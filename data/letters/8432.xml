	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Peverso tandem in Helvetiam gratissimum
					<lb xml:id="p1z2"/>misi accidit, quod Baltagares noster de te
					<lb xml:id="p1z3"/>collegaque tuo d. Gvaltero, optimo humanissimo,
					<lb xml:id="p1z4"/>viro nunciavit. Vos scilicet bona prosperau
					<lb xml:id="p1z5"/>frui valaetudine et mei memoriam animis
					<lb xml:id="p1z6"/>vestris haudquaquam excidisse Speravilitidem
					<lb xml:id="p1z7"/>vobis non ingratum fore, si idem Baltagarii
					<lb xml:id="p1z8"/>utrique vestrum salutem plurimam meis verbi
					<lb xml:id="p1z9"/>diceret, testareturque me caeteris vibus imparent
					<lb xml:id="p1z10"/>pari vos amore complecti neque porse aut veli
					<lb xml:id="p1z11"/>ea in re inferiores firre, ut qui vos omnibus
					<lb xml:id="p1z12"/>in rebus cum spectatae probitatis viros, tum
					<lb xml:id="p1z13"/>quotiescumque se obtulit occasio mei perstulioso
					<lb xml:id="p1z14"/>cognovirim, quae duae res bonorum iunguus
					<lb xml:id="p1z15"/>animos et amicitias immortali vinculo consociam
					<lb xml:id="p1z16"/>De meis rebus hoc tantum scribam, mi dei
					<pb/>
					<lb xml:id="p2z1"/>beneficio) meliuscule aliquanto quam cum sinc
					<lb xml:id="p2z2"/>in Galliam profectus sum habere longum
					<lb xml:id="p2z3"/>periculosumque illud iter sine ulla molestia
					<lb xml:id="p2z4"/>confecisse addam me uxorem duxisse bono si
					<lb xml:id="p2z5"/>fallor consilio evintu, quim dominus comprobabit
					<lb xml:id="p2z6"/>me sane consilii non poenitat. Feriunt nunc in
					<lb xml:id="p2z7"/>Gallia regis nuptiae, de stabilienda pace siduli
					<lb xml:id="p2z8"/>continentitue viri boni cogitant, quae de sis rebus
					<lb xml:id="p2z9"/>ad nos perscribuntur Baltazari mandavi, ut
					<lb xml:id="p2z10"/>tibi referret, quod me a prolixiore scriptionu
					<lb xml:id="p2z11"/>negotia avount; multa sunt, quae me de
					<lb xml:id="p2z12"/>republicae nostra melius in posterum sperare iubeant
					<lb xml:id="p2z13"/>Tibi dominoque Gvaltero plurimam a domino
					<lb xml:id="p2z14"/>Salutitu precor. Vale. Soloduro 25. navimes.
					<lb xml:id="p2z15"/>1570.
					<lb xml:id="p2z16"/>Tus eex animo
					<lb xml:id="p2z17"/>S.
					<lb xml:id="p2z18"/>Typoprus.
					<lb xml:id="p2z19"/>rl.
					<pb/>
					<lb xml:id="p4z1"/>Clarissimo et multum
					<lb xml:id="p4z2"/>Peurendo, domino e.
					<lb xml:id="p4z3"/>Bullingero, ecclesiae
					<lb xml:id="p4z4"/><placeName ref="l587">Tigurinae</placeName> pastor
					<lb xml:id="p4z5"/>elignissimo.
				</p>
			</div>
		</body>
