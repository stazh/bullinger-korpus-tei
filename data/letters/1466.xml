	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Dixit <persName ref="p1278">Gastius</persName> mihi de duobus libellis, altero Latino, altero <placeName ref="l822">Germanico</placeName>, unius tamen argumenti <lb xml:id="p1z2"/>a te missis et dono mihi dandis.</s>
					<s n="3" xml:lang="la">Ego nihil accepi, nec ille habet, quos distribuat <lb xml:id="p1z3"/>amplius.</s>
					<s n="4" xml:lang="la"><persName ref="p8298">Borrhaus</persName> habet suum, <persName ref="p714">Cęlius</persName> suum, et reliqui expleti sunt; solus ego careo, quod <lb xml:id="p1z4"/>donasti.</s>
					<s n="5" xml:lang="la">Age vero, caream; recipio grate, quod voluisti donatos.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z5"/>Reliquum est: <placeName ref="l1041">Brunsvicenses</placeName> miserunt nuncium ad <placeName ref="l491">Argentinenses</placeName>, ut sibi mittant doctum ali<lb xml:id="p1z6"/>quem ludimagistrum et pium concionatorem.</s>
					<s n="7" xml:lang="la">Tantum effecit tyrannis, qua sunt exagitati <lb xml:id="p1z7"/>hactenus.</s>
					<s n="8" xml:lang="la">Verum non miserunt quenquam, quia neminem habent, qui mitti possit.</s>
					<s n="9" xml:lang="la">Volui, <lb xml:id="p1z8"/>ut et hoc non ignorares.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z9"/>Redierunt ad me heri <placeName ref="l558">Witenbergenses</placeName> illi, qui fuerunt apud vos.</s>
					<s n="11" xml:lang="la">Beneficentiam vestram <lb xml:id="p1z10"/>mirabiliter vehunt et a doctrina vehementer commendant et nihil esse illic aiunt, <lb xml:id="p1z11"/>quod sibi non placeat.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale cum tuis.</s>
					<s n="13" xml:lang="la"><placeName ref="l28">Basileę</placeName> 10. novembris anno 1551.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z12"/>T[uus] <persName ref="p8418">Os[valdus] Myconius</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>in domino suo.</s>
				</p>
			</div>
		</body>
	</text>
