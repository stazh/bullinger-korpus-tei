	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Pax et tranquilla conscientia in Christo!</s>
					<s n="2" xml:lang="la">Indies <persName ref="p6063">Petersonii</persName> adventum exspecto: nam <lb xml:id="p1z2"/>sub festum Pentecostis me constanter suscepit, literis datis mense Martii, se adfore.</s>
					<s n="3" xml:lang="la">Quod <lb xml:id="p1z3"/>si non venerit, certum est interceptum esse dum <placeName ref="l832">Galliam</placeName> transiverit.</s>
					<s n="4" xml:lang="la">Meliora spero, Dei mi<lb xml:id="p1z4"/>sericordia fretus.</s>
					<s n="5" xml:lang="la">Age sit ita, nos tamen (Deo duce) Angli efficiemus, ne adeo magnam jacturam <lb xml:id="p1z5"/>faciat <persName ref="p6425">Schentzius</persName>; nisi ipse una rerum mearum, quas in <placeName ref="l830">Anglia</placeName> possideo, naufragium <lb xml:id="p1z6"/>fecero.</s>
					<s n="6" xml:lang="la">Tum ficulneum erit meum praesidium: adjuvabitur tamen ab aliis (non dubito) <lb xml:id="p1z7"/>bonis.</s>
					<s n="7" xml:lang="la">Istud ideo scribo, quia <placeName ref="l830">Angliae</placeName> status est jam nunc turbulentissimus.</s>
					<s n="8" xml:lang="la">Sed <lb xml:id="p1z8"/>de hoc nihil scribam, quia persuasum habeo brevi <persName ref="p6063">Petersonium</persName> viva voce omnia relaturum.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z9"/>Praeterea angustia temporis non fert modo ut de hac re plura scribam.</s>
					<s n="10" xml:lang="la">Pro tua <lb xml:id="p1z10"/>tamen prudentia hinc reliqua facile conjicias mala, exoptatissime <lb xml:id="p1z11"/>D. <persName ref="p495">Bullingere</persName>.</s>
					<s n="11" xml:lang="la">Tres enim optimi nostrum ministri captivi sunt in <lb xml:id="p1z12"/>carcere, quod <placeName ref="l296">Londinense</placeName> castellum aut, si mavis, Turrim <placeName ref="l296">Londinensem</placeName> nuncupant.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z13"/>Porro proficiscar recta <placeName ref="l157">Francofordiam</placeName> consolandi gratia <lb xml:id="p1z14"/>quosdam fratres ex <placeName ref="l830">Anglia</placeName> ultro profugas.</s>
					<s n="13" xml:lang="la">Ubi reverens fuero, plura <lb xml:id="p1z15"/>cognosces, si Dominus voluerit.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale quam felicissime in Christo pariter <lb xml:id="p1z16"/>cum uxore et universa familia.</s>
					<s n="15" xml:lang="la" ana="salute">Saluta, quaeso, omnes tuos collegas meis <lb xml:id="p1z17"/>verbis in Domino.</s>
					<s n="16" xml:lang="la" ana="farewell">Iterum vale.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z18"/>Tuus ex animo, <lb xml:id="p1z19"/><persName ref="p506">J. BUTLERUS</persName></s>
				</p>
				<p>
					<note type="PS">P.S.</note>
					<s n="18" xml:lang="la"><lb xml:id="p1z20"/>Ora Dominum nostrae sortis ut misereri dignetur, <lb xml:id="p1z21"/>te obsecro.</s>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Gravissimo viro <lb xml:id="p2z2"/>D. <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bullingero</persName>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
