	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Vivam epistolam habes <persName ref="p4037">Zanchum</persName> <lb xml:id="p1z2"/>nostrum.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Non ergo opus pluribus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Intelliges <lb xml:id="p1z3"/>ex ipso, quae de <persName ref="p2336">Bernhardino</persName> audire <lb xml:id="p1z4"/>velis.</s>
					<s n="5" xml:lang="la">Fuit apud ipsum <placeName ref="l28">Basileae</placeName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quae habe<lb xml:id="p1z5"/>o ex <placeName ref="l41">Berna</placeName>, his inclusi; sed nolim illa <lb xml:id="p1z6"/>spargi; tibi ergo retinebis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Audio ultimam <lb xml:id="p1z7"/>sessionem habitam in die conceptionis Mariae, unde <lb xml:id="p1z8"/>coniecturis colligo plures hoc anno habitas, <lb xml:id="p1z9"/>quam assequti simus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Cura ergo, ut omnes amicos <lb xml:id="p1z10"/>horteris, ea nobis communicent, quae inde accipiunt.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z11"/>Miror, quod hodie nullas acceperim <lb xml:id="p1z12"/>a te literas; verum negotiis hoc tuis tribuo.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z13"/>D. <persName ref="p4037">Zanchus</persName> utilissimus erit ecclesiae dei <lb xml:id="p1z14"/>in illis partibus; sed vereor, ne adversarii <lb xml:id="p1z15"/>papistae modis omnibus illum sint prose<lb xml:id="p1z16"/>quturi odio et capturi consilia, quomodo ipsum <lb xml:id="p1z17"/>loco pellant.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Fortior tamen est dominus, quam vin<lb xml:id="p1z18"/>ci possit ab illis loqustis.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Remittes, <lb xml:id="p1z19"/>quae nuper ad te misi, praecipue articulos <lb xml:id="p1z20"/><persName ref="p2336">Bernhardini</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vive et vale una cum <lb xml:id="p1z21"/>tuis omnibus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Salutant te mei omnes.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z22"/>Saluta d. consules, <persName ref="p8359">Gallicium</persName> et <persName ref="p6130">Pontasellam</persName>.</s>
					<s n="16" xml:lang="la">10. <lb xml:id="p1z24"/>decembris 1563.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z25"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
