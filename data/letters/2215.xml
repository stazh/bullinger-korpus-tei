	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Libellos, quos requiris, curavi per bibliopolas nostros <lb xml:id="p1z2"/>ex mercatu <placeName ref="l157">Franckfortense</placeName> adferri.</s>
					<s n="3" xml:lang="la">Catalogus vero librorum <lb xml:id="p1z3"/>hic excusorum hoc semestri haberi non potuit ob chalcographorum <lb xml:id="p1z4"/>occupationes ad nundinas sese parantium; sed ubi reversi fuerint, <lb xml:id="p1z5"/>efficiam ut prima occasione accipias.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Affini tuo, sicut confidis <lb xml:id="p1z6"/>mihi, non deero et intendam in omnes occasiones; sic enim meretur non <lb xml:id="p1z7"/>solum tua in me benevolentia, sed beneficia etiam, quibus immerentem prosequeris, <lb xml:id="p1z8"/>quorum nomine graciam tibi magnam habeo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Tractatum De iustificatione <lb xml:id="p1z9"/>accepi et <persName ref="p1283">Gesneri</persName> nostri librum secundum de oviparis quadrupedibus; utroque <lb xml:id="p1z10"/>oblector et erudior.</s>
					<s n="6" xml:lang="la"><placeName ref="l491">Argentinam</placeName> et <placeName ref="l411">Richemvylam</placeName> dimisi reliquos, <lb xml:id="p1z11"/>sicut cupivisti.</s>
					<s n="7" xml:lang="la">Novi praeter ea, quae ipse cognovisti, nihil <lb xml:id="p1z12"/>accepi, nisi quod <persName ref="p714">Celius</persName> noster significavit in <placeName ref="l830">Anglia</placeName> duos exercitus <lb xml:id="p1z13"/>collectos, alterum a <placeName ref="l1956">Suffolciae</placeName> duce, alterum ab <placeName>Oveto</placeName>, atque eatenus <lb xml:id="p1z14"/>eos in colloquium reginae (quod ambit) consensisse, ut obses detur <lb xml:id="p1z15"/>episcopus <placeName ref="l553">Vindonensis</placeName>.</s>
					<s n="8" xml:lang="la">Caesarem item in procinctu habuisse expeditionem, <lb xml:id="p1z16"/>qua traiiceret in <placeName ref="l830">Angliam</placeName> reginae subventurus, sed submonitum <lb xml:id="p1z17"/>a quibusdam habiturum a tergo infestissimum <placeName ref="l832">Galli</placeName> exercitum, si <lb xml:id="p1z19"/>moveat pedem, itque mutato consilio substitisse.</s>
					<s n="9" xml:lang="la">Cęterum <placeName ref="l830">Anglus</placeName> <lb xml:id="p1z20"/>quidam his diebus <persName ref="p8126">Oporino</persName> nostro significavit reginam <lb xml:id="p1z21"/>de hostibus suis devictis triumphare, qui utinam vanus sit; <lb xml:id="p1z22"/>verum, qui has perfert et ipse de <placeName>Oveto</placeName> capto narrabit, <lb xml:id="p1z23"/>quod <placeName ref="l491">Argentorati</placeName> accepit.</s>
					<s n="10" xml:lang="la" ana="salute">Bene vale cum uxore, liberis <lb xml:id="p1z24"/>et symmistis fratribus, quos cupio meis verbis <lb xml:id="p1z25"/>reverenter salutes.</s>
					<s n="11" xml:lang="la"><placeName ref="l28">Basileae</placeName> 8a marcii anno 1554.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z26"/>T[uus] <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> antistiti, domino <lb xml:id="p2z4"/>et symmistae colendissimo <lb xml:id="p2z5"/>suo.</s>
				</p>
			</div>
		</body>
	</text>
