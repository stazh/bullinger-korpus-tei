	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto tibi hic caseum, honorande domine et compater, <lb xml:id="p1z2"/>pro qualicunque gratitudinis et bonae meae erga te <lb xml:id="p1z3"/>voluntatis indicio; illo vero si suaviter uti velis, <lb xml:id="p1z4"/>mox eum, dum recens est, aggredere.</s>
					<s n="3" xml:lang="la">Ex reliquis <lb xml:id="p1z5"/>minoribus alterum d. <persName ref="p8011">Gvalthero</persName>, alterum vero <lb xml:id="p1z6"/>d. <persName ref="p3988">Wolphio</persName>, ut nomina eorum ipsis inscripta sunt, mitte.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Rogo vero omnes vos, ut exigua illa munuscula boni <lb xml:id="p1z8"/>consulatis, donec ampliore et liberaliore significatione <lb xml:id="p1z9"/>vobis aliquando benevolentiam meam declarem.</s>
					<s n="5" xml:lang="la">Interea <lb xml:id="p1z10"/>me, sicut hactenus fecistis, diligere pergite.</s>
					<s n="6" xml:lang="la">Precor simul <lb xml:id="p1z11"/>vobis a domino annos faustissimos et omnem benedictionem.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>De rebus aliis alias scribam; quando enim <lb xml:id="p1z13"/>has accepturus sis, ignoro.</s>
					<s n="8" xml:lang="la">Tradidi illa omni o oeconomo <placeName ref="l269">Küng<lb xml:id="p1z14"/>ßfeldensi</placeName>, qui ea, cum poterit, ad vos mittet.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z15"/>Bene valete.</s>
					<s n="10" xml:lang="la" ana="salute">Salutant vos <persName ref="p8063">Steigerus</persName>, <persName ref="p7449">Diesbachius</persName>, <persName ref="p7510">Gravenriet</persName>, <lb xml:id="p1z16"/><persName ref="p21017">Manuel</persName> et te praesertim tui <persName ref="p4060">Zehenderi</persName>.</s>
					<s n="11" xml:lang="de"><placeName ref="l41">Bernae</placeName> 12. <lb xml:id="p1z17"/>novembris 1566.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p8018">Johannes Hallerus</persName>, omnium <lb xml:id="p1z19"/>vester semper et <lb xml:id="p1z20"/>perpetuo.</s>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z4"/>fidelissimo pastori, domino <lb xml:id="p2z5"/>meo honorando et <lb xml:id="p2z6"/>compatri charissimo.</s>
				</p>
			</div>
		</body>
