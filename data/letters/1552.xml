	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Qui has ad te perfert, compater <lb xml:id="p1z2"/>in domino charissime, nomine m. <persName ref="p20335">Ioannes <lb xml:id="p1z3"/>Thomas Husinger</persName>, legatus est civitatis <lb xml:id="p1z4"/><placeName ref="l303">Magdeburgensis</placeName>; habet, quae coram senatu <lb xml:id="p1z5"/>vestro agat.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Arbitror haud opus <lb xml:id="p1z6"/>esse, ut causam illius vel exponam <lb xml:id="p1z7"/>literis vel commendem; nam ipse <lb xml:id="p1z8"/>fuse exponet omnia non sine <lb xml:id="p1z9"/>sigulari vestra delectatione et audi<lb xml:id="p1z10"/>endi aviditate, et causa ipsa t<lb xml:id="p1z11"/>am egregię civitatis in se ipsa <lb xml:id="p1z12"/>talis est, ut iam omnibus non <lb xml:id="p1z13"/>modo evangelii Christi amatoribus, <lb xml:id="p1z14"/>sed et <placeName ref="l822">Germanicę</placeName> libertatis studiosis <lb xml:id="p1z15"/>admodum sit commendata.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z17"/>Accepti sunt hic tam a senatu quam <lb xml:id="p1z18"/>a civibus satis amanter et honori<lb xml:id="p1z19"/>fice; verum ex literis <persName ref="p8018">Halleri</persName>, <lb xml:id="p1z20"/>opinor, intelliges nostrorum pro<lb xml:id="p1z21"/>positum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z22"/>Postremum meum scriptum in tuam <lb xml:id="p1z23"/>gratiam compositum etsi nihil <lb xml:id="p1z24"/>habet non veri meo iudicio, <lb xml:id="p1z25"/>oro tamen, pro tua prudentia <lb xml:id="p1z26"/>et vigilantia diligenter perpendes <lb xml:id="p1z27"/>et haud secus, quam si tuum esset <lb xml:id="p1z28"/>ipsius, vel corrigas vel supprimas, <lb xml:id="p1z29"/>iuxta quod faciundum videbitur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z30"/>Breviter in illo quaedam perstrinxi, <lb xml:id="p1z31"/>quae poterant fusius exponi et <lb xml:id="p1z32"/>firmius communiri; verum non sine <lb xml:id="p1z33"/>ratione paucis agendum putavi.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z34"/>Optime vale, compater charissime.</s>
					<s n="8" xml:lang="la">Audies <lb xml:id="p1z35"/>ex isto <placeName ref="l303">Magdeb[urgensi]</placeName> legato quaedam de <lb xml:id="p1z36"/>singulari et admodum grandi expeditio<lb xml:id="p1z37"/>ne quadam bellica, si perconteris.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Salutem <lb xml:id="p1z38"/>tuis omnibus.</s>
					<s n="10" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1552. 30. ianuarii.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p8417">W[olfgangus] Musc[ulus]</persName>, compater tuus in domino<pb/><lb xml:id="p2z3"/>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z4"/>Praestantissimo <lb xml:id="p2z5"/>theologo m. <lb xml:id="p2z6"/><persName ref="p495">Heinrycho <lb xml:id="p2z7"/>Bullingero</persName>, <lb xml:id="p2z8"/>compatri suo <lb xml:id="p2z9"/>cumprimis <lb xml:id="p2z10"/>colendo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z11"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
