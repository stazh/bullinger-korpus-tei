	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Reddidit hic mihi tuas.</s>
					<s n="3" xml:lang="la">Ego vero nunc alia non <lb xml:id="p1z2"/>habeo, quam quae scripsi prius et quę te iam accepisse <lb xml:id="p1z3"/>puto de luctuoso <placeName ref="l832">Galliae</placeName> statu.</s>
					<s n="4" xml:lang="la"><persName>Tristiora</persName> subinde <lb xml:id="p1z4"/>accipimus.</s>
					<s n="5" xml:lang="la">Fertur (sed quam firmum hoc sit, nolo <lb xml:id="p1z5"/>affirmare) regem cum 12 equitibus tantum effugisse <lb xml:id="p1z6"/>manus <placeName>Condensis</placeName> et amiralii et venisse <placeName ref="l378">Lutetiam</placeName>.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z7"/>Quid vero fiat ab illis reliquis, ignoramus adhuc.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/>Causam belli huius alii aliter interpretantur; aliqui <lb xml:id="p1z9"/>nostris culpam dant, ut scripsi proxime; alii dicunt <lb xml:id="p1z10"/>regem publica promulgatione sustulisse edictum pacis <lb xml:id="p1z11"/>et mandasse omnibus evangelicis, ut intra 12 dies regno <lb xml:id="p1z12"/>excedant; hinc illas turbas oriri.</s>
					<s n="8" xml:lang="la"><placeName ref="l167">Genevam</placeName> profugiunt <lb xml:id="p1z13"/>multi inopes, nudi et egeni.</s>
					<s n="9" xml:lang="la">Mirum, quod illis <lb xml:id="p1z14"/>a duce <placeName ref="l2478">Sabaudię</placeName> transitus conceditur.</s>
					<s n="10" xml:lang="la"><placeName ref="l301">Lugduni</placeName> est <lb xml:id="p1z15"/>misera rerum facies.</s>
					<s n="11" xml:lang="de">Man sagt auch, das sich in <placeName ref="l822">Tütsch<lb xml:id="p1z16"/>land</placeName> ein groß volk sammle; ire zeichen sigind wyße <lb xml:id="p1z17"/>fänli mitt zweyen zemmengschlagnen henden, trüw<lb xml:id="p1z18"/>wys; nieman aber wüß, wäm si dienen werdind.</s>
					<s n="12" xml:lang="de">Ett<lb xml:id="p1z19"/>lich achtend, dem printzen von <placeName>Aurange</placeName>, deßen sun <lb xml:id="p1z20"/>zuͦ <placeName ref="l1322">Löwen</placeName> gfangen; ettlich achtend anders.</s>
					<s n="13" xml:lang="de">Ich hoff, von <lb xml:id="p1z21"/>üch bald etwas zuͦ empfahen.</s>
					<s n="14" xml:lang="de">Was mir dann wirt, <lb xml:id="p1z22"/>wil ich üch auch lon wüßen.</s>
					<s n="15" xml:lang="de">Hiemitt schick ich üch üweren <lb xml:id="p1z23"/>zedel auch wider und dancken üch vast.</s>
					<s n="16" xml:lang="la"><persName ref="p8033">Bezae</persName> misi <lb xml:id="p1z24"/>literas, quę ad illum pertinebant, sic etiam d. <persName ref="p8063">Steigero</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Salutant <lb xml:id="p1z25"/>te nostri omnes; saluta tuos quoque omnes meo nomine.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l41">Bernę</placeName> <lb xml:id="p1z26"/>12. octobris 1567.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><persName ref="p8018">I[oh<lb xml:id="p1z27"/>annes] Hallerus</persName>, tuus <lb xml:id="p1z28"/>semper<lb xml:id="p1z30"/>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino meo <lb xml:id="p2z4"/>semper colendo et compatri <lb xml:id="p2z5"/>charissimo.</s>
				</p>
				<p>
					<s n="21" xml:lang="de"><lb xml:id="p2z6"/>M. <persName ref="p495">Heinrych Bullingern</persName> <lb xml:id="p2z7"/>zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
