	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>stapiam ecclesiam.
					<lb xml:id="p1z2"/>acerium es, in illo sum
					<lb xml:id="p1z3"/>sic suasi necne
					<lb xml:id="p1z4"/>sd
					<lb xml:id="p1z5"/>est
					<lb xml:id="p1z6"/>etatur
					<lb xml:id="p1z7"/>vicylar
					<lb xml:id="p1z8"/>demittertssim Red
					<lb xml:id="p1z9"/>tinet certi
					<lb xml:id="p1z10"/>sceam
					<lb xml:id="p1z11"/>cantiu
					<lb xml:id="p1z12"/>S.
					<lb xml:id="p1z13"/>
					<lb xml:id="p1z14"/>ufter
					<lb xml:id="p1z15"/>Casilini
					<pb/>
					<lb xml:id="p2z1"/>viro d. Heri.
					<lb xml:id="p2z2"/>domi doi
					<lb xml:id="p2z3"/>Tigurenę patrim
					<lb xml:id="p2z4"/>duis mei dite.
					<lb xml:id="p2z5"/>Piius e
					<pb/>
					<lb xml:id="p3z1"/>135.
					<pb/>
					<lb xml:id="p4z1"/>d. Henrico Bueno
					<lb xml:id="p4z2"/>Tigurinae ecclesiae
					<lb xml:id="p4z3"/>pastori et patri.
					<lb xml:id="p4z4"/>domino meo colendissimo.
					<lb xml:id="p4z5"/>Tigurum.
				</p>
			</div>
		</body>
	</text>
