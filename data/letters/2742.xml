					<lb xml:id="p4z2"/>Chiti sermo d. Henricho
					<lb xml:id="p4z3"/>Bullingero, <placeName ref="l587">Tigurinę</placeName> ecclesię
					<lb xml:id="p4z4"/>pastori.
					<lb xml:id="p4z5"/>fratri et symmystę observando.
					<lb xml:id="p4z6"/>Bisi,
					<lb xml:id="p4z7"/>8.
					<lb xml:id="p4z8"/>1186.
