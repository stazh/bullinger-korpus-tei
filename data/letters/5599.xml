	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Animum calamo admovi (reverende <lb xml:id="p1z2"/>in Christo pater), antequam mihi <lb xml:id="p1z3"/>de tabellione constaret; nostri enim propter <lb xml:id="p1z4"/>mercatum non proficiscuntur; sunt enim <lb xml:id="p1z5"/>nundinae nostrae.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Tamen haec paucula <lb xml:id="p1z6"/>scripsi et prodeo visum, cui dem, non <lb xml:id="p1z7"/>quod haberem, sed ut intelligeres tua <lb xml:id="p1z8"/>omnia mihi reddita, pro quibus immortales <lb xml:id="p1z9"/>tibi habemus gratias.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Exscripsi ordine <lb xml:id="p1z10"/>et ex singulis annotavi, quae legi ab <lb xml:id="p1z11"/>omnibus volo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Negotium <placeName ref="l1107">Tridentinum</placeName> <lb xml:id="p1z12"/>mihi curae erit; nunc habebo in nundinis, <lb xml:id="p1z13"/>quibus committam, sed tamen expecto aliquid <lb xml:id="p1z14"/>a fratribus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Nunc nihil habeo, nisi quod <lb xml:id="p1z15"/>quidam vir probus ex <placeName ref="l2893">Inferiore Engadina</placeName> <lb xml:id="p1z16"/>hic adest, qui affert <placeName ref="l522">Venetos</placeName>, propterea <lb xml:id="p1z17"/>quod fama puellarum et matronarum <lb xml:id="p1z18"/><placeName ref="l1107">Tridenti</placeName> supra modum laboraret, sanctis <lb xml:id="p1z19"/>patribus concilii supplemento misisse <lb xml:id="p1z20"/>trecenta lectissima et nobilissima <lb xml:id="p1z21"/>scorta.</s>
					<s n="7" xml:lang="la">Habes nova.</s>
					<s n="8" xml:lang="la">Scribitur ad <persName ref="p8114">Balingketum</persName> <lb xml:id="p1z22"/>duos fratres filios <placeName ref="l1098">Florentini</placeName> sese mutuo <lb xml:id="p1z23"/>in venatione confecisse et eorum mortem <lb xml:id="p1z24"/>statim matris quoque subsequutam.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z25"/>Haec an vero sint, non facile dum dixero.</s>
					<s n="10" xml:lang="de"><pb/><lb xml:id="p2z1"/><foreign xml:lang="la">Certe hoc verum perhibetur,</foreign> das die... armen <lb xml:id="p2z2"/>landsknächt mit dem kaiser übel zefri<lb xml:id="p2z3"/>den, der inen verbotten, uff der gart umhar<lb xml:id="p2z4"/>zeziechen, und thüge er es aber yetz selber.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z5"/>Haec per iocum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale, reverende in Christo <lb xml:id="p2z6"/>pater.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z7"/>Si legis, quae in vita <persName ref="p8127">Conradi Pellicani</persName> de <lb xml:id="p2z8"/>coelo ubiquario addidi, non te offendat; <lb xml:id="p2z9"/>nam ita cum suo coelo videntur exibilandi, <lb xml:id="p2z10"/>et certe videretur consultum, ut omnes docti, <lb xml:id="p2z11"/>qui a nobis stant, scommata in <lb xml:id="p2z12"/>eos iacerent.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Si tibi tamen non placet, <lb xml:id="p2z13"/>dele; penes te est potestas, quam tibi facio.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z14"/>Aequo autem animo hanc vitam <persName ref="p8127">Pellicani</persName> <lb xml:id="p2z15"/>leges, si cogitaris iam pridem scriptam <lb xml:id="p2z16"/>et nunc in tantis turbis mihi <lb xml:id="p2z17"/>corrigendi et emendandi laborem fuisse <lb xml:id="p2z18"/>permolestum.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z19"/><placeName ref="l98">Curię</placeName> 25. ianuarii anno 1563.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z20"/>Tui observans <persName ref="p8009">Iohannes <lb xml:id="p2z21"/>Fabricius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
