					<lb xml:id="p2z7"/>s.
					<lb xml:id="p2z8"/>.
					<lb xml:id="p2z9"/>Eximio Christi fervd
					<lb xml:id="p2z10"/>d. Henrico Bullingero,
					<lb xml:id="p2z11"/>Tigurinae ecclesia
					<lb xml:id="p2z12"/>vere fido pastori,
					<lb xml:id="p2z13"/>patri mihi plurimim
					<lb xml:id="p2z14"/>observando.
					<lb xml:id="p2z15"/>o one.
					<lb xml:id="p2z16"/>Tiguri.
					<lb xml:id="p2z17"/>e pu te vars .
