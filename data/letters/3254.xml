	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">Accepi, quae misisti, omnia et dabo operam, ut <lb xml:id="p1z3"/>quam primum licebit, etiam cętera, quę supersunt, expediam.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Orationem tertiam, si per ea, quę prius <lb xml:id="p1z5"/>absolvenda sunt, licebit, vel seorsim potius excudam.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Titulum cum praefatione Apocalypseos hactenus <lb xml:id="p1z7"/>distuli, dum a <persName ref="p1227">Froschovero</persName>, quo charactere excudi <lb xml:id="p1z8"/>praefationem vellet, admonerer; ita enim ille princi<lb xml:id="p1z9"/>pio iusserat; alioqui maluissem statim ab initio <lb xml:id="p1z10"/>a titulo et praefatione auspicari, quod fere vel <lb xml:id="p1z11"/>supersit aliquid postea vel desit, cum aboluto <lb xml:id="p1z12"/>opere priora aliquot folia adhuc postremo excudenda <lb xml:id="p1z13"/>relinquantur.</s>
					<s n="5" xml:lang="la">Cęterum, quod illum differre video, meo <lb xml:id="p1z14"/>more praefationem charactere illo, quo orationes tuas <lb xml:id="p1z15"/>expressi, curabo fieri; neque enim vel sic ultra <lb xml:id="p1z16"/>ternionem fore illam puto.</s>
					<s n="6" xml:lang="la">Literas tuas ad <persName ref="p8124">Nao<lb xml:id="p1z17"/>georgum</persName> ante 8 dies demum curavi; quas ad <persName>Iunium</persName> <lb xml:id="p1z18"/>nostrum heri cum meis accepi, in adventum i<lb xml:id="p1z19"/>psius servabo; comitatus est enim heri <placeName ref="l830">Anglos</placeName> <lb xml:id="p1z20"/>aliquot <placeName>Aroviam</placeName>, ut commodiore hospitio impe<lb xml:id="p1z21"/>trando ipsis adesse queat, cras (uti speramus) <lb xml:id="p1z22"/>reduturus.</s>
					<s n="7" xml:lang="la">Literas ad <persName ref="p8073">Gilbertum Gognatum</persName> adhuc habeo, <lb xml:id="p1z23"/>quod cariores in <placeName ref="l631">Burgundiam</placeName> tabellarii offerantur neque <lb xml:id="p1z24"/>cuivis credendas esse illas putem.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Quę in Samuelem, <lb xml:id="p1z25"/>Iudicum, Ruth, libros Regum excuduntur annotationes, <lb xml:id="p1z26"/><persName>Borrhai</persName> sunt, cui tuum de specimine tantum viso iudici<lb xml:id="p1z27"/>um exponam, ut alacriorem ad cętera reddam; valde en<lb xml:id="p1z28"/>im oblectari solet, ubi sua bonis et doctis h<lb xml:id="p1z29"/>omi<pb/><lb xml:id="p2z1"/>nibus non displicere intelligit.</s>
					<s n="9" xml:lang="la" ana="salute">Plurimum te re<lb xml:id="p2z2"/>salutant <persName ref="p8406">Lycosthenes</persName> (qui in prodigiis suis totus <lb xml:id="p2z3"/>iam est), <persName ref="p714">Cęlius</persName> (qui propter tragoediam a <persName ref="p3375">Vergerio</persName> <lb xml:id="p2z4"/>motam pertrubatior est), <persName ref="p8466">Wyssenburgius</persName> et <lb xml:id="p2z5"/><persName ref="p8155">Baleus</persName>.</s>
					<s n="10" xml:lang="la">Sed et <persName ref="p1145">Foxus</persName>, item <persName>Anglus</persName>, bonus <lb xml:id="p2z6"/>atque eruditus inprimis vir, oravit, ut amicicię <lb xml:id="p2z7"/>apud te ineund e viam sibi aliquam pararem.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z8"/>Vertit is longam atque doctam iuxta ac piam <lb xml:id="p2z9"/>disputationem de toto eucharistię negotio <persName ref="p674">Thomae <lb xml:id="p2z10"/>Cranmeri</persName>, quondam <placeName ref="l1255">Cantuariensis</placeName> archiepiscopi contra <lb xml:id="p2z11"/><placeName ref="l553">Wintoniensem</placeName> episcopum, a sermone Anglico in Latinum, <lb xml:id="p2z12"/>cuius hic ad te specimen mitto, et vehementer <lb xml:id="p2z13"/>cuperet, quod per quosdam nimium adhuc Lutherizantes <lb xml:id="p2z14"/>hic minus licet (semel enim atque sollici<lb xml:id="p2z15"/>tanti ei negatum est) saltem apud vos ei licere, <lb xml:id="p2z16"/>ut absolvere eum et in publicum emittere liceat.</s>
					<s n="12" xml:lang="la">Non <lb xml:id="p2z17"/>gravabor equidem vel ipse meo sumptui id curare, <lb xml:id="p2z18"/>saltem ut inveniatur, qui operam locare in <lb xml:id="p2z19"/>eo opere nobis excudendo velit, atque utinam <placeName ref="l41">Ber<lb xml:id="p2z20"/>nensi</placeName> typographo <persName ref="p4191">Apiario</persName> per valetudinem <lb xml:id="p2z21"/>liceret; non magno negotio ibi me id impetraturum <lb xml:id="p2z22"/>sperarem.</s>
					<s n="13" xml:lang="la">Metuunt autem nostri, ubi non <lb xml:id="p2z23"/>erat metuendum, et novam eis religionem <persName ref="p3375">Vergerii</persName> <foreign xml:lang="el">[<lb xml:id="p2z24"/>griechisch]</foreign> (ne quid gravius dicam) <lb xml:id="p2z25"/>plus satis etiam ante meticulosis in causa <lb xml:id="p2z26"/>non mala, sed minus favorabili tantum apud <lb xml:id="p2z27"/>eos, qui extra sunt, incussit.</s>
					<s n="14" xml:lang="la">Cęterum, quicquid ea in <pb/><lb xml:id="p3z1"/>re visum tibi fuerit, fac proximis literis per ocium de tua <lb xml:id="p3z2"/>nos sententia, et an impetrari locus excudendi illum <lb xml:id="p3z3"/>librum apud vos liceat, certiores reddas.</s>
					<s n="15" xml:lang="la">Libenter vel <lb xml:id="p3z4"/>totum sumptum ego sustinebo; adeo causae huic ex animo <lb xml:id="p3z5"/>faveo, aut particeps ero sumptuum vel papyro etiam, <lb xml:id="p3z6"/>si opus sit, quanta erit opus, suppeditanda.</s>
					<s n="16" xml:lang="la" ana="farewell">Bene <lb xml:id="p3z7"/>vale, optime atque doctissime mi d. <persName ref="p495">Bullingere</persName>, <lb xml:id="p3z8"/>et ignosce nimis familiariter tecum praeter et dignitatem tuam <lb xml:id="p3z9"/>et negotiorum nostrorum rationem nugari <lb xml:id="p3z10"/>iam aliquoties auso.</s>
					<s n="17" xml:lang="la">Aliquando enim plus <lb xml:id="p3z11"/>erit tibi a legendis nostris nugis ocii, si dominus volu<lb xml:id="p3z12"/>erit.</s>
					<s n="18" xml:lang="la" ana="salute">Iterum vale et <persName ref="p8171">Bibliandrum</persName> nostrum, <persName ref="p8101">Lelium</persName>, <persName ref="p2336">B<lb xml:id="p3z13"/>ernardinum</persName>, <persName ref="p8111">P. Martyrem</persName>, <persName ref="p8011">Gualtherum</persName>, <persName ref="p1283">Gesnerum</persName>, <persName ref="p1214">Frisium</persName>, <lb xml:id="p3z14"/>generos tuos quoque omnes per occasionem officiose saluta.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p3z15"/><placeName ref="l28">Basileae</placeName> pridie calendas augusti.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p3z16"/><persName ref="p8126">Ioan[nes] Oporinus</persName> t[uus] ex animo<lb xml:id="p3z17"/>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Ignosce, non licuit <lb xml:id="p3z20"/>relegere<pb/><lb xml:id="p4z1"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="22" xml:lang="la"><lb xml:id="p4z2"/>Domino <persName ref="p495">Henrico Bul<lb xml:id="p4z3"/>lingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p4z4"/>ecclesiae pastori pri<lb xml:id="p4z5"/>mario, domino et amico <lb xml:id="p4z6"/>suo inprimis cole<lb xml:id="p4z7"/>ndo.</s>
					<s n="23" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note type="author">[Bemerkung von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="24" xml:lang="la"><lb xml:id="p4z8"/><persName>Marcus Dobler</persName>.</s>
				</p>
