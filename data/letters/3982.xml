	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Gott mitt üch, früntlicher, lieber herr und bruͦder,
					<lb xml:id="p1z2"/>ich bitten üch uffs aller früntlichist, ir wöllind
					<lb xml:id="p1z3"/>mir verschlossen und verpitschiert zuͦschicken,
					<lb xml:id="p1z4"/>den teyl üwers patters geschribner chronick
					<lb xml:id="p1z5"/>un der Cappler schlacht, muͦß neman wyt
					<lb xml:id="p1z6"/>ind kend kummen und üch mitt guͦten trüwen
					<lb xml:id="p1z7"/>wider werden fürderlich. Alein dorumb hab ich
					<lb xml:id="p1z8"/>dise knaben geschickt. Gott mitt üch.
					<lb xml:id="p1z9"/>1559.
					<lb xml:id="p1z10"/>iunii montags
					<lb xml:id="p1z11"/>Bullinger.
					<pb/>
					<lb xml:id="p2z1"/>Dem frommen und getruen
					<lb xml:id="p2z2"/>h. Hasen Rodolffen
					<lb xml:id="p2z3"/>Stmpffen, pfarreren
					<lb xml:id="p2z4"/>Kylchberg sine
					<lb xml:id="p2z5"/>hernae und bruͦder.
				</p>
			</div>
		</body>
	</text>
