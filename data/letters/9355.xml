			<zone xml:id="p2z5-0" points="3204,2322 3234,2326 3341,2262 3365,2276 3411,2268 3461,2314 3503,2300 3511,2151 3479,2165 3445,2147 3415,2173 3399,2163 3347,2192 3288,2200 3248,2186 3208,2208">3218,2263 3244,2263 3271,2259 3297,2256 3324,2252 3351,2251 3377,2251 3404,2251 3431,2251 3457,2251 3484,2251 3511,2251</zone>
