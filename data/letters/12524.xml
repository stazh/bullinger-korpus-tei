	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non est, quod scribam de tumultu illo <lb xml:id="p1z2"/>bellico; nam a magistrato nostro id intelliges.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Video <placeName ref="l18">Augustam Vindelicorum</placeName><note xml:id="fn1" type="footnote" n="1"><placeName ref="l18">Augsburg</placeName>.</note> valde trepidare <lb xml:id="p1z4"/>et forte propter amplissimas opes unam peti <lb xml:id="p1z5"/>prae aliis urbibus.</s>
					<s n="4" xml:lang="la">Aiunt, <persName ref="p3590">lantgravium</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p3590">Philipp von Hessen</persName>.</note> a mi<lb xml:id="p1z6"/>litibus et equitibus nescio quibus detineri, <lb xml:id="p1z7"/>quo minus possit <placeName ref="l822">Germanicis</placeName> urbibus ferre <lb xml:id="p1z8"/>suppetias.</s>
					<s n="5" xml:lang="la">Ego vero famae nihil credo.</s>
					<s n="6" xml:lang="la">Spero <lb xml:id="p1z9"/>illum propediem affuturum iusto instructu<lb xml:id="p1z10"/>m exercitu.</s>
					<s n="7" xml:lang="la">Silent constanter fratres <lb xml:id="p1z11"/><placeName ref="l20">Inferioris Germaniae</placeName>.</s>
					<s n="8" xml:lang="la">In diem expecto, quid sint <lb xml:id="p1z12"/>de motibus suis scripturi.</s>
					<s n="9" xml:lang="la">Imo paucula ad<lb xml:id="p1z13"/>huc <placeName ref="l28">Basilienses</placeName> ad magistratum nostrum dedere.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/>Certum est, <persName ref="p9708">ducem</persName> <placeName ref="l572">Wirtenbergensem</placeName><note xml:id="fn3" type="footnote" n="3"><persName ref="p9708">Ulrich von Württemberg</persName>.</note> forti <lb xml:id="p1z15"/>et intrepido animo esse<note xml:id="fn4" type="footnote" n="4">s. Blarer an HB, 25. Juni.</note> et auxilia laturum <lb xml:id="p1z16"/>fida urbibus.</s>
					<s n="11" xml:lang="la">Ego ne de <placeName ref="l862">Helvetiis</placeName> quidem <lb xml:id="p1z17"/>despero.</s>
					<s n="12" xml:lang="la">Sis in hoc, ut tui quoque <placeName ref="l21">Badenae</placeName> fideles <lb xml:id="p1z18"/>sint.</s>
					<s n="13" xml:lang="la"><persName ref="p18604">Dux</persName> <placeName ref="l619">Bavariae</placeName><note xml:id="fn5" type="footnote" n="5"><persName ref="p18604">Wilhelm IV. von Bayern</persName>.</note> respondisse dicitur <persName ref="p18538">caesari</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p18538">Karl V.</persName></note>, <lb xml:id="p1z19"/>nolle se armis propter religionem certare; ergo <lb xml:id="p1z20"/>praetexit causas caesar alias.</s>
					<s n="14" xml:lang="la">Nobiles <placeName ref="l2459">Rheni</placeName> <lb xml:id="p1z21"/>negarunt auxilia caesari.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Tu si quae certiora <lb xml:id="p1z22"/>habes, communica.</s>
					<s n="16" xml:lang="la">Vive et vale!</s>
					<s n="17" xml:lang="la">Oremus <lb xml:id="p1z23"/>dominum, ut animum et robur nostris inspiret, <lb xml:id="p1z24"/>adversariis metum et vertiginem.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">28. iunii <lb xml:id="p1z25"/>anno 1546.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p495">H. Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. d[octori] <persName ref="p8049">Ioa<lb xml:id="p2z2"/>chimo Vadiano</persName>, domino <lb xml:id="p2z3"/>suo colendissimo.</s>
					<s n="21" xml:lang="la"><lb xml:id="p2z4"/>Sangallen.</s>
				</p>
			</div>
		</body>
	</text>
