	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil hac vice eram tibi scripturus, <lb xml:id="p1z2"/>charissime frater, nisi iam nunc sub ves<lb xml:id="p1z3"/>peram a <persName ref="p8033">Beza</persName> mihi essent traditae literae <lb xml:id="p1z5"/>in hanc sententiam: "10. octobris sub vesperam accipio <lb xml:id="p1z6"/>literas a d. admiraldo, quibus significatur detec<lb xml:id="p1z7"/>tam esse <placeName>Guysianorum</placeName> coniurationem, qui <placeName ref="l378">Lute<lb xml:id="p1z8"/>tiae</placeName> sperabant se regem intercepturos, quem <lb xml:id="p1z9"/>non antea constituerant dimittere, quam omnia <lb xml:id="p1z10"/>pro suo arbitrio confecissent.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Eorum consilium <lb xml:id="p1z11"/>abrupit reginae valetudo et regis ab urbe <lb xml:id="p1z12"/>regressus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Additur illos ne coniuratione quidem <lb xml:id="p1z13"/>detecta desistere; sed bona spes est nihil <lb xml:id="p1z14"/>nisi in suam perniciem effecturos.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Ipse ad<lb xml:id="p1z15"/>miraldus suorum copias vicissim cogit et sese <lb xml:id="p1z16"/>commendat ecclesiarum precibus, ac sane dignus <lb xml:id="p1z17"/>est, quem omnes pii precibus deo commendent.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z18"/>Quicquid audierimus, statim perscribam ad te.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z19"/>Festinantissime has scripsi, quod festinare<lb xml:id="p1z20"/>t tabellio."</s>
					<s n="8" xml:lang="la">Haec ad verbum <persName ref="p8033">Beza</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Caeterum <lb xml:id="p1z21"/>velim ista tibi adhuc serves, non spargas, <lb xml:id="p1z22"/>donec audierimus certiora.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ego maxime sum <lb xml:id="p1z23"/>solicitus, qui audio ex <placeName ref="l791">Valesia</placeName> <placeName ref="l466">Seduno</placeName> de<lb xml:id="p1z24"/>tectum ibidem etiam conatum cuiusdam capita<lb xml:id="p1z25"/>nei, qui exteros sclopetarios in vallem <lb xml:id="p1z26"/>introducere voluit, quibuscum malevoli <lb xml:id="p1z27"/>se iunxissent, intelligis, quo loco res fidelium <lb xml:id="p1z28"/>fuissent.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Detecto scelere fuga elapsus <lb xml:id="p1z29"/>est capitaneus; indignantur caeteri.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Metuendum, <lb xml:id="p1z30"/>ne inde quis moveatur motu<note type="margin">dazu a.R.: "Sed retineamus et haec nobis, donec certiora audierimus."</note>.</s>
					<s n="13" xml:lang="la">Oremus dominum<lb xml:id="p1z31"/>, ut is vigilet pro nobis et servet a <lb xml:id="p1z32"/>malo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Festinanter et hac scribo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z33"/>Hodie et hac septimana nullas a te accepi.</s>
					<s n="17" xml:lang="la" ana="farewell"><lb xml:id="p1z34"/>Iterum iterumque vale.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName> sub vesperam <lb xml:id="p1z35"/>22. octobris 1563.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z36"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabricio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>fideli ministro, domino <lb xml:id="p2z4"/>meo colendissimo et <lb xml:id="p2z5"/>charissimo.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
