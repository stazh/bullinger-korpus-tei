	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Literae tuae 23. maii huius anni scriptae
					<lb xml:id="p1z2"/>mihi sunt redditae fueruntque gratissimae. et
					<lb xml:id="p1z3"/>quamvis modo non haberem argumentum te
					<lb xml:id="p1z4"/>paucula tamen haec exarare volui
					<lb xml:id="p1z5"/>ex quibus intelligeres me accepisse tua.
					<lb xml:id="p1z6"/>in pristino amore et studio tui perse.
					<lb xml:id="p1z7"/>vverare constanter. Invideo ergo tibi illum
					<lb xml:id="p1z8"/>morbum continuum. Sed quia nihil fit sine pro
					<lb xml:id="p1z9"/>videntia optimi creatoris nostri et hic nos
					<lb xml:id="p1z10"/>samat impensissime, quod imponit portandm
					<lb xml:id="p1z11"/>overis, ut prosit et provehat nos,
					<lb xml:id="p1z12"/>Nec deerit nobis spiritu suo orantibus
					<lb xml:id="p1z13"/>Quanto vero magis deteritur corpus tanto
					<lb xml:id="p1z14"/>magis spiritus grandescit et confirmatur aspi.
					<lb xml:id="p1z15"/>ad futuram gloriam. Quod ecclesiam
					<lb xml:id="p1z16"/>et rempublic nostram attinet in eodem sententiam
					<lb xml:id="p1z17"/>statu sunt omnia. Dominus servet et tueatur nos
					<lb xml:id="p1z18"/>Non ignoramus, quantum sathanas per nteri
					<lb xml:id="p1z19"/>renica doctrinam affectet interimere animae
					<lb xml:id="p1z20"/>multorum. Caeterum fortiter pugnandum
					<lb xml:id="p1z21"/>nobis. Turbas et bella praedixit nobis dominus
					<lb xml:id="p1z22"/>Hunc oremus, ut confirmet. Sine hoc nihi
					<lb xml:id="p1z23"/>possumus. Discordia Argentinensis perdet
					<lb xml:id="p1z24"/>Argentinam. Dominus malum tollat est medio
					<lb xml:id="p1z25"/>Audio omnia huc dirigi, ut celebretur concilis
					<lb xml:id="p1z26"/>ad quod maxime aspirat pontifex
					<lb xml:id="p1z27"/>sentit enim illo se restituendum in interi
					<lb xml:id="p1z28"/>et verebatur quidem nostra ingratii
					<lb xml:id="p1z29"/>tenebras. Sed dominus pro neffabili
					<lb xml:id="p1z30"/>sua misericordia invertat et dissipet
					<lb xml:id="p1z31"/>onsilium Achitophelis et servet nos in conce
					<lb xml:id="p1z32"/>cofessione nominis sui. amem. Salutant te fratre
					<lb xml:id="p1z33"/>omnes inprimis generi mei duo Huld Zvin
					<lb xml:id="p1z34"/>et Ludovicus Lavaterus etc
					<lb xml:id="p1z35"/>1.iunii 1550. Saluta fratres imprim
					<lb xml:id="p1z36"/>regium nostrum
					<lb xml:id="p1z37"/>Bullingerus tuus.
					<pb/>
					<lb xml:id="p2z1"/>Praestantissimo viro d.
					<lb xml:id="p2z2"/>Matthiae Erbio
					<lb xml:id="p2z3"/>ministro ecclesiae
					<lb xml:id="p2z4"/>Rychenylensis, domino
					<lb xml:id="p2z5"/>et fratri colendissimo.
					<lb xml:id="p2z6"/>suo.
				</p>
			</div>
		</body>
