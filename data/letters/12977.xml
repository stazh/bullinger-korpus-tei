			<zone xml:id="p2z2-0" points="1007,2027 1139,2051 1200,2021 1252,2049 1323,2014 1400,2038 1443,2005 1566,2004 1643,2046 1717,2022 1719,1977 1589,1957 1536,1981 1440,1953 1306,1984 1242,1954 1201,1991 1138,1961 1008,1980">1012,2025 1047,2022 1082,2020 1118,2019 1153,2018 1189,2016 1224,2013 1259,2011 1295,2008 1330,2007 1366,2007 1401,2007 1436,2005 1472,2003 1507,2001 1543,2001 1578,2001 1613,2001 1649,2000 1684,1998 1720,1998</zone>
			<zone xml:id="p2z3-0" points="1009,2120 1069,2089 1136,2127 1185,2097 1323,2082 1685,2081 1687,2041 1549,2010 1425,2053 1333,2016 1238,2059 1012,2061">1015,2093 1048,2086 1082,2084 1115,2083 1149,2081 1183,2079 1216,2078 1250,2077 1283,2075 1317,2073 1351,2072 1384,2071 1418,2069 1451,2069 1485,2068 1519,2066 1552,2066 1586,2064 1619,2063 1653,2062 1687,2060</zone>
			<zone xml:id="p2z4-0" points="1197,2167 1330,2182 1504,2156 1564,2192 1720,2194 1724,2065 1518,2096 1323,2082 1266,2107 1199,2091">1203,2132 1229,2135 1255,2137 1281,2138 1307,2136 1333,2135 1359,2135 1385,2135 1411,2135 1437,2135 1463,2134 1489,2133 1515,2132 1541,2132 1567,2132 1593,2131 1619,2128 1645,2125 1671,2123 1697,2122 1723,2120</zone>
