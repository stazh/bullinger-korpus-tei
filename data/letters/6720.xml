			<zone xml:id="p2z32-0" points="639,3580 1241,3543 1446,3575 1552,3538 1693,3585 1816,3526 2043,3600 2591,3575 2596,3462 2218,3430 2095,3489 1883,3452 1577,3492 1535,3459 1251,3516 1115,3462 1068,3501 987,3477 639,3548">653,3568 750,3563 847,3556 944,3548 1042,3544 1139,3540 1236,3534 1334,3531 1431,3527 1528,3521 1626,3517 1723,3515 1820,3510 1917,3510 2015,3509 2112,3509 2209,3506 2307,3506 2404,3509 2501,3509 2599,3506</zone>
