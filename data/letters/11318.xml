	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Conditio mea talis <placeName ref="l28">Basileae</placeName> fuit, quemadmodum iamdudum scripsi<note xml:id="fn1" type="footnote" n="1">Oben <ref target="file11265">Nr. 1222</ref>.</note>, <lb xml:id="p1z2"/>ut inde mensam haberem et 24 florenos.</s>
					<s n="3" xml:lang="la">Sed quoniam <lb xml:id="p1z3"/>discipuli omnes<note xml:id="fna" type="footnote" n="a">vor omnes <hi>gestrichenes</hi> fere.</note> ex paedagogio<note xml:id="fn2" type="footnote" n="2"><persName ref="p8459">Werdmüller</persName> war Lehrer am Pädagogium (s. <bibl source="b10">HBBW VIII</bibl> <ref target="file11189">[Nr. 1146]</ref>, S. 170, Anm. 5).</note> pestem fugerunt, redeunt nulli, <lb xml:id="p1z4"/>haud immerito mensa denegatur, quae non ob aliam causam antea dabatur, <lb xml:id="p1z5"/>quam ut praelegerem in Offitiis<note xml:id="fn3" type="footnote" n="3"><persName ref="p4543">Cicero</persName>, De officiis (vgl. dazu oben <ref target="file11265">Nr. 1222</ref>, 9-11).</note> et a coena repeterem.</s>
					<s n="4" xml:lang="la">Soli r<lb xml:id="p1z6"/>emanserunt 24 floreni, propter quos in <persName ref="p19947">Herodiano</persName><note xml:id="fn4" type="footnote" n="4">Gemeint ist <persName ref="p19947">Herodians</persName> Kaisergeschichte (s. ebd.).</note> pergo; <lb xml:id="p1z7"/>et quia per annum mihi non sufficiunt 24 floreni (nam inde <lb xml:id="p1z8"/>ne mensam quidem emo, tantum abest, ut reliqua necessaria comparari <lb xml:id="p1z9"/>queant), commodissime tuas literas<note xml:id="fn5" type="footnote" n="5">Nicht erhalten.</note> nuper accipiebam de me in <lb xml:id="p1z10"/>d. <persName ref="p8428">Rellicani</persName><note xml:id="fn6" type="footnote" n="6">Offenbar war erwogen worden, <persName ref="p8428">Rhellikan</persName> als Zuchtmeister des Fraumünster-Alumnats durch <persName ref="p8459">Werdmüller</persName> zu ersetzen.</note> locum.</s>
					<s n="5" xml:lang="la">Quamvis autem nihil certi affirmabas, <lb xml:id="p1z11"/>tamen interea temporis hic <placeName ref="l28">Basileae</placeName> non aliam conditionem <lb xml:id="p1z12"/>ambivi existimans indecorum esse conditionem<pb type="edition" next="148"/> iamiam deserendam <lb xml:id="p1z13"/>vel petere vel offerre.</s>
					<s n="6" xml:lang="la">Quodsi igitur nondum est occasio <lb xml:id="p1z14"/>domum redeundi, nihil aliud abs te et ab reliquis peto collegi<lb xml:id="p1z15"/>archis<note xml:id="fn7" type="footnote" n="7">Die weiteren Schulverordneten sind nicht bekannt.</note>, quam ut vel pauci anni concedantur, quibus aliquod munus <lb xml:id="p1z16"/>sustineam, ne maiores faciam sumptus.</s>
					<s n="7" xml:lang="la">Plus satis offendi <lb xml:id="p1z17"/>patrem<note xml:id="fn8" type="footnote" n="8"><persName ref="p7018">Heinrich Werdmüller</persName>.</note> magnitudine debitorum, et merito nec ipse <lb xml:id="p1z18"/>largitur amplius nec <persName ref="p4851">Froschouerus</persName> diutius expectat, ideoque <lb xml:id="p1z19"/>vehementer oro tuam humanitatem, ne graveris obedientissimo <lb xml:id="p1z20"/>filio tuo per proximum nuntium, quid optimum visum fuerit, significar<lb xml:id="p1z21"/>e.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Vale, charissime pater, cum uxore<note xml:id="fn9" type="footnote" ana="bio" n="9"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> et <lb xml:id="p1z22"/>liberis<note xml:id="fn10" type="footnote" n="10">Siehe oben <ref target="file11260">Nr. 1217</ref>, Anm. 46. - Am Tag nach der Abfassung des vorliegenden Briefes kam <persName ref="p21014">Johannes Bullinger</persName> zur Welt (vgl. unten <ref target="file11320">Nr. 1277</ref>, Anm. 17).</note>.</s>
					<s n="9" xml:lang="la"><placeName ref="l28">Basileae</placeName>, 23. maii 1539.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/><persName ref="p8459">Otho Werdmüllerus</persName> <lb xml:id="p1z24"/>tibi deditissimus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, patri <lb xml:id="p2z3"/>suo plurimum colendo.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
