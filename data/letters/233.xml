	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Hac hora tuas accepi, <persName ref="p495">Bullingere</persName> <lb xml:id="p1z2"/>in domino charissime, quibus, quid apud inclytum <lb xml:id="p1z3"/>urbis vestrę senatum me nomine octava huius <lb xml:id="p1z4"/>mensis egeris quidque et quam facile obtinueris, <lb xml:id="p1z5"/>id videlicet, quod, cum apud vos postremo <lb xml:id="p1z6"/>essem, petii, nempe ut liceat mihi apud <lb xml:id="p1z7"/>vos sub amplissimi senatus vestri tutela et <lb xml:id="p1z8"/>umbra conquiescere.</s>
					<s n="3" xml:lang="la">Utinam invenissent me <lb xml:id="p1z9"/>literę tuę <placeName ref="l257">Constantiam</placeName> missę.</s>
					<s n="4" xml:lang="la">Verum sic visum <lb xml:id="p1z10"/>est domino.</s>
					<s n="5" xml:lang="la">Veni huc <placeName ref="l473">Sangallum</placeName> inopina illa <lb xml:id="p1z11"/>et funesta tempestate citra animi sententiam iactatus; <lb xml:id="p1z12"/>constitueram enim apud vos hęrere, maxime <lb xml:id="p1z13"/>propter doctorum hominum consortium et insignem <lb xml:id="p1z14"/>humanitatem, quam non ego modo, sed et <lb xml:id="p1z15"/>multi alii experti sunt, quamquam et hic <lb xml:id="p1z16"/>locus virum habet et doctissimum pariter et <lb xml:id="p1z17"/>humanissimum, celebrem illum <persName ref="p8049">Vadianum</persName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">At is <lb xml:id="p1z18"/>publicis sic est negotiis occupatus, ut con<lb xml:id="p1z19"/>sortio illius non admodum frui liceat.</s>
					<s n="7" xml:lang="la">Iam <lb xml:id="p1z20"/>consilium tuum, optime <persName ref="p495">Bullingere</persName>, imploro.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z21"/>Sicuti proximis literis significavi, advectę <lb xml:id="p1z22"/>sunt huc reculę meae; pro vectura illarum <lb xml:id="p1z23"/>inde a <placeName ref="l257">Constantia</placeName>, itinere 4 milliarium <lb xml:id="p1z24"/>vel, ut quidam numerant, trium, solvi flo<lb xml:id="p1z25"/>renos 24. Sumptus huiusmodi, si sint <lb xml:id="p1z26"/>aliquoties iterandi ac ferendi, erunt mihi <lb xml:id="p1z27"/>intolerabiles, nisi reliqui victus necessitatem <lb xml:id="p1z28"/>negligere velim, quod non possum.</s>
					<s n="9" xml:lang="la">Video <lb xml:id="p1z29"/>enim omnia passim esse charissima, exulibus <lb xml:id="p1z30"/>non minus quam inquilinis et civibus.</s>
					<s n="10" xml:lang="la">Videtur <lb xml:id="p1z31"/>itaque ipsa necessitate cogente rebus meis <lb xml:id="p1z32"/>consultum esse, ut caveam huiusmodi vecturas, <lb xml:id="p1z33"/>donec detur certo aliquo loco consistere.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z34"/>Qua in re opera tua et consilio opus habeo.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z35"/>Oro itaque per Christum, ut de sententia tua <lb xml:id="p1z36"/>certum me reddas.</s>
					<s n="13" xml:lang="la">Ante triduum cepit uxor <lb xml:id="p1z37"/>mea cum filiola quadam graviter decumbere.</s>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Causam morbi consternationi et angustię <lb xml:id="p2z2"/>deputo, quam oppugnatio <placeName ref="l257">Constantię</placeName> incusserat.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z3"/>Commendo et me et illam una cum meis <lb xml:id="p2z4"/>omnibus vestris precibus et fidei, quam <lb xml:id="p2z5"/>non dubito quin sitis erga me constanter <lb xml:id="p2z6"/>servaturi.</s>
					<s n="16" xml:lang="la">Oro dominum, ut vos in sua fide <lb xml:id="p2z7"/>constantes et firmos retineat.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Optime vale, <lb xml:id="p2z8"/><persName ref="p495">Bullingere</persName> doctissime.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l473">Sangalli</placeName>, 18. Augusti 1548.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z9"/><persName ref="p8417">W[olfgang<lb xml:id="p2z10"/>us] Musculus</persName>, tuus <lb xml:id="p2z12"/>in domino.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="salute"><lb xml:id="p2z13"/>Salutem fratribus et amicis <lb xml:id="p2z14"/>omnibus, cumprimis domui tuę <lb xml:id="p2z15"/>et <persName ref="p8018">Hallero</persName> meo.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="21" xml:lang="la"><lb xml:id="p2z16"/>Ornatissimo <lb xml:id="p2z17"/>viro, D. <lb xml:id="p2z18"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z19"/><placeName ref="l587">Tigurinę</placeName> ecclesię <lb xml:id="p2z20"/>antistiti fideliss<lb xml:id="p2z21"/>imo, fratri et <lb xml:id="p2z22"/>amico in Christo charissimo.</s>
				</p>
			</div>
