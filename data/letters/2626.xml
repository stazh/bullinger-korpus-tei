	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Clarissime d. <persName ref="p495">Bullingere</persName>, licet gravissimo et periculosissimo per aliquot septimanas <lb xml:id="p1z2"/>morbo laboraverim, ita ut neque legere neque scribere potuerim propter caliginem <lb xml:id="p1z3"/>oculorum et vertiginem, <lb xml:id="p1z4"/>tamen, quia audio te admodum solicitum de literis <lb xml:id="p1z5"/><persName>Iustinae</persName> abbatissae pertinentibus, non potui continere, quin scriberem, quamvis admodum vix haec <lb xml:id="p1z6"/>exaraverim, ne diutius animo suspendearis.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Scias ergo, literas praedictas sequenti die, <lb xml:id="p1z7"/>qua scriptae erant, mihi redditas, tertia statim die post per certum nuntium civem, virum bonum, <lb xml:id="p1z8"/>misi illas <placeName ref="l1228">Engen</placeName>, qui alias eo iter facturus erat, qui etiam diligentissime se curasse <lb xml:id="p1z9"/>mihi nuntiavit, neque est, quod dubites unquam de mea fide et diligentia, si quid tuarum <lb xml:id="p1z10"/>rerum mihi expediundum fuerit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Plura scribere nequeo.</s>
					<s n="5" xml:lang="la">Expectabo, ut promisisti, <lb xml:id="p1z11"/>propediem nova de conciliatione inter <persName ref="p18538">Carolum</persName> et <persName>Heinrichum</persName>, de practica episcoporum et cardina<lb xml:id="p1z12"/>lium contra dominum eiusque unctos<note type="margin">a.R.: (s)anctos</note></s>
					<s n="6" xml:lang="la">De virtute et nomine huius papae.</s>
					<s n="7" xml:lang="la">Epitaphia et <lb xml:id="p1z13"/>pasquillos in obitum Iulii 3. habeo, propediem mittam; non potui iam describere.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale iterum <lb xml:id="p1z14"/>et studiosos istos nostros tuae commendatos habeto fidei, iuvenes, ut mihi videtur, bonos, <lb xml:id="p1z15"/>qui ante etiam apud vos operam dedere literis.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale iterum.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/><placeName ref="l441">Scaphusiae</placeName> 3. martii 1555.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p2757">Iacobus Ruͤger</persName>, tuae humanitati <lb xml:id="p1z18"/>deditissimus.</s>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo, singulari doctrina <lb xml:id="p2z2"/>et pietate praedito viro d. m. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho Bullingero</persName>, antistiti <lb xml:id="p2z4"/>ecclesiae <placeName ref="l587">Tigurinae</placeName>, domino ac <lb xml:id="p2z5"/>fratri suo in Christo plurimum <lb xml:id="p2z6"/>suspiciendo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
