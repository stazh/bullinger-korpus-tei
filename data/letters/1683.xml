	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Crucior miser tuarum expectatione, quas quidem credo iam datas <lb xml:id="p1z2"/>esse; sed vehementer timeo, ne etiam ipsae pereant.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Oro <lb xml:id="p1z3"/>igitur eas renoves, praecipue ad principes.</s>
					<s n="4" xml:lang="la"><placeName ref="l3029">Warwicens<lb xml:id="p1z4"/>is</placeName> <placeName>Berwicum</placeName> magno comitatu initio maii est profectus, pro<lb xml:id="p1z5"/>pediem rediturus.</s>
					<s n="5" xml:lang="la">Dux vero noster superioribus diebus hic <lb xml:id="p1z6"/>prope <placeName ref="l376">Oxonium</placeName> fuit in praedio, quod illi ex haereditate demor<lb xml:id="p1z7"/>tui <placeName ref="l1956">Suffolciensis</placeName> obvenit.</s>
					<s n="6" xml:lang="la" ana="salute">Accessi illum, et de more academi<lb xml:id="p1z8"/>ae salutavi.</s>
					<s n="7" xml:lang="la">Is sodolitio nostro tres damas rogatu <lb xml:id="p1z9"/>meo donavit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">De te autem (ita vivam) peramanter, quid <lb xml:id="p1z10"/>agas, quid valeas interrogavit.</s>
					<s n="9" xml:lang="la">Cui ego quae visa sunt respondi.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z11"/>Tuum nunc est, tuae sunt partes ut quamprimum <lb xml:id="p1z12"/>rescribas.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z13"/>Fac, obsecro, ut intelligam me meaque tibi <lb xml:id="p1z14"/>curae fuisse; quod fiet, si <persName>Alexandri</persName> in tua ad <placeName ref="l1909">War<lb xml:id="p1z15"/>wicensem</placeName> epistola in eam quam volo partem mentionem <lb xml:id="p1z16"/>feceris.</s>
					<s n="12" xml:lang="la" ana="salute"><lb xml:id="p1z17"/>Salutem tibi dicit <persName ref="p8506">Scinnerus</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="de"><persName ref="p8111">Mar<lb xml:id="p1z18"/>tyr</persName> abest.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z19"/><placeName ref="l376">Oxonii</placeName>, 6 calend. augusti, <lb xml:id="p1z20"/>raptim.</s>
					<s n="15" xml:lang="la"><persName>Chirothecae</persName> bona fide uxori tuae reddentur.</s>
					<s n="16" xml:lang="la" ana="farewell"><lb xml:id="p1z21"/>Vale, mi charissime et observandissime <persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z22"/>Tuae amplitudini <lb xml:id="p1z23"/>addictissimus, <lb xml:id="p1z24"/><persName ref="p20172">Iwhannes ab Ulmis</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Bullingero</persName>, <placeName ref="l587">Tiguri</placeName>, <lb xml:id="p2z3"/>domino suo colen<lb xml:id="p2z4"/>dissimo.</s>
				</p>
			</div>
		</body>
	</text>
