	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Confessio <placeName ref="l894">4 urbium</placeName><note xml:id="fn1" type="footnote" n="1">Zur Confessio <placeName ref="l894">Tetrapolitana</placeName> s. oben <ref target="file10814">Nr. 776</ref>, Anm. 2.</note> <lb xml:id="p1z2"/>nobis non admodum adversa est, nec in ea in<lb xml:id="p1z3"/>venimus quicquam, quod displiceat.</s>
					<s n="3" xml:lang="la">Unde illam <lb xml:id="p1z4"/>recepimus veluti nostrae<note xml:id="fn2" type="footnote" n="2">Gemeint ist das Erste <placeName ref="l862">Helvetische</placeName> Bekenntnis (s. oben <ref target="file10775">Nr. 737</ref>, Anm. 1).</note> non adversam idque <lb xml:id="p1z5"/>coram senatu palam testati sumus<note xml:id="fn3" type="footnote" n="3">Vgl. oben <ref target="file10852">Nr. 813</ref>, Anm. 6.</note>.</s>
					<s n="4" xml:lang="la">Verum <lb xml:id="p1z6"/>pluscula de hac re hen scripsimus ad <placeName ref="l2">Aarouiam</placeName><note xml:id="fn4" type="footnote" n="4">Gemeint ist wohl der am Vortag geschriebene und offenbar den nach <placeName ref="l2">Aarau</placeName> reisenden Gesandten mitgegebene Brief an <persName ref="p8418">Myconius</persName> (oben <ref target="file10852">Nr. 813</ref>; vgl. dort Anm. 5).</note>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Caussam exulum <placeName ref="l760">Solodoren<lb xml:id="p1z8"/>sium</placeName> <lb xml:id="p1z9"/>tam mihi crede commendatam quam commendatissima<lb xml:id="p1z10"/>m<note xml:id="fn5" type="footnote" n="5">Siehe oben <ref target="file10852">Nr. 813</ref>, 2 mit Anm. 1.</note>.</s>
					<s n="6" xml:lang="la">Ego omnem movebo lapidem<note xml:id="fn6" type="footnote" n="6">Zur Redensart vgl. <bibl source="b56">Adagia</bibl>, 1, 4, 30 (<bibl source="b370">LB</bibl> II 161f).</note>, sed quid <lb xml:id="p1z11"/>promoveam, dominus novit.</s>
					<s n="7" xml:lang="la">Certe multi nostrorum <lb xml:id="p1z12"/>non placent mihi nec suadenti obsequuntur.<note xml:id="fn7" type="footnote" n="7">Am 4. und 6. Mai wurde über das weitere Vorgehen der <placeName ref="l587">Zürcher</placeName> Schiedboten beraten: aus ihrer Instruktion (Zürich StA, B VIII 3, f. 120r.-122r.) wird deutlich, daß der Rat den Forderungen der "Banditen" zurückhaltend gegenüberstand und vor allem an der raschen Beilegung des Konflikts interessiert war.</note>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb type="edition" next="275"/><lb xml:id="p1z13"/>Valebis et pro me Orabis dominum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Calendis <lb xml:id="p1z14"/>maii anno 1536.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><persName ref="p495">H<lb xml:id="p1z15"/>. Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="11" xml:lang="de"><lb xml:id="p1z16"/>Der unsinnig<note xml:id="fn8" type="footnote" n="8">Ein unbekannter Verrückter (<bibl source="b590">SI</bibl> VII 1070f).</note> was hütt hie.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z17"/>Suggestor.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z18"/>Suspendantur omnes.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z19"/>Sic <persName ref="p3242">Utingerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p8418">Osvaldo Myconio</persName>, <lb xml:id="p2z3"/>fratri charissimo.</s>
				</p>
			</div>
		</body>
