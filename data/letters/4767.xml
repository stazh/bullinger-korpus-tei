	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve in domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Vir dei observandissime, proximis diebus ad te scripsi et <lb xml:id="p1z3"/>Christi causam, quae in ecclesia nostra tuo favore eget, tibi commendavi; nunc vero <lb xml:id="p1z4"/><persName ref="p2336">Bernardini</persName> nostri, qui alias ut nosti, eo tempore, quo <persName ref="p3018">Stancarus</persName> et <lb xml:id="p1z5"/>alii nonnulli me molestiis afficerent, a quibus gratia dei et tua ope liberatus <lb xml:id="p1z6"/>fui, mihi ad te venienti fidus comes fuit, puerum tibi commendo.</s>
					<s n="3" xml:lang="la">Scio <lb xml:id="p1z7"/>enim, quod, ubi potes benefacere, nullius hominis commendatione eges; verum <lb xml:id="p1z8"/>bonus homo ac simplex me rogavit, ut ad te scriberem, putans <lb xml:id="p1z9"/>commendationem meam tibi gratam fore.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Quare te rogo, ne eum sua fallat <lb xml:id="p1z10"/>opinio, quin imo videat, quod immerentes etiam tua gratia complect rus.</s>
					<s n="5" xml:lang="la">Dominus Iesus <lb xml:id="p1z11"/>Christus te diu nobis et sue ecclesie servet incolumem, reveren<lb xml:id="p1z12"/>dissime <lb xml:id="p1z13"/>atque hu<lb xml:id="p1z14"/>manissime domine.</s>
					<s n="6" xml:lang="la"><placeName ref="l93">Clavene</placeName> 24. aprilis 1561<note type="misc">korrig. viell. 1551?</note></s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/><persName ref="p2019">Augustinus Mainardus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
