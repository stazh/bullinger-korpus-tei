	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Mitto ad te, mi pater, coronatos solares
					<lb xml:id="p1z2"/>septem cum dimudio, item pistoletum ununia
					<lb xml:id="p1z3"/>et quinque solidos nostrates, quant
					<lb xml:id="p1z4"/>vemierunt reculae Biblianari nostri
					<lb xml:id="p1z5"/>ipsi
					<lb xml:id="p1z6"/>duobus florenis iostratibus sdesbat
					<lb xml:id="p1z7"/>circiter decem, quos praeconi et aestimuator
					<lb xml:id="p1z8"/>numeram. Mitto etiam exemplum auctionis
					<lb xml:id="p1z9"/>complectens, quid cuique quo pretio sit
					<lb xml:id="p1z10"/>addictum. De pilcis naieram oblitus
					<lb xml:id="p1z11"/>Sed quod postulabas, no potui a Roselis
					<lb xml:id="p1z12"/>competrare. Egras  stuc proficiscens corant
					<lb xml:id="p1z13"/>aget. De rebus nostris audie
					<lb xml:id="p1z14"/>ex Pitheo nostro cuiusmodi sint
					<lb xml:id="p1z15"/>arecentis nostrae cum Sabausa
					<lb xml:id="p1z16"/>pacificatiorus. Precare dominum, ut nos
					<lb xml:id="p1z17"/>tandem a tam perfidiosis hominibus
					<lb xml:id="p1z18"/>liberet. Ipsum autem Piteum hominem
					<lb xml:id="p1z19"/>optimum et eruditissimum, addo etiam
					<lb xml:id="p1z20"/>mihi amicissimum, velim etiam a te
					<lb xml:id="p1z21"/>cognosci ac diligi, quod esse sciam,
					<lb xml:id="p1z22"/>bonorum et doctorum omnium amore plane
					<lb xml:id="p1z23"/>dignum, qui cum illo est, civis noster
					<lb xml:id="p1z24"/>istuc abit cum filio, quem vel permutatione
					<lb xml:id="p1z25"/>vel alio quovis modo cupit istic collocare.
					<lb xml:id="p1z26"/>Itaque velim eum tibi esse commenda.
					<lb xml:id="p1z27"/>et me quoque apud te excusatum
					<lb xml:id="p1z28"/>quod eiusmodi petitionibus obtundere te
					<lb xml:id="p1z29"/>non desinam. De rebus Gallicis. Coactus
					<lb xml:id="p1z30"/>est amiralius omissa Montlimardi
					<lb xml:id="p1z31"/>obsidione (salsum enim erat, quod de
					<lb xml:id="p1z32"/>expugnatione nuntiatum nobis fuit) statiu
					<lb xml:id="p1z33"/>ad se copicis, quae Rhodanum transrerant
					<lb xml:id="p1z34"/>revocare, quamvis totus ei dedfinctus iam
					<lb xml:id="p1z35"/>pateret, minime id quidem, quod motuendum
					<lb xml:id="p1z36"/>esset hostis, sed quod omnis ipsius peditatus
					<lb xml:id="p1z37"/>domum dilaberetur. Iaque exercitum coactus
					<lb xml:id="p1z38"/>in Arvernorum fines traducere, ubi
					<pb/>
					<lb xml:id="p2z1"/>fertilis est regio et urbes parum numire
					<lb xml:id="p2z2"/>Omnia per ovant pacis mitae crumeribus.
					<lb xml:id="p2z3"/>quos tamen inanissimos esse adhuc mihi
					<lb xml:id="p2z4"/>persuadeo. Frater meus unicus tandem
					<lb xml:id="p2z5"/>Vegeliis discipsus, salvus ad me venit,
					<lb xml:id="p2z6"/>sed relictis in urbe quinque liberis cu
					<lb xml:id="p2z7"/>uxore idque in maximo periculo non
					<lb xml:id="p2z8"/>ab hoste, quem nostri Vezelii
					<lb xml:id="p2z9"/>nihil prorsus metuunt, sed a pestis contagione
					<lb xml:id="p2z10"/>Itaque totus nunc in eo sum, ut si fieri
					<lb xml:id="p2z11"/>potest, reliquias nostrae familiae utcuque
					<lb xml:id="p2z12"/>colligam, tantisper, dum deseivant haec
					<lb xml:id="p2z13"/>tempestas. Nuntiar frater lecentos
					<lb xml:id="p2z14"/>ex postremis Helvetiis, quim adhc
					<lb xml:id="p2z15"/>a nostris discurdastibus
					<lb xml:id="p2z16"/>itinere essent, interceptos  fuisse non pie
					<lb xml:id="p2z17"/>senovibus. caeteros tandem senabum ad
					<lb xml:id="p2z18"/>ligerim pervenisse, ubi frustra iam telu
					<lb xml:id="p2z19"/>Equimensem expectantur Gallorum peditum
					<lb xml:id="p2z20"/>et equilum turmae omnibus
					<lb xml:id="p2z21"/>fere militiam longiorem detrectantibus.
					<lb xml:id="p2z22"/>Sed de his plus satis. Mitto istuc meum
					<lb xml:id="p2z23"/>ad d. Erasti argumenta responsum una
					<lb xml:id="p2z24"/>cum literis ad d. Gvalterum nostrum, obsecro,
					<lb xml:id="p2z25"/>mi pater, ne hoc accipias quasi vel
					<lb xml:id="p2z26"/>tantillum pravae suspicionis animo conces
					<lb xml:id="p2z27"/>.Absit enim hoc a nobis. Volui
					<lb xml:id="p2z28"/>enquum Ionullae noster occasionem
					<lb xml:id="p2z29"/>mihi de hac re scribendi necessariam.
					<lb xml:id="p2z30"/>praebuisset, haec vobis charissimis in domino
					<lb xml:id="p2z31"/>fratribus candide et syncere significata,
					<lb xml:id="p2z32"/>quae alioqui semel contemnere decreveram.
					<lb xml:id="p2z33"/>ut cognita veteris ininc
					<pb/>
					<lb xml:id="p3z1"/>per istos fusurrones nos adorientis versutia
					<lb xml:id="p3z2"/>communibus consiliis ipsi utrinque occurramus.
					<lb xml:id="p3z3"/>quod meum studium libi, mi frater
					<lb xml:id="p3z4"/>observando vestro collegio gratum fore mihi
					<lb xml:id="p3z5"/>persuasi. Bene vale. Dom. Iesus te custodiat
					<lb xml:id="p3z6"/>ab omni malo tuisque sanctis laboribus
					<lb xml:id="p3z7"/>magis ac magis benedicat. Genevae
					<lb xml:id="p3z8"/>29. maii 1570.
					<lb xml:id="p3z9"/>Tuus Berza.
					<pb/>
					<lb xml:id="p4z1"/>1. huartii 1550.
					<lb xml:id="p4z2"/>Oximnio Christi servo,
					<lb xml:id="p4z3"/>D.Henrico Bullingero,
					<lb xml:id="p4z4"/>patri mil plurimum
					<lb xml:id="p4z5"/>observando.
					<lb xml:id="p4z6"/><placeName ref="l587">Tigurinae</placeName> erla
					<lb xml:id="p4z7"/>fido pastori
					<lb xml:id="p4z8"/>aeber schicht s Bucllingerun, das ou
					<lb xml:id="p4z9"/>Biblianori, Fillinderum und andir i Bbaynn
					<lb xml:id="p4z10"/>erlostn gudt buguht in gas bewandnuß
					<lb xml:id="p4z11"/>beis en milt dien cafforgine setzund
					<lb xml:id="p4z12"/>1530.
				</p>
