	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hodie ad nos rumor advolavit senatum populumque <placeName ref="l291">Lindavie[n]sem</placeName> vel re<lb xml:id="p1z2"/>clamante plebe infame illud Interim acceptasse.</s>
					<s n="3" xml:lang="la">Arbitror autem hoc ipsum <lb xml:id="p1z3"/>sine codictionibus aliquibus clam pactis factisque non accidisse, quum sit verisi<lb xml:id="p1z4"/>mile hoc unum veritos esse Caesarianos, ne sibi artibus qualibuscunque huius urbis <lb xml:id="p1z5"/>comodissimus usus eriperetur.</s>
					<s n="4" xml:lang="la">Olfaciunt certe nescio quid, quod ut faustum <lb xml:id="p1z6"/>sit nobis, dominum oramus.</s>
					<s n="5" xml:lang="la"><placeName ref="l257">Constantiam</placeName> certe nollem <placeName ref="l862">Helvetiae</placeName> eripi, urbem <lb xml:id="p1z7"/>tot modis vel servandis nobis vel perdendis vel certe misere vexandis <lb xml:id="p1z8"/>mire accom[m]odam.</s>
					<s n="6" xml:lang="la">Sed speramus, aliquid praesentia commitia daturos agro <lb xml:id="p1z9"/>Durgauico.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><persName ref="p8417">Musculus</persName> apud nos agit cum <persName ref="p20374">uxore</persName> et liberis, vir non doctrina <lb xml:id="p1z10"/>modo, sed etiam integritate commendatus, cuius literas hisce meis annexas <lb xml:id="p1z11"/>mittimus.</s>
					<s n="8" xml:lang="la">Pridie advecta ei suppellex omnis una cum libris ex <placeName ref="l18">Augusta</placeName> est.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z12"/>Dabis operam, ut insigni alicui et frequenti ecclesiae praeficiatur.</s>
					<s n="10" xml:lang="la">De doctrinae <lb xml:id="p1z13"/>sanitate ambigendum non est, longe minus de ulla re alia, quae turbare aut <lb xml:id="p1z14"/>offendere coetum ullum possit.</s>
					<s n="11" xml:lang="la">Spiram versus moturum aiunt <persName ref="p18538">Caesarem</persName>; inde <lb xml:id="p1z15"/>fortasse telam suam redordietur et <placeName ref="l491">Argentoratum</placeName> primum, deinde alias urbes, <lb xml:id="p1z16"/>quae ad <placeName ref="l2459">Rhenum</placeName> iacent, suos praesules ut recipiant, coget.</s>
					<s n="12" xml:lang="la">Res ipsa con<lb xml:id="p1z17"/>vincit, totum hoc bellum, quod cum <placeName ref="l822">Germanis</placeName> <persName ref="p18538">Caesar</persName> gerit, alio fine magis susceptum <lb xml:id="p1z18"/>non esse, quam ut opprimatur religio, quam ferre pontificum insania nequit.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z19"/>Quod reliquum erit malorum, non modo religioni, sed libertati etiam nostrae <lb xml:id="p1z20"/>imminebit.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l473">Sangalli</placeName>, IVI. die Augusti, anno MDXLVIII.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z21"/><persName ref="p8049">Ioachimus Vadianus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro D. <persName ref="p495">Henrycho <lb xml:id="p2z2"/>Bullingero</persName>, amplissimae ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>episcopo, domino suo inprimis colendo.</s>
				</p>
			</div>
		</body>
