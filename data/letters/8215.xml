	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Cum bibliopola compater ad humanitatem tuam, vir <lb xml:id="p1z3"/>clarissime et pater in Christo venerande iter suum institueret, <lb xml:id="p1z4"/>nolui illum vel salutandi saltem gratia absque schedula <lb xml:id="p1z5"/>dimittere.</s>
					<s n="3" xml:lang="la">Sententiam de casu matrimoniali, quam <lb xml:id="p1z6"/>amici optimi viri nomine petebam, accepimus; qua <lb xml:id="p1z7"/>utrique nostrum abunde satisfactum cum sit, summas <lb xml:id="p1z8"/>vobis pro hoc officio et labore gratias agimus.</s>
					<s n="4" xml:lang="la">Re<lb xml:id="p1z9"/>mitto autem d. iudicis schedulam, ut volebas.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Ex <placeName ref="l301">Lugduno</placeName> ad negociatores nostrates de certa in <lb xml:id="p1z11"/><placeName ref="l832">Galliis</placeName> pace facta scribitur, quibus autem conditionibus, <lb xml:id="p1z12"/>non additur, et quid sibi nova nostrorum expeditio <lb xml:id="p1z13"/>velit, multi mirantur.</s>
					<s n="6" xml:lang="la">Audio imperatorem cum <lb xml:id="p1z14"/>fratribus dira minitari <placeName ref="l513">Ulmensibus</placeName>, nisi canonicos <lb xml:id="p1z15"/>ex suo eiectos templo restituant, et fertur imperatoris <lb xml:id="p1z16"/>conventum haberi <placeName ref="l396">Pragae</placeName>, cui et elector Saxo <lb xml:id="p1z17"/>intersit, aliumque indictum esse <placeName ref="l361">Noribergae</placeName> atque <lb xml:id="p1z18"/>insuper comitia <placeName ref="l471">Spirae</placeName>.</s>
					<s n="7" xml:lang="la">Multi mira consilia occulte <lb xml:id="p1z19"/>ubique fere in imperio agitari asserunt.</s>
					<s n="8" xml:lang="la">Utinam <lb xml:id="p1z20"/>nostri domi sese continerent suaque solicite curarent, n<lb xml:id="p1z21"/>e, ut dudum maeriti sumus, pęnas alias patriae <lb xml:id="p1z22"/>imminentes suis furiis accelerarent.</s>
					<s n="9" xml:lang="la">Plerique <lb xml:id="p1z23"/>omnia funesta ominantur <placeName ref="l2477">Palatino</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Rudera <lb xml:id="p1z24"/>imperii prorsus interitura videntur.</s>
					<s n="11" xml:lang="la">In omnibus his <lb xml:id="p1z25"/>malis et periculis nemo est, qui poenitentiam agat <lb xml:id="p1z26"/>et veniam deprecetur.</s>
					<s n="12" xml:lang="la">Civitatum, quae in <placeName ref="l862">Helvetia</placeName> <lb xml:id="p1z27"/>puram evangelii doctrinam profitentur, officiium erat <lb xml:id="p1z28"/>compescere sociorum furorem et tyrannidem <lb xml:id="p1z29"/>iustis piisque rationibus exemplo maiorum arcere <lb xml:id="p1z30"/>ab innocentum sanguine; sed dormitant et <lb xml:id="p1z31"/>connivent plerique nescio quo praetextu.</s>
					<s n="13" xml:lang="la">Christus <lb xml:id="p1z32"/>eiusque calamitosissima membra misere negliguntur; <lb xml:id="p1z33"/>sequentur igitur inevitabiles poenae.</s>
					<s n="14" xml:lang="la">Utinam <lb xml:id="p1z34"/>pax sit in diebus nostris, quam equidem aliquas <lb xml:id="p1z35"/>adhuc reliquias summa difficultate conservare <lb xml:id="p1z36"/>dubium non est; sed desino conqueri plura.</s>
					<s n="15" xml:lang="la">Tuam <lb xml:id="p1z37"/>humanitatem oro, ut, si certiora habes, nobis quoque <lb xml:id="p1z38"/>eam potissimum ob causam communices, ut ardentioribus <lb xml:id="p1z39"/>votis mole periculorum pressi divinam clementiam <lb xml:id="p1z40"/>imploremus et aliquos saltem ex hoc postremo <lb xml:id="p1z41"/>mundi diluvio eripiamus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell">Vale.</s>
					<s n="17" xml:lang="la">21. martii <lb xml:id="p1z42"/>1570.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z43"/>Tuae humanitatis studiosissimus <lb xml:id="p1z44"/><persName ref="p8109">Ioannes Conradus Ulmerus</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro eximio Christi servo <lb xml:id="p2z2"/>d. <persName ref="p495">Henrico Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>antistiti fidelissimo, amico et patri suo <lb xml:id="p2z4"/>in Christo summe colendo.</s>
				</p>
			</div>
