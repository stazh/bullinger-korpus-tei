	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Dilecte fili, nihil nunc, quod scribam, <lb xml:id="p1z2"/>habeo.</s>
					<s n="3" xml:lang="la">Tuas expecto una cum libello <lb xml:id="p1z3"/>mihi promisso De divinationis generibus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Valemus sic satis recte omnes.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Cura has inclusas.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute"><lb xml:id="p1z6"/>Singulariter vero salutato d. d. <lb xml:id="p1z7"/><persName ref="p8121">Christophorum <lb xml:id="p1z8"/>Montium</persName>; ora, ne aegre ferat, quod n<lb xml:id="p1z9"/>ihil <lb xml:id="p1z10"/>nunc scribo; nam opprimor <lb xml:id="p1z11"/>et enecor <lb xml:id="p1z12"/>negotiorum turbis.</s>
					<s n="7" xml:lang="la" ana="farewell">Vive et vale.</s>
					<s n="8" xml:lang="la" ana="salute">Saluta d. <lb xml:id="p1z13"/><persName ref="p8362">Garnerium</persName>, <placeName ref="l832">Gallicanae</placeName> ecclesiae antistitem.</s>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z14"/>Salutant te nostri omnes.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/><placeName ref="l587">Tiguri</placeName> 22. martii.</s>
					<s n="11" xml:lang="la">Bene collo<lb xml:id="p1z16"/>cato tempus.</s>
					<s n="12" xml:lang="la" ana="salute"><lb xml:id="p1z17"/>Saluta amicissime herum et heram.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p495">Bullingerus</persName> pater.</s>
				</p>
				<p>
					<s n="14" xml:lang="de"><pb/><lb xml:id="p2z1"/>Sinem lieben sun <persName ref="p487">Heinrych<lb xml:id="p2z2"/>en Bullingern</persName> by <lb xml:id="p2z3"/>herren <persName ref="p505">Johann Burckherrn</persName>, <placeName ref="l830">Engel<lb xml:id="p2z4"/>lendern</placeName>, zuͦ <placeName ref="l491">Straßburg</placeName>.</s>
				</p>
				<p>
					<note>[Notiz von <persName ref="p495">Bullinger</persName> jun.:]</note>
					<s n="15" xml:lang="la">5<lb xml:id="p2z5"/>4. martii 22.</s>
				</p>
			</div>
		</body>
	</text>
