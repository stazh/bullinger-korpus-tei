	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">Mitto ad te tres caseos ex <placeName>Bressia</placeName> et <placeName>Tarct</placeName> sia.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Nuper respondi <lb xml:id="p1z3"/>tuis literis.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Scis <persName>electorem Palatinum</persName> obiisse, ei successurus <persName>Fridericus Symmeren</persName>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z4"/>Nondum in <placeName ref="l825">Dania</placeName> omnia tranquilla nec in <placeName ref="l267">Colonia</placeName>.</s>
					<s n="6" xml:lang="la">Turca incursionem fecit <lb xml:id="p1z5"/>in <placeName ref="l777">Tirol</placeName> et cepit quoddam castrum imperatoris.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">De pace nihil adhuc intellexi.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z6"/>Commendo tibi filium et vellem illum abstinere a vino aut dilutum admodum <lb xml:id="p1z7"/>bibere.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Nescio, quos processus fecit in literis.</s>
					<s n="10" xml:lang="la" ana="salute">Saluta d. d <persName ref="p8111">Martirem</persName> <lb xml:id="p1z8"/>et <persName ref="p8011">Galterum</persName> et amicos.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l760">Soluturi</placeName> ultima februarii.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z9"/>Tuus ex voto quem nosti.</s>
				</p>
				<p>
					<note type="address">[Adresse von anderer Hand:]</note>
					<s n="14" xml:lang="de"><pb/><lb xml:id="p2z1"/>An herren <persName ref="p495">Heinrichen <lb xml:id="p2z2"/>Bullinger</persName>, <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
