	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Utrasque tuas recepi literas optimu frater
					<lb xml:id="p1z2"/>et quas misiste per Altorfferum Baptima Iudaeum
					<lb xml:id="p1z3"/>et per christianum. Neutri pro voto respondere
					<lb xml:id="p1z4"/>potui. Magna est apud nos inopum turba, ni
					<lb xml:id="p1z5"/>dei gratia studiosorum numerus. Cui
					<lb xml:id="p1z6"/>autem indigenis nondum pro necessitate
					<lb xml:id="p1z7"/>succrrimus, quid alienigenis faceremus.
					<lb xml:id="p1z8"/>Non tamen indonati discesserunt. Orat d.
					<lb xml:id="p1z9"/>Hallerus, ne sibi tales commendem, cum alio
					<lb xml:id="p1z10"/>qitalium sit plus satis. Vehementer me
					<lb xml:id="p1z11"/>huiusmodi errones, quibus ut supe
					<lb xml:id="p1z12"/>ferre non possum, ita minime tutum est
					<lb xml:id="p1z13"/>illis adesse, si possis. Miseret me tamen
					<lb xml:id="p1z14"/>Mense si bene memum iuno nisi
					<lb xml:id="p1z15"/>ad te literas una cum colligatis aut inclusis
					<lb xml:id="p1z16"/>libellis d. a Rapoltzsteu inscriptis. orandu
					<lb xml:id="p1z17"/>ut commode ad eam perferri curares. Nunc autem
					<lb xml:id="p1z18"/>acceptis literis eius suspicor illam nihil
					<lb xml:id="p1z19"/>accepisse. Quid ergo factum est? Fortassis cue
					<lb xml:id="p1z20"/>non inveneris, cum fideres, retines
					<lb xml:id="p1z21"/>adhuc. Trade ergo huic. Fervent diversa
					<lb xml:id="p1z22"/>in Galliis studia, coetus erit hoc mense
					<lb xml:id="p1z23"/>doctorum. Horum alii nituntur causam religionis
					<lb xml:id="p1z24"/>subdere conciliu Tridentino; alii sperant
					<lb xml:id="p1z25"/>colloquium in Gallia instituendum. de quo
					<lb xml:id="p1z26"/>quaedam hisce diebus vobis communicata sant
					<lb xml:id="p1z27"/>et consultata inter magratum et ministros. ora
					<lb xml:id="p1z28"/>dominum, ut res feliciter cadat. Si quid
					<lb xml:id="p1z29"/>hatnes memoratu dignum, fac communices.
					<lb xml:id="p1z30"/>et quid factum sit a te in causa librorum
					<lb xml:id="p1z31"/>de quibus nupter ad te. Vale. Saluta d. Berre
					<lb xml:id="p1z32"/>Wyssenburgium Oporinum Narcum
					<lb xml:id="p1z33"/>Salutant te nostri. Tiguri 1. augusti
					<lb xml:id="p1z34"/>1561.
					<lb xml:id="p1z35"/>A
					<lb xml:id="p1z36"/>Bullingerus tuus.
					<pb/>
					<lb xml:id="p2z1"/>Ornatissimo viro d. Ioine
					<lb xml:id="p2z2"/>lungio Basiea.
					<lb xml:id="p2z3"/>ecclesiae ministro
					<lb xml:id="p2z4"/>ad S. petri, domino
					<lb xml:id="p2z5"/>et fratri colendo et
					<lb xml:id="p2z6"/>perchuro.
					<lb xml:id="p2z7"/>Basel.
				</p>
			</div>
		</body>
