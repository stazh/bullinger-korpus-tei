	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Bene habet negotium, quo de, honorande <lb xml:id="p1z2"/>vir, extremis in literis<note xml:id="fn1" type="footnote" n="1">Nicht erhalten.</note> scribis.</s>
					<s n="3" xml:lang="la">Expectamus iam tuam <lb xml:id="p1z3"/>praesentiam, et ut comites tui tecum abeamus <placeName ref="l28">Basileam</placeName><note xml:id="fn2" type="footnote" n="2">Vgl. oben <ref target="file10762">Nr. 724</ref>, Anm. 3.</note>.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Senatus voluit, ut primarius urbis scriba<note xml:id="fn3" type="footnote" n="3"><persName ref="p257">Werner Beyel</persName>.</note>, deinde <lb xml:id="p1z5"/><persName ref="p1419">Habius</persName><note xml:id="fn4" type="footnote" n="4">Anstelle von <persName ref="p1419">Haab</persName> reiste schliesslich <persName ref="p5935">Kaspar Nasal</persName> nach <placeName ref="l28">Basel</placeName> (vgl. <persName ref="p495">Bullingers</persName> Aufzeichnungen in: Zürich StA, E II 337, 138r., sowie <persName ref="p3067">Stumpf</persName>, Abendmahlsstreit 74).</note>, <persName ref="p1753">Leo</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p1753">Leo Jud</persName>.</note> item et ego abeamus.</s>
					<s n="5" xml:lang="la">Ex <placeName ref="l441">Schaffhusio</placeName> abibunt <lb xml:id="p1z6"/><persName ref="p2299">Waldkylchius</persName>, unus ex <persName ref="p21394">tribunis</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p21394">Hans Schmid</persName> (vgl. <ref target="file10764">Nr. 726</ref>, Anm. 3).</note>, <persName ref="p264">Benedictus</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p264">Benedikt Burgauer</persName>.</note> <lb xml:id="p1z7"/>et <persName ref="p2810">Erasmus</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p2810">Erasmus Ritter</persName>.</note>.</s>
					<s n="6" xml:lang="la">Te a <placeName ref="l473">Sangallo</placeName> expectamus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Nosti <lb xml:id="p1z8"/>fortassis <placeName ref="l41">Bernates</placeName> in auxilium festinare <placeName ref="l167">Gebennensium</placeName><note xml:id="fn9" type="footnote" n="9">Zur Eröffnung des Krieges <placeName ref="l41">Berns</placeName> gegen <placeName ref="l2478">Savoyen</placeName> vgl. oben <ref target="file10762">Nr. 724</ref>, 3-6 mit Anm. 2, und 729, 27-32.</note>.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z9"/>Populum sane habent benevolum.</s>
					<s n="9" xml:lang="la">Dominus in <lb xml:id="p1z10"/>gloriam nominis sui victoriam optimis viris et pro fide <lb xml:id="p1z11"/>pura pugnantibus concedat!</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Si quid cert<lb xml:id="p1z12"/>i <lb xml:id="p1z13"/>habes a <placeName ref="l1202">Schmalkeldia</placeName><note xml:id="fn10" type="footnote" n="10">Zur Tagung des <placeName ref="l1202">Schmalkaldischen</placeName> Bundes vom 6. bis 24. Dezember 1535 vgl. Fabian, Bundesabschiede 59-78.</note>, fac sciam, obsecro, et valeto.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">21. <lb xml:id="p1z14"/>ianuarii 1536.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z15"/><persName ref="p495">H. Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctori <persName ref="p8049">Ioachimo Vadiano</persName>, <lb xml:id="p2z2"/>domino suo inprimis <lb xml:id="p2z3"/>observando.</s>
				</p>
			</div>
