	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Absendeort ist vermutlich der Wohnort des Briefschreibers <persName ref="p8483" cert="high">Ulrich Lieb</persName>, <placeName ref="l549" cert="high">Wigoltingen</placeName>, oder jener des Briefsieglers <persName cert="high" ref="p6459">Alexander Schmutz</persName>, <placeName ref="l287" cert="high">Leutmerken</placeName> (beide <placeName ref="l774" cert="high">Kt. Thurgau</placeName>).</note>
