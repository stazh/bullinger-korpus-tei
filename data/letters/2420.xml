	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuas cum <persName ref="p3375">Wergerii</persName> literis accepi agnoscoqu<lb xml:id="p1z2"/>e propensam tuam in omnes vestros status voluntatem, <lb xml:id="p1z3"/>que profecto multum a bonis viris iuvari <lb xml:id="p1z4"/>debet; nam si actiones omnium vestrorum <lb xml:id="p1z5"/>tendant ad commodum et pacem publicam, <lb xml:id="p1z6"/>quemadmodum tue faciunt, melius in <lb xml:id="p1z7"/>futurum patrie et religioni in futurum consuletur, etia<lb xml:id="p1z8"/>m se quidam sint ita violenti, qui omnia inconsulte sine <lb xml:id="p1z9"/>iudicio velint impetu et vi ducere.</s>
					<s n="3" xml:lang="la" ana="salute">Fere confectus <lb xml:id="p1z10"/>laboribus rogavi regem, ut tandem me rude <lb xml:id="p1z11"/>donaret vel saltem permitteret quietem per <lb xml:id="p1z12"/>aliquod menses, quod vix tandem impetravi <lb xml:id="p1z13"/>magno mee valetudinis commodo, sed <lb xml:id="p1z14"/>cum dolore tamen, cum video mihi multos <lb xml:id="p1z15"/>charos et intimos amicos relinquendos; <lb xml:id="p1z16"/>sed unum solum inter cetera consolatur, quod <lb xml:id="p1z17"/>dominis amicisque meis successorem mittit <lb xml:id="p1z18"/>sua maiestas mihi consanguineum et intimum <lb xml:id="p1z19"/>amicum, qui ex illis duobus legatis nostris, <lb xml:id="p1z20"/>qui te domi salutarunt, cum de liberatione domini.<lb xml:id="p1z21"/>..</s>
					<s n="4" xml:lang="la">Gadde ageretur, est iunior, do[c]tu<lb xml:id="p1z22"/>s in Grecis et Latinis fere super omnes nostros <lb xml:id="p1z23"/>et in <placeName ref="l834">Italia</placeName> diu posteaque in <placeName ref="l822">Germania</placeName> <lb xml:id="p1z24"/>enutritus.</s>
					<s n="5" xml:lang="la" ana="salute">Qui iamiam ex equo descendit tequ<lb xml:id="p1z25"/>e plurimum salutat sperans posthac <lb xml:id="p1z26"/>tecum communicare, que in salutem reipublicae christianae <lb xml:id="p1z28"/>erunt.</s>
					<s n="6" xml:lang="la" ana="salute">Illum ergo, mi <persName ref="p495">Bullingere</persName>, tibi commendo; est enim <pb/><lb xml:id="p2z1"/>pius, doctus et magne in futurum spei, quod <lb xml:id="p2z2"/>cupio d. consulem <persName ref="p1419">Hab</persName> habere et <lb xml:id="p2z3"/>intelligere meisque verbis plurimum salutari, <lb xml:id="p2z4"/>cui pacem publicam communemque nostram <lb xml:id="p2z5"/>amicitiam commendo.</s>
					<s n="7" xml:lang="la">Est vir bonus <lb xml:id="p2z6"/>prudensque in rebus agendis; merito ergo <lb xml:id="p2z7"/>illum amo et me meaque in futurum <lb xml:id="p2z8"/>offero.</s>
					<s n="8" xml:lang="la">Quod autem ad te attinet, unum <lb xml:id="p2z9"/>dolet, quod ante discessum non licuerit <lb xml:id="p2z10"/>pluribus et familiarius colloqui; <lb xml:id="p2z11"/>interea tamen, donec sese occasio offerat, <lb xml:id="p2z12"/>scies me tuum perpetuum fore et illam <lb xml:id="p2z13"/>merito de te opinionem recepisse, <lb xml:id="p2z14"/>quam omnes boni fecere.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale igitur, vir <lb xml:id="p2z15"/>optime et nos redama.</s>
					<s n="10" xml:lang="la">Datum <placeName ref="l760">Soluturo</placeName> 8a <lb xml:id="p2z16"/>octobris raptim<lb xml:id="p2z17"/>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p2z18"/>Tuus sem<lb xml:id="p2z19"/>per <persName ref="p8296">Bas[<lb xml:id="p2z20"/>safontaneus]</persName> <lb xml:id="p2z21"/>Rogo salutes dominum vestrum secretariu<lb xml:id="p2z22"/>m meo nomine et vale dicas.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Optimo vi<lb xml:id="p2z23"/>ro domino <persName ref="p495">Bulingero</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p4z1"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
