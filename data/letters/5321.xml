	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S<lb xml:id="p1z2"/>.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Nolo t<lb xml:id="p1z4"/>e diu <lb xml:id="p1z8"/>detinere, vir doctissime, cum sciam te nimiis occupationibus admodum <lb xml:id="p1z9"/>gravari.</s>
					<s n="3" xml:lang="la">Sed quia tam certus, licet improvisus, offerret se nuntius, nolebam ut nullas <lb xml:id="p1z10"/>ad tuam humanitatem ferret literas.</s>
					<s n="4" xml:lang="la">Placet mihi consilium vestrum de dissidio <placeName ref="l491">Argentinensi</placeName>, <lb xml:id="p1z11"/>laetor etiam, quod possum illis demonstrare me expediisse, quae oretenus et per literas mihi erant <lb xml:id="p1z12"/>commissa in hac causa, ut videant me nihil neglexisse intelligantque animi etiam vestri <lb xml:id="p1z13"/>sententiam; nam his diebus ad ipsos sum scripturus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z14"/>Caeterum [...]<note type="misc">no.? Gall.?</note> misit ad <lb xml:id="p1z15"/>me d. <persName ref="p8055">Blaurerus</persName> tua manu scriptas, ea tamen conditione, ut ad illum non ad te remittam; <lb xml:id="p1z16"/>die sabbati iam recipiet.</s>
					<s n="6" xml:lang="la">Si aliter fieri nequit, cures, obsecro, ut vel per <lb xml:id="p1z17"/>illum scitu necessaria novitatesque horum temporum accipiamus; de fide nostra nihil <lb xml:id="p1z18"/>dubites, dum spiritus hos regit artus<note xml:id="fn1" type="footnote" n="1">Vgl. Vergil, Aeneis, 4, 336.</note>, ut ille aiebat.</s>
					<s n="7" xml:lang="la">Porro consul <persName ref="p2553">Peyerus</persName> <lb xml:id="p1z19"/>mihi significavit decretum <placeName ref="l862">Helvetiorum</placeName> evangelicorum de responso dando de concilio <placeName ref="l1107">Tri<lb xml:id="p1z20"/>dentino</placeName>, cui inserendae sint rationes, quare illud visitare nolint neque etiam visitandum esse; <lb xml:id="p1z21"/>id vero componendum ab amplissimo magistratu <placeName ref="l587">Tigurino</placeName> auxilio doctorum, dehinc idem <placeName ref="l41">Bernatibus</placeName> etc. <lb xml:id="p1z22"/>communicando, ut similis omnium sit responsio.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Hoc si compositum fuerit, nos accepturos <lb xml:id="p1z23"/>non diffidimus.</s>
					<s n="9" xml:lang="la">Accipietis nimirum responsum principum statuumque ex comitiis <placeName ref="l513">Ulmensibus</placeName> de eodem <lb xml:id="p1z24"/>consilio.</s>
					<s n="10" xml:lang="la">Dominus adsit nobis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Supplicationes hic fiunt pro ecclesia Christi in <placeName ref="l832">Gallia</placeName> <lb xml:id="p1z25"/>sedulo.</s>
					<s n="12" xml:lang="la">Negocium domini est; is omnia diriget pro nutu voluntatis suae.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Magistratus noster <lb xml:id="p1z26"/>heri accepit scripta a <persName ref="p8315">principe Condensi</persName>, ita nimirum et vester; nondum legi neque vidi.</s>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z27"/>Vale, humanissime d. <persName ref="p495">Bullingere</persName>, cum omnibus nos amantibus, quos nostro nomine salutabis.</s>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z28"/>Salutant te nostri.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z29"/><placeName ref="l441">Scaphusiae</placeName> 14. maii 1562.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z30"/>Tuae humanitati(s?) deditissimus <persName ref="p2757">Iacobus <pb/><lb xml:id="p2z1"/>Rüger</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z2"/>Clarissimo, doctissimo atque praestantissimo <lb xml:id="p2z3"/>viro d. m. <persName ref="p495">Heinrycho <lb xml:id="p2z4"/>Bullingero</persName>, antistiti ecclesiae <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z5"/>vigilantissimo, domino ac fratri suo <lb xml:id="p2z6"/>plurimum observando.</s>
					<s n="19" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Tigurum</placeName> <lb xml:id="p2z8"/>Ann m. <persName ref="p495">Heinrich <lb xml:id="p2z9"/>Bullinger</persName> zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
