	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil nunc singulare, quod scribam habeo; <lb xml:id="p1z2"/>quia tam hunc nactus sum nuncium ad te certissimum <lb xml:id="p1z3"/><persName>Ioannem Baptistam Pellizarium</persName> <placeName ref="l93">Cleven[nensem]</placeName> his te ac tuos volui <lb xml:id="p1z4"/>salutare.</s>
					<s n="3" xml:lang="la">Dicuntur comicia celebrari nunc <placeName ref="l157">Franc<lb xml:id="p1z5"/>fordiae ad Moenum</placeName>, quo cum aliquot equitum <lb xml:id="p1z6"/>turmis properasse scribitur <persName ref="p18477">Ferdinandus</persName>, con<lb xml:id="p1z7"/>fluxisse vero ad ipsum <placeName ref="l822">Germaniae</placeName> principes.</s>
					<s n="4" xml:lang="la">Quid <lb xml:id="p1z8"/>vero ibi sint consultaturi aut decreturi, nemo <lb xml:id="p1z9"/>certo dixerit; alii aliud comminiscuntur, <lb xml:id="p1z10"/>quae ego tibi velut incerta non refero.</s>
					<s n="5" xml:lang="la">Plerique <lb xml:id="p1z11"/>arbitrantur creandum fore <persName ref="p8282">regem Romanorum <lb xml:id="p1z12"/>Maximilianum</persName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quod qua ratione fieri possit <lb xml:id="p1z13"/>nondum video, praesertim cum feratur <persName ref="p18538">Carolus</persName> <lb xml:id="p1z14"/>imperator vivere adhuc et <persName ref="p18477">Ferdinandus</persName> coronatus <lb xml:id="p1z15"/>sit <persName>rex Romanorum</persName>; scis autem corona a <lb xml:id="p1z16"/>bestia capiti <persName>regis Romanorum</persName> imposita creari <lb xml:id="p1z17"/>imperatorem.</s>
					<s n="7" xml:lang="la">Sed quid hisce putidis tibi <lb xml:id="p1z18"/>molestus sum?</s>
					<s n="8" xml:lang="la">Certiora brevi fortassis dabo.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/>Nunc puto mea referre, ut non nescias superiori<lb xml:id="p1z20"/>bus diebus me intellexisse filium meum <persName ref="p487">Heinrychum</persName>, <lb xml:id="p1z21"/>na<lb xml:id="p1z22"/>tu maximum, <placeName ref="l377">Patavium</placeName> ex <placeName ref="l850">Austria</placeName> venisse ac agere <lb xml:id="p1z23"/>nunc apud d. <persName ref="p8395">Georgium Cellarium</persName> <placeName ref="l587">Tigurinum</placeName> <placeName ref="l862">Helvetium</placeName>, <lb xml:id="p1z24"/>affinem meum, id quod ego ne somniavi <lb xml:id="p1z25"/>quidem.</s>
					<s n="10" xml:lang="la">Dedi ergo literas huic <persName>Ioanni Baptistae Pelli<lb xml:id="p1z26"/>zario</persName> scriptas d. d. <persName ref="p8395">Georgio</persName> etc., in quibus filium meum <lb xml:id="p1z27"/>revoco, ut absque mora domum redeat.</s>
					<s n="11" xml:lang="la">Literis via<lb xml:id="p1z28"/>ticum imposui coronatos quatuor.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Te itaque oro <lb xml:id="p1z29"/>per nostram amicitiam, ut horteris <persName>Baptistam</persName>, cui optim<lb xml:id="p1z30"/>e fido, ut diligenter et tuto et cito meas <lb xml:id="p1z31"/>procuret literas.</s>
					<s n="13" xml:lang="la">Gratissimam tu mihi rem faceres, <lb xml:id="p1z32"/>si tu quoque per tuos amicos literis tuis ad <lb xml:id="p1z33"/>d. doctorem <persName ref="p8395">Cellarium</persName>, medicum <placeName ref="l377">Patavii</placeName> agentem, <lb xml:id="p1z34"/>scriptis admoneres filium meum, cito et absque <lb xml:id="p1z35"/>cunctatione domum redeat, me illum revocare d<lb xml:id="p1z36"/>atis literis d. <persName>Baptistae</persName> profecturo <placeName>Vicentiam</placeName><lb xml:id="p1z37"/>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z38"/>Hoc autem peto, ut, si literae illę meae <persName>Baptistae</persName> datae vel diutius <lb xml:id="p1z39"/>in itinere haererent vel <lb xml:id="p1z40"/>minus diligenter, <lb xml:id="p1z41"/>quod minime puto, curarentur, filius meus nihilo<pb/><lb xml:id="p2z1"/>minus <lb xml:id="p2z2"/>intelligeret voluntatem meam esse, ut domum <lb xml:id="p2z3"/>recta redeat, si autem nondum accepit <lb xml:id="p2z4"/>meas literas Baptistae traditas ante tuas, mutuo <lb xml:id="p2z5"/>accipiat viaticum et coronatos et accingatur <lb xml:id="p2z6"/>itineri.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Nolo enim, ut is diutius vivat in <placeName ref="l834">Italia</placeName>; <lb xml:id="p2z7"/>sunt ca[uss]ae multae et graves, cur illum revocem <lb xml:id="p2z8"/>etc.</s>
					<s n="16" xml:lang="la">Si itaque me amas, mi domine et frater, <lb xml:id="p2z9"/>gratificare hic mihi.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Vive et vale aeternum.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Recte <lb xml:id="p2z10"/>valet uni<lb xml:id="p2z11"/>versa domus mea, et optime se gerit filius noster <persName>Ioannes</persName> etc.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Salvi sint tui omnes.<lb xml:id="p2z12"/>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="salute">Salutant te mei omnes.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 12. martii 1558.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Clarissimo viro d. <persName ref="p8432">Friderycho <lb xml:id="p2z13"/>a Salice</persName>, <placeName ref="l440">Samadeno</placeName> <placeName ref="l648">Rheto</placeName>, domino suo colendissimo et fratri charissimo.</s>
					<s n="24" xml:lang="de">An junckher <persName ref="p8432">Fridrychen von <lb xml:id="p2z14"/>Salis</persName> zuͦ <placeName ref="l440">Samada</placeName> in <placeName ref="l638">Ingadina</placeName>.</s>
				</p>
			</div>
