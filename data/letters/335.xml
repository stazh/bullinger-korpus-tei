	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/><persName ref="p8098">Georg, grave zu Württemberg <lb xml:id="p1z2"/>und zu Mümppelgart</persName> etc.</s>
					<s n="2" xml:lang="de"><lb xml:id="p1z3"/>Unswern grus zuvor, wolgelerter, lieber besunder.</s>
					<s n="3" xml:lang="de">Wir <lb xml:id="p1z4"/>haben nun mancherlei anzeigungen, wie die von <placeName ref="l257">Costentz</placeName> <lb xml:id="p1z5"/>mit schweren condictionen in des konnigs handen sich er<lb xml:id="p1z6"/>geben haben (doch zweyffelhafftig) vernommen.</s>
					<s n="4" xml:lang="de">Weyl wir <lb xml:id="p1z7"/>dan erachten, ir deren gutt wissens haben, begeren wir <lb xml:id="p1z8"/>gnediglichen, uns dasselb nach lengs zuzuschreiben, onge<lb xml:id="p1z9"/>zweyffelt, so sie ieren gutgünstigen zeitlich gevolgt, ire sac<lb xml:id="p1z10"/>hen besser st<lb xml:id="p1z11"/>on solten.</s>
				</p>
				<p>
					<s n="5" xml:lang="de">Ferrer vernemmen <lb xml:id="p1z12"/>wir, das die gesandten der vier Stett zusamen komen sollen; <lb xml:id="p1z13"/>in dem wollet das volck, damit christenlich ver<lb xml:id="p1z14"/>gleichung ieren fürgang habe, mit trewem ernst und eyffer im <lb xml:id="p1z15"/>gebett ermanen; dan, wo es euch, euwern mitbrudern <lb xml:id="p1z16"/>und allen gottgeliebten woll ergieng, hortent wir gern.</s>
					<s n="6" xml:lang="de"><lb xml:id="p1z17"/>Haben wir euch dismalen mit unserm schreiben gnediglich <lb xml:id="p1z18"/>ersuochen wollen.</s>
				</p>
				<p>
					<s n="7" xml:lang="de">Datum <placeName ref="l28">Basell</placeName> dem iijten <lb xml:id="p1z19"/>Novembris anno etc. xlviijten.</s>
					<s n="8" xml:lang="de"><persName ref="p8098">G[eorg], g[r<lb xml:id="p1z20"/>ave] z[u] Wyrttemberg</persName> etc<lb xml:id="p1z21"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="9" xml:lang="de"><lb xml:id="p1z22"/>D<pb/><lb xml:id="p2z1"/>em wolgelerten, unserm lieben <lb xml:id="p2z2"/>besundern <persName ref="p495">Heinrichen Bullinger</persName>, <lb xml:id="p2z3"/>predicanten zu <placeName ref="l587">Zürich</placeName>, <lb xml:id="p2z7"/>zu handen.</s>
				</p>
			</div>
		</body>
	</text>
