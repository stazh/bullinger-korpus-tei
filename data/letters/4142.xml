	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Modo accipio literas a filio meo satis <lb xml:id="p1z2"/>tristes 1. novembris scriptas <placeName ref="l522">Venetiis</placeName>, quibus <lb xml:id="p1z3"/>mihi queritur se nullas accipere per <placeName ref="l648">Rhetos</placeName> <lb xml:id="p1z4"/>literas, se desertum prorsus et febribus <lb xml:id="p1z5"/>debilitatum agere in schola pistorum quod <lb xml:id="p1z6"/>xenodochium esse intelligo.</s>
					<s n="3" xml:lang="la">Luit nunc miser, <lb xml:id="p1z7"/>quod me prohibente profectus est in <placeName ref="l834">Italiam</placeName>.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Sed interim ego crutior et sumptibus <lb xml:id="p1z9"/>exhaurior.</s>
					<s n="5" xml:lang="la">Tarvisii debet 5 florenos hospiti <lb xml:id="p1z10"/>Albae Rosae, aliis alicubi debet; crescunt in<lb xml:id="p1z11"/>dies sumptus<note type="margin">dazu a.R.: "Curavi, ut haec persolvantur per <placeName ref="l473">Sangallenses</placeName>."</note>.</s>
					<s n="6" xml:lang="la">Sed facilis esset haec iactura, <lb xml:id="p1z12"/>si incolumis et integra modo esset eius sanitas <lb xml:id="p1z13"/>aut tantillum morbus remitteret, <lb xml:id="p1z14"/>ut <lb xml:id="p1z15"/>per <placeName ref="l18">Augustam</placeName> domum redire posset.</s>
					<s n="7" xml:lang="la">Dominum <lb xml:id="p1z16"/>oro, ut hic illi et mihi adsit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Scribo illi <lb xml:id="p1z17"/>hisce inclusis, quid faciat, quamvis dubitem, <lb xml:id="p1z18"/>an adhuc ibi haereat.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Te autem oro <lb xml:id="p1z19"/>atque per nostram obtestor amicitiam, ut <lb xml:id="p1z20"/>literas has cures certo perferri Venetias.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Audio enim subinde illuc a vobis aut per <lb xml:id="p1z22"/>vos viros bonos proficisci, quibus has [liter<lb xml:id="p1z23"/>as] credere poteris.</s>
					<s n="11" xml:lang="la">Praeterea ago cum qui<lb xml:id="p1z24"/>busdam <placeName ref="l473">Sangallensibus</placeName> de sufficiendo <lb xml:id="p1z25"/>ei viatico, si adhuc ibi haereat.</s>
					<s n="12" xml:lang="la">Scis, <lb xml:id="p1z26"/>quod ad minimum binas aut ternas ipsi in<lb xml:id="p1z27"/>scriptas tibi crediderim intra menses circiter 6, <lb xml:id="p1z28"/>non dubbito de tua fide, sed fieri <lb xml:id="p1z29"/>potest, ut fefellerint, quibus dedisti literas.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Si <lb xml:id="p1z30"/>me amas, cura has diligenter.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Dentur <persName>Petro <lb xml:id="p1z31"/>Roos</persName> zum Wyßen Löwen <placeName ref="l522">Venetiis</placeName>; is scit, <lb xml:id="p1z33"/>ubi sit filius meus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 3. de<lb xml:id="p1z34"/>cembris 1559.</s>
					<s n="17" xml:lang="la">Ferstinantissim<lb xml:id="p1z35"/>e.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z37"/><persName ref="p495">Bullingerus</persName> <pb/><lb xml:id="p2z1"/>tuus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Clari<lb xml:id="p2z2"/>ssimo viro d. <persName ref="p8432">Frid<lb xml:id="p2z3"/>erycho a Sal<lb xml:id="p2z4"/>is</persName>, domino suo colen<lb xml:id="p2z5"/>di<lb xml:id="p2z6"/>ssimo et frat<lb xml:id="p2z8"/>r<lb xml:id="p2z9"/>i c<lb xml:id="p2z10"/>harissimo, <lb xml:id="p2z11"/>comissario <lb xml:id="p2z12"/><placeName ref="l93">Clavennae</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
