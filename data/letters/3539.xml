			<zone xml:id="p2z23-0" points="469,1662 604,1633 719,1667 914,1610 1388,1623 1438,1605 1441,1547 1250,1519 1136,1576 828,1553 662,1597 615,1568 472,1584">483,1635 531,1630 579,1627 627,1624 675,1621 723,1617 771,1614 819,1611 867,1608 915,1604 963,1601 1011,1598 1059,1596 1107,1593 1155,1590 1203,1588 1251,1585 1299,1584 1347,1581 1395,1578 1444,1575</zone>
			<zone xml:id="p2z24-0" points="487,1732 711,1748 1039,1688 1347,1725 1576,1652 2141,1657 2201,1649 2204,1579 1774,1612 1602,1573 1305,1631 920,1610 711,1670 604,1633 490,1657">504,1697 589,1691 674,1688 759,1684 844,1680 930,1673 1015,1667 1100,1664 1185,1659 1270,1656 1356,1650 1441,1644 1526,1641 1611,1638 1696,1638 1782,1635 1867,1635 1952,1635 2037,1635 2122,1632 2208,1632</zone>
