	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. <lb xml:id="p1z2"/>D.</s>
					<s n="2" xml:lang="la">Literas, quas ad me nuper absentem scripsisti, rediens <lb xml:id="p1z3"/>ab <persName ref="p8126">Oporino</persName> affine accepi, vir ornatissime.</s>
					<s n="3" xml:lang="la">Literas adiunctas <lb xml:id="p1z4"/>curavi probe, et cum nihil literarum ad te e<lb xml:id="p1z5"/>xploraverim et nihil etiam dignum epistola ad manum <lb xml:id="p1z6"/>erat, ad praesentem usque nuntium epistolam distuli.</s>
					<s n="4" xml:lang="la">Ago autem <lb xml:id="p1z7"/>tibi gratias ingentes, qui bonorum virorum ad te literas <lb xml:id="p1z8"/>mihi communicare non dedignaris.</s>
					<s n="5" xml:lang="la">Remitterem alia <lb xml:id="p1z9"/>nova, si quid certi haberem.</s>
					<s n="6" xml:lang="la">Certum autem est nobilem <lb xml:id="p1z10"/>illum ab <placeName>Hatstat</placeName> ducem imperatoreum, milites omnes, <lb xml:id="p1z11"/>quos circa <placeName ref="l101">Colmariam</placeName>, <placeName ref="l452">Selestadium</placeName> atque hinc inde per <lb xml:id="p1z12"/>totam <placeName ref="l632">Alsatiam</placeName> collegerat atque in praesidia destinaverat, <lb xml:id="p1z13"/>dimisisse, unde multi colligunt belli ner<lb xml:id="p1z14"/>vos<note xml:id="fn1" type="footnote" n="1">Vgl. <hi>Cicero,</hi> Orationes Philippicae, 5, 5 und s. <bibl source="b17">HBBW XIV</bibl> *** .</note> aut deesse aut imperatorem in rebus suis desperare, <lb xml:id="p1z15"/>licet post <placeName ref="l3031">Teruanum</placeName> <placeName ref="l2116">Ibisch</placeName> atque aliam quandam civitatem <lb xml:id="p1z16"/>munitissimam caesis <placeName ref="l832">Gallis</placeName> receperit.</s>
					<s n="7" xml:lang="la">In <lb xml:id="p1z17"/><placeName ref="l832">Galliis</placeName> periclitantur pii ob christianae religionis <lb xml:id="p1z18"/>professionem, ut ex filio intelligo, qui heri ex <placeName ref="l378">Lutetia</placeName> <lb xml:id="p1z19"/>ad nos rediit.</s>
					<s n="8" xml:lang="la">Haec modo ad te scribere volui, <lb xml:id="p1z20"/>ne virum illum bonum, qui ob communium studiorum <lb xml:id="p1z21"/>rationem me salutavit, omnino vacuum dimitterem.</s>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z22"/>Vale cum uxore et tota familia felicissime, quam <lb xml:id="p1z23"/>tecum salvam esse cupit <persName ref="p8126">Oporinus</persName> atque <persName ref="p8054">Marcus <span type="pronoun">noster</span> <lb xml:id="p1z24"/>Bersius</persName>.</s>
					<s n="10" xml:lang="la"><placeName ref="l28">Basileae</placeName> 18. augusti anno 1553.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z25"/>T[uus] <persName ref="p8406">Con[radus] Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> episcopo, amico <lb xml:id="p2z4"/>ut plurimum dilecto.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
