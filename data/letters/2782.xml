	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Vir clarissime, rarius omnino scribo, quam vellem; sed hoc facit nunccior<lb xml:id="p1z2"/>um penuria.</s>
					<s n="2" xml:lang="la">Scribo nunc, quia <placeName ref="l441">Schafusianus</placeName> nuncius se obtulit.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Pulchre valeo, dei benignitate, ac laboro more meo.</s>
					<s n="4" xml:lang="la">Verti librum <lb xml:id="p1z4"/><persName ref="p458">Brentii</persName> contra <persName>Asotum</persName>, ac fere iam typis excussus.</s>
					<s n="5" xml:lang="la">Utinam Italice <lb xml:id="p1z5"/>intelligeres; non pauca enim addidi, sed consulto autore.</s>
					<s n="6" xml:lang="la">Avellar <lb xml:id="p1z6"/>hinc proxima septimana, ut spero, futurus partim <placeName ref="l496">Stutgardiae</placeName>, partim <lb xml:id="p1z7"/>in quodam oppido, cui nomen <placeName>Bachenae</placeName>, ubi dominus <persName ref="p20206">Gribaldus</persName> <lb xml:id="p1z8"/>profitetur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l822">Germania</placeName> bene haberet, quod ad religionem attinet, <lb xml:id="p1z9"/>nisi hinc <persName ref="p8441">Svenchfeldiani</persName>, inde amarus zelus in articulo euchari<lb xml:id="p1z10"/>stico eam proscinderet; det pacem dominus ecclesiis suis.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/>Omnino futura sunt comitia mense martio <placeName ref="l410">Ratisbonae</placeName> pro expe<lb xml:id="p1z12"/>ditione scilicet in <placeName ref="l2510">Turcas</placeName> suscipienda; iam enim, quanquam sit hyems, <lb xml:id="p1z13"/>excursiones faciunt in <placeName ref="l882">Hungaria</placeName>.</s>
					<s n="9" xml:lang="la">Intra octo dies sumus habituri <lb xml:id="p1z14"/>conventum totius circuli <placeName ref="l2481">Suevici</placeName> hic <placeName ref="l412">Reutlingae</placeName>.</s>
					<s n="10" xml:lang="la">Princeps <lb xml:id="p1z15"/>noster venit hodie in proximum pagum venaturus, dum veniat <lb xml:id="p1z16"/>dies negociis statutus.</s>
					<s n="11" xml:lang="la">Fui cum illo aliquandiu; inimicus homo multa <lb xml:id="p1z17"/>instillavit in eius aures de <persName ref="p540">Calvino</persName>, cui certe undique video <lb xml:id="p1z18"/>non paucos esse adversarios.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Si forte e <placeName ref="l41">Berna</placeName> venit imago a <lb xml:id="p1z19"/><persName ref="p4191">Matthia Apiario</persName>, cura illa <placeName ref="l441">Schaphusam</placeName> ad <persName ref="p2757">Rugerum</persName> nostrum; <lb xml:id="p1z20"/>si nondum missa est, urge <persName ref="p8018">Hallerum</persName>, ut Apiarium, qui iam praecium <lb xml:id="p1z21"/>tulit, urgeat.</s>
					<s n="13" xml:lang="la">Mitto aliquot imagines cum Germanico elogio; <lb xml:id="p1z22"/>hac alea scilicet ludo, cum a gravioribus studiis quiescendum <lb xml:id="p1z23"/>est.</s>
					<s n="14" xml:lang="la" ana="salute">Salvere iubeo dominum <persName ref="p8011">Gualterum</persName> ac tuostris generos ac <lb xml:id="p1z24"/>reliquos fratres.</s>
					<s n="15" xml:lang="la">iuvate me precibus vestris, quod vos valde rogo.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z25"/><placeName ref="l412">Reutlingae</placeName> 6. decembris 1555.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z26"/>In hoc conventu quaeretur, quo modo <placeName ref="l2481">Suevia</placeName> sit <lb xml:id="p1z27"/>parata preditibus, equitibus, bombardis etc., si <lb xml:id="p1z28"/>pugnandum esset.</s>
					<s n="18" xml:lang="la">Hoc caput.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z29"/><persName ref="p3375">Vergerius</persName> <lb xml:id="p1z30"/>frater.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="20" xml:lang="la">(A. <pb/><lb xml:id="p2z1"/>H.) Clarissimo viro domino <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>antistiti, fratri honorando.</s>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
