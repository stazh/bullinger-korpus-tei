	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hodoie tuas 23. huius mensis scriptas accepi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Rediit <lb xml:id="p1z2"/>interea etiam d. <persName ref="p3659">Mülinensis</persName> et hodie <placeName ref="l646">Glaronensis</placeName> illa <lb xml:id="p1z3"/>causa coram diacosiis tractatur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Utinam illa finiatur tandem <lb xml:id="p1z4"/>cum deo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quid <placeName ref="l167">Genevenses</placeName> a nostris petant et quo lo<lb xml:id="p1z5"/>co res illorum pende<lb xml:id="p1z6"/>ant, quum ex meis ad fratrem <lb xml:id="p1z7"/>tum ex d. <persName ref="p8033">Bezae</persName> praesentibus literis cognosces.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Has ego <lb xml:id="p1z8"/>tua fretus humanitate, qua mihi alias tua omnia <lb xml:id="p1z9"/>communicare soles, tum etiam quod dominus <persName ref="p8033">Beza</persName> hoc con<lb xml:id="p1z10"/>cedebat, ut ex illis, quas ad me scripsit, cognosces, aperui <lb xml:id="p1z11"/>et his lectis valde perculsus sum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Metuo enim, ne magna <lb xml:id="p1z12"/>nobis pericula immineant.</s>
					<s n="8" xml:lang="la">Vides, quid fiat <placeName ref="l301">Lugduni</placeName>, <lb xml:id="p1z13"/>et nostris iam certo persuasum est regem concilio <lb xml:id="p1z14"/><placeName ref="l1107">Tridentino</placeName> subscripturum idque instinctu matris Iezabelis.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>Dominus dissipet et subvertat illius consilia; pro hoc est <lb xml:id="p1z16"/>sedulo nobis cum ecclesiis nostris orandum et in domini <lb xml:id="p1z17"/>auxilio fortiter sperandum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Suspicantur omnes milites <lb xml:id="p1z18"/>illos <placeName ref="l822">Germanos</placeName>, qui in <placeName ref="l834">Italiam</placeName> proficiscuntur, contra <placeName ref="l167">Ge<lb xml:id="p1z19"/>nevam</placeName> et nos esse ducendos.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Cognoscetur tamen hoc brevi; <lb xml:id="p1z20"/>nam nostri habent <placeName ref="l306">Mediolani</placeName> suos, ex quibus mox, <lb xml:id="p1z21"/>quo se vertant, cognoscent.</s>
					<s n="12" xml:lang="la">Audimus hic <placeName ref="l648">Rhaetos</placeName> inter <lb xml:id="p1z22"/>se tumultuari, et miror, quod nec tuę nec fratris <lb xml:id="p1z23"/>de his quicquam contineant.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Prolixior esse nolo, cum <lb xml:id="p1z24"/>in his aliis habeas omnia ea, quę ego scribere poteram.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z25"/>Dominum oro, ut te nobis diutissime servet.</s>
					<s n="15" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z26"/>Salutem dic dominis amicis et fratribus omnibus, praesertim eti<lb xml:id="p1z27"/>am his, qui sunt de domo tua.</s>
					<s n="17" xml:lang="la" ana="salute"><persName ref="p8063">Steigerus</persName>, <persName ref="p3494">Diesbachius</persName>, <lb xml:id="p1z28"/><persName ref="p7511">Grafenriet</persName>, <persName ref="p8012">Hallerus</persName>, socer, mater denique et uxor <lb xml:id="p1z29"/>te tuosque salutant.</s>
					<s n="18" xml:lang="la"><placeName ref="l41">Bernę</placeName> ultimo(a?) iunii 1564.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><persName ref="p8018">I[oh<lb xml:id="p1z30"/>annes] Hallerus</persName> tuus <pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino suo honorando <lb xml:id="p2z5"/>et compatri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
