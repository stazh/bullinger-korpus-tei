					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et misericordiam a domino per Iesum Christum, dominum nostrum.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/><persName ref="p8013">Lucius Haimius</persName> consul et ego literas humanitatis tuae 3. octobris datas <lb xml:id="p1z3"/>accepimus, charissime frater; legimus et intelleximus singula.</s>
					<s n="3" xml:lang="la">Hinc <lb xml:id="p1z4"/>ad octo dies cum amicis et cognatis puerorum consultabimus de his; <lb xml:id="p1z5"/>nam gravia sunt, quę tonsor proposuit, et dominus <persName ref="p396">Ioannes Blasius</persName> felicis <lb xml:id="p1z6"/>memoriae res suas perplexas et indispositas reliquit.</s>
					<s n="4" xml:lang="la">Futurum <lb xml:id="p1z7"/>credo, ut puer revocetur ad patrios lares; attamen de expensis <lb xml:id="p1z8"/>hucusque factis sine dilatione satisfaciemus et te quietum reddemus.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>In <persName ref="p396">Blasii</persName> locum nullus adhuc est subrogatus; operam dabo ut <persName ref="p8359">Pillipus <lb xml:id="p1z10"/>Galitius</persName> illi succedat.</s>
					<s n="6" xml:lang="la"><persName ref="p6130">Pontasella</persName> valet orbatus uxore et liberis; <lb xml:id="p1z11"/>matrem habet solam in lecto decumbentem; stipendium suum habet <lb xml:id="p1z12"/>absque detrimento, quamvis nullo iam labore prematur.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>De rebus Cęsareanis intellexi.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Nos <placeName ref="l98">Curienses</placeName> divina misericordia <lb xml:id="p1z14"/>et ope supra modum indigemus; nam optimis civibus evangelio faventibus <lb xml:id="p1z15"/>et doctis omnibus privati sumus.</s>
					<s n="9" xml:lang="la">Ex doctis obierunt <persName ref="p396">Ioannes Blasius</persName>, <lb xml:id="p1z16"/><persName ref="p3716">Rudolfus a Salicibus</persName>, <persName>Sampson a Salicibus</persName>, adolescens probe doctus, <lb xml:id="p1z17"/><persName>Caspar Andretina</persName>, <persName>Ieronimus Ilantinus</persName>, pastor.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>De filia scribis, quę mihi animum reddunt.</s>
					<s n="11" xml:lang="la" ana="salute">Tibi inprimis <lb xml:id="p1z19"/>magnas habeo gratias, qui tantos labores mea causa sustineas, <lb xml:id="p1z20"/>deinde hospiti et uxori illius; salutem ex me dicas etiam filiolae, <lb xml:id="p1z21"/>et quando aliquid defuerit, fac, ut sciam.</s>
					<s n="12" xml:lang="la">Vellem etiam, ut <lb xml:id="p1z22"/>puella post vindemiam ad scolas mitteretur, ut disceret scribere; <lb xml:id="p1z23"/>nam ante hyemem illam (si saltem locum habuerit) non sum revocaturus.</s>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z24"/>Vale.</s>
					<s n="14" xml:lang="la">Ex <placeName ref="l98">Curia</placeName>, 7. octobris 50.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z25"/>Tuus <persName ref="p654">Ioannes Comander</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo doctissimoque <lb xml:id="p2z2"/>viro magistro <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, domino ac <lb xml:id="p2z4"/>fratri charissimo suo.</s>
					<s n="17" xml:lang="de"><lb xml:id="p2z5"/>Gen <placeName ref="l587">Zürich</placeName>, meister <lb xml:id="p2z6"/><persName ref="p495">Heinrich Bullinger</persName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>