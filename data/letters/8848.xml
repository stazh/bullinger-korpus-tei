	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Iuvenis hic senatoris honesti apud nos filius est, domini scilicet <lb xml:id="p1z2"/><persName>Iacobi Albini</persName><note xml:id="fn1" type="footnote" n="1"><persName>Jakob Wyss</persName>.</note>, et <persName ref="p8449">Samuelis Telamonii</persName> ex sorore nepos; di<lb xml:id="p1z3"/>dicit artem pistoriam; nam pater, licet ditissimus sit, omnes <lb xml:id="p1z4"/>tamen filios suos, quorum non paucos habet, manuarias operas <lb xml:id="p1z5"/>exercere docet.</s>
					<s n="3" xml:lang="la">Statuit vero aliquamdiu <placeName ref="l587">Tiguri</placeName> manere et laborare <lb xml:id="p1z6"/>et postea, si per occasionem aliquam facere possit, <placeName ref="l522">Venetias</placeName> in<lb xml:id="p1z7"/>visere.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Rogarunt itaque me parentes et inprimis <persName ref="p8449">Telamonius</persName><lb xml:id="p1z8"/>, ut eum vel uno verbo tibi commendem, non ut quicquam <lb xml:id="p1z9"/>illi praestes, nisi unum hoc, ut consilio eum iuves, si possit nancis<lb xml:id="p1z10"/>ci bonum et honestum aliquem magistrum, qui illum ad se recipiat.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Satis alias ipse instructus est pecuniis.</s>
					<s n="6" xml:lang="la">Quaerunt etiam hoc inprimis, <lb xml:id="p1z12"/>ut tui cognitionem habeat tuique per totam vitam memor esse <lb xml:id="p1z13"/>possit.</s>
					<s n="7" xml:lang="la">Hoc illis negare non potui, cum nihil non apud te <lb xml:id="p1z14"/>audeam.</s>
					<s n="8" xml:lang="la">Novi nihil habeo, quod scribam, nisi quod <placeName ref="l167">Gene<lb xml:id="p1z15"/>vatum</placeName> gratia nostri cum urbibus vicinis <placeName ref="l160">Friburgi</placeName> primum, <lb xml:id="p1z16"/>postea <placeName ref="l760">Solodori</placeName> conventus egerunt; urget enim regis legatus, <lb xml:id="p1z17"/>ut saltem ab his urbibus in foedus recipiantur et <placeName ref="l760">Solodorenses</placeName> <lb xml:id="p1z18"/>in eam iam sententiam sunt adducti;</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l160">Friburgenses</placeName> hactenus <lb xml:id="p1z19"/>adhuc titubarunt et praesertim propter religionem.</s>
					<s n="10" xml:lang="la">Quid <lb xml:id="p1z20"/>postremo iam <placeName ref="l760">Solodori</placeName> conclusum sit, nondum scio; intelligo <lb xml:id="p1z21"/>interea ex privatis <placeName ref="l160">Friburgenses</placeName> velle, ut, si praesidium aliq<lb xml:id="p1z22"/>uando illuc sit collocandum, ipsis quoque suae religionis libertas <lb xml:id="p1z23"/>concedatur, hoc est, ut illic missam possint celebrare.</s>
					<s n="11" xml:lang="la">Hoc <lb xml:id="p1z24"/><placeName ref="l167">Genevensibus</placeName> durum est, et puto quęstionem illam apud theo<lb xml:id="p1z25"/>logos quoque ventilandam fore.</s>
					<s n="12" xml:lang="la">Rogo itaque, ut, quid tu hic <lb xml:id="p1z26"/>sentias, mihi communices.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l41">Bernae</placeName> penultima martii <lb xml:id="p1z27"/>1572.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Salutant te domini, amici et fratres omnes, inprimis vero <lb xml:id="p1z28"/><persName ref="p8449">Telamonius</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z29"/><persName ref="p8018">Iohannes Hallerus</persName>, <lb xml:id="p1z30"/>tuus, ut nosti.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino <lb xml:id="p2z4"/>meo honorando <lb xml:id="p2z5"/>et compatri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>