	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Caussa compatris nostri d. <persName ref="p8018">Halleri</persName>, compate<lb xml:id="p1z2"/>r in domino charissime, meo iudicio et <lb xml:id="p1z3"/>recte disposita est et habet non incommode, <lb xml:id="p1z4"/>neque quicquam ex illo percipio, unde colligere <lb xml:id="p1z5"/>possim, quod quicquam moleste <lb xml:id="p1z6"/>ferat.</s>
					<s n="3" xml:lang="la">Deinde ex <persName ref="p8012">quaestore d. Hallero</persName> <lb xml:id="p1z7"/>heri accepi esse illi stipendium satis condigne <lb xml:id="p1z8"/>auctum, et iam de eo cogitat, quomodo, <lb xml:id="p1z9"/>quae <placeName ref="l587">Tiguri</placeName> apud vos habeat, huc trans<lb xml:id="p1z10"/>ferat, ob quam caussam etiam brevi illum <lb xml:id="p1z11"/>ad vos venturum arbitror.</s>
					<s n="4" xml:lang="la">Meam <lb xml:id="p1z12"/>caussam commendavi domino; nisi ille rebus <lb xml:id="p1z13"/>meis succurrat, parum est, quod sperare <lb xml:id="p1z14"/>possim.</s>
					<s n="5" xml:lang="la">De <persName ref="p8440">Gervasio</persName> nostro cogito <lb xml:id="p1z15"/>indesinenter; <placeName ref="l49">Bielenses</placeName> caussati <lb xml:id="p1z16"/>sunt esse illum seniculum et <persName ref="p467">Buceranum</persName>, <lb xml:id="p1z17"/>quasi vero minister Christi propterea, <lb xml:id="p1z18"/>quod presbyter est, presbyterio ecclesi<lb xml:id="p1z19"/>astico sit incommodus et, si <persName ref="p467">Bucera<lb xml:id="p1z20"/>nismum</persName> spiraret, vos isthic tam essetis <lb xml:id="p1z21"/>stupidi, ut nihil illius observassetis <lb xml:id="p1z22"/>hactenus.</s>
					<s n="6" xml:lang="la">Obsecro, ubi compater noster d. <lb xml:id="p1z23"/><persName ref="p8018">Hallerus</persName> ad vos venerit, age apud eum <lb xml:id="p1z24"/>optimi fratris nostri causam.</s>
					<s n="7" xml:lang="la">Nec ego desistam, <lb xml:id="p1z25"/>sed urgebo hic, quoad eius per decorum <lb xml:id="p1z26"/>personę meae licuerit.</s>
					<s n="8" xml:lang="la">Domi meae per <lb xml:id="p1z27"/>gratiam Christi sunt adhuc salva omnia.</s>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z28"/>Optime vale, charissime in domino compater ac <lb xml:id="p1z29"/>syncerissime frater.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Salutem tuis omnibus <lb xml:id="p1z30"/>meo et meorum nomine.</s>
					<s n="11" xml:lang="la">Domino etiam <persName ref="p8127">Pellicano</persName>, <lb xml:id="p1z31"/>d. <persName ref="p8171">Bibliandro</persName> et reliquis dominis ac <lb xml:id="p1z32"/>fratribus.</s>
					<s n="12" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1550. 25. februarii.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z33"/><persName ref="p8417">W[olfgangus] Musc[ulus]</persName>, compater tuus in domino.</s>
					<s n="14" xml:lang="de"><lb xml:id="p1z34"/>Mein <persName ref="p8416">Abraham</persName> hinckt n<lb xml:id="p1z35"/>it <lb xml:id="p1z36"/>fast meer; dem herren sey lob; <lb xml:id="p1z37"/>bin guͤter hoffnung, es soll umb vil besser werden.</s>
					<s n="15" xml:lang="de" ana="salute"><lb xml:id="p1z38"/>Min <persName ref="p20957">Sarele</persName> laßt sin gspylin <persName ref="p5035">Verele</persName> zu tusentmal grietzen; <lb xml:id="p1z39"/>sie wolt gern mitt ir im garten umbher louffen, wann <lb xml:id="p1z40"/>nur die muter <persName>Klunglerin</persName> nit da were.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo theologo <lb xml:id="p2z2"/>M. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z4"/>ecclesię pastori <lb xml:id="p2z5"/>fidelissimo, com<lb xml:id="p2z6"/>patri suo in domino <lb xml:id="p2z7"/>charissimo.</s>
				</p>
				<p>
					<s n="17" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
