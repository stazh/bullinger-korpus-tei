	<text xml:lang="de">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z4"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z8"/>Mitto <persName ref="p2301">Osiandri</persName> responsionem ad carmen illud famosum, <lb xml:id="p1z9"/>quo est lacessitus.</s>
					<s n="3" xml:lang="la">Iam olla habet operculum.</s>
					<s n="4" xml:lang="la">Et iterum <lb xml:id="p1z10"/>nobis iustae querimoniae oblata occasio est, ut nec quieta <lb xml:id="p1z11"/>nec integra esse nobis ulla studia queant, laetante interim <lb xml:id="p1z12"/>et sub pallio canente <persName ref="p19981">pontifice Romano</persName> vel una dissensionis <lb xml:id="p1z13"/>nostrę confidentia.</s>
					<s n="5" xml:lang="la" ana="salute">Interim <persName ref="p1055">Frechtus</persName> ad me scripsit <lb xml:id="p1z14"/>tum aliis de rebus, tum una illa praecipua: de animis <lb xml:id="p1z15"/>urbium mire in nostram salutem inclinatis.</s>
					<s n="6" xml:lang="de">Ich <lb xml:id="p1z16"/>hab im gschriben, ich besorg mich uß etwas widerwilles <lb xml:id="p1z17"/>rö(misch) keiß.</s>
					<s n="7" xml:lang="de">Mt. schwerer kriegen und das wir uns <lb xml:id="p1z18"/>inn einer <placeName ref="l862">eidgnoschaft</placeName> treffelich rüstind, uns by <lb xml:id="p1z19"/>harkomnes unser fryheiten und libertet zu erhalten <lb xml:id="p1z20"/>und die hut doran ze binden; dann wol zuͦ gedencken<lb xml:id="p1z21"/>, wann wir ußgemacht werend, es wurde an <lb xml:id="p1z22"/>anderen fryen stenden ouch syn etc.</s>
					<s n="8" xml:lang="de">Daruf er mir <lb xml:id="p1z23"/>müntlich empotten: wiewol das buͦbenvolk sampt <lb xml:id="p1z24"/>ettlichen pfaffen doran syn wöltind oder möchtend, <lb xml:id="p1z25"/>so sye doch nur nicht ze gedenken, das die stett und <lb xml:id="p1z26"/>stende sich inn diser gefar dohin bringen lassen wer<lb xml:id="p1z27"/>dind, das man ein <placeName ref="l862">eidgnoschaft</placeName> bekriege.</s>
					<s n="9" xml:lang="de">Wurden <lb xml:id="p1z28"/>ee meer <placeName ref="l2450">Schwyzer</placeName> machen, dann meer <placeName ref="l2450">Schwyzer</placeName> demmen.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z29"/>Haec eius verba fuere.</s>
					<s n="11" xml:lang="la">Verum quid petat, tute ipse ex <lb xml:id="p1z30"/>literis intelliges, ex quibus, quo animo erga nos sint urbes, <lb xml:id="p1z31"/>facile est cognoscere.</s>
					<s n="12" xml:lang="de"><persName ref="p3067">Stumpffen</persName> Chronica die <pb/><lb xml:id="p2z1"/>mir überuß wol gfallend, wil ich üch <foreign xml:lang="la">intra dies <lb xml:id="p2z2"/>8</foreign> by nechster pottschaft zuͦschiken.</s>
					<s n="13" xml:lang="de">Was das kloster, <lb xml:id="p2z3"/>die statt <placeName ref="l473">S. Gallen</placeName> und <placeName ref="l2451">Appenzell</placeName> und <placeName ref="l1907">Gotzhuß</placeName> land<lb xml:id="p2z4"/>schaft belangt, wöllend wir (und sind ietz inn der <lb xml:id="p2z5"/>arbeit) dergstalt verbesseren, das es h(err) <persName ref="p3067">Johan Stumpf</persName> <lb xml:id="p2z6"/>wirt zuͦ sonderem danck annemmen.</s>
					<s n="14" xml:lang="la">Omnia autem <lb xml:id="p2z7"/>nec invidiose nec ulla cum offensione aut feile ullo, sed <lb xml:id="p2z8"/>placide, candide, libere, vere, simpliciter.</s>
					<s n="15" xml:lang="la" ana="farewell">Vale.</s>
					<s n="16" xml:lang="la">Celerri<lb xml:id="p2z9"/>me, pulsante et in senatum vocante me statore.</s>
					<s n="17" xml:lang="la">XV. <lb xml:id="p2z10"/>die Ianuarii, anno MDXLV.</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z11"/><persName ref="p1055">Frechti</persName> literas remitte.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Tuus <persName ref="p8049">Vadianus</persName><lb xml:id="p2z12"/>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z13"/>Domino <persName ref="p495">Heinricho Bullingero</persName>, do<lb xml:id="p2z14"/>m<lb xml:id="p2z15"/>in<lb xml:id="p2z16"/>o et a<lb xml:id="p2z17"/>mi<lb xml:id="p2z19"/>c<lb xml:id="p2z22"/>o <lb xml:id="p2z23"/>lo<lb xml:id="p2z24"/>nge <lb xml:id="p2z25"/>m<lb xml:id="p2z26"/>axi<lb xml:id="p2z27"/>me c<lb xml:id="p2z28"/>ol<lb xml:id="p2z29"/>en<lb xml:id="p2z30"/>do.</s>
				</p>
			</div>
		</body>
	</text>
