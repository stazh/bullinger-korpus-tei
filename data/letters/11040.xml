	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Ecce tibi, mi <persName ref="p495">Bullingere</persName>, quae olim miseras<note xml:id="fn1" type="footnote" n="1">Worum es sich handelte, bleibt ungewiß. Zu denken ist vielleicht an <persName ref="p3242">Utingers</persName> Beschreibung des <placeName ref="l2481">Schwabenkriegs</placeName>, nach der sich <persName ref="p8418">Myconius</persName> erkundigt hatte (s. oben <ref target="file10976">Nr. 934</ref>, 51f).</note>.</s>
					<s n="2" xml:lang="la">Visum est enim praestare, <lb xml:id="p1z2"/>ut librum apud te seu <persName ref="p4851">Froschouuerum</persName> expleant, quam ut pereant <lb xml:id="p1z3"/>apud me.</s>
					<s n="3" xml:lang="la">Vix fieri potest enim, ut non usui sint aliquo descriptori.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Cęterum, quod nihil scribis, tametsi miror, invenio tamen, quo hactenus <lb xml:id="p1z5"/>te excusarim.</s>
					<s n="5" xml:lang="la">Si perrexeris, tu videto, quam causam excogites <lb xml:id="p1z6"/>silentii.</s>
					<s n="6" xml:lang="la">Tempora sunt, quibus tacere ratione tali bonis viris <lb xml:id="p1z7"/>et populi christiani ducibus non convenit.</s>
					<s n="7" xml:lang="la">Si Arianismum isti r<lb xml:id="p1z8"/>educere conantur, uti coepisse audio,<note xml:id="fn2" type="footnote" n="2">Vgl. den Bericht über die <placeName ref="l280">Lausanner</placeName> Synode im Brief <persName ref="p8412">Meganders</persName> an <persName ref="p495">Bullinger</persName> vom 22. Mai, unten <ref target="file11041">Nr. 999</ref>, 9-15.</note>, vel potius <persName ref="p6589">Serveti</persName> <placeName ref="l875">Hispani</placeName> <lb xml:id="p1z9"/>pessimum errorem confirmare, erit, quod agant viri docti.</s>
					<s n="8" xml:lang="la">Quamv<lb xml:id="p1z10"/>is <lb xml:id="p1z11"/>vero sciam propter meam parvitatem hic nihil futurum mihi<note xml:id="fnb" type="footnote" n="b">mihi <hi>über der Zeile nachgetragen.</hi></note> negocii, <lb xml:id="p1z12"/>scribendo tamen monere seu hortari seu narrare quid possem, <lb xml:id="p1z13"/>quod ad rem foret forsitan<note xml:id="fnc" type="footnote" n="c">forsitan <hi>am Rande nachgetragen.</hi></note> aliqua ratione.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Literas <persName ref="p1365">Grynęi</persName> iamdum retineo <lb xml:id="p1z14"/>apud me, quas, inquam, tu scripsisti<note xml:id="fn3" type="footnote" n="3">Nicht erhalten.</note>, et bona fide retineo usque <lb xml:id="p1z15"/>in adventum eius; speramus post dies octo vel decem rediturum<note xml:id="fn4" type="footnote" n="4">Grund der Abwesenheit war wohl der von <persName ref="p1365">Grynäus</persName> angekündigte Badeaufenthalt; vgl. oben <ref target="file11033">Nr. 991</ref>, 141f.</note>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p467">Bucerus</persName> ab <placeName ref="l18">Augustanis</placeName> vocatus nunc apud eos est<note xml:id="fn5" type="footnote" n="5">Vgl. oben <ref target="file11039">Nr. 997</ref>, 12.</note>.</s>
					<s n="11" xml:lang="la">Nescio, quid rei <lb xml:id="p1z17"/>sit.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Fratrum <placeName ref="l41">Bernensium</placeName> dissidium<note xml:id="fn6" type="footnote" n="6">Vgl. den Bericht <persName ref="p8412">Meganders</persName>, unten <ref target="file11041">Nr. 999</ref>, 16-21.</note> dabit malum aliquando ecclesię tam <lb xml:id="p1z18"/>grandi et egregiae.</s>
					<s n="13" xml:lang="la">Vae zizaniarum seminatori<note xml:id="fn7" type="footnote" n="7">Vgl. <cit type="bible"><ref>Mt 13, 24-30. 36-42</ref></cit>.</note>!</s>
					<s n="14" xml:lang="la">Videbis olim, <lb xml:id="p1z19"/>quem finem dominus contentiosis parant ingeniis.</s>
					<s n="15" xml:lang="la">Deus spiritu sanct<lb xml:id="p1z20"/>o suo corda nostra, quaesumus, illuminet!</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell">Vale cum tuis et fratribus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb type="edition" next="161"/><lb xml:id="p1z21"/>Ipso die pentecostes mox ante concionem vespertinam, <placeName ref="l28">Basileae</placeName> anno 37.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z22"/><persName ref="p8418">Myconius</persName> <lb xml:id="p1z23"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/>antistiti <placeName ref="l587">Tigurinorum</placeName>, <lb xml:id="p2z4"/>domino colendissimo suo.</s>
				</p>
			</div>
		</body>
	</text>
