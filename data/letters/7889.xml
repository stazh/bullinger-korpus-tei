					<pb/>
					<lb xml:id="p4z1"/>din 11. maii 1569.
					<lb xml:id="p4z2"/>Dem erwurdigen und wolgelertten
					<lb xml:id="p4z3"/>herren Heinrich Bullinger, der ölter
					<lb xml:id="p4z4"/>gethrewer diener der kirchen in
					<lb xml:id="p4z5"/>Zurich, meinen erenden geliebten
					<lb xml:id="p4z6"/>herren
