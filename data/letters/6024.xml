	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Vir clarissime et domine colendissime.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Literas tuas accepi die 7a ianuarii datas.</s>
					<s n="3" xml:lang="la">Valde laetor iustam te excusationem meam <lb xml:id="p1z4"/>accepisse libenterque persequor de iis, quae mihi mandas, te commonefacere.</s>
					<s n="4" xml:lang="la">Te quod excusas <lb xml:id="p1z5"/>apud me de hac, quam vocas petacitate, nihil est; ego enim tuum hoc studium solicitudi<lb xml:id="p1z6"/>nemque pro ecclesia dei valde probo et, in ea ut perseveres, te vehementer hortor; <lb xml:id="p1z7"/>est enim pastoris munus vigilare super gregem.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Deus utinam tibi tuisque laboribus <lb xml:id="p1z8"/>benedicat.</s>
					<s n="6" xml:lang="la">Ex <placeName ref="l834">Italia</placeName> nihil de eorum apparatu auditur, quod nostra interesse existimem.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z9"/>Muniunt loca maritima propter <placeName ref="l2510">Turcam</placeName>, et <placeName ref="l522">Veneti</placeName> aliquot hominum millia in ditione sua <lb xml:id="p1z10"/>collegerunt ad instruendam classem, quam educent, quam primum per opportunitatem <lb xml:id="p1z11"/>temporis licuerit; idem faciunt caeteri <placeName ref="l834">Itali</placeName>; quod autem ad reliquos fines regionis <lb xml:id="p1z12"/>attinet, nihil est innovatum.</s>
					<s n="8" xml:lang="la"><placeName ref="l1107">Tridenti</placeName> ne unum quidem ex patribus mansisse aiunt.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>Credideram tibi nunc 3ae, 4ae et 9ae sessionis decreta mittere; sed propter amici errorem id <lb xml:id="p1z14"/>facere nequeo; mittam prima occasione.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Octavam iam dederam d. <persName ref="p8009">Fabritio</persName> ad te <lb xml:id="p1z15"/>transmittendam.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Mitto libellum <persName>Ioannis</persName> a <placeName>Turre Cremata</placeName>.</s>
					<s n="12" xml:lang="la">Ochinum audimus concessiss<lb xml:id="p1z16"/>e in <placeName ref="l2472">Poloniam</placeName>; eum noluisse resipiscere dolendum est; convertat deus omnes repugnantes <lb xml:id="p1z17"/>veritati aut perdat, si ita expedit in eius gloriam.</s>
					<s n="13" xml:lang="la">Doleo vicem illius provinciae, <lb xml:id="p1z18"/><placeName ref="l2472">Poloniae</placeName> inquam, quae iam utinam non sit omnium errorum sentina.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Gravis nuntius nobis d<lb xml:id="p1z19"/>e pestilentia in <placeName>Palatinatu</placeName> grassante; orandus deus tueatur ecclesiam suam <lb xml:id="p1z20"/>eamque a malo liberet.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Nos hic ab ea contagione sumus liberi; si ad nos redierit <lb xml:id="p1z21"/>primo hoc vere, fiat voluntas domini; in illius manu vita et mors nostra est.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Beati <lb xml:id="p1z22"/>mortui, qui in domino moriuntur.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Vale, mi domine, deumque pro nobis ora.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z23"/><placeName ref="l93">Clavenae</placeName> 8. calendas februarii 1564.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z24"/>Patrem convaluisse nuntiant.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z25"/>Tui observantissimus <persName ref="p2054">Ulisses Martinengus</persName><pb/><lb xml:id="p3z1"/>.</s>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro d. <persName ref="p495">Heinricho Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p4z2"/>ecclesiae pastori integerrimo, domino suo colendissimo.</s>
					<s n="22" xml:lang="la"><lb xml:id="p4z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note type="author">[Bemerkung von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="23" xml:lang="la">Illustrissimi comitis a <persName>Barch</persName> etc. <lb xml:id="p4z4"/>literae ad <persName ref="p495">Bullingerum</persName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>