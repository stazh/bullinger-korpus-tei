	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hodie tuas accepi, charissime compater, nec habeo, quod <lb xml:id="p1z2"/>ad illas multis respondeam.</s>
					<s n="3" xml:lang="la">Dolet mihi tua infirm<lb xml:id="p1z3"/>itas; dominus te restituat et conservet!</s>
					<s n="4" xml:lang="la">Pro <placeName ref="l294">Locar<lb xml:id="p1z4"/>nensibus</placeName> quid nunc a nostris fiat, ego quoque ignoro.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Paucissimi senatorum sunt in urbe propter vindemiam.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/><placeName ref="l167">Genevenses</placeName> huc miserunt unum ex ministris, qui conquereretur <lb xml:id="p1z7"/>apud senatum, quod <persName ref="p540">Calvini</persName> nomen tanquam haereticum <lb xml:id="p1z8"/>a quibusdam ditionis nostrae ministris <lb xml:id="p1z9"/>traducatur, et hoc ipsis esse intolerabile.</s>
					<s n="7" xml:lang="la">Sed remissum <lb xml:id="p1z10"/>est hoc negotium usque ad diem Martini; tum accusatores <lb xml:id="p1z11"/>simul et rei aderunt.</s>
					<s n="8" xml:lang="la">Ego valde metuo <lb xml:id="p1z12"/>graves turbas; sed invocato domini nomine dabimus operam, <lb xml:id="p1z13"/>ut, quam commode fieri possit, sopiantur.</s>
					<s n="9" xml:lang="la">Tu si quid habes con<lb xml:id="p1z14"/>silii, suggerito interea.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ex te cognoscere cu[pio], <lb xml:id="p1z15"/>quid <persName ref="p3099">Sultzerus</persName> apud vos egerit, praesertim quid [tecum] <lb xml:id="p1z16"/>contulerit et quid tibi de illo videatur.</s>
					<s n="11" xml:lang="la"><placeName ref="l491">Argentin[am]</placeName> <lb xml:id="p1z17"/>abiit pro sedanda ea controversia, quę nunc illic, ut scis, est.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z18"/>De tumultu <placeName ref="l830">Anglico</placeName>, uti promittis, fac quaeso certiores <lb xml:id="p1z19"/>nos, postquam certiora cognoveris.</s>
					<s n="13" xml:lang="la">Nos nihil <lb xml:id="p1z20"/>habemus.</s>
					<s n="14" xml:lang="la" ana="salute">Salutant te vicissim nostri omnes.</s>
					<s n="15" xml:lang="la">Trem<lb xml:id="p1z21"/>pio tuas tradidi.</s>
					<s n="16" xml:lang="la" ana="salute">Salutat te <persName ref="p3494">N[icolaus] a Dießbach</persName>, qui <lb xml:id="p1z22"/>et ipse has tibi mittit.</s>
					<s n="17" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="18" xml:lang="la">13. octobris 1554.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z23"/><placeName ref="l41">Bernae</placeName>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p8018">Ioannes Hallerus</persName> <lb xml:id="p1z25"/>totus tuus.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae fidelissimo <lb xml:id="p2z4"/>pastori, domino et <lb xml:id="p2z5"/>compatri suo pie <lb xml:id="p2z6"/>colendo.</s>
				</p>
				<p>
					<s n="22" xml:lang="de"><lb xml:id="p2z7"/>M. <persName ref="p495">Heinrych <lb xml:id="p2z8"/>Bullingeren</persName> zuͦ <lb xml:id="p2z9"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>