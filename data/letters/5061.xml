	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><pb type="scan" next="735"/><lb xml:id="p1z1"/>Intellexi, vir ornatissime, ex <persName ref="p8075">Erasto</persName> nostro literas, quas <lb xml:id="p1z2"/>nuper ad te per D. <persName>Marium</persName> dedi, tibi redditas et gratas <lb xml:id="p1z3"/>fuisse, quapropter iterum ad te scribo, ut intelligas <lb xml:id="p1z4"/>te tuosque omnes mihi meisque omnibus charos esse.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z5"/>Responsionem tuam adversus monstrum ubiquitatis <lb xml:id="p1z6"/>avide expectamus, optaremusque et latine <lb xml:id="p1z7"/>et Germanice id in publicum aedi, ut qui latina <lb xml:id="p1z8"/>non intelligant et animos iam opinionibus <lb xml:id="p1z9"/>fascinatos habent, Germanico scripto ad<lb xml:id="p1z10"/>monerentur.</s>
					<s n="3" xml:lang="la">Dici non potest, quantopere <lb xml:id="p1z11"/>huius pestilentissimae doctrinae authores suum <lb xml:id="p1z12"/>monstrum disseminare et quotidie hominibus <lb xml:id="p1z13"/>inculcare satagant.</s>
					<s n="4" xml:lang="la">Nos in eo toti sumus, <lb xml:id="p1z14"/>ut Ecclesias nostras ab his fecibus purgemus, <lb xml:id="p1z15"/>sed non sine magna difficultate, invidia et <lb xml:id="p1z16"/>periculo.</s>
					<s n="5" xml:lang="la">Verum dominus (cuius res tota est) et <lb xml:id="p1z17"/>consilia dat et eventus gubernat.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z18"/>Audivi iam pridem libellum tuum priorem, <lb xml:id="p1z19"/>quem de verbis christi (in domo patris mei etc.) <lb xml:id="p1z20"/>conscripsisti germanice quoque vulgatum <lb xml:id="p1z21"/>esse, sed non vidi cuperem itaque id abs te <lb xml:id="p1z22"/>certo cognoscere.</s>
					<s n="7" xml:lang="la">Nam si aeditus non est operam <lb xml:id="p1z23"/>dabimus, ut <placeName ref="l822">Germanice</placeName> <lb xml:id="p1z24"/>quoque loqui incipiat.</s>
					<s n="8" xml:lang="la"><persName ref="p8111">Petri Martyris</persName> <lb xml:id="p1z25"/>de eadem re liber iam prope conversus est.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb type="scan" next="736"/><pb/><lb xml:id="p2z1"/>Res <placeName ref="l832">Galliae</placeName> se satis commode habere partim ex <lb xml:id="p2z2"/>tuis partim ex aliorum accepimus literis, misimus e<lb xml:id="p2z3"/>o rogatu <persName ref="p18090">Regis Navarrae</persName> duos Theologos <lb xml:id="p2z4"/>viros pios doctos et tibi (ni fallor) notos: <lb xml:id="p2z5"/>D. <persName ref="p4639">Michaelem Tillerum</persName> et P. <persName>Boquinum</persName>, <lb xml:id="p2z6"/>quos intelligis sanae doctrinae ex animo favere.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z7"/>Utinam et alii, qui eo missi sunt, <lb xml:id="p2z8"/>id facerent.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Miramur autem illos iam fere vi <lb xml:id="p2z9"/>septimanis in <placeName ref="l832">Gallia</placeName> haesisse et <lb xml:id="p2z10"/>ne verbum quidem ad nos scripsisse.</s>
					<s n="12" xml:lang="la">Et <lb xml:id="p2z11"/>quantum intelligere seu coniectura assequi <lb xml:id="p2z12"/>possumus metuimus, ne literae aut interceptae <lb xml:id="p2z13"/>sin<lb xml:id="p2z14"/>t aut cursores impediantur.</s>
					<s n="13" xml:lang="la">Quare <lb xml:id="p2z15"/>rem gratam nobis facies, si primo <lb xml:id="p2z16"/>tempore nos de statu totius causae certio<lb xml:id="p2z17"/>res feceris, quod si tabellarii deerunt, <lb xml:id="p2z18"/>nostris sumptibus ad nos aliquem mittito.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z19"/>Interest enim et vestra et nostra communicar<lb xml:id="p2z20"/>i consilia.</s>
					<s n="15" xml:lang="la">Hoc tibi semel de nobis <lb xml:id="p2z21"/>persuadeas velim, nos hactenus et dedisse <lb xml:id="p2z22"/>et in posterum daturos operam, ut agnitam <lb xml:id="p2z23"/>doctrinam pro virili tueamur, propa<lb xml:id="p2z24"/>gemus et adversariorum consilia <lb xml:id="p2z25"/>impediamus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb type="scan" next="737"/><pb/><lb xml:id="p3z1"/>Opus habemus viro maturi iudicii doctri<lb xml:id="p3z2"/>nae pietatis et authoritatis hic <placeName ref="l210">Heydelbergae</placeName>, <lb xml:id="p3z3"/>quem libenter in senatum Ecclesiasti<lb xml:id="p3z4"/>cum reciperemus, illique <lb xml:id="p3z5"/>nostrorum Ecclesiarum vicinarum inspectionem <lb xml:id="p3z6"/>et unicam in hebdomada concionem deman<lb xml:id="p3z7"/>deremus.</s>
					<s n="17" xml:lang="la">Tu, si quem habes, quo carere possis, <lb xml:id="p3z8"/>vir clarissime, nos iuvato.</s>
					<s n="18" xml:lang="la">Et in domino <lb xml:id="p3z9"/>cum tuis omnibus foeliciter valeto.</s>
					<s n="19" xml:lang="la">Do<lb xml:id="p3z10"/>minus collegas tuos omnes meo nomine <lb xml:id="p3z11"/>valeto.</s>
					<s n="20" xml:lang="la">Raptim <placeName ref="l210">Heydelbergae</placeName> <lb xml:id="p3z12"/>13. novembris anno 1561</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p3z13"/>Tuus ex amino <lb xml:id="p3z14"/><persName ref="p997">Christophorus <lb xml:id="p3z15"/>Ehemius</persName>, palatini <lb xml:id="p3z16"/>consiliarius</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="salute"><lb xml:id="p3z17"/>D. <persName>Probus</persName> et <persName ref="p8094">Cirlerus</persName> te salutant.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb type="scan" next="737a"/><pb/><lb xml:id="p4z1"/>Clarissimo viro D. <persName ref="p495">Henricho Bullingero</persName> <lb xml:id="p4z2"/>verbi Dei apud <placeName ref="l587">Tigurinos</placeName> Ministro <lb xml:id="p4z3"/>domino et amico suo in primis <lb xml:id="p4z4"/>colendo<lb xml:id="p4z5"/>.</s>
					<s n="24" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
