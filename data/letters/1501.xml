	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quas 28. novembris scripsisti, <lb xml:id="p1z2"/>compater in domino charissime, prima mensis <lb xml:id="p1z3"/>huius accepi.</s>
					<s n="3" xml:lang="la">Distineor occu<lb xml:id="p1z4"/>patione scribendi <placeName ref="l18">Augustanis</placeName> et <lb xml:id="p1z5"/>ecclesiae illius fidelibus iam misere <lb xml:id="p1z6"/>periclitantibus pro mea mediocritate <lb xml:id="p1z7"/>succurrendi.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Obtrusus est illis <lb xml:id="p1z8"/>catechismus papisticis impuritatibus <lb xml:id="p1z9"/>infectus.</s>
					<s n="5" xml:lang="la">Hunc miserunt ad me <lb xml:id="p1z10"/>boni viri obsecrantes per Christum, <lb xml:id="p1z11"/>ut illi respondeam.</s>
					<s n="6" xml:lang="la">Non potui <lb xml:id="p1z12"/>votis illorum tam necessariis et christianis <lb xml:id="p1z13"/>deesse; scripsi igitur et <lb xml:id="p1z14"/>pleraque illius carptim perstrinxi.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Mitto ad te utrumque exemplar, sed <lb xml:id="p1z16"/>ea conditione, ut adulterina <lb xml:id="p1z17"/>dogmata non legas tantum, sed et ipse <lb xml:id="p1z18"/>refellas.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z19"/>Illud, quod de captis <placeName ref="l830">Angliae</placeName> princi<lb xml:id="p1z20"/>pibus scripsisti, non satis intelligo, <lb xml:id="p1z21"/>caedatne in detrimentum causae <lb xml:id="p1z22"/>Christi vel secus; quare te oro, <lb xml:id="p1z23"/>clarius, ubi commodum erit, ea <lb xml:id="p1z24"/>de re scribas.</s>
					<s n="9" xml:lang="la">Metuo insidias et <lb xml:id="p1z25"/>technas Carolinas, ne quid vene<lb xml:id="p1z26"/>ni inferant regno laboranti et non<lb xml:id="p1z27"/>dum satis confirmato.</s>
					<s n="10" xml:lang="la" ana="farewell">Optime vale.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z28"/>Heri accepi Caesarem esse <placeName ref="l1107">Tridenti</placeName>, <lb xml:id="p1z29"/>ut authoritate praesentię suae molem <lb xml:id="p1z30"/>Satanae, quo destinata est, impellat.</s>
					<s n="12" xml:lang="de"><lb xml:id="p1z31"/><placeName ref="l41">Bernę</placeName> 1551. 12. decembris.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z32"/><persName ref="p8417">W[olfgangus] Musc[ulus]</persName>, compater tuus <lb xml:id="p1z33"/>in domino.</s>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo m. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho <lb xml:id="p2z4"/>Bullingero</persName>, <lb xml:id="p2z5"/>compatri suo <lb xml:id="p2z6"/>in Christo charissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
