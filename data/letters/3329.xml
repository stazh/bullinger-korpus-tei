	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p8494">Hermannus Pincierus</persName> <persName ref="p495">Henricho Bullingero</persName> salutem per Christum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Si ad alium quam te scribendum mihi fuisset, permultum du<lb xml:id="p1z3"/>bitassem, ne in impudentiae suspitionem aliquam inciderem.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Tua vero summa humanitas, qua erga me ignotum nuper, cum <lb xml:id="p1z5"/><placeName ref="l587">Tyguri</placeName> essem, usus es, propensissimaque in peregrinos omnes voluntas <lb xml:id="p1z6"/>facit, nihil ut tale metuam et liberrime ad te, quae volo, scribam.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Hi duo adolescentes fama <placeName ref="l587">Tygurinae</placeName> urbis permoti ad eam <lb xml:id="p1z8"/>videndum profecturi a me petierunt, eis aliquas aliquas literas a<lb xml:id="p1z9"/>ccommodarem, quarum subsidio in unius alteriusque notitiam invaderent <lb xml:id="p1z10"/>suique propositi finem facilius consequerentur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Etsi vero difficulter <lb xml:id="p1z11"/>eis ipse interioribus amicis carens in hoc gratificari potuerim, <lb xml:id="p1z12"/>tamen, cum illi instarent et mihi de tua benevolentia in mentem <lb xml:id="p1z13"/>veniret, nolui committere, ut rusticus inanisque pudor hoc eorum <lb xml:id="p1z14"/>desyderium ac summam iucunditatem impediisse videretur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Itaque abs te peto, velis eos in tuum conspectum admittere unoque <lb xml:id="p1z16"/>verbo dignari; id illi magnum reputabunt, et ego summi beneficii <lb xml:id="p1z17"/>loco habebo.</s>
					<s n="7" xml:lang="la">Caeterum siquid de religionis statu in <placeName ref="l2485">Carynthia</placeName> <lb xml:id="p1z18"/>ac <placeName ref="l2486">Styria</placeName> scire desideras, alter eorum nunc ex istis partibus <lb xml:id="p1z19"/>huc venit; ei multa sunt nota, quae tibi, si audiveris, cognitu <lb xml:id="p1z20"/>non erunt iniucunda.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale in Christo et me, ut omnes <lb xml:id="p1z21"/><persName ref="p8494">Pincieros</persName> soles, ama.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l28">Basilęa</placeName> 24. septembris anno 57.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Optimo doctissimoque viro <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tygurinae</placeName> ecclesiae ministro <lb xml:id="p2z3"/>fidelissimo, domino suo.</s>
				</p>
			</div>
		</body>
	</text>
