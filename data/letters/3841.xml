	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Cum nuper istic esset <persName ref="p8009">Fabricius</persName> noster, rogatus ab <persName ref="p20260">Alexandro</persName>, <lb xml:id="p1z3"/>filio nostro, bibliopolae mandavit, ut Decadus tuae illi festorumque <lb xml:id="p1z4"/>dierum domini et servatoris nostri Iesu Christi sermones, omnia in unum <lb xml:id="p1z5"/>volumen scitissime ligarentur; pecunias tamen nullas dedit, quod ab <lb xml:id="p1z6"/>illo nullas accepisset.</s>
					<s n="3" xml:lang="la">Mittit igitur hic monetam hanc conficientem <lb xml:id="p1z7"/>plenos iustosque bacios, quos <placeName ref="l257">Constantienses</placeName> appellatis, 35; tot enim <lb xml:id="p1z8"/>satis esse opinamur; sin minus, mittemus proximo nuntio, et quod <lb xml:id="p1z9"/>plus petitur; tantum mittat librum bibliopola, et quantum acceperit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>Filius, qui librum emit, tui est observantissimus et, quicquid proficis<lb xml:id="p1z11"/>citur a te, sacrosanctum putat servatque pro reliquiis non tangendis, <lb xml:id="p1z12"/>quaecunque tuis sunt digitis exarata.</s>
					<s n="5" xml:lang="la">Obsecro igitur, ut pro <lb xml:id="p1z13"/>tua humanitate exhilares illum dignerisque in libro scribere <lb xml:id="p1z14"/>vel ista: "<persName ref="p495">Heinrychus Bullingerus</persName> <persName ref="p20260">Alexandro Salutio</persName>, <placeName ref="l778">Tusanae</placeName> Christi <lb xml:id="p1z15"/>evangelium praedicanti librum hunc mittit."</s>
					<s n="6" xml:lang="la">Hoc enim exhilaratus <lb xml:id="p1z16"/>cupidius leget librum, quam si ego, qui pater, centies eum hortarer <lb xml:id="p1z17"/>ad eius aurei operis lectionem, et gratius erit illi, quam si plurim<lb xml:id="p1z18"/>is aureis abs te donaretur.</s>
					<s n="7" xml:lang="la">Tantillo, quaeso, vir humanissime <lb xml:id="p1z19"/>gratificemur iuveni minime malo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Caeterum nova hic <lb xml:id="p1z20"/>penitus sunt nulla, quae quidem sint digna, ut ad tuam praest<lb xml:id="p1z21"/>antiam scribantur.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale in domino Iesu, virorum humanissime, <lb xml:id="p1z22"/><persName ref="p8359">Philippum</persName>, veterem tuum amicum, redamare non desine.</s>
					<s n="10" xml:lang="la">Ex <placeName ref="l98">Curia</placeName> <lb xml:id="p1z23"/>16. ianuarii anni 1559.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/>Tuae integritatis totus ut semper <persName ref="p8359">Philippus Gallicius</persName><pb/><lb xml:id="p2z4"/>.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z5"/>Vere magno viro <lb xml:id="p2z6"/>d. <persName ref="p495">Heinrycho <lb xml:id="p2z7"/>Bullingero</persName>, bonis omn<lb xml:id="p2z8"/>ibus honorandissimo.</s>
					<s n="13" xml:lang="de">Zürch.</s>
				</p>
				<p>
					<s n="14" xml:lang="de">Mais<lb xml:id="p2z9"/>ter <persName ref="p495">Hainrich Bullin<lb xml:id="p2z10"/>ger</persName>.</s>
				</p>
			</div>
		</body>
	</text>
