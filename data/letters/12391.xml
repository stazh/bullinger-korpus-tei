	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ego vero non dubito, quin meas<note xml:id="fn1" type="footnote" n="1">Nr. 2335 vom 27./28. Januar 1546.</note> iam acceperis, mi venerande <lb xml:id="p1z2"/>et charissime <persName ref="p495">Bullingere</persName>; quibus nihil est, quod in praesentia addam, <lb xml:id="p1z3"/>nisi quod <persName ref="p4442">Buflerus</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p4442">Peter Buffler</persName>.</note> heri ad me scripsit<note xml:id="fn3" type="footnote" n="3">Nicht in <hi><persName ref="p8055">Blarer</persName> BW.</hi></note> d. <persName ref="p7689">Navis</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p7689">Johann von Naves</persName>, Reichsvizekanzler.</note>, <persName ref="p18538">caesaris</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p18538">Karl V.</persName></note> commissarium, <lb xml:id="p1z4"/>a comite a <placeName ref="l1404">Furstenberg</placeName> captum haud procul a <placeName ref="l157">Francofordia</placeName>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Interim autem non scribit, uter ex comitibus, <persName ref="p20485">Federichus</persName> an <persName ref="p7492">Gulielmus</persName>,<note xml:id="fn6" type="footnote" n="6"><persName ref="p20485">Friedrich II.</persName> oder <persName ref="p7492">Wilhelm von Fürstenberg</persName>.</note> <lb xml:id="p1z6"/>istuc fecerit aut quas ob caussas, nec etiam cuius nomine, <lb xml:id="p1z7"/>suopte an caesaris<note xml:id="fn7" type="footnote" n="7">Ein Gerücht.</note>.</s>
					<s n="4" xml:lang="la">Affirmat deinde <persName ref="p18536">Sabaudię principem</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p18536">Karl III. von Savoyen</persName>.</note> <lb xml:id="p1z8"/>cum 10000 <placeName ref="l875">Hispanis</placeName> militibus a <persName ref="p20225">Gallo</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p20225">Franz I.</persName></note> trucidatum;<note xml:id="fn10" type="footnote" n="10">Ein Gerücht.</note> id quod <lb xml:id="p1z9"/>mihi nondum fit verisimile.</s>
					<s n="5" xml:lang="la">Certiora nos tempus docebit.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Quę <persName ref="p1010">Erbius</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p1010">Matthias Erb</persName>.</note> ad te scripsit<note xml:id="fn12" type="footnote" n="12">Im Brief vom 24. Januar 1546 (<ref target="file12380">Nr. 2333</ref>), aus dem <persName ref="p495">Bullinger</persName> am 30. Januar an <persName ref="p8055">Blarer</persName> berichtete; s. <ref target="file12387">Nr. 2340</ref>,8-17.</note>, ante sesquimensem ex nobili <persName ref="p7385">Caspare <lb xml:id="p1z11"/>ab Anwyl</persName><note xml:id="fn13" type="footnote" ana="bio" n="13">Der <placeName ref="l774">Thurgauer</placeName> <persName ref="p7385">Hans Kaspar von Anwyl</persName>, geb. ca. 1509, gest. 12. Oktober 1562, von 1537 bis 1553 <placeName ref="l572">württembergischer</placeName> Obervogt von <placeName ref="l26">Balingen</placeName>; s. Emil <hi>Egli,</hi> Ritter Franz Jakob von Anwyl, thurgauischer Edelmann und Verehrer Zwinglis, in: <bibl source="b714">Zwa</bibl> 2/2, 1905, 50; <bibl source="b509">Pfeilsticker</bibl> I 1293; II 2162. 2322. 2875 (dort "Anweil").</note>, qui <placeName ref="l26">Balingensi</placeName> provincię praefectus est, rescivi<note xml:id="fn14" type="footnote" n="14">Brief nicht in <hi><persName ref="p8055">Blarer</persName> BW.</hi></note>.</s>
					<s n="7" xml:lang="la"><persName ref="p6820">Petrus <lb xml:id="p1z12"/>Tossanus</persName> ante hoc decennium<note xml:id="fn15" type="footnote" n="15">Wohl 1534.</note> a <persName ref="p1365">Grynęo</persName><note xml:id="fn16" type="footnote" n="16"><persName ref="p1365">Simon Grynäus</persName>.</note> et me in <placeName ref="l572">Wirtembergensem</placeName> <lb xml:id="p1z13"/>ditionem monachis <placeName ref="l52">Blauburensis</placeName> cęnobii<note xml:id="fn17" type="footnote" n="17"><placeName ref="l52">Blaubeuren</placeName>.</note> praelecturus vocabatur;<note xml:id="fn18" type="footnote" n="18">Siehe Theodor <hi>Keim,</hi> Ambrosius Blarer. Der schwäbische Reformator, Stuttgart, 1860, S. 75; <bibl source="b657">Viénot</bibl> I 49.</note> <lb xml:id="p1z14"/>quem <persName ref="p9708">princeps</persName><note xml:id="fn19" type="footnote" n="19"><persName ref="p9708">Ulrich von Württemberg</persName>.</note> deinde<note xml:id="fn20" type="footnote" n="20">Im Sommer 1535; s. <bibl source="b657">Viénot</bibl> I 53.</note> ad <placeName ref="l327">Montbelgardum</placeName>, ut ecclesię illic <lb xml:id="p1z15"/>ministraret, misit.</s>
					<s n="8" xml:lang="la">Vir est ardentissimo dei zelo flagrans, <lb xml:id="p1z16"/>solide<note xml:id="fna" type="footnote" n="a"><hi>In der Vorlage</hi> solide.</note> doctus, qui pro Christi nomine a papistis indigna valde <lb xml:id="p1z17"/>pertulit.</s>
					<s n="9" xml:lang="la">Laudandus omnino senior princeps, quod tantum <lb xml:id="p1z18"/>ab omni superstitione abhorreat; quo mihi nomine semper <lb xml:id="p1z19"/>et impendio placuit illius animus, quantumvis multa <lb xml:id="p1z20"/>sint, quę in ipso desiderantur.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="10" xml:lang="la">Quod <persName ref="p8472">Conrado Curioni</persName><note xml:id="fn21" type="footnote" n="21"><persName ref="p8472">Konrad Hofherr</persName>.</note> nostro <lb xml:id="p1z21"/>tam plenum fers testimonium,<note xml:id="fn22" type="footnote" n="22">Nr. 2340,5-7.</note> maximopere me exhilaravit.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z22"/>Ille vicissim tuam erga se non vulgarem benevolentiam et animum <lb xml:id="p1z23"/>plane paternum mire depraedicat, ut maximas tibi huius caussa <lb xml:id="p1z24"/>gratias debeam, per Christum te obsecrans, ut porro quoque, <lb xml:id="p1z25"/>quod hactenus fecisti, facias.</s>
					<s n="12" xml:lang="la">Ita enim de illius profectu nihil <lb xml:id="p1z26"/>quicquam dubitarim.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="13" xml:lang="la">Magna hic gratia ecclesiam nostram domini <lb xml:id="p1z27"/>verbo salutavit, ut non pęnitenda mihi de illo pollicear, <lb xml:id="p1z28"/>si vestris consiliis (quod sancte se facturum recepit) paruerit, <lb xml:id="p1z29"/>quando vestrę rigationi cęleste incrementum deesse haudquaquam<pb type="edition" next="132"/> poterit<note xml:id="fn23" type="footnote" n="23">Vgl. <cit type="bible"><ref>1Kor 3, 6f</ref></cit>.</note>.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z30"/>De <persName ref="p5829">Mezlero</persName><note xml:id="fn24" type="footnote" n="24"><persName ref="p5829">Jakob Metzler</persName>.</note> proxime ad te scripsi<note xml:id="fn25" type="footnote" n="25">Nämlich <ref target="file12382">Nr. 2335</ref>,17-26.</note>.</s>
					<s n="15" xml:lang="la">Vereor autem, ut primę <lb xml:id="p1z31"/>expectationi facturus sit satis, nisi alium hominem quamprimum <lb xml:id="p1z32"/>induat<note xml:id="fn26" type="footnote" n="26">Vgl. <cit type="bible"><ref>Kol 3, 9</ref></cit>.</note>.</s>
					<s n="16" xml:lang="la" ana="salute">Tu bene vale, anime mi, venerande et plusquam charissime <lb xml:id="p1z33"/>frater, cum tota tua domo, quam mea vice unice iubebis salvere <lb xml:id="p1z34"/>cum omnibus fratribus et amicis, <persName ref="p8011">Gvalthero</persName>, <persName ref="p8171">Theodoro</persName><note xml:id="fn27" type="footnote" n="27"><persName ref="p8171">Theodor Bibliander</persName>.</note>, <persName ref="p8127">Pellicano</persName>, <lb xml:id="p1z35"/><persName ref="p8437">Fabricio</persName><note xml:id="fn28" type="footnote" n="28"><persName ref="p8437">Erasmus Schmid</persName>.</note>, etc.</s>
					<s n="17" xml:lang="la" ana="salute">Salutant te seque tibi commendant nostri, praecipue <lb xml:id="p1z36"/><persName ref="p4082">Zviccius</persName> noster<note xml:id="fn29" type="footnote" n="29"><persName ref="p4082">Konrad Zwick</persName>.</note>.</s>
					<s n="18" xml:lang="la"><persName ref="p8178">Frater</persName><note xml:id="fn30" type="footnote" n="30"><persName ref="p8178">Thomas Blarer</persName>.</note> nondum rediit<note xml:id="fn31" type="footnote" n="31">Zur Rückkehr <persName ref="p8178">Thomas Blarer</persName>s vom <placeName ref="l1202">Schmalkaldischen</placeName> Bundestag in <placeName ref="l157">Frankfurt</placeName> s. <ref target="file12401">Nr. 2354</ref>,1.</note>.</s>
					<s n="19" xml:lang="la">Ora pro nobis diligenter.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z37"/><placeName ref="l257">Constantiae</placeName>, 3. februarii 1546.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z38"/>Tuus <persName ref="p8055">Ambr. Bl.</persName></s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>incomparabilis candoris <lb xml:id="p2z4"/>et constantię amico<note xml:id="fn32" type="footnote" n="32">Der Brief wurde durch <persName ref="p8472">Konrad Hofherr</persName> übermittelt; s. <ref target="file12413">Nr. 2366</ref>,10.</note>.</s>
				</p>
			</div>
		</body>
