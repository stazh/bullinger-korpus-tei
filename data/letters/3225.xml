	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto rursus ad te 5 terniones, opqrs; <lb xml:id="p1z2"/>praecedentes omnes tibi esse redditas puto.</s>
					<s n="3" xml:lang="la">Spero <lb xml:id="p1z3"/>autem intra 3 septimanas aut paulo ante colophonem <lb xml:id="p1z4"/>nos toti operi, excepta tamen praefatione et <lb xml:id="p1z5"/>indice, imposituros.</s>
					<s n="4" xml:lang="la">Mitto enim literas nuper <lb xml:id="p1z6"/>ad me partim a <persName ref="p8124">Naogeorgo</persName> missas tibique <lb xml:id="p1z7"/>inscriptas, partim etiam a d. <persName ref="p2639">Valerando Pol<lb xml:id="p1z8"/>lano</persName> ad d. <persName ref="p8111">Petrum Martyrem</persName>, quem hortari is <lb xml:id="p1z9"/>me iubet, ut mox respondeat et vel proprio <lb xml:id="p1z10"/>tabellario ad illum (si alias commode non li<lb xml:id="p1z11"/>ceat) responsum mittat.</s>
					<s n="5" xml:lang="la">Quod reliquum est, valde <lb xml:id="p1z12"/>oro te, mi d. <persName ref="p495">Bullingere</persName>, quoniam in Commentariis <lb xml:id="p1z13"/>tuis alicubi citari a te legi <persName>Theodorichum</persName> <lb xml:id="p1z14"/>a <placeName ref="l1221">Niceno</placeName> sive historiam eius de <persName>pontificibus <lb xml:id="p1z15"/>Romanis</persName> sive de schismatibus ecclesię et inde <lb xml:id="p1z16"/>eum autorem habere existimo, ut prima quaque occasione <lb xml:id="p1z17"/>eius usumfructum ad paucos dies tantum nobis <lb xml:id="p1z18"/>concedas.</s>
					<s n="6" xml:lang="la">Remittemus autem ad te bona fide <lb xml:id="p1z19"/>brevi.</s>
					<s n="7" xml:lang="la">Quęsivit eum tota urbe nostra d. <persName ref="p8155">Ioannes <lb xml:id="p1z20"/>Baleus</persName> et vehementer inspicere unum atque alterum <lb xml:id="p1z21"/>in eo locum vellet, sed non reperit hic.</s>
					<s n="8" xml:lang="la">Gratifica<lb xml:id="p1z22"/>beris igitur et mihi et optimo seni <persName ref="p8155">Baleo</persName> et <lb xml:id="p1z23"/>ipsi adeo reipublicae, si brevi illum ad nos mittas.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z24"/>Poteris autem commode ad uxorem meam in Thermis <lb xml:id="p1z25"/>iam cum iunioris <persName ref="p1227">Froschoveri</persName> uxore <foreign xml:lang="de">im hoff</foreign> agentem <lb xml:id="p1z26"/>et forte una atque altera septimana adhuc isthic hę<pb/><lb xml:id="p2z1"/>suram, quicquid perferri ad me tuto voles, destinare, <lb xml:id="p2z2"/>nec deerit illi singulis ferme diebus ad <lb xml:id="p2z3"/>me mittendi opportunitas.</s>
					<s n="10" xml:lang="la" ana="farewell">Bene vale et domino <lb xml:id="p2z4"/><persName ref="p8171">Theodoro</persName> dices me tandem Arabicum evangelium cum <lb xml:id="p2z5"/>apostolis Pauli esse nactum <persName>Alberti</persName> idmestadii, <lb xml:id="p2z6"/>cuius etiam opera est editum, liberalitate.</s>
					<s n="11" xml:lang="la" ana="salute">Salutabis <lb xml:id="p2z7"/>etiam ipsum et d. <persName ref="p8111">Petrum Martyrem</persName>, <persName ref="p1214">Frisium</persName>, <persName ref="p8011">Gual<lb xml:id="p2z8"/>therum</persName>, <persName ref="p1283">Gesnerum</persName> et amicos reliquos omnes officio<lb xml:id="p2z9"/>se per occasionem et cum citra molestiam licebit.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p2z10"/>Bene vale.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l28">Basileae</placeName> 26. <lb xml:id="p2z11"/>iunii 1557.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z12"/><persName ref="p8126">Ioan[nes] Oporinus</persName> tu<lb xml:id="p2z13"/>us <lb xml:id="p2z14"/>ex animo<lb xml:id="p2z15"/>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z17"/>Nactus etiam sum Aphorismos d. <persName ref="p467">Buceri</persName> paulo ante eius <lb xml:id="p2z18"/>obitum in <placeName ref="l830">Anglia</placeName> scriptos de coena domini a nostra confessio<lb xml:id="p2z19"/>ne <lb xml:id="p2z20"/>non abhorrentes et libros eius de regno Christi, <lb xml:id="p2z22"/>quem item brevi, si dominus volet, excudam, item edicta <lb xml:id="p2z23"/>veterum imperatorum contra christianos a <persName ref="p8053">Balduino</persName> collecta, <lb xml:id="p2z24"/>qui nostris hodie multo clementius sęviisse deprehenduntur.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><lb xml:id="p2z25"/>Dom<lb xml:id="p2z26"/>ino <persName ref="p495">Henrico Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesię pastori vigilantissimo, <lb xml:id="p2z27"/>domino et amico suo <lb xml:id="p2z28"/>plurimum co<lb xml:id="p2z29"/>lendo.</s>
				</p>
			</div>
