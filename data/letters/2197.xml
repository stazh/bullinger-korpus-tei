	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime vir, d. <persName ref="p8332">Baionae</persName> episcopus mittet ad <lb xml:id="p1z2"/>te una cum his meis literis quaedam manu<lb xml:id="p1z3"/>scripta, mea quidem (ut statim prodam <lb xml:id="p1z4"/>autorem), quae cupio diligentissime legas e<lb xml:id="p1z5"/>xaminesque, et spero non ingratam <lb xml:id="p1z6"/>tibi eam lectionem futuram; novi tuum <lb xml:id="p1z8"/>ingenium et iudicium, et quam non si<lb xml:id="p1z9"/>s purus theologus, <lb xml:id="p1z10"/>sed reliqua intelligas, <lb xml:id="p1z11"/>quae ad civimagnarum rerum administrationem <lb xml:id="p1z12"/>pertinent.</s>
					<s n="2" xml:lang="la">Quorsum haec fuerint <lb xml:id="p1z13"/>scripta, facile iudicabis; ubi occasio <lb xml:id="p1z14"/>dietae advenerit, imprimemus Ger<lb xml:id="p1z15"/>manice versa.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Hic primum peto, <lb xml:id="p1z16"/>ut sincere, quid sentias, scribas ac <lb xml:id="p1z17"/>etiam addas in tuis literis "cuperem te <lb xml:id="p1z18"/>addidisse hoc et hoc aut tacuisse <lb xml:id="p1z19"/>hoc et hoc."</s>
					<s n="4" xml:lang="la">Deinde ut, postquam <lb xml:id="p1z20"/>legeris mittas ea cum literis incl<lb xml:id="p1z21"/>usis meis ad d. <persName ref="p8296">Bassafontaneum</persName>, cui ego <lb xml:id="p1z22"/>scribo, ut lecta ad te rursum re<lb xml:id="p1z23"/>mittat.</s>
					<s n="5" xml:lang="la">Ubi acceperis, ne com<lb xml:id="p1z24"/>mitas cuipiam una cum tuis cen<lb xml:id="p1z25"/>suris ad me ferenda, quem non scias <lb xml:id="p1z26"/>esse certissimum; sed retine apud te, <lb xml:id="p1z27"/>dum vel certissimus occurrat nuncius, <lb xml:id="p1z28"/>vel mittam ego proprium.</s>
					<s n="6" xml:lang="la">Non est <lb xml:id="p1z29"/>res tuo labore indigna; propterea <pb/><lb xml:id="p2z1"/>non est, quod me excusem, <lb xml:id="p2z2"/>quasi talia obtrudam, in quibus bonas horas <lb xml:id="p2z3"/>male colloces.</s>
					<s n="7" xml:lang="la">Dux noster, <persName>Augustus</persName> elector, <lb xml:id="p2z4"/>elector Palatinus et lantgr<lb xml:id="p2z5"/>avius <lb xml:id="p2z6"/>et <persName ref="p2411">Otho Henricus</persName> <placeName ref="l2477">Palatinus</placeName> misso certo nuncio enixe <lb xml:id="p2z7"/>petierant ab <persName ref="p8112">rege Gallorum</persName>, ut liceret <persName ref="p974">Carolo <lb xml:id="p2z8"/>Molineo</persName> educere uxorem ex <placeName ref="l832">Gallia</placeName> et <lb xml:id="p2z9"/>bona vendere; at nihil potuerunt im<lb xml:id="p2z10"/>petrare nec bona verba quidem.</s>
					<s n="8" xml:lang="la">Hoc <lb xml:id="p2z11"/>nemo ambigit negatum odio nostrae <lb xml:id="p2z12"/>religionis.</s>
					<s n="9" xml:lang="la">Illuminet illum dominus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p2z13"/>Vale et salve et iuva me tuis et <lb xml:id="p2z14"/>ecclesiae precibus versantem in non par<lb xml:id="p2z15"/>va invidia atque odio, non tam quod pere<lb xml:id="p2z16"/>grinus sum (praesertim <placeName ref="l834">Italus</placeName>) quam <lb xml:id="p2z17"/>quod vobiscum sentio et quod aperte <lb xml:id="p2z18"/>multa reprehendo; sic decet chris<lb xml:id="p2z19"/>tianum et a deo pendere, non ab <lb xml:id="p2z20"/>hominibus.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z21"/><placeName ref="l512">Tubingae</placeName> 23. februarii 1554.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z22"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
