	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Sine corde, optime pater <persName ref="p495">Bullingere</persName>, cogitare et <lb xml:id="p1z2"/>loqui quis potest?</s>
					<s n="3" xml:lang="la">Habeas vero cor meum, <lb xml:id="p1z3"/>et quid rerum mearum poterit te latere?</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Avulsisti tandem a me cor meum <persName ref="p8111">Martyrem</persName>; <lb xml:id="p1z5"/>hunc habes, me habes.</s>
					<s n="5" xml:lang="la">Non est igitur opus, ut <lb xml:id="p1z6"/>aliud quidpiam a me expectes nec, quomodo <lb xml:id="p1z7"/>valeam, interroges, aut quid agam, pręsertim i<lb xml:id="p1z8"/>n pręsentia, ubi nec facultas loquendi <lb xml:id="p1z9"/>conceditur nec voluntas.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Istic sum medius.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Cogitea meam miseriam, qui in tot partes <lb xml:id="p1z11"/>discerpar.</s>
					<s n="8" xml:lang="la">Quid quod et <persName ref="p8111">Petrus Martyr</persName> per <lb xml:id="p1z12"/>vos iam divisus est; <persName ref="p8111">Petrus</persName> enim apud <lb xml:id="p1z13"/>vos, martyrium apud me remansit.</s>
					<s n="9" xml:lang="la" ana="farewell">Ergo <lb xml:id="p1z14"/>valete et plaudite vos; nos vero super <lb xml:id="p1z15"/>flumina <placeName ref="l2131">Babylonis</placeName> sedebimus et fleb<lb xml:id="p1z16"/>imus tantisper, dum a <lb xml:id="p1z17"/>captivitate liberati <lb xml:id="p1z18"/>ad ipsam nostram civitatem <persName>Ziion</persName> re<lb xml:id="p1z19"/>vertamur.</s>
					<s n="10" xml:lang="la">Commendo me tuis precibus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/>Ex <persName>Eremo</persName> <placeName ref="l491">Argentinensi</placeName> 11.<note type="misc">ij=2?</note> iulii sub <lb xml:id="p1z21"/>profundam noctem.</s>
					<s n="12" xml:lang="la" ana="salute">Saluto omnes uno verbo<lb xml:id="p1z22"/>.</s>
					<s n="13" xml:lang="el"><lb xml:id="p1z24"/>[<pb/><lb xml:id="p2z4"/>grie<lb xml:id="p2z5"/>c<lb xml:id="p2z6"/>hisch]<lb xml:id="p2z7"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="14" xml:lang="la"><lb xml:id="p2z8"/>Pręst<lb xml:id="p2z10"/>ant<lb xml:id="p2z11"/>i<lb xml:id="p2z12"/>ssimo <placeName ref="l587">Tigurinę</placeName> e<lb xml:id="p2z13"/>cclesię pastori d. <persName ref="p495">H[<lb xml:id="p2z14"/>enrico] <lb xml:id="p2z15"/>Bullingero</persName>, patri observandissim<lb xml:id="p2z16"/>o.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z17"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
