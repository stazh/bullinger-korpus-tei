	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, doctissime <persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Militum turba tum et equitum<note xml:id="fn1" type="footnote" n="1">Zur Anwerbung von Soldaten im Zusammenhang mit den Spannungen um <placeName ref="l306">Mailand</placeName> vgl. oben <ref target="file10858">Nr. 819</ref>, 1-8, und unten <ref target="file10870">Nr. 831</ref>f. Zum Aufbruch von Truppen aus dem <placeName ref="l6">Allgäu</placeName> unter Hauptmann <persName ref="p7480">Kaspar von Frundsberg</persName> vgl. Nikolaus Ellenbog, Briefwechsel, hg. v. Andreas Bigelmair und Friedrich Zoepfl, Münster in Westfalen 1938. -Corpus Catholicorum 19/21, S. 374, 30-32.</note> <lb xml:id="p1z2"/>hominum piorum scilicet, ita obrutus et districtus, ut vix <lb xml:id="p1z3"/>respirare liceat, tantum abest ut tibi, que velim et cu<lb xml:id="p1z4"/>piam, scribere queam.</s>
					<s n="3" xml:lang="la" ana="salute">Tu itaque hoc meum salvere <lb xml:id="p1z5"/>et silere boni consule, vir integritate et eruditione <lb xml:id="p1z6"/>excellentissime.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Que tua ex officina prodierunt interim, <lb xml:id="p1z7"/>cura ut cum hoc <persName>Petro</persName><note xml:id="fn2" type="footnote" n="2">Ein <persName>Peter</persName> [...] ist bereits im Brief vom 14. Nov. 1535 als Bote genannt (vgl. <bibl source="b7">HBBW V</bibl> <ref target="file10715">[Nr. 677]</ref>, S. 425, 13).</note> nunc cognito tibi accipiam ac <lb xml:id="p1z8"/>aliorum tuorum symmistarum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell">Vale, et Christus in te <lb xml:id="p1z9"/>pergat peragere, quod cepit in suam laudem et <lb xml:id="p1z10"/>gloriam et suę ecclesię profectum et ornamentum.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale c<lb xml:id="p1z11"/>um tuis omnibus et ecclesia tua sancta.</s>
					<s n="7" xml:lang="la">Vicissim per <lb xml:id="p1z12"/>te oramus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Ipsa<note xml:id="fna" type="footnote" n="a"><hi>vor</hi> ipsa <hi>gestrichenes</hi> isp.</note> ascensionis di<lb xml:id="p1z13"/>e anno etc. <lb xml:id="p1z14"/>36.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/><persName ref="p330">Barptolomaeus</persName><note xml:id="fnb" type="footnote" n="b"><hi>nach</hi> <persName ref="p330">Barptolomaeus</persName> <hi>von späterer Hand</hi> <persName ref="p330">Bertlin</persName>.</note>, <lb xml:id="p1z16"/>t<lb xml:id="p1z17"/>uus discipulus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro pietate et <lb xml:id="p2z2"/>doctrina prestantissimo <lb xml:id="p2z3"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z4"/>ecclesię <placeName ref="l587">Tigurinę</placeName> episcopo <lb xml:id="p2z5"/>laudatissimo, suo preceptori <lb xml:id="p2z6"/>cum primis honorando.</s>
				</p>
			</div>
