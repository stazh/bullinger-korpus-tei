	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Venit ad nos <persName ref="p8155">Ioannes Baleus</persName>, olim episcopus <placeName ref="l3023">Ossavensis</placeName> in <placeName ref="l2665">Hybernia</placeName>, Christi exul, ut scribis, scriptis <lb xml:id="p1z2"/>celeberrimus et pietate illustris, una cum <persName>Richardo Turnero</persName> simul cum uxoribus, quos praecipue Christi, <lb xml:id="p1z3"/>deinde tuo nomine non conctanter accepimus atque pro nostra tenuitate tractavimus.</s>
					<s n="3" xml:lang="la">Pernoctarunt <lb xml:id="p1z4"/>apud me.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Accessit ad me <persName ref="p8369">Hammanus</persName> noster, qui suo quoque munere non defuit tam honesto <lb xml:id="p1z5"/>sodalitio.</s>
					<s n="5" xml:lang="la" ana="salute">Is te salutat ex animo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ego uxorem meam <placeName ref="l587">Tigurum</placeName> misi, ut pro futuro puerperio <lb xml:id="p1z6"/>inserviat uxori <persName>Anthonii Sprünglii</persName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Illa tibi corporis mei infirmitatem indicabit procul dubio <lb xml:id="p1z7"/>atque meam absentiam excusabit.</s>
					<s n="8" xml:lang="la">Uterque alterius faciem ęquo desiderio videre cupit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Dominus <lb xml:id="p1z8"/>faxit, ut pro voto nobis, quod cupimus, succedat olim; ego nondum despondi animum.</s>
					<s n="10" xml:lang="la">Obsecro <lb xml:id="p1z9"/>re... as hoc desiderium.</s>
					<s n="11" xml:lang="la">saltem partim, quoad nunc fieri potest, et mitte praesente nunctio <placeName>Mauritio</placeName> <lb xml:id="p1z10"/>si quid habes memorialium in Jheremiam; nihil enim penitus apud me residui est.</s>
					<s n="12" xml:lang="la">Septembris 7.<lb xml:id="p1z11"/>.. cęperat describere pęnam ipsam debitam peccatis etc.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Hanc conti... habeo et <lb xml:id="p1z12"/>praeterea nihil.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Noli differre, obsecro; praesente nunctio mitte.</s>
					<s n="15" xml:lang="la">Praeterea audio cogitationes tuas in <lb xml:id="p1z13"/>re ationem Christi typis excusas.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Quod si verum est, significa; curabo, ut ipse habeam.</s>
					<s n="17" xml:lang="la" ana="farewell">Porro scribe, si quid <lb xml:id="p1z14"/>attinet me scire, et vale, amice incomparabilis.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">Salutat iterum te <persName ref="p8369">Hammanus</persName> noster.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute">Salutabis nomine meo <lb xml:id="p1z15"/>tuam cum tota familia.</s>
				</p>
				<p>
					<s n="20" xml:lang="de">Date <placeName ref="l285">Lentzburg</placeName> 14. decembris anno 1557.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p8440">Gervasius <span type="pronoun">tuus</span> Schuler</persName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heynricho Bullingero</persName>, veteri <lb xml:id="p2z2"/>meo et optimo amico et <lb xml:id="p2z3"/>fratri in Christo observandissimo.</s>
				</p>
			</div>
		</body>
	</text>
