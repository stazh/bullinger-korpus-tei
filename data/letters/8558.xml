			<graphic xml:id="img4-0" url="https://media.sources-online.org/cantaloupe/iiif/3/bullinger!8558!Autograph!03%20E_II_362__fol__112_a_r_.tif/full/max/0/default.jpg" height="4076px" width="2781px" n="4">
