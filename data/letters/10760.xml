			<zone xml:id="p4z4-0" points="2404,1632 2504,1657 2696,1587 2939,1594 3171,1673 3270,1622 3365,1655 3681,1614 3681,1571 3478,1582 3241,1503 2996,1584 2668,1517 2404,1557">2413,1601 2476,1594 2540,1592 2603,1590 2667,1588 2730,1586 2794,1588 2857,1589 2921,1593 2984,1595 3048,1596 3111,1599 3175,1595 3238,1596 3302,1598 3365,1602 3429,1602 3492,1604 3556,1604 3619,1604 3683,1604</zone>
			<zone xml:id="p4z5-0" points="2445,1706 2666,1805 2783,1709 2987,1687 3197,1706 3295,1786 3468,1773 3519,1741 3516,1670 3363,1675 3290,1622 3184,1675 2950,1614 2871,1654 2701,1598 2442,1648">2452,1666 2505,1667 2558,1669 2612,1671 2665,1674 2719,1675 2772,1678 2826,1682 2879,1684 2933,1686 2986,1687 3039,1690 3093,1693 3146,1694 3200,1698 3253,1702 3307,1705 3360,1706 3414,1708 3467,1708 3521,1711</zone>
