	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Mitto ad te responsionem qualemcumque meam ad quaestionem illam, <lb xml:id="p1z3"/>quam nosti; eam rogo ut remittas; nam ut describerem <lb xml:id="p1z4"/>omnino non vacavit.</s>
					<s n="3" xml:lang="la">Nudiusquintus habere me putabam, qui <lb xml:id="p1z5"/>istuc hinc abiret; sed ille mutato consilio alio deflexit.</s>
					<s n="4" xml:lang="la">De <lb xml:id="p1z6"/>Cęsare, quę hodie ab amico quodam insigni accepi, ad te mitto.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Fuit mecum egregius quidam pictor <placeName ref="l18">Augustensis</placeName>, qui C[aesarem] subinde <lb xml:id="p1z8"/>libere accedit, quod opera et artificio ipsius multum se oblectare <lb xml:id="p1z9"/>soleat <persName>Carolus</persName>.</s>
					<s n="6" xml:lang="la">Is constantissime ac multis asseverat fieri nulla <lb xml:id="p1z10"/>ratione posse, ut ultra mensem unum atque alterum spiritum ducat; <lb xml:id="p1z11"/>quo verisimilius iam mihi fit, quod hic amicus ad me <lb xml:id="p1z12"/>scribit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Philippum longiores constituto moras nectere <placeName ref="l18">Augustę</placeName>, <lb xml:id="p1z13"/>quod pater animam iam agere putetur.</s>
					<s n="8" xml:lang="la">Dominus illum a <persName>Romano</persName> <lb xml:id="p1z14"/>ad cęleste regnum clementer transferat, id quod cum omnium bonorum <lb xml:id="p1z15"/>bona gratia fecerit!</s>
					<s n="9" xml:lang="de">Verlich im gott ain guͦte, fröliche himel<lb xml:id="p1z16"/>fart!</s>
					<s n="10" xml:lang="de">Ich wellt danecht nitt, das in der teuffel hinfuͤrte.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z17"/>Tu ora pro nobis diligenter.</s>
					<s n="12" xml:lang="la">Adest hic adolescens praeter <lb xml:id="p1z18"/>meam expectationem, qui multum festinat.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z19"/>Literas, quas misisti, per pictorem illum ad <persName ref="p3927">Welserum</persName> nostrum dedi.</s>
					<s n="14" xml:lang="la" ana="farewell"><lb xml:id="p1z20"/>Bene vale iterum atque iterum.</s>
					<s n="15" xml:lang="la">11. maii 1551.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">T[<lb xml:id="p1z21"/>uus] <persName ref="p8055">Ambr[osius] Bl[<lb xml:id="p1z22"/>aurerus]</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="de"><pb/><lb xml:id="p2z1"/>An herrn <persName ref="p495">Bullinger</persName> <lb xml:id="p2z2"/>zuͦ <placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
