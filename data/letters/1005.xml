	</facsimile>
	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Singulari humanitate tua fretus, clarissime domine <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z2"/>parvas has ad te literas dare volui ac breviter, quid <lb xml:id="p1z3"/>velim, exponam.</s>
					<s n="2" xml:lang="la">Nuper cum essem cum meis apud vos <lb xml:id="p1z4"/><placeName ref="l587">Tyguri</placeName>, gratius mihi in eo loco accidere haud quidquam pot<lb xml:id="p1z5"/>uit, quam quod qualiscunque mihi notitia intercessit <lb xml:id="p1z6"/>cum summis ac excellentibus viris eius loci, tecum scilicet, <lb xml:id="p1z7"/>cum domino <persName ref="p8127">Pellicano</persName> et domino <persName ref="p8171">Biblyandro</persName>.</s>
					<s n="3" xml:lang="la">Erat <lb xml:id="p1z8"/>in animo aliquod testimonium a vobis petendi, quod tamen <lb xml:id="p1z9"/>propter nimiam itineris festinationem tum neglexi.</s>
					<s n="4" xml:lang="la">Quare <lb xml:id="p1z10"/>hoc tempore summopere te oro, ut parvum aliquod chyro<lb xml:id="p1z11"/>graphum meo nomine petas a domino <persName ref="p8127">Pellicano</persName> et domino <lb xml:id="p1z12"/><persName ref="p8171">Biblyandro</persName> ac tuum simul etiam adiungas.</s>
					<s n="5" xml:lang="la">Quodsi <lb xml:id="p1z13"/>molestum fuerit dare literas, contentus ero, si miserint <lb xml:id="p1z14"/>manu propria descriptum locum quendam scripturę <lb xml:id="p1z15"/>cum explicatione succincta.</s>
					<s n="6" xml:lang="la">Gratius mihi a vobis <lb xml:id="p1z16"/>fieri nihil unquam poterit, et perpetua memoria, quoad <lb xml:id="p1z17"/>deus vitam concesserit, tenebo.</s>
					<s n="7" xml:lang="la">De nomine meo te <lb xml:id="p1z18"/>non dubitaturum existimo, quod, cum essemus apud <lb xml:id="p1z19"/>vos, diligenter in diversorio meo annotasti.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z20"/>Has literas, optime vir, boni consulito.</s>
					<s n="9" xml:lang="la">Si videro <lb xml:id="p1z21"/>eas tibi fuisse acceptas, prolixiores et crebriores dabo.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z22"/>Responsum obnixe peto mittas ad dominum <persName ref="p2270">Munsterum</persName>, <lb xml:id="p1z23"/>qui facilius et citius etiam, ut arbitror, ex <placeName ref="l28">Basilea</placeName> <lb xml:id="p1z24"/>curare poterit quam ex vestro loco.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Bene vale et <lb xml:id="p1z25"/>saluta praestantes illos viros, d. <persName ref="p8127">Pellicanum</persName> et d. <lb xml:id="p1z26"/><persName ref="p8171">Biblyandrum</persName>, reverenter meo nomine.</s>
					<s n="12" xml:lang="la"><placeName ref="l558">Vitębergae</placeName> die <lb xml:id="p1z27"/>27. augusti 1550.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z28"/>T[uus] <persName ref="p1851">Erhardus a Künheim</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo et integerrimo viro <lb xml:id="p2z2"/>d. <persName ref="p495">Henrico Bullingero</persName>, <placeName ref="l587">Tygurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori, domino <lb xml:id="p2z4"/>et amico suo charissimo, <lb xml:id="p2z5"/>ad manus proprias<lb xml:id="p2z6"/>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>