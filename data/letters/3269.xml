	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Etsi ante paucos dies scripserim ad te, nolui tamen, <lb xml:id="p1z2"/>ut <persName ref="p1227">Froschouerus</persName> literarum vacuus ad te rediret.</s>
					<s n="3" xml:lang="la">Vocatus <lb xml:id="p1z3"/>erat affinis ille tuus ad marchionis consiliarios; sed scriptis <lb xml:id="p1z4"/>literis ipse non venit ob adversam valetudinem ad diem <lb xml:id="p1z5"/>praescriptum.</s>
					<s n="4" xml:lang="la">An vero interea temporis eos accesserit, rescire <lb xml:id="p1z6"/>nondum potui; spero autem hanc moram absque periculo <lb xml:id="p1z7"/>esse, modo dominus bonum virum maturius restituat.</s>
					<s n="5" xml:lang="la">De rebus <lb xml:id="p1z8"/>novis quod scribam, habeo nihil nisi de apparatu bellico <lb xml:id="p1z9"/><persName ref="p18575">Philippi</persName>, quem scribunt esse peditum vexilla centum, equitum <lb xml:id="p1z10"/>numero quindecim milium.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><persName ref="p8112">Gallum</persName> vero viribus longe inferiorem <lb xml:id="p1z11"/>una cum suis magno metu perculsum.</s>
					<s n="7" xml:lang="la">Quo casura sit hec <lb xml:id="p1z12"/>Martis alea dominus novit, qui moderetur negocium ad <lb xml:id="p1z13"/>suam gloriam et foelicem successum regni sui.</s>
					<s n="8" xml:lang="la">Amen.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z14"/>Quod mihi exemplar Apocalypseos dare iusseris, habeo gratias <lb xml:id="p1z15"/>ultro nihilominus vel tibi vel <persName ref="p8126">Oporino</persName> meo persoluturus.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/>Nunc ut in domino recte valeas cum tuis, ex animo precor.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z17"/>Bene vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l28">Basileę</placeName> 12. augusti etc. 57.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z18"/>Tuus totus <persName ref="p1754">Ioannes Iungius</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Spectatę eruditionis <lb xml:id="p2z2"/>ac pietatis viro domino <lb xml:id="p2z3"/><persName ref="p495">Henrico Bullingero</persName>, domino s<lb xml:id="p2z4"/>uo ac fratri venerando.</s>
				</p>
			</div>
		</body>
	</text>
