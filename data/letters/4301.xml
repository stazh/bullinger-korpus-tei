	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Colendissime domine <persName ref="p495">Bullingere</persName>, quod nunc scribam, nil habeo praeter quod relatum est <lb xml:id="p1z2"/>regis <persName>Philippi</persName> classem a <placeName ref="l2510">Turca</placeName> prope <placeName ref="l1374">Tripolim</placeName> superatam esse et <lb xml:id="p1z3"/>proinde triremes vel onerarias naves circiter 60 amisisse.</s>
					<s n="2" xml:lang="la">Et <lb xml:id="p1z4"/>sane dolendum, quod rex christianus tantam iacturam accepit ab hoste <lb xml:id="p1z5"/>nominis christiani maximo.</s>
					<s n="3" xml:lang="la">Caeterum hic sumus satis quieti, nisi <lb xml:id="p1z6"/>quod perpetuo adhuc acri penuria molestamur; speramus tamen <lb xml:id="p1z7"/>eam aliquando remissum iri, idque faciat deus.</s>
					<s n="4" xml:lang="la">- Ego cum <lb xml:id="p1z8"/>meis omnibus bene valeo dei beneficio; id ipsum vero enixe <lb xml:id="p1z9"/>abs te tuisque audire cupio, quos optimus deus iugiter servet <lb xml:id="p1z10"/>incolumes.</s>
					<s n="5" xml:lang="la">Opinor me nundinas <placeName ref="l98">Churienses</placeName> nunc instantes <lb xml:id="p1z11"/>accessurum tuncque latius <placeName ref="l98">Churia</placeName> sum tibi scripturus et <lb xml:id="p1z12"/>maxime, si quid novi ingruerit.</s>
					<s n="6" xml:lang="la" ana="salute">Filius meus iubet te <lb xml:id="p1z13"/>cum omnibus domesticis admodum valere vosque omnes salutat.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z14"/>Vale multum.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Datum raptim <placeName ref="l93">Clavennae</placeName> 2. iunii 1560.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>Tibi omnium deditissimus <lb xml:id="p1z16"/><persName ref="p8432">Federicus a Salice</persName>, commissarius <placeName ref="l93">Clavennę</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo et clarissimo viro domino <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, domino meo iu<lb xml:id="p2z3"/>giter colendissimo.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName> Helvetiorum.</s>
				</p>
			</div>
		</body>
	</text>
