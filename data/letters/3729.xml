	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Dedi nudius tertius cuidam caminorum purgator
					<lb xml:id="p1z2"/>ad te literas spero redditurum. Has scribo, ut
					<lb xml:id="p1z3"/>D. Mebellum medicinae doctorem tuae charitat
					<lb xml:id="p1z4"/>commendem, ut commendo certe ex animo,
					<lb xml:id="p1z5"/>est pius et bene in suis studiis versatus, sum
					<lb xml:id="p1z6"/>deinde probitate et fide. Quare non e
					<lb xml:id="p1z7"/>indignum beneficium contuleris, si in hunc
					<lb xml:id="p1z8"/>contuleris. Erat unum cum eo verturus quis
					<lb xml:id="p1z9"/>piam ex coniratis cortru me nescio a
					<lb xml:id="p1z10"/>e verum venit, nomen non exporime
					<lb xml:id="p1z11"/>Sedsi venerit, agnosces. non est, quid consen
					<lb xml:id="p1z12"/>mendem hominem; esset enim veluti syppoca
					<lb xml:id="p1z13"/>cresis, sed volui tibi indicir, misi non
					<lb xml:id="p1z14"/>esse incognitos meos inimicos et diffana
					<lb xml:id="p1z15"/>quis cum apud nos digant, facile
					<lb xml:id="p1z16"/>possem ultessa , si non essem christiunus.
					<lb xml:id="p1z17"/>Vale. Exus conceptum de me opinionem,
					<lb xml:id="p1z18"/>atque ut alii exuent antersis te rogo. in
					<lb xml:id="p1z19"/>primis erat pro me
					<lb xml:id="p1z20"/>Tubiegae Goct 1558.
					<lb xml:id="p1z21"/>Tsergerius.
					<pb/>
					<lb xml:id="p2z1"/>Clarissimo viro domino
					<lb xml:id="p2z2"/>Henrico Bulingero,
					<lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae
					<lb xml:id="p2z4"/>ctori, fratri honor.
					<lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.
				</p>
			</div>
		</body>
	</text>
