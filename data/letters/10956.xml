	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus et pax Christi.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>O quam cupio audire ex te, observandissime <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z3"/>quid actum et conclusum <placeName ref="l28">Basileae</placeName><note xml:id="fn1" type="footnote" n="1">Zur <placeName ref="l28">Basler</placeName> Tagung vom 12.-14. November s. oben <ref target="file10953">Nr. 911</ref>, Anm. 1.</note>!</s>
					<s n="3" xml:lang="la">Utinam <lb xml:id="p1z4"/>omnia ex verbo domini successerint!</s>
					<s n="4" xml:lang="la">Audio <lb xml:id="p1z5"/><placeName ref="l28">Basilienses</placeName> fratres nostrum adventum desyderasse, absentiam <lb xml:id="p1z6"/>vero iniquius tulisse<note xml:id="fn2" type="footnote" n="2"><placeName ref="l257">Konstanz</placeName> war mit der Begründung ferngeblieben, man wolle <persName ref="p1974">Luther</persName> selbst antworten; s. oben <ref target="file10953">Nr. 911</ref>.</note>.</s>
					<s n="5" xml:lang="la">Sed quid est, quod per nos <lb xml:id="p1z7"/>potuisset fieri?</s>
					<s n="6" xml:lang="la">Deinde audio <persName ref="p467">Bucerum</persName> non per <lb xml:id="p1z8"/>omnia bene habuisse<note xml:id="fn3" type="footnote" n="3">Vgl. Blarer BW II 828, Nr. 71.</note>; restitutum tamen spero.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z9"/>Caeterum pro tua bonitate et benevolentia, imo <lb xml:id="p1z10"/>ecclesiae nostrae commodo certiores nos facies de <lb xml:id="p1z11"/>omnibus scitu dignis<note xml:id="fn4" type="footnote" n="4"><persName ref="p495">Bullingers</persName> Antwort ist nicht erhalten.</note>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Responsionem vestram<note xml:id="fn5" type="footnote" n="5">Siehe oben <ref target="file10951">Nr. 909</ref>, Anm. 1.</note> <lb xml:id="p1z12"/>legimus, et placuit.</s>
					<s n="9" xml:lang="la">Sed miramur, quam convenerit <lb xml:id="p1z13"/>inter vos, quid additum, quid erasum.</s>
					<s n="10" xml:lang="la">Eam ad <lb xml:id="p1z14"/>te remitto cum gratiarum actione.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><persName ref="p4082">Cuͦnradus</persName> frater<note xml:id="fn6" type="footnote" n="6"><persName ref="p4082">Konrad Zwick</persName>.</note> et <lb xml:id="p1z15"/><persName ref="p8178">Thomas</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p8178">Thomas Blarer</persName>.</note>, deinde fratres symmystae optant te bene habere.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z16"/>Vale cum tota domo tua.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">18. novembris 1536.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z17"/>Tuus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z18"/>Si quae habes, quae non sint tradenda literis et quae <lb xml:id="p1z19"/>nos hic scire referat, paratus sum coram ex te <lb xml:id="p1z20"/>intelligere.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell">[It]erum<note xml:id="fna" type="footnote" n="a"><hi>Text beschädigt.</hi></note> vale, et ne cesses amare <lb xml:id="p1z21"/>ecclesiam nostram.</s>
					<s n="17" xml:lang="la">Insimulamur<note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> insimulamur <hi>ein gestrichenes, unleserliches Wort.</hi></note> a quibusdam, <lb xml:id="p1z22"/>quasi studio simus nasuti.</s>
					<s n="18" xml:lang="la">Sed dominus novit nostras me<lb xml:id="p1z23"/>ntes.</s>
					<s n="19" xml:lang="la">Utri rectius sapiant, probabit dominus.</s>
					<s n="20" xml:lang="la">Nos <lb xml:id="p1z24"/>libenter offeremus libamenta pro ignorantia nostra.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z25"/>Scientes vero non peccamus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro M. <lb xml:id="p2z2"/><persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae vigi<lb xml:id="p2z4"/>lantissimo antistiti, <lb xml:id="p2z5"/>dilectissimo et observando <lb xml:id="p2z6"/>suo fratri.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>