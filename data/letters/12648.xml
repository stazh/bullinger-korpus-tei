	<text xml:lang="de">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Gnad und frid.</s>
					<s n="2" xml:lang="de">Gott woͤllte, ich koͤnde üch vil guͦts <lb xml:id="p1z2"/>schriben.</s>
					<s n="3" xml:lang="de">Es stat aber, alls es mag...</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="4" xml:lang="de"><placeName ref="l337">Nüwen<lb xml:id="p1z3"/>burg an der Tonow</placeName><note xml:id="fn1" type="footnote" n="1">Zur Einnahme <placeName ref="l337">Neuburgs ad. Donau</placeName> s. <ref target="file12643">Nr. 2596</ref>,27-40; <ref target="file12646">Nr. 2599</ref>,11-13.</note>, hertzog <persName ref="p2411">Ott Heinrychen</persName> <lb xml:id="p1z4"/>zuͦghoͤrig, ist gewunnen und verraͤterlich <lb xml:id="p1z5"/>yngnommen von den keyserischen.</s>
					<s n="5" xml:lang="de">Ettlich <lb xml:id="p1z6"/>burger sind erstochen, vil frowen und <lb xml:id="p1z7"/>junckfrowen schantlich geschwecht<note xml:id="fn2" type="footnote" ana="lex" n="2">vergewaltigt.</note>, lasterlich <lb xml:id="p1z8"/>mißhandlet, etc.</s>
					<s n="6" xml:lang="de">Ich besorg (so<note xml:id="fn3" type="footnote" ana="lex" n="3">da.</note> die unsern grad<note xml:id="fn4" type="footnote" n="4">(damals) gerade.</note> zuͦ <lb xml:id="p1z9"/><placeName ref="l119">Tonawerd</placeName><note xml:id="fn5" type="footnote" n="5"><placeName ref="l119">Donauwörth</placeName>.</note> gelaͤgen, und <lb xml:id="p1z11"/>noch<note xml:id="fn6" type="footnote" n="6">nahe (von <placeName ref="l337">Neuburg</placeName>).</note>, und soͤlich jomer nitt gerochen<note xml:id="fn7" type="footnote" ana="lex" n="7">gerächt haben.</note>)<note xml:id="fna" type="footnote" n="a"><hi>Klammern ergänzt.</hi></note>, <lb xml:id="p1z12"/>werd nahin<note xml:id="fn8" type="footnote" ana="lex" n="8">hernach.</note> der Benjamitern krieg <lb xml:id="p1z13"/>daruß<note xml:id="fn9" type="footnote" n="9">Anspielung auf die in <cit type="bible"><ref>Ri 19f</ref></cit> geschilderte Geschichte. - Die hier gemachten Äußerungen beruhen wohl auf <ref target="file12643">Nr. 2596</ref>,33-39 und 68f.</note>.</s>
					<s n="7" xml:lang="de">Die unsern ligend da in hun<lb xml:id="p1z14"/>dert tusend starck, beschicht<note xml:id="fn10" type="footnote" ana="lex" n="10">geschieht.</note> aber <lb xml:id="p1z15"/>nut dappffers!</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="8" xml:lang="de">Beid fürsten<note xml:id="fn11" type="footnote" n="11"><persName ref="p19065">Johann Friedrich I. von Sachsen</persName> und <persName ref="p3590">Philipp von Hessen</persName>.</note> und <lb xml:id="p1z16"/>das rych begärt<note xml:id="fn12" type="footnote" n="12">Siehe dazu <ref target="file12646">Nr. 2599</ref>, Anm. 20.</note> jetzund an die von <lb xml:id="p1z17"/><placeName ref="l587">Zürych</placeName>, <placeName ref="l41">Bern</placeName>, <placeName ref="l28">Basel</placeName>, <placeName ref="l441">Schaffhusen</placeName>, etc., <lb xml:id="p1z18"/>das sy demnaͤchsten uff den keyser<note xml:id="fn13" type="footnote" n="13"><persName ref="p18538">Karl V.</persName></note> <lb xml:id="p1z19"/>angryffind und imm sin land ynnaͤmind.</s>
					<s n="9" xml:lang="de"><lb xml:id="p1z20"/>Sind min herren<note xml:id="fn14" type="footnote" n="14">Der <placeName ref="l587">Zürcher</placeName> Rat.</note> nitt willig, dann alles <lb xml:id="p1z21"/>hieumb ist <placeName ref="l850">Oesterrychisch</placeName>.</s>
					<s n="10" xml:lang="de"><placeName ref="l631">Burgund</placeName> ist <lb xml:id="p1z22"/>keyserisch.</s>
					<s n="11" xml:lang="de">Dahin muͤstend wir ziehen.</s>
					<s n="12" xml:lang="de"><lb xml:id="p1z23"/>Gloub nitt, das es beschaͤch, <foreign xml:lang="la">nec mihi <lb xml:id="p1z24"/>consultum videtur</foreign>.</s>
					<s n="13" xml:lang="la">Haec tibi in sinum.</s>
					<s n="14" xml:lang="la">Plura <lb xml:id="p1z25"/>mihi valde displicent, sed forte <lb xml:id="p1z26"/>non intelligo mysteria...</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="15" xml:lang="la">Oremus dominum, mi <lb xml:id="p1z27"/>frater!</s>
					<s n="16" xml:lang="la" ana="farewell">Vale.</s>
					<s n="17" xml:lang="la">Ultima <lb xml:id="p1z28"/>se<lb xml:id="p1z29"/>ptembris <lb xml:id="p1z30"/>1546.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z31"/><persName ref="p495">Bullinger</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo <lb xml:id="p2z2"/>viro d. <persName ref="p8418">Osvaldo <lb xml:id="p2z3"/>Myconio</persName>, domino <lb xml:id="p2z4"/>et fratri semper colendo <lb xml:id="p2z5"/>suo.</s>
					<s n="20" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
