	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Reverende vir et carissime frater, <lb xml:id="p1z2"/>sepissime recito dulcissimum versum, <lb xml:id="p1z3"/>in quo numeri sunt Graeci poetae, <lb xml:id="p1z4"/>sententia divinitus tradita est <lb xml:id="p1z5"/>[...].</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Cum igitur et recte invoces deum et ecclesiae <lb xml:id="p1z7"/>pie servias, tua familia etiam deo curae <lb xml:id="p1z8"/>erit.</s>
					<s n="4" xml:lang="la">Filius <persName ref="p487">Henricus</persName> dei beneficio recte <lb xml:id="p1z9"/>valet et in optimis doctrinarum studiis <lb xml:id="p1z10"/>foeliciter procedit; quem ut servet deus <lb xml:id="p1z11"/>incolumem et faciet eum [...], <lb xml:id="p1z12"/>toto pectore opto.</s>
					<s n="5" xml:lang="la">Cogitat de gradu, <lb xml:id="p1z13"/>sed nihil nisi te iubente agere eum in <lb xml:id="p1z14"/>ea re volui [.<lb xml:id="p1z15"/>.<lb xml:id="p1z16"/>.<lb xml:id="p1z17"/>].</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z18"/>Libenter ad te multa scriberem nec <lb xml:id="p1z19"/>impedior occupationibus, etsi non leviter <lb xml:id="p1z20"/>oneratus sum; sed et rerum/renis et doloris mei <lb xml:id="p1z21"/>magnitudo tanta est, ut instituere alia argu<pb/><lb xml:id="p2z1"/>menta non possim.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Sed <lb xml:id="p2z2"/>fortassis brevi colloquemur; <lb xml:id="p2z3"/>nam et ego exilia usitata ecclesiae <lb xml:id="p2z4"/>expecto.</s>
					<s n="8" xml:lang="la" ana="salute">Salutem opto vobis omnibus <lb xml:id="p2z5"/>ac nominatim <persName ref="p8111">Petro Martyri</persName> <lb xml:id="p2z6"/>et <persName ref="p8101">Lelio</persName>.</s>
					<s n="9" xml:lang="la">Bene et feliciter<lb xml:id="p2z7"/>.</s>
				</p>
				<p>
					<s n="10" xml:lang="de">Die 16. septembris.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z8"/><persName ref="p2095">Philippus</persName>.</s>
				</p>
