	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><persName>Paulus hic Altorfer</persName><note xml:id="fn1" type="footnote" n="1">Auch erw. von Haller, 27. Juli 1561.</note>, qui a Iudais<lb xml:id="p1z2"/>mo [<lb xml:id="p1z3"/>..<lb xml:id="p1z4"/>.] <lb xml:id="p1z6"/>M<lb xml:id="p1z7"/>it<lb xml:id="p1z8"/>to <lb xml:id="p1z10"/>per hu<lb xml:id="p1z11"/>nc de reb<lb xml:id="p1z12"/>us <placeName ref="l2510">Turc<lb xml:id="p1z13"/>icis</placeName> ea <lb xml:id="p1z14"/>mihi communicata.</s>
					<s n="3" xml:lang="la">Et quia careo <lb xml:id="p1z15"/>exemplari neque, quum modo acceperim ex Marchionatu, describere <lb xml:id="p1z16"/>licuerit, rogo remittas et simul per literas significes, ut a vobis <persName ref="p8110">Velsius</persName> <lb xml:id="p1z17"/>exceptus sit atque dimissus.</s>
					<s n="4" xml:lang="la">Quaestus est hic de petulantia quorundam <lb xml:id="p1z18"/>in diversonio apud vos, quod suos et alios ad ebrietatem provocassent, <lb xml:id="p1z19"/>reprehensos ab ipso fuisse fructus esse hos doctrinae de imputativa <lb xml:id="p1z20"/>iusticia.</s>
					<s n="5" xml:lang="la">Nobis admodum insultavit et contra <persName>Barrhaum</persName>[!] <lb xml:id="p1z21"/>clam affixit themata ad collegiorum fores.</s>
					<s n="6" xml:lang="la">Nunc <placeName ref="l491">Argentinam</placeName> <lb xml:id="p1z22"/>reversus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Scripsi <placeName ref="l28">Basileae</placeName>, 16. iulii anno 61.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z24"/>Tuus <persName ref="p3099">Simon Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute"><lb xml:id="p1z25"/>Salv<pb/><lb xml:id="p2z1"/>os iube meis <lb xml:id="p2z2"/>verbis s<lb xml:id="p2z3"/>ymistas totamqu<lb xml:id="p2z4"/>e familiam tuam.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
				</p>
			</div>
		</body>
