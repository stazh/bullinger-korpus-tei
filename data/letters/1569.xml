	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Amantissimas tuas literas, compater in <lb xml:id="p1z2"/>domino charissime, hac hora accepi.</s>
					<s n="3" xml:lang="la">Habeo bene<lb xml:id="p1z3"/>volentiae tuae erga me pariter et prudentię, <lb xml:id="p1z4"/>quas possum gratias, qua rerum mearum <lb xml:id="p1z5"/>curam non minorum quam tuarum geris.</s>
					<s n="4" xml:lang="la">Quae ad <lb xml:id="p1z6"/>te scripta misi, nisi illa a me efflagitasses, <lb xml:id="p1z7"/>scripturus non eram propter incredibilem <lb xml:id="p1z8"/>temporuim istorum maliciam.</s>
					<s n="5" xml:lang="la">Verum nolebam <lb xml:id="p1z9"/>votis tuis deesse.</s>
					<s n="6" xml:lang="la">Videbam iuxta periculum <lb xml:id="p1z10"/>futurum, si sub meo nomine sic, ut a me <lb xml:id="p1z11"/>scripta sunt, aederentur; iam, quoniam prudenter <lb xml:id="p1z12"/>agendum iudicas, ne quam mihi <lb xml:id="p1z13"/>Camarinam excitem homo peregrinus, unde <lb xml:id="p1z14"/>haud facile extricari possem, obsecro per <lb xml:id="p1z15"/>mutuam nostram fidem et amicitiam, ut <lb xml:id="p1z16"/>utrunque scriptum ad me prima quavis, <lb xml:id="p1z17"/>certa tamen occasione remittas, ne per <lb xml:id="p1z18"/>imprudentiam citra utriusque, tuam et meam, <lb xml:id="p1z19"/>conscientiam spargatur, et mox hisce meis <lb xml:id="p1z20"/>literis lectis nomen meum, quod in fronte <lb xml:id="p1z21"/>praemissum est, expungas.</s>
					<s n="7" xml:lang="la">Meo iudicio sic <lb xml:id="p1z22"/>surdum est hoc saeculum, ut nullis amplius <lb xml:id="p1z23"/>queat admonitionibus in viam reduci, et usque <lb xml:id="p1z24"/>adeo insanum, ut levi de causa coelum [c<lb xml:id="p1z25"/>um] terra misceat.</s>
					<s n="8" xml:lang="la">Qua re satius est quiescere <lb xml:id="p1z26"/>et cursum iudiciorum dei in silentio et spe <lb xml:id="p1z27"/>tantisper spectare, dum reddita serenitate <lb xml:id="p1z28"/>cantent cygni, taceant corvi.</s>
					<s n="9" xml:lang="la">Grandes <lb xml:id="p1z29"/>et horribiles tempestates imminent unidque; <lb xml:id="p1z30"/>oranda est clementia domini, ne suos ad <lb xml:id="p1z31"/>exitium usque cum impiis involvat.</s>
					<s n="10" xml:lang="la" ana="farewell">Optime vale <lb xml:id="p1z32"/>et scripta mea remitte, obsecro.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Saluta omnem <lb xml:id="p1z33"/>domum tuam meo meorumque nomine.</s>
					<s n="12" xml:lang="la"><persName ref="p20374">Margarita</persName> <lb xml:id="p1z34"/>mea multis est margaritarum centuriis gravior <lb xml:id="p1z35"/>et tamen ne obulo quidem vendibilior, mo<lb xml:id="p1z36"/>lestissima gestat uterum.</s>
					<s n="13" xml:lang="la" ana="salute">Saluta etiam d. <persName ref="p8171">Theodorum <lb xml:id="p1z37"/>Bibliandrum</persName>, d. <persName ref="p8127">Pellicanum</persName>, d. <persName ref="p8011">Gvaltherum</persName>, d. <persName ref="p506">Butlerum</persName> <lb xml:id="p1z38"/>ac reliquos fratres et amicos una cum Trabero <lb xml:id="p1z39"/>nostro.</s>
					<s n="14" xml:lang="la">Dominus vos in gratia sua conservet in <lb xml:id="p1z40"/>sempiternum.</s>
					<s n="15" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1552. 16. februarii.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z41"/><persName ref="p8417">Wolfg[angus] Musculus</persName>, compater <lb xml:id="p1z42"/>tuus in domino.</s>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo m. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> ecclesię <lb xml:id="p2z5"/>pastori vigilan<lb xml:id="p2z6"/>tissimo, compatri <lb xml:id="p2z7"/>ac fratri in <lb xml:id="p2z8"/>domino charissimo.</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z9"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
