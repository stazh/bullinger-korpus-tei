	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil nunc quidem, quod scribam, <lb xml:id="p1z2"/>habeo, dilecte frater, nisi quod his inclusas d. <lb xml:id="p1z3"/><persName>Rampii</persName> nostri literas acceptas ab eo procurandas <lb xml:id="p1z4"/>tibi mitto.</s>
					<s n="3" xml:lang="la">Nihil memoratu dignum ab amicis <lb xml:id="p1z5"/>aliquot iam diebus accepi; si quid posthac acce<lb xml:id="p1z6"/>pero, libenter communicabo.</s>
					<s n="4" xml:lang="la">Hoc saltem commemoro regem <lb xml:id="p1z7"/>voluisse ad splendorem nuptiarum sibi Helvetiorum <lb xml:id="p1z8"/>guardiam, quam vocant, comparare.</s>
					<s n="5" xml:lang="la">Dissuaserunt <lb xml:id="p1z10"/>autem hoc principes consiliarii, ne forte cum admirallio <lb xml:id="p1z11"/>principes interpretarentur id fieri ad violandam <lb xml:id="p1z12"/>pacem.</s>
					<s n="6" xml:lang="la">Quod cum rex expendit, nullos penitus <lb xml:id="p1z13"/>ad nuptias vocare decrevit.</s>
					<s n="7" xml:lang="la">22. octobris imperatoris filia <lb xml:id="p1z14"/>desponsata est paranympho <persName>Ferdinando</persName>, archiduce <placeName ref="l850">Austriae</placeName>, <lb xml:id="p1z15"/>Gallorum regi <placeName ref="l471">Spyrae</placeName>; deinde ducta est in <placeName ref="l832">Galliam</placeName> <lb xml:id="p1z16"/>comitantibus electore <placeName ref="l1028">Trevirense</placeName>, episcopo <placeName ref="l491">Argentinense</placeName>, <lb xml:id="p1z17"/>marchione <placeName ref="l572">Badense</placeName> <persName>Carolo</persName> et multis comitibus <lb xml:id="p1z18"/>et nobilibus.</s>
					<s n="8" xml:lang="la"><persName ref="p18575">Hispani regis</persName> sponsa praeter omnium <lb xml:id="p1z19"/>expectationem magna cum pompa et 12 cum navibus <lb xml:id="p1z20"/>magnis bellicis <persName ref="p18554">reginae Angliae</persName> in Anglico mari <lb xml:id="p1z21"/>excepta honorificentissime et usque in portum <lb xml:id="p1z22"/><placeName>Biscaiae</placeName> deducta est.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Quo nomine <placeName ref="l875">Hispani</placeName> vehementer <lb xml:id="p1z23"/>exhilerati, et <persName>Hispana regia</persName> munera <lb xml:id="p1z24"/>misit <persName ref="p18554">reginae Angliae</persName>.</s>
					<s n="10" xml:lang="la">Mirantur omnes nondum <lb xml:id="p1z25"/>compositis <placeName ref="l830">Angliae</placeName> et <placeName ref="l875">Hispaniae</placeName> rebus <placeName ref="l830">Anglam</placeName> hoc <lb xml:id="p1z26"/>honoris impendisse hosti; sed prudentiores <lb xml:id="p1z27"/>id tribuunt eximiae sapientiae <persName ref="p18554">reginae Angliae</persName> etc.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z28"/>Finientur comitia <placeName ref="l471">Spyrensia</placeName> propediem, nisi <lb xml:id="p1z29"/>iam sunt finita.</s>
					<s n="12" xml:lang="la">Impetravit ab imperio imperator <lb xml:id="p1z30"/>bonam pecuniae summam.</s>
					<s n="13" xml:lang="de">Dorumb ists zuͦ thuͦn, <lb xml:id="p1z31"/>sunst wenig ußgericht.</s>
					<s n="14" xml:lang="la">Hodie octavus est dies, <lb xml:id="p1z32"/>quando ad te dedi literas una cum libro <persName ref="p8033">Bezae</persName>, <lb xml:id="p1z33"/>quo confutat <persName ref="p458">Brentii</persName> et aliorum libellos academicorum <lb xml:id="p1z34"/>contendentium haereticos non esse puni<lb xml:id="p1z35"/>endos.</s>
					<s n="15" xml:lang="la">Tu illum mihi, ubi usus fueris, <lb xml:id="p1z36"/>remittes tuto.</s>
					<s n="16" xml:lang="la">Nihil te hac septimana scripsisse <lb xml:id="p1z37"/>arbitror propter nundinas vestras et propter negotia, quae <lb xml:id="p1z38"/>tibi, sibi et aliis <persName ref="p20473">Ganthnerus</persName> obtrudit.</s>
					<s n="17" xml:lang="la">Cupio <lb xml:id="p1z39"/>sciat, quid fiat aut quid factum sit.</s>
					<s n="18" xml:lang="la">Dominus bene<lb xml:id="p1z40"/>dicat tibi tuisque laboribus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 17. novembris <lb xml:id="p1z41"/>anno salutis nostrae 1570.</s>
					<s n="20" xml:lang="la" ana="salute">Saluta utrumque consulem, d. <persName ref="p1770">Carolum</persName>, <lb xml:id="p1z42"/><persName ref="p6130">Pontisellam</persName>, <persName ref="p8186">Bonetum</persName> et alios.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z43"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="22" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem wolgelerten, frommen und <lb xml:id="p2z2"/>getruwen herren <persName ref="p8016">Thobia <lb xml:id="p2z3"/>Egli</persName>, pfarreren zuͦ Sant Martin <lb xml:id="p2z4"/>ze <placeName ref="l98">Chur</placeName> in den Pündten, <lb xml:id="p2z5"/>minem günstigen herren und <lb xml:id="p2z6"/>bruͦder.</s>
					<s n="23" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
