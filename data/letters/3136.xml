	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Sperabam me per occasionem ad te priora omnia folia <lb xml:id="p1z2"/>missurum, antequam ultimo finem imponerem; verum <lb xml:id="p1z3"/>propter instantes iam nundinas et quod tabellariis <lb xml:id="p1z4"/>hactenus destituti fuimus, nihil potui mittere <lb xml:id="p1z5"/>et ad umbilicum perducere libellum oportuit.</s>
					<s n="3" xml:lang="la">Itaque, <lb xml:id="p1z6"/>si quod forte occurrat emendandum, quod ne fieret, <lb xml:id="p1z7"/>sedulo curavi, aequo animo feres et calamo in <lb xml:id="p1z8"/>paucis aliquot, ad te exemplaribus <lb xml:id="p1z9"/>emendari curabis quę mitto.</s>
					<s n="4" xml:lang="la">Mitto autem 12 tantum, quę <lb xml:id="p1z10"/>tibi vicissim dono, quamquam et plura debeam et li<lb xml:id="p1z12"/>benter, si volueris, plura missurus sim.</s>
					<s n="5" xml:lang="la">Solum <lb xml:id="p1z13"/>tamen 800 excudere ob temporis brevitatem <lb xml:id="p1z14"/>fuit necesse; alioqui absolvere propter alia, <lb xml:id="p1z15"/>quibus prela etiamnum occupantur, non licuisset.</s>
					<s n="6" xml:lang="la" ana="salute">Bene <lb xml:id="p1z16"/>vale et <persName ref="p8171">Theodoro</persName>, <persName ref="p1214">Frisio</persName>, <persName ref="p1283">Gesnero</persName>, <persName ref="p8011">Gualthero</persName> <lb xml:id="p1z17"/>per occasionem salutem ex me dicito.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l28">Basileę</placeName> 27. martii 1557.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p8126">Ioannes Oporinus</persName> tuu<lb xml:id="p1z19"/>s <lb xml:id="p1z20"/>ex animo.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henrico B<lb xml:id="p2z2"/>ullingero</persName>, ecclesię <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> pastori, <lb xml:id="p2z4"/>domino et amico <lb xml:id="p2z5"/>suo polurimum co<lb xml:id="p2z6"/>lendo.</s>
					<s n="10" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
