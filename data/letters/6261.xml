	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Reverende in Christo pater, tuas accepi una cum <lb xml:id="p1z2"/>libro tuo, qui d. d. <persName ref="p4037">Zancho</persName> inscriptus est, et epistola <lb xml:id="p1z3"/>ad eundem; curabo prima occasione, licet de <lb xml:id="p1z4"/>tempore nihil certi promittere possim; illa enim <lb xml:id="p1z5"/>via iam clausa est propter pestem, quod ipsum te ex <lb xml:id="p1z6"/><persName ref="p4037">Zanchi</persName> ad me literis intellexisse puto.</s>
					<s n="3" xml:lang="la">Plurii <lb xml:id="p1z7"/>quoque hoc malum ingravescit, unde minister <lb xml:id="p1z8"/>illius ecclesię, <persName>Hyeronimus</persName>, ad nos profugerat.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Displicuit mihi hoc in homine factum vehementer, <lb xml:id="p1z10"/>quod is primus esset, qui fugam arriperet.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Reprehendi <lb xml:id="p1z11"/>eum; respondit hunc morem esse Italorum, templa <lb xml:id="p1z12"/>statim claudi, omni congressu mutuo homines <lb xml:id="p1z13"/>prohiberi.</s>
					<s n="6" xml:lang="la">Sed quod eum alii quoque non pauci se<lb xml:id="p1z14"/>querentur, senatus noster eis hospitium negavit; <lb xml:id="p1z15"/>iussit ad suos redire.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Fortassis ad vos descendit; <lb xml:id="p1z16"/>nusquam hic apparet amplius.</s>
					<s n="8" xml:lang="la">Quodsi se apud <lb xml:id="p1z17"/>suos continuisset, consilio et re praesto fuisset <lb xml:id="p1z18"/>et saltem baptismum administrasset.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Certe videtur r<lb xml:id="p1z19"/>es pessimi exempli, ideoque non ferendus, sed ad <lb xml:id="p1z20"/>suam ecclesiam remittendus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Est alias homo perversi <lb xml:id="p1z21"/>cerebri et ingenii.</s>
					<s n="11" xml:lang="la">Quod ad vos attinet, etsi <lb xml:id="p1z22"/>luctuosa sunt, quae nuncias, et periculum est, ne malum <lb xml:id="p1z23"/>hoc latius serpat, tamen ferenda sunt, quae dominus <lb xml:id="p1z24"/>immittit.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Tibi facile credo, te ad mundi huius <lb xml:id="p1z25"/>vanitatem nauseare incipere et cupere dissolvi <lb xml:id="p1z26"/>et esse cum Christo;<note xml:id="fn1" type="footnote" n="1">Vgl. <cit type="bible"><ref>Phil 1, 23</ref></cit>.</note> ecclesię tamen mo<lb xml:id="p1z27"/>r<lb xml:id="p1z28"/>s t<pb/><lb xml:id="p2z1"/>ua qu<lb xml:id="p2z3"/>ant<lb xml:id="p2z4"/>umvis <lb xml:id="p2z5"/>ma<lb xml:id="p2z6"/>tur<lb xml:id="p2z7"/>a, nimi<lb xml:id="p2z8"/>s est f<lb xml:id="p2z9"/>utu<lb xml:id="p2z10"/>ra ace<lb xml:id="p2z11"/>rba<lb xml:id="p2z12"/>, quando<lb xml:id="p2z13"/>cunque <lb xml:id="p2z14"/>ta<lb xml:id="p2z15"/>nde<lb xml:id="p2z16"/>m supe<lb xml:id="p2z17"/>rv<lb xml:id="p2z18"/>e<lb xml:id="p2z20"/>ner<lb xml:id="p2z21"/>it.</s>
					<s n="13" xml:lang="la">Inte<lb xml:id="p2z22"/>rim fi<lb xml:id="p2z23"/>at v<lb xml:id="p2z24"/>olu<lb xml:id="p2z25"/>ntas <lb xml:id="p2z26"/>do<lb xml:id="p2z27"/>m<lb xml:id="p2z28"/>ini.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z29"/>Ae<lb xml:id="p2z30"/>ru<pb/><lb xml:id="p3z1"/>mna<lb xml:id="p3z2"/>rum <lb xml:id="p3z4"/>ce<lb xml:id="p3z5"/>rt<lb xml:id="p3z6"/>e <lb xml:id="p3z7"/>nul<lb xml:id="p3z9"/>l<lb xml:id="p3z10"/>um <lb xml:id="p3z11"/>fin<lb xml:id="p3z12"/>em <lb xml:id="p3z14"/>inven<lb xml:id="p3z15"/>io pra<lb xml:id="p3z16"/>ete<lb xml:id="p3z17"/>r<lb xml:id="p3z18"/>quam <lb xml:id="p3z19"/>in <lb xml:id="p3z20"/>ipsa.<lb xml:id="p3z21"/>.<pb/><lb xml:id="p4z4"/>.</s>
				</p>
				<p>
					<note>[Rest nicht abgeschrieben von T. Schieß.]</note>
				</p>
