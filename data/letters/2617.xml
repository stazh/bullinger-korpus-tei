	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non habeo, quod nunc tibi, chare fili, <lb xml:id="p1z2"/>scribam nisi solitum illud meum: time deum, <lb xml:id="p1z3"/>ambula in mandatis eius, crede Christo, dei filio, <lb xml:id="p1z4"/>ora continue, stude et exerceto te in bonis <lb xml:id="p1z5"/>simul et sacris literis, sicuti dedi tibi institutionem <lb xml:id="p1z6"/>manu mea scriptam.</s>
					<s n="3" xml:lang="la">Dominus benedicat tibi.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Vide, ut sis humilis, fidelis et utilis domi tuae.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Valemus hic per dei gratiam rectissime, <lb xml:id="p1z10"/>nisi quod frater <placeName>Ottenbachii</placeName> perpetuis ex crur<lb xml:id="p1z11"/>e <lb xml:id="p1z12"/>doloribus discrutiatur; ibi etiam pestis nonnullos <lb xml:id="p1z13"/>praepropera morte <lb xml:id="p1z14"/>sustulit.</s>
					<s n="6" xml:lang="la"><placeName ref="l294">Locarenenses</placeName> plerique <lb xml:id="p1z15"/>ad nos commigrant et perbenigne recipiuntur; sed vix <lb xml:id="p1z16"/>patet illis locus; scis enim, quanta sit hominum <lb xml:id="p1z17"/><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z18"/>copia.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Difficulter ergo parantur eis hospitia nec tan<lb xml:id="p1z19"/>tis commoda <lb xml:id="p1z20"/>hominibus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z21"/>Intelliges ex hero <lb xml:id="p1z22"/>tuo <lb xml:id="p1z23"/>Iulium 3. pontificem 23. martii esse mortuum, alium pon<lb xml:id="p1z24"/>tificem esse creatum aprilis 10., hominem veteratorem <lb xml:id="p1z25"/>et exercitatum in malicia et ea de causa <lb xml:id="p1z27"/>papam verissimum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z28"/>Expecto tractationem tuam De divinationibus.</s>
					<s n="10" xml:lang="la" ana="salute">S<lb xml:id="p1z29"/>alutabis amicissime d. <persName ref="p8111">Petrum Martyrem</persName>, d. <persName ref="p4037">Hieronymum <lb xml:id="p1z30"/>Zanchum</persName> et alios tuos praeceptores, inprimis <lb xml:id="p1z31"/>d. d. <persName ref="p18137">Marpachium</persName> et <persName>Valentinum Erythreum</persName>, <persName ref="p8074">Dasypodium</persName>, <lb xml:id="p1z32"/><persName ref="p3088">Sturmium</persName> et caeteros.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z33"/>D. <persName ref="p8362">Garnerio</persName> dices m<lb xml:id="p1z34"/>e eius literas scriptas 22. marcii recepisse <lb xml:id="p1z35"/>neque habere modo, quod rescribam, nisi quod bene<lb xml:id="p1z36"/>dictionem ei imprecor a domino.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z37"/>Vale, fili chare, et annitere, ut meae expectationi <lb xml:id="p1z38"/>aliquando respondeas.</s>
					<s n="13" xml:lang="la">Ora dominum, ut possis.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z39"/><placeName ref="l587">Tiguri</placeName> 19. aprilis 1555.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z40"/><persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Dilecto meo filio <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l491">Ar<lb xml:id="p2z3"/>gentinae</placeName> agenti in <lb xml:id="p2z4"/>aedibus optimi viri d. <lb xml:id="p2z5"/><persName ref="p505">Burcheri</persName>, Angli.</s>
				</p>
				<p>
					<s n="17" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l491">Straßburg</placeName>.</s>
				</p>
			</div>
