	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Tuas habui et summas gratias ago, quod <lb xml:id="p1z2"/>tam cautus et diligens esse velis in <lb xml:id="p1z3"/>meis ad <persName ref="p3375">Vergerium</persName> mittendis.</s>
					<s n="3" xml:lang="la">Nova <lb xml:id="p1z4"/>vis: habeo pessima, quod ad <placeName ref="l830">Angliam</placeName>; <lb xml:id="p1z5"/>matrimonium <placeName ref="l875">Hispanicum</placeName> est certo <lb xml:id="p1z6"/>iunctum et iam misit <persName ref="p18554">regina Anglię</persName> <lb xml:id="p1z7"/>novem naves onerarias in <placeName ref="l875">Hispaniam</placeName> <lb xml:id="p1z8"/>cum suis legatis ad principem vocandum, <lb xml:id="p1z9"/>et cum istis et suis veniet versus <lb xml:id="p1z10"/>martium.</s>
					<s n="4" xml:lang="la">Deus adsit bonis omnibus.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Sed crede mihi istud est a vobis <lb xml:id="p1z12"/>et a nostris maxime timendum, et <lb xml:id="p1z13"/>debent omnes currere ad incendium <lb xml:id="p1z14"/>i<lb xml:id="p1z16"/>stud extinguendum.</s>
					<s n="6" xml:lang="la">20a <lb xml:id="p1z17"/>alterius mensis iussit regina illa proclamari <lb xml:id="p1z19"/>publice, quod nemo sub pena capitis <lb xml:id="p1z20"/>de <placeName ref="l875">Hispanis</placeName>, <persName ref="p18538">Caesare</persName> nec suo <lb xml:id="p1z22"/>matrimonio loqueretur.</s>
					<s n="7" xml:lang="la">Ego <lb xml:id="p1z23"/>postam conscendo, ut domum meam <lb xml:id="p1z24"/>et domestica invisam; sed tantum viginti <pb/><lb xml:id="p2z1"/>dies impetravi a rege.</s>
					<s n="8" xml:lang="la">Ego statim <lb xml:id="p2z2"/>adero; hic manent mei et inter <lb xml:id="p2z3"/>alios meus secretarius, qui eundem <lb xml:id="p2z4"/>quam ego habebit potestatem.</s>
					<s n="9" xml:lang="la">Ille <lb xml:id="p2z5"/>est, qui te nuper invisit.</s>
					<s n="10" xml:lang="la">Si quid <lb xml:id="p2z6"/>a te veniet, mittet mihi bona <lb xml:id="p2z7"/>fide; si quid etiam habeas a <persName ref="p3375">Ver[<lb xml:id="p2z8"/>gerio]</persName> nostro, mitte, queso, ad eum <lb xml:id="p2z9"/>et ora pro me<lb xml:id="p2z10"/>.</s>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p2z11"/>Vale optime.</s>
					<s n="12" xml:lang="la">Ex <lb xml:id="p2z12"/><placeName ref="l760">Solu<lb xml:id="p2z13"/>turo</placeName> 18a<note type="margin">a.R.: 1 viell. gestr.</note> ian<lb xml:id="p2z14"/>uarii.</s>
					<s n="13" xml:lang="la">Raptim.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z15"/>Tuus s<lb xml:id="p2z16"/>emper <lb xml:id="p2z17"/><persName ref="p8296">Bass[a]<lb xml:id="p2z18"/>f[ontaneus]</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z19"/>Populus <placeName ref="l830">Anglie</placeName> et tota nobilitas <lb xml:id="p2z20"/>maxime conantur impedire hoc <lb xml:id="p2z21"/>matrimonium, et speratur disso[lu]tum; tamen <lb xml:id="p2z22"/><persName ref="p18538">Caesaris</persName> pecunię multum <lb xml:id="p2z23"/>valent; papa eti<lb xml:id="p2z24"/>am, qui totus nobis est contrarius, <lb xml:id="p2z25"/>vigilat <lb xml:id="p2z26"/>contra nos p<lb xml:id="p2z27"/>ro <placeName ref="l875">Hispanis</placeName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p3z1"/>Optimo viro et <lb xml:id="p3z2"/>amico domino <lb xml:id="p3z3"/><persName ref="p495">Bulingero</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note>[Von anderer Hand (Wunderlich?)]</note>
					<s n="18" xml:lang="de"><lb xml:id="p3z4"/>Dem hernn <persName ref="p495">Bullinger</persName> z<lb xml:id="p3z5"/>u uberanttwurten<lb xml:id="p3z7"/>.</s>
				</p>
				<p>
					<s n="19" xml:lang="de"><lb xml:id="p3z8"/><placeName ref="l587">Zürych</placeName>.</s>
				</p>
			</div>
