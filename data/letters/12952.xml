	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Siehe dazu unten <ptr target="qvfn17169-1" type="qv"/>.</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Quamquam nihil modo, quod scribam, habeo, <lb xml:id="p1z3"/>vir colendissime, volui tamen diuturnum illud <lb xml:id="p1z4"/>silentium meum excusare.</s>
					<s n="3" xml:lang="la">Lavimus una <persName ref="p8127">Pellicanus</persName> <lb xml:id="p1z5"/>et ego cum aliquot bonis civibus <placeName ref="l515">Urdorffii</placeName>, <lb xml:id="p1z6"/>quo post Pascha<note xml:id="fn2" type="footnote" n="2">1547 fiel Ostern auf den 10. April. - Die Badenden hielten sich vom 17. April bis zum 11. Mai in <placeName ref="l515">Urdorf</placeName> (<placeName ref="l803">Kt. Zürich</placeName>) auf; s. <ref target="file12935">Nr. 2886</ref>, <ptr target="qvfn17153-2" type="qv"/>.</note> abivimus; redivimus superior<lb xml:id="p1z7"/>ibus diebus.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="4" xml:lang="la">Plures literas amicorum, etiam <lb xml:id="p1z8"/>tuas 23. aprilis datas<note xml:id="fn3" type="footnote" n="3">Nicht erhalten.</note>, accepi.</s>
					<s n="5" xml:lang="la">Caeterum illis, <lb xml:id="p1z9"/>quas ex <placeName ref="l2481">Suevia</placeName> scribunt amici,<note xml:id="fn4" type="footnote" n="4">Gemeint ist, wie es aus unten Z. <ptr target="qvzl17169-1" type="qv"/> hervorgeht, die Niederlage und die Gefangennahme des Kurfürsten (<hi>elector</hi>) <persName ref="p19065">Johann Friedrich I. von Sachsen</persName>. - Siehe dazu <ref target="file12943">Nr. 2894</ref>, <ptr target="qvfn17159-1" type="qv"/>.</note> credere non <lb xml:id="p1z10"/>possum.</s>
					<s n="6" xml:lang="la">Non enim congruit et constat sibi <lb xml:id="p1z11"/>narratio.</s>
					<s n="7" xml:lang="la">Expectamus ergo in diem certiora <lb xml:id="p1z12"/>et planiora.</s>
					<s n="8" xml:lang="la">De electoris captivitate et <lb xml:id="p1z13"/>rursus de strage <persName ref="p18538">caesaris</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p18538">Karl V.</persName></note> facta a <placeName ref="l749">Saxonibus</placeName> <lb xml:id="p1z14"/>et <placeName ref="l2449">Bohemis</placeName><note xml:id="fn6" type="footnote" n="6">Solche Nachrichten waren in <persName ref="p495">Bullingers</persName> Briefwechsel schon älter und kamen nicht alle aus <placeName ref="l2557">Süddeutschland</placeName>; s. <ref target="file12931">Nr. 2882</ref>,<ptr target="qvzl17149-1" type="qv"/>; <ref target="file12932">Nr. 2883</ref>,<ptr target="qvzl17150-3" type="qv"/>; und <ref target="file12934">Nr. 2885</ref>,<ptr target="qvzl17152-2" type="qv"/>. Vielleicht hatte er Ähnliches aus Briefen an Drittpersonen erfahren.</note> loquor.</s>
					<s n="9" xml:lang="la">Sunt enim, qui dicant <lb xml:id="p1z15"/>electore semel captum, mox red-<pb type="edition" next="200"/>emptum esse!<note xml:id="fn7" type="footnote" n="7"><persName ref="p495">Bullinger</persName> hatte (vgl. nämlich unten Z. <ptr target="qvzl17169-6" type="qv"/>) eine entsprechende Nachricht von <persName ref="p8018">Haller</persName> aus <placeName ref="l18">Augsburg</placeName> erhalten (s. <ref target="file12943">Nr. 2894</ref>,<ptr target="qvzl17159-13" type="qv"/>), hielt sie aber offenbar für unsicher!</note></s>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/>Certum tamen est caesareanos <placeName ref="l18">Augustae</placeName> et <placeName ref="l513">Ulmae</placeName> <lb xml:id="p1z17"/>calendis maii et pridie calendarum triumphasse:</s>
					<s n="11" xml:lang="de"><lb xml:id="p1z18"/>Die <placeName ref="l18">Augspurger</placeName> habend fröud geschossen, das <lb xml:id="p1z19"/>der wal by dem roten thoor inen yngefallen <lb xml:id="p1z20"/>ist!<note xml:id="fn8" type="footnote" n="8">Vgl. <ref target="file12943">Nr. 2894</ref>,<ptr target="qvzl17159-14" type="qv"/>.</note></s>
					<s n="12" xml:lang="la">Haec est videlicet Mercurialium <lb xml:id="p1z21"/>hominum fides!</s>
					<s n="13" xml:lang="la">Tonare bombardis et epulari <lb xml:id="p1z22"/>et iubilare, cum capiuntur et caeduntur sotii<note xml:id="fn9" type="footnote" n="9">= socii.</note> <lb xml:id="p1z23"/>ac optimi quique viri.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="14" xml:lang="la">Senatus noster una<lb xml:id="p1z24"/>nimi consensu<note xml:id="fn10" type="footnote" n="10">An der Ratssitzung vom 16. Mai 1547; s. Zürich StA, B II 68 (Ratsprotokoll), S. 18. Am Tag darauf verfasste der <placeName ref="l587">Zürcher</placeName> Rat einen Brief an den Rat von <placeName ref="l18">Augsburg</placeName> (Entwurf dieses Briefes in Zürich StA, B IV 16, 148r.) und einen weiteren an <persName ref="p8018">Johannes Haller</persName> und <persName ref="p2812">(Hans) Thoman Ruman (Römer)</persName> (Entwurf ebd., f. 148v.). - Siehe dazu schon <bibl source="b20">HBBW XVII</bibl> 417f, Anm. 21.<ptr target="zfnfn17169-2" type="zfn"/></note> revocat ab <placeName ref="l18">Augusta</placeName> <persName ref="p8018">Hallerum</persName> <lb xml:id="p1z25"/>et <persName ref="p2812">Romanum</persName> in patriam.</s>
					<s n="15" xml:lang="la">Nemo est, <lb xml:id="p1z26"/>qui perfidis illis urbibus<note xml:id="fn11" type="footnote" n="11">Jene Städte nämlich, die sich dem Kaiser unterworfen hatten.</note> faveat.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="16" xml:lang="la">Audio <lb xml:id="p1z27"/>et <persName ref="p467">Bucerum</persName> deditioni <placeName ref="l491">Argentinensium</placeName> val[de]<note xml:id="fna" type="footnote" n="a"><hi>Hier und unten Textverlust durch Papierverlust.</hi></note> <lb xml:id="p1z28"/>patrocinari et caesarisare fortiter.<note xml:id="fn12" type="footnote" n="12"><persName ref="p495">Bullinger</persName> wurde offenbar von in <placeName ref="l28">Basel</placeName> wohnenden Personen über den Inhalt des von <persName ref="p467">Bucer</persName> an <persName ref="p8418">Myconius</persName> gerichteten Briefes vom 30. März 1547 (<bibl>Henrich, Myconius BW</bibl> 953, <ref target="file11111">Nr. 1068</ref>) informiert.</note></s>
					<s n="17" xml:lang="la">Quo[d] <lb xml:id="p1z29"/>si verum est, eveniet illi, quod diu ia[m] <lb xml:id="p1z30"/>ipsi eventurum timui.</s>
					<s n="18" xml:lang="la">Dominus liberet n[os] <lb xml:id="p1z31"/>a malo!<note xml:id="fn13" type="footnote" n="13"><cit type="bible"><ref>Mt 6, 13</ref></cit>.</note></s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="19" xml:lang="la">D. <persName ref="p1278">Gastio</persName> fasciculum hunc t[ra]di <lb xml:id="p1z32"/>mox curato.<note xml:id="fn14" type="footnote" ana="bio" n="14">Vermutlich ein Dankesgeschenk (vgl. nämlich <bibl source="b22">HBBW XIX</bibl>, 125,6-8) für den wiederholten Einsatz von <persName ref="p1278">Johannes Gast</persName> beim Kauf der Wolle (s. z.B. <bibl source="b21">HBBW XVIII</bibl>, <ref target="file12768">Nr. 2721</ref>. 2724. 2718; XIX, <ref target="file12787">Nr. 2738</ref>; und oben <ref target="file12931">Nr. 2882</ref>) zugunsten von <persName ref="p495">Bullingers</persName> Frau <persName ref="p8051">Anna, geb. Adlischwyler</persName>, und deren Tochter <persName ref="p7224">Anna</persName>.</note></s>
					<s n="20" xml:lang="la">Valeto.</s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="21" xml:lang="la">Scribunt ex <placeName ref="l311">Ma[r]purgo</placeName> <persName ref="p3138">Thamerus</persName> et <lb xml:id="p1z33"/><persName ref="p1456">Happelius</persName> 27. Aprilis <lb xml:id="p1z35"/>datis literis <persName ref="p3590">Hessum</persName><note xml:id="fn15" type="footnote" n="15"><persName ref="p3590">Philipp von Hessen</persName>.</note> esse in armis ac pro<lb xml:id="p1z36"/>pediem moturum in papistas.<note xml:id="fn16" type="footnote" n="16">Siehe <ref target="file12932">Nr. 2883</ref>,<ptr target="qvzl17150-4" type="qv"/> (<persName ref="p1456">Wigand Happels</persName> Brief vom 18. April); <ref target="file12938">Nr. 2889</ref>,[5] (<persName ref="p3138">Theobald Thamers</persName> Brief vom 27. April).</note></s>
					<s n="22" xml:lang="la">Dominus servet <lb xml:id="p1z37"/>illum!</s>
					<s n="23" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, <lb xml:id="p1z38"/>18. aprilis<note xml:id="fnb" type="footnote" n="b"><hi><persName ref="p8418">Myconius</persName> schrieb darunter</hi> maii nimirum.<ptr target="zfnfn17169-1" type="zfn"/></note> 1547.</s>
					<s n="24" xml:lang="la">Tu<lb xml:id="p1z39"/>as <lb xml:id="p1z40"/>expecto avide!</s>
					<s n="25" xml:lang="la"><lb xml:id="p1z41"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p8418">Os<lb xml:id="p2z2"/>valdo Myconio</persName>, <lb xml:id="p2z3"/>fidelissimo <placeName ref="l28">Basiliensis</placeName> e<lb xml:id="p2z4"/>cclesię ministro, domino <lb xml:id="p2z5"/>et fratri suo <lb xml:id="p2z6"/>colendissimo.</s>
					<s n="27" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
