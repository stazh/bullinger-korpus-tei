	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuae literae, reverende in Christo pater, mihi hodie, <lb xml:id="p1z2"/>sed vesperi redduntur.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Non habui, quod rescriberem; <lb xml:id="p1z3"/>d. <persName ref="p8093">Hercules a Salicibus</persName> recepit se omnino ad te <lb xml:id="p1z4"/>scripturum; nam te observat et amat, sed dicebat <lb xml:id="p1z5"/>se verecundari, quod inter scribendum Italizaret <lb xml:id="p1z6"/>et Latine non posset.</s>
					<s n="4" xml:lang="la">Filius <persName>Rhodolphus</persName> <lb xml:id="p1z7"/>sancte promisit se porro mature satis nos de <lb xml:id="p1z8"/>rebus <placeName ref="l522">Venetis</placeName> edocturum; nam sibi optime de iis <lb xml:id="p1z9"/>constare.</s>
					<s n="5" xml:lang="la">Dum ergo ipse nihil scribit, non puto <lb xml:id="p1z10"/>esse, quod nos scire referat.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quae nuper de <persName ref="p3375">Vergerio</persName> <lb xml:id="p1z11"/>scripsi, nonnihil concitatus scripsi, sed vera scripsi <lb xml:id="p1z12"/>et multa possem adiicere, sed mihi nunc reservo.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p458">Brentii</persName> librum non vidi et dubito, si nominatim contra <lb xml:id="p1z14"/>te scripsit; nam <persName ref="p3375">Vergerius</persName> id factum esse pernegat.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Non est, quod mittam librum <persName ref="p3375">Vergerii</persName>; nam cives nostri <lb xml:id="p1z16"/>et inter eos d. <persName ref="p8114">Balinggetus</persName> de eo ad me retulerant; <lb xml:id="p1z17"/>interim inspexi ipse, <foreign xml:lang="de">ist des <persName ref="p3375">Vergerii</persName> widerruͦff;</foreign> <lb xml:id="p1z18"/>nam te illum librum habere ex eo colligo, quod <persName ref="p3375">Vergerius</persName> <lb xml:id="p1z19"/>inter alia, cum de te conquereretur, et haec adiecit: te cum <lb xml:id="p1z20"/>illum librum inspiceres, indignabundum eum ex manibus <lb xml:id="p1z21"/>abiecisse, quod tibi in causa sacramenti non <lb xml:id="p1z22"/>satisfaceret.</s>
					<s n="9" xml:lang="la">D. d. <persName ref="p8111">Martyrem</persName> salvum et incolumem <lb xml:id="p1z23"/>redisse nobis gratulor.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Promiserat noster consul s<lb xml:id="p1z24"/>e acta Domus Dei communicaturum; sed nondum <lb xml:id="p1z25"/>fecit; mittam, cum dederit.</s>
					<s n="11" xml:lang="la">Plura nunc non possum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z26"/>Vale, reverende in Christo pater.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Consignavi contiones <lb xml:id="p1z27"/>meas <placeName>Inlantii</placeName> habitas in unum libellum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Deus mihi <lb xml:id="p1z28"/>testis est, quod non vener aliquam gloriolam, sed <lb xml:id="p1z29"/>totus in eo sum, ut nostros confirmem; nam procul <lb xml:id="p1z30"/>dubio pontifex alia quoque aggredietur.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Si is liber <lb xml:id="p1z31"/>meus satisfecerit censoribus, rogo te, ut per occasionem <pb/><lb xml:id="p2z1"/>aliquam <persName ref="p1227">Froschouero</persName> author sis, ut eum excudat mature; nam tale genus argumenti est, quod propter <lb xml:id="p2z2"/>novitatem esse gratiosius.</s>
					<s n="16" xml:lang="la" ana="farewell">Vale, vir clarissime.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l98">Curię</placeName> 24. novembris anno 1561.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">T[uus] <persName ref="p8009">Fab[ricius</persName>].</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z3"/>Amplissimo viro eruditione et pietate excellenti ecclesiae <placeName ref="l587">Tigurinae</placeName> doctori vigilantissimo, d. <persName ref="p495">Heinrycho Bul<lb xml:id="p2z4"/>lingero</persName>, domino <lb xml:id="p2z5"/>et patrono suo observandissimo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>