				<p>
					<lb xml:id="p1z1"/>558.
					<lb xml:id="p1z2"/>ideryc ho Palatino Rheini
					<lb xml:id="p1z3"/>F.
					<lb xml:id="p1z4"/>s.
					<lb xml:id="p1z5"/>electori etc.
					<lb xml:id="p1z6"/>Illustrissimis princeps, domino clementissimo domini Iesus benedicat tibi
					<lb xml:id="p1z7"/>et servet te in sempiterium. Cum principibus innunera
					<lb xml:id="p1z8"/>sint quotidie et audiendam et expedienda negocia semper
					<lb xml:id="p1z9"/>audivi prudenter illos facere, qui omissis exordiis
					<lb xml:id="p1z10"/>expositione illa, quae propanere volunt, absolvum
					<lb xml:id="p1z11"/>Oro igitur clenentiam tuam princeps illustrissime
					<lb xml:id="p1z12"/>ut pauca, sed necessaria proponentem, audias benigne
					<lb xml:id="p1z13"/>Non ignorat ta , quantum exorium sit ante
					<lb xml:id="p1z14"/>menses aliquot dissidium in schola et ecclesia Argen
					<lb xml:id="p1z15"/>inter professores et concionatores eius ecclesia
					<lb xml:id="p1z16"/>ministros. Dum enim quidam concionatorum
					<lb xml:id="p1z17"/>Hiero.
					<lb xml:id="p1z18"/>oderunt clarissime virum d. Comchum non aliam
					<lb xml:id="p1z19"/>ob causam magis, quam quod videretur istis non ta
					<lb xml:id="p1z20"/>rae sentire de sacro corporis et sanguinis domini
					<lb xml:id="p1z21"/>quam quidam requirunt, et tumen doctrinam
					<lb xml:id="p1z22"/>Zanhi hac de reglamnare non porcent, observants
					<lb xml:id="p1z23"/>alia in eius praelectionibus capita, praper
					<lb xml:id="p1z24"/>quae ipsum vexarent ac de gradiu suo deturba
					<lb xml:id="p1z25"/>Ac cellegerunt hic quaedam de praede
					<lb xml:id="p1z26"/>vel electione sanctorum capita, quoque
					<lb xml:id="p1z27"/>ea causa prae cęteris videretur esse talis, quae
					<lb xml:id="p1z28"/>facile posset calumniati doctorique gravem apud
					<lb xml:id="p1z29"/>populum conflare invidiam. Et tamen nihil senti
					<lb xml:id="p1z30"/>nihil dacuit ea de re Lonchus aliud
					<lb xml:id="p1z31"/>quam quod in eadem schola et ecclesia antea d
					<lb xml:id="p1z32"/>ptrae memoriae Bucerus, id quod se
					<lb xml:id="p1z33"/>vel testimoriis Buceri, abunde commostratu
					<lb xml:id="p1z34"/>promittit, ut iam non comemorem
					<lb xml:id="p1z35"/>et d. Lutherus, Oecolampadis et ante hos
					<pb/>
					<lb xml:id="p2z1"/>S. Augustinus nihil aliud vel redidit vel
					<lb xml:id="p2z2"/>At nolunt cum Zuicho conferre
					<lb xml:id="p2z3"/>nolunt ipsum audire concionatores. Caeterum
					<lb xml:id="p2z4"/>collecta sunt interim multa multorum scholarum
					<lb xml:id="p2z5"/>iudicia illa ipsa de re et oblata amplissimus eius
					<lb xml:id="p2z6"/>pblicamagistratui. Ubi iam viri tam ina
					<lb xml:id="p2z7"/>metuunt, ne forte sententia feratur contra d.
					<lb xml:id="p2z8"/>Zanchum atque ita eiiciatur vir innocens, sed
					<lb xml:id="p2z9"/>sana simul doctrina condemnetur, denique eiicia
					<lb xml:id="p2z10"/>praeterea Sturmius, vir doctissime, una cum nu
					<lb xml:id="p2z11"/>aliis viris synceris et bonis, Ac mirum in
					<lb xml:id="p2z12"/>modum impotinos esse audimus concionato
					<lb xml:id="p2z13"/>sad populum. Videt proprudentia sua .
					<lb xml:id="p2z14"/>quannta in his sint discrimina, quam graves
					<lb xml:id="p2z15"/>oboriturae offensiones, quam denique iogosu
					<lb xml:id="p2z16"/>exultandi et blasphemandi suppeditabitur
					<lb xml:id="p2z17"/>hostibus communibus materia. De dissidio
					<lb xml:id="p2z18"/>illo omnia novisse puto ministros et professe
					<lb xml:id="p2z19"/>ressigulae et ecclesiae Heydelberg, a quibus copiosuia
					<lb xml:id="p2z20"/>si forte c requirat audiet.
					<lb xml:id="p2z21"/>Quid vero in tanto ecclesiae discrimine Christia
					<lb xml:id="p2z22"/>non principe dignius facere poterit tus e, quam
					<lb xml:id="p2z23"/>si communicato consilio cum illustrissimo principu
					<lb xml:id="p2z24"/>landgravio Hessorum (cui eadem de re eia
					<lb xml:id="p2z25"/>scribo) legationem ex ministris professoribusvi
					<lb xml:id="p2z26"/>consiliariis quoque ac inrisperitis, mittatis
					<lb xml:id="p2z27"/>qui dissidium hoc mature tentent camp
					<lb xml:id="p2z28"/>Non deerit piis conatibus Christus
					<lb xml:id="p2z29"/>qui ecclesiae suae semper adest. Beneficium
					<lb xml:id="p2z30"/>autm inęstimabile conferis in ecclesiam
					<pb/>
					<lb xml:id="p3z1"/>Dei alioqui afflictissimam laudem
					<lb xml:id="p3z2"/>quoque parabitis vobis mortalem apud posteros,
					<lb xml:id="p3z3"/>et praemium a deo accipietis amplissimum.
					<lb xml:id="p3z4"/>Tuam vero clementia supplex oro, princeps illustri
					<lb xml:id="p3z5"/>ut haec a me benigne accipiat, apud se diligenter
					<lb xml:id="p3z6"/>expendat et laborantibus rebus auxilium ferantur
					<lb xml:id="p3z7"/>mature. Dominus Iesus benedicat tibi princeps
					<lb xml:id="p3z8"/>illustrissimo et domine coendisse. Commendo me eximia
					<lb xml:id="p3z9"/>tuae humanitati ac pietati. <placeName ref="l587">Tiguri</placeName> 4 aprilis
					<lb xml:id="p3z10"/>anno domini 1562.
					<lb xml:id="p3z11"/>deditus
					<lb xml:id="p3z12"/>Heynrychus Bullingerus,
					<lb xml:id="p3z13"/>Tigurinę ecclesiae minister
