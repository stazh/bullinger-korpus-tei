			<zone xml:id="p2z5-0" points="2201,1198 2499,1198 2557,1162 2680,1198 2956,1165 3159,1203 3132,1100 2914,1139 2654,1081 2201,1126">2210,1151 2257,1151 2305,1148 2352,1148 2400,1148 2447,1147 2495,1144 2542,1143 2590,1143 2637,1142 2685,1142 2733,1144 2780,1145 2828,1147 2875,1148 2923,1151 2970,1154 3018,1157 3065,1157 3113,1161 3161,1166</zone>
