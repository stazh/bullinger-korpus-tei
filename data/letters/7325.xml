	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non possum ego consulere, ut in ecclesiis <lb xml:id="p1z2"/>nostris, in quibus certis per annum sacra domini <lb xml:id="p1z3"/>coena celebratur diebus, alia inducatur consuetudo, <lb xml:id="p1z4"/>qua crebrius peragatur.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Non ignoro <persName ref="p18700">Augustinum</persName> in ea <lb xml:id="p1z5"/>epistola, quam ego adduxi, commemorare multis fuisse <lb xml:id="p1z6"/>olim in usu singulis dominicis sumere sacram coenam <lb xml:id="p1z7"/>et aliis quidem quotidie etc.</s>
					<s n="4" xml:lang="la">Verum idem ille: "<lb xml:id="p1z8"/>Totum hoc genus rerum liberas habet observationes, <lb xml:id="p1z9"/>nec disciplina ulla in his est melior gravi pru<lb xml:id="p1z10"/>dentique christiano, quam ut eo modo agat, quo agere <lb xml:id="p1z11"/>viderit ecclesiam, ad quam cumque forte <lb xml:id="p1z12"/>devenerit."</s>
					<s n="5" xml:lang="la">Et item idem: "Mallem in rebus <lb xml:id="p1z13"/>huiusmodi, ut et ille in huius et hic in illius patria <lb xml:id="p1z14"/>ab eo, quod caeteri faciunt, non abhorreat" etc.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Quia itaque video, quantas excitaremus concertationes, <lb xml:id="p1z16"/>si quid mutaremus in recepta et iam usurpata <lb xml:id="p1z17"/>per annos 40 et plures forma etc., consultissimum <lb xml:id="p1z18"/>et deo acceptissimum esse non dubito, si iuxta <lb xml:id="p1z19"/><persName ref="p18700">Augustini</persName> consilium ita pergamus agere, quo videmus <lb xml:id="p1z20"/>agere ecclesiam, ad quam devenimus etc.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z21"/>7. decembris 1567.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z22"/><persName ref="p495">Bullingerus</persName> senior.</s>
				</p>
				<p>
					<note>[Keine Adresse.]</note>
				</p>
			</div>
