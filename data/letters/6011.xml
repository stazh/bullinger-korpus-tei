	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l378">Parisiis</placeName> ex iussu regis evangelium publice doceri apud nos ferunt.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/><placeName ref="l167">Genevam</placeName> nebulones quidam principi <placeName ref="l2478">Sabaudię</placeName> prodere voluerunt constituto ad <lb xml:id="p1z3"/>id die 26a decembris praeteriti, successu tamen destituto, comprehensi capite <lb xml:id="p1z4"/>poenas dedere.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><placeName ref="l3125">Ortenburgensem</placeName> equitem <placeName ref="l619">Bavarus</placeName> usque adeo infesta<lb xml:id="p1z5"/>t speciosos quosdam titulos praetexens, ut is profugus ad conventum principum <lb xml:id="p1z6"/>in <placeName ref="l1682">Misniam</placeName> abierit; conventum enim habent in oppido <placeName ref="l121">Drösen</placeName> <lb xml:id="p1z7"/>principes quidam <placeName ref="l822">Germanię</placeName> ad regem <placeName ref="l425">Romanum</placeName> et <persName ref="p18509">Augustum Saxonem</persName>, <lb xml:id="p1z8"/>qui iam ibidem existunt.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Hęc nolui intermittere, quin, priusquam in agrum nos<lb xml:id="p1z9"/>trum redirem, literis prioribus, quas iam obsignatas m. <persName ref="p2899">Schenkio</persName> tr<lb xml:id="p1z10"/>adideram, adderem.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Vereor, ne hęc sola... inter <placeName ref="l619">Bavarum</placeName> <lb xml:id="p1z11"/>et <placeName ref="l3125">Ortenburgensem</placeName> exorta, ut alia omittam, magnos nobis motus datura sit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/><persName ref="p20597">Grumpachius</persName> a iudicio camerę publice proscriptus; <lb xml:id="p1z13"/>ni<lb xml:id="p1z14"/>hilominus is validis copiis comitatus Francicis confoederatis <lb xml:id="p1z15"/>terrorem incutit.</s>
					<s n="7" xml:lang="la">Audio utrinque tam ab episcopis et <placeName ref="l361">Nerobergensibus</placeName> quam a <persName ref="p20597">Grumpachio</persName> <lb xml:id="p1z16"/>et sociis eius copias legi indies maiores.</s>
					<s n="8" xml:lang="la">Ita tandem<note type="misc">iam?</note> nos deus nostro <lb xml:id="p1z17"/>arbitrio ac perversę voluntati committit, qui ab ipsius voluntate pendere et ma<lb xml:id="p1z18"/>nu regi dedignamur.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Datę <placeName ref="l18">Augustę</placeName> 7. ianuarii anno d 64.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/><persName ref="p3740">Georgius a Stetten</persName> <lb xml:id="p1z20"/>tui observantissimus.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
