	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. Craas tuas 2. decembris datas nunc accepi
					<lb xml:id="p1z2"/>non est, quod ullam excusationem adfereis aut quod
					<lb xml:id="p1z3"/>prius literis meis non responderis aut nunc de
					<lb xml:id="p1z4"/>conventu vestro Badensi nihil scribus, sci
					<lb xml:id="p1z5"/>segravioribus negotiis deepenumero implicari, quod
					<lb xml:id="p1z6"/>ut scribendis literis tibi vecare licert atque e
					<lb xml:id="p1z7"/>de causa rarius interpello. De exitu conventus
					<lb xml:id="p1z8"/>hac tantum harbeo dicere petuisse me a te ut
					<lb xml:id="p1z9"/>si res transigeretur, quod impense desideram, tu
					<lb xml:id="p1z10"/>quamet aliiq boni viri in eo, quom pactum esset
					<lb xml:id="p1z11"/>acquiescerent, tu me quamprimum certuorem
					<lb xml:id="p1z12"/>facere non gravareris. Equidem in eo aequumus
					<lb xml:id="p1z13"/>esse putebam, ut, quemadmodum maximam ex ea
					<lb xml:id="p1z14"/>dissensione vestra omnium causa
					<lb xml:id="p1z15"/>molestiam reperam ita ei concordia voluptate
					<lb xml:id="p1z16"/>adfirerer. Caeterum neque ad me pertinet curiose
					<lb xml:id="p1z17"/>inquirere, quid agatur neque hic muneris tibi
					<lb xml:id="p1z18"/>imponendum putari, ut me certiorem foceres. aud
					<lb xml:id="p1z19"/>literas tuas superiores festinantissime, restandi a
					<lb xml:id="p1z20"/>ut verum. dieam turbate ita huc multu, quae
					<lb xml:id="p1z21"/>non lubenter audio de equitilus et adventu
					<lb xml:id="p1z22"/>spargebantur. Utcunque sit nunquam me et scripsisse
					<lb xml:id="p1z23"/>et priedicasse poenitelit Caesarianos variis abiglus
					<lb xml:id="p1z24"/>Hoc unum moliri, ut las inter nos committant. Cum
					<lb xml:id="p1z25"/>exempla praeteriti temporis, ut tu prudentissime
					<lb xml:id="p1z26"/>collegisti, id confirmavit tum ita multis festolus et
					<lb xml:id="p1z27"/>argumentis confirmatum habeo, ut dulitare
					<lb xml:id="p1z28"/>possim. Verle Curiae 4. decembrins
					<lb xml:id="p1z29"/>.
					<lb xml:id="p1z30"/>etc Benus.
					<pb/>
					<lb xml:id="p4z1"/>et optimo
					<lb xml:id="p4z2"/>d. Heynrico
					<lb xml:id="p4z3"/>ingero, amicoob.
					<lb xml:id="p4z4"/>Ultimae Bayoneusi
					<lb xml:id="p4z5"/>1554. de
					<lb xml:id="p4z6"/>cembri4.
				</p>
			</div>
