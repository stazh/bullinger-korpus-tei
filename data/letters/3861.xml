	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Eximio viro d. Petro
					<lb xml:id="p1z2"/>Martyri Tu drodoeo
					<lb xml:id="p1z3"/><placeName ref="l587">Tiguri</placeName>.
					<lb xml:id="p1z4"/>Literas, quas, vir praestantissime una cum literis d. Bulling
					<lb xml:id="p1z5"/>erireginae noestrae in manus ipse tradidi. quarum
					<lb xml:id="p1z6"/>dectione quantopere affecta sit testis est Caecilius,
					<lb xml:id="p1z7"/>lachrymas eius inter legendum obortas viderit
