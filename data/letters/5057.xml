	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuas, reverende pater, hodie accipio primum; <lb xml:id="p1z2"/>timeo autem nostros mercatores discessisse iam, <lb xml:id="p1z3"/>ideoque haec scribo, antequam d. <persName ref="p8111">Petri Martyris</persName> epistolam <lb xml:id="p1z4"/>legerim.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">De <placeName ref="l522">Venetis</placeName> certa habebimus in nostris <lb xml:id="p1z5"/>nundinis; expectatur etiam d. <persName ref="p8432">Fridericus a Salicibus</persName>, <lb xml:id="p1z6"/>qui mecum <placeName ref="l1103">Ilantii</placeName> fuit et recepit se ipsum scripturum; <lb xml:id="p1z7"/>iniunxit mihi, ut se tibi plurimum commendarem; <lb xml:id="p1z8"/>ego autem oblitus sum facere in tanta negotiorum <lb xml:id="p1z9"/>turba.</s>
					<s n="4" xml:lang="la">Tua tamen omnia, quae communicanda fuerunt, <lb xml:id="p1z10"/>fidelissime communicavi.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Caetera tua remittam <lb xml:id="p1z11"/>post 8 dies, si vixero; nunc novi nihil; appono <lb xml:id="p1z12"/>schedam, ut legas.</s>
				</p>
				<p>
					<s n="6" xml:lang="de">Der <persName>von Sax</persName> ist hye durch gefaren, <lb xml:id="p1z13"/>vermeint, dienst by den <placeName ref="l522">Venedigeren</placeName> ze erlangen; er zwyflet <lb xml:id="p1z14"/>aber nach; <foreign xml:lang="la">intra 8 aut 10 dies aderit denuo; tunc <lb xml:id="p1z15"/>omnia communicabit.</foreign></s>
					<s n="7" xml:lang="la" ana="farewell">Vale, reverende in Christo <lb xml:id="p1z16"/>pater.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l98">Curię</placeName> in die S. Martini anno 1561.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/>T[uus] <persName ref="p8009">Fab[ricius</persName>].</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro eruditione <lb xml:id="p2z2"/>et pietate excellenti d. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>antistiti vigilantissimo, <lb xml:id="p2z5"/>domino et patrono suo <lb xml:id="p2z6"/>semper honorando.</s>
				</p>
			</div>
		</body>
	</text>
