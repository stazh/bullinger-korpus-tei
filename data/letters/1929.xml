	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
					<s n="2" xml:lang="la"><persName ref="p714">Celius</persName> noster<note type="margin">a.R.: Wohl: <persName ref="p714">Celio Secondo Curione</persName>, kaum <persName ref="p8101">Lelio Sozzini</persName>.</note>, vir o<lb xml:id="p1z2"/>rnatissime, homo singulari eruditione et humanita<lb xml:id="p1z3"/>te pręditus et utriusque nostrum amicus, ne vacuus <lb xml:id="p1z4"/>meis ad te proficisceretur literis, has tibi dare placuit, <lb xml:id="p1z5"/>quibus ostenderem mihi tuam erga me benev<lb xml:id="p1z6"/>olentiam valde gratam esse, quam declaras tu eo, <lb xml:id="p1z7"/>quod nullos fere ad amicos, quos hic habes, literas <lb xml:id="p1z8"/>scribis, in quibus mei non amanter facias mentionem.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z9"/>Quod tuum de me testimonium ut a probato vi<lb xml:id="p1z10"/>ro profectum nisi magni faciam, et in te ingratus <lb xml:id="p1z11"/>sim valde et mihi iniquus.</s>
					<s n="4" xml:lang="la">Deinde, quoniam ęd<lb xml:id="p1z12"/>ita <lb xml:id="p1z13"/>est a <persName ref="p458">Brentio</persName> nuper scriptio quędam<note type="margin">a.R.: ediert 1553 (Köhler, Bibliogr. <persName ref="p458">Brentiana</persName>, Nr. 235, 234-237)</note>, in qua is <persName ref="p2301">Osiandrum</persName> <lb xml:id="p1z14"/>cum <placeName ref="l2562">Prussię</placeName> et <placeName ref="l749">Saxonię</placeName> theologis conciliare studet, <lb xml:id="p1z15"/>volui tibi significare te mihi gratum facturum, si <lb xml:id="p1z16"/>me, ut <persName ref="p458">Brentii</persName> studium tibi probetur, certiorem reddas; <lb xml:id="p1z17"/>nam ab initio statim visi sunt illi mihi ve<lb xml:id="p1z18"/>rius <foreign xml:lang="el">λογομαχεῖν</foreign> quam <foreign xml:lang="el">πραγματομαχεῖv</foreign>.</s>
					<s n="5" xml:lang="la" ana="farewell"><lb xml:id="p1z19"/>Tu vale, vir clarissime, et <persName ref="p714">Celium</persName> nostrum commen<lb xml:id="p1z20"/>datum habeto.</s>
					<s n="6" xml:lang="la" ana="salute">Omnes tuos salvere iubeo.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z21"/>17. iulii.</s>
				</p>
				<p>
