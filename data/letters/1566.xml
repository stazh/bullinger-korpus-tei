	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non mihi occurrit modo necessaria aliqua scribendi materia.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Silent modo omnia.</s>
					<s n="4" xml:lang="la">Ex <placeName ref="l832">Gallia</placeName> nihil habeo, nisi quod magna omnium <lb xml:id="p1z3"/>rerum illic fertur esse caritas, metuuntque simul omnes, ne maior <lb xml:id="p1z4"/>per bellicos illos tumultus sit futura.</s>
					<s n="5" xml:lang="la">Expecto, quid tu nobis <lb xml:id="p1z5"/>des novi de <placeName ref="l1107">Tridento</placeName>, item de <persName ref="p18250">Mauritio</persName>, an verum sit, quod fertur <lb xml:id="p1z6"/>ad Cęsarem esse profectus, item quid cum <placeName ref="l303">Magdeburgensi</placeName> <placeName ref="l587">Tiguri</placeName> sit <lb xml:id="p1z7"/>actum, quid tibi videatur de illis etc.</s>
					<s n="6" xml:lang="la">Audio etiam de quibusdam insidiis tibi <lb xml:id="p1z8"/>et d. <persName ref="p8011">Gvalthero</persName> paratis; nihil tamen certi expiscari possum<note type="margin">a.R.: possim?</note>; <lb xml:id="p1z9"/>alias te admonerem; si quid est, fac, quęso, me certiorem.</s>
					<s n="7" xml:lang="la">De <persName ref="p8055">Blaurero</persName> <lb xml:id="p1z10"/>fertur etiam, quod <placeName ref="l49">Bielnis</placeName> <placeName ref="l257">Constantiensem</placeName> instituerit disciplinam, publicam <lb xml:id="p1z11"/>poenitentiam et mulctam quandam pecuniariam, si non de singulis <lb xml:id="p1z12"/>familiis singulis concionibus singulę intersint personę.</s>
					<s n="8" xml:lang="la">Metuo, ne <lb xml:id="p1z13"/>quid nimis; non sic lego Christum vel apostolos fecisse.</s>
					<s n="9" xml:lang="la">Tanto maior <lb xml:id="p1z14"/>erit hypocrisis, quę tandem erumpit, sicut <placeName>Constantię</placeName> factum esse videmus.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/>Necdum tamen probe de his omnibus instructus sum; ubi fuero, significabo tibi.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z16"/>Has literas, quęso, primo quoque tempore ad d. <persName ref="p3375">Vergerium</persName> mittas; expectare <lb xml:id="p1z17"/>eum eas anxie sat scio.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale.</s>
					<s n="13" xml:lang="la" ana="salute">Salutat te <persName ref="p8417">Musuculus</persName><note type="margin">a.R.: klein geschr.!</note> cum suis <lb xml:id="p1z18"/>omnibus; familia item mea tibi tuisque omnibus salutem multam <lb xml:id="p1z19"/>dicit, quos ex me quoque salutabis.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Pestis hic recrudescit aliquantum.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z20"/><placeName ref="l41">Bernae</placeName> 11. februarii 1552.</s>
				</p>
				<p>
					<note type="signature">[Unterschrift fehlt.]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ec<lb xml:id="p2z4"/>clesiae pastori fideliss<lb xml:id="p2z5"/>imo, domino et compatri <lb xml:id="p2z6"/>unice colendo.</s>
				</p>
				<p>
					<s n="17" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zürich</placeName>.</s>
					<s n="18" xml:lang="de">M. <lb xml:id="p2z8"/><persName ref="p495">Heinrych Bul<lb xml:id="p2z9"/>linger</persName>n.</s>
				</p>
			</div>
		</body>
