	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p18538">Caesar</persName> voluit pacem, sed rex repudiavit; nam est <lb xml:id="p1z2"/>fraudulentia et in preiudicium totius reipublicae christianae <lb xml:id="p1z3"/>et praecipue <placeName ref="l822">Germanię</placeName>.</s>
					<s n="2" xml:lang="la">Vix credas, qualia <lb xml:id="p1z4"/>federa velit cum rege inire, ut ceteros <lb xml:id="p1z5"/>omnes possit iugulare, perdere et tanquam <lb xml:id="p1z6"/><persName ref="p18508">Herodes</persName> genus humanum, si fieri posset, <lb xml:id="p1z7"/>secum extinguere.</s>
					<s n="3" xml:lang="la">Ergo melius est <lb xml:id="p1z8"/>bellum trahi; nam interea dominus <lb xml:id="p1z9"/>meliora dabit tempora, quod <lb xml:id="p1z10"/>rex, qui sane optima cogitat, statuit cum <lb xml:id="p1z11"/>auxilio sociorum facere.</s>
					<s n="4" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Domino <persName ref="p495">Bulingero</persName></s>
				</p>
			</div>
		</body>
	</text>
