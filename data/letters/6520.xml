	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Dolui supra modum, gavisus sum supra modum, quod aegrota<lb xml:id="p1z2"/>veris, quod et convalueris.</s>
					<s n="2" xml:lang="la">Scribis te in meis literis d. <persName ref="p8391">Iuello</persName> <lb xml:id="p1z3"/>inscriptas inclusisse et petis, ut earum exmplum adhoc usque <lb xml:id="p1z4"/>signum describi curem et mittam d. <persName ref="p8085">Horno</persName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Certe, mi <lb xml:id="p1z5"/>Bullinere, ego <persName ref="p8391">Iuelli</persName> literas non vidi.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Quare nec tibi nec <persName ref="p8085">Horni</persName> <lb xml:id="p1z6"/>expectationi satisfacere potui; sed <persName ref="p6">Abelus</persName> meis apertis illa <lb xml:id="p1z7"/><persName ref="p8391">Iuello</persName> <placeName ref="l296">Londini</placeName> tradidit; promisit is Abelo se exemplum quamprimum <lb xml:id="p1z8"/>ad me missurum "Pollicitis dives quilibet esse potest".</s>
					<s n="5" xml:lang="la">Pollicitus <lb xml:id="p1z9"/>est, at nihil praeterea; sic et te et me et <persName ref="p8085">Hornum</persName> defraudavit.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>At ego hoc imputo infinitis negotiis, quibus ille distringitur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>Veniam petis, quod hoc oneris mihi imposueris: ego non onus, <lb xml:id="p1z12"/>sed honorem aestimo, si quacunque occasione <persName ref="p495">Bullingero</persName> inservire possim.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Cum Germanica tua meae uxori legerem, mentione facta obitus <lb xml:id="p1z14"/>uxoris et filiae tuae statim in acerbissimas erupit lachrymas, <lb xml:id="p1z16"/>ita coactus tum aliquamdiu a legendo desistere, cum illa auscultando aures <lb xml:id="p1z17"/>non praeberet.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><persName ref="p18212">Regina Scotiae</persName> 1. augusti nupsit <persName>Henrico</persName> domino Darley, <lb xml:id="p1z18"/>primogenito comitis <placeName>Lenex</placeName>.</s>
					<s n="10" xml:lang="la">Huic novo coniugio minime favent <lb xml:id="p1z19"/>proceres aliquot in <placeName ref="l2524">Scotia</placeName>; quis erit exitus, dubitamus adhuc.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/>Certe evangelium illic radices egit firmissimas.</s>
					<s n="12" xml:lang="la">Fama erat <lb xml:id="p1z21"/>non ita pridem nostram reginam duci <placeName ref="l850">Austriae</placeName> nupturam.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Quid fu<lb xml:id="p1z22"/>turum sit, equidem ignoro; cum cognovero, te certiorem reddam.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z23"/>Expecto doctissimas tuas homilias in <persName>Danielem</persName>.</s>
					<s n="15" xml:lang="la" ana="farewell">Bene vale, <lb xml:id="p1z24"/>optime <persName ref="p495">Bullingere</persName>, cum tuis omnibus, quos salvos esse cupio.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z25"/>Dominus <placeName ref="l587">Tigurinos</placeName> omnes servet a malo.</s>
					<s n="17" xml:lang="la">Amen.</s>
					<s n="18" xml:lang="la">Raptim <placeName ref="l299">Ludhamiae</placeName>, <lb xml:id="p1z26"/>18. augusti 1565.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute">Mea teque tuosque salutat.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z27"/>Tuus ex animo <persName ref="p2473">Ioannes <lb xml:id="p1z28"/>Parkhurstus</persName>, <placeName ref="l352">Nordovicensis</placeName><lb xml:id="p1z30"/>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>viro clarissimo.</s>
					<s n="22" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tigu<lb xml:id="p2z4"/>r<lb xml:id="p2z5"/>i</placeName><lb xml:id="p2z11"/>.</s>
				</p>
			</div>
		</body>
	</text>
