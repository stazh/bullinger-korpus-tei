			<zone xml:id="p2z3-0" points="2411,1112 2528,1129 2856,1085 3062,1128 3139,1115 3141,1034 3116,1027 2709,1054 2637,1020 2519,1063 2413,1061">2421,1097 2457,1092 2493,1090 2529,1087 2566,1085 2602,1085 2638,1085 2674,1084 2711,1081 2747,1079 2783,1082 2819,1082 2856,1082 2892,1081 2928,1079 2964,1082 3001,1082 3037,1082 3073,1081 3109,1080 3146,1082</zone>
