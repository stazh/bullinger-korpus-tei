	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><persName ref="p1365">Grynęi</persName> literas<note xml:id="fn1" type="footnote" n="1">HBBWX, <ref target="file11484">Nr. 1441</ref>.</note> misissem pridem, si occurrisset tabellio; nam ante <lb xml:id="p1z2"/>dies octo venerunt ad nos.</s>
					<s n="3" xml:lang="la">Quamobrem aequi consulito, quod <lb xml:id="p1z3"/>eas tam longe post datum accipis; nemo minus est in culpa <lb xml:id="p1z4"/>quam ego.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">De vestris, quos ad nos misistis studiorum gratia, nescio, quid <lb xml:id="p1z5"/>scribendum.</s>
					<s n="5" xml:lang="la">Postquam duo a me discesserunt,<note xml:id="fn2" type="footnote" n="2"><persName ref="p6755">Konrad Suter</persName> und <persName ref="p8383">Christian Wirth</persName> hatten nur kurze Zeit bei <persName ref="p8418">Myconius</persName> gewohnt; vgl. <bibl source="b12">HBBW X</bibl> <ref target="file11469">[Nr. 1426]</ref>, S. 174, 4-16.</note> <persName ref="p6755">Chuͦnhartum</persName> non <lb xml:id="p1z6"/>multo post amisimus, <persName ref="p8383">Christianum</persName> his diebus, nisi sit in patria, <lb xml:id="p1z7"/>quod ex <persName ref="p8428">Rhellicano</persName><note xml:id="fn3" type="footnote" ana="bio" n="3"><persName ref="p8428">Rhellikan</persName> war mit der Familie <persName ref="p8383">Wirth</persName> verschwägert; vgl. <bibl source="b9">HBBW VII</bibl> <ref target="file11074">[Nr. 1032]</ref>, S. 220, 17f.</note> facile intelliges.</s>
					<s n="6" xml:lang="la"><persName ref="p2811">Christophorus</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p2811">Christoph Rotacher</persName>.</note> adhuc <lb xml:id="p1z8"/>perdurat apud me, iuvenis, quantum novi, non malus.</s>
					<s n="7" xml:lang="la">Hęc <lb xml:id="p1z9"/>ideo, ne quid in nobis, quibus eos commendastis, desiderari possit.<pb type="edition" next="32"/></s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z10"/>Vale semper in domino cum tuis et fratribus.</s>
					<s n="9" xml:lang="la"><placeName ref="l28">Basileę</placeName>, 7. ianuarii an<lb xml:id="p1z11"/>no 1541.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z12"/><persName ref="p8418">Os. Myconius</persName> <lb xml:id="p1z13"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>in domino suo.</s>
					<s n="12" xml:lang="de"><placeName ref="l587">Zü[ric]h</placeName><note xml:id="fna" type="footnote" n="a"><hi>Teilweise auf das nicht mehr vorhandene Verschlussband geschrieben.</hi></note>.</s>
				</p>
			</div>
		</body>
	</text>
