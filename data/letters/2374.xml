	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Redditae sunt mihi literae tuae, domine
					<lb xml:id="p1z2"/>colendissime et frater charissime, quas 22. iulii script
					<lb xml:id="p1z3"/>Quoniam vero in iis nihil est, ad quod
					<lb xml:id="p1z4"/>magnopere referat respondere, paucis tibi
					<lb xml:id="p1z5"/>significo vos per dei gratiam sic satis recte
					<lb xml:id="p1z6"/>cudere. Gratulor et tibi de sanitate restiuert,
					<lb xml:id="p1z7"/>quam dominus tibi velit diu esse incolumem
					<lb xml:id="p1z8"/>Quae hic agamus et quo res nostrae habeant refcent.
					<lb xml:id="p1z9"/>tibi hic Fabritius noster vir pius et doctinem
					<lb xml:id="p1z10"/>nois charissime, quem etiam tibi commendavis
					<lb xml:id="p1z11"/>vivae epistolae loco offerimus
					<lb xml:id="p1z12"/>atm est, sed infeliciter, quod
					<lb xml:id="p1z13"/>In Italia priu
					<lb xml:id="p1z14"/>Galli partes attinet; Dum enim equitatus fe
					<lb xml:id="p1z15"/>fellit et Italica legio mala fide usu est
					<lb xml:id="p1z16"/>Rheti nostri et Germani, qui militarunt
					<lb xml:id="p1z17"/>duce Reckeuradt caesi sunt. Ceciderunt
					<lb xml:id="p1z18"/>omnes duces Rhetorum (exceptis duobus) cum omnibus
					<lb xml:id="p1z19"/>priemoribus; caesi sunt milites circiter 200, rliqui
					<lb xml:id="p1z20"/>qui evaserunt, capti sunt circiter 450, sed
					<lb xml:id="p1z21"/>rursus benigne divissi. In Germanos dicitur
					<lb xml:id="p1z22"/>sevitum atrocitur. Strozius et reliqui procere
					<lb xml:id="p1z23"/>i fuga consuluerunt, iam novum colligunt exere,
					<lb xml:id="p1z24"/>senarum urbs intrepide obsidentibus se
					<lb xml:id="p1z25"/>Pugnatum est et in
					<lb xml:id="p1z26"/>obiicit et repugnat.
					<lb xml:id="p1z27"/>Picardia ad urbem Rantii. Vicit Gallus, clado
					<lb xml:id="p1z28"/>affectus est caesare exercitus. Cecidisse dicuntur
					<lb xml:id="p1z29"/>circiter 3000, quorum maxima pars Hispanorum
					<lb xml:id="p1z30"/>27 signa ex ea pugna ad regem Gallorum pervener
					<lb xml:id="p1z31"/>et bonibordę maiores 8. Privarii vir
					<lb xml:id="p1z32"/>ex aula Caesare et proceribus Hispanis partim cap.
					<lb xml:id="p1z33"/>partim sunt caesi.
					<lb xml:id="p1z34"/>Dominus ita vindicat sanguinem, qui effunditur ab
					<lb xml:id="p1z35"/>istis monarchis propter evangelium Iesu Christi. Domin
					<lb xml:id="p1z36"/>aperiat oculos.
					<lb xml:id="p1z37"/>et pacem concedat, Venias
					<lb xml:id="p1z38"/>et liberet a malo. Vive et vale 27.
					<lb xml:id="p1z39"/>augusti anno 1554. Salvi sunt vira
					<lb xml:id="p1z40"/>omnes.
					<lb xml:id="p1z41"/>Bullingerus tuus.
					<pb/>
					<lb xml:id="p2z1"/>Praestantissimo viro d. Matri
					<lb xml:id="p2z2"/>hiaeErbio antistiti
					<lb xml:id="p2z3"/>vigilantissimo Rychevil
					<lb xml:id="p2z4"/>aae ecclesiae domino suoco
					<lb xml:id="p2z5"/>doet fratri colendissimo
					<lb xml:id="p2z6"/>rychenwylr.
				</p>
