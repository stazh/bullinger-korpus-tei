	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z5"/><persName ref="p8093">Hercules a Salicibus</persName> ludo literario <placeName ref="l587">Tigurino</placeName> praefectis S. P. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z6"/><persName ref="p2336">Bernardinus</persName> <placeName ref="l3652">Pesclaviensis</placeName>, qui ministerium evangelicum in <lb xml:id="p1z7"/>montano quodam viculo paupere quidem illo nunc exercet, <lb xml:id="p1z8"/>ad me venit mihique indicavit se suis e liberis unum <lb xml:id="p1z9"/>adduxisse <placeName ref="l587">Tigurum</placeName> eo nomine, ut et ad pietatem christia<lb xml:id="p1z10"/>nam et ad bonas literas instituatur.</s>
					<s n="3" xml:lang="la">Sed enim quum nequeat <lb xml:id="p1z11"/>pauperie nimirum premente sumptus ad alendum puerum, <lb xml:id="p1z12"/>ut par erat, exhibere, institit me orare, ut per literas eum <lb xml:id="p1z13"/>puerum vobis commendarem, quibus a vestro senatu c<lb xml:id="p1z14"/>urandorum huiusmodi parvulorum commissum est <lb xml:id="p1z15"/>munus.</s>
					<s n="4" xml:lang="la">Ego vero, qui hominem quidem hunc et probum <lb xml:id="p1z16"/>et pauperem novi, iustis ipsius petitionibus deesse nolui.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z17"/>Quamobrem vobis illum sic etiam atque etiam commendo, <lb xml:id="p1z18"/>ut pro ea, quae in vobis est, charitate hac in re ita iuvetis, <lb xml:id="p1z19"/>ut per vos eius puer ad optimam frugem perveniat, <lb xml:id="p1z20"/>quo deinde possit ecclesiae dei aliqua in parte <lb xml:id="p1z21"/>utilis inservire.</s>
					<s n="6" xml:lang="la" ana="farewell">Valete in domino.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l93">Clavennę</placeName> <lb xml:id="p1z22"/>24. aprilis 1561.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimis ac prudentissimis viris <lb xml:id="p4z2"/>ludo literario <placeName ref="l587">Tigurino</placeName> praefectis, dominis [col<lb xml:id="p4z3"/>end]issimis.</s>
					<s n="9" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
