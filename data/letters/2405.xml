	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. Hodie discessit hinc <persName>Löffelpergerus</persName>, per quem <lb xml:id="p1z2"/>fasciculum literarum ad te misi, quamvis tibi <lb xml:id="p1z3"/>ipse non scripserim; expectabam enim tuum respon<lb xml:id="p1z4"/>sum, quod mihi modo<note type="margin">a.R.:nunc</note> paucis horis post illius <lb xml:id="p1z5"/>abitum allatum est.</s>
					<s n="2" xml:lang="la">Festinat nuncius.</s>
					<s n="3" xml:lang="la">Ideo de <lb xml:id="p1z6"/><placeName ref="l294">Locarnensi</placeName> causa nihil possum respondere; nescio, quid <lb xml:id="p1z7"/>hodie sit decretum.</s>
					<s n="4" xml:lang="la">Ego semper in hoc incumbo, <lb xml:id="p1z8"/>ne nostri se segregent a reliquis.</s>
					<s n="5" xml:lang="la">Faciant <lb xml:id="p1z9"/>idem vestri in causa bona.</s>
					<s n="6" xml:lang="la">Putant nostri iniquum <lb xml:id="p1z10"/>esse, <foreign xml:lang="de">wenn si irs glaubens gnoßen söltind hälffen <lb xml:id="p1z11"/>nach dem landfriden straffen,</foreign> et certe iniquum <lb xml:id="p1z12"/>esset, si se res ita haberent.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Quod <placeName ref="l167">Genevenses</placeName> <lb xml:id="p1z14"/>concernit, nihil audio de eo, de quo scribis, dissidio, <lb xml:id="p1z15"/>neque inter nostros quemquam novi, qui <persName ref="p540">Calvinum</persName> <lb xml:id="p1z16"/>haereseos accuset.</s>
					<s n="8" xml:lang="la">Est quidem quibusdam <lb xml:id="p1z18"/>nostratibus invisus satis <persName ref="p540">Calvinus</persName>, quia videtur <lb xml:id="p1z19"/>ipsis nimium <foreign xml:lang="el">πολυπραγμονεῖν</foreign>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Quantum tamen in nobis <lb xml:id="p1z20"/>est, damus operam, ut ferociam eorum frangamus et miti<lb xml:id="p1z21"/>gemus et modestius eos de tantis viris sent<lb xml:id="p1z22"/>ire doceamus.</s>
					<s n="10" xml:lang="la">Haeret quidem <placeName>Tononii</placeName> adhuc <lb xml:id="p1z23"/><persName>Hieronymus</persName> ille, sed in nulla est authoritate.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/><persName>Franciscus Sampaulinus</persName> <persName>Viviaci</persName> satis tranquille <lb xml:id="p1z25"/>agit cum classis suę fratribus; det dominus, ut <lb xml:id="p1z26"/>ita pergant!</s>
					<s n="12" xml:lang="la">Sunt <placeName ref="l167">Genevę</placeName> peregrinorum aliquot <lb xml:id="p1z27"/>millia, unde fieri non potest, quin variae tractentur <lb xml:id="p1z28"/>inter ipsos quaestiones; confluunt enim ex variis regionibus <lb xml:id="p1z29"/>varie instituti et affecti.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Haec ad tuas.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z30"/>Alias nihil habeo, quod scribam modo, nisi quod <lb xml:id="p1z31"/><persName ref="p3241">Trempii</persName> uxor praeteritis diebus placide ad dominum <lb xml:id="p1z32"/>migravit.</s>
					<s n="15" xml:lang="la">Opus habet ipse consolatione, sicut proxime <lb xml:id="p1z33"/><persName ref="p4091">Zvinglio</persName> tuo simul et meo scripsi.</s>
					<s n="16" xml:lang="la">Praeter enim <lb xml:id="p1z34"/>alias calamitates nunc illa quoque accedit, quod <lb xml:id="p1z35"/>coniugis destituitur solatio.</s>
					<s n="17" xml:lang="la">Bene feceris ergo, <lb xml:id="p1z36"/>si ipsum per literas fueris consolatus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><persName ref="p6386">Schalleri</persName> <lb xml:id="p1z37"/>negotium, cui perplexus inhaeret, nondum est explicatum <lb xml:id="p1z38"/>et tanto gravius ipsum premit, quod, praeterquam <lb xml:id="p1z39"/>quod magnam rerum cogitur facere iacturam, nullum <lb xml:id="p1z40"/>adhuc finem aut exitum rei cernere possit.</s>
					<s n="19" xml:lang="la" ana="salute">Salutat <lb xml:id="p1z41"/>te vicissim <persName ref="p8417">Musculus</persName> et <lb xml:id="p1z42"/>nostri omnes; salvi sint <persName ref="p8011">Gvaltherus</persName>, <lb xml:id="p1z43"/><persName ref="p8127">Pellicanus</persName> et generi tui omnes una cum familiis vestri<lb xml:id="p1z44"/>s.</s>
					<s n="20" xml:lang="de"><placeName ref="l41">Bernę</placeName> 26. septembris 1554.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z45"/>Tuus <persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori <lb xml:id="p2z4"/>fidelissimo, domino et compatri <lb xml:id="p2z5"/>suo et colendissimo et <lb xml:id="p2z6"/>charissimo.</s>
				</p>
				<p>
					<s n="23" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zürich</placeName>.</s>
					<s n="24" xml:lang="de">M. <persName ref="p495">Hein<lb xml:id="p2z8"/>rych Bullingeren</persName><lb xml:id="p2z9"/>.</s>
				</p>
