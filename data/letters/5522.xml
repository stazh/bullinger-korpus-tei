	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p714">C[oelius] S[ecundus] C[urio]</persName> per Christum Iesum S. P. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Scripsi ad te proxime, vir clarissime et domine <lb xml:id="p1z4"/>colendissime, qua de re, ipse nosti; scripsi autem <lb xml:id="p1z5"/>tanquam ad amicum, ad fratrem et virum <lb xml:id="p1z6"/>prudentem nec opinione falli arbitror; <lb xml:id="p1z7"/>tamen videor aliquid hic subolfacere et vereor, <lb xml:id="p1z8"/>ne quo pacto, citra tamen tuam culpam, <lb xml:id="p1z9"/>ea res ad istorum aures pervenerit.</s>
					<s n="3" xml:lang="la">Quare <lb xml:id="p1z10"/>cogor suspenso animo esse, donec abs te <lb xml:id="p1z11"/>mihi hic scrupulus eximatur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Oro igitur te, <lb xml:id="p1z12"/>mi optime domine et frater, ut quam primum <lb xml:id="p1z13"/>ad me scribas, an existimes istinc ad hos <lb xml:id="p1z14"/>manare potuisse a me ea de re ad te scriptum <lb xml:id="p1z15"/>fuisse.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Existimavi quidem te cum fratrib<lb xml:id="p1z16"/>us istic ea de re aliquid acturum, sed meo no<lb xml:id="p1z17"/>mine suppresso, ne in istorum odia incurrerem; <lb xml:id="p1z18"/>ipse namque, quam sint irritabiles atque implacabiles, <lb xml:id="p1z19"/>optime nosti.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale cum tuis omnibus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Andoverpi<lb xml:id="p1z20"/>a huc ad nostros negotiatores scriptum est <lb xml:id="p1z21"/>triginta naves, in quibus et milites et stipendia <lb xml:id="p1z22"/>erant, quae ex <placeName ref="l875">Hispania</placeName> <placeName ref="l1176">Massiliam</placeName> cursu tendebant, <lb xml:id="p1z23"/>tempestate periisse, item naves octo, quibus ex <lb xml:id="p1z24"/><placeName ref="l2898">novis Indiis</placeName> in <placeName ref="l875">Hispaniam</placeName> aurum vehebatur, <lb xml:id="p1z25"/>et ipsas in Oceano submersas.</s>
				</p>
				<p>
					<note>[Schluss abgeschnitten.]</note>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo atque optimo <lb xml:id="p2z2"/>viro domino <persName ref="p495">Henricho <lb xml:id="p2z3"/>[Bu]llingero</persName>, ecclesiae <lb xml:id="p2z4"/><placeName ref="l587">[Ti]gurinae</placeName> antistiti <lb xml:id="p2z5"/>vigilantissimo, domino suo <lb xml:id="p2z6"/>colendissimo.</s>
					<s n="9" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
