	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuas accepi, pro quibus maximas gratias <lb xml:id="p1z2"/>ago.</s>
					<s n="3" xml:lang="la">Isti Caesariani iactant suas <lb xml:id="p1z3"/>victorias in <placeName ref="l834">Italia</placeName> miris modis <lb xml:id="p1z4"/>et veritati omnino parcunt; audiant eti<lb xml:id="p1z5"/>am, quid in <placeName ref="l2589">Picardia</placeName> actum sit.</s>
					<s n="4" xml:lang="la">Sed <lb xml:id="p1z6"/>de illis omnibus taceo; nam ex iis, que <lb xml:id="p1z7"/>dominis scribo, satis percipies etc.</s>
					<s n="5" xml:lang="la">Vere <lb xml:id="p1z8"/>mire sunt practice istius <lb xml:id="p1z9"/><persName>Bolvilleri</persName>, sed crumena vacua.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>De matrimonio <placeName ref="l830">Anglicano</placeName> dubium <lb xml:id="p1z11"/>non est, cui tamen tacite tota <lb xml:id="p1z13"/><placeName ref="l830">Anglia</placeName> adversatur, nec pote<lb xml:id="p1z14"/>st fieri, ut ist <placeName ref="l875">Hispanus</placeName> diu illic <lb xml:id="p1z15"/>delitescat.</s>
					<s n="7" xml:lang="la">Caesar vocabat <lb xml:id="p1z16"/>ad se <placeName ref="l1041">Brunsvicensem</placeName>, sed remoratus es<lb xml:id="p1z17"/>t a principib<lb xml:id="p1z18"/>us ligę <placeName ref="l2459">Rhenensis</placeName>, qui iam <lb xml:id="p1z19"/><placeName ref="l569">Wormatię</placeName> sunt vel potius <lb xml:id="p1z20"/>propter <lb xml:id="p1z21"/>defectum pecuniarum; nam Caes<lb xml:id="p1z22"/>ar <lb xml:id="p1z23"/>verba tantum dabat, et <lb xml:id="p1z24"/>isti milites <lb xml:id="p1z25"/><placeName ref="l822">Germani</placeName> norunt <lb xml:id="p1z26"/>suas <lb xml:id="p1z27"/>artes.</s>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z28"/>Saluto dominum consule<lb xml:id="p1z30"/>m <lb xml:id="p1z31"/><persName ref="p1419">Habium</persName> et te unice.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Vale.</s>
					<s n="10" xml:lang="la">Ex <placeName ref="l760">Soluturo</placeName> <lb xml:id="p1z32"/>raptim 24. augusti.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Tuus semper <persName ref="p8296">Bass[afon<lb xml:id="p1z33"/>taneus]</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
