	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Salutem ab eo, qui omnium salus est
					<lb xml:id="p1z2"/>Literas tuas, reu vir d. et frater observande,no
					<lb xml:id="p1z3"/>cum libello longe gratissimo, per manus ornatim
					<lb xml:id="p1z4"/>iuvenis, Ioannes Comandri Rhei accepi, qui ea
					<lb xml:id="p1z5"/>ad me Schopfium usque detulit. Ego vero
					<lb xml:id="p1z6"/>non solum tibi pro officio scribendi et denato muneni
					<lb xml:id="p1z7"/>maximas quas ago, verum etiam vobis singuli
					<lb xml:id="p1z8"/>reverndis parentibus praeceptoribus atque fratribs
					<lb xml:id="p1z9"/>pro pia vestria atque adeo paterna de me solici
					<lb xml:id="p1z10"/>Utinam ut meam erga nos observanti
					<lb xml:id="p1z11"/>ipsa, ut animo eam concipio, appropare nobis
					<lb xml:id="p1z12"/>possem. Caeterum quod  seu poti
					<lb xml:id="p1z13"/>illam attinee, quam literarum
					<lb xml:id="p1z14"/>perfida inspectio nobis popenit, quid de ea mihi
					<lb xml:id="p1z15"/>videatur ad ornatissimu virum, d. Wolfium, qui
					<lb xml:id="p1z16"/>nominatim me monuit, scripsi. Utur enim
					<lb xml:id="p1z17"/>smati incommodi rationem nullam habeam.
					<lb xml:id="p1z18"/>tamen ne meipsum ecclesia, cui subservio quodam
					<lb xml:id="p1z19"/>eqiam et alios mihi addigtiores mecum
					<lb xml:id="p1z20"/>periculo involvam vel saltem in tuenda veritati
					<lb xml:id="p1z21"/>languidiones reddam, nihil nobis hic tentandem
					<lb xml:id="p1z22"/>sed potius ocum propter eum, qui nullam non ignor,
					<lb xml:id="p1z23"/>imammihi causa sabire paratus fuit, devorunda
					<lb xml:id="p1z24"/>nequaguam.
					<lb xml:id="p1z25"/>eIllius iudicium interea  ffugient, quo
					<lb xml:id="p1z26"/>nonnisi vanitate et folis ruinosam suam caussa
					<lb xml:id="p1z27"/>suffulare sudent. Si vero colendus mishi praecept
					<lb xml:id="p1z28"/>d. Gvaltherus non gravaretur peroccasim
					<lb xml:id="p1z29"/>et quasi aliud agens me d. praesidu
					<lb xml:id="p1z30"/>d commendare, nihil gratius mihi contingeri
					<lb xml:id="p1z31"/>posse, sic tamen ne intelligar me monitore
					<lb xml:id="p1z32"/>hoc factum esse; Cum enim alioquin mihi faver
					<pb/>
					<lb xml:id="p2z1"/>hoc ipsum nuper liberaliter testatus sit, cum filiolam
					<lb xml:id="p2z2"/>primogenitam ex baptismo suscepisset, forte suspius
					<lb xml:id="p2z3"/>posset me e ipsius fide amligere vel potius
					<lb xml:id="p2z4"/>ipsius bonitate velle abuti. Posser tamen illa
					<lb xml:id="p2z5"/>commendatio d. Galthe mihi in posterum munitae
					<lb xml:id="p2z6"/>entum esse haud facile expugnatu, cum nesc
					<lb xml:id="p2z7"/>quas ignes hom iste in sinu suo fovear, qui
