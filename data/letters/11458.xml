	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Si in dies magis ac magis revalescis, gaudeo.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Ecce, re<lb xml:id="p1z2"/>mitto vobis <persName ref="p8459">Ottonem</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8459">Otto Werdmüller</persName>.</note> (nam rogatu parentum<note xml:id="fn2" type="footnote" ana="bio" n="2"><persName ref="p7018">Heinrich Werdmüller</persName> und <persName ref="p7014">Anna Schmid</persName> (<persName ref="p8459">Ottos</persName> Stiefmutter); vgl. Leo <hi>Weisz,</hi> Die Werdmüller. Schicksale eines alten Zürcher Geschlechtes, Zürich 1949, Bd. I, S. 13f; Bd. III, Stammtafel 2.</note> e <placeName ref="l832">Gallia</placeName> revocavi<note xml:id="fn3" type="footnote" n="3">Diesbezügliche Briefe an bzw. von <persName ref="p8418">Myconius</persName> sind nicht erhalten.</note>).</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z3"/>Iuvenis est pius et doctus, et qualem (verbo <lb xml:id="p1z4"/>sit venia) <placeName ref="l587">Tigurum</placeName> hactenus non<pb type="edition" next="150"/> fovit.</s>
					<s n="5" xml:lang="la">Hoc testimoni<lb xml:id="p1z5"/>um non ego solus, sed docti viri tribuunt.</s>
					<s n="6" xml:lang="la">Ergo si recte fueritis <lb xml:id="p1z6"/>ipso usi, gaudebit olim non tam schola vestra quam<note xml:id="fna" type="footnote" n="a">quam <hi>für gestrichenes</hi> sed et <hi>am Rande nachgetragen.</hi></note> <lb xml:id="p1z7"/>civitas tota.</s>
					<s n="7" xml:lang="la">Habetis scholam egregiam et cui nihil vi<lb xml:id="p1z8"/>detur deesse, verum si<note xml:id="fnb" type="footnote" n="b">si <hi>nachträglich eingefügt.</hi></note> adieceritis dialecticen<note xml:id="fn4" type="footnote" n="4">Bereits seit <persName ref="p4091">Zwinglis</persName> Zeit wurde Dialektik durch den Latein-Professor <persName ref="p167">Johann Jakob Ammann</persName> unterrichtet; s. Ulrich <hi>Ernst,</hi> Geschichte des Zürcherischen Schulwesens bis gegen das Ende des sechzehnten Jahrhunderts, Winterthur 1879, S. 57.</note> et mathem<lb xml:id="p1z9"/>ata, quibus recte praeerit <persName ref="p8459">Otto</persName>, minus deerit<note xml:id="fn5" type="footnote" n="5"><persName ref="p8459">Werdmüller</persName> versah zunächst allein, von 1541 bis 1546 zusammen mit <persName ref="p1283">Konrad Geßner</persName> (und 1541/42 mit <persName ref="p8465">Melchior Wirz</persName>) die neugeschaffene "professio physices", die Philosophie und Naturgeschichte, Mathematik und Ethik umfaßte; s. Bernhard <hi>Milt,</hi> <placeName ref="l587">Zürichs</placeName> Vergangenheit in Naturwissenschaft und Medizin (Mittelalter und 16. Jahrhundert), in: <persName ref="p1283">Gesnerus</persName> 4, 1947, S. 33-36.</note>.</s>
					<s n="8" xml:lang="la">Artificem <lb xml:id="p1z10"/>hic praestabit; nam non solum illas artes tradere, sed etiam <lb xml:id="p1z11"/>exercere novit.</s>
					<s n="9" xml:lang="la">Qua quidem re si quid possit<note xml:id="fnc" type="footnote" n="c"><hi>vor</hi> possit <hi>ein gestrichenes, unlesbares Wort.</hi></note> magis <lb xml:id="p1z12"/>prodesse adulescentię, praesertim hac tempestate, non <lb xml:id="p1z13"/>video (de humanis disciplinis loquor).</s>
					<s n="10" xml:lang="la">Excipite igitur <lb xml:id="p1z14"/><persName ref="p8459">Ottonem</persName> et sustinete, quemadmodum dignus<note xml:id="fnd" type="footnote" n="d">dignus <hi>am Rande nachgetragen.</hi></note> est, et nunquam vos <lb xml:id="p1z15"/>poenitebit.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Cum <persName ref="p7678">Rudberto a Mosham</persName> egerunt <placeName ref="l491">Argentinenses</placeName><note xml:id="fn6" type="footnote" ana="bio" n="6">Mitte August verhandelte <persName ref="p7678">Mosham</persName> erfolglos mit <placeName ref="l491">Straßburger</placeName> Gelehrten und Ratsherren; s. <bibl source="b519">QGT</bibl> XV 420-424. 427f.</note> <lb xml:id="p1z16"/>et hominem repererunt in consilio suo pertinacissimum; se<lb xml:id="p1z17"/>curus est eorum, quę obiecta sunt.</s>
					<s n="12" xml:lang="la">Dogma eius nuper <lb xml:id="p1z18"/>scripsi, opera videlicet una cum fide iustificare.</s>
					<s n="13" xml:lang="la">Nunc addit <lb xml:id="p1z19"/>hominem in hac vita pervenire posse ad summam perfectionem <lb xml:id="p1z20"/>ideoque legem dei possibilem esse.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><persName ref="p18538">Carolus</persName><note xml:id="fn7" type="footnote" n="7">Kaiser <persName ref="p18538">Karl V.</persName></note> adhuc subsisti<lb xml:id="p1z21"/>t in <placeName ref="l20">Germania Inferiore</placeName>; quid moliatur, clam est.</s>
					<s n="15" xml:lang="la">Illu<lb xml:id="p1z22"/>d certum, quod squamę pontificię<note xml:id="fn8" type="footnote" n="8">Zur Anwendung von <cit type="bible"><ref>Hi 41, 6</ref></cit> auf den Papst und seine Gefolgsleute vgl. etwa <bibl source="b39">Graubünden, Korr.</bibl> I 39; <bibl source="b671">WA</bibl> VIII 413, 31.</note> plus satis ipsum<note xml:id="fne" type="footnote" n="e">ipsum <hi>über der Zeile nachgetragen.</hi></note> in nos ex<lb xml:id="p1z23"/>timulant.</s>
					<s n="16" xml:lang="la">Verum spes est dominum adfuturum nobis, <lb xml:id="p1z24"/>modo nos non deficiamus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Valete cum liberis<note xml:id="fn9" type="footnote" ana="bio" n="9">Siehe oben <ref target="file11387">Nr. 1344</ref>, Anm. 14 (zu <persName ref="p495">Bullingers</persName> Kindern) bzw. <hi>Egli,</hi> Analecta 23 (zu <persName ref="p8171">Biblianders</persName> Kindern).</note> et uxoribus<note xml:id="fn10" type="footnote" n="10"><persName ref="p8051">Anna Adlischwyler</persName> und <persName ref="p4300">Rosilla Rordorf</persName>.</note>; <lb xml:id="p1z25"/><persName ref="p8127">Pellicano</persName> item et reliquis semper bene opto.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l28">Basileę</placeName>, ra<lb xml:id="p1z26"/>ptim, 20. augusti anno 40.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z27"/><persName ref="p8418">Os. Myconius</persName> <lb xml:id="p1z28"/>vester.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>D[ominis] <persName ref="p495">Heinricho Bullingero</persName> <lb xml:id="p2z2"/>et <persName ref="p8171">Theodoro <lb xml:id="p2z3"/>Bibliandro</persName>, viris doctissimis, <lb xml:id="p2z4"/>in domino suis.</s>
				</p>
			</div>
