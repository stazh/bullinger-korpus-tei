					<msContents>
						<summary>
							<p xml:id="regest1">Bedankt sich für <persName ref="p495" cert="high">Bullingers</persName> gehaltvolle Briefe, lobt <persName ref="p495" cert="high">Bullingers</persName> Fähigkeiten und christliches Wesen und berichtet vom Tod des <persName ref="p5028" cert="high">Philipp Grotz</persName> und anderer. Sehnt sich nach einer Aussprache mit <persName ref="p495" cert="high">Bullinger</persName>; dieser soll sich um die Entsendung eines Nachfolgers für Pfarrer <persName ref="p6022" cert="high">Jakob Otter</persName> nach <placeName ref="l2" cert="high">Aarau</placeName> bemühen.</p>
						</summary>
						<msItem>
							<textLang>Latein</textLang>
						</msItem>
