	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Satis fecisti prorsus animo meo, honorande <lb xml:id="p1z2"/>senex idemque frater colendissime; non excidet <lb xml:id="p1z3"/>amor mutuus, tametsi raro scribamus; manebit illae<lb xml:id="p1z4"/>sa amicitia et observantia mutua.</s>
					<s n="3" xml:lang="la">Cur hic ad <lb xml:id="p1z5"/>vos tabellio veniat, intelliges ex communi scripto, <lb xml:id="p1z6"/>quo obsecro ut prudenter utamini; fortassis <lb xml:id="p1z7"/>non proderit hoc spargere, sed inter fidos re<lb xml:id="p1z8"/>tinere.</s>
					<s n="4" xml:lang="la">Prospicite obsecro ecclesiis; adeste <lb xml:id="p1z9"/>caussae optimae; memores este admonitionum <lb xml:id="p1z10"/>Christi et apostolorum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Nunc agitur res ecclesiarum <lb xml:id="p1z11"/>et salutis nostrae; hic si aberraverimus <lb xml:id="p1z12"/>a scopo, actum erit cum ecclesiis nostrae fidei <lb xml:id="p1z13"/>commissis, nisi ipse pastorum princeps dominus noster <lb xml:id="p1z14"/>singulari modo nos servaverit.</s>
					<s n="6" xml:lang="la">Si fueri<lb xml:id="p1z15"/>mus concordes, bene spero; sin secus, non <lb xml:id="p1z16"/>est, quod putemus nobis irrogari iniuriam.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/>Dominus adsit nobis et ecclesiae.</s>
					<s n="8" xml:lang="la">Apud nos gratia <lb xml:id="p1z18"/>deo res bene habent.</s>
					<s n="9" xml:lang="la">A <placeName ref="l1122">Parma</placeName> nihildum certi <lb xml:id="p1z19"/>quicquam habeo; ubi accepero, non carebis iis.</s>
					<s n="10" xml:lang="la">Unum <lb xml:id="p1z20"/>et alterum verbum <persName ref="p1278">Gastio</persName> scripsi.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale cum tuis <lb xml:id="p1z21"/>omnibus.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/><placeName ref="l587">Tiguri</placeName> 8. iulii anno 1551.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z25"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p8418">Os<lb xml:id="p2z2"/>valdo Myconio</persName>, domin<lb xml:id="p2z3"/>o honorando et <lb xml:id="p2z4"/>fratri colendissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
