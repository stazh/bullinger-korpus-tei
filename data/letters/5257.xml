	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D. D.</s>
					<s n="2" xml:lang="la"><persName ref="p8359">Gallicio</persName> dices me eius accepisse literas<lb xml:id="p1z2"/>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>tribuit ille mihi pro suo in me amore nimium; <lb xml:id="p1z4"/>sed tribuamus omnia bona domino oremusque, <lb xml:id="p1z5"/>ut augeat dona et in ovibus<note type="misc">omnibus?</note> benedicat nobis.</s>
					<s n="4" xml:lang="la" ana="salute"><lb xml:id="p1z6"/>Saluta illum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Nullas nunc tuas accepi; spero <lb xml:id="p1z7"/>meas tibi esse oblatas per postam, in quibus ago te<lb xml:id="p1z8"/>cum de <persName ref="p3375">Vergerio</persName>.</s>
					<s n="6" xml:lang="la">De me et meis nihil dices <lb xml:id="p1z9"/>apud ipsum; imo, si cogitare potes aliquem tuorum <lb xml:id="p1z10"/>illi communicare res, omnia mea tibi retinere <lb xml:id="p1z11"/>memento, donec discesserit <foreign xml:lang="de">die unmüssig burdi.</foreign></s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/><persName>Guysianus</persName> recta, simulac venit vel rediit ex <lb xml:id="p1z13"/>conventu <placeName ref="l2074">Tabernensi</placeName> <placeName ref="l632">Alsat.</placeName>, invasit ecclesiam <lb xml:id="p1z14"/>dei.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Historiam habes hic paucis descriptam; vide, <lb xml:id="p1z15"/>ut soli tibi retineas.</s>
					<s n="9" xml:lang="la">Est locus in <placeName>Campania</placeName> <lb xml:id="p1z16"/><placeName>Wassey</placeName> non procul a <placeName>Lynvilla</placeName>, ubi ecclesia n<lb xml:id="p1z17"/>umerabatur ad 1500 hominum.</s>
					<s n="10" xml:lang="la">Recepta est haec ecclesia <lb xml:id="p1z18"/>in regis defensionem; coiit ergo sequra in coetum <lb xml:id="p1z19"/>ad verbi auscultationem et preces inermis.</s>
					<s n="11" xml:lang="la">Hanc <lb xml:id="p1z20"/><persName>Guysianus</persName> de repente invasit et trucidavit circi<lb xml:id="p1z21"/>ter 150, vulnerati supra 200, reliqui fuga <lb xml:id="p1z23"/>diffugierunt.</s>
					<s n="12" xml:lang="la">Regi conquesti sunt iniuriam.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Apud <lb xml:id="p1z24"/>regem fuit, qui <persName>Guysiano</persName> patrocinatus sit; alii vin<lb xml:id="p1z25"/>dicandum putarunt sanguinem innoxium.</s>
					<s n="14" xml:lang="la">Tandem in<lb xml:id="p1z26"/>quisitio decreta est.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Interim parato sibi equitatu <lb xml:id="p1z27"/>forti <persName>Guysianus</persName> progreditur.</s>
					<s n="16" xml:lang="la">Regina mater <lb xml:id="p1z28"/>mandat ei, exercitum dimittat aut regis in<lb xml:id="p1z29"/>dignationem expectet.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Excipit ille: "Si venero <lb xml:id="p1z30"/>ad reginam, purgabo me, ut nemo queri possit" etc.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z31"/><persName>Regina</persName> cum rege dicitur contendisse <placeName ref="l367">Aureliam</placeName>; interim <lb xml:id="p1z32"/>festinat ille cum equitatu <placeName ref="l378">Lutetiam</placeName>.</s>
					<s n="19" xml:lang="la">Aliis, id est <lb xml:id="p1z33"/>nostris, mandatur, ne arma sumant.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Quid futurum sit <lb xml:id="p1z34"/>aut iam factum sit, novit dominus, qui sedulo nobis <lb xml:id="p1z35"/>orandus est.</s>
					<s n="21" xml:lang="la">Scribuntur haec 17. martii <placeName ref="l378">Parisiis</placeName> etc.</s>
					<s n="22" xml:lang="la"><lb xml:id="p1z36"/>Concilium ita pergit, ut, si dominus hoc non de<lb xml:id="p1z37"/>struxerit, experturi simus, quae nunc minime <lb xml:id="p1z38"/>putamus; vigilat enim papa et satagit Sathan.</s>
					<s n="23" xml:lang="la"><lb xml:id="p1z39"/>Utinam precemur serio et preces nostras audiat dominus.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z40"/>Comitia Heremitana non procedent, <lb xml:id="p1z42"/>quia iudicum alter, amanus <foreign xml:lang="de"><persName ref="p5361">imm Hoff</persName> von <placeName ref="l781">Ury</placeName></foreign> mortuus <lb xml:id="p1z43"/>est; restat solus amanus <persName>Dieterych</persName>.</s>
					<s n="25" xml:lang="de">Dorumb ist der <lb xml:id="p1z44"/>tag widerumb abgeschriben nächte uff der nacht.</s>
					<s n="26" xml:lang="la"><lb xml:id="p1z45"/>Literas ex <placeName ref="l157">Franckforto</placeName> nondum accepi.</s>
					<s n="27" xml:lang="la" ana="farewell">Vale et ora <lb xml:id="p1z46"/>dominum sedulo.</s>
					<s n="28" xml:lang="la">Literas <persName ref="p629">Coignetii</persName> accepisti, opinor, <lb xml:id="p1z47"/>per postam.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 3. aprilis celerrime 1562.</s>
				</p>
				<p>
					<s n="30" xml:lang="la" ana="salute"><lb xml:id="p1z48"/>Saluta amicos et imprimis d. d. consules.</s>
					<s n="31" xml:lang="la" ana="salute">Salutant te nostri etc.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><lb xml:id="p1z49"/>Tuus ille.</s>
				</p>
				<p>
					<s n="33" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>fideli ministro, domino <lb xml:id="p2z4"/>colendo et fratri <lb xml:id="p2z5"/>charissimo suo.</s>
					<s n="34" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
