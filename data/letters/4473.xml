	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>M. Schenlsius ornatissimo d. Bullingero, S..
					<lb xml:id="p1z2"/>De qui nuper tibi scripsi libro eum nunc tibi d. B
					<lb xml:id="p1z3"/>ge mitto, qui quam gratus sit futurus, non ignoro (non
					<lb xml:id="p1z4"/>t enim non gratum tibi ne, quob ab amico tui amantissimi
					<lb xml:id="p1z5"/>ae
					<lb xml:id="p1z6"/>
					<lb xml:id="p1z7"/>amiucundus, non satis scio, quem pacs
					<lb xml:id="p1z8"/>ppelest.
					<lb xml:id="p1z9"/>reno
					<lb xml:id="p1z10"/>quillitatis publicae studiosissimum, ex animo dolere
					<lb xml:id="p1z11"/>quorundam importunitate tam nostrum ecclesiae et
					<lb xml:id="p1z12"/>ne sepitum dogma. Reliquum est, ut cum cessare nunquam
					<lb xml:id="p1z13"/>et congescere veteratorem Satanam videamus, ipsi vicissimi quoque rei
					<lb xml:id="p1z14"/>nostrarum satagamus, sed ita ut non gloriolae alilun
					<lb xml:id="p1z15"/>nostrae, sedo veritatis, quod quae deus est habuisse rationem
					<lb xml:id="p1z16"/>Bene vale d domino Ioanne Wolphio, Frisio ecs
					<lb xml:id="p1z17"/>ideamur.
					<lb xml:id="p1z18"/>si sine molestia potes meis vrbis d. Diato.Aug
					<lb xml:id="p1z19"/>ecalendias dctobris anno etc..
					<lb xml:id="p1z20"/>D. Semperitus Hoserus, vir inprimis pius ponestus lingis tudiu
					<lb xml:id="p1z21"/>salutem tibi suis verbis ascribit, cuni gratum feceris
					<lb xml:id="p1z22"/>siquando ocium nactus scripseris et me commendaris. Itom
					<lb xml:id="p1z23"/>Vale.
					<pb/>
					<lb xml:id="p2z1"/>Clarissimo viro domino
					<lb xml:id="p2z2"/>Heinricho Bullingero,
					<lb xml:id="p2z3"/>ecclesiastae Tigurino
					<lb xml:id="p2z4"/>domino et amico prarcipuo.
				</p>
			</div>
		</body>
	</text>
