	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Dominus <persName ref="p1548">Ricardus Hilles</persName> <placeName ref="l830">Anglus</placeName> ante mensem pollicitus est bona fide meas literas <lb xml:id="p1z3"/>ad te mittere.</s>
					<s n="3" xml:lang="la">Si accepisti, bene est; si non, spero te accepturum.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Rogo, ne imputes literarum intermissionem vel ingratitudini vel <lb xml:id="p1z5"/>oblivioni, sed seriis et gravibus negotiis, quibus distrahor <lb xml:id="p1z6"/>perpetuo, et aliis causis, quas supprimo, donec tempus <lb xml:id="p1z7"/>aspiret, quo liberius literis tecum agere possem.</s>
					<s n="5" xml:lang="la">Scio, quod <lb xml:id="p1z8"/>responsum tuarum petitionum, quas plurimum per literas petieras, <lb xml:id="p1z9"/>exspectas; exspecta paulisper: sat sit, si sat<note type="margin">a. R.: ...!</note> bene, quod <lb xml:id="p1z10"/>optas, optinebis.</s>
					<s n="6" xml:lang="la">Si <persName>Decades</persName>, quas a te pii multi singulis <lb xml:id="p1z11"/>nundinis expectant, prelo paratas habeas, rogo, ut duci <lb xml:id="p1z12"/><placeName ref="l2590">Northumbrię</placeName> illas dedices; te vehementer amat et Christi <lb xml:id="p1z13"/>gloriam promovet diligenter.</s>
					<s n="7" xml:lang="la">Dominum <persName ref="p8111">Martyrem</persName> 20. huius februarii <lb xml:id="p1z14"/><placeName ref="l376">Oxonię</placeName> febri decumbentem reliqui; dominus adsit illi, et <lb xml:id="p1z15"/>restituat sanitati.</s>
					<s n="8" xml:lang="la">Uxor illius 16 huius mensis migravit <lb xml:id="p1z16"/>ad dominum.</s>
					<s n="9" xml:lang="la" ana="salute">Uxor mea cum tota familia mea tuam praestantiam <lb xml:id="p1z17"/>salutat.</s>
					<s n="10" xml:lang="la" ana="salute">Meo ac illius nomine tuam salutabis, et omnia bona <lb xml:id="p1z18"/>filiis et filiabus tuis precamur.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Saluta d. consulem, d. <lb xml:id="p1z19"/><persName ref="p8171">Bibliandrum</persName>, d. <persName ref="p8011">Gvalterum</persName>, d. <persName ref="p8127">Pellicanum</persName>, cum suis <lb xml:id="p1z20"/>coniugibus, d. <persName ref="p506">Butlerum</persName> et suam.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l296">Londini</placeName>, ultimo februarii, 1553.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/>Tui semper studiosissimus, <persName ref="p1560">Iohannes <lb xml:id="p1z23"/>Hoperus</persName>, <placeName ref="l567">Wigorniensis</placeName> <lb xml:id="p1z24"/>et <placeName ref="l177">Gloucestrensis</placeName> episcopus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p4z1"/>Ornatissimo viro d. <lb xml:id="p4z2"/><persName ref="p495">Heinrico Bullingero</persName>, pientissimę <lb xml:id="p4z3"/>ecclesię <placeName ref="l587">Tigurinę</placeName> antistiti <lb xml:id="p4z4"/>vigilantissimo, <lb xml:id="p4z5"/>et compatri suo amantissimo.</s>
				</p>
			</div>
