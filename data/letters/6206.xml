	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Pro iis, quae misisti, gratias tibi, chare <lb xml:id="p1z2"/>frater, ago, imprimis pro decretis concilii, <lb xml:id="p1z3"/>quae remitto; nam superiore septimana accepi <lb xml:id="p1z4"/>et indicem haereticorum et decreta concilii <lb xml:id="p1z5"/><placeName ref="l1107">Tridentini</placeName> vulgata per pontificem praefixo brevi apostolico <lb xml:id="p1z6"/>et impresso eleganter a <persName>Paulo Manutio</persName> <placeName ref="l522">Veneciis</placeName>; <lb xml:id="p1z7"/>accepi autem ex <placeName ref="l377">Padua</placeName> a vetere meo <lb xml:id="p1z8"/>amico d. <persName>Engelberto Milandro</persName> Hesso et tibi fort<lb xml:id="p1z9"/>assis noto.</s>
					<s n="3" xml:lang="la">At disputationem <persName>Cardilli</persName> illius tui non <lb xml:id="p1z10"/>vidi neque quicquam de ipsa antea audivi.</s>
					<s n="4" xml:lang="la">Hic, <lb xml:id="p1z11"/>hic, si libet, periculum facere licet et respondere <lb xml:id="p1z12"/>isti diligenter et ad rem et breviter.</s>
					<s n="5" xml:lang="la">Si exem<lb xml:id="p1z13"/>plaria vehentur <placeName ref="l157">Francfordia</placeName> (-diam?), monebo <persName ref="p1227">Froschouerum</persName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Idem dixit se <persName>Erasti</persName> negotium curaturum; <lb xml:id="p1z15"/>egit cum <placeName ref="l294">Locarnensibus</placeName>; responderunt illi se <placeName ref="l306">Medio<lb xml:id="p1z16"/>lano</placeName> advecturos, sed non minori precio quam <lb xml:id="p1z17"/>aureorum 15.</s>
					<s n="7" xml:lang="la">Si scripsero <persName ref="p8075">Erasto</persName>, tuae admo<lb xml:id="p1z18"/>nitionis meminero.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Decreta concilii <placeName ref="l1107">Tri<lb xml:id="p1z19"/>dentini</placeName> antea quoque <placeName ref="l267">Coloniae Agrippinae</placeName> sunt impressa, <lb xml:id="p1z20"/>unde etiam e<lb xml:id="p1z21"/>xcepi.</s>
					<s n="9" xml:lang="la">Quae ex <placeName ref="l41">Berna</placeName> et <lb xml:id="p1z22"/><placeName ref="l167">Geneva</placeName> habeo, hic ad te mitto, ut videas <lb xml:id="p1z23"/>me etiam in multis negotiis me tui nunquam <lb xml:id="p1z24"/>oblivisci; cave, ne temere spargas.</s>
					<s n="10" xml:lang="la">Si ita <lb xml:id="p1z25"/>tibi videatur commodum, remitte mihi scriptum hoc; <lb xml:id="p1z26"/>sin secus, retine.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Latina epistola est <persName ref="p8033">Bezae</persName> ad me.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z27"/>De responso <placeName ref="l41">Bernatum</placeName> nihildum certi accepi; <lb xml:id="p1z28"/>ubi accepero, plenius scribam.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Nunc vale una <lb xml:id="p1z29"/>cum uxore, liberis et amicis nostris; omnes <lb xml:id="p1z30"/>mei te salutant.</s>
					<s n="14" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 28. iulii 1564.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z31"/>Tuus perpetuus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z4"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z5"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z6"/>ministro, domino et fratri <lb xml:id="p2z7"/>meo colendissimo et charissimo.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
