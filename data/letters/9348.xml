	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S.
					<lb xml:id="p1z2"/>Antequam tuae mihi pridie redderentur, honorande domine
					<lb xml:id="p1z3"/>compater, iam dominus quaestor dhiscosserat. Literas
					<lb xml:id="p1z4"/>tamen ad tutum ipsius contubernium continuo reddi
					<lb xml:id="p1z5"/>curavi, ut ad primum ipsius reditum easdem haberet
					<lb xml:id="p1z6"/>Non dubito autem, quin et suae profectionis causas
					<lb xml:id="p1z7"/>et quicquid hic agatur, et quid in Rhetos Hispanus
					<lb xml:id="p1z8"/>moliatur exposuerit. Secundum Bellieureum apud vo
					<lb xml:id="p1z9"/>iam vidisti. Silent hic omnia et suspensis animis
					<lb xml:id="p1z10"/>nescio quid praestolantur. Domina stettgnam 5. iupii noo
					<lb xml:id="p1z11"/>cum duobus curribus iter ingressa plurimam adhuc tb
					<lb xml:id="p1z12"/>et domino Gvalthero salutem dici iussit. Lavat et
					<lb xml:id="p1z13"/>apud nos domina Frischinga Bernensis tua, quod
					<lb xml:id="p1z14"/>puto propinqua, sorox Ioanis et Theobaldi, P. Ioanne
					<lb xml:id="p1z15"/>Alberto a Mulinen nepoti d. consulis nuper
					<lb xml:id="p1z16"/>Sunt cum illa et domini consules Sreigeri ex prio
					<lb xml:id="p1z17"/>uxore neptis Willendingam iunioris sticulari
					<lb xml:id="p1z18"/>qui et ipse senatorii ordinis est a proximo passsa
					<lb xml:id="p1z19"/>uxor et domini Wurstenbergeri filia, prius
					<lb xml:id="p1z20"/>sepandaretae Sagero modo praetori, Aroviensi maxta
					<lb xml:id="p1z21"/>Hoc si tibi significarem propter dominam Frischinga
					<lb xml:id="p1z22"/>non ingratum me facturum putavi.
					<lb xml:id="p1z23"/>norande domine compater et vive cum omnibus tuis
					<lb xml:id="p1z24"/>foeliciter. Propere sub vesperam 8. iunii
					<lb xml:id="p1z25"/>Ad aquas Helvet. Vale. Salvi sint dnim et
					<lb xml:id="p1z26"/>Fratres omnes
					<lb xml:id="p1z27"/>Tui colendissimo Wn. Hallerus
					<pb/>
					<lb xml:id="p2z1"/>Clarissimo viro domino Heinricho
					<lb xml:id="p2z2"/>Bullingero, seniori domino
					<lb xml:id="p2z3"/>et compatri honorando.
					<lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.
				</p>
			</div>
		</body>
