			<zone xml:id="p2z7-0" points="1382,2276 1396,2273 1422,2288 1428,2282 1441,2281 1460,2290 1472,2284 1480,2291 1507,2284 1508,2241 1486,2228 1468,2230 1456,2241 1421,2235 1412,2228 1383,2235">1388,2254 1418,2254 1449,2254 1479,2253 1510,2251</zone>
		</surface>
