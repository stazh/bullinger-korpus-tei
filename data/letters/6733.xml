	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. <lb xml:id="p1z2"/>D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Valde sum delectatus libris aliquot tuis, vir clarissime, domine colendissime idemque <lb xml:id="p1z4"/>frater charissime, quos ad me misit industrius typographus <persName>Ernestus Vigilii</persName>, <lb xml:id="p1z5"/>ac domino deo nostro gratias ago, qui tot tantaque in te dona sua contulit, eundemque <lb xml:id="p1z6"/>precor sedulo, ut tibi benedicere pergat, quo plurimum ecclesiae suae prodesse <lb xml:id="p1z7"/>possis.</s>
					<s n="3" xml:lang="la">Ex libris porro tuis videor mihi videre animum tuum minime <lb xml:id="p1z8"/>ad rixas contentionesque, sed ad pacem ecclesiarum concordiamque piam pr<lb xml:id="p1z9"/>opendere.</s>
					<s n="4" xml:lang="la">Quocirca ausus sum has breves ad te scribere literas, simul etiam <lb xml:id="p1z10"/>ecclesiarum <placeName ref="l862">Helveticarum</placeName> mittere Confessionem, quam tibi non displicituram <lb xml:id="p1z11"/>spero.</s>
					<s n="5" xml:lang="la">Superiore anno <placeName ref="l28">Basilienses</placeName> suam evulgarunt confessionem congrue<lb xml:id="p1z12"/>ntem cum hac, unde factum est, ut nunc huic nomina sua non adiunxerint.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Te oro, doctissime et humanissime me <persName ref="p3046">Victorine</persName>, ut nostram illam legas, nos <lb xml:id="p1z14"/>quoque tui amantissimos ames.</s>
					<s n="7" xml:lang="la" ana="salute">Commenda me viris piis et doctis et ora pro me dominum.</s>
					<s n="8" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z15"/>vale, charissime frater.</s>
					<s n="9" xml:lang="la">Dominus benedicat tibi et tuis.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 20. martii 1566.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><persName ref="p495">Heinrychus Bullingerus</persName> <placeName ref="l587">Tigurinae</placeName> ecclesiae minister, tuus <lb xml:id="p1z16"/>ex animo totus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">C<lb xml:id="p1z17"/>larissimo viro d. <persName ref="p3046">Victorino Strigelio</persName>, inclytae <lb xml:id="p1z18"/><placeName ref="l284">Lipsensis</placeName> academiae professori, domino meo colendo et fratri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
