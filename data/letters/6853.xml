	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Heri tuas accepi per hunc cursorem vestrum una <lb xml:id="p1z2"/>cum literis ad landgravium.</s>
					<s n="3" xml:lang="la">Illas legi, legit etiam <lb xml:id="p1z3"/><persName ref="p8063">Steigerus</persName>.</s>
					<s n="4" xml:lang="la">Interea sub noctem heri venit <persName ref="p8033">Beza</persName> et <lb xml:id="p1z4"/>cum eo syndicus <persName ref="p2740">Rosetus</persName> una cum d. <persName ref="p772">Datheno</persName>.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Mittuntur illi ad respublicas nostras, ut cum illis <lb xml:id="p1z6"/>deliberent aut potius eas huc deducant, ut legationem <lb xml:id="p1z7"/>aliquam aut saltem literas aliquas communes mittant <lb xml:id="p1z8"/>ad conventum <placeName ref="l142">Erdfordianum</placeName> et, quantum fieri potest, <lb xml:id="p1z9"/>colloquium illud instituendum praevertant et impedian<lb xml:id="p1z10"/>t.</s>
					<s n="6" xml:lang="la">Quid a nostris impetraturi sint, nescio; <lb xml:id="p1z11"/>non male erga causam ipsam sunt affecti; difficulte<lb xml:id="p1z12"/>r se tamen intromittant in controversias illas <lb xml:id="p1z13"/>peregrinas; metuunt enim, ne toti deinceps illic <lb xml:id="p1z14"/>involvamur et illas in caput nostrum attrahamus.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Veniant illi quoque <placeName ref="l587">Tigurum</placeName>; huius te praemonitum <lb xml:id="p1z16"/>hisce volo.</s>
					<s n="8" xml:lang="la">- Cras demum a senatu nostro audientur.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/>Cuperent sibi addi aliquos a nostris, qui una cum <lb xml:id="p1z18"/>ipsis <placeName ref="l587">Tigurum</placeName> proficiscerentur, ut communis illic fieret de <lb xml:id="p1z19"/>his rebus deliberatio.</s>
					<s n="10" xml:lang="la">Sed quid futurum sit, adhuc <lb xml:id="p1z20"/>ignoro.</s>
					<s n="11" xml:lang="la">Nobis illud sufficere videretur, quod iam <lb xml:id="p1z21"/>tu prius egisti, quod scilicet illam causam landgra<lb xml:id="p1z22"/>vio commendasti; speramus illum facturum officiium <lb xml:id="p1z23"/>boni principis, et cuperemus audire prius, quid ille <lb xml:id="p1z24"/>responderet.</s>
					<s n="12" xml:lang="la">Sed urgent illi negotium, propter[ea] quod <lb xml:id="p1z25"/>tempus nimis prope instet calendarum septembrium.</s>
					<s n="13" xml:lang="de"><lb xml:id="p1z26"/>Man kan aber nitt wol, man hör denn vor des land<lb xml:id="p1z27"/>grafen antwort; darzuͦ ist der fürsten bruch nitt, <lb xml:id="p1z28"/>so bald zuͦsammen zkommen.</s>
					<s n="14" xml:lang="la">Pro reliquis, quae <lb xml:id="p1z29"/>scripsisti et misisti, ago gratias; per <persName ref="p8033">Bezam</persName> caetera <lb xml:id="p1z30"/>remittam.</s>
					<s n="15" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="16" xml:lang="la" ana="salute">Salutant te <persName ref="p8063">Steigerus</persName>, <lb xml:id="p1z31"/><persName ref="p7511">Gravenrietus</persName>, <persName ref="p4060">Zehenderi</persName> et fratres omnes, socer item <lb xml:id="p1z32"/>cum mea domo.</s>
					<s n="17" xml:lang="la" ana="salute">Saluta tu tuam.</s>
					<s n="18" xml:lang="la">Cum <persName ref="p20227">Valentino <lb xml:id="p1z33"/>Gentile</persName> nihildum actum est.</s>
					<s n="19" xml:lang="la">Attulit nobis <persName ref="p8033">Beza</persName> multa, <lb xml:id="p1z34"/>quę prius ignoravimus, de tumultibus <placeName ref="l2472">Polonicis</placeName> per <lb xml:id="p1z35"/>ipsum et alios excitatis.</s>
					<s n="20" xml:lang="la" ana="farewell">Vale iterum.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l41">Bernae</placeName> <lb xml:id="p1z36"/>26. iulii 1566.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z37"/><persName ref="p8018">Joh[annes] Hallerus</persName>, <lb xml:id="p1z38"/>semper tuus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino meo honorando et <lb xml:id="p2z5"/>compatri charissimo.</s>
				</p>
				<p>
					<s n="24" xml:lang="de"><lb xml:id="p2z6"/>M. <persName ref="p495">Heinrych <lb xml:id="p2z7"/>Bullingern</persName> zuͦ <lb xml:id="p2z8"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
