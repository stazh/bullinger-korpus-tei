		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi tuas et legi nec video <lb xml:id="p1z2"/>magnopere referre, ut ad eas respondeam.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Timeamus deum, simus soliciti, agamus eius <lb xml:id="p1z4"/>negotium in conspectu eius fideliter obsecrantes, <lb xml:id="p1z5"/>ut ille benedicat nobis.</s>
					<s n="4" xml:lang="la">Plurima in hoc <lb xml:id="p1z6"/>homine mihi displicent; dominum oro, ne per <lb xml:id="p1z7"/>hunc ipsum puniat ingratitudinem et peccata <lb xml:id="p1z8"/>nostra.</s>
					<s n="5" xml:lang="la">Non possum plura scribere de rebus <lb xml:id="p1z9"/><placeName ref="l832">Gallicis</placeName>, quia totus occupatus sum in absolvendis <lb xml:id="p1z10"/>quibusdam in typographiam et scribendis <lb xml:id="p1z11"/>multis in <placeName ref="l830">Angliam</placeName>, <placeName ref="l749">Saxoniam</placeName>, <placeName ref="l2472">Polonia<lb xml:id="p1z12"/>m</placeName> <lb xml:id="p1z13"/>et ad alia loca, ad quae per mercatores <lb xml:id="p1z14"/>nunc se parantes <placeName ref="l157">Francof[ordiam]</placeName> curari pos<lb xml:id="p1z15"/>sunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Noli ergo mirari, si post octiduum nihil.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p629">Coignetius</persName> modo scribit res feliciter habere <lb xml:id="p1z17"/>in <placeName ref="l832">Gallia</placeName>; ab aula cardinalem recessisse.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z18"/>Addit <placeName>Sabaudum</placeName> <placeName>Vallis Agroniae</placeName> incolas <lb xml:id="p1z19"/>voluisse iterum perdere; sed cecidisse ex <lb xml:id="p1z20"/><placeName ref="l2478">Sabaudis</placeName> supra 800 milites.</s>
					<s n="9" xml:lang="la">Nihi<lb xml:id="p1z21"/>l <lb xml:id="p1z22"/><placeName>Neoburgi</placeName> effectum, nisi quod alia comitia <lb xml:id="p1z23"/>instituta 18. maij <placeName ref="l28">Basileae</placeName> celebranda, in quibus ex 11 cantonibus <lb xml:id="p1z24"/>sequestres causam debeant cognoscere.</s>
					<s n="10" xml:lang="la">Ex <lb xml:id="p1z25"/><placeName>Neoburgo</placeName> <placeName ref="l749">Saxoniae</placeName> nihildum certi habeo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z26"/>Si quid de concilio habes et de rebus <placeName ref="l834">Italicis</placeName>, <lb xml:id="p1z27"/>communica.</s>
					<s n="12" xml:lang="la">Oremus dominum, ut nobis <lb xml:id="p1z28"/>adsit.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vale.</s>
					<s n="14" xml:lang="la">28. februarii 1561.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z29"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p8009">Ioanni Fabritio</persName>, <lb xml:id="p2z3"/><placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z4"/>ministro, fratri suo <lb xml:id="p2z5"/>charissimo.</s>
					<s n="17" xml:lang="de"><lb xml:id="p2z6"/>Gen <placeName ref="l98">Chur</placeName> an h. <lb xml:id="p2z7"/><persName ref="p8009">Hansen Schmid</persName>, pfarrer <lb xml:id="p2z8"/>zuͦ S. Martin.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>