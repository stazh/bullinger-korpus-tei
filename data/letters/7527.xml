	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quid hi ferant, ex ipsis cognosces.</s>
					<s n="3" xml:lang="la"><placeName ref="l167">Genevenses</placeName> <lb xml:id="p1z2"/>multum sibi sumpserunt in thesibus istis explican<lb xml:id="p1z3"/>dis et ordinandis; sed simul quoque temporis <lb xml:id="p1z4"/>sibi multum sumpserunt; nam integro mense isti <lb xml:id="p1z5"/>substiterunt illic.</s>
					<s n="4" xml:lang="la">Miramur hanc gentem tot calam<lb xml:id="p1z6"/>itatibus non posse adigi ad concordiam et de rebus <lb xml:id="p1z7"/>tam leviculis tantum schisma oriri; miramur <lb xml:id="p1z8"/>hos <lb xml:id="p1z9"/>tantulum negotium tot ambagibus et thesibus nunquam <lb xml:id="p1z10"/>finiendis explicare.</s>
					<s n="5" xml:lang="la">Subscripserant nostri <placeName ref="l280">Lausanenses</placeName> <lb xml:id="p1z11"/><placeName ref="l167">Genevensium</placeName> expositioni; sed quoniam illud erat peri<lb xml:id="p1z12"/>culosum et non sine offensa magistratus, siquidem <lb xml:id="p1z13"/>scire potuisset, factum fuisset, effecimus commoda ratione, <lb xml:id="p1z14"/>ut Lausanensium scriptum rursum ab his extorqueremus, <lb xml:id="p1z15"/>et dedimus illis commune scriptum ecclesiae <placeName ref="l41">Bernensis</placeName> <lb xml:id="p1z16"/>nomine, sub qua etiam <placeName ref="l280">Lausanensis</placeName> comprehenditur, quod quale <lb xml:id="p1z17"/>sit, videbis.</s>
					<s n="6" xml:lang="la">Puto neminem propter hoc nos reprehendere posse, <lb xml:id="p1z18"/>et putamus vos quoque eadem cautione usuros.</s>
					<s n="7" xml:lang="la">Alias <lb xml:id="p1z19"/>quod nunc scribam, non habeo.</s>
					<s n="8" xml:lang="la">Pax in <placeName ref="l832">Gallia</placeName> medio<lb xml:id="p1z20"/>criter procedit.</s>
					<s n="9" xml:lang="la">Minitatur rex vim et iam papistis suis, qui <lb xml:id="p1z21"/>eam servare nolint.</s>
					<s n="10" xml:lang="la">Interea nec <persName>Condaeus</persName> nec ami<lb xml:id="p1z22"/>ralius adhuc sunt in aula.</s>
					<s n="11" xml:lang="la"><placeName ref="l167">Genevę</placeName> pestis magis <lb xml:id="p1z23"/>ac magis invalescit; hinc fit, ut plęrique discedant.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/>Expectamus hodie hic filium principis Palatini <persName ref="p8024">Christo<lb xml:id="p1z25"/>phorum</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute"><persName ref="p8063">Steigerus</persName>, <persName ref="p7449">Diesbachius</persName>, <persName ref="p7511">Gravenrietus</persName>, <persName ref="p21017">Manuel</persName>, <lb xml:id="p1z26"/><persName ref="p4060">Zehenderi</persName> et socer te plurimum salutant; idem facit <lb xml:id="p1z27"/><persName>Blasius</persName>, meus gener, qui hic adest et per quem ab <lb xml:id="p1z28"/>his legatis <placeName ref="l280">Lausanensium</placeName> subscriptionem commode rursus <lb xml:id="p1z29"/>extorsimus.</s>
					<s n="14" xml:lang="la" ana="salute">Precor benedictionem et salutem <lb xml:id="p1z30"/>tuis omnibus.</s>
					<s n="15" xml:lang="la" ana="salute">Salutant te item fratres et symmystae.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z31"/><placeName ref="l41">Bernae</placeName> 13. iulii 1568.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z32"/><persName ref="p8018">I[ohannes] Hallerus</persName>, perpetuo <lb xml:id="p1z33"/>tuus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, pa<lb xml:id="p2z3"/>stori ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>fidelissimo, domino <lb xml:id="p2z5"/>meo honorando <lb xml:id="p2z6"/>et compatri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
