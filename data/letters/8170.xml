	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D.
					<lb xml:id="p1z2"/>Consilium tuum, clarissime viri et pater in Christo
					<lb xml:id="p1z3"/>venerande, communicavi nabili iuvenii
					<lb xml:id="p1z4"/>qui maximas tuae humanitati gratias
					<lb xml:id="p1z5"/>agit. Quia vero plerumque domi me contineo.
					<lb xml:id="p1z6"/>nescio quid interim ille effecerit.
					<lb xml:id="p1z7"/>nunc scribo, potius salutandi gratia, quam
					<lb xml:id="p1z8"/>quod aliquid tua humanitate dignum habeam
					<lb xml:id="p1z9"/>facio. Vergerii nepos ex Saxonia nuper Venien
					<lb xml:id="p1z10"/>Saloduri apud legatum Gallicum fuit. Is
					<lb xml:id="p1z11"/>in reditu Tubingam recta petens, narravit
					<lb xml:id="p1z12"/>doctori Martino Pegero, imperatorem a qui
					<lb xml:id="p1z13"/>principibus quinque millia equitum pastu
					<lb xml:id="p1z14"/>qui filiam regi desponsatam deducantr
					<lb xml:id="p1z15"/>in Galliam. At denegasse principes, conscribi
					<lb xml:id="p1z16"/>ut in Saxonia exercitum, qui nomine electoris
					<lb xml:id="p1z17"/>Augusti contra pontificios ducat in Galliam
					<lb xml:id="p1z18"/>Hoc quia cognoverit rex, ideo deliberationem
					<lb xml:id="p1z19"/>nunc fieri de pacis conditionibus.
					<lb xml:id="p1z20"/>Rogerus noster ducta in uxorem fratris
					<lb xml:id="p1z21"/>Bovilli filia ad suos maritus redit.
					<lb xml:id="p1z22"/>dominum precor, ut ipsis et ecclesiae, cui servient
					<lb xml:id="p1z23"/>benedicat. Utrunque coniugem tuae fidei etiam atque
					<lb xml:id="p1z24"/>etiam commendo. Frater Cochlinus calechista
					<lb xml:id="p1z25"/>ecclesiae nostrae, vir diligentia modestia, pietate
					<lb xml:id="p1z26"/>caeterisque theologo dignis virtutibus ornatissimi.
					<lb xml:id="p1z27"/>graviter nunc aegrotat. Eius nomine
					<lb xml:id="p1z28"/>humanitatem tuam oro, ut pro illo preces
					<lb xml:id="p1z29"/>tuas ad dominum fundere velis. Salutabis me
					<lb xml:id="p1z30"/>nomine reverenter dominos et fratres Gvaltherum,
					<lb xml:id="p1z31"/>Wolfium, Simlerum et caeteros omnes.
					<lb xml:id="p1z32"/>Salutant te officiosissime d. d. conss, doctor
					<lb xml:id="p1z33"/>Martinus Peyerus, Oratus Ieo, nobilis in Thurn
					<lb xml:id="p1z34"/>et symmystae omnes. Vale. Datum 7. febr570
					<lb xml:id="p1z35"/>t humanitatis studiosissimus
					<lb xml:id="p1z36"/>Ioannes Conradus
					<lb xml:id="p1z37"/>Ulmerus
					<pb/>
					<lb xml:id="p2z1"/>.
					<lb xml:id="p2z2"/>Clarissimo viro eximioque Christi servo,
					<lb xml:id="p2z3"/>d. Henrico Bullingero, ecclesiae Tigurina
					<lb xml:id="p2z4"/>antistiti, amico et patri meo
					<lb xml:id="p2z5"/>in Christo summe colendo.
				</p>
			</div>
		</body>
