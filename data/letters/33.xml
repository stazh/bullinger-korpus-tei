			<zone xml:id="p2z1-0" points="615,1559 920,1539 1044,1564 1100,1545 1177,1574 1218,1547 1259,1558 1249,1466 1199,1489 1089,1460 865,1501 680,1465 615,1477">620,1542 652,1537 684,1533 716,1533 748,1535 780,1535 812,1533 844,1533 876,1533 908,1533 940,1533 972,1535 1004,1536 1036,1536 1068,1536 1100,1536 1132,1536 1164,1538 1196,1539 1228,1538 1261,1536</zone>
			<zone xml:id="p2z2-0" points="666,1654 854,1605 879,1621 1014,1612 1069,1640 1136,1616 1181,1634 1238,1622 1238,1581 1104,1548 1046,1564 985,1547 902,1578 870,1560 825,1586 666,1553">671,1610 699,1607 727,1604 756,1601 784,1601 813,1601 841,1601 870,1599 898,1598 927,1598 955,1598 983,1598 1012,1598 1040,1598 1069,1599 1097,1600 1126,1602 1154,1604 1183,1604 1211,1605 1240,1607</zone>
			<zone xml:id="p2z3-0" points="761,1690 796,1713 911,1682 939,1707 963,1710 1003,1688 1043,1684 1046,1622 967,1613 906,1648 855,1628 825,1634 782,1667 762,1663">766,1682 791,1677 816,1674 842,1672 867,1670 893,1668 918,1667 944,1667 969,1666 995,1664 1020,1663 1046,1661</zone>
