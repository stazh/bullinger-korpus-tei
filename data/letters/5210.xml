	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. Nihil a vobis (pater reverende) literarum habuimus
					<lb xml:id="p1z2"/>otimus occupationes vestras. Augustinum
					<lb xml:id="p1z3"/>Talpium nondum vidi, existimo eum alicubi in
					<lb xml:id="p1z4"/>haerere. Tridento nihil dum habeo, marchio
					<lb xml:id="p1z5"/>pescariae, qui hatenus rexit ducatum Mediolanensem
					<lb xml:id="p1z6"/>dicitu illuc profectus. Nunc venit Tridento
					<lb xml:id="p1z7"/>quidam Iudarus, qui se pro doctore medico
					<lb xml:id="p1z8"/>erit. Is negat quemquam ex Germanis principibus
					<lb xml:id="p1z9"/>illic esse, dicit 22. februarii inter eos deliberandum
					<lb xml:id="p1z10"/>fuisse ee coniugio sacerdotum. Per vos transibit,
					<lb xml:id="p1z11"/>poteris eum alloqui, est, liberali facie homo et
					<lb xml:id="p1z12"/>in Hebracis non vulgariter doctus; is, licet non
					<lb xml:id="p1z13"/>multis dies Tridenti haserit, de pluribus tamen
					<lb xml:id="p1z14"/>interrogatus ordline respondere poterit.
					<lb xml:id="p1z15"/>reverende in Christo pater; ni fallor sic
					<lb xml:id="p1z16"/>homo dicere potest, quantum pontifex in singular
					<lb xml:id="p1z17"/>episcopos eroget. Vale.
					<lb xml:id="p1z18"/>subite cut m irrum nonrhi
					<pb/>
					<lb xml:id="p2z1"/>Amplissimo viro eruditione
					<lb xml:id="p2z2"/>pietate, humanitate
					<lb xml:id="p2z3"/>singulari d. Heinrycho
					<lb xml:id="p2z4"/>Bullingero, domino
					<lb xml:id="p2z5"/>patrinos
					<lb xml:id="p2z6"/>observando.
					<lb xml:id="p2z7"/>Zürich an H Bullinger.
				</p>
			</div>
		</body>
	</text>
