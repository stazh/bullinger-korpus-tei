	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Quid tandem sit de nostrarum ecclesiarum conventu
					<lb xml:id="p1z2"/>qvobis constitutum iampridem scire cupio nec dissimulo
					<lb xml:id="p1z3"/>nullam mihi tantam causam videri, quae hoc
					<lb xml:id="p1z4"/>consilium debeat impedire, in quo sperarem sic nobis
					<lb xml:id="p1z5"/>affuturum dominum, ut  perpetuae et inviolabilis
					<lb xml:id="p1z6"/>concordiae fundamenta inter nos posterosque nostros
					<lb xml:id="p1z7"/>iacerentur firmiora quam unquam antea, et tum
					<lb xml:id="p1z8"/>Germanos tum Gallos fratres non mediocriter
					<lb xml:id="p1z9"/>confirmaremus, sicut pluribus heri ad d. Hallerum
					<lb xml:id="p1z10"/>nostrum scripsi. Caeterum in Gallia et alibi quio
					<lb xml:id="p1z11"/>moliantur coniurati omnes in nostram perviciem
					<lb xml:id="p1z12"/>spero te aliunde brevi coginturum. Sed quod ad me
					<lb xml:id="p1z13"/>attinet, ista quidem mihi dei beneficio animu
					<lb xml:id="p1z14"/>aciunt, nedum ut imminuant. cardinalis in aulam
					<lb xml:id="p1z15"/>appulit 1. huius mensis ianuarii, adest
					<lb xml:id="p1z16"/>ibi quoque amiralius noster. Aiunt de reconciliationi
					<lb xml:id="p1z17"/>illarum familiarum nunc agi. Quae utinam si corerit,
					<lb xml:id="p1z18"/>satis syncere coierit. Scribit ad me d. Ehemius
					<lb xml:id="p1z19"/>epectari.
					<lb xml:id="p1z20"/>ex Germania, Anglicanum scriptum, edito iam Belgarum
					<lb xml:id="p1z21"/>eiusdem argumenti oratione. Spero etiam Gallos non
					<lb xml:id="p1z22"/>defuturos, a quibus duo iam sunt ad principes
					<lb xml:id="p1z23"/>missi, qui coram cum ipsis agant. Nobis etiam, si
					<lb xml:id="p1z24"/>libebit, satis relinquitur spatii, quum ante calendas
					<lb xml:id="p1z25"/>Martias principes ipsi non sint affuturi. Ego privatim
					<lb xml:id="p1z26"/>nihil meditatus, postea curam hanc abieci
					<lb xml:id="p1z27"/>utqui malim aliis hac in re assentiri superiorum
					<lb xml:id="p1z28"/>temporum experientia edoctus, quam quicquam per
					<lb xml:id="p1z29"/>audere. Mitto ad te epitaphium, quod
					<lb xml:id="p1z30"/>d. Gesneri memoriae consecravi. Addidi etiam
					<lb xml:id="p1z31"/>literarum porti nostri fasciculum et aliquod Henric
					<lb xml:id="p1z32"/>tepham nostri eadem de re versiculos.
					<lb xml:id="p1z33"/>Vale, mi pater una cum omnibus collegis. do.
					<lb xml:id="p1z34"/>Iesus vos omnes servet et sanctis vestris laboribus
					<lb xml:id="p1z35"/>benedicat. Genevae, 22. ianuarii 1566.
					<lb xml:id="p1z36"/>scripsissem, hodie sunt
					<lb xml:id="p1z37"/>his redditae siunt literae
					<lb xml:id="p1z38"/>et nos, sicuti parest,
					<lb xml:id="p1z39"/>Tuus Beza.
					<lb xml:id="p1z40"/>.
					<lb xml:id="p1z41"/>Scribam autem pluribus
					<lb xml:id="p1z42"/>aacum collegis communicare.
					<pb/>
					<lb xml:id="p2z1"/>Uimio Christi servo,
					<lb xml:id="p2z2"/>d. Henrico Bullingero,
					<lb xml:id="p2z3"/>Tigurinae ecclesiae vere
					<lb xml:id="p2z4"/>fido pastori, patri
					<lb xml:id="p2z5"/>mihi plurimum colendo.
				</p>
			</div>
