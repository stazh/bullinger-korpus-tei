			<zone xml:id="p4z4-0" points="1592,1645 1740,1628 1966,1672 2209,1623 2478,1666 2478,1596 2208,1601 2092,1554 1827,1590 1761,1554 1692,1587 1591,1567">1599,1614 1643,1611 1687,1611 1731,1611 1775,1611 1819,1611 1863,1611 1907,1611 1951,1611 1995,1611 2039,1611 2083,1613 2127,1614 2171,1614 2215,1616 2259,1615 2303,1616 2347,1615 2391,1616 2435,1617 2479,1619</zone>
			<zone xml:id="p4z5-0" points="1602,1718 1688,1703 1756,1734 1884,1703 1960,1745 2062,1708 2121,1752 2186,1716 2386,1715 2385,1645 2114,1630 2064,1664 1737,1654 1673,1677 1601,1651">1608,1691 1647,1688 1686,1688 1725,1688 1764,1688 1803,1688 1842,1688 1881,1688 1920,1691 1959,1694 1998,1694 2037,1696 2076,1697 2115,1697 2154,1697 2193,1697 2232,1697 2271,1697 2310,1697 2349,1699 2389,1700</zone>
			<zone xml:id="p4z6-0" points="1831,1805 1850,1812 1878,1803 1906,1813 1997,1785 2053,1810 2052,1714 2020,1719 1999,1739 1976,1733 1962,1745 1881,1703 1840,1728 1830,1723">1837,1781 1864,1779 1891,1778 1918,1778 1946,1778 1973,1778 2000,1778 2027,1780 2055,1784</zone>
