	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Vir clarissime, quum iam tradidissem nuncio fascem <lb xml:id="p1z2"/>literarum <placeName ref="l98">Curiam</placeName> perferendum, ecce allatę sunt <lb xml:id="p1z3"/>literae tuae cum chyrographo de concilio <lb xml:id="p1z4"/><placeName ref="l1107">Tridentino</placeName> etc.</s>
					<s n="2" xml:lang="la">Itaque me et reliquos fratres <lb xml:id="p1z5"/>summo gaudio asperxisti.</s>
					<s n="3" xml:lang="la">Ego, quę tu <lb xml:id="p1z6"/>scripsisti, confestim in linguam <placeName ref="l834">Italicam</placeName> con<lb xml:id="p1z7"/>vertam et evulgabo procul dubio.</s>
					<s n="4" xml:lang="la">Reliqua, <lb xml:id="p1z8"/>quę scribis, lubenter audivimus; sed fusius <lb xml:id="p1z9"/>paulo post respondebo.</s>
					<s n="5" xml:lang="la">Illud te vehementer <lb xml:id="p1z10"/>oro, ut illustrissimo d[omino] comiti nuncies me literas suę celsi<lb xml:id="p1z11"/>tudinis summa lętitia accepisse et mox <lb xml:id="p1z14"/>responsurum esse et alia quedam ad eum missurum.</s>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z15"/>Vale, vir optime, et me <lb xml:id="p1z16"/>u<lb xml:id="p1z17"/>niversae tum scholae, tum ecclesię commenda.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z18"/>Christus salvator noster vos servet a malo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z19"/><placeName ref="l525">Vicosoprani</placeName>, idibus februarii <lb xml:id="p1z21"/>1551.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z22"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Cla<pb/><lb xml:id="p2z1"/>rissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Henryco Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pasto<lb xml:id="p2z4"/>ri.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
