	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">In proximis, quas <placeName>Birwylam</placeName> misi, quid usque ad <lb xml:id="p1z2"/>18. diem huius mensis in causa nostra Sabaudica actum <lb xml:id="p1z3"/>sit, scripsi.</s>
					<s n="3" xml:lang="la">Ea die senatus iterum frequens convenit <lb xml:id="p1z4"/>una cum diacosiis, et totum illud negotium diligenter <lb xml:id="p1z5"/>perpensum et ventilatum est.</s>
					<s n="4" xml:lang="la">Vicit tandem illa sententia, <lb xml:id="p1z6"/>ut, si <persName ref="p17889">dux Sabaudię</persName> capita transactionis <placeName>Ni<lb xml:id="p1z7"/>vidunensis</placeName> recipere velit, nostros quoque eadem recepturos.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Expectatur itaque illius responsum, quod ad 25. <lb xml:id="p1z9"/>diem huius mensis hic dare debet.</s>
					<s n="6" xml:lang="la">Nostri eadem <lb xml:id="p1z10"/>die respondebunt <placeName ref="l2245">Cameraci</placeName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l167">Genevenses</placeName> interea <lb xml:id="p1z11"/>valde conqueruntur et se prodi illa clamitant, cum <lb xml:id="p1z12"/>tamen in illa etiam ipsis de pace provisum sit.</s>
					<s n="8" xml:lang="la">Sed quia <lb xml:id="p1z13"/>non omnia pro ipsorum arbitrio et ex illorum praescripto fiunt <lb xml:id="p1z14"/>nec fieri possunt, nos et nostros devovent.</s>
					<s n="9" xml:lang="la">Faxit <lb xml:id="p1z15"/>dominus, ut omnia tandem bonum finem sortiantur!</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/>Rex <placeName ref="l301">Lugduno</placeName> discessit propter luem illic grassantem.</s>
					<s n="11" xml:lang="la">Ferunt <lb xml:id="p1z17"/>eum in <placeName ref="l2772">Delphinatu</placeName> nunc agere non procul a <placeName ref="l1944">Valentia</placeName> <lb xml:id="p1z18"/>in loco, quem vocant <placeName>Cremeau</placeName>.</s>
					<s n="12" xml:lang="la">Aiunt etiam <placeName ref="l1209">Navarrę</placeName> <lb xml:id="p1z19"/>reginam ab aula discessisse et fideles principes omnes.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z20"/>Vanus, ut audio, fuit rumor ille de occupata civitate <lb xml:id="p1z21"/><placeName>Abawylensi</placeName> ab amiraldo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l301">Lugduni</placeName> post abitum regis <lb xml:id="p1z22"/>evangelium publice iterum docetur, et ecclesiae restituuntur.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z23"/>De militibus illis Germanis, qui in <placeName ref="l834">Italiam</placeName> profecti sunt, <lb xml:id="p1z24"/>nihildum audimus, quo tendant; si tu quid de his certi <lb xml:id="p1z25"/>habes, nobis significa.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">In <placeName ref="l20">Holandia</placeName> et <placeName ref="l20">Inferiori Ger<lb xml:id="p1z26"/>mania</placeName> audimus graves oriri tumultus et rem non <lb xml:id="p1z27"/>procul abesse a seditione et intestino bello.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">De his tame<lb xml:id="p1z28"/>n vos puto habere certiora.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z29"/>Pestis in agro nostro infra <placeName ref="l760">Solodorum</placeName> grassari quoque incipit.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z30"/>Audimus <persName ref="p3099">Sultzerum</persName> <placeName ref="l28">Basileae</placeName> ea etiam laborare, necdum <lb xml:id="p1z31"/>nobis constat, quomodo habeat.</s>
					<s n="20" xml:lang="la">Praeterita hac nocte apud <lb xml:id="p1z32"/>nos apoplexia obiit d. <persName ref="p4610">Petrus Cyro</persName>, vetus urbis nostrae <lb xml:id="p1z33"/>archigrammataeus, vir doctus ut integer.</s>
					<s n="21" xml:lang="la">Alias quod <lb xml:id="p1z34"/>nunc scribam non habeo, nisi quod te domino commendo; <lb xml:id="p1z35"/>is te diu nobis et ecclesię servet incolumem.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="salute">Salutant te <lb xml:id="p1z36"/>amici et fratres omnes, consules ambo, <persName ref="p3659">Mülinen</persName>, <persName ref="p3494">Diesbach</persName>, <lb xml:id="p1z37"/><persName ref="p7511">Grafenriet</persName>, socer, <persName ref="p4060">Zehenderi</persName> etc. mater denique et uxor <lb xml:id="p1z38"/>mea.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="salute">Saluta tuos omnes nostro nomine.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><placeName ref="l41">Bernae</placeName> 22. iulii 1564.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p8018">I[ohan<lb xml:id="p1z40"/>nes] Hallerus</persName> tuus.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, domino et <lb xml:id="p2z3"/>compatri summa mihi <lb xml:id="p2z4"/>semper observantia colendo.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
