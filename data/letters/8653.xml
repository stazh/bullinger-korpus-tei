	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non opus erat, mi pater, te hac molestia fatigare, ut tuas ad <placeName ref="l830">Anglos</placeName> literas ad <lb xml:id="p1z2"/>me transmitteres; sed agnosco paterni amoris argumentum et proinde iucunde <lb xml:id="p1z3"/>mihi fuit illarum lectio.</s>
					<s n="3" xml:lang="la">Ego eadem fere scripsi ad <persName ref="p2473">Parkhurstum</persName>, <persName ref="p8391">Iuellum</persName> <lb xml:id="p1z4"/>et <persName ref="p2606">Pilkintonem</persName>; <persName ref="p1341">Grindallo</persName> etiam scripsi propter affinem meum Diethe mum <lb xml:id="p1z5"/>Blarerum, qui ipsi olim convixit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Quid <placeName ref="l327">Montebeligardi</placeName> actum sit, ex <persName ref="p6820">Tossani</persName> <lb xml:id="p1z6"/>literis cognosces, quas mitto.</s>
					<s n="5" xml:lang="la">Dignus est <persName ref="p4183">Iacobus Andreae</persName>, quem <placeName ref="l28">Basilienses</placeName> <lb xml:id="p1z7"/>in pretio habeant.</s>
					<s n="6" xml:lang="la">Quis dubitet eum ex <persName ref="p3099">Sulceri</persName> consilio illac iter fecisse, <lb xml:id="p1z8"/>ut Lutherizantes confirmaret falsis promissis vel etiam fictitia <lb xml:id="p1z9"/>terriculamenta ad Zvinglianismum propensis obiiceret.</s>
					<s n="7" xml:lang="la">Mirum est <lb xml:id="p1z10"/>gigantem illum, cum per nos transiret, nos non uno pede contrivisse.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/>Sed novum bellum molitur, ut <persName ref="p6820">Tossanus</persName> scribit, in quo magis quam <lb xml:id="p1z12"/>hucusque se ridiculum dabit.</s>
					<s n="9" xml:lang="la">Sed quid aliud facerent, qui papatum <lb xml:id="p1z13"/>instauratum volunt et de sola sede cum Romano antichristo certamen <lb xml:id="p1z14"/>habent?</s>
					<s n="10" xml:lang="la">Remitto tuas literas, meas vero ad <persName ref="p1227">Froschouerum</persName> deferri curabo <lb xml:id="p1z15"/>die Martis, si ita volet deus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Spero me quoque ad diem Veneris domum <lb xml:id="p1z16"/>rediturum, nisi uxoris et filiolae conditio aliud iubeat.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Salutabis domum <lb xml:id="p1z17"/>totam.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale, mi pater observande.</s>
					<s n="14" xml:lang="la"><placeName ref="l515">Urdorfi</placeName> 26. augusti 1571.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z18"/>Tui observantissimus <persName ref="p8011">Ro<lb xml:id="p1z19"/>dolphus Gvaltherus</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z2"/>Eximiae ecclesiae Iesu Christi ministro <lb xml:id="p2z3"/>domino <persName ref="p495">Heinrycho Bullingero</persName>, affini <lb xml:id="p2z4"/>et patri suo haud vulgariter observando.</s>
				</p>
				<p>
					<s n="17" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
