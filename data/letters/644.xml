	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Vir optimus est, qui hasce tibi offert, <lb xml:id="p1z2"/>observande <persName ref="p8418">Myconi</persName>, ipse copiose omne suum <lb xml:id="p1z3"/>tibi exponet negotium.</s>
					<s n="3" xml:lang="la">Matura autem, ut <lb xml:id="p1z4"/>omnia mox referantur ad senatum, quo citius ab<lb xml:id="p1z5"/>solvatur et ante calendas septembris <placeName ref="l441">Schaffhusium</placeName> <lb xml:id="p1z6"/>pervenire possit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Utinam impetres illi a tuis <lb xml:id="p1z7"/>quoque viaticum; nostri 4 gl. dederunt.</s>
					<s n="5" xml:lang="de"><foreign xml:lang="la">Hodie <lb xml:id="p1z8"/>eius causam ad senatum retuli; id autem respon<lb xml:id="p1z9"/>si retulit:</foreign> Min herren sind willig, imm <lb xml:id="p1z10"/>und den frommen lüten zuͦ <placeName ref="l1187">Luggaris</placeName> zuͦ <lb xml:id="p1z11"/>hälffen, doch das er sinen handel zuͦ <placeName ref="l41">Bern</placeName>, <placeName ref="l28">Basel</placeName> <lb xml:id="p1z12"/>und <placeName ref="l441">Schaffhusen</placeName> ouch fürtrage und der<lb xml:id="p1z13"/>selben stetten botten jetzund gen <placeName ref="l21">Baden</placeName> <lb xml:id="p1z14"/>mitt bevlech komind uff 3. septembris; <lb xml:id="p1z15"/>da wöllind sy mitteinandren radtschlagen.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z16"/>Interpretis ergo officio utere apud amplis<lb xml:id="p1z17"/>simum senatum <placeName ref="l28">Basiliensem</placeName> aut effice, ut <lb xml:id="p1z18"/>archigramma teus interpretem se praebeat.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z19"/>Habet hic multas literas, quas ut exhibeat <lb xml:id="p1z20"/>tibi, reposce, eas deinde redde, <lb xml:id="p1z21"/>ut usui <lb xml:id="p1z22"/>sint <placeName ref="l441">Schaffhusii</placeName>, praesertim vero literas <lb xml:id="p1z23"/><persName ref="p863">Thaddaei</persName> mihi inscriptas redde; eas <lb xml:id="p1z24"/>enim ad te misi, ut rectius omnia <lb xml:id="p1z25"/>intelligas.</s>
					<s n="8" xml:lang="la">Agis negotium multorum fidelium; <lb xml:id="p1z26"/>utinam tui ex affectu pietatis <lb xml:id="p1z27"/>et humanitatis ei in viaticum <lb xml:id="p1z28"/>aliquid etiam contribuant.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Vale et fideliter <lb xml:id="p1z29"/>fidelis Christi servus causam Christi age.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z30"/><placeName ref="l587">Tiguri</placeName> 21. augusti 1549.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z31"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro D. <lb xml:id="p2z2"/><persName ref="p8418">Osvaldo Myconio</persName>, <lb xml:id="p2z3"/>domino et fratri colendissimo <lb xml:id="p2z4"/>suo<lb xml:id="p2z6"/>.</s>
				</p>
			</div>
		</body>
