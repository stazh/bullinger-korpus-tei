	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Dominus Iesus benedicat tibi et servet te a malo, <lb xml:id="p1z2"/>chare frater.</s>
					<s n="2" xml:lang="la">Libenter legi amicissime acceptum <lb xml:id="p1z3"/>te esse a senatu <placeName ref="l98">Curiensi</placeName> amplissimo et fratribus <lb xml:id="p1z4"/>dilectis.</s>
					<s n="3" xml:lang="la">Non libenter vero legi, quod post tot documenta <lb xml:id="p1z5"/>iustae vocationis tuae tu nihilominus nescio quid <lb xml:id="p1z6"/>dicas de digniore te tibi surrogando.</s>
					<s n="4" xml:lang="la">Frustra hoc petis; <lb xml:id="p1z7"/>memento Ionae, ne quid tibi contingat deterius.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Talentum, quod accepisti, ponito in mensam, suc<lb xml:id="p1z9"/>cessum et lucrum domino, qui tibi dedit et te vocavit, <lb xml:id="p1z10"/>permitte; an oblitus es, quid ei evenerit servo, <lb xml:id="p1z11"/>qui talentum suum involutum sudario defodit?</s>
					<s n="6" xml:lang="la">Nihil <lb xml:id="p1z12"/>praeterea turpius tibi evenire et irrogari posset, <lb xml:id="p1z13"/>quam si nunc manumissus alium haberes successorem.</s>
					<s n="7" xml:lang="la">Ergo man<lb xml:id="p1z14"/>us <lb xml:id="p1z15"/>praebeto domino et dic cum propheta: "Loquatur <lb xml:id="p1z16"/>dominus meus, et audiet servus."</s>
					<s n="8" xml:lang="la">Quam <lb xml:id="p1z17"/>imprudenter vero quereris interim, dum tu <placeName ref="l98">Curiae</placeName> <lb xml:id="p1z18"/>haeres per mensem aut sesquimensem, domi fame <lb xml:id="p1z19"/>perituram uxorem cum liberis!</s>
					<s n="9" xml:lang="la">Itane habitat <lb xml:id="p1z20"/>inter barbaros, ut nemo sit, si omnibus destituatur, <lb xml:id="p1z21"/>qui sarciat eius inopiam, an vero tu oeconomiam <lb xml:id="p1z22"/>ita instituisti, ut domus tua non habeat in <lb xml:id="p1z23"/>sesquimensem, unde vivat?</s>
					<s n="10" xml:lang="la">Vide, vide, mi frater, <lb xml:id="p1z24"/>ne nimium querulando dominum offendas et te <lb xml:id="p1z25"/>bonis viris et amicis tuis parum commendes.</s>
					<s n="11" xml:lang="la">Caeterum <lb xml:id="p1z26"/>tribuo haec animo tuo nunc quidem anxio <lb xml:id="p1z27"/>et utcunque habeo excusatum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Vide tamen pro tua <lb xml:id="p1z28"/>pietate, ut haec aliquando omnia sarcias et vita <lb xml:id="p1z29"/>moribusque te dignis rectius instituas.</s>
					<s n="13" xml:lang="la">Habes dominum <lb xml:id="p1z30"/>clementem et potentem, qui invocatus tibi non <lb xml:id="p1z31"/>deerit.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale iterum <lb xml:id="p1z32"/>et me semper utere <lb xml:id="p1z33"/>ut tuo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName> festinantissime 6. ianuarii <lb xml:id="p1z34"/>anno domini 1567.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z37"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z38"/>D. d. d. consules ex me salutabis amicissime.</s>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <persName ref="p8016">Thobiae <lb xml:id="p2z2"/>Eglio</persName>, fideli <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro, domino <lb xml:id="p2z4"/>meo colendo et fratri charissim<lb xml:id="p2z5"/>o.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
