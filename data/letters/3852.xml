	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la">Si tan cito p[raestantiae] t[uae] non respondi, illa <lb xml:id="p1z2"/>me excusatum habeat; nihil enim, quod scribere <lb xml:id="p1z3"/>possim, sese offerebat; scribsissem enim de supplicio <lb xml:id="p1z5"/>miserorum <placeName ref="l832">Galorum</placeName> ad te, quem humanissimum <lb xml:id="p1z6"/>scio?</s>
					<s n="3" xml:lang="la">et si, qui sanguinem sitiverunt, habuerunt, <lb xml:id="p1z7"/>quem liberent.</s>
					<s n="4" xml:lang="la">Multa audimus ab Augusto, sed p[<lb xml:id="p1z8"/>raestantiae] t[uae] omnia prius nota esse scio.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><placeName ref="l425">Roma</placeName> intelligitur ponti<lb xml:id="p1z9"/>ficem, et eum quidem delirantem, ut scribunt, sevire in<lb xml:id="p1z10"/>cendiose in libros multos, quorum catalogum mitto p[raestantiae] t[uae] et e<lb xml:id="p1z11"/>os postmodum ad me remittat, rogo, ut eos amicis in <placeName ref="l832">Gallia</placeName> communicem.</s>
					<s n="6" xml:lang="la">Si quid p<lb xml:id="p1z12"/>ostea te dignum intellexero, labori et calamo non parcam.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Interim illam feli[cit]er val<lb xml:id="p1z13"/>ere opto.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Datum <placeName ref="l98">Curie</placeName> die pr<lb xml:id="p1z14"/>ima februarii 1559.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">P[raestantiae] t[uae] deditissimus <persName ref="p8306">I[oannes] I[acobus] Decambray</persName>.</s>
					<s n="10" xml:lang="la">Clarissimo viro <lb xml:id="p1z15"/>pietate et eruditione excellenti domino <persName ref="p495">Henrico Bulingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae minis<lb xml:id="p1z16"/>tro, domino et amico suo colendo.</s>
					<s n="11" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note type="regest">Er hat aus Mangel an Stoff bisher nicht erwidert.</note>
					<s n="12" xml:lang="la">Scripsisse<lb xml:id="p1z17"/>m enim de supplicio miserorum <lb xml:id="p1z18"/><placeName ref="l832">Gallorum</placeName> ad te, quem <pb/><lb xml:id="p2z1"/>humanissimum scio, et si qui sanguinem siti<lb xml:id="p2z2"/>verunt, habuerunt, quem biberent... <placeName ref="l425">Roma</placeName> intell<lb xml:id="p2z3"/>igimus pontificem, et eum quidem delirantem, ut scribunt, sa<lb xml:id="p2z4"/>evire incendiose in libros multos, quorum catalogum mitto.</s>
					<s n="13" xml:lang="la"><placeName ref="l98">Curiae</placeName>, <lb xml:id="p2z5"/>1. februarii 1559.</s>
				</p>
			</div>
		</body>
	</text>
