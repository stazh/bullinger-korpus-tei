	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Veni <placeName ref="l512">Tubingam</placeName> hodie <placeName ref="l496">Stutgardiam</placeName> statim reditu<lb xml:id="p1z2"/>rus.</s>
					<s n="2" xml:lang="la">Cum vero inciderim in nuncium <placeName ref="l291">Lindavium</placeName> <lb xml:id="p1z3"/>proficiscentem, volui experiri, si hae meae litterae <lb xml:id="p1z4"/>possent cito ad te perferri.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Res feliciter gesta <lb xml:id="p1z5"/>in <placeName ref="l2472">Polonia</placeName>; statutum enim, ut sub utraque, ut mi<lb xml:id="p1z6"/>nistri sint coniuges, ut omnia populari lingua <lb xml:id="p1z7"/>in templis, ut praedicetur purum evangeli<lb xml:id="p1z8"/>um.</s>
					<s n="4" xml:lang="la">Hoc nunciato fratribus, ut gratias agant <lb xml:id="p1z9"/>deo pro hoc principio.</s>
					<s n="5" xml:lang="la"><placeName ref="l18">Augustae</placeName> etiam res <lb xml:id="p1z10"/>bene gesta: pacem nobis adversarii conce<lb xml:id="p1z11"/>dunt, quomodo scies postea.</s>
					<s n="6" xml:lang="la">Vidi, quid <lb xml:id="p1z12"/>vester amplissimus senatus in causam meorum <lb xml:id="p1z13"/>fratrum <placeName ref="l294">Locarnensium</placeName>, omnia recte; <lb xml:id="p1z14"/>sed de ministro aliud expectavi, non quod <lb xml:id="p1z15"/>improbem <persName ref="p293">Beccariam</persName> nostrum, - est enim bonus <lb xml:id="p1z16"/>vir -; sed isti novae ecclesiae alium cultorem <lb xml:id="p1z17"/>opto, de quo postea pluribus.</s>
					<s n="7" xml:lang="la">Consolatur me, <lb xml:id="p1z18"/>quod est in fine decreti, hoc est: aliam rationem <lb xml:id="p1z19"/>velle inire senatum, si <persName ref="p293">Beccaria</persName> <lb xml:id="p1z20"/>non videbitur idoneus.</s>
					<s n="8" xml:lang="la">Ego me isti ecclesie <lb xml:id="p1z21"/>inserui.</s>
					<s n="9" xml:lang="la">Cogar quotidie pro ea <lb xml:id="p1z22"/>solicitus esse.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Salvere iubeo omnes; <lb xml:id="p1z23"/>orate pro me.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/><placeName ref="l512">Tubingae</placeName> 12. iunii 1555.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z25"/><persName ref="p3375">Vergeriu<pb/><lb xml:id="p2z1"/>s</persName>.</s>
				</p>
				<p>
					<note>[Von anderer Hand:]</note>
					<s n="13" xml:lang="de">Dem wirdigen hern <lb xml:id="p2z2"/><persName ref="p495">Heinrich Bullinger</persName>, <lb xml:id="p2z3"/>predicanten zu <placeName ref="l587">Zurich</placeName>, <lb xml:id="p2z4"/>meinem gunstigen <lb xml:id="p2z5"/>hern und guten freundt, <lb xml:id="p2z6"/>zu handen.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>