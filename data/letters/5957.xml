	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName>Antonius Vincentius</persName> d. <persName ref="p495">Henrico Bullingero</persName> S. P. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Etsi nullum beneficium, cum isthic discipulus d. <persName ref="p3988">Ioannis <lb xml:id="p1z3"/>Wolfii</persName> essem, in te contuli neque ab eo tempore, quo ad nos redii, <lb xml:id="p1z4"/>tibi ulla in re officium praestiti, quod nihilominus facere <lb xml:id="p1z5"/>summo studio teneor, cum sese mihi occasio offeret, tamen <lb xml:id="p1z6"/>etiam nunc has literas scribere non sum veritus, quibus <lb xml:id="p1z7"/>meo more id oneris tibi imponam, ut et fratrem et consobrinum <lb xml:id="p1z8"/>meum et praeceptorem eorum, qui isthuc operam literis <lb xml:id="p1z9"/>humanioribus daturi profecti sunt, in fidem et amicitiam <lb xml:id="p1z10"/>tuam recipias eosque tanquam peregrinos omnibus in rebus <lb xml:id="p1z11"/>opera et diligentia tua iuves.</s>
					<s n="3" xml:lang="la">Quod si feceris, quicquid in <lb xml:id="p1z12"/>eos officii et studii contuleris, id omne in me ipsum te contulisse <lb xml:id="p1z13"/>arbitrabor confidoque deo bene iuvante me non immemorem <lb xml:id="p1z14"/>futurum.</s>
					<s n="4" xml:lang="la">Verum quia mihi ipsi persuasi, quę tua est <lb xml:id="p1z15"/>humanitas, mea causa eorum te commodis nunquam defuturum, <lb xml:id="p1z16"/>pluribus tecum non agam, sed modum scribendi faciam deumque <lb xml:id="p1z17"/>optimum maximum deprecabor, ut tuorum bonorum consiliorum <lb xml:id="p1z18"/>dux ac fautor esse velit.</s>
					<s n="5" xml:lang="la" ana="salute">Familiae tuae salutem dici meo nomine vehem<lb xml:id="p1z19"/>enter cupio; tu me, ut facis, ama.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l301">Lugduni</placeName> calendis decembris.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Doctissimo maximeque pio domino <persName ref="p495">Henrico Bul<lb xml:id="p1z20"/>lingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae ministro.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note>[Bemerkung von Bullinger unter dem Text des Briefes (an <persName ref="p3988">Johannes Wolf</persName>?):]</note>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Cum graviter confligam cum tussi et catharro diebus <lb xml:id="p1z22"/>iam tribus, non potui te, amicissime affinis accedere.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z23"/>Venerunt ad me <persName>Galli</persName>, petunt hospitem.</s>
					<s n="12" xml:lang="la">Ego cum me <lb xml:id="p1z24"/>servem feriis nec egrediar, te oro, ut illis consulas.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z25"/>Meministi <persName>Barbaram Koffliam</persName><note type="misc"><persName>Roffliam</persName>?</note> postulare, ut darentur eis modes<lb xml:id="p1z26"/>ti ali<lb xml:id="p1z27"/>quot viri.</s>
					<s n="14" xml:lang="la">Non tamen vel <persName ref="p19606">V<lb xml:id="p1z28"/>incentii</persName> huius memi<lb xml:id="p1z29"/>ni neque novi, quinam isti sint.</s>
					<s n="15" xml:lang="la">Diverterunt ad <lb xml:id="p1z30"/>Ciconiam; iam a me discesserunt.</s>
					<s n="16" xml:lang="la">Habes <lb xml:id="p1z31"/>hic <persName ref="p8033">Bezae</persName> <lb xml:id="p1z32"/>quoque literas, quas una cum his remitte.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="18" xml:lang="de">Gott <lb xml:id="p1z33"/>sye trüwlich gelopt, das ir erfröwt sind; das ist des <lb xml:id="p1z34"/><persName>Elßbets</persName><note type="misc"><persName ref="p495">Bullingers</persName> Magd <persName>Elsbeth Kern</persName>, gest. 30. Okt. 1574.; <bibl source="b288">HBD</bibl> 123, 12f</note> bot<pb/><lb xml:id="p2z1"/>t<lb xml:id="p2z2"/>enbro<lb xml:id="p2z3"/>t<lb xml:id="p2z4"/>.</s>
				</p>
			</div>
		</body>
	</text>
