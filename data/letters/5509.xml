	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime atque ornatissime d. <persName ref="p495">Bullingere</persName>, literas quas mi<lb xml:id="p1z2"/>hi cum studioso quodam familiarissime scriptas misisti, <lb xml:id="p1z3"/>accepi, ex quibus tuum erga me animum benevolum <lb xml:id="p1z4"/>satis perspexi, quibus utinam pro dignitate, et quidem per <lb xml:id="p1z5"/>occupationes, quibus quotidie in rebus typographicis <lb xml:id="p1z6"/>obruor, respondere possem.</s>
					<s n="2" xml:lang="la">Tam enim devinctum hoc <lb xml:id="p1z7"/>modo me tibi reddidisti, ut omne quod in me est, tibi <lb xml:id="p1z8"/>me debere libenter agnoscam.</s>
					<s n="3" xml:lang="la">Sed tu, quia minus hoc <lb xml:id="p1z9"/>praestare valeo, mihi dabis veniam, et dum vires <lb xml:id="p1z10"/>deesse videris, voluntatem laudabis, donec commodius potero.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z11"/>Fateor iniuste me facere: ut quimus tamen quando <lb xml:id="p1z12"/>ut volumus non licet.</s>
					<s n="5" xml:lang="la" ana="salute">- <lb xml:id="p1z13"/>Salutem qua me do<lb xml:id="p1z14"/>minum impartiri iussisti, annunciavi, qui tibi magnas <lb xml:id="p1z15"/>agit gratias, ac tantundem reprecatur.</s>
					<s n="6" xml:lang="la">Scripsit quoque <lb xml:id="p1z16"/>ipse, ni fallor, cum hoc domino magistro, qui has tibi affert <lb xml:id="p1z17"/>literas.</s>
					<s n="7" xml:lang="la">De indice porro in <persName ref="p1214">Fricio</persName> cuius mentio fit <lb xml:id="p1z18"/>in titulo, profecto memorem mones; nam propter instantes <lb xml:id="p1z19"/>nundinas apponi non potuit, alias fuit perfectus.</s>
					<s n="8" xml:lang="la">Ubi vero <lb xml:id="p1z20"/>et hunc typis mandabimus, prima quaque occasione tibi trans<lb xml:id="p1z21"/>mittam.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Impressori nummum dedi, ut voluisti, qui maxim<lb xml:id="p1z22"/>as gratias tibi agere mandavit, maximopereque petit, ut <lb xml:id="p1z23"/>ignoscas quod non, ut promisit, rediit.</s>
					<s n="10" xml:lang="la">Haec breviter tibi <lb xml:id="p1z24"/>indicanda esse putavi, quae ut in bonam partem accipias <lb xml:id="p1z25"/>vehementer peto.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale unicum studiorum decus, et me tibi <lb xml:id="p1z26"/>commendatum habe.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l28">Basileae</placeName> 13. novemb[ris].</s>
				</p>
				<p>
					<s n="13" xml:lang="la">T[uus] <persName ref="p8487">Hieremias Mylius</persName> <placeName ref="l284">Lipsen<pb/><lb xml:id="p2z1"/>sis</placeName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Clarissimo viro, doctrina pietateque <lb xml:id="p2z2"/>excellentissimo d. <persName ref="p495">Henricho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z4"/>ministro fidelissimo, domino <lb xml:id="p2z5"/>et mecoenati suo colendissimo.</s>
					<s n="15" xml:lang="la"><foreign xml:lang="el">ἀω</foreign> o<lb xml:id="p2z6"/>der <foreign xml:lang="el">ἀεί</foreign> <placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>