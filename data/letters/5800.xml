	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuas, reverende pater, hodie nullas accipio; tribuo <lb xml:id="p1z2"/>hoc tuis immensis occupationibus.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Quae habebam <lb xml:id="p1z3"/>de concilio et rebus <placeName ref="l834">Italicis</placeName>, misi cum Italo.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Non <lb xml:id="p1z4"/>semel iam significare volui <placeName ref="l1121">Genuenses</placeName> militem <placeName ref="l822">Germanum</placeName> <lb xml:id="p1z5"/>denuo dimisisse, quod argumento est eos sibi a <lb xml:id="p1z6"/><placeName ref="l2510">Turcica</placeName> irruptione non magnopere timere.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Haec, <lb xml:id="p1z7"/>quae mitto, enotavit <persName ref="p8114">Balingketus</persName> ex suis.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>29. iunii hora 21., id est, ut nos numeramus, hora 5. pomeridiana <lb xml:id="p1z9"/>venit quidam <placeName ref="l522">Venetus</placeName> celoci vectus, <foreign xml:lang="de">in einem jagschiff,</foreign> <lb xml:id="p1z10"/>ex Catharo (quis ille locus sit aut quae insula, non mihi constat; <lb xml:id="p1z11"/>mappis enim destituor) nuncians duci <placeName ref="l522">Veneto</placeName> terrae motu concidisse <lb xml:id="p1z12"/>ibidem palatium et oppressisse gubernatorem vel praefectum <lb xml:id="p1z13"/><placeName ref="l522">Venetum</placeName> cum omni familia; per idem tempus <lb xml:id="p1z14"/>fulmine disiectam domum, quam appellant munitionis, arma<lb xml:id="p1z15"/>mentarium inquam, ubi magna vis pulveris tormentarii <lb xml:id="p1z16"/>erat reposita, et homines perdidisse circiter sexcentos.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/>Antequam has obsignarem, redduntur mihi affinis mei <lb xml:id="p1z18"/>literae, quibus significat te non recte habere.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Quod <lb xml:id="p1z19"/>quidem invitus audivi; sed additum erat, <lb xml:id="p1z20"/>quod me recreavit, bonam spem esse brevi <lb xml:id="p1z21"/>recuperandae valetudinis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Si convaluisti, <lb xml:id="p1z22"/>quod omnino spero et opto, nos edoceas certi aliquid <lb xml:id="p1z23"/>de rebus <placeName ref="l832">Gallicis</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l167">Genevenses</placeName> nihilne scribunt?</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/>Immeritone <persName>Condensis</persName> a nonnullis male audit?</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Fingunt<lb xml:id="p1z25"/>ne id papistae?</s>
					<s n="13" xml:lang="la">Quid de caede <persName>Ringravii</persName> amplius, <lb xml:id="p1z26"/>quid de virtute <placeName ref="l830">Anglorum</placeName>?</s>
					<s n="14" xml:lang="la"><placeName ref="l301">Lugdunensesne</placeName> pfaffos in urbem <lb xml:id="p1z27"/>receperunt?</s>
					<s n="15" xml:lang="la">Pax constat?</s>
					<s n="16" xml:lang="la">De his saltem aliquid.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell"><pb/><lb xml:id="p2z1"/>Vale, reverende in Christo pater, et mihi ignosce, qui toties <lb xml:id="p2z2"/>tibi molestus esse non desino.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Valeant tui omnes.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute">Nostri omnes te officiose salutant.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l98">Curię</placeName> 5. iulii <lb xml:id="p2z3"/>anno 1563.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Tui observantissimus <persName ref="p8009">I[oannes] F[abricius</persName>].</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Amplissimo viro d. <persName ref="p495">Heinrycho Bullingero</persName>, domino s<lb xml:id="p2z4"/>uo et in Christo patri semper honorando.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>