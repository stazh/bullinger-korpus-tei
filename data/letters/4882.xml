					<lb xml:id="p1z5"/>Unnserr gunstigen grues, erwurdigen be
					<lb xml:id="p1z6"/>S8.
					<lb xml:id="p1z7"/>sunderer lieber unnd gueter freundt,
					<lb xml:id="p1z8"/>hat unnszaiger diß Machias boltzwart, underthe
					<lb xml:id="p1z9"/>niglich bericht, nachdem er ein ze tlang der drust
					<lb xml:id="p1z10"/>der schrelen im Ferckhrerceh, unnserer oberkhait
					<lb xml:id="p1z11"/>trewlich und seins lesten vermogens dersehen
					<lb xml:id="p1z12"/>unnd die ingem alder zu Markhiech Anderwißen
					<lb xml:id="p1z13"/>aben von wegen geringe der besoldung solchen
					<lb xml:id="p1z14"/>dienst widerumb albergeben, das er jetzumal
					<lb xml:id="p1z15"/>willens, sich zu euch gerr Zürich zu verfüngen.
					<lb xml:id="p1z16"/>Ober illeicht alda zu einer corractur uff der
					<lb xml:id="p1z17"/>trnckherrn komen unnd erlangen und daselbst
					<lb xml:id="p1z18"/>sein zevlang beiden studyis bleiben modhst.
					<lb xml:id="p1z19"/>Min underthenger bit, dieweil wir inen diser
					<lb xml:id="p1z20"/>zei in unsern herschafften mi keinem dienst
					<lb xml:id="p1z21"/>so fur inen sein möcht zu verseherwisen), das
					<lb xml:id="p1z22"/>wir imenn fürschrift an euch gnedigliche
					<lb xml:id="p1z23"/>holffen sein wolten, uff das er inn ewerer befur
					<lb xml:id="p1z24"/>erwa enidienst oder sondition erlangen
					<lb xml:id="p1z25"/>Alie ir dann Fereners kon init
					<lb xml:id="p1z26"/>möcht.
					<lb xml:id="p1z27"/>welche win
					<lb xml:id="p1z28"/>vernemen werden.
					<lb xml:id="p1z29"/>ime in haben wißen obzuschlagen. sunder
					<lb xml:id="p1z30"/>ist an euch unser günstigs unnd freundtlichs
					<lb xml:id="p1z31"/>gesinnen er wolle euch obgarverten
					<lb xml:id="p1z32"/>holtzwart von unsertwegen befolhen sein laßen
					<lb xml:id="p1z33"/>unnd gunstiglich dahin befürdern, daruit er
					<lb xml:id="p1z34"/>bi euch zue Zürich einen begnentlichen diennst
					<pb/>
					<lb xml:id="p2z1"/>Wir derselbig seiner verfohn nach sein wurder
					<lb xml:id="p2z2"/>Gegerwir im kainen
					<lb xml:id="p2z3"/>bekhaner möcht.
					<lb xml:id="p2z4"/>zwemel, erwerd sichfleußug unnd daucch barlich
					<lb xml:id="p2z5"/>gegen meinglich beweifer unnd erzaigen. Das
					<lb xml:id="p2z6"/>unns iin gunstigen unnd freundtlichem
					<lb xml:id="p2z7"/>willen gegen euch zu beschulden. Datim
					<lb xml:id="p2z8"/>Rafoltzweiler den 19. iulii anno etc.
