	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quod nihil rescribis, colligo te meis nuper missis<note xml:id="fn1" type="footnote" n="1">Hier kann nicht <persName ref="p8018">Hallers</persName> Brief an <persName ref="p495">Bullinger</persName> vom 5. Juli (<ref target="file12991">Nr. 2942</ref>) gemeint sein, sondern vielmehr ein kurz zuvor verfasstes, nicht mehr erhaltenes Schreiben, das auch in <ref target="file12991">Nr. 2942</ref>,<ptr target="qvzl17207-1" type="qv"/>, belegt ist.<ptr target="zfnfn17215-4" type="zfn"/></note> offensum; <lb xml:id="p1z2"/>sed quod non immerito scripserim cum stomacho, testatur n<lb xml:id="p1z3"/>egotium praesens.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="3" xml:lang="la">Indicta sunt comitia ad calendas septembris in u<lb xml:id="p1z4"/>rbe nostra.<note xml:id="fn2" type="footnote" n="2">Siehe dazu <ref target="file13001">Nr. 2952</ref>, <ptr target="qvfn17218-1" type="qv"/>.</note></s>
					<s n="4" xml:lang="la">Expectamus intra triduum ipsum <foreign xml:lang="el">αὐτοκράτορα</foreign><note xml:id="fn3" type="footnote" n="3">Diktator (hier Kaiser <persName ref="p18538">Karl V.</persName>). - Zu dessen Ankunft in <placeName ref="l18">Augsburg</placeName> s. <ref target="file13001">Nr. 2952</ref>, <ptr target="qvfn17218-2" type="qv"/>.</note>.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Deputantur iam hospitia singulis principibus.</s>
					<s n="6" xml:lang="la">Erunt enim fre<lb xml:id="p1z6"/>quentissimi.</s>
					<s n="7" xml:lang="la">Confluunt <placeName ref="l875">Iberi</placeName> frequentes.</s>
					<s n="8" xml:lang="la">Quid nobiscum<note xml:id="fn4" type="footnote" n="4">mit den protestantischen Pfarrern in <placeName ref="l18">Augsburg</placeName>.</note> sit <lb xml:id="p1z7"/>futurum, ignoramus.</s>
					<s n="9" xml:lang="la">Sumus ludibrio omnibus<note xml:id="fn5" type="footnote" n="5"><cit type="bible"><ref>Ps 44 (Vulg. 43), 13</ref></cit>; <cit type="bible"><ref>79 (Vulg. 78), 4</ref></cit>.</note> et inaestima<lb xml:id="p1z8"/>bilibus premimur periculis.</s>
					<s n="10" xml:lang="la">Dux <persName ref="p4757">Camerinus</persName><note xml:id="fn6" type="footnote" ana="bio" n="6"><persName ref="p4757">Ottavio Farnese</persName> (1524-1586), Herr von <placeName ref="l2787">Camerino</placeName>. Er war der Enkel von Papst <persName ref="p19981">Paul III.</persName> und seit 1538 verheiratet mit <persName ref="p7704">Margarethe von Parma</persName>, der unehelichen Tochter Kaiser <persName ref="p18538">Karls V.</persName></note>, caesaris <lb xml:id="p1z9"/>gener et nepos <persName ref="p19981">pontificis</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p19981">Paul III.</persName></note>, <pb type="edition" next="306"/> iam 8 diebus hic fuit.</s>
					<s n="11" xml:lang="la">Consul <persName ref="p3927">Welserus</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p3927">Hans Welser</persName>.</note> <lb xml:id="p1z10"/>praesentiscens illa ad <placeName ref="l1618">Pfäfers</placeName><note xml:id="fn9" type="footnote" n="9">Bad <placeName ref="l1618">Pfäfers</placeName>, etwa 4 km südlich von <placeName ref="l2428">Bad Ragaz</placeName>. Vgl. auch <ref target="file12994">Nr. 2945</ref>,<ptr target="qvzl17217-5" type="qv"/>. - Zum Bad s. <persName ref="p7061">Johannes <hi>Winter</hi> (von Andernach)</persName>, Allerheylsamen Bäder, <placeName ref="l491">Straßburg</placeName> 1580 (<bibl source="https://gateway-bayern.de/VD16+W+3539">VD16 W3539</bibl>), S. 16-19. - <persName ref="p3927">Welser</persName>, der dieser Stelle zufolge <placeName ref="l18">Augsburg</placeName> etwa um den 6. Juli verlassen hatte, kehrte am 26. Juli oder kurz zuvor dorthin zurück; s. <ref target="file13079">Nr. 3030</ref>,<ptr target="qvzl17299-1" type="qv"/>.<ptr target="zfnfn17215-1" type="zfn"/></note> profectus est cum omni familia.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z11"/>In aedibus eius erit ducas<note xml:id="fn10" type="footnote" n="10">Von <foreign xml:lang="el">δούκας</foreign>, der gräzisierten, mittelalterlichen Ableitung von dux; s. <bibl source="b616">Stotz</bibl> I 569f, Nr. 18.2.</note> <persName ref="p20183">Albanus</persName>.<note xml:id="fn11" type="footnote" n="11"><persName ref="p20183">Fernando Álvarez de Toledo</persName>, Herzog von <placeName ref="l3178">Alba</placeName>, traf am 21. oder 22. Juli in <placeName ref="l18">Augsburg</placeName> ein; vgl. <ref target="file13010">Nr. 2961</ref>,<ptr target="qvzl17226-2" type="qv"/>; <ref target="file13011">Nr. 2962</ref>,<ptr target="qvzl17227-2" type="qv"/>; <ref target="file13019">Nr. 2970</ref>,<ptr target="qvzl17236-25" type="qv"/> (vielleicht entspricht das von <persName ref="p8354">Frölich</persName> in <ref target="file13010">Nr. 2961</ref> angeführte Briefdatum nicht dem Abfassungstag seines Briefes). - Für weitere Angaben zu den Einquartierungen der Kaiserlichen s. <bibl>RTA-JR</bibl> XVIII/1 197-200, Nr. 27f; <ref target="file13011">Nr. 2962</ref>, <ptr target="qvfn17227-4" type="qv"/>.<ptr target="zfnfn17215-5" type="zfn"/></note></s>
					<s n="13" xml:lang="la">Adducuntur captivi <persName ref="p19065">elector</persName><note xml:id="fn12" type="footnote" n="12"><persName ref="p19065">Johann Friedrich I. von Sachsen</persName>. - Er wurde am 26. Juli zwischen fünf und sechs Uhr abends auf einem Wagen sitzend und von 600 <placeName ref="l875">spanischen</placeName> Hakenschützen bewacht in die Stadt geführt; s. <ref target="file13019">Nr. 2970</ref>,<ptr target="qvzl17236-12" type="qv"/>; <bibl>Roth, Augsburg</bibl> IV 46f.</note> <lb xml:id="p1z12"/>et <persName ref="p3590">langrafius</persName>.<note xml:id="fn13" type="footnote" n="13"><persName ref="p3590">Philipp von Hessen</persName>.</note></s>
					<s n="14" xml:lang="la">Liber venit <persName ref="p20318">Heinrychus Brunsvicensis</persName>.<note xml:id="fn14" type="footnote" n="14">Herzog <persName ref="p20318">Heinrich d.J. von Braunschweig-Wolfenbüttel</persName>. Er war am 18. Juni freigelassen worden; s. <ref target="file12969">Nr. 2920</ref>, <ptr target="qvfn17185-1" type="qv"/>.</note></s>
					<s n="15" xml:lang="la">Vicinus <lb xml:id="p1z13"/>meus erit <persName ref="p7706">Granvella</persName><note xml:id="fn15" type="footnote" n="15"><persName ref="p7706">Nicolas de Perrenot, Herr von Granvelle</persName>. Er traf noch am 14. Juli in <placeName ref="l18">Augsburg</placeName> ein; s. <bibl>Roth, Augsburg</bibl> IV 44.<ptr target="zfnfn17215-3" type="zfn"/></note> et <persName ref="p7705">episcopus Arelatensis</persName><note xml:id="fn16" type="footnote" ana="bio" n="16">Hier ist nicht <persName ref="p18742">Jean Ferrier II.</persName>, Bischof von <placeName ref="l2723">Arles (Arelate)</placeName>, sondern <persName ref="p7705">Antoine de Perrenot</persName> (1517-1586), Bischof von <placeName ref="l2165">Arras (Atrebatum)</placeName>, Sohn des oben genannten <persName ref="p7706">Nicolas</persName>, gemeint.</note> et aliquot abbates.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z14"/>Vereor, ne et ego cogar habere <placeName ref="l875">Hispanos</placeName>.</s>
					<s n="17" xml:lang="la">Haec est illa, quam nobis <lb xml:id="p1z15"/>illi<note xml:id="fn17" type="footnote" n="17">Die <placeName ref="l18">Augsburger</placeName> Ratsherren. - Anspielung auf das in <ref target="file12957">Nr. 2908</ref>, <ptr target="qvfn17174-1" type="qv"/>, überlieferte Versprechen.</note> praestant, tutela!</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="18" xml:lang="la">Age!</s>
					<s n="19" xml:lang="la">Vos voluistis me manere.<note xml:id="fn18" type="footnote" n="18">Vgl. <ref target="file12966">Nr. 2917</ref>,<ptr target="qvzl17183-3" type="qv"/>.</note></s>
					<s n="20" xml:lang="la">Ma<lb xml:id="p1z16"/>nebo ergo et forti fide quemvis expectabo eventum!</s>
					<s n="21" xml:lang="la">Quem <lb xml:id="p1z17"/>hactenus coram publicanis<note xml:id="fn19" type="footnote" n="19">Hier auf die Kaufleute bezogen.</note> professus sum Christum, nunc coram <lb xml:id="p1z18"/>Herodianis<note xml:id="fn20" type="footnote" n="20">Hier sind die Christus feindlich gesinnten Mächtigen der Zeit gemeint.</note> non negabo, et pharisaeis!<note xml:id="fn21" type="footnote" n="21">Auf die heuchlerischen Theologen (Pfarrer) gemünzt.</note></s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="22" xml:lang="la" ana="farewell">Vale.</s>
					<s n="23" xml:lang="la">Si quid scribere <lb xml:id="p1z19"/>velis, scribe caute.</s>
					<s n="24" xml:lang="la">Nescio, quando plura possim.</s>
					<s n="25" xml:lang="la">14. iulii <lb xml:id="p1z20"/>1547.</s>
					<s n="26" xml:lang="la"><lb xml:id="p1z21"/><persName ref="p8018">I. Hallerus</persName> tuus perpetuo.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="27" xml:lang="de"><pb type="scan" next="v."/><pb/><lb xml:id="p2z1"/><foreign xml:lang="la">Postquam has scripsi</foreign>, so furiert man uns in<note xml:id="fn22" type="footnote" n="22">furiert in: quartiert ein.</note>, in unser kloster<note xml:id="fn23" type="footnote" n="23">Die Liegenschaft des Klosters St. Anna, wo u.a. das Kollegium und das "Wunderhaus" lagen; s. <ref target="file12933">Nr. 2884</ref>, <ptr target="qvfn17151-4" type="qv"/>.</note>, <foreign xml:lang="la">ubi ha[bi]tamus<note xml:id="fna" type="footnote" n="a"><hi>Hier und unten Text teils im engen Einband verdeckt.</hi></note>, <lb xml:id="p2z2"/><persName ref="p8122">Meyerus</persName>, <persName ref="p1860">Cellarius</persName>, <persName ref="p8173">Xystus</persName><note xml:id="fn24" type="footnote" n="24"><persName ref="p8122">Nikolaus Müller gen. Maier</persName>, <persName ref="p1860">Michael Keller</persName> und <persName ref="p8173">Sixt Birck</persName>.</note> et ego</foreign>, 40 rüter (und <lb xml:id="p2z3"/>hab ich doch sonst <persName ref="p2812">Romanum</persName><note xml:id="fn25" type="footnote" n="25"><persName ref="p2812">(Hans) Thoman Ruman (Römer)</persName>, der offensichtlich nach Anfang Mai 1547 nochmals umgezogen war; vgl. <ref target="file12943">Nr. 2894</ref> und <ptr target="qvfn17159-9" type="qv"/>.</note> zuͦ mir gnon).<note xml:id="fnb" type="footnote" n="b"><hi>Klammern ergänzt.</hi></note></s>
					<s n="28" xml:lang="de">Sobald einer<note xml:id="fnc" type="footnote" n="c"><hi>In der Vorlage</hi> eir.</note> ein wort<note xml:id="fnd" type="footnote" n="d"><hi>In der Vorlage</hi> wo.</note> <lb xml:id="p2z4"/>sagt, so sa-<pb type="edition" next="307"/>gend si, si syend herren.</s>
					<s n="29" xml:lang="de">Es darff kein bürger me <lb xml:id="p2z5"/>kauß<note xml:id="fn26" type="footnote" n="26">(einen) Mucks; s. <bibl source="b590">SI</bibl> III 515.</note> sagen.</s>
					<s n="30" xml:lang="la">Mira, mira iam fiunt!</s>
					<s n="31" xml:lang="la">Iam pueri, nedum vi[r]gines <lb xml:id="p2z6"/>corrumpuntur!</s>
					<s n="32" xml:lang="la">Tam bene nobis et ecclesiae consulitur!</s>
					<s n="33" xml:lang="la">Tam multum aedificamus!<note xml:id="fn27" type="footnote" n="27">Ironisch gemeint.</note></s>
				</p>
				<p>
					<note type="address">[Adresse darunter:]</note>
					<s n="34" xml:lang="la">Clarissimo viro d. <lb xml:id="p2z7"/><persName ref="p495">Bullingero</persName>, patri suo colendo.</s>
					<s n="35" xml:lang="de"><placeName ref="l587">Zürich</placeName>.<note xml:id="fn28" type="footnote" n="28">Dieser Brief wurde via <placeName ref="l473">St. Gallen</placeName> nach <placeName ref="l587">Zürich</placeName> befördert; s. <ref target="file13006">Nr. 2957</ref>,[1].<ptr target="zfnfn17215-2" type="zfn"/></note></s>
				</p>
			</div>
		</body>
	</text>
</TEI>