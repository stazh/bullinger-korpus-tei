			<zone xml:id="p2z6-0" points="496,646 604,604 1011,638 1278,583 1431,625 1830,596 2197,688 2344,646 2604,688 2601,575 2557,556 2520,598 2355,543 1234,533 1095,488 832,562 638,517 494,564">510,597 620,594 730,594 841,591 951,588 1062,585 1172,582 1283,582 1393,585 1504,586 1614,588 1725,591 1835,597 1946,603 2056,612 2167,617 2277,626 2388,635 2498,638 2609,647</zone>
			<zone xml:id="p2z7-0" points="507,696 643,717 685,688 740,709 808,675 890,706 1045,690 1179,717 1179,651 1129,630 1089,648 979,625 950,646 892,604 693,606 669,627 612,606 507,638">522,674 555,672 588,671 621,672 654,674 687,674 720,674 754,673 787,671 820,671 853,672 886,674 919,674 952,674 986,674 1019,674 1052,674 1085,676 1118,677 1151,677 1185,677</zone>
