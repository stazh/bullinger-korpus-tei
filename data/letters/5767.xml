	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Qam dolenter morsem d. Petri Martyris
					<lb xml:id="p1z2"/>praestantissimi theologi suleris ex literis. idu
					<lb xml:id="p1z3"/>quas mense octobris ad grastum nostrum ili
					<lb xml:id="p1z4"/>dedisti, satis perspexi. Et sane illius mors
					<lb xml:id="p1z5"/>sarcem
					<lb xml:id="p1z6"/>omnibus piis deploranda est. Amisimus enim
					<lb xml:id="p1z7"/>virum, cuius erudisio, innocenta et authoris
					<lb xml:id="p1z8"/>in tuenda veritate ecclesiae Christi
					<lb xml:id="p1z9"/>multum profuit. Amisisti tamen collegam. ea
					<lb xml:id="p1z10"/>fidelem, qui tibi in perferendis molestiis
					<lb xml:id="p1z11"/>
					<lb xml:id="p1z12"/>egregiam operam praestabat, Nec dubito
					<lb xml:id="p1z13"/>quosdam adversarios huius viri obitu
					<lb xml:id="p1z14"/>plurimum loetarum et vestio quam victoriam
					<lb xml:id="p1z15"/>sibi polliceri. Sed deus hunc grave i
					<lb xml:id="p1z16"/>casum sine dubio aliis organis et fortassis illa
					<lb xml:id="p1z17"/>copiosiori successione rependet. Video e
					<lb xml:id="p1z18"/>enim mirabilem adversariorum insolentium heo.
					<lb xml:id="p1z19"/>quae etiam illustres personas manifestis
					<lb xml:id="p1z20"/>calumnis netare et in arena rixarem
					<lb xml:id="p1z21"/>provocare non veretur. Quodsi pug
					<lb xml:id="p1z22"/>derit, vehementiores insultus
					<lb xml:id="p1z23"/>plus caloris et animosi
					<lb xml:id="p1z24"/>habebunt. Ego deum rogo, ut quosi
					<lb xml:id="p1z25"/>undam deliram ambitionem et epicuream. ta
					<lb xml:id="p1z26"/>scuerilitatem compescat, ne afflictae ecclesiae s
					<lb xml:id="p1z27"/>calomitates anegeant. Vale, mi Bullingere,
					<lb xml:id="p1z28"/>et si negotia patiuntur. per hunc tae
					<lb xml:id="p1z29"/>.
					<lb xml:id="p1z30"/>labellarium rescribas. Saluta meo nomine
					<lb xml:id="p1z31"/>D. d. Gvaltherum, Simlerum, Lavaternum Volphium stem
					<lb xml:id="p1z32"/>et reliquos, quibus me totum offero. Hedelbergae
					<lb xml:id="p1z33"/>21. iunii anno etc. 63.
					<lb xml:id="p1z34"/>Tuus ex animo
					<lb xml:id="p1z35"/>Stephanus Celerus
					<lb xml:id="p1z36"/>secretarius.
					<pb/>
					<lb xml:id="p2z1"/>Clarissimo viro d. Henrico
					<lb xml:id="p2z2"/>Bullingero, ecclesiae <placeName ref="l587">Tigurinae</placeName>
					<lb xml:id="p2z3"/>antistiti fidelissimo, ano et
					<lb xml:id="p2z4"/>amco singulari fide colendo.
				</p>
			</div>
