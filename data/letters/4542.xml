	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hic querelis turpibus et usurariis obruor pene, nec <lb xml:id="p1z2"/>ii, quos coniicis, ullam admittunt rationem.</s>
					<s n="3" xml:lang="la">Expectandum <lb xml:id="p1z3"/>erit iudicum iudicium.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Recte coniecisti de <placeName ref="l1209">Navarre</placeName> rege; <lb xml:id="p1z4"/>is enim in aula est <placeName ref="l367">Aurelie</placeName>, sed frater, princeps a <persName>Conde</persName>, <lb xml:id="p1z5"/>quem secum adduxit, captivus detinetur et nunc <persName>G[uisiani]</persName> triumphant.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Reliqua in presens tacebo et me tuis commendo precibus <lb xml:id="p1z7"/>et amicorum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l379">Paterniaci</placeName> 13. novembris.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Tuus, <lb xml:id="p1z8"/>quem nosti.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Me de tuis rebus et dieta certiorem facies.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z9"/>Ex <placeName ref="l367">Aurelianensibus</placeName> multi coniecti in carcerem.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z10"/>Inquisitio continebit.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">De consilio nulla mentio.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z11"/>Dominus interim ociosus non est.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
