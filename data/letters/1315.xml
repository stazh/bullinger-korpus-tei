	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Nihil habeo nunc temporis, quod scribam; quę <lb xml:id="p1z2"/>apud nos circumferebantur, iis diebus scripsi, et puto te meas recepisse <lb xml:id="p1z3"/>a <placeName ref="l587">Tigurino</placeName> quodam cive.</s>
					<s n="3" xml:lang="la">Quę in <placeName ref="l749">Saxonia</placeName> aguntur, poteris diligentissime <lb xml:id="p1z4"/>perquirere a tabellario.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><placeName ref="l303">Magedeburgum</placeName> gravissime obsidetur; <lb xml:id="p1z5"/>sic ad me quidam scribit; literę datę sunt 29. maii: "Ante triduum <lb xml:id="p1z6"/>vehementer conflixerunt; pugnę velitariae fere quotidie habentur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Ex<lb xml:id="p1z7"/>ercitus prope <placeName ref="l1750">Luneburgum</placeName> iterum conspicitur; adversus quos, ignoratur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/><placeName ref="l749">Saxonia</placeName> turbabitur gravissime hoc anno.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Videntur multa prodigia; <lb xml:id="p1z9"/>magnae sunt hominum desperationes, multi se suspendunt, confodiunt, <lb xml:id="p1z10"/>suffocantur in aquis.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Diaboli omnes in locis nostris grassantur.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z11"/>Sodomus episcopus <placeName ref="l1681">Merseburgensis</placeName> in visitatione ecclesiarum concio<lb xml:id="p1z12"/>naturus dysenteria ilice est correptus et gravissime decumbit."</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z13"/>Plura percipies a tabellario, qui varia narraturus est <lb xml:id="p1z14"/>de obsidione illa.</s>
					<s n="11" xml:lang="la">Fortiter resistunt pii homines.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z15"/>Quid agitur <placeName ref="l21">Badenę</placeName> in comitiis?</s>
					<s n="13" xml:lang="la"><persName>Gumpenbergius</persName> nostros <lb xml:id="p1z16"/>turbabit absque dubio, et bona ecclesiastica tandem, quod deus <lb xml:id="p1z17"/>avertat, nobis magnum dabunt malum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z18"/>Cupio praeterea scire, an aliquid editurus sis hac aestate et <lb xml:id="p1z19"/>quas nunc temporis cogitationes habeas, quas divulgare <lb xml:id="p1z20"/>constituisti.</s>
					<s n="15" xml:lang="la" ana="farewell">Vale.</s>
					<s n="16" xml:lang="la"><placeName ref="l28">Basileae</placeName> 20. iunii 1551.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z21"/>T[uus] <persName ref="p1278">Gasti<lb xml:id="p1z22"/>us</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">D. <persName ref="p8171">Theodorum</persName> nomine meo salutabis, cui brevi scribam, <lb xml:id="p1z23"/>quum literas ab <placeName ref="l491">Argentina</placeName> recepero, quas in omnia <lb xml:id="p1z24"/>momenta expecto variis de rebus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z25"/>In <placeName ref="l213">Hassia</placeName>, ne hoc praeteream, evangelii contio adhuc auditur <lb xml:id="p1z26"/>clarissime, et vix 8 inveniuntur in tota illa regione, qui missentur.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z27"/>Princeps adhuc durissima captivitate detinetur<lb xml:id="p1z29"/>.</s>
				</p>
				<p>
					<s n="21" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem ehrwurdigen <lb xml:id="p2z2"/>herren m. <persName ref="p495">Heinrych <lb xml:id="p2z3"/>Bullinger</persName>, lutpriester <lb xml:id="p2z4"/>der kirchen zuͦ <placeName ref="l587">Zurich</placeName>, <lb xml:id="p2z5"/>mynem gunstigen herren, <lb xml:id="p2z6"/>zuͦ handen.</s>
					<s n="22" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>