	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l491">Argentinae</placeName> 12. decembris 1549.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Salutem et pacem per dominum nostrum Iesum Christum!</s>
					<s n="3" xml:lang="la">Humanitatis tuae <lb xml:id="p1z3"/>praeclara in me ostensa offitia, quum iam <placeName ref="l587">Tiguri</placeName> essem, non sinunt etiam <lb xml:id="p1z4"/>inter maximam negotiorum turbam immemorem esse promissi.</s>
					<s n="4" xml:lang="la">Cupiebas, <lb xml:id="p1z5"/><persName ref="p495">Bullingere</persName> amicissime, ut saepius scriberem; quod iam incipio, <lb xml:id="p1z6"/>licet materia scribendi non fere supersit.</s>
					<s n="5" xml:lang="la">Ex <placeName ref="l830">Anglia</placeName> quicquid <lb xml:id="p1z7"/>audiri potest, audies nimirum ex literis dilecti nostri <persName ref="p1548">Richardi <lb xml:id="p1z8"/>Hillis</persName>, neque quicquam ego novarum percepi, quam quod Pagetius quidam, <lb xml:id="p1z9"/>vir omnibus modis bonus, praeses <placeName ref="l2610">Walliae</placeName> sit creatus.</s>
					<s n="6" xml:lang="la">Quaena<lb xml:id="p1z10"/>n <placeName ref="l2610">Wallia</placeName> sit, quis <persName>Pagetus</persName>, indicabunt tibi et <persName ref="p506">Butlerus</persName> <lb xml:id="p1z11"/>et <persName ref="p4160">Halesius</persName>.</s>
					<s n="7" xml:lang="la">Caetera adhuc omnia manent eo, quo fuerant statu <lb xml:id="p1z12"/>et ordine a capto protectore, de quo ne verbum quidem ad<lb xml:id="p1z13"/>huc scribitur, quam quod detineatur carcere.</s>
					<s n="8" xml:lang="la">De <persName ref="p18538">Caesaris</persName> ad <lb xml:id="p1z14"/>nos adventu omnia incerta sunt, neque creditur ante ver venturum.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>Certant sacrificuli et episcopus, ut missa natali die reducatur <lb xml:id="p1z16"/>ad nos; quid fiet, expectabitur.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Dominus noster Iesus <lb xml:id="p1z17"/>Christus propter misericordiam nos ab omni errore <lb xml:id="p1z18"/>inviolatos servet, amen.</s>
					<s n="11" xml:lang="la" ana="salute">Tibi cum uxore habeo immor<lb xml:id="p1z19"/>tales gratias propter vestra in me benefitia, cui meo et uxoris <lb xml:id="p1z20"/>nomine salutem dices.</s>
					<s n="12" xml:lang="la">Literas, quas hic inclusi, oro per vere<lb xml:id="p1z21"/>darios certos mittas, alias quidem ad <placeName ref="l2">Arow</placeName>, alteras <placeName ref="l257">Constantiam</placeName>.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Est quaedam honesta mulier, cuius maritus iam per annum <placeName ref="l257">Constantiae</placeName> <lb xml:id="p1z23"/>inservivit viduae; promisit se venturum huc ad natale Christi <lb xml:id="p1z24"/>iamque scripsit contrarium; uxor rescribit cupitque, ut tuto et <lb xml:id="p1z25"/>certo perferantur idque, quam citissime fieri potest.</s>
					<s n="14" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z26"/>Tuus <persName ref="p505">Burcherus</persName> <placeName ref="l830">Anglus</placeName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem ersamen, wisen hern <lb xml:id="p2z2"/><persName ref="p495">Heinrich Bullinger</persName>, predicanten, <lb xml:id="p2z3"/>mynem gunstigen <lb xml:id="p2z4"/>hern und lieben ffreundt.</s>
					<s n="17" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
