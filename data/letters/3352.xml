	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non placuit amplissimo <placeName ref="l41">Bernensium</placeName> magistratui po<lb xml:id="p1z2"/>stulatum dominorum nostrorum.</s>
					<s n="3" xml:lang="la">Proinde sicut <placeName ref="l41">Bernenses</placeName> <lb xml:id="p1z3"/>a nostris postularunt, delegerunt nostri legatum d. <persName>Ioannem Aescherum</persName> <lb xml:id="p1z4"/>archigrammateum, qui hisce diebus <placeName ref="l41">Bernam</placeName> ibit <lb xml:id="p1z5"/>ibi expectaturus legatos <placeName ref="l28">Basilienses</placeName> et Schaffhusianos ut inde <lb xml:id="p1z6"/>ad regem abeant supplicaturi pro vinctis.</s>
					<s n="4" xml:lang="la"><placeName ref="l41">Bernates</placeName> <lb xml:id="p1z7"/>delegisse audio <persName ref="p5787">Claudium a Madiis</persName> et d. <persName>Ioannem Mirabilem</persName><note xml:id="fn1" type="footnote" n="1">Wunderlich.</note>.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Dominus benedicat legationi ipsorum.</s>
					<s n="6" xml:lang="la">Quo nomine et <lb xml:id="p1z9"/>fratres adhortandi videntur ut sedulo orent dominum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Valde <lb xml:id="p1z10"/>metuo <placeName>Guysanos</placeName>: non tam cardinalem quam eum qui nuper <lb xml:id="p1z11"/>ex <placeName ref="l834">Italia</placeName> in <placeName ref="l832">Galliam</placeName> rediit.</s>
					<s n="8" xml:lang="la">Sed sunt in manu domini <lb xml:id="p1z12"/>corda regum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">D. <persName>Philippus</persName> ad me ex <placeName ref="l569">Wor<lb xml:id="p1z13"/>macia</placeName> amicissimas scripsit literas.</s>
					<s n="10" xml:lang="la">Inter alia ad verbum: "<lb xml:id="p1z14"/>Nos hic duplicia certamina sustinemus, <foreign xml:lang="el">αἰτοῦσι <lb xml:id="p1z15"/>γὰρ τινὲς ψηφίσματα γραφῆναι κατὰ τῶν ἀποδοκιμαζόντων τὴν ἀρτο<lb xml:id="p1z16"/>λατρείαν</foreign>.</s>
					<s n="11" xml:lang="la">Refragati sunt plurimi legati.</s>
					<s n="12" xml:lang="la">Deus adsit <lb xml:id="p1z17"/>ecclesiae suae.</s>
					<s n="13" xml:lang="la">Plura non potui scribere" etc.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Haec ille.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z18"/>Retulerunt et fide digni alii, sedulo instare <placeName ref="l749">Saxones</placeName> ut <lb xml:id="p1z19"/>damnaremur, et ut <persName ref="p2095">Melanchthon</persName> purget se de <lb xml:id="p1z20"/>suspicione Zvinglianismi et <persName ref="p540">Calvino</persName> renunciet.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z21"/><persName ref="p18137">Marbachius</persName> <placeName ref="l491">Argentinensis</placeName> ecclesiae minister dicitur <lb xml:id="p1z22"/>damnationem nostram urgere prae aliis: interim tamen <lb xml:id="p1z23"/>subine in ore habere: Si <persName ref="p540">Calvinus</persName> et <placeName ref="l587">Tigurini</placeName> ita sentirent <lb xml:id="p1z24"/>ut habet confessio a <persName ref="p1049">Pharello</persName> et <persName ref="p8033">Beza</persName> in manibus <lb xml:id="p1z25"/>relicta principum, sperari posset concordia.</s>
					<s n="17" xml:lang="la">Vides, <lb xml:id="p1z26"/>mi <persName ref="p540">Calvine</persName>, quid illa sua confessione effecerint et ut <lb xml:id="p1z27"/>accipiatur ab adversariis.</s>
					<s n="18" xml:lang="la">Utinam nunc iterum ni<lb xml:id="p1z28"/>hil incommodent nostris ecclesiis cum <placeName ref="l569">Wormatiam</placeName> <lb xml:id="p1z29"/>descendisse dicantur et huius aliquid obscurius denota<lb xml:id="p1z30"/>verit <persName ref="p8033">Beza</persName> in epistola a <placeName ref="l441">Schaffhusio</placeName> ad nos scripta: <lb xml:id="p1z31"/>aut si quid agere velint, suo non nostro nomine <lb xml:id="p1z32"/>agant.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Nam confessionem illam in manibus principu<lb xml:id="p1z33"/>m relictam non agnoscimus.</s>
					<s n="20" xml:lang="la">Id quod palam prae<lb xml:id="p1z34"/>sentibus diximus.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Quae fiant in <placeName ref="l2472">Polonia</placeName> intelliges <lb xml:id="p1z35"/>ex praesentium latore <persName>Stanislao</persName>.</s>
					<s n="22" xml:lang="la">Commendo autem <lb xml:id="p1z36"/>tuae pietati <persName ref="p8371">Albertum</persName> hunc <persName>Dluski</persName> nobilem puerum.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z37"/><placeName>Cures</placeName>, oro, ut sancte educetur et optime <lb xml:id="p1z38"/>erudiatur.</s>
					<s n="24" xml:lang="la" ana="farewell">Vive et vale.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z39"/><placeName ref="l587">Tiguri</placeName> 6. octob. <lb xml:id="p1z40"/>anno 1557.</s>
					<s n="26" xml:lang="la" ana="salute">Salutant te nostri omnes.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p1z41"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p540">Ioanni <lb xml:id="p2z2"/>Calvino</persName> <placeName ref="l167">Genevensis</placeName> <lb xml:id="p2z3"/>ecclesiae pastori vigilantissimo <lb xml:id="p2z4"/>domino suo colendo <lb xml:id="p2z5"/>et fratri charissimo<lb xml:id="p2z6"/>.</s>
				</p>
			</div>
