	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Epistolam hanc, quam ad <persName ref="p7201">Iacobum Zornum</persName> <lb xml:id="p1z2"/><placeName ref="l257">Constantiensem</placeName> conscripsi<note xml:id="fn1" type="footnote" n="1">Nicht erhalten.</note>, illi ut reddi cures, te <lb xml:id="p1z3"/>rogo.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Senatus noster scribit vestro<note xml:id="fn2" type="footnote" n="2">Der Entwurf zu dieser Missive vom 15. November findet sich in <placeName ref="l257">Konstanz</placeName>, Stadtarchiv, B II 38, 88; zur Sache vgl. auch unten <ref target="file11477">Nr. 1434</ref>, 30-32.</note> consilium <lb xml:id="p1z4"/>conferens de stupro eius, quę cum repudiatę marito <lb xml:id="p1z5"/>se miscuit, repudiatę vero ob adulterium commissum <lb xml:id="p1z6"/>cum viro nunc impregnatę, primum de pena dubitans<lb xml:id="p1z7"/>, quę hactenus nulla est constituta.</s>
					<s n="4" xml:lang="la">Novitas <lb xml:id="p1z8"/>autem facti quosdam videtur plus iusto irritare ad <lb xml:id="p1z9"/>vitii alioqui etiam impunis animadversionem; dein<lb xml:id="p1z10"/>de hęrent plerique, num fas sit eos ipsos, quorum <lb xml:id="p1z11"/>coniuges propter unum adulterium iure sunt dimissi <lb xml:id="p1z12"/>(cum<note xml:id="fna" type="footnote" n="a"><hi>vor der Klammer gestrichenes</hi> ut ipsi innocentes matri.</note> sint innocentes et utri<lb xml:id="p1z13"/>que cum aliis matrimonium contrahere sit liberum),<pb type="edition" next="186"/> <lb xml:id="p1z14"/>nuptias meditari.</s>
					<s n="5" xml:lang="la">Non videntur subesse vinculorum <lb xml:id="p1z15"/>(quo minus id liceat) causę; sed offendiculum <lb xml:id="p1z16"/>et<note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> et <hi>gestrichenes</hi> esse.</note> rem pravi exempli esse<note xml:id="fnc" type="footnote" n="c">esse <hi>über der Zeile nachgetragen.</hi></note> clamant.</s>
					<s n="6" xml:lang="la">Senatus vester <lb xml:id="p1z17"/>haud dubie tuam sententiam intelliget, qua<lb xml:id="p1z18"/>propter eius te placuit admonere<note xml:id="fnd" type="footnote" n="d"><hi>in der Vorlage</hi> admonuere.</note><note xml:id="fn3" type="footnote" n="3">Über die Stellungnahme der Zürcher ist nichts bekannt.</note>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ex aliis i<lb xml:id="p1z19"/>ntelliges de testimonio, quod a vestris petimus <persName ref="p4225">Mi<lb xml:id="p1z20"/>chaelis</persName> gratia<note xml:id="fn4" type="footnote" n="4">Zum Zeugnis für <persName ref="p4225">Michael Back</persName> s. unten <ref target="file11478">Nr. 1435</ref>, 2-16 (vgl. auch <ref target="file11477">Nr. 1434</ref>, 27-29).</note>.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale, charissime <persName ref="p495">Bullingere</persName>, cum <lb xml:id="p1z21"/>tuis omnibus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Constantię, 16. novembris 1540.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z22"/><persName ref="p8178">Thomas Blaurerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z2"/>evangelicę veritatis preconi <lb xml:id="p2z3"/>apud <placeName ref="l587">Tigurum</placeName>, fratri suo.</s>
					<s n="12" xml:lang="de"><placeName ref="l587">Zurch</placeName>.</s>
