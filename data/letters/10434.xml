	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Audio, vir clarissime, animum tuum <lb xml:id="p1z2"/>nonnihil mutatum erga <persName ref="p5547">Wolphgangi</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p5547">Wolfgang Kuchimeister</persName>.</note> filium<note xml:id="fn2" type="footnote" n="2">Wohl <persName ref="p5545">Balthasar Kuchimeister</persName>, s. oben <ref target="file10391">[Nr. 359]</ref> S. 134, Anm. 27.</note>.</s>
					<s n="3" xml:lang="la">Verum ne <lb xml:id="p1z3"/>an falsum audierim ignoro.</s>
					<s n="4" xml:lang="la">Caeterum unice te oro, <lb xml:id="p1z4"/>ut adulescentulum tibi habeas commendatum.</s>
					<s n="5" xml:lang="la">Viri enim optim<lb xml:id="p1z5"/>i filius est, puer, quod spero, non omnino malus<note xml:id="fn3" type="footnote" n="3">Die Schwierigkeiten mit seinem Kostgänger beschreibt <persName ref="p8418">Myconius</persName> zu Beginn von <ref target="file10446">Nr. 411</ref>.</note>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z6"/>et haec nostra boni consule.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, iunii 27, 1534.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z7"/>Salvum volo <persName ref="p4349">Carolostadium</persName> nostrum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z8"/>Hein. tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p8418">Osvaldo Myconio</persName>, <lb xml:id="p2z2"/>fratri suo charissimo.</s>
				</p>
			</div>
		</body>
	</text>
