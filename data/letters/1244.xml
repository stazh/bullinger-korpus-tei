	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Graciam et pacem a domino.</s>
					<s n="2" xml:lang="la">Mitto, charissime frater, <lb xml:id="p1z2"/>fasciculum literarum a <persName ref="p3375">Vergerio</persName> missas.</s>
					<s n="3" xml:lang="la">Spectant <lb xml:id="p1z3"/>ad dominum <persName ref="p8011">Rudolphum Gvaltherum</persName>; ad te tamen mittere <lb xml:id="p1z4"/>placuit; nam tabellario prorsus est incognitus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Tabellarius domini <persName ref="p8013">Haimii</persName>, consulis nostri, gener est.</s>
					<s n="5" xml:lang="la">Literas <lb xml:id="p1z6"/>alteras <persName>Francisco</persName> pręsentari peto, quem quoque ignorat.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z7"/><persName>Franciscus</persName> suppellectilem vel vestes filiae adhuc secum <lb xml:id="p1z8"/>habuit hucusque; nunc reddi posco per praesentem tabellarium.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z9"/>Res scitu dignas fere nullas habemus.</s>
					<s n="8" xml:lang="la">Parmam <lb xml:id="p1z10"/>rumor est <persName ref="p8112">regi Gallorum</persName> traditam esse, seminarium scilicet <lb xml:id="p1z11"/>futuri belli.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Lis de episcopatu nostro interempta est <lb xml:id="p1z12"/>et finita, ut fertur; <persName>Thomas Planta</persName> obtinuit.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z13"/>Gratia domini nostri Iesu Christi tecum sit et cum tua tota <lb xml:id="p1z14"/>familia.</s>
					<s n="11" xml:lang="la" ana="salute">Saluta omnes fratres meo nomine.</s>
					<s n="12" xml:lang="la" ana="salute">Salutat <lb xml:id="p1z15"/>te <persName ref="p8013">Haimius</persName> consul et <persName ref="p8359">Philippus</persName>, frater noster.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z16"/>Ex <placeName ref="l648">Rhetiae</placeName> <placeName ref="l98">Curia</placeName>, 14. apprilis <lb xml:id="p1z17"/>51.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z18"/>Tuus totus <persName ref="p654">Iohannes Comander</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro <lb xml:id="p2z2"/>domino <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tyguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
