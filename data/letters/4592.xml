	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ex tuis literis scriptis 22. huius mensis adversam tuam valetudinem <lb xml:id="p1z2"/>intellexi, quam contractam puto ex nimiis vigiliis et <lb xml:id="p1z3"/>laboribus et intemperie aeris nimiaque humiditate.</s>
					<s n="3" xml:lang="la">De ea <lb xml:id="p1z4"/>magis sollicitus esse deberes.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Utinam mea opera aliquid <lb xml:id="p1z5"/>in eius conservatione posset!</s>
					<s n="5" xml:lang="la">Sed spero dominum te sibi <lb xml:id="p1z6"/>et suis firmiorem redditurum.</s>
					<s n="6" xml:lang="la">De nostro rege spem <lb xml:id="p1z7"/>magnam boni conceperunt regemque <placeName ref="l1209">Navarre</placeName> sibi non <lb xml:id="p1z8"/>defuturum et pacatiora omnia fore in <placeName ref="l832">Gallia</placeName>.</s>
					<s n="7" xml:lang="la">Forsan etiam ratione<lb xml:id="p1z9"/>s nonnullorum, qui multa moliebantur, conturbate <lb xml:id="p1z10"/>manebunt.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Brevi nos certiora audiemus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Puer m<lb xml:id="p1z11"/>eus ad tuas respondet<note type="misc"><persName ref="p613">M. Coignet d.J</persName>. an HB 26. Dez. 1560.</note></s>
				</p>
				<p>
					<s n="10" xml:lang="la">Octo abhinc diebus interrogabat <lb xml:id="p1z13"/>eum mater, an vellet esse rex <placeName ref="l832">Gallie</placeName>; respondit se longe malle esse <lb xml:id="p1z14"/><persName ref="p495">Bulingerum</persName>; valde est in te affectus.</s>
					<s n="11" xml:lang="la">Si ineunte vere <lb xml:id="p1z15"/>possum in <placeName ref="l832">Galliam</placeName> proficisci, remittam illum ad vos; optarem <lb xml:id="p1z16"/>d. <persName ref="p8011">Galterum</persName> eius curam vellet suscipere.</s>
					<s n="12" xml:lang="la">Tuto curabo, ut litere, quas <lb xml:id="p1z17"/>misisti perferantur <placeName ref="l367">Aureliam</placeName>, vellemque maiori in re animum <lb xml:id="p1z18"/>erga te meum posse testari.</s>
					<s n="13" xml:lang="la">D. <placeName ref="l1854">Redonensis</placeName> episcopus scripsit <lb xml:id="p1z19"/>ad me spem esse magnam de consilio brevi futuro et intra <lb xml:id="p1z20"/>paucos dies convocandos episcopos.</s>
					<s n="14" xml:lang="la">Stultus ille astrologus <lb xml:id="p1z21"/><persName ref="p20302">Nostradamus</persName> inter infinita mendacia forsan verum dicet affirmans <lb xml:id="p1z22"/>non fore consilium in anno proximo, sed verba inania.</s>
					<s n="15" xml:lang="la" ana="salute">Salutat te <lb xml:id="p1z23"/>uxor.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute">Salutabis amicos omnes et nos amabis.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Te servet <lb xml:id="p1z24"/>dominus incolumem.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l760">Solut[uri]</placeName> 26. decembris.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z25"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
