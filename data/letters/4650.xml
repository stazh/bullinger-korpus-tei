	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Hrobes, doctissime et dilectissime Bullingere, que apum
					<lb xml:id="p1z2"/>circumferuntur, tristia certe et forgni done ilei
					<lb xml:id="p1z3"/>fuerit tuam de hisce scribere sententiam equi
					<lb xml:id="p1z4"/>de quinque paficis illis vobis sit binendim
					<lb xml:id="p1z5"/>Tuas de Loncliis librs aii expectamus hic pede
					<lb xml:id="p1z6"/>Gallis et Germanis inver vl de ne vestr se
					<lb xml:id="p1z7"/>Submittant onelio
					<lb xml:id="p1z8"/>Vergerus scripsit ad Tridentinum et petit omnus
					<lb xml:id="p1z9"/>ut sio tid illuc venire et redie possicti sa
					<lb xml:id="p1z10"/>non inscio principe suo, sed nescionum alequd
					<lb xml:id="p1z11"/>responsi tuleris.
					<lb xml:id="p1z12"/>Discoddia vestrorum theologorum torpor principam
					<lb xml:id="p1z13"/>et tepentes auditorum extot tanasque ntentem
					<lb xml:id="p1z14"/>laugientium, nobis multa minantur stericul
					<lb xml:id="p1z15"/>iam non licet plura. vale opss et febriani
					<lb xml:id="p1z16"/>b
					<lb xml:id="p1z17"/>SS.
					<lb xml:id="p1z18"/>Tinyurie qui ascensirus
					<pb/>
					<lb xml:id="p2z1"/>Onatissimo viro d. Heinricho
					<lb xml:id="p2z2"/>Bullingero, theologo et amico
					<lb xml:id="p2z3"/>ncerissimo.
				</p>
			</div>
		</body>
	</text>
