	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Mitto, quod scio tibi gratissimum fore, <lb xml:id="p1z2"/>nempe deliberationem eorum, qui nuper <lb xml:id="p1z3"/>fuere in synodo <placeName ref="l749">Saxonica</placeName>; at ea lege, <lb xml:id="p1z4"/>ut duo exempla cures describenda al<lb xml:id="p1z5"/>terumque ad <persName ref="p8296">Bassafontanum</persName> alterum ad <lb xml:id="p1z6"/><placeName>Baionensem</placeName> mittas.</s>
					<s n="2" xml:lang="la">Curassem ego <lb xml:id="p1z7"/>hic, sed non fuit ocium; urget enim <lb xml:id="p1z8"/>nuncius, qui <placeName ref="l441">Scaffusium</placeName> venit nec mi<lb xml:id="p1z9"/>hi dat plus quam horulae spacium.</s>
					<s n="3" xml:lang="la">Reli<lb xml:id="p1z10"/>quis in rebus nihil novi.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Fuit hic <lb xml:id="p1z11"/>princeps triduo cum duobus aliis princ<lb xml:id="p1z12"/>ipibus, <persName ref="p18935">Volfgango</persName> <placeName ref="l2477">Palatino</placeName> et marchione <lb xml:id="p1z13"/><placeName>Badense</placeName> atque cum uxoribus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Multa <lb xml:id="p1z14"/>egi apud eum, qui quidem fervet <lb xml:id="p1z15"/>in evangelio; hoc certe scias.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z16"/>Spero quendam amicum intra non <lb xml:id="p1z17"/>multos dies misurum ad te circiter <lb xml:id="p1z18"/>quinquaginta coronatos, qui ad me <lb xml:id="p1z19"/>pertinent; eos tu servabis mihi, dum <lb xml:id="p1z20"/>scribam, cui fuerint dandi; scio, <lb xml:id="p1z21"/>apud quem deponam.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale, mi carissi<lb xml:id="p1z22"/>me <persName ref="p495">Bullingere</persName>, omnium inquam carissime.</s>
					<s n="8" xml:lang="la">Dom<lb xml:id="p1z23"/>inus et tibi et familię et ecclesiae et <lb xml:id="p1z24"/>scholae augeat dona caelestia per Christum <lb xml:id="p1z25"/>dominum nostrum.</s>
					<s n="9" xml:lang="la" ana="salute">Salvere iubeo omnes a deo.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l512">Tubing<lb xml:id="p1z26"/>ae</placeName> 10. iulii 15<lb xml:id="p1z27"/>54.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse ist zugeklebt, nur "optimo" in d. letzten Zeile sichtbar]</note>
				</p>
			</div>
