	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
					<s n="2" xml:lang="la">Nos operam nostram fratri huic, D. ac frater in Christo <lb xml:id="p1z2"/>dilectissime, obtulimus, <persName ref="p8090">Lingkius</persName> et ego.</s>
					<s n="3" xml:lang="la">Senatus noster decrevit se iniunc<lb xml:id="p1z3"/>turum legato, quem <placeName ref="l21">Badenam</placeName> missurus est, ut agat, quae et pro Christi gloria e<lb xml:id="p1z4"/>t pro ipsorum officio et pro commodo <placeName ref="l294">Lucarnensium</placeName> factura sint.</s>
					<s n="4" xml:lang="la">Tres aurei <lb xml:id="p1z5"/>dati sunt in viaticum.</s>
					<s n="5" xml:lang="la">Cogor tibi referre, quae sine maximo dolore scribi <lb xml:id="p1z6"/>non possunt: Tandem factio Gallogermanorum tantum potuit idque miris <lb xml:id="p1z7"/>practicis, quae tandem erumpent, ut, <foreign xml:lang="el">[griechisch]</foreign>, maior <lb xml:id="p1z8"/>pars vicerit meliorem.</s>
					<s n="6" xml:lang="la">Audio (quod tibi in sinum dico) plures quam viginti <lb xml:id="p1z9"/>non interfuisse huic senatus consulto.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Quinque idem [item?] suffragi<lb xml:id="p1z10"/>is obtentum est, ut libertate patrię prostituta Christoque postposito foedus cum impio r<lb xml:id="p1z11"/>ege iniretur.</s>
					<s n="8" xml:lang="la">Nos non defuimus Christi negotio, <lb xml:id="p1z12"/>a<lb xml:id="p1z13"/>deo ut ad ravim etiam clamantes exaudirent et <placeName>Sylvani</placeName> et <placeName>Transsylvani</placeName>.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z14"/>Ora pro nobis dominum.</s>
					<s n="10" xml:lang="la" ana="salute">Salutabis itam nobis D. <persName ref="p8171">Theodorum</persName>, <lb xml:id="p1z15"/>D. <persName ref="p8127">Pellicanum</persName>, D. <persName ref="p8011">Gualtherum</persName>.</s>
					<s n="11" xml:lang="la" ana="salute">Salvum te volunt <persName>Sebastianus</persName> et <persName ref="p8090">Ling<lb xml:id="p1z16"/>kius</persName> caeterique fratres.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Raptim <placeName ref="l441">Scaffusii</placeName> 3. kalendas septembris an<lb xml:id="p1z17"/>no 1549.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z18"/>Tuus ex animo <persName ref="p3481">Simpertus Vogtius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctrina et pietate insigni viro <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ministro, D. et <lb xml:id="p2z4"/>fratri suo amantissimo.</s>
					<s n="15" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
