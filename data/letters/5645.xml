	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Nec volui nec debui tuae humanitati multa scribere.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Rationes multę sunt, <lb xml:id="p1z3"/>partim quod sciam non dubium esse, quin laboribus iam per aliquot tempus pene confectus sis, <lb xml:id="p1z4"/>deinde quod nova, quae hinc inde feruntur, adeo sunt dubia, ut qui ea scribere <lb xml:id="p1z5"/>festinat, aliquando revocare cogatur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Hoc tamen significo filium tuum <lb xml:id="p1z6"/><persName ref="p475">Christopherum</persName> me convenisse, cui si potuissem, quaecunque grata fuissent, praestassem ei.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell"><lb xml:id="p1z7"/>Vale in Christo, qui te diutius nobis incolumem conservet.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/><placeName ref="l441">Schaffhusiae</placeName> 15. martii 1563.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z9"/>Tuae humanitati(s?) deditissimus <lb xml:id="p1z10"/><persName ref="p2757">Iacobus Ruuͤger</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo doctissimoque viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>antistiti ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>vigilantissimo, domino ac <lb xml:id="p2z5"/>fratri, imo patri potius suo <lb xml:id="p2z6"/>plurimum observando.</s>
				</p>
			</div>
		</body>
	</text>
