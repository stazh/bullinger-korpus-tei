	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quod scribam, non habeo; operam tamen dabo, ut <lb xml:id="p1z2"/>quoad concilii acta nihil diligentiae praetermisisse <lb xml:id="p1z3"/>videar.</s>
					<s n="3" xml:lang="la">Molestus tibi fui superiori septimana <lb xml:id="p1z4"/>tot literis missitandis; nunc brevior ero, ne toties <lb xml:id="p1z5"/>te meis nugis distraham.</s>
					<s n="4" xml:lang="la">Nugas appellarim, <lb xml:id="p1z6"/>cum videam me omnia in cassum laborasse.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quid <lb xml:id="p1z7"/><persName ref="p8093">Hercules</persName>, quid ego tentarimus, iam scire potes; <lb xml:id="p1z8"/>fortissimum quemque habituri fueramus.</s>
					<s n="6" xml:lang="la">Nunc pax <lb xml:id="p1z9"/>nulla diuturna et stabilis esse potest, <persName>Guisianis</persName> <lb xml:id="p1z10"/>ad gubernacula sedentibus.</s>
					<s n="7" xml:lang="la">Faciunt adversarii hoc <lb xml:id="p1z11"/>omne procul dubio, ut vires nostrorum semel <lb xml:id="p1z12"/>distrahant et postea ex improviso invadant <lb xml:id="p1z13"/>imparatos.</s>
					<s n="8" xml:lang="la">O miseros nostros, qui tam foede <lb xml:id="p1z14"/>sibi imponi patiuntur!</s>
					<s n="9" xml:lang="la">Haec septimana <lb xml:id="p1z15"/>praeterita plus me exercuit quam quicquam aliud <lb xml:id="p1z16"/>in omni mea vita.</s>
					<s n="10" xml:lang="la">Cogitare tu ipse potes, <lb xml:id="p1z17"/>quantae molis fuerit tam seria consilia suscipere <lb xml:id="p1z18"/>quorumque eventus tam anceps est et dubius.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/>Nunc omnibus provisis, quibus ad hoc negocium <lb xml:id="p1z20"/>opus erat, <persName>Condenses</persName> fatiscunt.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Tu, quaeso, <lb xml:id="p1z21"/>perge, me edocere reliquum.</s>
					<s n="13" xml:lang="la">Cur nihil <lb xml:id="p1z22"/>de fratre <persName>Guisii Aumala</persName>?</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Nostris haec <lb xml:id="p1z23"/>pacificatio non placet; nam praevidemus <lb xml:id="p1z24"/><persName>Guisium</persName> in nullas conditiones iturum sibi adversas.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z25"/>Rescribo d. <persName ref="p629">Coignetio</persName>; rogo te, ut tuto reddi ei cures.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z26"/>Orationem meam tibi placuisse miror; nam <lb xml:id="p1z27"/>mihi non satisfeci, sed tamen indulsi; nec <lb xml:id="p1z28"/>enim tam perturbato tempore aliter potui.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z29"/>Facile tibi acquiesco, ut nomen meum subticeatur, <lb xml:id="p1z30"/>licet quod ad me non multum curo furorem <lb xml:id="p1z31"/>antichristi.</s>
					<s n="18" xml:lang="la">Reponatur ergo aliud nomen <lb xml:id="p1z32"/>et si placet, hoc: <persName>Iani Orii</persName>, vel tu aut d. d. <pb/><lb xml:id="p2z1"/><persName ref="p1283">Gesnerus</persName> fingatis aliud quoddam ex Graeco conflatum.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z2"/>Quod ad rigorem attinet, nihil plane detrahi velim; <lb xml:id="p2z3"/>nihil enim tam durum dici potest, quod nequitia <lb xml:id="p2z4"/>et crudelitas horum hominum non superet.</s>
					<s n="20" xml:lang="la">Sed <lb xml:id="p2z5"/>dubito, an <persName ref="p1227">Froschouerus</persName> excudat; si difficilem se praebet, mitte per occasionem <placeName ref="l210">Heidelbergam</placeName><lb xml:id="p2z6"/>, ut ibi excudatur.</s>
					<s n="21" xml:lang="la" ana="farewell">Vale, reverende in Christo pater.</s>
					<s n="22" xml:lang="la">29. iunii anno 1562.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Tui studiosissimus <persName ref="p8009">I[oan<lb xml:id="p2z7"/>nes] F[abricius]</persName>.</s>
					<s n="24" xml:lang="la">Amplissimo viro d. <persName ref="p495">Heinrycho Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> antisti<lb xml:id="p2z8"/>ti vigilantissimo, domino et patri suo in Christo <lb xml:id="p2z9"/>semper honorando.</s>
					<s n="25" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
				<p>
					<s n="26" xml:lang="de">Herren <persName ref="p495">Bullinger</persName>.</s>
				</p>
			</div>
		</body>
