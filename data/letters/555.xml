	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Pacem et gratiam fideique augmentum <lb xml:id="p1z2"/>per dominum Iesum <persName ref="p917">H[ieronymus] Carr[aria]</persName> <persName ref="p495">H[einricho] B[ul<lb xml:id="p1z3"/>lingero]</persName> precatur N<lb xml:id="p1z4"/>ulle me, observande <persName ref="p495">Heinriche</persName>, ut ad te scriberem, promovebat occasio.</s>
					<s n="2" xml:lang="la">Sed cum <lb xml:id="p1z5"/>gravis ille et pietate et eruditione <persName ref="p2019">Augustinus Mainardus</persName>, <placeName ref="l93">Clavenensis</placeName> ecclesia<lb xml:id="p1z6"/>e minister ex <placeName ref="l648">Retorum</placeName> fratribus, de non levi negotio quarta decima Ma-i <lb xml:id="p1z7"/>ad me suas dedisset, hiis imposuit, quod, si tali negotio responderem, nostras <lb xml:id="p1z8"/>tibi dirrigendas curarem, ut pro tua erga illum familiaritate vel.</s>
					<s n="3" xml:lang="la">D. <persName ref="p654">Comandro</persName> <lb xml:id="p1z9"/>vel <persName ref="p396">Blasio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae ministris deferendas fideliter comendares, qua de re <lb xml:id="p1z10"/>alterius nomine, quem tibi et familiarem et carum existimo, nostras <lb xml:id="p1z11"/>comendare [h]aud temere visum fuit.</s>
					<s n="4" xml:lang="la">Non est igitur, ut tuam officiosam humani<lb xml:id="p1z12"/>tatem pluribus promoveam, cum tanto viro gratificari studiosior esse <lb xml:id="p1z13"/>possis, quam existimem.</s>
					<s n="5" xml:lang="la" ana="farewell">Vale, mi[h]i observande <persName ref="p495">Heinriche</persName>, in domino Iesu, quem toto animo deprecor, ut te f<lb xml:id="p1z14"/>ortissimum evangelice veritatis propugnaculum, in ut te fortissimum evangelice veritatis propugnaculum, <lb xml:id="p1z15"/>in illius adversarios conterendos magis atque magis corroboret et vita lungev<lb xml:id="p1z16"/>um servet, que[m]<note type="misc">qui?</note> pro me oratione pulsa cum gratia domini nostri Iesu Christi, amen.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z17"/>Datum Martisiasi 15. mensis Iunii 1549.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p917">Hieronymus Carraria</persName> <placeName ref="l1291">Taurinensis</placeName> <lb xml:id="p1z19"/>ex fratribus classis <placeName ref="l1280">Tononiensis</placeName>, <lb xml:id="p1z20"/>tibi deditissimus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="8" xml:lang="la">[<pb/><lb xml:id="p2z1"/>P]reclaro tum pietate tum eruditione <lb xml:id="p2z2"/>domino <persName ref="p495">Heinricho Bullingero</persName>, Tug[u]<lb xml:id="p2z3"/>rinensis ecclesiae pastori vig<lb xml:id="p2z4"/>ilantissimo et sincerissimo, nostro <lb xml:id="p2z5"/>observando.</s>
					<s n="9" xml:lang="la"><lb xml:id="p2z6"/>Tuguri.</s>
				</p>
