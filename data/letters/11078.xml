	<text xml:lang="de">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Mynen fruntwillighen dienst, liebster <persName ref="p495">Heinrice</persName>.</s>
					<s n="2" xml:lang="de">Ich bin sampt <lb xml:id="p1z2"/>den mynen noch in guder gesontheit.</s>
					<s n="3" xml:lang="de">Des gleichen hoffen ich <lb xml:id="p1z3"/>du ouch siest.</s>
					<s n="4" xml:lang="de">Wythers<pb type="edition" next="228"/> weiß ich dyr sonders neit<note xml:id="fn1" type="footnote" ana="lex" n="1">nichts Besonderes.</note> zo schryben, <lb xml:id="p1z4"/>dan myner verheissong nachtzokhommen (ich will ummerdair<note xml:id="fn2" type="footnote" ana="lex" n="2">immerdar.</note> <lb xml:id="p1z5"/>schryben, solte<note xml:id="fna" type="footnote" n="a">solte <hi>vom Schreiber korrigiert aus</hi> solten.</note> ich ouch nichts dan "vale" schriben)<note xml:id="fn3" type="footnote" n="3">Vgl. <bibl source="b6">HBBW IV</bibl> <ref target="file10466">[Nr. 431]</ref>, S. 297f, 7-12.</note>.</s>
				</p>
				<p>
					<s n="5" xml:lang="de">So wiß, <lb xml:id="p1z6"/>das es zo <placeName ref="l267">Collen</placeName> noch in alter herkomst und gewonheit <lb xml:id="p1z7"/>bliebt.</s>
					<s n="6" xml:lang="de">Sy keren sich<note xml:id="fn4" type="footnote" ana="lex" n="4">machen sich.</note> noch zertziet<note xml:id="fn5" type="footnote" ana="lex" n="5">zur Zeit.</note> an gheine veranderongh, <lb xml:id="p1z8"/>es sy in lere ader<note xml:id="fn6" type="footnote" ana="lex" n="6">oder.</note> ceremonien.</s>
					<s n="7" xml:lang="de">Der gytz dominert<note xml:id="fn7" type="footnote" ana="lex" n="7">dominiert.</note> noch <lb xml:id="p1z9"/>uber uyß.</s>
					<s n="8" xml:lang="de">Und wan schoin das evangelion luther dair <lb xml:id="p1z10"/>gethain word<note xml:id="fn8" type="footnote" n="8">lauter ausgelegt wird.</note>, wie sich etliche oper sulchs roemen<note xml:id="fn9" type="footnote" ana="lex" n="9">dessen rühmen.</note>, sonder<note xml:id="fn10" type="footnote" ana="lex" n="10">ohne.</note> besse<lb xml:id="p1z11"/>rongh unsers sundighen wandels weer des evangelii frucht <lb xml:id="p1z12"/>noch gar kleyn.</s>
				</p>
				<p>
					<s n="9" xml:lang="de">Halt myr diß myn kintsche schrybongh<note xml:id="fn11" type="footnote" n="11">meine kindliche Schreibweise.</note> <lb xml:id="p1z13"/>zo gute und biß<note xml:id="fn12" type="footnote" ana="lex" n="12">sei.</note> neit unser alder fruntschaff ungedenck, <lb xml:id="p1z14"/>sonder, was myr im schryven mangelt, verfullen<note xml:id="fn13" type="footnote" ana="lex" n="13">erfülle, verwirkliche.</note>, nachdem <lb xml:id="p1z15"/>dyr der almechtiger das zo folforn<note xml:id="fn14" type="footnote" ana="lex" n="14">zu vollführen.</note> vergont und gebenn <lb xml:id="p1z16"/>hait.</s>
				</p>
				<p>
					<s n="10" xml:lang="de">Hy mit diß maell dem almechtighen befoelenn.</s>
					<s n="11" xml:lang="de"><lb xml:id="p1z17"/>Und wüst ich hie tzo lande wat seltzams<note xml:id="fn15" type="footnote" ana="lex" n="15">etwas Besonderes.</note> dyr ader <lb xml:id="p1z18"/>dynem gemahell<note xml:id="fn16" type="footnote" ana="bio" n="16"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> angenem<note xml:id="fnb" type="footnote" n="b"><hi>in der Vorlage</hi> angemem <hi>oder</hi> angeniem.</note> mochte synn, wolte ich <lb xml:id="p1z19"/>inne<note xml:id="fnc" type="footnote" n="c"><hi>vielleicht als</hi> ime <hi>zu lesen.</hi></note> bedacht syn.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Datum anno etc. 37, ultima augusti.</s>
				</p>
				<p>
					<s n="13" xml:lang="de"><lb xml:id="p1z20"/><persName ref="p8175">Diderich Bitter</persName>, dyn gunstigher.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="14" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem ersamenn, uberauß <lb xml:id="p2z2"/>geleirthenn Meister <persName ref="p495">Heyn<lb xml:id="p2z3"/>richen Bullingher</persName>, myn<lb xml:id="p2z4"/>em geliebten freundt, <lb xml:id="p2z5"/>zo handen.</s>
					<s n="15" xml:lang="de">Gen <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
