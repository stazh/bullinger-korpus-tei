	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Non dubito mirari te, colendissime domine compater, <lb xml:id="p1z3"/>quid <placeName ref="l280">Lausannae</placeName> egerimus, et quis nunc <lb xml:id="p1z4"/>sit illius ecclesiae et scholae status.</s>
					<s n="3" xml:lang="la">Cognosces <lb xml:id="p1z5"/>tamen hoc ex iis quas ad fratrem scripsi, qui <lb xml:id="p1z6"/>eas tibi communicabit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Scripsissem citius si <lb xml:id="p1z7"/>nuncium habuissem.</s>
					<s n="5" xml:lang="la">Tuas quas ad <persName ref="p3429">Viretum</persName> <lb xml:id="p1z8"/>scripsisti una cum meis nimis sero accepi.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Cum enim nobis hinc discedendum esset et nuncius <lb xml:id="p1z10"/>qui ad vos missus erat nondum venisset, mandavi <lb xml:id="p1z11"/>meis, ut si quę interea abs te literae adferrentur, <lb xml:id="p1z12"/>curarent eas illico ad me aut <placeName ref="l280">Lausannam</placeName> <lb xml:id="p1z13"/>aut <placeName ref="l330">Morgias</placeName> deferri.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Cum vere illae venissent <lb xml:id="p1z14"/>tradiderunt eas cuidam cursori, qui tamen in <lb xml:id="p1z15"/>itinere nos non offendit, et dum ille illuc <lb xml:id="p1z16"/>proficisceretur, nos domum revertebamur.</s>
					<s n="8" xml:lang="la">Itaque reversus <lb xml:id="p1z17"/>post aliquot demum dies tuas ex <placeName ref="l2478">Sabaudia</placeName> remissas <lb xml:id="p1z18"/>accepi.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Quoniam tamen illae quas ad <persName ref="p3429">Viretum</persName> scripsisti <lb xml:id="p1z19"/>visae fuerunt utiles quę adhuc ei exhiberentur, curav<lb xml:id="p1z20"/>i ut confestim ad ipsum deferrentur.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Confusissima sunt omnia illic.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Quid in ecclesiis istis <lb xml:id="p1z22"/>laborarint nescio.</s>
					<s n="12" xml:lang="la">Hoc scio, vix tantum offendiculorum <lb xml:id="p1z23"/>eos in ecclesia illa invenisse, quantum nobis nunc <lb xml:id="p1z24"/>reliquerunt.</s>
					<s n="13" xml:lang="la">Schola fere prorsus est desolata.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Deliberabitur <lb xml:id="p1z25"/>tamen his diebus de illius instauratione.</s>
					<s n="15" xml:lang="la">Audimus <lb xml:id="p1z26"/>eos, qui <placeName ref="l167">Genevam</placeName> concesserunt, apologiam adornare.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z27"/>Cui fortassis nostri respondebunt, et ita posteriora <lb xml:id="p1z28"/>semper peiora erunt primis.</s>
					<s n="17" xml:lang="la">Quantum inde offendiculi de<lb xml:id="p1z29"/>tur vicinis <placeName ref="l160">Friburgensibus</placeName> et <placeName ref="l791">Valesianis</placeName>, potes ipse <lb xml:id="p1z30"/>cogitare.</s>
					<s n="18" xml:lang="la">Ego non video spiritum esse Christi, qui illos homines <lb xml:id="p1z31"/>agitat.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Nunc vexant illos, qui passi sunt [se in] <lb xml:id="p1z32"/>illorum loca substitui, quorum tamen aliquos prius [pro] <lb xml:id="p1z33"/>summis amicis habuerunt et putant neminem bon[a con]<lb xml:id="p1z34"/>scientia ipsorum loco servire posse.</s>
					<s n="20" xml:lang="la">Vocant eos ventres.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z35"/>Vellent ecclesias prorsus potius desolatas manere, quam <lb xml:id="p1z36"/>alios substitutos.</s>
					<s n="22" xml:lang="la">Ex manentibus etiam multi adhuc sunt, <lb xml:id="p1z37"/>qui eam pertinaciam induerunt, ut neque eligere cum <lb xml:id="p1z38"/>aliis quemquam velint, neque etiam se eligi admittant.</s>
					<s n="23" xml:lang="la">Et ta<lb xml:id="p1z39"/>ntum est in multis locis schisma, ut nec diaconi cum pa<lb xml:id="p1z40"/>storibus, aut pastores cum diaconis in eadem ecclesia <lb xml:id="p1z41"/>ministrare velint.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">In summa, confusissima rerum facies <lb xml:id="p1z42"/>est.</s>
					<s n="25" xml:lang="la">Quomodo ipsi coram deo respondere possint, qui or<lb xml:id="p1z43"/>natissimas ecclesias eo deduxerunt sua importunitate, ne<lb xml:id="p1z44"/>scio.</s>
					<s n="26" xml:lang="la">Tu ora pro illis et nobis dominum, ut spiritu suo ferocia <lb xml:id="p1z45"/>ista ingenia compescat et tranquillitatem ecclesiis suis <lb xml:id="p1z46"/>reddat.</s>
					<s n="27" xml:lang="la">Novi nihil habemus, nisi quod bellum de novo <lb xml:id="p1z47"/>recrudescat iterum.</s>
				</p>
				<p>
					<s n="28" xml:lang="la">Nostros ex <placeName ref="l157">Francofurto</placeName> mercatores <lb xml:id="p1z48"/>hodie expectamus, ex quibus fortassis aliquid <lb xml:id="p1z49"/>cognoscemus.</s>
					<s n="29" xml:lang="la">Tu quaeso nobis, si quid receperis, imperti.</s>
					<s n="30" xml:lang="la"><pb/><lb xml:id="p2z1"/>12. martii obiit d. vennerus <persName ref="p7510">Ioannes Rodolphus a Grafenriet</persName>, <lb xml:id="p2z2"/>22. eiusdem secutus est ipsum <persName ref="p8351">Frischingus</persName> senex, affinis tuus.</s>
					<s n="31" xml:lang="la"><lb xml:id="p2z3"/>Hac septimana d. <persName ref="p21017">Hieronymus Manuel</persName>, tribunus, sen... <lb xml:id="p2z4"/>vennerus, ut nos vocamus, factus est vir integer et cordatus.</s>
					<s n="32" xml:lang="la"><lb xml:id="p2z5"/>Tres etiam novi in senatum lecti, quorum nomina ad fratrem <lb xml:id="p2z6"/>scripsi.</s>
				</p>
				<p>
					<s n="33" xml:lang="la">Alias quod scribam, non habeo.</s>
				</p>
				<p>
					<s n="34" xml:lang="la" ana="salute">Affines tui, socer <lb xml:id="p2z7"/>item meus, <persName ref="p8417">Musculus</persName>, mater et fratres mei omnes <lb xml:id="p2z8"/>te salutant.</s>
				</p>
				<p>
					<s n="35" xml:lang="la"><placeName ref="l41">Bernae</placeName> penultima martii 1559.</s>
				</p>
				<p>
					<s n="36" xml:lang="la"><lb xml:id="p2z9"/>Remitto tibi apographum tuarum et d. <persName ref="p8111">Martyris</persName> ad <persName ref="p3429">Viretum</persName> l<lb xml:id="p2z10"/>iterarum et ago tibi pro eo magnas gratias, pro literis etiam ipsis ad <persName ref="p3429">Viretum</persName> scriptis nostro om<lb xml:id="p2z11"/>nium nomine.</s>
					<s n="37" xml:lang="la">Hall[erus] tuus.</s>
				</p>
				<p>
					<s n="38" xml:lang="la">Clarissimo viro d. <persName ref="p495">Heinrycho Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae pastori fidelissimo, domino suo honoran<lb xml:id="p2z12"/>do et compatri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
