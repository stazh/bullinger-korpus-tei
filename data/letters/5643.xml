	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuae, reverende in Christo pater, mihi iam quidem <lb xml:id="p1z2"/>omnes sunt redditae, nihil plane deperiit.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Librum tuum <lb xml:id="p1z3"/>d. consuli exhibui; is grato et benevolo animo <lb xml:id="p1z4"/>accepit seque prima occasione lecturum recepit <lb xml:id="p1z5"/>meque, ut tibi prolixe gratias pro luculento illo <lb xml:id="p1z6"/>munere scriptis agerem, sedulo cohortatus est.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/><persName>Pellizarium</persName> meas quoque tibi reddidisse nihil plane <lb xml:id="p1z8"/>dubito; est enim hominis fides et integritas <lb xml:id="p1z9"/>mihi cognita et perspecta.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Non opus erit <lb xml:id="p1z10"/>illas literas d. <persName ref="p18700">Augustini</persName> remittere.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Utinam <lb xml:id="p1z11"/>vero vera sint, quae de <persName>Guisii</persName> morte nunciantur; <lb xml:id="p1z12"/>res ea futurae pacificationi certam aliquam <lb xml:id="p1z13"/>viam sterneret.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Dominus de Aumala certo <lb xml:id="p1z14"/>mortuus perhibetur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Transiit pridie hac <persName>Gallus</persName> <lb xml:id="p1z15"/>quidam, qui nostris, quod ante annos <lb xml:id="p1z16"/>aliquot hic coquinam in legatorum aulis exer<lb xml:id="p1z17"/>cuisset, notus fuit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Is consulis filio affirmavit <lb xml:id="p1z18"/>se funeri domini de <placeName>Aumalen</placeName> interfuisse; <lb xml:id="p1z19"/>mortem tamen illius aliquamdiu celatam fuisse <lb xml:id="p1z20"/>(propter coniugem ni fallor)<note type="margin">dazu a.R.: "Coniunx illius dicitur fuisse gravida."</note>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Concilium dissolvi <lb xml:id="p1z22"/>certum est.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Di<lb xml:id="p1z23"/>cuntur patres illi <placeName ref="l1107">Tridentini</placeName> libidinis <lb xml:id="p1z24"/>suae monumenta relinquere.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><persName>Cardinalis <lb xml:id="p1z25"/>Tridentinus</persName> senior, qui olim gubernator <lb xml:id="p1z26"/>fuit <placeName ref="l306">Mediolani</placeName>, dicitur is esse, qui alienatus <lb xml:id="p1z27"/>est mente catenisque constringitur; causa <lb xml:id="p1z28"/>eius alienationis perhibetur (ut ex <persName ref="p3728">Remigio <lb xml:id="p1z29"/>a Schouwenstein</persName> audivi, qui id ex episcopo) <lb xml:id="p1z30"/>venenatum propinatum, quod ad mortem <lb xml:id="p1z31"/>non suffecerit, per totum corpus se diffuderit <lb xml:id="p1z32"/>huncque furorem conciliarit.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p18477">Ferdinandus</persName> est <placeName ref="l232">Oeniponte</placeName><note xml:id="fn1" type="footnote" n="1"><placeName ref="l232">Innsbruck</placeName>.</note>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Illuc dicitur <persName>Maximilianus</persName> <lb xml:id="p2z2"/>cum paucis admodum suorum advolasse et in comitatu <lb xml:id="p2z3"/>habuisse unum aut alterum concionatorem, <lb xml:id="p2z4"/>sed subito salutato parente et prandio sumpto <lb xml:id="p2z5"/>viae se denuo dedisse istincque solvisse.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Dicitur <lb xml:id="p2z6"/>isse in <placeName ref="l850">Austriam</placeName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Scribit comes..., qui incolit <lb xml:id="p2z7"/>arcem <placeName ref="l2796">Fudutz</placeName>, qui nunc est in aula <persName ref="p18477">Ferdinandi</persName>, <lb xml:id="p2z8"/>cardinalem <placeName>Emsensem</placeName> in maximam Caesaris incurrisse <lb xml:id="p2z9"/>offensam; <foreign xml:lang="de">er sye in großen ungnaaden des keisers.</foreign></s>
				</p>
				<p>
					<s n="17" xml:lang="de"><lb xml:id="p2z10"/>Dietägen kompt ab dem hoff, seyt von vylen <lb xml:id="p2z11"/>hüraten, so vorhanden syn söllind; sonderlich <lb xml:id="p2z12"/>aber meine man, der mit <persName ref="p18477">Ferdinando</persName> <foreign xml:lang="la">(<persName ref="p18538">Caesaris</persName> filio)</foreign> <lb xml:id="p2z13"/>und der könnigin uß <placeName ref="l2524">Schottland</placeName> wärde ein <lb xml:id="p2z14"/>fürgang haben; <foreign xml:lang="la">sed tantum credo, quantum video.</foreign></s>
				</p>
				<p>
					<s n="18" xml:lang="de">Es <lb xml:id="p2z15"/>habend sich ettlich der Fünfförtischen heruff gelassen, <lb xml:id="p2z16"/>in disen landen knächt anzenemmen.</s>
				</p>
				<p>
					<s n="19" xml:lang="de">Unsere herren <lb xml:id="p2z17"/>habends mit ernst abgestelt; doch so laß ich mir <lb xml:id="p2z18"/>sagen, das ettliche uß dem <placeName>Oberen Pundt</placeName> <lb xml:id="p2z19"/>by nacht hinwäg louffind uff <placeName ref="l781">Uri</placeName> zuͦ.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z20"/>Heri venit quidam mercator <placeName ref="l306">Mediolano</placeName>, qui <lb xml:id="p2z21"/>affirmat <placeName ref="l306">Mediolanum</placeName> per postam nunciatum <persName>Guisium</persName> <lb xml:id="p2z22"/>ictu bombardae letaliter vulneratum.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z23"/><persName>Duca de Sessa</persName> dicitur 28. februarii magno cum <lb xml:id="p2z24"/>pompa <placeName ref="l306">Mediolanum</placeName> ingressus esse; rediit (ut <lb xml:id="p2z25"/>scribitur) ex <placeName ref="l736">Pedemonte</placeName>, ubi <placeName ref="l2478">Sabaudi</placeName> filium <lb xml:id="p2z26"/>ex baptismo sustulerit.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p2z27"/>Haec nunc habeo nullius momenti, sed ut <lb xml:id="p2z28"/>tu conferas cum aliis et diiudices; nam si non <lb xml:id="p2z29"/>prosunt singula, multa iuvant.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p3z1"/>Catastrophen rerum <placeName ref="l832">Galliarum</placeName> audire cupimus.</s>
					<s n="24" xml:lang="la" ana="farewell"><lb xml:id="p3z2"/>Vale, reverende in Christo pater.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><placeName ref="l98">Curię</placeName> 15. martii <lb xml:id="p3z3"/>anno 1563.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p3z4"/>Tui observans <persName ref="p8009">Iohannes Fabricius</persName>.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p3z5"/><placeName ref="l367">Aureliam</placeName> spero non captam; nam papistis nostris <lb xml:id="p3z6"/>nihildum tale a <persName ref="p8108">Tschudio</persName> nunciatum, quod <lb xml:id="p3z7"/>mihi argumento est res nostrorum non esse <lb xml:id="p3z8"/>malo loco.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p3z9"/>Hodie huc venit <persName ref="p1770">G[regorius] Carlin[us]</persName> cum <persName>Metzlero</persName> quodam, <lb xml:id="p3z10"/>qui narrat <persName ref="p3730">Lazarum Schwendium</persName> cogere 15 <lb xml:id="p3z11"/>signa militum; non satis dum constat in quem <lb xml:id="p3z12"/>usum, sed vulgo creditur pro coronatione <lb xml:id="p3z13"/><persName>Ferdinandi Cęsaris</persName>.</s>
				</p>
				<p>
					<s n="29" xml:lang="la">Sunt, qui nescio <lb xml:id="p3z14"/>quid spargant et satis iam diu constanter <lb xml:id="p3z15"/>de ducatu <placeName ref="l306">Mediolanensi</placeName> imperio restituendo; <lb xml:id="p3z16"/>sed nihil affirmare possum.</s>
				</p>
				<p>
					<s n="30" xml:lang="de">Ich gloub nit, <lb xml:id="p3z17"/>das <persName ref="p18477">Ferdinandus</persName> oder <persName>Maximilianus</persName> so statthafft <lb xml:id="p3z18"/>sygind, das sy diser zyt ettwas deren dingen ze handen <lb xml:id="p3z19"/>nemmind.</s>
				</p>
				<p>
					<s n="31" xml:lang="la"><lb xml:id="p3z20"/>Interim denuo ex <placeName ref="l834">Italia</placeName> mors <persName>Guisii</persName> nunciatur; <lb xml:id="p3z21"/>certum ex te discere cupimus.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><pb/><lb xml:id="p4z1"/>Amplissimo viro eruditione <lb xml:id="p4z2"/>et pietate excellenti d. <persName ref="p495">Heinrycho <lb xml:id="p4z3"/>Bullingero</persName>, domino <lb xml:id="p4z4"/>suo et in Christo reverendo <lb xml:id="p4z5"/>patri.</s>
					<s n="33" xml:lang="de"><lb xml:id="p4z6"/>An h. <persName ref="p495">Bullinger</persName>.</s>
				</p>
			</div>
		</body>
