	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Commendamus vobis, charissimi <lb xml:id="p1z2"/>fratres, optimi viri huius caussam, quam ipse vobis expon<lb xml:id="p1z3"/>et<note xml:id="fn1" type="footnote" n="1">Zum Anliegen des <placeName ref="l555">Winterthurer</placeName> Stadtschreibers (vgl. Z. 3f) <persName ref="p1393">Gebhart Hegner</persName> s. dessen Brief an <persName ref="p495">Bullinger</persName> vom 22. September 1536 (unten <ref target="file10938">Nr. 896</ref>).</note>.</s>
					<s n="3" xml:lang="la">Dignus autem est, cui beneficium conferatur.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Scriba est <placeName ref="l555">Vitudurensis</placeName>, Pius et bonis amicus.</s>
					<s n="5" xml:lang="la">Caussam <lb xml:id="p1z5"/>habet justam et bonam.</s>
					<s n="6" xml:lang="la">Quicquid autem huic fe<lb xml:id="p1z6"/>ceritis, mihi putabo factum.</s>
					<s n="7" xml:lang="la">Amo enim hominem <lb xml:id="p1z7"/>ob singularem integritatem ex animo.</s>
					<s n="8" xml:lang="la">Habetis <lb xml:id="p1z8"/>senatores vobis notos; his caussam eius commendabitis.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z9"/>Quodsi qua in re vices rependere licebit, totus <lb xml:id="p1z10"/>vester sum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Valete.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 22. martii <lb xml:id="p1z11"/>1536.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z12"/><persName ref="p495">H. Bullingerus</persName> vester.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Dominis <persName ref="p8418">Osvaldo Myconio</persName> et <lb xml:id="p2z2"/><persName ref="p8054">Marco Bersio</persName>, <placeName ref="l28">Basileiensis</placeName> <lb xml:id="p2z3"/>ecclesiae doctoribus, charissimis <lb xml:id="p2z4"/>fratribus.</s>
				</p>
			</div>
		</body>
