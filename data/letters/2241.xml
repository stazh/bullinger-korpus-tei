	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia et pax domini nostri Iesu Christi v/nobiscum.</s>
					<s n="2" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Quoniam hoc tempore apud nos sicut et alibi evangelicae <lb xml:id="p1z3"/>veritatis osores (humanissimi piissimique viri) <lb xml:id="p1z4"/>nihil intentatum relinquunt, ut evangelii splendorem <lb xml:id="p1z5"/>(si fieri posset) extinguant, iccirco visum est ecclesiae <lb xml:id="p1z6"/>nostrae <placeName ref="l294">Locarnensi</placeName> certiores facere illustrissimos <lb xml:id="p1z7"/>optimosque dominos nostros <placeName ref="l587">Tigurinos</placeName>, <placeName ref="l41">Bernenses</placeName>, <lb xml:id="p1z8"/><placeName ref="l28">Basilienses</placeName> et <placeName ref="l441">Schaffhusianos</placeName> earum rerum, qui <placeName ref="l294">Locarni</placeName> <lb xml:id="p1z9"/>tum annis iam elapsis tum hoc pręsenti, imo <lb xml:id="p1z10"/>pręsenti mense acciderunt, ut hinc intellegant, <lb xml:id="p1z11"/>quanti nos faciamus verbum domini quantique <lb xml:id="p1z12"/>ipsosmet dominos, quibus etiam sumus subditi.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z13"/>Aeque enim supradictis dominis subditi sumus ac <lb xml:id="p1z14"/>caeteris; proinde notum illis esse cupimus, quod alii <lb xml:id="p1z15"/>nostri illustrissimi domini faciunt, ne quando de <lb xml:id="p1z16"/>nobis conquerantur, quod non communicaverimus, quae <lb xml:id="p1z17"/>hic in causa religionis fiunt.</s>
					<s n="5" xml:lang="la">Mittimus ideo <lb xml:id="p1z18"/>inter caetera edictum nuperrime nomine illustris<lb xml:id="p1z19"/>simorum dominorum nostrorum Septem Angulorum <lb xml:id="p1z20"/>proclamatum, cui obedire ecclesia nostra multis <lb xml:id="p1z21"/>de causis renuit: primum quod sit contra evangelium <lb xml:id="p1z22"/>Christi, deinde quia non est proclamatum <lb xml:id="p1z23"/>nomine Duodecim Angulorum; nos enim duodecim, <lb xml:id="p1z24"/>non septem tantum dominos agnoscimus; postremo, <lb xml:id="p1z25"/>quia nos omnes, qui plurimi sumus, nullo modo <lb xml:id="p1z26"/>consensimus literis illis sive instrumento, quod <pb/><lb xml:id="p2z1"/>aliqui ex civibus nostris condiderunt.</s>
					<s n="6" xml:lang="la">Quapropter <lb xml:id="p2z2"/>agite, piissimi viri, quantum in vobis est, evangelicam <lb xml:id="p2z3"/>doctrinam strenue defendite.</s>
					<s n="7" xml:lang="la">Nos quidem deo <lb xml:id="p2z4"/>potius quam hominibus obedientes alicunde accersitis <lb xml:id="p2z5"/>ministris et cenam domini in aedibus nostris celebramus <lb xml:id="p2z6"/>et infantulos nostros christiano more baptizamus <lb xml:id="p2z7"/>et evangelium annuntiamus, licet adversarii <lb xml:id="p2z8"/>nostri saepissime turbent ac persequantur et ministros <lb xml:id="p2z9"/>et ecclesiam.</s>
					<s n="8" xml:lang="la">Fidimus deo, qui nobiscum est in consum<lb xml:id="p2z10"/>matione seculi.</s>
					<s n="9" xml:lang="la" ana="farewell">Obsecramus vos in domino, ut <lb xml:id="p2z11"/>mentionem ecclesiae nostrae facere dignemini in praecibus <lb xml:id="p2z12"/>vestris valete.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l294">Locarni</placeName> 5. calendas aprilis<lb xml:id="p2z13"/>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z16"/><persName ref="p863">Thaddaeus Dunus</persName> medicus.</s>
				</p>
				<p>
					<note type="attachment">[Beilage: E II 364, 564:]</note>
					<s n="12" xml:lang="la"><lb xml:id="p2z17"/>Mittimus <lb xml:id="p2z18"/>hasce literas <lb xml:id="p2z19"/>nostras existimantes illustris<lb xml:id="p2z20"/>simos dominos qu<lb xml:id="p2z21"/>atuor rerumpubli<lb xml:id="p2z22"/>carum isthic congregat<lb xml:id="p2z23"/>os esse, ut accepimus.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z24"/>Quodsi aliter se r<lb xml:id="p2z25"/>es habuerit, signifi<lb xml:id="p2z26"/>cate illis, oramus, q<lb xml:id="p2z27"/>uaecunque scripsimus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z28"/>Orate pro nobis, sicut<lb xml:id="p2z29"/>i et <lb xml:id="p2z30"/>nos oram<pb/><lb xml:id="p3z1"/>us pro do<lb xml:id="p3z2"/>minis nostris.</s>
					<s n="15" xml:lang="la">[<lb xml:id="p3z3"/>E II 36<lb xml:id="p3z4"/>5<lb xml:id="p3z5"/>, <lb xml:id="p3z6"/>56b.] <pb/><lb xml:id="p4z1"/>Domino <persName ref="p495">Heinrycho Bullingero</persName> <lb xml:id="p4z2"/>caeterisque ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p4z3"/>ministris, viris piissimis.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p4z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
