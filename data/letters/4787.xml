	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Binas a <placeName ref="l93">Clavenna</placeName> literas accepi, priores <lb xml:id="p1z2"/>a d. <persName ref="p2019">Augustino Maynardo</persName>, quibus exponit communi fratrum <lb xml:id="p1z3"/>consensu constitutionem factam, quae iubeat omnes <lb xml:id="p1z4"/>peregrinos illuc venientes examinare, cuius sint <lb xml:id="p1z5"/>religionis, et ab his requirere subscriptionem confessionis <lb xml:id="p1z6"/><placeName ref="l648">Rheticae</placeName>.</s>
					<s n="3" xml:lang="la">Addit quibusdam id videri satis tyrannicum <lb xml:id="p1z7"/>ac repugnare modis omnibus; satis enim esse, si quis c<lb xml:id="p1z8"/>onfessionem faciat symboli apostolici, nihil opus esse symbolo <lb xml:id="p1z9"/>Athanasiano etc.</s>
					<s n="4" xml:lang="la">Posteriores scribit <persName ref="p8116">Franciscus Portus</persName> <lb xml:id="p1z10"/>nomine advenarum, quos <placeName ref="l93">Clavennenses</placeName> eiicere loco conentur; <lb xml:id="p1z11"/>multis damna consequtura ostendit, si oneribus graventur, <lb xml:id="p1z12"/>ut manere ibi non possint; rogat, ab amplissimo magistratu <lb xml:id="p1z13"/>nostro impetrem ad senatum <placeName ref="l98">Curiensem</placeName> et alios <placeName ref="l648">Rhetorum</placeName> <lb xml:id="p1z14"/>ordines literas commendatorias, quibus causam advenarum commendent.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Hic ego lupum auribus teneo; dubito enim, <lb xml:id="p1z16"/>cuius rei gratia eo loco movendi sint.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Si enim renuunt confessioni <lb xml:id="p1z17"/>vestrae subscribere, nolo illorum sumere patrocinium; <lb xml:id="p1z18"/>si vero ob alias causas pellendi sunt et synceri sunt <lb xml:id="p1z19"/>in religione, libenter meam illis operam impendam.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Hac in re tuum e<lb xml:id="p1z20"/>xpecto iudicium et quid tu suadeas, aut quid a nostro magistratu pe<lb xml:id="p1z21"/>tendum sit, exponas adeoque praescribas.</s>
					<s n="8" xml:lang="la">Mature vero <lb xml:id="p1z22"/>video tibi esse respondendum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Alioqui quod scribam, <lb xml:id="p1z23"/>habeo nihil.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Quid fit, oro, in <placeName ref="l834">Italia</placeName>?</s>
					<s n="11" xml:lang="la">Quid moli<lb xml:id="p1z24"/>untur patres in sacrosancto concilio <placeName ref="l1107">Tridentino</placeName>?</s>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z25"/>Vale.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 9. maii anno 1561.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p8009">Ioanni Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro, <lb xml:id="p2z4"/>fratri suo charissimo.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z5"/>Chur.</s>
				</p>
			</div>
		</body>
	</text>
