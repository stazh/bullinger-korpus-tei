	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissim<lb xml:id="p1z2"/>e <lb xml:id="p1z3"/><persName ref="p495">Bullingere</persName>, salvus sis.</s>
					<s n="2" xml:lang="la"><placeName ref="l491">Argentinam</placeName> <lb xml:id="p1z5"/>nudiustertius veni, quemadmodum scrip<lb xml:id="p1z6"/>seram me facturum, et iam coepi ag<lb xml:id="p1z7"/>ere nescio quid.</s>
					<s n="3" xml:lang="la">Puto me hic haesur<lb xml:id="p1z8"/>um unum mensem, deinde <placeName ref="l28">Basile<lb xml:id="p1z10"/>am</placeName>, deinde ad te veniam, inde <lb xml:id="p1z11"/>domum.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z12"/>Scies, quid me cogat haec <lb xml:id="p1z13"/>on<lb xml:id="p1z15"/>era nunc obire, et libenter audies <persName ref="p974">M<lb xml:id="p1z16"/>olineus</persName> mecum huc venit, quem <lb xml:id="p1z17"/>nunquam deserui; at sustentare ita vivente<lb xml:id="p1z18"/>m quis potuisset?</s>
					<s n="5" xml:lang="la">Ait se velle <lb xml:id="p1z19"/>vivere <lb xml:id="p1z20"/><placeName ref="l327">Monbelgardi</placeName>; reliqua de <lb xml:id="p1z22"/>eo cora<lb xml:id="p1z23"/>m.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z24"/>Tuum filium <lb xml:id="p1z25"/>nondum <lb xml:id="p1z26"/>vidi, sed brevi et saepe <lb xml:id="p1z29"/>visurus sum; utinam et iuvar<lb xml:id="p1z30"/>e eum aliqua in re possem.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute"><lb xml:id="p1z31"/>Salutabis <lb xml:id="p1z32"/>a me <placeName ref="l830">Anglos</placeName> coexules meos.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z34"/>Quod scripsi de 200 florenis, quos illustriss<lb xml:id="p1z35"/>imus princeps illis destinaverit, <lb xml:id="p1z36"/>est <lb xml:id="p1z37"/>verissimum; ipsemet <lb xml:id="p1z39"/>dixit ore suo, et curo ego diligenter, <lb xml:id="p1z40"/>ut mittantur atque ut habeatur <lb xml:id="p1z41"/>ratio istorum, qui apud vos sunt; <lb xml:id="p1z42"/>ita illis <lb xml:id="p1z43"/>affirma.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z44"/>Scripsi <pb/><lb xml:id="p2z1"/>ad quendam pauperem fratrem, qui <lb xml:id="p2z2"/><placeName ref="l93">Clavenae</placeName> est; sed <lb xml:id="p2z3"/>ex <placeName ref="l3289">Histria</placeName>, ad me ut veniat; <lb xml:id="p2z4"/>iter faciet per <placeName ref="l587">Tigurum</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Oro te, des <lb xml:id="p2z5"/>mihi commodato duos libros ex <lb xml:id="p2z6"/>haereticis illis, quos foras misisti, <lb xml:id="p2z7"/>et ille ad me perferet, id est Ponti<lb xml:id="p2z8"/>ficale et versiculos Italicos illos <lb xml:id="p2z9"/>illos <persName ref="p20917">Ioànnis' della Casa</persName>.</s>
					<s n="11" xml:lang="la">Utrumque <lb xml:id="p2z10"/>bona fide ad te feram e<lb xml:id="p2z11"/>go<lb xml:id="p2z12"/>met.</s>
					<s n="12" xml:lang="la">Non possum me continere, <lb xml:id="p2z13"/>quin nunc scribam: Coepta <lb xml:id="p2z14"/>est imprimi historia <persName ref="p6096">Sleidani</persName> <lb xml:id="p2z15"/>ab anno 1517; ego vero adsum, <lb xml:id="p2z16"/>ut iuvem, quantum queo pro par<lb xml:id="p2z17"/>vitate mea.</s>
					<s n="13" xml:lang="la">Bonum librum <lb xml:id="p2z18"/>sumus habituri et parum grat<lb xml:id="p2z19"/>um Antiochis et antichristis.</s>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p2z20"/>Salvere iubeo omnes.</s>
					<s n="15" xml:lang="la">Orate pro me omnes<lb xml:id="p2z21"/>.</s>
					<s n="16" xml:lang="la"><placeName ref="l491">Argentinae</placeName> 6. octo<lb xml:id="p2z22"/>bris <lb xml:id="p2z23"/>1554.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><persName ref="p3375">V<lb xml:id="p2z24"/>ergerius</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">[Vor 630]: <pb/><lb xml:id="p4z1"/>Tibi d. <persName ref="p495">Bullingere</persName>.</s>
				</p>
