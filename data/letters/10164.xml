	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia et pax a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Accepi tuas literas<note xml:id="fn1" type="footnote" n="1">Die erwähnten Briefe <persName ref="p495">Bullingers</persName> sind nicht erhalten.</note> una cum iis, quorum in iisdem <lb xml:id="p1z2"/>facis mentionem, quibus supra modum ut ante crebro<note xml:id="fna" type="footnote" n="a"><hi>in der Vorlage irrtümlich</hi> crebo.</note> de<lb xml:id="p1z3"/>lectatus sum.</s>
					<s n="3" xml:lang="la">Sed vereor illa, que <placeName ref="l157">Franfordiam</placeName><note xml:id="fn2" type="footnote" n="2"><persName ref="p495">Bullinger</persName> und <persName ref="p8175">Bitter</persName> scheinen ihre Verbindungen durch Besucher der <placeName ref="l157">Frankfurter</placeName> Buchmesse aufrecht erhalten zu haben.</note> <lb xml:id="p1z4"/>miseris, egrius ad me perventura, eo quod desit, <lb xml:id="p1z5"/>qui meas tradat et tuas, ut constitueram, reposcat <lb xml:id="p1z6"/>et referat.</s>
					<s n="4" xml:lang="la">Nam ille<note xml:id="fn3" type="footnote" n="3">Unbekannt.</note>, quem subornaram, interea, <lb xml:id="p1z7"/>quod sororiis nuptiis in patria intereram, insperato <lb xml:id="p1z8"/>citius discessit.</s>
					<s n="5" xml:lang="la">Solet is cum libris venalibus <lb xml:id="p1z9"/>singulis interesse nundinis inque eodem cum <lb xml:id="p1z10"/><placeName ref="l587">Tigurinis</placeName> versari hospitio, si vera mihi relata <lb xml:id="p1z11"/>sunt.</s>
					<s n="6" xml:lang="la">Posthac, si deus vitam dederit, rectius curabitur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Dedi ad te in mense augusto proxime <lb xml:id="p1z13"/>elapso literas<note xml:id="fn4" type="footnote" n="4">Siehe oben <ref target="file10151">Nr. 120</ref>.</note> cum quodam cive <placeName ref="l267">Coloniensi</placeName><note xml:id="fn5" type="footnote" n="5">Unbekannt.</note>, qui mihi <lb xml:id="p1z14"/>sancte recepit easdem ad tuas manus perlaturas [!], <lb xml:id="p1z15"/>quibus petieram, ut annotaciones tuas [!] in Epistolam Ioannis <lb xml:id="p1z16"/>secundario<note xml:id="fn6" type="footnote" n="6">Zu <persName ref="p495">Bullingers</persName> Johannesbrief-Kommentar (<bibl source="b286">HBBibl</bibl> I 37) s. noch oben S. 175, Anm. 14.</note> mitterentur.</s>
					<s n="8" xml:lang="la">Nam priores fraterculo cuidam <lb xml:id="p1z17"/>concredidi, qui eas non reddit<note xml:id="fn7" type="footnote" n="7">Siehe oben, S. 175, 11-13.</note>, nec prostant adhuc <lb xml:id="p1z18"/><placeName ref="l267">Colonie</placeName> ut nuper.</s>
					<s n="9" xml:lang="la">Alioqui huius gratia te minime gravarem.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/>Commentarios in Epistolam ad Hebreos<note xml:id="fn8" type="footnote" n="8">Zu <persName ref="p495">Bullingers</persName> Hebräerbrief-Kommentar (<bibl source="b286">HBBibl</bibl> I 38) s. noch oben S. 167, Anm. 6 und <ref target="file10155">Nr. 124</ref>.</note> anxie cum charissimis <lb xml:id="p1z20"/>tuis<note xml:id="fnb" type="footnote" n="b">tuis <hi>übergeschrieben.</hi></note> <lb xml:id="p1z21"/>script<lb xml:id="p1z22"/>is adhuc<note xml:id="fnc" type="footnote" n="c">adhuc <hi>übergeschrieben. Darunter gestrichen</hi> causas ex scriptis.</note> expecto, et si, ut <lb xml:id="p1z23"/>spero, non assequor, nemini quam mihi ipsi imputabo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/>Congratulor sane de successu et pace ecclesie vestre <lb xml:id="p1z25"/>precorque, ut idem nobis quandoque liceret scribere.</s>
					<s n="12" xml:lang="la">Nam <lb xml:id="p1z26"/>nobiscum, qui evangelio et glorie Christi favent,<pb type="edition" next="239"/> clam <lb xml:id="p1z27"/>faciant oportet.</s>
					<s n="13" xml:lang="la">Ita pharisaicis constitutionibus undique, <lb xml:id="p1z28"/>ut nosti, vallati sumus.</s>
					<s n="14" xml:lang="la">Condonandum sane meo <lb xml:id="p1z29"/>iuditio rudi popello, qui optat summo conatu deo servire <lb xml:id="p1z30"/>et ea, quae facit - aliud enim non docetur -, unice putat <lb xml:id="p1z31"/>deo placere.</s>
					<s n="15" xml:lang="la">Nihil igitur principio mavelim quam <lb xml:id="p1z32"/>evangelium pure admitti.</s>
					<s n="16" xml:lang="la">Tum enim indubie ceteri abu<lb xml:id="p1z33"/>sus quique facile paulatim marcescent et interibunt.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z34"/>Tu cum vestris pro nobis oretis dominum.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Apud nos<pb type="scan" next="||100v."/> <pb/><lb xml:id="p2z1"/>nihil novi est.</s>
					<s n="19" xml:lang="la">Ea, quae sparguntur de imperatore et <placeName ref="l2510">Turca</placeName>, <lb xml:id="p2z2"/>incerta adhuc sunt<note xml:id="fn9" type="footnote" n="9">Über die <placeName ref="l2510">Türkengefahr</placeName> und die diesbezügliche kaiserliche Politik in den Sommermonaten 1532 s. <hi>Westermann.</hi></note>.</s>
					<s n="20" xml:lang="la">Ut fertur, brevi publicus habebitur <lb xml:id="p2z3"/>conflictus, cui in propria affuturum se scripsit <lb xml:id="p2z4"/>imperator<note xml:id="fn10" type="footnote" n="10">Tatsächlich hielt sich der Kaiser vom 23. September bis 4. Oktober 1532 in <placeName ref="l546">Wien</placeName> auf, s. <hi>Turetschek 334.</hi></note>.</s>
					<s n="21" xml:lang="la">Sit gloria domini in secula.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="salute">His vale <lb xml:id="p2z5"/>et <persName ref="p527">fratrem</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p527">Johannes Bullinger</persName>, der ebenfalls in <placeName ref="l974">Emmerich</placeName> und <placeName ref="l267">Köln</placeName> studiert hatte und aus dieser Zeit auch mit <persName ref="p8175">Bitter</persName> befreundet gewesen sein dürfte.</note> meo nomine salutes.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><placeName ref="l267">Colonie</placeName>, 13. sep<lb xml:id="p2z6"/>tembris 1532.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p2z7"/><persName ref="p8175">Theodericus Bitter</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse darunter:]</note>
					<s n="25" xml:lang="de"><lb xml:id="p2z8"/>Dem ersamen unnd wol<lb xml:id="p2z10"/>gelertenn <lb xml:id="p2z11"/>Meister <persName ref="p495">Heinrichen Bul<lb xml:id="p2z12"/>linger</persName>, meinem geliepten frun<lb xml:id="p2z13"/>dt zon handenn.</s>
					<s n="26" xml:lang="de">Gen <placeName ref="l587">Zuͤrich</placeName>.</s>
				</p>
			</div>
