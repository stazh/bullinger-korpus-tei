	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi tuas, honorande pater, per <persName>Knöulium</persName> hunc <lb xml:id="p1z2"/>vestrum et ago tibi maximas gratias pro iis, quae mihi <lb xml:id="p1z3"/>communicasti.</s>
					<s n="3" xml:lang="la">Domino vero gratias ago ex corde pro mirab<lb xml:id="p1z4"/>ili illa veritatis promotione, quam ubique exercet.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Illum oro, ut pios omnes defendat et conatus illorum <lb xml:id="p1z6"/>magis ac magis ad suam gloriam provehat.</s>
					<s n="5" xml:lang="la">Interea dolet, <lb xml:id="p1z7"/>quod d. <persName ref="p8075">Erastus</persName> scribit, in ecclesiis illis <placeName ref="l808">Belgicis</placeName> adeo <lb xml:id="p1z8"/>recentibus iam gliscere contentionem etiam sacramentariam.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Solatur tamen hoc, quod certum est veritatem tandem victuram, <lb xml:id="p1z10"/>ad cuius promotionem et defensionem oro subinde dominum, <lb xml:id="p1z11"/>ut te diutissime conservet; magnam enim agnosco huius <lb xml:id="p1z12"/>boni partem dominum per te efficere.</s>
					<s n="7" xml:lang="la">quę vero <lb xml:id="p1z13"/>simul misisti ea conditione, ut tibi remittam, <lb xml:id="p1z14"/>oro te, ut aegre non feras, quod ea non tibi per hunc <lb xml:id="p1z15"/>eundem remitto; heri enim sub noctem venit et hodie <lb xml:id="p1z16"/>statim discedet, ut ea nulli adhuc communicare potuerim.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Inducias ergo peto tantisper, donec alium aliquem nan<lb xml:id="p1z18"/>ciscar nuncium, per quem mittam.</s>
					<s n="9" xml:lang="de">Wies uns <lb xml:id="p1z19"/>mitt den <placeName ref="l2469">Underwaldneren</placeName> gang, <foreign xml:lang="la">audies ex fratre meo</foreign> <lb xml:id="p1z20"/>ein fyn spil.</s>
					<s n="10" xml:lang="la">Alias nihil habeo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="12" xml:lang="la" ana="salute">Salutant <lb xml:id="p1z21"/>te diligenter d. consul <persName ref="p8063">Steigerus</persName>, quęstores ambo, <persName ref="p7449">Dies<lb xml:id="p1z22"/>bachius</persName>, <persName ref="p3659">Mülinensis</persName>, <persName ref="p5787">Madiensis</persName>, <persName ref="p4060">Zehenderi</persName>, socer et <lb xml:id="p1z23"/>alii plures, praesertim <persName ref="p8416">Abraham Musculus</persName>, mater et uxor.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z24"/><placeName ref="l41">Bernae</placeName> 8. octobris 1566.</s>
