	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non potui intermittere, doctissime vir, quin ad te scriberem, cum <lb xml:id="p1z2"/>hunc virum et certum nuncium amici obtulissent; sed quid scribam?</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Deploratum statum ecclesiae et laceram ac undique afflictam hanc <lb xml:id="p1z4"/>sponsam Christi?</s>
					<s n="4" xml:lang="la">Utinam autem contingat aliquando videre <lb xml:id="p1z5"/>pristinum ecclesiae statum, utinam primitivum illum candorem <lb xml:id="p1z6"/>cernere aliquando possim.</s>
					<s n="5" xml:lang="la">Mehercle nichil beatius unquam <lb xml:id="p1z7"/>accideret michi, nichil suavius et dulcius nichilque iucundius.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Quid, obsecro, tanta <foreign xml:lang="el">φιλονεικία</foreign> utrinque fovetur?</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Utique serpens <lb xml:id="p1z9"/>in proprio nutritur sinu.</s>
					<s n="8" xml:lang="la">Dixi eadem <persName ref="p458">Brentio</persName> et <persName ref="p458">Brencianis</persName>; <lb xml:id="p1z10"/>sed statim <persName ref="p4091">Zvinglianus</persName> passim ubique, imo etiam apud principem <lb xml:id="p1z11"/>proclamatus sum.</s>
					<s n="9" xml:lang="la">Ego vero quantum <persName ref="p4091">Zvinglio</persName>, quantum <lb xml:id="p1z12"/>item <persName ref="p1974">Luthero</persName> ac vobis et similibus patribus et amicis charissimis <lb xml:id="p1z13"/>debeam, quorum scripta me ex lacuna illa <placeName ref="l2131">Babylonica</placeName> <lb xml:id="p1z14"/>eripuerunt, ipse testis est deus.</s>
					<s n="10" xml:lang="la">Porro conqueri merito oportet, <lb xml:id="p1z15"/>imo deum ipsum caelitus obtestari, quod ex animo lugeam <lb xml:id="p1z16"/>nec dissimilem luctum cęlebro a prophetarum lamentationibus, <lb xml:id="p1z17"/>quod tam sęva malignitate undique membra Christi afficiantur, <lb xml:id="p1z18"/>unitas ecclesiae scindatur ob exiguas ac nullas causas.</s>
					<s n="11" xml:lang="la">Tu, <lb xml:id="p1z20"/><persName ref="p495">Bullingere</persName>, praestitisti multa, cuius scripta magnifacio semper, pari <lb xml:id="p1z21"/>ratione doctissimi <persName ref="p8111">Martyris</persName> celeberrimi et placidissimi disputatoris, <lb xml:id="p1z22"/>cuius cuique similis in orbe vix existit, patris mei peritissimi <lb xml:id="p1z23"/><persName ref="p8171">Billiandri</persName>, fratris amicissimi <persName ref="p8011">Balteri</persName>, <persName ref="p2336">Ochini</persName> amantissimi, <lb xml:id="p1z24"/><persName ref="p540">Calvini</persName> eloquentissimi, <persName ref="p3429">Vireti</persName> pii ac integerrimi, <persName ref="p2095">Philippi</persName>, <lb xml:id="p1z25"/>mei praeceptoris candidissimi, <persName ref="p714">Caelii</persName> gravissimi, <persName ref="p8298">Borrhai</persName> pro<lb xml:id="p1z26"/>fundissimi, <persName ref="p3099">Sulceri</persName> syncerissimi et similium scripta semper <lb xml:id="p1z27"/>colui et de eis reverenter sensi neque <persName ref="p458">Brencium</persName> aut <persName ref="p18233">Illyricum</persName> <lb xml:id="p1z28"/>unquam aspernatus sum, qui hoc unicum flagitavi, si quando <pb/><lb xml:id="p2z1"/>concordiam possimus moliri et conciliare dissidentes.</s>
					<s n="12" xml:lang="la">Sed, ut video, <lb xml:id="p2z2"/>frustra, oleum et operam perdimus, quicquid in hanc rem conferimus, <lb xml:id="p2z3"/>neque video aliam causam praeter unicam <foreign xml:lang="el">φιλονεικίαν</foreign>, ex parte etiam <lb xml:id="p2z4"/><foreign xml:lang="el">φιλαυτίαν</foreign>, quae proxime, ut passim apostolus ubique testatur, ad <lb xml:id="p2z5"/>infernum pertrahit sui imitatores.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><foreign xml:lang="el">Μιμήται</foreign> ergo etoste et sectatores <lb xml:id="p2z6"/>Christi et apostolorum, obsecro, ac Pauli et Barnabae cum caeteris, cont<lb xml:id="p2z7"/>roversiam susceptam investigate et propter modicas causas aut nullas <lb xml:id="p2z8"/>nequaquam trubatae ecclesiam dei.</s>
					<s n="14" xml:lang="la">Fiet tum <lb xml:id="p2z9"/>demum, ut omnes facti haudquaquam paeniteat.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Haec non aliunde <lb xml:id="p2z10"/>proficiscuntur quam ex <foreign xml:lang="el">συμπάθεια</foreign>; nam vos amo et veneror tanquam <lb xml:id="p2z11"/>patres, admoneo autem tanquam salutis omnium cupidissimus, idem <lb xml:id="p2z12"/>non modo vobis, sed omnibus peropto.</s>
					<s n="16" xml:lang="la">Video enim, quod alter nimis in <lb xml:id="p2z13"/>signato, alter in signo haereat, neuter relationem advertit signi et si<lb xml:id="p2z14"/>gnati aut admodum perobscure, atque inde est tam varia opinio et <lb xml:id="p2z15"/>sectaria multitudo.</s>
					<s n="17" xml:lang="la">Sed haec pro meo erga vos amore scripsisse quoad <lb xml:id="p2z16"/>praesens sufficiat.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Precor vobis a deo patre et domino nostro Iesu <lb xml:id="p2z17"/>Christo pacem et tranquillitatem.</s>
					<s n="19" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="farewell"><lb xml:id="p2z18"/>Vale foelicissime tu et omnes <lb xml:id="p2z19"/>Christi fideles.</s>
					<s n="21" xml:lang="la"><lb xml:id="p2z20"/>Datae <placeName ref="l512">Tubingae</placeName> 11. martii <lb xml:id="p2z21"/>1560.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p2z22"/>T[uus] ex animo <persName ref="p8100">Scalichius</persName> <lb xml:id="p2z23"/>pro propria.</s>
				</p>
				<p>
					<note>[eigenhändig:]</note>
					<s n="23" xml:lang="la" ana="salute"><lb xml:id="p2z24"/>Saluta meo nomine <persName ref="p1283">Gisnerum</persName> et reliquos <lb xml:id="p2z25"/>nominatos viros, etiam atque etiam oro.</s>
				</p>
				<p>
					<note>[vor 479]</note>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p3z1"/>Reverendo <pb/><lb xml:id="p4z1"/>et pio viro <lb xml:id="p4z2"/>suo amicissimo <persName ref="p495">Heinrico <lb xml:id="p4z3"/>Bullingero</persName>, tanquam <lb xml:id="p4z4"/>patri charissimo, ad ma<lb xml:id="p4z5"/>nus proprias.</s>
					<s n="25" xml:lang="la"><lb xml:id="p4z6"/>In absent[<lb xml:id="p4z7"/>ia <persName ref="p495">Bullin]<lb xml:id="p4z8"/>geri</persName> <persName ref="p8111">Martyri</persName>, <lb xml:id="p4z9"/><persName ref="p8171">Bibliand[ro</persName>... <lb xml:id="p4z10"/><persName ref="p8011">Ga]lthero</persName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>