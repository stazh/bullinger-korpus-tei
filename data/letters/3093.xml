			<zone xml:id="p3z3-0" points="371,2519 956,2516 1045,2550 1190,2518 1337,2564 1335,2458 1218,2433 970,2470 822,2423 681,2464 493,2422 370,2439">379,2490 427,2484 475,2487 523,2487 571,2489 619,2492 667,2489 715,2489 763,2490 811,2488 859,2487 907,2492 955,2496 1003,2496 1051,2496 1099,2496 1147,2496 1195,2499 1243,2500 1291,2503 1339,2512</zone>
