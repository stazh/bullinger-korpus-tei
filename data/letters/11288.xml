	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Reddidit mihi <persName ref="p4851">Froschouerus</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p4851">Froschauer</persName> dürfte auf der Durchreise zur <placeName ref="l157">Frankfurter</placeName> Frühjahrsmesse nach <placeName ref="l28">Basel</placeName> gekommen sein; vgl. unten <ref target="file11291">Nr. 1248</ref>, 13-15.</note> literas<note xml:id="fn2" type="footnote" n="2">Nicht erhalten.</note> tuas, pater <lb xml:id="p1z2"/>humanissime, quibus me et consolaris et, quid agendum porro sit, <lb xml:id="p1z3"/>instituis, pro quibus in me benefitiis magnas tibi ago gratias; <lb xml:id="p1z4"/>referam etiam, si modo aliquando referendi facultas concessa fuerit.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Nimis vero<note xml:id="fnb" type="footnote" n="b">vero <hi>über der Zeile nachgetragen.</hi></note> mihi laborare videris, quod denuo tam accurate causam addis, <lb xml:id="p1z6"/>cur <placeName ref="l558">Witembergam</placeName> mihi negaveritis<note xml:id="fn3" type="footnote" n="3">Vgl. oben <ref target="file11275">Nr. 1232</ref>, 2-11.</note>; ego enim dudum hoc <lb xml:id="p1z7"/>mihi persuasum habeo vos non modo ea, quae mihi conducunt, videre, <lb xml:id="p1z8"/>verumetiam bene prospecta mihi consulere, sic ut vestrorum <lb xml:id="p1z9"/>imperiorum causas inquirere non plurimum laborem.</s>
					<s n="4" xml:lang="la">Hoc etenim <lb xml:id="p1z10"/>constitui: vestris iussis parere et obsequi; vestras, si quid delin<lb xml:id="p1z11"/>quo, admonitiones libenter recipio.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Religionem porro studiorum <lb xml:id="p1z12"/>meorum scopum esse vis<note xml:id="fn4" type="footnote" n="4"><persName ref="p8011">Gwalther</persName> kommt in seinem Brief vom 13. April nochmals auf diese Mahnung zurück; s. unten <ref target="file11297">Nr. 1254</ref>, 29-33.</note>, quod et ego imprimis cupio; video enim <lb xml:id="p1z13"/>hanc mihi solam propositam esse, in qua et divinę vocationi <lb xml:id="p1z14"/>satisfacere et collatis in me benefitiis respondere possim.</s>
					<s n="6" xml:lang="la">Curabo <lb xml:id="p1z15"/>itaque, ne me hic tuę admonitionis immemorem esse comperias.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>Postulaveram autem abs te, dum adhuc <placeName ref="l491">Argentinę</placeName> agerem, ut mihi <lb xml:id="p1z17"/>paucis, quo nam ordine sacrę scripturę libri legendi essent, de<lb xml:id="p1z18"/>monstrares<note xml:id="fn5" type="footnote" n="5">Vgl. <bibl source="b10">HBBW VIII</bibl> <ref target="file11244">[Nr. 1201]</ref>, S. 277, 106-113.</note>; id etiam nunc (si modo otium tibi fuerit) abs <lb xml:id="p1z19"/>te rogo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Chelim et <persName ref="p4543">Ciceronem</persName><note xml:id="fn6" type="footnote" n="6">Vgl. oben <ref target="file11278">Nr. 1235</ref>, 8-12.</note> eodem die recepi; nummos<note xml:id="fn7" type="footnote" n="7">Gemeint ist wohl die zu Fronfasten (26. Februar) fällig gewordene Stipendienrate.</note> <lb xml:id="p1z20"/><persName ref="p4851">Froschouerus</persName> dedit.</s>
					<s n="9" xml:lang="la">Salva alia sunt omnia.</s>
					<s n="10" xml:lang="la">Indicem <lb xml:id="p1z21"/><persName ref="p1001">Elioti</persName><note xml:id="fn8" type="footnote" n="8">Vgl. oben <ref target="file11275">Nr. 1232</ref>, 31f.</note> <persName ref="p18308">Quirinus</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p18308">Quirinus von Leiden</persName>.</note> ad me deferet.</s>
					<s n="11" xml:lang="la">Rogo praeterea, ut mihi <lb xml:id="p1z22"/>apud vos Biblia Latina <persName ref="p2270">Munsteri</persName> per <persName ref="p4851">Christophorum</persName> impressa<note xml:id="fn10" type="footnote" n="10">Zu der bei <persName ref="p4851">Froschauer</persName> gedruckten Bibelausgabe mit <persName ref="p2270">Münsters</persName> Übersetzung des Alten Testaments s. oben <ref target="file11280">Nr. 1237</ref>, Anm. 10.</note> <lb xml:id="p1z23"/>ligari cures et per eundem <persName ref="p18308">Quirinum</persName> ad<note xml:id="fnc" type="footnote" n="c">ad <hi>undeutlich korrigiert.</hi></note> me mittas <lb xml:id="p1z24"/>prętiumque ex nummis, quos tecum habes, solvas, nisi forte <lb xml:id="p1z25"/>tibi aliter visum fuerit; sed scis nimirum me sine propriis <lb xml:id="p1z26"/>bibliis non multum in theologia proficere posse.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Plura, <lb xml:id="p1z27"/>quae scribam, nunc non habeo.</s>
					<s n="13" xml:lang="la"><persName ref="p8418">Miconio</persName> de <persName ref="p1365">Grinei</persName> promissis, <lb xml:id="p1z28"/>quae tibi mei gratia exhibuit, scripsisti<note xml:id="fn11" type="footnote" n="11">Am 10. März; s. oben <ref target="file11282">Nr. 1239</ref>, 2-9.</note>; is <persName ref="p1365">Grineo</persName> epistolam leg<lb xml:id="p1z29"/>endam tradidit.</s>
					<s n="14" xml:lang="la">Nildum respondit hic, sed timeo, <lb xml:id="p1z30"/>ne nova uxor<note xml:id="fn12" type="footnote" ana="bio" n="12"><persName ref="p5044">Katharina, geb. Lompart</persName>.</note> propter divitias, quibus abundat, mariti <lb xml:id="p1z31"/>imperium sibi vendicet.</s>
					<s n="15" xml:lang="la">Quare de hac re postea <lb xml:id="p1z32"/>copiosius scribam.<pb type="edition" next="89"/></s>
				</p>
				<p>
					<s n="16" xml:lang="la">Deus optimus maximus te ecclesiae suae <lb xml:id="p1z33"/>diu incolumem servet.</s>
					<s n="17" xml:lang="la" ana="farewell">Vale bene, patrone charissime, <lb xml:id="p1z34"/>et <persName ref="p8011">Rodolphum</persName> tuum tibi commendatum habeto.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">Salutabis, <lb xml:id="p1z35"/>quaeso, nomine meo <persName ref="p8051">uxorem</persName><note xml:id="fn13" type="footnote" ana="bio" n="13"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> <persName ref="p7042">matremque</persName><note xml:id="fn14" type="footnote" ana="bio" n="14"><persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note> tuam et un<lb xml:id="p1z36"/>iversam familiam.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z37"/>Remitto hic saccum, in <lb xml:id="p1z38"/>quo <persName ref="p4543">Ciceronem</persName> ad me demisisti.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z39"/><placeName ref="l28">Basileę</placeName>, ex aedibus <lb xml:id="p1z40"/>d. <persName ref="p8418">Miconii</persName><note xml:id="fnd" type="footnote" n="d"><persName ref="p8418">Miconii</persName> <hi>anstelle von gestrichenem</hi> <persName ref="p495">Bullingen</persName>.</note>, 16. martii 1539.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z41"/>Tui observantissimus <persName ref="p8011">Rod. Gvaltherus</persName><note xml:id="fn15" type="footnote" n="15">Von diesem Brief an schreibt <persName ref="p8011">Gwalther</persName> seinen Namen stets mit "th" (<persName ref="p8011">Gvaltherus</persName>, Walther).</note>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Ignosce, <lb xml:id="p1z42"/>quaeso, lituris; non enim <lb xml:id="p1z43"/>rescribendi otium fui<lb xml:id="p1z44"/>t.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vere pio et erudito <lb xml:id="p2z2"/>viro M. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/>Moecenati<note xml:id="fn16" type="footnote" n="16">Vgl. oben <ref target="file11260">Nr. 1217</ref>, Anm. 3.</note> suo <lb xml:id="p2z5"/>imprimis colendo.</s>
				</p>
			</div>
