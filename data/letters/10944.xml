	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Unmittelbar vor der Verhandlung mit <persName ref="p2095" cert="high">Melanchthon</persName> in <placeName ref="l512" cert="high">Tübingen</placeName>; vgl. <hi>Moeller,</hi> <persName ref="p4079" cert="high">Zwick</persName> 188f (besonders Anm. 159); <persName ref="p2095" cert="high">Melanchthon</persName> BW, Regesten II 273, <ref target="file11840">Nr. 1794</ref>.</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Cum sperarem me <persName ref="p2095">Philippum</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p2095">Philipp Melanchthon</persName>.</note> <lb xml:id="p1z2"/>invenire <placeName ref="l512">Tubingae</placeName>, accinxi me itineri, neque <lb xml:id="p1z3"/>me fefellit spes mea.</s>
					<s n="3" xml:lang="la">Inveni illum impeditum <lb xml:id="p1z4"/>a principe<note xml:id="fn3" type="footnote" n="3">Herzog <persName ref="p9708">Ulrich von Württemberg</persName>.</note> et etiamnum agentem <placeName ref="l512">Tubingae</placeName> reformandae <lb xml:id="p1z5"/>achademiae caussa<note xml:id="fn4" type="footnote" n="4">Siehe oben <ref target="file10942">Nr. 900</ref>, Anm. 10.</note>.</s>
					<s n="4" xml:lang="la">Ego cum illo nunc <lb xml:id="p1z6"/>agam de concordiae negotio non impediendo, sed <lb xml:id="p1z7"/>firmius et certius concludendo.</s>
					<s n="5" xml:lang="la">Ubi domum rediero, <lb xml:id="p1z8"/>faciam te de reliquis certiorem<note xml:id="fn5" type="footnote" n="5">Siehe unten <ref target="file10950">Nr. 908</ref>.</note>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale cum fratribus <lb xml:id="p1z9"/>et dominis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Datum <placeName ref="l512">Tubingae</placeName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/>Tuus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tigurinae</placeName> ecclesię <lb xml:id="p2z3"/>antistiti, fratri optimo.</s>
				</p>
			</div>
		</body>
	</text>
