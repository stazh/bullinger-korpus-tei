	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime idemque ornatissime vir, domine amice <lb xml:id="p1z2"/>noster plurimum charissime ac observande.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Propensam benevolentiam nostram ac omne genus officii excellentissimae dominationi vestrae deferimus.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Cum hic illustri loco natus adolescens spectabilis et magnificus dominus <persName>Ioannes Kysska</persName>, <lb xml:id="p1z5"/>palatinides <placeName ref="l2571">Witebczensis</placeName>, liber baro in <placeName>Cziechanowyecz</placeName>, in <placeName>Tivye</placeName> et <placeName>Losko</placeName> dominus, in <lb xml:id="p1z6"/><placeName ref="l822">Germaniam</placeName> capessendae virtutis et rectae institutionis causa proficisceretur, nostrum consilium <lb xml:id="p1z7"/>sequutus statuit inprimis vestram rempublicam et scholam <placeName ref="l587">Tigurinam</placeName> videre ac in illa <lb xml:id="p1z8"/>conversari.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Noluimus itaque intermittere, quae est nostra in praestantiam tuam voluntatis <lb xml:id="p1z9"/>et officii affectio quaque benevolentia per mutuas literas constituta, quin adolescentem <lb xml:id="p1z10"/>praestantiae tuae commendaremus, ut eum vel nostra causa benevolentia et favoribus <lb xml:id="p1z11"/>suis prosequatur, et quicquid porro in eum humanitatis hospitalitatisque contulerit, id <lb xml:id="p1z12"/>eo loco habituri sumus ac ita accepturi, ac si in nos met ipsos vel filiolum nostrum non <lb xml:id="p1z13"/>ita pridem etiam ad vos ablegatum hoc officii esset collocatum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">De reliquo cupimus <lb xml:id="p1z14"/>praestantiae tuae firmam valetudinem et plurimam omnium bonarum foelicitatum accessio<lb xml:id="p1z15"/>nem.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Datum <placeName ref="l552">Vilnae</placeName> die 26. augusti anno domini 1563.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>Excellentissimae dominationis vestrae <lb xml:id="p1z17"/>bonus amicus <lb xml:id="p1z18"/><persName ref="p8117">Nicolaus Radziwyl</persName>, dei gratia in <placeName ref="l2573">Olyka</placeName> et <placeName ref="l2572">Nieswyess</placeName> dux, dominus in <placeName ref="l250">Klyeczko</placeName> <lb xml:id="p1z19"/>et <placeName ref="l2584">Grodek</placeName>, palatinus <placeName ref="l552">Vilnensis</placeName>, magni ducatus <placeName ref="l841">Lithuaniae</placeName> supremus marssalcus et <lb xml:id="p1z20"/>archicancellarius <placeName ref="l626">Brzestensis</placeName>, <placeName ref="l2570">Kawnensis</placeName>, <placeName ref="l2585">Borissoviensis</placeName> et in magna <placeName>Schawlye</placeName> capitaneus <lb xml:id="p1z21"/>generalis etc. man<lb xml:id="p1z22"/>u propria sub<lb xml:id="p1z23"/>scr<pb/><lb xml:id="p3z1"/>ipsit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo eidemque doctissimo viro domino <persName ref="p495">Henrico Bulingero</persName>, <lb xml:id="p4z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori vigilantissimo ac ecclesiarum <lb xml:id="p4z3"/><placeName ref="l862">Helveticarum</placeName> superintendenti dignissimo, amico nostro charissimo <lb xml:id="p4z4"/>ac observandissimo.</s>
				</p>
