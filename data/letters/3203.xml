	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Accusari me abs te, vir doctissime, non negligentiae et <lb xml:id="p1z2"/>ignaviae solum, quod iam pridem nihil ad te litterarum <lb xml:id="p1z3"/>dederim, verum etiam ingratitudinis, non dubito.</s>
					<s n="3" xml:lang="la">Quam <lb xml:id="p1z4"/>suspicionem apud te incurisse mihi sane gravissimum <lb xml:id="p1z5"/>foret, si meae innocentiae mihi non admodum bene con<lb xml:id="p1z6"/>scius essem et in promptu non essent causae, quę me <lb xml:id="p1z7"/>confestim ab hac opinione sinistra purgare possent.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Quę sunt: longo enim tempore ex oculis dolui et <lb xml:id="p1z9"/>gravi lippitudine defatigatus scribere non potui.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Ad quę etiam accedebat, quod nullus sese nuncius <lb xml:id="p1z11"/>offerret, cui meas committerem.</s>
					<s n="6" xml:lang="la">Propter quę te boni <lb xml:id="p1z12"/>consulere oportet, et si haec non satisfaciant, <foreign xml:lang="el">[griechisch]</foreign> <lb xml:id="p1z13"/>illa uti erga me, qua in amicorum erratis nunquam non <lb xml:id="p1z14"/>uti soles, debes.</s>
					<s n="7" xml:lang="la">Quod etiam atque etiam ut facias, reorum <lb xml:id="p1z15"/>more rogo.</s>
					<s n="8" xml:lang="la">Si me temporis angustia non premeret, <lb xml:id="p1z16"/>latius ad te scripsissem; sed brevi, uti spero, id fiet, <lb xml:id="p1z17"/>et si quid novi interveniat, id diligenter scribam.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z18"/>Bene vale, non minus sanctitate vitae quam doctrina clare.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/><placeName ref="l28">Basileae</placeName> ipsis nonis iunii anno christiano 1557.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/>Ex animo tuus <persName ref="p8073">Gilbertus Gognatus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietate et scientiarum ac linguarum <lb xml:id="p2z2"/>cognitione haud vulgari praedito <lb xml:id="p2z3"/>d. domino <persName ref="p495">henrico Bullingero</persName>, domino <lb xml:id="p2z4"/>et praeceptori suo in praecipuis <lb xml:id="p2z5"/>venerando.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
