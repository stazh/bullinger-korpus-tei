	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la">Mitto tuae humanitati, <persName ref="p495">Bullingere</persName> clarissime, per vestrum nuncium, <lb xml:id="p1z2"/>qui tuas mihi literas tradidit, <persName>Cydonii</persName> de contemnenda morte orationem, <lb xml:id="p1z3"/>quam desiderabas in proximis literis, misissemque con<lb xml:id="p1z4"/>ciliorum omnium canones ex conciliorum omnium tribus tomis <lb xml:id="p1z5"/>excerptas, si nuntium hoc onere satis magno gravare essem <lb xml:id="p1z6"/>ausus.</s>
					<s n="3" xml:lang="la">Divenduntur autem bibliopolis atque amicis novem <lb xml:id="p1z7"/>bazionibus <placeName ref="l257">Constanciensibus</placeName> ab <persName ref="p8126">Oporino</persName> nostro, qui non <lb xml:id="p1z8"/>voluit, ut tuo nomine quicquam pro <persName>Cydonii</persName> oratione <lb xml:id="p1z9"/>numerarem.</s>
					<s n="4" xml:lang="la">Plura nunc scribere non vacat, cum nuncius <lb xml:id="p1z10"/>finem literarum postulet.</s>
					<s n="5" xml:lang="la" ana="salute">Vale cum familia et fratribus <lb xml:id="p1z11"/>omnibus felicissime, quos omnes meo nomine salu<lb xml:id="p1z12"/>tabis.</s>
					<s n="6" xml:lang="la">Datae <placeName ref="l28">Basileae</placeName> 29. octobris anno 1553.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>T[uus] <persName ref="p8406">Con[radus] Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, episcopo <lb xml:id="p2z3"/><placeName ref="l587">Tigurino</placeName>, domino atque <lb xml:id="p2z4"/>amico incomparabili.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
