	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Mittimus ad vos, honorandi domini et fratres charissimi, <lb xml:id="p1z2"/>dilectum fratrem et fidelem symmistam nostrum d. <persName ref="p8011">Rodolphum Gvaltherum</persName>, <lb xml:id="p1z3"/>qui vobis bona fide exponet consilium et institutum nostrum idque non sine <lb xml:id="p1z4"/>boni amplissimi magistratus nostri voluntate.</s>
					<s n="3" xml:lang="la">Commendamus hunc vobis quam <lb xml:id="p1z5"/>possumus fidelissime et oramus vestram pietatem humanitatemque per dominum nostrum, <lb xml:id="p1z6"/>ut in hoc negotio vos exhibeatis, sicut decet fideles et concordię veritatisque <lb xml:id="p1z7"/>simplicis studiosos dei et ecclesiarum ministros.</s>
					<s n="4" xml:lang="la">Erit hoc deo volente <lb xml:id="p1z8"/>vinculum, quo mutuum constringemur charitate et amicicia, nullis unquam <lb xml:id="p1z9"/>temporibus rumpendum.</s>
					<s n="5" xml:lang="la">Cessabunt simul suspitiones omnes, et praecludetur via <lb xml:id="p1z10"/>futuris alioqui contentionibus et dissidiis.</s>
					<s n="6" xml:lang="la">Amate nos, fratres vestri <lb xml:id="p1z11"/>amantissimos.</s>
					<s n="7" xml:lang="la" ana="farewell">Vivite in Christo et valete; orate pro nobis dominum.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/><placeName ref="l587">Tiguri</placeName> 13. februarii 1566</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>Vester ex animo <lb xml:id="p1z14"/>totus <lb xml:id="p1z15"/><persName ref="p495">Heinrychus Bullingerus</persName> omnium <lb xml:id="p1z16"/>pastorum, concionatorum professorumque, <lb xml:id="p1z17"/>ministrorum <placeName ref="l587">Tigurinę</placeName> ecclesię, nomine.</s>
				</p>
				<p>
					<note type="author">[Darunter von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>"Ministris ecclesiarum <lb xml:id="p1z19"/><placeName ref="l28">Basileensis</placeName>, <placeName ref="l441">Schaffhusiensis</placeName> <lb xml:id="p1z20"/>et <placeName ref="l335">Mylhusianorum</placeName>."</s>
				</p>
			</div>
		</body>
	</text>
