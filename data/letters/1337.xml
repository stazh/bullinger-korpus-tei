	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Si vale<lb xml:id="p1z2"/>s, <lb xml:id="p1z3"/>bene est; ego quidem valeo.</s>
					<s n="2" xml:lang="la">De rebus omnibus, quae ad tuam dignitatem <lb xml:id="p1z4"/>pertinent, quid a me sit actum et porro constituendum, ad te, simul ac primum <lb xml:id="p1z5"/>e <placeName ref="l2524">Scotia</placeName> redii diligenter perscripsi.</s>
					<s n="3" xml:lang="la">Nunc summatim tantum ac breviter ea perse<lb xml:id="p1z6"/>quar, ne si forte priores literae intercipiantur, id omnino, cuius tua multum inter<lb xml:id="p1z7"/>esse puto, a me neglectum esse videatur.</s>
					<s n="4" xml:lang="la">Ac primum sermones tuos a principe <lb xml:id="p1z8"/>vehementer probari scias: mihi quidem et compluribus sane est certo <lb xml:id="p1z9"/>persuasum, te qui[d]quid habueris iudicii de sacris rebus in illum librum contuliss<lb xml:id="p1z10"/>e.</s>
					<s n="5" xml:lang="la">Faxit modo ille princeps deus et summus rerum omnium moderator, ut <lb xml:id="p1z11"/>voci ac doctrinae filii sui, nunc per terras et maria magnifice resonanti, vita <lb xml:id="p1z12"/>nostra aliquando et actiones respondeant.</s>
					<s n="6" xml:lang="la">Se scripturum ad te princeps <lb xml:id="p1z13"/>affirmat simul ac <placeName ref="l296">Londinum</placeName> aut <placeName ref="l60">Bradgaet</placeName> redeat; nunc se tibi per <lb xml:id="p1z14"/>multa et gravia negocia vult excusatum, quibus plus quam dici possit est <lb xml:id="p1z15"/>implicatus: rogat interim vehementer, ut silentium suum aequo ferre velis animo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>Literas <persName ref="p1336">Iohannae Grayae</persName> filiae domini iam istuc perlatas <lb xml:id="p1z18"/>existimo, quibus gratam se tibi ac memorem comprobare studet; sed qui<lb xml:id="p1z19"/>a literae fere semper sunt in periculo, ne vel intercipiantur vel omnino <lb xml:id="p1z20"/>negligantur, earum exemplum esse tua causa rescribendum putavi.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z22"/>Ill<lb xml:id="p1z24"/>ud ad ver<lb xml:id="p1z25"/>bum sic <lb xml:id="p1z26"/>se ha<lb xml:id="p1z27"/>bet:<note type="margin">a.R.: ...</note></s>
				</p>
				<p>
					<note>[f. 2175b./270e.:]</note>
					<s n="9" xml:lang="la">Tui <lb xml:id="p1z28"/>studi<lb xml:id="p1z29"/>osissimu<lb xml:id="p1z30"/>s <persName ref="p20172">Ioh<lb xml:id="p1z31"/>[<lb xml:id="p1z32"/>annes] ab <lb xml:id="p1z33"/>Ul<lb xml:id="p1z34"/>m<lb xml:id="p1z35"/>is</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z36"/>V<lb xml:id="p1z37"/>iro <lb xml:id="p1z38"/>docti<lb xml:id="p1z39"/>ss<pb/><lb xml:id="p2z1"/>imo et pi<lb xml:id="p2z2"/>et<lb xml:id="p2z3"/>ate pr<lb xml:id="p2z4"/>aest<lb xml:id="p2z5"/>anti<lb xml:id="p2z6"/>ssim<lb xml:id="p2z7"/>o <persName ref="p495">Heinri<lb xml:id="p2z8"/>ch<lb xml:id="p2z9"/>o B<lb xml:id="p2z10"/>ullin<lb xml:id="p2z11"/>ger<lb xml:id="p2z12"/>o</persName>, <lb xml:id="p2z13"/>domino suo <lb xml:id="p2z14"/>co<lb xml:id="p2z15"/>le<lb xml:id="p2z16"/>nd<lb xml:id="p2z17"/>iss<lb xml:id="p2z18"/>imo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z19"/><placeName ref="l587">Tigu<lb xml:id="p2z20"/>r<lb xml:id="p2z21"/>i</placeName>.</s>
				</p>
