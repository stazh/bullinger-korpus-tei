	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Si re ipsa hoc potuissem prestare, quod debui, vel saltem, quod volui, profecto <lb xml:id="p1z2"/>patricium illum nobilem vestrum honorifice excepissem; sed cum tempora <lb xml:id="p1z3"/>sint calamitosissima, nihil plane vel omnino parum tantoque viro in dignum feci.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Ecquid facerem, qui inter receptores regni Sathane sedeo?</s>
					<s n="4" xml:lang="la">In <placeName ref="l425">Romanam</placeName> <lb xml:id="p1z5"/>religionem fere per omnia consensum est.</s>
					<s n="5" xml:lang="la">Mali laudantur, boni vituperantur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/><persName ref="p8417">Musculus</persName> abivit; <persName ref="p1860">Michael Cellarius</persName> iamdudum in domino obdormivit et praeter <lb xml:id="p1z7"/>fecem nostratium nemo mansurus est.</s>
					<s n="7" xml:lang="la">Ego fere compedibus teneor; scribere plura <lb xml:id="p1z8"/>lachrime cohibent me.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z9"/>De Mundano illo mira prędicas.</s>
					<s n="9" xml:lang="la">Dominus reducat ipsum in viam.</s>
					<s n="10" xml:lang="la">Oro te <lb xml:id="p1z10"/>per amicitiam nostram, ut, quantum licet suarum rerum et casuum statum mihi aliquando <lb xml:id="p1z11"/>significes; hominem amo valde, vitia autem ipsius non item.</s>
					<s n="11" xml:lang="la"><persName ref="p4851">Typographus</persName> <lb xml:id="p1z12"/>vester, vir optimus, ex me habet, quid ad illum scribendum sit; fac, ne illud <lb xml:id="p1z13"/>prętereatur.</s>
					<s n="12" xml:lang="la">Ego ex animo cuperem ipsius libertatem, qua commode potuisset <lb xml:id="p1z14"/>fraui, nisi <persName ref="p21113">Plutone</persName> ductus esse in servitutem reiecisset.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z15"/>Interim fere omnes civitates intereunt exceptis <placeName ref="l491">Argentoratis</placeName>, <placeName ref="l291">Lyndovien(si)</placeName>, <lb xml:id="p1z16"/><placeName ref="l257">Constantia</placeName> et <placeName ref="l749">Saxonicis</placeName> civitatibus.</s>
					<s n="14" xml:lang="la"><placeName ref="l361">Nuremberga</placeName> et <placeName ref="l513">Ulma</placeName> iamdudum <lb xml:id="p1z17"/>lapsis <placeName ref="l18">Augusta</placeName> cecidit.</s>
					<s n="15" xml:lang="la">Flebiliores casus in cordibus piorum nunquam vidisti.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z18"/>O si iam illos <persName ref="p18827">Hercules</persName> deberes metiri, quos olim aliquid esse putaras, <lb xml:id="p1z19"/>vanos prorsus, ne dicam fungos cerneres.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z20"/>Orate pro diuturna tranquilitate vestra sedulo, ne intretis in temtationem; <lb xml:id="p1z21"/>ego itidem facturus sum probe, atque utinam non solum voti istius, sed <lb xml:id="p1z22"/>etiam futuri consorcii vestri compos fiam.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z23"/>Epitome vestra lima forsan egebit, quam adhiberi plurimum oro; tum <lb xml:id="p1z24"/>etiam aliquando excudi autor petit.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute">Salveant omnes et singuli fratres <lb xml:id="p1z25"/>et amici nostro.</s>
					<s n="20" xml:lang="la" ana="farewell">Eternum vale.</s>
					<s n="21" xml:lang="la">28. iunii 1548.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z26"/>Tuus totus etc.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro domino <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName> etc., amico et fratri.</s>
				</p>
			</div>
		</body>
