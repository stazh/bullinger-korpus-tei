	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Duo viri honesti ad proxima comitia <placeName ref="l862">Helvetica</placeName> ab ecclesia <placeName>Lippersvilensi</placeName> <lb xml:id="p1z2"/>missi sunt, quorum hic unus est, vir pius magno veritatis evangelicae <lb xml:id="p1z3"/>promovendae zelo ardens.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Proinde te, d. affinis mihi plurimum observande, <lb xml:id="p1z4"/>etiam atque etiam oratum volo, ut ecclesiam praedictam et eius negocium, quod <lb xml:id="p1z5"/>hic ad te retulerit, habeas tibi commendatissimum.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Communi suffragio..<lb xml:id="p1z6"/>. vit ecclesia <placeName>Lippersvilensis</placeName> nullum recipere concionatorem, nisi <lb xml:id="p1z7"/>ab ecclesiae <placeName ref="l587">Tigurinae</placeName> proceribus examinatum et admissum, quique honestę <lb xml:id="p1z8"/>vitae evangelii ministro dignae testimonium afferat et qui insuper a <lb xml:id="p1z9"/>collatore eius conditionis nihil ex stipendio antiquo detrahi patiatur, taleque <lb xml:id="p1z10"/>decretum ab <placeName ref="l862">Helvetiis</placeName> in hisce comitiis impetrarunt.</s>
					<s n="4" xml:lang="la">Quae omnia verbis <lb xml:id="p1z11"/>prolixioribus hic bonus vir tibi narrabit, de cuius fide ne dubites; nam et <lb xml:id="p1z12"/>consul noster (si ex comitiis rediit) idem testimonium feret, ex quo rectius <lb xml:id="p1z13"/>omnia intelliges.</s>
					<s n="5" xml:lang="la"><persName>Victor Fabritius</persName> quid conetur, hic quoque tibi referet, <lb xml:id="p1z14"/>ut pluribus te (d. affinis colendissime) occupatissimum obtundere nolim.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Haec, quaeso, pro tua humanitate aequi bonique consule.</s>
					<s n="7" xml:lang="la" ana="salute">Mater mea te <lb xml:id="p1z16"/>et uxorem tuam cum tota familia plurimum salvere iubet.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Raptim <placeName ref="l166">Gachnangę</placeName> 4. septembris 1564.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/>Tui observantissimus <lb xml:id="p1z19"/><persName ref="p1541">Ioannes Hertherus</persName><lb xml:id="p1z20"/>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietate et doctrina clarissimo <lb xml:id="p2z2"/>viro d. m. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>patri et mecoenati <lb xml:id="p2z4"/>suo semper venerando.</s>
				</p>
			</div>
		</body>
	</text>
