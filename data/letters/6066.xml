	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Venit ad vos, reverende in Christo pater, <lb xml:id="p1z2"/>d. <persName ref="p3196">Tscharnerus</persName>, civitatis nostrae consul; profic<lb xml:id="p1z3"/>iscitur <placeName ref="l301">Lugdunum</placeName> et inde, quantum iudico, <lb xml:id="p1z4"/>ad regem ipsum.</s>
					<s n="3" xml:lang="la">Agit nomine <placeName ref="l893">Trium <lb xml:id="p1z5"/>Foederum</placeName> (a quibus publica authoritate <lb xml:id="p1z6"/>mittitur) negotium d. <persName>Pellizariorum</persName>.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Itaque <lb xml:id="p1z7"/>si quid in <placeName ref="l832">Galliam</placeName>, si <placeName ref="l167">Genevam</placeName> ad amicos <lb xml:id="p1z8"/>scripturus es, habes hic certum hominem.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Non est, quod eum tibi commendem, cum <lb xml:id="p1z10"/>sit tibi commendatissimus.</s>
					<s n="6" xml:lang="la">Si vos, si <lb xml:id="p1z11"/>senatus vester aliquid in eum honoris <lb xml:id="p1z12"/>et officii contulerit, facit rem se dignam; <lb xml:id="p1z13"/>id ut fiat, tu consules vestros hortabere.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Quid actum sit cum legato regio, coram <lb xml:id="p1z15"/>is exponet.</s>
					<s n="8" xml:lang="la">Proxime ad te scripsi et <lb xml:id="p1z16"/>de discessu legati te certiorem feci.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Interim <lb xml:id="p1z17"/>nihil ex <placeName ref="l834">Italia</placeName> allatum est, quod tu quidem <lb xml:id="p1z18"/>scire velles.</s>
					<s n="10" xml:lang="la">Miror istum miserrimum <lb xml:id="p1z19"/>hominem<note type="margin">a.R.: mit Verweisungszeichen "<persName ref="p458">Brentium</persName>".</note> adeo delyrare; sed magis <lb xml:id="p1z20"/>principem eius ineptiis indulgere.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z21"/>Deum rogo, ut te conservet nobis.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale, <lb xml:id="p1z22"/>reverende in Christo pater.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l98">Curię</placeName> 16. <lb xml:id="p1z23"/>martii anno 1564.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>T[uus] <persName ref="p8009">F[abricius</persName>].</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Ad nos perscriptum est d. <persName ref="p540">Calvinum</persName> letaliter <lb xml:id="p2z2"/>aegrotare, quod nuncium nos non parum terruit.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Si tu d. consulem <lb xml:id="p2z3"/>literis tuis ad amicos <placeName ref="l301">Lugduni</placeName> et in aula iuveris, faceres rem nobis omnibus gratissimam Amp<lb xml:id="p2z4"/>lissimo viro domino <persName ref="p495">Heinrycho Bullingero</persName>, domino suo et in Christ<lb xml:id="p2z5"/>o patri multum reverendo.</s>
					<s n="17" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
