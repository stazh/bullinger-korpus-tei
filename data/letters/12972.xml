	<text xml:lang="de">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Nova scribit<note xml:id="fn1" type="footnote" n="1">Mit einem nicht erhaltenen Brief.</note> <persName ref="p8418">Myconius</persName>, quę ab <lb xml:id="p1z2"/><placeName ref="l491">Argentina</placeName> accepit.<note xml:id="fn2" type="footnote" n="2">Wohl aus <persName ref="p467">Martin Bucers</persName> undatiertem Brief von Ende Mai 1547 (<bibl>Henrich, Myconius BW</bibl>, <ref target="file11125">Nr. 1082</ref>).</note></s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="3" xml:lang="la">Conscribit <persName ref="p8112">Gallus</persName><note xml:id="fn3" type="footnote" n="3">König <persName ref="p8112">Heinrich II.</persName> - Siehe dazu <ref target="file12973">Nr. 2924</ref> und <ptr target="qvfn17189-3" type="qv"/>.</note> exercitum <lb xml:id="p1z3"/>passim in istis partibus.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="4" xml:lang="de"><lb xml:id="p1z4"/>Die wollen ist im vas,<note xml:id="fn4" type="footnote" n="4">Siehe dazu <ref target="file12931">Nr. 2882</ref>,<ptr target="qvzl17149-2" type="qv"/>; <ref target="file12952">Nr. 2903</ref>,<ptr target="qvzl17169-3" type="qv"/>.</note> das <persName ref="p8126">Oporinus</persName> ingeschlagen<note xml:id="fn5" type="footnote" ana="lex" n="5">eingepackt.</note> <lb xml:id="p1z5"/>hat.</s>
					<s n="5" xml:lang="de">Darinn werden ir sy fynden.</s>
					<s n="6" xml:lang="de">Sy alle <lb xml:id="p1z6"/>uwer, die in vaß ist, ußgenomen die wysse, <lb xml:id="p1z7"/>die ich uch hi schicke mit dem rütteten botten.<note xml:id="fn6" type="footnote" n="6">Unbekannt.</note></s>
					<s n="7" xml:lang="de"><lb xml:id="p1z8"/>Die ander wollen im säckli ist deß anderen.<note xml:id="fn7" type="footnote" n="7">Unbekannt.</note></s>
					<s n="8" xml:lang="de"><lb xml:id="p1z9"/>Ir mögent ouch woll<note xml:id="fn8" type="footnote" ana="lex" n="8">wohl.</note> alle farben machen, die <lb xml:id="p1z10"/>ir nit fynden, wann ir sy nur durch ein wasser<note xml:id="fn9" type="footnote" n="9">Hier als "Farblauge" zu verstehen.</note> <lb xml:id="p1z11"/>ziehen.</s>
					<s n="9" xml:lang="de">Do<note xml:id="fn10" type="footnote" n="10">Auf diese Weise.</note> mögent ir zuͦ schattyeren<note xml:id="fn11" type="footnote" ana="lex" n="11">färben.</note> wol vil machen <lb xml:id="p1z12"/>allerley farben.</s>
					<s n="10" xml:lang="de">Das klein büschley im sack hat<note xml:id="fna" type="footnote" n="a"><hi>In der Vorlage</hi> hast.</note> <lb xml:id="p1z13"/>5 lib.<note xml:id="fn12" type="footnote" n="12">Pfund (als Gewichtsmaß), etwa 1/2 kg.</note>; die uwer hat 15 lib. Nit mynder hat <lb xml:id="p1z14"/>myn <persName ref="p4970">frow</persName><note xml:id="fn13" type="footnote" ana="bio" n="13"><persName ref="p4970">Apollonia, geb. Glaser</persName>.</note> keynnen<note xml:id="fn14" type="footnote" ana="lex" n="14">können.</note> nämen.</s>
					<s n="11" xml:lang="de">Es ist ouch rotte wolle <lb xml:id="p1z15"/>in eim briffli.<note xml:id="fn15" type="footnote" n="15">In einem mit Papier eingewickelten kleineren Paket; s. <bibl source="b590">SI</bibl> V 447.</note></s>
					<s n="12" xml:lang="de">Die ist <placeName ref="l301">leonschy</placeName><note xml:id="fn16" type="footnote" n="16">Aus <placeName ref="l301">Lyon</placeName>.</note> wöllen; die findet <lb xml:id="p1z16"/>man by unß nit.</s>
					<s n="13" xml:lang="de">Habent wol acht uff die gefel<lb xml:id="p1z17"/>schete<note xml:id="fn17" type="footnote" ana="lex" n="17">gefälschte.</note> wöllen; so<note xml:id="fn18" type="footnote" n="18">auf diese Weise.</note> mögent ir alle farben zuͦ wegen <lb xml:id="p1z18"/>bringen.<note xml:id="fn19" type="footnote" n="19">zuͦ wegen bringen: erzeugen.</note></s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="14" xml:lang="de">Kostet ein lib. wollen 6 batzen oder 10 ß<note xml:id="fn20" type="footnote" n="20">Schilling (der Batzen entsprach also damals 1 Schilling + 8 Pfennigen - 1 Schilling ist 12 Pfennige wert). - Aus dieser Angabe wird deutlich, dass die rote Wolle 5 Pfund wog.</note> <lb xml:id="p1z19"/><placeName ref="l28">Basler</placeName> werung.</s>
					<s n="15" xml:lang="de">Rechnen ir nun uß, was die 20 <lb xml:id="p1z20"/>lib. pringen.<note xml:id="fn21" type="footnote" n="21">Gesamtbetrag: 200 ß = 10 Pfund (gemeint ist diesmal die Geldwährung).</note></s>
					<s n="16" xml:lang="de">Habent also verguͦtt.</s>
					<s n="17" xml:lang="de">Wo es myn frow <lb xml:id="p1z21"/>hette mögen besser ankommen<note xml:id="fn22" type="footnote" n="22">besser ankommen: billiger erhalten können; vgl. <bibl source="b590">SI</bibl> III 274.</note>, so welte sy es gthon <lb xml:id="p1z22"/>haben.</s>
					<s n="18" xml:lang="de">Sy hofft aber, sy habe hüpsche wollen keufft und <lb xml:id="p1z23"/>uß eim grossen huffen ußglesen.</s>
					<s n="19" xml:lang="de">Darumb nement <lb xml:id="p1z24"/>fur guͦt.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="20" xml:lang="la" ana="salute">Saluta <persName ref="p8051">uxorem</persName> tuam<note xml:id="fn23" type="footnote" ana="bio" n="23"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> cum liberis.<note xml:id="fn24" type="footnote" n="24">Zu deren Namen <ref target="file12934">Nr. 2885</ref>, <ptr target="qvfn17152-3" type="qv"/>.</note></s>
					<s n="21" xml:lang="la" ana="farewell">Vale<lb xml:id="p1z25"/>.</s>
					<s n="22" xml:lang="la"><lb xml:id="p1z26"/>3. iuni 1547.</s>
					<s n="23" xml:lang="la"><lb xml:id="p1z27"/>Tuus <persName ref="p1278">Gastius</persName> <lb xml:id="p1z28"/>ex animo.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="24" xml:lang="de"><pb/><lb xml:id="p2z1"/>Diser brieff gehört <lb xml:id="p2z2"/>dem wolgelerten herren <lb xml:id="p2z3"/>meyster <persName ref="p495">Heynrich Bullinger</persName>, <lb xml:id="p2z4"/>lütpriester zuͦ <lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName> im gestifft<note xml:id="fn25" type="footnote" ana="lex" n="25">Großmünsterstift.</note>, <lb xml:id="p2z6"/>mynem günstigen, lie<lb xml:id="p2z7"/>ben herren und fründt.</s>
				</p>
			</div>
		</body>
