	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Tuas accepi, chare frater, et c<lb xml:id="p1z2"/>upide expecto tragoediae vestrae catastrophen <lb xml:id="p1z3"/>comicam.</s>
					<s n="3" xml:lang="la">Dominus concedat vobis pacem.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">D. <persName>Müll<lb xml:id="p1z4"/>nerus</persName> ipse ad te scribet, opinor.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Dicebat: "Si <lb xml:id="p1z5"/>hoc praescivissem illum me vino hoc donaturum, <lb xml:id="p1z6"/>non petivissem ab eo." etc.</s>
					<s n="6" xml:lang="la">Nihil aliud nunc ha<lb xml:id="p1z7"/>beo, quod scribam.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Habes hic <persName ref="p8033">Bezae</persName> literas; eas <lb xml:id="p1z8"/>remitte ad me.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Saluta amplissimum virum d. <lb xml:id="p1z9"/>legatum, cui nihil scribo, ne conduplicem molestias; <lb xml:id="p1z10"/>scio ipsum laborare, affligi et angi.</s>
					<s n="9" xml:lang="la">Est illi <lb xml:id="p1z11"/>negotium cum huiusmodi hominibus, cum quibus non <lb xml:id="p1z12"/>facile transigitur commode.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Salutant te nostri <lb xml:id="p1z13"/>omnes.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Multae nunc <placeName ref="l157">Francfortum</placeName> literae a m<lb xml:id="p1z14"/>e scriptae sunt et scribuntur; brevior ergo sum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Dis<lb xml:id="p1z15"/>cessit heri <persName ref="p1227">Froschouerus</persName> probe oneratus meis <lb xml:id="p1z16"/>literis; cras alii mercatores nostri sequentur.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z17"/>Scribo adhuc plures etiam <placeName ref="l210">Heydelbergam</placeName>; <lb xml:id="p1z18"/>meis ergo tuas includam et sub vesperam cras ma<lb xml:id="p1z19"/>ne profecturis tradam.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Bene vale cum omnibus <lb xml:id="p1z20"/>tuis.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 30. martii 1565.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z22"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro fideli, <lb xml:id="p2z4"/>domino et fratri meo <lb xml:id="p2z5"/>colendo et dilecto.</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
