	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Domino <persName ref="p495">Heinricho Bullingero</persName> <persName ref="p8011">Rod. Gvaltherus</persName><note xml:id="fnb" type="footnote" n="b">Nachträglich <hi>dem Brief vorangestellt, da für die Unterschrift nicht genügend Raum blieb.</hi></note>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Scholarcharum nostrorum decretum, human<lb xml:id="p1z3"/>issime pater, ex <persName ref="p167">Ammiani</persName> literis intellexi<note xml:id="fn1" type="footnote" n="1">Vgl. oben <ref target="file11434">Nr. 1391</ref>, 2 mit Anm. 2.</note>.</s>
					<s n="4" xml:lang="la">Curabo, ne illorum sententiae <lb xml:id="p1z4"/>immoriger fuisse videar, et quamprimum per occasionem potero, <lb xml:id="p1z5"/><placeName ref="l28">Basilea</placeName> abibo nec diebus plus octo illic commorabor idque <lb xml:id="p1z6"/>d. <persName ref="p506">Butleri</persName> caussa, quem <placeName ref="l157">Frankfordiam</placeName> usque comitem <lb xml:id="p1z7"/>habiturus sum.</s>
					<s n="5" xml:lang="la">Nolim tamen, id cuiquam indices, donec a <lb xml:id="p1z8"/><placeName ref="l157">Frankfordia</placeName> <persName ref="p506">Butlerus</persName> redierit; nemo enim ne <placeName ref="l28">Basileae</placeName> <lb xml:id="p1z9"/>quidem illum praeter me solum discessurum novit.</s>
					<s n="6" xml:lang="la">Sunt, <lb xml:id="p1z10"/>proh dolor, <placeName ref="l830">Anglorum</placeName> res in novaculae acie, quod aiunt, <lb xml:id="p1z11"/>constitutae<note xml:id="fn2" type="footnote" n="2">d. h. auf Messers Schneide, vgl. <bibl source="b56">Adagia</bibl>, 1, 1, 18 (<bibl source="b370">LB</bibl> II 33).</note>.</s>
					<s n="7" xml:lang="la">Venit ad eum <placeName ref="l830">Anglus</placeName><note xml:id="fn3" type="footnote" n="3">Unbekannt.</note> quidam hisce diebus <lb xml:id="p1z12"/>sua causa ex <placeName ref="l830">Anglia</placeName> huc missus, quem statim <lb xml:id="p1z13"/>literis datis ablegavit; ipse sequetur nunc <placeName ref="l157">Frankfordiam</placeName> <lb xml:id="p1z14"/>usque, ubi nonnulli (ut opinor) <placeName ref="l830">Angli</placeName> illum convenient, <lb xml:id="p1z15"/>viri pii et mihi non ignoti, quos certe exules esse <lb xml:id="p1z16"/>metuo.</s>
					<s n="8" xml:lang="la">Hęc sunt, ut vides, mundi et principum <lb xml:id="p1z17"/>exercitia.</s>
					<s n="9" xml:lang="la">Tu tamen vel mea causa hęc nemini patefacias, <lb xml:id="p1z18"/>ne mihi hęc exprobrandi occasio oboriatur.</s>
					<s n="10" xml:lang="la">Tibi soli <lb xml:id="p1z19"/>hęc scribo, quem patrem mihi fidelissimum cognovi.<pb type="edition" next="110"/></s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/>Interim tamen hoc animum meum non mediocriter angit, quod <lb xml:id="p1z21"/>patronus <persName ref="p167">Ammianus</persName> mihi datus sit<note xml:id="fn4" type="footnote" n="4">Vgl. oben <ref target="file11434">Nr. 1391</ref>, 2-6.</note>.</s>
					<s n="12" xml:lang="la">Causam mirando <lb xml:id="p1z22"/>consequi nequeo.</s>
					<s n="13" xml:lang="la">Vir bonus est, non tamen tam mihi <lb xml:id="p1z23"/>familiaris, ut patroni officium illi tam libere quam <lb xml:id="p1z24"/>tibi committere audeam.</s>
					<s n="14" xml:lang="la">Faciam tamen, quod velint.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z25"/>Hoc solum rogo, ne tu parentis animum erga<note xml:id="fnc" type="footnote" n="c"><hi>vor</hi> erga <hi>gestrichenes</hi> ex.</note> me exuas.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z26"/>Te enim solum rerum et fortunarum mearum refugium <lb xml:id="p1z27"/>agnosco, quod si mihi negaretur, certe nec literis nec <lb xml:id="p1z28"/>patrię operam dare posthac iuvaret.</s>
					<s n="17" xml:lang="la">Sed, quoad te mihi <lb xml:id="p1z29"/>patrem videro, curabo, ne alicuius culpae insimulari <lb xml:id="p1z30"/>merito possim.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">Salutat te d. <persName ref="p8418">Myconius</persName> et <persName ref="p1365">Gryneus</persName>.</s>
					<s n="19" xml:lang="la" ana="salute"><lb xml:id="p1z31"/>Salutabis nomine meo totam tuam familiam.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Velim certe, <lb xml:id="p1z32"/>mihi credas, iuvenes Abatissani collegii<note xml:id="fn5" type="footnote" n="5">Gemeint sind die Schüler des von <persName ref="p8428">Rhellikan</persName> geleiteten Fraumünster-Alumnats. <persName ref="p8011">Gwalthers</persName> Mitstudenten und Hausgenossen <persName ref="p8383">Christian Wirth</persName>, <persName ref="p6755">Konrad Suter</persName> und <persName ref="p2811">Christoph Rotacher</persName> waren dort erzogen worden; s. <hi>Bächtold,</hi> <persName ref="p495">Bullinger</persName> vor dem Rat 202, Anm. 36.</note> meliore morum <lb xml:id="p1z33"/>civilitate instrui, si apud exteros laudem per hos consequi <lb xml:id="p1z34"/>statuitis; sed hęc per me tibi significata esse nolim quenquam scire.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="farewell"><lb xml:id="p1z35"/>Vale, humanissime pater, et me tibi commendatum habeas.</s>
					<s n="22" xml:lang="la"><lb xml:id="p1z36"/><placeName ref="l28">Basileae</placeName>, 17. calendas iunii 1540.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae antistiti vigilantissimo, <lb xml:id="p2z4"/>patri suo imprimis <lb xml:id="p2z5"/>colendo.</s>
				</p>
				<p>
					<s n="24" xml:lang="de"><placeName ref="l587">Z[ürich]</placeName><note xml:id="fnd" type="footnote" n="d"><hi>Teilweise auf das nicht mehr vorhandene Verschlußband geschrieben.</hi></note>.</s>
				</p>
			</div>
