	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hic <lb xml:id="p1z2"/>frater<note xml:id="fn1" type="footnote" n="1">Unbekannt.</note>, sicubi posset idoneum locum obtinere, bonum <lb xml:id="p1z3"/>testimonium hinc a nobis ad vos adferet et pietatis <lb xml:id="p1z4"/>et industrię, non a me tantum, sed ab<pb type="edition" next="213"/> omnibus <lb xml:id="p1z5"/>hic fratribus.</s>
					<s n="3" xml:lang="la">Hoc ideo ad te scribo, ne hac parte <lb xml:id="p1z6"/>quidquam obstet vobis, si quid sit, ubi possit commo<lb xml:id="p1z7"/>de recipi.</s>
					<s n="4" xml:lang="la">Causas, cur mutare locum hunc cogitet, <lb xml:id="p1z8"/>ipse tibi poterit narrare, et nos etiam non <lb xml:id="p1z9"/>gravaremur scribere.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">De iis, quae sunt allata <lb xml:id="p1z10"/>iam ex comitiis<note xml:id="fn2" type="footnote" n="2">Gemeint sind Nachrichten vom Reichstag zu <placeName ref="l410">Regensburg</placeName>.</note>, scriberem, si hunc scirem recta <lb xml:id="p1z11"/>ad vos ire.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Nos valemus hic.</s>
					<s n="7" xml:lang="la">Vos omnes <lb xml:id="p1z12"/>in domino Christo recte valere cupio.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale, mihi <lb xml:id="p1z13"/>colendissime et charissime frater.</s>
					<s n="9" xml:lang="la" ana="salute">Fratres omnes in domino <lb xml:id="p1z14"/>mihi saluta.</s>
					<s n="10" xml:lang="la">7. iunii 41.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z15"/>Tuus <persName ref="p1365">Grynęus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henricho Bullingero</persName> <lb xml:id="p2z2"/>suo, amico et <lb xml:id="p2z3"/>fratri charissimo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tyguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
