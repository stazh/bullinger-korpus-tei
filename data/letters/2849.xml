	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literas tuas nondum accepi et miror iuvenem, <lb xml:id="p1z2"/>qui meas tulerat, tam diu abesse et occasionem, qua illi nunc <lb xml:id="p1z3"/>posset prospici negligere.</s>
					<s n="3" xml:lang="la">Librum, quem requiris, mox accipies.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Nunc praeterea nihil, nisi quod <placeName ref="l2477">Palatinus</placeName> elector mortuus <lb xml:id="p1z5"/>est.</s>
					<s n="5" xml:lang="la">Cui si succedat <persName ref="p2411">Otto Heinrichus</persName>, spes est non <lb xml:id="p1z6"/>parum momenti ad religionis profectum accessurum esse.</s>
					<s n="6" xml:lang="la">Marchio <lb xml:id="p1z7"/>nobis vicinus diutius, quam vellemus, cunctatur; a <lb xml:id="p1z8"/>quo his diebus expectamus responsum, quia a praefectis <lb xml:id="p1z9"/>coenobii ad S. Albanum et me quoque interpellatus <lb xml:id="p1z10"/>est nomine parrhochiae cuiusdam in ditione ipsius, <lb xml:id="p1z11"/>cui propter ius patronatus, quod vocant, concionatorem ex urbe <lb xml:id="p1z12"/>iam per duos menses praefecimus et doctrina <lb xml:id="p1z13"/>evangelii cum illustri successu herbescit.</s>
					<s n="7" xml:lang="la" ana="farewell">Bene vale <lb xml:id="p1z14"/>in Christo Iesu cum tuis omnibus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l28">Basileae</placeName> 5. martii <lb xml:id="p1z15"/>anno 1556.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>T[uus] <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, domino <lb xml:id="p2z3"/>et symmistae colendi<lb xml:id="p2z4"/>ssimo suo.</s>
				</p>
			</div>
		</body>
	</text>
