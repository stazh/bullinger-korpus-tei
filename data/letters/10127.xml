	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Die erwähnten Ereignisse weisen zweifelsfrei ins Jahr 1532.</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. et pacem.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Responsionem ad praedestinationis negocium<note xml:id="fn2" type="footnote" n="2">Nicht erhalten. Zur Sache s. oben <ref target="file10098">[Nr. 69]</ref> S. 56f, Anm. 18.</note> meditari hactenus, charissime <persName ref="p495">Heinrice</persName>, <lb xml:id="p1z2"/>per ocium non licuit, licebit autem, cum singula iam capitula per agrum nostrum <placeName ref="l41">Bernatem</placeName> convenerimus.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Unum adhuc restat, quod ad 28. maii visitabimus<note xml:id="fn3" type="footnote" n="3">Siehe oben S. 117, Anm. 20.</note>.</s>
					<s n="4" xml:lang="la">Caeterum ad eandem diem <placeName ref="l28">Basilienses</placeName> synodum <lb xml:id="p1z4"/>celebraturi<note xml:id="fn4" type="footnote" n="4">Zur <placeName ref="l28">Basler</placeName> Synode vom 28. Mai 1532 s. <bibl source="b53">ABaslerRef</bibl> VI 101; <hi>Kirchhofer,</hi> Myconius 106f.</note> vocarunt et nos.</s>
					<s n="5" xml:lang="la">Quibus fratrem<note xml:id="fn5" type="footnote" n="5">Unbekannt.</note> ex agro misimus.</s>
					<s n="6" xml:lang="la">Sperant <persName ref="p5565">Capitonem</persName> adfuturum<note xml:id="fn6" type="footnote" n="6"><persName ref="p5565">Wolfgang Capito</persName> nahm an der <placeName ref="l28">Basler</placeName> Synode tatsächlich teil, <hi>s. Baum</hi> 489.</note>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><pb type="edition" next="124"/>Interim <lb xml:id="p1z5"/><placeName ref="l832">Gallorum</placeName> legati<note xml:id="fn7" type="footnote" ana="bio" n="7">Die <placeName ref="l832">französischen</placeName> Gesandten waren: <persName ref="p4620">Louis Daugerant, Seigneur de Boisrigaut</persName>, der erste ordentliche Gesandte der <placeName ref="l832">französischen</placeName> Krone bei der <placeName ref="l862">Eidgenossenschaft</placeName> 1522-1544 und 1547/1548 (Edouard <hi>Rott,</hi> Histoire de la Représentation Diplomatique de la France auprès des Cantons Suisses, de leurs Alliés et de leurs Confédérés I, 1430-1559, Bern 1900, S. 305-330; <bibl source="b700">Z</bibl> X 484, Anm. I und XI, Reg.; <bibl source="b291">HBLS</bibl> II 293) und <persName ref="p5728">Lambert Maigret (Meigret)</persName>, gest. 1533 in <placeName ref="l760">Solothurn</placeName>, außerordentlicher Gesandter in der <placeName ref="l862">Schweiz</placeName> 1530-1533 <hi>(s. Rott,</hi> aaO, S. 380-387; <bibl source="b700">Z</bibl> X 457, Anm., I und XI, Reg.).</note> ad urbem nostram venere atque senatum nostrum a <persName ref="p18536">duce Sabaudiae</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p18536">Karl III., Herzog von Savoyen</persName>.</note>, qui quottid[i]e foedus antiquum <lb xml:id="p1z6"/>renovare meditatur<note xml:id="fn9" type="footnote" n="9">Zu den Verhandlungen wegen der Erneuerung des Bündnisses mit <placeName ref="l2478">Savoyen</placeName> 1532 s. <bibl source="b197">EA</bibl> IV/1b 1282f.1337-1339.1345.1347.1351; ASchweizerRef IV 1409.1458a.1579. V 162; s. noch Anshelm VI 152f.</note>, avertere annisi, id quod impetrare non potuerunt<note xml:id="fn10" type="footnote" n="10">Zum erfolglosen <placeName ref="l832">französischen</placeName> Versuch vom 22. und 24. Mai 1532, die Bündnisverhandlungen zwischen <placeName ref="l2478">Savoyen</placeName> und <placeName ref="l41">Bern</placeName> zu stören s. <bibl source="b197">EA</bibl> <hi>IV/1b</hi> 1345f; Anshelm VI 150, 13-26.</note>.</s>
					<s n="8" xml:lang="la">Ego vero suspicatus <lb xml:id="p1z7"/>sub hoc praetextu pensionum et funesti foederis<note xml:id="fn11" type="footnote" n="11">Gemeint ist die <placeName ref="l832">französische</placeName> Allianz von 1521, die <placeName ref="l832">Frankreich</placeName> das Anwerben von Söldnern erlaubte. <placeName ref="l41">Bern</placeName> hielt sich ihr seit 1529 fern, <placeName ref="l587">Zürich</placeName> war ihr nie beigetreten, s. <hi>von Muralt,</hi> Renaissance und Reformation 428-431; Peter <hi>Stadler,</hi> Das Zeitalter der Gegenreformation, in: <bibl source="b318">HSG</bibl> I 574f.</note> reditum attentari.</s>
					<s n="9" xml:lang="la">Nam amicis quibusdam in aurem <lb xml:id="p1z8"/>mentiri non est veritus <persName ref="p20225">Gallus</persName> post 14 dies <placeName ref="l587">Tigurinos</placeName> inituros foedus gallicum, sicut et <placeName ref="l2448">Quinquepagici</placeName><note xml:id="fn12" type="footnote" n="12">Zur wirtschaftlichen Bedeutung der <placeName ref="l832">französischen</placeName> Allianz für die <placeName ref="l2448">V Orte</placeName> s. <hi>Stadler,</hi> aaO, mit Lit.</note>.</s>
					<s n="10" xml:lang="la">Id quod et <lb xml:id="p1z9"/>de nobis apud vestros dici non dubito.</s>
					<s n="11" xml:lang="la">Sed certe, si non maturassent abitum, plebem nostram turbassent.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z10"/>Acclamabat illis plebs in plateis:</s>
					<s n="13" xml:lang="de">Ir metzgerknecht, hett üch der tüfel hartragen?</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z11"/><placeName ref="l760">Salodori</placeName> maxima est civium dissensio, ut omnibus boris alterius partis interitum formidemus propter verbum domini.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z12"/>Concionatorem evangelicum<note xml:id="fn13" type="footnote" ana="bio" n="13"><persName ref="p6957">Urs Völmi (Völmlin)</persName>, gest. 1558, aus <placeName ref="l760">Solothurn</placeName>, war seit 1512 Priester und Kaplan in <placeName ref="l760">Solothurn</placeName>, bis er 1522 wegen Reformationsfreundlichkeit abgesetzt wurde, jedoch bis 1527 in der Stadt bleiben durfte. 1528/1529 war er Pfarrer in <placeName ref="l1108">Koppigen</placeName> (<placeName ref="l2826">Kt. Bern</placeName>), danach in <placeName ref="l1099">Balsthal</placeName> und vielleicht auch in <placeName ref="l1109">Lüßlingen</placeName> (<placeName ref="l468">Kt. Solothurn</placeName>), 1530 wurde er an Stelle des nach <placeName ref="l1099">Balsthal</placeName> versetzten <persName ref="p5028">Philipp Grotz</persName> (s. oben <ref target="file10118">[Nr. 89]</ref> S. 108, Anm. 7) Pfarrer in <placeName ref="l760">Solothurn</placeName>. Nach dem Zweiten <placeName ref="l242">Kappelerkrieg</placeName> mehrmals angepöbelt und bedroht, wurde <persName ref="p6957">Völmi</persName> 1532 zunächst mit Predigtverbot belegt (s. nächste Anm.), dann am 15. August entlassen. Anschließend wirkte er als zweiter Pfarrer in <placeName ref="l503">Thun</placeName> (<placeName ref="l2826">Kt. Bern</placeName>), seit 1554 war er Dekan. - Lit.: ASchweizerRef, Reg.; Anshelm VI 23; Ludwig Rochus <hi>Schmidlin,</hi> Solothurns Glaubenskampf und Reformation im 16. Jahrhundert, Solothurn 1904, S. 176, Anm. 4; <hi>Haefliger,</hi> passim; Lohner 347.349.351.</note>, quem habebant, a functione suspenderunt<note xml:id="fn14" type="footnote" n="14">«Am 30. April 1532 verbot die Obrigkeit trotz Einspruch der Evangelischen dem Prädikanten öffentlich zu predigen», <hi>Haefliger</hi> 161.</note>.</s>
					<s n="16" xml:lang="la">«Durae cervicis populus est» [Ex 32,9 u. a.].</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z13"/>Hi, qui potiores sunt ab evangelio, muneribus et mensis <placeName ref="l832">Gallorum</placeName> corrumpuntur<note xml:id="fn15" type="footnote" n="15"><placeName ref="l760">Solothurn</placeName> war der traditionelle Sitz der <placeName ref="l832">französischen</placeName> Gesandten (<bibl source="b291">HBLS</bibl> I 308f); ihre Anwesenheit stärkte zwar die katholische Partei, doch versuchten sie auch, auf beide Seiten mäßigend einzuwirken, s. <hi>Haefliger</hi> 57.161.163f.</note>, quo minus audent aut volunt <lb xml:id="p1z14"/>domini verbum promotum.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Postremo, valemus alioqui omnes.</s>
					<s n="19" xml:lang="la">At quid in comitiis <placeName ref="l21">Badensibus</placeName><note xml:id="fn16" type="footnote" n="16">Zur Tagsatzung in <placeName ref="l21">Baden</placeName> vom 10. - ca. 16. Mai 1532 s. <bibl source="b197">EA</bibl> IV/1b 1338-1344; vgl. ASchweizerRef <hi>IV</hi> 1618.</note> agatur <lb xml:id="p1z15"/>aut actum sit, nec verbum percępimus<note xml:id="fn17" type="footnote" n="17">Vgl. oben S. 93,41-43.</note>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="farewell">Tu interea vale et perge, ut cępisti.</s>
					<s n="21" xml:lang="la">Apud nos optime audis, <lb xml:id="p1z16"/>immo et apud tuos.</s>
					<s n="22" xml:lang="la">Dominus te conservet fidelem et irreprehensibilem in ministerio suo.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Fabrum pro dignitate <lb xml:id="p1z17"/>tractasti.</s>
					<s n="24" xml:lang="la">Arridet libellus<note xml:id="fn18" type="footnote" n="18">Siehe oben S. 110, Anm. 9.</note> omnibus lectoribus et in magno<pb type="edition" next="125"/> numero apud nos venditus est.</s>
					<s n="25" xml:lang="la">Commendatur <lb xml:id="p1z18"/>modestia et sermonis commoditas ac gravitas.</s>
					<s n="26" xml:lang="la" ana="farewell">Rursum vale, cor meum alteraque animula<note xml:id="fn19" type="footnote" n="19">Vgl. <bibl source="b473">Otto</bibl> 25, Nr. 111.</note>.</s>
				</p>
				<p>
					<s n="27" xml:lang="de">25. ma<lb xml:id="p1z19"/>ii.</s>
				</p>
				<p>
					<s n="28" xml:lang="la">Tuus <persName ref="p1391">B. Hallerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="29" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Heinrico Bullingero</persName>, <lb xml:id="p2z2"/>fratri suo charissimo.</s>
				</p>
			</div>
