	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Quod disciplina arctiori in officio contineatis iuvenes vestros, perplacet <lb xml:id="p1z2"/>mihi; nam posthac erunt tanto cautiores et humiliores, quamquam <lb xml:id="p1z3"/>certe maior pars ita se gesserit, ut nihil prorsus desiderarim.</s>
					<s n="2" xml:lang="la">Hoc mihi <lb xml:id="p1z4"/>valde displicuit, quod in discessu usi fuere <foreign xml:lang="de">pfeiffen und trommen,</foreign> <lb xml:id="p1z5"/>et ego interdixi eis; at consensu <persName ref="p8386">Hyperii</persName> impetrato non paren<lb xml:id="p1z6"/>dum mihi esse putaverunt.</s>
					<s n="3" xml:lang="la">Egre quoque tulisse illustrissimum princi<lb xml:id="p1z7"/>pem nostrum hinc colligo, quod ex domino <persName ref="p8115">Pinciero</persName> scire cupiverit <lb xml:id="p1z8"/>causas discessus <placeName ref="l862">Helvetiorum</placeName>, <foreign xml:lang="de">und warumb si mit trommen und <lb xml:id="p1z9"/>pfeiffen weren abzogen,</foreign> et credo, si nullos amplius ad nos mittatis, <lb xml:id="p1z10"/>offensionem id aliquam pariturum apud principem, pręsertim cum <lb xml:id="p1z11"/>nunc duplo melius consultum sit professioni theologiae; nam <placeName ref="l832">Gallum</placeName> <lb xml:id="p1z12"/>quendam, insignem virum adiunxit <persName ref="p8386">Hyperio</persName> princeps, qui sane <lb xml:id="p1z13"/>prope m... fructu et laude profitetur, et fuit is <persName>Wilhelmi prin<lb xml:id="p1z14"/>cipis</persName> in lingua <placeName ref="l832">Gallica</placeName> praeceptor et <placeName ref="l832">Gallicus</placeName> concionator <placeName ref="l491">Argenti<lb xml:id="p1z15"/>nae</placeName>, quem tibi poterit describere <persName ref="p8111">Martyr</persName> noster ille, et quoque <lb xml:id="p1z16"/>coepit et meditatur salubrem scholae universae nostrae reformationem <lb xml:id="p1z17"/>princeps noster.</s>
					<s n="4" xml:lang="la">Faxit dominus, ut felicem sortiatur eventum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Intra mensem <lb xml:id="p1z18"/><placeName ref="l311">Marpurgi</placeName> nuptię celebrabuntur <persName ref="p20258">filii</persName> <persName ref="p8060">Palatini</persName> et <persName ref="p21059">filiae</persName> <persName ref="p3590">lantgravii</persName>, <lb xml:id="p1z19"/>ad quas confluent circiter tria milia equitum, <foreign xml:lang="de">und werden ein <lb xml:id="p1z20"/>offentlich tornir halten.</foreign></s>
					<s n="6" xml:lang="la">Faxit dominus, ne quid monstri alatur <lb xml:id="p1z21"/>incommodi.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">His paucis scribendis abstinere non potui propter <lb xml:id="p1z22"/>meum erga te amorem et observantiam.</s>
					<s n="8" xml:lang="la" ana="farewell">Bene vale cum omnibus <lb xml:id="p1z23"/>bonis et doctis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Datum <placeName ref="l157">Francofurti</placeName> 9. aprilis anno 1560.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p1456">Happelius</persName> tuus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l803">Tigurinae</placeName> <lb xml:id="p2z3"/>episcopo longe dignissimo, <lb xml:id="p2z4"/>praeceptori meo <lb xml:id="p2z5"/>colendo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>