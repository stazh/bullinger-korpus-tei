					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="9" xml:lang="la"><lb xml:id="p2z2"/>Pietate ac eruditione <lb xml:id="p2z3"/>eximio viro <persName ref="p495">Henrico Bul<lb xml:id="p2z4"/>lingero</persName>, <placeName ref="l587">Tigurino</placeName> contio<lb xml:id="p2z5"/>natori primario, domino <lb xml:id="p2z6"/>suo colendissimo.</s>
				</p>
