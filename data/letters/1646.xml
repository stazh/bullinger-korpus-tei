	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Eheu triste nuntium adporto: <persName ref="p2270">Monsterus</persName> noster <lb xml:id="p1z2"/>die ascensionis domini hora octava mane in cęlum ascendit reg<lb xml:id="p1z3"/>nans nunc cum Christo Iesu filio a pestilentiali lue interfectus.</s>
					<s n="3" xml:lang="la" ana="farewell"><lb xml:id="p1z4"/>Vale.</s>
					<s n="4" xml:lang="la">Nihil possum addere prę męrore, qui animum meum concutit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Expecto literas tuas avide.</s>
					<s n="6" xml:lang="la">A legato vestrate audietis, <lb xml:id="p1z6"/>que apud regem Gallorum agantur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l361">Norimbergensis</placeName> ager incessus <lb xml:id="p1z7"/>est ab hostibus.</s>
					<s n="8" xml:lang="la">Modicam fidem invenimus in hominibus.</s>
					<s n="9" xml:lang="la"><placeName ref="l28">Basileę</placeName> <lb xml:id="p1z8"/>26. maii 1552.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z10"/>Tuus <persName ref="p1278">Gastius</persName> ex <lb xml:id="p1z11"/>animo.</s>
				</p>
				<p>
					<s n="11" xml:lang="de"><pb/><lb xml:id="p2z1"/>An den wolgelerten herren <lb xml:id="p2z2"/>meyster <persName ref="p495">Heinrich Bullinger</persName>, <lb xml:id="p2z3"/>lutpriester zuͦ <placeName ref="l587">Zurich</placeName>, mynem <lb xml:id="p2z4"/>günstigen herren, zuͦ handen.</s>
					<s n="12" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
