	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Eruditissime vir et domine mi observandissime.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Vidi, quę heri ad me scripsisti<note xml:id="fn1" type="footnote" n="1">Dieser Brief <persName ref="p495">Bullingers</persName> ist nicht erhalten.</note>, et omnia libenter <lb xml:id="p1z3"/>intellexi, quia mihi satisfecisti, ut desiderabam<note xml:id="fn2" type="footnote" n="2"><persName ref="p830">Panizzone</persName> bezieht sich auf seinen Brief an <persName ref="p495">Bullinger</persName> vom 9. September 1544 (oben <ref target="file12026">Nr. 1979</ref>). Darin bat er <persName ref="p495">Bullinger</persName> um Nachrichten bezüglich der Ankunft des <placeName ref="l631">burgundischen</placeName> Gesandten in <placeName ref="l587">Zürich</placeName> und der Friedensverhandlungen zwischen <persName ref="p18538">Kaiser Karl V.</persName> und <persName ref="p20225">König Franz I.</persName></note>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Quare fateor me tibi plurimum debere <lb xml:id="p1z5"/>et ago gratias, ac quicquid possum et habeo, <lb xml:id="p1z6"/>id totum tibi offero.</s>
					<s n="4" xml:lang="la" ana="salute">Tuos salutavi, ut <lb xml:id="p1z7"/>iussisti, qui te pariter resalutant.</s>
					<s n="5" xml:lang="la">Ego vero <lb xml:id="p1z8"/>non ero immemor tuę comendationis erga tuos, <lb xml:id="p1z9"/>ubi eis prodesse potero, ut hactenus <lb xml:id="p1z10"/>feci.</s>
					<s n="6" xml:lang="la">Nihil aliud habeo, quod scribam, nisi <lb xml:id="p1z11"/>quod more solito tuus sum et superi me <lb xml:id="p1z12"/>genuere tuum, cui ac familię toto <lb xml:id="p1z13"/>corde me comendo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l62">Brengartii</placeName>, 12. <lb xml:id="p1z14"/>septembris 1<lb xml:id="p1z15"/>544.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Totus tuus <persName ref="p830">Io. Dominicus<lb type="manual"/> <lb xml:id="p1z17"/>Panizonus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eruditissimo viro ac domino meo observan<lb xml:id="p2z2"/>dissimo d. <persName ref="p495">Henrico Bullingero</persName>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z3"/>Turregi.</s>
				</p>
			</div>
