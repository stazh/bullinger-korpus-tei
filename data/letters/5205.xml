	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. P. D.
					<lb xml:id="p1z2"/>fere per biennium ad perlustranda cognoscendaque illiu
					<lb xml:id="p1z3"/>triora et praestantiora Italiae et mihi a dio parente meo data
					<lb xml:id="p1z4"/>fuerit potestas ac nunc ex iussu ipsius me inGermania
					<lb xml:id="p1z5"/>et ipsius arcem. Aschau sanum et incolumem (deo authore
					<lb xml:id="p1z6"/>contulissem, in qua decimum et quartum nunc ago diem. ecclesia
					<lb xml:id="p1z7"/>venit quidem vester nuncius <placeName ref="l587">Tigurinus</placeName> a domino et praecepsore
					<lb xml:id="p1z8"/>meo colendissimo charissimoque Rodolpho Funkio, isque cum ad
					<lb xml:id="p1z9"/>vos redire vellet, non potui intermittere, quin ineptis incomptisque
					<lb xml:id="p1z10"/>hisce literulis te, vir prae caeteris clarissime et integerrime plurima
					<lb xml:id="p1z11"/>salute impartirer, observantiamque erga te meam studiumque declariue,
					<lb xml:id="p1z12"/>ac insuper ob largiter in me meosque fratres effusa benefici
					<lb xml:id="p1z13"/>tibi gratias agerem immortates, suplexque rogarem, ut eae qua
					<lb xml:id="p1z14"/>praeterito, sic etiam futuro tempore perseverantia erga nos utaris,
					<lb xml:id="p1z15"/>et fautor noster esse velis. Talis est enim naturae tuae integri
					<lb xml:id="p1z16"/>atque bonitas ea rara quidem, sed homine claro et pio dignistime
					<lb xml:id="p1z17"/>facilitas ut virtutem hanc tuam perspectare adnicasi.
					<lb xml:id="p1z18"/>feceris, quod etiam in adversis temporibus ac ad Cristi gloria
					<lb xml:id="p1z19"/>susceptam et finitam titem ita domino parenti meo tuis illi expeca,
					<lb xml:id="p1z20"/>tatissimis consulaloriis literis praesto fueris, quam illi rem grati
					<lb xml:id="p1z21"/>tamfeceris, nec ego scriptis exprimere nec tu credere potes, quoo
					<lb xml:id="p1z22"/>nomine libenter fateor me tibi arctissimo vinculo perpetui benei
					<lb xml:id="p1z23"/>studiique esse devinctum. Cum vero fortuna (ut merito)
					<lb xml:id="p1z24"/>bonorum omni genere locupletissimum effecerit, nihil est, qua au
					<lb xml:id="p1z25"/>ego paestare aut tu a me magnopere desiderare possis, si quid tameni
					<lb xml:id="p1z26"/>totum me tibi offero atque devoveo, ut me pro tuo abutaris meque cum fratri
					<lb xml:id="p1z27"/>commendatos habeas, hasque incongruas aequo animo suscipias
					<lb xml:id="p1z28"/>Datae 5. martii in arce nostra Aschau anno salutisti
					<lb xml:id="p1z29"/>Ts deditissimus.
					<lb xml:id="p1z30"/>Gulietmus a Freibr.
					<pb/>
					<lb xml:id="p2z1"/>Doctissimo clarissimoque viro domino
					<lb xml:id="p2z2"/>Henrico Bullingero  Tigurinae ei
					<lb xml:id="p2z3"/>ecclesiae ministro integerrimo domino
					<lb xml:id="p2z4"/>et fautori suo summa observandisimo
					<lb xml:id="p2z5"/>colendo.
					<lb xml:id="p2z6"/>S.
					<lb xml:id="p2z7"/>.
					<lb xml:id="p2z8"/><placeName ref="l587">Tigurum</placeName>.
				</p>
			</div>
		</body>
