			<zone xml:id="p2z4-0" points="2083,1107 2233,1101 2281,1135 2436,1083 2471,1109 2541,1094 2820,1135 2820,1056 2766,1046 2679,1077 2467,1037 2372,1066 2271,1066 2237,1037 2196,1068 2162,1037 2083,1060">2093,1082 2129,1084 2166,1085 2202,1085 2239,1084 2275,1082 2312,1082 2348,1082 2385,1082 2421,1082 2458,1082 2495,1085 2531,1085 2568,1085 2604,1085 2641,1086 2677,1088 2714,1093 2750,1092 2787,1090 2824,1094</zone>
			<zone xml:id="p2z5-0" points="2498,1191 2563,1196 2628,1160 2646,1179 2677,1160 2740,1172 2740,1119 2721,1126 2679,1109 2665,1119 2628,1111 2614,1118 2537,1094 2498,1116">2508,1145 2534,1148 2560,1151 2586,1151 2612,1150 2639,1148 2665,1148 2691,1148 2717,1150 2744,1151</zone>
			<zone xml:id="p2z6-0" points="2174,1297 2293,1276 2384,1307 2523,1283 2636,1300 2703,1266 2735,1275 2732,1179 2612,1167 2529,1198 2242,1177 2208,1206 2170,1201">2181,1239 2208,1238 2236,1237 2264,1237 2292,1238 2320,1240 2348,1242 2375,1244 2403,1246 2431,1249 2459,1254 2487,1262 2515,1265 2543,1267 2570,1265 2598,1260 2626,1255 2654,1255 2682,1251 2710,1246 2738,1246</zone>
