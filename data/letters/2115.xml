	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Postscripta.</s>
					<s n="2" xml:lang="la">Comitia prorogata sunt ad tres <lb xml:id="p1z2"/>menses.</s>
					<s n="3" xml:lang="la">Putamus omnes Ces[aris] negotium, quod <lb xml:id="p1z4"/>ad <placeName ref="l830">Angliam</placeName> attinet, non succedere illi ex sententia <lb xml:id="p1z5"/>quemadmodum neque in <placeName ref="l834">Italia</placeName>.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Quum huc <lb xml:id="p1z6"/>venissem, princeps dedit, quod scripsi, et nunc <lb xml:id="p1z7"/>mandavit d. <persName>a Ghitilingen</persName>, qui hodie huc venit, <lb xml:id="p1z8"/>ut mecum agat dispiciatque, quibus rebus opus <lb xml:id="p1z9"/>habeam toto anno; quum hoc a me quaesi<lb xml:id="p1z10"/>vit, ego rem totam eius arbitrio reliqui.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Puto cras tractandum, an debeam hic suscipere <lb xml:id="p1z12"/>provintiam profitendi; faciam, quod dominus <lb xml:id="p1z13"/>mihi ostenderit in gloriam eius redundare.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>D. <persName>Iacobus Beurlinus</persName> in <placeName ref="l2562">Prussiam</placeName> ibit brevi; sic <lb xml:id="p1z15"/>nuper statutum.</s>
					<s n="7" xml:lang="la" ana="farewell">Iterum vale, iterum.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Salve, optime frater.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">H[enrico] <lb xml:id="p2z2"/>Bullingero</persName>, domino et <lb xml:id="p2z3"/>fratri honorando.</s>
					<s n="10" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note>[Datum: Verschiebung des Reichstages, Vgl. V. an HB.]</note>
					<s n="11" xml:lang="la">19. <lb xml:id="p2z4"/>Dez. 1553.</s>
				</p>
			</div>
		</body>
	</text>
