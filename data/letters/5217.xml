	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Ad tabernas <placeName ref="l632">Alsaticas</placeName>, sicuti nuper <lb xml:id="p1z4"/>praemonui, convenere <placeName ref="l572">Wirtemb[ergensis]</placeName> dux et 4 Guysiani fratres, <lb xml:id="p1z5"/>dux, prior, cardinalis <placeName ref="l691">Lotharingius</placeName>, cardinalis <persName>Guysanus</persName>.</s>
					<s n="3" xml:lang="la">Adduxit <lb xml:id="p1z6"/>secum <placeName ref="l572">Wirtemb[ergensis]</placeName> <persName ref="p458">Brentium</persName> et <persName>Ioannem Andreae</persName>.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Colloqu[u]ti sunt hi diu cum cardinali Lotharingio, cui <lb xml:id="p1z8"/>commendata est ab illis confessio <placeName ref="l18">Augustana</placeName> et con<lb xml:id="p1z9"/>fessio <placeName ref="l572">Wirtemb[ergensis]</placeName> superioribus annis oblata concilio <lb xml:id="p1z10"/><placeName ref="l1107">Tridentino</placeName> etc.</s>
					<s n="5" xml:lang="la">Quid concluserint, incertum; <lb xml:id="p1z11"/>hoc autem <placeName ref="l491">Argentina</placeName> scribitur <lb xml:id="p1z12"/>ad me <lb xml:id="p1z13"/>unum ex fratribus profectururm, cardinalem opinor <placeName ref="l691">Lotharingium</placeName>, recta in concilium <lb xml:id="p1z14"/><placeName ref="l1107">Tridentinum</placeName> et effecturum, ut inde legatus mittatur <lb xml:id="p1z15"/>ad <placeName ref="l822">Germanos</placeName> principes.</s>
					<s n="6" xml:lang="la">Quid ergo quaeritur <lb xml:id="p1z16"/>nisi intestina discordia inter principes <placeName ref="l822">Germanos</placeName>, <lb xml:id="p1z17"/>aut ut his concedatur sua illa confessio, <lb xml:id="p1z18"/>principes vicissim defendant aut non op<lb xml:id="p1z19"/>primant episcopos etc.?</s>
					<s n="7" xml:lang="la">Additur in literis pateras argen<lb xml:id="p1z20"/>teas graves a card[inale] datas dono utrique; quod <lb xml:id="p1z21"/>si verum est, profecto mirum est ministros <lb xml:id="p1z22"/>Christi accepisse munus ab eo, qui madet ad<lb xml:id="p1z23"/>huc sanguine martyrum Christi.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Sed haec ad <lb xml:id="p1z24"/>te scribo, ut ad me sunt perlata; utcunque res habeat, <lb xml:id="p1z25"/>video nobis maxima pericula imminere <lb xml:id="p1z26"/>et undique nos petendos.</s>
					<s n="9" xml:lang="la">Sed fortior est, qui <lb xml:id="p1z27"/>in nobis quam qui in mundo est.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Vidisti, quae <lb xml:id="p1z28"/>scripserit contra nos <persName ref="p20367">Hesshusius</persName>.</s>
					<s n="11" xml:lang="la">Oro, si statuisti <lb xml:id="p1z29"/>respondere, respondeas ad argumenta diligenter praeterita <lb xml:id="p1z30"/>persona illa <persName>Thersitis</persName> <persName>Homerici</persName>; idem sug<lb xml:id="p1z31"/>gerito et d. <persName ref="p8033">Bezae</persName> nostro.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Ego non minus ve<lb xml:id="p1z32"/>nenata expecto a <persName ref="p458">Brentio</persName>.</s>
					<s n="13" xml:lang="la">Gratificareris <lb xml:id="p1z33"/>mihi, si scriberes tuum mihi iudicium de responsion<lb xml:id="p1z34"/>e mea, quam te accepisse spero.</s>
					<s n="14" xml:lang="la">Remitto <lb xml:id="p1z35"/>d. <persName ref="p8033">Bezae</persName> literas<note type="misc"><persName ref="p8033">Beza</persName> an HB, 2. März [1562</note>], sicut petieras, et oro, ut, quid ab <lb xml:id="p1z36"/>eo tempore factum sit, ad me perscribas; nihil <lb xml:id="p1z37"/>enim prorsus audimus, nisi quod Navarrus ad papam <lb xml:id="p1z38"/>defecerit.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Dominus reducat illum!</s>
					<s n="16" xml:lang="la">Mitto et confessionem <lb xml:id="p1z39"/>ecclesiae <placeName ref="l2472">Polonicae</placeName>, de qua nuper etiam monueram.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z40"/>Literas appositas quaeso cures tradi d. <lb xml:id="p1z41"/><persName ref="p8511">Christophoro Trecio</persName> <placeName ref="l2472">Polono</placeName>, quem tibi commendo, <lb xml:id="p1z42"/>et te optime valere cupio.</s>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 13. martii 15<lb xml:id="p1z43"/>62.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Festinantissime scripsi propter abiturientem <lb xml:id="p1z45"/>tabellionem.</s>
					<s n="20" xml:lang="la" ana="salute">Salutant te fratres.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z46"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p540">Ioanni Calvino</persName>, <lb xml:id="p2z2"/><placeName ref="l167">Genevensis</placeName> ecclesiae <lb xml:id="p2z3"/>ministro fideli, domino <lb xml:id="p2z4"/>et fratri suo colendo et dilecto.</s>
					<s n="23" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l167">Genff</placeName>.</s>
				</p>
			</div>
		</body>
