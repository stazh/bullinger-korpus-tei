	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. Accepi tabulas Bibliandri nostri et tuum de illis
					<lb xml:id="p1z2"/>iudicium valde amplictor. Statum autem confessim
					<lb xml:id="p1z3"/>incipere, nisi forte quia censoribus antea exhibenda
					<lb xml:id="p1z4"/>s dies aliquot adhuc expectandum sit. Interea vero
					<lb xml:id="p1z5"/>de mittenda ad nos etiam praefatione, occasione captabit
					<lb xml:id="p1z6"/>t Theodorus, ad quam rem citius etiam expediendam
					<lb xml:id="p1z7"/>tua quoque nobis ope erit opus, quam ut paratam nobi
					<lb xml:id="p1z8"/>exhibeas, oro, ne in mora id quoque. scis enm
					<lb xml:id="p1z9"/>perbreve esse, quod superest ad nundinas iam instantes
					<lb xml:id="p1z10"/>tempus, et irem hanc interea non parum diligentię
					<lb xml:id="p1z11"/>expetere, ut ante mensas aliquot missas potius
					<lb xml:id="p1z12"/>cuperem. De oratione tua ne dubita, non peribit illa
					<lb xml:id="p1z13"/>et dabo operam, ut vel solam eadem qua superiores
					<lb xml:id="p1z14"/>forma edam potius, si contungi in praesentia, quia sipriores
					<lb xml:id="p1z15"/>nondum sint distractu, minis sit commodum. Dionis
					<lb xml:id="p1z16"/>historiam patria quaque occasione absolutam ad te mitsam.
					<lb xml:id="p1z17"/>spero autem non displicituram. Bene vale et qui
					<lb xml:id="p1z18"/>D. Theodorus statuo librum suum rebuspublicam Tigurinus
					<lb xml:id="p1z19"/>Bernensi, Basiliensis Scaphesaniae, dedicare, quaeso
					<lb xml:id="p1z20"/>autor enim esse velis, ut ea prudentia dedicernt
					<lb xml:id="p1z21"/>suae causam exponat, ne alii Helvetii conquera
					<lb xml:id="p1z22"/>iure possint, aliqua se inde vel contumelia
					<lb xml:id="p1z23"/>vel intura esse affectos. Nosti, quid velim,
					<lb xml:id="p1z24"/>et vides, quod sumus miseri nos typographi
					<lb xml:id="p1z25"/>iam omnium telis expositi. Porum vale. Basileae
					<lb xml:id="p1z26"/>13. februarii 1558.
					<lb xml:id="p1z27"/>Io Oporinus
					<lb xml:id="p1z28"/>ut subito, quum de
					<lb xml:id="p1z29"/>ex animo.
					<lb xml:id="p1z30"/>itra divido hora
					<lb xml:id="p1z31"/>admonitus.
					<pb/>
					<lb xml:id="p2z1"/>Optimo atque doctissimo
					<lb xml:id="p2z2"/>viro d. Henrico
					<lb xml:id="p2z3"/>Bullingero, Tigurinae
					<lb xml:id="p2z4"/>Tae ecclesię patri
					<lb xml:id="p2z5"/>fudelissimo, domino
					<lb xml:id="p2z6"/>et amico suo in
					<lb xml:id="p2z7"/>primis colando.
					<lb xml:id="p2z8"/><placeName ref="l587">Tiguri</placeName>.
				</p>
			</div>
