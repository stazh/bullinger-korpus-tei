	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Si quid novi a me velis, quod ad bellum attinet, poteris <lb xml:id="p1z2"/>ex literis, quas ad dominos tuos scribo, <lb xml:id="p1z3"/>cognoscere; illic enim vere, tam que ex <lb xml:id="p1z4"/><placeName ref="l2589">Picardia</placeName>, <placeName ref="l736">Pedemontio</placeName> quam que ex <placeName ref="l834">Italia</placeName> et <lb xml:id="p1z5"/>aliis locis veniunt, comprehendo.</s>
					<s n="3" xml:lang="la">Cupio et te o<lb xml:id="p1z6"/>ro, ut copiam ad dominum <persName ref="p3375">Vergerium</persName> mittas.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Eius literas accepi a tempore, quo ex <placeName ref="l822">Germania</placeName> <lb xml:id="p1z8"/>rediit, et cum literis libellum, quem mihi <lb xml:id="p1z9"/>dedicavit, qui egregie et docte est scriptus, <lb xml:id="p1z10"/>et vix credo secundum in <placeName ref="l834">Italia</placeName> <lb xml:id="p1z11"/>e<lb xml:id="p1z12"/>sse, qui purius et cum maiori vi et energia <lb xml:id="p1z13"/>scribat Italice.</s>
					<s n="5" xml:lang="la">Ei respondeo; curabis, s<lb xml:id="p1z14"/>i placet, <lb xml:id="p1z15"/>meas red[d]i.</s>
					<s n="6" xml:lang="la">Quod pra<lb xml:id="p1z16"/>eterea <lb xml:id="p1z17"/>hic inclusum est, scias certum, poteris <lb xml:id="p1z18"/>ad eum mittere; sed rogo, ne autorem <lb xml:id="p1z19"/>nominetis.</s>
					<s n="7" xml:lang="la">Expectas de <placeName ref="l830">Anglis</placeName> aliquid; <lb xml:id="p1z20"/>video enim per tuas ultimas te illic a multis <lb xml:id="p1z21"/>observatum.</s>
					<s n="8" xml:lang="la">Omnia infeliciter; illa prima regina es<lb xml:id="p1z22"/>t per Caesarianos reiecta, et tam <lb xml:id="p1z24"/>imprudens vel parum audax fuit ille <lb xml:id="p1z25"/><placeName ref="l2590">Nort[h]umberland</placeName>, ut eis vix ausus sit, cum <lb xml:id="p1z26"/>potuisset, resistere; sic <persName ref="p18554">Maria</persName> Caesariana <lb xml:id="p1z27"/>et pap[istica] est regina declarata.</s>
					<s n="9" xml:lang="la">Scis, quomodo <pb/><lb xml:id="p2z1"/>vestros oderit, quam unice contraria observet.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z2"/>Illa sunt nimium certa et iam sibi <lb xml:id="p2z3"/>ex consilio <persName ref="p18538">Cesaris</persName> querit maritum sibi <lb xml:id="p2z4"/>similem; sic sperantur magno mutationes <lb xml:id="p2z5"/>in aecclesia.</s>
					<s n="11" xml:lang="la">Hec est ars Caesaris, qua <lb xml:id="p2z6"/>nullo modo potest uti nisi per <lb xml:id="p2z7"/>divisiones, quas in ecclesiis fovet.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z8"/>Sic ei moriens <persName ref="p7706">Granvellanus</persName> praedixit <lb xml:id="p2z9"/>futurum maximum Caesarem et ea <lb xml:id="p2z10"/>ratione <placeName ref="l822">Germaniam</placeName> et <lb xml:id="p2z11"/><placeName ref="l862">Helvetios</placeName> perdi <lb xml:id="p2z12"/>posse.</s>
					<s n="13" xml:lang="la">Deus prohibuit et prohibebit; <lb xml:id="p2z13"/>sed eadem conatur in <placeName ref="l830">Anglia</placeName>, <lb xml:id="p2z14"/>ubi in summa omnino res male <lb xml:id="p2z15"/>sunt.</s>
					<s n="14" xml:lang="la">Cupio etiam, ut de <lb xml:id="p2z16"/>aliquid d. <persName ref="p3375">Ver[gerio]</persName> dicas; nam per <lb xml:id="p2z17"/>otium non iam vaccat pluribus ad <lb xml:id="p2z18"/>eum, et omnia ad te remitto.</s>
					<s n="15" xml:lang="la">Expectavi <lb xml:id="p2z19"/>nova de prelio.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Dominus exercituum det <lb xml:id="p2z20"/>victoriam, ex qua certe multa pendunt, <pb/><lb xml:id="p3z1"/>et respici[a]t eos, qui etiam nobiscum non <lb xml:id="p3z2"/>stant.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Saluto dominos tuos et te <lb xml:id="p3z3"/>unice.</s>
					<s n="18" xml:lang="la" ana="farewell">Vale optime, et si quid de <lb xml:id="p3z4"/><placeName ref="l361">Nurembergensibus</placeName> habeas et aliis <lb xml:id="p3z5"/><placeName ref="l822">Germanicis</placeName>, scribe, queso.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="farewell"><lb xml:id="p3z6"/>Vale iterum, vir bone.</s>
					<s n="20" xml:lang="la">Datum ex <placeName ref="l760">Soluturo</placeName> <lb xml:id="p3z7"/>hoc die Veneris.</s>
					<s n="21" xml:lang="la"><lb xml:id="p3z8"/>Tuus sem<lb xml:id="p3z9"/>per <persName ref="p8296">B[<lb xml:id="p3z10"/>assafontan<lb xml:id="p3z11"/>eus]</persName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p4z1"/>Domino <persName ref="p495">Bulingero</persName>, viro <lb xml:id="p4z2"/>optimo.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p4z3"/><placeName ref="l587">Tiguri</placeName>.</s>
