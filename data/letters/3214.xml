	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z3"/>S.</s>
					<s n="2" xml:lang="la">Dum praeterito <lb xml:id="p1z4"/>mense maio apud nos <placeName ref="l587">Tiguri</placeName> esset <lb xml:id="p1z5"/>d. <persName ref="p3375">Vergerius</persName>, praesentibus d. <persName ref="p8011">Rod. Gualthero</persName> et d. <persName ref="p8101">Laelio</persName>, fratribus <lb xml:id="p1z6"/>in domino colendissimis et charissimis, literas illustrissimi principis <placeName ref="l572">Wirtembergensis</placeName> <lb xml:id="p1z7"/>protulit, quibus amplissimum <placeName ref="l28">Basiliensem</placeName> senatum admoneri dixit, ne <lb xml:id="p1z8"/>citra delectum quosvis libros etiam improbanda continentes typis ex<lb xml:id="p1z9"/>cudi pateretur.</s>
					<s n="3" xml:lang="la">Occasionem principi dedisse libellum illum de a<lb xml:id="p1z10"/>mplitudine regni dei beati scriptum, quem ego probem tantopere.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z11"/>Id quod excepi: "Quid dicis, <persName ref="p3375">Vergeri</persName>?</s>
					<s n="5" xml:lang="la">probem tantopere?</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>cum non nescias scriptis ad d. <persName ref="p714">Caelium</persName> literis editionem eius <lb xml:id="p1z13"/>libri modis dissuasisse omnibus."</s>
					<s n="7" xml:lang="la">Respondit: "Scio, <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z14"/>nec illud ignoro et <persName ref="p8111">Martyrem</persName> <placeName ref="l491">Argentinae</placeName> librum istum non <lb xml:id="p1z15"/>probavisse per omnia.</s>
					<s n="8" xml:lang="la">Illud vero illustrissimum principem offendit <lb xml:id="p1z16"/>gravissime, quod in ipso dicit etiam sine Christo salvari <lb xml:id="p1z17"/>posse homines."</s>
					<s n="9" xml:lang="la">Ego vero: "In scripto exemplari," aiebam, "id <lb xml:id="p1z18"/>non vidi aut observavi; impressum vero mihi ab ipso <lb xml:id="p1z19"/>donatum authore non legi.</s>
					<s n="10" xml:lang="la" ana="salute">Absque Christo autem quemcumque servar<lb xml:id="p1z20"/>i non credo, cum sciam in hoc uno esse salutem totius <lb xml:id="p1z21"/>mundi; proinde huiusmodi doctrinam abominor."</s>
					<s n="11" xml:lang="la">"Quid ergo dices," <lb xml:id="p1z22"/>subiiciebat, "si quis scribat miracula Christi facta esse arte <lb xml:id="p1z23"/>magica?"</s>
					<s n="12" xml:lang="la">Excepi: "Dicam impium esse scriptum."</s>
					<s n="13" xml:lang="la">At tale quid <lb xml:id="p1z24"/><placeName ref="l28">Basileę</placeName> impressum esse aiebat <persName ref="p3375">Vergerius</persName>.</s>
					<s n="14" xml:lang="la">Ego vero nihil <lb xml:id="p1z25"/>tale vel videram vel audiveram antea ac subiiciebam: "<lb xml:id="p1z26"/>Mallem ego huiusmodi libros nullibi in mundo imprimi, cum mun<lb xml:id="p1z27"/>d<lb xml:id="p1z28"/>us alioqui depravatissimus res divinas in dubium <lb xml:id="p1z29"/>vocet ac fere irrideat.</s>
					<s n="15" xml:lang="la">Hic addebat <persName ref="p8011">Gualtherus</persName> <lb xml:id="p1z30"/>meus etiam se malle nonnisi optima excudi et ideo <lb xml:id="p1z31"/>zelum laudare illustrissimi principis, qui huius rei rationem <lb xml:id="p1z32"/>aliquam habeat.</s>
					<s n="16" xml:lang="la">Haec omnia audivit d. <persName ref="p8101">Lelius</persName>, testis oculatus <lb xml:id="p1z33"/>et auritus, et haec ipsa sunt, quae in causa inter d. <persName ref="p3375">Vergerium</persName> <lb xml:id="p1z34"/>et nos transacta, de qua tu certior reddi cupiebas, <lb xml:id="p1z35"/>bona fide exposui.</s>
					<s n="17" xml:lang="la">Si quid tu, d. <persName ref="p714">Cęli</persName>, accusationis <lb xml:id="p1z36"/>vel excusationis instituisti, cave, ne causae me implices.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z37"/>Odi lites et concertationes huiusmodi ex animo, neque <lb xml:id="p1z38"/>hac scribo, ut tibi arma ac materiam suppeditem, <lb xml:id="p1z39"/>sed ut revera, quid inter nos dictum ac factum sit, non <lb xml:id="p1z40"/>ignores aut aliud suspiceris.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Vide, ne male gratus <lb xml:id="p1z41"/>hisce meis abutare literis; nolo enim ullo modo vel <lb xml:id="p1z42"/>meas literas vel me ipsum hisce misceri concertationibus.</s>
					<s n="20" xml:lang="la" ana="farewell"><lb xml:id="p1z43"/>Vale.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 16. iulii anno 1557.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z44"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="salute"><lb xml:id="p1z45"/>Salutabis ex me, ex <persName ref="p8051">uxore</persName> mea <lb xml:id="p1z46"/>honestissimam tuam <persName ref="p4597">uxorem</persName> et charissimos liberos.</s>
				</p>
				<p>
					<note type="address">[Adresse... fehlt:]</note>
				</p>
