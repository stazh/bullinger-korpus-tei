	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Recepi tuas, frater colende, ac <lb xml:id="p1z2"/>intellexi, quid postules.</s>
					<s n="3" xml:lang="la">Promptus sum <lb xml:id="p1z3"/>sane iuvandi te et filium; hoc enim <lb xml:id="p1z4"/>merentur tua in me benevolentia et filii <lb xml:id="p1z5"/>virtus.</s>
					<s n="4" xml:lang="la">Testimonia ille ex <placeName ref="l830">Anglia</placeName> secum <lb xml:id="p1z6"/>attulit plane optima; at qua ratione filio <lb xml:id="p1z7"/>subveniri possit et tui sumptus alioqui <lb xml:id="p1z8"/>grandes minui, non facile dixero.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Utinam tibi aliquando commodum esset venire <lb xml:id="p1z10"/>ad nos et forte nunc <persName ref="p18538">Caroli</persName> celebritate <lb xml:id="p1z11"/>adesse nobis; colloqueremur ea de re <lb xml:id="p1z12"/>familiarius.</s>
					<s n="6" xml:lang="la">Nec est, quod alium quaeras <lb xml:id="p1z13"/>hospitem quam me; cum enim <lb xml:id="p1z14"/>socer migravit ad dominum et affinis <lb xml:id="p1z15"/>sedem mutaverit, non video apud <lb xml:id="p1z16"/>quem hospiteris commodius quam apud me <lb xml:id="p1z17"/>tui studiosissimum et amantissimum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Vive e<lb xml:id="p1z18"/>t vale felix cum tota familia.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z19"/>Festinantissime <placeName ref="l587">Tiguri</placeName> 22. ianuarii <lb xml:id="p1z20"/>anno 1552.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z22"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem frommen, wolgelerten <lb xml:id="p2z2"/>und getruwen h. <persName ref="p3067">Hansen <lb xml:id="p2z3"/>Stumppffen</persName>, pfarreren zuͦ <lb xml:id="p2z4"/><placeName ref="l2483">Stammen</placeName>, sinem günstigen <lb xml:id="p2z5"/>lieben herren und <lb xml:id="p2z6"/>bruͦder.</s>
				</p>
			</div>
		</body>
	</text>
