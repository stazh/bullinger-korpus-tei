	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Sal[us] in Christo, clarissime d. <persName ref="p495">Bullingere</persName> ac <lb xml:id="p1z2"/>frater in Christo charissime.</s>
					<s n="2" xml:lang="la">Quod praeter communes <lb xml:id="p1z3"/>illas literas privatim etiam ad me scripsisti, gratias <lb xml:id="p1z4"/>ago; sed non est, cur tu mihi gratias ageres <lb xml:id="p1z5"/>tam diligenter, quo saepius idque non illibenter, <lb xml:id="p1z6"/>honorificam tui mentionem faciam.</s>
					<s n="3" xml:lang="la">Facio enim <lb xml:id="p1z7"/>hoc merito tuo, quum non sim nescius, quantum <lb xml:id="p1z8"/>et ministerio et scriptis ecclesiae profueris et <lb xml:id="p1z9"/>adhuc prodesse non desinis.</s>
					<s n="4" xml:lang="la">Hoc etiam privatim <lb xml:id="p1z10"/>tibi debeo, quod ante annos plus minus viginti lectione <lb xml:id="p1z11"/>libri tui De origine erroris primum excitatus sum <lb xml:id="p1z12"/>ad veram de coena domini sententiam amplectendam, <lb xml:id="p1z13"/>quum antea <persName ref="p1974">Luthero</persName> fuissem addictus; aequum <lb xml:id="p1z14"/>est igitur, ut illum colam, per quem profeci.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Haec volui paucis ad literas tuas respondere, quae <lb xml:id="p1z16"/>mihi erant gratissimae.</s>
					<s n="6" xml:lang="la">In <placeName ref="l2524">Scotia</placeName> ecclesiae <lb xml:id="p1z17"/>aliquanto meliore in conditione sunt, quam quum proxim<lb xml:id="p1z18"/>e ad te scribebam; sed ipsa <placeName ref="l2524">Scotiae</placeName> regina <lb xml:id="p1z19"/>non mutat sententiam.</s>
					<s n="7" xml:lang="la">Decembri elapso <lb xml:id="p1z20"/>baptizatus fuit filius illius primogenitus more <lb xml:id="p1z21"/>papistico per quendam mitratum pseudoepiscopum.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z22"/>Sed ex universa illius regni nobilitate <lb xml:id="p1z23"/>tantum duo reperti sunt, qui baptismo interesse dignati <lb xml:id="p1z24"/>sunt; ceteri euntem et redeuntem infantem tantum <lb xml:id="p1z25"/>ad valvas usque sacelli comitati sunt.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z26"/>Quid in <placeName ref="l2529">Brabantia</placeName> et <placeName ref="l640">Flandria</placeName> geratur, scio vos <lb xml:id="p1z27"/>non ignorare; spero illis coeleste auxilium non <lb xml:id="p1z28"/>defuturum, postquam magna ex parte humanis praesidiis <lb xml:id="p1z29"/>destituti videantur, praesertim si <persName ref="p18575">Hispaniarum <lb xml:id="p1z30"/>rex</persName> cum exercitu, (quod timemus,) ad illos <pb/><lb xml:id="p2z1"/>opprimendos veniat.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z2"/>Oro, <lb xml:id="p2z3"/>ut dnum.</s>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p2z4"/><persName ref="p8011">Gvalterum</persName> et caeteros tuos collegas meo nomine <lb xml:id="p2z5"/>salutes.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z6"/>Dominus vos conservet!</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l296">Londini</placeName> <lb xml:id="p2z7"/>8. februarii <lb xml:id="p2z8"/>1567.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z9"/>Deditissimus tibi in domino <lb xml:id="p2z10"/><persName ref="p1341">Edmundus Grindallus</persName>, <lb xml:id="p2z11"/>episcopus <placeName ref="l296">London</placeName><lb xml:id="p2z13"/>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p4z1"/>Reverendo in Christo <lb xml:id="p4z2"/>d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p4z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae ministro <lb xml:id="p4z4"/>fidelissimo ac fratri in <lb xml:id="p4z5"/>domino charissimo.</s>
					<s n="16" xml:lang="la"><lb xml:id="p4z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
