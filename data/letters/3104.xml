	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Speraveram fore, ut per hunc nuncium c<lb xml:id="p1z2"/>erti aliquid tibi de impressione Commentariorum <lb xml:id="p1z3"/>tuorum in Apocalypsim significarem.</s>
					<s n="3" xml:lang="la">Sed ne nunc <lb xml:id="p1z4"/>quidem possum, quod mihi valde dolet, et <lb xml:id="p1z5"/>magis scio me hac mora discruciari quam te.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>20. huius mensis convenere scholarchae; placuit <lb xml:id="p1z7"/>omnibus communiter, ut imprimerentur.</s>
					<s n="5" xml:lang="la">Pauci tantum <lb xml:id="p1z8"/>ex iis, qui nonnisi Germanicam praefationem intelligere <lb xml:id="p1z9"/>potuerunt, timere nescio quid.</s>
					<s n="6" xml:lang="la">Res postridie <lb xml:id="p1z10"/>ad senatum delata.</s>
					<s n="7" xml:lang="la">Senatus quoniam parum <lb xml:id="p1z11"/>frequens venisset, in maiorem conventum distulit <lb xml:id="p1z12"/>hanc consultationem.</s>
					<s n="8" xml:lang="la">Itaque haeremus iterum.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>Libenter tibi remitterem omnia; adeo indigne fero <lb xml:id="p1z14"/>praeter morem hactenus usurpatum tanta diffi<lb xml:id="p1z15"/>cultate rem tantillam agitari.</s>
					<s n="10" xml:lang="la">Urgeo, ut, si <lb xml:id="p1z16"/>non imprimere velint, edicant saltem.</s>
					<s n="11" xml:lang="la">Sed sic <lb xml:id="p1z17"/>omnia fere hic aguntur, et me hoc tantummodo enecat.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z18"/>Die lunę proxima spero iterum proponendum <lb xml:id="p1z20"/>fore senatui; tum certum habebimus responsum.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/>Remitto tibi, quae proxime miseras.</s>
					<s n="14" xml:lang="la">Sunt, qui exi<lb xml:id="p1z22"/>stiment supprimenda talia scripta, non vulgand[a], <lb xml:id="p1z23"/>ne qui nostratium quoque tales exactiones addisca[nt].</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z24"/>Victoria, quam alterum scriptum praedicat, n[ihil] <lb xml:id="p1z25"/>est quam incentivum <placeName ref="l2510">Turcici</placeName> furoris.</s>
					<s n="16" xml:lang="la">N[ovi] <lb xml:id="p1z26"/>nihil habemus, nisi quod <persName ref="p18113">Mecardus</persName> ex <placeName ref="l18">A[ugusta]</placeName> <lb xml:id="p1z27"/>scribit 9. ianuarii obiisse marchionem <persName>Alb[ertum]</persName> <lb xml:id="p1z28"/><placeName ref="l1048">Brandenburgensem</placeName>, cuius fata valde dole/dolent multi?, <lb xml:id="p1z29"/>episcopi Franconię et Norinbergenses scilicet.</s>
					<s n="17" xml:lang="la">Quis d. <lb xml:id="p1z30"/><persName ref="p1888">Lavatero</persName> successerit, adhuc ignoro.</s>
					<s n="18" xml:lang="la">Utinam <lb xml:id="p1z31"/>pius aliquis et cordatus!</s>
					<s n="19" xml:lang="la" ana="salute">Nostri te omnes <lb xml:id="p1z32"/>salutant, et valde gaudeo concordia et <lb xml:id="p1z33"/>paria omnia fuisse de tuo scripto iudicia.</s>
					<s n="20" xml:lang="la" ana="salute"><lb xml:id="p1z34"/>Salutat te mater et uxor.</s>
					<s n="21" xml:lang="la" ana="salute">Salvos quoque cupimus <lb xml:id="p1z35"/>tuam familiam omnem.</s>
					<s n="22" xml:lang="la" ana="salute">Fratri nunc nihil scribo; <lb xml:id="p1z36"/>salutabis eum meo nomine.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><placeName ref="l41">Bernę</placeName> 22. ianuarii 1557.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z37"/><persName ref="p8018">I[ohanne<lb xml:id="p1z38"/>s] H[allerus</persName>] tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino suo colendissimo et <lb xml:id="p2z5"/>compatri charissimo.</s>
					<s n="26" xml:lang="de"><lb xml:id="p2z6"/>M. <persName ref="p495">Heinrych Bul<lb xml:id="p2z7"/>lingern</persName>.</s>
				</p>
				<p>
					<note>[Von <persName ref="p495">Bullingers</persName> Hand ist zwischen der lateinischen und deutschen Adresse bemerkt:]</note>
					<s n="27" xml:lang="la"><lb xml:id="p2z8"/>22. ianuari<lb xml:id="p2z9"/>i 1557.</s>
				</p>
