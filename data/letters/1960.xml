	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia Christi tecum.</s>
					<s n="2" xml:lang="la"><persName ref="p7073">Hospinianus</persName> noster ex <placeName ref="l587">Tiguro</placeName> <lb xml:id="p1z2"/>rediens significavit mihi tuam sospitatem bonamque <lb xml:id="p1z3"/>valetudinem, quam, oro, benignus deus diutissime <lb xml:id="p1z4"/>ad sui nominis ecclesiarumque omnium, quas tuis vigiliis <lb xml:id="p1z5"/>illustras, emolumentum perpetuo servet.</s>
					<s n="3" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Mirabilis certo rumor apud nos dissipatur de tot <lb xml:id="p1z7"/>ac variis principum mortibus, nec tamen cessat fu<lb xml:id="p1z8"/>riosus ille Mars superstites et armare et extimulare <lb xml:id="p1z9"/>ad maiores Germanię calamitates.</s>
					<s n="5" xml:lang="la">Veredarii ac <lb xml:id="p1z10"/>nuntii principum et urbium c rrentes sursum et deorsum <lb xml:id="p1z11"/>legationes celerrime perferunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><placeName ref="l491">Argentinenses</placeName> conscriptum <lb xml:id="p1z12"/>habent militem, qui ad tubam classicam stabunt in <lb xml:id="p1z13"/>procinctu.</s>
					<s n="7" xml:lang="la">Proceres <placeName ref="l496">Stuckgardiani</placeName>, quos regentes vocant, <lb xml:id="p1z14"/>iam biduo cum nostro agunt principe in penetrali<lb xml:id="p1z15"/>bus, nec est aliquis, qui vel tantillulum rerum vel a <lb xml:id="p1z16"/>longe olfacere vel divinare possit.</s>
					<s n="8" xml:lang="la">Oramus omnes: <lb xml:id="p1z17"/>Da pacem domine, et domine dissipa consilia principum <lb xml:id="p1z18"/>et reprobo cogitationes populorum, qui contra te et <lb xml:id="p1z19"/>ecclesiam tuam conveniunt.</s>
					<s n="9" xml:lang="la">Amen.</s>
					<s n="10" xml:lang="la">Osiandriana si legeris, <lb xml:id="p1z20"/>per certos remitte nuntios, ne intercipiantur.</s>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p1z21"/>Hisce vale et saluta in primis familiam tuam, <lb xml:id="p1z22"/>meum <persName ref="p8127">Pellicanum</persName>, d. <persName ref="p8011">Gvaltherum</persName> et <persName ref="p8171">Bibliandrum</persName> am<lb xml:id="p1z23"/>bosque generos cum omnibus fratribus.</s>
					<s n="12" xml:lang="la">Orate dominum pro nobis.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z24"/><placeName ref="l411">Richenvillę</placeName> 17. augusti 1553.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z25"/>T[uus] <lb xml:id="p1z26"/><persName ref="p1010">Erbius</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio pietate et eruditi<lb xml:id="p2z2"/>one viro d. <persName ref="p495">Henrycho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z4"/>ecclesię antistiti, fratri <lb xml:id="p2z5"/>observando.</s>
				</p>
			</div>
		</body>
	</text>
