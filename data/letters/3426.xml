	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia filii dei tecum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Princeps noster die quinta <lb xml:id="p1z2"/>decembris (postquam nobiscum hic quindecim <lb xml:id="p1z3"/>fere diebus egerat adornaretque iter <placeName ref="l327">Montbelgardiam</placeName>) <lb xml:id="p1z4"/>hasce commisit tibi per nuntium fortuitu se offerentem <lb xml:id="p1z5"/>reddendas.</s>
					<s n="3" xml:lang="la">Eas ad <persName ref="p8384">Hospinianum</persName> nostrum, qui nunc <lb xml:id="p1z6"/>agit <placeName ref="l28">Basileę</placeName> et quem scio tui nominis studiosum, <lb xml:id="p1z7"/>transmisi.</s>
					<s n="4" xml:lang="la">De colloquio nil certi audimus, vos <lb xml:id="p1z8"/>forte veriora quam nos; Adversarii nostros ridentes <lb xml:id="p1z9"/>vocant vaniloquium.</s>
					<s n="5" xml:lang="la"><persName>Philippus</persName> fuit aliquam<lb xml:id="p1z10"/>du <placeName ref="l210">Heidelbergę</placeName> ab electore et eius academię <lb xml:id="p1z11"/>studiosis honorifice exceptus illicque triste accepit <lb xml:id="p1z12"/>nuntium uxorem, quacum multis annis suaviter <lb xml:id="p1z13"/>vixit, obiisse diem.</s>
					<s n="6" xml:lang="la">Rediit <placeName ref="l558">Wittenbergam</placeName> <lb xml:id="p1z14"/>electoris et forti et magno conductu.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Aiunt <lb xml:id="p1z15"/>nova instituta esse comitia apud <placeName ref="l513">Ulmenses</placeName>, quo <lb xml:id="p1z16"/><persName ref="p18477">Ferdinandus</persName> cum electoribus venturus est.</s>
					<s n="8" xml:lang="la">Eo <lb xml:id="p1z17"/>etiamnum <persName>Caesar</persName> mittet legatos, qui insignia <lb xml:id="p1z18"/>imperii, sceptrum et coronam resignent.</s>
					<s n="9" xml:lang="la">Quod certe seminarium <lb xml:id="p1z19"/>et occasio erit, nisi deus id sua solita <lb xml:id="p1z20"/>clementia averterit, multorum malorum inter dissidentes <lb xml:id="p1z21"/>episcopos ac principes.</s>
					<s n="10" xml:lang="la">Propicii numinis <lb xml:id="p1z22"/>sempiterna benignitas iugiter deprecanda est, ut <lb xml:id="p1z23"/>ecclesiam suam, quam sanctificavit, conservet, hoc <lb xml:id="p1z24"/>quod facturus est, modo poenitentes ac patientes <lb xml:id="p1z25"/>fuerimus.</s>
					<s n="11" xml:lang="la" ana="salute">Hisce vale optime <persName ref="p495">Henriche</persName>, cum <lb xml:id="p1z26"/>familia ac symmistis, quos omnes nominatim salutabis.</s>
					<s n="12" xml:lang="de"><lb xml:id="p1z27"/><placeName ref="l411">Richenvillę</placeName> 6. decembris 1557.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z29"/>Tui studiosissimus <lb xml:id="p1z32"/><persName ref="p1010">Erbius</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro ac theologo <lb xml:id="p2z2"/>d. <persName ref="p495">Henrycho Bullingero</persName>, <lb xml:id="p2z3"/>antistiti ecclesię <placeName ref="l587">Tigurinę</placeName>, <lb xml:id="p2z4"/>suo domino ac fratri <lb xml:id="p2z5"/>in Christo charissimo.</s>
					<s n="15" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zürch</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
