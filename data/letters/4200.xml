	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Londen 18. decembris
					<lb xml:id="p1z2"/>Habemus doctrinam satis puram dei benignitate eandem
					<lb xml:id="p1z3"/>quam tempore Ednardi 6. Crannerus Rydleus, Martyr
					<lb xml:id="p1z4"/>apud nos deposuerunt.
					<lb xml:id="p1z5"/>Instituta est totius regni visitatio inspectio omnium ecclesia
					<lb xml:id="p1z6"/>a qua nondum Sandus Iuellus caeteri
					<lb xml:id="p1z7"/>dierunt. Dirmuntur arae conburuntur idolo. Sed ministro
					<lb xml:id="p1z8"/>est inopia fidorum et peritorum. Vix vi
					<lb xml:id="p1z9"/>cesinae dare possumus pastorem
					<lb xml:id="p1z10"/>Episcopus hodie in Anglia nullus est. papistici omne
					<lb xml:id="p1z11"/>sunt depositi. designati nostrum aliqui, sed nondum
					<lb xml:id="p1z12"/>administratio. Dabitur sequentibus diebus
					<lb xml:id="p1z13"/>Secretarius reginae dixit (Cecillus) te   vere
					<lb xml:id="p1z14"/>vocandum in Angliam; Veni nam tuam opus opera
					<lb xml:id="p1z15"/>nuptiis nihil certi. Proci sunt
					<lb xml:id="p1z16"/>De reginae sr
					<lb xml:id="p1z17"/>Sueciae regis filius secunus, qui fratri suo Erico ambit
					<lb xml:id="p1z18"/>Discessit hinc Ferdinanis legatus, qui pro Carolo R egi
					<lb xml:id="p1z19"/>optimi quique sibi metuunt ab Austriaca domo.
					<lb xml:id="p1z20"/>adhuc imptura Anglo. Sunt, qui existiment
					<lb xml:id="p1z21"/>mansura in virginitate
					<lb xml:id="p1z22"/>sunt motus. utraque pars est in
					<lb xml:id="p1z23"/>In Scotia mai
					<lb xml:id="p1z24"/>Nobilitatem et incolarum multo maxima pars
					<lb xml:id="p1z25"/>evangelio favet; sed regina habet Gallos praesidia
					<lb xml:id="p1z26"/>et nova auxilia a Gallis expectat.
					<lb xml:id="p1z27"/>d. Bullingerum diligenter salutare digneris ne
					<lb xml:id="p1z28"/>momine. Blaurerum, quem mihi commendavit, qua poter,
					<lb xml:id="p1z29"/>humaniter tractabo.
					<lb xml:id="p1z30"/>Parcurstus in integrum est restitutus. Galli ad
					<lb xml:id="p1z31"/>necti aliquot novibus ingredi voluerunt Sco
					<lb xml:id="p1z32"/>sed tempestas oborta subversit aliquot ma
					<lb xml:id="p1z33"/>aliquot reiecit in Flandriam
					<lb xml:id="p1z34"/>Salve optimus Ambrosi, charissime frater. Non fuit mihi ocium
					<lb xml:id="p1z35"/>scribendi. Boni haec contule et hanc chartam remitte
					<lb xml:id="p1z36"/>tuas accepi. Saluta fratrem, cum consule et haec illi
					<lb xml:id="p1z37"/>Cansignavi haec ex literis d. Grin
					<lb xml:id="p1z38"/>ex literis d. Ioanne Abeli. Brevi plura. u
					<lb xml:id="p1z39"/><placeName ref="l587">Tiguri</placeName> 26. ianuarii 6.
					<lb xml:id="p1z40"/>tuis omnibus.
					<lb xml:id="p1z41"/>D. Festinantissime
					<lb xml:id="p1z42"/>Bullingerus tuus.
					<pb/>
					<lb xml:id="p2z1"/>d. Ambrohios
					<lb xml:id="p2z2"/>domino meo co
					<lb xml:id="p2z3"/>charissimo.
					<lb xml:id="p2z4"/>.
					<lb xml:id="p2z5"/>herd ne
				</p>
