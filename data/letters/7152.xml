	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Salutam in Christo.
					<lb xml:id="p1z2"/>Clarissime vir legi litteras tuas ad nostrum
					<lb xml:id="p1z3"/>cirlerum scriptas, quod ad filium tuum
					<lb xml:id="p1z4"/>attinet, accepit ab illustissimo pincipe
					<lb xml:id="p1z5"/>cementissimum respontum ipse videlicet
					<lb xml:id="p1z6"/>conditionem apud suam celtitudinem,
					<lb xml:id="p1z7"/>si apud Lantgravis locus non sit, minime
					<lb xml:id="p1z8"/>defuturum. Pacificatio incer Sabaudum
					<lb xml:id="p1z9"/>et Bernates, an constans et utilis ripi
					<lb xml:id="p1z10"/>christianae maxime vero vobis et pane
					<lb xml:id="p1z11"/>vestfutura sit, iguero, metuendum
					<lb xml:id="p1z12"/>profecto et ne hoc tentpore sabaudus alia
					<lb xml:id="p1z13"/>p. Mirabilia sunt hostium Christi
					<lb xml:id="p1z14"/>consilia, quae ut spero aliquando dissipatu
					<lb xml:id="p1z15"/>dominus. Is tegandę est ut afflictissimu
					<lb xml:id="p1z16"/>nunc Bulgis opem salutiferam ferat.
					<lb xml:id="p1z17"/>posposum, quod iginistri reprarum eulesia
					<lb xml:id="p1z18"/>langgianio Wilhelmo dederunt
					<lb xml:id="p1z19"/>nobs summoper placuit. Spero insestem
					<lb xml:id="p1z20"/>Wirtembergicos modestiores futuros. Vide
					<lb xml:id="p1z21"/>nopimus primepe landera, quamod adversam
					<lb xml:id="p1z22"/>septe istic vostrorum hominum dissansionibus
					<lb xml:id="p1z23"/>armentad exhipandam evangelii doctrinam
					<lb xml:id="p1z24"/>sed noster elegans et facetus egrobactici
					<lb xml:id="p1z25"/>pergit prenue sum defendenda sua haediesi
					<lb xml:id="p1z26"/>vel capore seii humanitate Christi
					<lb xml:id="p1z27"/>.
					<pb/>
					<lb xml:id="p2z1"/>tu.
					<lb xml:id="p2z2"/>perbis ci mentium a.
					<lb xml:id="p2z3"/>In trinitatem recepta et cidum, ut ipse loguutur
					<lb xml:id="p2z4"/>incertirata. Deas bone quo tandem ista
					<lb xml:id="p2z5"/>thheoloxia Ctrituper. Htabemur iam serunda
					<lb xml:id="p2z6"/>istiue hominis sedide phancasiam leo
					<lb xml:id="p2z7"/>trnitatis quadritatum. Lao uniquaeri
					<lb xml:id="p2z8"/>et sumptrim dei. Quos doc unum a
					<lb xml:id="p2z9"/>Saelemo, alterum fastiticium. Illustrissimo
					<lb xml:id="p2z10"/>prinoxi nostro Wilhelmo cantgravim
					<lb xml:id="p2z11"/>et Carolo Badensi, qui ne liber agar
					<lb xml:id="p2z12"/>Faachianus su lavem fudiret senatum
					<lb xml:id="p2z13"/>Arntnensem hatat sint. Respensum
					<lb xml:id="p2z14"/>typographum iam sferiptre insentat.
					<lb xml:id="p2z15"/>neque comunde iam amplius suipedioque reien
					<lb xml:id="p2z16"/>Cngium sanem tali seralu, unius hiteras sudecti
					<lb xml:id="p2z17"/>et ambitissi impostuta fascineti indignum
					<lb xml:id="p2z18"/>responsum.
					<lb xml:id="p2z19"/>scribit ad te noster Iosias, sicut exliteris
					<lb xml:id="p2z20"/>intelliges, datis operam, ut statim fideus
					<lb xml:id="p2z21"/>aliquos ex vestro senatu aut aliqua can
					<lb xml:id="p2z22"/>herum temporum censilia sanguinaria, quae
					<lb xml:id="p2z23"/>In repia capita nminus quam aliorum cudum
					<lb xml:id="p2z24"/>expliceri potunt. Bene cale et nos ut
					<lb xml:id="p2z25"/>soles amare pergito. Salutant te omnem
					<lb xml:id="p2z26"/>amici, qui partim tibi scribunt. Heydellergae
					<lb xml:id="p2z27"/>1. iulii a.6.
					<lb xml:id="p2z28"/>Tuus ex animo
					<lb xml:id="p2z29"/>.
					<lb xml:id="p2z30"/>Chustopherus Thenius d.
					<pb/>
					<lb xml:id="p4z1"/>Clarissimo pietate et doctrina
					<lb xml:id="p4z2"/>viro d. Henrycho Bullingero,
					<lb xml:id="p4z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> paestori
					<lb xml:id="p4z4"/>fidelissimo anico et patri
					<lb xml:id="p4z5"/>longe charissimo.
					<lb xml:id="p4z6"/>Turio.
				</p>
