	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Remitto ad te tuas literas ex literis scriptis in exercitu.</s>
					<s n="3" xml:lang="la">1. et 2. <lb xml:id="p1z2"/>huius mensis accepi conestabilem, admiralium et marescalcum St. Andree captivos es<lb xml:id="p1z3"/>se Attrebati, vocamus <placeName ref="l2165">Arras</placeName>, ubi tractant de pace cum Atrebatensi<note xml:id="fn1" type="footnote" n="1">von Arras.</note> <lb xml:id="p1z4"/>episcopo cancellario <persName>Philippi Domp Rigomet</persName> et matre ducis <placeName ref="l691">Lotaringie</placeName>, <lb xml:id="p1z5"/>ita ut speretur pax.</s>
					<s n="4" xml:lang="la">Ultima augusti rex et dolphinus sumpserant <lb xml:id="p1z6"/>eucharistiam.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Distant duo exercitus tribus aut quatuor miliaribus <lb xml:id="p1z7"/>nec separantur ullo flumine aut urbe, ita ut, nisi brevi <lb xml:id="p1z8"/>concludatur pax, ad manus deveniendum sit.</s>
					<s n="6" xml:lang="la">Non est ocium scribe[re] <lb xml:id="p1z9"/>ad amplissimum senatum; excusabis et hec indicabis certissima.</s>
					<s n="7" xml:lang="la" ana="salute"><lb xml:id="p1z10"/>Bene vale et amicos salutes meis verbis.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l760">Soluduri</placeName> 10. <lb xml:id="p1z11"/>septembris.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henrico Bulingero</persName>.</s>
				</p>
				<p>
					<note>[Von anderer Hand.]</note>
				</p>
			</div>
		</body>
	</text>
