	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Iter i<lb xml:id="p1z2"/>d <lb xml:id="p1z3"/>quod a m<lb xml:id="p1z4"/>e hoc tem<lb xml:id="p1z5"/>pore susc<lb xml:id="p1z6"/>eptum era<lb xml:id="p1z7"/>t iam dei beneficio magna ex parte emensu<lb xml:id="p1z8"/>s sum.</s>
					<s n="2" xml:lang="la">Ut <placeName ref="l41">Bernae</placeName> e<lb xml:id="p1z9"/>a quae visa erant digna conspicere possemus tuae <lb xml:id="p1z10"/>ad virum optimum d. <persName ref="p8018">Hallerum</persName> effecerunt literae.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Quid <lb xml:id="p1z11"/>autem dicam de d. <persName ref="p540">Calvino</persName>, <persName ref="p8033">Beza</persName>, <persName ref="p8078">Ionvillaeo</persName> et aliis qui <lb xml:id="p1z12"/>ut primum tuam agnoverunt manum, protinus suam <lb xml:id="p1z13"/>nobis obtulerunt operam.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Quanquam sane d. <persName ref="p540">Calvinus</persName> adeo <lb xml:id="p1z14"/>erat occupatus ut vix pauca quaedam nobiscum conferre <lb xml:id="p1z15"/>potuerit: id ipsum tamen quod contulit adeo gratum <lb xml:id="p1z16"/>est ut vix quidquam amplius.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><placeName ref="l167">Geneva</placeName> deinde post triduum <lb xml:id="p1z17"/><placeName ref="l28">Basileam</placeName> versus per <placeName ref="l760">Soloturnum</placeName> discessimus, hucque <lb xml:id="p1z18"/>die 2. huius mensis pervenimus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Iamque id quod restat <lb xml:id="p1z19"/>itineris brevi deo volente conficiemus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Quod sup<lb xml:id="p1z20"/>erest, peto, ut me antequam in <lb xml:id="p1z21"/>patriam discedam, tuis compellare literis non dedigneris.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Has <lb xml:id="p1z22"/>autem si ad me ante nundinas, quod maxime velim, mittere <lb xml:id="p1z23"/>volueris, mittendas esse puto huc <placeName ref="l28">Basileam</placeName> in <lb xml:id="p1z24"/>aedes <persName ref="p8126">Oporini</persName> <lb xml:id="p1z25"/>ad <persName>Andream Baliciensem</persName> <placeName ref="l2472">Polonum</placeName>, qui ad me facile <lb xml:id="p1z26"/>transmittet.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Quod si ad nundinas eas transmittere <lb xml:id="p1z27"/>volueris, <persName ref="p1227">Froschouerus</persName> eas adferre poterit.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z28"/>igitur, vir d<lb xml:id="p1z29"/>octissime.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Ecclesias nostras <lb xml:id="p1z30"/>commendatas vobis habeatis in vestris precibus ad deum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute"><pb/><lb xml:id="p2z1"/>Honestissimam matronam coniugem tuam ut meo nomine salutes <lb xml:id="p2z2"/>a te peto nec minus filiis et generis tuis plurimam <lb xml:id="p2z3"/>ex me salutem dicas.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Datae <placeName ref="l28">Basileae</placeName> 14. au<lb xml:id="p2z4"/>gusti 1563.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z5"/>Literarum ruditati peto ut ignoscas, <lb xml:id="p2z6"/>certe in hoc itinere temporis spatio destit<lb xml:id="p2z7"/>utus cultiores dare non poteram.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z8"/>Tuus <lb xml:id="p2z9"/>ex animo totus <persName ref="p2406">Venceslaus <lb xml:id="p2z10"/>ab Ostrorog</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Reverendo viro pietate et <lb xml:id="p2z11"/>singulari eruditione praestanti domino <lb xml:id="p2z12"/><persName ref="p495">Heinrycho Bul[lingero</persName>], ecclesiae <lb xml:id="p2z13"/>dei <placeName ref="l587">Ti[guri</placeName>.<lb xml:id="p2z14"/>.] pastori vigilantiss<lb xml:id="p2z15"/>imo, domino et patri in <lb xml:id="p2z16"/>Christo observandissimo.</s>
				</p>
				<p>
					<note type="author">[Darunter von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="18" xml:lang="la">Literae nobili<lb xml:id="p2z17"/>s viri <placeName ref="l2472">Poloni</placeName> <lb xml:id="p2z18"/><persName ref="p2406">Wenceslai ab <lb xml:id="p2z19"/>Ostrorog</persName> 1563.</s>
				</p>
			</div>
		</body>
	</text>
