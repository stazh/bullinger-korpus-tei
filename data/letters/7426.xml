	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Praesentes literas ante aliquot dies <placeName ref="l167">Geneva</placeName> accepi, <lb xml:id="p1z2"/>et dolet mihi, quod eas non citius ad te transmittere <lb xml:id="p1z3"/>potuerim.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Quaesivi, qui vel <placeName ref="l269">Küngsfeldum</placeName> irent; sed <lb xml:id="p1z4"/>nec istos invenire potui; proinde, si quid in mora peccatum <lb xml:id="p1z5"/>est, huic tantum tribue, quod aliter facere non potui.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/><persName ref="p8033">Beza</persName> suas mihi misit non occlusas, quo eas tecum commune<lb xml:id="p1z7"/>s habere possem; ideo ego eas meo sigillo obsignavi.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Ego istis non multa addere possum, nisi quod ab eo <lb xml:id="p1z9"/>tempore, quo has accepi, multa undequaque, etiam ex <placeName ref="l167">Gene<lb xml:id="p1z10"/>va</placeName>, de pace facta afferuntur et quod ea talis sit, ut papistae <lb xml:id="p1z11"/>multum ex ea tristentur.</s>
					<s n="6" xml:lang="la">Sed nihil adhuc certi per <lb xml:id="p1z12"/>postas, ut vocant, ea de re habemus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ex <placeName ref="l491">Argentina</placeName> quae<lb xml:id="p1z13"/>dam allata sunt, quę tamen nihil singulare continent, <lb xml:id="p1z14"/>nisi de successu <persName ref="p8315">Condensis</persName>, quantae sint illius copiae, quas <lb xml:id="p1z15"/>quisque alas ducat, quomodo sui in multis veli<lb xml:id="p1z16"/>tationibus superiores fuerint, quod dimidiam fere nunc <lb xml:id="p1z17"/><placeName ref="l832">Galliae</placeName> partem teneat, et quę sunt eiusmodi, quam <lb xml:id="p1z18"/>misere item <placeName ref="l834">Itali</placeName> ab utraque parte tractentur; vix tamen, <lb xml:id="p1z19"/>ut sunt digni, tractantur.</s>
					<s n="8" xml:lang="la">Faxit dominus, ut subinde melio<lb xml:id="p1z20"/>ra audiamus.</s>
					<s n="9" xml:lang="la">Quid <placeName ref="l1860">Neoduni</placeName> sit actum, ex domino consule <lb xml:id="p1z21"/>cognovisti.</s>
					<s n="10" xml:lang="la">Dolet mihi valde, quod illum ea nocte, <lb xml:id="p1z22"/>qua hic fuit, alloqui non potuerim; ita enim se continuit<lb xml:id="p1z23"/>, ut discessum illius prius quam adventum cogno<lb xml:id="p1z24"/>verim.</s>
					<s n="11" xml:lang="la">Si contingat, rogo, ut me apud illum excuses.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z25"/>Bene vale.</s>
					<s n="13" xml:lang="la" ana="salute">Salutant te omnes nostri; salvi sint etiam tui.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z26"/><placeName ref="l41">Bernae</placeName> 28. martii 1568.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z27"/><persName ref="p8018">I[ohannes] Hallerus</persName>, tuus <lb xml:id="p1z28"/>semper.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">[<pb/><lb xml:id="p2z1"/>C]larissimo viro domino <persName ref="p495">Heinrycho [<lb xml:id="p2z2"/>B]ullingero</persName>, domino meo colend<lb xml:id="p2z3"/>issimo et compatri charissimo.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>