	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tua (reverende pater) remitto omnia cum <lb xml:id="p1z2"/>venerando fratre d. <persName>Iulio</persName>, qui in <placeName ref="l832">Galliam</placeName> <lb xml:id="p1z3"/>proficiscitur; causam profectionis ex illo audies <lb xml:id="p1z4"/>ipso.</s>
					<s n="3" xml:lang="la">D. <persName ref="p3375">Vergerius</persName> adhuc apud nos est, et <lb xml:id="p1z5"/>quantum intelligo, septimanas aliquot hic <lb xml:id="p1z6"/>haerebit; nec enim se expedire potest aut vult <lb xml:id="p1z7"/>ante adventum d. <persName ref="p629">Coignetii</persName>, ut simul cum ipso <lb xml:id="p1z8"/>res communes Rhetiae tractet.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ex <placeName ref="l832">Gallia</placeName> <lb xml:id="p1z9"/>expecto certiora; sed interim adversarii se firmant.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Sed fiat voluntas domini.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">De concilio nihil <lb xml:id="p1z11"/>diligentiae praetermittam, maxime in nundinis <lb xml:id="p1z12"/>nostris, operam dabo, ut quid certi habeamus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Certe <lb xml:id="p1z13"/>hoc negotium pluribus dedi.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Mitto literas <lb xml:id="p1z14"/>d. <persName ref="p6831">Traversii</persName>, ex quibus intelliges nihildum <lb xml:id="p1z15"/>actum esse; literas non est quod remittas, conscinde.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>Totus nunc occupatus sum circa conciones <lb xml:id="p1z17"/>et alia mercatus, qui instat, negotia; itaque <lb xml:id="p1z18"/>plura non possum, sed ne habeo quidem, quod <lb xml:id="p1z19"/>scribam.</s>
					<s n="10" xml:lang="la">Maximas tibi refero gratias, quod <lb xml:id="p1z20"/>literas tantorum virorum communicaveris.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale, <lb xml:id="p1z21"/>reverende pater.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l98">Curię</placeName> 25. maii anno 1562.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">T[uus] <persName ref="p8009">Fab[ricius</persName>].</s>
				</p>
				<p>
					<s n="14" xml:lang="la">D. <persName ref="p495">Bulling[ero]</persName>.</s>
				</p>
			</div>
		</body>
	</text>
