	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Sat cito et sat bene accepi, quę postulaveram, cum libello et gratias <lb xml:id="p1z2"/>ago immortales libenter repensurus, si daretur occasio.</s>
					<s n="3" xml:lang="la">Transferam in <lb xml:id="p1z3"/><placeName ref="l832">Gallorum</placeName> ling[u]am et annitar, ut rex legat et probet, et mittam <lb xml:id="p1z4"/>Latine et <placeName ref="l832">Gallice</placeName> nec aliquid prętermittam.</s>
					<s n="4" xml:lang="la">Idem argumentum ego tractavi, <lb xml:id="p1z5"/>sed alio modo et ea attigi, que solum meliorem statum respiciunt et <lb xml:id="p1z6"/>in quibus erratum deprehendi et que potui observare, quod tibi aliquando <lb xml:id="p1z7"/>communicabo, et qualem successum omnia habuerint.</s>
					<s n="5" xml:lang="la"><persName ref="p17889">Dux Sabaudiae</persName> discessit <lb xml:id="p1z8"/>ab aula regis et petiit <placeName ref="l640">Flandriam</placeName> brevi rediturus, ut <placeName ref="l2478">Sabaudiam</placeName> <lb xml:id="p1z9"/>petat.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Tres legatos mittit ad <placeName ref="l41">Bernates</placeName>, <placeName ref="l160">Friburgenses</placeName> et <placeName ref="l791">Valesios</placeName>.</s>
					<s n="7" xml:lang="la">Si non <lb xml:id="p1z10"/>conveniant et sint discordes, puto, quod rem referent ad omnes cantones; <lb xml:id="p1z11"/>certius omnia brevi potero intelligere.</s>
					<s n="8" xml:lang="la">Ab illo duce heri literas accepi, <lb xml:id="p1z12"/>quibus solum gratias agit de beneficiis, que accepit me contulisse <lb xml:id="p1z13"/><placeName ref="l2478">Sabaudis</placeName>, et de humanitate et auxilio candide prestito, quo tempore <lb xml:id="p1z14"/>apud <placeName ref="l2478">Allobroges</placeName> a rege missus sum generalis, et se fore memorem <lb xml:id="p1z15"/>dicit.</s>
					<s n="9" xml:lang="la">Brevi imponetur finis comitiis <placeName ref="l18">Augustanis</placeName> et recta <placeName ref="l546">Viennam</placeName> <lb xml:id="p1z16"/>profecturus est imperator.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ei promiserunt quinque millia florenorum <lb xml:id="p1z17"/>in quinque annos pro contributione, et si <placeName ref="l2510">Turca</placeName> bellum moveat, <lb xml:id="p1z18"/>per dimidium annum dabunt 20 millia peditum et 4000 equites.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/>Is ad regem mittit legatum fratrem cardinalis <placeName ref="l18">Augusti</placeName>, ut eum <lb xml:id="p1z20"/>amicitie paterne heredem faciat.</s>
					<s n="12" xml:lang="la">Idem faciunt duces <lb xml:id="p1z21"/><placeName ref="l572">Virtembergensis</placeName> et Duorum <placeName ref="l2100">Pontium</placeName> et <persName ref="p8060">comes Palatinus</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Multorum rationes <lb xml:id="p1z22"/>conturbavit mors regis, et sperantur feliciora omnia et quietiora.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z23"/>Expectatur in aula rex <placeName ref="l1209">Navarre</placeName>, qui diu egrotavit.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Nescio quo <lb xml:id="p1z24"/>modo componentur res <placeName ref="l2524">Scotie</placeName>; nam obtinuerunt protestantes et omnia fere <lb xml:id="p1z25"/>occupant.</s>
					<s n="16" xml:lang="la">Omnia sunt in <placeName ref="l830">Anglia</placeName> composita, nec puto, quod filium <lb xml:id="p1z26"/>imperatoris ambiat regina; tametsi vulgo non omnino temere dictitant.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z27"/>Nondum papam mortuum accepi certo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l2653">Moscovita</placeName> redintegravit <lb xml:id="p1z28"/>bellum et trucidavit septingentes equites iuxta <placeName ref="l3690">Righa</placeName>.</s>
					<s n="19" xml:lang="la" ana="salute">Salutabis amicos <lb xml:id="p1z29"/>omnes et nos amabis et filium.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l760">Sol[uturi]</placeName> 7. augusti.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z30"/>Tuus ex animo <persName ref="p629">M[atthias] C[ognetius]</persName>.</s>
				</p>
				<p>
					<note>[Von anderer Hand:]</note>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>pastori vigilantissimo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>