	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quę mea sit sententia de scripto conciligationis <lb xml:id="p1z2"/>inter vos isthic et D. <persName ref="p540">Calvinum</persName> composito, <persName ref="p495">Bullingere</persName> <lb xml:id="p1z3"/>in domino charissime, ante octiduum ad te per D. <lb xml:id="p1z4"/><persName ref="p3700">Eberhardum</persName> scripsi, ut nunc opus non sit quicquam <lb xml:id="p1z5"/>de illo memorare.</s>
					<s n="3" xml:lang="la">Animum meum nosti: nihil <lb xml:id="p1z6"/>magis in votis habeo, quam ut omni simultate <lb xml:id="p1z7"/>sublata veritas evangelii dei sic Christi proponatur <lb xml:id="p1z8"/>ecclesiis, ut populus dei aedificetur et tandem <lb xml:id="p1z9"/>sci<lb xml:id="p1z10"/>entię dei, quae satis magna postremis istis concessa <lb xml:id="p1z11"/>est temporibus, timor ac reverentia dei <lb xml:id="p1z12"/>coniungatur.</s>
					<s n="4" xml:lang="la">Quapropter admodum congratulor <lb xml:id="p1z13"/>diligentię tuę quam huc tendere video, <lb xml:id="p1z14"/>ut controversia ista sacramentaria sublata <lb xml:id="p1z15"/>animi ministrorum Christi arctius iungantur, <lb xml:id="p1z16"/>et adversus improbissimum Satanam gregi Domini <lb xml:id="p1z17"/>pascendo vigilantius incumbant.</s>
					<s n="5" xml:lang="la">Quę ecclesiam <lb xml:id="p1z18"/>hanc specialiter concernunt, inque illa vel ferenda vel <lb xml:id="p1z19"/>tentanda sunt, illis committo quibus <lb xml:id="p1z20"/>plus est authoritatis et experientię.</s>
					<s n="6" xml:lang="la">Ago hic <lb xml:id="p1z21"/>homo advena, nihil aliud in usu habens <lb xml:id="p1z22"/>quam ut in psalterio meo publicis lectionibus <lb xml:id="p1z23"/>absolvendo pergam.</s>
					<s n="7" xml:lang="la">Commendo me tuę <lb xml:id="p1z24"/>fidei.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Dominus rationem habeat ecclesiarum suarum.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z25"/>Si quid me vis, mone.</s>
					<s n="10" xml:lang="la" ana="salute">Salutem omnibus <lb xml:id="p1z26"/>tuis meo et meorum nomine, qui per gratiam <lb xml:id="p1z27"/>Dei belle valere incipiunt.</s>
					<s n="11" xml:lang="la" ana="salute">Salveant etiam <lb xml:id="p1z28"/>domini ac fratres mei omnes.</s>
					<s n="12" xml:lang="la"><persName ref="p8440">Gervasium</persName> quaeso <lb xml:id="p1z29"/>mone ut aliquid saltem ad me scribat.</s>
				</p>
				<p>
					<s n="13" xml:lang="de"><lb xml:id="p1z30"/><placeName ref="l41">Bernę</placeName> 1549.</s>
					<s n="14" xml:lang="la">27. Iunii.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Heri annus fuit <lb xml:id="p1z31"/>quo <placeName ref="l18">Augustam</placeName> propter acceptatum Interim reliqui.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z32"/>Domino sit gratia qui adflictiones suorum tempori <lb xml:id="p1z33"/>fluxo ac transitorio inclusit.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><persName ref="p8417">W[<lb xml:id="p1z34"/>olfgangus] Muscu<lb xml:id="p1z35"/>lus</persName> tuus <lb xml:id="p1z36"/>in Domino.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo M. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z4"/>domino ac <lb xml:id="p2z5"/>fratri in Christo <lb xml:id="p2z6"/>plurimum colendo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
