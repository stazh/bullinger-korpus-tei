	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nisi opportunus hic nuncius ad vos abiret, <lb xml:id="p1z2"/>non fuissem tibi molestus brevi hoc meo <lb xml:id="p1z3"/>epistolio; at commode per hunc poteris rescribere <lb xml:id="p1z4"/>de rebus <placeName ref="l832">Galliae</placeName>, de quibus cum nuncientur <lb xml:id="p1z5"/>in diem tristissima, maxima me afficiunt <lb xml:id="p1z6"/>molestia.</s>
					<s n="3" xml:lang="la">Moerore tantum non conficior; dolet <lb xml:id="p1z7"/>ex animo veritatem blasphemari, idololatriam <lb xml:id="p1z8"/>restitui, sanctos dei confessores et <lb xml:id="p1z9"/>miseram plebeculam barbara saevitie ita misere <lb xml:id="p1z10"/>trucidari ac impios tantopere exultare.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z11"/>Verum huiusmodi querelas multas cogeris audire <lb xml:id="p1z12"/>quotidie, unde merito dolorem tibi augere <lb xml:id="p1z13"/>non debeo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Oremus dominum, ne nos deserat <lb xml:id="p1z14"/>in perpetuum.</s>
					<s n="6" xml:lang="la"><persName>Mendacium</persName> vel <persName ref="p17872">Mendoza</persName>, legatus <lb xml:id="p1z15"/><placeName ref="l832">Gallicus</placeName>, petit ab 8 cantonibus adhuc 8 signa, <lb xml:id="p1z16"/>quae res me utcunque consolatur; si enim res pa<lb xml:id="p1z17"/>pistarum tam felices sunt, ut praedicant, quid necesse <lb xml:id="p1z18"/>est augere exercitum?</s>
					<s n="7" xml:lang="la">De <placeName ref="l830">Anglis</placeName> nihil a<lb xml:id="p1z19"/>mplius audio; vereor vana esse, quae nunciata sunt <lb xml:id="p1z20"/>de ipsorum adventu, et <placeName ref="l822">Germanos</placeName> post festum <lb xml:id="p1z21"/>venire timeo; nam hic dicitur pro certo <placeName ref="l367">Au<lb xml:id="p1z22"/>reliam</placeName> gravissime obsideri.</s>
					<s n="8" xml:lang="la">Utinam felicior<lb xml:id="p1z23"/>a a te audiam per hunc <placeName ref="l2472">Polonum</placeName>, qui brevi ad <lb xml:id="p1z24"/>nos redibit; commendo ipsum tuae humanitati; <lb xml:id="p1z25"/>nam vir est bonus et doctrinae nostrae studiosissimus, <lb xml:id="p1z26"/>qui, si aliquando in patriam redierit, plurimum <lb xml:id="p1z27"/>iuvare poterit ecclesiam<note type="margin">dazu a.R.: "<persName ref="p8511">Christophorus Tretius</persName>."</note></s>
					<s n="9" xml:lang="la" ana="farewell">Vale, domine co<lb xml:id="p1z28"/>lende et frater charissime, supplicemusque domino <lb xml:id="p1z29"/>deo nostro assidue, ut nostri misereatur et nos liberet <lb xml:id="p1z30"/>ab infensissimis hostibus nostris.</s>
					<s n="10" xml:lang="la" ana="salute">Salutato d. <lb xml:id="p1z31"/><persName ref="p8033">Bezam</persName>, ubiubi sit, d. <persName ref="p8078">Ionvilleum</persName>, <persName ref="p8305">Budeum</persName> <lb xml:id="p1z32"/>et alios nostros amicos; salutant te una cum <lb xml:id="p1z33"/>tuis omnibus nostri omnes.</s>
					<s n="11" xml:lang="la">Septembris 14. 1562.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z34"/>Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p540">Ioanni <lb xml:id="p2z2"/>Calvino</persName>, <placeName ref="l167">Genevensis</placeName> <lb xml:id="p2z3"/>ecclesiae pastori <lb xml:id="p2z4"/>fideli, domino colendo <lb xml:id="p2z5"/>et fratri charissimo suo.</s>
					<s n="14" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l167">Genff</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
