	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Postquam mirabili dei providentia gratiaque <lb xml:id="p1z2"/>singulari factum est, ut ministri omnium <lb xml:id="p1z3"/>ecclesiarum in <lb xml:id="p1z4"/><placeName ref="l862">Helvetia</placeName> et <placeName ref="l648">Rhetia</placeName> consenserint in eam confessionem, quam antea <lb xml:id="p1z5"/>vidistis et in quam etiam vos consensistis no<lb xml:id="p1z6"/>biscum, visum est illam praefixa praefatione <lb xml:id="p1z7"/>communi omnium nostrum nomine edere in publicum.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z8"/>Quod felix et faustum sit, precamur benedicente laboribus <lb xml:id="p1z9"/>nostris domino nostro Iesu Christo.</s>
					<s n="4" xml:lang="la">Iam vero antea <lb xml:id="p1z10"/>intellexistis <placeName ref="l28">Basiliensium</placeName> responsum, quorum <lb xml:id="p1z11"/>l<lb xml:id="p1z12"/>iteras descriptas misimus ad d. <persName ref="p8018">Hallerum</persName><note type="misc">zuerst wollte er offenbar schreiben 'ad vestram urbem <placeName ref="l41">Bernensem</placeName>; es steht "nururbe" das gestrichen u. durch über der Zeile nachgetragenes, D. <persName ref="p8018">Hallerum</persName> nostrum' ersetzt ist.</note> nostrum.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z13"/>Iussi autem sumus 12 exempla mittere ad vos, ut ea inter <lb xml:id="p1z14"/>vos distribuatis et inter senatores praecipuos.</s>
					<s n="6" xml:lang="la">Omnia <lb xml:id="p1z15"/>egimus communi magistratus nostri consilio, cuius sumptibus <lb xml:id="p1z16"/>publicis haec res tandem est perfecta.</s>
					<s n="7" xml:lang="la">Restat <lb xml:id="p1z17"/>vero, colendissimi domini et fratres charissimi, ut <lb xml:id="p1z18"/>primum agamus maximas gratias domino deo nostro <lb xml:id="p1z19"/>pro hoc concordi nostro consensu, deinde ut sedulo <lb xml:id="p1z20"/>opem eius imploremus, quo laboribus nostris <lb xml:id="p1z21"/>benedicere pergat ipseque efficiet, ut confessio <lb xml:id="p1z22"/>nostr multum boni fructus proferat.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Bene valete, <lb xml:id="p1z23"/>viri reverendi, domini colendissimi et fratres <lb xml:id="p1z24"/>charissimi.</s>
					<s n="9" xml:lang="la">Orate pro nobis ac amemus nos mu<lb xml:id="p1z25"/>tuum charitate syncera.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 12. martii <lb xml:id="p1z26"/>anno 1566.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z27"/><persName ref="p495">Heinrychus Bullingerus</persName> <lb xml:id="p1z28"/>scripsit hoc nomine omnium <lb xml:id="p1z29"/>pastorum atque ministrorum <lb xml:id="p1z30"/><placeName ref="l587">Tigurinae</placeName> ecclesiae.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Huius<lb xml:id="p1z31"/>modi literas misimus <placeName ref="l41">Bernam</placeName>, <lb xml:id="p1z32"/><placeName ref="l167">Genevam</placeName> et <placeName ref="l49">Biennam</placeName> et <placeName ref="l98">Curiam</placeName><note type="misc">"et Curiam" nachträglich von ihm beigefügt.</note>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>