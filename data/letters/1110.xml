	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Communes literas tuas, compater in domino <lb xml:id="p1z2"/>charissime, ego et <persName ref="p8018">Hallerus</persName> accepimus una cum <lb xml:id="p1z3"/>donario, quod <persName ref="p2066">Ioanni Heinricho</persName>, communi <lb xml:id="p1z4"/>nostro in Christo filiolo, pro felici iam imminentis <lb xml:id="p1z5"/>quinquagesimi primi anni auspicio <lb xml:id="p1z6"/>misisti, cuius nomine tibi gratiam habemus.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Oro dominum, ut tantum det et pacis et aetatis, <lb xml:id="p1z8"/>ut aliquando coram illum videas et instruas <lb xml:id="p1z9"/>et ipse huic tuę benevolentię grato animo <lb xml:id="p1z10"/>pro sua virili respondeat.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z11"/>Metuis, ne futurum conciliabulum antichristianorum <lb xml:id="p1z12"/><placeName ref="l862">Elvetiam</placeName> potissimum vocet in discrimen.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z13"/>Iam dudum hic ea ipsa de re loquutus sum, <lb xml:id="p1z14"/>quibus licuit; verum media nox est, dormiunt <lb xml:id="p1z15"/>omnes.</s>
					<s n="6" xml:lang="la">Admoneo, ut evangelici, <placeName ref="l587">Tigurini</placeName>, <lb xml:id="p1z16"/><placeName ref="l41">Bernates</placeName>, <placeName ref="l28">Basilienses</placeName>, <placeName ref="l441">Schafhusiani</placeName> ac reli<lb xml:id="p1z17"/>qui collaterales, ut ita dicam, animos <lb xml:id="p1z18"/>in tempore coniungant.</s>
					<s n="7" xml:lang="la">Etenim, nisi hoc <lb xml:id="p1z19"/>fiat, non video, quomodo manus <lb xml:id="p1z20"/>constanter et efficaciter iungi possint, ubi <lb xml:id="p1z21"/>occurrendum erit hosti.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Retinetis antiquarum <lb xml:id="p1z22"/>discordiarum memoriam studiosissime, quam <lb xml:id="p1z23"/>ne verbo quidem improbare ac reprehendere <lb xml:id="p1z24"/>audetis.</s>
					<s n="9" xml:lang="la">Praeterquam quod ea res prorsus <lb xml:id="p1z25"/>a professione evangelii Christi dissidet, <lb xml:id="p1z26"/>etiam hoc mali habet, quod solidam animorum <lb xml:id="p1z27"/>concordiam summopere nunc necessariam <lb xml:id="p1z28"/>impedit.</s>
					<s n="10" xml:lang="la">Hoc me malum plurimum divexat; <lb xml:id="p1z29"/>verum quid faciam?</s>
					<s n="11" xml:lang="la">Clamo ad dominum, ut <lb xml:id="p1z30"/>ecclesiarum suarum rationem habeat nec <lb xml:id="p1z31"/>sinat eas propter quorundam inconsultorum <lb xml:id="p1z32"/>hominum ineptias prorsus de veritate <lb xml:id="p1z33"/>evangelii sui periclitari.</s>
					<s n="12" xml:lang="la">Si conciliabulum <lb xml:id="p1z34"/>hoc processerit, videbimus magnam nequiciam <lb xml:id="p1z35"/>antichristianorum; verum spero dominum consilia <lb xml:id="p1z36"/>principum dissipaturum.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Difficillimum erit <persName ref="p18538">Caesari</persName> <lb xml:id="p1z37"/>ac papae conflare concilium ex <placeName ref="l822">Germania</placeName>, <lb xml:id="p1z38"/><placeName ref="l832">Gallia</placeName>, <placeName ref="l830">Anglia</placeName>, <placeName ref="l825">Dania</placeName>, <placeName ref="l2472">Polonia</placeName>, quamvis <placeName ref="l875">Hispania</placeName> <lb xml:id="p1z39"/>et <placeName ref="l834">Italia</placeName> non detrectent.</s>
					<s n="14" xml:lang="la">Utinam nostri sint <lb xml:id="p1z40"/>vigiles et prudentes.</s>
					<s n="15" xml:lang="la" ana="farewell">Optime vale, charissime compater.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z41"/>Domus mea iam est tranquilla; gratia sit domino.</s>
					<s n="17" xml:lang="la" ana="salute">Salutem <lb xml:id="p1z42"/>tuis omnibus et fratribus.</s>
					<s n="18" xml:lang="la"><placeName ref="l41">Bernę</placeName> 16. decembris 1550.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><persName ref="p8417">Musculus</persName> tuus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo theologo <lb xml:id="p2z2"/>m. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae <lb xml:id="p2z5"/>pastori vigilantiss<lb xml:id="p2z6"/>imo, compatri <lb xml:id="p2z7"/>suo in Christo <lb xml:id="p2z8"/>charissimo.</s>
				</p>
			</div>
		</body>
	</text>
