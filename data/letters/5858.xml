	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><persName ref="p1227">Froschouerus</persName> parat discessum <placeName ref="l157">Franc<lb xml:id="p1z2"/>fordiam</placeName>; scis, quibus tum premar angustiis: <lb xml:id="p1z3"/>scribendum in <placeName ref="l830">Angliam</placeName>, in <placeName ref="l808">Belgicum</placeName>, in <placeName ref="l213">Hessiam</placeName>, <lb xml:id="p1z4"/><placeName ref="l749">Saxoniam</placeName>, <placeName ref="l743">Pomeraniam</placeName>, <placeName ref="l2562">Prussiam</placeName> etc.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Ergo <lb xml:id="p1z5"/>mitto literas, ex quibus colligas, quae petis.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Prudenter illis utere; nollem ea, quae de <lb xml:id="p1z7"/><placeName>Condensi</placeName> referuntur, omnibus esse nota.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Similia prope scripsi tecum ad <placeName ref="l646">Claronenses</placeName>.</s>
					<s n="6" xml:lang="la">Me<lb xml:id="p1z9"/>tuo, ne, dum officiis inhiant, amittant maiora.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Dominum oremus, ut benedicat ei negotio.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/>Literas vero, quas tibi communico, soli communico <lb xml:id="p1z12"/>et, ut mature remittas, volo<note type="margin">dazu a.R.: "Ich vertruwen also nitt jederman mine brieff."</note>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>Nunc fama adfertur <placeName ref="l300">Lucernae</placeName> novum militem <lb xml:id="p1z14"/>in <placeName ref="l832">Galliam</placeName> mittendum colligi; causae potius <lb xml:id="p1z15"/>ex coniectura colliguntur quam ex veritate.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/>Alii putant ecclesiam reliquam in <placeName ref="l832">Gallia</placeName> ex<lb xml:id="p1z17"/>cindendam horum militum opera, alii putant <lb xml:id="p1z18"/>recrudescere bellum <placeName ref="l832">Gallicum</placeName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Quid sit, brevi <lb xml:id="p1z19"/>audiemus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z20"/>Scripsi antea coronatione <persName ref="p18556">Maximiliani</persName> in <lb xml:id="p1z21"/><persName ref="p20809">regem Hungariae</persName> irritari crabrones; <lb xml:id="p1z22"/>nunc audio <placeName ref="l2510">Turcicum</placeName> exercitum ingentem <lb xml:id="p1z23"/>venisse <placeName ref="l1074">Budam</placeName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Quod si verum est, reliqua <lb xml:id="p1z24"/>facile colligis.</s>
					<s n="14" xml:lang="de"><foreign xml:lang="la">Addunt conscriptos ad lu<lb xml:id="p1z25"/>dum vel certamen bombardarum</foreign> (die uff <lb xml:id="p1z26"/>das schiessen bescheiden) werdint uffgehallten, <lb xml:id="p1z27"/>biß man säch, wo die sach hinus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell"><lb xml:id="p1z28"/>Vale bene.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute">Saluta familiam tuam, d. d. consules, <lb xml:id="p1z29"/><persName ref="p8359">Gallicium</persName>, <persName ref="p6130">Pontisellam</persName>, amicos omnes.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z30"/>optime.</s>
					<s n="18" xml:lang="la">27. augusti 1563.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z31"/>Tuus ille.</s>
				</p>
				<p>
					<note type="address">[Ohne Adresse.]</note>
				</p>
			</div>
		</body>
	</text>
</TEI>