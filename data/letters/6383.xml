	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Literas tuas, chare frater, copiose scriptas de <lb xml:id="p1z2"/>motibus istis vestris <placeName ref="l648">Rheticis</placeName> tardius accepi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Scriptae <lb xml:id="p1z3"/>erant 10. februarii; recepi illas 20. eiusdem mensis, <lb xml:id="p1z4"/>sed videram prius eas, quas scripseras ad <persName ref="p252">I[oachimum] Beldium</persName>; <lb xml:id="p1z5"/>has enim mihi exhibuit interpres legati regis, qui <lb xml:id="p1z6"/><placeName ref="l760">Saloduri</placeName> agit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ille fuerat <placeName ref="l646">Claronae</placeName>, per nos redibat <lb xml:id="p1z7"/><placeName ref="l760">Salodurum</placeName> et hic me salutabat.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Proinde totam historiam <lb xml:id="p1z8"/>exponendam putavi consulibus, id quod feci.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Simul afferuntur <lb xml:id="p1z9"/><placeName ref="l300">Lucerna</placeName> literae testificantes et ipsae cieri apud <lb xml:id="p1z10"/>vos seditiones.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Indigne ferebant nostri, quod citius <lb xml:id="p1z11"/>periculum vestrum exposuissetis <placeName ref="l300">Lucernatibus</placeName> quam nobis.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/>Nihilominus conscripsere nostri commitia<note type="misc">... mitia</note> Badae 4. martii <lb xml:id="p1z13"/>celebranda, in quibus consultetur de remedio turbis illis <lb xml:id="p1z14"/>adhibendo.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Simul misere nostri cursorem cum literis <lb xml:id="p1z15"/>ad vestros perquisitum, ut res habeant vestrae, et significatum <lb xml:id="p1z16"/>propter vos <persName>Rhetos</persName> conscripta esse comitia <placeName ref="l21">Badam</placeName> etc.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z17"/>Haec iam antea haud dubie nosti.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Valde doleo propter <lb xml:id="p1z18"/>principes exteros et studiis partium sic nos discind<lb xml:id="p1z19"/>i per <placeName ref="l862">Helvetiam</placeName>; laceratio haec certissimum est <lb xml:id="p1z20"/>prognosticon res nostras brevi corruituras.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><persName>Locarn<lb xml:id="p1z21"/>as</persName> quidam rediens pridie <placeName ref="l306">Mediolano</placeName> significat nav<lb xml:id="p1z22"/>ibus iustum allatum <placeName ref="l875">Hispanorum</placeName> militum exercitum <lb xml:id="p1z23"/>Ianuam, qui per hyperna sit disponendus per <placeName ref="l736">Pede<lb xml:id="p1z24"/>montium</placeName> et <placeName ref="l306">Mediolanum</placeName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Quid hoc, si vera sunt, <lb xml:id="p1z25"/>quae ille refert?</s>
					<s n="14" xml:lang="la">Addit ille <persName>Sanpetrium</persName> iam <lb xml:id="p1z26"/>totam occupasse <placeName ref="l2801">Corsicam</placeName> uno aut altero loco excepto; <lb xml:id="p1z27"/>classem quoque a <placeName ref="l2510">Turca</placeName> instrui.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">De morte <persName ref="p18556">Maximiliani</persName> <lb xml:id="p1z28"/>nihildum accepi.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Diu iam expecto literas ex <placeName ref="l361">Nero<lb xml:id="p1z29"/>berga</placeName> et <placeName ref="l18">Augusta Vindelicorum</placeName>; alioqui ex <placeName ref="l822">Ger<lb xml:id="p1z30"/>mania</placeName> iam septimanas aliquot nihil habeo.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Quae <lb xml:id="p1z31"/>fuse ad me perscripta sunt ex <placeName ref="l869">Transylvaniae</placeName> con<lb xml:id="p1z32"/>finis, in summam collecta et descripta hic mitto, <lb xml:id="p1z33"/>sed ut per proximum nuncium remittas; communica <lb xml:id="p1z34"/>cum amplissimo d. legato, quem honorificentissime <lb xml:id="p1z35"/>ex me salutabis.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Legatus regis <placeName ref="l760">Salodorensis</placeName> dicitur <lb xml:id="p1z36"/>descendisse <placeName ref="l28">Basileam</placeName>, quod magna ibi sint impedim<lb xml:id="p1z37"/>enta foederis pangendi, quae ille amoliri conetur.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z38"/>Nescio, an <placeName ref="l41">Bernates</placeName> receperint.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Diu nihil <lb xml:id="p1z39"/>accipio literarum vel ex <placeName ref="l41">Berna</placeName> vel <placeName ref="l167">Geneva</placeName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Tu <lb xml:id="p1z40"/>si quid certi habes ex <placeName ref="l834">Italia</placeName>, communica.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Ad tuam querel<lb xml:id="p1z41"/>am nihil respondere possum, quam quod ego in paribus <lb xml:id="p1z42"/>casibus facio, id ipsum te doceo: respicere in deum, illum <lb xml:id="p1z43"/>invocare et perstare in officio.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="farewell">Vale aeternum.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Februarii <lb xml:id="p1z44"/>23. 1565.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Tuus qui semper.</s>
				</p>
				<p>
					<s n="26" xml:lang="la" ana="salute">Saluta <pb/><lb xml:id="p2z1"/>consules et viros bon<lb xml:id="p2z2"/>os.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p2z3"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z4"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z5"/>fideli ministro, domino <lb xml:id="p2z6"/>meo colendo et fratri chariss<lb xml:id="p2z7"/>imo.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
