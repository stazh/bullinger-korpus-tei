	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Mura d. Gallitium ad te non scrississe me iam alterum
					<lb xml:id="p1z2"/>mensem atque in gravissimis doloribus decumbere, id eum
					<lb xml:id="p1z3"/>ut fueret, pea alterum medicorum, qui mihi adsunt
					<lb xml:id="p1z4"/>cum d. Gessneri literas ad me misisses rogav. Acces
					<lb xml:id="p1z5"/>acta synodi Neoduegensis et tibi gratias ado rogoque
					<lb xml:id="p1z6"/>ut me excusatum habeas. Vale. Curiae 24. iulii.
					<lb xml:id="p1z7"/>Tuus e rt.
					<pb/>
					<lb xml:id="p2z1"/>Clarissimo viro d. Heinricho
					<lb xml:id="p2z2"/>Bullingero, ecclesiastae <placeName ref="l587">Tigurino</placeName>
					<lb xml:id="p2z3"/>amico charissimo.
					<lb xml:id="p2z4"/>S.
				</p>
			</div>
		</body>
	</text>
