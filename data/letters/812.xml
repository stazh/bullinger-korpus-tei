	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Anno 1550 adi<note xml:id="fn1" type="footnote" n="1">anno domini?</note> 18. ianuarii ex <placeName ref="l267">Colonia</placeName>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">S. <lb xml:id="p1z2"/>P.</s>
					<s n="3" xml:lang="la">Tuae dominationis literas 10. decembris scriptas accepi 12. ianuarii.</s>
					<s n="4" xml:lang="la">De <persName>Floriani</persName> integra fide non dubitavi nec <lb xml:id="p1z3"/>dubitabo; illud saltem me movet, quod se clam <placeName ref="l157">Franckfordia</placeName> insalutatis omnibus amicis subduxit <lb xml:id="p1z4"/>neque in hunc diem, ubi agit, indicavit.</s>
					<s n="5" xml:lang="la">Non intelligo ex tuis literis, ubi degit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Emit a me nonnullos <lb xml:id="p1z5"/>libros, an pro te vel pro alio, ignoro.</s>
					<s n="7" xml:lang="la">Credo illum suo famulo pecuniam servandam non commisisse.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z6"/>Avide expecto vestram et d. <persName ref="p540">Calvini</persName> consensionem, et a synceris hic expectatur.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Ante mensem ad <lb xml:id="p1z7"/>sacram anchoram huc fugit <persName>Lovanio</persName> pius sacrificus et studiosus, qui meo suasu ad te scribere <lb xml:id="p1z8"/>instituit, num hic vel alibi nostris ceremoniis interesse salva conscientia potest; non satis facit <lb xml:id="p1z9"/>illi d. <persName ref="p8417">Musculus</persName>.</s>
					<s n="10" xml:lang="la">D. <persName ref="p540">Calvini</persName> liber De vitandis superstitionibus apud me iam non prostat.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z10"/>Senior comes a Weda relictis omnibus prebendis hoc titulo honoratur innato: <lb xml:id="p1z11"/>"<lb xml:id="p1z12"/>Illustri et generoso <persName>Friderico</persName> seniori comiti in <placeName>Weda</placeName>, d. in <placeName>Ronchel</placeName> et <placeName>Isenburg</placeName>" etc., <lb xml:id="p1z13"/>eodem titulo et <persName>Hermannus a Weda</persName> senior, <placeName ref="l267">Coloniensis</placeName> archiepiscopus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z14"/>D. <persName>Cesarius</persName> brevi ad nos rediturus est.</s>
					<s n="13" xml:lang="la">Speramus indies meliora ex <placeName ref="l830">Anglia</placeName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Optaremus operam <lb xml:id="p1z15"/>illius boni nobilis, qui apud vos agit; posset nobis et omnibus piis sua lectione multum prodesse, <lb xml:id="p1z16"/>donec iuvenem quendam mitterem, qui correctorem sua lectione iuvaret.</s>
					<s n="15" xml:lang="la">Scripsi d. <persName ref="p8121">Montio</persName>, ut ad <lb xml:id="p1z17"/>te mitteret disputata d. <persName ref="p8111">Petri Martyris</persName> de sacramento eucharistiae; scio illum habere exemplar unum.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z18"/>Varia hic de electione pontificis habemus; alii <persName>Anglum</persName>, alii cardinalem a <placeName ref="l691">Lotharingia</placeName> electum <lb xml:id="p1z19"/>affirmant.</s>
					<s n="17" xml:lang="la">Nostra nihil refert; nam nulla spes est verae reformationis.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z20"/>Accepi <placeName ref="l1098">Florentia</placeName> nonnullos novos libros, <persName ref="p18357">Thomam de Aquino</persName> in Apocalypsim; mittam quam primum ex <lb xml:id="p1z21"/>singulis unum exemplar.</s>
					<s n="19" xml:lang="la">Si quid apud vos novi fuerit impressum, oro, ut d. <persName ref="p4851">Froschouerus</persName> nobis mittat; <lb xml:id="p1z22"/>non dubito de illius diligentia in imprimendis bibliis <placeName ref="l830">Anglicanis</placeName>, in quibus tua dominatio suam operam nobis <lb xml:id="p1z23"/>pollicetur; non sine [in]grati animi significatione acceptamus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z24"/>De <persName ref="p18538">Caesaris</persName> adventu nihil certi habemus; decumbit podagra, meditatur semper et ad maiora spirat.</s>
					<s n="21" xml:lang="la" ana="salute"><lb xml:id="p1z25"/>Salutabis d. <persName ref="p1283">Gesnerum</persName> nomine d. <persName>Echtii</persName> et d. <persName ref="p17832">Bernhardi</persName>; uterque miratur taciturnitatem d. <persName ref="p1283">Gesneri</persName>; offerunt <lb xml:id="p1z26"/>illi omnem operam et diligentiam in depingendis animalibus.</s>
					<s n="22" xml:lang="la">De debitoribus d. <persName ref="p8127">Pellicani</persName> nihil accepi.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="farewell"><lb xml:id="p1z27"/>Vale, mi d. <persName ref="p495">Bullingere</persName>, et <persName ref="p380">Byrchmannum</persName> amare perge.</s>
					<s n="24" xml:lang="la"><lb xml:id="p1z28"/>Tuus obsequentissimus <persName ref="p380">Ioannes Byrchmannus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
