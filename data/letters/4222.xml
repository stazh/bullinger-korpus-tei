	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. <lb xml:id="p1z2"/>P.</s>
					<s n="2" xml:lang="la">Quod diu iam futurum putavi, tandem pręter expectation<lb xml:id="p1z3"/>em accidit.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Regnum papisticum iterum excudit <persName ref="p8126">Oporinus</persName> <lb xml:id="p1z4"/>adiunctis aliis quibusdam meis, in calce vera alia quę<lb xml:id="p1z5"/>dam addidit non mea.</s>
					<s n="4" xml:lang="la">Inter illa carmen est nescio cuius <lb xml:id="p1z6"/>de coena domini cum comparatione Christi et papę.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Quum igitur libellum concinnatum iurisconsulto cuidam hic <lb xml:id="p1z8"/>donassem atque ille in illud carmen incidisset, statim <lb xml:id="p1z9"/>ostendit principi.</s>
					<s n="6" xml:lang="la">Qui ita excanduit, ut ex templo iuberet <lb xml:id="p1z10"/>me dimitti, suspicans nimirum aut a me factum aut <lb xml:id="p1z11"/>eiusdem me esse opinionis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Non interrogor neque au<lb xml:id="p1z12"/>dior; adeo sibi persuadet esse vera, quę <persName ref="p458">Brentius</persName> aut <lb xml:id="p1z13"/>alius insusurrat.</s>
					<s n="8" xml:lang="la">Nunc te, frater, quęso, adiuva me <lb xml:id="p1z14"/>consilio.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Novem circiter annos hic evangelium docui <lb xml:id="p1z15"/>absque querimonia, nemini me opposui, cum nemine certavi <lb xml:id="p1z16"/>ulla de re concordię pacisque causa, licet interdum audirem <lb xml:id="p1z17"/>magno cum dolore a veritate nimium aliena; nosti enim <lb xml:id="p1z18"/><persName ref="p458">Brentiana</persName> commenta.</s>
					<s n="10" xml:lang="la">Nunc <persName ref="p8126">Oporinus</persName> me perdidit suis <lb xml:id="p1z19"/>additionibus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Quo ergo me vertam, plane nescio; si tu <lb xml:id="p1z20"/>aliquem nosti locum vel in territorio vestro vel alibi, <lb xml:id="p1z21"/>ostende.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Ad iuris omissa studia redire non libet; nam <lb xml:id="p1z22"/>ago annum quinquagesimum primum et patronum <lb xml:id="p1z23"/>olim meum <persName ref="p4863">Iacobum Fuggerum</persName> rursus compellar<lb xml:id="p1z24"/>e non audeo; aegerrime enim tulit, quod redierim <lb xml:id="p1z25"/>ad theologiam et sacras conciones.</s>
					<s n="13" xml:lang="la">Maximopere te rogo, <lb xml:id="p1z26"/>circumspice, inquire aliquam mihi conditionem.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Bene <lb xml:id="p1z27"/>vale et saluta me nomine collegas istic tuos.</s>
					<s n="15" xml:lang="la">Datum <lb xml:id="p1z28"/><placeName ref="l496">Stutgardię</placeName> 29. februarii 1560.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z29"/><persName ref="p8124">Thomas Naogeorgus</persName> <lb xml:id="p1z30"/>tuus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctrina et pietate insigni viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinricho Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesię pastori, domino ac <lb xml:id="p2z4"/>amico suo<lb xml:id="p2z7"/>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>