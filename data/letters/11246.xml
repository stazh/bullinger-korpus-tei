	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Beatum esse video, <persName ref="p8418">Myconi</persName> colend<lb xml:id="p1z2"/>issime, quisquis peste incensus migrat ad dominum.</s>
					<s n="3" xml:lang="la">Non <lb xml:id="p1z3"/>hoc tantum nomine, quod summo bono deo frui summa sit <lb xml:id="p1z4"/>felicitas<note xml:id="fn1" type="footnote" n="1">Vgl. etwa <persName ref="p18700">Augustin</persName>, De trinitate, 13, 7 (CChr 50A 394, 11-14).</note>, sed quod huiusmodi sint hodie saecula, ut mori <lb xml:id="p1z5"/>praestabilius sit quam vivere.</s>
					<s n="4" xml:lang="la">Omnia coarguunt et evin<lb xml:id="p1z6"/>cunt deum ad vindictam parari.</s>
					<s n="5" xml:lang="la">Miseri, qui huic vin<lb xml:id="p1z7"/>dictae per mortem non subtrahuntur.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quid in <placeName ref="l2507">Westphalia</placeName> <lb xml:id="p1z8"/>apud <placeName ref="l1097">Monasterienses</placeName> denuo tentarint quidam, non <lb xml:id="p1z9"/>nescis<note xml:id="fn2" type="footnote" n="2">In <placeName ref="l1097">Münster</placeName> waren mehrere Täufer aus <placeName ref="l185">Groningen</placeName> festgenommen worden, die aufgrund einer Prophezeiung die Wiedererrichtung des Täuferreichs vorbereiten wollten; s. Karl-Heinz <bibl source="b352">Kirchhoff</bibl> Die Täufer im Münsterland. Verbreitung und Verfolgung des Täufertums im Stift Münster 1533-1550, in: Westfälische Zeitschrift 113, 1963, S. 65f.</note>.</s>
					<s n="7" xml:lang="la">Ex <placeName ref="l850">Austria</placeName><note xml:id="fna" type="footnote" n="a"><hi>in der Vorlage irrtümlich</hi> Austia.</note> rumores ferunt<note xml:id="fn3" type="footnote" n="3">Ein <placeName ref="l587">Zürcher</placeName> Bote war kürzlich aus <placeName ref="l850">Österreich</placeName> zurückgekehrt; s. oben <ref target="file11243">Nr. 1200</ref>, 2-4 und 30f.</note> <placeName ref="l3246">Moltam</placeName>, quae <placeName ref="l3183">Wa<lb xml:id="p1z10"/>lachiae</placeName> pars est, nuper captam et subiugatam esse a <placeName ref="l2510">Turcico</placeName> <lb xml:id="p1z11"/>imperatore<note xml:id="fn4" type="footnote" n="4">Zur Strafexpedition von Sultan <persName ref="p18593">Suleiman I.</persName> in die <placeName ref="l3246">Moldau</placeName> s. ebd., Z. 34 mit Anm. 23.</note> excisis omnibus incolis.</s>
					<s n="8" xml:lang="la">Fertur habuisse <lb xml:id="p1z12"/>sub signis <persName ref="p20801">Tartaros</persName> 60000; nam immanissimum <lb xml:id="p1z13"/><persName ref="p20801">Tartarorum</persName> regem sibi foedere constrinxit et ad vota <lb xml:id="p1z14"/>paratissimum habet<note xml:id="fn5" type="footnote" n="5">Der Khan der Krimtataren, <persName ref="p18328">Sahib Giray</persName>, nahm mit einem großen Reiterheer am Feldzug teil; s. <bibl source="b276">Hammer-Purgstall</bibl> III 202.</note>.</s>
					<s n="9" xml:lang="la"><placeName ref="l869">Transsylvani</placeName> iugulum quasi <lb xml:id="p1z15"/>gladio venturo ad tempus vernum<note xml:id="fnb" type="footnote" n="b"><hi>kann auch als</hi> verum <hi>gelesen werden, was aber kaum Sinn ergibt.</hi></note> apparant.</s>
					<s n="10" xml:lang="la">Nam <lb xml:id="p1z16"/>quis est, qui causam eorum suscipiat tuendam?</s>
					<s n="11" xml:lang="la">Principes <lb xml:id="p1z17"/>nostri in innocentem et christianum sanguinem <lb xml:id="p1z18"/>arma parant.</s>
					<s n="12" xml:lang="la">Disiecta est hisce diebus a <placeName ref="l2510">Turcicis</placeName> <lb xml:id="p1z19"/>ratibus caesareana, pontificalis ac <placeName ref="l522">Veneta</placeName> <lb xml:id="p1z20"/>classis non longe, quod aiunt, a <placeName ref="l3182">Rhodo</placeName><note xml:id="fn6" type="footnote" n="6">Die Flotte der "Heiligen Liga" hatte am 27. September bei <placeName ref="l3184">Prevesa</placeName> (<placeName ref="l2531">Griechenland</placeName>) gegen <persName ref="p19042">Cheireddin Barbarossa</persName> eine empfindliche Niederlage erlitten, die den Zerfall des Bündnisses einleitete; s. oben <ref target="file11243">Nr. 1200</ref>, 32-34 mit Anm. 21.</note>.</s>
					<s n="13" xml:lang="la"><persName ref="p17784">Andreas <lb xml:id="p1z21"/>de Aurea</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p17784">Andrea Doria</persName>, der oberste Kommandant der vereinigten Flotte.</note> vix hostium manus evasit.</s>
					<s n="14" xml:lang="la">Mersae sunt ali<lb xml:id="p1z22"/>quot eius naves.</s>
					<s n="15" xml:lang="la"><persName ref="p8049">Vadianus</persName> noster hisce diebus scribit<note xml:id="fn8" type="footnote" n="8">Der Brief <persName ref="p8049">Vadians</persName> ist nicht erhalten; er muß einen Bericht über die Eruption des <placeName ref="l3014">Monte Nuovo</placeName> in den <placeName ref="l3185">Phlegräischen Feldern</placeName> enthalten haben, wie er ähnlich zu finden ist in: <persName ref="p1789">Keßler</persName>, Sabbata 478 (vgl. auch 593f sowie <persName ref="p6340">Johannes Rütiner</persName>, Diarium 1529-1539, hg. v. Ernst Gerhard Rüsch, Textband II/2, St. Gallen 1996, Abs. 421).</note> <lb xml:id="p1z23"/>mare a <placeName ref="l994">Neapoli</placeName> magno itinere retrocessisse <lb xml:id="p1z24"/>nec redire, unde foetor intollerandus omnibus in<lb xml:id="p1z25"/>ternicivam pestem minitetur.</s>
					<s n="16" xml:lang="la">Addit in <placeName ref="l2802">Apulia</placeName> circa <lb xml:id="p1z26"/><placeName ref="l994">Neapolim</placeName> ignem e terra erumpere et agros <lb xml:id="p1z27"/>plus quam horribiliter incendio vastare.</s>
					<s n="17" xml:lang="la">En manum <lb xml:id="p1z28"/>dei validam!</s>
					<s n="18" xml:lang="la">Ego vero haec dolorum initia crediderim<note xml:id="fn9" type="footnote" n="9">Vgl. <cit type="bible"><ref>Mt 24, 8</ref></cit>; <cit type="bible"><ref>Mk 13, 8</ref></cit>.</note>.<pb type="edition" next="281"/></s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z29"/>Multa huius generis calamitosa et porten<lb xml:id="p1z30"/>tosa scribere possem, sed sit hic finis.</s>
					<s n="20" xml:lang="la">Igitur, si <lb xml:id="p1z31"/>dominus tuos e medio sustulerit, imo si cum omnibus <lb xml:id="p1z32"/>pastorem vocarit, bene vobiscum agi credo.</s>
					<s n="21" xml:lang="la">Utinam <lb xml:id="p1z33"/>pari liceret vobiscum sorte frui!</s>
					<s n="22" xml:lang="la">Quod si non <lb xml:id="p1z34"/>dabitur, expectanda manus domini.</s>
					<s n="23" xml:lang="la">Vivit, vivit, qui <lb xml:id="p1z35"/>redemit nos<note xml:id="fn10" type="footnote" n="10">Vgl. <cit type="bible"><ref>Hi 19, 25</ref></cit>.</note>; non deseret nomen suum invocantes<note xml:id="fn11" type="footnote" n="11">Vgl. <cit type="bible"><ref>Ps 145, 18</ref></cit>.</note>.</s>
					<s n="24" xml:lang="la"><lb xml:id="p1z36"/>Simus ergo alacres in domino, qui est petra et <lb xml:id="p1z37"/>refugium nostrum<note xml:id="fn12" type="footnote" n="12">Vgl. <cit type="bible"><ref>2 Sam 22, 2f</ref></cit>.</note>.</s>
					<s n="25" xml:lang="la">Hic conservet te.</s>
					<s n="26" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="27" xml:lang="la" ana="farewell"><lb xml:id="p1z38"/>Vale cum tuis omnibus.</s>
					<s n="28" xml:lang="la" ana="salute">Salutabis <persName ref="p1365">Grynaeum</persName>, <persName ref="p8459">Ottonem</persName><note xml:id="fn13" type="footnote" n="13"><persName ref="p8459">Otto Werdmüller</persName>.</note>, <lb xml:id="p1z39"/><persName ref="p1278">Gastium</persName>, reliquos.</s>
					<s n="29" xml:lang="la">Miror, quid sit, quod <lb xml:id="p1z40"/>scribebas de universitate<note xml:id="fn14" type="footnote" n="14">Siehe oben <ref target="file11239">Nr. 1196</ref>, 10-19.</note>.</s>
					<s n="30" xml:lang="la">Scribe, obsecro, et me amare pergi<lb xml:id="p1z41"/>to.</s>
					<s n="31" xml:lang="de">3. decembris 1538.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><lb xml:id="p1z43"/><persName ref="p495">H. Bullingeru</persName>s tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="33" xml:lang="la"><pb/><lb xml:id="p2z1"/>Suo d. <persName ref="p8418">Myconio</persName>, <lb xml:id="p2z2"/>fratri charissimo.</s>
					<s n="34" xml:lang="la"><lb xml:id="p2z3"/>An herren <lb xml:id="p2z4"/><persName ref="p8418">Myconium</persName>.</s>
				</p>
			</div>
