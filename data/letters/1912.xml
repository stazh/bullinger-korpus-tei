	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Binas tuas accepi cum <persName ref="p3375">Vergerii</persName> literis et <lb xml:id="p1z2"/>libellis, que omnia perlubenter vidi; in hoc enim <lb xml:id="p1z3"/>bellorum et occupationum tumultu nihil est, <lb xml:id="p1z4"/>quod magis me recreet.</s>
					<s n="3" xml:lang="la">Non possum ergo <lb xml:id="p1z5"/>non infinitas tibi agere gratias.</s>
					<s n="4" xml:lang="la">Si quid <lb xml:id="p1z6"/>sit novi, poteris legere ex memoriali <lb xml:id="p1z7"/>hic inserto.</s>
					<s n="5" xml:lang="la">Cetera autem audiemus <lb xml:id="p1z8"/>postea; nam rex parat magnum exercitum, <lb xml:id="p1z9"/>et interea Caesar moribundus expectat <lb xml:id="p1z10"/>filium, qui nondum est <placeName>Genę</placeName>, tentat <lb xml:id="p1z11"/>tamen transitum, ut a nostris audio, <lb xml:id="p1z12"/>et suus est scopus, ut ab <placeName ref="l834">Italia</placeName> statim <lb xml:id="p1z13"/>in <placeName ref="l822">Germaniam</placeName> descendat ad imperium <lb xml:id="p1z14"/>occupandum.</s>
					<s n="6" xml:lang="la">Inde ille regis <persName ref="p18477">Romanoru<lb xml:id="p1z15"/>m</persName> <lb xml:id="p1z16"/>practice cum principibus, et <lb xml:id="p1z17"/>habeas pro certo illa non fieri nec impediri insciis nobis.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z18"/>Quid ad comitia <placeName>Ulmensia</placeName>, in quibus <persName ref="p18538">Cęsar</persName> <lb xml:id="p1z19"/>promittit se in persona fore, sunt <lb xml:id="p1z20"/>artes <placeName ref="l875">Hispanice</placeName>.</s>
					<s n="8" xml:lang="la">Hoc stratagemate <lb xml:id="p1z21"/>vult retinere <placeName ref="l822">Germanos</placeName> sub virga <lb xml:id="p1z22"/>timentes adventum domini, cuius <lb xml:id="p1z23"/>persona est bona fide deplorata et <lb xml:id="p1z24"/>merum cadaver.</s>
					<s n="9" xml:lang="la">Noster conventus finem habet, <lb xml:id="p1z25"/>et quia nostri milites incipiunt properare, <lb xml:id="p1z26"/>cogor <placeName ref="l760">Soludurum</placeName> et <placeName ref="l160">Friburgum</placeName> versus tendere.</s>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Inde sepius tibi scribam et a te vicissim <lb xml:id="p2z2"/>expectabo aliquid.</s>
					<s n="11" xml:lang="la"><persName ref="p3207">Rex Anglie</persName> melius <lb xml:id="p2z3"/>habet, adhuc tamen iacet in lecto.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z4"/>Dominus <persName ref="p3375">Vergerius</persName> scribit se brevi rediturum; mihi <lb xml:id="p2z5"/>sane pergratum esset, si eum videre possem, antequam <lb xml:id="p2z6"/>suos montes peteret.</s>
					<s n="13" xml:lang="la" ana="farewell">Bene vale et nos <lb xml:id="p2z7"/>ama.</s>
					<s n="14" xml:lang="la">Datum <placeName ref="l21">Badde</placeName> 28a iunii.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z8"/>Tuus se<lb xml:id="p2z9"/>mper <persName ref="p8296">Bas[safonta<lb xml:id="p2z10"/>neus]</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z11"/>Dominus cardinalis <persName>Belleyus</persName> mih<lb xml:id="p2z12"/>i e <placeName ref="l425">Roma</placeName> scripsit; <lb xml:id="p2z13"/>bene habet et t<lb xml:id="p2z14"/>e amat.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
