	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scribam dominis, que de mutatione regni intellexi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Obiit <persName>Franciscus 5</persName>. huius mensis sero; ei successit frater <persName>Carolus</persName> <lb xml:id="p1z3"/>bone indolis, administrationi regni commissi mater et <placeName ref="l1209">Navarre</placeName> <lb xml:id="p1z4"/>rex.</s>
					<s n="4" xml:lang="la">Sperant boni omnes pacatiora omnia.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute"><lb xml:id="p1z5"/>Salutabis meis verbis dominos et senatum amplissimum <lb xml:id="p1z6"/>et amicos omnes nosque amabis.</s>
					<s n="7" xml:lang="la"><placeName ref="l760">Solut[uri]</placeName> 15. decembris.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Tuus <lb xml:id="p1z7"/>ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Rumor est habitatores vallis <persName>Angrone</persName> <lb xml:id="p1z8"/>oppressos a <placeName>Sabaudo</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Intellex<lb xml:id="p1z9"/>i etiam <lb xml:id="p1z10"/><persName>Philebertum</persName> marchionem <placeName ref="l572">Badensem</placeName> redeuntem <lb xml:id="p1z11"/><placeName ref="l496">Stutgardia</placeName> occupasse monasterium Herrenalba vocatum <lb xml:id="p1z12"/>et undecim praetores ex pagis vicinis coniecisse in carcerem, <lb xml:id="p1z13"/>ex quibus quatuor mortui sunt.</s>
					<s n="11" xml:lang="la">Itaque princeps <placeName ref="l572">Wirtembergicus</placeName> <lb xml:id="p1z14"/>tanquam monasterii eius defensor duo signa et quadringentos <lb xml:id="p1z15"/>equites conscripsit marchioni <persName>Wolfgangus</persName>, ordinis teutonici magister <lb xml:id="p1z16"/>se ei adiungit, nec eum affinis <placeName>Bavarus</placeName> deseret.</s>
					<s n="12" xml:lang="la">Sperant aliqui <lb xml:id="p1z17"/><placeName>Palatinum</placeName> et lantgravium de reconciliatione acturos.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Si quid de eo <lb xml:id="p1z18"/>intellexeris et aliis rebus, mihi signifficabis.</s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori vigila<lb xml:id="p2z3"/>ntissimo.</s>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="de"><placeName ref="l587">Zurch</placeName>.</s>
				</p>
			</div>
		</body>
