	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia et pax a deo per dominum nostrum Iesum Christum.</s>
					<s n="2" xml:lang="la">Cum mihi pręter <lb xml:id="p1z2"/>opinionem et voluntatem meam diutius <placeName ref="l512">Tubingę</placeName> manendum sit, volui <lb xml:id="p1z3"/>ad te scribere statum rerum nostrarum, ne quid nobis adversi accidisse putares.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Pervenimus quinto, postquam a vobis discessimus, die <placeName ref="l512">Tubingam</placeName> et crastino, <lb xml:id="p1z5"/>qui dies sabbati erat, <placeName ref="l496">Stutgardiam</placeName> abiimus.</s>
					<s n="4" xml:lang="la">Illic nobis manendum <lb xml:id="p1z7"/>fuit in quintum usque diem.</s>
					<s n="5" xml:lang="la">Princeps humaniter nos excepit, atque cum e<lb xml:id="p1z8"/>o d. <persName ref="p3375">Vergerius</persName> bis collocutus est absque interprete; bene enim et expedite Latina <lb xml:id="p1z9"/>lingua loquitur.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Petiit princeps a d. <persName ref="p3375">Vergerio</persName>, ut confessionem a legatis <lb xml:id="p1z10"/>eius concilio <placeName ref="l1107">Tridentino</placeName> exhibitam in linguam Italicam transferat.</s>
					<s n="7" xml:lang="la">Itaque <lb xml:id="p1z11"/>nunc <placeName ref="l512">Tubingę</placeName> manemus, donec excudatur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Habitamus apud <lb xml:id="p1z12"/>humanissimum atque doctissimum virum d. <persName ref="p8113">Me[l]chiorem Volmarium</persName>.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>D. <persName>comes Georgius</persName> ante adventum nostrum <placeName ref="l496">Stutgardia</placeName> <placeName ref="l411">Richenwilum</placeName> <lb xml:id="p1z14"/>abiit; literas tamen tuas per nuncios principis ad eum transmisi.</s>
					<s n="10" xml:lang="la">De <lb xml:id="p1z15"/>d. <persName ref="p974">Molinęo</persName> d. <persName ref="p3375">Vergerius</persName> cum principe locutus est; is invitat <lb xml:id="p1z16"/>eum <placeName ref="l512">Tubingam</placeName> et honestam conditionem profitendi iuris offert, <lb xml:id="p1z17"/>aut si id nolit, relinquit ei liberum, ut in <placeName ref="l327">Monte Beliardi</placeName> habitet.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z18"/>Scripsit etiam ipse <persName ref="p974">Molinęus</persName> ad principem, quas literas princeps <lb xml:id="p1z19"/>legendas exhibuit d. <persName ref="p3375">Vergerio</persName>.</s>
					<s n="12" xml:lang="la"><persName ref="p458">Brentio</persName> literas tuas dedi.</s>
					<s n="13" xml:lang="la">Cum eo etiam <lb xml:id="p1z20"/>d. <persName ref="p3375">Vergerius</persName> de multis articulis controversis locutus est; verum <persName ref="p458">Brentius</persName> <lb xml:id="p1z21"/>mihi in multis simulator esse visus est.</s>
					<s n="14" xml:lang="la">Promisit se <placeName ref="l512">Tubingam</placeName> ad nos <lb xml:id="p1z22"/>venturum; quod tamen an facturus sit, nescio; si venerit, plura colloquemur.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z23"/>Hęc habui, quę ad te scriberem brevi; copiosius coram omnia exponam.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z24"/>Dominus servet vos omnes incolum<lb xml:id="p1z25"/>es.</s>
					<s n="17" xml:lang="la"><placeName ref="l512">Tubingę</placeName> 4. iunii.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z26"/>Tui semper ex animo observantissimus filius <lb xml:id="p1z27"/><persName ref="p8442">Iosias Simlerus</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vigilantissimo <placeName ref="l587">Tigurinę</placeName> ecclesie pastori <lb xml:id="p2z2"/>d. <persName ref="p495">Heinricho Bullingero</persName>, domino <lb xml:id="p2z3"/>et patri meo dilecto.</s>
				</p>
				<p>
					<s n="20" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
