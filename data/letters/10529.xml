			<zone xml:id="p4z4-0" points="1206,1794 1286,1776 1323,1792 1360,1775 1439,1805 1526,1803 1549,1789 1572,1798 1572,1716 1526,1704 1460,1709 1446,1696 1399,1714 1375,1700 1327,1723 1280,1700 1206,1725">1215,1764 1240,1761 1266,1758 1292,1758 1318,1757 1343,1756 1369,1755 1395,1755 1421,1755 1447,1755 1472,1755 1498,1755 1524,1755 1550,1755 1576,1755</zone>
