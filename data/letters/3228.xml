	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Filium tuum, charissime et doctissime vir, avide expecto, <lb xml:id="p1z2"/>illum expassis non tantum ulnis, verum etiam paterno <lb xml:id="p1z3"/>affectu tractabo et amplectar, neque dubites de mea <lb xml:id="p1z4"/>erga te fide et integritate.</s>
					<s n="2" xml:lang="la">morum enim suavitas, quam <lb xml:id="p1z5"/>omnes in te praedicant, et religionis similitudo, qua <lb xml:id="p1z6"/>utrique lectamur, faciunt, ut te impensius diligam.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>novi enim te perpessum permagnos laborum fluctus <lb xml:id="p1z8"/>et passurum etiam maximas negociorum undas et <lb xml:id="p1z9"/>tempestates, quibus tantum non submerguntur, qui <lb xml:id="p1z10"/>Christum et non se ipsos querunt.</s>
					<s n="4" xml:lang="la">Sed malo <lb xml:id="p1z11"/>hunc meum erga te animum re ipsa quam verbis <lb xml:id="p1z12"/>declarare.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z13"/>Res <placeName ref="l736">Pedemontanas</placeName> temporius te scire arbitror quam me, <lb xml:id="p1z14"/>quod minus longe absis.</s>
					<s n="6" xml:lang="la">Gallum magna victorię <lb xml:id="p1z15"/>fundamenta in <placeName ref="l736">Pedemontanis</placeName> iecisse ferunt.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>in <placeName ref="l834">Italia</placeName> refrixerunt aliquot diebus res <placeName ref="l832">Gallicę</placeName>, <lb xml:id="p1z17"/>presertim quod ad <placeName ref="l994">Neapolitanum</placeName> regnum attinet; <lb xml:id="p1z18"/>sed iam omnia iterum fervere et igniri d[icuntur].</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z19"/>Pontifex enim, incarnatus ille diabolus, magnis <lb xml:id="p1z20"/>exactionibus ingentem pecunię acervum congessit.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z21"/>Quare subministrare furię pabulum on desinit.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z22"/><persName ref="p18554">Rex Anglię</persName> magnum exercitum in <placeName ref="l808">Belgas</placeName> convocat; <lb xml:id="p1z23"/>ille ab <placeName>Hatstet</placeName> cum 12 peditum vexillis in <placeName ref="l808">Belgas</placeName> <lb xml:id="p1z24"/>venit, hunc brevi sequetur <persName>Pemelbergus</persName>; <placeName ref="l1041">Brun<lb xml:id="p1z25"/>svicensis</placeName> illuc ducet equitatum, ut putant, <lb xml:id="p1z26"/>3000 superantem.</s>
					<s n="11" xml:lang="la">Tota <placeName ref="l20">Inferior Germania</placeName> annonę <lb xml:id="p1z27"/>charitate, intolerabilibus exactionibus, domestico <lb xml:id="p1z28"/>milite et inquisitionis tyrannide misere affligitur.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z29"/>De <placeName ref="l882">Ungaria</placeName> nihil certi audeo scribere.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Concionatores <lb xml:id="p1z30"/>et plures principes quid <placeName ref="l157">Frankforti</placeName> sint acturi, nescitur <lb xml:id="p1z31"/>adhuc.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Vale, mi <persName ref="p495">Bullingere</persName>, et d. <persName ref="p1283">Gesnerum</persName> saluta.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z32"/><placeName ref="l18">Augustę</placeName> 28. iunii anno <lb xml:id="p1z33"/>etc. <lb xml:id="p1z34"/>57.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z35"/><persName ref="p2856">Geryon</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo atque pientissimo <lb xml:id="p2z2"/>viro d. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> ecclesię antistiti dignissimo, <lb xml:id="p2z4"/>domino et fratri colendissimo<lb xml:id="p2z5"/>.</s>
					<s n="18" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zurch</placeName>.</s>
				</p>
			</div>
