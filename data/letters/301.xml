					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Habeo iustam quaerelam contra tuam coniugem, <lb xml:id="p1z2"/>dilecte et colendissime vir, <persName ref="p8418">Myconi</persName>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Venit <lb xml:id="p1z4"/>illa <placeName ref="l587">Tigurum</placeName> et sero me accedens dumtaxat salutavit, <lb xml:id="p1z5"/>invitata item ad coenam non venit, <lb xml:id="p1z6"/>mane discessit.</s>
					<s n="4" xml:lang="la">Itaque nihil officii in illam <lb xml:id="p1z7"/>contuli; verum ipsa in culpa est.</s>
					<s n="5" xml:lang="la">Ideo conqueror <lb xml:id="p1z8"/>et ita factum eius interpretor: non venit, <lb xml:id="p1z9"/>ne, dum <placeName ref="l28">Basilęam</placeName> descendo, ipse ad te veniam.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Praeterea quod scribam, non habeo, <lb xml:id="p1z11"/>nisi quod multus sermo est <persName ref="p7295">Müssium</persName> latronem <lb xml:id="p1z12"/>apparare exercitum et naves, quibus <lb xml:id="p1z13"/>regis <placeName ref="l425">Romani</placeName> nomine occupet <placeName ref="l2626">Constantiam</placeName>, quam <lb xml:id="p1z14"/>Caesar modis omnibus repellit a pacificatione <lb xml:id="p1z15"/>istis interim perseverantibus et <persName ref="p18538">Caesari</persName> bene faventibus.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>Utinam fallantur, qui arbitrantur illam vim mu<lb xml:id="p1z17"/>ltis non fore ingratam.</s>
					<s n="8" xml:lang="la">Utinam <lb xml:id="p1z18"/>vero non <lb xml:id="p1z19"/>capiat <placeName ref="l2626">Constantiam</placeName> vel <persName ref="p7295">Mussius</persName> <lb xml:id="p1z21"/>latro vel <persName ref="p7295">Madruschius</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Video Helvetiae ex <lb xml:id="p1z22"/>ea urbe mala conglomerari ingentia.</s>
					<s n="10" xml:lang="la">Sed <lb xml:id="p1z23"/>sic forte fata volunt.</s>
					<s n="11" xml:lang="la">Oremus dominum pro <lb xml:id="p1z24"/>innocentibus <placeName ref="l2626">Constantiensibus</placeName>, imo et pro nobis <lb xml:id="p1z25"/>ipsis; nostra res agitur, proximi dum paries <lb xml:id="p1z26"/>ardet<note xml:id="fn1" type="footnote" n="1">Vgl. <hi><persName ref="p19882">Horaz</persName>,</hi> Epistulae, 1, 18, 84.</note>.</s>
					<s n="12" xml:lang="la">Dominus servet ecclesiam suam.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vale.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z27"/>Plura non potui; expecto tuas.</s>
					<s n="15" xml:lang="la">Salvi <lb xml:id="p1z28"/>sint omnes viri boni et uxor tua.</s>
					<s n="16" xml:lang="la">Octobris <lb xml:id="p1z29"/>13. 1548.</s>
					<s n="17" xml:lang="la">Commendatum scio tibi esse <lb xml:id="p1z30"/><persName ref="p1214">Frisium</persName> nostrum.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z31"/>Tuus <lb xml:id="p1z32"/><persName ref="p495">H[einrychus] B[u<pb/><lb xml:id="p2z1"/>llingerus]</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="19" xml:lang="la">D. <persName ref="p8418">Osvaldo Myconio</persName>, <lb xml:id="p2z2"/>colendo <lb xml:id="p2z3"/>suo fratri.</s>
					<s n="20" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
