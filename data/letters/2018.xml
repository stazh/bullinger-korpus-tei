	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia Christi tecum.</s>
					<s n="2" xml:lang="la">A <persName ref="p8406">Chunrado Lycosthene</persName> omnia, quę <lb xml:id="p1z2"/>remisisti, salva et integra 10. septembris per <persName ref="p3932">Westhemerum</persName>, <lb xml:id="p1z3"/>quem nuper in episcopum <placeName ref="l491">Argentinensem</placeName> inauguravi, <lb xml:id="p1z4"/>recepi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Princeps novis rumoribus mirabiliter adfectus <lb xml:id="p1z5"/>est; utinam inde fieret melior illorumque, qui perierunt, <lb xml:id="p1z6"/>clade disceret resipiscentiam sibique subiectos in tanta <lb xml:id="p1z7"/>rerum omnium charitate tonderet, non degluberet etc.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Exigit 3m ab ista parva republica florinorum etc.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Humanitatem, quam erga me hactenus prę se ferebat, <lb xml:id="p1z10"/>mutans caperata fronte alienatum declarat.</s>
					<s n="6" xml:lang="la">Ducitur, <lb xml:id="p1z11"/>ne dicam, seducitur ab iis, qui nec Christi nec <lb xml:id="p1z12"/>reipublicae bonum cogitant.</s>
					<s n="7" xml:lang="la">Tu, mi frater, ora dei filium, <lb xml:id="p1z13"/>ne illius gloria avarorum rapacitate intereat atque <lb xml:id="p1z14"/>ut ego liberer in hora bona.</s>
					<s n="8" xml:lang="la">Sufficit enim mihi.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>Si discedere cogor, erit forte angulus, in quem me re<lb xml:id="p1z16"/>cipiam vel, hoc quod potissimum opto, cęlum, ubi mansiones <lb xml:id="p1z17"/>multę sunt.</s>
					<s n="10" xml:lang="la">Rursum ora pro me, ne videam mala, <lb xml:id="p1z18"/>quę nobis videntur ingruere.</s>
					<s n="11" xml:lang="la">Raptim.</s>
					<s n="12" xml:lang="la"><placeName ref="l411">Richenvillę</placeName> <lb xml:id="p1z19"/>1<lb xml:id="p1z20"/>9. septembris 1553.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/>T[uus] <pb/><lb xml:id="p2z1"/><persName ref="p1010">Erbius</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Eximio eruditione <lb xml:id="p2z2"/>et pietate viro d. <lb xml:id="p2z3"/><persName ref="p495">Henrycho Bullingero</persName>, <lb xml:id="p2z4"/><placeName ref="l587">Tigurino</placeName> antistiti, <lb xml:id="p2z5"/>suo domino <lb xml:id="p2z6"/>et fratri in Christo <lb xml:id="p2z7"/>observando.</s>
				</p>
			</div>
		</body>
	</text>
