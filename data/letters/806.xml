	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Tu vero, mi <persName ref="p495">Bulingere</persName>, si quid in me contulisti, primum scito Christo te <lb xml:id="p1z2"/>id pręstitisse; deinde, quoad potero, operam dabo, si aliquando respiraro, <lb xml:id="p1z3"/>ut eum me erga te esse sentias, ne te operę tuę unquam pęniteat.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z4"/>Non erit ab re, si huic <placeName ref="l1936">Brixiano</placeName>, optimo viro, rescripseris; <lb xml:id="p1z5"/>plurimum enim valet in his partibus auctoritate et gratia seque exhibet <lb xml:id="p1z6"/>in Christi servos favorabilem ac propitium.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Litteras illas consola<lb xml:id="p1z7"/>torias, quas <persName ref="p8101">Lelius</persName> noster <placeName ref="l1098">Florentiam</placeName> transmiserat, nondum accepi.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Deus enim ita voluit, ut tantum in ipso consolationem accipere<lb xml:id="p1z9"/>.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Novi, quod ad te scribam, nihil habeo; in his enim sum locis, quo tardissime <lb xml:id="p1z11"/>omnia perferuntur.</s>
					<s n="6" xml:lang="la">Tu si quid habueris de <placeName ref="l830">Anglia</placeName>, fac nos, amabo, certiores; <lb xml:id="p1z12"/>verum ea omnia iampridem antea animo conceperam ita fore.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/><placeName ref="l425">Romanensis</placeName> illi conspiratio aliquid monstri alit.</s>
					<s n="8" xml:lang="la">De <persName ref="p6122">Rainaldo <lb xml:id="p1z14"/>Polo</persName> in antichristum eligendo frequentior est fama.</s>
					<s n="9" xml:lang="la" ana="farewell">Tu interim <lb xml:id="p1z15"/>vale meque ames.</s>
					<s n="10" xml:lang="la">Datum ex agro <placeName ref="l1936">Brixiano</placeName> idibus ianuariis <lb xml:id="p1z16"/>1550.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z17"/>Tui observantissimus <lb xml:id="p1z18"/><persName ref="p152">Balthasar Alterius</persName>.</s>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietate et eruditione ornatissimo <lb xml:id="p2z2"/>domino <persName ref="p495">Henryco Bulingero</persName> in <lb xml:id="p2z3"/>domino mihi admodum colendo<lb xml:id="p2z4"/>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
