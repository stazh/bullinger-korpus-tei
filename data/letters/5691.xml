	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Valde doleo, colende domine et frater carissime, prae<lb xml:id="p1z2"/>reptam nobis esse istius festinatione intempestiva <lb xml:id="p1z3"/>tantam occasionem pacis solidae stabilisque constituendae.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Vereor enim plurimum ne ista durabilis sit <lb xml:id="p1z5"/>futura.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Quando vero aliter fieri non potest, orandus est <lb xml:id="p1z6"/>nobis dominus, ut ille morbis istis hominum sive <lb xml:id="p1z7"/>inertia sive malitia inductis medeatur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Caussa haec <lb xml:id="p1z8"/>domini est.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Sine huius nutu nihil fit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Vult ille haud <lb xml:id="p1z9"/>dubie ita exercere fidem et patientiam nostram.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Ac videmus iam ab annis 40 et amplius mirifice deum <lb xml:id="p1z11"/>nostrum caussam illam religionis et promovisse in <lb xml:id="p1z12"/>mundo et defendisse.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Non deerit nobis invocantibus <lb xml:id="p1z13"/>nomen eius.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Mirum vero illud est, quod et <placeName>Namursiu<lb xml:id="p1z14"/>s</placeName> mortuos deserere non vult, quibus indivulse <lb xml:id="p1z15"/>adhaesit viventibus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">O quanto nebulonum pondere levatur <lb xml:id="p1z16"/><placeName ref="l832">Gallia</placeName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Miraculum est igens, quod tempore ad<lb xml:id="p1z17"/>modum brevi tot sublati sunt hostes evangelii graves.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z18"/>Non frustra evenere haec.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Favet adhuc <placeName ref="l832">Galliae</placeName> dominus <lb xml:id="p1z19"/>qui huiusmodi eam liberat monstris.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Benedicet <lb xml:id="p1z20"/>ei etiam suo tempore plenius.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Ipsi gloria.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Caeterum <lb xml:id="p1z21"/>meo et omnium fratrum nomine tibi gratias ago, qui et pacis <lb xml:id="p1z22"/>conditiones, et de rebus omnibus tam diligenter scripseris.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z23"/>Omnibus enim nobis rem fecisti gratissimam.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z24"/>Utinam brevi scribere detur faustiora.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Sed et nos <lb xml:id="p1z25"/>et res nostrae omnes sunt in manu domini dei nostri.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z26"/>Quid factum sit in causa <persName ref="p4037">Zanchi</persName> <placeName ref="l491">Argentinae</placeName> intelliges rectius <lb xml:id="p1z27"/>ex ipsius literis.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Mihi videtur vir bonus paulo <lb xml:id="p1z28"/>imprudentius egisse, et nimium dedisse et hostibus et com<lb xml:id="p1z29"/>positoribus etc.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Ex <placeName ref="l834">Italia</placeName> scribitur mortuos esse praecipuos <lb xml:id="p1z30"/>legatos concilii <placeName ref="l1107">Tridentini</placeName> Mantuanum, <placeName ref="l1107">Tridentinum</placeName> et <placeName>Seripandum</placeName>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z31"/>Patres concilii vehementer dissidere, dum hi papam volunt <lb xml:id="p1z32"/>subiicere concilio, alii praeferre, ut qui non sit ab <lb xml:id="p1z33"/>ullo iudicandus.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Sessionem illos in 22. aprilis distulisse <lb xml:id="p1z34"/>scribit <persName ref="p8079">Iulius Mediolanensis</persName>.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><persName ref="p2054">Comes Martinengus</persName> <lb xml:id="p1z35"/>scribit cardinalem <placeName ref="l691">Lotharingum</placeName> moestum et equis citis <lb xml:id="p1z36"/>per <placeName ref="l736">Pedemontium</placeName> rediisse in <placeName ref="l832">Galliam</placeName>, <placeName ref="l522">Venetos</placeName> vehementer <lb xml:id="p1z37"/>ob interitum <placeName>Guysii</placeName> lugere.</s>
				</p>
				<p>
					<s n="27" xml:lang="la">Mercatores nostri <lb xml:id="p1z38"/><placeName ref="l157">Franckforto</placeName> nondum rediere; quidam quidem rediere, <lb xml:id="p1z39"/>sed qui nihil observarunt; <persName ref="p1227">Froschouerum</persName> his diebus <lb xml:id="p1z40"/>expectamus.</s>
				</p>
				<p>
					<s n="28" xml:lang="la">Quam vero cuperem occasionem dari nobis <lb xml:id="p1z42"/>consequendi istius antiqui calycis <placeName ref="l232">Oenipontani</placeName><note xml:id="fn1" type="footnote" n="1"><placeName ref="l232">Innsbruck</placeName>.</note>, qui carmina <lb xml:id="p1z43"/>illa pia exhibet, de quibus mihi iucundam historiam <lb xml:id="p1z44"/>in tuis refers literis.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><placeName ref="l2472">Poloni</placeName> dicuntur graviter <pb/><lb xml:id="p2z1"/>urgeri a <placeName>Moscis</placeName>.</s>
					<s n="30" xml:lang="la">Dominus liberet eos et potius quidem <lb xml:id="p2z2"/>ab <persName ref="p1936">Lysmanninis</persName>, <persName ref="p7955">Blandratistis</persName> et aliis Italicis <lb xml:id="p2z3"/>monstris!</s>
					<s n="31" xml:lang="la">Satis multa rursus ad te de his scribit <lb xml:id="p2z4"/>piissimus vir <persName ref="p8511">Tretius</persName>; si quid ergo potes, fac vel <lb xml:id="p2z5"/>in gratiam tot piorum in <placeName ref="l2472">Polonia</placeName> virorum.</s>
				</p>
				<p>
					<s n="32" xml:lang="la">Operam <lb xml:id="p2z6"/>et impensam non perdes.</s>
				</p>
				<p>
					<s n="33" xml:lang="la">Dominus benedicat tibi <lb xml:id="p2z7"/>et servet te nobis diu incolumem!</s>
					<s n="34" xml:lang="la" ana="salute">Filii mei, gen<lb xml:id="p2z8"/>eri, affines, fratres et symmystae omnes et uni<lb xml:id="p2z9"/>versa domus mea te salutat reverenter.</s>
				</p>
				<p>
					<s n="35" xml:lang="la">Recude[tur] <lb xml:id="p2z10"/>mox mea responsio data ultimo <persName ref="p458">Brentio</persName>; si quid <lb xml:id="p2z11"/>mutandum videtur, quaeso significes in tempore.</s>
				</p>
				<p>
					<s n="36" xml:lang="la">Ubi <lb xml:id="p2z12"/>enim librum te accepisse ex tuis intellexi, spero te obiter inspexisse.</s>
				</p>
				<p>
					<s n="37" xml:lang="la" ana="farewell"><lb xml:id="p2z13"/>Optime vale, domine mi et frater.</s>
				</p>
				<p>
					<s n="38" xml:lang="la" ana="salute">Saluta fratres et amicos, <persName ref="p8078">Ionvilleum</persName> imprimis.</s>
				</p>
				<p>
					<s n="39" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 17. aprilis 1563.</s>
				</p>
				<p>
					<s n="40" xml:lang="la"><lb xml:id="p2z14"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="41" xml:lang="la">Clarissimo viro d. <persName ref="p540">Ioanni Calvino</persName>, <placeName ref="l167">Genevensis</placeName> ecclesiae fidelissimo <lb xml:id="p2z15"/>pastori, <lb xml:id="p2z16"/>domino honorando et frat<lb xml:id="p2z17"/>ri longe charissimo meo.</s>
				</p>
				<p>
					<s n="42" xml:lang="de"><placeName ref="l167">Genff</placeName>.</s>
				</p>
