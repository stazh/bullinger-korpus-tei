	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Observande pat<lb xml:id="p1z2"/>er, S. <persName>Philippus</persName> parat expeditionem contra nostros <lb xml:id="p1z3"/>in <placeName ref="l640">Flandria</placeName>, et iam appulerunt <placeName ref="l1121">Genuam</placeName> <lb xml:id="p1z4"/>septem millia <placeName ref="l875">Hispanorum</placeName>; hybernabunt in <lb xml:id="p1z5"/>ducatu <placeName ref="l306">Mediolanensi</placeName> primo vere profectur<lb xml:id="p1z6"/>i in <placeName ref="l640">Flandriam</placeName>.</s>
					<s n="2" xml:lang="la">In dies etiam expectatur <lb xml:id="p1z7"/><persName>Philippus</persName>.</s>
					<s n="3" xml:lang="la">quę certa sunt scribo, <lb xml:id="p1z8"/>reliqua relinquo vulgo.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Propter persecutionem, quę fervet in <placeName ref="l834">Italia</placeName>, <lb xml:id="p1z10"/>subinde aliqui ad nos confugiunt.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Valemus omnes; precor deum ut te quoque et <lb xml:id="p1z12"/>omnes filios diu conservet.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l93">Cl[aven<lb xml:id="p1z13"/>nae]</placeName> 12. decembris 66.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>T[<lb xml:id="p1z15"/>uus] <persName ref="p4037">H[i<lb xml:id="p1z16"/>eronymus] <lb xml:id="p1z17"/>Z[an<lb xml:id="p1z18"/>chus]</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Misissem et ad te et ad reliquos fratres, qui me <lb xml:id="p1z19"/>soliti estis novis vestris lucubrationibus donare, <lb xml:id="p1z20"/>exemplaria aliquot mei libri grati animi <lb xml:id="p1z21"/>ergo; sed nullum adhuc ad me missum <lb xml:id="p1z22"/>est.</s>
					<s n="10" xml:lang="la">Bonam ergo meam voluntatem amplectimini.</s>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo <lb xml:id="p2z2"/>viro <lb xml:id="p2z3"/>d. <persName ref="p495">Henr[ico] Bullingero</persName>, <lb xml:id="p2z4"/>ecclesię <placeName ref="l587">Tigurinę</placeName> patri <lb xml:id="p2z6"/>dignissimo et observandissimo.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
