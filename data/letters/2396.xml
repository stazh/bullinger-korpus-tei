	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salutem et pacem a domino.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Quum essem apud d. <persName ref="p540">Calvinum</persName> nostrum et sese <lb xml:id="p1z3"/>peropportune obtulisset hic tabellarius, <lb xml:id="p1z4"/>bina illa exemplaria nostri libelli <lb xml:id="p1z5"/>una cum his literis commisi, ex quibus <lb xml:id="p1z6"/>intelliges, ut spero, quanta sit adversariorum <lb xml:id="p1z7"/>impudentia et qua diligentia sit <lb xml:id="p1z8"/>illis occurrendum.</s>
					<s n="3" xml:lang="la">Quantuluscunque autem noster <lb xml:id="p1z9"/>hic labor est, spero eum tibi non ingratum <lb xml:id="p1z10"/>fore et te vehementer rogo, ut, <lb xml:id="p1z11"/>quaecunque in eo repereris animadversione <lb xml:id="p1z12"/>digna, ea seorsim paucis annotata (siqui<lb xml:id="p1z13"/>dem tibi tantum sit otii), ad me mittas, <lb xml:id="p1z14"/>ut tuus ille labor, quem in eo legendo <lb xml:id="p1z15"/>capies, mihi saltem usui esse possit.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z16"/>Sed de his hactenus.</s>
					<s n="5" xml:lang="la">Literas tuas ad 10. <lb xml:id="p1z17"/>iulii datas nudiustertius accepi, quibus <lb xml:id="p1z18"/>mihi <placeName ref="l2">Aroviensem</placeName> quendam iuvenem <lb xml:id="p1z19"/>commendas.</s>
					<s n="6" xml:lang="la">Eum ego, mi pater, <lb xml:id="p1z20"/>vel quia abs te erat <lb xml:id="p1z21"/>commendatus, u<lb xml:id="p1z22"/>bi, <lb xml:id="p1z23"/>quibuscunque rebus potero ipsius studia <lb xml:id="p1z24"/>et pietatem sane libenter et cupide <lb xml:id="p1z25"/>adiuvabo, rogoque, ut tibi perusadeas <lb xml:id="p1z26"/>nihil mihi iucundius accidere <lb xml:id="p1z27"/>posse, quam si commodam aliquam occasionem <lb xml:id="p1z28"/>habuero gratum meum in te animum declar<lb xml:id="p1z29"/>andi.</s>
					<s n="7" xml:lang="la">Novi nunc quidem nihil habeo ex <lb xml:id="p1z30"/><placeName ref="l832">Gallia</placeName>; audisti enim pridem, quam misere <lb xml:id="p1z31"/>in <placeName>Arthesios</placeName> et <placeName ref="l640">Flandros</placeName> Gallus noster <lb xml:id="p1z32"/>tyrannus saevierit.</s>
					<s n="8" xml:lang="la">Nunc non dubito, quin totus <lb xml:id="p1z33"/>sit <persName>Caesar</persName> in vindicandis iniuriis.</s>
					<s n="9" xml:lang="la">Hac autem hyeme, <pb/><lb xml:id="p2z1"/>si verum est, quod aiunt, eadem incendia aut <lb xml:id="p2z2"/>crudeliora constituit rex in ecclesiam exercere.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z3"/>Tu si quid de comitiis illis <placeName ref="l749">Saxonicis</placeName> <lb xml:id="p2z4"/>et <placeName ref="l18">Augustanis</placeName> audieris, quod nostra intersit, <lb xml:id="p2z5"/>ut sciamus, rogo, ut ad nos perscribas <lb xml:id="p2z6"/>et studium nostrum crebris tuis literis ad <lb xml:id="p2z7"/>precandum exacuas et incendas.</s>
					<s n="11" xml:lang="la" ana="farewell">Bene <lb xml:id="p2z8"/>vale, mi pater.</s>
					<s n="12" xml:lang="la">Dominus Iesus te tueri et <lb xml:id="p2z9"/>confirmare pergat, tibi <lb xml:id="p2z10"/>benedicat teque ecclesiae suae conservet.</s>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p2z11"/>D. <persName ref="p8011">Gvaltherum</persName> et totam ecclesiam rogo <lb xml:id="p2z12"/>ut meo nomine diligenter salutes.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z13"/><placeName ref="l167">Genevae</placeName> 18. septembris.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><persName ref="p8033">Th[eod<lb xml:id="p2z14"/>orus] Beza</persName>, filius tibi <lb xml:id="p2z15"/>in domino addictissimus.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z16"/>Cuperem <placeName ref="l28">Basilienses</placeName> serio admonitos, ut hanc <lb xml:id="p2z17"/>cloacam in tempore repurgarent.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z18"/>Exi<lb xml:id="p2z19"/>mio Christi s<lb xml:id="p2z20"/>ervo d. <persName ref="p495">Henrico <lb xml:id="p2z21"/>Bullingero</persName>, patr<lb xml:id="p2z22"/>i mihi observa<lb xml:id="p2z23"/>ndissimo et fide<lb xml:id="p2z24"/>lissimo <placeName ref="l587">Tigurinae</placeName> ecclesi<lb xml:id="p2z25"/>ae pastori.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
