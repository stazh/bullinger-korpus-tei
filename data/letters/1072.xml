	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Quia commodissimus hic se mihi tabel
					<lb xml:id="p1z2"/>obtulit d. Ioannes Fabritius pietate ete
					<lb xml:id="p1z3"/>uditione clarus et ideo mihi imo nobis omnibus
					<lb xml:id="p1z4"/>charissime nolui illam negligere occasionem. crib
					<lb xml:id="p1z5"/>itaque hec qualiacunque ne nihil omnino sciri
					<lb xml:id="p1z6"/>;Deest enim argumentum te dignum. Quod
					<lb xml:id="p1z7"/>enim de rebus nostris scribere poteram fabrim
					<lb xml:id="p1z8"/>multo expeditius narrabit, qui rerum
					<lb xml:id="p1z9"/>nostrarum nihil nescit. Res nostrae deo gratia
					<lb xml:id="p1z10"/>habent. Scripsi nuper ad te ac dec
					<lb xml:id="p1z11"/>sermoni nostrorum quartam nisi, nec d
					<lb xml:id="p1z12"/>qun acceperis. Quod interea nulla
					<lb xml:id="p1z13"/>ate accepi tribuo tabellariorum raritati
					<lb xml:id="p1z14"/>et senio tuo morbis et aegritudinibus observan
					<lb xml:id="p1z15"/>Alliquid tamen nunc rerum tuarum narrabi
					<lb xml:id="p1z16"/>Fabritio vel eidem schedulami saltem aliqud
					<lb xml:id="p1z17"/>quam dabis; Tuis enim delector; nam i
					<lb xml:id="p1z18"/>pense te propter pietatem et integritatem
					<lb xml:id="p1z19"/>lgo. Dominus benedicat tibi et servet
					<lb xml:id="p1z20"/>in aeternum.
					<lb xml:id="p1z21"/>Tiguri 8. novembris 155.
					<lb xml:id="p1z22"/>Salutant te fratres.
					<lb xml:id="p1z23"/>Saluta d. Rhegium et aliou
					<lb xml:id="p1z24"/>fratres ac anno
					<lb xml:id="p1z25"/>Commendo autem hunc tibi
					<lb xml:id="p1z26"/>Fabritium tanquam me ipsum
					<lb xml:id="p1z27"/>Bullingerus tuus.
					<pb/>
					<lb xml:id="p2z1"/>Praestantissimo viro d.
					<lb xml:id="p2z2"/>Matthiae Erbior
					<lb xml:id="p2z3"/>Rchevylensis ecclesia
					<lb xml:id="p2z4"/>pastori fidelissimo, domino
					<lb xml:id="p2z5"/>fratri suo
					<lb xml:id="p2z6"/>colendissimo et charissimo
					<lb xml:id="p2z7"/>Beychenwyler.
				</p>
			</div>
		</body>
	</text>
