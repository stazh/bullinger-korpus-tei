	<text xml:lang="de">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Das Jahr ergibt sich aus dem Briefinhalt.</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Hasce literas<note xml:id="fn2" type="footnote" ana="bio" n="2">Vielleicht ein Brief des Bürgermeisters <persName ref="p1888">Hans Rudolf Lavater</persName> im Anschluss an den Brief der <placeName ref="l587">Zürcher</placeName> Pfarrer Nr. 2745 vom 10. Januar in Zusammenhang mit der Weigerung von <persName ref="p1888">Lavaters</persName> Sohn <persName ref="p1884">Ludwig</persName>, am Abendmahl teilzunehmen.</note> d. <persName ref="p467">Bucero</persName> primo quoque <lb xml:id="p1z2"/>tabellioni et certo quidem tradas, oro, <placeName ref="l491">Argentinam</placeName> <lb xml:id="p1z3"/>perferendas.</s>
					<s n="3" xml:lang="la" ana="salute">Poteris id commode per a<lb xml:id="p1z4"/>rchigrammateum<note xml:id="fn3" type="footnote" n="3">Der <placeName ref="l28">Basler</placeName> Stadtschreiber <persName ref="p2804">Heinrich Ryhiner</persName>.</note>, comunem amicum nostrum, perficere, <lb xml:id="p1z5"/>quem et salutabis.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="4" xml:lang="la">D. <persName ref="p8049">Vadianus</persName> scribit<note xml:id="fn4" type="footnote" n="4">In einem nicht erhaltenen Brief, den <persName ref="p495">Bullinger</persName> dem <persName ref="p8055">Ambrosius Blarer</persName> zum Lesen weiterleitete; s. <ref target="file12823">Nr. 2774</ref>,34f.</note> <placeName ref="l1121">Ianuae <lb xml:id="p1z6"/>(Genow)</placeName><note xml:id="fn5" type="footnote" n="5"><placeName ref="l1121">Genua</placeName>.</note> tumultuatum esse multo cum sanguine <lb xml:id="p1z7"/>et transfixum quidem conto <persName ref="p4649">Ianingne de <lb xml:id="p1z8"/>Doria</persName><note xml:id="fn6" type="footnote" n="6">Graf <persName ref="p4649">Giannettino Doria</persName>; s. Nr. 2759, Anm. 49.</note>, <persName ref="p18538">caesaris</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p18538">Karl V.</persName></note> officialem, <pb type="edition" next="185"/> occubuisse, conto autem <lb xml:id="p1z9"/>de <persName ref="p4782">Flisco</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p4782">Gian Luigi Fieschi</persName>.</note>, papisticum et seditionis authorem <lb xml:id="p1z10"/>coniectum in vincula, confiteri, quod <persName ref="p19981">pontifi<lb xml:id="p1z11"/>ci</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p19981">Paul III.</persName></note> <lb xml:id="p1z12"/>voluerit <placeName ref="l1121">Ianuam</placeName> occupare et tradere.</s>
					<s n="5" xml:lang="la">Haec <lb xml:id="p1z13"/>retulit, qui<note xml:id="fn10" type="footnote" n="10">Unbekannt.</note> hisce diebus e <placeName ref="l306">Mediolano</placeName> venit.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Quod si verum est, novit forte papa caesarem <lb xml:id="p1z15"/><placeName ref="l3559">Stygias</placeName> profectum ad undas<note xml:id="fn11" type="footnote" n="11">Stygias undas: Der Fluss <placeName ref="l3559">Styx</placeName> in der Unterwelt, der die Grenze zum Totenreich (Hades) bildet.</note> a <persName ref="p18817">Nerone</persName><note xml:id="fn12" type="footnote" n="12"><persName ref="p18817">Nero</persName>, <placeName ref="l425">römischer</placeName> Kaiser von 54 bis 68, bekannt (wie auch die hier nachfolgend angeführten römischen Kaiser) als Verfolger der Christen.</note>, <lb xml:id="p1z16"/><persName ref="p18462">Domiciano</persName><note xml:id="fn13" type="footnote" n="13"><persName ref="p18462">Domitian</persName>, <placeName ref="l425">römischer</placeName> Kaiser von 81 bis 96.</note>, <persName ref="p20046">Diocletiano</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p20046">Diokletian</persName>, <placeName ref="l425">römischer</placeName> Kaiser von 284 bis 305.</note> et <persName ref="p19186">Iuliano</persName><note xml:id="fn15" type="footnote" ana="bio" n="15"><persName ref="p19186">Julian, gen. Apostata</persName>, <placeName ref="l425">römischer</placeName> Kaiser von 361 bis 363.</note> artes disce<lb xml:id="p1z17"/>re, quomodo herbescens evangelium extinguat; <lb xml:id="p1z18"/>quod tam verum vellem, quam constanter a multis ass<lb xml:id="p1z19"/>everatur.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="7" xml:lang="de">Zuͦ <lb xml:id="p1z20"/><placeName ref="l513">Ulm</placeName> gadts übel.</s>
					<s n="8" xml:lang="de">Di<lb xml:id="p1z21"/>e <lb xml:id="p1z22"/><placeName ref="l875">hispanier</placeName> und <placeName ref="l834">Italier</placeName> thuͦnd wie ir bruch.</s>
					<s n="9" xml:lang="de"><lb xml:id="p1z23"/>Gott erbarm sich der armen lüten!</s>
					<s n="10" xml:lang="de">Keyser hatt <lb xml:id="p1z24"/>gester<note xml:id="fn16" type="footnote" n="16">Er traf am Abfassungstag des vorliegenden Briefes in <placeName ref="l513">Ulm</placeName> ein; s. Nr. 2754, Anm. 18.</note> ynryten soͤllen.</s>
					<s n="11" xml:lang="de">Sagend wol, er lig imm holtz.<note xml:id="fn17" type="footnote" n="17">im Holz liegen: Ein längerer Bettaufenthalt im warmen Zimmer, verbunden mit einer Fastenkur, oft bei Syphilis angewandt; s. <bibl source="b18">HBBW XV</bibl> 147, Anm. 15. Vgl. ferner <bibl source="b19">HBBW XVI</bibl> 177 mit Anm. 18.</note></s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="12" xml:lang="de"><lb xml:id="p1z25"/>Sampstags<note xml:id="fn18" type="footnote" n="18">D.h. am 22. Januar.</note> ist mir üwer <lb xml:id="p1z27"/>schriben<note xml:id="fn19" type="footnote" n="19"><persName ref="p8418">Myconius</persName>' Brief vom 20. Januar (<ref target="file12810">Nr. 2761</ref>).</note> von unserm <persName ref="p6435">loͤuffer</persName><note xml:id="fn20" type="footnote" n="20">Sehr wahrscheinlich <persName ref="p6435">Melchior Schlosser</persName>. Zu seiner Entsendung nach <placeName ref="l28">Basel</placeName> um diese Zeit s. Zürich StA, F III 32, Seckelamtsrechnungen 1546/47, S. 65 der Ausgabenabteilung für laufende Boten.</note> worden.</s>
					<s n="13" xml:lang="de">Des<lb xml:id="p1z28"/>selben tags habend min herren ußgenomen<note xml:id="fn21" type="footnote" ana="lex" n="21">einberufen.</note> <lb xml:id="p1z29"/>zuͦ irem stattpaner und fenli<note xml:id="fn22" type="footnote" n="22">Das Banner und das Fähnlein stehen für größere bzw. kleinere Truppenabteilungen.</note>: Acht man<lb xml:id="p1z30"/>, dem fenli 2000 man, der paner <lb xml:id="p1z32"/>6000.<note xml:id="fn23" type="footnote" n="23">Richtig: 4000 Mann, wie aus der in Zürich StA, A 29.1 (Kriegs- und Reissachen), Aktenbündel Nr. 11, unter dem 22. Januar 1547, überlieferten Liste hervorgeht, in der die Zusammenstellung des damals einbezogenen Banners überliefert ist. - Ein entsprechende Liste für das Fähnlein ist nicht erhalten.</note></s>
					<s n="14" xml:lang="de">Und diewyl die vogthien <placeName ref="l774">Durgoͤw</placeName><note xml:id="fn24" type="footnote" n="24"><placeName ref="l774">Thurgau</placeName>.</note> <lb xml:id="p1z33"/>und <placeName ref="l1003">Sargans</placeName> an <placeName ref="l587">Zürych</placeName>, werdint sy da <lb xml:id="p1z34"/>ouch ußnemmen<note xml:id="fn25" type="footnote" ana="lex" n="25">ausheben, mustern.</note> sampt andern, die minen herren <lb xml:id="p1z35"/>mitt burgraͤcht<note xml:id="fn26" type="footnote" n="26">Das Burgrecht war eine staatsrechtlich bedeutende Verbindung städtischer Gemeinwesen durch Verträge und Bündnisse; s. <bibl source="b590">SI</bibl> VI 297. - In dem oben in Anm. 23 angeführten Aktenbündel Nr. 11 sowie in Zürich StA, A 30.3, Nr. 153f, und B IV 17, f. 210r.-211r., befinden sich mehrere Dokumente im Zusammenhang mit den damaligen Musterungen in den Vogteien und Herrschaften der <placeName ref="l803">Landschaft Zürich</placeName>.</note> und pflicht verwandt: ouch ettwan in <lb xml:id="p1z37"/>2000.</s>
					<s n="15" xml:lang="de"><lb xml:id="p1z38"/><persName ref="p3493">Bernhart von Cham</persName>,<note xml:id="fn27" type="footnote" n="27">Zu dieser Ernennung s. schon <bibl source="b21">HBBW XVIII</bibl> 18f.</note> <lb xml:id="p1z39"/>ein <lb xml:id="p1z40"/>trüw, redlich man, houptman; <persName ref="p8436">Anderes <lb xml:id="p1z41"/>Schmid</persName>,<note xml:id="fn28" type="footnote" n="28"><persName ref="p8436">Andreas Schmid (Faber)</persName>.</note> vast trostlich,<note xml:id="fn29" type="footnote" n="29">vast trostlich: sehr nützlich (im Kriegsfall); s. <bibl source="b590">SI</bibl> XIV 1429f.</note> panerher; der allt m. <persName ref="p6544">Schwy<lb xml:id="p1z42"/>zer</persName><note xml:id="fn30" type="footnote" ana="bio" n="30"><persName ref="p6544">Rudolf Schwyzer</persName>. - Der Vorname (wie auch der der unten aufgeführten Personen) wurde anhand der oben in Anm. 23 erwähnten Liste ergänzt. - Da <persName ref="p6544">Rudolf Schwyzer</persName> hier mit "m." bezeichnet wird, handelt es sich vermutlich um den Zunftmeister zur Zimmerleuten, gest. am 8. März 1564; s. <hi>Schnvder, Ratslisten 605.</hi></note> vortrager<note xml:id="fn31" type="footnote" n="31">Adjutant des Fähnrichs; s. <bibl source="b590">SI</bibl> XIV 538.</note>; m. <pb type="edition" next="186"/> <persName ref="p6793">Dumysen</persName><note xml:id="fn32" type="footnote" n="32"><persName ref="p6793">Itelhans Thumysen</persName>.</note> schützenhouptmann; <lb xml:id="p1z43"/>m. <persName ref="p5273">Holtzhalb</persName><note xml:id="fn33" type="footnote" n="33"><persName ref="p5273">Hans Holzhalb</persName>.</note> schützenfenrych; <persName ref="p20538">Heinrych Lochman</persName> <lb xml:id="p1z44"/>vortrager<note xml:id="fn34" type="footnote" n="34"><persName ref="p20538">Heinrich Lochmann</persName>, als Vortrager des "schützenfenrich" laut der oben in Anm. 23 angeführten Liste.</note>; seckelmeister <persName ref="p6157">Heinrych Raan</persName><note xml:id="fn35" type="footnote" n="35"><persName ref="p6157">Heinrich Rahn</persName>.</note>, der al<lb xml:id="p1z45"/>lt, houptman <lb xml:id="p1z46"/>zum fenly; m. <persName>Heinryc<lb xml:id="p1z47"/>h Kramer</persName><note xml:id="fn36" type="footnote" ana="bio" n="36">Es kommen folgende Personen in Frage: 1) <persName ref="p20884">Heinrich Kramer</persName>. gest. 28. Januar 1552, 1532 Zunftmeister zur Schmiden, Natalrat 1532-1552; 2) <persName ref="p21155">Heinrich Kramer</persName>, gest. 2. Juni 1559, Metzger, 1542 Zunftmeister zum Widder, Natalrat 1542 bis 1546, 1547-1553 Vogt zu <placeName ref="l187">Grüningen</placeName>, Baptistalrat 1553-1558. - <persName ref="p21156">Heinrich Kramer</persName>, Hufschmied, geb. 15. April 1529, gest. 13. Oktober 1594, Natalrat 1586-1594, der erst viel später Zunftmeister zur Schmiden wurde, ist hier kaum gemeint. - Lit.: <bibl source="b577">Schnyder, Ratslisten</bibl> 571; <bibl source="b196">Dütsch, Landvögte</bibl> passim.</note> <lb xml:id="p1z48"/>fenrych; <persName ref="p5681">Rodolff Lochman</persName><note xml:id="fn37" type="footnote" ana="bio" n="37"><persName ref="p5681">Rudolf Lochmann</persName>, geb. 1510, gest. am 20. April 1557. Zunftmeister zur Schiffleuten, im Natalrat von 1554 bis 1557; s. <bibl source="b577">Schnyder, Ratslisten</bibl> 591.</note> vortrager; <persName ref="p5435">Balt<lb xml:id="p1z49"/>azar Kaͤller</persName><note xml:id="fn38" type="footnote" ana="bio" n="38">Möglicherweise handelt es sich um <persName ref="p20885">Balthasar Keller</persName>, gest. 11. Februar 1554, der von 1529 bis 1540 als Zunftmeister der Schneidern im Kleinen Rat saß. 1547 erneut Ratsherr, später Fraumünsterammann; s. Christa <hi>Koppel,</hi> Von der Äbtissin zu den gnädigen Herren. Untersuchungen zu Wirtschaft und Verwaltung der Fraumünsterabtei und des Fraumünsteramts in Zürich 1418-1549, Zürich 1991, S. 92; <bibl source="b577">Schnyder, Ratslisten</bibl> 309, obere Anm. 1.</note> sc<lb xml:id="p1z50"/>hützen zum fenlihouptman.</s>
					<s n="16" xml:lang="de"><lb xml:id="p1z51"/>Hütt ordnet man wacht und provandtmeister, zuͦ <lb xml:id="p1z52"/>den spiessen, helmbarten houptlüt,<note xml:id="fn39" type="footnote" n="39">Die Namen der Wachtmeister sowie der Hauptleute zu den Spießen bzw. den Hellebarden sind in der oben in Anm. 23 erwähnten Liste angeführt.</note> item gen <placeName ref="l489">Stein am <lb xml:id="p1z53"/>Rhyn</placeName><note xml:id="fn40" type="footnote" n="40">Siehe dazu das auf den 31. Januar 1547 datierte und an den <placeName ref="l587">Zürcher</placeName> Rat gerichtete Schreiben aus <placeName ref="l489">Stein am Rhein</placeName>, das im oben Anm. 23 angeführten Aktenbündel Nr. 11 erhalten geblieben ist.</note> und anderschwo hin houptlüt.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="17" xml:lang="de"><lb xml:id="p1z55"/>Gott mitt uns.</s>
					<s n="18" xml:lang="la">Valeat et <persName ref="p1278">Gastius</persName>.</s>
					<s n="19" xml:lang="la">25. ianuarii.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z56"/><persName ref="p495">Bullinger</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="21" xml:lang="de"><pb/><lb xml:id="p2z2"/>An herren <persName ref="p8418">Oßwalden <lb xml:id="p2z3"/>Myconien</persName> oder in sinem <lb xml:id="p2z4"/>abwaͤsen an herren <persName ref="p1278">Hansen <lb xml:id="p2z5"/>Gasten</persName>, predicanten <lb xml:id="p2z6"/>zuͦ <lb xml:id="p2z7"/><placeName ref="l28">Basel</placeName>.<note xml:id="fna" type="footnote" n="a"><hi>Anmerkung von anderer Hand als Überschrift für ein Briefbündel:</hi> <persName ref="p495">Bullingeri</persName> ad d. <persName ref="p8418">Myconium</persName>, pastorem <placeName ref="l28">Basiliensem</placeName>, literae <placeName ref="l28">Basilaea</placeName> remissae. - <hi>Diese Briefe wurden nach <persName ref="p8418">Myconius</persName>' Ableben von <persName ref="p495">Bullinger</persName> zurückgefordert; s. Henrich, Myconius BW 80.</hi></note></s>
				</p>
			</div>
		</body>
	</text>
</TEI>