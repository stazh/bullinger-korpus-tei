	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Cum hoc vesperi (reverende in Christo pater) accepissem <lb xml:id="p1z3"/>literas idemque alii affirmarent, mihi autem exscribere <lb xml:id="p1z4"/>haec non vacaret, ipsum autographum mittendum putavi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z5"/>Spero autem te iam recte valere, ita ut non periculum <lb xml:id="p1z6"/>sit, ne te literis meis obtundam.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Cum hic esset <persName ref="p1770">Gorgus <lb xml:id="p1z7"/>Carlin</persName> mihique narraret cardinalem <placeName ref="l1107">Tridentinum</placeName> <lb xml:id="p1z8"/>furiis correptum (ertoubet) duos catenis constringi <lb xml:id="p1z9"/>(dubitabat tamen, uter esset, senior an iunior), ecce <lb xml:id="p1z10"/>astabat summus noster tribunus, cui hodie nomine <lb xml:id="p1z11"/>civitatis negotium fuit cum episcopo, qui itidem <lb xml:id="p1z12"/>affirmabat episcopum haec eadem dixisse, et sit ad <lb xml:id="p1z13"/>eum perscriptum eoque amplius, quod pontifex esset m<lb xml:id="p1z14"/>edius mortuus (sic Itali loquuntur megmort), <foreign xml:lang="de">das <lb xml:id="p1z15"/>ist halb unentpfindtlich etc.</foreign></s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z16"/>Haec subito multa nocte.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell">Vale, reverende <lb xml:id="p1z17"/>in Christo pater.</s>
					<s n="6" xml:lang="la">9. martii 1563.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">T[uus] <persName ref="p8009">F[abricius</persName>].</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>domino et patri <lb xml:id="p2z4"/>suo in Christo <lb xml:id="p2z5"/>reverendo.</s>
				</p>
				<p>
					<s n="9" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zurych</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
