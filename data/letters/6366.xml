	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi literas tuas, charissime frater; audivi item d. <lb xml:id="p1z2"/><persName ref="p5497">Franciscum</persName> de variis disserentem, comperio autem <lb xml:id="p1z3"/>nos versari in extremis.</s>
					<s n="3" xml:lang="la">Te quidem illa torquent, <lb xml:id="p1z4"/>me et alios eadem et alia quoque excarnificant.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Expertus <lb xml:id="p1z5"/>tibi dico, quoquo veneris, te inventurum, quae nolis, <lb xml:id="p1z6"/>denique ea, quae non putasti.</s>
					<s n="5" xml:lang="la">Quo quisque aequi et iuris <lb xml:id="p1z7"/>studiosior est, hoc dolet magis ob res iniquas <lb xml:id="p1z8"/>tanta patratas licentia.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Sed sumus in mundo; cum <lb xml:id="p1z9"/>erimus in coelo, illi s demum carebimus molestiis.</s>
					<s n="7" xml:lang="la">Orandus <lb xml:id="p1z10"/>ergo deus, dum hic vivimus, ipse nos gubernet, <lb xml:id="p1z11"/>sapientiam conferat atque tolerantiam etc.</s>
					<s n="8" xml:lang="la">Librum <lb xml:id="p1z12"/>tuum vixdum degustavi; tot enim negotiis distra<lb xml:id="p1z13"/>hor, ut vix ea possim absolvere, in quibus iam <lb xml:id="p1z14"/>sum annis aliquot.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Scribo in Isaiam et Danielem, <lb xml:id="p1z15"/>ut alia non commemorem.</s>
					<s n="10" xml:lang="la">Accedit senium et <lb xml:id="p1z16"/>tarditas quaedam, ut iam non possim, quod <lb xml:id="p1z17"/>aliquando potui; accedit hominum frequentia <lb xml:id="p1z18"/>tota die accedentium et decedentium; accedit <lb xml:id="p1z19"/>infirmitas virium corporis et nescio <lb xml:id="p1z20"/>quid reliquiarum ex morbo, a quo non prorsus <lb xml:id="p1z21"/>sum liber.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Legam tamen ad primam quamque occasionem <lb xml:id="p1z22"/>et tradam legendum socero tuo et <persName ref="p1884">Ludovi<lb xml:id="p1z23"/>co</persName> meo.</s>
					<s n="12" xml:lang="la">Praeter ea, quae nuper ad te scripsi <lb xml:id="p1z24"/>nihil habeo; <placeName ref="l41">Berna</placeName> nihildum certi est allatum.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z25"/>Nisi vero hoc nescias, significo <placeName ref="l300">Lucernae</placeName> <lb xml:id="p1z26"/>comitia celebranda mensis huius 29.</s>
					<s n="14" xml:lang="la">Conscripta <lb xml:id="p1z27"/>sunt a 7 catholicis illis <placeName>Cantonibus</placeName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Papa <lb xml:id="p1z28"/>aget cum illis de ineundo foedere.</s>
					<s n="16" xml:lang="la"><persName>Lussius</persName> <lb xml:id="p1z29"/>et <persName>Rollius</persName>, uterque ex fama tibi notus, negotium <lb xml:id="p1z30"/>papae agunt.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Audio <persName>Gallum</persName> refragari.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Quid sit <lb xml:id="p1z31"/>nescio; causae multae sunt, cur suspicer male, <lb xml:id="p1z32"/>et sunt, qui affirment, foedus percussum inter <persName>pontificem</persName>, <lb xml:id="p1z33"/><persName>Gallum</persName>, <placeName ref="l522">Venetos</placeName>, <placeName ref="l150">Ferrariensem</placeName> et <placeName ref="l1098">Florentinum</placeName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Gratifi<lb xml:id="p1z34"/>careris ergo plurimum mihi, si, quid sit, a <lb xml:id="p1z35"/>d. legato expiscareris aut saltem tibi ex<lb xml:id="p1z36"/>poneret, quid comitiis illis definiatur; non <lb xml:id="p1z37"/>enim hoc ignorabit.</s>
					<s n="20" xml:lang="la">- Sed titulum non misisti, <lb xml:id="p1z38"/>ex quo discam, quomodo scribam episcopo; scribere enim <lb xml:id="p1z39"/>vel tua caussa institui.</s>
				</p>
				<p>
					<note type="regest">Er lässt den Gesandten grüssen, dessen Brief ihn erfreut hat:</note>
					<s n="21" xml:lang="la">[...] q<lb xml:id="p1z40"/>uamqua<lb xml:id="p1z41"/>m doleam o<lb xml:id="p1z42"/>ptimum virum sic vexari.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Scribam primo quoque <lb xml:id="p1z43"/>tempore.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="farewell">Aeternum vale.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 26. ianuarii 1565.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z44"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantiss. viro d. <persName ref="p8009">Ioann<lb xml:id="p2z2"/>i Fabritio</persName>, curien.</s>
					<s n="27" xml:lang="la"><lb xml:id="p2z3"/>ecclesiae ministro fideliss., <lb xml:id="p2z4"/>domino meo colendo et <lb xml:id="p2z5"/>fratri chariss.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
