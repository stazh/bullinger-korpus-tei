	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. <lb xml:id="p1z2"/>D.</s>
					<s n="2" xml:lang="la">Literas tuas, vir clariss. et colendiss., postremas accepi <lb xml:id="p1z3"/>et in hi<lb xml:id="p1z4"/>s, quas <lb xml:id="p1z5"/>de <persName ref="p7703">Para<lb xml:id="p1z6"/>celsi</persName> <lb xml:id="p1z7"/>rebus ante <lb xml:id="p1z8"/>scripseras, qu<lb xml:id="p1z9"/>ae mi<lb xml:id="p1z10"/>hi a<lb xml:id="p1z11"/>m<lb xml:id="p1z12"/>bae val<lb xml:id="p1z13"/>de g<lb xml:id="p1z15"/>ratae <lb xml:id="p1z16"/>fuer<lb xml:id="p1z17"/>unt.</s>
					<s n="3" xml:lang="la">[...] <lb xml:id="p1z19"/><persName ref="p7703">Paracel<lb xml:id="p1z20"/>si</persName> <lb xml:id="p1z21"/>doctrina non tantum est in philosophia iniqua, in me<lb xml:id="p1z22"/>dicina monstrosa, verum etiam in theologia impia et blasphema.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z23"/>Negat creationem a deo vero perfectam, creatores nostros facit <lb xml:id="p1z24"/>fabros quosdam mortales in astris sedentes, miraculorum potestatem <lb xml:id="p1z25"/>tribuit hominibus, herbis, lapillis, spectris.</s>
					<s n="5" xml:lang="la">Futurorum praevisionem <lb xml:id="p1z26"/>a nescio quo daemone in nos derivat; characteribus, verbis, <lb xml:id="p1z27"/>imaginibus sub certo syderum positu fabricatis vim tribuit <lb xml:id="p1z28"/>plus quam divinam.</s>
					<s n="6" xml:lang="la">Vitam nostram in nostro arbitrio esse, ex dei <lb xml:id="p1z29"/>praefinitione nihil esse, posse eam nos ad iudicium usque extr<lb xml:id="p1z30"/>emum prorogare.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Coelos nequam homines per errorem fabricari, <lb xml:id="p1z31"/>qui boni esse nullo possint modo etc.</s>
					<s n="8" xml:lang="la">Monstra his longe absur<lb xml:id="p1z32"/>diora alia profert.</s>
					<s n="9" xml:lang="la">Omnia ha<lb xml:id="p1z33"/>ec in <lb xml:id="p1z34"/>pr<lb xml:id="p1z35"/>ima p<lb xml:id="p1z37"/>arte <lb xml:id="p1z38"/>confuta<lb xml:id="p1z39"/>tionis so<lb xml:id="p1z40"/>lide re<lb xml:id="p1z41"/>fell<lb xml:id="p1z42"/>e<lb xml:id="p1z43"/>r<pb/><lb xml:id="p2z1"/>e con<lb xml:id="p2z2"/>or <note type="regest">[... es folgen Bemerkungen über den Stand seiner Arbeit und über das Bedürfnis, seine Position von Freunden prüfen zu lassen]</note><lb xml:id="p2z3"/>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z5"/>Ago ingentes gratias, quod mihi <persName ref="p7703">Paracelsum</persName> depinxisti.</s>
					<s n="11" xml:lang="la">Idem fecit <lb xml:id="p2z6"/><persName ref="p8126">Oporinus</persName>, quo usus fuit amanuense per bien<lb xml:id="p2z7"/>nium.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z8"/>Pulch<lb xml:id="p2z9"/>re c<lb xml:id="p2z10"/>onveni[<lb xml:id="p2z11"/>t<lb xml:id="p2z12"/>is?] <lb xml:id="p2z13"/>in omnibus.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z14"/>Magum fuis<lb xml:id="p2z15"/>se et c<lb xml:id="p2z16"/>acodae<lb xml:id="p2z17"/>monis <lb xml:id="p2z18"/>con<lb xml:id="p2z19"/>foed<lb xml:id="p2z20"/>eratu<lb xml:id="p2z21"/>m cer[<lb xml:id="p2z22"/>te?] est<lb xml:id="p2z23"/>."</s>
				</p>
				<p>
					<note>[Rand auf der Kopie nicht lesbar.]</note>
				</p>
			</div>
		</body>
	</text>
