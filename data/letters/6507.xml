	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Tuas accepi, amice et frater charissime.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Similia <lb xml:id="p1z2"/>de <placeName ref="l2523">Melitensium</placeName> insula adferuntur aliunde; sunt tamen, <lb xml:id="p1z3"/>qui spargant <persName ref="p18593">Turcam</persName> accepta clade discessisse; verum <lb xml:id="p1z4"/>procurator non credit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Aestus, qui vos vexat, nos <lb xml:id="p1z5"/>quoque mirum in modum excruciat.</s>
					<s n="5" xml:lang="la">Pestis circum<lb xml:id="p1z6"/>quaque grassari incipit; nemo dum ea apud nos est <lb xml:id="p1z7"/>correptus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">In urbe et agro <placeName ref="l41">Bernensi</placeName> saevit, <placeName ref="l93">Clave<lb xml:id="p1z8"/>nae</placeName> quoque serpit; dominus liberet nos a malo.</s>
					<s n="7" xml:lang="la">Pestem <lb xml:id="p1z9"/>episcopalem perinde timeo; nisi enim dominus sequester <lb xml:id="p1z10"/>fuerit, aegre res sine pugna dirimetur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Res <lb xml:id="p1z11"/>novae nullae sunt; audies multa a d. legato.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Hoc <lb xml:id="p1z12"/>memoratu dignum videtur, quod consul ex comitiis <lb xml:id="p1z13"/>rediens mihi narravit se nullis unquam comitiis <lb xml:id="p1z14"/>interfuisse, in quibus minum fuerit litium; <lb xml:id="p1z15"/>Pagos per omnia fuisse benignos.</s>
					<s n="10" xml:lang="la" ana="farewell">Optime vale cum <lb xml:id="p1z16"/>tuis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Saluta amicos et inprimis d. legatum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z17"/><placeName ref="l587">Tiguri</placeName> 27. iulii 1565.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p495">Bullingerus</persName> tuissimus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Io<lb xml:id="p2z2"/>anni Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae fideli ministro, <lb xml:id="p2z4"/>compatri et fratri meo <lb xml:id="p2z5"/>colendissimo et longe charissimo.</s>
					<s n="15" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
