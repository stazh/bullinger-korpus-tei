	<text xml:lang="de">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Gnad und frid.</s>
					<s n="2" xml:lang="de">Ye laͤnger ich schryb, ye boͤser <lb xml:id="p1z2"/>es wirt.</s>
					<s n="3" xml:lang="de">Gott bessers!</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="4" xml:lang="de">Die von <placeName ref="l513">Ulm</placeName>, die ell<lb xml:id="p1z3"/>enden <placeName ref="l2481">Schwaben</placeName>, habend sich ergaͤben an <lb xml:id="p1z4"/>des <persName ref="p18538">keyssers</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p18538">Karl V.</persName> -Zu <placeName ref="l513">Ulms</placeName> Ergebung s. <ref target="file12783">Nr. 2734</ref>, Anm. 4.</note> gnad!</s>
					<s n="5" xml:lang="de">Und ist ein friden zwü<lb xml:id="p1z5"/>schen inen beredt und beschlossen.<note xml:id="fn2" type="footnote" n="2">Zur Sache s. <bibl source="b21">HBBW XVIII</bibl> 458,7-11; <ref target="file12783">Nr. 2734</ref> und Anm. 6.</note></s>
					<s n="6" xml:lang="de"><lb xml:id="p1z6"/>Sy <pb type="edition" next="78"/> soͤllend blyben by irem glouben biß uff ein <lb xml:id="p1z7"/>consilium.<note xml:id="fn3" type="footnote" n="3">Gemeint ist ein Konzil. Zur Schreibweise "consilium" anstelle von "concilium" s. <bibl source="b19">HBBW XVI</bibl> 169, Anm. 19.</note></s>
					<s n="7" xml:lang="la">Hoc est negare <lb xml:id="p1z8"/>fidem et <lb xml:id="p1z9"/>nebulonibus subiicere iudican<lb xml:id="p1z10"/>dam, <lb xml:id="p1z11"/>imo conculcandam.</s>
					<s n="8" xml:lang="de"><lb xml:id="p1z12"/>Sy soͤllend gar kein püntnus machen <lb xml:id="p1z13"/>nimmerme on erloupnus <lb xml:id="p1z14"/>und vorwüsse<lb xml:id="p1z15"/>n eines keysers.</s>
					<s n="9" xml:lang="la">Hoc est prodere libertatem.</s>
					<s n="10" xml:lang="de"><lb xml:id="p1z16"/>Das lut wider <placeName ref="l862">eydgnosische</placeName> <lb xml:id="p1z17"/>püntnus.<note xml:id="fn4" type="footnote" n="4">Gemeint ist: Das klingt wie gerichtet gegen ein Bündnis mit den <placeName ref="l862">Eidgenossen</placeName>.</note></s>
					<s n="11" xml:lang="de">Wil <lb xml:id="p1z18"/>fürkummen<note xml:id="fn5" type="footnote" n="5">wil fürkummen: soll verhüten, verhindern; s. <bibl source="b590">SI</bibl> III 278 (unten).</note>, <lb xml:id="p1z19"/>das keine mee ge<lb xml:id="p1z20"/>machet oder <lb xml:id="p1z21"/>sy zuͦ uns nitt fründint.<note xml:id="fn6" type="footnote" n="6">einen Freundschaftsbund eingehen; s. <bibl source="b590">SI</bibl> I 1306.</note></s>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/>Periculum, ne <lb xml:id="p1z23"/>aliae urbes quoque sequantur.</s>
					<s n="13" xml:lang="de"><lb xml:id="p1z25"/>Werdent aber hernach trüwlich knistet<note xml:id="fn7" type="footnote" n="7">trüwlich knistet: gehörig geprügelt.</note>, <lb xml:id="p1z26"/><foreign xml:lang="la">ubi scilicet oportunum fuerit.</foreign></s>
					<s n="14" xml:lang="de"><lb xml:id="p1z27"/>Sy habend dem keysser ein gaͤllt<lb xml:id="p1z28"/>straaff erlegt.</s>
					<s n="15" xml:lang="de">Weiß nitt, wie vil.<note xml:id="fn8" type="footnote" n="8">Die Geldstrafe betrug 100000 Gulden; s. <hi>Rommel, Ulm</hi> 80.</note></s>
					<s n="16" xml:lang="de"><lb xml:id="p1z29"/>Ander artikel sind mee vorhanden.</s>
					<s n="17" xml:lang="de"><lb xml:id="p1z30"/>Weiß sy nitt eigentlich.<note xml:id="fn9" type="footnote" n="9">genau. - Siehe dazu <ref target="file12783">Nr. 2734</ref>, Anm. 6.</note></s>
					<s n="18" xml:lang="de">Die oberen <lb xml:id="p1z31"/>sind gewüß.</s>
					<s n="19" xml:lang="de"><lb xml:id="p1z32"/>Das ist ir evan<lb xml:id="p1z33"/>gelium!</s>
					<s n="20" xml:lang="de">Gott erbarms und gaͤbe an<lb xml:id="p1z34"/>deren gnad, das sy sich nitt also ergaͤbend.</s>
					<s n="21" xml:lang="de"><lb xml:id="p1z35"/>Jetzund ist es alles guͦt; hernach <lb xml:id="p1z36"/>wirt es boͤß gnuͦg werden.</s>
					<s n="22" xml:lang="la">Oremus dominum, nam <lb xml:id="p1z37"/>sumus in tentatione gravi.</s>
					<s n="23" xml:lang="de">Wie joch<note xml:id="fn10" type="footnote" n="10">Wie joch: Wie gut auch; s. <bibl source="b590">SI</bibl> III 6.</note> <lb xml:id="p1z39"/>das evangelium gepredget sye, ist der <lb xml:id="p1z40"/>buw<note xml:id="fn11" type="footnote" ana="lex" n="11">Bau.</note> nitt fest.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="24" xml:lang="de"><lb xml:id="p1z41"/><persName ref="p1278">Gastium</persName> beruͤffend.</s>
					<s n="25" xml:lang="de">Gaͤbend imm das brieffli<note xml:id="fn12" type="footnote" n="12">Nicht erhalten.</note> <lb xml:id="p1z42"/>und gaͤllt.</s>
					<s n="26" xml:lang="de">Sind 2 gl. umb die wollen.<note xml:id="fn13" type="footnote" n="13">Die von <persName ref="p1278">Johannes Gast</persName> in <placeName ref="l28">Basel</placeName> gekaufte Wolle im Wert von 2 Gulden; s. <bibl source="b21">HBBW XVIII</bibl> 421. 439. 450f.</note></s>
					<s n="27" xml:lang="de" ana="salute"><lb xml:id="p1z43"/>Gruͤssend mir inn und d. <lb xml:id="p1z44"/><persName ref="p8032">Dryandrum</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p8032">Francisco de Enzinas</persName>, der damals in <placeName ref="l28">Basel</placeName> wohnte.</note>, <lb xml:id="p1z45"/>desse<note xml:id="fn15" type="footnote" n="15">dessen; s. <bibl source="b590">SI</bibl> XIII 1029.</note> brieff<note xml:id="fn16" type="footnote" n="16">Vom 1. Januar 1547 (<ref target="file12785">Nr. 2736</ref>).</note> mir worden.</s>
					<s n="28" xml:lang="de">Kan nitt ant<lb xml:id="p1z46"/>worten.</s>
					<s n="29" xml:lang="de">Habend die ding<note xml:id="fn17" type="footnote" n="17">Die Informationen aus dem vorliegenden Brief.</note> mitt denen gemein.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="30" xml:lang="de"><lb xml:id="p1z47"/>Über acht tag wirt ein tag zuͦ <lb xml:id="p1z48"/><placeName ref="l21">Baden</placeName>.<note xml:id="fn18" type="footnote" n="18">Die <placeName ref="l21">Badener</placeName> Tagsatzung vom 10. Januar; s. <ref target="file12786">Nr. 2737</ref>, Anm. 3.</note></s>
					<s n="31" xml:lang="de"><lb xml:id="p1z49"/>Was habend ir uß <placeName ref="l832">Franck<lb xml:id="p1z50"/>r<lb xml:id="p1z51"/>ych</placeName> und uß dem <placeName ref="l20">Niderland</placeName>?</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="32" xml:lang="de">Gott m<lb xml:id="p1z52"/>itt üch.</s>
					<s n="33" xml:lang="la">2. ianuarii 1547.</s>
					<s n="34" xml:lang="la"><lb xml:id="p1z53"/>Festinavi.</s>
					<s n="35" xml:lang="la"><lb xml:id="p1z54"/>Non relegi.</s>
					<s n="36" xml:lang="la"><lb xml:id="p1z55"/><persName ref="p495">Bullinger</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="37" xml:lang="de"><lb xml:id="p1z56"/>Sin<pb/><lb xml:id="p2z1"/>em lieben herren <lb xml:id="p2z2"/>und bruͦder, h. <lb xml:id="p2z3"/><persName ref="p8418">Oßwalden Myconien</persName>, <lb xml:id="p2z4"/>predicanten zuͦ <lb xml:id="p2z5"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>