	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Accepi tuas, mi venerande et charissime <persName ref="p495">Bullingere</persName>, quas per <persName>Petrum</persName> redditas putabas, <lb xml:id="p1z2"/>deinde annotationes tuas super Interim, quas, ut mihi legerentur, curavi.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Tu vide, ne in quorum libet manus veniant propter quaedam odiosius de <persName>C[aesare]</persName><lb xml:id="p1z4"/>.</s>
					<s n="3" xml:lang="la">Cętera sanae doctrinae prorsus consentiunt.</s>
					<s n="4" xml:lang="la">Remitto nunc et maximas <lb xml:id="p1z5"/>ago gratias, quod communicaveris.</s>
					<s n="5" xml:lang="la">Dedi epistolium per adulescentem <persName>Augustinum</persName>.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/>Ego nondum quicquam possum nec prodeo quoquam languente adhuc capite.</s>
					<s n="7" xml:lang="la"><persName ref="p8474">Onophor<lb xml:id="p1z7"/>us Heurusius</persName> noster, quicquid apud nos est, diligenter tibi exponet.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z8"/>De comitiis vide, ne quid me celes, sed quamprimum ut, quo loco omnia sint, <lb xml:id="p1z9"/>sciam, quę sciri convenit, pro mutuo nostro amore strenue cura.</s>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z10"/>Salveat tua domus cum amicis omnibus.</s>
					<s n="10" xml:lang="la">Optimi senis <persName ref="p6552">Schöneri</persName> literis <lb xml:id="p1z11"/>respondere plane nunc nequeo; sed sorori illius inscriptas reddi curabo.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z12"/>Ora pro me nostraque ecclesia.</s>
					<s n="12" xml:lang="la">Ad scribendi officium brevi spero integer <lb xml:id="p1z13"/>rursus rediero, quandoquidem remittit nonnihil vertigo.</s>
					<s n="13" xml:lang="la">27. Iulii 1548.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z14"/>Tuus <persName ref="p8055">Ambr[osius] Bl[aurerus</persName>].</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z15"/>Quę <placeName ref="l558">Wittenbergenses</placeName> super Interim, vidisti; <lb xml:id="p1z16"/>quę <persName ref="p467">Bucerus</persName> et <placeName ref="l491">Argentoratenses</placeName>, iam <lb xml:id="p1z17"/>hic <persName ref="p8049">Vadiano</persName> nostro describuntur, <lb xml:id="p1z18"/>a quo licebit ut petas.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Bullingero</persName> suo.</s>
					<s n="17" xml:lang="de"><lb xml:id="p2z2"/>Zuͤrich.</s>
				</p>
			</div>
		</body>
	</text>
