	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Vir maxime, ex literis et relatione d. <persName ref="p8009">Fabritii</persName> nostri meas tuae human<lb xml:id="p1z2"/>itati literas non esse redditas facile video.</s>
					<s n="3" xml:lang="la">Scias igitur denuo lib<lb xml:id="p1z3"/>rum a te missum ad filium nostrum <persName ref="p20260">Alexandrum</persName>, quem petieramus, <lb xml:id="p1z4"/>nos illesum accepisse, ornatum etiam, quod maxime avebat filius, <lb xml:id="p1z5"/>tuae manus characteribus sententiae pulcherrimae et gravissimę.</s>
					<s n="4" xml:lang="la">Acce<lb xml:id="p1z6"/>pimus etiam bacios quinque; gratius tamen fuisset, si Sermonum tuo<lb xml:id="p1z7"/>rum aliquem nobis pro illis misisses.</s>
					<s n="5" xml:lang="la">Gratias tamen <lb xml:id="p1z8"/>agimus maximas pro tanta tua humanitate; facis perpetuo, <lb xml:id="p1z9"/>quod te decet, et plus, quam sis ferendo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Sufficiat tibi vires <lb xml:id="p1z10"/>deus ac pater noster caelestis.</s>
					<s n="7" xml:lang="la">Postremas literas, quas ad <persName ref="p8009">Fabriti<lb xml:id="p1z11"/>um</persName> nostrum scripsisti de <persName ref="p2095">Melanchthone</persName>, ille mihi legit.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/>Eum nunc accurrere nobis non miror, sed magis, quod tam diu <lb xml:id="p1z13"/>abfuerit; parum enim literati non facile capiunt, quod de ser<lb xml:id="p1z14"/>monibus et verbis tropicis aut figuratis dicitur (sci enim, quam <lb xml:id="p1z15"/>tardus fuerim ipse ad huiusmodi capessenda); sed vero doctos <lb xml:id="p1z16"/>hoc nolle cognoscere, qualis est <persName ref="p8359">Philippus</persName>, hoc maxime mirum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/>Caterum notabilia, quae scribam, sunt nulla, et si quae essent, <lb xml:id="p1z18"/>satis scribit frater noster <persName ref="p8009">Fabricius</persName>.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale igitur, virorum <lb xml:id="p1z19"/>maxime, et <persName ref="p8359">Philippum</persName> tuum redamare non desi[ne].</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/>Ex <placeName ref="l98">Curia</placeName> <lb xml:id="p1z21"/>die 23. aprilis anni 1559.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/>Tuae humanitatis totus ex animo ut semper <lb xml:id="p1z23"/><persName ref="p8359">Philippus Gallicius</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vere magno viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>bonis omnibus longe <lb xml:id="p2z4"/>colendissimo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tig<lb xml:id="p2z6"/>uri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
