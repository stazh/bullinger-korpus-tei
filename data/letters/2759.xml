	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Vir clarissime, ago tuę pietati magnas gratias, qu<lb xml:id="p1z2"/>od <persName>Gasnerum</persName> placaveris; ego certe praeter <persName>Matt<lb xml:id="p1z3"/>heum</persName> nihil promiseram.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Omnino morosior<lb xml:id="p1z4"/>es sunt aliqui ex fratribus <placeName ref="l167">Genevensibus</placeName> <lb xml:id="p1z5"/>quam vellem.</s>
					<s n="3" xml:lang="la">Nimis prosciderunt <persName ref="p20206">Gribaldum</persName>, nim<lb xml:id="p1z6"/>is late volunt patere eorum iurisdictionem <lb xml:id="p1z7"/>ac fere dominari in ecclesiis.</s>
					<s n="4" xml:lang="la">Vidi qua form<lb xml:id="p1z8"/>a verborum ad me hucusque scripserunt.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Ferendos tamen outo quia vicissim multa <lb xml:id="p1z10"/>sunt in illis laudana.</s>
					<s n="6" xml:lang="la"><persName ref="p20206">Gribaldus</persName> nec verbum <lb xml:id="p1z11"/>faciet, observat quae monuisti, et <lb xml:id="p1z12"/>quae ego adhuc inculcavi.</s>
					<s n="7" xml:lang="la">Sic vincuntur <lb xml:id="p1z13"/>animi, nin asperitate.</s>
					<s n="8" xml:lang="la">Vidisti, opinor, <lb xml:id="p1z14"/>quid <persName ref="p7024">Westphalus</persName> contra <persName ref="p540">Calvinum</persName>.</s>
					<s n="9" xml:lang="la">Utinam <lb xml:id="p1z15"/>is sedatius scripsisset, hoc est, te fuisset <lb xml:id="p1z16"/>aemulatus qui moderatissimam epistolam ad<lb xml:id="p1z17"/>scripseras.</s>
					<s n="10" xml:lang="la">Aliud est contra Antichristum <lb xml:id="p1z18"/>agere, aliud contra Lutheranos.</s>
					<s n="11" xml:lang="la">Nunc multa <lb xml:id="p1z19"/>audio.</s>
					<s n="12" xml:lang="la">Exacerbati animi.</s>
					<s n="13" xml:lang="la">Lasci cons<lb xml:id="p1z20"/>ilium non potuisset incidere in conditionem <lb xml:id="p1z21"/>deteriorem.</s>
					<s n="14" xml:lang="la">Utinamdaret locum <lb xml:id="p1z22"/>foedę tempestati et se in portu contineret.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z23"/>Nullum fuit comitium post renatum evangelium, <lb xml:id="p1z24"/>in quo plura obtinuerint protestantes.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z25"/><persName>Caesar</persName> putavit obsequendum, quum in animo <pb/><lb xml:id="p2z1"/>haberet navigare.</s>
					<s n="17" xml:lang="la">Scis agi conventum infra <placeName ref="l307">Ma<lb xml:id="p2z2"/>guntiam</placeName>, ubi agitur de novo foedere.</s>
					<s n="18" xml:lang="la">Quid dux <lb xml:id="p2z3"/><placeName ref="l2562">Prussiae</placeName> in causa <persName ref="p2301">Osiandrica</persName> statuerit, vide; hoc <lb xml:id="p2z4"/>enim <persName ref="p2095">Melanctonis</persName> consilium inseruit suo decreto.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z5"/>Urget, ut eam ad se; sed vix licebit mihi; <lb xml:id="p2z6"/>nam fratres aliquot Itali, qui deserere <placeName>Babyloniam</placeName> <lb xml:id="p2z7"/>statuerunt, diserte dixerunt se non <lb xml:id="p2z8"/>discessuros, nisi certo sciant fore, ut <lb xml:id="p2z9"/>me inveniant in ducatu saltem, quum primum <lb xml:id="p2z10"/>appulerint.</s>
					<s n="20" xml:lang="la">Hanc vero praedam nolim <lb xml:id="p2z11"/>mea culpa ammitti.</s>
					<s n="21" xml:lang="la">A dabit mihi consilium <lb xml:id="p2z12"/>res et locus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Verti <persName ref="p458">Brentii</persName> librum <lb xml:id="p2z13"/>in <placeName>Asotum</placeName> et nunc excudam alicubi <lb xml:id="p2z14"/>auctum.</s>
					<s n="23" xml:lang="la">Ubi venerit e <placeName ref="l41">Berna</placeName> imago, <lb xml:id="p2z15"/>oro ad me mittite.</s>
				</p>
				<p>
					<s n="24" xml:lang="la" ana="farewell">Vale et salve <lb xml:id="p2z16"/>una cum tribus generis, cum <persName ref="p8011">Gvaltero</persName> <lb xml:id="p2z17"/>atque omnibus symmistis et fratribus.</s>
					<s n="25" xml:lang="la"><lb xml:id="p2z18"/><placeName ref="l412">Reuthlingae</placeName>, pridie kalendas novembris 1555.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p2z19"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf...:]</note>
					<s n="27" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro domino <lb xml:id="p4z2"/><persName ref="p495">[Hei]nrico Bullingero</persName>, <lb xml:id="p4z3"/>[p]astori <placeName ref="l587">Tigurino</placeName>, fra[t]ri <lb xml:id="p4z4"/>honorando.</s>
					<s n="28" xml:lang="la"><lb xml:id="p4z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
