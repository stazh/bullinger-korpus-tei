	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil iam possum, nisi quod tuae <lb xml:id="p1z2"/>mihi redditae sunt una cum <persName ref="p1278">Gastii</persName> literis per <lb xml:id="p1z3"/><persName ref="p4851">Froschouerum</persName> nostrum.</s>
					<s n="3" xml:lang="la">Deinde ora dominum <lb xml:id="p1z4"/>omnia bene vertat.</s>
					<s n="4" xml:lang="la">Res apud nos bene <lb xml:id="p1z5"/>habent; bene spero; bene succedit consultatio; <lb xml:id="p1z6"/>unanimitatem video.</s>
					<s n="5" xml:lang="la">Primum qui<lb xml:id="p1z7"/>dem deputati nostri 8 consultarunt 30. <lb xml:id="p1z8"/>praecedentis mensis et concluserunt, quod velint <lb xml:id="p1z9"/>comitia conscribere.</s>
					<s n="6" xml:lang="la">Hodie scribunt <lb xml:id="p1z10"/><placeName ref="l41">Bernates</placeName> literas amicissimas ac postulant idem, <lb xml:id="p1z11"/>ut comitia conscribantur.</s>
					<s n="7" xml:lang="la">Conscribuntur <lb xml:id="p1z12"/>ergo <placeName ref="l894">4 Urbibus</placeName> <placeName ref="l587">Tigurum</placeName> ad 25. Novembris, <lb xml:id="p1z13"/>ut concludatur unanimis responsio danda <placeName ref="l2542">7 Cantonibus</placeName>.</s>
					<s n="8" xml:lang="la">Ideo <lb xml:id="p1z14"/>adest hic tabellio.</s>
					<s n="9" xml:lang="la">Oremus dominum.</s>
					<s n="10" xml:lang="la" ana="salute">Haec <lb xml:id="p1z15"/>et <persName ref="p1278">Gastio</persName>, quem et saluto.</s>
					<s n="11" xml:lang="la"><placeName ref="l257">Constantia</placeName> est ter <lb xml:id="p1z16"/>misera.</s>
					<s n="12" xml:lang="de">Die erst stür von 100 <lb xml:id="p1z17"/>12 gl.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale.</s>
					<s n="14" xml:lang="la">Ora, ut servemur i<lb xml:id="p1z18"/>n veritate Christi et pace.</s>
					<s n="15" xml:lang="la"><persName ref="p8417">Musculus</persName> a<lb xml:id="p1z19"/>pud nos est, vicinus meus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l587">Tigu<lb xml:id="p1z20"/>ri</placeName> <lb xml:id="p1z21"/>festinantissime 7. <lb xml:id="p1z22"/>Novembris 1548.</s>
				</p>
				<p>
