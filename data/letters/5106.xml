	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>27. decembris 1562.
					<lb xml:id="p1z2"/>D. Pvaldo oro, ut omnium non nominem
					<lb xml:id="p1z3"/>Iudicium breve conscribat, quod indic
					<lb xml:id="p1z4"/>ibus deputatis 2 offerre possit. Iudic
					<lb xml:id="p1z5"/>enim non deserendum esse virum doctum
					<lb xml:id="p1z6"/>et fidelem Christi ministrum, qui propter
					<lb xml:id="p1z7"/>veritatem et maxime cam coenae
					<lb xml:id="p1z8"/>domi paericlitatur, denique, de quo est
					<lb xml:id="p1z9"/>eximia spes plurimum iuvare posse
					<lb xml:id="p1z10"/>ecclesiam, si in hac causa non sucumbati
					<lb xml:id="p1z11"/>ac per aemulos eiiciatur; Si enim eiiciet
					<lb xml:id="p1z12"/>corrumpent et subvertent scholam et
					<lb xml:id="p1z13"/>ecclesiam alioqui afflictam satis.
					<lb xml:id="p1z14"/>Non urgo propositiones has potuisse
					<lb xml:id="p1z15"/>alicubi commodius, si de ea re esset, quaes
					<lb xml:id="p1z16"/>coblocari; At positas interim constat
					<lb xml:id="p1z17"/>ut si non accedat maligia interpretatur.
					<lb xml:id="p1z18"/>reici non possint.
					<lb xml:id="p1z19"/>Propositio prima videtur opponi scholae
					<lb xml:id="p1z20"/>Helianae et coniecturis Osiandri ac
					<lb xml:id="p1z21"/>confermatur verbo domini Marci 13.
					<lb xml:id="p1z22"/>illae, quae sunt scriptae de antichristo et
					<lb xml:id="p1z23"/>ac signis praecedentibus, etsi videant
					<lb xml:id="p1z24"/>aliter et forte sumplitius  xponi
					<lb xml:id="p1z25"/>tu illae non debent, quod studio
					<lb xml:id="p1z26"/>concordandi in spem pugnantes script
					<lb xml:id="p1z27"/>turarum sententias, ea adduxerit
					<pb/>
					<lb xml:id="p2z1"/>Scimus autem in concordandis
					<lb xml:id="p2z2"/>sententiis diversa saepe proponi, at
					<lb xml:id="p2z3"/>interim liberum esse auditoribus sequtn
					<lb xml:id="p2z4"/>quod maxime congrum videtur esse veritati.
					<lb xml:id="p2z5"/>Propositio de necessario damnandis et serv
					<lb xml:id="p2z6"/>dura videtur et si ita undo
					<lb xml:id="p2z7"/>pponeretur populo
					<lb xml:id="p2z8"/>atione proponeretur, quia tamen legimus Ioan
					<lb xml:id="p2z9"/>Propterea credere non potuerunt, quia scrib
					<lb xml:id="p2z10"/>est excaeca 6. Ioanne 10. vos non creditis
					<lb xml:id="p2z11"/>non estis ex onnibus et iterum.
					<lb xml:id="p2z12"/>rapiet etc. Rom 8. quis separabit etc.
					<lb xml:id="p2z13"/>recipienda est sano sensu Crsto.
					<lb xml:id="p2z14"/>Quae de peccato Petru et sanctorum scribit
					<lb xml:id="p2z15"/>adeum modum intelligatur, quo Pauli
					<lb xml:id="p2z16"/>Romn 7 nihil hunc periculi.
					<lb xml:id="p2z17"/>Reliquae theses de praedestinat sanctorum
					<lb xml:id="p2z18"/>fide
					<lb xml:id="p2z19"/>perseverantia, sicuti et expra . Ticos
					<lb xml:id="p2z20"/>cum leganter in Augustino doctore
					<lb xml:id="p2z21"/>atholico, qui et sua firmavit scripi
					<lb xml:id="p2z22"/>non difficile est eam approbare
					<lb xml:id="p2z23"/>Proinde quod initio dixi repeto et
					<lb xml:id="p2z24"/>ora etc.
					<lb xml:id="p2z25"/>Bullingerus.
					<lb xml:id="p2z26"/>d. Martyri
				</p>
			</div>
