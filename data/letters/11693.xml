	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepisti nostra<note xml:id="fn1" type="footnote" n="1">Gemeint ist sicher <persName ref="p8055">Blarers</persName> Brief vom 6. August, oben <ref target="file11691">Nr. 1648</ref>.</note>, puto, mi venerande <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z2"/>quę per illum ipsum bonum virum<note xml:id="fn2" type="footnote" n="2">Unbekannt.</note>, qui tuas nobis literas<note xml:id="fn3" type="footnote" n="3">Ein Brief <persName ref="p495">Bullingers</persName> aus dieser Zeit ist nicht erhalten.</note> <lb xml:id="p1z3"/>reddidit, misimus.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Praeterea nihil est, quod <lb xml:id="p1z4"/>addamus extra illa, quę Erasmus noster<note xml:id="fn4" type="footnote" n="4"><persName ref="p8437">Erasmus Schmid</persName> oder <persName ref="p2810">Erasmus Ritter</persName>.</note> narrare <lb xml:id="p1z5"/>tibi potuit, in quem pariter et optimos viros, quibus <lb xml:id="p1z6"/>facundum se comitem adiunxit, utinam tam humanis et <lb xml:id="p1z7"/>officiosis esse nobis<note xml:id="fna" type="footnote" n="a">nobis <hi>über der Zeile nachgetragen.</hi></note> licuisset, quam sunt illi <lb xml:id="p1z8"/>modis omnibus dignissimi.</s>
					<s n="4" xml:lang="la">Sed omnis fere negata <lb xml:id="p1z9"/>nobis occasio fuit, tum quod retineri se diutius <lb xml:id="p1z10"/>non sunt passi, tum quod <persName ref="p4079">Zviccius</persName> noster<note xml:id="fn5" type="footnote" n="5"><persName ref="p4079">Johannes Zwick</persName>.</note> adesse <lb xml:id="p1z11"/>illis non potuit; quum enim ad quosdam peste cor<lb xml:id="p1z12"/>reptos vocaretur, noluit deinde cum illis congredi, <lb xml:id="p1z13"/>ne quid forte mali (ut serpit hic morbus <lb xml:id="p1z14"/>contagio) affricaret<note xml:id="fn6" type="footnote" n="6">Zum Ausbruch der Pest im Spätsommer 1542 und <persName ref="p4079">Zwicks</persName> Engagement für die Pestkranken v. a. in der Gemeinde <placeName ref="l50">Bischofszell</placeName> vgl. <hi>Moeller,</hi> <persName ref="p4079">Zwick</persName> 233, 243.</note>.</s>
					<s n="5" xml:lang="la">Videtur nos omnino dominus <lb xml:id="p1z15"/>hoc etiam anno quemadmodum superiore castigaturus,<note xml:id="fn7" type="footnote" n="7">1541 bis 1543 wurde <placeName ref="l257">Konstanz</placeName> von drei Pestwellen, die jeweils im Sommer einsetzten, heimgesucht; vgl. <hi>Moeller,</hi> <persName ref="p4079">Zwick</persName> 233.</note> <lb xml:id="p1z16"/>quare illi nos cum tuis christianę[!] commendabis, <lb xml:id="p1z17"/>ut vel vivamus ad ipsius gloriam vel fluxam <lb xml:id="p1z18"/>et evanidam hanc vitam cum ęterna commutemus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z19"/><persName ref="p20318">Brunsvicensis</persName><note xml:id="fn8" type="footnote" n="8">Herzog <persName ref="p20318">Heinrich d.J. von Braunschweig-Wolfenbüttel</persName>.</note> fuga sibi consuluit et ad <lb xml:id="p1z20"/><placeName ref="l619">Baioarię</placeName> opidulum <placeName ref="l276">Landtsperg</placeName> cum paucissimis se <lb xml:id="p1z21"/>contulit<note xml:id="fn9" type="footnote" n="9"><persName ref="p20318">Heinrich</persName> flüchtete mit seinen Söhnen <persName ref="p18720">Karl Viktor</persName> und <persName ref="p20267">Philipp Magnus</persName> sowie seinem Kanzler <persName ref="p20004">Stopler</persName> nach <placeName ref="l276">Landshut</placeName>; vgl. <bibl source="b473">Otto</bibl> von <hi>Heinemann,</hi> Geschichte von Braunschweig und Hannover, Bd. 2, Gotha 1886, S. 360f; <hi>Blume,</hi> Goslar 108; vgl. auch unten <ref target="file11695">Nr. 1652</ref>, 1-7; 1673 (Beilage); 1700, 57f.</note>.</s>
					<s n="7" xml:lang="la">Quid porro futurum sit, expectamus.<pb type="edition" next="162"/></s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z22"/>Salutant te nostri omnes.</s>
					<s n="9" xml:lang="la" ana="salute">Salutabis totam tuam <lb xml:id="p1z23"/>domum cum omnibus fratribus et amicis.</s>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z24"/>Bene vale, suavissime pectus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l257">Constantiae</placeName>, 9. augusti 1542.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z25"/>Tuus <persName ref="p8055">Ambr. Blaurerus</persName>.</s>
				</p>
