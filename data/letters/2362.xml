	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Dedi <persName>Zehendero</persName> annulum, quem misisti, et <lb xml:id="p1z2"/>puto ipsum iam satisfecisse aurifabro.</s>
					<s n="3" xml:lang="la">Remitto <lb xml:id="p1z3"/>ipse quoque tibi acta <placeName ref="l1811">Naumburgensis</placeName> synodi, praeclara s<lb xml:id="p1z4"/>cilicet et digna tantorum virorum conventu.</s>
					<s n="4" xml:lang="la">Hoc nobis <lb xml:id="p1z5"/>inter omnia videtur optimum, quod Zvinglianorum et sa<lb xml:id="p1z6"/>cramentariorum nulla fit inter haereticos mentio.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Det illis dominus, ut agnita veritate propius nobis accedant <lb xml:id="p1z8"/>et modestius de nobis et sentiant et loquantur quam <lb xml:id="p1z9"/><persName ref="p7024">Westphalum</persName> et alius eius farinae plurimi.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quod cladem <lb xml:id="p1z10"/><persName>Senensem</persName> attinet, nondum certi quicquam hic <lb xml:id="p1z11"/>fertur; verentur tamen nostri, ne nimis vera sint illa <lb xml:id="p1z12"/>omnia.</s>
					<s n="7" xml:lang="la">Fatentur quidem <persName>Galli</persName> cladem aliquam accepta<lb xml:id="p1z13"/>m, sed non tantam, praesertim vero <placeName ref="l648">Rhoetos</placeName> pau<lb xml:id="p1z14"/>cos amisisse.</s>
					<s n="8" xml:lang="la">In <placeName ref="l736">Pedemonte</placeName> quoque <persName>Galli</persName> in <lb xml:id="p1z15"/>certamine quodem succubuerunt et non paucos <lb xml:id="p1z16"/>amiserunt, id quod capitaneum <persName ref="p8354">Laetum</persName> ferunt <placeName ref="l760">So<lb xml:id="p1z17"/>lodorum</placeName> scripsisse.</s>
					<s n="9" xml:lang="la">Sic ulciscitur dominus innoxium suorum <lb xml:id="p1z18"/>sanguinem, qui quotidie adhuc per <placeName ref="l832">Gallias</placeName> <lb xml:id="p1z19"/>propter Christi confessionem funditur.</s>
					<s n="10" xml:lang="la">Hi sunt etiam nos<lb xml:id="p1z20"/>trae cum <placeName ref="l832">Gallo</placeName> confoederationis fructus.</s>
					<s n="11" xml:lang="la">Utinam <lb xml:id="p1z21"/><placeName ref="l862">Helvetia</placeName> tandem agnoscat et resipiscat.</s>
					<s n="12" xml:lang="la">Nihil <lb xml:id="p1z22"/>alias nunc apud nos est novi.</s>
					<s n="13" xml:lang="la">Marchionem <persName>Albertum</persName> <lb xml:id="p1z23"/>hac transisse ferunt, sed ignotum.</s>
					<s n="14" xml:lang="la">Febres meae <lb xml:id="p1z24"/>per domini gratiam me relinquunt nec nisi tres con<lb xml:id="p1z25"/>tinuis diebus habui paroxysmos; reliquias tamen <lb xml:id="p1z26"/>adhuc sentio membris admodum lassatis.</s>
					<s n="15" xml:lang="la" ana="salute">Valent <lb xml:id="p1z27"/>recte nostri omnes et vicissim te tuosque salutant.</s>
					<s n="16" xml:lang="la" ana="farewell"><lb xml:id="p1z28"/>Bene vale.</s>
					<s n="17" xml:lang="la"><placeName ref="l41">Bernae</placeName> 18. augusti 1554.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z29"/>Tuus <persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z30"/>Post expulsam <placeName ref="l366">Orbae</placeName> missam, alius adhuc pagus <lb xml:id="p1z31"/>reformationem petit, unde mire insaniunt <placeName ref="l160">Fribur<lb xml:id="p1z32"/>genses</placeName>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino et <lb xml:id="p2z4"/>compatri venerando et charissimo <lb xml:id="p2z5"/>suo.</s>
				</p>
				<p>
					<s n="21" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zürich</placeName>.</s>
					<s n="22" xml:lang="de">M. <lb xml:id="p2z8"/><persName ref="p495">Heinrych Bullingeren</persName>.</s>
				</p>
			</div>
		</body>
