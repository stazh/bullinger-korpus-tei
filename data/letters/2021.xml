	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Filium tuum nuper <placeName ref="l491">Argentinam</placeName> a te ablegatum ad faciendum <lb xml:id="p1z2"/>ingenii cultum nuper excepimus ea, qua tum temporis potuimus <lb xml:id="p1z3"/>humanitate, sed tamen non ea, qua cupiebamus, partim <lb xml:id="p1z4"/>ob duram aeris tempestatem, partim ob celeritatem susceptae <lb xml:id="p1z5"/>peregrinationis.</s>
					<s n="2" xml:lang="la">Omnia tamen, quae apud praeclara <lb xml:id="p1z6"/>videbantur, ostendimus.</s>
					<s n="3" xml:lang="la">Accepi heri ab <persName ref="p8126">Oporino</persName> nostro <lb xml:id="p1z7"/>ex nundinis <placeName ref="l157">Francfordianis</placeName> literas, quibus significat <lb xml:id="p1z8"/>in <placeName ref="l830">Anglia</placeName> omnia esse tumultibus atque intestinis seditionibu<lb xml:id="p1z9"/>s plena; reginam novam crudeliter saevire in <lb xml:id="p1z10"/>evangelicos, quorum multos incarceravit, ex quibus <lb xml:id="p1z11"/><persName ref="p8111">Petrus Martyr</persName>, vir sanctissimus non postremi nominis <lb xml:id="p1z12"/>esse dicitur.</s>
					<s n="4" xml:lang="la"><persName>Caesar</persName> magno iterum conflictu a <placeName ref="l832">Gallo</placeName> <lb xml:id="p1z13"/>victus est.</s>
					<s n="5" xml:lang="la"><persName>Marchio Brandeburgensis</persName>, crudelis <lb xml:id="p1z14"/>ille tyrannus in <placeName ref="l61">Bremensi</placeName> ditione magno cum exercitu <lb xml:id="p1z15"/>pro more suo praedonem agit et gladio vicinis minatur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z16"/><placeName ref="l361">Nurenbergensibus</placeName> mercatoribus in nundinis <placeName ref="l157">Francfordi<lb xml:id="p1z17"/>anis</placeName> aliquot currus intercepit praedamque opinam <lb xml:id="p1z18"/>assecutus est.</s>
					<s n="7" xml:lang="la">Mors episcopi <placeName ref="l28">Basiliensis</placeName> excitavit <lb xml:id="p1z19"/>turbas penes nos; nam <placeName ref="l760">Solodurenses</placeName> audita eius morte cl<lb xml:id="p1z20"/>am praesidium in <placeName ref="l1185">Dornach</placeName> collocarunt, <placeName>Ettingen<lb xml:id="p1z21"/>ses</placeName> rusticos omnes exceptis duobus tantum, qui fuga <lb xml:id="p1z22"/>evaserunt, ceperunt atque in castrum <placeName ref="l1185">Dornach</placeName> abduxerunt.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z23"/>Ceperant et sex ex pago <placeName>Arlesheim</placeName> <placeName ref="l28">B<lb xml:id="p1z24"/>asiliensibus</placeName> ob evangelii praedicationem confoederato; sed <lb xml:id="p1z25"/>a <placeName ref="l28">Basiliensium</placeName> legatis statim liberati sunt.</s>
					<s n="9" xml:lang="la">Missa <lb xml:id="p1z26"/>est a magistratu nostro Solodurum legatio, ut experiatur, <lb xml:id="p1z27"/>quo animo aliena invaserint et quid moliantur.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z28"/>Vereor satis amplam belli suscipiendi contra <placeName ref="l760">Solodurenses</placeName> <lb xml:id="p1z29"/>occasionem datam esse <placeName ref="l28">Basiliensibus</placeName>.</s>
					<s n="11" xml:lang="la">Haec modo tibi, vi<lb xml:id="p1z30"/>r ornatissime, significare quam paucis volui; tu <lb xml:id="p1z31"/>si quid ex <placeName ref="l830">Anglia</placeName> vel aliis orbis partibus habes, <lb xml:id="p1z32"/>communicabis.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l28">Basileae</placeName> 24. septembris anno <lb xml:id="p1z33"/>1553.</s>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z34"/>Salutabis meo nomine <persName ref="p8127">Pellicanum</persName> <lb xml:id="p1z37"/>avunculum, d. <persName ref="p8171">Theodorum</persName> et alios amicos.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">T[uus] <lb xml:id="p1z38"/><persName ref="p8406">Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>pastori, amico <lb xml:id="p2z4"/>summo.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
