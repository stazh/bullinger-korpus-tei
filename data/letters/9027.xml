	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Quo in statu res sint ecclesiae <placeName ref="l832">Gallicae</placeName>, reverende pater, nimium <lb xml:id="p1z3"/>forte cito audivistis atque etiam ex praesenti homine Gallo, quem dominus incolumem <lb xml:id="p1z4"/>servavit, audietis.</s>
					<s n="3" xml:lang="la">Ergo pluribus detinere te nolo; ipse quoque abitum festinat, <lb xml:id="p1z5"/>ut longior esse non possim.</s>
					<s n="4" xml:lang="la">Non hic dubitamus, quin admodum vos omnes <lb xml:id="p1z6"/>miserandus admiralii casus perculit; excitabit procul dubio dominus <lb xml:id="p1z7"/>alios bonos viros; suum enim opus imperfectum non deseret.</s>
					<s n="5" xml:lang="la">Quid apud <lb xml:id="p1z8"/>dominos <placeName ref="l41">Bernenses</placeName> egerit, ex ipso cognosces.</s>
					<s n="6" xml:lang="la">Legati <placeName ref="l832">Gallici</placeName> mirifice fumos <lb xml:id="p1z9"/>vendunt et regem suum purgare conantur, qui tamen tantis sese aspersit maculis, <lb xml:id="p1z10"/>quae aeternum dici non possunt.</s>
					<s n="7" xml:lang="la">Fidat, qui volet, posthac fidei <placeName ref="l832">Gallicae</placeName>.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/>Furere et insanire aiunt regem in fideles Neronis instar, cuius quinquennium <lb xml:id="p1z12"/>absolvit.</s>
					<s n="9" xml:lang="la">Remitto per hunc ea, quae in Acta ad me misisti; <lb xml:id="p1z13"/>caetera quoque, si licet, quaeso, ad me transmitte; arbitror enim hunc mox rediturum.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/>Apud me uxorem debilem cum filiola reliquit.</s>
					<s n="11" xml:lang="la" ana="salute">D. <persName>consul <lb xml:id="p1z15"/>Wittembacchius</persName> te plurimum salutat et, quid spei reliquum sit, ex te cognoscere <lb xml:id="p1z16"/>cupit.</s>
					<s n="12" xml:lang="la">Aroviae aiunt coitura comitia Evangelicorum.</s>
					<s n="13" xml:lang="la">Dominus suae <lb xml:id="p1z17"/>ecclesiae in extremis casibus laboranti subveniat et opem adferat <lb xml:id="p1z18"/>ad gloriam sui nominis.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l49">Bielae</placeName> 17. septembris anno 1572.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z19"/>Christus te nobis diu incolumem servet.</s>
					<s n="16" xml:lang="la">Magnas tibi quoque ago gratias pro <lb xml:id="p1z20"/>libellis, quibus me donasti; utinam aliquando aliquo modo rependere possem.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z21"/>Crebris apud nos micat ignibus aether; annona iterum carior redditur; <lb xml:id="p1z22"/>mensura vini novi batzio venditur.</s>
					<s n="18" xml:lang="la"><placeName ref="l41">Bernenses</placeName> suis prohibuerunt frumenta in <lb xml:id="p1z23"/>foro vendere, ni prius magistratui pro decimis et censibus annuis satis fecerint; vix <lb xml:id="p1z24"/>ergo speram magnam annonae vilitatem, maxime cum fruges aestivae non <lb xml:id="p1z25"/>admodum foeliciter provenerint.</s>
					<s n="19" xml:lang="la" ana="farewell">Item vale et me meosque commen<lb xml:id="p1z26"/>datos habere digneris etc.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z27"/>T[uus] <lb xml:id="p1z28"/>t[otus] <persName ref="p8080">I[osua] V[in<lb xml:id="p1z29"/>slerus]</persName> <placeName ref="l587">T[igurinus]</placeName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae episcopo vigilantissimo, <lb xml:id="p2z4"/>domino et patri suo plurimum <lb xml:id="p2z5"/>observando.</s>
				</p>
				<p>
					<s n="22" xml:lang="de"><lb xml:id="p2z6"/>An m. <persName ref="p495">Heinrych Bullinger</persName> <lb xml:id="p2z7"/><placeName ref="l587">Zürych</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
