			<zone xml:id="p2z32-0" points="1324,3212 1762,3204 2232,3269 2508,3225 2505,3155 2366,3119 2283,3176 1321,3119">1334,3194 1393,3190 1452,3192 1511,3189 1570,3189 1629,3187 1688,3188 1747,3186 1806,3186 1865,3188 1924,3189 1983,3190 2042,3192 2101,3192 2160,3196 2219,3202 2278,3204 2337,3202 2396,3206 2455,3207 2514,3207</zone>
