	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">In absentia d. <persName ref="p8018">Halleri</persName>, compater in domino <lb xml:id="p1z2"/>charissime, Caleb vester, vere et nomine et <lb xml:id="p1z3"/>re cordatus iuvenis, terram electis ac fide<lb xml:id="p1z4"/>libus omnibus promissam feliciter est ingressus.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Suasi <persName>Burckhardo</persName>, ut interea temporis, dum <lb xml:id="p1z6"/>studia vacant, aliquo recreandi animi gratia <lb xml:id="p1z7"/>discedat; verum, quid animus imperterritus <lb xml:id="p1z8"/>magis quam quid carnis infirmitas possit, <lb xml:id="p1z9"/>ostendere voluit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>Caeterum obsecro, ne moleste feras, quod <lb xml:id="p1z11"/>rarius scribo.</s>
					<s n="5" xml:lang="la">Longe sum diversus ab eo, <lb xml:id="p1z12"/>qui ante paucos annos eram, si scribendi sedulitatem con<lb xml:id="p1z13"/>syderes; qui scribax <lb xml:id="p1z14"/>olim fui, <lb xml:id="p1z15"/>iam sum modo silentii et quietis tenax.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z16"/>Arbitror te pro prudentia tua satis intelligere, <lb xml:id="p1z17"/>quodnam sit senilis aetatis... <lb xml:id="p1z18"/>Quod praesentes motus concernit, accepi tandem <lb xml:id="p1z19"/>heri <placeName ref="l18">Augustanorum</placeName> meorum literas.</s>
					<s n="7" xml:lang="la">Deest mihi <lb xml:id="p1z20"/>amanuensis; alioqui scriberem aliorum <lb xml:id="p1z21"/>manu, quae mea non lubet neque vacat <lb xml:id="p1z22"/>etiam, cum prae aliis, quibus delector laboribus, <lb xml:id="p1z23"/>tum prae animi moesticia, quam nolim velim <lb xml:id="p1z24"/>noctes ac dies propter publica discri<lb xml:id="p1z25"/>mina sentire cogor.</s>
					<s n="8" xml:lang="la">Verum d. <persName ref="p8018">Hallerus</persName>, <lb xml:id="p1z26"/>quoniam convictores habet, quorum uti <lb xml:id="p1z27"/>potest opera, quicquid hoc est incom<lb xml:id="p1z28"/>modi, sarcire potest, cui etiam, quae <lb xml:id="p1z29"/>ad me perferuntur, communicare soleo.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z30"/>Orandus est dominus, ut gravissimos hosce <lb xml:id="p1z31"/>ac revera periculosos motus ad refocillatio<lb xml:id="p1z32"/>nem ecclesiae suę compescat.</s>
					<s n="10" xml:lang="la" ana="farewell">Optime vale, <lb xml:id="p1z33"/>compater charissime.</s>
					<s n="11" xml:lang="la" ana="salute">Salutem tuis et amicis <lb xml:id="p1z34"/>ac fratribus omnibus.</s>
					<s n="12" xml:lang="de"><placeName ref="l41">Bernę</placeName> 22. septembris 1552.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><persName ref="p8417">W[olfg<lb xml:id="p1z35"/>angus] Musc[ulus]</persName>, <lb xml:id="p1z36"/>compat<lb xml:id="p1z37"/>er tuus in domino.</s>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro <lb xml:id="p2z2"/>m. <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae <lb xml:id="p2z5"/>antistiti fidelissimo, <lb xml:id="p2z6"/>compatri in <lb xml:id="p2z7"/>domino charissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
