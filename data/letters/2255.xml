	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Ad singulas priores tuas literas speciatim respondi, precipue, <lb xml:id="p1z2"/>quid <persName>Ionas</persName> meus super questione testudinem sive chelim <lb xml:id="p1z3"/>attinente asserat, hoc nimirum, quod nullam habuerit <lb xml:id="p1z4"/>chelim quam unicam, quę per dominum <persName>Symblerum</persName> ei comparata <lb xml:id="p1z5"/>sit et in ipsius ratiuncula in scriptis ad me data continetur: <lb xml:id="p1z6"/>iniuriam autem ei fieri per eum, qui dicat se ei chelim <lb xml:id="p1z7"/>abstulisse.</s>
					<s n="3" xml:lang="la">Pecunias debitas diu mecum in crumena <lb xml:id="p1z8"/>gessi et hodie adhuc gero; per quem autem eas ad <persName>Symblerum</persName> <lb xml:id="p1z9"/>darem, neminem hactenus habere potui.</s>
					<s n="4" xml:lang="la">Verum intra <lb xml:id="p1z10"/>paucos dies spero me <placeName ref="l18">Augustam</placeName> venturum et per mercatorem <lb xml:id="p1z11"/>quempiam <placeName ref="l291">Lyndoviam</placeName> ad <persName ref="p2465">Ieronimum Papiam</persName> missurum, <lb xml:id="p1z12"/>qui se obtulit eas tuto ad te dare posse.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z13"/>Titulum sermonum vel librorum tuorum De gratia cum dedicatoria <lb xml:id="p1z14"/>ad te dedi; sit vero ea tibi oblata necne, scire cupio; <lb xml:id="p1z15"/>vellem etiam, ut aliquando remitteres, cum exemplar <lb xml:id="p1z16"/>nullum reservarim.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z17"/>Postremo <persName>Ionę</persName> mei suppellex vasi inclus adhuc <lb xml:id="p1z18"/>desyderatur; debuit ea, ut <persName>Ionas</persName> dicit, aut <placeName ref="l291">Lyndo<lb xml:id="p1z19"/>viam</placeName> aut <placeName ref="l320">Memingam</placeName> mitti; qui autem fiat istęc retentio, <lb xml:id="p1z20"/>miramur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Si pignoris loco detinetur... ferendum <lb xml:id="p1z21"/>est; si autem alicui traditum et cui, precor, ut per Symblerum <lb xml:id="p1z22"/>certior fiam; animus enim est illum, nempe <persName ref="p18982">Ionam</persName>, hinc <lb xml:id="p1z23"/>ablegare et tentare, an etiamnum in literis progredi velit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z24"/>Apud nos omnia sub dubio versantur, nec inter mille <lb xml:id="p1z25"/>unus est, qui statui rerum suarum metodum ponere possit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z26"/>Spectamus omneis incerti ad tragedię finem.</s>
					<s n="10" xml:lang="la">Marg<lb xml:id="p1z27"/>gravius redit cum exercitu forti; adversarii contra <lb xml:id="p1z28"/>in procinctu stant, sed vix ęqualiter armati.</s>
					<s n="11" xml:lang="la">Quid futu<lb xml:id="p1z29"/>rum sit, tempus declarabit.</s>
					<s n="12" xml:lang="la">Papistę <placeName ref="l875">Hispanorum</placeName> <lb xml:id="p1z30"/>et <placeName ref="l834">Italorum</placeName> brachium avide expectant in perniciem tam <lb xml:id="p1z31"/>suam quam aliorum.</s>
					<s n="13" xml:lang="la"><persName ref="p18477">Rex Ferdinandus</persName> et episcopi cru<lb xml:id="p1z32"/>delius in pios grassantur quam antea unquam.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z33"/><placeName ref="l279">Laugingę</placeName> 23. marcii treis soles sunt aperte et <lb xml:id="p1z34"/>distinctim a sexta hora mane usque ad octavam visi; <lb xml:id="p1z35"/>quod signum ego carmine descripsi.</s>
					<s n="15" xml:lang="la" ana="salute">Dic ex me amicis <lb xml:id="p1z36"/>et fratribus, quos nosti, salutem plurimam.</s>
					<s n="16" xml:lang="la">Raptim <placeName ref="l337">Neoburgi <lb xml:id="p1z37"/>ad Danubium</placeName> 8. aprilis anno etc.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z38"/>Tuus <persName ref="p8354">Georgius Lętus</persName> etc.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiastę <placeName ref="l587">Tigurino</placeName>, <lb xml:id="p2z3"/>amico et fratri charissimo.</s>
				</p>
				<p>
					<s n="19" xml:lang="de"><placeName ref="l587">Zurch</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
