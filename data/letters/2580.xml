	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Dedi per <persName ref="p2899">Mathiam Schenkhium</persName> superioribus diebus <lb xml:id="p1z2"/>literas cum pecunia, quam pro libris meo nomine <lb xml:id="p1z3"/>exposuisti, ornatissime <persName ref="p495">Bullingere</persName>.</s>
					<s n="3" xml:lang="la">Interim accepi <lb xml:id="p1z4"/>a te literas cum pientissimo libello 10.<note type="margin">a.R.: 16? 18?</note> februarii <lb xml:id="p1z5"/>datas.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Dedi item 27. februarii literas ad ornatissimum <lb xml:id="p1z6"/>virum d. d. <persName ref="p1283">Gesnerum</persName>, per quendam <placeName ref="l41">Bernensem</placeName> tabell<lb xml:id="p1z7"/>arium Pernagel vocatum; is accepta mercede bona <lb xml:id="p1z8"/>fide pollicitus est se hasce redditurum.</s>
					<s n="5" xml:lang="la">Rogo <lb xml:id="p1z9"/>te, ut d. <persName ref="p1283">Gesnerum</persName> certiorem facias me magnis <lb xml:id="p1z10"/>certe laboribus impetrasse privilegium ad decennium.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Illud iam scribitur; quare tuto poterit libro <lb xml:id="p1z12"/>edendo praeponere in frontispicio, cum privilegio <lb xml:id="p1z13"/>regis <persName ref="p18477">Romanorum</persName> ad decennium.</s>
					<s n="7" xml:lang="la">Scribent in <lb xml:id="p1z14"/>cancellaria privilegium; sed quod occupatiores sunt, <lb xml:id="p1z15"/>quam ut statim absolvere possint, volui hoc ipsum, <lb xml:id="p1z16"/>anteaquam scriberetur hoc ipsum significare d. d. <lb xml:id="p1z17"/><persName ref="p1283">Gesneri</persName>.</s>
					<s n="8" xml:lang="la">Praefigat igitur privilegio esse cautum, ne <lb xml:id="p1z18"/>in decennio recudatur.</s>
					<s n="9" xml:lang="de">Es ist im radt peschlossen <lb xml:id="p1z19"/>und registriert; darumb ists ebenso fil, als wers <lb xml:id="p1z20"/>schon geschriben.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Libellus tuus de extremo iudicio multis bonis <lb xml:id="p1z22"/>viris acceptissimus est.</s>
					<s n="11" xml:lang="la">Habui libellum <persName ref="p540">Calvini</persName> <lb xml:id="p1z23"/>de coena domini certe eruditum; optarem plures, <lb xml:id="p1z24"/>ut eos amicis communicare licet.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z25"/>Neque [...]<note type="margin">a.R.:Verentzom?</note> nec quisquam suorum apud nos agit <lb xml:id="p1z26"/>preter quendam prepositum, hominem contra religionem <lb xml:id="p1z27"/>atrociter sevientem et ob hoc regi acceptissimum, <lb xml:id="p1z28"/>cui literas concedere minus tutum est.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Adperuit <lb xml:id="p1z29"/>nuper literas <persName ref="p3375">Pauli Vergerii</persName> ad amicum in aula regis <lb xml:id="p1z30"/>et eas regi ostendit non sine periculo istius, cui literę <pb/><lb xml:id="p2z1"/>fuerunt inscriptę; sed dabo operam, ut denuo tuto <lb xml:id="p2z2"/>transferantur literę meę cum libello tuo ad virum <lb xml:id="p2z3"/>optimum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z4"/>Valde commendantur consilia <placeName ref="l587">Tigurensium</placeName>, quod <lb xml:id="p2z5"/>non subscripserunt inquissimę sententiae contra <lb xml:id="p2z6"/><placeName ref="l294">Locarnenses</placeName> pios latę.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z7"/>Comitia nostra fortiter procedunt; habita est heri <lb xml:id="p2z8"/>quarta consultatio; pii strenue se gesserunt <lb xml:id="p2z9"/>in defendenda religione et tuendo tractatu <placeName ref="l1204">Patavii</placeName> <lb xml:id="p2z10"/>in praeterito bello composito; ab illis enim articulis <lb xml:id="p2z11"/>illic conclusis ne unguem latum discedere volunt, <lb xml:id="p2z12"/>utut filii seculi huius omnes intendant <lb xml:id="p2z13"/>nervos, ut ex <placeName ref="l1204">Pataviensi</placeName> concordia et prescripto <lb xml:id="p2z14"/>elabantur ipsi et alios elabi faciant.</s>
					<s n="16" xml:lang="la">Vincunt inpii <lb xml:id="p2z15"/>pios votorum multitudine; sed hi, qui stant <lb xml:id="p2z16"/>ab evangelio, ut pauciores ita sunt constantiores <lb xml:id="p2z17"/>in asserenda veritate.</s>
					<s n="17" xml:lang="la">Habent fundamentum nequaquam <lb xml:id="p2z18"/>ficulneum, cui innituntur; nam <placeName ref="l1204">Pataviense</placeName> prescriptum <lb xml:id="p2z19"/>inter ceterea capita hoc habet, quod religionis <lb xml:id="p2z20"/>causa equalibus votis transigi debeat.</s>
					<s n="18" xml:lang="la">Mille <lb xml:id="p2z21"/>queruntur cunei ad dissolvendum hunc nodum<note xml:id="fn1" type="footnote" n="1">Adag. 1, 2, 5?</note>; <lb xml:id="p2z22"/>sed spero frustra eos molituros omnia.</s>
					<s n="19" xml:lang="la" ana="salute">Vale, doctissime <lb xml:id="p2z23"/><persName ref="p495">Bullingere</persName>, et d. <persName ref="p1283">Gesnerum</persName> cum aliis viris bonis meo <lb xml:id="p2z24"/>nomine salutes, oro.</s>
					<s n="20" xml:lang="la" ana="salute">Salutem tibi annunciari cupit <lb xml:id="p2z25"/>d. <persName>a Freyberg</persName>, qui iam hic agit in comitiis cum <lb xml:id="p2z26"/>principe suo.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Missus est per <persName>Guilielmum</persName> libellus <lb xml:id="p2z27"/>tuus ad patrem.</s>
					<s n="22" xml:lang="la" ana="salute">Salutato item <persName>Guilielmum</persName>.</s>
					<s n="23" xml:lang="la"><placeName ref="l18">Augustę</placeName> <lb xml:id="p2z28"/>ocyssime 6. martii anno 55.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">D. <lb xml:id="p2z29"/><persName ref="p3927">Welserus</persName> expassis ulnis libellum a te missum accepit; scribet <lb xml:id="p2z30"/>ad te hac de re ipse.</s>
				</p>
				<p>
					<s n="25" xml:lang="de"><lb xml:id="p2z31"/><persName ref="p2856">Geryon Seyler</persName> t[uus<pb/><lb xml:id="p4z1"/>].</s>
				</p>
				<p>
					<note type="address">[Adresse von anderer Hand:]</note>
					<s n="26" xml:lang="la">Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p4z2"/>Bullingero</persName>, ecclesiastae <placeName ref="l587">Tigurino</placeName> <lb xml:id="p4z3"/>vigilantissimo, domino et <lb xml:id="p4z4"/>amico observ<lb xml:id="p4z5"/>ando.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p4z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
