	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Doctissime vir, salus a deo patre nostro per <lb xml:id="p1z2"/>Iesum Christum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Amen.</s>
					<s n="3" xml:lang="la">D. <persName ref="p3375">Petrus Paulus <lb xml:id="p1z3"/>Vergerius</persName>, vir ille scilicet pro Christiana <lb xml:id="p1z4"/>religione optimus athleta, nuper scripsit <lb xml:id="p1z5"/>ad me in han[c]<note type="margin">a.R.: [c</note>...] sententiam: "Si ullas ad me <lb xml:id="p1z6"/>literas dare velis, eas ad d. <persName ref="p495">Heinrychum <lb xml:id="p1z7"/>Bullingerum</persName> dirigito, qui, ut ad me <lb xml:id="p1z8"/>quam primum perferantur, operam navabit:" <lb xml:id="p1z9"/>Idcirco, ut monuit, egi confisus te, qua <lb xml:id="p1z10"/>praeditus es diligentia, curatum ire, ut, <lb xml:id="p1z11"/>quae de te mihi persuasum habuit, vera <lb xml:id="p1z12"/>se dixisse videat.</s>
					<s n="4" xml:lang="la" ana="farewell">Vale in domino semper.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z13"/>Ex loco de <placeName ref="l525">Vicosoprano</placeName>, die 20. augusti <lb xml:id="p1z14"/>1551.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Frater tuus in domino <lb xml:id="p1z16"/><placeName ref="l378">Paris</placeName> a <placeName ref="l36">Bergamo</placeName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Clari<pb/><lb xml:id="p2z1"/>ssimo viro domino <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>pastori fidelissimo, plurimum <lb xml:id="p2z4"/>[mih<lb xml:id="p2z5"/>i]<note type="margin">a.R.: in?</note> domino observando.</s>
					<s n="8" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
