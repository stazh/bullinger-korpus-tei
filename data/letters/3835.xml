	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. <lb xml:id="p1z2"/>P. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>S. Si tu omnesque tui, clarissime atque colendissime domine, valetis, bene <lb xml:id="p1z4"/>est; ego quidem (divina gratia) optime valeo.</s>
					<s n="3" xml:lang="la">Porro, colendissime domine, <lb xml:id="p1z5"/>scias me bonum herum habere, qui me omnibus in rebus bene atque laute <lb xml:id="p1z6"/>tractat.</s>
					<s n="4" xml:lang="la">Deinde etiam pro viribus in studiis diligenter pergo meis.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Nunc plura quod ad te scribam, non habeo.</s>
					<s n="6" xml:lang="la">Saltem te rogo, ut, si quas meas <lb xml:id="p1z8"/>ad te mittit pater literas, eas, ut mihi tradentur, diligenter cures.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z9"/>Oro, quod mihi pannum, quod apud vos reliqui, admittas meque semper <lb xml:id="p1z10"/>commendatum, ut hactenus, habeas.</s>
					<s n="8" xml:lang="la">Has insulsas meas literas aequi bonique <lb xml:id="p1z11"/>consulas, te rogo.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">His satis.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Nomine meo uxorem tuam charissimam, <persName ref="p495">Henrichum</persName>, <lb xml:id="p1z12"/>filium tuum, et omnem familiam plurimum salutabis.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z13"/>atque vive, domine mi charissime.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Data <placeName ref="l28">Basileę</placeName> ex edibus heri mei m. <lb xml:id="p1z14"/><persName>Lienhartt Smidt</persName> anno salutis nostre 1559. die 9. ianuarii.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z15"/>Tuus totus ex animo amicus <lb xml:id="p1z16"/>atque tamquam filius charissimus <lb xml:id="p1z17"/><persName ref="p8433">Ioannes a Salicibus</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z18"/><persName>Petrus Alexius</persName>, conter(r?) aneus meus charissimus, qui etiam <placeName ref="l587">Tiguri</placeName> studuit, te inprimis <lb xml:id="p1z19"/>omnesque tibi faventes plurima salute atque felicitate impertit<pb/><lb xml:id="p2z3"/>.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z7"/>Clarissimo atque pręstantissimo viro d. <lb xml:id="p2z8"/><persName ref="p495">Henricho Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z9"/>pastori fidelissimo, amico atque d<lb xml:id="p2z10"/>omino suo semper plurimum colendo<lb xml:id="p2z11"/>.</s>
				</p>
			</div>
		</body>
	</text>
