	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Pergrata mihi fuerunt, quae legenda communicasti; ea nunc tibi remitto.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Apud nos non minus incerta de bello <placeName ref="l832">Gallico</placeName> feruntur quam apud vos, <lb xml:id="p1z3"/>imo iam omnia conticuerunt, nec quisquam quicquam novarum rerum profert, quod, quae <lb xml:id="p1z4"/>hactenus nunciata sunt, fere omnia falsa aut saltem incerta fuisse constet.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Itaque, quod nunc ad [te] scribam, omnino nihil habeo.</s>
					<s n="5" xml:lang="la">Iudicium vero tuum de <lb xml:id="p1z6"/><placeName ref="l832">Gallico</placeName> bello minime absurdum est, et similibus ex causis similes eventus <lb xml:id="p1z7"/>probe colliguntur.</s>
					<s n="6" xml:lang="la">Ego dum seculi senium considero, predicationes varias, quas <lb xml:id="p1z8"/>multis... perlegi, papisticę tyrannidi si non interne<lb xml:id="p1z9"/>cionem, saltem exitium ingens imminere spero potius quam assero.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/><persName ref="p2899">Schenckio</persName>, quae mandasti, tradidi.</s>
					<s n="8" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="9" xml:lang="de">Datum <placeName ref="l54">Bochsperg</placeName> <lb xml:id="p1z11"/>10. februarii anno 68.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z12"/>R[everentiae] t[uae] observantissimus <persName ref="p3740">Georgius a <lb xml:id="p1z13"/>Stetten</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Venerando, pio atque erudito domino <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, ecclesię <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>antistiti vigilantissimo, domino et amico <lb xml:id="p2z4"/>suo colendo.</s>
					<s n="12" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
