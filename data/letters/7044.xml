	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literas tuas scriptas 2. februarii summa cum voluptate legi; mirum <lb xml:id="p1z2"/>tamen fuit te non accepisse tres, quas scripsi ab ineunte septembri.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Hoc me consolatur nostram amicitiam ne dependere ab officio <lb xml:id="p1z4"/>literarum, ut quę tam alte radices egerit, ut nulla re labefactari <lb xml:id="p1z5"/>possit.</s>
					<s n="4" xml:lang="la">Ante intellexeramus <placeName ref="l875">Hispanicas</placeName> artes <persName>Maxim[iliani]</persName> nec, ut <lb xml:id="p1z6"/>sperabat, procedere aut successu frui, cum obsidentes ab obsessis plu<lb xml:id="p1z7"/>s accipiant incommodi nec desint, qui eos ab obsidione <lb xml:id="p1z8"/>liberaturi sint, plures etiam, qui <placeName ref="l808">Belgis</placeName> liberan ibus auxilium <lb xml:id="p1z9"/>sint laturi.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><placeName ref="l15">Antverpie</placeName> domus Franciscanorum exusta, reperte me<lb xml:id="p1z10"/>retrices aliquot.</s>
					<s n="6" xml:lang="la">Tumultus omnes convertet dominus ad nominis sui <lb xml:id="p1z11"/>gloriam, etiamsi, cum puniuntur impii, sepe involvantur etiam sancti.</s>
					<s n="7" xml:lang="la">Ad domini providentiam <lb xml:id="p1z12"/>nobis respiciendum, qui ad poenitentiam omnes tantis calamitatibus invitat, <lb xml:id="p1z13"/>atque cernamus et quasi palpemus peccata perturbare universam naturam <lb xml:id="p1z14"/>rerum et urbes evertere ac omnes perdere.</s>
					<s n="8" xml:lang="la">Aliquibus in locis pestis <lb xml:id="p1z15"/>in pagis proximis incipit grassari.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Intellexisti <persName ref="p18212">Scotię regem</persName> <lb xml:id="p1z16"/>misere interfectum eius cubiculo suppositis vasis aliquot plenis pulvere <lb xml:id="p1z17"/>bombardico, cuius vi deiectum fuit corpus centum passibus.</s>
					<s n="10" xml:lang="la">Scripsi <lb xml:id="p1z18"/>me recepisse et devorasse summa cum voluptate homilias tuas <lb xml:id="p1z19"/>in Danielem; ubi excusse fuerint alie in Isaiam, hic invenientur.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p1z20"/>Salutat te uxor et liberi.</s>
					<s n="12" xml:lang="la" ana="salute">Salutabis amplissimum senatum meo nomine <lb xml:id="p1z21"/>et amicos omnes.</s>
					<s n="13" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l378">Parisiis</placeName> 5. martii 1567.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z22"/>Tuus ex animo <persName ref="p629">Coignetius</persName><pb/><lb xml:id="p2z1"/>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z2"/>Eximio viro d. <persName ref="p495">Henricho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurine</placeName> ecclesie <lb xml:id="p2z4"/>pastori vigilantissimo.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>