	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Ingratus sane videri poteram chare
					<lb xml:id="p1z2"/>Caeli, qui tuis hactenus non respondi nec
					<lb xml:id="p1z3"/>pro misso exemplari epistolarum egi gratias, nisi
					<lb xml:id="p1z4"/>afflicta me excusaret valetudo. Hactenus enim
					<lb xml:id="p1z5"/>obstimui aliquoties ab ordinariis meis coner
					<lb xml:id="p1z6"/>ioibus, quod debilitas et aegritudo corpo
					<lb xml:id="p1z7"/>non sineret me fungi meo minere
					<lb xml:id="p1z8"/>Ultimi conflictatus sum cum febri, quae ne non
					<lb xml:id="p1z9"/>deseruit plene. Verum ita deo visum
					<lb xml:id="p1z10"/>est. Pacientuer haec omnia per eius gratiam fero. Tu
					<lb xml:id="p1z11"/>ora pro me dominum, ut in bona eius volunta
					<lb xml:id="p1z12"/>et me semper confirmet. Pro missis libellis
					<lb xml:id="p1z13"/>gratias ago, nec aliud dico, quam malle ovissem
					<lb xml:id="p1z14"/>esse mta epistolam; scripta quippe illaborate
					<lb xml:id="p1z15"/>negligenter; neque enim unquam somnare
					<lb xml:id="p1z16"/>ea fore vulgandam. Atque oro, si post hac
					<lb xml:id="p1z17"/>
					<lb xml:id="p1z18"/>mei aliquid edere velis, ne id feceri,
					<lb xml:id="p1z19"/>praemonito. Vide item ne male
					<lb xml:id="p1z20"/>
					<lb xml:id="p1z21"/>censulueris hominibus piis in Italia veluti
					<lb xml:id="p1z22"/>medio luporum habitantibus. Utcunque
					<lb xml:id="p1z23"/>enimhi hactenus dissimularunt sua, id est
					<lb xml:id="p1z24"/>veram religionem, nunc tamen quali sint reliu
					<lb xml:id="p1z25"/>imbuti ex tuo epistolari invote
					<lb xml:id="p1z26"/>omnibus; nn metuendum est, ne illiss
					<lb xml:id="p1z27"/>ingens periculum conscveris. Caeterum possims
					<lb xml:id="p1z28"/>confuteantur. Qu Anglia
					<lb xml:id="p1z29"/>dominus, ut sui ipsum
					<lb xml:id="p1z30"/>nullas iam mesibus aliquot literas accep
					<lb xml:id="p1z31"/>episcopi Wigornensis sub fine
					<lb xml:id="p1z32"/>enarii scriptas, sed eas quoque breves. Si aliu
					<lb xml:id="p1z33"/>quid accepero, alicuius moventi non ignorim
					<lb xml:id="p1z34"/>Perge tu frequenter ad me scribe,
					<lb xml:id="p1z35"/>Commenda me d. d. Borrhao, domino
					<lb xml:id="p1z36"/>meo colendissimo. vive et vale. Tiguri
					<lb xml:id="p1z37"/>maiim. Reliqua audies ex Lycon
					<lb xml:id="p1z38"/>thenen nostro 1553.
					<lb xml:id="p1z39"/>Tuus Bullingerus.
					<pb/>
					<lb xml:id="p2z1"/>Clarissimo viro d. Car
					<lb xml:id="p2z2"/>secundo Curio
					<lb xml:id="p2z3"/>domio et fratri
					<lb xml:id="p2z4"/>suo colendo et churo.
					<lb xml:id="p2z5"/>Basel.
				</p>
			</div>
		</body>
