	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Gratulor tibi, vir clarissime, quod salvus <lb xml:id="p1z2"/>et incolumis domum rediens tuosque omnes et res <lb xml:id="p1z3"/>tuas inveneris felices.</s>
					<s n="3" xml:lang="la">Utinam d. <persName ref="p8492">Petrus Bergomas</persName> <lb xml:id="p1z4"/>revalescat, utinam et de <persName ref="p6831">Traversio</persName> nostro <lb xml:id="p1z5"/>felicia scribas!</s>
					<s n="4" xml:lang="la">Res nostrae hic per dei gratiam <lb xml:id="p1z6"/>satis recte habent.</s>
					<s n="5" xml:lang="la">Valemus, et res sunt omnes pacificę<lb xml:id="p1z7"/>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><persName ref="p8433">Ioannem</persName>, filium tuum, ut semper ita nunc <lb xml:id="p1z8"/>quoque laudo; mihi instar filii et charissimus est; ingenii <lb xml:id="p1z9"/>enim est probi, candidi et boni.</s>
					<s n="7" xml:lang="la">Si ita per<lb xml:id="p1z10"/>rexerit, quod spero et dominum oro, ut gratiam <lb xml:id="p1z11"/>illi suam conferat, erit aliquando, unde leteris <lb xml:id="p1z12"/>abundantissime; caeterum cura multo opus est, <lb xml:id="p1z13"/>ne corrumpatur.</s>
					<s n="8" xml:lang="la">Ita apud me vixit hactenus, ut <lb xml:id="p1z14"/>nunquam virga in ipsum animadverterim.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">At in <persName ref="p20301">Hectorem</persName>, <lb xml:id="p1z15"/>licet brevissimo tempore apud me fuerit, coactus sum hoc iuris mihi usurpare.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/>Vehementis est ingenii et pervicacis nec facile <lb xml:id="p1z17"/>verbis movetur; aegerrime sinit se a coeptis <lb xml:id="p1z18"/>suis et a moribus consuetis avertere.</s>
					<s n="11" xml:lang="la">Conabor <lb xml:id="p1z19"/>tamen paterna cura, benevolentia et moderata <lb xml:id="p1z20"/>severitate tentare omnia, si possint eius curari <lb xml:id="p1z21"/>vicia.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Utut cedat res, scribam tibi sedulo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Mihi quidem <lb xml:id="p1z22"/>videtur pro initio nimis multis esse intentus; chelim <lb xml:id="p1z23"/>tractare alio tempore commodius discere posset; <lb xml:id="p1z24"/>mallem eum nunc operam dare dumtaxat scholae <lb xml:id="p1z25"/>et linguae ac scriptioni etc.</s>
					<s n="14" xml:lang="la">Novae res circum<lb xml:id="p1z26"/>feruntur plurimae: regem <persName ref="p18477">Ferdinandum</persName> properare <lb xml:id="p1z27"/><placeName ref="l157">Francfortum</placeName>, illuc venturos esse etiam alios electores; <lb xml:id="p1z28"/>multos <placeName ref="l822">Germaniae</placeName> principes graves facere <lb xml:id="p1z29"/>expeditiones bellicas, incertum in quem.</s>
					<s n="15" xml:lang="la">Sed <lb xml:id="p1z30"/>de his ubi habuero compertiora, scribam alias; <lb xml:id="p1z31"/>nunc enim ęgre haec exarare potui.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">De filiis <lb xml:id="p1z32"/>nolo te esse solicitum; nam quod honestati et <lb xml:id="p1z33"/>necessitati serviet, nihil eis deerit.</s>
					<s n="17" xml:lang="la" ana="salute">Cupio me <lb xml:id="p1z34"/>commendari d. <persName ref="p6831">Traversio</persName> et d. parenti tuo et viris <lb xml:id="p1z35"/>aliis bonis, quos ex me salutabis, imprimis verbi <lb xml:id="p1z36"/>et ecclesiae apud vos ministros.</s>
					<s n="18" xml:lang="la" ana="salute">Uxor mea et <lb xml:id="p1z37"/>mea familia te, uxorem tuam honestissimam et totam <lb xml:id="p1z38"/>denique domum tuam iubet salvere.</s>
					<s n="19" xml:lang="la" ana="farewell">Vale in <lb xml:id="p1z39"/>Christo felix et beatus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 25. februarii 1558.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z40"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z7"/>Clarissimo viro d. <persName ref="p8432">Fride<lb xml:id="p2z8"/>rycho a Salice</persName>, <placeName ref="l440">Sa<lb xml:id="p2z9"/>madeno Rheto</placeName>, domino <lb xml:id="p2z10"/>meo colendo <lb xml:id="p2z11"/>et fratri charissimo.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p2z13"/><placeName ref="l440">Samada</placeName>.</s>
				</p>
			</div>
