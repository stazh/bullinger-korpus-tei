	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z3"/>S.</s>
					<s n="2" xml:lang="la">Quod novi nihil scripserim, in <lb xml:id="p1z4"/>causa fuit, quod certi <lb xml:id="p1z5"/>nihil hactenus potui ab illo mercatore<note xml:id="fn1" type="footnote" n="1">Unbekannt.</note> expiscari.</s>
					<s n="3" xml:lang="la">Geldrus <lb xml:id="p1z6"/>in gratiam caesaris est receptus<note xml:id="fn2" type="footnote" n="2">Zur Unterwerfung Herzog <persName ref="p18605">Wilhelms von Jülich-Berg-Kleve-Geldern</persName> unter Kaiser <persName ref="p18538">Karl V.</persName> s. oben <ref target="file11834">Nr. 1788</ref>, 9-24.</note> iniquissima conditione, quam <lb xml:id="p1z7"/>fortassis connubium mitigabit illud futurum cum <persName ref="p18477">Ferdinandi</persName> filia<note xml:id="fn3" type="footnote" n="3"><persName ref="p20145">Maria von Österreich</persName>; vgl. ebd. Anm. 22.</note>, <lb xml:id="p1z8"/>ut fama fert, vel cum <persName ref="p19525">regina vidua</persName> demortui <persName ref="p3671">regis Danorum</persName><note xml:id="fn4" type="footnote" n="4">Gedacht ist anscheinend an <persName ref="p19525">Königin Dorothea</persName>; vgl. dazu das (falsche) Gerücht, König <persName ref="p3671">Christian III.</persName> sei vom Schlag getroffen worden (<bibl source="b480">PC</bibl> III 432).</note>.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/><persName ref="p20318">Dux Brunsvicensis</persName>,<note xml:id="fn5" type="footnote" n="5">Herzog <persName ref="p20318">Heinrich von Braunschweig-Wolfenbüttel</persName>.</note> evangelii acerrimus hostis et homicida <lb xml:id="p1z10"/>multorum piorum, in magno pretio habetur in aula caesaris.</s>
					<s n="5" xml:lang="la">Inservit <lb xml:id="p1z11"/>servitium diligentissimum,<note xml:id="fn6" type="footnote" n="6">Vgl. den ganz ähnlich lautenden Bericht, den <placeName ref="l491">Straßburg</placeName> am 17. September an <placeName ref="l28">Basel</placeName> übermittelte (<bibl source="b480">PC</bibl> III 436).</note> adstat caesari, quum inscendit equum, stapedes <lb xml:id="p1z12"/>tenet; quum descendit, idem officium subit, ut ne locus sit nobilibus <lb xml:id="p1z13"/>tale offitium caesari offerre.</s>
					<s n="6" xml:lang="la">Summo mane vigilat ante cubiculum caesaris <lb xml:id="p1z14"/>illius adventum expectans.</s>
					<s n="7" xml:lang="la">Eandem humanitatem <persName ref="p7295">dominus de Müß</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p7295">Gian Giacomo de' Medici</persName>, Herr von <placeName ref="l1056">Musso</placeName>.</note> <lb xml:id="p1z15"/>caesari exhibet; nihil absque illorum consilio agit, verum non in omnibus, <lb xml:id="p1z16"/>solum in hiis, quę contra evangelicos et civitates sunt.</s>
					<s n="8" xml:lang="la"><persName ref="p18538">Caesar</persName> <lb xml:id="p1z17"/>paucorum est verborum, minis et irarum plenus erga <placeName ref="l822">Germaniam</placeName>.</s>
					<s n="9" xml:lang="la"><placeName ref="l1875">Heil<lb xml:id="p1z18"/>desheymensibus</placeName> edictum misit satis<pb type="edition" next="269"/> atrox, quod prelo excusum est;<note xml:id="fn8" type="footnote" n="8">Rhoemischer keyserlicher maiestat [...] ernstlichs mandat [...] wider die unruehige burgermeister unnd that der stadt <placeName ref="l1875">Hildeßheim</placeName>, zu <placeName ref="l569">Wormbs</placeName> [...] ausgangen, s.l. 1543 <bibl source="https://gateway-bayern.de/VD16+D+962">(VD 16 D 962)</bibl>.</note> reor <lb xml:id="p1z19"/>te iam olim vidisse.</s>
					<s n="10" xml:lang="la"><placeName ref="l2829">Geldriam</placeName> totam in fidem accepit datis <lb xml:id="p1z20"/>obsidibus.</s>
					<s n="11" xml:lang="la">Quid actum sit <placeName ref="l157">Francofurti</placeName>, ignoro; nam adhuc comitia <lb xml:id="p1z21"/>habentur a praecipuis, qui ad bellica negotia ordinati<note xml:id="fna" type="footnote" n="a"><hi>Wortanfang undeutlich korrigiert.</hi></note> sunt<note xml:id="fn9" type="footnote" n="9">Zum <placeName ref="l1202">schmalkaldischen</placeName> Bundestag in <placeName ref="l157">Frankfurt</placeName> vgl. oben <ref target="file11831">Nr. 1785</ref>, 38-40 mit Anm. 18.</note>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/>Timor enim invasit omnes civitates.</s>
					<s n="13" xml:lang="la"><placeName ref="l491">Argentoratenses</placeName> insimulantur <lb xml:id="p1z23"/>a caesare, quod <persName ref="p20225">Gallo</persName><note xml:id="fn10" type="footnote" n="10">König <persName ref="p20225">Franz I.</persName></note> faveant; incusat eos<note xml:id="fnb" type="footnote" n="b">eos <hi>über der Zeile nachgetragen.</hi></note>, quod praesidia mittant et <lb xml:id="p1z24"/>consilia communicent;<note xml:id="fn11" type="footnote" n="11">Vor allem Graf <persName ref="p7492">Wilhelm von Fürstenberg</persName> soll <placeName ref="l491">Straßburg</placeName> beim <persName ref="p18538">Kaiser</persName> der Parteilichkeit für <placeName ref="l832">Frankreich</placeName> beschuldigt haben; s. <bibl source="b480">PC</bibl> III 411f.</note> an ita sit, nescio.</s>
					<s n="14" xml:lang="la">Brevi erunt comitia <lb xml:id="p1z25"/><placeName ref="l471">Spirę</placeName>;<note xml:id="fn12" type="footnote" n="12">Zum Reichstag, der Ende November in <placeName ref="l471">Speyer</placeName> beginnen sollte, s. oben <ref target="file11812">Nr. 1766</ref>, 92f mit Anm. 42.</note> ob id oremus dominum<note xml:id="fnc" type="footnote" n="c"><hi>Vielleicht als</hi> deum zu <hi>lesen.</hi></note>, ne suis desit, ut et nobis vitam <lb xml:id="p1z26"/>dignam christiano populo det.</s>
					<s n="15" xml:lang="la" ana="farewell">Vale in domino.</s>
					<s n="16" xml:lang="la">Fortassis <lb xml:id="p1z27"/><persName ref="p8418">Myconius</persName> plura scribet, quę me latent<note xml:id="fn13" type="footnote" n="13">Vgl. <persName ref="p8418">Myconius</persName>' Brief vom selben Tag, unten <ref target="file11838">Nr. 1792</ref>.</note>.</s>
					<s n="17" xml:lang="la">Quum libri ad <lb xml:id="p1z28"/>nos venerint e mercatu <placeName ref="l157">Francfurtensi</placeName>, habebis indice<lb xml:id="p1z29"/>m.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">D. <persName ref="p8049">Vadianum</persName>, virum pium et optimum, nomine meo salutabis, si ad illum <lb xml:id="p1z30"/>quid scripturus es; <persName ref="p8171">Theodorum</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p8171">Theodor Bibliander</persName>.</note> similiter, virum divinum, plurima imparti salute.</s>
					<s n="19" xml:lang="la">1. <lb xml:id="p1z31"/>octobris <lb xml:id="p1z32"/>1543.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Tuus <persName ref="p1278">Gastius</persName> ex animo.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb type="scan" next="263v."/><persName ref="p8298">Cellarius</persName><note xml:id="fn15" type="footnote" n="15"><persName ref="p8298">Martin Borrhaus</persName>; vgl. zuletzt oben <ref target="file11821">Nr. 1775</ref>, 33-37.</note> noster publico scripto purgabit se, quod falso insimulatur <lb xml:id="p2z2"/>haereseos neque vult sectarius dici, et si plenus opinionum sit; specimen <lb xml:id="p2z3"/>dedit editis libris<note xml:id="fn16" type="footnote" ana="bio" n="16">In seinem Erstlingswerk "De operibus dei", <placeName ref="l491">Straßburg</placeName> (<persName ref="p5213">Johann Herwagen</persName>) 1527 <bibl source="https://gateway-bayern.de/VD16+B+6745">(VD 16 B 6745)</bibl> hatte <persName ref="p8298">Borrhaus</persName> die Kindertaufe als zwar vorläufig sinnvoll, aber nicht notwendig bezeichnet, weshalb ihn <persName ref="p4091">Zwingli</persName> täuferischer Ansichten beschuldigte (vgl. bes. <bibl source="b700">Z</bibl> VI/1 181f, Anm. 4).</note>.</s>
					<s n="22" xml:lang="la">Ambit lectionem theologicam, quod egre fert <persName ref="p8466">Wolfius</persName><note xml:id="fn17" type="footnote" n="17"><persName ref="p8466">Wolfgang Wissenburg</persName>.</note> <lb xml:id="p2z4"/>noster, doctor primus evangelicus in nostra academia<note xml:id="fn18" type="footnote" n="18"><persName ref="p8466">Wissenburg</persName> war 1540 zum Missfallen von <persName ref="p1278">Gast</persName> als erster Theologe in <placeName ref="l28">Basel</placeName> seit der Reformation zum Doktor promoviert worden; vgl. <bibl source="b12">HBBW X</bibl> <ref target="file11469">[Nr. 1426]</ref>, S. 175, Anm. 14.</note>.</s>
					<s n="23" xml:lang="la">Videbis brevi <lb xml:id="p2z5"/>illius purgationem<note xml:id="fn19" type="footnote" n="19">Nicht erhalten.</note>; timeo, ne plus seipsum accusaturus sit quam ex<lb xml:id="p2z6"/>cusaturus, si<note xml:id="fnd" type="footnote" n="d"><hi>Vor</hi> si <hi>ein gestrichenes, unlesbares Wort.</hi></note> verum dicere aut scribere vult.<pb type="edition" next="270"/></s>
				</p>
				<p>
					<s n="24" xml:lang="la">In <placeName ref="l832">Gallum</placeName> partem <lb xml:id="p2z7"/>exercitus caesar mittit,<note xml:id="fn20" type="footnote" n="20">Nach dem Sieg über <placeName ref="l1095">Jülich</placeName> wurde das kaiserliche Heer in den <placeName ref="l2952">Hennegau</placeName> verlegt; vgl. <bibl source="b301">Henne</bibl> VIII 137.</note> partem in <placeName ref="l825">Danum</placeName>;<note xml:id="fn21" type="footnote" n="21"><persName ref="p3671">Christian III.</persName>, der Kaiser <persName ref="p18538">Karl V.</persName> den Krieg erklärt hatte, rechnete mit einem solchen Angriff; der <persName ref="p18538">Kaiser</persName> zog es jedoch vor, die Kräfte auf <placeName ref="l832">Frankreich</placeName> zu konzentrieren; vgl. <bibl source="b555">Rudolf</bibl> <hi>Häpke,</hi> Die Regierung Karls V. und der europäische Norden, Lübeck 1914 (Nachdruck: Hildesheim-New York 1976). - Veröffentlichungen zur Geschichte der Freien und Hansestadt Lübeck 3, S. 221f.</note> exercitum ingentem habet <lb xml:id="p2z9"/>et externum militem etc.</s>
				</p>
				<p>
					<s n="25" xml:lang="la" ana="farewell">Vale iter<lb xml:id="p2z11"/>um<lb xml:id="p2z12"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse darunter:]</note>
					<s n="26" xml:lang="la"><lb xml:id="p2z13"/>Vero theologo d. <persName ref="p495">Heinricho <lb xml:id="p2z14"/>Bullingero</persName>, domino <lb xml:id="p2z15"/>suo observando.</s>
				</p>
				<p>
