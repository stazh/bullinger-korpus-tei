	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quae ex <placeName ref="l834">Italia</placeName> accepi ab amicis in praesenti m<lb xml:id="p1z2"/>itto.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Ex <placeName ref="l830">Anglia</placeName> scribit episcopus <placeName ref="l951">Sarisberiensis</placeName> <lb xml:id="p1z3"/>res omnes satis habere feliciter et <placeName ref="l2524">Scotiam</placeName> <lb xml:id="p1z4"/>progressus in evangelio facere maximos, reginam pro <lb xml:id="p1z5"/>ingenio Guysiaco missare solam.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Con<lb xml:id="p1z6"/>cionator aulicus ducis <placeName ref="l2562">Prussiae</placeName> missus a suo <lb xml:id="p1z7"/>principe contulit cum <persName ref="p458">Brentio</persName> de coena; sed <lb xml:id="p1z8"/>non potuit eis convenire.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Monstra opinionum <lb xml:id="p1z9"/>cudit <persName ref="p458">Brentius</persName> cum suo <persName>Schmidelino</persName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Hic, <lb xml:id="p1z10"/>qui alias <persName ref="p4183">Iacobus Andreae</persName>, tui fecit mentionem <lb xml:id="p1z11"/>et quidem non sine contemptu.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ego vero <persName>Wey<lb xml:id="p1z12"/>gelio</persName>, ita enim concionator ille appellatur, de <lb xml:id="p1z13"/>omnibus institui, ut iam rectius de te sentiat.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Mirifici sunt <persName ref="p458">Brentiani</persName>; absurdissima tuentur <lb xml:id="p1z15"/>dogmata.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Et <persName>Palatinus</persName> hodie pessime apud istos <lb xml:id="p1z16"/>audit ac <persName ref="p540">Calvinianus</persName> appellatur ab eis.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Spero <lb xml:id="p1z17"/>autem invitis istis omnibus perseveraturum <lb xml:id="p1z18"/>in veritate.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Novum bellum exortum est <lb xml:id="p1z19"/>inter <placeName ref="l2520">Suedum</placeName> et <persName ref="p3671">Daniae</persName> regem.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Fortassis <lb xml:id="p1z20"/>oborietur grave bellum in <placeName ref="l834">Italia</placeName> propter <placeName ref="l306">Mediolanum</placeName>, <lb xml:id="p1z21"/>quod <placeName ref="l875">Hispanis</placeName> cogitare dicitur adimere <lb xml:id="p1z22"/><persName ref="p8282">Maximilianus</persName> rex.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Mira est in <placeName ref="l2472">Polonia</placeName> <lb xml:id="p1z23"/>conturbatio et altercatio in c[aus]a trinitatis et <lb xml:id="p1z24"/>in c[aus]a <persName ref="p7955">Blandratae</persName> et <persName ref="p3018">Stankari</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Mox ad te <lb xml:id="p1z25"/>rursus mittam scripta aliquot; vexamur <lb xml:id="p1z26"/>mirifice ab istis.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Optime vale cum fratribus <lb xml:id="p1z27"/>et symmystis omnibus.</s>
					<s n="16" xml:lang="la" ana="salute">Omnes mei et omnes fratres <lb xml:id="p1z28"/>te salutant.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Festinantissime scripsi.</s>
					<s n="18" xml:lang="la">20. <lb xml:id="p1z29"/>a<lb xml:id="p1z30"/>prilis 1563.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Miramur valde, quid <lb xml:id="p1z31"/>fiat in <placeName ref="l832">Gallia</placeName>, paxne sit recepta an repudiata.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="farewell"><lb xml:id="p1z32"/>Iterum iterumque vale<lb xml:id="p1z33"/>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="salute"><lb xml:id="p1z34"/>Salvus sit d. <persName ref="p8078">Ionvilleus</persName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z35"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z36"/>Quaeso te, ut scriptum hoc, quod tibi <lb xml:id="p1z37"/>mitto, maturo remittas ad m<lb xml:id="p1z38"/>e; nullum habeo exemplum.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p540">Ioanni Calvino</persName>, <lb xml:id="p2z2"/><placeName ref="l167">Genevensis</placeName> ecclesiae <lb xml:id="p2z3"/>fidelissimo pastori, domino <lb xml:id="p2z4"/>colendo et fratri carissimo meo.</s>
				</p>
				<p>
					<s n="25" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l167">Genff</placeName>.</s>
				</p>
			</div>
