	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. I. D.</s>
					<s n="2" xml:lang="la">Ex tuae pietatis literis intelligo, vir clarissime, meas <lb xml:id="p1z2"/>nondum redditas esse, cum tamen <persName ref="p8127">Pellicanum</persName>, avunculum meum <lb xml:id="p1z3"/>colendissimum, atque <persName ref="p8171">Theodorum</persName> vestrum librorum fasciculum, <lb xml:id="p1z4"/>quo literae inclusae erant, accepisse non dubitem.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Scripser<lb xml:id="p1z5"/>am autem d. <persName ref="p8121">Christophorum Montium</persName> in domino pie <lb xml:id="p1z6"/>obdormivisse, quo factum est, ut tuas ad eundem literas <lb xml:id="p1z7"/>ab eodem cive <placeName ref="l28">Basiliensi</placeName>, cui eas commiseram, receperim, <lb xml:id="p1z8"/>quas meis inclusas iamdudum te accepisse spero.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Liter<lb xml:id="p1z9"/>as praeterea tuas ab <persName ref="p8126">Oporino</persName> <placeName ref="l157">Francfordiae</placeName> atque <lb xml:id="p1z10"/><placeName ref="l491">Argentinae</placeName> probe curatas dubitare noli, cum homo <lb xml:id="p1z11"/>in alienis potius quam suis curiosior esse soleat <lb xml:id="p1z12"/>rebus.</s>
					<s n="5" xml:lang="la">Novarum rerum nihil habemus modo; communis <lb xml:id="p1z13"/>tamen fama est <persName ref="p18538">Carolum</persName> imperatorem <placeName>Prusellam</placeName> <lb xml:id="p1z14"/>properasse, qui hisce diebus scribas suos, quos <lb xml:id="p1z15"/><placeName ref="l491">Argentinae</placeName> (dum Metis obsidio duraret) reliquerat, <lb xml:id="p1z16"/>in <placeName ref="l822">Germaniam</placeName> etiam Inferiorem revocavit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z17"/>Bombergensis atque <placeName ref="l1030">Herbipolensis</placeName> episcopi exercitum <lb xml:id="p1z18"/>contra marchionem <persName ref="p8371">Albertum</persName> colligere dicuntur, <lb xml:id="p1z19"/>qui exactiones permissione imperatoris ab episco<lb xml:id="p1z20"/>pis urget nondum numeratas.</s>
				</p>
				<p>
					<s n="7" xml:lang="de">Also miessens die <lb xml:id="p1z21"/>bischoff widerspils den passion noch dem alleluja <lb xml:id="p1z22"/>singen, deren Christus noch langem erstanden was.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z23"/>Caetera ex adolescente harum literarum latore probe <lb xml:id="p1z24"/>intelliges.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale cum tota familia.</s>
					<s n="10" xml:lang="la">7. idus f<lb xml:id="p1z25"/>ebruarii anno domini 1553.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z26"/>T[uus] <persName ref="p8406">Lycos<lb xml:id="p1z27"/>t<lb xml:id="p1z28"/>henes</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae antistiti omnium <lb xml:id="p2z4"/>vigilantissimo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
