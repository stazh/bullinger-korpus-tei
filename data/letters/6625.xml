			<zone xml:id="p2z2-0" points="1808,568 1863,576 1890,555 1904,560 1917,551 1960,566 1986,590 2011,584 2015,463 1974,467 1939,486 1931,476 1911,478 1867,443 1853,453 1831,439 1812,445">1820,504 1848,503 1876,501 1904,501 1932,501 1960,499 1988,497 2017,495</zone>
