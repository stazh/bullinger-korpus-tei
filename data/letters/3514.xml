	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Optima fide tuae illae priores mihi sunt redditae.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Gaudeo autem hoc mihi indicatum in tempore, ne ina<lb xml:id="p1z3"/>nem illum meum perderem laborem, cum alioqui <lb xml:id="p1z4"/>satis sit quod alias agam.</s>
					<s n="4" xml:lang="la">Vide autem, mi compater, ne <lb xml:id="p1z5"/>unquam vel iubeas vel conniveas vel sciens et prudens in <lb xml:id="p1z6"/>ullam violentiam consentias.</s>
					<s n="5" xml:lang="la">Non placet mihi, ut hic <lb xml:id="p1z7"/>quicquam vi tentetur.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Rationes plurimas tibi indicarem <lb xml:id="p1z8"/>coram, quas literis committere non est tutum.</s>
					<s n="7" xml:lang="la">Video istos omnes <lb xml:id="p1z9"/>eiusdem esse generis et non posse aut velle emendari, nisi etc.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Quae referuntur apud nos nova sane plurima, pleraque <lb xml:id="p1z11"/>eiusmodi videntur, ut vix sint verisimilia, et quae <lb xml:id="p1z12"/>hic recito, non sunt omnino compertissima, ita tamen ad me <lb xml:id="p1z13"/>perscribuntur ex <placeName>Svevia</placeName> vel Germania ab amicis.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z14"/>Oppida <placeName>Sveviae</placeName> comitia habent <placeName>Eslingiaci</placeName>; nam dicitur <lb xml:id="p1z15"/><persName>Ferdinandus</persName> <placeName ref="l157">Francofurtum</placeName> descensurus, illuc quoque ven<lb xml:id="p1z16"/>turos electores, ut agant de rege Romanorum creando.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z17"/>Alii magis comicum quid futurum arbitrantur, ut reges <lb xml:id="p1z18"/><persName ref="p18477">Ferdinandus</persName> et <persName ref="p3671">Daniae</persName> liberos suos coniungant.</s>
					<s n="11" xml:lang="la">Scribuntur <lb xml:id="p1z19"/>expeditiones bellicas facere <persName>principes Brunsvigi</persName>, <lb xml:id="p1z20"/>Saxonum, margravios <placeName ref="l1048">Brandenburgensem</placeName> et alios quoque.</s>
					<s n="12" xml:lang="la">Alii <lb xml:id="p1z21"/>colligi putant equites in subsidium <persName>Philippi</persName>, alii in <lb xml:id="p1z22"/>gratiam <persName ref="p18477">Ferdinandi</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Fortassis, si sapiunt, consilia <lb xml:id="p1z23"/>sua nolunt cognita esse quibusvis.</s>
					<s n="14" xml:lang="la">Ego ex <placeName ref="l18">Augusta <lb xml:id="p1z24"/>Vindelicorum</placeName> literas expecto; quas ubi accepero, for<lb xml:id="p1z25"/>tassis plura et certiora dabo.</s>
					<s n="15" xml:lang="la">Frendent et tan<lb xml:id="p1z26"/>tum non insaniunt <placeName>Angli</placeName> et <placeName>Belgae</placeName> propter Caletum <lb xml:id="p1z27"/>amissum, et hi quidem militem et pecunias offerunt <lb xml:id="p1z28"/>copiosissimas, ut recuperetur iterum Caletum.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z29"/>De <placeName>Anglis</placeName> varia referuntur.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Alii aiunt eos dissider<lb xml:id="p1z30"/>e graviter, alii dicunt ipsos venturos in <lb xml:id="p1z31"/><placeName>Galliam</placeName> et extrema tentaturos etc.</s>
					<s n="18" xml:lang="la">Dissidere dicuntur <lb xml:id="p1z32"/>in <placeName ref="l749">Saxonia</placeName> graviter Witembergen(sis) et Wim<lb xml:id="p1z33"/>arien(sis) in religionis negotio.</s>
					<s n="19" xml:lang="la">De quo fortassis b<lb xml:id="p1z34"/>revi copiosiora.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Intelligo <lb xml:id="p1z35"/>abbatem Fabariensem <lb xml:id="p1z36"/>totum negotium suum <placeName>Septem Cantonibus</placeName> finiendum <lb xml:id="p1z37"/>tradere, se enim nihil amplius agere posse.</s>
					<s n="21" xml:lang="la">Vellem <lb xml:id="p1z38"/>ego vestrates amica compositione finire <lb xml:id="p1z39"/>molestam hanc caussam; sed hoc dabitur forte, cum <lb xml:id="p1z40"/>indicentur comitia eaque publica.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="salute">Consules meo nomine <lb xml:id="p1z41"/>salutabis amicissime; salutabis et d. <persName>Aurelium <lb xml:id="p1z42"/>Schytarcham</persName>, <persName ref="p6130">Pontasellam</persName>, imprimis d. <persName ref="p8359">Philippum <lb xml:id="p1z43"/>Gallicium</persName> et amicos omnes.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 25. <lb xml:id="p1z44"/>februarii 1558.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z45"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> Rhetiae <lb xml:id="p2z3"/>ecclesiae ministro, <lb xml:id="p2z4"/>compatri et fratri meo <lb xml:id="p2z5"/>charissimo.</s>
					<s n="27" xml:lang="la">Chur.</s>
				</p>
			</div>
