	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Meus ad vos reditus, de quo per <persName ref="p505">Burcherum</persName> scripsi, a <placeName ref="l552">Vilnensi</placeName> procrastinatur, <lb xml:id="p1z2"/>qui vult exitum comitiorum expectari in quibus nunc agitur de ratione et forma <lb xml:id="p1z3"/>eligendi novum regem, si quando iste decederet sine liberis.</s>
					<s n="2" xml:lang="la">Archiepiscopus Gnes[nensis] <lb xml:id="p1z4"/>quidem mortuus est; sed vicecancellarius, qui dicitur ei successisse, contendit ad se <lb xml:id="p1z5"/>pertinere, ut nobilitatem convocet, quum in regno primas obtineat; sed <lb xml:id="p1z6"/><persName ref="p8062">Tarnovius</persName> sese opposuit negans spiritualium hoc esse munus.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Alii et plerique omnes evangelici non tantum ab electione, verum etiam a senatu <lb xml:id="p1z8"/>regio conantur illos in perpetuum excludere, quia novo et execrabili <lb xml:id="p1z9"/>iuramento pontifici sunt obstricti nec habent ipsi, quo se tueantur <lb xml:id="p1z10"/>nisi longissimam praescriptionem, quę nullius est momenti, quandoquidem <lb xml:id="p1z11"/>hoc iuramentum nos latebat.</s>
					<s n="4" xml:lang="la">Idcirca rex in magna perplexita<lb xml:id="p1z12"/>te, quid faciat, nescit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Ego saepius ab illo sum admistus in colloquium <lb xml:id="p1z13"/>solitarium nec frustra cum eius literis <placeName ref="l546">Viennam</placeName> redibo; quid <lb xml:id="p1z14"/>autem sperem aut metuam, non audeo scribere.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Caeterum expendite <lb xml:id="p1z15"/>inclusa folia et, in manus omnium ne veniant, attendite.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/><placeName ref="l2472">Poloni</placeName> cum Tartaris iam pacem habent, et in re <placeName>Barensi</placeName> ad <lb xml:id="p1z17"/>caesaream maiestatem electi sunt palatinus <placeName ref="l260">Cracoviensis</placeName> et cancellarius <lb xml:id="p1z18"/>regni; qui discedent post dominicam Invocavit.</s>
					<s n="8" xml:lang="la">Sed plura <lb xml:id="p1z19"/>ex me vel ex literis, cum mihi fidus se obtulerit nuntius.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Igno<lb xml:id="p1z20"/>scat, obsecro, d. <persName ref="p8111">Martyr</persName> et <persName ref="p3988">Volfius</persName>, quia nunc respondere non <lb xml:id="p1z21"/>licet.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">D. <persName ref="p1283">Gesnero</persName> quoque nonnulla ex his terris afferam, <lb xml:id="p1z22"/>quę iam <placeName>Biacensis</placeName> <placeName ref="l648">Rhętico</placeName> mittenda dedit.</s>
					<s n="11" xml:lang="la">Ignoscite; <lb xml:id="p1z23"/>rursus vocor ad palatinum <placeName ref="l552">Vilnensem</placeName>, ubi fratrum conventus <lb xml:id="p1z24"/>erit.</s>
				</p>
				<p>
					<s n="12" xml:lang="de"><placeName ref="l260">Cracovię</placeName> 23. anni 1560.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z25"/>Ob[servantissimus] fil[ius] <pb/><lb xml:id="p2z1"/><persName ref="p8101">Lęlius</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Clarissimo domino <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, perpetua o<lb xml:id="p2z3"/>bservantia colendo.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>