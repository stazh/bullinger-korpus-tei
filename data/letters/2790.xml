	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, <lb xml:id="p1z3"/>vir clarissime et frater optime.</s>
					<s n="2" xml:lang="la">Dudum nihil abs te <lb xml:id="p1z4"/>literarum accepi; at aveo quidem scire, quid <lb xml:id="p1z5"/>meus agat <persName ref="p495">Bullingerus</persName>, quid symmistae eius, <lb xml:id="p1z6"/>quid tota ecclesia.</s>
					<s n="3" xml:lang="la">Mitto nunc peculiarem <lb xml:id="p1z7"/>nuncium; saltem ab eo fac aliquid intel<lb xml:id="p1z8"/>ligam.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Apud nos omnia in eodem statu; <lb xml:id="p1z9"/>ego pulchre valeo ac laboro noctes diesque, <lb xml:id="p1z10"/>deo gratiae.</s>
					<s n="5" xml:lang="la">Ostendet tibi <persName ref="p8101">Laeliu<lb xml:id="p1z11"/>s</persName> scriptum non quidem valde novum, sed <lb xml:id="p1z12"/>quod tamen non puto te vidisse adhuc.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Audio <persName ref="p2095">Melanthonem</persName> edidisse nuperrime li<lb xml:id="p1z14"/>brum satis papisticum; habeo huius rei <lb xml:id="p1z15"/>locupletissimum testem.</s>
					<s n="7" xml:lang="la">Coepi venari ad <lb xml:id="p1z16"/>eum librum et perveniam; si pervenero, t<lb xml:id="p1z17"/>u quoque visurus es.</s>
					<s n="8" xml:lang="la">Omnino proxim vere <lb xml:id="p1z18"/><placeName ref="l2510">Turca</placeName> irruet in <placeName ref="l2721">Pannoniam</placeName>, <lb xml:id="p1z19"/>qua<lb xml:id="p1z21"/>m ob causam futura sunt comitia <placeName ref="l410">Ratis<lb xml:id="p1z22"/>ponae</placeName> kalendis martii, nempe ubi agatur de <lb xml:id="p1z23"/>contributione, hoc est de apice rerum omnium.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z24"/>D. <persName ref="p458">Brentius</persName> nunc mittet <lb xml:id="p1z25"/>ad praelum secundam partem adversus <lb xml:id="p1z26"/>belluam <placeName>Asoticam</placeName>, valde profecto bon<lb xml:id="p1z27"/>um scriptum; habeo domi ego nunc.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z28"/>Utinam posses intelligere meam versionem <lb xml:id="p1z29"/>primae partis; saepe enim (volente autore) <lb xml:id="p1z30"/>paraphrasten go.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Miror <persName>Appiarium</persName> <lb xml:id="p1z31"/>non misisse e <placeName ref="l41">Berna</placeName> imaginem, pro <lb xml:id="p1z32"/>qua iam iussi dari et datum scio <lb xml:id="p1z33"/>unum coronatum.</s>
					<s n="12" xml:lang="la">Quaeso te, si nondum <lb xml:id="p1z34"/>misit, mone d. <persName ref="p8018">Halerum</persName> tuis literis, ut <lb xml:id="p1z35"/>hominem urgeat.</s>
					<s n="13" xml:lang="la" ana="salute"><pb/><lb xml:id="p2z1"/>Salvere iubeo d. <persName ref="p8011">R[odolphum] Gualterum</persName> et tris generos <lb xml:id="p2z2"/>tuos ac alios quoque fratres.</s>
					<s n="14" xml:lang="la">Obsecro, iu<lb xml:id="p2z3"/>vate me vestris precibus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l496">Stutgardię</placeName> <lb xml:id="p2z4"/>pridie natalis domini 1555.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z5"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse von anderer Hand:]</note>
					<s n="17" xml:lang="la"><lb xml:id="p2z6"/>Clarissimo viro domino <persName ref="p495">Henrico <lb xml:id="p2z7"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z8"/>ecclesiae pastori, fratri honorando.</s>
				</p>
			</div>
		</body>
	</text>
