	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Postscripta.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>S. Reverende in Christo pater, heri scripsi, sed <lb xml:id="p1z3"/>hodie incidi in tabellionem, qui ait se cras discessurum.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Interim huc scribitur <placeName ref="l28">Basilea</placeName> in <placeName ref="l832">Gallia</placeName> novos <lb xml:id="p1z5"/>tumultus concitari, <persName>Condaeum</persName> et ammiralium de <lb xml:id="p1z6"/>integro copias cogere, arcem quandam exustam esse.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Haec si vera sunt, <persName>Gallo</persName> omnia turbabunt.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Sed <lb xml:id="p1z8"/>quod multo quandoque vana spargantur, d. <lb xml:id="p1z9"/>consul et <persName>Carlinus</persName>, sed et ego te rogamus anixe, <lb xml:id="p1z10"/>nos verum doceas; si enim ita se res haberent, <lb xml:id="p1z11"/>non esset consultum nostris turbis istiusmodi <lb xml:id="p1z12"/>se commiscere.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quaeso, nos non celes; anxie <lb xml:id="p1z13"/>expectamus, quid sit.</s>
					<s n="7" xml:lang="la">Non est, quod mercatores <lb xml:id="p1z14"/>expectes; hospes Ciconiae tertio quoque die <lb xml:id="p1z15"/>certos homines cum literis mittit, per eos tu <lb xml:id="p1z16"/>poteris tua curare quoque.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Vale, reverende <lb xml:id="p1z17"/>in Christo pater, et quod tibi toties molestus sum, <lb xml:id="p1z18"/>ignosce.</s>
					<s n="9" xml:lang="la"><placeName ref="l98">Curię</placeName> pridie calendas decembres anno 1564.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/>Tui observantissimus <lb xml:id="p1z20"/><persName ref="p8009">Ioannes Fabricius</persName>.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z21"/>Illud nuncium nos valde terruit; <lb xml:id="p1z22"/>nam si verum esset, <placeName ref="l875">Hispanus</placeName> <lb xml:id="p1z23"/>multa hac occasione posset.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/>Sed speramus meliora.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
