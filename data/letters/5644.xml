	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. Nihil haberem, vir clarissime, quod nunc adderem literus d.
					<lb xml:id="p1z2"/>Calvim, nissi tu argumentum suppeditasses, quum duos libellos
					<lb xml:id="p1z3"/>misisti, quorum alterum mihi statim dedit d. Calvinus, alterum
					<lb xml:id="p1z4"/>vero ubi plegerit se mihi etiam daturum dixit. Ego itaque
					<lb xml:id="p1z5"/>tibiquas possum, non quas debeo. gratias ago pro munere mihi
					<lb xml:id="p1z6"/>gratissimo Iam et decem batzios accepi, sed duos tibi redde
					<lb xml:id="p1z7"/>Trecius noster, ut illi scribo, quia tantum octo impendi tue
					<lb xml:id="p1z8"/>nomine; nam pro 5 libris Italicis numeram asses Sabaudico
					<lb xml:id="p1z9"/>viginti, qui efficiunt sedecim regios et hi respondent octobat
					<lb xml:id="p1z10"/>maioribus sine Germanicis. Utinam aliquid manis et
					<lb xml:id="p1z11"/>gratius possem tuo nomine praestare. Te igitur rogi
					<lb xml:id="p1z12"/>vir clarissime, et obtestor, ut, si qua in re operae mea
					<lb xml:id="p1z13"/>tibi possit esse usui, tantum mihi significes; nam me
					<lb xml:id="p1z14"/>paratissimum semper experieris. D. Calvinus diligentes
					<lb xml:id="p1z15"/>omnia tibi perscribit, quae pro certis habentur, atque possim
					<lb xml:id="p1z16"/>hoc affirmare, nulla occasionem ab eo praetermitti, quin
					<lb xml:id="p1z17"/>scribat. unum nobis molestum est, quod non semper sint
					<lb xml:id="p1z18"/>nobis ad manum, qui istuc proficiscantur. Sed certo scia
					<lb xml:id="p1z19"/>nihil esse mihi iucundius, quam literas d. Calna ad te
					<lb xml:id="p1z20"/>excipere, et sentio, etiam quantum inde fructus prercipiam
					<lb xml:id="p1z21"/>quum video res gestas in Gallia tam conciune conscribi, ut
					<lb xml:id="p1z22"/>saepius admiratione corripiar, dum excipio, quae foecunda
					<lb xml:id="p1z23"/>sua brevitate et eloquentia singulari complectitur. Vale
					<lb xml:id="p1z24"/>vio clarissime et mihi plurimum observande. dominus te diu
					<lb xml:id="p1z25"/>incolumem servet, spiritu suo regat tuosque laboresbene
					<lb xml:id="p1z26"/>ctGenevae 15. martii 1563.
					<lb xml:id="p1z27"/>Budaeus frater te salv
					<lb xml:id="p1z28"/>reverenter. CCar Ionvillaeus tui observantissimus
					<pb/>
					<lb xml:id="p2z1"/>Clarissimo viro d. Henrico Bullingero,
					<lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> fido pastori
					<lb xml:id="p2z3"/>mihi plurimum observando.
					<lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.
				</p>
			</div>
		</body>
	</text>
