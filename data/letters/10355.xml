	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Habes hic literas<note xml:id="fn1" type="footnote" n="1"><persName ref="p8055">Blarer</persName> sandte diesen Brief mit Nachrichten über den <placeName ref="l2481">Schwäbischen</placeName> Bund gemäß seinem früheren Versprechen (s. oben <ref target="file10348">[Nr. 317]</ref> S. 44, 12-14) und verlangte ihn wieder zurück (unten Z. 10). <persName ref="p495">Bullinger</persName> kam offenbar diesem Verlangen nach; der Brief ist nicht mehr erhalten.</note>, unde statum foederis <placeName ref="l2481">Svevici</placeName> <lb xml:id="p1z2"/>et quid <placeName ref="l18">Augustensia</placeName> ista comitia nobis pepererint<note xml:id="fn2" type="footnote" n="2">Die letzte Tagung des Schwäbischen Bundes in <placeName ref="l18">Augsburg</placeName> brachte dessen Auflösung, s. unten S. 65f, 2-18.</note>, <lb xml:id="p1z3"/>quantum satis est, discas.</s>
					<s n="2" xml:lang="la">Occupatissimus <lb xml:id="p1z4"/>nunc sum alioqui plura scripturus.</s>
					<s n="3" xml:lang="la">Dedi <lb xml:id="p1z5"/>ad te literas 20. ianuarii<note xml:id="fn3" type="footnote" n="3">Oben Nr.3 17.</note> nec dubito, <lb xml:id="p1z6"/>quin eas acceperis.</s>
					<s n="4" xml:lang="la">Tuas avide expecto<note xml:id="fn4" type="footnote" n="4">Aus dieser Zeit ist kein Brief <persName ref="p495">Bullingers</persName> an <persName ref="p8055">Ambrosius Blarer</persName> erhalten.</note>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="salute"><lb xml:id="p1z7"/>Saluta universum sanctorum, qui isthic <lb xml:id="p1z8"/>sunt, chorum.</s>
					<s n="6" xml:lang="la" ana="salute">Salutant te nostri omnes, <lb xml:id="p1z9"/>inprimis <persName ref="p4321">uxorcula</persName><note xml:id="fn5" type="footnote" ana="bio" n="5"><persName ref="p4321">Katharina Blarer, geb. Ryff</persName>.</note> et <persName ref="p4334">soror</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p4334">Margaretha Blarer</persName>.</note>.</s>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z10"/>Bene vale, ornatissime <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z11"/>et commenda nos Christo.</s>
					<s n="8" xml:lang="la" ana="salute">Coniugem<note xml:id="fn7" type="footnote" ana="bio" n="7"><persName ref="p8051">Anna Bullinger, geb. Adlischwyler</persName>.</note> <lb xml:id="p1z12"/>tuam meis verbis diligenter saluta.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/><placeName ref="l257">Constantiae</placeName>, 13. februarii 1534.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/>Tuus <persName ref="p8055">Ambr. Blaurerus</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z15"/>Proximo nuncio<note xml:id="fn8" type="footnote" n="8">Unbekannt.</note> remitte, obsecro, has literas.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo <lb xml:id="p2z2"/>viro d. <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tiguri<lb xml:id="p2z4"/>censi</placeName> episcopo, fratri <lb xml:id="p2z5"/>in domino charissimo.</s>
				</p>
			</div>
