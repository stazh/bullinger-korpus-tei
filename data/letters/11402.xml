	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Iam ante quoque scripsi<note xml:id="fn1" type="footnote" n="1"><persName ref="p8459">Werdmüllers</persName> letzter Brief an <persName ref="p495">Bullinger</persName>, der noch erhalten ist, datiert vom 23. Mai 1539; s. <bibl source="b11">HBBW IX</bibl>, <ref target="file11318">Nr. 1275</ref>.</note>, pater inprimis observande, <lb xml:id="p1z2"/>de statu rerum mearum.</s>
					<s n="3" xml:lang="la">Quae num acceperis, ignoro.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z3"/>Nullas enim e patria literas accepi, ex quo <placeName ref="l28">Basilea</placeName><note xml:id="fna" type="footnote" n="a"><placeName ref="l28">Basilea</placeName> <hi>korrigiert aus</hi> <placeName ref="l28">Basileae</placeName>.</note> discessi<note xml:id="fn2" type="footnote" n="2"><persName ref="p8459">Werdmüller</persName> hatte <placeName ref="l28">Basel</placeName> zu Ende des Jahres 1539 verlassen; vgl. unten <ref target="file11429">Nr. 1386</ref>, Anm.1.</note>.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z4"/>Iterum igitur scribo et vehementer oro, ne in aliam partem, <lb xml:id="p1z5"/>atque ego feci, abitum meum interpretari velitis, qui paratus <lb xml:id="p1z6"/>sum et tibi et omnibus, quos deus mihi praefecit<note xml:id="fnb" type="footnote" n="b"><hi>Vor</hi> praefecit <hi>gestrichenes</hi> praeposuit.</note>, per omnia <lb xml:id="p1z7"/>morem gerere.</s>
					<s n="6" xml:lang="la">Nam quod ab hoc, ubi nunc sum, loco solum <lb xml:id="p1z8"/>absterrebat, re ipsa<note xml:id="fnc" type="footnote" n="c"><hi>in der Vorlage</hi> reipsa.</note> comperio sine periculo esse.</s>
					<s n="7" xml:lang="la">Vivo alioqui <lb xml:id="p1z9"/>satis foeliciter laboreque victum mihi paro publice praelegendo.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Itaque deo immortali gratias ago, qui me nusquam destitutum <lb xml:id="p1z11"/>esse patiatur.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Salutabis, obsecro, d. <persName ref="p167">Iacobum Ammanium</persName> <lb xml:id="p1z12"/>et reliquos praeceptores in perpetuum colendos.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z13"/>20. februarii 1540.</s>
					<s n="11" xml:lang="la"><placeName ref="l378">Parrisiis</placeName>, prope collegium Plessia<lb xml:id="p1z14"/>cum in vico Iacobęo<note xml:id="fn3" type="footnote" n="3">Das alte "Collège du Plessis", von Geoffroi du Plessis 1317/1323 gegründet, stand an der Rue Saint-Jacques; vgl. M. <hi>Barroux,</hi> Art. Plessis (Collège du), in: La Grande Encyclopédie, Bd. 26, <placeName ref="l378">Paris</placeName> [s. d.], S. 1090.</note>, ubi tres pisces dependent.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z15"/><persName ref="p8459">Otho Werdmüllerus</persName>, tuus filius <lb xml:id="p1z16"/>obsequentissimus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Celeberrimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrico Bullingero</persName>, domino <lb xml:id="p2z3"/>et patri suo in perpetuum <lb xml:id="p2z4"/>colendo.</s>
					<s n="14" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
