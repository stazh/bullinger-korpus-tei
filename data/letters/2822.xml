			<zone xml:id="p3z3-0" points="1158,943 1688,955 1744,916 1919,923 1923,846 1590,901 1444,875 1364,912 1253,884 1160,901">1167,934 1204,934 1242,932 1280,929 1318,928 1356,927 1393,925 1431,925 1469,925 1507,923 1545,920 1582,918 1620,916 1658,916 1696,913 1734,911 1771,907 1809,904 1847,901 1885,900 1923,905</zone>
			<zone xml:id="p3z4-0" points="1349,1027 1382,1043 1453,1052 1509,1022 1518,1030 1539,1016 1566,1018 1575,952 1532,962 1518,948 1480,971 1453,955 1436,961 1416,943 1373,957 1358,952">1362,1015 1388,1010 1415,1005 1441,1000 1468,998 1494,996 1521,992 1547,990 1574,988</zone>
