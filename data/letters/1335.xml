	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Habes hic, colendissime mi domine <lb xml:id="p1z2"/>et frater, tabellionem, qui ad me bona <lb xml:id="p1z3"/>fide feret, si quid scripturus eras.</s>
					<s n="3" xml:lang="de"><lb xml:id="p1z4"/><foreign xml:lang="la">Ego nihil habeo,</foreign> dann das uß <placeName ref="l834">Italia</placeName> kumpt, <lb xml:id="p1z5"/>der krieg gange sträng vor <placeName ref="l1122">Parma</placeName>.</s>
					<s n="4" xml:lang="de"><placeName ref="l2067">Raven<lb xml:id="p1z6"/>na</placeName> sölle ettwas schadens erlitten haben; <lb xml:id="p1z7"/>den <placeName ref="l832">Französischen</placeName> gange es glücklich etc.</s>
				</p>
				<p>
					<s n="5" xml:lang="de"><lb xml:id="p1z8"/>Die <placeName ref="l522">Venediger</placeName> söllend einer verrätery innen <lb xml:id="p1z9"/>worden sin, die inen die ke<lb xml:id="p1z10"/>yserischen zuͦ<lb xml:id="p1z11"/>gerüst, deßglych die <placeName ref="l1121">Janueser</placeName> <lb xml:id="p1z13"/>ouch einer und söllend übel an dem <lb xml:id="p1z14"/>keyser sin.</s>
					<s n="6" xml:lang="de">Man sagt ouch, die <placeName ref="l303">Magdeburge<lb xml:id="p1z15"/>r</placeName> söllend kurtzlich in einem uußfaal <lb xml:id="p1z16"/>ein grossen syg gehept haben.</s>
					<s n="7" xml:lang="la"><foreign xml:lang="de">Habend <lb xml:id="p1z17"/>ir ettwas, lassend michs wüssen,</foreign> inprimis <lb xml:id="p1z18"/>quomodo habeat concilii negotium.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale.</s>
					<s n="9" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 12. i<lb xml:id="p1z19"/>ulii anno 1551<lb xml:id="p1z20"/>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/><persName ref="p495">Bullinger</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro <lb xml:id="p2z2"/>d. <persName ref="p8418">Osvaldo My<lb xml:id="p2z3"/>conio</persName>, domino hon<lb xml:id="p2z4"/>orando et fratri <lb xml:id="p2z5"/>charissimo suo.</s>
				</p>
			</div>
		</body>
	</text>
