	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>D. <persName ref="p495">Bullingero</persName> <persName ref="p8432">Federicus a Salice</persName> S. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Isto hoc momento tuas ad me datas accepi hic <placeName ref="l98">Churiae</placeName>, quo me <lb xml:id="p1z3"/>festinanter ob quaedam negocia mihi incumbentia contuli.</s>
					<s n="3" xml:lang="la">Sed et <lb xml:id="p1z4"/>illas habui, quas tuo gnato mitti optas, illasque sedulo de<lb xml:id="p1z5"/>ferendas curabo.</s>
					<s n="4" xml:lang="la">Novi porro, quod scribere queam, nil habeo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Gratissima autem fuere nova illa, quorum me in penultimis tuis <lb xml:id="p1z7"/>litteris religionis incrementum significantibus, reddis certiorem, <lb xml:id="p1z8"/>idemque deus, qui gloriam suam in fidelibus suis dilatare in<lb xml:id="p1z9"/>coepit foelicissime, bene incoeptum opus foecundet et iugiter pro<lb xml:id="p1z10"/>moveat, et utique rogandus est interim, ut et novi <placeName ref="l832">Galliarum</placeName> <lb xml:id="p1z11"/>regis cor commoveat, ut pietatem et veram religionem amplectetur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Hic omnia succedunt satis prospere, excepto quod passim <lb xml:id="p1z13"/>rerum ad victum necessarium est permaxima penuria.</s>
					<s n="7" xml:lang="la">Dominus deus omnibus <lb xml:id="p1z14"/>egenis subveniat.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Reliquum, quod scribam, hoc est, ut me mutuo <lb xml:id="p1z15"/>ames meque tibi perpetuo habeas commendatum.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale, colendissime <lb xml:id="p1z16"/>domine.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Datum <placeName ref="l98">Churiae</placeName> in aedibus domini <persName ref="p8009">Ioannis Fabricii</persName> festi<lb xml:id="p1z17"/>nantissime.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z18"/>1559, primo calen[das] augusti.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z19"/>Idem qui semper tibi deditissimus <lb xml:id="p1z20"/><persName ref="p8432">Federicus a Salice</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/>Postscripta.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Hisce meis raptim exaratis perlegi postea et alias <lb xml:id="p1z22"/>litteras per filium tuum d. <persName ref="p487">Henricum</persName> ad me datas, quibus etiam aliae <lb xml:id="p1z23"/>sunt inclusae spectantes filio tuo <persName ref="p475">Christophoro</persName>.</s>
					<s n="15" xml:lang="la">Illas itaque una <lb xml:id="p1z24"/>tuis ad <persName ref="p475">Cristopherum</persName> nostrum tuto deferri curabo deo dante <lb xml:id="p1z25"/>et id ipsum significabis nomine meo filio tuo <persName ref="p487">Henrico</persName>, cui me <lb xml:id="p1z26"/>plurimum commendabis.</s>
					<s n="16" xml:lang="la" ana="farewell">Iterum vale.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo et clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, domino ac patrono meo <lb xml:id="p2z3"/>iugiter colendissimo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
