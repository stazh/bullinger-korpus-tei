	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><persName ref="p506">Buttlerus</persName> vero noster tuam erga se officiosam humanitatem <lb xml:id="p1z2"/>mirifice praedicat et amore studioque tui iam inde a multis annis <lb xml:id="p1z3"/>vehementer flagrat, vir, si quisquam alius, divini verbi amans <lb xml:id="p1z4"/>ac pietatis observantissimus.</s>
					<s n="3" xml:lang="la">Quod <placeName ref="l572">Wirtempergensi</placeName> ab <placeName ref="l850">Austriacis</placeName> <lb xml:id="p1z5"/>istis tantopere metuis, non frustra facis; nam sunt ex prudentiori<lb xml:id="p1z6"/>bus sęculi huius non pauci, qui istuc ipsum plusquam persuasum habent.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Ego coniecturis nonnullis adducor, ut vera putem, quae ad te scripsi, <lb xml:id="p1z8"/>praesertim quum nihil aliud a quoquam hisce diebus acceperim.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/><persName ref="p3988">Wolphio</persName> nostro ampliores ędes contigisse supra modum gratulor; <lb xml:id="p1z10"/>praestat enim una esse adulescentes idque perpetuo quam aliis ędibus <lb xml:id="p1z11"/>noctu aliis interdiu immorari.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Gratias tibi maximis maiores <lb xml:id="p1z12"/>agimus, quod hic nobis tanta diligentia advigilas, quanta <lb xml:id="p1z13"/>in omnibus aliis soles.</s>
					<s n="7" xml:lang="la">Utinam paria tecum facere per occasionem aliquam <lb xml:id="p1z14"/>aliquando nobis liceat!</s>
				</p>
				<p>
					<s n="8" xml:lang="la">De principum ludo festiviter tu quidem; <lb xml:id="p1z15"/>facile profecto tredecim seniculis pedes abluuntur; sed non perinde <lb xml:id="p1z16"/>copiosus ille sanguinis cruor multorum milium eluitur.</s>
					<s n="9" xml:lang="la">O praeposteram <lb xml:id="p1z17"/>religionem!</s>
					<s n="10" xml:lang="la">Dominus illos mentibus se magis dignis propitius donet!</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z18"/>De <persName ref="p467">Bucero</persName> securum te esse iubeo; nam scio illum Christi gloriam unice quaerere.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z19"/>Mitto epistolam, quam <persName ref="p8440">Gervasius</persName> noster post <persName ref="p506">Buttleri</persName> abitum dedit, <lb xml:id="p1z20"/>quamquam non adeo multum fidei iis, quę ibi leguntur, habeo; <lb xml:id="p1z21"/>verum, sive vera sint sive fictu, lectu tamen non sunt iniucunda; <lb xml:id="p1z22"/><foreign xml:lang="de">ists nitt war, so laut es doch wol.</foreign></s>
				</p>
				<p>
					<s n="13" xml:lang="la">Consul <placeName ref="l320">Memingensis</placeName> <placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z23"/>et <placeName ref="l441">Scaphusii</placeName> fuit miratus tuas et <persName ref="p3481">Simperti</persName> contiones, <lb xml:id="p1z24"/>quę a <placeName ref="l832">Galli</placeName> foedere tantopere dehortentur.</s>
					<s n="14" xml:lang="la">Sed dominum obni<lb xml:id="p1z25"/>xe precor, ut vos sibi arctissimo fidei foedere astringere et ab omnibus <lb xml:id="p1z26"/>impietatis vinculis vindicet ac servet!</s>
					<s n="15" xml:lang="la">Sed valebis nunc, <lb xml:id="p1z27"/>mi venerande pariter et optime <persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute">Urget consobrinus, <lb xml:id="p1z28"/>ut manum tollam, qui te tam officiosissime iubet salvere.</s>
					<s n="17" xml:lang="la" ana="salute">Salveat <lb xml:id="p1z29"/>tua domus tuique omnes.</s>
					<s n="18" xml:lang="la">Orate pro nobis instantissime.</s>
					<s n="19" xml:lang="de">4. maii 1548.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Tuus <persName ref="p8055">Ambrosius <lb xml:id="p1z30"/>Blaureru<lb xml:id="p1z31"/>s</persName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Liber, quem <persName ref="p506">Buttlerus</persName> noster exhibuit, <lb xml:id="p1z32"/>supra veri fidem mihi arridet, <lb xml:id="p1z33"/>quod in tempore sit scriptus <lb xml:id="p1z34"/>et vehementer dolet, quod <lb xml:id="p1z36"/>noster typographus iam plus <lb xml:id="p1z38"/>integro biennio cessavit; <lb xml:id="p1z39"/>curabo tamen, si ulla ratione <lb xml:id="p1z40"/>fieri possit, ut vel hic vel <lb xml:id="p1z41"/>alibi typis diligentissime, ut dignus <lb xml:id="p1z42"/>certe est, excudatur.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Incomparabili Iesu Christi servo <lb xml:id="p2z2"/>D. <persName ref="p495">Heinricho Bullingero</persName>, fratri suo <lb xml:id="p2z3"/>praeter cęteros observando lo<lb xml:id="p2z4"/>ngeque charissimo.</s>
					<s n="23" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
