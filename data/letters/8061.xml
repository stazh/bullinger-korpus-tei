	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Ab amplissimis viris a republica nostra <placeName>Badam</placeName> missis <lb xml:id="p1z2"/>binas tuas, chare frater, accepi nec habeo, quod nunc <lb xml:id="p1z3"/>ad te rescribam.</s>
					<s n="3" xml:lang="la">Ante 8 dies nullas ad te dedi, quod <lb xml:id="p1z4"/>praeter ea, quae prius et ultimo scripseram, nihil <lb xml:id="p1z5"/>esset allatum ut ne nunc quidem.</s>
					<s n="4" xml:lang="la">Scripsit quidem <lb xml:id="p1z6"/>regis legatus <persName>Bellevreus</persName> multa de prelio et captivitate, <lb xml:id="p1z7"/>vulneribus et nece admiraldi; sed nunc audio <lb xml:id="p1z8"/>vana esse illa omnia et ipsum literis non recte informatum <lb xml:id="p1z9"/>incerta dedisse pro certis.</s>
					<s n="5" xml:lang="la">Dicitur admiraldus <lb xml:id="p1z10"/>vivere nec captus nec vulneratus esse, id quod haud <lb xml:id="p1z11"/>dubie iam audisti a <persName>Pellicario</persName> et <persName>Lumaga</persName> recta <lb xml:id="p1z12"/><placeName ref="l301">Lugduno</placeName> venientibus.</s>
					<s n="6" xml:lang="la">Sed et aliunde refertur rem <lb xml:id="p1z13"/>longe aliter esse gestam et habere in <placeName ref="l832">Gallia</placeName>, quam spargatur.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Ego tamen nihildum tibi dixero certi propter vari<lb xml:id="p1z15"/>antes et contrarias narrationes necdum ullas <lb xml:id="p1z16"/>accepi literas vel <placeName ref="l41">Berna</placeName> vel <placeName ref="l49">Bienna</placeName> vel <placeName ref="l339">Noviobu<lb xml:id="p1z17"/>rgo</placeName> vel <placeName ref="l167">Geneva</placeName>.</s>
					<s n="8" xml:lang="la">Ubi aliquid nunciatum fuerit <lb xml:id="p1z18"/>communicabo tecum ac vereor quidem utrinque plus <lb xml:id="p1z19"/>nimium sanguinis effusum, nondum tamen credere possum <lb xml:id="p1z20"/>rem ita esse gestam penitus, sicut narrat <persName>Bellevreius</persName>, <lb xml:id="p1z21"/>cum ipsa narratio alicubi secum pugnet et studium <lb xml:id="p1z22"/>partis adversae vehementer, quod mirum non est, redoleat <lb xml:id="p1z23"/>nec moderati quidpiam habeat; singula enim <lb xml:id="p1z24"/>Franciscant, et ex musca aquilam faciunt, ut moris <lb xml:id="p1z25"/>est illius.</s>
					<s n="9" xml:lang="la">Dominus luctuosum hoc bellum benigne com<lb xml:id="p1z26"/>ponere et pacem suis concedere dignetur per suam in<lb xml:id="p1z27"/>effabilem misericordiam nosque servare a malo.</s>
					<s n="10" xml:lang="la">Dum haec <lb xml:id="p1z28"/>scribo 9. antemeridiana nihildum Bada allatum est.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z29"/>Pridie nunciabat d. consul nihildum certi allatum esse <lb xml:id="p1z30"/>de prelio, id quod multi interpretantur aliter rem gestam, <lb xml:id="p1z31"/>quam hactenus sit nunciatum, <lb xml:id="p1z32"/>alioqui dudum fuisse perscriptum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Interea audio ex aula <lb xml:id="p1z33"/><persName>Bellevreium</persName> accepisse literas post illud nuncium, quod <lb xml:id="p1z34"/>cons[ulem] fecisse dixi.</s>
					<s n="13" xml:lang="la">Expectamus ergo, quid ille rursus sit <lb xml:id="p1z35"/>prolaturus.</s>
					<s n="14" xml:lang="la">Sed quid credas toties fallenti?</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Vale.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z36"/>Dominus confirmet nos in veritate et liberet a malo!</s>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z38"/>Saluta d. consules<note type="margin">a.R.: cos.</note>, <persName>Carolum</persName>, <persName ref="p8186">Bonettum</persName>, <persName ref="p6130">Pontisellam</persName>, <persName ref="p20473">Ganthnerum</persName> et <lb xml:id="p1z39"/>precipue d. <persName ref="p2776">Ruinellam</persName> et amicos alios una cum domo <lb xml:id="p1z40"/>tua.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName> Simonis et Iudae festinanter 1569.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z41"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <persName ref="p8016">Tobiae <lb xml:id="p2z2"/>Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae fideli ministro, <lb xml:id="p2z4"/>domino meo hon<lb xml:id="p2z5"/>orando et fratri charissimo.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
