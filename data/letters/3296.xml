	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Vix scribere desii, rursus ordior, sed paucis <lb xml:id="p1z2"/>absolvam.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Heri librum misi cum literis, quae ut <lb xml:id="p1z3"/>probe curarentur, socero tuo tradidi.</s>
					<s n="4" xml:lang="la">Interea ultimas <lb xml:id="p1z4"/>tuas accepi.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">D. <persName ref="p629">Coignetius</persName> hac transiit demum <lb xml:id="p1z5"/>28. augusti 7 abhinc diebus.</s>
					<s n="6" xml:lang="la">Multa mihi retulit <lb xml:id="p1z6"/>et quidem ea quoque, quae tu de adventu <persName ref="p20858">Guysiani ducis</persName> <lb xml:id="p1z7"/>commemoras.</s>
					<s n="7" xml:lang="la">Excipiet hunc magistratus (si modo <lb xml:id="p1z8"/>hic aliquamdiu substiterit; scis celeribus transeuntes <lb xml:id="p1z9"/>equis non diu morari in uno loco) et aget <lb xml:id="p1z10"/>cum illo, quod vos instituistis; utinam bene vertat <lb xml:id="p1z11"/>dominus!</s>
					<s n="8" xml:lang="la">Forma supplicationis elegans et apposita est; <lb xml:id="p1z12"/>non videtur in ea mutandum quicquam, quamquam nunc omnino obla<lb xml:id="p1z13"/>tam existimem.</s>
					<s n="9" xml:lang="la">Versabuntur milites <placeName ref="l832">Gallici</placeName> in summo <lb xml:id="p1z14"/>discrimine, si duces discedant ipsosque in medio <lb xml:id="p1z15"/>hostium relinquant.</s>
					<s n="10" xml:lang="la">Videntur haec omnia tendere ad in<lb xml:id="p1z16"/>fortunium aliquod non leve.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Multo tutius et melius <lb xml:id="p1z17"/>relicta <placeName ref="l834">Italia</placeName> redirent in <placeName ref="l832">Galliam</placeName>.</s>
					<s n="12" xml:lang="la">Sed eunt et <lb xml:id="p1z18"/>redeunt, quo haud dubie fata, quod dicitur, trahunt.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">De <lb xml:id="p1z19"/><placeName ref="l2520">Svitensibus</placeName> varii seruntur sermones.</s>
					<s n="14" xml:lang="la">Constat satis illos <lb xml:id="p1z20"/>meditari de recuperanda libertate; sed cum graves <lb xml:id="p1z21"/>habeant adversarios, qui tales sunt, ignoratur, quo res <lb xml:id="p1z22"/>sit inclinatura.</s>
					<s n="15" xml:lang="la">Summa contentione animorum illa res <lb xml:id="p1z23"/>geritur, et fortassis proximis comitiis ea de re agetur <lb xml:id="p1z24"/><placeName ref="l21">Badae</placeName> ad 5. septembris.</s>
					<s n="16" xml:lang="la" ana="salute">Oremus dominum, ut omnia ad <lb xml:id="p1z25"/>salutem patriae cedant.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Vale cum omnibus fratribus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z26"/><placeName ref="l587">Tiguri</placeName> 3. septembris <lb xml:id="p1z27"/>1557.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z28"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p8009">Ioanni Fabritio</persName>, <lb xml:id="p2z3"/>fideli <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z4"/>ecclesiae ministro, com<lb xml:id="p2z5"/>patri et fratri suo <lb xml:id="p2z6"/>charissimo.</s>
					<s n="21" xml:lang="de"><lb xml:id="p2z7"/>Dem pfarrer zuͦ <lb xml:id="p2z8"/>Sant Martin ze <lb xml:id="p2z9"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>