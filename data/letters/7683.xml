	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Certi quod adfirmem non habeo.</s>
					<s n="3" xml:lang="la">Habeo quidem <lb xml:id="p1z2"/>ex <placeName ref="l808">Belgio</placeName> et <placeName ref="l832">Gallia</placeName> aliqua, sed quae rursus <lb xml:id="p1z3"/>scriptis adversariis evertuntur et redduntur incerta.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Alia itaque expecto, sive illa sunt felicia sive <lb xml:id="p1z5"/>infelicia.</s>
					<s n="5" xml:lang="la">Scribam alias, si vixero, quae <lb xml:id="p1z6"/>videbuntur et amici dederint.</s>
					<s n="6" xml:lang="la">Nunc mitto, quaedam, <lb xml:id="p1z7"/>quae huc sunt missa a viro quodam celebri, <lb xml:id="p1z8"/>neque illa ausim adfirmare pro certis; pro certiss<lb xml:id="p1z9"/>imis huc sunt missa.</s>
					<s n="7" xml:lang="la">Tu utere iis prudenter.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Tuae literae mihi sunt redditae.</s>
					<s n="9" xml:lang="la">In iis cum nil <lb xml:id="p1z11"/>sit, ad quod respondere oporteat, et alioqui multis <lb xml:id="p1z12"/>sim occupatus, condonabis brevitati literarum <lb xml:id="p1z13"/>mearum.</s>
					<s n="10" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="11" xml:lang="la">Dominus benedicat tibi et familiae <lb xml:id="p1z14"/>tuae.</s>
					<s n="12" xml:lang="la">Noli solicitus esse propter res tuas; dominus pro<lb xml:id="p1z15"/>videbit.</s>
					<s n="13" xml:lang="la">Tu sis fidelis; dominus non deseret.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">S<lb xml:id="p1z16"/>aluta amicos omnes, quos nosti.</s>
					<s n="15" xml:lang="la">Septimana hac <lb xml:id="p1z17"/>mortuus est vir optimus <persName ref="p3015">Bernardus Sprünglius</persName>; <lb xml:id="p1z18"/>sic quotidie imminuuntur boni etc.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z19"/>3. decembris 1568.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <lb xml:id="p2z2"/><persName ref="p8016">Tobiae Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro <lb xml:id="p2z4"/>fideli, domino <lb xml:id="p2z5"/>colendo et fratri <lb xml:id="p2z6"/>charissimo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
