	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nunc scribo magistratui amplissimo, quę luctuosa intellexi de morte <lb xml:id="p1z2"/>regis <persName>Henrici*</persName>, cui successit filius <persName>Franciscus</persName>.</s>
					<s n="3" xml:lang="la">Ei sanum consilium et piam m<lb xml:id="p1z3"/>entem optare omnes debent, utque ardeat zelo domus dei et subditi vera <lb xml:id="p1z4"/>doctrina instituantur.</s>
					<s n="4" xml:lang="la">Id a dei voluntate dependet.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Oro, ut ad me, cum <lb xml:id="p1z5"/>erit ocium, scribas capita eorum, de quibus regem pium admonendum existimas <lb xml:id="p1z6"/>et in quibus erratum putas, cum scias nulla in re nos magis posse mereri <lb xml:id="p1z7"/>de corpore quam in sanando oculo**.</s>
					<s n="6" xml:lang="la">Ex <placeName ref="l522">Venetiis</placeName> intellexi pugnam <lb xml:id="p1z8"/>commissam inter duos fratres <placeName ref="l2510">Turce</placeName> filios et ab ut[r]aque parte cęsa <lb xml:id="p1z9"/>plus quam quadraginta milia, postquam protractum prelium per diem integrum et sequentem <lb xml:id="p1z10"/>usque ad tertiam horam post meridiem.</s>
					<s n="7" xml:lang="la">Puto te intellexisse de controversia <lb xml:id="p1z11"/>inter <persName>Palatinos</persName> et <persName>Bavarum</persName> pro possessionibus, et quam male omnes conveniant <lb xml:id="p1z12"/><placeName ref="l18">Auguste</placeName> de religione et contributione in <placeName ref="l2510">Turcam</placeName>.</s>
					<s n="8" xml:lang="la" ana="salute">Potens est deus convertere <lb xml:id="p1z13"/>omnia ad gloriam nominis sui et suorum salutem.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Salutabis amicos omnes.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l760">Sol[<lb xml:id="p1z14"/>uturi]</placeName> 20. iulii.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z15"/>Tuus ex animo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho Bullingero</persName>.</s>
				</p>
				<p>
					<note>[Darunter von Bull. s Hand:]</note>
					<s n="14" xml:lang="la"><lb xml:id="p2z2"/><persName ref="p8112">Regis Galliarum</persName> <persName ref="p8112">Heinric<lb xml:id="p2z3"/>hi</persName> 2. mors iulii <lb xml:id="p2z4"/>10. 1559.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z5"/>Fracta lancea est vul<lb xml:id="p2z6"/>neratus in fronte supra <lb xml:id="p2z7"/>dextrum oculum; ex eo <lb xml:id="p2z8"/>vulnere obiit mortem.</s>
				</p>
				<p>
					<note>[<persName>Heinrich II.</persName> mort. 12. Juli 1559; *vgl. HB an Kg. Franz II 1559 anfangs Aug.]</note>
				</p>
			</div>
		</body>
	</text>
