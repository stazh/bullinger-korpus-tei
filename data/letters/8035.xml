	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ne multiplicia tua negotia, reverendissime <lb xml:id="p1z2"/>domine, meis non necessariis literis parum <lb xml:id="p1z3"/>verecunde interpellam, parcior ad te nunc <lb xml:id="p1z4"/>ero, praesertim cum ex <placeName ref="l834">Italia</placeName> nihil scriptione <lb xml:id="p1z5"/>magnopere dignum habeamus.</s>
					<s n="3" xml:lang="la">Unum est, quod <lb xml:id="p1z6"/>te iampridem cognovisse arbitror, quam digne <lb xml:id="p1z7"/>videlicet nuper Lucae in turbis quibusdam <lb xml:id="p1z8"/>inquisitor cum ministris suis sit interfectus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Nec puto etiam te latere oratoris nostri filiolum ab <lb xml:id="p1z10"/>episcopo nostro nuper tinctum esse cum sputo et <lb xml:id="p1z11"/>sale.</s>
					<s n="5" xml:lang="la">Interim literas illas procuravi ad rempublicam <lb xml:id="p1z12"/><placeName ref="l41">Bernensem</placeName>; reliquas amplissimo vestro magistratui et <lb xml:id="p1z13"/>cuidam civi pertinentes per Lucium mittere et <lb xml:id="p1z14"/>curare potes, ne quid tibi negocii faciant.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Ex <placeName ref="l2510">Turcia</placeName> nihil esse d. d. <persName ref="p2776">Ruinella</persName> hodie monuit, <lb xml:id="p1z16"/>qui me ad dominum in arcem invitaverat.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/>Haec ad te verbosius, quam putaram.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Vale, prae<lb xml:id="p1z18"/>clarissime vir reverendissimeque d. pater.</s>
					<s n="9" xml:lang="la">Te <lb xml:id="p1z19"/>Iesus salvator mundi nobis omnibus quam diutissime <lb xml:id="p1z20"/>conservet incolumem.</s>
					<s n="10" xml:lang="la" ana="salute">Salutant tuam <lb xml:id="p1z21"/>praestantiam d. d. consules, d. <persName ref="p1770">Carolus</persName>, d. <persName ref="p8186">Bonettus</persName>, <lb xml:id="p1z22"/>d. <persName ref="p20473">Gantnerus</persName>, d. <persName ref="p6130">Pontisella</persName> et inprimis d. d. <persName ref="p2776">Ruinella</persName>.</s>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p1z23"/>Salutabis et nobis d. <persName ref="p1453">W[olfgangum] Hallerum</persName>, d. <persName ref="p1012">Ernium</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p1012">Leonhard Erni</persName>.</note> <lb xml:id="p1z24"/>totamque tuam praeclaram et humanissimam domum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z25"/><placeName ref="l98">Curiae</placeName> 1569 10. octobris.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">T[uae] <lb xml:id="p1z26"/>d[ominationis] <lb xml:id="p1z27"/>addictissimus <persName ref="p8016">Thobias Iconius</persName><lb xml:id="p1z28"/>.</s>
				</p>
