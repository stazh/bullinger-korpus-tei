	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et vitae innocentiam a Domino.</s>
					<s n="2" xml:lang="la">Non est, ut multis tecum verbis <lb xml:id="p1z2"/>agam, charissime <persName ref="p495">Bullingere</persName>.</s>
					<s n="3" xml:lang="la">In magna sumus conturbatione.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z3"/>Coeptum est agi contra pensionarios, ut corrigantur et in <lb xml:id="p1z4"/>ordinem redigantur; illorum tamen impudentia per multi<lb xml:id="p1z5"/>tudinem et sublimitatem personatorum hominum tantas nacta est <lb xml:id="p1z6"/>vires, ut iuri stare renuant.</s>
					<s n="5" xml:lang="la">Interea omnem <lb xml:id="p1z7"/>culpam in nos, qui verbum Dei annuntiamus, reiiciunt, eo quod <lb xml:id="p1z8"/>pro contionibus huic sceleri semper restiterimus.</s>
					<s n="6" xml:lang="la">Affingunt <lb xml:id="p1z9"/>nobis mendatia foeda, sermones invertunt, ita ut <lb xml:id="p1z10"/>in maiori periculo quam nunc fuerimus nunquam.</s>
					<s n="7" xml:lang="la">Hoc tantum <lb xml:id="p1z11"/>a te et fratribus exoratum volumus, ut cum ecclesia vestra <lb xml:id="p1z12"/>pro nobis orare ad Dominum velitis, quatenus ex bis turbis <lb xml:id="p1z13"/>liberati ad vitae tranquillitatem commode perveniamus.</s>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z14"/>Vale una cum fratribus omnibus.</s>
					<s n="9" xml:lang="la">21. Februarii 42.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/>Tui <persName ref="p396">Ioannes Blasius</persName>, <lb xml:id="p1z16"/><persName ref="p654">Ioannes Comander</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z17"/>Praesentium lator <persName ref="p3958">Stephanus</persName> omnem rem melius indicabit, quam scribere <lb xml:id="p1z18"/>potuerimus; hunc et tibi commendatum fore rogamus<pb/><lb xml:id="p2z1"/>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z2"/>Pietate et doctrina ornatissimo <lb xml:id="p2z3"/>viro magistro <persName ref="p495">Heinrico <lb xml:id="p2z4"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z5"/>episcopo, amico ac in <lb xml:id="p2z6"/>Christo fratri primario.</s>
				</p>
			</div>
		</body>
