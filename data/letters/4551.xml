	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">Non erat, quod ageres gratias, quod <placeName ref="l21">Badenam</placeName> sim profectus; nihil enim <lb xml:id="p1z3"/>mihi magis est in votis, quam ut <placeName>13 Pagi</placeName> in amicitia maneant et <lb xml:id="p1z4"/>unione, ex qua creverunt, nec seditiosis et inimicis prębeant aures; <lb xml:id="p1z5"/>ea in re nihil in posterum pretermittam.</s>
					<s n="3" xml:lang="la">Paterniaci nihil omnino effectum, <lb xml:id="p1z6"/>quod regis procurator actorem se constituerit in moderatione usurarum <lb xml:id="p1z7"/>in eoque diverse fuerint iudicum sententię.</s>
					<s n="4" xml:lang="la">Brevi <placeName ref="l1107">Tridenti</placeName> indicturus <lb xml:id="p1z8"/>est consilium papa, in eoque cesserunt ei imperator et reges cristianissimus et catolicus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Mense proxime <placeName ref="l832">Gallie</placeName> consilia fient <placeName ref="l367">Aurelię</placeName> inter arma; de nationali consilio <lb xml:id="p1z10"/>nulla fit mentio.</s>
					<s n="6" xml:lang="la"><persName>Cardinalis Turnonius</persName> post <placeName ref="l691">Lotoringum</placeName> multum potest apud <lb xml:id="p1z11"/>regem.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Sed sepissime, cum humana desunt auxilia, dominus suam vim <lb xml:id="p1z12"/>magis exerit.</s>
					<s n="8" xml:lang="la">Nihil adhuc intellexi, quid <placeName ref="l41">Bernenses</placeName> <placeName ref="l339">Neocomi</placeName> egerint <lb xml:id="p1z13"/>cum <placeName ref="l2478">Sabaudi</placeName> legatis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Salutant te uxor et liberi; salutabis amicos <lb xml:id="p1z14"/>omnes et nos amabis.</s>
					<s n="10" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l760">Solut[uri]</placeName> 22. novembris</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z15"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesie <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
					<s n="14" xml:lang="la"><placeName ref="l587">Tigury</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
