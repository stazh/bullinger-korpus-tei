	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hodie communibus amplissimi senatus votis et suffragiis <lb xml:id="p1z2"/>electus est in ecclesiae nostrae diaconum <persName ref="p1553">Christianus Hochholtzerus</persName>, <lb xml:id="p1z3"/>atque ita ipsius electio tuum praevenit, quod expectaveram, consilium.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Vocatur huc ad aliquot dies, ut ecclesia ipsum videat et audiat sicque <lb xml:id="p1z5"/>confirmetur.</s>
					<s n="4" xml:lang="la">Vocatur ea conditione ad diaconatum, ut aliquo ex t<lb xml:id="p1z6"/>riade nostra deficiente ipse certo succedat atque interea paulatim <lb xml:id="p1z7"/>ecclesiae mores addiscat.</s>
					<s n="5" xml:lang="la">Non visum est senatui illum petere ab <lb xml:id="p1z8"/>illustribus dominis <placeName ref="l587">Tigurinis</placeName>, partim ne denuo plus satis iilis sint <lb xml:id="p1z9"/>in expetendis ministris molesti, partim vero quia non videbatur <lb xml:id="p1z10"/>opere pretium esse, quia iam prius sub ipsorum dominio degat, neque <lb xml:id="p1z11"/>existimant vos, qui <placeName ref="l2">Aroviensibus</placeName> ipsum concesseritis, eum ipsis <placeName ref="l41">Bernensibus</placeName> <lb xml:id="p1z12"/>denegaturos.</s>
					<s n="6" xml:lang="la">Scripsi etiam ego illi.</s>
					<s n="7" xml:lang="la">Habebit sine dubio ante omnia vestrum <lb xml:id="p1z13"/>consilium.</s>
					<s n="8" xml:lang="la">Vos ergo rogo, ne nobis hac in parte desitis aut <lb xml:id="p1z14"/>illius vocationem tam necessariam impediatis.</s>
					<s n="9" xml:lang="la">Labora, obsecro, apud <lb xml:id="p1z15"/>senatum, si intellexeris aliquam difficultatem ingruere velle; <lb xml:id="p1z16"/>erit hoc nobis, ipsi et ecclesiae ornamento et utilitati.</s>
					<s n="10" xml:lang="la">Postulant <lb xml:id="p1z17"/>idem communibus votis fratres omnes.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">De obitu <persName>Leopoldi</persName> nostri, item <lb xml:id="p1z18"/>D. <persName>Bartholomaei Meisteri</persName> iam pridem certior factus es.</s>
					<s n="12" xml:lang="la">Apud nos <lb xml:id="p1z19"/>quoque paulatim pestis ingruit.</s>
					<s n="13" xml:lang="la">Iam <persName ref="p20454">Iudith</persName>, senior filia <lb xml:id="p1z20"/>D. <persName ref="p8417">Musculi</persName> nostri, proxima die solis peste correpta iam quasi <lb xml:id="p1z21"/>animam agit, ut exigua illius vitae spes supersit.</s>
					<s n="14" xml:lang="la">Ita variis modis <lb xml:id="p1z22"/>affligitur vir optimus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Dominus consoletur pisum et nos in voluntate sua <lb xml:id="p1z23"/>dirigat in finem usque, ut vigilantes inveniamur et parati, quan<lb xml:id="p1z24"/>docunque ipsi placuerit vocare nos!</s>
				</p>
				<p>
					<s n="16" xml:lang="la">D. quaestor <persName ref="p8012">Hallerus</persName> pet<lb xml:id="p1z25"/>it se apud te excusari, quod ad proximas tuas non responderit; po<lb xml:id="p1z26"/>dagra enim illum iam integro mense vexavit domique detinuit; <lb xml:id="p1z27"/>incipit iam aliquantum revalescere.</s>
					<s n="17" xml:lang="la" ana="salute">Is quoque te salutat; sic uxor <lb xml:id="p1z28"/>mea et mei omnes, <persName ref="p8417">Musculus</persName> quoque te cum tuis omnibus plurimum salutant.</s>
					<s n="18" xml:lang="la" ana="salute"><lb xml:id="p1z29"/>Salutem ex me quoque dicas fratribus omnibus.</s>
					<s n="19" xml:lang="la">Plura iam scribenda <lb xml:id="p1z30"/>non occurrunt festinante nuncio; si quid exciderit, proxime scribam.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z31"/>Dominus te servet et custodiat, amen.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l41">Bernae</placeName> 20. novembris 1549.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z32"/>Tuus <persName ref="p8018">Ioannes <lb xml:id="p1z33"/>Hallerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro D. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, fidelisimo <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori, domino et <lb xml:id="p2z4"/>compatri venerando.</s>
				</p>
			</div>
		</body>
	</text>
