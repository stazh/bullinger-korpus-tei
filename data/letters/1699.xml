	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Plura cum plus ocii nactus fuero; haec ad te festinans ac raptim <lb xml:id="p1z2"/>scribo.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Nullas omnino abs te literas intervallo iam 10 <lb xml:id="p1z4"/>mensium accepimus; quod ipsum demirari satis non possum.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Obli<lb xml:id="p1z5"/>tum te nostri non puto, siquidem causa eius tibi nulla est data.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Tamen e contra diuturnum hoc tuum ac pestiferum silentium <lb xml:id="p1z7"/>mirum in modum nos sollicitat et angit, ne quid gravius communibus <lb xml:id="p1z8"/>rationibus nostris acciderit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Filia principis ad te <lb xml:id="p1z10"/>iam bis scripsit, princeps vero ipse semel, cuius istuc literas <lb xml:id="p1z11"/>per certissimos nuncios deferri curavi.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quare si <lb xml:id="p1z12"/>me amas, si tuam existimationem salvam vis, quam diligentissime <lb xml:id="p1z13"/>quam primumque hominibus principibus rescribe.</s>
					<s n="7" xml:lang="la">Cum primis <lb xml:id="p1z14"/>autem <persName>Alexandri</persName> fac in tua ad <placeName ref="l3029">Warwicensem</placeName> epistola <lb xml:id="p1z15"/>memineris simulque gratias agas pro oblata iamque ostensa <lb xml:id="p1z16"/>eius in nos summa benevolentia; itidem etiam velim erga <lb xml:id="p1z17"/>Suffolciensem ducem facias.</s>
					<s n="8" xml:lang="la">Hoc ut velis, te tam rogo <lb xml:id="p1z18"/>quam quod vehementissime.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/><placeName>Chirothecae</placeName>, quas filia <lb xml:id="p1z20"/>principis istuc ad uxorem tuam perferendas mihi dederat, ante <lb xml:id="p1z21"/>nundinas commode reddi non poterunt.</s>
					<s n="10" xml:lang="la">Volebat illi mittere <lb xml:id="p1z22"/>pulcherrimum annulum aureum; verum non eum accepi certas <lb xml:id="p1z23"/>ob causas, quam hic longum esset recensere.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale, doctis<lb xml:id="p1z24"/>sime vir, et literas rudissime ac levissime scriptas boni <lb xml:id="p1z25"/>consule.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z26"/>Oxonii 16. augusti 1551.</s>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z27"/>Salvere iubeas velim communes amicos.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Tuus quantusquantus <lb xml:id="p1z29"/><persName ref="p20172">Iohannes ab Ulmis</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><persName ref="p591">Ch<lb xml:id="p1z30"/>ekus</persName> optime convaluit.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z31"/><persName ref="p672">Coxus</persName> cancellarius huius universitatis amplius non <lb xml:id="p1z32"/>erit; intra duas horas electionem a nobis futuram <lb xml:id="p1z33"/>scio.</s>
					<s n="17" xml:lang="la">Bona spes, imo summa <placeName>Sufolchiae</placeName> ducem hanc <lb xml:id="p1z34"/>dignitatem et urbis patrocinium in se suscepturum.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z35"/>Constans fama est <persName ref="p672">Coxum</persName> iam propediem episcopum esse crean<lb xml:id="p1z36"/>dum.</s>
					<s n="19" xml:lang="la">Oro <persName ref="p591">Cheko</persName> diligentissime <lb xml:id="p1z37"/>scribas.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z38"/>Festinantiss<lb xml:id="p1z39"/>ime haec ad te.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro <persName ref="p495">Heinrico <lb xml:id="p2z2"/>Bullingero</persName>, domino <lb xml:id="p2z3"/>suo colendissimo.</s>
					<s n="22" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
