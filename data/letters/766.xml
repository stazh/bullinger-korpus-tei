	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>ot loan Hopesrus i
					<lb xml:id="p1z2"/>notiae Esus Gtoci.
					<lb xml:id="p1z3"/>habet ex me illa memorialia.
					<lb xml:id="p1z4"/>In qu priores libr regum, qui et sanuer
					<lb xml:id="p1z5"/>dicuntme omnia.
					<lb xml:id="p1z6"/>In 1 posteriores libr regnum omnia
					<lb xml:id="p1z7"/>In Isaiam prophetam omnia.
					<lb xml:id="p1z8"/>In Danielem prophetam omnia.
					<lb xml:id="p1z9"/>InZacharian prophan omnia
					<lb xml:id="p1z10"/>In Matthei capita 1. Incipies ab
					<lb xml:id="p1z11"/>In evangelium Lucae omnia.
					<lb xml:id="p1z12"/>In acta apostolorum omnia
					<lb xml:id="p1z13"/>In evangelium Ioannis omnia.
					<lb xml:id="p1z14"/>Ieiusdem 1. canonica omnia.
					<lb xml:id="p1z15"/>inepistolam Pauli ad Romanos omnia.
					<lb xml:id="p1z16"/>epistolam eiusdem ad Hebruuri omnia
					<lb xml:id="p1z17"/>In Oseam omnia
					<lb xml:id="p1z18"/>1552.
					<lb xml:id="p1z19"/>In 1. ad Tinoch 3 pia cap.
					<lb xml:id="p1z20"/>zufert zuͦ sel et.
				</p>
			</div>
		</body>
	</text>
