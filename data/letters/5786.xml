	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil habeo, nihil debeo, ut vulgo <lb xml:id="p1z2"/>dicitur, excepto hoc uno, quod d. <persName ref="p629">Coignetius</persName> <lb xml:id="p1z3"/>e <placeName ref="l378">Lutetia</placeName> 27. maii ad me scribit et significat <lb xml:id="p1z4"/>se feliciter venisse in <placeName ref="l832">Galliam</placeName>, benignissim<lb xml:id="p1z5"/>e a rege, regina, principibus acceptum, mox <lb xml:id="p1z6"/>nescio quibus officiis oneratum ac honoratum; ipsum <lb xml:id="p1z7"/>in praesenti nihil recipere.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Addit rem non<lb xml:id="p1z8"/>dum plene compositam esse, praecipue vero <placeName ref="l378">Parisienses</placeName> <lb xml:id="p1z9"/>reluctari; regem se invenisse ad <persName>S. Germanum</persName>, <lb xml:id="p1z10"/>inde cum eo in urbem progressum; esse spem ex <lb xml:id="p1z11"/>deo copiosissimam, ex hominibus non admodum amplam; <lb xml:id="p1z12"/>deum, qui coepit mirabiliter, multo mirabilius <lb xml:id="p1z13"/>deducturum in optatum finem.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Deprecatur bellum <lb xml:id="p1z14"/><placeName ref="l830">Anglicum</placeName>; sed si non cedat ex portu <placeName>Hafeldegras</placeName><note type="misc">... gros?</note></s>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Angla, futurum ut cum exercitu rex ingrediatur <lb xml:id="p1z16"/><placeName ref="l2770">Normanniam</placeName> etc.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Haec et ni<lb xml:id="p1z17"/>hil amplius habeo; <lb xml:id="p1z18"/>varii sunt rumores etc.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Lutherani aliquot <lb xml:id="p1z19"/>clamatores, <persName ref="p458">Brentium</persName> puto primum, scripserunt <lb xml:id="p1z20"/>confutationem catechismi <placeName ref="l2477">Palatini</placeName> principis; <lb xml:id="p1z21"/>princeps ex cancellaria curavit per cursorem <lb xml:id="p1z22"/>suum mitti ad me refutationem peti<lb xml:id="p1z23"/>vitque meam responsionem.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Facile intelligo et <lb xml:id="p1z24"/>aliis ecclesiarum ministris colligi iudicia.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z25"/>Absolvi nostram responsionem non sine labore; heri <lb xml:id="p1z26"/>misi.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Deum oro ut servet principem, veritatem <lb xml:id="p1z27"/>propaget, errorem et imprudentes <lb xml:id="p1z28"/>canes ab ecclesia dei abigat.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Oremus, mi frater, <lb xml:id="p1z29"/>dominum, ut ecclesiam servet.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute"><persName ref="p3375">Vergerium</persName>, <lb xml:id="p1z30"/>si apud vos est, saluta et hortare, ut fideliter <lb xml:id="p1z31"/>Christo inserviat.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z32"/>A comitiis <placeName ref="l21">Badensibus</placeName> <lb xml:id="p1z33"/>vixdum coeptis nihil adhuc habemus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale, <lb xml:id="p1z34"/>et ago tibi gratias pro libro tuo De providentia etc.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z35"/>Scripsi festinantissime.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z36"/>25. iunii 1563.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z37"/>Saluta consules, fratres, symmistas, <lb xml:id="p1z38"/>amicos omnes.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute"><lb xml:id="p1z40"/>Mei te salutant et tuos.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae fideli ministro, <lb xml:id="p2z4"/>domino et fratri meo <lb xml:id="p2z5"/>colendo et dilecto.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z6"/>Chur.</s>
				</p>
			</div>
		</body>
	</text>
