	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literas tuas cum <persName ref="p3375">Vergerii</persName> nostri fasciculo accepi; <lb xml:id="p1z2"/>ei breviter respondeo.</s>
					<s n="3" xml:lang="la">Si commodo tuo facere poteris, ad <lb xml:id="p1z3"/>eum mittes.</s>
					<s n="4" xml:lang="la">Non sum tam expers humanitatis, ut te <lb xml:id="p1z4"/>aut ea aut alia re gravare velim.</s>
					<s n="5" xml:lang="la">Scribo, ut se res <lb xml:id="p1z5"/>offerunt, et scribo aperte.</s>
					<s n="6" xml:lang="la">Nihil mihi gratius est, <lb xml:id="p1z6"/>quam ut omnes erga me eadem libertate utantur, nedum i<lb xml:id="p1z7"/>i, quibus tribuo, ut debeo, plurimum.</s>
					<s n="7" xml:lang="la">Te certe <lb xml:id="p1z8"/>imprimis amo et veneror.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale.</s>
					<s n="9" xml:lang="la"><placeName ref="l98">Curiae</placeName>, 8. calendas <lb xml:id="p1z9"/>februarii.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z10"/>Tuus <persName ref="p8332">Ioh[annes] Frax[ineus]</persName>, episcopus <placeName ref="l1206">Bay[onensis]</placeName>.</s>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p4z1"/>Doctissimo viro d. <persName ref="p495">Henrico <lb xml:id="p4z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p4z3"/>ministro, amico charissimo.</s>
				</p>
			</div>
		</body>
	</text>
