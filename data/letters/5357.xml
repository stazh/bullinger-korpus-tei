	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Per Christum servatorem.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Hodie, hoc est 6. iunii <lb xml:id="p1z2"/>literas 4. iunii a te scriptas accepi, quibus te meas accepis<lb xml:id="p1z3"/>se intelligo.</s>
					<s n="4" xml:lang="la">Quibus quod respondeam, nunc nihil habeo; heri <lb xml:id="p1z4"/>etenim per vestros studiosos, quos ab <placeName ref="l210">Heidelberga</placeName> revoc<lb xml:id="p1z5"/>astis, de fratrum sententia, quid cum vestris, quos huc misistis <lb xml:id="p1z6"/>per d. <persName>Hospinianum</persName> et me actum, scripsi.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Placet omnibus modis <lb xml:id="p1z7"/>sententia vestra de recusando <placeName ref="l1107">Tridentino</placeName> conciliabulo, <lb xml:id="p1z8"/>quemadmodum plurimis ex hesterno die literis intelliges.</s>
					<s n="6" xml:lang="la">De occu<lb xml:id="p1z9"/>pato oppido <placeName ref="l1290">Angiers</placeName> nihil audivimus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l3065">Villamfrancham</placeName> a <persName>Conden[si]bus</persName> <lb xml:id="p1z10"/>acceptam constanter adhuc narratur et damno multo minori, <lb xml:id="p1z11"/>quam fama sparserat; nam cum duo milia <persName>Condensium</persName> periisse primo <lb xml:id="p1z12"/>dicerentur, nunc 200 tantum esse dicuntur.</s>
					<s n="8" xml:lang="la">Exemplar scripti <persName ref="p3099">Sul<lb xml:id="p1z13"/>tzerus</persName> sibi usurpavit; id quam primum ab ipso impetravero, remittam.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z14"/>Quod reliquum ad te nunc scribam, nihil habeo, quam fratrum omnium <lb xml:id="p1z15"/>vos salute impartiar, inprimis autem d. <persName ref="p8054">Marci Berschii</persName>, qui <lb xml:id="p1z16"/>qua gratitudine tuae humanitatis salutationes recipiat satis, nescit.</s>
					<s n="10" xml:lang="la" ana="farewell">Interim <lb xml:id="p1z17"/>vale ac vale millies.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l28">Basileae</placeName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Festinanter.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Fratres omnes meo salutes <lb xml:id="p1z18"/>nomine ac fratrum, <persName ref="p1884">Lavaterum</persName> autem inprimis.</s>
					<s n="14" xml:lang="la">Datum <placeName ref="l28">Basileę</placeName> 6. iunii <lb xml:id="p1z19"/>anno 1562.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z20"/>Tuus supra, quam credis, <lb xml:id="p1z21"/><persName ref="p8466">Wissemburg</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro et omni <lb xml:id="p2z2"/>genere virtutum ornato d. <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z4"/>ecclesię pastori fidelissimo, domino <lb xml:id="p2z5"/>et amico suo veteri.</s>
					<s n="17" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zurich</placeName><lb xml:id="p2z7"/>.</s>
				</p>
			</div>
		</body>
	</text>
