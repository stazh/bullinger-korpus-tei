	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto literas magistro poste, quas puto esse pro solutione debiti, <lb xml:id="p1z2"/>de quo scripseram a te admonitus, ut fideiussione liberaretur.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Eius filio dixi me curaturum, ut ei in tuto sit posta, nihil tamen <lb xml:id="p1z4"/>praetermissurum.</s>
					<s n="4" xml:lang="la">Accepi eo in statu esse religionem in <placeName ref="l830">Anglia</placeName> parlamenti <lb xml:id="p1z5"/>senatus consulto et regine decreto, quo tempore <persName ref="p3207">Edoardi</persName> fuit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Spero me brevi te visurum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute">Interim vale et saluta amicos communes.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z7"/><placeName ref="l760">Sol[uturi]</placeName> 6. iunii.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z8"/>Tuus.</s>
				</p>
				<p>
					<s n="9" xml:lang="de"><pb/><lb xml:id="p2z1"/>An herren <persName ref="p495">Heinrichen <lb xml:id="p2z2"/>Bullinger</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
				<p>
					<note>[Von anderer Hand.]</note>
				</p>
			</div>
		</body>
	</text>
