	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Multum te obsecro, mi colendissime charissimeque <persName ref="p495">Bullingere</persName>, ut, ubi primum <placeName ref="l167">Genevam</placeName> scripseris, <lb xml:id="p1z2"/>fasciculum, quem hic mitto, cum tuis literis connexum <persName ref="p540">Calvino</persName> nosto aut <persName ref="p8033">Beze</persName> pariter reddi cures; <lb xml:id="p1z3"/>nuncio vero, qui diligentius hic nobis inserviat, duos bazones hic insinuatos dabis; <lb xml:id="p1z4"/>omnino enim perire aut intercipi nolim, quę non mea solum, sed aliorum etiam sunt amicorum fasciculo <lb xml:id="p1z5"/>huic credita.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Nova nulla sunt, nisi que hic a me ex amicorum quorundam literis descripta mitto.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Tu, quod habes, ex <placeName ref="l832">Gallia</placeName> praesertim, vicissim mihi tuo more communica.</s>
					<s n="5" xml:lang="la"><placeName ref="l257">Constantienses</placeName> enim carrucarii <lb xml:id="p1z7"/>istinc a vobis <placeName ref="l257">Constantiam</placeName> revertentes apud <placeName ref="l2367">Felben</placeName> pagum pernoctare solent, unde mihi, quicquid <lb xml:id="p1z8"/>vel <placeName ref="l587">Tiguro</placeName> vel <placeName ref="l555">Vituduro</placeName> scribitur aut mittitur, nulla difficultate affertur.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Bene vale, mi <lb xml:id="p1z9"/>venerande mihi semper in Christo anime, apud quem mihi fideli tuo patrocinio adesse sedulo velis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute"><lb xml:id="p1z10"/>Saluta tuam domum cum omnibus fratribus et sororibu<note type="misc">saluta hier nochmals!</note>.</s>
					<s n="8" xml:lang="la" ana="salute">Salutant te magna cum venerat<lb xml:id="p1z11"/>ione charissima mea uxor, soror cum filiis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Non dubito, quin iam ex amicis miserabile fatum <persName ref="p2300">Hei<lb xml:id="p1z12"/>nrichi ab Ulmis</persName> cognoveris, quam, quotquot noverunt, vehementer plangunt.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z13"/>T[uus] <persName ref="p8055">Am[brosius] Bl[aurerus]</persName>.</s>
				</p>
				<p>
					<note type="address">[Ohne Adresse.]</note>
				</p>
			</div>
		</body>
	</text>
