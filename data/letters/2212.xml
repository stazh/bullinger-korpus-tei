	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l491">Argentinae</placeName> 3. martii 1554.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>S. P.</s>
					<s n="3" xml:lang="la">Famam seditionis turbatae et afflictae <placeName ref="l830">Angliae</placeName> <lb xml:id="p1z3"/>ad vos pervenisse non dubito, <persName ref="p495">Bullingere</persName> colende.</s>
					<s n="4" xml:lang="la">Cuius <lb xml:id="p1z4"/>causam, initium, et exitum, vobis indicabit, qui has literas <lb xml:id="p1z5"/>adfert: quem oro, ut officiose accipias; nam <lb xml:id="p1z6"/>quod huic feceris, Christo factum estimo.</s>
					<s n="5" xml:lang="la">Vir est, <lb xml:id="p1z7"/>ut doctus, ita pius et religiosus, iam ab <placeName ref="l830">Anglis</placeName> propte<lb xml:id="p1z8"/>r verbum dei et testimonium Iesu Christi profugus.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Eum precor digneris tuis aedibus et hospitio; nam <lb xml:id="p1z10"/>non diutius apud vos manebit, quam de questionibus <lb xml:id="p1z11"/>in religione controversis cum doctis contulerit.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Quietus est, paucissimis contentus, adeo ut non satis <lb xml:id="p1z13"/>admirari possum eius in victu parsimoniam.</s>
					<s n="8" xml:lang="la">Quod <lb xml:id="p1z14"/>scribo, comprobabunt experientiae<note type="margin">a.R.: -tia?</note>.</s>
					<s n="9" xml:lang="la">Neque gratis apud <lb xml:id="p1z15"/>te erit; habet enim, quo se posset alere.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Caeterum <lb xml:id="p1z16"/>doctrinae eius non pauca testimonia edidit.</s>
					<s n="11" xml:lang="la">Concio<lb xml:id="p1z17"/>nes exstant doctae et piae, quas ante regem <lb xml:id="p1z18"/>defunctum et principes habuit.</s>
					<s n="12" xml:lang="la">Tu, mi <lb xml:id="p1z19"/><persName ref="p495">Bullingere</persName>, experientia disces, quales sit, ut caetera taceam.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z20"/>Proin ne, quaeso, destituatur tuo auxilio.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z21"/>Et, ut pauca commemorem quae te audisse iuvabit, <lb xml:id="p1z22"/>trecentos sacrificulos iugulasse seditiosos fertur.</s>
					<s n="15" xml:lang="la">In <lb xml:id="p1z23"/>initio secunda usi sunt fortuna; tandem captum audio <lb xml:id="p1z24"/>fuisse eorum ducem.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Inter caetera scribitur (tamen <lb xml:id="p1z25"/>incerta fama fuit) ducem <placeName ref="l1956">Suffolciae</placeName> cum sediti<lb xml:id="p1z26"/>osis conspirasse et fuisse.</s>
					<s n="17" xml:lang="la">Quod opto falsum.</s>
					<s n="18" xml:lang="la">Prae<lb xml:id="p1z27"/>terea audivi, reginam decolasse <persName>Annam</persName>, filiam eius, <lb xml:id="p1z28"/>cum marito.</s>
					<s n="19" xml:lang="la">De ea <persName>Anna</persName> loquor, quae declarata <lb xml:id="p1z29"/>fuit regina.</s>
					<s n="20" xml:lang="la">Caeterum quaecunque audivero, <lb xml:id="p1z30"/>scripturus sum.</s>
					<s n="21" xml:lang="la">Iam parce brevitati; <lb xml:id="p1z31"/>nam is nuntius tibi referat omnia.</s>
					<s n="22" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="23" xml:lang="la"><lb xml:id="p1z32"/>Filius tuus vivet et valet dei benefitio.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z33"/>Me <lb xml:id="p1z35"/>nosti.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heynr[i]co Bullingero</persName>, <lb xml:id="p2z2"/>amico colendo.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
