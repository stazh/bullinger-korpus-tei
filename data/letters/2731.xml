	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Scribo nunc, clarissime domine <persName ref="p495">H[enrice] Bullingere</persName>, ut patefaciam adi<lb xml:id="p1z2"/>tum ad tuam amicitiam huic fratri meo <lb xml:id="p1z3"/>studioso <placeName ref="l512">Tubingensi</placeName> subdito illustrissimi domini <persName ref="p2411">Otthonis Henrici</persName>; <lb xml:id="p1z4"/>suscipe illum, ut soles reliquos, qui tibi sunt <lb xml:id="p1z5"/>nomine pietatis commendati; fac, intelligat <lb xml:id="p1z6"/>me amari abs te.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Vale et salve cum tota <lb xml:id="p1z7"/>familia, schola atque ecclesia.</s>
					<s n="3" xml:lang="la">Orate pro m<lb xml:id="p1z8"/>e; adhuc haereo <placeName ref="l412">Reuthlingae</placeName> neque <lb xml:id="p1z9"/>ociosus; mox videbis.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/><placeName ref="l412">Reuthlingae</placeName> 18. septembris 1555.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z12"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo d. <persName ref="p495">H[enrico] <lb xml:id="p2z2"/>Bullingero</persName>, fratri honorando.</s>
					<s n="7" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
