	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Comitia nostra, optime <persName ref="p495">Bullingere</persName>, utinam non magnas <lb xml:id="p1z2"/>parturiant turbas; eam namque inania fore ce[<lb xml:id="p1z3"/>r]to mihi persuadeo et processus hactenus o<lb xml:id="p1z4"/>bservatus hoc indicare videtur.</s>
					<s n="3" xml:lang="la">Catholici <lb xml:id="p1z5"/>nunquam tam fuerunt superciliosi, pertinaces <lb xml:id="p1z6"/>et elati, atque hodie sunt; cuncta pro arbitrio ins<lb xml:id="p1z7"/>tituunt, et nihil est, quod aeque eos ampullari <lb xml:id="p1z9"/>faciat, quam nostra discordia et pax, <lb xml:id="p1z10"/>quam iactant inter <persName>Gallum</persName> et <persName>Hispanum</persName> esse <lb xml:id="p1z11"/>factam.</s>
					<s n="4" xml:lang="la">Putant fore, ut... nostri esse debeant <lb xml:id="p1z12"/>in comitiis illis exemplum <placeName ref="l569">Wormatiense</placeName> sint <lb xml:id="p1z13"/>secuturi, digni <placeName ref="l569">Wormatiensis</placeName> colloquii, <lb xml:id="p1z14"/>ut fustibus et lictoribus ex <placeName ref="l822">Germania</placeName> expellantur.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Quare strata futura omnia fore puto; lecta est <lb xml:id="p1z16"/>pars sacrificorum <placeName ref="l569">Wormacię</placeName> exhibita, ne alteras <lb xml:id="p1z17"/>legatur mille excogitant modos, technas et <lb xml:id="p1z18"/>insidias.</s>
					<s n="6" xml:lang="la">Accedit, quod in nostris multa <lb xml:id="p1z19"/>desiderem, sobrietatem, constantiam, zelum <lb xml:id="p1z20"/>et multa alia.</s>
					<s n="7" xml:lang="la">Non licet iam plura.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Vale, <lb xml:id="p1z21"/>mi <persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ocyssime.</s>
					<s n="11" xml:lang="la">4. aprilis etc. 59.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><persName ref="p2856">G[ereon] Sailer</persName> <lb xml:id="p1z22"/>tuus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pręstantissimo viro d. <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName>, d. et amico <lb xml:id="p2z3"/>integerrimo<lb xml:id="p2z4"/>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tyguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
