			<graphic xml:id="img4-0" url="https://media.sources-online.org/cantaloupe/iiif/3/bullinger!8630!Autograph!03%20E_II_362__fol__117_c_r_.tif/full/max/0/default.jpg" height="4067px" width="2799px" n="4">
