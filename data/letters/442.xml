	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Si hunc exceperis virum familiariter, scias me acceptum.</s>
					<s n="3" xml:lang="la">Doctus est, pius, magnus <lb xml:id="p1z2"/>et posset esse maior, ni nimium placeret Christus, quamvis hoc etiamnum <lb xml:id="p1z3"/>contineat apud se.</s>
					<s n="4" xml:lang="la">Hic vivit tamen hodie cum uxore <persName>Dana</persName> et liberis.</s>
					<s n="5" xml:lang="la">Abi<lb xml:id="p1z4"/>it isthuc, ut videat <placeName ref="l587">Tigurum</placeName> et vos.</s>
					<s n="6" xml:lang="la">Exhibebis igitur illi te familiarem.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z5"/>Quęcunque ego nova possum narrare, narrabit ille; plura non novi.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z6"/>De Cęsare tacetur, tametsi scriptum sit ad <placeName ref="l41">Bernates</placeName> ipsum obpressurum <lb xml:id="p1z7"/>saltem partem <placeName ref="l862">Helvetię</placeName> idque de improviso, si non queat aliud, quamobrem <lb xml:id="p1z8"/>multa diligentia opus esse.</s>
					<s n="9" xml:lang="la">Sed referent nimirum <placeName ref="l41">Bernates</placeName> in proximis <lb xml:id="p1z9"/>comitiis ad <placeName ref="l862">Helvetios</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z10"/>Trepidant infelices <placeName ref="l491">Argentinenses</placeName>, ut de novo miserint legationem ad <persName ref="p18538">Carolum</persName>; <lb xml:id="p1z11"/>episcopus enim ne literam quidem vult cadere de Interim et de sua iuris<lb xml:id="p1z12"/>dictione.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z13"/>Est <placeName ref="l284">Lypsię</placeName> doctor <persName ref="p4160">Alexander Alesius</persName>, qui his diebus scripsit ad D. <lb xml:id="p1z14"/><persName ref="p2270">Munsterum</persName> his verbis: "<placeName ref="l2655">Civitates maritimę</placeName><note xml:id="fn1" type="footnote" n="1">die <placeName ref="l2655">Hansestädte</placeName> ("Seestädte").</note> et <placeName ref="l749">Saxonicę</placeName>, <placeName ref="l303">Mag<lb xml:id="p1z15"/>deburga</placeName>, <placeName ref="l1041">Brunswica</placeName>, <placeName ref="l204">Hamburga</placeName>, <placeName ref="l302">Lubeca</placeName>, <placeName ref="l61">Brema</placeName> et alię dei <lb xml:id="p1z16"/>beneficio sunt adhuc constantiores <placeName ref="l257">Constantia</placeName> inconstanti et con<lb xml:id="p1z17"/>cordes" etc.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z18"/>De tributo dando Cęsari et <persName ref="p18477">Ferdinando</persName>, quod procurrit ad tonas <lb xml:id="p1z19"/>auri liij, audisti nimirum ex <persName ref="p1278">Gastio</persName>.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale in domino.</s>
					<s n="14" xml:lang="la" ana="salute">Salutabis <lb xml:id="p1z20"/>D. <persName ref="p8171">Theodorum</persName> et <persName ref="p8011">Gualtherum</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l28">Basileę</placeName> 22. Februarii anno <lb xml:id="p1z21"/>1549.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z22"/>Non potuit plura tuus <persName ref="p8418">Myconiu<lb xml:id="p1z23"/>s</persName>.</s>
				</p>
				<p>
