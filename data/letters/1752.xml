	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la">Literas tuas cum sermonibus vestris multa pietate refertis <lb xml:id="p1z2"/>uxor me absente recepit, vir ornatissime, pro quibus tibi <lb xml:id="p1z3"/>atque <persName ref="p8011">Gvaltero</persName>, viro clarissimo, ingentes gratias ago, qui <lb xml:id="p1z4"/>me satis antea devinctum novis cumulatis beneficiis.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Nuncius tanta festinatione ad vos se recepit, ut <lb xml:id="p1z6"/>non tantum literas dare non potuerim, sed ne viderim <lb xml:id="p1z7"/>quidem visitandis aegrotantibus adeo occupatus, ut vix <lb xml:id="p1z8"/>scalpendis auribus ocium esset eo tempore.</s>
					<s n="4" xml:lang="la">Fasciculum cum <lb xml:id="p1z9"/>epistolis ad comitem <placeName ref="l572">Wirtenbergensem</placeName> atque <persName ref="p1010">Erbium</persName>, <lb xml:id="p1z10"/>virum optimum, probe curavi atque dabo etiam pro virili <lb xml:id="p1z11"/>operam, ut tuas ad pie memoriae <persName ref="p8418">Myconium</persName> epistolas, <lb xml:id="p1z12"/>etsi non omnes (quod vix est possibile), plerasque tamen <lb xml:id="p1z13"/>ad proximam oportunitatem accipias.</s>
					<s n="5" xml:lang="la">Ex <placeName ref="l850">Austria</placeName> diu <lb xml:id="p1z14"/>nihil audivimus aliud quam <persName ref="p18477">Ferdinandum</persName> <placeName ref="l546">Viennae</placeName> da<lb xml:id="p1z15"/>re operam genio atque luxuriari pro more suo in tanto <lb xml:id="p1z16"/>suorum periculo.</s>
					<s n="6" xml:lang="la">De <placeName ref="l832">Gallo</placeName> nihil audimus certi; timemus, <lb xml:id="p1z17"/>ne marchio <placeName ref="l1048">Brandeburgensis</placeName>, qui iam omnes fere episcopatus <lb xml:id="p1z18"/>exhausit, hiberna sua in <placeName ref="l631">Burgundia</placeName>, Caesar vero <lb xml:id="p1z19"/>in <placeName ref="l632">Alsacia</placeName> et <placeName ref="l2836">Suntgavia</placeName> figat ob rerum copiam <lb xml:id="p1z20"/>magno nostro atque totius Helvetiae incommodo <lb xml:id="p1z21"/>atque periculo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l28">Basiliensis</placeName> ecclesia a morte <persName ref="p8418">My<lb xml:id="p1z22"/>conii</persName> pie memoriae caret pastore; orandus itaque et <lb xml:id="p1z23"/>exorandus est piorum precibus deus, ut ecclesiae suae <lb xml:id="p1z24"/>praeficiat episcopum in tantis Germaniae tumultibus atque <lb xml:id="p1z25"/>insultibus antichristi vigilantissimum, qui ovibus <lb xml:id="p1z26"/>suis non minus exemplo vitę quam doctrinae etiam <lb xml:id="p1z27"/>praesit extra omnem contentionem, qua multae hodie fluctuan<lb xml:id="p1z28"/>tur ecclesiae magno scandalo.</s>
					<s n="8" xml:lang="la">Expecto subinde <lb xml:id="p1z29"/>fasciculum librorum a <persName ref="p18291">Petro Mechlingensi</persName> <placeName ref="l491">Argentiae</placeName> <lb xml:id="p1z30"/>coemptorum, quo demum tuos accipias diu iam desideratos.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z31"/>Vale cum uxore atque tota familia foelicissime.</s>
					<s n="10" xml:lang="la" ana="salute"><lb xml:id="p1z32"/>Salutabis autem meo nomine <persName ref="p8127">Pellicanum</persName>, avunculum <lb xml:id="p1z33"/>meum colendissimum, cui scribere modo non vacat.</s>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p1z34"/>Salutat te etiam <persName ref="p8054">Marcus <span type="pronoun">noster</span> Bersius</persName> atque <lb xml:id="p1z35"/><persName ref="p8126">Oporinus</persName>.</s>
					<s n="12" xml:lang="la" ana="farewell">Iterum vale.</s>
					<s n="13" xml:lang="la">Calendis novembris <lb xml:id="p1z36"/>anno 1552.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z37"/>Tuus <persName ref="p8406">Conradus Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vigilantissimo ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z2"/>pastori d. <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bullingero</persName>, amico incom<lb xml:id="p2z4"/>parabili.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
