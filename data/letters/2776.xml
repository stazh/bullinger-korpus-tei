	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non tam creber sum in scribendis literis, quam iure esse deberem.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Hoc autem facit partim egritudo, partim etiam negotiorum moles, <lb xml:id="p1z3"/>cumque his horis valde occupatus sim nec commode scribere liceat, <lb xml:id="p1z4"/>legas tantum, quę domino <persName ref="p8417">Musculo</persName> significare volui, cumque sint <lb xml:id="p1z5"/>fere talia, qualia ad te darem, oro, ne graveris me a suspition<lb xml:id="p1z6"/>e <lb xml:id="p1z7"/>negligentiae excusare et lectioni huius festinantis scripti <lb xml:id="p1z8"/>exaturari, postquam illud perlegeris, <persName ref="p8417">Musculo</persName> tuis literis inclusum <lb xml:id="p1z9"/>transmittere.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>Defensionem confessionis vestrę et consensionem d. <persName ref="p2095">Philippo Melanchtoni</persName> <lb xml:id="p1z11"/>transmisi atque super ea iuditium suum petii.</s>
					<s n="5" xml:lang="la">Si quid responderit <lb xml:id="p1z12"/>ipse, quod in dubium voco, hoc ex me rescies.</s>
					<s n="6" xml:lang="la">Illam ipsam <lb xml:id="p1z13"/>consensionem in Germanicam linguam transtuli; sed typographum, <lb xml:id="p1z14"/>qui eam excudat, non invenio.</s>
					<s n="7" xml:lang="la">Multum profecto produceret fructus, <lb xml:id="p1z15"/>si Germanice in lucem ederetur, presertim cum nomen <lb xml:id="p1z16"/>optimi viri <persName ref="p4091">Zvinglii</persName> incipiat fere apud multos melius <lb xml:id="p1z17"/>audire quam antea.</s>
					<s n="8" xml:lang="la">Ego sane aliquot Lutheranos profligavi <lb xml:id="p1z18"/>atque gladio spiritus Christi in meam partem pertraxi, quamvis <lb xml:id="p1z19"/>non ego, sed etc.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale, mi frater.</s>
					<s n="10" xml:lang="la">Mihi videre videor turbu<lb xml:id="p1z20"/>lentam estatem.</s>
					<s n="11" xml:lang="la">Raptim 24. novembris 1555. <lb xml:id="p1z21"/>ex possessione mea <placeName ref="l447">Schlachtegkh</placeName> ad flumen <persName ref="p458">Brentzium</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/>Tuus totus <persName ref="p8354">Georgius Laetus</persName> <lb xml:id="p1z23"/>a <placeName>Lemnitz</placeName> etc.</s>
					<s n="13" xml:lang="de">(...<pb/><lb xml:id="p2z1"/>) unnd hochgelerten (...) <lb xml:id="p2z2"/><persName ref="p495">Bullinger</persName>, vorgeern<note xml:id="fn1" type="footnote" n="1">Antistes.</note> [der k<lb xml:id="p2z3"/>i]lchen <placeName ref="l587">Zurch</placeName>, minem (...<lb xml:id="p2z4"/>) eren zu hannden.</s>
					<s n="14" xml:lang="de"><placeName ref="l587">[Zu]rch</placeName>.</s>
				</p>
				<p>
					<note>[Darüber von Bull. s. Hand:]</note>
					<s n="15" xml:lang="la">D. <persName ref="p8417">Muscu<lb xml:id="p2z5"/>lo</persName> <placeName ref="l41">Be<lb xml:id="p2z6"/>rnae</placeName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
				</p>
