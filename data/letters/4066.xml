	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissimo et spectatissimo viro d. <persName ref="p495">Henrico Bullin<lb xml:id="p1z2"/>ger<lb xml:id="p1z4"/>o</persName>, <lb xml:id="p1z5"/>pastor<lb xml:id="p1z6"/>i ec<lb xml:id="p1z7"/>c<lb xml:id="p1z8"/>le<lb xml:id="p1z9"/>siae <placeName ref="l587">Ti<lb xml:id="p1z10"/>gurin<lb xml:id="p1z11"/>ae</placeName> fi<lb xml:id="p1z12"/>delissimo, <lb xml:id="p1z13"/>domi<lb xml:id="p1z14"/>no et pa<lb xml:id="p1z15"/>renti magnope<lb xml:id="p1z16"/>re obse<lb xml:id="p1z17"/>rvando, <persName ref="p1586">Hotom<lb xml:id="p1z18"/>anus</persName> S. P<lb xml:id="p1z19"/>. <lb xml:id="p1z20"/>D.</s>
					<s n="2" xml:lang="la">Veri<lb xml:id="p1z21"/>ssim<lb xml:id="p1z22"/>a s<lb xml:id="p1z23"/>u<lb xml:id="p1z24"/>nt, q<lb xml:id="p1z25"/>uae <lb xml:id="p1z26"/>de <placeName>Gal<lb xml:id="p1z27"/>lia</placeName> <lb xml:id="p1z28"/>sc<lb xml:id="p1z29"/>ripsis<lb xml:id="p1z30"/>ti, pa<lb xml:id="p1z31"/>ter observand<lb xml:id="p1z32"/>issime<lb xml:id="p1z33"/>, o<lb xml:id="p1z34"/>mniumqu<lb xml:id="p1z35"/>e <lb xml:id="p1z36"/>mor<lb xml:id="p1z37"/>talium <lb xml:id="p1z41"/>spem <persName>N<lb xml:id="p1z42"/>av<lb xml:id="p1z43"/>ar<lb xml:id="p1z44"/>r<lb xml:id="p1z45"/>us</persName> <lb xml:id="p1z46"/>miserrime <pb/><lb xml:id="p2z1"/>fefellit.</s>
					<s n="3" xml:lang="la">Si scires, quam acriter sit admonitus, quae condition s illi oblatae <lb xml:id="p2z2"/>sint, quanta subsidia delata, quanta tamen inertia omnia despexerit, vehementer mirareris.</s>
					<s n="4" xml:lang="la">Ego <lb xml:id="p2z3"/>totos hosce menses duos nunquam quievi; sed video nos inaniter laborare.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Consolor me tamen in <lb xml:id="p2z4"/>eo, unde spes omnes meae semper pependerunt et qui fallax esse non potest.</s>
					<s n="6" xml:lang="la">De <persName>Vilhelmo</persName><note xml:id="fn1" type="footnote" n="1">Stucki?</note> <lb xml:id="p2z5"/>tuo non est quod habeas gratias.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Te oro, ut me apud spectatissimum virum d. parentem suum ex<lb xml:id="p2z6"/>cuses, si ili non rescribam, quia Germanice nihil possum et in ipsius filio spero me ea prae<lb xml:id="p2z7"/>staturum, quae ipsius expectationi satisfaciant.</s>
					<s n="8" xml:lang="la">Opus est illi aliquot libris, si eum doctum eva<lb xml:id="p2z8"/>dere volumus, opus est etiam vestimentis adventante hieme, et scis me aliquando scrip<lb xml:id="p2z9"/>sisse, <lb xml:id="p2z10"/>quam <lb xml:id="p2z13"/>mihi <lb xml:id="p2z14"/>cur<lb xml:id="p2z17"/>ta supel<lb xml:id="p2z18"/>lex sit<note xml:id="fn2" type="footnote" n="2">Vgl. Persius, Saturae, 4, 52.</note>.</s>
					<s n="9" xml:lang="la">Q<lb xml:id="p2z19"/>uare peto abs t<lb xml:id="p2z20"/>e, ut per e<lb xml:id="p2z21"/>os, qui ad <lb xml:id="p2z22"/>nundinas v<lb xml:id="p2z23"/>eniunt, <lb xml:id="p2z24"/>mihi <lb xml:id="p2z25"/>num os al<lb xml:id="p2z26"/>iquot nu<lb xml:id="p2z27"/>merand<lb xml:id="p2z28"/>os cures.</s>
					<s n="10" xml:lang="la" ana="farewell">V<lb xml:id="p2z29"/>ir clarissim<lb xml:id="p2z30"/>e et pate<lb xml:id="p2z31"/>r obse<lb xml:id="p2z32"/>rv<lb xml:id="p2z33"/>andiss<lb xml:id="p2z34"/>ime, <lb xml:id="p2z35"/>vale e<lb xml:id="p2z36"/>t salv<lb xml:id="p2z37"/>e.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Ve<lb xml:id="p2z38"/>gitunti 2. <lb xml:id="p2z39"/>sep<lb xml:id="p2z40"/>tem<lb xml:id="p2z41"/>br<lb xml:id="p2z42"/>is 1<lb xml:id="p2z43"/>559<note xml:id="fn3" type="footnote" n="3">Ur-? = Besançon?</note>.</s>
				</p>
			</div>
		</body>
	</text>
