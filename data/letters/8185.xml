	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Doctissime vir, binas hoc mane literas vestras accepi de 19. et <lb xml:id="p1z2"/>22. huius.</s>
					<s n="3" xml:lang="la">Responsum regis hic vobis mito.</s>
					<s n="4" xml:lang="la">Dux <placeName ref="l691">Lotaringiae</placeName> et alii <lb xml:id="p1z3"/>pacem futuram dicunt et secundum istas conditiones.</s>
					<s n="5" xml:lang="la">Multi quibus<lb xml:id="p1z4"/>vis secuturam arbitrantur praeter utriusque partis necessitates.</s>
					<s n="6" xml:lang="la">Non <lb xml:id="p1z5"/>desunt veteres hostes, qui rupta omnia vellent et plenam tandem <lb xml:id="p1z6"/>Hugenotorum omnium extirpationem pollicentur.</s>
					<s n="7" xml:lang="la">Multa ex utraque parte <lb xml:id="p1z7"/>indigna commituntur, quae postea animos magis exasperant et <lb xml:id="p1z8"/>calamitates augent.</s>
					<s n="8" xml:lang="la">Misericordia dei istis sola mederi <lb xml:id="p1z9"/>poterit, cum demerita nostra talia non sint, quae diutius suum <lb xml:id="p1z10"/>iudicium tollerare possint<note type="margin">dazu a.R.: quod?</note>.</s>
					<s n="9" xml:lang="la">De <persName>Mauris Hispani</persName> sibi certam <lb xml:id="p1z11"/>victoriam pollicentur, quam illis exopto.</s>
					<s n="10" xml:lang="la"><placeName ref="l2510">Turcica</placeName> classis <persName>Cypro</persName> <lb xml:id="p1z12"/>minari dicitur, quanquam mihi non sit dubium <placeName ref="l2510">Turcos</placeName> sine <lb xml:id="p1z13"/>auxilio <persName>Mauros</persName> non relicturos.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z14"/>De <persName>Erico</persName> duce dudum, quod scribitis, intellexi et credo equites <lb xml:id="p1z15"/>suos progressuros in <placeName ref="l832">Galliam</placeName>, si opus sit.</s>
					<s n="12" xml:lang="la">Sed interim <lb xml:id="p1z16"/>invigilandum est, ne quid detrimenti respublica capiat<note xml:id="fn1" type="footnote" n="1">Vgl. Cicero, "Videant consules, ne ...".</note>.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z17"/><persName>Guilielmum</persName> ducem pecuniam ex <placeName ref="l832">Gallia</placeName> expectare ferebant <lb xml:id="p1z18"/>pro conductu suorum equitum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z19"/>Hugnoti frustra pro auxiliis laborare hactenus visi sunt, <lb xml:id="p1z20"/>et sane difficile illis erit sustinere bellum hac aestate, si <lb xml:id="p1z21"/>novis copiis non fuerint instructi.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z22"/>Dieta ad mensem maium procedet ad <persName>Renum</persName> / <persName>Reinum</persName>, ut puto.</s>
					<s n="16" xml:lang="la">De reliquo <lb xml:id="p1z23"/>vos rogo, ut etiam ex <placeName ref="l157">Franckfordio</placeName> ad me scribere velitis; <lb xml:id="p1z24"/>ego non ero ingratus.</s>
					<s n="17" xml:lang="la">Et vos feliciter valere exopto.</s>
				</p>
				<p>
					<s n="18" xml:lang="de">Ex <lb xml:id="p1z25"/><placeName ref="l924">Kuensheim</placeName> 24. februarii anno 70.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z26"/>Vester bonus amicus <lb xml:id="p1z27"/><persName ref="p3730">Lazarus de <lb xml:id="p1z28"/>Svendi</persName> <pb/><lb xml:id="p2z3"/>sc<lb xml:id="p2z4"/>ri<lb xml:id="p2z5"/>p<lb xml:id="p2z7"/>s<lb xml:id="p2z8"/>i<lb xml:id="p2z10"/>t<lb xml:id="p2z11"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt; jedenfalls nicht an Bullinger.]</note>
				</p>
			</div>
		</body>
	</text>
