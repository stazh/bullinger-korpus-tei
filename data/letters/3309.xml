	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia et pax a deo patre nostro et domino Iesu Christo.</s>
				</p>
				<p>
					<s n="2" xml:lang="de">Amen.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Cla<lb xml:id="p1z2"/>rissimum virum d. <persName ref="p8066">Max[imilianum Martinengum]</persName> ex turbulentissimo hoc migrasse <lb xml:id="p1z3"/>saeculo gaudemus, eo quod credimus illum *multis liberatum malis<note type="margin">Zusatz a.R.</note> nunc demum iis frui apud <lb xml:id="p1z4"/>dominum et salvatorem nostrum gaudiis quae nos speramus.</s>
					<s n="4" xml:lang="la">Dolemus <lb xml:id="p1z5"/>autem ex animo vos interim fideli destitutos esse <lb xml:id="p1z6"/>pastore, dominumque oramus sedulo ut is alium substituat <lb xml:id="p1z7"/>eumque vobis det qui sit secundum cor dei, denique qui et absque in<lb xml:id="p1z8"/>signi aliarum ecclesiarum detrimento vobis dari possit<note type="margin">Zusatz a.R.</note></s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Equidem amplissimum virum d. <persName ref="p8111">Petrum Martyrem</persName>, dominum et fratrem nostrum colendissimum cha<lb xml:id="p1z10"/>rissimumque, vix<lb xml:id="p1z11"/>dum <placeName ref="l491">Argentorato</placeName> venientem excepimus: quomodo vero derepente <lb xml:id="p1z12"/>illum iterum a nobis nunc ablegaremus, praesertim cuius <lb xml:id="p1z13"/>opera nullo modo carere potest fidelis apud nos <lb xml:id="p1z14"/>ecclesia?</s>
					<s n="6" xml:lang="la">Scit ch<lb xml:id="p1z15"/>aritas vestra, <lb xml:id="p1z16"/>semper facilius fuisse pastorem alicui ecclesiae i<lb xml:id="p1z17"/>nveni<lb xml:id="p1z18"/>re quam <lb xml:id="p1z19"/>pluribus <lb xml:id="p1z20"/>ecclesiis prophetam, sanctarum inquam scripturarum interpretem, et non pubis <lb xml:id="p1z21"/>quidem sed destinatorum sacro ministerio formatorem<lb xml:id="p1z22"/>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z23"/>Habet quidem d. <persName ref="p8111">Martyr</persName> collegam doctum fidelem pium et exercitatum <lb xml:id="p1z24"/>clarissimum virum d. <persName ref="p8171">Theodorum Bibliandrum</persName>, sed iam <lb xml:id="p1z25"/>gravibus diutinis immoderatisque fractum laboribus, adeoque sibi prope<lb xml:id="p1z26"/>modum nobisque (proh dolor)<note type="margin">Zusatz a.R.</note> inutilem.</s>
					<s n="8" xml:lang="la">Nisi ergo scholam nostram ecclesiastica<lb xml:id="p1z27"/>m dissipari et aliis quoque irrecuperabilibus <lb xml:id="p1z28"/>damnis nostram ecclesiam affici voluimus, d. <persName ref="p8111">Martyrem</persName> retinere <lb xml:id="p1z29"/>coacti sumus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Sunt enim multae aliae quoque graves causae ob quas in <lb xml:id="p1z30"/>vocationem vestram non potuimus consentire.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ego <lb xml:id="p1z31"/>quidem, <lb xml:id="p1z32"/>sicuti postulabatis, privatim <lb xml:id="p1z33"/>cum quibusdam contuli viris authoritate <lb xml:id="p1z34"/>et <lb xml:id="p1z35"/>virtute suspiciendis, sed nullum reperiebam qui non <lb xml:id="p1z36"/>indigne ferret d. <persName ref="p8111">Martyris</persName> discessum.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Vocavi praeterea <lb xml:id="p1z37"/>in coetum fratres et symmystas omnes *quibus proposita est d. <persName ref="p8111">Martyris</persName> vocatio una cum cau<lb xml:id="p1z38"/>sis suis.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z39"/>Caeterum<note type="margin">Zusatz a.R.</note> inter omnes, ne unus quidem erat, qui non bene esse cuperet vobis omni<lb xml:id="p1z40"/>bus, sed interim sana conscientia dimittere posset <lb xml:id="p1z41"/>d. <persName ref="p8111">Martyrem</persName>.</s>
					<s n="13" xml:lang="la">Necessitati itaque, non ulli aliae causae <lb xml:id="p1z42"/>tribuite quod hac in re gratificari vobis non potuimus.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z43"/>Si nostrae ecclesiae ratio vobis perinde ut nobis esset perspecta, <lb xml:id="p1z44"/>nihil dubitamus vos daturum nobis d. <persName ref="p8111">Martyrem</persName> <lb xml:id="p1z45"/>postulantibus, tantum abest ut abstrahere pergatis a re<lb xml:id="p1z46"/>nitentibus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Et cum haec revera sic habeant, ob<lb xml:id="p1z47"/>secramus ve<lb xml:id="p1z48"/>stram charitatem nihilomins ut boni <lb xml:id="p1z49"/>consulatis quod vestra<lb xml:id="p1z50"/>e <lb xml:id="p1z51"/>postulationi non acquievimus.</s>
					<s n="16" xml:lang="la">Denique iubemus ut vobis polliceamini <lb xml:id="p1z52"/>de nobis perpetuo quod de fratribus fidelibus vestrique <lb xml:id="p1z53"/>amantibus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Deus est qui ecclesiae suae pastores dat: <lb xml:id="p1z54"/>pleni ergo spe bona supplicamini deo misericord<lb xml:id="p1z55"/>i et omnipoten<lb xml:id="p1z56"/>ti spirituumque domino, ne deserat vos, sed pastorem det ad gloriam no<lb xml:id="p1z57"/>minis sui et salutem animarum vestrarum, neque hic nost<lb xml:id="p1z58"/>ro quoque deerimus offic<lb xml:id="p1z59"/>io<note type="margin">Zusatz a.R.</note>.</s>
					<s n="18" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z60"/>valete in Christo, domini ac fratres colendissimi et charissimi.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute">S<lb xml:id="p1z61"/>alutant vos in Christo servatore symmystae et fratres omnes <lb xml:id="p1z62"/>precantes vobis a domino benedictionem.</s>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 10. <lb xml:id="p1z63"/>septembris anno 1557.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z64"/>Vestri observantis<lb xml:id="p1z65"/>simus <persName ref="p495">H[einryc<lb xml:id="p1z66"/>hus] Bullingerus</persName>, <lb xml:id="p1z67"/><placeName ref="l587">Tigurinae</placeName> m<lb xml:id="p1z68"/>inister ecclesiae.</s>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Sanctae <placeName ref="l834">Italorum</placeName> <placeName ref="l167">Genevae</placeName> in <lb xml:id="p2z2"/>Christo collectae ecclesiae mihi <lb xml:id="p2z3"/>perpetuo observandissimae et cha<lb xml:id="p2z4"/>rissimae.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>