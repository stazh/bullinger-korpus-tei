	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tam saepe animo meo occurrit tui recordatio <lb xml:id="p1z2"/>et fis obvius, ut has calamo extorserit literas, quibus <lb xml:id="p1z3"/>te ad scribendum incitarem, ut diuturnum meum <lb xml:id="p1z4"/>explerer desiderium nec diutius fructu et delectatione <lb xml:id="p1z5"/>tuarum carerem.</s>
					<s n="3" xml:lang="la">Amicorum enim, qualium tu es, <lb xml:id="p1z6"/>dici non potest quam iucunde sint litere, etiamsi ab earum <lb xml:id="p1z7"/>officio non pendeat amicitia vera.</s>
					<s n="4" xml:lang="la">Motus <placeName ref="l832">Gallię</placeName> <lb xml:id="p1z8"/>et bella civilia, quę misera semper esse solent <lb xml:id="p1z9"/>et malorum plena, mutuum scribendi officium <lb xml:id="p1z10"/>retardarunt.</s>
					<s n="5" xml:lang="la">Sed deo beneficio pace et honesto <lb xml:id="p1z11"/>fruimur ocio.</s>
					<s n="6" xml:lang="la">Hoc cavendum nobis erat, ne eius <lb xml:id="p1z12"/>iram provocare pergamus fructusque reddamus <lb xml:id="p1z13"/>dignos iis, qui resipuerunt; si enim a fructibus <lb xml:id="p1z14"/>causis similia eventa expectanda sunt, coniectura <lb xml:id="p1z15"/>est securos nos esse non debere, cum frigeat <lb xml:id="p1z16"/>pietas vereque virtutes contemnantur, ut nihil <lb xml:id="p1z17"/>gravius dicam.</s>
					<s n="7" xml:lang="la">Videtur tamen nubes illa atra, <lb xml:id="p1z18"/>que maximis calamitatibus nos affecit, <placeName ref="l640">Flandriam</placeName> <lb xml:id="p1z19"/>respicere, de qua certiora poteris intelligere.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z20"/>Cęterum, ut scias, quid agat noster filius, quoniam illum revocare <lb xml:id="p1z21"/>constitui ineunte autumno, ne grave ei esset vicinas <lb xml:id="p1z22"/>regiones et antiqua monumenta non videre, adduci <lb xml:id="p1z23"/>me passus sum, ut initio aprilis elapsi cum fidis, bonis <lb xml:id="p1z24"/>et doctis commilitonibus inviseret <placeName ref="l55">Bononiam</placeName>, <placeName ref="l425">Romam</placeName>, <placeName ref="l994">Neapolim</placeName> <lb xml:id="p1z25"/>et pręcipuas Italię urbes, earum iura et mores observaret, <lb xml:id="p1z26"/>se a contagione incolumem servans et ne pungat ira spina<lb xml:id="p1z27"/>s, inter quas ambulandum illi est.</s>
					<s n="9" xml:lang="la">Meam forsan ei in <lb xml:id="p1z28"/>re improbabis facilitatem et indulgentiam.</s>
					<s n="10" xml:lang="la">Me illumque <lb xml:id="p1z29"/>tibi charum tuis commendo pręcibus.</s>
					<s n="11" xml:lang="la">Gratum fore confido <lb xml:id="p1z30"/>et memorem tuorum beneficiorum.</s>
					<s n="12" xml:lang="la">Filium comitis ab <lb xml:id="p1z31"/><persName>Alto Saxo</persName>, qui optimi parentis non degener filius et <lb xml:id="p1z32"/>probe indolis mihi videtur, habebo commendatissimum, <lb xml:id="p1z33"/>et si qua in re tibi aut amicis gratificari potero, <lb xml:id="p1z34"/>me paratissimum invenies.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Salutat te uxor; salutabis meo <lb xml:id="p1z35"/>nomine amplissimum senatum et amicos omnes.</s>
					<s n="14" xml:lang="la" ana="farewell">Bene vale nosque, <lb xml:id="p1z36"/>quod facis, amabis.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Parisiis 12. amii 1572.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z37"/>Tuus ex animo <persName ref="p629">C<lb xml:id="p1z38"/>oignetius</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z4"/>vigilantissimo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note>[Vermerk von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="19" xml:lang="la">D. <persName ref="p629">M. Coignetii</persName> <lb xml:id="p2z6"/>literae post bellum <lb xml:id="p2z7"/>scriptae mense <lb xml:id="p2z8"/>maio 1572.</s>
				</p>
			</div>
