	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Libelli Germanici de coena et
					<lb xml:id="p1z2"/>perticuli Anglici principis sunt. Eidem pr
					<lb xml:id="p1z3"/>exhibe historia Anglicana per me
					<lb xml:id="p1z4"/>missa Conrado Lycosthen, ut tibi exhi
					<lb xml:id="p1z5"/>una cum illis, quae de rebus Italicis
					<lb xml:id="p1z6"/>adieci. Habeo illa ex Bayonensis episcopo vi
					<lb xml:id="p1z7"/>docto et prudentissimo. Libellus Anglic
					<lb xml:id="p1z8"/>Latinus contines catechismum et articulos
					<lb xml:id="p1z9"/>est. Ex eo intelliges, quanta fecerit
					<lb xml:id="p1z10"/>iactura ecclesia Christi in mico hoc privun
					<lb xml:id="p1z11"/>Historiam et nova Italicam prius
					<lb xml:id="p1z12"/>lege deinde protinus vel mitte principi vel
					<lb xml:id="p1z13"/>ipse defer. In horus plurima ad me
					<lb xml:id="p1z14"/>deferuntur ex Italia et Gallia et Anglia
					<lb xml:id="p1z15"/>utinam diceret commodiorem viseirdia ad vos tran
					<lb xml:id="p1z16"/>mittere, quae accipio. Raro iuveni
					<lb xml:id="p1z17"/>tabelliones. Orandus et dominus, ut adsit
					<lb xml:id="p1z18"/>Auglicanae ecclesiae; nam vocatur regina
					<lb xml:id="p1z19"/>bolus in Anglia ex Roma homo versus
					<lb xml:id="p1z20"/>hypocrita doctus. Remitto scripta con
					<lb xml:id="p1z21"/>traversa de iustificatione, de qua iam
					<lb xml:id="p1z22"/>aulo copiosius ex professo scribo. Deo volemd
					<lb xml:id="p1z23"/>eilla brevi videbis. Ideoque libenter
					<lb xml:id="p1z24"/>legi, quae scripsere isti. Ioachimi Mornm
					<lb xml:id="p1z25"/>mi maxime probantur. Brentii non
					<lb xml:id="p1z26"/>inversum improbantur, maxime vero con
					<lb xml:id="p1z27"/>cofessionem et uultro declarationem non regu
					<lb xml:id="p1z28"/>Potuisset tamen in prioribus scripti
					<lb xml:id="p1z29"/>liberius promuciasse. Dominus pugnas illas dice
					<lb xml:id="p1z30"/>Affligitur alias ecclesia gravissimi
					<lb xml:id="p1z31"/>
					<lb xml:id="p1z32"/>ut nihil sit  calamitatibus illa quoque adde
					<lb xml:id="p1z33"/>calamitatem. De manducatione impei
					<lb xml:id="p1z34"/>piguit quicquam exarare, Nec iam
					<lb xml:id="p1z35"/>multiplicia mea negotia tantillum per
					<lb xml:id="p1z36"/>Curae
					<lb xml:id="p1z37"/>enecat. Oremus dominum
					<lb xml:id="p1z38"/>ut nobis adsit. Tuas expecto. Vive
					<lb xml:id="p1z39"/>et vale. Binas tuas accepi
					<lb xml:id="p1z40"/>
					<lb xml:id="p1z41"/>mein
					<lb xml:id="p1z42"/>A
					<lb xml:id="p1z43"/>28. augusti
					<lb xml:id="p1z44"/>1553 Salvi sint
					<lb xml:id="p1z45"/>fratres et Hospinianus.
					<lb xml:id="p1z46"/>Bullingerus tuus.
					<pb/>
					<lb xml:id="p2z1"/>Optimo viro d. Hatro
					<lb xml:id="p2z2"/>hiae Erbio doio colendimo
					<lb xml:id="p2z3"/>fratri charissimo suo.
					<lb xml:id="p2z4"/>chenwylgen
					<lb xml:id="p2z5"/>fredelite 10. septembris
				</p>
			</div>
