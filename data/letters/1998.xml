	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi ea, quae ad <persName ref="p8406">Lycost[h]enem</persName> scripsisti, cum <lb xml:id="p1z2"/>tuis ad me datis, neque dissimilia nostri statim acceperunt <lb xml:id="p1z3"/>ex <placeName ref="l830">Anglia</placeName>.</s>
					<s n="3" xml:lang="la">Nunc vero d. <persName ref="p8466">Volff[gangus] Wissemburgius</persName> <lb xml:id="p1z4"/><placeName ref="l491">Argentinae</placeName>, reversus ex thermis marchionicis, se <lb xml:id="p1z5"/>intellexisse significavit: rege quidem defuncto <persName ref="p18212">Mariam</persName> <lb xml:id="p1z6"/>constitutam reginam esse, sed religionis cursum ut hactenus <lb xml:id="p1z7"/>liberum fore et, quae sancita sunt sarta tecta habita iri; <lb xml:id="p1z8"/>nam <placeName ref="l2524">Scotiae</placeName> regem iuvenem matrimonio iungen<lb xml:id="p1z9"/>dum <persName ref="p18212">Mariae</persName> idque procerum regni consensu, imbutum <lb xml:id="p1z10"/>et ipsum verae pietatis doctrina, neque abest <lb xml:id="p1z11"/>procul, ut <placeName ref="l2524">Scotia</placeName> a <placeName ref="l832">Gallo</placeName> vel religionis ergo <lb xml:id="p1z12"/>seiungatur.</s>
					<s n="4" xml:lang="la">Haec, inquam, ille a proceribus civitatis aliquot <lb xml:id="p1z13"/>accepit, quae te nolui latere.</s>
					<s n="5" xml:lang="la">Orandus est dominus, <lb xml:id="p1z14"/>ut hunc orbem alterum filii sui luce illustret <lb xml:id="p1z15"/>et misericorditer conservet.</s>
					<s n="6" xml:lang="la">Per caetera hic est altum <lb xml:id="p1z16"/>silentium.</s>
					<s n="7" xml:lang="la">Filius tuus una cum <persName ref="p1227">Froschovero</persName> et socio hodie <lb xml:id="p1z17"/>navem neglexit, sed crastina habiturus aliam; placet ingenium <lb xml:id="p1z18"/>et verecundia, ut sperem non sine fructu in literis melioribus <lb xml:id="p1z19"/>versaturum esse et futurum aliquando senectutis tuae iucundum solatium.</s>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z20"/>Bene vale cum uxore et tuis omnibus, quos iube <lb xml:id="p1z21"/>meis verbis salvere amanter et reverenter.</s>
					<s n="9" xml:lang="la"><placeName ref="l28">Basilea</placeName> 5a septembris <lb xml:id="p1z22"/>anno 1553.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Tuus <lb xml:id="p1z24"/><persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>pastori, domino <lb xml:id="p2z5"/>et symmistae observ<lb xml:id="p2z6"/>ando suo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>