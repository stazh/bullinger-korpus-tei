	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/><persName ref="p1586">Fr<lb xml:id="p1z3"/>ancis<lb xml:id="p1z4"/>cus <lb xml:id="p1z5"/>Hoto<lb xml:id="p1z6"/>ma<lb xml:id="p1z7"/>nnus</persName> S. <lb xml:id="p1z8"/>D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Sp<lb xml:id="p1z9"/>er<lb xml:id="p1z10"/>o tibi liter<lb xml:id="p1z11"/>as mea<lb xml:id="p1z12"/>s esse <lb xml:id="p1z13"/>red<lb xml:id="p1z14"/>ditas, qua<lb xml:id="p1z15"/>s <placeName ref="l167">Gen<lb xml:id="p1z16"/>evae</placeName> a<lb xml:id="p1z17"/>nte dies <lb xml:id="p1z18"/>20 <lb xml:id="p1z19"/><persName ref="p4440">Bud<lb xml:id="p1z20"/>aeo</persName> n<lb xml:id="p1z21"/>ostro commisi, quibus te de instituta mea ad <placeName ref="l491">Argentinam</placeName> profectione <lb xml:id="p1z22"/>certiorem faciebam.</s>
					<s n="3" xml:lang="la">Ex eo tempore familiam huc abduxi, ubi tum navigium <lb xml:id="p1z23"/>tum vasa mea expectans cum summa moram traho.</s>
					<s n="4" xml:lang="la"><placeName ref="l28">Basilaea</placeName> mihi <lb xml:id="p1z24"/>antea nota non erat, tametsi saepe de ea multa audieram.</s>
					<s n="5" xml:lang="la">Sulcerum cum d. <lb xml:id="p1z25"/><persName ref="p164">Amorbachium</persName> probo imprimis itemque <persName ref="p1327">Gratarolum</persName> nostrum neque dubito esse <lb xml:id="p1z26"/>alios quam multos, quorum integritas et religio deo gratae sit.</s>
					<s n="6" xml:lang="la">Sed <persName>Castalionis</persName> <lb xml:id="p1z27"/>ita sunt studiosi et amantes plerique, ut hoc quasi Atlante coelum <lb xml:id="p1z28"/>fulciri religio et pietas existimetur.</s>
					<s n="7" xml:lang="la">Quid ego impressori <placeName ref="l832">Gallicorum</placeName> bibliorum <lb xml:id="p1z29"/>de hominis stultitia dixerim cum interpretatoris inepta audacia <lb xml:id="p1z30"/>aut favore potius, sciunt non pauci.</s>
					<s n="8" xml:lang="la">Quum a me nonnulli <lb xml:id="p1z31"/>petiissent, ut praefationis stultitiam explicarem, scriptori meo dictavi hanc <lb xml:id="p1z32"/>admonitiunculam, quam in his literis inclusi.</s>
					<s n="9" xml:lang="la">Si facultas ferret, maxi<pb/><lb xml:id="p2z2"/>mopere cuperem praefationem mutari.</s>
					<s n="10" xml:lang="la">Quae <persName>Gallis</persName> praesertim aulicis, si obiter <lb xml:id="p2z3"/>legatur, perridicula videbitur.</s>
					<s n="11" xml:lang="la"><persName ref="p540">Calvinus</persName> autem nihilo melius hic audit quam <persName ref="p1974">Luterus</persName>.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z4"/>Quod si quis aut deierantem aut lascivientem coarguat "Calvinista" contumeliae <lb xml:id="p2z5"/>causa nominatur.</s>
					<s n="13" xml:lang="la">Denique <placeName ref="l167">Genevensium</placeName> ecclesiam tueatur, quae singularem quandam <lb xml:id="p2z6"/>disciplinam et vere christianam conservat.</s>
					<s n="14" xml:lang="la"><persName ref="p18554">Regem Angliae</persName> <placeName ref="l1284">Bruxellam</placeName> venisse <lb xml:id="p2z7"/>secumque magnam nobilitatis <placeName ref="l830">Angliae</placeName> adduxisse ab <placeName ref="l875">Hispanis</placeName>, qui illinc veniunt, <lb xml:id="p2z8"/>nobis narratum est.</s>
					<s n="15" xml:lang="la">Papa cum <placeName ref="l2510">Turca</placeName> foedus inire dicitur a principe Sal..tano <lb xml:id="p2z9"/>impulsus et iunctis copiis <persName>Caesarem</persName> adoritur.</s>
					<s n="16" xml:lang="la">Dominus <persName ref="p540">Calvinus</persName>, quum illinc discessi, lateris <lb xml:id="p2z11"/>summo dolore afficiebatur; ex hoc medicus ei a pleuritidis morbo pertimescebat.</s>
					<s n="17" xml:lang="la">Q<lb xml:id="p2z12"/>uaeso, ut <lb xml:id="p2z13"/>consolere; nam undique allatratur iportunissime et immanissime; quos significem<lb xml:id="p2z14"/>, satis nosti.</s>
					<s n="18" xml:lang="la" ana="salute"><lb xml:id="p2z15"/>Dominum <persName ref="p1283">Gesnerum</persName>, <lb xml:id="p2z16"/>virum clarissimum, <lb xml:id="p2z17"/>duo<lb xml:id="p2z20"/>s <lb xml:id="p2z21"/>tuos generos, et eruditissim<lb xml:id="p2z22"/>os et humanis<lb xml:id="p2z23"/>simos viro<lb xml:id="p2z24"/>s, item d<lb xml:id="p2z25"/>ominum <persName ref="p1936">Lis<lb xml:id="p2z26"/>maninum</persName>, <lb xml:id="p2z27"/>eximia p<lb xml:id="p2z28"/>ietate et v<lb xml:id="p2z29"/>irtu<lb xml:id="p2z30"/>te hominem, mei<lb xml:id="p2z31"/>s verbis quaeso ut <lb xml:id="p2z32"/>ornate et honor<lb xml:id="p2z33"/>ifice salutes.</s>
					<s n="19" xml:lang="la" ana="farewell"><lb xml:id="p2z34"/>R[everende] p[<lb xml:id="p2z35"/>ater], va<lb xml:id="p2z36"/>le, vir clarissime et pater observandissime.</s>
					<s n="20" xml:lang="la"><placeName ref="l28">Basileae</placeName> 3. <lb xml:id="p2z37"/>calendas octobris 1555.</s>
				</p>
				<p>
					<note>[Vermerk: Vide <persName ref="p1586">Hotomannorum</persName> epistolas p. t.]</note>
				</p>
