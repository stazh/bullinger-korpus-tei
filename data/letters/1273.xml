	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Vir clarissime, veni <placeName ref="l87">Casaciam</placeName> vocatus, <lb xml:id="p1z3"/>ut adversus papam et missam, eius <lb xml:id="p1z4"/>creaturam, verba facerem.</s>
					<s n="2" xml:lang="la">Hic itaque <lb xml:id="p1z5"/>incidi in hominem, qui ad vos mane <lb xml:id="p1z6"/>venit, et scribo tumultuarie.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Erant quinque vici, qui unum ha<lb xml:id="p1z8"/>bebant concionatorem, nunc singuli <lb xml:id="p1z9"/>suum habent; in summa: progreditur <lb xml:id="p1z10"/>evangelium.</s>
					<s n="4" xml:lang="la">Sed contra papa clam<lb xml:id="p1z11"/>at et minatur velle perdere <lb xml:id="p1z12"/><placeName ref="l648">Rhaetos</placeName>, si diutius me audierint.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z13"/>Vix crederes, quot verba de me <lb xml:id="p1z14"/>ille Antichristus.</s>
					<s n="6" xml:lang="la">Tandem sensit <lb xml:id="p1z15"/>verbula mea, quę per <placeName ref="l834">Italiam</placeName> <lb xml:id="p1z16"/>spargebam; nondum enim finis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Tua <lb xml:id="p1z17"/>demonstratio iam sparsa est <lb xml:id="p1z18"/>magno, (quod certo rescivi), illius <lb xml:id="p1z19"/>bestiae dolore.</s>
					<s n="8" xml:lang="la">Sed insaniat et fremat; <lb xml:id="p1z20"/>nam propediem interficietur.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z21"/>Reprehendit <placeName ref="l522">Venetos</placeName> emissa bulla, qui <lb xml:id="p1z22"/>non patiuntur solos monachos posse, <lb xml:id="p1z23"/>quę volunt, adversus fratres macchi<pb/><lb xml:id="p2z1"/>nari, sed magistratum quempiam addidere, <lb xml:id="p2z2"/>qui illis praesit.</s>
					<s n="10" xml:lang="la">Nunc certabunt i<lb xml:id="p2z3"/>nter sese; <lb xml:id="p2z4"/>spero <placeName ref="l522">Venetos</placeName> non <lb xml:id="p2z5"/>cessuros.</s>
					<s n="11" xml:lang="la">Fervet persecutio in <placeName ref="l834">Italia</placeName>.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z6"/>Ego tandem ad vos <lb xml:id="p2z8"/>propediem me recipiam.</s>
					<s n="13" xml:lang="la" ana="salute">Saluto <lb xml:id="p2z9"/>scholam omnem et eccle<lb xml:id="p2z10"/>siam.</s>
					<s n="14" xml:lang="la">Rogate pro nobis, qui <lb xml:id="p2z12"/>valde laboramus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z13"/><placeName ref="l87">Cassacii</placeName>, <lb xml:id="p2z14"/>nonis maii <lb xml:id="p2z15"/>1551.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z16"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p3z2"/>C<lb xml:id="p3z3"/>l<lb xml:id="p3z4"/>arissimo <lb xml:id="p3z5"/>viro dom<pb/><lb xml:id="p4z1"/>ino <lb xml:id="p4z2"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p4z3"/><placeName ref="l587">Tigurinę</placeName> ecclesię <lb xml:id="p4z4"/>pastori, fratri honorando<note type="margin">a.R.: ...</note>.</s>
					<s n="18" xml:lang="la"><lb xml:id="p4z5"/><placeName ref="l587">Tigur<lb xml:id="p4z6"/>i</placeName>.</s>
				</p>
			</div>
		</body>
