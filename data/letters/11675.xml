	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Salve, charissimorum charissime <persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Dedi ad te literas <lb xml:id="p1z3"/>27. aprilis<note xml:id="fn1" type="footnote" n="1">Oben <ref target="file11667">Nr. 1624</ref>.</note>, in quibus te certiorem reddidi de comitiorum<note xml:id="fn2" type="footnote" n="2">Gemeint ist der Reichstag zu <placeName ref="l471">Speyer</placeName>.</note> exitu, <lb xml:id="p1z4"/>quantum quidem id temporis rescire licebat.</s>
					<s n="3" xml:lang="la">Nunc optimus hic <lb xml:id="p1z5"/>adulescens <persName ref="p4868">Iacobus Velocianus</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p4868">Jakob Funcklin</persName>.</note>, si quid adhuc eius rei desideras, <lb xml:id="p1z6"/>ad satietatem usque, quod reliquum est, tibi narraverit, quandoquidem <lb xml:id="p1z7"/>diligens et attentissimus auditor adfuit, quum <persName ref="p4082">Conradus Zviccius</persName> <lb xml:id="p1z8"/>noster in fratrum conventu omnia istęc prolixe bonaque fide retulit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Lavabunt non procul a <placeName ref="l587">Tiguro</placeName><note xml:id="fn4" type="footnote" n="4">Wohl in <placeName ref="l515">Urdorf</placeName>, <placeName ref="l803">Kt. Zürich</placeName>, oder <placeName ref="l21">Baden</placeName>, <placeName ref="l594">Kt. Aargau</placeName>.</note> <persName ref="p4082">Conradi</persName> <persName ref="p7213">uxor</persName><note xml:id="fn5" type="footnote" ana="bio" n="5"><persName ref="p7213">Amalia Zwick, geb. Muntprat</persName>. - Lit.: <persName ref="p8055">Blarer</persName> BW II u. III, Reg.; <bibl source="b661">Vögeli, Schriften</bibl> II/2 1224.</note> cum tribus filiis<note xml:id="fn6" type="footnote" n="6">Von <persName ref="p4082">Konrad Zwick</persName> sind fünf Söhne bekannt; zu den drei hier genannten zählen sicherlich <persName ref="p7216">Jakob</persName> und <persName ref="p7220">(Georg) Ulrich</persName>, in der Literatur begegnet man noch deren Brüdern <persName ref="p7218">Konrad</persName>, <persName ref="p7215">Hartmann</persName> und <persName ref="p7217">Joseph</persName>; vgl. <persName ref="p8055">Blarer</persName> BW II u. III, Reg.</note> <lb xml:id="p1z10"/>et meo <persName ref="p4322">nepote</persName> ex fratre<note xml:id="fn7" type="footnote" n="7"><persName ref="p4322">Albert Blarer</persName>; s. <persName ref="p8055">Blarer</persName> BW II 62, Anm. 3.</note>, quibus <persName ref="p7216">Iacobum</persName> hunc, quo pędagogo <lb xml:id="p1z11"/>iam aliquamdiu usi sunt, visum est addere, praesertim cum ipse <lb xml:id="p1z12"/>quoque non ferenda scabie discrucietur, ne disciplinę iugum inso<lb xml:id="p1z13"/>lentius iactent.<pb type="edition" next="90"/></s>
				</p>
				<p>
					<s n="5" xml:lang="la"><persName ref="p4079">Zviccius</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p4079">Johannes Zwick</persName>.</note>, qui rursum iam minimum a morte <lb xml:id="p1z14"/>abfuit, nonnihil iterum<note xml:id="fnb" type="footnote" n="b">iterum <hi>über gestrichenem</hi> iam.</note> domini beneficio respirat<note xml:id="fn9" type="footnote" n="9">Zu <persName ref="p4079">Zwicks</persName> Krankheit s. zuletzt oben <ref target="file11667">Nr. 1624</ref>, 16-20.</note>.</s>
					<s n="6" xml:lang="la">Scripserat non pridem <lb xml:id="p1z15"/><persName ref="p8127">Pellicanus</persName> noster te, <persName ref="p1753">Leonem</persName><note xml:id="fn10" type="footnote" n="10"><persName ref="p1753">Leo Jud</persName>.</note>, <persName ref="p8171">Theodorum</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p8171">Theodor Bibliander</persName>.</note>, se quoque et cęteros non satis <lb xml:id="p1z16"/>recte valere;<note xml:id="fn12" type="footnote" n="12">Ein solcher Brief ist nicht erhalten. Zu den Erkrankungen vgl. oben <ref target="file11664">Nr. 1621</ref>, 4-13.</note> sed speramus Christi medica manu omnes vos restitutos.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/>Exhibebit tibi <persName ref="p4868">Velocianus</persName> <persName ref="p3590">landtgravii</persName><note xml:id="fn13" type="footnote" n="13"><persName ref="p3590">Philipp von Hessen</persName>.</note> scriptum ad <persName ref="p8441">C[asparem] Schwenck<lb xml:id="p1z18"/>feldum</persName>, <lb xml:id="p1z19"/>quod ille <foreign xml:lang="el">ἄνευ Θησέως</foreign><note xml:id="fn14" type="footnote" n="14">Ohne Hilfe; vgl. <bibl source="b56">Adagia</bibl> 1, 5, 27 (<bibl source="b370">LB</bibl> II 191f).</note> confecisse affirmatur,<note xml:id="fn15" type="footnote" n="15">Zur Antwort des <persName ref="p3590">Landgrafen Philipp</persName> an <persName ref="p8441">Schwenckfeld</persName> vom 7. Februar 1542 vgl. <bibl source="b169">CSch</bibl> VIII 135; <bibl source="b41">Vadian BW VI</bibl> 120. Eine Abschrift befindet sich in Zürich StA, E II 446, 81-84.</note> et resipit <lb xml:id="p1z20"/>stilus ipse militare quiddam et principale.</s>
					<s n="8" xml:lang="la">Quid ego de <persName ref="p8441">C[aspare] S[chwenckfeldo]</persName> <lb xml:id="p1z21"/>sentiam, proximis literis ad te perscripsi<note xml:id="fn16" type="footnote" n="16">Vgl. oben <ref target="file11667">Nr. 1624</ref>, 39-62.</note>.</s>
					<s n="9" xml:lang="la">Plus ille nostris <lb xml:id="p1z22"/>ecclesiis incommodat, quam quisquam non expertus credere possit.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Ita certe comparata sunt plęrorumque ingenia, ut, ubi vitam viderint <lb xml:id="p1z24"/>insigni temperantia commendatam, mox etiam profectam ab hoc <lb xml:id="p1z25"/>doctrinam, praesertim si suaviloquentia quadam condita sit, veram et <lb xml:id="p1z26"/>solidam iudicent.</s>
					<s n="11" xml:lang="la">Hinc enim et vitę <persName ref="p21151">Ioannis</persName><note xml:id="fn17" type="footnote" n="17">Gemeint ist <persName ref="p21151">Johannes der Täufer</persName>.</note> austeritas doctrina<lb xml:id="p1z27"/>m ipsius ita vehebat, ut prae illa Christus quoque multis sordesceret.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z28"/>Utinam in tempore malum hoc de ecclesiis tua tuique similium vigilantia <lb xml:id="p1z29"/>tolleretur!</s>
					<s n="13" xml:lang="la">Postquam enim altius egerit radices, difficillimum sane fuerit <lb xml:id="p1z30"/>stirpium tenus revellere.</s>
					<s n="14" xml:lang="la">Tu hic vide, obsecro, ne partes tuas negligas; <lb xml:id="p1z31"/>nam ecclesię Christi supra modum commodabit, quisquis blandissimum hunc, sed nocentissimum <lb xml:id="p1z32"/>hostem forti manu confecerit.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z33"/>Apud <persName ref="p20167">sororem</persName><note xml:id="fn18" type="footnote" ana="bio" n="18"><persName ref="p20167">Barbara von Ulm, geb. Blarer</persName>, die Schwester des <persName ref="p8055">Ambrosius Blarer</persName>.</note> et <persName ref="p2300">sororium</persName><note xml:id="fn19" type="footnote" n="19"><persName ref="p2300">Heinrich von Ulm</persName>.</note> <placeName ref="l184">Griessenbergi</placeName><note xml:id="fn20" type="footnote" n="20"><placeName ref="l184">Schloss Grießenberg</placeName> (<placeName ref="l2352">Amlikon</placeName>, <placeName ref="l774">Kt. Thurgau</placeName>).</note> hisce diebus fui, qui diligentissime <lb xml:id="p1z34"/>mihi demandarunt, ut, si quando ad te scriberem, suis quoque verbis <lb xml:id="p1z35"/>salvere te multum iuberem, quamquam sororius ipse vel iam fuit <placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z36"/>vel erit propediem.</s>
					<s n="16" xml:lang="la">Simul<note xml:id="fnc" type="footnote" n="c"><hi>Zum Folgenden eine durch Streichung unlesbar gemachte Bemerkung am Rande.</hi></note> autem indicabant rogatos se a senioris<note xml:id="fnd" type="footnote" n="d"><hi>Korrigiert aus</hi> iunioris.</note> <lb xml:id="p1z37"/><persName ref="p2816">Röstii</persName><note xml:id="fn21" type="footnote" n="21"><persName ref="p2816">Diethelm Röist</persName>.</note>, consulis vestri, nuru<note xml:id="fne" type="footnote" n="e">nuru <hi>über gestrichenem</hi> uxore <hi>nachgetragen.</hi></note> <persName ref="p20168">Barbara ab Ulmis</persName><note xml:id="fn22" type="footnote" ana="bio" n="22"><persName ref="p20168">Barbara, geb. von Ulm</persName>, geboren nach 1519, war die Tochter <persName ref="p18627">Hans Jakob von Ulms</persName> und der <persName ref="p20131">Barbara zum Tor</persName>. Beide Eltern starben schon vor 1539, woraufhin <persName ref="p2300">Heinrich von Ulm</persName> die Vormundschaft der Kinder übernahm. <persName ref="p20168">Barbara</persName> war die Stiefschwester des späteren <persName ref="p495">Bullingerkorrespondenten</persName> <persName ref="p20173">Johannes von Ulm</persName> und heiratete 1541 <persName ref="p6319">Jakob Röist</persName>. Lit.: Carl <hi>Keller-Escher,</hi> Promptuarium genealogicum, Bd. VII (Zürich ZB, Ms Z II 6a), S. 157 (dort als "Anna" aufgeführt); <persName ref="p8055">Blarer</persName> BW II 526, <ref target="file11406">Nr. 1363</ref>, und Reg.</note>, ut per me tibi <lb xml:id="p1z38"/>commendetur, id quod sic abs te inpetratum cupio ut quod maxime; <lb xml:id="p1z39"/>est enim vere pia<pb type="edition" next="91"/> mulier, qua parte formam, et si quid aliud in ipsa <lb xml:id="p1z40"/>gratiarum desideratur, pulchre compensat.</s>
					<s n="17" xml:lang="la">Interim autem pusillanimis est <lb xml:id="p1z41"/>nec scrupulis caret moleste subinde punctitantibus, quas tu illi <lb xml:id="p1z42"/>pro christiana tua prudentia et familiaritate, qua <persName ref="p2816">socero</persName><note xml:id="fn23" type="footnote" n="23"><persName ref="p2816">Diethelm Röist</persName>.</note> et <persName ref="p6319">marito</persName><note xml:id="fn24" type="footnote" ana="bio" n="24"><persName ref="p6319">Jakob Röist (Röust)</persName> (1523-1573), der Sohn <persName ref="p2816">Diethelms</persName>, war 1545-1553 und 1561-1570 Mitglied des Kleinen Rats der Stadt <placeName ref="l587">Zürich</placeName>, 1546-1553 Obervogt zu <placeName ref="l1037">Wollishofen</placeName>, 1553-1559 Landvogt zu <placeName ref="l131">Eglisau</placeName>, 1563-1570 Obervogt zu <placeName ref="l1818">Wipkingen</placeName> und 1570-1573 zu <placeName ref="l2581">Laufen</placeName>. 1556 verkaufte er seinen Anteil an den Gerichten zu <placeName ref="l1366">Trüllikon</placeName> und <placeName ref="l1910">Truttikon</placeName> an das Kloster <placeName ref="l2545">Rheinau</placeName>. <persName ref="p6319">Röist</persName> war 1561 der Taufpate von <persName ref="p495">Bullingers</persName> Enkelin <persName ref="p7230">Margret oder Margarita</persName>, der Tochter von <persName ref="p7224">Anna, geb. Bullinger</persName> und <persName ref="p4091">Ulrich Zwingli</persName>. - Lit.: <bibl source="b291">HBLS</bibl> V 665; <bibl source="b288">HBD</bibl> 67, 17f und 118, 1-3.</note> <lb xml:id="p1z43"/>coniunctus es, facile eximes, ut ad iustum aliquando animi robur grandescat.</s>
					<s n="18" xml:lang="la">Expiscaber<lb xml:id="p1z44"/>is tu vero malum hoc ab illa certo artificio et velut aliud agens; alioqui pudor obstabit, quominus istuc tibi retegat<note xml:id="fnf" type="footnote" n="f"><hi>Von</hi> Expiscaberis <hi>bis</hi> retegat <hi>am Rande nachgetragen.</hi></note>.</s>
					<s n="19" xml:lang="la" ana="salute"><lb xml:id="p1z45"/>Salutabis autem illam valde quam amanter meis quoque verbis non praeteritis <persName ref="p21180">Röstio</persName> <persName ref="p2816">patre</persName> et <persName ref="p6319">filio</persName>, quibus commendari abs te unice cupio<lb xml:id="p1z46"/>.</s>
					<s n="20" xml:lang="la">Affirmant in filio mire elucere patris ingenium et mores, ut hinc <lb xml:id="p1z47"/>habeat vestra respublica, unde sibi maximopere gratuletur, quum pater <lb xml:id="p1z48"/>optimi et felicissimi consulis omnes numeros impleverit, ut se consule <lb xml:id="p1z49"/>haud immerito <placeName ref="l587">Tigurum</placeName> vestrum fortunatum natum pronunciare possimus<note xml:id="fn25" type="footnote" n="25">Vgl. <persName ref="p4543">Cicero</persName>, Carminum (praeter Aratea) fragmenta, 12.</note>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="salute"><lb xml:id="p1z50"/>Saluta castissimam <persName ref="p8051">coniugem</persName><note xml:id="fn26" type="footnote" ana="bio" n="26"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> cum tota tua domo et omnibus administris tuis in <lb xml:id="p1z51"/>domino, praecipue <persName ref="p8011">Gvalthero</persName> amicissimo nostro.</s>
					<s n="22" xml:lang="la" ana="salute">Salutant te nostri omnes.</s>
					<s n="23" xml:lang="la" ana="farewell"><lb xml:id="p1z52"/>Bene vale, anima mea et cor meum, in domino.</s>
					<s n="24" xml:lang="de">22. maii 1542.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Tuus <persName ref="p8055">Ambr. <lb xml:id="p1z53"/>Blaur.</persName></s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Sanequam venerando atque charissimo <lb xml:id="p2z2"/>suo fratri d. <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tiguricensis</placeName> ecclesiae episcopo.</s>
				</p>
			</div>
