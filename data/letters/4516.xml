	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Ex <placeName ref="l18">Augusta</placeName> 18. octobris:</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Prodiit dialogus, in quo <persName ref="p2095">Melanchton</persName> ad inferos de<lb xml:id="p1z3"/>truditur.</s>
					<s n="3" xml:lang="la">Interloqutores sunt <persName ref="p2411">Otto Heinrychus</persName> e<lb xml:id="p1z4"/>lector, <persName ref="p18250">Mauritius</persName> elector, <persName ref="p8371">Albertus</persName> marchio et alii <lb xml:id="p1z5"/>quidam, qui misere conqueruntur, quod turpiter <lb xml:id="p1z6"/>sint seducti.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Ex <placeName ref="l28">Basilea</placeName>, 20. octobris:</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/><placeName ref="l300">Lucernenses</placeName> 3. novembris omnino volunt iudicium <lb xml:id="p1z9"/>fieri contra <persName>Gallum</persName> de lucro vel chura aut inter<lb xml:id="p1z10"/>esse 16. pro 100, nec quicquam volunt remittere nec <lb xml:id="p1z11"/>ullam interponi dilationem.</s>
					<s n="6" xml:lang="la">Tumultus in <placeName ref="l832">Gallia</placeName> <lb xml:id="p1z12"/>dicuntur in diem augeri.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Fama est ducem <placeName ref="l1098">Florentiae</placeName> <lb xml:id="p1z13"/>occupasse <placeName ref="l2801">Corsicam</placeName> insulam.</s>
					<s n="8" xml:lang="la">Papa dicitur <lb xml:id="p1z14"/>militem colligere, velle item, ut provinciales <lb xml:id="p1z15"/>et guardiani conventuum sese parent, ut, si nation<lb xml:id="p1z16"/>ale concilium in <placeName ref="l832">Gallia</placeName> neque per se neque per <placeName ref="l875">Hispanum</placeName> <lb xml:id="p1z17"/>possit turbari, disputent in eo.</s>
					<s n="9" xml:lang="la"><persName>Bollvylerus</persName> <lb xml:id="p1z18"/>cupit alicubi summam pecuniae mutuari, ut mi<lb xml:id="p1z19"/>litem colligat, forte ut praesidium imponat <placeName ref="l257">Constantiae</placeName>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/>Ex <placeName ref="l167">Geneva</placeName>, 14. octobris: <lb xml:id="p1z21"/><persName ref="p18090">Rex Navarrae</persName> in aulam accitus nunc est in itinere, <lb xml:id="p1z22"/>fratrem adducit.</s>
					<s n="11" xml:lang="la">Sic autem dispositae sunt centuriae <lb xml:id="p1z23"/><placeName>Gallici</placeName> equitatus, ut undique <persName>Navarrum</persName> circumveniant.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/>Eventus in manu dei est, qui forte brevi dissipabit, <lb xml:id="p1z25"/>quicquid callide videntur sibi moliri.</s>
					<s n="13" xml:lang="la">Uno capite oppresso <lb xml:id="p1z26"/>promittunt sibi de omnibus facilem victoriam.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Sed si <lb xml:id="p1z27"/><persName>Navarrum</persName> hostiliter aggressi fuerint, opponent se, quod <lb xml:id="p1z28"/>spero, pro eius defensione multi.</s>
					<s n="15" xml:lang="la">Decrevit is ius suum <lb xml:id="p1z29"/>recuperare in concilio, sed absque armis.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Missa est <lb xml:id="p1z30"/>ex <placeName ref="l875">Hispania</placeName> legatio, quae concilium nationale in <lb xml:id="p1z31"/><placeName ref="l832">Gallia</placeName> disturbet.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z32"/>Die Michaelis <placeName ref="l311">Martburgi</placeName>: "<lb xml:id="p1z33"/>Mitto theses disputationis <placeName ref="l210">Haydelbergae</placeName> habitae, <lb xml:id="p1z34"/>de qua audistis forte."</s>
					<s n="18" xml:lang="la">Haec <persName ref="p8386">Hyperius</persName>, qui alias <lb xml:id="p1z35"/>multa quidem ad me scribit, sed nihil nisi faustum et <lb xml:id="p1z36"/>quod testatur negotium religionis feliciter progredi.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z37"/>Mitto illas theses; mitto, quae ex <placeName ref="l210">Haydelberga</placeName> <lb xml:id="p1z38"/>ipsa accepi de disputatione illa, quae tu remitt<lb xml:id="p1z39"/>es ad me.</s>
				</p>
				<p>
					<note>[Darunter Bemerkung von <persName ref="p8009">Fabricius</persName>]</note>
					<s n="20" xml:lang="la"><lb xml:id="p1z40"/>Anno d[omini] 1560, in <lb xml:id="p1z41"/>motibus bellicis.</s>
				</p>
				<p>
					<s n="21" xml:lang="de"><pb/><lb xml:id="p2z1"/>An herren <persName ref="p8009">Johansen <lb xml:id="p2z2"/>Schmiden</persName>, predicanten <lb xml:id="p2z3"/>zuͦ <placeName ref="l98">Chur</placeName>, sinem g<lb xml:id="p2z4"/>ünstigen herren.</s>
					<s n="22" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
