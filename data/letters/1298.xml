	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salutem a domino, exoptat.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Etsi nulla consuetudo inter nos intercessit nec te unquam <lb xml:id="p1z3"/>vidi (clarissime vir) tamen ex libris aeditis videor mihi <lb xml:id="p1z4"/>te cognoscere et ex scriptis ad dominum meum dominum <lb xml:id="p1z5"/><persName ref="p8068">marchionem <lb xml:id="p1z6"/>Dorcester</persName> literis, precipue autem ex commemoratione et <lb xml:id="p1z7"/>sermone de te habito cum <persName ref="p20172">Ioanne ab Ulmis</persName>, pio iuvene <lb xml:id="p1z8"/>et tui studiosissimo, qui contantem me, et leniter initio <lb xml:id="p1z9"/>refragantem pene tandem coegit, ut aliquid ad te scriberem.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z10"/>Si quid igitur peccatum est ista audacia <foreign xml:lang="el">καὶ αὐτοσχε<lb xml:id="p1z11"/>διασμῷ</foreign> et (ut plane dicam) inanitate orationis, in eum culpam <lb xml:id="p1z12"/>conferas, quaeso, tametsi ingenue fateor me (desyderio te <lb xml:id="p1z13"/>plenius cognoscendi) eadem aliqua ex parte teneri.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z14"/>Dominus Iesus Christus tuo semper adsit ministerio teque <lb xml:id="p1z15"/>suo spiritu omni ratione tueatur et gubernet.</s>
					<s n="5" xml:lang="la">Spero te <lb xml:id="p1z16"/>mei meminisse in tuis ad dominum precibus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z17"/><placeName ref="l60">Brodgati</placeName> prope <placeName ref="l60">Lecestriam</placeName> quarto calendas iunii 1551.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z18"/>Tui tuaeque pietatis studiosissimus <lb xml:id="p1z19"/><persName ref="p1422">Iacobus Haddonus</persName><note type="margin">a.R.: ô!</note>.</s>
				</p>
				<p>
					<note>[Von <persName ref="p20172">Johannes von Ulm</persName>:]</note>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo theologo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae servo.</s>
				</p>
				<p>
					<note type="author">[Darunter von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="9" xml:lang="la"><lb xml:id="p2z4"/><persName ref="p1422">Iacobus Haddonus</persName>, <lb xml:id="p2z5"/><placeName ref="l830">Anglus</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
