			<zone xml:id="p2z22-0" points="1606,1757 1772,1726 1938,1782 2168,1795 2277,1719 2387,1770 2463,1734 2522,1775 2629,1765 2626,1670 2264,1693 2088,1645 1910,1680 1823,1645 1604,1688">1618,1719 1668,1720 1719,1723 1770,1714 1821,1710 1872,1710 1923,1710 1974,1708 2025,1710 2076,1711 2127,1713 2177,1714 2228,1718 2279,1719 2330,1722 2381,1725 2432,1728 2483,1729 2534,1732 2585,1736 2636,1734</zone>
