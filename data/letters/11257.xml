	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus et pax Christi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Cum <persName ref="p7201">Iacobo</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p7201">Jakob Zorn</persName>; vgl. oben <ref target="file11255">Nr. 1212</ref>, 2-10, und unten <ref target="file11290">Nr. 1247</ref>.</note> conferam ex<note xml:id="fna" type="footnote" n="a"><hi>vor</hi> ex <hi>gestrichenes</hi> 1.</note> tuis literis<note xml:id="fn2" type="footnote" n="2">Nicht erhalten.</note>, ubi ad me <lb xml:id="p1z3"/>redierit.</s>
					<s n="3" xml:lang="la">Ego optarem illum diutius hęrere posse, <lb xml:id="p1z4"/>cum rarissimi sint, qui digne substituantur, <lb xml:id="p1z5"/>et periculosum sit, si vacent ecclesiae.<pb type="edition" next="32"/></s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/><persName ref="p5565">Capitoni</persName> hodie mitto literas<note xml:id="fn3" type="footnote" n="3">Nicht erhalten.</note>, in quibus peto, ut <lb xml:id="p1z7"/>me profectionis suae faciat, quantum licet, <lb xml:id="p1z8"/>certiorem<note xml:id="fn4" type="footnote" n="4">Zum Gerücht, <persName ref="p5565">Capito</persName> werde nach <placeName ref="l41">Bern</placeName> reisen, s. oben <ref target="file11255">Nr. 1212</ref>, 11 mit Anm. 2.</note>; acceptum ergo responsum tibi quoque <lb xml:id="p1z9"/>communicabo.</s>
					<s n="5" xml:lang="la">Alioqui res nunc bene habent, <lb xml:id="p1z10"/>et semper putavi silentio commodissime posse <lb xml:id="p1z11"/>mederi controversiis.</s>
					<s n="6" xml:lang="la"><persName ref="p467">Bucerus</persName> iam diu <lb xml:id="p1z12"/>abfuit in Hassia et etiamnum aiunt esse <lb xml:id="p1z13"/><placeName ref="l558">Wittenbergae</placeName><note xml:id="fn5" type="footnote" n="5">Vgl. <bibl source="b10">HBBW VIII</bibl> <ref target="file11243">[Nr. 1200]</ref>, S. 269, 6-10.</note>; illius reditus quid sit daturus, <lb xml:id="p1z14"/>audiemus postea.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><foreign xml:lang="de">Ach,</foreign> quam exhilarat me, <lb xml:id="p1z15"/>quod scribis quotidie apud vos proficere pietatem <lb xml:id="p1z16"/>et bonas literas!</s>
					<s n="8" xml:lang="la">Dominus hunc profectum magis <lb xml:id="p1z17"/>ac magis firmet.</s>
					<s n="9" xml:lang="la">Quę nobis dominus minatur, <lb xml:id="p1z18"/>non sunt nova; nunquam non aliquo portento <lb xml:id="p1z19"/>multis iam annis monuit nos, sed fides r<lb xml:id="p1z20"/>ara est.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Co[mes] a <persName ref="p7492">Furstenberg</persName> nihil apud <lb xml:id="p1z21"/>nos aliud egit, nisi quod urbem invisit<note xml:id="fn6" type="footnote" n="6">Über den Besuch <persName ref="p7492">Wilhelms von Fürstenberg</persName> in Konstanz berichtet auch <persName ref="p8055">Ambrosius Blarer</persName>, s. <bibl source="b51">Blarer BW</bibl> II 14.</note>; <lb xml:id="p1z22"/>fuit enim in vicino cum fratre<note xml:id="fn7" type="footnote" n="7">Graf <persName ref="p20485">Friedrich von Fürstenberg-Heiligenberg</persName>.</note> suo etc.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z23"/>Vale, nec desinas me amare et orare pro me.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/>Familiam totam cupio bene habere.</s>
					<s n="13" xml:lang="la">17. ianuarii <lb xml:id="p1z25"/>1539.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Tuus <lb xml:id="p1z26"/><persName ref="p4079">Io. Zwick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Hainricho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesiae ornamento, <lb xml:id="p2z4"/>fratri observando.</s>
				</p>
			</div>
		</body>
	</text>
