	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Si quid novi habeo, dominis tuis mitto, <lb xml:id="p1z3"/>quare non repeto et hec raptim a me <lb xml:id="p1z4"/>habebis, ut scias filium <persName ref="p18538">Cesaris</persName> singulis <lb xml:id="p1z5"/>horis expectari in <placeName ref="l640">Flandria</placeName>, ut <lb xml:id="p1z6"/>matrimonium <placeName ref="l830">Anglicanum</placeName> perficiat.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Interea, ut heri habui per literas <lb xml:id="p1z8"/>scriptas ex <placeName ref="l296">Londino</placeName> ante 12 dies, <lb xml:id="p1z9"/>regina illa exercet inauditam <lb xml:id="p1z10"/>tyrannidem.</s>
					<s n="4" xml:lang="la">Iam enim ad quadringentos <lb xml:id="p1z11"/>viros optimos et nobiles occidit, ex<lb xml:id="p1z12"/>pectaturque de propria sorore <persName>Is<lb xml:id="p1z13"/>abella</persName> <lb xml:id="p1z14"/>idem eventus; nam fuit ante viginti <lb xml:id="p1z15"/>dies capta, et agitur in eam summo <lb xml:id="p1z16"/>iure.</s>
					<s n="5" xml:lang="la">Apud nos arma parantur, ut <lb xml:id="p1z17"/>scis, nec spes alia est quam in terro <lb xml:id="p1z18"/>dominus adsit.</s>
					<s n="6" xml:lang="la">Ero die dominico <placeName>Badde</placeName>, <lb xml:id="p1z19"/>unde, si quid novi habuero, te participem faciam.</s>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z20"/>Vale optime.</s>
					<s n="8" xml:lang="la">Ex <placeName ref="l760">So<lb xml:id="p1z21"/>luturo</placeName> <lb xml:id="p1z22"/>5a aprilis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Tuus semper <persName ref="p8296">Basse<lb xml:id="p1z23"/>fontaneus</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p4z1"/>Domino <persName ref="p495">Bulingero</persName>, <lb xml:id="p4z2"/>viro optimo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p4z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note>[von andrer Hand:]</note>
					<s n="12" xml:lang="de"><lb xml:id="p4z4"/>Diser brieff gehörtt <lb xml:id="p4z5"/>dem herren <persName ref="p495">Bullinger</persName> zuͦ <lb xml:id="p4z6"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
