	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quod de pontificis cum <persName>Philippo</persName> pacificatione scribis, <persName ref="p1049">Farellus</persName> et <lb xml:id="p1z2"/><persName ref="p8033">Beza</persName> confirmaverunt, neque id non praevisum et praecogitatum multis accidit, <lb xml:id="p1z3"/>et tamen haec bestia adoratur ab iis saltem, qui, licet perfidiam detestentur papae, <lb xml:id="p1z4"/>sanum tamen papatum habent.</s>
					<s n="3" xml:lang="la">De colloquio nihildum habeo, eo quod <persName ref="p8126">Oporinus</persName> <lb xml:id="p1z5"/>noster (quod sciam) nondum redierit, per quem literas expecto et relationem <lb xml:id="p1z6"/>vel ab ipso cognitorum.</s>
					<s n="4" xml:lang="la">Involvitur periculo propter libellum de <placeName>Misnico</placeName> et <lb xml:id="p1z7"/><placeName ref="l749">Saxonico</placeName> bello a <persName ref="p4421">Brillingero</persName> ipso exhibitore excusum, in quo etsi <lb xml:id="p1z8"/>synceriter et acute iudicet autor, quem incertum esse ferunt, afficto titulo, <lb xml:id="p1z9"/>ab electore <placeName ref="l749">Saxone</placeName> tamen impugnatur, quod fratrem <persName ref="p18250">Mauricium</persName> non <lb xml:id="p1z10"/>le iter attingat.</s>
					<s n="5" xml:lang="la">Metuo male, ne et haec tragoedia aliquod sit praeiudicium <lb xml:id="p1z11"/>datura futurum impedimento scriptis etiam sanioribus.</s>
					<s n="6" xml:lang="la">Vix enim <lb xml:id="p1z12"/>nuper propter <persName ref="p714">Caelii</persName> nostri De amplitudine regni dei librum ortam querelam <lb xml:id="p1z13"/>sedavimus, ut periculum sit, ne exacerbetur tandem magistratus et <lb xml:id="p1z14"/>gravius aliquid statuat.</s>
					<s n="7" xml:lang="la">De <persName ref="p20206">Gribaldo</persName> scio nota tibi omnia <lb xml:id="p1z15"/>esse, cuius viri casum gravem ex animo doleo et praecor dominum, ut misericorditer <lb xml:id="p1z16"/>in viam veritatis perducat.</s>
					<s n="8" xml:lang="la" ana="farewell">Bene vale in Christo Iesu cum tuis <lb xml:id="p1z17"/>omnibus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l28">Basileae</placeName> 26. septembris anno 1557.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute"><lb xml:id="p1z18"/>Literas a d. <persName ref="p8011">Gvaltero</persName> ad me datas hodie <persName ref="p8033">Bezae</persName> exhibui; <lb xml:id="p1z19"/>saluta eum meis verbis reverenter.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/>Tuus <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>viro doctissimo, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>pastori vigilantissimo, <lb xml:id="p2z4"/>domino et fratri colendissimo <lb xml:id="p2z5"/>et charissimo <lb xml:id="p2z6"/>suo.</s>
				</p>
			</div>
		</body>
	</text>
