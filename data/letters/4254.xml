	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Exemplaria operis tui sanctissimi contra pernici<lb xml:id="p1z2"/>osam anabaptistarum sectam aediti accepimus, <lb xml:id="p1z3"/>colendissime domine compater, et agimus tibi ingentes <lb xml:id="p1z4"/>gratias <persName ref="p8417">Musculus</persName> et ego.</s>
					<s n="3" xml:lang="la">Scripsisset ipsemet ad te <lb xml:id="p1z5"/>quoque, sed propter occupationes illi hoc nunc non licet; <lb xml:id="p1z6"/>scribet tamen propediem, ut spero, et vicissim tibi <lb xml:id="p1z7"/>Locos suos transmittit.</s>
					<s n="4" xml:lang="la">Nunc vult, ut ego communes <lb xml:id="p1z8"/>tibi utrinque nostrum nomine gratias agam.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Quod <placeName ref="l2451">Abbatiscellensem</placeName> cladem seu calamitatem <lb xml:id="p1z10"/>attinet, indicavi eam nostris, qui plurimum <lb xml:id="p1z11"/>condolent et honorarium quoque, ut existimo, ad illos <lb xml:id="p1z12"/>mittent.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ex <placeName ref="l832">Gallia</placeName> atque <placeName ref="l167">Geneva</placeName> interea, dum <lb xml:id="p1z13"/>priores scripsi (quas te interea accepisse spero), <lb xml:id="p1z14"/>nihil certi accepimus.</s>
					<s n="7" xml:lang="la">Miramur valde, quomodo tumul<lb xml:id="p1z15"/>tus ille habeat et quis exitus sit futurus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Postquam <lb xml:id="p1z16"/>aliquid cognovero, faciam te eius sine mora <lb xml:id="p1z17"/>certiorem.</s>
					<s n="9" xml:lang="la">De <persName ref="p8124">Naogeorgo</persName> nuper scripsi, quibus <lb xml:id="p1z18"/>quod nunc addam, non habeo.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l411">Richenwilensi</placeName> ecclesię <lb xml:id="p1z19"/>condoleo valde.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Dominus eam servet in puritate vera.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z20"/><placeName ref="l18">Augustae</placeName> ubiquitarii mirum in modum tumul<lb xml:id="p1z21"/>tuantur.</s>
					<s n="13" xml:lang="la">Illi, qui prius nobiscum in ministerio <lb xml:id="p1z22"/>illius ecclesiae erant coniuncti, ventres sunt et <lb xml:id="p1z23"/>nebulones; contra testimonium conscientiae suę tacent, <lb xml:id="p1z24"/>dissimulant, imo cum adversariis quoque se coniungunt <lb xml:id="p1z25"/>et veritatem oppugnant.</s>
					<s n="14" xml:lang="la">Illis unus se opponit lu<lb xml:id="p1z26"/>dimagister quidam <persName ref="p2899">Mathias Schenckius</persName> <placeName ref="l257">Constantiensis</placeName>, <lb xml:id="p1z27"/>cuius eruditum contra ubiquitatem scriptum ad nos <lb xml:id="p1z28"/>nuper missum est.</s>
					<s n="15" xml:lang="la">Ego <persName ref="p8417">Musculum</persName> nostrum frequenter <lb xml:id="p1z29"/>urgeo, ut ecclesię et veritati illic laboranti privato <lb xml:id="p1z30"/>et parvo aliquo Germanico scripto succurrat; videtur <lb xml:id="p1z31"/>enim mihi hoc deo, veritati et ecclesiae illi optime <lb xml:id="p1z32"/>de se meritae debere.</s>
					<s n="16" xml:lang="la">Sed ipsum in arenam hanc <lb xml:id="p1z33"/>protrudere non possum.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Velim itaque, ut t[<lb xml:id="p1z34"/>u quoque] ei aurem vellicares, si tibi tale quid co[nduci]<lb xml:id="p1z35"/>bile videretur.</s>
					<s n="18" xml:lang="la">De concilio novo <placeName ref="l306">Mediola[num]</placeName> <lb xml:id="p1z36"/>indicto si quid certi habes, fac, quaeso, cognoscamus; <lb xml:id="p1z37"/>multus enim de eo sermo est inter nostros.</s>
					<s n="19" xml:lang="la" ana="salute"><lb xml:id="p1z38"/>Salutant te nostri omnes, praesertim <persName ref="p8417">Musculus</persName>, <persName ref="p8012">Hallerus</persName> <lb xml:id="p1z39"/>quaestor, <persName ref="p8389">Hagius</persName>, socer et mater mea.</s>
					<s n="20" xml:lang="la" ana="salute">Salutem <lb xml:id="p1z40"/>dic tuis omnibus nostro nomine.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l41">Bernae</placeName> 2. aprilis <lb xml:id="p1z41"/>1560.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z42"/><persName ref="p8018">Hall[erus]</persName> tuus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino et compatri suo <lb xml:id="p2z5"/>observandissimo.</s>
				</p>
