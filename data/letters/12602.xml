	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">De charta, quę primo venit in manus, ne cures, postquam festinandum fuit.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Ex evangelicis<note xml:id="fn1" type="footnote" n="1">Zu verstehen: Ex evangelicis <placeName ref="l862">Helveticorum</placeName>.</note> sunt, qui vires omnes sunt addicturi civitatibus imperii, quicquid <lb xml:id="p1z3"/>dicant <placeName ref="l2448">Quinquepagici</placeName>.</s>
					<s n="4" xml:lang="la">Tu fac idem tuis persuadeas.<pb type="edition" next="363"/></s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z4"/>Exercitus, quicquid <placeName ref="l213">Hessi</placeName> custodierint, <placeName ref="l2459">Rhenum</placeName> transiit apud oppidum <placeName ref="l1788">Bingen</placeName><note xml:id="fn2" type="footnote" n="2">Zur Rheinüberquerung der von <persName ref="p7459">Maximilian von Egmont</persName>, Graf von <placeName ref="l2126">Büren</placeName>, angeführten Truppen s. <ref target="file12595">Nr. 2548</ref>, Anm. 50.</note>.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z5"/>Quid nunc sit facturus, nescio.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="7" xml:lang="la">Per <placeName ref="l2836">Sungoviam</placeName> et <placeName ref="l632">Alsatiam</placeName> tumultuatur, quamobrem, <lb xml:id="p1z6"/>ignoratur.</s>
					<s n="8" xml:lang="la">In primis ad <placeName ref="l1273">Ensheim</placeName> munitiones instituuntur roboribus quercinis<note xml:id="fn3" type="footnote" n="3">Zu den Kriegsvorbereitungen im <placeName ref="l2836">Sundgau</placeName> und im <placeName ref="l632">Elsass</placeName> (u.a. in <placeName ref="l1273">Ensisheim</placeName>) s. schon <persName ref="p8418">Myconius</persName>' Mitteilungen in <ref target="file12587">Nr. 2540</ref>,19-24.</note>.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z7"/><persName ref="p18538">Cęsarem</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p18538">Karl V.</persName> war am 15. August aus <placeName ref="l276">Landshut</placeName> abgereist und lag vom 17. bis 21. August vor <placeName ref="l410">Regensburg</placeName>; s. <ref target="file12588">Nr. 2541</ref>, Anm. 29. Von dort aus zog er nicht in Richtung <placeName ref="l1204">Passau</placeName>, sondern nach <placeName ref="l3115">Neustadt ad. Donau</placeName> und <placeName ref="l231">Ingolstadt</placeName> weiter; s. <ref target="file12598">Nr. 2551</ref>, Anm. 13; <ref target="file12608">Nr. 2561</ref>,6-9.</note> aiunt reliquisse <placeName ref="l276">Landshuͦtum</placeName>, rediisse <placeName ref="l410">Ratisponam</placeName>, nec ibi mansurum, <lb xml:id="p1z8"/>sed <placeName ref="l1204">Patavium</placeName> abiturum.</s>
					<s n="10" xml:lang="la">Mihi videtur in animo habere, ut pios <placeName ref="l822">Germanos</placeName> delasse<lb xml:id="p1z9"/>t ac pecunia evacuet, ut in annum sequentem securius nos adgrediatur.</s>
					<s n="11" xml:lang="la">Dico <lb xml:id="p1z10"/>tibi, vir astu et malicia belligeratur contra dei homines!</s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z11"/>Helvetiorum ex omnibus pagis video esse paratos contra <persName ref="p18538">Carolum</persName> innumeros.</s>
					<s n="13" xml:lang="la">Trans<lb xml:id="p1z12"/>eunt hac <placeName ref="l587">Tigurini</placeName>, <placeName ref="l41">Bernenses</placeName>, <placeName ref="l49">Bielenses</placeName>, <placeName ref="l98">Curienses</placeName>, <placeName ref="l300">Lucernani</placeName>, <placeName ref="l801">Tugini</placeName> vehementer <lb xml:id="p1z13"/>alacres<note xml:id="fn5" type="footnote" n="5">Zu den <placeName ref="l862">eidgenössischen</placeName> Söldnern s. <ref target="file12595">Nr. 2548</ref>, Anm. 40; <hi><persName ref="p1278">Gast</persName>, Tagebuch</hi> 288f (unter dem 26. August); <bibl source="b480">PC</bibl> IV/1 351, Nr. 333.</note>.</s>
					<s n="14" xml:lang="la">Hic mihi dolet, quod multi coguntur redire domum, quia pecunia <lb xml:id="p1z14"/>deest.</s>
					<s n="15" xml:lang="la">Et putant exteri, quod propriis sumptibus deberemus mittere exercitum <lb xml:id="p1z15"/>iustum, ignorantes morem nostrum<note xml:id="fn6" type="footnote" n="6">Gemeint ist das Reislaufen.</note>, ad quem sumus adsueti, dum procul abimus, <lb xml:id="p1z16"/>iam longo tempore.</s>
					<s n="16" xml:lang="la">Nescio, quid inde possit tandem fieri.</s>
				</p>
			</div>
			<div xml:id="div7" corresp="regest7">
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z17"/>Hunc tibi commendo, qui literas fert, ut doctum<note xml:id="fn7" type="footnote" n="7"><persName ref="p8032">Francisco de Enzinas</persName>; s. <ref target="file12601">Nr. 2554</ref>.</note> valde.</s>
					<s n="18" xml:lang="la" ana="farewell">Vale cum tuis.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z18"/><placeName ref="l28">Basileę</placeName>, 27. augusti anno 1546.</s>
				</p>
			</div>
			<div xml:id="div8" corresp="regest8">
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z19"/><persName ref="p8418">Os. Myconius</persName> <lb xml:id="p1z20"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>in domino suo.</s>
					<s n="22" xml:lang="de"><placeName ref="l587">Z[urich]</placeName><note xml:id="fna" type="footnote" n="a"><hi>Textverlust durch Entfernung des Siegels.</hi></note>.</s>
				</p>
			</div>
		</body>
	</text>
