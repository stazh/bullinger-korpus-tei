	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Tu vero et prudenter facis, mi <persName ref="p495">Bullingere</persName>, et mini<lb xml:id="p1z2"/>me arrogantem te esse ostendis, dum tantis viris, <lb xml:id="p1z3"/>quid faciendum sit, non vis praescribere; ea enim est <lb xml:id="p1z4"/>natura tua, ut non superbe te de sentias, qui morbis in <lb xml:id="p1z5"/>theologo quam sit periculosus, non ignoras.</s>
					<s n="3" xml:lang="la">Quare non <lb xml:id="p1z6"/>solum propter eruditionem singularem, sed eti<lb xml:id="p1z7"/>am propter virtutes insignes merito te amamus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Ego etiam pro tua in me benevolentia gratias <lb xml:id="p1z9"/>tibi ago immortales, quod me passus es a te <lb xml:id="p1z10"/>impetrare, quod volui, meamque tibi fidem, operam, <lb xml:id="p1z11"/>curam, diligentiam ita tibi vicissim pol<lb xml:id="p1z12"/>liceor, ut nunquam mea tibi defutura sit voluntas.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z13"/>Verum, mi <persName ref="p495">Bullingere</persName>, tantum abest, ut tuas <lb xml:id="p1z14"/>tibi remittere voluerim, ut curaverim statim <lb xml:id="p1z15"/>eas una cum senatus collegiique nostri <placeName ref="l41">Ber<lb xml:id="p1z16"/>nam</placeName> mitti.</s>
					<s n="6" xml:lang="la">Placet <placeName ref="l830">Anglia</placeName>, quo facile me<lb xml:id="p1z17"/>rcatorum auxilio sine periculo pervenitur, haud adeo <lb xml:id="p1z18"/>magnis etiam sumptibus; sed dominorum nostrorum <lb xml:id="p1z19"/>permittemus hoc arbitrio.</s>
					<s n="7" xml:lang="la">Quibus consulendum <lb xml:id="p1z20"/>non fuisset, nisi discors illa concordia <lb xml:id="p1z21"/>multa non solum <placeName ref="l862">Helvetiis</placeName>, sed toti pene <lb xml:id="p1z22"/><placeName ref="l822">Germanię</placeName> mala attulisset.</s>
					<s n="8" xml:lang="la">Oeconomus noster <lb xml:id="p1z23"/><placeName ref="l269">Kunigsfeldensis</placeName> mihi retulit se a [te] cognovisse multos <lb xml:id="p1z24"/>esse cum episcopos ac abbates tum alios, <lb xml:id="p1z25"/>qui religionis veram doctrinam nunc recipiant.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z26"/>Quorum nomina quaeso <persName>Platnero</persName> nostro indica, <lb xml:id="p1z27"/>ut ea ad me perscribat; vix enim aliquid longo <lb xml:id="p1z28"/>tempore audivi, quod maiori me voluptate <lb xml:id="p1z29"/>affecerit.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Christus regnabit et <lb xml:id="p1z30"/>tum, ut alicubi cecini, bestia foeda cadet.</s>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z31"/>Vale.</s>
					<s n="12" xml:lang="la">Raptim <placeName ref="l69">Brugis</placeName> 4. calendas martii <lb xml:id="p1z32"/>1550.</s>
					<s n="13" xml:lang="la" ana="salute">Salutat te totamque tuam familiam mea, quae <lb xml:id="p1z33"/>nunquam nisi honorificentissime/am(?) tui mentionem facit.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Salvum te cupiunt, quos salutasti.</s>
					<s n="15" xml:lang="la"><persName ref="p8450">Toxites</persName> t[uus].</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo atque humanissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrico Bullingero</persName>, ecclesi<lb xml:id="p2z3"/>astę <placeName ref="l587">Tigurino</placeName>, domino suo o<lb xml:id="p2z4"/>bservando.</s>
				</p>
			</div>
		</body>
	</text>
