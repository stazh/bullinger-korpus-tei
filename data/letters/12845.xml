	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Si scivissem de adventu domini <persName ref="p540">Calvini</persName>, venissem ad vos cum <persName ref="p2336">Bernardino</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p2336">Bernardino Ochino</persName>, der von <placeName ref="l473">St. Gallen</placeName> nach <placeName ref="l587">Zürich</placeName> gegangen war, wo er am 2. Februar 1547 ankam und zufälligerweise auch <persName ref="p540">Calvin</persName> begegnete; siehe dazu <ref target="file12838">Nr. 2789</ref>, <ptr target="qvfn17056-1" type="qv"/>.</note>, <lb xml:id="p1z2"/>quia eum mirifice videre cupio.</s>
					<s n="3" xml:lang="la" ana="salute">Salutabis eum meis verbis accuratissime, ad quem sine <lb xml:id="p1z3"/>mora venirem, si permitteret <persName ref="p6355">Sailerus</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p6355">Hieronymus Sailer</persName>.</note>.</s>
					<s n="4" xml:lang="la">Sed cogor hic manere, donec peperit <persName ref="p7004">uxor</persName><note xml:id="fn7" type="footnote" ana="bio" n="7"><persName ref="p6355">Sailers</persName> Ehefrau <persName ref="p7004">Felicitas, geb. Welser</persName> (eine Tochter von <persName ref="p7003">Bartholomäus Welser</persName>).</note>.</s>
					<s n="5" xml:lang="la">Etsi enim <lb xml:id="p1z4"/>peramica est inter nos communicatio et suavitate ac benevolentia uxoris, foeminae prudentissimae, <lb xml:id="p1z5"/>tractatus sum aliquanto deliciosius<note xml:id="fna" type="footnote" n="a"><hi>In der Vorlage</hi> deliciosius.</note>, quam homini studioso conveniret, tamen hoc mihi iniurato <lb xml:id="p1z6"/>crede, <persName ref="p495">Bullingere</persName> doctissime, multo me libentius apud vos aut in nostris sedibus <placeName ref="l28">Basileae</placeName> versari.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="6" xml:lang="la" ana="salute"><lb xml:id="p1z7"/>Salutat te <persName ref="p6355">Sailerus</persName> cum uxore et gratiam habet pro eo, quod scripsisti de causa <persName ref="p8011">Gvalteri</persName><note xml:id="fn8" type="footnote" n="8">Streit um <persName ref="p8011">Gwalthers</persName> Antichrist.</note>.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/>Ego ecclesiae vestrae gratulor tranquillitatem, quam spero fore durabilem, siquidem hoc negotium <lb xml:id="p1z9"/>est compositum de sententia vestra.</s>
					<s n="8" xml:lang="la">Nescio quid nunciatur de perturbatione <placeName ref="l291">Lydaviensi</placeName>; dicitur <lb xml:id="p1z10"/>captus urbis praefectus, sed nihildum certi constat.</s>
					<s n="9" xml:lang="la">Scribam, quid sit, ubi aliquid veri accepero.</s>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z11"/>Interim bene vale cum omnibus fratribus.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="11" xml:lang="la"><placeName ref="l473">Sangalli</placeName>, 6. die februarii 1547.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z12"/>Tuus <persName ref="p8032">Franciscus Dryander</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Mitto duas epistolas domini <persName ref="p6355">Saileri</persName> <lb xml:id="p1z13"/>ad duos <placeName ref="l587">Tigurinos</placeName><note xml:id="fn9" type="footnote" n="9">Unbekannt.</note>; quaeso, ne sit grave <lb xml:id="p1z14"/>eas per famulum mittere.</s>
					<s n="14" xml:lang="la">Si quid hic a nobis <lb xml:id="p1z15"/>curatum velis, erimus omnes paratissimi.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z4"/>vigilantissimo.</s>
				</p>
			</div>
		</body>
	</text>
