			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Nunc ac<lb xml:id="p1z4"/>cipio <lb xml:id="p1z5"/>s<lb xml:id="p1z6"/>ub <lb xml:id="p1z7"/>vesper<lb xml:id="p1z8"/>am li<lb xml:id="p1z9"/>tera<lb xml:id="p1z10"/>s <persName>Pesc<lb xml:id="p1z11"/>lavio</persName> a <lb xml:id="p1z12"/>d. <persName>Iu<lb xml:id="p1z13"/>lio</persName>, in <lb xml:id="p1z14"/>qui<lb xml:id="p1z15"/>bus <lb xml:id="p1z16"/>inte<lb xml:id="p1z17"/>r alia, quo<lb xml:id="p1z18"/>d s[an<lb xml:id="p1z19"/>cti] <lb xml:id="p1z21"/>p<lb xml:id="p1z22"/>a<lb xml:id="p1z23"/>tr<lb xml:id="p1z24"/>es <lb xml:id="p1z25"/><placeName ref="l1107">Tridenti</placeName> detinentur nec aliud nunc agunt, quam quod <lb xml:id="p1z26"/>aliquando in conventibus disputent de tremendo illo missae sacrificio habit<lb xml:id="p1z27"/>urosque sessionem de hoc negotio in feriis nativitatis domini.</s>
					<s n="3" xml:lang="la">Qua absoluta <lb xml:id="p1z28"/>sit dimittendum concilium ex praecepto d. papae, ubi anathemate ferient om<lb xml:id="p1z29"/>nes vocatos ad concilium, qui non comparuerunt.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Haec verba posui ex <persName>Iulii</persName> <lb xml:id="p1z30"/>epistola.</s>
					<s n="5" xml:lang="la">Plura ille non.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z31"/>28. octobris <lb xml:id="p1z32"/>1562.</s>
					<note type="signature">[Ohne Unterschrift.]</note>
				</p>
