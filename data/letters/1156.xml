	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Precor tibi et tuis felicem et faustum <lb xml:id="p1z2"/>annum et incrementum fidei christianę.</s>
					<s n="3" xml:lang="la">Amen.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z3"/>Accepit uxor mea munus ab uxore tua missum; si ita <lb xml:id="p1z4"/>in rependendis officiis pergere constituisti, dives ero <lb xml:id="p1z5"/>et insignis mercator, cui fortuna ingentes dabit brevi <lb xml:id="p1z6"/>divitias; sed desinam te deinceps gravare, ne plus oneris <lb xml:id="p1z7"/>adferam quam emolumenti conferam.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Curavi literas, et reliquas etiam curabo diligentissimo <lb xml:id="p1z9"/>nacto fideli tabellario, cui literę tuto dandae sint.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>A domino <persName ref="p2916">Schertlino</persName> accipies nova et de statu illius <lb xml:id="p1z11"/>exacte omnia.</s>
					<s n="7" xml:lang="la">Admones illum diligenter; nam dedit mihi <lb xml:id="p1z12"/>literas legendas, quo regem suum admoneat de variis rebus, <lb xml:id="p1z13"/>quę nunc temporis aguntur per monarchas.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Dedi praeterea literas tuas d. <persName ref="p8418">Myconio</persName>, qui graviter <lb xml:id="p1z15"/>decumbit nec potuit eas legere, neque volui aperire.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>Dominus illi assistat sua cum gratia.</s>
					<s n="10" xml:lang="la">Mirum illo aegrotante omnia, <lb xml:id="p1z17"/>quę nostram ecclesiam adficiunt, cumulatissime nos obruere.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z18"/>Sed de his suo tempore.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z19"/>Aiunt maritimas civitates habere in armis 24000 <lb xml:id="p1z20"/>pedites et 4000 equites, bellica instrumenta multa.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/>Dominus fortes illis det manus, corda fortiora et domini spiritum <lb xml:id="p1z22"/>principalem, quo omnibus hostibus Christi resistant, etsi terrore maximo <lb xml:id="p1z23"/>concutior, quomodo<note type="margin">a.R.: quoniam?</note></s>
					<s n="14" xml:lang="la">Christus suum evangelium nolit per arma plantare, <lb xml:id="p1z24"/>sed per sanguinem, attamen spero dominum tandem respecturum ad <lb xml:id="p1z25"/>suum populum miserrime adflictum et a bestia Romana oppressum.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell"><lb xml:id="p1z26"/>Vale.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l28">Basileae</placeName> 17. ianuarii 1551.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">T[uus] <persName ref="p1278">G[astius</persName>].</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, pastori <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z4"/>vigilantissimo, <lb xml:id="p2z5"/>praeceptori suo perpetuo <lb xml:id="p2z6"/>colendo.</s>
				</p>
				<p>
					<s n="19" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>