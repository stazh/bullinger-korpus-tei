	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Nach <persName ref="p1365" cert="high">Grynäus</persName>' Rückkehr vom <placeName ref="l569" cert="high">Wormser</placeName> Kolloquium.</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p495">Bullingero</persName> suo.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">S. <lb xml:id="p1z2"/>Cum subito comitia propter inexpectatum cęsaris <lb xml:id="p1z3"/>mandatum solverentur,<note xml:id="fn2" type="footnote" n="2">Kaiser <persName ref="p18538">Karl V.</persName> hatte am 15. Januar die Beendigung des <placeName ref="l569">Wormser</placeName> Kolloquiums angeordnet; s. <bibl source="b62">ADRG</bibl> II/1 208-2 10, Nr. 112 (vgl. den Abschied vom 18. Januar, <bibl source="b62">ADRG</bibl> II/1 210f, Nr. 113; <bibl source="b441">MO</bibl> IV 79).</note> scribere ad vos fratres, qualiter <lb xml:id="p1z4"/>voluerunt, non potuerunt.</s>
					<s n="3" xml:lang="la"><persName ref="p2095">Philippus</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p2095">Philipp Melanchthon</persName>.</note> ipse mihi pro<lb xml:id="p1z5"/>misit ad te se scripturum<note xml:id="fna" type="footnote" n="a"><hi>In er Vorlage</hi> scriptum.</note> diligenter esse<note xml:id="fn4" type="footnote" n="4">Ein entsprechender Brief ist nicht nachweisbar.</note>.</s>
					<s n="4" xml:lang="la">Cęterorum <lb xml:id="p1z6"/>unusquisque scribere paratus fuerat.</s>
					<s n="5" xml:lang="la">Itaque oro <lb xml:id="p1z7"/>te, ut, quod non multorum literas adfero ad vos, <lb xml:id="p1z8"/>velitis imputare necessitati.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><placeName ref="l491">Argentina</placeName> tota vos pie colit et diligit.</s>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z9"/>Vale in domino.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><persName ref="p1365">S. Grynęus</persName> tuus.</s>
					<s n="9" xml:lang="la">2. februarii.</s>
				</p>
			</div>
		</body>
	</text>
