	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi literas tuas, vir praestantissime, et ago <lb xml:id="p1z2"/>gratias tuae humanitati et diligentiae in scribendo.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Nihil nunc habeo, quae adiiciam superioribus <lb xml:id="p1z4"/>et iis maxime, quae scripsi per <persName>Lumagam</persName> mercator<lb xml:id="p1z5"/>em.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Anxius fui propter filium meum, quod a<lb xml:id="p1z7"/>udis<lb xml:id="p1z8"/>sem ipsum aegrotare.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Nunc, cum intelligo cum <lb xml:id="p1z9"/>a te tum aliunde ipsum rectius valere, deo gratias <lb xml:id="p1z10"/>ago.</s>
					<s n="6" xml:lang="la">Misi... <lb xml:id="p1z11"/>pecunias mense septembri.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Nollem illi dare <lb xml:id="p1z12"/>nisi in neces<lb xml:id="p1z13"/>sitate, ne quid prodigat, neque ita <lb xml:id="p1z14"/>sum instructus facultatibus, ut tantum possim <lb xml:id="p1z16"/>dare, quantum aliquando absumit iuvenum talium s<lb xml:id="p1z17"/>tultitia et immoderatus nec necessarius usus; <lb xml:id="p1z18"/>non curant isti, unde accipiatur pecunia, tantum <lb xml:id="p1z19"/>accipere gestiunt.</s>
					<s n="8" xml:lang="la">Si quid amicus ille tuus dedit <lb xml:id="p1z20"/>ei, recipiet cum gratiarum actione, teque <lb xml:id="p1z21"/>oro, ut hos duos aureos illi restituas et gratias <lb xml:id="p1z22"/>ei agas meo nomine; accipies autem propediem <lb xml:id="p1z23"/>a me duos illos aureos.</s>
					<s n="9" xml:lang="la">Hisce diebus dedi <lb xml:id="p1z24"/>cuidam <placeName ref="l18">Augustano</placeName> coronatum, <placeName ref="l473">Sangallensi</placeName> duos <lb xml:id="p1z25"/>coronatos atque aliis et aliis alia, quae omnia <lb xml:id="p1z26"/>ille accepit mutuo.</s>
					<s n="10" xml:lang="la">Tribuo hoc eius aegritu<lb xml:id="p1z27"/>dini, quamquam intelligam eam non admodum <lb xml:id="p1z28"/>fuisse diuturnam.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Nihilominus, <lb xml:id="p1z29"/>prout intellex<lb xml:id="p1z30"/>eris necessitatem postulare, sufficito; bona fide <lb xml:id="p1z31"/>reddetur.</s>
					<s n="12" xml:lang="la">Quae ad necessitatem non pertinuerint, nullus <lb xml:id="p1z32"/>ei dato; volo enim, ut laboret et labore manuu<lb xml:id="p1z33"/>m vivat.</s>
					<s n="13" xml:lang="la">Dominus benedicat ei.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Oro te, <lb xml:id="p1z34"/>ut <lb xml:id="p1z35"/>has literas cures ei tradi <lb xml:id="p1z36"/>mature.</s>
					<s n="15" xml:lang="la">Recte hic <lb xml:id="p1z37"/>per dei gratiam valemus et bene habemus, nisi quod <lb xml:id="p1z38"/>frumenti precium subinde augetur.</s>
					<s n="16" xml:lang="la">Dominus deus noster <lb xml:id="p1z39"/>misereatur nostri et luxum et ebrietatem nostram <lb xml:id="p1z40"/>incurabilem non puniat inopia rerum omnium!</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z42"/>Salutant te nostri.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">Salutabis tuum parentem et soc<lb xml:id="p1z43"/>erum, mihi semper colendissimos patronos, <persName>Ioannem</persName> <lb xml:id="p1z44"/>nostrum, totam domum tuam et symmystas nostros, ministrum Christi et<lb xml:id="p1z45"/>c.</s>
					<s n="19" xml:lang="la">Festinantissime scripsi.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Octobris 13.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z46"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z47"/>Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clariss<lb xml:id="p2z2"/>imo viro d. <persName ref="p8432">Frideryc<lb xml:id="p2z3"/>ho a Salice</persName>, comitatus <placeName ref="l93">Clavenensis</placeName> comis<lb xml:id="p2z4"/>sario dignissimo, domino e<lb xml:id="p2z6"/>t a<lb xml:id="p2z7"/>mico colendo <lb xml:id="p2z8"/>et sem<lb xml:id="p2z9"/>per amando.</s>
					<s n="24" xml:lang="la"><lb xml:id="p2z10"/><placeName ref="l93">Clä<lb xml:id="p2z11"/>ven</placeName>.</s>
				</p>
			</div>
		</body>
