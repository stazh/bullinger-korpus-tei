	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Literae tuae et d. <persName ref="p8033">Bezae</persName> magna voluptate me <lb xml:id="p1z3"/>affecerunt, ut quibus spes mihi facta sit occasionem datam <lb xml:id="p1z4"/>ad aperiendum ostium regno Christi.</s>
					<s n="3" xml:lang="la">Quid nostri rescribant senatui <lb xml:id="p1z5"/>vestro, nescio, atque utinam non velimus nimis sapere ea <lb xml:id="p1z6"/>in re, in qua opera fidelis casse esse nulla potest.</s>
					<s n="4" xml:lang="la">De libris <lb xml:id="p1z7"/>ab <placeName ref="l834">Italo</placeName> scriptis prodigiosa quaedam de miraculis Christi continentibus nihil prorsus mihi <lb xml:id="p1z8"/>constat, sed neque de eo, quem De amplitudine gratiae dei inscriptum <lb xml:id="p1z9"/>ferunt, nisi forte is intelligatur, qui a <persName ref="p714">Coelio nostro Secundo</persName> <lb xml:id="p1z10"/>ęditus est non apud nos, sed alibi neque apud nos, quod <lb xml:id="p1z11"/>sciam, venalis prostat.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Monuimus pridem typographos, ne <lb xml:id="p1z12"/>quid ędant non adprobatum a censoribus, et sicut scribis, male <lb xml:id="p1z13"/>vereor, ne, si quid aliunde senatus accipiat sinistri ex officinis <lb xml:id="p1z14"/>nostris prodiisse, in praeiudicium cedat, quo etiam aliis iisque <lb xml:id="p1z15"/>optimis lucubrationibus excudendis praecidatur facultas.</s>
					<s n="6" xml:lang="la">De <lb xml:id="p1z16"/>pia <persName>Christophori</persName> principis et aliorum erga nostras ecclesias <lb xml:id="p1z17"/>benevolentia laeta significas; quem precor Christus dominus adaugeat <lb xml:id="p1z18"/>et donet pacem in ipso.</s>
					<s n="7" xml:lang="la">De uxoris tuae fratre egi diligenter; <lb xml:id="p1z19"/>sed nihildum solidae spei adparet, et cogit viam <lb xml:id="p1z20"/>tentare etiam alibi, quantum possum, optimo viro non defuturus.</s>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z21"/>Bene vale in Christo Iesu cum tuis omnibus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l28">Basileae</placeName> <lb xml:id="p1z23"/>24. maii anno 15<lb xml:id="p1z24"/>57.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Tuus <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, domino et fratri <lb xml:id="p2z3"/>colendissimo suo.</s>
				</p>
			</div>
		</body>
