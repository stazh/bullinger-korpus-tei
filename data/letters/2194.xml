	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Cuperem gratificari tibi libellorum de mensibus; sed quia <lb xml:id="p1z2"/>nuper non solum nullas apud <persName ref="p8126">Oporinum</persName> reperiebam, sed neque hic etiam <lb xml:id="p1z3"/>extare affirmaret, factum est, ut schaedam paule negligentius <lb xml:id="p1z4"/>sepositam amiserim, eam inquam, quae nomenclaturam eorum autorum continebat.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Quare velim, denuo eadem significes, ut apud reliquos <lb xml:id="p1z6"/>bibliopolas inquiram vel, si nequeant reperiri, ex <placeName ref="l157">Francofurto</placeName> curem <lb xml:id="p1z7"/>comparari.</s>
					<s n="4" xml:lang="la">Novi nihil nunc habeo, nisi quod bellum grave aiunt <lb xml:id="p1z8"/>imminere <placeName ref="l822">Germaniae</placeName> <persName ref="p2916">Schertliumque</persName> constitutum capitaneum super 24 <lb xml:id="p1z9"/>vexilla <placeName ref="l822">Germanorum</placeName> idque confoederatorum nomine.</s>
					<s n="5" xml:lang="la">Conflare et <lb xml:id="p1z10"/>Caesar nititur 100 vexilla, ut manu, quam possit maxima denuo <placeName ref="l2589">Picardiam</placeName> <lb xml:id="p1z11"/>invadat; verum haberi tantas copias vix posse prudentiores <lb xml:id="p1z12"/>censent.</s>
					<s n="6" xml:lang="la">Male autem vereor, ne nova expeditione iterum miles noster <lb xml:id="p1z13"/>evocetur et frequentiore militandi consuetudine disciplina perquam <lb xml:id="p1z14"/>infirma penitus cadat reatusque sanguinis in capita nostra incumbat.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>D. <persName ref="p8359">Philippi Gallicii</persName> filium, quacunque potero occasione, iuvare non negligam <lb xml:id="p1z16"/>quum propter parentis pietatem tum iuvenis indolem, quae in illo singularis <lb xml:id="p1z17"/>nobis elucere videtur.</s>
					<s n="8" xml:lang="la">Sed opereprecium erit, ut rectorem atque ordinum <lb xml:id="p1z18"/>quatuor decanos pater etiam ipse interpellet, ut inter competitores, quales <lb xml:id="p1z19"/>ad vacantia stipendia plures esse solent, ipsius habeatur ratio.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>Scribam ea de re ad ipsum proximo nuncio.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l28">Basileae</placeName> 22. februarii <lb xml:id="p1z21"/>anno 54.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/>T[uus] <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>domino et symmistae <lb xml:id="p2z4"/>observandissimo suo.</s>
				</p>
			</div>
		</body>
	</text>
