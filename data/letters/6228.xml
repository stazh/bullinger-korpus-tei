	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi heri ad te.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Interea vester ille cursor citato <lb xml:id="p1z2"/>cursu venit; nam 9a augusti <placeName ref="l587">Tiguro</placeName> discedens 10a eius<lb xml:id="p1z3"/>dem mensis circa coenam hic fuit.</s>
					<s n="4" xml:lang="la">Audimus tumultuari ad<lb xml:id="p1z4"/>huc <placeName ref="l2450">Svitenses</placeName>; oramus autem dominum, ut eas compescat.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Redibit h<lb xml:id="p1z5"/>ic ad vos quoque festinanter; ideo plura non possum nec etiam multa <lb xml:id="p1z6"/>habeo, nisi quod <persName ref="p8033">Beza</persName> ad te scribit de foedere illo <placeName ref="l832">Gallico</placeName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z7"/>Scis, quantopere illud urgeat et quibus conditionibus; interea <lb xml:id="p1z8"/>ostendit regem non velle separatos nos habere articulos a reli<lb xml:id="p1z9"/>quis <placeName ref="l862">Helvetiis</placeName>; posse quidem nos privatim aliquas conditio<lb xml:id="p1z10"/>nes praeservare, praesertim ut salvum maneat edictum ipsius <lb xml:id="p1z11"/>de libertate doctrinae evangelicae.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ego vero metuo, ne fiat <lb xml:id="p1z12"/>nobis quod <placeName ref="l1202">Schmalkaldicis</placeName>, ut, dum res sacras politicis istis <lb xml:id="p1z13"/>foederibus coniungere volumus, amittamus et puritatem doctrinę <lb xml:id="p1z14"/>et libertatis quoque magnam partem.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Veniet hodie <placeName ref="l922">Friburgum</placeName> <lb xml:id="p1z15"/>mareschallus quidam <placeName ref="l832">Galliae</placeName> huius rei gratia, cum illi cum <lb xml:id="p1z16"/>magno apparatu obviam procedent.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Veniet idem propediem <lb xml:id="p1z17"/>ad nos; nam et hic multus pro illo fit apparatus.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Metuo itaque, ne peregrini illi volucres a synceritate et <lb xml:id="p1z19"/>simplicitate doctrinae et disciplinę nostrae tandem nos a<lb xml:id="p1z20"/>bducant.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Cupio interea piis in <placeName ref="l832">Gallia</placeName> optime consultum; sed <lb xml:id="p1z21"/>dum in homines nimis speramus et carnis auxilia quaerimus, amittimus <lb xml:id="p1z22"/>auxilium divinum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Scio nostros hac de re tecum agere; sed tu pulc<lb xml:id="p1z23"/>hre dissimulas.</s>
					<s n="13" xml:lang="la">Oro ergo, ut mihi tuum iudicium significes; <lb xml:id="p1z24"/>opus enim nos, si ullibi, praesertim in hac re coniunctos esse, praesertim <lb xml:id="p1z25"/>cum <persName ref="p8033">Beza</persName> tantopere utrisque instet.</s>
					<s n="14" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Saluta <lb xml:id="p1z26"/>uxorem, liberos, generos, amicos.</s>
					<s n="16" xml:lang="la"><placeName ref="l41">Bernae</placeName> 11. augusti, <lb xml:id="p1z27"/>hora 12. meridiana.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z28"/><persName ref="p8018">Hallerus</persName> tuus semper.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori <lb xml:id="p2z4"/>fidelissimo, domino <lb xml:id="p2z5"/>meo et compatr<lb xml:id="p2z6"/>i summe semper <lb xml:id="p2z7"/>observando.</s>
				</p>
				<p>
					<s n="19" xml:lang="de"><lb xml:id="p2z8"/>M. <persName ref="p495">Heinrych Bul<lb xml:id="p2z9"/>lingern</persName> zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
