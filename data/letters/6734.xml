	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Haec ad te scribo, ut me salvum in <placeName ref="l862">Helvetiam</placeName> et <lb xml:id="p1z2"/>tui amantem rediisse scias.</s>
					<s n="3" xml:lang="la">In <placeName ref="l832">Gallia</placeName> satis pacata <lb xml:id="p1z3"/>omnia fore videbantur compositis primarum familiarum <lb xml:id="p1z4"/>dissidiis; an vero bona fide in gratiam redierint, docebit <lb xml:id="p1z5"/>exitus.</s>
					<s n="4" xml:lang="la">Sed e dignitate reque publica factum omnes arbitramur; <lb xml:id="p1z6"/>vix enim dici potest, quantum utrinque gladiatorum numerum <lb xml:id="p1z7"/>ea dissidia alerent, qui et ipsi, quoad eius fieri poterat, ea <lb xml:id="p1z8"/>dissidia alebant.</s>
					<s n="5" xml:lang="la">Quoniam in <placeName ref="l834">Italia</placeName> bellum a <placeName ref="l2510">Turca</placeName> metuitur, <lb xml:id="p1z9"/>non pauci se illo bono publico conferunt; eo fit, ut <placeName ref="l167">Genevates</placeName> <lb xml:id="p1z10"/>aliquo in metu versentur, tum qui <persName>Namurtius</persName>, <placeName ref="l2478">Sabaudi</placeName> <lb xml:id="p1z11"/>patruellis, <placeName ref="l2575">Anysii</placeName>, vicino <placeName ref="l167">Genevae</placeName> oppido, cum <persName>Guysiana</persName> <lb xml:id="p1z12"/>magno comitatu expectatur, illudque sibi suspectum allegabant, <lb xml:id="p1z13"/>quod in <placeName ref="l832">Gallia</placeName> tam multi milites exautorarentur.</s>
					<s n="6" xml:lang="la">Sed cum <lb xml:id="p1z14"/>exautorationis causam docuissem, graves scilicet et necessarias, <lb xml:id="p1z15"/>nonnihil eos commovisse metumque aliqua ex parte abstersisse <lb xml:id="p1z16"/>mihi visus sum.</s>
					<s n="7" xml:lang="la">Hi certe urbis suae incolumitati diligenter prospiciunt.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Tu, si quid de foedere <placeName ref="l306">Mediolanensi</placeName> pontificiove certius acceperis, <lb xml:id="p1z18"/>rogo, uti me facias certiorem.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="10" xml:lang="la">Dominus te et eruditissimum <lb xml:id="p1z19"/><persName ref="p8011">Gvalterum</persName> quam diutissime incolumes conservet.</s>
					<s n="11" xml:lang="la" ana="farewell">Valete.</s>
					<s n="12" xml:lang="la"><placeName ref="l760">Soloduri</placeName> <lb xml:id="p1z20"/>21. martii 1566.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/>Tuss ex animo <persName ref="p8160">P. <lb xml:id="p1z22"/>Bellieure</persName>.</s>
				</p>
				<p>
