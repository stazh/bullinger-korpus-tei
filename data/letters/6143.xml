	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non potui summo sine animi dolore alteram literarum <lb xml:id="p1z2"/>tuarum partem legere, vir humanissime.</s>
					<s n="3" xml:lang="la">Facile <lb xml:id="p1z3"/>enim video te, qui ecclesiae Christi summa fide <lb xml:id="p1z4"/>semper addictus fuisti, longo iam tempore ab impuris <lb xml:id="p1z5"/>hominibus nullo tuo merito divexari.</s>
					<s n="4" xml:lang="la">At <lb xml:id="p1z6"/>in tanta evangelii luce tam absurda dogmat<lb xml:id="p1z7"/>a iamdudum a christianis per verbum <lb xml:id="p1z8"/>divinum explosa hoc tempore adeo pertinaciter <lb xml:id="p1z9"/>revocari posse non existimabam.</s>
					<s n="5" xml:lang="la">Sed quid <lb xml:id="p1z10"/>non Sathan quotidie adversus fidos Christi <lb xml:id="p1z11"/>servos male molitur et struit?</s>
					<s n="6" xml:lang="la">Verum <lb xml:id="p1z12"/>non est, opinor, pius et doctus ullus, qui te <lb xml:id="p1z13"/>non plus satis ad singulos <persName ref="p458">Brentii</persName> errores <lb xml:id="p1z14"/>respondisse et, si quid eius generis est, refutasse <lb xml:id="p1z15"/>(nihil dico de convitiis, quibus pro tua pietate nihil <lb xml:id="p1z16"/>respondere vis) ex verbo dei affirmet.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/>Quid igitur opus erat novo scripto inveteratam <lb xml:id="p1z18"/>stultitiam denuo prodere?</s>
					<s n="8" xml:lang="la">Enimvero <lb xml:id="p1z19"/>quid agas, mi pater?</s>
					<s n="9" xml:lang="la">Nisi alios vidisses ventos, <lb xml:id="p1z20"/>nisi alias prospexisses animo procellas, magis haec <lb xml:id="p1z21"/>te moverent quam, ut opinor, moveant.</s>
					<s n="10" xml:lang="la">Dolet <lb xml:id="p1z22"/>tamen mihi ex animo reverendam tuam senectutem, <lb xml:id="p1z23"/>quę multo maioribus rebus erat dedita, his <lb xml:id="p1z24"/>pertractandis occupari.</s>
					<s n="11" xml:lang="la">Deum vero praepotentem <lb xml:id="p1z25"/>oramus, ut tibi eam animi constantiam, qua ad hanc <lb xml:id="p1z26"/>usque aetatem gloriose fretus es, perpetuo suppeditet, <lb xml:id="p1z27"/>ut, malis quemadmodum semper restitisti, ita ad <lb xml:id="p1z28"/>extremum victoriae christianę decus et triumphum <lb xml:id="p1z29"/>pervenire possis, sicut futurum nemo bonus diffidit.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z30"/>Quod mihi adolescentes hos tres, quos misistis <lb xml:id="p1z31"/>ad nos, tam studiose commendas, facis id, mi <lb xml:id="p1z32"/>pater, pro tua in eos et me simul humanitate.</s>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ego itaque, qui <placeName ref="l587">Tigurinam</placeName> ecclesiam semper tanti <lb xml:id="p2z2"/>feci, quanti apud me esse debuit, nihil negligam, <lb xml:id="p2z3"/>quod ad hos adolescentes spectare videbitur.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z4"/>Vestrum erit, viri ornatissimi, meam tenuitatem <lb xml:id="p2z5"/>boni consulere.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z6"/>De comitiis <placeName ref="l41">Bernatum</placeName> <lb xml:id="p2z7"/>cum legatis <placeName ref="l2478">Sabaudi</placeName> quia certi nihil quicquam <lb xml:id="p2z8"/>habeo, nihil scribo; sed tu ex aliis, ut spero, au<lb xml:id="p2z9"/>dies certa et quidem singula.</s>
					<s n="16" xml:lang="la">In <placeName ref="l832">Gallia</placeName>, <lb xml:id="p2z10"/>ut scribit d. <persName ref="p8033">Beza</persName>, res sunt paulo quam antea <lb xml:id="p2z11"/>perturbatiores, dum utraque pars suspicionibus <lb xml:id="p2z12"/>indulget.</s>
					<s n="17" xml:lang="la">Regis adventus expectatur in dies <lb xml:id="p2z13"/><placeName ref="l301">Lugduni</placeName>; utinam sit ecclesiae fructuosus!</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z14"/>Sed deus suos respiciet et spem etiam nostram <lb xml:id="p2z15"/>superabit.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Fidelis ille dei servus <lb xml:id="p2z16"/>d. <persName ref="p540">Calvinus</persName>, singulare olim in vita, nunc vero <lb xml:id="p2z17"/>in morte virtutum egregiarum exemplum, vergit <lb xml:id="p2z18"/>quotidie ad interitum, quamvis in dei potestate <lb xml:id="p2z19"/>sit eum restituere.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Delatus est his diebus, <lb xml:id="p2z20"/>ut audimus, in senatum, ubi insignem ad senator<lb xml:id="p2z21"/>es et civeis orationem habuit simulque eis va<lb xml:id="p2z22"/>ledixit.</s>
					<s n="21" xml:lang="la">Ista sunt meo quidem iudicio <lb xml:id="p2z23"/>irae in nos divinae vestigia non obscura, quod <lb xml:id="p2z24"/>tam exiguo temporis spatio tot egregia organa <lb xml:id="p2z25"/>nobis sublata sint.</s>
					<s n="22" xml:lang="la" ana="farewell">Tu itaque, mi pater, <lb xml:id="p2z26"/>in quo ecclesiae syncerioris spes maxima reposita <lb xml:id="p2z27"/>est, vive et vale feliciter.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Dominus te diu <lb xml:id="p2z28"/>nobis incolumem conservet!</s>
					<s n="24" xml:lang="la">Gaudeo vos <lb xml:id="p2z29"/>a lue illa contagiosa egregie vacuos.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Deus det <lb xml:id="p2z30"/>vobis et nobis pacem suam!</s>
				</p>
				<p>
					<s n="26" xml:lang="la" ana="farewell">Vale, mi pater.</s>
				</p>
				<p>
					<s n="27" xml:lang="la" ana="salute"><lb xml:id="p2z31"/>Saluta generos omnes tuos et amicos verbis meis.</s>
					<s n="28" xml:lang="la"><lb xml:id="p2z32"/><placeName ref="l280">Lausannae</placeName> 22. maii 1564.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><lb xml:id="p2z33"/>Tuus ex animo <lb xml:id="p2z34"/><persName ref="p2041">Blasius Marcuardus</persName>.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><pb/><lb xml:id="p4z1"/>Virtute et pietate <lb xml:id="p4z2"/>ornatissimo viro d. <persName ref="p495">Huldricho <lb xml:id="p4z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p4z4"/>ecclesiae pastori fidelissimo, <lb xml:id="p4z5"/>domino et patri meo <lb xml:id="p4z6"/>venerando.</s>
					<s n="31" xml:lang="la"><lb xml:id="p4z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>