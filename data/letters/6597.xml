	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ne nunc quidem committere volui, ut literas d. <persName ref="p3740">a Stetten</persName> <lb xml:id="p1z2"/>sine meis ad te mitterem atque hoc minus, quod <lb xml:id="p1z3"/>tuas nuper accepi amoris et officii plenas illas quidem, sed <lb xml:id="p1z4"/>quae epistolae longioris argumentum et occasionem mihi non suppe<lb xml:id="p1z5"/>ditarent; tantum enim scribis meas tibi esse redditas ro<lb xml:id="p1z6"/>gasque, ut <persName ref="p6850">Treschium</persName> salutem atque d. <persName>Hugonem</persName>, cuius alie<lb xml:id="p1z7"/>natum abs te animum esse non falso suspicaris.</s>
					<s n="3" xml:lang="la">Cum enim <lb xml:id="p1z8"/>familiarissime plurimumque utatur iis, qui nos extinctos et <lb xml:id="p1z9"/>sublatos cupiunt, non est difficile coniicere, qua sit in nos volu<lb xml:id="p1z10"/>ntate, praesertim cum scribenti tibi respondeat nihil.</s>
					<s n="4" xml:lang="la">Habet <lb xml:id="p1z11"/>aedes meis contiguas; sed vix semel et iterum eas sum in<lb xml:id="p1z12"/>gressus annis 12 totis.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Ne tamen nimium tribuam suspicionibus, <lb xml:id="p1z13"/>quae nos non raro egregie fallunt, operam dabo, <lb xml:id="p1z14"/>ut aliunde eius mentem erga te explorem, atque ad te <lb xml:id="p1z15"/>perscribam.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Treschius hoc ipso die hinc abit suos <lb xml:id="p1z16"/>salutaturus, nescio ubi, teque in reditu conventurus; <lb xml:id="p1z17"/>quem cave sine literis dimittere.</s>
					<s n="7" xml:lang="la" ana="salute">Salutem ille ascribere <lb xml:id="p1z18"/>tibi iussit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Bene vale et d. <persName ref="p8011">Gvalthero</persName>, <persName ref="p3988">Wolfio</persName> et <lb xml:id="p1z19"/>inprimis generis tuis suavissimis meis verbis S.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l18">Augustae</placeName> anno <lb xml:id="p1z20"/>1565 die decembris 10.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/><persName ref="p2899">Matthias Schenckius</persName>, tuus <lb xml:id="p1z22"/>ut suus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullinger</persName>o, domino <lb xml:id="p2z3"/>atque amico observando.</s>
					<s n="12" xml:lang="de"><lb xml:id="p2z4"/>An meister <persName ref="p495">Heinrich <lb xml:id="p2z5"/>Bullinger</persName> zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
