			<zone xml:id="p2z38-0" points="515,2504 557,2514 627,2474 709,2486 761,2459 835,2454 950,2491 957,2389 803,2429 731,2407 622,2437 520,2419">531,2477 557,2477 584,2475 610,2472 637,2469 663,2467 690,2465 716,2463 743,2461 769,2459 796,2458 822,2456 849,2454 875,2452 902,2451 928,2450 955,2450</zone>
			<zone xml:id="p2z39-0" points="664,2625 679,2625 689,2618 691,2621 701,2611 723,2608 738,2596 756,2598 756,2489 733,2489 714,2501 704,2501 676,2484 664,2484">677,2584 705,2588 733,2588 761,2584</zone>
