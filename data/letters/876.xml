	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Anno 1550 adi<note xml:id="fn1" type="footnote" n="1">anno domini?</note> 5 aprilis ex <placeName ref="l157">Franckfordia</placeName>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>S. Tuas literas accepi, clarissime d. <persName ref="p495">Bullingere</persName>.</s>
					<s n="3" xml:lang="la">Quonam se contulit <persName>Florianus</persName>, nescio.</s>
					<s n="4" xml:lang="la">D. <lb xml:id="p1z3"/><persName ref="p8041">Ioannis a Lasco</persName> agit <placeName ref="l61">Bremae</placeName>, nondum fuit in <placeName ref="l2472">Polonia</placeName>, quemadmodum mihi retulit civis <lb xml:id="p1z4"/><placeName ref="l61">Bremensis</placeName> mihi notus; si quid ad illum scribere velis, curabo diligenter.</s>
					<s n="5" xml:lang="la">Verum est <persName>Florianum</persName> <lb xml:id="p1z5"/>emisse libros a me, quos <placeName ref="l15">Antverpiae</placeName> reliquit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Literas non remitto, servabo; forte venturus <lb xml:id="p1z6"/>est vel tandem indicabit, quonam se contulerit.</s>
					<s n="7" xml:lang="la">Ago ingentes gratias pro libris ad me <lb xml:id="p1z7"/>missis; communicabo amico, qui has ad te mittit; oro, ut illi sententiam et animum tuum indices, <lb xml:id="p1z8"/>ut tandem a scrupulo liberetur.</s>
					<s n="8" xml:lang="la">Ego ipse tuum librum offeram seniori archiepiscopo et fratri <lb xml:id="p1z9"/>mihi omnibus modis colendissimo/is; uterque adhuc recte valet.</s>
					<s n="9" xml:lang="la">Cęsario quoque offeram tua.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z10"/>Miror d. <persName ref="p8121">Montium</persName> nihil ad te misisse; volo illum in meis literis admonere.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z11"/>Dissidium inter <persName>Gallum</persName> et <persName>Anglum</persName> aiunt dissolutum; procedit nihilominus negotium religionis.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z12"/><persName>Caesar</persName> parat profectionem in <placeName ref="l822">Germaniam</placeName> satis instructus copiis bellicis.</s>
					<s n="13" xml:lang="la">Hactenus <lb xml:id="p1z13"/>involutus variis negotiis integrum non fuit copiosiores literas mittere; si occurrit <lb xml:id="p1z14"/>quispiam alius, diligentius scribam.</s>
					<s n="14" xml:lang="la">D. <persName ref="p1283">Gesnero</persName> offeres omne[m] meam diligentiam; misi <lb xml:id="p1z15"/>literas ad doctores nostros; mittam quamprimum <placeName ref="l267">Colonia</placeName> responsum.</s>
					<s n="15" xml:lang="la">Interim cum omnibus <lb xml:id="p1z16"/>tuis valeas et pro tuo me utere.</s>
					<s n="16" xml:lang="la">Raptim.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z17"/>Tuus obsequentissimus <persName ref="p380">Ioannes Byrchmannus</persName> scripsit.</s>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, domino et amico <lb xml:id="p2z3"/>colendo.</s>
					<s n="19" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
