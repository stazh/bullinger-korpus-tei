					<lb xml:id="p2z2"/>Curioni bonarum
					<lb xml:id="p2z3"/>literarum in schola Basilensis
					<lb xml:id="p2z4"/>fidelissimo et doctissimo pro
					<lb xml:id="p2z5"/>festori, domino meo colendio.
					<lb xml:id="p2z6"/>et amico sigulari.
