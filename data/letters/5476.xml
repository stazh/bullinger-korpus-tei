	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Multo sane longoque tempore nullas ad te
					<lb xml:id="p1z2"/>Coeli doctissime literas dedi. Scio autem hoc te
					<lb xml:id="p1z3"/>aequo ferre animo, qui nihil sane dubites de per
					<lb xml:id="p1z4"/>severantia mei erga te studii persuasumque habeas
					<lb xml:id="p1z5"/>tibi tuisque libenter inserviturum, siquidem ferats
					<lb xml:id="p1z6"/>opportunitas et mea quoque facultas. Caeterum Ioanne
					<lb xml:id="p1z7"/>Iacobus hic Brenvaldus iuvenis studiosus et e
					<lb xml:id="p1z8"/>ecclesiae nostrae alimnus occasionem mihi dedit
					<lb xml:id="p1z9"/>brevissimas hasce scribendi ad te et commendandi
					<lb xml:id="p1z10"/>ipsum tibi, ut fideliter doceas et sicubi videa
					<lb xml:id="p1z11"/>ipsum indigere monitore moveas, denique in officiu
					<lb xml:id="p1z12"/>retineas. Tigurinus est et honestis natus parentibus
					<lb xml:id="p1z13"/>iuvenis modestus et non indoctus, cui tua
					<lb xml:id="p1z14"/>institutio plurimum prodesse poterit. De rebus
					<lb xml:id="p1z15"/>ut vocant novis nihil humanitati scribo, quod
					<lb xml:id="p1z16"/>tanta sit mentiendi licentia et tam varia cir
					<lb xml:id="p1z17"/>cumferantur, ut vir prudens, quid credat, nesciat
					<lb xml:id="p1z18"/>Video tamen Galliam maximi implicita esse
					<lb xml:id="p1z19"/>periculo et manu domini extentam esse su
					<lb xml:id="p1z20"/>Dominus ergo orandus, ut Galliae misereatur
					<lb xml:id="p1z21"/>et vos a malo protegat. Quod enim Galliae
					<lb xml:id="p1z22"/>usu venit et nobis evenire poterit.Val
					<lb xml:id="p1z23"/>colende. Dominus benedicat tibi et familia
					<lb xml:id="p1z24"/>tuae. Tiguri 29. septembris 1562. Salute
					<lb xml:id="p1z25"/>humanissime d. d. Gratorolum et alios viros
					<lb xml:id="p1z26"/>bonos.
					<lb xml:id="p1z27"/>Bullingerus tuus.
