	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ex literis affinis mei <persName ref="p4554">Collini</persName>, reverende <lb xml:id="p1z2"/>in Christo pater, intellexi te non adeo <lb xml:id="p1z3"/>recte habere ideoque rerum <placeName ref="l832">Galliarum</placeName>, <lb xml:id="p1z4"/>quibus tamen abundares, nihil plane <lb xml:id="p1z5"/>scripsisse.</s>
					<s n="3" xml:lang="la">Sed idem ille addidit in <lb xml:id="p1z6"/>bona spe esse tuam valetudinem; rogo <lb xml:id="p1z7"/>ergo dominum, ut te ecclesiae quam primum <lb xml:id="p1z8"/>restituat.</s>
					<s n="4" xml:lang="la">Ego nihil habeo, quod <lb xml:id="p1z9"/>te scire magnopere referat, scribo <lb xml:id="p1z10"/>tamen, ut morem meum per<lb xml:id="p1z11"/>sequar meamque erga te voluntatem <lb xml:id="p1z12"/>et observantiam testificer.</s>
					<s n="5" xml:lang="la">Nisi <lb xml:id="p1z13"/>forte hoc scire velis, quod quidam, <lb xml:id="p1z14"/>qui recta <placeName ref="l157">Francfurto</placeName> veniebat, <lb xml:id="p1z15"/>hic affirmavit episcopum <lb xml:id="p1z16"/><placeName ref="l267">Coloniensem</placeName> diem suum obiisse eiusque <lb xml:id="p1z17"/>mortem actionem nonnihil impedivisse.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p8282">Maximilianum</persName> filium cum parente <lb xml:id="p1z19"/>Caesare papistica sacra frequentare <lb xml:id="p1z20"/>et quidem magnam devotionem <lb xml:id="p1z21"/>prae se ferre.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z22"/>Qui nuper <placeName>Ilantio</placeName> e<lb xml:id="p1z23"/>x mercatu ad nos veniebant, <lb xml:id="p1z24"/>dicebant Uranienses (nam inter se <lb xml:id="p1z25"/>mutuo propter vicinitatem is<lb xml:id="p1z26"/>ti homines non pauca commertia <pb/><lb xml:id="p2z1"/>habent) in maximo luctu esse, quod illuc <lb xml:id="p2z2"/><persName>Guisianorum</persName> clades esset nunciata.</s>
					<s n="8" xml:lang="la">Sed in<lb xml:id="p2z3"/>terim audio plures illorum et ex capitaneis <lb xml:id="p2z4"/>duos peste interiisse, non paucos in ex<lb xml:id="p2z5"/>pugnatione Rotomagi periisse, et <lb xml:id="p2z6"/>haec puto verior luctus causa, quam quod <lb xml:id="p2z7"/><persName>Guisius</persName> esset caesus.</s>
					<s n="9" xml:lang="la">Tu, quaeso, <lb xml:id="p2z8"/>reverende pater, si quid habes, sicuti t<lb xml:id="p2z9"/>e habere audio, da negotium exscribendi <lb xml:id="p2z10"/><persName>Collinis</persName> et nobis imperti.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale cum tuis omnib<lb xml:id="p2z11"/>us quam felicissime et diutissime.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l98">Curiae</placeName> 7. decembris anno 1562.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">T[uus] <persName ref="p8009">Fab[ricius</persName>].</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Amplissimo viro d. <persName ref="p495">Heinr<lb xml:id="p2z12"/>ycho Bullingero</persName>, domino suo et in Christo patri semper h<lb xml:id="p2z13"/>onorando.</s>
				</p>
			</div>
		</body>
	</text>
