	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi his diebus ad d. <persName ref="p8011">Gwaltherum</persName> per illius filium, <lb xml:id="p1z2"/>quae habebam; ea scio ipsum tecum habere communia.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Interea nihil aliud cognovi, quod sit alicuius momenti; <lb xml:id="p1z4"/>accepi vero ea, quę tu per fratrem meum mihi communi<lb xml:id="p1z5"/>cari voluisti.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Pro iis habeo tibi gratias, tum etiam pro ho<lb xml:id="p1z6"/>meliis tuis de conversione eunuchi Candaces<note xml:id="fn1" type="footnote" n="1"><bibl source="b286">HBBibl</bibl> I 561.</note> ad me <lb xml:id="p1z7"/>missis, elegans certe, pius et utilis labor.</s>
					<s n="5" xml:lang="la">Si quando <lb xml:id="p1z8"/>per occasionem recompensare possum et hęc et omnia, <lb xml:id="p1z9"/>quę mihi praestas, faciam libenter et diligenter.</s>
					<s n="6" xml:lang="la">F<lb xml:id="p1z10"/>estinant iuvenes hi, ut plura nunc non possim.</s>
					<s n="7" xml:lang="la" ana="salute">Alter <lb xml:id="p1z11"/>eorum hic apud d. <persName ref="p8417">Musculum</persName> aliquamdiu vixit, <placeName ref="l808">Belga</placeName> <lb xml:id="p1z12"/>est honestus, doctus et pius valde; proficiscitur <placeName ref="l157">Fran<lb xml:id="p1z13"/>cufurtum</placeName> et cupit occasione harum literarum te prius vider<lb xml:id="p1z14"/>e et salutare.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="9" xml:lang="la" ana="salute">Salutant te nostri omnes.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/><placeName ref="l41">Bernae</placeName> 22. februarii 1570.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p8018">Iohannes Hallerus</persName> senior, <lb xml:id="p1z17"/>tuus semper.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino <lb xml:id="p2z4"/>meo honorando et compatri <lb xml:id="p2z5"/>charissimo.</s>
				</p>
			</div>
		</body>
