	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z3"/>S. D.</s>
					<s n="2" xml:lang="la">Maximas tuae humanitati gratias ago, <lb xml:id="p1z4"/>colendissime mi domine et frater charissime, pro fideli <lb xml:id="p1z5"/>et copiosa rerum <placeName ref="l832">Gallicarum</placeName> expositione.</s>
					<s n="3" xml:lang="la">Utar <lb xml:id="p1z6"/>illa ad iuvandam veritatem.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Pueros quantum <lb xml:id="p1z7"/>attinet, curabimus, ut sint in disciplina et in <lb xml:id="p1z8"/>omnibus accurata ipsorum habeatur ratio.</s>
					<s n="5" xml:lang="la">Vicissim <lb xml:id="p1z9"/>autem commendamus vobis nostros illos pueros, qui <lb xml:id="p1z10"/>nunc ad vos veniunt, <persName ref="p1541">Ioannis Herteri</persName> imprimis <lb xml:id="p1z11"/>fratrem.</s>
					<s n="6" xml:lang="la"><persName ref="p1541">Herterus</persName> hic vicarius est in ludo nostro <lb xml:id="p1z12"/>literario domini <persName ref="p1214">Frisii</persName> et affinitate mihi iunctus, <lb xml:id="p1z13"/>vir certe pius et diligens.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Voluit etiam videre <lb xml:id="p1z14"/><placeName ref="l167">Genevensem</placeName> scholam ac ecclesiam; hunc ergo co<lb xml:id="p1z15"/>mmendo tibi.</s>
					<s n="8" xml:lang="la">Postulaverat rex sibi mitti 1000 <lb xml:id="p1z16"/>Helvetios, qui essent in turbis illis custodes cor<lb xml:id="p1z17"/>poris regii.</s>
					<s n="9" xml:lang="la">Nunc vero legatus d. <persName ref="p629">Coignetius</persName> non <lb xml:id="p1z18"/>admodum urget, neque <persName ref="p8354">Frölichius</persName> militem cogit.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/>Aiunt turbas in <placeName ref="l832">Gallia</placeName> deferbuisse et expectari <lb xml:id="p1z20"/><placeName ref="l378">Lutetiae</placeName> regem <placeName>Navarrae</placeName> sperarique pacem, et <lb xml:id="p1z21"/>quod omnia feliciter sint componenda.</s>
					<s n="11" xml:lang="la">Utinam vero <lb xml:id="p1z22"/>componantur omnia ad voluntatem dei, non secundum ar<lb xml:id="p1z23"/>bitrium et technas corruptorum hominum.</s>
					<s n="12" xml:lang="la">Hic <lb xml:id="p1z24"/>dubii sumus, pacem habeamus an bellum.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Finita sunt <lb xml:id="p1z25"/>comitia <placeName>Eremitana</placeName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Nihil effectum est.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Quinque<lb xml:id="p1z26"/>pagici postulant, ut <placeName ref="l646">Claronenses</placeName> evangelici deserta<note type="misc">deserto</note> <lb xml:id="p1z27"/>nova (ut aiunt) fide cocedant ad veterem.</s>
					<s n="16" xml:lang="la">Si hoc <lb xml:id="p1z28"/>non faciant, subdubitare, quid domini et communitates <lb xml:id="p1z29"/>(ut vocant ipsorum) tentaturi sint.</s>
					<s n="17" xml:lang="la">Caeteri <lb xml:id="p1z30"/>ut <placeName ref="l587">Tigurini</placeName>, <placeName ref="l41">Bernates</placeName>, <placeName ref="l28">Basilienses</placeName>, <placeName ref="l160">Friburgenses</placeName>, <placeName ref="l760">Salodurii</placeName>, <lb xml:id="p1z31"/><placeName ref="l441">Schaffhusiani</placeName>, <placeName ref="l17">Apptcellani</placeName>, <placeName ref="l648">Rheti</placeName> serio <placeName ref="l2448">5 Pagis</placeName> in<lb xml:id="p1z32"/>iunxerunt, iure, non vi aut armis agant et d<lb xml:id="p1z33"/>issidia sua caussamque suam disceptent.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Quid futurum sit, novit <lb xml:id="p1z34"/>dominus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Ferociunt enim isti ac mirabiliter et incre<lb xml:id="p1z35"/>dibiliter insolescunt.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Dominus aut convertat eos aut co<lb xml:id="p1z36"/>herceat!</s>
					<s n="21" xml:lang="la">Operatur in eis inspiratio pontificis, cuius legatum <lb xml:id="p1z37"/>fovent.</s>
					<s n="22" xml:lang="la">Quęso, diligenter expedias, quod in <lb xml:id="p1z38"/>charta consignatum vides, et respondeas mihi.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="farewell">Vive et <lb xml:id="p1z39"/>vale.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Ora pro nobis dominum.</s>
				</p>
				<p>
					<s n="25" xml:lang="la" ana="salute">Omnes nostri te et tuos salutant.</s>
					<s n="26" xml:lang="la"><lb xml:id="p1z40"/>10. octobris 1560.</s>
				</p>
				<p>
					<s n="27" xml:lang="la" ana="salute">Salvus sit <persName ref="p8033">Beza</persName> noster.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p1z41"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p540">Ioanni <lb xml:id="p2z2"/>Calvino</persName>, fideli <placeName ref="l167">Genevensis</placeName> <lb xml:id="p2z3"/>ecclesiae pastori, domino <lb xml:id="p2z4"/>suo colendo et fratri <lb xml:id="p2z5"/>charissimo.</s>
					<s n="30" xml:lang="de"><placeName ref="l167">Genff</placeName>.</s>
				</p>
			</div>
