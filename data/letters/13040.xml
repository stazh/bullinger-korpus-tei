	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Studerus noster, arbitror, tuae Humanitati quae dedi <lb xml:id="p1z2"/>reddidit; quae ubi legeris aut ex parte describenda curaris, <lb xml:id="p1z3"/>valde oro, primo quoque tempore et quam poteris ocissi<lb xml:id="p1z4"/>me remittere velis.</s>
					<s n="3" xml:lang="la">Si ad manum non est tabellio, fac aliquo <lb xml:id="p1z5"/>ex tuis ad me misso negotium expedias; nam is, qui sancte omnia m<lb xml:id="p1z6"/>ihi concredidit, flagitare sua abs me non desistit.</s>
					<s n="4" xml:lang="la">Proinde fac <lb xml:id="p1z7"/>meae fidei consulas, quo et ipse in posterum aliorum fide nostris <lb xml:id="p1z8"/>in rebus uti frui possim.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="5" xml:lang="la" ana="farewell">Vale.</s>
					<s n="6" xml:lang="la"><placeName ref="l473">Sangalli</placeName>, XIIII. die <lb xml:id="p1z9"/>Augusti, anno MDXLVII.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><persName ref="p8049">Ioachimus Vadianus</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrycho Bullingero</persName>, <lb xml:id="p2z2"/>colendissimo domino <lb xml:id="p2z3"/>et amico.</s>
					<s n="9" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
