	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Remissurus eram tibi, quę nuper mis<lb xml:id="p1z2"/>isti; sed <lb xml:id="p1z3"/>adeo festinat d. <persName ref="p1754">Iungius</persName>, ut mihi ea colligere <lb xml:id="p1z4"/>non licuit; inducias ergo peto in aliud tempus.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Gratias vero tibi habeo maximas, quod communicaveris nobis <lb xml:id="p1z6"/>ista omnia, quę a vobis scripta sunt.</s>
					<s n="4" xml:lang="la">Dabo operam, <lb xml:id="p1z7"/>quoniam id intelligo vobis gratum esse, ut <placeName ref="l339">Neocomenses</placeName> <lb xml:id="p1z8"/>quoque confessioni nostrae subscribant.</s>
					<s n="5" xml:lang="la">Nova, quae <lb xml:id="p1z9"/>misisti, in senatu lecta sunt; sed ea nondum recepi.</s>
					<s n="6" xml:lang="la" ana="salute"><lb xml:id="p1z10"/>Exemplaria inter primores distribui, qui omnes <lb xml:id="p1z11"/>bene contenti sunt et tibi summas agunt gratias ac <lb xml:id="p1z12"/>te salutant, praesertim consul <persName ref="p2305">Negelinus</persName>, <persName ref="p8063">Steigerus</persName>, <persName ref="p3494">Diesbachius</persName>, <lb xml:id="p1z13"/><persName ref="p3659">Mülinensis</persName>, <persName ref="p7511">Graffenriet</persName> et alii.</s>
					<s n="7" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="8" xml:lang="la">Proxime <lb xml:id="p1z14"/>copiosius scribam; vix haec inter prandendum annotavi.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>Qui cum d. <persName>Iunio</persName> venit, <placeName ref="l339">Neocomensis</placeName> est et <lb xml:id="p1z16"/>una cum <persName ref="p3429">Vireto</persName> <placeName ref="l301">Lugduno</placeName>, ubi aliquando <lb xml:id="p1z17"/>ministrum egit, pulsus est; ingenuus est homo, qui <lb xml:id="p1z18"/>hic aliquando literis operam dedit.</s>
					<s n="10" xml:lang="la">Is tibi plura <lb xml:id="p1z19"/>de rebus <placeName ref="l832">Gallicis</placeName> narrabit.</s>
					<s n="11" xml:lang="la">Puer, quem <lb xml:id="p1z20"/>secum deducunt, filius est d. d. <persName>Saraceni</persName>, medici <lb xml:id="p1z21"/><placeName ref="l167">Genevensis</placeName>.</s>
					<s n="12" xml:lang="la">Exponent ipsi tibi supplicium <lb xml:id="p1z22"/>sumptum his diebus <placeName ref="l167">Genevę</placeName> a <persName>Spitamęo</persName>, qui <lb xml:id="p1z23"/>aliquando episcopus fuit <placeName ref="l1860">Nivernensis</placeName>; causas etiam ab <lb xml:id="p1z24"/>ipsis cognosces.</s>
					<s n="13" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="14" xml:lang="la" ana="salute">Salutem dic omnibus <lb xml:id="p1z25"/>tuis meo nomine.</s>
					<s n="15" xml:lang="la"><placeName ref="l41">Bernę</placeName> 30. martii 1566.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><persName ref="p8018">I<lb xml:id="p1z26"/>[ohannes] Hall[erus</persName>] tuu<pb/><lb xml:id="p2z1"/>s.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino meo honorando et <lb xml:id="p2z5"/>compatri charissimo.</s>
					<s n="18" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
