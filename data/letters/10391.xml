	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">De duobus istis, quae scribis<note xml:id="fn1" type="footnote" n="1">Oben Nrn. 350 und 356.</note>, libenter cognovi.</s>
					<s n="3" xml:lang="la">Sed bone deus, quam <lb xml:id="p1z3"/>miseria!</s>
					<s n="4" xml:lang="la">Non est amplius, quod dicam.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">De bello futuro sic res habet: <persName ref="p3590">Princeps <lb xml:id="p1z4"/>Hessorum</persName><note xml:id="fna" type="footnote" n="a"><hi>Von</hi> Princeps <placeName ref="l213">Hessorum</placeName> <hi>bis</hi> silentium esse <hi>(Z. 27) von <persName ref="p495">Bullinger</persName> leicht gekürzt am 24. April an <persName ref="p8049">Vadian</persName> (<ref target="file10396">Nr. 364</ref>) mitgeteilt. Abweichungen sind nachfolgend unter der <bibl source="b591">Sigel</bibl> BV verzeichnet.</hi></note><note xml:id="fn2" type="footnote" n="2"><persName ref="p3590">Philipp von Hessen</persName>.</note> ante pentecosten<note xml:id="fn3" type="footnote" n="3">24. Mai 1534.</note> erit in ducatu <placeName ref="l572">Wirtenbergensi</placeName> cum exercitu, <lb xml:id="p1z5"/>imperator huius exercitus dux est <placeName ref="l1041">Brunsvigensis</placeName><note xml:id="fn4" type="footnote" n="4">Offenbar handelt es sich um eine Fehlinformation: Im von <persName ref="p3590">Philipp von Hessen</persName> geführten Kriegszug wird als Feldherr keiner der Herzoge von <placeName ref="l1041">Braunschweig</placeName> (<persName ref="p19855">Philipp I. zu Grubenhagen</persName>, <persName ref="p20612">Erich I. zu Calenberg</persName>, <persName ref="p20318">Heinrich IX. d. J. zu Wolfenbüttel</persName>, <persName ref="p18566">Otto I. d.Ä. von Lüneburg</persName> in <placeName ref="l3139">Harburg</placeName>, <persName ref="p20464">Franz von Lüneburg</persName> in <placeName ref="l1739">Gifhorn</placeName> oder <persName ref="p17897">Ernst III. d. Bekenner</persName> von <placeName ref="l1750">Lüneburg</placeName> in <placeName ref="l1740">Celle</placeName>) erwähnt, s. <bibl source="b690">Wille</bibl> 170f. Zum Durchsickern von Nachrichten über die Kriegsvorbereitungen <persName ref="p3590">Philipps von Hessen</persName> und über die Gegenmaßnahmen <persName ref="p18477">Ferdinands</persName> s. <bibl source="b690">Wille</bibl> 154. 172f.</note>, praeter hunc sunt duces comites <lb xml:id="p1z6"/>et nobiles, viri profecto magni.</s>
					<s n="6" xml:lang="la">Causa<note xml:id="fn5" type="footnote" n="5">Die Wiedereinsetzung des durch <placeName ref="l850">Österreich</placeName> vertriebenen Herzogs <persName ref="p9708">Ulrich von Württemberg</persName>, s. <bibl source="b690">Wille</bibl> und <hi>Keller.</hi></note> per se favorem habet omnium.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z7"/>Pecuniae magnus numerus est, miles multus, machinae bellicae multae, <lb xml:id="p1z8"/>adparatus totus, qualem esse decet.</s>
					<s n="8" xml:lang="la"><persName ref="p20225">Rex</persName><note xml:id="fn6" type="footnote" n="6">König <persName ref="p20225">Franz I.</persName> von <placeName ref="l832">Frankreich</placeName>.</note> et, ut quidam aiunt, <persName ref="p7636">Lotharingus</persName><note xml:id="fn7" type="footnote" ana="bio" n="7"><persName ref="p7636">Claude de Lorraine</persName>, erster Herzog von <placeName ref="l3258">Guise</placeName>, 1496-1550, ein Truppenführer, Vater von <persName ref="p20858">François de Lorraine</persName>, Herzog von Guise, der Kardinäle <persName ref="p7287">Charles</persName> und <persName ref="p7289">Louis de Lorraine</persName> und Großvater von <persName ref="p18212">Maria Stuart</persName>, s. <bibl source="b480">PC</bibl> II 208 (vgl. S. IX); Grande Encyclopédie 22, Paris 1885, S. 567.</note> <lb xml:id="p1z9"/>exercitum habent coniunctim latitantem fere et per hoc munitantem, si pri<lb xml:id="p1z10"/>mi domus <placeName ref="l850">Austriae</placeName>, hoc est<note xml:id="fnb" type="footnote" n="b">hoc est <hi>fehlt in BV.</hi></note> <placeName ref="l2836">Sungaudienses</placeName>, <placeName ref="l632">Alsatici</placeName>, <placeName ref="l64">Brisacenses</placeName><note xml:id="fnc" type="footnote" n="c"><hi>BV fügt ein:</hi> etc.</note><note xml:id="fn8" type="footnote" n="8"><placeName ref="l2836">Sundgauer</placeName> (Süd-<placeName ref="l632">Elsaß</placeName>), <placeName ref="l632">Elsässer</placeName> und <placeName ref="l64">Breisacher</placeName> (<placeName ref="l572">Baden-Württemberg</placeName>).</note> ad de<lb xml:id="p1z11"/>fendendum <placeName ref="l572">Wirtenbergam</placeName> proripere se pararent.</s>
					<s n="9" xml:lang="la"><persName ref="p18604">Dux Bavariae</persName><note xml:id="fn9" type="footnote" n="9">Herzog <persName ref="p18604">Wilhelm IV.</persName> von <placeName ref="l619">Bayern</placeName>.</note> triplici e<lb xml:id="p1z12"/>xercitu cavebit, ne ex <placeName ref="l850">Austria</placeName> seu <persName ref="p18477">Boemia</persName> quis obsit.</s>
					<s n="10" xml:lang="la">Is duces quinque<note xml:id="fn10" type="footnote" n="10">Gemeint sind vielleicht dem Wahlbund (vom 24. Oktober 1531 zu <placeName ref="l1137">Saalfeld</placeName> von <placeName ref="l619">Bayern</placeName>, <placeName ref="l213">Hessen</placeName> und <placeName ref="l749">Kursachsen</placeName> gegen die Anerkennung der Wahl <persName ref="p18477">Ferdinands I</persName>. als römischer König) nahestehende Fürsten wie <persName ref="p19855">Philipp I. von Braunschweig-Grubenhagen</persName>, <persName ref="p20464">Franz von Braunschweig-Lüneburg</persName> in <placeName ref="l1739">Gifhorn</placeName>, <persName ref="p7100">Wolfgang von Anhalt-Köthen</persName>, <persName ref="p7653">Gebhart VII</persName>. und <persName ref="p7652">Albrecht VII. von Mansfeld</persName>, s. <bibl source="b342">Keller</bibl> 8-11. 45. Näheres ist nicht bekannt.</note> <lb xml:id="p1z13"/>dicitur ingenti pecunia ab imperatore <placeName ref="l875">Hispano</placeName><pb type="edition" next="133"/> abstraxisse<note xml:id="fn11" type="footnote" n="11">Näheres ist nicht bekannt.</note>.</s>
					<s n="11" xml:lang="la">Hostis<note xml:id="fnd" type="footnote" n="d"><hi>Der Abschnitt</hi> Hostis <hi>bis</hi> paupertate <hi>ist in BV übersprungen.</hi></note> autem <lb xml:id="p1z14"/>paratum quidem nunc demum novit, sed quo tendat, iamdum haesitat.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z15"/>Duces habet dictis, ut quidam aiunt, exercitatiores<note xml:id="fn12" type="footnote" n="12">Auf Habsburgs Seite führten <persName ref="p18785">Pfalzgraf Philipp</persName>, von <placeName ref="l2831">Pfalz-Neuburg</placeName>, seit 1532 Statthalter in <placeName ref="l572">Württemberg</placeName> <hi>(Wille</hi> 171f; <bibl source="b342">Keller</bibl> 65f) und nach seiner schweren Verwundung <persName ref="p6660">Dietrich Spät</persName> <hi>(Keller</hi> 67) den Oberbefehl.</note> verum carent, m<lb xml:id="p1z16"/>ilite, quod <persName ref="p18477">Ferdinandus</persName> summa laboret paupertate<note xml:id="fne" type="footnote" n="e"><hi>Der Abschnitt</hi> Hostis <hi>bis</hi> paupertate <hi>ist in BV übersprungen.</hi></note><note xml:id="fn13" type="footnote" n="13">Der geldbedingte Truppenmangel auf habsburgischer Seite wird auch sonst bestätigt, s. <bibl source="b690">Wille</bibl> 172. 174f und <bibl source="b342">Keller</bibl> 65. 68.</note>.</s>
					<s n="13" xml:lang="la">Rumor est item <lb xml:id="p1z17"/>Widam <persName ref="p7234">Hungarum</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p7234">Johannes Zápolya (Szapolyai János)</persName>, Wojwode (ungarisch: Wajda) von <placeName ref="l869">Siebenbürgen</placeName> und König von <placeName ref="l882">Ungarn</placeName>.</note> illum regnum occupasse poenitus <persName ref="p18477">Ferdinando</persName> occluso<note xml:id="fnf" type="footnote" n="f">Ferdinando occluso <hi>in BV ausgelassen.</hi></note><note xml:id="fn15" type="footnote" n="15">Ähnliches berichtet <persName ref="p5565">Capito</persName>, s. oben S. 116, 20.</note>.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z18"/>Motus est <placeName ref="l213">Hessus</placeName>, quod minis plus quam horrendis a <persName ref="p18477">Ferdinando</persName> exagitatur, <lb xml:id="p1z19"/>et nisi ad hunc modum rem adgrederetur, actum esset de principatu <lb xml:id="p1z20"/>suo, de iusticia evangelii, actum esset<note xml:id="fng" type="footnote" n="g"><hi>BV setzt</hi> et <hi>für</hi> actum esset.</note> de omnibus, qui<note xml:id="fnh" type="footnote" n="h"><hi>BV:</hi> qui dependent a principe.</note> hactenus a <lb xml:id="p1z21"/>principe<note xml:id="fn16" type="footnote" n="16">Wohl Herzog <persName ref="p9708">Ulrich von Württemberg</persName>.</note> dependerunt<note xml:id="fni" type="footnote" n="i"><hi>BV:</hi> qui dependent a principe.</note>, tantaeque<note xml:id="fnk" type="footnote" n="k"><hi>Der Abschnitt</hi> tantaque <hi>bis</hi> conspectae <hi>ist in BV übersprungen.</hi></note> turbae per <placeName ref="l822">Germaniam</placeName> essent futurae - <lb xml:id="p1z22"/>ita <persName ref="p18477">Ferdinandus</persName> impellitur cum per se tum per pfaffos -, quantae vix <lb xml:id="p1z23"/>unquam sunt conspectae<note xml:id="fnl" type="footnote" n="l"><hi>Der Abschnitt</hi> tantaque <hi>bis</hi> conspectae <hi>ist in BV übersprungen.</hi></note>.</s>
					<s n="15" xml:lang="la">Quare deus est orandus, ut suis faveat et <lb xml:id="p1z24"/>adsit misericorditer<note xml:id="fnm" type="footnote" n="m">et adsit misericorditer <hi>fehlt in BV.</hi></note>.</s>
					<s n="16" xml:lang="la">Miraculum, quod hic video, illud est, rem tanto tempore<note xml:id="fnn" type="footnote" n="n"><hi>BV gibt</hi> iam quinquennio <hi>für</hi> tanto tempore.</note> ins<lb xml:id="p1z25"/>titutam - nam<note xml:id="fno" type="footnote" n="o"><hi>Von</hi> nam <hi>bis</hi> fuerit <hi>am Rande nachgetragen, in BV übersprungen.</hi></note> a quinque fere annis, quamvis iam duobus integris in actu fuerit<note xml:id="fnp" type="footnote" n="p"><hi>Von</hi> nam <hi>bis</hi> fuerit <hi>am Rande nachgetragen, in BV übersprungen.</hi></note> - nemine conscio praeter eos, qui tractarunt, <lb xml:id="p1z26"/>adhuc hostem et alios latere, postquam etiam exercitus ad exeundum in procinctu <lb xml:id="p1z27"/>est<note xml:id="fnq" type="footnote" n="q"><hi>BV verdeutlicht zu</hi> ad irrumpendum in procinctu astat.</note>.</s>
					<s n="17" xml:lang="la">Absque deo non videtur tam longum silentium esse.</s>
					<s n="18" xml:lang="la">Nam, quae nos scribimus, <lb xml:id="p1z28"/>praeter paucissimos nemo novit, quare velim etiam apud te contineri, <lb xml:id="p1z29"/>quousque sic profuerit.</s>
					<s n="19" xml:lang="la">Hactenus de bello.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">De <persName ref="p18722">Erasmo</persName> et <persName ref="p1974">Luthero</persName> <lb xml:id="p1z30"/>idem sentio, quod tu de altero<note xml:id="fn17" type="footnote" n="17">Vgl. oben S. 127, 25-35.</note>.</s>
					<s n="21" xml:lang="la">Profuerunt initio, nunc nemo <lb xml:id="p1z31"/>nocet perniciosius.</s>
					<s n="22" xml:lang="la">Alter superbus et insolens est, alter amarus et am<lb xml:id="p1z32"/>bitiosus.</s>
					<s n="23" xml:lang="la">Deus, opto, faveat, imo emendet utrosque.</s>
					<s n="24" xml:lang="la">De <persName ref="p2442">Oecolam<lb xml:id="p1z33"/>padio</persName> interpres <persName ref="p1974">Lutheri</persName> mitius quiddam habet<note xml:id="fn18" type="footnote" n="18">Möglicherweise bezieht sich <persName ref="p8418">Myconius</persName> auf eine diesbezügliche Aussage <persName ref="p467">Bucers</persName>. <persName ref="p467">Bucer</persName> äußerte sich nämlich einige Tage später auch <persName ref="p495">Bullinger</persName> gegenüber sehr günstig über <persName ref="p2442">Oekolampad</persName> und dessen milde, verständnisvolle Beurteilung <persName ref="p1974">Luthers</persName>, s. unten <ref target="file10393">[Nr. 361]</ref> S. 137f, 7-21.</note>, quam tu scribis<note xml:id="fn19" type="footnote" n="19">Vgl. oben S. 127, 29-31.</note>.</s>
					<s n="25" xml:lang="la">Ita enim ait: «Et <lb xml:id="p1z34"/>ego plane persuasus sum <persName ref="p4696">Emserum</persName><note xml:id="fn20" type="footnote" ana="bio" n="20"><persName ref="p4696">Hieronymus Emser</persName>, 1478-1527, aus <placeName ref="l1267">Weidenstetten</placeName> bei <placeName ref="l513">Ulm</placeName>, studierte von 1493 bis 1499 in <placeName ref="l512">Tübingen</placeName> und <placeName ref="l28">Basel</placeName>. Noch vor 1502 erhielt er die Priesterweihe. 1504 las er in <placeName ref="l142">Erfurt</placeName> und in <placeName ref="l284">Leipzig</placeName>. Nach seiner Promotion zum Lizentiaten des kanonischen Rechts wurde er 1505 Geheimsekretär und, vier Jahre danach, Hofkaplan bei Herzog <persName ref="p19058">Georg von Sachsen</persName>. Der Humanist <persName ref="p4696">Emser</persName> war anfänglich kirchlichen Reformen nicht abgeneigt, nahm gegen <persName ref="p6778">Tetzel</persName> Stellung und unterhielt bis zum Jahr 1519 gute Beziehungen zum <placeName ref="l558">Wittenberger</placeName> Kreis. Im Anschluß an die <placeName ref="l284">Leipziger</placeName> Disputation aber wandte er sich offen gegen <persName ref="p1974">Luther</persName>. Mit einer ersten Schrift, in der er <persName ref="p1974">Luther</persName> mit <persName ref="p5327">Hus</persName> und den Hussiten in Verbindung brachte, und dessen scharfer Entgegnung im September 1519 begann eine lange und bittere Kontroverse zwischen dem «Emserschen Steinbock» und dem «Stier zu <placeName ref="l558">Wittenberg</placeName>». <persName ref="p4696">Emsers</persName> Streitschriften richteten sich indessen auch gegen <persName ref="p4349">Karlstadt</persName>, <persName ref="p4091">Zwingli</persName> und andere Reformatoren. Der weitaus überwiegende Teil der an die 50 nachgelassenen Publikationen <persName ref="p4696">Emsers</persName> ist der kirchlichen Kontroversliteratur zuzurechnen. Auf Veranlassung des Herzogs gab <persName ref="p4696">Emser</persName> 1527 ein in Anlehnung an <persName ref="p1974">Luthers</persName> Bibel übersetztes und anhand der Vulgata revidiertes Neues Testament heraus. - Lit.: Gustav <hi>Kawerau,</hi> Hieronymus Emser. Ein Lebensbild aus der Reformationsgeschichte, Halle 1898. - <bibl source="b625">SVRG</bibl> 61; Heribert <hi>Smolinsky,</hi> Hieronymus Emser, in: Katholische Theologen der Reformationszeit I, hg. v. Erwin Iserloh, Münster i. W. 1984. - Katholisches Leben und Kirchenreform im Zeitalter der Glaubensspaltung 44, S. 37-46; Heinrich <bibl source="b260">Grimm</bibl> in: <bibl source="b457">NDB</bibl> IV 488 f; Franz <hi>Lau</hi> in: RGG VI 462; Erwin <hi>Iserloh</hi> in: LThK III 855f; Josef <hi>Steinruck</hi> in: <bibl source="b641">TRE</bibl> IX 576-580; <bibl source="b163">Contemporaries</bibl> I 429 f.</note> et <persName ref="p2442">Oecolampadium</persName> et similes his ictibus<pb type="edition" next="134"/> horribilibus <lb xml:id="p1z35"/>et quassationibus subito extinctos esse»<note xml:id="fn21" type="footnote" n="21">Zitiert in freier lateinischer Übersetzung aus <persName ref="p1974">Luthers</persName> «Von der Winkelmesse und Pfaffenweihe», 1533, S. <bibl source="b671">WA</bibl> XXXVIII 204, Z. 26-28.</note>.</s>
					<s n="26" xml:lang="la">Haec tantum legi indicante <persName ref="p8054">Marco <lb xml:id="p1z36"/>nostro Bersio</persName>.</s>
					<s n="27" xml:lang="la">Miror, si aliter sit in exemplari Lutherano<note xml:id="fn22" type="footnote" n="22"><persName ref="p495">Bullinger</persName> zitiert im Brief vom 24. April (unten S. 145, 56-59) den genauen Wortlaut der <persName ref="p1974">Luther</persName>-Stelle, welche <persName ref="p8418">Myconius</persName> hier nur auf Grund einer Mitteilung des <persName ref="p8054">Markus Bertschi</persName> wiedergegeben hat.</note>.</s>
					<s n="28" xml:lang="la">Equidem <lb xml:id="p1z37"/>iurare ausim <persName ref="p1974">Lutherum</persName> persuasum spiritum sanctum non esse nisi apud se et<pb type="scan" next="||54v."/> <pb/><lb xml:id="p2z1"/>suos.</s>
					<s n="29" xml:lang="la">Dies declarabit omnia<note xml:id="fn23" type="footnote" n="23">Vgl. <cit type="bible"><ref>1 Kor 3, 13</ref></cit>.</note>.</s>
					<s n="30" xml:lang="la">Deus largiatur nobis suam veritatem<note xml:id="fn24" type="footnote" n="24">Vgl. <cit type="bible"><ref>Ps 43, 3</ref></cit>.</note>.</s>
				</p>
				<p>
					<s n="31" xml:lang="la"><lb xml:id="p2z2"/>Caeterum opus habemus opera tua: Indigemus viro docto, cordato, prudenti.</s>
					<s n="32" xml:lang="la"><lb xml:id="p2z3"/>Si quem noveris, qui ad subsidium ecclesiae nostrae queat dari, quantocyus <lb xml:id="p2z4"/>indicabis, vel ex tuis vel aliunde<note xml:id="fn25" type="footnote" n="25"><persName ref="p495">Bullinger</persName> empfahl <persName ref="p4349">Andreas Karlstadt</persName> (s. unten <ref target="file10395">[Nr. 363]</ref> S. 143, 21-27), der am 1. Juli 1534 zur Entlastung von <persName ref="p8424">Paul Phrygio</persName> als Professor an der Universität und als Pfarrer am St. Peter in <placeName ref="l28">Basel</placeName> angestellt wurde, vgl. Karl <hi>Gauß,</hi> Basilea Reformata, Basel 1930, S. 94.</note>.</s>
					<s n="33" xml:lang="la">Diligentiam adhibe, nam sic est neces[se]<note xml:id="fnr" type="footnote" n="r"><hi>Randtext im engen Einband nicht zugänglich.</hi></note>.</s>
				</p>
				<p>
					<s n="34" xml:lang="de"><lb xml:id="p2z5"/><persName ref="p5547">Wolfgang Kuchimeister</persName><note xml:id="fn26" type="footnote" ana="bio" n="26"><persName ref="p5547">Wolfgang Kuchimeister</persName>, wie schon sein Vater Möbelschreiner (Tischmacher) in <placeName ref="l587">Zürich</placeName>, scheint ein tüchtiger, initiativer Mann gewesen zu sein, vgl. unten S. 219, 4f. 1533 schloß er mit der Metzgerzunft für den Bau ihres Zunfthauses einen Gesamtarbeitsvertrag («samenthafft verdingen», «verdingwerch»), was ihm der Rat auf Antrag der Zimmerleutezunft verbot, wie auch 1557 das Bleichen von Tüchern auf seiner Wiese. Er gehörte zu den drei ersten Verordneten, die als Experten die 1548 eingeführte Meisterprobe (einen Kasten mit eingesetztem Fuß und einen Tisch) zu begutachten hatten. Er saß nie im Rat. - Lit.: Quellen zur Zürcher Zunftgeschichte, bearb. unter Mithilfe von Hans Nabholz von Werner Schnyder, Bd. 1, Zürich 1936, S. 213. 262. 294f.</note> der, tischmacher, wott mir sin sun<note xml:id="fn27" type="footnote" ana="bio" n="27">Sein Sohn ist wahrscheinlich <persName ref="p5545">Balthasar Kuchimeister (Kuchenmeister)</persName>, geb. 1520 [?], der 1546 kurze Zeit <placeName ref="l216">Hirzel</placeName> und <placeName ref="l1087">Weiach</placeName> versah, am 27. November 1546 Pfarrer in <placeName ref="l998">Knonau</placeName> wurde (Zürich StA, E I 30.66, Nr. 12) und vom Frühling 1551 (ebenda E I 30.75, Nr. 8) bis zu seinem Tod im März 1566 (ebenda E I 30.45, Nr. 7; <bibl source="b39">Graubünden, Korr.</bibl> II 691) Pfarrer in <placeName ref="l1268">Flaach</placeName> (alle Orte im <placeName ref="l803">Kt. Zürich</placeName>) war. Wegen unbedachter politischer Äußerungen wurde er 1555/56 mit Haft (vgl. <persName ref="p2757">Jakob Rüeger</persName> an <persName ref="p495">Bullinger</persName>, 3. Januar 1556, Zürich StA, E II 375,481) und 1562 mit Geld gebüßt. <persName ref="p495">Bullinger</persName> empfahl ihn im Sommer 1534 nochmals an <persName ref="p8418">Myconius</persName> (s. unten <ref target="file10434">Nr. 399</ref>), dessen Kostgänger er vermutlich wurde. An der Universität <placeName ref="l28">Basel</placeName> war <persName ref="p5547">Kuchimeister</persName> nicht immatrikuliert. - Lit.: <bibl source="b384">LL</bibl> XI 233; Pfarrerbuch 395.</note> schick[en]<note xml:id="fns" type="footnote" n="s"><hi>Randtext im engen Einband nicht zugänglich.</hi></note>; <lb xml:id="p2z6"/>enbüttend<note xml:id="fn28" type="footnote" n="28">entbietet, lasset ihm sagen (<bibl source="b590">SI</bibl> IV 1869).</note> imm, so es kumlich<note xml:id="fn29" type="footnote" n="29">gelegen, passend (<bibl source="b590">SI</bibl> III 285f).</note>, ye belder, ye lieber, so will<pb type="edition" next="135"/> ich inn <lb xml:id="p2z7"/>versuͦchen<note xml:id="fn30" type="footnote" ana="lex" n="30">prüfen (<bibl source="b590">SI</bibl> VII 223f).</note>, wie er mir geschriben heb<note xml:id="fn31" type="footnote" n="31"><persName ref="p5547">Wolfgang Kuchimeisters</persName> Brief an <persName ref="p8418">Myconius</persName> scheint nicht mehr erhalten zu sein.</note>.</s>
					<s n="35" xml:lang="la">Per ocium ei scribere non licuit.</s>
				</p>
				<p>
					<s n="36" xml:lang="la"><lb xml:id="p2z8"/>Quae in his comitiis<note xml:id="fn32" type="footnote" n="32">Die Tagsatzung vom 14. April 1534 in <placeName ref="l21">Baden</placeName>, s. <bibl source="b197">EA</bibl> IV/IC, 307-313.</note> acta sunt, ubi noveris, ad me perscribito, ut <lb xml:id="p2z9"/>videam, quomodo legati consonent aut dissonent<note xml:id="fn33" type="footnote" n="33">Vermutlich im Streit zwischen dem Abt und der Stadt <placeName ref="l473">St. Gallen</placeName>, <bibl source="b197">EA</bibl> IV/IC, 307 a. b; vgl. unten S. 145f, Anm. 4.</note>.</s>
				</p>
				<p>
					<s n="37" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="38" xml:lang="la">Raptim <lb xml:id="p2z10"/><placeName ref="l28">Basileae</placeName>, 20. aprilis anno 34.</s>
				</p>
				<p>
					<s n="39" xml:lang="la"><lb xml:id="p2z11"/><persName ref="p8418">Os.</persName> tuus<note xml:id="fnt" type="footnote" n="t"><hi>Darunter von späterer Hand:</hi> <persName ref="p8418">Myconius</persName>.</note>.</s>
				</p>
				<p>
					<note type="address">[Adresse darunter:]</note>
					<s n="40" xml:lang="la"><lb xml:id="p2z12"/>Domi<lb xml:id="p2z13"/>no <persName ref="p495">He<lb xml:id="p2z14"/>inricho Bullingero</persName>, docto pio<lb xml:id="p2z15"/>que fratri in domino suo.</s>
					<s n="41" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
