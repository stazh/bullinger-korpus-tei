	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Scribebam diebus abhinc exactis 8, sed <lb xml:id="p1z2"/>neminem inveni, cui traderem; his ergo <lb xml:id="p1z3"/>nunc etiam inclusi illas.</s>
					<s n="3" xml:lang="la">Interea tuae adferuntur <lb xml:id="p1z4"/>una cum illustris viri <persName ref="p2054">Martinengi</persName> literis mihi val<lb xml:id="p1z5"/>de gratis, ac tibi multum me debere fateor, <lb xml:id="p1z6"/>cuius opera in eius amicitiam perveni, quo nomine <lb xml:id="p1z7"/>et gratias tuae humanitati maximas ago.</s>
					<s n="4" xml:lang="la">Respond<lb xml:id="p1z8"/>eo illi brevibus; tu, quaeso, literas procura.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>D. <persName ref="p2336">Bernardino</persName> amplius ne verbum quidem audio.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Sunt hic, qui dicant <persName ref="p2807">Camillum</persName> et <persName>Darium</persName><note xml:id="fn1" type="footnote" n="1">Dario Sozzini?</note> profectos <lb xml:id="p1z11"/><placeName ref="l257">Constantiam</placeName> ibi latitare; ego, quid verum <lb xml:id="p1z12"/>sit, nescio; nobis contra istos vigilandum esse scio.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Pro his, quae misisti de concilio accepta ab <lb xml:id="p1z14"/>episcopo, ingentes ago gratias; cupide autem ipsa <lb xml:id="p1z15"/>decreta expecto.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Dum maledictiones et bene<lb xml:id="p1z16"/>dictiones carnalis a Lotherbuͦbingen lego, <lb xml:id="p1z17"/>occurrit illud prophetae: Maledicam benedictionis <lb xml:id="p1z18"/>nostris<note type="misc">vestris?</note>, et recidet in ipsum, quod eiaculatus <lb xml:id="p1z19"/>fuerit in innoxium impius.</s>
					<s n="9" xml:lang="la">Arbitratur <lb xml:id="p1z20"/>d. <persName ref="p2054">Martinengus</persName> propter tumultum <placeName ref="l2650">Calabricum</placeName> et metum <lb xml:id="p1z21"/><placeName ref="l2510">Turcae</placeName> in <placeName ref="l834">Italiam</placeName> se apparantis adversarios <lb xml:id="p1z22"/>nostros nunc frustra consultaturos de exequtione.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Dominus dissipet consilia istorum!</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l2448">Quinque<lb xml:id="p1z24"/>pagicorum</placeName> aliqui videntur et dicuntur de novo fure<lb xml:id="p1z25"/>re contra <placeName ref="l646">Claronenses</placeName>, et quis tandem finis?</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z26"/>Domine deus, libera tu invocantes nomen tuum.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z27"/>Quae habeo a d. <persName ref="p8018">Hallero</persName> <placeName ref="l41">Berna</placeName> de proditione <lb xml:id="p1z28"/>contra <placeName ref="l167">Genevam</placeName> instituta, habes hic descripta.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z29"/>Pestis admodum inclementer sęvit ad <placeName ref="l2459">Rhenum</placeName> <lb xml:id="p1z30"/>infra <placeName ref="l491">Argentinam</placeName>, incipit gliscere et in ipsa <lb xml:id="p1z31"/>urbe.</s>
					<s n="15" xml:lang="la">Petunt fratres <placeName ref="l210">Heydelbergenses</placeName>, ut supplicemus <lb xml:id="p1z32"/>pro salute eorum domino; comes <persName>Valentinus <lb xml:id="p1z34"/>ab Erpach</persName> peste extinctus est in <placeName ref="l2477">Palatinatu</placeName>.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z35"/>Oremus dominum, ut nobis adsit perpetuo.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z36"/>vale in Christo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 7. ianuarii 1564.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute"><lb xml:id="p1z37"/>Saluto consules, dominos meos, <persName ref="p8359">Gallicium</persName>, <persName ref="p6130">Ponta<lb xml:id="p1z38"/>sellam</persName> et alios amicos nostros.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>ministro, domino <lb xml:id="p2z4"/>et fratri meo colendo <lb xml:id="p2z5"/>et dilecto.</s>
					<s n="22" xml:lang="la"><lb xml:id="p2z6"/>Chur.</s>
				</p>
			</div>
		</body>
	</text>
