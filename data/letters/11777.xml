	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Deo laus<lb xml:id="p1z2"/>!</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Quam possim humiliter me tuae pietati commendo, mi domine colende.</s>
					<s n="3" xml:lang="la">Literas <lb xml:id="p1z4"/>tuas per <persName ref="p4747">Falcknerum</persName> nuper accepi, quibus te excusas, quod non tanta potueras <lb xml:id="p1z5"/>tum temporis respondere prolixitate, quanta, ut ais, fortassis exspectabam.</s>
					<s n="4" xml:lang="la">At <lb xml:id="p1z6"/>ego vicissim respondeo, me omnino tam prolixum, sed mihi vere utile et <lb xml:id="p1z7"/>gratissimum responsum, non cupiisse, ne tibi fuissem nimis molestus, ut fui dubio procul.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Propter <persName ref="p505">Joannem Bourcherum</persName> ex animo habeo tibi gratias, praesertim quod tanto <lb xml:id="p1z9"/>citius, <lb xml:id="p1z10"/>ut loqueris, ob meum patrocinium illum juvisti.</s>
					<s n="6" xml:lang="la">De <persName ref="p18519">rege</persName> <placeName ref="l2524">Scotorum</placeName> D. <persName ref="p506">Joa<lb xml:id="p1z11"/>nni Butlero</persName> paulo post natalem Domini scripsi, eum certe mortuum esse, atque <placeName ref="l15">Antverpiae</placeName> fuisse inter aliquos <lb xml:id="p1z12"/>famam eundem ex vulnere interiisse: id quod in meis literis non erat no<lb xml:id="p1z13"/>tatum, certissimum tamen et ab ipsis <placeName ref="l2524">Scotis</placeName> confessum, regem eorum post suos <lb xml:id="p1z14"/>ab <placeName ref="l830">Anglis</placeName> captos nobiles aliquot statim obiisse.</s>
					<s n="7" xml:lang="la">Ex eo tempore nihil certe ex <lb xml:id="p1z15"/><placeName ref="l830">Anglia</placeName> accepi, praeterquam quod rex noster absque mora in <placeName ref="l2524">Scotiam</placeName> illos <lb xml:id="p1z16"/>nobiles remisisset, ut pro se apud <placeName ref="l2524">Scotos</placeName> orarent, et regnum illi reddi <lb xml:id="p1z17"/>aut offerr a <placeName ref="l2524">Scotis</placeName> suis viribus omnibus conarentur.</s>
					<s n="8" xml:lang="la">Sed, ut jam ab <lb xml:id="p1z18"/><placeName ref="l830">Anglo</placeName> nobili hic audivi, nihil fere a <placeName ref="l2524">Scoti<lb xml:id="p1z19"/>s</placeName> impetrati sunt, sed ad regem <lb xml:id="p1z20"/>rediere suo conatu plane deceptum.</s>
					<s n="9" xml:lang="la">Alii tamen nostrates <placeName ref="l15">Antverpiae</placeName> jactarunt, proceres <lb xml:id="p1z21"/><placeName ref="l2524">Scotiae</placeName> ad istorum nobilium preces aut industriam in <placeName ref="l830">Angliam</placeName> <placeName ref="l2524">Scotorum</placeName> cardinalem <lb xml:id="p1z22"/>misisse.</s>
					<s n="10" xml:lang="la">Iste autem <placeName ref="l830">Anglus</placeName> hic mihi retulit contrarium fere: videlicet, <placeName ref="l2524">Sco<lb xml:id="p1z23"/>tos</placeName> novum regem sibi constituisse ex suis, <persName ref="p20225">Gallorum regem</persName> in opem imploras<lb xml:id="p1z24"/>se, et nostrum totis viribus in animo habere adhuc depellere.</s>
					<s n="11" xml:lang="la">Non audio <lb xml:id="p1z25"/><persName ref="p8375">regem Angliae</persName> <persName ref="p18538">Caesari</persName> confoederatum esse, neque amicitiam <persName ref="p20225">Gallo</persName> renunciasse; <lb xml:id="p1z26"/>quamvis eum hoc propter <placeName ref="l2524">Scotos</placeName>, si illis succurrat, brevi facturum <lb xml:id="p1z27"/>esse verisimile sit.</s>
					<s n="12" xml:lang="la">Nihilominus mihi his nundinis ex <placeName ref="l830">Anglia</placeName> scriptum est, <lb xml:id="p1z28"/><placeName ref="l2524">Scotos</placeName>, qui naves aliquot a nostratibus eripuerunt, a proceribus <placeName ref="l2524">Scotiae</placeName> <lb xml:id="p1z29"/>prohibitos esse, ne bona quibus oneratae fuerunt divenderent, priusquam <lb xml:id="p1z30"/>scirent in illa etiam re quid placitum sit nostri regis.</s>
					<s n="13" xml:lang="la">Poterit tamen <lb xml:id="p1z31"/>in ea re latere aliquid doli, ne scilicet <persName ref="p8375">rex Angliae</persName> se muniat fortius, <lb xml:id="p1z32"/>atque in bellum paret citius.</s>
					<s n="14" xml:lang="la" ana="farewell">Bene vale, et me uxori tuae carissimae <lb xml:id="p1z33"/>omnibusque tam piissimis quam doctissimis viris, mihi per tuam operam <lb xml:id="p1z34"/>isthic notis, commendatum quam diligentissime habeto.</s>
					<s n="15" xml:lang="la">Deus te tuique similes <lb xml:id="p1z35"/>diutissime conservet, et orate pro me.</s>
					<s n="16" xml:lang="de">Amen.</s>
					<s n="17" xml:lang="la">Jam <placeName ref="l361">Nurembergam</placeName> (post mensem, <lb xml:id="p1z36"/>Deo volente, rediturus) profecturus sum ad vendendos pannos meos, <lb xml:id="p1z37"/>quos propter <persName ref="p18605">Juliacensem ducem</persName> non sunt ausi huc his nundinis mit<lb xml:id="p1z38"/>tere amici mei, qui <placeName ref="l15">Antverpiae</placeName> res meas curant; atque ideo miserunt eos <lb xml:id="p1z39"/><placeName ref="l361">Nurembergam</placeName> ad nundinas jam appropinquantes.</s>
					<s n="18" xml:lang="la" ana="farewell">Iterum vale et vive feliciter.</s>
					<s n="19" xml:lang="de">Amen.</s>
					<s n="20" xml:lang="la"><placeName ref="l157">Francofor<lb xml:id="p1z40"/>diae</placeName>, 24 die Martii, 1543.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Tuus, <persName ref="p1548">RICARDUS HILLES</persName> INS<lb xml:id="p1z41"/>C<lb xml:id="p1z42"/>RIPTIO.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bvllingero</persName> <lb xml:id="p2z2"/>theologo pientissimo amico meo <lb xml:id="p2z3"/>imprimis caro et colendo.</s>
					<s n="23" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
