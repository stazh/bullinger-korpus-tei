	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et vitae innocentiam a domino!</s>
					<s n="2" xml:lang="la">Vir ille artifex <placeName ref="l104">Cremensis</placeName> <lb xml:id="p1z2"/>venit ad me ferens literas a <persName ref="p3375">Vergerio</persName>; fasciculum, quem <lb xml:id="p1z3"/>habui ante octo dies, illi quoque commendavi.</s>
					<s n="3" xml:lang="la">Gebennam <lb xml:id="p1z4"/>properat illic arte sua victurus et a seva persecutione securus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>De rebus <placeName ref="l834">Italicis</placeName> nimirum ille te certiorem faciet.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Scriberem <lb xml:id="p1z6"/>plura, nisi tabellarius nimium properaret; post dies octo, si nactus <lb xml:id="p1z7"/>fuero tabellarium commodum, scribam de singulis.</s>
					<s n="6" xml:lang="la"><persName ref="p8359">Philippus <lb xml:id="p1z8"/>Gallicius</persName> collega factus est ecclesię nostrę, vir doctus et laboris <lb xml:id="p1z9"/>patiens; ille sepius nostro nomine ad te scripturus est.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Ex <placeName ref="l98">Curia</placeName> <placeName ref="l648">Rhetica</placeName>, 22. februarii 51.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z11"/>Tuus <persName ref="p654">Ioannes Comander</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute"><lb xml:id="p1z12"/><persName>Franciscum</persName> cum sua familia meo nomine salutare <lb xml:id="p1z13"/>digneris.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro m[agis<lb xml:id="p2z2"/>tro] <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, fratri suo <lb xml:id="p2z4"/>et domino observando.</s>
				</p>
			</div>
		</body>
	</text>
