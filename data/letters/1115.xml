	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hoc vespere missae sunt ad celebrem quendam mercatorem ex nostris literae <lb xml:id="p1z2"/>mihi inscriptae et certo perlatae nuncio, sed incerto authore et sine authoris <lb xml:id="p1z3"/>nomine, in quibus cuius rei admonear, tu ipse videbis, nam ea causa <lb xml:id="p1z4"/>his meis inclusas misi, ut et legeres et iudicares.</s>
					<s n="3" xml:lang="la">Simulatur quidem <lb xml:id="p1z5"/>pietatis studium et amor in patriam nostram; at quia omnia <foreign xml:lang="el">ἀνόνητα</foreign> <lb xml:id="p1z6"/>sunt, valde mihi sunt suspecta.</s>
					<s n="4" xml:lang="la">Fortasse veterator aliquis aut nebulo has <lb xml:id="p1z7"/>nugas fingere et talis tragoedię imagine terrere nos adeoque coercere <lb xml:id="p1z8"/>voluit, ne auxiliis adversum impios institutis nostros ulla parte con<lb xml:id="p1z9"/>iungeremus; quanquam interim fatear prudentiae esse, in tam lubricis <lb xml:id="p1z10"/>exulceratorum temporum articulis nullam admonitionem temere reiicere.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Sed tuum erit iudicare.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l473">Sangalli</placeName>, 20. decembris, anno <lb xml:id="p1z13"/>1550.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p8049">Ioachimus Vadianus</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrycho Bullingero</persName>, <lb xml:id="p2z2"/>suo.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
