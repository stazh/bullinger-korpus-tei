			<zone xml:id="p4z5-0" points="2848,1472 2888,1453 2930,1459 2941,1450 3005,1461 3027,1450 3047,1460 3045,1401 3017,1397 3004,1386 2978,1388 2954,1375 2922,1387 2875,1360 2844,1364">2851,1425 2879,1421 2907,1420 2935,1422 2963,1424 2991,1425 3019,1427 3048,1428</zone>
