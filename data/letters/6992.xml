	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Cum tibi, reverende Bullingere, domino Erastris ad
					<lb xml:id="p1z2"/>tuas respondeat, mihi, quod addam, relinqui nihil existimo
					<lb xml:id="p1z3"/>Hanc tamen brevem epistolam ipsius literis volui adiicere
					<lb xml:id="p1z4"/>bitiis tuis literis acceptis nihil responderem. Recte
					<lb xml:id="p1z5"/>iudicasti de difficultate rerum Ambergensium. Metuebamus
					<lb xml:id="p1z6"/>nos propter adversariorum multituditem et pervicaciam
					<lb xml:id="p1z7"/>admirabilem nostrorum lenitatem. Sed tamen Derei
					<lb xml:id="p1z8"/>causae affuturum speramus; Sua enim pertinacia con
					<lb xml:id="p1z9"/>concionatores clamosi et maledici, ipsi se deiecerunt loco. Ho
					<lb xml:id="p1z10"/>tantum postuilabim est, ut a comiciis et condemnationibus
					<lb xml:id="p1z11"/>abstinerent et nos a fraternitate et ecclesia christiana
					<lb xml:id="p1z12"/>non excluderent, stiamque sententiam ita profiterentur, n
					<lb xml:id="p1z13"/>liberum ecclesiae iudicium relinquerent nec eam  congius
					<lb xml:id="p1z14"/>honc partis utrisque avocarent et se iitra metas eorum
					<lb xml:id="p1z15"/>scriptorum continerent, quae et ipsi non possint improbare
					<lb xml:id="p1z16"/>repudiare. Id cum obtineri non potuerit, ne ipso
					<lb xml:id="p1z17"/>quidem papistus, nedum alios ipsorum dimissionem repe.
					<lb xml:id="p1z18"/>pohendere posse confidimus. Tolerati enim fuissent
					<lb xml:id="p1z19"/>etiam cum ecclesiae detrimento, si ad moderatione
					<lb xml:id="p1z20"/>aliquam tradici potuissent. Sed in eos competere
					<lb xml:id="p1z21"/>existimo, quod Iosue1 de chananaeis dicitur. A domino factu
					<lb xml:id="p1z22"/>fuisse, ut indurarentur corda eorum, ut puignarent contra
					<lb xml:id="p1z23"/>Isul, ut caderent nec mererentur ullam misericordiam.
					<lb xml:id="p1z24"/>isitir oramus, ut gubernet caetera nobis pacem conseniet,
					<lb xml:id="p1z25"/>et in media Germania et circumquaque tristes moti
					<lb xml:id="p1z26"/>omnia mivantur, a vobis pestitentiam et omnia malo
					<lb xml:id="p1z27"/>eclementer anertat teque confirmet ac nobis quam diutissima
					<lb xml:id="p1z28"/>me servet. Saluto steserenter dominu totiam, dominum Wolfiunsm
					<lb xml:id="p1z29"/>die Lavaterum, dominus Rodolphum, die Zwinglium. Vale
					<lb xml:id="p1z30"/>feliciter. Heidelbu 5. ianarii anno 1567.
					<lb xml:id="p1z31"/>Ts Zacharias Ursinus
					<pb/>
					<lb xml:id="p2z1"/>Reverendo viro et seximio Christi
					<lb xml:id="p2z2"/>servo, domino Henrico Bullingero,
					<lb xml:id="p2z3"/>ecclesiae Tigurinae pastori, domino
					<lb xml:id="p2z4"/>ac facitori scio tanquam patri bservano.
					<lb xml:id="p2z5"/>quando.
					<lb xml:id="p2z6"/>
					<lb xml:id="p2z7"/>
					<lb xml:id="p2z8"/>Zürich.
				</p>
