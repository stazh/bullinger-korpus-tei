	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Per Iesum Christum omnem salutem.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Scripsi nuper <persName ref="p1039">Benedicti Euandri</persName> causa ad te<note xml:id="fn1" type="footnote" n="1">Siehe oben <ref target="file10284">Nr. 253</ref>.</note>, frater sincerissime, <lb xml:id="p1z2"/>nunc iterum ecclesie nostre.</s>
					<s n="3" xml:lang="la">Desperabundi de saluti plurimorum.</s>
					<s n="4" xml:lang="la">Interturbatur ecclesia Luther<lb xml:id="p1z3"/>anorum, anabaptistarum et aliorum doctrina.</s>
					<s n="5" xml:lang="la">Per decennium predicatur verbum dei<note xml:id="fn2" type="footnote" n="2">Seit ungefähr 1523 predigten in <placeName ref="l907">Kempten</placeName> <persName ref="p6294">Sixt Rummel</persName>, <persName ref="p1390">Jakob Haistung</persName> und <persName ref="p6267">Johannes Rottach</persName> im evangelischen Geist, s. <hi>Erhard,</hi> Reformation 7f.</note> sine <lb xml:id="p1z4"/>fructu<note xml:id="fn3" type="footnote" n="3">Vgl. <cit type="bible"><ref>Mt 13, 22 par</ref></cit>.</note>.</s>
					<s n="6" xml:lang="la">Adhuc omnia pendent sub priori seculo.</s>
					<s n="7" xml:lang="la">Ceremonie prostant adhuc cum mis<lb xml:id="p1z5"/>se nomenclatura in monasterio<note xml:id="fn4" type="footnote" n="4">In dem vor der Stadt liegenden, mächtigen Benediktinerkloster. In der Stadt selbst hatten nur die Nonnen des Franziskanerinnenklosters den katholischen Glauben beibehalten und mußten deshalb 1537 <placeName ref="l907">Kempten</placeName> verlassen, s. <hi>Erhard,</hi> Reformation 41.</note>.</s>
					<s n="8" xml:lang="la">Luditur, bibitur, peieratur etc., nec ulle censur<lb xml:id="p1z6"/>e apud seniores populi memoria habetur.</s>
					<s n="9" xml:lang="la">Timent cesarem.</s>
					<s n="10" xml:lang="la">Quid plura?</s>
					<s n="11" xml:lang="la">Audiunt <lb xml:id="p1z7"/>verbum dei, sed non credunt<note xml:id="fn5" type="footnote" n="5">Vgl. <cit type="bible"><ref>Jes 6, 9</ref></cit>; <cit type="bible"><ref>Mt 13, 13-23</ref></cit>.</note>.</s>
					<s n="12" xml:lang="la">Timeo in damnationis testimonium denuncietur, ut ubique <lb xml:id="p1z8"/>inscius, quid faciendum, ita «sanctum dare canibus» <cit type="bible"><ref>[Mt 7, 6]</ref></cit>.</s>
					<s n="13" xml:lang="la">Vellem potius esse tecum agro <lb xml:id="p1z9"/><placeName ref="l587">Tigurino</placeName>, si deus velit.</s>
					<s n="14" xml:lang="la">Consule itaque, optime frater, boni, si quid habes.</s>
					<s n="15" xml:lang="la">Ni adsit deus <lb xml:id="p1z10"/>miris modis, decidit omnis spes.</s>
					<s n="16" xml:lang="la">Magistratus timore perculsus.</s>
					<s n="17" xml:lang="la">Misera gens pendet a men<lb xml:id="p1z11"/>se fortuna.</s>
					<s n="18" xml:lang="la">Ex Christi precepto brevi abeundum censeo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Scribito paucis, si vacas, per <lb xml:id="p1z12"/>huius schede latorem<note xml:id="fn6" type="footnote" n="6">Unbekannt.</note>.</s>
					<s n="20" xml:lang="la">Ora sedulo nisu pro statu ecclesie nostre, etiam pro nobis.</s>
					<s n="21" xml:lang="la">Itidem <lb xml:id="p1z13"/>et nos faciemus.</s>
					<s n="22" xml:lang="la">Cupio salvos fratres omnes, qui tecum sunt, <persName ref="p1753">Leonem</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p1753">Leo Jud</persName>.</note>, <persName ref="p8437">Erasmum Fabricium</persName>, <lb xml:id="p1z14"/><persName ref="p4349">Carolstadium</persName>.</s>
					<s n="23" xml:lang="la" ana="salute">Salutant et te tuosque fratres mei<note xml:id="fn8" type="footnote" n="8"><persName ref="p8476">Kappelers</persName> Amtsbrüder <persName ref="p8426">Paul Rasdorfer</persName> und <persName ref="p1390">Jakob Haistung</persName>.</note>, etiam genitricem tuam<note xml:id="fn9" type="footnote" ana="bio" n="9"><persName ref="p7042">Anna Bullinger, geb. Wiederkehr</persName>.</note> cum uxore<note xml:id="fn10" type="footnote" ana="bio" n="10"><persName ref="p8051">Anna Bullinger, geb. Adlischwyler</persName>.</note> ada<lb xml:id="p1z15"/>mata: omnem gratiam.</s>
				</p>
				<p>
					<s n="24" xml:lang="la" ana="farewell"><pb type="edition" next="224"/>Vale.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><placeName ref="l907">Kampidone</placeName>, 6. novembris 33, raptim.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p8476">Vitus Kappeller</persName>, <lb xml:id="p1z17"/>verbi dei minister, <lb xml:id="p1z18"/>tuus deditus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="27" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Heinricho Bullingero</persName> episcopo <lb xml:id="p2z2"/><placeName ref="l587">Tigurino</placeName>, viro can<lb xml:id="p2z3"/>dido diligentissimoque fratri.</s>
					<s n="28" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
