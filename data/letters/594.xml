	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Per Christum Iesum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">S. D. <lb xml:id="p1z3"/>P.</s>
					<s n="3" xml:lang="la">Non respondi tuis proximis literis, <persName ref="p495">Bullingere</persName> optime atque humanissime, <lb xml:id="p1z4"/>quoniam nihil erat, quod scriberem novi.</s>
					<s n="4" xml:lang="la">Nunc autem <lb xml:id="p1z5"/>nuntium nactus certum, qui recta redit ex <placeName ref="l830">Anglia</placeName>, duo, ut ad te <lb xml:id="p1z6"/>scriberem, permoverunt: alterum est, quod te natarum tuarum unam <lb xml:id="p1z7"/>collocasse <persName ref="p7228">Zvinglio</persName>, magni <persName ref="p4091">Zvinglii</persName> virique clarissimi filio, <lb xml:id="p1z8"/>accepimus, alterum est concordia de coenae domini mysterio, <lb xml:id="p1z9"/>quam audio vos cum <persName ref="p540">Calvino</persName> et suis instituisse.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Tuae filliae <lb xml:id="p1z10"/>nuptias, quoniam spero honestissimam puellam adolescenti optimo <lb xml:id="p1z11"/>et nequaquam ab optimo et clarissimoparente degeneranti nupsisse, <lb xml:id="p1z12"/>tibi et uxori tuae amantissimae gratulor, deum vero optimum maximum <lb xml:id="p1z13"/>precor, ut id firmum atque auspicatum esse vellit.</s>
					<s n="6" xml:lang="la">De coenae domini <lb xml:id="p1z14"/>et re sacramentaria concordia, quoniam pacis et concordiae semper <lb xml:id="p1z15"/>studiosissimus fui, quid aliud dicam quam me illam vehementer <lb xml:id="p1z16"/>approbare?</s>
					<s n="7" xml:lang="la">Neque enim dubito, quin [quim?] talis sit, quod vos tales <lb xml:id="p1z17"/>agnoscam, hoc est piosreligiosos et veritatis servantissimos, ut <lb xml:id="p1z18"/>omnium bonorum approbationem mereatur, quamquam ipse, quo<lb xml:id="p1z19"/>d meum sensum attinet, nihil pronuntiare possim, utpote qui num <lb xml:id="p1z20"/>nundum scriptum ipsum legerim.</s>
					<s n="8" xml:lang="la">Circumfertur quidem scriptum <lb xml:id="p1z21"/>quoddam incerto autore, quae res effecit, quominus illud <lb xml:id="p1z22"/>perlegere curarim.</s>
					<s n="9" xml:lang="la">Mihi tamen gratum esset, si a vobis aliquid <lb xml:id="p1z23"/>huiusmodi profectum mihi legendum offerretur.</s>
					<s n="10" xml:lang="la">Sed de hoc satis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/>De rebus <placeName ref="l830">Anglicanis</placeName> puto te certiorem a nostro <persName ref="p8101">Laelio</persName> factum; <lb xml:id="p1z25"/>nam nihil ego literis <persName ref="p2336">Bernardini</persName> et aliorum amicorum <lb xml:id="p1z26"/>accepi, quod is non acceperit, quod iidem sunt utriusque amici, <lb xml:id="p1z27"/>ac fortassis etiam tu ipse literis plura ex <placeName ref="l830">Anglia</placeName> ab hoc <lb xml:id="p1z28"/>ipso tabellario accipies, quin et ipse tabellarius poterit <lb xml:id="p1z29"/>quaedam de statu <placeName ref="l830">Angliae</placeName> et Caesaris itineribus tibi narrare, <lb xml:id="p1z30"/>si ab eo placuerit sciscitari.</s>
					<s n="12" xml:lang="la">Equidem nihil aliud habeo novi; <lb xml:id="p1z31"/>tu si quid habes, quod non dubito, praesertim de comitiis istis iam<lb xml:id="p1z32"/>iam dissolutis et de <placeName ref="l832">Gallico</placeName> foedere et de [no - oder ve?] stra <placeName ref="l862">Helvetiorum</placeName> <lb xml:id="p1z33"/>concordia, rogo ut ad me perscribas; potes enim mecum communicare <lb xml:id="p1z34"/>fidenter, ut si ipse id ipsum cum animo faceres tuo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z35"/>Quod si feceris, rem mihi gratam et commodam feceris; sic <lb xml:id="p1z36"/>enim de rebus futuris et rerum eventu aliquid potero suspi<lb xml:id="p1z37"/>cari et rebus meis ante (domino duce et consiliario) consulere.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z38"/>Vale, mi <persName ref="p495">Bullingere</persName> charissime et observandissime cum familia tua tota <lb xml:id="p1z39"/>et tuam uxorem meae uxoris nomine saluta; non iussit, ut id <lb xml:id="p1z40"/>adscriberem.</s>
					<s n="15" xml:lang="la" ana="salute">Salutabis quoque generum tuum <pb/><lb xml:id="p2z1"/>mihi longe charissimum, quem oro, ut nostri recordetur <lb xml:id="p2z2"/>interdum.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l28">Basileae</placeName> 18. iulii 1549.</s>
					<s n="17" xml:lang="la" ana="salute">Saluta, <lb xml:id="p2z3"/>quaeso, si potes, mihi D. <persName ref="p8171">Bibliandrum</persName>, <persName ref="p1283">Gesnerum</persName> et <persName ref="p8011">Gualterum</persName>, <lb xml:id="p2z4"/>optimos ac doctissimos et mihi certe charissimos.</s>
					<s n="18" xml:lang="la" ana="farewell"><lb xml:id="p2z5"/>Iterum vale.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z6"/>Tuus ex animo <persName ref="p714">Coel<lb xml:id="p2z7"/>ius S[ecundus] C[urio]</persName> <pb/><lb xml:id="p4z1"/>subscripsit</s>
				</p>
