	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Cum singulari quodam eventu dominus rerum <lb xml:id="p1z2"/>providerit filium meum ex quattuor tertium in <placeName ref="l830">Angliam</placeName> <lb xml:id="p1z3"/>accersi visum est eo proficiscente et a me revertente, quem ex <lb xml:id="p1z4"/>alumni sui <persName ref="p8385">Conradi Huberti</persName> pręcepto exploravit de consensu, <lb xml:id="p1z5"/>epistolam meam, quam ad d. <persName>Edmundum</persName> scribo, ad te legendam <lb xml:id="p1z6"/>dare et simul rogare, ut meo nomine adulescentem illi commendare <lb xml:id="p1z7"/>ne graveris.</s>
					<s n="3" xml:lang="la">Nam memini illius ad te epistolam te mihi ostendis<lb xml:id="p1z8"/>se <lb xml:id="p1z9"/>et de meliore nota virum iamdiu percognitum tibi esse, unde factum <lb xml:id="p1z10"/>est, ut oblata mihi occasio ad meum Dithelmum spectans ut divinum be<lb xml:id="p1z11"/>neficium probaretur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="farewell">Dominus te nobis conservet incolumem, in <lb xml:id="p1z12"/>quo vale, mi venerande et chare <persName ref="p495">Bullingere</persName>.</s>
					<s n="5" xml:lang="la">In fundo meo <lb xml:id="p1z13"/>15. calendas septembres 1559.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p8178">Thomas Blaurerus</persName> tuus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>antistiti ecclesię <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName>, <placeName ref="l862">Helvetię</placeName> <lb xml:id="p2z4"/>ornamento, d. et amico <lb xml:id="p2z5"/>suo singulariter observ<lb xml:id="p2z6"/>ando.</s>
				</p>
			</div>
		</body>
	</text>
