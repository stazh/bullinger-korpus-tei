	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Speraveram omnino ea, quae scripseram clarissimo <lb xml:id="p1z2"/>viro d. legato tibi, charissime frater, communicanda iri, <lb xml:id="p1z3"/>et quidem brevia illa fuerunt nec nunc copiosiora <lb xml:id="p1z4"/>habeo.</s>
					<s n="3" xml:lang="la">Summa omnium: evangelium Christi feliciter <lb xml:id="p1z5"/>procedit in <placeName ref="l830">Anglia</placeName> nec minus feliciter in <placeName ref="l2524">Scotia</placeName>; oportet <lb xml:id="p1z6"/>enim evangelium ante iudicium praedicari ad fines <lb xml:id="p1z7"/>usque orbis.</s>
					<s n="4" xml:lang="la">In <placeName ref="l875">Hispania</placeName> quoque certum est ingentes esse <lb xml:id="p1z8"/>motus, quorum sedandorum gratia illuc profectus est per <lb xml:id="p1z9"/>mare non sine ingenti periculo et iactura rex <lb xml:id="p1z10"/><persName ref="p18575">Philippus</persName>, quippe qui eiectus dicitur in insulam quandam <lb xml:id="p1z11"/><placeName ref="l830">Angliae</placeName>, unde tamen mox solverit in <placeName ref="l875">Hispaniam</placeName>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z12"/>In <placeName ref="l832">Gallia</placeName> sic saevit persequtio contra fideles <lb xml:id="p1z13"/>ut vix antea saevius.</s>
					<s n="6" xml:lang="la">Sic scripsit ad me hisce <lb xml:id="p1z14"/>diebus d. <persName ref="p540">Calvinus</persName>; culpa ascribitur <placeName>Guysianis</placeName> alioqui <lb xml:id="p1z15"/>exosis <placeName ref="l832">Galliae</placeName> et maxime nobilitati.</s>
					<s n="7" xml:lang="la">Caeterum per <lb xml:id="p1z16"/>huiusmodi afflictiones solent grandescere ecclesiae.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Dominnum oremus, ut adsit et suae ecclesiae et suis bonis <lb xml:id="p1z18"/>servis.</s>
					<s n="9" xml:lang="la">In <placeName ref="l822">Germania</placeName> sunt multae contentiones, <lb xml:id="p1z19"/>in <placeName ref="l749">Saxonia</placeName> maxime.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><persName>Philippus</persName> a multis petitur; <lb xml:id="p1z20"/>videtur et ipse esse sacramentarius.</s>
					<s n="11" xml:lang="la"><persName ref="p3590">Princeps Hessus</persName> <lb xml:id="p1z21"/>obtinet antiquum et nos amat.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Multo melior est princeps <lb xml:id="p1z22"/><persName>elector Palatinus</persName> ille nuper electus aut creatus, quam <lb xml:id="p1z23"/>fuerit qui decessit; speramus (quantum de homine sperare <lb xml:id="p1z24"/>licet) non mediocria de illo.</s>
					<s n="13" xml:lang="la"><placeName ref="l572">Wirtembergensis</placeName> i<lb xml:id="p1z25"/>nter alios vehementer nobis est adversarius; instigatur <lb xml:id="p1z26"/>enim a <persName ref="p458">Brentio</persName>.</s>
					<s n="14" xml:lang="la">Sed dabit dominus his quoque finem<note xml:id="fn1" type="footnote" n="1"><hi>Vergil,</hi> Aeneis, 1, 199.</note>; ubique enim <lb xml:id="p1z27"/>sunt viri boni, qui veritatem intelligunt et iuvant.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z28"/>Ex <placeName ref="l2472">Polonia</placeName> nunc nihil audimus; dicitur tamen celebranda <lb xml:id="p1z29"/>nunc ibi fore comitia regni, et quo brevior<lb xml:id="p1z30"/>i esse liceat, mitto hic quaedam scripta, quae legas, <lb xml:id="p1z31"/>ea tamen lege, ut mox remittas tuis inclusas, in<lb xml:id="p1z32"/>primis Iaskei literas, ad quas hisce diebus erit <lb xml:id="p1z33"/>respondendum.</s>
					<s n="16" xml:lang="la">D. <persName ref="p8085">Hornus</persName>, d. <persName ref="p8391">Iuellus</persName>, qui convixit <lb xml:id="p1z34"/><persName ref="p8111">Martyri</persName>, d. <persName ref="p2866">Sampsonus</persName>, d. <persName ref="p2867">Sandus</persName>, d. <persName ref="p2606">Pilchinthonus</persName> <lb xml:id="p1z35"/><placeName ref="l830">Angli</placeName>, qui hic <placeName ref="l587">Tiguri</placeName> vixerunt et operam literis <lb xml:id="p1z36"/>dederunt, omnes in <placeName ref="l830">Anglia</placeName> facti dicuntur episcopi: <persName ref="p8391">Iuellus</persName> <lb xml:id="p1z37"/>ipse scribit se designatum <placeName ref="l951">Sarisburiensem</placeName> etc.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Boni <lb xml:id="p1z38"/>haec consulas, oro.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Valeas.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Festinantissime.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z39"/>13. octobris 1559.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="salute">Salutant te mei omnes.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z40"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="23" xml:lang="de"><lb xml:id="p1z41"/><foreign xml:lang="la">De <placeName ref="l41">Bernensibus</placeName> <lb xml:id="p1z42"/>et <placeName ref="l2478">Sabaudis</placeName> <lb xml:id="p1z43"/>alias;</foreign> ein gütli<lb xml:id="p1z44"/>cher tag wirt zuͦ <placeName ref="l339">Nüwenburg</placeName> 1. novembris.</s>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro, fratri <lb xml:id="p2z4"/>et compatri meo c<lb xml:id="p2z5"/>harissimo.</s>
					<s n="25" xml:lang="de"><lb xml:id="p2z6"/>Gen <placeName ref="l98">Chur</placeName> h. <persName ref="p8009">Hansen <lb xml:id="p2z7"/>Schmiden</persName>, pfarreren <lb xml:id="p2z8"/>zuͦ S. <lb xml:id="p2z9"/>Martin.</s>
				</p>
			</div>
