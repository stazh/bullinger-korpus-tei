	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuas accepi literas scriptas 27. martii.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><persName>Imperator</persName> foedus iniit cum <lb xml:id="p1z2"/><placeName ref="l2510">Turca</placeName> satis iniquis conditionibus.</s>
					<s n="4" xml:lang="la">De pace inter regem et <placeName ref="l875">Hispanum</placeName> nihil <lb xml:id="p1z3"/>adhuc certi.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Omnia cum <placeName ref="l830">Anglo</placeName> sunt transacta.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Caletum manet in regis possessione; <lb xml:id="p1z4"/>sed quo faciliorem se praebuit rex, eo praefractiores et difficiliores fuerunt <lb xml:id="p1z5"/><placeName ref="l875">Hispani</placeName>.</s>
					<s n="7" xml:lang="la">Eam ob rem, ne rex intercipiatur dolis adversariorum, iussit, <lb xml:id="p1z6"/>ut pro defensione regni sex millia <placeName ref="l862">Helvetiorum</placeName> peterem et aliquot <lb xml:id="p1z7"/>insignia pro <placeName ref="l736">Pedemontio</placeName>.</s>
					<s n="8" xml:lang="la">Principum animi sunt in manu dei, qui <lb xml:id="p1z8"/>novit tumultus maximos convertere in bonum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Illi sit gloria.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z9"/>Nepotum pape iactantur infinita crimina; ipse in hidropisim incidit.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p1z10"/>Uxor te salutat et gratias agit pro sollicitudine, quam sumis de filio.</s>
					<s n="12" xml:lang="la" ana="salute"><lb xml:id="p1z11"/>Salutabis d. d. <persName ref="p8111">Martirem</persName> et <persName ref="p8011">Galterum</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l760">Sol[uturi]</placeName> 2. aprilis.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Tuus <lb xml:id="p1z12"/>ex animo, quem nosti.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Nihil praetermittam, ut hospes <persName>Ciconie</persName> sponsione liberetur [et] <lb xml:id="p1z13"/>solvatur, quod legatus <placeName ref="l825">Danorum</placeName> mutuo accepit.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z14"/>Amplissimo senatui scribam, ubi quid habuero dignum <lb xml:id="p1z15"/>illorum oculis.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Dominus illis benedicat.</s>
				</p>
				<p>
					<s n="19" xml:lang="de"><pb/><lb xml:id="p2z1"/>An herren <persName ref="p495">Heinrichen Bullinger</persName> <lb xml:id="p2z2"/><placeName ref="l587">Zürich</placeName> zuͦ handen.</s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
				</p>
			</div>
		</body>
	</text>
