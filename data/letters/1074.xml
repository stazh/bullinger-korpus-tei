	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuas ad quaestorem et <persName ref="p8389">Hagium</persName> obtuli ipse eis.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Receperunt <lb xml:id="p1z2"/>se hoc negotium per primam quamque occasionem adiuturos, ita <lb xml:id="p1z3"/>ut subinde magis ac magis bene sperem in hac parte.</s>
					<s n="4" xml:lang="la"><persName ref="p8049">Vadiani</persName> <lb xml:id="p1z4"/>literas, Caesaris mandatum per <persName>Artopaeum</persName> missum et instructionem <lb xml:id="p1z5"/>inquisitorum crudelissimam ad te remitto et habeo tibi in<lb xml:id="p1z6"/>gentes gratias.</s>
					<s n="5" xml:lang="la">Literas quoque simul mitto ad d. <persName ref="p8055">Blaurerum</persName> directas, <lb xml:id="p1z7"/>quas ut illi cito mittas oro.</s>
					<s n="6" xml:lang="la">Publica et domestica me premunt <lb xml:id="p1z8"/>negotia, ut plura nunc non possim; sunt enim nundinae hodie <lb xml:id="p1z9"/>frequentes; praeterea heri habuimus nostrae classis synodum, ut sim plus <lb xml:id="p1z10"/>aequo occupatus.</s>
					<s n="7" xml:lang="la">Adhaec dominus familiam meam visitans his <lb xml:id="p1z11"/>diebus ancillulam mihi abripuit, et decumbit iam <persName>Blattnerus</persName> <lb xml:id="p1z12"/>noster, provisor scholę et commensalis meus, de cuius vita adm<lb xml:id="p1z13"/>odum sum sollicitus, cum sit doctus et valde ingenuus, <lb xml:id="p1z14"/>modestae et magnae spei iuvenis.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Reliqua adhuc omnia apud <lb xml:id="p1z15"/>me bene valent.</s>
					<s n="9" xml:lang="la">Pestis invaluit ita, ut hac septimana circiter <lb xml:id="p1z16"/>50 obierint, inter quos etiam cognatus meus <persName ref="p4157">Cosmas Alderinus</persName>, <lb xml:id="p1z17"/>musicus et componista, ut vocant, insignis.</s>
					<s n="10" xml:lang="la">Ita sumus <lb xml:id="p1z18"/>in manu domini; illius fiat voluntas, cui me totum cum meis <lb xml:id="p1z19"/>omnibus consecravi et dedidi.</s>
					<s n="11" xml:lang="la">Tu pro nobis ora dominum et <lb xml:id="p1z20"/>habebis me meosque tibi perpetuo commendatos.</s>
					<s n="12" xml:lang="la">Dominus tuam tuorum<lb xml:id="p1z21"/>que valetudinem tueatur diligenter.</s>
					<s n="13" xml:lang="la" ana="salute">Salutat te mea uxor, <lb xml:id="p1z22"/>d. <persName ref="p8417">Musculus</persName>, d. quaestor, <persName ref="p8389">Hagius</persName>, <persName ref="p3700">Rümlangus</persName> et alii.</s>
					<s n="14" xml:lang="la" ana="salute">Salutabis <lb xml:id="p1z23"/>meo nomine etiam tuos.</s>
					<s n="15" xml:lang="la" ana="farewell">Vale.</s>
					<s n="16" xml:lang="la"><placeName ref="l41">Bernae</placeName> 11. novembris 1550.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z24"/>Tuus <persName ref="p8018">I[oannes] Hallerus</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z25"/><persName>Sultzbergerum</persName>, de quo scribis, non vidi.</s>
					<s n="19" xml:lang="la">Literae mihi a puella <lb xml:id="p1z26"/>quadam <placeName ref="l587">Tigurina</placeName> redditae, quae et ipsa dicit se non videre illum.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, suo colendissimo <lb xml:id="p2z3"/>domino et compatri.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
