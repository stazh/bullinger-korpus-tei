	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>
					<lb xml:id="p1z2"/>Philips vonn gotts gnnadenn hanndtgraue
					<lb xml:id="p1z3"/>zuHessenn grave zuͦ Catennelmpogn etc.
					<lb xml:id="p1z4"/>Unnsernn gnedigenn grußzuvor. wirdiger
					<lb xml:id="p1z5"/>unnd wolgelerter, lieber befonnder
					<lb xml:id="p1z6"/>Dir habenn ewer schreibenn unndern dato
					<lb xml:id="p1z7"/><placeName ref="l587">Zurich</placeName> denn zehendenn suns sampt denn
					<lb xml:id="p1z8"/>darbeygeschicktenn predigenn entpfangen, wollen
					<lb xml:id="p1z9"/>Dieselbgenach der lengte unnd mit vleißch
					<lb xml:id="p1z10"/>verlesenn unnd verstehenns vonn euch
					<lb xml:id="p1z11"/>gnnediglich, thun unns auch solcher eweer
