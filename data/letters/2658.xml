	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>etiamsi nihil sit, quod scribam, nolui tamen comit
					<lb xml:id="p1z2"/>ut vamus ad te rediret tam tertus nuntius.
					<lb xml:id="p1z3"/>hoc possem forsan scribere, qui tibi mittit librum
					<lb xml:id="p1z4"/>tam diu quaesitum frantiscus Bonetus, certo re
					<lb xml:id="p1z5"/>fertVenetos suos sedulos esse nunc in paranda
					<lb xml:id="p1z6"/>augendaque classe multasque naves deduxisse in
					<lb xml:id="p1z7"/>altum, quod Turca id etiam feterit ac favat.
					<lb xml:id="p1z8"/>nec scatur certo, quo sit iturus. Dominus
					<lb xml:id="p1z9"/>Iesus te tuosque conservet doctosque istic omnes.
					<lb xml:id="p1z10"/>Haymius ante hebdomadas aliquot fato fun
					<lb xml:id="p1z11"/>Resalutant te amit, quos suis ons
					<lb xml:id="p1z12"/>praeter Tschernerus tuus (pi commm Pontiselli
					<lb xml:id="p1z13"/>Traversus iunior episcopi hosmaiste. Vale.
					<lb xml:id="p1z14"/>domino. ex Curia die 18. iunii 1555.
					<lb xml:id="p1z15"/>Tuae humanitatis totus e allicius
					<pb/>
					<lb xml:id="p2z1"/>Vere magno viro d.
					<lb xml:id="p2z2"/>Heinrycho Bullingero,
					<lb xml:id="p2z3"/>20 bonis omnibus
					<lb xml:id="p2z4"/>aeternum colendo.
					<lb xml:id="p2z5"/>Zürich.
				</p>
			</div>
		</body>
	</text>
