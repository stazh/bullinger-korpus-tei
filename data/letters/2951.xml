	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Restarent adhuc innumera scribenda, quae iam minus an<lb xml:id="p1z2"/>notare fas est.</s>
					<s n="2" xml:lang="la">Quid hic <placeName ref="l862">Helveticus</placeName> tamen capitaneus <lb xml:id="p1z3"/>quidam tamdiu agat, ex admiratione multis in su<lb xml:id="p1z4"/>spicionem venit.</s>
					<s n="3" xml:lang="la">Dissensio etenim vestratium adhuc popu<lb xml:id="p1z5"/>larium multos nimium fidere suis coeptis facit, veren<lb xml:id="p1z6"/>dumque, ne <placeName ref="l2448">Quinque Pagi</placeName> sceleratorum consiliorum in im<lb xml:id="p1z7"/>perio sint probe conscii, quae tu pro ea, qua es solertia, <lb xml:id="p1z8"/>non imprudenter assequeris.</s>
					<s n="4" xml:lang="la" ana="salute">De <persName>Thoma</persName> nostro <lb xml:id="p1z9"/>plane persuasum habeas acceptissimum eum esse nobis, <lb xml:id="p1z10"/>qui adstans tibi salutem quoque officiosissimam adscribit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>D. <persName ref="p1283">Gesnero</persName> haec quoque communicato, quum integrum tibi visum <lb xml:id="p1z12"/>fuerit, cui propter infinita benemerita honestissimamque <lb xml:id="p1z13"/>mei mentionem iterum atque iterum nullo meo merito factam <lb xml:id="p1z14"/>abunde gratias agam.</s>
					<s n="6" xml:lang="la">Iam me brevitas temporis et festinans <lb xml:id="p1z15"/>celeritas excusat.</s>
					<s n="7" xml:lang="la">Sanctissimum postremo coetum <lb xml:id="p1z16"/>et ecclesiae et scholae vestrae d. parentis mei meoque <lb xml:id="p1z17"/>nomine salutetis perquam officiosissime, obnixe petimus, <lb xml:id="p1z18"/>quos ego non tam veneror quam perpetua et iugi, dum <lb xml:id="p1z19"/>vixero, celebratione, observantia studioque... rendissime colam.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z20"/>Literas tuas d. <persName ref="p3927">Welsero</persName> ad <lb xml:id="p1z23"/>praedium vicinum, ubi agebat et apricabatur a militibus, <lb xml:id="p1z24"/>ilico transmisimus, alteras <persName>Petro</persName> pharmacopolae, <lb xml:id="p1z25"/>qui tuas nobis adtulerat, confestim tradidimus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z26"/>Vale, vir celeberrime, doctrinae pietatisque syncerae <lb xml:id="p1z27"/>columen.</s>
					<s n="10" xml:lang="la"><placeName ref="l18">Augusta Rhetica Vindelicorum</placeName> iunii 22. 1556.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z28"/>Humanitati tuae <lb xml:id="p1z29"/>per <lb xml:id="p1z30"/>omnia devo<lb xml:id="p1z31"/>tus <lb xml:id="p1z32"/><persName ref="p8430">Raphael Seiler</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo divini verbi <lb xml:id="p2z2"/>ministro domino <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, domino et tanquam <lb xml:id="p2z4"/>patri suo syncerissime <lb xml:id="p2z5"/>colendo.</s>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
