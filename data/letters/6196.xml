	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l587">Tigurum</placeName> proficisci decreveram, vir doctissime, atque istic ad tempus vivere, <lb xml:id="p1z2"/>quo et doctorum virorum consuetudine fruerer et, quae ad animae institutionem, <lb xml:id="p1z3"/>quam aliquandiu non ita, ut volui utque decuit, exercere potui, pertinebant, <lb xml:id="p1z4"/>consequerer.</s>
					<s n="2" xml:lang="la">Ad hunc scopum ut minime impium hortatus quoque me est <lb xml:id="p1z5"/><persName ref="p8486">Engelbertus Milander</persName>, amicus meus, imo literis, quibus me vobis commendari <lb xml:id="p1z6"/>satis scio, instruxit.</s>
					<s n="3" xml:lang="la">Verum obstitit conatibus meis amicorum, qui in patriam <lb xml:id="p1z7"/>me ante tres menses revocabant, importunitas aut rerum mearum necessitas <lb xml:id="p1z8"/>potius, quae nullam moram admittit.</s>
					<s n="4" xml:lang="la">Libellum itaque et literas, veluti <lb xml:id="p1z9"/>a domino <persName ref="p8486">Milandro</persName> accepi, ad vos transferri bona (ut spero) fide curavi.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Si in hac <lb xml:id="p1z10"/>re quicquam feci secus, ac debui, non mihi, sed festinationi, quam effugere non <lb xml:id="p1z11"/>licuit, tribuatur velim.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale et has literulas ab ignoto quidem, vestrum tamen <lb xml:id="p1z12"/>studiosissimo profectas boni consule.</s>
					<s n="7" xml:lang="la"><placeName ref="l300">Lucernae</placeName> 16. iulii.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Tuae excellentiae e<lb xml:id="p1z14"/>t praestantiae de[di]tissimus <lb xml:id="p1z15"/><persName ref="p2109">Henricus Menscheverus</persName> <persName ref="p2109">Frisius Groningensis</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Gravitate ac doctrina praestantissim<lb xml:id="p2z2"/>o viro d. <persName ref="p495">Henricho Bullingero</persName> seniori, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> ministro vigilantissimo, <lb xml:id="p2z4"/>domino ac patrono in primis observando etc.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note>Datum: <persName ref="p8486">E. Milander</persName> an HB, 5. Juli 1564, wo HM's Besuch angekündigt wird.</note>
				</p>
			</div>
		</body>
