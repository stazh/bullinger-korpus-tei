	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nisi post abitum <persName ref="p8511">Thretii</persName> literae mihi ab <persName>Evichio</persName> reddi<lb xml:id="p1z2"/>tae fuissent, quas vobis mitti petit, nunc nihil scripsissem, <lb xml:id="p1z3"/>quia nihil est, quod scriptione videatur dignum.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Misit etiam nunc d. <persName ref="p8453">Ursinus</persName> ad me inclusas, in quibus <lb xml:id="p1z5"/>de rebus <placeName ref="l558">Witebergensium</placeName> ad te perscribit.</s>
					<s n="4" xml:lang="la">Inter caetera <lb xml:id="p1z6"/>scribit ad me <persName>Evichius</persName>:</s>
				</p>
				<p>
					<s n="5" xml:lang="la">"Tigurini nostri quoque nihil <lb xml:id="p1z7"/>hisce nundinis praeteritis scripsere, quod equidem sciam; quae <lb xml:id="p1z8"/>res non parum me angit."</s>
					<s n="6" xml:lang="la">Res enim soliciti et plena <lb xml:id="p1z9"/>timoris amor.<note xml:id="fn1" type="footnote" n="1"><hi>Ovid,</hi> Heroides, 1, 12.</note>"</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Praecipue autem me accenderant novorum <lb xml:id="p1z10"/>quorundam commentariorum mentiones et pollicitationes.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/>Quid acciderit, nescio et metuo; nam per bibliopolas nihil <lb xml:id="p1z12"/>adhuc intelligo."</s>
					<s n="9" xml:lang="la">Item: "Apud nos parum est, quod tibi <lb xml:id="p1z13"/>gratum auditu fuerit, nisi quod concordia religionis pene <lb xml:id="p1z14"/>nobis modo sit integra, etsi nondum, quam debuit, fructuosa."</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/>Haec festinanter scribere libuit, ut me usque vestri <lb xml:id="p1z16"/>memorem esse videatis.</s>
					<s n="11" xml:lang="la" ana="farewell">In Christo domino <lb xml:id="p1z17"/>nostro felicissime valete.</s>
					<s n="12" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p8075">Thomas Erastus</persName>, <lb xml:id="p1z19"/>totus tuus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori primario, <lb xml:id="p2z4"/>domino suo instar patris honorando.</s>
				</p>
			</div>
		</body>
	</text>
