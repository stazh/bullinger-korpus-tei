	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S<lb xml:id="p1z2"/>i q<lb xml:id="p1z3"/>uid <lb xml:id="p1z4"/>aliud possemus, puderet nos gratias et nihil quam <lb xml:id="p1z5"/>gratias agere, cum tua in nos beneficia crebra <lb xml:id="p1z6"/>et ampla postulent ut re praestemus, quicquid <lb xml:id="p1z7"/>verbis promittere possumus.</s>
					<s n="2" xml:lang="la">Sed quando animo nostro <lb xml:id="p1z8"/>multo angustiores contigerunt facultates, id agimus, <lb xml:id="p1z9"/>ne nihil agamus, quod omnes agunt; tametsi aliquanto <lb xml:id="p1z10"/>sincerius nimirum gratiam habemus quan<lb xml:id="p1z11"/>tam possumus maximam ob singularem human<lb xml:id="p1z12"/>itatem, quam erga nos cum alias tum in di<lb xml:id="p1z13"/>gressu nostro exhibuisti.</s>
					<s n="3" xml:lang="la">Iter habuimus <placeName ref="l41">Ber<lb xml:id="p1z14"/>nam</placeName> usque amoenum satis, nisi quod tui interdum <lb xml:id="p1z15"/>desiderium, hominis nobis longe carissimi, male <lb xml:id="p1z16"/>torquebat.</s>
					<s n="4" xml:lang="la">Illi, quibus nos literis amice scriptis <lb xml:id="p1z17"/>commendasti, nos plus quam humanissime <lb xml:id="p1z18"/>tractaverunt: cujus benignitatis magnam <lb xml:id="p1z19"/>partem tibi referimus acceptam; qui non satis <lb xml:id="p1z20"/>habuisti, ut nos ipse humaniter tractares, <lb xml:id="p1z21"/>nisi etiam efficeres ut idem in nos ab <lb xml:id="p1z22"/>aliis fieret.</s>
					<s n="5" xml:lang="la">Quanta haec tua sit hum<lb xml:id="p1z23"/>anitas, agnoscimus; nosque propterea tuos esse <lb xml:id="p1z24"/>totos fatemur, dum nostri esse poterimus.</s>
					<s n="6" xml:lang="la">Quod <lb xml:id="p1z25"/>hic tuis promeritis rependamus nihil est: <lb xml:id="p1z26"/>quae in <placeName ref="l830">Anglia</placeName> habemus, omnia tam tua <lb xml:id="p1z27"/>esse puta quam quae sunt maxime tua<lb xml:id="p1z28"/>.</s>
					<s n="7" xml:lang="la" ana="salute"><lb xml:id="p1z30"/>D. <persName ref="p1753">Leonem Judam</persName>, D. <persName ref="p8127">Pellicanum</persName>, <lb xml:id="p1z31"/>illudque <placeName ref="l862">Helvetiae</placeName>, im<lb xml:id="p1z32"/>o totius orbis, eximium decus, <persName ref="p8171">Theodorum Bibliandrum</persName>, nostris verbis <lb xml:id="p1z33"/>diligenter salutare non gravaberis speramus; <lb xml:id="p1z34"/>quorum humanitatem pariter et <lb xml:id="p1z35"/>raram eruditionem ita suspicimus, ut nobis <lb xml:id="p1z36"/>excidero nunquam simus passuri.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z37"/>Vale, nobis multis <lb xml:id="p1z38"/>nominibus carissime D. <lb xml:id="p1z39"/><persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eruditissimo viro suoque <lb xml:id="p2z2"/>observando praeceptori, D. <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bullingero</persName>, dentur has liter<lb xml:id="p2z4"/>as.</s>
				</p>
			</div>
		</body>
