	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quod rarius ad te scribo, <persName ref="p8055">Ambrosii</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8055">Ambrosius Blarer</persName>.</note> literae <lb xml:id="p1z2"/>in causa sunt; nam ille iam etiam meo loco <lb xml:id="p1z3"/>officio scribendi fungitur, qui potest illi <lb xml:id="p1z4"/>et copiose et eleganter satisfacere.</s>
					<s n="3" xml:lang="la">Itaque <lb xml:id="p1z5"/>silentium meum bene vertas, quod nullo <lb xml:id="p1z6"/>fastidio nec ulla tui oblivione nascitur; <lb xml:id="p1z7"/>in oculis enim meis semper talis es, <lb xml:id="p1z8"/>quales sunt amantissimi.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="salute">Vale <lb xml:id="p1z9"/>et <persName ref="p8051">uxorem tuam</persName><note xml:id="fn2" type="footnote" ana="bio" n="2"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> totamque domum saluta <lb xml:id="p1z10"/>nomine meo<note xml:id="fna" type="footnote" n="a"><hi>In der Vorlage</hi> me.</note> studiosissime.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Quam me etiamnum affligat obitus <persName ref="p1753">Leonis</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p1753">Leo Jud</persName>, der am 19. Juni verstorben war, vgl. oben <ref target="file11681">Nr. 1638</ref>.</note>, <lb xml:id="p1z12"/>non possum ulla ratione explicare.</s>
					<s n="6" xml:lang="la">Dominus <lb xml:id="p1z13"/>nos consoletur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ex <placeName ref="l257">Constantia</placeName>, <lb xml:id="p1z14"/>9. augusti 1542.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Tuus <persName ref="p4079">Io. <lb xml:id="p1z16"/>Zvick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro <lb xml:id="p2z2"/>d. <persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> ad<lb xml:id="p2z4"/>ministro, suo in domino <lb xml:id="p2z5"/>dilectissimo fratri.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
