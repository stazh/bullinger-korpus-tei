	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Dominus benedicat balneo tuo et te tuamque fa<lb xml:id="p1z2"/>miliam servet ab omni malo.</s>
					<s n="2" xml:lang="la">Literas a <persName>Lyn<lb xml:id="p1z3"/>ero</persName> nostro acceptas mitto, ita et vidua <persName>Buttleri</persName>, <lb xml:id="p1z4"/>ut ex his, quid facto opus sit, dispicias.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Non placet, quod imprudens iuvenis negotium <lb xml:id="p1z6"/>suum mox ab eo auspicatus est, quod summum ei <lb xml:id="p1z7"/>conciliavit etiam apud consanguineos et affines <lb xml:id="p1z8"/>odium.</s>
					<s n="4" xml:lang="la">Aliud ei suggesseram consilium.</s>
					<s n="5" xml:lang="la">Praeterea <lb xml:id="p1z9"/>certum est mirificum illum <persName>Zviccium</persName> noluisse <lb xml:id="p1z10"/>de nuptiis tantillum audire conciliandis, nisi <lb xml:id="p1z11"/>prius patrimonium suum in <placeName ref="l822">Germaniam</placeName> tran(s)<lb xml:id="p1z12"/>tulisset.</s>
					<s n="6" xml:lang="la">Certum est illud quoque pium <persName ref="p506">Buttleru<lb xml:id="p1z13"/>m</persName> <lb xml:id="p1z14"/>religionis ergo ad nos initio migrasse anno 1536.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Dubito, quid hac in causa possit scribi et agi <lb xml:id="p1z16"/>amplius.</s>
					<s n="8" xml:lang="la">Literas viduae tibi servat, quo ex<lb xml:id="p1z17"/>peditius agas, quae acturus es; <persName>Lyneri</persName> <lb xml:id="p1z18"/>saltem ad me remittito.</s>
					<s n="9" xml:lang="la">Ego plane nullam <lb xml:id="p1z19"/>fidem adhibeo <placeName>Anglogallicis</placeName> nuptiis, saltem propt<lb xml:id="p1z20"/>er coronationem tam properam adiunctam; <lb xml:id="p1z21"/>certe, si reduceretur in <placeName ref="l830">Angliam</placeName> papismus, <lb xml:id="p1z22"/>periisset regnum illud.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Dominus meliora conceda<lb xml:id="p1z23"/>t.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Recte valemus omnes dei gratia; <lb xml:id="p1z24"/>utinam tu quoque cum tuis valeas.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z25"/>2. augusti mane 1571.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Dilecto meo affini <lb xml:id="p2z2"/>d. <persName ref="p8011">Rodolpho Gvalthero</persName>.</s>
					<s n="15" xml:lang="de"><lb xml:id="p2z3"/><placeName ref="l515">Urdorfii</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
