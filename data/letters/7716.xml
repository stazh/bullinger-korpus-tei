	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Mi pater, scio, quam avide meas expectes; eo magis <lb xml:id="p1z2"/>rogo, ut ignoscas, quod tam paucis scribam, nihil enim <lb xml:id="p1z3"/>habeo novi, quod satis certum sit, nisi quod ex <placeName ref="l830">Anglia</placeName> <lb xml:id="p1z4"/>refertur <placeName ref="l2524">Scoticam</placeName> illam reginam in <placeName ref="l296">Londinensem</placeName> <lb xml:id="p1z5"/>tu<lb xml:id="p1z6"/>rrim esse compactam, ut caesi mariti <lb xml:id="p1z7"/>damnatam; <lb xml:id="p1z8"/>convenisse inter utrumque regnum, ut <persName ref="p18554">regina Angliae</persName> puero <lb xml:id="p1z9"/>regi et ipse vicissim reginae deficientibus alterius <lb xml:id="p1z10"/>liberis succedat, ipsa interim sit eius tutrix eumqu<lb xml:id="p1z11"/>e habeat in potestate regie educandum.</s>
					<s n="2" xml:lang="la"><placeName ref="l2524">Scotia</placeName> <lb xml:id="p1z12"/>interea a Morensi duce, quem milardum <persName>Iacobum</persName> <lb xml:id="p1z13"/>vocant, ex <placeName ref="l2524">Scotiae</placeName> parlamenti auctoritate delectum, <lb xml:id="p1z14"/>administretur.</s>
					<s n="3" xml:lang="la">Si hoc ita est, ut affirmatur <lb xml:id="p1z15"/>ipsis adversariis, non potuit melius illi insulae <lb xml:id="p1z16"/>caveri, et maximum inde bonum spero.</s>
					<s n="4" xml:lang="la"><persName>Condensem</persName> <lb xml:id="p1z17"/>narrant fudisse Andegavensis exercitum omnibus <lb xml:id="p1z18"/>eius impedimentis captis et maxima, ut aiunt, <lb xml:id="p1z19"/>praeda recepta.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Addunt vestros <placeName>Cares</placeName> admodum <lb xml:id="p1z20"/>duriter habitos.</s>
					<s n="6" xml:lang="la">Cur aliquid istorum esse credam, <lb xml:id="p1z21"/>eo adducor, quod hostes quam severissime <lb xml:id="p1z22"/>prohibent, ne quid nuntietur; sed tamen haec ut <lb xml:id="p1z23"/>non satis certa scribo.</s>
					<s n="7" xml:lang="la">Aurantium aiunt obsidere <lb xml:id="p1z24"/><placeName>Remos</placeName>, quod et ipsum incertum est.</s>
					<s n="8" xml:lang="la"><placeName>Bipontinus</placeName> <lb xml:id="p1z25"/>ante biduum lustravit exercitum <lb xml:id="p1z26"/>in finibus <placeName ref="l691">Lotharingiae</placeName>, si promissis <lb xml:id="p1z27"/>stetit, nempe equites 7500, pedites 16000 <lb xml:id="p1z28"/>cum tormentis triginta; his se adiungunt <lb xml:id="p1z32"/>equites multi ex <lb xml:id="p1z33"/><placeName ref="l832">Gallis</placeName>, qui <placeName ref="l491">Argentinam</placeName> et <placeName ref="l327">Mompelgardum</placeName> <lb xml:id="p1z34"/>se contulerant, ad quos ex his etiam regionibus <lb xml:id="p1z35"/>multi concurrunt.</s>
					<s n="9" xml:lang="la">Dominus tam miseri nunc <lb xml:id="p1z36"/>regni misereatur et det non in equis neque <lb xml:id="p1z37"/>in filiis hominum, sed in ipso confidere.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z38"/>Fratres communes istuc literas scribent, <lb xml:id="p1z39"/>quas una cum his accipies.</s>
					<s n="11" xml:lang="la">Negotium ipsum minime <lb xml:id="p1z40"/>opus est ut tibi vel fratribus commendem, quibus <lb xml:id="p1z41"/>abunde curae sunt, quae tam bona et sancta sunt, <lb xml:id="p1z42"/>adde etiam tam necessaria; nam vix credas, <lb xml:id="p1z43"/>quam multi et quidem miserrimi et egentissimi huc <lb xml:id="p1z44"/>confluant.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Hospitia adhuc satis multa, quam <lb xml:id="p1z45"/>perangusta, habemus; sed victu et vestitu opus <lb xml:id="p1z46"/>est; de his demum laboramus vehementer.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z47"/>Bene vale, mi pater, cum toto fratrum collegio.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z48"/>D. Iesus vos servet vestrisque laboribus magis <lb xml:id="p1z49"/>ac magis benedicat.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l167">Genevae</placeName> 27. decembris <lb xml:id="p1z50"/>1568.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z51"/>Tuus <persName ref="p8033">Beza</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio Iesu Christi s<lb xml:id="p2z2"/>ervo d. <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bullingero</persName>, patri <lb xml:id="p2z4"/>plurimum observando <lb xml:id="p2z5"/>et <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z6"/>vere fido pastori.</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l587">Tiguri</placeName><lb xml:id="p2z13"/>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>