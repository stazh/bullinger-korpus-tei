	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Der Empfänger steht zweifelsfrei fest; vgl. z. B. die Bezugnahme auf <persName ref="p467" cert="high">Bucers</persName> "Retraktationen", unten Z. 24f.</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a deo patre per dominum Iesum <lb xml:id="p1z2"/>Christum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Scripseram, quas hic vides prolixiores <lb xml:id="p1z3"/>literas<note xml:id="fn2" type="footnote" n="2">Oben <ref target="file11096">Nr. 1053</ref>.</note>, priusquam tuas a <placeName ref="l28">Basilea</placeName><note xml:id="fnb" type="footnote" n="b"><hi>E:</hi> <placeName ref="l28">Basilaea</placeName>.</note> scriptas<note xml:id="fn3" type="footnote" n="3">Nicht erhalten.</note> recepissem.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Cum enim scriptae essent a te<note xml:id="fnc" type="footnote" n="c"><hi>E:</hi> Scriptae enim cum essent.</note> 2. octobris, ad 14. demum <lb xml:id="p1z5"/>eiusdem<note xml:id="fnd" type="footnote" n="d"><hi>E:</hi> eius.</note> mensis reddebantur.</s>
					<s n="4" xml:lang="la">Cernens autem <lb xml:id="p1z6"/>illa in his<note xml:id="fne" type="footnote" n="e"><hi>E:</hi> in his illa.</note>, quae scripsisti de <persName ref="p1039">Benedicto Euandro</persName>, <lb xml:id="p1z7"/>nihil volui in meis 6. octobris scriptis mutar<lb xml:id="p1z8"/>e<note xml:id="fnf" type="footnote" n="f"><hi>E:</hi> nihil volui mutare in meis 6. octobris scriptis.</note><note xml:id="fn4" type="footnote" n="4">Vgl. oben <ref target="file11096">Nr. 1053</ref>, 2-57.</note>.</s>
					<s n="5" xml:lang="la">Audio<note xml:id="fng" type="footnote" n="g"><hi>E:</hi> Et audio quidem.</note> illum negare et pernegare<note xml:id="fnh" type="footnote" n="h"><hi>E:</hi> pernegareque.</note>, quod <lb xml:id="p1z9"/>tuas furtim subtraxerit cuiquam.</s>
					<s n="6" xml:lang="la">Certe mihi <lb xml:id="p1z10"/>videris, frater in domino colende<note xml:id="fni" type="footnote" n="i"><hi>E:</hi> frater charissime.</note>, nimium non mali hominis <lb xml:id="p1z11"/>causam exaggerare<note xml:id="fnk" type="footnote" n="k"><hi>Randbemerkung von <persName ref="p467">Bucers</persName> Hand:</hi> Pernegat furto sustulisse; nimium exageras.</note>.</s>
					<s n="7" xml:lang="la">Esto enim, quod furto illas <lb xml:id="p1z12"/>subduxerit; an ideo capitali sententia<note xml:id="fnl" type="footnote" n="l"><hi>E:</hi> supplitio.</note> subiacebit<note xml:id="fn5" type="footnote" n="5"><persName ref="p467">Bucer</persName> hatte in seinem verlorenen Brief darauf angespielt, daß Theodosius wegen eines ähnlichen Vergehens ein Todesurteil verhängt habe. In seiner Antwort an <persName ref="p495">Bullinger</persName> vom 25. Februar 1538 kommt er nochmals darauf zu sprechen; s. Zürich StA, E II 347, 91; vgl. Hieronymus, Epist. 57, 3, 2 (<bibl source="b170">CSEL</bibl> LIV 506, 8-11).</note>?</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Cum tamen<note xml:id="fnm" type="footnote" n="m">tamen <hi>fehlt in E.</hi></note> illas non miserit hostibus<note xml:id="fnn" type="footnote" n="n"><hi>E:</hi> non hostibus miserit.</note>, sed amicis <lb xml:id="p1z14"/>et tuis et suis, nec illas quidem pravo animo mi<lb xml:id="p1z15"/>serit, quo tibi incommodaret.</s>
					<s n="9" xml:lang="la">Iterum ergo te oramus<note xml:id="fno" type="footnote" n="o"><hi>E:</hi> oramus te.</note>, <lb xml:id="p1z16"/>ut conceptam iram<note xml:id="fnp" type="footnote" n="p"><hi>E:</hi> conceptam illam iram.</note> remittas<note xml:id="fnq" type="footnote" n="q"><hi>Randbemerkung von <persName ref="p467">Bucers</persName> Hand:</hi> remisi; sed quantum, oro, incommodavit[?] vos; ne[?] defenderis tale factum.</note>.</s>
					<s n="10" xml:lang="la">Iam <lb xml:id="p1z17"/>ut negare non possumus, quod te de literis ad doctorem <persName ref="p1974">Lutherum</persName> script<lb xml:id="p1z18"/>is<note xml:id="fnr" type="footnote" n="r"><hi>E:</hi> illis <hi>anstelle von</hi> ad doctorem <persName ref="p1974">Lutherum</persName> scriptis.</note> ne verbo quidem admonuerimus, ita infitias ire non <lb xml:id="p1z19"/>debemus<note xml:id="fns" type="footnote" n="s"><hi>E:</hi> ita non eo infitias.</note> misisse me tuas aliis quoque fratribus.</s>
					<s n="11" xml:lang="la">Ad <lb xml:id="p1z20"/>omnes enim verbi ministros, qui <placeName ref="l28">Basileae</placeName><note xml:id="fnt" type="footnote" n="t"><hi>E:</hi> <placeName ref="l28">Basilaeae</placeName>.</note> fuerant<note xml:id="fn6" type="footnote" n="6">d. h. die Theologen, die an den Konkordienverhandlungen des Vorjahres in <placeName ref="l28">Basel</placeName> teilgenommen hatten.</note>, <lb xml:id="p1z21"/>videbatur illud negotium pertinere<note xml:id="fnu" type="footnote" n="u"><hi>E:</hi> videbatur spectare causa.</note>.</s>
					<s n="12" xml:lang="la">Hic autem nihil egi <lb xml:id="p1z22"/>vel gladiatorio vel delatorio animo.</s>
					<s n="13" xml:lang="la">Deus est mihi <lb xml:id="p1z23"/>testis.</s>
					<s n="14" xml:lang="la">Pacem, non turbas quaesivi, utut alii <lb xml:id="p1z24"/>hoc meum factum<note xml:id="fnv" type="footnote" n="v"><hi>E:</hi> factum meum.</note> exponant.</s>
					<s n="15" xml:lang="la">Sed de his quaedam <lb xml:id="p1z25"/>alias<note xml:id="fnw" type="footnote" n="w"><hi>E:</hi> quaedam ad te alias.</note> dedi.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb type="edition" next="282"/>Quid autem desiderem <lb xml:id="p1z26"/>in literis illis tuis ad doctorem <persName ref="p1974">Lutherum</persName> scriptis, <lb xml:id="p1z27"/>quibus tu nihil messe putas, quod non ultro <lb xml:id="p1z28"/>citroque inter nos dictum et actum sit, brevibus <lb xml:id="p1z29"/>in aliis meis literis<note xml:id="fnx" type="footnote" n="x"><hi>E:</hi> in alia illa epistola mea.</note> exposui<note xml:id="fn7" type="footnote" n="7">Siehe oben <ref target="file11096">Nr. 1053</ref>, 58-206.</note>.</s>
					<s n="17" xml:lang="la">Interim vero <lb xml:id="p1z30"/>ingratus esse nolo.</s>
					<s n="18" xml:lang="la">Quod enim meas attinet <lb xml:id="p1z31"/>partes et quod de meis<note xml:id="fny" type="footnote" n="y"><hi>E:</hi> de meis facultatibus.</note> polliceri <lb xml:id="p1z32"/>possum, senties non ingratum hominem<note xml:id="fnz" type="footnote" n="z"><hi>Randbemerkung von <persName ref="p467">Bucers</persName> Hand:</hi> Ingrati erga me.</note>, sicubi mod<lb xml:id="p1z33"/>o occasionem nactus fuero<note xml:id="fnaa" type="footnote" n="aa"><hi>E:</hi> sicubi nactus fuero occasionem.</note> de te tuisque laboribus et <lb xml:id="p1z34"/>de tuo in me favore<note xml:id="fnab" type="footnote" n="ab"><hi>E:</hi> ac tua in me benevolentia <hi>anstelle von</hi> et de tuo in me favore.</note> benemerendi.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z35"/>De Retractationibus tuis qui<note xml:id="fnac" type="footnote" n="ac"><hi>E:</hi> quia.</note> coram quaedam <lb xml:id="p1z36"/><placeName ref="l28">Basileae</placeName><note xml:id="fnad" type="footnote" n="ad"><hi>E:</hi> <placeName ref="l28">Basilaeae</placeName>.</note> suggessi<note xml:id="fn8" type="footnote" n="8">Vgl. oben <ref target="file10986">Nr. 944</ref>, 5f mit Anm. 5.</note>, nunc dicam nihil<note xml:id="fnae" type="footnote" n="ae"><hi>E:</hi> nihil dicam.</note>.</s>
					<s n="20" xml:lang="la">Et de libro<note xml:id="fnaf" type="footnote" n="af"><hi>E:</hi> libello.</note> <lb xml:id="p1z37"/>tuo Ad <placeName ref="l1097">Monasterienses</placeName> deque mea ad te de isto<note xml:id="fnag" type="footnote" n="ag"><hi>E:</hi> illo.</note> e<lb xml:id="p1z38"/>pistola, rursus de epistolis <persName ref="p4091">Zvinglii</persName> et <persName ref="p2442">Oecolampadi<lb xml:id="p1z39"/>i</persName> vulgatis<note xml:id="fnah" type="footnote" n="ah"><hi>E:</hi> item de <persName ref="p4091">Zvinglii</persName> et <persName ref="p2442">Oecolampadii</persName> epistolarum aeditione.</note>, quorum omnium in tua <lb xml:id="p1z40"/>illa epistola obiter meministi<note xml:id="fnai" type="footnote" n="ai"><hi>E:</hi> in tua meministi epistola obiter quidem.</note>, ego paucis <lb xml:id="p1z41"/>quoque in superioribus literis respondi<note xml:id="fnak" type="footnote" n="ak"><hi>E:</hi> quid a te postulem, perstrinxi <hi>anstelle von</hi> in superioribus literis respondi.</note><note xml:id="fn9" type="footnote" n="9">Siehe oben <ref target="file11096">Nr. 1053</ref>, 235-306.</note>.</s>
					<s n="21" xml:lang="la">Quod <lb xml:id="p1z42"/>autem postremo hortaris, ut studeamus<note xml:id="fnal" type="footnote" n="al"><hi>E:</hi> studeamus omnes.</note> <lb xml:id="p1z43"/>ea, quae charitatis sunt, praestare invicem, <pb/><lb xml:id="p2z1"/>donec dominus dederit idem sentire, iudicare <lb xml:id="p2z2"/>et loqui omnes<note xml:id="fnam" type="footnote" n="am">omnes <hi>fehlt in E.</hi></note> in omnibus, si forte in praesenti<note xml:id="fnan" type="footnote" n="an"><hi>E:</hi> nunc.</note> quaedam <lb xml:id="p2z3"/>non omnino perspiciamus, recte<note xml:id="fnao" type="footnote" n="ao"><hi>E:</hi> bene.</note> profecto suades, <lb xml:id="p2z4"/>et hoc tibi hac in re pollicere de nobis, quod <lb xml:id="p2z5"/>de hominibus charitatem dei colentibus<note xml:id="fnap" type="footnote" n="ap"><hi>Randbemerkung von <persName ref="p467">Bucers</persName> Hand:</hi> Certe male praestatur.</note>.</s>
					<s n="22" xml:lang="la">Pro<lb xml:id="p2z6"/>inde nec illa praesentia nec alia, quae ad te <lb xml:id="p2z7"/>scribimus, ita intelliges, quasi te irritare aut <lb xml:id="p2z8"/>ista ratione novam discordiae telam cupiamu<lb xml:id="p2z9"/>s ordiri<note xml:id="fnaq" type="footnote" n="aq"><hi>Randbemerkung von <persName ref="p467">Bucers</persName> Hand:</hi> nolunt novam discordiam exercere, ita intelligo.</note>, sed ut expectorata omni simultate <lb xml:id="p2z10"/>libere, quod decet fratres<note xml:id="fnar" type="footnote" n="ar"><hi>E:</hi> fratres decet.</note>, agamus cum fratre<note xml:id="fnas" type="footnote" n="as"><hi>E:</hi> cum fratre agamus.</note>.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">De <lb xml:id="p2z11"/>ecclesiis <placeName ref="l572">Wirtembergicis</placeName> et <persName ref="p6469">Schneppffio</persName> non <lb xml:id="p2z12"/>est, quod conquerar<note xml:id="fnat" type="footnote" n="at"><hi>E:</hi> conquaerar.</note> amplius.</s>
					<s n="24" xml:lang="la">Audio enim <lb xml:id="p2z13"/><persName ref="p9708">principis</persName><note xml:id="fn10" type="footnote" n="10">Herzog <persName ref="p9708">Ulrich von Württemberg</persName>.</note> pietate factum esse, ut omnia migrarint <lb xml:id="p2z14"/>e templis dei et divorum idola.</s>
					<s n="25" xml:lang="la">Interim ver<lb xml:id="p2z15"/>o<note xml:id="fnau" type="footnote" n="au">vero <hi>fehlt in E.</hi></note> nescire<note xml:id="fnav" type="footnote" n="av">nescire <hi>für ein gestrichenes, unlesbares Wort am Rande nachgetragen.</hi></note> non potes, quid 16. septembris actum s<lb xml:id="p2z16"/>it <placeName ref="l514">Urachiae</placeName><note xml:id="fnaw" type="footnote" n="aw"><hi>E:</hi> quid actum sit Urachiae 16. septembris.</note><note xml:id="fn11" type="footnote" n="11"><persName ref="p495">Bullinger</persName> war durch <persName ref="p4079">Johannes Zwick</persName> über den <placeName ref="l514">Uracher</placeName> "Götzentag" vom 10. September unterrichtet worden, allerdings mit irrtümlicher Datumsangabe; s. oben <ref target="file11089">Nr. 1046</ref>.</note>.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><pb type="edition" next="283"/>Fac autem, obsecro, quod te facturum <lb xml:id="p2z17"/>polliceris: Commenda doctori<note xml:id="fnax" type="footnote" n="ax">doctori <hi>fehlt in E.</hi></note> <persName ref="p1974">Luthero</persName> et suis nos<lb xml:id="p2z18"/>tram fidem et sedulitatem in regno Christi<note xml:id="fnay" type="footnote" n="ay"><hi>Randbemerkung von <persName ref="p467">Bucers</persName> Hand:</hi> Commendo <persName ref="p1974">Luthero</persName> semper quam possim.</note>.</s>
					<s n="27" xml:lang="la"><lb xml:id="p2z19"/>Nam auxiliante deo ita nos geremus<note xml:id="fnaz" type="footnote" n="az"><hi>E:</hi> Nam ita geremus nos auxiliante domino.</note>, ut tuae <lb xml:id="p2z20"/>commendationis poeniteat nunquam<note xml:id="fnba" type="footnote" n="ba"><hi>E:</hi> poenitere non possit.</note>.</s>
				</p>
				<p>
					<s n="28" xml:lang="la" ana="farewell">Bene vale <lb xml:id="p2z21"/>et ora pro nobis dominum.</s>
				</p>
				<p>
					<s n="29" xml:lang="la">15. octobris 1537.</s>
				</p>
				<p>
					<s n="30" xml:lang="la" ana="salute"><lb xml:id="p2z22"/>Salutant te fratres<note xml:id="fnbb" type="footnote" n="bb">Salutant te fratres <hi>fehlt in E.</hi></note>.</s>
				</p>
				<p>
					<s n="31" xml:lang="la"><lb xml:id="p2z23"/><persName ref="p495">H. Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Ohne Adresse.]</note>
				</p>
			</div>
		</body>
