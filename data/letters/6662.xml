	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tametsi non constet amicitia literarum officio, foveri tamen scio valdeque delectari <lb xml:id="p1z2"/>literis et colloquio mutuo, eoque gravius mihi est tres, quas a discessu filii nostri <lb xml:id="p1z3"/>abs te scripsi, interceptas aut perditas fuisse.</s>
					<s n="3" xml:lang="la">Sed me abs te amari habeo <lb xml:id="p1z4"/>persuasissimum nec etiam te dubitare de promptissima mea in te voluntate, quam <lb xml:id="p1z5"/>semper poteris experiri.</s>
					<s n="4" xml:lang="la">Gratias ago, ut antea egi, de tuo munere, quod tamen <lb xml:id="p1z6"/>per aurigarum negligentiam nondum recepi.</s>
					<s n="5" xml:lang="la">Dominus <persName ref="p8011">Galtherus</persName> curabit, ut <lb xml:id="p1z7"/>sarcinula tandem mittatur.</s>
					<s n="6" xml:lang="la">Molestum porro fuit audire filiarum mortem; <lb xml:id="p1z8"/>sed contra huiusmodi certamina instructissimus es sciens, quis depositum repetiit, <lb xml:id="p1z9"/>ferendumque esse, quicquid imponit oneris, dum peregrinamur hoc in deserto <lb xml:id="p1z10"/>expectantes meliora hospitia.</s>
					<s n="7" xml:lang="la">De rebus nostris e <placeName ref="l301">Lugduno</placeName> certiora potes <lb xml:id="p1z11"/>intelligere, quam scribere possim.</s>
					<s n="8" xml:lang="la" ana="salute">Salutat te plurimum uxor.</s>
					<s n="9" xml:lang="la" ana="salute">Salutabis <lb xml:id="p1z12"/>amplissimum senatum et amicos omnes.</s>
					<s n="10" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="11" xml:lang="la"><placeName ref="l378">Parisiis</placeName> 27. ianuarii <lb xml:id="p1z13"/>1566.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z14"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tigurine</placeName> ecclesie pastori fido.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
					<s n="15" xml:lang="de"><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
