			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Studiosi hi <placeName>Borussi</placeName>, <placeName ref="l2472">Poloni</placeName>, <placeName ref="l859">Russi</placeName> et <lb xml:id="p1z2"/><placeName ref="l841">Lituani</placeName> veniunt <placeName ref="l512">Tubinga</placeName> ad me; petiverunt <lb xml:id="p1z3"/>a me literas ad te, frater, ut per ipsas ad te pos<lb xml:id="p1z4"/>sint accedere; cupiunt enim colloqui.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Ex colloquio <lb xml:id="p1z5"/>autem, quod mecum habuerunt, intellexi se<lb xml:id="p1z6"/>niorem <placeName ref="l841">Lituanum</placeName>, qui iuniorum paedagogus est, <lb xml:id="p1z7"/>eximie <persName ref="p458">Brentianum</persName> esse; libenter enim disputat <lb xml:id="p1z8"/>de loco et motu in coelo beatorum, et de <lb xml:id="p1z9"/>substantiali praesentia et manducatione corporis <lb xml:id="p1z12"/>Christi in coena.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Quidam <lb xml:id="p1z13"/><placeName ref="l512">Tubinga</placeName> veniens affirmavit mihi <persName ref="p458">Brentium</persName> adornare <lb xml:id="p1z14"/>scriptum contra me novum et acerbum valde.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Suspicor <persName>Lituanum</persName> illum aliquid venari, si <lb xml:id="p1z16"/>forte deprehendat dissimilitudinem aliquam <lb xml:id="p1z17"/>inter nos sententiarum de coelo et dextera <lb xml:id="p1z18"/>dei; scis enim, quale sit <persName ref="p458">Brentii</persName> dogma de <lb xml:id="p1z19"/>ubiquitate corporis Christi, coeli et dexterae <lb xml:id="p1z20"/>dei.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Verum non est, quod hic te admoneam alio<lb xml:id="p1z21"/>qui prudentem per dei gratiam satis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Dominus <lb xml:id="p1z22"/>restituat te nobis, chare frater; magno cum <lb xml:id="p1z23"/>dolore audimus te aegrotare.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Dominum ergo pro sa<lb xml:id="p1z24"/>lute tua oramus assidue.</s>
					<s n="9" xml:lang="la">Brevior sum, ne <lb xml:id="p1z25"/>molestiam addam aegritudini.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Optime vale <lb xml:id="p1z26"/>et nos omnes amare perge.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Omnes nostri te ex <lb xml:id="p1z27"/>animo salutant.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 31. maii 1563.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z28"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p540">Ioanni <lb xml:id="p2z2"/>Calvino</persName>, <placeName ref="l167">Genevensis</placeName> <lb xml:id="p2z3"/>ecclesiae fidelissimo pastori, <lb xml:id="p2z4"/>domino meo colendo et <lb xml:id="p2z5"/>fratri charissimo <lb xml:id="p2z6"/><placeName ref="l167">Genff</placeName> <lb xml:id="p2z7"/>vel dentur d. <persName ref="p8033">Theodoro <lb xml:id="p2z8"/>Bezae</persName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>