	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">De rebus meis, compater in domino charissime, <lb xml:id="p1z2"/>non est ut scribam in praesenti, nisi quod iam <lb xml:id="p1z3"/>tandem, ubi Commentarios meos in Psalmum <lb xml:id="p1z4"/>Davidis senatui nostro dicatos obtulero, visurus <lb xml:id="p1z5"/>sum, possimne in posterum commodius ac <lb xml:id="p1z6"/>tolerabilius hic aucto stipendio hęrere vel, <lb xml:id="p1z7"/>si nulla accesserit auctio, alias necesse sit con<lb xml:id="p1z8"/>stituendarum rerum mearum inire rationes.</s>
					<s n="3" xml:lang="la">Neque <lb xml:id="p1z9"/>etiam video, quid postea sperari debeat, si <lb xml:id="p1z10"/>hac occasione amici nihil impetraverint.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z11"/>Domus mea est adhuc per gratiam domini tranquilla, <lb xml:id="p1z12"/>nisi quod uxor subinde molestius cum utero, <lb xml:id="p1z13"/>quem gravem gestat, conflictatur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z14"/>Hodie literas e <placeName ref="l558">Witemberga</placeName> accepi datas 10. ianuarii, <lb xml:id="p1z15"/>in quibus tamen de afflictione <placeName ref="l303">Magdeburgensium</placeName> <lb xml:id="p1z16"/>ne gry quidem scribitur.</s>
					<s n="6" xml:lang="la">Scribit ad me <lb xml:id="p1z17"/><persName>Mathias quidam Orbazius</persName> <placeName ref="l882">Ungarus</placeName>, anno 48. <lb xml:id="p1z18"/>in comitiis <placeName ref="l18">Augustanis</placeName> adhuc sacellanus <persName ref="p18477">Ferdin<lb xml:id="p1z19"/>andi</persName> regis, nunc <placeName ref="l558">Witenbergae</placeName> sacrarum literarum <lb xml:id="p1z20"/>studiosus, mirabilis conversio: rebus prosperis <lb xml:id="p1z21"/>hęrebat in aula regis, nunc, ubi uni<lb xml:id="p1z22"/>versa veritatis Christi causa non inclinare modo, <lb xml:id="p1z23"/>sed et extrema periclitari videtur, coniunxit <lb xml:id="p1z24"/>se nostris perinde atque olim Ioseph et Nico<lb xml:id="p1z25"/>demus Christo se, dum penderet in cruce, palam <lb xml:id="p1z26"/>coniungebant, cuius tamen antea fidem metu <lb xml:id="p1z27"/>adversarię potestatis dissimulaverant.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z28"/>De <placeName ref="l303">Magdeburgensibus</placeName> fama est <placeName ref="l18">Augustę</placeName> esse <lb xml:id="p1z29"/>eos iam plane omni auxilio destitutos, eo <lb xml:id="p1z30"/>quod exercitus ille dominorum ab <persName ref="p8034">Heideck</persName> et <persName ref="p7652">Mansfelden</persName> <lb xml:id="p1z31"/>prorsus sit dissolutus ac dispersus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Quę res <lb xml:id="p1z32"/>me diebus istis plurimum divexavit; succurrat <lb xml:id="p1z33"/>afflictis dominus exercituum, et ubi cessat humanum, <lb xml:id="p1z34"/>ibi incipiat d[omini] auxilium.</s>
					<s n="9" xml:lang="la">Ad concilium <placeName ref="l1107">Tridentinum</placeName> <lb xml:id="p1z35"/>parabis te; nihil enim certius est quam, si <lb xml:id="p1z36"/>conatus antichristi eousque successerint, fore <lb xml:id="p1z37"/>ut postuleris a Confoederatis vestris et voceris <lb xml:id="p1z38"/>ad conciliabulum, non ad patrocinium veritatis, <lb xml:id="p1z39"/>sed ad audiendam condemnationis catholicę sententiam.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z40"/>Habeo hic exemplum Commentariorum meorum in Psalmos <lb xml:id="p1z41"/>bibliothecę tuę consecratum; si nosti modum, quo <lb xml:id="p1z42"/>possit ad te mitti, significa.</s>
					<s n="11" xml:lang="la" ana="farewell">Optime vale.</s>
					<s n="12" xml:lang="la" ana="salute">Salutem <lb xml:id="p1z43"/>tuis omnibus, etiam fratribus, d. <persName ref="p8127">Pellicano</persName>, <persName ref="p8171">Theodoro</persName>, <persName ref="p8011">Gvalthero</persName> etc.</s>
					<s n="13" xml:lang="de"><placeName ref="l41">Bernę</placeName> 20. februarii 15<lb xml:id="p1z44"/>51.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><persName ref="p8417">W[olfgangus] M[usculus]</persName>, compater tuus.</s>
					<s n="15" xml:lang="la" ana="salute">Saluta amanter <lb xml:id="p1z45"/>meo nomine d. <persName ref="p506">Butlerum</persName>, <lb xml:id="p1z46"/>amicum chari<pb/><lb xml:id="p2z1"/>ssimum.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z2"/>Clarissimo theologo <lb xml:id="p2z3"/>m. <persName ref="p495">Heinrycho <lb xml:id="p2z4"/>Bullingero</persName>, <lb xml:id="p2z5"/><placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z6"/>pastori fidelissimo, <lb xml:id="p2z7"/>compatri suo <lb xml:id="p2z8"/>in Christo charissimo.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z9"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
