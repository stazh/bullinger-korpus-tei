	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Quoties <lb xml:id="p1z2"/>ad d. <persName ref="p8362">Guarnerum</persName> et nostrum d. <persName ref="p8101">Lelium</persName> dedi literas, totus <lb xml:id="p1z3"/>ab illis petii, ut te accederent, meis verbis reverenter salutarent <lb xml:id="p1z4"/>ac de omnibus certiorem redderent, quod eos fecisse non dubito.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z5"/>Nunc etiam ex meis ad.</s>
					<s n="3" xml:lang="la">d. <persName ref="p8362">Guarnerum</persName> et quibusdam scriptis intelliges, <lb xml:id="p1z6"/>quo in statu sint nostrę, multaque narrabit et d. <persName>Iulius <lb xml:id="p1z7"/>Maresius</persName> <placeName ref="l1709">Bellunensis</placeName>, vir eruditus, quem dominus per me eruit <lb xml:id="p1z8"/>ex <placeName>Francisci</placeName> antro.</s>
					<s n="4" xml:lang="la">Venit istuc eo animo, ut vestra pia pariter <lb xml:id="p1z9"/>et erudita fruatur consuetudine.</s>
					<s n="5" xml:lang="la">Optat convictor esse d. <persName ref="p2336">Ber<lb xml:id="p1z10"/>nardini</persName> aut d. <persName ref="p8127">Pellicani</persName>; ut illum suscipiet, accipiet a <lb xml:id="p1z11"/>me singulis annis, quantum iusserit.</s>
					<s n="6" xml:lang="la">Rogo, ut tu quoque hominem <lb xml:id="p1z12"/>novitium in christiana palestra solita tua charitate complectaris.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Erat in papatu doctor theologię ex nobili familia.</s>
					<s n="8" xml:lang="la">Hęc scribo, <lb xml:id="p1z14"/>ut nihil ignores.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>Quam gratę fuerint ecclesię <placeName ref="l2472">Polonicę</placeName> tuę litere, cognosces ex respon<lb xml:id="p1z16"/>sis, que tibi mitto.</s>
					<s n="10" xml:lang="la">Dominus te diutissime ecclesię suę servet.</s>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p1z17"/>Saluta ex me optimam tuam coniugem, filios, filias, generos et, <lb xml:id="p1z18"/>si tamen audere licet, clarissimos viros d. consules, archigrammateum <lb xml:id="p1z19"/>et thesaurarios.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Datum ex <placeName>Heremo Sarmatic</placeName> <lb xml:id="p1z20"/>14. augusti 1556.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/>Tuus <persName ref="p1936">Franciscus Lismaninus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctrina et eruditione pręstan<lb xml:id="p2z2"/>tissimo viro domino <persName ref="p495">Henricho <lb xml:id="p2z3"/>Bulingero</persName>, ecclesiae <placeName ref="l587">Tiguri[nae<lb xml:id="p2z4"/>]</placeName> pastori vigilantissimo, domino [et] <lb xml:id="p2z5"/>fratri colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
