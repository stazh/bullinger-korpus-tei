	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Non sileo, quod rarius scribas, sed quod iam <lb xml:id="p1z2"/>occasiones scribendi rariores sint, neque tu peccas <lb xml:id="p1z3"/>tacendo, modo ne indignatione aliqua taceas.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Ego quod tuis literis<note xml:id="fn1" type="footnote" n="1">Nicht erhalten.</note> non respondi diutius, factum est <lb xml:id="p1z6"/>expectatione tabellionis; cum enim literas tuas <lb xml:id="p1z7"/>redderet, pollicebatur se brevi rediturum, sed iam <lb xml:id="p1z8"/>ex alio et posteriore tabellione audio illum <lb xml:id="p1z9"/>vita functum<note xml:id="fn2" type="footnote" n="2">Keiner der beiden Boten ist namentlich bekannt.</note>.<pb type="edition" next="187"/></s>
				</p>
				<p>
					<s n="4" xml:lang="la">Intellexi autem ex literis tuis, <lb xml:id="p1z10"/>quod non fueris firma valetudine aliquandiu<note xml:id="fn3" type="footnote" n="3">Vgl. oben <ref target="file11469">Nr. 1426</ref>, Anm. 3.</note>, <lb xml:id="p1z11"/>iam vero te non nichil habere melius<note xml:id="fna" type="footnote" n="a"><hi>vor</hi> melius <hi>ein gestrichenes, unlesbares Wort.</hi></note>.</s>
					<s n="5" xml:lang="la">Quod posteriu<lb xml:id="p1z12"/>s <lb xml:id="p1z13"/>gratissimum est michi - non tuo ipsius nomine, praestaret <lb xml:id="p1z15"/>enim nos citissime dissolvi et esse cum <lb xml:id="p1z17"/>Christo<note xml:id="fn4" type="footnote" n="4">Vgl. <cit type="bible"><ref>Phil 1, 23</ref></cit>.</note> -, caeterum quotienscunque animum subit, <lb xml:id="p1z18"/>quis status ecclesiae futurus sit ereptis sanctis <lb xml:id="p1z19"/>apostolis, totus exhorresco et video, si non uno <lb xml:id="p1z20"/>impetu, saltem paulatim irrupturam omnem <lb xml:id="p1z21"/>impietatem.</s>
					<s n="6" xml:lang="la">Quanquam non ignorem a domino stare, <lb xml:id="p1z22"/>ut ex lapidibus creet filios Abrahae<note xml:id="fn5" type="footnote" n="5">Vgl. <cit type="bible"><ref>Mt 3, 9 par</ref></cit>.</note>, tamen, <lb xml:id="p1z23"/>an velit, quod potest, quaeritur, deinde, an istud <lb xml:id="p1z24"/>mereatur nostra ingratitudo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Quae de <placeName ref="l830">Anglia</placeName> <lb xml:id="p1z25"/>scribis<note xml:id="fn6" type="footnote" n="6">Wahrscheinlich handelte es sich um Nachrichten aus Briefen von <persName ref="p8011">Gwalther</persName> und <persName ref="p8418">Myconius</persName>; vgl. oben <ref target="file11463">Nr. 1420</ref>, 86-104; 1426, 25f.</note>, apud me non sunt nova; nichil enim <lb xml:id="p1z26"/>unquam boni pollicitus sum michi de illius <lb xml:id="p1z27"/><persName ref="p8375">rege</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p8375">Heinrich VIII.</persName></note>, postquam truculenter adeo et subdole <lb xml:id="p1z28"/>repudiavit primam <persName ref="p7386">uxorem</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p7386">Katharina von Aragonien</persName>.</note> et <persName ref="p4358">secundam</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p4358">Anne Boleyn</persName>.</note> interfecit, <lb xml:id="p1z29"/>ne quid de reliquis<note xml:id="fn10" type="footnote" n="10"><persName ref="p6596">Jane Seymour</persName> und <persName ref="p20560">Anna von Kleve</persName> (vgl. oben <ref target="file11463">Nr. 1420</ref>, 88-90).</note> dicam.</s>
					<s n="8" xml:lang="la">Extinxit uxores, <lb xml:id="p1z30"/>extinguit etiam sponsam Christi<note xml:id="fn11" type="footnote" ana="lex" n="11">die Kirche.</note>.</s>
					<s n="9" xml:lang="la">Idem facit <lb xml:id="p1z31"/><persName ref="p18538">imperator</persName><note xml:id="fn12" type="footnote" n="12"><persName ref="p18538">Karl V.</persName></note>, qui nuper cepit atrociter sęvire in <lb xml:id="p1z32"/>suos<note xml:id="fn13" type="footnote" n="13">Zum <placeName ref="l640">flandrischen</placeName> Ketzermandat vom 22. September, auf das sich <persName ref="p4079">Zwick</persName> wohl bezieht, s. unten <ref target="file11482">Nr. 1439</ref>, Anm. 14.</note>.</s>
					<s n="10" xml:lang="la">Interim sunt, qui boni aliquid de illo <lb xml:id="p1z33"/>sibi pollicentur, id quod connivente domino <lb xml:id="p1z34"/>pulchre sentiemus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb type="scan" next="68"/><pb/><lb xml:id="p2z1"/>Quid comitia<note xml:id="fn14" type="footnote" n="14">Gemeint ist das <placeName ref="l569">Wormser</placeName> Religionsgespräch.</note> proditura sint, etiamnum ignoratur, <lb xml:id="p2z2"/>nichil dum audimus ex <persName ref="p5741">Ioachimo</persName><note xml:id="fn15" type="footnote" n="15"><persName ref="p5741">Joachim Maler</persName>.</note> nostro, speramus <lb xml:id="p2z3"/>tamen innocentiam nostram ipsamque veritatem <lb xml:id="p2z4"/>melius habituram, si nos omnibus expositi simus <lb xml:id="p2z5"/>rationem reddere fidei nostrae.</s>
					<s n="12" xml:lang="la">Sed Christus <lb xml:id="p2z6"/>bene omnia vertat.</s>
					<s n="13" xml:lang="la">Amen.</s>
					<s n="14" xml:lang="la">Cum primum aliquid <lb xml:id="p2z7"/>rescripserit legatus noster, dabo operam, ne tu quoque <lb xml:id="p2z8"/>ignores.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z9"/>De facto <persName ref="p3590">Hessii</persName><note xml:id="fn16" type="footnote" n="16">Die Rede ist von der Nebenehe <persName ref="p3590">Philipps von Hessen</persName>.</note> scribo ad <persName ref="p8127">Pellicanum</persName><note xml:id="fn17" type="footnote" n="17">Der Brief ist nicht erhaten.</note>.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z10"/>Sed ad <persName ref="p1753">Leonem</persName> scribo<note xml:id="fn18" type="footnote" n="18">Auch der Brief an <persName ref="p1753">Leo Jud</persName> ist verloren.</note> aliquid de <lb xml:id="p2z11"/><persName ref="p4225">Michaele</persName><note xml:id="fn19" type="footnote" n="19"><persName ref="p4225">Michael Back</persName>; vgl. unten <ref target="file11478">Nr. 1435</ref>, 2-16.</note> meo, qui meus est, dum mecum est.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z12"/>Hic te iterum atque iterum rogo, ne quid negligas; <lb xml:id="p2z13"/>sed non est cunctandum.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Deinde quaerunt nostri <lb xml:id="p2z14"/>consilium a vobis, ut audio, in causa divortii sive <lb xml:id="p2z15"/>adulterii<note xml:id="fn20" type="footnote" n="20">Vgl. oben <ref target="file11476">Nr. 1433</ref>, 3-13.</note>.</s>
					<s n="19" xml:lang="la">Hic vellemus vos respondere mitius aliquid, <lb xml:id="p2z16"/>non erga nocentes, sed innocentes.</s>
					<s n="20" xml:lang="la">Sed et <lb xml:id="p2z17"/>istud ex literis <placeName ref="l822">Germanicis</placeName> ad <persName ref="p1753">Leonem</persName>.<pb type="edition" next="188"/></s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="farewell"><lb xml:id="p2z18"/>Iam tu vale, et insta apud dominum multis precibu[s]<note xml:id="fnb" type="footnote" n="b"><hi>Text im engen Einband nicht zugänglich.</hi></note>, <lb xml:id="p2z19"/>ne nos deserat.</s>
					<s n="22" xml:lang="la" ana="salute">Salutant te rursus boni omnes, <lb xml:id="p2z20"/>cumprimis <persName ref="p8055">Ambrosius</persName><note xml:id="fn21" type="footnote" n="21"><persName ref="p8055">Ambrosius Blarer</persName>.</note> cum fratre<note xml:id="fn22" type="footnote" n="22"><persName ref="p8178">Thomas Blarer</persName> oder <persName ref="p4082">Konrad Zwick</persName>.</note>.</s>
					<s n="23" xml:lang="la">Ex <placeName ref="l257">Con<lb xml:id="p2z21"/>stantia</placeName>, 16. novembris 1540.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p2z22"/>Tuus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf f. 61a v.:]<note xml:id="fnc" type="footnote" n="c"><hi>Daß das Blatt mit der Adresse zu diesem Brief gehört, ist nicht ganz sicher. Wegen der Erwähnung von <persName ref="p495">Bullingers</persName> Kollegen (s. oben Z. 27 und 32) steht aber der Adressat zweifelsfrei fest.</hi></note></note>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p4z1"/>Domino <persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p4z2"/>episcopo <placeName ref="l587">Tigurino</placeName>, <lb xml:id="p4z3"/>fratri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
