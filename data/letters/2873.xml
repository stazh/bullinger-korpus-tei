	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Salve, optime frater.</s>
					<s n="3" xml:lang="la">Dabit tuae humanitati <persName ref="p8101">Laelius</persName> noster <lb xml:id="p1z2"/>librum atque imaginem unam et, si volueris, <lb xml:id="p1z3"/>etiam plures.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Boni consule tenuitatem munus<lb xml:id="p1z4"/>culi.</s>
					<s n="5" xml:lang="la"><persName ref="p8371">Albertus</persName> agit de concordia, <lb xml:id="p1z5"/>papa nititur turbare; quid sit futurum nescio.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/>Plerique omnes timent bella, horrida bella.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z7"/>Idem <persName ref="p8371">Albertus</persName> fuit cum principe meo, quat<lb xml:id="p1z8"/>triduo.</s>
					<s n="8" xml:lang="la">Bone deus, qua nos letitia excepit, <lb xml:id="p1z9"/>quam gaudeo me illi factum familia<lb xml:id="p1z10"/>rem; <lb xml:id="p1z11"/>vere habet egregias dotes, ut possit <lb xml:id="p1z12"/>etiam lingua Latina non infoeliciter uti, <lb xml:id="p1z13"/>ante omnia fere suprat me in colendo <lb xml:id="p1z14"/>papa.</s>
					<s n="9" xml:lang="la">Mortuo <persName>Friderico</persName> successit <persName ref="p2411">Otto <lb xml:id="p1z15"/>Henricus</persName> et pacifice arripuit possessionem <lb xml:id="p1z16"/>electoratus; nunc totus <placeName ref="l2477">Palatinatus</placeName> ex<lb xml:id="p1z17"/>papabitur, quod ego sedulo urgeo.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Nosti abs te tuisque symmistis condemnatum aut <lb xml:id="p1z19"/>reprobatum fuisse librum De amplitudine <lb xml:id="p1z20"/>beati regni dei, quod <placeName ref="l28">Basilienses</placeName> quoque, <lb xml:id="p1z21"/>imo etiam <placeName ref="l491">Argentinenses</placeName> fecerunt; at nunc ide<lb xml:id="p1z22"/>m praeclarus liber circumfertur velut <lb xml:id="p1z23"/>excusus <placeName ref="l28">Basileae</placeName>, quum excusus fuerit <lb xml:id="p1z24"/><placeName ref="l399">Pusclavii</placeName> in <placeName ref="l648">Raetia</placeName>.</s>
					<s n="11" xml:lang="la">Nescio quis princi<lb xml:id="p1z25"/>pi obtrudit, ut illum venaretur; at princeps <lb xml:id="p1z26"/>statim vidit errores et peximum puta<lb xml:id="p1z27"/>vit librum non uno tantum errore infectum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z28"/><persName ref="p458">Brentius</persName> diserte condemnavit et dolet latum <pb/><lb xml:id="p2z1"/>fuisse in <placeName ref="l2472">Poloniam</placeName>.</s>
					<s n="13" xml:lang="la">Cur vos siletis, cur <lb xml:id="p2z2"/>non commonefacitis, ut discant b<lb xml:id="p2z4"/>onum spargere cunctis bonis ecclesiis; <lb xml:id="p2z5"/>non videtur res dissimulanda, agitur de gloria <lb xml:id="p2z6"/>dei.</s>
					<s n="14" xml:lang="la">Illud inprimis abominabile: d<lb xml:id="p2z7"/>iserte dicit hominem posse salvari lege natu<lb xml:id="p2z8"/>rae praeter Christum.</s>
					<s n="15" xml:lang="la">Forsan impulsus <lb xml:id="p2z9"/>scribo, sed magnorum, sed piorum autoritat[e], <lb xml:id="p2z10"/>qui cupiunt autorem illum cohercitum, <lb xml:id="p2z11"/>ne talia amplius.</s>
					<s n="16" xml:lang="la">At tecum ego fa<lb xml:id="p2z12"/>miliariter, nolim multis, quod scripsi, <lb xml:id="p2z13"/>communices.</s>
					<s n="17" xml:lang="la" ana="salute">Salvere iubeo familiam, <lb xml:id="p2z14"/>scholam ecclesiam; iuvate me vestris precibus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z15"/><placeName ref="l512">Tubingae</placeName> 26. mart<lb xml:id="p2z16"/>ii <lb xml:id="p2z17"/>1556.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z18"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="20" xml:lang="la"><lb xml:id="p2z19"/>Clarissimo viro d. <lb xml:id="p2z20"/><persName ref="p495">H. Bullingero</persName>, f<lb xml:id="p2z21"/>ratri optimo.</s>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
