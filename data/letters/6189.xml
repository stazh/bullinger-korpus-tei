	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gaudium et pacem per Christum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Sedimus hactenus, <lb xml:id="p1z2"/>mi domine <persName ref="p495">Bullingere</persName> et reverende pater, in magna <lb xml:id="p1z3"/>expectatione colloquii in <placeName ref="l572">Wirttenbergensi</placeName> ducatu <lb xml:id="p1z4"/>habiti, quid tandem gigneret aut quid in eo esset <lb xml:id="p1z5"/>effectum.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Ac dum ita haeremus, ecce forte fortuna <lb xml:id="p1z6"/>vocor <placeName>Erdbachum</placeName>.</s>
					<s n="4" xml:lang="la">Institui itaque meum iter per <lb xml:id="p1z7"/><placeName ref="l210">Heidelbergam</placeName>, quo in loco incidi in quosdam <lb xml:id="p1z8"/>viros et pios et doctos, quibuscum ea de re <lb xml:id="p1z9"/>contuli.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Et quanquam non dubitem, quin <lb xml:id="p1z10"/>singula ad te diligentissime sint perscripta, tamen, <lb xml:id="p1z11"/>quid in eo colloquio effectum sit, summa capita <lb xml:id="p1z12"/>tibi dominus noster senex <persName ref="p1010">Erbius</persName> communicabit.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Faxit omnipotens deus, ut suam gloriam apud cunctos <lb xml:id="p1z14"/>vindicet.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Salutabis meo nomine optimos quosque <lb xml:id="p1z15"/>dominos et fratres mihi cognitos, ac tu cura, ut feliciter <lb xml:id="p1z16"/>valeas et athletice, quo recognitionis librum <lb xml:id="p1z17"/><persName ref="p458">Brentii</persName> recognoscere possis.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Datum raptim <lb xml:id="p1z18"/><placeName ref="l404">Rapperßvillę</placeName> 7. iuli anno etc. 64.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/>Tui obsequentissimus <lb xml:id="p1z20"/><persName ref="p8099">Thomas Schöpfius</persName>, d[<lb xml:id="p1z21"/>octor] m[edic<lb xml:id="p1z22"/>inae], physicus <placeName ref="l101">Colmariensis</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro doctrina et pietate praestantissimo domino <lb xml:id="p2z2"/><persName ref="p495">Heinrico Bullingero</persName>, verbi divini praeconi <lb xml:id="p2z3"/>dignissimo inclytę urbis <placeName ref="l587">Tigurinę</placeName>, domino <lb xml:id="p2z4"/>ac fratri suo plurimum observando.</s>
				</p>
			</div>
		</body>
	</text>
