	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Domino <persName ref="p495">Heinricho Bullingero</persName> <persName ref="p8407">H[einrichus] Lutius</persName> s[alutem] d[icit].</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Quod nova auctus es prole idque sane filio<note xml:id="fn1" type="footnote" n="1">Am 12. Januar 1541 war <persName ref="p495">Bullingers</persName> Sohn <persName ref="p4446">Diethelm</persName> (gest. 1542) zur Welt gekommen; s. <bibl source="b288">HBD</bibl> 28, 31f; 31, 7-22.</note>, <lb xml:id="p1z3"/>ni fallor, tibi equidem plurimum congratulor.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Puero opto felicitatem maximam, tibi vero parenti <lb xml:id="p1z5"/>fore filium obsequentissimum, deos precor immortales, <lb xml:id="p1z6"/>quorum beneficio favoreque fiat, [u]t<note xml:id="fna" type="footnote" n="a">[u]t <hi>am Rande nachgetragen, Wortanfang im Einband verdeckt.</hi></note> filius iste tuus <lb xml:id="p1z7"/>parentem cum pietate tum doctrina pulchre aliquando <lb xml:id="p1z8"/>referat, exprimat per omnia tanquam vivum<note xml:id="fnb" type="footnote" n="b"><hi>In der Vorlage</hi> vium.</note> exemplar <lb xml:id="p1z9"/>itaque tanto parente dignus reddatur filius.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>Puerpere muneri mitto galinas duas, turdos <lb xml:id="p1z11"/>quinque, donum equidem parvi momenti, si id <lb xml:id="p1z12"/>ab ipsius rei magnitudine estimes, multo vero <lb xml:id="p1z13"/>maximum, si animum eius, qui dat, spectes, <lb xml:id="p1z14"/>tibi, ita me dii bene ament, addictissimum, devinctissimum <lb xml:id="p1z15"/>adeoque quavis in re tibi gratificandi propensissimum.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z16"/>Id ipsum me hercle vicissim mihi de te polliceri <lb xml:id="p1z17"/>ausim.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale et vive quam diutissime idque <lb xml:id="p1z19"/>salubriter.</s>
					<s n="7" xml:lang="la">Anno 1541, calendis februariis.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>Thigurinorum ecclesiaste <lb xml:id="p2z3"/>vigilantissimo doctissimoque, domino <lb xml:id="p2z4"/>suo ac fratri cum primis <lb xml:id="p2z5"/>observando.</s>
				</p>
			</div>
		</body>
