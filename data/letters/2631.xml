	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Forte fortuna a lectione mea domum <lb xml:id="p1z2"/>reversus, compater in domino charissime, incidi <lb xml:id="p1z3"/>in bibliopolam <placeName ref="l2">Arowensem</placeName>, cuius opera <lb xml:id="p1z4"/>ad hoc uti placuit, ut <placeName ref="l425">Romanos</placeName> <lb xml:id="p1z5"/>meos ad te mitterem.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Ille pro huma<lb xml:id="p1z6"/>nitate sua illam libens praestitit.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Mitto igitur, quod iamdudum misissem, <lb xml:id="p1z8"/>si commoda aliqua ratione licuisset.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Oro, ut animum fratris magis quam <lb xml:id="p1z10"/>donum ipsum respiciens, quicquid hoc est <lb xml:id="p1z11"/>meae erga te gratitudinis, boni consulas.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Si quid inter legendum, quod limam postulat, <lb xml:id="p1z13"/>deprehenderis, vel corrigas ipse vel <lb xml:id="p1z14"/>mihi significes.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Domum tuam spero per gratiam domini salvam <lb xml:id="p1z16"/>esse et inoffenso cursu pergere in <lb xml:id="p1z17"/>statu commodo ac tranquillo.</s>
					<s n="8" xml:lang="la">Mea quoque <lb xml:id="p1z18"/>eiusdem gratia non habet incommode.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/>Statum ecclesiarum commendemus domino.</s>
					<s n="10" xml:lang="la">Ministri <lb xml:id="p1z20"/>illarum sic animati esse pergunt, ut, nisi <lb xml:id="p1z21"/>mutet animos illorum dominus, non sint ipsi <lb xml:id="p1z22"/>adversarii plus allaturi detrimenti quam ii <lb xml:id="p1z23"/>ipsi, quorum erat conciunctis animis <lb xml:id="p1z24"/>castris hostium expugnandis studiosissime <lb xml:id="p1z25"/>incumbere.</s>
					<s n="11" xml:lang="la">Si fuerit pax inter <persName ref="p18538">Caesarem</persName> et <lb xml:id="p1z26"/><persName ref="p8112">Gallum</persName> composita, videbimus magnas <lb xml:id="p1z27"/>rerum perturbationes.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Episcopi cum <persName ref="p18477">Ferdinando</persName> <lb xml:id="p1z28"/>moliuntur continuationem conciliabuli <lb xml:id="p1z29"/><placeName ref="l1107">Tridentini</placeName>, et <persName ref="p18538">Caesar</persName> totus in eo est, ut <lb xml:id="p1z30"/>filium suum imperio obtrudat.</s>
					<s n="13" xml:lang="la">Dissipet dominus <lb xml:id="p1z31"/>consilia principum.</s>
					<s n="14" xml:lang="de">Amen, amen.</s>
					<s n="15" xml:lang="la" ana="farewell">Optime <lb xml:id="p1z32"/>vale, compater in domino charissime.</s>
					<s n="16" xml:lang="la" ana="salute">Salutem domui <lb xml:id="p1z33"/>tuae, dominis ac fratribus isthic, d. <persName ref="p8127">Pellicano</persName>, <lb xml:id="p1z34"/>d. <persName ref="p8171">Bibliandro</persName>, d. <persName ref="p8011">Gvalthero</persName> ac reliquis.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z35"/>Salutant te mei omnes, praesertim <persName ref="p2207">Ioannes Hein<lb xml:id="p1z36"/>rychulus</persName>, filiolus tuus in domino.</s>
					<s n="18" xml:lang="de"><placeName ref="l41">Bernę</placeName> 1555. <lb xml:id="p1z37"/>6. maii.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><persName ref="p8417">W[olfgangus] Musc[ulus]</persName>, compater tu<lb xml:id="p1z38"/>us in domino.</s>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo theologo <lb xml:id="p2z2"/>m. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, domino <lb xml:id="p2z4"/>ac compatri <lb xml:id="p2z5"/>suo longe charissimo.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
