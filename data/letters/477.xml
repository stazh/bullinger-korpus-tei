	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Pl.</s>
					<s n="3" xml:lang="la">Salvi et incolumes dei clementia, colendissime omine ac compater, <lb xml:id="p1z2"/>venimus <placeName ref="l28">Basileam</placeName> 27. Martii circa horam decimam et <lb xml:id="p1z3"/>cras mane, si nautis fas sit credere, hinc solvemus.</s>
					<s n="4" xml:lang="la">Ut <lb xml:id="p1z4"/>sumptubus igitur parcam, expedio aurigam cum curru et equis.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Cras vesperi dominus civis vester omnia, spero, sua denuo salva <lb xml:id="p1z6"/>ac illesa recipiet.</s>
					<s n="6" xml:lang="la">Quod longius in itinere suo incommodo <lb xml:id="p1z7"/>et meis magnis impensis, quam putaverat, moram neximus, <lb xml:id="p1z8"/>itineris asperitati imputari oportet et non segnitię nostrę vel <lb xml:id="p1z9"/>equorum lassitudini.</s>
					<s n="7" xml:lang="la">Huic optimo civi meo nomine <lb xml:id="p1z11"/>referas gratias quam maximas, rogo, vel hoc humanitatis offitium <lb xml:id="p1z12"/>meo nomine ac precibus iniungas tui ac mei amantissimo D. <persName ref="p8011">Gu[<lb xml:id="p1z13"/>a]ltero</persName>; nam is, ni fallor, vel affinitate vel sanguine domi<lb xml:id="p1z14"/>no <lb xml:id="p1z15"/>equorum est iunctus.</s>
					<s n="8" xml:lang="la">Novi hic nihil adhuc nobis refertur, <lb xml:id="p1z17"/>nisi quod pro certo asserunt, qui iam veniunt ab <lb xml:id="p1z18"/><placeName ref="l491">Argentina</placeName>, missam nondum a civibus esse admissam.</s>
					<s n="9" xml:lang="la">Hanc <lb xml:id="p1z19"/>ob causam episcopus urbis non irascitur, sed insania et <lb xml:id="p1z20"/>furore quodam furit et instituit colloquium in sua <lb xml:id="p1z21"/>civitate duobus milliaribus ab <placeName ref="l491">Argentina</placeName>, et omnes, <lb xml:id="p1z22"/>qui hic me convenerunt amicitię causa, dicunt <lb xml:id="p1z23"/>illum parturire monstrum aliquod horrendum; sed faciet <lb xml:id="p1z24"/>aborsum, spero.</s>
					<s n="10" xml:lang="la">Accipies etiam ab isto viro linthiamen <lb xml:id="p1z25"/>unum, pannum unum et pulvinar unum cum maximis <lb xml:id="p1z26"/>gratiis; praeterea omnia, quae mutuo accepimus in expeditionem <lb xml:id="p1z27"/>itineris nostri <placeName ref="l28">Basileam</placeName> usque, remittimus.</s>
					<s n="11" xml:lang="la">Raptim <placeName ref="l28">Basileae</placeName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z28"/>Intra triduum plure accipies deo volente<lb xml:id="p1z29"/>.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z30"/>Remittimus lagenam; <lb xml:id="p1z31"/>ad quem pertineat, ignoramus.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z32"/>Pete, quaeso, ab hospite nostro <lb xml:id="p1z33"/>et ne graveris (omnia onera tu<lb xml:id="p1z34"/>is humeris <lb xml:id="p1z35"/>audacter impono) hoc nostri causa suscipere.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Tui de<lb xml:id="p1z36"/>vinctissimus <persName ref="p1560">Io[annes] Hoperus</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z37"/>Salutamus quam officiosissime charam tuam coniugem cum tua <lb xml:id="p1z38"/>familia tota, D. <persName ref="p8171">Theodorum</persName>, D. <persName ref="p8127">Pellicanum</persName>, D. <persName ref="p8011">Gualterum</persName>, <lb xml:id="p1z39"/>D. <persName ref="p506">Butlerum</persName> cum aliis omnibus<pb/><lb xml:id="p2z1"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="17" xml:lang="la"><lb xml:id="p2z2"/>Ornatissimo viro ac D. <lb xml:id="p2z3"/>D. <persName ref="p495">Heinrico Bullingero</persName>, <lb xml:id="p2z4"/>pientiss[imae] ecclesię <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z5"/>antistiti vigilantissimo, <lb xml:id="p2z6"/>domino ac compatri suo <lb xml:id="p2z7"/>omnibus nominibus optime <lb xml:id="p2z8"/>merito.</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z9"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
