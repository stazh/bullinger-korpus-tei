	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Simul hic iuvenis monet et se iam abiturum <lb xml:id="p1z2"/>ad te et, si quid scribere velim, ipsi dem.</s>
					<s n="3" xml:lang="la">Scis <lb xml:id="p1z3"/>autem, quibus negotiorum procellis adoperiar; unde <lb xml:id="p1z4"/>scio brevitatem nostram satis tibi esse excusatam.</s>
					<s n="4" xml:lang="la">Legi, <lb xml:id="p1z5"/>quae ad me scripsisti, sed bonam partem non intellexi; <lb xml:id="p1z6"/>nescio enim, quis sit ille Doegius adversarius tuus, <lb xml:id="p1z7"/>nescio, quid causae cum illo tibi intercidat, neque <lb xml:id="p1z8"/>ullae ad me de te sunt delatae querelae.</s>
					<s n="5" xml:lang="la">At si <lb xml:id="p1z9"/>delata fuissent, scio alteram aurem patere debere <lb xml:id="p1z10"/>accusato.</s>
					<s n="6" xml:lang="la">Proinde, quoad me, iubeo te esse sequrum <lb xml:id="p1z11"/>neque soleo delatoribus benignas praebere aures.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Deinde commendavi senatoribus certis tuum negotium; <lb xml:id="p1z13"/>ipse supplicationem tuam allaturus fueram d. consuli; sed <lb xml:id="p1z14"/>iuvenis dicebat, se illi porrecturum.</s>
					<s n="8" xml:lang="la">Hodie <lb xml:id="p1z15"/>et consul et quaestor aerarius, viri amplissimi, mihi <lb xml:id="p1z16"/>referunt postulata tua in senatu esse recitata <lb xml:id="p1z17"/>totumque negotium relatum ad dominos, qui praesunt <lb xml:id="p1z18"/>rationibus, nisi quod iam decretum est tabulas <lb xml:id="p1z19"/>tibi dandas favoris, defensionis et reditus e<lb xml:id="p1z20"/>tc.</s>
					<s n="9" xml:lang="la">De caeteris nihil esse dubitandum, rem esse loco <lb xml:id="p1z21"/>optimo, id quod fortassis a tuis rectius intelliges.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z22"/>Brevia haec in hanc chartam coniicere volui, <lb xml:id="p1z23"/>ne suspicareris negotium tuum mihi non <lb xml:id="p1z24"/>perinde esse commendatum.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Vive, vale, mi <persName ref="p8016">Tobia</persName>, <lb xml:id="p1z25"/>et fratres omnes symmystas saluta.</s>
					<s n="12" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 6. <lb xml:id="p1z26"/>novembris festinantissime <lb xml:id="p1z27"/>1566.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z28"/><persName ref="p495">Bullingerus</persName> senior<lb xml:id="p1z29"/>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <persName ref="p8016">Tobiae <lb xml:id="p2z2"/>Eglio</persName>, symmystae et fratri <lb xml:id="p2z3"/>fideli et dilecto.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l433">Russikon</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
