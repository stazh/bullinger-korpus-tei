					<s n="2" xml:lang="la">Binas tuas literas eodem prope tempore accepi et cum <lb xml:id="p1z2"/>posterioribus fasciculum etiam nescio quarum rerum, quem d. <lb xml:id="p1z3"/><persName ref="p3740">Stettensi</persName> in arcem mittendum per suos quam primum curavi, <lb xml:id="p1z4"/>quemadmodum ex iis, quas nunc mittit, literis intelliges, quibus <lb xml:id="p1z5"/>ipsum cum dubium non sit quin sit ad te caetera quoque perscri<lb xml:id="p1z6"/>pturus, puta de comitiis quid futurum, de recuperata a Svendio <lb xml:id="p1z7"/>arce quadam firmissima, eo me labore levat idque <lb xml:id="p1z8"/>perqu<lb xml:id="p1z9"/>am comm<lb xml:id="p1z10"/>ode.</s>
					<s n="3" xml:lang="la">Na<lb xml:id="p1z11"/>m cum di<lb xml:id="p1z12"/>sci<lb xml:id="p1z13"/>pul<lb xml:id="p1z14"/>us h<lb xml:id="p1z15"/>ic <lb xml:id="p1z16"/>meus <lb xml:id="p1z17"/><placeName ref="l257">Constan<lb xml:id="p1z18"/>tiam</placeName>, <lb xml:id="p1z19"/>patri<lb xml:id="p1z20"/>am <lb xml:id="p1z21"/>utri<lb xml:id="p1z22"/>usqu<lb xml:id="p1z23"/>e, eat<lb xml:id="p1z24"/>, <lb xml:id="p1z25"/>inde ad v<lb xml:id="p1z26"/>os.<pb/><lb xml:id="p2z3"/>.<lb xml:id="p2z7"/>.</s>
				</p>
			</div>
