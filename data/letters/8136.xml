	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Gott mitt uns.</s>
					<s n="2" xml:lang="de">Ich hab dir der vorigen tagen <lb xml:id="p1z2"/>by <persName ref="p499">Josen</persName><note type="margin">a.R.: <persName ref="p499">Josua Bull</persName>.</note> geschriben, der gen <placeName ref="l441">Schaffhausen</placeName> umb <lb xml:id="p1z3"/>beltzwerch gereyset.</s>
					<s n="3" xml:lang="de">Hievor hab ich dir ouch <lb xml:id="p1z4"/>ein wenig geschriben, wie ouch jetzund thuͦ.</s>
					<s n="4" xml:lang="de"><lb xml:id="p1z5"/>Aber du schripst nüt hinwider.</s>
					<s n="5" xml:lang="de">Hieryn hab ich <lb xml:id="p1z6"/>dir verschlossen nüw zytung, so mir von <placeName ref="l491">Straßburg</placeName> <lb xml:id="p1z7"/>heruff worden; möchte wol lyden, were es müglich, <lb xml:id="p1z8"/>du schicktests mir biß frytag wider; doch ists <lb xml:id="p1z9"/>nitt kömlich, so laß es also.</s>
					<s n="6" xml:lang="de">Gott mitt dir.</s>
					<s n="7" xml:lang="de" ana="salute"><lb xml:id="p1z10"/>Gruͤß uns allen <persName ref="p20082">Susanna</persName>, <persName ref="p5612">Lisenbethli</persName>.</s>
					<s n="8" xml:lang="de">Nächt <lb xml:id="p1z11"/>habend wir in der muͦter huß mitt d. <persName>Jörgen</persName> zu<lb xml:id="p1z12"/>ͦ nacht geessen, warend guͦter dingen.</s>
				</p>
				<p>
					<s n="9" xml:lang="de">Mitt<lb xml:id="p1z13"/>wuchen 11. jaunarij 1570.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><persName ref="p495">H[e<lb xml:id="p1z14"/>inr<lb xml:id="p1z15"/>ych] <pb/><lb xml:id="p2z1"/>B[ullinger]</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="de">Minem lieben sun <persName ref="p477">Han<lb xml:id="p2z2"/>sen Rodolffen Bullinger<lb xml:id="p2z3"/>n</persName>, pfarreren zuͦ <lb xml:id="p2z4"/><placeName ref="l35">Berg</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
