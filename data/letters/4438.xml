	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Magno cum dolore tuas legi li
					<lb xml:id="p1z2"/>nihil tale expectantem nunciantes
					<lb xml:id="p1z3"/>Dominum deum nostrum ex animo per Iesum Christum
					<lb xml:id="p1z4"/>oro, ut te restieuat et ecclesiae suae; servet
					<lb xml:id="p1z5"/>Verum fiat voluntas domini. si evocarit te
					<lb xml:id="p1z6"/>ex hoc mundo dominus Levaberus magno over
					<lb xml:id="p1z7"/>Utinam me tibi iungeret comitem. Sed
					<lb xml:id="p1z8"/>quod ipse voluerit faciat. Si voluerit nos
					<lb xml:id="p1z9"/>diutius haerere in hoc saeculo, orabimus ipsum
					<lb xml:id="p1z10"/>gratiam nobis concedat, quo feliciter exhis
					<lb xml:id="p1z11"/>possimus evitare procellis. Ipse est sydus
					<lb xml:id="p1z12"/>cyvosura nostra et portus salutis nostrae.
					<lb xml:id="p1z13"/>ipsi gloria. Noli autem dubitare de mea
					<lb xml:id="p1z14"/>fide erga uxorem et liberos tuos. libenter
					<lb xml:id="p1z15"/>mmea illis operam impendam. Tu modo
					<lb xml:id="p1z16"/>tranquillo sis animo et spera in dominum
					<lb xml:id="p1z17"/>De te transferet ad se in aeternam gloriam
					<lb xml:id="p1z18"/>optimeque providebit uxori et liberis
					<lb xml:id="p1z19"/>De aliis rebus nunc nihilo dicam apud aegro.
					<lb xml:id="p1z20"/>Tu, donec fueris in hoc seculo m
					<lb xml:id="p1z21"/>et ministerium nostrum et ecclesiam nostram
					<lb xml:id="p1z22"/>tuis precibus deo commendes, oro, in quo omnis
					<lb xml:id="p1z23"/>spes nostra est sita. Ipsi gloria in sempiternum
					<lb xml:id="p1z24"/>Ipse liberet nos ab omni malo et servet
					<lb xml:id="p1z25"/>osex misericordia sua, in mnico servatores
					<lb xml:id="p1z26"/>nostro Iesu Christo. Vale aeternum frnter
					<lb xml:id="p1z27"/>dominus Iesus servet te, compater charissime.
					<lb xml:id="p1z28"/>6.
					<lb xml:id="p1z29"/>Tiguri 5. septembris.
					<lb xml:id="p1z30"/>Saluta
					<lb xml:id="p1z31"/>d. Philippum et Pontasellam, d. d. consules et amic
					<lb xml:id="p1z32"/>s
					<lb xml:id="p1z33"/>Bullingerus tuus.
					<lb xml:id="p1z34"/>laboraveram tam difficulter, ut de vita mortali
					<lb xml:id="p1z35"/>de sperarim; Erat colica passio morbus
					<lb xml:id="p1z36"/>valde acuts. dolor incredibilis. dicravit non
					<lb xml:id="p1z37"/>nisi quatriduum. rediit per intervalla
					<lb xml:id="p1z38"/>irenattine secundo septembris.
					<pb/>
					<lb xml:id="p2z1"/>
					<lb xml:id="p2z2"/>Praestantissimo viro d.
					<lb xml:id="p2z3"/>Ioanni Fabritio
					<lb xml:id="p2z4"/>Curiensis ecclesiae
					<lb xml:id="p2z5"/>fideli ministro, domino
					<lb xml:id="p2z6"/>mino et fratri suo
					<lb xml:id="p2z7"/>colendo et charissimo.
					<lb xml:id="p2z8"/>sie
				</p>
