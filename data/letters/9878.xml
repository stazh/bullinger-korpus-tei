	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Mein freündtlich gruͤse und alles guͦts sey eüch
					<lb xml:id="p1z2"/>icbazeit. zuvor, eerwirdiger, hochgelerte her eten
					<lb xml:id="p1z3"/>schreiben und uberschicts buchlein meiner lieben
					<lb xml:id="p1z4"/>epesta elipiletum sab is vel eufagum nd
					<lb xml:id="p1z5"/>hsebt zuhanden gestolt neben ere
					<lb xml:id="p1z6"/>harem.
					<lb xml:id="p1z7"/>meldung, alls ir mir geschriben, das sy dan sonderli
					<lb xml:id="p1z8"/>vyl erfrelet und last lüch freündtlichen hahen
					<lb xml:id="p1z9"/>zandt sagen, dese vorhabens uss solchen iren besie
					<lb xml:id="p1z10"/>ferschrffen, dieweil, sy aber diser zeit nichts
					<lb xml:id="p1z11"/>hihanden, damis sy lüß gleicherweist hünzegn
					<lb xml:id="p1z12"/>erfretren khonne, welle sy doch zu gelegnen
					<lb xml:id="p1z13"/>rist siser schener eingedener sein, de allunchigs
					<lb xml:id="p1z14"/>in bitend euch latglirig in guͦter gesundihant
					<lb xml:id="p1z15"/>und wolstand zverzalten.
					<lb xml:id="p1z16"/>für die mirgethalte zötung sag ich euch glich heh
					<lb xml:id="p1z17"/>eglichen dann der gnedig gat schiere alleszu
					<lb xml:id="p1z18"/>gutem. Es last mein lieber herr ues vaten
					<lb xml:id="p1z19"/>eich heuender fründtlich gessen, und il guͦts
					<lb xml:id="p1z20"/>hiemil den eleige gott in seinem gnad
					<lb xml:id="p1z21"/>segen.
					<lb xml:id="p1z22"/>buase, der ver den 27. hunri in 0.
					<lb xml:id="p1z23"/>Joh Philip freyfher
					<lb xml:id="p1z24"/>von Frensox.
					<lb xml:id="p1z25"/>quo
					<lb xml:id="p1z26"/>Beygelegte guittenzelten und leblüchlein schiltz allein
					<lb xml:id="p1z27"/>euch mein schlester dissmalls bis sy es zer
					<lb xml:id="p1z28"/>bessere hab
					<lb xml:id="p1z29"/>und oster pepomo
					<lb xml:id="p1z30"/>nam se famem viri letem enim expeu e verernt esetei,
					<lb xml:id="p1z31"/>das inen der kans trüser von Ech, so es mügleg ist zuͦ gen
					<lb xml:id="p1z32"/>werde; dan er biecht moch nich minen schlechten bleinfugen
					<lb xml:id="p1z33"/>perstand hiehar gsheckt und dugenlich sein, dan keiner fin zie
					<pb/>
					<lb xml:id="p2z1"/>Dem eerwirdigen, hochgelerten
					<lb xml:id="p2z2"/>herre Heinrych Bullinger, den
					<lb xml:id="p2z3"/>ellere diener der kirchen zuͦ
					<lb xml:id="p2z4"/>meinem besonders lieber
					<lb xml:id="p2z5"/>herren und freündt.
				</p>
			</div>
		</body>
	</text>
