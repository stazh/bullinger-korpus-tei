	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Gleichzeitig mit <ref target="file10669">Nr. 631</ref>.</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus.</s>
				</p>
				<p>
					<s n="2" xml:lang="de">Zöger<note xml:id="fn2" type="footnote" n="2">Überbringer, Vorzeiger (<bibl source="b260">Grimm</bibl> XV 507).</note> des briefs ist ain <persName ref="p7604">landtsherr</persName><note xml:id="fn3" type="footnote" n="3">Ein hoher Adliger (<bibl source="b260">Grimm</bibl> VI 109f), nämlich <persName ref="p7604">Balthasar von Kuenring</persName>; vgl. oben <ref target="file10669">Nr. 631</ref>, 3-14.</note> <lb xml:id="p1z2"/>us <placeName ref="l850">Österrich</placeName>, ain gschickter junger mann, <lb xml:id="p1z3"/>den lond uch befolchen sin.</s>
					<s n="3" xml:lang="de">Er wolt in siner her<lb xml:id="p1z4"/>schaft och lassen das evangelium predigen, wann <lb xml:id="p1z5"/>er etwan ain gschickten gsellen<note xml:id="fn4" type="footnote" n="4">jungen Mann, Pfarrhelfer (<bibl source="b260">Grimm</bibl> IV/I 2 4032; <bibl source="b590">SI</bibl> VII 719). Die Bitte um einen Prädikanten wird später wiederholt; s. unten <ref target="file10680">Nr. 642</ref>, 30-32. 648, 2-8.</note> wiste.</s>
					<s n="4" xml:lang="de">Er muͤste <lb xml:id="p1z6"/>aber hüpschlich<note xml:id="fn5" type="footnote" n="5">sachte, vorsichtig (<bibl source="b590">SI</bibl> II 966f).</note> gon zum ersten, doch wurt er <lb xml:id="p1z7"/>selbs mit uch davon reden.</s>
					<s n="5" xml:lang="la">In negotio caenae non <lb xml:id="p1z8"/>nihil pendet bonus vir, quantum intelligo, sed plane <lb xml:id="p1z9"/>aequus est.</s>
					<s n="6" xml:lang="de">Lieber, schaffend, das im Maister <lb xml:id="p1z10"/><persName ref="p8447">Wernher Stainer</persName> gselschaft<note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> gselschaft <hi>gestrichenes</hi> gsch.</note> laist und im <lb xml:id="p1z11"/>von <placeName ref="l850">Österrych</placeName> guͦt possen rysse<note xml:id="fnc" type="footnote" n="c"><hi>vor</hi> rysse <hi>gestrichenes</hi> fa.</note>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Vi extorsit a me, quid de consobrinorum coniugio <lb xml:id="p1z13"/>sentiam<note xml:id="fn6" type="footnote" n="6">Über <persName ref="p4079">Zwicks</persName> Gutachten vgl. oben <ref target="file10669">Nr. 631</ref>, 8-13, und unten <ref target="file10680">Nr. 642</ref>, 2-4.</note>.</s>
					<s n="8" xml:lang="la">Ipse enim consobrinam <persName ref="p7172">sororem</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p7172">Anastasia von Zelking</persName> (vgl. oben <ref target="file10669">Nr. 631</ref>, Anm. 3).</note> ambit.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z14"/>Non potui tibi exemplar mittere iuditii mei, <lb xml:id="p1z15"/>vellem tamen, ex illo peteres.</s>
					<s n="10" xml:lang="la">Deinde peto <lb xml:id="p1z16"/>ne graveris ad me dare, quid tu illi responderis<note xml:id="fn8" type="footnote" n="8"><persName ref="p4079">Zwick</persName> erhielt die gewünschte Kopie, vgl. unten <ref target="file10680">Nr. 642</ref>, 2.</note>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z17"/>Vale cum piis fratribus.</s>
					<s n="12" xml:lang="la"><persName ref="p8127">Pellicanum</persName> salvum <lb xml:id="p1z18"/>volo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z19"/><persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z20"/>Abiturum commenda <lb xml:id="p1z21"/><persName ref="p1365">Gryneo</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p7604">Balthasar von Kuenring</persName> reiste von <placeName ref="l587">Zürich</placeName> nach <placeName ref="l28">Basel</placeName> weiter (vgl. <persName ref="p18722">Erasmus</persName>, Corr. XI 226); ein Empfehlungsschreiben <persName ref="p495">Bullingers</persName> ist jedoch nicht erhalten.</note></s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> antistiti<lb xml:id="p2z4"/>, fratri charissimo.</s>
				</p>
			</div>
		</body>
