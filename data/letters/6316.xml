	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Reverende in Christo pater, heri ad te scripsi <lb xml:id="p1z3"/>de rebus <placeName ref="l648">Rheticis</placeName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Hoc vesperi a d. legato ad <lb xml:id="p1z4"/>coenam evocatus sum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Supervenerunt literae, <lb xml:id="p1z5"/>quas attulit tabellio civitatis <placeName ref="l587">Tigurinae</placeName>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quid <lb xml:id="p1z6"/>in illis esset, nescio, nisi quod dominus post e<lb xml:id="p1z7"/>arum lectionem videbatur subtristis.</s>
					<s n="6" xml:lang="la">Quae in <lb xml:id="p1z8"/>mensa referebat, haec erant:</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Dominum de <persName>Angusola <lb xml:id="p1z9"/>Uranii</persName> haerere et ibi sua venena spargere.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Hoc certum est conatum <placeName ref="l875">Hispanorum</placeName> <lb xml:id="p1z11"/>non esse exiguum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Qui ad nos missi sunt, <lb xml:id="p1z12"/>nihildum proposuerunt; quid quaerant, non <lb xml:id="p1z13"/>est obscurum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Cras aut postridie hic erunt comitia <lb xml:id="p1z14"/>minora (bytag) nomine <placeName ref="l832">Galli</placeName>.</s>
					<s n="11" xml:lang="la">Ille enim <lb xml:id="p1z15"/>nostros evocaverat, antequam ei de <placeName ref="l875">Hispani</placeName> <lb xml:id="p1z16"/>adventu constaret.</s>
					<s n="12" xml:lang="la">- Mitto scriptum meum de peste, <lb xml:id="p1z17"/>quod tu aut solus aut cum paucis leges, ne <lb xml:id="p1z18"/>habeat ille, quod conqueratur.</s>
					<s n="13" xml:lang="la">Remittes aliquando, <lb xml:id="p1z19"/>sed non nisi per certos homines; nolo spargi, <lb xml:id="p1z20"/>quoniam ille tam aegre fert.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Dices esse satis acre; <lb xml:id="p1z21"/>sed cogitare debes, dolorem, quem ex morbo tuo <lb xml:id="p1z22"/>conceperam, haec extorsisse.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Multo absurdiora proferre <lb xml:id="p1z23"/>possum, et illi boni viri haec omnia defendunt.</s>
					<s n="16" xml:lang="la">Dicunt <lb xml:id="p1z24"/>se non probare immanitatem; sed probant causam.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z25"/>Praeterea possum hoc affirmare me illius oratione, <lb xml:id="p1z26"/>qui mecum disputavit, plurimum esse offensum; sic <lb xml:id="p1z27"/>ethnice omnia, de divina providentia ne verbum.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z28"/>Sed, ut heri scripsi, per me sint omnia sopita <lb xml:id="p1z29"/>et sepulta.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Itaque te cum paucis haec volo legere, <lb xml:id="p1z30"/>propter quem scripta sunt.</s>
					<s n="20" xml:lang="la">Mitto etiam edictum regium, <lb xml:id="p1z31"/>quod cupio d. d. <persName ref="p1283">Gesnero</persName> restitui.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Heri ad <pb/><lb xml:id="p2z1"/>eundem scripsi, nunc saltem hoc scriptum cum gratia remitto.</s>
					<s n="22" xml:lang="la"><lb xml:id="p2z2"/>Non mihi constat de tabellionis abitu; ideo haec noctu scripsi.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p2z3"/>Fieri potest, ut cras hic haereat et interim, si quae <lb xml:id="p2z4"/>nova sunt cognitione tua digna, amplius experiar.</s>
					<s n="24" xml:lang="la" ana="farewell"><lb xml:id="p2z5"/>Vale, reverende in Christo pater.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><placeName ref="l98">Curiae</placeName> 28. novembris anno 1564.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">Tui observans <persName ref="p8009">I[oannes] Fa[bricius</persName>].</s>
				</p>
				<p>
					<s n="27" xml:lang="la">Si tibi vi<lb xml:id="p2z6"/>detur, <lb xml:id="p2z7"/>da etiam d. socero meo legen<lb xml:id="p2z8"/>dum, sed ita ut unus legat.</s>
				</p>
				<p>
					<s n="28" xml:lang="la">Amplissimo viro d. <persName ref="p495">Heinrycho Bullingero</persName>, domino suo <lb xml:id="p2z9"/>et in Ch<lb xml:id="p2z10"/>risto patri multum reverendo.</s>
				</p>
				<p>
					<s n="29" xml:lang="de"><placeName ref="l587">Zurich</placeName> an h[errn] <persName ref="p495">Bullinger</persName>.</s>
				</p>
			</div>
		</body>
