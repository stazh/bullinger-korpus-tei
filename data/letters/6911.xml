	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Multa quidem ad nos de prospero Germanorum successu <lb xml:id="p1z2"/>in dies afferuntur; ego autem finem, non principia specto; <lb xml:id="p1z3"/>vix enim est, ut quisquam ad summum miseriae gradum <lb xml:id="p1z4"/>demittatur, qui fortunae blanditias expertus non sit.</s>
					<s n="3" xml:lang="la">Ego <lb xml:id="p1z5"/><placeName ref="l822">Germanis</placeName> omnia fausta opto precorque simulque velim, ne se, <lb xml:id="p1z6"/>hostem amicosque negligant.</s>
					<s n="4" xml:lang="la">Qui <placeName ref="l157">Francforto</placeName> ex nundinis redeunt, <lb xml:id="p1z7"/>mira de rebus <placeName ref="l640">Flandricis</placeName> narrant, deiectas undique statuas, <lb xml:id="p1z8"/>nihil humani sanguinis sparsum.</s>
					<s n="5" xml:lang="la">Utinam nostris malis e<lb xml:id="p1z9"/>docti sapiant.</s>
					<s n="6" xml:lang="la"><persName>Granrieus</persName> legatus me de iis admonuit, <lb xml:id="p1z10"/>quae cum meque scire voluisti; inde tibi magna a nobis <lb xml:id="p1z11"/>debetur gratia.</s>
					<s n="7" xml:lang="la">Agitur a me sedulo, ne quid detrimenti <lb xml:id="p1z12"/>accipiamus; quam feliciter, deus viderit, qui consilia, cogitationes <lb xml:id="p1z13"/>ipsosque rerum ductus ab aeterno in numerato habet.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Haec ad te scripsi, non quod satis ad scribendum argumenti <lb xml:id="p1z15"/>suppeteret; sed nolui hunc meum sine nostris ad te literis <lb xml:id="p1z16"/><placeName ref="l587">Tigurum</placeName> proficisci.</s>
					<s n="9" xml:lang="la" ana="salute">Dominis <persName ref="p8011">Gvalthero</persName> <persName ref="p3988">Wolphioque</persName> salutem <lb xml:id="p1z17"/>plurimam, quam tibi a domino, reverende amice, aeternam <lb xml:id="p1z18"/>precor.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l760">Soloduri</placeName> 27. septembris 1566.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z19"/>Tuus ex animo <lb xml:id="p1z20"/><persName ref="p8160">Pomponne <lb xml:id="p1z21"/>Bellièvre</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p4z1"/>Reverendo d. domino <lb xml:id="p4z2"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p4z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p4z4"/>dignissimo.</s>
				</p>
			</div>
		</body>
	</text>
