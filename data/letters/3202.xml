	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mi pater, salvi et incolumes dei gratia r<lb xml:id="p1z2"/>evertimus, ubi satis prospera et salva omnia <lb xml:id="p1z3"/>comperimus.</s>
					<s n="3" xml:lang="la">fratres nostri <placeName ref="l736">Pedemontani</placeName> nihil <lb xml:id="p1z4"/>adhuc praeter minas senserunt, sed eas prorsus <lb xml:id="p1z5"/>atroces.</s>
					<s n="4" xml:lang="la">Compescat dominus Satanae rabiem, <lb xml:id="p1z6"/>sicut futurum quoque speramus.</s>
					<s n="5" xml:lang="la">D. <persName ref="p540">Calvinus</persName> <lb xml:id="p1z7"/>Confessionem valde probavit; sed cur aliam <lb xml:id="p1z8"/>nunc ineundam viam putet, iam, ut opinor, <lb xml:id="p1z10"/>ex ipsius literis cognovisti, quas a me abhinc biduum accepi<lb xml:id="p1z11"/>t <persName ref="p3375">Vergerius</persName> primo quoque tempore ad te perferendas.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Tempus brevissimum est, quanquam non dubito, <lb xml:id="p1z13"/>quin lantgravii caussa duas minimum hebdo<lb xml:id="p1z14"/>madas auferat, ut si quis ex nostris <placeName ref="l157">Francfordiam</placeName> <lb xml:id="p1z15"/>circiter calendas iulii venerit, non videatur <lb xml:id="p1z16"/>operam lusurus.</s>
					<s n="7" xml:lang="la">Insta, obsecro, et urge omnibus <lb xml:id="p1z17"/>modis.</s>
					<s n="8" xml:lang="la">Nam a nostris hoc responsum accepimus, <lb xml:id="p1z18"/>se non futuros in mora, si aliis ita faciendum <lb xml:id="p1z19"/>videbitur.</s>
					<s n="9" xml:lang="la">ut nihil aliud obtineatur, certe <lb xml:id="p1z20"/>eripuerimus furiosis illis apertam calumniae occasionem, <lb xml:id="p1z21"/>nos quum ultro ad concordiam provocemur tergi<lb xml:id="p1z22"/>versatos.</s>
					<s n="10" xml:lang="la">Sed et ipsos principes omnino spero <lb xml:id="p1z23"/>multo nobis futuros aequiores, ac illos proinde <lb xml:id="p1z24"/>multo moderatiores, si dominus dederit ut <lb xml:id="p1z25"/>coram, quae nobis rationes constent, intellexerint.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z26"/>Deinde, quam obsecro iniquum fuerit, optimi <lb xml:id="p1z27"/>et mihi crede supra quam testari possim in <lb xml:id="p1z28"/>hanc caussam concordiae propensi principis, <lb xml:id="p1z29"/>ultroneam postulationem aspernari?</s>
					<s n="12" xml:lang="la">Ergo, mi pater, <lb xml:id="p1z30"/>ego te obtestor, ut quanta maxima diligentia <lb xml:id="p1z31"/>ac sedulitate fieri poterit totum hoc negotium, <lb xml:id="p1z32"/>tum apud tuos tum apud reliquos nostros acceleres, <lb xml:id="p1z33"/>ne oblatam occasionem nobis e manibus elabi <lb xml:id="p1z34"/>sinamus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Sed de his satis.</s>
					<s n="14" xml:lang="la">Tabellam nostram <lb xml:id="p1z35"/>praedestinationis ad te mitto, de qua mihi <lb xml:id="p1z36"/>pergratum feceris si iudicium tuum ad me libere <lb xml:id="p1z37"/>perscripseris.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Bene vale, mi pater, d. Iesus <lb xml:id="p1z38"/>magis ac magis tuis sanctis laboribus <lb xml:id="p1z39"/>benedicat.</s>
					<s n="16" xml:lang="la">D. <persName ref="p8111">Martyrem</persName>, d. <persName ref="p8011">Galterum</persName> <lb xml:id="p1z40"/>caeterosque optimos et colendissimos fratres cupio <lb xml:id="p1z41"/>quam officiosissime meo nomine salutatri.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z42"/><placeName ref="l280">Lausanae</placeName> pridie pentecostes.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z43"/><persName ref="p8033">T<lb xml:id="p1z44"/>h. Beza</persName> plane tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio servo Christi <lb xml:id="p2z2"/>d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z4"/>vere fido pastori.</s>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
