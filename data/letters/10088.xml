			<zone xml:id="p2z4-0" points="1945,1319 2079,1304 2107,1325 2188,1317 2237,1335 2365,1299 2444,1309 2445,1265 2270,1277 2242,1252 2189,1274 2092,1251 2040,1271 2010,1260 1945,1297">1951,1304 1977,1299 2003,1298 2029,1298 2055,1298 2081,1298 2107,1298 2133,1298 2159,1298 2185,1298 2212,1296 2238,1295 2264,1295 2290,1294 2316,1292 2342,1290 2368,1289 2394,1289 2420,1290 2447,1292</zone>
			<zone xml:id="p2z5-0" points="1950,1950 1967,1956 1981,1952 1990,1961 2006,1963 2035,1946 2055,1951 2070,1945 2072,1877 2047,1874 2036,1879 2019,1870 1991,1876 1968,1858 1952,1860">1957,1942 1986,1939 2015,1937 2044,1937 2074,1939</zone>
