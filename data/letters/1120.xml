	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Vir clarissime, heri dedi cuidam mercator<lb xml:id="p1z2"/>i <lb xml:id="p1z3"/>fascem literarum, quem ad te perferet; at <lb xml:id="p1z4"/>hodie oblata est mihi occasio huiusce nun<lb xml:id="p1z5"/>cii, qui recta <placeName ref="l28">Basileam</placeName> proficiscitur.</s>
					<s n="2" xml:lang="la">Itaque <lb xml:id="p1z6"/>iterum scribo atque illud ipsum mitto, quod <lb xml:id="p1z7"/>in prioribus literis missi; nam si illae <lb xml:id="p1z8"/>forte perirent, hae quidem non peribunt.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z9"/>Accepi hodie literas a fratribus <placeName ref="l834">Italiae</placeName>, qui scribunt <lb xml:id="p1z10"/>oratorem regis <placeName ref="l2472">Poloniae</placeName> conquestum <lb xml:id="p1z11"/>fuisse apud <placeName ref="l425">Romanum</placeName> pontificem, quod non[n]ulli <lb xml:id="p1z12"/>diffamaverint suum regem, quasi coeperit <lb xml:id="p1z13"/>consentire doctrinae nostrae, addiditque eum <lb xml:id="p1z14"/>esse paratum etiam sanguinem pro <placeName ref="l425">Roman<lb xml:id="p1z15"/>a</placeName> <lb xml:id="p1z16"/>ecclesia adversum nos defendenda profundere.</s>
					<s n="4" xml:lang="la">Sic res est.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z17"/>Praeterea scribunt papam parare reformationem <lb xml:id="p1z18"/>nescio quam, scilicet ut amputet <lb xml:id="p1z19"/>occasionem, ne quis clamet in concilio.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z20"/>Persecutio fervet mirum in modum; rogate <lb xml:id="p1z21"/>pro fratribus illis.</s>
					<s n="7" xml:lang="la">Ego ad vos cogito <lb xml:id="p1z22"/>redire, imo necesse puto, ut redeam <lb xml:id="p1z23"/>pro Christi causa et nunciem vobis <lb xml:id="p1z24"/>multa, quae non ita possunt epistolis <lb xml:id="p1z25"/>committi.</s>
					<s n="8" xml:lang="la">Itaque dabo operam, ut cito <lb xml:id="p1z26"/>veniam.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Antichristus dedit negotium <lb xml:id="p1z27"/>cuidam Parascito, ut ad meos libros <pb/><lb xml:id="p2z1"/>respondeat, iamque respondit ad non[n]ullos, <lb xml:id="p2z2"/>sed impie, sed inepte, sed impudenter.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z3"/>Cum hoc mons<lb xml:id="p2z4"/>tro mihi erit aliquandiu certandum.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z5"/>Hic meus <persName ref="p8312">Cocleus</persName> futurus est.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z6"/>Audio nescio quid regem <placeName ref="l832">Gallorum</placeName> non libenter <lb xml:id="p2z7"/>concilii celebrationi consentire, puto <lb xml:id="p2z8"/>in odium Caesaris, qui ex concilio illud <lb xml:id="p2z9"/>sperat commodum, ut tota <placeName ref="l822">Germania</placeName> <lb xml:id="p2z10"/>ei serviat.</s>
					<s n="13" xml:lang="la"><placeName ref="l834">Itali</placeName> pro certo habent fore, <lb xml:id="p2z11"/>ut modo <placeName ref="l18">Augustae</placeName> <persName ref="p3590">Philippus</persName> detur <persName ref="p18538">Carolo</persName> <lb xml:id="p2z12"/>coadiutor et successor.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale, frater in <lb xml:id="p2z13"/>Christo, et deum roga pro me cum tota <lb xml:id="p2z14"/>ecclesia.</s>
					<s n="15" xml:lang="la" ana="salute">Saluto d. <persName ref="p8127">Pellicanum</persName>, <lb xml:id="p2z15"/>d. <persName ref="p8011">Gvalterum</persName>, d. <persName ref="p8171">Bibliandrum</persName>, d. <lb xml:id="p2z16"/><persName ref="p1283">Gesnerum</persName>, d. <lb xml:id="p2z17"/><persName ref="p1214">Frisium</persName>, d. <persName ref="p4091">Zvinglium</persName>, <lb xml:id="p2z18"/>d. <persName ref="p1888">Lavaterum</persName>, d. <persName ref="p8459">Otthonem</persName>, d. Iosiam.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z19"/>Deus vos servet a malo per Christum, dominum nostrum.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z20"/><placeName ref="l93">Claven[n]ae</placeName>, 23. decembris 1550.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z21"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo <lb xml:id="p4z2"/>viro domino <lb xml:id="p4z3"/><persName ref="p495">H[enrico] Bullingero</persName>.</s>
				</p>
