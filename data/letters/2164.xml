	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p714">C[oelius] S[ecundus] C[urio]</persName> per Christum dominum S. <lb xml:id="p1z2"/>D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><persName ref="p8101">Laelius</persName> noster mihi gratissimas a te literas attulit, <lb xml:id="p1z3"/>quibus semper tuum erga me amorem recognosco.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Quod de <persName ref="p487">Heinrycho</persName> filio tuo scribis, ut mihi eum <lb xml:id="p1z5"/>scrupulum eximas, qui pungebat animum, tibi <lb xml:id="p1z6"/>prorsus credo, etiam si <persName ref="p8101">Lęlio</persName> in diario tempus <lb xml:id="p1z7"/>meae et filli tui profectionis non ostendisses.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Itaque neque a me ullam in te offensionem profectam <lb xml:id="p1z9"/>fuisse neque quicquam de tuo in me amore diminutum <lb xml:id="p1z10"/>fuisse mihi deinceps persuadebo.</s>
					<s n="5" xml:lang="la">Quod vero etiam <lb xml:id="p1z11"/>meos De amplitudine regni dei dialogos attinet, <lb xml:id="p1z12"/>non video, quid hoc argumentum turbarum, praesertim piis, <lb xml:id="p1z13"/>possit afferre, cum faciat ad dei amplificandam <lb xml:id="p1z14"/>gloriam, quam maxime illustrare atque exaggerari <lb xml:id="p1z15"/>cupiunt pii omnes, nec amplificari, quantum satis <lb xml:id="p1z16"/>sit, atque eius meretur amplitudo, possit.</s>
					<s n="6" xml:lang="la">Neque enim <lb xml:id="p1z17"/>hic ullum est novum dogma, sed tantum de ea quaestione <lb xml:id="p1z18"/>in utranque partem disputatur idque sine <lb xml:id="p1z19"/>pertinacia.</s>
					<s n="7" xml:lang="la">Quamquam, ut aliis literis scripsi, plurimi <lb xml:id="p1z20"/>tuam admonitionem facio nec sum quicquam temer<lb xml:id="p1z21"/>e facturus, sed domini voluntatem expectaturus, <lb xml:id="p1z22"/>cui cum me atque omnia mea semel commendaverim <lb xml:id="p1z23"/>atque ipsius gloriae consecraverim, me aberrare <lb xml:id="p1z24"/>non patietur.</s>
					<s n="8" xml:lang="la">Et ago tibi etiam gratias pro <lb xml:id="p1z25"/>isto tuo consilio, tantum abest, ut aegre feram, <lb xml:id="p1z26"/>quod non aliunde quam ex amore erga me tuo <lb xml:id="p1z27"/>proficisci mihi persuadere non possum.</s>
					<s n="9" xml:lang="la" ana="salute">Uxor, <lb xml:id="p1z28"/>filii, amici ac praesertim <persName ref="p8101">Laelius</persName> te ex animo salutant, <lb xml:id="p1z29"/>ego vero etiam reverenter atque una <lb xml:id="p1z30"/>tuos omnes, quibus omnia feilcia precor.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l28">Basileae</placeName> <lb xml:id="p1z31"/>19. ianuarii 1554.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z32"/>Tuus ex animo <persName ref="p714">C[ae<lb xml:id="p1z33"/>lius] S[ecundus] <pb/><lb xml:id="p2z1"/>C[urio]</persName> subscripsit.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la">Clarissimo atque sapientissimo <lb xml:id="p2z2"/>viro domino <persName ref="p495">Henrycho [<lb xml:id="p2z3"/>Bu]llingero</persName>, antistiti <placeName ref="l587">[<lb xml:id="p2z4"/>Tigu]rino</placeName>, domino suo <lb xml:id="p2z5"/>observando.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
