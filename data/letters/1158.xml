	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Accepi binas literas simul, dedi tertias d. <persName ref="p714">Caelio</persName>, qui <lb xml:id="p1z2"/>dixit nihil se habere, quod rescribat; si quid novi ex <placeName ref="l834">Italia</placeName> habuerit, <lb xml:id="p1z3"/>tecum velle brevi communicare.</s>
					<s n="3" xml:lang="la">Ago etiam gratias tibi propter <lb xml:id="p1z4"/>nova illa, quę et nos habuimus; sed tu clariora scribis et <lb xml:id="p1z5"/>quędam addis, quę nobis non sunt scripta.</s>
					<s n="4" xml:lang="la">Expectamus in <lb xml:id="p1z6"/>singulas horas literas ex <placeName ref="l749">Saxonia</placeName>.</s>
					<s n="5" xml:lang="la">Communicavi <persName ref="p2916">Schertlin</persName> <lb xml:id="p1z7"/>et <persName>baron Georgio</persName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/><persName>Caesar</persName> nuper audivit missam, puto in festo trium regum, et quum <lb xml:id="p1z9"/>pfaffus praelegeret evangelium de <persName>Herode</persName>, corruit ipse in sacello Fug<lb xml:id="p1z10"/>geranorum; accursum est a ministris, et pfaffus reliquit in hoc <lb xml:id="p1z11"/>tumultu altare ad Caesarem currens ac clamans: "Domine Caesar, invoca <lb xml:id="p1z12"/>Iesum salvatorem."</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Sublevatus est et reportatus ad conclave suum.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Mox iussus accersiri ad se sororem <persName>Mariam</persName>, quę tunc erat <lb xml:id="p1z14"/><placeName ref="l513">Ulmę</placeName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Putant quidam illum tactum ab angelo dei quemadmodum <persName ref="p18508">Herodes</persName> in <lb xml:id="p1z15"/>Actis.</s>
					<s n="10" xml:lang="la">Dominus illius misereatur.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z16"/>Pulchre me irrides, quod parvum donulum miserim et maximum <lb xml:id="p1z17"/>receperimus.</s>
					<s n="12" xml:lang="la">Fortunatus sum mercator, si ita perrexero mercari; <lb xml:id="p1z18"/>brevi plura lucrari potero, quam <persName>Fuggerani</persName> habent.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Sed hęc ioco.</s>
					<s n="14" xml:lang="la" ana="farewell"><lb xml:id="p1z19"/>Vale.</s>
					<s n="15" xml:lang="la">Brevi plura.</s>
					<s n="16" xml:lang="la">A domino quęstore plura percipies.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z20"/>19. ianuarii 1551.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z21"/>T[uus] <persName ref="p1278">Gastius</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="de"><pb/><lb xml:id="p2z1"/>An den wolgelerten <lb xml:id="p2z2"/>herren <persName ref="p495">Heinrych <lb xml:id="p2z3"/>Bullinger</persName>, prędicanten <lb xml:id="p2z4"/>zuͦ <placeName ref="l587">Zurich</placeName> im münste<lb xml:id="p2z5"/>r, mynem günstigen <lb xml:id="p2z6"/>herren, zuͦ handen.</s>
					<s n="20" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
