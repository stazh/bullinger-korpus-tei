	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi literas tuas, compater et frater charissime, <lb xml:id="p1z2"/>diligenter de rebus omnibus stris scriptas ac gratias pro <lb xml:id="p1z3"/>iis ago maximas.</s>
					<s n="3" xml:lang="la">Perge sic, ut coepisti.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Cunctatur <lb xml:id="p1z4"/>rex, quia haeret.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Comitia nunc celebrantur <placeName ref="l21">Badae</placeName>, nec<lb xml:id="p1z5"/>dum militem regi concesserunt nisi <placeName ref="l160">Friburgenses</placeName> et <lb xml:id="p1z6"/><placeName ref="l760">Salodorii</placeName>; reliqui hactenus nihil concesserunt.</s>
					<s n="6" xml:lang="la">Suspicantur <lb xml:id="p1z7"/>tamen multi regem, ubi liberius numeraverit, <lb xml:id="p1z8"/>militem habiturum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Interim tamen certum <lb xml:id="p1z9"/>est <placeName ref="l28">Basilienses</placeName> et <placeName ref="l441">Schaffhusianos</placeName> et illos magis cogitare <lb xml:id="p1z10"/>de renuntiando foedere.</s>
					<s n="8" xml:lang="la">Militem, quem nunc <lb xml:id="p1z11"/>postulat, rex in <placeName ref="l834">Italiam</placeName> ducere cogitat, ut liberet <lb xml:id="p1z12"/>et educat exercitum <placeName>Guysianum</placeName>, cum quo <lb xml:id="p1z13"/>mox per <placeName ref="l736">Pedemontem</placeName> descendat in <placeName ref="l832">Galliam</placeName> <lb xml:id="p1z14"/><placeName ref="l808">Belgicam</placeName>.</s>
					<s n="9" xml:lang="la">At <placeName ref="l862">Helvetii</placeName> difficulter concedent militem, <lb xml:id="p1z15"/>qui proficiscatur prius in <placeName ref="l834">Italiam</placeName>; vident enim p<lb xml:id="p1z16"/>rofectionem illam fore periculosissimam.</s>
					<s n="10" xml:lang="de">Also söllend <lb xml:id="p1z17"/>belonet werden, die der heylikeit dienend.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Utinam <lb xml:id="p1z18"/>sapiant aliquando <placeName ref="l648">Rheti</placeName>, ne caesis militibus in servi<lb xml:id="p1z19"/>tio aut militia regis tandem cogantur se per<lb xml:id="p1z20"/>mittere diripiendos et laniandos <placeName ref="l834">Italis</placeName> atque <lb xml:id="p1z21"/><placeName ref="l875">Hispanis</placeName> totam ditionem suam relinquere <placeName ref="l1887">Athesinis</placeName> <lb xml:id="p1z22"/>et lanzknächtis etc.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Ex <placeName ref="l18">Augusta</placeName> scribunt amici <lb xml:id="p1z23"/><persName ref="p18477">Ferdinandum</persName> postulasse a <persName ref="p2916">Schertlio</persName> exercitum 5000 <lb xml:id="p1z24"/>peditum et 300 levis armaturae equitum, Schertlium <lb xml:id="p1z25"/>hic omnem suam operam contulisse regi et exquisitum <lb xml:id="p1z26"/>parasse regi exercitum, quem ducat contra <placeName ref="l2510">Turcam</placeName> <lb xml:id="p1z27"/>in <placeName ref="l2721">Pannoniam</placeName>.</s>
					<s n="13" xml:lang="la">Sed ecce, dum expectat, quando vocatur, <lb xml:id="p1z28"/>adest nuncius, qui ostendit regi nihil nunc opus <lb xml:id="p1z29"/>esse exercitu contra <placeName ref="l2510">Turcam</placeName>; proinde milites, quos <lb xml:id="p1z30"/>paravit, mittat <placeName ref="l1299">Riedlingam</placeName>, ubi <persName>Pollvylerus</persName> con<lb xml:id="p1z31"/>scripturus sit brevi exercitum 7000 peditum et 1000 equit<lb xml:id="p1z32"/>um, quem in <placeName ref="l808">Belgas</placeName> contra <placeName ref="l832">Gallum</placeName> ducat, nulla interim <lb xml:id="p1z33"/>mentione facta sumptuum etc.</s>
					<s n="14" xml:lang="la">Unde tantum non insaniunt <lb xml:id="p1z34"/>contra <persName ref="p18477">Ferdinandum</persName> et capitanei et milites.</s>
				</p>
				<p>
					<s n="15" xml:lang="de">Mitt sömlich<lb xml:id="p1z35"/>en fuulen sachen gadt man um.</s>
					<s n="16" xml:lang="la">Dicitur autem <persName>Phili<lb xml:id="p1z36"/>ppus</persName> parasse 3 ordines, primum educet <persName>dux Sa<lb xml:id="p1z37"/>baudiae</persName> contra <placeName>Marieburgum</placeName>, secundum <persName>Gonzaga</persName> (opinor<lb xml:id="p1z38"/>) ducet contra <placeName ref="l631">Burgundiam</placeName>, in tertio erit ipse <lb xml:id="p1z39"/><persName>Philippus</persName> cum suis Inferioris <placeName ref="l822">Germaniae</placeName> populis <pb/><lb xml:id="p2z1"/>et <placeName ref="l830">Anglis</placeName>; horum (ut ex <placeName ref="l15">Antverpia</placeName> pridie audivimus) <lb xml:id="p2z2"/>7000 applicarunt in Inferiore <placeName ref="l822">Germania</placeName> militaturi <lb xml:id="p2z3"/>Philippo contra <placeName ref="l832">Gallum</placeName>.</s>
					<s n="17" xml:lang="la">Summus <persName>imperator Anglorum</persName> est <lb xml:id="p2z4"/>comes <placeName>Penbrüggensis</placeName>, locum tenens d. <persName>Bron</persName>, consiliarii <lb xml:id="p2z5"/>comes <placeName>Ruttlandiae</placeName>, comes <placeName>Bettfordiae</placeName>, d. <persName>Bray</persName>, d. <lb xml:id="p2z7"/><persName>Clinchton</persName>, <persName>Dudlei</persName> etc.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Aiunt <persName>Philippum</persName> recta pr<lb xml:id="p2z8"/>ofecturum versus <placeName ref="l378">Lutetiam</placeName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Sic scribitur ab <placeName ref="l18">Augusta</placeName> <lb xml:id="p2z9"/>quoque et concorditer ex aliis locis; quamquam vero illa non <lb xml:id="p2z10"/>existimem vana esse prorsus, superare tamen rem <lb xml:id="p2z11"/>arbitror famam.</s>
					<s n="20" xml:lang="la"><foreign xml:lang="de">Der könig in <placeName ref="l832">Franckrych</placeName> wirt denocht <lb xml:id="p2z12"/>nitt also umbzuͦkeren sin,</foreign> nisi forte dies eius iam <lb xml:id="p2z13"/>quoque adsit et vindicta dei incubuerit super eum.</s>
					<s n="21" xml:lang="la"><lb xml:id="p2z14"/>Collo<lb xml:id="p2z15"/>quium <placeName ref="l569">Wormacię</placeName> dicitur procedere, sed sine principibus, <lb xml:id="p2z16"/>de quo alias plura, ubi certiora habuero.</s>
					<s n="22" xml:lang="la" ana="salute">Has <lb xml:id="p2z17"/>literas communes habebis ut et proximas ante 8 dies scriptas <lb xml:id="p2z18"/>cum dd. consulibus, <persName>Philippo</persName>, <persName ref="p6831">Traverso</persName>, d. <persName ref="p8432">Friderycho a <lb xml:id="p2z19"/>Salyce</persName>, ad quem tuis inclusas mittes omnesque salutabis <lb xml:id="p2z20"/>diligentissime.</s>
					<s n="23" xml:lang="la" ana="salute">Omnes mei te et tuam domum salutant.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p2z21"/>Sis fidelis et diligens in negotio domini.</s>
					<s n="25" xml:lang="la" ana="farewell">Vale <lb xml:id="p2z22"/>aeternum.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">Festinantissime.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 13. augusti 1557.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="29" xml:lang="de">Dem hoch- u<lb xml:id="p2z23"/>nd wolgelerten, frommen und getruwen herren <persName ref="p8009">Johansen Schmiden</persName>, pfarreren zuͦ S. Martin <lb xml:id="p2z24"/>ze <placeName ref="l98">Chur</placeName>, sin<lb xml:id="p2z25"/>em lieben herren und gevat<lb xml:id="p2z26"/>tern.</s>
					<s n="30" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>