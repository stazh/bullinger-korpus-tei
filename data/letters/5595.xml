	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Habes d. <persName ref="p8511">Christopherum Tretium</persName> vivam epistolam, <lb xml:id="p1z2"/>qui tibi omnia, quae ex <placeName ref="l832">Galliis</placeName> nunc hic et <placeName ref="l167">Gene<lb xml:id="p1z3"/>vae</placeName> habentur, narrare poterit, praesertim quae de altero <lb xml:id="p1z4"/>conflictu 7. huius mensis die facto, in quo <lb xml:id="p1z5"/><persName>Guisianus</persName> occisus fertur, de quo tamen plurimi ad<lb xml:id="p1z6"/>huc dubitant.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Sunt alii, qui dicant ipsum a conestabilis <lb xml:id="p1z7"/>filio confossum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ego neutrum adhuc credo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Deinde de <persName>Adresii</persName> defectione et eodem capto, <lb xml:id="p1z9"/>tum de <placeName>Condensi</placeName>, ubi et quomodo servetur.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute">Illis non <lb xml:id="p1z10"/>habeo quod addam, nisi quod consul <persName ref="p8063">Steigerus</persName> et <lb xml:id="p1z11"/>amici omnes te iubent salvere.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><persName ref="p7449">Diesbachius</persName> per <lb xml:id="p1z12"/><persName ref="p1227">Froschouerum</persName> nuper scripturus erat, si non tam cito <lb xml:id="p1z13"/>discessisset; nunc ergo has mittit literas.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Salutem <lb xml:id="p1z14"/>etiam tibi dicunt socer meus, mater et domestici <lb xml:id="p1z15"/>omnes.</s>
					<s n="9" xml:lang="la" ana="salute">Salutem dic quoque tuis omnibus meo nomine.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l41">Bernae</placeName> 21. <lb xml:id="p1z16"/>ianuarii 1561<note type="misc">3?</note>.</s>
					<s n="11" xml:lang="la"><persName ref="p8018">I[oannes]<lb type="manual"/> Hall[erus]</persName> tuus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">[Clar<lb xml:id="p1z17"/>issimo viro] d. <persName ref="p495">Heinrycho [<pb/><lb xml:id="p2z1"/>Bullingero</persName>, ecclesi]ae <lb xml:id="p2z2"/><placeName ref="l587">Tigurinae</placeName> [pastori] <lb xml:id="p2z3"/>fidelissimo, [domino su<lb xml:id="p2z4"/>o] honorando et [co<lb xml:id="p2z5"/>mpatri cha]rissimo.</s>
				</p>
			</div>
		</body>
