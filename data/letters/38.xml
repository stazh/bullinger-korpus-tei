			<zone xml:id="p2z3-0" points="2534,1160 2658,1186 2903,1146 3003,1201 3219,1143 3221,1079 3138,1105 3073,1071 2970,1105 2929,1081 2855,1112 2728,1071 2665,1114 2536,1102">2544,1155 2577,1148 2611,1145 2645,1144 2679,1148 2713,1147 2747,1145 2781,1143 2815,1140 2849,1140 2883,1140 2916,1140 2950,1137 2984,1137 3018,1136 3052,1134 3086,1132 3120,1132 3154,1132 3188,1133 3222,1135</zone>
