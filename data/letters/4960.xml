	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S. D.</s>
					<s n="2" xml:lang="la">Doctissime <persName ref="p495">Bullingere</persName> et charissime frater, <lb xml:id="p1z3"/>literas tuas ad me in iunio datas accepi, in <lb xml:id="p1z4"/>quibus mihi propter coniugium nuper initum congra<lb xml:id="p1z5"/>tularis, quo nomine tibi maximas gratias ago <lb xml:id="p1z6"/>dominum Iesum orans, ut in bona valetudine <lb xml:id="p1z7"/>et fidei analogia te tuosque quam diutissime con<lb xml:id="p1z8"/>servet.</s>
					<s n="3" xml:lang="la">Quae commemoras de <placeName ref="l862">Helvetiorum</placeName> aliorum<lb xml:id="p1z9"/>que populorum firma tranquillitate cum <lb xml:id="p1z10"/>incredibili gaudio legimus summum in nos odium <lb xml:id="p1z11"/>piosque fratres omnes vicissim vobis denuntiantes.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z12"/>Langravius et <persName>Palatinus</persName> nobiscum consentiunt; <lb xml:id="p1z13"/>dolet hoc eorum subditis et inferiori <lb xml:id="p1z14"/>magistratui, qui voluptuarius atque carnalis <lb xml:id="p1z15"/>est non intelligens, quae salutis sint humanae.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z16"/>Ego <persName>Wesaliae</persName> nullam conditionem arripio propter <lb xml:id="p1z17"/>saeva pericula; non enim nostri concionatores <lb xml:id="p1z18"/>rem, uti scripturae veritas tuaque sanctissima <lb xml:id="p1z19"/>scripta postulant, inquirere incipiunt.</s>
					<s n="6" xml:lang="la">Pastor vero <lb xml:id="p1z20"/>noster, cui <persName ref="p8497">Nicolao Rollio</persName> nomen est, rem pro caeteri s <lb xml:id="p1z21"/>dexterius intelligit, qui per me ad te sua opor<lb xml:id="p1z22"/>tunitate transcribet.</s>
					<s n="7" xml:lang="la">Quod ubi fuerit, perquam benevolis <lb xml:id="p1z23"/>literis eum hortare, ita tamen ut non intelligat ad <lb xml:id="p1z24"/>te quicquam per me de se perscriptum.</s>
					<s n="8" xml:lang="la">Est circumspecte <lb xml:id="p1z25"/>nunc ambulandum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><persName>Cassandrum</persName> non vidi; alioquin <lb xml:id="p1z26"/>mandati non fuissem immemor; ferunt eum a nobis <lb xml:id="p1z27"/>deficere et quodammodo discessisse.</s>
					<s n="10" xml:lang="la" ana="salute">Nobilem <persName ref="p8152">Adolphum <lb xml:id="p1z28"/>a Bars</persName> tuo nomine salutavi, qui hisce literis te <lb xml:id="p1z29"/>salutat.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Quibus si responderis, uti sperabit, nobis <lb xml:id="p1z30"/>quaeso respondeto.</s>
					<s n="12" xml:lang="la">Haec in nundinis <placeName ref="l157">Francofordianis</placeName> <lb xml:id="p1z31"/>exaravi in summa negotiorum meorum turba.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>In quibus nundinis tuae literae a <persName ref="p1227">Froschouero</persName> tu nostroque semper <lb xml:id="p2z2"/>exigentur; quem si vacuum vi erimus lituarum tuarum et <persName ref="p8429">My<lb xml:id="p2z3"/>liagrii</persName>, molestissime propter amorem nostrum singularem <lb xml:id="p2z4"/>erga te et tuos feremus.</s>
					<s n="14" xml:lang="la" ana="salute">Nunc vale cum electis et <persName ref="p8429">Myliagrium</persName> <lb xml:id="p2z5"/>saluta.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Subito <placeName ref="l157">Francoforti</placeName> 13. septembris 1561.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z6"/>Tuus ex animo <lb xml:id="p2z7"/><persName ref="p8005">Carolus Fabricius</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z8"/>Eruditio<lb xml:id="p2z9"/>ne et p<lb xml:id="p2z10"/>ietate or<lb xml:id="p2z11"/>na<lb xml:id="p2z13"/>tissimo viro d. <lb xml:id="p2z14"/><persName ref="p495">Heinrycho <lb xml:id="p2z15"/>Bul<lb xml:id="p2z16"/>linge<lb xml:id="p2z17"/>r<lb xml:id="p2z19"/>o</persName>, <lb xml:id="p2z21"/>vigi<lb xml:id="p2z22"/>lan<lb xml:id="p2z23"/>ti<lb xml:id="p2z26"/>s<lb xml:id="p2z27"/>s<lb xml:id="p2z30"/>imo <lb xml:id="p2z32"/><placeName ref="l587">Ti<lb xml:id="p2z33"/>g<lb xml:id="p2z34"/>u<lb xml:id="p2z35"/>rinae</placeName> <lb xml:id="p2z37"/>eccl<lb xml:id="p2z38"/>esiae pastori, <lb xml:id="p2z39"/>domin<lb xml:id="p2z40"/>o et patri <lb xml:id="p2z41"/>s<lb xml:id="p2z43"/>u<lb xml:id="p2z44"/>o cole<lb xml:id="p2z45"/>ndo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>