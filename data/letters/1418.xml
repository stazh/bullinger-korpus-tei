	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Tuas 20. septembris ut et superiores bona fide <lb xml:id="p1z2"/>accepi et ago tibi magnas gratias pro illa tua <lb xml:id="p1z3"/>fide et diligentia; satis enim intelligo te ex <lb xml:id="p1z4"/>lecto scribere; verum furiente modo Sathana <lb xml:id="p1z5"/>praestat omnino saepe colloqui.</s>
					<s n="3" xml:lang="la">Scripsi sane me <lb xml:id="p1z6"/>nihil scire de concilio, sed loqutus sum me n<lb xml:id="p1z7"/>ihil habere a <placeName ref="l1107">Tridento</placeName>; expecto enim in horas <lb xml:id="p1z8"/>bonorum virorum literas, ex quibus discam, quid <lb xml:id="p1z9"/>agant beati patres.</s>
					<s n="4" xml:lang="la">Alioqui non ignoro illud iam <lb xml:id="p1z10"/>sudare strenue et laborare, ut veritatem op<lb xml:id="p1z11"/>primant, praesertim cum videantur sibi tutorem <lb xml:id="p1z12"/>habere potentissimum <persName ref="p18538">Karlum</persName>.</s>
					<s n="5" xml:lang="la">Sed maledictus, qui confidit <lb xml:id="p1z13"/>in homine et ponit carnem brachium suum.</s>
					<s n="6" xml:lang="la">Nostri <lb xml:id="p1z14"/>heri abierunt ad comitia; fama sparsit <placeName ref="l41">Bernates</placeName> <lb xml:id="p1z15"/>non venturos.</s>
					<s n="7" xml:lang="la">Quid futurum sit, nescio; <lb xml:id="p1z16"/>plerique non aliam ob causam conscripta arbitrantur, <lb xml:id="p1z17"/>quam ut nostros et vestros rapiant in <lb xml:id="p1z18"/>consensionem et subiectionem concilii.</s>
					<s n="8" xml:lang="la">Spero illos, <lb xml:id="p1z19"/>si hoc postulaverint, operam et impensam per<lb xml:id="p1z20"/>dituros.</s>
					<s n="9" xml:lang="la">Si hoc agunt, ex consilio papae et Caesaris <lb xml:id="p1z21"/>omnia agunt, qui conabitur Helvetios inter se <lb xml:id="p1z22"/>committere, ut ipse interim expeditius <persName ref="p8112">Gallum</persName> <lb xml:id="p1z23"/>supereat, deinde totam Helvetiam excindat.</s>
					<s n="10" xml:lang="la">Huc <lb xml:id="p1z24"/>tendunt omnia hominis consilia; multi vero id vi<lb xml:id="p1z25"/>dere nolunt, partim invidia, partim avaritia <lb xml:id="p1z26"/>caecati; implent mensuram.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Dominus misericors <lb xml:id="p1z27"/>benigne nos ipsi fidentes respicere dignetur <lb xml:id="p1z28"/>ac subvertere consilia malignantium.</s>
					<s n="12" xml:lang="la">Scis <lb xml:id="p1z29"/>haud dubie <persName ref="p8112">Gallum</persName> in <placeName ref="l736">Pedemontana</placeName> occupasse <lb xml:id="p1z30"/>urbes 4, arces plurimas ac prorogasse suam <lb xml:id="p1z31"/>ditionem per 15 miliaria Italica; ea ratione <lb xml:id="p1z32"/>Caesaris exercitum avertit a <placeName ref="l1122">Parma</placeName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Interea vero <lb xml:id="p1z33"/>apertum dicitur bellum inter Caesarem et regem; <lb xml:id="p1z34"/>ita fortassis minus optatus eveniet concilii eventus; <lb xml:id="p1z35"/>implicabuntur forte plurimorum consilia.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z36"/>Simus nos constantes in domino, oremus, vigilemus.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z37"/>Dominus Iesus te restituat sanitati.</s>
					<s n="16" xml:lang="de"><lb xml:id="p1z38"/>Unsere <lb xml:id="p1z39"/>habend uff den tag gar kein befälch dann zu<lb xml:id="p1z40"/>ͦ losen.</s>
					<s n="17" xml:lang="la" ana="farewell">Vale aeternum.</s>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 29. septembris 1551.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z41"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p8418">Osvaldo <lb xml:id="p2z2"/>Myconio</persName>, domino <lb xml:id="p2z3"/>venerando et fratri <lb xml:id="p2z4"/>charissimo suo.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l28">Basileae</placeName>.</s>
				</p>
			</div>
