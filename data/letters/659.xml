	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve iterum atque iterum.</s>
					<s n="2" xml:lang="la">Omnia bella spirare, <placeName ref="l822">Germaniae</placeName> vastitatem <lb xml:id="p1z2"/>indicare non mirum; peccata nostra id iam olim ferre debebant.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Uno impetu volunt adversarii nostri evangelium Christi perdere ac radicitus <lb xml:id="p1z4"/>extirpare, licet non cogitent Christum suam ecclesiam habiturum invitis inferorum <lb xml:id="p1z5"/>portis.</s>
					<s n="4" xml:lang="la">Utinam <placeName ref="l862">Helvetia</placeName> tandem saeperet et de pace seria cogitaret; <lb xml:id="p1z6"/>dissidia enim illa intestina si auxerint sese, omnino nos perdent ac ausum <lb xml:id="p1z7"/>hostibus nostris hereditariis dabunt nos aggrediendi idque non uno in <lb xml:id="p1z8"/>loco.</s>
					<s n="5" xml:lang="la"><placeName ref="l257">Constantia</placeName> erit propugnaculum forte contra vestrum agrum; <persName>Dola</persName> <lb xml:id="p1z9"/>munitur contra <placeName ref="l41">Bernates</placeName>; Paganis erit multum negotii cum <persName ref="p17907">Gonzaga</persName> <lb xml:id="p1z10"/><placeName ref="l306">Mediolanensi</placeName>, et <persName>Rheti</persName> proprium habebunt hostem, qui eos divexaturus est.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Gallus ingentem cladem sensit ab <placeName ref="l830">Anglo</placeName>, qui multum damni illaturus <lb xml:id="p1z12"/>est <placeName>Gallo</placeName>, nisi totis viribus restiterit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><persName ref="p18538">Caesaris</persName> doli hic apparent.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Postquam ambo reges vires proprias attriverint, pecunias in res <lb xml:id="p1z14"/>bellicas insumpserint, aderit oportuno tempore et aleam belli tentabit <lb xml:id="p1z15"/>cum lassis et exhaustis.</s>
					<s n="9" xml:lang="la">Utinam Helvetia hęc cogitaret et patrię terrę <lb xml:id="p1z16"/>pacem non contemneret.</s>
					<s n="10" xml:lang="la">Quis enim malus genius corda nostra obnubilat, <lb xml:id="p1z17"/>ut, quę ventura sunt, cogitemus minime.</s>
					<s n="11" xml:lang="la">Certe nos in causa sumus <lb xml:id="p1z18"/>et peccata nostra.</s>
					<s n="12" xml:lang="la"><persName>Sępius</persName> cogito propheticum <persName ref="p1974">Lutheri</persName> dictum de <placeName ref="l862">Helvetia</placeName> <lb xml:id="p1z19"/>dissolvenda sub iugumque mittenda, et dissidium illud dabit occasionem hostibus <lb xml:id="p1z20"/>nostris dictum illud adimplendum.</s>
					<s n="13" xml:lang="la">Verum de iis rebus alias.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z21"/><persName ref="p8353">Frobenio</persName> debes 3 fl. eamque pecuniam domino, apud quem <lb xml:id="p1z22"/>filius illius convictorem agit, dabis.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z23"/>Scripsi domino <persName ref="p18383">Rihelio</persName>, ut libros <persName ref="p3088">Sturmii</persName> ad me mittat, quos tu <lb xml:id="p1z24"/>in scheda significasti, et promisit se velle mittere brevi; eam ob rem <lb xml:id="p1z25"/>ne sis sollcitus te accepturum hos libellos.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z26"/>Diacosii hodie congregati audiverunt houptman <persName>Frölich</persName> garrient<lb xml:id="p1z27"/>em, et adiectis conditionibus in fędus <placeName>Gallicum</placeName> nostri con<lb xml:id="p1z28"/>senserunt.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Dominus bene fortunet illud negotium.</s>
					<s n="18" xml:lang="la">Sancietur illud <lb xml:id="p1z29"/>fędus absque dubio non sine sanguine innocentum.</s>
					<s n="19" xml:lang="la">26. augusti.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z30"/>Tuus <lb xml:id="p1z31"/>G.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="21" xml:lang="la">Dom<lb xml:id="p1z32"/>ino <persName ref="p495">Bul<pb/><lb xml:id="p2z1"/>lingero</persName> <lb xml:id="p2z2"/>suo.</s>
				</p>
			</div>
		</body>
	</text>
