	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hodie alteras tuas accepi per <persName ref="p8214">Paulum Knibbe</persName>, <lb xml:id="p1z2"/><placeName ref="l640">Flandrum</placeName>, missas una cum iis, quę ex Dialogis <lb xml:id="p1z3"/><persName ref="p2336">Ochini</persName> excerpsistis.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Eadem tibi per hunc vestratem <lb xml:id="p1z4"/>nunc remitto et puto tibi meis prioribus, quas <lb xml:id="p1z5"/>interea accipies, esse satisfactum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ego illis quod <lb xml:id="p1z6"/>nunc addam amplius non habeo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><persName ref="p2336">Bernhardinus</persName> omnibus <lb xml:id="p1z7"/>nobis exemplum esse debet, ut caveamus ab eiusmodi ingeniis, <lb xml:id="p1z8"/>quorum nimis multa sunt, quę ecclesiis nostris pacem, <lb xml:id="p1z9"/>qua fruuntur, invident et vellent omnia sursum deorsum <lb xml:id="p1z10"/>versa esse, ut ipsi in maiore haberentur precio.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Arbitror <lb xml:id="p1z11"/>illum in <placeName ref="l2472">Poloniam</placeName> concessurum, ut illic sibi ecclesiam <lb xml:id="p1z12"/>pro arbitrio constituat.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Miseret interea me senii <lb xml:id="p1z13"/>illius et liberorum.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Dominus illi det mentem sanam!</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z14"/>Dialogos ipsos non vidi; sed ex <persName ref="p8095">Zerchinte</persName> archigram<lb xml:id="p1z15"/>mataeo<note xml:id="fn1" type="footnote" n="1"><persName ref="p8095">Zurkinden</persName>.</note> nostro, qui eos <placeName ref="l28">Basileae</placeName> vidit, audivi <lb xml:id="p1z16"/>nescio quę turpia etiam in illis contineri de conceptione <lb xml:id="p1z17"/>domini; nescio, an illo observaveris.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Bene <lb xml:id="p1z18"/>ageretur cum illo, si una cum interprete suo migraret <lb xml:id="p1z19"/>ad dominum; sed fiat, quod domino visum est.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Expecto, <lb xml:id="p1z20"/>ut ad hesternas meas diligenter respondeas.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Pro <lb xml:id="p1z21"/>hisce vero communicatis mihi magnas tibi habeo gratias <lb xml:id="p1z22"/>oroque dominum, ut te tuosque totamque ecclesiam vestram <lb xml:id="p1z23"/>tueatur et conservet.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Salutant te fratres et amici <lb xml:id="p1z24"/>omnes, praesertim <persName ref="p8063">Steigerus</persName>, qui tibi pro literis ad ipsum missis <lb xml:id="p1z25"/>agit gratias et orat, ut illi parcas, quod propter occu<lb xml:id="p1z26"/>pationes nimias rarius ad te scribit; <persName ref="p7449">Diesbachius</persName> <lb xml:id="p1z27"/>item, <persName ref="p7511">Grafenrietus</persName>, <persName ref="p8012">Hallerus</persName>, <persName ref="p8389">Hagius</persName>, socer, <lb xml:id="p1z28"/><persName ref="p4060">Zehenderi</persName> <lb xml:id="p1z29"/>et multi alii te impense salutant.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l41">Bernae</placeName> <lb xml:id="p1z30"/>16 decembris 1563.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z31"/><persName ref="p8018">Ioh[annes]<lb type="manual"/> Hallerus</persName> <lb xml:id="p1z32"/>tuus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro, d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae antistiti <lb xml:id="p2z4"/>fidelissimo, domino <lb xml:id="p2z5"/>suo honorando <lb xml:id="p2z6"/>et compatri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
