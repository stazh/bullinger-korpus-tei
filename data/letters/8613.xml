			<zone xml:id="p4z6-0" points="2666,1870 2676,1868 2694,1880 2717,1866 2735,1880 2744,1875 2758,1878 2763,1820 2740,1817 2733,1810 2719,1822 2701,1829 2699,1824 2671,1817">2676,1869 2705,1867 2734,1864 2763,1861</zone>
