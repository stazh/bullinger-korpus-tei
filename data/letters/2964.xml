	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a deo patre per Christum servatorem etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Peregrin<lb xml:id="p1z2"/>us noster Assulanus cum iam abituriret, quamvis impetrata satis honorifica <lb xml:id="p1z3"/>missione actaeque vitae testimonio a dominis scholarchis <lb xml:id="p1z4"/>nostris, voluit tamen etiam per nos commendari erga humanitatem tuam.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Certe, si diutius apud nos manere voluisset, schola nostra opera ipsius libens <lb xml:id="p1z6"/>usa fuisset; sed quando aliter rationibus suis consuli non posse existimat, <lb xml:id="p1z7"/>nisi cum se recipiat istuc, nostrum non erat ipsum impedire, <lb xml:id="p1z8"/>qui maluissemus promotum.</s>
					<s n="4" xml:lang="la">Vitam, quantum nobis scire datum, una <lb xml:id="p1z9"/>cum familia sua satis honeste transegit, diligens fuit in ludo literario.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Interfuimus aliquando ipsius concionibus, quas pro gratia dei satis <lb xml:id="p1z11"/>dextre tractavit, neque dubitamus, quin, si qua ipsi ecclesia concredita <lb xml:id="p1z12"/>fuerit, officio suo satis sit facturus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Rogamus igitur quam offi<lb xml:id="p1z13"/>ciosissime, ut ipsum commendatum habere velitis, ut intelligat nostram <lb xml:id="p1z14"/>commendationem non vulgarem fuisse.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>De provisoribus concessis gratias <lb xml:id="p1z16"/>agimus sperantes ipsos pubi nostrae multu commodaturos.</s>
					<s n="8" xml:lang="la" ana="salute">Salutan<lb xml:id="p1z17"/>t te symmystae mei.</s>
					<s n="9" xml:lang="la" ana="salute">Salvos apud vos cupio omnes</s>
					<s n="10" xml:lang="la">Raptim <lb xml:id="p1z18"/><placeName ref="l441">Scaffhusii</placeName> 11. iulii anno salutis humanae 1556.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/>Tuus ex animo <lb xml:id="p1z20"/><persName ref="p3481">Simpertus Vogt</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio Christi servo <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>pastori vigilantissimo, <lb xml:id="p2z4"/>domino suo observando <lb xml:id="p2z5"/>et fratri charissimo.</s>
					<s n="13" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
