	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S[pectatissime] D[omine.]</s>
					<s n="2" xml:lang="la">Spero <persName>Hispanum</persName> cui mense Julio literas <lb xml:id="p1z2"/>a te dedi, bona fide reddidisse.</s>
					<s n="3" xml:lang="la">Erat enim <lb xml:id="p1z3"/>vir bonus et tui pietatisque amantissimus.</s>
					<s n="4" xml:lang="la">Julio nomen <lb xml:id="p1z4"/>erat illi: qui et singularia quaedam de te <lb xml:id="p1z5"/>referebat.</s>
					<s n="5" xml:lang="la">Alioquin enim non soleo cuivis literas <lb xml:id="p1z6"/>credere.</s>
					<s n="6" xml:lang="la">In iis cupiebam certior fieri per te <lb xml:id="p1z7"/>num literae meae superiori anno scriptae ad <lb xml:id="p1z8"/>amplissimum virum D. <persName ref="p8152">Adolphum a Baers</persName> et transmissae <lb xml:id="p1z9"/>per <persName ref="p1227">Froschoverum</persName> ad te, D. <persName ref="p8152">Adolpho</persName> sint traditae.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Nollem enim illas interiisse.</s>
					<s n="8" xml:lang="la">Ac nondum <lb xml:id="p1z11"/>vel verbo significatum est mihi acceperit ve <lb xml:id="p1z12"/>illas an non acceperit.</s>
					<s n="9" xml:lang="la">Fac igitur mi frater <lb xml:id="p1z13"/>ut certius hic aliquid sciam.</s>
					<s n="10" xml:lang="la">Deinde audio <lb xml:id="p1z14"/>te habere Polychronicum et alios authores Graecos, <lb xml:id="p1z15"/>quos verteris in Latinum e Graeco.</s>
					<s n="11" xml:lang="la">Cur vero <lb xml:id="p1z16"/>hunc thesaurum tibi retines?</s>
					<s n="12" xml:lang="la">Communica hunc <lb xml:id="p1z17"/>ecclesiae et fratribus.</s>
					<s n="13" xml:lang="la">Non magni facio alioquin <lb xml:id="p1z18"/>novos illos libros Graecorum, qui hodie veterum <lb xml:id="p1z19"/>Scriptorum proferuntur in lucem.</s>
					<s n="14" xml:lang="la">Metuo enim <lb xml:id="p1z20"/>quosdam his non bona fide uti.</s>
					<s n="15" xml:lang="la">Cum autem <lb xml:id="p1z21"/>tua fides probitasque perspectissima mihi sit, <lb xml:id="p1z22"/>magni facerem sane quod prodiret a te.</s>
					<s n="16" xml:lang="la">Fac <lb xml:id="p1z23"/>igitur mi frater ut aliquando et mature bonis <lb xml:id="p1z24"/>illis authoribus fruamur.</s>
					<s n="17" xml:lang="la">Audisti fortassis <lb xml:id="p1z25"/>quid potentes hujus seculi instituant de Concilio <lb xml:id="p1z26"/>celebrando.</s>
					<s n="18" xml:lang="la">Liberum dicitur ab illis, sed <lb xml:id="p1z27"/>more veteri celebrabitur neque in alium finem <lb xml:id="p1z28"/>quam dolosum celebrabitur.</s>
					<s n="19" xml:lang="la">Dominus dissipet <lb xml:id="p1z29"/>omnia impiorum consilia, et servet afflictam <lb xml:id="p1z30"/>suam ecclesiam liberetque a malo.</s>
					<s n="20" xml:lang="la" ana="salute">Saluta offi<lb xml:id="p1z31"/>ciosissime <persName>Cornelium</persName> tuum, et mei amantes <lb xml:id="p1z32"/>qui apud vos <placeName ref="l267">Coloniae</placeName> sunt.</s>
					<s n="21" xml:lang="la" ana="farewell">Vale.</s>
					<s n="22" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, <lb xml:id="p1z33"/>28 Augusti 1560</s>
					<s n="23" xml:lang="la"><lb xml:id="p1z34"/><persName ref="p495">BU<pb/><lb xml:id="p2z1"/>LLING<lb xml:id="p2z2"/>ERU<lb xml:id="p2z3"/>S</persName> tuu<lb xml:id="p2z4"/>s<lb xml:id="p2z6"/>.</s>
				</p>
			</div>
		</body>
	</text>
