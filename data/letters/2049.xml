	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. <lb xml:id="p1z2"/>P. D.</s>
					<s n="2" xml:lang="la">Qui meas tibi adfert literas, <persName ref="p495">Bullingere</persName> clarissime, privignus <lb xml:id="p1z3"/>quidem meus est, quem tamen propter raras ingenii dotes <lb xml:id="p1z4"/>non minus amem, quam si ex meo cerebro natus esset.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Dedit <lb xml:id="p1z5"/>operam philosophiae studio et linguis in <placeName ref="l832">Galliis</placeName> ad quin<lb xml:id="p1z6"/>quennium fere, ubi sub doctissimis praeceptoribus satis fe<lb xml:id="p1z7"/>liciter profecit.</s>
					<s n="4" xml:lang="la">Revocavi ante duos menses et cupiebam, <lb xml:id="p1z8"/>ut apud nos theologiae saniori navaret operam et aliquando <lb xml:id="p1z9"/>ad ministerium vocatus ecclesiae prodesset; verum me<lb xml:id="p1z10"/>dicinae studium cum magis arriserit, quam sperabam, nolui, ut <lb xml:id="p1z11"/>refragante ingenio tentaret aliud, cum invita Minerva <lb xml:id="p1z12"/>nihil boni atque perfecti parturiat.</s>
					<s n="5" xml:lang="la">Cupio igitur, ut <lb xml:id="p1z13"/>cum <persName>Petro Bernate</persName>, viro optimo in <placeName ref="l834">Italiam</placeName> proficiscatur <lb xml:id="p1z14"/>et <placeName ref="l377">Paduae</placeName> per anni spatium medicinae incumbat, quam ibi <lb xml:id="p1z15"/>maxime etiam florere audio.</s>
					<s n="6" xml:lang="la">Cum igitur per <placeName ref="l587">Tigurum</placeName> <lb xml:id="p1z16"/>profectionem instituerint, nolui filium ad amicum vacuum <lb xml:id="p1z17"/>omnino meis literis mittere.</s>
					<s n="7" xml:lang="la">Nihil novi nunc circum<lb xml:id="p1z18"/>fertur apud nos, qui subinde aliquid ex tuis literis <lb xml:id="p1z19"/>venamur.</s>
					<s n="8" xml:lang="la">Misi nuper ad te catalogum librorum hac <lb xml:id="p1z20"/>aestate apud nos excus rum, quem iam dudum te accepisse <lb xml:id="p1z21"/>spero, et num quid ex his elegeris tibi, proximis literis <lb xml:id="p1z22"/>audire percupio.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale cum <persName ref="p8171">Theodoro Bibliandro</persName>, <lb xml:id="p1z23"/><persName ref="p8011">Gvaltero</persName>, <persName ref="p1214">Frisio</persName> atque aliis amicis ac fratribus felicissime.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z24"/>Datae <placeName ref="l28">Basileae</placeName> 25. octobris anno domini 1553.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z25"/>T[uus] <persName ref="p8406">Con[<lb xml:id="p1z26"/>radus] Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> vero episcopo, <lb xml:id="p2z4"/>domino atque amico incom<lb xml:id="p2z5"/>parabili.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l587">Tigurum</placeName><lb xml:id="p2z8"/>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>