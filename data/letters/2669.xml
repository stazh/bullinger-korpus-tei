	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z3"/>Misericordia et salus a mediatore nosrto <lb xml:id="p1z4"/>unico Iesu Christo.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">S. D.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Dum ante dies aliquot <placeName ref="l587">Tyguri</placeName> essem teque abesse cog<lb xml:id="p1z6"/>noscerem, non mediocriter equidem fui contristatus; <lb xml:id="p1z7"/>magni etiam, uti soleo, sic etiam nunc magis facio coll<lb xml:id="p1z8"/>oquia tua sancta consiliaque saluberrima, quibus a te <lb xml:id="p1z9"/>saepius doctior sanctiorque discessi.</s>
					<s n="4" xml:lang="la">Nunc saltem <lb xml:id="p1z10"/>officii causa hoc ad te de me optime meritum <lb xml:id="p1z11"/>volui scribere, ut non minus sincere, quam semper <lb xml:id="p1z12"/>consuevisti, de me meaque in relligione vera sententia <lb xml:id="p1z13"/>opinionem concipias, idque ob id, quod in mutando <lb xml:id="p1z14"/>loco equum asino praeposuisse videar.</s>
					<s n="5" xml:lang="la">In quo <lb xml:id="p1z15"/>equidem consilii mei rationes d. <persName ref="p8127">Pellicano</persName>, praeceptori <lb xml:id="p1z16"/>meo honorando, sat copiose exposuisse existimo.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z17"/>De statu ecclesiae <placeName ref="l734">Phrysiacae</placeName> redderem te certiorem, <lb xml:id="p1z18"/>nisi id alias ab <persName ref="p8041">I[oanne] a Lasco</persName> aut ab hoc conterraneo meo <lb xml:id="p1z19"/>cognoscere potuisses, qui ecclesiae vestrae videndae causa <lb xml:id="p1z20"/>ad vos hoc, quidquid est, suscepit itineris.</s>
					<s n="7" xml:lang="la">Huius <lb xml:id="p1z21"/>parens a comitibus facile secundus relligionis amantissimus <lb xml:id="p1z22"/>et <placeName ref="l587">Tygurinae</placeName> maxime deditus ecclesiae necnon a <persName ref="p4112">Gerardo <lb xml:id="p1z23"/>a Campff</persName> in meis literis tibi aliquando commendatus fuit.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z24"/>Praestita igitur solita vestra, qua erga omnes, etiam <lb xml:id="p1z25"/>in hunc benevolentia non dubito, quin humanita<lb xml:id="p1z26"/>te etiam vestra ab illo animadversa acriores sti<lb xml:id="p1z27"/>mulos fraternae charitatis fideique suppeditabit <lb xml:id="p1z28"/>et uti hactenus sic etiam in dies magis magisque <lb xml:id="p1z29"/>membra Christi coalescere incipiamus.</s>
					<s n="9" xml:lang="la" ana="farewell">His nunc <lb xml:id="p1z30"/>paucis vale.</s>
					<s n="10" xml:lang="la" ana="salute">Salutabis dominos ac venerandos <lb xml:id="p1z31"/>patres et fratres in Christo.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z32"/><placeName ref="l28">Basileae</placeName> anno liberationis humanae <lb xml:id="p1z33"/>1555 pridie idus iulii.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z34"/><persName ref="p8508">Nicolaus a Starkhenburg</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pio, doctissimo viro <persName ref="p495">Hinrico <lb xml:id="p2z2"/>Bullingero</persName>, episcopo <lb xml:id="p2z3"/><placeName ref="l587">Tygurino</placeName> fidelissim[o], <lb xml:id="p2z4"/>praeceptori meo <lb xml:id="p2z5"/>charissimo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tyguri</placeName>.</s>
				</p>
