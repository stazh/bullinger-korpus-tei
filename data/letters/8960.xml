	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi omnia tua, dilecte mi frater, sed nondum <lb xml:id="p1z2"/>vel dimidiatem partem legi negotiis impedit s, <lb xml:id="p1z3"/>tum et capitis debilitate varietate n<lb xml:id="p1z4"/>egotiorum conciliata.</s>
					<s n="3" xml:lang="la" ana="salute">Remitto tamen literas optimi viri <lb xml:id="p1z5"/>d. <persName ref="p2776">Ruinelli</persName>, quem meo nomine salutabis.</s>
					<s n="4" xml:lang="la">Ita mihi tu<lb xml:id="p1z6"/>multus rusticanus propter decimas displicet, ut magis <lb xml:id="p1z7"/>displicere non posset.</s>
					<s n="5" xml:lang="la">Cohercendi sunt sane et <lb xml:id="p1z8"/>rationibus commodis ad aequitatem reducendi.</s>
					<s n="6" xml:lang="la">Huiusmodi <lb xml:id="p1z9"/>conatus vere sunt seditiosi quique multum offendunt <lb xml:id="p1z10"/>nostros adversarios nec immerito.</s>
					<s n="7" xml:lang="la">Dum <lb xml:id="p1z12"/>ambasatoris nostri (?) calumniam audissemus, aderant ex <lb xml:id="p1z13"/>senatu nonnulli.</s>
					<s n="8" xml:lang="la">Ego excipiebam: 'Cum hic in <lb xml:id="p1z14"/>urbe sit, quid si accederemus eum et inquireremus?</s>
					<s n="9" xml:lang="la">[<lb xml:id="p1z15"/>Responsum nobis:] Magistratus est hac in re agere, <lb xml:id="p1z16"/>quod decet.'</s>
					<s n="10" xml:lang="la">Caeterum dum interrogo hodie, quid <lb xml:id="p1z17"/>factum sit, intelligo rem nondum delatam ad senatum <lb xml:id="p1z18"/>et quosdam contemnere illius hominis multas ob caussas <lb xml:id="p1z19"/>futilitatem.</s>
					<s n="11" xml:lang="la">Dubito ergo, quid futurum sit.</s>
					<s n="12" xml:lang="la">Ipse quoque <lb xml:id="p1z20"/>non magni facio illius accusationem, si propius ex<lb xml:id="p1z21"/>pendero, quam facile illi sit negare ante dicta.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Suadeo itaque, tibi ipsi haec serves, non erum<lb xml:id="p1z23"/>pas; qua de re et <persName ref="p8442">Simlerus</persName> ad te...<note type="margin">a.R.: ...?</note></s>
					<s n="14" xml:lang="la">Nihil <lb xml:id="p1z24"/>autem stultius (condona hoc mihi) faceres, quam si <lb xml:id="p1z25"/>apologiam scriberes ad Helvetiorum legatos.</s>
					<s n="15" xml:lang="la">Si ignoras: <lb xml:id="p1z26"/>non legerent, conspuerent, lacerarent, proculcarent etc.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z27"/>Quae hisce diebus variis ex locis ab amicis accepi, <lb xml:id="p1z28"/>mitto, ut cum amicis et familiaribus legas, deinde <lb xml:id="p1z29"/>remittas.</s>
					<s n="17" xml:lang="la">Plura iam non possum.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">Saluta amicos <lb xml:id="p1z30"/>ordine omnes.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Ocyssime.</s>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 18. iulii, <lb xml:id="p1z31"/>quo die ante annos 68 in has erumnas et miserias sum natus, <lb xml:id="p1z32"/>1572.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z33"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><foreign xml:lang="la"><lb xml:id="p1z34"/><persName ref="p1227">Froschouerus</persName> agit tibi gratia<lb xml:id="p1z35"/>s</foreign> u<lb xml:id="p1z36"/>nd wil noch ein zyt <lb xml:id="p1z37"/>warten etc.</s>
				</p>
				<p>
					<s n="23" xml:lang="de"><pb/><lb xml:id="p2z1"/>Minem lieben <lb xml:id="p2z2"/>herren und guͦten <lb xml:id="p2z3"/>fründ h. <persName ref="p8016">Thobia <lb xml:id="p2z4"/>Egli</persName>, pfarrer zuͦ <lb xml:id="p2z5"/>S. Martin zuͦ <placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
