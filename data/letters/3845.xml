	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Pax et... per Christum Iesum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>S. A genero tuo, imo filio, meoque veteri discipulo ac <lb xml:id="p1z3"/>tanquam charissimo filio, literas tuas cum d. <persName ref="p8041">a Laski</persName> <lb xml:id="p1z4"/>literis accepi, quae mihi et reliquis fratribus iu<lb xml:id="p1z5"/>cundissimę fuerunt, et merito; nam quanta accessio <lb xml:id="p1z6"/>fiat regno dei, si in regno <placeName ref="l2472">Poloniae</placeName> amplissimo Christus <lb xml:id="p1z7"/>dominus recipiatur.</s>
					<s n="3" xml:lang="la">Atque quidem orandus est <lb xml:id="p1z8"/>pater caelestis, quod et ipse petit d. <persName ref="p8041">a Lascus</persName>, ut <lb xml:id="p1z9"/>det gratiam suis et virtutem regni sui asserendi <lb xml:id="p1z10"/>et amplificandi.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Hoc bonum nuntium, quibus scripsisti, <lb xml:id="p1z11"/>mittam et communicabo libentissime.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quod autem petis, <lb xml:id="p1z12"/>ut eum in vos animum retineam, quem hactenus habui, <lb xml:id="p1z13"/>non est, quod dubites, domine et frater amicissime et <lb xml:id="p1z14"/>colendissime; sum enim is, qui semper fui, qui mei magis <lb xml:id="p1z15"/>oblivisci quam tuorum in me meritorum possim et debeam.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z16"/>At multo magis hoc mihi a te contendendum est, ut <lb xml:id="p1z17"/>me amare pergas neque malevolorum meorum calumniis <lb xml:id="p1z18"/>aures tu s religiosissimas prębere velis; sunt enim <lb xml:id="p1z19"/>quidam, qui fratrum nomine se venditant, re autem <lb xml:id="p1z20"/>vera inimici non modo nobis, verum etiam Christi domini <lb xml:id="p1z21"/>crucis, mendaces, malae bestiae, ventres pigri non <lb xml:id="p1z22"/>minus quam Cretenses illi, in quos invehitur Paulus.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z23"/>Quare te etiam atque etiam oro, ut adversus tales <lb xml:id="p1z24"/><persName ref="p714">Caelium</persName> tuum tueare, qui te amat, reveretur et <lb xml:id="p1z25"/>tanquam parentem cum omnibus tuis observat <lb xml:id="p1z26"/>pro sua tenuitate.</s>
					<s n="8" xml:lang="la" ana="salute">Mea uxor et filiae tuis <lb xml:id="p1z27"/>omnibus salutem dicunt eisque omnia fausta preca[n]tur.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Vale, <lb xml:id="p1z28"/>domine et frater amantissime, et tuos meo quoque nomine <lb xml:id="p1z29"/>saluta.</s>
					<s n="10" xml:lang="la"><placeName ref="l28">Basileae</placeName> 20. ianuarii 1559.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><persName ref="p714">C[aelius] <lb xml:id="p1z30"/>S[ecundus]</persName> ex animo <lb xml:id="p1z32"/>semper tuus scripsit.</s>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>[anti]stiti vigilantissimo, <lb xml:id="p2z5"/>domino et fratri colendissimo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
