	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. Rogo te, mi d. Bullingere, ut quamprimum
					<lb xml:id="p1z2"/>me certiore facias, ubi dit Vergerius est
					<lb xml:id="p1z3"/>eum aliquid quod ad eum valde perfines
					<lb xml:id="p1z4"/>et valde mihi gratum erit, di quamprimum
					<lb xml:id="p1z5"/>per me rectior fiat. Caeferum, si ut allatum
					<lb xml:id="p1z6"/>est exibis commentus vestri laetas erit, qua
					<lb xml:id="p1z7"/>imprimis cupio, deinde, ut tu reliquique
					<lb xml:id="p1z8"/>pii et boni viri in eo, quod actum erit
					<lb xml:id="p1z9"/>acquiescant non dedignalere me etiam
					<lb xml:id="p1z10"/>certiore facere. Vale symantissimo Curiae
					<lb xml:id="p1z11"/>2cmobris
					<lb xml:id="p1z12"/>et Buryr.
					<pb/>
					<lb xml:id="p2z1"/>Dem hochgraften unnd
					<lb xml:id="p2z2"/>hoch getacten herrn Heynrico
					<lb xml:id="p2z3"/>Bullingerro, predicanten
					<lb xml:id="p2z4"/>zu <placeName ref="l587">Zürich</placeName>.
				</p>
			</div>
		</body>
	</text>
