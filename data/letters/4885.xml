	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. Eadem fere hora et fasciculus hic a
					<lb xml:id="p1z2"/>Thoma Erasto ad me iissus est, ut ad te
					<lb xml:id="p1z3"/>perferri curarem et hic bonus ac studiosius in
					<lb xml:id="p1z4"/>vens literas mihi ab eo, qui ante annum svarem
					<lb xml:id="p1z5"/>Apotheosim mihi aedendam dederat et attulit. Qu
					<lb xml:id="p1z6"/>quum se <placeName ref="l587">Tigurunm</placeName> profecturum diceret, valde ia
					<lb xml:id="p1z7"/>iustus occasione, statim per eum ipsum ad te
					<lb xml:id="p1z8"/>mittendum duxi. Spero autem te ex Erasti
					<lb xml:id="p1z9"/>literis cogniturum literas a te mihi nuper, ut ad ipsum
					<lb xml:id="p1z10"/>curarent missas eum recepisse. Bene vale
					<lb xml:id="p1z11"/>Basileae, 21. iulii 1561.
					<lb xml:id="p1z12"/>Ioannes Oporinum
					<lb xml:id="p1z13"/>Tuus ex animo
					<pb/>
					<lb xml:id="p2z1"/>15.
					<lb xml:id="p2z2"/>Optimo atque doctissimo
					<lb xml:id="p2z3"/>viro d. Henrico
					<lb xml:id="p2z4"/>Bullingero, ecclesiae
					<lb xml:id="p2z5"/>Tigurinae pastori
					<lb xml:id="p2z6"/>vigilantissimo, domino e
					<lb xml:id="p2z7"/>amico suo cum prii
					<lb xml:id="p2z8"/>colendo.
					<lb xml:id="p2z9"/>Tiguri.
				</p>
			</div>
		</body>
	</text>
