			<zone xml:id="p4z14-0" points="719,3715 746,3722 793,3701 861,3727 966,3729 1052,3750 1049,3611 1016,3590 934,3650 829,3664 804,3650 718,3674">725,3699 750,3697 775,3696 800,3698 826,3699 851,3699 876,3699 902,3699 927,3699 952,3699 978,3701 1003,3702 1028,3702 1054,3702</zone>
