	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Curavi omnes literas hoc anno ad me datas <lb xml:id="p1z2"/>quam diligentissime, ne sis sollicitus.</s>
					<s n="3" xml:lang="de"><foreign xml:lang="la">Ad nos venere scripta, in <lb xml:id="p1z3"/>quibus hęc sunt:</foreign> "<persName ref="p18250">Hertzog Mauritz</persName> geschlagen vom h. <persName ref="p8034">von Heideck</persName>, <lb xml:id="p1z4"/>im ein kynback abgeschossen und durch ein schenckel, ist <lb xml:id="p1z5"/>kum entrunnen.</s>
					<s n="4" xml:lang="de"><persName ref="p18716">Ericus von Brunschwick</persName> ist gefangen und der <persName>graf <lb xml:id="p1z6"/>von der Lipp</persName> <foreign xml:lang="la">et multi nobiles.</foreign></s>
					<s n="5" xml:lang="la">Magna fuit strages.</s>
					<s n="6" xml:lang="la"><foreign xml:lang="de">Der keyser <lb xml:id="p1z7"/>buttet inen den landtfriden,</foreign> quam nunquam servavit, ... omnia <lb xml:id="p1z8"/>agit Caesar, ut dissipet illum exercitum.</s>
					<s n="7" xml:lang="la"><placeName ref="l61">Bremensis</placeName> episcopus in ipsa <lb xml:id="p1z9"/>pugna interfectus est.</s>
					<s n="8" xml:lang="la"><persName>Princeps Georgius</persName> ab <placeName ref="l701">Mechelburg</placeName> quarto <lb xml:id="p1z10"/>die post captivitatem obiit ex vulnere.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z11"/><persName>Caesar</persName> contrahit ad se exercitum ex praesidiis veterem; fortassis <lb xml:id="p1z12"/>non fidit <placeName ref="l18">Augustanis</placeName>.</s>
					<s n="10" xml:lang="la">Videbimus aestatem turbulentissimam.</s>
					<s n="11" xml:lang="la">Veniunt <lb xml:id="p1z13"/>ad nos multi <placeName ref="l875">Hispani</placeName> et Neapolitani; nescio, quid sibi hoc velit, nonne <lb xml:id="p1z14"/>clam exercitum colligit et militem exterum, quo terrorem Germanis incutiat, <lb xml:id="p1z15"/>ne deficiant.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z16"/><placeName ref="l61">Bremensis</placeName> exercitus pro hostibus habet interimistas et papistas; <lb xml:id="p1z17"/>spoliant mercatores, episcopatus devorant.</s>
					<s n="13" xml:lang="la">Si <persName>Caesar</persName> dissidia inter illos <lb xml:id="p1z18"/>potest serere, sicuti conatur, actum erit de illis; nam nihil aliud cogitat, <lb xml:id="p1z19"/>quam et nobis cladem inferre et sub odientiam(?) redigere; sed no<lb xml:id="p1z20"/>lumus sapere nisi icti.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z21"/>Quinque reges conveniunt, <persName ref="p20225">Gallus</persName>, <persName ref="p8375">Anglus</persName>, <persName ref="p3671">Danus</persName>, <persName>Polus</persName>; <lb xml:id="p1z22"/>nescio quintum.</s>
					<s n="15" xml:lang="la">Similiter etiam civitates <placeName ref="l749">Saxoniae</placeName> consultabunt de pace <lb xml:id="p1z23"/>in <placeName ref="l822">Germania</placeName> constituenda et de exercitu contra Caesaris monarchiam <lb xml:id="p1z24"/>colligendo obiiciendoque; nam tempus est, ut tandem evigilent reges <lb xml:id="p1z25"/>terrae et, quid contingere posset debellatis civitatibus, expendant diligentius <lb xml:id="p1z26"/>quam hactenus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z27"/>Tu si quid ex <placeName ref="l830">Anglia</placeName> habes, obsecro, velis communicare, neque <lb xml:id="p1z28"/>etiam dubito tuas literas iam in <placeName ref="l830">Anglia</placeName> esse.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p8418">Myconius</persName> vexatur podagrico morbo, bonus vir dignus <lb xml:id="p2z2"/>meliori fato propter multa incommoda, quę alias habet.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l491">Argentinę</placeName> deus exercet mirabilia iudicia contra hostes <lb xml:id="p2z4"/>evangelii.</s>
					<s n="19" xml:lang="de"><foreign xml:lang="la">Duo peste abierunt, aliter vocatus <persName>Matthias <lb xml:id="p2z5"/>Grotterus</persName>;</foreign> diser hat by 24 jaren um ein ander psalmen <lb xml:id="p2z6"/>angehebt im mynster, ist jetz zuͦletst bewegt worden <lb xml:id="p2z7"/>widerumb ze messen.</s>
					<s n="20" xml:lang="la">Desperavit omnino de misericordia dei, quia <lb xml:id="p2z8"/>dixit se peccasse <lb xml:id="p2z9"/>in spiritum sanctum et contra conscien<lb xml:id="p2z10"/>tiam <lb xml:id="p2z12"/>propter lucrum et ingentia promissa.</s>
					<s n="21" xml:lang="la"><lb xml:id="p2z14"/>Alter vocatus <persName>Claudius</persName>, concionator <persName>Iunioris Petri</persName>; <foreign xml:lang="de">diser <lb xml:id="p2z15"/>ist</foreign> ex publico stipendio educatus et in evangelica veritate in<lb xml:id="p2z16"/>stitutus et tandem etiam defecit.</s>
					<s n="22" xml:lang="la" ana="salute">Qui cum peste laboraret, dixit <lb xml:id="p2z17"/>se non posse consequi salutem, sed damnatum esse.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Vide, qualia <lb xml:id="p2z18"/>dominus nobis proponat exempla ob oculos, praecipue papistis<lb xml:id="p2z19"/>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p2z20"/>D. <persName ref="p2916">Sebastianus Schertlin</persName> cogitat discedere et alium locum <lb xml:id="p2z21"/>quęrere bonus et strenuus vir; sed nolo hac de re loqui; <lb xml:id="p2z23"/>fortassis brevi redibit.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p2z24"/>Multi subitanea morte abeunt, multi peste et <lb xml:id="p2z26"/>interna infectione.</s>
					<s n="26" xml:lang="la">Dominus nobis spiritum fortitudinis et patientia<lb xml:id="p2z27"/>e cum vera fide concedat, ne ab illo deficiam<lb xml:id="p2z29"/>us.</s>
				</p>
				<p>
					<s n="27" xml:lang="la" ana="farewell"><lb xml:id="p2z30"/>Vale 1. februarii 1551.</s>
				</p>
				<p>
					<s n="28" xml:lang="la">T[uus] <lb xml:id="p2z31"/><persName ref="p1278">Gastius</persName>.</s>
				</p>
				<p>
					<s n="29" xml:lang="la" ana="salute"><pb/><lb xml:id="p3z1"/>Salutabis nomine meo d. <persName ref="p8171">Theodorum</persName>, cui hęc communicare <lb xml:id="p3z2"/>poteris.</s>
				</p>
				<p>
					<s n="30" xml:lang="de"><pb/><lb xml:id="p4z1"/>An den ehrwürdigen <lb xml:id="p4z2"/>und wolgelerten herren <lb xml:id="p4z3"/>meyster <persName ref="p495">Heinrych <lb xml:id="p4z4"/>Bullinger</persName>, lutpriester zuͦ <lb xml:id="p4z5"/><placeName ref="l587">Zürich</placeName>, mynem gün<lb xml:id="p4z6"/>stigen, lieben herren.</s>
					<s n="31" xml:lang="de"><lb xml:id="p4z7"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
				<p>
					<note>Achtung: der nächste Brief ist Nr. 21321, von Blarer an <persName ref="p495">Bullinger</persName>, 2 Februar [1551]!!!!</note>
				</p>
			</div>
		</body>
	</text>
