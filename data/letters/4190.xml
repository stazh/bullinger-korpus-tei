	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil praecipui nunc habeo, quod ad te scribam, colendissime domine <persName ref="p495">Bullingere</persName>.</s>
					<s n="3" xml:lang="la" ana="salute"><lb xml:id="p1z2"/>Ne autem negligentiae insimules, cum sim nuncium nactus opportunum, hisce <lb xml:id="p1z3"/>meis te tuosque omnes libuit salutare.</s>
					<s n="4" xml:lang="la">Salvi itaque sitis pariter omnes.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Caeterum <lb xml:id="p1z4"/>cupio me reddi certiorem, ut re vera omnes valeatis quibusque demum auspiciis <lb xml:id="p1z5"/><persName>Christopherus</persName> noster vos accesserit sitquene pristinae incolumitati <lb xml:id="p1z6"/>restitutus.</s>
					<s n="6" xml:lang="la">Utinam vero optima quaeque a vobis omnibus audire contingat.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z7"/>Nos hic bene valemus omnes dei beneficio, quanquam non careo continuis molestiis; <lb xml:id="p1z8"/>obruor enim negociis, potissimum forensibus, quae me vitae institutum ut plurimum <lb xml:id="p1z9"/>mutare cogunt.</s>
					<s n="8" xml:lang="la">Ex quo etiam sequitur, quod amicis et litteris etiam non ad<lb xml:id="p1z10"/>modum licet indulgere, sumque proinde rarior ad scribendum tibi et caeteris <lb xml:id="p1z11"/>amicis; habebis itaque me excusatum.</s>
					<s n="9" xml:lang="la">Novi hoc habemus, quod <lb xml:id="p1z12"/><placeName ref="l522">Veneti</placeName> subinde sunt solliciti, ne pax illa, quae coaluit inter tantos monarc<lb xml:id="p1z13"/>has, ipsis pariat insigne aliquod bellum, quippe cum indies praeludia <lb xml:id="p1z14"/>quaedam cernantur idem significantia.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Cremae inter caetera nuperrime <lb xml:id="p1z15"/>inventi sunt aliquot <placeName ref="l875">Hispani</placeName> molientes quid proditionis, quorum unus dumtax<lb xml:id="p1z16"/>at (ut dicitur) equis est discerptus, reliqui <placeName ref="l522">Venetias</placeName> in captivitatem ab<lb xml:id="p1z17"/>ducti.</s>
					<s n="11" xml:lang="la">Referuntur praeterea multa huiuscemodi, quae nunc praetereo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Cardinalis <lb xml:id="p1z18"/><persName>Medices</persName> papatum est assequutus praeter omnium fere expectationem, cumque <lb xml:id="p1z19"/>ob talem adeptam dignitatem censeatur eum esse fortunatissimum, ego iudico <lb xml:id="p1z20"/>mortales nil peius ei posse ominari; erit enim suorum praedecessorum <lb xml:id="p1z21"/>simillimus et proinde impiissimus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Dux <placeName>Suessiae</placeName>, <placeName ref="l306">Mediolani</placeName> <lb xml:id="p1z22"/>gubernator, aegrotat admodum non absque vitae amittendae periculo.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z23"/><placeName ref="l425">Romam</placeName> ante octiduum se contulit <persName>Hannibal</persName> <placeName>Empsensis</placeName> cum insigni comitatu <lb xml:id="p1z24"/>avunculum papam visitaturus.</s>
					<s n="15" xml:lang="la">Sed et alias ex locis huic <lb xml:id="p1z25"/>meae iurisdictioni contiguis permulti catervatim se <placeName ref="l425">Romam</placeName> conferunt <lb xml:id="p1z26"/>illuc advolantes rati ut omnes papae liberalitate insigniter donati <lb xml:id="p1z27"/>divites domum revertantur.</s>
					<s n="16" xml:lang="la">Cum desiderio tuas expecto <lb xml:id="p1z28"/>litteras, me interim tibi tuisque etiam atque etiam commendans.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell"><lb xml:id="p1z29"/>Vale aeternum, colendissime domine <persName ref="p495">Bullingere</persName>, quem cum tota familia tua <lb xml:id="p1z30"/>quam diutissime quamque foelicissime opto fore incolumem.</s>
					<s n="18" xml:lang="la">Datum raptim <lb xml:id="p1z31"/><placeName ref="l93">Clavennae</placeName> die 15. ianuarii 1560.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z32"/>Tibi omnium deditissimus <lb xml:id="p1z33"/><persName ref="p8432">Federicus a Salice</persName>, commissarius <lb xml:id="p1z34"/><placeName ref="l93">Clavennensis</placeName>.</s>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p4z1"/>Ornatissimo ac clarissimo viro, <lb xml:id="p4z2"/>domino <persName ref="p495">Henrico Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> [ec<lb xml:id="p4z3"/>clesiae praed]icatori summo ac domino [s<lb xml:id="p4z4"/>uo iug]iter colendissimo et <lb xml:id="p4z5"/>[observan]dissimo.</s>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName> Helvetiorum.</s>
				</p>
				<p>
					<s n="22" xml:lang="de"><lb xml:id="p4z6"/>Dem hochgelerten herren <persName ref="p495">Hainrichen <lb xml:id="p4z7"/>Bullingern</persName> <lb xml:id="p4z8"/>zuͦ <placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
