	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Diu nihil ad te scripsi, frater in domino <lb xml:id="p1z2"/>colende, nulla alia caussa, quam quod te dignum <lb xml:id="p1z3"/>haberem nihil, ut ne nunc quidem habeo.</s>
					<s n="3" xml:lang="la">Tamen, <lb xml:id="p1z4"/>ne suspicareris aliud, breves hasce mitto, <lb xml:id="p1z5"/>quibus nostras coniunxi de caussa matrimonii <placeName>Wilensis</placeName> <lb xml:id="p1z6"/>illius scriptas et ea conditione missas, ut, si ita <lb xml:id="p1z7"/>videretur, retinerem eas.</s>
					<s n="4" xml:lang="la">Quoniam vero <lb xml:id="p1z8"/>nostrum forum in 2. et 3. gradu coniugium non <lb xml:id="p1z9"/>concedit neque per<lb xml:id="p1z10"/>egrinis coniugiis benedicit, <lb xml:id="p1z11"/>consultius est visum vestras retinere quam ipsi <lb xml:id="p1z12"/>dare, ut iam non commemorem peregrinos istos <lb xml:id="p1z13"/>fere aliter rem proponere, quam revera habeat, <lb xml:id="p1z14"/>ut periculo non careat literis agere <lb xml:id="p1z15"/>cum talibus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><placeName ref="l157">Francfordiae</placeName> convenerant aliquot <lb xml:id="p1z16"/>principes; ea comitia dicuntur soluta.</s>
					<s n="6" xml:lang="la">Composita <lb xml:id="p1z17"/>dicitur lis <placeName ref="l213">Hessi</placeName> et <placeName ref="l1229">Nassaviensis</placeName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Urgent <lb xml:id="p1z18"/>principes colloquium <placeName ref="l569">Wormatiense</placeName> compromissum <lb xml:id="p1z19"/>ad 24. augusti; videtur enim frigere <persName ref="p18477">Ferdinandus</persName> <lb xml:id="p1z20"/>rex, quod mortuus feratur <persName ref="p18593">Turcarum imperator</persName> et <lb xml:id="p1z21"/>filii duo de successione bellagerere.</s>
					<s n="8" xml:lang="la"><persName ref="p3590">Philippus</persName> <lb xml:id="p1z22"/>ingentem parat in <placeName ref="l832">Gallum</placeName> exercitum <lb xml:id="p1z23"/>Regina <placeName ref="l830">Angliae</placeName> declaravit bellum contra Gallum <lb xml:id="p1z24"/>proceribus <placeName ref="l830">Anglis</placeName> nonnullis contradicentibus; <lb xml:id="p1z25"/>sed pergit illa.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z26"/>Recruduit et bellum <lb xml:id="p1z27"/><persName>Livonicum</persName> et <persName>Brutenicum</persName>.</s>
					<s n="10" xml:lang="la">Quid fiat in <placeName ref="l834">Italia</placeName> et <lb xml:id="p1z28"/><placeName ref="l994">Neapoli</placeName>, a te expectamus.</s>
					<s n="11" xml:lang="la">Valemus <lb xml:id="p1z29"/>hic (<lb xml:id="p1z30"/>dei gratia) omnes.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Salutabis dominum <persName ref="p629">Matthaeum <lb xml:id="p1z31"/>Cognetium</persName>, cum quo haec habebis communia.</s>
					<s n="13" xml:lang="la">Scrip<lb xml:id="p1z32"/>si, et illę literae interceptae sunt, sicuti ille novit; <lb xml:id="p1z33"/>proinde nihil scribo, ne illi incommodem.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z34"/>Haec ipsi dicas, oro.</s>
					<s n="15" xml:lang="la" ana="salute">Salutabis d. <persName ref="p8359">Gallicium</persName>, <lb xml:id="p1z35"/>d. <persName ref="p3196">Tscharnerum</persName> et d. <persName ref="p8055">Ambrosium</persName>, d. <persName ref="p6130">Pontasellam</persName> <lb xml:id="p1z36"/>et reliquos nostros amicos et fratres.</s>
					<s n="16" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z37"/>varia et dubia feruntur ex <placeName ref="l834">Italia</placeName> et <placeName ref="l736">Pedemonte</placeName>; <lb xml:id="p1z38"/>ego a te certa expecto.</s>
					<s n="17" xml:lang="la">Valebis.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z39"/>16. iulii 1557.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z40"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimis viris d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiae Rhetorum</placeName> <lb xml:id="p2z3"/>in S. Martini evangelium a<lb xml:id="p2z4"/>nnuncianti, domino colendo, <lb xml:id="p2z5"/>compatri et fratri charissimo.</s>
				</p>
				<p>
					<s n="21" xml:lang="de"><lb xml:id="p2z6"/>An h. <persName ref="p8009">Hansen Schmiden</persName>, <lb xml:id="p2z7"/>predicanten zuͦ Sant <lb xml:id="p2z8"/>Martin ze <placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
