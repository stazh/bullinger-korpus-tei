	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Redii heri ex <placeName ref="l491">Argentina</placeName>, unde ad te scripsi.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Huc reversus nuncium tale inveni: Famulum, <lb xml:id="p1z3"/>quem modo, <placeName ref="l587">Tiguri</placeName> quum essem, habui, mis<lb xml:id="p1z5"/>s<lb xml:id="p1z6"/>um ad me ab ipso <persName ref="p20206">Gribaldo</persName> multa domi meae surri<lb xml:id="p1z7"/>puisse, fere ad 30 florenos et profugisse; <lb xml:id="p1z8"/>at Bullingae deprehensus relictis furtis <lb xml:id="p1z9"/>adhuc profugere potuisse.</s>
					<s n="3" xml:lang="la">Spero me <lb xml:id="p1z10"/>omnia recuperaturum, nam scio esse salva.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z11"/>At quoniam suspicor eum mihi <lb xml:id="p1z13"/>sigillum asportasse, hactenus enim non <lb xml:id="p1z14"/>invenio, mone <placeName ref="l104">Cremonensem</placeName>, mone <persName>Zie<lb xml:id="p1z15"/>glerum</persName>, imprimis mone d. <persName ref="p8296">Bassafontaneum</persName>, <lb xml:id="p1z16"/>ne sinant sibi imponi nec credant si<lb xml:id="p1z17"/>gillo, si meam manum per totas literas <lb xml:id="p1z18"/>non videant.</s>
					<s n="5" xml:lang="la">Scripsi in <placeName ref="l834">Italiam</placeName>, <lb xml:id="p1z19"/>ut posthac videant, quem mihi com<lb xml:id="p1z20"/>mendaturi sunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Nunc alia <lb xml:id="p1z21"/>non habeo, quae scribam.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale et <lb xml:id="p1z22"/>salve cum omnibus.</s>
					<s n="8" xml:lang="la">Orate pro me.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z23"/><placeName ref="l512">Tubingae</placeName> 2. <lb xml:id="p1z24"/>augusti 1554.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">[<lb xml:id="p1z26"/>C]<pb/><lb xml:id="p2z1"/>larissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>fratri honorando.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
