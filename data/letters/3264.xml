	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p3375">Vergerio S. D.</persName> Non sum nec haberi <lb xml:id="p1z2"/>volo defensor libri illius.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Laudavi, fateor, <lb xml:id="p1z3"/>principis tui consilium suadentis, ne quid <lb xml:id="p1z4"/>non examinatum excudi patiantur <placeName ref="l28">Basilienses</placeName>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Sed quid haec ad librum <persName ref="p714">Caelii</persName>, qui <placeName ref="l28">Basileae</placeName> <lb xml:id="p1z6"/>non est impressus?</s>
					<s n="4" xml:lang="la">Imo, cum tecum postea, quam <lb xml:id="p1z7"/><persName ref="p8011">Gvalthero</persName> et mihi consilium tuum indica<lb xml:id="p1z8"/>veras, in hypocausto Ciconiae solus tecum obam<lb xml:id="p1z9"/>bularem, hortatus sum, si meministi, ut pru<lb xml:id="p1z10"/>denter tentares negotium, ne malevolis <placeName ref="l28">Basiliensibus</placeName> <lb xml:id="p1z11"/>ansam dares etiam bonos libros opprim<lb xml:id="p1z12"/>endi.</s>
					<s n="5" xml:lang="la">Adieci <persName ref="p714">Caelium</persName> esse doctum et valere <lb xml:id="p1z13"/>lingua; suadere ergo, ne ipsi occasionem sup<lb xml:id="p1z14"/>pedites altercandi et postulandi tecum.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Ita et non aliter rem gestam esse dices, <lb xml:id="p1z16"/>sat scio, si adhuc meministi verborum <lb xml:id="p1z17"/>meorum.</s>
					<s n="7" xml:lang="la"><persName ref="p714">Coelius</persName> perinde ut tu fr<lb xml:id="p1z18"/>equenter ad me literas scribit et magis <lb xml:id="p1z19"/>necessariis occupatum vexat et distrahit, <lb xml:id="p1z20"/>et quoniam illi pro voto non respondeo <lb xml:id="p1z21"/>et ipsum accuso, habet, quod ipse quoque in me <lb xml:id="p1z22"/>accuset.</s>
					<s n="8" xml:lang="la">Ego vero inter utrumque medius <lb xml:id="p1z23"/>sic agam deo aspirante, ut neque deum <lb xml:id="p1z24"/>offendam neque a vobis iure accusari <lb xml:id="p1z25"/>possim.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Quoniam vero tu spem facis <lb xml:id="p1z26"/>ea de re nihil amplius scripturum te <lb xml:id="p1z27"/>et praeteritis his in veteri amicitia perseveraturum, <pb/><lb xml:id="p2z1"/>habebis etiam me amicum, ut habuisti <lb xml:id="p2z2"/>hactenus.</s>
					<s n="10" xml:lang="la">Nescio enim, quas ad te literas <lb xml:id="p2z3"/>scripserim, quas non expectavisses.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Video <lb xml:id="p2z4"/>autem id evenisse, quod eventurum putaram <lb xml:id="p2z5"/>et tibi futurum praedixeram, ut turba <lb xml:id="p2z6"/>exoriatur, quam non consequatur fructus <lb xml:id="p2z7"/>splendidus, et multi inter se amici tur<lb xml:id="p2z8"/>bentur.</s>
					<s n="12" xml:lang="la">Sed bene habet, omissis illis <lb xml:id="p2z9"/>amemus nos mutuum in domino.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">In hoc <lb xml:id="p2z10"/>vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Festinantissime.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 8. a<lb xml:id="p2z11"/>ugusti 1557.</s>
					<s n="16" xml:lang="la">De rebus novis scriberem, <lb xml:id="p2z12"/>nisi scirem d. <persName ref="p8101">Lęlium</persName> hic n<lb xml:id="p2z13"/>ihil negligere.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z14"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
			</div>
		</body>
	</text>
