	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ignosces ęgre pingenti propter insolentem capitis vertiginem.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Literas illas, quas per <persName>Petrum</persName> quendam misisse te scribis, nondum <lb xml:id="p1z3"/>accepi, id quod valde male me habet, praesertim quum <lb xml:id="p1z4"/><persName ref="p8417">Musculi</persName> epistolam adiunctam illis audiam, cuius uxor ad <lb xml:id="p1z5"/>nos nudius quartus cum novem liberis est Lindavio advecta, <lb xml:id="p1z6"/>et eius fortassis referret scire, quid facere se vellet maritus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Sed optimus et sanctissimus <persName>Christophorus Myllerus</persName>, <placeName ref="l291">Lindaugiensis</placeName> <lb xml:id="p1z8"/>archigrammateus, et de suis et pientissimae illius mulieris, <lb xml:id="p1z9"/>adde etiam nostris rebus te iam fecit, scio, certiorem.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Alia, quę praeterea apud nos feruntur nova, <persName ref="p4082">C[onradus] [Zviccius]</persName> schedula <lb xml:id="p1z11"/>adnotata legenda tibi mitit ea lege, ut tu deinde <lb xml:id="p1z12"/>omnia ad <persName ref="p8498">Marcellum</persName> cum literis sibi inscriptis mittenda cures.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>De <persName ref="p6552">Schönero</persName> fac sciam, num istic sit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Adulescentem hunc quam possum tibi commendo, sed ita, ut per te <lb xml:id="p1z15"/><placeName ref="l830">Anglo</placeName> illi in <placeName ref="l830">Angliam</placeName> sub calendas Septembres profecturo <lb xml:id="p1z16"/>dilligenter commendetur cum altero quodam nostrate, <lb xml:id="p1z17"/>qui <placeName ref="l491">Argentorati</placeName> adhuc hęret, optimus plane adulescens.</s>
					<s n="8" xml:lang="de"><lb xml:id="p1z18"/>24. Julii 1548.</s>
					<s n="9" xml:lang="la">Ora pro nobis.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><lb xml:id="p1z19"/>Ic<lb xml:id="p1z20"/>h mag nitt baß<lb xml:id="p1z21"/>.</s>
				</p>
				<p>
					<note type="signature">[Unterschrift fehlt.]</note>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Bullingero</persName> <lb xml:id="p2z2"/>suo.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
