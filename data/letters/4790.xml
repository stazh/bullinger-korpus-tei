	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsit ad me d. <persName>Flaminius</persName> de quodam libro valde inepto, quem <lb xml:id="p1z2"/>d. <persName ref="p8306">a Cambray</persName>, qui legationis munere functus apud <placeName ref="l648">Rhetos</placeName>, imprimendum <lb xml:id="p1z3"/>curavit, et existimat, quod in pagella una doctos aliquos suppressis <lb xml:id="p1z4"/>nominibus inter adulatores comprehendat.</s>
					<s n="3" xml:lang="la">Videbis, si molestum non <lb xml:id="p1z5"/>erit, quid illi respondeam, et literas ad eum mittes, quando se occasio <lb xml:id="p1z6"/>offeret.</s>
					<s n="4" xml:lang="la">Mitto etiam ad te exemplar literarum scriptarum de iis, quę in <lb xml:id="p1z7"/>suburbio <placeName ref="l378">Luthecię</placeName> acta sunt sacerdotibus frigidam suffundentibus.</s>
					<s n="5" xml:lang="la">Scripsit <lb xml:id="p1z8"/>rex <placeName ref="l301">Lugdunensi</placeName> praefecto et aliis metropolitanarum urbium, ut octo aut dec<lb xml:id="p1z9"/>em viros ex qua<lb xml:id="p1z10"/>libet urbe deligerent summe probitatis et eruditionis, alienos a contentione, <lb xml:id="p1z11"/>et qui alteri sacramentum non dederunt, illorumque mittant nomina, ut <lb xml:id="p1z12"/>consilium de religionis reformatione et repurgatione capi possit.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Putat d. <persName>Redonensis</persName> episcopus actum de consilio... nec spem restare.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Mitto ad te libellos duos poematum et epigrammatum, in quibus multa <lb xml:id="p1z15"/>reperies iucundissima, cum erit ocium.</s>
					<s n="8" xml:lang="la">Illos d. <persName ref="p8111">Martiri</persName> communicabis, <lb xml:id="p1z16"/>ut fidem meam liberes.</s>
					<s n="9" xml:lang="la">Cras <placeName ref="l2478">Sabaudi</placeName> et <placeName ref="l160">Friburgenses</placeName> convenient <lb xml:id="p1z17"/><placeName ref="l379">Paterniaci</placeName>; sed nihil facient.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Post octo dies conventus <placeName ref="l28">Basiliensis</placeName> erit; <lb xml:id="p1z18"/>nondum constitui, an interesse debeam, tametsi me valde omnes, <lb xml:id="p1z19"/>quorum interest, orent, ut me interponam.</s>
					<s n="11" xml:lang="la" ana="salute">Uxor et filius te salutant.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute"><lb xml:id="p1z20"/>Meis verbis salutabis dominos et amicos omnes.</s>
					<s n="13" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z21"/><placeName ref="l157">Francfordie</placeName> nihil fiet; reiecta commitia in mensem proximum.</s>
					<s n="15" xml:lang="la"><placeName ref="l760">Solodori</placeName> 11. maii.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z22"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
				</p>
			</div>
		</body>
	</text>
