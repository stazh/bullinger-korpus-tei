	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/><placeName ref="l184">Griessenbergi</placeName> etiamnum hęreo, ubi literas ab <persName ref="p8018">Hallero</persName> nostro <lb xml:id="p1z3"/><placeName ref="l257">Constantia</placeName> heri ad multam noctem huc allatas accepi <lb xml:id="p1z4"/>cum aliis literis, quibus momnino ut respondeam opportet, <lb xml:id="p1z5"/>quo minus multa nunc ad te, mi venerande <lb xml:id="p1z6"/><persName ref="p495">Bullingere</persName>, possum.</s>
					<s n="3" xml:lang="la">Anxius expecto tuas scire <lb xml:id="p1z7"/>vehementer cupiens, num tabellarius ille Helvetiorum <lb xml:id="p1z8"/>redierit et quid responsi a Cęsare attulerit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Quid autem <lb xml:id="p1z9"/>etiam vestri nunc in comitiis?</s>
					<s n="5" xml:lang="la">Hic me tanta <foreign xml:lang="el">[griechisch]</foreign> <lb xml:id="p1z10"/>vexavit, ut cunctum propemodum exhauserit.</s>
					<s n="6" xml:lang="la">Ora pro <lb xml:id="p1z11"/>nobis nostraque urbe, ut, si fieri ulla ratione possit, <lb xml:id="p1z12"/>omnia ista mala sua bonitate revocet nosque in pristinum <lb xml:id="p1z13"/>adeoque etiam meliorem christianismi statum revocet <lb xml:id="p1z14"/>inque eo perpetuo conservet.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale cum Tuis omnibus.</s>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z15"/>Salutat te optima mea soror valde quam reverenter.</s>
				</p>
				<p>
					<s n="9" xml:lang="de"><lb xml:id="p1z16"/><placeName ref="l184">Griessenbergi</placeName> 6. Septembris 1548.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z17"/>Tuus <persName ref="p8055">A[mbrosius] B[laurerus</persName>]<lb xml:id="p1z18"/>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Literas, quas hic vides, <lb xml:id="p1z19"/><persName ref="p8498">Marcello Theodoricho</persName> <lb xml:id="p1z20"/>primo commodo nuncio <lb xml:id="p1z21"/>diligenter ut reddi cures, <lb xml:id="p1z22"/>multum te quęso.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z3"/>D. <persName ref="p495">Heinricho Bullingero</persName> <lb xml:id="p2z4"/>suo.</s>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
