	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Accepi literas tuas, vir clarissime, nec
					<lb xml:id="p1z2"/>S.D.
					<lb xml:id="p1z3"/>sine ingenti dolore illas legi. Exanimo enim
					<lb xml:id="p1z4"/>tuam doleo et Ioanni nostro metuo. De
					<lb xml:id="p1z5"/>quo tun tamen, quod niror, ne verbum quidem
					<lb xml:id="p1z6"/>scribis, Ubi sit et quid cum ipso in his turbis
					<lb xml:id="p1z7"/>Utinam salvus sit et extea periculum.
					<lb xml:id="p1z8"/>huiusmodi turbae apud veteres collasae sunt
					<lb xml:id="p1z9"/>terrentibus hybernis nivibus liquefactus et
					<lb xml:id="p1z10"/>imbribus auctis per Montanam in vicinas vel
					<lb xml:id="p1z11"/>ruentibus atque effusis; Obvia enim quaevis
					<lb xml:id="p1z12"/>secum abripiunt, omniaque involuint vertent
					<lb xml:id="p1z13"/>erduntDominus gratia et protentia sua dignetur
					<lb xml:id="p1z14"/>hoc aestus sedare; Vix enim video, quid hic
					<lb xml:id="p1z15"/>effecturi sunt homines. Dudum ego huiusmodi
					<lb xml:id="p1z16"/>furores putavi uros et longe lateque
					<lb xml:id="p1z17"/>implicaturos plurimos, peregrina illa foede
					<lb xml:id="p1z18"/>partim studea regum munera. Scis
					<lb xml:id="p1z19"/>enim quid nobis exhibeat vetus historia.
					<lb xml:id="p1z20"/>Imo domestica exempla docore nos potuissent
					<lb xml:id="p1z21"/>Sed haec est manus domini, quem soro, ner ipsam aggratu,
					<lb xml:id="p1z22"/>Tibi autem, mi domine et frater, ferensa est
					<lb xml:id="p1z23"/>in fide et pacientia. Cum dominus propter penata
					<lb xml:id="p1z24"/>nostra nos invisit et nos peccata nostra ingenue
					<lb xml:id="p1z25"/>agnoscimus, etus gratiam invocamus et poenitentiam
					<lb xml:id="p1z26"/>agimus, clemens ille est et non retinet iram
					<lb xml:id="p1z27"/>suam perpetuo. Si ergo tu quoque conversus ad Bom
					<lb xml:id="p1z28"/>mim ei supplicaveris, certo consolabitur et iva
					<lb xml:id="p1z29"/>Si quid meam opera tibi conficere queat
					<lb xml:id="p1z30"/>totus sum tuus. Oro brevem hanc meam epistolam
					<lb xml:id="p1z31"/>constulas; nam concinando et aliis negotiis defac
					<lb xml:id="p1z32"/>vix haec scripsi. Quae a me vis fieri
					<lb xml:id="p1z33"/>literis tuis fient. Dominus servet te et liberet
					<lb xml:id="p1z34"/>1565.
					<lb xml:id="p1z35"/>a malo. Tiguri 20. aprilism.
					<lb xml:id="p1z36"/>Bullingerus tuus.
					<pb/>
					<lb xml:id="p2z1"/>.
					<lb xml:id="p2z2"/>ca.
					<lb xml:id="p2z3"/>.
					<lb xml:id="p2z4"/>
					<lb xml:id="p2z5"/>
					<lb xml:id="p2z6"/>rgamis
					<lb xml:id="p2z7"/>mim
					<lb xml:id="p2z8"/>. h. A. ind.
					<lb xml:id="p2z9"/>amani 4.
					<lb xml:id="p2z10"/>lanisio
					<lb xml:id="p2z11"/>prapas.
					<lb xml:id="p2z12"/>suand dunt
					<lb xml:id="p2z13"/>pi altare.
					<pb/>
					<lb xml:id="p4z1"/>Clarissimo viro d. Fridenroo
					<lb xml:id="p4z2"/>ycho a Salice Rheto
					<lb xml:id="p4z3"/>nunc Curiae agenti domino
					<lb xml:id="p4z4"/>mo colendo e nmico
					<lb xml:id="p4z5"/>integerrimo
					<lb xml:id="p4z6"/>regs
					<lb xml:id="p4z7"/>Bullinger, ecclesię Tigurinę, antistitis
					<lb xml:id="p4z8"/>Cr.
				</p>
