	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>esas
					<lb xml:id="p1z2"/>ente
					<lb xml:id="p1z3"/>ficere
					<lb xml:id="p1z4"/>liberatus.
					<lb xml:id="p1z5"/>S. D. Literae tuae 27. februarii <placeName ref="l587">Tiguro</placeName> datae in patria
					<lb xml:id="p1z6"/>mihi traditae sunt 8. die maii. Unde animum
					<lb xml:id="p1z7"/>tuum erga me propensissimum (de quo quidem nu
					<lb xml:id="p1z8"/>quam dubitavi) cognoscere licuit. Utinam et tibi
					<lb xml:id="p1z9"/>et omnibus <placeName ref="l587">Tigurinis</placeName> ceterisque Christi fidelibus aequi
					<lb xml:id="p1z10"/>ac vobis ex animo faveo succederet. Vivimus hic
					<lb xml:id="p1z11"/>per dei gratiam satis quiete sub tutela domini
					<lb xml:id="p1z12"/>nostri illustrissimi pii et vere christia
					<lb xml:id="p1z13"/>cuius (divina proigentia) inaignus consui
					<lb xml:id="p1z14"/>sum factus. Corerdat mihi dominum
					<lb xml:id="p1z15"/>ad nominis sui gloriam, salutem reipublicaet
					<lb xml:id="p1z16"/>mpatriae consilia et vitam mea diri
					<lb xml:id="p1z17"/>Livonienses ob varia nefanda
					<lb xml:id="p1z18"/>et crudelia erga subditos peccata, hac pra
					<lb xml:id="p1z19"/>terita hieme satis graviter a Moscovitis
					<lb xml:id="p1z20"/>castigati sunt. Ademerunt illis mirabiliter
					<lb xml:id="p1z21"/>Vervam et terbium (quod vulgo dörpt
					<lb xml:id="p1z22"/>vocati), cuius praesulem patriae proditorem
					<lb xml:id="p1z23"/>una cum multis civibus in terras suas ab
					<lb xml:id="p1z24"/>duxerunt, relicis ibi suae gentis hominibus
					<lb xml:id="p1z25"/>Depopulati sunt praeterea agros Rigensam
					<lb xml:id="p1z26"/>et Revaliensem ferro rigni; Sed ad
					<lb xml:id="p1z27"/>ventante Christopho duce Megapolitane
					<lb xml:id="p1z28"/>cuius exercitum ingentem per iudicium
					<lb xml:id="p1z29"/>acceperant, recesserunt, cum ultra 30
					<lb xml:id="p1z30"/>equites non haberet. Luiovienses missa ad
					<lb xml:id="p1z31"/>eum legatione inducias usque ad futurum
					<lb xml:id="p1z32"/>vembrem impetrarunt. Nunc sunt Vilnae
					<lb xml:id="p1z33"/>
					<pb/>
					<lb xml:id="p2z1"/>praestaturi regi Poloniae Homagium, qui eos
					<lb xml:id="p2z2"/>Cremisso ab imperatore iuramento, quo hactenus
					<lb xml:id="p2z3"/>imperio Romano devincti fuerunt) in
					<lb xml:id="p2z4"/>suam Clientelam contra Moscovitam defendentim
					<lb xml:id="p2z5"/>suscepit. Misit quoque eo legatum dux nostr
					<lb xml:id="p2z6"/>instinctu fratris archiepiscopi Rigensiss,
					<lb xml:id="p2z7"/>Det illis deus fęlicissimum successum, ut
					<lb xml:id="p2z8"/>cum vitae emendatione pacate vivere liceat
					<lb xml:id="p2z9"/>Luberae conventus nunc agitur civitatum
					<lb xml:id="p2z10"/>magnae societatis Anzae Saxonicae adsunt
					<lb xml:id="p2z11"/>ibi et nostri Dantiscam, qui una cum aliis
					<lb xml:id="p2z12"/>finito conventu in Dania ad coronationem
					<lb xml:id="p2z13"/>regis Friderici ex ipsius petitione, quae ibi
					<lb xml:id="p2z14"/>agenti dies dabit. Dolendae profecto vices
					<lb xml:id="p2z15"/>Ditinariensium, qui hactenus in summa liberta
					<lb xml:id="p2z16"/>te etiam invitis regibus Daniae et ducum Holeium
					<lb xml:id="p2z17"/>satia quos aliquoties graviter ademptis to
					<lb xml:id="p2z18"/>bellicis cederunt, nunc in servitu
					<lb xml:id="p2z19"/>redactos. Librum tuum quem mihi
					<lb xml:id="p2z20"/>pximis literis misisti, non accepi, habet praeteri
					<lb xml:id="p2z21"/>ea adhuc Froschouerus alterum tomn
					<lb xml:id="p2z22"/>sermonum Teremiae prophetae siniet Apocalipsi
					<lb xml:id="p2z23"/>tuam, quam ei solvi retinuit tamen
					<lb xml:id="p2z24"/>ob augustiam vasculi. Rogo literis tuis
					<lb xml:id="p2z25"/>obsignatis suprnscribas, si quidquam mittere vonru,
					<lb xml:id="p2z26"/>Mitto tibi hic exemplar Alphabet
					<lb xml:id="p2z27"/>aulici, quod ob materiam tibi non displicetit
					<lb xml:id="p2z28"/>spero mittam posthac gratiora. Tum
					<pb/>
					<lb xml:id="p3z1"/>ete.
					<lb xml:id="p3z2"/>me
					<lb xml:id="p3z3"/>hactenus fecisti me amare pergito, quod
					<lb xml:id="p3z4"/>idem erga te facere credito. vale
					<lb xml:id="p3z5"/>lutatis collegis et familia tua honestu
					<lb xml:id="p3z6"/>Salutat te M. Wolfgangus perium
					<lb xml:id="p3z7"/>S.
					<lb xml:id="p3z8"/>universitatis nostrae rector, qui
					<lb xml:id="p3z9"/>sibi a te multa humanitatis officia
					<lb xml:id="p3z10"/>praestita praedicat. Iterum vale felicite
					<lb xml:id="p3z11"/>in domino. Dedi Monteregio die 4.
					<lb xml:id="p3z12"/>augusti anno 1559.
					<lb xml:id="p3z13"/>S.
					<lb xml:id="p3z14"/>Tuus
					<lb xml:id="p3z15"/>Ioannes Jaskeus.
					<lb xml:id="p3z16"/>om
					<lb xml:id="p3z17"/>ibi
					<lb xml:id="p3z18"/>erta
					<lb xml:id="p3z19"/>Hol.
					<lb xml:id="p3z20"/>tot
					<lb xml:id="p3z21"/>utu.
					<lb xml:id="p3z22"/>cum
					<lb xml:id="p3z23"/>praeter
					<lb xml:id="p3z24"/>tomu.
					<lb xml:id="p3z25"/>ilip.
					<lb xml:id="p3z26"/>er.
					<lb xml:id="p3z27"/>D.
					<lb xml:id="p3z28"/>habet
					<lb xml:id="p3z29"/>irtit
					<lb xml:id="p3z30"/>ut
					<pb/>
					<lb xml:id="p4z1"/>Pietate et doctrina praestissimo
					<lb xml:id="p4z2"/>viro domino Heinricho
					<lb xml:id="p4z3"/>Bullingero, ecclesiae Tigurina
					<lb xml:id="p4z4"/>antistiti fidelissimo
					<lb xml:id="p4z5"/>domino suo colendissimo.
					<lb xml:id="p4z6"/>fratri carissimo
					<lb xml:id="p4z7"/>it manus proprias
					<pb/>
					<lb xml:id="p6z1"/>clarissimo et piissimis viris dominis
					<lb xml:id="p6z2"/>ministris et professoribus vi urbe
					<lb xml:id="p6z3"/>Tigurina, dominis et fratribus observandissimo.
				</p>
