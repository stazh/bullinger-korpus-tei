	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia Christi tecum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Commendamus vobis bonum hunc <lb xml:id="p1z2"/>et, quantum iudicare potuimus, solide pium Michaelem<note xml:id="fn1" type="footnote" n="1">Unbekannt.</note>, <lb xml:id="p1z3"/>quem sesquimensem, ni fallor, in ptochodochio<note xml:id="fn2" type="footnote" n="2">Armenhaus (griech. <foreign xml:lang="el">πτωχοδοχεῖον</foreign> s. <persName ref="p8320">Dasypodius</persName>, Dic. 192r.</note> nostro <lb xml:id="p1z4"/>fovimus diutius etiam foturi, si diutius hęrere voluisset.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Ad laborandum<pb type="edition" next="442"/> manibus ob lęsum brachium inutilis est <lb xml:id="p1z6"/>redditus; in spetiem superstitiosus videri poterit et nobis <lb xml:id="p1z7"/>profecto primo occursu<note xml:id="fna" type="footnote" n="a">occursu <hi>nach einem gestrichenen, unlesbar gemachten Wort.</hi></note> talis videbatur; <lb xml:id="p1z8"/>sed pressum<note xml:id="fnb" type="footnote" n="b"><hi>In der Vorlage</hi> pressus.</note> intuentes et illius animam, quatenus <lb xml:id="p1z9"/>licuit, discutientes, longe alium invenimus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>Reiicula veste<note xml:id="fn3" type="footnote" n="3">mit einem verbrauchten (s. <persName ref="p8320">Dasypodius</persName>, Dic. 96v.) Gewand.</note> et nudis pedibus ingreditur absque <lb xml:id="p1z11"/>caligis, quod vereatur, ne, si decentiore toga <lb xml:id="p1z12"/>et caligis utatur, impotenti [m]ilitandi<note xml:id="fnc" type="footnote" n="c">[m]ilitandi <hi>am Rand nachgetragen und im engen Einband teilweise verdeckt.</hi></note> affectu vincatur; <lb xml:id="p1z13"/>id quod prius etiam accidisse sibi valde conquęritur.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z14"/>Supra modum enim militiam, cuius ab adulescentia assuetus <lb xml:id="p1z15"/>fuit, ardet, ut consilium hoc improbare haudquaquam <lb xml:id="p1z16"/>valeamus.</s>
					<s n="6" xml:lang="la">Puto vere in Christum collocatum, quicquid <lb xml:id="p1z17"/>huic benignitatis exhibetur<note xml:id="fn4" type="footnote" n="4">Vgl. <cit type="bible"><ref>Mt 25, 40</ref></cit>.</note>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Bene vale, mi charissime <lb xml:id="p1z18"/>frater.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l257">Constantiae</placeName>, 7. octobris anno 1544.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/>Tuus <persName ref="p8055">Ambr. Bl.</persName></s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Suo longe colendissimo <lb xml:id="p2z2"/>fratri d. <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>.</s>
					<s n="11" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
