			<zone xml:id="p4z8-0" points="2573,2339 2638,2366 2671,2351 2737,2366 2802,2347 2929,2366 2934,2278 2901,2273 2833,2298 2821,2286 2772,2296 2733,2261 2714,2269 2692,2253 2644,2273 2575,2271">2584,2327 2609,2327 2634,2327 2659,2327 2684,2325 2709,2321 2734,2318 2760,2315 2785,2315 2810,2315 2835,2315 2860,2315 2885,2315 2910,2315 2936,2315</zone>
			<zone xml:id="p4z9-0" points="2333,2476 2571,2493 2710,2423 3054,2474 3147,2446 3147,2386 3003,2355 2333,2370">2345,2435 2385,2432 2425,2430 2465,2429 2506,2429 2546,2429 2586,2429 2627,2428 2667,2425 2707,2423 2748,2423 2788,2423 2828,2425 2868,2428 2909,2431 2949,2433 2989,2435 3030,2435 3070,2435 3110,2435 3151,2435</zone>
