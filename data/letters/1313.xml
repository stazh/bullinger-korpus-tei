	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Cum evulgassem Decadem meam 5. <lb xml:id="p1z2"/>et me exemissem ex pressura preli, scripsi <lb xml:id="p1z3"/>tibi, domine ac frater in domino colende, sed <lb xml:id="p1z4"/>et exemplum Decadis meae misi.</s>
					<s n="3" xml:lang="la">Postea iterum <lb xml:id="p1z5"/>scripsi in mense martio et aprili sem<lb xml:id="p1z6"/>el et iterum, mense maio literas <placeName ref="l640">Flandro</placeName> <lb xml:id="p1z7"/>cuidam <persName ref="p8061">Ioanni</persName>, qui se <persName ref="p8061">Utenhovium</persName> nuncupabat, <lb xml:id="p1z8"/>credidi, simul autem <persName ref="p1278">Gastio</persName> nostro scribens <lb xml:id="p1z9"/>mandavi, ut communes tecum haberet literas.</s>
					<s n="4" xml:lang="la">Tu vero <lb xml:id="p1z10"/>ab eo tempore si semel scripseris, ignoro.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Hoc scio te graviter decubuisse; sed tum <lb xml:id="p1z12"/>quoque scripsi consolatorias.</s>
					<s n="6" xml:lang="la">Interea cum re<lb xml:id="p1z13"/>valuisti, ocium scribendi non defuisse sat s<lb xml:id="p1z14"/>cio.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Rursus ergo te praeverto, te saluto, ex <lb xml:id="p1z15"/>te statum rerum tuarum scire cupio.</s>
					<s n="8" xml:lang="la">Nos <lb xml:id="p1z16"/>hic recte valemus, nisi quod magna est <lb xml:id="p1z17"/>copia pauperum et inopia rerum omnium.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/>Dominus punit nostram in mundo effrenem crapulam.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/>Plurimi ominantur gravissimum <lb xml:id="p1z20"/>exoriturum bellum; cui si pestis accedat, <lb xml:id="p1z21"/>flagellum habemus paratum scorpionibus tribus <lb xml:id="p1z22"/>digni, quorum tergoribus infigatur gravissime.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z23"/>Dominus servet ecclesiam suam in <lb xml:id="p1z24"/>hisce erumnis.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale.</s>
					<s n="13" xml:lang="la">Ocyssime.</s>
				</p>
				<p>
