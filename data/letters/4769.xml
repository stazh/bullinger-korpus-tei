	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi a legatis <placeName ref="l572">Wirtenbergensibus</placeName>, <lb xml:id="p1z2"/>qui <placeName ref="l21">Badenę</placeName> nuper fuerunt, a tutoribus <lb xml:id="p1z3"/>principibus decretum esse, ne quid molestię <lb xml:id="p1z4"/><persName ref="p1010">Erbio</persName> et suo collegae inferatur <lb xml:id="p1z5"/>et uterque stipendio, quod hactenus illis <lb xml:id="p1z6"/>subministratum est, utantur fruantur[que], <lb xml:id="p1z7"/>ita tamen ut publica docendi functione <lb xml:id="p1z8"/>abstineant et nuper in ecclesiis illis <lb xml:id="p1z9"/>usum et formam receptam non <lb xml:id="p1z10"/>reprehendant.</s>
					<s n="3" xml:lang="la">Si hac conditiones accep<lb xml:id="p1z11"/>taverint, liceat illis in otio vivere.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z12"/>Sed quo animo <persName ref="p1010">Erbius</persName> illa accipiat, <lb xml:id="p1z13"/>nondum constat.</s>
					<s n="5" xml:lang="la">Nuper <placeName ref="l28">Basilea</placeName> <lb xml:id="p1z14"/>scripsi et commonefeci hominem, quo <lb xml:id="p1z15"/>loco res suę sint; absque consilio <lb xml:id="p1z16"/>amicorum, si quid offeratur, temere <lb xml:id="p1z17"/>nihil repudiet neque loco pedem <lb xml:id="p1z18"/>moveat, priusquam, quid principes tutores <lb xml:id="p1z19"/>de sese statuant, certo cognoverit.</s>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z20"/>Bene vale et me semper commen<lb xml:id="p1z21"/>datum habeas.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Datum 25. aprilis <lb xml:id="p1z22"/>anno 61.</s>
				</p>
				<p>
					<s n="8" xml:lang="de"><lb xml:id="p1z23"/><persName>Hartman von Halwyll</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietate et doctrina spectato <lb xml:id="p2z2"/>viro domino <persName ref="p495">Bullingero</persName>, domino <lb xml:id="p2z3"/>et amico observandissimo.</s>
				</p>
			</div>
		</body>
	</text>
