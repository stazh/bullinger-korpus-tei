	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino, doctissime <persName ref="p495">Bullingere</persName>.</s>
					<s n="2" xml:lang="la">Quod scribam, nunc non habeo praeter <lb xml:id="p1z2"/>ea, que ̨ nuper acciderunt.</s>
					<s n="3" xml:lang="de">Zuͦ <placeName ref="l2953">S. Gwer</placeName><note type="margin">a.R.: <placeName ref="l2953">St. Goar</placeName>?</note> sindt vil rutter lantgrefisch <lb xml:id="p1z3"/>und <placeName ref="l832">Galli</placeName>; die haben den pass besetzt.</s>
					<s n="4" xml:lang="de">Do sindt die keyserischen by nacht <lb xml:id="p1z4"/>darfur zogen, handts wellen am morgen überfallen, sindt aber ubel ent<lb xml:id="p1z5"/>pfangen, vil volcks do verloren; sindt also widerumb abzogen.</s>
					<s n="5" xml:lang="de">Der Rhin<lb xml:id="p1z6"/>graff hat dem <placeName>Bolwiler</placeName> im <placeName>Wilertal</placeName>, das er erst koufft hat, ein dorff <lb xml:id="p1z7"/>genant <placeName>Sol</placeName> geblundert, ein groß dorff, rich volck darinn.</s>
					<s n="6" xml:lang="de">Item dem <lb xml:id="p1z8"/>herren von <placeName>Rapolstein</placeName> ein dorff verbrent; diser herr ist gon <placeName ref="l64">Brisach</placeName> <lb xml:id="p1z9"/>geflohen mit allem sinem guͦt.</s>
					<s n="7" xml:lang="de">Die von Dann haben by 500 in ir <lb xml:id="p1z10"/>statt geleget, meynen, der <persName ref="p2916">Schertlin</persName> welle by inen in <placeName ref="l691">Lothringen</placeName> ziehen <lb xml:id="p1z11"/>und inn also hinderen.</s>
					<s n="8" xml:lang="de">Aber es weist noch niemant, wo er hinuß <lb xml:id="p1z12"/>wil.</s>
					<s n="9" xml:lang="de">Vil knecht ligen zuͦ <placeName ref="l1273">Enßisheim</placeName> gefangen in eim keller wie <lb xml:id="p1z13"/>die thier, wiewol ich noch nuit hab gehört, das sy jemants haben <lb xml:id="p1z14"/>getödet.</s>
					<s n="10" xml:lang="de">Der <persName>hertzog von Mechelburg</persName>, der alt und der jung, sind zuͦ <lb xml:id="p1z15"/>uns kommen die 13. martii.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Mirum, quomodo potuerint evadere manus <persName>Ferdi<lb xml:id="p1z16"/>nandorum</persName>, qui tam strenue in omnibus angulis vigilias locarunt.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z17"/><placeName ref="l491">Argentoratenses</placeName> ministros suos ad concilium miserunt et aiunt <persName>Philippum</persName> illos <lb xml:id="p1z18"/><placeName>Augustę</placeName> expectare.</s>
					<s n="13" xml:lang="la">De libellis, quos petis, ne dubita; curabo, brevi ut habeas.</s>
					<s n="14" xml:lang="la" ana="farewell"><lb xml:id="p1z19"/>Vale iterum atque iterum.</s>
					<s n="15" xml:lang="la"><placeName ref="l28">Basileę</placeName> 16. martii 1552.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z20"/>T[uus] <lb xml:id="p1z21"/><persName ref="p1278">Gastius</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z22"/>D. <lb xml:id="p1z23"/><persName ref="p8011">Gvaltherum</persName> meo nomine s<lb xml:id="p1z24"/>alutabis officiosissime.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">D. <persName ref="p18113">Mecardus</persName>, olim <persName>Augustanus</persName> concionator, a domino <persName ref="p2916">Schertlino</persName> <lb xml:id="p1z25"/>vocatus et electus in castrensem concionatorem.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Docto et pio <lb xml:id="p2z2"/>viro d. <persName ref="p495">Heinryco <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z5"/>pastori diligentissimo, <lb xml:id="p2z6"/>suo.</s>
				</p>
				<p>
					<s n="20" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
