	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Binas tuas accepi et intellexi studium tuum erga me, pro qua <lb xml:id="p1z2"/>re tibi ago gratias immensas relaturus etiam data occasione.</s>
					<s n="3" xml:lang="la">Accepi sessiones <lb xml:id="p1z3"/><placeName ref="l1107">Tridentinorum</placeName> patrum, legam et bona fide per certum virum remittam.<note type="margin">dazu a.R.: "Imo accepit <persName>Cęlius</persName> noster, qui mihi altera die mutuo dedit."</note></s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Verum heus tu, mitto ad te propositiones, quas d. <persName ref="p8298">Borrhaus</persName> noster protr<lb xml:id="p1z6"/>udi<lb xml:id="p1z7"/>t <lb xml:id="p1z8"/>hoc periculoso tempore; sapiunt <persName ref="p2301">Osiandricum</persName> dogma.</s>
					<s n="5" xml:lang="la">Cupio itaque scire, <lb xml:id="p1z10"/>quid de illis sentias quidve iudices.</s>
					<s n="6" xml:lang="la">Disputarunt nostri, sed ne verbulo attigerunt <lb xml:id="p1z11"/>propositiones de iustitia <persName ref="p2301">Osiandrica</persName>, quia non legerunt illius dogma.</s>
					<s n="7" xml:lang="la">Quid si pergat <lb xml:id="p1z12"/>nostram turbare ecclesiam homo plenus dogmatum?</s>
					<s n="8" xml:lang="la">Expecto tuam hac de re sententiam.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>Praeterea mitto apologiam regis <persName>Gallici</persName> contra <persName ref="p18538">Caesaris</persName> scriptum et hoc soleo <lb xml:id="p1z14"/>mirari, cur nullam faciat mentionem <placeName ref="l1122">Parmensis</placeName> belli.</s>
					<s n="10" xml:lang="la">De novis rebus hec habemus: <lb xml:id="p1z15"/><persName ref="p7364">Martinus de Rossa</persName> collegit militem in <placeName ref="l20">Inferiore Germania</placeName> nomine <persName ref="p18538">Caesaris</persName>.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z16"/>Aquarum inundatio magnum detrimentum dedit Prabantinis.</s>
					<s n="12" xml:lang="la">Norembergae <lb xml:id="p1z17"/>300 et quinquaginta domus combustae sunt, miserabile spectaculum.</s>
					<s n="13" xml:lang="la">Non <lb xml:id="p1z18"/>procul ab <placeName>Ambergo</placeName> ecclesia in rure multis signis clara et anathematibus <lb xml:id="p1z19"/>ornata combusta est, et nemo ausus accedere ad reprimendum incendium; <lb xml:id="p1z20"/>e cęlo tactum est templum, sicque idololatriam dominus delevit eo in loco.</s>
					<s n="14" xml:lang="la">Utinam <lb xml:id="p1z21"/>et <placeName ref="l1107">Tridentinis</placeName> hypocritis suam manum ostenderet, quo tandem cessarent os in <lb xml:id="p1z22"/>cęlum ponere.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Audio miraculum quoddam accidisse <placeName ref="l1107">Tridenti</placeName>, quum canerent <lb xml:id="p1z23"/>die quodam officium de spiritu sancto, volavit in templum super altare ulula, quam <lb xml:id="p1z24"/>et cęperunt, quę evertit calicem in altario.</s>
					<s n="16" xml:lang="la">Sic solet spiritus sanctus venire ad patres <lb xml:id="p1z25"/>istos sanctissimos.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z26"/>Aiunt <persName ref="p3671">Danum</persName> habere ingentem exercitum in <placeName ref="l754">Holsatia</placeName>, quem in locum sit missurus <lb xml:id="p1z27"/>militem, adhuc ignoratur.</s>
					<s n="18" xml:lang="la">Turbabitur <placeName ref="l822">Germania</placeName> ab omnibus partibus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z28"/>Fertur fama conclusum fuisse a Caesareanis, ut episcopi <placeName ref="l822">Germani</placeName> mitterentur <lb xml:id="p1z29"/>in <placeName ref="l875">Hispaniam</placeName> et <placeName ref="l875">Hispanos</placeName> in <placeName ref="l822">Germaniam</placeName>, quo melior tranquillitas ecclesia<lb xml:id="p1z30"/>e <lb xml:id="p1z32"/>possit constitui; sed fabulam puto esse.</s>
					<s n="20" xml:lang="la">Sed hoc certum est, nemo episcoporum audebit <lb xml:id="p1z33"/>discedere sine consensu <persName ref="p18538">Caesaris</persName> ex isto colloquio.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z34"/>Aiunt insuper <persName ref="p2095">Philippum Melanchthonem</persName> <placeName ref="l361">Norimbergae</placeName> fuisse, sed iterum revocatum <lb xml:id="p1z35"/>a principe; alias periisset bonus et pius vir.</s>
					<s n="22" xml:lang="la"><placeName ref="l18">Augustani</placeName> concionatores <lb xml:id="p1z36"/>mirum in modum olei unctionem et instituerunt iuxta baptismum unctionem <lb xml:id="p1z37"/>ab episcopo consecratam; nebulones sunt, et quicquid hactenus docuerunt, iam <lb xml:id="p1z38"/>ostendunt se ex animo nunquam bono docuisse.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="farewell">Vale.</s>
					<s n="24" xml:lang="la"><placeName ref="l28">Basileę</placeName> 19. februarii <lb xml:id="p1z39"/>1552.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">T[uus] <persName ref="p1278">Gast<lb xml:id="p1z40"/>ius</persName> <lb xml:id="p1z41"/>ex animo<lb xml:id="p1z42"/>.</s>
				</p>
				<p>
					<s n="26" xml:lang="de"><pb/><lb xml:id="p2z1"/>An den wolgelerten herre<lb xml:id="p2z2"/>n meyster <persName ref="p495">Heinrych <lb xml:id="p2z3"/>Bullingeren</persName>, lutpriester zuͦ <placeName ref="l587">Zurich</placeName>, <lb xml:id="p2z4"/>mynem gunstigen herren zuͦ <lb xml:id="p2z5"/>handen.</s>
					<s n="27" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
