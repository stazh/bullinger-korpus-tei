			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Gratias ago misericordi domino deo nostro, qui <lb xml:id="p1z2"/>suam gratiam vobis singulariter et aliis fratribus <lb xml:id="p1z3"/>piis largitus est in transigendo negotio ecclesi<lb xml:id="p1z4"/>astico satis difficili.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Declaravit bonus dominus, <lb xml:id="p1z5"/>quod sperantes in se et invocantes per nomen <lb xml:id="p1z6"/>Iesu Christi nunquam destituit; ipsi gloria et laus et <lb xml:id="p1z7"/>gratiarum actio.</s>
					<s n="4" xml:lang="la">Libenter legi acta synodi vestrae, <lb xml:id="p1z8"/>et placent, quae tu cum aliis viris piis et eruditis <lb xml:id="p1z9"/>fideliter egistis.</s>
					<s n="5" xml:lang="la">Dominus sit merces vestra et <lb xml:id="p1z10"/>conservet vos in synceritate purae fidei et convertat <lb xml:id="p1z11"/><persName ref="p20473">Ganthneros</persName>, <persName>Marios</persName> et similes miserandos <lb xml:id="p1z12"/>homines.</s>
					<s n="6" xml:lang="la">Remitto acta et mihi credita omnia <lb xml:id="p1z13"/>et gratias pro his, quas possum maximas, ago.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Nihil <lb xml:id="p1z14"/>nunc, quod scribam habeo.</s>
					<s n="8" xml:lang="la">Redii paucis ante diebus <lb xml:id="p1z15"/>ex balneis <persName>Vulturenis</persName> sanus per dei gratiam <lb xml:id="p1z16"/>et satis incolumis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Dominus dignetur mihi et meis <lb xml:id="p1z17"/>benedicere!</s>
					<s n="10" xml:lang="la">Finita sunt comitia <placeName ref="l21">Badensia</placeName>; <lb xml:id="p1z18"/>sed nondum est compositum dissidium <placeName ref="l441">Schaffhusianorum</placeName> <lb xml:id="p1z19"/>cum Cantonibus <placeName ref="l774">Durgaviam</placeName> gubernantibus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Grando, <lb xml:id="p1z20"/>dei flagellum, multis locis attrivit segetes <lb xml:id="p1z21"/>et fructus arborum concussit.</s>
					<s n="12" xml:lang="la">Sunt haec firmamenta famis <lb xml:id="p1z22"/>et caritatis, quia extincta est charitas et <lb xml:id="p1z23"/>abundat omnis iniquitas.</s>
					<s n="13" xml:lang="la">De rebus <placeName ref="l522">Venetorum</placeName> <lb xml:id="p1z24"/>et <placeName ref="l834">Italiae</placeName> a te malo audire, quid fiat.</s>
					<s n="14" xml:lang="la">Ex <placeName ref="l822">Germ<lb xml:id="p1z25"/>ania</placeName> in praesenti nihil habeo neque ex <placeName ref="l832">Gallia</placeName>; <lb xml:id="p1z26"/>audio tamen <persName ref="p20341">res Galliae</persName> non infelices esse.</s>
					<s n="15" xml:lang="la">Dominus <lb xml:id="p1z27"/>orandus nobis pro benedictione.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell">Optime vale <lb xml:id="p1z28"/>cum domo tua et fratribus nostris.</s>
					<s n="17" xml:lang="la" ana="salute">Saluta d. d. consules, <persName ref="p8057">Campellum</persName>,<note type="margin">a.R.: ... Egli, ...</note> <lb xml:id="p1z29"/><persName ref="p6130">Pontisellam</persName>, <persName ref="p1770">Gregorium</persName>, <persName ref="p8186">Bonetum</persName> et alios.</s>
					<s n="18" xml:lang="la">13. iulii <lb xml:id="p1z30"/>anno domini 1571.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z31"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <persName ref="p8016">Tobiae <lb xml:id="p2z2"/>Eglio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>fidelissimo et vigilantissimo pastori, <lb xml:id="p2z4"/>domino meo honorando et <lb xml:id="p2z5"/>fratri charissimo.</s>
					<s n="21" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>