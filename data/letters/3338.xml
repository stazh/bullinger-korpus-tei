	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino nostro Iesu Christo.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Amen.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Venerande pater, munus eximium, <lb xml:id="p1z3"/>quod pro tua singulari erga nostram ecclesiam <lb xml:id="p1z4"/>charitate nobis misisti, una cum humanissimis <lb xml:id="p1z5"/>tuis literis accepimus gratissimumque id nobis <lb xml:id="p1z6"/>omnibus cum aliis de causis fuit tum vel <lb xml:id="p1z7"/>maxime, quia perspeximus singulare tuum <lb xml:id="p1z8"/>in hanc nostram ecclesiolam studium quotidie <lb xml:id="p1z9"/>magis ac magis augeri.</s>
					<s n="4" xml:lang="la">Quae res sane summae <lb xml:id="p1z10"/>nobis consolationi fuit, cum persuasum habe<lb xml:id="p1z11"/>amus eum animum, qui se tam propensum erga nos <lb xml:id="p1z12"/>ostendit, nunquam memoriam nostri apud dominum <lb xml:id="p1z13"/>deum nostrum intermittere.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quod ut perpetuo cum <lb xml:id="p1z14"/>sociis collegisque tuis, religiosissimis integerrimisque viris, <lb xml:id="p1z15"/>facere digneris, vehementer petimus his presertim <lb xml:id="p1z16"/>miseris temporibus, quibus bella et discordiae <lb xml:id="p1z17"/>diaboli opera in ecclesia seminantur ita crudeles, <lb xml:id="p1z18"/>ut, quae copiae in communem hostem antichristum Romanum <lb xml:id="p1z19"/>coniunctis animis unaque mente impetum facere <lb xml:id="p1z20"/>debebant, nunc inter se commissae miserandum <lb xml:id="p1z21"/>et deo et hominibus spectaculum praebeant.</s>
					<s n="6" xml:lang="la">Dominus <lb xml:id="p1z22"/>noster Iesus Christus, deus pacis et concordiae, <lb xml:id="p1z23"/>spiritum suum sanctum a patre suo impetret eumque ad <lb xml:id="p1z24"/>reconciliationem ecclesiarum impartiat tibique et <lb xml:id="p1z25"/>ecclesiae tuae florentissimae ac beatissimae patroci<lb xml:id="p1z26"/>nium suum, ut hactenus fecit, perpetuo praestet.</s>
					<s n="7" xml:lang="la" ana="salute">Vir clarissi<lb xml:id="p1z27"/>me et observandissime pater, vale ac salve dominumque <lb xml:id="p1z28"/><persName ref="p8111">P. Martyrem</persName>, olim lumen et ornamentum ecclesiae nostrae clarissimum, <lb xml:id="p1z29"/>nostris verbis honorifice saluta.</s>
					<s n="8" xml:lang="la">Datum <placeName ref="l491">Argentina</placeName> 4. cal. <lb xml:id="p1z30"/>octobris anni 1557.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z31"/>Totus totus <persName ref="p7915">Petrus Alexander</persName>, ecclesie minister, <lb xml:id="p1z32"/><persName ref="p7917">Loquetus</persName>, diaconus ecclesie <placeName ref="l832">Ga<lb xml:id="p1z33"/>llicane</placeName>, (Poquetus?) <persName ref="p1586">Franc. <lb xml:id="p1z34"/>Hotomanus</persName> tuus obsequen...</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro domino <persName ref="p495">Henrico <lb xml:id="p4z2"/>Bullingero</persName>, pastori ecclesiae <lb xml:id="p4z3"/><placeName ref="l587">Tigurinae</placeName> fidelissimo et de <lb xml:id="p4z4"/>omnibus ecclesiis christianis <lb xml:id="p4z5"/>optime merito, parenti <lb xml:id="p4z6"/>nostro imprimis venerando.</s>
					<s n="11" xml:lang="la"><lb xml:id="p4z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
