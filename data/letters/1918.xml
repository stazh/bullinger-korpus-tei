	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l491">Argentinae</placeName>, 8. iulii 1553.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>S. P.</s>
					<s n="3" xml:lang="la">Fama ad nos pervenit ingratissima, <persName ref="p495">Bullingere</persName> colende, <lb xml:id="p1z3"/>de rege nostro christianissimo (licebit attribuere huic vere <lb xml:id="p1z4"/>christiano christianissimi titulum quam alteri, qui falso sibi id vendicat).</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Haec nos primo perterruit multum fama et <lb xml:id="p1z6"/>pene <lb xml:id="p1z7"/>credidissem, si non aliter ad nos scripsisset amicus noster <lb xml:id="p1z8"/>communis d. d. <persName ref="p8121">Montius</persName>, qui <placeName ref="l1284">Bruxellas</placeName> in aulam Caesaris <lb xml:id="p1z9"/>ab <placeName ref="l830">Angliae</placeName> legatis iussu regis vocatus est.</s>
					<s n="5" xml:lang="la">Is tum <lb xml:id="p1z10"/>ad me tum ad alios 24. iunii scripsit <placeName ref="l1284">Bruxellas</placeName> pervenis<lb xml:id="p1z11"/>se legatos <placeName ref="l830">Anglos</placeName>, qui nuntiabant graviter aegrotasse regem, <lb xml:id="p1z12"/>sed dei benefitio revalescere, adeo ut vitae nullum esset periculum.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Igitur laudandus deus praecandusque, ut no<lb xml:id="p1z14"/>bis <lb xml:id="p1z15"/>hunc quam diutissime superstitem concedat.</s>
					<s n="7" xml:lang="la">Tota ecclesia <lb xml:id="p1z16"/><placeName ref="l830">Anglicana</placeName> communi prece deum optimum maximum orat, ut et <lb xml:id="p1z17"/>restituatur sanitati et diu conservetur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Vos item oramus, <lb xml:id="p1z18"/>ut deo et regem et ecclesiam nostram assiduis <lb xml:id="p1z19"/>precibus commendetis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>Scribit praeterea <persName ref="p8121">Montius</persName> captam per insidias esse <lb xml:id="p1z21"/><placeName>Turwan</placeName>.</s>
					<s n="10" xml:lang="la">Agebatur de pace inter cives et <persName>Caesarem</persName>: <lb xml:id="p1z22"/>emittebantur legati, qui de conditionibus consultarent: <lb xml:id="p1z23"/>iussa sunt cessare arma.</s>
					<s n="11" xml:lang="la">Interim dum haec agerentur, <lb xml:id="p1z24"/>ex improviso aggressi sunt urbem Caesariani atque in<lb xml:id="p1z25"/>gressi ea parte, qua prius bombardarum ictu muros stra<lb xml:id="p1z26"/>verant, ad 500 milites interfecerant, urbem incen<lb xml:id="p1z27"/>derant, filium constabuli captum inde duxerant ut <lb xml:id="p1z28"/>merito iam <placeName>Punica</placeName> fides in <placeName ref="l875">Hispanicam</placeName> verti posset.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z29"/>Haec habui, quae digna duxi ad te scribere, <persName ref="p495">Bullinge<lb xml:id="p1z30"/>re</persName> <lb xml:id="p1z31"/>amicissime.</s>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z32"/>Bene vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Tuus, <persName ref="p505">I. B.</persName>, <placeName ref="l830">Anglus</placeName><lb xml:id="p1z33"/>.</s>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>amico colendo.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>