	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">De iis, que 6. huius mensis scripsisti, habeo gratiam.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Nih<lb xml:id="p1z3"/>il habeo novi <lb xml:id="p1z4"/>ex <placeName ref="l832">Gallia</placeName> nisi captivos adhuc esse plurimos religionis ergo, nulla esse incendia.</s>
					<s n="4" xml:lang="la">Quem successum <lb xml:id="p1z5"/>omnia sint habitura, puto me brevi intellecturum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Non est abreviata <lb xml:id="p1z6"/>manus domini, ut suos protegere et tueri non possit.</s>
					<s n="6" xml:lang="la">Si non vidisti s<lb xml:id="p1z7"/>ecessum et acta omnia comitiorum <placeName ref="l18">Augustanorum</placeName>, ad te mittam.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/>Historiam <persName>Davidis Basiliensis</persName> nunc mitto.</s>
					<s n="8" xml:lang="la">Iucundissimum mihi esset, <lb xml:id="p1z9"/>si aliqua in re gratificari tibi possem, nec ullam praetermittam occasionem.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z10"/>Que ex <placeName>Italia</placeName> scripta sunt, ... nus tibi interpretabitur.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z11"/><placeName ref="l41">Bernates</placeName> constituerunt amanter componere controversias omnes, quę sunt cum <lb xml:id="p1z12"/><persName ref="p17889">duce Sabaudie</persName>.</s>
					<s n="11" xml:lang="la">Quis futurus sit exitus, incertum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><persName ref="p18090">Rex Navarre</persName> <lb xml:id="p1z13"/>manebit cum rege et ex precipuis consiliariis erit.</s>
					<s n="13" xml:lang="la">Principum corda <lb xml:id="p1z14"/>moderatur et firmat deus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Salutabis d. d. <persName ref="p8111">Martirem</persName>, <persName ref="p8011">Galterum</persName> et qui <lb xml:id="p1z15"/>de me percunctabuntur.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l760">Sol[uturi]</placeName> 15. septembris</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z16"/>Tuus ex animo.</s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>.</s>
				</p>
			</div>
		</body>
	</text>
