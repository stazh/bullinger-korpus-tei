	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Literas sex dierum spacio maturius <lb xml:id="p1z2"/>occlusas esse, quam tabellarius discesser<lb xml:id="p1z3"/>it, ne mireris.</s>
					<s n="2" xml:lang="la">In hoc enim fidem <lb xml:id="p1z4"/>suam neglexit, quod promiserat mihi <lb xml:id="p1z5"/>se postridie abiturum.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Caeterum <lb xml:id="p1z6"/>idem quod antehac obnixe humanitatem tuam de <lb xml:id="p1z7"/>puero oro et obtestor, ut quam prim<lb xml:id="p1z8"/>um tuas literas vicissim in <placeName ref="l21">Ther<lb xml:id="p1z9"/>mas</placeName> vicinas vobis, ubi <persName ref="p19043">Fuggerus</persName> <lb xml:id="p1z10"/>commoratur, noster municeps, amandes <lb xml:id="p1z11"/>ita, ut aliquis ex ipsius familia, <lb xml:id="p1z12"/>quicunque <lb xml:id="p1z13"/>sit, eas quamprimum recipia<lb xml:id="p1z14"/>t.</s>
					<s n="4" xml:lang="la" ana="farewell">Vale tertium et tandem <lb xml:id="p1z15"/>in sempiternum, vir omnium virtutum <lb xml:id="p1z16"/>luce et ornamentis splendidissime, <lb xml:id="p1z17"/>et <persName ref="p8430">Raphaelem</persName>, veteris amici et quasi fratris <lb xml:id="p1z18"/>filium, ne a tua familiaritate <lb xml:id="p1z19"/>abige.</s>
					<s n="5" xml:lang="la">Datum <lb xml:id="p1z20"/>2. iunii.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt; Kleiner Zettel, zu unterst von anderer Hand der Vermerk: "Sayleri; huc non pertinet"; Dem Brief <persName ref="p8107">Traherons</persName> an <persName ref="p495">Bullinger</persName> vom (1541 recte: 1538 ca. Januar) auf der Rückseite aufgeklebt.]</note>
				</p>
			</div>
		</body>
	</text>
