	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">Mitto tibi tandem libros, quos iam olim flagitasti.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><persName>Eusebius</persName> <lb xml:id="p1z3"/>venditur pro 1 fl. et quarta floreni parte.</s>
					<s n="4" xml:lang="la">Mitto praeterea scriptum <lb xml:id="p1z4"/>ex castris <placeName ref="l832">Gallicanis</placeName> ad D. sertlinum missum, quod legere cum aliis poteris <lb xml:id="p1z5"/>et remittere.</s>
					<s n="5" xml:lang="la">Omnes isti libri, quos mitto, constat 10 batziones <placeName ref="l257">Constantienses</placeName>, <lb xml:id="p1z6"/>et vix potui consequi tales.</s>
					<s n="6" xml:lang="la">Priorem editionem habent nostri bibliopolę, ideo <lb xml:id="p1z7"/>misi <placeName ref="l491">Argentinam</placeName> literas et impetravi, quod volebam.</s>
					<s n="7" xml:lang="la">Nova hęc habeo: <lb xml:id="p1z8"/><persName>Ioannes Frede</persName> us, quem fortassis ex scriptis novisti, reliquit suam functionem <lb xml:id="p1z9"/>apud <placeName>Sundenses</placeName>, quę in <placeName ref="l743">Pomerania</placeName> prima et magnificentissima est civita<lb xml:id="p1z10"/>s.<lb xml:id="p1z11"/>"</s>
					<s n="8" xml:lang="la">Nunc vero," scribit in epistola, "in academia <placeName ref="l2107">Gripesvaldensi</placeName> ago profitens iu<lb xml:id="p1z12"/>ra; nam senatus <placeName>Sundensis</placeName> mandaverat nobis, ne pro contione taxaremu<lb xml:id="p1z13"/>s <lb xml:id="p1z14"/>interimisticum scriptum, addideruntque, ut is, qui a taxatione ille supersedere nollet, <lb xml:id="p1z15"/>migraret in alia loca.</s>
					<s n="9" xml:lang="la">Ibi ego et alter vir quidam bonus, cui nomen <persName>Alexio <lb xml:id="p1z16"/>Magno</persName>, cum dixissemus nos non posse bona conscientia parere senatus mandato, <lb xml:id="p1z17"/>statim veturunt, ne suggestum ab eo tempore conscenderemus.</s>
					<s n="10" xml:lang="la">Mutato itaque loco <lb xml:id="p1z18"/>nunc ago in academia <placeName ref="l2107">Gripesvaldensi</placeName>.</s>
					<s n="11" xml:lang="la">Apud nos eadem doctrina sonat in <lb xml:id="p1z19"/>omnibus ecclesiis, quę semper sonuit hactenus, et speramus pacem.</s>
					<s n="12" xml:lang="la">Sonat ea <lb xml:id="p1z20"/>doctrina etiam in omnibus maritimis civitatibus.</s>
					<s n="13" xml:lang="la">Principes habemus valde pios, <lb xml:id="p1z21"/>ut sperem nunquam recepturos impii aliquid aut permissuros, ut revocetur papatus <lb xml:id="p1z22"/>in nostras ecclesias.</s>
					<s n="14" xml:lang="la">Apud <placeName>Sundenses</placeName> nihil neque in doctrina neque ceremoniis <lb xml:id="p1z23"/>mutatum, et nihil minus videri volunt quam Interinistę; propter periculum tantum dicunt <lb xml:id="p1z24"/>se prohibuisse, ne taxaretur Interim."</s>
					<s n="15" xml:lang="la">Hęc ille.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Ex <placeName ref="l284">Lipsia</placeName> hęc: "<lb xml:id="p1z25"/><persName>Sidonius</persName> ille papistarum summus antistes propediem aderit electus in episcopum <lb xml:id="p1z26"/><placeName ref="l311">Martisburgensem</placeName>, quod oppidum situm est in <placeName ref="l1682">Misnia</placeName>.</s>
					<s n="17" xml:lang="la">Episcopatus autem ille <lb xml:id="p1z27"/>proventus habet annuos 30000 fl.</s>
					<s n="18" xml:lang="la">Vereor nostris scholis et ecclesiis, licet <lb xml:id="p1z28"/>adhuc boni viri resistant omnibus modis antichristianis hominibus.</s>
					<s n="19" xml:lang="la"><persName ref="p4176">Amsdorffius</persName> <lb xml:id="p1z29"/>vehemens scriptum contra <persName ref="p4443">Pomeranum</persName> edidit, <placeName>Guttenburchi</placeName>, quod 11 milia <lb xml:id="p1z30"/>a <placeName ref="l284">Lipsia</placeName> distat.</s>
					<s n="20" xml:lang="la">Conventus <placeName ref="l303">Magdeburgensium</placeName> causa multorum procerum <lb xml:id="p1z31"/>atque principum est habitus" etc.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z32"/>Ecclesia <placeName ref="l491">Argentoratensis</placeName> eodem adhuc in statu est, quo iam aliquot menses; <lb xml:id="p1z33"/>episcopus multa non videtur ita urgere, ut ceperat.</s>
					<s n="22" xml:lang="la">Quid posthac sit facturus, <lb xml:id="p1z34"/>audiemus suo tempore.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Fortassis expectat <persName ref="p18538">Caesaris</persName> adventum, qui iam in <lb xml:id="p1z35"/>itinere est ad <placeName ref="l471">Spiram</placeName> venturus.</s>
					<s n="24" xml:lang="la">In <placeName ref="l882">Hungaria</placeName> gliscunt quędam seminaria <lb xml:id="p1z36"/>belli.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><persName ref="p18477">Ferdinandus</persName> est in magno ocio vacans venationibus in <placeName ref="l1682">Misnia</placeName>.</s>
					<s n="26" xml:lang="la"><lb xml:id="p1z37"/>Dissidia oriuntur inter fratres <placeName ref="l558">Wittenbergenses</placeName>, quę nimirum maximum <lb xml:id="p1z38"/>dabunt malum ecclesiis.</s>
					<s n="27" xml:lang="la">Hęc volui ad te paucis, proxime plura.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p1z39"/><placeName ref="l28">Basile</placeName> 10. octobris 1549.</s>
				</p>
				<p>
					<s n="29" xml:lang="la" ana="salute">Salutabis <persName ref="p8171">Theodorum</persName>, <persName ref="p8127">Bellicanum</persName>, <lb xml:id="p1z40"/><persName ref="p8011">Gualtherum</persName> et reliquos fratres nomine meo.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><lb xml:id="p1z41"/>T[uus] <persName ref="p1278">Gastius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="31" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro D. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>pastori <placeName ref="l587">Tiguri</placeName> vigi<lb xml:id="p2z4"/>lantissimo, domino <lb xml:id="p2z5"/>suo perpetuo obser<lb xml:id="p2z6"/>vando.</s>
				</p>
