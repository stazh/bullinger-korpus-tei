	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Honnil.
					<lb xml:id="p1z2"/>certuor.
					<lb xml:id="p1z3"/>soro
					<lb xml:id="p1z4"/>ppostum mt an
					<lb xml:id="p1z5"/>facc.
					<lb xml:id="p1z6"/>r unsi gsent
					<lb xml:id="p1z7"/>qę de scripto suo
					<lb xml:id="p1z8"/>responsione
					<lb xml:id="p1z9"/>oncopatissimo
					<lb xml:id="p1z10"/>illius me an on
					<lb xml:id="p1z11"/>Smel mutt geld beladen zu
					<lb xml:id="p1z12"/>ret
					<lb xml:id="p1z13"/>ieben ein starcke.
					<lb xml:id="p1z14"/>daran mie etwas gelegen
					<lb xml:id="p1z15"/>Schmag nas wissen.
					<lb xml:id="p1z16"/>die nit angeben, wellee
					<lb xml:id="p1z17"/>die bortsch sot des von lande oder
					<lb xml:id="p1z18"/>fusto corto issi dominus
				</p>
			</div>
		</body>
	</text>
