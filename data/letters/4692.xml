			<div>
				<p>
					<lb xml:id="p1z1"/>tuas accem simul etiam drgesneu
					<lb xml:id="p1z2"/>doctissime Besngre respendissim uttique
					<lb xml:id="p1z3"/>o.
					<lb xml:id="p1z4"/>inopinatam et festimi t incpinatam meam perfoc
					<lb xml:id="p1z5"/>licuisset, resplrndisso tamen vtria aimius domessu
					<lb xml:id="p1z6"/>fuero; rei etan autem hac hebodidada mittam
					<lb xml:id="p1z7"/>dgesnerum remedia aliqua quique augus.
					<lb xml:id="p1z8"/>confidere secundante tamen donituo aliquo nihil
					<lb xml:id="p1z9"/>tam certius est, quod non fallat
					<lb xml:id="p1z10"/>nihil scripsisse vier hoc qualecunque
					<lb xml:id="p1z11"/>est epistolius.
					<lb xml:id="p1z12"/>crsere vlum et mansilio etire
					<lb xml:id="p1z13"/>Per paletaditem necandissimo et pestilent sim
					<lb xml:id="p1z14"/>cripturarus depramatoris Stuphyli cigello ie
					<lb xml:id="p1z15"/>prote legas et latui ad doctissime folstantissim
					<lb xml:id="p1z16"/>veritatis propugnatorem Calvinum mictas ractis
					<lb xml:id="p1z17"/>est ille impudentissimo velctu
					<lb xml:id="p1z18"/>Brvnari cansisarius
					<lb xml:id="p1z19"/>non solum ed eniam schol inspector publica
					<lb xml:id="p1z20"/>nihil paelebit, ut tanita, sed in fide solui lam itud
					<lb xml:id="p1z21"/>eest.
					<lb xml:id="p1z22"/>vsolier e anuimadi es at e
					<lb xml:id="p1z23"/>denis sprogene vuces. Valvis excisis nuper uffir
					<lb xml:id="p1z24"/>est scriptum, inquo virtutes istiuc nehaletis infile
					<lb xml:id="p1z25"/>depiliguntur, vocaet eum homifidiei, et quod filmum hon
					<lb xml:id="p1z26"/>colmuiseris in vcorem; iam vero pelgat opieli fui
					<lb xml:id="p1z27"/>animas  ilami certe argumentum, quod intra etera
					<lb xml:id="p1z28"/>ariumeniatur vobis dam est, nopse miptera illi
					<lb xml:id="p1z29"/>hac ess mi se non est darus. ergo lauci im dese
					<lb xml:id="p1z30"/>regere scripturas.
					<lb xml:id="p1z31"/>veg.
					<lb xml:id="p1z32"/>pca sunt perfernarus.
					<lb xml:id="p1z33"/>concianatores nos
					<lb xml:id="p1z34"/>hominum caleara, ut incipiant et ingestis
					<lb xml:id="p1z35"/>am venferantem scripturas esse per inte pres de frato,
					<pb/>
					<lb xml:id="p2z1"/>De recessu principui nihil Rraheocerti sunt, qui
					<lb xml:id="p2z2"/>asserun, quos elactores saxonem et Cantia
					<lb xml:id="p2z3"/>uo ponter eucharistia essu discessisse, sed
					<lb xml:id="p2z4"/>hac certo ausim adfirmare posamnes
					<lb xml:id="p2z5"/>Constantia concesse tinfifici inferiatum lueque eo
					<lb xml:id="p2z6"/>legatis concedere, quid pincfoxalur patiricii e
					<lb xml:id="p2z7"/>inspula, quem isse si rrogatit, nempe in
					<lb xml:id="p2z8"/>lissidine reigunandi et ad se cuncta rapendi sedulius
					<lb xml:id="p2z9"/>sit potius quam inservillando verbo de
					<lb xml:id="p2z10"/>Grid rut.
					<lb xml:id="p2z11"/>extilpatum deque concedere velint, quod vel debberat
					<lb xml:id="p2z12"/>vel pessit iue indiceri onelia Qroinde mittitus
					<lb xml:id="p2z13"/>aa an sus tuet id ec muittete egtaiia
					<lb xml:id="p2z14"/>fede scat lilat se friris edisisis
					<lb xml:id="p2z15"/>eius ibolis inxta dictum domine frufite ides
					<lb xml:id="p2z16"/>fidi iepea reise ami n a pius
					<lb xml:id="p2z17"/>sunt leget, sed quia nosbiles, sed quil venenit a
					<lb xml:id="p2z18"/>Cumanus et delsinus Veneti sunt,  quod
					<lb xml:id="p2z19"/>seveim republc semper fuerint propensi.
					<lb xml:id="p2z20"/>eat, ut, si fiei possit muittas ium inde alvium cort
					<lb xml:id="p2z21"/>Pillianius hec husimi scriptum. vale in ine d
					<lb xml:id="p2z22"/>plura Augustae oppssime et plirimi e.
					<lb xml:id="p2z23"/>salve.
