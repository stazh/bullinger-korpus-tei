	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Facilius equidem a me impetrasti, humanissime vir, ut operam meam vobis <lb xml:id="p1z2"/>condicerem,<note xml:id="fn1" type="footnote" n="1">Zur Berufung <persName ref="p1039">Euanders</persName> vgl. oben <ref target="file11720">Nr. 1676</ref>.</note> quam a dominis meis permissum sit.</s>
					<s n="2" xml:lang="la">Veruntamen[!], cum praecibus a <lb xml:id="p1z3"/>me nihil impetrare possent et iure aut aliquo pacto vi retinere non <lb xml:id="p1z4"/>liceret, tandem bona pace concesserunt.</s>
					<s n="3" xml:lang="la">Polliceor itaque vobis meam operam rogoque, <lb xml:id="p1z5"/>ut me vobis<note xml:id="fna" type="footnote" n="a"><hi>Korrigiert aus</hi> tibi.</note> semper et ubique commendatum habere velitis<note xml:id="fnb" type="footnote" n="b"><hi>Korrigiert aus</hi> velis.</note>.<note xml:id="fn2" type="footnote" n="2"><persName ref="p1039">Euander</persName> trat am 20. März 1543 die Nachfolge <persName ref="p344">Georg Binders</persName> als Schulmeister der Lateinschule am Großmünster an; s. Leo <hi>Weisz,</hi> Quellen zur Reformationsgeschichte des Großmünsters in <placeName ref="l587">Zürich</placeName>, in: <bibl source="b714">Zwa</bibl> VII/3, 1940, S. 200.</note></s>
					<s n="4" xml:lang="la">Cetera omnia partim <lb xml:id="p1z6"/>ex nuntio<note xml:id="fn3" type="footnote" n="3">Unbekannt.</note>, partim ex me propediem audies.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell">Vale cum tua honestissima <lb xml:id="p1z7"/><persName ref="p8051">coniuge</persName><note xml:id="fn4" type="footnote" ana="bio" n="4"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> et tota familia<note xml:id="fnc" type="footnote" n="c"><hi>in der Vorlage irrtümlich</hi> familiam.</note>, quam salvam esse volumus et ego et uxor<note xml:id="fn5" type="footnote" n="5">Nicht namentlich bekannt.</note> mea.</s>
					<s n="6" xml:lang="la" ana="salute"><lb xml:id="p1z8"/>Salutabis meo nomine vicissim <persName ref="p8127">Pellicanum</persName>,<pb type="edition" next="284"/> <persName ref="p8171">Bibliandrum</persName>, <persName ref="p8412">Megandrum</persName>, <lb xml:id="p1z9"/><persName ref="p8011">Gvaltherum</persName>, <persName ref="p344">Binderum</persName>, <persName ref="p1214">Frisium</persName><note xml:id="fnd" type="footnote" n="d"><hi>Nach</hi> <persName ref="p1214">Frisium</persName> <hi>gestrichenes</hi> ac doct.</note>, <persName ref="p167">Ammannum</persName>, <persName ref="p4554">Collinum</persName> ac doctos omnes.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/><placeName ref="l907">Cambidoni</placeName>, 29. decembris anno 1542.<note xml:id="fne" type="footnote" n="e"><hi>Nach</hi> 1542 <hi>gestrichenes</hi> Benedictus.</note></s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z11"/><persName ref="p1039">Benedictus Euander</persName>, tui <lb xml:id="p1z12"/>nominis studiosissimus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino Magistro <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, viro piissimo <lb xml:id="p2z3"/>et doctissimo, contionatori <lb xml:id="p2z4"/><placeName ref="l587">Tigurino</placeName> primario, domino <lb xml:id="p2z5"/>suo colendissimo.</s>
				</p>
			</div>
