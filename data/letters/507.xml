	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><placeName ref="l491">Argentinę</placeName> Satanam turbasse ecclesiam, <persName ref="p467">Bucerum</persName> cum <persName ref="p4744">Paulo Fagio</persName> abso<lb xml:id="p1z2"/>lutos abireque iussos, <persName ref="p8374">Hedionem</persName> etiam cum reliquis consensisse in [...].</s>
					<s n="3" xml:lang="la">Interim<lb xml:id="p1z3"/>, ieiunia mandata, festos dies instauratos ex literis <persName ref="p467">Buceri</persName> leges, <lb xml:id="p1z4"/>quas D. <persName>Musculo</persName> scribit.</s>
					<s n="4" xml:lang="la">Quam miseri sumus homines et imbecilles [los?].</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Verbum domini <placeName ref="l491">Argentinę</placeName> nullas radices habuit; hoc debemus <lb xml:id="p1z6"/>nostris peccatiset impęnitentię.</s>
					<s n="6" xml:lang="la">Hoc debebat illis animum addi[di]sse, quo <lb xml:id="p1z7"/>constantiores fuissent contra <persName ref="p18538">Cęsaris</persName> edictum, quod audierunt et certo <lb xml:id="p1z8"/>sciverunt <placeName>Saxonicas</placeName> civitates novum fędus cum rege Danię et multis <lb xml:id="p1z9"/>principibus instituisse.</s>
					<s n="7" xml:lang="la">Quid sibi hoc vult?</s>
					<s n="8" xml:lang="la"><persName>Mauricius dux Saxonię</persName> <lb xml:id="p1z10"/>cum episcopo <placeName ref="l18">Augustano</placeName> missus ad Venetos, pulchri et probi legati.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z11"/>Utinam suspenderentur in itinere ad arborem aliquam praealtum, ut <lb xml:id="p1z12"/>essent diu conspicui omnibus.</s>
					<s n="10" xml:lang="la"><persName>Schertlinus</persName> famulum habuit, quem miserat <lb xml:id="p1z13"/><placeName ref="l303">Magdeburgum</placeName>, qui 2. Martii rediit; multa de constantia civitatum re<lb xml:id="p1z14"/>fert, ed dominus a <persName>Riffenberg</persName>, qui diu apud nos hęsit, iam agit in <lb xml:id="p1z15"/>Brema civitate.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z16"/>De <placeName>Senensis</placeName> civitatis proditione fortasse melius nosti quam ego.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z17"/>Hęc paucis ad te; tabellio enim urget.</s>
					<s n="13" xml:lang="la">Rescribe nacto otio, cur disces<lb xml:id="p1z18"/>serit <persName ref="p8417">Musculus</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z19"/>Tu commendasti <persName>Thomam</persName><note xml:id="fn1" type="footnote" n="1">Thomas Leymer/Argillanus; vgl. Basel, Matrikel II 54, Nr. 45 und Myc., 8.12.48.</note>, qui duxit abbatissam Seckingensem in <lb xml:id="p1z20"/>uxorem; nam mira de te spargit, qui iam alterum superinduxit uxorem <lb xml:id="p1z21"/>nobilem.</s>
					<s n="15" xml:lang="la">Timeo, ne coniiciatur in carcerem; est enim insignis nebulo, <lb xml:id="p1z22"/>quem audio tibi commendatum a <persName ref="p8418">Myconio</persName> nostro.</s>
					<s n="16" xml:lang="la">Vehementer mihi dolet, <lb xml:id="p1z23"/>si illum tibi suis in literis commendavit.</s>
					<s n="17" xml:lang="la"><placeName>Abbatissa</placeName> honesta matrona <lb xml:id="p1z24"/>adhuc constanter confitetur illud matrimonium semel cum nebulone <lb xml:id="p1z25"/>contractum nec vult retractare.</s>
					<s n="18" xml:lang="la">Posset libere vivere sine custodia, <lb xml:id="p1z26"/>si vellet abnegare.</s>
					<s n="19" xml:lang="la">Nihil facio literas, quas fortassis habet ab <lb xml:id="p1z27"/>episcopalibus extortas, quibus scribunt illum esse liberum nec posse propter <lb xml:id="p1z28"/>votum semel datum ducere uxorem.</s>
					<s n="20" xml:lang="la">Cur permittit <persName>Caesar</persName> in suo Interim?</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z29"/>Vide fallacias perditor<lb xml:id="p1z30"/>um hominum.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">5. Marcii 1549.</s>
				</p>
				<p>
					<s n="24" xml:lang="la" ana="salute"><lb xml:id="p1z31"/>Salutabis D. <persName ref="p8171">Bibliandrum</persName>, <persName ref="p8127">Pellicanum</persName> etc<lb xml:id="p1z32"/>.</s>
					<s n="25" xml:lang="la"><lb xml:id="p1z33"/>Tuus quem nosti.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="26" xml:lang="de"><pb/><lb xml:id="p2z1"/>An herren <persName ref="p495">Heinr<lb xml:id="p2z2"/>ych Bullinger</persName>, lüt<lb xml:id="p2z3"/>priester zuͦ <placeName ref="l587">Zurich</placeName>, <lb xml:id="p2z4"/>mynem lieben, gunstigen <lb xml:id="p2z5"/>herren und frundt, <lb xml:id="p2z6"/>zuͦ handen.</s>
					<s n="27" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
