	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi nuper de electione diaconi nostri, qui <lb xml:id="p1z2"/>vix duobus votis superavit <persName ref="p8417">Musculum</persName>.</s>
					<s n="3" xml:lang="la">Boni et cor<lb xml:id="p1z3"/>datiores omnes, quibusque aliquid cerebri est, a parte steterunt <lb xml:id="p1z4"/>nostra et maximi in urbe propter hanc electionem <lb xml:id="p1z5"/>sunt tumultus aliis eam approbantibus aliis reprobantibus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Senatores plęrique omnes <persName ref="p8417">Musculo</persName> sua dedere <lb xml:id="p1z7"/>suffragia; sed imperitę plebis vicit multitudo.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Accersitus est ipse ad senatum et severiter de Buce<lb xml:id="p1z9"/>ranismo cavendo admonitus; itaque cristas demittere <lb xml:id="p1z10"/>nonnihil videtur, ut existimem ipsum pacificum futurum.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Hoc solum metuo, ne <persName ref="p8467">Weberus</persName> et ipse, qui <lb xml:id="p1z12"/>utrinque satis sunt vehementes, concordes manere possint.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Accedit autem aliud, quod me in hac causa non parum quoque solatur, <lb xml:id="p1z14"/>nempe electio <persName ref="p2919">Michaelis Schlatteri</persName>; is enim diaco<lb xml:id="p1z15"/>no suffectus est, quamvis nondum omnino confirmatus; <lb xml:id="p1z16"/>concionabitur enim prius hic aliquot septimanis.</s>
					<s n="8" xml:lang="la">Non dubito <lb xml:id="p1z17"/>autem, quin et doctrina et loquela eius ab omnibus <lb xml:id="p1z18"/>sit probanda, cum diserte admodum et clare loquatur.</s>
					<s n="9" xml:lang="la">Ego <lb xml:id="p1z19"/>nunc in <persName ref="p1804">Iodoci</persName> aedes ex senatus consulto demigro; quam<lb xml:id="p1z20"/>vis enim elegantiores relinquam, quia tamen hę sunt parochiales, <lb xml:id="p1z21"/>ideo mihi sunt attributę.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><persName ref="p8417">Musculum</persName> in meas puto migraturum<note type="margin">a.R.: Musc. - migraturum Zusatz a. Rand.</note>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Quod res novas <lb xml:id="p1z22"/>concernit, nihil habemus prorsus; cupio ex te scire <lb xml:id="p1z23"/>aliquid et cognoscere.</s>
					<s n="12" xml:lang="la">Mea familia omnis fere <lb xml:id="p1z24"/>tussi laborat et minimus infans omnium maxime, <lb xml:id="p1z25"/>ut de eius prope vita desperem.</s>
					<s n="13" xml:lang="la">Dominus servet illum clementer!</s>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z26"/><persName ref="p8417">Musculus</persName> cum suis, mea it<lb xml:id="p1z27"/>em <lb xml:id="p1z28"/>uxor te tuosque plurimum salutant.</s>
					<s n="15" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="16" xml:lang="de"><placeName ref="l41">Bernę</placeName> <lb xml:id="p1z29"/>2. decembris 1552.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z30"/>Tuus <persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> ecclesię <lb xml:id="p2z3"/>pastori fidelissimo, domino et com<lb xml:id="p2z4"/>patri suo honorando.</s>
				</p>
			</div>
		</body>
	</text>
