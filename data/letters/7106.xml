	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S. D.</s>
					<s n="2" xml:lang="la">Quamvis insalutato me discesseris nec sciam <lb xml:id="p1z3"/>eius rei c[aus]as iustas, insuper toto tempore, quo <placeName ref="l98">Curiae</placeName> <lb xml:id="p1z4"/>iam fuisti, ne literulam quidem scripseris ad me, <lb xml:id="p1z5"/>pergam tamen ego in eo scribendi officio, quo plurimum <lb xml:id="p1z6"/>delectatus est praedecessor tuus, vir per omnia <lb xml:id="p1z7"/>fidelissimus et excellentissimus, tantisper, dum videro me <lb xml:id="p1z8"/>plane praeteriri a te.</s>
					<s n="3" xml:lang="la">Officiosissimus alioqui fuit <lb xml:id="p1z9"/>d. <persName ref="p8009">Fabritius</persName> p[raeclarae] m[emoriae] ac semper copiose de rebus omnibus <lb xml:id="p1z10"/>scribebat, nec ego illi deeram.</s>
					<s n="4" xml:lang="la">Quod autem <lb xml:id="p1z11"/>nunc ad te scribo, hoc potissimum me movet, quod audio <lb xml:id="p1z12"/>certamen esse d. <persName ref="p4037">Zancho</persName> cum sua ecclesia et <lb xml:id="p1z13"/>cum symmysta.</s>
					<s n="5" xml:lang="la">Et quamvis nihil dubitem de tua <lb xml:id="p1z14"/>fide et diligentia, hortor tamen, ut sedulo et per<lb xml:id="p1z15"/>tinaciter studeas in futura synodo ad concordiam <lb xml:id="p1z16"/>reducere discordes.</s>
					<s n="6" xml:lang="la">Cum ille apud nos <lb xml:id="p1z17"/>esset, promisi me hac de re scripturum ad te.</s>
					<s n="7" xml:lang="la">Petebat <lb xml:id="p1z18"/>alioqui nostrum iudicium de ea controversia; sed cum <lb xml:id="p1z19"/>intelligeremus totum negotium ad futuram synodum vestram <lb xml:id="p1z20"/>reiectam, nos praeiudicare quicquam noluimus.</s>
					<s n="8" xml:lang="la">Incidunt <lb xml:id="p1z21"/>saepe apud <placeName ref="l834">Italos</placeName> maxime contentiones; tibi vero <lb xml:id="p1z22"/>et aliis annitendum, ne ignis accedat igni, sed <lb xml:id="p1z23"/>detrahatur plurimum et amicę compositiones fiant.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z24"/>Plus nimium alias contentionum est in ecclesia.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/>Orandus quoque incessanter dominus, ut pacem concedat [et animo<lb xml:id="p1z26"/>s eff.<lb xml:id="p1z27"/>.. tos placet atque tran]quillet<lb xml:id="p1z28"/>.</s>
					<s n="11" xml:lang="la">Qui has tibi affert literas <persName ref="p20601">Anthonius <lb xml:id="p1z29"/>Gaza</persName>, vir est bonus, ut arbitror et ex colloquio <lb xml:id="p1z30"/>colligere potui.</s>
					<s n="12" xml:lang="la">Petivit, ut ipsum tibi commendem; <lb xml:id="p1z31"/>oro itaque, ut ipsum iuves, amice accipias et <lb xml:id="p1z32"/>dimittas.</s>
					<s n="13" xml:lang="la">In <placeName ref="l808">Belgis</placeName> omnes disturbatae sunt <lb xml:id="p1z33"/>ecclesiae et affliguntur fideles crudelissime.</s>
					<s n="14" xml:lang="la"><placeName ref="l1571">Gotha</placeName> <lb xml:id="p1z34"/>se dedidit, sumptumque est supplicium de proscriptis.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z35"/>Quid faciat <placeName ref="l875">Hispanicus</placeName> exercitus in Insubria <lb xml:id="p1z36"/>a te audire malo, qui certiora habes.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z37"/>Oro, diligenter salutes tres consules et symmystam <lb xml:id="p1z38"/>tuum <persName ref="p20473">Gantnerum</persName>, de cuius silentio etiam miror.</s>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z39"/>Saluta item amplissimum virum d. legatum regium <lb xml:id="p1z40"/>et dic me ab illo maxime petere, ut, si quid certi <lb xml:id="p1z41"/>habeat de <placeName ref="l2510">Turca</placeName> et eius expeditione ex republica <placeName ref="l522">Ve<lb xml:id="p1z42"/>netorum</placeName>, ut mihi communicet vel per te vel per <lb xml:id="p1z43"/>literas.</s>
					<s n="18" xml:lang="la">Si quid cognitu dignum accepero, <lb xml:id="p1z44"/>vicissim ei communicabo.</s>
					<s n="19" xml:lang="la" ana="farewell">Optime vale.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z45"/>die pentecostes sub vesperam 1567.</s>
					<s n="21" xml:lang="la"><persName ref="p495">H[einryc<lb xml:id="p1z46"/>hus] Bullingerus</persName> senior.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <persName ref="p8016">Tobiae <lb xml:id="p2z2"/>Eglio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>fideli ministro, domino <lb xml:id="p2z4"/>meo colendo et fratri dilecto.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
