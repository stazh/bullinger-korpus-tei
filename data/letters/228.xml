	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p8114">Nicolaus Artopoeus</persName> <persName ref="p495">Hein[rycho] Bul[lingero]</persName>, viro <lb xml:id="p1z3"/>candidissimo, S. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z4"/>Ostendit mihi nuper D. <persName ref="p8018">Hallerus</persName> lexicon a te cons<lb xml:id="p1z5"/>criptum, de quo, ita tu me ames, peroptime <lb xml:id="p1z6"/>sentio, quod cętera huius generis et elegantia <lb xml:id="p1z7"/>et copia pręstet.</s>
					<s n="3" xml:lang="la">Quare interrogavi statim, <lb xml:id="p1z8"/>num velles in lucem ędere.</s>
					<s n="4" xml:lang="la">"Si rite recordor", inquit <lb xml:id="p1z9"/><persName ref="p8018">Hallerus</persName>, "prodibit propediem, sed recognitum et <lb xml:id="p1z10"/>ditius atque ex officina D. <persName ref="p4851">Froschouer<lb xml:id="p1z11"/>i</persName>."</s>
					<s n="5" xml:lang="la">"Quam inique", inquam, "comparatum est, ut semper <lb xml:id="p1z12"/>aliquid addatur ditioribus; utinam id negotii <lb xml:id="p1z13"/>daret D. <persName ref="p495">Bul[lingerus]</persName> pauperculo nostro <persName ref="p4191">Apiario</persName>, <lb xml:id="p1z14"/>a quo iniret maximam gratiam, neque hoc <lb xml:id="p1z15"/>ęgre haberet, scio, diminum <persName ref="p4851">Froschouerum</persName>.</s>
					<s n="6" xml:lang="la">Iuva nos, <lb xml:id="p1z16"/>d[omine] mi; tu solus hoc a D. <persName ref="p495">Bulling[ero]</persName> citra <lb xml:id="p1z17"/>omnem controversiam impetrare poteris.</s>
					<s n="7" xml:lang="la">Ego <lb xml:id="p1z18"/>si quid queo, queo autem non omnino nihil, <lb xml:id="p1z19"/>faciam quoque atque perlibenter."</s>
					<s n="8" xml:lang="la">Cum hęc <lb xml:id="p1z20"/>dicerem, vir amantissime, ilico in me quoque <lb xml:id="p1z21"/>hanc rem reiecit inquiens: "Experire, quid possis; <lb xml:id="p1z23"/>ego, quid D. <persName ref="p495">Bullingerus</persName> secum constituerit, certo <lb xml:id="p1z24"/>affirmare non ausim."</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Itaque te rogo <lb xml:id="p1z25"/>atque obsecro, mi D. <persName ref="p495">Bullingere</persName>, ut <lb xml:id="p1z26"/>hoc munere et nos et scholam <lb xml:id="p1z27"/>nostram dones; quod si feceris, facies <lb xml:id="p1z28"/>nobis rem gratissimam, ac persuade<pb/><lb xml:id="p2z1"/>as tibi, velim, prorsus neminem omnium ami<lb xml:id="p2z2"/>corum hoc tempore te uno nobis omnibus <lb xml:id="p2z3"/>esse chariorem.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale peroptime.</s>
					<s n="11" xml:lang="la">14. Augusti anno 48.</s>
					<s n="12" xml:lang="la" ana="salute"><lb xml:id="p2z4"/>Saluta nostrum omnium nom<lb xml:id="p2z5"/>ine <lb xml:id="p2z6"/>symmystas tuos omnes cum <persName ref="p8127">Pellicano</persName>, <lb xml:id="p2z7"/><persName ref="p167">Amiano</persName>, <persName ref="p4554">Collino</persName> cęterisque probis viris.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z8"/>Heri mihi tradidit <persName ref="p8292">And[reas] Zebędeus</persName>, <lb xml:id="p2z9"/><placeName ref="l280">Lausanensis</placeName> scholę professor, literarum <lb xml:id="p2z10"/>fasciculum, qui continet epistolas <lb xml:id="p2z11"/>aliquot a <persName ref="p540">Calvino</persName> et aliis ad se datas, <lb xml:id="p2z12"/>quas describam et unam et alteram ad <lb xml:id="p2z13"/>te mittam, ex quibus poteris cog<lb xml:id="p2z14"/>noscere, quid sentiant perturba<lb xml:id="p2z15"/>tores illi de sinceriore doctrina e<lb xml:id="p2z16"/>vangelica, quam ipsi <persName ref="p4091">Zvinglianam</persName> <lb xml:id="p2z17"/>vocant.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale iterum.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z18"/>Fac, ut brevi <lb xml:id="p2z19"/>intelligamus, quid constitueris.</s>
					<s n="16" xml:lang="la">Quod ad liter<lb xml:id="p2z20"/>am attinet <persName ref="p4191">Apiarii</persName>, nihil <lb xml:id="p2z21"/>est, quod sis <lb xml:id="p2z22"/>solicitus; sat superque eleganter exprimit, quae <lb xml:id="p2z23"/>exprimenda suscipit, et ego, si tibi <lb xml:id="p2z24"/>placuerit, corrigam neutiquam resupia <lb xml:id="p2z25"/>diligentia.</s>
				</p>
				<p>
					<note type="signature">[Unterschrift fehlt.]</note>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p4z1"/>D. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p4z2"/>viro et doctrina <lb xml:id="p4z3"/>et moribus <lb xml:id="p4z4"/>et integritate <lb xml:id="p4z5"/>conspicuo.</s>
				</p>
			</div>
		</body>
