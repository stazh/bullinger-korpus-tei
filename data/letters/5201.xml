	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accipio tuas (reverende in Christo pater) hoc vesperi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Totum autem hunc diem in conquirendis herbis d. d. <persName ref="p1283">Gesnero</persName> <lb xml:id="p1z3"/>occupatus fui, ita ut prolixe scribere non possim.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Sed quod scribam, non habeo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Concilii acta nos fugiunt; <lb xml:id="p1z5"/>expecto tamen quotidie, quid ab illis nuncietur, ad <lb xml:id="p1z6"/>quos ea de re scripsi.</s>
					<s n="6" xml:lang="la">Qui ex <placeName ref="l834">Italia</placeName> veniun<lb xml:id="p1z7"/>t maxime ex agro <placeName ref="l306">Mediolanensi</placeName>, omnes uno <lb xml:id="p1z8"/>ore affirmant quieta esse omnia <placeName ref="l306">Mediolani</placeName> <lb xml:id="p1z9"/>et circa.</s>
					<s n="7" xml:lang="la">Nostri <placeName ref="l520">Valletelinenses</placeName> quoque affirmant <lb xml:id="p1z10"/>frumentum in magna copia per Lacum ad se devehi.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/>Haec quid certa sunt, de cęteris tam varii rumores, <lb xml:id="p1z12"/>ut, quid verisimile sit, non facile dixerim.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>Quod ad <persName ref="p3375">Vergerium</persName> attinet, iubeo te securum esse.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/>Nostri consules iam sunt informati.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Gratulor <lb xml:id="p1z15"/>tibi, qui librum tuum semel ad finem perduxeris.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z16"/>Scio ego nostras contentiones rem esse offendiculi <lb xml:id="p1z17"/>plenam; sed domino committendus est eventus <lb xml:id="p1z18"/>nec ideo veritas deserenda.</s>
					<s n="13" xml:lang="la">Hodie legi tabellas <lb xml:id="p1z19"/>inscriptas: Genealogia seu posteritas <persName ref="p1974">Lutheri</persName>, quinti <lb xml:id="p1z20"/>(si dis placet) evangelistae etc.</s>
					<s n="14" xml:lang="la">Nescio, an videris; puto esse <lb xml:id="p1z21"/><persName>Staphyli</persName> laborem.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Dominus <persName>de Rozinß</persName> commodavit <lb xml:id="p1z22"/>cuidam ex nostris legenda.</s>
					<s n="16" xml:lang="la">Conatur author causam <lb xml:id="p1z23"/>nostram invisam et suspectam reddere eo nomine, <lb xml:id="p1z24"/>quod nobis ipsis inter nos mutuo non bene conveniat; eos, <lb xml:id="p1z25"/>qui asseverant corpus Christi deificatum, appellat <lb xml:id="p1z26"/>metamorphistas; Manichaeis et Marcionitis <persName ref="p540">Calvinum</persName> <lb xml:id="p1z27"/>annumerat.</s>
					<s n="17" xml:lang="la">Sunt merae calumnię.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Ago tibi <lb xml:id="p1z28"/>pro libro tuo singulares gratias.</s>
					<s n="19" xml:lang="la">Caetera remitto, <lb xml:id="p1z29"/>uti postulas.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Nihil plane novi est.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="farewell">Vale, reverende <lb xml:id="p1z30"/>in Christo pater.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Deum rogo, ut tua labores fortunet <lb xml:id="p1z31"/>teque cum tuis incolumem conservet.</s>
					<s n="23" xml:lang="la">2. martii anno <lb xml:id="p1z32"/>domini 1562.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z33"/>T[uus] <persName ref="p8009">Fab[ricius</persName>].</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>suo in Christo patri <lb xml:id="p2z4"/>semper honorando.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>