	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Quid agendum, si quis post sumptionem conot
					<lb xml:id="p1z2"/>Christi statim patiatur vomitum.
					<lb xml:id="p1z3"/>Reverenter recolligantur speries panis, si discer,
					<lb xml:id="p1z4"/>possunt et reponantur in sacrario vel
					<lb xml:id="p1z5"/>ab aliquo, si saltem adsit aliquis ad
					<lb xml:id="p1z6"/>sumendum dispositus absque nausea et ea in
					<lb xml:id="p1z7"/>quibus inventae fuerint species, comburantur
					<lb xml:id="p1z8"/>et cieres insacrario recondantur.
					<lb xml:id="p1z9"/>uid agendum si quis post sumptionem
					<lb xml:id="p1z10"/>ex infirmitate statim emittat persecessum quo
					<lb xml:id="p1z11"/>sumpsit.
					<lb xml:id="p1z12"/>Recolligantur speries et fiat, sicut in casum
					<lb xml:id="p1z13"/>praecedentis dubii.
					<lb xml:id="p1z14"/>Ex libro, quem hoc anoque edidit capimlis Augustae
					<lb xml:id="p1z15"/>De celebratione aveonr Diligae impreco.
				</p>
			</div>
		</body>
	</text>
