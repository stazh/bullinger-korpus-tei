	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="de">Uff necht hab ich schriben empfangen von <placeName ref="l18">Augspurg</placeName>, <lb xml:id="p1z2"/>das der herr <persName>Niclausß von Gravell</persName>, kai[serlicher] m[ajesta]t <lb xml:id="p1z3"/>oberester rath, zuͦ <placeName ref="l18">Augspurg</placeName>, da er dann ouch sein <lb xml:id="p1z4"/>wyb und kind gehapt, gestorben und auff 30. augsten <lb xml:id="p1z5"/>gen <placeName>Blesentz</placeName> in <placeName ref="l631">Burgund</placeName> gefuͤrt seye.</s>
					<s n="3" xml:lang="de">Da ist <lb xml:id="p1z6"/>grosß fröd und laid allenthalb.</s>
					<s n="4" xml:lang="de">Gott helff vyl <lb xml:id="p1z7"/>leuten bald mitt gnaden nache!</s>
					<s n="5" xml:lang="de">Er ist ain gwaltig <lb xml:id="p1z8"/>mann und kaiser selbs gewesen.</s>
					<s n="6" xml:lang="de">Hapt mich fuͤr <lb xml:id="p1z9"/>bevolchen.</s>
					<s n="7" xml:lang="de">Datum den 12. septembris 1550.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/><persName ref="p8055">Ambr[osius] Bl[aurerus</persName>].</s>
				</p>
				<p>
					<s n="9" xml:lang="de"><lb xml:id="p1z11"/>Vom alten landtvogt im <placeName ref="l774">Turgöuw</placeName> sagt <lb xml:id="p1z12"/>man, er seye zuͦ <placeName ref="l300">Lucern</placeName> gefangen; <lb xml:id="p1z13"/>lasst mich bym Jeronymo wissen; <lb xml:id="p1z14"/>der kompt hutt widerum her.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Bullingero</persName> suo.</s>
				</p>
			</div>
		</body>
	</text>
