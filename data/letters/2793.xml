	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Pacem et gratiam a domino etc.</s>
					<s n="2" xml:lang="la">Certiorem te reddo, vir humanissime, <persName ref="p3206">Valentinum <lb xml:id="p1z2"/>Scudum</persName>, <placeName ref="l646">Glaronensis</placeName> ecclesię pastorem, ad dominum migrasse et me indignum in <lb xml:id="p1z3"/>locum ipsius substitutum.</s>
					<s n="3" xml:lang="la">Timeo Atlantem coelum suscepisse; perfectiora enim omnia illic <lb xml:id="p1z4"/>invenisse, quam invenerim, mallem; sed confisus dei bonitati ipsum meis laboribus <lb xml:id="p1z5"/>et conatibus haud defore sperabo, cuius auxilio omnia perfectiora sint futura.</s>
					<s n="4" xml:lang="la">Caret <lb xml:id="p1z6"/>nunc ecclesia illa, cui praefui 23 annos, pastore; oratum ob id te volumus, ut nobis <lb xml:id="p1z7"/>virum doctrina et pietate sy[n]cerum mittas, cui[us] fidei ministerium <lb xml:id="p1z8"/>verbi tuto committatur.</s>
					<s n="5" xml:lang="la">Habebit annatim ex stipendio ecclesiastico 70 <lb xml:id="p1z9"/>aureos.</s>
					<s n="6" xml:lang="la">Hoc si feceris, gratissimam et deo et nobis es facturus.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z10"/>in domino.</s>
					<s n="8" xml:lang="la">Ex <placeName ref="l176">Glarona</placeName> 28. die decembris datę anno 1555.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z11"/><persName ref="p8303">Fridolinus Fonteius</persName> tuus, <lb xml:id="p1z12"/>nunc <placeName ref="l646">Glaronensis</placeName> ecclesię <lb xml:id="p1z13"/>pastor.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="10" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem erwirdigen und wolgele<lb xml:id="p2z2"/>rten m. <persName ref="p495">Heinrich Bullinger</persName>, <lb xml:id="p2z3"/>diner der kylch zuͦ <placeName ref="l587">Zürich</placeName>, <lb xml:id="p2z4"/>minem günstigen herren, zuͦ <lb xml:id="p2z5"/>handen.</s>
				</p>
			</div>
		</body>
	</text>
