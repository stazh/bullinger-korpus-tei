	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Saepius a pluribus tuo nomine salutatus, mi <persName ref="p495">Bullinghere</persName> <lb xml:id="p1z2"/>charissime, facile colligere possum nullas te in has regiones <lb xml:id="p1z3"/>literas mittere, in quibus mei memoriam honorificam <lb xml:id="p1z4"/>non habeas.</s>
					<s n="2" xml:lang="la">In qua tua benevolentia, ut tibi gratias <lb xml:id="p1z5"/>ago infinitas, dominum oro, ne unquam tui obliviscatur in <lb xml:id="p1z6"/>die illo.</s>
					<s n="3" xml:lang="la"><placeName ref="l875">Hispani</placeName> in <placeName ref="l834">Italia</placeName> plures dicuntur esse, <lb xml:id="p1z7"/>plures etiam expectantur ad adventum ducis <placeName>Albani</placeName>; <lb xml:id="p1z8"/>quo vero sint ituri, nemo adhuc rescire potuit.</s>
					<s n="4" xml:lang="la">Hoc <lb xml:id="p1z9"/>pro certo tibi ausim affirmare: papae, <placeName ref="l875">Hispano</placeName> et <placeName ref="l832">Gallo</placeName> <lb xml:id="p1z10"/>optime convenire.</s>
					<s n="5" xml:lang="la">Quo vero tendunt eorum consilia, nisi <lb xml:id="p1z11"/>contra Christi regnum, quis nesciat?</s>
					<s n="6" xml:lang="la"><placeName ref="l2510">Turcha</placeName>, ut <lb xml:id="p1z12"/>ferunt, qui nuper ad nos <placeName ref="l546">Vienna</placeName> venerant, inducias per <lb xml:id="p1z13"/>decennium fecit cum imperatore.</s>
					<s n="7" xml:lang="la">Id vero an certum sit, nescio; <lb xml:id="p1z14"/>sed in dies filium meum <persName>Rodolfum</persName> ab imperatore expecto.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Is nos de omnibus his certiores reddet.</s>
					<s n="9" xml:lang="la">De quibus et aliis omnibus <lb xml:id="p1z16"/>ab illo aut undevis certi facti vos admonere non gravabor.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z17"/>Vale interim et dominum tuis precibus, ut mihi semper adsit, <lb xml:id="p1z18"/>solicitabis.</s>
					<s n="11" xml:lang="la" ana="salute">Salutabis etiam meo nomine illustrissimos <lb xml:id="p1z19"/>et magnificos <lb xml:id="p1z20"/>dominos urbis praefectos.</s>
					<s n="12" xml:lang="la" ana="salute">Saluto domesticam tuam ecclesiam.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/>Dominus benedicat tuis sanctis laboribus.</s>
				</p>
				<p>
					<s n="14" xml:lang="de">Amen.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z22"/>Datum <placeName ref="l93">Clavennę</placeName> die 25. aprilis 1567.</s>
				</p>
				<p>
					<s n="16" xml:lang="de"><lb xml:id="p1z23"/><persName ref="p8093">Hercules von Salisis</persName>, <lb xml:id="p1z24"/>üwer alizit.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo <lb xml:id="p4z2"/>viro ac patri pii<lb xml:id="p4z3"/>ssimo <lb xml:id="p4z4"/>domino <persName ref="p495">Henricho Buling<lb xml:id="p4z5"/>ero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p4z7"/>fidelissimo ministro.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p4z8"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>