	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non vacat nunc multis scribere, nec aliquid attingam de <lb xml:id="p1z2"/>ineptiis <persName ref="p8423">Pfifferi</persName>, cum nihil putem regi fraudi esse posse et afferre <lb xml:id="p1z3"/>praeiudicium, si ius et ęquum obtineant et serventur foedera.</s>
					<s n="3" xml:lang="la">Boni il<lb xml:id="p1z4"/>li theologi, qui ad <persName>Philippum</persName> proficiscebantur, ut eum animarent <lb xml:id="p1z5"/>in <placeName ref="l832">Galliam</placeName> religionis nomine, capti sunt.</s>
					<s n="4" xml:lang="la">Alie exorientur tragedie.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Hoc volebant: <lb xml:id="p1z6"/>Flectere si nequeo superos, <persName>Acheronta</persName> movebo.</s>
					<s n="6" xml:lang="la">Volebant exuri et occidi <lb xml:id="p1z7"/>omnes suspectos, ne quid de illorum questu et ambitione decederet.</s>
					<s n="7" xml:lang="la">Literas tuas <lb xml:id="p1z8"/>recepit r.N.<note type="misc">rex noster?</note> cum libro; gratissima illi fuerunt omnia <lb xml:id="p1z9"/>er regin<lb xml:id="p1z10"/>e matri <lb xml:id="p1z11"/>et multis aliis.</s>
					<s n="8" xml:lang="la">6. huius mensis <placeName ref="l425">Rome</placeName> caput amputatum duci <lb xml:id="p1z12"/><persName>Paliano</persName>, comiti d'Alifa<note type="misc">dalifa</note> et d. <persName>Leonardo de Cardine</persName> et <persName>cardinalis <lb xml:id="p1z13"/>Carafa</persName> strangulatus in carcere, ferturis<note type="misc">serturis?</note> ludibria.</s>
					<s n="9" xml:lang="la">Ante dietam <lb xml:id="p1z14"/>proximam invisam dominos, et colloquemur.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Eos salutabis et amicos om<lb xml:id="p1z15"/>nes nosque amabis.</s>
					<s n="11" xml:lang="la">Scis consilium reiectum ad comitia, que <lb xml:id="p1z16"/>erunt <placeName ref="l569">Wormatie</placeName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Interim forsan nationale erit et <persName>Gallici</persName>.</s>
					<s n="13" xml:lang="la"><placeName ref="l760">Soluduri</placeName> <lb xml:id="p1z17"/>19. martii.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z18"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z19"/>Mitto d. <persName>Valentino</persName> libellos duos scriptos Italice <lb xml:id="p1z20"/>a <persName ref="p3375">Vergerio</persName> de consilio.</s>
					<s n="16" xml:lang="la">Is Latinos ad me misit <lb xml:id="p1z21"/>manu descriptos; eos si volueris, ad te mittam.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
