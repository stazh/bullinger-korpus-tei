	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Dum nuncios, per quos ad te scribam, expecto, ea, qua<lb xml:id="p1z2"/>e scripturus eram, antiqua fiunt et exoleta.</s>
					<s n="3" xml:lang="la">Hoc nunc <lb xml:id="p1z3"/>mihi aliquoties contigit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Scripseram nuper per hunc <lb xml:id="p1z4"/>eundem, qui se receperat a <placeName ref="l339">Neocomo</placeName> huc redire velle; <lb xml:id="p1z5"/>sed, dum ipsum expecto, <placeName ref="l587">Tigurum</placeName> recta profectus est relictis hic literis.</s>
					<s n="5" xml:lang="la">Nu<lb xml:id="p1z6"/>nc reversum spero has recepturum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Novi vero nunc parum <lb xml:id="p1z7"/>habeo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Heri demum audivimus primo Elicurtense castrum <lb xml:id="p1z8"/>a <placeName ref="l572">Wirtenbergense</placeName> esse expugnatum.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Patefient nunc, si quę <lb xml:id="p1z9"/>secretiora latuerunt consilia.</s>
					<s n="9" xml:lang="la">Quid <placeName ref="l28">Basileae</placeName> factum sit, <lb xml:id="p1z10"/>scribere nihil est necesse, cum nimirum hoc prius ex vestro <lb xml:id="p1z11"/>resciveris legato d. <persName>Tumisio</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Expectatur nunc, an princeps <lb xml:id="p1z12"/>sententiam ibi latam sit recepturus; nostri ut nec opinantur <lb xml:id="p1z13"/>eum hoc facturum, ita nec vellent etiam; ita enim plus <lb xml:id="p1z14"/>iuris et favoris ad totam ditionem retinendam habituri <lb xml:id="p1z15"/>videbuntur.</s>
					<s n="11" xml:lang="la">Expectatur hic <persName>Longovillanus dux</persName>, ad quem <placeName ref="l339">N<lb xml:id="p1z16"/>eocomensis</placeName> comitatus spectat; habet enim de eo comitatu <lb xml:id="p1z17"/>quod cum nostris agat.</s>
					<s n="12" xml:lang="la">Audimus eum erga religionem bene <lb xml:id="p1z18"/>esse affectum et ducere secum ministrum.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName>Waldenses</placeName> <lb xml:id="p1z19"/>ferunt denuo post tantos successus cum principe pacisci <lb xml:id="p1z20"/>velle; dat eis bona verba, sed mirum, si non fallat ipsos.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z21"/>In <placeName ref="l832">Gallia</placeName> res sunt dubię; <persName>Vandomius</persName> nullius est precii; <lb xml:id="p1z22"/>interea tamen florent et crescunt ecclesiae.</s>
					<s n="15" xml:lang="la"><placeName ref="l301">Lugduni</placeName> ferunt <lb xml:id="p1z23"/>quendam in proxima corporis Christi festivitate, dum solennis <lb xml:id="p1z24"/>haberetur processus, ereptum sacrificulo panaceum deum <lb xml:id="p1z25"/>una cum monstrantia, ut vocant, humo illisisse et <lb xml:id="p1z26"/>pedibus proculcasse; ipsum vero eodem die primo man<lb xml:id="p1z27"/>u dextra truncatum et postea in quatuor partes dissectum <lb xml:id="p1z28"/>esse.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Alias nunc ex <placeName ref="l832">Gallia</placeName> nihil habemus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Ad <lb xml:id="p1z29"/><placeName ref="l648">Rhoetos</placeName> nos quoque scripsimus et cohortati sumus illos ad <lb xml:id="p1z30"/>pacem; qui errores lateant, nescimus; videntur tamen in <lb xml:id="p1z31"/>exercenda illa disciplina quoque esse nimii; pleręque enim earum <lb xml:id="p1z32"/>quaestionum, quas <persName>Angelus</persName> proposuit, ex illa materia dependent.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z33"/>Nostri <persName>Galli</persName> nos quoque circa hanc subinde exercent.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Nos <lb xml:id="p1z34"/>disciplinae ipsi non reluctamur, quę utinam quam optime <lb xml:id="p1z35"/>esset instituta!</s>
					<s n="20" xml:lang="la">Sed videmur praevidere non minus turbarum <lb xml:id="p1z36"/>eam daturam ecclesiis quam dedit olim, ut et patrum <lb xml:id="p1z37"/>scripta et ecclesiasticae historiae testantur.</s>
					<s n="21" xml:lang="la">Quid <placeName ref="l28">Basileae</placeName> <lb xml:id="p1z38"/>et <placeName ref="l491">Argentinae</placeName> fiat, non ignoratis; ideo non est necesse, ut <lb xml:id="p1z39"/>de his quicquam scribam.</s>
					<s n="22" xml:lang="la">Miramur, quis fuerit eventus <lb xml:id="p1z40"/><placeName ref="l98">Curiensis</placeName> synodi; si quid habes, communica nobis.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="salute">Salutant <lb xml:id="p1z41"/>te nostri omnes.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><persName ref="p7449">Diesbachius</persName> <placeName ref="l21">Badenae</placeName> est; <persName>Emanuel</persName> hodie <lb xml:id="p1z42"/><placeName ref="l1187">Luganum</placeName> proficiscitur.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><persName ref="p4060">Zehenderi</persName> ad te missuri erant aliquid; <lb xml:id="p1z43"/>sed mittent hoc per alium quendam, qui his diebus hunc <lb xml:id="p1z44"/>subsequetur.</s>
					<s n="26" xml:lang="la"><persName>Samuel</persName> tamen, meus simul et tuus affinis, has <lb xml:id="p1z45"/>tibi mittit.</s>
				</p>
				<p>
					<s n="27" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="28" xml:lang="la" ana="salute">Salutem dic universae domui <lb xml:id="p1z46"/>tuę meo meorumque omnium nomine.</s>
				</p>
				<p>
					<s n="29" xml:lang="la">Salvi sint item fratres <lb xml:id="p1z47"/>et symmystae omnes.</s>
					<s n="30" xml:lang="la"><placeName ref="l41">Bernae</placeName> 18. iunii 1561.</s>
				</p>
				<p>
					<s n="31" xml:lang="la"><lb xml:id="p1z48"/><persName ref="p8018">I[oannes] Hall[erus</persName>] tuus perpetuo.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino suo honorando et <lb xml:id="p2z5"/>compatri charissimo.</s>
				</p>
			</div>
