	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non habeo aliud, quod ad te scribam; ita me quaedam <lb xml:id="p1z2"/>negotia urgent.</s>
					<s n="3" xml:lang="la">Mitto ad d. <persName ref="p3375">Vergerium</persName> literas tuas.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z3"/>Miror tam coecos esse principes <placeName ref="l822">Germaniae</placeName>, ut nunc <lb xml:id="p1z4"/>saltem non intelligant, quo <persName ref="p18538">Caesaris</persName> consilia et ambages <lb xml:id="p1z5"/>tendant.</s>
					<s n="5" xml:lang="la">Si quid erit novi, faciam te certiorem.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/>Idem a tua humanitate expecto.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale, vir clarissime.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z7"/><placeName ref="l98">Curiae</placeName>, 9. calendas septembris<note type="margin">a.R.: ... /...</note>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z8"/>Tuus episcopus <placeName ref="l1206">Bayonensis</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p4z1"/>Doctissimo viro, domino <lb xml:id="p4z2"/><persName ref="p495">Heinrico Bullingero</persName>, ecclesiae <lb xml:id="p4z3"/><placeName ref="l587">Tigurinae</placeName> ministro, amico <lb xml:id="p4z5"/>charissimo.</s>
				</p>
			</div>
		</body>
	</text>
