	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Viro doctrina ac pietate insigni domino <lb xml:id="p1z2"/><persName ref="p495">Henrico Bullingero</persName>, <placeName ref="l587">Tigurinorum</placeName> ecclesie pastori <lb xml:id="p1z3"/>vigillantissimo, <persName ref="p8473">Anne de Tserclas</persName><note xml:id="fn1" type="footnote" n="1">t'Serclaes? Evtl. konsultieren: André Monteyne: T'Serclaes. Une famille bruxelloise, [Brüssel] 1987.</note> S. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z4"/>Accepi literas tuas, vir christianissime, quibus veluti in speculo, <lb xml:id="p1z5"/>quantum pro nobis sis sollicitus, conspexi.</s>
					<s n="3" xml:lang="la">Etsi vero me tuę <lb xml:id="p1z6"/>tam singulari in nos amicitię gratiis persolvendis longe <lb xml:id="p1z7"/>inparem agnosco, agere tamen non desistam immortales deum <lb xml:id="p1z8"/>ac patrem domini nostri Iesu Christi precata ex animo, ut, quod hac <lb xml:id="p1z9"/>in parte praestare non possum, habundantissime penset.</s>
					<s n="4" xml:lang="la">Causam <lb xml:id="p1z10"/>vinculorum domini <persName ref="p1560">Hoperi</persName> tantisper per me non rescies, donec illi <lb xml:id="p1z11"/>tuas litteras communicavero, quod nunc minime licet; abiit <lb xml:id="p1z12"/>enim mox, ubi solutus fuit, in suum episcopatum.</s>
					<s n="5" xml:lang="la">Non <lb xml:id="p1z13"/>dubito, quin ipsemet tuo desiderio sit satisfacturus, postquam <lb xml:id="p1z14"/>illud compertum habuerit, atque id quidem mihi valde <lb xml:id="p1z15"/>commodius videtur, quam si eo inconsulto hoc tentarem.</s>
					<s n="6" xml:lang="la">Quia <lb xml:id="p1z16"/>vero percontaris, quomodo <persName ref="p21204">Rachel</persName> filia mea adolescat, officii <lb xml:id="p1z17"/>mei esse iudicavi nonnihil de illa scribere.</s>
					<s n="7" xml:lang="la">Inprimis <lb xml:id="p1z18"/>scito illam esse Anglici ydiomatis peritam, tresque iam <lb xml:id="p1z19"/>menses effluxisse, ex quibus formulam actionis gratiarum <lb xml:id="p1z20"/>edocta, decem precepta, orationem dominicam, symbolum <lb xml:id="p1z21"/>apostolicum, una cum primo atque secundo <persName ref="p18877">Davidis</persName> psalmo <lb xml:id="p1z22"/>memoria tenet.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Iam quia fere omnium litterarum characteres <lb xml:id="p1z23"/>agnoscit, instituitur in cathechismo.</s>
					<s n="9" xml:lang="la">Si Germanice <lb xml:id="p1z24"/>scribere scirem, manum calamo admoverem frequentius.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/>Verum si filium tuum in angliam venire contingat, maior <lb xml:id="p1z26"/>dabitur copia cum scribendi, tum paternum tuum in nos <lb xml:id="p1z27"/>animum (quem pluris facio quam locupletissimos auri vel <lb xml:id="p1z28"/>argenti thesauros) aliqua ex parte pensandi.</s>
					<s n="11" xml:lang="la">De <placeName ref="l2665">Hibernia</placeName> <lb xml:id="p1z29"/>nihil habeo quod scribam, preterquam quod <persName ref="p8112">Gal[l]orum regem</persName> <lb xml:id="p1z30"/>classem aliquam, qua illam invaderet submitteretque <lb xml:id="p1z31"/>suo sceptro, instruxisse dicunt, sed cuiusdam fidelis <placeName ref="l832">Gal[l]i</placeName> <lb xml:id="p1z32"/>diligentia illius consilia detecta sunt.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Mitto tibi <lb xml:id="p1z33"/>nummulum aureum, in quo <persName ref="p3207">regis Anglorum</persName> effigies satis <lb xml:id="p1z34"/>eleganter descripta est,<note xml:id="fn2" type="footnote" n="2">Vgl. <persName ref="p495">Bullingers</persName> privates Testament!</note> pro pignore quod ad <persName ref="p21204">Rachelem</persName> <lb xml:id="p1z35"/>legasti, propter quod ipsa quoque suo puerili eloquio <lb xml:id="p1z36"/>gratiam agit, ac te plurimum salutat.</s>
					<s n="13" xml:lang="la">Obtestor te ut dominum <lb xml:id="p1z37"/><persName ref="p1560">Hoperum</persName> quo suos labores temperet permoneas: nam quotidie <lb xml:id="p1z38"/>quattuor vel ad minimum tres conciones habet; vereor autem ne <lb xml:id="p1z39"/>immature plus satis vigilie morbum illi concili[a]bunt, quo et <lb xml:id="p1z40"/>doctore et doctrina orbentur complures divini verbi anime <lb xml:id="p1z41"/>admodum esurientes, quarum nota est esuries ex crebra <pb/><lb xml:id="p2z1"/>ipsius audiendi propensione.</s>
					<s n="14" xml:lang="la">Plurimum nos hic divexat turbarum <lb xml:id="p2z2"/>timor; nam periculum est, ne proxime ingentes tumultus excitentur <lb xml:id="p2z3"/>propter annone ceterarumque rerum caritatem, quamquam fromenti <lb xml:id="p2z4"/>atque aliorum ingens sit copia; sed in quos reiicienda sit culpa, <lb xml:id="p2z5"/>ipse me melius nosti.</s>
					<s n="15" xml:lang="la">Misi litteras tuas domino <lb xml:id="p2z6"/><persName ref="p1560">Hopero</persName>, quibus cum responderit, curabo ut tibi reddantur <lb xml:id="p2z7"/>litere sue.</s>
					<s n="16" xml:lang="la" ana="farewell">Vale.</s>
					<s n="17" xml:lang="la" ana="salute">Saluta dominum <persName ref="p8171">Bibliandrum</persName> et eius coniugem, <lb xml:id="p2z8"/>dominum <persName ref="p8011">Gvalterum</persName>, dominum <persName ref="p8127">Pel[l]icanum</persName>, una cum ipsorum uxoribus, <lb xml:id="p2z9"/>dominum <persName ref="p7228">Zvinglium</persName>, et eius uxorem, ad quam etiam mitto nummulum <lb xml:id="p2z10"/>aureum regia effigie insculptum.</s>
					<s n="18" xml:lang="la"><placeName ref="l296">Londini</placeName>, 3° die aprilis.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z11"/>Tui observandissima, <lb xml:id="p2z12"/><persName ref="p8473">Anne de Tserclas</persName> dict.</s>
					<s n="20" xml:lang="la"><persName>Hoper[a].</persName></s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="salute"><lb xml:id="p2z13"/>Salutat te <persName>Iohanna</persName> ancilla mea, eiusque maritus <lb xml:id="p2z14"/><placeName ref="l832">Gal[l]orum</placeName> ecclesie minister.</s>
					<s n="22" xml:lang="la"><lb xml:id="p2z15"/>Si ad dominum <persName ref="p1560">Hoperum</persName> vel ad me scripseris, omni diligentia <lb xml:id="p2z16"/>literas tuas obsignari cura; nam curiosuli quidam solent <lb xml:id="p2z17"/>illas aperire ac p[er]legere<note type="margin">a.R.: ... [prae</note>], si quo pacto eas aperire possint.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p4z1"/>Viro doctrina ac pietate insigni, <lb xml:id="p4z2"/>domino <persName ref="p495">Henrico Bul[l]ingero</persName>, <lb xml:id="p4z3"/><placeName ref="l587">Tigurinorum</placeName> ecclesię pastori vigilantissimo.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p4z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
