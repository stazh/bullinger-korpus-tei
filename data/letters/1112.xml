	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino, <persName ref="p495">Henryche</persName> doctissime.</s>
					<s n="2" xml:lang="la">Puto te librum <persName ref="p4926">Gerbelii</persName> acce<lb xml:id="p1z2"/>pisse a <persName ref="p4851">Froscovero</persName>, in cuius vase fuit inclusum cum literis, vel si <lb xml:id="p1z3"/>non accepisti, accede <persName ref="p4851">Froscoverum</persName> et pete ab illo.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Novi nihil habemus.</s>
					<s n="4" xml:lang="de"><foreign xml:lang="la">De <placeName ref="l303">Magdeburgensibus</placeName> certum est,</foreign> das sy, die <lb xml:id="p1z5"/>iren z ug geschlagen haben im abzug, haben ire geschützs und <lb xml:id="p1z6"/>muinition widerumb erlangt, <foreign xml:lang="la">et per illorum fortunam redditum est.</foreign></s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/><persName ref="p18250">Mauritius</persName> munit civitates suas et arces ac imponit pręsidia.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Betuleius ad me scripsit ex <placeName ref="l18">Augusta</placeName>: <placeName ref="l749">Saxonicę</placeName> civitates designarunt <lb xml:id="p1z9"/>nobile factum et habent, qui ipsorum causam suscipiunt, qui, <lb xml:id="p1z10"/>ut fertur, hybernabunt in <placeName ref="l1041">Brunswick</placeName> repugnante incendiario.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>A Venetis petit <placeName ref="l2510">Turca</placeName> iter in <placeName ref="l834">Italiam</placeName>, denegat <placeName ref="l1121">Genuensibus</placeName> <lb xml:id="p1z12"/>frumenta iussitque illos secedere nec reverti.</s>
					<s n="8" xml:lang="la">Caesaris crude<lb xml:id="p1z13"/>litatem, quam exercuit in <placeName ref="l2549">Africanos</placeName>, inultam sinere non vult; ideo <lb xml:id="p1z14"/>sub ver proximum habebimus bellum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/><placeName ref="l18">Augustę</placeName> 43 fures capti, ex quorum numero multi <lb xml:id="p1z16"/>suspensi sunt.</s>
					<s n="10" xml:lang="la">Sic <placeName ref="l875">Hispani</placeName> debent cruces ornare publicas.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z17"/>Dominus <persName ref="p4261">Bebelius</persName>, quem nosti, 15. huius mensis sepultus est, quem 16. die <lb xml:id="p1z18"/>subsecutus est <persName ref="p8349">Rodolphus Frey</persName>, evangelio Christi addictissimus.</s>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z19"/>Vale.</s>
					<s n="13" xml:lang="la">Mox plura.</s>
					<s n="14" xml:lang="la" ana="salute">Dominus <persName ref="p2916">Schertlinus</persName> te resalutat, apud quem <lb xml:id="p1z20"/>pransurus sum; qui narrabit mihi nova quędam.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z21"/><placeName ref="l28">Basileę</placeName> 17. decembris 1550.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z22"/>Tuus <persName ref="p1278">Gastius</persName> <pb/><lb xml:id="p2z1"/>ex animo.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">D. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z4"/>vigilantissimo, praeceptori <lb xml:id="p2z5"/>suo summe observ<lb xml:id="p2z6"/>ando.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
