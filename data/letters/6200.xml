	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Gratulor vobis, optime pater, singularem <lb xml:id="p1z2"/>dei benedictionem, qua vos a communi <lb xml:id="p1z3"/>fere omnibus pestilentia servat.</s>
					<s n="3" xml:lang="la">Grassatur <lb xml:id="p1z4"/>illa etiam <placeName>Bergomi</placeName> mirabiliter.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><placeName ref="l93">Claven<lb xml:id="p1z5"/>nę</placeName> videtur remisisse, quod satura sit <lb xml:id="p1z6"/>septingentis et amplius hominibus; supersunt <lb xml:id="p1z7"/>enim paucę aliquot reliquię; proinde <lb xml:id="p1z8"/>non possunt multi amplius nobis tolli, <lb xml:id="p1z9"/>et si aliqui corripiantur, illorum plerique <lb xml:id="p1z10"/>iam convalescunt.</s>
					<s n="5" xml:lang="la">Deo sit laus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Cęterum, ut video, non tam cito colligetur <lb xml:id="p1z12"/>iterum ecclesia, quam fuit dissipata.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Dominus me quoque et familiam mira<lb xml:id="p1z14"/>biliter servavit.</s>
					<s n="8" xml:lang="la">Cum discederem <placeName ref="l93">Clavenna</placeName>, <lb xml:id="p1z15"/>reliqui in ędibus quendam optimum <lb xml:id="p1z16"/>fratrem cum uxore, ut eas custodirent.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/>Non ita multo post fuit locus, ubi <lb xml:id="p1z18"/>purgari solebant nostri panni, a nebulonibus <lb xml:id="p1z19"/>quibusdam, qui multas quoque aliorum fores <lb xml:id="p1z20"/>et aedium pessulos adipe nescio quo <lb xml:id="p1z21"/>pestifero infecerant, eodem veneno <lb xml:id="p1z22"/>infectus.</s>
					<s n="10" xml:lang="la">Bona matrona ubi cepit <lb xml:id="p1z23"/>pannos purgare, mox correpta <lb xml:id="p1z24"/>dolore capitis incidit in febrim, <pb/><lb xml:id="p2z1"/>deinde maritus, qui et mortuus <lb xml:id="p2z2"/>est; sed uxor convalescit dei benefitio.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z3"/>Ego in monte quodam solitarius et <lb xml:id="p2z4"/>verus heremita cum mea familia <lb xml:id="p2z5"/>valeo optime et totus orationi et <lb xml:id="p2z6"/>lectioni atque scriptionibus vaco ex<lb xml:id="p2z7"/>pectans, dum me revocet dominus.</s>
					<s n="12" xml:lang="la">Videor <lb xml:id="p2z8"/>mihi <persName>Ionas</persName> esse in hoc monte ex <lb xml:id="p2z9"/>adverso meę ecclesię, nisi quod ille <lb xml:id="p2z10"/>eversam cupiebat Nineven, ego vero <lb xml:id="p2z11"/>restitutam et salvam meam <placeName ref="l93">Clavennam</placeName>.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z12"/>Maximo certe dolore me confecit <lb xml:id="p2z13"/>hęc calamitas nostrę ecclesię, sed non <lb xml:id="p2z14"/>minori, ne dicam maiori, at procul dub<lb xml:id="p2z15"/>io maiori mors nostri <persName ref="p540">Calvini</persName> praesertim <lb xml:id="p2z16"/>hoc tempore.</s>
					<s n="14" xml:lang="la">Misereatur dominus suę ecclesię.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z17"/>Quinque columnas intra paucos annos eri<lb xml:id="p2z18"/>puit nobis dominus, <persName>Philippum</persName>, <persName ref="p8111">Martyrem</persName>, <lb xml:id="p2z19"/><persName ref="p8417">Musculum</persName>, <persName ref="p8386">Hyperium</persName>, <persName ref="p540">Calvinum</persName>, beatos <lb xml:id="p2z20"/>quidem illos, qui fruuntur conspectu <lb xml:id="p2z21"/>tandem exoptato illius boni domini Iesu, <lb xml:id="p2z22"/>pro quo multa sunt passi; sed <lb xml:id="p2z23"/>interim misera ecclesia non facile inveniet <lb xml:id="p2z24"/>alios <persName>Philippos</persName>, <persName ref="p8111">Martyres</persName>, <persName ref="p8417">Musculos</persName>, <persName ref="p540">Calvinos</persName>.</s>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p3z1"/>Servet ergo te dominus et in aliis <lb xml:id="p3z2"/>suis servis non contemnendis, <lb xml:id="p3z3"/>qui superstites sunt, adaugeat <lb xml:id="p3z4"/>donum, perdat vero hęreticos ac <lb xml:id="p3z5"/>sectarios omnes vel ad meliorem <lb xml:id="p3z6"/>mentem convertat!</s>
					<s n="17" xml:lang="la">Sentiet <persName ref="p458">Brentius</persName> <lb xml:id="p3z7"/>manum domini, nisi resipiscet.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p3z8"/>Aveo intelligere, qualem exitum habuerit <lb xml:id="p3z9"/>illa disputatio <placeName ref="l210">Heydelberg[ensis]</placeName> cum <lb xml:id="p3z10"/><placeName ref="l512">Tubingensibus</placeName>.</s>
					<s n="19" xml:lang="la">Vehementer mihi <lb xml:id="p3z11"/>gratum fuit, quod scripsisti de composition<lb xml:id="p3z12"/>e dissidii, quod fuerat inter vestros <lb xml:id="p3z13"/>Pagos et de spe, quam habes <lb xml:id="p3z14"/>pacis inter <placeName ref="l41">Bernates</placeName> et ducem <placeName ref="l2478">Sabaudię</placeName>; <lb xml:id="p3z15"/>proderit <placeName ref="l167">Genevę</placeName>.</s>
					<s n="20" xml:lang="la">Quod <placeName ref="l832">Galliam</placeName> <lb xml:id="p3z16"/>attinet, dominus proficiet, quod incepit, <lb xml:id="p3z17"/>utut mundus et omnes portę inferorum <lb xml:id="p3z18"/>fremant, ringantur, insaniant.</s>
					<s n="21" xml:lang="la"><lb xml:id="p3z19"/>Scripseram quidem iampridem literas <persName ref="p8033">Bezę</persName> <lb xml:id="p3z20"/>illas, quas ad me miseras, a me <lb xml:id="p3z21"/>remitti, sed postea eas includere <lb xml:id="p3z22"/>in meis oblitus fueram; nunc ergo <lb xml:id="p3z23"/>eas habes hic inclusas.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Ignosce.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="salute"><lb xml:id="p3z24"/>Cupio vero resalutari fratres et amicos <lb xml:id="p3z25"/>omnes.</s>
					<s n="24" xml:lang="la">Ego vero, quos iussisti, salutabo<pb/><lb xml:id="p4z1"/>.</s>
					<s n="25" xml:lang="la"><lb xml:id="p4z2"/>Perlegi partim <placeName ref="l93">Clavennę</placeName>, dum ferveret <lb xml:id="p4z3"/>pestis, partim in hoc meo eremo <lb xml:id="p4z4"/>omnes nostri <persName>Rodolphi</persName> in minores prophetas <lb xml:id="p4z5"/>et in Marcum homilias non sine <lb xml:id="p4z6"/>voluptate et fructu; sed quędam <lb xml:id="p4z7"/>habeo, quę ad illum scribam, cum <lb xml:id="p4z8"/>plus otii habuero; nunc non vacat.</s>
					<s n="26" xml:lang="la" ana="salute"><lb xml:id="p4z9"/>Illi salutem dices meo nomine.</s>
					<s n="27" xml:lang="la">De nostro <lb xml:id="p4z10"/>Iosia nihil audio, scripseram tamen <lb xml:id="p4z11"/>ad illum <placeName ref="l93">Clavenna</placeName> paulo ante meum <lb xml:id="p4z12"/>discessum, nihil etiam de <persName>Iulio</persName> et <lb xml:id="p4z13"/>an convaluerit filiolus.</s>
				</p>
				<p>
					<s n="28" xml:lang="la" ana="farewell"><lb xml:id="p4z14"/>Vale, optime pater, et dominus te servet <lb xml:id="p4z15"/>nobis diu incolumem.</s>
					<s n="29" xml:lang="la">Amen.</s>
					<s n="30" xml:lang="la"><lb xml:id="p4z16"/>Ex Eremo 21. iulii 64.</s>
				</p>
				<p>
					<s n="31" xml:lang="la"><lb xml:id="p4z17"/>Tuus totus <persName ref="p4037">H[ieronymus] Zanchus</persName>.</s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
					<s n="32" xml:lang="la" ana="salute"><lb xml:id="p4z18"/>Salutat te <lb xml:id="p4z19"/><persName ref="p8432">Fridericus</persName> tuus totus.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
