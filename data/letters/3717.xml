					<lb xml:id="p1z1"/>Misi ad te per l agriolam, doctissime Bullingere, que lentia
					<lb xml:id="p1z2"/>veritatem evangelii sunt promulitata eodita. na
					<lb xml:id="p1z3"/>quos solere miseris ministris captiose proponere
					<lb xml:id="p1z4"/>irrepire qutd deterbere; iam inatuisitio procedit stremune
					<lb xml:id="p1z5"/>quallatura sit, nant dominus, non est opus multu
					<lb xml:id="p1z6"/>eaggerire horum artieclorum a monabao quodam domini past
					<lb xml:id="p1z7"/>mutanto et lerum inegferto; alioquisi ptrumque parentem
					<lb xml:id="p1z8"/>uspicias nantio bono laterum et ita ut cedat eos ess
					<lb xml:id="p1z9"/>vilentissimos; nam si princeps prudelem hanc Carnitiona
					<lb xml:id="p1z10"/>conscentatur, plas pemp aet impietatem cognosceret
					<lb xml:id="p1z11"/>non possum, credere, quod eos articulos ebaminando
					<lb xml:id="p1z12"/>et torgidendis propeni e reluctantibus atque
					<lb xml:id="p1z13"/>contratientibus teartorio suo interdici et poentas, numuo
					<lb xml:id="p1z14"/>et miserabiles infligi prmitteret.
					<lb xml:id="p1z15"/>hoc dolendisim est, neminem neminem dinue
					<lb xml:id="p1z16"/>pre nostros theologos veritatem et eiosem postrimi
					<lb xml:id="p1z17"/>factantilus, quo vel verbo, qui re ipsa non possunt
					<lb xml:id="p1z18"/>
					<lb xml:id="p1z19"/>afflictis conscientias existis lagueis extacaret, iunare
					<lb xml:id="p1z20"/>a consolaretur, impietatem refutando territas ab
					<lb xml:id="p1z21"/>regu tranite, solutum honios, sed talibsus, ampestirm
					<lb xml:id="p1z22"/>speductos reducendo ob dei gltriam aliquid affitu,
					<lb xml:id="p1z23"/>Ehristiano ministrodigni prastaret et irerfenderet
					<lb xml:id="p1z24"/>plepaeque esse et ministros et auditores, qui intelligu
					<lb xml:id="p1z25"/>hosce articulos plane esse impios, sed in prouetu
					<lb xml:id="p1z26"/>non habere quod respondeant, igitur spientissimeovio
					<lb xml:id="p1z27"/>tacentibus plastoribus doctis, quibum esset constraticentes
					<lb xml:id="p1z28"/>non in vilo tantum loco, sed ubique terrarum ad pa
					<lb xml:id="p1z29"/>dectrinam coniingere, obmutessunt et adversariis
					<lb xml:id="p1z30"/>trimmphandim occasionem prebent,  ut crudeliuę
					<lb xml:id="p1z31"/>in persequendo instos pergant audaciores reddunt
					<lb xml:id="p1z32"/>in elis frissus vebi empete rerni aedatr anus,
