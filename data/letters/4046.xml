	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi, charissime frater, epistolam tuam una cum libro <lb xml:id="p1z2"/>catechistico mihi valde grato, pro quo tibi gratias ago <lb xml:id="p1z3"/>non habens, quod rependam, nisi quod oro dominum, <lb xml:id="p1z4"/>ut te diu nobis et ecclesię servet incolumem.</s>
					<s n="3" xml:lang="la">Quas <lb xml:id="p1z5"/><persName ref="p1010">Erbio</persName> inscriptas misisti, ego per civem <placeName ref="l2998">Keiserspergensem</placeName> <lb xml:id="p1z6"/>eisdem diebus ei transmisi.</s>
					<s n="4" xml:lang="la">De nostris illis Davidicis <lb xml:id="p1z7"/>deque tota actione lati in ipsos et archihereticum iudicii <lb xml:id="p1z8"/>expectabam tuam sententiam.</s>
					<s n="5" xml:lang="la">Sed tam odiosum fuit <lb xml:id="p1z9"/>negocium, ut non mirer non solum hereses ipsas, sed et reo<lb xml:id="p1z10"/>rum hypocritarum absolutionem damnari piis omnibus, <lb xml:id="p1z11"/>qui propius norunt, quę hactenus monstra aluerint <lb xml:id="p1z12"/>perversi homines.</s>
					<s n="6" xml:lang="la">Utinam ex animo resipiscant ac <lb xml:id="p1z13"/>ita parsum sit personis, ut secta simul sit extincta.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Rerum novarum quae scribam, habeo nihil; ipse enim, <lb xml:id="p1z15"/>quae mirabilia passim dominus designet, melius nosti.</s>
					<s n="8" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z16"/>vale.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l28">Basileę</placeName> 17. augusti 1559.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z17"/>Tuus <persName ref="p1754">Ioannes Iungius</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem erwürdigen und <lb xml:id="p2z2"/>gotsgeleerten herren m. <lb xml:id="p2z3"/><persName ref="p495">Heinrichen Bullinger</persName>, <lb xml:id="p2z4"/>getrüwen vorstender der <lb xml:id="p2z5"/>kirchen gottes zuͦ <placeName ref="l587">Zürich</placeName>, <lb xml:id="p2z6"/>minem günstigen herren <lb xml:id="p2z7"/>und vilgeliepten bruͦder.</s>
				</p>
			</div>
		</body>
	</text>
