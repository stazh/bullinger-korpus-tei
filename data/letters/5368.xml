	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Legi, quae senatus vester scribit.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Nostri rescribent <lb xml:id="p1z2"/>diligenter.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Valde autem miror, cum <placeName>Condensis</placeName> <lb xml:id="p1z3"/>opus habeat milite, quod nunquam a <placeName ref="l648">Rhaetis</placeName> petiit; <lb xml:id="p1z4"/>non dubito, quin impetraret.</s>
					<s n="5" xml:lang="la">Vides <persName ref="p8093">Herculem <lb xml:id="p1z5"/>a Salicibus</persName> se ipsum offerre.</s>
				</p>
				<p>
					<s n="6" xml:lang="de">Man muͦste von einem <lb xml:id="p1z6"/>yeden Pundt ein fändli 2 begären.</s>
					<s n="7" xml:lang="de">Wiewol <lb xml:id="p1z7"/>das kan ich nit verhalten: man besorget sich <lb xml:id="p1z8"/>ettwas entpörung im Etschland gegen dem <lb xml:id="p1z9"/><placeName ref="l638">Engadyn</placeName>; dan die regierung zuͦ <placeName ref="l232">Ynsbruck</placeName> <lb xml:id="p1z10"/>sich gantz trutzlich stelt.</s>
					<s n="8" xml:lang="de">Derha[l]ben yetz montag <lb xml:id="p1z11"/>herr <persName>Tscharner</persName>, herr zuͦ <placeName>Rozinß</placeName> und der landt<lb xml:id="p1z12"/>amman ab <placeName ref="l108">Davoß</placeName> verryten werdend zuͦ <lb xml:id="p1z13"/>dem römischen keiser, sich deren beschwärden <lb xml:id="p1z14"/>ze beklagen.</s>
					<s n="9" xml:lang="de">Ich hör, das der adel im <placeName>Etschland</placeName> <lb xml:id="p1z15"/>gern ettwas anhübe; so müssind sy ire <lb xml:id="p1z16"/>eigne puren entsitzen, die sonst unrüwig <lb xml:id="p1z17"/>sind.</s>
					<s n="10" xml:lang="la">Si scriberet <placeName>Condensis</placeName> (siquidem <lb xml:id="p1z18"/>militem peteret), ad <persName ref="p1770">G[regorium] Carlium</persName> et <persName>Herculem</persName> <lb xml:id="p1z19"/>privatim quoque erat scribendum, deinde in <lb xml:id="p1z20"/>commune ad <placeName>3 Foedera</placeName>.</s>
					<s n="11" xml:lang="la">Ad d. <persName ref="p629">Coignetium</persName> <lb xml:id="p1z21"/>consulto ian diu nihil scribo, ne literis <lb xml:id="p1z22"/>meis ei aliquod periculum creem.</s>
					<s n="12" xml:lang="la">Tu, quaeso, <lb xml:id="p1z23"/>si vestri legationem in <placeName ref="l832">Galliam</placeName> decreverint, <lb xml:id="p1z24"/>fac sciam, quo <persName ref="p8093">Herculem a Salicibus</persName> de <lb xml:id="p1z25"/>eo edoceam.</s>
					<s n="13" xml:lang="la">Misi proxime literas d. <persName ref="p2019">Augustini <lb xml:id="p1z26"/>Maynardi</persName> et spero tibi redditas.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale, <lb xml:id="p1z27"/>reverende in Christo pater, cum tuis omnibus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l98">Curię</placeName> 19. iunii anno <lb xml:id="p1z28"/>1562.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">T[uus] <persName ref="p8009">F[abricius</persName>].</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> antistiti vig<lb xml:id="p2z4"/>ilantissimo, d. et patri <lb xml:id="p2z5"/>suo in Christo reverendo.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zürych</placeName> an h. <persName ref="p495">Bullinger</persName>.</s>
				</p>
			</div>
		</body>
	</text>
