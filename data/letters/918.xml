	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Duo nostri iuvenes, <persName>Hylerus</persName> et <persName>Bumannus</persName>, <lb xml:id="p1z2"/>pessime apud vos se gesserunt; redeuntes ergo in carcerem <lb xml:id="p1z3"/>coniecti per octiduum sustentati sunt pulte <lb xml:id="p1z4"/>et aqua.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Dimissi acerrime sunt obiurgati a magistratu <lb xml:id="p1z5"/>et praefectis scholae, rursus tamen post castigationem <lb xml:id="p1z6"/>recepti in gratiam.</s>
					<s n="4" xml:lang="la">Metuimus, ne aere alieno se ag<lb xml:id="p1z7"/>gravarint nec creditorum nomina et summas bona fide <lb xml:id="p1z8"/>nobis significent.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Certe propter te et tuam intercessionem <lb xml:id="p1z9"/>vocavi ipsos, expostulavi cum eis; attoniti <lb xml:id="p1z10"/>vero responderunt se debere <persName>R. Berchtoldo</persName> et aliis <lb xml:id="p1z11"/>ac mature curaturos, ut persolvantur.</s>
					<s n="6" xml:lang="la">Ego mallem <lb xml:id="p1z12"/>te a creditoribus postulare schedas, quibus non tantum <lb xml:id="p1z13"/>summam debiti, sed rationes quoque, pro quibus <lb xml:id="p1z14"/>rebus singula sint expensa, colligeres easque <lb xml:id="p1z15"/>mihi mitteres; dispicerem enim diligenter, quid <lb xml:id="p1z16"/>rebus, alioqui dubiis fieret.</s>
					<s n="7" xml:lang="la">Non enim puto illos <lb xml:id="p1z17"/>bona fide, quantum debeant, significaturos; posses tu <lb xml:id="p1z18"/>illud nullo negotio conficere, si videlicet aedituus, <lb xml:id="p1z19"/>apud quem habitarunt, creditorum nomina <lb xml:id="p1z20"/>et singula debito colligat tibique credat.</s>
					<s n="8" xml:lang="la">Si mature <lb xml:id="p1z21"/>satis miseris, maturius agam, quod potero; <lb xml:id="p1z22"/>nihil alioqui polliceor certi.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Haec de illis.</s>
					<s n="10" xml:lang="la">Non <lb xml:id="p1z23"/>essem tibi alias occupatissimo rebus gravissimis one<lb xml:id="p1z24"/>rosus, nisi tu prior hac de re compellasses me ac <lb xml:id="p1z25"/>dolerem <placeName ref="l587">Tigurinos</placeName> accusari etc.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z26"/>Iam dudum sparsit fama pontificem duos cardinales <lb xml:id="p1z27"/>in <placeName ref="l862">Helvetiam</placeName> missuros; certi nihil habeo, non <lb xml:id="p1z28"/>tamen dubito antichristum omnia tentaturum, ut se<lb xml:id="p1z29"/>des in his terris amissas recuperet.</s>
					<s n="12" xml:lang="de">Was thuͦt <lb xml:id="p1z30"/>uwer thumbropst von <persName ref="p20918">Lumpenberg</persName>?</s>
					<s n="13" xml:lang="de">wenn wöllen<lb xml:id="p1z31"/>d ir inn installieren?</s>
					<s n="14" xml:lang="la">Hae scilicet artes sunt mem<lb xml:id="p1z32"/>brorum antichristi vos et nos vexare.</s>
					<s n="15" xml:lang="la">Vexant <lb xml:id="p1z33"/>nos singulariter <placeName ref="l2450">Suicii</placeName> et <placeName ref="l646">Glaronenses</placeName> propter castrum <lb xml:id="p1z34"/><placeName ref="l570">Wedenschwyl</placeName>, quod nostri emerunt legitime <lb xml:id="p1z35"/>et optimo iure.</s>
					<s n="16" xml:lang="de">Doch muͤssend min herren <lb xml:id="p1z36"/>morn zum raechten zuͦ den <placeName ref="l970">Eynsidlen</placeName>; der <lb xml:id="p1z37"/>h. <persName ref="p1419">Hab</persName> und m. <persName ref="p8123">Jörg Müller</persName> sind zuͦgsatzte, <persName ref="p3493">Cham</persName> <lb xml:id="p1z38"/>und <persName ref="p18762">Sproß</persName> radtgäben, <persName ref="p8339">Aescher</persName> stattschryber redner, <persName ref="p6194">Reynhart</persName> schryber.</s>
					<s n="17" xml:lang="la" ana="farewell"><lb xml:id="p1z39"/>Vale aeternum; plura non <lb xml:id="p1z40"/>possum.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z41"/>Ultima mai<lb xml:id="p1z42"/>i <lb xml:id="p1z43"/>1550.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z44"/><persName ref="p495">Bullinger</persName>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p8418">Osvaldo My<lb xml:id="p2z2"/>conio</persName>, venerando <lb xml:id="p2z3"/>suo fratri.</s>
				</p>
				<p>
					<s n="21" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
