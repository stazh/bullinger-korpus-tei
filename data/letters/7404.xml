	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>intellexissem quendam tabellarium
					<lb xml:id="p1z2"/>ad vos rediturum volui ei has breves
					<lb xml:id="p1z3"/>te dare; Nihil enim fere habeo, quod ad
					<lb xml:id="p1z4"/>te scribam, cum ex Galliis nihil adferatur
					<lb xml:id="p1z5"/>quae tamen satis maternarum scribendi
					<lb xml:id="p1z6"/>intanta civili confusione suppeditar
					<lb xml:id="p1z7"/>possunt. Erumpent brevi maiori
					<lb xml:id="p1z8"/>duorum regum conspirationes, qui ante
					<lb xml:id="p1z9"/>paicos omnes capitales hostes, nunc in
					<lb xml:id="p1z10"/>opprimendo Christo amicissimi facti. Qubi
					<lb xml:id="p1z11"/>accedent multae nefariae et sceleratae
					<lb xml:id="p1z12"/>proditiones eorum, qui evangelicissimi
					<lb xml:id="p1z13"/>rsipoderi volunt; sed proderit ecclesiae
					<lb xml:id="p1z14"/>Christi haec hurcorum ab hoedis separeatio. Dominu
					<lb xml:id="p1z15"/>potest, mi Bullingere, quanto dolori
					<lb xml:id="p1z16"/>affitiar falsorum fratrum perfidia et munmr
					<lb xml:id="p1z17"/>quibus papistis minime redunt
					<lb xml:id="p1z18"/>Ego me ea spe sustentor, quod certo sciam
					<lb xml:id="p1z19"/>dominum suis electis non defuturmm confi
					<lb xml:id="p1z20"/>adversarii humanae potentiae nec
					<lb xml:id="p1z21"/>ope celestem implorant, qua ut suripsus
					<lb xml:id="p1z22"/>frax despitunt ac persequuntur, quae tamen
					<lb xml:id="p1z23"/>victrm evadet. Caerte sanguis a Carolo 5.
					<lb xml:id="p1z24"/>Francisco et Henrico innocenter effusus nondum
					<lb xml:id="p1z25"/>cessat clamare vindicta. Es mußs geror
					<lb xml:id="p1z26"/>in praefractis posteris. Bene vale
					<lb xml:id="p1z27"/>et Gvalthero, Simlero, Lavatero, Polphio
					<lb xml:id="p1z28"/>ac reliquis amicis meo nomine salute
					<lb xml:id="p1z29"/>ics 2. martii anno ec.8.
					<lb xml:id="p1z30"/>T mis toto
					<lb xml:id="p1z31"/>velerus.
					<pb/>
					<lb xml:id="p2z1"/>Reverendo viro Henrico Bullingero,
					<lb xml:id="p2z2"/>ecclesiae Tigurinae antistiti
					<lb xml:id="p2z3"/>fidelissimo, amico suo syncero
					<lb xml:id="p2z4"/>amore colendo.
					<lb xml:id="p2z5"/>Zurich.
				</p>
