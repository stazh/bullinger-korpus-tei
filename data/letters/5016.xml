	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Gratias ago tibi pro novis illis e <placeName ref="l832">Gallia</placeName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Audiens <lb xml:id="p1z2"/>confessionis <placeName ref="l18">Augustanę</placeName> factam mentionem videbo, ut caute <lb xml:id="p1z3"/>agam, ne arripiant id miseri ad perturbandum negocium.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Interim agnosco nihil temere aut fortuito factum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Dominus pro sua eterna sapientia dirigat omnia ad bonum finem.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/>Descripsi raptim scriptum hoc, et quia nuncius properat, tibi <lb xml:id="p1z7"/>remitto.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Nunc nihil est novi apud nos.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z8"/>7. octobris 1561.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z9"/><persName ref="p1754">Iunius</persName> tuus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio viro domino <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinorum</placeName> antistiti <lb xml:id="p2z4"/>syncerissimo, fratri <lb xml:id="p2z5"/>suo observandissimo.</s>
				</p>
			</div>
		</body>
	</text>
