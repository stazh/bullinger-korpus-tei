	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quamvis non sperem aliquid me <lb xml:id="p1z2"/>hoc scripto efficere, compater in domino <lb xml:id="p1z3"/>charissime, nolui tamen hoc tantillum <lb xml:id="p1z4"/>laboris petitioni tuę negare.</s>
					<s n="3" xml:lang="la">Mitto <lb xml:id="p1z5"/>igitur rudem et inelaboratam quaesti<lb xml:id="p1z6"/>onis propositę tractationem, non ut, <lb xml:id="p1z7"/>qualis est, aedatur, sed ut abs te <lb xml:id="p1z8"/>refingatur et ad scopum destinatum <lb xml:id="p1z9"/>accommodetur.</s>
					<s n="4" xml:lang="la">Mihi non sunt vestrę <lb xml:id="p1z10"/>gentis mores noti, quare non <lb xml:id="p1z11"/>possum praestare cum efficacia, quod <lb xml:id="p1z12"/>volebas.</s>
					<s n="5" xml:lang="la">Tuum erit, quod deesse vi<lb xml:id="p1z13"/>debitur, adiicere et, si quid est <lb xml:id="p1z14"/>impertinenter aut superflue, nedum <lb xml:id="p1z15"/>periculose dictum, vel tollere vel <lb xml:id="p1z16"/>corrigere.</s>
					<s n="6" xml:lang="la">Non licet plura <lb xml:id="p1z17"/>in praesenti.</s>
					<s n="7" xml:lang="la">Bene valemus domi meę <lb xml:id="p1z18"/>per gratiam domini; eandem sortem optamus <lb xml:id="p1z19"/>tibi quoque et tuis omnibus.</s>
					<s n="8" xml:lang="la" ana="farewell">Optime <lb xml:id="p1z20"/>vale, compater charissime.</s>
					<s n="9" xml:lang="la" ana="salute">Salutem toti <lb xml:id="p1z21"/>domui tuę et fratribus omnibus, <lb xml:id="p1z22"/>d. <persName ref="p8127">Pelli[cano]</persName>, d. <persName ref="p8171">Bibliandro</persName>, domino <persName ref="p8011">Gval<lb xml:id="p1z23"/>thero</persName> et d. <persName ref="p506">Butlero</persName>.</s>
					<s n="10" xml:lang="de"><placeName ref="l41">Bernę</placeName> 1551. <lb xml:id="p1z24"/>23. decembris.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z25"/><persName ref="p8417">W[olfgangus] Musc[ulus]</persName>, compater tuus <lb xml:id="p1z26"/>in domino.</s>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo m. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho Bul<lb xml:id="p2z4"/>lingero</persName>, com<lb xml:id="p2z5"/>patri in domino <lb xml:id="p2z6"/>charissimo.</s>
				</p>
