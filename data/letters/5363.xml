	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Quod a me per literas et a d. <persName>Wrotho</persName> <lb xml:id="p1z2"/>dudum petebas, clarissime d. <persName ref="p495">Bullynger</persName>e, <lb xml:id="p1z3"/>ut hic iuvenis in aula reginye nostrę <lb xml:id="p1z4"/>locum aliquem honestum haberet, id a <lb xml:id="p1z5"/>nobis sedulo curatum est, si minus ex <lb xml:id="p1z6"/>eius animi sententia, saltem ut res <lb xml:id="p1z7"/>et nostra tempora tulerunt.</s>
					<s n="2" xml:lang="la">Nunc quum <lb xml:id="p1z8"/>illum patrię desiderium revocat, hęc <lb xml:id="p1z9"/>ad te pauca scribere fuit consilium, <lb xml:id="p1z10"/>ut intelligas et persuasum habeas, nullam <lb xml:id="p1z11"/>neque temporis diuturnitatem neque locorum <lb xml:id="p1z12"/>longinquitatem meum erga te <lb xml:id="p1z13"/>studium, officium, observantiam immi<lb xml:id="p1z14"/>nuere, nedum expungere aut delere <lb xml:id="p1z15"/>posse.</s>
				</p>
				<p>
					<s n="3" xml:lang="la" ana="salute">D. <persName ref="p8111">Petrum Martyrem</persName>, d. <lb xml:id="p1z16"/><persName ref="p2336">Bernardinum</persName> et d. <persName ref="p8011">Gvalterum</persName>, quos <lb xml:id="p1z17"/>honoris causa nomino, quęso meis <lb xml:id="p1z18"/>verbis plurimum salutes.</s>
					<s n="4" xml:lang="la">Dominus <lb xml:id="p1z19"/>noster Iesus Christus vos gregi suo quam d<lb xml:id="p1z20"/>iutissime s<lb xml:id="p1z21"/>alvos et superstites esse velit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z22"/><placeName ref="l296">Londini</placeName>, 14 iunii, 1562.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z23"/>Tuę pietatis studiosiss., <lb xml:id="p1z24"/><persName ref="p663">Antonius Cookus</persName>.</s>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo doctissimo<lb xml:id="p4z2"/>que viro, d. <lb xml:id="p4z3"/><persName ref="p495">Henrycho Bullingero</persName>, <lb xml:id="p4z4"/><placeName ref="l587">Tigurinę</placeName> <lb xml:id="p4z5"/>ecclesię antistiti <lb xml:id="p4z6"/>plurimum observando.</s>
					<s n="8" xml:lang="la"><lb xml:id="p4z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
