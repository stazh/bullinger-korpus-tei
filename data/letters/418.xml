	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Mirum, quod ad ternas aut quinas, si bene me<lb xml:id="p1z2"/>mini, nihil rescribas nec orationem contra Interim mittas.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Episcopus noster<note xml:id="fn1" type="footnote" n="1"><persName ref="p18295">Philipp von Gundelsheim</persName>.</note> die 21. ianuarii misit legationem honestam ad <lb xml:id="p1z4"/>nos, quę senatum voluit persu[a]dere, quod Interim reciperet.</s>
					<s n="4" xml:lang="de"><lb xml:id="p1z5"/>Er hat gesendet den hoffmeyster, <persName>Sigelman</persName> genant, ein edelman, <lb xml:id="p1z6"/>den cantzler, den official; dise haben sich entschuldiget, das sy <lb xml:id="p1z7"/>muͤssen ein sölichen furtrag thuͦn, den sy wussen, nit angenem <lb xml:id="p1z8"/>sin; ouch haben sy den bischoff entschulget, wie er getrungen <lb xml:id="p1z9"/>werde durch <persName ref="p18538">keserliche m[ajestat]</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p18538">Karl V.</persName></note>, dises zuͦ exequieren.</s>
					<s n="5" xml:lang="la">Auditi sunt <lb xml:id="p1z10"/>astuti homines ac dimissi sine responso; <placeName>Milhusum</placeName> petierunt, <lb xml:id="p1z11"/>in quo etiam nihil effecerunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Veniet legatus<note xml:id="fn3" type="footnote" n="3">............</note> episcopi <placeName ref="l257">Constantiensis</placeName><note xml:id="fn4" type="footnote" n="4"><persName ref="p7852">Johann von Weeze</persName>.</note> <lb xml:id="p1z12"/>in civitatem <placeName ref="l41">Pernam</placeName><note xml:id="fn5" type="footnote" n="5"><placeName ref="l41">Bern</placeName>.</note> suum officium acturus de restituendis <lb xml:id="p1z13"/>omnibus, quę olim habuere.</s>
					<s n="7" xml:lang="la">Audimus et <placeName ref="l587">Tiguri</placeName> fuisse legatum <lb xml:id="p1z14"/>aut illuc venturum.</s>
					<s n="8" xml:lang="la">Hic apparet, quid <placeName>Septempagici</placeName> instituant.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>Legatio <persName ref="p18536">ducis Sabaudię</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p18536">Karl III.</persName></note> cras erit apud senatum; non dubium, quin <lb xml:id="p1z16"/>repetituri sint agrum amissum<note xml:id="fn7" type="footnote" n="7"><placeName ref="l788">Waadt</placeName>.</note> et <placeName ref="l167">Genevates</placeName> contumeliosis verbis <lb xml:id="p1z17"/>adficient aut conantur nostros irritare contra <placeName ref="l41">Bernates</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Sulcerus partem electus in pastorem templi <persName>Petrini</persName>, partim <lb xml:id="p1z19"/>se cupit insinuare; cogitur servire, quod libenter <lb xml:id="p1z20"/>faciet, ad anni spacium gratis; pro Lupo concionabitur diebus <lb xml:id="p1z21"/>dominicis.</s>
					<s n="11" xml:lang="la">Quum autem annus elapsus fuerit, tum eligetur ab <lb xml:id="p1z22"/>omnibus, si eis placuerit.</s>
					<s n="12" xml:lang="la">Nonne hoc est beneficia ecclesias <lb xml:id="p1z23"/>vendere, paleas dare aliis et servare triticum?</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z24"/>et rescribe.</s>
					<s n="14" xml:lang="la">26. ianuarii 1549.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Salutabis <lb xml:id="p1z25"/><persName ref="p8171">Theodorum</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p8171">Theodor Bibliander</persName>.</note>, <persName ref="p8127">Pellicanum</persName>, <persName ref="p8011">Rodolphum</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p8011">Rudolf Gwalther</persName>.</note> cum <persName ref="p8417">Musculo</persName> nostro, cui mitto <lb xml:id="p1z28"/>has literas ab <placeName ref="l491">Argentina</placeName> <lb xml:id="p1z29"/>ad me missas.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z30"/>T[uus] <persName ref="p1278">Gasti<lb xml:id="p1z31"/>us</persName> ex animo.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="17" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem erwurdigen <lb xml:id="p2z2"/>und wolgelerten herren <lb xml:id="p2z3"/>Meyster <persName ref="p495">Heinrychen <lb xml:id="p2z4"/>Bullinger</persName>, pfarrherren <lb xml:id="p2z5"/>zuͦ <placeName ref="l587">Zurich</placeName>, mynem <lb xml:id="p2z6"/>lieben günstigen <lb xml:id="p2z7"/>herren.</s>
					<s n="18" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
