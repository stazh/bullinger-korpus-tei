	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Imprudenter facere iuditio meo viderer, si <persName ref="p505">Ioannem Burcherum</persName> <lb xml:id="p1z3"/>tibi commendarem, quocum tibi iam, ut puto, non modo vetus, sed <lb xml:id="p1z4"/>etiam arcta amicitia intercedit.</s>
					<s n="3" xml:lang="la">Quia vero multa me ab <lb xml:id="p1z5"/>eodem humanitatis offitia accepisse fateor, non oro, ut <lb xml:id="p1z6"/>ei adsis, quod hoc tua sponte sis facturus, sed, ut adesse <lb xml:id="p1z7"/>ei possis, demonstrabo.</s>
					<s n="4" xml:lang="la">Nosti, quam artem <persName ref="p4082">Conradus Zviccius</persName> <lb xml:id="p1z8"/>habeat de parcendis lignis in coquendo ac calefaciendo c<lb xml:id="p1z9"/>onclavi.</s>
					<s n="5" xml:lang="la">Ad eam promulgandam pluribus opus habet hominibus.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Cum autem <persName ref="p505">Burcherus</persName> noster homo sit in multis <lb xml:id="p1z11"/>rebus versatus, prudens atque sollers quique Latinam linguam <lb xml:id="p1z12"/>non intelligit modo, sed probe loquitur, puto illum <persName ref="p4082">Zviccio</persName> nostro <lb xml:id="p1z13"/>ea in re fore utilem, si a te illi commendetur, nec credo <lb xml:id="p1z14"/><persName ref="p4082">Zviccium</persName> tuam commendationem parvi facturum esse.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Velim autem, ut me mentionem nullam apud eum facias, <lb xml:id="p1z16"/>quoniam is mea opera iam fere annum ea in re <lb xml:id="p1z17"/>usus est ac deinceps etiam utetur, ne quid de me <lb xml:id="p1z18"/>sinistre suspicetur, quae res <persName ref="p505">Burchero</persName> potius fraudi <lb xml:id="p1z19"/>quam emolumento esset.</s>
					<s n="8" xml:lang="la">Videtur mihi hęc omnino via <lb xml:id="p1z20"/>esse, qua <persName ref="p505">Burcherum</persName> iterum iuvemus, quod ego <lb xml:id="p1z21"/>ex animo cupio.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z22"/>Vestris confoederatis nolite plus fidere, quam par est; <lb xml:id="p1z23"/><placeName ref="l425">Romę</placeName> enim auxilium pontificis contra vos implora[ru]<lb xml:id="p1z24"/>nt, tametsi illud cardinalis quidam dissuasit.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/><placeName ref="l491">Argentorati</placeName> 24. septembris 1556.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z26"/>Tuus ex animo <persName ref="p8450">Toxites</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Et virtute et pietate ac doctrina <lb xml:id="p2z2"/>praestanti viro d. <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, amico suo observando.</s>
