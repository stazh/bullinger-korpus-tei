	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literas tuas <placeName ref="l269">Küngßfeldensis</placeName> oeconomus ad me <lb xml:id="p1z2"/>misit, optime et charissime domine compater, ex <lb xml:id="p1z3"/>quibus cum magno dolore obitum charissimarum <lb xml:id="p1z4"/>tuarum filiarum, <persName ref="p7228">Zvinglię</persName> et <persName ref="p8442">Simlerae</persName>, cognovi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Quo nuncio vulnus, quod ex obitu filię meae <lb xml:id="p1z6"/>charissimae <persName ref="p20670">Elizabethae</persName> acceperam et quod iam <lb xml:id="p1z7"/>mitescere incipiebat, mihi prorsus recruduit iterum, <lb xml:id="p1z8"/>praesertim cum in memoriam revocarem <persName ref="p20670">Elizabethae</persName> <lb xml:id="p1z9"/>meae verba, quibus adeo frequenter et ad extremum <lb xml:id="p1z10"/>fere usque tuam illam <persName ref="p6609">Elizabetham</persName>, commatricem sive <lb xml:id="p1z11"/>susceptricem<note xml:id="fn1" type="footnote" n="1">Taufpatin.</note> suam, ingeminabat ipsam perpetuo <lb xml:id="p1z12"/>sonans, et cum a me ipsam aegrotare intellexisset, <lb xml:id="p1z13"/>praedicebat illam iam mortuam esse et se ad illam <lb xml:id="p1z14"/>migrare, adeo ut coniunctionem illam spirituum <lb xml:id="p1z15"/>admirer nec dubitem, quin una gaudeant <lb xml:id="p1z16"/>nunc coram coelesti patre.</s>
					<s n="4" xml:lang="la">Tibi vero et omnibus <lb xml:id="p1z17"/>vobis ex animo condoleo, quod illarum solatio in <lb xml:id="p1z18"/>praesenti orbati sitis, sicut et vos quoque meae sorti <lb xml:id="p1z19"/>in hac parte condolere scio.</s>
					<s n="5" xml:lang="la">Cum tamen sciamus, <lb xml:id="p1z20"/>quo migraverint et quam certo nos illas secuturi <lb xml:id="p1z21"/>simus, est quod domino gratias agamus et ipsius voluntati <lb xml:id="p1z22"/>nos patienter subiiciamus et nos quoque ad <lb xml:id="p1z23"/>hanc profectionem (quę utinam in Christo Iesu foelix <lb xml:id="p1z24"/>ac fausta nobis contingat!) paremus.</s>
					<s n="6" xml:lang="la">Me valde <lb xml:id="p1z25"/>solatur tuum exemplum; si enim tibi dominus hoc <lb xml:id="p1z26"/>imposuit, quis ego sum, ut conquererer?</s>
					<s n="7" xml:lang="la">Dominus soletur <lb xml:id="p1z27"/>et servet utrumque.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Ceterum literas, quas <placeName ref="l167">Genevam</placeName> <lb xml:id="p1z28"/>mittebas, <persName>Blasio</persName> meo <placeName ref="l280">Lausannam</placeName> transmisi; ipse <lb xml:id="p1z29"/>eas diligenter curabit.</s>
					<s n="9" xml:lang="la">Quod ad pestem, remisit <lb xml:id="p1z30"/>illa multum a 14 iam diebus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Decumbit adhuc <lb xml:id="p1z31"/><persName ref="p20956">Stephanus</persName> senioris <persName ref="p7879">Wittenbachii</persName> filius; sed videtur <lb xml:id="p1z32"/>omne periculum superasse iam per domini gratiam; is illum <lb xml:id="p1z33"/>prorsus erigat.</s>
					<s n="11" xml:lang="la">Ex domini <persName ref="p8063">Steigeri</persName> literis intellexisti <lb xml:id="p1z34"/>Sabaudicum negotium omne, ut non opus mihi sit <lb xml:id="p1z35"/>illud repetere.</s>
					<s n="12" xml:lang="la">Vereor, ne pro uno hoste tandem <lb xml:id="p1z36"/>plures simus habituri; atque utinam non incentores <lb xml:id="p1z37"/>harum rerum sint, qui pro mediatoribus hactenus <lb xml:id="p1z38"/>habiti sunt!</s>
					<s n="13" xml:lang="la">Fortassis illud utilius est ecclesiis; novit <lb xml:id="p1z39"/>hoc dominus; is nos servet!</s>
					<s n="14" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Salutem <lb xml:id="p1z40"/>dic tuis omnibus, praesertim d. <persName ref="p8442">Simlero</persName> et d. <persName ref="p7228">Zvinglio</persName>, <lb xml:id="p1z41"/>quibus quantum condoleam in tanto moerore <lb xml:id="p1z42"/>constitutis, significato.</s>
					<s n="16" xml:lang="la" ana="salute">Salutant te d. consul <persName ref="p8063">Steigerus</persName>, <lb xml:id="p1z43"/><persName ref="p7449">Diesbachius</persName>, <persName>Amadiensis</persName>, socer, <persName ref="p8416">Musculus</persName> <lb xml:id="p1z44"/>et alii.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l41">Bernae</placeName> 13. decembris 1565.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z45"/><persName ref="p8018">Johannes Hallerus</persName> semper <lb xml:id="p1z46"/>et ex animo tuus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo doctissimoque viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori <lb xml:id="p2z4"/>fidelissimo, domino meo et <lb xml:id="p2z5"/>compatri perpetua obser<lb xml:id="p2z6"/>vantia colendo.</s>
				</p>
			</div>
