			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hodie postremos <persName ref="p1227">Froschouerus</persName> attulit <lb xml:id="p1z2"/>terniones hodie iterum discessurus.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Tumu<lb xml:id="p1z3"/>ltuarie ergo in indicem ex istis congessi, quę <lb xml:id="p1z4"/>videbantur praecipua; perpetuo enim in <lb xml:id="p1z5"/>reliquis quoque me ursit, ut brevis essem.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>In locorum scripturae explicatorum indice <lb xml:id="p1z7"/>non habeo multa ex parte, quę Latinum <lb xml:id="p1z8"/>habet exemplar; nolui enim annotare simpliciter <lb xml:id="p1z9"/>citatos locos, sed praecipuos duntaxat, qui <lb xml:id="p1z10"/>coniunctam haberent explicationem.</s>
					<s n="5" xml:lang="la">Tu boni, <lb xml:id="p1z11"/>oro, consulas istum laborem.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Caeterum <lb xml:id="p1z12"/>pro nummo uxori meę misso magnas <lb xml:id="p1z13"/>ago tibi gratias; agit itidem illa summas.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Non opus erat denuo mittere aliquid <lb xml:id="p1z15"/>priore amisso.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">De <placeName ref="l830">Anglo</placeName> isto nihildum <lb xml:id="p1z16"/>comperi.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><persName ref="p8033">Beza</persName> hinc discedens apud <lb xml:id="p1z17"/>alium quendam reliquit hunc librum, <lb xml:id="p1z18"/>quem oravit ut mihi traderet ad te <lb xml:id="p1z19"/>mittendum, simulque per illum rogavit, te ut <lb xml:id="p1z20"/>orarem, ne aegre feras, quod nihil nunc <lb xml:id="p1z21"/>ad te scripserit.</s>
					<s n="10" xml:lang="la">Novi interea nihil allatum est<lb xml:id="p1z22"/>, nisi quod <placeName ref="l862">Helvetii</placeName> nostri ex <placeName ref="l808">Belgico</placeName> <lb xml:id="p1z23"/>redeant, si qui supersint, miseri illi et morbis <lb xml:id="p1z24"/>plane confecti.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Expectamus, quid <placeName ref="l157">Fran<lb xml:id="p1z25"/>cofurdensis</placeName> conventus pariturus sit.</s>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z26"/>Bene vale.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Salutem dic uxori et liberis <lb xml:id="p1z27"/>omnibus meo uxorisque meae nomine; <lb xml:id="p1z28"/><persName ref="p8417">Musculus</persName> vos quoque salutat cum suis.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z29"/>5. martii 1558.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z30"/><persName ref="p8018">Hall[erus]</persName> tuus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, domino <lb xml:id="p2z4"/>et compatri suo summe <lb xml:id="p2z5"/>colendo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>