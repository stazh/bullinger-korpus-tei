	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Habes hic alterum et non minus fidelem nuncium, vicinum meum<note xml:id="fn1" type="footnote" n="1">Unbekannt.</note>, charissime <persName ref="p495">Heinrice</persName>, cui tutissime <lb xml:id="p1z2"/>credere poteris evangelistarium<note xml:id="fn2" type="footnote" n="2">Es handelt sich um <persName ref="p495">Bullingers</persName> Scholien zu den vier Evangelien. Vor allem um jene zum Johannesevangelium hatte <persName ref="p1391">Haller</persName> früher schon wiederholt gebeten (s. oben <ref target="file10230">[Nr. 199]</ref> S. 85, Anm. 25 und 140, Anm. 2).</note> tuum.</s>
					<s n="3" xml:lang="la">Quod si <persName ref="p8412">Megandro</persName> non commiseris<note xml:id="fn3" type="footnote" n="3">Vgl. oben S. 140, 4-6.</note>, fac is eo vacuus non redeat.</s>
					<s n="4" xml:lang="la">Interim et <lb xml:id="p1z3"/>te quoque expectabo<note xml:id="fn4" type="footnote" n="4">Vgl. oben S. 140,14-18 u. ö.</note>, et utinam vita non intercipiatur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Periit his diebus apoplexia <persName ref="p5261">Sebastianus Oeconomus</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p5261">Sebastian Hofmeister</persName>. - Als Todestag <persName ref="p5261">Hofmeisters</persName> kommt aller Wahrscheinlichkeit nach der 9. Juni 1533 in Frage, s. Hans <hi>Lieb,</hi> Sebastian Hofmeisters Geburtsjahr und Todestag, in: Schaffhauser Beiträge zur Geschichte, Bd. 57, 1980, S. 146-148.</note>, <placeName ref="l582">Zofingensis</placeName><note xml:id="fn6" type="footnote" n="6"><placeName ref="l582">Zofingen</placeName> (<placeName ref="l594">Kt. Aargau</placeName>).</note> <lb xml:id="p1z4"/>ecclesię minister, quo doctiorem <placeName ref="l41">Berna</placeName> meo iudicio non habuit, tametsi suos subinde et defectus et affectus <lb xml:id="p1z5"/>passus sit.</s>
					<s n="6" xml:lang="la">Reliquit liberos quattuor, uxorem<note xml:id="fn7" type="footnote" n="7">Unbekannt, s. <hi>Wipf</hi> 145.</note> et, ut aiunt, debita multa, quod nimirum pessime nostrum offendet <lb xml:id="p1z6"/>senatum.</s>
					<s n="7" xml:lang="de">Es ist ein sundere plag, daß unser vil so übel könnend und wellend hußhan<note xml:id="fn8" type="footnote" ana="lex" n="8">haushalten.</note>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Aliud nihil habeo <lb xml:id="p1z7"/>quod scribam.</s>
					<s n="9" xml:lang="la">Nunc tuas expecto.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">12. iunii anno 33.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z8"/>Tuus semper <persName ref="p1391">Bertol. Hallerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="13" xml:lang="de"><pb/><lb xml:id="p2z1"/>An Meister <persName ref="p495">Heinrich <lb xml:id="p2z2"/>Bullinger</persName>, predicanten <lb xml:id="p2z3"/>ze <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
