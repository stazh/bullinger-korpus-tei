	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime atque idem charissime mi <persName ref="p495">Bullinger</persName>i.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Mitto nunc proprium nuncium nec putavi exi<lb xml:id="p1z3"/>guo huic sumptui parcendum, ut iuvaremus <lb xml:id="p1z4"/>exulem Iesu Christi, <persName ref="p974">Molineum</persName> tuum, non ingnare <lb xml:id="p1z5"/>mali miseris succurrere disco.</s>
					<s n="3" xml:lang="la">Res sic <lb xml:id="p1z6"/>se habet.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Quum abesset d. comes, sumpsi ego <lb xml:id="p1z7"/>agendam causam hominis apud ducem; <lb xml:id="p1z8"/>egi, quin et tua usus sum autoritate; nam <lb xml:id="p1z9"/>dixi te mihi <persName ref="p974">Molineum</persName> commendasse.</s>
					<s n="5" xml:lang="la">Beni<lb xml:id="p1z10"/>gne dux respondit; sed heri misit ad <lb xml:id="p1z11"/>me epistolam, quam nuper ab ipso exule <lb xml:id="p1z12"/>acceperat, qui nempe id petebat, <lb xml:id="p1z13"/>quod iam ego pro eo petieram, et mandavit <lb xml:id="p1z14"/>mihi<lb xml:id="p1z15"/>, ut significem illi, <placeName ref="l512">Tubingam</placeName> ut <lb xml:id="p1z16"/>veniat et videret, si civitatula placeat, <lb xml:id="p1z17"/>si viri, si reliqua; nam si placeret s<lb xml:id="p1z18"/>e<note type="margin">a.R.: gestrichen?</note> illi conditionem offerre, ut hic proffiteretu<lb xml:id="p1z19"/>r ius civile.</s>
					<s n="6" xml:lang="la">Ita itaque mihi manda<lb xml:id="p1z20"/>vit princeps.</s>
					<s n="7" xml:lang="la">Nunc ego, ni ipsum vid<lb xml:id="p1z21"/>ear parvifacere et oblatum beneficium, <lb xml:id="p1z22"/>putavi omnia ad te esse scribenda, ad te, <lb xml:id="p1z23"/>inquam, cuius auspiciis res coepta est agi, <lb xml:id="p1z24"/>ut tu fratrem illum nostrum moneas de <lb xml:id="p1z25"/>voluntate ducis.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Certe nimium differebamus, <lb xml:id="p1z26"/>si nullum nuncium misissem et voluissem <lb xml:id="p1z27"/>egomet tibi haec nunciare coram.</s>
					<s n="9" xml:lang="la">Scio <pb/><lb xml:id="p2z1"/>exules solere sollicitos atque anxios esse, dum ex<lb xml:id="p2z2"/>pectant, in quem portum sint navigaturi; ideo, <lb xml:id="p2z3"/>inquam, sumptui nollui parcere ob gloriam domini.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z4"/>Interim scias, velim, me ad <persName ref="p19001">Lactantium</persName> meum <lb xml:id="p2z5"/>illum <placeName ref="l167">Genevam</placeName> scripsisse, ut Molineum mon<lb xml:id="p2z6"/>eat nos causam eius agere; sed tu nichilo<lb xml:id="p2z7"/>minus omnia ordine ad ipsum exarabis.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z8"/>Dux multa mecum de <placeName ref="l587">Tigurinis</placeName> past[oribus]; sed ea in meum <lb xml:id="p2z9"/>adventum reservo, quem spero fore futurum <lb xml:id="p2z10"/>ad 15 usque dies.</s>
					<s n="12" xml:lang="la">Verto duos libellos principis <lb xml:id="p2z11"/>iussu.</s>
					<s n="13" xml:lang="la">Dux <persName ref="p18250">Mauritius</persName> et <placeName ref="l1041">Brunsvicensis</placeName> <lb xml:id="p2z12"/>mittunt subsidio episcopis 5 m peditum et longe <lb xml:id="p2z13"/>plures equites; res est certa.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z14"/>Oro te, frater, quaere diligenter apud hospitem <lb xml:id="p2z15"/><persName>Ciconiae</persName> et apud <persName>Zieglerum</persName>, num forte <lb xml:id="p2z16"/>ullę essent literę, quae ad me pertinerent, <lb xml:id="p2z17"/>et eas da huic nuncio ferendas ad me, <lb xml:id="p2z18"/>quin, si <persName>Aurelius</persName> forte <placeName ref="l587">Tigurum</placeName> venisset, <lb xml:id="p2z19"/>iube eum cum nuncio hoc ad me venire, <lb xml:id="p2z20"/>quamquam parum spero; nam si <lb xml:id="p2z21"/>sperarem, mitterem equum pro eo.</s>
					<s n="15" xml:lang="la">Sed si <lb xml:id="p2z22"/>forte, inquam, advenisset, huc ad me se recipiat <lb xml:id="p2z23"/>nunc cum ipso nuncio, si velit, aut si nolit, <lb xml:id="p2z24"/>abeat, quo illi libitum fuerit.</s>
					<s n="16" xml:lang="la" ana="salute">Praeterea te <lb xml:id="p2z25"/>oro, ut has, quas hic addam, <placeName ref="l98">Curiam</placeName> <lb xml:id="p2z26"/>mittas; da hospiti <persName>Ciconiae</persName> e<lb xml:id="p2z27"/>t <lb xml:id="p2z28"/>diligenter commenda.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z29"/>Ducatum <pb/><lb xml:id="p3z1"/><placeName ref="l2530">Lus<lb xml:id="p3z2"/>itanum</placeName>, <lb xml:id="p3z3"/>quem in literis hisce invenies, mitte <placeName ref="l28">Basileam</placeName> <lb xml:id="p3z4"/>ad <persName>Iacobum Parcum</persName> cum libello, quem etiam <lb xml:id="p3z5"/>hic adiungam, at primo quoque tempore<lb xml:id="p3z6"/>, at per fidum aliquem virum.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p3z7"/>Iter hoc fuit omnino in nomine domini susceptum <lb xml:id="p3z8"/>et benedictum ab eo; ita video multa <lb xml:id="p3z9"/>foeliciter cadere; illi laus et gloria in <lb xml:id="p3z10"/>saecula saeculorum, qui suos non deserit; fide<lb xml:id="p3z11"/>lis <lb xml:id="p3z12"/>enim est.</s>
					<s n="19" xml:lang="la">Iosias meus bene habet; pro<lb xml:id="p3z13"/>dest illi mirum in modum praxis haec <lb xml:id="p3z14"/>et se rebus ferendis probe accomodat.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Iam <lb xml:id="p3z15"/>finem facio.</s>
					<s n="21" xml:lang="la">Tu ad nos de rebus omnibus <lb xml:id="p3z16"/>diligenter.</s>
					<s n="22" xml:lang="la" ana="salute">Salutat te <persName ref="p8113">Wolmarius</persName>, hos<lb xml:id="p3z17"/>pes noster, certe vir eximius.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="salute">Salvere <lb xml:id="p3z18"/>iubeo totam familiam, totam scholam, <lb xml:id="p3z19"/>totam ecclesiam.</s>
					<s n="24" xml:lang="la">D. Iesus benedicat <lb xml:id="p3z20"/>tuis laboribus.</s>
					<s n="25" xml:lang="la">Fiat, fiat.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><placeName ref="l512">Tubingae</placeName> <lb xml:id="p3z21"/>4. iunii 1553.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p3z22"/><persName ref="p3375">Vergerius</persName><lb xml:id="p3z23"/>.</s>
				</p>
				<p>
					<note>[Von anderer Hand:]</note>
					<s n="28" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro domino <persName ref="p495">Heinricho <lb xml:id="p4z2"/>Bullingero</persName>.</s>
					<s n="29" xml:lang="de"><lb xml:id="p4z5"/><placeName ref="l587">Z<lb xml:id="p4z6"/>ür<lb xml:id="p4z7"/>ich</placeName>.</s>
				</p>
			</div>
