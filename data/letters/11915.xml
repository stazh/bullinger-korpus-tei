	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S[alutem] d[ico].</s>
					<s n="2" xml:lang="la">Accipe hic, <persName ref="p8055">Ambrosi</persName>, frater suavissime, quae <lb xml:id="p1z2"/>respondi <persName ref="p8312">Cochleo</persName><note xml:id="fn1" type="footnote" n="1">Siehe oben <ref target="file11885">Nr. 1839</ref>, Anm. 3; 1858, Anm. 1; unten 1870.</note>, ac iudica libere fratremque <lb xml:id="p1z3"/>admone liberrime.</s>
					<s n="3" xml:lang="la">Scripsi haec intra sep<lb xml:id="p1z4"/>timanas fere 14 horis succisivis.</s>
					<s n="4" xml:lang="la">Defendi caus<lb xml:id="p1z5"/>am communem, atque utinam magno cum <lb xml:id="p1z6"/>fructu!</s>
					<s n="5" xml:lang="la">Quae his tuis coniunxi, quaeso <placeName ref="l513">Ulmam</placeName> <lb xml:id="p1z7"/>ad <persName ref="p1055">Frechtum</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p1055">Martin Frecht</persName>. - Ein Brief <persName ref="p495">Bullingers</persName> an Frecht ist nicht erhalten.</note> deferri diligenter curato.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Dono illum exemplari; sed et literas a <lb xml:id="p1z9"/>me <persName ref="p8312">Cochleo</persName> scriptas<note xml:id="fn3" type="footnote" n="3">Eine Abschrift dieses Briefes unten <ref target="file11916">Nr. 1870</ref>.</note> una cum exemplari <lb xml:id="p1z10"/>mitto rogans, ut ipsa fide bona ad <persName ref="p8312">Cochleum</persName> <lb xml:id="p1z11"/>deferri curet<note xml:id="fn4" type="footnote" n="4">Zur Übermittlung dieser Schrift durch <persName ref="p1055">Frecht</persName> s. <persName ref="p8055">Blarer</persName> BW II 267 sowie unten <ref target="file11975">Nr. 1928</ref>; s. auch den Brief <persName ref="p495">Bullingers</persName> an <persName ref="p8049">Vadian</persName>, oben <ref target="file11907">Nr. 1861</ref>.</note>.</s>
					<s n="7" xml:lang="la">Nolo, ut responsio per <lb xml:id="p1z12"/>omnium oberret manus, priusquam ad ipsum <lb xml:id="p1z13"/>perveniat, ad quem pertinet maxime.</s>
					<s n="8" xml:lang="la">Nolo <lb xml:id="p1z14"/>illius imitari exemplum, qui scribit <lb xml:id="p1z15"/>ad me ac vulgat libellum<note xml:id="fn5" type="footnote" n="5">Gemeint ist <persName ref="p8312">Cochläus</persName>' Schrift gegen <persName ref="p495">Bullinger</persName>; s. oben <ref target="file11885">Nr. 1839</ref>, Anm. 2.</note>, non autem mittit<note xml:id="fn6" type="footnote" n="6"><persName ref="p495">Bullinger</persName> erwähnt dies auch im Brief an <persName ref="p8312">Cochläus</persName> selbst; s. unten <ref target="file11916">Nr. 1870</ref>, 2f.</note>.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>Nec causam agens optimam tantillum metuo.</s>
					<s n="10" xml:lang="la">In <lb xml:id="p1z17"/>luce palam et aperto Marte<note xml:id="fn7" type="footnote" n="7">Vgl. <persName ref="p4804">Seneca</persName>, <persName ref="p19833">Oedipus</persName>, 275.</note> agere ac <lb xml:id="p1z18"/>congredi cupio, ago et congredior.</s>
					<s n="11" xml:lang="la">Quod <lb xml:id="p1z19"/>si ille referire perrexerit, clypeum non <lb xml:id="p1z20"/>abiiciam, modo gloriae dei et ecclesiarum <lb xml:id="p1z21"/>saluti conducere putavero.</s>
					<s n="12" xml:lang="la">Plura iam <lb xml:id="p1z22"/>non possum.<pb type="edition" next="136"/></s>
				</p>
				<p>
					<s n="13" xml:lang="la">Ora pro me dominum.</s>
					<s n="14" xml:lang="la">Undique <lb xml:id="p1z23"/>pericula et tentationes; sed liberabit <lb xml:id="p1z24"/>ex his dominus.</s>
					<s n="15" xml:lang="la" ana="farewell">Vale cum clarissimo <persName ref="p8178">fratre</persName> <lb xml:id="p1z25"/>tuo<note xml:id="fn8" type="footnote" n="8"><persName ref="p8178">Thomas Blarer</persName>.</note>, <persName ref="p4082">Zviccio</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p4082">Konrad Zwick</persName>.</note> atque reliquis.</s>
					<s n="16" xml:lang="la">Martii 14., anno <lb xml:id="p1z26"/>domini 1544.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z27"/><persName ref="p495">H. Bullingerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p8055">Am<lb xml:id="p2z2"/>brosio Blaurero</persName>, amico <lb xml:id="p2z3"/>incomparabili, <lb xml:id="p2z4"/>fratri honorando et <lb xml:id="p2z5"/>semper charissimo.</s>
				</p>
			</div>
