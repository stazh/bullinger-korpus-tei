	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Commendat nobis <placeName>Ungaros</placeName> hosce dominus <persName ref="p8033">Beza</persName>, commen<lb xml:id="p1z2"/>do ego illos tibi.</s>
					<s n="3" xml:lang="la">Proficiscuntur ad vos, ut vos <lb xml:id="p1z3"/>videant aut et alloquantur.</s>
					<s n="4" xml:lang="de"><foreign xml:lang="la">Scribitur simul <placeName ref="l167">Geneva</placeName>,</foreign> <lb xml:id="p1z4"/>der hertzog nemme volk an und rüste sich, und <lb xml:id="p1z5"/>sigind schon ettliche reisige zuͦ <placeName>Burg in Breß</placeName> ankommen; <lb xml:id="p1z6"/>wo es us well, weißt man nitt; man besor<lb xml:id="p1z7"/>get ein bös wätter, wo es joch des herren wind <lb xml:id="p1z8"/>hin wäye.</s>
					<s n="5" xml:lang="la">Heri redierunt nostri <placeName ref="l922">Friburgo</placeName>.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Quid afferant, nondum liquido cognovi; nec<lb xml:id="p1z10"/>dum enim senatui acta exposuerunt.</s>
					<s n="7" xml:lang="de">Si wartend <lb xml:id="p1z11"/>uff den abscheid; der sol inen hütt nach kon.</s>
					<s n="8" xml:lang="de"><lb xml:id="p1z12"/>Doch verston ich, <persName>Frybrug</persName> und <placeName ref="l791">Wallis</placeName> enbütend <lb xml:id="p1z13"/>sich, lyb und guͦt zuͦ m[inen] h[erren] zuͦ setzen, so inen des <lb xml:id="p1z14"/>lands halb ützit sötte begegnen.</s>
					<s n="9" xml:lang="de">Wie si aber <placeName ref="l167">Genff</placeName> <lb xml:id="p1z15"/>halb gesinnet, han ich noch nitt verstanden.</s>
					<s n="10" xml:lang="de">Item, <lb xml:id="p1z16"/>ob etwas punts oder verschrybung darumb werde <lb xml:id="p1z17"/>ufgericht oder nitt.</s>
					<s n="11" xml:lang="de">Sonst hab ich jetz nüt.</s>
					<s n="12" xml:lang="la">Re<lb xml:id="p1z18"/>diit interea filius meus et tuas mihi attulit, <lb xml:id="p1z19"/>pro quibus ago gratias.</s>
					<s n="13" xml:lang="la">Remitto tibi, quę per illum <lb xml:id="p1z20"/>et quę etiam iam antea misisti.</s>
					<s n="14" xml:lang="la">In <lb xml:id="p1z21"/>syntagmate, <lb xml:id="p1z22"/>quod mihi nuper misisti, deficit quaternio J, <lb xml:id="p1z23"/>qui incipit a syllaba - lis; tu poteris hunc mihi <lb xml:id="p1z24"/>defectum a <persName ref="p1227">Froschouero</persName> comparare, si placet.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z25"/>D. <persName ref="p8063">Steigerus</persName> et fratres omnes te diligenter salutant; <lb xml:id="p1z26"/>idem faciunt socer, mater, uxor etc.</s>
					<s n="16" xml:lang="la" ana="salute">Salutem precor <lb xml:id="p1z27"/>tuis quoque.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l41">Bernae</placeName> 25. februarii 1567.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><persName ref="p8018">I[oh<lb xml:id="p1z28"/>annes] Hall[erus</persName>] tuus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, colendissimo <lb xml:id="p2z4"/>mihi semper domino et <lb xml:id="p2z5"/>compatri.</s>
				</p>
			</div>
		</body>
	</text>
