	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Invenit me hic studiosus pluribus
					<lb xml:id="p1z2"/>implicitum negotiis frater, ut non potuerit,
					<lb xml:id="p1z3"/>copiosas ad te dare, ne tamen sue
					<lb xml:id="p1z4"/>literis prorsus rediret, his saltem grati
					<lb xml:id="p1z5"/>lari volui tibi de sanitate utcunque
					<lb xml:id="p1z6"/>recuperata. Dominus illam suam virtute
					<lb xml:id="p1z7"/>magisque confirmet et provehat.
					<lb xml:id="p1z8"/>Salvi sint fratres omnes. Te et tuos synbis
					<lb xml:id="p1z9"/>ystas nostre omnes vicissim salutant.
					<lb xml:id="p1z10"/>vale. Brevi copiosiores ad te scrib,
					<lb xml:id="p1z11"/>et prolixiores a te expectabo.T
					<lb xml:id="p1z12"/>Tiguri 1.novembris 1554.
					<lb xml:id="p1z13"/>Bullingerus tuus.
					<lb xml:id="p1z14"/>ascendas, deinde et ad no
					<lb xml:id="p1z15"/>Badeno.
					<lb xml:id="p1z16"/>u
					<lb xml:id="p1z17"/>videamus et colloqua.
					<lb xml:id="p1z18"/>
					<lb xml:id="p1z19"/>fiat.
					<lb xml:id="p1z20"/>.
					<pb/>
					<lb xml:id="p2z1"/>Praestantissimo viro d.
					<lb xml:id="p2z2"/>Matthiae Erbiae pastori
					<lb xml:id="p2z3"/>Rychevillano, domino
					<lb xml:id="p2z4"/>fratrio
					<lb xml:id="p2z5"/>clendo et dilectosus
					<lb xml:id="p2z6"/>Reychen wybr
				</p>
			</div>
		</body>
	</text>
