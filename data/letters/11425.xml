	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Iamdudum abs te responsum expecto<note xml:id="fn1" type="footnote" n="1">Vgl. <persName ref="p8011">Gwalthers</persName> Brief vom 30. März (oben <ref target="file11422">Nr. 1379</ref>).</note>, huma<lb xml:id="p1z2"/>nissime pater, ut, quid de rebus meis constituendum mihi sit, certo cognoscam, <lb xml:id="p1z3"/>quamvis ampliori responsione opus non foret, nisi aliis arduis pro<lb xml:id="p1z4"/>fecto et ingentibus caussis impedirer.</s>
					<s n="3" xml:lang="la">Nequaquam enim ignoro, quantum <lb xml:id="p1z5"/>officii et obedientiae collegii nostri praesidibus (imprimis vero tibi, qui <lb xml:id="p1z6"/>mihi semper patris loco fuisti<note xml:id="fn2" type="footnote" n="2">Vgl. <bibl source="b10">HBBW VIII</bibl>. <hi>S.</hi> 177, 20-22.</note>) debeam.</s>
					<s n="4" xml:lang="la">Sed ut quimus, aiunt, <lb xml:id="p1z7"/>quando ut volumus non licet<note xml:id="fn3" type="footnote" n="3"><persName ref="p18901">Terenz</persName>, Andria, 805; vgl. <bibl source="b56">Adagia</bibl>, 1, 843 (<bibl source="b370">LB</bibl> II 313f).</note>.</s>
					<s n="5" xml:lang="la">Ego sane<pb type="edition" next="88"/> vestrae huic vocationi, <lb xml:id="p1z8"/>qua <placeName ref="l512">Tubingam</placeName> scholam mihi proposuistis, satisfacere paratus non <lb xml:id="p1z9"/>tam aliorum consiliis (quibus si non multum, certe non nihil <lb xml:id="p1z10"/>debeo) quam propria necessitate impeditus ceptum consilium <lb xml:id="p1z11"/>exequi nequaquam potero.</s>
					<s n="6" xml:lang="la">Venerunt enim ad sodales nostros, <lb xml:id="p1z12"/>qui hic mecum degunt<note xml:id="fn4" type="footnote" n="4"><persName ref="p6755">Konrad Suter</persName>, <persName ref="p2811">Christoph Rotacher</persName> und <persName ref="p8383">Christian Wirth</persName>; vgl. oben <ref target="file11420">Nr. 1377</ref>, 1-10 mit Anm.1.</note>, a <placeName ref="l512">Tubinga</placeName> <persName ref="p3988">Wolphii</persName> et aliorum literae<note xml:id="fn5" type="footnote" n="5">Dieser Brief von <persName ref="p3988">Johannes Wolf</persName>, <persName ref="p8461">Johann Jakob Wick</persName> und <persName ref="p8018">Johannes Haller</persName> (vgl. oben <ref target="file11422">Nr. 1379</ref>, Anm. 15) ist nicht erhalten, vgl. jedoch das inhaltlich parallele Schreiben Wolfs an <persName ref="p495">Bullinger</persName> vom 13. April (unten <ref target="file11426">Nr. 1383</ref>).</note>, <lb xml:id="p1z13"/>quę scholae quidem modum non damnant, victus vero caritatem <lb xml:id="p1z14"/>mihi intolerandam ostendunt.</s>
					<s n="7" xml:lang="la">Vilissimo enim, quo <lb xml:id="p1z15"/>ibi vivitur pretio, minus 26 florenis non victitare quisquam poterit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Pręterea lectus conducendus, conducendum quoque <lb xml:id="p1z17"/>domicilium, quorum omnium summa ad 34 florenorum summam <lb xml:id="p1z18"/>fere ascendet, quod et ipse iudicare poteris.</s>
					<s n="9" xml:lang="la">Esto tamen, <lb xml:id="p1z19"/>ut nunc pentecostes et autumni stipendium mittatur<note xml:id="fn6" type="footnote" n="6">Am 11. März war <persName ref="p8011">Gwalthers</persName> Stipendium von 30 auf 34 Gulden jährlich erhöht worden; die Bezüge für Sommer und Herbst wurden ausnahmsweise zusammen ausbezahlt (s. Zürich StA, G II 39. 1, Nr. 8).</note>, <lb xml:id="p1z20"/>impossibile nihilominus erit, ut <placeName ref="l512">Tubingae</placeName> 17 florenis <lb xml:id="p1z21"/>ab hinc usque ad Christi nativitatem vivere queam.</s>
					<s n="10" xml:lang="la">Quare <lb xml:id="p1z22"/>doctissimorum virorum consiliis persuasus <placeName ref="l28">Basileae</placeName> morari institui, <lb xml:id="p1z23"/>nisi vobis secum visum fuerit; quod etiamsi fiat, mihi <lb xml:id="p1z24"/>tamen aliter agere impossibile est hac pecuniarum inopia circumvento.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z25"/>Quare te rogo, ut per hunc tabellarium<note xml:id="fn7" type="footnote" n="7">Unbekannt.</note> mihi, <lb xml:id="p1z26"/>quid nam tibi optimum videatur, scribas.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Interim tamen <lb xml:id="p1z27"/>non parum me implicat et illud, quod <placeName ref="l280">Lausannam</placeName> scripseras, <lb xml:id="p1z28"/>cum de <placeName ref="l167">Genevensi</placeName> mercatore et typographo te con<lb xml:id="p1z29"/>suluissem<note xml:id="fn8" type="footnote" n="8">Siehe <bibl source="b11">HBBW IX</bibl> <ref target="file11379">[Nr. 1336]</ref>, S. 261, 20-30; vgl. oben <ref target="file11395">Nr. 1352</ref>, 49-53.</note>; in genere mihi rescribere videbaris, ne alienis <lb xml:id="p1z30"/>hominibus operam meam collocarem.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Tu tamen ipse, velim, <lb xml:id="p1z31"/>perpendas, et invenies necesse fore aut alienis operam <lb xml:id="p1z32"/>meam condicere aut stipendium amplius habere <lb xml:id="p1z33"/>aut mendicandum forsitan esse, quod tamen vobis ne<lb xml:id="p1z34"/>quaquam placere arbitror.</s>
					<s n="14" xml:lang="la">Vestris tamen adhuc innitar <lb xml:id="p1z35"/>consiliis, quoad me vobis curę esse intellexero nec mihi <lb xml:id="p1z36"/>soli negari id, quod aliis omnibus me longe ditioribus <lb xml:id="p1z37"/>concessum est<note xml:id="fn9" type="footnote" n="9">Vgl. auch unten <ref target="file11431">Nr. 1388</ref>, 29-66.</note>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Salutabis nomine meo uxorem<note xml:id="fn10" type="footnote" ana="bio" n="10"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> et matrem<note xml:id="fn11" type="footnote" ana="bio" n="11"><persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note> <lb xml:id="p1z38"/>tuam cum omni familia.</s>
					<s n="16" xml:lang="la" ana="farewell">Vale, pater charissime, et <lb xml:id="p1z39"/>me tibi commendatum habeas.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Mitte per hunc, quaeso, quę <lb xml:id="p1z40"/>prioribus literis petii<note xml:id="fn12" type="footnote" n="12">Die Rede ist von Büchern, vgl. oben <ref target="file11422">Nr. 1379</ref>, 30-32.</note>, si modo onus non recusaverit.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l28">Basileae</placeName>, <lb xml:id="p1z41"/>8. aprilis 1540.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z42"/>Tui observantissimus</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z43"/><persName ref="p8011">Rod. Gvaltherus</persName>.<pb type="edition" next="89"/></s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> ecclesiae antistiti, <lb xml:id="p2z4"/>patri suo imprimis <lb xml:id="p2z5"/>colendo.</s>
					<s n="22" xml:lang="de"><lb xml:id="p2z6"/>An M. <persName ref="p495">Heinrich <lb xml:id="p2z7"/>Bullinger</persName> zuͦ <lb xml:id="p2z8"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
