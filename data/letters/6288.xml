	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Reverendi et clarissimi viri, domini observandi, salutem et <lb xml:id="p1z2"/>officiorum meorum commendationem.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Dum hic cum filiolo illustrissimi principis et d. d. <persName ref="p8117">Nicolai Radziw<lb xml:id="p1z4"/>ili</persName>, ducis de <placeName ref="l2573">Olika</placeName> et <placeName ref="l2572">Nyczwiesch</placeName> etc., studiorum causa versor, mis<lb xml:id="p1z5"/>sae sunt ad me literae hae, quas excellentiis vestris per praesentem <lb xml:id="p1z6"/>offero, rogoque vehementer, cum de ecclesiae emolumento res <lb xml:id="p1z7"/>agatur, excellentiae vestrae non graventur paucis praenominato prin<lb xml:id="p1z8"/>cipi ad haec scripta respondere, sive id fiat per praesentium <lb xml:id="p1z9"/>exhibitorem sive per alium (si nunc non vacabit) nuntium <lb xml:id="p1z10"/>ad hoc peculiariter conductum, cui ego, cum ad me venerit, <lb xml:id="p1z11"/>libenter sum soluturus.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Interim ego nobilem, qui cum istis <lb xml:id="p1z12"/>scriptis huc venit, tandiu detinebo, donec ab excellentiis vestris <lb xml:id="p1z13"/>fuerit allatum responsum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">His me meaque officia excellentiis <lb xml:id="p1z14"/>vestris sedulo commendo.</s>
					<s n="5" xml:lang="la">Datae <placeName ref="l512">Tubingae</placeName> 19. octobris 1564.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Excellentiarum vestrarum <lb xml:id="p1z16"/>paratissimus <lb xml:id="p1z17"/><persName ref="p3655">Balthasar a Lewalt</persName>, <lb xml:id="p1z18"/>administer studiorum iuni<lb xml:id="p1z19"/>oris principis <persName ref="p8117">Radzivili</persName> <lb xml:id="p1z20"/><placeName ref="l512">Tubingae</placeName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>Reve<pb/><lb xml:id="p4z1"/>rendis et excellentissimis viris dominis superintendenti <lb xml:id="p4z2"/>et pastoribus ecclesiae <placeName ref="l587">Tigurinae</placeName>, dominis <lb xml:id="p4z3"/>et amicis observandis.</s>
				</p>
			</div>
		</body>
	</text>
