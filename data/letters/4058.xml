	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi binas tuas literas, compater <lb xml:id="p1z2"/>charissime; eas, quas inscripseras d. d. <persName ref="p1283">Gessnero</persName>, <lb xml:id="p1z3"/>curavi ipsi protinus tradi.</s>
					<s n="3" xml:lang="la">Quod scribam, nunc no<lb xml:id="p1z4"/>n habeo, nisi quod illi, qui ex <placeName ref="l832">Gallia</placeName> veniunt, <lb xml:id="p1z5"/>pro certo referunt persequtionem opera et in<lb xml:id="p1z6"/>stinctu <placeName>Guysianorum</placeName> et rasorum unctorumque ma<lb xml:id="p1z7"/>ledicto chrismate, chara[c]tere bestiae, progredi.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Dominus, qui regem potenter cohercuit, potest <lb xml:id="p1z9"/>et infelix illud avicium per acsipitrem aliquem <lb xml:id="p1z10"/>dispellere et in fugam convertere.</s>
					<s n="5" xml:lang="la">Nunc <lb xml:id="p1z11"/>totus occupatus sum scribendis literis et mittendis <lb xml:id="p1z12"/><placeName ref="l157">Francfordiam</placeName>, ut inde in varia<lb xml:id="p1z13"/>s nationes ad amicos perferantur.</s>
					<s n="6" xml:lang="la">Mitto tibi <lb xml:id="p1z14"/>et d. <persName ref="p8359">Gallicio</persName> Sermones nostros in Ieremiam <lb xml:id="p1z15"/>nunc aeditos.</s>
					<s n="7" xml:lang="la">Puto me tibi et <persName ref="p8359">Gallicio</persName> <lb xml:id="p1z16"/>nostram catechesim misisse; si non misi, <lb xml:id="p1z17"/>submittam adhuc.</s>
					<s n="8" xml:lang="la">Benigne haec a me <lb xml:id="p1z18"/>accipite.</s>
				</p>
				<p>
					<s n="9" xml:lang="de">Wenn ich üch anders gern schanckte, <lb xml:id="p1z19"/>hätte ichs nitt; acht ouch, das sye ein <lb xml:id="p1z20"/>komliche und üch fuͦgeliche schäncke.</s>
					<s n="10" xml:lang="la" ana="farewell">Valete.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p1z21"/>Saluta d. d. consules, <persName>Philippum</persName> etc.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Com[m]end <lb xml:id="p1z23"/>me legato et saluta illum amicissime; scribam <lb xml:id="p1z24"/>ad eum, si aliquid memoratu dignum <lb xml:id="p1z25"/>ex nundinis accepero.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 25. <lb xml:id="p1z26"/>augusti <lb xml:id="p1z27"/>anno 15<lb xml:id="p1z28"/>5<lb xml:id="p1z29"/>9.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z30"/><persName ref="p495">Bullingerus</persName> tuissimus.</s>
				</p>
				<p>
					<note>[Darunter von Fabricius Hand die Notiz:]</note>
					<s n="15" xml:lang="la"><lb xml:id="p1z31"/>20. augusti <persName ref="p18477">Ferdinandus</persName> post soluta comitia <lb xml:id="p1z32"/><placeName ref="l18">Augusta</placeName> discessit <placeName ref="l546">Viennam</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>