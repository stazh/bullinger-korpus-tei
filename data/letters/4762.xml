	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non dubito, quin intellexeris, que <placeName ref="l21">Badene</placeName> acta sunt, causamque <lb xml:id="p1z2"/><placeName ref="l646">Glaronensium</placeName> optimo in loco positam.</s>
					<s n="3" xml:lang="la">Mitterem exemplar propositionis facte <lb xml:id="p1z3"/>per pontificis nuncium, nisi eam te habere existimarem.</s>
					<s n="4" xml:lang="la">Multus est <lb xml:id="p1z4"/>rumor de foedere inter pontificem, imperatorem, <persName ref="p18575">regem Hispanie</persName> et <placeName>Sabaudum</placeName> <lb xml:id="p1z5"/>et quod <placeName ref="l2448">Quinquepagici</placeName> se adiungere velint.</s>
					<s n="5" xml:lang="la">Senatus amplissimus <placeName ref="l587">Tigurinus</placeName> <lb xml:id="p1z6"/>sibi non deerit nec si quas deus offerat honestas conditiones et <lb xml:id="p1z7"/>rationes tuende pacis et tranquillitatis publice repudiabit pro sua <lb xml:id="p1z8"/>prudentia, ut nihil addam in re, que per se loquitur, et sicut sabatum <lb xml:id="p1z9"/>propter hominem factum, ita leges temporum sunt non hominum etc.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Rex Remis sacrabitur 11. maii et <placeName ref="l378">Lutetiam</placeName> ingredietur cum pompa 20. iulii.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>Maximi in dies progressus fient verbi in <placeName ref="l832">Gallia</placeName> et furor pseudosacerdotum <lb xml:id="p1z12"/>cohibetur.</s>
					<s n="8" xml:lang="la">His scriptis literas accepi a domino <placeName ref="l1854">Redonensi</placeName> episcopo <placeName ref="l613">Vienne</placeName> <lb xml:id="p1z13"/>scriptas 15. huius mensis, quibus scribit concilii negocium tam sibi videri <lb xml:id="p1z14"/>incertum quam unquam antea.</s>
					<s n="9" xml:lang="la">Post dietam aliquid statuetur.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Deus scit, <lb xml:id="p1z15"/>quando erit.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Bellum incipit inter <persName ref="p1825">regem Polonie</persName> et Moscovitam.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z16"/>Hactenus eius verba.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z17"/>Est quod dominis agam gratias et consuli, quod suam interposuerint <lb xml:id="p1z18"/>auctoritatem in negocio interesse aut usurarum.</s>
					<s n="14" xml:lang="la">Sed <placeName ref="l300">Lucernates</placeName> illis <lb xml:id="p1z19"/>immensas gratias deberent agere et ferre, non si obtemperatum <lb xml:id="p1z20"/>fuisset <persName ref="p8423">Pfiffero</persName> rege non abs re exacerbato, vix a multis mensibus <lb xml:id="p1z21"/>aliquid decidi potuisset.</s>
					<s n="15" xml:lang="la">Adeo sunt, qui laborant, ut sibi mala <lb xml:id="p1z22"/>concilient et calamitates accersant.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Noluerunt acceptare <lb xml:id="p1z23"/>ultra quinque hic recepta quatuor singulis annis ex liberalitate <lb xml:id="p1z24"/>regia et volunt de<lb xml:id="p1z25"/>cem pro centum, si supplex offero.</s>
					<s n="17" xml:lang="la">Hec sunt vitia huius <lb xml:id="p1z26"/>senecte mundi, quibus non desunt fautores et obsignatores.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Acri <lb xml:id="p1z27"/>opus esset medico; sed ab illorum manibus evadere oportet.</s>
					<s n="19" xml:lang="la" ana="salute"><lb xml:id="p1z28"/>Salutabis dominos et amicos omnes.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l760">Soluduri</placeName> 20. aprilis.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z29"/>Tuus ex animo si suus.</s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
					<s n="23" xml:lang="de"><pb/><lb xml:id="p2z1"/>An herren <persName ref="p495">Heinrich <lb xml:id="p2z2"/>Bullinger</persName>.</s>
				</p>
				<p>
					<s n="24" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
