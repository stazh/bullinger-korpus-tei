	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Magnam gratiam tibi habeo, mi <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z2"/>ob perscriptam ad me historiam de <placeName ref="l294">Locarnensibus</placeName> fratribus, ex quorum <lb xml:id="p1z3"/>aequanimitate et constantia merito pii omnes voluptatem capiunt, et <lb xml:id="p1z4"/>celebrare par est nomen sanctum domini, qui haec in suis operatus <lb xml:id="p1z5"/>est porro eos misericorditer gubernaturus et vindicaturus innocenti<lb xml:id="p1z6"/>um gemitus, quorum lachrymas in lagenulam colligit.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Nos id agimus privatim et publice, ut delicti magn<lb xml:id="p1z8"/>itudo intelligatur seque haud immunes a culpa esse noverint, <lb xml:id="p1z9"/>qui vel dissimulatione vel consensu causam sanctorum, que <lb xml:id="p1z10"/>Christi est, produnt, si vel in posterum ardentius agant, quando, <lb xml:id="p1z11"/>quod semel est factum, nequit infectum fieri.</s>
					<s n="4" xml:lang="la"><placeName ref="l18">Augustae</placeName> <persName ref="p18477">Ferdinandus</persName> <lb xml:id="p1z12"/>ingressus est plena potestate acturus, quam imperator illi <lb xml:id="p1z13"/>nunc detulit, cum comiciis nequeat ipse interesse, neque ego <lb xml:id="p1z14"/>de illo auspicatiora expecto quam de fratre, quando nuper <lb xml:id="p1z15"/>vir eruditissimus idemque innocentissimus d. <persName ref="p17836">Bruschius</persName> poeta <lb xml:id="p1z16"/>ob evangelii professionem capite truncatus est <lb xml:id="p1z17"/>in <placeName ref="l232">Aeniponte</placeName>, rege nimirum consentiente et forte iubente etiam.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z18"/>Adeo sibi similes tyranni permanent, ubi semel manus sanguine <lb xml:id="p1z19"/>martyrum cruentarint.</s>
					<s n="6" xml:lang="la"><placeName ref="l648">Rhetiae</placeName> bene precor et ominor ob <lb xml:id="p1z20"/>receptos pientissimos Christi exules, recepturae nimirum cumulatissimam <lb xml:id="p1z21"/>benedictionem ob hoc pietatis officium, neque illa <lb xml:id="p1z22"/>non gratiae dei efficacis signum experta est statim a comiciis, <lb xml:id="p1z23"/>quo haec tractata sunt de exulibus, quando liberata est <lb xml:id="p1z24"/>viro principe hypocrita eoque per manum domini sublato, cum <lb xml:id="p1z25"/>inquisitorem <placeName ref="l425">Romanum</placeName> monachum episcopi iussu deduceret, quod tu <lb xml:id="p1z26"/>nimirum pridem cognovisti.</s>
					<s n="7" xml:lang="la" ana="farewell">Sed vale in Christo Iesu cum <lb xml:id="p1z27"/>tuis omnibus.</s>
					<s n="8" xml:lang="la"><placeName ref="l335">Mulhusanis</placeName> fratribus statim perferenda curabo, quae mi<lb xml:id="p1z28"/>sisti nomine <persName ref="p540">Calvini</persName>, a quo nos nihil accepimus.</s>
					<s n="9" xml:lang="la"><placeName ref="l28">Basileae</placeName> <lb xml:id="p1z29"/>12. februarii anno 55.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z30"/>T[uus] <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, domino <lb xml:id="p2z3"/>et fratri colendissimo s<lb xml:id="p2z4"/>uo.</s>
				</p>
			</div>
		</body>
	</text>
