	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et vitae innocentiam a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Vix <lb xml:id="p1z2"/>dixero, charissime mi <persName ref="p1010">Erbi</persName>, quam male me <lb xml:id="p1z3"/>habeat et angat liber ille tuus, hoc est epistol<lb xml:id="p1z4"/>a dedicatoria<note xml:id="fn1" type="footnote" n="1"><persName ref="p1010">Erbs</persName> Widmungsbrief zum von ihm geplanten lateinischen Sonderdruck von <persName ref="p495">Bullingers</persName> "Resurrectio"; s. oben <ref target="file12196">Nr. 2149</ref>, Anm. 26. - Die Widmungsepistel richtete sich an <persName ref="p8103">Sigismund Stier</persName> und <persName ref="p4890">Oswald Fürstenlob</persName>.</note> et partitio libri de re<lb xml:id="p1z5"/>surrectione<note xml:id="fn2" type="footnote" n="2">Aus <persName ref="p1010">Erbs</persName> Brief vom 30. April 1545 (oben <ref target="file12196">Nr. 2149</ref>) konnte <persName ref="p495">Bullinger</persName> entnehmen, dass <persName ref="p1010">Erb</persName> seine Sendung von Anfang April (s. unten Z. 4) nicht erhalten hatte.</note>.</s>
					<s n="3" xml:lang="la">Hunc enim per fratrem quendam<note xml:id="fn3" type="footnote" n="3">Unbekannt und Teil einer Gruppe; s. unten Z. 16.</note> <lb xml:id="p1z6"/>circa paschae festum<note xml:id="fn4" type="footnote" n="4">D.h. um den 5. April 1545.</note> <placeName ref="l28">Basilaeam</placeName> ablegavi, ratus in<lb xml:id="p1z7"/>de tuto et brevi ad te perferendum.</s>
					<s n="4" xml:lang="la">Nunc vero <lb xml:id="p1z8"/>ex literis tuis<note xml:id="fn5" type="footnote" n="5">Oben Nr.2149.</note> intelligo nihildum te accepisse.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Suspicor ergo interiisse laborem utilem et pium.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Verum diligentius adhuc perquiram<note xml:id="fn6" type="footnote" n="6"><persName ref="p495">Bullinger</persName> konnte die Vorlagen vordem 19. Juli 1545 zurückerhalten; s. unten <ref target="file12246">Nr. 2199</ref>.</note>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Exposui <lb xml:id="p1z11"/>tibi literis additis<note xml:id="fn7" type="footnote" n="7">Im nicht erhaltenen Begleitbrief zu <persName ref="p495">Bullingers</persName> Sendung.</note>, quid obstiterit, quo minus <lb xml:id="p1z12"/>typis excuderit <persName ref="p4851">Froschouerus</persName>, cur tam diu <lb xml:id="p1z13"/>retinuerim.</s>
					<s n="8" xml:lang="la">Nam in diem faciebat mihi <lb xml:id="p1z14"/>spem imprimendi, tandem mole negotiorum ad<lb xml:id="p1z15"/>opertus sancte asseverabat se non posse praelo ex<lb xml:id="p1z16"/>cudere.</s>
					<s n="9" xml:lang="la">Et, quamquam non admodum patienti animo <lb xml:id="p1z17"/>responsionem susciperem, quia tamen videbam hominem <lb xml:id="p1z18"/>negotiis, uti quaerebatur, coopertum, boni con<lb xml:id="p1z19"/>sului, ac tibi remittendum putavi in tempore, <lb xml:id="p1z20"/>uti <placeName ref="l28">Basilęae</placeName> apud <persName ref="p3932">Westheymerum</persName> aut alium <lb xml:id="p1z21"/>curares mature imprimi.</s>
					<s n="10" xml:lang="la">Iam vero <lb xml:id="p1z22"/>praeter<pb type="edition" next="349"/> spem experior te nondum recepisse quic<lb xml:id="p1z23"/>quam.</s>
					<s n="11" xml:lang="la">At revera culpa haec in me <lb xml:id="p1z24"/>non haeret, <lb xml:id="p1z25"/>sed in illis, quibus credidi literas; attamen <lb xml:id="p1z26"/>culpam deprecor quam possum humilime.</s>
					<s n="12" xml:lang="la">Quamprimum <lb xml:id="p1z27"/>vero rescivero, qua fide aut perfidia usi <lb xml:id="p1z28"/>sint, qui susceperunt, receperoque librum, bona <lb xml:id="p1z29"/>fide mittam.</s>
					<s n="13" xml:lang="la">Interim, cum aliud non possum, dolore <lb xml:id="p1z30"/>prosequar infortunium illud.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Qui <lb xml:id="p1z31"/>has tibi offert, est <persName ref="p20592">Geroldus Meyer</persName>,<note xml:id="fn8" type="footnote" n="8"><persName ref="p20592">Gerold Meyer von Knonau d.J.</persName></note> honestissimis natus <lb xml:id="p1z32"/>parentibus,<note xml:id="fn9" type="footnote" ana="bio" n="9">Die Eltern von <persName ref="p20592">Gerold Meyer von Knonau d.J.</persName> waren <persName ref="p17953">Gerold Meyer von Knonau d.Ä.</persName> und <persName ref="p4638">Küngold Dietschi</persName>; s. Genealogisches Handbuch zur Schweizer Geschichte, Bd. 3: Niederer Adel und Patriziat, Zürich 1908/1916, S. 182.</note> maximę spei iuvenis.</s>
					<s n="15" xml:lang="la">Hunc <lb xml:id="p1z33"/>tuae fidei commendo tanquam patri filium.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Quod <lb xml:id="p1z34"/>huic impenderis, mihi impensum putabo.</s>
					<s n="17" xml:lang="la">Mone <lb xml:id="p1z35"/>illum fideliter, et, sicubi pro iuvenili <lb xml:id="p1z37"/>aetate exorbitare videris, mature ad nos <lb xml:id="p1z38"/>scribito.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Ego vicissim totus tuus ero ac sum.</s>
					<s n="19" xml:lang="la">Ama m<lb xml:id="p1z39"/>e in Christo.</s>
					<s n="20" xml:lang="la" ana="farewell">Vive et vale<lb xml:id="p1z40"/>.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z41"/>Festinantissime.</s>
					<s n="22" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 3. iunii <lb xml:id="p1z42"/>1545.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z43"/><persName ref="p495">H. Bullingerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p1010">Matthiae <lb xml:id="p2z2"/>Erbio</persName>, <placeName ref="l411">Richenvillae</placeName> Christi <lb xml:id="p2z3"/>et ecclesiae ministro, fratri <lb xml:id="p2z4"/>charissimo suo.</s>
				</p>
