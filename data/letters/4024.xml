	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Die martis mane, cum iam honestus hic et pius vir <lb xml:id="p1z2"/>in procinctu esset, haec d. orator: <lb xml:id="p1z3"/>Nunc primum omnia <placeName ref="l1148">Constantinopoli</placeName> ad se diserte esse <lb xml:id="p1z4"/>perscripta de conflictu duorum filiorum imperatoris <lb xml:id="p1z5"/><placeName ref="l2510">Turcici</placeName>.</s>
					<s n="3" xml:lang="la">Cecidisse hominum numero triginta millia <lb xml:id="p1z6"/>aut amplius; superiorem factum <persName>Selimum</persName>, cuius <lb xml:id="p1z7"/>partes tuetur parens.</s>
					<s n="4" xml:lang="la">Baiasetum esse in fuga, <lb xml:id="p1z8"/>cogitare aut in <placeName>Persidem</placeName> aut <placeName ref="l2688">Aegyptum</placeName>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Imperatorem <lb xml:id="p1z9"/>misisse multa millia equitum, qui ex fuga retrahant <lb xml:id="p1z10"/>caputque eius ad parentem perferant, vix tamen hoc <lb xml:id="p1z11"/>futurum, nisi pater ipse persequatur; timent enim, <lb xml:id="p1z12"/>ne parentis ira sedata eum facile poeniteat et culpa <lb xml:id="p1z13"/>in se redundet.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Ad legatum perscribitur <persName ref="p487">Heinrychum</persName> morientem filium iuramento <lb xml:id="p1z15"/>obstrinxisse, ut veterem et avitam religionem conservet <lb xml:id="p1z16"/><persName>Philippumque</persName>, <persName ref="p18575">Hispaniarum regem</persName>, observet, eiusque rei filium <lb xml:id="p1z17"/>Franciscum dedisse chyrographum, quod, ut existimatur, sit penes <lb xml:id="p1z18"/><persName>Philippum</persName>.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z19"/>Classis paratur contra <placeName>Tripolim</placeName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Ni<lb xml:id="p1z20"/>hil his festinantius.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><persName ref="p8009">Fabritius</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro eruditione <lb xml:id="p2z2"/>et pietate excellenti d. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z4"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> antistiti <lb xml:id="p2z5"/>vigilantissimo, domino <lb xml:id="p2z6"/>et patrono suo <lb xml:id="p2z7"/>multum colendo.</s>
				</p>
			</div>
		</body>
	</text>
