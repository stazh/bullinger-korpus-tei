	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z5"/>S. <lb xml:id="p1z12"/>P.</s>
					<s n="2" xml:lang="la">Laconismum hunc meum, vir praestantissime, excusabit necessitas.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Pemit nos <lb xml:id="p1z13"/>sęva pestis, quae multos bonos quotidie apud nos <placeName ref="l351">Nordanos</placeName> absumit, et uxor <lb xml:id="p1z14"/>mea periculose decumbit.</s>
					<s n="4" xml:lang="la"><placeName ref="l138">Emda</placeName> a peste iam est libera.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Dithmaria mense <lb xml:id="p1z15"/>iunio armis victa [fuit] in deditionem venit ducis <placeName>Holsatię</placeName>.</s>
					<s n="6" xml:lang="la">Princeps <lb xml:id="p1z16"/>noster <persName>Edhardus</persName> ante mensem circiter iam secundum profectus est <lb xml:id="p1z17"/>in <placeName>Sweciam</placeName> inde sponsam adducturus regis natu maiorem <lb xml:id="p1z18"/>filiam.</s>
					<s n="7" xml:lang="la">Quid ex his nuptiis boni ominer ecclesię nostrę, non habeo; <lb xml:id="p1z19"/>sed Christus dominus, caput omnis principatus et potestatis facile omnia <lb xml:id="p1z20"/>adversariorum consilia in nihilum rediget.</s>
					<s n="8" xml:lang="la">Dominus deus noster, dominus de<lb xml:id="p1z21"/>us noster annos tibi addat quam plurimos, quibus ecclesię dei adhuc utilis vivas.</s>
					<s n="9" xml:lang="la" ana="salute">Nostro <lb xml:id="p1z22"/>nomine salutare dignaberis praeceptores nostros observandos d. <lb xml:id="p1z23"/><persName ref="p8111">Petrum Martyrem</persName> et d. <persName ref="p1283">Gesnerum</persName> medicum.</s>
					<s n="10" xml:lang="la" ana="salute">Salutant vos collegę <lb xml:id="p1z24"/>et fratres omnes, qui omnia vobis in domino felicia precantur.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z25"/>Raptim.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l351">Nordę</placeName> 1559. augusti 14.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z26"/>Tuus in domino <persName ref="p8415">Martinus <lb xml:id="p1z27"/>Micronius</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Piissimo et eruditissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesię doctori vigilantissimo, <lb xml:id="p2z4"/>domino et fratri suo.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
