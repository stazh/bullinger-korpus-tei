	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Iuvenem hunc pręclaro ingenio, eruditione et <lb xml:id="p1z3"/>pietate pręditum cum intelligerem ad vos profi<lb xml:id="p1z4"/>cisci velle, passus non sum eum ad te sine meis literis<note type="misc">litere</note> <lb xml:id="p1z5"/>hinc <lb xml:id="p1z6"/>abire, quibus ea lege tibi commendaretur, <lb xml:id="p1z7"/>qua mihi a <persName ref="p8100">Scalichio</persName> polyhistore viro, commendatus <lb xml:id="p1z8"/>fuit.</s>
					<s n="2" xml:lang="la">Pręlo <persName ref="p1283">Gesneri</persName>, ut audio, aderit corrector <lb xml:id="p1z9"/>hanc <placeName>Spartam</placeName> ad tempus, dum alia non occurrit, <lb xml:id="p1z10"/>quę hodie literatorum hominum calamitas est, culturus.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z11"/>Is procul dubio <persName ref="p1283">Gesnero</persName> gratior erit, si tua <lb xml:id="p1z12"/>commendatio accesserit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Est alius nomine <persName>Gwilhelmus <lb xml:id="p1z13"/>Clebizius</persName> <placeName ref="l1048">Brandenburgensis</placeName>, qui <placeName ref="l210">Heydelbergę</placeName> ob dissidium <lb xml:id="p1z14"/>cum <persName>Tilmanno</persName> quodam, impanati Christi <lb xml:id="p1z15"/>importuno defensore, ortum ecclesiastico munere <lb xml:id="p1z16"/>ad tempus privatus est, sed non nec principis <lb xml:id="p1z17"/>neve bonorum virorum benevolentia privatus.</s>
					<s n="5" xml:lang="la">Iuvenis <lb xml:id="p1z18"/>est magno ingenio et acri, eruditus et facundus <lb xml:id="p1z19"/>et <foreign xml:lang="el">ἀρτολατρίαν</foreign> inimice persequens.</s>
					<s n="6" xml:lang="la">Ex eo <lb xml:id="p1z20"/>miram narrationem rerum cum <persName>Tilmanno</persName> illo<note type="misc">korr. isto?</note> <lb xml:id="p1z21"/>gestarum audies, quam tibi eo nomine gratam <lb xml:id="p1z22"/>fore arbitror, quod ex ea intelliges principis et <lb xml:id="p1z23"/>magnorum virorum animos ad saniorem <lb xml:id="p1z24"/>et meliorem de sacramentis doctrinam non parum <lb xml:id="p1z25"/>inclinare.</s>
					<s n="7" xml:lang="la" ana="farewell">Tu vale cum omnibus fratribus <lb xml:id="p1z26"/>sacri evangelii ministris.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z27"/><persName ref="p8298">Martinus Borrhaus</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesię ecclesiasti, <lb xml:id="p2z4"/>amico et fratri suo <lb xml:id="p2z5"/>colendo.</s>
				</p>
			</div>
		</body>
	</text>
