	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Kurz vor <persName ref="p1365" cert="high">Grynäus</persName>' Tod, vgl. Anm. b.</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hos fratres<note xml:id="fn2" type="footnote" ana="bio" n="2">Einer der nicht namentlich genannten Reisenden war möglicherweise jener <persName ref="p8148">Johannes Arlius Paldinus (Spaldinus, Spalding</persName>? Name nicht zweifelsfrei lesbar), der am 27. April 1542 als Medizinstudent aus <placeName ref="l55">Bologna</placeName> an <persName ref="p495">Bullinger</persName> schrieb und dabei sowohl auf den Tod von <persName ref="p1365">Grynäus</persName> als auch auf einen nicht weit zurückliegenden Besuch in <placeName ref="l587">Zürich</placeName> zu sprechen kam (s. Zürich StA, E II 361, 121).</note> commendo vobis.</s>
					<s n="3" xml:lang="la">Colloqui vobiscum cupiunt et vos nosse.</s>
					<s n="4" xml:lang="la">Christum <lb xml:id="p1z2"/>et norunt et amant; itaque digni sunt vestro favore.</s>
					<s n="5" xml:lang="la">Pergunt <lb xml:id="p1z3"/>in <placeName ref="l834">Italiam</placeName> propter medicinę<note xml:id="fna" type="footnote" n="a"><hi>In der Vorlage</hi> mediciae.</note> studium.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale in Christo domino et <lb xml:id="p1z5"/>me ama.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale cum omnibus.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z6"/><persName ref="p1365">S. Grynęu<lb xml:id="p1z7"/>s</persName> tuus<note xml:id="fnb" type="footnote" n="b"><hi>Darunter Notiz von <persName ref="p495">Bullingers</persName> Hand:</hi> Ultimum <persName ref="p1365">Grynaei</persName> scriptum. Nam mortuus est 1. augusti anno 1541.</note><lb xml:id="p1z8"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">H. Bullinger</persName>o, <lb xml:id="p2z2"/>amico <lb xml:id="p2z3"/>et fratri charissimo.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tyguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
