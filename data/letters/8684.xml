	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p495">H[enrico] Bullingero</persName>, theologo clarissimo, <persName ref="p4087">Zvingerus</persName> <lb xml:id="p1z2"/>S.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Te salvum et incolumem reipublicae quam diutissime superesse <lb xml:id="p1z4"/>opto.</s>
					<s n="3" xml:lang="la">Misit ad me hasce <persName ref="p8118">P[etrus] Ramus</persName> <placeName ref="l378">Lutetia</placeName> <lb xml:id="p1z5"/>et, ut cito et certo ad te perferri curarentur, <lb xml:id="p1z6"/>pro amicitię iure imperavit.</s>
					<s n="4" xml:lang="la">Has mitto per civem <lb xml:id="p1z7"/>vestratem.</s>
					<s n="5" xml:lang="la">Si quid respondere voles nec compen<lb xml:id="p1z8"/>diosiore aut certiore via possis, curabo, ut prima <lb xml:id="p1z9"/>quavis occasione nostram hac in parte fidem et <lb xml:id="p1z10"/>tibi, quem meritorum nomine boni omnes colunt, <lb xml:id="p1z11"/>et <persName ref="p8118">Ramo</persName> comprobemus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute">Vale, vir clarissime, et filios <lb xml:id="p1z12"/>tuos ex me amanter saluta.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l28">Basileae</placeName> idibus <lb xml:id="p1z13"/>8bris 1571.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo theologo d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>domino suo colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
