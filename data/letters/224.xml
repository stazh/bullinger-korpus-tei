	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Accepi etiam postremum epistolium, ubi sero domum redii incertus, <lb xml:id="p1z3"/>an nuncius adhuc hic hereat; experiar tam mox.</s>
					<s n="3" xml:lang="la">Tu ora pro <lb xml:id="p1z4"/>nobis et ignosce, quod parcius scribo; nec enim possum plura, ut <lb xml:id="p1z5"/>moriar etiam.</s>
					<s n="4" xml:lang="la">Quę de consule nostro <persName ref="p7495">Gaisbergo</persName> scripsi, quod hinc <lb xml:id="p1z6"/>fugerit, sic nunc re diligentius comperta emendo, ut scias ipsum <lb xml:id="p1z7"/>facta sibi potestate demigrasse, quod langueat nec ad ullum <lb xml:id="p1z8"/>usum utilis sit; sic enim nunc affirmant nonnulli.</s>
				</p>
				<p>
					<note type="date">[Ohne Datum, Unterschrift und Adresse]</note>
					<note type="address">[Adresse:]</note>
				</p>
			</div>
		</body>
	</text>
