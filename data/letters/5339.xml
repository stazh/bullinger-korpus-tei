	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Scriberem copiosius de exitu comitiorum <lb xml:id="p1z2"/><placeName ref="l760">Salodurensium</placeName>, nisi existimarem d. a <lb xml:id="p1z3"/><persName>Scharteres</persName>, qui iis interfuit, et tibi et inprimis <lb xml:id="p1z4"/>illustrissimo principi <placeName>Condensi</placeName> iam ordine omnia <lb xml:id="p1z5"/>exposuisse.</s>
					<s n="3" xml:lang="la">Nostri iam agunt de mittenda in <lb xml:id="p1z6"/><placeName ref="l832">Galliam</placeName> legatione.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Prius tamen visum est in com<lb xml:id="p1z7"/>itiis congregatis mittendum esse ad <placeName ref="l572">Wirtembergensem</placeName> <lb xml:id="p1z8"/>et percontandum, qua via principes Germani <lb xml:id="p1z9"/>suos sint legatos missuri, si forte 5 cantonum <lb xml:id="p1z10"/>legati, nempe <placeName ref="l587">Tigurinorum</placeName>; <placeName ref="l41">Bernatum</placeName>, <placeName ref="l646">Claronensium</placeName>, <lb xml:id="p1z11"/><placeName ref="l28">Basiliensium</placeName> et <placeName ref="l441">Schaffhusianorum</placeName> illis se con<lb xml:id="p1z12"/>iungerent.</s>
					<s n="5" xml:lang="la">Ego hic maxime sol[l]icitus sum, ut qui <lb xml:id="p1z13"/>experientia doctus recordor, quantum in nostro <lb xml:id="p1z14"/>illi infelici bello ante annos 30 gesto nobis et syn<lb xml:id="p1z15"/>ceritati religionis compositores legati no<lb xml:id="p1z16"/>cuerint.</s>
					<s n="6" xml:lang="la">Quid putas tu, mi domine et frater, <lb xml:id="p1z17"/>Lutheranos legatos in religionis negotio feliciter <lb xml:id="p1z18"/>acturos?</s>
					<s n="7" xml:lang="la">Scis, quomodo in nostram doctrinam sint affecti; <lb xml:id="p1z19"/>volent omnino locum esse in <placeName ref="l832">Gallia</placeName> et confessioni <placeName ref="l18">Augustanae</placeName>, <lb xml:id="p1z20"/>ex qua ceu ex pixide <persName>Pandore</persName> scis quanta <lb xml:id="p1z21"/>sint per <placeName ref="l822">Germaniam</placeName> exorta certamina.</s>
					<s n="8" xml:lang="la">Proinde scribo <lb xml:id="p1z22"/>ad d. <persName ref="p8033">Bezam</persName> et moneo illum in tempore.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Te oro, <lb xml:id="p1z23"/>ut literas eas non tantum cures mature, sed tuum quoque <lb xml:id="p1z24"/>adiungas consilium, tuam admonitionem.</s>
					<s n="10" xml:lang="la">De nostrorum <lb xml:id="p1z25"/>pietate nihil dubito; verum scis, quid fiat <lb xml:id="p1z26"/>in tot diversissimorum et astutissimorum <lb xml:id="p1z27"/>comitiis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Foederati nostri 5 cantones tantum non <lb xml:id="p1z28"/>insaniunt contra evangelium; erumpent illi sup<lb xml:id="p1z29"/>petias allaturi <placeName>Guysianis</placeName>, monachis et pfaffis <lb xml:id="p1z30"/>neque retineri aut coherceri poterunt, si modo <lb xml:id="p1z31"/>pecuniae vel stipendia numerentur.</s>
					<s n="12" xml:lang="la">Forte urget <lb xml:id="p1z32"/>ipsos suum illud fatum.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Varii sunt apud nos rumores.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z33"/>Proinde liberabis nos sol[l]icitudine anxia, <lb xml:id="p1z34"/>si frequenter, quid in <placeName ref="l832">Gallia</placeName> fiat, scripseris aut <lb xml:id="p1z35"/>per alios scribi curaveris.</s>
					<s n="15" xml:lang="la">Nunc audimus <placeName ref="l830">Anglos</placeName> <lb xml:id="p1z36"/>milites festinare in <placeName ref="l832">Galliam</placeName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Utinam hoc verum sit <lb xml:id="p1z37"/>ac <placeName>Condensis</placeName> partes sequantur!</s>
					<s n="17" xml:lang="la">Literas tuas mense <lb xml:id="p1z38"/>hoc scriptas accepimus et maximas tibi pro his a<lb xml:id="p1z39"/>gimus gratias.</s>
					<s n="18" xml:lang="la">Prodest nos non imperitos esse rerum <lb xml:id="p1z40"/><placeName ref="l832">Gallicarum</placeName>, ut eorum possimus confutare mendatia, qui <lb xml:id="p1z41"/>impensius favent rebus pessimis.</s>
					<s n="19" xml:lang="la" ana="salute">Salutant <lb xml:id="p1z42"/>te et symmystas <persName ref="p8111">Martyr</persName> et fratres symmystae omnes; <lb xml:id="p1z43"/>saluta tu fratres quoque et symmystas omnes.</s>
					<s n="20" xml:lang="la">Dominus <lb xml:id="p1z45"/>servet te nobis diu incolumem!</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 27. maii 1562.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z46"/>Non relegi.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="salute">Salvus sit <persName ref="p4440">Budęus</persName> cum <persName ref="p8078">Jonvilleo</persName><lb xml:id="p1z47"/>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z48"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p540">Ioanni <lb xml:id="p2z2"/>Calvino</persName>, <placeName ref="l167">Genevensis</placeName> <lb xml:id="p2z3"/>ecclesiae fideli ministro, <lb xml:id="p2z4"/>domino colendissimo et fratri <lb xml:id="p2z5"/>charissimo suo.</s>
					<s n="26" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l167">Genff</placeName>.</s>
				</p>
			</div>
