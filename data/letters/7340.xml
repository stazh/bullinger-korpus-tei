	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Haec potius tibi a me scribuntur, ut duorum nunsium
					<lb xml:id="p1z2"/>silentium interrumpam, quam quia res te dignum vel etiam
					<lb xml:id="p1z3"/>mihi gratum, quod scribant, habeam, agitur apud nos
					<lb xml:id="p1z4"/>assidue de pacificatione, sed nescio quo pacto gravius
					<lb xml:id="p1z5"/>agrotamus, quam ut salutaria veincdia admittamus,
					<lb xml:id="p1z6"/>aut levioribus sisti, sedarire tanta vis morbi possit
					<lb xml:id="p1z7"/>ut qui acutiorum morbo urgantur laudam quidem pharmaca
					<lb xml:id="p1z8"/>salubrs, vix tamenster iis vesci utique animum
					<lb xml:id="p1z9"/>inaucam, sic nobis usuvenis, omnium semone pax
					<lb xml:id="p1z10"/>qs publica saudantur praedicanturque animi Classicum
					<lb xml:id="p1z11"/>ut nihil ad christianorum miserias disit,
					<lb xml:id="p1z12"/>Turca ingentis copias tirra marius comparare dicitur
					<lb xml:id="p1z13"/>scribitur ad me nihil ei cum Ienetis supeiresse dilissidi
					<lb xml:id="p1z14"/>quod si quid vestet coronatis minus centim millibus
					<lb xml:id="p1z15"/>posse, quae quidem summa perlenis est, si in seratu
					<lb xml:id="p1z16"/>agetur, ut ase in alios Turceci belli molim derivent,
					<lb xml:id="p1z17"/>Itaeque non pauci existimavi teterrimam illam Bellunam
					<lb xml:id="p1z18"/>culi melitentensibusque imminere Germani
					<lb xml:id="p1z19"/>principes equitisque quantum in eis bella Gallica
					<lb xml:id="p1z20"/>fovem aliut Turcae caetitorumque hostium securi atque
					<lb xml:id="p1z21"/>videtur.
					<lb xml:id="p1z22"/>etiam inmictiarum regis, qui ut mihi quidem minime
					<lb xml:id="p1z23"/>omnium lacessendus abalienandusm ab eis fui, si vel
					<lb xml:id="p1z24"/>officii memores fuisse vel prudentiam in consilium adhibuisse
					<pb/>
					<lb xml:id="p2z1"/>videri volunt, Caetira, quae de Gallicis Helveticai
					<lb xml:id="p2z2"/>rebus hic audimus Baltagari fido homini mihi
					<lb xml:id="p2z3"/>admodum probato communicavi mandaviqu
					<lb xml:id="p2z4"/>e tibi exponeret ac te dominumque Gvalterum
					<lb xml:id="p2z5"/>plurima salute meis verbis impertiras. deus
					<lb xml:id="p2z6"/>benignitatitu suam vobis conservet valete solodure
					<lb xml:id="p2z7"/>22. vbris 1563.
