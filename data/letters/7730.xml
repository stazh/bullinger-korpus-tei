				<p>
					<lb xml:id="p1z1"/>principium huius tractationis te Ide re sacrame pas sub 1
					<lb xml:id="p1z2"/>Concusio
					<lb xml:id="p1z3"/>episcopo
					<lb xml:id="p1z4"/>quid petatur a principe.
					<lb xml:id="p1z5"/>Cum vero princeps illustrissime hactenus
					<lb xml:id="p1z6"/>intellexeris Ihenensis non legitimio
					<lb xml:id="p1z7"/>sibi synodum postulare neque eos
					<lb xml:id="p1z8"/>legotimae synodo nos iure excludere, sum
					<lb xml:id="p1z9"/>q iniustitia nos non auditos damna
					<lb xml:id="p1z10"/>velle; Ostendimus enim cum illorum
					<lb xml:id="p1z11"/>factum pugnare cum exemplis veteris
					<lb xml:id="p1z12"/>ecclesiae Christi, tum etiam doctrina fidem
					<lb xml:id="p1z13"/>nostram nec novam esse nec haereticam, sed
					<lb xml:id="p1z14"/>veterem et orthodoxam. Praeterea cum
					<lb xml:id="p1z15"/>intellexeris, iustissimas ob causas nos va
					<lb xml:id="p1z16"/>a recepta a quibusdam confessione
					<lb xml:id="p1z17"/>Augustana quam in universum non
					<lb xml:id="p1z18"/>reiiciamus, sed in nonnullis dumtaxat
					<lb xml:id="p1z19"/>qui non possimus, simul autem nos conce
					<lb xml:id="p1z20"/>ordiae quantum fieri potest, studere nunc
					<lb xml:id="p1z21"/>et studuisse semper, atque ideo legitimos
					<lb xml:id="p1z22"/>congressus, in quibus sub spe aliqua et non
					<lb xml:id="p1z23"/>cum detremento maiore causae religione
					<lb xml:id="p1z24"/>controversae discutiantur nec reforman
					<lb xml:id="p1z25"/>idare nec refugere, oramus tuam
					<lb xml:id="p1z26"/>pietatem, princeps illustrissime, orav
					<lb xml:id="p1z27"/>et alios principes christianos per ipsum
					<lb xml:id="p1z28"/>Christum dominum, ut in hoc fideliter laboris
					<lb xml:id="p1z29"/>Anfang.
					<lb xml:id="p1z30"/>3450 Ib, qibus aculriatur bonu
					<lb xml:id="p1z31"/>ninitiae. Et
					<lb xml:id="p1z32"/>gulalten fie Chrin
					<lb xml:id="p1z33"/>mdera
					<lb xml:id="p1z34"/>hic to ar ass.
					<lb xml:id="p1z35"/>fillan.
					<lb xml:id="p1z36"/>du
					<pb/>
					<lb xml:id="p2z1"/>velitis, ne illegittima aliqua
					<lb xml:id="p2z2"/>scribatur syngdus, ex qua non modo
					<lb xml:id="p2z3"/>cludamur, sed etiam non auditi conder
					<lb xml:id="p2z4"/>emur maioresque turbae inter eos, qu
					<lb xml:id="p2z5"/>evangelium praedicant exoriantur, denique ne
					<lb xml:id="p2z6"/>adversariis nostris id perpetuo concedat
					<lb xml:id="p2z7"/>quod hactenus apud multos eis datum
					<lb xml:id="p2z8"/>audimus, ne videlicet libri nostri divent
					<lb xml:id="p2z9"/>leganter ac iudicentur. Ita enim
					<lb xml:id="p2z10"/>testes innocentiae nostrae contra ius et
					<lb xml:id="p2z11"/>phanon admittuntur, neque audiuntur et fert
					<lb xml:id="p2z12"/>contra nos iudicium caecum, ut ne quid
					<lb xml:id="p2z13"/>durius dicamus. Apud nos certe libro
					<lb xml:id="p2z14"/>ipsorum distrahuntur ac nos ipsi hortam
					<lb xml:id="p2z15"/>nostros, ut illos legant et ex collationei
					<lb xml:id="p2z16"/>dicent vincatque in omnibus voritas
					<lb xml:id="p2z17"/>Quod si omnino spes nulla affulget
					<lb xml:id="p2z18"/>fore, ut tranquilla et frugifera collatu,
					<lb xml:id="p2z19"/>fiat aut ut a concepto contra nos odio
					<lb xml:id="p2z20"/>et furore discedant, praestaret, saltem prii
					<lb xml:id="p2z21"/>et magistratus christianos prosut
					<lb xml:id="p2z22"/>authoritate suoque officio prohibere in
					<lb xml:id="p2z23"/>portunas illas in cathedris sacris de
					<lb xml:id="p2z24"/>bachationes et libellos illos furiosos
					<lb xml:id="p2z25"/>convitiisque exundantes cohercere eto
					<lb xml:id="p2z26"/>privere, Cum alioqui multa eaque ma
					<pb/>
					<lb xml:id="p3z1"/>k
					<lb xml:id="p3z2"/>necessaria sint, quae doceri et populo pr
					<lb xml:id="p3z3"/>oniqueant, maiori, cum plebis miserae
					<lb xml:id="p3z4"/>emolumento et nimori cum infirmori
					<lb xml:id="p3z5"/>scandalo. Dudum certe haec a nobis
					<lb xml:id="p3z6"/>petrata et observata norunt, qui nostras
					<lb xml:id="p3z7"/>conciones sacras praelectionesque audiunt
					<lb xml:id="p3z8"/>Docemus fidem et pietatem poenitentem
					<lb xml:id="p3z9"/>et remissionem peccatorum eaque per
					<lb xml:id="p3z10"/>dei gratiam proponimus, quae populum Christi
					<lb xml:id="p3z11"/>aedificare possunt. Refutamus item argumenti
					<lb xml:id="p3z12"/>mentis scripturae non conitiis, errores
					<lb xml:id="p3z13"/>superstitiones scelera et haereses. Si quiando
					<lb xml:id="p3z14"/>discutienda sunt aut explicanda controvera
					<lb xml:id="p3z15"/>inter nos dogmata, praeteritis authoribus
					<lb xml:id="p3z16"/>et omissis convitiis rem rationibus modeste tra
					<lb xml:id="p3z17"/>Per caetera Lutheri piae memo
					<lb xml:id="p3z18"/>suorumque, nunquam nisi honorificami faci
					<lb xml:id="p3z19"/>mentionem, neque hanc voluptatem
					<lb xml:id="p3z20"/>omnnibus hostibus nostris, quam capian
					<lb xml:id="p3z21"/>ex nostra dissensione mutuisque crimin
					<lb xml:id="p3z22"/>enotionibus, exhibemus, quam isti illis
					<lb xml:id="p3z23"/>propinare nunquam fere desinunt.
					<lb xml:id="p3z24"/>Haecautem omnia simplici animo tuae
					<lb xml:id="p3z25"/>pietati illustrissimu princeps proposita, ora
					<lb xml:id="p3z26"/>benigne accipias, nosque tibi comm
					<lb xml:id="p3z27"/>cmendatos habeas, imprimis vero causam
					<lb xml:id="p3z28"/>veritatis et ecclesiarum incolumitate
					<pb/>
					<lb xml:id="p4z1"/>tranquillitateque iuves pro virilii
					<lb xml:id="p4z2"/>Dominus Iesus concedat tibi illustrissimo
					<lb xml:id="p4z3"/>princeps spiritum principalem
					<lb xml:id="p4z4"/>augeat hunc atque confirmet in te ac serv
					<lb xml:id="p4z5"/>te cum omnibus tuis semper
					<lb xml:id="p4z6"/>columem. Datae <placeName ref="l587">Tiguri</placeName> Mense ai
					<lb xml:id="p4z7"/>agusto anno salutis nostrae 13.
					<lb xml:id="p4z8"/>Illustrissimo pie
					<lb xml:id="p4z9"/>tuae
					<lb xml:id="p4z10"/>dediti
					<lb xml:id="p4z11"/>pastores prędi
					<lb xml:id="p4z12"/>cecatoresque et pro
					<lb xml:id="p4z13"/>fessores minim
					<lb xml:id="p4z14"/>Tigurinae
					<lb xml:id="p4z15"/>ecclesiae
