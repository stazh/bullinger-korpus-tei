	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Reverende in Christo pater, cum tam certum haberem hominem, <lb xml:id="p1z2"/>qui tuas mihi reddidisset, committere non potui, quin <lb xml:id="p1z3"/>brevibus saltem te edocerem <persName>Lampertum</persName> illum, de quo scribis <lb xml:id="p1z4"/>iam non esse ad urbem; itaque ea, quae cupis, expedire <lb xml:id="p1z5"/>non potui; sed quam primum redierit, in id negocium in<lb xml:id="p1z6"/>quiram.</s>
					<s n="3" xml:lang="la">De rebus <placeName ref="l834">Italicis</placeName> nihil certi habeo.</s>
					<s n="4" xml:lang="la">Spero <lb xml:id="p1z7"/>tibi binas meas redditas.</s>
					<s n="5" xml:lang="la"><foreign xml:lang="de">Ich han by des Nülen sun, <lb xml:id="p1z8"/>dem <persName>Hans Nülen</persName>, üch die letsten zuͦgeschickt</foreign> et omnino <lb xml:id="p1z9"/>puto redditas, cum multum intersit te ea scire, quae scribuntur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Hodie hic fuerunt nobiscum nonnulli ministri ecclesiarum <lb xml:id="p1z11"/>10 Iurisdictionum a nobis evocati.</s>
					<s n="7" xml:lang="la">Qui affirmant, quae a <lb xml:id="p1z12"/>legatis in commitiis in gratiam <placeName ref="l2448">Quinquepagicorum</placeName> essent facta, <lb xml:id="p1z13"/>insciis communitatibus fieri.</s>
					<s n="8" xml:lang="la">Itaque ego spero multos bonos <lb xml:id="p1z14"/>posse melius instrui; ad hoc totum plurimum momenti <lb xml:id="p1z15"/>afferret, si <placeName ref="l587">Tigurini</placeName> et reliqui modeste scriberent, de <lb xml:id="p1z16"/>quo ante quoque ad te scripsi.</s>
					<s n="9" xml:lang="la">Cum ruina nostra cum vestro <lb xml:id="p1z17"/>malo sit coniuncta, non negligenter hoc totum negotium <lb xml:id="p1z18"/>est administrandum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">De rebus <placeName ref="l522">Venetis</placeName> proxime <lb xml:id="p1z19"/>te edocui.</s>
					<s n="11" xml:lang="la">Ex <placeName ref="l822">Germania</placeName> nos nihil, sed nec ex <lb xml:id="p1z20"/><placeName ref="l832">Gallia</placeName>.</s>
					<s n="12" xml:lang="la">Quid <placeName ref="l18">Augustę</placeName> fiat et in <placeName ref="l832">Gallia</placeName>, ex te <lb xml:id="p1z21"/>scire avemus.</s>
					<s n="13" xml:lang="la">Scripserat <persName ref="p252">Bäldius</persName> pacem inter <persName ref="p8282">Maxim<lb xml:id="p1z22"/>ilianum</persName> et <placeName ref="l2510">Turcam</placeName> esse confectam; sed <placeName ref="l28">Basilea</placeName> diversum <lb xml:id="p1z23"/>scribitur.</s>
					<s n="14" xml:lang="la">Tu nos verum edoce, si per occupationes licet.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z24"/>Qui Venetiis veniunt, de longe maximo <placeName>Turcę</placeName> apparat<lb xml:id="p1z25"/>u nunciant.</s>
					<s n="16" xml:lang="la" ana="farewell">Vale, reverende in Christo pater.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z26"/><placeName ref="l98">Curię</placeName> 15. februarii anno 1566.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z27"/>Tui observantissimus <lb xml:id="p1z28"/><persName ref="p8009">Ioa[nnes] Fab[ricius</persName>].</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, domino <lb xml:id="p2z3"/>suo et in Christo patri <lb xml:id="p2z4"/>reverendo.</s>
					<s n="20" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName> an herren <persName ref="p495">Bullinger</persName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>