	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Miror te rarius ad me scribere, mi <lb xml:id="p1z2"/>compater, sed destitueris forte argumento <lb xml:id="p1z3"/>neque vis me alioqui occupatum tuis onerare <lb xml:id="p1z4"/>distrahereque literis; sed his scias nullam <lb xml:id="p1z5"/>te mihi molestiam exhibere.</s>
					<s n="3" xml:lang="la">Varia de <lb xml:id="p1z6"/>dissidiis Rhetorum sparguntur.</s>
					<s n="4" xml:lang="la">Infelicia dicuntur <lb xml:id="p1z7"/>de regis in <placeName ref="l994">Neapoli</placeName> exercitu, sed forte <lb xml:id="p1z8"/>felicissima; ita enim rex discet agnoscere <lb xml:id="p1z9"/>sana consilia et sibi cavere a proditore regum et <lb xml:id="p1z10"/>imperat[orum].</s>
					<s n="5" xml:lang="la">en, habes <lb xml:id="p1z11"/>m<lb xml:id="p1z12"/>ateriam scribendi.</s>
					<s n="6" xml:lang="la">Utinam valeas una <lb xml:id="p1z13"/>cum uxore, liberis et viris bonis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/><placeName ref="l587">Tiguri</placeName> 21. iunii 1557.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="9" xml:lang="la">Ornatissimo viro d. <lb xml:id="p2z2"/><persName ref="p8009">Ioanni Fabritio</persName>, <placeName ref="l98">Curiae</placeName> <lb xml:id="p2z3"/><placeName ref="l98">Rhetorum</placeName> evangelium <lb xml:id="p2z4"/>praedicanti, com<lb xml:id="p2z5"/>patri et fratri suo charissimo<lb xml:id="p2z6"/>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
