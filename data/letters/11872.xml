	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Ego diligentiam tuam <lb xml:id="p1z2"/>laudo, quam in negotio <persName ref="p7197">Zolleri</persName>, iuvenis a me <lb xml:id="p1z3"/>tibi iniuncto, fideliter praestitisti<note xml:id="fn1" type="footnote" n="1">Vgl. oben <ref target="file11839">Nr. 1793</ref>, 2-13; 1806, 2-30.</note>.</s>
					<s n="3" xml:lang="la">Dominus rependat <lb xml:id="p1z4"/>tibi.</s>
					<s n="4" xml:lang="la">Quod non successit, ita nimirum fuit domini <lb xml:id="p1z5"/>voluntas.</s>
					<s n="5" xml:lang="la">Applicuit interim animum adolescens <lb xml:id="p1z6"/>ad mercaturam.</s>
					<s n="6" xml:lang="la">Utinam illi faustum sit et salutare!</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z7"/>Plus id quidem probo quam vitam aulicam.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Polliceor <lb xml:id="p1z8"/>autem pro illa tua fide me totum, et quod pari <lb xml:id="p1z9"/>fide nec impari diligentia id quoque curaturus <lb xml:id="p1z10"/>sim, quod rerum tuarum mihi iniunxerim.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Uti<lb xml:id="p1z11"/>nam vero videam aliquando <persName ref="p1010">Erbium</persName> <placeName ref="l587">Tiguri</placeName>!</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z12"/>Magna spes praeterito autumno detinebat multos <lb xml:id="p1z13"/>nostrorum, fore, ut tunc frueremur fratre exoptatis<lb xml:id="p1z14"/>simo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Quoniam vero id tunc non obtigit, <lb xml:id="p1z15"/>age, obveniat quando tibi fuerit opportunum, <lb xml:id="p1z16"/>quanto tum citius, tanto gratius.<pb type="edition" next="339"/></s>
				</p>
				<p>
					<s n="12" xml:lang="la">Porro rem fecisti <lb xml:id="p1z17"/>longe gratissimam, qui mihi apographum epistolae <lb xml:id="p1z18"/>d. <persName ref="p6211">Beati Rhenani</persName>, viri undiquaque doctissimi et <lb xml:id="p1z19"/>mihi ab annis multis colendissimi, miseris<note xml:id="fn2" type="footnote" n="2"><persName ref="p1010">Erb</persName> hatte <persName ref="p495">Bullinger</persName> eine Kopie eines Briefes von <persName ref="p6211">Beatus Rhenanus</persName> übersandt, den dieser am 29. Juli an <persName ref="p1010">Erb</persName> gerichtet hatte (<bibl source="b539">Rhenanus BW</bibl> 496-502, Nr. 368; vgl. oben <ref target="file11852">Nr. 1806</ref>, 64-73).</note>.</s>
					<s n="13" xml:lang="la">Neque <lb xml:id="p1z20"/>enim vivit hodie inter eruditos ullus alius, <lb xml:id="p1z21"/>quem, cum nunquam viderim, amem et colam tam <lb xml:id="p1z22"/>reverenter.</s>
					<s n="14" xml:lang="la">Dominus illum nobis diu servet incolumem et <lb xml:id="p1z23"/>reliqua antiquitatum Germaniae, <lb xml:id="p1z25"/>patriae dulcissimae, per hunc nobis eruat<note xml:id="fn3" type="footnote" n="3"><persName ref="p495">Bullinger</persName> hat <persName ref="p6211">Rhenanus</persName>' historische Arbeit im Blick, deren Früchte sich im Werk "Rerum Germanicarum libri tres", <placeName ref="l28">Basel</placeName> (Offizin <persName ref="p8353">Froben</persName>) 1531 <bibl source="https://gateway-bayern.de/VD16+R+2064">(VD 16 R 2064)</bibl> niederschlugen.</note>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z26"/>Nova nos habemus nulla, nisi quod milites <lb xml:id="p1z27"/><placeName ref="l862">Helvetiorum</placeName>, foederatorum nostrorum, superioribus <lb xml:id="p1z28"/>diebus e bello <placeName ref="l808">Belgico</placeName> redierunt<note xml:id="fn4" type="footnote" n="4">Vgl. oben <ref target="file11869">Nr. 1823</ref>, 10f.</note>.</s>
					<s n="16" xml:lang="la">Rem feceris <lb xml:id="p1z29"/>non ingratam, si communicaveris ea, quae <lb xml:id="p1z30"/>certa fide ad te de comitiis <placeName ref="l471">Spirensibus</placeName> allata <lb xml:id="p1z31"/>fuerint<note xml:id="fn5" type="footnote" n="5">Vgl. oben <ref target="file11852">Nr. 1806</ref>, 31-35.</note>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Valemus hic omnes ministri et maxima nos <lb xml:id="p1z32"/>mutuo<note xml:id="fna" type="footnote" n="a">mutuo <hi>am Rande nachgetragen.</hi></note> complectimur charitate.</s>
					<s n="18" xml:lang="la">Procedit religionis <lb xml:id="p1z33"/>negotium, et summa est inter nos, deo gratiae, <lb xml:id="p1z34"/>concordia.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Id ut nobis iuge sit et perpetuum, pro <lb xml:id="p1z35"/>nobis, quaeso, ora dominum.</s>
					<s n="20" xml:lang="la">Salvi sint fratres o<lb xml:id="p1z36"/>mnes in domino.</s>
					<s n="21" xml:lang="la" ana="salute">Salutant te d. <persName ref="p8412">Megander</persName>, <lb xml:id="p1z37"/><persName ref="p8437">Fabritius</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p8437">Erasmus Schmid</persName>.</note>, <persName ref="p8127">Pelicanus</persName>, <persName ref="p8171">Bibliander</persName>, <persName ref="p8011">Gvaltherus</persName> <lb xml:id="p1z38"/>ac reliqui omnes.</s>
					<s n="22" xml:lang="la" ana="farewell">Vale in domino.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 8. <lb xml:id="p1z39"/>decembris anno 1543.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z41"/><persName ref="p495">H. Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p1010">Matthiae Erbio</persName>, pastori <lb xml:id="p2z3"/><placeName ref="l411">Rychenvilae</placeName>, <lb xml:id="p2z4"/>fratri charissimo.</s>
				</p>
			</div>
