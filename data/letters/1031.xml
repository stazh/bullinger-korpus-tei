	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S. D.</s>
					<s n="2" xml:lang="la">Qui has reddit, compater in domino <lb xml:id="p1z3"/>charissime, significavit se <placeName ref="l587">Tigurum</placeName> iturum; si quid <lb xml:id="p1z4"/>illo scribere vellem, paratum se esse <lb xml:id="p1z5"/>ad hoc, quicquid sit, officii praestandum, <lb xml:id="p1z6"/>ut literas reddat.</s>
					<s n="3" xml:lang="la">Quanquam igitur nihil <lb xml:id="p1z7"/>sit, quod necessario scribam, nolui <lb xml:id="p1z8"/>tamen occasionem negligere, qua literas <lb xml:id="p1z9"/>abs te possum, si quid sit, quod scribere <lb xml:id="p1z10"/>velis, commode recipere.</s>
					<s n="4" xml:lang="la">Oro autem, ut, <lb xml:id="p1z11"/>si quid ex <placeName ref="l18">Augusta</placeName> habueris, paucis <lb xml:id="p1z12"/>significes.</s>
					<s n="5" xml:lang="la">Hodie retulit mihi filius <lb xml:id="p1z13"/>Apiarii detineri quasdam literas nomini <lb xml:id="p1z14"/>meo inscriptas <placeName ref="l28">Basileę</placeName> in officina <lb xml:id="p1z15"/>Episcopii a typographo quodam, qui <lb xml:id="p1z16"/>illas <placeName ref="l18">Augustę</placeName> mihi reddendas acceperit.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z17"/>Quodsi in illis, ubi allatę fuerint, <lb xml:id="p1z18"/>quicquam deprehendero, quod dignum sit <lb xml:id="p1z19"/>tua cognitione, curabo, ut scias.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z20"/>Caeterum domi meę pacata sunt adhuc <lb xml:id="p1z21"/>omnia, nisi quod uxor mire tristis <lb xml:id="p1z22"/>et anxia eam est ob causam, quod <lb xml:id="p1z23"/>nostra hic insumimus, quę liberis et <lb xml:id="p1z24"/>ipsi servanda putaverit.</s>
					<s n="8" xml:lang="la">Verum quid <lb xml:id="p1z25"/>faciam?</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Polliceor illi dominum tandem etiam <lb xml:id="p1z26"/>hoc incommodum sublaturum; sed subinde <lb xml:id="p1z27"/>parum proficio, quę res me non leviter <lb xml:id="p1z28"/>fatigat.</s>
					<s n="10" xml:lang="la">Ora dominum, ut infirmi vasculi <lb xml:id="p1z29"/>rationem habere dignetur.</s>
					<s n="11" xml:lang="la" ana="salute">Saluta nostro omnium <lb xml:id="p1z30"/>nomine honestissimam tuam uxorem una cum <lb xml:id="p1z31"/>liberis, item dominos ac fratres omnes, d. <persName ref="p8127">Pellicanum</persName>, <lb xml:id="p1z32"/>d. <persName ref="p8171">Theodorum Bibliandrum</persName> et d. <persName ref="p8011">Rodolphum</persName> <lb xml:id="p1z33"/>et amicum nostrum d. <persName ref="p506">Butlerum</persName>.</s>
					<s n="12" xml:lang="la"><placeName ref="l41">Bernę</placeName> <lb xml:id="p1z34"/>ultima septembris 1550.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z35"/><persName ref="p8417">W[olfgangus] Musc[ulus]</persName>, compater tuus <lb xml:id="p1z36"/>in domino.</s>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo domino <lb xml:id="p2z3"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z5"/>ecclesię antistiti <lb xml:id="p2z6"/>vigilantissimo, <lb xml:id="p2z7"/>domino ac compatri c<lb xml:id="p2z8"/>harissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
