	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l491">Argen<lb xml:id="p1z2"/>ti[nae]</placeName> 14. februarii.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>S. D.</s>
					<s n="3" xml:lang="la" ana="salute">Licet tibi non vacet, doctissime vir, in meis nugis perlegendis <lb xml:id="p1z4"/>immorari, cum tamen essent mihi istae literae (quas a fratribus <placeName ref="l157">Franckford[iensib<lb xml:id="p1z5"/>us]</placeName> accepi) papiro involvendae, volui tamen, ut vacua ista papirus, vel <lb xml:id="p1z6"/>pro meo officio erga te, salutem tibi diceret.</s>
					<s n="4" xml:lang="la">Sermo tuus diu iam <lb xml:id="p1z7"/>versatus est inter <placeName ref="l830">Anglos</placeName> <placeName ref="l830">Anglus</placeName>, <placeName ref="l830">Anglis</placeName> certe non ingratus, ut audio.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Adhuc miseram patitur persequutionem afflictus Christi grex; nam 27 ianuarii, <lb xml:id="p1z9"/><placeName ref="l296">Londini</placeName>, sunt septem igne absumpti, eodemque die <placeName>Cantuariae</placeName> quinque.</s>
					<s n="6" xml:lang="la">Haec <lb xml:id="p1z10"/>illa potestas est tenebrarum.</s>
					<s n="7" xml:lang="la"><persName>Hethus</persName> <placeName ref="l574">Eboracensis</placeName> obtinet officium <lb xml:id="p1z11"/>cancellarii.</s>
					<s n="8" xml:lang="la"><persName>Whitus</persName> <placeName ref="l1754">Lincolniensis</placeName> nunc factus est <placeName ref="l553">Vintoniensis</placeName> episcopus<lb xml:id="p1z12"/>.</s>
					<s n="9" xml:lang="la">Penelope languens reditum sui <persName>Ulixis</persName> expectat; ille vero <placeName ref="l15">Antverpiae</placeName> <lb xml:id="p1z13"/>pro fausto adepto ducatu orgia Bacchi celebrat.</s>
					<s n="10" xml:lang="la">Incderta referuntur <lb xml:id="p1z14"/>de induciis <persName>Philippi</persName> et <persName>Galli</persName>, sed horrenda de illius choreis, nocturnis <lb xml:id="p1z15"/>ludicris, virginumque raptu, quibus nunc se <placeName ref="l15">Antverpiae</placeName> totum dedit.</s>
					<s n="11" xml:lang="la">Aderit <lb xml:id="p1z16"/>tandem deus iudex et vindex, cui tu supplices manus pro <placeName ref="l830">Anglia</placeName> <lb xml:id="p1z17"/>ad lassitudinem usque cum Mose extende.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale, pater optime.</s>
					<s n="13" xml:lang="la" ana="salute">Saluta, <lb xml:id="p1z18"/>quęso, optimum et <placeName ref="l830">Anglorum</placeName> etiam amantissimum dominum <persName ref="p8011">Gualterum</persName>.</s>
					<s n="14" xml:lang="la">Deus optimus maximus <lb xml:id="p1z19"/>vobis omnibus rependat.</s>
					<s n="15" xml:lang="la">Ego iam sub manibus habeo illius Antichristum, <lb xml:id="p1z20"/>ut <placeName ref="l830">Angli</placeName> epitomen illius libri videant papam Anglice salutantem.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell"><lb xml:id="p1z21"/>Iterum vale foelicissimeque in Christo vive.</s>
					<s n="17" xml:lang="la">Tuus <persName ref="p2866">Thomas Sampson<lb xml:id="p1z22"/>us</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z23"/>Si quid aliud habet d. <persName ref="p8011">Gualterus</persName>, quod intersertum nostro operi Antichristi illud possit <lb xml:id="p1z24"/>promovere, rem longe gratissimam faciet nostraeque ecclesiae utilissimam, si <lb xml:id="p1z25"/>velit illud ad me mittere, sin minus, Antichristum illius, ut est, licet paulo <lb xml:id="p1z26"/>contractius, evulgabo deo favente.</s>
					<s n="19" xml:lang="la" ana="farewell">Iam tertio vale.</s>
					<s n="20" xml:lang="la">Raptim.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>.</s>
					<s n="22" xml:lang="la"><placeName ref="l587">Tyguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
