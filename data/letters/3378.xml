	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissimo viro d. <persName ref="p540">Ioanni Calvino</persName> <placeName ref="l167">Genevensis</placeName> ecclesiae pastori domino suo colendissimo et fratri charissimo.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">S. <lb xml:id="p1z2"/>D.</s>
					<s n="3" xml:lang="la">Hodie literas tuas accipio, colendissime mi <persName ref="p540">Calvine</persName>, simul etiam hic <persName ref="p8453">Zacharias</persName><note xml:id="fn1" type="footnote" n="1">Ursinus.</note> <placeName ref="l66">Vratislaviensis</placeName> <lb xml:id="p1z3"/>indicat, se cras mane abiturum.</s>
					<s n="4" xml:lang="la">Cogor itaque brevibus ad tuas <lb xml:id="p1z4"/>respondere.</s>
					<s n="5" xml:lang="la">Audies aliquando non suspitionem vanam <lb xml:id="p1z5"/>fuisse quam conceperamus ex deposita fratrum apud principes <lb xml:id="p1z6"/>confessione.</s>
					<s n="6" xml:lang="la">Metuimus enim illa adversarios nostros <lb xml:id="p1z7"/>aliquando liberius usuros quam velimus.</s>
					<s n="7" xml:lang="la">Quid scripserit <lb xml:id="p1z8"/>d. <persName ref="p8011">Gvaltherus</persName> nescio, neque cum ipso ea de re contuli.</s>
					<s n="8" xml:lang="la">Et quod <lb xml:id="p1z9"/>antea scripsi id nunc repeto, nobis ministris non licere <lb xml:id="p1z10"/>non consulto magistratu in ullum colloquium consentire.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z11"/>Oportebit eam rem prius cum eo conferre.</s>
					<s n="10" xml:lang="la">Nam is quoque <lb xml:id="p1z12"/>insciis nobis nihil prorsus agit in ecclesiae et religionis <lb xml:id="p1z13"/>negotiis.</s>
					<s n="11" xml:lang="la">Pro literis <persName>Philippi</persName> communicatis maximas <lb xml:id="p1z14"/>ago gratias, quas et nunc remitto.</s>
					<s n="12" xml:lang="la">Communico vicissim quod <lb xml:id="p1z15"/>accepi ab ipso hodie: "Reverende vir et charissime frater.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z16"/>Cum non perfecissent nostri collegae ut condemnationem ves<lb xml:id="p1z17"/>trarum ecclesiarum comprobaremus, seiunxerunt se a nobis <lb xml:id="p1z18"/>et eam privatim exhibuerunt <foreign xml:lang="el">τῷ βραβευτῇ</foreign> Iulio, a quo <lb xml:id="p1z19"/>petiverunt ut publice in consessu recitaretur.</s>
					<s n="14" xml:lang="la">Fuit autem <lb xml:id="p1z20"/>ea moderatio <foreign xml:lang="el">τοῦ βραβευτοῦ</foreign> ut recitari eam in consessu <lb xml:id="p1z21"/>noluerit.</s>
					<s n="15" xml:lang="la">Postea hinc illi discesserunt.</s>
					<s n="16" xml:lang="la">Nunc igitur an in<lb xml:id="p1z22"/>choata collatio processura sit, dubitamus.</s>
					<s n="17" xml:lang="la">Quicunque autem <lb xml:id="p1z23"/>eventus erit, spero sapientes viros nostram contationem <lb xml:id="p1z24"/>non improbaturos esse, quod noluimus statim re non dis<lb xml:id="p1z25"/>putata nec explicata confirmare pontificum idola et <lb xml:id="p1z26"/>parricidia.</s>
					<s n="18" xml:lang="la">Sed precor filium dei ut nos gubernet.</s>
					<s n="19" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z27"/>et feliciter vale.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Die 5. octobris.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="salute">Salutem opto vobis omni<lb xml:id="p1z28"/>bus ac nominatim <persName ref="p8111">Petro Martyri</persName> et <persName ref="p8101">Laelio</persName>."</s>
					<s n="22" xml:lang="la" ana="salute">Has <lb xml:id="p1z29"/>eius literas bona fide descriptas attulerunt studiosi nostri <lb xml:id="p1z30"/>qui <placeName>Martburgo</placeName> redeuntes <placeName ref="l569">Wormatiae</placeName> <persName>Philippum</persName> salutarunt <lb xml:id="p1z31"/>et has ab eo ad me perferendas acceperunt.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Proinde non <lb xml:id="p1z32"/>spero ullum inter nos porro instituendum colloquium, nisi <lb xml:id="p1z33"/><persName>Philippus</persName> <placeName ref="l491">Argentinam</placeName> venerit.</s>
					<s n="24" xml:lang="la">Conditiones apud nos <lb xml:id="p1z34"/>plane nullae sunt vacantes.</s>
					<s n="25" xml:lang="la">Si qua aliquando vacet <lb xml:id="p1z35"/>decem sunt competitores.</s>
					<s n="26" xml:lang="la">Interim propter tuam et <persName>Philippi</persName> <lb xml:id="p1z36"/>commendationem dabitur viro optimo subsidium ad tempus, <lb xml:id="p1z37"/>si hic haerere voluerit.</s>
					<s n="27" xml:lang="la">Magna est copia <lb xml:id="p1z38"/>apud nos pauperum studiosorum.</s>
					<s n="28" xml:lang="la">D. <persName ref="p4183">Iacobi Andreae</persName> <lb xml:id="p1z39"/>librum cum hactenus legere non potueris, quod <lb xml:id="p1z40"/>Germanice scriptus sit, potissima eius hic mitto a <lb xml:id="p1z41"/>me versa ex <placeName ref="l822">Germanico</placeName> in gratiam d. <persName ref="p8111">Martyris</persName>: <lb xml:id="p1z43"/>oro autem ut per primum nuncium forte <lb xml:id="p1z44"/>oblatum illa mihi remittas.</s>
					<s n="29" xml:lang="la">Literas eas legere <lb xml:id="p1z45"/>non potui, eas puto quas communicasti, quas <lb xml:id="p1z46"/>libenter nunc quoque remitterem, nisi in turbis <lb xml:id="p1z47"/>negotiorum quo posuerim prorsus ignorarem.</s>
					<s n="30" xml:lang="la">Ubi <lb xml:id="p1z48"/>rursus invenero, mittam ad te certo.</s>
					<s n="31" xml:lang="la"><persName ref="p8453">Zachariam</persName> <pb/><lb xml:id="p2z1"/>autem hunc singulariter tibi commendo.</s>
					<s n="32" xml:lang="la"><placeName ref="l66">Vra<lb xml:id="p2z2"/>tislaviensis</placeName> est.</s>
					<s n="33" xml:lang="la">Venit ad nos <placeName ref="l28">Basilaea</placeName> commendatus <lb xml:id="p2z3"/>mihi per <persName>Hermannum Pinzingerum</persName>, qui asserit illum <persName>Philippi</persName> <lb xml:id="p2z4"/>esse intimum.</s>
					<s n="34" xml:lang="la">Venit te salutaturus et visurus <lb xml:id="p2z5"/><placeName ref="l167">Genevensem</placeName> ecclesiam.</s>
					<s n="35" xml:lang="la" ana="farewell">Vive et vale.</s>
					<s n="36" xml:lang="la" ana="salute">Nostri omnes <lb xml:id="p2z6"/>te salutant.</s>
					<s n="37" xml:lang="la" ana="salute">Saluta tu symmystas omnes.</s>
				</p>
				<p>
					<s n="38" xml:lang="la" ana="salute">Saluta <lb xml:id="p2z7"/>item d. <persName ref="p8078">Ionvillaeum</persName> et <persName ref="p4227">Badium</persName> et <persName>Normandium</persName> <lb xml:id="p2z8"/>et reliquos fratres, <persName ref="p4440">Budaeum</persName> quoque si rediit.</s>
					<s n="39" xml:lang="la">Gratulor <lb xml:id="p2z9"/>mihi plurimum quod inscriptionem operis nostri <lb xml:id="p2z10"/>Apoc.</s>
					<s n="40" xml:lang="la">tam bene collocaverim.</s>
				</p>
				<p>
					<s n="41" xml:lang="la">Pluris facio bene<lb xml:id="p2z11"/>volentiam et tuam et fratrum <placeName ref="l834">Italicae</placeName>, <placeName ref="l832">Gallicae</placeName>, <placeName ref="l830">Angli<lb xml:id="p2z12"/>canaeque</placeName> ecclesiae quam multa auri talenta etc.</s>
					<s n="42" xml:lang="la">Tu <lb xml:id="p2z13"/>me illis commendabis.</s>
				</p>
				<p>
					<s n="43" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 26. octobris 1557.</s>
				</p>
				<p>
					<s n="44" xml:lang="la"><lb xml:id="p2z14"/>Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>