	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsissem sane frequentius hactenus, nisi ma<lb xml:id="p1z2"/>teria simul ac nuncii defuissent.</s>
					<s n="3" xml:lang="la">In Iudoci lo<lb xml:id="p1z3"/>cum nullus dum est subrogatus; abfuere enim <lb xml:id="p1z4"/>plęrique senatorum, qui ad nundinas nunc sunt <lb xml:id="p1z5"/>reversi.</s>
					<s n="4" xml:lang="la">Itaque spero proxima septimana alium fore <lb xml:id="p1z6"/>eligendum.</s>
					<s n="5" xml:lang="la">Senatui praeter <persName ref="p8417">Musculum</persName> nullum <lb xml:id="p1z7"/>statuemus; non enim est alius, qui ipsi comparari ne<lb xml:id="p1z8"/>dum praeferri possit.</s>
					<s n="6" xml:lang="la">Hoc unum metuo, ne <lb xml:id="p1z9"/>non ab omnibus approbetur, quia peregrinus est; sed <lb xml:id="p1z10"/>si is domino placebit, dabit illum nobis; sin minus, <lb xml:id="p1z11"/>fiat voluntas domini.</s>
					<s n="7" xml:lang="la">Ego hoc agam, ut iure <lb xml:id="p1z12"/>nemo me contentiosum dicere queat; interea <lb xml:id="p1z13"/>tamen de veritate ne latum quidem culmen.</s>
					<s n="8" xml:lang="la">Diaconus <lb xml:id="p1z14"/>si substituatur, nihil nisi contentiones habebimus.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>Sed libere senatum praemonere constitui, ut <lb xml:id="p1z16"/>meam simul fidem et conscientiam liberem.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z17"/>Te scio nobiscum oraturum ad dominum, ut foelicem <lb xml:id="p1z18"/>det successum.</s>
					<s n="11" xml:lang="la">Ubi transactum fuerit negotium, <lb xml:id="p1z19"/>scribam illico.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z20"/>Quod res novas attinet, <lb xml:id="p1z21"/>neque nos habemus quicquam certi.</s>
					<s n="13" xml:lang="la">Marchionem alii <lb xml:id="p1z22"/>ad Caesarem defecisse affirmant, alii in <placeName ref="l632">Alsatiam</placeName> <lb xml:id="p1z23"/>ipsum pro rege ducere exercitum.</s>
					<s n="14" xml:lang="la"><placeName ref="l631">Burgundi</placeName> <lb xml:id="p1z24"/>metuunt sibi, cum quibus nostri nescio quid <lb xml:id="p1z25"/>colludunt.</s>
					<s n="15" xml:lang="la">Fuere hic <placeName ref="l160">Friburgensium</placeName> et <placeName ref="l760">Solodorensium</placeName> <lb xml:id="p1z26"/>legati his diebus, et horis insuetis coactus fuit <lb xml:id="p1z27"/>senatus; quid fiat, clam me adhuc est.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Ferunt <lb xml:id="p1z28"/>etiam quidam, sed incerto adhuc rumore, civitatem <placeName>Me<lb xml:id="p1z29"/>tensem</placeName> a Caesare iterum occupatam; item in <placeName ref="l749">Saxonia</placeName> <lb xml:id="p1z30"/>conflictum factum inter comitem <placeName ref="l1716">Mansfeldensem</placeName> <lb xml:id="p1z31"/>et <persName ref="p20318">Heinrychum Brunsvigum</persName> huncque succubuisse, <lb xml:id="p1z32"/>victores <placeName ref="l157">Francofurtum</placeName> petere ad ulciscendam <lb xml:id="p1z33"/><persName>Georgii Megaloburgensis</persName> necem.</s>
					<s n="17" xml:lang="la">Ita varia feruntur, <lb xml:id="p1z34"/>sed quorum fides adhuc sit dubia.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Pestis cessavit <lb xml:id="p1z35"/>iterum, ut nemo ea moriatur; sed in agro multis <lb xml:id="p1z36"/>in locis sęvit, maxime in illis, qui vobis viciniores <lb xml:id="p1z37"/>sunt quam nobis.</s>
					<s n="19" xml:lang="la">Exemplaria sermonum tuorum accepi e<lb xml:id="p1z38"/>t pro voluntate tua distribuam.</s>
					<s n="20" xml:lang="la"><persName ref="p3429">Viretus</persName> <lb xml:id="p1z39"/>cum <persName ref="p8033">Beza</persName> veniet huc his diebus, per quem et domino <lb xml:id="p1z40"/><persName ref="p8299">Falesio</persName> suum mittam.</s>
					<s n="21" xml:lang="la">Pro mea maximas tibi <lb xml:id="p1z41"/>habeo gratias; admiror valde doctam illam sim<lb xml:id="p1z42"/>plicitatem.</s>
					<s n="22" xml:lang="la">Dominus augeat in te sua dona semper et <lb xml:id="p1z43"/>quam diutissime te nobis incolumem servet amen.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z44"/>D. <persName ref="p3241">Trempii</persName> uxor idem fere, quod tu, est passa; <lb xml:id="p1z45"/>decumbit adhuc, sed melius incepit habere.</s>
					<s n="24" xml:lang="la">Amiser<pb/><lb xml:id="p2z1"/>at loquendi facultatem, sed recepit eam iterum et melius <lb xml:id="p2z2"/>habere incipit.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Haec raptim modo ad tuas.</s>
					<s n="26" xml:lang="la"><lb xml:id="p2z3"/>Hodie sunt nundinę.</s>
					<s n="27" xml:lang="la">Si quid inciderit aliud <lb xml:id="p2z4"/>scriptu dignum, scribam per alios, qui ad mercat[um] <lb xml:id="p2z5"/>huc venerunt.</s>
					<s n="28" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="29" xml:lang="la" ana="salute">Mea familia omnis, <persName ref="p8417">Mu<lb xml:id="p2z6"/>sculus</persName> item cum sua te tuamque plurimum salvere iubent.</s>
					<s n="30" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l41">Bernę</placeName> 11. novembris 1552.</s>
				</p>
				<p>
					<s n="31" xml:lang="la"><lb xml:id="p2z8"/>Tuus <persName ref="p8018">Io[annes] Hallerus</persName>.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><lb xml:id="p2z9"/>Literae hę ad te pertinentes a <placeName ref="l280">Lausanna</placeName> ad me sunt perlatę.</s>
					<s n="33" xml:lang="la"><persName ref="p8204">Gißlingerus</persName> etiam <persName>Felici Sprünglio</persName> <lb xml:id="p2z10"/>aliquid hic mittit et literarum et pecuniarum.</s>
				</p>
				<p>
					<s n="34" xml:lang="la">Clarissimo viro d. <persName ref="p495">Heinrycho Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> eccle<lb xml:id="p2z11"/>się pastori fidelissimo, domino et compatri suo colendissimo.</s>
				</p>
				<p>
					<s n="35" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
					<s n="36" xml:lang="de">M. <persName ref="p495">Heinrych Bullinger</persName>en.</s>
				</p>
			</div>
