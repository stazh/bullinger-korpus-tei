	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Frater viva est epistola; per eum nostra omnia <lb xml:id="p1z2"/>cognosces.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Ego tibi tuisque filiis et generis max<lb xml:id="p1z3"/>imas ago gratias pro donariis splendidissimis filię <lb xml:id="p1z4"/>meae missis; quomodo vero hanc liberalitatem vestram <lb xml:id="p1z5"/>et magnificentiam rependam?</s>
					<s n="4" xml:lang="la">Dominum oro, ut is rependat <lb xml:id="p1z6"/>vobisque, ut facit, ita perpetuo benedicere pergat.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>De reliquis proxime per <persName>Löffelspergerum</persName>; nunc enim sum <lb xml:id="p1z8"/>admodum occupatus, ut plura non possim.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z9"/>vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l41">Bernae</placeName> 23. martii 1563.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/><persName ref="p8018">I[oannes] Hallerus</persName> tuus<pb/><lb xml:id="p2z1"/>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ec<lb xml:id="p2z4"/>clesiae pastori fidelissimo, <lb xml:id="p2z5"/>domino suo ho<lb xml:id="p2z6"/>norando compatriqu<lb xml:id="p2z7"/>e charissimo.</s>
				</p>
			</div>
		</body>
	</text>
