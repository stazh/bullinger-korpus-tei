					<lb xml:id="p1z1"/>7
					<lb xml:id="p1z2"/>15.
					<lb xml:id="p1z3"/>Ad d. Buttlgun
					<lb xml:id="p1z4"/>scribit: minister doinm princp
					<lb xml:id="p1z5"/>igis Condensis ex Basilae
					<lb xml:id="p1z6"/>14. novembris 1574.
					<lb xml:id="p1z7"/>domine, mi charissime et honorandissime pater,
					<lb xml:id="p1z8"/>dominus princeps Condensis hum mitteret nunti
					<lb xml:id="p1z9"/>cui literas suas daret perferendas ad magnifica
					<lb xml:id="p1z10"/>cenitatis ves domirum, ed eam quae sedem lieri
					<lb xml:id="p1z11"/>Nes ofsem se dipe hac ad t srita
					<lb xml:id="p1z12"/>ut primum quidam tibi magnas gratias ageram.
					<lb xml:id="p1z13"/>ut ago) propterea, quod pro favore suo, mi
					<lb xml:id="p1z14"/>de tuis rebus certiorem facere dignatus ses u
					<lb xml:id="p1z15"/>inde re rogarem, ut me excusitum habeas
					<lb xml:id="p1z16"/>s cirius tibi non respendarim. celi se e
					<lb xml:id="p1z17"/>suadias velim, mi pater, me hactenus infemitim
					<lb xml:id="p1z18"/>ingotiis ita orcupatum fuisse, ut me mihi eo
					<lb xml:id="p1z19"/>otium licuerit nec potuerim et meo
					<lb xml:id="p1z20"/>deburtum fungi offecio. Nunc enum non ret
					<lb xml:id="p1z21"/>multe plus est ori, quoniam idam venicunt
					<lb xml:id="p1z22"/>literas et bonos viros parat ad regem a quit
					<lb xml:id="p1z23"/>commonifiat de emolumento, quod ipsius regn
					<lb xml:id="p1z24"/>ergaturum est it offecto ae larlis ceusu
					<lb xml:id="p1z25"/>liveranto, si mobo suis suldti Lonami scitissum
					<lb xml:id="p1z26"/>parem concedat. Interea te rogo, quo ad postum
					<lb xml:id="p1z27"/>ut des operam, ut magnifici domini Tigurin
					<lb xml:id="p1z28"/>huic sancto operi gnaviter incumbam
					<lb xml:id="p1z29"/>quo afflictae ecclesiae Gallice et quo iam
					<lb xml:id="p1z30"/>iam patura sunt, nisi sola dei grari
					<lb xml:id="p1z31"/>bonitateque fulciantur) animum collican
					<lb xml:id="p1z32"/>viresque resumman. noque dubito, quem
					<lb xml:id="p1z33"/>nificorum dominorum et aliorum cana
					<lb xml:id="p1z34"/>evangelicorum coniunctis et curu
					<lb xml:id="p1z35"/>cedentibus graecibus, res magis promoveantur
					<lb xml:id="p1z36"/>meliusque se habeant; Nam praeterquae quoq
					<lb xml:id="p1z37"/>ceptum est oppidum. Elachi et quod verem
					<lb xml:id="p1z38"/>cogitationis principum sancti foedlisse
					<lb xml:id="p1z39"/>nocunt alio deducere, quam ad ruinam filio
					<lb xml:id="p1z40"/>dei, quam iam a multis annis piurarum
					<pb/>
					<lb xml:id="p2z1"/>certums est eos admodum falsos ae decar
					<lb xml:id="p2z2"/>fuisse, qui persuasum regem incitarunt
					<lb xml:id="p2z3"/>ad bellum armis absolvendum, brevi vicent
					<lb xml:id="p2z4"/>pollicentes. Nostri enim fratres divina
					<lb xml:id="p2z5"/>bonitate magis quam suis viribus fulti
					<lb xml:id="p2z6"/>vlitur se defendant, nec per illos conscripert
					<lb xml:id="p2z7"/>milites quidquam effectum et aliud, quod sciam,
					<lb xml:id="p2z8"/>quam quod paugam captum sit, ubipe
					<lb xml:id="p2z9"/>amisit qusquam mille hominis, cum
					<lb xml:id="p2z10"/>tamen locus ille minimus sit minusque
					<lb xml:id="p2z11"/>unisex autem etet aliis, quas noscre ocvedi
					<lb xml:id="p2z12"/>Adhaec domini princeps heri vesperi intellexi.
					<lb xml:id="p2z13"/>domi ducem de Nompenzier coactumm
					<lb xml:id="p2z14"/>fuisse, summo cum suo dedicere et decrimit
					<lb xml:id="p2z15"/>a lusignam obsidionem levasse.E
					<lb xml:id="p2z16"/>ut drius inimicorum incomparabilis
					<lb xml:id="p2z17"/>viribus resistendo suos tueatur. Illi supplice
					<lb xml:id="p2z18"/>ut sum favorem in nos exercire persat.
					<lb xml:id="p2z19"/>Caeterum dominus princeps nunquam alias mai
					<lb xml:id="p2z20"/>opus habuit et praecibus et consolatione amici
					<lb xml:id="p2z21"/>suorum quam hoc rempe.
					<lb xml:id="p2z22"/>enim priitatem eum mirum in modum
					<lb xml:id="p2z23"/>afflixit, in eo, quod dominam eius uxorem
					<lb xml:id="p2z24"/>ad se vocavit. Tu itaqu dominem pro tuim oa
					<lb xml:id="p2z25"/>illius excellentiam, dilecta bonitate, illum
					<lb xml:id="p2z26"/>libet aliquo modo consolaburis. Illi
					<lb xml:id="p2z27"/>afflictę princeps virentibus praedita a
					<lb xml:id="p2z28"/>excellenti principissa orbatus est quae
					<lb xml:id="p2z29"/>dei benfitio christana, q ipsius nomen s
					<lb xml:id="p2z30"/>obiit. Nihil aliud addam, quam
					<lb xml:id="p2z31"/>quod te plurimum saluto. deo supesseus p
					<lb xml:id="p2z32"/>ut ite eum perfecti poelicitate loatu
					<lb xml:id="p2z33"/>et longevam largiatur viram.
				</p>
