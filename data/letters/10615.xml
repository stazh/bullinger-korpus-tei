	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mi venerande <persName ref="p495">Bullingere</persName>, charissime frater, ego semper <lb xml:id="p1z2"/>erga omnes, quos mihi commendas, officium fecero<note xml:id="fn1" type="footnote" n="1"><persName ref="p8055">Blarer</persName> hatte kurz zuvor auf <persName ref="p495">Bullingers</persName> Empfehlung <persName ref="p1999">Konrad Lüthard</persName> berufen, vgl. oben <ref target="file10611">Nr. 573</ref>, 2-4.</note>, <lb xml:id="p1z3"/>modo unum hoc a te impetrem, ut ne succenseas, <lb xml:id="p1z4"/>quod rarissime quicquam ad te perscribo; nam sic <lb xml:id="p1z5"/>discerpor etiam in<pb type="edition" next="207"/> sexcenta<note xml:id="fn2" type="footnote" ana="lex" n="2">unzählige (<bibl source="b247">Georges</bibl> II 2636).</note> negocia, ut nihil <lb xml:id="p1z6"/>possim ad amicos.</s>
					<s n="3" xml:lang="la">Erit brevi forte, ut <lb xml:id="p1z7"/>ocii plusculum adfulgeat.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="salute">Bene vale et commenda me, ut <lb xml:id="p1z8"/>facis, Christo.</s>
					<s n="5" xml:lang="la" ana="salute">Saluta <persName ref="p8127">Pellicanum</persName>, <persName ref="p8171">Theodorum</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p8171">Theodor Bibliander</persName>.</note>, <persName ref="p1753">Leonem</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p1753">Leo Jud</persName>.</note> et reliquos <lb xml:id="p1z9"/>omnes.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><placeName ref="l512">Tubingę</placeName>, 26. aprilis anno 1535.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Vere tuus <persName ref="p8055">Ambros[ius] Bl[arer]</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>Tiguricen[sium] episcopo, domino et fratri <lb xml:id="p2z3"/>multum in Christo venerando.</s>
				</p>
			</div>
		</body>
