	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Fuit apud me dominus tuus, fili dilecte, quem <lb xml:id="p1z2"/>pro meritis in te suis libenter trac<lb xml:id="p1z3"/>tavissem quam honorificentissime; sed ita festinavit, <lb xml:id="p1z4"/>ut non licuerit nisi paucula illi <lb xml:id="p1z5"/>conferre.</s>
					<s n="3" xml:lang="la">Vidit tamen meam et meorum erga ill<lb xml:id="p1z6"/>um <lb xml:id="p1z8"/>benevolentiam.</s>
					<s n="4" xml:lang="la">Benigne recepit curam tui in se <lb xml:id="p1z9"/>iterum, cumque te alio ablegavero, recepturus <lb xml:id="p1z10"/>est et <persName ref="p477">I[oannem] Rodolphum</persName>.</s>
					<s n="5" xml:lang="la">Proinde perquire diligente<lb xml:id="p1z11"/>r a doctis, quis locus nunc maxime tutus sit <lb xml:id="p1z12"/>et in quo literae bonae et pietas floreant.</s>
					<s n="6" xml:lang="la">Forte <lb xml:id="p1z13"/>ad calendas septembris ab <placeName ref="l491">Argentina</placeName> discedes, s<lb xml:id="p1z14"/>i modo intellexero nihil te deteriorem <lb xml:id="p1z16"/>fieri, sed <lb xml:id="p1z17"/>meliorem.</s>
					<s n="7" xml:lang="la">Dominus tuus nunc bonum tibi <lb xml:id="p1z18"/>dedit testimonium et supputationem mecum iniit; <lb xml:id="p1z19"/>post octo coronatos datos olim, cum illuc venires, <lb xml:id="p1z20"/>debeo adhuc illi quatuor florinos <lb xml:id="p1z21"/>et bazionem, in summa 17 gl. 2 batz.</s>
					<s n="8" xml:lang="la">praeter mensam consumpsisti.</s>
					<s n="9" xml:lang="la">Laudo in te <lb xml:id="p1z22"/>diligentiam, quam dominus praedicavit, et hanc tuam frugalitatem.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Libenter hos in te sumptus facio, cum <lb xml:id="p1z24"/>video te et diligentem esse et non profusum.</s>
					<s n="11" xml:lang="la">Perge <lb xml:id="p1z25"/>sic, mi charissime fili; places et matri; prae<lb xml:id="p1z26"/>dico te apud fratres et sorores.</s>
					<s n="12" xml:lang="la">Vide etiam atque etiam, <lb xml:id="p1z27"/>sedulo deum ores, ut in bono sic procedas; <lb xml:id="p1z28"/>maiores enim sumptus aegre sustinerem; <foreign xml:lang="de">dann <lb xml:id="p1z29"/>es sint üwer vil, und hab ich sunst ein grossen <lb xml:id="p1z30"/>kosten und nitt darnach ein ynkummen,</foreign> ut scis.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z31"/>Vide tamen, mi fili, nequid aberres in consignando, <lb xml:id="p1z32"/>ne ulla fiat iniuria domino; nam <lb xml:id="p1z33"/>cum schedulas contuli datas a te domino cum iis, quae m<lb xml:id="p1z34"/>ihi <lb xml:id="p1z35"/>consignata misisti, non ubique videntur congruere.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z36"/>Sed cum cernerem capitalem summam in idem <lb xml:id="p1z37"/>recidere, tranquillior factus sum.</s>
					<s n="15" xml:lang="la">Non inveni in eius <lb xml:id="p1z38"/>chartis 10. decembris, in summa tamen <lb xml:id="p1z39"/>nihil defuit.</s>
					<s n="16" xml:lang="de"><foreign xml:lang="la">Vide ergo, ut diligens sis,</foreign> das imm nit <lb xml:id="p1z40"/>joch umb ein haller unrächt beschäch; dann er thuͦt <lb xml:id="p1z41"/>uns gar groß guͦt, und dien imm und iren, <lb xml:id="p1z42"/>wo du dines studierens halben kanst.</s>
					<s n="17" xml:lang="la">Vide, <lb xml:id="p1z43"/>ut sedulo studeas, si forte intra aut post <lb xml:id="p1z44"/>biennium te revocem, redeas sine ignominia <lb xml:id="p1z45"/>summa cum gloria per gratiam dei.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Recte valemus <lb xml:id="p1z46"/>omnes per gratiam dei.</s>
					<s n="19" xml:lang="la" ana="salute">Salutant te omnes et tuos omnes.</s>
					<s n="20" xml:lang="la" ana="salute">Fuerunt <lb xml:id="p1z47"/>apud nos d. d. <persName ref="p18137">Marpachius</persName> et d. <persName>Valentinus Eryt<lb xml:id="p1z48"/>hreus</persName>; hos ex m<lb xml:id="p1z49"/>e salutabis amicissime.</s>
					<s n="21" xml:lang="la" ana="salute">Salutabis <lb xml:id="p1z50"/>et d. <persName ref="p8362">Garnerium</persName> et viros bonos omnes.</s>
					<s n="22" xml:lang="la">Martii <lb xml:id="p1z51"/>12. anno 1555.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z52"/><persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la" ana="salute"><pb/><lb xml:id="p2z1"/>D. <persName>Hattono</persName> scribere volui, <lb xml:id="p2z2"/>sed non potui; salutabis eum<lb xml:id="p2z3"/>.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Dilecto meo fi<lb xml:id="p2z4"/>lio <persName ref="p495">Heinrycho Bullingero</persName>, <placeName ref="l491">Argentinae</placeName>, <lb xml:id="p2z5"/>in aedibus domini <persName ref="p505">Burcheri</persName> <placeName ref="l830">Angli</placeName>.</s>
				</p>
				<p>
					<s n="26" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l491">Straßburg</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
