	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salutem et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Nihil iam habeo, colendissime <lb xml:id="p1z3"/>domine, quod ad tuas literas respondeam, quam ut de transmittendis <lb xml:id="p1z4"/>sermonibus, quos tuus filius <persName ref="p475">Christophorus</persName> meo nomine abs te peti<lb xml:id="p1z5"/>vit, te securum esse iubeam.</s>
					<s n="3" xml:lang="la">Nolim enim te aliis multis <lb xml:id="p1z6"/>laboribus oppressum, quicquam molestiarum mea causa ferre.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Mitto tibi scriptum, cuius autor est d. <persName ref="p8441">Caspar Schwencfeldius</persName>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Hoc quidem bonus, pius et doctus vir, cum ei nimium <lb xml:id="p1z9"/>in vestram partem inclinare viderer, mihi obiecit.</s>
					<s n="6" xml:lang="la">Descripsi, ausus <lb xml:id="p1z10"/>tamen non fui, ut ad vos mitterem.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Iam tuae humanitati confi<lb xml:id="p1z11"/>sus mitto.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Spero te id non male habere.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Si ita est, ut homo <lb xml:id="p1z12"/>iste dicit, vobis <placeName ref="l587">Tigurinis</placeName>, ut salva pace dixerim, non iniuria <lb xml:id="p1z13"/>fit, si Lutherani vobis idem faciunt, iuxta illud: Quo quis mensura <lb xml:id="p1z14"/>metitur, eadem ipsi metiatur.</s>
					<s n="10" xml:lang="la">Si minus, miror hominis <lb xml:id="p1z15"/>impudentiam, qui talia de vobis spargere ausus sit.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Bene vale me<lb xml:id="p1z16"/>que tuum esse sine.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z17"/><placeName ref="l18">Augustae</placeName> ultimo(a?) decembris 1557.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z18"/>Non opus est, ut exemplar Schwengfeldii remittas.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z19"/>Tui observantissimus <lb xml:id="p1z20"/><persName ref="p8486">Engelbertus Milander</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Reverendo et excellenti viro <lb xml:id="p2z2"/>domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>ecclesię <placeName ref="l587">Tigurinae</placeName> ministro <lb xml:id="p2z4"/>primario, domino suo plurimum <lb xml:id="p2z5"/>observando.</s>
					<s n="16" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
