	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Trevirensium status afflictissimus est, de quo arbitror nuper ad te, <lb xml:id="p1z2"/>et mitterem integram historiam; sed non est nunc ad manus, missurus, ubi recepero.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/><placeName ref="l2524">Scoti</placeName> <persName>Guisanum</persName> fuderunt duce comite de <placeName>Aran</placeName>; vindictam meditatur <lb xml:id="p1z4"/>cladis frater <persName>Guisanus</persName> senior.</s>
					<s n="4" xml:lang="la">Utinam et is per domini manum confundatur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Confoederati certis legibus <placeName ref="l830">Angli</placeName> et <placeName ref="l2524">Scoti</placeName> feruntur; sed tum ea certius <lb xml:id="p1z6"/>scribemus, cum habuerimus certiora.</s>
					<s n="6" xml:lang="la">Persecutio <placeName ref="l378">Lutetiae</placeName> super modum fervet; <lb xml:id="p1z7"/>interemptus glande bombardae nuper est ex iudicibus primus quidam, evasitque <lb xml:id="p1z8"/>caedis autor, unde supra modum et cardinales et sui similes tyranni <lb xml:id="p1z9"/>metuunt et in curiam nemo nisi armatorum stipatus manu venit.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>In <placeName>Provincia</placeName> et <placeName>Aquitania</placeName> non ea exercetur saevitia.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Rex <lb xml:id="p1z11"/>iuvenis misero est miserior, ut qui et valetudine infirmissima adfligitur <lb xml:id="p1z12"/>et insanorum regitur furoribus.</s>
					<s n="9" xml:lang="la"><placeName ref="l361">Norimbergenses</placeName> a d. <persName ref="p20597">a Grumbach</persName> <lb xml:id="p1z13"/>graviter vexantur, nec redimi pax nisi ingenti pecunia posse videtur, <lb xml:id="p1z14"/>quod auxiliares habeat potentes.</s>
					<s n="10" xml:lang="la">Per caetera altum est silentium <lb xml:id="p1z15"/>de <placeName ref="l822">Germaniae</placeName> rebus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><persName ref="p540">Calvinus</persName> graviter aegrotare nunciatur, <lb xml:id="p1z16"/>quem commendemus ecclesiae ut insigne Christi organum.</s>
					<s n="12" xml:lang="la" ana="farewell">Bene vale <lb xml:id="p1z17"/>cum tuis omnibus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l28">Basileae</placeName> 17. februarii anno 60.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">T[uus] <persName ref="p3099">S[<lb xml:id="p1z18"/>imo<lb xml:id="p1z19"/>n] <lb xml:id="p1z20"/>Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> antistiti vigi<lb xml:id="p2z4"/>lantissimo, domino et symmistae <lb xml:id="p2z5"/>colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
