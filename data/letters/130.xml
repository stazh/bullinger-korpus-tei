	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Decima nona martii scriptum de <persName ref="p5930">Naemanni</persName> adoratione remisi tibi, frater obs<lb xml:id="p1z2"/>ervandissime, ac deinceps XI. aprilis iterum scripsi inter cętera, quid tibi videatur <lb xml:id="p1z3"/>de scripto illo per me in Latinum transferendo.</s>
					<s n="3" xml:lang="la">Hactenus vero rerum omnium hęreo incertus; <lb xml:id="p1z4"/>a te enim a 15. usque februarii nihil accepi, nec typographus quicquam, ut postula<lb xml:id="p1z5"/>veram, respondit.</s>
					<s n="4" xml:lang="la">Cupio igitur quam paucissimis per tabellarium et amicum hunc <lb xml:id="p1z6"/>meum <persName ref="p6897">Varnirium</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p6897">Varnier</persName>.</note> allato epistolio certior fieri.</s>
					<s n="5" xml:lang="la">Si typographus Latinum etiam <lb xml:id="p1z7"/>libellum istum habere voluerit, statim mittam; <persName ref="p6897">Varnirius</persName> ne adhuc quidem <lb xml:id="p1z8"/>ad imprimendum est instruc<lb xml:id="p1z9"/>tus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Cęterum ut maxime cupiam <lb xml:id="p1z10"/>te libello aliquo remunerare, nil tamen omnino habere possum, nisi ut meorum <lb xml:id="p1z11"/>aliquot servare te iubeam.</s>
					<s n="7" xml:lang="la">De comitiis nil adhuc vulgatur, <lb xml:id="p1z12"/>licet in pręlo quidem esse ferant propediem proditura.</s>
					<s n="8" xml:lang="la">Hoc die Interim <lb xml:id="p1z13"/>illud ad senatum nostrum refertur, ut est elapsa hebdomada <placeName ref="l18">Augustę</placeName> <lb xml:id="p1z14"/>statibus omnibus expositum, de quo tamen malo alias idque procul dubio brevi <lb xml:id="p1z15"/>scribere.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Ignoratur enim, an omnes consensu suo sint ratificaturi.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/>Audio equidem electores <persName ref="p18250">Mauritium</persName> et <placeName ref="l1048">Brandenburgensem</placeName> contra illud <lb xml:id="p1z17"/>esse portestatos.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale.</s>
					<s n="12" xml:lang="la">Plura scribere non vacavit; <persName ref="p6897">Varnirius</persName> enim <lb xml:id="p1z18"/>abitus sui indicatione me fefellit.</s>
				</p>
				<p>
					<s n="13" xml:lang="de"><placeName ref="l513">Ulmę</placeName> 22. maii <lb xml:id="p1z19"/>anno 48.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p8504">Leonhartus Soerinus</persName><lb xml:id="p1z21"/>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z22"/>De libello nil scriberem, nisi metuendum mihi esset nec hunc forte nec epistolam <lb xml:id="p1z23"/>alteram ad te pervenisse.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ecclesię catholicę ministro fidelissimo <lb xml:id="p2z2"/><persName ref="p495">H. Bullingero</persName>, fratri suo in domino <lb xml:id="p2z3"/>plurimum diligendo et colendo.</s>
					<s n="17" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zürch</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
