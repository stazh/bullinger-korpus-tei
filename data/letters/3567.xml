	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>fuit tua de diica cęna concio.
					<lb xml:id="p1z2"/>
					<lb xml:id="p1z3"/>e Bulliger, Proinde sabeo et ao gratiams.
					<lb xml:id="p1z4"/>habeni sic nivis professores. Anvernatur
					<lb xml:id="p1z5"/>vir alioqui datum et extellentu medicis
					<lb xml:id="p1z6"/>p veriams occusarim, non sut ampleus
					<lb xml:id="p1z7"/>soleta nostra legere, e eius titum suf,
					<lb xml:id="p1z8"/>Hiet Masserius Italis novus doctor.
					<lb xml:id="p1z9"/>sed venera non indoctus filius essie Basi
					<lb xml:id="p1z10"/>oii (ut audio) leget i Maathematices, He
					<lb xml:id="p1z11"/>loco. Angli se ppera et lesti
					<lb xml:id="p1z12"/>e saleti, dulem.
					<lb xml:id="p1z13"/>quae hastum pro recuperet.
					<lb xml:id="p1z14"/>sebelum insrrctas navesic mari, meus
					<lb xml:id="p1z15"/>etiam intercitum in continenti. Interim phisissus
					<lb xml:id="p1z16"/>in cardinali Carifsa Brenzillis sit scrib.
					<lb xml:id="p1z17"/>galeter et cardinaliter
					<lb xml:id="p1z18"/>veneri et Baccodult
					<lb xml:id="p1z19"/>valemur hic omne bene, idem tibi a bua
					<lb xml:id="p1z20"/>prelamur et tuę tume familię tim tidii. Val
					<lb xml:id="p1z21"/>Argentiratu 17. prili 15.
					<lb xml:id="p1z22"/>Tuę ex aic
					<lb xml:id="p1z23"/>athuc
					<pb/>
					<lb xml:id="p2z1"/><placeName ref="l587">Tigurine</placeName> ecclesie pastori viginia
					<lb xml:id="p2z2"/>d. Bomineb patri
					<lb xml:id="p2z3"/>Tigurum.
				</p>
			</div>
		</body>
	</text>
