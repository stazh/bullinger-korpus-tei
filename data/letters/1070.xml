	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Non satis mirari posse, qoud nullas ad <lb xml:id="p1z2"/>me literas dederis in hoc rerum tumultu, ubi omnia <lb xml:id="p1z3"/>susque deque feruntur.</s>
					<s n="3" xml:lang="la">Caear aegrotat strenue; forte habet <lb xml:id="p1z4"/>cadaver, quod dissolvi nescit.</s>
					<s n="4" xml:lang="la"><persName ref="p18477">Ferdinandus</persName> rex in periculo est <lb xml:id="p1z5"/>ingenti ob <placeName ref="l2510">Turcę</placeName> incursiones, quas <placeName ref="l869">Transsyl<lb xml:id="p1z6"/>vania</placeName>; timent quidam, cum totam illam ditionem iam subie<lb xml:id="p1z7"/>cerit.</s>
					<s n="5" xml:lang="la">Nos diu consultamus et praecipue contra Christum consilia <lb xml:id="p1z8"/>excogitamus; sed dominus aliud solet excogitare, quod impedire solet <lb xml:id="p1z9"/>impiorum hominum consultationes, quibus nihil aliud instituunt quam <lb xml:id="p1z10"/>Christi verbum cum ministris suis perdere.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/><persName ref="p18935">Dux Bipontinus</persName> cum suis consanguineis consultat de liberan<lb xml:id="p1z12"/>do lantgravio; multi ex nobilibus et baronibus congregati <lb xml:id="p1z13"/>sunt in <placeName>Meisenheim</placeName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Princeps pius nihil mutavit adhuc <lb xml:id="p1z14"/>in religione semel suscepta, quem dominus suo spiritu vegetiorem reddat <lb xml:id="p1z15"/>constantioremque, precor.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Certe pręterea dicitur comitia <placeName ref="l18">Augustę</placeName> suspensa esse usque <lb xml:id="p1z17"/>ad calendas februarias.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/>Duo egregii fratres obierunt iis diebus <placeName ref="l491">Argentinę</placeName>, alter <lb xml:id="p1z19"/><persName>Kigelius</persName> alter <persName>Marcus Heilandt</persName>, qui olim in agro <placeName ref="l28">Basiliensi</placeName> verbum <lb xml:id="p1z20"/>domini praedicavit, quem egregie d. <persName ref="p8127">Pellicanus</persName> novit.</s>
					<s n="10" xml:lang="la">Strenue in nego<lb xml:id="p1z21"/>tio domini laborarunt et praecipue pugnarunt contra Interim.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z22"/>Obsecro, velis scribere, si quid meo officiolo in hiis nundinis <lb xml:id="p1z23"/>indigeas; libens exequi paratus sum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/>Cupio insuper a te scire, quid iam scribas aut quid nobis <lb xml:id="p1z25"/>hac hyeme daturus sis in ecclesiae Christi utilitatem.</s>
					<s n="13" xml:lang="la">Pauci nostro <lb xml:id="p1z26"/>seculo scribunt; omnes timent potentiam illius, qui quiescere <lb xml:id="p1z27"/>nescit, donec a domino prosternatur et rapiatur usque ad <lb xml:id="p1z28"/>inferos.</s>
					<s n="14" xml:lang="la">Mittam brevi <placeName ref="l303">Magdenburgensium</placeName> cladem, qui libellus <lb xml:id="p1z29"/>apud nos excuditur.</s>
					<s n="15" xml:lang="la" ana="farewell">Vale.</s>
					<s n="16" xml:lang="la"><placeName ref="l28">Basileę</placeName> 4. novembris <lb xml:id="p1z30"/>1550.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z31"/>T[uus] <persName ref="p1278">Ioannes Gastius</persName> ex an<lb xml:id="p1z32"/>imo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">D. <persName ref="p1214">Frisium</persName> nostrum salutabis m<lb xml:id="p1z33"/>eo nomine, <lb xml:id="p1z35"/>si me <lb xml:id="p1z36"/>adhuc agnoscit suum.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z37"/>Ex <placeName ref="l749">Saxonia</placeName> nihil habemus.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z38"/>Misi literas tuas <placeName ref="l18">Augustam</placeName> ad bonum <lb xml:id="p1z39"/>amicum, qui dedit aulicis <persName ref="p18250">Mauricii</persName> ducis, qui <lb xml:id="p1z40"/>diligentissime curare volunt.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, pastori <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> ecclesiae <lb xml:id="p2z4"/>vigilantissimo <lb xml:id="p2z5"/>praeceptorique suo charis<lb xml:id="p2z6"/>simo.</s>
				</p>
			</div>
