	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><persName ref="p6463">Gasparem Schneberger</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p6463">Kaspar Schneeberger</persName>, der Kostgänger bei <persName ref="p8418">Myconius</persName> gewesen war.</note>, quęso, sic excipias, ut omnium simplicissimum et ex sim<lb xml:id="p1z2"/>plicitate stultulum atque nonnihil superbulum; quod intelligit, quę recta sunt, verum <lb xml:id="p1z3"/>nescit uti.</s>
					<s n="3" xml:lang="la">Literarum quoque non est omnino expers (quod valde miror), sed itidem <lb xml:id="p1z4"/>sine bono usu.</s>
					<s n="4" xml:lang="la">Si amici et cognati<note xml:id="fn2" type="footnote" ana="bio" n="2">Zu <persName ref="p6463">Kaspar Schneebergers</persName> Eltern s. <bibl source="b17">HBBW XIV</bibl>, <ref target="file11902">Nr. 1856</ref>, Anm. 1.</note> permiserint eum suis moribus vivere, i<lb xml:id="p1z5"/>ucundus esse valebit; sin conabuntur mutare, plane perdent.</s>
					<s n="5" xml:lang="la">Rogavit me, ut <lb xml:id="p1z6"/>se tibi commendarem.</s>
					<s n="6" xml:lang="la">Fac ergo, ut sit commendatissimus vel hoc nomine, quod est minime <lb xml:id="p1z7"/>malus, nisi nimium vexando talis reddatur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/>Omisi in altera epistola<note xml:id="fn3" type="footnote" n="3">Oben <ref target="file12111">Nr. 2064</ref>.</note>, quod, postquam obsignavi, rediit ad me cum literis<note xml:id="fn4" type="footnote" n="4">Vermutlich an <persName ref="p495">Bullinger</persName> gerichtet; nicht erhalten.</note> nepos tuus<note xml:id="fn5" type="footnote" n="5"><persName ref="p499">Josua Bullinger</persName>.</note> - ut nos<lb xml:id="p1z9"/>se vales, quia eas mitto.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Item octo millibus <placeName ref="l875">Hispanorum</placeName> gravare <persName ref="p18538">cęsar</persName><note xml:id="fnb" type="footnote" n="b">cęsar <hi>über der Zeile nachgetragen.</hi></note><note xml:id="fn6" type="footnote" n="6"><persName ref="p18538">Karl V.</persName></note> voluit <placeName ref="l691">Lothoringiam</placeName>, quam antea tamen <lb xml:id="p1z11"/>exhausit.</s>
					<s n="9" xml:lang="la">Sed dux<note xml:id="fn7" type="footnote" n="7"><persName ref="p7637">François I. von Lothringen</persName> (1517-1545).</note> collecto exercitu dum eos vi conatus erat eiicere, venit intercessor<note xml:id="fn8" type="footnote" n="8">Unbekannt.</note><lb xml:id="p1z12"/>, vir magnus, vimque prohibuit et <placeName ref="l691">Lothoringum</placeName> levavit, Concordiensibus<note xml:id="fn9" type="footnote" n="9">Gemeint sind vermutlich die vom <placeName ref="l1202">Schmalkaldischen</placeName> Bund bereitgestellten Truppenteile; s. <bibl source="b17">HBBW XIV</bibl>, <ref target="file11932">Nr. 1886</ref>, 42-44; 1890, 1-10.</note>, <placeName ref="l2836">Sunt<lb xml:id="p1z13"/>gaudiensibus</placeName><note xml:id="fn10" type="footnote" n="10">den <placeName ref="l2836">Sundgauern</placeName> (südliches <placeName ref="l632">Elsass</placeName>).</note> et <placeName ref="l2774">Brisgaviensibus</placeName><note xml:id="fn11" type="footnote" ana="lex" n="11">den <placeName ref="l2774">Breisgauern</placeName>.</note> imminens.<note xml:id="fn12" type="footnote" n="12">Zu diesen Begebenheiten s. Auguste <hi>Digot,</hi> Histoire de Lorraine, Bd. 4, Nancy 1856, S. 100f. Es könnte sich dabei um das spanische Regiment unter dem Obersten <persName ref="p7310">Alvarez de Sande</persName> gehandelt haben, "welches nach Beendigung des Krieges mit Frankreich in <placeName ref="l691">Lothringen</placeName> Winterquartiere bezogen hatte" (<bibl source="b480">PC</bibl> III 550f, Nr. 521, Anm. 2).</note><pb type="edition" next="88"/></s>
					<s n="10" xml:lang="la">Et nisi nobilitas, quę propterea convenit <placeName ref="l452">Selestadię</placeName>, <lb xml:id="p1z14"/>deprecatura est apud cęsarem, fiet aliquid.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale in domino.</s>
					<s n="12" xml:lang="la">16. ianuarii anno 1545.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z15"/>Tuus <persName ref="p8418">Mycon</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>theologo doctissimo, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> praesuli, in domino <lb xml:id="p2z4"/>venerando suo.</s>
				</p>
			</div>
		</body>
