	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem.</s>
					<s n="2" xml:lang="la">Nihil habeo memorabile, vir clarissime, <lb xml:id="p1z2"/>nisi quod alias intelliges ex literis nostri magistratus.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Enarrant illi vestris omnia diligenter.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Nolui tamen committere, ut certus tabellio vacuus <lb xml:id="p1z5"/>ad te veniret.</s>
					<s n="5" xml:lang="la">His saltem occasionem do scrib<lb xml:id="p1z6"/>endi.</s>
					<s n="6" xml:lang="la">Scio enim, te multo plura habere - quae mihi <lb xml:id="p1z7"/>communicare velis, oro.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="7" xml:lang="de"><foreign xml:lang="la">Praeterea scribit ho<lb xml:id="p1z8"/>die d. <persName ref="p8055">Ambrosius Blaurerus</persName>:</foreign> <lb xml:id="p1z9"/>Die von <placeName ref="l157">Franc<lb xml:id="p1z10"/>kfurt</placeName> habend dem keysser uffgefangen für 1000 <lb xml:id="p1z11"/>man harnisch, ettlich tusend haggen <lb xml:id="p1z14"/>und ettlich hundert tonen bulvers.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="8" xml:lang="de"><lb xml:id="p1z15"/>27. iulii ist ein fenli knaͤcht von <placeName ref="l28">Basel</placeName> den R<lb xml:id="p1z16"/>hyn nider gefaren uff <placeName ref="l491">Straßburg</placeName>.</s>
					<s n="9" xml:lang="de">Sind <lb xml:id="p1z17"/>umb <placeName ref="l28">Basel</placeName> angenommen.</s>
					<s n="10" xml:lang="la">Plura non habeo.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z18"/>Tuas accepi missas per <persName ref="p4705">Engelinum</persName> de <persName ref="p4932">Antronio</persName> et <lb xml:id="p1z19"/><persName ref="p6793">Dumysio</persName>.</s>
					<s n="12" xml:lang="la">Utinam tu venias <placeName ref="l587">Tigurum</placeName> a<lb xml:id="p1z20"/>d comitia!</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z21"/>Vale.</s>
					<s n="14" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 29. iulii <lb xml:id="p1z22"/>a<lb xml:id="p1z23"/>nno 1546.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p8049">Ioachimo <lb xml:id="p2z2"/>Vadiano</persName>, domino suo <lb xml:id="p2z3"/>colendissimo.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l473">Sangallen</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
