	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, frater.</s>
					<s n="2" xml:lang="la">Unus ex <placeName ref="l294">Locarnensibus</placeName>, quem <lb xml:id="p1z2"/>accepi in familiam, mittetur a me istuc; <lb xml:id="p1z3"/>quare non erat equum illum venire sine <lb xml:id="p1z4"/>meis ad te litteris, tametsi pauca habeo, <lb xml:id="p1z5"/>quae scribam.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Quum pestilentia abierit, <lb xml:id="p1z6"/><placeName ref="l512">Tubingam</placeName> sum reversus liberatus hac <lb xml:id="p1z7"/>occasione ab aula, quod valde optavi.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Valeo pulchre dei gratia.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Schola <lb xml:id="p1z9"/>instauratur; undique conveniunt studiosi <lb xml:id="p1z10"/>non pauci.</s>
					<s n="6" xml:lang="la"><persName ref="p20206">Gribaldus</persName> tamen nunc in <lb xml:id="p1z11"/>patriam satis iniquo tempore est pro<lb xml:id="p1z12"/>fectus.</s>
					<s n="7" xml:lang="la">Misit ad me d. <persName ref="p8111">Martyr</persName> scriptu<lb xml:id="p1z13"/>m, quod ille <placeName ref="l167">Genevae</placeName> sparserat, satis <lb xml:id="p1z14"/>alienum a confessione.</s>
					<s n="8" xml:lang="la">Fateor mihi val<lb xml:id="p1z15"/>de ista dsplicere.</s>
					<s n="9" xml:lang="la">Sed sic sunt omnes: <lb xml:id="p1z16"/>tegunt se mira astutia, praeterea cum <lb xml:id="p1z17"/>infamia bonorum; seri<lb xml:id="p1z19"/>o <lb xml:id="p1z20"/>m<lb xml:id="p1z21"/>onui homin<lb xml:id="p1z22"/>em, ne p<lb xml:id="p1z23"/>er<lb xml:id="p1z24"/>gat.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p18477">Ferdinandus</persName> scripsit ad principes, ne <placeName ref="l410">Ratis<lb xml:id="p2z2"/>ponam</placeName> comitiorum causa veniant, nisi sua m<lb xml:id="p2z3"/>aiestas scribat prius, ac petivit, ut in pro<lb xml:id="p2z4"/>pria persona velint venire, id quod polli<lb xml:id="p2z5"/>citi sunt.</s>
					<s n="11" xml:lang="la"><persName ref="p2411">Otto Henricus</persName> meus va<lb xml:id="p2z6"/>gatur in <placeName ref="l2477">Palatinatu</placeName> ac summit omnes <lb xml:id="p2z7"/>in fidem.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Ego brevi ad eius celsitudinem ac<lb xml:id="p2z8"/>cedam, si dominus voluerit.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z9"/>Undique resonat antichristum nullum non <lb xml:id="p2z10"/>lapidem movere, ut possit nos bello <lb xml:id="p2z11"/>obruere.</s>
					<s n="14" xml:lang="la">Qui habitat in coelis, irridebit <lb xml:id="p2z12"/>eum.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z13"/>Legati provintiarum <placeName ref="l850">Austriacarum</placeName> constan<lb xml:id="p2z14"/>tissime urserunt eorum principem pro evan<lb xml:id="p2z15"/>gelio, at frustra; redierunt re in<lb xml:id="p2z16"/>fecta.</s>
					<s n="16" xml:lang="la">Sed ea constantia paritura est <lb xml:id="p2z17"/>suum fructum, non dubito.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z18"/>Utinam mihi significares, quid agat le<lb xml:id="p2z19"/>gatio <placeName ref="l862">Helvetica</placeName>, redieritque, quid effe<lb xml:id="p2z20"/>cerit etc.</s>
					<s n="18" xml:lang="la" ana="salute">D. <persName ref="p8011">Gualtero</persName> meis <lb xml:id="p2z21"/>verbis salutem plurimam, atque ut mittat mihi <lb xml:id="p2z22"/>versus, quos ab eo petivi; difficilius possem <lb xml:id="p2z23"/>extorquere aurum, si versus, quorum est <pb/><lb xml:id="p3z1"/>ditissimus, non possum.</s>
					<s n="19" xml:lang="la" ana="salute">Salvere iubeo <lb xml:id="p3z2"/>tris generos et reliquam familiam <lb xml:id="p3z3"/>atque totam ecclesiam.</s>
					<s n="20" xml:lang="la">Oro, iuvate me <lb xml:id="p3z4"/>vestris precibus.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Pax domini nostri Iesu <lb xml:id="p3z5"/>Christi cum omnibus vobis, amen.</s>
					<s n="22" xml:lang="la"><lb xml:id="p3z6"/><placeName ref="l512">Tubingae</placeName> 11. aprilis 1556.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p3z7"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="24" xml:lang="la">[<pb/><lb xml:id="p4z1"/>C]larissimo viro domino <persName ref="p495">Henrico <lb xml:id="p4z2"/>Bullingero</persName>, fratri et <lb xml:id="p4z3"/>domino honorando.</s>
					<s n="25" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
