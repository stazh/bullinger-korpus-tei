	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Diese bereits von <persName ref="p2979" cert="high">J. J. Simler</persName> vorgeschlagene Datierung (vgl. Zürich ZB, Ms S 44, 77) beruht auf der Annahme, der im Brief erwähnte Schützling <persName ref="p495" cert="high">Bullingers</persName> sei <persName ref="p8011" cert="high">Rudolf Gwalther</persName>. Vgl. dazu Anm. 2.</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Sic habent res, ut nec negare nec annuere nunc <lb xml:id="p1z2"/>quidem possim.</s>
					<s n="3" xml:lang="la">Egere mecum de eadem re quidam, quorum <lb xml:id="p1z3"/>liberi si quidem aderunt, sic ut expecto brevi, locus erit <lb xml:id="p1z4"/>et huic tuo<note xml:id="fn2" type="footnote" n="2">Gemeint ist vermutlich <persName ref="p8011">Rudolf Gwalther</persName>; um Mitte Juli entschuldigt sich <persName ref="p1365">Grynäus</persName>, daß er die Bitte um dessen Aufnahme in sein Haus noch nicht beantwortet habe (s. unten <ref target="file11189">Nr. 1146</ref>, 1-10).</note>.</s>
					<s n="4" xml:lang="la">Sin minus, vides, quam non sit aequum operam <lb xml:id="p1z5"/>uni locare.</s>
					<s n="5" xml:lang="la">Sane dudum istam a me provinciam reieci, <lb xml:id="p1z6"/>verum vincit improbitas hominum dicam an authoritas, ut <lb xml:id="p1z7"/>tenere meum in studiis propositum non possim.</s>
					<s n="6" xml:lang="la">Tibi vero, <lb xml:id="p1z8"/>mi <persName ref="p495">Bulingere</persName>, quam aequum est gratificari bonos omnes et <lb xml:id="p1z9"/>quam<note xml:id="fna" type="footnote" n="a"><hi>vor</hi> quam <hi>gestrichenes</hi> quam.</note> ipse inter bonos censeri cupio, tam studebo diligenter <lb xml:id="p1z10"/>obsequi et, quantum id fieri potest, amorem tuum demereri.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z11"/>Vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Pridie calendas aprilis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z12"/><persName ref="p1365">Simon Grynaeus</persName> tuus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z13"/>Respondebitur <lb xml:id="p1z14"/>tibi brevi.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heynricho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/>viro egregio, <lb xml:id="p2z4"/>fratri in Christo.</s>
				</p>
			</div>
		</body>
	</text>
