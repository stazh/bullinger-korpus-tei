	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>En tandem diu a me desideratam et a nobis <lb xml:id="p1z2"/>expectatam <persName ref="p8417">Musculi</persName> vocationem.</s>
					<s n="2" xml:lang="la">Si iusiurandum <lb xml:id="p1z3"/>(ut omnes solemus) praestabit et mentem suam fratribus libere <lb xml:id="p1z4"/>aperuerit, iam rata erit vocatio.</s>
					<s n="3" xml:lang="la">Iniungetur illi professio <lb xml:id="p1z5"/>theologica.</s>
					<s n="4" xml:lang="la">Bene habent fratres omnes, cum vident aliter fieri <lb xml:id="p1z6"/>non posse.</s>
					<s n="5" xml:lang="la">Spero utilem fore illius vocationem huic ecclesiae <lb xml:id="p1z7"/>et nobis omnibus urbique et universae reipublicae <placeName ref="l41">Bernensi</placeName> honestissimam.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Tu (quod et in proximis rogavi) cum caeteris fratribus ipsum <lb xml:id="p1z9"/>alloquere et, quomodo se gerat, instrue; ego illi liberime [haec - <lb xml:id="p1z10"/>illi?] tria proposui capita: 1. insinuando se doctrinam [disput<lb xml:id="p1z11"/>a]tionis nostrae confirmaturum, 2. explicaturum etiam publice <lb xml:id="p1z12"/>priora sua scripta, ne deinceps cuiquam impingendi sint occasio, <lb xml:id="p1z13"/>3. ut diligenter caveat a consortio omnium, qui hactenus <lb xml:id="p1z14"/>adversas secuti sunt partes et hanc inquietarunt ecclesiam etc.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Reliqua vos quoque ei proponite.</s>
					<s n="8" xml:lang="la">Tum denique rogo, ut <lb xml:id="p1z16"/>ei publicus tradatur eques, qui eum huc deducat; erit <lb xml:id="p1z17"/>hoc et ipsi et dominis <placeName ref="l587">Tigurinis</placeName> honestissimum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Scripsi vero illi <lb xml:id="p1z18"/>quoque, ut ad 24. Februarii suum differat adventum, donec <lb xml:id="p1z19"/>ex <placeName ref="l280">Lausana</placeName> ipse fuero reversus.</s>
					<s n="10" xml:lang="la" ana="farewell">Interim tu quoque bene <lb xml:id="p1z20"/>vale.</s>
					<s n="11" xml:lang="la" ana="salute">Salutem dic colendissimis dominis et fratribus omnibus <lb xml:id="p1z21"/>D. praeposito, <persName ref="p8127">Pellicano</persName>, <persName ref="p8171">Bibliandro</persName>, <persName ref="p8011">Gualthero</persName>, <persName ref="p8459">Othoni</persName> etc. tuae de<lb xml:id="p1z22"/>nique uxori et liberis ex me meaque.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l41">Bernae</placeName> <lb xml:id="p1z23"/>10. Februarii 1549.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><persName ref="p8018">I[<lb xml:id="p1z24"/>oannes] H[allerus</persName>] ex animo tu<pb/><lb xml:id="p2z1"/>us.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="14" xml:lang="la">Excellentissimo viro <lb xml:id="p2z2"/>D. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>fidelissimo <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae antistiti, <lb xml:id="p2z5"/>suo colendissimo domino et <lb xml:id="p2z6"/>compatri.</s>
				</p>
			</div>
		</body>
	</text>
