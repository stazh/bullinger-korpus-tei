	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi quidem tuas, chare frater, <lb xml:id="p1z2"/>literas una cum excerptis causae <placeName ref="l646">Claronensis</placeName>; <lb xml:id="p1z3"/>sed nunc, quod scribam, non habeo.</s>
					<s n="3" xml:lang="la">Sequestres <lb xml:id="p1z4"/>dominica reminiscere <placeName ref="l300">Lucernam</placeName> ibunt, inde ad <placeName ref="l781">Uria<lb xml:id="p1z5"/>nos</placeName>, <placeName ref="l2450">Svytenses</placeName> et <placeName ref="l2469">Subsylvanos</placeName>, tentaturi, num <lb xml:id="p1z6"/>possint ab his impetrare, ut consentiant in <lb xml:id="p1z7"/>pacem sicuti <placeName ref="l300">Lucernates</placeName> et <placeName>Togeni</placeName>.</s>
					<s n="4" xml:lang="la" ana="salute">Faxit <lb xml:id="p1z8"/>dominus, ut omnia feliciter ad gloriam dei et pacem <lb xml:id="p1z9"/>nostram cedant ad salutem animarum!</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Fama est 23. februarii in aulam regis <placeName ref="l832">Galliae</placeName> <lb xml:id="p1z11"/>perventurum <placeName ref="l691">Lotharingum</placeName> cardinalem.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quod si verum <lb xml:id="p1z12"/>est, nihil mihi vel boni vel pacis polliceor.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/><persName>Erynnis</persName> et furia infernalis est.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Hoc nunc <lb xml:id="p1z14"/>me consolatur, quod dominus noster et diaboli est dominus, <lb xml:id="p1z15"/>qui et momento potest alastores illos tollere <lb xml:id="p1z16"/>e medio.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Recte ille gerit purpuram, <lb xml:id="p1z17"/>qui totus sanguine innoxio conspersus, imo <lb xml:id="p1z18"/>complutus est statque in cruore fidelium usque <lb xml:id="p1z19"/>ad collum, imo supra caput.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><persName>Thomyris</persName> aliqua <lb xml:id="p1z20"/>dominum usqueadeo cruentum, reverendum <lb xml:id="p1z21"/>dicere volebam, pro dignitate tractare posset.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z22"/>Verum iudicia dei sunt, qui iustus est et verax.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/>Vix dixero, quanto tenear desyderio videndi <lb xml:id="p1z24"/>sessionem 9. et conclusionis concilii.</s>
					<s n="13" xml:lang="la">Vellicabis <lb xml:id="p1z25"/>ergo aurem omnibus, a quibus aliquid speras.</s>
				</p>
				<p>
					<s n="14" xml:lang="de"><lb xml:id="p1z26"/>Die 60000 duggaten werdent verplumpen in den <lb xml:id="p1z27"/>unersettigen gmuͤten wie ein ply klotz imm <placeName ref="l2528">Bo<lb xml:id="p1z28"/>densee</placeName> etc.</s>
					<s n="15" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 18. februarii.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Qui fit, <lb xml:id="p1z29"/>quod <persName ref="p4037">Zanchus</persName> ne<foreign xml:lang="el">γρῇ</foreign> quidem scribit?</s>
					<s n="18" xml:lang="la">Non <lb xml:id="p1z30"/>suspicaris alibi apud <placeName ref="l648">Rhetos</placeName> latere <persName ref="p2336">Ochinum</persName>; quo <lb xml:id="p1z31"/>pervenerit scire non possum<lb xml:id="p1z32"/>.</s>
					<s n="19" xml:lang="la" ana="salute"><lb xml:id="p1z33"/>Salutant te mei omnes.</s>
					<s n="20" xml:lang="la">1564.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z34"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z2"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z3"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z4"/>ecclesiae ministro, domino <lb xml:id="p2z5"/>meo colendo et fratri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
