	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Faxit Christus, ut hic annus illuxerit tibi tuisque <lb xml:id="p1z2"/>felicissimus dominusque pergat tibi benedicere, augere <lb xml:id="p1z3"/>donis suis et protegere ab omni malo!</s>
					<s n="2" xml:lang="la">Iam <lb xml:id="p1z4"/>per mensem fere nullas ad te dedi literas propter negotia varia, <lb xml:id="p1z5"/>quibus opprimor, et sane in utilitatem vestram et <lb xml:id="p1z6"/>ecclesiae totus in eo fui, ut affinis ille et filius meus <lb xml:id="p1z7"/><persName ref="p8011">Gwaltherus</persName> sermones illos suos 6 dedicaret amplissimo consuli <lb xml:id="p1z8"/>et in praeliminari dedicatoriaque tractaret negotium, <lb xml:id="p1z9"/>quo de controvertitur apud vos.</s>
					<s n="3" xml:lang="la">Faxit Christus, ut multo <lb xml:id="p1z10"/>cum fructu id sit factum!</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Gratulor ecclesiae vestrae <lb xml:id="p1z11"/>datum esse <placeName ref="l242">Capellum</placeName>; spero enim per hunc ei consultum optime, <lb xml:id="p1z12"/>quod et a domino precibus peto.</s>
					<s n="5" xml:lang="la" ana="salute">Salutabis ipsum <lb xml:id="p1z13"/>et gratulaberis ipsi.</s>
					<s n="6" xml:lang="de">Es wirt des willens me werden <lb xml:id="p1z14"/>mitt der zyt und unwillens vil abgan.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Praesentia <lb xml:id="p1z15"/>viri docti et piae vitae mitigabit multa.</s>
					<s n="8" xml:lang="la">Si <persName ref="p20473">Ganthnerus</persName> <lb xml:id="p1z16"/>fodit foveam, videat ne in ipsam cadat<note xml:id="fn1" type="footnote" n="1">Bibelzitat (mehrere Stellen!).</note>.</s>
					<s n="9" xml:lang="la">Tu <lb xml:id="p1z17"/>perges et in synodo et extra synodum tueri verum et <lb xml:id="p1z18"/>refutare falsum.</s>
					<s n="10" xml:lang="la">Quodsi necessarius est tibi adhuc liber <lb xml:id="p1z19"/>meus retineto illum, donec abunde eo fueris usus; <lb xml:id="p1z20"/>si post mensem nunum et alterum remiseris, sat cito.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z21"/>Remitto episcopale negotium lupinum<note type="margin">a.R.: ... Volpi...!</note>.</s>
					<s n="12" xml:lang="la">Nihil aliud <lb xml:id="p1z22"/>licet expectare ab istis.</s>
					<s n="13" xml:lang="la">Dominus evertat eos!</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Quicquid <lb xml:id="p1z23"/>tu potes pro conservatione fidelium, praestabis iuvando <lb xml:id="p1z24"/>apud proceres.</s>
					<s n="15" xml:lang="la">Dominus benedicat negotio.</s>
					<s n="16" xml:lang="la">Laborandum <lb xml:id="p1z25"/>et orandum, quoad vixerimus.</s>
					<s n="17" xml:lang="la">Inclusi his chartam <lb xml:id="p1z26"/>varia continentem nova, quae partim ad me partim <lb xml:id="p1z27"/>ad <persName ref="p8011">Gwaltherum</persName> sunt perscripta.</s>
					<s n="18" xml:lang="la"><persName ref="p8033">Beza</persName> rediit <placeName ref="l167">Genevam</placeName> <lb xml:id="p1z28"/>e <placeName ref="l832">Gallia</placeName> salvus et incolumis.</s>
					<s n="19" xml:lang="la">Ecclesiae incipiunt <lb xml:id="p1z29"/>reparari in <placeName ref="l832">Gallia</placeName>.</s>
					<s n="20" xml:lang="la">Futura est ibi synodus genera<lb xml:id="p1z30"/>lis intra breve tempus; vocatur eo et <persName ref="p8033">Beza</persName>; nam <lb xml:id="p1z31"/>evangelici dumtaxat de reparandis ecclesiis in illa <lb xml:id="p1z32"/>synodo inter se consultabunt.</s>
					<s n="21" xml:lang="la">Plurima alia ad te essent <lb xml:id="p1z33"/>scribenda; sed tempore excludor.</s>
					<s n="22" xml:lang="la">Tu boni haec con<lb xml:id="p1z34"/>sulas, oro, et valeas una cum domo tua.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z35"/>12. ianuarii 1571.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z36"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="25" xml:lang="la" ana="salute"><lb xml:id="p1z37"/>Salutabis consules, <persName ref="p6130">Pontasellam</persName>, <lb xml:id="p1z38"/>d. <persName ref="p1770">Gregorium</persName>, <persName ref="p8186">Bonetum</persName> etc. <lb xml:id="p1z39"/>et alios nostros.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <lb xml:id="p2z2"/><persName ref="p8016">Tobiae Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae fidel<lb xml:id="p2z4"/>i ministro, domino et <lb xml:id="p2z5"/>fratri meo honorando <lb xml:id="p2z6"/>et dilecto.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
