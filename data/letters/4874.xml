	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><persName ref="p8110">Iustus Velsius</persName> quid apud nos egerit utque discesserit <lb xml:id="p1z2"/><persName ref="p8298">Borrhao</persName> publice notato, non arbitror vos latere, <lb xml:id="p1z3"/>quem non dubito vobis a multis iam annis clarissimo <lb xml:id="p1z4"/>praesertim viro <persName ref="p8111">Petro Martyre</persName> interprete cogn<lb xml:id="p1z5"/>itum esse.</s>
					<s n="3" xml:lang="la">Quid apud vos egerit utque exceptus <lb xml:id="p1z6"/>sit et a vobis dimissus, etsi facile possum ex iis, quae <lb xml:id="p1z7"/>apud nos impudenter et arroganter gessit, cog<lb xml:id="p1z8"/>noscere, gratum tamen erit, si ea de re certiorem <lb xml:id="p1z9"/>me feceris, si modo id per ocium, quo te minime <lb xml:id="p1z10"/>abundare scio, liceat.</s>
					<s n="4" xml:lang="la">Nolim enim tibi honestis <lb xml:id="p1z11"/>studiis occupato molestus esse, praesertim de <persName>Felsio</persName>, <lb xml:id="p1z12"/>piorum hominum et conscientiarum turbatore, <lb xml:id="p1z13"/>quas per suam illam perfectam, quam per hypocrisim <lb xml:id="p1z14"/>fingit <lb xml:id="p1z15"/>fidem, ad desperationem adigerit potius <lb xml:id="p1z16"/>quam ulla ex parte sublevet, dum renovationem <lb xml:id="p1z17"/>et regenerationem omnium in homine partium <lb xml:id="p1z18"/>corporis, animae et mentis, sublato carnis ad<lb xml:id="p1z19"/>versus spiritum per concupiscentiam bello, in iusti<lb xml:id="p1z20"/>ficatione nostri requirit et iam in hoc seculo <lb xml:id="p1z21"/>contingere docet.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="salute">Dominus eius misereatur, <lb xml:id="p1z22"/>et <persName>Helleboro</persName>, quo opus habet, non apud Anticyras <lb xml:id="p1z23"/>nato, sed in horto illo coelesti, Christus medicus <lb xml:id="p1z24"/>hanc eius vesaniam sanet et nos suamque ecclesiam <lb xml:id="p1z25"/>sponsam dilectam in salutari doctrina, <lb xml:id="p1z26"/>qua et dei patris nomen in filio amplificemus et <lb xml:id="p1z27"/>electorum salutem procuremus, pro misericordia <pb/><lb xml:id="p2z1"/>sua retineat.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Coeterum <persName>Iudaeus</persName> is rogavit me, u<lb xml:id="p2z2"/>t se tib<lb xml:id="p2z3"/>i et <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z5"/>e<lb xml:id="p2z6"/>c<lb xml:id="p2z7"/>clesia<lb xml:id="p2z8"/>e mi<lb xml:id="p2z9"/>nist<lb xml:id="p2z10"/>ris <lb xml:id="p2z11"/>comm<lb xml:id="p2z12"/>en<lb xml:id="p2z14"/>d<lb xml:id="p2z15"/>ar<lb xml:id="p2z16"/>em [<lb xml:id="p2z17"/>...].</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p2z18"/><placeName ref="l28">Ba<lb xml:id="p2z19"/>si<lb xml:id="p2z20"/>leae</placeName>, <lb xml:id="p2z21"/>16. i<lb xml:id="p2z22"/>ulii.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p2z23"/><persName ref="p8298">Ma<lb xml:id="p2z24"/>r<lb xml:id="p2z25"/>tinus <pb/><lb xml:id="p3z1"/>B<lb xml:id="p3z3"/>orrh<lb xml:id="p3z5"/>aus</persName> <lb xml:id="p3z6"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p4z2"/>Bullingero</persName>, fideli <lb xml:id="p4z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori, <lb xml:id="p4z4"/>fratri observando.</s>
				</p>
