	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime vir, diu expectavi nuncium, qui <lb xml:id="p1z2"/>hunc ad te fasciculum; tandem venit <lb xml:id="p1z3"/>valde opportunus.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z4"/>Tuas accepi diei <lb xml:id="p1z5"/>23. octobris.</s>
					<s n="3" xml:lang="la">De concilio adhuc nihil ha<lb xml:id="p1z6"/>beo egregium; nunc trans[s]ubstantiationem <lb xml:id="p1z7"/>in manibus habent.</s>
					<s n="4" xml:lang="la">At brevi <lb xml:id="p1z8"/>habebo aliquid et statim scribam.</s>
					<s n="5" xml:lang="la">Ubi legeris <lb xml:id="p1z9"/>exemplum epistolae meae ad personato<lb xml:id="p1z10"/>s <lb xml:id="p1z11"/>patres, da illam meis nepotibus, qui <lb xml:id="p1z12"/>eam descripturi sunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Si versio d. <persName ref="p8022">Francisci Nigri</persName> placuerit, <lb xml:id="p1z14"/>mitte eam ad <persName ref="p8126">Oporinum</persName>.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale et <lb xml:id="p1z15"/>salve cum tota familia, scola et <lb xml:id="p1z16"/>ecclesia.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Rogate pro me.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/><placeName ref="l93">Claven[n]ae</placeName>, nonis novembris<note type="margin">a.R.: e!</note> 1551.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Tibi <persName ref="p495">Bullingeri</persName>.</s>
				</p>
			</div>
		</body>
	</text>
