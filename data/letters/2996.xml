	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Dolet mihi, mi <persName ref="p495">Bullingere</persName>, capitis doloribus te <lb xml:id="p1z2"/>torqueri, et facti sunt illi mihi etiam nimis familiares ac saepe <lb xml:id="p1z3"/>cursum occupationum mihi intercipiunt; sic exercet et probat nos dominus <lb xml:id="p1z4"/>deus, cuius manum patienter sustineamus, qui semel liberatos <lb xml:id="p1z5"/>difficultatibus vitae ad portum transferet aerumnarum.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Non desinam eum precari, <lb xml:id="p1z6"/>ut te diu servet ecclesiae.</s>
					<s n="4" xml:lang="la"><placeName ref="l167">Genevenses</placeName> legati hic fuerunt.</s>
					<s n="5" xml:lang="la">Sed <lb xml:id="p1z7"/>cum illi nihil ulla de re praeter institutam purgationem contra exulum <lb xml:id="p1z8"/>calumnias vel verbo attingerent, nihil nostri cum ipsis egerunt, qui <lb xml:id="p1z9"/>ut sunt (nam familiariter et prolixe cum ipsis contuli) in ea prorsus <lb xml:id="p1z10"/>sententia qua et vestri, et utrique reipublicae, nisi coalescant in solidam <lb xml:id="p1z11"/>societatem, perniciem certam ominantur: ita expectant quid vester senatus, <lb xml:id="p1z12"/>quem iam norunt conscium rerum omnium, super hoc negocio tentandum esse <lb xml:id="p1z13"/>statuat: quare velim mature aliquid agi.</s>
					<s n="6" xml:lang="la">Ad <placeName ref="l41">Bernates</placeName> iam quosdam <lb xml:id="p1z14"/>scripsi et egi hic um aliquibus ex maiori senatu, coram <lb xml:id="p1z15"/>amicis <placeName ref="l41">Bernensibus</placeName> acturus cum pluribus.</s>
					<s n="7" xml:lang="la">Videntur autem et fratres excitandi <lb xml:id="p1z16"/>quod a te etiam fieri velim, ut serio huc et publice et privatim incumbant, <lb xml:id="p1z17"/>quo paratiores animos ad omnimodam conciliationem efficiant.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z18"/><persName>Chalcographus</persName> a te commendatus plane mihi talis videtur, qualis <lb xml:id="p1z19"/>a te pingitur, eoque magis gaudeo conditionem illi obtigisse apud <lb xml:id="p1z20"/>marchionem.</s>
					<s n="9" xml:lang="la" ana="farewell">Bene vale in Christo Iesu, et quaeso ut huic <lb xml:id="p1z21"/>ipsi, qui has perfert, rationem indices, qua possit certo et tuto <lb xml:id="p1z22"/>meas ad consulem <placeName>Glareanum</placeName> et d. <persName ref="p8303">Fridolinum Brunnerum</persName> literas trans<lb xml:id="p1z23"/>mittere.</s>
					<s n="10" xml:lang="la">Scribe item, cum primum potes, de <placeName ref="l646">Glaronensium</placeName> rerum statu.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/><placeName ref="l28">Basileae</placeName> 25. augusti anno 1556.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z25"/>Tuus <lb xml:id="p1z26"/><persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>viro praestantissimo, domino <lb xml:id="p2z3"/>et symmistae colendissimo <lb xml:id="p2z4"/>suo.</s>
				</p>
			</div>
		</body>
	</text>
