	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nihil habeo in praesentiarum, quod ad te scribam, charissime <lb xml:id="p1z2"/>compater, quam quod D. <persName ref="p8417">musculi</persName> uxor heri foelici partu filium <lb xml:id="p1z3"/>elegantem enixa est, quem hodie <persName ref="p3170">Felix Toblerus</persName> tuo nomine et <lb xml:id="p1z4"/>ego de sacro fonte levavimus simulque <persName ref="p20955">Elizabetha</persName>, D. <persName ref="p8467">Ioannis Textorii</persName> <lb xml:id="p1z5"/>filia.</s>
					<s n="3" xml:lang="la">Aureum pro te ita, ut iussisti, nummum exposui, Valet <lb xml:id="p1z6"/>puerpera, valet infans et utriusque tota familia, nisi quod <lb xml:id="p1z7"/>18. huius mensis <persName ref="p8416">Abrahamus</persName>, <persName ref="p8417">Musculi</persName> filius, gravi casu crus <lb xml:id="p1z8"/>fregit non exiguum dolorem parentibus et nobis omnibus faciens; <lb xml:id="p1z9"/>sed probe curatur et aliquantum convalescere incipit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Haec tamen quoniam <lb xml:id="p1z10"/>ex ipsius literis copiosius cognosces, supervacaneum me longius persequi.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Infans utriusque nostrum nomen habet <persName ref="p2207">Ioannes Heinrychus</persName> no<lb xml:id="p1z12"/>minatus, sicut fieri praestitueras.</s>
					<s n="6" xml:lang="la">Expecto a te responsum <lb xml:id="p1z13"/>ad meas proximas, quas tibi non exiguum attulisse spero gaudium.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Ego propediem deo volente ad vos veniam.</s>
					<s n="8" xml:lang="la" ana="salute">Interea bene vale <lb xml:id="p1z15"/>et ex me meaque uxore tuam cum tota familia salvere iube.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/><placeName ref="l41">Bernae</placeName> 22. septembris 1549.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Salutat te <persName ref="p3700">Eberhardus</persName> et <foreign xml:lang="el">[griechisch]</foreign> noster.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z17"/>Tuus ex animo <lb xml:id="p1z18"/><persName ref="p8018">Ioann<lb xml:id="p1z19"/>es <lb xml:id="p1z20"/>Hallerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro D. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, suo colendo <lb xml:id="p2z3"/>domino et compatri.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
