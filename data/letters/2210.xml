	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l491">Argentinae</placeName> 1. die martii <lb xml:id="p1z2"/>1554.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>S. D.</s>
					<s n="3" xml:lang="la">Sub finem februarii eas demum <lb xml:id="p1z4"/>accepi literas, quas tu ad me 17. novembris dederas; <lb xml:id="p1z5"/>sed eo nihil detrimenti sentiebam.</s>
					<s n="4" xml:lang="la">Illud autem <lb xml:id="p1z6"/>valere vos et salvos esse ex literis intelligo, id quod <lb xml:id="p1z7"/>ita iucundum, ut nihil possit esse iucundius.</s>
					<s n="5" xml:lang="la">Deum <lb xml:id="p1z8"/>autem precor, ut sicut mihi iucunda sic vobis non lęta <lb xml:id="p1z9"/>solum, sed diuturna sit salus et valetudo optima.</s>
					<s n="6" xml:lang="la">Ego <lb xml:id="p1z10"/>certe, et qui mecum sunt in nostra domo, omnes valemus.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>Adiectae sunt lectionibus, quibus interesse soleo, lectiones <lb xml:id="p1z12"/>etiam d. d. <persName ref="p8111">Petri Martyris</persName>, viri ut doctrina sic <lb xml:id="p1z13"/>pietate excellentissimi, qui quidem apud nos receptus <lb xml:id="p1z14"/>est in ordinem canonicorum S. Thomae.</s>
					<s n="8" xml:lang="la">Pręter <persName ref="p8111">Martyris</persName> <lb xml:id="p1z15"/>in librum Iudicum et in Ethicam Aristotelis <lb xml:id="p1z16"/>lectiones expectamus d. d. <persName ref="p4037">Zanchi</persName> expositionem in <lb xml:id="p1z17"/>Physicam Aristotelis.</s>
					<s n="9" xml:lang="la">D. <persName ref="p8111">Petrus Martyr</persName> me amice di<lb xml:id="p1z18"/>ligit, pollicetur suam operam mihi nunquam defuturam, <lb xml:id="p1z19"/>mihique in primis ornandus et excolendus est, quod et <lb xml:id="p1z20"/>conor et studio, quantum possum.</s>
					<s n="10" xml:lang="la">Sed quod te forte non <lb xml:id="p1z21"/>latet: venerunt ad nos plurimi boni viri ex <placeName ref="l830">Anglia</placeName> <lb xml:id="p1z22"/>propter evangelium expulsi partim ex <placeName ref="l86">Cantabrigia</placeName>, pa<lb xml:id="p1z23"/>rtim <lb xml:id="p1z24"/>vero ex <placeName ref="l376">Oxonia</placeName>, quorum e numero unum tibi prę caeteris <lb xml:id="p1z25"/>commendo: D. <persName ref="p1911">Thomam Leverum</persName> tui cupidissimum, <lb xml:id="p1z26"/>pium et sincerę religionis, qui una cum aliis <lb xml:id="p1z27"/>fortunis propter evangelium relictis peregrinam terram <lb xml:id="p1z28"/>invisere cogitur.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Dominus deus noster tandem <placeName ref="l830">Angliam</placeName> cęter<lb xml:id="p1z29"/>asque ecclesias misere adflictas restituat in integrum <lb xml:id="p1z30"/>statum.</s>
					<s n="12" xml:lang="la">Discedenti (mi pater) inculcare, hoc est praeciper<lb xml:id="p1z31"/>e <lb xml:id="p1z32"/>non desiisti, ut hic Graeca Latinis coniungerem, nunc <lb xml:id="p1z33"/>ut ex Graecis Latina nunc ex Latinis ut Graeca <lb xml:id="p1z34"/>facerem.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z35"/>Quod certo cum facio, illius fructum non minorem <lb xml:id="p1z36"/>reperio, quam tu eum futurum esse dicebas; hinc enim <lb xml:id="p1z37"/>copia verborum, varietas figurarum, explicandi facilitas, <lb xml:id="p1z38"/>inveniendi facultas, optimorum denique imitatio paratur, <lb xml:id="p1z39"/>intelligentia acuitur, iuditium acquiritur.</s>
					<s n="14" xml:lang="la">Habes ergo <lb xml:id="p1z40"/>hic, chare pater, experimentum aliquod meae diligentiae epistolam <lb xml:id="p1z41"/>scilicet <persName>Isocratis</persName> ex Graecis per me in Latinam <lb xml:id="p1z42"/>translata.</s>
					<s n="15" xml:lang="la">Praeterea, quod scriberem, nihil erat.</s>
					<s n="16" xml:lang="la" ana="salute"><pb/><lb xml:id="p2z1"/>Salutant te commilitones mei; te salvum vult tota <lb xml:id="p2z2"/>domus nostra.</s>
					<s n="17" xml:lang="la" ana="salute">Salutat te <persName>Gabriel</persName> coriarius <placeName ref="l267">Coloniensis</placeName>, <lb xml:id="p2z3"/>qui, si aliquid velis a d. <persName ref="p8041">Ioannem a Lasco</persName> in <lb xml:id="p2z4"/><placeName ref="l734">Phrisiam</placeName> scribere, diligenter curabit; ipse enim intra tres septimanas eo <lb xml:id="p2z5"/>profecturus est.</s>
					<s n="18" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><persName ref="p495">Heinrychus Bullingerus</persName>, filius tuus dilec<lb xml:id="p2z6"/>tus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="20" xml:lang="la">Eximio viro d. m. <persName ref="p495">Heinrycho Bul<lb xml:id="p2z7"/>lingero</persName>, patri suo plurimum observa<lb xml:id="p2z8"/>ndo.</s>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
					<s n="22" xml:lang="de"><placeName ref="l587">Züric[h]</placeName>.</s>
				</p>
