	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Redeunt ad vos, <persName ref="p495">Bullingere</persName> doctissime, dilecti <lb xml:id="p1z2"/>in domino fratres, <persName ref="p8130">Laurentius Agricola</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8130">Lorenz Meyer (Agricola)</persName>.</note> et <persName ref="p6544">Rudolfus <lb xml:id="p1z3"/>Schwitzer</persName>.<note xml:id="fn2" type="footnote" n="2"><persName ref="p6544">Rudolf Schwyzer d.Ä.</persName></note></s>
					<s n="3" xml:lang="la">Redeunt autem, non reiecti a nostris<note xml:id="fn3" type="footnote" n="3">Gemeint sind die <placeName ref="l18">Augsburger</placeName> Ratsherren.</note> <lb xml:id="p1z4"/>nec sua aliqua temeritate, sed propter mise<lb xml:id="p1z5"/>rabilem statum, imo verius lapsum nostrę huius <lb xml:id="p1z6"/>urbis.<note xml:id="fn4" type="footnote" n="4">Zur Unterwerfung <placeName ref="l18">Augsburgs</placeName> unter Kaiser <persName ref="p18538">Karl V.</persName> s. <ref target="file12818">Nr. 2769</ref>, Anm. 7.</note></s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="4" xml:lang="la">Sperabatur toti diocesi posse praedi<lb xml:id="p1z7"/>catione evangelii consuli propter eiectum papatum<lb xml:id="p1z8"/>, ad quam rem nostri ministros verbi <lb xml:id="p1z9"/>undequaque<note xml:id="fn5" type="footnote" n="5">Nämlich auch von <placeName ref="l28">Basel</placeName> und <placeName ref="l491">Straßburg</placeName>.</note> vocare sta-<pb type="edition" next="392"/>tuerant; ob quam causam <lb xml:id="p1z10"/>dicti etiam fratres ad nos vocati sunt.</s>
					<s n="5" xml:lang="la">Verum <lb xml:id="p1z11"/>(quoniam spes ista, quantum praesentem rerum <lb xml:id="p1z12"/>statum concernit, prorsus evanuit, ita ut <lb xml:id="p1z13"/>totus ager in manus pfafforum redierit, <lb xml:id="p1z14"/>factumque est, ut causa vocationis ipsorum <lb xml:id="p1z15"/>desierit, et urbs haec alioqui ministris <lb xml:id="p1z16"/>verbi abundat, quorum aliqui ex agro pulsi <lb xml:id="p1z17"/>hic haerent<note xml:id="fn6" type="footnote" n="6">Vgl. <ref target="file12886">Nr. 2837</ref>,3.</note>)<note xml:id="fna" type="footnote" n="a"><hi>Klammern ergänzt.</hi></note> iudicarunt dicti fratres, et meo <lb xml:id="p1z18"/>iudicio non absque ratione, consultum esse, <lb xml:id="p1z19"/>ut ad suos reverterentur, id quod vestri<note xml:id="fn7" type="footnote" n="7">Gemeint ist der <placeName ref="l587">Zürcher</placeName> Rat.</note> <lb xml:id="p1z20"/>dubio procul boni consulent.</s>
					<s n="6" xml:lang="la">Quam honorifice <lb xml:id="p1z21"/>dimissi sint a nostris, ipsi referent.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z22"/>De urbe hac et ecclesia nostra cognosces ex <lb xml:id="p1z23"/>ipsis, ut necesse non sit aliquid rerum nostrarum <lb xml:id="p1z24"/>chartae committere.</s>
					<s n="8" xml:lang="la">Quae mihi spes sit <lb xml:id="p1z25"/>hic manendi, et ipsum illi tibi indicare <lb xml:id="p1z26"/>possunt.</s>
					<s n="9" xml:lang="la">Si non dabitur hic manendi li<lb xml:id="p1z27"/>bertas, dabitur forsan, ut <placeName ref="l862">Helvetiam</placeName> vestram <lb xml:id="p1z28"/>aliquando tanquam asylum ministrorum Christi <lb xml:id="p1z29"/>videam.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="10" xml:lang="la">Reliqui duo, <persName ref="p8018">Hallerus</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p8018">Johannes Haller</persName>.</note> et <persName ref="p2812">Rummanus</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p2812">(Hans) Thoman Ruman (Römer)</persName>.</note>, <lb xml:id="p1z30"/>quem una addita litera rectius vocaremus <lb xml:id="p1z31"/>Frumman, diutius apud nos manere const<lb xml:id="p1z32"/>ituerunt, qua de <lb xml:id="p1z33"/>re ex ipsorum forsa<lb xml:id="p1z34"/>n liter<lb xml:id="p1z35"/>is<note xml:id="fn10" type="footnote" n="10">Bekannt ist nur ein Brief <persName ref="p8018">Hallers</persName> vom 5. März (<ref target="file12886">Nr. 2837</ref>).</note> intelliges.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="11" xml:lang="la" ana="farewell">Bene in domino vale, virorum <lb xml:id="p1z36"/>colendissime.</s>
					<s n="12" xml:lang="la"><placeName ref="l18">Augustae Vindelicorum</placeName>, 1547, 5. martii.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z37"/><persName ref="p8417">W. Musculus</persName> <lb xml:id="p1z38"/>tuus in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae <lb xml:id="p2z5"/>antistiti fidelissimo, <lb xml:id="p2z6"/>domino ac fratri <lb xml:id="p2z7"/>plurimum colendo.<note xml:id="fn11" type="footnote" n="11">Dieser Brief wurde wie auch die Briefe gleichen Datums von <persName ref="p8018">Haller</persName> (<ref target="file12886">Nr. 2837</ref>) und von <persName ref="p1860">Michael Keller</persName> (Nr. 2838) durch <persName ref="p8130">Meyer</persName> und <persName ref="p6544">Schwyzer</persName> übermittelt, denen <persName ref="p7197">Hans Wilpert Zoller</persName> als Begleiter zugewiesen wurde; s. <ref target="file12893">Nr. 2844</ref>,1f.</note></s>
				</p>
			</div>
		</body>
