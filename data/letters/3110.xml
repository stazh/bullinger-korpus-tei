	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Heri post horam 4am pomeridianam, charissime <lb xml:id="p1z3"/><persName ref="p495">Bullinger</persName>, tuę mihi sunt oblatę.</s>
					<s n="3" xml:lang="la" ana="salute">Propternoctis <lb xml:id="p1z4"/>coenam tempestatem non licuit optimos viros accedere; <lb xml:id="p1z5"/>hodie omnes invisere et circa horam octavam salutare <lb xml:id="p1z6"/>illos et ad prandium vel coenam, utrum placuisset, <lb xml:id="p1z7"/>vocare volui.</s>
					<s n="4" xml:lang="la">En nunciatur triste, nempe eos iam <lb xml:id="p1z8"/>ocreatos et petasatos itineri committere velle, <lb xml:id="p1z9"/>quare unum licuit <persName>Raphaelem</persName> meum ad illos mittere, <lb xml:id="p1z10"/>generosum piscem et vina ex mea illa vinaria <lb xml:id="p1z11"/>ut offerret, quae alioqui in aedibus meis uberius <lb xml:id="p1z12"/>et liberalius fuissent oblata.</s>
					<s n="5" xml:lang="la">Dolet valde, quod [non] <lb xml:id="p1z13"/>licuit, quod tamen maxime volui, quare mola s<lb xml:id="p1z14"/>alsa litare temporis brevitas coegit, cum <lb xml:id="p1z15"/>alioqui thure odorifero fuissent excepti.</s>
					<s n="6" xml:lang="la">Peto <lb xml:id="p1z16"/>occasionem hanc boni consulito.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/>De filio tuo non sis sollicitus; omnem navabo <lb xml:id="p1z18"/>laborem, ne ei defuisse videar.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z19"/>Scribenda essent plura, sed abituros <lb xml:id="p1z20"/>remorari nolui.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z21"/>De comitiis nihil spero.</s>
					<s n="10" xml:lang="la">Rex duodecies cent na(?) <lb xml:id="p1z22"/>millia petit, auxiliares nimirum copias <lb xml:id="p1z23"/>adversus <placeName ref="l2510">Turcę</placeName> rabiem.</s>
					<s n="11" xml:lang="la">Ego timeo, ne magna <lb xml:id="p1z24"/>pars abitura sit ad sedandos creditorum <lb xml:id="p1z25"/>insultus, qui miserum regem fecerunt <lb xml:id="p1z26"/>o<lb xml:id="p1z27"/>mn<lb xml:id="p1z28"/>ino e<lb xml:id="p1z29"/>xanguem.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Re<lb xml:id="p1z30"/>ligio<lb xml:id="p1z31"/>nem co<lb xml:id="p1z32"/>mpos..<lb xml:id="p1z33"/>. <placeName>Sid<pb/><lb xml:id="p2z1"/>onii</placeName>, <placeName>Ca<lb xml:id="p2z2"/>nisii</placeName>, <persName>W<lb xml:id="p2z3"/>icelii</persName><lb xml:id="p2z4"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
