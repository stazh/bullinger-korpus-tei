	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus et pax Christi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>O deus, quantum exhilerasti me literis tuis<note xml:id="fn1" type="footnote" n="1">Nicht erhalten.</note> ob <lb xml:id="p1z3"/>felicissima ista nuntia de sopita contentione inter <lb xml:id="p1z4"/>fratres <placeName ref="l41">Bernenses</placeName><note xml:id="fn2" type="footnote" n="2">Zur <placeName ref="l41">Berner</placeName> Synode von Ende Mai s. die Berichte <persName ref="p8412">Meganders</persName> oben <ref target="file11041">Nr. 999</ref>, 16-21, und unten <ref target="file11052">Nr. 1010</ref>, 1-65.</note> et extincto Arianismi incendio<note xml:id="fn3" type="footnote" n="3">Vgl. die von <persName ref="p8412">Megander</persName> übermittelten und durch <persName ref="p495">Bullinger</persName> auch an <persName ref="p8049">Vadian</persName> weitergeleiteten Nachrichten über die <placeName ref="l280">Lausanner</placeName> Synode vom 14. Mai und den Widerruf des Antitrinitariers <persName ref="p7242">Claude d'Aliod</persName>, oben <ref target="file11041">Nr. 999</ref>, 9-15, bzw. <ref target="file11049">Nr. 1007</ref>.</note> <lb xml:id="p1z5"/>optimoque illo in<note xml:id="fna" type="footnote" n="a">in <hi>über der Zeile nachgetragen.</hi></note> <placeName ref="l830">Anglia</placeName> successu<note xml:id="fn4" type="footnote" n="4">Gemeint ist die Niederschlagung des Aufstandes, der als "Pilgrimage of Grace" in die Geschichte einging; vgl. oben <ref target="file11026">Nr. 984</ref> und 1007.</note>.</s>
					<s n="3" xml:lang="la">Domino sint perpetuae <lb xml:id="p1z6"/>gratiae, quod semper adstet nobis!</s>
					<s n="4" xml:lang="la">Miraris autem, cur <lb xml:id="p1z7"/>ego ad te nihil.</s>
					<s n="5" xml:lang="la">Sed quid fingam, mi frater, si <lb xml:id="p1z8"/>veri nihil sit prae manibus?</s>
					<s n="6" xml:lang="la">Non sum tam natus <lb xml:id="p1z9"/>ad fingendum.</s>
					<s n="7" xml:lang="la">Patienter feras itaque silentium, <lb xml:id="p1z10"/>donec aliqua sit scribendi occasio, quam nunc <lb xml:id="p1z11"/>ex <placeName ref="l18">Augusta</placeName> et <placeName ref="l491">Argentorato</placeName> expecto.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/>Unum hoc iam volo, ut, si possis, impedias <lb xml:id="p1z13"/><persName ref="p7242">Claudium <span type="pronoun">illum</span> Sabaudum</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p7242">Claude d'Aliod</persName>.</note>, ne ad nos veniat <lb xml:id="p1z14"/>aut alias ecclesias de nostris; non enim efficiet <lb xml:id="p1z15"/>quicquam, nisi quod in memoriam<note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> memoriam <hi>gestrichenes</hi> re.</note> revocabit priora<note xml:id="fnc" type="footnote" n="c"><hi>vor</hi> priora <hi>gestrichenes</hi> p.</note><note xml:id="fn6" type="footnote" n="6"><persName ref="p7242">D'Aliod</persName> war 1534 wegen seiner Lehre aus <placeName ref="l257">Konstanz</placeName> ausgewiesen worden; s. <persName ref="p8049">Vadian</persName> BW V 182f.</note>, <lb xml:id="p1z16"/>ut credam minus profuturum<pb type="edition" next="175"/> illius ad nostros adventum.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/>Si viatico opus est illi, numera<note xml:id="fnd" type="footnote" n="d"><hi>vor</hi> numera <hi>gestrichenes</hi> d.</note> dimidium aureum, <lb xml:id="p1z18"/>quem ego restituam.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Hęc tumultuanter; nam <lb xml:id="p1z19"/><placeName ref="l28">Basiliensis</placeName> contionator <persName ref="p8466">Wolfgangus</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p8466">Wolfgang Wissenburg</persName>.</note> apud nos <lb xml:id="p1z20"/>est, quocum cogor tempus absumere.</s>
					<s n="11" xml:lang="la">De aliis pro<lb xml:id="p1z21"/>xime.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale diutissime cum tota familia <lb xml:id="p1z22"/>et bonis omnibus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z23"/>19. iunii 1537.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z24"/>Tuus <persName ref="p4079">Io. Zwick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vigilantissimo Christi <lb xml:id="p2z2"/>ministro d. <persName ref="p495">Hainricho <lb xml:id="p2z3"/>Bullingero</persName>, et domino <lb xml:id="p2z4"/>et fratri suo studiosissime <lb xml:id="p2z5"/>colendo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>