	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nihil, quod scribam, occurrit nisi me expectare responsum ad meas <lb xml:id="p1z2"/>ultimas literas, nos bene valere, negocium etiam religionis magnos <lb xml:id="p1z3"/>indies progressus facere etiam invitus omnibus perditis.</s>
					<s n="3" xml:lang="la">Et cum nunc d. <persName ref="p8160">Bellieure</persName> <lb xml:id="p1z4"/>legati officio fungatur, literis frequentioribus amicitiam nostram fruere tutum <lb xml:id="p1z5"/>et integrum erit.</s>
					<s n="4" xml:lang="la" ana="salute">Salutat te plurimum uxor.</s>
					<s n="5" xml:lang="la" ana="salute">Salutabis amplissimum senatum <lb xml:id="p1z6"/>et amicos omnes.</s>
					<s n="6" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="7" xml:lang="la"><placeName ref="l378">Parisiis</placeName> raptim 6. martii 1566.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z7"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henricho Bullingero</persName>, <placeName ref="l587">Tigurine</placeName> <lb xml:id="p2z2"/>ecclesie pastori vigilantissimo.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
