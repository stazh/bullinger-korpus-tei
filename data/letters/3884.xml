	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Plura in dies tibi debeo, vir honorande; nam et nuper <placeName ref="l18">Augustam</placeName> <lb xml:id="p1z2"/>sedulo ac diligenter scripsisti mei gratia et iam anxius <lb xml:id="p1z3"/>es mecum tardius curatis litteris clarissimi viri d. doctoris <lb xml:id="p1z4"/>Hyperii.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Utinam vero et occasio et locus declarandi <lb xml:id="p1z5"/>animi mei erga te promptam gratitudinem mihi <lb xml:id="p1z6"/>aliquando daretur; interea, quod unicum possum, verbis tibi <lb xml:id="p1z7"/>immortales habeo gratias pro tuo in me candore petoque <lb xml:id="p1z8"/>me sic perpetuo charitati tuae commendatum esse et pro<lb xml:id="p1z9"/>tegi.</s>
					<s n="4" xml:lang="la">D. <persName ref="p8386">doctori Hyperio</persName> scripseram summo mane <lb xml:id="p1z10"/>eius diei, quo circa vesperam tuae mihi redditę sunt, <lb xml:id="p1z11"/>et hoc unicum scripseram mirari me nil ad mea postulata <lb xml:id="p1z12"/>hactenus esse responsum.</s>
					<s n="5" xml:lang="la">Alteras postea exaravi profunda <lb xml:id="p1z13"/>nocte ac, quid interea acceperim, ostendi, nihil tamen <lb xml:id="p1z14"/>iam effici posse, donec domini legati, qui 3. martii con<lb xml:id="p1z15"/>venient <placeName ref="l330">Morgiae</placeName> et causam scholae <placeName ref="l280">Lausanensis</placeName> inspicient, [rever]si fuerint; <lb xml:id="p1z16"/>simul rogavi, ut in eo proposito persistat, effecturos <lb xml:id="p1z17"/>nos reversis legatis, ut domini nostri liberali stipendio <lb xml:id="p1z18"/>ipsum vocent.</s>
					<s n="6" xml:lang="la">Remitto tibi literas tuas et simul <lb xml:id="p1z19"/>pro iis communicatis gratiam habeo; cupio etiam, ut <lb xml:id="p1z20"/>ipsius litteras ad me scriptas legas et videas eius <lb xml:id="p1z21"/>promptitudinem et in ea causa postea nos adiuves, <lb xml:id="p1z22"/>quo hominem ad nos pertrahamus.</s>
					<s n="7" xml:lang="la">Pro libro <lb xml:id="p1z23"/>donato enixe habeo gratiam; placet <foreign xml:lang="el">καλά πάντα</foreign> <lb xml:id="p1z24"/>et placebit caeteris, immo proderit plurimis, qui in <lb xml:id="p1z25"/>eo negotio periclitantur, et forsan multis elabendi <lb xml:id="p1z26"/>pericula viam exhibebit.</s>
					<s n="8" xml:lang="la">D. Iesus Christus te nobis diu incolumem servet.</s>
					<s n="9" xml:lang="la">Amen.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z27"/>1559. 4. martii <placeName ref="l41">Bernę</placeName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z28"/>T[uus] t[otus] ex animo <lb xml:id="p1z29"/><persName ref="p8092">Benedictus Martius</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z30"/>Clariss<pb/><lb xml:id="p2z1"/>imo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, ecclesię Christi <lb xml:id="p2z3"/>ministro vigilantissimo, domino <lb xml:id="p2z4"/>suo pie colendo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
