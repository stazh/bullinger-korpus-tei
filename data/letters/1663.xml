	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nostrarum rerum nihil habeo, quod scrib<lb xml:id="p1z2"/>am omnino, nisi quod recte valemus omnes.</s>
					<s n="3" xml:lang="la">Miramur <lb xml:id="p1z3"/><persName ref="p8114">Artopoeum</persName> tamdiu apud <placeName ref="l648">Rhoetos</placeName> moram trahere.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/><persName ref="p8417">Musculi</persName> recens natus infans obiit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Uxoris vitricus venit ex <placeName ref="l691">Lotharingia</placeName>, qui <lb xml:id="p1z6"/>dicit multa oppida a <placeName ref="l832">Gallo</placeName> occupata deficere <lb xml:id="p1z7"/>iterum et novum in has partes a <placeName ref="l832">Gallo</placeName> ducendum <lb xml:id="p1z8"/>exercitum, qui disperdat omnia.</s>
					<s n="6" xml:lang="la">De <persName ref="p18250">Mauritio</persName> <lb xml:id="p1z9"/>et principibus nihil prorsus audimus neque de <placeName ref="l361">Norinber<lb xml:id="p1z10"/>gensibus</placeName>, nisi quod a marchione caesi sint.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Scribe, quę<lb xml:id="p1z11"/>so, si quid habes.</s>
					<s n="8" xml:lang="la"><persName ref="p2411">Otto Heinrich</persName> vocavit <persName ref="p8417">Mu<lb xml:id="p1z12"/>sculum</persName> et <persName ref="p8055">Blaurerum</persName> ad instaurandas ditionis <lb xml:id="p1z14"/>suę ecclesias.</s>
					<s n="9" xml:lang="la"><persName ref="p8417">Muscu<lb xml:id="p1z15"/>lus</persName> <lb xml:id="p1z16"/><placeName ref="l49">Bielnas</placeName> profectus ad <lb xml:id="p1z17"/><persName ref="p8055">Blaurerum</persName> communicatoque invicem consilio ambo communi re<lb xml:id="p1z18"/>sponso vocationem renuerunt intenti alter ad <placeName ref="l18">Augustam</placeName> <lb xml:id="p1z19"/>alter ad suam <placeName ref="l257">Constantiam</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Haec sunt, <lb xml:id="p1z20"/>quę habeo.</s>
					<s n="11" xml:lang="la">Legati <placeName ref="l21">Badenam</placeName> sunt <persName ref="p8389">Hagius</persName> <lb xml:id="p1z21"/>et <persName ref="p6037">Pastor</persName> pandaretę ambo.</s>
					<s n="12" xml:lang="la" ana="salute">Salutat vos <lb xml:id="p1z22"/>mea familia omnis et <persName ref="p8417">Musculi</persName> quoque.</s>
					<s n="13" xml:lang="la">Salvi sint <lb xml:id="p1z23"/>omnes tui.</s>
					<s n="14" xml:lang="la">Raptim <placeName ref="l41">Bernę</placeName> 23. iunii 1552.</s>
