	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Quamquam non putem te latere reginam <placeName ref="l830">Angliae</placeName> <lb xml:id="p1z2"/><persName ref="p18554">Mariam</persName> una cum foetu periisse, nolui tamen <lb xml:id="p1z3"/>obmit[t]ere, quin tibi scriberem.</s>
					<s n="2" xml:lang="la">Quid autem post <lb xml:id="p1z4"/>ipsius di[s]cessum actum sit, nihil adhuc audivi; <lb xml:id="p1z5"/>spero tamen evangelium ibi restitu[tu]m iri brevi.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Rex <placeName ref="l1209">Navarae</placeName> non mortuus est, valde tamen <lb xml:id="p1z7"/>egrotavit.</s>
					<s n="4" xml:lang="la">Episcopus <placeName ref="l546">Viennensis</placeName> ita pure et <lb xml:id="p1z9"/>aperte evangelium in suo episcopatu predicavit, <lb xml:id="p1z10"/>ut non dubitaverit vocare missam abominationem.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Rex <placeName ref="l832">Galliae</placeName> iussit illum ad se venire, ut illic <lb xml:id="p1z12"/>rationem suae doctrinae red[d]at.</s>
					<s n="6" xml:lang="la">Hunc itaque vobis com[m]<lb xml:id="p1z13"/>endo, ut <lb xml:id="p1z14"/>pro eo dominum omnipotentem oretis.</s>
					<s n="7" xml:lang="la">De <lb xml:id="p1z15"/>inimicis veritatis, qui semper aliquid novi contra <lb xml:id="p1z16"/>d. <persName ref="p540">Calvinum</persName> moliuntur, nihil tibi scribo eo, <lb xml:id="p1z17"/>quod satis noveris.</s>
					<s n="8" xml:lang="la">Faxit autem deus omnipotens, <lb xml:id="p1z18"/>ut omnia in suam gloriam vertantur.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale, sincerissime <lb xml:id="p1z19"/>dei minister.</s>
					<s n="10" xml:lang="la">Si quid aliud novi intel[l]igere possim, <lb xml:id="p1z21"/>tibi significabo.</s>
					<s n="11" xml:lang="la">Hanc raptim interea tibi scripsi ex <placeName ref="l41">Berna</placeName> <lb xml:id="p1z22"/>perindie ascensionis domini.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/>Tuus ex animo <lb xml:id="p1z24"/><persName ref="p8285">Sechelles</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z2"/>Doctissimo atque pientissimo viro <lb xml:id="p2z3"/>d. <persName ref="p495">Bulingero</persName>, ecclesiae <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> pastori vigilantissimo, <lb xml:id="p2z5"/>amico suo colendissimo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName><note xml:id="fn1" type="footnote" n="1">richtig: perendie = übermorgen - 25. Mai /Himmelfahrt 1555: 23. Mai.</note>.</s>
				</p>
			</div>
		</body>
	</text>
