	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Rursus accepi, quae misisti, omnia, colendissime domine <lb xml:id="p1z2"/>et compater, et priora quidem, scripta scilicet de disciplina <lb xml:id="p1z3"/>per huncce, qui se commode nobis offerebat, remitto.</s>
					<s n="3" xml:lang="la">Quae <lb xml:id="p1z4"/>vero modo per <placeName ref="l269">Küngßfeldam</placeName> misisti, quoniam ne<lb xml:id="p1z5"/>mini adhuc communicare potui, per proximum aliquem <lb xml:id="p1z6"/>remittam.</s>
					<s n="4" xml:lang="la">Ago autem tibi pro his omnibus gratias; agit <lb xml:id="p1z7"/>item <persName>Aretius</persName>, quem et ipsum ad te scripturum existimo.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Mira sane est inversio rerum, quod <placeName ref="l558">Wittenberga</placeName>, <lb xml:id="p1z9"/>ubi <persName ref="p1974">Lutherus</persName> sedem doctrinae suae immutabilem et <lb xml:id="p1z10"/>aeternam collocasse videbatur, nunc pro nobis contra Lu<lb xml:id="p1z11"/>therianos reliquos stet et <placeName ref="l28">Basilae</placeName> e diverso, ubi ipse <lb xml:id="p1z12"/><persName ref="p2442">Oecolampadius</persName> veritatis doctrinam contra <persName ref="p1974">Lutherum</persName> de<lb xml:id="p1z13"/>fendit, nunc Lutherani in universum regnent.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Sol<lb xml:id="p1z14"/>antur illa nos plurimum, haec vero terrent et vi<lb xml:id="p1z15"/>gilare docent.</s>
					<s n="7" xml:lang="la">Cupimus autem et ipsi videre <placeName ref="l558">Wittenbergensium</placeName> <lb xml:id="p1z16"/>scriptum, de quo scribis, modo eius cito nobis copia fieri <lb xml:id="p1z17"/>possit.</s>
					<s n="8" xml:lang="la">Novi nihil habemus, neque dum scio, quid <lb xml:id="p1z18"/><placeName ref="l21">Badenae</placeName> sit actum aut conclusum.</s>
					<s n="9" xml:lang="la"><persName ref="p8063">Steigerus</persName> nondum <lb xml:id="p1z19"/>ex <placeName>Rotulanis</placeName> suis vindemiis reversus est.</s>
					<s n="10" xml:lang="la">Vini minor <lb xml:id="p1z20"/>apud nos quoque eventus fuit, quam speratum fuerit; <lb xml:id="p1z21"/>tantum in superioribus regionis huius partibus, Tuni <lb xml:id="p1z22"/>scilicet et passim ad lacum Tunensem proventus omnem <lb xml:id="p1z23"/>spem mirabiliter superavit, ita ut multis in annis <lb xml:id="p1z24"/>tanta tamque boni vini copia non provenerit ac hoc <lb xml:id="p1z25"/>anno.</s>
					<s n="11" xml:lang="la">Ita dispensat bonitas domini dona sua mi<lb xml:id="p1z26"/>rabiliter, prout illi placuerit.</s>
					<s n="12" xml:lang="la">Frumentum octo libris <lb xml:id="p1z27"/>venditur, et quamvis illud multum sit et graviter <lb xml:id="p1z28"/>premantur pauperes, felices tamen adhuc nobis videmur <lb xml:id="p1z29"/>in his partibus, si nostrae res cum vestris aut exteris <lb xml:id="p1z30"/>conferantur.</s>
					<s n="13" xml:lang="la">Dominus misereatur nostri et pauperes suos <lb xml:id="p1z31"/>passim rursus sereno et clementi vultu intueatur.</s>
					<s n="14" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z32"/>Salutant te <placeName>Mülinensis</placeName> consul, quaestores ambo, amici <lb xml:id="p1z33"/>praeterea et fratres omnes.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Socer est <placeName ref="l269">Küngßfeldae</placeName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l41">Bernae</placeName> <lb xml:id="p1z34"/>12. octobris 1571.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Salvi sint tui omnes.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z35"/><persName ref="p8018">Iohannes Hallerus</persName>, <lb xml:id="p1z36"/>tuus perpetuus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino <lb xml:id="p2z4"/>meo honorando et compatri <lb xml:id="p2z5"/>charissimo.</s>
				</p>
				<p>
					<s n="21" xml:lang="de"><lb xml:id="p2z6"/>M. <persName ref="p495">Heinrych Bullinger</persName><lb xml:id="p2z7"/>n zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
