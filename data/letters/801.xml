	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto tandem, domine colendissime, quae iam ante tibi reddenda fuerant, <lb xml:id="p1z2"/>ea videlicet, quae de importuno illo homine habere cupiebas.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Consigna<lb xml:id="p1z3"/>vi ea brevibus; planiora sine dubio ex ipso aliquando audies.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Omnes boni il<lb xml:id="p1z4"/>lum aut in ordinem redigi aut illius absentia offendicula ecclesiae nostrae <lb xml:id="p1z5"/>averti cupiunt.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Adeo enim importunus et prefrictae frontis est, ut merito hunc <lb xml:id="p1z6"/>in ordinem redigi expectant.</s>
					<s n="6" xml:lang="la">Sat illi parsum hactenus, sat cum illo actum, si <lb xml:id="p1z7"/>modo apud illum diligens et frequens aliquid profecisset admonitio.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Gloriatur <lb xml:id="p1z8"/>multa, sed quae veritati parum sint congrua; multam venditat scientiam, qua non<lb xml:id="p1z9"/>nisi suam testatur nequitiam.</s>
					<s n="8" xml:lang="la">Multa de aequitate et charitate praedicat, cum ipso <lb xml:id="p1z10"/>importunior et magis ad rixas inter nos pronus non sit.</s>
					<s n="9" xml:lang="la">Haec et alia in illo <lb xml:id="p1z11"/>multa sunt, quae vobis nunc in illo corrigenda permittimus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Dominus in suae <lb xml:id="p1z12"/>ecclesiae incolumitatem in multa saecula te salvum conservet et incolumem.</s>
					<s n="11" xml:lang="la"><placeName ref="l317">Meylę</placeName> 9. <lb xml:id="p1z13"/>ianuarii anno 1550.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p1453">Wolphgangus Hallerus</persName>, <lb xml:id="p1z15"/>tui colendissimus.</s>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>domino ac patri <lb xml:id="p2z4"/>suo colendissimo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
