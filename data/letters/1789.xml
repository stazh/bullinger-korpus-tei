	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime <persName ref="p495">Bulling[ere]</persName>, audi et obstupescas.</s>
					<s n="2" xml:lang="la">Dixi, <lb xml:id="p1z2"/>quum apud te essem, me suspicari, ne <placeName ref="l28">Basi<lb xml:id="p1z3"/>leae</placeName> quispiam ex primoribus anabaptismum <lb xml:id="p1z4"/>suscepisset, et quum me coegisses, ut dicere<lb xml:id="p1z5"/>m nomen hominis, non potui non obtem<lb xml:id="p1z6"/>perare <persName ref="p495">Bullingero</persName> et dixi.</s>
					<s n="3" xml:lang="la">Nunc tibi <lb xml:id="p1z7"/>affirmo duos, qui erant anabaptistae <placeName ref="l834">Itali</placeName>, <lb xml:id="p1z8"/>rediisse ad puritatem doctrinae nostrae et <lb xml:id="p1z9"/>hos palam dicere se illi, quem tibi <lb xml:id="p1z10"/>dixeram, novum baptismum dedisse, ita <lb xml:id="p1z11"/>ut putem rem esse certam.</s>
					<s n="4" xml:lang="la">Sed audi <lb xml:id="p1z12"/>reliqua: ambo hii affirmant se fuisse <lb xml:id="p1z13"/>a <persName ref="p2807">Camillo</persName> seductos, et unus, qui adest, <lb xml:id="p1z14"/>in faciem illi graviter et prudenter obii<lb xml:id="p1z15"/>cit atque addit totum <placeName ref="l834">Italiae</placeName> anabaptis<lb xml:id="p1z16"/>mum pendere ab illo utre venenato, ut <lb xml:id="p1z17"/>tu soles dicere.</s>
					<s n="5" xml:lang="la">Monui hac de re pastore<lb xml:id="p1z18"/>s <placeName ref="l98">Curiae</placeName>.</s>
					<s n="6" xml:lang="la">At ego interea in nova ecclesia, <lb xml:id="p1z19"/>quam dedit mihi dominus, illum excom[m]<lb xml:id="p1z20"/>unicabo.</s>
					<s n="7" xml:lang="la">Ingredior enim deo duce cras <lb xml:id="p1z21"/>summo mane.</s>
					<s n="8" xml:lang="la">Domini <placeName ref="l37">Bregalienses</placeName> adiun<lb xml:id="p1z22"/>xerunt mihi duos legatos, qui mon<lb xml:id="p1z23"/>eant incolas vallis illius, ut abstineant <lb xml:id="p1z24"/>ab iniuria; nam audimus minas plurimas.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z25"/>Sed utinam fiam martir!</s>
					<s n="10" xml:lang="la">nec pro<lb xml:id="p1z26"/>cul abero.</s>
					<s n="11" xml:lang="la">Norunt illi me ex octo oppidis <lb xml:id="p1z27"/>missam exturbasse hactenus et timent, ne <lb xml:id="p1z28"/>idem per me apud illos operetur dominus, <pb/><lb xml:id="p2z1"/>et confidunt in brachio et potentia eorum, <lb xml:id="p2z2"/>ego vero in deo ipso.</s>
					<s n="12" xml:lang="la">Petunt a me fratres <lb xml:id="p2z3"/><placeName ref="l491">Argentinae</placeName> num adhuc vivat <persName ref="p4810">Bortolameus <lb xml:id="p2z4"/>Fontius</persName>, qui olim apud eos professus es[t], et <lb xml:id="p2z5"/>an sciam, ubi sit.</s>
					<s n="13" xml:lang="la">Oro itaque, ut ad <persName>Sturmium</persName> <lb xml:id="p2z6"/>scribas illum vivere, esse mihi perfamilia<lb xml:id="p2z7"/>rem et perseverare in via domini et posse <lb xml:id="p2z8"/>me efficere, ut ad eos redeat.</s>
					<s n="14" xml:lang="la">Nunc non <lb xml:id="p2z9"/>fuit mihi ad ipsum <persName>Sturmium</persName> scribendi ocium.</s>
					<s n="15" xml:lang="la" ana="farewell"><lb xml:id="p2z10"/>Vale et salve.</s>
					<s n="16" xml:lang="la">Ora pro me diligentius, quandoqui<lb xml:id="p2z11"/>dem maiora certe instant pericula quam un<lb xml:id="p2z12"/>quam antea.</s>
					<s n="17" xml:lang="la">Dominus benedicat tuis laboribus.</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z13"/>Amen.</s>
					<s n="19" xml:lang="la"><placeName ref="l93">Claven[n]ae</placeName>, 10. ianuarii 1553.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z14"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Clari<lb xml:id="p2z15"/>ss<lb xml:id="p2z16"/>imo viro d. <persName ref="p495">Henrico <lb xml:id="p2z17"/>Bullingero</persName>, fratri <lb xml:id="p2z18"/>et domino honorando.</s>
					<s n="22" xml:lang="la"><lb xml:id="p2z19"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
