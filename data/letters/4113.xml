	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Valde beatus es, mi <persName ref="p495">Bullingere</persName>, ut quem dominus bono <lb xml:id="p1z2"/>singulari et <foreign xml:lang="el">πολυτεχνίας</foreign> et <foreign xml:lang="el">εὐτεχνίας</foreign> exornavit.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Vidi praeteritis <lb xml:id="p1z3"/>diebus filium iuniorem et colloquio eius familiari propter singularem quandam <lb xml:id="p1z4"/>suavitatem et pietatem sic sum refectus, ut vix queam dicere.</s>
					<s n="4" xml:lang="la">Praecor <lb xml:id="p1z5"/>Christum, ut hunc surculum suae ecclesiae conservet et provehat decla[re]<lb xml:id="p1z6"/>turque in illo non esse catholicum malum, quod proverbio occasionem dedit: <lb xml:id="p1z7"/>heroum filii noxae.</s>
					<s n="5" xml:lang="la">Spero te etiam defunctum in hoc revicturum esse; <lb xml:id="p1z8"/>itaque et amicum mihi esse cupio.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ex <placeName ref="l832">Gallia</placeName> audimus <persName>Guisani</persName> au<lb xml:id="p1z9"/>spiciis 20 vexilla peditum cum iusto equitum in <placeName ref="l2524">Scotiam</placeName> profectura <lb xml:id="p1z10"/>ad subigendum in plenam ditionem regnum et opprimendos in<lb xml:id="p1z11"/>dubie christianos extinguendaque pietatis illic emergentis semina.</s>
					<s n="7" xml:lang="la">Sed <lb xml:id="p1z12"/>dominus est Zebaoth, cuius vel solo nutu dissipari possunt <lb xml:id="p1z13"/>ingentia molimina.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l1028">Trevirenses</placeName> sic egerunt cum adversariis, <lb xml:id="p1z14"/>ut praeter Christum nihil quaerere ipso actu ostendant; obsides <lb xml:id="p1z15"/>se ipsos primores civitatis sex exhibuerunt adversariis ad solidam <lb xml:id="p1z16"/>confirmationem nihil a sua parte seditiose vel agi vel actum iri, <lb xml:id="p1z17"/>et cum binae ad singulas partes claves destinatę sint, alteram <lb xml:id="p1z18"/>adversariis volentes concessere.</s>
					<s n="9" xml:lang="la">Quo factum esse affirmant, ut <lb xml:id="p1z19"/>etiam sine sanguine postulatam religionis libertatem sint obtenturi.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/>Aiunt pro certo ab <persName>imperatore Ferdinando</persName> civitatibus <placeName>Svevicis</placeName> <lb xml:id="p1z21"/>pristina iura, quo ad tribus et electionem magistratuum resti<lb xml:id="p1z22"/>tuta esse; <foreign xml:lang="de">doch söllend es nit zünft, sunder quartier heissen.</foreign></s>
					<s n="11" xml:lang="la"><lb xml:id="p1z23"/>Si quid habes ex <placeName ref="l834">Italia</placeName>, fac, obsecro, sciam.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale in Christo Iesu <lb xml:id="p1z24"/>cum uxore, filiis et tuis omnibus.</s>
					<s n="13" xml:lang="la"><placeName ref="l28">Basileae</placeName> 29. octobris anno 1559.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z25"/>T[uus] <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>antistiti vigilantissimo, domino et <lb xml:id="p2z4"/>symmistae colendissimo et charissimo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>