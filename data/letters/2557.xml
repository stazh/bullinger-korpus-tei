	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Ante proximas meas tibi cum <persName ref="p4082">Cunraadto Zvigkio</persName> nostro <lb xml:id="p1z2"/>elapso ferme bimestri scripsimus et rationem fidei nostrę <lb xml:id="p1z3"/>chartis mandatam transmisimus, ut pro pietate tua <lb xml:id="p1z4"/>emendationem et iudicium tuum in scriptis ad me redderes, <lb xml:id="p1z5"/>neque diffido, quin meę literę per tam certum latorem ad te <lb xml:id="p1z6"/>perlatę sint.</s>
					<s n="3" xml:lang="la">Quod autem interim nihil literarum ad <lb xml:id="p1z7"/>me dederis, miror; si interceptę sint, doleo.</s>
					<s n="4" xml:lang="la" ana="salute"><lb xml:id="p1z8"/>Ego etsi prophanis negotiis occupatus sim, tamen <lb xml:id="p1z9"/>gloriam Christi atque salutem nostram iure omni occupationi <lb xml:id="p1z10"/>praefero.</s>
					<s n="5" xml:lang="la">Hinc est, quod huius sęculi mores et iniquitates <lb xml:id="p1z11"/>nihilo plus faciant, quam quod non totum me enecent.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Audies ex inclusa summi pontificis <placeName ref="l18">Augustani</placeName> inter <lb xml:id="p1z13"/>evangelicos, quid confiteantur isti de idolo, quod sacramentum <lb xml:id="p1z14"/>vocant.</s>
					<s n="7" xml:lang="la">Utinam illud verbum, nempe sacramentum <lb xml:id="p1z15"/>in ecclesiam nunquam irrepsisset aut apud <lb xml:id="p1z16"/><placeName ref="l822">Germano</placeName> etiam Germanico vocabulo exprimeretur; <lb xml:id="p1z17"/>certus profecto tunc essem tam ernormes errores <lb xml:id="p1z18"/>et scandala nunquam adeo radices egisse, taceo totius <lb xml:id="p1z19"/>papatus fundamenta in hoc unico niti.</s>
					<s n="8" xml:lang="la">Novus vero <lb xml:id="p1z20"/>papatus quid tentaturus sit, brevi videbimus; ob <lb xml:id="p1z21"/>id tot tantosque esse, qui proximos parietes uri non <lb xml:id="p1z22"/>vident, ex animo doleo.</s>
					<s n="9" xml:lang="la">Comitia nunc <placeName ref="l18">Augustę</placeName> <lb xml:id="p1z23"/>incepta nunquam finienda habenda, nimirum ad evangelii <lb xml:id="p1z24"/>exterminationem, quantum in humanis est.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/>Te valde oro, ut ad confessionem fidei meę mihi <lb xml:id="p1z26"/>respondeas, dummodo eam percepisti; sin minus, fac <lb xml:id="p1z27"/>resciam, et tibi denuo transmittetur.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z28"/>Ad ver futurm est animus invisere Termas, imo <lb xml:id="p1z29"/>pios homines omnibus Termis salubriores.</s>
					<s n="12" xml:lang="la">Si <lb xml:id="p1z30"/>fieri potes[t], ut brevi respondeas, offitium fidelis <lb xml:id="p1z31"/>amici et fratris feceris.</s>
					<s n="13" xml:lang="la" ana="salute">Vale et libertatem vestram <lb xml:id="p1z32"/>alias in toto mundo collapsam diligentissime et <lb xml:id="p1z33"/>reverenter salutato... terras relictura, non reperatura(?) est.</s>
					<s n="14" xml:lang="la">Raptim.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z34"/><placeName ref="l337">Neoburgi ad Danubium</placeName> 14. februarii anno etc. 55.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z35"/>Tuus <persName ref="p8354">Georgius Lętus</persName> a <placeName>Lemnicz</placeName>, <lb xml:id="p1z36"/>vicecancellarius <placeName ref="l2477">Palatini</placeName> comitis <lb xml:id="p1z37"/><persName ref="p2411">Ottonis Henrichi</persName> etc.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Incomparabili viro et fratri meo <lb xml:id="p2z2"/>domino <persName ref="p495">Henricho Bullingero</persName>, gregis <lb xml:id="p2z3"/>Christi apud inclytos <placeName ref="l587">Tygurinos</placeName> <lb xml:id="p2z4"/>pastori vigilantissimo.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zur[ch]</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
