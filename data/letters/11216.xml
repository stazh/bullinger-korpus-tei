	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus et pax Christi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Scis, <persName ref="p495">Bullingere</persName> charissime, <persName ref="p8055">Ambrosium</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8055">Ambrosius Blarer</persName>.</note> rediisse salvum.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Qua fortuna ex ditione principis pulsus, ipsemet <lb xml:id="p1z4"/>nescit<note xml:id="fn2" type="footnote" n="2">Vgl. <persName ref="p8055">Blarers</persName> Bericht über seine Entlassung aus dem Dienst Herzog <persName ref="p9708">Ulrichs von Württemberg</persName>, oben <ref target="file11209">Nr. 1166</ref>.</note>, sed verendum est, ne illius abitus piis <lb xml:id="p1z5"/>fratribus valde sit incommodaturus.</s>
					<s n="4" xml:lang="la">Fiat autem <lb xml:id="p1z6"/>voluntas domini; nostra ingratitudo meretur tales <lb xml:id="p1z7"/>cruces.<pb type="edition" next="216"/></s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>De <persName ref="p5515">Cottero</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p5515">Hans Kotter</persName>.</note>, optimo viro, quid scribam?</s>
					<s n="6" xml:lang="la">Iam parat <lb xml:id="p1z9"/>abitum.</s>
					<s n="7" xml:lang="la">Causatur aerem adversum, sed revera <lb xml:id="p1z10"/><persName ref="p5514">uxor</persName><note xml:id="fn4" type="footnote" ana="bio" n="4"><persName ref="p5514">Anna Tschollier (Tschällier)</persName>; s. Adolf <hi>Fluri,</hi> Beschreibung der deutschen Schule zu <placeName ref="l41">Bern</placeName>, in: Archiv des Historischen Vereins des Kantons <placeName ref="l41">Bern</placeName> XVI/3, 1902, S. 521. Von seiner ersten Frau, <persName ref="p5513">Margaretha Henngin</persName> von <placeName ref="l509">Torgau</placeName>, war <persName ref="p5515">Kotter</persName> 1531 geschieden worden; s. Adrian <hi>Staehelin,</hi> Die Einführung der Ehescheidung in <placeName ref="l28">Basel</placeName> zur Zeit der Reformation, Basel 1957. -<placeName ref="l28">Basler</placeName> Studien zur Rechtswissenschaft 45, S. 161-163.</note> in causa est, quę illum turbavit miserrime.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/>Deinde timuit forte, ne non sufficerent vires ad <lb xml:id="p1z12"/>ferendos scolasticos labores, quos tamen adhuc <lb xml:id="p1z13"/>non tentavit, quod scola hactenus non sit in ordinem <lb xml:id="p1z14"/>redacta.</s>
					<s n="9" xml:lang="la">Debuit autem redigi in classes<note xml:id="fna" type="footnote" n="a"><hi>vor</hi> classes <hi>gestrichenes</hi> cll.</note> <lb xml:id="p1z15"/>quatuor electis praeceptoribus quatuor; ipse <lb xml:id="p1z16"/>vero classem legentium puerorum habuisset liber <lb xml:id="p1z17"/>omnino ab omnibus<note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> omnibus <hi>gestrichenes</hi> a...</note> elementariis et iis, <lb xml:id="p1z18"/>qui discunt literas nectere vel pingere.</s>
					<s n="10" xml:lang="la">I<lb xml:id="p1z19"/>ntelligo autem bonum virum <placeName ref="l41">Bernae</placeName> liberiorem fuisse <lb xml:id="p1z20"/>nec astrictum ullis docendi aut gubernandae <lb xml:id="p1z21"/>scolae legibus, quod nostri hic non ferunt.</s>
					<s n="11" xml:lang="la">Uxoris <lb xml:id="p1z22"/>ergo intollerabilis vexatio et laboris sive disciplinae <lb xml:id="p1z23"/>scolasticę suspitio fecerunt, ut a nostris <lb xml:id="p1z24"/>facultatem ad suos redeundi rogarit et impetrarit.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z25"/>Quęcumque vero illi hactenus stipendii nomine <lb xml:id="p1z26"/>data sunt, ea omnia non solum non sunt ab <lb xml:id="p1z27"/>eo repetita, sed viginti quoque aurei ex liberalit<lb xml:id="p1z28"/>ate a magistratu additi, a privatis vero sex.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z29"/>Sic abit bonus vir occasione data, ut <lb xml:id="p1z30"/>scolae quoque consultatio hoc tempore in cineres <lb xml:id="p1z31"/>redierit.</s>
					<s n="14" xml:lang="la">Alioqui certe bonus vir est, in <lb xml:id="p1z32"/>quo retinendo nihil non tentavi cum bonis, <lb xml:id="p1z33"/>sed frustra.<pb type="scan" next="48"/></s>
					<s n="15" xml:lang="la" ana="salute"><pb/><lb xml:id="p2z1"/>Haec<note xml:id="fnc" type="footnote" n="c"><hi>undeutlich korrigiert aus</hi> Hoc.</note> non tibi solum, sed <persName ref="p1753">Leoni</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p1753">Leo Jud</persName>.</note> quoque et <persName ref="p8412">Megandro</persName>, <lb xml:id="p2z2"/>denique <persName ref="p8428">Rhellicano</persName> scripta volo, quos meo nomine <lb xml:id="p2z3"/>salutabis etiam diligenter.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z4"/>Praeterea nihil habeo dignum scriptu.</s>
					<s n="17" xml:lang="la"><persName ref="p8055">Ambrosius</persName> <lb xml:id="p2z5"/>serio vocatur <placeName ref="l18">Augustam</placeName><note xml:id="fn6" type="footnote" n="6">Die neuerliche Bitte <placeName ref="l18">Augsburgs</placeName> an <placeName ref="l257">Konstanz</placeName> um Entsendung <persName ref="p8055">Blarers</persName> vom 20. August ist gedruckt in: Theodor <hi>Pressel,</hi> <persName ref="p8055">Ambrosius Blaurer</persName>'s des schwäbischen Reformators Leben und Schriften, Stuttgart 1861, S. 444, Anm. 1.</note>, sed iam non potest fieri, <lb xml:id="p2z6"/>ut morem gerat illis.</s>
					<s n="18" xml:lang="la">Post hiemem quid futurum <lb xml:id="p2z7"/>sit, novit dominus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="farewell">Vale cum bonis omnibus, <lb xml:id="p2z8"/>uxore<note xml:id="fn7" type="footnote" ana="bio" n="7"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> cum primis, matre<note xml:id="fn8" type="footnote" ana="bio" n="8"><persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note> et domesticis.</s>
					<s n="20" xml:lang="de"><lb xml:id="p2z9"/>10. septembris 1538.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z11"/>Tuus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse darunter:]</note>
					<s n="22" xml:lang="la"><lb xml:id="p2z12"/>Domino <persName ref="p495">Hainricho Bullingero</persName>, observandis<lb xml:id="p2z13"/>s<lb xml:id="p2z15"/>imo meo in domino fratri.</s>
				</p>
			</div>
		</body>
