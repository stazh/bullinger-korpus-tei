	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Cupimus omnes te, frater in domino charissime, <lb xml:id="p1z2"/>rebus salvis omnibus pervenisse <placeName ref="l98">Curiam</placeName> ac speramus <lb xml:id="p1z3"/>propediem id nos ex literis tuis intellecturos.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Valemus hic per dei gratiam omnes; utinam tu quoque cum <lb xml:id="p1z5"/>tuis valeas rectę <persName ref="p8126">Oporinus</persName> duas hasce meas <lb xml:id="p1z6"/>orationes evulgavit, quas ei dono dederat.</s>
					<s n="4" xml:lang="la">Paucula <lb xml:id="p1z7"/>aliquot mihi misit exemplaria; unum ergo tibi et <lb xml:id="p1z8"/>d. <persName>Philippo</persName> mitto, alterum d. <persName ref="p8432">Friderycho a Salicibus</persName>, <lb xml:id="p1z9"/>quod tu chartis involutum et obtectum una <lb xml:id="p1z10"/>cum meis hisce literis ad ipsum tuto mittere digneris <lb xml:id="p1z11"/>Samadam.</s>
					<s n="5" xml:lang="la">Pridie nunciatum est ab <placeName ref="l18">Augusta <lb xml:id="p1z12"/>Vindelicorum</placeName> finita esse comitia imperialia <lb xml:id="p1z13"/>et colloquium de religionibus pugnantibus compone<lb xml:id="p1z14"/>ndis habendum mense augusto <placeName ref="l569">Wormatiae</placeName>.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Ego vel nullo cum fructu habendum vel omnino <lb xml:id="p1z16"/>non habendum arbitror; rex enim <persName ref="p18477">Ferdinandus</persName> pro <lb xml:id="p1z17"/>ingenio <placeName ref="l875">Hispanico</placeName> libenter utitur translationibus; ac <lb xml:id="p1z18"/>stupidi <placeName ref="l822">Germani</placeName> toties delusi ne nunc quidem <lb xml:id="p1z19"/>sapiunt.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 9. aprilis 1557.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">S<lb xml:id="p1z21"/>alutabis diligentissime d. <lb xml:id="p1z22"/><persName ref="p8359">Gallicium</persName> <lb xml:id="p1z23"/>nostrum, d. d. consules<lb xml:id="p1z24"/>, quaes<lb xml:id="p1z25"/>torem ęrarium, <persName ref="p6130">Pontasellam</persName> <lb xml:id="p1z26"/>etc.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio Montano</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro, <lb xml:id="p2z4"/>compatri et fratri suo per<lb xml:id="p2z5"/>charo.</s>
					<s n="12" xml:lang="de"><lb xml:id="p2z6"/>Dem pfarrer zuͦ <lb xml:id="p2z7"/>Sant Martin zuͦ <lb xml:id="p2z8"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
