	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non dubito, quin intellexeris de provincia mihi demandata, <lb xml:id="p1z2"/>quam non ultro sumpsi nec appetivi, sed suo iure mihi <lb xml:id="p1z3"/>commisit et imposuit, qui imperare potest.</s>
					<s n="3" xml:lang="la">Scio, quam grave onus <lb xml:id="p1z4"/>sit et meis humeris impar, atque frequentes mihi subeundas <lb xml:id="p1z5"/>sollicitudines et tempestates.</s>
					<s n="4" xml:lang="la">Sed spero eum, qui talem mihi <lb xml:id="p1z6"/>imposuit personam et qui opera praeparat, in quibus ambulare debemus, <lb xml:id="p1z7"/>et suis ut instrumentis utitur, daturum robur et prudentiam, <lb xml:id="p1z8"/>qua ex huiusmodi labirinthis et impedimentis me expediam.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Eum oro, ut mihi semper adsit et suo spiritu me regat.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Cęterum pergratum mihi feceris, si de his, que scitu digna <lb xml:id="p1z11"/>existimaveris, ad me sepe scribas, tibi omnia de meo in te animo <lb xml:id="p1z12"/>et benevolentia promittens.</s>
					<s n="7" xml:lang="la" ana="salute">Salutabis meo nomine <persName ref="p8111">Martirem</persName> <lb xml:id="p1z13"/>et <persName ref="p8011">Valterum</persName> et amicos communes.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Te servet dominus et benedictionibus <lb xml:id="p1z14"/>augeat.</s>
					<s n="9" xml:lang="de"><placeName ref="l21">Badene</placeName> 25. maii.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/>Tuus <persName ref="p629">Coignetus</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bulingero</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z2"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note type="address">[Adresse von anderer HandM Bemerkung von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="13" xml:lang="la">"D. <persName ref="p629">Coigneti</persName> primae <lb xml:id="p2z3"/>literae, legati <lb xml:id="p2z4"/>regii, <lb xml:id="p2z5"/>mense maio <lb xml:id="p2z6"/>1558."</s>
				</p>
			</div>
		</body>
	</text>
