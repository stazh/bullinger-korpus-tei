	</facsimile>
	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Pręstantissime <persName ref="p495">Bul[l]ingere</persName>, Dominus <lb xml:id="p1z2"/>servet te in tuo ministerio absque querela.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Scripseram ad te paucis ante diebus, quid omnes fideles mirifice cu<lb xml:id="p1z4"/>piant agi per te ad salutem et consolationem primum ecclesię <lb xml:id="p1z5"/><placeName ref="l93">Claven[n]ensis</placeName>, quę multis ac magnis discordiis pene dissipata est; <lb xml:id="p1z6"/>id autem est, ut per sinodum Curiensem ii duo removeantur facta causę <lb xml:id="p1z7"/>cognitione, <persName ref="p2019">Augustinus</persName> scilicet, minister <placeName ref="l93">Claven[n]ę</placeName>, et <persName ref="p2807">Camillus</persName>, <lb xml:id="p1z8"/>anabaptistarum patronus.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Quodsi tu ad ministros <placeName ref="l98">Curienses</placeName> scripseris <lb xml:id="p1z9"/>ea de re, non tam mihi, qui te unice observo, sed episcopo <lb xml:id="p1z10"/><persName ref="p3375">Vergerio</persName>, immo omnibus fidelibus, qui sunt in hisce partibus, gratissimum <lb xml:id="p1z11"/>feceris et clorię Christi, quę nunc eo pacto periclitatur, rectis<lb xml:id="p1z12"/>sime prospicies.</s>
					<s n="4" xml:lang="la">Dabis igitur operam, ut in hac tam gravi causa <lb xml:id="p1z13"/>te eum esse sentiamus, qualem semper existimavimus, id est ecclesię <lb xml:id="p1z14"/>Christi summum patronum et curatorem.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Cęterum hunc fratrem tibi valde commendo; dignus est opera tua.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z16"/>Monachatum cum missa deseruit, et cum non posset in <placeName ref="l834">Italia</placeName> tutus <lb xml:id="p1z17"/>manere nec alibi victum querere, coactus est venire ad vos, <lb xml:id="p1z18"/>a nobis ita persuasus, ut vel ibi vel <placeName ref="l28">Basileę</placeName> aliquo modo de victu <lb xml:id="p1z19"/>et vestitu sibi prospiciatur et inservire alicui vocationi, dummodo <lb xml:id="p1z20"/>sibi tantum ocii relinquatur, quod satis sit ad discendum aliquid.</s>
					<s n="7" xml:lang="la">Paratus <lb xml:id="p1z21"/>est <lb xml:id="p1z22"/>omnia quantumvis dura sufferre prius quam ad illam monachorum <lb xml:id="p1z23"/>et missarum abominationem reverti; vestrum igitur erit iuvare quoquo modo <lb xml:id="p1z24"/>ipsius laudabile institutum.</s>
					<s n="8" xml:lang="la">Quicquid huic feceris, scias te primum <lb xml:id="p1z25"/>Christo, ut scis, deinde multis fidelibus et mihi ipsi contulisse.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z26"/>Ego <placeName ref="l399">Postclavium</placeName> veni una cum episcopo <persName ref="p3375">Vergerio</persName>.</s>
					<s n="10" xml:lang="la">Is habet omnia parata <lb xml:id="p1z27"/>contra Antichristum fulmina, quę iaculaturus contra illam bestiam.</s>
					<s n="11" xml:lang="la">Dicit <lb xml:id="p1z28"/>se hic hyematurum, ut opus suum perficiat.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">De me vero nihil pene <lb xml:id="p1z29"/>spei pollicetur ista nimis insolens persecutio <placeName ref="l522">Venetorum</placeName>.</s>
					<s n="13" xml:lang="la">Literę illę commen<lb xml:id="p1z30"/>datitię nihil proderunt.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale in Domino.</s>
					<s n="15" xml:lang="la" ana="salute">Reliquam ecclesiam salutabis <lb xml:id="p1z31"/>meo nomine meque ames.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Datum <placeName ref="l399">Postclavii</placeName>, die 3. augusti 1549 <lb xml:id="p1z32"/>Tuus ex animo <persName ref="p152">Balthasar Alteri<pb/><lb xml:id="p2z14"/>us</persName><lb xml:id="p2z19"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="17" xml:lang="la"><lb xml:id="p2z20"/>Integerrimo et eruditissimo ministro <lb xml:id="p2z22"/>ecclesię <placeName ref="l587">Tigurinę</placeName>, domino <persName ref="p495">Henryco <lb xml:id="p2z23"/>Bul[l]<lb xml:id="p2z24"/>ingero</persName>, meo semper colendo<lb xml:id="p2z27"/>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z28"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>