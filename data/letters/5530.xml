	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi tuas nuper per <persName>Bränvaldum</persName> missas, quibus <lb xml:id="p1z2"/>demum certo d. <persName ref="p8111">Martyrem</persName> obiisse cognovimus.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Valde <lb xml:id="p1z3"/>hoc nos consternavit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">D. <persName ref="p8417">Musculus</persName> ita afficitur, ut <lb xml:id="p1z4"/>mihi persuadeam ipsum quoque tanto citius hinc mi<lb xml:id="p1z5"/>graturum; maxima enim fuit apud illum huius existimatio <lb xml:id="p1z6"/>viri.</s>
					<s n="5" xml:lang="la">Ego non tantum pro illo doleo, quod tantum a nobis <lb xml:id="p1z7"/>lumen dominus abstulit, quantum tibi condoleo, qui <lb xml:id="p1z8"/>quomodo hinc afficiaris sat scio.</s>
					<s n="6" xml:lang="la">Oro autem dominum, ut hac <lb xml:id="p1z9"/>castigatione contentus te, <persName ref="p8417">Musculum</persName> et alios quam diutissime <lb xml:id="p1z10"/>nobis conservet.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Hodie accipio etiam alteras <lb xml:id="p1z11"/>tuas una cum illis, quę domino <persName ref="p8063">Steigero</persName> pertinent; ex<lb xml:id="p1z12"/>hibebo eas illi, ubi primum redierit.</s>
					<s n="8" xml:lang="la">Profectus est <placeName ref="l1860">Neo<lb xml:id="p1z13"/>dunum</placeName>; agebatur enim illic de induciis quibusdam <lb xml:id="p1z14"/>cum <placeName ref="l2478">Allobrogum</placeName> principe ineundis; sed quantum ex praecursor<lb xml:id="p1z15"/>ibus advenientibus audio, nihil effectum est.</s>
					<s n="9" xml:lang="la">Veni<lb xml:id="p1z16"/>ent ipsi fortassis cras aut perendie, qui quidquid <lb xml:id="p1z17"/>afferent, tibi communicabo; commonebo interea alios <lb xml:id="p1z18"/>quoque eorum, quae de <persName>Schliningero</persName> scribis.</s>
					<s n="10" xml:lang="la">Ex <lb xml:id="p1z19"/><placeName ref="l832">Gallia</placeName> quicquid haberi potest, cognosces ex <persName ref="p1918">Linero</persName> <lb xml:id="p1z20"/>nostro, qui has tibi adfert.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l157">Francofurti</placeName> nihil<lb xml:id="p1z21"/>dum audimus, propter obitum episcopi <placeName ref="l267">Coloniensis</placeName>; aiunt <lb xml:id="p1z22"/>tamen alium nunc electum esse et <placeName ref="l157">Francofurti</placeName> expectari.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/>Scribit <persName ref="p3099">Sultzerus</persName> <placeName ref="l2510">Turcicam</placeName> illic esse legationem, <lb xml:id="p1z24"/>quae referat imperatorem <placeName ref="l2510">Turcicum</placeName> causam regis <placeName ref="l832">Galliae</placeName> <lb xml:id="p1z25"/>defendendam suscepturum contra rebelles.</s>
					<s n="13" xml:lang="la">Sed omnes <lb xml:id="p1z26"/>cordati intelligunt esse artes cardinalis <placeName ref="l691">Lotha<lb xml:id="p1z27"/>ringi</placeName> et <placeName ref="l3258">Guisiani</placeName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Pro certo affirmat <persName ref="p1918">Linerus</persName> <lb xml:id="p1z28"/>25. triremes <placeName ref="l875">Hispanicas</placeName>, quę in <placeName ref="l832">Galliam</placeName> mittebantur <lb xml:id="p1z29"/>et <placeName ref="l1176">Massilię</placeName> appellere debebant, interiisse et 5 tantum <lb xml:id="p1z30"/>(nam 30 erant), laceras tamen, applicuisse.</s>
					<s n="15" xml:lang="la">Scribitur <lb xml:id="p1z31"/>in <placeName ref="l875">Hispania</placeName> mercatores aliquot <placeName ref="l830">Anglos</placeName> supplicio <lb xml:id="p1z32"/>fuisse affectos; hinc <placeName ref="l830">Anglos</placeName> 4 <placeName ref="l875">Hispanicas</placeName> naves <lb xml:id="p1z33"/>mercibus onustas in Oceano <placeName ref="l832">Gallico</placeName> cepisse <lb xml:id="p1z34"/>et trucidasse, quotquot in iis erant, <placeName ref="l875">Hispanos</placeName>; ideo <lb xml:id="p1z35"/>iam apertum quasi bellum inter <placeName ref="l875">Hispaniam</placeName> et <placeName ref="l830">Angliam</placeName> es<lb xml:id="p1z36"/>se.</s>
					<s n="16" xml:lang="la"><persName ref="p252">Bäldii</persName> literas remitto; vidit senatus <lb xml:id="p1z37"/>noster, quę schedula illis inclusa habet; gaudent <lb xml:id="p1z38"/>omnes bonos viros illo homine liberatos esse et sperant <lb xml:id="p1z39"/>inde plus quietis.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">His non habeo, quę nunc addam; <lb xml:id="p1z40"/>reliqua enim omnia, ut scripsi, ex <persName ref="p1918">Linero</persName> audies.</s>
					<s n="18" xml:lang="la" ana="farewell"><lb xml:id="p1z41"/>Bene vale.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute">Saluta amicos, fratres, uxorem, liberos, <lb xml:id="p1z42"/>totam denique familiam tuam meo nomine.</s>
					<s n="20" xml:lang="la" ana="salute">Salutant <lb xml:id="p1z43"/>te mater, socer, <persName ref="p8012">Hallerus</persName>, <persName ref="p8389">Hagius</persName> et inprimis <lb xml:id="p1z44"/><persName ref="p3494">Diesbachius</persName>, cui etiam <placeName ref="l176">Glaronensia</placeName> illa communicavi.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z45"/>Scis <persName>Mandossam</persName> abiisse vocatum in <placeName ref="l832">Galliam</placeName>; mirantur omnes, <lb xml:id="p1z46"/>quid hoc portendat.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><persName ref="p605">Coignetius</persName> etiam discedet; nam missis <lb xml:id="p1z47"/>literis senatui modo valedixit.</s>
					<s n="23" xml:lang="la" ana="farewell">Vale.</s>
					<s n="24" xml:lang="la"><placeName ref="l41">Bernae</placeName> 6. <lb xml:id="p1z48"/>decembris 1562.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z49"/>Tuus, quem nosti.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino suo <lb xml:id="p2z4"/>honorando compatrique cha<lb xml:id="p2z5"/>rissimo.</s>
				</p>
			</div>
