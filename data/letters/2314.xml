	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsit ad nos <placeName ref="l294">Locarnensis</placeName> ecclesia lugubres sane <lb xml:id="p1z2"/>literas, cui per has respondemus confirmantes <lb xml:id="p1z3"/>eos in opere domini; eas vero ad te mittimus rogantes, <lb xml:id="p1z4"/>ut ad aliquem ex ea ecclesia tibi notum et fidelem <lb xml:id="p1z5"/>transmittas.</s>
					<s n="3" xml:lang="la">Nullus eorum de nomine nobis <lb xml:id="p1z6"/>notus est; ideo nulli ipsorum peculiariter ipsas <lb xml:id="p1z7"/>adscribere potuimus.</s>
					<s n="4" xml:lang="la">Sed et neque tutum admodum <lb xml:id="p1z8"/>erat eas <placeName ref="l21">Badenam</placeName> ad legatos dominorum nostrorum <lb xml:id="p1z9"/>mittere, ne forte per imprudentiam in <lb xml:id="p1z10"/>manus impiorum devenirent maiusque concilia<lb xml:id="p1z11"/>retur bonis viris malum.</s>
					<s n="5" xml:lang="la">Si significaveris <lb xml:id="p1z12"/>nobis, quis inter illos alicuius nominis sit, rem feceris <lb xml:id="p1z13"/>nobis gratam; ad eum poterimus deinceps scribere.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Memini quidem <placeName ref="l294">Locarnensem</placeName> ludimagistr<lb xml:id="p1z16"/>um, opinor, virum doctum aliquando hic fuisse nobiscu<lb xml:id="p1z17"/>m; sed nomen eius interea plane mihi excidit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z18"/>Apud nos interea a magnifico senatu <lb xml:id="p1z19"/>ad tempus aliquod receptus est d. <persName ref="p6836">E<lb xml:id="p1z20"/>manuel Tremellius</persName>, vir sane pius et doctrinae <lb xml:id="p1z21"/>admirabilis; puto illum tibi alias esse notum.</s>
					<s n="8" xml:lang="la">Ex <lb xml:id="p1z22"/>circumcisione christianus factus ante 12 annos <lb xml:id="p1z23"/><placeName ref="l491">Argentinam</placeName> ex <placeName ref="l150">Ferraria</placeName>, unde natus est, conce[ssit]; <lb xml:id="p1z24"/>ibi sex annis linguam sanctam professus aliis [postea<lb xml:id="p1z25"/>]<note type="margin">a.R.: quoque?</note> disciplinis operam dedit.</s>
					<s n="9" xml:lang="la">Postea <persName ref="p4744">Fagium</persName> in <placeName ref="l830">Angliam</placeName> <lb xml:id="p1z26"/>secutus et in illius defuncti locum substi<lb xml:id="p1z27"/>tutus totidem annis <placeName ref="l86">Cantabrigię</placeName> docuit.</s>
					<s n="10" xml:lang="la">Nunc <lb xml:id="p1z28"/>communi cum aliis fortuna eiectus huc venit commen<lb xml:id="p1z29"/>datus a <persName ref="p540">Calvino</persName>, <persName ref="p3429">Vireto</persName>, <persName ref="p8033">Beza</persName> et aliis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Dominus <lb xml:id="p1z30"/>vero praeter spem nostram permovit animos principum <lb xml:id="p1z31"/>nostrorum, ut illum in scholae nostrae usum <lb xml:id="p1z32"/>receperint; speramus ergo magnum ex eo fructum ad nos <lb xml:id="p1z33"/>omnes rediturum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Graece et Latine doctissimus est praeter <lb xml:id="p1z34"/>communem Iudaeorum morem et in omni grammaticorum <lb xml:id="p1z35"/>genere exercitatissimus.</s>
					<s n="13" xml:lang="la">D. <persName ref="p8417">Musculus</persName> eruditionem <lb xml:id="p1z36"/>eius satis commendare nequit.</s>
					<s n="14" xml:lang="la">Quod tibi significo, <lb xml:id="p1z37"/>ut nobis de tanto scholae nostrae profectu <lb xml:id="p1z38"/>congratuleris; habemus enim nunc non paucos spectatae <lb xml:id="p1z39"/>eruditionis viros.</s>
					<s n="15" xml:lang="la" ana="salute">Mei omnes recte valent teque <lb xml:id="p1z40"/>tuosque salutant, quos ego quoque cupio salvos.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z41"/><placeName ref="l41">Bernae</placeName> 17. iunii 1554.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z42"/>Tuus <persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Antequam <lb xml:id="p1z43"/>has occluderem tuas 12. iunii datas accepi et, <lb xml:id="p1z44"/>quas simul misisti, curabo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino suo <lb xml:id="p2z4"/>et compatri venerando.</s>
				</p>
				<p>
					<s n="20" xml:lang="de"><lb xml:id="p2z5"/>M. <persName ref="p495">Heinrych Bullinger<lb xml:id="p2z6"/>en</persName> zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
