	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Veni <placeName ref="l28">Basileam</placeName> hodie, <persName ref="p495">Bullingere</persName> charissime, <lb xml:id="p1z2"/>per gratiam Christi satis commode, nisi quod <lb xml:id="p1z3"/>pes sinister tumorem suum adhuc retinet, quem <lb xml:id="p1z4"/>tamen mediocriter fero, donec sensim <lb xml:id="p1z5"/>absumatur.</s>
					<s n="3" xml:lang="la">Exceptus sum a fratribus, domino <lb xml:id="p1z6"/><persName ref="p8418">Myconio</persName> et <persName ref="p1278">Gastio</persName>, perquam humaniter <lb xml:id="p1z7"/>et ab <persName ref="p5213">Hervagio</persName> typographo domum abductus, <lb xml:id="p1z8"/>apud quam tantisper haerebo, dum divina <lb xml:id="p1z9"/>me providentia certo alicui loco addicet.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>Unum me torquet plurimum, <lb xml:id="p1z11"/>quod hic, ut speraram, nihil literarum <lb xml:id="p1z12"/>invenio et adhuc incertus de <lb xml:id="p1z13"/>relictis symmystis, uxore ac liberis <lb xml:id="p1z14"/>esse cogor.</s>
					<s n="5" xml:lang="la">Sed haec quoque ferenda est <lb xml:id="p1z15"/>molestia.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Literas hisce inclusas, obsecro, <lb xml:id="p1z16"/>primo quoque nuncio per occasionem <lb xml:id="p1z17"/>oblato <placeName ref="l257">Constantiam</placeName> mittas.</s>
					<s n="7" xml:lang="la"><persName>Conradus</persName>, <lb xml:id="p1z18"/>comes meus, optime sese gessit.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z19"/>Dominus illi rependat.</s>
					<s n="9" xml:lang="la">Plura iam non <lb xml:id="p1z20"/>licet.</s>
					<s n="10" xml:lang="la">De <placeName ref="l41">Bernatibus</placeName> expectabo quid <lb xml:id="p1z21"/>scribas, quamvis consultum puto, ut <lb xml:id="p1z22"/>aliquandiu mecum deliberem, quid <lb xml:id="p1z23"/>non modo mihi, sed et causae <lb xml:id="p1z24"/>Christi conducat.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Optime vale.</s>
					<s n="12" xml:lang="la" ana="salute">Salutem <lb xml:id="p1z25"/>domui tuae honestissimę et fratribus <lb xml:id="p1z26"/>isthic omnibus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l28">Basileae</placeName> 13. iulii 1548.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><persName ref="p8417">W<lb xml:id="p1z27"/>(olfgang<lb xml:id="p1z28"/>us) Musculus</persName>, <lb xml:id="p1z29"/>tuus in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro <lb xml:id="p2z2"/>D. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullinger</persName>o, <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z5"/>ecclesię pastori <lb xml:id="p2z6"/>fidelissimo, <lb xml:id="p2z7"/>fratri et hospiti <lb xml:id="p2z8"/>charissimo.</s>
				</p>
			</div>
		</body>
	</text>
