	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quas proxime ad me misisti literas, vir clarissime, diligenter <lb xml:id="p1z2"/><placeName ref="l491">Argentinam</placeName> cum <persName ref="p8126">Oporini</persName> nostri fasciculo peferri curavi, quod <lb xml:id="p1z3"/>ideo siginificare praesentibus literis volui, ut omni sollicitudine <lb xml:id="p1z4"/>tuam pietatem liberarem.</s>
					<s n="3" xml:lang="la">Gratulor autem domino <persName ref="p8121">Christophoro <lb xml:id="p1z5"/>Montio</persName>, viro omnium doctissimo, quem e vita exemptum dolebamus <lb xml:id="p1z6"/>plurimum, proinde vix dici potest, quantum literis tuis, <lb xml:id="p1z7"/>quae hominem adhuc incolumem indicabant, sim recreatus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Sed habet dominus <persName ref="p8121">Montius</persName> hoc commune cum Caesare, <lb xml:id="p1z9"/>quem iam aliquocies diem suum obiisse vani homines sparserunt, <lb xml:id="p1z10"/>quo adversariis gaudium quasi in sinum effunderent.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Quod autem ad libros, quos ante aliquot menses a me <lb xml:id="p1z12"/>peciisti, attinet, negocium omne <persName ref="p18291">Petro Mechlingensi</persName> commiseram, <lb xml:id="p1z13"/>qui eos cum caeteris ab <placeName ref="l491">Argentinensibus</placeName> peciit, sed <lb xml:id="p1z14"/>frustra, ut video.</s>
					<s n="6" xml:lang="la">Magna est hodie vectorum improbitas, <lb xml:id="p1z15"/>qui ex <placeName ref="l157">Francfordia</placeName> et <placeName ref="l491">Argentina</placeName> <placeName ref="l28">Basileam</placeName> usque triplam <lb xml:id="p1z16"/>vel quadruplam efflagitare non erubescunt, quo factum <lb xml:id="p1z17"/>est, ut libri ante sex vel octo mens s a nostratibus <lb xml:id="p1z18"/>coempti <placeName ref="l157">Francfordiae</placeName> aliisque locis hęreant et a bonis <lb xml:id="p1z19"/>subinde viris efflagitentur frustra.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Proinde non est, <lb xml:id="p1z20"/>ut meam in rebus tuis curandis fidem accuses, qui in <lb xml:id="p1z21"/>gravioribus me tuae pietati obstrictum esse lubens agnos<lb xml:id="p1z22"/>co.</s>
					<s n="8" xml:lang="la">Novarum rerum nihil habemus modo; communis <lb xml:id="p1z23"/>tamen fama est Caesarem etiam atque marchionem <persName ref="p8371">Albertum</persName> <lb xml:id="p1z24"/>dimisisse milites et propositas esse pacis conditiones <lb xml:id="p1z25"/>inter <persName ref="p18538">Caesarem</persName> et <persName ref="p8112">Gallum</persName>, sed nescio quales.</s>
					<s n="9" xml:lang="la">Dominus <lb xml:id="p1z26"/><persName ref="p1754">Ioannes Iunius</persName>, <placeName ref="l2">Aroviensis</placeName> ecclesiastes, 17. iunii mensis die <lb xml:id="p1z27"/>apud nos concionatus est, quem apud divum Petrum <lb xml:id="p1z28"/><persName ref="p3099">Sultzeri</persName> locum adepturum speramus.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale cum familia.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z29"/>19. februarii anno 1553.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z30"/>T[uus] <persName ref="p8406">Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietate simul ac eruditione praestantis<lb xml:id="p2z2"/>simo viro d. <persName ref="p495">Henricho Bul<lb xml:id="p2z3"/>lingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ministro, domino atque amico <lb xml:id="p2z5"/>colendissimo.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
