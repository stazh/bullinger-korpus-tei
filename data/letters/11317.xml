	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Accepi literas<note xml:id="fn1" type="footnote" n="1">Nicht erhalten.</note> tuas una cum nummis, <lb xml:id="p1z2"/>patrone humanissime, in quibus <persName ref="p18379">Gvaltherum Insulanum</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p18379">Walter von Châtillon</persName>, Alexandreis (Manuskript); vgl. oben <ref target="file11303">Nr. 1260</ref>, 17f.</note> <lb xml:id="p1z3"/>restitui tibi cupis; sed hunc<note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> hunc <hi>gestrichenes</hi> u.</note>, ut ante scripsi<note xml:id="fn3" type="footnote" n="3">Ebenda.</note>, <persName ref="p2259">Gregorius <lb xml:id="p1z4"/>Mangolt</persName> a <persName ref="p6117">Plattero</persName> accepit.</s>
					<s n="3" xml:lang="la"><persName ref="p6571">Sedulium</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p6571">Coelius Sedulius</persName>, Carmen paschale; vgl. oben <ref target="file11309">Nr. 1266</ref>, 18-21; 1270, 12.</note> an <placeName ref="l28">Basileae</placeName> im<lb xml:id="p1z5"/>pressuri sint, ignoro; non tamen eum ibi excusum iri arbitror<note xml:id="fnc" type="footnote" n="c">arbitror <hi>am Rande nachgetragen.</hi></note><note xml:id="fn5" type="footnote" n="5">Das Werk erschien 1541 bei <persName ref="p3932">Bartholomäus Westheimer</persName>; s. <bibl>VD 16, S 5248</bibl> (vgl. auch die unfirmierte Ausgabe S 5247).</note>.</s>
					<s n="4" xml:lang="la"><persName ref="p7828">Urs<lb xml:id="p1z6"/>purgensis</persName> comparavi Chronica<note xml:id="fn6" type="footnote" n="6">Ob eine lateinische oder eine deutsche Ausgabe der Chronik des <persName ref="p7828">Burchard von Ursberg</persName> gemeint ist, bleibt offen; vgl. oben <ref target="file11313">Nr. 1270</ref>, 7-12.</note>; constant 12 batzonibus <placeName ref="l257">Constantiensibus</placeName>, <lb xml:id="p1z7"/><persName ref="p18377">Vigilius</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p18377">Vigilius</persName>, Contra Eutychen; vgl. ebd., Z. 7.</note> 2 blapph[art]<note xml:id="fn8" type="footnote" n="8">Vgl. ebd., Anm. 5.</note>, <persName ref="p6927">Vives</persName> De anima<note xml:id="fn9" type="footnote" n="9"><persName ref="p6927">Juan Luis Vives</persName>, De anima et vita libri tres; vgl. oben <ref target="file11303">Nr. 1260</ref>, 21f.</note> 8 blapp[hart].</s>
					<s n="5" xml:lang="la">Si quid <lb xml:id="p1z8"/>aliud est, quo tibi mea opera opus est, indicato, nec <lb xml:id="p1z9"/>me imorigerum comperies.<pb type="edition" next="146"/></s>
				</p>
				<p>
					<s n="6" xml:lang="la">Scias autem me nunc quędam <lb xml:id="p1z10"/>sub pręlo habere, quę proximis nundinis<note xml:id="fn10" type="footnote" n="10">Zum Termin der <placeName ref="l157">Frankfurter</placeName> Herbstmesse s. <bibl source="b8">HBBW VI</bibl> <ref target="file10925">[Nr. 884]</ref>, S. 406, Anm. 5.</note> in lucem <lb xml:id="p1z11"/>prodibunt.</s>
					<s n="7" xml:lang="la"><persName ref="p8126">Oporinus</persName> enim in unum volumen commentarios <lb xml:id="p1z12"/>in omnes <persName ref="p4543">Ciceronis</persName> orationes imprimit<note xml:id="fn11" type="footnote" n="11">Die von <persName ref="p8126">Oporin</persName> herausgegebene Sammlung wurde im September 1539 bei <persName ref="p7062">Robert Winter</persName> gedruckt; sie trägt den Titel "In omnes M. Tullii Ciceronis orationes, quot quidem extant, doctissimorum virorum lucubrationes ..." (s. <bibl source="b322">Index</bibl> Aureliensis, Catalogus librorum sedecimo saecub impressorum, 1. Teil, Bd. VIII, Baden-Baden 1989, S. 101).</note>.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Deerant autem orationes decem, quas nullus exponendas <lb xml:id="p1z14"/>sumpserat.</s>
					<s n="9" xml:lang="la">Has cum <persName ref="p8459">Otho</persName><note xml:id="fn12" type="footnote" n="12"><persName ref="p8459">Otto Werdmüller</persName>.</note> sibi delegisset vel <persName ref="p8126">Oporin<lb xml:id="p1z15"/>i</persName> hortatu impulsus suscepisset nec tam brevi temp<lb xml:id="p1z16"/>oris curriculo, quod volebat, exequi posset, meum <lb xml:id="p1z17"/>petiit auxilium, rationem modumque tractandi <lb xml:id="p1z18"/>deliniavit.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Duas ergo posteriores De lege agraria <lb xml:id="p1z19"/>orationes (nam prior mutila est) delegi<note xml:id="fn13" type="footnote" n="13">AaO, Sp. 393-414.</note>.</s>
					<s n="11" xml:lang="la">Cum vero <lb xml:id="p1z20"/>vix decem duodecimve dierum spatium mihi esset <lb xml:id="p1z21"/>et ob id nec diligentiam summam adhibere nec multum <lb xml:id="p1z22"/>temporis in rhetorum praeceptis evolvendis <lb xml:id="p1z23"/>insumere possem, nomen proprium supprimere f<lb xml:id="p1z24"/>ictitiumque supponere optimum esse et ego et <persName ref="p8459">Otho</persName> <lb xml:id="p1z25"/>duximus; nam idem et ipse fecit<note xml:id="fn14" type="footnote" n="14"><persName ref="p8459">Werdmüller</persName> wählte als Pseudonym "<persName ref="p8459">Myliander Tigurinus</persName>"; <persName ref="p8011">Gwalthers</persName> Kommentare erschienen unter dem Namen "<persName ref="p8011">Eubulus Dynaterus</persName>" (vgl. unten <ref target="file11320">Nr. 1277</ref>, 4-8).</note>.</s>
					<s n="12" xml:lang="la">Sic enim <lb xml:id="p1z26"/>nec, quis author sit, scitur, et ubi plus otii fuerit, <lb xml:id="p1z27"/>eas recognoscere et mihi vendicare licet.</s>
					<s n="13" xml:lang="la">De <lb xml:id="p1z28"/>aliis quibusdam proxime copiosius scribam.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z29"/>De epistola <persName ref="p8049">Vadiani</persName><note xml:id="fn15" type="footnote" n="15"><bibl source="b8">HBBW VI</bibl>, <ref target="file10936">Nr. 894</ref> (Teildruck); s. oben <ref target="file11310">Nr. 1267</ref>, 3-5; 1269, 1f.</note> d. <persName ref="p8418">Miconium</persName> <persName ref="p1365">Gryneumque</persName> conveni; <lb xml:id="p1z30"/>quid illi acturi sint, nescio.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Habebis autem, ut opinor, <lb xml:id="p1z31"/>ex <persName ref="p8418">Miconii</persName> literis certiora de dissidio illo pestilentissim<lb xml:id="p1z32"/>o<note xml:id="fn16" type="footnote" n="16"><persName ref="p8418">Myconius</persName> hatte bereits mehrfach vom Konflikt um die neuen Universitätsstatuten berichtet; vgl. oben <ref target="file11307">Nr. 1264</ref> und 1273.</note>.</s>
					<s n="16" xml:lang="la">Doctores creari volunt; metuendum, ne hoc <lb xml:id="p1z33"/>efficiant, ut et schola et ecclesia veris doctoribus careat.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z34"/>Sed hęc deus iudicet.</s>
					<s n="18" xml:lang="la">Sunt, qui dicant<note xml:id="fnd" type="footnote" n="d"><hi>vor</hi> dicant <hi>gestrichenes</hi> C.</note> <persName ref="p4349">Carolstadium</persName> <lb xml:id="p1z35"/><placeName ref="l587">Tigurum</placeName> rursus spirare; sed ego, quantum mihi<pb type="scan" next="2786v."/> <pb/><lb xml:id="p2z1"/>iuditii inest, huiusmodi virum patriae pręesse nollem.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z2"/>Nihil pręterea habeo, quod scribam, nisi si habes, quod in <placeName ref="l830">An<lb xml:id="p2z3"/>gliam</placeName> scribas, mitte per d. <persName ref="p506">Butlerum</persName>; est enim quidam mercat<lb xml:id="p2z4"/>or<note xml:id="fn17" type="footnote" n="17">Unbekannt.</note> <persName ref="p8418">Myconio</persName> familiarissimus, qui <placeName ref="l15">Antverpiam</placeName> brevi petet <lb xml:id="p2z5"/>literasque se curaturum pollicitus est.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><persName ref="p4830">Adamus Phrygio</persName><note xml:id="fn18" type="footnote" n="18"><persName ref="p4830">Adam Frey</persName>.</note> <lb xml:id="p2z6"/>nova iam experitur pharmaca.</s>
					<s n="21" xml:lang="la">Proxima die dominica<note xml:id="fn19" type="footnote" n="19">25. Mai (Pfingsten).</note> ipsum <lb xml:id="p2z7"/>conveniam; nam unius tantum horę itinere a <placeName ref="l28">Basilea</placeName> abest<note xml:id="fn20" type="footnote" ana="bio" n="20"><persName ref="p4830">Frey</persName> hielt sich einige Zeit bei einem Arzt in <placeName ref="l1738">Schliengen</placeName> (<placeName ref="l3389">Kr. Lörrach</placeName>, <placeName ref="l572">Baden-Württemberg</placeName>) auf, wie den Akten des Verfahrens gegen seine Ehefrau zu entnehmen ist (s. Zürich StA, A 27. 159, Nr. 22).</note>.<pb type="edition" next="147"/></s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p2z8"/>Haec rogo, ut aequi bonique consulas.</s>
					<s n="23" xml:lang="la" ana="salute">Salutabis meis <lb xml:id="p2z9"/>verbis <persName ref="p7042">matrem</persName><note xml:id="fn21" type="footnote" ana="bio" n="21"><persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note> et <persName ref="p8051">uxorem</persName><note xml:id="fn22" type="footnote" ana="bio" n="22"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> tuam, humanissimas ma<lb xml:id="p2z10"/>tronas, et omnem liberorum coetum<note xml:id="fn23" type="footnote" n="23">Vgl. oben <ref target="file11260">Nr. 1217</ref>, Anm. 46.</note>.</s>
					<s n="24" xml:lang="la" ana="farewell">Vale, patrone <lb xml:id="p2z11"/>charissime, et me, ut facis, amare pergito.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p2z12"/><placeName ref="l28">Basileę</placeName>, ex aedibus d. <persName ref="p8418">Miconii</persName>, 23. maii 1539.</s>
					<s n="26" xml:lang="la">Tui observantissimus <persName ref="p8011">Rodolphus<lb type="manual"/> Gvaltherus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse darunter:]</note>
					<s n="27" xml:lang="la"><lb xml:id="p2z13"/>Eruditione et pietate insigni viro d. <persName ref="p495">Heinrycho Bul<lb xml:id="p2z14"/>lingero</persName>, patrono suo imprimis colendo.</s>
				</p>
			</div>
