	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Clarissime vir, amice et frater inprimis colende, <lb xml:id="p1z2"/>etsi non dubito nostrum <persName>Gregorium</persName> rerum nostrarum <lb xml:id="p1z3"/><placeName ref="l832">Gallicarum</placeName> miserrimum statum fusissime expositurum, <lb xml:id="p1z4"/>nolui tamen illum sine aliquot lineis a me ad te <lb xml:id="p1z5"/>dimittere, ut saltem intelligas nos tui memoriam <lb xml:id="p1z6"/>nequaquam deposuisse, sed animis nostris, quoadusque <lb xml:id="p1z7"/>vixerimus, perpetuo infixam retinere.</s>
					<s n="3" xml:lang="la">Plura <lb xml:id="p1z8"/>autem non scribo propter summam animi maestitiam, <lb xml:id="p1z9"/>quam ex nefaria et plusquam perfida et barbarica <lb xml:id="p1z10"/>tot nobilium et christianorum virorum caede in <lb xml:id="p1z11"/><placeName ref="l832">Gallia</placeName> concepi.</s>
					<s n="4" xml:lang="la">Deum optimum maximum <lb xml:id="p1z12"/>rogans, ut tandem sui populi misereatur.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z13"/>Scio vobis hanc tragoediam non minus quam nobis <lb xml:id="p1z14"/>auditu molestissimam fore.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute">Bene vale et <lb xml:id="p1z16"/>fratres tuos meosque scholae et ecclesiae apud vos inservientes <lb xml:id="p1z17"/>meo nomine plurimum salutato.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l210">Heydel<lb xml:id="p1z18"/>bergae</placeName> 8. septembris a 1572.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z19"/>Tuus ex animo <lb xml:id="p1z20"/><persName ref="p997">Christophorus Ehemius</persName> d[octor].</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietate, doctrina ac virtute <lb xml:id="p2z2"/>clarissimo viro d. <persName ref="p495">Heynricho <lb xml:id="p2z3"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>fidelissimo d. et [amico] <lb xml:id="p2z5"/>suo inprimis honorando<lb xml:id="p2z6"/>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
