	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Excellentis<lb xml:id="p1z2"/>sime domine, esset quod prolixioribus litteris tecum <lb xml:id="p1z3"/>agerem, nisi me spectabilis vir dominus <persName>de la Murette</persName>, qui has <lb xml:id="p1z4"/>ad te defferet, officio scribendi hac occasione levaret.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z5"/>Diffusissime enim de rebus nostris et de his, quę huc <lb xml:id="p1z6"/>geruntur, tecum aget.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Hoc unum te rogo, ut aliquando, <lb xml:id="p1z7"/>et cum tibi sese obtulerit occasio et otium, ad me scribas <lb xml:id="p1z8"/>addasque (si videbitur) litteras tuas ad utrumque huiusce civitatis <lb xml:id="p1z9"/>ministrum cum tali, quę tibi videbitur pro amicitia nostra <lb xml:id="p1z10"/>et pro rebus nostris, mentione necessaria, easque lubenter illis <lb xml:id="p1z11"/>egomet reddam.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Ex <placeName ref="l98">Curia</placeName> 5. calendas iunii 1558.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Excellentie tuę obsequentissimus amicus <persName ref="p8306">J[ean] J[<lb xml:id="p1z13"/>acques] Decambray</persName>.</s>
				</p>
				<p>
					<note>[Nur Unterschrift autograph.]</note>
				</p>
				<p>
					<s n="7" xml:lang="la">Claris<pb/><lb xml:id="p2z1"/>simo viro domino <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, ecclesie <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ministro.</s>
					<s n="8" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note type="author">[Bemerkung von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="9" xml:lang="la">Primae d. <persName ref="p8306">a <lb xml:id="p2z5"/>Cambray</persName><lb xml:id="p2z6"/>.</s>
				</p>
			</div>
		</body>
	</text>
