	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Salutem et pacem a Christo nostra spe!</s>
					<s n="2" xml:lang="la">Scias, domine observande, <lb xml:id="p1z3"/>quod, uti in tuis literis, 13 Octob. datis, mihi significasti, <persName ref="p4747">Henr. <lb xml:id="p1z4"/>Falcknerus</persName> ad me scripsit brevi <lb xml:id="p1z5"/>postea de pretio pannorum meor<lb xml:id="p1z6"/>um conquerens.</s>
					<s n="3" xml:lang="la">Ad easdem <persName ref="p4747">Falckneri</persName> literas jam responsum hisce in<lb xml:id="p1z7"/>clusum mitto ad te, <lb xml:id="p1z8"/>precorque, <lb xml:id="p1z9"/>ut per tuum maximum otium id <lb xml:id="p1z10"/>legendo ei interpretari dignaberis.</s>
					<s n="4" xml:lang="la">In hoc namque <lb xml:id="p1z11"/>mihi gratifi<lb xml:id="p1z12"/>cabis multum.</s>
					<s n="5" xml:lang="la">Namque, ut <lb xml:id="p1z13"/>nosti, nescio Latine satis scribere, multo aute<lb xml:id="p1z14"/>m ineptius Germanice; <lb xml:id="p1z15"/>phrasin en<lb xml:id="p1z16"/>im linguae vestra<lb xml:id="p1z17"/>e <lb xml:id="p1z18"/>nescio adhuc as<lb xml:id="p1z19"/>sequi.</s>
					<s n="6" xml:lang="la">Sed ad i<lb xml:id="p1z20"/>nstitutum meum veniendum est.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Si dom<lb xml:id="p1z21"/>inus <persName ref="p4747">Falcknerus</persName> (postquam ei me<lb xml:id="p1z22"/>am ment<lb xml:id="p1z23"/>em ex meis <lb xml:id="p1z24"/>literis exposueris, sive <lb xml:id="p1z25"/>exponi per <lb xml:id="p1z26"/>alium dignatus fueris) pannos meos <lb xml:id="p1z27"/>iterum tibi reddat, <lb xml:id="p1z28"/>oro te, mi domine, ut recipias atque <lb xml:id="p1z29"/>conser<lb xml:id="p1z30"/>ves eos in aedibus tuis usque in <lb xml:id="p1z31"/>adventum <persName ref="p505">Joannis Bourcheri</persName>, <lb xml:id="p1z32"/>cui ego scribam meam m<lb xml:id="p1z33"/>entem quantum ad pannos illos <lb xml:id="p1z35"/>spectat, quid debet facere <lb xml:id="p1z36"/>cum eis.</s>
					<s n="8" xml:lang="la">Bona enim fide non possum <lb xml:id="p1z38"/>eos dare viliori pretio (ut nunc <lb xml:id="p1z39"/>est ratio temporis) quam <lb xml:id="p1z40"/><persName ref="p4747">Falcknero</persName> feci.</s>
					<s n="9" xml:lang="la">Si ego animum totum applicarem ad lucrum, <lb xml:id="p1z41"/>plus potuissem lucrari in mille florenis super aliis mercibus collo<lb xml:id="p1z42"/>catis (maxim<lb xml:id="p1z43"/>e hoc tempore belli) quam in duobus mill<lb xml:id="p1z44"/>ibus florenis in pannos impensis.</s>
					<s n="10" xml:lang="la">Semper autem pro oculis habeo <lb xml:id="p1z45"/>quod dicit apostolus 1 Tim. 6. de his, qui volunt in hoc seculo esse <lb xml:id="p1z46"/>divites.</s>
					<s n="11" xml:lang="la">De quatuor illis florenis, quo<lb xml:id="p1z47"/>s per <persName ref="p4747">Falcknerum</persName> ab <placeName ref="l491">Argentinensibus</placeName> <lb xml:id="p1z48"/>nundinis tibi misi, nunquam fui sollicitus: sed de illis scripsi potius, <lb xml:id="p1z49"/>ut scirem, an redditae fuerunt tum literae juvenis illi<lb xml:id="p1z50"/>us qui apud me est, quas simul cum pecuniis per <persName ref="p4747">Falcknerum</persName> amandavi.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z51"/>Tractabant ill literae de impiis aliquot statutis circa id <lb xml:id="p1z52"/>temporis per nostrum <lb xml:id="p1z53"/>parliamentum editis.</s>
					<s n="13" xml:lang="la">At si receperis <lb xml:id="p1z54"/>eas literas, bene est.</s>
					<s n="14" xml:lang="la">Juvenis enim ille, cui nomen est <persName ref="p3872">Franciscus <lb xml:id="p1z55"/>Warnerus</persName>, saepe me interrogavit, an redditae fuerint; <lb xml:id="p1z56"/>respondebam me de hoc non dubitasse, quia per <persName ref="p4747">Falcknerum</persName> <lb xml:id="p1z57"/>nos eas amandavimus.</s>
					<s n="15" xml:lang="la"><persName ref="p5231">Uxor</persName> mea tibi tuaeque conjugi ex animo <lb xml:id="p1z58"/>omnia bona precatur, dicitque se nullum habere dubium quod <lb xml:id="p1z59"/>ei enitenti eo citius auxiliatus est Deus propter vestras bonas <lb xml:id="p1z60"/>preces.</s>
					<s n="16" xml:lang="la">Secundo die hujus mensis Christi ecclesiae peperit <lb xml:id="p1z61"/>filium pro muliere procerae staturae satis magnum (ut aiunt <lb xml:id="p1z62"/>mulierculae), quem nominavi statim <persName ref="p5229">Gersom</persName>.</s>
					<s n="17" xml:lang="la">Quotidie exsp<lb xml:id="p1z63"/>ecto literas, sed nulla nova ex <placeName ref="l830">Anglia</placeName>.</s>
					<s n="18" xml:lang="la" ana="salute">Salutat valde diligente<lb xml:id="p1z64"/>r <persName ref="p5231">uxor</persName> mea prae omnibus uxorem tuam piissimam: <lb xml:id="p1z65"/>dicit quoque quod cupiit nescio quid, ut illa, cum jam hab<lb xml:id="p1z66"/>eat tam multos bellos liberos secum, orabit pro <persName ref="p5804">conjuge</persName> <lb xml:id="p1z67"/>D. <persName ref="p8412">Megandri</persName>, ut illa quoque pariat proles.</s>
					<s n="19" xml:lang="la" ana="salute">Salutes oro meo <lb xml:id="p1z68"/>nomine doctos illos apud vos omnes, quibus Christi ecclesia <lb xml:id="p1z69"/>tam multum devincti sunt, reddatque illis in illo die merce<lb xml:id="p1z70"/>dem multam Dominus noster Jesus, Princeps ille pastorum, tibi <lb xml:id="p1z71"/>autem maxime.</s>
					<s n="20" xml:lang="de">Amen.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z72"/>Tuus, <persName ref="p1548">RICARDUS HI<lb xml:id="p1z73"/>LL<pb/><lb xml:id="p2z1"/>ES</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="22" xml:lang="la"><lb xml:id="p2z2"/>Doctissimo ac pientissimo <lb xml:id="p2z3"/>theologo D. <persName ref="p495">Henrico Bul<lb xml:id="p2z4"/>lingero</persName>, <placeName ref="l587">Tigurinos</placeName> ecclesiae <lb xml:id="p2z5"/>concionatori primario, mi<lb xml:id="p2z6"/>hique imprimis observando.</s>
					<s n="23" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
