	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Dominus deus noster componat motus istos <lb xml:id="p1z2"/>in <placeName ref="l832">Gallia</placeName> ad gloriam nominis sui et incrementum <lb xml:id="p1z3"/>sacrosancti evangelii!</s>
					<s n="3" xml:lang="la">Multa crudelia instituunt hostes <lb xml:id="p1z4"/>veritatis evangelii, sed non proficient ul<lb xml:id="p1z5"/>terius quam dominus voluerit.</s>
					<s n="4" xml:lang="la">Hunc oremus <lb xml:id="p1z6"/>sedulo ne ipsis concedat letitiam, sed subvertat <lb xml:id="p1z7"/>cruenta ipsorum consilia.</s>
					<s n="5" xml:lang="la">Si quando <persName ref="p8033">Beza</persName> di<lb xml:id="p1z8"/>lectus frater noster ex <placeName ref="l832">Gallia</placeName> ad vos scripserit <lb xml:id="p1z9"/>certa de his quae ibi geruntur, rem facies gratissima<lb xml:id="p1z10"/>m si communicaveris ea nobiscum.</s>
					<s n="6" xml:lang="la">Libenter <lb xml:id="p1z11"/>vero tibi, frater, et imprimis amplissimo senatui <lb xml:id="p1z12"/>in eo quod mihi imposuisti negotio inservivi.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Nam cum gaudio legi institutum amplissimi senatus, <lb xml:id="p1z14"/>ac nisi mihi numerosior esset familia quam <lb xml:id="p1z15"/>ut quemquam recipere possim, ipse uni ex his exhibuissem <lb xml:id="p1z16"/>hospitium.</s>
					<s n="8" xml:lang="la">Adeo amplissimo senatui et tibi fratri <lb xml:id="p1z17"/>meo charissimo inservire cupio.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Invenimus autem <lb xml:id="p1z18"/>hospites illis commodos d. d. <persName ref="p8395">Georgium Cellarium</persName> <lb xml:id="p1z19"/>medicum, d. <persName ref="p8461">Ioannem Iacobum Wickium</persName> concionatorem <lb xml:id="p1z20"/>in nostra ecclesia, <persName ref="p4091">Huldricum Zvinglium</persName> generum meum, d. <lb xml:id="p1z21"/><persName ref="p1541">Ioan. Herterum</persName> hypodidascalum.</s>
					<s n="10" xml:lang="la">Offerunt praeterea suam <lb xml:id="p1z22"/>operam alii viri boni.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Precium erit viginti coron<lb xml:id="p1z23"/>atorum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Scripsi superioribus diebus de rebus nostris omnibus <lb xml:id="p1z24"/>per <placeName ref="l808">Belgam</placeName> quendam.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Spero eas tibi literas esse <lb xml:id="p1z25"/>traditas.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Nam amissas aut interceptas nollem.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z26"/>Dolemus et nos valde te tam cordato et fideli sym<lb xml:id="p1z27"/>mysta orbatum esse.</s>
					<s n="16" xml:lang="la">Sed dominus ecclesiae suae custos <lb xml:id="p1z28"/>et tutor sustulit illum.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Scit ille quibus sua in<lb xml:id="p1z29"/>digeat ecclesia.</s>
					<s n="18" xml:lang="la">Ac liberat ille fideles suos ministros <lb xml:id="p1z30"/>praesenti molestia.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Rogemus illum ut alios submittat <lb xml:id="p1z31"/>in messem suam fideles operarios.</s>
					<s n="20" xml:lang="la" ana="salute">Fratres nostri <lb xml:id="p1z32"/>omnes, <persName ref="p8011">Gvaltherus</persName> imprimis, <persName ref="p3988">Wolphius</persName>, <persName ref="p8111">Martyr</persName>, <lb xml:id="p1z33"/><persName ref="p8442">Simlerus</persName>, et caeteri te et tuos honorifice salutant.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z34"/>Vidisti haud dubie librum illum Latinum quem de prae<lb xml:id="p1z35"/>sentia corporis Christi in coena contra te imprimis <lb xml:id="p1z36"/>scripsit <persName ref="p20367">Tilemannus Hesshusius</persName> etc.</s>
					<s n="22" xml:lang="la">De his alia.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z37"/>aeternum cum tuis omnibus, domine colendissime et frater charissime.</s>
					<s n="24" xml:lang="la"><lb xml:id="p1z38"/>Dominus benedicat tibi.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 11. septemb. 1560.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p540">Ioanni <lb xml:id="p2z2"/>Calvino</persName>, fideli <placeName ref="l167">Genevensis</placeName> <lb xml:id="p2z3"/>ecclesiae pastori, domino <lb xml:id="p2z4"/>suo colendissimo et <lb xml:id="p2z5"/>fratri longe charissimo<lb xml:id="p2z6"/>.</s>
				</p>
			</div>
		</body>
