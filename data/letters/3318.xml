	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hae sunt alterae quas hodie ad te scribo sed <lb xml:id="p1z2"/>citius hae prioribus tibi reddentur.</s>
					<s n="3" xml:lang="la"><persName ref="p20206">Gribaldus</persName> hodie se<lb xml:id="p1z3"/>natum suppliciter rogavit ne eum <placeName ref="l512">Tubingam</placeName> remittat, <lb xml:id="p1z4"/>se paratum recipere et agere quicquid iussus fuerit.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Itaque denuo ad nos remissus est.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Cras cum illo agemus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/>Si abnegaverit errores suos et subscripserit confessioni <lb xml:id="p1z7"/>nostrae, symbolis item illis antiquis <placeName>Nicęno</placeName> et Athanasii, <lb xml:id="p1z8"/>mitigabitur forte lata in eum sententia.</s>
					<s n="7" xml:lang="la">Quicquid actum <lb xml:id="p1z9"/>fuerit tibi significabo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><persName ref="p4440">Budaeus</persName> quid afferat ex ipso <lb xml:id="p1z10"/>cognosces.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Senatus noster ea de re scribit ad vestrum.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z11"/>Non dubito quin <placeName ref="l832">Gallia</placeName> tandem poenas persolutura <lb xml:id="p1z12"/>sit tanti effusi cruoris piorum, et tam irremissi <lb xml:id="p1z13"/>contra eos furoris.</s>
					<s n="11" xml:lang="la">Dominus custodiat nos, ne faciamus <lb xml:id="p1z14"/>nos huius sceleris et poenae quoque simul participes.</s>
					<s n="12" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z15"/>Nostri te salutant.</s>
				</p>
				<p>
					<s n="14" xml:lang="de"><placeName ref="l41">Bernę</placeName> 17. septembris 1557.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p8018">Io. Hall</persName>. tuus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName> <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> ecclesię pastori <lb xml:id="p2z4"/>fidelissimo domino <lb xml:id="p2z5"/>et compatri colendissim<lb xml:id="p2z6"/>o charissimoque suo.</s>
					<s n="17" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
