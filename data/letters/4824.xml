	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Diu est, quo nihil a te literarum recepi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Que hic acta sunt in <lb xml:id="p1z2"/>controversia <placeName ref="l2478">Sabaudi</placeName> et <placeName ref="l41">Bernatum</placeName>, melius ex arbitro intelliges, quam <lb xml:id="p1z3"/>literis explicare possim; in summa omnia in tempus aliud dilata ut concilii <lb xml:id="p1z4"/>negocium.</s>
					<s n="4" xml:lang="la">Rex sacratus 15. huius mensis nunc est ad <placeName>Villecscelerem</placeName> unius <lb xml:id="p1z5"/>diei itinere a <placeName ref="l378">Lutetia</placeName>.</s>
					<s n="5" xml:lang="la">Veram regis effigiem ad te mitto.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">De eo multa sibi <lb xml:id="p1z6"/>boni promittunt; benedicat ei dominus.</s>
					<s n="7" xml:lang="la">Ni putarem te vidisse responsum <lb xml:id="p1z7"/><placeName ref="l491">Argentinensis</placeName> reipublicae ad legati pape postulata, misissem ad te.</s>
					<s n="8" xml:lang="la" ana="salute">Salutabis amplissimum <lb xml:id="p1z8"/>senatum et amicos omnes.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l28">Basilee</placeName> ultima maii.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z9"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse von anderer Hand:]</note>
					<s n="12" xml:lang="de"><pb/><lb xml:id="p2z1"/>An herren <persName ref="p495">Heinrichen <lb xml:id="p2z2"/>Bullinger</persName>, predicant der <lb xml:id="p2z3"/>statt <placeName ref="l587">Zürich</placeName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
