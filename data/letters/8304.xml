	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Gott mitt uns, fuͤrgeliepter sun, ich <lb xml:id="p1z2"/>danck dir und <persName ref="p20082">Susanna</persName> umb die hürlig; <lb xml:id="p1z3"/>hab ich nächt mitt unserm volck geässen.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z4"/><foreign xml:lang="de">In dinem embieten und fuͤrnemmen bestäte <lb xml:id="p1z5"/>dich gott; der sye din hilff,</foreign> et <lb xml:id="p1z6"/>festina, quantum potes, ut res tuas in tutum <lb xml:id="p1z7"/>componas; sic etiam me levabis onere <lb xml:id="p1z8"/>gravissimo.</s>
					<s n="3" xml:lang="de">Was ich hab, schicken ich <lb xml:id="p1z9"/>dir hie.</s>
					<s n="4" xml:lang="de">Der <persName>pfaltzgraff von Craca</persName> <lb xml:id="p1z10"/>schribt mir, köndt nitt früntlicher, uß <lb xml:id="p1z11"/><placeName ref="l2472">Poland</placeName>.</s>
					<s n="5" xml:lang="la">Aliquando videbis.</s>
					<s n="6" xml:lang="de">Unser <persName ref="p527">Joannes</persName> ligt <lb xml:id="p1z12"/>kranck zuͦ <placeName ref="l260">Craka</placeName>; wirt bald <lb xml:id="p1z13"/>me bottschafft kummen.</s>
					<s n="7" xml:lang="de">Me kan ich <lb xml:id="p1z14"/>diser zyt nitt schryben.</s>
					<s n="8" xml:lang="de">Gott mitt <lb xml:id="p1z15"/>üch allen.</s>
					<s n="9" xml:lang="de"><lb xml:id="p1z16"/>30. iunii in yl yl 1570.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p495">Bullinger</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="de"><pb/><lb xml:id="p2z1"/>Minem lieben sun <lb xml:id="p2z2"/><persName ref="p477">Hansen Rodolffen Bullingern</persName>, <lb xml:id="p2z3"/>pfarreren zuͦ <lb xml:id="p2z4"/><placeName ref="l35">Berg</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
