	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><persName ref="p6683">Barptolomeus Stekius</persName>, affinis meus, has abs tuo filio ad <lb xml:id="p1z2"/>me literas misit tibi primo nuntio perferendas.</s>
					<s n="3" xml:lang="la">Quas bo<lb xml:id="p1z3"/>no huic viro, qui <persName ref="p3878">Ioannis Widenhuberini</persName> piae memoriae filiae <lb xml:id="p1z4"/>nuptiis apud nos interfuit, certo quasi tabellario commendavi, <lb xml:id="p1z5"/>et pollicetur interim, si quid tuo filio vel pecuniarum vel <lb xml:id="p1z6"/>literarum vel aliarum rerum mittere habueris, et certis semper <lb xml:id="p1z7"/>nuntiis et primo quoque tempore ad eum perferri se diligentissime <lb xml:id="p1z8"/>curaturum.</s>
					<s n="4" xml:lang="la">Qua enim in re et tibi tuisque inservire et <lb xml:id="p1z9"/>gratiam facere et affinis meus et ego poterimus, habebis nos <lb xml:id="p1z10"/>semper paratissimos.</s>
					<s n="5" xml:lang="la">Rogo autem, si quid novi vel ex <placeName ref="l832">Gallia</placeName> vel <lb xml:id="p1z11"/><placeName ref="l830">Anglia</placeName> vel aliis ex locis ad te perscribatur, quod me scire dignum <lb xml:id="p1z12"/>existimaveris, me quoque facias certiorem, id quod et me factur<lb xml:id="p1z13"/>um benevole repromitto.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Raptim <placeName ref="l473">Sangalli</placeName> 13. calendas <lb xml:id="p1z14"/>septembris anno salutis 1556.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Tuus ex animo <persName ref="p5454">Iosueus <lb xml:id="p1z16"/>Kesslerus</persName>, <placeName ref="l473">Sangallensium</placeName> <lb xml:id="p1z17"/><foreign xml:lang="el">[griechisch]</foreign>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctrina et pietate praestantissimo viro <lb xml:id="p2z2"/>domino <persName ref="p495">Heinricho Bullingero</persName>, amplissimae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae antistiti, <lb xml:id="p2z4"/>domino et amico suo omni observatione <lb xml:id="p2z5"/>colendissimo.</s>
				</p>
