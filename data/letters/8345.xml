	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Rursum tuas, colendissime domine et compater, accepi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Quomodo vero iam res habeant <placeName ref="l280">Lausannę</placeName>, non aliter <lb xml:id="p1z3"/>scribere possum, quam quod scio <placeName ref="l832">Gallos</placeName> magna <lb xml:id="p1z4"/>copia ex <placeName ref="l167">Geneva</placeName> illuc commigrare propter magis ac <lb xml:id="p1z5"/>magis illic ingruentem pestem.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Vereor itaque, ne se<lb xml:id="p1z6"/>cum aliquid afferant contagii.</s>
					<s n="5" xml:lang="la">Scribam tamen genero, <lb xml:id="p1z7"/>et cum salva omnia esse comperero, <persName>Felicem</persName> tuum il<lb xml:id="p1z8"/>luc ad ipsum mittam.</s>
					<s n="6" xml:lang="la">Vix alibi melius quam apud <lb xml:id="p1z9"/>ipsum esse poterit, praesertim cum nunc liberatus sit <lb xml:id="p1z10"/>ab illo onere domestico, quo ei duodecim ordinarii <lb xml:id="p1z11"/>studiosi erant alendi; nunc non recipit, nisi quos vult, <lb xml:id="p1z12"/>et scio illum libenter hoc tibi et d. <persName ref="p1884">Lavatero</persName> praestiturum.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Dum mecum est, dabo operam, ut, sicut cepit, <lb xml:id="p1z14"/>ita ex omni parte pergat facere officium.</s>
					<s n="8" xml:lang="la">Diligo illum val<lb xml:id="p1z15"/>de propter ingenuitatem et candorem, et hoc nomine ab omni <lb xml:id="p1z16"/>quoque familia amatur, quę illum cuperet diutius <lb xml:id="p1z17"/>nobiscum, si ita res eius ferrent, commorari.</s>
					<s n="9" xml:lang="la">Ubi primum <lb xml:id="p1z18"/>ex <placeName ref="l280">Lausanna</placeName><note type="margin">a.R.: Lausama!</note> responsum accepero, faciam te illius <lb xml:id="p1z19"/>certiorem.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Bene vale cum tuis omnibus, quibus <lb xml:id="p1z20"/>plurimum ex me salutis dicas, oro.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l41">Bernae</placeName> 8. augusti <lb xml:id="p1z21"/>1570.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/>Tuus ex animo <lb xml:id="p1z23"/><persName ref="p8018">Iohannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>antistiti fidelissimo, <lb xml:id="p2z4"/>honorando meo domino et <lb xml:id="p2z5"/>compatri.</s>
				</p>
			</div>
		</body>
	</text>
