	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>[...] Orandus est <lb xml:id="p1z2"/>dominus, ut... tranquillitatem con<lb xml:id="p1z3"/>e...</s>
					<s n="2" xml:lang="la">Ante septimanam unam et alteram misi ad te historiam <lb xml:id="p1z4"/>consiliorum nostrorum de edenda fidei confessione <lb xml:id="p1z5"/>in gratiam <placeName ref="l2477">Palatini</placeName> et ut minus damnentur nostrae <lb xml:id="p1z6"/>ecclesiae in comitiis ab imperatore, qui dicitur nunc <lb xml:id="p1z7"/>agere <placeName ref="l18">Augustae</placeName> et moliri nescio quid contra veram <lb xml:id="p1z8"/>religionem.</s>
					<s n="3" xml:lang="la">Dominus defendat suas ecclesias.</s>
					<s n="4" xml:lang="la">Nunc <lb xml:id="p1z9"/>submitto ea, quae ab iis, quae ultimo legisti et <lb xml:id="p1z10"/>remisisti, acta sunt; ea remitte prima quaque <lb xml:id="p1z11"/>opportunitate nacta.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z12"/>Nunc in hoc sum totus, ut Latina Expositio <lb xml:id="p1z13"/>edatur et ut vertam in <placeName ref="l822">Germanicam</placeName>; ita <lb xml:id="p1z15"/>nunquam mihi conceditur otium.</s>
					<s n="6" xml:lang="la">Sed libentissime <lb xml:id="p1z16"/>laboro in domini vinea.</s>
					<s n="7" xml:lang="la">Spero autem me bre<lb xml:id="p1z17"/>vi ab illo evocandum in sedes beatas, quas ex <lb xml:id="p1z18"/>animo desidero huius vitae plus quam pertaesus et<lb xml:id="p1z19"/>c.</s>
					<s n="8" xml:lang="la">Cras mittam proprium nuncium <placeName ref="l210">Heydelbergam</placeName>; <lb xml:id="p1z20"/>ideo nunc plures mihi literae sunt scribendae; con<lb xml:id="p1z21"/>donabis itaque, si brevior sum.</s>
					<s n="9" xml:lang="la" ana="salute">Si quid habes <lb xml:id="p1z22"/>ex <placeName ref="l834">Italia</placeName> certi, communica nobis et saluta d. consules, <lb xml:id="p1z23"/><persName ref="p20976">Baltazarem interpretem Gryssachensem</persName>, <persName ref="p6130">Pontasellam</persName> etc.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p8033">Beza</persName> scribit (literas iamiam accipio) in <placeName ref="l832">Gallia</placeName> <lb xml:id="p1z25"/>reconciliari familiam <persName ref="p20978">Castilioneorum</persName> cum <persName ref="p20977">Guysiaca</persName>.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z26"/>Aliunde, quod communicem, habeo nihil.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale cum familia tua et bonis omnibus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z27"/><placeName ref="l587">Tiguri</placeName> 1. februarii 1566.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z28"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z29"/>Pietate et <pb/><lb xml:id="p2z1"/>eruditione <lb xml:id="p2z3"/>praestantissimo viro d. <lb xml:id="p2z4"/><persName ref="p8009">Ioanni Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z5"/>ecclesiae ministro, <lb xml:id="p2z6"/>domino meo colendo et <lb xml:id="p2z7"/>compatri fratrique charissimo.</s>
					<s n="16" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>