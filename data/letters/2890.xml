	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><persName ref="p20685">Iacobus Spalerus</persName>, de quo superiori scrip<lb xml:id="p1z2"/>si epistolio, ni interceptum sit vel non <lb xml:id="p1z3"/>acceperis, liberatus est a tyrannide Caiaphę <lb xml:id="p1z4"/>idque sine aliqua multa et nisi quinque coronatos <lb xml:id="p1z5"/>solvit pro alimonia fiscali, ut vocant.</s>
					<s n="3" xml:lang="de"><foreign xml:lang="la">Qui <lb xml:id="p1z6"/>s<lb xml:id="p1z7"/>chedulam laconicam hisce verbis misit:</foreign> "<persName>Margret</persName>, <lb xml:id="p1z8"/>wilt din eeman ledig han, so schick funff <lb xml:id="p1z9"/>cronen."</s>
					<s n="4" xml:lang="la">Bone deus, stulti illi cęci fatentur <lb xml:id="p1z10"/>coniugium boni viri pauci et apertis <lb xml:id="p1z11"/>verbis, et cur adductus in carcerem?</s>
					<s n="5" xml:lang="la"><pb/><lb xml:id="p2z1"/><placeName ref="l335">Mülhusii</placeName> aegrotat propter carceris squalorem <lb xml:id="p2z2"/>ac inediam; nam semestri fere pane <lb xml:id="p2z3"/>et aqua sustentatus est.</s>
					<s n="6" xml:lang="la">Brevi, spero, illum <lb xml:id="p2z4"/>recipiemus.</s>
					<s n="7" xml:lang="la">Tum ex illo audiemus, quid <lb xml:id="p2z5"/>a ministris Satanę sit perpessus etc.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale.</s>
					<s n="9" xml:lang="la"><lb xml:id="p2z6"/>11. aprilis etc.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z7"/>Tuus <lb xml:id="p2z8"/><persName ref="p1010">Erbius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
					<note>Zu <persName ref="p20685">Jakob Spaler</persName> vgl. <persName ref="p1010">Erb</persName> an <persName ref="p495">HB</persName>, 1556, März 22.</note>
				</p>
			</div>
		</body>
	</text>
