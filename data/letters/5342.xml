	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hodie synodus nostra, reverende in Christo pater, solita est, <lb xml:id="p1z2"/>quae iam duravit triduum totum.</s>
					<s n="3" xml:lang="la">Causa <persName>Leonis</persName> recruduerat <lb xml:id="p1z3"/>et nos detinuit plures horas; post longam <lb xml:id="p1z4"/>demum concertationem haec ab illo extorsimus, quae <lb xml:id="p1z5"/>mitto.</s>
					<s n="4" xml:lang="la">Quae omnia tibi prolixius charissimus noster <lb xml:id="p1z6"/>frater d. <persName ref="p8057">Huldrychus Campellus</persName>, si <lb xml:id="p1z7"/>petieris, pro candore suo exponere poterit, <lb xml:id="p1z8"/>ex quo et audies, quis causam d. <persName>Leonis</persName> egerit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Plura proxime.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">De concilio quae sciri potuerunt, <lb xml:id="p1z10"/>ex d. <persName>Iulio</persName> intellexisti.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Scribit d. <persName ref="p6831">Traversius</persName> <lb xml:id="p1z11"/>et promittit d. <persName>Friderychus</persName> se posthac certa <lb xml:id="p1z12"/>habituros; sibi enim esse consanguineum, qui <lb xml:id="p1z13"/>versetur in aula ducis <placeName ref="l1060">Mantuani</placeName>.</s>
					<s n="8" xml:lang="de">Die <lb xml:id="p1z14"/>krönung <persName ref="p18556">Maximiliani</persName> (die behömisch krönung) ist <lb xml:id="p1z15"/>wider abgeschaffen; <foreign xml:lang="la">est certum.</foreign></s>
					<s n="9" xml:lang="de">Es hat sich der <lb xml:id="p1z16"/>graaff von <placeName>Sultz</placeName> und andere ouch schon daruff <lb xml:id="p1z17"/>gerüst, und als sy diser tagen habend verryten <lb xml:id="p1z18"/>wöllen, ist uff der post die sach abkündt; <lb xml:id="p1z19"/><foreign xml:lang="la">causam ignoro.</foreign></s>
					<s n="10" xml:lang="la"><foreign xml:lang="de"><placeName>Sfortia</placeName> sol von den <placeName ref="l522">Venedigern</placeName> gefange<lb xml:id="p1z20"/>n,</foreign> alii putant <lb xml:id="p1z21"/>sublatum; dicitur indignius tractas<lb xml:id="p1z22"/>se nescio quem magnum Venetum.<note type="misc">gestrichen.</note></s>
					<s n="11" xml:lang="la">Sed omnia proxime prolixius; haec nunc.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Certe adeo defectus sum concionando (<lb xml:id="p1z23"/>sed nondum finis), ut non possim amplius.</s>
					<s n="13" xml:lang="la">Ignosce <lb xml:id="p1z24"/>et de rebus <placeName ref="l832">Gallicis</placeName> nos edoce; nam omnes <lb xml:id="p1z25"/>anxie expectamus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale d. d. pater.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z26"/><placeName ref="l98">Curię</placeName> 29. maii anno 1562.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z27"/>Tui observantissimus <lb xml:id="p1z28"/><persName ref="p8009">Ioan[nes] F[abri<lb xml:id="p1z29"/>cius]</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Has literas pridie scripsi.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Nunc ita subito <lb xml:id="p1z30"/>discedunt, ut plura non possim; sed scribam <lb xml:id="p1z31"/>cras et puto ex nostris profecturos.</s>
					<s n="19" xml:lang="la">Transiit <lb xml:id="p1z32"/>hac quidam <placeName ref="l1107">Tridentinus</placeName> per postam, qui <lb xml:id="p1z33"/>videtur explorator nec negare potest marchionem <pb/><lb xml:id="p2z1"/>de <persName>Peschier</persName> domum rediisse; alii autem pro certo affirmant (<lb xml:id="p2z2"/>sed ego nihil affirmo) marchionem, qui illuc missus erat n<lb xml:id="p2z3"/>omine <persName>Philippi</persName> regis, protestatum cum episcopis non procedendum, dum pontifex se subiiciat concilio.</s>
					<s n="20" xml:lang="la">Plura <lb xml:id="p2z4"/>nunc non possum.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Amplissimo viro eruditione et pietate singulari d. <persName ref="p495">Heinrycho Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> antistiti <lb xml:id="p2z5"/>vigilantissimo, domino et patrono suo etc.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>