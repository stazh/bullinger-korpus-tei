			<zone xml:id="p2z5-0" points="638,679 748,634 835,659 1089,627 1185,668 1290,625 1420,641 1413,547 1094,576 902,545 777,614 714,572 641,589">653,632 691,633 730,632 768,632 807,631 845,629 884,626 922,626 961,624 999,623 1038,621 1077,617 1115,617 1154,614 1192,614 1231,614 1269,614 1308,613 1346,612 1385,612 1424,609</zone>
