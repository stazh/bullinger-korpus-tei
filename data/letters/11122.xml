	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Consulem nostrum quartana iterum invasit<note xml:id="fn1" type="footnote" n="1">Zur Erkrankung <persName ref="p8178">Thomas Blarer</persName>s vgl. oben <ref target="file11085">Nr. 1043</ref>, 43; 1064, 11.</note>, <lb xml:id="p1z2"/><persName ref="p495">Bullingere</persName> charissime; sed non speramus duraturam.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Commendo tamen eum precibus tuis.</s>
					<s n="4" xml:lang="la">Iussit tibi pro <lb xml:id="p1z4"/>salute gratias agere et longe plurimam remittere.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>De <persName ref="p8398">Clausero</persName> iuvene sic se res habet, quemadmodum <lb xml:id="p1z6"/>in aliis literis sum testatus<note xml:id="fn2" type="footnote" n="2">Siehe oben <ref target="file11107">Nr. 1064</ref>, 14-28; 1076, 2-9.</note>; tamen, si nobis tuorum <lb xml:id="p1z7"/>favore contigisset, dedissemus summam operam, ne <lb xml:id="p1z8"/>cum studiorum suorum neglectu, sed profectu nobiscum <lb xml:id="p1z9"/>fuisset.</s>
					<s n="6" xml:lang="la">Nunc autem, cum hęc spes elapsa sit nobis, <lb xml:id="p1z10"/>tamen non desinimus rogare te usque et usque, ut, si quis <lb xml:id="p1z11"/>alius talis tuo consilio et ope tua nobis possit contingere<lb xml:id="p1z12"/>, ne quid negligas, mi frater.</s>
					<s n="7" xml:lang="la">Periculum, quod <lb xml:id="p1z13"/>secum haec mora adfert, misere nos divexat; <lb xml:id="p1z14"/>vellemus enim pueris nostris in tempore consultum.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Sed iam nihil aliud habeo properante etiam tabellio<lb xml:id="p1z16"/>ne isto<note xml:id="fn3" type="footnote" n="3">Unbekannt.</note>, qui ad nos missus est, quemadmodum <lb xml:id="p1z17"/>ex literis hic vides.</s>
					<s n="9" xml:lang="la">Caeterum, cum <persName ref="p17774">Albertum</persName> illum <lb xml:id="p1z18"/>apud nos nusquam repererim<note xml:id="fn4" type="footnote" n="4">Wie es scheint, war der Briefüberbringer auf der Suche nach Werken des scholastischen Theologen und Philosophen <persName ref="p17774">Albertus Magnus</persName> (gest. 1280). - Lit.: Paul <hi>Simon,</hi> in: <bibl source="b641">TRE</bibl> II 177-184; Georg <hi>Wieland,</hi> in: LThK<hi rend="sup">3</hi> I 337-339.</note>, vellem, tu quoque <lb xml:id="p1z19"/>faceres offitium in gratiam istius boni viri, si <lb xml:id="p1z20"/>forte apud vos inveniretur, quanquam etiam <lb xml:id="p1z21"/>dubitarim, philosophicane an vero theologica <lb xml:id="p1z22"/>velit.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale, mi frater, et ora dominum pro me.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z23"/>15. decembris 1537.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/>Libellum<note xml:id="fn5" type="footnote" n="5"><persName ref="p2301">Osianders</persName> "Coniuratio Papistarum"; vgl. oben <ref target="file11119">Nr. 1076</ref>, 19 mit Anm. 10.</note> hic remitto cum gratiarum actione.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z25"/>Tuus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="14" xml:lang="la">Domino <pb/><lb xml:id="p2z1"/><persName ref="p495">Hainricho Bullingero</persName> <lb xml:id="p2z3"/><placeName ref="l587">Tigurino</placeName>, suo <lb xml:id="p2z4"/>charissimo fratri<lb xml:id="p2z8"/>.</s>
				</p>
			</div>
		</body>
	</text>
