	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi hodie a prandio ad te literas, <lb xml:id="p1z2"/>quas per oeconomum <placeName ref="l269">Küngsfeldensem</placeName><note xml:id="fn1" type="footnote" n="1">Dachselhofer? Vincenz Pfister? Vgl. Leu Lexikon.</note> <lb xml:id="p1z3"/>ad fratrem meum <placeName ref="l21">Badenam</placeName> misi, quoniam <lb xml:id="p1z4"/>de hoc nuncio, qui has tibi adfert, nihil<lb xml:id="p1z5"/>dum scribam.</s>
					<s n="3" xml:lang="la">Interea senatui nostro <lb xml:id="p1z6"/>ex <placeName ref="l791">Valesia</placeName> literae allatae sunt.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Senatus <lb xml:id="p1z7"/>hora 4. illico congregatus, praefectus <lb xml:id="p1z8"/><placeName>Aquileiensis</placeName>, qui hic in urbe erat rationes <lb xml:id="p1z9"/>suas redditurus, ex tempore domum <lb xml:id="p1z10"/>remissus, ut cunctis invigilet.</s>
					<s n="5" xml:lang="la">Cras <lb xml:id="p1z11"/>duo legati sequentur salinas quasi nostras <lb xml:id="p1z12"/><placeName>Aquileienses</placeName> inspecturi, sed eo potissimum nomine <lb xml:id="p1z13"/>mittuntur, ut rebus <placeName ref="l791">Valesianis</placeName> invigilent.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Venerunt enim <placeName ref="l2542">Septem Cantonum</placeName> legati <lb xml:id="p1z15"/>illuc; quid acturi sint, nondum certo constat, <lb xml:id="p1z16"/>quamvis hoc certius constet, quam quid <lb xml:id="p1z17"/>sint effecturi.</s>
					<s n="7" xml:lang="la">Nostri valde sunt solliciti.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z18"/>Quamprimum, quid fiat, cognovero, faciam <lb xml:id="p1z19"/>te certiorem.</s>
					<s n="9" xml:lang="la">Haec (quoniam nuncius hic <lb xml:id="p1z20"/>sub vesperam se mihi obtulit) te ignorare <lb xml:id="p1z21"/>nolui.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Velim, ut uno verbo fratrem <lb xml:id="p1z22"/>meum horum etiam certiorem reddas, ne, quoniam <lb xml:id="p1z23"/>scripsi illi nihil mihi constare de legatis, <lb xml:id="p1z24"/>se a me delusum existimet.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z25"/><placeName ref="l41">Bernae</placeName> 21. iulii sub noctat.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Salutat te <lb xml:id="p1z26"/>quęstor <persName ref="p4639">Dilgerus</persName>, cum quo fui in <lb xml:id="p1z27"/>coena et a quo haec omnia cognovi.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><persName ref="p8018">H[allerus]</persName> <lb xml:id="p1z28"/>tuus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="de"><lb xml:id="p2z3"/>M. <persName ref="p495">Heinrych <lb xml:id="p2z4"/>Bullingern</persName> zuͦ <lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
				<p>
					<note type="date">[Datum: Erwähnt in Brief vom 22. Juli 1560.]</note>
				</p>
			</div>
		</body>
	</text>
