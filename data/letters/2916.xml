	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p1586">Fr<lb xml:id="p1z2"/>anciscus Ho<lb xml:id="p1z3"/>tomanus</persName> S<lb xml:id="p1z4"/>. <lb xml:id="p1z5"/>D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Apud dom<lb xml:id="p1z6"/>inu<lb xml:id="p1z7"/>m <persName ref="p8111">Marty<lb xml:id="p1z8"/>rem</persName> non <lb xml:id="p1z9"/>tuam, s<lb xml:id="p1z10"/>ed ec<lb xml:id="p1z11"/>cl<lb xml:id="p1z12"/>esi<lb xml:id="p1z13"/>ae <lb xml:id="p1z14"/>dei cau<lb xml:id="p1z15"/>sam <lb xml:id="p1z16"/>egi<lb xml:id="p1z17"/>, m<lb xml:id="p1z18"/>ulta s<lb xml:id="p1z19"/>unt <lb xml:id="p1z20"/>tame<lb xml:id="p1z21"/>n a<lb xml:id="p1z22"/>ccurate <lb xml:id="p1z23"/>consider<lb xml:id="p1z24"/>anda <lb xml:id="p1z25"/>et pru<lb xml:id="p1z26"/>d<lb xml:id="p1z27"/>enter; nam <lb xml:id="p1z28"/>si <lb xml:id="p1z31"/>discesser<lb xml:id="p1z32"/>it, de successione sumus vehementer solliciti.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z33"/>Si liceret nomen ascribere monachuli cuiusdam, quem huc hostis noster adduxit; qui quid <lb xml:id="p1z34"/>effecturus sit, incerti sumus; quid velit et quo intendat, nemo nescit.</s>
					<s n="4" xml:lang="la">Hoc quoque d. <lb xml:id="p1z35"/><persName ref="p8111">Martyr</persName> perpendet.</s>
					<s n="5" xml:lang="la">Literas accepi a domino <persName ref="p540">Calvino</persName> et <persName ref="p8033">Beza</persName>, quarum libenter ad te e<lb xml:id="p1z36"/>xemplum mitterem, si mihi describendi otium fuisset.</s>
					<s n="6" xml:lang="la">Videres testimonium illarum <lb xml:id="p1z37"/>ecclesiarum et de eo, quem impium, crudelem, impudentem, sicophantem, manifestum <lb xml:id="p1z38"/>apostatam appellant.</s>
					<s n="7" xml:lang="la">Tuis fratrum et illorum monitis, quoad potero, parebo et hanc <lb xml:id="p1z39"/>insaniam deo iuvante sempiterna oblivione delebo.</s>
					<s n="8" xml:lang="la">Quo tamen id pacto fiat, in<lb xml:id="p1z40"/>certus sum; nam quotidie sic pergit, et nunc, cum videat se neque existimationem <lb xml:id="p1z41"/>neque fortunas meas laedere potuisse, de capite meo, ut audio, consilium ineat.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z42"/>Rem tibi magis perspicue patefacere non audeo, nunc quod sit tempus, vides.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z43"/>Dicunt regem <placeName ref="l832">Galliae</placeName> timeri sedulo; civitas munitur; a <placeName ref="l832">Gallis</placeName> ergo cavebitur.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z44"/>In hoc tumultu verbulum plus nocere poterit quam alio tempore accusatio<lb xml:id="p1z45"/>nes verbosissimae.</s>
					<s n="12" xml:lang="la">Deus familiae meae miserebitur; migratio mihi esset gratissima <lb xml:id="p1z46"/>hoc tempore praesertim, cum uxor propediem paritura sit; sed si mea negotia <placeName ref="l378">Lutetiae</placeName> <lb xml:id="p1z47"/>confecta essent, id est mater respondisset, ut <foreign xml:lang="el">[griechisch]</foreign> aut <foreign xml:lang="el">[griechisch]</foreign> praestare <lb xml:id="p1z48"/>mecum agi putarem.</s>
					<s n="13" xml:lang="la">Si qua in re ecclesiae vestrae prodesse possem, de quo rogo, ut cogites, <pb/><lb xml:id="p2z1"/>tacitum tamen hoc apud te habeas.</s>
					<s n="14" xml:lang="la">Hoc tamen vehementer a te peto, ut magis non <lb xml:id="p2z2"/>possim, si placet ad me scribere, gratissimum feceris; sed quaeso, ne ad quenquam <lb xml:id="p2z3"/>alium.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Mi reverende et optime pater, vale.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l491">Argent[inę]</placeName> 8. maii 1556.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">D<lb xml:id="p2z4"/>omi<lb xml:id="p2z6"/>nu<lb xml:id="p2z7"/>m <persName ref="p1283">Ge<lb xml:id="p2z8"/>ssn<lb xml:id="p2z9"/>erum</persName> <lb xml:id="p2z10"/>et domi<lb xml:id="p2z11"/>nu<lb xml:id="p2z12"/>m <lb xml:id="p2z13"/><persName ref="p8011">Gualte<lb xml:id="p2z14"/>rum</persName>, vi<lb xml:id="p2z15"/>ros clari<lb xml:id="p2z16"/>ssim<lb xml:id="p2z17"/>os, me<lb xml:id="p2z18"/>o n<lb xml:id="p2z19"/>omin<lb xml:id="p2z20"/>e salute<lb xml:id="p2z21"/>s velim<lb xml:id="p2z22"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="18" xml:lang="la">Clarissi<lb xml:id="p2z23"/>mo viro d. <persName ref="p495">Henr<lb xml:id="p2z24"/>i<lb xml:id="p2z26"/>co <lb xml:id="p2z29"/>Bullingero</persName> <lb xml:id="p2z30"/>ex<lb xml:id="p2z31"/>im<lb xml:id="p2z32"/>io de<lb xml:id="p2z33"/>i et ec<lb xml:id="p2z34"/>cl<lb xml:id="p2z35"/>esiae <placeName ref="l587">T<lb xml:id="p2z36"/>igu<lb xml:id="p2z37"/>ri<lb xml:id="p2z38"/>nen<lb xml:id="p2z39"/>sis</placeName> <lb xml:id="p2z40"/>m<lb xml:id="p2z41"/>inis<lb xml:id="p2z42"/>tro, th<lb xml:id="p2z43"/>eolo<lb xml:id="p2z44"/>go pr<lb xml:id="p2z45"/>aestant<lb xml:id="p2z46"/>issim<lb xml:id="p2z47"/>o.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z48"/><placeName ref="l587">Tig<lb xml:id="p2z49"/>uri</placeName>.</s>
				</p>
