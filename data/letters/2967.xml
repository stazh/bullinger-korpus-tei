	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Mi <persName ref="p495">Bullingere</persName> salve.</s>
					<s n="2" xml:lang="la">E <placeName ref="l2472">Sarmatia</placeName> usque scribere ad te <lb xml:id="p1z2"/>me cogit singularis benevolentia, qua te prosequor.</s>
					<s n="3" xml:lang="la">Ven<lb xml:id="p1z3"/>i hu<lb xml:id="p1z4"/>c 24 dierum spatio, sed acceleravi aliquan<lb xml:id="p1z5"/>tulum, quia sic opus erat.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Omnia inveni mitiora <lb xml:id="p1z7"/>et civiliora, quam putaram, celum, terram, homines, <lb xml:id="p1z8"/>inprimis principem.</s>
					<s n="5" xml:lang="la">Crede mihi, <persName ref="p495">H. Bullingere</persName>, non <lb xml:id="p1z9"/>habere totam <placeName ref="l822">Germaniam</placeName> talem principem, sive pietatem <lb xml:id="p1z10"/>sive eruditionem sive prudentiam spectes.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Deus eum diutius servet ob gloriam nominis sui.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Excepit me longe honorificentius, quam vellem, <lb xml:id="p1z14"/>totusque in eo nunc est, ut mihi compedes iniiciat, <lb xml:id="p1z15"/>ne possim amplius hinc egredi.</s>
					<s n="8" xml:lang="la">Pudet scribere, <lb xml:id="p1z16"/>quam magna mihi promittat, ne videar agno<lb xml:id="p1z17"/>scere aut dare suspitionem, quod putem me illis <lb xml:id="p1z18"/>dignum, ut certe non sum.</s>
					<s n="9" xml:lang="la">Respondi diserte <lb xml:id="p1z19"/>deum mihi illam stationem dedisse, in qua hactenus <lb xml:id="p1z20"/>fui, qua nolle me eam deserere.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Sunt quidam adhuc contentiones aliquae in his ecclesiis, <lb xml:id="p1z22"/>sed spero eas sopitum iri, quin bella quoque nunc <lb xml:id="p1z23"/>sunt inter hunc principem et <placeName ref="l2574">Livonienses</placeName>, sed <lb xml:id="p1z24"/>agitur de pace, ac forte succedet.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Salutavi ve[rbis] <lb xml:id="p1z25"/>meis d. <persName ref="p2095">Melanthonem</persName>, qui, quum esset mecum <lb xml:id="p1z26"/>cenaturus, adduxit secum convivam tuum filium <lb xml:id="p1z27"/>et duos <persName>Colinos</persName> fratres.</s>
					<s n="12" xml:lang="la">Ita visus es[t] mihi amare <lb xml:id="p1z28"/>vestrates.</s>
					<s n="13" xml:lang="la">Laetabatur, quod audierat futurum con<lb xml:id="p1z29"/>ventum in causa religionis, atque ego quoque laetarer, <lb xml:id="p1z30"/>si aut certo sperarem futurum aut homines <pb/><lb xml:id="p2z1"/>allaturos eo moderatos animos.</s>
					<s n="14" xml:lang="la">Res <placeName ref="l2472">Poloniae</placeName> <lb xml:id="p2z2"/>non ita fervent, ut putabantur; sunt quidem nonnulli <lb xml:id="p2z3"/>ex primoribus regni, qui favent; sed florentis<lb xml:id="p2z4"/>sima est aposcoporum potentia, et rex plane <lb xml:id="p2z5"/>fovet eos cum toto papatu.</s>
					<s n="15" xml:lang="la">Fient tamen <lb xml:id="p2z7"/>comitia ad <persName>Bartholomei</persName>, quibus ego quoque in<lb xml:id="p2z8"/>tereo, si audiero serio fieri.</s>
					<s n="16" xml:lang="la">Spero me <lb xml:id="p2z9"/>ante initium proximi anni in <placeName>Suevia</placeName> futurum, <lb xml:id="p2z10"/>si deus voluerit.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z11"/>Forsan has ad te feret d. <persName>Timotheus Gersovius</persName>, <lb xml:id="p2z12"/>huius illustrissimi principis secretarius.</s>
					<s n="18" xml:lang="la">Si ips tulerit, <lb xml:id="p2z14"/>oro atque obsecro, cura, ut honorifice excip<lb xml:id="p2z15"/>iatur, ut tuus est mos.</s>
					<s n="19" xml:lang="la">Certe est principi <lb xml:id="p2z16"/>gratus.</s>
					<s n="20" xml:lang="la" ana="salute">Salvere iubeo d. <persName ref="p8011">Gualterum</persName>, d. <lb xml:id="p2z18"/><persName ref="p1283">Gasnerum</persName>, quorum libros una cum tuis vidi <lb xml:id="p2z19"/>tum in privata tum in publica principis <lb xml:id="p2z20"/>instructissima biblyotheca.</s>
					<s n="21" xml:lang="la" ana="salute">Salvere iubeo <lb xml:id="p2z21"/>tuos tris generos et totam familiam<lb xml:id="p2z22"/>.</s>
					<s n="22" xml:lang="la" ana="salute"><lb xml:id="p2z23"/>Si iam sit apud vos d. <persName ref="p8111">Martyr</persName>, salvere quoque <lb xml:id="p2z24"/>atque inprimis iubeo.</s>
					<s n="23" xml:lang="la">Orate pro me.</s>
					<s n="24" xml:lang="la"><lb xml:id="p2z25"/>Gratia et pax domini nostri Iesu Christi cum omnibus <lb xml:id="p2z27"/>vobis, amen.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p2z28"/>E <lb xml:id="p2z30"/><placeName ref="l268">Regio Monte</placeName> 2<lb xml:id="p2z31"/>0<lb xml:id="p2z32"/>. <lb xml:id="p2z33"/>iulii <lb xml:id="p2z34"/>1556.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p2z35"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<note>[Von anderer Hand:]</note>
					<s n="27" xml:lang="la">Cla<lb xml:id="p2z36"/>ris<lb xml:id="p2z37"/>s<pb/><lb xml:id="p3z1"/>imo viro domino <persName ref="p495">Henrico <lb xml:id="p3z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p3z3"/>antistiti, fratri honorando.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p3z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
