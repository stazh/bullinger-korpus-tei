	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quaecunque habeo, heri ad fratrem scripsi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Is ea omnia tibi commun<lb xml:id="p1z2"/>icabit, nec habeo, quod nunc illis addam, nisi quod hisce meis <lb xml:id="p1z3"/>fiduciam illis, qui eas ferunt, addere volui liberius te con<lb xml:id="p1z4"/>veniendi.</s>
					<s n="4" xml:lang="la">Hoc enim a me petierunt, quamvis prius tibi <lb xml:id="p1z5"/>noti sint, <persName ref="p8102">Roberti Stephani</persName> filius et <persName ref="p20638">Engelbertus Hessus</persName>.</s>
					<s n="5" xml:lang="la" ana="salute">S<lb xml:id="p1z6"/>alutem tibi dicunt d. consul <persName ref="p8063">Steigerus</persName>, quaestor a <persName ref="p7511">Grafenriet</persName>, <lb xml:id="p1z7"/><persName ref="p8012">Hallerus</persName>, <persName ref="p8389">Hagius</persName>, <persName ref="p9046">Pistorius</persName>, <persName ref="p4060">Zehenderi</persName>, socer, mater denique <lb xml:id="p1z8"/>mea.</s>
					<s n="6" xml:lang="la">Salvi sint tui omnes.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l41">Bernae</placeName> 6. augusti 62.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><persName ref="p8018">I[oannes] <lb xml:id="p1z9"/>Hall[erus</persName>] semper tuus.</s>
				</p>
				<p>
					<note>[Adresse a. t.:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fide<lb xml:id="p2z4"/>lissimo, domino suo hono<lb xml:id="p2z5"/>rando et compatri <lb xml:id="p2z6"/>colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
