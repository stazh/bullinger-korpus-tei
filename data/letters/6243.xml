	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">De rebus <placeName ref="l832">Gallicis</placeName> nihil me opus est scribere, cum <lb xml:id="p1z2"/>singulatim omnia ex hoc <persName ref="p1918">Linero</persName> nostro, qui modo <lb xml:id="p1z3"/>ex aula venit, intellecturus sis.</s>
					<s n="3" xml:lang="la">Proxime per <placeName ref="l176">Gla<lb xml:id="p1z4"/>ronensem</placeName> nuncium brevius ad tuas scripsi et praesertim <lb xml:id="p1z5"/>de responso <placeName ref="l832">Gallicis</placeName> legatis dato; nondum enim, quale <lb xml:id="p1z6"/>illud esset, scire poteram.</s>
					<s n="4" xml:lang="la">Interea audio responsum <lb xml:id="p1z7"/>dilatum fuisse in ipsorum reditum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Varia sunt <lb xml:id="p1z8"/>interim iudicia et populi murmura.</s>
					<s n="6" xml:lang="la">Spero do<lb xml:id="p1z9"/>minum daturum gratiam, ut veterum periculorum memore<lb xml:id="p1z10"/>s ab eiusmodi foederibus abstineant.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Audies ex <lb xml:id="p1z11"/><persName ref="p1918">Linero</persName>, quomodo pacis edictum servetur in <placeName ref="l832">Gallia</placeName>, et nos <lb xml:id="p1z12"/>putamus nos nostra authoritate illud stabilire posse.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Mutavit et <persName ref="p8033">Beza</persName>, ut ex illo audio, sententiam.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Velim <lb xml:id="p1z14"/>autem eum minus hac de re ad nostros scripsisse, ne ipsius <lb xml:id="p1z15"/>authoritate contra nos abuterentur.</s>
					<s n="10" xml:lang="la">Expectamus nunc, <lb xml:id="p1z16"/>quid comitia illa <placeName ref="l21">Badenę</placeName> latura sint.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Habes illic <lb xml:id="p1z17"/>ex nostris <persName ref="p3659">Mülinensem</persName> ac <persName>Manuelem</persName>, cum quibus <lb xml:id="p1z18"/>per literas agere poteris.</s>
					<s n="12" xml:lang="la">Puto autem negotium nostrum <persName>Sabau<lb xml:id="p1z19"/>dicum</persName> illic <placeName ref="l862">Helvetiis</placeName> proponendum fore; princeps enim nihil <lb xml:id="p1z20"/>magis urget, quam ut tandem transigat et restitutio <lb xml:id="p1z21"/>fiat.</s>
					<s n="13" xml:lang="la">Restituendi nos tantum non Diris devovent <lb xml:id="p1z22"/>et dolorem suum propter metum novi principis non satis dete<lb xml:id="p1z23"/>gere audent; dominus ipsis adsit et nos a malo custodiat.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z24"/>Post legatorum discessum consules quoque et senatores <lb xml:id="p1z25"/>ita gregatim ex urbe discesserunt ad sua quisque praedia, <lb xml:id="p1z26"/>ut tota hac septimana non <lb xml:id="p1z27"/>ultra 6 in senatu <lb xml:id="p1z28"/>fuerint et viceconsulatus adusque pandaretam <persName ref="p5361">imm <lb xml:id="p1z29"/>Hof</persName> descenderit.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Salutant t<lb xml:id="p1z30"/>e amici et fratres omnes, <lb xml:id="p1z31"/>praesertim <persName ref="p8012">Hallerus</persName>, socer et <persName ref="p4060">Zehenderi</persName>.</s>
					<s n="16" xml:lang="la">Salvi sin<lb xml:id="p1z32"/>t tui omnes.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Dominus te nobis servet incolumem; <lb xml:id="p1z34"/>in illo tu bene vale.</s>
					<s n="18" xml:lang="la"><placeName ref="l41">Bernę</placeName> 25. augusti 1564.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z35"/><persName ref="p8018">Ioannes Hallerus</persName> tuus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino meo et compatri <lb xml:id="p2z5"/>perpetuo et summo amore <lb xml:id="p2z6"/>complectendo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>