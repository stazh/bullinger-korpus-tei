	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
					<s n="2" xml:lang="la">Multum diuque, domine et pater colende, laboravi in n<lb xml:id="p1z2"/>egotio ludi nostri;<note xml:id="fn1" type="footnote" n="1">Vgl. <bibl source="b18">HBBW XV</bibl>, <ref target="file12323">Nr. 2276</ref>. 2292.</note> sed ita evenit, ut nosti.</s>
					<s n="3" xml:lang="la">Receptus est, quem<note xml:id="fn2" type="footnote" n="2"><persName ref="p18370">Ulrich Trog</persName>; s. <bibl source="b18">HBBW XV</bibl> 612f,23-40; 653f,6-16.</note> alii<note xml:id="fn3" type="footnote" n="3">Die <placeName ref="l41">Berner</placeName>.</note> voluere.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z3"/>Mearum non erat partium ipsum reiicere.</s>
					<s n="5" xml:lang="la">Qualis futurus sit, haud dum exploratum <lb xml:id="p1z4"/>habeo; tacet.</s>
					<s n="6" xml:lang="la">Interim id, quod monuisti,<note xml:id="fn4" type="footnote" n="4">Vermutlich in <persName ref="p495">Bullingers</persName> nicht erhaltener Antwort auf <persName ref="p1553">Hochholzers</persName> Brief vom 21. November 1545 <hi>(HBBW</hi> XV, <ref target="file12339">Nr. 2292</ref>).</note> faciam sedulo; curabo omnibus modis me <lb xml:id="p1z5"/>ipsius animo insinuare.</s>
					<s n="7" xml:lang="la">Puerilis adhuc est plane; conabor ipsum domino lucrifacere.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z6"/>Maxime vitat frequentiam hominum, simplex videtur et bonus, nisi promissis <lb xml:id="p1z7"/>maximis seduceretur.</s>
					<s n="9" xml:lang="la">Id enim omnino fit apud episcopos<note xml:id="fn5" type="footnote" n="5">Damit sind Pfarrer wie <persName ref="p3099">Simon Sulzer</persName> und <persName ref="p8364">Beat Gering</persName> gemeint.</note> nostros: quod veritate <lb xml:id="p1z8"/>obtinere minus datur, id artibus hominibus obtrudere conantur.</s>
					<s n="10" xml:lang="la">Lutheranus aliquis <lb xml:id="p1z9"/>indoctus, omnium rerum expers, parum etiam (fere dicerem) spectatę probitatis <lb xml:id="p1z10"/>promovetur, ut optime habeat; veritatis studiosus, Luthero et huic similibus <lb xml:id="p1z11"/>contrarius, doctus, probitatis spectatę, omnium rerum peritus, ab ipsis impeditur, <lb xml:id="p1z12"/>male audit.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="11" xml:lang="la">Quod, si novum esset, maxime mirarer; sed veritas inde usque ab <lb xml:id="p1z13"/>initio<pb type="edition" next="142"/> mundi exosa fuit mundo<note xml:id="fn6" type="footnote" n="6">Vgl. <cit type="bible"><ref>Joh 3, 19f</ref></cit>. 14, 17. 15, 18f. 17, 14.</note>.</s>
					<s n="12" xml:lang="la">Tanta est etiam et tam crassa senatus <lb xml:id="p1z14"/>nostri <placeName ref="l41">Bernensis</placeName> (alioqui prudentissimi) caecitas et ignorantia, ut interim, dum <lb xml:id="p1z15"/>sua doceant illi, non animadvertant.</s>
					<s n="13" xml:lang="la">Expectamus synodum appetente vere, verum, <lb xml:id="p1z16"/>num futura sit, ignoramus.</s>
					<s n="14" xml:lang="la">Parum etiam profuturam iudicamus.</s>
					<s n="15" xml:lang="la">Non enim <lb xml:id="p1z17"/>convocabimur, donec illi multitudine nos superandos fore iudicent; quod nequaquam <lb xml:id="p1z18"/>fiet.</s>
					<s n="16" xml:lang="la">Nam licet maior sit illorum pars, tamen veritas non multitudine <lb xml:id="p1z19"/>vel paucitate aestimatur.</s>
					<s n="17" xml:lang="la">Maior pars mundi errores amat<note xml:id="fn7" type="footnote" n="7"><cit type="bible"><ref>Joh 3, 19</ref></cit>.</note>.</s>
				</p>
			</div>
			<div xml:id="div3">
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z20"/>Nos satis recte habemus.</s>
					<s n="19" xml:lang="la">Laus deo optime maximo!</s>
					<s n="20" xml:lang="la">Metuimus tamen plurimos sequutur<lb xml:id="p1z21"/>os maiorem partem, ut fieri solet; qualis princeps, talis populus<note xml:id="fn8" type="footnote" n="8">Vgl. <bibl source="b639">TPMA</bibl> VI 54-56, Nr. 478-526.</note>.</s>
					<s n="21" xml:lang="la">Adhaec insignis <lb xml:id="p1z22"/>nostra ingratitudo meretur, ut iuxta apostoli<note xml:id="fn9" type="footnote" n="9">Paulus.</note> verba mendaciis credamus, eo quod <lb xml:id="p1z23"/>veritati credere nolumus<note xml:id="fn10" type="footnote" n="10">Vgl. <cit type="bible"><ref>2Thess 2, 11f</ref></cit>.</note>.</s>
					<s n="22" xml:lang="la">Dominus sit nobis propitius.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest3">
				<p>
					<s n="23" xml:lang="la"><placeName ref="l2">Aarovię</placeName>, quod ad <lb xml:id="p1z24"/>res meas attinet, optime pro tenuitate stipendii habeo, sed nescio, qui fiat, <lb xml:id="p1z25"/>ut uxor<note xml:id="fn11" type="footnote" ana="bio" n="11"><persName ref="p5976">Agathe, geb. Näf</persName>.</note>, quo diutius hic est, eo magis <placeName ref="l587">Tigurum</placeName> redire cupiat; indies maiori <lb xml:id="p1z26"/>desiderio patriae tenetur.</s>
					<s n="24" xml:lang="la">Quod, etsi non valde expetam nunc, tamen suo <lb xml:id="p1z27"/>tempore, si daretur, non omnino ingratum foret.</s>
					<s n="25" xml:lang="la">Domini est terra<note xml:id="fn12" type="footnote" n="12"><cit type="bible"><ref>Ps 24 (Vulg. 23), 1.</ref></cit></note>.</s>
					<s n="26" xml:lang="la">In <lb xml:id="p1z28"/>vineam eius me misit,<note xml:id="fn13" type="footnote" n="13">Vgl. <cit type="bible"><ref>Mt 20, 2</ref></cit>.</note> in ea, quantum mihi concesserit virium et donorum <lb xml:id="p1z29"/>ex larga sua benignitate, ubicunque sim locorum, fideliter laborabo tam eruendo <lb xml:id="p1z30"/>quam plantando<note xml:id="fn14" type="footnote" n="14">Vgl. <cit type="bible"><ref>Jer 1, 10</ref></cit>.</note>.</s>
					<s n="27" xml:lang="la">Me omniaque mea ut hactenus semper tibi commendo.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest4">
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p1z31"/>Inter nova alia, quae certius tu cognovisti, per fratris cuiusdam<note xml:id="fn15" type="footnote" n="15">Nicht ermittelt.</note> literas<note xml:id="fn16" type="footnote" n="16">Nicht ermittelt.</note> allatum est ad nos <lb xml:id="p1z32"/><persName ref="p20318">Brunsvicensem</persName><note xml:id="fn17" type="footnote" n="17">Herzog <persName ref="p20318">Heinrich d.J. von Braunschweig-Wolfenbüttel</persName>.</note> efflagitare recipi in foedus <placeName ref="l1202">Schmalkaldense</placeName>.</s>
					<s n="29" xml:lang="la">Quodsi ita res <lb xml:id="p1z33"/>se habet, dimissus plurimum dabit turbarum nequam insignis, et landtgravio<note xml:id="fn18" type="footnote" n="18"><persName ref="p3590">Philipp von Hessen</persName>.</note> <foreign xml:lang="el">ἀ<lb xml:id="p1z34"/>ντίλυτρον</foreign><note xml:id="fn19" type="footnote" ana="lex" n="19">Lösegeld.</note> non gratum appendet.</s>
					<s n="30" xml:lang="la" ana="salute">Salutem dicas, rogo, meo uxorisque meę <lb xml:id="p1z35"/>nomine toti familię tuę.</s>
					<s n="31" xml:lang="la" ana="salute">Salutabis et d. <persName ref="p8011">Gvaltherum</persName> simul et alios dominos et <lb xml:id="p1z36"/>praeceptores meos venerandos.</s>
				</p>
				<p>
					<s n="32" xml:lang="la" ana="farewell">Vale cum omnibus tuis in domino.</s>
					<s n="33" xml:lang="la"><placeName ref="l2">Aarovię</placeName>, 9. <lb xml:id="p1z37"/>februarii 1546.</s>
					<s n="34" xml:lang="la">T<lb xml:id="p1z38"/>uae humanitati deditissimus, <lb xml:id="p1z39"/><persName ref="p1553">Christianus Hochholzer</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="35" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> antistiti fidelissimo, <lb xml:id="p2z4"/>domino ac patri suo colendissim<lb xml:id="p2z5"/>o.</s>
				</p>
			</div>
		</body>
