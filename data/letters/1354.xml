	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Vir clarissime, mitto duos libellos, quos hic curavi <lb xml:id="p1z2"/>imprimendos; tu fratribus eos communicato.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Vos, qui magna estis doctrina et prudentia, <lb xml:id="p1z4"/>magnos libros saepe editis; ego, vir <lb xml:id="p1z5"/>pusillus, his scilicet libellis ludo et meum <lb xml:id="p1z6"/>papam celebro.</s>
					<s n="3" xml:lang="la">Cras iturus sum <placeName ref="l41">Bernam</placeName>; <lb xml:id="p1z7"/>nam satis diu d[ominum] doc[torem] <persName ref="p20206">Gribaldum</persName> expectavi <lb xml:id="p1z8"/>nec possum amplius expectare, et sumptus <lb xml:id="p1z9"/>et ratio negotiorum vetat.</s>
					<s n="4" xml:lang="la">Itaque si advenerit, <lb xml:id="p1z10"/>dicito illi me <placeName ref="l41">Bernae</placeName> futurum <lb xml:id="p1z11"/>et illic aliquandiu expectaturum, et ut secum <lb xml:id="p1z12"/>advehat nepotem meum.</s>
					<s n="5" xml:lang="la">Utinam <placeName ref="l41">Bernam</placeName> <lb xml:id="p1z13"/>mitteretis eas literas commendaticias,<note type="margin">a.R.: ...</note> quas <lb xml:id="p1z14"/>coram dixi me desiderare, nempe ad dominos <lb xml:id="p1z15"/><placeName ref="l41">Bernates</placeName>.</s>
					<s n="6" xml:lang="la">Inde profecturus sum ad videndos <lb xml:id="p1z16"/>fratres <placeName ref="l167">Genevenses</placeName> et mox redibo ad vos, ut <lb xml:id="p1z17"/>spero.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale et salve cum tota ecclesia <lb xml:id="p1z18"/>et schola.</s>
					<s n="8" xml:lang="la">Rogate pro me.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/><placeName ref="l28">Basileae</placeName>, 25. iulii 1551.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><persName ref="p3375">Vergeriu<lb xml:id="p1z20"/>s</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Clarissimo d. <pb/><lb xml:id="p2z1"/><persName ref="p495">H[enrico] <lb xml:id="p2z2"/>Bullingero</persName>.</s>
				</p>
			</div>
		</body>
