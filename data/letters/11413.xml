	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Salus et pax Christi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Pro libello<note xml:id="fn1" type="footnote" n="1">Gemeint ist <persName ref="p495">Bullingers</persName> neuerschienenes Werk "Der christliche Ehestand"; vgl. oben <ref target="file11409">Nr. 1366</ref>, 2-6 mit Anm. 1.</note> tuo gratias ago quam possum plurimas; <lb xml:id="p1z4"/>gratissima enim michi sunt talia talium <lb xml:id="p1z5"/>amicorum dona.</s>
					<s n="3" xml:lang="la">Utinam rependere possem tua <lb xml:id="p1z6"/>tot erga me offitia.</s>
					<s n="4" xml:lang="la">Expecto occasionem, <lb xml:id="p1z7"/>qua oblata non ero ingratus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quid scribam, <lb xml:id="p1z8"/>aliud non habeo.</s>
					<s n="6" xml:lang="la">Omnia nunc silent, <lb xml:id="p1z9"/>quod ad evangelii negotium adtinet.</s>
					<s n="7" xml:lang="la">Utinam <lb xml:id="p1z10"/>ex comitiis nostrorum audiamus felicia<note xml:id="fn2" type="footnote" n="2">Zu den Ergebnissen des Bundestags zu <placeName ref="l1202">Schmalkalden</placeName> s. unten <ref target="file11424">Nr. 1381</ref>, 1-8; 1398, 2-24.</note>!</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z11"/>Vale, mi frater, et pro nobis semper ora.</s>
					<s n="9" xml:lang="la">10. martii <lb xml:id="p1z12"/>1540.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z13"/>Tuus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p7214">Uxor</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p7214">Anna</persName> Tegerfelderin oder Tegerwilerin; vgl. <bibl source="b11">HBBW IX</bibl> <ref target="file11343">[Nr. 1300]</ref>, S. 203, Anm. 20.</note> mea quoque gratias <lb xml:id="p1z15"/>agit pro munere; legemus <lb xml:id="p1z16"/>mutuo et dabimus operam, <lb xml:id="p1z17"/>ut tuis exhortationibus adiuti <lb xml:id="p1z18"/>reddamur meliores.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute"><lb xml:id="p1z19"/>Tuam totam familiam saluta studiosissime.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p1753">Leonem</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p1753">Leo Jud</persName>.</note>, <persName ref="p8127">Pellicanum</persName> et omnes fratres salvos iubeo.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Hainricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiastae <lb xml:id="p2z3"/><placeName ref="l587">Tigurino</placeName>, suo fratri <lb xml:id="p2z4"/>charissimo.</s>
					<s n="15" xml:lang="de"><placeName ref="l587">Zurch</placeName>.</s>
				</p>
			</div>
		</body>
