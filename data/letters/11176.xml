	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus et pax Christi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Ergo constituta est pax inter vos et <persName ref="p467">Bucerum</persName> <lb xml:id="p1z3"/>adeoque <persName ref="p1974">Lutherum</persName> ipsum<note xml:id="fn1" type="footnote" n="1"><persName ref="p4079">Zwick</persName> hatte <persName ref="p495">Bullinger</persName> gebeten, ihm die Akten der <placeName ref="l587">Zürcher</placeName> Tagung vom 28. April bis 3. Mai zukommen zu lassen (s. oben <ref target="file11172">Nr. 1129</ref>, 15-20); die Antwort <persName ref="p495">Bullingers</persName>, auf die sich <persName ref="p4079">Zwick</persName> bezieht, ist verloren.</note>.</s>
					<s n="3" xml:lang="la">Quod felix et faustum sit, <lb xml:id="p1z4"/>atque utinam sic contentionis finis sit!</s>
					<s n="4" xml:lang="la">Faxit <lb xml:id="p1z5"/>quoque noster Christus, ut, quae dantur et recipiuntur, <lb xml:id="p1z6"/>solida sint et firma, quo ipsa etiam concordia <lb xml:id="p1z7"/>solida sit et firma.</s>
					<s n="5" xml:lang="la">Ego omnino spero <lb xml:id="p1z8"/><persName ref="p467">Bucerum</persName><note xml:id="fna" type="footnote" n="a"><hi>vor</hi> <persName ref="p467">Bucerum</persName> <hi>gestrichenes</hi> vo.</note> vos posthac non turbaturos.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Quod <persName ref="p7564">Landenbergium</persName><note xml:id="fn2" type="footnote" n="2">Siehe oben <ref target="file11172">Nr. 1129</ref>, 21-32 mit Anm. 5.</note> iuveris, gratissimum mihi est; <lb xml:id="p1z10"/>audio enim omnia illum obtinuisse.</s>
					<s n="7" xml:lang="la">Egit autem <lb xml:id="p1z11"/>multas gratias mihi et tales, ut intelligam illum <lb xml:id="p1z12"/>victoriam hanc meae commendationi et tuae <lb xml:id="p1z13"/>sedulitati tribuere.</s>
					<s n="8" xml:lang="la">Quam ego vicissim <lb xml:id="p1z14"/>diligentiam praestiterim <persName ref="p5515">Cotteri</persName><note xml:id="fn3" type="footnote" n="3">Zur Berufung <persName ref="p5515">Hans Kotters</persName> als Schulmeister nach <placeName ref="l257">Konstanz</placeName> s. Manfred <hi>Schuler,</hi> Ein Beitrag zur Biographie <persName ref="p5515">Hans Kotters</persName>, in: Die Musikforschung 22, 1969, S. 197-200.</note> nomine, ipse referet.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>Successit feliciter; domino sint gratiae multae.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p1753">Leonem</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p1753">Leo Jud</persName>.</note> quoque exhilara hoc nuntio.</s>
					<s n="11" xml:lang="la" ana="farewell">Et vale <lb xml:id="p1z17"/>in Christo; nam plura non possum.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z18"/>Confessionem et reliqua acta<note xml:id="fn5" type="footnote" n="5">Vgl. oben Anm. 1.</note> remitto cum <lb xml:id="p1z19"/>gratiarum actione.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Datum <placeName ref="l257">Constantiae</placeName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z20"/>Consul noster <persName ref="p8178">Thomas</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p8178">Thomas Blarer</persName>.</note> iubet te salutare millies.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z21"/>Occupatissimus est, alioqui et<note xml:id="fnb" type="footnote" n="b">et <hi>über der Zeile nachgetragen.</hi></note> ipse aliquid respondisset.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z22"/><persName ref="p8127">Pellicanum</persName> meo nomine saluta.</s>
					<s n="17" xml:lang="de">27. maii <lb xml:id="p1z23"/>1538.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z24"/>Tuus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z2"/>Domino <persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>antistiti, suo in domino <lb xml:id="p2z5"/>charissimo fratri<lb xml:id="p2z8"/>.</s>
				</p>
			</div>
		</body>
