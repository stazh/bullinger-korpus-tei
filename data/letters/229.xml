	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Ante dies aliquot, <persName ref="p495">Bullingere</persName> charissime, <lb xml:id="p1z2"/>scripsi ad te per ministros <placeName ref="l409">Ravenspurgensis</placeName> ecclesię <lb xml:id="p1z3"/>ad vos proficiscentes significavique, quo iam <lb xml:id="p1z4"/>loco degam et per quam occasionem huc venerim, <lb xml:id="p1z5"/>cum ad vos constituissem et ea de re literas <lb xml:id="p1z6"/>tuas senatus vestri voluntatem significantes <lb xml:id="p1z7"/>expectarem.</s>
					<s n="3" xml:lang="la">Interea nactus sum reculas meas <lb xml:id="p1z8"/>una cum libris, ut iam universum <lb xml:id="p1z9"/>liberatus sim ab <placeName ref="l18">Augustana</placeName> <placeName ref="l2131">Babylone</placeName>, quae <lb xml:id="p1z10"/>in ecclesiam illam multis nominibus insignem <lb xml:id="p1z11"/>per antichristi est intrusa satellites, possimque <lb xml:id="p1z12"/>pro voluntate domini alicui deinceps ecclesię in <lb xml:id="p1z13"/>Christo servatore nostro secundum evangelium illius <lb xml:id="p1z14"/>servire.</s>
					<s n="4" xml:lang="la">nolim enim cum servo illo nequam <lb xml:id="p1z15"/>ociosae vitę merito reprehensibilis subire <lb xml:id="p1z16"/>notam; itaque expectans vocationem domini hęreo <lb xml:id="p1z17"/>hic apud <placeName ref="l473">Sangallenses</placeName>, nisi tibi visum <lb xml:id="p1z18"/>fuerit, ut ad vos concedam, qua de re, oro, <lb xml:id="p1z19"/>consilium tuum significes.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z20"/>De <placeName ref="l257">Constantiensibus</placeName> audio pleraque, quę faciunt, <lb xml:id="p1z21"/>ut ei ecclesię sicut et <placeName ref="l291">Lindaviensium</placeName> vehem<lb xml:id="p1z22"/>enter timeam.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Poterant vicinorum solatio et auxilio <lb xml:id="p1z23"/>confirmatiores reddi, quę res adversariorum <lb xml:id="p1z24"/>conatus mirum in modum fregisset; illorum ruina <lb xml:id="p1z25"/>magnorum malorum occasionem minatur.</s>
					<s n="7" xml:lang="la">De <lb xml:id="p1z26"/>discessu <persName ref="p18538">Caesaris</persName> forsan audisti; fertur <placeName ref="l513">Ulmam</placeName> <lb xml:id="p1z27"/>profectus, dubio procul mediatatur <placeName ref="l491">Argent(inę)</placeName> <lb xml:id="p1z28"/>occupationem.</s>
					<s n="8" xml:lang="la">Nihil agitur ab illo obiter ac <lb xml:id="p1z29"/>temere; omnia illius vigilanter sunt ob<lb xml:id="p1z30"/>servanda.</s>
					<s n="9" xml:lang="la">Verum est deus in coelo, qui pro<lb xml:id="p1z31"/>vidus omnia curat, et sicuti cum integris integer <lb xml:id="p1z32"/>est, ita cum perversis pervertitur et <lb xml:id="p1z33"/>virum sanguinum et dolosum abominatur.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Optime <lb xml:id="p1z34"/>vale; salutem domui tuę toti, fratribus omnibus <lb xml:id="p1z35"/>et <persName ref="p8018">Hallero</persName> meo <placeName ref="l41">Bernę</placeName> agenti.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l473">Sangalli</placeName> 1548 <lb xml:id="p1z36"/>16. Augusti.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><persName ref="p8417">W[olfga<lb xml:id="p1z37"/>ngus] Musculus</persName>, tuus in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro <lb xml:id="p2z2"/>D. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae <lb xml:id="p2z5"/>pastori fidelissimo, <lb xml:id="p2z6"/>domino ac <lb xml:id="p2z7"/>fratri charissimo.</s>
				</p>
