	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Fuit apud nos vetus amicus <persName>Daniel Osiander</persName> <lb xml:id="p1z2"/><placeName ref="l28">Basiliensis</placeName> hisce diebus.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Eius adventus miram mihi <lb xml:id="p1z3"/>attulit voluptatem atque lętitiam, ut solet fieri, cum <lb xml:id="p1z4"/>amicus amicum invisit.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Verum cum audivissem de <lb xml:id="p1z5"/>illo te iterum decumbere febrique iactari, lętitiam <lb xml:id="p1z6"/>extinxit dolor.</s>
					<s n="4" xml:lang="la" ana="salute">Quid tamen hic agerem, non habui, <lb xml:id="p1z7"/>nisi ut deum pro te precarer, id quod ita factum <lb xml:id="p1z8"/>est et quotidie fiet idque propter non tuam, sed aliorum <lb xml:id="p1z9"/>salutem.</s>
					<s n="5" xml:lang="la">Cura etiam tu, ut valeas, neque cogites <lb xml:id="p1z10"/>te amplius eum esse, hoc est fortem et valentem <lb xml:id="p1z11"/>iuvenem atque virum, qui fueris, sed senem, sed <lb xml:id="p1z12"/>imbecillum et emeritum, militem veteranum, cuius <lb xml:id="p1z13"/>consiliis nunc magis opus sit ecclesię quam laboribus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Cura, obsecro te, valetudinem tuam et istac ętate <lb xml:id="p1z15"/>tibi tempera in magnis solitisque laboribus, ut <lb xml:id="p1z16"/>ęquum est et salus multorum postulat.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/>Die dominica, hoc est 12. augusti, excommunicavimus <lb xml:id="p1z18"/><persName>Patavinum</persName> quendam nomine <persName>Antonium Sutorem</persName>, quod <lb xml:id="p1z19"/>convictus pertinaciter tamen contendebat Christum <lb xml:id="p1z20"/>non esse verum deum seque pro hac (ut ipse <lb xml:id="p1z21"/>aiebat) veritate velle mori.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Idem dicebat <lb xml:id="p1z22"/>de spiritu sancto; solum enim patrem esse de<lb xml:id="p1z23"/>um.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z24"/>Infecta est (ut audio) <placeName ref="l834">Italia</placeName> hac hęresi; accedit <lb xml:id="p1z25"/>etiam apud multos <persName>Pelagianismus</persName>.</s>
					<s n="10" xml:lang="la">Vides, in quę <lb xml:id="p1z26"/>incidimus tempora.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Dei benefitio ecclesia nostra <lb xml:id="p1z27"/>satis puram retinet doctrinam, neque diu hic hęrere <lb xml:id="p1z28"/>possunt huiuscemodi fanatici homines.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Opus tamen <lb xml:id="p1z29"/>fuerit toti huic regioni, ne latius serpat <lb xml:id="p1z30"/>venenum, aliqua bona theriaca.</s>
					<s n="13" xml:lang="la">Scribo ad <lb xml:id="p1z31"/>nostrum <persName>Fabritium</persName>, aliquid excogitet remedii, quod <lb xml:id="p1z32"/>in proxima synhodo dominis proponatur.</s>
					<s n="14" xml:lang="la">Non <lb xml:id="p1z33"/>inutile fuerit, si tu aliquid des consilii re cum fratr<lb xml:id="p1z34"/>ibus deliberata.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Dominus nobis adsit.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z35"/>Facile est divinari, <pb/><lb xml:id="p2z1"/>und<lb xml:id="p2z2"/>e hoc malum et per quos <lb xml:id="p2z3"/>fotum: <placeName ref="l875">Hispanica</placeName> gallina peperit, <placeName ref="l834">Italica</placeName> <lb xml:id="p2z4"/>fovit ova, nos pipientes iam pullos audimus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z5"/>Melitam ferunt fortiter sese tueri, multum enim <lb xml:id="p2z6"/>opis atque auxilii accepisse.</s>
					<s n="18" xml:lang="la">In dies etiam <lb xml:id="p2z7"/>novus cogitur miles <placeName ref="l306">Mediolani</placeName>, qui eo <lb xml:id="p2z8"/>mittatur.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Cętera quiescunt omnia.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="salute">Vale <lb xml:id="p2z9"/>et fratres salvere iube meo nomine.</s>
					<s n="21" xml:lang="la" ana="salute"><persName>Ulysses</persName> saluta<lb xml:id="p2z10"/>t.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p2z11"/><placeName ref="l93">Clavenna</placeName> 19. augusti 1565.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p2z12"/>Tui obse<lb xml:id="p2z13"/>rvantissimus <persName ref="p4037">H[ieronymus] Zan<lb xml:id="p2z14"/>chus</persName>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Cave des testimonium sanę doctrinę Italis nostris, nisi bene perspectam <lb xml:id="p2z16"/>habeas illorum fidem de d<lb xml:id="p2z17"/>eo <lb xml:id="p2z18"/>et peccato orig<lb xml:id="p2z19"/>inali, de ba<lb xml:id="p2z20"/>ptismo <lb xml:id="p2z21"/>parvu<pb/><lb xml:id="p3z1"/>lorum etc.</s>
					<s n="25" xml:lang="la"><lb xml:id="p3z2"/>Claris<pb/><lb xml:id="p4z1"/>simo <lb xml:id="p4z2"/>viro <lb xml:id="p4z4"/>d. <persName ref="p495">H. Bullingero</persName>, <lb xml:id="p4z5"/>ecclesię <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p4z6"/>patri d<lb xml:id="p4z7"/>ig<lb xml:id="p4z8"/>nissimo et colen<lb xml:id="p4z9"/>dissimo.</s>
					<s n="26" xml:lang="la"><lb xml:id="p4z10"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>