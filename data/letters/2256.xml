	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Reddita est mihi, doctissime <persName ref="p714">Coeli</persName>, epistola <lb xml:id="p1z2"/>illa tua per d. <persName ref="p8222">Hieronymum Massarium</persName>, qua <lb xml:id="p1z3"/>tantopere contendis ut te expurgem apud <lb xml:id="p1z4"/>d. <persName ref="p8011">Gvaltherum</persName>, et fratrem et affinem meum longe <lb xml:id="p1z5"/>carissimum.</s>
					<s n="3" xml:lang="la">Et quidem quum huius nihil unquam audivissem <lb xml:id="p1z6"/>ab ipso, mirabar primum quum tuas legissem, <lb xml:id="p1z7"/>nec potui interquiescere donec ipsi tuas <lb xml:id="p1z8"/>communicassem fideliter literas.</s>
					<s n="4" xml:lang="la">Mirabatur et <lb xml:id="p1z9"/>ille nec aliud respondebat quam se nunquam illa <lb xml:id="p1z10"/>vidisse carmina, neque novisse qua de re <lb xml:id="p1z11"/>sint scripta: tantum abesse ut in te reiecerit <lb xml:id="p1z12"/>autorem.</s>
					<s n="5" xml:lang="la">Haec nolui ignorares tranquilliorique <lb xml:id="p1z13"/>esses animo.</s>
					<s n="6" xml:lang="la" ana="farewell">Vive et vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Festinant<lb xml:id="p1z14"/>er <lb xml:id="p1z15"/>9. aprilis anno 1554.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p714">Coelio <lb xml:id="p2z2"/>Secundo Curioni</persName> <lb xml:id="p2z3"/>doctissimo professor<lb xml:id="p2z4"/>i <lb xml:id="p2z5"/>scholae <placeName ref="l28">Basiliensis</placeName> <lb xml:id="p2z6"/>domino colendo et fratri <lb xml:id="p2z7"/>meo carissimo.</s>
					<s n="9" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
