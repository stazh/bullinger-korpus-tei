	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quae ex <placeName ref="l167">Geneva</placeName> habui, nuper misi.</s>
					<s n="3" xml:lang="la">Scribunt illi in<lb xml:id="p1z2"/>terea amplius, quod <persName ref="p8315">Condaeus</persName> munitum quendam locum <lb xml:id="p1z3"/>non procul a <placeName ref="l1765">Burdegala</placeName> situm coeperit et <persName>Lemovices</persName> etiam <lb xml:id="p1z4"/>teneat.</s>
					<s n="4" xml:lang="la">Faciunt etiam mentionem <placeName ref="l1284">Bruxellarum</placeName> ab <persName>Au<lb xml:id="p1z5"/>rangio</persName> captarum, sed non pro certo affirmant.</s>
					<s n="5" xml:lang="la"><placeName ref="l28">Basilienses</placeName> <lb xml:id="p1z6"/>et <placeName ref="l491">Argentinenses</placeName> multas et varias chartas nostris mis<lb xml:id="p1z7"/>erunt, quas hincinde acceperunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Harum cum mihi <lb xml:id="p1z8"/>copia facta esset, paucis in hanc schedulam, quę praecipua <lb xml:id="p1z9"/>erant, consignavi.</s>
					<s n="7" xml:lang="la">Ostendes eam etiam fratri meo, si placet.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Alias nunc nihil habeo, nisi quod deum oro, ut te servet <lb xml:id="p1z11"/>incolumem.</s>
					<s n="9" xml:lang="la" ana="salute">Salutant te consules nostri et quęstores, <persName ref="p4060">Zehenderi</persName>, <lb xml:id="p1z12"/>socer, mater et uxor.</s>
					<s n="10" xml:lang="la" ana="salute">Saluta tuos omnes quoque meo nomine.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z13"/><placeName ref="l41">Bernae</placeName> 17. novembris 1568.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z14"/>Exciderat hoc, quod de <persName>Anguisola</persName> scripsi in literis fratris; <lb xml:id="p1z15"/>ibi reperies, quid hic quoque egerit et qua fraude (non enim aliter nostri interpretantur) sit usus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p8018">I[ohannes] Hallerus</persName> tuus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">[Clarissimo viro d. <persName ref="p495">He]inrycho [Bullingero</persName>, <placeName ref="l587">Tigu<lb xml:id="p1z17"/>rinae</placeName>] ecclesię [pastori fid<pb/><lb xml:id="p2z1"/>elissimo], domino m<lb xml:id="p2z2"/>eo [honorando et compat]ri <lb xml:id="p2z3"/>cha[rissimo].</s>
				</p>
			</div>
		</body>
	</text>
