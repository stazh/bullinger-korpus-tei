	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">Certiorem te feci de regis <persName>Francisci</persName> morte, de qua amplissimo senatui <lb xml:id="p1z3"/>scribo.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Accepi controversiam, quę erat inter <placeName ref="l572">Wirtembergensem</placeName> et marchionem <lb xml:id="p1z4"/><placeName>Badensem</placeName>, qua de scripseram ad te, sedatam esse et <placeName ref="l572">Wirtembergensem</placeName> <lb xml:id="p1z5"/>recuperasse monasterium <placeName>Herrenalba</placeName>.</s>
					<s n="4" xml:lang="la">Si quid dignum scitu <lb xml:id="p1z6"/>habeas, gratissimum erit, si certiores nos reddideris.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="salute">Salutabis <lb xml:id="p1z7"/>amicos omnes et nos amabis.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l760">Sol[uturi]</placeName> 17. decembris.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z8"/><persName>Valentinus</persName> communicabit literas scriptas <placeName ref="l834">Italice</placeName> <lb xml:id="p1z9"/>ex <placeName ref="l522">Venetia</placeName>, antequam <lb xml:id="p1z10"/>remittat.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Tuus ex animo <persName ref="p629">Coignet</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henricho Bullingero</persName>, <placeName ref="l587">Tigurine</placeName> <lb xml:id="p2z2"/>ecclesie pastori vigilantissimo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
