	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi tuas, chare frater, una cum illis, <lb xml:id="p1z2"/>quas scripsisti ad d. comitem <persName ref="p2054">Martinengum</persName>; eas per <lb xml:id="p1z3"/>primum certum quemque tabellionem mittam <placeName ref="l167">Gen<lb xml:id="p1z4"/>evam</placeName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Valde doleo mihi per negotia non licuis<lb xml:id="p1z5"/>se d. <persName ref="p1770">Gregorium Carlinum</persName> mea praesentia in con<lb xml:id="p1z6"/>vivio aliquo honorare.</s>
					<s n="4" xml:lang="la">Placuit mihi vir <lb xml:id="p1z7"/>ille; nunquam antea videram.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Hortatus sum illum, <lb xml:id="p1z8"/>licet brevibus, ad constantiam in bono etc.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute">Salu<lb xml:id="p1z9"/>tabis ipsum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Quae <placeName ref="l210">Heydelberga</placeName> accepi et ali<lb xml:id="p1z10"/>unde, hic communico; remitte.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">D. <persName ref="p8160">Bellieure</persName> <lb xml:id="p1z11"/>officiosissime salutato; retuli ei, quae habes <lb xml:id="p1z12"/>de legione <placeName>Empserana</placeName><note type="misc">Bupse?</note>.</s>
					<s n="9" xml:lang="la">Optimus noster <persName ref="p2447">Sam<lb xml:id="p1z13"/>uel Pellicanus</persName> decumbit; decumbit et ux<lb xml:id="p1z14"/>or eius, matrona honestissima; dominus erigat <lb xml:id="p1z15"/>illos et servet.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">D. <persName>Iodoci Brenvaldi</persName> uxor <lb xml:id="p1z16"/>decumbit absque spe vitae, filia quoque eius natu <lb xml:id="p1z17"/>maxima.</s>
					<s n="11" xml:lang="la">Passim per urbem corripiuntu<lb xml:id="p1z18"/>r e<lb xml:id="p1z19"/>t involvuntur ea lue homines; dominus concedat animi robur <lb xml:id="p1z20"/>et veram fidem.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale et ora pro nobis do<lb xml:id="p1z21"/>minum.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 15. septembris 1564.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z22"/>Saluta dominos consules et symmystas.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z23"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">S<lb xml:id="p1z24"/>cholares et studiosi peregrin<lb xml:id="p1z25"/>i <lb xml:id="p1z26"/>omnes iam diffugiere; va<lb xml:id="p1z27"/>cuantur cum auditoriis scholae.</s>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>ministro fideli, domino et fratri <lb xml:id="p2z4"/>meo colendo et dilecto.</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
