	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salutem scripsi tibi hisce diebus ex <placeName ref="l28">Basilea</placeName>; nunc <lb xml:id="p1z2"/>vero <placeName ref="l2">Arovię</placeName> incidens in hunc bonum virum te rogo, ut, <lb xml:id="p1z3"/>quod nuper scripsi de negocio <placeName ref="l491">Argentinensium</placeName>, id apud te <lb xml:id="p1z4"/>reconditum maneat.</s>
					<s n="2" xml:lang="la">Nam postea mihi succurrebat, <lb xml:id="p1z5"/>quod se prodi noluerunt <placeName ref="l491">Argentinenses</placeName>, quod quid sibi velit nescio t<lb xml:id="p1z6"/>amen.</s>
					<s n="3" xml:lang="la">De negocio meo cum <placeName ref="l2">Aroviensibus</placeName> expectabo quid <lb xml:id="p1z7"/>sentias ac consulas.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Accipio nunc ipsos vocasse <persName ref="p8087">Hieronymum <lb xml:id="p1z8"/>Krantz</persName> ex <placeName ref="l113">Diessenhofen</placeName>.</s>
					<s n="5" xml:lang="la">Quod ut foelix sit ac faustum, precor.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Urgent porro adhuc, ut transferar ad se, quod ultro facerem, <lb xml:id="p1z10"/>nisi ecclesia mea tantopere solicita esset, ne locum mutem.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z11"/>Bene vale.</s>
					<s n="8" xml:lang="la">21. ianuarii 1558.</s>
					<s n="9" xml:lang="la"><placeName ref="l2">Arovię</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z12"/>Tuus <persName ref="p1754">Ioannes Iung</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro <lb xml:id="p2z2"/>d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>domino suo colendissimo <lb xml:id="p2z4"/>fratrique charissimo.</s>
				</p>
			</div>
		</body>
	</text>
