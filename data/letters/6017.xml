	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Habes hic <persName>Paulum Knippe</persName>, <placeName ref="l640">Flandrum</placeName>, <placeName ref="l167">Ge<lb xml:id="p1z3"/>neva</placeName> et <placeName ref="l301">Lugduno</placeName> redeuntem.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Is praeterqu<lb xml:id="p1z4"/>am <lb xml:id="p1z5"/>quod a <persName ref="p8033">Beza</persName> et aliis multas tibi literas affert, vivę <lb xml:id="p1z6"/>quoque epistolae loco esse poterit et narrare, quę<lb xml:id="p1z7"/>cunque vel <placeName ref="l167">Genevę</placeName> vel <placeName ref="l301">Lugduni</placeName> vidit et audivit <lb xml:id="p1z8"/>ipse.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Quibus ut ego quicquam addam, operae <lb xml:id="p1z9"/>precium non est.</s>
					<s n="5" xml:lang="la">Scripsit per eundem <persName ref="p8033">Beza</persName> <lb xml:id="p1z10"/>ad me quoque, quas tibi communicarem, nisi scirem <lb xml:id="p1z11"/>eadem ipsum ad te quoque scribere.</s>
					<s n="6" xml:lang="la">Res in <placeName ref="l832">Gallia</placeName> <lb xml:id="p1z12"/>satis sunt exulceratae adhuc; orandus itaque, <lb xml:id="p1z13"/>ut dominus illis et nobis succurrat.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ex <placeName ref="l21">Badena</placeName> <lb xml:id="p1z14"/>nihildum habemus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Speraveram futurum, ut <lb xml:id="p1z15"/><placeName ref="l646">Glaronensium</placeName> res componeretur; sed finito nunc concilio <lb xml:id="p1z16"/>nescio, quid sperare debeam.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Metuo, ne <lb xml:id="p1z17"/>illud magnorum inter nos in <placeName ref="l862">Helvetia</placeName> tumul<lb xml:id="p1z18"/>tuum occasio futurum sit; <foreign xml:lang="de">dann uff das ist es bißhar <lb xml:id="p1z19"/>alles gspillt.</foreign></s>
					<s n="10" xml:lang="de">Sind si aber witzig (die anderen), so <lb xml:id="p1z20"/>lassend si uns zefriden; dann unser undergang <lb xml:id="p1z21"/>kan on iren großen schaden nitt geschehen.</s>
					<s n="11" xml:lang="de"><foreign xml:lang="la">Vicini nos<lb xml:id="p1z22"/>tri <placeName ref="l160">Friburgenses</placeName> et <placeName ref="l760">Solodorenses</placeName></foreign> sind vast kützlig; <lb xml:id="p1z23"/>weiß nitt, was in inen stecket; vilicht bißt si die <lb xml:id="p1z24"/>hut.</s>
				</p>
				<p>
					<s n="12" xml:lang="de">Gott welle uns vor unfal bhuͤten!</s>
					<s n="13" xml:lang="de">Die <lb xml:id="p1z25"/><placeName ref="l167">genffisch</placeName> sach ist dermaß, das schier nitt darvon <lb xml:id="p1z26"/>zschryben noch zreden.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Profugerant exules ex <lb xml:id="p1z27"/>ditione dominorum nostrorum; nunc nescio, quae <lb xml:id="p1z28"/>illis iterum lux illis affulgeat: catervatim, ut audio, <lb xml:id="p1z29"/>redeunt, <placeName ref="l167">Genevensibus</placeName> insultant, se excusant, <lb xml:id="p1z30"/>calumniis et mendaciis omnia complent, cum certo <lb xml:id="p1z31"/>certius constet ipsos perditos esse nebulones.</s>
					<s n="15" xml:lang="la">Sed <lb xml:id="p1z32"/>odia illa inveterata faciunt, ut inveniant <lb xml:id="p1z33"/>aures, apud quos non deberent invenire.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Sa<lb xml:id="p1z34"/>baudus se quoque excusat, ut nesciam, quo adhuc <lb xml:id="p1z35"/>sit res evasura.</s>
					<s n="17" xml:lang="la">Expectamus nunc conventum proxim <lb xml:id="p1z36"/>mense <placeName ref="l1860">Neoduni</placeName> futurum; <foreign xml:lang="de">da wirt man aber <lb xml:id="p1z37"/>tagen, bis es wider nacht wirt.</foreign></s>
				</p>
				<p>
					<s n="18" xml:lang="la">Expecto, ut tu <lb xml:id="p1z38"/>scribas multa.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute">Amici omnes recte valent <lb xml:id="p1z39"/>et te salutant, praesertim <persName ref="p8063">Steigerus</persName>, <persName ref="p2305">Nägelinus</persName>, <lb xml:id="p1z40"/><persName ref="p7511">Grafenriett</persName>, socer, <persName ref="p4060">Zehenderi</persName> et multi alii.</s>
					<s n="20" xml:lang="la" ana="salute"><lb xml:id="p1z41"/>Salutem dic tuis omnibus meo et uxoris <lb xml:id="p1z42"/>nomine.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l41">Bernae</placeName> 16. ianuarii 1563.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z43"/><persName ref="p8018">I<lb xml:id="p1z44"/>[o<pb/><lb xml:id="p2z1"/>hannes] <lb xml:id="p2z2"/>Hall[er<lb xml:id="p2z3"/>us</persName>] <lb xml:id="p2z5"/>tuu<lb xml:id="p2z6"/>s.</s>
				</p>
				<p>
					<note type="address">[Ohne Adresse.]</note>
				</p>
