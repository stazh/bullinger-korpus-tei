	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literę ex <placeName ref="l834">Italia</placeName> ad me allatae sunt, quibus certe <lb xml:id="p1z2"/>mihi significatur a nostris magnam cladem <placeName ref="l875">Hispanensi</placeName> <lb xml:id="p1z3"/>exercitui in <placeName ref="l150">Ferrariensi</placeName> ducatu esse illatam, et <lb xml:id="p1z4"/>quanquam, quomodo res gesta sit, nondum <lb xml:id="p1z5"/>per particulas intellexerim, tamen, quia hoc constat <lb xml:id="p1z6"/>paulo minus duobus millis <placeName ref="l875">Hispanorum</placeName> nullis <lb xml:id="p1z7"/>nostris amissis cecidisse, id significare tibi volui.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z8"/>Tu, si quid aliunde novi habeas, si scripseris, <lb xml:id="p1z9"/>erit mihi gratissimum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Noster exercitus in <lb xml:id="p1z10"/><placeName ref="l832">Gallia</placeName> ad <placeName ref="l2235">Caletes</placeName> oppugnandos profectus <lb xml:id="p1z11"/>est; sed magnitudo frigoris, quae <lb xml:id="p1z12"/>etiam in regione illa vehementior est, <lb xml:id="p1z14"/>me quicquam ex illa expeditione magni sperare vetat.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Quicquid erit, vos brevi intelligetis.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>9a. ianuarii 1557 nostra computatione.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Tuus <persName ref="p8183">Sanlaurent[ian<lb xml:id="p1z18"/>us]</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo theologo d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>.</s>
				</p>
				<p>
					<note type="author">[Darunter von anderer Hand:]</note>
				</p>
				<p>
					<s n="10" xml:lang="de"><lb xml:id="p2z3"/>An herren <persName ref="p495">Heinrich Bullinger</persName>.</s>
					<s n="11" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
