	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ioachimus hic cognomento <persName ref="p4811">Fuerterius</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p4811">Joachim Forrer</persName>. Darüber von anderer Hand: "<persName ref="p4811">Furerus</persName>".</note> <placeName ref="l555">Vitudurensis</placeName> <persName ref="p8083">Fortmüllero</persName> et <lb xml:id="p1z2"/><persName ref="p7188">Antonio Zilio</persName>, ministris nostris, sese peramice insinuavit rogitans, ut, si quod <lb xml:id="p1z3"/>munus ministerii vacaret, in se periculum facerent, num ei praeesse <lb xml:id="p1z4"/>cum fructu et honeste fungi concionandi munere possit necne etc.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Negat autem unquam antea se ulli ecclesiae esse concionatum, sed exercitum <lb xml:id="p1z6"/>tamen studiis honestis et in ludis nonnullis literariis bonam aetatis partem <lb xml:id="p1z7"/>consumpsisse.</s>
					<s n="4" xml:lang="la">Rogarunt ergo me ambo illius nomine, quo scriberem <lb xml:id="p1z8"/>ad te oraremque, ut, quoniam aegre admitti tam nephytus ad ullum <lb xml:id="p1z9"/>munus curae pastoralis in praesentia possit, urbis tuae liberalita<lb xml:id="p1z10"/>te (ex agro enim aut, ut rectius dicam, iurisditione <placeName ref="l587">Tigurinorum</placeName> <lb xml:id="p1z11"/>oriundus est) tantisper foveretur, donec ei in ludo saltem pluscu<lb xml:id="p1z12"/>lum exercito et in te cottidie audiendo eruditiore facto tandem <lb xml:id="p1z13"/>praefici frequenti alicui ecclesiae posset; cogitant autem de Arbore <lb xml:id="p1z14"/>Felici, cuius loci sane frequentissima est ecclesia, cuius beneficentia <lb xml:id="p1z15"/>ei perquam liberaliter provideri posset, ne, quod solent non<lb xml:id="p1z16"/>nulli, ad ullam mendicitatem impelleretur ac velut quaestus caussa <lb xml:id="p1z17"/>Christum praedicare et ceu cauponem agere ullis posset videri.</s>
					<s n="5" xml:lang="la">Quod<lb xml:id="p1z18"/>si vel brevi tempore tu eum idoneum tali munere pronunciaveris <lb xml:id="p1z19"/>et nostros ministros tuis literis spectari tibi ac probari hominem significaris, <lb xml:id="p1z20"/>sine mora aderunt <persName>Ioachimo</persName>, ut et ipse adesse et praeesse fi<lb xml:id="p1z21"/>delibus magno cum fructu possit.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale et rescribe aliquando, quid <lb xml:id="p1z22"/>tu iudices et agendum ducas.</s>
					<s n="7" xml:lang="la">Unum hoc nostri probabunt, quod tibi optimum <lb xml:id="p1z23"/>factu visum fuerit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l473">Sangalli</placeName> XII die Maii, anno MDXLVIII.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p8049">Ioachimus Vadianus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo et pientissimo <lb xml:id="p2z2"/>viro domino <persName ref="p495">Henrycho <lb xml:id="p2z3"/>Bullingero</persName>, clarissimae urbis <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> episcopo, domino suo in<lb xml:id="p2z5"/>primis observando.</s>
				</p>
