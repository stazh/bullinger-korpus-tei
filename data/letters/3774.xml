	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Quod tam raro ad pietatem tuam scribo, in causa est <lb xml:id="p1z2"/>penuria novarum te dignarum, et nugis nolo illi esse <lb xml:id="p1z3"/>molestus.</s>
					<s n="3" xml:lang="la">Quę pauca autem ab <placeName ref="l834">Italia</placeName> habemus, omnia <lb xml:id="p1z4"/>m. d. <persName ref="p8009">Fabritio</persName> exposui, ut eadem pietati tuę comunicet, <lb xml:id="p1z5"/>rogavique, ut salutationes meas addat, quod iddem <lb xml:id="p1z6"/>his addo et obsequiorum meorum perpetuam pietati <lb xml:id="p1z7"/>tuę obtulionem.</s>
					<s n="4" xml:lang="la">Datum <placeName ref="l98">Curię Rhetorum</placeName> 22. novembris <lb xml:id="p1z8"/>1558.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>P[ietatis] t[uae] obsequentissimus amicus <lb xml:id="p1z10"/><persName ref="p8306">J. Ja. Decambray</persName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro pietate et <lb xml:id="p2z2"/>eruditione excellenti domino <lb xml:id="p2z3"/><persName ref="p495">Henrico Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z4"/>ecclesiae ministro, domino et amico <lb xml:id="p2z5"/>suo colendo.</s>
					<s n="7" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note>[Adresse wahrscheinlich von anderer Hand]</note>
				</p>
			</div>
		</body>
	</text>
