			<zone xml:id="p2z5-0" points="968,2868 1272,2833 1447,2874 1571,2814 1687,2866 1766,2860 1769,2772 1634,2742 1292,2795 972,2763">975,2837 1014,2834 1054,2831 1094,2828 1133,2828 1173,2828 1213,2826 1252,2824 1292,2822 1332,2821 1372,2819 1411,2819 1451,2819 1491,2817 1530,2814 1570,2813 1610,2813 1649,2813 1689,2814 1729,2816 1769,2813</zone>
