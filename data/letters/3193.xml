	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">De libellis aliquot a <persName ref="p18291">Petro Mechlin</persName> ad te mittendis <lb xml:id="p1z2"/>eum admonui, qui se iam pridem de iis ad <persName>Michaelem</persName> <lb xml:id="p1z3"/>scripsisse affirmabat, nempe non reperiri illos amplius, sed <lb xml:id="p1z4"/>iam recudi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Idm de defectu, quem petebas, se visurum re<lb xml:id="p1z5"/>spondit, an sarciri is iam possit; puto ipsummet ad te <lb xml:id="p1z6"/>scripturum.</s>
					<s n="4" xml:lang="la">Spiritus antichristi videtur moliri aliquid contra <lb xml:id="p1z7"/>conatus nostros, de quo proxime scribam ad te; iam enim non <lb xml:id="p1z8"/>licet.</s>
					<s n="5" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="6" xml:lang="la">Misi nuper per fusorem <persName>Iacobum Munzingerum</persName> <lb xml:id="p1z9"/><placeName ref="l28">Basiliensem</placeName> folia aliquot usque ad f. Utinima li<lb xml:id="p1z10"/>ceat in reliquis pergere.</s>
					<s n="7" xml:lang="la" ana="farewell">Iterum vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l28">Basileae</placeName> 23. maii 1557.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z11"/><persName ref="p8126">Ioannes Oporinus</persName> tuu<lb xml:id="p1z12"/>s <lb xml:id="p1z13"/>ex animo.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurin<lb xml:id="p2z3"/>ae</placeName> pastori <lb xml:id="p2z4"/>vigilantissimo, domino <lb xml:id="p2z5"/>et amico suo <lb xml:id="p2z6"/>inprimis colend<lb xml:id="p2z7"/>o.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
