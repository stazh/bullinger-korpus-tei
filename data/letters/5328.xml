	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Quanta in sollicitudine, reverendissime pater, hosce <lb xml:id="p1z3"/>dies fuerim, cogitare potes ipse lectis Germanicis <lb xml:id="p1z4"/>literis, quas simul mitto; eas tu quidem <lb xml:id="p1z5"/>difficillime leges (scripsit eas <persName ref="p1770">Georgius Carlin</persName>, <lb xml:id="p1z6"/>qui pessime pingit), eas tamen tibi mittere <lb xml:id="p1z7"/>volui, ut narrationi meae fidem facerem.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z8"/>Summa: principem <placeName>Condensem</placeName> in colloquio <lb xml:id="p1z9"/>circumventum a <persName>Guisiano</persName> pugione percussum, <lb xml:id="p1z10"/>cecidisse simul utrinque 300.</s>
					<s n="4" xml:lang="la">Haec ille, qui <persName ref="p1770">Carlino</persName> <lb xml:id="p1z11"/>dixit (existimamus autem esse <placeName>Dietägium</placeName>) affirmavit <lb xml:id="p1z12"/><placeName ref="l1107">Tridento</placeName> per postam in <placeName ref="l822">Germaniam</placeName> missa.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quaeso <lb xml:id="p1z13"/>te, pater, tu nos hac cura et angore libera.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Verisimile quidem non est citius haec <placeName ref="l1107">Tridenti</placeName> <lb xml:id="p1z15"/>et in <placeName ref="l822">Germania</placeName> nunciata quam <placeName ref="l760">Solothuri</placeName>; sed <lb xml:id="p1z16"/>tamen quid non timemus amantes?</s>
					<s n="7" xml:lang="la">aut <lb xml:id="p1z17"/>quid adversarii non audent?</s>
					<s n="8" xml:lang="la">Deinde addit <lb xml:id="p1z18"/>in literis pro certo exercitum <persName ref="p18477">Ferdinandi</persName> contra <lb xml:id="p1z19"/><placeName ref="l2510">Turcam</placeName> missum esse deletum et in hoc 400 equites.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>Quae mandasti, maiori curae mihi esse non possunt; <lb xml:id="p1z21"/>scripsi in plura simul loca.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><persName ref="p8114">Balingketus</persName> praeterea <lb xml:id="p1z22"/>singulariter promisit operam; interim et hic <lb xml:id="p1z23"/>apud papistas meos habebo exploratores.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p3375">Vergerius</persName> heri <placeName ref="l93">Clavenna</placeName> rediit.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Nondum conveni <lb xml:id="p1z25"/>hominem; vides, quibus elogiis eum ornet senex <lb xml:id="p1z26"/><persName ref="p2019">Maynardus</persName>; quod ex specula prospexi et <lb xml:id="p1z27"/>illis ecclesiis ominatus sum, res testatur etc.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z28"/>Non est, quod vel <persName ref="p18700">Augustini</persName> vel <persName ref="p1770">Carlini</persName> literas <lb xml:id="p1z29"/>remittas; discerpe tamen.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z30"/>Collega dicit <persName ref="p3375">Vergerium</persName> dicere pontificem exercitum <lb xml:id="p1z31"/>in <placeName ref="l834">Italia</placeName> conscribere.</s>
					<s n="15" xml:lang="la">Venit alius <placeName ref="l522">Venetiis</placeName>, <lb xml:id="p1z32"/>qui idem refert.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Novi praeterea habetur plane <lb xml:id="p1z33"/>nihil.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Vale, reverende pater, cum tuis omnibus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z34"/><placeName ref="l98">Curię</placeName> 18. maii anno 1562.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Festinanter post <lb xml:id="p1z35"/>concionum molem.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z36"/>Tui observans.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Exemplaria literarum remitto.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Habeo gratias; legi cum <lb xml:id="p2z2"/>voluptate; sunt Latinissimae, sed et exscripsi.</s>
					<s n="23" xml:lang="la"><lb xml:id="p2z3"/>Ampliss<lb xml:id="p2z4"/>imo <lb xml:id="p2z5"/>viro d. <persName ref="p495">Heinrycho Bu<lb xml:id="p2z6"/>llingero</persName>, domino et patrono suo <lb xml:id="p2z7"/>summe observando.</s>
				</p>
			</div>
		</body>
	</text>
