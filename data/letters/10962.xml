	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Qui has perferendas accepit<note xml:id="fn1" type="footnote" n="1">Der Briefüberbringer ist unbekannt.</note>, nunc est civis <lb xml:id="p1z2"/><placeName ref="l491">Argentinę</placeName>, vir tui valde observans.</s>
					<s n="3" xml:lang="la">Dicit se initio <lb xml:id="p1z3"/>praedicationis <persName ref="p4091">Zvinglii</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p4091">Zwingli</persName> predigte vom 1. Januar 1519 an in <placeName ref="l587">Zürich</placeName>, s. <bibl source="b292">HBRG</bibl> I 12f.</note>, si recte memini, aut certe <lb xml:id="p1z4"/>sub primum bellum patrium<note xml:id="fn3" type="footnote" n="3">Gemeint ist der Erste Kappelerkrieg vom Juni 1529, s. <bibl source="b291">HBLS</bibl> IV 455.</note> factum extorrem a <placeName ref="l300">Lucerna</placeName> <lb xml:id="p1z5"/>propter causam communem.</s>
					<s n="4" xml:lang="la">Eum, oro, juves.</s>
					<s n="5" xml:lang="la">A <persName ref="p8418">Mycon<lb xml:id="p1z6"/>io</persName> causam omnem intelliges<note xml:id="fn4" type="footnote" n="4">Ein entsprechendes Schreiben von <persName ref="p8418">Myconius</persName> ist nicht bekannt.</note>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><pb type="edition" next="480"/>Age vero, mi <lb xml:id="p1z7"/><persName ref="p495">Bullingere</persName>, quanto testimonio quidam apud nos prę<lb xml:id="p1z8"/>dicant tuam diligentiam et studium in concordia ecclesiarum <lb xml:id="p1z9"/>reparanda!</s>
					<s n="7" xml:lang="la">Idem et <persName ref="p467">Bucerus</persName> agnoscit.</s>
					<s n="8" xml:lang="la">Nos adhuc <lb xml:id="p1z10"/>bona spes tenet.</s>
					<s n="9" xml:lang="la">Nam operam dabimus, ut <placeName ref="l558">Witen<lb xml:id="p1z11"/>bergenses</placeName> et principes intelligant, quam plene veritatem <lb xml:id="p1z12"/>agnoscatis et quam minime contemnendus <lb xml:id="p1z13"/>metus ab articulis<note xml:id="fn5" type="footnote" n="5">Gemeint ist die <placeName ref="l558">Wittenberger</placeName> Konkordie (<bibl source="b135">BucerDS</bibl> VI/1 114-134).</note> recipiendis vos remoretur.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/>Omnia synceriter et ut in oculis domini admoliemur.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z15"/>Vale felicissime.</s>
					<s n="12" xml:lang="la" ana="salute"><persName ref="p1753">Leonem</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p1753">Leo Jud</persName>.</note>, <persName ref="p8171">Bibliandrum</persName>, <persName ref="p8127">Pellicanum</persName> <lb xml:id="p1z16"/>nostrum, amicos omnes salvere plurimum opto.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z17"/><placeName ref="l491">Argen[torati]</placeName>30. novembris anno 1536.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p5565">V. Capito</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo d. <persName ref="p495">Henrico Bullinger<lb xml:id="p2z2"/>o</persName>, pastori <placeName ref="l587">Tigurino</placeName>, sibi <lb xml:id="p2z3"/>in domino observando.</s>
				</p>
			</div>
