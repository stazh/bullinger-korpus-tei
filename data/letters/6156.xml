	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Fuse exponet <persName ref="p8071">Voglerus</persName> noster, quid velit <lb xml:id="p1z2"/>et cur sit ad vos profectus; hunc tibi tanquam me ipsum <lb xml:id="p1z3"/>commendo in causa, quam agit.</s>
					<s n="3" xml:lang="la">Inservies et gratifica<lb xml:id="p1z4"/>beris et d. <persName ref="p6668">Stampfero</persName>, qui vir quis sit, nosti, <lb xml:id="p1z5"/>dignus, qui iuvetur et ametur ab omnibus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Heri sub vesperam accepi literas tuas, quibus vehe<lb xml:id="p1z8"/>menter sum perturbatus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Cur ad me solum res pertinentes <lb xml:id="p1z10"/>ad communem gubernationem scribitis?</s>
					<s n="6" xml:lang="la">Cur non <lb xml:id="p1z11"/>scribit consul ad consulem nostrum?</s>
					<s n="7" xml:lang="la">Cur non scribit l<lb xml:id="p1z12"/>egatus regius?</s>
					<s n="8" xml:lang="la">Cur non scribit vir aliquis <lb xml:id="p1z13"/>fidus ad utrumque consulem?</s>
					<s n="9" xml:lang="de">Das hätte ein ansähen; <lb xml:id="p1z14"/>der pfaffen ding hat wenig ansähens.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ego tamen <lb xml:id="p1z15"/>quod potui, sub noctem adhuc praestiti totumque <lb xml:id="p1z16"/>negotium consuli exposui postulans, ut rebus afflictis <lb xml:id="p1z17"/>consulat atque succurrat.</s>
					<s n="11" xml:lang="la">Vereor societatem <lb xml:id="p1z18"/>regum nobis fore initium, medium et finem <lb xml:id="p1z19"/>excidii.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Dominum oro, ut nos liberet a malo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z20"/>Plura audies a <persName ref="p8071">Voglero</persName> nostro, quem iterum iterum<lb xml:id="p1z21"/>que commendo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="de" ana="salute"><foreign xml:lang="la">Saluta legatum regium, <lb xml:id="p1z22"/>consules, fratres et <persName>Saliceos</persName>, <persName ref="p8093">Herculem</persName> imprimis et <lb xml:id="p1z23"/><persName ref="p8432">Friderychum</persName>;</foreign> vermanend sy, das <lb xml:id="p1z24"/>sy sich vor den <lb xml:id="p1z25"/><placeName ref="l875">Hispaniern</placeName> huͦtind, die uns nie guͦts gethan <lb xml:id="p1z26"/>und zuͦ besorgen noch nitt thuͦn werdent.</s>
					<s n="16" xml:lang="de">30. <lb xml:id="p1z27"/>maij 1564.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z28"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>ministro, domino colendo et <lb xml:id="p2z4"/>fratri charissimo.</s>
					<s n="19" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
