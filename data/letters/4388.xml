	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">Hodie summo mane tuas, honorande compater, <lb xml:id="p1z3"/>accepi et ago tibi usque gratias, quod tam <lb xml:id="p1z4"/>fideliter nobis omnia communicas.</s>
					<s n="3" xml:lang="la">Nunc scribere multa <lb xml:id="p1z5"/>non possum, quia rerum, de quibus scribere poteram, <lb xml:id="p1z6"/>nondum omnino certus sum et festinat <lb xml:id="p1z7"/>hic nuncius abire, qui senatui vestro forte <lb xml:id="p1z8"/>ea afferet, quę ego alias scripturus eram.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Si quid tu ibi ex fidelibus amicis certi cognoveris, <lb xml:id="p1z10"/>fac, quaeso, per hunc ipsum nuncium sciam.</s>
					<s n="5" xml:lang="la">Unum <lb xml:id="p1z11"/>tantum est, quod te summopere rogo idque ab amicis <lb xml:id="p1z12"/>quibusdam subornatus, ut mihi significes, <lb xml:id="p1z13"/>quid apud <placeName ref="l646">Glaronenses</placeName> fiat.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Fertur enim hic <lb xml:id="p1z14"/>ex aliquot delubris apud illos idola, ubi adhuc <lb xml:id="p1z15"/>supererant, eiecta et ex eo nescio quid periculi <lb xml:id="p1z16"/>ipsis a vicinis imminere.</s>
					<s n="7" xml:lang="la">De <placeName ref="l791">Valesianis</placeName> optime <lb xml:id="p1z17"/>spero.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Sed plura non possum, literas claudere cogor <lb xml:id="p1z18"/>propter festinum nuncii abitum.</s>
					<s n="9" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l41">Bernę</placeName> <lb xml:id="p1z19"/>12. augusti, hora fere prima post meridiem.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p8018">I[oannes] H[allerus</persName>] tuus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesię pastori fidelissimo, <lb xml:id="p2z4"/>domino et compatri <lb xml:id="p2z5"/>charissimo suo<note type="misc">vgl. <bibl source="b197">EA</bibl> IV, zr2, 133, 135.</note>.</s>
				</p>
			</div>
		</body>
