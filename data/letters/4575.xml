	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Varie me affecerunt literę tuę varia nunciantes, sed <lb xml:id="p1z2"/>tristia plura quam iucunda, nisi quod volupe fuit legere <placeName ref="l41">Bernensium</placeName> <lb xml:id="p1z3"/>et <placeName ref="l167">Gebennensium</placeName> concordiam, quam dominus confirmet et conservet.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z4"/>Heri sub noctem literas a <persName ref="p8385">Conrado Huberto</persName>, olim <persName ref="p467">Buceri</persName> nostri <lb xml:id="p1z5"/>amanuense, literas accepi, quas mitto, ut ipse legas et proximo <lb xml:id="p1z6"/>nuncio remittas.</s>
					<s n="3" xml:lang="la">Scribit autem filius meus <persName>Ioannes Gervicus</persName> <lb xml:id="p1z7"/>regem <placeName ref="l1209">Navarrę</placeName> cum fratre captum a <placeName ref="l832">Gallo</placeName> contra datam ipsis <lb xml:id="p1z8"/>fidem publicam, cum ad comitia vocante rege venissent, quod <lb xml:id="p1z9"/>rex persuadere sibi a cardinalibus sustinuerit hereticis non <lb xml:id="p1z10"/>servandam fidem, quemadmodum nec <persName>Sigismundus Husso</persName> servavit.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z11"/>Redeamus in viam convertamur totis animis ad dominum <lb xml:id="p1z12"/>urgentes, apud quoscunque possumus, maturam pęnitentiam, <lb xml:id="p1z13"/>ut misertus nostri Christus tot malorum plaustra, quę humeris <lb xml:id="p1z14"/>nostris imponere meditantur hostes veritatis, potenti <lb xml:id="p1z15"/>sua manu in ipsorum capita et duras cervices reiiciat <lb xml:id="p1z16"/>donata nobis diuturna pace, qua nomen ipsius glorificemus.</s>
					<s n="5" xml:lang="la" ana="farewell"><lb xml:id="p1z17"/>Sed vale.</s>
					<s n="6" xml:lang="la">9. decembris 1560.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z18"/>T[uus] <persName ref="p8055">A[mbrosius] Bl[aurerus]</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho Bulli<lb xml:id="p2z2"/>ngero</persName>, viro clarissimo, <lb xml:id="p2z3"/>amico incomparabili.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
