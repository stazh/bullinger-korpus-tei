	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Cum e senatu veniens tuas resignassem, affertur mihi nuncius esse in hospitio <lb xml:id="p1z2"/>ad Agnum Aureum <persName ref="p21273">Jacobum Brenwaldum</persName> paratum ad reddendum, si quid habeam, <lb xml:id="p1z3"/>quod <placeName ref="l587">Tigurum</placeName> sim missurus.</s>
					<s n="3" xml:lang="la">Condixi me daturum, quas reddat literas; sed reclu<lb xml:id="p1z4"/>si tamen fasciculum et <persName ref="p540">Calvini</persName> librum inveni, quo de mihi significas, cuius primum <lb xml:id="p1z5"/>nomine tibi magnas ago gratias.</s>
					<s n="4" xml:lang="la">Cuperem abs te pluscula exempla <lb xml:id="p1z6"/>comparari, quae ad amicos mitterentur; non ambigo enim dignum lectione, quod <lb xml:id="p1z7"/>a <persName ref="p540">Calvino</persName> nostro est elucubratum.</s>
					<s n="5" xml:lang="la">Si ea haberet <persName>Antonius</persName> noster, magno venderet, <lb xml:id="p1z8"/>etiamsi palam non prostarent.</s>
					<s n="6" xml:lang="la">Habuimus autem ab amicis nostris mer<lb xml:id="p1z9"/>catoribus recentissimas literas ex <placeName ref="l15">Antwerpia</placeName> missas, quarum exemplar ad <lb xml:id="p1z10"/>te mittimus, sed eo pacto, ut, ubi legeris et nostris, praesertim D. D. consulibus, com<lb xml:id="p1z11"/>municaris, ad me remittas.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Submittam brevi, quo genere supplicii perierit <lb xml:id="p1z12"/>protectoris regii frater, deinde etiam, quid cum aliis coniuratis actum sit; nam <lb xml:id="p1z13"/>isthaec omnia scripturum ille, qui alia scripsit hactenus, sancte pollicitus est et <lb xml:id="p1z14"/>ego (egos?) meos sum precatus, ne quid me caelent.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l473">Sangalli</placeName> in ipso <lb xml:id="p1z15"/>prandio 18 Februarii anno 1549.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p8049">Ioachimus Vadianus</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z17"/>Mire me exhilaravit nuncius de <persName ref="p8417">Musculo</persName>; gratulor ei ex animo functionem <lb xml:id="p1z18"/>tam frugiferam et honorificam.</s>
					<s n="12" xml:lang="la" ana="salute">Dominus ipsum diu publicę pietati conservet, <lb xml:id="p1z19"/>quem et meo nomine valde salutabis.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="13" xml:lang="de"><pb/><lb xml:id="p2z1"/>An maister <persName ref="p495">Heinrichen Bullinger</persName>, <lb xml:id="p2z2"/>predicanten zuͦ dem <lb xml:id="p2z3"/>Grossen Münster <placeName ref="l587">Zürich</placeName>, <lb xml:id="p2z4"/>minem lieben herren und <lb xml:id="p2z5"/>freundt zuͦ handen.</s>
				</p>
			</div>
		</body>
	</text>
