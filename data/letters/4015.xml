	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Tuas, optime vir, datas <placeName ref="l93">Clavenae</placeName> 20. iunii acce<lb xml:id="p1z2"/>pi mature.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Illico per negotia respondere non potui, <lb xml:id="p1z3"/>nunc brevissime cogor respondere.</s>
					<s n="4" xml:lang="la">Imprimis te hortor, <lb xml:id="p1z4"/>ut filium nostrum <persName>Ioannem</persName> a studiis non retrahas; spero <lb xml:id="p1z5"/>illum, si vixerit, aliquando ornamento fore <placeName ref="l648">Rhetiis</placeName>.</s>
					<s n="5" xml:lang="la" ana="salute"><lb xml:id="p1z6"/>Saluta illum humanissime.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><persName>Hectorem</persName> fratrem collocavi <lb xml:id="p1z7"/>apud d. <persName>Sebastianum</persName> ludimagistrum etc., quem <lb xml:id="p1z8"/><persName>Ioannes</persName> noster novit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Supputavi cum illo d. <persName ref="p19043">Antonio</persName>, <lb xml:id="p1z9"/>apud quem habitat <persName ref="p499">Iosue</persName>, iunior frater, praesente, <lb xml:id="p1z11"/>ac debet mihi pater novem aureos, <foreign xml:lang="de">15 batzen <placeName ref="l257">Constantzer</placeName></foreign> pro <lb xml:id="p1z12"/>aureo supputatis et batzonibus cum 3 h[eller].</s>
					<s n="8" xml:lang="la">Scripsi supputatio<lb xml:id="p1z13"/>nem in schedam et imposui literis ad patrem <lb xml:id="p1z14"/>tuum scriptis; apud hunc me, quaeso, excuses, quod <lb xml:id="p1z15"/>illum a me dimisi.</s>
					<s n="9" xml:lang="la">Praeterea pro Ioanne tuo <lb xml:id="p1z16"/>exposui septem et semis batzones <placeName ref="l257">Constantzer</placeName> pro vectura <lb xml:id="p1z17"/>dolioli sui ex <placeName ref="l28">Basilea</placeName>; id in aedibus meis haeret.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Oravi <persName>Zieglerum</persName> et <persName>Antonium Besuzium</persName>, <lb xml:id="p1z19"/>ut curet avehi; sed manet in aedibus meis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/>In <placeName ref="l830">Anglia</placeName> finitum est parliamentum 8. maii et <lb xml:id="p1z21"/>communibus votis haec certo sunt decreta, uti literis certis <lb xml:id="p1z22"/><placeName ref="l296">Londino</placeName> ad nos perscribitur: 1. Renunciatum <lb xml:id="p1z23"/>est Romano pontifici et ecclesiae in aeternum.</s>
					<s n="12" xml:lang="la">2. Iurisdictio, <lb xml:id="p1z24"/>quam habuit pontifex Romanus data est reginae, quae recepit <lb xml:id="p1z25"/>excepto titulo capitis ecclesiae.</s>
					<s n="13" xml:lang="la">3. Missa abro<lb xml:id="p1z26"/>gata est cum omnibus impietatibus papisticis.</s>
					<s n="14" xml:lang="la">4. R<lb xml:id="p1z27"/>ecepta est iterum reformatio <persName>Eduardi</persName> regis 6. in <lb xml:id="p1z28"/>dogmatis et ritibus.</s>
					<s n="15" xml:lang="la">5. Episcopi redacti sunt in ordinem, <lb xml:id="p1z29"/>arces, opes, dominia saeculiaria illis adempta.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z30"/>6. Missi sunt visitatores, qui reforment scholas <lb xml:id="p1z31"/>in inchoent reformationem per episcopatus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z32"/>In <placeName ref="l2524">Scotia</placeName> <lb xml:id="p1z33"/>commota est turba; postulatur liber evangelii cursus; <lb xml:id="p1z34"/>repetunt reginam suam, ut vel ipsa vel rex <persName>regno <lb xml:id="p1z35"/>Scotiae</persName> praesideat; nolle se administrari ut prae<lb xml:id="p1z36"/>fecturam.</s>
					<s n="18" xml:lang="la">Dicuntur aliquot <persName>Galli</persName> caesi etc.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">In <placeName ref="l832">Gallia</placeName>, <lb xml:id="p1z37"/>quod pro certo tibi scribo, instruit se rex ad <lb xml:id="p1z38"/>gravem persequtionem fidelium et iam capit aliquos, <lb xml:id="p1z39"/>vexat Pictavos.</s>
					<s n="20" xml:lang="la"><persName ref="p18090">Regi Navarrę</persName> graviter minatus <lb xml:id="p1z40"/>est et comiti <persName>Aran</persName>... etc.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Sic instigatur ab <lb xml:id="p1z41"/>illis, quibus merces aliquando digna numerbabitur.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="farewell"><lb xml:id="p1z42"/>Vive et vale cum socero et bonis omnibus.</s>
					<s n="23" xml:lang="la">Festinantis<lb xml:id="p1z43"/>sime.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><placeName ref="l587">Tiguri</placeName> iulii 7. 1559.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z44"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z6"/>Clarissimo viro d. <persName ref="p8432">Fri<lb xml:id="p2z7"/>derycho a Salice</persName>, com<lb xml:id="p2z8"/>missario <placeName ref="l93">Clavennens<lb xml:id="p2z9"/>i</placeName> dignissimo, domino et <lb xml:id="p2z10"/>amico suo syncerissimo <lb xml:id="p2z11"/>et semper amando.</s>
					<s n="27" xml:lang="la"><lb xml:id="p2z12"/><placeName ref="l93">Kläven</placeName>.</s>
				</p>
			</div>
