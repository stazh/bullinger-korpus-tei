	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuis literis respondi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Te solum oratum velim, ut, si possis <lb xml:id="p1z2"/>ad <persName ref="p3375">Vergerium</persName> mittere literas, quas ad eum scribo, mittas; <lb xml:id="p1z3"/>nam ubi nunc sit, nescio.</s>
					<s n="4" xml:lang="la">Vellem comitiis <placeName ref="l18">Augustanis</placeName> adesse <lb xml:id="p1z4"/>posset; ad ea mittit rex archiepiscopum <placeName ref="l546">Viennensem</placeName>, qui summam <lb xml:id="p1z5"/>pietatem cum eruditione coniunctam habet et diu legatione <lb xml:id="p1z6"/>functus est apud imperatorem <persName ref="p18538">Carolum</persName>.</s>
					<s n="5" xml:lang="la">Si ad <persName ref="p8101">Lęlium</persName> scripseris <lb xml:id="p1z7"/>aut amicum aliquem, qui brevi ex <placeName ref="l2472">Polonia</placeName> rediturus sit, <lb xml:id="p1z8"/>orabis, ut gradarium aliquem equum pro uxore adducat.</s>
					<s n="6" xml:lang="la">Persolvam, <lb xml:id="p1z9"/>quod dixerit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Salutato amicos.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z10"/>Tuus<lb xml:id="p1z11"/>.</s>
				</p>
				<p>
					<note>[Von anderer Hand:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
				</p>
			</div>
		</body>
	</text>
