	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Nihil habeo omnino quod non d. <persName ref="p7228">Zwinglius</persName> ore tib<lb xml:id="p1z3"/>i referre possit.</s>
					<s n="3" xml:lang="la">Remitto tibi literas <placeName ref="l1206">Baionensis</placeName> <lb xml:id="p1z4"/>episcopi, versuti et callidi hominis, et pro illarum communicatione <lb xml:id="p1z5"/>ago tibi gratias.</s>
					<s n="4" xml:lang="la">Exspecto quid de <persName ref="p6589">Serveti</persName> causa de<lb xml:id="p1z6"/>creveritis.</s>
					<s n="5" xml:lang="la">Oro ut mature nobis hoc communices.</s>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z7"/>Bene vale cum tuis omnibus quum domesticis, <lb xml:id="p1z8"/>tum fratribus, ac in opere domini collaboratoribus.</s>
					<s n="7" xml:lang="la" ana="salute"><lb xml:id="p1z9"/>Salutant te <persName ref="p8417">Musculus</persName> et nostri.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l41">Bernae</placeName> 28. octobris 1553.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z10"/><persName ref="p8018">Hallerus</persName> tuus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName> <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesię pastori f<lb xml:id="p2z5"/>idelissimo venerando <lb xml:id="p2z6"/>suo domino ac <lb xml:id="p2z7"/>compatri charis<lb xml:id="p2z8"/>simo.</s>
				</p>
			</div>
		</body>
	</text>
