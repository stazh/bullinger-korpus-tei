	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Cum nostri theologi, quos ad petitionem regis
					<lb xml:id="p1z2"/>Novarrae calendis octobris in Galliam ablegamis.
					<lb xml:id="p1z3"/>ab eo tempore nihil literarum ad nos dede,
					<lb xml:id="p1z4"/>nec de eorum incolumitate reditu
					<lb xml:id="p1z5"/>actionibusque quicquam certi habeamus, imo
					<lb xml:id="p1z6"/>quotidianis curis affligamur, ne vel literae
					<lb xml:id="p1z7"/>illorum ab adversariorum insidiosis conatibus
					<lb xml:id="p1z8"/>interceptae vel in eam solitudinem collocati
					<lb xml:id="p1z9"/>ut omnis facultas ad nos scribendi eis ademptus
					<lb xml:id="p1z10"/>sit. Operae pretium indicavimus, hunc proprium
					<lb xml:id="p1z11"/>tabellarium ad vos mitterum esse, quin
					<lb xml:id="p1z12"/>moastra ac sollicitudinem nostram vobis literis
					<lb xml:id="p1z13"/>exponeret. Petimus igitur, mi Bullingere,
					<lb xml:id="p1z14"/>ut, si quid certi de religionis negotio
					<lb xml:id="p1z15"/>ac nostrorum hominum conditione ex Galliu
					<lb xml:id="p1z16"/>ad vos perlatum sit, id nobis benevolom
					<lb xml:id="p1z17"/>animo communicare velitis. De cursu
					<lb xml:id="p1z18"/>evangelii optima quaeque speramus, cum
					<lb xml:id="p1z19"/>pontifex Romanus de eo regno na
					<lb xml:id="p1z20"/>desperare incipiat. Ac nisi falsi fratres
					<lb xml:id="p1z21"/>obstarent, iamdudum piis ecclesiis consulti
					<lb xml:id="p1z22"/>fuisset, qui tamen suo tempore meriti
					<lb xml:id="p1z23"/>poenas liens. Nuum, mi Bullingere,
					<lb xml:id="p1z24"/>valetudine cura, ut diu turbatis ecclesia
					<lb xml:id="p1z25"/>tua salutari aedificatione prodesse
					<lb xml:id="p1z26"/>possis. Datae Hedelbergae 22. novembris
					<lb xml:id="p1z27"/>anno etc. 61.
					<lb xml:id="p1z28"/>Tui auantissimo
					<lb xml:id="p1z29"/>Stephenus Cuelerus.
					<lb xml:id="p1z30"/>secretarius.
					<pb/>
					<lb xml:id="p2z1"/>Reverendo viro pietate summaque
					<lb xml:id="p2z2"/>doctrina praestanti d. Henrico
					<lb xml:id="p2z3"/>Bullingero, ecclesiae Tigurinae
					<lb xml:id="p2z4"/>antistiti dignissimo, domino et amico
					<lb xml:id="p2z5"/>singulari fide colendo.
					<lb xml:id="p2z6"/>taphan
					<lb xml:id="p2z7"/>secretarii.
				</p>
			</div>
