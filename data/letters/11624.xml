	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ego ad te nihil habeo scribente ad te <persName ref="p8055">Ambrosio</persName> nostro<note xml:id="fn1" type="footnote" n="1">Vgl. den Brief <persName ref="p8055">Ambrosius Blarers</persName> vom gleichen Tag (oben <ref target="file11623">Nr. 1580</ref>).</note>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Literas vero ab <placeName ref="l18">Augusta</placeName> ad me datas<note xml:id="fn2" type="footnote" n="2">Ein entsprechendes Schreiben aus <placeName ref="l18">Augsburg</placeName> liegt nicht vor.</note> hic mitto.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z3"/>Tantum mille gratias ago, quod pro <persName ref="p3963">Georgio</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p3963">Georg Wimpfer</persName>; vgl. oben <ref target="file11563">Nr. 1520</ref>, 21-25.</note>, <lb xml:id="p1z4"/>pastore in <placeName ref="l489">Stain</placeName>, tam fuisti sollicitus, ut iam <lb xml:id="p1z5"/>stipendium bona parte tuo beneficio auctum <lb xml:id="p1z6"/>habeat<note xml:id="fn4" type="footnote" n="4">Das Einkommen des Pfarrers von <placeName ref="l489">Stein am Rhein</placeName> ist erst für das Jahr 1548 genau bekannt; s. C[arl] A[ugust] <hi>Bächtold,</hi> Geschichte der Pfarrpfründen im Kanton Schaffhausen, Schaffhausen 1882, S. 226f (hier irrtümlich "Georg Mumpfer").</note>.</s>
					<s n="5" xml:lang="la">De aliis literas habes <persName ref="p8055">Ambrosii</persName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Christus <lb xml:id="p1z7"/>te servet incolumem<note xml:id="fn5" type="footnote" n="5"><persName ref="p4079">Zwick</persName> war wegen der grassierenden Pest um die Zürcher Theologen besorgt, wie auch aus seinem Brief vom gleichen Tag an <persName ref="p8127">Pelikan</persName> hervorgeht (s. Zürich ZB, Ms F 47, 50).</note> idque pro ecclesiae suae <lb xml:id="p1z8"/>gloria.</s>
					<s n="7" xml:lang="la">Quid enim futurum putas, si piis <lb xml:id="p1z9"/>ministris ecclesiae destituantur?</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Totam domum tuam salvam cupio.</s>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z11"/>Vale.</s>
					<s n="10" xml:lang="la">5. novembris 1541.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z12"/>Tuus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z2"/>charissimo in Christo <lb xml:id="p2z3"/>fratri.</s>
				</p>
			</div>
		</body>
	</text>
