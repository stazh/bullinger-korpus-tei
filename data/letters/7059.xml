	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto ad vos literas domini <persName ref="p629">Cognetii</persName>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Is ad me de <persName ref="p6130">Pontassellae</persName> negotio rescribit; <lb xml:id="p1z3"/>eum ego de meliore nota domino legato <lb xml:id="p1z4"/>apud <placeName ref="l648">Rhetos</placeName> commendavi.</s>
					<s n="4" xml:lang="la">Spero nos aliquid <lb xml:id="p1z5"/>effecturos; prolixe enim mihi humaniterque <lb xml:id="p1z6"/>de sua voluntate est pollicitus.</s>
					<s n="5" xml:lang="la">Haec scribo <lb xml:id="p1z7"/>occupatus; excusabitis epistolae negligentiam.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Ex <placeName ref="l822">Germania</placeName> scribitur <persName ref="p20484">Ioannem Federicum <lb xml:id="p1z9"/>Saxonem</persName>, qui <placeName ref="l1571">Gothae</placeName> obsidetur forti <lb xml:id="p1z10"/>praesentique animo eam obsidionem ferre <lb xml:id="p1z11"/>et ab omni re paratissimum esse.</s>
					<s n="7" xml:lang="la">Germani <lb xml:id="p1z12"/>negligunt bellum <placeName ref="l2510">Turcicum</placeName>, nescio quam <lb xml:id="p1z13"/>prudenter.</s>
					<s n="8" xml:lang="la"><placeName ref="l875">Hispanus</placeName> habet, quod agat in <lb xml:id="p1z14"/><placeName ref="l808">Belgio</placeName>; fertur enim <persName>Naussovius</persName> iunior, <lb xml:id="p1z15"/><persName>Aurantii</persName> frater, cum magnis copiis equitatuque <lb xml:id="p1z16"/><placeName ref="l822">Germanico</placeName> auxilio <placeName ref="l808">Belgis</placeName> advenisse.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Bene valete.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l760">Soloduro</placeName> 25. <lb xml:id="p1z17"/>martii 1567.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Vester ex animo <persName ref="p8160">P[omponius] Bellieure<lb xml:id="p1z18"/>us</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">C. C. et rev<lb xml:id="p1z19"/>erendissimis viris dominis <persName ref="p495">Henrico Bullingero</persName> et <persName ref="p8011">Rodol<lb xml:id="p1z20"/>pho Gvaltero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> pastoribus.</s>
				</p>
			</div>
		</body>
	</text>
