	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Magnopere me literae tuae, reverende pater, exhilararunt, utpote officii ac <lb xml:id="p1z2"/>humanitatis, quibus me semper prosequutus es, plenissimae.</s>
					<s n="3" xml:lang="la">In ipso luctu propter uxoris meae obitum <lb xml:id="p1z3"/>me deprehenderunt ac mirum in modum consolatae sunt; perspexi enim facile, quam tibi licet <lb xml:id="p1z4"/>absens cordi sim, qui non desinis perpetuo de me meisque omnibus optime mereri.</s>
					<s n="4" xml:lang="la">Pro hiis ergo <lb xml:id="p1z5"/>beneficiis, quibus ego par esse nequeo, deum rogo optimum maximum, ut is tibi vires rependat pro <lb xml:id="p1z6"/>sua benignitate inexhausta.</s>
					<s n="5" xml:lang="la">Remitto illa omnia, quae ad me proxime misisti, festinavi, <lb xml:id="p1z7"/>quantum potui, ut quam ocyssime absolverem.</s>
					<s n="6" xml:lang="la">Pos<lb xml:id="p1z8"/>tquam <lb xml:id="p1z9"/>eni<lb xml:id="p1z10"/>m uxor <lb xml:id="p1z11"/>mea piae memor<lb xml:id="p1z12"/>ię diem extr<lb xml:id="p1z13"/>emu<lb xml:id="p1z14"/>m obiit, aliquantul<lb xml:id="p1z15"/>um pl<lb xml:id="p1z16"/>us oti<lb xml:id="p1z17"/>i ac mi<lb xml:id="p1z18"/>nus curarum <lb xml:id="p1z19"/>mih<lb xml:id="p1z20"/>i fu<lb xml:id="p1z21"/>it; de<lb xml:id="p1z22"/>inde etiam mater<lb xml:id="p1z23"/>ia ipsa <lb xml:id="p1z24"/>perpetu<lb xml:id="p1z25"/>o me al<lb xml:id="p1z26"/>lexit<lb xml:id="p1z27"/>, ut manu<lb xml:id="p1z28"/>m amov<lb xml:id="p1z29"/>ere non <lb xml:id="p1z30"/>potue<lb xml:id="p1z31"/>rim, <lb xml:id="p1z32"/>donec tota<lb xml:id="p1z33"/>m absol<lb xml:id="p1z34"/>vissem; <lb xml:id="p1z35"/>multa mi<lb xml:id="p1z36"/>hi in m<lb xml:id="p1z37"/>e<lb xml:id="p1z38"/>moriam <lb xml:id="p1z39"/>red<lb xml:id="p1z40"/>iere, quae<lb xml:id="p1z41"/>.<pb/><lb xml:id="p2z2"/>.<lb xml:id="p2z7"/>.</s>
				</p>
