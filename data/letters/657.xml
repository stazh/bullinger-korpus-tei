	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus per Christum.</s>
					<s n="2" xml:lang="la">Memoralia tua in 2 libros Samuelis utilissima ea <lb xml:id="p1z2"/>festinancia, qua potui, descripsi, per fidum hunc iuvenem tuę humanitati <lb xml:id="p1z3"/>bona, uti spero, fide remitto.</s>
					<s n="3" xml:lang="la">Utinam huius non pęnitendi beneficii mihi <lb xml:id="p1z4"/>aliqua talionis occasio daretur.</s>
					<s n="4" xml:lang="la">At Iesus Christus, salvator noster, arduos <lb xml:id="p1z5"/>et sanctos tuos in fidelium ecclesiam labores statuto die rependet.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Placet mirum in modum, ut ea, quae habes in 2 Regum libros mihi ad <lb xml:id="p1z7"/>describendum communicare velis; maturius, quam putas, recipies.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z8"/>Vale raptim.</s>
					<s n="7" xml:lang="la">Dominus noster per Christum salvatorem nostrum suę ecclesię te perpetuo <lb xml:id="p1z9"/>incolumem conservet, memorque sis in tuis intimis precibus nostri <lb xml:id="p1z10"/>et magistratus, ne constancię virtutem obsequio sanguinariorum, qui in dies <lb xml:id="p1z11"/>literis frequentissimis pulsant apud senatum, perdant, sed constanter iudicata ex <lb xml:id="p1z12"/>[e]quantur.</s>
					<s n="8" xml:lang="la" ana="salute">Saluta omnes pios et vere doctos fratres <persName ref="p8011">Gwaltherum</persName> et <lb xml:id="p1z13"/><persName ref="p8171">Theodorum</persName> inprimis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Datum 25. augusti anno 49.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p8090">Henrichus Lęvinus</persName> tuus <lb xml:id="p1z15"/>ad omnia obsequentissimus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo integerrimoque <lb xml:id="p2z2"/>viro <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesię <placeName ref="l587">Tigurinae</placeName> summo <lb xml:id="p2z4"/>et vigilantissimo <lb xml:id="p2z5"/>pastori <lb xml:id="p2z6"/>et fratri suo in Christo charissimo.</s>
				</p>
			</div>
