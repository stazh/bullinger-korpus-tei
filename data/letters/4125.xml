	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Sane nihil habeo nunc, quod illis addam, <lb xml:id="p1z3"/>quas scripsi proxime.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><placeName ref="l2478">Sabaudię</placeName> principem <persName>Nyßam</persName> <lb xml:id="p1z4"/>profectum esse audimus et uxorem eius eum secutam; <lb xml:id="p1z5"/>quid moliatur, nondum certo constat.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Vicinos nostros arma parare et animis esse <lb xml:id="p1z7"/>suspensis scimus; sed spero fore, ut confundat <lb xml:id="p1z8"/>eos dominus.</s>
					<s n="5" xml:lang="la">Nescio, quid cursor hic vester attulerit, <lb xml:id="p1z9"/>num comitia indicentur necne.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ego affinem <lb xml:id="p1z10"/>habeo <placeName ref="l300">Lucernae</placeName> capitaneum, <persName>Herbortum</persName>, qui <lb xml:id="p1z11"/>his diebus hic fuit; sed nihil certi ab eo potuimus <lb xml:id="p1z12"/>expiscare.</s>
					<s n="7" xml:lang="la">Quid <placeName ref="l646">Glaronae</placeName> fiat, non opus est, ut <lb xml:id="p1z13"/>scribam tibi; metuo, ne tandem plane ruiturę <lb xml:id="p1z14"/>sint illae ecclesiae, nisi dominus eas mirabiliter sustentet; <lb xml:id="p1z15"/>nemini enim cordi est ea res, et ipsimet sibi asciscunt <lb xml:id="p1z16"/>omnia mala haec.</s>
					<s n="8" xml:lang="la">Ex <placeName ref="l167">Geneva</placeName> nihil interea acce<lb xml:id="p1z17"/>pimus, nisi quod strenue ędificent nova mu<lb xml:id="p1z18"/>nimenta et se parent ad obsidionem.</s>
					<s n="9" xml:lang="la">Interea perpetuo <lb xml:id="p1z19"/>novae lites aliae ex aliis inter ipsos et nostros <lb xml:id="p1z20"/>seruntur.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Orandus dominus, ut conciliet mentes <lb xml:id="p1z21"/>nostras in his tantis periculis, ne indesinens <lb xml:id="p1z22"/>illa simultas tandem utrique parti exitio sit.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z23"/>De expeditione <placeName ref="l2524">Scotica</placeName> nihil habemus certi neque <lb xml:id="p1z24"/>etiam de interitu regis <persName>Philippi</persName>.</s>
					<s n="12" xml:lang="la">Habemus lamen<lb xml:id="p1z25"/>tabilem historiam ex <placeName ref="l875">Hispanica</placeName> in <lb xml:id="p1z26"/><placeName ref="l822">Germanicam</placeName> translatam de 14 personis nobi<lb xml:id="p1z27"/>libus et celebribus cum magna pompa <lb xml:id="p1z28"/>et in frequenti principum et totius <placeName ref="l875">Hispanię</placeName> conventu <lb xml:id="p1z29"/>strangulatis et exustis in <placeName ref="l875">Hispania</placeName>, quam <lb xml:id="p1z30"/>et vos habere puto; mihi nunc ad manus <lb xml:id="p1z31"/>non est, alioqui mitterem ad te exemplar.</s>
					<s n="13" xml:lang="la">Remitto <lb xml:id="p1z32"/>tibi literas Fabritii et ago gratias.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><persName>Romani</persName> ut[<lb xml:id="p1z33"/>inam] perpetuo maneant inpontificati.</s>
					<s n="15" xml:lang="la"><persName ref="p8417">Mu[sculus]</persName> <lb xml:id="p1z34"/><persName>Locos</persName> suos iam typographo tradidit et... <lb xml:id="p1z35"/>nunc esse sub prelo.</s>
					<s n="16" xml:lang="la">Ursit illum nimis; alioqui <lb xml:id="p1z36"/>animus illi erat eos prius vobiscum communicare.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Salutat <lb xml:id="p1z37"/>is te vicissim et <lb xml:id="p1z38"/>simul omnes alii, quibus salutem <lb xml:id="p1z39"/>dicere iussisti, inprimis d. <persName ref="p3494">Diesbachius</persName>, cuius <lb xml:id="p1z40"/>uxor, honestissima matrona, diebus superioribus <lb xml:id="p1z41"/>non modo illius, sed et totius civitatis <lb xml:id="p1z42"/>magno moerore obiit.</s>
					<s n="18" xml:lang="la" ana="salute">Salutat te tuosque <lb xml:id="p1z43"/>mater mea, socer et amici omnes.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Salvi sint <lb xml:id="p1z44"/>tui omnes, fratres item ac symmystę, domini m<lb xml:id="p1z45"/>ei <lb xml:id="p1z46"/>observandi.</s>
					<s n="20" xml:lang="la"><placeName ref="l41">Bernae</placeName> 16. novembris 1559.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z47"/><persName ref="p8018">Ioan[nes] Hall[erus</persName>] tuus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori <lb xml:id="p2z4"/>fidelissimo, domino ac compatri su<lb xml:id="p2z5"/>o perpetuo honorando.</s>
				</p>
			</div>
