	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Ea est tui erga <placeName ref="l830">Angliam</placeName> animi propensio, <persName ref="p495">Bullingere</persName> <lb xml:id="p1z2"/>doctissime, ut facile mihi persuadeam tuam humanitatem aeque <lb xml:id="p1z3"/>curaturam ea, quae deprecatoriis a te petii literis, ac si <lb xml:id="p1z4"/>eadem de re multis literis multo plura agerem.</s>
					<s n="2" xml:lang="la">Itaque <lb xml:id="p1z5"/>meam pro mea <placeName ref="l830">Anglia</placeName> petitionem tibi commendo, cuius res quo <lb xml:id="p1z6"/>magis sint miserae, eo maiore miseratione dignae.</s>
					<s n="3" xml:lang="la">Redduntur <lb xml:id="p1z7"/>sane res nostrae in dies deteriores; iam enim ex <placeName ref="l830">Anglia</placeName> accepi <lb xml:id="p1z8"/>comitem <placeName ref="l2588">Sussexiae</placeName> missum cum aliqua manu militari in <lb xml:id="p1z9"/><placeName ref="l722">Norfolciam</placeName> et <placeName ref="l1956">Suffolciam</placeName>, ut evangelicos compellat ad <lb xml:id="p1z10"/>missas audiendas.</s>
					<s n="4" xml:lang="la">Et quae haec tyrannis?</s>
					<s n="5" xml:lang="la">Non putes <lb xml:id="p1z11"/>vere pios nunc egere consolatione, infirmos exhortatione?</s>
					<s n="6" xml:lang="la">Age <lb xml:id="p1z12"/>igitur, si vacat, optime pater, nostrosque tuis visita literis.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p18575">Philippus</persName> a consiliariis petiit, ut inauguraretur, hoc est, ut <lb xml:id="p1z14"/>vulgo apud nos dicitur, ut res <placeName ref="l830">Angliae</placeName> coronaretur, atque <lb xml:id="p1z15"/>decem millia <placeName ref="l830">Anglorum</placeName>, quos mitteret militatum sub <lb xml:id="p1z16"/>Caesare in bello <placeName ref="l832">Gallico</placeName>; sed utrumque fuit illi negatum.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Hinc, hinc mala <placeName ref="l830">Angliae</placeName> exitialia orientur, nisi deus optimus <lb xml:id="p1z18"/>maximus pro sua summa misericordia averterit; quod ut <lb xml:id="p1z19"/>faciat, tu deum nostrum per Christum deprecare meique vel in <lb xml:id="p1z20"/>fine orationis tuae aliquam mentionem facias.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Tuus <persName ref="p2866">Thomas Sampson</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Octobris <lb xml:id="p1z21"/>13.</s>
					<s n="11" xml:lang="la"><placeName ref="l280">Lausannae</placeName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName> <lb xml:id="p2z3"/>dentur hae.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
