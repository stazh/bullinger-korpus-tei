	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tabellarius ille <placeName ref="l300">Lucernat[um]</placeName> hodie hora 6 portas <lb xml:id="p1z2"/>civitatis egressus mihi factus est obviam.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Illum rogavi, ut hasce expectaret absolvendas <lb xml:id="p1z4"/>in proximis ędibus d. <persName>Io[hannis] Iac[obi] P.</persName>, quod <lb xml:id="p1z5"/>vix impetravi.</s>
					<s n="4" xml:lang="la">Scripsi per <placeName ref="l257">Constantiensem</placeName> <lb xml:id="p1z6"/>tabellarium 21. huius, misi reliquam <lb xml:id="p1z7"/>recessus partem et hortatus sum, ut non <lb xml:id="p1z8"/>fortuito, sed in hoc conducto tabellari<lb xml:id="p1z9"/>o rem cum <placeName ref="l280">Lausannensibus</placeName> sive <placeName ref="l167">Genevensibus</placeName> <lb xml:id="p1z10"/>de praeceptore transigas.</s>
					<s n="5" xml:lang="la">Item iterum oro et <lb xml:id="p1z11"/>obtestor.</s>
					<s n="6" xml:lang="la"><persName ref="p8126">Oporini</persName> nepos mihi posset obtingere, <lb xml:id="p1z12"/>cui ut respondeam necessum habeo.</s>
					<s n="7" xml:lang="la">Mallem <lb xml:id="p1z13"/>aliquem per vos mihi oblatum.</s>
					<s n="8" xml:lang="la">Quare rogo, <lb xml:id="p1z14"/>ut sedulo agatis, neque ullis expensis <lb xml:id="p1z15"/>parcite.</s>
					<s n="9" xml:lang="la">Dabo operam, ut nihil ingrato <lb xml:id="p1z16"/>prestetis.</s>
					<s n="10" xml:lang="la">Non licet plura.</s>
					<s n="11" xml:lang="la" ana="salute">Salutem <persName ref="p1283">Gesnero</persName> et <lb xml:id="p1z17"/>amicis.</s>
					<s n="12" xml:lang="la">Ocyssime.</s>
					<s n="13" xml:lang="la">25. ianuarii anno etc. 56.<note type="margin">a.R.: D.I.U.</note></s>
				</p>
				<p>
					<s n="14" xml:lang="la"><persName ref="p2856">G[ereon] S[ailerus</persName>] d[octor] i[uris] <lb xml:id="p1z18"/>u[tri<lb xml:id="p1z19"/>usque].</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Hainricho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurino</placeName> <lb xml:id="p2z3"/>episcopo, d. et amico <lb xml:id="p2z4"/>selectissimo.</s>
					<s n="16" xml:lang="de"><lb xml:id="p2z5"/>Zürch.</s>
				</p>
			</div>
		</body>
	</text>
