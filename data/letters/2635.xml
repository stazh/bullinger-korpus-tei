	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Quae ego de Turcae apparatu ad te antea
					<lb xml:id="p1z2"/>scripsi Utinam tam certa non essent. Caeterum
					<lb xml:id="p1z3"/>in Germania, quantum ex multorum literis colligi
					<lb xml:id="p1z4"/>omnia invenio sedatiora neque illam modo
					<lb xml:id="p1z5"/>principum coniurationem non timeri, sed ne
					<lb xml:id="p1z6"/>caesaris quidem conatum in restituendo
					<lb xml:id="p1z7"/>Rassaviensi, de quo multa a finidis
					<lb xml:id="p1z8"/>hominibus spargebantur, tanquam sub illo praetextu
					<lb xml:id="p1z9"/>Philippus Germaniam ingressurus et
					<lb xml:id="p1z10"/>ad portas Francfordiae exercitum locaturus
					<lb xml:id="p1z11"/>ibique fecundum imperii morem tamdii permansum
					<lb xml:id="p1z12"/>et.
					<lb xml:id="p1z13"/>quousque
					<lb xml:id="p1z14"/>esset imperator ita ipso ture freget
					<lb xml:id="p1z15"/>spmitia ad primum iunii scis esse indicta. sed
					<lb xml:id="p1z16"/>quantum audio principes in personis libenter
					<lb xml:id="p1z17"/>convenient, et tamen regis Rom ves sant
					<lb xml:id="p1z18"/>i eo statu, ut vel parva mora maximum
					<lb xml:id="p1z19"/>detrimentum iis afferre possit. Transyluania
					<pb/>
					<lb xml:id="p2z1"/>In pueri Vaynodae potestatem redacta ess
					<lb xml:id="p2z2"/>urbe (opinor). Alba excepta et uno atque atter
					<lb xml:id="p2z3"/>cantillo, quae etiam non magna difficultatu
					<lb xml:id="p2z4"/>dicunt occupata iri. Inter episcopos et
					<lb xml:id="p2z5"/>marchionem Albertum nihildum potuit convenir
					<lb xml:id="p2z6"/>si quicquam aliud est fimenda Germaniae
					<lb xml:id="p2z7"/>illa controversia, non tam ex sese quam
					<lb xml:id="p2z8"/>illius occasione, si res ad arma veniat
					<lb xml:id="p2z9"/>illius hostes se aliquid effecturos sperent
					<lb xml:id="p2z10"/>contra libertatem imperii. Nova fuius
					<lb xml:id="p2z11"/>Dux Ascoti, qui captivus in ducis
					<lb xml:id="p2z12"/>Mommorantii Conestas manibus erat evasit
					<lb xml:id="p2z13"/>ex Casello bene munito, maxima ipsius
					<lb xml:id="p2z14"/>d. constabilis lactura, qui filium apud
					<lb xml:id="p2z15"/>Casarianos captivum habet, quem non solum
					<lb xml:id="p2z16"/>istius pertuntationem redimere, sed magnam etiam
					<lb xml:id="p2z17"/>summa pecuniae ultra consequi poterat
					<pb/>
					<lb xml:id="p3z1"/>altero
					<lb xml:id="p3z2"/>aton.
					<lb xml:id="p3z3"/>Tusius.
					<lb xml:id="p3z4"/>veneat.
					<lb xml:id="p3z5"/>nt.
					<lb xml:id="p3z6"/>lucis
					<lb xml:id="p3z7"/>Tuua.
					<lb xml:id="p3z8"/>hat.
					<lb xml:id="p3z9"/>Mitto tibi induciarum articulos in laguam Germanica
					<lb xml:id="p3z10"/>transtates, quos consuli Habio dabis, eundem
					<lb xml:id="p3z11"/>quoque meo nomine salutabis. Nihil est alius
					<lb xml:id="p3z12"/>quod scribam. Vale. 2. maii
					<lb xml:id="p3z13"/>Mus hantaurent.
					<pb/>
					<lb xml:id="p5z1"/>D. Henrico Bullingero,
					<lb xml:id="p5z2"/>S. Laurentianus
					<lb xml:id="p5z3"/>ultimae.
					<lb xml:id="p5z4"/>8.
					<pb/>
					<lb xml:id="p6z1"/>Clarissimo thelogo d. Heinrico
					<lb xml:id="p6z2"/>me
					<lb xml:id="p6z3"/>Bullingero, amico carnio
				</p>
			</div>
		</body>
