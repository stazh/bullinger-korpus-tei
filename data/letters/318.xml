	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Accepi ternas tuas literas, ad quas nunc respon<lb xml:id="p1z2"/>deo.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Laudo tuam diligentiam et studium in consolando, admonendo <lb xml:id="p1z3"/>de rebus ad ecclesiam, quam multi conantur oprimere, pertinentibus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Satan ubique negotium piis facessit, conatur et iam etiam nostras <lb xml:id="p1z5"/>ecclesias adoritur mirabili astutia; sed confundantur et erubescant <lb xml:id="p1z6"/>omnes, qui odiunt nomen Christi Iesu.</s>
					<s n="5" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z7"/>Nobiles <placeName>Crechtgavienses</placeName> numero 68 convocati sunt <placeName>Sinsheim</placeName> <lb xml:id="p1z8"/>a <persName>Palatino</persName>, et est eis Interim propositum, quod unum omnes <lb xml:id="p1z9"/>receperunt; nunc laborant, quomodo quam minimum mordeantur <lb xml:id="p1z10"/>a serpente, quem in sinum admiserunt, utque Christum simul ret<lb xml:id="p1z11"/>ineant.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Dominus adsit illi.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p4637">Vitus Theodorus</persName> hęc scribit, et literę datę sunt pridie <lb xml:id="p1z14"/>Michaelis: "Scias sanguinem manasse in <placeName ref="l449">Silesia</placeName> e sti<lb xml:id="p1z15"/>pulis, prope <placeName ref="l1041">Brunsvicum</placeName> ex terra, <placeName ref="l1032">Coburgi</placeName> ex piscina <lb xml:id="p1z16"/>et hic copiose admodum atque tribus septiman<lb xml:id="p1z17"/>is.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/>Ex <placeName ref="l808">Belgis</placeName> nihil audimus.</s>
					<s n="10" xml:lang="la">Caesar <placeName ref="l1284">Bruxellae</placeName> ligni aquam bibit, <lb xml:id="p1z19"/>quid per aestatem acturus praeme<lb xml:id="p1z20"/>dit<lb xml:id="p1z21"/>ans."</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z22"/><placeName ref="l491">Argentina</placeName> nondum recepit Interim<lb xml:id="p1z23"/>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p2095">Philippus Melanchthon</persName> hęc: "<lb xml:id="p1z25"/>Cum tantę fuerint de rebus maximis dissentiones inter <lb xml:id="p1z26"/>doctores, minus miremur populi voluntates parum firmas <lb xml:id="p1z27"/>fuisse, imo nec illud miremur iram dei atrociorem adversum nos <lb xml:id="p1z28"/>accensam esse, quam ut mitiget; quotidie enim gemens <lb xml:id="p1z31"/>oro.</s>
					<s n="13" xml:lang="la">Iacent, pro dolor, ecclesiae nunc oppressę multiplice ty<lb xml:id="p1z32"/>rannide; sed iacebant et ante dilaceratę dissidiis.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Nunc <lb xml:id="p1z33"/>utcunque [...] <foreign xml:lang="el">αγοσ δει πολιτενσιγ</foreign>, quę deus <pb/><lb xml:id="p2z1"/>gubernet.</s>
					<s n="15" xml:lang="la">Civitates <placeName ref="l749">Saxonicę</placeName> in litore <placeName>Baltico</placeName> <lb xml:id="p2z2"/>et ceterae et <placeName ref="l743">Pomeranię</placeName> duces decreverunt se non <lb xml:id="p2z3"/>velle mutare doctrinam aut ritus suarum ecclesiarum.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z4"/>Et si autem vidimus, quam facile fracti sint alii, <lb xml:id="p2z5"/>qui maiores causas habuerant, ne reciperent <lb xml:id="p2z6"/>illam novam <foreign xml:lang="el">γομοδεσια</foreign>, tamen nunc quidem <lb xml:id="p2z8"/>horum volutans laudanda est et deus orandus, ut <lb xml:id="p2z9"/>servet ecclesiae suę reliquias.</s>
					<s n="17" xml:lang="la">Edere librum dicitur <lb xml:id="p2z10"/><foreign xml:lang="el">οτον Μαφφιτισ Κολα...</foreign>, in quo cum me accuset, <lb xml:id="p2z11"/>fortass aliud hospitium mihi quęrendum erit, <lb xml:id="p2z12"/>ubi ędere responsionem possim" e<lb xml:id="p2z13"/>tc.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><lb xml:id="p2z14"/>Den herren <persName ref="p2916">Sebastian Schertlin</persName> haben unsere herren <lb xml:id="p2z15"/>geheissen, sine roß in sin huß nehmen uß der <lb xml:id="p2z16"/>herberg, und er möge wol in sim huss essen, <lb xml:id="p2z17"/>aber doch die spiß uß der herberg nemen.</s>
					<s n="19" xml:lang="de"><lb xml:id="p2z18"/>Ich hoff, es werde im bald alles erloubt <lb xml:id="p2z20"/>werden, das er ist begeren.</s>
				</p>
				<p>
					<s n="20" xml:lang="de"><lb xml:id="p2z21"/>Etlich uffruͤrische in <placeName ref="l832">Franckreich</placeName>, auß keyser <lb xml:id="p2z22"/>landt stossende, sindt by einanderen, haben sich <lb xml:id="p2z23"/>vil im adel zuͦ inen thon, sindt also rebelles, <lb xml:id="p2z24"/>haben paner gemacht, doran statt geschriben <lb xml:id="p2z25"/>mit goldenen buͦchstaben an der einen <pb/><lb xml:id="p3z2"/>sitten: Libertas, an der anderen: <foreign xml:lang="la">Seu <lb xml:id="p3z3"/>melius seu peius.</foreign></s>
					<s n="21" xml:lang="de">Der künig sol sin volck <lb xml:id="p3z4"/>uß <placeName ref="l2524">Schotten</placeName> beruͤffen, die wil mann ein anstandt <lb xml:id="p3z5"/>gemacht hat, die zuͦ kriegen.</s>
					<s n="22" xml:lang="de">Es sindt arm <lb xml:id="p3z6"/>lüt, die sich selbs in geferlichheit stossen on not, <foreign xml:lang="la">quum <lb xml:id="p3z7"/>seditiosi nihil unquam prosperi habuerint</foreign>.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="farewell">Vale.</s>
					<s n="24" xml:lang="la" ana="salute"><persName ref="p458">Brentius</persName> <lb xml:id="p3z8"/>te salutat.</s>
					<s n="25" xml:lang="la" ana="salute">Salutabis et tu D. <persName ref="p8417">Musculum</persName>, cui fausta omnia <lb xml:id="p3z9"/>precor; potuisset apud nos manere commodissime; sed nescio <lb xml:id="p3z10"/>quo consilio <placeName ref="l28">Basileam</placeName> reliquerit.</s>
					<s n="26" xml:lang="la">25. Octobris 1548.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p3z11"/>Quid actum sit in senatu quidve responsi nostri daturi <lb xml:id="p3z12"/>Paganicis, ignoro; sed fusius a D. <persName ref="p8418">Myconio</persName> <lb xml:id="p3z13"/>percipies; nam crastina die habetur maior senatus.</s>
					<s n="28" xml:lang="la"><lb xml:id="p3z14"/>Verum hoc scio, quod non satis nostri possunt admirari <lb xml:id="p3z15"/>filiorum hominum astutias, calliditates; sed sic capiuntur <lb xml:id="p3z16"/>vulpes.</s>
					<s n="29" xml:lang="la">De legato quodam, qui in mea contione fuit, <lb xml:id="p3z17"/>quid dicam?</s>
					<s n="30" xml:lang="la">Quum de peccatis occultis mentionem facerem, <lb xml:id="p3z18"/>quę deus raro impunitas sinit, e templo mox se proripuit <lb xml:id="p3z19"/>expuens in terram, ut signatum <lb xml:id="p3z20"/>mihi.</s>
				</p>
				<p>
					<s n="31" xml:lang="la">Sic se produnt miseri homines.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><lb xml:id="p3z21"/>Tuus <persName ref="p1278">G[astius]</persName>.</s>
				</p>
				<p>
					<s n="33" xml:lang="la" ana="salute"><lb xml:id="p3z22"/>D. <lb xml:id="p3z23"/><persName ref="p8171">Theodorum</persName>, <persName ref="p8127">Pellicanum</persName> <lb xml:id="p3z24"/>et reliquos fratres salvere iubeas et in domino <lb xml:id="p3z25"/>constantes esse.</s>
					<s n="34" xml:lang="la">Felicem exitum speramus in negotio e<lb xml:id="p3z26"/>vangelii de Iesu Christo.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="35" xml:lang="la"><pb/><lb xml:id="p4z1"/>Domino <persName ref="p495">Heinrycho <lb xml:id="p4z2"/>Bullingero</persName>, <lb xml:id="p4z3"/>pastori <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p4z4"/>ecclesiae diligen<lb xml:id="p4z5"/>tissimo.</s>
					<s n="36" xml:lang="de"><lb xml:id="p4z6"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
