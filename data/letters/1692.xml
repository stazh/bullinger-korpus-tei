	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Gratissimę fuerunt mihi tuae literae, quas <lb xml:id="p1z2"/>hodie domum accepi, cum scriptas intelligam <lb xml:id="p1z3"/>in vigilia Ioannis Baptistae.</s>
					<s n="3" xml:lang="la">Di boni, ubi tam diu <lb xml:id="p1z4"/>delituerunt?</s>
					<s n="4" xml:lang="la">Venit puella sub contione sacra <lb xml:id="p1z5"/>et literas ancillae dedit; igitur, quae illa fuerit, <lb xml:id="p1z6"/>nescio, nec illa dixit, unde ferat aut a <lb xml:id="p1z7"/>quo acceperit.</s>
					<s n="5" xml:lang="la" ana="salute">Interea fuit apud nos <persName ref="p8011">Gvalt<lb xml:id="p1z8"/>herus</persName> noster, qui ex te salutem dixit et tuam humanitatem <lb xml:id="p1z9"/>et dilectionem erga nos praedicavit.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Utinam brevi convalescat uxor, ut et tu nulla <lb xml:id="p1z11"/>excrutieris domestica cura; sed dominus non <lb xml:id="p1z12"/>deerit tuae pietati.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Apud nos nihil est novi, <lb xml:id="p1z13"/>nisi quod principes dicuntur pacem cum <lb xml:id="p1z14"/>Caesare iniisse; utinam inde non exoriantur <lb xml:id="p1z15"/>aliquando bella saevissima et persequtiones gravissimae.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Dominus misereatur nostri.</s>
					<s n="9" xml:lang="la">Si certa hisce <lb xml:id="p1z17"/>de rebus acceperis, rem feceris gratissimam, <lb xml:id="p1z18"/>si communicaveris.</s>
					<s n="10" xml:lang="la" ana="farewell">Vive et vale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/>Augusti 9. anno 1552.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p8418">Osvaldo Myconio</persName>, <lb xml:id="p2z3"/><placeName ref="l28">Basiliensis</placeName> <lb xml:id="p2z4"/>ecclesiae antistiti <lb xml:id="p2z5"/>fidelissimo, domino et <lb xml:id="p2z6"/>fratri suo colendo.</s>
				</p>
			</div>
		</body>
	</text>
