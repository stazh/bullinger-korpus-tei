	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Hodie demum accepi tuas 28. <lb xml:id="p1z2"/>augusti scriptas.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><placeName ref="l300">Lucernates</placeName> petunt con<lb xml:id="p1z3"/>scribi comicia, causas non indicant; con<lb xml:id="p1z4"/>scribuntur ad 27. huius mensis.</s>
					<s n="4" xml:lang="la">Multi suspicantur <lb xml:id="p1z5"/>illos aliquid acturos ex instinctu <lb xml:id="p1z6"/><persName ref="p18531">papae</persName> et <persName ref="p18538">Caesaris</persName>; sed audiemus.</s>
					<s n="5" xml:lang="la">Vincemus vera <lb xml:id="p1z7"/>fide, precibus et constantia omne malum.</s>
					<s n="6" xml:lang="la">De <lb xml:id="p1z8"/>concilio ne verbum quidem audio.</s>
					<s n="7" xml:lang="la">Bellum <lb xml:id="p1z9"/>in <placeName ref="l834">Italia</placeName> gliscit; papa <placeName ref="l832">Gallo</placeName> irascitu<lb xml:id="p1z10"/>r impotentissime; feliciter enim ce<lb xml:id="p1z11"/>dunt res <placeName ref="l832">Galli</placeName>.</s>
					<s n="8" xml:lang="la"><placeName ref="l2510">Turcica</placeName> classis dicitur <lb xml:id="p1z12"/>navigasse in <placeName ref="l2549">Aphricam</placeName>; in <placeName ref="l2721">Pannoniam</placeName> <lb xml:id="p1z13"/>dicuntur venisse equi <placeName ref="l2510">Turcici</placeName> 60000.</s>
					<s n="9" xml:lang="la">Cer<lb xml:id="p1z14"/>te praesidia aliqua missa sunt in <placeName ref="l850">Austriam</placeName>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/>Ita omnia sese componunt, ut colligam multa <lb xml:id="p1z16"/>mala imminere nostris cervicibus.</s>
					<s n="11" xml:lang="la">Pugnantibus <lb xml:id="p1z17"/>vera fide non deerit dominus.</s>
					<s n="12" xml:lang="la" ana="farewell">In <lb xml:id="p1z18"/>hoc vale aeternum; non potui plura <lb xml:id="p1z19"/>oppressus hominum accedentium et abeuntium tur<lb xml:id="p1z20"/>ba.</s>
					<s n="13" xml:lang="la"><persName ref="p18538">Caesar</persName> in hoc totus <lb xml:id="p1z22"/>est, ut excindat doctrinam evangelii; iam <lb xml:id="p1z23"/>exilio pugnat, mox gladio pugnabit etc.</s>
					<s n="14" xml:lang="la" ana="farewell"><lb xml:id="p1z24"/>Vale iterum.</s>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 13. septembris 1551.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z25"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p8418">Osvaldo Myconio</persName>, <lb xml:id="p2z3"/><placeName ref="l28">Basiliensis</placeName> ecclesiae <lb xml:id="p2z4"/>fideli antistiti, domino <lb xml:id="p2z5"/>venerando et <lb xml:id="p2z6"/>fratri charissimo.</s>
					<s n="18" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
