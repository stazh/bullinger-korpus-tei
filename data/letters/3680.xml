			<zone xml:id="p2z36-0" points="2280,2849 2386,2864 2437,2858 2522,2896 2575,2878 2572,2793 2546,2784 2510,2817 2463,2808 2407,2823 2354,2811 2339,2823 2328,2811 2310,2820 2280,2811">2298,2844 2323,2842 2349,2841 2374,2843 2400,2845 2425,2847 2451,2848 2476,2850 2502,2852 2527,2853 2553,2851 2579,2850</zone>
