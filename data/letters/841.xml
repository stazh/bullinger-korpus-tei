	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Oblatam scribendi occasionem, compater <lb xml:id="p1z2"/>in domino charissime, negligere nolui, licet <lb xml:id="p1z3"/>nihil sit, quod necessario scribam.</s>
					<s n="3" xml:lang="la">Per gratiam <lb xml:id="p1z4"/>domini salvi sumus adhuc omnes, nec <lb xml:id="p1z5"/>est aliquid incommodi, quo domus mea gravetur, <lb xml:id="p1z6"/>nisi quod uxor desyderium filię <lb xml:id="p1z7"/>ad dominum praemissę ponere nescit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Spero <lb xml:id="p1z8"/>tamen et hoc, quicquid est incommodi, <lb xml:id="p1z9"/>temporis beneficio si non prorsus tollendum, <lb xml:id="p1z10"/>aliquo tamen usque mitigandum.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Quod vestri d. <persName ref="p8018">Ioannem Hallerum</persName>, compatrem nostrum, <lb xml:id="p1z12"/>huic ecclesię permiserunt, factum est et <lb xml:id="p1z13"/>dignum commendatione et, ut spero, <lb xml:id="p1z14"/>ecclesię admodum conducibile.</s>
					<s n="6" xml:lang="la">Quod <lb xml:id="p1z15"/>res meas concernit, expecto, quomodo <lb xml:id="p1z16"/><placeName ref="l41">Bernates</placeName> necessitatis meę sint habituri rat<lb xml:id="p1z17"/>ionem.</s>
					<s n="7" xml:lang="la">Quinquaginta florenos interea, <lb xml:id="p1z18"/>dum hic <placeName ref="l41">Bernę</placeName> dego, misit ad me <persName ref="p5213">Herv<lb xml:id="p1z19"/>agius</persName>, tyopgraphus <placeName ref="l28">Basiliensis</placeName>, quos omnes <lb xml:id="p1z20"/>ultra <placeName ref="l41">Bernense</placeName> stipendium insumpsi et <lb xml:id="p1z21"/>praeterea nonnullos de reliqua substantię <lb xml:id="p1z22"/>meę summa.</s>
					<s n="8" xml:lang="de">Wa nit ein insehen <lb xml:id="p1z23"/>beschicht, so würdt es mir bald ußzündt <lb xml:id="p1z24"/>haben.</s>
					<s n="9" xml:lang="la">Spero d. <persName ref="p1453">Hallerum</persName> post suę <lb xml:id="p1z25"/>expeditionem etiam meae caussae rationem <lb xml:id="p1z26"/>habiturum.</s>
					<s n="10" xml:lang="la">Quodsi ille me neglexerit, <lb xml:id="p1z27"/>dominus tamen non negliget.</s>
					<s n="11" xml:lang="la">Haec est spes <lb xml:id="p1z28"/>mea.</s>
					<s n="12" xml:lang="la">De <placeName ref="l491">Argentinensibus</placeName> audio tristia.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z29"/>Rumor hic spargitur in die purificationis <lb xml:id="p1z30"/>spiritus illos immundos olim virtute <lb xml:id="p1z31"/>verbi Christi eiectos in domum scopis <lb xml:id="p1z32"/>purgatam denuo esse receptos.</s>
					<s n="14" xml:lang="la">Quodsi <lb xml:id="p1z33"/>certi aliquid habes, obsecro, communica.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z34"/><placeName ref="l18">Augustani</placeName> d. <persName ref="p2449">Claudium Peutingerum</persName> <placeName ref="l425">Romam</placeName> <lb xml:id="p1z35"/>ad episcopum <placeName ref="l18">Augustanum</placeName> miserunt.</s>
					<s n="16" xml:lang="la">Quid senatus <lb xml:id="p1z36"/>parturiat, post reditum legatorum, quos <lb xml:id="p1z37"/>ad <persName ref="p18538">Caesarem</persName> anno praeterito miserunt, nescitur quidem, <lb xml:id="p1z38"/>verum propediem manifestabitur.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Servet dominus ecclesiam <lb xml:id="p1z39"/>suam.</s>
					<s n="18" xml:lang="la" ana="farewell">Optime vale, compater charissime, cum reliquis dominis <lb xml:id="p1z40"/>ac fratribus.</s>
					<s n="19" xml:lang="la" ana="salute">Salutem toti domui tuę meo ac meorum nomine.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z41"/><placeName ref="l41">Bernę</placeName> 16. februarii 1550.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><persName ref="p8417">W[olfgangus] Musculus</persName>, com<lb xml:id="p1z42"/>pater tuus in domino.</s>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo theologo <lb xml:id="p2z2"/>m. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z4"/>ecclesię pastori <lb xml:id="p2z5"/>fidelissimo, compatri <lb xml:id="p2z6"/>in Christo charissimo.</s>
				</p>
				<p>
					<s n="23" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
