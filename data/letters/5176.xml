	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Libentissime multis ad te scri<lb xml:id="p1z2"/>berem, sed non possum.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Hoc unum peto, ut, <lb xml:id="p1z3"/>quacunque ratione possis, agas cum vicinis <placeName ref="l1107">Tri<lb xml:id="p1z4"/>dentino</placeName> concilio, ut, quid ibi fiat, explorent <lb xml:id="p1z5"/>et diligenter ad te scribant, tu ad me.</s>
					<s n="4" xml:lang="de"><lb xml:id="p1z6"/>Wie könnend die onmechtigen <placeName>Welschen</placeName> so <lb xml:id="p1z7"/>fuul, unsorgsam und so untrüw sin!</s>
					<s n="5" xml:lang="de">Tribend <lb xml:id="p1z8"/>sy oder sagend, ir wöllind inen nüt me <lb xml:id="p1z9"/>mitteylen.</s>
					<s n="6" xml:lang="la">Affini tuo dedi ultima, quae <lb xml:id="p1z10"/>accepi, describenda tibi.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Breviter: intelligo <lb xml:id="p1z11"/>ex literis <persName ref="p540">Calvini</persName> rem esse in discrimine, <lb xml:id="p1z12"/>eo quod <persName>Navarrenus</persName> parum sit firmus<note type="misc">Vgl. Die Wickiana, hg. v. <persName>Matthias Senn</persName>, 1975, S. 85 (Erwähnung der Mitteilung <persName ref="p540">Calvins</persName>)!</note>.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Sed dominus servabit nos et suam ecclesiam.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z14"/>Literas, quas paulo ante accepi, hic mitto, ne <lb xml:id="p1z15"/>quid ignores et non habeas, quod ego habeo; <lb xml:id="p1z16"/>sed ad proximum mercatum remitte <lb xml:id="p1z17"/>haec.</s>
					<s n="10" xml:lang="la" ana="farewell">Optime vale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Plura essent scri<lb xml:id="p1z18"/>benda; sed dixi: non possum.</s>
					<s n="12" xml:lang="de">Drü bistumb, <lb xml:id="p1z19"/><placeName ref="l303">Magdenburg</placeName>, <placeName ref="l1430">Hall</placeName> und <placeName ref="l1681">Merseburg</placeName> habend <lb xml:id="p1z20"/>das bapstumb hingeworffen, ouch bischoff und <lb xml:id="p1z21"/>thumcapittel; <foreign xml:lang="la">certissimum hoc.</foreign></s>
					<s n="13" xml:lang="de">Bischoff <lb xml:id="p1z22"/>und capittel sind evangelisch worden, habend <lb xml:id="p1z23"/>reformiert.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 20. februarii 1562.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z24"/>Tuus, qui semper.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z25"/>Saluta, quos nosti, d. consules, <lb xml:id="p1z26"/><persName>Philippum</persName>, <persName ref="p6130">Pontisellam</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse S. 378:]</note>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p4z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p4z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p4z3"/>ecclesiae ministro fideli, <lb xml:id="p4z4"/>domino et fratri suo <lb xml:id="p4z5"/>colendo et percharo.</s>
					<s n="19" xml:lang="la"><lb xml:id="p4z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
