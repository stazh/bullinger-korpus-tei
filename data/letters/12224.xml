	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia et pax a domino et salvatore nostro Iesu Christo.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Tametsi <lb xml:id="p1z2"/>valde sum<note xml:id="fna" type="footnote" n="a"><hi>In der Vorlage</hi> suum.</note> turbatus a morbo filiole<note xml:id="fn1" type="footnote" n="1">Unbekannt.</note> capitali, quo laborat, <lb xml:id="p1z3"/>et uxoris<note xml:id="fn2" type="footnote" n="2">Unbekannt.</note> absentia, quae iam thermis se pristinam valetudinem <lb xml:id="p1z4"/>recuperaturam sperat, quę et illi graviter labefacta <lb xml:id="p1z5"/>fuit, ut praeteream<note xml:id="fnb" type="footnote" n="b"><hi>In der Vorlage</hi> praeteram.</note> alia, quę et privatim et publice <lb xml:id="p1z6"/>me impugnant, non tamen committere volui, ut his <lb xml:id="p1z7"/>nuncius<note xml:id="fn3" type="footnote" n="3">Unbekannt.</note> vacuus ad te rediret, ne suspiceris <lb xml:id="p1z8"/>mentem meam mutatam.</s>
					<s n="3" xml:lang="la">Dolet, quod me tam <lb xml:id="p1z9"/>inconstantem et leviculum verearis<note xml:id="fnc" type="footnote" n="c">verearis <hi>nach gestrichenem</hi> suspi[caris].</note>.<note xml:id="fn4" type="footnote" n="4">Vgl. oben <ref target="file12182">Nr. 2135</ref>, 4f. - <persName ref="p495">Bullinger</persName> hat vielleicht dem schweigenden <persName ref="p3700">Rümlang</persName> noch einen weiteren Brief nach dem 14. April geschrieben, in dem er dessen Standhaftigkeit ausdrücklich bezweifelte.</note></s>
					<s n="4" xml:lang="la">Utcunque me<note xml:id="fnd" type="footnote" n="d"><hi>In der Vorlage</hi> ne.</note> <lb xml:id="p1z10"/>satan cribrat,<note xml:id="fn5" type="footnote" n="5">Vgl. <cit type="bible"><ref>Lk 22, 31</ref></cit>.</note> dominus tamen, fulcrum meum, me <lb xml:id="p1z11"/>sustentat.<pb type="edition" next="359"/></s>
				</p>
				<p>
					<s n="5" xml:lang="la">Propemodum sopita est apud nos <lb xml:id="p1z12"/>disceptatio sacramentaria,<note xml:id="fn6" type="footnote" n="6">Vgl. schon oben <ref target="file12108">Nr. 2061</ref>, 9f.</note> ut, qua parum promoverunt, <lb xml:id="p1z13"/>obtecte tantum loquantur, ut non nisi acuti capiant.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>At alia via ceremonias urgent et Lutheranismum <lb xml:id="p1z15"/>obnubilant<note xml:id="fn7" type="footnote" n="7">Sie befürworteten nämlich die Austeilung des Abendmahls an Kranke und Sterbende in deren Häusern; s. oben <ref target="file12129">Nr. 2082</ref>,5-20; <bibl source="b319">Hundeshagen</bibl> 196f. 387-389 (hier die ent sprechende Stelle aus Stettlers Berner Chronik).</note>.</s>
					<s n="7" xml:lang="la">Sed dolus deprehenditur, ut confidam <lb xml:id="p1z16"/>ipsos succubituros.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Senatus minor in duas partes <lb xml:id="p1z17"/>dissectus, si de hoc negotio quid tractandum sit.</s>
					<s n="9" xml:lang="la">Ideo <lb xml:id="p1z18"/>suspendunt ea<note xml:id="fne" type="footnote" n="e">ea <hi>über der Zeile nachgetragen.</hi></note> et sese mutuo timent, nam adversus <lb xml:id="p1z19"/>se invicem excandescunt.</s>
					<s n="10" xml:lang="la">Ideo et de vestro libello<note xml:id="fn8" type="footnote" n="8">Die Antwort der Zürcher auf <persName ref="p1974">Luthers</persName> "Kurtz bekentnis"; s. oben <ref target="file12108">Nr. 2061</ref>, Anm. 9.</note> <lb xml:id="p1z20"/>tacetur et nihil rescribitur,<note xml:id="fn9" type="footnote" n="9">Vgl. oben <ref target="file12182">Nr. 2135</ref>.</note> tametsi a plurimis ematur <lb xml:id="p1z21"/>et legatur; et placeat plurimum.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Salutabis omnes <lb xml:id="p1z22"/>bonos amicos, quibus me commendabis ubique inprimis.</s>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z23"/>Vale optime.</s>
					<s n="13" xml:lang="la">Datum raptim, 12. iunii <lb xml:id="p1z25"/>anno 1545.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z26"/>Tuus <persName ref="p3700">Eber. a Rumlang</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vigilantissimo fidelissimo<lb xml:id="p2z2"/>que viro d. <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, pastori <lb xml:id="p2z4"/><placeName ref="l587">Tigurinę</placeName> ecclesię primario, <lb xml:id="p2z5"/>patrono suo semper obser<lb xml:id="p2z6"/>vando.</s>
				</p>
			</div>
		</body>
	</text>
