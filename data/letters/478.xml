	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Qui hasce tibi literas affert, colendis<lb xml:id="p1z2"/>sime mi <persName ref="p8418">Myconi</persName>, <placeName ref="l98">Curiensis</placeName> est puer.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Venerunt <lb xml:id="p1z3"/>ad me d. <persName ref="p3196">Tscharnerus</persName> et <persName>Herus</persName> oraruntque, <lb xml:id="p1z4"/>ut ipsum meis tibi literis commendarem.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Fuit apud vos <placeName ref="l28">Basileae</placeName>, sed in morbum (ita mihi <lb xml:id="p1z6"/>referunt) incidit et ideo discessit.</s>
					<s n="5" xml:lang="la">Si ergo <lb xml:id="p1z7"/>ita habet res et ipsum iuvare potes, oro, vel pro<lb xml:id="p1z8"/>pter me illi adsis.</s>
					<s n="6" xml:lang="la">Nihil est apud nos <lb xml:id="p1z9"/>admodum memorabile, quod te dignum scribam.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z10"/>Vale ergo.</s>
					<s n="8" xml:lang="la">A te expecto, quid habeas <lb xml:id="p1z11"/>ab <placeName ref="l491">Argentina</placeName> et <placeName ref="l20">Inferior<lb xml:id="p1z12"/>e Germania</placeName>.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/><placeName ref="l587">Tiguri</placeName> 29. Martii anno 1549.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p8418">Osvaldo My<lb xml:id="p2z2"/>conio</persName>, charissimo <lb xml:id="p2z3"/>fratri suo.</s>
					<s n="12" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
