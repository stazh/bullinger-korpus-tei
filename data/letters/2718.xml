			<zone xml:id="p4z3-0" points="1727,2311 1814,2296 1890,2339 1946,2313 2136,2335 2206,2310 2346,2343 2351,2229 2309,2247 2121,2166 2056,2205 1945,2209 1895,2185 1726,2237">1731,2263 1762,2263 1793,2263 1824,2263 1855,2263 1886,2264 1917,2266 1948,2263 1979,2265 2010,2267 2042,2269 2073,2269 2104,2269 2135,2269 2166,2269 2197,2269 2228,2269 2259,2269 2290,2269 2321,2269 2353,2269</zone>
