	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="de">Wüssend, eerender herr und gevatter, das uff <lb xml:id="p1z2"/>hütt dato dis brieffs dem h. <persName>Georg</persName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="de"><persName>Carl.</persName> ein schryben <lb xml:id="p1z3"/>zuͦ kommen von des bischoffs von <placeName ref="l257">Costentz</placeName> vogt <lb xml:id="p1z4"/>zuͦ <placeName ref="l1301">Merspurg</placeName>, dem <persName>Mätzler</persName>, synem vetteren, desse[n] <lb xml:id="p1z5"/>inhalt diser: er könne uff bestimpte zyt, wie <lb xml:id="p1z6"/>sy miteinander verlassen, zuͦ <placeName ref="l2582">Feldkirch</placeName> nit erschynen, <lb xml:id="p1z7"/>dan[n] er desse[n] von synem herrenn, dem bischoff, <lb xml:id="p1z8"/>khein erloubnuß gehaben möge, uß ursachen, <lb xml:id="p1z9"/>das unrüwige zyt vorhanden und der <lb xml:id="p1z10"/><placeName>Empser</placeName> handel sich wider rege, ouch zwey <lb xml:id="p1z11"/>regiment knächt söllind angenommen <lb xml:id="p1z12"/>werden, deren das ein zuͦ <placeName ref="l165">Füssen</placeName>, das a<lb xml:id="p1z13"/>nder zuͦ <placeName ref="l1294">Wyngarten</placeName> gemustert werde.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z14"/><persName>Carolus</persName> literis cum consule communicatis ad me <lb xml:id="p1z15"/>eas attulit; videntur autem hi milites cogi contra <placeName ref="l646">Glaronen<lb xml:id="p1z16"/>ses</placeName> <foreign xml:lang="de">im nammen und dienst der <placeName ref="l2448">5 Ort</placeName>, die<lb xml:id="p1z17"/>wyl der musterplatz uff des keisers boden etc.</foreign></s>
					<s n="5" xml:lang="la"><lb xml:id="p1z18"/>Siginificanda ergo haec duximus, ut enixius <lb xml:id="p1z19"/>vigiletis vestrique in eam rem accurate inquirant.</s>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z20"/>Vale, vir clarissime.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l98">Curię</placeName> 15. aprilis anno domini <lb xml:id="p1z21"/>1561.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Nosti <lb xml:id="p2z2"/>manum.</s>
				</p>
				<p>
					<s n="9" xml:lang="de">Dem eerwyrdigen, hochgelerten, <lb xml:id="p2z3"/>frommen und getrüwen <lb xml:id="p2z4"/>herren <persName ref="p495">Heinrych Bullingern</persName>, <lb xml:id="p2z5"/>vorstender der kilchen <placeName ref="l587">Zü<lb xml:id="p2z6"/>rych</placeName>, synem eerenden, <lb xml:id="p2z7"/>günstigen herren ze ant<lb xml:id="p2z8"/>worten.</s>
					<s n="10" xml:lang="de"><lb xml:id="p2z9"/><placeName ref="l587">Zürych</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
