	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p495">Henrico Bullingero</persName>, viro vere Christiano, apud <placeName ref="l587">Tigurinos</placeName> verbi divini tub<lb xml:id="p1z2"/>icini strenuo et ministro Christi fideli.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Salutem et pacem in Domino.</s>
					<s n="3" xml:lang="la">Quae scripsisti, vir clarissime, ac<lb xml:id="p1z3"/>cepi et legi, nec est, ut tu studiosorum nomine mihi gratias referas pro laboribus me<lb xml:id="p1z4"/>is, cum potius ego et omnes studiosi tibi plurimum <lb xml:id="p1z5"/>debeamus, qui meum laborem tuis scriptis usque <lb xml:id="p1z6"/>adeo exornaris.</s>
					<s n="4" xml:lang="la">Placet supra modum diligentia <lb xml:id="p1z7"/>tua et prologus ille tuus theologicus, quem ego <lb xml:id="p1z8"/>nunquam ex ingenii mei officina tanta cudere po<lb xml:id="p1z9"/>tuissem industria.</s>
					<s n="5" xml:lang="la">Agnosco hic nolim velim ingeni<lb xml:id="p1z10"/>i mei tarditatem, immo obtusitatem, et rur<lb xml:id="p1z11"/>sum suspicio dona tibi et multis aliis vere Christi<lb xml:id="p1z12"/>anis viris a largitore omnium bonorum concessa, <lb xml:id="p1z13"/>tantum abest, ut haec exigua, quae desursum accepi, in ment<lb xml:id="p1z14"/>is efferant elationem.</s>
					<s n="6" xml:lang="la">Timeo, ne favore quodam <lb xml:id="p1z15"/>ingenuo propensior fueris in laudem meam quam <lb xml:id="p1z16"/>debueras, cum doctiores quique, qui hic inveniuntur <lb xml:id="p1z17"/>et pro magnis in theologia suspiciuntur, malint <lb xml:id="p1z18"/>operam meam, quam veteri testamento iuxta Hebraismum <lb xml:id="p1z19"/>vertendo adhibui, intermissam.</s>
					<s n="7" xml:lang="la">Irritat enim eos sermonis <lb xml:id="p1z20"/>et stili mei simplicitas offenditque indocta praesumptio, <lb xml:id="p1z21"/>sed iacta est alea.</s>
					<s n="8" xml:lang="la">Feci, quod potui, qui meliora <lb xml:id="p1z22"/>habent et maiora possunt, eructent, quae ipsi <lb xml:id="p1z23"/>acceperunt.</s>
					<s n="9" xml:lang="la">Non omnes omnia possumus.</s>
					<s n="10" xml:lang="la">Unus quidem <lb xml:id="p1z24"/>sic, alius autem sic, prout quisque a Domino accepit, <lb xml:id="p1z25"/>dispensatorem agit mysteriorum concreditorum.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z26"/>Praeter <persName ref="p6144">Ptolemaei</persName> Geographiam iam molior quoque Iudaei <lb xml:id="p1z27"/>et Christiani hominis in fide concertationem et iam quidem <lb xml:id="p1z28"/>duae chartae Hebraice impressae sunt inceptusque est libellus; <lb xml:id="p1z29"/>Dominus donet, ut pro gloria nominis sui ad finem usque <lb xml:id="p1z30"/>feliciter perducatur.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale Christi minister et adminis<lb xml:id="p1z31"/>trator fidelis.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l28">Basileae</placeName>, tertia Pas<pb/><lb xml:id="p2z1"/>c<lb xml:id="p2z2"/>ha<lb xml:id="p2z3"/>e<lb xml:id="p2z5"/>.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z6"/><persName ref="p2270">Sebast. Munsterus</persName></s>
				</p>
			</div>
		</body>
