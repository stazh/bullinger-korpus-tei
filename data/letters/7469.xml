	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literis d. <persName ref="p629">Cognetii</persName> pauca haec a<lb xml:id="p1z2"/>diunxi, <lb xml:id="p1z3"/>quibus me dei beneficio satis valere <lb xml:id="p1z4"/>scies et tibi plurimam salutem optare.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Hoc unum novi ad me scribitur <persName ref="p18212">reginam <lb xml:id="p1z6"/>Scotiae</persName> carcere, quo detinebatur, procerum <lb xml:id="p1z7"/>quorundam ope elapsam in satis munitum <lb xml:id="p1z8"/>oppidum profugisse atque illic auxilia expectare.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/><persName>Flandricus</persName> ille tumultus neque caput neque <lb xml:id="p1z10"/>pedes hactenus mihi quidem habere videtur; <lb xml:id="p1z11"/>vix tamen est, ut tam atra nebula impune <lb xml:id="p1z12"/>abeat.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="6" xml:lang="la" ana="salute">Dominus <persName ref="p8011">Gvalterus</persName> <lb xml:id="p1z13"/>hic sibi plurimam salutem ascriptam sciet<lb xml:id="p1z14"/>.</s>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z15"/>Iterum vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l760">Soloduro</placeName> 27. mayi 1568.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>Tuus ex animo <persName ref="p8160">P[om<lb xml:id="p1z17"/>ponne] <lb xml:id="p1z18"/>Bellieure</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro <lb xml:id="p4z2"/>d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p4z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p4z4"/>pastori.</s>
				</p>
			</div>
		</body>
	</text>
