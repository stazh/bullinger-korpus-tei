	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hac hora literae mihi a publico tabellione urbis nostrae et ex <placeName ref="l513">Ulma</placeName> et <placeName ref="l18">Augus<lb xml:id="p1z2"/>ta</placeName> allatae sunt, quas recentes et, ut primum relegi, commodum <lb xml:id="p1z3"/>oblato nuncio ad te perferendas curavi.</s>
					<s n="3" xml:lang="la">Misissem typis excusum librum <lb xml:id="p1z4"/>Interimnum (ut eum vocat <persName ref="p1055">Frechtus</persName>), nisi scirem descriptum tibi ad <lb xml:id="p1z5"/>manum esse.</s>
					<s n="4" xml:lang="la">Cura solum, ne Sayleri nostri nomen prodatur.</s>
					<s n="5" xml:lang="la">Habes et <lb xml:id="p1z6"/>e Lindavia missas ad quendam nostratem literas, in quibus, quas artes <lb xml:id="p1z7"/>excerceat in miseras urbes <persName ref="p7706">Granvella</persName> cum filio cardinale <lb xml:id="p1z8"/><persName>Caesarei</persName> nominis praetextu, palam intelliges.</s>
					<s n="6" xml:lang="la">Sed et ex <persName>Sayleri</persName> literis <lb xml:id="p1z9"/>de <persName>Pauli</persName> pontificis animo cognosces, dolo et arte.</s>
					<s n="7" xml:lang="la">Dominus nos servet, <lb xml:id="p1z10"/>ut exemplum et authoramentum esse possimus multorum, qui spem u<lb xml:id="p1z11"/>nam et omnem in <placeName ref="l862">Helvetiae</placeName> salute collocant secundum Christum!</s>
					<s n="8" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z12"/><placeName ref="l473">Sangalli</placeName> ocyssime V. calendas Iunii anno MDXLVIII.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p8049">Ioachimus Vadianus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrycho Bullingero</persName>, <lb xml:id="p2z2"/>urbis <placeName ref="l587">Tigurinae</placeName> episcopo, suo.</s>
				</p>
			</div>
