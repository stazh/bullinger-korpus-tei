	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi literas tuas, clarissime <persName ref="p8432">Frideryche</persName>, ac o<lb xml:id="p1z2"/>stendi etiam amplissimo consuli, quae scribebas de 20000, <lb xml:id="p1z3"/>qui conscribi dicantur <placeName ref="l306">Mediolani</placeName>, forte <placeName ref="l1374">Tripolim</placeName> <lb xml:id="p1z4"/>ducendi.</s>
					<s n="3" xml:lang="la">Cupiunt illi audire, si quid certius, quo <lb xml:id="p1z5"/>ducendi sint, intellexeris; puto enim nobis Helvetiis <lb xml:id="p1z6"/>invigilandum rebus nostris diligenter, cum non de<lb xml:id="p1z7"/>sint, qui affirment nescio quas practicas contra <lb xml:id="p1z8"/>nos esse contextas.</s>
					<s n="4" xml:lang="la">Ex <placeName ref="l830">Anglia</placeName> audimus procedere <lb xml:id="p1z9"/>feliciter religionem, sed vereri multos, ne propter <lb xml:id="p1z10"/>vicinum bellum <placeName ref="l2524">Scoticum</placeName> inplicanda sit et <placeName ref="l830">Anglia</placeName>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Ex <placeName ref="l832">Gallia</placeName> nihildum certi habemus, quomodo composita <lb xml:id="p1z12"/>sit seditio a nescio quibus commota contra <placeName>Guysianos</placeName>.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Tu forte nunc certiora habes.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Valemus <lb xml:id="p1z14"/>hic recte satis et cupimus te, tuos et omnes ami<lb xml:id="p1z15"/>cos et fratres nostros recte valere.</s>
					<s n="8" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 4. maii 1560.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>Festinantissime scripsi, <lb xml:id="p1z18"/>quod tardius audiverim hunc <persName>Iordanem</persName> nostrum <lb xml:id="p1z19"/>adesse, quem tibi commendo.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p8432">Fride<lb xml:id="p2z2"/>rycho a Salice</persName>, com<lb xml:id="p2z3"/>missario com[itatus] <placeName ref="l93">Clavennensis</placeName> <lb xml:id="p2z4"/>amplissimo, domino <lb xml:id="p2z5"/>suo colendo et <lb xml:id="p2z6"/>fratri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
