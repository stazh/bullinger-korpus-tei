	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Sperabam omnino fratres hos mecum pransuros; sic enim licuisset <lb xml:id="p1z2"/>prolixius scribere.</s>
					<s n="3" xml:lang="la">Nunc hoc solum ad te, quod <placeName ref="l1048">Brandenburgensis</placeName> <lb xml:id="p1z3"/>domus cum Caesare agit sciscitata, num eius autoritate proscriptus <lb xml:id="p1z4"/><persName ref="p8371">Albertus</persName> sit et num idem <persName ref="p18538">Cesar</persName> punire constituat <persName ref="p20318">H[einricum] Brunsvicensem</persName>, quod contra pacis <lb xml:id="p1z5"/>legem 32 ordines imperii vexarit bello; id enim si ipse non faciat, <lb xml:id="p1z6"/>se esse curaturos ut fiat.</s>
					<s n="4" xml:lang="la">Conscribit militem <persName ref="p20318">Heinrichus</persName>, <lb xml:id="p1z7"/>sed non potest in unum colligere.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Conveniunt <placeName ref="l1048">Brandenburg[ens</placeName> s], <lb xml:id="p1z8"/><placeName ref="l749">Saxoniae</placeName> et <placeName ref="l213">Hassiae</placeName> principes <placeName ref="l337">Neoburgi</placeName>, ut <lb xml:id="p1z9"/>veterem inter se confoderationem renovent, inter se et alia tractaturi.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/><placeName ref="l18">Augustae</placeName> <persName ref="p18477">Ferdinandus</persName> cum sacrificis urgeat <foreign xml:lang="de">den lant<lb xml:id="p1z11"/>friden zuͦ <placeName ref="l157">Franckfurt</placeName></foreign> idem vellet et Caesar obtinere.</s>
					<s n="7" xml:lang="la">Contra <lb xml:id="p1z12"/>vero electores <placeName ref="l749">Saxoniae</placeName>, <placeName ref="l1048">Brandenburgensis</placeName>, <persName ref="p3590">Palatinus</persName> cum aliis compluribus <lb xml:id="p1z13"/><placeName ref="l1204">Pataviensia</placeName> pacta, quae nisi procedant, aliam consiliorum <lb xml:id="p1z14"/>suorum rationem inituros profitentur.</s>
					<s n="8" xml:lang="la">Itaque male sibi metuunt pfaffi, <lb xml:id="p1z15"/>eo quod pactis iis libera religionis professio aperte concedatur.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>Rogemus dominum, ut suorum animos augeat et confirmet <lb xml:id="p1z17"/>et nos misericorditer tueatur a malo.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale in domino, mi <lb xml:id="p1z18"/><persName ref="p495">Bullingere</persName> venerande, et <persName ref="p3099">Sulcerum</persName> perge amare et precibus iuvare.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/><placeName ref="l28">Basileae</placeName> ultima marcii anno 1555.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z20"/>T[uus] <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, domino <lb xml:id="p2z3"/>et fratri colendissimo <lb xml:id="p2z4"/>suo.</s>
				</p>
			</div>
		</body>
	</text>
