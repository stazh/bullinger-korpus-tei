	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Magis atque magis arridet nobis consilium <lb xml:id="p1z2"/>de mittendis legatis a vobis ad <persName ref="p1974">Lutherum</persName><note xml:id="fn1" type="footnote" n="1">Vgl. unten <ref target="file10769">Nr. 731</ref>, 64-67.</note>, neque iam <lb xml:id="p1z3"/>aliud volumus, quam ut maturetis hanc rem; vigilant <lb xml:id="p1z4"/>enim alii atque urgent conventum.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/><persName ref="p1974">Lutherus</persName> visus est <placeName ref="l491">Argentoratensibus</placeName> conventum <lb xml:id="p1z6"/>in principum et magistratuum arbitrium<note xml:id="fna" type="footnote" n="a"><hi>vor</hi> arbitrium <hi>gestrichenes</hi> conven aut.</note> <lb xml:id="p1z7"/>reiicere, sed persuasus est venire et adesse, etiam <lb xml:id="p1z8"/>si nolint civitates et principes manum addere auxiliatricem<note xml:id="fn2" type="footnote" n="2"><persName ref="p4079">Zwick</persName> bezieht sich auf <persName ref="p1974">Luthers</persName> Brief an die <placeName ref="l491">Straßburger</placeName> Geistlichen vom 27. November 1535 (s. oben <ref target="file10751">Nr. 713</ref>, Anm. 9).</note><lb xml:id="p1z9"/>.</s>
					<s n="4" xml:lang="la">Nos vero non dubitamus, quin<note xml:id="fnb" type="footnote" n="b"><hi>in der Vorlage</hi> quim.</note> maximam <lb xml:id="p1z10"/>invidiam simus conflaturi rei evangelicae, si <lb xml:id="p1z11"/>conemur vel invitis vel insciis potestatibus <lb xml:id="p1z12"/>convenire.</s>
					<s n="5" xml:lang="la">O quam strenue orandus est dominus, ne <lb xml:id="p1z13"/>nobis ipsis nos sinat!</s>
					<s n="6" xml:lang="la">Iterum atque iterum urgent <lb xml:id="p1z14"/><placeName ref="l491">Argentoratenses</placeName>, ne fugiatis congressum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z15"/>Vale, mi frater<note xml:id="fnc" type="footnote" n="c"><hi>nach</hi> frater <hi>gestrichenes</hi> raptim.</note>, cum omnibus fratribus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Datum <lb xml:id="p1z16"/>raptim 7. ianuarii <lb xml:id="p1z17"/>1536.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/>Hic mitto<note xml:id="fnd" type="footnote" n="d">Hic mitto <hi>am Rande nachgetragen.</hi></note> negotium boni illius fratris, qui iam biennio fere <lb xml:id="p1z19"/>carceri inclusus est <placeName ref="l1301">Merspurg</placeName><note xml:id="fn3" type="footnote" n="3">Vgl. <bibl source="b7">HBBW V</bibl>, S. 223, 32f mit Anm. 16.</note>, nec dubita, quin <lb xml:id="p1z20"/>ita sese res habeat.</s>
					<s n="10" xml:lang="la">Si quicquam excogitare potes <lb xml:id="p1z21"/>in consolationem captivi, fac, ut<note xml:id="fne" type="footnote" n="e"><hi>vor</hi> ut <hi>gestrichenes</hi> c.</note> tuam diligentiam <lb xml:id="p1z22"/>experiatur.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale cum tota domo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/>Tuus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tigurinae</placeName> eclesiae <lb xml:id="p2z3"/>ecclesiastae, fratri charissimo.</s>
				</p>
			</div>
