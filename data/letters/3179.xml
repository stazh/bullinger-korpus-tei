	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Qui hasce tuae offert humanitati liters, <lb xml:id="p1z2"/>optime compater, Regis <placeName ref="l832">Galliae</placeName> legatus est ad <placeName ref="l648">Rhaetos</placeName>.</s>
					<s n="3" xml:lang="la" ana="salute"><lb xml:id="p1z3"/>Postulavit a me commendari tibi.</s>
					<s n="4" xml:lang="la">Ego hoc ei <lb xml:id="p1z4"/>negare non potui.</s>
					<s n="5" xml:lang="la">Dicebam tamen ingenue: Min<lb xml:id="p1z5"/>istrum ecclesiae <placeName ref="l98">Curiensis</placeName> se non immiscere <lb xml:id="p1z6"/>negotiis regiis, neque huc meam illam commendationem <lb xml:id="p1z7"/>dirigendam, sed huc potius, ut intelligat, te <lb xml:id="p1z8"/>Christo et verae pietati favere et te regnum Christi <lb xml:id="p1z9"/>propagatum cupere ex animo, ut ea in re et in <lb xml:id="p1z10"/>ea causa misceatis frequentissima colloquia.</s>
					<s n="6" xml:lang="la" ana="salute">Salutavit <lb xml:id="p1z11"/>me hic ante annos quatuor.</s>
					<s n="7" xml:lang="la">Intellexi ex <placeName ref="l832">Gallis</placeName>, <lb xml:id="p1z12"/>hunc Regi esse carissimum et multa apud Regem posse, <lb xml:id="p1z13"/>multum item iuvare fideles: quum alioqui <lb xml:id="p1z14"/>potentissimus sit et magnae autoritatis apud Regem.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>D. <persName ref="p540">Ioannes Calvinus</persName> hunc mihi hisce commendavit verbis: <lb xml:id="p1z16"/>"Hunc tibi, mi <persName ref="p495">Bullingere</persName>, Regis ad <placeName ref="l648">Rhaetos</placeName> legatum <lb xml:id="p1z17"/>ita tibi commendo, ut de eius pietate et integritate <lb xml:id="p1z18"/>me sponsorem interponere audeam.</s>
					<s n="9" xml:lang="la">Tu igitur hominem <lb xml:id="p1z19"/>non secus ac unum ex nobis familiariter excipies.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/>Hoc quoque testimonium apud D. <persName ref="p8111">Petrum Martyrem</persName> et alios <lb xml:id="p1z21"/>fratres valere cupio.</s>
					<s n="11" xml:lang="la">Uxor viro similis absque fuco <lb xml:id="p1z22"/>pietatem colit.</s>
					<s n="12" xml:lang="la">Quidquid in eum humanitatis contuleris, <lb xml:id="p1z23"/>mihi acceptum feram.</s>
					<s n="13" xml:lang="la"><placeName ref="l167">Genevae</placeName> vi.</s>
					<s n="14" xml:lang="la">Maii 1557." Addit mox: <lb xml:id="p1z24"/>Fratres nostros <placeName ref="l98">Curienses</placeName> si de eius integritate certiores <lb xml:id="p1z25"/>feceris, talem futurum spero, ne te unquam huius <lb xml:id="p1z26"/>testimonii poeniteat.</s>
					<s n="15" xml:lang="la" ana="farewell">Iterum vale.</s>
					<s n="16" xml:lang="la">Haec <persName ref="p540">Calvinus</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z27"/>Sic ergo et tibi et D. <persName>Philippo</persName> hunc commendo, ut sitis <lb xml:id="p1z28"/>illi calcaria ad pietatem, et ut in hac pr<lb xml:id="p1z29"/>oficiat.</s>
					<s n="18" xml:lang="la">Communes has habebis cum nostro <persName>Philippo</persName>, quem <lb xml:id="p1z30"/>valere opto.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z31"/>Quum plus otii erit scribam <lb xml:id="p1z32"/>pluri.</s>
					<s n="20" xml:lang="la" ana="farewell">Interea valete, vestri semper memores <lb xml:id="p1z33"/>officii.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 13. Maii 1557.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z34"/><persName ref="p495">Bullingerus</persName> vester.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Prastantissimo viro D. <persName ref="p8009">Joanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>ministro, domino compatri et <lb xml:id="p2z4"/>fatricolendo et percharo, <lb xml:id="p2z5"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
