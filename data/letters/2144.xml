	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Non estis vestri, inquit apostolus, et ita <lb xml:id="p1z2"/>profecto est, <lb xml:id="p1z3"/>quamquam ego nunc ea verba <lb xml:id="p1z4"/>alio sensu accipio, nempe solere nos <lb xml:id="p1z5"/>cogitare: hoc faciam atque hoc, atque in<lb xml:id="p1z6"/>terim aliud cogimur.</s>
					<s n="2" xml:lang="la">Ego enim ad te <lb xml:id="p1z7"/>scripseram me postridie illius diei <lb xml:id="p1z8"/>iturum <placeName ref="l18">Augustam</placeName>, et sane parata <lb xml:id="p1z9"/>erant omnia; at ecce, noctu invadit <lb xml:id="p1z10"/>me rursus podagra, ut neque <lb xml:id="p1z11"/>lecto potuerim me dimovere.</s>
					<s n="3" xml:lang="la">Sic res <lb xml:id="p1z12"/>est; at rursus convalui.</s>
					<s n="4" xml:lang="la">Lucta haec <lb xml:id="p1z13"/>est; modo vinco, modo vincor, et <lb xml:id="p1z14"/>rursus me illi itineri accingo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Cras <lb xml:id="p1z15"/>tamen prius <placeName ref="l496">Stutgardium</placeName> eundum <lb xml:id="p1z16"/>mihi est; ita constitui, ut, antequam <lb xml:id="p1z17"/><placeName ref="l18">Augustam</placeName> eam, velim proprium <lb xml:id="p1z18"/>nuncium ad te.</s>
					<s n="6" xml:lang="la">Res principum <lb xml:id="p1z19"/>similes dixeris coelo, quod nunc vides <lb xml:id="p1z20"/>uno colore et paulo post alio.</s>
					<s n="7" xml:lang="la">Scripsi <lb xml:id="p1z21"/>non futura comitia; at mutata <lb xml:id="p1z22"/>est principum facies aut voluntas; <lb xml:id="p1z23"/>nunc arbitror futura.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><persName>Marchionis <lb xml:id="p1z24"/>Brandenburgensis</persName> causa transigenda est, ut multi <lb xml:id="p1z25"/>sperant.</s>
					<s n="9" xml:lang="la">Reliqua, quum nuncium <lb xml:id="p1z26"/>mittam.</s>
					<s n="10" xml:lang="la">Feceris mihi rem apprime <lb xml:id="p1z27"/>gratam, si scripseris ad eos duos, qu<lb xml:id="p1z28"/>os nosti, me scripsisse futura comitia et <lb xml:id="p1z29"/>brevi mis[s]urum ad te <pb/><lb xml:id="p2z1"/>nuncium et podagram retinuisse, <lb xml:id="p2z2"/>ne potuerim, quo destinaveram.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z3"/>Quum te scirem <persName ref="p8111">Martirem</persName> tantopere am<lb xml:id="p2z4"/>are, ego, qui hominem nunquam vidi (<lb xml:id="p2z5"/>certe in tuam gratiam, <persName ref="p495">Henrice Bullingere</persName>), <lb xml:id="p2z6"/>illum invitavi, ut apud me esset <lb xml:id="p2z7"/>per duos menses et quantum voluerit <lb xml:id="p2z8"/>amplius.</s>
					<s n="12" xml:lang="la">Accepit conditionem, <lb xml:id="p2z9"/>venturus est, et curabo, ut possit <lb xml:id="p2z10"/>locum habere in hac schola, quamquam <lb xml:id="p2z11"/>aliquid obstat, ut puto te praevidere.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z12"/>At experiar.</s>
					<s n="14" xml:lang="la">Quid enim tutum noctis?</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z13"/>Scripsi libellum Latine magna et seria de re, <lb xml:id="p2z14"/>nempe quo pacto respondere possimus<lb xml:id="p2z15"/>, <lb xml:id="p2z16"/>si agatur de concilio instaurando; <lb xml:id="p2z17"/>scio placere principi et suis.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z18"/>Expect tuam Iustificationem et <lb xml:id="p2z19"/>non unum tantum exemplar, <lb xml:id="p2z20"/>sed pro principe aliisque fratribus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z21"/>Noctu scribo; nuncius <persName ref="p1271">Lindavium</persName> has <lb xml:id="p2z22"/>feret; utinam solvas.</s>
					<s n="18" xml:lang="la">Mitte ad <lb xml:id="p2z23"/><persName>Gartarolum</persName> suas; sunt enim alicuius <lb xml:id="p2z24"/>momenti.</s>
					<s n="19" xml:lang="la" ana="farewell">Vale et salve cum <lb xml:id="p2z25"/>tota familia, schola atque ecclesia.</s>
					<s n="20" xml:lang="la"><lb xml:id="p2z26"/>D. Iesus benedicat vestris omnium <lb xml:id="p2z27"/>laboribus.</s>
					<s n="21" xml:lang="la">Amen.</s>
					<s n="22" xml:lang="la">Obsecro, commen<pb/><lb xml:id="p3z1"/>date me domino vestris precibus.</s>
					<s n="23" xml:lang="la"><persName ref="p458">Brentio</persName> <lb xml:id="p3z2"/>et <persName ref="p3375">Vergerio</persName> nihil est coniunctius, et certe <lb xml:id="p3z3"/>mira caritate (hoc possum toti orbi <lb xml:id="p3z4"/>testari) complectitur res meas.</s>
					<s n="24" xml:lang="la">Caritatem <lb xml:id="p3z5"/>quum video, divinitatem video <lb xml:id="p3z6"/>aut signum divinitatis; ita docet Christus.</s>
					<s n="25" xml:lang="la"><lb xml:id="p3z7"/>Quid me laetius, quum <persName ref="p8111">Martirem</persName> habebo <lb xml:id="p3z8"/>hospitem?</s>
					<s n="26" xml:lang="la">Spero autem me habiturum <lb xml:id="p3z9"/>intra 20 dies.</s>
				</p>
				<p>
					<s n="27" xml:lang="la">Mitto eius ad te <lb xml:id="p3z10"/>literas.</s>
					<s n="28" xml:lang="la"><persName ref="p2095">Melanthon</persName> adversus <persName ref="p8441">Svenckfeldium</persName> <lb xml:id="p3z11"/>nunc stilum acuit.</s>
					<s n="29" xml:lang="la">Reliqua (ut <lb xml:id="p3z12"/>dixi), quum nuncium misero.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><lb xml:id="p3z13"/><placeName ref="l512">Tubingae</placeName> kalen<lb xml:id="p3z14"/>dis ianuarii 1554.</s>
				</p>
				<p>
					<s n="31" xml:lang="la"><lb xml:id="p3z15"/><persName ref="p3375">Verg<lb xml:id="p3z16"/>erius</persName> totus, <lb xml:id="p3z17"/>totus tuus.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo pietate <lb xml:id="p4z2"/>et doctrina viro <lb xml:id="p4z3"/>d. <persName ref="p495">Henrico Bullingero</persName> <lb xml:id="p4z4"/>etc.</s>
				</p>
			</div>
		</body>
	</text>
