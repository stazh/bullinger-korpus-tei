	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Haec paucula ad te scribam, plura ubi plus ocii nactus fuero.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Princeps noster creatus est <placeName ref="l1956">Supholcia<lb xml:id="p1z3"/>e</placeName> <lb xml:id="p1z4"/>dux: pro certissimo est hesterna die mihi pollicitus, se <lb xml:id="p1z5"/>una cum filiabus suis intra mensem ad te scripturum.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/><persName ref="p591">Chekum</persName> regiae maiestatis institutorem hodie conveni; caeterum <lb xml:id="p1z7"/>plane de rebus tuis hominem alloqui non potui; iussus <lb xml:id="p1z8"/>sum itaque in crastinum redire.</s>
					<s n="5" xml:lang="la"><persName ref="p3067">Stumphius</persName> vero et <persName>Andreas</persName>, <lb xml:id="p1z9"/>iamiam navim conscensuri, faciunt ut ipse quoque <lb xml:id="p1z10"/>nihil ad te hoc tempore scribere queam.</s>
					<s n="6" xml:lang="la">Te oro atque <lb xml:id="p1z11"/>obtestor ut brevitati ignoscas; diligentia et studio <lb xml:id="p1z12"/>singulari omnia compensabo in posterum.</s>
					<s n="7" xml:lang="la">7. novemb. 1551.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Tuae amplitudinis studiosissimus, <persName ref="p20172">Iohannes ab Ulmis</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z14"/>Praecipue de sorore <persName ref="p3207">regis Angliae</persName> esse<lb xml:id="p1z15"/>s a me commone<lb xml:id="p1z16"/>faciendus diligentissime.</s>
					<s n="10" xml:lang="la">Verum ex <lb xml:id="p1z17"/><persName>Andrea</persName> hoc meo cuncta cognosces <lb xml:id="p1z18"/>et melius et rectius: itaque <lb xml:id="p1z19"/>ipsum percunctator.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Optimo et praestantissimo <lb xml:id="p2z2"/>viro <persName ref="p495">H. Bullingero</persName>, d. <lb xml:id="p2z3"/>suo colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
