			<graphic xml:id="img2-0" url="https://media.sources-online.org/cantaloupe/iiif/3/bullinger!6475!Autograph!01%20Ms%20F%2059%20%28331%29_00003.tif/full/max/0/default.jpg" height="5354px" width="3669px" n="2">
