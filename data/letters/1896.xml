			<zone xml:id="p4z5-0" points="1104,1067 1275,1077 1618,1033 1749,1090 1774,952 1366,1020 1319,978 1274,1009 1106,1030">1109,1062 1142,1059 1175,1057 1208,1056 1241,1055 1274,1051 1307,1048 1341,1046 1374,1044 1407,1041 1440,1037 1473,1034 1506,1032 1539,1030 1573,1029 1606,1027 1639,1023 1672,1023 1705,1023 1738,1024 1772,1026</zone>
			<zone xml:id="p4z6-0" points="1415,1384 1464,1405 1560,1354 1645,1384 1647,1309 1628,1304 1597,1315 1587,1306 1560,1317 1522,1301 1496,1317 1419,1310">1422,1357 1447,1357 1472,1357 1497,1355 1522,1354 1548,1352 1573,1350 1598,1348 1623,1348 1649,1348</zone>
