					<lb xml:id="p1z1"/>Würdiger, hoch und wolgelertt verthruwtt herr
					<lb xml:id="p1z2"/>Wot
					<lb xml:id="p1z3"/>annea.
					<lb xml:id="p1z4"/>und fründ. ich hab ewer schriben von
					<lb xml:id="p1z5"/>rrüzlich.
					<lb xml:id="p1z6"/>i
					<lb xml:id="p1z7"/>geliepten pfare von bax empfan
					<lb xml:id="p1z8"/>be.
					<lb xml:id="p1z9"/>sund.
					<lb xml:id="p1z10"/>von hertzen laeid, das ir
					<lb xml:id="p1z11"/>blmächt. Ich
					<lb xml:id="p1z12"/>des glichen der gethrüw
					<lb xml:id="p1z13"/>erckhn zuͦ
					<lb xml:id="p1z14"/>ig gott wil buch baid ergo
					<lb xml:id="p1z15"/>dern kews kan
					<lb xml:id="p1z16"/>siem lob. demnach welt ich
					<lb xml:id="p1z17"/>mpa
					<lb xml:id="p1z18"/>nüws zu schriben, so hab ich mit sonders den
					<lb xml:id="p1z19"/>ir alles beser wüsen häbend, den ich ir
					<lb xml:id="p1z20"/>144.
					<lb xml:id="p1z21"/>sonder was der künig uß Hispanien mit das
					<lb xml:id="p1z22"/>e
					<lb xml:id="p1z23"/>Fidgnosten im burgund machen well, ist
					<lb xml:id="p1z24"/>
					<lb xml:id="p1z25"/>mins achtens, lichtlich zuͦ beston der thruw
					<lb xml:id="p1z26"/>kürg.
					<lb xml:id="p1z27"/>vatter im himel well alle böse braticen
					<lb xml:id="p1z28"/>ich nag
					<lb xml:id="p1z29"/>wider sin wort und kilchen erdacht gnädigklin
					<lb xml:id="p1z30"/>zwegen
					<lb xml:id="p1z31"/>abwenden, demnach gli
					<lb xml:id="p1z32"/>epoer, dan
					<lb xml:id="p1z33"/>gott der allmachtig mir
					<lb xml:id="p1z34"/>fast üfflich
					<lb xml:id="p1z35"/>mit sinem gsind angrigen
					<lb xml:id="p1z36"/>hatt. hoff ist
					<lb xml:id="p1z37"/>gern, das er sich in die
					<lb xml:id="p1z38"/>zr urtel und villen
					<lb xml:id="p1z39"/>zu gott, er werde durch das
					<lb xml:id="p1z40"/>mittel gottes, destro furer zuͦ ainem glöbigen eynanen
					<lb xml:id="p1z41"/>menschen werden, do den ich euch fründtlichen wwatt
					<lb xml:id="p1z42"/>pitt ir wellem zum selben, hilff und anlab son zu
					<lb xml:id="p1z43"/>yebe, so vil müglich sey. Jetz last euch min liebe des patt
					<lb xml:id="p1z44"/>hußfrow und mir alle unser fründtlich gruͦts, sond
					<lb xml:id="p1z45"/>um alles guͦtz anzaigen undb
					<lb xml:id="p1z46"/>mpb
					<lb xml:id="p1z47"/>in den schurm gottes in il uß
					<lb xml:id="p1z48"/>Eb hurs
					<lb xml:id="p1z49"/>29. tag setole im 1568. jar.
