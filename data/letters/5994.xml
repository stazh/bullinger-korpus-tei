	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scribitur ad me <placeName ref="l1059">Belinzona</placeName> <placeName ref="l3326">Casalenses</placeName>, <lb xml:id="p1z2"/>quod iniustis exactionibus vexarentur, <lb xml:id="p1z3"/><placeName ref="l1060">Mantuani</placeName> imperium detrectasse, consternatis <lb xml:id="p1z4"/>itaque ad arma popularium animis militum <lb xml:id="p1z5"/>aliquam manum ex agris oppidisque vicinis <lb xml:id="p1z6"/>evocasse.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Prorex <placeName ref="l306">Mediolani</placeName> eo legatum misit <lb xml:id="p1z7"/><persName ref="p18258">Nicolaum Madruccium</persName>, qui rem omnem non <lb xml:id="p1z8"/>magno negotio composuit, ut scilicet <placeName ref="l3326">Casalensibus</placeName> <lb xml:id="p1z9"/>sua privilegia intacta illibataque bona fide conserventur, <placeName ref="l3326">C<lb xml:id="p1z10"/>asalenses</placeName> <placeName ref="l1060">Mantuano</placeName> fidem suam rursus obstringant <lb xml:id="p1z11"/>neve eis ullum telum domi habere liceat praeter <lb xml:id="p1z12"/>gladium viatorium.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Papa dicebatur sex millia <lb xml:id="p1z13"/>peditum in agro <placeName ref="l306">Mediolanensi</placeName> conscripturus; <lb xml:id="p1z14"/>sed id negotium frigide administrari scribitur.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Nihil praeterea; literae Italice erant scriptae, <lb xml:id="p1z16"/>iccirco non<note type="margin">a.R.: wiederholt / verschr. f. nunc?</note> mitto.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">In <placeName ref="l648">Rhetis</placeName> omnia <lb xml:id="p1z17"/>satis pacata, et in dies melius speratur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z19"/>Bene vale, vir praestantissime.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z20"/>Tuus ex animo <persName ref="p8160">P[omponne] Bel<lb xml:id="p1z21"/>lievre</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
