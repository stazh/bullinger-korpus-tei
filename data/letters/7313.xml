	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi heri sub noctem tuas, quibus mihi obitum <lb xml:id="p1z2"/>praestantissimi consulis vestri <persName>Mülleri</persName> significas, deploran<lb xml:id="p1z3"/>dum sane non vestrae modo reipublicae, sed piis bonisque omnibus.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Valde itaque eo nuncio perculsus sum; oro autem dominum, ut <lb xml:id="p1z5"/>pro <lb xml:id="p1z6"/>ipso <lb xml:id="p1z7"/>vobis det alium non minus pium et prudentem, quamvis <lb xml:id="p1z8"/>sciam, quam raro tales contingant et quam exiguum vos quoque <lb xml:id="p1z9"/>talium habeatis numerum.</s>
					<s n="4" xml:lang="la">Hodie affert mihi hic <persName ref="p4502">I<lb xml:id="p1z10"/>oachimi Camerarii</persName> filius<note xml:id="fn1" type="footnote" n="1">Der Botaniker <persName ref="p4502">Joachim Camerarius d.J.</persName>? Dieser war ein Freund Gessners; s. G. Rath, Briefe G's ...).</note> literas a <persName ref="p8033">Beza</persName>, et quoniam mihi <lb xml:id="p1z11"/>potestatem fecit aperiendi eas, quas ad te scripsit, reseravi <lb xml:id="p1z12"/>eas et legi, et quoniam illae continent omnia, <lb xml:id="p1z13"/>de quibus ego scribere poteram, non est, ut ipse sim pro<lb xml:id="p1z14"/>lixior.</s>
					<s n="5" xml:lang="la" ana="farewell">Bene itaque vale.</s>
					<s n="6" xml:lang="la">Dominus te servet et ecclesię s<lb xml:id="p1z15"/>uę supra modum periclitanti clementer succurrat!</s>
					<s n="7" xml:lang="la">De conflictu <lb xml:id="p1z16"/>illo <placeName ref="l378">Lutetiano</placeName> legatus regius <placeName ref="l760">Salodoro</placeName> senatui nostro <lb xml:id="p1z17"/>magnifice et thrasonice admodum scripsit <placeName>Condensem</placeName> <lb xml:id="p1z18"/>esse profligatum, amisisse maximas copias, conestabilem <lb xml:id="p1z19"/>esse quidem occisum, sed ex <placeName ref="l862">Helvetiis</placeName>, qui strenue se <lb xml:id="p1z20"/>gesserint, ne unum quidem occubuisse.</s>
					<s n="8" xml:lang="la">Sed ut fides istius <lb xml:id="p1z21"/>literis non est habita, ita veriora sunt, quę nunc ex <persName ref="p8033">Bezae</persName> <lb xml:id="p1z22"/>literis intelliges.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Bene iterum vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l41">Bernae</placeName> penultima <lb xml:id="p1z23"/>novembris 1567.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><persName ref="p8018">I[oha<lb xml:id="p1z24"/>nnes] Hall[erus</persName>] tuus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo doctissimoque viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori <lb xml:id="p2z4"/>fidelissimo, domino meo ho<lb xml:id="p2z5"/>norando et compatri charis<lb xml:id="p2z6"/>simo.</s>
				</p>
			</div>
		</body>
