	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>vertuuwer ser die ursech, das ehie bis
					<lb xml:id="p1z2"/>ber ist, das mich dar ser beschriben
					<lb xml:id="p1z3"/>und mir an zaigt, de sy berichte
					<lb xml:id="p1z4"/>wie des küngs wider penig vil
					<lb xml:id="p1z5"/>versaben siend etttig volch
					<lb xml:id="p1z6"/>Erff in bringen in, dem ich mic
					<lb xml:id="p1z7"/>aus selee begeben. da bitt en
					<lb xml:id="p1z8"/>nich, das ich ins bungs denst
					<lb xml:id="p1z9"/>abr und mich nitt, wi der in
					<lb xml:id="p1z10"/>gewegen las uff solis sob
					<lb xml:id="p1z11"/>gdantwurter, s wur mirt da
					<lb xml:id="p1z12"/>vem sin mir ein fronden, och
					<lb xml:id="p1z13"/>wie war as gbas, e pets abser
					<lb xml:id="p1z14"/>t nitt kbiegesch sa, da syy die
					<lb xml:id="p1z15"/>ueseth, das ich wider min w
					<lb xml:id="p1z16"/>üsse gang nitt kriegen woll
					<lb xml:id="p1z17"/>26 Berceste deb
					<lb xml:id="p1z18"/>solchami isti
					<lb xml:id="p1z19"/>sabh ban, als minem
					<lb xml:id="p1z20"/>schrewerten, lieben frund nitt
					<lb xml:id="p1z21"/>sunden von halten gott er
					<lb xml:id="p1z22"/>Sale a in i
					<lb xml:id="p1z23"/>Fründ.
					<lb xml:id="p1z24"/>S.
					<lb xml:id="p1z25"/>S.
					<lb xml:id="p1z26"/>T
					<lb xml:id="p1z27"/>.
				</p>
			</div>
		</body>
