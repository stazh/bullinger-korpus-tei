	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hodie ante horas aliquot ad te scripsi per proprium <lb xml:id="p1z2"/>nuncium.</s>
					<s n="3" xml:lang="la">Oblitus sum, quod nihil scripserim de <persName ref="p540">Calvini</persName> <lb xml:id="p1z3"/>propositionibus tuis annotationibus illustratis.</s>
					<s n="4" xml:lang="la">Redditae <lb xml:id="p1z4"/>sunt illae mihi.</s>
					<s n="5" xml:lang="la" ana="salute">Fasciculum literarum <placeName ref="l167">Genevam</placeName> misi per <lb xml:id="p1z5"/>D. <persName ref="p8031">Beatum Comitem</persName>, qui te et <persName ref="p8011">Gvaltherum</persName> plurimum salutat.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/>Ipsas propositiones, ut <persName ref="p8011">Gvaltherus</persName> descripsit, legerunt fratres <lb xml:id="p1z7"/>omnes, ego iam mihi per puerum describi curo, quo nondum <lb xml:id="p1z8"/>absolvit; alioqui per hunc nuncium remisissem, remittam <lb xml:id="p1z9"/>per proximum tamen.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Vale denuo.</s>
					<s n="8" xml:lang="la" ana="salute">Salutant te D. <persName ref="p1804">Iodocus</persName>, <lb xml:id="p1z10"/><persName ref="p3700">Eberardus</persName>, <persName ref="p8467">Textor</persName> et <persName ref="p3494">Nicolaus</persName>, qui heri domum reversus <lb xml:id="p1z11"/>est.</s>
					<s n="9" xml:lang="la">Quae de <persName ref="p5072">Sebastiano Guldibecio</persName> scribis, conferam <lb xml:id="p1z12"/>cum scholarchis et tentabo illum quoque privatim; est <lb xml:id="p1z13"/>homo in linguis exercitatus, tamen, sicut scis, nimium <lb xml:id="p1z14"/>sordidus; sed haec ferenda, quatenus mutari non possunt.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/>Ambit etiam hanc conditionem <persName ref="p20823">Ioannes Ferus</persName>, qui <placeName ref="l441">Scaphusiae</placeName> <lb xml:id="p1z16"/>scholam multis annis rexit, nunc autem pastorem agit in <lb xml:id="p1z17"/>agro nostro; nescio, an tibi sit notus, <placeName ref="l28">Basileae</placeName> <persName>Erasmi</persName> <lb xml:id="p1z18"/>stipendio diu vixit.</s>
					<s n="11" xml:lang="la">Ego illum <placeName ref="l18">Augustae</placeName> vidi, et notus est <lb xml:id="p1z19"/>mihi, quamvis etiam in illo habeam, quod desiderem.</s>
					<s n="12" xml:lang="la"><persName ref="p8384">Hospinianus</persName>, <lb xml:id="p1z20"/>qui <placeName ref="l69">Brugis</placeName> est, est homo bonus, sed disciplinae scholasticae <lb xml:id="p1z21"/>negligens exequutor neque etiam in grammaticis exercitatus; legit <lb xml:id="p1z22"/>multos insignes authores, sine tamen grammatices exercitio, <lb xml:id="p1z23"/>id quod pueris valde nocivum est.</s>
					<s n="13" xml:lang="la">De illo <persName ref="p8384">Hospiniano</persName>, qui <lb xml:id="p1z24"/><placeName ref="l28">Basileae</placeName> profitetur, recte scribis; videtur etiam mihi talis.</s>
					<s n="14" xml:lang="la">Ut <persName ref="p8173">Xystus</persName> <lb xml:id="p1z25"/>vocetur, vix effecero; causas ipse per te cognoscere potes.</s>
					<s n="15" xml:lang="la">Deligendus <lb xml:id="p1z26"/>erit ex omnibus unus; utinam deligatur optimus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell">Denuo vale.</s>
					<s n="17" xml:lang="la">24. Octobris.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><persName ref="p8018">I[oannes] H[a<lb xml:id="p1z27"/>llerus</persName>]</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Fidelissimo Iesu Christi <lb xml:id="p2z2"/>servo D. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, domino et <lb xml:id="p2z4"/>compatri suo unice <lb xml:id="p2z5"/>observando.</s>
					<s n="20" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
