	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Cum pridie ad te scripserim copiosius, <lb xml:id="p1z2"/>colendissime pater, nunc nihil habeo, quod scribam, <lb xml:id="p1z3"/>nisis quod <persName>Valentino Mentzero</persName> hanc tradas <lb xml:id="p1z4"/>cautionem, quam ipsi quoque a dominis impetravi, <lb xml:id="p1z5"/>ut liber a vectigalibus cum sua suppellectile ad <lb xml:id="p1z6"/>ecclesiam suae fidei commissam proficisci queat.</s>
					<s n="3" xml:lang="la" ana="farewell">Vale.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Dominus Iesus te diu servet incolumem cum <lb xml:id="p1z8"/>omnibus tuis.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Cal[endis] Sept[embris] 1548.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><persName ref="p8018">I[ohannes] Hallerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt (weggeschnitten):]</note>
				</p>
			</div>
		</body>
	</text>
