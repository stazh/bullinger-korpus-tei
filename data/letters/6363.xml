	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">S. si vales, clarissime ac reverendissime pater, bene est; ego quidem valeo.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Literas tuas accepi, in quibus mihi scribis, ut semper operam bonis literis <lb xml:id="p1z3"/>impendiam et assidue pro te orem.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Nolui etiam intermittere, quin tibi <lb xml:id="p1z4"/>literas mea propria manu scriptas mitterem.</s>
					<s n="5" xml:lang="la">Sed te rogo, ne egre feras <lb xml:id="p1z5"/>me non tam diu tibi scripsisse; sed me excusabis propterea, quod nullum <lb xml:id="p1z6"/>tabellionem invenire potui, qui literas traderet, nec meis ineptiis tua studia <lb xml:id="p1z7"/>sepius interrumpere audeo.</s>
					<s n="6" xml:lang="la">Gratias tibi ingentes ago propter strenam <lb xml:id="p1z8"/>mihi a te missam.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Omnes adhuc optime in nostro pago et domo <lb xml:id="p1z9"/>valemus praeter matrem praeceptoris et hospitis nostri <persName>Rodolphi Wonlichii</persName>, <lb xml:id="p1z10"/>quae quotidie egrotat mortis periculo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Ora semper pro nobis dominum, <lb xml:id="p1z11"/>item etiam pro te faciam.</s>
					<s n="9" xml:lang="la" ana="salute">Dominus noster et domina nostra <lb xml:id="p1z12"/>cum tota familia te plurimum salutant.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Finem faciam scribendi.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p1z13"/>Salutem, obsecro, dices meo nomine <persName ref="p5035">Veritati</persName>, <persName ref="p5034">Dorotheae</persName> et cum tota <lb xml:id="p1z14"/>tua familia.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale in Christo, mi pater, qui te semper incolumem <lb xml:id="p1z15"/>in sua tutela conservet ad s[al]utem suae ecclesiae.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Datum <placeName ref="l2712">Rickenbach</placeName> <lb xml:id="p1z16"/>undecimo calendas februarii 1565.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z17"/>Tuus dilectissimus et semper <lb xml:id="p1z18"/>obedientissimus <persName ref="p613">filius <lb xml:id="p1z19"/>Mathaeus Coignetius</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo et praestantissimo <lb xml:id="p2z2"/>viro d. <persName ref="p495">Heinrico Bullingero</persName> p[atri], <lb xml:id="p2z3"/>domino et patri suo observandissimo.</s>
				</p>
				<p>
					<s n="16" xml:lang="de"><lb xml:id="p2z4"/>Zuͦ <placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
