	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Ro ipso temporis momento, quo controversam
					<lb xml:id="p1z2"/>untam solutum et amice transactum in
					<lb xml:id="p1z3"/>sperabam. praeter expertationem meam accidit
					<lb xml:id="p1z4"/>ut vestrorum, nescio, an mututione consilii
					<lb xml:id="p1z5"/>nimia perseverantia rec ita differretur sut
					<lb xml:id="p1z6"/>inimici vestri in spem venirent omnia possempedirs.
					<lb xml:id="p1z7"/>quam eorum spem dei optimi maximo. providentia
					<lb xml:id="p1z8"/>et vestra prudentia cupio falsam esse.
					<lb xml:id="p1z9"/>considerare, certe debent omnes Helvetii, ut eam
					<lb xml:id="p1z10"/>Conservent, qua hodie securissime rebus
					<lb xml:id="p1z11"/>omnibus siis et opulus antegris potiuintur et cavere
					<lb xml:id="p1z12"/>ut eam tum facice amittant, quam postea
					<lb xml:id="p1z13"/>sufficilius fractis et comminutis suis opibus et
					<lb xml:id="p1z14"/>magnas propuesis cahamitites nihilo meliorem
					<lb xml:id="p1z15"/>quam nunc habent recuperabunt.
					<lb xml:id="p1z16"/>Detatu i Bulligere, ut tuae ede aius
					<lb xml:id="p1z17"/>adeo omnibus Helvetiis et nolus quoque (quod anio
					<lb xml:id="p1z18"/>itam abs te petius et mihi es pollicitus  operam
					<lb xml:id="p1z19"/>hac in re tuam praestes. Quoe rato conventium
					<lb xml:id="p1z20"/>istam suspesam retineat, non scribo tu extim
					<lb xml:id="p1z21"/>intelliges Gramiprima profecto esse oleberet
					<lb xml:id="p1z22"/>sut haec certe non est), quae vos ad tamu permicusum
					<lb xml:id="p1z23"/>bellum atque vestrae omnino hoc est Helveticae
					<lb xml:id="p1z24"/>oi cvrsionem antulleret. Exputare tantum
					<pb/>
					<lb xml:id="p2z1"/>undum omnim est facullatium, sed extinguere
					<lb xml:id="p2z2"/>iaedifini ruina nemo poterit. Effice
					<lb xml:id="p2z3"/>roge, ut dum liceae id tui cogitent. Suprioribus
					<lb xml:id="p2z4"/>diebus, ita continuis curis et negotiis
					<lb xml:id="p2z5"/>constrictus fui, ut mihi libere reserran.
					<lb xml:id="p2z6"/>pe potestas fuerit, quae reos effacit, ut
					<lb xml:id="p2z7"/>ad te, quemadmodum constitueram, non ita
					<lb xml:id="p2z8"/>uebro surpserim, sed hanc officii omuistionum
					<lb xml:id="p2z9"/>cum primum mihi partam molestas occupationes
					<lb xml:id="p2z10"/>ficuerit, ingenti usura compensabo.e
					<lb xml:id="p2z11"/>et quod amam S. Cal. dec.
					<lb xml:id="p2z12"/>Tuus i animo
					<lb xml:id="p2z13"/>amlaurentius.
					<lb xml:id="p2z14"/>Responsionem meam ad has
					<lb xml:id="p2z15"/>iuvenies inter meas
					<lb xml:id="p2z16"/>copias Latinas.
					<pb/>
					<lb xml:id="p4z1"/>Clarissimo theologiae professun
					<lb xml:id="p4z2"/>domino Henrico Bullingero,
					<pb/>
					<lb xml:id="p6z1"/>Ooptimo atque amicissimo vtio
					<lb xml:id="p6z2"/>d. Henrico Bullingero,
					<lb xml:id="p6z3"/>zuͦ Zürich.
				</p>
			</div>
