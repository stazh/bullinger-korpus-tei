	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Gratias agimus <persName ref="p1365">Grynęus</persName> et ego propter omnia, quę in nos contulistis<note xml:id="fn1" type="footnote" n="1">Namlich bei ihrem Besuch in <placeName ref="l587">Zürich</placeName>; s. oben <ref target="file10918">Nr. 877</ref>, Anm. 4.</note> in, primis <lb xml:id="p1z2"/>autem, quod nunc mittis descriptum <persName ref="p4079">Zviccii</persName><note xml:id="fn2" type="footnote" n="2">Gemeint ist <persName ref="p4079">Zwicks</persName> Brief vom 19. August (oben <ref target="file10920">Nr. 879</ref>), vgl. oben <ref target="file10925">Nr. 884</ref>, 4f.</note>.</s>
					<s n="3" xml:lang="la">Videmus enim hinc et diligentiam <lb xml:id="p1z3"/>tuam et studium erga nos.</s>
					<s n="4" xml:lang="la">Insuper intelligimus et gaudemus, quod nihil ex hoc, <lb xml:id="p1z4"/>quod non e nobis pariter, audieritis.</s>
					<s n="5" xml:lang="la">Ex quo speramus non per nos staturum, <lb xml:id="p1z5"/>ne fiat concordia.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">In hunc usque diem expectamus responsum a <placeName ref="l41">Bernensibus</placeName><note xml:id="fn3" type="footnote" n="3">Die Stellungnahme der <placeName ref="l41">Berner</placeName> Pfarrer zur <placeName ref="l558">Wittenberger</placeName> Konkordie (oben <ref target="file10919">Nr. 878</ref>) wurde vom <placeName ref="l41">Berner</placeName> Rat am 23. August nach <placeName ref="l28">Basel</placeName> und <placeName ref="l587">Zürich</placeName> gesandt; s. ebd., Anm. 2.</note>.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z6"/>Equidem articulos cum declarationibus<note xml:id="fn4" type="footnote" n="4">Zu den verschiedenen Erläuterungen der Konkordie vgl. oben <ref target="file10906">Nr. 866</ref>, 5-12 mit Anm. 2f; 871, 1 mit Anm. 1.</note>, nostrum responsum cum vestro<note xml:id="fn5" type="footnote" n="5">Zu den Gutachten der <placeName ref="l28">Basler</placeName> und <placeName ref="l587">Zürcher</placeName> Pfarrer s. oben <ref target="file10911">Nr. 871</ref>, 3f mit Anm. 5, bzw. <ref target="file10918">Nr. 877</ref>, 9-13 mit Anm. 7.</note> dimiseram illis <lb xml:id="p1z7"/>remittenda cum ipsorum sententia.</s>
					<s n="8" xml:lang="la">Miserunt hodie nostra; responsum video nullum, <lb xml:id="p1z8"/>quamvis, qui adtulit<note xml:id="fn6" type="footnote" n="6">Unbekannt.</note>, dixerit responsum sese descripsisse et consensum intellexiss<lb xml:id="p1z9"/>e, at quonam pervenerit, ignorare.</s>
					<s n="9" xml:lang="la">Literas senatui adtulit<note xml:id="fn7" type="footnote" n="7">Siehe <hi>Bizer,</hi> Abendmahlsstreit 156f.</note>; quid con<lb xml:id="p1z10"/>tineant, adhuc ignoramus.</s>
					<s n="10" xml:lang="la">Monet me <persName ref="p8412">Gaspar</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p8412">Kaspar Meganders</persName> Brief an <persName ref="p8418">Myconius</persName> ist nicht erhalten.</note>, ne nimium credam <lb xml:id="p1z11"/><persName ref="p1974">Luthero</persName> seu <placeName ref="l491">Argentinensibus</placeName>.</s>
					<s n="11" xml:lang="la">Dolet mihi certe adfectibus tantum tribui.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z12"/>Ego coram deo neminem respicio nisi veritatem Christi.</s>
					<s n="13" xml:lang="la"><persName ref="p2810">Erasmus</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p2810">Erasmus Ritter</persName>.</note> la<lb xml:id="p1z13"/>borat, ne fiat concordia; nescio, quid vereatur.</s>
					<s n="14" xml:lang="la">Utinam <placeName ref="l41">Bernam</placeName> nunquam <lb xml:id="p1z14"/>introisset!</s>
					<s n="15" xml:lang="la">Hoc tibi.</s>
					<s n="16" xml:lang="la">Curamus, ut et <placeName ref="l41">Bernenses</placeName> habeant literas <persName ref="p4079">Zviccii</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z15"/>Scripsit interea et <persName ref="p467">Bucerus</persName><note xml:id="fn10" type="footnote" n="10">Zum undatierten Brief <persName ref="p467">Bucers</persName> an <persName ref="p1365">Grynäus</persName>, aus dem <persName ref="p8418">Myconius</persName> nachfolgend zitiert, s. <hi>Pollet,</hi> <persName ref="p467">Bucer</persName> II 391, Anm. 3.</note>, quę darem integrę, nisi per tempus non <lb xml:id="p1z16"/>liceret.</s>
					<s n="18" xml:lang="la">E multis tamen unum illud audi: "Iam" inquit "hęc fidei praesentia e<lb xml:id="p1z17"/>t captus non deducit Christum coelo, non miscet pani, non includit loco, se<lb xml:id="p1z18"/>d amplectitur<pb type="edition" next="408"/> in coelesti gloria regnantem, at sic regnantem, ut sibi nobis <lb xml:id="p1z19"/>hic exulantibus, in hoc corpore detentis, hac coena, his verbis et symbolis <lb xml:id="p1z20"/>(ipse tamen nullo loco exciusus vel inclusus nullaque ratione immutatus) hoc <lb xml:id="p1z21"/>loci administratis sese sistat servatorem et re ipsa praestet."</s>
					<s n="19" xml:lang="la">De indignis autem <lb xml:id="p1z22"/>scribit in hunc modum: "De indignis scis, ut articulus<note xml:id="fn11" type="footnote" n="11"><bibl source="b135">BucerDS</bibl> VI/1 122,7f; 124,1-4.</note> eos nominatim <lb xml:id="p1z23"/>exprimit, qui verba et domini institutionem non pervertunt, qui fidem habent sacramento.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z24"/>Oro abs te, si quis volens aliquam sibi anulo desponsare et in hoc <lb xml:id="p1z25"/>tradat illi anulum, illa intelligens mysterii accipiat anulum et simul <lb xml:id="p1z26"/>matrimonii jus, attamen non sit eo animo, ut fidem coniugii veut servare, nunquid <lb xml:id="p1z27"/>dicemus tamen, quod ista non solum anulum, sed ipsum quoque jus coniugii acceperit?</s>
					<s n="21" xml:lang="la">Licet <lb xml:id="p1z28"/>indigne, quia matrimonium non rite colit aut colere etiam tum, cum matrimonium <lb xml:id="p1z29"/>anulo acciperet, instituit.</s>
					<s n="22" xml:lang="la">Ita cum sacramento" etc.</s>
					<s n="23" xml:lang="la">Hec expendito.</s>
					<s n="24" xml:lang="la">Si opus <lb xml:id="p1z30"/>fuerit, totam deinceps epistolam mittam, tametsi <persName ref="p1365">Grynęi</persName> est.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Vellem, <lb xml:id="p1z31"/>literis admonerentur a vobis <persName ref="p8412">Gaspar</persName> et reliqui, caverent ab <persName ref="p2810">Erasmo</persName>, <lb xml:id="p1z32"/>tum, ut omnibus omissis ad concordiam et veritatem respicerent.</s>
					<s n="26" xml:lang="la">Videtur <lb xml:id="p1z33"/>mihi pacem in ecclesia prorsus futuram.</s>
					<s n="27" xml:lang="la">De plebe videtis nihil timendum <lb xml:id="p1z34"/>esse, cum loquendi modos nemo praescribat.</s>
					<s n="28" xml:lang="la">De conventu agemus <lb xml:id="p1z35"/>qua possumus diligentia, ut differatur<note xml:id="fn12" type="footnote" n="12"><persName ref="p495">Bullinger</persName> hatte darum gebeten; s. oben <ref target="file10925">Nr. 884</ref>, 5-8.</note>.</s>
					<s n="29" xml:lang="la">Nam iudicium <persName ref="p1974">Lutheri</persName> de <lb xml:id="p1z36"/><persName ref="p8049">Vadiano</persName> anxie expecto et ego<note xml:id="fn13" type="footnote" n="13">Vgl. ebd., Z. 7f.</note>.</s>
				</p>
				<p>
					<s n="30" xml:lang="la" ana="farewell">Vale cum familia tua, et fratribus <lb xml:id="p1z37"/>omnibus <persName ref="p1365">Grynęi</persName> et meo nomine bene precare.</s>
				</p>
				<p>
					<s n="31" xml:lang="la"><placeName ref="l28">Basileę</placeName>, 26. augusti anno 1536.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><lb xml:id="p1z38"/><persName ref="p8418">Os. Myco.</persName> <lb xml:id="p1z39"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="33" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho Bul<lb xml:id="p2z2"/>lingero</persName>, <placeName ref="l587">Tigurinorum</placeName> <lb xml:id="p2z3"/>antistiti d<lb xml:id="p2z4"/>ignissimo, domino ac <lb xml:id="p2z5"/>fratri in Christo <lb xml:id="p2z6"/>observando <lb xml:id="p2z7"/>suo.</s>
				</p>
			</div>
		</body>
