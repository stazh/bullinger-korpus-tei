	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non potui committere, quin ad verbum <lb xml:id="p1z2"/>describerem tibi literas, quas hac hora per <lb xml:id="p1z3"/>postam accepi; erit earum usus aliquis: "<lb xml:id="p1z4"/>D. <persName ref="p495">Heinrycho Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p1z5"/>vigilantissimo S. Ex literis d. <persName ref="p8111">Petri</persName> et meis <lb xml:id="p1z6"/>intellexisti colloquii continuationem.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Omnia <lb xml:id="p1z7"/>nunc meliore loco sunt, et triumphat dominus per <lb xml:id="p1z8"/>omnes fere urbes <placeName ref="l832">Galliae</placeName>.</s>
					<s n="4" xml:lang="la" ana="salute">Scribam ad te brevi <lb xml:id="p1z9"/>pluribus; interim salutabis amicos omnes nosque am<lb xml:id="p1z10"/>abis.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Scripsit rex nuper <placeName ref="l862">Helvetiis</placeName> et <lb xml:id="p1z11"/><placeName ref="l648">Rhetis</placeName>, ut in fide constantes sint.</s>
					<s n="6" xml:lang="la"><placeName ref="l378">Parisiis</placeName>, 2. <lb xml:id="p1z12"/>octobris.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Tuus ex animo <persName ref="p629">Coignetius</persName>."</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Syllabatim descripsi.</s>
					<s n="9" xml:lang="la">At literas, quarum <lb xml:id="p1z15"/>fecit mentionem, nondum accepimus; haerent <lb xml:id="p1z16"/>in itinere.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ubi redditae fuerint, comm<lb xml:id="p1z17"/>unicabo illas quoque.</s>
					<s n="11" xml:lang="la" ana="salute">Haec exhibebis d. <lb xml:id="p1z18"/><persName ref="p8432">Friderycho a Salice</persName>, veteri et singulari <lb xml:id="p1z19"/>meo amico, quem et salutabis.</s>
					<s n="12" xml:lang="la">Commen<lb xml:id="p1z20"/>dabis me clarissimo viro d. <persName ref="p8093">Herculi a Sa<lb xml:id="p1z21"/>lice</persName>, cui cuperem esse notus; amo hominem <lb xml:id="p1z22"/>propter singulare pietatis studium.</s>
					<s n="13" xml:lang="la" ana="salute">Salu<lb xml:id="p1z23"/>tabis illum meo nomine et commendabis me <lb xml:id="p1z24"/>bonis omnibus, imprimis d. consulibus et m<lb xml:id="p1z25"/>inistris.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Saluta et <persName ref="p8016">Eglium</persName> etc.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z26"/>18. octobris 1561.</s>
					<s n="16" xml:lang="la">Dominus benedicat <lb xml:id="p1z27"/>comitiis vestris et eliminet omnia dissidia, <lb xml:id="p1z28"/>omnem impietatem et imprimis de<lb xml:id="p1z29"/>ceptiones et imposturas papisticas, <lb xml:id="p1z30"/>servet vos in pace et concordia sal<lb xml:id="p1z31"/>vos et incolumes semper.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z32"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z34"/>Scripsi festinantissime.</s>
				</p>
				<p>
					<note>[Darunter von der Hand des Fabricius:]</note>
					<s n="19" xml:lang="la"><lb xml:id="p1z35"/>Hae literae mihi <persName>Ilantii</persName> sunt redditę in comitiis.</s>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p4z1"/>Praestantissimo viro d. <persName ref="p8009">Ioann<lb xml:id="p4z2"/>i Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p4z3"/>ecclesiae ministro, domino <lb xml:id="p4z4"/>et fratri suo colendissimo.</s>
					<s n="21" xml:lang="de"><lb xml:id="p4z5"/>An h. <persName ref="p8009">Johansen Fabricien</persName>, <lb xml:id="p4z6"/>pfarreren zuͦ <placeName ref="l98">Chur</placeName> by S. <lb xml:id="p4z7"/>Martin, jetzund uff dem <lb xml:id="p4z8"/>pundtstag in den <placeName ref="l648">Pünten</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
