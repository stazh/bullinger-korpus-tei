	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non potui per varia impeditus negotia <lb xml:id="p1z2"/>ante dies 8, cum tuas bene longas de ca[uss]a Rezuntiana <lb xml:id="p1z3"/>scriptas accepissem, respondere.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Mandavi ergo <lb xml:id="p1z4"/><persName>Lucio</persName> nostro tibi significaret tuas mihi redditas <lb xml:id="p1z5"/>esse, sed et illas, quas <persName ref="p1283">Gessnero</persName> tradideras, per <lb xml:id="p1z6"/>me esse curatas; misi eas <placeName ref="l28">Basileam</placeName> ad d. <persName ref="p4087">Zvingerum</persName>.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Licet ille nihil responderit, tamen illum spero <lb xml:id="p1z8"/>fecisse officium.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Expectamus te, frater, cupide.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Sed audi meam solicitudinem: Scis ingenia <lb xml:id="p1z10"/>adversariorum nostrorum subdola et vafra esse, denique <lb xml:id="p1z11"/>maligna.</s>
					<s n="7" xml:lang="la">Quid si <persName>Rhezu</persName><note type="margin">a.R.: Rezi.. od. Rezu m. Abkürzungszeichen Reziensis, Rezunziensis?</note> ille tuus adversarius <lb xml:id="p1z12"/>te deferret apud Svizios, per quorum ditionem <lb xml:id="p1z13"/>te transire oportet, illique caussis effictis, ut facile <lb xml:id="p1z14"/>inveniunt, te interciperent?</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Meliora spero, sed <lb xml:id="p1z15"/>tamen amore et studio tui meas cogitationes forte <lb xml:id="p1z16"/>inanes celare te non possum in hoc, ut in profectione <lb xml:id="p1z17"/>sis circumspectior.</s>
					<s n="9" xml:lang="la">Reliqua omnia in tuum <lb xml:id="p1z18"/>differo adventum.</s>
					<s n="10" xml:lang="la">Forte post octiduum copiosius <lb xml:id="p1z19"/>mihi scribendi argumentum suppeditabitur.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Optim<lb xml:id="p1z20"/>e vale.</s>
					<s n="12" xml:lang="la">Dominus te protegat ab omni malo.</s>
					<s n="13" xml:lang="la" ana="salute">S<lb xml:id="p1z21"/>aluta d. <persName ref="p8057">Campellum</persName>, d. consules, <persName ref="p1770">Gregorium</persName>, <persName ref="p6130">Pontisellam</persName>, <lb xml:id="p1z22"/><persName ref="p8186">Bonetum</persName>, d. <persName ref="p2776">Ruinellam</persName> et omnes notos atque bonos.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z23"/><placeName ref="l587">Tiguri</placeName> 18. ianuarii 1572.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z25"/>Salutant te mei omnes.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro et <lb xml:id="p2z2"/>fideli ecclesiae Christi <lb xml:id="p2z3"/>apud <placeName ref="l98">Curienses</placeName> <lb xml:id="p2z4"/>ministro d. <persName ref="p8016">Tobiae Eglio</persName>, <lb xml:id="p2z5"/>domino meo <lb xml:id="p2z6"/>honorando et fratri <lb xml:id="p2z7"/>charissimo.</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>