	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quum ex improviso, vir colendissime, <lb xml:id="p1z2"/>in tabellarium iamiam itineri accinctum i<lb xml:id="p1z3"/>ncidissem, visum mihi est doctam tuam aurem <lb xml:id="p1z4"/>indocto epistolio vulnerare."</s>
					<s n="3" xml:lang="la">Qui" dicis.</s>
					<s n="4" xml:lang="la"><foreign xml:lang="el">[<lb xml:id="p1z5"/>griechisch]</foreign>Adolescens quidam <placeName ref="l335">Myl<lb xml:id="p1z6"/>husanus</placeName>, bonę quidem indolis, isthic stipendia <lb xml:id="p1z7"/>literaria facit, <placeName ref="l587">Tigurinę</placeName> scholę bonas <lb xml:id="p1z8"/>literas addiscendas traditus est.</s>
					<s n="5" xml:lang="la">Hunc itaque tibi <lb xml:id="p1z9"/>commendo et, si quid deliquerit seu cesserit, se<lb xml:id="p1z10"/>veriter reprehende.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l335">Mylhusii</placeName> die 20. <lb xml:id="p1z11"/>Maii anno 1549.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/><persName ref="p8336">Henrichus Apriolus</persName>, <lb xml:id="p1z13"/>verbi dei minister.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Percelebri viro D. <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesię episcopo<lb xml:id="p2z4"/>.</s>
				</p>
			</div>
		</body>
	</text>
