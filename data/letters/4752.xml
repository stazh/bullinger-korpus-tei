	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Heri sub cenam eas literas ab <persName ref="p1568">Hosero</persName> accepi, quarum nudius quartus mentio <lb xml:id="p1z3"/>fiebat in alteris, quas per <persName>Leonardum</persName> ad me dedit; coniunctę vero illis erant <lb xml:id="p1z4"/>item tibi inscriptę, quas ab optimo <persName ref="p1918">Linero</persName> iam accipies.</s>
					<s n="3" xml:lang="la">Simul autem advenerat <lb xml:id="p1z5"/>heri <persName>Wonlichius</persName> noster istinc veniens et literarum fasciculum <placeName ref="l491">Argentorato</placeName> <lb xml:id="p1z6"/>ab <persName>Huberto</persName> et filio meo adferens.</s>
					<s n="4" xml:lang="la">Scribunt autem de rebus <placeName ref="l832">Gallię</placeName>, mittunt <lb xml:id="p1z7"/>etiam libellum cum <persName ref="p3088">Iohannis Sturmii</persName> praefatione continentem quatuor scripta <lb xml:id="p1z8"/>eucharistica Buceri nostri; pariter novos motus <placeName ref="l491">Argentoratenses</placeName> significant.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quę omnia <lb xml:id="p1z9"/>nisi certo mihi perusaderem a <persName ref="p3050">Stuckio</persName> vestro ad te quoque missa, partem aliquam <lb xml:id="p1z10"/>nunc etiam non lectam ad te perferri curassem.</s>
					<s n="6" xml:lang="la">Fac igitur sciam, si quid forte <lb xml:id="p1z11"/>horum desideras.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Non possum quicquam praeterea; ita simul multa mihi scribenda vehe<lb xml:id="p1z12"/>menter me urgent.</s>
					<s n="8" xml:lang="la" ana="farewell">Bene vale, mi venerande charissimeque <persName ref="p495">Bullingere</persName>.</s>
					<s n="9" xml:lang="la">12. aprilis.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p8055">A[mbrosius] Bl[aurerus]</persName> t[uus].</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho Bul<lb xml:id="p2z2"/>lingero</persName>, venerando <lb xml:id="p2z3"/>et charissimo fratri suo.</s>
				</p>
			</div>
		</body>
	</text>
