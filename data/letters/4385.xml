				<p>
					<lb xml:id="p1z1"/>Literas tuas, vir reverendissime proximum
					<lb xml:id="p1z2"/>Martio datas die quodecima iunii, sum
					<lb xml:id="p1z3"/>animi laetitia accepi, una cum quibus
					<lb xml:id="p1z4"/>libris tuis, quorum in literis ficet
					<lb xml:id="p1z5"/>exceptis iis duobus, quos manximi
					<lb xml:id="p1z6"/>me habendos speraveram, nempe dn
					<lb xml:id="p1z7"/>christliche phestandt et de iustificatione
					<lb xml:id="p1z8"/>Non credo tamen a Froschouero omissos
					<lb xml:id="p1z9"/>Sed quod sarcinulam illam suo ilis
					<lb xml:id="p1z10"/>non clauserit, causam dedisse, ut ad
					<lb xml:id="p1z11"/>illis, per quorum manus ad me veniam
					<lb xml:id="p1z12"/>debuit, subriperentur, det illis dominu
					<lb xml:id="p1z13"/>minus ut etiam legant et cum fructi
					<lb xml:id="p1z14"/>inde percepto fęliciter vivant. ibi
					<lb xml:id="p1z15"/>ante tantm iis, quam pro acceptis ingente
					<lb xml:id="p1z16"/>ago gratias et praecor, ut idem donum
					<lb xml:id="p1z17"/>minus deus tibi caeterisque christiana
					<lb xml:id="p1z18"/>ecclesiae ministris fidelibus, concedat
					<lb xml:id="p1z19"/>plura in utilitatem eemolumentum s
					<lb xml:id="p1z20"/>cętus scribere. Amen. Porro non abs ri
					<lb xml:id="p1z21"/>tibi significandum puto, mihi omnia pro
					<lb xml:id="p1z22"/>animi tui. voto dominum deum largim
					<pb/>
					<lb xml:id="p2z1"/>tum esse, nempe uxorem (piam, pudicam
					<lb xml:id="p2z2"/>probam, pulchram et quamvis non adeo
					<lb xml:id="p2z3"/>pecuniosam, tamen meis moribus accomor
					<lb xml:id="p2z4"/>adissima et ob id reliquaque dona animi
					<lb xml:id="p2z5"/>charissimam. Idem deus, qui dedit pro
					<lb xml:id="p2z6"/>sua paterna clementia mihi eam diu
					<lb xml:id="p2z7"/>incolumem conservet. Nata est parem
					<lb xml:id="p2z8"/>ex familia Norumbergica sunit
					<lb xml:id="p2z9"/>neriorum, pater nomine Petrus sinituer
					<lb xml:id="p2z10"/>hic in monteregio multis annis fuit
					<lb xml:id="p2z11"/>primas iudicii, quem magistrum sclis
					<lb xml:id="p2z12"/>binorum vocant, obiit peste an 4.
					<lb xml:id="p2z13"/>non sine maximo civum luctu.V
					<lb xml:id="p2z14"/>c frater eius Andreas, eiusdem
					<lb xml:id="p2z15"/>reipublicae consul dignissimus, qui ob
					<lb xml:id="p2z16"/>sui integritatem ab illustrissimo
					<lb xml:id="p2z17"/>principe plurimum diligite, filiam eius
					<lb xml:id="p2z18"/>duxit Thimotheus Gersonius secretarum
					<lb xml:id="p2z19"/>camerae. Adfuius meis iuptiis lilitsisimo,
					<lb xml:id="p2z20"/>simus dux noster una cum ducissia
					<lb xml:id="p2z21"/>consiliariis nobilibusque primoribus
					<lb xml:id="p2z22"/>ut fieri solet, hilares fuerunt
					<lb xml:id="p2z23"/>Adfuit quoque d. doctor Anthonius
					<lb xml:id="p2z24"/>Schnebergerus <placeName ref="l587">Tigurinus</placeName>, medicus et
					<pb/>
					<lb xml:id="p3z1"/>me
					<lb xml:id="p3z2"/>ssa
					<lb xml:id="p3z3"/>sponsus Gaconiensis, qui sine dubio
					<lb xml:id="p3z4"/>omnia etiam largius (sicuti hinc discedens
					<lb xml:id="p3z5"/>pollicitus est) ad te scripsit. Mitto
					<lb xml:id="p3z6"/>tibi hisce literis duos nummos argento.
					<lb xml:id="p3z7"/>quorum alter meam, alter vero Uxon
					<lb xml:id="p3z8"/>meae imaginem. utcunque refert
					<lb xml:id="p3z9"/>quos tanquam testes peracti voti tui
					<lb xml:id="p3z10"/>in memoriam mei servare non dedigne.
					<lb xml:id="p3z11"/>Ego vicissim omnia, quae in tui omniu
					<lb xml:id="p3z12"/>unqu Tigurinirum gratiam facere poteri,
					<lb xml:id="p3z13"/>non omittam. Nova apud nos hic
					<lb xml:id="p3z14"/>sunt nulla praeterque, quod inter Magnum
					<lb xml:id="p3z15"/>regis Dani fratrem et magistrum
					<lb xml:id="p3z16"/>Linoniae male convenit, unde ilus
					<lb xml:id="p3z17"/>covitarum principi facilior victoria
					<lb xml:id="p3z18"/>erit rapit quisquam, quantum poest.r
					<lb xml:id="p3z19"/>Poloniae parte Muscovita parte magnus
					<lb xml:id="p3z20"/>Paae princeps parte, dux noster
					<lb xml:id="p3z21"/>emit partem, frater eius tenet episcopoco
					<lb xml:id="p3z22"/>Rigensem, habet Christophorum
