	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi et legi tuas, sed superiore septimana <lb xml:id="p1z2"/>nullas a d. <persName ref="p8432">Friderycho a Salicibus</persName> accepi neque vidi.</s>
					<s n="3" xml:lang="la">Ago <lb xml:id="p1z3"/>tibi gratias pro diligenti consignatione rerum variarum, <lb xml:id="p1z4"/>ex <placeName ref="l834">Italia</placeName> maxime; vicissim haec tibi communico: Scribit d. <persName ref="p2095">Mela<lb xml:id="p1z5"/>nchton</persName> datis ad me literis amicissimis sibi <placeName ref="l569">Wormatiae</placeName> duplicem esse <lb xml:id="p1z6"/>pugnam cum adversus papistas, tum adversus <lb xml:id="p1z7"/>socios; horum enim aliquot postulare, ut excommunicentur <lb xml:id="p1z8"/>Zvingliani, plures autem ex legatis refragari.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Brevi plura audiemus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quieverunt ad tempus <lb xml:id="p1z10"/>homines importuni.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Benignum se nobis praebet <lb xml:id="p1z11"/><persName>Philippus</persName>.</s>
					<s n="7" xml:lang="la">- In <placeName ref="l832">Gallia</placeName> vel <placeName ref="l2589">Picardia</placeName> aiunt alii <lb xml:id="p1z12"/><placeName>Peronam</placeName> obsidione cingi, alii captam esse, quod <lb xml:id="p1z13"/>non credo.</s>
					<s n="8" xml:lang="la">Rex expeditione gravi se parat, <lb xml:id="p1z14"/>ut hostibus progrediuntibus occurrat.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Naves ali<lb xml:id="p1z15"/>quot <placeName ref="l830">Anglorum</placeName> et <placeName ref="l808">Belgarum</placeName>, in quibus et magnae <lb xml:id="p1z16"/>pecuniae et copiae fuerunt, a <placeName ref="l832">Gallis</placeName> captae dicunt<lb xml:id="p1z17"/>ur in mari Britannico et in <placeName ref="l832">Galliam</placeName> ab<lb xml:id="p1z18"/>ductae; magnae naves onustae viris et rebus <lb xml:id="p1z19"/>ex <placeName ref="l875">Hispaniis</placeName> venientes non procul a portu <lb xml:id="p1z20"/><placeName ref="l830">Anglico</placeName> naufragio perierunt.</s>
					<s n="10" xml:lang="la">Exarsit grave <lb xml:id="p1z21"/>bellum inter <placeName ref="l830">Anglos</placeName> et <placeName ref="l2524">Scotos</placeName>, ac <placeName ref="l2524">Scoti</placeName>, <placeName ref="l832">Gallorum</placeName> <lb xml:id="p1z22"/>socii, hactenus victores fuerunt.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Nuper <lb xml:id="p1z23"/>500 equitum trucidarunt; quotidie incursiones <lb xml:id="p1z24"/>et certamina fiunt.</s>
					<s n="12" xml:lang="la">Haec omnia debemus <lb xml:id="p1z25"/>sanctissimo; <foreign xml:lang="de">der Tüffel gäb imm den lhon etc.</foreign></s>
				</p>
				<p>
					<s n="13" xml:lang="la">De <lb xml:id="p1z26"/>colloquio <placeName ref="l569">Wormatiensi</placeName> prudentes nihil sperant; <lb xml:id="p1z27"/>existimant vel non finiendum vel, si finiatur, <lb xml:id="p1z28"/>eventu felici cariturum.</s>
					<s n="14" xml:lang="la">- Iam nunc copiosissimas <lb xml:id="p1z29"/>ex <placeName ref="l2472">Polonia</placeName> literas accipio.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Predicatur in <placeName ref="l2472">Polonia</placeName> <lb xml:id="p1z30"/>evangelium; sed graviter interim papistae obsistunt.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z31"/>Crescit tamen in dies Christi ecclesia, decrescit <lb xml:id="p1z32"/>papistica.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Rex occupatus bello <placeName ref="l2574">Livoniensi</placeName> nondum <lb xml:id="p1z33"/>potuit caussam religionis tractare publicis <lb xml:id="p1z34"/>comitiis.</s>
					<s n="18" xml:lang="la">Benignissime recepit d. <persName ref="p8041">Ioannem a Lasco</persName>, <lb xml:id="p1z35"/>qui de ipso, uti ad me scribit, amplissimam concepit <lb xml:id="p1z36"/>spem.</s>
					<s n="19" xml:lang="la">Plura iam in negotiorum turba non possum.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="salute"><lb xml:id="p1z37"/>Tu saluta mihi amplissimos d. d. consules, fratres <persName>Philippum</persName> et <persName ref="p6130">Pontasellam</persName>, <lb xml:id="p1z38"/>diligentissime vero d. <persName ref="p8432">Friderychum a Salicibus</persName> et d. <persName ref="p6831">Ioannem <lb xml:id="p1z39"/>Traversum</persName>, cum quibus has communicabis inclusis iis <lb xml:id="p1z40"/>tuis literis et mature missis.</s>
					<s n="21" xml:lang="la">Valet eorum filius <pb/><lb xml:id="p2z1"/>et proficit, scabie tamen iterum vexatur, ut solent <lb xml:id="p2z2"/>fere huiusmodi adolescentuli.</s>
					<s n="22" xml:lang="la" ana="farewell">Vale una cum domo <lb xml:id="p2z3"/>tua et perge mihi frequentes vel creberrimas s<lb xml:id="p2z4"/>cribere literas, nec est, quod excuses; videntur pleraeque nimis acurate scriptae, tantum abest, ut videri debeant <lb xml:id="p2z5"/>mihi parum diligentes.</s>
					<s n="23" xml:lang="la"><placeName ref="l587">Tiguri</placeName> prima octobris festinantissime 1557.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Praest<lb xml:id="p2z6"/>antissimo viro d. <persName ref="p8009">Ioanni Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae ministro, compatri suo fideli et <lb xml:id="p2z7"/>fratri charissimo.</s>
					<s n="26" xml:lang="de">An h. herren <persName ref="p8009">Hansen Schmiden</persName>, pfar<lb xml:id="p2z8"/>reren zuͦ S. Martin ze <placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
