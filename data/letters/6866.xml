	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Literas tuas per tabellarium, quem in <placeName>Hassiam</placeName> <lb xml:id="p1z2"/>ablegastis, mihi tanem traditas legi.</s>
					<s n="3" xml:lang="la">Vestram <lb xml:id="p1z3"/>sollicitudinem et laborem in dissidiis <lb xml:id="p1z4"/>componendis valde probo; utinam <persName ref="p1974">Lutheri</persName> <lb xml:id="p1z5"/>sectatores pari studio pacis accenderentur!</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Plus fortassis aequitatis et <lb xml:id="p1z7"/>modestiae haberemus ac minus turbarum.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Nunc cum maior pars iniquis praeiu<lb xml:id="p1z9"/>ditiis et arroganti primogenitura <lb xml:id="p1z10"/>superbiat, fieri non potest, quin actiones <lb xml:id="p1z11"/>meo quidem iuditio in hoc genere <lb xml:id="p1z12"/>cum dolore piorum concidant.</s>
					<s n="6" xml:lang="la">Allegasti <lb xml:id="p1z13"/>saepius in tuis scriptis ex <persName>Eusebio</persName> locum <lb xml:id="p1z14"/>8. libro 1. capite; vereor, ne et nos talem <lb xml:id="p1z15"/>effectum ambitionis tandem sentiamus.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>Video dissidium Saxonicorum principum <lb xml:id="p1z17"/>eo progressum, ut, nisi deus Sathanae <lb xml:id="p1z18"/>sanguinaria organa reprimat, id <lb xml:id="p1z19"/>ecclesiae incredibile damnum sit pariturum.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z20"/>Rogandus igitur deus, ut graves, patriae <lb xml:id="p1z21"/>amantes et prudentes politicos excitet, <lb xml:id="p1z22"/>qui rebus aestuantibus medicinam <lb xml:id="p1z23"/>adhibeant.</s>
					<s n="9" xml:lang="la">De <placeName>Ungarica</placeName> expeditione <lb xml:id="p1z24"/>nescio, quid mihi polliceri debeam.</s>
					<s n="10" xml:lang="la">Irri<lb xml:id="p1z25"/>tatus est <persName>Solymannus</persName>, hostis potens, bellico<lb xml:id="p1z26"/>sus, quo dominus tanquam virga contra <lb xml:id="p1z27"/>nos usus est.</s>
					<s n="11" xml:lang="la">Arenis quidem resistimus, <lb xml:id="p1z28"/>utinam et precibus!</s>
					<s n="12" xml:lang="la">Valde me <placeName>Varnensis</placeName> <lb xml:id="p1z29"/>cladis atque <persName>Ludovici</persName> fortuna terret.</s>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z30"/>Vale, mi <persName ref="p495">Bullingere</persName>, et me tuum <lb xml:id="p1z31"/>plane esse scias.</s>
					<s n="14" xml:lang="la" ana="salute">Saluta meo nomine <pb/><lb xml:id="p2z1"/>ornatissimos viros <persName ref="p8011">Gvaltherum</persName>, <persName ref="p8442">Simlerum</persName>, <lb xml:id="p2z2"/><persName ref="p3988">Volphium</persName>, <persName ref="p1884">Lavaterum</persName> et alios.</s>
					<s n="15" xml:lang="la">Nostri dei <lb xml:id="p2z3"/>benignitate bene valent et se vestris precibus <lb xml:id="p2z4"/>commendant.</s>
					<s n="16" xml:lang="la"><placeName ref="l210">Hedelbergae</placeName> 7. augusti <lb xml:id="p2z5"/>anno etc. 66.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z6"/>Tuus totus <lb xml:id="p2z7"/><persName ref="p8094">Stephanus Cirlerus</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z8"/>Cum literas obsignare volebam, venit ad <lb xml:id="p2z9"/>nos nobilis quidam <persName>Gallus</persName> ab amiralio <lb xml:id="p2z10"/>missus.</s>
					<s n="19" xml:lang="la">Is petiit, ut <persName>Gallicarum</persName> ecclesiarum <lb xml:id="p2z11"/><placeName ref="l142">Erfordiae</placeName> ratio habeatur earumque docto<lb xml:id="p2z12"/>res ad colloquium admittantur; quod <lb xml:id="p2z13"/>Saxonici vix concedent, qui eo spectant, <lb xml:id="p2z14"/>ut primatum conservent et aliis leges <lb xml:id="p2z15"/>praescribant etc.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p4z1"/>Reverendo viro d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p4z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> antistiti <lb xml:id="p4z3"/>fidelissimo, amico singulari <lb xml:id="p4z4"/>amore prosequendo.</s>
					<s n="21" xml:lang="de"><lb xml:id="p4z5"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
