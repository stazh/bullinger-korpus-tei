	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hoc vesperi cum amplissimis viris <persName>Pellizariis</persName> <lb xml:id="p1z2"/>in coena fui, cum superveniunt literae <lb xml:id="p1z3"/>d. <persName ref="p2054">Martinengi</persName> multa nocte una cum <lb xml:id="p1z4"/>oratione acri et vehementi <persName>Petri Fonti<lb xml:id="p1z5"/>donii</persName> etc.</s>
					<s n="3" xml:lang="la">Id ex epistola praeliminari <lb xml:id="p1z6"/>augurari licuit.</s>
					<s n="4" xml:lang="la">Plura hoc vesperi non legi.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Mitto literas d. <persName ref="p2054">Martinengi</persName>, non ut quid <lb xml:id="p1z8"/>tua cognitione maximopere dignum con<lb xml:id="p1z9"/>tineant, sed ut intelligas nostram diligentiam; <lb xml:id="p1z10"/>literas d. <persName ref="p2054">Martinengi</persName> aliquando remittes.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Si <persName ref="p1227">Froscoverus</persName> advexerit et <persName>Fontidonii</persName> et <lb xml:id="p1z12"/><persName>Cardilli</persName> contra me exemplaria, fecerit rem <lb xml:id="p1z13"/>gratissimam, si miserit; nam hoc <persName>Fontidonii</persName>, <lb xml:id="p1z14"/>quod in manibus habeo, d. <persName ref="p2054">Martinengo</persName> re<lb xml:id="p1z15"/>mittere cogito.</s>
					<s n="7" xml:lang="la">Si d. <persName ref="p8016">Tobias Egli</persName> <lb xml:id="p1z16"/>ad vos venerit cohortabere eum pro tua <lb xml:id="p1z17"/>et paternitate et humanitate, ut <lb xml:id="p1z18"/>eam, quam semel suscepit provinciam, porro <lb xml:id="p1z19"/>ornare pergat; certe diligentia et modestia <lb xml:id="p1z20"/>ipsius multum mihi hactenus commodavit <lb xml:id="p1z21"/>et eo quidem nomine ei multum debeo.</s>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Sunt quidem multae difficultates, non modo <lb xml:id="p2z2"/>publicę, sed et domesticę, cum quibus con<lb xml:id="p2z3"/>flictatur; sed eiusmodi tamen omnes sunt, <lb xml:id="p2z4"/>quae divina gratia superari possint.</s>
					<s n="9" xml:lang="la"><lb xml:id="p2z5"/>Non dubito, quae eius est modestia, quin paternis <lb xml:id="p2z6"/>tuis et fidis consiliis pro sua erga <lb xml:id="p2z7"/>te summa observantia facillime sit obsequuturus.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z8"/>Haec subito.</s>
					<s n="11" xml:lang="la">Rogo autem tuam paternitatem, ut <lb xml:id="p2z9"/>hanc festinationem boni consulat.</s>
					<s n="12" xml:lang="la">Si quid per <lb xml:id="p2z10"/>amplissimum virum <persName ref="p8111">Petrum Martyrem</persName> <lb xml:id="p2z11"/><persName>Pellizarium</persName> <placeName ref="l167">Genevam</placeName> scribere voles, <lb xml:id="p2z12"/>habebis, cui tuto committas.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale, <lb xml:id="p2z13"/>reverende pater.</s>
					<s n="14" xml:lang="la">Subito vesperi 18.<note type="misc">8.</note> octobris <lb xml:id="p2z14"/>anno 1563.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z15"/>Tui observantissimus <lb xml:id="p2z16"/><persName ref="p8009">Ioannes Fa<lb xml:id="p2z17"/>bricius</persName>.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z18"/>Pestis paulatim ad nos accedit.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z19"/>In <placeName ref="l2701">Prättigavia</placeName> dicitur vellicare <lb xml:id="p2z20"/>non paucos; apud nos nemodum <lb xml:id="p2z21"/>peste mortuus etc.</s>
				</p>
				<p>
					<note type="address">[Ohne Adresse.]</note>
				</p>
