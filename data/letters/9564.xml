	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Geliepter herr und frund, es ist iun
					<lb xml:id="p1z2"/>gestern diß schreiben von nenen son
					<lb xml:id="p1z3"/>bend dise nüw zeittung zukhonen.
					<lb xml:id="p1z4"/>und diewiel ir und herr Walteher
					<lb xml:id="p1z5"/>i neines sons schreben gedaft
					<lb xml:id="p1z6"/>werden, schik ich euch er glch
					<lb xml:id="p1z7"/>allis zuͦ f, das welt ir mr
					<lb xml:id="p1z8"/>Wo es jes nitt fuͦg hatt
					<lb xml:id="p1z9"/>sonst bey nechster potschafft zu
					<lb xml:id="p1z10"/>schicken, sonst diser zeitt nitt
					<lb xml:id="p1z11"/>mer, dan ih besich ich im die
					<lb xml:id="p1z12"/>gnad gottes datth use das4.
					<lb xml:id="p1z13"/>lebernach anno 1574.
					<lb xml:id="p1z14"/>.d.
					<lb xml:id="p1z15"/>Ulrich pchlyps furh
					<lb xml:id="p1z16"/>Tchoff Ger.
					<pb/>
					<lb xml:id="p2z1"/>Dm hochglertten, meinem
					<lb xml:id="p2z2"/>lieben und verthruwten frudt.
					<lb xml:id="p2z3"/>Meister Heinrich Bullinger,
					<lb xml:id="p2z4"/>diener der eilhen zu Zury.
					<lb xml:id="p2z5"/>
				</p>
			</div>
		</body>
	</text>
