	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">Si is, cui has literas <placeName ref="l473">Sangallum</placeName> deferendas dedi, pernoctare his <lb xml:id="p1z3"/>meis etiam expensis aut apud me manere vel voluisset vel potuisset<lb xml:id="p1z4"/>, prolixiorem a me epistolam haberes, doctissime atque optime <lb xml:id="p1z5"/><persName ref="p495">Bullingere</persName>.</s>
					<s n="3" xml:lang="la">Nunc id unum mihi curae fuit in his angustiis <lb xml:id="p1z6"/>temporis, ut de eo, quod scire ex me voluistis, te ac d. <persName ref="p1283">Gesnerum</persName> <lb xml:id="p1z7"/>utcunque certiores facerem.</s>
					<s n="4" xml:lang="la">De libellis tuis doctissimis, <lb xml:id="p1z8"/>quos mihi quum ante persepe tum nuper etiam muneri misisti, <lb xml:id="p1z9"/>gratiam habeo quam maximam; quam utinam aliquando pro re <lb xml:id="p1z10"/>nata referre etiam queam.</s>
					<s n="5" xml:lang="la">Gratias tibi etiam eo nomine agunt <lb xml:id="p1z11"/>et uxor et filia mea, cui <persName ref="p20455">Christinae</persName> nomen est, ut quibus <lb xml:id="p1z12"/>lectos a me prius illos legendos etiam atque relegendos quasi per <lb xml:id="p1z13"/>manus tradere solitus sim.</s>
					<s n="6" xml:lang="la" ana="farewell">Bene vale, vir doctissime, sitque <lb xml:id="p1z14"/>officium <persName ref="p8113">Volmarii</persName> tui cordi tibi semper.</s>
					<s n="7" xml:lang="de"><placeName ref="l512">Tubingae</placeName> 21.<note type="margin">a.R.: undeutlich wie y/ij geschr.!</note> februarii <lb xml:id="p1z15"/>anno etc. 53.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Tui nominis studiosissimus <lb xml:id="p1z17"/><persName ref="p8113">Melior Volmarius <lb xml:id="p1z18"/>dictus Rufus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
