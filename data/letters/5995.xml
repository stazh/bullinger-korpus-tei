	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Gratiam habeo optime humanissimeque faburtu
					<lb xml:id="p1z2"/>quod tam humaniter merum agas,
					<lb xml:id="p1z3"/>consilia omnia tua mihi patrfacta velis
					<lb xml:id="p1z4"/>ego certe de Glaromentibus null tecum
					<lb xml:id="p1z5"/>(expostulabam, quem scio bonum virum
					<lb xml:id="p1z6"/>bonae fidem omnia agatur; sed ego aliquid
					<lb xml:id="p1z7"/>de schrytitsibus sum expiscatus id maximu
					<lb xml:id="p1z8"/>veteri, ne foedere nostro comprehisidantur.
					<lb xml:id="p1z9"/>sic enim putavi fore vi non magno labor
					<lb xml:id="p1z10"/>debellari possin, se dt quia in pernicunu
					<lb xml:id="p1z11"/>suam propirant. Quid facias illi iubeas mnsri
					<lb xml:id="p1z12"/>esse llibenter nulla a nobis in eos factiu
					<lb xml:id="p1z13"/>praetimissa sum officiam, si foedere excludatur
					<lb xml:id="p1z14"/>res iam integra non esit. quod ad ffircaium
					<lb xml:id="p1z15"/>attinet, non dubitabam eam mala fide tecum
					<lb xml:id="p1z16"/>omicumque agirem, et tamen tuis monitis multum
					<lb xml:id="p1z17"/>tribuebam id unum curabat, ut resciret
					<lb xml:id="p1z18"/>Hispanus cum apud nos in aliquo pretio esse
					<lb xml:id="p1z19"/>Antonius a salttibus, qui si quacturum dixcera
					<lb xml:id="p1z20"/>unum disponsium a me accepisset, quod a
					<pb/>
					<lb xml:id="p2z1"/>D Mar ixculco his diebus expectabam
					<lb xml:id="p2z2"/>efferatus, adventu istius Hispani malu
					<lb xml:id="p2z3"/>multa nobis homuncio miratur. Quod
					<lb xml:id="p2z4"/>cribis de Bregalitsibus a multis
					<lb xml:id="p2z5"/>fideque dignis accepi tanta iniudica
					<lb xml:id="p2z6"/>laborare. Hercultu, ut cuius odio in
					<lb xml:id="p2z7"/>foedus nostrum consensuri sim multi
					<lb xml:id="p2z8"/>xrgome copago opitam sua
					<lb xml:id="p2z9"/>obtulibrunt multi etiam beve spirare.
					<lb xml:id="p2z10"/>la seid videbimus. Ego hoc possum
					<lb xml:id="p2z11"/>audett legatum Hispanum, quod Iutelligus
					<lb xml:id="p2z12"/>haesto
					<lb xml:id="p2z13"/>quo numero poset apud  Istr Hercul
					<lb xml:id="p2z14"/>iussisse ei a se domum abiret
					<lb xml:id="p2z15"/>Intellexisse enim eia gratia hoctissim
					<lb xml:id="p2z16"/>invignuise minusque gratim tt quod aus consuetudi
					<lb xml:id="p2z17"/>.
					<lb xml:id="p2z18"/>Haec ego pro certo scio. Hodit
					<lb xml:id="p2z19"/>cormodius exit, cui collega et panticelle
					<lb xml:id="p2z20"/>yog.
					<lb xml:id="p2z21"/>ire et.
					<lb xml:id="p2z22"/>qitic apud Scauffostinum coetrabimus; nam
					<lb xml:id="p2z23"/>tione
					<lb xml:id="p2z24"/>in alicm finem
					<lb xml:id="p2z25"/>audio. Hispanum tantum  nos oppugnatum
					<lb xml:id="p2z26"/>mer1.
					<lb xml:id="p2z27"/>vetisse, quod Germanis principibus rex suus
					<lb xml:id="p2z28"/>S. P..
					<lb xml:id="p2z29"/>exrexitum paret. Bne vale. a  elteuram
					<lb xml:id="p2z30"/>fuissim.
					<lb xml:id="p2z31"/>Tuus em animo chestur.
				</p>
