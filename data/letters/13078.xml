			<zone xml:id="p2z3-0" points="2027,1221 2098,1246 2166,1209 2322,1199 2544,1249 2623,1203 2795,1209 2795,1159 2721,1173 2643,1146 2613,1173 2578,1137 2027,1171">2037,1203 2075,1198 2113,1195 2151,1194 2189,1193 2227,1191 2265,1191 2303,1194 2341,1192 2379,1191 2417,1191 2455,1191 2493,1191 2531,1191 2569,1191 2607,1191 2645,1189 2683,1188 2721,1187 2759,1185 2798,1188</zone>
