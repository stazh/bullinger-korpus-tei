			<div>
				<p>
					<lb xml:id="p1z1"/>Hiic clarit qudo
					<lb xml:id="p1z2"/>restaniarit certi
					<lb xml:id="p1z3"/>m as oor.
					<lb xml:id="p1z4"/>mnburenent
					<lb xml:id="p1z5"/>et gurbarit prior ecclesia
					<lb xml:id="p1z6"/>Fortassis, priusquam hae meae literae
					<lb xml:id="p1z7"/>ad te perferentur.
					<lb xml:id="p1z8"/>accipies atrocissimum
					<lb xml:id="p1z9"/>Lutheri scripta, in quo bellum hopi
					<lb xml:id="p1z10"/>oes arpiate instaurat. Nunqus
					<lb xml:id="p1z11"/>maiore impetum hanc causam egit
					<lb xml:id="p1z12"/>desino igitur sperare ecclesiarum
					<lb xml:id="p1z13"/>pacem. Tollent cristas inimici
					<lb xml:id="p1z14"/>nostri, qui defendunt dolosque monachorum
					<lb xml:id="p1z15"/>ac virsus nostrae ecclesiae magis
					<lb xml:id="p1z16"/>distrahentur, qua ex re ingentem
					<lb xml:id="p1z17"/>capeo dolorem. Nam privato periculo
					<lb xml:id="p1z18"/>quod nunc mihi impendit, itsi non
					<lb xml:id="p1z19"/>est bene. Tantum tamen non moneor
					<lb xml:id="p1z20"/>quantum ecclesiarum nostrarum et literatos
					<lb xml:id="p1z21"/>distractionibus. lege tuam epistolum sen
					<lb xml:id="p1z22"/>querelam potius, quam dedist Iosepho
					<lb xml:id="p1z23"/>Pannonio, in qua mihi, qui fueram
					<lb xml:id="p1z24"/>hortator ad quaedam dissimulanda
					<lb xml:id="p1z25"/>respondes. Sed
					<lb xml:id="p1z26"/>haec novu belli instauratio impedits, ne
					<lb xml:id="p1z27"/>quod de moderatione nunc scribam. Ben
					<lb xml:id="p1z28"/>pride cal septenbris
					<lb xml:id="p1z29"/>opus melantho.
					<pb/>
					<lb xml:id="p2z1"/>Egregia eruditione
					<lb xml:id="p2z2"/>et virtu te
					<lb xml:id="p2z3"/>praedito d.
					<lb xml:id="p2z4"/>Henrico
					<lb xml:id="p2z5"/>Buligero,
					<lb xml:id="p2z6"/>amico
					<lb xml:id="p2z7"/>suo.
