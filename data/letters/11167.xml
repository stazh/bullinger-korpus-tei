	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Quamvis annis iam aliquot nihil <lb xml:id="p1z2"/>scripseris, de animo tamen in me tuo amico ... <lb xml:id="p1z3"/>plane non dubito.</s>
					<s n="3" xml:lang="la">Quocirca veteri fretus familiaritate <lb xml:id="p1z4"/>audeo negotia tua interturbare et ex animo a te <lb xml:id="p1z5"/>petere, sanctis hisce viris Dei <persName ref="p540">Calvino</persName> et <persName ref="p1049">Pharello</persName> ad<lb xml:id="p1z6"/>sis.</s>
					<s n="4" xml:lang="la">Zelum habent nimium.</s>
					<s n="5" xml:lang="la">Sed viri sancti et docti <lb xml:id="p1z7"/>sunt quibus permultum censeo donandum esse.</s>
					<s n="6" xml:lang="la"><persName ref="p2810">Erasmus</persName> <lb xml:id="p1z8"/>poterit tibi ipsorum explicare causam.</s>
					<s n="7" xml:lang="la">Vide ne desis, <lb xml:id="p1z9"/>verum iuves interpellando et obsecrando quos nosti <lb xml:id="p1z10"/>senatores.</s>
					<s n="8" xml:lang="la">Christus Dominus rependet tibi in die iudicii.</s>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z11"/>Commenda me tuis quos semper colui et etiam nu<lb xml:id="p1z12"/>nc magn<lb xml:id="p1z13"/>i facio, quantum mea parvitate possum.</s>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z14"/>Vale cum tuis.</s>
				</p>
				<p>
					<s n="11" xml:lang="de">4. Mai. 1538.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z15"/><persName ref="p495">Heinrychus Bullingerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="13" xml:lang="la"><lb xml:id="p1z16"/>Clarissimo viro D. <persName ref="p3862">Nicolao a Wattenwyl</persName> <placeName ref="l41">Bernati</placeName> Domino suo colendissimo.</s>
				</p>
			</div>
		</body>
