	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. M[agistrum] <persName ref="p8384">Ioannem Hospinianum</persName> nondum vidi.</s>
					<s n="2" xml:lang="la">Novi non esse indoctum, de pietate ignoro.</s>
					<s n="3" xml:lang="la">Habet <lb xml:id="p1z2"/>d. <persName ref="p164">Amorbachium</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p164">Bonifacius Amerbach</persName>.</note>, quem intellexi pridem ei amicum esse.</s>
					<s n="4" xml:lang="la">Is iuvare potest.</s>
					<s n="5" xml:lang="la">Siquid ego facturus <lb xml:id="p1z3"/>sum, tuo et <persName ref="p8412">Megandri</persName> nomine facturus sum<note xml:id="fn2" type="footnote" n="2"><persName ref="p8418">Myconius</persName> bezieht sich auf ein verlorenes Empfehlungsschreiben (vgl. unten <ref target="file11679">Nr. 1636</ref>, 28f).</note>.</s>
					<s n="6" xml:lang="la">At opera mea non indiget, atque id illi proderit.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z4"/>Qui mihi placent, aliis displicent; quos promovere conor, prohibeo.</s>
					<s n="8" xml:lang="la">Hanc gratiam <lb xml:id="p1z5"/>apud doctos nostros habeo, quamvis dissimulent egregie.</s>
					<s n="9" xml:lang="la">Verum ita hactenus sensi et expertus <lb xml:id="p1z6"/>sum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Cęterum aliud esse audio, quamobrem huc se contulit; ambit puellam<note xml:id="fn3" type="footnote" ana="bio" n="3"><persName ref="p7073">Hospinian</persName> heiratete am 7. Juli <persName ref="p20737">Anna Schaffner (Curio)</persName>, Tochter von <persName ref="p6384">Valentin Curio</persName> und <persName ref="p4594">Anna Meyer zum Hirzen</persName>, Stieftochter des 1541 verstorbenen <persName ref="p20834">Johann Walder</persName> (s. <persName ref="p164">Amerbach</persName>, Korr. VI 162).</note> certe bonam.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z7"/>Quid fieri possit, plane ignoro; videant, quorum interest.</s>
					<s n="12" xml:lang="la">Ad me nonnihil pertinere visa <lb xml:id="p1z8"/>est, dum vixit avus<note xml:id="fn4" type="footnote" n="4">Bürgermeister <persName ref="p8129">Jakob Meyer</persName> (gest. 1541, s. <bibl source="b14">HBBW XI</bibl> <ref target="file11622">[Nr. 1579]</ref>, S. 338, Anm. 5).</note> et item vitricus <persName ref="p20834">Walderus</persName>; his defunctis nihil sum etc.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z9"/>Gratum est, quod scripsisti de comitiis <placeName ref="l21">Badensibus</placeName><note xml:id="fn5" type="footnote" n="5">Vgl. den Abschied der <placeName ref="l21">Badener</placeName> Tagsatzung vom 15. Mai (<bibl source="b197">EA</bibl> IV/1d 142-145).</note>; omnia nescivi praeter vaga quędam, quibus fidem <lb xml:id="p1z10"/>habere non potui.</s>
					<s n="14" xml:lang="la">Placet valde, quod tui se a <persName ref="p20225">Gallo</persName><note xml:id="fn6" type="footnote" n="6">König <persName ref="p20225">Franz I.</persName> von <placeName ref="l832">Frankreich</placeName>.</note> separant et a fautoribus eius<note xml:id="fn7" type="footnote" n="7"><placeName ref="l587">Zürich</placeName> sprach sich an der erwähnten Tagsatzung entschieden gegen die Anwerbung eidgenössischer Söldner durch <placeName ref="l832">Frankreich</placeName> aus; s. <bibl source="b197">EA</bibl> IV/1d 144 h.</note>; dignus est<note xml:id="fna" type="footnote" n="a">Nach est <hi>ein gestrichener Buchstabe.</hi></note>, <lb xml:id="p1z11"/>quem nemo non aversetur.</s>
					<s n="15" xml:lang="la">In <placeName ref="l832">Gallia</placeName> vir evangelicus<note xml:id="fn8" type="footnote" n="8">Unbekannt.</note>, postquam de Christo loqui non desineret, primo <lb xml:id="p1z12"/>linguam perdidit, dein combustus est<note xml:id="fnb" type="footnote" n="b">est <hi>über der Zeile nachgetragen.</hi></note> intra mensem.</s>
					<s n="16" xml:lang="la">Adeo constat convenire<pb type="edition" next="94"/> inter <persName ref="p18593">Turcam</persName><note xml:id="fn9" type="footnote" n="9">Sultan <persName ref="p18593">Suleiman I.</persName></note> et <persName ref="p20225">Gallum</persName><note xml:id="fn10" type="footnote" n="10">Zu den Verhandlungen <placeName ref="l832">Frankreichs</placeName> mit der Pforte vgl. oben <ref target="file11674">Nr. 1631</ref>, Anm. 5.</note>, <lb xml:id="p1z13"/>ut nec <placeName ref="l832">Galli</placeName> dissimulent.</s>
					<s n="17" xml:lang="la">Age, dominus utrunque suo tempore visitabit.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z14"/>Rumores sunt cęsarianos castrametasse ante <placeName ref="l1074">Budam</placeName>, sed nihil audere, <persName ref="p18593">Turcam</persName> petere in<lb xml:id="p1z15"/>ducias, at neminem dare, Boemos ingenti multitudine adesse valde alacres, sed prohiberi, ne <lb xml:id="p1z16"/>hostem obpugnent temere; periculum enim esse, ut fallantur.</s>
					<s n="19" xml:lang="la">Si successerit, in periculo stamus, sin aliter, <lb xml:id="p1z17"/>iterum instat damnum.</s>
					<s n="20" xml:lang="la">Quicquid eveniat, inter nos magis discordabimus.</s>
					<s n="21" xml:lang="la">Utinam dominus <lb xml:id="p1z18"/>stet a nobis!</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z19"/>De adulescentibus<note xml:id="fn11" type="footnote" n="11">Unbekannt.</note> diligenter inquiro; si invenero, dicam.</s>
					<s n="23" xml:lang="la">Non queo pluribus tecum colloqui, quod synodus <lb xml:id="p1z20"/>futura<note xml:id="fn12" type="footnote" n="12">Zur Synode vom 12. Juni 1542 s. unten <ref target="file11687">Nr. 1644</ref>, Anm. 32.</note> ocium omne tollit.</s>
				</p>
				<p>
					<s n="24" xml:lang="la" ana="farewell">Vale cum tuis omnibus in Christo.</s>
					<s n="25" xml:lang="la" ana="salute"><persName ref="p8412">Gasparem</persName><note xml:id="fn13" type="footnote" n="13"><persName ref="p8412">Kaspar Megander</persName>.</note> salutabis diligenter meo <lb xml:id="p1z21"/>nomine, <persName ref="p8171">Theodorum</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p8171">Theodor Bibliander</persName>.</note> item et <persName ref="p8127">Pellicanum</persName>.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><placeName ref="l28">Basileę</placeName>, 8. iunii anno 1542.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><persName ref="p8418">Os. <lb xml:id="p1z22"/>Myconius</persName> tuus.</s>
				</p>
				<p>
					<s n="28" xml:lang="la">Si votum meum recipies, <persName ref="p1888">Lavaterum</persName> creabi<lb xml:id="p1z23"/>s in <lb xml:id="p1z25"/>consulem<note xml:id="fn15" type="footnote" n="15">Zum Nachfolger des am 7. April verstorbenen <placeName ref="l587">Zürcher</placeName> Bürgermeisters <persName ref="p6965">Heinrich Walder</persName> wurde nicht <persName ref="p1888">Hans Rudolf Lavater</persName>, sondern <persName ref="p1419">Johannes Haab</persName> gewählt; s. C[onrad] <hi>Escher,</hi> Bürgermeister Johannes Haab (1503-1561), in: <bibl source="b709">ZTB</bibl> 1903, NF 26, S. 25; <bibl source="b577">Schnyder, Ratslisten</bibl> 303, untere Anm. 1 (vgl. auch oben <ref target="file11677">Nr. 1634</ref> und unten <ref target="file11679">Nr. 1636</ref>, 1-4).</note> etc.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="29" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho Bullingero</persName> <lb xml:id="p2z2"/>doctissimo, in domino <lb xml:id="p2z3"/>suo.</s>
					<s n="30" xml:lang="de"><placeName ref="l587">Zü[ric]h</placeName><note xml:id="fnc" type="footnote" n="c"><hi>Teilweise auf das nicht mehr vorhandene Verschlussband geschrieben.</hi></note>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>