	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gracia et pax etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Ego et <persName ref="p264">Benedictus</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p264">Benedikt Burgauer</persName>.</note> una destinati sumus <placeName ref="l28">Basileam</placeName><note xml:id="fn2" type="footnote" n="2">Vgl. oben <ref target="file10762">Nr. 724</ref>, Anm. 3; zu den Einladungsschreiben <placeName ref="l28">Basels</placeName> an <placeName ref="l587">Zürich</placeName> vom 4. Januar und <placeName ref="l587">Zürichs</placeName> an <placeName ref="l441">Schaffhausen</placeName> vom 10. Januar vgl. <bibl source="b197">EA</bibl> IV/1c 598.</note> - comites erunt consul <lb xml:id="p1z2"/>Waldkilchius et ex tribunis unus<note xml:id="fn3" type="footnote" n="3">Zunftmeister <persName ref="p21394">Hans Schmid</persName> (s. <persName ref="p3067">Stumpf</persName>, Abendmahlsstreit 75).</note> -, ea tamen lege, quod ego et <persName ref="p264">Benedictus</persName> proprio et reliquorum <lb xml:id="p1z3"/>conpresbiterorum sumptu pergamus.</s>
					<s n="3" xml:lang="la">Viden, charissime frater, et prudentiam et pietatem nostri senatus?</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Decreverant, quod neminem illuc vellent mittere ex ministris, sed tantum ex senatoribus duos.</s>
					<s n="5" xml:lang="la">Nescio, <lb xml:id="p1z5"/>quid tandem illis in mentem venerit, quod et nos addiderunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Tu vero fac me cerciorem, quos nodos<note xml:id="fn4" type="footnote" n="4">Vgl. <bibl source="b473">Otto</bibl> 244, Nr. 1233.</note> <lb xml:id="p1z6"/>tractaturi simus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell"><pb type="edition" next="73"/>Vale, 15. ianuarii 1536.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z7"/><persName ref="p2810">Erasmus Ritter</persName>, <lb xml:id="p1z8"/>ex animo tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="9" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem wolgelerten herren Meister <lb xml:id="p2z2"/><persName ref="p495">Heinrich Bullinger</persName>, predicanten zuͦ <lb xml:id="p2z3"/><placeName ref="l587">Zurich</placeName>, minem lieben herren und <lb xml:id="p2z4"/>guͦten freundt.</s>
				</p>
			</div>
		</body>
