	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi tua, quae misisti, omnia et ago tibi pro his <lb xml:id="p1z2"/>ingentes gratias.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Quae de concilii actis, legi et postea <lb xml:id="p1z3"/>dedi domino a <persName ref="p7682">Mülinen</persName>; monui etiam, ut, si quid respondere <lb xml:id="p1z4"/>vellet, ad me mittat; sed nihildum misit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Quae de <placeName ref="l2478">Sabaudici</placeName> legati apud nos actis scribis, in<lb xml:id="p1z6"/>dicavi d. <persName ref="p8063">Steigero</persName>; is mihi retulit eadem istum <lb xml:id="p1z7"/>legatum hic quoque proposuisse et indicasse nostris, quod <lb xml:id="p1z8"/>de hac iniuria apud omnes Helvetiorum pagos conqueri <lb xml:id="p1z9"/>velit.</s>
					<s n="5" xml:lang="la">Nostri arbitrantur rem esse fictam; interea <lb xml:id="p1z10"/>in medio relinquunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><placeName ref="l167">Genevenses</placeName> se satis purgare <lb xml:id="p1z11"/>poterunt, si sint innocentes.</s>
					<s n="7" xml:lang="la">A nostris autem praeter omnem <lb xml:id="p1z12"/>expectationem de novo denuo impetravit, ut con<lb xml:id="p1z13"/>ventus utriusque partis <placeName ref="l1860">Neoduni</placeName> ad calendas maii <lb xml:id="p1z14"/>concessus et institutus sit; agetur ibi de religione <lb xml:id="p1z15"/>restituendorum et de <placeName ref="l646">Glaronensibus</placeName>.</s>
					<s n="8" xml:lang="la">Utinam, si pax fieri pos<lb xml:id="p1z16"/>sit, <placeName ref="l167">Genevenses</placeName> se ei quoque accommodent; alioqui vereor, <lb xml:id="p1z17"/>ne grave tandem bellum sibi et nobis sint conciliaturi.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/>Ex <placeName ref="l832">Gallia</placeName> porro nunc nihil habemus, nisi quod <lb xml:id="p1z19"/>rex certo nunciatur <placeName ref="l301">Lugdunum</placeName> venturus; id quare futurum <lb xml:id="p1z20"/>sit, varie a multis exponitur.</s>
					<s n="10" xml:lang="la">Faxit dominus, ne quid mali <lb xml:id="p1z21"/>secum afferat!</s>
					<s n="11" xml:lang="la">Ex <placeName ref="l822">Germania</placeName> nihil habemus mercatori<lb xml:id="p1z22"/>bus nostris ex nundinis <placeName ref="l157">Franck[ofordensibus]</placeName> nondum reversis.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Tu <lb xml:id="p1z23"/>si quid inde aut ex <placeName ref="l830">Anglia</placeName> acceperis, impertias nobis <lb xml:id="p1z24"/>quoque, obsecro.</s>
					<s n="13" xml:lang="la">Caeterum his diebus domino <persName ref="p8063">Steigero</persName> biennis <lb xml:id="p1z25"/>consulatus sui completo <persName ref="p2305">Negelinus</persName> iterum successit.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z26"/>D. <persName ref="p3494">Nicolaus Diesbachius</persName>, compater et amicus summus <lb xml:id="p1z27"/>noster, iterum ad diacosios et crastina mox veteri <lb xml:id="p1z28"/>suo loco in senatu restitutus est cum summa bonorum <lb xml:id="p1z29"/>omnium congratulatione; lecti sunt praeterea de novo in <lb xml:id="p1z30"/>senatum d. <persName ref="p20306">Albertus ab Erlach</persName>, <persName>Germanus Gentsch</persName> <lb xml:id="p1z31"/>et <persName>Ioannes Müller</persName>.</s>
					<s n="15" xml:lang="la">Literas <persName ref="p8009">Fabritii</persName> et comitis <lb xml:id="p1z32"/><persName>Martinengi</persName> tibi remitto et ago gratias; simul etiam remitto <lb xml:id="p1z33"/>axiomata illa <placeName ref="l512">Tubingensia</placeName>, cuius sane theologię <lb xml:id="p1z34"/>perplexitatem ego intelligere nequeo.</s>
					<s n="16" xml:lang="la">Neque enim <lb xml:id="p1z35"/>vel in scripturis vel in patribus talem confusionem <lb xml:id="p1z36"/>invenio; quae modo aiunt, mox negant et Christo <lb xml:id="p1z37"/>triplex corpus tribuunt ex eoque <persName>Geryona</persName> quendam <lb xml:id="p1z38"/>tricorporeum constituunt.</s>
					<s n="17" xml:lang="la">Dominus misereatur huius <lb xml:id="p1z39"/>coecitatis et veritatem suam simplicem universo <lb xml:id="p1z40"/>orbi manifestet.</s>
					<s n="18" xml:lang="de">Amen.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><persName ref="p458">Brentii</persName> librum nondum <lb xml:id="p1z41"/>vidi nec cupio videre; venter enim et universa <lb xml:id="p1z42"/>intestina mihi dolent, quoties eiusmodi lego.</s>
					<s n="20" xml:lang="la">Gratum <lb xml:id="p1z43"/>tamen fuit, quod ista ad me miseris, ut possem monstr<lb xml:id="p1z44"/>are hic, qui de gynęis istis tanquam <placeName ref="l41">Bernatibus</placeName> <lb xml:id="p1z45"/>gloriantur.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="salute">D. <persName ref="p8012">Hallerus</persName>, cui post prius infortunium <lb xml:id="p1z46"/>aliud adhuc non minus grave accidit, sicut ex fratre <lb xml:id="p1z47"/>meo cognosces, te salutat; patienter omnia suscipit.</s>
					<s n="22" xml:lang="la" ana="salute"><lb xml:id="p1z48"/>Salutant te quoque d. <persName ref="p8063">Steigerus</persName>, <persName ref="p3494">Diesbachius</persName>, socer, uxor, <lb xml:id="p1z49"/>fratres denique et amici omnes.</s>
					<s n="23" xml:lang="la">Salvi sint uxor, filii, filię <lb xml:id="p1z50"/>generique omnes.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Dominus nos custodiat ab omni malo teque <lb xml:id="p1z51"/>inprimis nobis quam diutissime servet incolumem.</s>
				</p>
				<p>
					<s n="25" xml:lang="de">Amen.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p1z52"/><placeName ref="l41">Bernae</placeName> 6. aprilis 1564.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><persName ref="p8018">I<lb xml:id="p1z53"/>[ohannes] Hallerus</persName> tuus.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, domino <lb xml:id="p2z4"/>suo honorando et com<lb xml:id="p2z5"/>patri charissimo.</s>
				</p>
			</div>
		</body>
