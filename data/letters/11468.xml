	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Satis, ut opinor, copiose de rebus meis proxime ad te scripsi<note xml:id="fn1" type="footnote" n="1">Am 15. September; s. oben <ref target="file11463">Nr. 1420</ref>.</note>, pater colendiss<lb xml:id="p1z2"/>ime; non tamen possum, quin et nunc de rebus meis te certiorem faciam, praesertim <lb xml:id="p1z3"/>cum non dubitem res meas tibi ex animo curae esse.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Agimus<note xml:id="fn2" type="footnote" n="2">Gemeint sind neben <persName ref="p8011">Gwalther</persName> dessen Studienkollegen <persName ref="p8018">Haller</persName>, <persName ref="p8461">Wick</persName> und <persName ref="p3988">Wolf</persName>.</note> itaque hic more con<lb xml:id="p1z4"/>sueto, paupere videlicet et tenui, spe omni<note xml:id="fna" type="footnote" n="a"><hi>korrigiert aus</hi> spem omnem.</note> in scholarcharum<note xml:id="fn3" type="footnote" n="3">Zu den Schulverordneten vgl. oben <ref target="file11417">Nr. 1374</ref>, Anm. 1.</note> liberalitate intenti; <lb xml:id="p1z5"/>quod enim me attinet, quod aliud sperem, non habeo.</s>
					<s n="4" xml:lang="la">Quod utinam ipsi tam bene atque <lb xml:id="p1z6"/>tu vel ego consyderarent nec me cum aliis conferrent, cum me<note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> me <hi>ein gestrichenes Zeichen.</hi></note> omnium tam <lb xml:id="p1z7"/>parentum quam cognatorum auxilio destitutum cognoscant.</s>
					<s n="5" xml:lang="la">Sed hęc saepius inculcare <lb xml:id="p1z8"/>non opus est.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Spem mihi literę<note xml:id="fn4" type="footnote" n="4">Nicht erhalten.</note> tuę de <persName ref="p5985">Nuscheleri</persName><note xml:id="fn5" type="footnote" n="5">Stiftsverwalter <persName ref="p5985">Heinrich Nüscheler</persName>.</note> benevolentia fecerunt, qui si sic <lb xml:id="p1z9"/>perrexerit,<pb type="edition" next="172"/> comperiet sane non in ingratum se hoc beneficii collocasse.</s>
					<s n="7" xml:lang="la">Curabo etenim, <lb xml:id="p1z10"/>quoad<note xml:id="fnc" type="footnote" n="c"><hi>in der Vorlage</hi> quo ad.</note> possum, ut et illius et omnium vestrorum de me expectationi satisfaciam.</s>
					<s n="8" xml:lang="la">Tu, quaeso, ipsum <lb xml:id="p1z11"/>hortare et roga, quo in mihi commodando sit facilior.</s>
					<s n="9" xml:lang="la">De <persName ref="p4851">Froschouero</persName> mutuum daturo <lb xml:id="p1z12"/>scripseras.</s>
					<s n="10" xml:lang="la">Ego cum eum aut aliis incommoditatibus impeditum aut alioquin <lb xml:id="p1z13"/>non promptum viderem, importunius urgere nolui.</s>
					<s n="11" xml:lang="la">Accepi ab eo florenos undecim<lb xml:id="p1z14"/>, quos<note xml:id="fnd" type="footnote" n="d"><hi>vor</hi> quos <hi>gestrichenes</hi> solvi[?].</note> solos dixit sibi commendatos esse, ut mihi daret, quin etiam interdictum <lb xml:id="p1z15"/>a te dicebat, ne quid adderet, quamvis hoc falsum esse sciam et ex literis <lb xml:id="p1z16"/>tuis facile colligere possim.</s>
					<s n="12" xml:lang="la">Eo tandem perventum est, ut <persName ref="p4676">Egenolphum</persName> nobis providere <lb xml:id="p1z17"/>iuberet.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Hac nos re contenti <placeName ref="l157">Frankfordia</placeName> discessimus.</s>
					<s n="14" xml:lang="la">Nunc vero <persName ref="p4676">Egenolphus</persName> <lb xml:id="p1z18"/>singulis 5 florenos <persName ref="p4851">Froschoueri</persName><note xml:id="fne" type="footnote" n="e"><hi>vor</hi> <persName ref="p4851">Froschoueri</persName> <hi>gestrichenes</hi> ex.</note> nomine daturos[!] promittit nec illum plus iussisse<note xml:id="fnf" type="footnote" n="f"><hi>in der Vorlage</hi> iusisse.</note> <lb xml:id="p1z19"/>affirmat, quod et illius chirographo<note xml:id="fn6" type="footnote" n="6">Nicht erhalten.</note> ad nos misso testatus est.</s>
					<s n="15" xml:lang="la">Quę res certe non <lb xml:id="p1z20"/>parum nos affligit, cum tam procul a patria remotis non melior spes (praesertim hoc <lb xml:id="p1z21"/>turbulentissimo rerum statu) usquam appareat<note xml:id="fng" type="footnote" n="g"><hi>korrigiert aus</hi> apparet.</note>.</s>
					<s n="16" xml:lang="la">Quid enim vivemus aut unde, cum <lb xml:id="p1z22"/>e meis nummis hyemales vestes emere coactus sim, sodales vero me etiam minus nummorum <lb xml:id="p1z23"/>habeant<note xml:id="fn7" type="footnote" n="7"><persName ref="p8011">Gwalthers</persName> Stipendium war im Frühjahr erhöht worden; vgl. oben <ref target="file11425">Nr. 1382</ref>, Anm. 6.</note>?</s>
					<s n="17" xml:lang="la">Spem mihi maiorem facit <persName ref="p4676">Egenolphi</persName> humanitas; quę si nos quoque <lb xml:id="p1z24"/>fefellerit, quid agamus, incertum est.</s>
					<s n="18" xml:lang="la">Quare, pater charissime, te vęhementer rogito, <lb xml:id="p1z25"/>ut cum<note xml:id="fnh" type="footnote" n="h">cum <hi>über der Zeile nachgetragen.</hi></note> <persName ref="p5985">Nuschelero</persName> nomine meo agere digneris, ut vel hoc futuro anno nummos aliquot <lb xml:id="p1z26"/>mutuo dare dignetur.</s>
					<s n="19" xml:lang="la">Ego pro meis viribus conabor, ne in me aut gratitudinem <lb xml:id="p1z27"/>aut boni iuvenis officium desideret.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z28"/>Quod de Davidis monomachia <lb xml:id="p1z29"/>ad me scripseras<note xml:id="fn8" type="footnote" n="8">Vgl. oben <ref target="file11463">Nr. 1420</ref>, Anm. 7.</note>, diligenter curo totusque in hoc sum, ut ad proximas nundinas<note xml:id="fn9" type="footnote" n="9">Vgl. oben <ref target="file11433">Nr. 1390</ref>, Anm. 9.</note> <lb xml:id="p1z30"/>absolvam.</s>
					<s n="21" xml:lang="la">Librum primum perfeci.</s>
					<s n="22" xml:lang="la">In tres enim libros totum opus dividere <lb xml:id="p1z31"/>statui.</s>
					<s n="23" xml:lang="la">Quorum primus utriusque populi expeditionem, castrorum situs, armorum <lb xml:id="p1z32"/>et ipsius Goliath descriptionem continet.</s>
					<s n="24" xml:lang="la">Monomachiam absolvet secundus.</s>
					<s n="25" xml:lang="la"><lb xml:id="p1z33"/>Allegoricę autem expositiones tertio describentur.</s>
					<s n="26" xml:lang="la">Scripsi praeterea aliquot heroinas <lb xml:id="p1z34"/>epistolas<note xml:id="fn10" type="footnote" n="10">Vgl. oben <ref target="file11463">Nr. 1420</ref>, Anm. 10.</note>, quas in fine subiicere statui.</s>
					<s n="27" xml:lang="la">Eas vero cui<note xml:id="fni" type="footnote" n="i"><hi>vor</hi> cui <hi>ein gestrichener Buchstabe.</hi></note> dedicem, dubito.</s>
					<s n="28" xml:lang="la">Tu, <lb xml:id="p1z35"/>quaeso, consule, an <persName ref="p5985">Nuschelero</persName> potius aut M. <persName ref="p8447">Wernhero Lithonio</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p8447">Werner Steiner</persName>.</note> dedicandę sint; <lb xml:id="p1z36"/>hi enim inter alios maxime occurrunt.</s>
					<s n="29" xml:lang="la">Monomachiam vero tibi cum aliis <lb xml:id="p1z37"/>scholarchis commendabo.</s>
				</p>
				<p>
					<s n="30" xml:lang="la">Quare te rogatum velim, ut aliorum nomina proximis <lb xml:id="p1z38"/>nundinis ad me mittas.</s>
					<s n="31" xml:lang="la">Tunc enim <persName ref="p4851">Froschouero</persName> omnia, ut excudat, <lb xml:id="p1z39"/>commendabo.</s>
				</p>
				<p>
					<s n="32" xml:lang="la">Nos hic defunctum lugemus <placeName ref="l822">Germanię</placeName> decus <persName ref="p17891">Eobanum</persName>, <lb xml:id="p1z40"/>virum sanctissimum, qui quarto octobris non sine summo dolore meo obiit.</s>
					<s n="33" xml:lang="la">Solus <lb xml:id="p1z41"/>enim<pb type="edition" next="173"/> erat, qui singulari me benevolentia prosequebatur.</s>
					<s n="34" xml:lang="la">Scripsi in eius obitum epicedion, <lb xml:id="p1z42"/>quod forsitan brevi imprimetur<note xml:id="fn12" type="footnote" n="12"><persName ref="p8011">Gwalthers</persName> Epicedium auf <persName ref="p17891">Hessus</persName>, das an <persName ref="p495">Bullinger</persName> gerichtet war, fand zusammen mit vier kürzeren Trauergedichten Eingang in die bei <persName ref="p4676">Egenolff</persName> in <placeName ref="l311">Marburg</placeName> gedruckte Sammlung "Epitaphia aliquot epigrammata in mortem ... Helii <persName ref="p17891">Eobani Hessi</persName>" (vgl. Carl <hi>Krause,</hi> Helius Eobanus Hessus. Sein Leben und seine Werke, Gotha 1879 [Nachdruck Nieuwkoop 1963], Bd. 2, S. 262f). Die gleichen Gedichte sind auch im Anhang zu <persName ref="p8011">Gwalthers</persName> "Monomachia Davidis et Goliae" (vgl. oben Z. 32-37) abgedruckt.</note>.</s>
					<s n="35" xml:lang="la">Sic enim vult praeceptor noster communis <lb xml:id="p1z43"/>d. <persName ref="p18135">Lonicerus</persName>.</s>
				</p>
				<p>
					<s n="36" xml:lang="la"><persName ref="p3590">Princeps</persName> <placeName ref="l213">Hassię</placeName><note xml:id="fn13" type="footnote" n="13"><persName ref="p3590">Landgraf Philipp</persName>.</note> propter pestem <placeName ref="l244">Cassellis</placeName> grassantem huc <lb xml:id="p1z44"/>confugit.</s>
					<s n="37" xml:lang="la">Novi praeterea non multum.</s>
					<s n="38" xml:lang="la">Rerum enim incertas vices et <lb xml:id="p1z45"/>regnorum perturbationes, quae hoc nostro sęculo communes sunt, nihil novi duxero.</s>
					<s n="39" xml:lang="la"><lb xml:id="p1z46"/><persName ref="p18538">Cęsarem</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p18538">Karl V.</persName></note> <placeName ref="l569">Wormatiam</placeName> venturum audio, idem nimirum acturus, quod aliis co<lb xml:id="p1z47"/>mitiis actum est.</s>
					<s n="40" xml:lang="la"><placeName ref="l2448">Quinque Paganos</placeName><note xml:id="fn15" type="footnote" n="15">die <placeName ref="l2448">Fünf Orte</placeName>.</note> tumultuari<note xml:id="fnk" type="footnote" n="k"><hi>vor</hi> tumultuari <hi>gestrichenes</hi> hic.</note> hic audimus<note xml:id="fn16" type="footnote" n="16">Die Gerüchte über einen bevorstehenden Überfall der katholischen Orte auf <placeName ref="l572">Württemberg</placeName> (vgl. <bibl source="b480">PC</bibl> III 99. 104. 110f) hatten ihren realen Hintergrund in der Neigung der <placeName ref="l2542">Sieben Orte</placeName>, zugunsten von <placeName ref="l431">Rottweil</placeName> in die Landenberger Fehde einzugreifen (s. <bibl source="b197">EA</bibl> IV/1c 1239f [n, p]. 1245 [b, f]. 1267-1270). Vgl. auch unten <ref target="file11473">Nr. 1430</ref>, 64-67; 1435, 36f; 1436, 54-75.</note>.</s>
					<s n="41" xml:lang="la"><lb xml:id="p1z48"/>Utinam tandem domini iusto perdantur iuditio!</s>
					<s n="42" xml:lang="la">Metuo tamen, ne et nos <lb xml:id="p1z49"/>propter nimiam, quę nobis cum illis est, consuetudinem, imo et confoederationem <lb xml:id="p1z50"/>poenas cum illis condignas sentiamus.</s>
					<s n="43" xml:lang="la">Quod omnino futurum animus mihi <lb xml:id="p1z51"/>praedicit.</s>
				</p>
				<p>
					<s n="44" xml:lang="la">Utinam falsus hic vates sim!</s>
				</p>
				<p>
					<s n="45" xml:lang="la" ana="salute">Salutabis nomine meo <persName ref="p8051">uxorem</persName><note xml:id="fn17" type="footnote" ana="bio" n="17"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> <lb xml:id="p1z52"/>et <persName ref="p7042">matrem</persName><note xml:id="fn18" type="footnote" ana="bio" n="18"><persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note> tuam cum omni familia, d. <persName ref="p167">Ammianum</persName> quoque et <persName ref="p4554">Collinum</persName>.</s>
					<s n="46" xml:lang="la" ana="farewell"><lb xml:id="p1z53"/>Vale, pater mi, et me tibi commendatum, ut soles, habeto.</s>
				</p>
				<p>
					<s n="47" xml:lang="la"><placeName ref="l311">Marpurgi</placeName>, pridie idus octobris <lb xml:id="p1z54"/>1540<lb xml:id="p1z55"/>.</s>
				</p>
				<p>
					<s n="48" xml:lang="la">Tui<note xml:id="fnl" type="footnote" n="l"><hi>vor</hi> Tui <hi>gestrichenes</hi> T totu.</note> observantissimus <persName ref="p8011">R. G.</persName></s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="49" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, patri <lb xml:id="p2z3"/>suo imprimis colendo.</s>
					<s n="50" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
