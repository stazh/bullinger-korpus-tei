	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Iam quartum scribo, sed nihil scio te literarum accepisse adhuc; acci<lb xml:id="p1z2"/>pies autem brevi; nam literę in vas venerunt non data opera, sed forte fortuna.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/><placeName ref="l303">Magdenburgenses</placeName> adhuc constantes sunt; confluunt ad illos milites, quos nolunt suscipere; <lb xml:id="p1z4"/>nam nolunt se gravare impio milite.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><placeName ref="l701">Mechelburgensi</placeName> damnum magnum intulerunt <lb xml:id="p1z5"/>et blochhuß everterunt.</s>
					<s n="5" xml:lang="la">Dein[de] frater ducis regiones sibi vendicat, quam frater <lb xml:id="p1z6"/>bellator hactenus habuit; fortassis dolo agit, ne <placeName ref="l303">Magdenburgenses</placeName> aut alię civitates <lb xml:id="p1z7"/>igne perdant ducis pagos et oppidula.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><persName ref="p18538">Caesarem</persName> aiunt milites conscribere in subsidiumque <lb xml:id="p1z8"/>missurum ducibus adversariis <placeName ref="l303">Magdenburgensium</placeName>.</s>
					<s n="7" xml:lang="la">Simulat se in <placeName ref="l882">Ungaria</placeName> habere negotium <lb xml:id="p1z9"/>cum <placeName ref="l2510">Turca</placeName>; sed quis credet?</s>
					<s n="8" xml:lang="la">Hactenus pulchre eo titulo emulgere solitus est <lb xml:id="p1z10"/>pecunias ab omnibus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Quid sibi hoc vult?</s>
					<s n="10" xml:lang="la">Duo miliaria a <placeName ref="l28">Basilea</placeName> est locus <lb xml:id="p1z11"/>aut praefectura <placeName ref="l1839">Salamantis</placeName><note type="margin">a.R.: <placeName ref="l1839">Salamancę</placeName>?</note> demortui, in qua prohibitum est rusticis, ne porcos <lb xml:id="p1z12"/>vendant; <foreign xml:lang="de">dann sy sollens in ire eygene hüser schlagen bey einer grossen straff.</foreign></s>
					<s n="11" xml:lang="la">Quid <lb xml:id="p1z13"/>putas conari <persName ref="p18477">Ferdinandinos</persName>?</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Et nos in causa sumus propter dissensiones intestinas; <lb xml:id="p1z14"/>alias facile resisteremus iis hominibus, qui nobis quotidie facessunt negotium.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z15"/>Accipies brevi <persName ref="p5004">Grebelum</persName>, fortassis a <persName ref="p4851">Froscovero</persName>; in vas enim illius inclusus <lb xml:id="p1z16"/>est liber cum cultris.</s>
					<s n="14" xml:lang="la">In <placeName ref="l830">Anglia</placeName> aiunt consultationes fieri de evangelio <placeName ref="l832">Gallis</placeName> <lb xml:id="p1z17"/>obtrudendo, et rex omnem pecuniam, quam <persName ref="p8112">Gallus</persName> ei debet iam a multis annis, <lb xml:id="p1z18"/>vult <persName ref="p8112">Gallo</persName> donare, saltem ut Christum recipiat <persName ref="p8112">Gallus</persName> suam in ditionem.</s>
					<s n="15" xml:lang="la">Deinde fędus perpetuum cum <lb xml:id="p1z19"/>eo instituet etc.</s>
					<s n="16" xml:lang="la">De hac re certiora fortassis brevi audiemus.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z20"/><placeName ref="l28">Basileae</placeName> 7. decembris 1550.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z21"/>T[uus] <persName ref="p1278">Gastius</persName> ex animo.</s>
				</p>
				<p>
