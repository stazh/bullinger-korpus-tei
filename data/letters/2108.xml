	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Valde miror, quid tam altum de rerum Germanicarum statu <lb xml:id="p1z2"/>silentium daturum sit tandem; vix enim tam diu unquam antehac <lb xml:id="p1z4"/>etiam nostri ex <placeName ref="l822">Germania</placeName> minus acceperunt.</s>
					<s n="3" xml:lang="la">Sed dubium non est monstri aliquid <lb xml:id="p1z5"/>imperatorem alere neque <persName ref="p8371">Albertum</persName> facile quieturum cum <persName ref="p20318">Heinrico Brunsvicesni</persName>, <lb xml:id="p1z6"/>nisi utrumque fragat pectus domini manus.</s>
					<s n="4" xml:lang="la">Ex <placeName ref="l832">Gallia</placeName> accepi die <lb xml:id="p1z7"/>hesterna ex filio<note xml:id="fna" type="footnote" n="a">Ein Sohn von Gabriel Arnold hieß Matthäus (dieser starb 1572); s. Markus Nadler, Neuburg an der Donau, München 2004, S. 233.</note> <persName ref="p182">Gabrielis Arnoldi</persName> virum quendam doctrina pietateque <lb xml:id="p1z8"/>insignem ustulatione horribili sublatum esse, sed infracta constantia animi <lb xml:id="p1z9"/>perdurasse in finem.</s>
					<s n="5" xml:lang="la">Similia narrant et alii complures.</s>
					<s n="6" xml:lang="la">Dedit vero <lb xml:id="p1z10"/>idem <persName>Gallus</persName> etiam ab <placeName ref="l862">Helvetiorum</placeName> discessu longe lateque incendia <lb xml:id="p1z11"/>adusque <placeName ref="l1284">Bruxellam</placeName> fere, quibus consumptos aiunt bis mille pagos e<lb xml:id="p1z12"/>t commeatus frum<lb xml:id="p1z13"/>entorumque tantam copiam, quanta toti Helvetiae in annum alendę <lb xml:id="p1z14"/>suffecisset.</s>
					<s n="7" xml:lang="la">Unde miseri agricolae cum suis in sylvis hybernare coguntur <lb xml:id="p1z15"/>et alii fame contabescunt alli ad latrocinia et praedationes convertuntur, <lb xml:id="p1z16"/>nullae ut sint viae tutae amplius in longis admodum terrarum <lb xml:id="p1z17"/>spaciis.</s>
					<s n="8" xml:lang="la">Hi fructus bellorum sunt, a quorum commercio <lb xml:id="p1z18"/>utinam nos essemus immunes.</s>
					<s n="9" xml:lang="la">Porro, dum haec scribo, accipio <lb xml:id="p1z19"/>ex <placeName ref="l18">Augusta</placeName> copias <persName ref="p8371">Alberti</persName>, quas habuit in oppido <placeName>Liechtenfeld</placeName>, <lb xml:id="p1z20"/>9 vexilla, in deditionem venisse et potestatem <persName ref="p20318">H[einrici] Brunsvicensis</persName>, <lb xml:id="p1z21"/>capitaneos duos capite truncatos, reliquos vero exutos armis <lb xml:id="p1z22"/>iurare coactos deinceps se <persName ref="p8371">Alberto</persName> nunquam, contra imperatorem vero, <lb xml:id="p1z23"/><persName ref="p18477">Ferdinandum</persName> et confoederatos intra annum non militaturos atque ea <lb xml:id="p1z24"/>re animadversa <persName ref="p8371">Albertum</persName> cum 2000 equitibus <placeName ref="l1031">Swinfurtum</placeName> confugisse <lb xml:id="p1z25"/>et oppidum prius munitum praesidio 12 vexillorum vehementius firmare <lb xml:id="p1z26"/>et denuo se ad resistendum parare.</s>
					<s n="10" xml:lang="la">Perrexit vero <persName ref="p20318">H[einricus] Brunsvicensis</persName> <lb xml:id="p1z27"/>ad occupandam <placeName>Alberti</placeName> ditionem, in qua Berreut iam obtinuit <lb xml:id="p1z28"/>et obsidione cinxit <placeName>Blasemberg</placeName>, quod invictum existimatur, <lb xml:id="p1z29"/>nisi fame potius quam armis expugnetur.</s>
					<s n="11" xml:lang="la"><persName ref="p18554">Reginam Angliae</persName> <lb xml:id="p1z30"/>aut regnum potius ambiunt proci filius imperatoris, filius <persName ref="p18477">Ferdinandi</persName> et <persName ref="p18536">Sabaudus</persName>, <lb xml:id="p1z31"/>ut ferunt; sed resistere dicuntur <placeName ref="l830">Angli</placeName> et nunquam concessuri, ut <lb xml:id="p1z32"/>alienigena rerum apud ipsos potiatur.</s>
					<s n="12" xml:lang="la">De <placeName ref="l2510">Turca</placeName> et <placeName>Vercellis</placeName> <lb xml:id="p1z33"/>nil dicebat se <persName>Copus</persName> habere, quare cupio, ut scribas, <lb xml:id="p1z34"/>si quae habes.</s>
					<s n="13" xml:lang="la" ana="farewell">Sed vale cum tuis.</s>
					<s n="14" xml:lang="de"><placeName ref="l28">Basileae</placeName> 13. decembris (1553)<note type="misc">Die Jahreszahl ist von anderer Hand beigesetzt.</note>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z35"/>T[uus] <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio viro d. <persName ref="p495">Heinrich<lb xml:id="p2z2"/>o <lb xml:id="p2z3"/>Bullingero</persName>, domino <lb xml:id="p2z4"/>et fratri observan<lb xml:id="p2z5"/>dissimo <lb xml:id="p2z6"/>suo.</s>
				</p>
			</div>
