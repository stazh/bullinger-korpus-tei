	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a deo patre per Christum servatorem etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><persName ref="p6939">Iacobus</persName> noster, <lb xml:id="p1z2"/>cum nuper ad vos esset, rediens non potuit satis praedicare miram et eximi<lb xml:id="p1z3"/>am humanitatem, quam ipsi exhibuistis.</s>
					<s n="3" xml:lang="la">Quod <lb xml:id="p1z4"/>duplici nomine nobis gratum est, primum quod in ea, qua hactenus <lb xml:id="p1z5"/>erga nos usi estis, et benevolentia et humanitate constanter per<lb xml:id="p1z6"/>severatis, alterum quod persuasum habemus nos tantum apud vos <lb xml:id="p1z7"/>posse, quod nullius aequi ac iusti repulsam simus laturi.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Expertus igitur cum sim praesertim in te, <persName ref="p495">Bullingere</persName> humanissime, <lb xml:id="p1z9"/>eam erga nos benevolentiam, qua nos unice amplecteris, <lb xml:id="p1z10"/>eam subinde magis ac magis experiri desidero.</s>
					<s n="5" xml:lang="la">Quare non tamtum <lb xml:id="p1z11"/>mearum rerum rationem a te haberi desidero, sed et earum, quae attinent <lb xml:id="p1z12"/>fratres mihi unice dilectos.</s>
					<s n="6" xml:lang="la">Quorum non postremus est <persName>Thomas <lb xml:id="p1z13"/>Alberti</persName>, quem et antea tibi commendaveram tuaque opera adiutus est.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Veretur, ne tibi propter varia tua negocia exciderit animo, oravit, <lb xml:id="p1z15"/>ut denuo se tibi commendem.</s>
					<s n="8" xml:lang="la">Tua intercessione isthic <lb xml:id="p1z16"/>opus habebit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Rem omnem tibi narrabit.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Oro igitur tam <lb xml:id="p1z17"/>meo quam ipsius nomine, ut ipsi adesse velis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Eo namque pacto cum <lb xml:id="p1z18"/>senserit meam erga te commendationem aliquid valuisse, <lb xml:id="p1z19"/>utrumque maiore charitate amplectetur.</s>
					<s n="12" xml:lang="la">Novi nil habemus, quam <lb xml:id="p1z20"/>quod <persName>Bollwileri</persName> exercitus nondum persoluto stipendio crabronum in morem <lb xml:id="p1z21"/>irritatus insanit.</s>
					<s n="13" xml:lang="la">Dux <persName>Bollwilerus</persName> concessit <placeName ref="l1284">Bruxellam</placeName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Suspicantur <lb xml:id="p1z22"/>aliqui, quod data opera differat persolutionem salariorum in vernum <lb xml:id="p1z23"/>tempus, quo militem alioquin ad <persName>Gallum</persName> delapsurum retinere possit <lb xml:id="p1z24"/>in officio neque cogatur recentem conscribere exercitum.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Deus <lb xml:id="p1z25"/>omnia convertat in communem ecclesiae suae pacem.</s>
					<s n="16" xml:lang="la">Raptim <lb xml:id="p1z26"/><placeName ref="l441">Scaffhusii</placeName> 11. kalendas februarii anno 1558.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Salutabis nomine <lb xml:id="p1z27"/>meo doctos.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">Salutant te symmystae mei.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="farewell">Vale ecclesiae Christi <lb xml:id="p1z28"/>in multos annos incolumis.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z29"/>Tuus ex animo <lb xml:id="p1z30"/><persName ref="p3481">Simpertus Vogt</persName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio viro <persName ref="p495">Henrycho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesię <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>pastori vigilantissimo, <lb xml:id="p2z4"/>domino ac fratri <lb xml:id="p2z5"/>charissimo suo.</s>
				</p>
				<p>
					<note type="author">[Bemerkung von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="22" xml:lang="de">"<lb xml:id="p2z6"/><persName>Thomas Alberti</persName><lb xml:id="p2z7"/>."</s>
				</p>
			</div>
		</body>
	</text>
</TEI>