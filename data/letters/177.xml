	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Literas tuas cum pecunia pro libris emptis ab <persName ref="p8126">Oporino</persName> <lb xml:id="p1z2"/>nostro accepi.</s>
					<s n="3" xml:lang="la">Nova, quę apud nos circumferuntur, literarum lator indicare <lb xml:id="p1z3"/>poterit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><placeName ref="l210">Heidelbergae</placeName> missa papistica instituta, ad quam solummodo prima <lb xml:id="p1z4"/>die duę vetulę adierunt, altero die una adparuit; <lb xml:id="p1z5"/>sacrificulus indignatus est et abiit iterum in pagum suum et vix serv<lb xml:id="p1z6"/>atus a quorundam videntia.</s>
					<s n="5" xml:lang="la"><persName ref="p18477">Ferdinandus rex</persName> conscribit duodecim <lb xml:id="p1z7"/>cohortes, cum quibus <persName ref="p18593">Turcam</persName> aut perditurus aut fugam turpem subiturus.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Gloriantur papistę de revocata missa et ceremoniis; utinam gaudium <lb xml:id="p1z9"/>aliud habeant nullum.</s>
					<s n="7" xml:lang="la">Marchio <persName ref="p18471">Badensis Ernestus</persName> vocavit quosdam <lb xml:id="p1z10"/>sacerdotes ex doctioribus ad se et, quid de Interim Cęsareano statuant <lb xml:id="p1z11"/>exploraturus.</s>
					<s n="8" xml:lang="la"><persName ref="p5341">Lepusculus</persName> noster scribit ex <placeName ref="l18">Augusta</placeName> se brevi <lb xml:id="p1z12"/>advolaturum ad nos, nescio quibus ex causis motus sit, quod abitum <lb xml:id="p1z13"/>paret.</s>
					<s n="9" xml:lang="de"><foreign xml:lang="la">Avis mirę magnitudinis,</foreign> der uff ein mal 3 lib. flei[s]<lb xml:id="p1z14"/>chs isset, hat ein krommen schnabel, grosse fuͤß, disen hat ein bur g<lb xml:id="p1z15"/>efangen; dann er hat sich nit megen uff schwingen, dan er noch jung.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><lb xml:id="p1z16"/>Ettlich meynen, es sey ein trapp, ettlich grosser junger gyrr.</s>
					<s n="11" xml:lang="de">Ein <lb xml:id="p1z17"/>maler hat in abgemalet.</s>
					<s n="12" xml:lang="de">Diser were ouch in das wildt buͦch <lb xml:id="p1z18"/>D. <persName ref="p1283">Gesneri</persName> zesetzen, <foreign xml:lang="la">si prius non haberet tale genus avium.</foreign></s>
					<s n="13" xml:lang="la"><lb xml:id="p1z19"/>Ingens multitudo currit in pagum illum miliare fere distantem <lb xml:id="p1z20"/>a <placeName ref="l28">Basilea</placeName>, ut avem illam videant.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l28">Basileę</placeName> 30. <lb xml:id="p1z21"/>iunii 1548.</s>
					<s n="16" xml:lang="la" ana="salute">D. <persName ref="p8171">Theodorum</persName> salutabis etc.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">T(uus) <lb xml:id="p1z22"/><persName ref="p1278">Gastius</persName> ex <lb xml:id="p1z23"/>animo.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="18" xml:lang="la"><lb xml:id="p1z24"/>D. <persName ref="p495">Heinrycho Bul<lb xml:id="p1z25"/>linger<lb xml:id="p1z26"/>o</persName>, <pb/><lb xml:id="p2z1"/>ecclesiae <placeName ref="l587">Tigurinę</placeName> vigilantis<lb xml:id="p2z2"/>simo pastori, praecept<lb xml:id="p2z3"/>ori suo perpetu<lb xml:id="p2z4"/>o colendo.</s>
				</p>
				<p>
					<s n="19" xml:lang="de"><placeName ref="l587">Zuri<lb xml:id="p2z5"/>ch</placeName>.</s>
				</p>
