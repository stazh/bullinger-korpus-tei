	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hodie sub meridiem absolvimus synodum Germanica<lb xml:id="p1z2"/>m; foeliciter admodum et auspicate processerunt <lb xml:id="p1z3"/>omnia.</s>
					<s n="3" xml:lang="la">Animadversum in utres quosdam vinosos, quorum <lb xml:id="p1z4"/>7 incarcerati; Lutherani et Bucerani obmut<lb xml:id="p1z5"/>uerunt prorsus; spero posthac tranquillitatem <lb xml:id="p1z6"/>magnam.</s>
					<s n="4" xml:lang="la">Pauci quidem deprehensi, cum quibus <lb xml:id="p1z7"/>agetur privatim; noluimus enim aliquam coram synodo <lb xml:id="p1z8"/>instituere disputationem aut actionem aliquam, qua <lb xml:id="p1z9"/>prolongaretur synodus.</s>
					<s n="5" xml:lang="la">Necessaria fuit valde et, ut <lb xml:id="p1z10"/>spero, utilissima inquisitio et correptio; spero correctiorem <lb xml:id="p1z11"/>a multis et doctrinam et vitam.</s>
					<s n="6" xml:lang="la">Iam instat <lb xml:id="p1z12"/><placeName ref="l832">Gallica</placeName>; utinam eadem, qua <placeName ref="l822">Germanica</placeName>, procedat fac<lb xml:id="p1z13"/>ilitate.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Domini in singulas classes seu capitula <lb xml:id="p1z14"/>10 libras largiti sunt.</s>
					<s n="8" xml:lang="la">Habes summam.</s>
					<s n="9" xml:lang="la">Plura <lb xml:id="p1z15"/>nequeo; distrahunt enim me gratres.</s>
					<s n="10" xml:lang="la">Vidisses certe <lb xml:id="p1z16"/>ministrorum egregiam coronam et certe inter multos <lb xml:id="p1z17"/>nepotes plurimos tamen viros christianos, pios et eruditos.</s>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z18"/>Vale.</s>
					<s n="12" xml:lang="la" ana="salute">Salutat te tuamque D. <persName ref="p8417">Musculus</persName>, mea familia <lb xml:id="p1z19"/>omnis.</s>
					<s n="13" xml:lang="la">Cras domini <persName ref="p8417">Musculi</persName> negotium tractabitur et absolvetur.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z20"/>15. Martii <placeName ref="l41">Bernae</placeName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z21"/>T[uus], quem nosti.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro D. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, theologo prae<lb xml:id="p2z3"/>stantissimo et <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z4"/>fidelissimo antistiti, domino et <lb xml:id="p2z5"/>compatri suo charissimo.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z6"/>M. <persName ref="p495">Heinrych <lb xml:id="p2z7"/>Bullinger</persName>.</s>
					<s n="18" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
