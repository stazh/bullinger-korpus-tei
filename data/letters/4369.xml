	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Gratia filii dei tecum etc. Quid vis scribam, non
					<lb xml:id="p1z2"/>de rebus dulcissime Bullingere. Omnia unico intelit,
					<lb xml:id="p1z3"/>verbo. Acticum
					<lb xml:id="p1z4"/>T Monstrum olim conceptum
					<lb xml:id="p1z5"/>et pinguiter altum in nos insiliit dilamare cupiens.
					<lb xml:id="p1z6"/>Viderit dominus et iudicet. Ego ob senium exautoratus
					<lb xml:id="p1z7"/>sum mihique salarium, quo hactenus vixi constitutum
					<lb xml:id="p1z8"/>est, dum vixero. Qui successit cum diacono a tutoribus
					<lb xml:id="p1z9"/>autoritatem habet omnia reformandi iuxta ordina
					<lb xml:id="p1z10"/>maio nobis propositam. Videt bonus esse homi
					<lb xml:id="p1z11"/>pius rt doctus, qui omnem pollicetur amititiam, Christi
					<lb xml:id="p1z12"/>stophorus Binderus, pastor Nurtingense. Quid igitur
					<lb xml:id="p1z13"/>Communicabo, ne cum illis aut prioribus relictis mo
					<lb xml:id="p1z14"/>novos recipiam. libera
					<lb xml:id="p1z15"/>Absit.
					<lb xml:id="p1z16"/>me benigne deus, expecto, voca me, veni pallica
					<lb xml:id="p1z17"/>mors fac, quod habes tuum in me offitium. Amen.
					<lb xml:id="p1z18"/>Iacobus intra tres hepdomadas hiic solvet, Ludi
					<lb xml:id="p1z19"/>moderator cum hypodycasculo abeunt. regius noster
					<lb xml:id="p1z20"/>necdum suam accepit sententiam. Goezius cras responsi
					<lb xml:id="p1z21"/>videbit etc. Ite intempestunter mecum agentes, ita vrst
					<lb xml:id="p1z22"/>ut in lectulo graviter decumbentem a me ex
					<lb xml:id="p1z23"/>egerint offitii resignationem, feci. Haec paucis. Tu
					<lb xml:id="p1z24"/>propter Iesum Christum, consule angustiato. Saluta omnes
					<lb xml:id="p1z25"/>fratres tuos et symmistas in Christo Iesu. Salutat te
					<lb xml:id="p1z26"/>nostri reliqua ex Iacobo etc. Hęc decumbens i
					<lb xml:id="p1z27"/>lectulo. Richenvillę 29. iulii 1560.
					<lb xml:id="p1z28"/>frate pro nobisne
					<lb xml:id="p1z29"/>defitiamus in tribulatione
					<pb/>
					<lb xml:id="p2z1"/>Praestantissimo theo
					<lb xml:id="p2z2"/>pietateque singulari
					<lb xml:id="p2z3"/>praedito do Hericio
					<lb xml:id="p2z4"/>Bullingero,
					<lb xml:id="p2z5"/>Tigurinorum primario
					<lb xml:id="p2z6"/>antistiti suo
					<lb xml:id="p2z7"/>sud colendo.
					<lb xml:id="p2z8"/>ss
					<lb xml:id="p2z9"/>.
				</p>
