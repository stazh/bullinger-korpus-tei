	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nihil habeo singulare, nisi quod <persName ref="p8092">Aretius</persName> noster <placeName ref="l210">Hei<lb xml:id="p1z2"/>delberga</placeName> rediit.</s>
					<s n="3" xml:lang="la">Ibi cum ipsomet principe de <placeName>Ursino</placeName> <lb xml:id="p1z3"/>egit; scribit princeps ad nostros et concedit illum <lb xml:id="p1z4"/>quamvis difficulter, non autem ante ver proximum illum di<lb xml:id="p1z5"/>mittere potest; eousque enim illi ex pacto obligatus est.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Nos gaudemus saltem eum nobis commissum esse; de fide <lb xml:id="p1z7"/>enim principis non dubitamus.</s>
					<s n="5" xml:lang="la">Adfuere commodum ab aula <lb xml:id="p1z8"/>aliqui, qui, si adfuissent, impedituri videbantur hanc vocationem, <lb xml:id="p1z9"/><persName ref="p997">Ehemius</persName> scilicet, <persName ref="p4069">Zulegerus</persName> et <persName ref="p772">Dathenus</persName>.</s>
					<s n="6" xml:lang="la">At<lb xml:id="p1z10"/>tulit simul <persName ref="p8092">Aretius</persName> fasciculum hunc literarum, quem tibi <lb xml:id="p1z11"/>mitto.</s>
					<s n="7" xml:lang="la">Qui praeterita dominica novae sint creaturae <lb xml:id="p1z12"/>facti, hoc est praefecti, ad fratrem scribo, ex quo singulorum<lb xml:id="p1z13"/>, si placuerit, nomina cognosces.</s>
					<s n="8" xml:lang="la">Dolet nobis <lb xml:id="p1z14"/>de mutato <persName>Küngßfeldiano</persName> nostro; succedit illi l<lb xml:id="p1z15"/>onge dissimilis illi futurus, pius alias, sed crassi in<lb xml:id="p1z16"/>genii homo et studiosorum parum studiosus.</s>
					<s n="9" xml:lang="la"><placeName ref="l167">Genevę</placeName> <lb xml:id="p1z17"/>audimus pestem magis ac magis saevire; vident ergo se luem <lb xml:id="p1z18"/>hanc non ex veneficis habere, quod tamen sibi persuaserant, <lb xml:id="p1z19"/>quas magno numero hoc anno combusserunt.</s>
					<s n="10" xml:lang="la">Vivit ille <lb xml:id="p1z20"/>adhuc, cuius haec sunt opera; is custodiat nos!</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Salutant <lb xml:id="p1z21"/>te amici et fratres.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l41">Bernae</placeName> 14. augusti 1571.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Tuus totus <lb xml:id="p1z23"/><persName ref="p8018">Iohannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori primario, domino <lb xml:id="p2z4"/>meo honorando et compatri <lb xml:id="p2z5"/>charissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="de"><lb xml:id="p2z6"/>M. <persName ref="p495">Heinrych Bullingeren</persName> <lb xml:id="p2z7"/>zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
