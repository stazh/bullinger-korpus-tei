	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Si nova queris, videbis ex his, que dominis tu<lb xml:id="p1z2"/>is significo.</s>
					<s n="3" xml:lang="la">Dominus det meliora; nam <lb xml:id="p1z4"/>singulis horis expecto nova de <lb xml:id="p1z5"/>conflictu.</s>
					<s n="4" xml:lang="la">Cardinales sive legati, <lb xml:id="p1z6"/>qui ad Caesaren et regen dimissi erant <lb xml:id="p1z7"/>a papa, pro pace, redeunt re infecta; <lb xml:id="p1z8"/>nam Caesar petit a rege sub s<lb xml:id="p1z9"/>pecie amicitię in futurum federa <lb xml:id="p1z10"/>captiosa contra Germaniam et alios <lb xml:id="p1z11"/>amicos, et <lb xml:id="p1z12"/>in sum<lb xml:id="p1z13"/>ma nihil est <lb xml:id="p1z14"/>certi in illis tractatibus, per quos <lb xml:id="p1z16"/>plus mali eveniet in republica christi<lb xml:id="p1z17"/>ana <lb xml:id="p1z18"/>quam ex bello.</s>
					<s n="5" xml:lang="la">Nam inter cetera <lb xml:id="p1z19"/><persName>Caesar</persName> petit, ne rex comprehendat <lb xml:id="p1z20"/>in foedere suos amicos et quod ipse eadem velit ex <lb xml:id="p1z21"/>sua parte, ut sit post <lb xml:id="p1z24"/>pacem liberum Caesari et regi bellum facere... <lb xml:id="p1z25"/>iis.</s>
					<s n="6" xml:lang="la">Vide, quorsum ista tendant.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z26"/>Ergo melius est pugnare.</s>
					<s n="8" xml:lang="la">Audi <lb xml:id="p1z28"/>reliqua: cardinalis ille, qui nuper apud vos <pb/><lb xml:id="p2z1"/>fuit, mihi significavit <persName>Caesarem</persName> promittere <lb xml:id="p2z2"/>pape, quod velit <placeName ref="l830">Angliam</placeName> ad pristinum <lb xml:id="p2z3"/>religionis statum reducere.</s>
					<s n="9" xml:lang="la">Ergo <lb xml:id="p2z4"/>statim decretum est, quod cardinalis <lb xml:id="p2z5"/><placeName ref="l830">Anglus</placeName> Paulus, qui <placeName ref="l425">Rome</placeName> est, <lb xml:id="p2z6"/>iret ad <persName>Caesarem</persName> et postea <lb xml:id="p2z7"/>ab eo in <placeName ref="l830">Angliam</placeName> transiret, <lb xml:id="p2z8"/>et brevi transiturus est.</s>
					<s n="10" xml:lang="la">Vide <lb xml:id="p2z9"/>et perpende diligenter artes illius <lb xml:id="p2z10"/>Caesaris, et quam caute totum orbem bel<lb xml:id="p2z11"/>lis civilibus implicet.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z12"/>Videbis brevi <lb xml:id="p2z13"/>miseram <placeName ref="l830">Angliam</placeName> <lb xml:id="p2z14"/>estuantem.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z15"/>Marchio adhuc vi<lb xml:id="p2z16"/>vit <lb xml:id="p2z17"/>et rursum parat arma.</s>
					<s n="13" xml:lang="la">De ceteris s<lb xml:id="p2z18"/>i quid habes, lubenter a te audirem.</s>
					<s n="14" xml:lang="la" ana="farewell"><lb xml:id="p2z19"/>Vive, vale, vir optime.</s>
					<s n="15" xml:lang="la">Raptim <lb xml:id="p2z20"/>ex <placeName ref="l760">Soluturo</placeName> <lb xml:id="p2z21"/>22a augusti.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Tuus <lb xml:id="p2z22"/>semper Bas[safontaneus].</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p3z1"/>Decem ex camera <persName ref="p18538">Cesaris</persName> summi viri <lb xml:id="p3z2"/>sunt inter alios in hoc conflictu <lb xml:id="p3z3"/>rapti; hoc habui iam.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p4z1"/>Viro optimo domino <lb xml:id="p4z2"/><persName ref="p495">Bulingero</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note>[Von anderer Hand:]</note>
					<s n="20" xml:lang="de"><lb xml:id="p4z3"/>Dem herren <persName ref="p495">Bullinger</persName> <lb xml:id="p4z5"/>zuͦ <placeName ref="l587">Zürich</placeName> zu uberantwurtten <lb xml:id="p4z6"/>zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
