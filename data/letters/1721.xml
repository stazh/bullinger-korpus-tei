	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime <persName ref="p495">Bullingeri</persName>, mitto duo <lb xml:id="p1z2"/>vascula <lb xml:id="p1z3"/>sic signata: Ga. C. M. id est <persName>Galeacius <lb xml:id="p1z5"/>Carraciolus</persName>, marchio.</s>
					<s n="2" xml:lang="la">Solvi <placeName ref="l98">Curiam</placeName> <lb xml:id="p1z6"/>usque pro vectura, et d[ominus] <lb xml:id="p1z7"/>burgimagister solvet <placeName ref="l587">Tigurum</placeName> usque.</s>
					<s n="3" xml:lang="la">Te rogo, <lb xml:id="p1z8"/>da operam, ut primo quoque tempore <lb xml:id="p1z9"/>perferantur <placeName ref="l167">Genevam</placeName> ad illum d[ominum] <lb xml:id="p1z10"/>marchionem, qui solvet reliqua.</s>
					<s n="4" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z11"/>et salve; boni consule, nam in <lb xml:id="p1z12"/>causa Christi tua opera nunc utor.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z13"/><placeName ref="l525">Vicosoprani</placeName>, 18. septembris 1552.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, pastori <placeName ref="l587">Tiguri<lb xml:id="p2z3"/>no</placeName>, fratri honoran<lb xml:id="p2z4"/>do.</s>
					<s n="8" xml:lang="la">[<lb xml:id="p2z5"/>Cum] duobus vasculis <lb xml:id="p2z8"/>sic signatis Ga. <lb xml:id="p2z9"/>C. <lb xml:id="p2z10"/>M.</s>
				</p>
			</div>
		</body>
	</text>
