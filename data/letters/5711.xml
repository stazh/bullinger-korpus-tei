	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Habebam in animo paucula quaedam scribere ac nescio
					<lb xml:id="p1z2"/>qumomdo charta repteni totam. D. Pylander mit
					<lb xml:id="p1z3"/>tibi, arbitror, ea quae inter Brentium collegasse
					<lb xml:id="p1z4"/>suos et Ioannem Weigel concionatorem piutenum acta
					<lb xml:id="p1z5"/>sunt. Flebot incredibilem audaciam impietatemque
					<lb xml:id="p1z6"/>incredibilem. In Polonia Christum deum esse hic
					<lb xml:id="p1z7"/>hominem negant. Nihil igiur erit, nisi quo
					<lb xml:id="p1z8"/>plasphemum os marcionis eructavit, spertrum furert,
					<lb xml:id="p1z9"/>debebant, si unquam alias, omnes iam theologuim
					<lb xml:id="p1z10"/>sese monstris illis et Sathanae angelis fortissim
					<lb xml:id="p1z11"/>opponere. Dxus optimu maxmu tibi tua fortun
					<lb xml:id="p1z12"/>consilia. Nemo propemodum vivt, qui
					<lb xml:id="p1z13"/>dignior mihi videatur acerba accusatione Sulcere
					<lb xml:id="p1z14"/>Basiliensi. Utinam vero occasionem habea.
					<lb xml:id="p1z15"/>retractam ei percupio. Minus multos seduceret
					<lb xml:id="p1z16"/>quoque mentitur se velle attrahere cona
					<lb xml:id="p1z17"/>ut Christum in carnem venisse per negatis
					<pb/>
					<lb xml:id="p2z1"/>Dostrina et pietate
					<lb xml:id="p2z2"/>ornatissimo viro domino
					<lb xml:id="p2z3"/>Henrico Bullingero,
					<lb xml:id="p2z4"/>Tigurinae ecclesiae pastor
					<lb xml:id="p2z5"/>idelissimo, domeio sibi colendissimo.
				</p>
			</div>
		</body>
	</text>
