	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ego vero (mi venerande pater) valde miror, <lb xml:id="p1z2"/>quae causa sit, quod <placeName ref="l93">Clavennae</placeName> ignoretur <lb xml:id="p1z3"/>concilio finem impositum.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Mitto literas d. <lb xml:id="p1z4"/><persName ref="p2054">Martinengi</persName>, ut ipse legas; non est, quod <lb xml:id="p1z5"/>remittas.</s>
					<s n="4" xml:lang="la">Aut illi in errore aliquo magno <lb xml:id="p1z6"/>et insigni versantur, aut nos decipimur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Sed concilium omnino puto dissolutum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Quod illud ignoret <persName ref="p2054">Martinengus</persName>, haec <lb xml:id="p1z9"/>nimirum unica et potissima causa <lb xml:id="p1z10"/>erit, quod itinera sunt minus frequentia <lb xml:id="p1z11"/>propter ea quod Rhetia propter pestem, ut ex <lb xml:id="p1z12"/><persName ref="p2054">Martinengi</persName> literis intelliges, ab <placeName ref="l834">Italis</placeName> <lb xml:id="p1z13"/>vitatur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Haec vesperi scribo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Cras a <lb xml:id="p1z14"/>concione, si vixero, operam dabo, ut <lb xml:id="p1z15"/>aliquem ex episcopi domesticis conveniam, <lb xml:id="p1z16"/>ut vel istinc aliquid extorqueam.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/>Vix has conciones absolvi; aegre intellectus <lb xml:id="p1z18"/>sum propter tussim et raucedinem; sed <lb xml:id="p1z19"/>spero me plane posse dei gratia confir<lb xml:id="p1z20"/>mare valetudinem.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Scio ego me <lb xml:id="p1z21"/>sensim senescere et cum aliis multis diffi<lb xml:id="p1z22"/>cultatibus mihi confligendum, dum navis <lb xml:id="p1z23"/>mea tandem in portum deducatur.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">In <lb xml:id="p1z24"/>haec misera et aerumnosa vita nulla <lb xml:id="p1z25"/>statio apparet; coelestis est patria, ad quam <lb xml:id="p1z26"/>suspiramus uterque.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Pestis hic <placeName ref="l98">Curiae</placeName> <lb xml:id="p1z27"/>non quidem saevit, sed per intervalla <lb xml:id="p1z28"/>tamen aliquot domos infestat; mirum, <lb xml:id="p1z29"/>si non ingravescit.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Negotium <persName>Pellizariorum</persName> <pb/><lb xml:id="p2z1"/>conati erant quidam practicis suis impedire; <lb xml:id="p2z2"/>sed dei gratia frustrati sunt praeter spem, <lb xml:id="p2z3"/>et speramus satis felicem successum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Sed <lb xml:id="p2z4"/>quod omnia sint lubrica, nihil certi affir<lb xml:id="p2z5"/>mare dum possum, donec expedita habeamus <lb xml:id="p2z6"/>omnia.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Scriptum est Venetiis ad nostros <lb xml:id="p2z7"/>illuc nunciatum esse pontificis afflictam admodum <lb xml:id="p2z8"/>valetudinem; de quo si quid scribetur amplius, <lb xml:id="p2z9"/>faciam ut scias.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z10"/>Haec heri scripseram et hodie, quo rescirem <lb xml:id="p2z11"/>aliquid certi de concilio, ipse ad episcopum <lb xml:id="p2z12"/>scripsi rogans, si <persName ref="p17892">Epiphanium</persName> haberet, <lb xml:id="p2z13"/>commodato mitteret; addidi me audire <lb xml:id="p2z14"/>concilium dissolutum eiusque acta libro <lb xml:id="p2z15"/>comprehensa ad se missa; per unam aut <lb xml:id="p2z16"/>alteram horam legenda concederet.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z17"/>Ipse recripsit, quae hic vides; nam et haec <lb xml:id="p2z18"/>ipsius manus est.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Itaque intelligis acta <lb xml:id="p2z19"/>extare, sed haberi dum non potuisse.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z20"/>Si prius ipse accepero ex amicis, mittam; <lb xml:id="p2z21"/>si episcopus acceperit et mutuo dederit, <lb xml:id="p2z22"/>enotabo capita et summas, dum integrum <lb xml:id="p2z23"/>volumen nacti fuerimus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z24"/>Haec sunt (reverende pater), quae nunc quidem <lb xml:id="p2z25"/>habeo.</s>
					<s n="21" xml:lang="la">Tibi pro novis illis mirabilibus <lb xml:id="p2z26"/>gratias immortales ago.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">D. <persName ref="p8055">Blaureri</persName> <lb xml:id="p2z27"/>scriptum non remisi, quod ille utatur charta <lb xml:id="p2z28"/>molli et fluida et magna ex parte ex <pb/><lb xml:id="p3z1"/>gestatione fuerit attritum; satis tamen commode <lb xml:id="p3z2"/>legi; adde, quod mihi inscriptum non remitten<lb xml:id="p3z3"/>dum duxi.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Te autem valere cupimus omnes, <lb xml:id="p3z4"/>deumque optimum maximum rogamus, ut hic annus <lb xml:id="p3z5"/>tibi tuisque felicissime ineat, aeque feliciter <lb xml:id="p3z6"/>exeat.</s>
				</p>
				<p>
					<s n="24" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><placeName ref="l98">Curię</placeName> in die Ioannis anno 156<lb xml:id="p3z7"/>3.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">T[uus] <persName ref="p8009">Fab[ricius</persName>].</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><pb/><lb xml:id="p4z1"/>Amplissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p4z2"/>Bullingero</persName>, domino <lb xml:id="p4z3"/>suo et in Christo patri <lb xml:id="p4z4"/>summe reverendo.</s>
				</p>
				<p>
					<s n="28" xml:lang="de"><lb xml:id="p4z5"/><placeName ref="l587">Zurich</placeName> an herren <persName ref="p495">Bullinger</persName><lb xml:id="p4z6"/>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>