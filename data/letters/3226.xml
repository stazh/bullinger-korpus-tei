	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Per Christum Iesum S. P. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/><persName ref="p6055">Petrus Perna</persName>, iam civis <placeName ref="l28">Basiliensis</placeName>, aut <persName ref="p8101">Socinus</persName> <lb xml:id="p1z3"/>nostram primam ad <persName ref="p3375">Vergerii</persName> calumnias responsionem <lb xml:id="p1z4"/>ostendet, venerande mi domine et frater in domino <persName ref="p495">Bullingere</persName>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Res agitur a nostris hic moderate et pacate.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Si <persName ref="p3375">Vergerius</persName> sibi constare voluisset in iis, quae <lb xml:id="p1z7"/>vobis promiserat, non laboraremus.</s>
					<s n="5" xml:lang="la">sed aere alieno <lb xml:id="p1z8"/>obstricti, cuius dissolutionem vel maxime pecuniis <lb xml:id="p1z9"/>abundantes aegre suscipiunt, facile mutantur.</s>
					<s n="6" xml:lang="la">Idem <lb xml:id="p1z10"/>hic fecit, cum eius creditores et in his Oporinus maxime <lb xml:id="p1z11"/>expectarent, coniecto in me et <persName ref="p1327">Gratarolum</persName>, <lb xml:id="p1z12"/>quod ante paraverat, venenato telo repente discessit <lb xml:id="p1z13"/>non tam cito, quam vellemus, forsitan rediturus.</s>
					<s n="7" xml:lang="la">Sed <lb xml:id="p1z14"/>crede mihi de hac sua criminosa accusatione parvam <lb xml:id="p1z15"/>apud senatum nostrum et academiam gratiam inivit.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Verum his omissis oro te, mi domine et frater colendissime, <lb xml:id="p1z17"/>ut proximis meis literis respondere non dedigneris neque <lb xml:id="p1z18"/>eum contemnas, quem semper tibi charissimum esse non <lb xml:id="p1z19"/>obscuriis aut dubiis signis ostendisti; nullam hic tu vel <lb xml:id="p1z20"/>autoritatis vel quietis iacturam facies.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Vale cum <lb xml:id="p1z21"/>tuis charissimis omnibus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l28">Basileae</placeName> 28. iunii 1557.</s>
				</p>
				<p>
