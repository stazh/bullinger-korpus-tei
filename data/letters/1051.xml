	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi literas tuas una cum pharmaco, dilecte in domino frater, nec est, quod dubites michi gratum <lb xml:id="p1z2"/>exhibuisse beneficium; nam cum commodius fieri non potuit, ut proprium nunctium mitteres, tum <lb xml:id="p1z3"/>tua in me singularis pietas tum corporis mei infirmitas exigebat.</s>
					<s n="3" xml:lang="la">Quare gratias ago <lb xml:id="p1z4"/>tibi pro eo, quod inpe[n]debas beneficio.</s>
					<s n="4" xml:lang="la">Declaras praeterea hac tua in nos sollicitudine, quo sis <lb xml:id="p1z5"/>animo preditus erga <placeName ref="l41">Bernates</placeName>.</s>
					<s n="5" xml:lang="la">Presuli a <persName ref="p7449">Diesbach</persName> otius exponam, ubi illum convenero.</s>
					<s n="6" xml:lang="la" ana="salute"><lb xml:id="p1z6"/>Avunculus tuus te plurimum salutat; sermonem de sacrificiis gratanter accepit, quia dei verbum <lb xml:id="p1z7"/>inpense amat.</s>
					<s n="7" xml:lang="la">Ceterum varii sunt apud nos rumores bellici.</s>
					<s n="8" xml:lang="la">Sunt, qui Caesarem <lb xml:id="p1z8"/><placeName ref="l830">Anglię</placeName> regem cinxisse dicant, ne per viam maris ulla parte possit evadere Cesaris <lb xml:id="p1z9"/>manus.</s>
					<s n="9" xml:lang="la">Pars <placeName ref="l2510">Turcam</placeName> in armis esse constanter negat; pars <placeName ref="l2556">Siciliam</placeName>, <placeName ref="l2800">Sardiniam</placeName> et <lb xml:id="p1z10"/><placeName ref="l2801">Corsicam</placeName> invadisse adfirmat.</s>
					<s n="10" xml:lang="la"><placeName ref="l303">Madenburgum</placeName> obsidione liberatum audimus.</s>
					<s n="11" xml:lang="la">Cesarianum <lb xml:id="p1z11"/>exercitum <placeName ref="l1122">Parmam</placeName> reliquisse <placeName ref="l832">Galli</placeName> quidam apud nos praedicant; <placeName ref="l832">Gallorum</placeName> regem <lb xml:id="p1z12"/>penitus a pontifice descivisse, ut patriarcham substituerit per totum <placeName ref="l832">Gallię</placeName> regnum, <lb xml:id="p1z13"/>e quodam magni nominis <placeName ref="l832">Gallo</placeName> hic <placeName ref="l285">Lentzburgi</placeName> accepimus.</s>
					<s n="12" xml:lang="la"><placeName ref="l18">Augustanus</placeName> senatus perfide <lb xml:id="p1z14"/>egit cum suis contionatoribus; nunc in contentione sunt cum Cesareanis; populus tumul<lb xml:id="p1z15"/>tuatur; aliquot contionatores velut postliminio revocantur, et Sathan ipse, author huius <lb xml:id="p1z16"/>mali, cupit nostrorum praesentia maius malum caveri.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><persName ref="p1546">Princeps Wirtenbergius</persName> a Caesare <lb xml:id="p1z17"/>libertate donatus est; ut Christum libere praedicari permittat, concessum est.</s>
					<s n="14" xml:lang="la">magno a... <lb xml:id="p1z18"/>et pius princeps hanc emit libertatem, id quidem non inprudenter.</s>
					<s n="15" xml:lang="la">Sub futurum... <lb xml:id="p1z19"/>forte excitabit dominus iram in nos multoties commeritam.</s>
					<s n="16" xml:lang="la">Si quid de <placeName ref="l830">Anglia</placeName> ce[rti] <lb xml:id="p1z20"/>habes, rescribe, obsecro.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Vale.</s>
					<s n="18" xml:lang="la">Prae dolore plura non possum.</s>
					<s n="19" xml:lang="la">Datum 16. octobris.</s>
					<s n="20" xml:lang="la" ana="salute"><lb xml:id="p1z21"/>Saluto nomine meo uxorem tuam et generos etc.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z22"/><persName ref="p8440">Gervasius Schuler</persName> tuus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro <persName ref="p495">Heynricho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> ecclesię an<lb xml:id="p2z3"/>tistiti vigilantissimo, domino fratri et <lb xml:id="p2z4"/>veteri amico, plurimum obser<lb xml:id="p2z5"/>vando.</s>
				</p>
				<p>
					<note>Datum: Während der Belagerung <placeName ref="l303">Magdeburgs</placeName>.</note>
				</p>
			</div>
		</body>
	</text>
