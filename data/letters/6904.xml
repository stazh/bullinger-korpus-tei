	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Plaustrum literarum abs te expecto, colendissime <lb xml:id="p1z2"/>domine compater, praesertim vero, ut scribas, an ea <lb xml:id="p1z3"/>acceperis, quae nomine senioris <persName ref="p4060">Zehenderae</persName> non <lb xml:id="p1z4"/>ita pridem ad te misi; sollicitum enim me ea <lb xml:id="p1z5"/>res tenet, donec, an acceperis necne, intelligam.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Ego paucula alias nunc habebam; quae quoniam <lb xml:id="p1z7"/>literis ad <persName ref="p8011">Gvaltherum</persName> nostrum scriptis ingessi, non <lb xml:id="p1z8"/>est, ut eadem in tuis repetam, cum sciam omnia <lb xml:id="p1z9"/>vobis esse communia.</s>
					<s n="4" xml:lang="la">Has tamen ad te quoque scribere <lb xml:id="p1z10"/>volui, ut me cura liberares et ego meo non <lb xml:id="p1z11"/>deessem officio.</s>
					<s n="5" xml:lang="la">De <persName ref="p20227">Gentilis</persName> exitu nuper scripsi.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Audimus aliquos ecclesiae nostrae ob id factum <lb xml:id="p1z13"/>male loqui, qui si suos haereticos com<lb xml:id="p1z14"/>bussissent, non opus erat post mortem erutos cremare.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Te rogamus, ut, sicubi se occasio offerat, <lb xml:id="p1z16"/>magistratus nostri et ecclesiae nostrae factique hu<lb xml:id="p1z17"/>ius patrocinium suscipias.</s>
					<s n="8" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="9" xml:lang="la" ana="salute">Salutant <lb xml:id="p1z18"/>te omnes nostri, nominatim vero consul <persName ref="p8063">Steigerus</persName>, <lb xml:id="p1z19"/><persName ref="p3494">Diesbachius</persName>, quaestores, <persName ref="p4060">Zehenderi</persName>, socer item, <lb xml:id="p1z20"/>mater et uxor.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><placeName ref="l41">Bernae</placeName> 23. septembris 1566.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z21"/>Tuus ut semper <lb xml:id="p1z22"/><persName ref="p8018">Iohannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino meo et compatri <lb xml:id="p2z5"/>summa mihi observantia <lb xml:id="p2z6"/>colendo.</s>
				</p>
			</div>
		</body>
	</text>
