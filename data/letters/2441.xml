	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Tanto libentius leges has liter[as]..<lb xml:id="p1z2"/>. ursit me, ut scriberem, nunciumque <lb xml:id="p1z3"/>promisit.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z4"/>Valeo dei benignitate et laboro perpetuo in eius <lb xml:id="p1z5"/>gloriam, quantulum id sit, quod possim conferre.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Excuditur historia ab anno 1517, nempe d. <persName>Sleid<lb xml:id="p1z7"/>ani</persName>, quam ego recognosco, et si qua in re possum <lb xml:id="p1z8"/>iuvare, sit laus domino deo nostro.</s>
					<s n="4" xml:lang="la">Ex<lb xml:id="p1z9"/>cuditur totus liber cardinalis <persName>Poli</persName> pro papatu, sed <lb xml:id="p1z10"/>cum antidotis ex tuis etiam libris petitis; <lb xml:id="p1z11"/>nam describetur, quod scripsisti in Matthaeum et <lb xml:id="p1z12"/>in Ioannem: "Tu es Petrus, pasce oves."</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Excu<lb xml:id="p1z13"/>duntur 20 epistolae <persName>F. Petrarcae</persName>, quibus testatus <lb xml:id="p1z14"/>reliquit, quid de papatu senserit.</s>
					<s n="6" xml:lang="la">Excuduntur <lb xml:id="p1z15"/>duae illae secretarii actiones, quas hac aestate <lb xml:id="p1z16"/>vidisti.</s>
					<s n="7" xml:lang="la">Excuditur idolum <persName>Laurentianum</persName>, cuius <lb xml:id="p1z17"/>etiam mitto aliquot folia, ac non modo Latine, <lb xml:id="p1z18"/>sed etiam Italice.</s>
					<s n="8" xml:lang="la">Excuditur denique responsio <lb xml:id="p1z19"/>mea ad postremum catalogum, illum scilicet, <lb xml:id="p1z20"/>in quo tibi pepercerunt, quae res dedit mihi occasionem, <lb xml:id="p1z21"/>ut multa ego de te.</s>
					<s n="9" xml:lang="la">Habes rationem <lb xml:id="p1z22"/>negotiationis meae.</s>
					<s n="10" xml:lang="la">Ubi paulo ulterius typo<lb xml:id="p1z23"/>graphi tres, qui mihi operam navarunt, pro<lb xml:id="p1z24"/>gressi fuerint, dimittam eos et ad vos ve<lb xml:id="p1z25"/>niam, ut spero et scripsi.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z26"/>Accepi literas d. <persName ref="p8296">Bassafontanei</persName>, qui mihi valedixit <lb xml:id="p1z27"/>discedens ex legatione et successorem commendavit; <lb xml:id="p1z28"/>cui ego pauca.</s>
					<s n="12" xml:lang="la">Tu curabis, ut ad eum <lb xml:id="p1z29"/>perferantur.</s>
					<s n="13" xml:lang="la">Pecunia a me <persName>Anglis</persName> impetrata huc mis<lb xml:id="p1z30"/>sa est ad magistratum; <pb/><lb xml:id="p2z1"/>agitur de...</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Ursit me... causam eorum, qui istic sunt, ago diligenter.</s>
					<s n="15" xml:lang="la">Hoc velim illis nuncies et ut rogent pro <lb xml:id="p2z2"/>me.</s>
					<s n="16" xml:lang="la">Non puto me plura habere, quae scribam.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z3"/>Velim, sane communices non solum <lb xml:id="p2z4"/>tuis generis, et filiis meis carissimis, sed <lb xml:id="p2z5"/>etiam <persName ref="p8101">Lelio</persName> meo, quum vix pauca possim <lb xml:id="p2z8"/>ad illum nunc.</s>
					<s n="18" xml:lang="la" ana="farewell">Vale et salve, ora pro <lb xml:id="p2z9"/>me.</s>
					<s n="19" xml:lang="la"><placeName ref="l491">Argentorati</placeName> 30. octobris 155<lb xml:id="p2z10"/>4.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><persName ref="p3375">Vergerius</persName><lb xml:id="p2z12"/>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z13"/>Tibi <persName ref="p495">H[<lb xml:id="p2z15"/>enric<lb xml:id="p2z16"/>e] <lb xml:id="p2z17"/>Bullingere</persName>.</s>
				</p>
			</div>
		</body>
	</text>
