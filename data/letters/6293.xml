	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Habeo nunc dei gratia, cl[arissime] d. <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z2"/>paulo melius.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Mitto ad te <persName ref="p8009">Fabricii</persName> literas.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Legatus etiam <lb xml:id="p1z3"/><placeName ref="l98">Curia</placeName> ad me scripsit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Novi nihil habere se ait, expectare <lb xml:id="p1z4"/>autem, ut ego aliquid scribam.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quare cupio, d. <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z5"/>si quid habueris in crastinum, ubi vacabit, mihi communices.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z6"/>Vale et ignosce semicęco iamque etiam claudo scriptori.</s>
					<s n="8" xml:lang="la">Tuu<lb xml:id="p1z7"/>s <persName ref="p1283">C. Gesnerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Ohne Adresse.]</note>
				</p>
			</div>
		</body>
	</text>
