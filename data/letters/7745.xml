	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literas tuas, vir clarissime colendissimeque <lb xml:id="p1z2"/>d. pater, una cum scripto inserto accepi nec <lb xml:id="p1z3"/>illud nunc remittere potui, cum a benevolo <lb xml:id="p1z4"/>et amico quodam singulari nondum esset <lb xml:id="p1z5"/>restitutum.</s>
					<s n="3" xml:lang="la">Is autem e numero quoque nostro est, <lb xml:id="p1z6"/>quod ideo scribo, ne tuae liturae indicium te <lb xml:id="p1z7"/>excruciat.</s>
					<s n="4" xml:lang="la">Remittam proxime et quamprimum <lb xml:id="p1z8"/>recepero.</s>
					<s n="5" xml:lang="la">Sed non dissimilia in hoc, quod mihi <lb xml:id="p1z9"/>nuper perscriptum est.</s>
					<s n="6" xml:lang="la">Recentius nihil <lb xml:id="p1z10"/>habemus, nisi quod ipsi nunc adversarii <lb xml:id="p1z11"/>affirment pugnam com[m]issam esse in <placeName ref="l832">Gallia</placeName>, <lb xml:id="p1z12"/>sed utrisque luctuosam et cruentam.</s>
					<s n="7" xml:lang="la">- Nostri heri <lb xml:id="p1z13"/>ad comitia profecti sunt.</s>
					<s n="8" xml:lang="la">Audiemus brevi, <lb xml:id="p1z14"/>quid in causa <persName ref="p8394">Cellarii</persName> definiatur.</s>
					<s n="9" xml:lang="la">Ulciscendam <lb xml:id="p1z15"/>hanc iniuriam convenere <placeName>2 Foedera</placeName>, ex tertio <lb xml:id="p1z16"/>etiam non paucae communitates.</s>
					<s n="10" xml:lang="la">Sed verbis exequi <lb xml:id="p1z17"/>vix possum, quantum plena manu monachorum <lb xml:id="p1z18"/>fautores concursaverint oppugnaturi, <lb xml:id="p1z19"/>si quos minus benevolos sentirent, et <lb xml:id="p1z20"/>periculum est certe, ne munusculis eiusmodi <lb xml:id="p1z21"/>emolliant durissimos quosvis.</s>
					<s n="11" xml:lang="la">Legatus <lb xml:id="p1z22"/>noster affirmat <persName ref="p4810">Venetum</persName> senatum inquisitores <lb xml:id="p1z23"/>ipsorumque artes repudiasse et amolitos esse.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/>Haec hactenus ocyssime.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Anxie exspectamus <lb xml:id="p1z25"/>historiam comissi proelii <persName>Gallici</persName>, nec parum <lb xml:id="p1z26"/>prodesset causae nostrae, si ante finem comitiorum <lb xml:id="p1z27"/>percrebesceret.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale, vir amplissime; <lb xml:id="p1z28"/>serveris aeternum ecclesiae dei.</s>
					<s n="15" xml:lang="la"><placeName ref="l98">Curiae</placeName> 1569. <lb xml:id="p1z30"/>10. ianuarii, quo tuarum nullas adhuc.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute">Resalutant te nostri omnes <lb xml:id="p1z31"/>cum laetissimi anni imprecatione.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z32"/>Amplitudinis tua<lb xml:id="p1z33"/>e subiectissi<lb xml:id="p1z34"/>mus <persName ref="p8016">Th[obias] Eg[linus</persName><lb xml:id="p1z35"/>].</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. m. <persName ref="p495">H[ennrico] <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ministro cla<lb xml:id="p2z5"/>rissimo et primario, <lb xml:id="p2z6"/>d. suo aeternum <lb xml:id="p2z7"/>colendissimo.</s>
				</p>
				<p>
					<s n="19" xml:lang="de"><lb xml:id="p2z8"/>Ann h. pfarrer zum <lb xml:id="p2z9"/>Grosen Münster zuͦ <lb xml:id="p2z10"/><placeName ref="l587">Zürych</placeName></s>
				</p>
			</div>
		</body>
	</text>
