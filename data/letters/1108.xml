	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S<lb xml:id="p1z3"/>. D.</s>
					<s n="2" xml:lang="la">Nudiustertius copiose scripsi tuae <lb xml:id="p1z4"/>humanitati, vir clarissime, per <persName ref="p18073">Ranspergium</persName> <lb xml:id="p1z5"/>vestratum.</s>
					<s n="3" xml:lang="la">Quia tamen hic amicus noster <lb xml:id="p1z6"/>singularis<note xml:id="fn1" type="footnote" n="1">a.R.: <persName ref="p506">Butler</persName>.</note> ad vos erat profecturus, hasce <lb xml:id="p1z7"/>ei dare volebam, quibus te admonerem, si forte <lb xml:id="p1z8"/>ad meas respondere vacaret.</s>
					<s n="4" xml:lang="la">Quae amic<lb xml:id="p1z9"/>us ad me de <placeName ref="l303">Magdeburgensibus</placeName>, <lb xml:id="p1z10"/><placeName ref="l572">Wirtebergensibus</placeName> et aliis nonnullis ad me <lb xml:id="p1z11"/>scripsit, hic idem <persName ref="p506">Buttlerus</persName> noster legit <lb xml:id="p1z12"/>ac recitare potest.</s>
					<s n="5" xml:lang="la" ana="farewell">Vale.</s>
					<s n="6" xml:lang="la">Libelli d. <lb xml:id="p1z13"/><persName ref="p8171">Theodori</persName> nondum prodiere; quamprimum pro<lb xml:id="p1z14"/>dibunt, ex me habebis.</s>
					<s n="7" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 16. <lb xml:id="p1z15"/>decembris 15<lb xml:id="p1z16"/>50.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p495">Bullingerus</persName> <lb xml:id="p1z18"/>tuus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Comme<lb xml:id="p2z2"/>ndo t<lb xml:id="p2z3"/>uae humanit<lb xml:id="p2z4"/>ati <persName ref="p506">Buttlerum</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z5"/>Clarissimo viro d. d. <lb xml:id="p2z6"/><persName ref="p8049">Ioachimo Vadiano</persName>, <lb xml:id="p2z7"/>domino suo colendissimo.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l473">Sangallen</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
