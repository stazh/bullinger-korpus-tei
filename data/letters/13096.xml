			<zone xml:id="p2z4-0" points="2654,1697 2719,1671 2762,1688 2832,1658 2947,1669 3024,1646 3100,1696 3123,1680 3159,1696 3164,1617 3117,1623 3067,1596 3004,1623 2990,1607 2835,1610 2819,1593 2733,1651 2657,1648">2664,1668 2689,1667 2714,1665 2739,1664 2764,1662 2789,1659 2814,1656 2839,1656 2864,1654 2889,1651 2915,1648 2940,1644 2965,1644 2990,1644 3015,1644 3040,1644 3065,1644 3090,1642 3115,1639 3140,1639 3166,1641</zone>
			<zone xml:id="p2z5-0" points="2223,1755 2339,1765 2356,1753 2375,1759 2429,1731 2466,1736 2475,1668 2454,1654 2424,1676 2367,1672 2328,1685 2300,1668 2278,1668 2257,1682 2234,1682">2232,1748 2258,1744 2285,1742 2311,1741 2338,1739 2364,1735 2391,1730 2417,1723 2444,1720 2471,1718</zone>
