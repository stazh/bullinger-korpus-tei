	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Postquam mirabili dei providentia gratiaque <lb xml:id="p1z2"/>singulari factum est, ut ministri omnium ecclesiarum <lb xml:id="p1z3"/>in <placeName ref="l862">Helvetia</placeName> consenserunt in eam Confessionem, <lb xml:id="p1z4"/>quam antea vidistis et in quam etiam vos con<lb xml:id="p1z5"/>sensistis nobiscum, visum est illam praefixa prae<lb xml:id="p1z6"/>fatione communi omnium nostrum nomine edere in publicum.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Quod felix et faustum sit, precamur, benedicente laboribus <lb xml:id="p1z8"/>nostris domino nostro Iesu Christo.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><placeName ref="l28">Basilienses</placeName> responderunt <lb xml:id="p1z9"/>sibi non videri necessarium, ut nunc huic se adiungan<lb xml:id="p1z10"/>t confessioni, qui suam superiore anno ediderint; <lb xml:id="p1z11"/>per caetera se nos complecti pro fratribus etc.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z12"/>Iussi autem sumus 12 exempla mittere ad vos, ut ea <lb xml:id="p1z13"/>inter vos distribuatis et inter senatores praecipuos.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Omnia egimus communi magistratus nostri consilio, cuius <lb xml:id="p1z15"/>sumptibus publicis haec res tandem est perfecta.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>Restat vero, colendissimi domini et fratres charissimi, ut primum <lb xml:id="p1z17"/>agamus maximas gratias domino deo nostro pro hoc <lb xml:id="p1z18"/>concordi nostro consensu, deinde, ut sedulo opem eius <lb xml:id="p1z19"/>imploremus, quo laboribus nostris benedicere pergat <lb xml:id="p1z20"/>ipseque efficiat, ut confessio nostra multum boni fructus <lb xml:id="p1z21"/>proferat.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Bene valete, viri venerandi, domini <lb xml:id="p1z22"/>colendissimi et fratres charissimi, orate pro nobis, ac amemus <lb xml:id="p1z23"/>nos mutuum charitate syncera.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z24"/>15. martii anno domini 1566.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/><persName ref="p495">Heinrychus Bullingerus</persName> <lb xml:id="p1z26"/>suo et omnium aliorum <lb xml:id="p1z27"/>pastorum professorumque et <lb xml:id="p1z28"/>ministrorum ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p1z29"/>nomine.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietate, eruditione et vigilantia <lb xml:id="p2z2"/>praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z3"/>Fabritio</persName> et reliquis <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z4"/>et reliquarum 3 Foederum <lb xml:id="p2z5"/>ecclesiarum ministris, dominis <lb xml:id="p2z6"/>colendis et fratribus charissimis <lb xml:id="p2z7"/>nostris.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>