	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto ad te orationem, quam in comitiis imperialibus habuit d. <persName ref="p17841">Carolus <lb xml:id="p1z2"/>Marillac</persName>, archiepiscopus <placeName ref="l546">Viennensis</placeName>, regis legatus pius.</s>
					<s n="3" xml:lang="la">Ubi pacis conditiones <lb xml:id="p1z3"/>recepero, amplissimo senatui mittam, cui salutaria omnia et felicia precor, <lb xml:id="p1z4"/>d. d. etiam <persName ref="p8111">Martiri</persName> et <persName ref="p8011">Gvalthero</persName>.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><placeName ref="l760">Sol[uturi]</placeName> 14. aprilis.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z5"/>Tuus ex animo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurine</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
				</p>
				<p>
					<note>[von anderer Hand.]</note>
				</p>
			</div>
		</body>
	</text>
