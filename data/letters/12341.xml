	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Habuit hodie dominus <persName ref="p8018">Ioannes Hallerus</persName> sermonem non tam pium quam <lb xml:id="p1z2"/>luculentum eumque ex verbis Christi fere ultimis: „Ite in orbem <lb xml:id="p1z3"/>universum et predicate evangelium omni creaturę“,<note xml:id="fn1" type="footnote" n="1"><cit type="bible"><ref>Mk 16, 15</ref></cit>.</note> quem omnes <lb xml:id="p1z4"/>boni, presertim eruditi, magnopere laudaverunt.</s>
					<s n="3" xml:lang="la">Cumque <lb xml:id="p1z5"/>primitię tam foeliciter ceciderint, spero in recessu fructus <lb xml:id="p1z6"/>hinc uberes.</s>
					<s n="4" xml:lang="la">Voluit <persName ref="p8417">quidam</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p8417">Wolfgang Musculus</persName>; vgl. oben <ref target="file12337">Nr. 2290</ref>, 17-37.</note> ex nostris ecclesię ministris <lb xml:id="p1z7"/>primum de eius vocatione scrupulum quęrere<note xml:id="fna" type="footnote" n="a"><hi>In der Vorlage</hi> quere.</note>.</s>
					<s n="5" xml:lang="la">Consules<note xml:id="fn3" type="footnote" n="3"><persName ref="p1410">Jakob Herbrot</persName> und <persName ref="p3927">Hans Welser</persName>.</note> vero <lb xml:id="p1z8"/>durioribus illum verbis docuerunt, quam pie quam que legitime <lb xml:id="p1z9"/>non literis tantum, sed et per me viva voce accersitus <lb xml:id="p1z10"/>sit.</s>
					<s n="6" xml:lang="la">Compescuimus ergo hominem tanquam<pb type="edition" next="657"/> Lutheranę fecis <lb xml:id="p1z11"/><persName ref="p467">Bucerique</persName> progeniem recte.</s>
					<s n="7" xml:lang="la">Clamabunt autem <placeName ref="l558">Witembergenses</placeName>, <placeName ref="l361">Norinbergenses</placeName> <lb xml:id="p1z12"/>et reliqui eius farinę<note xml:id="fn4" type="footnote" n="4">Vgl. Adagia, 3, 5, 44 (<bibl>ASD</bibl> II/5 321f, Nr. 2444).</note> nos <persName ref="p4091">Zvinglii</persName> dogma ingesturos, <lb xml:id="p1z13"/>concordiam dissipaturos, etc.</s>
					<s n="8" xml:lang="la">Scimus quidem<note xml:id="fn5" type="footnote" n="5"><persName ref="p8354">Frölichs</persName> Befürchtungen sollten sich als berechtigt erweisen; s. <hi>Bähler,</hi> <persName ref="p8018">Haller</persName> 10f.</note>.</s>
					<s n="9" xml:lang="la">Scimus et hoc, <lb xml:id="p1z14"/>puritatem evangelii, non nugas hominum nos sequi.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z15"/>in eo, qui est unica salus.</s>
					<s n="11" xml:lang="de">22. novembris 1545.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z16"/>Tuus <persName ref="p8354">G. Lętus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henricho suo Bullingero</persName>, <lb xml:id="p2z2"/>viro incomparabili, etc<note xml:id="fn6" type="footnote" n="6">Vorliegender Brief wie auch die Briefe <ref target="file12334">Nr. 2287</ref>. 2289-2291. 2293. 2295f wurden <persName ref="p495">Bullinger</persName> durch <persName ref="p7228">Zwingli d.J.</persName> überbracht; s. oben <ref target="file12337">Nr. 2290</ref>, 57f; unten 2302, 1-9; 2303.</note>.</s>
				</p>
			</div>
