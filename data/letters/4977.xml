	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Domine observande et colendissime.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">C<lb xml:id="p1z2"/>redo te accepisse hesternas domini mei <persName ref="p629">Coignetii</persName>.</s>
					<s n="3" xml:lang="la">Nunc cum equitare <lb xml:id="p1z3"/>cogeretur, iussit, ut has ad te scriberem et orationem a domino <lb xml:id="p1z4"/>meo <persName ref="p8033">Besa</persName> habitam mitterem teque suo nomine salutarem.</s>
					<s n="4" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z5"/>atque iterum vale meque tui obsequentissimum habe.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Apud <lb xml:id="p1z6"/><placeName ref="l478">Sanc<lb xml:id="p1z7"/>tum Germanum</placeName> die 20a 7bris 1561.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Tui obsequentissimus <persName ref="p448">Ioannes Boutinus</persName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">[<pb/><lb xml:id="p2z1"/>D]omino <persName ref="p495">Henrico Bullingero</persName>, ecclesie <lb xml:id="p2z2"/><placeName ref="l587">Tigurinae</placeName> pastori vigilantissimo, [<lb xml:id="p2z3"/>domin]o meo imprimis colendissimo.</s>
					<s n="8" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tigury</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
