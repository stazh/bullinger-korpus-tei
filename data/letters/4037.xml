	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, clarissime vir.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Cum neminem habeam, qui recta <lb xml:id="p1z2"/><placeName ref="l587">Tigurum</placeName> veniat, ecce per <placeName ref="l28">Basileam</placeName> scribo, salt<lb xml:id="p1z3"/>em ut videas me habere rationem <persName ref="p495">Bullinger</persName>i, cum <lb xml:id="p1z4"/>quo magis nunc cupio conferre quam unquam antea, <lb xml:id="p1z5"/>nimirum undique laudantibus, quae in <placeName ref="l157">Fran<lb xml:id="p1z6"/>cfordiensi</placeName> conventu de coena constituta aut dec<lb xml:id="p1z7"/>larata sunt.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z8"/>Mirareris, si sci<lb xml:id="p1z9"/>res, quot et qui consentiant affirmentque iam <lb xml:id="p1z10"/>duntaxat de forma verborum litigari.</s>
					<s n="4" xml:lang="la">Quis <lb xml:id="p1z11"/>scit, si ante hyemem, quam puto me alibi trans<lb xml:id="p1z12"/>acturum, vos invisam?</s>
					<s n="5" xml:lang="la">Fiet fortassis.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Instat comitiorum finis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ecclesiae pacem <lb xml:id="p1z14"/>sunt habiturae iuxta <placeName ref="l1204">Passaviensem</placeName> conventum; <lb xml:id="p1z15"/>reliqua non attinet scribere.</s>
					<s n="8" xml:lang="la">Nemin<lb xml:id="p1z16"/>i mortalium magis est infensus Caesar quam <lb xml:id="p1z17"/>isti, qui tecum loquitur, praesertim postquam ad filium <lb xml:id="p1z18"/>accessi, et carpinalis <placeName ref="l18">Augustanus</placeName>, quo nemo <lb xml:id="p1z19"/>nunc est coniunctior Caesari, furit adversus <lb xml:id="p1z20"/>eundem me, praesertim post editum libellum, <lb xml:id="p1z21"/>quem literis inseram.</s>
					<s n="9" xml:lang="la">At ego utrunque con<lb xml:id="p1z22"/>temno per gratiam dei ut papam quoque.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Scripsi adversus novum catalogum editum Latine atque <lb xml:id="p1z24"/>Italice, edidi meos in <persName>Osium</persName> quatuor dialogos; <lb xml:id="p1z25"/>mitterem ad vos, si nuncium haberem.</s>
					<s n="11" xml:lang="la">Non de<lb xml:id="p1z26"/>sisto a meis laboribus, qualescunque sint.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Utinam <lb xml:id="p1z27"/>desisterent vestrates tam male de me sentire etc.; <pb/><lb xml:id="p2z1"/>nolo enim id pelagus ingredi, dicam solum me sperare, <lb xml:id="p2z2"/>quod leviter crediderint; sustentor certe praeclara <lb xml:id="p2z3"/>conscientia.</s>
					<s n="13" xml:lang="la">Plura, quae scribam, habeo quidem, <lb xml:id="p2z4"/>sed non talibus litteris, quae longo circuitu veniunt.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z5"/>Utinam cogitaremus de concordia omnes.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Saluta[bis] <lb xml:id="p2z6"/>mihi familiam, scholam atque ecclesiam; iuvate me <lb xml:id="p2z7"/>vestris precibus.</s>
					<s n="16" xml:lang="la"><placeName ref="l512">Tubingae</placeName> die 3. augusti 1559.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z8"/><persName ref="p3375">Ver<lb xml:id="p2z9"/>gerius</persName> frater.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
