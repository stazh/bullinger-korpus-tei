	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Honestissimę uxori tuae, <persName ref="p495">Bullingere</persName> in domino <lb xml:id="p1z2"/>charissime, mea hisce diebus scripsit.</s>
					<s n="3" xml:lang="la">Suspicor <lb xml:id="p1z3"/>eam nonnihil querelam admiscuisse de incivi<lb xml:id="p1z4"/>litate eorum, qui hic ecclesiae serviunt; <lb xml:id="p1z5"/>nam de illa coram me frequenter queritur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Habet una quaeque gens suos mores, quos <lb xml:id="p1z7"/>ego facillime fero.</s>
					<s n="5" xml:lang="la">Suspirat perpetuo <lb xml:id="p1z8"/><placeName ref="l18">Augustanam</placeName> comitatem et humanitatem nec <lb xml:id="p1z9"/>induci se sustinet, ut diversa ingenia <lb xml:id="p1z10"/>boni consulat et praesentem fortunam, ut illa <lb xml:id="p1z11"/>nobis a domino dispensatur, aequo animo ferat.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Ista ob id ad te scribo, ut scias, si quid <lb xml:id="p1z13"/>huiusmodi scriptum est ab uxore mea, <lb xml:id="p1z14"/>scriptum esse praeter animi mei sententiam.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Oro itaque, ut uxori tuae exemplar aliquod <lb xml:id="p1z16"/>literarum praescribas, quo meae respondeat, <lb xml:id="p1z17"/>et ut quamvis fortunam in domino <lb xml:id="p1z18"/>patienter ferat, suadeat, id quod non <lb xml:id="p1z19"/>infrugiferum fore spero; nam diligit eam <lb xml:id="p1z20"/>plurimum et cupide amplexabitur, si quid <lb xml:id="p1z21"/>literarum ab ea acceperit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z22"/>Cęterum de archigrammateo <placeName ref="l291">Lindavi[ensi]</placeName>, qui hactenus <lb xml:id="p1z23"/><placeName ref="l473">Sangalli</placeName> haesit, relatum hisce diebus <lb xml:id="p1z24"/>ad me est, esse illum <placeName ref="l291">Lindaviam</placeName> una <lb xml:id="p1z25"/>cum omni domo sua reversum.</s>
					<s n="9" xml:lang="la">Hac de re <lb xml:id="p1z26"/>si quid habes, oro, scribas.</s>
					<s n="10" xml:lang="la">Venit huc ante <lb xml:id="p1z27"/>triduum <persName ref="p1010">Erbius</persName>, <placeName ref="l411">Richwyleranę</placeName> ecclesiae pastor, <lb xml:id="p1z28"/>duobus fratribus symmystis comitatus indi<lb xml:id="p1z29"/>cavitque in ea regiuncula introductam <lb xml:id="p1z30"/>esse a duce <persName ref="p9708">Udalrycho Wirtembergensi</persName> Metaxycam <lb xml:id="p1z31"/>superstitionem ac pestem ipsisque ministris propositam <lb xml:id="p1z32"/>conditionem, ut vel illi subscribant vel <lb xml:id="p1z33"/>loco cedant, et hac ratione impia putat <lb xml:id="p1z34"/>infelix dux posse se placare imperatorem et dicatum <lb xml:id="p1z35"/>suum contra regis <persName ref="p18477">Ferdinandi</persName> instantiam retinere, <pb/><lb xml:id="p2z1"/>id quod illi perinde cedet atque <placeName ref="l257">Constantiensibus</placeName> <lb xml:id="p2z2"/>consilium plane simile cessit.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Optime vale, <lb xml:id="p2z3"/>virorum colendissime.</s>
					<s n="12" xml:lang="la" ana="salute">Salutem toti domui tuę, <lb xml:id="p2z4"/>dominis etiam et fratribus meis isthic omnibus et domino <persName ref="p506">Ioanni Butlero</persName>, amico charissimo.</s>
				</p>
				<p>
					<s n="13" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l41">Bernę</placeName> 13. Maii 1549.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><persName ref="p8417">W[olfgangus] Musculus</persName>, tuus in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="15" xml:lang="la">Clarissimo theologo M. <persName ref="p495">Heinrycho Bul<lb xml:id="p2z6"/>lingero</persName>, <lb xml:id="p2z7"/><placeName ref="l587">Tigurinae</placeName> ecclesiae antistit<lb xml:id="p2z8"/>i fidelissimo, D. ac frat<lb xml:id="p2z9"/>ri charissimo.</s>
				</p>
			</div>
