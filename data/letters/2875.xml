	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">In hac hora tuę atque <persName ref="p1283">Gesneri</persName> ad me et ad alios <lb xml:id="p1z2"/>literę cum libris offeruntur, quare non licet, ut volui, <lb xml:id="p1z3"/>ad cuncta respondere.</s>
					<s n="3" xml:lang="la"><placeName ref="l157">Frankfortum</placeName> abiturus tabellarius <lb xml:id="p1z4"/>ne momentum expectare voluit.</s>
					<s n="4" xml:lang="la">Curabo, ut recte <lb xml:id="p1z5"/>curentur omnia, libri et literę, quibus sunt inscripte, <lb xml:id="p1z6"/>afferantur.</s>
					<s n="5" xml:lang="la">Ago gracias pro libellis.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z7"/>Pedagogum rogo ut primo quovis tempore mittatis.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/><foreign xml:lang="de">Den frantzhosischen apothekher</foreign> desideramus; habebit <lb xml:id="p1z9"/>conditionem se dignam non tantum apud propha<lb xml:id="p1z10"/>num <lb xml:id="p1z11"/>populum, sed inserviet valetudinario... que civi <lb xml:id="p1z12"/>podagrico in exhibendis medicinis; hunc sentiet <lb xml:id="p1z13"/>divitem, liberalem et parentem.</s>
					<s n="8" xml:lang="la">Conditio nulli <lb xml:id="p1z14"/>locabitur, sed in istius adventum differetur.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>O bone deus, quanta aviditate tuas contra <lb xml:id="p1z16"/>impanationem impiam cogitationes expectavi; eas <lb xml:id="p1z17"/>legam diligentissime.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/><placeName ref="l619">Bavari</placeName>, deo gloria, excusserunt iugum pontificium; data <lb xml:id="p1z19"/>est urgentibus nobilibus et subditis communio <lb xml:id="p1z20"/>sub utraque, libertas ciborum, conciones pię <lb xml:id="p1z21"/>non tantum indulgendo; <foreign xml:lang="de">sunder der hertzog mueß <lb xml:id="p1z22"/>ins landpuech schreiben,</foreign> et si ordinarii episcopii <lb xml:id="p1z23"/><placeName ref="l1725">Salisburgensis</placeName>, <placeName>Aistetensis</placeName>, <placeName ref="l18">Augustanus</placeName>, <placeName ref="l1706">Frisingensis</placeName> etc., <lb xml:id="p1z24"/>ad quos pro consensu scribet princeps, recusarent, <lb xml:id="p1z25"/>nihilominus princeps concessa velit habere <lb xml:id="p1z26"/>rata.</s>
					<s n="11" xml:lang="la">Sed non licet plura.</s>
					<s n="12" xml:lang="la">Brevi mittam acta illorum <lb xml:id="p1z27"/>comitiorum <persName>Bavaricorum</persName>.</s>
					<s n="13" xml:lang="la">Hec eadem dicito <persName ref="p1283">Gesnero</persName> <lb xml:id="p1z28"/>nostro.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Ocyssim<lb xml:id="p1z29"/>e 29. martii anno 56.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><persName ref="p2856">Geryon</persName> <lb xml:id="p1z30"/>t[uus].</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pientissimo atque doctissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tygurensis</placeName> ecclesię episcopo, <lb xml:id="p2z4"/>domino et fratri observandissimo.</s>
					<s n="17" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zurch</placeName> <lb xml:id="p2z6"/>in <placeName ref="l862">Schweit<lb xml:id="p2z7"/>z</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
