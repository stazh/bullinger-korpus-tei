	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi humanissimas tuas literas, colendissime <lb xml:id="p1z2"/>d. pater, et quidem magno gaudio, utpote qui non<lb xml:id="p1z3"/>dum sis defatigatus nos quoque de multis erudire, <lb xml:id="p1z4"/>quamvis et negocia et aetas id muneris et officii <lb xml:id="p1z5"/>merito denegare possit.</s>
					<s n="3" xml:lang="la">Agimus gratias omnes et deum <lb xml:id="p1z6"/>rogamus enixe, ut ille vires tibi sufficiat, quae <lb xml:id="p1z7"/>porro comodo nobis esse possint.</s>
					<s n="4" xml:lang="la">Ex <placeName ref="l834">Italia</placeName> quaedam <lb xml:id="p1z8"/>essent, sed auditu iniucunda, utpote tyrannidem <lb xml:id="p1z9"/>redolentia pontificis inauditam, de qua proxime.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Nunc enim, quod uxor peperit mea et 7m mihi <lb xml:id="p1z11"/>dedit hodierno die, ultra nihil possum.</s>
					<s n="6" xml:lang="la">Ignosces ergo <lb xml:id="p1z12"/>et brevitati meae et celeritati.</s>
					<s n="7" xml:lang="la">Dedit mihi <lb xml:id="p1z13"/>vir amplissimus praefectus huius urbis hasce literas <lb xml:id="p1z14"/><placeName ref="l28">Basileam</placeName> pertinentes, quas, si citra tuam <lb xml:id="p1z15"/>molestiam commoda et obvia aliqua occasione <placeName ref="l28">Ba<lb xml:id="p1z16"/>sileam</placeName> mittere possis, gratissimum utrique fecer[is]; s<lb xml:id="p1z17"/>at autem cito, si sat bene; pecuniis enim sunt onustę.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Salutant tu[am] <lb xml:id="p1z18"/>humanitatem d. <persName ref="p8057">Campellus</persName>, qui in auxilium <lb xml:id="p1z19"/>neptis suae, filiae d. <persName ref="p8359">Philippi Gallicii</persName>, huc se contulit, <lb xml:id="p1z20"/>quae a viro cupit divertere ob inemendabilem <lb xml:id="p1z21"/>et desperatam diuturnamque sęvitiam illius etc.</s>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z22"/>Salutant te etiam d. consul[es]<note type="margin">a. R. coss.</note>, d. <persName ref="p6130">Pontisella</persName>, d. <persName ref="p20473">Gantnerus</persName>, <lb xml:id="p1z23"/>d. <persName ref="p1770">Carolus</persName>, d. <persName ref="p8186">Bonettus</persName>, d. <persName ref="p8432">Fridericus a Salicibus</persName>, <lb xml:id="p1z24"/>d. <persName>Balthasar Planta</persName>, frater d. <persName>Rhetiensis</persName>, homo <lb xml:id="p1z25"/>evangelio faventissimus, et plures alii, quorum <lb xml:id="p1z26"/>nomine de industria subticere brevitas iussit <lb xml:id="p1z27"/>et sexcenta negocia.</s>
					<s n="10" xml:lang="la">Te deus, colendissime mi domine, <lb xml:id="p1z28"/>diutissime nobis et aeternum servet.</s>
					<s n="11" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Ocyssime <placeName ref="l98">Curię</placeName> 1570. 6. februarii.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z29"/>T[uae] <lb xml:id="p1z30"/>d[ominat<lb xml:id="p1z31"/>ionis] subiectissimus <persName ref="p8016">Th[<lb xml:id="p1z32"/>obias]<lb type="manual"/> Eg[linus]</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo omnigenaque <lb xml:id="p2z2"/>et virtutis et eruditionis <lb xml:id="p2z3"/>luce splendidissimo <lb xml:id="p2z4"/>clarissimoque viro d. d. <lb xml:id="p2z5"/><persName ref="p495">Hennrico Bullingero</persName>, <lb xml:id="p2z6"/><placeName ref="l587">Tigurinę</placeName> ecclesię antistiti <lb xml:id="p2z7"/>primario, d. suo aeternum <lb xml:id="p2z8"/>colendissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="de"><lb xml:id="p2z9"/><placeName ref="l587">Zürych</placeName>.</s>
				</p>
			</div>
