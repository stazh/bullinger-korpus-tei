			<zone xml:id="p2z2-0" points="2071,1166 2320,1192 2405,1165 2473,1189 2599,1176 2654,1200 2740,1183 2739,1115 2070,1115">2076,1163 2109,1163 2142,1161 2175,1160 2209,1160 2242,1160 2275,1160 2308,1161 2342,1163 2375,1163 2408,1163 2441,1163 2475,1163 2508,1165 2541,1164 2574,1164 2608,1166 2641,1166 2674,1166 2707,1165 2741,1160</zone>
			<zone xml:id="p2z3-0" points="2062,1285 2155,1273 2254,1300 2459,1269 2540,1301 2784,1251 2784,1177 2743,1170 2633,1204 2405,1165 2062,1218">2067,1244 2104,1242 2142,1239 2180,1238 2218,1237 2256,1235 2294,1235 2331,1235 2369,1235 2407,1235 2445,1236 2483,1238 2521,1238 2558,1235 2596,1235 2634,1235 2672,1236 2710,1237 2748,1235 2786,1235</zone>
