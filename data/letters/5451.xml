	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Simulac hasce obsignaram, venit ad me doctor <lb xml:id="p1z2"/><persName ref="p8099">Thomas Schopffius</persName> physicus significans, quod <placeName ref="l496">Stu<lb xml:id="p1z3"/>ggardię</placeName> salutarit doctorem <persName ref="p4183">Iacobum Andreę Schmidlin</persName> <lb xml:id="p1z4"/>amice cum illo conferens.</s>
					<s n="2" xml:lang="la">At is magis <persName ref="p458">Brencis<lb xml:id="p1z5"/>sat</persName> quam unquam sua pertinaciter defendens etc.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Isto autumno visitabit ecclesiam cum quibusdam <lb xml:id="p1z7"/>legatis nobilibus; qui omnes ritus pios <lb xml:id="p1z8"/>subvertent etc.</s>
					<s n="4" xml:lang="la" ana="salute">Salutat te <persName ref="p8099">Schopffius</persName><pb/><lb xml:id="p2z2"/>.</s>
				</p>
				<p>
					<note>[Unterschrift, Datum und Adresse fehlen.]</note>
				</p>
			</div>
		</body>
	</text>
