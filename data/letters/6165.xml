	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, vir clarissime.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Spero illustrissimum principem <lb xml:id="p1z2"/>meum non esse abs te alienum, imo favere, <lb xml:id="p1z3"/>quantum video.</s>
					<s n="3" xml:lang="la">Expectabat tuas literas, <lb xml:id="p1z4"/>quibus significares, quid audiretis de nov<lb xml:id="p1z5"/>o exercitu, procederetne an vero <lb xml:id="p1z6"/><placeName ref="l2510">Turcam</placeName> et mare esset impetiturus.</s>
					<s n="4" xml:lang="la">Libenter <lb xml:id="p1z7"/>vero audierat, quae scripseras.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Mitto <lb xml:id="p1z8"/>ad d. legatum regium literas per <placeName ref="l441">Schaffu<lb xml:id="p1z9"/>siam</placeName>, quas tuae commendo fidei.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale et <lb xml:id="p1z10"/>salve, vir amplissime.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Salutat te <persName>doctor <lb xml:id="p1z11"/>Aurelius</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Saluto ego universam familiam, <lb xml:id="p1z12"/>scolam atque ecclesiam.</s>
					<s n="9" xml:lang="la">Gratia et pax d. nos<lb xml:id="p1z13"/>tri Iesu Christi vobiscum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/><placeName ref="l512">Tubingae</placeName> die 11. iunii 1564.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z15"/><persName ref="p3375">Vergerius</persName> frater.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. Henrico <lb xml:id="p2z2"/>Bullinghero <placeName ref="l587">Tigurino</placeName>, ... <lb xml:id="p2z3"/>rat[r]i honorando.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
