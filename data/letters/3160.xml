	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z3"/>S<lb xml:id="p1z4"/>.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z5"/>Non opus, ut de causa, quam hi nostri afferunt, multa <lb xml:id="p1z6"/>scribam; audies eam ex ipsis et habebis per se commendatam; <lb xml:id="p1z7"/>sat scio.</s>
					<s n="3" xml:lang="la">Hic serio hodie tractata fuit; datae sunt <lb xml:id="p1z8"/>istis literae ad senatum <placeName ref="l587">Tigurinum</placeName>.</s>
					<s n="4" xml:lang="la">Aliud erat consilium, <lb xml:id="p1z9"/>ut legatus aliquis ordinis senatorii pisis adderetur, ut <lb xml:id="p1z10"/>videre possent <placeName ref="l587">Tigurini</placeName> et alię civitates (praesertim <placeName ref="l28">Basilienses</placeName> <lb xml:id="p1z11"/>et <placeName ref="l441">Scaphusiani</placeName>, qui huius belluę confoederati sunt eamque su<lb xml:id="p1z12"/>sceptis armis defendunt), quam hęc res nostris cordi sit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z13"/>Significant nostri, quid ipsis videatur; si melius alii praebu<lb xml:id="p1z14"/>erint consilium, ipsi de suo cedent et aliud amplexabunt<lb xml:id="p1z15"/>ur.</s>
					<s n="6" xml:lang="la">Haec paucis, ne nihil per eos ad te darem; <lb xml:id="p1z16"/>reliqua ex ipsis percipies.</s>
					<s n="7" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l41">Bernę</placeName> 23. <lb xml:id="p1z17"/>aprilis 1557.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><persName ref="p8018">I<lb xml:id="p1z18"/>[ohannes] Hall[erus</persName>] tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Cl[arissimo] viro d. <persName ref="p495">Heinrych<lb xml:id="p2z2"/>o Bullingero</persName>, <lb xml:id="p2z3"/>ecclesię <placeName ref="l587">Tigurinę</placeName> pastori <lb xml:id="p2z4"/>fidelissimo, domino <lb xml:id="p2z5"/>et compatri suo <lb xml:id="p2z6"/>colendissimo charis<lb xml:id="p2z7"/>simoque.</s>
				</p>
			</div>
		</body>
	</text>
