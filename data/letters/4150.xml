	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Totus sum in libris scribendis, quos <lb xml:id="p1z2"/>Germanica lingua adorno <lb xml:id="p1z3"/>et molior contra <lb xml:id="p1z4"/>anabaptistarum sectas omnes.</s>
					<s n="3" xml:lang="la">Ita enim dudum <lb xml:id="p1z5"/>postularunt multi viri boni <placeName ref="l20">Inferioris Ger<lb xml:id="p1z6"/>maniae</placeName>; sed et passim in hisce quoque regionibus <lb xml:id="p1z7"/>repullulat anabaptistica pestis.</s>
					<s n="4" xml:lang="la">Scripsi qui<lb xml:id="p1z8"/>dem ante annos 29 contra eosdem libros 4; sed <lb xml:id="p1z9"/>interea multa alia et tempus et anabaptistae <lb xml:id="p1z10"/>nobis confutanda suppeditarunt.</s>
					<s n="5" xml:lang="la">Labor est <lb xml:id="p1z11"/>ingens.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Aliquando cogito me vix absolvere <lb xml:id="p1z12"/>posse, et tamen versor in eo iam dies 14, in <lb xml:id="p1z13"/>quibus absolvi librum primum; festino enim, si pos<lb xml:id="p1z14"/>sim edere ad proximas nundinas.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Tu ora <lb xml:id="p1z15"/>dominum, ut, quae illius gloriae et salutis nostrae sunt, <lb xml:id="p1z16"/>cum ubere fructu faciam viresque alioqui <lb xml:id="p1z17"/>imbecillo et multis laboribus et moeroribus <lb xml:id="p1z18"/>exhausto sufficia[n]t.</s>
					<s n="8" xml:lang="la">Simul enim et in Ieremia <lb xml:id="p1z19"/>pergo nec ullas meas conciones omitto.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>Fortassis erit hic ultimus meus labor.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Sed, <lb xml:id="p1z21"/>quod domino visum fuerit, fiat!</s>
					<s n="11" xml:lang="la">Quaestor ęrarius <lb xml:id="p1z22"/><persName ref="p1041">Edlibachius</persName> heri est elatus maxima populi frequentia; <lb xml:id="p1z23"/>reddidit spiritum deo admiranda cum fide et ala<lb xml:id="p1z24"/>critate.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Senes nostri paulatim deficiunt; <lb xml:id="p1z25"/>dominus adsit nobis.</s>
					<s n="13" xml:lang="la">Scribet filius meus, <lb xml:id="p1z26"/>ubi revaluerit; medicatur nonnihil.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Ipsi dedi <lb xml:id="p1z27"/>literas d. <persName ref="p8127">Pellicano</persName> et viduae <persName ref="p1753">Leonis</persName> et socero <lb xml:id="p1z28"/>tuo procurandas nec dubito de eius fide et di<lb xml:id="p1z29"/>ligentia etc.</s>
					<s n="15" xml:lang="la">Expectamus, quid comitia sint pa<lb xml:id="p1z30"/>ritura, quae incipient 10. vel 11. decembris <placeName ref="l21">Ba<lb xml:id="p1z31"/>denae</placeName>.</s>
					<s n="16" xml:lang="la" ana="farewell">Vale et noli mirari, si rarius scribam <lb xml:id="p1z32"/>et brevius.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Tu nihilominus pergito frequentes <lb xml:id="p1z33"/>ad me dare.</s>
					<s n="18" xml:lang="la">Salvi sint d. <persName>Philippus</persName>, [domini] consules et alii <lb xml:id="p1z34"/>viri boni, amici, fratres, <persName ref="p6130">Pontasella</persName> etc.</s>
					<s n="19" xml:lang="la">8. decembris 1559.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z35"/><persName ref="p495">Bullingerus</persName> tuissimus.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>ministro, domino suo <lb xml:id="p2z4"/>colendo et fratri charissimo.</s>
					<s n="22" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
