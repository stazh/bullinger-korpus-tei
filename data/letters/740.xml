	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/><placeName ref="l296">Londini</placeName> 17. die novembris 1549.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">L<lb xml:id="p1z3"/>AUS DEO!</s>
					<s n="3" xml:lang="la">S. D. P.</s>
					<s n="4" xml:lang="la">Literas tuas humanissimas, mit domine observande, <lb xml:id="p1z4"/>Ultima augusti datas, nunc primum ante biduum accepi una <lb xml:id="p1z5"/>cum sarcinula quadam epistolarum pro domino <persName ref="p1560">Ioanne <lb xml:id="p1z6"/>Hopero</persName> et aliis quibusdam fratribus tuis et amicis, quas <lb xml:id="p1z7"/>statim illis tradidi, quibus fuerunt inscripte per te.</s>
					<s n="5" xml:lang="la">De meis <lb xml:id="p1z8"/>autem literis ut pauca scribam: primum magnas tue charitati <lb xml:id="p1z9"/>gratias refero, quod me adhortari ad pietatis studium <lb xml:id="p1z10"/>atque a mundi huius nimiis curis dehortari non desinis.</s>
					<s n="6" xml:lang="la">Debe<lb xml:id="p1z11"/>remus enim, fateor, nos mutuis istiusmodi scriptis ac serm<lb xml:id="p1z12"/>onibus nos invicem admonere.</s>
					<s n="7" xml:lang="la">Quod consensio sit vestrum <lb xml:id="p1z13"/>et domini <persName ref="p540">Ioannis Calvini</persName> in re sacramentaria, libenter <lb xml:id="p1z14"/>audio; neque dubito, quin dominus <persName ref="p1560">Hoperus</persName> permittet eand<lb xml:id="p1z15"/>em me perlegere brevi.</s>
					<s n="8" xml:lang="la" ana="salute">Salutationes tuas ad D. <persName ref="p8107">Bartholemeum <lb xml:id="p1z16"/>Trehernium</persName> et D. <persName ref="p2336">Bernardinum</persName> lubentissime, quamprimum <lb xml:id="p1z17"/>potero, perfitiam, atque illos tuo nomine orabo, ut cupis, quod, <lb xml:id="p1z18"/>quanvis nunc ad eos scribere tibi non fuit otium, ne eam illi <lb xml:id="p1z19"/>ob rem ad te omittant scribendi offitium.</s>
					<s n="9" xml:lang="la" ana="salute"><persName ref="p5231">Uxor</persName> mee tuo nomine <lb xml:id="p1z20"/>multam salutem precatus sum, et illi tuam pietatem vi<lb xml:id="p1z21"/>cissim resalutat, ac bene proficere in literis sacris ad dei <lb xml:id="p1z22"/>gloriam ecclesieque edificationem quam affectuosissime optat.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Illa iam a mense augusto valde laborabat gravibus <lb xml:id="p1z24"/>morbis, ita ut de vita eius diu nos omnes desperavimus.</s>
					<s n="11" xml:lang="la">Sed <lb xml:id="p1z25"/>vivit dominus, qui ad inferos deducit et reducit, et nunc <lb xml:id="p1z26"/>illam respirandi tempusculum dedit, ita quod incepimus <lb xml:id="p1z27"/>de illa spem aliquam concipere, quod brevi melius <lb xml:id="p1z28"/>se habebit et tandem se recipiet.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Pro hoc precor te atque <lb xml:id="p1z29"/>omnes istic symmistas tuos et fratres, ut orare dominum <lb xml:id="p1z30"/>dignemini sedulo.</s>
					<s n="13" xml:lang="la">Primum enim matricis suffocatione <lb xml:id="p1z31"/>diu, deinde deliquiis animi per unam integram fere [h]eb<lb xml:id="p1z32"/>domamdam subinde, postremo ad hunc <lb xml:id="p1z33"/>usque diem quaterna <lb xml:id="p1z34"/>febri graviter laborabat.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">De statu nostri regni presenti scio quod ex literis <lb xml:id="p1z35"/>charissimi fratris <persName ref="p505">Ioannis Burcheri</persName> certior sis.</s>
					<s n="15" xml:lang="la">In summa, <lb xml:id="p1z36"/>speramus adhuc nobiscum mansurum Christum, quanvis <lb xml:id="p1z37"/>ante mensem multis videbatur pre se ferre se longius vo<lb xml:id="p1z38"/>luisse ire, immo ultra mare.</s>
					<s n="16" xml:lang="la">Sed virtus domini in infir<lb xml:id="p1z39"/>mitate perficitur.</s>
					<s n="17" xml:lang="la" ana="salute">D. <persName ref="p8127">Pellicanum</persName>, D. <persName ref="p8171">Bibliandrem</persName>, et ceteros <lb xml:id="p1z40"/>qui me apud vos norunt, precipue autem D. <persName ref="p506">Butlerum</persName> <lb xml:id="p1z41"/>una cum uxore illius ac tua piissima <persName ref="p8051">coniuge</persName>, salutabis.</s>
					<s n="18" xml:lang="la">Et <lb xml:id="p1z42"/>domino <persName ref="p506">Butlero</persName>, si placet, istam chartam impressam hisce <lb xml:id="p1z43"/>inclusam dabis, ut legat et tibi interpretetur.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z44"/>Dominus Iesus te diu incolumem nobis conservet.</s>
					<s n="21" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z45"/>Tuus, <persName ref="p1548">RICHARDUS HILLIS</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tigurine</placeName> ecclesie contion<lb xml:id="p2z3"/>atori precipuo, et amico <lb xml:id="p2z4"/>mihi imprimis charo, <lb xml:id="p2z5"/>dentur litere.</s>
					<s n="24" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiburi</placeName>.</s>
				</p>
			</div>
