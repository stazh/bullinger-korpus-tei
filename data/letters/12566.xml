			<zone xml:id="p2z9-0" points="431,1515 568,1444 716,1458 843,1518 1246,1504 1243,1414 1161,1394 1117,1425 972,1381 914,1416 755,1389 714,1425 631,1378 568,1422 524,1394 428,1403">444,1442 484,1442 524,1442 565,1442 605,1442 645,1443 686,1445 726,1445 766,1445 807,1445 847,1445 887,1448 928,1448 968,1450 1008,1451 1049,1452 1089,1455 1129,1457 1170,1458 1210,1463 1251,1460</zone>
