	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D.
					<lb xml:id="p1z2"/>Ut partus virginis toti humano, qui faustus
					<lb xml:id="p1z3"/>fuit atque felix, ita ut hic annus tibi tuisque
					<lb xml:id="p1z4"/>imprimis vero afflictae Christi ecclesiae felix sit
					<lb xml:id="p1z5"/>ac salutaris, ex animo precor. Binas ab hu
					<lb xml:id="p1z6"/>humanitate tua literas accepi, primas quidem
					<lb xml:id="p1z7"/>1 alteras vero 23. decembris die, Ad qua
					<lb xml:id="p1z8"/>quidem, si quid tua humanitate dignum
					<lb xml:id="p1z9"/>fuisset oblatum, dudum respondissem. Num
					<lb xml:id="p1z10"/>quia symmystam pro tabellaria
					<lb xml:id="p1z11"/>habeo, breviter ad utrasque respondebo.
					<lb xml:id="p1z12"/>Imprimis igitur gratias ago, quod quae nova
					<lb xml:id="p1z13"/>Hinc inde diligenter abs te collecta sunt
					<lb xml:id="p1z14"/>humaniter communicasti. Cum enim
					<lb xml:id="p1z15"/>quam nactus sum Spartam pro virili
					<lb xml:id="p1z16"/>ornare tantum studeam, ideoque plerumque
					<lb xml:id="p1z17"/>angulo meo delitescam, parum aut
					<lb xml:id="p1z18"/>nihil fere mihi vel a nostris vel ab
					<lb xml:id="p1z19"/>aliis communicati. Accedit eorum negliatem
					<lb xml:id="p1z20"/>quorum maxime intererat, ea
					<lb xml:id="p1z21"/>etiam curiose explorare, quae ad defensionem
					<lb xml:id="p1z22"/>patriae et ecclesiae scitu pernecessario
					<lb xml:id="p1z23"/>Quae ipse quoque minus equidem
					<lb xml:id="p1z24"/>curarem, nisi ad accendenda et nostra
					<lb xml:id="p1z25"/>et populi vota multum facerent.
					<lb xml:id="p1z26"/>Tantam profecto in plerisque et ecclesiae
					<lb xml:id="p1z27"/>et reipublicae securitatem cerno, ut ad eam
					<lb xml:id="p1z28"/>interdum tam non toto animo constert
					<lb xml:id="p1z29"/>atusvehementissime exhorrescam.
					<lb xml:id="p1z30"/>Quam ad quaestionem meam attinet,
					<lb xml:id="p1z31"/>de frequentiore eucharistiae usu inducendo
					<lb xml:id="p1z32"/>accepi sentiam tuam. Non enim consulis
					<pb/>
					<lb xml:id="p2z1"/>ut consuetudae multis annis usurpata mutetur
					<lb xml:id="p2z2"/>Eam equidem ipse quoque mutari nolui, quemam
					<lb xml:id="p2z3"/>ad constituta festa pertinet, sed optarim
					<lb xml:id="p2z4"/>addi his aliquot alios pro libertate nostra
					<lb xml:id="p2z5"/>per intervalla iusta olies. Quae me vero
					<lb xml:id="p2z6"/>ad hanc sententiam causae trahant, antea
					<lb xml:id="p2z7"/>breviter exposui, nec obstat Augustini
					<lb xml:id="p2z8"/>consilium, ut sic sentiam; nam apud me
					<lb xml:id="p2z9"/>certum est Augustinum in ea epistola neque piis
					<lb xml:id="p2z10"/>gubernatoribus neque ipsis ecclesiis quicquam
					<lb xml:id="p2z11"/>de ritibus in aliam formam mutandis
					<lb xml:id="p2z12"/>praescribere, si ad meliorem ordinem,
					<lb xml:id="p2z13"/>maiorem  et ecclesiae aedi
					<lb xml:id="p2z14"/>deservire iudicentur.
					<lb xml:id="p2z15"/>eos, qui usitatam consuetudinem
					<lb xml:id="p2z16"/>primum induxerunt, contra libertatem
					<lb xml:id="p2z17"/>nostram quicquam instituere, sed suis tantum
					<lb xml:id="p2z18"/>den enidius frnerere elquisie elis
					<lb xml:id="p2z19"/>Nec etiam video, quaenam concertationes
					<lb xml:id="p2z20"/>tuendae esnt, si pio gravis modestoque
					<lb xml:id="p2z21"/>et ministrorum et ecclesiae consilio atque consen
					<lb xml:id="p2z22"/>sensu constitutis diebus adderentur et
					<lb xml:id="p2z23"/>alii, cum quidem nemo ad coenae
					<lb xml:id="p2z24"/>usum neque his neque aliis diebus cogeretu
					<lb xml:id="p2z25"/>Multa equidem intra eos, quos a pria abfui
					<lb xml:id="p2z26"/>nnos, in aliam formam mutata nunc
					<lb xml:id="p2z27"/>video, quae longe utilius aut saltem tolerati
					<lb xml:id="p2z28"/>in pristina consuetudine e
					<lb xml:id="p2z29"/>mansissent et pleraque necessaria aut
					<lb xml:id="p2z30"/>remissa.
					<pb/>
					<lb xml:id="p3z1"/>remissa aut omissa aut in deteries p
					<lb xml:id="p3z2"/>mutata sunt; sed desino addere plura
					<lb xml:id="p3z3"/>Non enim eum humanitate tua con
					<lb xml:id="p3z4"/>ta gratia, ut initio huius quaestiao
					<lb xml:id="p3z5"/>contestatus sum, sed animi in hac
					<lb xml:id="p3z6"/>mei signcandi causaista scribo.
					<lb xml:id="p3z7"/>nec praescribere aliis ecclesiis quicquam valo
					<lb xml:id="p3z8"/>sed meam, ut dictum est, spartam, pi
					<lb xml:id="p3z9"/>ornare cupio; ut enim usitatam con
					<lb xml:id="p3z10"/>suetudinem non reprhendo aut abiicio.
					<lb xml:id="p3z11"/>ita frequentiorem sanctissime et utilissim
					<lb xml:id="p3z12"/>mysterii usum magis approbo, et si aequi
					<lb xml:id="p3z13"/>atque salutaribus rationibus fieri possit.
					<lb xml:id="p3z14"/>imprimis promovere ubique desidero.
					<lb xml:id="p3z15"/>Vesanum, ut vere scribis, Illyrici librum
					<lb xml:id="p3z16"/>CCelestini enim nondum vidi) aliqua ex par te
					<lb xml:id="p3z17"/>ei si egro stonpeio inseires ea
					<lb xml:id="p3z18"/>eut illi veterator d sanio aliud est, quam
					<lb xml:id="p3z19"/>quod bene dicta sycophantice exagitat
					<lb xml:id="p3z20"/>et amnisi qura scribiosissime vexati trat
					<lb xml:id="p3z21"/>omnia corporalia ecclesiae pericula superant.
					<lb xml:id="p3z22"/>Deius hiis quoqs tandem fuiem dabit
					<lb xml:id="p3z23"/>Quid praeterea apud nos agatu ex symaia
					<lb xml:id="p3z24"/>mysta melius quam ex literis cognosces
					<lb xml:id="p3z25"/>Vale. Datum raptim 12. ianuarii anno
					<lb xml:id="p3z26"/>568.
					<lb xml:id="p3z27"/>Tuae humanitates
					<lb xml:id="p3z28"/>studiosissimu
					<lb xml:id="p3z29"/>Iohannes Conradus Ulmerus.
					<pb/>
					<lb xml:id="p4z1"/>Clarissimo omnique eruditionis et
					<lb xml:id="p4z2"/>Virtites genere ornatissimo viro d. Henricho
					<lb xml:id="p4z3"/>Bullingero, antistiti ecclesiae Tigurinę
					<lb xml:id="p4z4"/>vigilantissimo pastri suo in Christo
					<lb xml:id="p4z5"/>colendissimo
				</p>
