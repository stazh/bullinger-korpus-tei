	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Quod miraris ob diuturnum silentium, vir clarissime, nequaquam <lb xml:id="p1z2"/>miror ego, qui raro scribendi occasionem intermitto, si ulla ratione <lb xml:id="p1z3"/>possum.</s>
					<s n="2" xml:lang="la">Verum, quod per mensem nullas a me acceperis literas, <lb xml:id="p1z4"/>nil aliud quam adversa corporis valetudo in causa fuit; <lb xml:id="p1z5"/>vix enim dici potest, quantum tam dira hyemis improbitate <lb xml:id="p1z6"/>sim vexatus.</s>
					<s n="3" xml:lang="la">Laboravi autem potissimum nescio quo pedum <lb xml:id="p1z7"/>morbo ante annos fere quindecim ex periculosa profectio<lb xml:id="p1z8"/>ne contracto, quo factum est, ut rarissime sim egressus <lb xml:id="p1z9"/>ex nido meo, a quo nondum egredior, nisi maxima coactus <lb xml:id="p1z10"/>necessitate.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Novarum autem rerum nihil habemus, quae vos <lb xml:id="p1z11"/>lateant.</s>
					<s n="5" xml:lang="la">Audio tamen marchionem <persName>Albertum</persName> magnum con<lb xml:id="p1z12"/>scripsisse exercitum contra episcopum <placeName ref="l1030">Herbipolensem</placeName>, <lb xml:id="p1z13"/>qui cum <placeName ref="l1703">Bambergensi</placeName> vicino et <placeName ref="l361">Norenbergensibus</placeName> nescio <lb xml:id="p1z14"/>quam confoederationem habere dicitur.</s>
					<s n="6" xml:lang="la">Epistolam <placeName ref="l832">Gallorum</placeName> <lb xml:id="p1z15"/>regis ad statum Romani imperii ad te mitto apud <lb xml:id="p1z16"/>nos hisce diebus excusam.</s>
					<s n="7" xml:lang="la">Adiunxissem cuiusdam Caesareani <lb xml:id="p1z17"/>orationem ad <placeName ref="l822">Germaniae</placeName> proceres contra <placeName ref="l832">Gallum</placeName> <lb xml:id="p1z18"/>conscriptam, si habere potuissem; unicum enim exemplar <lb xml:id="p1z19"/>per <persName ref="p6070">Henricum Petri</persName> ex nundinis <placeName ref="l157">Francfordianis</placeName> ac<lb xml:id="p1z20"/>cepimus.</s>
					<s n="8" xml:lang="la">Excusa est denuo <persName ref="p4868">Functii</persName><note type="margin">a. R.: <persName ref="p4868">Funclii</persName>?</note>.</s>
					<s n="9" xml:lang="la">Chronographia, <lb xml:id="p1z22"/>quam a condita mundo ad nostra usque tempora co<lb xml:id="p1z23"/>ns<lb xml:id="p1z24"/>cripsit et in <placeName ref="l2562">Prussia</placeName> excudi voluit, in cuius fine <lb xml:id="p1z25"/>promittit historiam de vita et morte <persName ref="p2301">Osiandri</persName> contra <lb xml:id="p1z26"/>aemulos eius conscriptam, qui varia de eius morte <lb xml:id="p1z27"/>mendacia sparserunt.</s>
					<s n="10" xml:lang="la">Caetera non vidi, quae propediem <lb xml:id="p1z28"/>emptoribus communicabuntur a bibliopolis nostris.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z29"/>Haec in praesentiarum scribere volui, ne ta<lb xml:id="p1z30"/>bellio vacuus ad te rediret.</s>
					<s n="12" xml:lang="la" ana="farewell">Va<lb xml:id="p1z31"/>le cum uxore et tota familia felicissime.</s>
					<s n="13" xml:lang="la">15. aprilis <lb xml:id="p1z32"/>anno 1553.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z33"/>T[uus] <persName ref="p8406">Lycosthen<pb/><lb xml:id="p2z1"/>es</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Vigilantissimo ecclesiae <lb xml:id="p2z2"/><placeName ref="l587">Tigurinae</placeName> pastori d. <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bullingero</persName>, domino <lb xml:id="p2z4"/>atque amico incompara<lb xml:id="p2z5"/>bili.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
