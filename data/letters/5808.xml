	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Valde dolebamus, reverende in Christo pater, te non recte <lb xml:id="p1z2"/>habere; sed quod ipse medicus, <persName ref="p1283">Gesnerus</persName> inquam noster, <lb xml:id="p1z3"/>nos bene sperare iuberet, dolorem nostrum nonnihil <lb xml:id="p1z4"/>diluit, et certe, nisi mihi plane perusaderem te vale<lb xml:id="p1z5"/>tudinem confirmasse, hoc scriptionis genere supersederem.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Quid enim praeter inanes literas mitto?</s>
					<s n="4" xml:lang="la">sed tamen <lb xml:id="p1z7"/>has ipsas mitto, ut tibi planum faciam non mihi voluntatem, <lb xml:id="p1z8"/>sed materiam defuisse.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Venit ad vos d. <persName ref="p3375">Vergerius</persName>, <lb xml:id="p1z9"/>qui in <placeName ref="l520">Valletelina</placeName> se continuit; ex eo, si quid <lb xml:id="p1z10"/>esset de concilio, ipse coram intelligere potes.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/><placeName ref="l822">Germania</placeName> scribitur dominum <persName>de Adreß</persName> liberatum et magnam <lb xml:id="p1z13"/>spem esse eum in integrum restitutum iri.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">De <persName>Fuggeris</persName> <lb xml:id="p1z14"/>eadem scribuntur <placeName ref="l522">Venetiis</placeName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Qui <placeName ref="l491">Argentorato</placeName> ex <lb xml:id="p1z15"/>nostris mercatoribus redierunt, affirmant pacem inter <lb xml:id="p1z16"/>Gallos et <placeName ref="l830">Anglos</placeName> factam, quibus conditionibus sibi non <lb xml:id="p1z17"/>liquido constare, propterea quod ipsis discedentibus haec primum <lb xml:id="p1z18"/><placeName ref="l491">Argentoratum</placeName> nunciarentur.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Causa <placeName ref="l646">Glaronensis</placeName> <lb xml:id="p1z19"/>quo loco sit, ex actis et literis <placeName ref="l646">Glaronensium</placeName> intellexi.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/>D. <persName ref="p1884">Lavatero</persName>, viro de me optime merito, maximas <lb xml:id="p1z21"/>gratias ago, qui non gravate in nostri gratiam nova <lb xml:id="p1z22"/>illa enotavit.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Plura nunc non scribo; proxime, si quid <lb xml:id="p1z23"/>de rebus Italicis cognovero, officio meo non deero.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Deum <lb xml:id="p1z24"/>rogo, ut te ecclesię suae diu incolumem et integrum conservet.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z25"/><placeName ref="l98">Curię</placeName> 19. iulii anno 1563.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z26"/>Tui observantissimus <persName ref="p8009">Ioh[annes] Fab[ricius</persName>]<pb/><lb xml:id="p2z1"/>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Amplissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, d. suo et in <lb xml:id="p2z3"/>Christo patri reverendo.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>