	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Paucis ante diebus scripsi ad senatum vestrum <lb xml:id="p1z2"/>de expugnatione oppidi <placeName>Valfiniera</placeName>, quae <lb xml:id="p1z3"/>procul dubio maximi ad res nostras est momenti.</s>
					<s n="3" xml:lang="la">I<lb xml:id="p1z4"/>am noster exercitus, qui illic est, ad oppugnationem <lb xml:id="p1z5"/>alterius oppidi (<persName>Chieraseum</persName> appellatur) proficiscitur.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Spero felicem quoque illius oppugnationis fore <lb xml:id="p1z7"/>eventum; quidquid acciderit, vobis <lb xml:id="p1z8"/>significabo.</s>
					<s n="5" xml:lang="la">Scriptum est nuper ad me <lb xml:id="p1z9"/>principes <placeName ref="l749">Saxoniae</placeName> contra recessum <placeName ref="l410">Ratisbonensem</placeName> <lb xml:id="p1z10"/>(ut loquuntur) protestatos esse neque velle rata habere, <lb xml:id="p1z11"/>quae illic ab illorum legatis contra sua mandata, <lb xml:id="p1z12"/>ut dicunt, acta sunt.</s>
					<s n="6" xml:lang="la">Hac de re si quid certi audiveris, <lb xml:id="p1z13"/>rogo, quamprimum mihi significes.</s>
					<s n="7" xml:lang="la">Noster <lb xml:id="p1z14"/>exercitus, qui est in <placeName ref="l834">Italia</placeName>, nihildum fecit; <lb xml:id="p1z15"/>spero tamen nos brevi aliquid illinc habituros <lb xml:id="p1z16"/>novi; quod si alicuius momenti, statim <lb xml:id="p1z17"/>intelligetis.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale.</s>
					<s n="9" xml:lang="la">3a maii.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Tuus <persName ref="p8183">Sanlaurentius</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo theologo d. <lb xml:id="p4z2"/><persName ref="p495">Henrico Bullingero</persName>.</s>
				</p>
			</div>
		</body>
	</text>
