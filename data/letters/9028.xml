	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Clarissime vir et pater in Christo summe colende, binas uno atque <lb xml:id="p1z2"/>eodem die abs te literas accepi, alteras 11. alteras 12. septembris <lb xml:id="p1z3"/>scriptas, ex quibus convenire ea, quae ex <placeName ref="l832">Gallia</placeName> accepimus, cum iis, <lb xml:id="p1z4"/>quae etiam ad vos perlata sunt, imprimis intellexi.</s>
					<s n="3" xml:lang="la">Quod igitur hac <lb xml:id="p1z5"/>immani et perfida caede piorum tantum efferuntur papistae, signum <lb xml:id="p1z6"/>iudico fore eo maturioris vindictae, quae illis immineat a domino.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Quis enim vel immanissimarum gentium sapiens hoc nefandum <lb xml:id="p1z8"/>scelus approbaverit?</s>
					<s n="5" xml:lang="la">Consolatur igitur Christi sententia dicentis:</s>
				</p>
				<p>
					<s n="6" xml:lang="la">"<lb xml:id="p1z9"/>Amen, amen dico vobis, plorabitis et lamentabimini vos; <lb xml:id="p1z10"/>mundus contra gaudebit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Vos autem moerore afficiemini; sed <lb xml:id="p1z11"/>moeror vester vertetur in gaudium."</s>
					<s n="8" xml:lang="la">Quas secum unica <placeName>Zachariae</placeName> <lb xml:id="p1z12"/>lapidatio poenas paulo post traxerit, notum est ex historia.</s>
					<s n="9" xml:lang="la">Interim <lb xml:id="p1z13"/>his exemplis de agenda poenitentia et fide in invocatione seria et <lb xml:id="p1z14"/>assidua exerc<lb xml:id="p1z15"/>enda admonemur.</s>
					<s n="10" xml:lang="la">Proxima dominica d. <persName ref="p264">doctor Burgo<lb xml:id="p1z16"/>verus</persName> in publico diversorio offendit literas <placeName ref="l361">Neroberga</placeName> hospiti <lb xml:id="p1z17"/>nescio a quo traditas ad tuam pertinentes humanitatem, quas, <lb xml:id="p1z18"/>quantum ex pictura coniicere possum, <persName ref="p850">Durnhoferi</persName> esse iudico; <lb xml:id="p1z19"/>eas cum hoc nuncio nunc demum mitto, cum praeter hunc maturius <lb xml:id="p1z20"/>nullus alias offerretur.</s>
					<s n="11" xml:lang="la">Remitto et d. doctoris <persName>Ursini</persName> literas, <lb xml:id="p1z21"/>pro quarum communicatione summas tibi gratias ago.</s>
					<s n="12" xml:lang="la">Nec materiam <lb xml:id="p1z22"/>nec ocium plura scribendi in hoc praesertim nunc vindemiali <lb xml:id="p1z23"/>strepitu et summa nuncii festinatione habeo.</s>
					<s n="13" xml:lang="la">Si quid <lb xml:id="p1z24"/>tua humanitas acceperit vel ex <placeName ref="l832">Gallia</placeName> vel ex <placeName ref="l808">Belgio</placeName>, nobis <lb xml:id="p1z25"/>ut paucis communicet oro.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale in Christo.</s>
					<s n="15" xml:lang="la" ana="salute">Salutant <lb xml:id="p1z26"/>humanitatem tuam reverenter d. d. consules, doctores <persName ref="p2553">Peyerus</persName> <lb xml:id="p1z27"/>et <persName ref="p264">Burgoverus</persName>, <persName>Beatus Leo</persName>, <persName ref="p3043">Benedictus Stockerus</persName> [Stokar, Stockar] <lb xml:id="p1z28"/>iunior et ministri omnes et singuli.</s>
					<s n="16" xml:lang="la" ana="salute">Saluto reverenter omnes <lb xml:id="p1z29"/>symmystas <placeName ref="l587">Tigurinos</placeName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Datum festinantissime 18. <lb xml:id="p1z30"/>septembris anno domini 1572.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z31"/>Tuae humanitatis <lb xml:id="p1z32"/>studiosissimus <lb xml:id="p1z33"/><persName ref="p8109">Iohannes Conradus <lb xml:id="p1z34"/>Ulmerus</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro atque eximio Iesu Christi <lb xml:id="p2z2"/>servo d. <persName ref="p495">Henrico Bullingero</persName> seniori, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> antistiti fidelissimo, <lb xml:id="p2z4"/>domino et patri suo in Christo <lb xml:id="p2z5"/>summe colendo.</s>
				</p>
				<p>
					<s n="20" xml:lang="de"><lb xml:id="p2z6"/>An den ehrwirdigen, hochgelehrten <lb xml:id="p2z7"/>herren <persName ref="p495">Heinrichen Bullinger</persName>n <lb xml:id="p2z8"/>den eltern, dienern der kirchen <lb xml:id="p2z9"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
