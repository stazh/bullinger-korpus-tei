	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quid a legatis nostris <placeName ref="l587">Tiguri</placeName> et alibi impetratum <lb xml:id="p1z2"/>fuerit, nondum cognovi, cum haec causa hodie demum <lb xml:id="p1z3"/>coram diacosiis agitetur, ut opinor.</s>
					<s n="3" xml:lang="la">Utinam rectius <lb xml:id="p1z4"/>per omnia nostris magistratibus conveniret.</s>
					<s n="4" xml:lang="la">Cum <placeName ref="l167">Genevensibus</placeName> <lb xml:id="p1z5"/>etiam lis quaedam fuit nostratibus, cuius non minima pars <lb xml:id="p1z6"/>fuit ceremoniarum diversitas; sed ea hisce diebus quoque <lb xml:id="p1z7"/>per gratiam domini composita est.</s>
					<s n="5" xml:lang="la">Causae Orbanae arbiter <lb xml:id="p1z8"/><placeName ref="l28">Basiliensis</placeName> pro parte nostra sententiam tulit.</s>
					<s n="6" xml:lang="la">Itaque nihil <lb xml:id="p1z9"/>restat, nisi ut votis collectis missa <persName>Orbę</persName> exturbetur, <lb xml:id="p1z10"/>unde est, quod domino agamus gratias et illum perpetuo pro <lb xml:id="p1z11"/>ecclesiae suae incrementis comprecemur.</s>
					<s n="7" xml:lang="la">Utinam eadem <lb xml:id="p1z12"/><placeName ref="l294">Locarnensibus</placeName> contingeret foelicitas et libertas!</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Ex <placeName ref="l832">Gallia</placeName> nihil habemus, praeterquam quod regis legatus <lb xml:id="p1z14"/>hisce diebus huc scripsit regem 9. huius mensis urbem <lb xml:id="p1z15"/>quandam insignem in <placeName ref="l2589">Picardia</placeName> non procul a <placeName>Namursio</placeName> <lb xml:id="p1z16"/>cepisse et, in ea quicquid virile fuerit inventum, <lb xml:id="p1z17"/>interemisse et spem esse, ut ipsum quoque <placeName>Namursium</placeName> capiatur.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/>Regem ipsum esse in armis cum instructissimo exercitu et <lb xml:id="p1z19"/>foeliciter omnia illi succedere.</s>
					<s n="10" xml:lang="la">Sed sic solent <placeName ref="l832">Galli</placeName> sua efferre.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/><persName>Caesar</persName> antiquo more impetus illius patientia frangit et <lb xml:id="p1z21"/>dolis superat.</s>
					<s n="12" xml:lang="la"><placeName ref="l631">Burgundiones</placeName> ferunt ab <placeName ref="l862">Helvetiis</placeName> petere, <lb xml:id="p1z22"/>ut ipsos in tutelam suscipiant; timere enim eos, sibi a <placeName ref="l832">Gallo</placeName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z23"/>Sed quam sit hoc certum, nescio.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Apud nos satis bene <lb xml:id="p1z24"/>se habent omnia, nisi quod <persName>Emanuel</persName> iterum nobis ablatus <lb xml:id="p1z25"/>est; visum enim est nostris illum <placeName ref="l280">Lausannę</placeName> commodius quam <lb xml:id="p1z26"/>hic agere posse.</s>
					<s n="15" xml:lang="la">Ita, quicquid tentemus, solum nostrum omnino <lb xml:id="p1z27"/>literarum non videtur ferax esse velle.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Arma spirant plęrique <lb xml:id="p1z28"/>omnes et lata imperia, non literas, cum tamen nullum tanto im<lb xml:id="p1z29"/>perio ornamentum maius (ut de utilitate nihil dicam) <lb xml:id="p1z30"/>accedere posset quam eruditorum virorum copia.</s>
					<s n="17" xml:lang="la" ana="salute"><persName ref="p8417">Musculus</persName> <lb xml:id="p1z31"/>cum suis bene valet et vos salutat; idem faciunt <lb xml:id="p1z32"/>mei.</s>
					<s n="18" xml:lang="la">Tu si quid habeas novi, fac cognoscamus <lb xml:id="p1z33"/>nos quoque.</s>
					<s n="19" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="20" xml:lang="la"><placeName ref="l41">Bernae</placeName> 27. iulii 1554.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z34"/>Tuus ex animo <lb xml:id="p1z35"/><persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, domino <lb xml:id="p2z4"/>et compatri suo perpetua <lb xml:id="p2z5"/>fide colendo.</s>
				</p>
			</div>
