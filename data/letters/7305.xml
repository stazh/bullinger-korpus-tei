	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi, observande pater <persName ref="p495">Bullingere</persName>, quod ad te missum <lb xml:id="p1z2"/><placeName ref="l491">Argentina</placeName>.</s>
					<s n="3" xml:lang="la">Curavi ad me perferendum testi<lb xml:id="p1z3"/>monium quoddam veritatis meę existimationi <lb xml:id="p1z4"/>pernecessarium; erat enim protervis et in<lb xml:id="p1z5"/>gratis hominibus, qui, ne videantur iniuste <lb xml:id="p1z6"/>suum eiecisse pastorem, nihil non excogitant <lb xml:id="p1z7"/>calumniarum, os occludendum veritate et <lb xml:id="p1z8"/>bonorum virorum testimonio.</s>
					<s n="4" xml:lang="la">Ago igitur tibi <lb xml:id="p1z9"/>gratias ac remitto epistolam <persName ref="p8127">Conradi</persName> nostri.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>In <placeName ref="l834">Italia</placeName> ubique colligitur pro <lb xml:id="p1z11"/><placeName ref="l832">Gallia</placeName> contra nostros.</s>
					<s n="6" xml:lang="la"><persName>Sabaudus</persName> rogatus, <lb xml:id="p1z12"/>ut esset ductor, fertur recusasse.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Quid nostri concesserint domini, credo te <lb xml:id="p1z14"/>ex aliis iamdudum intellexisse.</s>
					<s n="8" xml:lang="la">Nos <lb xml:id="p1z15"/>rogamus dominum, ut bonam et iust<lb xml:id="p1z16"/>am tuentibus causam adsit et compescat <lb xml:id="p1z17"/>improbos antichristique consilia dissi<lb xml:id="p1z18"/>pet, confundat, perdat et in illius <lb xml:id="p1z19"/>castra totum convertat malum.</s>
					<s n="9" xml:lang="la">Frater <lb xml:id="p1z20"/>quidam, qui ex mea erat ecclesia, <placeName ref="l834">Italus</placeName>, <lb xml:id="p1z21"/>at vir vere pius et probus, cuius <lb xml:id="p1z22"/>adhuc uxor et liberi degunt <placeName ref="l93">Clavennę</placeName>, <lb xml:id="p1z23"/>cum in <placeName ref="l834">Italiam</placeName> profectus esset ob certa <lb xml:id="p1z24"/>negotia, captus a monachis in carcer<pb/><lb xml:id="p2z1"/>em coniectus est et hucusque dei <lb xml:id="p2z2"/>beneficio constans et fortis in fidei <lb xml:id="p2z3"/>confessione permansit ut permanet; commen<lb xml:id="p2z4"/>dandus est ecclesię precibus, ut eum dominus <lb xml:id="p2z5"/>servet in bono et liberet a malo.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z6"/>Comes <persName ref="p2054">Ulysses</persName> laborat etiamnum echtica, <lb xml:id="p2z7"/>sed spes <lb xml:id="p2z8"/>est vitę.</s>
					<s n="11" xml:lang="la" ana="salute">Te vero plurimum <lb xml:id="p2z9"/>salutat.</s>
					<s n="12" xml:lang="la" ana="salute">Cupio omnes fratres meo nomine <lb xml:id="p2z10"/>salutari.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale; dominus vos servet.</s>
					<s n="14" xml:lang="la">Amen.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z11"/>Accingo me et familiam ad iter.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z12"/>Plurio 17. novembris <lb xml:id="p2z13"/>1567.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z14"/>Tuus semper ex animo <persName ref="p4037">H[<lb xml:id="p2z15"/>ieronymus] Z[anchus]</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse vor 823:]</note>
					<s n="18" xml:lang="la"><lb xml:id="p2z16"/>Clarissi<lb xml:id="p2z17"/>mo viro d<lb xml:id="p2z18"/>. <lb xml:id="p2z19"/><persName ref="p495">H[enric<pb/><lb xml:id="p4z1"/>o] Bullingero</persName>, <lb xml:id="p4z2"/>ecclesię <placeName ref="l587">Tigurinę</placeName> pas<lb xml:id="p4z3"/>tori et patri, domino <lb xml:id="p4z4"/>colendissimo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p4z5"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
