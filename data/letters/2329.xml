	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, vir optime.</s>
					<s n="2" xml:lang="la">Ultimas tuas accepi cum <lb xml:id="p1z2"/><placeName ref="l749">Saxonicis</placeName>; placuerunt, sed utinam <lb xml:id="p1z3"/>non tam cruda essent, imo ampliora.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><persName ref="p3375">Ver<lb xml:id="p1z4"/>gerius</persName> fuit <placeName ref="l491">Argentinę</placeName>, unde mihi <lb xml:id="p1z5"/>scripsit tibique, ut videbis e<lb xml:id="p1z6"/>x iis, que <lb xml:id="p1z7"/>mitto.</s>
					<s n="4" xml:lang="la">Nova a m<lb xml:id="p1z8"/>e <lb xml:id="p1z9"/>expectas ex <placeName ref="l834">Italia</placeName>; habuisti a domino <lb xml:id="p1z10"/>consule Hab, que venere tempore co<lb xml:id="p1z11"/>mitiorum.</s>
					<s n="5" xml:lang="la">Iam audies etiam, que <lb xml:id="p1z12"/>ex <placeName ref="l2589">Picardia</placeName>; scribo enim <lb xml:id="p1z13"/>dominis omnia.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Thyrannus ille, si qui<lb xml:id="p1z15"/>d <lb xml:id="p1z17"/>cordi habeat, deberet sufocari et tamen <lb xml:id="p1z18"/>vivit in christianę reipublicę <lb xml:id="p1z19"/>pernici<lb xml:id="p1z20"/>em.</s>
					<s n="7" xml:lang="la">Filius, quidquid iactetur, <lb xml:id="p1z21"/>nondum est in <placeName ref="l830">Anglia</placeName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z22"/>Quod ad vestram rempublicam, audieris a <lb xml:id="p1z23"/>vestris legatis, quo in statu sint <lb xml:id="p1z24"/>ea, de quibus antea scripsimus.</s>
					<s n="9" xml:lang="la">Video <lb xml:id="p1z25"/>omnia pacifica.</s>
					<s n="10" xml:lang="la">Dominus vestris <lb xml:id="p1z26"/>statibus adsit.</s>
					<s n="11" xml:lang="la">Iam isti <placeName ref="l631">Burgundi</placeName>, <lb xml:id="p1z27"/><placeName ref="l822">Almani</placeName> multi et Caesariani ridebant <lb xml:id="p1z28"/>scribebantque, nunc publice recitabunt <lb xml:id="p1z29"/>Helvetios pugnare civilibusque bellis <lb xml:id="p1z30"/>agitari et esse spem, quod Caesar <pb/><lb xml:id="p2z1"/>alteri parti vellet auxilium ferre.</s>
					<s n="12" xml:lang="la">Di <lb xml:id="p2z2"/>boni, qualia monstra.</s>
					<s n="13" xml:lang="la">De iis vester <lb xml:id="p2z3"/>consul poterit amplius communic<lb xml:id="p2z4"/>are.</s>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p2z5"/>Illum saluto <lb xml:id="p2z6"/>teque.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Vale, vir <lb xml:id="p2z7"/>optime etc.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l760">Soluturo</placeName> <lb xml:id="p2z9"/>raptim 5a <lb xml:id="p2z10"/>iulii.</s>
					<s n="17" xml:lang="la">Tuus sem<lb xml:id="p2z11"/>per <persName ref="p8296">Bass[af<lb xml:id="p2z12"/>ontaneus]</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
