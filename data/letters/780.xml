	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Der herr hat unnser stun erhert
					<lb xml:id="p1z2"/>sein gnedig oren zu unns keert
					<lb xml:id="p1z3"/>von unns des lebens peßrung gert
					<lb xml:id="p1z4"/>den glauben gsterkhst in uns gemert
					<lb xml:id="p1z5"/>der sey in ewigkheit geort
					<lb xml:id="p1z6"/>als ich dieen brief zumahen wollen kumbt
					<lb xml:id="p1z7"/>ainem für gewib und war schreiben der
					<lb xml:id="p1z8"/>aber ungenamit sein will, das die von
					<lb xml:id="p1z9"/>Mardenburg in irer veindt abzug herans
					<lb xml:id="p1z10"/>gefallen, sind sollen irer veindt in siben.
					<lb xml:id="p1z11"/>hunderst ersachen, das geschutz erobert
					<lb xml:id="p1z12"/>und in die stat gebracht haben.
					<lb xml:id="p1z13"/>Es wirdet geschriben, das in disem slazen
					<lb xml:id="p1z14"/>ainem grasfen von Mannßfell auf der
					<lb xml:id="p1z15"/>Mardenbeurger seiten am arm abgeschoßen
					<lb xml:id="p1z16"/>se
					<lb xml:id="p1z17"/>Es wirdet den veindten nach dem man
					<lb xml:id="p1z18"/>in den abzugen die großen Hannse hinden
					<lb xml:id="p1z19"/>stelt gollten haben. Was sich weiter zuetregt
					<lb xml:id="p1z20"/>aßs ich eie wißen.
					<pb/>
					<lb xml:id="p2z1"/>la d.
					<lb xml:id="p2z2"/>poi a
					<lb xml:id="p2z3"/>ilear tqu sers messi
					<lb xml:id="p2z4"/>isi .
					<lb xml:id="p2z5"/>
					<lb xml:id="p2z6"/>ecclesi e possim
					<lb xml:id="p2z7"/>uliss a
					<lb xml:id="p2z8"/>er e ils dii.
					<lb xml:id="p2z9"/>to.
					<lb xml:id="p2z10"/>
