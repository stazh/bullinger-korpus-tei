	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissimo viro D. <persName ref="p540">Ioanni Calvino</persName> <placeName ref="l167">Genevensis</placeName> ecclesiae fideli ministro fratri <lb xml:id="p1z2"/>charissimo suo.</s>
					<s n="2" xml:lang="de"><placeName ref="l167">Genff</placeName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">S. D.</s>
					<s n="4" xml:lang="la">Superioribus diebus <placeName ref="l167">Geneva</placeName> veniens <placeName ref="l832">Gallus</placeName> quidam studios<lb xml:id="p1z3"/>us Antidotum tuum contra <placeName ref="l1107">Tridentinae</placeName> synodi decreta tradidit.</s>
					<s n="5" xml:lang="la">Pro quo maximas ago gratias.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z4"/>Sed quoniam promisisti illa quoque quae apud vos <lb xml:id="p1z5"/>excusa sunt contra Libertinos, et Commentarios in 2. ad <lb xml:id="p1z6"/>Corinthios, in epistolam ad Galatas Ephesios Philippenses atque <lb xml:id="p1z7"/>Colossenses, dubito an librorum istorum sis oblitus, <lb xml:id="p1z8"/>an dederis <placeName ref="l832">Gallo</placeName> isti qui in itinere amiserit.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z9"/>Oro itaque ut illos tuos libellos mihi mittas.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Non postulo ut dones, neque enim ita impudens sum ut uno <lb xml:id="p1z11"/>accepto beneficio alterum <lb xml:id="p1z13"/>postulem, sed pretium libenter numerabo.</s>
					<s n="9" xml:lang="la">Apud <lb xml:id="p1z14"/>nos non extant, nec quisquam est apud nos qui <lb xml:id="p1z15"/>viderit.</s>
					<s n="10" xml:lang="la">Quod si alterius opera uti possem <lb xml:id="p1z16"/>ad comparandos illos mihi profecto non essem <lb xml:id="p1z17"/>tibi alias occupatissimo molestus.</s>
					<s n="11" xml:lang="la">Obsecro, boni <lb xml:id="p1z18"/>consulas meam audatiam et hactenus mihi inservias.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z19"/>Spero D. <persName ref="p8018">Hallerum</persName> ea usurum moderatione apu<lb xml:id="p1z20"/>d <placeName ref="l41">Bernates</placeName> ut turbae pulchre subsidant<lb xml:id="p1z21"/>.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Oro autem Dominum ut spiritum cordi hominis liber<lb xml:id="p1z23"/>alissime infundat, cuius instinctu omnia ad gloriam <lb xml:id="p1z24"/>nominis Christi et utilitatem ecclesiarum faciat.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z25"/>Quid autem dicam tibi de ecclesiis <placeName ref="l822">Germanicis</placeName>?</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z26"/>Interierunt pleraeque interemptae per Interim im<lb xml:id="p1z27"/>pium Caesaris.</s>
					<s n="16" xml:lang="la">Conflavit e<lb xml:id="p1z28"/>nim <lb xml:id="p1z29"/>formam religionis corruptissimam <persName ref="p18538">Cesar</persName>, in qua <lb xml:id="p1z30"/>missam, intercessionem divorum, orationes et ob<lb xml:id="p1z31"/>lationes pro defunctis, usum imaginum in tem<lb xml:id="p1z32"/>plis, septem denique sacramenta servanda statibus <lb xml:id="p1z33"/>proposuit.</s>
					<s n="17" xml:lang="la">Adiecit minas saevissimas.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Cesserunt <lb xml:id="p1z34"/>itaque loco urbes praesertim et receperunt <lb xml:id="p1z35"/>formam illam impiissimam.</s>
					<s n="19" xml:lang="la"><placeName ref="l18">Augusta</placeName> recepit 26. <lb xml:id="p1z36"/>Iunii.</s>
					<s n="20" xml:lang="la"><persName ref="p8417">Musculus</persName> ergo dessertus ab ecclesia se ad nos <lb xml:id="p1z37"/>contulit.</s>
					<s n="21" xml:lang="la">Defecerunt vicinae urbes omnes.</s>
					<s n="22" xml:lang="la"><lb xml:id="p1z38"/>Optimus et doctissimus <persName ref="p458">Brentius</persName> aegre evasit cruentissimi lupi manus<lb xml:id="p1z39"/>.</s>
					<s n="23" xml:lang="la">Domino sit gratia qui illum <lb xml:id="p1z41"/>nobis servavit.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Defecerunt <placeName ref="l513">Ulma</placeName>, <placeName ref="l361">Neroberga</placeName>, <lb xml:id="p1z42"/><placeName ref="l320">Memminga</placeName>, <placeName ref="l907">Cambodunum</placeName> etc.</s>
					<s n="25" xml:lang="la"><placeName ref="l491">Argentina</placeName>, <lb xml:id="p1z43"/><placeName ref="l257">Constantia</placeName> et <placeName ref="l291">Lindovia</placeName> perstant adhuc.</s>
					<s n="26" xml:lang="la">Perstan<pb/><lb xml:id="p2z1"/>t adhuc pauci aliquot principes.</s>
					<s n="27" xml:lang="la">Intelligo <lb xml:id="p2z2"/>et <persName>Philippum</persName> animosiorem factum iam melius <lb xml:id="p2z3"/>et liberius dare consilium.</s>
					<s n="28" xml:lang="la">Audio D. <persName ref="p467">Bucerum</persName> fortiter <lb xml:id="p2z4"/>oppugnare Interim.</s>
					<s n="29" xml:lang="la">Utinam excitetur tuus <lb xml:id="p2z5"/>quoque spiritus qui scribas antidotum contra Interim.</s>
					<s n="30" xml:lang="la"><lb xml:id="p2z6"/>Si cares exemplo, fac sciam, mittam brevi.</s>
					<s n="31" xml:lang="la"><lb xml:id="p2z7"/>Et praestaret quidem doctos contra abominationem <lb xml:id="p2z8"/>illam scribere, quo confirmarentur rursus <lb xml:id="p2z9"/>pectora pavitantia.</s>
					<s n="32" xml:lang="la">Oremus quoque Dominum ut erigat <lb xml:id="p2z10"/>lapsos et frenum ponat in rictum illius <lb xml:id="p2z11"/>cruentae bestiae, ne quo libet progrediatur.</s>
					<s n="33" xml:lang="la"><lb xml:id="p2z12"/>Comitia finita sunt ultima Iunii.</s>
					<s n="34" xml:lang="la">Discesserunt <lb xml:id="p2z13"/>principes.</s>
					<s n="35" xml:lang="la">Quid facturus sit Caesar <placeName ref="l18">Augustae</placeName> <lb xml:id="p2z14"/>ignoratur.</s>
					<s n="36" xml:lang="la">Utinam non descendat <placeName ref="l491">Argentoratum</placeName>.</s>
					<s n="37" xml:lang="la"><lb xml:id="p2z15"/>Dominus misereatur ecclesiae suae afflictissimę.</s>
					<s n="38" xml:lang="la" ana="farewell">Vale a<lb xml:id="p2z16"/>eternum cum D. <persName ref="p1049">Farello</persName> et bonis omnibus.</s>
				</p>
				<p>
					<s n="39" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p2z17"/>14. Iulii anno 1548.</s>
					<s n="40" xml:lang="la" ana="salute">Salutant te fratres.</s>
					<s n="41" xml:lang="la"><lb xml:id="p2z18"/>H. B. tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
