	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Si venerit ad vos <persName ref="p8061">Ioannes Utenhovius</persName> <placeName ref="l168">Gandav<lb xml:id="p1z2"/>ensis</placeName> exul et pauper, quaeso, illi benefaciatis pro<lb xml:id="p1z3"/>pter charitatem.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Nescio plane, an sit <persName ref="p8061">Ioannis <lb xml:id="p1z4"/>Utenhovii</persName> nostri cognatus; videtur vir esse non <lb xml:id="p1z5"/>malus, biduum apud me peregit.</s>
				</p>
				<p>
					<s n="3" xml:lang="la" ana="farewell">Vale iterum.</s>
				</p>
				<p>
					<note type="attachment">[Beilage z. e. Brief ohne Dat., Unterschrift und Adresse, ~1566]</note>
				</p>
			</div>
		</body>
	</text>
