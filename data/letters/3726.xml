	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Etsi vix mihi vires sufficiant scribendi a morbo <lb xml:id="p1z2"/>gravi, quo per octiduum laboravi, nolui tamen illum bonum virum <lb xml:id="p1z3"/>sine literis meis ad te dimittere.</s>
					<s n="3" xml:lang="la">Accepi librum <lb xml:id="p1z4"/>Sermonum de Christo nostro diebus festis proque eo tibi magnas <lb xml:id="p1z5"/>ago gratias cupiens etiam referre, si aliquando detur occasio.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Tu perge non sine magna ecclesię utilitate talentum tuum <lb xml:id="p1z7"/>cum foenore reportare ad dominum, qui ut te diu nobis <lb xml:id="p1z8"/>conservet incolumem, ex animo precari pergam et ipse.</s>
					<s n="5" xml:lang="la">Gestit <lb xml:id="p1z9"/>mihi animus pluribus tecum ac de seriis rebus colloqui, sed <lb xml:id="p1z10"/>nunc non possum; alias spero et tempus et vires et occasionem <lb xml:id="p1z11"/>mihi a domino dandam.</s>
					<s n="6" xml:lang="la">D. consul <persName ref="p456">Theodorus Brand</persName> <lb xml:id="p1z12"/>nunc in extremis agit non sine ingenti querela urbis nostrę.</s>
					<s n="7" xml:lang="la" ana="salute"><lb xml:id="p1z13"/>D. <persName ref="p3988">Volfio</persName> ut meis verbis salutem dicas, rogo, utque curet <lb xml:id="p1z14"/>satisfieri <placeName ref="l2472">Polonorum</placeName> suorum nomine, quibus id debetur; me <lb xml:id="p1z15"/>in horas et expectare et alios etiam, ut expectent, exhortari.</s>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z16"/>Bene vale, domine observande ac frater charissime, ac ora d. <lb xml:id="p1z17"/>pro nobis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l28">Basilee</placeName> 4. octobris 1558.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Tuus <persName ref="p1754">Ioannes Iungius</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/>Priusquam obsignarem literas iam nunciatur consulem exhalasse <lb xml:id="p1z20"/>animam hac hora nona antemeridiana.</s>
					<s n="12" xml:lang="la">D. prospiciat <lb xml:id="p1z21"/>ecclesię suę.</s>
					<s n="13" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z22"/>Ignosce obsecro, tam male <lb xml:id="p1z23"/>scribenti; tremulę manus ac capitis dolor melius non <lb xml:id="p1z24"/>sinunt.</s>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Spectate pietatis <lb xml:id="p2z2"/>ac eruditionis viro d. <lb xml:id="p2z3"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z4"/>fratri suo observando <lb xml:id="p2z5"/>ac longe charissimo.</s>
					<s n="16" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
