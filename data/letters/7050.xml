	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>saiam tuum tuo maximo labore homiliis illustratum
					<lb xml:id="p1z2"/>munus longe mihi gratissimum una cum iis literis
					<lb xml:id="p1z3"/>libroque, quem ad clarissimum praetorem Strygerum.
					<lb xml:id="p1z4"/>mittis accepi, quae ego uti bene reddantur curabe
					<lb xml:id="p1z5"/>sedulo; nunc me ad eius libri lectionem paro nov
					<lb xml:id="p1z6"/>mihi voluntas deest, faciam autem te monitorem opium
					<lb xml:id="p1z7"/>magnas quidem iam tibi pro eo munere debeo gratia
					<lb xml:id="p1z8"/>sed quia optimi libri lectio obligatiorem tibim
					<lb xml:id="p1z9"/>reddet gratiarum actionem aifferam. Lgi qui
					<lb xml:id="p1z10"/>ad ti, cum Gothae obsidione scripta sunt mihi
					<lb xml:id="p1z11"/>certi alia omnia scilicet obsessis nihil furi ips
					<lb xml:id="p1z12"/>superesse Grunbachium graviter aegrum decnuibere
					<lb xml:id="p1z13"/>nihil quicquam in urbe praesidii praeter ignavam
					<lb xml:id="p1z14"/>rusticorum manum tu fortan certiora habex
					<lb xml:id="p1z15"/>recttioraque de anxlio recepto scilicer scribum
					<lb xml:id="p1z16"/>Belgas magna a Germanis expectare parataque haberi
					<lb xml:id="p1z17"/>auxilia aurantium Hispanica crudelitatis avaritiani
					<lb xml:id="p1z18"/>statuisse se Besgis adiungere dux Albulae et
					<lb xml:id="p1z19"/>ut Italiam appulit ducturus ii Bulgium minarem illam
					<lb xml:id="p1z20"/>thipanorum Italorumque manum lussius undetuandensis pomcer
					<lb xml:id="p1z21"/>eiet spero optoque bene habebum omnia in Helvetia serrati
					<lb xml:id="p1z22"/>nullum nonmomem lapidem et suis proxpiciam tibi dominoque Gval
					<lb xml:id="p1z23"/>plurimavi salutem. pene vale, vir optime Soloduro 1. icrtii
					<lb xml:id="p1z24"/>1563.
					<lb xml:id="p1z25"/>Tuus eramino.
					<lb xml:id="p1z26"/>Bellie.
					<pb/>
					<lb xml:id="p4z1"/>Reverendo domino
					<lb xml:id="p4z2"/>Henrico Bullingero,
					<lb xml:id="p4z3"/>ecclesiae Tigurinae
					<lb xml:id="p4z4"/>pastori dignissimo
					<lb xml:id="p4z5"/>Tiguri.
				</p>
			</div>
		</body>
