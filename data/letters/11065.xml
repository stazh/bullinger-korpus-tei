	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Quod de commutatione Episcopicellensis scribis<note xml:id="fn1" type="footnote" n="1"><persName ref="p495">Bullinger</persName> muß in einem nicht erhaltenen Brief das Bestreben des Pfarrers von <placeName ref="l50">Bischofszell</placeName>, <persName ref="p1120">Jakob Fehr</persName>, unterstützt haben, an einen anderen Ort zu wechseln; vgl. <bibl source="b8">HBBW VI</bibl> <ref target="file10907">[Nr. 867]</ref>, S. 370, Anm. 2, und unten <ref target="file11085">Nr. 1043</ref>, 38f.</note>, <lb xml:id="p1z2"/>charissime <persName ref="p495">Bullingere</persName>, mihi non arridet.</s>
					<s n="3" xml:lang="la">Iam <lb xml:id="p1z3"/>enim res illius boni viri, ut audio, ceperunt<note xml:id="fna" type="footnote" n="a"><hi>vor</hi> ceperunt <hi>gestrichenes</hi> m.</note> <lb xml:id="p1z4"/>habere melius.</s>
					<s n="4" xml:lang="la">Proinde difficillimum esset optimo <lb xml:id="p1z5"/>viro tanto itinere tantoque familiae onere pere<lb xml:id="p1z6"/>grinari<note xml:id="fn2" type="footnote" n="2">Möglicherweise hatte <persName ref="p495">Bullinger</persName> vorgeschlagen, <persName ref="p1120">Fehr</persName> nach <placeName ref="l850">Österreich</placeName> zu schicken, nachdem <persName ref="p4079">Zwick</persName> wiederholt durch <persName ref="p7604">Balthasar von Kuenring</persName> um die Entsendung eines evangelischen Predigers gebeten worden war (vgl. unten <ref target="file11119">Nr. 1076</ref>, 10-16).</note>.</s>
					<s n="5" xml:lang="la">Adde talem illum habere uxorem et <lb xml:id="p1z7"/>liberos, quemadmodum a bonis amicis intelligo, <lb xml:id="p1z8"/>ut consultius sit manere apud suos.</s>
					<s n="6" xml:lang="la">Sed hoc <lb xml:id="p1z9"/>non nisi ad te scriptum velim.</s>
					<s n="7" xml:lang="la">Ipse forsan <lb xml:id="p1z10"/>acceptis <persName ref="p8171">Theodori</persName> literis<note xml:id="fn3" type="footnote" n="3">Ein entsprechender Brief <persName ref="p8171">Biblianders</persName> ist nicht erhalten.</note> secus respondebit.</s>
					<s n="8" xml:lang="la">Fiat domini <lb xml:id="p1z11"/>voluntas, non nostra.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Tu vale; nam nec <lb xml:id="p1z12"/>ego habeo, quod praeterea scribam.</s>
					<s n="10" xml:lang="la">Libenter <lb xml:id="p1z13"/>audio ad vos vocatum fratrem<note xml:id="fn4" type="footnote" n="4">Der in Baden weilende <persName ref="p4082">Konrad Zwick</persName> war nach <placeName ref="l515">Urdorf</placeName> eingeladen worden, s. oben <ref target="file11064">Nr. 1022</ref>.</note>; spero hunc <lb xml:id="p1z14"/>non defuturum tam candido sodalitio.</s>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z15"/>Iterum vale cum <persName ref="p7042">matre</persName><note xml:id="fn5" type="footnote" ana="bio" n="5"><persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note>, <persName ref="p8051">uxore</persName><note xml:id="fn6" type="footnote" ana="bio" n="6"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note>, liberis<note xml:id="fn7" type="footnote" n="7">Siehe <bibl source="b8">HBBW VI</bibl> <ref target="file10782">[Nr. 744]</ref>, S. 124, Anm. 34.</note> <lb xml:id="p1z16"/>et tota domo tua.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">18. iulii 1537.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z17"/>Tuus totus</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio viro d. <lb xml:id="p2z2"/><persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z4"/>pastori, domino et <lb xml:id="p2z5"/>fratri suo observando.</s>
					<s n="16" xml:lang="de"><placeName ref="l587">Zurch</placeName>.</s>
				</p>
			</div>
		</body>
