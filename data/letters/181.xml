	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hodie ad octavam horam antemeridianam literas recenter allatas <placeName ref="l18">Augusta</placeName> <lb xml:id="p1z2"/>et ad senatum nostrum scriptas consul praelegi iussit.</s>
					<s n="3" xml:lang="la">Inde senatui placuit, <lb xml:id="p1z3"/>ut, quoniam me ad te scripsisse et meas certo nunico iam nunc daturas <lb xml:id="p1z4"/>significassem, oratus sum, ut sensum illarum a scriba utcunque extractum meis <lb xml:id="p1z5"/>includerem et itidem ad te perferendum in scheda curarem.</s>
					<s n="4" xml:lang="la">Legati <placeName ref="l291">Lindavi<lb xml:id="p1z6"/>ensium</placeName> redierunt, diram <persName ref="p18538">Caesaris</persName> voluntatem cum atroci mandato con<lb xml:id="p1z7"/>iunctam afferentes; sed surdo canitur fabula.</s>
					<s n="5" xml:lang="la">Perstant enim, et quo con<lb xml:id="p1z8"/>iunctior esse animorum consensus posset, celebri festo dominicae coenę sese <lb xml:id="p1z9"/>domino addixerunt.</s>
					<s n="6" xml:lang="la">Dominus illos iuvare dignetur; nam urbium partem <lb xml:id="p1z10"/>maximam succumbere infirmitate audimus.</s>
					<s n="7" xml:lang="la">Adeo saeviunt minis <lb xml:id="p1z11"/>et poenis papae <placeName ref="l822">Germanici</placeName>.</s>
					<s n="8" xml:lang="la">Plures enim habemus, inter quos potissim<lb xml:id="p1z12"/>i <persName ref="p7706">Granvellae</persName> gnarus, praesul <placeName ref="l1107">Tridentinus</placeName> et caput abominationis, <lb xml:id="p1z13"/>cardinalis <placeName ref="l18">Augustanus</placeName>, quibus licere aiunt, quicquid libet.</s>
					<s n="9" xml:lang="la">Vigi<lb xml:id="p1z14"/>landum nobis plane, ne subitus aliquis Typho et nos nil tale <lb xml:id="p1z15"/>cogitantes obruat.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l473">Sangalli</placeName>, III. die Iulii, anno XLVIII.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p8049">Ioachimus Vadianus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrycho Bullingero</persName>, <lb xml:id="p2z2"/>urbis <placeName ref="l587">Tigurinae</placeName> episcopo, <lb xml:id="p2z3"/>suo.</s>
				</p>
