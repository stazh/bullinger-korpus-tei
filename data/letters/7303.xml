	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi tuas omnes, honorande pater, quum quas per <lb xml:id="p1z2"/><persName>Fietzium</persName>, affinem meum, tum quas per oeconomum <lb xml:id="p1z3"/><placeName ref="l269">Küngßfeldensem</placeName> ad me misisti.</s>
					<s n="3" xml:lang="la">Legi etiam ea, quae <lb xml:id="p1z4"/>ad ipsum oeconomum scripsisti ac misisti.</s>
					<s n="4" xml:lang="la">His quod <lb xml:id="p1z5"/>ego certi addam, iam non habeo; silent nunc per ali<lb xml:id="p1z6"/>quot dies omnia.</s>
					<s n="5" xml:lang="la">Ferebatur quidem <placeName ref="l862">Helvetios</placeName>, qui <placeName ref="l378">Parisiis</placeName> <lb xml:id="p1z7"/>sunt, fame coactos erupisse ad praedam quandam addu<lb xml:id="p1z8"/>cendam, sed ab adversariis non sine clade repulsos <lb xml:id="p1z9"/>esse; tres enim interiisse capitaneos, et illi quidem nomin<lb xml:id="p1z10"/>abantur <placeName>Praromanus</placeName>, <placeName ref="l922">Friburgensis</placeName> consul, <persName ref="p5342">Hässius</persName> <lb xml:id="p1z11"/><placeName ref="l646">Glaronensis</placeName> et quidam <placeName ref="l760">Solodorensis</placeName>.</s>
					<s n="6" xml:lang="la">Sed quod verum sit hoc, <lb xml:id="p1z12"/>affirmare nondum possum.</s>
					<s n="7" xml:lang="la">Audio <placeName ref="l760">Salodori</placeName> mercatorem <lb xml:id="p1z13"/>quendam <placeName ref="l822">Germanum</placeName> esse captum, propterea quod ista <lb xml:id="p1z14"/>dixerit, nec liberandum fore, donec, quod vero dixerit, <lb xml:id="p1z15"/>cognitum fuerit.</s>
					<s n="8" xml:lang="la">Quod posteriores attinet, transierunt <lb xml:id="p1z16"/>hac duae cohortes non sine fremitu et indignatione plebis <lb xml:id="p1z17"/>nostrae; coacti sunt in diversoriis se continere; <lb xml:id="p1z18"/>alioqui tantus iam erat concursus, ut non sine con<lb xml:id="p1z19"/>flictu abitum fuisset.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Audimus illos proficisci <placeName ref="l301">Lugdunum</placeName>, <lb xml:id="p1z20"/>ut ibi se cum reliquis papisticis copiis coniungant.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Dux <placeName ref="l2478">Sabaudię</placeName> per legatum nostris indicat se a rege <lb xml:id="p1z22"/>urgeri, ut ei suppetias ferat; non posse autem se hoc re<lb xml:id="p1z23"/>nuere, missurum itaque se illi 1000 equites.</s>
					<s n="11" xml:lang="la">Petisse <lb xml:id="p1z24"/>item regem transitum exercitui Italico per ipsius ditionem; <lb xml:id="p1z25"/>hoc ipsum etiam se non posse ei negare et hoc se dominis <lb xml:id="p1z26"/>nostris significare velle, ut sciant, quid sibi apparatus <lb xml:id="p1z27"/>suus velit, nec cogitent, quod contra ipsos aliquid mo<lb xml:id="p1z28"/>liatur.</s>
					<s n="12" xml:lang="la">Apparet hinc communis ille contra pios et veritatem <lb xml:id="p1z29"/>syncretismus; sed de his etiam <placeName ref="l21">Badenae</placeName> agetur cum legatis <lb xml:id="p1z30"/>vestris.</s>
					<s n="13" xml:lang="la">Quid consilii capiendum sit, ignoratur; <lb xml:id="p1z31"/>periculum apparet, si nos quoque huic immiscamus bello; rursum <lb xml:id="p1z32"/>quid eventurum nobis, si nostra pars in <placeName ref="l832">Gallia</placeName> succumbat!</s>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z33"/>Orandus ergo et dominus, ut ipse consilium et prudentiam suggera<lb xml:id="p1z34"/>t et omnia moderetur ad communem pacem ad salutem s<lb xml:id="p1z35"/>uorum et inprimis ad gloriam nominis sui et conservationem <lb xml:id="p1z36"/>veritatis.</s>
					<s n="15" xml:lang="la">Collectae fiunt ab ecclesiis aliquibus pro <lb xml:id="p1z37"/>exulibus <placeName ref="l301">Lugdunensibus</placeName>, qui miseri et exuti prorsus ma<lb xml:id="p1z38"/>gno <lb xml:id="p1z39"/>numero <placeName ref="l167">Genevam</placeName> et <placeName ref="l280">Lausannam</placeName> veniunt.</s>
					<s n="16" xml:lang="la">Quid in urbe <lb xml:id="p1z40"/>nostra futurum sit, nondum scimus; urgemus tamen, ut etiam hic <lb xml:id="p1z41"/>fiat; dominus det successum!</s>
					<s n="17" xml:lang="la">Aliud nunc non habeo; cum <lb xml:id="p1z42"/>primum aliquid accepero, faciam te certiorem.</s>
					<s n="18" xml:lang="la">Dominus te <lb xml:id="p1z43"/>servet!</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute">Salutant te vicissim nostri omnes; saluta tuos quoque.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z44"/><placeName ref="l41">Bernae</placeName> 14. novembris 1567.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><persName ref="p8018">I[<lb xml:id="p1z45"/>ohannes] Hall[erus</persName>], tuus <lb xml:id="p1z46"/>semper.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo doctissimoque viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori fide<lb xml:id="p2z4"/>lissimo, domino meo honorando <lb xml:id="p2z5"/>et compatri charissimo.</s>
				</p>
				<p>
					<s n="23" xml:lang="de"><lb xml:id="p2z6"/>M. <persName ref="p495">Heinrych Bullingern</persName> <lb xml:id="p2z7"/>zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
