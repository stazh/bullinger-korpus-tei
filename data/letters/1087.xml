	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino, binas ad te et d. <persName>Theodorum</persName> scripsi literas, <lb xml:id="p1z2"/>quas inclusi in vas cum pisis, et pulchre me vector <lb xml:id="p1z3"/>decepit, qui vas meum <placeName ref="l28">Basileę</placeName> dimisit me inscio; <lb xml:id="p1z4"/>sed brevi habebitis vos, in quo tu librum <persName ref="p4926">Gerbelii</persName> habes <lb xml:id="p1z5"/>cum aliis nonnullis rebus, quę ad uxorem tuam et <persName ref="p1214">Frisium</persName> <lb xml:id="p1z6"/>attinent.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Nova, quę habui, in literas scriptas invenies.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/><placeName>Pestis</placeName> parum apud nos gliscit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Dominus fidem nostram adaugeat.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Quid tu iam, optime <persName ref="p495">Bullingere</persName>, scribis in ecclesiae utilitatem?</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Imminent ecclesiae ingentia mala, et si liceret <lb xml:id="p1z10"/>divinare, maxima ab hypocrit s, qui inter nos agunt.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>Falsorum fratrum magnus est proventus et uber ubique, quos <lb xml:id="p1z12"/>dominus tandem perdet.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p18477">Ferdinandus</persName> rex exactionem <placeName>Turcicam</placeName> promulgare instituit.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z14"/><persName>Rumusculus</persName> est <placeName>Melitenses</placeName> dominos ingentem cladem accepisse <lb xml:id="p1z15"/>a <persName>Draguth</persName>, rege Africę et <persName ref="p8282">Maximilianum</persName> in <placeName ref="l875">Hispaniis</placeName> <lb xml:id="p1z16"/>magno esse in periculo.</s>
					<s n="10" xml:lang="la">Varii sparguntur de iis rebus rumo<lb xml:id="p1z17"/>res; sed certi nihil habemus.</s>
					<s n="11" xml:lang="la">Haec volui paucis ad <lb xml:id="p1z18"/>te, ne adolescens iste, qui me invisit et se ultro obtulit <lb xml:id="p1z19"/>ad peferendas literas ad te, vacuus ad te rediret.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z20"/>Vale in domino 21. novembris 1550.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/>Uxor mea <foreign xml:lang="de">schenckt uwer hußfrowen ein par <lb xml:id="p1z22"/>messer zuͦ eynem meßkram</foreign> et rogat, ut boni co<lb xml:id="p1z24"/>nsulat.</s>
					<s n="14" xml:lang="la">In vase inclusi sunt etc.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z25"/>T[uus] <persName ref="p1278">Gastius</persName> <lb xml:id="p1z26"/>ex animo.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z27"/>Rescribe.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z28"/>Raptim sub <lb xml:id="p1z29"/>noctem<lb xml:id="p1z30"/>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eruditione et <lb xml:id="p2z2"/>pietate singulari <lb xml:id="p2z3"/>praedito d. <lb xml:id="p2z4"/><persName ref="p495">Heinrycho <lb xml:id="p2z5"/>Bullingero</persName>, pastori <lb xml:id="p2z6"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z7"/>fidelissimo.</s>
				</p>
				<p>
					<s n="19" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>