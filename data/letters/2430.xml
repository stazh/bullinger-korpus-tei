	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p714">Caelius S[ecundus] Curio</persName> per Christum Iesum S. P. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Ut meum perpetuum morem meamque benevolentiam erga te <lb xml:id="p1z3"/>conservem, optime frater, mitto tibi meos De amplit<lb xml:id="p1z4"/>udine beati regni dei dialogos teque obsecro per veterem <lb xml:id="p1z5"/>nostram amicitiam, ut si nihil impium aut <lb xml:id="p1z6"/>contra apostolicam fidem assero, sed sincero animo meam <lb xml:id="p1z7"/>sive prophetiam sive interpretationem ad dei gloriam <lb xml:id="p1z8"/>in medium affero, christiana charitate omnia i<lb xml:id="p1z9"/>nterpreteris in meliorem partes atque editos aequo animo <lb xml:id="p1z10"/>patiare.</s>
					<s n="3" xml:lang="la">Neque tamen haec scribo, quod te aliter facturum <lb xml:id="p1z11"/>existimem, qui tuam in omni re animi lenita<lb xml:id="p1z12"/>tem <lb xml:id="p1z13"/>tuumque in me constantem amorem intelligam, sed quia decet <lb xml:id="p1z14"/>me ita scribere tibi, quem pie colo et amo.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z15"/>Neque enim nescio neminem esse tam cordatum, tam cau<lb xml:id="p1z16"/>tum tamque pium scriptorem (apostolos domini semper <lb xml:id="p1z17"/>excipio), in cuius scriptis, si quis morosus diligentius <lb xml:id="p1z18"/>velit inquirere, non aliquid sit reperturus, quod <lb xml:id="p1z19"/>aliqua reprehensione dignum esse videatur.</s>
					<s n="5" xml:lang="la">Quo <lb xml:id="p1z20"/>nos in eos, qui studio glorię dei aliquid scribunt <lb xml:id="p1z21"/>aut edunt, aequiores esse decet.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale, mi <lb xml:id="p1z22"/>charissime et colendissime frater, et deum pro nobis <lb xml:id="p1z23"/>ora.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Mea uxor et liberi te, tuam tuosque liberos <lb xml:id="p1z24"/>ex animo salutant; idem ego ex animo facio et, <lb xml:id="p1z25"/>ut generos tuos meo nomine salvere iubeas, oro.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z26"/>De <placeName ref="l830">Anglia</placeName> hoc tanquam certum accepi in ea novum <lb xml:id="p1z27"/>eumque maximum motum excitatum esse, ita ut <lb xml:id="p1z28"/>rex et regina fugam meditarentur cum suis <lb xml:id="p1z29"/><placeName ref="l875">Hispanis</placeName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Caussam motus extitisse aiunt, quod vo<lb xml:id="p1z30"/>luerint <placeName ref="l875">Hispanos</placeName> homines arcibus et magistratibus <lb xml:id="p1z31"/>praeficere.</s>
					<s n="10" xml:lang="la" ana="farewell">Iterum vale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l28">Basileae</placeName> 15. octobris 1554.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praeclarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> antistiti sapien[tissimo], <lb xml:id="p2z4"/>fratri et domino suo <lb xml:id="p2z5"/>amantissimo et colendissimo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
