	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Binas abs te accepi literas scriptas 21. octobris cum ea, quam <lb xml:id="p1z2"/>scribis d. <persName>Petro</persName>, qui nunc est in itinere, et intra dies <lb xml:id="p1z3"/>paucos spero incolumem ad vos rediturum.</s>
					<s n="3" xml:lang="la">Absens eram, <lb xml:id="p1z4"/>cum discessit, et cum eius equos remisi, non fuit integrum <lb xml:id="p1z5"/>illum videre; sed vos brevi videbo domino volente.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Cęterum de iis, quae de expeditione <placeName ref="l822">Germanica</placeName> scripsisti, gratiam <lb xml:id="p1z7"/>habeo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Ob simultates aliquas et privatas iniurias ea <lb xml:id="p1z8"/>excitari suspicor et spero causam <placeName ref="l646">Glaronensium</placeName> pacatum exitum <lb xml:id="p1z9"/>habituram.</s>
					<s n="6" xml:lang="la">Prudentes enim omnes <placeName ref="l862">Helvetii</placeName> satis intelligunt, <lb xml:id="p1z10"/>quo in periculo eorum ditio collocabitur quotque sequentur <lb xml:id="p1z11"/>incommoda et calamitates, si illos audiant, qui pretextu <lb xml:id="p1z12"/>religionis turbas movere volunt et amicitię iura violare.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/><persName>Philippum</persName> audio valde angi et sollicitum esse, ut pontificis auctoritas <lb xml:id="p1z14"/>sarta tecta maneat, et in hoc incumbit, ut ministri omnes et qui <lb xml:id="p1z15"/>secus quam in suis regionibus evangelium annunciant, eiiciantur <lb xml:id="p1z16"/>e <placeName ref="l832">Gallia</placeName> et severissime puniantur, qui a Romana sede deficiunt, <lb xml:id="p1z17"/>et profitetur se inimicum fore omnium, qui illis favent.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Ob institutum <lb xml:id="p1z18"/>colloquium in <placeName ref="l832">Gallia</placeName> episcopi <placeName ref="l875">Hispani</placeName> nondum ierunt ad concilium; ex illis <lb xml:id="p1z19"/>sunt deputati archiepiscopus <placeName ref="l3032">Grenade</placeName>, episcopi <placeName ref="l1839">Salamenqua</placeName>, <placeName ref="l301">Leon</placeName> <lb xml:id="p1z20"/>et <placeName>Doviedo</placeName>.</s>
					<s n="9" xml:lang="la">Ignis exussit magnam partem urbis <placeName>Vallidolit</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute"><lb xml:id="p1z21"/>D. d. consulibus et amplissimo magistratui et symmystis salutem multo cum foenore <lb xml:id="p1z22"/>reddas et nostri memor ores tuis in precibus.</s>
					<s n="11" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/>Apud Sanctum Germanum 7. novembris.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z24"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Quod intellex<lb xml:id="p1z25"/>eris ex <placeName ref="l648">Rhetorum</placeName> dieta et <placeName>Here<lb xml:id="p1z26"/>mitarum</placeName> rescribes.</s>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>ex[c]lesie <placeName ref="l803">Tigurine</placeName> pastori <lb xml:id="p2z3"/>vigiantissimo.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
