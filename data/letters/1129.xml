	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Gloriam et pacem a Christo, domino nostro.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Ex eo temporis spatio, quo a <placeName ref="l587">Tiguro</placeName> solvimus, pater charissime, <lb xml:id="p1z3"/>pervenimus in patriam <persName ref="p1541">Ioannis Herteri</persName>, ubi humaniter excepti <lb xml:id="p1z4"/>commorati sumus ad diem Mercurii.</s>
					<s n="4" xml:lang="la">Inde una profecti <placeName ref="l159">Froenfeldam</placeName> <lb xml:id="p1z5"/>ibi pernoctavimus, deinde summo mane ulterius progressi pervenimus <lb xml:id="p1z6"/>in pagum quendam situm in ditione <placeName ref="l507">Doggenburgensium</placeName>, ut appellant, <lb xml:id="p1z7"/>inde rursum die Veneris <placeName ref="l17">Abbatiscellam</placeName>, quam miro desyderio cupie<lb xml:id="p1z8"/>bamus videre, appulimus, ubi sane multis a bonis nostre religioni <lb xml:id="p1z9"/>summopere faventibus honoribus sumus affecti.</s>
					<s n="5" xml:lang="la">Sequenti igitur die sumpto <lb xml:id="p1z10"/>prandio <placeName ref="l473">Sangallum</placeName>, uti proposueramus, iter fecimus et ibidem retenti <lb xml:id="p1z11"/>a multis bonis amicis maximis honoribus non solum a prudenti <lb xml:id="p1z12"/><placeName ref="l473">Sangallensium</placeName> magistratu excepti, qui sex cantheribus ad hoc destinatis nos <lb xml:id="p1z13"/>honoraverunt, verum omnes pene ecclesię antistites et ludi<lb xml:id="p1z14"/>moderatores nostri gratia in publico hospitio, in quo diverteramus, <lb xml:id="p1z15"/>pransi sunt.</s>
					<s n="6" xml:lang="la">Prandio absoluto cum omnibus <lb xml:id="p1z16"/>valedixissemus et pro exhibito honore gratias egissemus, postea has ad te <lb xml:id="p1z17"/>conscripsi literas, dein <placeName ref="l50">Episcopicellam</placeName>, inde <placeName ref="l257">Constantiam</placeName> et <placeName ref="l291">Litopolin</placeName> <lb xml:id="p1z18"/>proficisci proposuimus, dein, quam primum possumus, domum reverti.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z19"/>Quapropter, mi pater, rogo atque obsecro, ne mihi succenseas, quod tam <lb xml:id="p1z20"/>diu haeream apud exteros; do enim operam, ut me moderate et modeste <lb xml:id="p1z21"/>apud omnes geram.</s>
					<s n="8" xml:lang="la">Quodsi hoc (ut non dubito) a te impetravero, <lb xml:id="p1z22"/>polliceor me illud, quod consumpsi tempus, singulari diligentia et <lb xml:id="p1z23"/>studio resartiaturum.</s>
					<s n="9" xml:lang="la">Cetera, utut gesta sunt, presente me certius <lb xml:id="p1z24"/>cognosces.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale.</s>
					<s n="11" xml:lang="la" ana="salute">Salutabis plurimum matrem charissimam, fratrem, <lb xml:id="p1z25"/>sorores et ancillam.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l473">Sangallo</placeName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p477">Ioanes Rodolphus Bullingerus</persName>, filius tuus charissimus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <lb xml:id="p2z2"/>m. <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae <lb xml:id="p2z5"/>pastori, patri dilecto.</s>
				</p>
				<p>
					<s n="16" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
