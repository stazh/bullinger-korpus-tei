	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. A cena libellum huncce<note xml:id="fn1" type="footnote" n="1"><persName ref="p1974">Luthers</persName> "Kurtz Bekentnis"; s. oben <ref target="file12018">Nr. 1971</ref>, Anm. 20.</note>, tantopere a te desideratum,<note xml:id="fn2" type="footnote" n="2">Siehe oben <ref target="file12077">Nr. 2030</ref>, 12-18; 2044, 27-35.</note> <lb xml:id="p1z2"/>a <persName ref="p1055">Frechto</persName> nostro accepi,<note xml:id="fn3" type="footnote" n="3">Aus <placeName ref="l513">Ulm</placeName>. Ein entsprechender Begleitbrief an <persName ref="p8055">Blarer</persName> ist unbekannt.</note> qui potestatem fecit mihi eum<note xml:id="fnb" type="footnote" n="b">eum <hi>über unlesbar gemachtem Wort.</hi></note> ad te <lb xml:id="p1z3"/>mittendi, sed ea lege, ut, ubi usus eo fueris, rursum <lb xml:id="p1z4"/>ad nos remittas; paucissima enim extare exemplaria, <lb xml:id="p1z5"/>quamquam mihi plura plurimis extare videntur, si vel u<lb xml:id="p1z6"/>nicum extet.</s>
					<s n="2" xml:lang="la">Tu pro christiana tua prudentia omnia vide, <lb xml:id="p1z7"/>ut circumspecte agas nihilque <persName ref="p1974">Luthero</persName>, qui nec audire <lb xml:id="p1z8"/>nos nec respondere nobis dignatur, sed omnia ecclesiis Christi <lb xml:id="p1z9"/>scribes, illis vos<note xml:id="fnc" type="footnote" n="c">vos <hi>korrigiert aus</hi> nos.</note> modestissime purgaturus.</s>
					<s n="3" xml:lang="la">Ego <lb xml:id="p1z10"/>tumultuanter tantoque animi dolore legi, ut plane <lb xml:id="p1z11"/>iam, quid legerim, exciderit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="salute">Sed vale cum tuis et domino <lb xml:id="p1z12"/>nos diligenter commenda.</s>
					<s n="5" xml:lang="la">Nequeo plura et spero te <lb xml:id="p1z13"/>superiores meas literas<note xml:id="fn4" type="footnote" n="4">Oben <ref target="file12091">Nr. 2044</ref> vom 5. Dezember.</note>, quas per Saram<note xml:id="fn5" type="footnote" ana="bio" n="5">Eine Verwandte <persName ref="p8055">Blarers</persName>? Die Tochter <persName ref="p21234">Sara</persName> von <persName ref="p8178">Thomas Blarer</persName> (s. <persName ref="p8055">Blarer</persName> BW III 70. 884) wird hier kaum in Frage kommen.</note> misi, accepisse.</s>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z14"/>Iterum vale.</s>
					<s n="7" xml:lang="la">13. decembris 1544.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Tuus <persName ref="p8055">Amb. Bl.</persName></s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>Si iam antea <lb xml:id="p1z17"/>libellum habes,<note xml:id="fn6" type="footnote" n="6">Hatte <persName ref="p495">Bullinger</persName> bereits damals das ihm von <persName ref="p8317">Markus Crodel</persName> zugesandte Exemplar (s. oben <ref target="file12084">Nr. 2037</ref>, Anm. 3) erhalten?</note> <lb xml:id="p1z18"/>hunc quamprimum remitte; <lb xml:id="p1z20"/>nullus enim prorsus <lb xml:id="p1z21"/>apud nos illum legit.<pb type="edition" next="585"/></s>
				</p>
				<p>
					<s n="10" xml:lang="la">Tr<lb xml:id="p1z22"/>agica scribunt<note xml:id="fn7" type="footnote" n="7">Nicht ermittelt.</note> <placeName ref="l145">Esselingiacense<lb xml:id="p1z23"/>s</placeName> de <persName ref="p9708">duce Wirtemp[ergensi]</persName><note xml:id="fn8" type="footnote" n="8">Herzog <persName ref="p9708">Ulrich von Württemberg</persName>.</note>, <lb xml:id="p1z24"/>quod miseros <lb xml:id="p1z25"/>quosdam <persName ref="p21235">Acteones</persName><note xml:id="fn9" type="footnote" n="9">D.h. Jäger (nach dem Jäger <persName ref="p21235">Akteon oder Aktaion</persName> in der griech. Mythologie; vgl. Albert <hi>Schachter,</hi> in: <bibl source="b185">DNP</bibl> I 414).</note> <lb xml:id="p1z26"/>exocularit<note xml:id="fn10" type="footnote" n="10">Vgl. oben <ref target="file12083">Nr. 2036</ref> mit Anm. 13; 2044, 38-40.</note>.</s>
				</p>
				<p>
					<note type="address">[Adresse vor S. 102:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p4z1"/><persName ref="p495">Bullingero</persName> suo <placeName ref="l587">Tiguri</placeName>.</s>
					<s n="12" xml:lang="de">Maister <lb xml:id="p4z2"/><persName ref="p495">Hainrich Bullinger</persName> zuͦ <lb xml:id="p4z3"/><placeName ref="l587">Zuͤrich</placeName>.</s>
					<s n="13" xml:lang="de"><lb xml:id="p4z4"/><placeName ref="l587">Zuͤ<lb xml:id="p4z5"/>rich</placeName>.</s>
				</p>
			</div>
