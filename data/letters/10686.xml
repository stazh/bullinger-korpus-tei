	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus per Christum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Scis, qualem ministrum desyderet baro ille, qui <lb xml:id="p1z3"/>nuper apud vos fuit<note xml:id="fn1" type="footnote" n="1">Gemeint ist <persName ref="p7604">Balthasar von Kuenring</persName>, der kurz zuvor in <placeName ref="l257">Konstanz</placeName> und <placeName ref="l587">Zürich</placeName> einen geeigneten Prädikanten gesucht hatte; vgl. oben <ref target="file10670">Nr. 632</ref>, 2-5; 642, 30-37.</note>.</s>
					<s n="3" xml:lang="la">Si tu quem nosti, vellem, <lb xml:id="p1z4"/>illius mihi mores et ingenium cum nomine indicares; <lb xml:id="p1z5"/>nam e<note xml:id="fna" type="footnote" n="a">e <hi>übergeschrieben.</hi></note> <placeName ref="l157">Franckfordia</placeName> scripturus est ad me baro<note xml:id="fnb" type="footnote" n="b"><hi>nach</hi> baro <hi>gestrichenes</hi> d.</note><note xml:id="fn2" type="footnote" n="2">Ein solcher Brief ist nicht erhalten.</note>, <lb xml:id="p1z6"/>quid mihi sit faciendum.</s>
					<s n="4" xml:lang="de">Es ist neiswa<note xml:id="fn3" type="footnote" ana="lex" n="3">irgendwo (<bibl source="b590">SI</bibl> IV 809f).</note> einer <lb xml:id="p1z7"/>uss dem <placeName ref="l216">Hirzel</placeName> by <placeName ref="l222">Horgen</placeName><note xml:id="fn4" type="footnote" n="4">Der Name dieses von <placeName ref="l216">Hirzel</placeName> bei <placeName ref="l222">Horgen</placeName> (<placeName ref="l803">Kt. Zürich</placeName>) stammenden Prädikanten ließ sich bisher nicht feststellen.</note>, den kennend ir wol.</s>
					<s n="5" xml:lang="de"><lb xml:id="p1z8"/>Lassend mich<pb type="edition" next="363"/> wissen, was er für ain mensch sye; <lb xml:id="p1z9"/>dann der her were des wol wert, das er ainen <lb xml:id="p1z10"/>syttigen<note xml:id="fn5" type="footnote" ana="lex" n="5">wohlgesitteten (<bibl source="b590">SI</bibl> VII 1467f).</note>, verstendigen gsellen<note xml:id="fn6" type="footnote" n="6">jungen Mann, Pfarrhelfer (<bibl source="b260">Grimm</bibl> IV/I 2 4032; <bibl source="b590">SI</bibl> VIII 719).</note> hette.</s>
					<s n="6" xml:lang="de">Darum sind <lb xml:id="p1z11"/>mir hilfflich und raetlich<note xml:id="fn7" type="footnote" n="7">mit Rat behilflich (<bibl source="b590">SI</bibl> VI 1617). - Am 5. Oktober 1536 wandte sich <persName ref="p4079">Zwick</persName> erneut mit der Bitte um einen Prädikanten für <persName ref="p7604">Balthasar von Kuenring</persName> an <persName ref="p495">Bullinger</persName> (Zürich ZB, Ms F 62, 569).</note>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Novarum rerum nihil habeo, quam quod <persName ref="p2095">Philippus Melanthon</persName> denuo<note xml:id="fnc" type="footnote" n="c">denuo <hi>am Rande nachgetragen.</hi></note> <lb xml:id="p1z13"/>aedidit Locos suos communes<note xml:id="fn8" type="footnote" n="8"><persName ref="p2095">Melanchthon</persName>, Loci communes theologici recens collecti et recogniti, <placeName ref="l558">Wittenberg</placeName> 1535 (<bibl source="b441">MO</bibl> XXI 229-252. 331-560; vgl. <persName ref="p2095">Melanchthon</persName> BW. Regesten II 178-180. 198, <ref target="file11594">Nr. 1551</ref>. 1555. 1606f).</note>, in quibus rationem consilii <lb xml:id="p1z15"/>Gallo<note xml:id="fnd" type="footnote" n="d">Gallo <hi>korr. aus</hi> Galli.</note> dati accurate explicat<note xml:id="fn9" type="footnote" n="9">Dies ist höchstens in ganz allgemeinem Sinn zu verstehen; <persName ref="p2095">Melanchthon</persName> bezieht sich in den "Loci communes" nicht ausdrücklich auf sein umstrittenes Gutachten zur Einheit der Kirche (zu diesem vgl. oben <ref target="file10549">Nr. 513</ref>, Anm. 4).</note>.</s>
					<s n="8" xml:lang="la">Sic ad me scribit <persName ref="p1055">Frechtus</persName><note xml:id="fn10" type="footnote" n="10">Der Brief <persName ref="p1055">Martin Frechts</persName> ist nur in den folgenden Zitaten und in <persName ref="p4079">Zwicks</persName> Mitteilung an <persName ref="p8049">Vadian</persName> vom 16. September (<persName ref="p8049">Vadian</persName> BW V 250f) teilweise überliefert.</note> <lb xml:id="p1z16"/>additis nonnullis de <persName ref="p8441">Schwenckfeldio</persName> et <persName ref="p8350">Franco</persName>.</s>
					<s n="9" xml:lang="la">"<lb xml:id="p1z17"/><persName ref="p8441">Schwenckfeldius</persName>", inquit, "apud nos <placeName ref="l513">Ulmae</placeName> habet diversorium<note xml:id="fn11" type="footnote" n="11"><persName ref="p8441">Schwenckfeld</persName> kam demnach schon Ende August/Anfang September nach <placeName ref="l513">Ulm</placeName>, nicht erst kurz vor dem 26. September (so <bibl source="b169">CSch</bibl> V 402, Anm. 5). Hier wohnte er bei Bürgermeister <persName ref="p4285">Bernhard Besserer</persName>; vgl. unten <ref target="file10699">Nr. 661</ref>, 43-45.</note>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Pollicetur strenue se concordię leges<note xml:id="fn12" type="footnote" n="12">Gemeint ist die am 28. Mai 1535 zwischen <persName ref="p8055">Blarer</persName>, <persName ref="p467">Bucer</persName>, <persName ref="p1055">Frecht</persName> und <persName ref="p8441">Schwenckfeld</persName> geschlossene "<placeName ref="l512">Tübinger</placeName> Konkordie"; vgl. oben <ref target="file10660">Nr. 622</ref>, Anm. 31.</note> observaturum, sed <lb xml:id="p1z19"/>ego metuo, ne velut sub Aiacis<note xml:id="fn13" type="footnote" n="13">Aias der Telamonier, griechischer Held im <placeName ref="l2219">Trojanischen</placeName> Krieg, Träger eines mächtigen Schildes (<bibl source="b479">Pauly/Wissowa</bibl> I/1 930-936). Zur Redensart vgl. Quintillian, Institutio oratoria 8, 4, 24.</note> clypeo latens huius concordię <lb xml:id="p1z20"/>praetextu sua interim dogmata serat.</s>
					<s n="11" xml:lang="la">Pertinaciter <lb xml:id="p1z21"/>vero vult defendere naturam humanam<note xml:id="fne" type="footnote" n="e">humanam <hi>am Rande nachgetragen.</hi></note> in Christo prorsus <lb xml:id="p1z22"/>esse deificatam adeo, ut ipsa creaturae rationem exuerit<note xml:id="fn14" type="footnote" n="14">Zur Fortdauer des Streits um die Kreatürlichkeit Christi trotz der in <placeName ref="l512">Tübingen</placeName> erzielten Übereinkunft vgl. <bibl source="b169">CSch</bibl> VI 86f.</note>.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/><persName ref="p8350">Francus</persName>", inquit <persName ref="p1055">Frechtus</persName>, "senatus consultu iussus est omnia <lb xml:id="p1z24"/>sua perperam scripta publice vel declarare vel revocare<note xml:id="fnf" type="footnote" n="f"><hi>Die Vorsilbe</hi> re <hi>ist als nicht sicher lesbare Ligatur geschrieben.</hi></note><note xml:id="fn15" type="footnote" n="15"><persName ref="p8350">Sebastian Franck</persName> antwortete am 3. September mit einer ausführlichen Erklärung (vgl. unten <ref target="file10699">Nr. 661</ref>, 36-40) auf die von <persName ref="p1055">Frecht</persName> und den Schulpflegern auf Grund eines Ratsbeschlusses vom 16. Juni zusammengetragene und ihm am 20. Juli zugestellte Liste der anstößigen Stellen in seinen Schriften. Die Dokumente sind gedruckt bei: Alfred <hi>Hegler,</hi> Beiträge zur Geschichte der Mystik in der Reformationszeit. Aus dem Nachlasse hg. v. Walther Köhler. Berlin 1906. - ARG, Ergänzungsband I, S. 122-186; vgl. Eberhard <hi>Teufel,</hi> "Landräumig". Sebastian Franck, ein Wanderer an Donau, Rhein und Neckar, Neustadt an der Aisch 1954, S. 59-76.</note>.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z25"/>Habent isti suos applausores, praesertim <placeName ref="l18">Augustanos</placeName>, qui <lb xml:id="p1z26"/>huc pestis declinandę gratia agminatim convolaverunt."</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z27"/>Haec ex literis <persName ref="p1055">Frechti</persName> paucis.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb type="edition" next="364"/><pb type="scan" next="||14v."/><pb/><lb xml:id="p2z1"/>Quod adolescens tuus convaluit<note xml:id="fn16" type="footnote" n="16">Zur Erkrankung eines unbekannten Hausgenossen von <persName ref="p495">Bullinger</persName> vgl. oben <ref target="file10675">Nr. 637</ref>, 23-26.</note>, gratias ago domino, qui te <lb xml:id="p2z2"/>cumprimis servet incolumem.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z3"/>De <placeName ref="l441">Schafhusia</placeName> esto sollicitus; parum enim convenit <lb xml:id="p2z4"/>magistratui<note xml:id="fng" type="footnote" n="g"><hi>vor</hi> magistratui <hi>gestrichenes</hi> co.</note> cum ministris, irritantibus quibusdam, <lb xml:id="p2z5"/>ut aiunt, anabaptistis<note xml:id="fn17" type="footnote" n="17">Zu den Vorgängen in <placeName ref="l441">Schaffhausen</placeName> vgl. oben <ref target="file10672">Nr. 634</ref> und 644 sowie unten <ref target="file10687">Nr. 649</ref> und 681.</note>.</s>
					<s n="17" xml:lang="la">Certe succurrendum est <lb xml:id="p2z6"/>ecclesiis dissentionibus perituris.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="farewell"><lb xml:id="p2z7"/>Sed vale; plura enim non possum.</s>
					<s n="19" xml:lang="la"><persName ref="p8178">Thomas</persName><note xml:id="fn18" type="footnote" n="18"><persName ref="p8178">Thomas Blarer</persName>.</note> cum <lb xml:id="p2z9"/><persName ref="p4334">sorore</persName> sua<note xml:id="fn19" type="footnote" n="19"><persName ref="p4334">Margaretha Blarer</persName>.</note> et frater <persName ref="p4082">Cuͦnradus</persName><note xml:id="fn20" type="footnote" n="20"><persName ref="p4082">Konrad Zwick</persName>.</note> valere<note xml:id="fnh" type="footnote" n="h">valere <hi>über gestrichenem</hi> salvere.</note> te volunt <lb xml:id="p2z10"/>quam optime.</s>
				</p>
				<p>
					<s n="20" xml:lang="de">10. septembris 1535.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z11"/>Tuus <persName ref="p4079">Io. <lb xml:id="p2z12"/>Zwick</persName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="salute"><lb xml:id="p2z13"/><persName ref="p8171">Theodorum</persName><note xml:id="fn21" type="footnote" n="21"><persName ref="p8171">Theodor Bibliander</persName>.</note>, <lb xml:id="p2z14"/><persName ref="p1753">Leonem</persName><note xml:id="fn22" type="footnote" n="22"><persName ref="p1753">Leo Jud</persName>.</note>, <lb xml:id="p2z15"/>cumprimis <persName ref="p8127">Pellicanum</persName> salvere iubeo<lb xml:id="p2z16"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf f. 11a v.:]</note>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p4z1"/>Domino <persName ref="p495">Hainricho <lb xml:id="p4z2"/>Bullingero</persName>, antistiti <lb xml:id="p4z3"/><placeName ref="l587">Tigurino</placeName>, fratri <lb xml:id="p4z4"/>charissimo.</s>
				</p>
