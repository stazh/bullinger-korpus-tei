	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nondum recte revalui a carbunculo<note xml:id="fn1" type="footnote" n="1">Karbunkel (Karfunkel); vgl. <bibl source="b14">HBBW XI</bibl> <ref target="file11622">[Nr. 1579]</ref>, S. 339f, Anm. 17.</note> (ut mulieres vocant) et tamen concionari <lb xml:id="p1z2"/>et scribere et omnia facere cogor.</s>
					<s n="3" xml:lang="la">Audivi aliquoties <persName ref="p20531">Maguntinum</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p20531">Albrecht von Brandenburg</persName>, Erzbischof und Kurfürst von <placeName ref="l307">Mainz</placeName>.</note> valde <lb xml:id="p1z3"/>delectari lapillis preciosis et eos magni emere<note xml:id="fn3" type="footnote" n="3">Zur Prunkliebe des Kirchenfürsten, die sich vor allem im sog. "Halleschen Heiltumsschatz" manifestierte, s. Gerhard <hi>Händler,</hi> Fürstliche Mäzene und Sammler in Deutschland von 1500-1620, Straßburg 1933. - Studien zur Deutschen Kunstgeschichte 297, S. 29-33.</note>.</s>
					<s n="4" xml:lang="la">Obtuli et meum istum<note xml:id="fn4" type="footnote" n="4"><persName ref="p8418">Myconius</persName> bezieht sich ironisch auf seine Krankheit, den "Karfunkelstein".</note> gratis, sed <lb xml:id="p1z4"/>renuit.</s>
					<s n="5" xml:lang="la">Si potis essem, compellerem, ut a collo suspensum ferret perpetuo.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z5"/>Ille in causa est una cum <persName ref="p18604">Bavaro</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p18604">Wilhelm IV.</persName>, Herzog von <placeName ref="l619">Bayern</placeName>.</note>, ut religionis negocium<note xml:id="fna" type="footnote" n="a"><hi>Vor</hi> negocium <hi>ein gestrichenes Zeichen.</hi></note> in tractationem <lb xml:id="p1z6"/>venire non potuerit<note xml:id="fn6" type="footnote" n="6">Vielleicht hatte <persName ref="p8418">Myconius</persName> bereits Kenntnis von den umfangreichen Akten über die Verhandlungen des Reichstags zu <placeName ref="l471">Speyer</placeName>, die <placeName ref="l491">Straßburg</placeName> am 6. April nach <placeName ref="l28">Basel</placeName> übermittelt hatte (s. Basel StA, Fremde Staaten, Deutschland B 1). Zur schroffen Ablehnung der protestantischen Forderungen durch <persName ref="p20531">Albrecht von Brandenburg</persName> vgl. <hi>Heidrich,</hi> <persName ref="p18538">Karl V.</persName> 68. 76, Anm. 2.</note>.</s>
					<s n="7" xml:lang="la">Plęnus est consiliis pravis et eis pertinaciter utitur.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z7"/>Effecit, ut contra ius et veterem morem civitates a consultationibus sint communibus <lb xml:id="p1z8"/>hactenus exclusę, ut in comitiis nihil sit actum nisi de colligenda pecuni<lb xml:id="p1z9"/>a in bellum <placeName ref="l2510">Turcicum</placeName>, et conatus est de iudicio communi, de pace, de moneta r<lb xml:id="p1z10"/>eliquisque rebus politicis consultationem reiicere in comitia ad augustum promissa<note xml:id="fn7" type="footnote" n="7">Bereits Mitte März war von einem weiteren Reichstag die Rede, der am 1. August in <placeName ref="l361">Nürnberg</placeName> oder <placeName ref="l410">Regensburg</placeName> zusammentreten sollte; s. <bibl source="b480">PC</bibl> III 242.</note>.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z11"/>Quid fiat, nescio; conclusum enim an quid sit, nondum novi<note xml:id="fn8" type="footnote" n="8">Zum Ergebnis des Reichstags vgl. unten <ref target="file11663">Nr. 1620</ref>, 13-18 mit Anm. 4.</note>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z12"/>Sed audi consilium de pecunia: Decimę debent imponi omnibus.</s>
					<s n="11" xml:lang="la">Eas receperunt <lb xml:id="p1z13"/>se daturos principes, comites, nobiles, sed de reditibus, non de omnibus bonis.</s>
					<s n="12" xml:lang="la">C<lb xml:id="p1z14"/>ivitates de bonis omnibus, etiamsi carent reditibus, dare urgentur, mercatores <lb xml:id="p1z15"/>decimas duplices.</s>
					<s n="13" xml:lang="la">Vide tyrannidem, quę causam habet evangelium et libertatem, <lb xml:id="p1z16"/>item et opulentiam civitatum et mercatorum<note xml:id="fn9" type="footnote" n="9">Einen Überblick über die Auseinandersetzungen um die Mitbestimmung und steuerliche Veranlagung der Städte gibt RTA JR XII/1 67f.</note>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Non mirum, si nova <lb xml:id="p1z17"/>aliqua foederatio fieret contra civitatum tam graves obpressores<note xml:id="fn10" type="footnote" n="10">Eine gegen die Fürsten gerichtete engere Verbindung der evangelischen und katholischen Städte wurde tatsächlich erwogen, kam aber nicht zustande; vgl. <hi>Heidrich,</hi> <persName ref="p18538">Karl V.</persName> 69f. 73.</note>.</s>
					<s n="15" xml:lang="la">Verum sic <lb xml:id="p1z18"/>apud te loquor.</s>
					<s n="16" xml:lang="la">Hactenus civitates repugnarunt; quid vero fecerint de<lb xml:id="p1z19"/>inceps aut facturę sint, incertum mihi adhuc.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z20"/>Uxorem praeterea <persName ref="p20318">Heinrichi Brunswigensis</persName> nosti esse sororem <persName ref="p9708">Wirtenbergensis</persName><note xml:id="fn11" type="footnote" ana="bio" n="11"><persName ref="p20792">Marie von Württemberg</persName>, die Schwester <persName ref="p9708">Herzog Ulrichs</persName>, war seit 1515 mit <persName ref="p20318">Herzog Heinrich von Braunschweig</persName> verheiratet; s. [Ferdinand] <hi>Spehr,</hi> Art. Heinrich der Jüngere, Herzog von Braunschweig-Wolfenbüttel, in: <bibl source="b60">ADB</bibl> XI 499.</note>.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z21"/>Hic in more habuit singulis annis<note xml:id="fnb" type="footnote" n="b">annis <hi>am Rande nachgetragen.</hi></note> invisere illam circa nativitatem<pb type="edition" next="68"/> domini cum <lb xml:id="p1z22"/>munere per se vel honestos viros aliquos.</s>
					<s n="19" xml:lang="la">Idem fecit anno proximo; misit <lb xml:id="p1z23"/>legatos et una mille aureos.</s>
					<s n="20" xml:lang="la">Postquam venerunt, a sorore prohibuerunt <lb xml:id="p1z24"/>conantes interim tamen pecuniam emungere <persName ref="p20318">Brunswigenses</persName>, sed frustra.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z25"/>Sed antequam pecuniam e manibus vellent dimittere, admiserunt legatos.</s>
					<s n="22" xml:lang="la">Hi <lb xml:id="p1z26"/>peractis, quę in mandatis habuerant, discesserunt.</s>
					<s n="23" xml:lang="la">Non autem multo postea <lb xml:id="p1z27"/>venit nuncium ducissam vita defunctam<note xml:id="fn12" type="footnote" n="12">Am 28. Dezember, s. <hi>Spehr,</hi> in: <bibl source="b60">ADB</bibl> XI 499.</note>, ducem filio ducatum omnem re<lb xml:id="p1z28"/>scripsisse<note xml:id="fn13" type="footnote" ana="bio" n="13">Das Gerücht bezog sich wohl auf den ältesten Sohn Heinrichs, <persName ref="p18720">Karl Viktor</persName> (geb. 1525).</note> et ipsum cum paucis abiisse, nescitur quo.</s>
					<s n="24" xml:lang="la">Sic pro certo mihi dictum <lb xml:id="p1z29"/>est a viris nobilibus.</s>
					<s n="25" xml:lang="la">An ad <persName ref="p18593">Turcam</persName><note xml:id="fn14" type="footnote" n="14">Sultan <persName ref="p18593">Suleiman I.</persName></note> abierit, an ad <persName ref="p19981">papam</persName><note xml:id="fn15" type="footnote" n="15">Papst <persName ref="p19981">Paul III.</persName></note> an alio, ut pravis <lb xml:id="p1z30"/>iterum consiliis turbationes novas cudat, omnes dubitant.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p1z31"/>Ad hęc legatus noster, qui e <placeName ref="l832">Gallia</placeName> his diebus pacificationis pecuniam portavit<note xml:id="fn16" type="footnote" n="16">Zur Entgegennahme der jährlichen Pension aufgrund des Ewigen Friedens von 1516 (vgl. Walter <hi>Schaufelberger,</hi> Spätmittelalter, in: Handbuch der Schweizer Geschichte, Bd. I, Zürich 1972, S. 358) war als Abgeordneter <placeName ref="l28">Basels</placeName> <persName ref="p5995">Christoph Offenburg</persName> nach <placeName ref="l301">Lyon</placeName> geritten; s. Basel StA, Finanz G 16, 554.</note>, <lb xml:id="p1z32"/>adeo narrat crudelia de <placeName ref="l832">Gallorum</placeName> vestitu et moribus <placeName ref="l2510">Turcarum</placeName> similibus, ut <lb xml:id="p1z33"/>dicere possis in <placeName ref="l2510">Turcas</placeName> degenerasse<note xml:id="fn17" type="footnote" n="17">Vgl. auch den Bericht <placeName ref="l28">Basels</placeName> an Straßburg vom 10. April 1542 (<bibl source="b480">PC</bibl> III 265f).</note>.</s>
					<s n="27" xml:lang="la">Verum hęc eadem ex tuis nimirum <lb xml:id="p1z34"/>ipse quoque intellexisti<note xml:id="fn18" type="footnote" n="18"><persName ref="p8436">Andreas Schmid</persName>, der den <placeName ref="l587">Zürcher</placeName> Anteil des "Friedgeldes" abgeholt hatte, kehrte am 12. April oder kurz vorher zurück; s. Zürich StA, F III 32, 1541[-42], "Usgeben", S. 48.</note>.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p1z35"/><persName ref="p467">Bucerus</persName> de <persName ref="p8462">Coloniensi</persName><note xml:id="fn19" type="footnote" n="19">Erzbischof <persName ref="p8462">Hermann von Wied</persName>.</note> scribit in hęc verba<note xml:id="fn20" type="footnote" n="20"><persName ref="p467">Bucer</persName> an <persName ref="p8418">Myconius</persName>, 23. März 1542 (Zürich ZB, Ms F 80, 150).</note>: „Senex totus noster est; sed nosti, <lb xml:id="p1z36"/>quantum et quibus talium principum potestas obnoxia est.“</s>
					<s n="29" xml:lang="la">Reliqua dicit <lb xml:id="p1z37"/>non esse literis committenda.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><lb xml:id="p1z38"/>Circumferuntur literę, quas vidisti forsitan, impressę<note xml:id="fn21" type="footnote" n="21">Gemeint ist sicher die Flugschrift "Absagung des <placeName ref="l2510">Türckischen</placeName> Keysers, den König von <placeName ref="l2472">Polen</placeName> belangende" (s.l. 1542; s. Carl Göllner, Turcica. Die europäischen Türkendrucke des XVI. Jahrhunderts, Bd. I, Bukarest-Berlin 1961, <ref target="file10799">Nr. 761</ref>; <bibl source="https://gateway-bayern.de/VD16+T+2192">VD 16 T 2192)</bibl>.</note>, quibus indicitur bellum a <persName ref="p18593">Turca</persName> <lb xml:id="p1z39"/><persName ref="p18589">Polono</persName><note xml:id="fn22" type="footnote" n="22">König <persName ref="p18589">Sigismund I.</persName> von <placeName ref="l2472">Polen</placeName>.</note>.</s>
					<s n="31" xml:lang="la">Bone deus, quę illic crudelitas, quę blasphemię in Christum!</s>
					<s n="32" xml:lang="la">Equidem <lb xml:id="p1z40"/>dico in domino <placeName ref="l2510">Turcam</placeName> me nunquam timuisse, sed peccata nostra, quę in dies au<lb xml:id="p1z41"/>gentur.</s>
					<s n="33" xml:lang="la">Nunc, id est post blasphemias tam crudeles, multo minus timeo; no<lb xml:id="p1z42"/>vi etenim, qualisnam deus ad blasphemias.</s>
				</p>
				<p>
					<s n="34" xml:lang="la">Vide tempora, in quę dominus nos <lb xml:id="p1z43"/>posuit!</s>
					<s n="35" xml:lang="la">Tuebitur is, scio, ecclesiam suam.</s>
					<s n="36" xml:lang="la">Communicabis hęc cum <persName ref="p8171">Theodoro</persName><note xml:id="fn23" type="footnote" n="23"><persName ref="p8171">Theodor Bibliander</persName>.</note> et <persName ref="p8127">Pellicano</persName>.</s>
				</p>
				<p>
					<s n="37" xml:lang="la" ana="farewell"><lb xml:id="p1z44"/>Vale cum tuis in Christo.</s>
				</p>
				<p>
					<s n="38" xml:lang="la"><placeName ref="l28">Basileę</placeName>, 10. aprilis anno 1542.</s>
				</p>
				<p>
					<s n="39" xml:lang="la"><persName ref="p8418">Os. <lb xml:id="p1z45"/>Myconius</persName> tuus.<pb type="edition" next="69"/></s>
				</p>
				<p>
					<s n="40" xml:lang="la">Mitto simul literas <placeName ref="l339">Neocomensium</placeName> fratrum<note xml:id="fn24" type="footnote" n="24">Oben <ref target="file11652">Nr. 1609</ref>.</note>.</s>
					<s n="41" xml:lang="la">Gratiarum actionem <lb xml:id="p1z46"/>esse puto, nam et nobis scripserunt similiter<note xml:id="fn25" type="footnote" n="25">Ein entsprechendes Schreiben liegt nicht vor.</note>.</s>
					<s n="42" xml:lang="la">Fac, <lb xml:id="p1z48"/>commendatos habeas, ubi fuerit opus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="43" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho Bullin<lb xml:id="p2z2"/>gero</persName>, ministro Christi <lb xml:id="p2z3"/>optimo, fratri in domino charissi<lb xml:id="p2z4"/>mo suo.</s>
				</p>
			</div>
		</body>
