	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p714">Coelius Secundus Curio</persName> s[alutem] p[lurimam] d[icit] per Christum Iesum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Quamquam tua erga me humanitas seu pietas potius tanta fuit<note xml:id="fna" type="footnote" n="a">fuit <hi>über gestrichenem</hi> sit.</note>, ut bene longa <lb xml:id="p1z3"/>epistola tibi gratiae agendę forent, his tamen literis nihil amplius ad <lb xml:id="p1z4"/>scribendum sumam, quam quod nobis amicorum caussa curandum erat.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Alias <lb xml:id="p1z6"/>vero etiam referendi gratiam fortassis facultas suppetet, nedum gratias<note xml:id="fnb" type="footnote" n="b">gratias <hi>über der Zeile eingefügt.</hi></note> agendi.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Meministi, credo, cum essemus apud te,<note xml:id="fn1" type="footnote" n="1"><persName ref="p714">Curione</persName> bezieht sich wohl auf seinen Aufenthalt in <placeName ref="l587">Zürich</placeName> im November, vgl. <ref target="file11737">Nr. 1692</ref>.</note> me tibi narrasse de quodam amico<note xml:id="fn2" type="footnote" n="2">Unbekannt.</note>, <lb xml:id="p1z8"/>qui fratrem suum <placeName ref="l587">Tigurum</placeName> mittere vellet cum discendae <placeName ref="l822">Germanicae</placeName> lingu<lb xml:id="p1z9"/>ae tum aliarum bonarum rerum gratia.</s>
					<s n="5" xml:lang="la">Sed nescio quae negotia nos <lb xml:id="p1z11"/>ab ea cura ad se transtulerunt, ita ut nihil de ea re certi<note xml:id="fnc" type="footnote" n="c">certi <hi>über der Zeile eingefügt.</hi></note> inter nos <lb xml:id="p1z12"/>constitutum sit.</s>
					<s n="6" xml:lang="la">Nunc, quod omissum fuit, sarcire paro.</s>
					<s n="7" xml:lang="la">Igitur rogo, <lb xml:id="p1z13"/>ut aliquem seligere<note xml:id="fn3" type="footnote" n="3">Zu ergänzen ist "velis" o. ä.</note> bonum et doctum virum, dein etiam mercatorem aut <lb xml:id="p1z14"/>negotiorum plenum, apud quem is adolescens agat, et cum utroque de precio <lb xml:id="p1z15"/>et conditione convenire.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Quod ubi feceris meo nomine, si placet, ad <lb xml:id="p1z16"/>d. <persName ref="p18226">Martinum a Pergula</persName><note xml:id="fn4" type="footnote" n="4">Der Rechtsanwalt Dr. <persName ref="p18226">Martin a Pergula (della Pergola)</persName> in <placeName ref="l505">Tirano</placeName> (<placeName ref="l3762">Prov. Sondrio</placeName>, <placeName ref="l834">Italien</placeName>) war eine wichtige Schaltstelle für <persName ref="p495">Bullingers</persName> Briefverkehr mit den <placeName ref="l648">Bündner</placeName> Südtälern, vgl. <placeName ref="l648">Graubünden</placeName>, Korr. II 415. 419. 421-423; III 184f.</note> iurisconsultum <placeName ref="l505">Tiranum</placeName> literas mittes, quae de toto <lb xml:id="p1z17"/>eo negotio eum certiorem faciant.</s>
					<s n="9" xml:lang="la">Occurrent certe, qui literas ferant; <lb xml:id="p1z18"/>sin minus, <placeName ref="l98">Curiam</placeName> ad d. <persName ref="p654">Io[annem] Comandrum</persName> aut <persName ref="p396">Blasium</persName>, ministros, eas mittere <lb xml:id="p1z19"/>poteris additis ad horum alterum, ut <placeName ref="l505">Tirani</placeName> in <placeName ref="l520">Valle Telina</placeName><note xml:id="fn5" type="footnote" n="5"><placeName ref="l520">Veltlin</placeName>.</note> reddendas <lb xml:id="p1z20"/>curent, quatuor verbis<note xml:id="fn6" type="footnote" n="6">Ob <persName ref="p495">Bullinger</persName> entsprechende Schritte unternahm, ist nicht bekannt.</note>.</s>
					<s n="10" xml:lang="la">Hanc rem te omnino curare sedulo opus est, <lb xml:id="p1z21"/>ni meam fidem in discrimen et meipsum in infamiam adduci velis, qui haec ipsa <lb xml:id="p1z22"/>praestare sum pollicitus, quae tamen obrutus negotiis, curis<note xml:id="fnd" type="footnote" n="d"><hi>Vor</hi> curis <hi>gestrichenes</hi> et.</note> et molestiis innu<lb xml:id="p1z23"/>meris non praestiti.</s>
					<s n="11" xml:lang="la">Quod ut<note xml:id="fne" type="footnote" n="e"><hi>Vor</hi> ut <hi>gestrichenes</hi> un[?].</note> huic<note xml:id="fnf" type="footnote" n="f">huic <hi>über der Zeile eingefügt.</hi></note> meae negligentiae (ut etiam me ipsum ingenue <lb xml:id="p1z24"/>accusem) tuae opera, studio et diligentia succurras, te etiam atque etiam rogo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z25"/>Caeterum ad <persName ref="p2807">Camilum</persName><note xml:id="fn7" type="footnote" n="7">Gemeint ist <persName ref="p2807">Camillo Renato</persName>, vgl. <persName ref="p714">Curione</persName> an <persName ref="p495">Bullinger</persName>, [4. März 1543], Zürich StA, E II 366, 88.</note> quoque, cuius tibi<note xml:id="fng" type="footnote" n="g"><hi>Vor</hi> tibi <hi>gestrichenes</hi> a.</note> literas<note xml:id="fn8" type="footnote" n="8">Oben <ref target="file11733">Nr. 1688</ref>.</note> redidi, rescribere eadem opera <lb xml:id="p1z26"/>aliquid poteris.</s>
					<s n="13" xml:lang="la">Hic enim <placeName ref="l505">Tirani</placeName> agit, et facile d. <persName ref="p18226">Martinus</persName> ei literas <lb xml:id="p1z27"/>tuas reddet.</s>
					<s n="14" xml:lang="la">Solaberis enim virum et literis et religione pręstantem et tui <lb xml:id="p1z28"/>praesertim amantissimum.</s>
					<s n="15" xml:lang="la">Quae scripsi, quo celerius fient, eo gratiora erunt.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z29"/>Ipse scripsissem, si certi aliquid scribere possem; sed cum non possim, ipse conficies <lb xml:id="p1z30"/>et nos apud d. <persName ref="p18226">Martinum</persName> excusabis.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Vale per Christum Iesum et nostro nomine <lb xml:id="p1z31"/>eximios doctores <persName ref="p8127">Pellicanum</persName>, <persName ref="p8412">Megandrum</persName>, <persName ref="p8171">Bibliandrum</persName>, <persName ref="p8011">Gvalterum</persName> et reliquos <lb xml:id="p1z32"/>salvere iubebis.</s>
					<s n="18" xml:lang="la" ana="salute"><persName ref="p8051">Uxorem</persName><pb type="edition" next="271"/> tuam<note xml:id="fn9" type="footnote" ana="bio" n="9"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> officii et caritatis plenam meo et <persName ref="p4597">uxoris</persName> meae<note xml:id="fn10" type="footnote" n="10"><persName ref="p4597">Margarita Bianca Isacchi</persName>.</note> <lb xml:id="p1z33"/>nomine officiose diligenterque, adde etiam amanter salutabis, liberos<note xml:id="fn11" type="footnote" n="11">Zu <persName ref="p495">Bullingers</persName> Kindern s. oben <ref target="file11701">Nr. 1658</ref>, Anm. 27.</note> dulcissimos de sua <lb xml:id="p1z34"/>erga nostros suavitate, gratia et officiis amabis<note xml:id="fnh" type="footnote" n="h"><hi>Vor</hi> amabis <hi>gestrichenes Wort.</hi></note>.</s>
					<s n="19" xml:lang="la">Ego meipsum tibi <lb xml:id="p1z35"/>et tuis dedo, qui, quicquid sum, debeo.</s>
					<s n="20" xml:lang="la" ana="farewell">Vale et salve.</s>
					<s n="21" xml:lang="la" ana="salute">Salutant vos fratres <lb xml:id="p1z36"/>et ministri, qui nobiscum sunt, praecipue <persName ref="p3429">Viretus</persName> et <persName ref="p8031">Comes</persName><note xml:id="fn12" type="footnote" n="12"><persName ref="p8031">Béat Comte</persName>.</note>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><placeName ref="l280">Lausannae</placeName>, <lb xml:id="p1z37"/>quarto idus decembris 1542.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z38"/>Una cum tuis hasce quoque his annexas <lb xml:id="p1z39"/>ad d.<note xml:id="fni" type="footnote" n="i">d. <hi>über der Zeile eingefügt.</hi></note> <persName ref="p2807">Camilum</persName> aut ad d. <persName ref="p18226">Martinum</persName> cum<note xml:id="fnk" type="footnote" n="k">cum <hi>über der Zeile eingefügt.</hi></note> tuis <lb xml:id="p1z40"/>adligabis diligenter et mihi ignosces, <lb xml:id="p1z41"/>qui tot et tanta tibi onera imponam.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="24" xml:lang="la">D. <pb/><lb xml:id="p2z1"/><persName ref="p495">Henrico Bulingero</persName>, ecclesiae <lb xml:id="p2z2"/><placeName ref="l587">Tigurinae</placeName> antistiti, fratri <lb xml:id="p2z3"/>in Christo venerando.</s>
					<s n="25" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
