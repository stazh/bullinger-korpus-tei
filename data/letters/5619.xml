	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z3"/>Vir clarissime.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Illustrissimus <placeName ref="l2562">Prussiae</placeName> dux, dominus meus clemen<lb xml:id="p1z4"/>tissimus (sequor enim usitatum dicendi morem), <lb xml:id="p1z5"/>commendavit mihi de meliore nota eum virum, <lb xml:id="p1z6"/>qui has litteras perferet; pro quo cum hic fecerim, <lb xml:id="p1z7"/>quantum licuit, faciam quoque apud te, <lb xml:id="p1z8"/>quantum potero.</s>
					<s n="3" xml:lang="la">Commendo eum tibi, quantum <lb xml:id="p1z9"/>possum maxime, ut eum scilicet tua consueta <lb xml:id="p1z10"/>humanitate suscipias remittasque nobis incolumem, <lb xml:id="p1z11"/>ut possim ego hinc ad illustrissimum <placeName ref="l2562">Prussiae</placeName> princip<lb xml:id="p1z12"/>em statim remittere, ac non<note type="misc">wiederholt.</note> dubito, quin <lb xml:id="p1z13"/>eius celsitudo sit tibi eo nomine gratias habitura.</s>
					<s n="4" xml:lang="la">"<lb xml:id="p1z14"/>Da pacem, domine, in diebus nostris", quod rogo.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>De toto meo statu <persName>Weigelius</persName> coram pluribus; nihil <lb xml:id="p1z16"/>addam amplius.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale et salve cum tota ecclesia, <lb xml:id="p1z17"/>schola atque familia, nosti meum hunc <lb xml:id="p1z18"/>fuisse morem.</s>
					<s n="7" xml:lang="la">Pater coelestis augeat omnibus <lb xml:id="p1z19"/>suos divinos thesauros, spiritum et fidem <lb xml:id="p1z20"/>per Christum dominum nostrum.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z21"/><placeName ref="l512">Tubingae</placeName> 20. <lb xml:id="p1z22"/>februarii 1563.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z23"/><persName ref="p3375">Vergerius</persName> tuus.</s>
				</p>
				<p>
					<note>[nicht v.V.]</note>
					<s n="10" xml:lang="la">[<pb/><lb xml:id="p2z1"/>C]larissimo viro domino <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, fratri honorando.</s>
					<s n="11" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note type="author">[Darunter von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="12" xml:lang="la"><lb xml:id="p2z3"/>Commendatitiae <persName>Weigelio</persName> <lb xml:id="p2z4"/>datae a <persName ref="p3375">Vergerio</persName>, <lb xml:id="p2z6"/>mense februario 1563.</s>
				</p>
			</div>
		</body>
	</text>
