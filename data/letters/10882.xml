	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><persName ref="p1888">Lavaterus</persName>, vir optimus, <lb xml:id="p1z2"/>in senatum allectus est<note xml:id="fn1" type="footnote" n="1">Zur Wahl <persName ref="p1888">Hans Rudolf Lavaters</persName> in den Kleinen Rat s. <bibl source="b620">Stucki</bibl> 153-155.</note>.</s>
					<s n="3" xml:lang="la">Idem vero religioni et iustitiae <lb xml:id="p1z3"/>publicę favet egregie.</s>
					<s n="4" xml:lang="la">Deinde vir est magnanimus, <lb xml:id="p1z4"/>opulentus, fortis, constans et eloquens; unde boni viri <lb xml:id="p1z5"/>non mediocriter laetantur ob vocationem eius.</s>
					<s n="5" xml:lang="la">Tu hoc <persName ref="p8129">consuli</persName><note xml:id="fn2" type="footnote" n="2">Gemeint ist wahrscheinlich <persName ref="p8129">Jakob Meyer</persName> (vgl. <bibl source="b620">Stucki</bibl> 154f; amtierender Bürgermeister war zu diesem Zeitpunkt allerdings <persName ref="p2271">Adelberg Meyer</persName>.</note> <lb xml:id="p1z6"/>significabis, orabitisque dominum, ut dona sua in eo homine <lb xml:id="p1z7"/>augeat et confirmet.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Ad ea, quae scripsisti de <placeName ref="l791">Valesiis</placeName><note xml:id="fn3" type="footnote" n="3">Oben <ref target="file10881">Nr. 842</ref>, 28-40.</note>, obstupui, quanquam ab initio <lb xml:id="p1z9"/>perfidiam et imposturam timui.</s>
					<s n="7" xml:lang="la">Itaque <placeName ref="l41">Bernates</placeName> ab <lb xml:id="p1z10"/>istis nunc deserti sunt, quibus tamen, ut audio, confisi sunt <lb xml:id="p1z11"/>plurimum<note xml:id="fn4" type="footnote" n="4">Vgl. oben <ref target="file10782">Nr. 744</ref>, 63-82; 750, 12-15; 752, 35f.</note>.</s>
					<s n="8" xml:lang="la">Ita propediem damnum a <persName ref="p20225">Gallo</persName><note xml:id="fn5" type="footnote" n="5">König <persName ref="p20225">Franz I.</persName></note> accipient <lb xml:id="p1z12"/>maximum.</s>
					<s n="9" xml:lang="la">Nunquam enim impiorum societas bonis bene <lb xml:id="p1z13"/>cessit<note xml:id="fn6" type="footnote" n="6">Vgl. oben <ref target="file10880">Nr. 841</ref>, 27f.</note>.</s>
					<s n="10" xml:lang="la">Et nos quotidie experimur, quid nobis impia <lb xml:id="p1z14"/>incomodent foedera.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z15"/>De conventu<note xml:id="fn7" type="footnote" n="7">Vgl. oben <ref target="file10881">Nr. 842</ref>, 17-25.</note> ne verbum quidem habeo.</s>
					<s n="12" xml:lang="la">Quid sperare <lb xml:id="p1z16"/>debeam, nescio.</s>
					<s n="13" xml:lang="la">Hoc certum autem apud me est, veritatem <lb xml:id="p1z17"/>perpetuo superaturam.</s>
					<s n="14" xml:lang="la">Neque ego tanti fecero istorum <lb xml:id="p1z18"/>conscriptionem, si veritati repugnans statuerint.</s>
					<s n="15" xml:lang="la">Igitur <lb xml:id="p1z19"/>pacato apud me sum animo, quod istud attinet <lb xml:id="p1z20"/>negotium.</s>
					<s n="16" xml:lang="la">Interim doleo propter quorundam impu<lb xml:id="p1z21"/>dentiam et male feriata negotia.</s>
					<s n="17" xml:lang="de">Es wirt der kampff <lb xml:id="p1z22"/>wären biß inn das end.</s>
					<s n="18" xml:lang="la">Cribrabimur<note xml:id="fn8" type="footnote" n="8">Vgl. <cit type="bible"><ref>Lk 22,31</ref></cit>.</note>, per ignem explorabit <lb xml:id="p1z23"/>nos dominus<note xml:id="fn9" type="footnote" n="9">Vgl. <cit type="bible"><ref>Sach 13,9</ref></cit>.</note>.</s>
					<s n="19" xml:lang="la">Beati, qui perseverant in finem usque<note xml:id="fn10" type="footnote" n="10">Vgl. <cit type="bible"><ref>Mt 10, 22</ref></cit>; <cit type="bible"><ref>24, 13.</ref></cit></note>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z24"/>De bello si quid habes, scribe.</s>
					<s n="21" xml:lang="la"><persName ref="p8049">Vadianus</persName> a <placeName ref="l473">Sangallo</placeName> <lb xml:id="p1z25"/>scribit<note xml:id="fn11" type="footnote" n="11"><persName ref="p8049">Vadians</persName> Brief ist nicht erhalten.</note> <placeName ref="l2510">Turcam</placeName> certo equitatu magno ingressum <lb xml:id="p1z26"/><placeName ref="l882">Hungariam</placeName>, aciem dirigere in <placeName ref="l850">Austriam</placeName><note xml:id="fn12" type="footnote" n="12">Zum Gerücht über einen gegen <placeName ref="l882">Ungarn</placeName> gerichteten Angriffsplan des Sultans <persName ref="p18593">Suleiman I.</persName> und zu den Übergriffen des Paschas von <placeName ref="l1589">Belgrad</placeName>, die besonders <placeName ref="l2798">Slawonien</placeName> betrafen, vgl. <persName ref="p18722">Erasmus</persName>, Corr. XI 325, 34; Nuntiaturberichte aus <placeName ref="l822">Deutschland</placeName> 1533-1559, Bd. I, Nuntiaturen des Vergerio 1533-1536, bearb. v. Walter Friedensburg, Gotha 1892, S. 574,29-575,4.</note>.</s>
					<s n="22" xml:lang="la">Haec <lb xml:id="p1z27"/>videlicet illa christiani regis consilia sunt<note xml:id="fn13" type="footnote" n="13">Zu <persName ref="p495">Bullingers</persName> Kritik an der Türkenpolitik König <persName ref="p20225">Franz' I.</persName> vgl. oben <ref target="file10880">Nr. 841</ref>, 23.</note>.</s>
					<s n="23" xml:lang="la">Quid <lb xml:id="p1z28"/>vero multis opus?</s>
					<s n="24" xml:lang="la">Domini gladius Imminet cer<lb xml:id="p1z29"/>vicibus nostris.</s>
					<s n="25" xml:lang="la">Dominus misereatur nostri.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p1z30"/>Venit ad vos <persName ref="p1214">Frisius</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p1214">Johannes Fries</persName>.</note> noster nobis longe charissimus.</s>
					<s n="27" xml:lang="la">Hunc no<lb xml:id="p1z31"/>s<note xml:id="fna" type="footnote" n="a">nos <hi>über gestrichenem</hi> ego.</note> tibi et <persName ref="p1365">Gryneo</persName> ceu fidelissimis patribus charis<lb xml:id="p1z32"/>simum Commendamus filium.</s>
					<s n="28" xml:lang="la">Obsecramus vos, ut hunc ceu <lb xml:id="p1z33"/>viscera nostra complectamini.</s>
					<s n="29" xml:lang="la">Vir est doctus, Pius <lb xml:id="p1z34"/>et probus.</s>
					<s n="30" xml:lang="la">Quicquid offitii in hunc contuleritis, in hominem <lb xml:id="p1z35"/>dignissimum contuleritis, et nos, quantum in nobis est, vestris respondebimus <lb xml:id="p1z36"/>benefitiis.</s>
					<s n="31" xml:lang="la">Acceptum ergo duces ad <persName ref="p1365">Grynaeum</persName> oreque <lb xml:id="p1z37"/>proprio hunc commendabis et literis hisce nostris.</s>
					<s n="32" xml:lang="la">Id, dum viv<lb xml:id="p1z38"/>am, agnoscam.</s>
				</p>
				<p>
					<s n="33" xml:lang="la" ana="farewell"><pb type="edition" next="330"/>Vale, <persName ref="p8418">Myconi</persName>, amicorum charissime, et frequ<lb xml:id="p1z39"/>entius scribe.</s>
				</p>
				<p>
					<s n="34" xml:lang="la">12. i<lb xml:id="p1z40"/>unii 1536.</s>
				</p>
				<p>
					<s n="35" xml:lang="la"><lb xml:id="p1z41"/><persName ref="p495">H. Bullinger<pb/><lb xml:id="p2z1"/>us</persName> <lb xml:id="p2z2"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="36" xml:lang="la"><lb xml:id="p2z3"/>Praestantissimo viro d. <persName ref="p8418">Osvaldo <lb xml:id="p2z4"/>Myconio</persName>, celeberrimae urbis <lb xml:id="p2z5"/><placeName ref="l28">Basileae</placeName> episcopo, suo in domino charissimo <lb xml:id="p2z6"/>fratri.</s>
				</p>
			</div>
