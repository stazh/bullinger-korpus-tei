	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Accepi iis diebus dissidium esse inter episcopos <lb xml:id="p1z2"/><placeName ref="l1107">Tridentinos</placeName>; <placeName ref="l822">Germani</placeName> urgent Interim illud <persName>Cęsareanum</persName>, <placeName ref="l834">Itali</placeName> cum <lb xml:id="p1z3"/><placeName ref="l875">Hispanis</placeName> nolunt in illud consentire.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><persName>Caesar</persName> se interposuit; quid <lb xml:id="p1z4"/>autem futurum sit ex ista contentione, dominus novit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/><persName>Mauritianus</persName> exercitus <placeName ref="l335">Milhusię</placeName> est in <placeName>Misnia</placeName>; civitatem illa<lb xml:id="p1z6"/>m militibus spoliendam dedit.</s>
					<s n="5" xml:lang="de">Es ist nünt denn ein pfaffenstatt.</s>
					<s n="6" xml:lang="la">Noluerun<lb xml:id="p1z7"/>t commeatum dare militibus et ea industria omnia perdiderunt.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/>Nescitur, quo exercitus iste ad futurum ver evolaturus sit.</s>
					<s n="8" xml:lang="la">Quidam <lb xml:id="p1z9"/>putant <persName>Catto</persName> adhęsurus, quo liberet parentem, quum delectum habeat <lb xml:id="p1z10"/>militum sua in ditione; quidam <placeName>Gallicas</placeName> partes defensurum aestimant <lb xml:id="p1z11"/><persName ref="p18250">Mauritium</persName>, quidam <placeName>Turcicis</placeName> incursionibus obiecturum <persName ref="p18477">Ferdi<lb xml:id="p1z12"/>nandum</persName> regem hunc exercitum.</s>
					<s n="9" xml:lang="la">Verum timeo imminens malum.</s>
					<s n="10" xml:lang="la">Quid <lb xml:id="p1z13"/>si nobis incommodarent?</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p20531">Episcopus Moguntinus</persName> conscripserat militem, sed dimisit illum altera die.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z15"/><persName ref="p18250">Mauritianis</persName> datam esse pecuniam.</s>
					<s n="13" xml:lang="la">Aurea habet idola, quę <lb xml:id="p1z16"/>ipsum commodissime liberare possunt ab istis hostibus, qui aurum <lb xml:id="p1z17"/>quęrunt et ecclesiarum devastationem et praeterea nihil.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z18"/><placeName ref="l157">Francofordienses</placeName> tres solummodo portas apertas habent et vigilan<lb xml:id="p1z19"/>t strenue, ne aliquid damni ab hostibus, quos adhuc ig<lb xml:id="p1z20"/>norant, accipiant.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z21"/>Guͦttschick nebulo decollatus est.</s>
					<s n="16" xml:lang="la">Hostis <persName>Gallicorum</persName> militum et d. <lb xml:id="p1z22"/><persName ref="p2916">Schertlini</persName>, saepissime illum interficere conatus est; sed maiestas, <lb xml:id="p1z24"/>quę in ipso d. <persName ref="p2916">Schertlino</persName> elucet, nebulonem terruit.</s>
					<s n="17" xml:lang="la">Omnino <lb xml:id="p1z25"/>męstus ad supplicium ivit.</s>
					<s n="18" xml:lang="la">Accepit pecunias a domino a Bollwill <lb xml:id="p1z26"/><placeName ref="l257">Constantiensi</placeName>, ut tale flagitium designaret.</s>
					<s n="19" xml:lang="la">Pauca sunt lecta publice eorum, <lb xml:id="p1z27"/>quę perpetravit miser, fortassis non absque causa propter homines <lb xml:id="p1z28"/>eiusdem coniurationis.</s>
					<s n="20" xml:lang="la" ana="farewell">Vale.</s>
					<s n="21" xml:lang="la"><placeName ref="l28">Basileę</placeName> 13. ianuarii 1552.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z29"/>T[uus] <persName ref="p1278">Gastius</persName> ex <lb xml:id="p1z30"/>animo.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z31"/>Aiunt concilium prolongatum <lb xml:id="p1z33"/>esse in duo annos.</s>
				</p>
				<p>
					<s n="24" xml:lang="la" ana="salute"><lb xml:id="p1z34"/>D. <persName ref="p8011">Gvaltherum</persName> meo nomine <lb xml:id="p1z35"/>salutabis.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pręstantissimo viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, episcopo <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z5"/>vigilantissimo.</s>
				</p>
				<p>
					<s n="26" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
