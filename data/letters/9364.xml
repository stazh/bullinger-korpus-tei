	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. Melius nunc te habere, honorande domine compater
					<lb xml:id="p1z2"/>ex animo gaudeo dominumque oro, ut cum bona
					<lb xml:id="p1z3"/>Valetudine tuas vires ita confirmet, ut ecclesiae
					<lb xml:id="p1z4"/>et nobis supersis diutissime. Amen. Honoraria
					<lb xml:id="p1z5"/>Vestra munera matronis Bernatibus obtulimus, qua
					<lb xml:id="p1z6"/>vobis gratias quam maximas agunt etiam quam officiosissimu s
					<lb xml:id="p1z7"/>D Tehosua delectus compatr meus suo
					<lb xml:id="p1z8"/>negotiorum causa non se vecta <placeName ref="l587">Tigurum</placeName>
					<lb xml:id="p1z9"/>diturum mihi dixit, neque ante crastinavi vestro
					<lb xml:id="p1z10"/>reversurum, voluitque, ut hoc tibi significe
					<lb xml:id="p1z11"/>quo et uxori et domino equi hoc
					<lb xml:id="p1z12"/>tuos indicetur, ut eo minus sint solliciti.
					<lb xml:id="p1z13"/>nihil, in quod d. Belingerus Augustanus certo
					<lb xml:id="p1z14"/>imper Solim obitum et revinciatam Venetis pacem
					<lb xml:id="p1z15"/>et missam a Venetis legationem Ragusam a Turcis
					<lb xml:id="p1z16"/>repulsam affirmant, cum novo maximoque Veneti
					<lb xml:id="p1z17"/>arsenalis apparatu. Qui hic sunt pagici mussitant
					<lb xml:id="p1z18"/>et suorum nonnullos amissos fateri incipiunt. Atque
					<lb xml:id="p1z19"/>haec admodum propere 24. iunii 23. Selvi sin omnes tui
					<lb xml:id="p1z20"/>Tui observn uno Hall.
					<lb xml:id="p1z21"/>cu dominis ac fratribs omnibus
					<lb xml:id="p1z22"/>De reditu meo dubius sum propter
					<lb xml:id="p1z23"/>civo mea de novo valdi laceram.
					<pb/>
					<lb xml:id="p2z1"/>Clarissimo viro d.
					<lb xml:id="p2z2"/>Heinricho Bullingero,
					<lb xml:id="p2z3"/>seniori, domino et compiti
					<lb xml:id="p2z4"/>meo veverenta colendo.
					<lb xml:id="p2z5"/>Tiguri.
				</p>
			</div>
		</body>
	</text>
