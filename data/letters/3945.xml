	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi, vir clarissime et domine <lb xml:id="p1z2"/>co<lb xml:id="p1z3"/>lendissime, <lb xml:id="p1z4"/>sex coronatos <placeName ref="l832">Gallicos</placeName> et duos <placeName ref="l834">Italicos</placeName> una <lb xml:id="p1z5"/>cum <lb xml:id="p1z6"/>literis filio tuo <lb xml:id="p1z7"/>inscriptis, quae mittam ad ipsum <placeName ref="l28">Basileam</placeName>.</s>
					<s n="3" xml:lang="la">Coniungam <lb xml:id="p1z8"/>ego illis debitum illud meum, quo tibi obstringor, ne quid <lb xml:id="p1z9"/>illi desit, ac ista omnia per proximum quemque nuncium certum <lb xml:id="p1z10"/>submittam.</s>
					<s n="4" xml:lang="la">Mense integro nihil ab eo vel literarum habui <lb xml:id="p1z11"/>vel quicquam audivi; sed nihilominus omnia eius rec<lb xml:id="p1z12"/>te habere arbitror.</s>
					<s n="5" xml:lang="la">Valemus hic recte per dei gratiam omnes.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Propter incendiarios quosdam satis periculosae sunt <lb xml:id="p1z14"/>res nostrae et omnium vicinorum nostrorum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Multi eam <lb xml:id="p1z15"/>ob rem vinciuntur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Dominus liberet nos a malo et tue<lb xml:id="p1z16"/>atur!</s>
					<s n="9" xml:lang="la">Pax inter <placeName ref="l832">Gallum</placeName> et <placeName ref="l875">Hispanum</placeName> confecta est, nec desunt <lb xml:id="p1z17"/>viri authoritate graves, qui suspicentur <lb xml:id="p1z18"/>in religionem <lb xml:id="p1z19"/>Christi pro antichristianismo reparando consilia <lb xml:id="p1z20"/>esse instituta.</s>
					<s n="10" xml:lang="la">De <placeName ref="l167">Genevensibus</placeName> quaedam dicuntur et de aliis, <lb xml:id="p1z21"/>de quibus tu forte melius.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Ex <placeName ref="l830">Anglia</placeName> accepi literas <lb xml:id="p1z22"/>aprilis 8. scriptas, quae et ipsae nunciant pacem <lb xml:id="p1z23"/>proclamatam <placeName ref="l296">Londini</placeName> inter <placeName ref="l830">Anglos</placeName>, <placeName ref="l832">Gallos</placeName> et <placeName ref="l2524">Scotos</placeName>.</s>
					<s n="12" xml:lang="la">Par<lb xml:id="p1z24"/>lamentum tum sedit adhuc, parlamentum vocant totius <lb xml:id="p1z25"/>regni comitia et consilium.</s>
					<s n="13" xml:lang="la">Renunciatum <lb xml:id="p1z26"/>qui<lb xml:id="p1z27"/>dem est papae, sed nondum reparata et restituta vera r<lb xml:id="p1z28"/>eligio.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Disputatum est a deputatis per parlamentum et reg<lb xml:id="p1z29"/>inam; novem utrinque sunt selecti ex evangelicis <lb xml:id="p1z30"/>et papistis; sed episcoporum quorundam disputantium <lb xml:id="p1z31"/>importunitate factum est, ut interruptum sit colloquium <lb xml:id="p1z32"/>et duo capti ex episcopis papistis, <placeName ref="l553">Wintoniensis</placeName> et <placeName ref="l1754">Li<lb xml:id="p1z33"/>ncolniensis</placeName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Rursus ergo agitur in parlamento de reducenda <lb xml:id="p1z34"/>religione, quae tempore <persName ref="p3207">Eduardi</persName> nuper mortui in <lb xml:id="p1z35"/>usu per <placeName ref="l830">Angliam</placeName> fuerat.</s>
					<s n="16" xml:lang="la">Dominus concedat spiritum suum <lb xml:id="p1z36"/>concilio illi.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Regina ardet zelo in sanctam religionem, <lb xml:id="p1z37"/>ardet nobilitas, et populus in <lb xml:id="p1z38"/>concionibus <lb xml:id="p1z39"/>est frequentissimus.</s>
					<s n="18" xml:lang="la">Concionantur strenue viri illi <lb xml:id="p1z40"/>docti, qui apud nos, <placeName ref="l167">Genevae</placeName>, <placeName ref="l41">Bernae</placeName>, <placeName ref="l28">Basileae</placeName>, <lb xml:id="p1z41"/><placeName ref="l491">Argentorati</placeName>, <placeName ref="l157">Francfordi</placeName> et alibi per <placeName ref="l822">Germaniam</placeName> fuere <lb xml:id="p1z42"/>exules et redierunt in patriam.</s>
					<s n="19" xml:lang="la">Scribunt de ad<lb xml:id="p1z44"/>mirando proventu evangelii.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Ex comitiis <placeName ref="l18">Augustanis</placeName> quo<lb xml:id="p1z45"/>tidie certiora expectamus, quae feret legatus ille <lb xml:id="p1z46"/>noster, qui una cum stris et aliorum <placeName ref="l862">Helvetiorum</placeName> <lb xml:id="p1z47"/>missus est <placeName ref="l18">Augustam</placeName>.</s>
					<s n="21" xml:lang="la">Audio principibus non bene inter <lb xml:id="p1z48"/>se convenire de religione et certamina esse; sed certiora, <lb xml:id="p1z49"/>quod dixi, expectamus.</s>
					<s n="22" xml:lang="la" ana="farewell">Vive et vale et boni <lb xml:id="p1z50"/>haec consule; nam plura iam non potui.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Tuas avide <lb xml:id="p1z51"/>expecto.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Salva sit tota domus tua, pater tuus, senex <lb xml:id="p1z52"/>reverendus, inprimis d. <persName ref="p6831">Traversus</persName> et alii viri boni.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z53"/>Miror an acceperitis libellos, quos misi inscriptos Bericht etc.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p1z54"/>Valet <persName ref="p20466">Hector</persName>, frater tuus.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><placeName ref="l587">Ti<lb xml:id="p1z55"/>guri</placeName> 6. maii 1559.</s>
				</p>
				<p>
					<s n="28" xml:lang="la" ana="salute"><lb xml:id="p1z56"/>Salutant te mei omnes; salutat <lb xml:id="p1z58"/>d. <persName ref="p8111">Martyr</persName> et alii.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><lb xml:id="p1z59"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p8432">Frideryc<lb xml:id="p2z2"/>ho a Salice</persName>, <lb xml:id="p2z3"/><placeName ref="l93">Cla<lb xml:id="p2z4"/>venensi</placeName> comissario dignissimo, domin<lb xml:id="p2z5"/>o suo colendo et fr<lb xml:id="p2z6"/>at<lb xml:id="p2z7"/>ri <lb xml:id="p2z8"/>charissimo.</s>
					<s n="31" xml:lang="de">An junckher <lb xml:id="p2z9"/><persName ref="p8432">Fridrychen von Salis</persName>, <lb xml:id="p2z10"/>comissarie<lb xml:id="p2z11"/>n zuͦ <placeName ref="l93">Cläf<lb xml:id="p2z12"/>fen</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
