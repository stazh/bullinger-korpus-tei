	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><placeName ref="l473">Sangallum</placeName> ubi veni, <persName ref="p495">Bullingere</persName> in domino <lb xml:id="p1z2"/>charissime, uxorem reperi etsi non omnino <lb xml:id="p1z3"/>sanitati restitutam, haud tamen lecto decumbentem.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Urget migrationem statuitque, si fieri queat, <lb xml:id="p1z5"/>feria secunda sequenti itinere sese com<lb xml:id="p1z6"/>mittere.</s>
					<s n="4" xml:lang="la">Det dominus, ut hęc profectio nihil <lb xml:id="p1z7"/>illi incommodet!</s>
					<s n="5" xml:lang="la">D. <persName ref="p8049">Vadianum</persName> nondum con<lb xml:id="p1z8"/>venire potui, conveniam eum cras a concione <lb xml:id="p1z9"/>excusaboque silentium tuum, quod nihil literarum <lb xml:id="p1z10"/>ad ipsum per me dedisti.</s>
					<s n="6" xml:lang="la">Plura non <lb xml:id="p1z11"/>licet in praesenti.</s>
					<s n="7" xml:lang="la">Nondum hic audire potui, <lb xml:id="p1z12"/>quid agant, imo verius quid insaniant <lb xml:id="p1z13"/><placeName ref="l257">Constantienses</placeName>, nisi quod in itinere intellexi <lb xml:id="p1z14"/>evacuare eos canonicorum cenon. ędes, ut <lb xml:id="p1z15"/>spiritus immundos olim virtute Christi <lb xml:id="p1z16"/>eiectos denuo astu et malicia Satanę <lb xml:id="p1z17"/>dementati recipiant, quo posteriora <lb xml:id="p1z18"/>peiora fiant prioribus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Optime vale.</s>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z19"/>Salutem uxori et domui toti.</s>
					<s n="10" xml:lang="la"><placeName ref="l473">Sangalli</placeName> <lb xml:id="p1z21"/>22. Septembris 1548.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z22"/><persName ref="p8417">Wolfg[angus] Musculus</persName>, <lb xml:id="p1z23"/>tuus in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo theologo <lb xml:id="p2z2"/>D. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>domino ac fratri <lb xml:id="p2z4"/>in Christo longe <lb xml:id="p2z5"/>charissimo.</s>
				</p>
			</div>
		</body>
	</text>
