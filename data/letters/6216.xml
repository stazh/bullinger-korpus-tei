	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non scripturus fueram, d. pater; proxime <lb xml:id="p1z2"/>fueram gratias acturus pro tuis tot officiis.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Sed ecce heri vesperi dicitur quidam <placeName ref="l306">Mediolano</placeName> <lb xml:id="p1z4"/>advenisse, qui dixisse fertur <persName>Hannibalis</persName> <lb xml:id="p1z5"/>copias omnes pessum isse, <persName>Hannibalem</persName> captum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Hodie veniunt literae d. consuli <persName ref="p8055">Ambrosio</persName> <placeName ref="l1059">Bellizona</placeName> <lb xml:id="p1z7"/>a certo viro, in quibus nunciatur illas copias <lb xml:id="p1z8"/>tempestate periisse et quidem in universum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Nunc, quid verum sit, audiemus brevi; existimo <lb xml:id="p1z10"/>rem non omni carere fide.</s>
					<s n="6" xml:lang="la">Addit ille in suis ad consulem <lb xml:id="p1z11"/>literis <placeName ref="l1121">Genuenses</placeName> in maximo periculo versari, <lb xml:id="p1z12"/>quod quidem S. Petro <persName>Corso</persName> nomine ab ipsis <lb xml:id="p1z13"/>ad <placeName ref="l2510">Turcam</placeName> defecerit et oppidum in <placeName ref="l2801">Corsica</placeName> ceperit.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Congruunt hęc cum d. <persName ref="p8033">Bezae</persName> literis.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Addit <lb xml:id="p1z15"/>praeterea <placeName ref="l1121">Genuenses</placeName> misisse certos homi<lb xml:id="p1z16"/>nes cum mandatis <placeName ref="l306">Mediolanum</placeName>, ut ibi militem novum <lb xml:id="p1z17"/>pararent; sed <placeName ref="l306">Mediolanensibus</placeName> militia interdictum <lb xml:id="p1z18"/>poena capitali.</s>
				</p>
				<p>
					<s n="9" xml:lang="de">Doch so sygind die houptlütt <lb xml:id="p1z19"/>und andere befelchslütt or dem verbott schon darvon <lb xml:id="p1z20"/>gesyn.</s>
					<s n="10" xml:lang="la">Haec subito te scire volui et dubito, <lb xml:id="p1z22"/>an sit, cui dare possim literas; existimo enim <lb xml:id="p1z23"/>nostros iam abiisse.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale, reverende pater.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/>Calendis augusti <placeName ref="l98">Curię</placeName> anno 1564.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">T[uus] <persName ref="p8009">F[abritius</persName>].</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>domino suo colen<lb xml:id="p2z4"/>dissimo.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
