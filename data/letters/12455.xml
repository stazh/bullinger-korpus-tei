	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi heri literas istas ab <persName ref="p1410">Herbrotio</persName><note xml:id="fn1" type="footnote" n="1">Der Brief <persName ref="p1410">Jakob Herbrots</persName> vom 24. März (<ref target="file12439">Nr. 2392</ref>).</note>, <lb xml:id="p1z2"/><placeName ref="l18">Augustanorum</placeName> consule, quas ad te mitto <lb xml:id="p1z3"/>nihil praeterea addens, quod verear, ne <lb xml:id="p1z4"/>tui<note xml:id="fn2" type="footnote" n="2">Unbekannte Zürcher.</note>, de quorum praesentia certior nunc sim <lb xml:id="p1z5"/>factus, mihi elabantur.</s>
					<s n="3" xml:lang="la">Ad alias literas <lb xml:id="p1z6"/>tuas<note xml:id="fn3" type="footnote" n="3"><persName ref="p495">Bullingers</persName> Briefe vom 22. (<ref target="file12434">Nr. 2387</ref>) und 29. März (<ref target="file12443">Nr. 2396</ref>).</note> alias.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="farewell">Vale.</s>
					<s n="5" xml:lang="la">2. aprilis 1546.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Tuus <lb xml:id="p1z7"/><persName ref="p8055">Ambr. Bl.</persName></s>
				</p>
				<p>
					<note type="address">[Ohne Adresse.]</note>
				</p>
			</div>
		</body>
	</text>
