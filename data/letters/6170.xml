	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime vir, Moecenas singularis, ex <persName ref="p20489">Huseri</persName> <lb xml:id="p1z2"/>literis, qui, cum in vivis adhuc parens meus piae <lb xml:id="p1z3"/>memoriae esset, et ad tempus etiam post mortem <lb xml:id="p1z4"/>eius nostra mensa vixit, tuam humanitatem <lb xml:id="p1z5"/>ex morte parentis mei in Christo defuncti maximum <lb xml:id="p1z6"/>moerorem accepisse intellexi.</s>
					<s n="2" xml:lang="la">Qua ex re singularem <lb xml:id="p1z7"/>tuum in parentem meum amorem iudicare potui, <lb xml:id="p1z8"/>dum eius, quem viventem dilexisti, mortem doles.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z9"/>Quin et hoc est certissimum argumentum tuae erga nos pro<lb xml:id="p1z10"/>pter parentem nostrum benevolentiae, quod audivimus <lb xml:id="p1z11"/>te apud illustrissimum principem nostrum pro matre <lb xml:id="p1z12"/>nostra nobisque intercessisse, ut is nostri curam susciperet <lb xml:id="p1z13"/>nosterque esset patronus.</s>
					<s n="4" xml:lang="la">Pro quo beneficio tibi ingentes <lb xml:id="p1z14"/>ago gratias nostrum omnium nomine precaturus perpe<lb xml:id="p1z16"/>tuo deum optimum maximum, ut, quod denegatum <lb xml:id="p1z17"/>est viribus meis recompensare, id ipse pro tua clementia <lb xml:id="p1z18"/>persolvat.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="salute">Quamvis autem propter aetatem, vir <pb/><lb xml:id="p2z1"/>singularis, te salutare per literas ut puer et indoctus <lb xml:id="p2z2"/>recusaverim aliquandiu, tamen, cum matri id placeret <lb xml:id="p2z3"/>speraremque te etiam meam infantiam, quod et <persName ref="p20489">Huserus</persName> <lb xml:id="p2z4"/>pollicitus est vestro nomine, boni consulturum propter veter<lb xml:id="p2z5"/>em cum parente meo amicitiam, matris meae volun<lb xml:id="p2z6"/>tati parui sperans tuae humanitati meas literas <lb xml:id="p2z7"/>gratas fore.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Sed nolui tibi esse onerosus, cum id etiam <lb xml:id="p2z8"/>festinatio tabellarii videretur vetare.</s>
					<s n="7" xml:lang="la">Te cum tota <lb xml:id="p2z9"/>familia et ecclesiis Helveticis deo commendo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p2z10"/>Iubet et mater omnesque meae sorores te plurimum salvere <lb xml:id="p2z11"/>simulque filium tuum d. <persName ref="p477">Ioannem Rudolphum <lb xml:id="p2z12"/>Bullingerum</persName> eiusque uxorem, deumque mecum precantur<lb xml:id="p2z13"/>, ut is omnia foelicia tibi tuisque largiatur.</s>
					<s n="9" xml:lang="la"><lb xml:id="p2z14"/>Datae <placeName ref="l311">Marpurgi</placeName> 18. iunii.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z15"/><persName>Laurentius Hyperius</persName> t[ibi] t[otus] d[editus].</s>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo simul ac piissimo <lb xml:id="p4z2"/>viro d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p4z3"/>in <placeName ref="l587">Tigurina</placeName> ecclesia <lb xml:id="p4z4"/>ministro verbi dei fidelissimo, <lb xml:id="p4z5"/>domino suo <persName>Męcenati</persName> <lb xml:id="p4z6"/>summa fide et gratitudine <lb xml:id="p4z7"/>perpetuo colendo etc.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p4z9"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
