	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi tuas hodie per <persName ref="p1227">Froschouerum</persName> et simul cum <lb xml:id="p1z2"/>illis, quae frater tuo nomine transcripta ad me <lb xml:id="p1z3"/>misit.</s>
					<s n="3" xml:lang="la">Ago pro his vobis gratias.</s>
					<s n="4" xml:lang="la">Mitto ego vicissim <lb xml:id="p1z4"/>ad fratrem aliquot schedulas, in quibus occisorum <lb xml:id="p1z5"/>et captivorum partim nomina partim numeri <lb xml:id="p1z6"/>continentur.</s>
					<s n="5" xml:lang="la">Alias nunc nihil prorsus habemus, <lb xml:id="p1z7"/>nisi quod rumor allatus est, qui me discrutiat, <lb xml:id="p1z8"/>si verus esset, quod tamen credere non possum, <persName>Adresium</persName> <lb xml:id="p1z9"/>ad partes adversas defecisse.</s>
					<s n="6" xml:lang="la">Expecto, quid <lb xml:id="p1z10"/>vos amplius per cursorem nostrum, qui his diebus <lb xml:id="p1z11"/>ad vos profectus est, scribatis et mittatis.</s>
					<s n="7" xml:lang="la">Misi ego <lb xml:id="p1z12"/>per illum, quid capitanei superstites ad <placeName ref="l2542">7 Cantones</placeName> <lb xml:id="p1z13"/>scripserint.</s>
					<s n="8" xml:lang="la">Mitto nunc sessionem <placeName ref="l1107">Tridentinam</placeName> <lb xml:id="p1z14"/>iam pridem habitam, sed quam adhuc aeditam non <lb xml:id="p1z15"/>vidi; nescio, an vos videritis.</s>
					<s n="9" xml:lang="la">Oro, ut exemplar <lb xml:id="p1z16"/>remittas; nam non est meum.</s>
					<s n="10" xml:lang="la">Mirantur multi, <lb xml:id="p1z17"/>quod te ita affligis <persName ref="p458">Brentio</persName> respondendo, cum vix <lb xml:id="p1z18"/>responso dignus videatur.</s>
					<s n="11" xml:lang="la">Sed ego oro dominum, ut tibi vires <lb xml:id="p1z19"/>suppeditet longaevas ad propugnationem et defensionem <lb xml:id="p1z20"/>veritatis.</s>
					<s n="12" xml:lang="la">Plura non possum nec habeo nunc.</s>
					<s n="13" xml:lang="la">Tuas <lb xml:id="p1z21"/><placeName ref="l167">Genevam</placeName> hodie vel cras mittam; sunt enim hic, per <lb xml:id="p1z22"/>quos hoc commode facere potero.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z23"/>Salutant te amici et fratres omnes, nominatim socer, <lb xml:id="p1z24"/>mater et familia omnis.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><persName ref="p8063">Steigerum</persName> et <persName ref="p3494">Diesbachium</persName> <lb xml:id="p1z25"/>literas tuas accepisse scio, quamvis hodie eos adhuc <lb xml:id="p1z26"/>alloqui non potuerim.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z27"/><placeName ref="l41">Bernae</placeName> 18. ianuarii, <lb xml:id="p1z28"/>qui est meus natalis, 1563.</s>
					<s n="18" xml:lang="la"><persName ref="p8018">I[<lb xml:id="p1z29"/>oannes] Hallerus</persName> tu<pb/><lb xml:id="p2z1"/>us.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino <lb xml:id="p2z4"/>suo honorando et compatri <lb xml:id="p2z5"/>charissimo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>