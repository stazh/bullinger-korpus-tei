	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Varia, crede mihi, quidam ex industria spargunt <lb xml:id="p1z2"/>de <persName ref="p18538">Caesaris</persName> abitu, quo nos gaudio aliquo adficiant; sed facile illis <lb xml:id="p1z3"/>non credo.</s>
					<s n="3" xml:lang="la">Sed hoc certissimum est Caesarem adhuc hęrere <placeName ref="l18">Augustae</placeName>, <lb xml:id="p1z4"/>nec facile avelletur ob multas causas.</s>
					<s n="4" xml:lang="la">Concionatorem adepti sunt <persName>Casparem <lb xml:id="p1z5"/>Huberum</persName>, qui Interim hactenus magno in pretio habuit et interitum <placeName ref="l18">Augustanum</placeName> <lb xml:id="p1z6"/>defensurus est.</s>
					<s n="5" xml:lang="la">Considera hic falsum fratrem, quem ante annum ad <lb xml:id="p1z7"/>se clam vocarunt cum eoque pacti sunt, qui sancte promisit se nihil contra <lb xml:id="p1z8"/>Interitum dicturum.</s>
					<s n="6" xml:lang="la">Ex <placeName ref="l18">Augustanis</placeName> militibus ducta est vexilla in arcem <lb xml:id="p1z9"/><placeName ref="l963">Asperg</placeName>, ne deficiat princeps absentibus <placeName ref="l875">Hispanis</placeName>.</s>
					<s n="7" xml:lang="la">De liberato principe <lb xml:id="p1z10"/>electore nihil audimus, et quidam putant difficile hoc posse consequi <lb xml:id="p1z11"/>a principibus imperii, quia <persName>Caesar</persName> timet nescio quid electore liberato.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/>Mitto ad te <persName>Corium</persName> missum et <persName>Polyaenum</persName>; <persName>Corium</persName> poteris petere <lb xml:id="p1z13"/>a domino <persName ref="p8171">Theodoro</persName>.</s>
					<s n="9" xml:lang="la">Gratias praeterea ago pro libro dono misso; rependam i<lb xml:id="p1z14"/>n remittendis libris, quoscunque volueris.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/><persName>Hector</persName> pro se respondebit ad literas, quas ego illi nomine tuo dedi.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z16"/>Hoc autem certum est d. <persName>Müssar de Gyß</persName><note type="margin">a.R.: Guise?</note> multa milia porcorum <lb xml:id="p1z17"/>ex <placeName ref="l691">Lotharingia</placeName> abegisse; <placeName ref="l632">Alsates</placeName> magnum detrimentum acceperunt.</s>
					<s n="12" xml:lang="la">Quae <lb xml:id="p1z18"/>vero <placeName ref="l303">Magdeburgi</placeName> aguntur, ex hac scheda cognoscere poteris, et quid <lb xml:id="p1z19"/>iam agant, ignoratur, et dubia quędam dicuntur, quibus fidem non habeo, <lb xml:id="p1z20"/>ac puto me literas a <placeName ref="l361">Noremberga</placeName> accepturum, ex quibus certiora habebimus.</s>
					<s n="13" xml:lang="la">Missae sunt ad me literę <lb xml:id="p1z21"/>ex <placeName ref="l284">Lipsia</placeName> cum variis libellis, sed non sunt redditę, fortassis <placeName ref="l157">Franco<lb xml:id="p1z22"/>fordię</placeName> adhuc latent.</s>
					<s n="14" xml:lang="la">Odio summo prosequor tales homines, qui tam <lb xml:id="p1z23"/>negligenter ea, quę in commissis habent, curant.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z24"/>Pestis nos vexat et timemus graviora necnon annona premimur.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z25"/>Dominus suo favore nos prosequatur.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell"><lb xml:id="p1z26"/>Vale aeternum cum omnibus tuis.</s>
					<s n="18" xml:lang="la">Si quid novi acceperis <lb xml:id="p1z27"/>ex <placeName ref="l18">Augusta</placeName> vel <placeName ref="l834">Italia</placeName>, communicare non sit molestum.</s>
					<s n="19" xml:lang="la"><persName ref="p8418">Myconius</persName> laborat <lb xml:id="p1z28"/>domestico suo morbo, quem proxima hebdomade non credidi alterum diem super<lb xml:id="p1z29"/>victurum; adeo grassabatur in illum morbus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z30"/>Nos, crede mihi, non alia de iuramento praestando senatui nostro obt<lb xml:id="p1z31"/>ulimus quam vos, etsi pluribus egimus verbis hoc negotium; ne dubita, nostri <lb xml:id="p1z32"/>constantes erunt, et <persName ref="p18600">Valentiniani</persName> parum vacillent.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z33"/><placeName ref="l28">Basileę</placeName> 28. octobris 1551.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z34"/>T[uus] <pb/><lb xml:id="p2z1"/><persName ref="p1278">Gastius</persName>.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Mandatum <placeName>Ensesheymenses</placeName> nomine <persName ref="p18477">Ferdinandi</persName> regis publicarunt, ne quis <lb xml:id="p2z2"/>in <placeName ref="l832">Galliam</placeName> militiam eat; poena capitis et amissio omnium <lb xml:id="p2z3"/>adiecta est.</s>
					<s n="24" xml:lang="la">Milites quidam <placeName ref="l18">Augustam</placeName> <lb xml:id="p2z4"/>p<lb xml:id="p2z5"/>etunt, qui acceperunt <lb xml:id="p2z6"/>aureum ab capitaneo; nescio, quo <persName>Caesar</persName> illos ducturus sit.</s>
					<s n="25" xml:lang="la"><lb xml:id="p2z7"/>Quid agant equites illorum publicis in itineribus, poteris ab <lb xml:id="p2z8"/>illo tabellario percontari.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">D. <persName ref="p495">Hei<lb xml:id="p2z10"/>nrycho Bu<lb xml:id="p2z11"/>llingero</persName>, pas<lb xml:id="p2z12"/>tori ec<lb xml:id="p2z13"/>clesiae <lb xml:id="p2z15"/><placeName ref="l587">Ti<lb xml:id="p2z16"/>gurinę</placeName>, suo <lb xml:id="p2z17"/>in domi<lb xml:id="p2z19"/>no char<lb xml:id="p2z22"/>iss<lb xml:id="p2z24"/>imo<lb xml:id="p2z25"/>.</s>
				</p>
				<p>
					<s n="27" xml:lang="de"><lb xml:id="p2z26"/><placeName ref="l587">Zuric<lb xml:id="p2z27"/>h</placeName><lb xml:id="p2z28"/>.</s>
				</p>
			</div>
