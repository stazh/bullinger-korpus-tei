	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi tuas, mi honorande et plurimum dilecte <lb xml:id="p1z2"/>pater ac compater, et ago tibi ingentes gratias pro <lb xml:id="p1z3"/>perpetua illa tua erga me benevolentia, qua <lb xml:id="p1z4"/>me et praesentem nuper excepisti et complexus es <lb xml:id="p1z5"/>et absentem quoque nunc et semper prosequeris.</s>
					<s n="3" xml:lang="la">Uti<lb xml:id="p1z6"/>nam gratum me tibi, ut deberem, exhibere possem!</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Intellexi vero ex d. <persName ref="p8063">Steigero</persName>, quid legati <lb xml:id="p1z8"/><placeName ref="l18">Augusta</placeName> reportarint.</s>
					<s n="5" xml:lang="la">Nostris illa non valde placent; <lb xml:id="p1z9"/>gaudemus interea propter <placeName ref="l2477">Palatini</placeName> constantiam nec <lb xml:id="p1z10"/>dubitamus, quin illo agone superato deinceps <lb xml:id="p1z11"/>et ipsius privatae res et commune veritatis ne<lb xml:id="p1z12"/>gotium melius sint habitur uod ad nos, ex <lb xml:id="p1z13"/>quo redii, nihil novi accepimus, quod alicuius <lb xml:id="p1z14"/>momenti sit, nisi quod <placeName ref="l167">Geneva</placeName> scribitur a regina <lb xml:id="p1z15"/>matre <placeName ref="l875">Hispanis</placeName> concessum esse, ut cum <lb xml:id="p1z16"/>exercitu per <placeName ref="l832">Galliam</placeName> in <placeName ref="l20">Inferiorem Germaniam</placeName> <lb xml:id="p1z17"/>transire possint ad compescendum eos, qui se in<lb xml:id="p1z18"/>quisitionis acerbitati illic opponunt.</s>
					<s n="6" xml:lang="la">Hoc si verum <lb xml:id="p1z19"/>sit, cogitare potes, quantum bellum et quanti motus <lb xml:id="p1z20"/>illic sint futuri.</s>
					<s n="7" xml:lang="la">Orandus itaque dominus, ut ecclesii<lb xml:id="p1z21"/>s succurrat et eas a rabie luporum istorum custodiat.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z22"/>De <placeName ref="l2510">Turca</placeName> nihil audimus amplius, nec <lb xml:id="p1z23"/>tuae aliquid de eo literae habent; suspicamur fictos <lb xml:id="p1z24"/>fuisse rumores illos ad emungendum pecuniam.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z25"/>Veteres istae sunt artes; sed verendum, ne contingat <lb xml:id="p1z26"/>illis tandem, quod puero in fabula, qui rusticos <lb xml:id="p1z27"/>evocabat ad capiendum lupum, qui tamen non <lb xml:id="p1z28"/>aderat etc.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Scripserunt autem interea ad me <lb xml:id="p1z29"/>ministri comitatus et classis <placeName ref="l339">Neocomensis</placeName> et <lb xml:id="p1z30"/>obnixe rogant, ne eorum nomen praetereatur, si <lb xml:id="p1z31"/>quando Confessio nostra nova rursus sit <lb xml:id="p1z32"/>aedenda; <lb xml:id="p1z33"/>cupiunt enim omnino nobiscum coniungi et conquerun<lb xml:id="p1z34"/>tur <lb xml:id="p1z35"/>se in priori ęditione esse praeteritos.</s>
					<s n="11" xml:lang="la">Excusavi vos <lb xml:id="p1z36"/>de eo apud illos et spem illis feci fieri posse, ut <lb xml:id="p1z37"/>deinceps nobis coniungantur.</s>
					<s n="12" xml:lang="la">Tu ergo huius, si quando <lb xml:id="p1z38"/>recudatur, sis memor, quaeso.</s>
					<s n="13" xml:lang="la" ana="salute">Alias nunc nihil <lb xml:id="p1z39"/>habeo, nisi quod dominum oro, ut te cum tuis omnibus, <lb xml:id="p1z40"/>quos omnes meo nomine salutabis, diutissime con<lb xml:id="p1z41"/>servet.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale.</s>
					<s n="15" xml:lang="la" ana="salute">Salutant te vicissim d. <persName ref="p8063">Steigerus</persName>, <persName ref="p3494">Dies<lb xml:id="p1z42"/>bachius</persName>, <persName ref="p5787">Madiensis</persName>, <persName ref="p4060">Zehenderi</persName>, socer, mater, <lb xml:id="p1z43"/>uxor et plures alii.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l41">Bernae</placeName> 4. iunii 1566.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z44"/><persName ref="p8018">Iohannes Hallerus</persName>, <lb xml:id="p1z45"/>tuus semper.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae antistiti <lb xml:id="p2z4"/>fidelissimo, domino meo <lb xml:id="p2z5"/>et compatri summa <lb xml:id="p2z6"/>reverentia et observantia <lb xml:id="p2z7"/>colendo.</s>
				</p>
			</div>
		</body>
	</text>
