	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tua omnia, reverende in Christo pater, <lb xml:id="p1z2"/>nobis bona fide sunt reddita.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">D. <persName ref="p4037">Zancho</persName> <lb xml:id="p1z3"/>et <persName ref="p2054">Martinengo</persName> suas misi; sed d. <persName ref="p2054">Martinengus</persName> <lb xml:id="p1z4"/>secessit <placeName ref="l329">Morbennum</placeName> propter pestem cum <lb xml:id="p1z5"/>matre vidua.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Civitas <placeName ref="l93">Clavennensis</placeName> <lb xml:id="p1z6"/>dissipata est; tam anxie sibi timent.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Consulem tecum fuisse scio, ex quo intellexisti <lb xml:id="p1z8"/>omnia, quae ad negotium <persName>Philippi</persName> pertinent.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Nunc subito scribo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Quae de sene <persName ref="p2336">Ochino</persName> <lb xml:id="p1z10"/>addis, nimis certa comperimus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">En <lb xml:id="p1z11"/>dialogum, qui iam exiit, in quo te <lb xml:id="p1z12"/>praecipue incessit.</s>
					<s n="9" xml:lang="la">Cura verti in Latinum, <lb xml:id="p1z13"/>quo senatus <placeName ref="l361">Norinbergensis</placeName> mature <lb xml:id="p1z14"/>a vestro moneri possit.</s>
					<s n="10" xml:lang="la">Procuravit <lb xml:id="p1z15"/>eum mihi d. <persName ref="p8114">Balingketus</persName>; dubitabat, <lb xml:id="p1z16"/>an mittendus, ego vero omnino mittendum <lb xml:id="p1z17"/>duxi.</s>
					<s n="11" xml:lang="la">Te, reverende pater, rogo, pergas <lb xml:id="p1z18"/>nos de omnibus edocere; nam sic spero n<lb xml:id="p1z19"/>os ante reditum legati <persName>Philippici</persName> habituros, <lb xml:id="p1z20"/>quod certo opponamus.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/><placeName ref="l98">Curię</placeName> subito propter nuncii festinationem <lb xml:id="p1z22"/>20. martii anno domini 1564.</s>
					<s n="14" xml:lang="la">T[uus] <persName ref="p8009">Fab[ricius</persName>].</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z23"/>Dialogus nondum est excusus, sed <lb xml:id="p1z24"/>in <placeName ref="l520">Valletelina</placeName> inter nonnullos <lb xml:id="p1z25"/>per manus traditur ex scripto; <lb xml:id="p1z26"/>eum in tui gratiam d. <persName ref="p8114">Balingketu<lb xml:id="p1z27"/>s</persName> enotari voluit.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
