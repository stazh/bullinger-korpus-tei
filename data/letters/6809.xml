	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Observande pater.</s>
					<s n="2" xml:lang="la">Rogo, ignosce meę tarditati et brevitati; <lb xml:id="p1z3"/>nam neque semper habeo aut scio, qui ad <lb xml:id="p1z4"/>vos veniant, cum habitem seorsim ab <lb xml:id="p1z5"/>oppido, neque ut plura scribam, ferunt <lb xml:id="p1z6"/>molestię multę.</s>
					<s n="3" xml:lang="la">Illud vero me consolatur, <lb xml:id="p1z7"/>quod perspecta tibi est mea erga te <lb xml:id="p1z9"/>observantia, ut, licet piger et tardus <lb xml:id="p1z11"/>sim in scribendo, dubitare tamen de mea voluntate <lb xml:id="p1z12"/>minime possis.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z13"/>Polonus iste <persName>Stanislaus <lb xml:id="p1z14"/>Ilovius</persName> appellatur, vir doctus Graece et <lb xml:id="p1z15"/>Latine, quique multa scripsit atque in <lb xml:id="p1z16"/>lucem dedit, mihi vero multos iam <lb xml:id="p1z17"/>annos amicus et familiaris.</s>
					<s n="5" xml:lang="la">Cupit te <lb xml:id="p1z18"/>videre et amicitiam ac familiaritatem con<lb xml:id="p1z19"/>trahere cum viris doctis.</s>
					<s n="6" xml:lang="la">Venit ex <lb xml:id="p1z20"/><placeName ref="l834">Italia</placeName>.</s>
					<s n="7" xml:lang="la">Poteris, si quid novi est, expiscari <lb xml:id="p1z21"/>atque intelligere ex ipso.</s>
					<s n="8" xml:lang="la">Valemus hic bene <lb xml:id="p1z22"/>dei beneficio, sed absumor, quod caream <lb xml:id="p1z23"/>consortio doctorum virorum.</s>
					<s n="9" xml:lang="la">Verum cum non <lb xml:id="p1z24"/>mihi, sed Christo et ecclesię natus sim hucque <lb xml:id="p1z25"/>me vocarit Christus, ferenda sunt mihi <lb xml:id="p1z26"/>omnia ęquo animo; tantum rogo, efficiat, <lb xml:id="p1z27"/>ne frustra hic vivam.</s>
					<s n="10" xml:lang="la">Is etiam te nobis et e<lb xml:id="p1z28"/>clesię suę servet diu incolumem.</s>
					<s n="11" xml:lang="la" ana="salute">Vale <lb xml:id="p1z29"/>et <lb xml:id="p1z30"/>fratres meo salvere iubebis nomine.</s>
					<s n="12" xml:lang="la"><placeName ref="l93">Clavennae</placeName> 10. <lb xml:id="p1z31"/>iunii 66.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">T[uus] <persName ref="p4037">Zanc<lb xml:id="p1z32"/>hus</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute"><persName>Saliceos</persName> salutavi et resalutant.</s>
					<s n="15" xml:lang="la">[<persName ref="p8432">Frideric<pb/><lb xml:id="p2z1"/>us</persName>] profectus est in <lb xml:id="p2z2"/><placeName ref="l882">Ungariam</placeName> ad fr<lb xml:id="p2z3"/>atrem.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z4"/>Clarissimo viro <lb xml:id="p2z5"/>d. <persName ref="p495">Henrico Bull[inger]o</persName>, <lb xml:id="p2z6"/>ecclesię <placeName ref="l587">Tigurin<lb xml:id="p2z7"/>ę</placeName> <lb xml:id="p2z8"/>patri observando.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z9"/><placeName ref="l587">Tigurum</placeName><lb xml:id="p2z10"/>.</s>
				</p>
			</div>
