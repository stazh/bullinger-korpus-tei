	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Iubeo te, optime amice et frater charissime,
					<lb xml:id="p1z2"/>plane sepurum esse; nemo a me vel hic intellex
					<lb xml:id="p1z3"/>tunde illa acceperim. Mox tamen d. Sullins
					<lb xml:id="p1z4"/>ro scripsi ac nonui ageret cum symmysto
					<lb xml:id="p1z5"/>et praeveniret, ne quid inde inter nos oriatur dis
					<lb xml:id="p1z6"/>De rebus novis ad te nihil scribo,
					<lb xml:id="p1z7"/>quod ita varient rumores, ut nihil cer
					<lb xml:id="p1z8"/>possit commemorari. Dominum oro, ut
					<lb xml:id="p1z9"/>is nostri misertus turbas illas sedare dignetur.
					<lb xml:id="p1z10"/>et pacem concedere. Optime vale una cum
					<lb xml:id="p1z11"/>uxorem et liberis tuis, quibus omnibus benedicat
					<lb xml:id="p1z12"/>dominus. Semper tantum tuorumque sum memor
					<lb xml:id="p1z13"/>Atque utinam iuvare te possem tam facile
					<lb xml:id="p1z14"/>quam animus esset paratus. Iterum iterumque vale
					<lb xml:id="p1z15"/>et studiosos vestros tibi commendatos habe
					<lb xml:id="p1z16"/>In vigilia natinitatis domini 1156.
					<lb xml:id="p1z17"/>Tuus Bullingerus.
					<pb/>
					<lb xml:id="p2z1"/>Clarissimo viro d. Caeari
					<lb xml:id="p2z2"/>Curionp
					<lb xml:id="p2z3"/>fesseri scholae Basieas
					<lb xml:id="p2z4"/>dmino meo
					<lb xml:id="p2z5"/>colendo et fratri charissimo.
				</p>
			</div>
		</body>
	</text>
