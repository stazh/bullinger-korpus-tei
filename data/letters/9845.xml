	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>zu.
					<lb xml:id="p1z2"/>Mein freündtlich gruß mit erbietustg alles
					<lb xml:id="p1z3"/>gutten sin uich bevor schrwirdig besonders
					<lb xml:id="p1z4"/>lieber herr und verthrauteter freundt
					<lb xml:id="p1z5"/>ewers widerm zmmlchen Gallen wolstandz
					<lb xml:id="p1z6"/>ni, so schleerer und schmertzlicher wandlche
					<lb xml:id="p1z7"/>li ich on Hagen eferter, unde laiti
					<lb xml:id="p1z8"/>in Alenetztige euch fürer langtkwrig in
					<lb xml:id="p1z9"/>gesurdihitt seiner kichen zu gutten in
					<lb xml:id="p1z10"/>gnediget halt jehaben1. demnaz aze
					<lb xml:id="p1z11"/>send im mehr durch ander leachs
					<lb xml:id="p1z12"/>pürg worden deßs schlewren folwst, so ich
					<lb xml:id="p1z13"/>memer lieben gemagen selig erlatten
					<lb xml:id="p1z14"/>
					<lb xml:id="p1z15"/>Go lehet mich kurffig, so lang es
					<lb xml:id="p1z16"/>sin gellicher wil vor deglirten und
					<lb xml:id="p1z17"/>deen lei. Es schickren mieinen libe
					<lb xml:id="p1z18"/>riterem, an statt ier fratam matter selius
					<lb xml:id="p1z19"/>siiz hreimet et enum mercipam ad Iraii
					<lb xml:id="p1z20"/>t in vo il worgen, dar sy lach an
					<lb xml:id="p1z21"/>aclias miessem und abledam forta te
					<lb xml:id="p1z22"/>n meine geleaden un lüch dienstlich jede
					<lb xml:id="p1z23"/>het, vo mir forderen solt ir mich
					<lb xml:id="p1z24"/>ganz geneigt, wissen hiemint dar
					<lb xml:id="p1z25"/>herne gnad bevokhen. Datum u
					<lb xml:id="p1z26"/>den 5. delembris anno 74.
					<lb xml:id="p1z27"/>Zrych Phelep Fress.
					<lb xml:id="p1z28"/>von hohen Sax.
					<pb/>
					<lb xml:id="p2z1"/>emm chrundig hochgeen
					<lb xml:id="p2z2"/>heoten H. Heinrych Bullinger,
					<lb xml:id="p2z3"/>jievee der kirche Zurich seinen
					<lb xml:id="p2z4"/>sonds leben uerb frfrareten.
					<lb xml:id="p2z5"/>frendt.
