	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi proxime de obitu <persName>Calephi Bschörlii</persName>.</s>
					<s n="3" xml:lang="la">Interea omnis <lb xml:id="p1z2"/>mea familia recte valet, domino sit laus!</s>
					<s n="4" xml:lang="la">2. octobris <lb xml:id="p1z3"/>obiit frater ac symmista noster d. <persName ref="p1804">Iodocus</persName> magna <lb xml:id="p1z4"/>fiducia animam suam domino tradens.</s>
					<s n="5" xml:lang="la">Nunc nobis de alio <lb xml:id="p1z5"/>erit cogitandum.</s>
					<s n="6" xml:lang="la">Hic metuo turbas ingentes; erunt <lb xml:id="p1z6"/>enim, qui diaconum nostrum nobis obtrudere conabuntur.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z7"/>Quod si fiet, iacta erit contentionis et dissipation<lb xml:id="p1z8"/>is huius ecclesię alea; est enim homo mire superbus, <lb xml:id="p1z9"/>indoctus, domi educatus (nisi quod <placeName ref="l491">Argentinę</placeName> aliquamdiu <lb xml:id="p1z10"/>fuit) linguę effrenis et contumacis, <persName ref="p8417">Musculo</persName> <lb xml:id="p1z11"/>invisissimus, doctrinę valde suspectae.</s>
					<s n="8" xml:lang="la">Resistemus autem, <lb xml:id="p1z12"/>quantum quantum poterimus; declarabimus senatui omnia pericula, <lb xml:id="p1z13"/>quamvis non sine magna multorum fiet offensione.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z14"/>Tamen sic res et necessitas expostulat.</s>
					<s n="10" xml:lang="la">Nos omnes <persName ref="p8417">Musculo</persName> <lb xml:id="p1z15"/>nostra dabimus suffragia.</s>
					<s n="11" xml:lang="la">Tu cum omnibus, qui vobiscum s<lb xml:id="p1z16"/>unt, orabis diligenter ad dominum, ut huic ecclesię succurrat <lb xml:id="p1z17"/>et in coepta pace et tranquillitate ipsam conservet.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z18"/>Si etiam habes aliquid opis et consilii, suggere, quęso, in <lb xml:id="p1z19"/>tempore.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale.</s>
					<s n="14" xml:lang="la" ana="salute">Salutant te tuosque mei omnes, <lb xml:id="p1z20"/><persName ref="p8417">Musculus</persName> item cum suis.</s>
					<s n="15" xml:lang="la">Fratri meo, quaeso, dic <lb xml:id="p1z21"/>me recte valere cum meis, ut idem nunciet <lb xml:id="p1z22"/>matri meę, quam scio valde esse sollicitam.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z23"/><placeName ref="l41">Bernę</placeName> 5. octobris 1552.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z24"/>Tuus <persName ref="p8018">I[oannes] <pb/><lb xml:id="p2z1"/>H[allerus</persName>].</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Clarissimo <lb xml:id="p2z2"/>viro d. <lb xml:id="p2z3"/><persName ref="p495">Bullingero</persName> <placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="de">M. <persName ref="p495">Heinrych <lb xml:id="p2z4"/>Bullingeren</persName>, predicanten <lb xml:id="p2z5"/>zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
