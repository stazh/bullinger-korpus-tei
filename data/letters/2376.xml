	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Tuas cum libello <placeName ref="l830">Anglicano</placeName> accepi, et <lb xml:id="p1z2"/>omnia mihi gratissima fuerunt; sed misere <lb xml:id="p1z3"/>nunc regnum illud agitatur.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><persName ref="p18538">Cesar</persName> <lb xml:id="p1z4"/>apud papam triumphat, quia illi <lb xml:id="p1z5"/>ista regina affinis est, et promittit <lb xml:id="p1z6"/>de religione omnia.</s>
					<s n="4" xml:lang="la">Et re vera scias <lb xml:id="p1z7"/>certo missam iam receptam et omnia <lb xml:id="p1z8"/>rursum mirum in modum immutata.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Her<lb xml:id="p1z9"/>i hic fuit apud me <placeName ref="l830">Anglus</placeName> <lb xml:id="p1z12"/>nobilis, qui per postas regias it <placeName ref="l425">Romam</placeName>, <lb xml:id="p1z13"/>qui mihi illam certam esse mutationem <lb xml:id="p1z14"/>narravit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Inter alia habet literas <lb xml:id="p1z15"/>a <persName ref="p18554">regina Maria</persName> ad cardinalem <persName>Paulum</persName> <lb xml:id="p1z16"/><placeName ref="l830">Anglum</placeName>, et vocatur; credo iam esse <lb xml:id="p1z17"/>in itinere, quod etiam sperat ille Anglus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z18"/>In <placeName ref="l2589">Picardia</placeName> omnia prospera; cum pugnandum <lb xml:id="p1z19"/>esset, hostes fugere.</s>
					<s n="8" xml:lang="la">Sed remitto te ad <lb xml:id="p1z20"/>coppiam literarum, quas nostris confederatis s<lb xml:id="p1z21"/>cripsi; hanc, <lb xml:id="p1z22"/>si placet, <lb xml:id="p1z23"/>dominis et c<pb/><lb xml:id="p2z1"/>onsilio dabis.</s>
					<s n="9" xml:lang="la">Rex vult tota hy[e]me <lb xml:id="p2z2"/>bellum trahere, et credo illa sex <lb xml:id="p2z3"/>milia militum in <placeName ref="l834">Italiam</placeName> mittere, <lb xml:id="p2z4"/>ubi etiam omnia prospera; nam d. <persName ref="p17907">Ferrandus</persName> <lb xml:id="p2z5"/>cum nostris in <placeName ref="l736">Pedemontem</placeName> cessit cum <lb xml:id="p2z6"/>magna iactura suorum.</s>
					<s n="10" xml:lang="la">De <persName>Alberto</persName> <lb xml:id="p2z7"/>illo nihil certi habemus; scribitur <lb xml:id="p2z8"/>mihi illum mortuum et in secundo <lb xml:id="p2z9"/>conflictu a <placeName>Grumsheisensi</placeName> occisum; sed ille ipse, <lb xml:id="p2z10"/>qui scribit, <lb xml:id="p2z11"/>parv<lb xml:id="p2z12"/>am fidem facit; <lb xml:id="p2z13"/>ideo dubito.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale optime.</s>
					<s n="12" xml:lang="la">Ex <placeName ref="l760">Soluturo</placeName> <lb xml:id="p2z14"/>27a augusti.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Tuus semper <persName ref="p8296">B<lb xml:id="p2z15"/>ass[afontan<lb xml:id="p2z16"/>eus]</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p3z1"/>Viro optimo et amico <lb xml:id="p3z2"/>domino <persName ref="p495">Bulingero</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p3z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
