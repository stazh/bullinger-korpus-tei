			<zone xml:id="p2z2-0" points="1199,2092 1404,2036 1572,2052 1671,2029 1716,2056 1936,2029 1929,1951 1801,1946 1625,1987 1501,1977 1453,1944 1376,1990 1202,1975">1206,2045 1242,2035 1279,2032 1315,2030 1352,2027 1389,2027 1425,2027 1462,2027 1498,2027 1535,2027 1572,2027 1608,2025 1645,2024 1681,2024 1718,2024 1755,2021 1791,2021 1828,2019 1864,2018 1901,2018 1938,2018</zone>
