	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Redditae sunt nobis tuae, charissime et venerande domine compater, <lb xml:id="p1z2"/>et agimus tibi magnas gratias pro pio tuo in nos studio, praesertim <lb xml:id="p1z3"/>etiam pro munusculis illis et strenis liberis nostris missis; <lb xml:id="p1z4"/>dominus tibi tuisque rependat omnia!</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Apud nos nunc nihil est novi, <lb xml:id="p1z5"/>quod scribere possim, nisi quod domini gratia sustulit quodammodo <lb xml:id="p1z6"/>luem illam hactenus nos infestantem; inter multos enim dies <lb xml:id="p1z7"/>nemo obiit nisi d. <persName>Georgius zum Stein</persName>, non tamen ex peste ille.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Aequum nunc est, ut domino agamus gratias, et praeparemus nos ad graviora <lb xml:id="p1z9"/>ferenda; nihil enim, quos dominus supplices vult, lucrantur quam <lb xml:id="p1z10"/>cruces, dolores et labores, quos, ut recte iudicas, si quid aliud <lb xml:id="p1z11"/>pariet nobis concilium.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Oratione tamen et precibus conabimur ill[ud] <lb xml:id="p1z12"/>dissipare, siquidem efficatiora nobis contra illud non sunt a[lia].</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Placet archiepiscopi <placeName ref="l267">Coloniensis</placeName> constantia; dominus illum confirmet!</s>
					<s n="7" xml:lang="la">Plac[et] <lb xml:id="p1z14"/>etiam, quod audio <placeName ref="l587">Tiguri</placeName> mandata renovata eaque typis excusa; apud <lb xml:id="p1z15"/>nos, ut hic vulgarentur, obtineri non potuit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Gratulamur tamen nobis in <lb xml:id="p1z16"/>eo, quod vel scripto hoc sit factum.</s>
					<s n="9" xml:lang="la">Exemplar vero vestrorum <lb xml:id="p1z17"/>mandatorum non videre modo, sed et habere cupio; proinde ut <lb xml:id="p1z18"/>mihi compares mea pecunia et mittas, etiam atque etiam rogo.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/><persName>Daniel Fluͤlerus</persName>, iuvenis doctus et compositorum satis morum, <lb xml:id="p1z20"/>in locum <persName>Salomonis</persName> submittitur; eum tibi commendo.</s>
					<s n="11" xml:lang="la">Speramus <lb xml:id="p1z21"/>et vos vestros deinceps ad nos missuros, postquam intellexeritis de<lb xml:id="p1z22"/>ferbuisse pestem; praeterquam enim, quod vel solus <persName ref="p8417">Musculus</persName> dignus <lb xml:id="p1z23"/>est, quem audiant plurimi, video iuvenilem illam amicitiam inter utriusque <lb xml:id="p1z24"/>ecclesiae ministros contractam nobis ab utraque parte deinceps multum <lb xml:id="p1z25"/>pacis et commoditatis allatura.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale.</s>
					<s n="13" xml:lang="la">17. decembris 1550.</s>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z26"/>Salutant vos mei omnes, inprimis vero <persName ref="p20670">Elizabetha</persName> tibi tuaeque gratias <lb xml:id="p1z27"/>agit magnas.</s>
					<s n="15" xml:lang="la" ana="salute">Saluta quoque ex me fratres omnes, d. <persName ref="p8127">Pellicanum</persName>, <persName ref="p8011">Gvaltherum</persName>, <persName ref="p8171">Theodorum</persName> <lb xml:id="p1z28"/>et utrumque generum, quibus tanto parcius scribo, quanto ad te fre<lb xml:id="p1z29"/>quentius.</s>
					<s n="16" xml:lang="la"><placeName ref="l41">Bernae</placeName>.</s>
					<s n="17" xml:lang="la">Literas ad <persName ref="p540">Calvinum</persName> direc<lb xml:id="p1z30"/>tas ante biduum illi misi.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z31"/>Tuus in domino <persName ref="p8018">I[oannes] Hallerus</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>fidelissimo <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae pastori, domino et <lb xml:id="p2z5"/>compatri suo venerando.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>