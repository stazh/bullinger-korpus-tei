	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Gratiam et pacem.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Signaveram literas priores<note xml:id="fn1" type="footnote" n="1">Oben <ref target="file10913">Nr. 873</ref>.</note> easque <lb xml:id="p1z3"/>tradideram <persName ref="p8437">Erasmo</persName> nostro<note xml:id="fn2" type="footnote" n="2"><persName ref="p8437">Erasmus Schmid</persName>.</note> cum in, mentem venit <lb xml:id="p1z4"/>non infrugiferum futurum, si ea tibi ex <lb xml:id="p1z5"/>opere nostro Paulino nondum perfecto<note xml:id="fn3" type="footnote" n="3"><persName ref="p495">Bullinger</persName>, In omnes apostolicas epistolas commentarii, Zürich 1537 (<bibl source="b286">HBBibl</bibl> I 84).</note> mitterem, <lb xml:id="p1z6"/>quae scripsi de ratione sacramentorum et eu<lb xml:id="p1z7"/>charistia.</s>
					<s n="3" xml:lang="la">Istis vero novum exemplar loqu<lb xml:id="p1z8"/>pletavi; in aliis ante annos aliquot aeditis<note xml:id="fn4" type="footnote" n="4"><persName ref="p495">Bullingers</persName> Kommentar zum Römerbrief (<bibl source="b286">HBBibl</bibl> I 42) war 1533, jener zum ersten Korintherbrief (<bibl source="b286">HBBibl</bibl> I 53) 1534 erstmals erschienen.</note> <lb xml:id="p1z9"/>haec per omnia non leges.</s>
					<s n="4" xml:lang="la">Lege itaque, quae <lb xml:id="p1z10"/>scripsi fol. 41 usque ad 45, et rursus, <lb xml:id="p1z11"/>quae sunt fol. 204 usque ad 216<note xml:id="fn5" type="footnote" n="5">An den genannten Stellen handelt <persName ref="p495">Bullinger</persName> ausführlich über die Sakramente (zu <cit type="bible"><ref>Röm 4, 11f</ref></cit>; aaO, S. 41-45) und über die Eucharistie (zu <cit type="bible"><ref>1Kor 11, 17-34</ref></cit>; aaO, S. 202-216).</note>.</s>
					<s n="5" xml:lang="la">Planius et <lb xml:id="p1z12"/>melius ego de hoc negotio dicere non possum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z13"/>Vale et haec nostra etiam <persName ref="p1365">Grynaeo</persName> communica aut, <lb xml:id="p1z14"/>si placet, ipsi etiam <persName ref="p467">Bucero</persName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 4. <lb xml:id="p1z15"/>augusti 1536.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p495">H. Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="9" xml:lang="la">Domino <pb/><lb xml:id="p2z1"/><persName ref="p8418">Myconio</persName> suo.</s>
				</p>
			</div>
		</body>
