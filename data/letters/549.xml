	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Pro tuis in me collatis beneficiis, integerrime doctissimeque <lb xml:id="p1z3"/><persName ref="p495">Bullingere</persName>, gratiam habeo maximam lubentius, si fert occasio, <lb xml:id="p1z4"/>relaturus.</s>
					<s n="2" xml:lang="la">Mitto fasciculum tibi reddendum, e <placeName ref="l2472">Polonia</placeName> opinor <lb xml:id="p1z5"/>acceptum, cum libro imperiali Germanico e meis libris; <lb xml:id="p1z6"/>nullus enim hic venalis reperitur.</s>
					<s n="3" xml:lang="la"><persName>Josephum</persName> additurus eram; sed <lb xml:id="p1z7"/>auriga ne illam quidem sarcinulam videbatur accepturus; <lb xml:id="p1z8"/>proxime tamen ad tuam humanitatem perveniet.</s>
					<s n="4" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z9"/>meque amare perge.</s>
					<s n="5" xml:lang="la">4. Iunii 1549.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Tuus <persName ref="p8353">Frobenius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eruditissimo viro D. <persName ref="p495">Bullingero</persName>, <lb xml:id="p2z2"/>divini verbi apud <placeName ref="l587">Tigurum</placeName> <lb xml:id="p2z3"/>preconi fidelissimo, domino suo multum col<lb xml:id="p2z4"/>endo.</s>
				</p>
				<p>
					<note type="author">[Bemerkung von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="8" xml:lang="la">"<persName ref="p8353">Hieronymus Frobenius</persName>".</s>
				</p>
			</div>
