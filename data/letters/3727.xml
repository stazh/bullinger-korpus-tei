	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve et tu iterum, doctissime mihique tot nominibus <lb xml:id="p1z2"/>observande <persName ref="p495">Bullingere</persName>, frater charissime.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Accepi per publicum illum urbis vestrę tabellarium epistolam <lb xml:id="p1z4"/>tuam ac sine mora misi, qui a d. <persName ref="p6070">Henrico Petro</persName> <lb xml:id="p1z5"/>mihi adferrent, quos postulas libros; verum alterum <lb xml:id="p1z6"/>duntaxat mihi misit reliquis codicis Theodosiani <lb xml:id="p1z7"/>omnibus distractis.</s>
					<s n="3" xml:lang="la">Istum porro alterum tectorio <lb xml:id="p1z8"/>munitum per tabellarium mitto, nisi ipse renuat <lb xml:id="p1z9"/>accipere.</s>
					<s n="4" xml:lang="la">De precio rogatus typographus postulat <lb xml:id="p1z10"/>dimidium florenum, quem ego solvam, quamprimum <lb xml:id="p1z11"/>recuperata valetudine in publicum prodiero.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z12"/>Hiis coniunctas pridie scripseram missurus per <placeName ref="l830">Anglum</placeName> <lb xml:id="p1z13"/>quendam ad vos profecturum, qui tamen fidem fefellit.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Nunc paulo melius habeo ac meliora etiam spero.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Dominus que de me statuat, ipse novit; fiat voluntas <lb xml:id="p1z16"/>eius.</s>
					<s n="8" xml:lang="la">Si erigat me, scribam fusius; nunc mihi <lb xml:id="p1z17"/>totum librum scripsisse videor.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l28">Basileę</placeName> <lb xml:id="p1z18"/>6. octobris 1558.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/>Tuus <persName ref="p1754">Ioannes Iungius</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio viro <lb xml:id="p2z2"/>d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>ecclesię <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z4"/>antistiti praeclaro, <lb xml:id="p2z5"/>domino suo colendissimo.</s>
					<s n="13" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
