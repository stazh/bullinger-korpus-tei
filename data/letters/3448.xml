	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Clarissime idemque doctissime domine <persName ref="p495">Bulinger</persName>e, nactus perparum otii <lb xml:id="p1z3"/>et nuncii certi occasione praetermittere nolui, quin te hac <lb xml:id="p1z4"/>unica schedula salutarem.</s>
					<s n="2" xml:lang="la">Obsecro, animum meum erga te <lb xml:id="p1z5"/>promptissimum et sincerissimum aequo et paterno intempleris <lb xml:id="p1z6"/>animo, quo ego te ob summam tuam eruditionem semper <lb xml:id="p1z7"/>prosecutus sum tuoque filio, qui in <placeName>Pathmo</placeName> apud m<lb xml:id="p1z8"/>e cum praesentium latore fuit, satis abunde n<lb xml:id="p1z9"/>arravi.</s>
					<s n="3" xml:lang="la">Eam promptitudinem tibi etiamnum offero, <lb xml:id="p1z10"/>quam precor accipito sereno vultu.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="farewell">His v<lb xml:id="p1z12"/>ale <lb xml:id="p1z13"/>foelicissime.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Datum raptim... 3. calendas ianuarii 1557<note type="misc">Ortsname unlesbar.</note>.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Tuus ex animo d <persName ref="p8100">Paulus <lb xml:id="p1z15"/>Scalichius</persName>.<lb xml:id="p1z16"/>..</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>Celeberrimo viro <lb xml:id="p2z2"/><persName ref="p495">Henrico Bulingero</persName>, <lb xml:id="p2z3"/>amico observandissimo.</s>
				</p>
				<p>
					<note type="author">[Darunter von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="8" xml:lang="la"><lb xml:id="p2z4"/>D. comitis num<lb xml:id="p2z5"/>morum pr...</s>
				</p>
			</div>
		</body>
	</text>
