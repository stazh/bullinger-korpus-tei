	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literae tuae (vir clarissime paterque in Christo reverende) <lb xml:id="p1z2"/>mihi die lunae, qui dies <persName>Galli</persName> fuit, sero admodum sunt <lb xml:id="p1z3"/>redditae.</s>
					<s n="3" xml:lang="la">Vix tantum temporis mihi superfuit, ut tuas <lb xml:id="p1z4"/>et <persName ref="p1731">Iaskei</persName> legerem.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Habeo paternitati tuae gratias <lb xml:id="p1z5"/>ingentes.</s>
					<s n="5" xml:lang="la">Legatus tuas nobis communicavit; sed quod <lb xml:id="p1z6"/>viderem festinantius scriptas, existimabam te alia nova <lb xml:id="p1z7"/>ex <placeName ref="l822">Germania</placeName> habere, quae scribere ad legatum temporis <lb xml:id="p1z8"/>angustia exclusus nequivisses.</s>
					<s n="6" xml:lang="la">Quae de <placeName ref="l2524">Scotis</placeName> scripseram, <lb xml:id="p1z9"/>ficta fuerunt.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Capita pacificationis, de quibus tu, et <lb xml:id="p1z10"/>legatus habet et nobis legit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Illud <persName>Gallis</persName> intolerabile est, <lb xml:id="p1z11"/>quod <placeName ref="l2524">Scoti</placeName> eos a suo regno volunt exclusos.</s>
					<s n="9" xml:lang="la">Remitto <lb xml:id="p1z12"/><persName ref="p1731">Iaskei</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Novi hic nihil habetur, nisi forte id novum est, <lb xml:id="p1z13"/>quod tamen iam est inveteratum, de turbis, quae <placeName ref="l425">Romae</placeName> sunt, <lb xml:id="p1z14"/>de quibus quaedam ad d. <persName ref="p1884">Lavaterum</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Dux <placeName ref="l150">Ferrarię</placeName> <lb xml:id="p1z15"/>7. die huius mensis diem suum obiisse dicitur.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale, pater <lb xml:id="p1z16"/>in Christo reverende, et quod adhuc facis, me tibi commendatum <lb xml:id="p1z17"/>habe.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l98">Curię</placeName> in die S. Galli anno 1559.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z18"/>Salvum te volunt et incolumem nostri omnes.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z19"/><persName ref="p8009">Ioannes Fabricius</persName> tui <lb xml:id="p1z20"/>observantissimus.</s>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro eruditione <lb xml:id="p2z2"/>et pietate excellenti d. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>antistiti vigilantissimo, domino <lb xml:id="p2z5"/>et patrono suo multum <lb xml:id="p2z6"/>observando.</s>
				</p>
			</div>
		</body>
	</text>
