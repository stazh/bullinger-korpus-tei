	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Sal<lb xml:id="p1z2"/>ve, vir clarissime.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Etsi nullas ad te literas hinc dare soleo, quod negotiis <lb xml:id="p1z3"/>te multis gravissimisque implicitum inanibus meis distinere <lb xml:id="p1z4"/>nephas existimem, hac tamen huius libelli recens cusi <lb xml:id="p1z5"/>occasione mihi data continere me non potui, quin duabus <lb xml:id="p1z6"/>hisce lineis te reverenter salutarem librumque mitterem.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Quem quidem eo etiam nomine gratiorem tibi fore suspicatus <lb xml:id="p1z8"/>sum, quod et extremum fuerit d. <persName ref="p540">Calvini</persName> opus et in <lb xml:id="p1z9"/>praefatione explicet praestantissimi illius tibi coniunctissimi <lb xml:id="p1z10"/>viri transitum ad meliorem vitam, addat etiam suorum omnium librorum <lb xml:id="p1z11"/>catalogum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="farewell">Tu interim vale, vir clarissime, nos deum rogabimus <lb xml:id="p1z12"/>te saltem diu nobis superstitem conservet ad ipsius gloriam <lb xml:id="p1z13"/>et ecclesiae utilitatem.</s>
					<s n="5" xml:lang="la"><placeName ref="l167">Genevae</placeName> 7. calendas septembris <lb xml:id="p1z14"/>1564.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Tui observantissimu<lb xml:id="p1z16"/>s <persName ref="p2054">Ulisses Martinengus</persName>, c[omes] <placeName>B[ari]</placeName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heynricho Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z2"/>pastori integerrimo, domino suo colendissimo.</s>
					<s n="8" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
