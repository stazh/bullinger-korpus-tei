	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p1586">Fr[an<lb xml:id="p1z2"/>ciscus<lb xml:id="p1z3"/>] H<lb xml:id="p1z4"/>otom<lb xml:id="p1z6"/>anus</persName> S. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z7"/>Qui tibi has reddit, puer est mihi iampridem notus, quadriennium apud <persName ref="p8033">Bezam</persName> <lb xml:id="p1z8"/>vixit, mihi <placeName ref="l280">Lausannae</placeName> docenti satis diu operam dedit.</s>
					<s n="3" xml:lang="la">Eum ergo tibi, observande <lb xml:id="p1z9"/>pater, commendo.</s>
					<s n="4" xml:lang="la">Dominus <persName ref="p8111">Martyr</persName> eum ut alios complures abduxit.</s>
					<s n="5" xml:lang="la">Hanc vos nostrae scholae <lb xml:id="p1z10"/>calamitatem affertis, quod non odo doctorem praestantissimum, sed etiam auditorii <lb xml:id="p1z11"/>magnam partem nobis eripitis.</s>
					<s n="6" xml:lang="la">Quod ego molestius ferre coepi, postquam ab <lb xml:id="p1z12"/>amplissimo senatu rogatus sum, ut iuris interpretationem susciperem, quum essem <lb xml:id="p1z13"/>de <placeName ref="l2562">Prussiae</placeName> ducis voluntate admonitus.</s>
					<s n="7" xml:lang="la">In hoc munere videbis, quid tibi <lb xml:id="p1z14"/>tuisve commodare possim.</s>
					<s n="8" xml:lang="la">Si filius tuus hic mansurus est, non, opinor, pessime <lb xml:id="p1z15"/>suis rationibus consuleret, si iuris nostri rudimenta primo quasi per ludum et iocum <lb xml:id="p1z16"/>cognosceret.</s>
					<s n="9" xml:lang="la">In bibliotheca vestra publica liber est vetus manuscriptus Institutio<lb xml:id="p1z17"/>num sine glossis, cui adiunctus est tractatus, si bene memini, de regulis iuris.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Has institutiones iampridem dixi domino <persName ref="p1283">Gesnero</persName> mihi magnopere fore necessarias; <lb xml:id="p1z19"/>si placet, eas mihi ad aliquot hebdomadas commodare, maximo me beneficio <lb xml:id="p1z20"/>obligabis.</s>
					<s n="11" xml:lang="la">peto abs te, ut hac in re mihi gratific re; liber tibi sartus tectus reddetur.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z21"/>Sed pluribus verbis hoc abs te non peto; tua erga me benevolentia et hum<lb xml:id="p1z22"/>an<lb xml:id="p1z23"/>it<lb xml:id="p1z24"/>a<lb xml:id="p1z26"/>te c<lb xml:id="p1z29"/>on<lb xml:id="p1z30"/>fisus.</s>
					<s n="13" xml:lang="la" ana="farewell">Va<lb xml:id="p1z31"/>le, <lb xml:id="p1z32"/>pate<lb xml:id="p1z33"/>r obs<lb xml:id="p1z34"/>ervand<lb xml:id="p1z35"/>e<lb xml:id="p1z36"/>, <lb xml:id="p1z37"/>et m<lb xml:id="p1z38"/>e, ut f<lb xml:id="p1z39"/>acis<lb xml:id="p1z40"/>, a<lb xml:id="p1z41"/>ma.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z42"/><placeName ref="l491">A<lb xml:id="p1z44"/>rge<lb xml:id="p1z45"/>ntorati</placeName> <lb xml:id="p1z46"/>8. <lb xml:id="p1z47"/>iulii <lb xml:id="p1z48"/>15<lb xml:id="p1z49"/>56.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
