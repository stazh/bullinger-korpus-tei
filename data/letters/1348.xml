	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/><persName ref="p8098">Georg, grave zu Wurttem<lb xml:id="p1z2"/>berg unnd zu Mumpelgartt</persName> etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="de"><lb xml:id="p1z3"/>Unsern grueß zuvor, lieber besonder.</s>
					<s n="3" xml:lang="de">Nachdem <lb xml:id="p1z4"/>ir unns ettlich new zeittung nitt verhaltten, <lb xml:id="p1z5"/>seind unns ettliche alhier zukhummen, wir <lb xml:id="p1z6"/>euch hiebey zuschickhen.</s>
					<s n="4" xml:lang="de">Die wellen unns, noch<lb xml:id="p1z7"/>dem ir die gelesen, widerum zukhummen <lb xml:id="p1z8"/>lossenn.</s>
					<s n="5" xml:lang="de">Wier haben unns alhier in das <lb xml:id="p1z9"/>wasser auch begeben; der lieb gott well gnad <lb xml:id="p1z10"/>geben, das wir im selbigen woͤl heyl unnd <lb xml:id="p1z11"/>glücklich außbaden mögen.</s>
					<s n="6" xml:lang="de">Seydt gott be<lb xml:id="p1z12"/>volhen.</s>
					<s n="7" xml:lang="de">Datum <placeName ref="l515">Urdorff</placeName> den 19ten iulii anno etc. 51.</s>
				</p>
				<p>
					<s n="8" xml:lang="de"><persName ref="p8098">G[eorg] G[rave] z<lb xml:id="p1z13"/>[u] Wyrttemberg</persName> etc.</s>
				</p>
				<p>
					<s n="9" xml:lang="de"><pb/><lb xml:id="p2z1"/>Unnserem lieben, besonndern <persName ref="p495">Heinrich <lb xml:id="p2z2"/>Bullingern</persName>, predigern zu <lb xml:id="p2z3"/><placeName ref="l587">Zürch</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
