	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quae ex <placeName ref="l830">Anglia</placeName> habeo, haec sunt, <placeName ref="l296">Londini</placeName> <lb xml:id="p1z2"/>scripta 8. aprilis: "Pax inter <placeName ref="l832">Gallos</placeName>, <lb xml:id="p1z3"/><placeName ref="l830">Anglos</placeName> et <placeName ref="l2524">Scotos</placeName> hic proclamata est; renuncia<lb xml:id="p1z4"/>tum est potifici penitus, ut nil amplius habeat <lb xml:id="p1z5"/>iuris in <placeName ref="l830">Anglia</placeName>; sed nondum ordinata <lb xml:id="p1z6"/>est religio.</s>
					<s n="3" xml:lang="la">Sedet adhuc parlamentum, <lb xml:id="p1z7"/>id est concilium regni; id est durant etiamnum <lb xml:id="p1z8"/>comicia.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Superioribus diebus disputatum <lb xml:id="p1z9"/>est de tribus articulis: an ecclesia preces <lb xml:id="p1z10"/>et ritus sacramentales peragat, in peregrina lingua, <lb xml:id="p1z11"/>an mutare possit ceremonias pro utilitate fideli<lb xml:id="p1z12"/>um, an missa sit sacrificium pro vivis <lb xml:id="p1z13"/>e<lb xml:id="p1z14"/>t mortuis.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Disputatum est ab 18 delectis; <lb xml:id="p1z15"/>nam utrinque delecti sunt viri 9.</s>
					<s n="6" xml:lang="la">Import<lb xml:id="p1z16"/>unitate episcoporum papisticorum interemptum <lb xml:id="p1z17"/>est colloquium et duo, <placeName ref="l553">Vintoniensis</placeName> et <placeName ref="l1754">Lin<lb xml:id="p1z18"/>colniensis</placeName>, conclusi sunt in carcerem.</s>
					<s n="7" xml:lang="la">Iam agitur <lb xml:id="p1z19"/>de religione.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Spes est optima; optime enim <lb xml:id="p1z20"/>verae religioni volunt regina, nobiles <lb xml:id="p1z21"/>et bona populi pars" etc.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z22"/>Ex comiciis <lb xml:id="p1z23"/><placeName ref="l18">Augustanis</placeName> nihildum habemus certi.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Nunc <lb xml:id="p1z24"/>adfertur ad nos triste nuncium Dusas apud <lb xml:id="p1z25"/>vos igni conflagrasse subiecto a latronibus; <lb xml:id="p1z26"/>expecto a te, quid sit.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Vigilatur hic, in <lb xml:id="p1z27"/>urbe et agro passim contra incendiarios.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z28"/>Dominus liberet nos a malo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vive et <lb xml:id="p1z29"/>vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Commenda me d. legato, cui haec <lb xml:id="p1z30"/>communicabis eundemque amicissime salutabis.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z31"/>Salutabis consules, <persName ref="p2095">Philippum</persName>, <persName ref="p6130">Pontasellam</persName> <lb xml:id="p1z32"/>et <lb xml:id="p1z33"/>amicos.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z34"/><placeName ref="l587">Tiguri</placeName> 6. maii. 1559.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Festin<lb xml:id="p1z35"/>avi ita ut nunquam magis.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z36"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note>[Darunter von der Hand des <persName ref="p8009">Johannes Fabricius</persName>:]</note>
					<s n="19" xml:lang="la"><lb xml:id="p1z37"/>17. maii hae literae mihi primum <lb xml:id="p1z38"/>sunt allatae.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, ministro <lb xml:id="p2z3"/><placeName ref="l98">Curiensis</placeName> ecclesiae fidelissimo, <lb xml:id="p2z4"/>domino et fratri <lb xml:id="p2z5"/>suo colendissimo et charissimo.</s>
					<s n="21" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
