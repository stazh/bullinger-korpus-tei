	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Concessit ad superos postridie, uti divinaram,<note xml:id="fn1" type="footnote" n="1">Vgl. <ref target="file13090">Nr. 3041</ref>,<ptr target="qvzl17311-6" type="qv"/>. - Zu <persName ref="p473">Heinrich Buchters</persName> Todesdatum s. <ref target="file13090">Nr. 3041</ref>, <ptr target="qvfn17311-1" type="qv"/>.</note> <lb xml:id="p1z2"/>d. <persName ref="p473">Buchterus</persName> in vera fidei confessione.</s>
					<s n="3" xml:lang="la">Sepultum <lb xml:id="p1z3"/>invenit filius.<note xml:id="fn2" type="footnote" n="2"><persName ref="p19845">Johannes Buchter</persName>.</note></s>
					<s n="4" xml:lang="la">Reliquit liberos in summa 7.</s>
					<s n="5" xml:lang="la">Ego <lb xml:id="p1z4"/>de magistratus beneficentia bene spero.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="6" xml:lang="la">Rediit <placeName ref="l18">Augusta</placeName> <lb xml:id="p1z5"/><persName ref="p8018">Hallerus</persName> salvus et incolumis.<note xml:id="fn3" type="footnote" n="3"><persName ref="p8018">Johannes Haller</persName> war am 12. oder 13. Oktober nach <placeName ref="l587">Zürich</placeName> zurückgekehrt; s. <ref target="file13066">Nr. 3017</ref>, <ptr target="qvfn17285-4" type="qv"/>.</note></s>
					<s n="7" xml:lang="la">Multi di<lb xml:id="p1z6"/>vinant ipsum <persName ref="p473">Buchtero</persName> surrogandum fore.<note xml:id="fn4" type="footnote" n="4"><persName ref="p473">Buchter</persName> war seit September 1545 zweiter Prediger (Archidiakon) am Großmünster gewesen; s. <bibl source="b1">HBBW I</bibl> 124, Anm. 1; XV 481f, Anm. 12.</note></s>
					<s n="8" xml:lang="la">Dominus eum n<lb xml:id="p1z7"/>obis det, quem novit ecclesi<lb xml:id="p1z8"/>ae suae esse utilem.<note xml:id="fn5" type="footnote" ana="bio" n="5"><persName ref="p495">Bullinger</persName> scheint also von der durch <persName ref="p1804">Jodocus Kilchmeyer</persName> bewirkten und ihm von diesem mit Brief <ref target="file13085">Nr. 3036</ref> mitgeteilten Berufung <persName ref="p8018">Hallers</persName> nach <placeName ref="l41">Bern</placeName> nicht viel gehalten zu haben.<ptr target="zfnfn17322-3" type="zfn"/></note></s>
					<s n="9" xml:lang="la"><lb xml:id="p1z9"/>Mira refert <persName ref="p8018">Hallerus</persName>, quae scribere non possum.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z10"/>Sunt multi fideles et rursus hypocritae multi <lb xml:id="p1z11"/>in aula caesaris<note xml:id="fn6" type="footnote" n="6"><persName ref="p18538">Karl V.</persName></note> et in ipsa urbe <placeName ref="l18">Augusta</placeName>, etc.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z12"/>Non intelligis, cum quibus foedus petat <persName ref="p8112">Gallus</persName>!<note xml:id="fn7" type="footnote" n="7">König <persName ref="p8112">Heinrich II.</persName> von <placeName ref="l832">Frankreich</placeName>. - <persName ref="p495">Bullinger</persName> bezieht sich hier auf <ref target="file13095">Nr. 3046</ref>,<ptr target="qvzl17315-2" type="qv"/>.</note></s>
					<s n="12" xml:lang="la">Mire!</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z13"/>Mirum sane te hoc non intelligere, cum <lb xml:id="p1z14"/>intelligas, quod mox sequitur:<note xml:id="fn8" type="footnote" n="8">Nämlich in <ref target="file13095">Nr. 3046</ref>,<ptr target="qvzl17315-3" type="qv"/>.</note> <persName ref="p19981">Papae</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p19981">Paul III.</persName></note> nos esse foederatos, <lb xml:id="p1z15"/>si <persName ref="p8112">Gallo</persName> connectamur!</s>
					<s n="14" xml:lang="la">Quinam isti „nos?“</s>
					<s n="15" xml:lang="la"><placeName ref="l862">Helvetii</placeName>!</s>
					<s n="16" xml:lang="la">Ergo cum <lb xml:id="p1z16"/><placeName ref="l587">Tigurinis</placeName>, <placeName ref="l41">Bernatibus</placeName>, <placeName ref="l2448">Quinqu<lb xml:id="p1z17"/>e <lb xml:id="p1z18"/>Pagicis</placeName>, <placeName ref="l176">Claronensibus</placeName>, <placeName ref="l28">Basiliensibus</placeName>, etc., petit foedus, et <lb xml:id="p1z19"/>novum quidem foedus!</s>
					<s n="17" xml:lang="la">Fatetur interim vetus illud <lb xml:id="p1z20"/>duraturum alias 3 annis a morte patris.<note xml:id="fn10" type="footnote" n="10"><persName ref="p20225">Franz I.</persName>, verstorben am 31. März 1547. - Zum Soldbündnis mit <placeName ref="l832">Frankreich</placeName> s. <ref target="file13025">Nr. 2976</ref>, <ptr target="qvfn17242-1" type="qv"/>.</note></s>
					<s n="18" xml:lang="la">Ideo <lb xml:id="p1z21"/>vero <placeName ref="l832">Gallo</placeName> nexos papae sotios<note xml:id="fn11" type="footnote" n="11">= socios.</note> esse arbitror, quod <lb xml:id="p1z22"/>syncretismus<note xml:id="fn12" type="footnote" n="12">Vereinbarung; s. <bibl source="b353">Kirsch</bibl> 2783.</note> esse videatur inter papam et <placeName ref="l832">Gallum</placeName>.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z23"/>Nam in literis ad senatum nostrum <ptr target="fna" type="footnote" n="a"/>a regio <persName ref="p4620">legato</persName><note xml:id="fna" type="footnote" n="a"><hi>Am Rande nachgetragen.</hi></note><note xml:id="fn13" type="footnote" n="13">Gemeint ist der <placeName ref="l832">französische</placeName> Gesandte <persName ref="p4620">Louis Daugerant, Seigneur de Boisrigaut</persName>. Zu dessen hier erwähntem Schreiben s. <ref target="file13090">Nr. 3041</ref>, <ptr target="qvfn17311-2" type="qv"/>.</note> missis quaeritur <lb xml:id="p1z24"/>misere confossum esse <persName ref="p4758">Petrum Aloysium</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p4758">Pièr Luigi Farnese</persName>; s. <ref target="file13013">Nr. 2964</ref>, <ptr target="qvfn17229-4" type="qv"/>.</note>, innocentem<note xml:id="fn15" type="footnote" n="15">Ein von <persName ref="p495">Bullinger</persName> hinzugefügter ironischer Kommentar. - Vgl. <ref target="file13069">Nr. 3020</ref>,<ptr target="qvzl17288-10" type="qv"/>.</note> <lb xml:id="p1z25"/>scilicet hominem, si diis placet.</s>
					<s n="20" xml:lang="la">Verum mihi crede<note xml:id="fnb" type="footnote" n="b"><hi>In der Vorlage</hi> credi.</note>, <lb xml:id="p1z26"/><persName ref="p8418">Myconi</persName>, perituros nos, si fiduciam nostram <lb xml:id="p1z27"/>collocaverimus in <lb xml:id="p1z28"/>regem illum Aegypti<note xml:id="fn16" type="footnote" n="16">Vgl. <cit type="bible"><ref>Jes 30, 1-3</ref></cit>; <cit type="bible"><ref>31, 1</ref></cit>. - Gemeint ist <placeName ref="l832">Frankreich</placeName>; vgl. <bibl source="b22">HBBW XIX</bibl> 121,59; 123,20.</note> et in foe<lb xml:id="p1z29"/>dera carnalia.<note xml:id="fn17" type="footnote" n="17">Vgl. <cit type="bible"><ref>Jer 17, 5.</ref></cit> - Vgl. diesen Satz mit <ref target="file13097">Nr. 3048</ref>,<ptr target="qvzl17317-2" type="qv"/>.</note></s>
					<s n="21" xml:lang="la">Beatus, qui spem suam in deo collocat,<note xml:id="fn18" type="footnote" n="18"><cit type="bible"><ref>Ps 40 (Vulg. 39), 5.</ref></cit></note> <lb xml:id="p1z30"/>iusta quoque media non contemnit,<note xml:id="fn19" type="footnote" n="19">Unter anderem die Hilfe der <placeName ref="l3259">Innerschweizer</placeName>; vgl. nämlich <ref target="file13033">Nr. 2984</ref>,<ptr target="qvzl17249-4" type="qv"/>; <ref target="file13114">Nr. 3065</ref>,<ptr target="qvzl17331-2" type="qv"/>.</note> iniusta <lb xml:id="p1z31"/>abominatur.<note xml:id="fn20" type="footnote" n="20">Vgl. <cit type="bible"><ref>Dtn 25, 16</ref></cit>.</note></s>
					<s n="22" xml:lang="la">Haec ad tua paucis.<pb type="edition" next="586"/></s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="23" xml:lang="la">Iam vero in<lb xml:id="p1z32"/>fausti nuncii tibi <lb xml:id="p1z33"/>nuncius sum: <placeName ref="l257">Constantienses</placeName> <lb xml:id="p1z34"/>artibus <persName ref="p7706">Granvellae</persName><note xml:id="fn21" type="footnote" n="21"><persName ref="p7706">Nicolas de Perrenot, Herr von Granvelle</persName>. - <persName ref="p495">Bullinger</persName> erfuhr das hier Mitgeteilte aus dem Brief des <placeName ref="l257">Konstanzer</placeName> Rats an den <placeName ref="l587">Zürcher</placeName> Rat vom 22. Oktober; s. <ref target="file13102">Nr. 3053</ref>, <ptr target="qvfn17321-1" type="qv"/>. Dieses Schreiben war <persName ref="p495">Bullinger</persName> bereits von <persName ref="p8055">Blarer</persName> mit <ref target="file13100">Nr. 3051</ref>,<ptr target="qvzl17320-1" type="qv"/>, angekündigt worden.</note> capti, utinam non daementati!<note xml:id="fn22" type="footnote" n="22">Zur Schreibweise vgl. <bibl source="b5">HBBW III</bibl> 243,28; 244,53; VI 384,18.</note></s>
					<s n="24" xml:lang="la">Iam <lb xml:id="p1z35"/>incipiunt consultare de reconciliatione cum caesare.</s>
					<s n="25" xml:lang="la"><lb xml:id="p1z36"/>Certum est, quod scribo.</s>
					<s n="26" xml:lang="la">Constanter illi quidem <lb xml:id="p1z37"/>animo conceperunt nolle se quicquam recipere, quod <lb xml:id="p1z38"/>deo, religioni, incolumitati reipublicae, adde et <lb xml:id="p1z39"/>vicinis, adversum sit.</s>
					<s n="27" xml:lang="la">Verum illi postulant.</s>
					<s n="28" xml:lang="la">Cae<lb xml:id="p1z40"/>saris est dare.</s>
					<s n="29" xml:lang="la">Dabit is, quod placuerit.</s>
					<s n="30" xml:lang="la">Ac <lb xml:id="p1z41"/>periculum est, ne liberalis sit in promittendo, parcus <lb xml:id="p1z42"/>in praestando.</s>
					<s n="31" xml:lang="la">Ora pro ipsis dominum (amplis<lb xml:id="p1z43"/>simo senatui vestro haec omnia ad longum perscribuntur)<note xml:id="fnc" type="footnote" n="c"><hi>Klammern ergänzt.</hi></note>.<note xml:id="fn23" type="footnote" n="23">Gemeint ist das in <ref target="file13102">Nr. 3053</ref>, <ptr target="qvfn17321-3" type="qv"/>, erwähnte Rundschreiben der <placeName ref="l587">Zürcher</placeName> vom 25. Oktober. Die Ausfertigung für <placeName ref="l28">Basel</placeName> ist in Basel StA, Städte und Dörfer CK 18.1, erhalten; s. <bibl>Henrich, Myconius BW</bibl> 997.<ptr target="zfnfn17322-1" type="zfn"/></note></s>
					<s n="32" xml:lang="la"><lb xml:id="p1z44"/>Optimi apud ipsos optime sperant.</s>
					<s n="33" xml:lang="la">Deus faxit, <lb xml:id="p1z45"/>ut bona consequantur.</s>
					<s n="34" xml:lang="la">Plu<lb xml:id="p1z46"/>ra iam non <lb xml:id="p1z47"/>possum.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="35" xml:lang="la" ana="salute">Vale u<lb xml:id="p1z48"/>na cum <persName ref="p8032">Dryandro</persName><note xml:id="fn24" type="footnote" n="24"><persName ref="p8032">Francisco de Enzinas</persName>.</note>, <persName ref="p8126">Oporino</persName>, <persName ref="p1278">Gastio</persName>, <persName ref="p714">Coelio</persName><note xml:id="fn25" type="footnote" n="25"><persName ref="p714">Celio Secondo Curione</persName>.</note> et <lb xml:id="p1z49"/>aliis bonis, quos omnes ex me salutabis.</s>
					<s n="36" xml:lang="la">25. octobris 1547.</s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="37" xml:lang="la"><pb type="scan" next="180v."/>Dic d. <persName ref="p1278">Gastio</persName> adesse tabellione<pb/><lb xml:id="p2z1"/>m<note xml:id="fn26" type="footnote" n="26">Der <placeName ref="l587">Zürcher</placeName> Stadtbote <persName ref="p18349">Thomas Binzmüller</persName>, der den oben in Z. <ptr target="qvzl17322-1" type="qv"/> erwähnten Brief des <placeName ref="l587">Zürcher</placeName> Rates zusammen mit <persName ref="p495">Bullingers</persName> vorliegendem Brief nach <placeName ref="l28">Basel</placeName> befördert hatte; s. Zürich StA, F III 32, Seckelamtsrechnungen 1547/48, S. 53, der Abteilung "Laufende Boten".<ptr target="zfnfn17322-2" type="zfn"/></note>, si forte respondeat ad literas meas<note xml:id="fn27" type="footnote" n="27">Ein nicht erhaltener Brief <persName ref="p495">Bullingers</persName>, der etwa um den 5. Oktober verfasst gewesen sein müsste und <persName ref="p1884">Ludwig Lavater</persName> (s. weiter unten) mitgegeben worden war.<ptr target="zfnfn17322-4" type="zfn"/></note> <lb xml:id="p2z2"/>per <persName ref="p1884">Lavaterum</persName><note xml:id="fn28" type="footnote" n="28"><persName ref="p1884">Ludwig Lavater</persName>; s. <ref target="file13081">Nr. 3032</ref>,<ptr target="qvzl17301-4" type="qv"/>; <ref target="file13084">Nr. 3035</ref>,<ptr target="qvzl17304-6" type="qv"/>.</note> missas.</s>
				</p>
				<p>
					<note type="signature">[Ohne Unterschrift.]</note>
				</p>
				<p>
					<note type="address">[Adresse darunter:]</note>
					<s n="38" xml:lang="la">D. <persName ref="p8418">Osvaldo Myconio</persName>, suo c<lb xml:id="p2z3"/>harissimo fratri, <foreign xml:lang="de">zuͦ <placeName ref="l28">Basel</placeName> <lb xml:id="p2z4"/>predicanten.<note xml:id="fn29" type="footnote" n="29">Vorliegender Brief wurde mit dem oben in <ptr target="qvfn17322-2" type="qv"/> identifizierten <placeName ref="l587">Zürcher</placeName> Stadtboten nach <placeName ref="l28">Basel</placeName> übermittelt.</note></foreign></s>
				</p>
			</div>
		</body>
	</text>
</TEI>