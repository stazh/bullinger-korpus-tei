			<zone xml:id="p4z8-0" points="528,1879 641,1852 775,1867 863,1836 1007,1846 1028,1841 1029,1795 923,1803 863,1767 791,1772 749,1800 708,1772 629,1802 529,1801">534,1835 560,1834 586,1832 612,1830 638,1828 665,1827 691,1826 717,1826 743,1824 769,1823 796,1821 822,1821 848,1823 874,1823 900,1823 927,1823 953,1823 979,1823 1005,1823 1032,1823</zone>
