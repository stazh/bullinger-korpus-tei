	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Salvus et incolumis ad meos sum reversus; <lb xml:id="p1z2"/>inveni ipsos quoque salvos per domini gratiam.</s>
					<s n="3" xml:lang="la">Vobis <lb xml:id="p1z3"/>omnibus pro humanitate ac benficentia vestra <lb xml:id="p1z4"/>magnas habeo gratias.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Utinam te quoque hic aliquando <lb xml:id="p1z5"/>conspicere et ea tibi, quę in me perpetuo confers <lb xml:id="p1z6"/>beneficia, referre queam.</s>
					<s n="5" xml:lang="la">Octiduo postquam redii, uxor <lb xml:id="p1z7"/>mea septima me nunc prole donavit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Alias nihil <lb xml:id="p1z8"/>est, quod nunc scribam; silent enim mirifice omnia, neque <lb xml:id="p1z9"/>quicquam fertur novi, nisi quod quidam nescio quid <lb xml:id="p1z10"/>de pacificatione inter Caesarem et <persName ref="p8112">Gallum</persName> quadam muss<lb xml:id="p1z11"/>itant.</s>
					<s n="7" xml:lang="la">Quae si procedat, una cum <persName>regno Anglia<lb xml:id="p1z12"/>e</persName> ecclesiae quoque nostrae periclitabuntur.</s>
					<s n="8" xml:lang="la">Dominus <lb xml:id="p1z13"/>adsit nobis sua gratia et dissipet consilia malignantium.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z14"/>Amen.</s>
					<s n="10" xml:lang="la">Salvi sint tui omnes una cum fratribus nostris <lb xml:id="p1z15"/>charissimis.</s>
					<s n="11" xml:lang="la" ana="salute">Nostri omnes te salutant.</s>
					<s n="12" xml:lang="la"><placeName ref="l167">Genevę</placeName> a qui<lb xml:id="p1z16"/>busdam contraverti audio, an excommunicatorum in<lb xml:id="p1z17"/>fantes baptizari debeant necne; sic semper novi <lb xml:id="p1z18"/>aliquid ex illa <placeName ref="l2549">Africa</placeName>.</s>
					<s n="13" xml:lang="la"><placeName ref="l41">Bernae</placeName> 6. iunii 1554.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z19"/>Has literas mittes iis, ad quos pertinent, oro.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z20"/>Tuus <persName ref="p8018">I[oannes] Hallerus</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino ac compatri suo plurimum <lb xml:id="p2z5"/>colendo.</s>
				</p>
				<p>
					<s n="17" xml:lang="de"><lb xml:id="p2z6"/>M. <persName ref="p495">Heinrych <lb xml:id="p2z7"/>Bullingern</persName> zuͦ <lb xml:id="p2z8"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
