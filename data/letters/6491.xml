	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a deo patre nostro eiusque filio, domino nostro Ie<lb xml:id="p1z2"/>su Christo et spiritu paracleto etc.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Quum certum sit nihil intolerabilius esse apud deum et homines pios <lb xml:id="p1z4"/>ingratitudine et perfidia, quam ob rem ne et ipse huius vitii cum opprobrio <lb xml:id="p1z5"/>nominis christiani accuser, quod deus avertat, sollicitabar a multo <lb xml:id="p1z6"/>tempore, viri doctissimi praestantissimique solvere p[raest].</s>
					<s n="3" xml:lang="la">v[estris] peccuniam, <lb xml:id="p1z7"/>pro qua meam fidem apud vos interposui, quam <persName>Petrus Sebastianus Tar<lb xml:id="p1z8"/>nowius</persName> noster, dum isthic peregrinabatur mutuo acceperat, quadragint<lb xml:id="p1z9"/>a videlicet Ioachimicorum apud p[raest].</s>
					<s n="4" xml:lang="la">v[estras] relicto manu mea scripto chirograp<lb xml:id="p1z10"/>ho.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Verum cum nulla ratione id efficere potuerim, quod volui, propter inopiam <lb xml:id="p1z11"/>fidelium et certorum tabellariorum vel literas saltem p[raest].</s>
					<s n="6" xml:lang="la">v[estris] transmittere <lb xml:id="p1z12"/>quiverim, nunc demum serius quidem, quam par est, mitto illud <lb xml:id="p1z13"/>ipsum argentum habeoque, ago et habiturus acturusque sum gratias pro <lb xml:id="p1z14"/>hoc officio tantaque beneficentia hominibus christianis dignissima P. V. <lb xml:id="p1z15"/>At quo certus sim redditam p[raest].</s>
					<s n="7" xml:lang="la">v[estris] esse, litteris mihi quam primum significari <lb xml:id="p1z16"/>a p[raest].</s>
					<s n="8" xml:lang="la">v[estris] velim.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Ego vero et, qui mecum hic sunt christiani, <lb xml:id="p1z17"/>curae meae concrediti tanti beneficii memores et apud deum et apud <lb xml:id="p1z18"/>homines, quoad vixerimus, erimus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Bene e<lb xml:id="p1z19"/>t felic<lb xml:id="p1z20"/>iter valere p[r<lb xml:id="p1z21"/>aest].</s>
					<s n="11" xml:lang="la">v[estras] omnes percupimus.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/>Amen.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Ex oppido <placeName ref="l2472">Poloniae</placeName> <placeName ref="l933">Radzieiow</placeName> iunii 22. <lb xml:id="p1z23"/>anno 1565.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z24"/>Praestantiarum vestrarum <lb xml:id="p1z25"/>studiosissimus <lb xml:id="p1z26"/><persName>Andreas Prasmovius</persName>, <lb xml:id="p1z27"/>pastor ecclesię <placeName ref="l933">Radzie<lb xml:id="p1z28"/>viensis</placeName> m[anu] p[ropria].</s>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimis et doctissimis <lb xml:id="p2z2"/>viris in ecclesia <placeName ref="l587">Tigurina</placeName> <lb xml:id="p2z3"/>verbi dei fideliss. ad<lb xml:id="p2z4"/>ministris, fratribus et <lb xml:id="p2z5"/>dominis summa observantia <lb xml:id="p2z6"/>colendis<lb xml:id="p2z7"/>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l587">Tiguri</placeName> in <placeName ref="l862">Helvetia</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>