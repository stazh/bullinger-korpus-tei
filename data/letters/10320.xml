	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">De quinque illis<note xml:id="fn1" type="footnote" n="1">Wie aus <persName ref="p495">Bullingers</persName> Antwort vom 4. Dezember (unten <ref target="file10324">Nr. 293</ref>) hervorgeht, handelt es sich um die in <placeName ref="l300">Luzern</placeName> versammelten geheimen Boten der <placeName ref="l2448">V Orte</placeName>, über welche <persName ref="p8418">Myconius</persName> Genaueres wissen will.</note>, qui omnia excipiunt atque inde consultant, velim fieri certior, an<note xml:id="fna" type="footnote" n="a"><hi>von</hi> an <hi>bis</hi> tentent <hi>am Rande nachgetragen.</hi></note> a<lb xml:id="p1z2"/>dhuc sint, qui sint, quid tentent<note xml:id="fnb" type="footnote" n="b"><hi>von</hi> an <hi>bis</hi> tentent <hi>am Rande nachgetragen.</hi></note>.</s>
					<s n="3" xml:lang="la">Opus est.</s>
					<s n="4" xml:lang="la">Quamobrem vide, quicquid potes, exquiras.</s>
					<s n="5" xml:lang="la">Laborem <lb xml:id="p1z3"/>non frustra insumpseris.</s>
					<s n="6" xml:lang="la">Intelligis, quid velim: nihil aliud certe, <lb xml:id="p1z4"/>quam quod <persName ref="p8320">Dasipodio</persName> commendasti in sinum mihi.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Caeterum non nihil est, <lb xml:id="p1z5"/>quod de <placeName ref="l425">Roma</placeName> scripsisti<note xml:id="fn2" type="footnote" n="2">Oben S. 232, 22.</note>.</s>
					<s n="8" xml:lang="la">Tumultus fuit ob navigationem papae<note xml:id="fn3" type="footnote" n="3">Gemeint ist die Seereise des Papstes <persName ref="p18451">Clemens VII.</persName> nach <placeName ref="l1176">Marseille</placeName>, s. oben <ref target="file10307">[Nr. 276]</ref> S. 211, Anm. 4.</note>, in <lb xml:id="p1z6"/>quo cardinales Franco faventes perierunt, quamvis alter veneno<note xml:id="fn4" type="footnote" n="4">Gemeint sind wohl die Todesfälle des päpstlichen Geheimsekretärs <persName ref="p6363">Jacopo Salviati</persName> vom 6. September und von Kardinal <persName ref="p17800">Antonio Ciocchi del Monte</persName> vom 20. September (s. <bibl source="b477">Pastor</bibl> IV/2 478). Die dramatischen Begleitumstände, mit denen die ohnehin ungenaue Nachricht ausgeschmückt ist, lassen sich allerdings nicht nachweisen.</note>.</s>
					<s n="9" xml:lang="la">Tum di<lb xml:id="p1z7"/>reptus est vicus omnino.</s>
					<s n="10" xml:lang="la">Ratum est apud caesarianos papam nunquam <lb xml:id="p1z8"/>recipiendum deinceps.</s>
					<s n="11" xml:lang="la">Quod ita erit, nisi caesar persuadeatur a papa, <lb xml:id="p1z9"/>quod concordiam sic inter ipsum et regem <placeName ref="l832">Gallorum</placeName> per exitum ab <placeName ref="l834">Italia</placeName> <lb xml:id="p1z10"/>moliatur.</s>
					<s n="12" xml:lang="la">Haec nobilis quidam<note xml:id="fn5" type="footnote" n="5">Unbekannt.</note>, qui papam sequutus est ad classem us<lb xml:id="p1z11"/>que.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vale cum <persName ref="p8051">uxore</persName><note xml:id="fn6" type="footnote" ana="bio" n="6"><persName ref="p8051">Anna Bullinger, geb. Adlischwyler</persName>.</note> et <persName ref="p3242">Utingero</persName>.</s>
					<s n="14" xml:lang="la">Rescribe quam ocyssime.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z12"/><placeName ref="l28">Basileae</placeName>, 23. novembris anno 33.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><persName ref="p8418">Os. <lb xml:id="p1z13"/>Myco<lb xml:id="p1z14"/>nius</persName> <lb xml:id="p1z15"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="17" xml:lang="de"><pb/><lb xml:id="p2z1"/>An den wolgelerten herren <lb xml:id="p2z2"/>herr <persName ref="p495">Heinrich Bullinger</persName>, predi<lb xml:id="p2z3"/>canten zuͦ <placeName ref="l587">Zürich</placeName>, sinem <lb xml:id="p2z4"/>lieben und günstigen bruͦder.</s>
				</p>
			</div>
