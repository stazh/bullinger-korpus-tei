	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salutem in Christo.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Mittimus isthuc <placeName ref="l830">Anglum</placeName> <lb xml:id="p1z2"/>cum birria; venturi et ipsi sumus, si audiamus <lb xml:id="p1z3"/>eum vivere.</s>
					<s n="3" xml:lang="la">Itaque quo celerius sciremus, placuit <lb xml:id="p1z4"/>expeditum hunc internuncium praemittere cum equo <lb xml:id="p1z5"/>conductitio; nam plures conducere non licuit.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Quaeso ut iubeas hunc iterum ad nos, si <persName ref="p1183">Frenshamus</persName> <lb xml:id="p1z7"/>vivit, maturare.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><placeName ref="l2">Aroviae</placeName> birria <lb xml:id="p1z8"/>facilius et vicinius erit vobis parabilis, <lb xml:id="p1z9"/>si opus fuerit.</s>
					<s n="6" xml:lang="la">D. Iesus, omnis salutis fons, <lb xml:id="p1z10"/>nos ad gloriam ipsius custodiat!</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Maii 6, <lb xml:id="p1z11"/>id est postridie quam literae huc vestrae perlatae s<lb xml:id="p1z12"/>unt.</s>
					<s n="8" xml:lang="la"><placeName ref="l28">Basileae</placeName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Tuus in Christo, <persName ref="p1145">I. Foxus</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro<lb xml:id="p2z2"/>, d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
