	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, vir clarissime.</s>
					<s n="2" xml:lang="la">Praefectus huius urbis diligenter <lb xml:id="p1z2"/>investigavit de <persName>Beato</persName> illo vestrate et <lb xml:id="p1z3"/>tandem misit ad me eam schedulam, quam <lb xml:id="p1z4"/>hic videbis; boni consule, si prius non <lb xml:id="p1z5"/>potui.</s>
					<s n="3" xml:lang="la">Has <placeName ref="l291">Lindavium</placeName> mitto, unde <lb xml:id="p1z6"/>ad te mittantur.</s>
					<s n="4" xml:lang="la">Omnia hic recte, <lb xml:id="p1z7"/>nisi quod frigemus nimium.</s>
					<s n="5" xml:lang="la">Deus solem <lb xml:id="p1z8"/>suum illum, illum alium faciat ori<lb xml:id="p1z9"/>ri <lb xml:id="p1z10"/>super nos, qui nos intus calfaciat.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ubi <lb xml:id="p1z11"/>nactus fuero certum nuncium, mittam <lb xml:id="p1z12"/>ad te quaedam manuscripta, quae scio <lb xml:id="p1z13"/>te libenter visurum <persName ref="p495">Hen[rici] Bull[ingere]</persName>.</s>
					<s n="7" xml:lang="la">Comitia <lb xml:id="p1z14"/>non sunt futura.</s>
					<s n="8" xml:lang="la"><persName ref="p18554">Regina An<lb xml:id="p1z15"/>gliae</persName> abiecit titulum, quo initio utebatur <lb xml:id="p1z16"/>primum caput p[os]t Christum <persName>regni Angliae</persName> <lb xml:id="p1z17"/>et publica autoritate restituit prorsus <lb xml:id="p1z18"/>sacra antichristi.</s>
					<s n="9" xml:lang="la">Credimus Cesarem in suas <lb xml:id="p1z19"/><placeName ref="l875">Hispanias</placeName> mox rediturum et <persName ref="p8371">Alber<lb xml:id="p1z20"/>tum</persName> rursus emersum e latebris contra <lb xml:id="p1z21"/>pffafos.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale et ora pro me <lb xml:id="p1z22"/>cum tota familia, schola atque ecclesia.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z23"/>Quispiam canonista in publica schola <lb xml:id="p1z24"/>in promotione 13 magistrorum dixit <lb xml:id="p1z25"/>se eos promovere autoritate papae; ego <lb xml:id="p1z26"/>publice reclamavi non decere; deinde in<lb xml:id="p1z27"/>dignatio et zelus ille extorsit a me <pb/><lb xml:id="p2z1"/>hos versus, quos misi homini ferventi <lb xml:id="p2z2"/>cum omnibus illius farinae viris non <lb xml:id="p2z3"/>paucis.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z4"/>Bellua cum nobis <placeName>Tyberina</placeName> ignota fuisset, <lb xml:id="p2z5"/>Fundavit falsam in relligione scholam;</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z6"/>Quae postquam lucem Christi conspexit obortam, <lb xml:id="p2z7"/>Monstrum illud misit prorsus in exilium<lb xml:id="p2z8"/>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z9"/>At tu cur revocas, cur non sinis, ut suo <placeName ref="l425">Romae</placeName> <lb xml:id="p2z10"/>Lustra atque antra colat bellua pestifera?</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z11"/><placeName ref="l512">Tubingae</placeName> 11. februarii 1554.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z12"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z13"/>[<pb/><lb xml:id="p4z1"/>C]larissimo viro domino [<lb xml:id="p4z2"/><persName ref="p495">H]enrico Bullingero</persName>, <lb xml:id="p4z3"/><placeName ref="l587">[T]igurinae</placeName> ecclesiae <lb xml:id="p4z4"/>pastori.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p4z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
