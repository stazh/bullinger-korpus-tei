	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Simulatque me D. <persName ref="p1553">Hochholtzero</persName> adeoque D. <persName ref="p8018">Hallero</persName> <lb xml:id="p1z3"/>commendaveras, nolo te lateat scholę <placeName>Aroviensi</placeName> paulo ante meum <persName>[Li<lb xml:id="p1z4"/>enhard</persName> <persName>Meyer?</persName>] adventum pręfectum quendam <placeName ref="l28">Basiliensem</placeName> <lb xml:id="p1z5"/>iuvenem.</s>
					<s n="3" xml:lang="la">Itaque ego <placeName ref="l41">Bernam</placeName> profectus a fratribus <lb xml:id="p1z6"/>magistratui commendatus sum.</s>
					<s n="4" xml:lang="la">Magistratus porro ad <lb xml:id="p1z7"/>primam occasionem se mihi prospecturum pollicitus <lb xml:id="p1z8"/>est; D. <persName ref="p8018">Hallerus</persName> autem literas vocationis meę ad <lb xml:id="p1z9"/>te missurum recepit.</s>
					<s n="5" xml:lang="la">Proinde rogo te, domine mi, <lb xml:id="p1z10"/>ut reliquis tuis in me beneficiis hoc addas: si <lb xml:id="p1z11"/>pervenerint ad te literę, mihi quamprimum vel <lb xml:id="p1z12"/><placeName ref="l50">Episcopicellam</placeName> vel <placeName ref="l257">Constantiam</placeName> ad fratrem meum <persName>Lütfrid <lb xml:id="p1z13"/>Jung</persName> vocatum perferri cures.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Dominus et te et <lb xml:id="p1z14"/>ecclesiam vestram una cum familia tua in sua pace <lb xml:id="p1z15"/>conservet.</s>
					<s n="7" xml:lang="la">Hęc paucis ad te in presens ex <lb xml:id="p1z16"/>itinere; alias fusius scribendi dabitur (spero) oportunitas.</s>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z17"/>Bene vale.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l21">Badenę</placeName> 3a iulii 1549.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p1754">Iohannes Iung</persName> nunc Episcopalicellę.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praeclaro <placeName ref="l587">Tigurinę</placeName> ecclesię <lb xml:id="p2z2"/>antistiti D. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>domino suo observandissimo.</s>
				</p>
			</div>
		</body>
