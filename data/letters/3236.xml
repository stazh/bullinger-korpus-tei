	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Existimavi ultimis ad te literis meis abunde <lb xml:id="p1z3"/>tibi esse satisfactum; sed tu alteras scribis et stu<lb xml:id="p1z4"/>diose expetis, ut respondeam ad quaestion<lb xml:id="p1z5"/>es abs <lb xml:id="p1z6"/>te mihi propositas.</s>
					<s n="2" xml:lang="la"><persName ref="p3375">Vergerium</persName> enim, hominem callidum, elicuisse <lb xml:id="p1z7"/>a me verba quaedam, quibus subvertat <persName ref="p714">Coelium</persName>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z8"/>Ego vero inservire tibi promtus sum semper et semper <lb xml:id="p1z9"/>talem me tibi exhibui, qualem decet amicum et <lb xml:id="p1z10"/>fratrem.</s>
					<s n="4" xml:lang="la">Nunc vero, cum subolfaciam ideo a me <lb xml:id="p1z11"/>exigi responsionem novam, ut illa in conflictu cum <persName ref="p3375">Vergeri<lb xml:id="p1z12"/>o</persName> <lb xml:id="p1z13"/>proferatur, ego vero nolim ullo modo ministrari <lb xml:id="p1z14"/>meum nomen ei concertationi, nihil aliud mihi <lb xml:id="p1z15"/>respondendum esse video, quam quod vera respondi ultimis i<lb xml:id="p1z16"/>llis meis literis.</s>
					<s n="5" xml:lang="la">Nulla ex me verba elicuit <persName ref="p3375">Vergerius</persName>, <lb xml:id="p1z17"/>quae tendant ad coelii subversionem, nisi ea, <lb xml:id="p1z18"/>quae ultimis meis <lb xml:id="p1z19"/>exposui, ad tui subversionem <lb xml:id="p1z20"/>tend<lb xml:id="p1z21"/>ere existimes.</s>
					<s n="6" xml:lang="la">Ergo <lb xml:id="p1z22"/>non <lb xml:id="p1z23"/>est, quod ad tuas illas quaestiones respondeam, <lb xml:id="p1z24"/>cum nihil aliud de tuo illo libro aut dixerim <lb xml:id="p1z25"/>aut scripserim unquam quam illud ipsum, quod expo<lb xml:id="p1z26"/>sui tibi ultimis iam sae<lb xml:id="p1z27"/>pe citatis literis meis.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z28"/>Tu quidem dicis: "Te quidem suasisse, ne ederem, scio; haec, <lb xml:id="p1z29"/>inquam, sunt vetera, nova iam sunt omnia."</s>
					<s n="8" xml:lang="la">Ego vero praeter <lb xml:id="p1z30"/>vetera nulla agnosco, nova... nolo ac doleo novam <lb xml:id="p1z31"/>existere content<lb xml:id="p1z32"/>ionem inter eos <lb xml:id="p1z33"/>qui ex... fratres et eiusdem gentis aliquando fuerunt.</s>
					<s n="9" xml:lang="la">Si tu consilio meo obseq<lb xml:id="p1z34"/>utus non edidisses disputationem illa<lb xml:id="p1z35"/>m tuam, iam quoque facile hac careres molestia.</s>
					<s n="10" xml:lang="la">Vol<lb xml:id="p1z36"/>uit offerre partem Apologiae tuae <persName ref="p8101">Laelius</persName> <lb xml:id="p1z37"/>noster; sed nondum accepi, <lb xml:id="p1z38"/>nondum legi, maxime quod tunc, cum offerret, <lb xml:id="p1z39"/>aliquot <lb xml:id="p1z40"/>dies in urbe <lb xml:id="p1z41"/>non <lb xml:id="p1z42"/>futurus eram, in qu<lb xml:id="p1z43"/>am heri dem<lb xml:id="p1z44"/>um redii.</s>
					<s n="11" xml:lang="la">Legam autem, ubi posthac mihi obtulerit et per negotia mea licue<lb xml:id="p1z45"/>rit.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z46"/>Satis alioqui et plus satis est contentionum altercationum<lb xml:id="p1z47"/>que <lb xml:id="p1z48"/>in ecclesia; spectatores sunt pugnae infaustae hostes nostri <lb xml:id="p1z49"/>magno <lb xml:id="p1z50"/>cum suo gaudio.</s>
					<s n="13" xml:lang="la">Dominus Iesus, pacis princeps, <lb xml:id="p1z51"/>tranquilliora nobis tempora concedat tibique <lb xml:id="p1z52"/>et <persName ref="p3375">Vergerio</persName> corda formet pacifica et a sordibus <lb xml:id="p1z53"/>invidiae perturbationibusque animi pravi repurgata.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell"><lb xml:id="p1z54"/>Vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 9. iulii.</s>
					<s n="16" xml:lang="la" ana="salute">Uxorem totamque familiam <lb xml:id="p1z55"/>meo et uxoris nomine salutabis.</s>
					<s n="17" xml:lang="la">1557<pb/><lb xml:id="p2z1"/>.</s>
				</p>
