	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nunc, cum vesperi multa nocte, reverende <lb xml:id="p1z2"/>pater, ex montibus redeo, tuae in mensa <lb xml:id="p1z3"/>iacent et 25. scriptae nunc primum <lb xml:id="p1z4"/>5. octobris redduntur.</s>
					<s n="3" xml:lang="la">Itaque tibi permagnas <lb xml:id="p1z5"/>habeo gratias; nam plus praestitisti, <lb xml:id="p1z6"/>quam sperare eram ausus.</s>
					<s n="4" xml:lang="la">Ego nihil <lb xml:id="p1z7"/>habeo, et si quid haberem, non deessem <lb xml:id="p1z8"/>officio.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">D. <persName ref="p8018">Hallerus</persName> ambigue scripsit <lb xml:id="p1z9"/>de <placeName ref="l830">Anglorum</placeName> et <placeName ref="l822">Germanorum</placeName> exercitu <lb xml:id="p1z10"/>eorumque progressu; cupimus aliquando <lb xml:id="p1z11"/>certiora.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale, reverende in Christo <lb xml:id="p1z12"/>pater.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l98">Curię</placeName> 5. octobris anno 1562.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Tui observa<lb xml:id="p1z13"/>ntissimus <persName ref="p8009">F[abricius]</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesię <placeName ref="l587">Tigurinae</placeName> antistiti <lb xml:id="p2z4"/>dignissimo, domino <lb xml:id="p2z5"/>suo et in Christo <lb xml:id="p2z6"/>patri.</s>
					<s n="10" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zurych</placeName> an <persName ref="p495">h. Bullinger</persName>.</s>
				</p>
			</div>
		</body>
	</text>
