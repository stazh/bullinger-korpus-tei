	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Gratiam a deo patre per Christum servatorem etc.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Literas tuas legimus, <persName ref="p495">Bullingere</persName> unice dilecte.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Ex quibus intelleximus Lutheranorum animos plus nimio <lb xml:id="p1z5"/>exasperatos.</s>
					<s n="4" xml:lang="la">Sperabamus quidem a <persName ref="p1974">Lutheri</persName> obitu ipsos longe <lb xml:id="p1z6"/>sedatiores pacatiorisque animi futuros.</s>
					<s n="5" xml:lang="la">Diversum accidit pro<lb xml:id="p1z7"/>cul dubio divina sic moderante providentia, qua nostri animi <lb xml:id="p1z8"/>probantur, an constantes futuri sint an secus.</s>
					<s n="6" xml:lang="la">Caeterum quod <lb xml:id="p1z9"/>vestrum iudicium adtinet, non displicet, quod proposuistis.</s>
					<s n="7" xml:lang="la">Hoc autem <lb xml:id="p1z10"/>fratribus ac symmystis meis unice placeret, ut confessio <placeName ref="l28">Basilien<lb xml:id="p1z11"/>sis</placeName> ad proxima <placeName ref="l157">Francfordiensium</placeName> comitia offerretur principibus.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/>Speramus enim hac via aut benevolis ecclesiis nostris suppeditari <lb xml:id="p1z13"/>ansam melius de nobis et ecclesiis nostratibus iudicandi aut ma<lb xml:id="p1z14"/>levolis omnem in nos debacchandi occasionem ablatum iri.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>Hoc sane speramus in posterum furorem ipsorum sedatiorem <lb xml:id="p1z16"/>futurum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Det dominus, ut ecclesiae suae bene inter se conveniat <lb xml:id="p1z17"/>adversariisque haec unica, qua gloriantur, ansa amputetur <lb xml:id="p1z18"/>sic, ut veritas sola triumpet(?).</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Salutant te symmystę mei.</s>
					<s n="12" xml:lang="la" ana="salute"><lb xml:id="p1z19"/>Salutabis item omnium nostrum nomine omnes fratres quam officiosissime.</s>
					<s n="13" xml:lang="la">Dominus <lb xml:id="p1z20"/>te conservet ecclesiae suae diu incolumem.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l441">Scaffhusii</placeName> 14. iunii <lb xml:id="p1z21"/>anno 1557.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z22"/>Tuus ex animo <lb xml:id="p1z23"/><persName ref="p3481">Simpertus Vogt</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietate et eruditione singulari <lb xml:id="p2z2"/>d. <persName ref="p495">Henrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori <lb xml:id="p2z4"/>vigilantissimo, domino ac <lb xml:id="p2z5"/>fratri suo unice cole<lb xml:id="p2z6"/>ndo.</s>
					<s n="17" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
