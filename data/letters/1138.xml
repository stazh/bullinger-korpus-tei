	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Tandem ova basilisci discerpta peperer<lb xml:id="p1z2"/>unt nobis indictionem concilii, domin<lb xml:id="p1z3"/>e et frater in Christo venerabilis et charissime.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Prodiit enim <placeName ref="l425">Romae</placeName> indictio concilii 18. <lb xml:id="p1z5"/>calendas novembris et dicitur dies 1. calend. maii.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Celebrandum erit <placeName ref="l1107">Tridenti</placeName>, imo continuandum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Confirm<lb xml:id="p1z7"/>atur et habentur rata quaecunque <lb xml:id="p1z8"/>a<lb xml:id="p1z9"/>cta sunt in causa concilii a <persName ref="p19981">Paulo III</persName>.</s>
					<s n="6" xml:lang="la">Missa <lb xml:id="p1z10"/>est ad me ab amicis bullae copia.</s>
					<s n="7" xml:lang="la">Diligenter <lb xml:id="p1z11"/>in ea cavetur, ne quis alius vocetur, quam qui <lb xml:id="p1z12"/>de more habent voces decisivas.</s>
					<s n="8" xml:lang="la">Diligenter in<lb xml:id="p1z13"/>dicatur pontificis Romani esse indicere et regere concilia, <lb xml:id="p1z14"/>et quod Caesar, filius eius dilectissimus hoc ipsum postulaveri<lb xml:id="p1z15"/>t.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Quid ergo aliud ex<lb xml:id="p1z16"/>p<lb xml:id="p1z17"/>ectabimus quam apertam vim?</s>
					<s n="10" xml:lang="la">Nullus erit locus veri<lb xml:id="p1z18"/>tati.</s>
					<s n="11" xml:lang="la">Imo scribit quidam <persName>Muti<lb xml:id="p1z19"/>us <lb xml:id="p1z20"/>Italus</persName> contra <persName ref="p3375">Vergerium</persName>.</s>
					<s n="12" xml:lang="la">Typis excusus <lb xml:id="p1z21"/>est liber Italice, habet praefixum breve <lb xml:id="p1z22"/>apostolicum; approbatur liber a pontifice.</s>
					<s n="13" xml:lang="la">In eo <lb xml:id="p1z23"/>libro diserte scribitur concilium non convocari, <lb xml:id="p1z24"/>ut detur locus haereticis agendi caussam <lb xml:id="p1z25"/>suam et disputandi; hoc enim modo in dis<lb xml:id="p1z26"/>crimen poni authoritatem omnium conciliorum; <lb xml:id="p1z27"/>convocari concilium, ut omnis contraria doctrina <lb xml:id="p1z28"/>Romanae ecclesiae damnetur et ut adversarii <lb xml:id="p1z29"/>revocent.</s>
					<s n="14" xml:lang="la">Vide, quale sit futurum concilium; <lb xml:id="p1z30"/>certa autem sunt haec.</s>
					<s n="15" xml:lang="la">In tale concilium, quod ipsis longe splendidius pingitur, sed f<lb xml:id="p1z31"/>also, consenserunt ordines imperii.</s>
					<s n="16" xml:lang="la">Confirmata est <lb xml:id="p1z32"/>sessio, quae traditiones aequat scripturis.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z33"/>Huic concilio subiicit se bona pars Germaniae; <lb xml:id="p1z34"/>hic fructus diutinae et laboriosae <lb xml:id="p1z35"/>praedicationis.</s>
					<s n="18" xml:lang="la">Ideo visitabit peccata nostra dominus; nost<lb xml:id="p1z36"/>rum erit constanter usque in mortem resiste<lb xml:id="p1z38"/>re et papae et Caesari doctrina et precibus.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z39"/>Verum ita sum adobrutus scriptionibus, laboribus <lb xml:id="p1z40"/>et curis variis, ut plura iam non <lb xml:id="p1z41"/>possim.</s>
					<s n="20" xml:lang="la">Scripsi haec festinantissime.</s>
					<s n="21" xml:lang="la">Admonenda <lb xml:id="p1z42"/>erit in tempore ecclesia et confirmanda.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Dominus serv<lb xml:id="p1z43"/>et te una cum omnibus fratribus.</s>
					<s n="23" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 4. ia<lb xml:id="p1z44"/>nuari<lb xml:id="p1z45"/>i anno 1551.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Tuus <persName ref="p495">H[einryc<lb xml:id="p1z46"/>hus] B[ullingerus]</persName>.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p8418">Osvaldo <lb xml:id="p2z2"/>Myconio</persName>, <placeName ref="l28">Basiliensis</placeName> <lb xml:id="p2z3"/>ecclesiae antistiti vigilantissimo, <lb xml:id="p2z4"/>suo colendissimo domino <lb xml:id="p2z5"/>et fratri.</s>
				</p>
				<p>
					<s n="26" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
