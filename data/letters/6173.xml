					<lb xml:id="p3z4"/>
					<lb xml:id="p3z5"/>lan
					<lb xml:id="p3z6"/>
					<lb xml:id="p3z7"/>Amen.
					<lb xml:id="p3z8"/>odis.
					<lb xml:id="p3z9"/>1564.
					<pb/>
					<lb xml:id="p4z1"/>Ornatissimo viro d. Henrico
					<lb xml:id="p4z2"/>Bullingero, ecclesiae
					<lb xml:id="p4z3"/><placeName ref="l587">Tigurinae</placeName> pastori vigilantisimo
					<lb xml:id="p4z4"/>patri in Christo
					<lb xml:id="p4z5"/>modis omnibus reverendo
					<lb xml:id="p4z6"/>
					<lb xml:id="p4z7"/>Zurich.
				</p>
