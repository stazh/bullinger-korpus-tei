	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Quod rarius ad te scribo, id facio, quod <lb xml:id="p1z2"/>occupationes tuas et studia interpellare nolim.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Nunc, quod res nulla est, quae scribenda sit, brevior e<lb xml:id="p1z4"/>ro.</s>
					<s n="3" xml:lang="la">Quid agatur in <placeName ref="l822">Germania</placeName> et quanti illic <lb xml:id="p1z5"/>rerum omnium apparatus fiant, tu melius nosti <lb xml:id="p1z6"/>ex tot amicorum tuorum literis.</s>
					<s n="4" xml:lang="la">Reliquum est <lb xml:id="p1z7"/>igitur, ut pietati tuae me commendem.</s>
					<s n="5" xml:lang="la">Brevi, si <lb xml:id="p1z8"/>procedant multorum consilia, arma undique concre<lb xml:id="p1z9"/>pabunt.</s>
					<s n="6" xml:lang="la" ana="salute">Deus optimus maximus omnia ad populi sui salutem <lb xml:id="p1z10"/>dirigat.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale.</s>
					<s n="8" xml:lang="la"><placeName ref="l98">Curiae</placeName>, idibus martii.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z11"/>Tuus <persName ref="p8332">episcopus Bayonensis</persName>.</s>
				</p>
				<p>
					<note>[vor 263:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p4z1"/>Doctissimo viro domino <persName ref="p495">Henrico <lb xml:id="p4z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p4z3"/>ministro, amico charissimo.</s>
				</p>
			</div>
		</body>
	</text>
