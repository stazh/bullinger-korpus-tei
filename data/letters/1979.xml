	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la">Quas scripsisti literas cum novis atque catechismo, quem ob temporis <lb xml:id="p1z2"/>brevitatem inspicere non potui, accepi diligenter, quo nomine non <lb xml:id="p1z3"/>immerito, <persName ref="p495">Bullingere</persName> ornatissime, gratias ingenteis ago, qui <lb xml:id="p1z4"/>subinde nova ex diversis orbis partibus tibi allata tam human<lb xml:id="p1z5"/>iter communicas.</s>
					<s n="3" xml:lang="la">Nos autem de hisce rebus omnibus ne verbum <lb xml:id="p1z6"/>quidem audivimus; silent enim nunc ad duorum fere mensium <lb xml:id="p1z7"/>spatium omnia.</s>
					<s n="4" xml:lang="la">Quo fit, ut nihil tibi scribendum modo offeratur.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/><persName ref="p3099">Sulcerus</persName> si quid habet, procul dubio communicabit.</s>
					<s n="6" xml:lang="la">Advo<lb xml:id="p1z9"/>lavit nuper ad nos ex <placeName ref="l18">Augusta Vindelicorum</placeName> d. <persName ref="p7095">Hieronymus <lb xml:id="p1z10"/>Wolfius</persName>, qui licet <persName>Fuggeris</persName>, quorum stipendio <lb xml:id="p1z11"/>et mensa alitur, sit familiarissimus, nihil tamen novi <lb xml:id="p1z12"/>referre nobis potuit.</s>
					<s n="7" xml:lang="la">Dabunt tamen quaedam nobis <lb xml:id="p1z13"/><placeName ref="l157">Francfordienses</placeName>, quae instant, nundinae, ex quibus si quid <lb xml:id="p1z14"/>allatum fuerit, diligenter communicabimus.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale cum <lb xml:id="p1z15"/>uxore et tota familia nobis et ecclesiae <lb xml:id="p1z16"/>Christi diu salvus et incolumis.</s>
					<s n="9" xml:lang="la">Fasciculum ad <lb xml:id="p1z17"/>d. <persName ref="p1010">Erbium</persName> diligenter curabo per <persName ref="p3932">Westhemerum</persName>, <lb xml:id="p1z18"/>qui ad ecclesiae ministerium nuper a <persName>principe Gre<lb xml:id="p1z19"/>gorio</persName> in pagum prope <placeName ref="l411">Richenwylam</placeName> vocatus est.</s>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z20"/>Iterum vale.</s>
					<s n="11" xml:lang="la"><placeName ref="l28">Basileae</placeName> raptim, ut aparet, 31<lb xml:id="p1z21"/>. <lb xml:id="p1z22"/>augusti anno 1553.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/>T[uus] <persName ref="p8406">Lycos<lb xml:id="p1z24"/>thenes</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z25"/>Pro munere mihi acceptissimo gratias tibi ingentes <lb xml:id="p1z26"/>ago et habeo, donec referendi sese nobis adferet <lb xml:id="p1z27"/>occasio<lb xml:id="p1z35"/>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, urbis <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> episcopo, summo am<lb xml:id="p2z4"/>ico.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
