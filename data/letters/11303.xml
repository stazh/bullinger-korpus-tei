	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Literas<note xml:id="fn1" type="footnote" n="1">Oben <ref target="file11297">Nr. 1254</ref>.</note> meas gratas tibi fuisse, patro<lb xml:id="p1z2"/>ne charissime, gaudeo, nec parvum hoc in scribendo calcar <lb xml:id="p1z3"/>addidit.</s>
					<s n="3" xml:lang="la">Quod me de te id, quod de patre, polliceri iubes<note xml:id="fn2" type="footnote" n="2"><persName ref="p495">Bullingers</persName> Brief ist nicht erhalten.</note>, <lb xml:id="p1z4"/>gratias ingentes ago teque id de<note xml:id="fna" type="footnote" n="a">de <hi>über der Zeile nachgetragen.</hi></note> me tibi polliceri iubeo, quod <lb xml:id="p1z5"/>de filio; me enim tuę voluntati minus obedientem nunquam <lb xml:id="p1z6"/>(si modo deus affuerit) comperies.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><persName ref="p4830">Adamo Fry</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p4830">Adam Frey</persName>.</note> libellum<note xml:id="fn4" type="footnote" n="4"><persName ref="p495">Bullingers</persName> "Bericht der Kranken" (<bibl source="b286">HBBibl</bibl> I 73); vgl. oben <ref target="file11297">Nr. 1254</ref>, 12-16.</note> <lb xml:id="p1z7"/>nondum misi; mittam autem brevi, quamvis ipse, ut egomet <lb xml:id="p1z8"/>eum adirem, cupit, quod, si licuerit, faciam, ne me <lb xml:id="p1z9"/>sibi defuisse conquęratur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">In <persName ref="p4543">Ciceronis</persName> orationibus maxime <lb xml:id="p1z10"/>laboro, cum has ad Gręcorum Latinorumque rhetorum<note xml:id="fnb" type="footnote" n="b">-um <hi>als Korrektur über gestrichener Endung.</hi></note> praecepta <lb xml:id="p1z11"/>examino et<note xml:id="fnc" type="footnote" n="c"><hi>vor</hi> et <hi>ein gestrichenes Wort.</hi></note> alias ad harum exemplar conscribo.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Magnam praeterea de <placeName ref="l587">Tigurinis</placeName> humanitatem predicat <lb xml:id="p1z13"/><persName ref="p8126">Ioannes Ryfenstein</persName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Gaudeo, quod et peregrino et mei <lb xml:id="p1z14"/>amantissimo tantum apud vos honoris impensum<note xml:id="fnd" type="footnote" n="d"><hi>in der Vorlage</hi> impensit[?].</note> sit.<pb type="edition" next="119"/></s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Biblia <persName ref="p2270">Munsteri</persName><note xml:id="fn5" type="footnote" n="5">Zu der von <persName ref="p8011">Gwalther</persName> erbetenen lateinischen Bibel vgl. oben <ref target="file11288">Nr. 1245</ref>, 19-23; 1254, 78f.</note> ab <persName ref="p506">Ioanne Butlero</persName> accepi; tibi gratias <lb xml:id="p1z16"/>ago pro labore pro me impenso.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Quod <persName ref="p6117">Blatterum</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p6117">Thomas Platter</persName>.</note> attinet, <lb xml:id="p1z17"/>me illum convenisse scias<note xml:id="fne" type="footnote" n="e"><hi>vor</hi> scias <hi>ein gestrichener Buchstabe.</hi></note>; verum hic <persName ref="p8011">Gvaltheri <lb xml:id="p1z18"/>Insulani</persName> <persName ref="p18379">episcopi</persName> librum<note xml:id="fn7" type="footnote" n="7"><persName ref="p18379">Walter von Châtillon</persName>, Alexandreis (Manuskript); s. <bibl source="b9">HBBW VII</bibl> <ref target="file11105">[Nr. 1062]</ref>, S. 291, 8-13 mit Anm. 3.</note> <persName ref="p2259">Gregorio Mangolt</persName> tradidit.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/><persName ref="p6571">Sedulium</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p6571">Coelius Sedulius</persName>, Carmen paschale (Manuskript); s. <bibl source="b8">HBBW VI</bibl>, S. 330, 2-6 mit Anm. 1.</note> vero <persName ref="p8126">Oporinus</persName> habet, quem cum nec <lb xml:id="p1z20"/>heri nec hodie domi deprehendere potuerim (est enim <lb xml:id="p1z21"/>maximis irretitus negotiis), nunc mittere non <lb xml:id="p1z22"/>potui; sed habebis hunc a me, quam primum nuntius <lb xml:id="p1z23"/>alius datur.</s>
					<s n="11" xml:lang="la">Tunc etiam te de libro <persName ref="p6927">Vivis</persName> De anima<note xml:id="fn9" type="footnote" n="9"><persName ref="p6927">Juan Luis Vives</persName>, De anima et vita libri tres, <placeName ref="l28">Basel</placeName> (<persName ref="p7062">Robert Winter</persName>) 1538; vgl. <bibl source="b10">HBBW VIII</bibl> <ref target="file11217">[Nr. 1174]</ref>, S. 219, 35f und 238, 4-9.</note>, <lb xml:id="p1z24"/>quantum constet, certiorem faciam; nam et hunc ab <lb xml:id="p1z26"/><persName ref="p8126">Oporino</persName> accepi.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z27"/>Anglo huic, de quo ante scripseras<note xml:id="fn10" type="footnote" n="10">Die Formulierung läßt vermuten, daß jemand anders als der oben Z. 15 genannte <persName ref="p506">John Butler</persName> gemeint sein dürfte.</note>, <lb xml:id="p1z28"/>conditionem nullam adhuc reperi nec ullam <lb xml:id="p1z29"/>me inventurum spero; correctores enim sunt plurim<lb xml:id="p1z30"/>i, qui huiusmodi inhiant conditionibus.</s>
					<s n="13" xml:lang="la">Accedit <lb xml:id="p1z31"/>his, quod ignotos et qui in typographiis exercitati <lb xml:id="p1z32"/>nunquam sunt, non libenter recipiunt.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z33"/>Verum si duobus <lb xml:id="p1z34"/>tantum id praescissem diebus, <persName ref="p5599">Balthazar Lasius</persName> eum r<lb xml:id="p1z35"/>ecepisset; sed nunc <placeName ref="l832">Gallum</placeName> quendam<note xml:id="fn11" type="footnote" n="11">Unbekannt.</note> habet.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z36"/>Hos nummos rogavit <persName ref="p8126">Ioannes Ryfenstein</persName>, ut alicui <lb xml:id="p1z37"/>mitterem, qui bazones<note xml:id="fn12" type="footnote" ana="lex" n="12">Batzen.</note> ei pro his mitteret; nam hic <lb xml:id="p1z38"/>hęc moneta ignota est nec permutari potest.</s>
					<s n="16" xml:lang="la">Te rogo, <lb xml:id="p1z39"/>ut optimo iuveni hic operam tuam praebeas.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Salutabis, <lb xml:id="p1z40"/>quaeso, nomine meo <persName ref="p7042">matrem</persName><note xml:id="fn13" type="footnote" ana="bio" n="13"><persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note> et <persName ref="p8051">uxorem</persName><note xml:id="fn14" type="footnote" ana="bio" n="14"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> tuam cum univers<lb xml:id="p1z41"/>a familia, fratrem quoque <persName ref="p527">Ioannem</persName><note xml:id="fn15" type="footnote" n="15"><persName ref="p527">Johannes Bullinger</persName>.</note>, quem<note xml:id="fnf" type="footnote" n="f"><hi>vor</hi> quem <hi>gestrichenes</hi> u.</note>, ut rescribat, <lb xml:id="p1z42"/>num ea, quae misi<note xml:id="fn16" type="footnote" n="16">Worum es sich handelte, ist nicht bekannt.</note>, receperit, hortare.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="farewell">Vale bene, patrone <lb xml:id="p1z43"/>humanissime, et me, ut cępisti, amare pergito.</s>
					<s n="19" xml:lang="la"><placeName ref="l28">Basileę</placeName>, <lb xml:id="p1z44"/>ex aedibus <persName ref="p8418">Miconii</persName>, 26. aprilis 1539.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z45"/>Tuus, ut nosti, <lb xml:id="p1z46"/><persName ref="p8011">Rodolphus Gvaltherus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Et docto et pio viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho Bul<lb xml:id="p2z3"/>lingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae episcopo vigilantissimo, <lb xml:id="p2z5"/>patrono <lb xml:id="p2z6"/>suo imprimis <lb xml:id="p2z7"/>colendo.</s>
				</p>
				<p>
					<s n="22" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
