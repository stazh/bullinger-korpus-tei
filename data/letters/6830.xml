	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Proficiscitur ad vos <persName ref="p772">Petrus Dathenus</persName>, cuius <lb xml:id="p1z2"/>pietatem et eruditionem vobis notam esse <lb xml:id="p1z3"/>arbitror.</s>
					<s n="3" xml:lang="la">Conferet autem vobiscum de rebus <lb xml:id="p1z4"/>arduis.</s>
					<s n="4" xml:lang="la">Quem ut amice audiatis et <lb xml:id="p1z5"/>negotium prudenter ac mature curetis, <lb xml:id="p1z6"/>valde rogo.</s>
					<s n="5" xml:lang="la">Vereor, ne adversarii olfatiant <lb xml:id="p1z7"/>aliquid ex composito gestum, quare danda <lb xml:id="p1z8"/>opera est, ut occasiones calumniandi vitentur <lb xml:id="p1z9"/>minimeque communicationes consiliorum <lb xml:id="p1z10"/>effluant.</s>
					<s n="6" xml:lang="la" ana="salute">Princeps te et <persName ref="p3988">Volphium</persName> salver<lb xml:id="p1z11"/>e iubet, quibus honoraria misisset, si ea <lb xml:id="p1z12"/><persName ref="p772">Dathenus</persName> commodo perferre potuisset.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Curabo autem, ut proximo autumnali <lb xml:id="p1z14"/><placeName ref="l157">Francfordiano</placeName> mercatu mittantur per <lb xml:id="p1z15"/><persName ref="p1227">Froschouerum</persName> vestrum/nostrum.</s>
					<s n="8" xml:lang="la">Ex <placeName ref="l2472">Polonia</placeName> tristia <lb xml:id="p1z16"/>ad nos scribuntur Arianismum longe <lb xml:id="p1z17"/>lateque serpere.</s>
					<s n="9" xml:lang="la">Multi suspicantur regno <lb xml:id="p1z18"/>maximam calamitatem imminere, cum rex <lb xml:id="p1z19"/>legitimo sucessore careat et finitimi reges <lb xml:id="p1z20"/>nunc copiis instructi regno inhiant.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Dominus suam ecclesiam in his turbis benigne <lb xml:id="p1z22"/>respitiat et conservet.</s>
					<s n="11" xml:lang="la" ana="salute">Vale, mi <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z23"/>ac <persName ref="p3988">Volphium</persName>, <persName ref="p8442">Simlerum</persName>, <persName ref="p8011">Gvaltherum</persName>, <persName ref="p1884">Lavaterum</persName> <lb xml:id="p1z24"/>et alios nostros amicos meo nomine <lb xml:id="p1z25"/>saluta.</s>
					<s n="12" xml:lang="de">3. iulii anno etc. 66.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z26"/>Tuus ex animo <lb xml:id="p1z27"/><persName ref="p8094">Stephanus Cirlerus</persName>, <lb xml:id="p1z28"/>secretarius.</s>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Reverendo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>antistiti fidelissimo, <lb xml:id="p2z4"/>[am]ico plurimum colendo<lb xml:id="p2z5"/>.</s>
				</p>
			</div>
		</body>
	</text>
