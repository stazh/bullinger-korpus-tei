	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>D laus der rere adi 2. appel in S Gallen
					<lb xml:id="p1z2"/>Erwurdiger, hoch- und wollglertter herr uff.
					<lb xml:id="p1z3"/>ant ich euch den jungsten sampt ainem
					<lb xml:id="p1z4"/>brieff von Grinenbach auch etlicher newer
					<lb xml:id="p1z5"/>zeitung Sider hat sich, sunders nichts zuͦ tragen
					<lb xml:id="p1z6"/>dan das graff Hansball kam Muster plat kan
					<lb xml:id="p1z7"/>bekomen. So hat der mit hin vor dattum 4 sin
					<lb xml:id="p1z8"/>fürnemsten räth fur zain ersamen rath alhie
					<lb xml:id="p1z9"/>gesant die inlaßen anzaigen, das alle die, so
					<lb xml:id="p1z10"/>seiner landthafft guetter haben, die sollen
					<lb xml:id="p1z11"/>seinen geboten verpotten gehorsam sein, an
					<lb xml:id="p1z12"/>fietaben sontag in dis hailgen maß gonn
					<lb xml:id="p1z13"/>wn sy, das nit schun wollend, sollen sy wed
					<lb xml:id="p1z14"/>furen, essen nochwonen in iren hußern
					<lb xml:id="p1z15"/>kunzum kain anders nit das seye ires gnediger
					<lb xml:id="p1z16"/>fursten und herren ernstlicher beuch also
					<lb xml:id="p1z17"/>volgt aies nach dem andren jee mehr man
					<lb xml:id="p1z18"/>ain puren vorgibt, jen stölter ehr wirdt. ich
					<lb xml:id="p1z19"/>mich ewer zeitung. ich trag soig die straff
					<lb xml:id="p1z20"/>über ain Eidtgliosschafft seye nacher dan mir
					<lb xml:id="p1z21"/>achten gott der herr kome den seinen zu
					<lb xml:id="p1z22"/>hilff dem sind sampt den ewer auch allen
					<lb xml:id="p1z23"/>meinen erenden geliebten herren in gnadt
					<lb xml:id="p1z24"/>beulhen herr, danit frowt eier schreiben
					<lb xml:id="p1z25"/>woll wirdt euch widumb schriben die tag
					<lb xml:id="p1z26"/>ist der elend mensch merrat hie gesin vor
					<lb xml:id="p1z27"/>minen herren umb furgschrifft gerpfenng
					<lb xml:id="p1z28"/>pacgurt verschafsiche.
					<lb xml:id="p1z29"/>nach darto pere murh.
					<lb xml:id="p1z30"/>U. di.
					<lb xml:id="p1z31"/>Hanuß Jomin.
					<pb/>
					<lb xml:id="p2z1"/>Dem erwurdigen, hoch-unnd
					<lb xml:id="p2z2"/>wolglertten herren Heinrich
					<lb xml:id="p2z3"/>Bullinger der olter gethrewer
					<lb xml:id="p2z4"/>dienner der kirchen christ
					<lb xml:id="p2z5"/>meinem erenden geliebten
					<lb xml:id="p2z6"/>herren in
					<lb xml:id="p2z7"/><placeName ref="l587">Zurich</placeName>.
				</p>
			</div>
