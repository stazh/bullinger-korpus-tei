	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Non possum scribere, quam lubenter tuas acceperim et <lb xml:id="p1z2"/>legerim, doctas sane et prudenter de omnibus scriptas, <lb xml:id="p1z3"/>et utinam <placeName ref="l822">Germani</placeName>, qui iam per tot annos sunt Caesaris <lb xml:id="p1z4"/>benevolentiam experti, tandem sapiant.</s>
					<s n="3" xml:lang="la">Timeo semper <lb xml:id="p1z5"/>finem; scio enim per decem vel duodecim annos cum <lb xml:id="p1z6"/>eis enutritus, quam facile imponatur omnibus, <lb xml:id="p1z7"/>nescio an fato quodam malo vel propter mutu<lb xml:id="p1z8"/>a odia id accidit.</s>
					<s n="4" xml:lang="la">Acci<lb xml:id="p1z9"/>dit tamen iam <lb xml:id="p1z10"/>sepius republicae christianae incommodum ita, quod alii <lb xml:id="p1z11"/>reges et monarche non audent fidem suam <lb xml:id="p1z12"/>eis committere.</s>
					<s n="5" xml:lang="la">Rex tamen noster statuit omnino <placeName ref="l822">Germanicam</placeName> <lb xml:id="p1z13"/>libertatem non deserere, si modo ipsi, ut iam quotidie suę m[<lb xml:id="p1z14"/>aiesta]ti significant, aliquid animi habeant.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Marquio ille thyrannus omnia perdit; ingressus, <lb xml:id="p1z16"/>ut iam audivi, civitatem <placeName ref="l1703">Pambergensem</placeName> iussit <lb xml:id="p1z17"/>aliquod canonicos suspendi et per pagos idem de <lb xml:id="p1z18"/>sacerdotibus facit, egregiam vero laudem.</s>
					<s n="7" xml:lang="la">Sed <lb xml:id="p1z19"/>qualis dominus, talis famulus; <persName>Caesar</persName> <lb xml:id="p1z20"/>favebat primo protestantibus, secundo aliis, iam <lb xml:id="p1z21"/>tertio utrosque perdit; tanta est eius in <placeName ref="l822">Germaniam</placeName> <lb xml:id="p1z22"/>affectio paterna.</s>
					<s n="8" xml:lang="la">Mihi ab <placeName ref="l491">Argentina</placeName> scriptum est <lb xml:id="p1z23"/>comitia omnium principum <placeName ref="l157">Francfordiae</placeName> indicta ad <lb xml:id="p1z24"/>16. huius mensis, quo Caesar promittit se missurum <lb xml:id="p1z25"/>suos legatos.</s>
					<s n="9" xml:lang="la">Interim per papam petit pacem, <pb/><lb xml:id="p2z1"/>sed non impetrabit, et scimus illa omnia in fraudem <lb xml:id="p2z2"/>fieri; nam primo regem tentavit, cum vellet secum <lb xml:id="p2z3"/>foedus contra <placeName ref="l822">Germaniam</placeName> inire.</s>
					<s n="10" xml:lang="la">Rex interea <lb xml:id="p2z4"/>mittit fortem exercitum in <placeName ref="l736">Pedemontium</placeName> et cetera <lb xml:id="p2z5"/>expedit ad bellum.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Senenses bene habent; heret <lb xml:id="p2z6"/><persName>Casarianus</persName> exercitus iam per mensem ante <lb xml:id="p2z7"/>parvum quoddam castellum nomine <placeName>Montertio</placeName>.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z8"/>Non possum non libenter legisse id, quod mihi <lb xml:id="p2z9"/>de legato <placeName ref="l1098">Florentino</placeName> scribis; video vestrum senatum <lb xml:id="p2z10"/>sapere et sentire artes Caesaris; illa enim, ut <lb xml:id="p2z11"/>scribis, fiunt eius instinctu, ut dividat <lb xml:id="p2z12"/>vos invicem et nos a vobis; nam nihil est, <lb xml:id="p2z13"/>quod magis eum vexet.</s>
					<s n="13" xml:lang="la">Admonueram vestrates <lb xml:id="p2z14"/>et quomodo <persName>Caesar</persName> post seditiones <placeName ref="l822">Germanicas</placeName> omnino <lb xml:id="p2z15"/>urget marquionem, ut bellum transferat versus <lb xml:id="p2z16"/><placeName ref="l631">Burgundiam</placeName> in vestris et nostris limitibus.</s>
					<s n="14" xml:lang="la">Scribe <lb xml:id="p2z17"/>sepe, queso, et habeas me charum.</s>
					<s n="15" xml:lang="la" ana="farewell">Vale optime, <lb xml:id="p2z18"/>vir bone.</s>
					<s n="16" xml:lang="la">Datum <placeName ref="l760">Soluturi</placeName> 3a amii.</s>
					<s n="17" xml:lang="la">Raptim.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Tuus semper <persName ref="p8296">Bas[<lb xml:id="p2z19"/>sefontaneus]</persName>.</s>
				</p>
				<p>
					<note>[viell. doch nur die Unterschrift autograph.]</note>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z20"/>Tuae veniunt per postam <lb xml:id="p2z22"/>absque ullo periculo.</s>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p3z1"/>Clarissimo domino et <lb xml:id="p3z2"/>amico d. <persName ref="p495">Bulingero</persName>, <lb xml:id="p3z3"/>viro optimo.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p3z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
