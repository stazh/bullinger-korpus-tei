	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia Christi tecum.</s>
					<s n="2" xml:lang="la">Nuncius vehementer abitur<lb xml:id="p1z2"/>iebat; hinc factum, patrone et frater in Christo <lb xml:id="p1z3"/>observande, ut nequiverim, quę volebam, scribere.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Princeps indies expectatur, utinam ne mutatum <lb xml:id="p1z5"/>moribus et cęremoniis, quibus utitur ducatus, ... fert.</s>
					<s n="4" xml:lang="la">Mihi <lb xml:id="p1z6"/>cum M.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><persName ref="p5051">Casparo Gretero</persName>, concionatore aulico, negotium est, qui <lb xml:id="p1z7"/>nostrum catechismum ad formam Wirtenberg[ensis] urget <lb xml:id="p1z8"/>castigare, de quo, si vacaret, plura.</s>
					<s n="6" xml:lang="la">Privatim exa<lb xml:id="p1z9"/>minationem ante coenam cupit nobis obtrudere et de <lb xml:id="p1z10"/>pręsentia Christi maiorem explicationem etc. et nescio quę <lb xml:id="p1z11"/>alia.</s>
					<s n="7" xml:lang="la">Apud me est libellus a duce <placeName>Prutenico</placeName> <lb xml:id="p1z12"/>aeditus de iustificatione, de qua delirarunt fere <lb xml:id="p1z13"/>triennio <persName ref="p2301">Osiander</persName> etc.; si non haberes, mitterem <lb xml:id="p1z14"/>cum confessione <placeName ref="l572">Wirtenbergensi</placeName>.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale, vale et, ut <lb xml:id="p1z15"/>soles, ora pro me.</s>
					<s n="9" xml:lang="la" ana="salute">Saluta omnes.</s>
					<s n="10" xml:lang="la">16. maii 1553.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z16"/>T[uus] <pb/><lb xml:id="p2z1"/><persName ref="p1010">Erbius</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z2"/>Eximio viro d. <lb xml:id="p2z3"/><persName ref="p495">Henrycho <lb xml:id="p2z4"/>Bullingero</persName>, <lb xml:id="p2z5"/>antistiti ecclesię <lb xml:id="p2z6"/><placeName ref="l587">Tigurinę</placeName>, fratri <lb xml:id="p2z7"/>semper in Christo <lb xml:id="p2z8"/>observando.</s>
				</p>
			</div>
		</body>
	</text>
