	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Humaniter scribit <persName>Philippus</persName>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Utinam libere et <lb xml:id="p1z2"/>explicate.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Sed magis dolendum est hostiliter inter <lb xml:id="p1z3"/>nos agi.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Bene est quod dominus me contra minas <lb xml:id="p1z4"/>et terrores obduravit.</s>
					<s n="5" xml:lang="la">In <persName ref="p8033">Beza</persName> quoque non minus <lb xml:id="p1z5"/>animi et constantię fore certo persuasus sum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>pastori fratri et symmystae <lb xml:id="p2z4"/>observando.</s>
				</p>
			</div>
		</body>
	</text>
