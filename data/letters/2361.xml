	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quaesivit bonus hic frater conditionem apud nos, quam <lb xml:id="p1z2"/>tamen non invenit; horrent enim nostri peregrinum idioma mirum <lb xml:id="p1z3"/>in modum.</s>
					<s n="3" xml:lang="la">Praedixi illi idem eventurum <placeName ref="l587">Tiguri</placeName>; voluit tamen ad <lb xml:id="p1z4"/>vos proficisci inde <placeName ref="l18">Augustam</placeName> petiturus, opinor.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Habet uxorem <lb xml:id="p1z5"/>et duos liberos.</s>
					<s n="5" xml:lang="la">Duos coronatos a nostris accepit pro viatico.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/>Rogavit, ut ipsum tibi commendarem; quod etsi aegre facio, quia <lb xml:id="p1z7"/>te satis alias eiusmodi hominibus oneratum esse scio, tamen non potui <lb xml:id="p1z8"/>omnino hoc recusare, quia bonus et pius esse videtur et unus <lb xml:id="p1z9"/>ex eorum numero, quos dominus nobis commendat.</s>
					<s n="7" xml:lang="la">Alias nunc <lb xml:id="p1z10"/>non habeo, quod scribam.</s>
					<s n="8" xml:lang="la">Tuas accepi una cum Italico l<lb xml:id="p1z11"/>ibello et ago tibi gratias.</s>
					<s n="9" xml:lang="la">Causa <persName>Orbana</persName> bene successit.</s>
					<s n="10" xml:lang="la">Nunc est <lb xml:id="p1z12"/>alia parochia, quae reformationem petit.</s>
					<s n="11" xml:lang="la"><placeName ref="l922">Friburgensibus</placeName> <lb xml:id="p1z13"/>dies dictus est ad 20. augusti; illi insaniunt et nesciunt, <lb xml:id="p1z14"/>quo pacto cursum hunc evangelii impedire possint; nostri <lb xml:id="p1z15"/>pergunt strenue.</s>
					<s n="12" xml:lang="la">Dominus confirmet opus suum.</s>
					<s n="13" xml:lang="la"><persName ref="p3099">Sultzerus</persName> hisce <lb xml:id="p1z16"/>diebus hic fuit, veniet quoque ad vos in hac profectione, <lb xml:id="p1z17"/>quam per <placeName ref="l2469">Subsylvanos</placeName> et <placeName ref="l300">Lucernates</placeName> instituit.</s>
					<s n="14" xml:lang="la" ana="salute">Nostri te tuosque <lb xml:id="p1z18"/>omnes salutant, praesertim <persName ref="p8417">Musculus</persName> et <persName ref="p2919">Schlatterus</persName> atque familiae nostrae.</s>
					<s n="15" xml:lang="la" ana="farewell"><lb xml:id="p1z19"/>Bene vale.</s>
					<s n="16" xml:lang="la">11. augusti 1554.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z20"/>Tuus <persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z4"/>pastori fidelissimo, <lb xml:id="p2z5"/>domino ac compatri <lb xml:id="p2z6"/>suo charissimo.</s>
				</p>
			</div>
		</body>
	</text>
