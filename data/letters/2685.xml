	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Posteriores tuas, compater in domino charissime, <lb xml:id="p1z2"/>30. mensis praeteriti accepi.</s>
					<s n="3" xml:lang="la">Quae de im<lb xml:id="p1z3"/>probitate Lutheranorum scribis, mihi iam <lb xml:id="p1z4"/>antea ad nauseam usque innotuerat.</s>
					<s n="4" xml:lang="la">Nihil <lb xml:id="p1z5"/>est, quod miremur in illis infrenem hanc <lb xml:id="p1z6"/>et impudentem maledicendi libidinem; melius <lb xml:id="p1z7"/>instituti non sunt, benedicere nesciunt, <lb xml:id="p1z8"/>quia a praeceptoribus suis maledicentiam istam <lb xml:id="p1z9"/>sic imbiberunt, ut maledicta ex ore ipsorum <lb xml:id="p1z10"/>ultro effluant, de quibus antea non co<lb xml:id="p1z11"/>gitarunt.</s>
					<s n="5" xml:lang="la">Existimant se probe fungi suo <lb xml:id="p1z12"/>munere, ubi conciones suas loedoriis <lb xml:id="p1z13"/>in sacramentarios, ut nos vocant, <lb xml:id="p1z14"/>eiaculatis magna ex parte absolvunt.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Orandus est dominus, ut reducat eos ad me<lb xml:id="p1z16"/>liorem mentem.</s>
					<s n="7" xml:lang="la">Quam longe aliter animatum <lb xml:id="p1z17"/>convenit esse Christi ministrum?</s>
					<s n="8" xml:lang="el">Πολλα δ<lb xml:id="p1z18"/>ει μεριμνηναι, <foreign xml:lang="la">inquit alicubi Basilius</foreign>, και πολλαΩ <lb xml:id="p1z19"/>αγρθπτοθΩ νθκταΩ διενεγκειν και μετα πολλ<lb xml:id="p1z20"/>ςν δακρθςν εκζητησαι παρα Ξεοθ την αληΞεια<lb xml:id="p1z21"/>ν τον μελλοντα ξιλιαΩ αδελξοθ τεμνεσΞαι.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z22"/>Caeterum, quod <persName>Matheum Beyer</persName> attinet, qui <lb xml:id="p1z23"/>has reddit, deputarunt illi domini nostri singulis <lb xml:id="p1z24"/>quartalibus anni florenos <lb xml:id="p1z25"/>quinque cum duabus frumenti mensuris <lb xml:id="p1z26"/>nostratibus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Exigua sane est annona pro <lb xml:id="p1z27"/>necessitate eius, qui quatuor liberos est <lb xml:id="p1z28"/>cum uxore secum adducturus; verum quid fa<lb xml:id="p1z29"/>ciamus?</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Venit huc non satis in tempore; <lb xml:id="p1z30"/>nostri magnis sumptibus gravantur, praesertim <lb xml:id="p1z31"/>hac tempestate, quare tenaciores sunt <lb xml:id="p1z32"/>solito.</s>
					<s n="12" xml:lang="la">Dominus <persName ref="p8018">Hallerus</persName> non adest; caeteris <lb xml:id="p1z33"/>consultum videtur, ut huc veniat; sperant <lb xml:id="p1z34"/>ipsam praesentem necessitatem plura extorsuram.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Reliquum est, ut vos isthic hominem sumptu <lb xml:id="p2z2"/>aliquo itineris ad nos usque iuvetis, quan<lb xml:id="p2z3"/>doquidem de suo non habet, unde hospiti <lb xml:id="p2z4"/>satisfaciat.</s>
					<s n="14" xml:lang="la">De meo dedi illi dimidium florenum, <lb xml:id="p2z5"/>quo expeditius ad vos usque redeat.</s>
					<s n="15" xml:lang="la">Non <lb xml:id="p2z6"/>possumus bona cum conscientia deserere tales.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z7"/>Quare te oro, compater charissime, impetres a tuis <lb xml:id="p2z8"/>viaticum ad nos profecturo; ubi huc cum <lb xml:id="p2z9"/>suis venerit, reliquam illius curam in nos <lb xml:id="p2z10"/>suscipiemus.</s>
					<s n="17" xml:lang="la" ana="farewell">Optime vale cum tuis omnibus.</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z11"/>Salvi sint etiam domini et fratres, d. <persName ref="p8127">Pellicanus</persName>, <persName ref="p8171">Bibliander</persName>, <lb xml:id="p2z12"/><persName ref="p8011">Gvaltherus</persName>, <persName ref="p7228">Zvinglius</persName>, <persName ref="p8018">Hallerus</persName> vester praepositus <lb xml:id="p2z13"/>et reliqui.</s>
					<s n="19" xml:lang="la" ana="salute">Salutant te fratres et mei omnes, <lb xml:id="p2z14"/>praesertim <persName ref="p487">Heinrychulus</persName> tuus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1555. <lb xml:id="p2z15"/>2. augusti.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><persName ref="p8417">W[olfgan<lb xml:id="p2z16"/>gus] Musculus</persName>, tuus <lb xml:id="p2z17"/>in domino.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p4z1"/>Praestantissimo <lb xml:id="p4z2"/>theologo m. <persName ref="p495">Heinrycho <lb xml:id="p4z3"/>Bullingero</persName>, <lb xml:id="p4z4"/><placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p4z5"/>pastori fidelissimo, <lb xml:id="p4z6"/>domino ac compatri <lb xml:id="p4z7"/>suo charissimo.</s>
					<s n="23" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
