	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Frater, quem <persName>Tavasianis</persName> ad nos misisti, redit ad vos nostri simul atque <lb xml:id="p1z2"/>sui voti compos factus.</s>
					<s n="3" xml:lang="la">Sed exponet ipse tibi omnia.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Miror saepe mecum, quo tandem <lb xml:id="p1z3"/>deventurae res sint apud nos, cum evangelicos concionatores tam con<lb xml:id="p1z4"/>temptim tractent, etiam cum tam pauci sint.</s>
					<s n="5" xml:lang="la">Caeterum ago tibi gratias <lb xml:id="p1z5"/>maximas, humanissime vir, pro libro concionum tuarum secundarum in Ieremiam, <lb xml:id="p1z6"/>sed crede longe maiores pro literulis libri in fronte tuis digitis scriptis.</s>
					<s n="6" xml:lang="la">Ego <lb xml:id="p1z7"/>maximi honoris loco duco (quicquid grunniant rigidorum <persName>Stoicorum</persName> <lb xml:id="p1z8"/>filii isti) tibi sic in memoria fuit, ut dignatus sis sic <persName>Philippi</persName> tui <lb xml:id="p1z9"/>nomen ponere.</s>
					<s n="7" xml:lang="la">Nova apud nos sunt nulla, nisi quod iam certum est <lb xml:id="p1z10"/><placeName ref="l2510">Turcam</placeName> mare occupare <placeName>Tyrrhenum</placeName> et <placeName ref="l1121">Genuensibus</placeName> esse formidabilis.</s>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z11"/>Vale, virorum humanissime, et <persName ref="p8359">Philippum</persName> tuum redamare non desine.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z12"/>Ex <placeName ref="l98">Curia</placeName> die iulii 19. anni 1558.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z13"/>Tuae integritatis totus <persName ref="p8359">Philippus Gallicius</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vere magno viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, bonis <lb xml:id="p2z4"/>omnibus semper <lb xml:id="p2z5"/>colendissimo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
