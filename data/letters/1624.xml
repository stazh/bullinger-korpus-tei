	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">De exemplaribus <placeName ref="l832">Gallicis</placeName><note type="margin">a.R.: s. 22. Apr.</note> distrahendis scripsi ad <persName ref="p3429">Vi<lb xml:id="p1z2"/>retum</persName>.</s>
					<s n="3" xml:lang="la">Ille his verbis respondit: "Conveni hic biblio<lb xml:id="p1z3"/>polam, quem habemus, virum natione <placeName ref="l822">Ger<lb xml:id="p1z4"/>manum</placeName> et spectatae probitatis, qui diu iam nobis<lb xml:id="p1z5"/>cum vixit et omnium bonorum testimonio probatus est, <lb xml:id="p1z6"/>super libris d. <persName ref="p495">Bullinger</persName>i, de quibus ad me scripsisti.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Pollicetur omnem suam operam et fidem, si quid hac in <lb xml:id="p1z8"/>re potest; quia pauper est nec apud nos magnus est <lb xml:id="p1z9"/>concursus mercatorum libros ementium, non potest susci<lb xml:id="p1z10"/>pere distrahendos tanquam mercator, qui eorum curam <lb xml:id="p1z11"/>suscipiat suo aliquo periculo, quod pecuniam non habeat <lb xml:id="p1z12"/>praesentem; sed si mittantur libri, lubens curabit <lb xml:id="p1z13"/>distrahendos pari fide, qua suos ipsius.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Scripsimus <lb xml:id="p1z14"/>etiam <placeName ref="l167">Genevam</placeName> ad bibliopolas, qui hoc multo commo<lb xml:id="p1z15"/>dius praestare poterunt; ubi responsum acceperimus, tibi signi<lb xml:id="p1z16"/>ficabimus."</s>
					<s n="6" xml:lang="la">Haec ille, quę tibi verbotim<note xml:id="fn1" type="footnote" n="1">wörtlich; vgl. <bibl source="b316">Hoven</bibl> 378.</note> adscribere <lb xml:id="p1z17"/>volui, ut tanto melius, quae de hac re spes sit, <lb xml:id="p1z18"/>intelligere et <persName ref="p1283">Gessnero</persName> exponere possis.</s>
					<s n="7" xml:lang="la">Si <placeName ref="l167">Gene<lb xml:id="p1z19"/>vensium</placeName> audiero responsum, quoque significabo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Nihil <lb xml:id="p1z20"/>interea novi.</s>
					<s n="9" xml:lang="la" ana="salute">Tuas accepi una cum libello <lb xml:id="p1z21"/>d. <persName ref="p2305">Negelino</persName> inscripto; hoc illi exhibui, et magnas <lb xml:id="p1z22"/>agit gratias teque plurimum salvere iubet, sic etiam d. <lb xml:id="p1z23"/><persName ref="p3530">Ioannes Rodolphus ab Erlach</persName>, quaestor, <persName ref="p8389">Hagius</persName> et <lb xml:id="p1z24"/>alii.</s>
					<s n="10" xml:lang="la">Heri venit nuncius dominorum nostrorum <lb xml:id="p1z25"/>ex castris Mauritianis, qui 17. ex illis discessit; <lb xml:id="p1z26"/><placeName ref="l513">Ulma</placeName> tamen nondum se dederat, sed erat spes.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Dicit <lb xml:id="p1z27"/>principes apud <placeName ref="l1139">Lintz</placeName> habere conventum; ibi esse <persName ref="p18250">Mau<lb xml:id="p1z28"/>ritium</persName> et <persName ref="p18477">Ferdinandum</persName> quoque <lb xml:id="p1z29"/>illuc venturum; sed <lb xml:id="p1z30"/>vix crediderim, nisi magna subsit proditio.</s>
					<s n="12" xml:lang="la">Si, <lb xml:id="p1z31"/>quid nostris <placeName>Cantonibus</placeName> responsum fuerit, cognoveris, <lb xml:id="p1z32"/>indica nobis, quaeso.</s>
					<s n="13" xml:lang="la">Lindoa reiecto Interim <lb xml:id="p1z33"/>evangelium sponte recepit; dominus illos conservet!</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z34"/>Vereor, ne avellatur iterum a nobis <persName ref="p8417">Musculus</persName>; <lb xml:id="p1z35"/>posset ille facile retineri, sed uxor omnino iam se parat <lb xml:id="p1z36"/>ad abitum neque ullis rationibus, ut maneat, <lb xml:id="p1z37"/>persuaderi vult.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Haec raptim, quia commodus <lb xml:id="p1z38"/>hic mihi ad manum veniebat nuncius.</s>
					<s n="16" xml:lang="la"><persName>Urdorffi</persName> <lb xml:id="p1z39"/>tecum modo lavare non possum quum propter alia <lb xml:id="p1z40"/>multa negotia, tum quia inconsultum videtur <lb xml:id="p1z41"/>hac tempestate diutius et procul ab urbe abesse.</s>
					<s n="17" xml:lang="la" ana="farewell"><lb xml:id="p1z42"/>Bene vale.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">Salutant te nostri; salvi sint omnes tui.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z43"/><placeName ref="l41">Bernę</placeName> 25. aprilis 1552.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">T<lb xml:id="p1z44"/>uus <persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori vigilantissimo, <lb xml:id="p2z4"/>domino et compatri suo <lb xml:id="p2z5"/>charissimo.</s>
				</p>
				<p>
					<s n="22" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zürich</placeName>.</s>
					<s n="23" xml:lang="de"><lb xml:id="p2z7"/>M. <persName ref="p495">Heinrych Bullinger<lb xml:id="p2z8"/>en</persName>.</s>
				</p>
			</div>
		</body>
