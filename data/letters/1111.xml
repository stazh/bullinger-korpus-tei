	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Tuus in me amor singularis meaque in te item perpetua observantia <lb xml:id="p1z2"/>merito postulant, ut gratum me tibi ac memorem exhibeam; nam quod <lb xml:id="p1z3"/>studium mihi tuum, operam ac laborem humaniter praestitisti, veterem <lb xml:id="p1z4"/>tuam in meum patrem humanitatem ac benevolentiam salvam <lb xml:id="p1z5"/>adhuc et integram esse libens agnosco.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Quare, quum tuo officio plurimum <lb xml:id="p1z6"/>adiumenti meis rebus studiisque consulatur, meum erit, quoniam <lb xml:id="p1z7"/>id referre nunquam potero, perpetuo eius tanti beneficii meminisse.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z8"/>Sed utinam eam mihi facultatem aliquando concedat deus, ut possim <lb xml:id="p1z9"/>hunc meum in te animum re potius quam verbis declarare; officio quidem <lb xml:id="p1z10"/>meo ac studio dignitati tuae nunquam sum defuturus.</s>
					<s n="4" xml:lang="la" ana="salute">Id iam, quod <lb xml:id="p1z11"/>unum absens et possum et debeo, salutem tibi et incolumitatem vitae <lb xml:id="p1z12"/>pręcari non desinam; tu contra, velim, amantissime pater (quem <lb xml:id="p1z13"/>enim hoc nomine rectius appellem, non habeo), in ista erga me be<lb xml:id="p1z14"/>nevolentia perseveres ac librum, quem comiti <placeName ref="l3029">Warwicensi</placeName> descriptum <lb xml:id="p1z15"/>te ais, per me et <persName ref="p1560">Hupperum</persName>, cui princeps nihil non in gratiam tuam <lb xml:id="p1z16"/>facturum se est pollicitus, offerri sinas.</s>
					<s n="5" xml:lang="la">Egit quidem <persName ref="p1560">Hupperus</persName> <lb xml:id="p1z17"/>cum comiti accepitque optimum responsum; verum ex eo tempore ipsum <lb xml:id="p1z18"/>ea de re non est allocutus, ita ut nihildum sit confectum.</s>
					<s n="6" xml:lang="la">Tu vero, <lb xml:id="p1z19"/>amantissime pater, libri tui oblatione rem omnem facillime ad <lb xml:id="p1z20"/>exitum perduces, modo per me ac <persName ref="p1560">Hupperum</persName> comiti curetur <lb xml:id="p1z21"/>offerri; quod ut velis te tam rogo quam quod vehementissime.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z22"/><placeName ref="l376">Oxonii</placeName> 16. decembris 1550.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z23"/>Tę amplitudini deditissimus <lb xml:id="p1z24"/><persName ref="p2926">Alexander Schmutz</persName>, in <lb xml:id="p1z25"/>Christo filius.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z26"/>Scriberem ipse ad te, si non plene de omnibus rebus te iam bis fecissem <lb xml:id="p1z27"/>certiorem et iam hac nocte in duabus difficillimis quęstionibus hic in collegio <lb xml:id="p1z28"/>mihi esset respondendum.</s>
					<s n="10" xml:lang="la">Literas principis brevi accipias simul cum <lb xml:id="p1z29"/>meis.</s>
					<s n="11" xml:lang="la">Titulum <placeName ref="l3029">Warwizensis</placeName> hunc habeto: <lb xml:id="p1z30"/><persName ref="p20646">Iohanni Dudleo</persName>, vicecomiti <placeName ref="l3030">Lysse</placeName>', comiti <placeName ref="l3029">Warwizensi</placeName>, hospitio regio praefecto <lb xml:id="p1z31"/>et consiliario<note type="margin">dazu a.R.: "Non appellatur <persName>Heinrichus Cudleus</persName>, ut quondam falso mihi dixerant, sed ut iam scripsi."</note>.</s>
					<s n="12" xml:lang="la">Tute ipse satis, opinor nosti, marchionem comiti <lb xml:id="p1z32"/>honore et dignitate superiorem.</s>
					<s n="13" xml:lang="la">Igitur <placeName ref="l3507">Dorcestrię</placeName> principem principio <lb xml:id="p1z33"/>pones, cuius titulum ipse nosti hic esse: <persName ref="p8068">Heinricho Grayo</persName> marchi<lb xml:id="p1z34"/>oni <placeName ref="l3507">Dorcestriae</placeName>, <persName ref="p8068">domino Ferrers de Gruby, Herington, Bonvyl et Aschle</persName>, regio consiliario.</s>
					<s n="14" xml:lang="la" ana="farewell"><lb xml:id="p1z35"/>Eternum vale, vir optime idemque doctissime.</s>
					<s n="15" xml:lang="la" ana="salute">Salutat <lb xml:id="p1z36"/>t<lb xml:id="p1z37"/>e <persName ref="p21074">Thomas Caius</persName>, urbis huius (archigrammateus) <foreign xml:lang="el">ἀρχιγραμματεύς</foreign>.</s>
					<s n="16" xml:lang="la">Festinans <placeName ref="l376">Oxonii</placeName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z38"/><persName ref="p20172">Iohannes ab Ulmis</persName> t[ibi] d[editus].</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo humanissimoque viro <lb xml:id="p2z2"/>d. <persName ref="p495">Henricho Bullingero</persName>, domino <lb xml:id="p2z3"/>et patrono suo charissimo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
