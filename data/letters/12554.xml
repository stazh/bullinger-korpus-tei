			<zone xml:id="p2z2-0" points="2148,940 2279,929 2362,967 2468,944 2515,967 2726,923 2728,865 2634,854 2582,873 2511,842 2461,873 2374,854 2281,890 2212,861 2150,873">2159,933 2187,928 2216,926 2244,924 2273,922 2302,920 2330,918 2359,916 2388,915 2416,915 2445,915 2474,915 2502,915 2531,915 2560,915 2588,915 2617,914 2646,912 2674,912 2703,911 2732,909</zone>
			<zone xml:id="p2z3-0" points="2143,1046 2208,1029 2355,1062 2410,1027 2482,1058 2549,1021 2619,1019 2711,1044 2738,1040 2740,963 2653,942 2416,969 2145,948">2153,1026 2182,1021 2211,1020 2241,1018 2270,1017 2300,1017 2329,1017 2358,1016 2388,1014 2417,1012 2447,1011 2476,1011 2505,1009 2535,1008 2564,1008 2594,1008 2623,1007 2652,1005 2682,1005 2711,1004 2741,1002</zone>
			<zone xml:id="p2z4-0" points="2110,1141 2224,1152 2387,1119 2484,1143 2607,1106 2719,1133 2723,1048 2621,1017 2486,1058 2256,1046 2229,1066 2164,1042 2114,1060">2121,1115 2151,1115 2181,1113 2211,1111 2242,1108 2272,1106 2302,1104 2332,1102 2363,1100 2393,1100 2423,1099 2453,1097 2484,1097 2514,1097 2544,1097 2574,1095 2605,1094 2635,1094 2665,1090 2695,1088 2726,1088</zone>
		</surface>
