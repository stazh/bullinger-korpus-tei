	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D. P.</s>
					<s n="2" xml:lang="la">Volui paucis <lb xml:id="p1z2"/>tibi significare me salvum <lb xml:id="p1z3"/>et incolumem <placeName ref="l21">Badenam</placeName> venisse.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Hospes meus affinis <lb xml:id="p1z4"/>omnem suam mihi operam promisit et hactenus <lb xml:id="p1z5"/>benevolentia magna me prosequutus est.</s>
					<s n="4" xml:lang="la">Sed tamen <lb xml:id="p1z6"/>de rebus omnibus paucis ad meam <persName ref="p5608">Margaretham</persName> <lb xml:id="p1z7"/>scripsi, nec enim tibi nugis hisce volo molestus esse.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Familiam meam tibi commendo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale <placeName ref="l21">Badenae</placeName> <lb xml:id="p1z9"/>die Mercurii.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Tuus <lb xml:id="p1z10"/>filius <persName ref="p1884">Lavaterus</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>patri suo colendissimo.</s>
					<s n="9" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note>Datum: Kurz vor 22. April 1558.</note>
					<note>Möglicherweise kurz vor L. an HB 29. April (1558).</note>
				</p>
			</div>
		</body>
	</text>
