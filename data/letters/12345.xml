	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem.</s>
					<s n="2" xml:lang="la">Tardius seriusque respondeo ad tuas<note xml:id="fn1" type="footnote" n="1">Oben <ref target="file12325">Nr. 2278</ref>.</note>, vir <lb xml:id="p1z2"/>observande, quia, cum scribere vacat, tabellionibus <lb xml:id="p1z3"/>careo, cum non vacat, ultro se ingerunt.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Haec <lb xml:id="p1z4"/>mox ab initio commemoro, ne aliud subesse suspiceris.<pb type="edition" next="665"/></s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Caussam <persName ref="p8441">Schvenckfeldianam</persName> committamus iu<lb xml:id="p1z6"/>dici deo.</s>
					<s n="5" xml:lang="la">Colloquia hominis virulenti fugiamus.</s>
					<s n="6" xml:lang="la">Si<lb xml:id="p1z7"/>mulat miram sanctimoniam, modestiam et aequitatem, <lb xml:id="p1z8"/>sed exquisite pungit et mordet, nec audiri <lb xml:id="p1z9"/>cupit, ut discat, sed ut aliis affricet suam scabiem.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Vidimus, quam infauste res illius cedant omnes: Tu <lb xml:id="p1z11"/>non mala mente, quae ab aliis acceperas, transscripsisti <lb xml:id="p1z12"/>ad nos,<note xml:id="fn2" type="footnote" n="2"><persName ref="p8418">Myconius</persName> hatte auf die Bitte <persName ref="p18067">Jakob Helds von Tiefenau</persName> hin <persName ref="p8049">Vadian</persName> und <persName ref="p495">Bullinger</persName> <persName ref="p8441">Schwenckfelds</persName> Wunsch nach einem Gespräch mitgeteilt; s. oben <ref target="file12290">Nr. 2243</ref> und Anm. 1.</note> et mox induxisset inter nos qualecunque <lb xml:id="p1z13"/>dissidium mentio illa <persName ref="p8441">Schvenckfeldii</persName> facta,<note xml:id="fn3" type="footnote" n="3">Zu diesen Uneinigkeiten s. zuletzt oben <ref target="file12325">Nr. 2278</ref>, 1-7.</note> nisi charitas <lb xml:id="p1z14"/>intercessisset media.</s>
					<s n="8" xml:lang="la">Omnia enim nunc sublata sunt e <lb xml:id="p1z15"/>medio, et recte habent res.</s>
					<s n="9" xml:lang="la">Caveamus modo, ne quid <lb xml:id="p1z16"/>vobis<note xml:id="fna" type="footnote" n="a"><hi>Die Lesung</hi> nobis <hi>wäre auch möglich.</hi></note> negotii sit cum infausto hoc homine!</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z17"/>Gratias agimus deo optimo maximo, qui victoriam celebrem <lb xml:id="p1z18"/><persName ref="p3590">Hesso</persName><note xml:id="fn4" type="footnote" n="4">Der Sieg <persName ref="p3590">Philipps von Hessen</persName> über Herzog <persName ref="p20318">Heinrich d.J. von Braunschweig-Wolfenbüttel</persName>; s. zuletzt oben <ref target="file12336">Nr. 2289</ref>, 34-42.</note> nostro concessit.</s>
					<s n="11" xml:lang="la">Is concedat optimo principi, ut <lb xml:id="p1z19"/>victoria recte et bene utatur atque sic tractet <lb xml:id="p1z20"/><persName ref="p19821">Hagagum</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p19821">Agag</persName>, König der <persName ref="p20851">Amalekiter</persName>. Saul schonte ihn entgegen Gottes Anweisungen und wurde deshalb von Gott verworfen; s. Sam 15.</note> et <persName ref="p20850">Benhadad</persName><note xml:id="fn6" type="footnote" n="6">Siehe oben <ref target="file12331">Nr. 2284</ref>, Anm. 17.</note>, ne uspiam sibi numinis iram<note xml:id="fn7" type="footnote" n="7">numinis iram: Vgl. z.B. <hi>Ovid,</hi> Metamorphosen, 2, 659, u.ö.</note> <lb xml:id="p1z21"/>contrahat.</s>
					<s n="12" xml:lang="la">Ego suspicor ac vereor illa ingentis <lb xml:id="p1z22"/>belli incendiique maximi fore initia.</s>
					<s n="13" xml:lang="la">Notum est illud <lb xml:id="p1z23"/>crudele, ambitiosum, superbum et impium ingenium <lb xml:id="p1z24"/><placeName ref="l875">Hispanicum</placeName><note xml:id="fn8" type="footnote" n="8">Kaiser <persName ref="p18538">Karl V.</persName></note>, cui multi magnates flammas subiiciunt<lb xml:id="p1z25"/>, quo aestuet ferocius.</s>
					<s n="14" xml:lang="la">Quod colloquium<note xml:id="fn9" type="footnote" n="9">Das Zweite <placeName ref="l410">Regensburger</placeName> Religionsgespräch; s. oben <ref target="file12268">Nr. 2221</ref>, Anm. 5.</note> offert, <lb xml:id="p1z26"/>pro ingenio suo <placeName ref="l875">Hispanico</placeName> offert: Id quod eventus, <lb xml:id="p1z28"/>nisi dominus praevenerit, declarabit.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Pro iis, quae di<lb xml:id="p1z29"/>ligenter consignasti in tuis, ingentes ago gratias.</s>
					<s n="16" xml:lang="la">Si quid <lb xml:id="p1z30"/>habes praeterea de exercitu et instituto <persName ref="p3590">Hessi</persName>, de <lb xml:id="p1z31"/>bello <placeName ref="l830">Anglico</placeName> vel <placeName ref="l832">Gallico</placeName>,<note xml:id="fn10" type="footnote" n="10">Zu den Verhandlungen zwischen <placeName ref="l832">Frankreich</placeName> und <placeName ref="l830">England</placeName> unter Leitung der deutschen Protestanten bzw. des Kaisers s. oben <ref target="file12325">Nr. 2278</ref>,23-27, und unten <ref target="file12348">Nr. 2301</ref>, Anm. 17 und 19.</note> item de comitiis <placeName ref="l157">Franc<lb xml:id="p1z32"/>fordianis</placeName><note xml:id="fn11" type="footnote" n="11">Zum <placeName ref="l1202">Schmalkaldischen</placeName> Bundestag in <placeName ref="l157">Frankfurt</placeName> s. oben Nr. 2285, Anm. 37.</note> similibusque scitu dignis, oro communices.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z33"/>Literas electoris <persName ref="p19065">Saxonis</persName><note xml:id="fn12" type="footnote" n="12"><persName ref="p19065">Johann Friedrich I. von Sachsen</persName>.</note> et <persName ref="p3590">Hessi</persName> ad <placeName ref="l491">Argentinenses</placeName> <lb xml:id="p1z34"/>scriptas<note xml:id="fn13" type="footnote" n="13">Am 18. November hatte <persName ref="p495">Bullinger</persName> von <persName ref="p8055">Ambrosius Blarer</persName> eine Abschrift dieses von <persName ref="p19065">Johann Friedrich I. von Sachsen</persName> und Landgraf <persName ref="p3590">Philipp von Hessen</persName> an den Rat von <placeName ref="l491">Straßburg</placeName> geschriebenen Briefes erhalten, wovon er sich eine Kopie anfertigen ließ; s. oben <ref target="file12333">Nr. 2286</ref> und Anm. 7.</note>, ut <persName ref="p467">Bucerum</persName> <placeName ref="l410">Ratisponam</placeName> mittant ad colloquium, l<lb xml:id="p1z35"/>egi.</s>
					<s n="18" xml:lang="la">Quod moneo, ne id scriptum mittas, si fort<lb xml:id="p1z36"/>e <lb xml:id="p1z37"/>habes et missurus eras.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute">Rediit e <placeName ref="l306">Mediolano</placeName> <lb xml:id="p1z38"/>legatus noster<note xml:id="fn14" type="footnote" n="14">Unbekannt. -Zur Angelegenheit s. zuletzt oben <ref target="file12335">Nr. 2288</ref> und Anm. 4.</note>, quem nondum salutavi.</s>
					<s n="20" xml:lang="la">Audio tamen ab <lb xml:id="p1z39"/>aliis marchionem<note xml:id="fn15" type="footnote" n="15">Der <placeName ref="l875">Spanier</placeName> <persName ref="p7251">Alfonso d'Avalos</persName>, Marchese del <placeName ref="l3273">Vasto (Guasto)</placeName>, Statthalter von <placeName ref="l306">Mailand</placeName>.</note> illos non admisisse ad colloquium, <lb xml:id="p1z41"/>nisi post diem 9.,<pb type="edition" next="666"/> cumque mandata illi exposuissent, respondisse illum [p]aucis<note xml:id="fnb" type="footnote" n="b">[p]aucis et <hi>am Rande nachgetragen. Hier und unten Text teilweise im engen Einband verdeckt.</hi></note> et s<lb xml:id="p1z42"/>uperbe relationem<note xml:id="fnc" type="footnote" n="c">relationem legatorum esse imperiosam <hi>über der Zeile nachgetragen.</hi></note> le<lb xml:id="p1z43"/>gatorum esse imperiosam nolui<lb xml:id="p1z44"/>sseque responsionem dare aliam quam <lb xml:id="p1z45"/>literis inclusam obsignatamque, <lb xml:id="p1z46"/>quam et attulere [o]mnibus<note xml:id="fnd" type="footnote" n="d">[o]mnibus <placeName ref="l862">Hel[v]etiorum</placeName> inscriptam [o]rdinibus <hi>am Rande nachgetragen.</hi></note> <lb xml:id="p1z47"/><placeName ref="l862">Hel[v]etiorum</placeName> inscriptam [o]rdinibus<note xml:id="fn16" type="footnote" n="16">Der Brief vom 13. November 1545 war an die zu <placeName ref="l21">Baden</placeName> versammelten Boten der XII Orte gerichtet; s. <bibl source="b197">EA</bibl> IV/Id 560, Nr.2.</note>.</s>
					<s n="21" xml:lang="la">Sic, inquam, audio.</s>
					<s n="22" xml:lang="la">Ubi habuero <lb xml:id="p1z48"/>certiora, scribam<note xml:id="fn17" type="footnote" n="17">Mit dem Brief vom 6. Dezember (unten <ref target="file12351">Nr. 2304</ref>).</note>.</s>
					<s n="23" xml:lang="la">Ego nihil dubito <placeName ref="l875">Hispanum</placeName> <lb xml:id="p1z49"/>quaerere nocendi subiugandique occasiones.</s>
					<s n="24" xml:lang="la">Dominus perdat <lb xml:id="p1z50"/>nebulonem impiissimum crudelissimumque.</s>
				</p>
				<p>
					<s n="25" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z51"/>una cum omnibus tuis.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 27. novembris 1545.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p1z52"/>Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="28" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8418">Osvaldo <lb xml:id="p2z2"/>Myconio</persName>, <placeName ref="l28">Basiliensis</placeName> ecclesiae ant<lb xml:id="p2z3"/>istiti vigilantissimo, suo in domino <lb xml:id="p2z4"/>colendissimo charissimoque fratri.</s>
					<s n="29" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
