	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D. P.</s>
					<s n="2" xml:lang="la">Accepi posteriores post primas literas tuas (christianissime vir), quibus ante triduum <lb xml:id="p1z2"/>respondi.</s>
					<s n="3" xml:lang="la">Sed quia per rhedarium tardius fortasse perferentur, volui rursus monere <lb xml:id="p1z3"/>me et pharmacopolę importunitati et aliis satisfecisse, nec amplius quisquam, nisi <lb xml:id="p1z4"/>stultus sit, hac de re vel alia me interveniente vexabit te, quem scio alioqu<lb xml:id="p1z5"/>i longe maioribus et melioribus rebus occupatissimum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Libenter viderem, quae in <persName ref="p6589">Serveti</persName> <lb xml:id="p1z6"/>haeresiarchae caussam ad <placeName ref="l167">Genevenses</placeName> scripsisti, ut <persName ref="p3375">Vergerius</persName> noster me monuit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>De illo nihil amplius audio aliquem mussitantem.</s>
					<s n="6" xml:lang="la">Novarum rerum nihil te dignum habeo.</s>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z8"/>Bene vale.</s>
					<s n="8" xml:lang="la">Ex <placeName ref="l28">Basilea</placeName> tertio nonas novembris 1553.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">[<lb xml:id="p1z9"/>Tuus, si quis alius,] <lb xml:id="p1z10"/><persName ref="p1327">Gulielmus Gratarolus</persName>, medicus.</s>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Optimo domino <persName ref="p495">Bullingero</persName>, pastori etc. <lb xml:id="p2z2"/><foreign xml:lang="de">zuͦ <placeName ref="l587">Zürich</placeName>.</foreign></s>
				</p>
			</div>
		</body>
	</text>
