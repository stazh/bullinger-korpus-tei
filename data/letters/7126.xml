	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Sal. in Christo, clarissime d. <persName ref="p495">Bullingere</persName>, ac frater <lb xml:id="p1z2"/>in domino charissime!</s>
					<s n="2" xml:lang="la">Ago tibi gratias ex animo, quod literas <lb xml:id="p1z3"/>meas tam grato animo accepisti; similiter etiam pro <lb xml:id="p1z4"/>homiliis tuis in Esaiam, quas accepi per d. <persName ref="p6">Iohannem Abelum</persName>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Ad literas vestras mense septembri per <persName>Wiburnum</persName> missas, <lb xml:id="p1z6"/>sed ab alio traditas, respondimus d. <persName ref="p7497">Wintoniensis</persName> atque ego <lb xml:id="p1z7"/>superioribus nundinis <placeName ref="l157">Franckfordianis</placeName>; et illas literas <lb xml:id="p1z8"/>spero vos iamdudum accepisse.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Quod ad publicationem <lb xml:id="p1z9"/>epistolae de re vestiaria attinet, sciebam quidem vos <lb xml:id="p1z10"/>eam non in hoc scripsisse ut aederetur; sed quia ex <lb xml:id="p1z11"/>publicatione magnam ecclesiarum nostrarum utilitatem <lb xml:id="p1z12"/>consequuturam certo previdebam, vos hoc aequo animo <lb xml:id="p1z13"/>laturos esse mihi persuadebam.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Res nostrae eodem <lb xml:id="p1z14"/>fere in statu sunt, quo hactenus fuere.</s>
					<s n="6" xml:lang="la">Habemus <lb xml:id="p1z15"/>iam apud nos comitem a <placeName ref="l1607">Stolberg</placeName>, Germanum, legatum <lb xml:id="p1z16"/>a <persName>Caesare Maximiliano</persName>.</s>
					<s n="7" xml:lang="la">Petit (uti audio) annuum <lb xml:id="p1z17"/>subsidium pecuniarium ad bellum <placeName ref="l2510">Turcicum</placeName>.</s>
					<s n="8" xml:lang="la">Sed non <lb xml:id="p1z18"/>videtur hic aliquid impetraturus, nisi caetera regna <lb xml:id="p1z19"/>ac provinciae in commune conferant.</s>
					<s n="9" xml:lang="la">Est etiam <lb xml:id="p1z20"/>aliquis sermo de matrimonio inter reginam nostram <lb xml:id="p1z21"/>et <persName>Carolum Austriacum</persName>; sed in omni tractatione semper <lb xml:id="p1z22"/>cavetur de religione.</s>
					<s n="10" xml:lang="la">Itaque nisi <persName>Carolus</persName> papismo <lb xml:id="p1z23"/>renunciare velit, non habet hic, quod speret.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/><placeName ref="l2524">Scotia</placeName> iam in novos motus incidit.</s>
					<s n="12" xml:lang="la">Henricus, nuper <lb xml:id="p1z25"/><persName ref="p18212">Scotiae rex</persName> (uti te audivisse existimo) 10. februarii <lb xml:id="p1z26"/>elapsi in horto quodam hospitio suo (quod extra aulam <lb xml:id="p1z27"/>habebat) adiacente inventus est mortuus.</s>
					<s n="13" xml:lang="la">De genere m<lb xml:id="p1z28"/>ortis nondum convenit apud omnes.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z29"/>Alii dicunt, incensis <lb xml:id="p1z30"/>vasis aliquot pulveris tormentarii, quae sub cubiculo, <lb xml:id="p1z31"/>in quo dormiebat, ex industria reposita fuerant, aedes <lb xml:id="p1z32"/>eversas atque ipsum in hortum proximum proiectum fuisse.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z33"/>Alii vere, intempesta nocte vi extractum e cubiculo, <lb xml:id="p1z34"/>et postea strangulatum, ac tum demum incenso pulvere ae<lb xml:id="p1z35"/>des disiectas fui<lb xml:id="p1z36"/>sse, affirmant.</s>
					<s n="16" xml:lang="la">Huius caedis <lb xml:id="p1z37"/>apud omnes suspectus fuit comes quidam nomine <persName>Bot<lb xml:id="p1z38"/>hwellius</persName>.</s>
					<s n="17" xml:lang="la">Huic comiti, postquam uxorem legit<lb xml:id="p1z39"/>ti<lb xml:id="p1z40"/>mam <pb/><lb xml:id="p2z1"/>interveniente authoritate archiepiscopi <persName>S. Andreae</persName> <lb xml:id="p2z2"/>repudiasset, 15 maii nupsit <persName ref="p18212">Scotiae regina</persName>, <lb xml:id="p2z3"/>atque eundem ex comite <placeName>Orchadum</placeName> ducem <lb xml:id="p2z4"/>creavit.</s>
					<s n="18" xml:lang="la">Paulo ante hoc matrimonium omnes <lb xml:id="p2z5"/>fere regni proceres, quum nullam in caedem regis <lb xml:id="p2z6"/>inquisitionem institui viderent, discesserunt ex aula, <lb xml:id="p2z7"/>et seorsum apud <placeName>Sterlynum</placeName> oppidum conventum <lb xml:id="p2z8"/>habuerunt.</s>
					<s n="19" xml:lang="la">In hoc conventu certis inditiis <lb xml:id="p2z9"/>nefandam hanc caedem a <persName>Bothwellio</persName> perpetratam <lb xml:id="p2z10"/>fuisse compertum est.</s>
					<s n="20" xml:lang="la">Itaque collecto exercitu <lb xml:id="p2z12"/>ipsum comprehendere satagunt: <persName>Bothwellius</persName> vero dat <lb xml:id="p2z13"/>se in fugam; sed quo profugerit, adhuc <lb xml:id="p2z14"/>nescitur.</s>
					<s n="21" xml:lang="la">Reginam alii aiunt obsideri in arce <lb xml:id="p2z15"/>quadam; alii vero in arce <placeName ref="l130">Edinburgensi</placeName>, tanquam necis <lb xml:id="p2z16"/>mariti consciam, captivam detineri asserunt.</s>
					<s n="22" xml:lang="la"><lb xml:id="p2z17"/>Quomodocunque sit, infames illae nuptiae non possunt <lb xml:id="p2z18"/>non in aliquam diram tragoediam desinere.</s>
					<s n="23" xml:lang="la"><lb xml:id="p2z19"/>Sed de hiis omnibus expectamus in dies certiora, de <lb xml:id="p2z20"/>quibus efficiam brevi ut cognoscas.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">De persequut<lb xml:id="p2z21"/>ionibus <placeName ref="l640">Flandricis</placeName> nihil scribo, quod eas vos non <lb xml:id="p2z22"/>latere existimem.</s>
					<s n="25" xml:lang="la">Multa apud nos iactata sunt de <lb xml:id="p2z23"/>obsessa <placeName ref="l167">Geneva</placeName>; sed spero vana esse.</s>
					<s n="26" xml:lang="la">Dominus <lb xml:id="p2z24"/>Iesus pietatem tuam nobis et ecclesiae incolumem conservet!</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p2z25"/><placeName ref="l296">Londini</placeName> 21. iunii 1567<lb xml:id="p2z26"/>.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p2z27"/>Deditissimus tibi in domino <lb xml:id="p2z28"/><persName ref="p1341">Edmundus Grindallus</persName>, <lb xml:id="p2z29"/>episcopus <placeName ref="l296">London</placeName>.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><pb/><lb xml:id="p4z1"/>Reverendo in Christo <lb xml:id="p4z2"/>d. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p4z3"/><placeName ref="l587">Tigurinae</placeName> ecclesię <lb xml:id="p4z4"/>ministro fidelissimo et <lb xml:id="p4z5"/>fratri in Christo <lb xml:id="p4z6"/>charissimo.</s>
					<s n="30" xml:lang="la"><lb xml:id="p4z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
