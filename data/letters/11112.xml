	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et vita innocentiam a Deo.</s>
					<s n="2" xml:lang="la">Iheremiam cum tandem absolvissem, <lb xml:id="p1z2"/>ad te remittere curavi.</s>
					<s n="3" xml:lang="la">Cuidam institori una cum <persName ref="p18207">Luciano</persName> <placeName ref="l2531">Graeco</placeName> commisi, <lb xml:id="p1z3"/>ut mercibus suis addat tibique representet; rebar enim, quod hoc modo tutissime <lb xml:id="p1z4"/>ad te remigraret.</s>
					<s n="4" xml:lang="la"><persName ref="p18207">Lucianum</persName> <persName ref="p6130">Pontasellae</persName> mitto, ut illo utatur et mundum servet.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Missuri sumus etiam pecuniam aliquam in usum ipsius; sed nundinarum <lb xml:id="p1z6"/>strepitus et certa quedam negotia impedierunt me, ut corradere nunc non <lb xml:id="p1z7"/>potuerim; mittam tamen propediem.</s>
					<s n="6" xml:lang="la">Ago insuper et habeo magnas gratias, <lb xml:id="p1z8"/>primum quod misellum in curam tuam susceperis, ne a studio literarum inopia victus <lb xml:id="p1z9"/>arceatur, deinde quoque quod librum illum tibi charissimum, mihi denique utilissimum <lb xml:id="p1z10"/>commodaveris.</s>
					<s n="7" xml:lang="la">Cum nihil haberem te dignum, quod referrem, dedi operam, <lb xml:id="p1z11"/>ut liberis tuis munusculum mitterem castaneas perpaucas.</s>
					<s n="8" xml:lang="la">Sed haec <lb xml:id="p1z12"/>minime digna sunt, ut commemorem.</s>
					<s n="9" xml:lang="la">Sacculus <persName ref="p6130">Ioanni Pontasellae</persName> reddatur.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z13"/>Nihil apud nos agitur neque fertur, quod tuis auribus dignum sit; <lb xml:id="p1z14"/>tantum hoc praecor, ut me in amicorum tuorum albo recenseas.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale, <lb xml:id="p1z15"/>vir doctissime.</s>
					<s n="12" xml:lang="la">Ex <placeName ref="l98">Curia Rhetiae</placeName>, quarta decima kalendas Decembres 37.</s>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z16"/>Plurimum salvere iubeo <persName ref="p1753">Leonem</persName> nostrum et <persName ref="p8127">Cůnradum Pellicanum</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z17"/>Tuus <persName ref="p654">Ioannes Comander</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro magi<lb xml:id="p2z2"/>stro <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae antistiti, <lb xml:id="p2z5"/>domino et amico suo <lb xml:id="p2z6"/>primario.</s>
				</p>
			</div>
		</body>
	</text>
