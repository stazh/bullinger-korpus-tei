	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quamvis de rebus nostris omnibus et publicis et privati<lb xml:id="p1z2"/>s certiores vos reddere possit noster ille <persName ref="p8449">Telamonius Samuel</persName>, <lb xml:id="p1z3"/>nolui tamen intermittere, quin per ipsum quoque aliquid <lb xml:id="p1z4"/>scriberem, saltem ne meo defuisse videar officio.</s>
					<s n="3" xml:lang="la">Exercet <lb xml:id="p1z5"/>quidem me rursus et podagra et chiragra, ita ut diffi<lb xml:id="p1z6"/>culter scribam; sed amoris mei erga vos vis dolores <lb xml:id="p1z7"/>istos facile superat, qui quidem, licet interdum acerbi satis <lb xml:id="p1z8"/>sint, nondum tamen hoc tempore per domini gratiam me lecto <lb xml:id="p1z9"/>affixerunt.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Expecto vero subinde vestras et miror, quod <lb xml:id="p1z10"/>tanto tempore nihil scribatis; suspicor tamen id tabellionum <lb xml:id="p1z11"/>fieri penuria.</s>
					<s n="5" xml:lang="la">Scripseram nuper quędam de rumoribus, quos <lb xml:id="p1z12"/>ex <placeName ref="l832">Gallia</placeName> allatos acceperamus; resederunt vero ista rege, <lb xml:id="p1z13"/>ut audio, authoritatem suam ubique graviter, ut pax re<lb xml:id="p1z14"/>tineatur, interponente.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Sparguntur ab eo tempore alia, quae <lb xml:id="p1z15"/>tamen, quoniam non fidem, ideo etiam non scriptionem merentur.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>Sabaudię ducem sibi ab amiralio metuere certum est, ne <lb xml:id="p1z17"/>cum <placeName ref="l167">Genevensibus</placeName> aliquid contra ipsum moliatur, nec potuit <lb xml:id="p1z18"/>metum hunc apud nostros dissimulare; sed proprium tyrannorum <lb xml:id="p1z19"/>est metuere semper.</s>
					<s n="8" xml:lang="la">Nec tamen mirum esset, si toties <lb xml:id="p1z20"/>laesa <placeName ref="l167">Genevensium</placeName> patientia in furorem tandem erumperet, <lb xml:id="p1z21"/>ut non omnino frustra sibi metuere videatur.</s>
					<s n="9" xml:lang="la">De rebus <lb xml:id="p1z22"/><placeName ref="l862">Heveticis</placeName> non est quod scribam, cum illae sint vobis notiores.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Cur non conceditur <placeName>Subsylvanis</placeName>, ut devorent <placeName ref="l2510">Turcam</placeName>.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/>Audio comitia hoc nomine conscripta; quę quid ferant, expec<lb xml:id="p1z25"/>tabimus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Nobis adhuc cum annonae caritate res est; quę <lb xml:id="p1z26"/>utinam desinat brevi.</s>
					<s n="13" xml:lang="la">Si quae sunt reliqua, petes ea a nostro <lb xml:id="p1z27"/>hoc, qui, cum quotidie mecum sit, omnia referre poterit.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z28"/>Consules, quęstores, <persName ref="p7449">Diesbachius</persName>, socer, uxor et amici omnes te <lb xml:id="p1z29"/>plurimum salutant; salutem dic tuis quoque, inter quos etiam <lb xml:id="p1z30"/>omnes fratres numero, ex me officiosissime.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l41">Bernę</placeName> <lb xml:id="p1z31"/>29. ianuarii 1572.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z32"/><persName ref="p8018">Ioh[annes] Hallerus</persName>, <lb xml:id="p1z33"/>tuus semper.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo dilectissimoque viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori fideli<lb xml:id="p2z4"/>ssimo, domino suo honorando <lb xml:id="p2z5"/>et compatri charissimo.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><lb xml:id="p2z6"/>M. <persName ref="p495">Heinrych Bullinger<lb xml:id="p2z7"/>en</persName> zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
