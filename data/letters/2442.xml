	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem Christi servatoris omnium.</s>
					<s n="2" xml:lang="la">Non <lb xml:id="p1z2"/>ego tanta fiducia vel potius audacia fuissem unquam, <lb xml:id="p1z3"/>observande d. <persName ref="p495">Bullingere</persName>, qui meis aliquando te <lb xml:id="p1z4"/>literis appellarem, tua quamvis bonitate multum confisus <lb xml:id="p1z5"/>et humanitate fretus, utpote cui poteram id en<lb xml:id="p1z6"/>comii vere tribuere, quod ad condonandum facile sis, <lb xml:id="p1z7"/>si quid adversum te vel confidentius vel etiam impu<lb xml:id="p1z8"/>dentius admissum esset.</s>
					<s n="3" xml:lang="la">Nunc ad illud <foreign xml:lang="el">συγγνωσμονικόν</foreign> <lb xml:id="p1z9"/>tuum, quia ad te scribendi necessaria quaedam ac<lb xml:id="p1z10"/>cessit alia causa, diutius id nolui detractare.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Haud <lb xml:id="p1z11"/>ita multi praeteriere dies, quod socer meus d. <persName ref="p8417">Musculus</persName> <lb xml:id="p1z12"/>quibusdam de causis <placeName ref="l28">Basileae</placeName> fuit apud <persName ref="p5213">Hervagium</persName> ty<lb xml:id="p1z13"/>pographum.</s>
					<s n="5" xml:lang="la">Iussit ibi filio suo <persName>Abrahamo</persName>, qui duo <persName>Ge<lb xml:id="p1z14"/>neseos</persName> ab <persName ref="p5213">Hervagio</persName> nuper excusa mihi mitteret exemplaria, <lb xml:id="p1z15"/>quorum alterum ego <placeName ref="l587">Tigurum</placeName> ad te transmitterem.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z16"/>Iter, quod hinc isthuc ducit, quia minus frequens est, <lb xml:id="p1z17"/>usus sum opera d. <persName ref="p8014">Petri Sartoris</persName>, <placeName>Arburgensis</placeName> ecclesiastae, <lb xml:id="p1z18"/>qui quia illinc ad vos est regia via, librum istum <lb xml:id="p1z19"/>ad te transferri curavit; nam alioquin est rarum quiddam <lb xml:id="p1z20"/>fidus tabellarius, cui quidvis audeas tuto committere.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z21"/>Te, observande d. <persName ref="p495">Bullingere</persName>, rogatum velim, ut, <lb xml:id="p1z22"/>quam potes primum, si non per literas, alia tamen quo<lb xml:id="p1z23"/>cunque fiat modo, significes, num, quod a me missum <lb xml:id="p1z24"/>est, receperis, non quidem quasi qui mihi responderi <lb xml:id="p1z25"/>urgeam propterea, quod ipse scripsi, sed quo tranquillior <lb xml:id="p1z26"/>ego sim magisque securus tanquam de libro curato <lb xml:id="p1z27"/>possimque socero meo d. <persName ref="p8417">Musculo</persName> certam aliquam reddere rationem.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z28"/>Quod reliquum est, hac epistolium petitione <lb xml:id="p1z29"/>concludam te rogans, qui me tibi semper velis habere <lb xml:id="p1z30"/>commendatum; ego me vicissim in omnibus, quę discipulum <lb xml:id="p1z31"/>decent, officiis paratissimum offero.</s>
					<s n="9" xml:lang="la">Multum enim me <placeName ref="l587">Tigurin<lb xml:id="p1z32"/>is</placeName> debere libenter agnosco, quippe qui scholae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p1z33"/>fuerim alumnus et discipulus aliquamdiu.</s>
					<s n="10" xml:lang="la">Ea praeter <lb xml:id="p1z34"/>beneficia tibi me tuaeque domui multum devinctum esse fateor; <lb xml:id="p1z35"/>nam in principiis artis ludendi testudine tuus me filius <persName>Hein<lb xml:id="p1z36"/>rychus</persName> instituit, dialecticam <persName ref="p1884">Lud[ovicus] Lavaterus</persName> tradidit, arith<lb xml:id="p1z37"/>metices, quę mathemathum, quas vocant, mater est, praeceptis <persName ref="p8442">Simlerus</persName> <lb xml:id="p1z38"/>imbuit.</s>
					<s n="11" xml:lang="la">Ita quidem non immerito tibi tuisque faveo prae caete<lb xml:id="p1z39"/>ris.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale, observande d. <persName ref="p495">Bullingere</persName>.</s>
					<s n="13" xml:lang="la" ana="salute">Salutabis meo <lb xml:id="p1z40"/>nomine liberos tuos et generos, d. m. <persName ref="p7228">Huldr[ychum] Zvinglium</persName>, <persName ref="p1884">Lavaterum</persName> <lb xml:id="p1z41"/>et <persName ref="p8442">Simlerum</persName>.</s>
					<s n="14" xml:lang="la"><placeName ref="l582">Zofingae</placeName> 1554 pridie calendas novembris.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><persName ref="p8052">Valentinus Ampelander</persName> <lb xml:id="p1z42"/>totus tibi deditissimus.</s>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. m. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z4"/>vigilantissimo, domino <lb xml:id="p2z5"/>suo plurimum <lb xml:id="p2z6"/>observando<lb xml:id="p2z7"/>.</s>
					<s n="17" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zürych</placeName>.</s>
				</p>
			</div>
		</body>
