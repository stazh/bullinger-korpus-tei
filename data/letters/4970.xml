	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S.
					<lb xml:id="p1z2"/>P. Cum te ac reliquos tuos collegas scepissime
					<lb xml:id="p1z3"/>de nostra ecclesia cogitare sciam, utrisque precibus
					<lb xml:id="p1z4"/>prosperum successum sanctissimi incepti optare.
					<lb xml:id="p1z5"/>merito vos amare atque colere debemus.
					<lb xml:id="p1z6"/>Quod et facimus, mi Bullingere, adeo ut
					<lb xml:id="p1z7"/>nulla dies fere praetereat, in qua non
					<lb xml:id="p1z8"/>in mro colloquio theologico tui ac tuorum
					<lb xml:id="p1z9"/>honorifica benevolentiaeque plena menti
					<lb xml:id="p1z10"/>habeatur. Statum ecclesiae atque scholae
					<lb xml:id="p1z11"/>nostrae arbitror te ex literis Erasti mstri
					<lb xml:id="p1z12"/>cognovisse. Begumus Enamel et
					<lb xml:id="p1z13"/>olimanus sacra publice profitentur.
					<lb xml:id="p1z14"/>quorum eruditio, pietas animorumque
					<lb xml:id="p1z15"/>consensus tibi notus est. In templis
					<lb xml:id="p1z16"/>quatuor ministri docent, qui et recte
					<lb xml:id="p1z17"/>in pura doctrina instituti et populo
					<lb xml:id="p1z18"/>ob morum integritatem ac fraternam cons
					<lb xml:id="p1z19"/>grati sunt. Hos omnes opere
					<lb xml:id="p1z20"/>dlaturos spero, ut non solum gratia
					<lb xml:id="p1z21"/>missimum vulmus, partium a funciosis
					<lb xml:id="p1z22"/>consadiatoribus, partim ab impueis hypea
					<lb xml:id="p1z23"/>tis inflictum sanent, verum etiam
					<lb xml:id="p1z24"/>distractum ad veram cognitionem
					<lb xml:id="p1z25"/>mysteriorum dei perducant. Quos
					<lb xml:id="p1z26"/>dominus noster Iesus Christus suo spiritu
					<lb xml:id="p1z27"/>ita iuvare ac opus sem, quod incepit
					<lb xml:id="p1z28"/>ad ipsius gloriam confirmare atque
					<lb xml:id="p1z29"/>perficere velit, ut fanctus quam uberrimus
					<lb xml:id="p1z30"/>sequatur. Vale, mi Bullingere et cirte
					<lb xml:id="p1z31"/>in munerum tuorum ponas Hedelc.
					<lb xml:id="p1z32"/>bergae 18. septembris anno etc. 6.
					<lb xml:id="p1z33"/>Tuus ex onimum
					<lb xml:id="p1z34"/>Stephamus Cielerus.
					<lb xml:id="p1z35"/>secretarius.
					<pb/>
					<lb xml:id="p2z1"/>Clarissimo viro doctrina ac pietatie
					<lb xml:id="p2z2"/>praestanti d. Henrico Bullingero,
					<lb xml:id="p2z3"/>ecclesiae Tigurinae pastori
					<lb xml:id="p2z4"/>fidelissimo, domino et amico singulia
					<lb xml:id="p2z5"/>ari observantia praesequendo.
					<lb xml:id="p2z6"/>S.
					<lb xml:id="p2z7"/>Tignoi.
				</p>
			</div>
