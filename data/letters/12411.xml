	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Venimus<note xml:id="fn1" type="footnote" ana="bio" n="1">Nämlich <persName ref="p8018">Haller</persName>, seine Frau <persName ref="p5131">Elsbeth, geb. Kambli</persName>, und Töchterchen <persName ref="p20735">Agnes</persName> sowie ein Reiter namens <persName ref="p6930">Marx Vogel</persName> aus <placeName ref="l587">Zürich</placeName>, den <persName ref="p1888">Hans Rudolf Lavater</persName> mit der Begleitung der Familie <persName ref="p8018">Haller</persName> beauftragt hatte; s. Zürich StA, Seckelamt Rechnungen F III 32, Rechnungsbuch 1545/46, S. 100, der Ausgabenabteilung. - Vgl. ferner <ref target="file12417">Nr. 2370</ref>,25f.</note> <placeName ref="l18">Augustam</placeName> ultimo februarii, <lb xml:id="p1z2"/>salvi quidem, sed itinere valde <lb xml:id="p1z3"/>difficili propter ventorum vehementiam<note xml:id="fn2" type="footnote" n="2">Zum strengen Winter 1545/46 s. <ref target="file12379">Nr. 2332</ref> und Anm. 20; <ref target="file12384">Nr. 2337</ref> und Anm. 2.</note>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Excepit nos honorificentissime iterum<note xml:id="fn3" type="footnote" n="3">Nämlich wie schon im November 1545; s. <bibl source="b18">HBBW XV</bibl> 647.7-12. 649f.</note> <lb xml:id="p1z5"/>senatus.</s>
					<s n="4" xml:lang="la">Adhaec <persName ref="p8354">Laetus</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p8354">Georg Frölich</persName>.</note> noluit pro <lb xml:id="p1z6"/>solita sua humanitate et benevolentia, <lb xml:id="p1z7"/>ut apud quemquam alium quam apud <lb xml:id="p1z8"/>ipsum diverterem<note xml:id="fn5" type="footnote" n="5">= deverterem.</note>, donec omnia, quae <lb xml:id="p1z9"/>ad rem domesticam attinent, abunde <lb xml:id="p1z10"/>pararentur.</s>
					<s n="5" xml:lang="la">Aedesque construxere novas.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Ornarunt interim splendide suppellectile <lb xml:id="p1z12"/>et omnibus utensilibus comparatis; qua <lb xml:id="p1z13"/>in re multum laboravit et adhuc <lb xml:id="p1z14"/>laborat consul <persName ref="p3927">Welserus</persName><note xml:id="fn6" type="footnote" n="6">Altbürgermeister <persName ref="p3927">Hans Welser</persName>.</note>.</s>
					<s n="7" xml:lang="la">Praeterea <lb xml:id="p1z15"/>omnes magna cum benevolentia <lb xml:id="p1z16"/>indigno<note xml:id="fn7" type="footnote" n="7">indigno: dem Unwürdigen. - <persName ref="p8018">Haller</persName> meint sich selbst.</note> quamvis sua offerunt officia.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p8417">Musculus</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p8417">Wolfgang Musculus</persName>.</note> quid ad lectas literas tuas<note xml:id="fn9" type="footnote" n="9"><persName ref="p495">Bullingers</persName> Brief an <persName ref="p8417">Wolfgang Musculus</persName> vom 18. Februar 1546 (<ref target="file12405">Nr. 2358</ref>).</note> <lb xml:id="p1z18"/>responderit, ignoro;<note xml:id="fn10" type="footnote" n="10"><persName ref="p8417">Musculus</persName> antwortete am 30. März 1546 (<ref target="file12446">Nr. 2399</ref>).</note> nondum enim conven<lb xml:id="p1z19"/>i interim eum, qui tamen humaniter <lb xml:id="p1z20"/>me excepit.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="9" xml:lang="la"><persName ref="p8440">Gervasius</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p8440">Gervasius Schuler</persName>.</note> <placeName ref="l320">Memmingę</placeName> <lb xml:id="p1z21"/>cum gaudio nos suscepit magno.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z22"/>Postquam autem ei literas dedi tuas,<note xml:id="fn12" type="footnote" n="12"><persName ref="p495">Bullingers</persName> Brief an <persName ref="p8440">Schuler</persName> vom 20. Februar 1546 (<ref target="file12408">Nr. 2361</ref>).</note> domum <lb xml:id="p1z23"/>reversus.</s>
					<s n="11" xml:lang="la">Postquam legisset, nunquam se am<lb xml:id="p1z24"/>plius nobis praebuit aspiciendum, cum <lb xml:id="p1z25"/>tamen promisisset se ad coenam venturum.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z26"/>Causam ego solus noveram<note xml:id="fn13" type="footnote" n="13">Entgegen der Aussage <persName ref="p495">Bullingers</persName> in seinem Brief an <persName ref="p8440">Schuler</persName> (<ref target="file12408">Nr. 2361</ref>,85-87) wurde <persName ref="p8018">Haller</persName> also über den Inhalt des genannten Briefes in Kenntnis gesetzt.</note> admirantibus <lb xml:id="p1z27"/>reliquis fratribus, quod non adesset coenae.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="13" xml:lang="la"><pb type="scan" next="35v."/><pb/><lb xml:id="p2z1"/>Nova certius ex d. <persName ref="p8354">Laeto</persName> intelliges<note xml:id="fn14" type="footnote" n="14">Siehe <ref target="file12414">Nr. 2367</ref> vom 2. März.</note>.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z2"/>Comitia indicta sunt <placeName ref="l569">Wormatiae</placeName> <lb xml:id="p2z3"/>ad calendas aprilis,<note xml:id="fn15" type="footnote" n="15">Gemeint ist der <placeName ref="l1202">Schmalkaldische</placeName> Bundestag; s. <ref target="file12398">Nr. 2351</ref>, Anm. 67.</note> ad quae caesar<note xml:id="fn16" type="footnote" n="16"><persName ref="p18538">Karl V.</persName></note> veniet <lb xml:id="p2z4"/>numeroso stipatus exercitu<note xml:id="fn17" type="footnote" n="17">Vgl. <bibl source="b694">Wolrad, Regensb. RG</bibl> 312 (die Nachricht kommt ebenfalls aus <placeName ref="l18">Augsburg</placeName>).</note>.</s>
					<s n="15" xml:lang="la">Aiunt <lb xml:id="p2z5"/>praeterea novas quasdam copias colligi <lb xml:id="p2z6"/>in diocesi <placeName ref="l61">Brämensi</placeName><note xml:id="fn18" type="footnote" n="18"><placeName ref="l61">Bremen</placeName>.</note> contra langravium<note xml:id="fn19" type="footnote" n="19"><persName ref="p3590">Philipp von Hessen</persName>.</note>.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z7"/><persName ref="p1974">Lutherum</persName> praeterea de vivis ex<lb xml:id="p2z8"/>cessisse 17. februarii<note xml:id="fn20" type="footnote" ana="bio" n="20"><persName ref="p1974">Luther</persName> starb in der Nacht vom 17. auf den 18. Februar 1546 kurz vor drei Uhr morgens.</note> literae<pb type="edition" next="186"/> quaedam ex <lb xml:id="p2z9"/><placeName ref="l361">Norinberga</placeName> missae<note xml:id="fn21" type="footnote" n="21">Nicht ermittelt.</note> testantur.</s>
					<s n="17" xml:lang="la"><placeName ref="l410">Ratis<lb xml:id="p2z10"/>bonae</placeName><note xml:id="fn22" type="footnote" n="22">Am Zweiten <placeName ref="l410">Regensburger</placeName> Religionsgespräch.</note> dolose et perfide aguntur multa.</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z11"/><persName ref="p467">Bucerus</persName> semper sibi similis est, quisquis <lb xml:id="p2z12"/>tandem eius defendat conatus.</s>
					<s n="19" xml:lang="la">Nos <lb xml:id="p2z13"/>orabimus dominum, ut conservet ecclesias nostras <lb xml:id="p2z14"/>ab impiis antichristianorum et semichri<lb xml:id="p2z15"/>stianorum machinis.</s>
					<s n="20" xml:lang="la">Amen.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="21" xml:lang="la">Libellos, <lb xml:id="p2z16"/>quos voluisti tibi mitti,<note xml:id="fn23" type="footnote" n="23">Welche Bücher <persName ref="p495">Bullinger</persName> gewünscht hatte, ist nicht bekannt.</note> mitto.</s>
					<s n="22" xml:lang="la"><lb xml:id="p2z17"/>Novi nihil attulerunt bibliopolae ex <placeName ref="l284">Lypsia</placeName>.</s>
					<s n="23" xml:lang="la"><lb xml:id="p2z18"/>Quidam aiunt <persName ref="p1974">Lutherum</persName> morte praeventum, <lb xml:id="p2z19"/>ne finiret, quod coeperat opus;<note xml:id="fn24" type="footnote" n="24">Wohl die gegen die Sakramentierer (vgl. <ref target="file12379">Nr. 2332</ref> und Anm. 21; <ref target="file12382">Nr. 2335</ref> und Anm. 6; <ref target="file12398">Nr. 2351</ref> und Anm. 38; <ref target="file12402">Nr. 2355</ref> und Anm. 4) und kaum die angeblich gegen die Juden (vgl. <ref target="file12400">Nr. 2353</ref>) geplante Schrift <persName ref="p1974">Luthers</persName>.</note> quidam <lb xml:id="p2z20"/>amicorum precibus eum impeditum esse <lb xml:id="p2z21"/>confirmant.</s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="24" xml:lang="la">Utrum sit, gaudeo, <lb xml:id="p2z22"/>si offendicula ab ecclesiis arceantur.</s>
					<s n="25" xml:lang="la" ana="farewell"><lb xml:id="p2z23"/>Vale et ignosce; festinanter enim <lb xml:id="p2z24"/>scripsi.</s>
					<s n="26" xml:lang="la"><lb xml:id="p2z25"/>Calendis martii 1546.</s>
				</p>
			</div>
			<div xml:id="div7" corresp="regest7">
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p2z26"/>Tuus ex animo <persName ref="p8018">Ioan. <lb xml:id="p2z27"/>Hallerus</persName>.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><pb type="scan" next="36r."/><pb/><lb xml:id="p3z1"/>Negotium <persName ref="p7197">Wilperti Zolleri</persName> bene se habet<note xml:id="fn25" type="footnote" n="25">Siehe dazu zuletzt <ref target="file12398">Nr. 2351</ref>,156-170.</note>.</s>
					<s n="29" xml:lang="la"><lb xml:id="p3z2"/><persName ref="p2916">Schertlius</persName><note xml:id="fn26" type="footnote" n="26"><persName ref="p2916">Sebastian Schertlin</persName>.</note> eum per annum habebit <lb xml:id="p3z3"/>secum, non tamen ut servum.</s>
					<s n="30" xml:lang="la">Sumptus <lb xml:id="p3z4"/>ei suppeditabunt<note xml:id="fna" type="footnote" n="a"><hi>In der Vorlage</hi> suppetabunt.</note> domini <placeName ref="l18">Augustani</placeName>, ita ta<lb xml:id="p3z5"/>men, ut, si eius opus habuerint <lb xml:id="p3z6"/>opera, inservire eis non detrectet.</s>
					<s n="31" xml:lang="la"><lb xml:id="p3z7"/>Sic <lb xml:id="p3z8"/>mihi retulit archigrammateu<pb/><lb xml:id="p4z1"/>s<note xml:id="fn27" type="footnote" n="27"><persName ref="p8354">Georg Frölich</persName>.</note>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="32" xml:lang="la">Clarissimo viro <lb xml:id="p4z2"/>d. <persName ref="p495">Heinrycho <lb xml:id="p4z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p4z4"/>Ecclesiae fidelissimo <lb xml:id="p4z5"/>praesuli, do<lb xml:id="p4z6"/>mino et patri <lb xml:id="p4z7"/>suo unice collendo. <lb xml:id="p4z8"/>m. <persName ref="p495">Heinrich <lb xml:id="p4z9"/>Bullinger</persName>.</s>
				</p>
			</div>
		</body>
	</text>
