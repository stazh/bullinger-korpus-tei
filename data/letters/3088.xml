	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Negociis impedior et improviso tabellarii abitu, <lb xml:id="p1z2"/>quominus possim pluribus scribere.</s>
					<s n="3" xml:lang="la"><placeName ref="l167">Genevatum</placeName> et <placeName ref="l41">Bernensium</placeName>, illustrium <lb xml:id="p1z3"/>rerumpublicarum, quicunque coniunctionem procurant, pientissime utiliterque faciunt, <lb xml:id="p1z4"/>et heri, cum quosdam ex nostris interpellarem, satis ampliter promiserunt; <lb xml:id="p1z5"/>verum quid hodie in senatu conclusum, nondum <lb xml:id="p1z6"/>cognitum, sed bene spero.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Interea, sicut par est, praecibus insistamus <lb xml:id="p1z7"/>ad dominum, ut misericorditer ipse uniat, quos unitos <lb xml:id="p1z8"/>maxime oportet.</s>
					<s n="5" xml:lang="la">Ex <placeName ref="l822">Germania</placeName> nihil magnopere accipimus.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Comicia procedunt, quanquam nondum omnium principum legati convenerint.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Agetur de religionis libertate pleniore, quam tanto <lb xml:id="p1z11"/>facilius impetratum iri confidunt aliqui, quod <persName ref="p18477">Ferdinandus</persName> successionem <lb xml:id="p1z12"/>in imperio iam sperat ratam ordinum consensu fore.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Si quid accepero, te non celabo.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Bene vale in Christo Iesu.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/><placeName ref="l28">Basileae</placeName> 3a ianuarii anno 1557.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">T[uus] <lb xml:id="p1z15"/><persName ref="p3099">Sulcerus</persName> <lb xml:id="p1z16"/>totus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>domino et symmistae <lb xml:id="p2z4"/>colendissimo suo.</s>
				</p>
			</div>
