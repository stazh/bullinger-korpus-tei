	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Si monachus Rütinenses et alii eius farinae
					<lb xml:id="p1z2"/>homines in hoc saculo plus iurio quam filii dei
					<lb xml:id="p1z3"/>habere videntur, id sane mirandum non est; Scis enim
					<lb xml:id="p1z4"/>hoc salvatoris nostri. Si de mundo essetis, mundus
					<lb xml:id="p1z5"/>quod suum oest diligeret. quod magistratus, quorum
					<lb xml:id="p1z6"/>intererat ex aequo omnibus reddere ius, aliquando
					<lb xml:id="p1z7"/>remissiores apparent, multas, quas ipse nosti
					<lb xml:id="p1z8"/>caussas habet. Interim, dum officium suum negligunt
					<lb xml:id="p1z9"/>panore impeditu aut aliis turbati affertibus, non
					<lb xml:id="p1z10"/>excusabuntur apud iudicem iustum, cui sane nos
					<lb xml:id="p1z11"/>in hac causa et similibus credere nos totos opim
					<lb xml:id="p1z12"/>expectantes opportunitatis et ipsius auxilium
					<lb xml:id="p1z13"/>Non est autem quod tantas agas gratias meae induc
					<lb xml:id="p1z14"/>quae tamen licet sedulo fuerit et prompta
					<lb xml:id="p1z15"/>sit semper, nihil tamen fectus tibi contulit.
					<lb xml:id="p1z16"/>sane facis, qui in hisce perturbationibus rerum
					<lb xml:id="p1z17"/>confugiendum putas ad preces; nam plus hic et per
					<lb xml:id="p1z18"/>as poterimus quam humanis innitentes consiliis, quamquam
					<lb xml:id="p1z19"/>interim si quid per magistratus operam efficere
					<lb xml:id="p1z20"/>pseges esse debeamus ac alia quoque media
					<lb xml:id="p1z21"/>usurpare ad conservandas tuendasque
					<lb xml:id="p1z22"/>ia nobis creditas. Sunt sane pericula, quae
					<lb xml:id="p1z23"/>undique imminet gravia. Socii et fratres nostri qi
					<lb xml:id="p1z24"/>sunt per Saxoniam persequntur nos et ineptis scriptione
					<lb xml:id="p1z25"/>exhilerant et iuvant hostes nostros, dissidium
					<lb xml:id="p1z26"/>non modo fovent, sed et propagant. Hostes manit
					<lb xml:id="p1z27"/>festi, mira tractant contra nos consilia. Recensim
					<lb xml:id="p1z28"/>multa huius generis fratri huic, qui has tibi reddit,
					<lb xml:id="p1z29"/>vir sane, quantum ego iudicare possum, bonus et interi
					<lb xml:id="p1z30"/>Dominus adfuit nobis; is porro nobis non dat
					<lb xml:id="p1z31"/>si in ipsum confisi constanter eius opem implor.
					<lb xml:id="p1z32"/>raverimus. Vestrum quoque est, qui Basiliensi
					<lb xml:id="p1z33"/>ecclesiae inservitis et en bone multis invigila
					<lb xml:id="p1z34"/>et accurate integram eius famam conserva.
					<lb xml:id="p1z35"/>Si qui non recte pede incesserint, admodiu
					<lb xml:id="p1z36"/>sunt sesulo, cohercendi auxilioque fratrum
					<lb xml:id="p1z37"/>e honem in magistratu virorum competrendu
					<lb xml:id="p1z38"/>Orandus imprimis dominu, ut is omnium corda dicrn
					<lb xml:id="p1z39"/>ad gloriam nons sum et pacem veram in
					<lb xml:id="p1z40"/>ecclesiis conservet. Vive et vale, optime frater. Scrib
					<lb xml:id="p1z41"/>nuper quaedam de Oporino, ad quae nondum
					<lb xml:id="p1z42"/>respondisti. <placeName ref="l587">Tiguri</placeName> 13. septembris 1560.
					<lb xml:id="p1z43"/>Tuus Bullingerus.
					<pb/>
					<lb xml:id="p2z1"/>Praestantissimo viro
					<lb xml:id="p2z2"/>d. Ioanni Iungio
					<lb xml:id="p2z3"/>Basiliensis ecclesiae
					<lb xml:id="p2z4"/>fideli ministro
					<lb xml:id="p2z5"/>domino et fratri
					<lb xml:id="p2z6"/>suo colenissis.
					<lb xml:id="p2z7"/>charisssimo.
				</p>
