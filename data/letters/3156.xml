	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quemadmodum mea erga te observantia, <lb xml:id="p1z2"/>optime p(ater) <persName ref="p495">B[ullingere]</persName>, constans, firma et perpetua est, <lb xml:id="p1z3"/>ita de tua erga me benevolentia nunquam <lb xml:id="p1z4"/>ab eo tempore, quo tu me semel es com<lb xml:id="p1z5"/>plexus et in tuam recepisti amititiam, <lb xml:id="p1z6"/>dubitavi.</s>
					<s n="3" xml:lang="la">Gratum tamen fuit illud ex te <lb xml:id="p1z7"/>ipso in tuis literis audire, nimirum te nunquam <lb xml:id="p1z8"/>ob ivisci mei, gratissimum vero, quod scrib<lb xml:id="p1z9"/>is me deo a te commendari.</s>
					<s n="4" xml:lang="la">Perge, <lb xml:id="p1z10"/>rogo te, p[ater] <persName ref="p495">B[ullingere]</persName>, id facere nec me solum, <lb xml:id="p1z11"/>sed inprimis totam hanc ecclesiam et scholam <lb xml:id="p1z12"/>populumque talem ac tantum et tu et tota <lb xml:id="p1z13"/>ipsa tua sancta ecclesia domino frequentissimis e<lb xml:id="p1z14"/>t ardentissimis votis precibusque commendet.</s>
					<s n="5" xml:lang="la">Calamitas <lb xml:id="p1z15"/>nostra, quia spiritualis est, eo pestilentior.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z16"/>Nosti, quid dicam.</s>
					<s n="7" xml:lang="la">Locum hic habet papismus, <lb xml:id="p1z17"/>anabaptismus, <persName ref="p8441">Swenchfeldianismus</persName> et quid malorum non?</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z18"/>Quod <lb xml:id="p1z19"/>superest christianismi et syncerę <lb xml:id="p1z20"/>doctrinę, non desunt, a quibus pro virili <lb xml:id="p1z21"/>explodatur, proscribatur.</s>
					<s n="9" xml:lang="la">Rogandus certe est <lb xml:id="p1z22"/>deus, ut <lb xml:id="p1z23"/>huius ecclesię et scholę abactis <lb xml:id="p1z24"/>erroribus et restituta syncera evanelii <lb xml:id="p1z25"/>doctrina misereatur <lb xml:id="p1z26"/>per Iesum Christum.</s>
					<s n="10" xml:lang="la">Non sine s<lb xml:id="p1z27"/>ummo animi mei dolore hec scribo, nec <lb xml:id="p1z28"/>quisquam vere pius est, qui sine lachrymis <lb xml:id="p1z29"/>videre et audire hęc possit.</s>
					<s n="11" xml:lang="la">Hoc boni <lb xml:id="p1z30"/>superest, quod et in magistratu et in reliquo <lb xml:id="p1z31"/>populo quamplurimi adhuc sunt, qui ex animo favent <lb xml:id="p1z32"/>purę doctrinę et Satanę eiusque angelis r<lb xml:id="p1z33"/>esistunt.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Supersunt etiam aliquot reliqui seminis <lb xml:id="p1z34"/>sancti inter ministros, qui causam Christi <lb xml:id="p1z35"/>pro viribus defendunt.</s>
					<s n="13" xml:lang="la">Ergo omnes ii commendan<lb xml:id="p1z36"/>di sunt deo.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z37"/>Nova ex d. <persName ref="p8111">P[etro] M[artyre</persName>] nulla <pb/><lb xml:id="p2z1"/>accepi, imo in literis quidem habui; sed fieri <lb xml:id="p2z2"/>potest, ut vel literę non sint redditę, <lb xml:id="p2z3"/>vel ei per <lb xml:id="p2z4"/>graviores occupationes non vacar<lb xml:id="p2z5"/>it scribere.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z6"/>Filius mihi est <lb xml:id="p2z7"/>commendatissimus; sed ipse et raro me invisit <lb xml:id="p2z8"/>et nunquam a me aliquid petit, cum tamen nil <lb xml:id="p2z9"/>magis exoptem quam ei prodesse, ut simul <lb xml:id="p2z10"/>et tibi gratificer; habes animum meum <lb xml:id="p2z11"/>et tibi gratificandi et de filio benemer<lb xml:id="p2z12"/>endi cupidissimum.</s>
					<s n="16" xml:lang="la">Reliquum est, ut et <lb xml:id="p2z13"/>tu authoritate mihi imperes <lb xml:id="p2z14"/>et ille pro suo officio, qua in re possim <lb xml:id="p2z15"/>ei prodesse, significet.</s>
					<s n="17" xml:lang="la" ana="farewell">Vale et, <lb xml:id="p2z16"/>quomodo cępisti, amare perge.</s>
					<s n="18" xml:lang="la" ana="salute">Saluta, pater, <lb xml:id="p2z17"/>uxorem tuam, matronam honestissimam, cum <lb xml:id="p2z18"/>omnibus tuis et filiabus et generis, deinde <lb xml:id="p2z19"/>omnes istic pios et doctos viros.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z20"/><placeName ref="l491">Argentina</placeName> 20. aprilis 1557.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z21"/>T[uae] s[anctitati<lb xml:id="p2z22"/>s] <persName ref="p4037">H[ieronymus] Zanchus</persName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z23"/>De <persName>Beato</persName> audies ex domino d. <persName>Petro</persName>.</s>
				</p>
