	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>alue, mi domine Bullingere. Tuas fideles admodoum
					<lb xml:id="p1z2"/>Unitiones, quas superiori anno ad nos scripsisse
					<lb xml:id="p1z3"/>nunc deuum veras esse, re ipsa experimur. Non
					<lb xml:id="p1z4"/>audeo literis experinere, quantas molestias labore
					<lb xml:id="p1z5"/>atque pericula ob pueiorem veritatis confessionem
					<lb xml:id="p1z6"/>hic sustinerimus. Malo id ex aliis intelligas
					<lb xml:id="p1z7"/>eote statum nostrarum rerum pli psalmus tibi
					<lb xml:id="p1z8"/>Aingrophice depinget, quo prostratis animum
					<lb xml:id="p1z9"/>saepe erexi. Actiones imperiales tibi Bern
					<lb xml:id="p1z10"/>chardus a coma exponet, cui etiam 25 dalero
					<lb xml:id="p1z11"/>osd. iunio mutuo dedisti, numeram
					<lb xml:id="p1z12"/>his paucis bene vale et dominos Volphium.
					<lb xml:id="p1z13"/>Gvaltherum, Lomaterum ac reliquos aanco
					<lb xml:id="p1z14"/>meo nomine plurimum saluta. Non licet
					<lb xml:id="p1z15"/>hic libere scribere, cum sint, qui possit proscribere
					<lb xml:id="p1z16"/>plura deo volente ex Hedelberga. Datae A
					<lb xml:id="p1z17"/>Vindelicorum nostra fortuna inter
					<lb xml:id="p1z18"/>a et Saxum stante 19. maii anno etc..
					<lb xml:id="p1z19"/>Tuns ex annum
					<lb xml:id="p1z20"/>Stephentus Cvelerus.
					<lb xml:id="p1z21"/>an wolt uns hie gern
					<lb xml:id="p1z22"/>auß dem religiones finden
					<lb xml:id="p1z23"/>ausschliessen, als die win
					<lb xml:id="p1z24"/>von d Augspurgissim confessione
					<lb xml:id="p1z25"/>abgefallen und dem (alminismo
					<lb xml:id="p1z26"/>erhengig gemacht vix medis
					<lb xml:id="p1z27"/>quam acerbos inquietos ac pene sumos
					<lb xml:id="p1z28"/>Sathanae insultus patramur. Sed dominus
					<lb xml:id="p1z29"/>cui nos totos dedicavimus. nostra
					<lb xml:id="p1z30"/>innocentiam tuebitur et tandem ex omnibus
					<lb xml:id="p1z31"/>malis eccipiet.
					<lb xml:id="p1z32"/>Salutem tibi dicunt d d. concellarii
					<lb xml:id="p1z33"/>probus Ehemius Wilingus, strenune
					<lb xml:id="p1z34"/>et animose pro gloria domini
					<lb xml:id="p1z35"/>decertantes, quos omnes precellit
					<lb xml:id="p1z36"/>principis invicta animi magnitudo.
					<pb/>
					<lb xml:id="p2z1"/>Reverendo viro d. Henrico Bullingero,
					<lb xml:id="p2z2"/>ecclesiae Tigurinae mi
					<lb xml:id="p2z3"/>ministro fidelissimo, domino et
					<lb xml:id="p2z4"/>amico suo plurimum colendo.
					<lb xml:id="p2z5"/>.
					<lb xml:id="p2z6"/>mich
					<lb xml:id="p2z7"/>
				</p>
			</div>
