	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Mitto tibi, vir ornatissime, quos petisti, conciliorum canones, in <lb xml:id="p1z4"/>quibus multa sane non absurda tantum, sed sacris literis ex diametro etiam pu<lb xml:id="p1z5"/>gnantia invenies, quae tamen a <persName ref="p6420">Sagittario</persName> collectore data opera <lb xml:id="p1z6"/>inserta sunt, ne quis fidem et integritatem desideret, cum <lb xml:id="p1z7"/>multorum hactenus disputationibus quasi ad oculum sit demonstratum <lb xml:id="p1z8"/>omnia ab apostolorum temporibus ad <placeName ref="l1107">Tridentinum</placeName> usque proxime <lb xml:id="p1z9"/>celebratum concilium non in paucis aberasse.</s>
					<s n="3" xml:lang="la">Quod autem <lb xml:id="p1z10"/>proximis literis meum de conciliorum epitome iuditium postulas, <lb xml:id="p1z11"/>non invenio, quod respondeam, qui rebus gravioribus <lb xml:id="p1z12"/>meum iudicium non lubenter interpono, in iudicandis presertim <lb xml:id="p1z13"/>aliorum scriptis, in quibus unusquisque pro suo ingenio atque <lb xml:id="p1z14"/>dono vires intendit et doctioribus ansam praebet altiora <lb xml:id="p1z15"/>cogitandi.</s>
					<s n="4" xml:lang="la">Novarum rerum plane nihil habemus, quod ego sciam; <lb xml:id="p1z16"/>silent enim omnia adeo, ut indutias inter <persName ref="p18538">Cęsarem</persName> et <persName ref="p8112">Gallum</persName> [<lb xml:id="p1z17"/>ad] tempus factas multi existiment.</s>
					<s n="5" xml:lang="la" ana="farewell">Vale cum tota familia.</s>
					<s n="6" xml:lang="la">18. novem<lb xml:id="p1z18"/>bris <placeName ref="l28">Basileae</placeName> anno 1553.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z19"/>T[uus] <persName ref="p8406">Con[radus] Lycosthenes</persName><lb xml:id="p1z20"/>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> vero <lb xml:id="p2z4"/>episcopo, domino atque <lb xml:id="p2z5"/>amico colendissimo.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
