	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil nunc, quod scribam, habeo, nisi <lb xml:id="p1z2"/>quod te hortor ad pietatem, et ut in studiis <lb xml:id="p1z3"/>sedulo pergas, quod te omnino facturum <lb xml:id="p1z4"/>confido.</s>
					<s n="3" xml:lang="la">Accepisti haud dubie literas, quas <lb xml:id="p1z5"/>nuper mittebam per d. <persName ref="p1428">Halesium</persName> <placeName ref="l830">Anglum</placeName>, quibus <lb xml:id="p1z6"/>imposueram nummum indicium, quod placuit mihi <lb xml:id="p1z7"/>tua exercitatio in Isocrate.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Expecto <lb xml:id="p1z8"/>iam rationem expensi et accepti ab eo die, <lb xml:id="p1z9"/>quo circa natalitia domini rationem reddidisti.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Perge deinde consignare omnia et singula.</s>
					<s n="6" xml:lang="la">Libenter <lb xml:id="p1z11"/>suppeditabo necessaria; sed vide et cave, mi <lb xml:id="p1z12"/>fili, ne facias inutiles et non necessarios sumptus.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Id si feceris, quod mihi plane persuasi, senties <lb xml:id="p1z14"/>me tibi benignissimum futurum.</s>
					<s n="8" xml:lang="la">Gravia <lb xml:id="p1z15"/>nunc ex omnibus partibus pericula nobis et <lb xml:id="p1z16"/>vobis impendent; ora dominum, ut liberet isthic <lb xml:id="p1z17"/>vos et nos a malo.</s>
					<s n="9" xml:lang="la">Graves enim expeditiones <lb xml:id="p1z18"/>fiunt, nec possumus aliud expectare quam <lb xml:id="p1z19"/>aestatem plane sanguinolentam.</s>
					<s n="10" xml:lang="la">Sed apud <lb xml:id="p1z20"/>dominum est asylum tutissimum; illuc confugiamus <lb xml:id="p1z21"/>secura fide et sedula dilectione necnon spe <lb xml:id="p1z22"/>immota; nam turris est munitissima nomen domini; <lb xml:id="p1z24"/>quisquis illud invocaverit, serv<lb xml:id="p1z25"/>abitur.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Salutant te diligenter mater, <lb xml:id="p1z26"/><persName ref="p5035">Veritas</persName>, <persName ref="p5034">Dorothea</persName>, <persName>Brigida</persName> et tota familia.</s>
					<s n="12" xml:lang="la" ana="salute"><lb xml:id="p1z27"/>Salutabis tu nobis dominam tuam et familiam <lb xml:id="p1z28"/>totam.</s>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 31. martii anno 1554.</s>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z29"/>Commenda me <lb xml:id="p1z30"/>clarissimis viris d. <persName ref="p8111">Martyri</persName> <lb xml:id="p1z31"/>et d. <persName ref="p4037">Zancho</persName>, d. <persName ref="p8320">Dasypodio</persName>, d. <persName ref="p8121">Montio</persName> <lb xml:id="p1z32"/>ac reliquis.</s>
					<s n="15" xml:lang="la">Roga singulos, si quid velint scribere <lb xml:id="p1z33"/>per hunc tabellionem certum <persName>Höniun</persName> etc.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z34"/><persName ref="p495">Bullinger</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p487">Heinrycho Bullingero <lb xml:id="p2z2"/>iuniori</persName>, dilecto meo <lb xml:id="p2z3"/>filio <placeName ref="l491">Argentinae</placeName> agenti <lb xml:id="p2z4"/>in aedibus d. <persName ref="p505">Ioannis Bur<lb xml:id="p2z5"/>cheri</persName>, <placeName ref="l830">Angli</placeName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l491">Straßburg</placeName><lb xml:id="p2z7"/>.</s>
				</p>
