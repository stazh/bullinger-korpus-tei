	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia domini tecum.</s>
					<s n="2" xml:lang="la">Filia <persName ref="p8009">Fabritii</persName> iam alteras <lb xml:id="p1z2"/>matri litteras mittit eo, quod nullum a prioribus <lb xml:id="p1z3"/>receperit responsum; orat vero tuam humanitatem, dulciss<lb xml:id="p1z4"/>ime <persName ref="p495">Bullingere</persName>, propter Christum, ut tu ipse hasce <lb xml:id="p1z5"/>matri presentes auditurus, quid petat; maternum <lb xml:id="p1z6"/>animum facile flectes, ut puerum in tutelam suscipiat, <lb xml:id="p1z7"/>dum ipsa bonorum consilio statum servilem in melius <lb xml:id="p1z8"/>mutaverit.</s>
					<s n="3" xml:lang="la">Ego ut brevibus de illa utcunque tester, <lb xml:id="p1z9"/>nil aliud audio, quam ut ipsa optime apud nobilem <lb xml:id="p1z10"/>nostrum et pręfectum inprimis, deinde in republica <lb xml:id="p1z11"/>audiat; commendata est omnibus propter parentem, <lb xml:id="p1z12"/>cuius in ecclesia ministerium apud plerosque non<lb xml:id="p1z13"/>dum oblivione deletum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Si quid forte peccavit, iam icta <lb xml:id="p1z14"/>procul dubio sapiet in exilio et alienis penatibus <lb xml:id="p1z15"/>fructu maiori resipiscens.</s>
					<s n="5" xml:lang="la">Status noster idem est <lb xml:id="p1z16"/>qui diu; in gratiam <persName ref="p18538">Caesaris</persName> non sumus conscripti; utinam <lb xml:id="p1z17"/>simus in favore illius, qui est plenus gratia et veritate.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z18"/>Heri accepi litteras a <persName>Norico</persName> quodam, qui scribit <lb xml:id="p1z19"/>8. die huius mensis <persName ref="p18538">Caesari</persName>, filio et <persName ref="p18477">Ferdinando</persName> <placeName ref="l361">Norinberge</placeName> <lb xml:id="p1z20"/>hospitia esse designata et nunc agere Monaci.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z21"/>Quod si verum, non erunt comitia, sed sodalitia.</s>
					<s n="8" xml:lang="la">Paucos <lb xml:id="p1z22"/>principes illic esse constat etc.</s>
					<s n="9" xml:lang="la">Certo quoque fertur civitatem <lb xml:id="p1z23"/><placeName ref="l1041">Brunsvicensem</placeName> levia aliquot prelia sive conflictus <lb xml:id="p1z24"/>cum duce <placeName ref="l1041">Brunsvicensi</placeName> <persName ref="p20318">Henrico</persName> commisisse atque nuper cives <lb xml:id="p1z25"/>potitos victoria et centum ex nobilibus ducis cęsos.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z26"/>Aiunt rursum et redingretare et magnum conscribere <lb xml:id="p1z27"/>exercitum et mirabilia moliri.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Dominus malum hoc, quod tent<lb xml:id="p1z28"/>at, in caput latronis convertat, amen.</s>
					<s n="12" xml:lang="la">Reliquę ci<lb xml:id="p1z29"/>vitates maritimę adhuc sui similes <persName>Caesareanum</persName> <lb xml:id="p1z30"/>Interim omnibus modis proscribunt.</s>
					<s n="13" xml:lang="la">Alia plura; forte <lb xml:id="p1z31"/>veredarius in procinctu stabat.</s>
					<s n="14" xml:lang="la">Te cum familia tua <lb xml:id="p1z32"/>et fratribus et generis, item <persName ref="p8127">Pellicano</persName>, <persName ref="p8171">Bibliandro</persName>, <persName ref="p8011">Gvalthero</persName>, <lb xml:id="p1z33"/>optime valere cupio.</s>
					<s n="15" xml:lang="la" ana="salute">Salutant te nostri.</s>
					<s n="16" xml:lang="la">Orate <lb xml:id="p1z34"/>pro nobis sedulo, amen.</s>
					<s n="17" xml:lang="la">Raptim.</s>
					<s n="18" xml:lang="la"><placeName ref="l411">Richenvillę</placeName> 30. augusti <lb xml:id="p1z35"/>1550.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z36"/>Tuus silicernius <persName ref="p1010">M[atthias] Erbius</persName>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro pietate et eruditione <lb xml:id="p2z2"/>insigni d. <persName ref="p495">Henrycho Bul<lb xml:id="p2z3"/>lingero</persName>, ecclesię <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z4"/>antistiti diligentissimo, <lb xml:id="p2z5"/>fratri obser<lb xml:id="p2z6"/>vando.</s>
				</p>
			</div>
