	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Maximo cum dolore audio et lego urbes prae<lb xml:id="p1z2"/>sidiis nudatas subinde occupari et tot trucidari passim <lb xml:id="p1z3"/>sanctos.</s>
					<s n="3" xml:lang="la">Misere metuo <placeName ref="l301">Lugduno</placeName>, propter quod <lb xml:id="p1z4"/>semel et iterum ad te serio scripsi compertum <lb xml:id="p1z5"/>me habere omnia hostium consilia eo dirigi, ut occupetur <lb xml:id="p1z6"/>et omnibus nostris terror incutiatur.</s>
					<s n="4" xml:lang="la">Dixi <lb xml:id="p1z7"/>item profecturos <placeName ref="l2448">Quinquepagicos</placeName> cum suis, et <lb xml:id="p1z8"/>quidem profecti sunt.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Utinam vel non redeant <lb xml:id="p1z9"/>vel per septem vias redeant!</s>
					<s n="6" xml:lang="la"><persName ref="p8621">Guysius</persName> interim <lb xml:id="p1z10"/>de concordia ineunda tractat, dum ipse exercitum <lb xml:id="p1z11"/>sibi comparet validum; ubi vero satis <lb xml:id="p1z12"/>instructum se putabit, tum nostri demum experientur, <lb xml:id="p1z13"/>ad quid remorae illae fuerint <lb xml:id="p1z14"/>institutae.</s>
					<s n="7" xml:lang="la">Scribit d. <persName ref="p2019">Augustinus Maynardus</persName> ex <lb xml:id="p1z15"/><placeName ref="l834">Italia</placeName> pontificem parasse 8000, quos mittat <lb xml:id="p1z16"/>in <placeName ref="l832">Galliam</placeName> contra principem ad excindendos <lb xml:id="p1z17"/>haereticos.</s>
					<s n="8" xml:lang="la">Addunt alii <persName>Ferrariensem</persName> quoque parare <lb xml:id="p1z18"/>copias, quas coniungat <persName>Guysio</persName> et connestablio, <persName>Achi<lb xml:id="p1z19"/>topheli</persName> scelestissimo.</s>
					<s n="9" xml:lang="la">Literas inscriptas d. <persName ref="p8093">Herculi <lb xml:id="p1z20"/>a Salice</persName> mature curavi ac describam modo <lb xml:id="p1z21"/>d. <persName ref="p8009">Fabritii</persName> responsionem.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ita rescribit: "Valde mihi <lb xml:id="p1z22"/>displicet nostrorum ita bene instructorum cunctatio, <lb xml:id="p1z23"/>sed et omnibus, quos ego quidem audivi viros fortes <lb xml:id="p1z24"/>et rei militaris peritos.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Cupis tu, ut <persName>Rheti</persName> su<lb xml:id="p1z25"/>um faciant officium; urges fervide.</s>
					<s n="12" xml:lang="la">Sed quid <lb xml:id="p1z26"/>faciant, ad quos nemo hactenus quicquam scripsit!</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z27"/>Et quidem indignissime ferunt ita se praeteriri.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z28"/>Qui fit, ut illustrissimus princeps <persName>Condensis</persName> nostros <lb xml:id="p1z29"/>ita neglexit?</s>
					<s n="15" xml:lang="la">Cum nostri vident ita se contemni, <lb xml:id="p1z30"/>indignantur.</s>
					<s n="16" xml:lang="la">Saltem scriberet ad ipsos princeps; <lb xml:id="p1z31"/>si nihil aliud, animos nostrorum sibi devinciret.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z32"/>Priusquam nostri <placeName ref="l167">Genevam</placeName> eant et redeant, mensis erit.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z33"/>Interimne pii praeda erunt impiorum?</s>
					<s n="19" xml:lang="la">Si quid <lb xml:id="p1z34"/>potes apud d. <persName ref="p540">Calvinum</persName> et <persName ref="p8033">Bezam</persName>, effice, ut <persName>Condensis</persName>, <lb xml:id="p1z35"/>siquidem opera indigeat <placeName ref="l648">Rhetorum</placeName>, mature <lb xml:id="p1z36"/>scribat.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Literas mihi creditas d. <persName ref="p8093">Herculi</persName> <lb xml:id="p1z37"/>submittam.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Cuperem illum ipsum progredi <lb xml:id="p1z38"/><placeName ref="l167">Genevam</placeName> usque."</s>
					<s n="22" xml:lang="la">Haec verbotim<note xml:id="fn1" type="footnote" n="1">wörtlich; vgl. <bibl source="b316">Hoven</bibl> 378.</note> <persName>Fabritius</persName>, quae te nes<lb xml:id="p1z39"/>cire nolui.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Nondum respondit <persName ref="p3559">Hallvylerus</persName>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vix dixero, quam sim sol[l]icitus, ne diversum <lb xml:id="p2z2"/>exeat institutum nostrorum, quam velimus.</s>
					<s n="25" xml:lang="la">Orem<lb xml:id="p2z3"/>us dominum, ut ipse res moderetur.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">Est non longe <lb xml:id="p2z4"/>a nobis baro d. <persName ref="p3619">Ulrychus Philippus ab Alto <lb xml:id="p2z5"/>Saxo</persName> militiae peritissimus, qui nihil aliud vellet <lb xml:id="p2z6"/>quam se vocari a <persName>Condensi</persName> principe; posset <lb xml:id="p2z7"/>illi signa aliquot adducere ex <placeName ref="l862">Helvetia</placeName>.</s>
					<s n="27" xml:lang="la"><lb xml:id="p2z8"/>Caeterum metuo, ne nimis sero haec tracte[ntur].</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p2z9"/>Dominus misereatur nostri et servet suos!</s>
					<s n="29" xml:lang="la" ana="farewell">Vale <lb xml:id="p2z10"/>aeternum cum omnibus bonis.</s>
					<s n="30" xml:lang="la" ana="salute">Salutant te fratres; <lb xml:id="p2z11"/>saluta d. <persName ref="p4440">Budaeum</persName>, <persName ref="p8078">Ionvilleum</persName>, omnes denique fratres.</s>
					<s n="31" xml:lang="la">Datae ipsa die Ioannis Baptistae sero sub vesperam <lb xml:id="p2z12"/>1562.</s>
				</p>
				<p>
					<s n="32" xml:lang="la">Tuus ex animo <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="33" xml:lang="la">Clarissimo viro d. <persName ref="p540">Ioanni Calvino</persName>, <placeName ref="l167">Genevensis</placeName> ecclesiae pastori fidelissimo, <lb xml:id="p2z13"/>domino ho<lb xml:id="p2z14"/>norando et fratri meo longe charissimo.</s>
					<s n="34" xml:lang="de"><placeName ref="l167">[G]enff</placeName>.</s>
				</p>
			</div>
