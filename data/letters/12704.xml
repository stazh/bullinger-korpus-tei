					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro <lb xml:id="p2z2"/>domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>ministro ecclesiae <lb xml:id="p2z4"/>dei, quae est <placeName ref="l587">Tiguri</placeName>, <lb xml:id="p2z5"/>fidelissimo.</s>
