	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Multum sane profecisti apud me tua <lb xml:id="p1z2"/>responsione, <persName ref="p540">Calvine</persName> doctissime et charissime frater.</s>
					<s n="3" xml:lang="la">Rectius <lb xml:id="p1z3"/>nunc te intelligo ex hoc ultimo tuo scripto <lb xml:id="p1z4"/>quam intellexerim hactenus, sicut videbis <lb xml:id="p1z5"/>in mea responsione.</s>
					<s n="4" xml:lang="la">Neque miraberis quod adeo <lb xml:id="p1z6"/>ruditer ad te scripsi.</s>
					<s n="5" xml:lang="la">Invenias hodie doctos, et <lb xml:id="p1z7"/>eximie quidem doctos qui sententias suas <lb xml:id="p1z8"/>saepius mutent quam prosit.</s>
					<s n="6" xml:lang="la">Non quod te talem <lb xml:id="p1z9"/>esse existimem, sed quod disertis verbis id a te <lb xml:id="p1z10"/>audire cupiverim quod audivi.</s>
					<s n="7" xml:lang="la">Alioqui nullam <lb xml:id="p1z11"/>de te sinistram opinionem concepi.</s>
					<s n="8" xml:lang="la">Condona <lb xml:id="p1z12"/>mihi meam rusticitatem.</s>
					<s n="9" xml:lang="la">Neque mea tueri <lb xml:id="p1z13"/>conor, nisi quatenus vera sunt.</s>
					<s n="10" xml:lang="la">Neque tu falsa <lb xml:id="p1z14"/>esse dicis, aut falsi me arguis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Dicis te sic a <lb xml:id="p1z15"/>nobis dissentire, ut animo minime sis disiunctus.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z16"/>Ego vero non video cur a nobis dissentias.</s>
					<s n="13" xml:lang="la">Lecta <lb xml:id="p1z17"/>responsione mea spero te hac in c[au]sa omnem poriturum <lb xml:id="p1z18"/>dissensionem.</s>
					<s n="14" xml:lang="la">Si in aliis dogmatibus a nobis <lb xml:id="p1z19"/>dissentis, id quidem ignoro, neque puto.</s>
					<s n="15" xml:lang="la">D. <persName ref="p467">Bu<lb xml:id="p1z20"/>cerum</persName> non odie, et dolet mihi modo hominis infortunium <lb xml:id="p1z21"/>non mediocriter.</s>
					<s n="16" xml:lang="la">Sed dubium non est quin <lb xml:id="p1z22"/>is sua flexibilitate permultum ecclesiae Dei in<lb xml:id="p1z23"/>commodarit.</s>
					<s n="17" xml:lang="la">Dominus condonet illi, et nobis quae contra <lb xml:id="p1z24"/>ipsum affectibus superati peccamus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">De literis a <lb xml:id="p1z25"/>te et ab aliis scriptis et <placeName ref="l587">Tigurinis</placeName> reprehensis <lb xml:id="p1z26"/>nihil adiiciam, nihil respondebo amplius.</s>
					<s n="19" xml:lang="la">Dominus <lb xml:id="p1z27"/>concedat nobis omnibus corda in charitate syn<lb xml:id="p1z28"/>cerissima.</s>
					<s n="20" xml:lang="la">Mihi satis est quod scribis te amare <lb xml:id="p1z29"/>nos syncere.</s>
					<s n="21" xml:lang="la">Hoc ipsum tibi et de nobis pollice<lb xml:id="p1z30"/>are licet.</s>
					<s n="22" xml:lang="la">Valeant porro expostulationes.</s>
					<s n="23" xml:lang="la">Amemus <lb xml:id="p1z31"/>nos mutuo syncere et aedificemus ecclesias.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">De rebus <lb xml:id="p1z32"/>nostris nihil aliud nunc scribo quam eas per gratiam <lb xml:id="p1z33"/>Dei optime habere.</s>
					<s n="25" xml:lang="la">Valemus hic omnes et est pax.</s>
					<s n="26" xml:lang="la">Utinam <lb xml:id="p1z34"/>ita vivamus ut diuturnam habeamus.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><placeName ref="l587">Tigurini</placeName> in <lb xml:id="p1z35"/>praesenti nullam legationem miserunt ad comitia <lb xml:id="p1z36"/>Salodorensia Regis, cum quod non sint in foedere <lb xml:id="p1z37"/>de cuius reparatione tractabitur, tum quod foe<lb xml:id="p1z38"/>deris capita aliquot huiusmodi esse videantur, <lb xml:id="p1z39"/>ut non possint a nobis recipi.</s>
					<s n="28" xml:lang="la">Dominus et tempus, <pb/><lb xml:id="p2z1"/>spero, subinde suppeditabunt salubre consilium.</s>
					<s n="29" xml:lang="la">Multorum <lb xml:id="p2z2"/>animos terret exemplum foederis Iosaphat icti <lb xml:id="p2z3"/>cum domo Achab, et dolet multis cruenta illa per<lb xml:id="p2z4"/>sequ[u]tio Regis in Christianos.</s>
					<s n="30" xml:lang="la">Dominus adsit suis perpetu<lb xml:id="p2z5"/>o.</s>
					<s n="31" xml:lang="la">Pro libris mihi dono missis, ago tibi <lb xml:id="p2z6"/>maximas gratias.</s>
					<s n="32" xml:lang="la">Ego ut saltem aliquod gratitu<lb xml:id="p2z7"/>dinis testimonium apud te deponerem, per D. <persName ref="p8018">Hallerum</persName> <lb xml:id="p2z8"/>misi duas sermonum decades, quas te ac<lb xml:id="p2z9"/>cepisse spero.</s>
					<s n="33" xml:lang="la">Oro ut boni consulas munusculum exiguum.</s>
					<s n="34" xml:lang="la"><lb xml:id="p2z10"/>Laudo tuam fidem quam in confutando Interim <lb xml:id="p2z11"/>exeruisti.</s>
					<s n="35" xml:lang="la">Dominus dabit tibi coronam gloriae.</s>
					<s n="36" xml:lang="la">Domino a<lb xml:id="p2z12"/>gimus gratias.</s>
					<s n="37" xml:lang="la">Agimus et tibi gratias pro diligentia et laboribus.</s>
					<s n="38" xml:lang="la"><lb xml:id="p2z13"/>Perplacet in scribendo libertas et zelus.</s>
					<s n="39" xml:lang="la"><lb xml:id="p2z14"/>Placent prae aliis ultima duo fere folia quae subiecisti <lb xml:id="p2z15"/>confutationi episcopi <placeName>Abricensis</placeName>.</s>
				</p>
				<p>
					<s n="40" xml:lang="la">Mirum sane si <lb xml:id="p2z16"/>prurit adhuc cutis usque adeo impigre non tantum <lb xml:id="p2z17"/>confricta sed et lacerata.</s>
					<s n="41" xml:lang="la">Miror valde quo spiritu <lb xml:id="p2z18"/>impulsus <persName ref="p458">Brentius</persName> principibus Wirtenbergicis <lb xml:id="p2z19"/>respondeat, posse hos publicare Interim et subditis <lb xml:id="p2z20"/>imponere religionem Interemicam (vel Ierobeamicam), <lb xml:id="p2z21"/>ita tamen ne quid approbent in Interim.</s>
					<s n="42" xml:lang="la"><lb xml:id="p2z22"/>Hanc enim hominis esse sententiam retulit illustrissimus <lb xml:id="p2z23"/>princeps <persName ref="p8098">Georgius comes Wirtenberg[ensis</persName>], qui etiam <lb xml:id="p2z24"/>ea re valde offensus est, eoque nomine valde improbat <lb xml:id="p2z25"/><persName ref="p458">Brentium</persName>.</s>
					<s n="43" xml:lang="la">Pergamus nos potius veritatem di<lb xml:id="p2z26"/>serte confiteri et non approbare aut dissimulare <lb xml:id="p2z27"/>si vel tantillum obiiciatur nobis religionis falsae.</s>
				</p>
				<p>
					<s n="44" xml:lang="la"><lb xml:id="p2z28"/>D. <persName ref="p8417">Musculus</persName> unice mihi charus <placeName ref="l41">Bernae</placeName> haerebit, <lb xml:id="p2z29"/>spero, ac fideliter in ea laborabit ecclesia.</s>
					<s n="45" xml:lang="la"><lb xml:id="p2z31"/>Ecclesia Christi quidem dispersa est per totum terrarum <lb xml:id="p2z32"/>orbem, sed pauculae restant hodie quae palam ecclesiae <lb xml:id="p2z33"/>Christi nomen retineant.</s>
				</p>
				<p>
					<s n="46" xml:lang="la">Ecclesiae germanicae f<lb xml:id="p2z34"/>ere <lb xml:id="p2z35"/>omnes (certe <placeName>superioris Germaniae</placeName>) receperunt <lb xml:id="p2z36"/>Interim.</s>
					<s n="47" xml:lang="la">Oremus pro illis, obsecro, et huc conferamus <lb xml:id="p2z37"/>vires omnes in <placeName ref="l862">Helvetia</placeName> ut ecclesiae nostrae <lb xml:id="p2z38"/>sint concordes.</s>
					<s n="48" xml:lang="la">Huc confer omnem tuam operam: nos <lb xml:id="p2z39"/>quoque nostrum officium faciemus pro nostra virili.</s>
				</p>
				<p>
					<s n="49" xml:lang="la" ana="farewell">Vale in <lb xml:id="p2z40"/>Christo, vir colendissime et frater in Domino charissime.</s>
					<s n="50" xml:lang="la" ana="salute"><lb xml:id="p2z41"/>Saluta fratres omnes, inprimis D. <persName ref="p966">Gallasium</persName>, a quo accepi <lb xml:id="p2z43"/>librum elegantem pro quo magnas ago <lb xml:id="p2z44"/>gratis.</s>
					<s n="51" xml:lang="la" ana="salute">Sa<lb xml:id="p2z47"/>lutant te fratres omnes etc.</s>
				</p>
				<p>
					<note type="signature">[Unterschrift fehlt.]</note>
					<note type="address">[Adresse fehlt.]</note>
				</p>
