	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. et G. per Iesum Christum, dominum nostrum, ac mei et meorum <lb xml:id="p1z2"/>obsequiorum diligentem commendationem.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Iter nostrum hactenus ex dei gratia fuit satis foelix.</s>
					<s n="3" xml:lang="la">Nam et adolescent<lb xml:id="p1z4"/>es <persName>Mischcovii</persName> incolumes ad destinata loca venerunt et in constituendis <lb xml:id="p1z5"/>rebus suis successum prosperum experti sunt.</s>
					<s n="4" xml:lang="la"><persName>Petrus</persName> a principe <persName>Chri<lb xml:id="p1z6"/>stophoro</persName>, electoris filio, clementer in familiam receptus est, <persName>Nicolaum <lb xml:id="p1z7"/>Iociscus</persName> motus tuis literis in familiaritatem suam admisit, cu[i] <lb xml:id="p1z8"/>se fore et patronum et praeceptorem liberaliter promisit.</s>
					<s n="5" xml:lang="la">Iam noster <lb xml:id="p1z9"/><persName>Iohannes</persName> ab <persName ref="p8075">Erasto</persName> humanissime tua caussa tractatur, cum eo vi<lb xml:id="p1z10"/>vit in mensa talero septimanatim, habitat autem in vicinia 16 flo<lb xml:id="p1z11"/>renis annuatim, nihilominus ligna et ablutiones sibi prospicere debet.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/><persName>Caspar</persName> vero in contubernio cum caeteris 30 florenis victitat.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Vestes illi comparavi honestas, ut potui, principi et consiliariis eum <lb xml:id="p1z14"/>praesentavi praeceptoribus et <persName ref="p8041">Lasicio</persName> commendavi atque ita his rebus <lb xml:id="p1z15"/>feliciter confectis <placeName ref="l157">Francofurtum</placeName> appuli.</s>
					<s n="8" xml:lang="la">Novi nihil hactenus audivimus, <lb xml:id="p1z16"/>si quid postea erit, <persName ref="p1227">Froschouerus</persName> referret, qui adhuc hic post me diu<lb xml:id="p1z17"/>tius mansurus est.</s>
					<s n="9" xml:lang="la">Ex <placeName ref="l2472">Polonia</placeName> scribunt amici, novum legatum papae ad <lb xml:id="p1z18"/>regem venisse et iam tantum effecisse, ut inquisitio librorum iussu <lb xml:id="p1z19"/>regis <placeName ref="l260">Cracoviae</placeName> facta sit multique libri ab adversariis intercepti sint.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/>Quid hoc sibi velit vel quid inde futurum sit, ubi in patriam rediero <lb xml:id="p1z21"/>duce Christo ad vos perscribam.</s>
					<s n="11" xml:lang="la">Nunc longiorem me in scribendo <lb xml:id="p1z22"/>esse et nundinae <placeName ref="l157">Francofordienses</placeName> et profectio mea <lb xml:id="p1z23"/>propera non sinunt.</s>
					<s n="12" xml:lang="la">Fui tamen <persName>autor Dateno</persName>, ut ipse proli<lb xml:id="p1z24"/>xe omnia tibi perscribat, si quae digna tua auditione existimat <lb xml:id="p1z25"/>aut habeat, quod eum fecisse certo scio.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Felicissime vale, <lb xml:id="p1z26"/>pater colendissime cum tota tua familia, quam saluto reverenter.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z27"/>Dat. <placeName ref="l157">Francofurti</placeName>, 17. septembr. 1568.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z28"/>Recepi omnia a <persName ref="p1227">Froschouero</persName>, quae misisti et quae illi tradideras.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Tui observantissimus <lb xml:id="p1z29"/><persName ref="p8511">Chris<lb xml:id="p1z30"/>tophorus Thretius</persName>.<pb/><lb xml:id="p4z1"/>.. o pietate atque eruditione..<lb xml:id="p4z2"/>. quinimo homini deo... <lb xml:id="p4z3"/><persName ref="p495">Bullingero</persName> seniori ecclesiae..<lb xml:id="p4z4"/>. tistiti fidelissimo, domino... <lb xml:id="p4z5"/>issimo.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
