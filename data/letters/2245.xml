	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Ecce tandem <placeName ref="l18">Augustam</placeName> veni, sed sat video magistratum non <lb xml:id="p1z2"/>esse laturum, ut diutius hic haeream; neque enim taceo aut <lb xml:id="p1z3"/>in ocio dego.</s>
					<s n="2" xml:lang="la">Si princeps meus aderit, tunc domi eius tutior <lb xml:id="p1z4"/>sum futurus.</s>
					<s n="3" xml:lang="la">Parantur quidem comitia id est hospitia <lb xml:id="p1z5"/>pro principibus; sed adhuc sunt, qui putant ea non <lb xml:id="p1z6"/>habenda; at brevi hoc videbimus.</s>
					<s n="4" xml:lang="la">Ego <placeName ref="l512">Tubingam</placeName> <lb xml:id="p1z7"/>proxima septimana redibo, si dominus voluerit.</s>
					<s n="5" xml:lang="la">Hic <lb xml:id="p1z8"/>plurimi <persName>Sfenkfeldiani</persName>, ut nusquam plures.</s>
					<s n="6" xml:lang="la">Evangelium <lb xml:id="p1z9"/>pure praedicatur, et certe bonam operam navant mi<lb xml:id="p1z10"/>nistri, praesertim Meccardus, et acriter pugnat contr<lb xml:id="p1z11"/>a hęreses.</s>
					<s n="7" xml:lang="la">Multi sunt, qui bene sentiunt de <lb xml:id="p1z12"/>eucharistia, at dissimulant plerique; putant enim <lb xml:id="p1z13"/>tutiorem esse alteram viam quod ad carnem.</s>
					<s n="8" xml:lang="la">Mortuus <lb xml:id="p1z14"/>est unicus filius <persName>ducis Augusti</persName>, electoris, et decumbit <lb xml:id="p1z15"/>ipse periculoso morbo oppressus.</s>
					<s n="9" xml:lang="la">Palam affirmant <lb xml:id="p1z16"/><placeName ref="l1048">Brandeburgensem</placeName> rediisse in gratiam cum <persName ref="p8112">rege Galliarum</persName>, <lb xml:id="p1z17"/>quod placet omnibus his, qui <placeName ref="l822">Germ[aniae]</placeName> libertatem <lb xml:id="p1z18"/>amant.</s>
					<s n="10" xml:lang="la">Tace hoc unum, quod nunc dicam: in proximo <lb xml:id="p1z19"/>conventu principum actum fuit, quo pacto <lb xml:id="p1z20"/>esset exequtioni mittenda proscriptio seu bannum im<lb xml:id="p1z21"/>periale contra marchionem <placeName ref="l1048">Brandeburgensem</placeName>, et re infecta <lb xml:id="p1z22"/>discessum.</s>
					<s n="11" xml:lang="la">At brevi eadem de re alius instituetur conventus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/>Tandem perveni ad librum, quem diu quae<lb xml:id="p1z24"/>sivi cardinalis scilicet <persName>Poli</persName> <placeName ref="l830">Angli</placeName> pro papatu.</s>
					<s n="13" xml:lang="la">Est quidem <lb xml:id="p1z25"/>impressus <placeName ref="l425">Romae</placeName>, sed nullibi venalis erat et nonnisi <lb xml:id="p1z26"/>firmis papistis concedebatur.</s>
					<s n="14" xml:lang="la">Nullus fuit liber contra <lb xml:id="p1z27"/>nostram doctrinam scriptus aut callidior aut eloquentior.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z28"/>In 3. (sunt enim quatuor libri) insertus est ad <lb xml:id="p1z29"/><persName>Caesarem</persName> oratio, qua nos <placeName ref="l2510">Turcas</placeName> appellat et nititur persua<lb xml:id="p1z30"/>dere <pb/><lb xml:id="p2z1"/>illi, ut armis contra nos agat.</s>
					<s n="16" xml:lang="la">Hanc ego excerptam dedi <lb xml:id="p2z2"/><placeName ref="l18">Augustanis</placeName> fratribus, et brevi tota <placeName ref="l822">Germanica</placeName> spargetur; <lb xml:id="p2z3"/>quin imprimam hanc seorsum ornatam scho<lb xml:id="p2z4"/>liis, itaque paratos bonorum animos inveniet ille hypo<lb xml:id="p2z5"/>critarum princeps, si ad comitia venerit.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Non multo <lb xml:id="p2z6"/>post curabo totum librum imprimendum cum scholiis <lb xml:id="p2z7"/>et adiungam libellum Luteri de <lb xml:id="p2z8"/>papatu et Antichristum d. <persName ref="p8011">Rud[olphi] Gvalteri</persName>, et quid <lb xml:id="p2z9"/>tu scripseris in 16. Matth[aei] et ultimum Io[annis] et quid <lb xml:id="p2z10"/>reliqui nostrates, et spero te visurum omnia, <lb xml:id="p2z11"/>antequam edantur.</s>
					<s n="18" xml:lang="la" ana="farewell">Vale et salve.</s>
					<s n="19" xml:lang="la">Ora pro me <lb xml:id="p2z12"/>perpetuo laborante et te, <persName ref="p495">Henr[ice] Bullingere</persName>, ex <lb xml:id="p2z13"/>animo diligente.</s>
					<s n="20" xml:lang="la" ana="salute">Salvere iubeo omnes fratres.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z14"/><placeName ref="l18">Augustae</placeName> 30. martii 1554.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p2z15"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
