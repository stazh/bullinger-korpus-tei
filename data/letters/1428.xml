	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Gratus fuit mihi adventus <persName ref="p8101">Lęlii</persName>, qui tuas adtulit longe gratissimas.</s>
					<s n="3" xml:lang="la">Nihil <lb xml:id="p1z2"/>retulit nisi communia adductus a d. <persName ref="p714">Cęlio</persName>; non erat enim ocium.</s>
					<s n="4" xml:lang="la">Dum has reddam, <lb xml:id="p1z3"/>rogabo aliquid.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z4"/>Ex <placeName ref="l21">Badensibus</placeName> comitiis obiter narravit mihi consul nec reliquos Conf<lb xml:id="p1z5"/>oederatos missuros quenquam ad concilium, quod inter consultandum venerint literę <lb xml:id="p1z6"/>regis <placeName ref="l832">Francię</placeName> magno studio dehortantes, ne abirent vocati; nam quicquid <lb xml:id="p1z7"/>hic ageretur a Cęsare et pontifice, tenderet ad gravius dissidium Confoederationis nostrę, <lb xml:id="p1z8"/>et ut eo facilius nostra respublica per alterum tempore suo periret.</s>
					<s n="6" xml:lang="la">Hoc scriptum <lb xml:id="p1z9"/>fortiter rupit propositum papistarum, quod conceperant de concilio communis pacis <lb xml:id="p1z10"/>gratia; nam eam pacem gnaviter urserunt.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>De concilio dixerat <persName ref="p1278">Gastius</persName> die proxima solis iterum suspensum esse ad <lb xml:id="p1z12"/>calendas maii; credebam; nunc aliud audio et hoc ipsum credo: sic urget <lb xml:id="p1z13"/>Cęsar ex persuasione, quam nuper dixi, se non pręvaliturum <placeName ref="l2510">Turcę</placeName>, donec manser<lb xml:id="p1z14"/>it hęresis ista Lutherana in <placeName ref="l822">Germanicis</placeName> sua negligentia civitatibus.</s>
					<s n="8" xml:lang="la">Ita homo <lb xml:id="p1z15"/>ille vel a pfaffis suis vel a propria malicia vel ab utroque obcęcatus est.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>De <persName ref="p8111">Petro Martyre</persName> quod significas, vehementer placet; opto enim ei <lb xml:id="p1z17"/>viro, ut vivat in usum ecclesię quam diutissime.</s>
					<s n="10" xml:lang="la">De reliquis duobus ignoravi <lb xml:id="p1z18"/>decubuisse.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/>Duo ex <placeName ref="l18">Augustanis</placeName>, qui tecum fuerunt, descenderant <placeName ref="l491">Argentinam</placeName> ituri, credo, <lb xml:id="p1z20"/>in <placeName ref="l830">Angliam</placeName>.</s>
					<s n="12" xml:lang="la">Nudiustertius redierunt; misi, qui interrogaret de <lb xml:id="p1z21"/><placeName ref="l491">Argentinensibus</placeName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Responderunt Cęsarem nihil eis iniunxisse vel boni vel <lb xml:id="p1z22"/>mali; quamobrem satis tranquillos nunc esse.</s>
					<s n="14" xml:lang="la">De <placeName ref="l303">Magdeburgensibus</placeName> vero illud <lb xml:id="p1z23"/>narrari pro certo: ante paucos dies iterum erupisse et hostem tribus castris <lb xml:id="p1z24"/>plane exuisse et ita lętos rediisse in urbem.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z25"/>Onerarias naves <placeName ref="l832">Gallus</placeName> vix hodie per <placeName ref="l822">Germaniam</placeName> vehit, quidquid sit, quod <lb xml:id="p1z26"/>narratum est.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z27"/>Istud miserum, quod duo fratres illi tam fatales sunt orbi christianę, non solum <lb xml:id="p1z28"/><placeName ref="l822">Germanię</placeName>.</s>
					<s n="17" xml:lang="la">Credo magis ac magis fratri d. <persName>Egidii</persName>, qui dixit, dum adhuc <lb xml:id="p1z29"/>essem <placeName ref="l587">Tiguri</placeName>, ad <persName>Seslerum</persName> pistorem: "Donec principes illi <placeName ref="l850">Austrię</placeName> domini fuerint <lb xml:id="p1z30"/>in <placeName ref="l822">Germania</placeName>, erit hęc infelix in perpetuum usque:"</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="farewell">Vale in domino cu<lb xml:id="p1z31"/>m tuis et fratribus, inprimis d. <persName ref="p8127">Pellicano</persName>.</s>
					<s n="19" xml:lang="la"><placeName ref="l28">Basileę</placeName> 8. octobris anno 1551.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z32"/>Ago gratias de concione tua iam bis <lb xml:id="p1z33"/>missa; placet.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z34"/>T[uus] <persName ref="p8418">Os[valdus] Myconius</persName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>antistiti <placeName ref="l587">Tigurinorum</placeName>, <lb xml:id="p2z3"/>in domino fratri venerando <lb xml:id="p2z4"/>suo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>