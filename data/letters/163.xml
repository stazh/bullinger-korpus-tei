	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Respondere volenti ad tuas, colende mi <lb xml:id="p1z2"/><persName ref="p8418">Myconi</persName>, duo incommoda me interturbarunt, <lb xml:id="p1z3"/>prius discessus D. <persName ref="p8353">Frobenii</persName> festinantior <lb xml:id="p1z4"/>et celerior, quam putaram, posterius <lb xml:id="p1z5"/>mea incuria; amisi enim tuas literas, ut <lb xml:id="p1z6"/>iam non possim invenire et ordine respon<lb xml:id="p1z7"/>dere ad singula.</s>
					<s n="3" xml:lang="la">Scis autem me illas <lb xml:id="p1z8"/>mox reperturum; tum, si necesse erit, addam <lb xml:id="p1z9"/>auctarium.</s>
					<s n="4" xml:lang="la">Utinam vero sit verum <lb xml:id="p1z10"/>et certum <placeName ref="l491">Argentinenses</placeName> nolle Interim <lb xml:id="p1z11"/>recipere, sed velle in antiqua illa <lb xml:id="p1z12"/>sua confessione perseverare.</s>
					<s n="5" xml:lang="la">Scribit D. <persName ref="p8055">Am<lb xml:id="p1z13"/>brosius</persName> accepisse se bona fide literas, quas ad <lb xml:id="p1z14"/>ipsum per te et me <persName ref="p467">Bucerus</persName> misit; addit <lb xml:id="p1z15"/><persName ref="p467">Bucerum</persName> immerito accusari, quod approbarit <lb xml:id="p1z16"/>Interim.</s>
					<s n="6" xml:lang="la">Scio autem, unde exortus <lb xml:id="p1z17"/>sit rumor ille; <placeName ref="l473">Sangallum</placeName> literae sunt scriptae <lb xml:id="p1z18"/>significantes <persName ref="p467">Bucerum</persName> a Caesare vocatum <lb xml:id="p1z19"/>et rogatum approbasse Interim.</s>
					<s n="7" xml:lang="la">Ego vero <lb xml:id="p1z20"/>gaudeo mendacia scripsisse, qui illas <placeName ref="l473">San<lb xml:id="p1z21"/>gallum</placeName> scripsit, neque celabo D. <persName ref="p8049">Vadianum</persName>, quae <lb xml:id="p1z22"/>ab <persName ref="p8055">Ambrosio</persName> didici.</s>
					<s n="8" xml:lang="la">Utinam omnes docti evan<lb xml:id="p1z23"/>gelium bona fide agant.</s>
					<s n="9" xml:lang="la">Fama est episcopum <lb xml:id="p1z24"/><placeName ref="l257">Constantiensem</placeName> intra hoc octiduum obiisse apo<lb xml:id="p1z25"/>plexia; ego nondum credo.</s>
					<s n="10" xml:lang="la"><placeName ref="l257">Constantienses</placeName> <lb xml:id="p1z26"/>nondum sunt reconciliati <persName ref="p18538">Caesari</persName>.</s>
					<s n="11" xml:lang="la">Orandus <lb xml:id="p1z27"/>est dominus, ecclesiae suae adsit.</s>
					<s n="12" xml:lang="la">De <persName ref="p8184">Valtino <lb xml:id="p1z28"/>Telio</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8184">valentin Boltz</persName>.</note> alias; nunc nihil possum amplius.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z29"/>Vale aeternum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z30"/><placeName ref="l587">Tiguri</placeName> 20. iunii <lb xml:id="p1z31"/>1548.</s>
					<s n="15" xml:lang="la">Reliqua D. <persName ref="p8353">Frobenius</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z32"/><persName ref="p495">B(ullingerus)</persName> <lb xml:id="p1z33"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="17" xml:lang="la">Praest<lb xml:id="p1z34"/>antissimo viro D. <persName ref="p8418">Osvaldo Myconio</persName>, domino <lb xml:id="p1z35"/>et fratri suo colendissimo.</s>
				</p>
				<p>
					<note>[Am Rand zum Schluss des Briefes Bemerkung von <persName ref="p8418">Myconius</persName>:]</note>
					<s n="18" xml:lang="la"><lb xml:id="p1z36"/>Caesar <placeName ref="l257">Constantiensibus</placeName> Interim suum conatur i<lb xml:id="p1z37"/>mponere, dein ut pfaffos intromittant in civitatem s<lb xml:id="p1z38"/>uam ut ante, t<pb/><lb xml:id="p2z1"/>ertio ut civitas sit domui <placeName ref="l850">Austrię</placeName> dom<lb xml:id="p2z2"/>us propria, quarto u<lb xml:id="p2z3"/>t summam pecunię numerent, <lb xml:id="p2z4"/>nescio quantam, sed magnam.</s>
				</p>
			</div>
