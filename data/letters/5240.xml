	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Credo, charissime in Christo domine ac praeceptor obseervande, <lb xml:id="p1z2"/>literas istas, quas ex <placeName ref="l832">Gallia</placeName> d[ominationi] v[estrae] scripsi, ad manus <lb xml:id="p1z3"/>vestras pervenisse.</s>
					<s n="3" xml:lang="la">Caeterum diu est, quod nihil scripti dominationi ves<lb xml:id="p1z4"/>trae miserim, quod quidem non tam mea culpa, quam longinquę <lb xml:id="p1z5"/>peregrinationis mora evenit, de qua ut strictim dominationi vestrae <lb xml:id="p1z6"/>quaedam pro temporis angustia significem: 25. octobris <placeName ref="l378">Parisi<lb xml:id="p1z7"/>is</placeName> <placeName ref="l301">Lugdunum</placeName> bonis avibus iter in <placeName ref="l834">Italiam</placeName> suscepi; <lb xml:id="p1z8"/>primo igitur profectus sum <placeName ref="l306">Mediolanum</placeName>, deinde per <placeName ref="l150">Ferrariam</placeName> <lb xml:id="p1z9"/><placeName ref="l55">Bononiam</placeName>, <placeName ref="l1098">Florentiam</placeName>, <placeName ref="l425">Romam</placeName> veni, quam sanctam <lb xml:id="p1z10"/>appellant, sed ego [s]purcam existimo.</s>
					<s n="4" xml:lang="la"><placeName ref="l425">Roma</placeName> <placeName ref="l994">Neapolim</placeName>, <lb xml:id="p1z11"/>postea <placeName ref="l1409">Anconam</placeName>, dein <placeName ref="l522">Venetias</placeName> veni bona utcunque <lb xml:id="p1z12"/>usus fortuna, sed multa quoque adversa.</s>
					<s n="5" xml:lang="la"><placeName ref="l522">Venetiis</placeName> <placeName ref="l1107">Triden<lb xml:id="p1z13"/>tum</placeName> accessi; ibi omnia plena inveni cardinalibus, epis<lb xml:id="p1z14"/>copis, monachis et sacerdotibus, qui quidem multa <lb xml:id="p1z15"/>machinantur, sed nihil procedit; ipsi enim inter <lb xml:id="p1z16"/>se discordant.</s>
					<s n="6" xml:lang="la"><placeName ref="l1107">Tridento</placeName> per <placeName ref="l513">Ulmam</placeName> <placeName ref="l491">Argentinam</placeName>, <lb xml:id="p1z17"/>dein <placeName ref="l157">Francfortum</placeName> veni.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Eo cum venissem, statim <lb xml:id="p1z18"/>de vestrorum omnium valetudine ex <persName ref="p1227">Froscofero</persName> petens <lb xml:id="p1z19"/>omnia salva esse retulit, quae res mihi non parvam laetitiam <lb xml:id="p1z20"/>attulit et maiorem, quam scribere possim.</s>
					<s n="8" xml:lang="la">Dominatio vestra <lb xml:id="p1z21"/>hoc parvo epistolio contenta sit, oro; alias copiosius, <lb xml:id="p1z22"/>cum tempus maius detur, scripturus.</s>
					<s n="9" xml:lang="la">Salutet, quaeso, dominat<lb xml:id="p1z23"/>io vestra uxorem et liberos, quos deus omnipotens ad sui <lb xml:id="p1z24"/>gloriam conservet, oro.</s>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z25"/>Vale, praeceptor observande.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z26"/>Tuus <persName ref="p8499">Rando Schatter</persName>.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z27"/>1562. 24. martii.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietate ac religione <lb xml:id="p2z2"/>praestanti viro d. <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bullingero</persName>, christianę <lb xml:id="p2z4"/>religionis antisti<lb xml:id="p2z5"/>ti ac <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z6"/>ecclesię ministro, prae<lb xml:id="p2z7"/>ceptori suo observan<lb xml:id="p2z8"/>dissimo, hę literę.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z9"/><placeName ref="l587">Tiguri</placeName> <placeName ref="l862">Helvetio[rum]</placeName>.</s>
				</p>
			</div>
