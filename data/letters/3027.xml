	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Has literas usque ad Fodiemium dcem
					<lb xml:id="p1z2"/>qui est fortius octobris servavi
					<lb xml:id="p1z3"/>quo die sororum nuum a domino
					<lb xml:id="p1z4"/>convestabis rediisse sevimus. Is
					<lb xml:id="p1z5"/>hoc novi attulit. Regem Philippum
					<lb xml:id="p1z6"/>postulare, ut legati utrinquam ad agendum
					<lb xml:id="p1z7"/>e pace mittantur. Nos non sumus
					<lb xml:id="p1z8"/>aspernati. Octavo vel nono huius
					<lb xml:id="p1z9"/>sInter utraque castra ii legat
					<lb xml:id="p1z10"/>congredientur, et sane iam de pace
					<lb xml:id="p1z11"/>aliqua spes est
				</p>
			</div>
		</body>
	</text>
