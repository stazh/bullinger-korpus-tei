	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Optime in Christo pater.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Quoniam negocia aliqua Itali illi, qui <placeName ref="l167">Genevam</placeName> usque accesserunt, <lb xml:id="p1z3"/>mihi expediunda hic reliquerunt, ideo, cum iam omnia absolverim <lb xml:id="p1z4"/>et illos de omnibus certiores reddere opus sit, has meas humanitati <lb xml:id="p1z5"/>tuae afferenda dedi, ut illas eis reddas, cum <placeName ref="l587">Tigurum</placeName> <lb xml:id="p1z6"/>revertentur.</s>
					<s n="3" xml:lang="la">Heri nobis allatum fuit a nobili quodam Lucensi <lb xml:id="p1z7"/>d. <persName ref="p8111">Petri Martyris</persName> <placeName ref="l1098">Florentini</placeName> amantissimo, quemadmodum ipse <lb xml:id="p1z8"/><persName ref="p8111">Petrus Martyr</persName> vitam cum morte commutavit aut (ut rectius <lb xml:id="p1z9"/>loquar) mortem cum vita, et certo scias rem ita se habere.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>Iam diu hoc idem audieramus et literas habuimus, attamen <lb xml:id="p1z11"/>non credidimus; sed modo credimus et certo scimus.</s>
					<s n="5" xml:lang="la">Nobilis <lb xml:id="p1z12"/>enim ille ex <placeName ref="l15">Antverpia</placeName> venit et allocutus est alterum Lucensem <lb xml:id="p1z13"/>nobilem veluti ipsius <persName ref="p8111">Petri Martyris</persName> fratrem.</s>
					<s n="6" xml:lang="la">Hic in <lb xml:id="p1z14"/><placeName ref="l830">Anglia</placeName> fuit et retulit illum iam mortuum esse.</s>
					<s n="7" xml:lang="la">Intempestive <lb xml:id="p1z15"/>certe abeunt ex mundo huiuscemodi ecclesiae columnę (secundum <lb xml:id="p1z16"/>hominem dico); sed speramus in deum, qui novas continuo er<lb xml:id="p1z17"/>igit.</s>
					<s n="8" xml:lang="la">Valemus omnes in domino vosque eodem modo valere <lb xml:id="p1z18"/>audivimus et laetamur.</s>
					<s n="9" xml:lang="la" ana="salute">Saluta, quaeso, fratres meo nomine.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/><placeName ref="l28">Basileae</placeName> 8. idus augusti 1551.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/>Tuus in domino <lb xml:id="p1z21"/><persName ref="p8222">Hieronymus Massarius</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heynricho Bullingero</persName>, <lb xml:id="p2z2"/>optimo fidelissimoque verbi <lb xml:id="p2z3"/>dei ministro.</s>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
