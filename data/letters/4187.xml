	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ingentes tibi ago gratias filiaeque tuae <persName ref="p6609">Eli<lb xml:id="p1z2"/>zabethae</persName>, commatri nostrae charissimae, pro strena <lb xml:id="p1z3"/>filiolae meae missa.</s>
					<s n="3" xml:lang="la">Dominus rependat <lb xml:id="p1z4"/>vobis millecuplo faxitque, ut plurimos annos <lb xml:id="p1z5"/>faustos et foelices videatis.</s>
					<s n="4" xml:lang="la">Tu meo nomine <lb xml:id="p1z6"/>illi gratias agas, oro.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Scribit etiam filiola puerilia <lb xml:id="p1z7"/>hic quaedam ad ipsam matrinam suam.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Scripsissem ego tibi citius; sed nunc nuncios <lb xml:id="p1z9"/>habui praeter Maternum <placeName>Vratislaviensem</placeName> nec <lb xml:id="p1z10"/>materiam.</s>
					<s n="7" xml:lang="la">Cum <persName>Maternus</persName> hic esset, mihi <lb xml:id="p1z11"/>aliquo extra urbem proficiscendum erat, ut <lb xml:id="p1z12"/>per ipsum scribere non potuerim.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Nunc, cum <lb xml:id="p1z13"/>certum habeam nuncium, intermittere <lb xml:id="p1z14"/>non potui, quin vel saltem gratias tibi agerem; <lb xml:id="p1z15"/>nam aliud non habeo ne nunc quidem, <lb xml:id="p1z16"/>quod scriptu admodum dignum sit.</s>
					<s n="9" xml:lang="la">De <placeName ref="l2478">Sabaudo</placeName> <lb xml:id="p1z17"/>nihil audivimus interea.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">In <placeName ref="l832">Gallia</placeName> <placeName ref="l691">Lothoringus</placeName> <lb xml:id="p1z18"/>carnalis saevit praetextu regio.</s>
					<s n="11" xml:lang="la">De <placeName ref="l1028">Trevi<lb xml:id="p1z19"/>rensibus</placeName> frater scribit <persName>Oleverium</persName> liberatum, reliquos <lb xml:id="p1z20"/>eandem fere sortem nactos quam <placeName ref="l294">Locarnenses</placeName>.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z21"/><placeName ref="l646">Glaronenses</placeName> quomodo habeant, ipse melius nosti.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Cum <placeName ref="l167">Genevatibus</placeName> vetus remanet dissidium.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z23"/>Ceperant nobilem quendam, <placeName ref="l280">Lausanensem</placeName> <lb xml:id="p1z24"/>civem, dominum de <placeName>Vufflens</placeName>; sed dum n[o]stri <lb xml:id="p1z25"/>pro eo intercedunt, ipsi iterum [<lb xml:id="p1z26"/>dimi]serunt eum.</s>
					<s n="15" xml:lang="la">Faxit dominus, ut... <lb xml:id="p1z27"/>componantur omnia!</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute">Salutant te domini..<lb xml:id="p1z28"/>. <persName ref="p6801">Dillger</persName>, <persName ref="p8012">Haller</persName>, <persName ref="p8063">Steiger</persName>, d. item <persName ref="p3494">[Diesbach</persName>], <lb xml:id="p1z29"/>socer, mater et familia omnis precanturque tibi <lb xml:id="p1z30"/>tuisque annum faustum et foelicem, prosperitatem<lb xml:id="p1z31"/>que longaevam.</s>
					<s n="17" xml:lang="la" ana="salute">Saluta meo quoque nomine <lb xml:id="p1z32"/>tuos omnes precareque illis foelicia omnia.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l41">Bernae</placeName> <lb xml:id="p1z33"/>10. ianuarii 1560.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><persName ref="p8018">I[oannes] <lb xml:id="p1z34"/>Hall[erus</persName>] tuus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino et compatri suo <lb xml:id="p2z5"/>charissimo et colend<lb xml:id="p2z6"/>issimo.</s>
				</p>
			</div>
		</body>
	</text>
