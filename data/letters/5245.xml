	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Omnes et singulas tuas literas quas misisti, colendissim<lb xml:id="p1z2"/>e domine et frater charissime, usque ad adventum <persName ref="p8089">Scipionis</persName> Cal. <lb xml:id="p1z3"/>accepi, atque pro his maximas tibi ago gratias.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Dominum oro <lb xml:id="p1z4"/>ut <placeName ref="l832">Galliae</placeName> et nostrum omnium misertus eripiat illam et nos ex faucibus <lb xml:id="p1z5"/>leonis, ac sanctos suos confirmet ut stabiles et synceri <lb xml:id="p1z6"/>permaneant.</s>
					<s n="4" xml:lang="la">Interim venit nobilis <persName>Ludovicus a Bar</persName>, <lb xml:id="p1z7"/>qui recta proficiscebatur ad d. <persName ref="p3559">Hart. a Hallwyl</persName>, inde ad <lb xml:id="p1z8"/>principes <placeName ref="l822">Germaniae</placeName> aliquot missus a nostris illis principibus.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Vereor ne invenerit principes congregatos.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Nam potiores evo<lb xml:id="p1z10"/>carat <placeName ref="l1284">Bruxellam</placeName> supra <placeName ref="l471">Spiram</placeName> <placeName ref="l572">Wirtembergensis</placeName>.</s>
					<s n="7" xml:lang="la">Utinam non egerit apud eos causam <persName>Guysianorum</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/>Illuc festinavit <persName>Ludovicus</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Venit interea et d. <persName ref="p629">Coignetius</persName> <lb xml:id="p1z12"/>ad quem illa ipsa de re scripserat <persName ref="p918">Admiraldus</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Vocavi<lb xml:id="p1z13"/>t ergo <persName ref="p629">Cognetius</persName> <placeName ref="l587">Tigurum</placeName> illum ab <placeName ref="l203">Hallwyl</placeName>.</s>
					<s n="11" xml:lang="la">Venit.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Egit cum <lb xml:id="p1z14"/>illo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Significavit <persName ref="p3559">Hall.</persName></s>
					<s n="14" xml:lang="la">quorundam animos refrixisse, ubi <lb xml:id="p1z15"/>audiverunt defecisse a veritate regem <placeName ref="l1209">Navar</placeName>.</s>
					<s n="15" xml:lang="la">et postquam <lb xml:id="p1z16"/>auditi sunt <placeName>Guysiani</placeName> a <placeName ref="l572">Wirtenbergensi</placeName> ad <placeName ref="l2074">Tabernas</placeName> <placeName ref="l632">alsaticas</placeName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z17"/>Caeterum postquam intellexerunt alios principes manere <lb xml:id="p1z18"/>synceros et constantes crevisse rursus ipsorum animos.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z19"/>Ideoque audito <persName>Ludovico a Bar</persName> ipsum (<persName ref="p3559">Hall.</persName>) veluti de novo <lb xml:id="p1z20"/>solicitans(?) quosdam istorum, a quibus responsum exspectet dandum <lb xml:id="p1z21"/>hisce diebus.</s>
					<s n="18" xml:lang="la">Quod referet ad <persName ref="p629">Cognetium</persName>, tum etiam per me <lb xml:id="p1z22"/>atque te ad d. <persName ref="p8033">Bezam</persName> et principes.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Optime spe<lb xml:id="p1z23"/>rat <lb xml:id="p1z24"/><persName ref="p3559">Hall.</persName></s>
					<s n="20" xml:lang="la">quanquam nihil dubitet <lb xml:id="p1z26"/>animos <lb xml:id="p1z28"/>per <lb xml:id="p1z29"/>acti<lb xml:id="p1z31"/>onem <lb xml:id="p1z32"/>illam <lb xml:id="p1z33"/>als<lb xml:id="p1z34"/>atic<lb xml:id="p1z35"/>am non<lb xml:id="p1z36"/>nihil per<lb xml:id="p1z37"/>turb<lb xml:id="p1z38"/>atam <lb xml:id="p1z39"/>et im<lb xml:id="p1z40"/>peditam.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z41"/>Dominu<lb xml:id="p1z42"/>s dissipe<lb xml:id="p1z43"/>t co<lb xml:id="p1z44"/>nsilia i<lb xml:id="p1z45"/>mp<lb xml:id="p1z46"/>iorum.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z48"/>Vigila<lb xml:id="p1z49"/>bunt <lb xml:id="p1z50"/>b<lb xml:id="p1z51"/>oni in <lb xml:id="p1z52"/><placeName ref="l832">Gallia</placeName> et o<lb xml:id="p1z53"/>rabunt d<lb xml:id="p1z54"/>ominum <lb xml:id="p1z55"/>ne <persName>G<lb xml:id="p1z56"/>uysii</persName> il<lb xml:id="p1z57"/>li <lb xml:id="p1z58"/>mag<lb xml:id="p1z60"/>num de<pb/><lb xml:id="p2z1"/>nt mal<lb xml:id="p2z2"/>um, adi<lb xml:id="p2z3"/>uti vi<lb xml:id="p2z4"/>delice<lb xml:id="p2z5"/>t op<lb xml:id="p2z6"/>era <placeName ref="l875">Hi<lb xml:id="p2z7"/>spani</placeName> et pont<lb xml:id="p2z8"/>ificis et quoru<lb xml:id="p2z9"/>ndam a<lb xml:id="p2z10"/>lio<lb xml:id="p2z11"/>rum hos<lb xml:id="p2z12"/>tium ev<lb xml:id="p2z13"/>ange<lb xml:id="p2z15"/>li<lb xml:id="p2z16"/>i.</s>
				</p>
			</div>
		</body>
	</text>
