	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Nos vero Chlristi et isti pater dominus, in
					<lb xml:id="p1z2"/>tibi agem et sacems gratan
					<lb xml:id="p1z3"/>sabinde vis cumulas benefecii et
					<lb xml:id="p1z4"/>dones. Ego vero, quid adhea in te cilule
					<lb xml:id="p1z5"/>quid
					<lb xml:id="p1z6"/>vedeit, inquaratur sane; se dabiti milendi
					<lb xml:id="p1z7"/>esponscndi occasio in satis qua esti, praesentio
					<lb xml:id="p1z8"/>divei sui tempore referamus.
					<lb xml:id="p1z9"/>prcc egi
					<lb xml:id="p1z10"/>munus eo fuit gatins, qui a tuli et tant
					<lb xml:id="p1z11"/>amico profecui nam et tua etia not cum
					<lb xml:id="p1z12"/>letia nulli non dabitur pissum tamu
					<lb xml:id="p1z13"/>vere dum, ut te deuturna vetu ea
					<lb xml:id="p1z14"/>daret, dinei ei hunc, quem es eue.
					<lb xml:id="p1z15"/>gressia profilam perfecere; eni in aliis nam
					<lb xml:id="p1z16"/>qua sic, felicetet perqua
					<lb xml:id="p1z17"/>salutati omnes, atque sid Namprisens.
					<lb xml:id="p1z18"/>officiisissime tuc neverotiam rensulutan.
					<lb xml:id="p1z19"/>Galli ne sum adhuc nusi obserere lute.
					<lb xml:id="p1z20"/>lurgum in permulti elliti fuere, nstrus
					<lb xml:id="p1z21"/>repiines trucediti, nisi tamen ceti
					<lb xml:id="p1z22"/>sededissum Theumvillam, venissem illise
					<lb xml:id="p1z23"/>sedeo Lutenburgenses cum 5000 egtumses
					<lb xml:id="p1z24"/>eram prsenvilte, id eos latebatin pullica
					<lb xml:id="p1z25"/>est fama, Philippum cum exercim, reita
					<lb xml:id="p1z26"/>cegetur Luteteam et brevi irrupems
					<lb xml:id="p1z27"/>Gallea, factiorum vale optime pater.
					<lb xml:id="p1z28"/>Ts ded.
					<lb xml:id="p1z29"/>Arget 10. iulii anno 18.
					<lb xml:id="p1z30"/>Hieo pencia
					<pb/>
					<lb xml:id="p2z1"/>pietate et doctrina clari
					<lb xml:id="p2z2"/>.Bullingero, Tno Tigur
					<lb xml:id="p2z3"/>rer pestori diu etclesiae
					<lb xml:id="p2z4"/>Tigurum.
				</p>
