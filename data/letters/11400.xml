	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>N<lb xml:id="p1z2"/>ae eg<lb xml:id="p1z3"/>o <lb xml:id="p1z5"/>sim vere inhumanus, doctissime <persName ref="p495">Bullingere</persName>, ni te <lb xml:id="p1z6"/>literis meis salutem, qui me cum apud vos essem tanta <lb xml:id="p1z7"/>humanitate tractaris.</s>
					<s n="2" xml:lang="la">Quod autem proximis nundini<lb xml:id="p1z8"/>s nihil scripserim, tu causam conjicere potes.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z9"/>Nunc etiamsi eadem causa fortassis remaneat, <lb xml:id="p1z10"/>silentium tamen rumpendum duxi, ne non tam temporis <lb xml:id="p1z11"/>quam negligentiae atque oblivionis cessatio mea <lb xml:id="p1z12"/>videri possit: id quod, crede mihi, in mores meos non <lb xml:id="p1z13"/>cadit.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z14"/>Nam neque animus meus a mutuo amore <lb xml:id="p1z15"/>abhorret, et humanitatis mihi exhibitae, ut si quis <lb xml:id="p1z16"/>alius, minime immemor sum.</s>
					<s n="5" xml:lang="la">In praesentia nihil e<lb xml:id="p1z17"/>st <lb xml:id="p1z18"/>quod scribam, quam omnes monachos nostrates nomen suum amisisse, <lb xml:id="p1z19"/>aliquot ex maximis monasteriis facta esse scho<lb xml:id="p1z20"/>las studiosorum, paulo ante festum natalitium supplicium <lb xml:id="p1z21"/>sumptum esse de tribus opulentissimis abbatibus, <lb xml:id="p1z22"/>quod inter se de restituendo papa conspirassent.</s>
					<s n="6" xml:lang="la">Non <lb xml:id="p1z23"/>est praetereundum, episcopum Wintoniensem adverso po<lb xml:id="p1z24"/>puli fremitu admodum papistice concionatum esse <lb xml:id="p1z25"/>primo Dominico quadragesimali, huicque sequenti Domini<lb xml:id="p1z26"/>co doctorem <persName ref="p4238">Barnes</persName> egregie respondisse gratissima pe<lb xml:id="p1z27"/>ne omnium admurmuratione.</s>
					<s n="7" xml:lang="la">Quae potissimum tractavit <lb xml:id="p1z28"/>episcopus, ad <persName ref="p506">Joannem Butlerum</persName> scripsi, ex quo cognoscere <lb xml:id="p1z29"/>potes.</s>
					<s n="8" xml:lang="la">Alia ab aliis accipies.</s>
					<s n="9" xml:lang="la">Dominus <persName ref="p4216">Audlaeus</persName>, vir <lb xml:id="p1z30"/>egregius, famulus regis, ex nostra praedicatione <lb xml:id="p1z31"/>factus est tui amantissimus, jussitque ut non modo <lb xml:id="p1z32"/>te suis verbis accurate salutarem, verum etiam ut tibi <lb xml:id="p1z33"/>indicarem, si filium tuum huc miseris, se illum ea <lb xml:id="p1z34"/>humanitate tractaturum, qua proles carissimi <lb xml:id="p1z35"/>et singularis viri tractari debet.</s>
					<s n="10" xml:lang="la" ana="salute">Salvere <lb xml:id="p1z36"/>plurimum jubeo matrem tuam, uxorem, fratrem, liber<lb xml:id="p1z37"/>os, totamque reliquam familiam.</s>
					<s n="11" xml:lang="la" ana="salute">Parem salutem meis <lb xml:id="p1z38"/>verbis ascribes D. <persName ref="p8127">Pellicano</persName>, D. <persName ref="p1753">Judae</persName>, D. <persName ref="p8428">Rhelicano</persName>, <lb xml:id="p1z39"/>D. <persName ref="p8412">Megandro</persName>, viris optimis atque lectissimis.</s>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z40"/>Vale.</s>
					<s n="13" xml:lang="la"><placeName ref="l296">Londini</placeName>, <lb xml:id="p1z41"/>20 die Februarii.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">INSCRIPTIO.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Henrico B.</persName></s>
				</p>
