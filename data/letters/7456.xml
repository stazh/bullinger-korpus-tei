	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Iam dudum hac te cura liberavi, d. <persName ref="p495">Bullingere</persName> charis<lb xml:id="p1z2"/>sime, ne me offendi literarum tuarum vel raritate vel brevitate <lb xml:id="p1z3"/>putes.</s>
					<s n="3" xml:lang="la">Quia vero me id ipsum impetrasse vicissim <lb xml:id="p1z4"/>ab humanitate tua confido, non sum veritus iuveni huic, <lb xml:id="p1z5"/><persName>Io[anni] Conradi Maiori</persName> <placeName ref="l441">Schafhusiano</placeName>, ad te dare perferendam e<lb xml:id="p1z6"/>pistolam valde etiam pusillam.</s>
					<s n="4" xml:lang="la">Tantum igitur scito, quas ad me <lb xml:id="p1z7"/><persName ref="p8018">Hallerumque</persName> scripsisti 20. aprilis, eas mihi postridie calendas <lb xml:id="p1z8"/>maias esse redditas meque <persName ref="p8018">Hallero</persName> suam iam misisse <lb xml:id="p1z9"/>ex d. <persName ref="p3740">Stettensi</persName>, quae de rebus <placeName ref="l832">Gallicis</placeName> scripsisti, me adhuc <lb xml:id="p1z10"/>cognoscere non potuisse, quod in arce cum familia vivens <lb xml:id="p1z11"/>commeare ad nos rarius solet egoque, quod decocto ligni <lb xml:id="p1z12"/>Guaiaci sum mense hoc proximo usus, domo non exivi.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z13"/>A d. <persName ref="p8018">Hallero</persName> si quid accepero, faciam, ut quam primum <lb xml:id="p1z14"/>reddatur tibi.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Quod reliquum est, bene vale et d. <lb xml:id="p1z15"/><persName ref="p8011">Gvalthero</persName> nec non generis suavissimis tuis filioque <lb xml:id="p1z16"/>meis verbis S.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l18">Augustae</placeName> postridie nonas maias 1568.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><persName ref="p2899">M[a<lb xml:id="p1z17"/>tthias] <lb xml:id="p1z18"/>Schenckius</persName> t[uus].</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Humanissimo simul et <lb xml:id="p2z2"/>doctissimo viro <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, ecclesia<lb xml:id="p2z4"/>stae <placeName ref="l587">Tigurino</placeName>, domino <lb xml:id="p2z5"/>atque amico primario.</s>
				</p>
			</div>
		</body>
