	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Ich bith den <lb xml:id="p1z2"/>herren gantz vliss<lb xml:id="p1z3"/>ig, e. e. wolle meins lieben mitbrueders <lb xml:id="p1z4"/>nit vergessen.</s>
					<s n="2" xml:lang="de">Sein nahm ist <persName ref="p20425">Joannes Eckel</persName> von <placeName ref="l202">Hall</placeName> im <placeName ref="l2922">Inthal</placeName>, <lb xml:id="p1z5"/>predicant zue <placeName ref="l2716">Herbishoffen</placeName> im <placeName ref="l6">Algey</placeName>.</s>
				</p>
				<p>
					<note>[Ohne Adresse.]</note>
					<note>[Vgl. <persName ref="p8027">Bechlins</persName> Briefe vom 13. Dez. 1569 und [Dez./Jan. 1569/70]]</note>
				</p>
			</div>
		</body>
	</text>
