	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi literas tuas, dilecte frater, quibus significas <lb xml:id="p1z2"/>te non immiscere temetipsum controversiae <lb xml:id="p1z3"/>episcopi ac <placeName ref="l648">Rhetorum</placeName>.</s>
					<s n="3" xml:lang="la">Prudenter sane et recte facis; satis <lb xml:id="p1z4"/>est, si pro officio tuo subinde id, quod ad pacem utriusque <lb xml:id="p1z5"/>fecerit, urseris, te vero partibus odiose non adiunxeris.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Quae scripsisti ex traditione viri strenui d. <persName>Caroli</persName>, <lb xml:id="p1z7"/>tristia quidem sunt, sed dignissima, quae a nobis ob<lb xml:id="p1z8"/>serventur; dominus aperiat nobis oculos.</s>
					<s n="5" xml:lang="la" ana="salute">Tu gratias illi <lb xml:id="p1z9"/>meo nomine ages maximissimas, ut sic loquar; <lb xml:id="p1z10"/>salutabis ipsum humanissime.</s>
					<s n="6" xml:lang="la">Quae a republica <placeName ref="l41">Bernatum</placeName> <lb xml:id="p1z11"/>de tristissimis <placeName ref="l832">Galliae</placeName> motibus ad magistratum <lb xml:id="p1z12"/>vestrum sunt transscripta, facile a piis assequeris; <lb xml:id="p1z13"/>parces autem mihi, quod de his nihil scripsi, de quibus <lb xml:id="p1z14"/>certius instrueris a tuis.</s>
					<s n="7" xml:lang="la" ana="farewell">Aeternum vale, mi <lb xml:id="p1z15"/>frater.</s>
					<s n="8" xml:lang="la">Contende precibus ad dominum tuis, hortare <lb xml:id="p1z16"/>ecclesiam tibi creditam ad preces et poenitentiam.</s>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z17"/>Saluta d. d. d. consules, <persName ref="p6130">Pontisellam</persName> et <persName ref="p20473">Ganthnerum</persName> aliosque <lb xml:id="p1z18"/>viros bonos et legatum regium inprimis.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 9. <lb xml:id="p1z19"/>octobris 1567.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <persName ref="p8016">Thobiae <lb xml:id="p2z2"/>Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro fideli, <lb xml:id="p2z4"/>symmystae et fratri meo <lb xml:id="p2z5"/>charissimo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
