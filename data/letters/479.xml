	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Pro libro, quem tu misisti ad me proque eo, quem <lb xml:id="p1z2"/>paulo ante donaras, habeo tibi gratiam, quam et <lb xml:id="p1z3"/>iamiam referrem, si commentariolo meo de <placeName ref="l2510">Turicicis</placeName> <lb xml:id="p1z4"/>rebus summa esset imposita manus; sed in id adhuc <lb xml:id="p1z5"/>incumbo, quoties vacat, neque video, quod tam cito possit <lb xml:id="p1z6"/>manumitti.</s>
					<s n="3" xml:lang="la">Liberabo tamen fidem tempore manumissumque <lb xml:id="p1z7"/>(qualequale fuerit) perferri ad te curabo.</s>
					<s n="4" xml:lang="la">Gratum <lb xml:id="p1z8"/>facies, si quando ad nos scribas, gratissimum, si, quę <lb xml:id="p1z9"/>habes nova vel cognitu iucunda vel nostris scitu necessari<lb xml:id="p1z10"/>a.</s>
					<s n="5" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><placeName ref="l28">Basileae</placeName> tertio calandas Apriles 1548 more <placeName ref="l832">Gallico</placeName>, <lb xml:id="p1z11"/>vestro 1549.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Ex animo tuus <lb xml:id="p1z13"/><persName ref="p2706">Christophorus Richerius</persName><pb/><lb xml:id="p2z2"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="8" xml:lang="la"><lb xml:id="p2z3"/>Pietate literarumque peritia claro et <lb xml:id="p2z4"/>venerando viro D. <persName ref="p495">Heinrycho <lb xml:id="p2z5"/>Bullingero</persName>, <placeName ref="l587">Tigurino</placeName> pastori, amico <lb xml:id="p2z6"/>suo ex animo charo.</s>
					<s n="9" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note type="author">[Bemerkung von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="10" xml:lang="la"><persName ref="p2706">Chris<lb xml:id="p2z7"/>tophorus Rycherius</persName>.</s>
				</p>
			</div>
		</body>
