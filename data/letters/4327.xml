	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nihil quidem nunc habeo, quod scribam, nisi <lb xml:id="p1z2"/>quod hasce domini <persName ref="p8063">Steigeri</persName> literas ad te sine meis <lb xml:id="p1z3"/>dimittere non possim.</s>
					<s n="3" xml:lang="la">Gratias is agit tibi pro honorario <lb xml:id="p1z4"/>ad istum ad <placeName>Thermas</placeName> misso.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Scribit quoque de <lb xml:id="p1z5"/><placeName>Valesianis</placeName>, ut mihi significavit, ut non sit opus <lb xml:id="p1z6"/>his addere plura.</s>
					<s n="5" xml:lang="la">Rediit etiam heri d. <persName>Simon <lb xml:id="p1z7"/>Wurstenbergerus</persName> (nam d. <persName ref="p3494">N[icolaus] de Diesbach</persName> <placeName ref="l21">Ba<lb xml:id="p1z8"/>denae</placeName> mansit).</s>
					<s n="6" xml:lang="la">Is supra modum commendat <lb xml:id="p1z9"/>et praedicat, qua humanitate, quo honore et magni<lb xml:id="p1z10"/>ficentia <placeName ref="l587">Tiguri</placeName> sint excepti, quomodo etiam tu privatim <lb xml:id="p1z11"/>eos acceperis atque itidem quoque dominus <persName ref="p8011">Gvalt<lb xml:id="p1z12"/>herus</persName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Unde est, quod vestro nomine plurimum gau<lb xml:id="p1z13"/>deam, et spero inde fore, ut maior concord<lb xml:id="p1z14"/>ia et benevolentia inter utramque rempublicam <lb xml:id="p1z15"/>gignatur.</s>
					<s n="8" xml:lang="la">De novo consule vobis gratulor.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>In nostri Watenvilii locum post biennium <lb xml:id="p1z17"/>demum (ordine sic requirente) alius eligetur.</s>
					<s n="10" xml:lang="la">Faxit <lb xml:id="p1z18"/>dominus, ut talem habeamus, qualem amisimus, pietate <lb xml:id="p1z19"/>certe, prudentia et fortitudine praestantissimum.</s>
					<s n="11" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z20"/>vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Salutem dic d. <persName ref="p8011">Gvalthero</persName>, d. <persName ref="p8111">Martyri</persName>, <lb xml:id="p1z21"/>uxori item atque universae domui tuae.</s>
					<s n="13" xml:lang="la"><placeName ref="l41">Bernae</placeName> 26. iunii 1560<lb xml:id="p1z22"/>.</s>
				</p>
				<p>
