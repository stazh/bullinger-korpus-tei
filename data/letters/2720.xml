	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Compater in domino charissime, quamvis duas <lb xml:id="p1z2"/>satis elegantes ac vivas epistolas, d. <persName ref="p8018">Hallerum</persName> <lb xml:id="p1z3"/>videlicet et d. <persName>Nicolaum</persName>, a pueris compatres <lb xml:id="p1z4"/>meos charissimos, accipiatis a nobis, <lb xml:id="p1z5"/>ex quibus omnia nostra rescire poteris, <lb xml:id="p1z6"/>visum tamen est prudentiam tuam uno et altero <lb xml:id="p1z7"/>verbo de causa <placeName ref="l167">Genevensium</placeName> admonere, <lb xml:id="p1z8"/>quae meo iudicio sic quotidie peior ac peior <lb xml:id="p1z9"/>redditur, ut metuendum sit, ne ex hac <lb xml:id="p1z10"/>simultate duabus hisce, nostrę et ipsorum <lb xml:id="p1z11"/>civitatibus incendium exoriatur, ad quod <lb xml:id="p1z12"/>restinguendum et vestris et reliquis vicinis <lb xml:id="p1z13"/>summopere sit laborandum.</s>
					<s n="3" xml:lang="la">Odium nominis <persName ref="p540">Calvini</persName>, <lb xml:id="p1z14"/>fratris in domino dilecti, malo quorundam <lb xml:id="p1z15"/>hominum studio usque adeo augescit, ut verear, <lb xml:id="p1z16"/>ne, si quid tumultuationis et discriminis <lb xml:id="p1z17"/>oriatur, omnis mala causa in caput ipsius <lb xml:id="p1z18"/>reiiciatur.</s>
					<s n="4" xml:lang="la">Quare videtur mihi admonendus, <lb xml:id="p1z19"/>ut summo studio caveat, ne dę hę civitates <lb xml:id="p1z20"/>a se invicem dissiliant.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Nec dubito, si <lb xml:id="p1z21"/>suis author esse voluerit, ut societati <placeName ref="l41">Ber<lb xml:id="p1z22"/>natum</placeName> sese accommodant, facile hoc <lb xml:id="p1z23"/>impetraturum; id quod hoc debet diligentius <lb xml:id="p1z24"/>curare, quo certius est, si dissiliat ista soci<lb xml:id="p1z25"/>etas, causam uni ipsi cum <placeName ref="l832">Gallis</placeName>, quos secum <lb xml:id="p1z26"/>habet, fore tribuendam.</s>
					<s n="6" xml:lang="la">Verum hac de re <lb xml:id="p1z27"/>et plura et certiora a duobus hisce fratribus <lb xml:id="p1z28"/>et amicis meis rescire poteris.</s>
					<s n="7" xml:lang="la">Haec <lb xml:id="p1z29"/>propterea tantum ad te scripsi, ut occasionem <lb xml:id="p1z30"/>ex literis meis habeas cum illis hac de <lb xml:id="p1z31"/>re conferendi.</s>
					<s n="8" xml:lang="la">Quod ut boni consulas, <lb xml:id="p1z32"/>oro.</s>
					<s n="9" xml:lang="la" ana="salute">Salutem domui tuae et reliquis dominis <lb xml:id="p1z33"/>ac fratribus.</s>
					<s n="10" xml:lang="la" ana="farewell">Optime vale in Christo servatore.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z34"/><placeName ref="l41">Bernę</placeName> 1555. 8. septembris.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><persName ref="p8417">W[olf<lb xml:id="p1z35"/>gangus] Musc[ulus]</persName>, tuus <lb xml:id="p1z36"/>in domino.</s>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo m. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho Bul<lb xml:id="p2z4"/>lingero</persName>, domino ac <lb xml:id="p2z5"/>compatri suo <lb xml:id="p2z6"/>longe charissimo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
