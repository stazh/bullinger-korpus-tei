	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Quę de obsidione urbis nostrę scripsi, timentur magis a quibusdam <lb xml:id="p1z3"/>quam re vera timenda sint.</s>
					<s n="2" xml:lang="la">D. <persName ref="p2856">Gerion Seyler</persName> ob nescio quos <lb xml:id="p1z4"/>rumores in <placeName ref="l619">Bavariam</placeName> spars s iussu principis <placeName ref="l619">Bavarię</placeName> custodię <lb xml:id="p1z5"/>datus est, ut dixi, altero... liber dimissus.</s>
					<s n="3" xml:lang="la">Timent sibi <lb xml:id="p1z6"/>papistici magis, quam necesse sit; nostri e diverso ferociores se <lb xml:id="p1z7"/>ostentant, quam re vera sint.</s>
					<s n="4" xml:lang="la">Ad conventum <placeName ref="l231">Ingolstadiensem</placeName> legati <lb xml:id="p1z8"/>trium principum (nescio quorum, sed non ex evangelicis) venerunt <lb xml:id="p1z9"/>composituri forte hocce dissidium.</s>
					<s n="5" xml:lang="la">Cardinalis <placeName ref="l691">Lotharingię</placeName> <lb xml:id="p1z10"/>globulo bombardę a quodam, cuius fratrem cremari iusserat, traiectus <lb xml:id="p1z11"/>interiit; ita mihi hodie pro certo relatum est.</s>
					<s n="6" xml:lang="la">Imperator noster <lb xml:id="p1z12"/>quid agat, nihil audio; audio autem, quae effari non audeo, ... <lb xml:id="p1z13"/>utpote nondum satis comperta.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Datum 8. marcii anno 1560.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">R[<lb xml:id="p1z14"/>everentiae] t[uae] deditissimus <persName ref="p3740">Georgius a <lb xml:id="p1z15"/>Stetten iunior</persName>.</s>
				</p>
				<p>
					<note type="address">[Ohne Adresse.]</note>
				</p>
			</div>
		</body>
	</text>
