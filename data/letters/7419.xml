	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Binas tuas accepi, chare frater, et laudo <lb xml:id="p1z2"/>tuam in scribendo diligentiam, imo et gratias <lb xml:id="p1z3"/>ago.</s>
					<s n="3" xml:lang="la" ana="salute">Oro, ut me commendes d. consulibus<note type="margin">a.R.: cosss.</note> et d. <persName ref="p1770">Carolo</persName>, <lb xml:id="p1z4"/><persName ref="p6130">Pontisellę</persName> nostro et <persName ref="p20473">Ganthnero</persName>, quos omnes salu<lb xml:id="p1z5"/>tabis meo nomine officiosissime.</s>
					<s n="4" xml:lang="la">Condonabis <lb xml:id="p1z6"/>mihi, quod brevior sum; nunc enim tempus <lb xml:id="p1z7"/>est, quo literas meas paro <placeName ref="l157">Francfortum</placeName> transmittendas <lb xml:id="p1z8"/>inde ad amicos meos (qui mihi scripserunt <lb xml:id="p1z9"/>et quibus respondere oportet) in <placeName ref="l2477">Palatinatum</placeName>, <placeName ref="l213">Hessiam</placeName>, <lb xml:id="p1z10"/><placeName ref="l749">Saxoniam</placeName>, <placeName ref="l267">Coloniam</placeName>, <placeName ref="l830">Angliam</placeName>, <placeName ref="l2562">Prussiam</placeName>, <placeName ref="l2472">Po<lb xml:id="p1z11"/>loniam</placeName> et in alia loca plura.</s>
					<s n="5" xml:lang="la">Quae allata <lb xml:id="p1z12"/>sunt, curavi describi tibi; quae imposui <lb xml:id="p1z13"/>his.</s>
					<s n="6" xml:lang="la"><persName ref="p1012">Aernius</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p1012">Leonhard Erni</persName>.</note> noster mecum iam prandebit; <lb xml:id="p1z14"/>tradidi ei tuas.</s>
					<s n="7" xml:lang="la" ana="salute">Eius nomine te quam dili<lb xml:id="p1z15"/>gentissime et amicissime saluto ut et nomine <lb xml:id="p1z16"/>meorum.</s>
					<s n="8" xml:lang="la">Dominus benedicat tibi et servet te!</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/>Strenue ego cum tussi et catharro concerto.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Dominus dignetur me brevi ex integro hac <lb xml:id="p1z19"/>etiam liberare molestia!</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale semper.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z20"/>19. martii 1568.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="14" xml:lang="de"><lb xml:id="p1z22"/>Ich acht wol, das <persName ref="p4226">Hans Bader</persName> hinuff gebracht, sye <lb xml:id="p1z23"/>anders nüt dann die hispanisch unruͦw; <lb xml:id="p1z24"/>dann es allen bäpstlern gar ein bitter <lb xml:id="p1z25"/>crütz, und nitt unbillich.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z26"/>Vide, ut prudenter iis, quae scribo, utaris; non <lb xml:id="p1z27"/>omnibus communices et ut spargatur meo nomine.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z28"/>Aliquando enim ea, quae incerta sunt, pro certis <lb xml:id="p1z29"/>scribuntur; at horum author haberi nolim.</s>
					<s n="17" xml:lang="la">Ego <lb xml:id="p1z30"/>bona fide tibi communico, quae ab aliis accipio, <lb xml:id="p1z31"/>et ita, ut accipio, tibi communico.</s>
					<s n="18" xml:lang="la">Sit fides <lb xml:id="p1z32"/>apud lectorem.</s>
					<s n="19" xml:lang="la" ana="farewell">Iterum vale etc.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <lb xml:id="p2z2"/><persName ref="p8016">Thobiae Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro fideli, <lb xml:id="p2z4"/>domino meo colendo et <lb xml:id="p2z5"/>fratri charissimo.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z6"/>Chur.</s>
				</p>
			</div>
		</body>
	</text>
