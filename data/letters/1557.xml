	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Quem ad me venturum scripseras, non venit; alias et nobilis ab <lb xml:id="p1z2"/><placeName ref="l203">Hallwyl</placeName> et <persName ref="p3494">Nicolaus a Dispach</persName> humaniter illum tractassent.</s>
					<s n="2" xml:lang="la">Absentia <lb xml:id="p1z3"/>illius doctoris a Nytpruck nos multis privavit, quę scire <lb xml:id="p1z4"/>ex animo cupiebamus audire.</s>
					<s n="3" xml:lang="la">De <placeName ref="l1107">Tridentino</placeName> conciliabulo omnia bene <lb xml:id="p1z5"/>procedunt, quandoquidem omnes pii ab illo aliud nihil profecturum sperarunt <lb xml:id="p1z6"/>unquam.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Audies brevi, quid <placeName ref="l41">Bernensis</placeName> senatus noster cum <placeName ref="l832">Gallorum</placeName> <lb xml:id="p1z7"/>rege in consulto habeat (tibi scribo).</s>
					<s n="5" xml:lang="la">Ego vereor illos veluti cum <lb xml:id="p1z8"/>rege <placeName ref="l2688">Aegyptiorum</placeName> pactum inituros.</s>
					<s n="6" xml:lang="la">Christus praeveniat omnes omnium <lb xml:id="p1z9"/>conatus, quibus cursui evangelii non fuerit consultum.</s>
					<s n="7" xml:lang="la">Paucis hec; plura <lb xml:id="p1z10"/>non potest invalida manus mea.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale in domino, amice incomparabilis.</s>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z11"/>Saluta uxorem tuam, <foreign xml:lang="de">mins liebs muterlin,</foreign> et totam tuam familiam.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute"><lb xml:id="p1z12"/>Salutat te mea costa, arcis praefectus, avunculus tuus, a[r]chescriba <lb xml:id="p1z13"/><persName ref="p8369">Hammannus</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8369">Haberer</persName>.</note> et urbi prefectus.</s>
					<s n="11" xml:lang="la">Datum <placeName ref="l285">Lentzburgi</placeName> 3. februarii 1552.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z14"/>Tuus <persName ref="p8440">Gervasius</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>domino fratri et veteri <lb xml:id="p2z3"/>amico in Chris<lb xml:id="p2z4"/>to <lb xml:id="p2z5"/>c<lb xml:id="p2z6"/>haris<lb xml:id="p2z7"/>simo.</s>
				</p>
			</div>
		</body>
	</text>
