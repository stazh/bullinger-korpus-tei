	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Tandem vides, quid in causa fuerit, quod <lb xml:id="p1z2"/>praeterita aestate scripserim rarius, <persName ref="p8418">Myconi</persName>, <lb xml:id="p1z3"/>venerande domine et frater colendissime; mitto <lb xml:id="p1z4"/>sermones nostros, non multos quidem, sed <lb xml:id="p1z5"/>quos multo cum labore scripsi, maxime propter <lb xml:id="p1z6"/>alia negotia, quibus divexor sine intermissione.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Hos veluti succisivis horis scripsi; iudicium tu<lb xml:id="p1z8"/>um expecto.</s>
					<s n="4" xml:lang="la">Tractavi locos scripturae praes<lb xml:id="p1z9"/>tantissimos, leges, peccatum, gratiam vel evan<lb xml:id="p1z10"/>gelium et poenitentiam.</s>
					<s n="5" xml:lang="la">Quamquam vero alii eosdem <lb xml:id="p1z11"/>olim tractaverint docte et pie, puto tamen <lb xml:id="p1z12"/>hanc meam tractationem aliquid perspicuitatis <lb xml:id="p1z13"/>habere et fortassis plus simplicitatis, minus peregrinarum <lb xml:id="p1z14"/>disputationum.</s>
					<s n="6" xml:lang="la">Cęremonialia solus <lb xml:id="p1z15"/>hac aetate tracto.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Summa autem cum volupta<lb xml:id="p1z16"/>te id feci, quia Christum redemptorem nostrum <lb xml:id="p1z17"/>tam clare proponunt et fidem in ipsum docent, <lb xml:id="p1z18"/>ut videar mihi beneficium studiosis <lb xml:id="p1z19"/>dedisse, imo ipsum dominum hoc suis praestitisse <lb xml:id="p1z20"/>per me.</s>
					<s n="8" xml:lang="la">In 4. Decade sequuntur loci <lb xml:id="p1z21"/>deus unus trinus, cultus adoratio, invocatio <lb xml:id="p1z22"/>dei, religio, superstitio; Christus deus et <lb xml:id="p1z23"/>homo, rex, sacerdos, salvator; spiritus sanctus, <lb xml:id="p1z24"/>boni spiritus, mali vel cacodaemones; anima <lb xml:id="p1z25"/>hominis et certa salus hominis.</s>
					<s n="9" xml:lang="la">5. Decas habebit <lb xml:id="p1z26"/>etiam suos locos.</s>
					<s n="10" xml:lang="la">Ora dominum, ut spiritu <lb xml:id="p1z27"/>suo mihi adsit, quo multa cum lectorum <lb xml:id="p1z28"/>utilitate scribam.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Hodie, quod novum <lb xml:id="p1z29"/>apud te videbitur, allectus est in numerum <lb xml:id="p1z30"/>concionatorum urbis, nempe in locum d. <persName ref="p8018">Halleri</persName>, <lb xml:id="p1z31"/>d. <persName ref="p1884">Ludevychus Lavaterus</persName>, iuvenis <lb xml:id="p1z32"/>doctus et valde pius; nam multis precibus <lb xml:id="p1z33"/>impetrarunt <placeName ref="l41">Bernenses</placeName>, ut senatus eis <persName ref="p8018">Hallerum</persName> <lb xml:id="p1z34"/>dederit ministrum.</s>
					<s n="12" xml:lang="la">Ex <placeName ref="l830">Anglia</placeName> <lb xml:id="p1z35"/>scribit <persName ref="p8111">Petrus Martyr</persName> omnia recte habere, <lb xml:id="p1z36"/>se valde decertasse contra sophistas et gratia <lb xml:id="p1z37"/>dei vicisse sententiam de coena, quam hactenus tutati sumus, <pb/><lb xml:id="p2z1"/>esse tamen, qui publicis scriptis conentur tueri <lb xml:id="p2z2"/>corporalem praesentiam etc.</s>
					<s n="13" xml:lang="la">His respondebitur.</s>
					<s n="14" xml:lang="la">Prot<lb xml:id="p2z3"/>ector, regis avunculus, carcere et omni molestia <lb xml:id="p2z4"/>est liberatus, 5. vel 6. februarii restitutus est suo <lb xml:id="p2z5"/>ducatui.</s>
					<s n="15" xml:lang="la">Missi abierunt in <placeName ref="l832">Galliam</placeName> legati de <lb xml:id="p2z6"/>pace acturi.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Venerunt in <placeName ref="l830">Angliam</placeName> legati <placeName ref="l832">Galli</placeName>.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z7"/>Dominus spiritum concordiae inspiret regibus illis.</s>
					<s n="18" xml:lang="la">Ego <lb xml:id="p2z8"/>aliquid a te audire cupio de Caesare, putrido <lb xml:id="p2z9"/>cadavere.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="farewell">Vale aeternum.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 9. martii <lb xml:id="p2z10"/>anno 1550.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z11"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p2z12"/><persName ref="p18531">Iulius III.</persName> appellatus <lb xml:id="p2z13"/>novus <lb xml:id="p2z14"/>antichristus; <lb xml:id="p2z15"/>id habeo ex <placeName ref="l55">Bononia</placeName> et <placeName ref="l522">Venetiis</placeName>.</s>
					<s n="23" xml:lang="la"><lb xml:id="p2z16"/>Is fuit <persName ref="p18531">Ioannes Maria de Monte</persName> episcopus <placeName ref="l3324">Praenestinus</placeName>, <placeName ref="l3323">Aretinus</placeName> <lb xml:id="p2z17"/>patria.</s>
					<s n="24" xml:lang="la">Acerrimus est <lb xml:id="p2z18"/>oppugnator libertatis <lb xml:id="p2z19"/>ecclesiasticae <foreign xml:lang="de">(pfäffischer buͤbery und der <lb xml:id="p2z20"/>geistlichen muͦtwill).</foreign></s>
					<s n="25" xml:lang="la">Praesedit concilio <placeName ref="l1107">Tridentino</placeName>, appel<lb xml:id="p2z21"/>lavit <placeName ref="l55">Bononiam</placeName>.</s>
					<s n="26" xml:lang="de">Ist me franzos(?) dan imperij.</s>
					<s n="27" xml:lang="la"><foreign xml:lang="de">Der tüfel reych den vasel allen</foreign> <persName ref="p4851">Frosch<lb xml:id="p2z22"/>overus</persName> veniet post 8 dies <placeName ref="l28">Basileam</placeName>; cum eo agat parochus in <placeName ref="l2581">Louffen</placeName>.</s>
				</p>
				<p>
					<s n="28" xml:lang="la" ana="salute">Sal<lb xml:id="p2z23"/>vus sit d. <persName ref="p1278">Gastius</persName>, cui mittes ex<lb xml:id="p2z24"/>emplum per hunc studiosum.</s>
				</p>
				<p>
					<s n="29" xml:lang="la">Praestantissimo viro d. <persName ref="p8418">Osvaldo Myconio</persName>, domi<lb xml:id="p2z25"/>no et fratri venerabili et charissimo.</s>
				</p>
				<p>
					<s n="30" xml:lang="de"><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
