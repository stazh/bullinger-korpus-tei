	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Iam iam abeuntibus tabellariis et sarcinulis <lb xml:id="p1z2"/>humeris impositis scribunt unanimi consensu <lb xml:id="p1z3"/>omnium evangelicorum non theologorum tantum, verum <lb xml:id="p1z4"/>etiam consiliariorum principum <placeName ref="l18">Augustanę</placeName> confession<lb xml:id="p1z5"/>is <persName ref="p6469">Schnepfium</persName>, Sarcerium, Victorinum, electoris <lb xml:id="p1z6"/>marchionis theologum et quintum nescio, esse <lb xml:id="p1z7"/>ab ceteris nostrę partis theologis a colloquio <lb xml:id="p1z8"/>exclusos, domum relegatos et hereseos <lb xml:id="p1z9"/>condemnatos, quod graciam Christi sacramentis <lb xml:id="p1z10"/>alligarint et signis fere plus quam signato <lb xml:id="p1z11"/>in remittendis peccatis tribuerint.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Non <lb xml:id="p1z12"/>licet plura.</s>
				</p>
				<p>
					<s n="4" xml:lang="de"><lb xml:id="p1z13"/><foreign xml:lang="la">Iamiam scribenti hec in pharmacopolio <lb xml:id="p1z14"/>nuntiatur certo,</foreign> der Ro. ko(nig) hab drey l<lb xml:id="p1z15"/>egaten pey dem <placeName>Turckhen</placeName>; die zwen hat er <lb xml:id="p1z16"/>lassen ziehen pis gen Ofen, den dritten pehalt <lb xml:id="p1z17"/>er und erpeut sich auffs kunigs <lb xml:id="p1z18"/>ansuechen, 7 jar frid zue halten, das ime <lb xml:id="p1z19"/>der kunig gebe jarlich 40000 ducaten <lb xml:id="p1z20"/>tribut und alle wider in gepauten vesten <lb xml:id="p1z21"/>abwerffe.</s>
					<s n="5" xml:lang="de">Das kan der kunig nit thun; <lb xml:id="p1z22"/>derhalb verhofflich, es sulle nichtz daraus <lb xml:id="p1z23"/>werden.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><foreign xml:lang="de">Dann giengs fur sich,</foreign> rex... <lb xml:id="p1z24"/>institueret ad extirpandam religionem <lb xml:id="p1z25"/>et dissipandam Germaniam alioqui laceram.<lb xml:id="p1z26"/>..</s>
					<s n="7" xml:lang="la">Hęc festinanter scribere volui<lb xml:id="p1z27"/>.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z28"/><placeName ref="l18">Augustę</placeName> 10. oct<lb xml:id="p1z29"/>obris an<lb xml:id="p1z30"/>no etc. 57.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><persName ref="p2856">G[er<lb xml:id="p1z31"/>eon] <lb xml:id="p1z32"/>S[ailer]</persName> <pb/><lb xml:id="p2z1"/>t[uus].</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><persName ref="p495">Hein<lb xml:id="p2z2"/>richo Bullingero</persName>, d. et amico <lb xml:id="p2z3"/>syncerissimo.</s>
				</p>
			</div>
		</body>
	</text>
