	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Spero te, optime et colendissime <persName ref="p540">Calvine</persName>, omnes <lb xml:id="p1z2"/>meas accepisse literas.</s>
					<s n="3" xml:lang="la">Nunc commendo tuae charitati <lb xml:id="p1z3"/>hunc optimum fratrem <placeName ref="l104">Cremonensem</placeName>, cuius humeris iniec<lb xml:id="p1z4"/>i quintam meam decadem quam ad te mitto, no<lb xml:id="p1z5"/>n <lb xml:id="p1z6"/>ut te doceam meis libris, qui ex tuis me <lb xml:id="p1z7"/>plurima discere fateor, sed ut animi mei erga <lb xml:id="p1z8"/>te benevolentiam attester.</s>
					<s n="4" xml:lang="la">Utinam vero in <lb xml:id="p1z9"/>aliis longe maioribus mea tibi officia praestare <lb xml:id="p1z10"/>possem.</s>
					<s n="5" xml:lang="la">Nihil displicebit, sat scio, in tractatione <lb xml:id="p1z11"/>sacramentorum et in aliis locis.</s>
					<s n="6" xml:lang="la">Nam <lb xml:id="p1z12"/>quae olim admonebas quibusdam viris bonis <lb xml:id="p1z13"/>displicatura omisi, et ut omnia nostrae Consensioni <lb xml:id="p1z14"/>congruant summa diligentia curavi etc.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/>Excuditur iam apud nos Consensio, cuius prim<lb xml:id="p1z18"/>um folium nondum absolutum hic tibi mitto.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z19"/>Imprimetur et <placeName ref="l822">Germanica</placeName> lingua redditum.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>Adieci his quae accepi a d. <persName ref="p3375">Vergerio</persName>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Exemplum remittes, siquidem commode poteris.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z22"/>Rescribe, obsecro, mature.</s>
					<s n="12" xml:lang="la">Aegre enim tuis <lb xml:id="p1z23"/>careo tam diu.</s>
					<s n="13" xml:lang="la">Sub finem sermonis <lb xml:id="p1z24"/>de coena tuis ex Institutionibus verbis <lb xml:id="p1z25"/>utor, ut omnes videant nobis convenire etc.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z26"/>Foeda a nostris facta est cessio in comitiis <lb xml:id="p1z27"/><placeName ref="l18">Augustanis</placeName>.</s>
					<s n="15" xml:lang="la">Receperunt concilium illud <lb xml:id="p1z28"/>impiissimum <placeName ref="l1107">Tridentinum</placeName>.</s>
					<s n="16" xml:lang="la">Soli <placeName ref="l2923">Mauritiani</placeName> <lb xml:id="p1z29"/>nescio quid intercessere.</s>
					<s n="17" xml:lang="la">Iam igitur <lb xml:id="p1z30"/>agitur de subiiciendis <placeName ref="l862">Helvetiis</placeName> et <placeName ref="l830">Anglis</placeName>.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z31"/>Si unquam pro pietate asserenda aliquid <lb xml:id="p1z32"/>fecimus operante per nos domino, iam demum <lb xml:id="p1z33"/>orandus est ne nobis desit, et ut fortiter <lb xml:id="p1z34"/>pugnemus pro gloria Christi redemptoris et <lb xml:id="p1z35"/>pro ecclesiis nostrae fidei commissis.</s>
					<s n="19" xml:lang="la" ana="farewell">Vale.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z36"/>Festinantissime scripsi.</s>
					<s n="21" xml:lang="la">2<lb xml:id="p1z37"/>7. decembris 1551.</s>
					<s n="22" xml:lang="la" ana="salute"><lb xml:id="p1z38"/>Commenda me d. a <placeName ref="l631">Burgundia</placeName>.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="24" xml:lang="la" ana="salute"><lb xml:id="p1z40"/>Salvus sit <lb xml:id="p1z41"/><persName ref="p966">Gallasius</persName>, <lb xml:id="p1z42"/><persName ref="p1049">Farellus</persName> inprimis et omnes boni.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p540">Ioanni <lb xml:id="p2z2"/>Calvino</persName>, <placeName ref="l167">Genevensis</placeName> <lb xml:id="p2z3"/>ecclesiae fido pastori, <lb xml:id="p2z4"/>domino et fratri a<lb xml:id="p2z5"/>eternum colendo.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l167">Genevae</placeName>.</s>
				</p>
			</div>
