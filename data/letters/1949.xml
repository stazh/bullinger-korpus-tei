	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Eadem hora, qua nuper tuas acceperam, respondi; sed cum literas, <lb xml:id="p1z2"/>quas his mitto inclusas, tabellario exhibere in diversorio vellem, <lb xml:id="p1z3"/>iam ille discesserat.</s>
					<s n="3" xml:lang="la">Interim ex <placeName ref="l1030">Herpipoli</placeName> accepimus <persName ref="p18250">Mauricium</persName> <lb xml:id="p1z4"/>tercia a conflictu die ex ictus bombardici vulnere mortuum, eo <lb xml:id="p1z5"/>quod etiam vesica lesa fuerit, et christianissimo fine vitam <lb xml:id="p1z6"/>clausisse sancte testatum se huic bello nullius privati commodi, <lb xml:id="p1z7"/>sed publici boni ergo implicitum.</s>
					<s n="4" xml:lang="la"><persName ref="p8034">He[i]deckerum</persName> item etiamnum <lb xml:id="p1z8"/>superstitem esse et marchionici exercitus vexilla innumera <lb xml:id="p1z9"/>esse capta, <persName ref="p8371">Albertum</persName> semel iterumque ceu e manibus elapsum, <lb xml:id="p1z10"/>qui iam <persName ref="p20318">Heinricho Brunsvicensi</persName> commutationem captivorum denunciet <lb xml:id="p1z11"/>et copias restauret, quantum possit, ut videatur novis moliminibus rem <lb xml:id="p1z12"/>tentaturus esse.</s>
					<s n="5" xml:lang="la">Ceterum consilia eius animadversa ex deprehensis <lb xml:id="p1z13"/>capsis, quibus secreta ipsius contenta fuerint, et proinde <lb xml:id="p1z14"/>per dispositos equos ea imperatori et <persName ref="p18477">Ferdinando</persName> significari.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Quod si verum est, metuo, ne graviorum malorum praeterita haec <lb xml:id="p1z16"/>clades prooemium tantummodo fuerit, et medicos, qui sanando <lb xml:id="p1z17"/>paroxysmo advocantur, valde habeo suspectos.</s>
					<s n="7" xml:lang="la">Haec te, <lb xml:id="p1z18"/>mi frater, nolui celare.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Ceterum, qui has adfert, Italus est <lb xml:id="p1z19"/>vir, ut testantur, qui ipsum norunt, sanctus et familia <lb xml:id="p1z20"/>non mediocriter pressus, cuius filium certe recepissemus, nisi <lb xml:id="p1z21"/>non solum loca omnia stipendiariorum essent plena, sed et extraordi<lb xml:id="p1z22"/>nariis obrueremur.</s>
					<s n="9" xml:lang="la">Quocirca viatico eum instruximus parantem <lb xml:id="p1z23"/>reditum in <placeName ref="l834">Italiam</placeName>.</s>
					<s n="10" xml:lang="la">Quodsi vos inopem iuveretis, scitis, <lb xml:id="p1z24"/>a quo mercedem sitis relaturi.</s>
					<s n="11" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="12" xml:lang="la"><placeName ref="l28">Basileae</placeName> <lb xml:id="p1z25"/>3a augusti anno 1553.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z26"/>T[uus] <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z27"/>Saluta tuos omnes.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, domino et fratri <lb xml:id="p2z3"/>suo observandissimo.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>