	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi heri ad te binas; alteras per oeconomum <lb xml:id="p1z2"/><placeName ref="l269">Küngßfeldensem</placeName> ad fratrem meum <placeName>Thermis</placeName> lavantem <lb xml:id="p1z3"/>misi, alteras nunc una cum his mitto.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Frustratus sum enim per adventum <persName>Tumisii</persName> <lb xml:id="p1z5"/>eo nuncio, qui alias, nisi hic venisset, hodie <placeName ref="l587">Tigurum</placeName> <lb xml:id="p1z6"/>profecturus erat.</s>
					<s n="4" xml:lang="la">Invenies, quid apud <placeName>Valesios</placeName> agatur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Hodie d. d. <persName ref="p8032">Dryandri</persName> filius tuas mihi attulit <lb xml:id="p1z8"/>et d. <persName ref="p8011">Gvaltheri</persName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ago utrique vestrum pro vestra fide <lb xml:id="p1z9"/>et diligentia summas gratias.</s>
					<s n="7" xml:lang="la">Cum magna voluptate <lb xml:id="p1z10"/>legi literas Anglicas atque easdem per hunc <persName>Tum<lb xml:id="p1z11"/>isium</persName> vestratem remitto; communicavi eas quoque d. <persName ref="p8417">Mu<lb xml:id="p1z12"/>sculo</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Inter alia scribis de <placeName>Ienensium</placeName> scripto, quod <lb xml:id="p1z13"/>mihi servare debeam, dum principis <placeName>Haßiae</placeName> quoque <lb xml:id="p1z14"/>scriptum videam; sed neque Ienense illud vidi, non <lb xml:id="p1z15"/>enim fuit additum fasciculo literarum.</s>
					<s n="9" xml:lang="la">Nescio tamen, <lb xml:id="p1z16"/>si forte <persName ref="p8032">Dryander</persName> illud habeat, qui nunc mihi scribenti <lb xml:id="p1z17"/>praesto non est.</s>
					<s n="10" xml:lang="la"><placeName>Bohemus</placeName> ille <placeName>Waldensis</placeName> <lb xml:id="p1z18"/>hic fuit; hoc cognosces ex confessione theologorum <lb xml:id="p1z19"/><placeName>Wirtembergensium</placeName>, quas cum hesternis literis ad te re<lb xml:id="p1z20"/>misi.</s>
					<s n="11" xml:lang="la">Grata fuit <persName ref="p8417">Musculo</persName> tua praemonitio.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z21"/>Quid, quaeso, <persName ref="p3375">Vergerius</persName> molitur?</s>
					<s n="13" xml:lang="la">Non satis intelligimus, <lb xml:id="p1z22"/>quid volvat; hoc videmus ipsi cum <persName>Lutheranis</persName> <lb xml:id="p1z23"/>optime convenire, de reliquis non ita bene possumus iudicare, nis<lb xml:id="p1z24"/>i quod iam pridem suspecta nobis fuit <lb xml:id="p1z25"/>illius <foreign xml:lang="el">πολυπραγμοσύνη</foreign>.</s>
					<s n="14" xml:lang="la">De rebus aliis in <lb xml:id="p1z26"/>aliis literis ago; itaque hic sum brevior.</s>
					<s n="15" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z27"/>vale.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute">Salutant te vicissim omnes, quos salvere iubebas, <lb xml:id="p1z28"/>praesertim <persName ref="p8063">Steigerus</persName>, cui tuas exhibui.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z29"/><persName ref="p8351">Frischingam</persName> ipsam responsuram puto.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="farewell">Vale...</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z30"/><placeName ref="l41">Bernae</placeName> 22. iulii 1560.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><persName ref="p8018">H[a<lb xml:id="p1z31"/>llerus]</persName> tuus.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino suo honorando et <lb xml:id="p2z5"/>compatri charissimo.</s>
					<s n="22" xml:lang="de"><lb xml:id="p2z6"/>M. <persName ref="p495">Heinrych Bullinger</persName>n <lb xml:id="p2z7"/>zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
