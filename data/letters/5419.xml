	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salutem.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Heri <placeName ref="l2529">Brabanto</placeName> cuidam studioso <placeName ref="l1284">Bruxellensi</placeName> nomine <persName ref="p20639">Philippus Pensart</persName>, <lb xml:id="p1z2"/>qui <placeName ref="l41">Berna</placeName> nobiscum <placeName ref="l21">Badenas</placeName> usque profectus est, meas literas celeriter <lb xml:id="p1z3"/>exaratas tibi reddendas tradidi, in quibus binae domini <persName ref="p8018">Halleri</persName>, ecclesię ministri <lb xml:id="p1z4"/><placeName ref="l41">Bernatium</placeName>, alterę ad tuam excellentiam, alterę vero ad fratrem dominum <persName ref="p1453">Wolpgangum</persName> inclu<lb xml:id="p1z5"/>sae fuerunt; spero recte esse traditas.</s>
					<s n="3" xml:lang="la">Quamobrem te rogo, velis huic <placeName ref="l18">Augustano</placeName> d. <lb xml:id="p1z6"/><persName ref="p3099">Sultzero</persName> saltem tribus verbis nota<lb xml:id="p1z7"/>re, ut scire possem omnia per istum studiosum recte curata esse; is mihi semper rectis<lb xml:id="p1z8"/>sime mittere poterit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ipse ad vos propter multas certas causas ad vos venire non potui, <lb xml:id="p1z9"/>quamvis mihi certo proposueram et domino <persName ref="p8018">Hallero</persName> promiseram.</s>
					<s n="5" xml:lang="la">Facile tecum <lb xml:id="p1z10"/>reputare poteris, quanta provincia mihi imposita sit, qui per totum iter <lb xml:id="p1z11"/>pro sex discipulis, omnibus <placeName ref="l18">Augustanis</placeName> omnesque honestissima familia orti, respondere <lb xml:id="p1z12"/>oporteat.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Oravi istum studiosum, ut me apud te excusatum habere velit, donec <lb xml:id="p1z13"/>ego per ocium me ipsum purgare possem.</s>
					<s n="7" xml:lang="la">Audies quoque a <persName ref="p3099">Sultzero</persName>, quam invitus <lb xml:id="p1z14"/>te praeterierim.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">His vale cum omnibus tuis quam felicissime.</s>
					<s n="9" xml:lang="la">Datae manu cursoria <lb xml:id="p1z15"/>10. augusti <placeName ref="l441">Schafhusię</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/>Tuae excellentiae <lb xml:id="p1z17"/>observantissimus <lb xml:id="p1z18"/><persName ref="p8486">Engelbertus Milander</persName>.</s>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo atque doctissimo <lb xml:id="p2z2"/>viro domino <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bullingero</persName> seniori, domino <lb xml:id="p2z4"/>suo perpetua fide col<lb xml:id="p2z5"/>endissimo.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note>[Datum: Vgl. Johannes Haller an HB, 6. August 1562.]</note>
				</p>
			</div>
		</body>
	</text>
