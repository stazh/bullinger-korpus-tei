	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Scripsi ad te, venerande frater, superioribus diebus misique fasciculum <lb xml:id="p1z3"/>literarum, qui <placeName ref="l491">Argentina</placeName> ad me missus fuerat.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Nunc tibi literas generi mei tibi mitto una cum <lb xml:id="p1z5"/>literis ad <persName ref="p2019">Mainardum</persName> nostrum, <placeName ref="l93">Clavenensis</placeName> ecclesiae <lb xml:id="p1z6"/>ministrum, quas oro te ad eum primo quoque tempore <lb xml:id="p1z7"/>mittas.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Hoc erit genero, mihi et ipso <persName ref="p18700">Augustino</persName> <lb xml:id="p1z8"/>gratissimum.</s>
					<s n="5" xml:lang="la" ana="farewell">Vale.</s>
					<s n="6" xml:lang="la">De rebus <placeName ref="l830">Anglie</placeName> puto te <lb xml:id="p1z9"/>accepisse <persName ref="p18575">regem Philippum</persName> adventare magnis cum <lb xml:id="p1z10"/>copiis.</s>
					<s n="7" xml:lang="la"><placeName ref="l830">Angli</placeName>, qui foris sunt, edictum est, ne in <lb xml:id="p1z11"/>Luteranis civitatibus neve in <placeName ref="l832">Gallia</placeName> consistant, <lb xml:id="p1z12"/>sed in <placeName ref="l834">Italia</placeName>.</s>
					<s n="8" xml:lang="la">Sex millia <placeName ref="l830">Anglorum</placeName> duce quodam <lb xml:id="p1z13"/>magnate in <placeName ref="l832">Galliam</placeName> ad regem se contulerunt parati <lb xml:id="p1z14"/>iussa facere.</s>
					<s n="9" xml:lang="la"><placeName ref="l553">Vintoniensis</placeName> ille <placeName ref="l830">Anglie</placeName> tyrannus <lb xml:id="p1z15"/>a consilio proditionis accusatus est; accusationem <lb xml:id="p1z16"/>regina non admisit aut, si admisit, dixit se <lb xml:id="p1z17"/>ei ignoscere propter eius multa in se merita.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p18538">Caesar</persName> ad <placeName ref="l20">Belgas</placeName> magnas habere copias dicitur <lb xml:id="p1z19"/><placeName ref="l832">Gallusque</placeName> contra.</s>
					<s n="11" xml:lang="la">Ita vides omnia plena malorum.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z20"/>Oremus dominum, in tot malis defendat et <lb xml:id="p1z21"/>conservet ecclesiam suam.</s>
					<s n="13" xml:lang="la" ana="farewell">Iterum vale cum <lb xml:id="p1z22"/>sancta familia tota.</s>
					<s n="14" xml:lang="la" ana="salute">Saluta fratres.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l28">Basileae</placeName> 12. iuni<lb xml:id="p1z23"/>i 1554.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Tuus ex animo <persName ref="p714">C[o<lb xml:id="p1z24"/>elius] S[ecundus</persName>] subscripsit.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>antistiti, domino et <lb xml:id="p2z5"/>fratri colendissimo.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
