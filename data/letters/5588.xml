	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Pax et salus per Christum Iesum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Scis etiam me tacente, pater in Christo colendissime, <lb xml:id="p1z3"/>quot impedimenta scribere volentibus obstent, <lb xml:id="p1z4"/>praesertim iis, qui non Sisiphum saxum, sed <lb xml:id="p1z5"/>typographicum volvunt.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Proinde sat scio communem <lb xml:id="p1z6"/>excusationem, quod rarius scribam, valere apud <lb xml:id="p1z7"/>te.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Cogito tamen de te saepius nec vero segnius, <lb xml:id="p1z8"/>quam qui crebrius scribunt, ac deum patrem <lb xml:id="p1z9"/>domini nostri Iesu Christi oro, ut te in hoc <lb xml:id="p1z10"/>turbulentissimo rerum statu diutissime incolumem <lb xml:id="p1z11"/>servet suae ecclesiae non <lb xml:id="p1z12"/>tantum in conservando evangelii ovili quam ab <lb xml:id="p1z13"/>eo abigendis lupis et iis, qui falso nomine <lb xml:id="p1z14"/>fratrum titulo se iactant.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Hactenus dedimus <lb xml:id="p1z15"/>operam evulgandis libris <placeName ref="l832">Gallicis</placeName>; sed bellum istud <lb xml:id="p1z16"/>intestinum apud <placeName ref="l832">Gallos</placeName> veluti procella omnes <lb xml:id="p1z17"/>absumpsit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Restant nostri <placeName ref="l640">Flandri</placeName> et patria <lb xml:id="p1z18"/>illa inferior, quibus libros illos, quos tu adversus <lb xml:id="p1z19"/>anabaptistas primum Germanice, deinde a <lb xml:id="p1z20"/>d. <persName ref="p8442">Simlero</persName> in Latinum convers, <placeName ref="l832">Gallice</placeName> loquentes <lb xml:id="p1z21"/>paro, dum illis dominus deus fidos <lb xml:id="p1z22"/>sui verbi pręcones, qui viva etiam voce lupos <lb xml:id="p1z23"/>arceant, dederit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Dominus <persName ref="p8511">Trecelius</persName> <lb xml:id="p1z24"/><placeName ref="l2472">Polonus</placeName>, qui has etiam expectat, coram <lb xml:id="p1z25"/>omnia commodius, et quae hic et <lb xml:id="p1z26"/>dicuntur, exponet.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Bene interea <pb/><lb xml:id="p2z4"/>vale, vir clarissime et pater in Christo <lb xml:id="p2z5"/>plurimorum, qui te ex animo complectuntur.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p2z6"/>Raptim <placeName ref="l167">Genevae</placeName> 16. ianuarii 1563.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z7"/>Tuus ex animo <persName ref="p684">Io<lb xml:id="p2z8"/>annes Crispinus</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z9"/>[Cla]rissimo <lb xml:id="p2z10"/>verbi dei [<lb xml:id="p2z11"/>m]inistro d. <persName ref="p495">Heinrico <lb xml:id="p2z12"/>Bullin<lb xml:id="p2z13"/>ger<lb xml:id="p2z15"/>o</persName>, <placeName ref="l587">Tiguri<lb xml:id="p2z16"/>norum</placeName> <lb xml:id="p2z17"/>pastori eximio.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z18"/><placeName ref="l587">Tiguri</placeName><lb xml:id="p2z19"/>.</s>
				</p>
			</div>
		</body>
