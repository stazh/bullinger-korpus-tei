	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Ne nihil etiam nunc scriberem, chare frater, <lb xml:id="p1z2"/>saltem salutare volui et paucula haec referre: <lb xml:id="p1z3"/>Transiit hac regius legatus, vir, ut apparet, non <lb xml:id="p1z4"/>malus, certe eloquens et non imprudens.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Con<lb xml:id="p1z5"/>tulimus de rebus variis.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Advenit et alius regis legatus <lb xml:id="p1z6"/><placeName>Saluduro</placeName>; verum privatim uterque mecum est colloqutus, <lb xml:id="p1z7"/>neque <persName>Salodurensis</persName> ita ut vester ille probatur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Ex comitiis nihil dum habemus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><placeName>Tres Pagi</placeName> causam <lb xml:id="p1z9"/><placeName ref="l646">Claronensem</placeName> noluerunt ab initio comitiorum tractari, <lb xml:id="p1z10"/>sicut prioribus fuerat decretum; praetexunt se nondum <lb xml:id="p1z11"/>plene consultasse de danda responsione.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Seques<lb xml:id="p1z12"/>tres indigne hoc tulerunt et iusserunt intra <lb xml:id="p1z13"/>paucos dies respondere; expectamus ergo, quid futurum <lb xml:id="p1z14"/>sit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Ex <placeName ref="l832">Gallia</placeName> nihil habemus, nisi quod fama spargit <lb xml:id="p1z15"/>regem 12. iunii <placeName ref="l301">Lugdunum</placeName> esse pompa regia ingres<lb xml:id="p1z16"/>sum et exceptum ibidem magnifice.</s>
					<s n="9" xml:lang="la">De militibus <lb xml:id="p1z17"/><persName>Hanniballicis</persName> malo a te audire, quonam <lb xml:id="p1z18"/>ducantur.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><persName>Commissarii Caesaris</persName> scripserunt praefectis <placeName ref="l862">Hel<lb xml:id="p1z19"/>vetiorum</placeName> vicinis, ne quid suspicentur sinistri, salva <lb xml:id="p1z20"/>esse omnia, atque utinam salva sint omnia.</s>
				</p>
				<p>
					<s n="11" xml:lang="de">Ich <lb xml:id="p1z21"/>bin immer dar, wie ich bin, übelmögend und muͦß <lb xml:id="p1z22"/>doch ziehen, biß ich darunder erligen.</s>
					<s n="12" xml:lang="la">Uxor <lb xml:id="p1z23"/><persName ref="p8016">Eglii</persName>, boni alioqui viri, poenas dabit insolentiae et <lb xml:id="p1z24"/>morositatis.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Sustinebit bonus <persName ref="p8016">Eglius</persName> onus grave; <lb xml:id="p1z25"/>nam pater eius una cum matre miro desiderio <lb xml:id="p1z26"/>expectant eius adventum.</s>
					<s n="14" xml:lang="la">Sunt reliqui eius consangu<lb xml:id="p1z27"/>inei inopes; exhaurient illum nec interim <lb xml:id="p1z28"/>ulla[m] ei gratiam referent.</s>
					<s n="15" xml:lang="la">Commodius et tranquillius <lb xml:id="p1z29"/>multo vixisset apud vos; sed dum vitamus Scyllam, <lb xml:id="p1z30"/>incidimus in Charibdim<note xml:id="fn1" type="footnote" n="1"><bibl source="b56">Adagia</bibl>, 1, 5, 4 (<bibl source="b370">LB</bibl> II 183).</note>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Dominus benedicat tibi <lb xml:id="p1z32"/>et familiae tuae.</s>
					<s n="17" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">De [sym<lb xml:id="p1z33"/>mysta tuo]<note type="misc">durchgestrichen</note> mira retulit regius legatus; vide tu etiam atque etiam, <lb xml:id="p1z34"/>ut eum tractes, quo minus noceat, et ne <lb xml:id="p1z35"/>malum latens, quantum fieri potest erumpat et apertum <lb xml:id="p1z36"/>inter vos dissidium causae noceat.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 16. iunii 1564.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="salute"><lb xml:id="p1z37"/>Saluta d. consules<lb xml:id="p1z38"/>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>ministro fideli, domino <lb xml:id="p2z4"/>meo colendo et fratri charissimo.</s>
					<s n="23" xml:lang="la"><lb xml:id="p2z5"/>Chur.</s>
				</p>
			</div>
