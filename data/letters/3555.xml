	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Si, postquam postremas ad te literas scripsi, aliquid <lb xml:id="p1z2"/>novi accidisset, quod te dignum fuisset, sane consuetudinem <lb xml:id="p1z3"/>scribendi tanto iam tempore non intermississem.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Nam de Germanicis rebus et actis comitiorum <lb xml:id="p1z5"/><placeName ref="l157">Francfordiensium</placeName> puto te certiora omnia quam me <lb xml:id="p1z6"/>habere, eaque ego abs te potius expectare debeo.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Monarchae summa vi utrinque bellum parant; sed <lb xml:id="p1z8"/>nihil adhuc geritur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Pacis aliqua fuit mentio <lb xml:id="p1z9"/>misso a <persName ref="p20596">Caraffa</persName> (qui apud <persName>Hyspanum</persName> erat) ad <lb xml:id="p1z10"/>regem nuntio, qui eius de pace voluntatem s<lb xml:id="p1z11"/>ciscitaretur.</s>
					<s n="6" xml:lang="la">Rex tum capturum consilium <lb xml:id="p1z12"/>et responsurum, cum <persName>Hyspanus</persName> sese indicaverit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Hoc certe constat principes istos conciliatorem <lb xml:id="p1z14"/>et interpretem pacis <persName ref="p20596">Caraffam</persName> non probare <lb xml:id="p1z15"/>multoque minus rem per illum confici potuisse, quam <lb xml:id="p1z16"/>fortasse posthac deo volente poterit illo absente.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Spero me <persName ref="p629">Mathaeum Coignetium</persName> successorem habiturum, <lb xml:id="p1z18"/>hominem mihi et tibi amicissimum.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Salodori 7<lb xml:id="p1z19"/>a aprilis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/>Tuus <persName ref="p8183">San Laurenti<lb xml:id="p1z21"/>us</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo theologo d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName> et<lb xml:id="p2z3"/>c.</s>
				</p>
			</div>
		</body>
	</text>
