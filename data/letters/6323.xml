	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Monsr te priustahardiesse de posescrire vous supliant
					<lb xml:id="p1z2"/>escuze mon langage cest pout vos prtes, que vous faciem ten
					<lb xml:id="p1z3"/>ratestus pistoles vos diciples auteine et iesquem de conquerit,
					<lb xml:id="p1z4"/>tudepleu dint ilont (esse vir compagnuem alsiait et a
					<lb xml:id="p1z5"/>qesqueledenger soit hominis si vos plestles recendium vous (ront
					<lb xml:id="p1z6"/>curvosleitate bstrementde plurous empes
					<lb xml:id="p1z7"/>fere fuipas me suble,  sa vos bones prieres et pri pręscipuem
					<lb xml:id="p1z8"/>nousiones loguement vivis esagrace degeneve xp
					<lb xml:id="p1z9"/>derembre
					<lb xml:id="p1z10"/>Vrem hres lub fille
					<lb xml:id="p1z11"/>iderter.
					<pb/>
					<lb xml:id="p2z1"/>Monsitur.
					<lb xml:id="p2z2"/>Myter Bullinger,
					<lb xml:id="p2z3"/>agerro.
				</p>
			</div>
		</body>
	</text>
