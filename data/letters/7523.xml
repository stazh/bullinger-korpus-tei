	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Tandem aliquando theses de excommunicatione <lb xml:id="p1z3"/>ab ipso auctore recognitas mitto, reverende et claris<lb xml:id="p1z4"/>sime d. <persName ref="p495">Bullingere</persName>, ut eas cum earundem defensione <lb xml:id="p1z5"/>coniungere liceat.</s>
					<s n="3" xml:lang="la">Narravit mihi nuper noster <lb xml:id="p1z6"/><persName ref="p3099">doctor Sulcerus</persName> <persName ref="p8033">Bezam</persName> in suis ad se literis <lb xml:id="p1z7"/>minitari scripto in publicum edito impugnaturum <lb xml:id="p1z8"/>se theses.</s>
					<s n="4" xml:lang="la">Quod si fecerit, iacta erit alea.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Miror <lb xml:id="p1z9"/>hominem tantum sibi sumere et recta stringere <lb xml:id="p1z10"/>calamum in eos, qui sine contumelia in unico doctrinae <lb xml:id="p1z11"/>coelestis capite ab ipso dissentiunt et sua toties <lb xml:id="p1z12"/>probanda aliis proponunt.</s>
					<s n="6" xml:lang="la">Historiam <foreign xml:lang="el">περὶ ἀφορμῆς</foreign> <lb xml:id="p1z13"/>istius dissidii in praefatione descriptam reperiet <lb xml:id="p1z14"/>tua praestantia.</s>
					<s n="7" xml:lang="la">Ego tametsi video nimium <lb xml:id="p1z15"/>altercando veritatem non raro vel obscuratam <lb xml:id="p1z16"/>vel amissam, spero tamen futurum, ut haec <lb xml:id="p1z17"/>ingeniorum et consiliorum varietas et contentio <lb xml:id="p1z18"/>cedat in dei gloriam et veritatis assertionem, <lb xml:id="p1z19"/>et ut id fiat, vota facio.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Salutem a Christo <lb xml:id="p1z20"/>servatore tuae praestantiae et omnibus collegis <lb xml:id="p1z21"/>tuis precor.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Perscriptum <placeName ref="l434">Roetelae</placeName> <lb xml:id="p1z22"/>8. iulii.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Tuus in domino <persName ref="p8067">Iohannes <lb xml:id="p1z24"/>Iacobus Gryna<lb xml:id="p1z26"/>e<lb xml:id="p1z27"/>us</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Sapientia, virtute et eruditione praestantissim<lb xml:id="p2z2"/>o viro d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tygurinae</placeName> ecclesiae ministro, domino suo <lb xml:id="p2z4"/>et amico observando<lb xml:id="p2z5"/>.</s>
				</p>
			</div>
		</body>
	</text>
