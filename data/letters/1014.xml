	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l491">Argentinae</placeName> primo septembris 1550.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">S. <lb xml:id="p1z2"/>P.</s>
					<s n="3" xml:lang="la">Vehementer gavisus sum, <persName ref="p495">Bullingere</persName> amice et domine <lb xml:id="p1z3"/>colende, quod literas ab <persName ref="p1560">Hopero</persName> accepisse te scripseras, per quas <lb xml:id="p1z4"/>et de libris et de benevolentia regia certior eras.</s>
					<s n="4" xml:lang="la">Grati<lb xml:id="p1z5"/>tudinis tuae munus a <persName ref="p4851">Froschouero</persName> magna cum gratia accipiam <lb xml:id="p1z6"/>referamque, si dabitur occasio.</s>
					<s n="5" xml:lang="la">Per postam quum literas mitto, <lb xml:id="p1z7"/>pro unciis singulis, quae ex duabus <placeName ref="l822">Germanicis</placeName> lott constant, <lb xml:id="p1z8"/>decem cruciaros pendendi praeter vecturam hinc <placeName ref="l471">Spiram</placeName>, <lb xml:id="p1z9"/>quae sol t ut minimum pro singulis fasciculis batzium cum dimidio, si <lb xml:id="p1z10"/>maiores fuerint.</s>
					<s n="6" xml:lang="la">De turba orta in <placeName ref="l832">Gallia</placeName> <placeName ref="l808">Belgica</placeName> nihill <lb xml:id="p1z11"/>audimus plane.</s>
					<s n="7" xml:lang="la">Dominus det gratiam, ut quocunque modo Christus et <lb xml:id="p1z12"/>imperium suum augeatur, antichristi diminuatur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Quod imponis mihi de libris et literis tum accipiendis <lb xml:id="p1z14"/>a <persName ref="p4851">Froschouero</persName> tum in <placeName ref="l830">Anglia</placeName> reddendis, libenter accipio; non <lb xml:id="p1z15"/>id grave, sed pergratissimum mihi erit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Cupio enim tibi et <placeName ref="l587">Tigu<lb xml:id="p1z16"/>rinis</placeName> omnibus inservire; nam me ipsum Tigurino-<placeName ref="l830">Anglum</placeName> puto.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z17"/>Libros igitur et literas fidelissime vel reddam ipse vel mittam <lb xml:id="p1z18"/>iis, quibus commendasti.</s>
					<s n="11" xml:lang="la">Miror tamen, quod episcopo nullum <lb xml:id="p1z19"/>exemplar miseris.</s>
					<s n="12" xml:lang="la">Sed parum refert; nam eidem tuo nomine <lb xml:id="p1z20"/>praesentabo, quod mihi dederis.</s>
					<s n="13" xml:lang="la">Literas tuas ad doctorem <lb xml:id="p1z21"/><persName ref="p8121">Montium</persName> <placeName ref="l18">Augustam</placeName> misi; istic enim est cum legato <placeName ref="l830">Angliae</placeName>, <lb xml:id="p1z22"/>verum in fine huius mensis huc reversurus.</s>
					<s n="14" xml:lang="la">Avocant <lb xml:id="p1z23"/>negotia nec sinunt diutius immorari; precor igitur, ut <lb xml:id="p1z24"/>parcas tenuitati meae scribendi.</s>
					<s n="15" xml:lang="la">Nova non habemus; <lb xml:id="p1z25"/>si quid fuerit, <placeName ref="l157">Franckofordiae</placeName> communicabo.</s>
					<s n="16" xml:lang="la" ana="farewell">Bene vale <lb xml:id="p1z26"/>cum familia universa.</s>
					<s n="17" xml:lang="la" ana="salute">Uxor mea quam officiose te <lb xml:id="p1z27"/>et tuam resalutant.</s>
					<s n="18" xml:lang="la">Salvi sunt fratres omnes.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z28"/>Tuus <persName ref="p505">Burcherus</persName>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z29"/>Librum <placeName ref="l1322">Lovaniensem</placeName> reperire non possum; sed a <placeName ref="l157">Franckofordia</placeName> <lb xml:id="p1z30"/>mittendus erit.</s>
					<s n="21" xml:lang="la">Has literas quaeso perferri cures <lb xml:id="p1z31"/><placeName ref="l555">Vitudurum</placeName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem frommen, wisen <lb xml:id="p2z2"/>hern <persName ref="p495">Bullinger</persName>, praedic<lb xml:id="p2z3"/>anten zum Münster, <lb xml:id="p2z4"/>mynem gunstigen hern.</s>
				</p>
				<p>
					<s n="23" xml:lang="de"><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
