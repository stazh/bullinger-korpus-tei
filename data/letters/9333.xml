	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Remitto tibi tua <placeName ref="l648">Rhetica</placeName> et pro his ago gratias, <lb xml:id="p1z2"/>agit etiam d. <persName ref="p8063">Steigerus</persName>, qui eadem legit.</s>
					<s n="3" xml:lang="la">Ego quae <lb xml:id="p1z3"/>habeo ex <placeName ref="l2772">Delphinatu</placeName>, <placeName ref="l832">Gallia</placeName> et <placeName ref="l808">Belgico</placeName>, vicissim tibi <lb xml:id="p1z4"/>mitto eaque lingua pleraque <placeName ref="l832">Gallica</placeName> conscripta, sicut ad <lb xml:id="p1z5"/>dominos huc fuere transmissa; non enim fuit ita repente <lb xml:id="p1z6"/>mihi ad manus, qui ea interpretaretur; habetis vero illic <lb xml:id="p1z7"/>plures, qui ea intelligere et interpretari possunt.</s>
					<s n="4" xml:lang="la">Si plura <lb xml:id="p1z8"/>habuero, plura mittam.</s>
					<s n="5" xml:lang="la">Scriptum illud Sathanae ad regem <lb xml:id="p1z9"/>praestaret nunquam nec scriptum nec editum.</s>
					<s n="6" xml:lang="la">Nunquam mihi <lb xml:id="p1z10"/>illud placuit; plus enim talibus scriptis irritantur mali <lb xml:id="p1z11"/>quam aedificentur probi.</s>
					<s n="7" xml:lang="la">Mihi tamen neque de authore illius <lb xml:id="p1z12"/>neque de typographo constat.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="9" xml:lang="la">Scribo adhuc et <lb xml:id="p1z13"/>ambulo qualitercunque; ideo ignosces, si sim brevior.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute"><persName ref="p8063">Stei<lb xml:id="p1z14"/>gerus</persName> et nostri omnes te vicissim plurimum salutant, sic etiam <lb xml:id="p1z15"/>d. quaestor <persName ref="p21017">Manuel</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l41">Bernae</placeName> 26. maii 1573.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p8018">I[ohannes] Hal<pb/><lb xml:id="p2z1"/>l[erus</persName>] tuus.</s>
				</p>
				<p>
					<note>[Adresse a t.:]</note>
					<s n="13" xml:lang="la"><lb xml:id="p2z2"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName> seniori, <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori <lb xml:id="p2z5"/>fidelissimo, domino suo ho<lb xml:id="p2z6"/>norando et compatri <lb xml:id="p2z7"/>charissimo.</s>
				</p>
			</div>
		</body>
	</text>
