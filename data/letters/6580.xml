	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>scriptum
					<lb xml:id="p1z2"/>Quia in praesentia, vir ominum vittutum genere ornatis
					<lb xml:id="p1z3"/>non vacat scribere pluribus neque etiam quod scribam,
					<lb xml:id="p1z4"/>aliud habeo, quam scribere sum iussus, hoc ipsum brevi
					<lb xml:id="p1z5"/>perscribam.
					<lb xml:id="p1z6"/>D. d. Ehemius iubet, ut haec ad te capita mittam,
					<lb xml:id="p1z7"/>atque orare te principis illustrissimi vomine, ut aliquoc
					<lb xml:id="p1z8"/>vel tu vel alius quilibet vestrum componatis, in que
					<lb xml:id="p1z9"/>ista capita pro vestro arbitrio tractentur. Imperator
					<lb xml:id="p1z10"/>Comitia indixit Augusstam ad 15 diem ianuarii et
					<lb xml:id="p1z11"/>inter caetera deliberationis capita primum est
					<lb xml:id="p1z12"/>componendo religionis dissidio et haeresibus arcendis
					<lb xml:id="p1z13"/>quae hinc inde gliscere coeperint. Puto simile
					<lb xml:id="p1z14"/>scriptum a Genevensibus Anglis Germanis Inferior
					<lb xml:id="p1z15"/>et Gallis proditurum. Fortasse hoc pactor
					<lb xml:id="p1z16"/>egorabitur imperator aut saltem movebuntur multorum
					<lb xml:id="p1z17"/>ad cogitandum de remediis adhibendis tot
					<lb xml:id="p1z18"/>malis. Fiei et poterit, ut mala malorum consilia
					<lb xml:id="p1z19"/>retardentur, si multi bona consilia meditentur
					<lb xml:id="p1z20"/>utut habeat, ad te mitto, ut sum iustus. Ego
					<lb xml:id="p1z21"/>quantum sperem, scio. Quam recte vel sperem aliquid
					<lb xml:id="p1z22"/>vel nihil, nescio. Dominus diugat actiones suorum
					<lb xml:id="p1z23"/>et misereatur ecclesiae suae.
					<lb xml:id="p1z24"/>Scripto mihi a d. Bogno nuncium cum haec scripsis
					<lb xml:id="p1z25"/>allatum est, de peste apud vos grassante. Dnum
					<lb xml:id="p1z26"/>ex toto pectore oro, ut nostri omnium pro sua boni
					<lb xml:id="p1z27"/>propter mediatoris nostr filii ipsius iungeni
					<lb xml:id="p1z28"/>Iesu Christi misereatur. Amen. Fiat ipsius
					<lb xml:id="p1z29"/>sancrissima. Novit, qui sui sint. In rode
					<lb xml:id="p1z30"/>Christo domino valete omnes felicissimi. Die 23.
					<lb xml:id="p1z31"/>omnebs ad meridiem 1555
					<lb xml:id="p1z32"/>Saluta omnes fratres
					<lb xml:id="p1z33"/>in Christo domino.
					<lb xml:id="p1z34"/>Tuus ex animo
					<lb xml:id="p1z35"/>Thomas Erastus.
					<pb/>
					<lb xml:id="p2z1"/>Virtute eruditione, prei
					<lb xml:id="p2z2"/>claissimo viro d.
					<lb xml:id="p2z3"/>Henrico Bullingero,
					<lb xml:id="p2z4"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> ministro
					<lb xml:id="p2z5"/>fidelissimo et prymario
					<lb xml:id="p2z6"/>domino suo iustar patrise
					<lb xml:id="p2z7"/>olendissimo piter.
				</p>
			</div>
