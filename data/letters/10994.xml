	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non sunt mihi posthabitae litterae <lb xml:id="p1z2"/>tuae<note xml:id="fn1" type="footnote" n="1">Oben <ref target="file10983">Nr. 941</ref>.</note>, humanissime <persName ref="p495">Bullingere</persName>, et quod <lb xml:id="p1z3"/>nunc non fit, his diebus nuncium accipies, <lb xml:id="p1z4"/>qui satisfaciet expectationi tuę, quare <lb xml:id="p1z5"/>ne sitis solliciti<note xml:id="fna" type="footnote" n="a">sitis solliciti <hi>vom Schreiber korrigiert aus</hi> sis sollicitus.</note> rogo<note xml:id="fn2" type="footnote" n="2">Vgl. unten <ref target="file11003">Nr. 961</ref>.</note>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Commentarios tuos <lb xml:id="p1z6"/>in epistolas Paulinas<note xml:id="fn3" type="footnote" n="3"><bibl source="b286">HBBibl</bibl> I 84.</note> gravissimum iucundissimum<lb xml:id="p1z7"/>que accepimus <foreign xml:lang="el">σύμβολον</foreign><note xml:id="fnb" type="footnote" n="b"><foreign xml:lang="el">σύμβολον</foreign> <hi>am Rande nachgetragen.</hi></note> amiciciae tuae erga nostras <lb xml:id="p1z8"/>familias itemque diligentię in rem publicam christianam.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="salute"><lb xml:id="p1z9"/>Saluta meis et <persName ref="p4082">Zvicciorum</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p4079">Johannes</persName> und <persName ref="p4082">Konrad Zwick</persName>.</note> verbis pios <lb xml:id="p1z10"/>et litteratos omnes, inprimis ipsum consulem <lb xml:id="p1z11"/><persName ref="p2816">Röschum</persName><note xml:id="fn5" type="footnote" n="5">Bürgermeister <persName ref="p2816">Diethelm Röist</persName>.</note>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><pb type="edition" next="70"/><persName ref="p8171">Theodori</persName><note xml:id="fnc" type="footnote" n="c">Theodori <hi>vom Schreiber korrigiert aus</hi> Theodorum.</note> [ve]rsiculos<note xml:id="fnd" type="footnote" n="d">[ve]rsiculos <hi>am Rande nachgetragen; im engen Einband teilweise verdeckt.</hi></note><note xml:id="fn6" type="footnote" n="6"><persName ref="p8171">Theodor Biblianders</persName> umfangreiches Lobgedicht auf den zum Bürgermeister gewählten <persName ref="p8178">Thomas Blarer</persName> (32 vierzeilige Strophen) befindet sich in: Zürich ZB, Ms. Car I 93 (eigenhändige Kopie <persName ref="p8171">Biblianders</persName>).</note>, si dabis, compensabo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z12"/>Vale in Christo, venerande <persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Constantię, <lb xml:id="p1z13"/>19. februarii 1537.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p8178">Thomas Blaurerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/>praeconi evangeli<lb xml:id="p2z4"/>cae veritatis <lb xml:id="p2z5"/>apud Tiguros, <lb xml:id="p2z6"/>domino et amico <lb xml:id="p2z7"/>suo venerando.</s>
					<s n="10" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zurch</placeName>.</s>
				</p>
			</div>
