	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Qui has perfert, <persName ref="p5441">Isaacus Keller</persName>, medicinae doctor, <persName ref="p1365">Grynaei</persName> <lb xml:id="p1z3"/>piae memoriae privignus, vir doctrina excellente et singulari pietate <lb xml:id="p1z4"/>praeditus est, quem tibi, mi <persName ref="p495">Bullingere</persName>, unice commendo; cupit enim <lb xml:id="p1z5"/>innotescere bonis, et quia <foreign xml:lang="el">ἄγαμος</foreign> est, circumspicere, sicubi occasio of<lb xml:id="p1z6"/>feratur rebus suis consulendi<lb xml:id="p1z7"/>.</s>
					<s n="3" xml:lang="la">Fratrem habet <persName>Andream Keller</persName>, virum non postremae autoritatis in <lb xml:id="p1z8"/>senatu nostro mihique amicum, cui velim affinis tui negocium vel per hunc nostrum tuo nomine <lb xml:id="p1z10"/>commendari; nam ex eo erit nobis non vulgare et consilium et auxilium.</s>
					<s n="4" xml:lang="la">Nova <lb xml:id="p1z11"/>nunc nulla habemus, nisi quod <persName ref="p2916">Schertlius</persName> militem dicitur conscribere regi<lb xml:id="p1z12"/>s <lb xml:id="p1z13"/><persName ref="p18477">Ferdinandi</persName> nomine.</s>
					<s n="5" xml:lang="la"><persName ref="p18423">Albertus Bavarus</persName> a nobilitate sua propter religionis <lb xml:id="p1z14"/>evangelicae libertatem interpellatus, et ne <placeName ref="l875">Hispanicae</placeName> inquis<lb xml:id="p1z15"/>itioni locum faceret, respondit, quod eam (inquam) inquisitionem attinet, sib<lb xml:id="p1z16"/>i <lb xml:id="p1z17"/>nunquam fuisse in animo, ut introduceret, verum de ostio evangelio pate<lb xml:id="p1z18"/>facien<lb xml:id="p1z19"/>do nondum liquido responderat, quum ad me amicus ex aula suas perscriberet, <lb xml:id="p1z20"/>sed spem tamen multis factam haud obscure significavit.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z21"/>Rogandus est dominus, qui regum corda in manu habet et moderatur, <lb xml:id="p1z22"/>ut amplissimum principatum verae cognitionis luce donet et illustret.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z23"/><persName ref="p8406">Cunradus <span type="pronoun">noster</span> Lycosthenes</persName> dei singulari beneficio eo usque restitutus <lb xml:id="p1z24"/>est, ut citra scipionem queat ingredi propemodum inoffense, sed linguae <lb xml:id="p1z25"/>tamen vinculum nondum est ita solutum, quin aliquot in syllabis et literis <lb xml:id="p1z26"/>enunciandis blaesus haereat.</s>
					<s n="8" xml:lang="la">Verum cum et ea parte in dies <lb xml:id="p1z27"/>proficiat, spem fovemus denuo ministerio suo vel ex parte functurum <lb xml:id="p1z28"/>esse, id quod sic cupio et oro dominum ut vix quicquam impensius, quia organum <lb xml:id="p1z29"/>certe est minime vulgare.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale cum tuis omnibus et uxore.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l28">Basileae</placeName> <lb xml:id="p1z30"/>4. februarii anno 1554.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z31"/>T[uus] <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> antistiti, domino <lb xml:id="p2z4"/>colendissimo et symmistae <lb xml:id="p2z5"/>dilectissimo suo.</s>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
