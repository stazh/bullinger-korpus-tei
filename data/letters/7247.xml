	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Ad literas humanitatis tuae, clarissimi vir et
					<lb xml:id="p1z2"/>pin Christo colendissime 2c. septembris ad
					<lb xml:id="p1z3"/>etsi tardius fortasse respondeo, nihil
					<lb xml:id="p1z4"/>omnius tamen propter tumultus uiideniales
					<lb xml:id="p1z5"/>non ita ut statueram, respondere possum.
					<lb xml:id="p1z6"/>Ut vero nunc breviter scribam, imprimis
					<lb xml:id="p1z7"/>me fratrum impulit voluntas. Praefectus
					<lb xml:id="p1z8"/>Turgoviae imperavit m. Ludovici Bovilli
					<lb xml:id="p1z9"/>filio, qui pastor Wagenhusensis ecclesiae est
					<lb xml:id="p1z10"/>ut ad proximam vestram synodum cum alii
					<lb xml:id="p1z11"/>suae praefecturae subiectis ministris, Tigurin
					<lb xml:id="p1z12"/>sese sistat. pastor d. Deanum nostrum
					<lb xml:id="p1z13"/>super ea re consuluit, d. Sebastianum
					<lb xml:id="p1z14"/>Grubelium. Is, postquam ad fratres Scaphusianos
					<lb xml:id="p1z15"/>retulit, mandatum mihi dasu
					<lb xml:id="p1z16"/>t ut tuam hac de re sentntiam petam
					<lb xml:id="p1z17"/>Nam quia pastor ille per aliquot hactenus
					<lb xml:id="p1z18"/>annos synodum nostram visitavit, existima
					<lb xml:id="p1z19"/>aliqui decretum conventus Badensis
					<lb xml:id="p1z20"/>ad ipsum minus pertinere. At vero, ne
					<lb xml:id="p1z21"/>quid a nobis inepti aut praeposteri comp
					<lb xml:id="p1z22"/>mittati tuam humanitatem oramus, ut
					<lb xml:id="p1z23"/>quid illi agendum sit, ne quid minus
					<lb xml:id="p1z24"/>recte agat, ante synodi vestrae constitutu
					<lb xml:id="p1z25"/>siggare velis. Longius illi iter ad
					<lb xml:id="p1z26"/>vos est quam ad nos. Eadem vero fidei
					<lb xml:id="p1z27"/>religionis confessio. Sententiam igitur tuam
					<lb xml:id="p1z28"/>desideramus. De Constantiensi synodi
					<lb xml:id="p1z29"/>nihil omnino certi habeo, nisi quod sacrisa
					<lb xml:id="p1z30"/>cancubniae relegandae suit
					<lb xml:id="p1z31"/>meo iudicio) quam prioribus gratiores sunt
					<lb xml:id="p1z32"/>paulo post recipiendae. D. Sulcerus Müsr
					<lb xml:id="p1z33"/>husianis pastorem misit, de quo aliqui me
					<lb xml:id="p1z34"/>ne ecclesiam illam turbet
					<pb/>
					<lb xml:id="p2z1"/>Utinam dei misericordia illa dies illucescat
					<lb xml:id="p2z2"/>qua vel nos ipsi aut saccessores nostri.
					<lb xml:id="p2z3"/>concordiam in re sacramentaria videri
					<lb xml:id="p2z4"/>possint. Mitto carmen Germanicum
					<lb xml:id="p2z5"/>quod ante aliquot dies concinnatum a
					<lb xml:id="p2z6"/>me est de coena dominica; nam quia nun
					<lb xml:id="p2z7"/>Calechismi capita populariter plebi explicamus
					<lb xml:id="p2z8"/>nec de eucharistia ecclesiasticum carmen
					<lb xml:id="p2z9"/>in nostro templo idoneum Cangli, hoc
					<lb xml:id="p2z10"/>ipsum pro virili ex institutione verbis
					<lb xml:id="p2z11"/>domini composui; Optarim enim simplicem
					<lb xml:id="p2z12"/>plebeculam Assuefreri magis ad sacra
					<lb xml:id="p2z13"/>scripturae quam hominum verba, praesertim
					<lb xml:id="p2z14"/>in caelechismi capitibus, quae omnibus esse
					<lb xml:id="p2z15"/>notissima debent, nec minus optarim
					<lb xml:id="p2z16"/>in iis ecclesiis, in quibus canendi consuetudion
					<lb xml:id="p2z17"/>multorum piorum iudicio, non quaslibet
					<lb xml:id="p2z18"/>si probatas tamn cantiones usurpari.
					<lb xml:id="p2z19"/>Hanc igitur quam mitto, imprimis tuo,
					<lb xml:id="p2z20"/>fratrumque iudicio submitto.Quae
					<lb xml:id="p2z21"/>placuerit, d. Froschouero tradere potes,
					<lb xml:id="p2z22"/>ut cum paedagogi nostri carminibus ecclesiastia
					<lb xml:id="p2z23"/>imprimati; nam et paulo anted
					<lb xml:id="p2z24"/>calogum tam ex lextu scripturae, ita in
					<lb xml:id="p2z25"/>rhythinos Germanicos transtuli.V.
					<lb xml:id="p2z26"/>Salutabis symmystas omnes et meo et fratrum
					<lb xml:id="p2z27"/>nomine. Resalutant te, reverenter d. consules
					<lb xml:id="p2z28"/>d. Bovillus, d. Peyerus et Beatus Reo
					<lb xml:id="p2z29"/>Scaphusiae 2. octobris anno 1562.
					<lb xml:id="p2z30"/>T Ios Conradus Ulmem
					<pb/>
					<lb xml:id="p4z1"/>Clarissimo viro d. Heinrico Bullingero,
					<lb xml:id="p4z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> antistiti
					<lb xml:id="p4z3"/>fidelissimo, patri suo in Christo
					<lb xml:id="p4z4"/>colendissimo.
				</p>
			</div>
		</body>
	</text>
