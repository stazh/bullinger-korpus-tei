	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuas accepi scriptas 8. decembris, in quibus facis mentionem <lb xml:id="p1z2"/>eorum, que multi dictitant de valle <placeName>Angonie</placeName>, quam <placeName ref="l2478">Sabaudus</placeName> <lb xml:id="p1z3"/>vult invadere, quod aliquibus in locis colligatur miles.</s>
					<s n="3" xml:lang="la">Sed <lb xml:id="p1z4"/>incertus est author.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ferunt etiam portum aliquem in <placeName ref="l2801">Corsica</placeName> <lb xml:id="p1z5"/>capt m a <placeName ref="l2510">Turcis</placeName>; certiora expecto ut etiam de eo, quod e <lb xml:id="p1z6"/><placeName ref="l301">Lugduno</placeName> multi scripserunt ad me regem esse mortuum, cum tamen <lb xml:id="p1z7"/>ab eo scriptas literas ultima decembris receperim.</s>
					<s n="5" xml:lang="la">Scit dominus, <lb xml:id="p1z8"/>quid suis expediat et quibus mediis ecclesię sue adesse velit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>In horas literas expecto; de iis, que intellexero, certiorem <lb xml:id="p1z10"/>te faciam.</s>
					<s n="7" xml:lang="la" ana="salute">Bene vale; salutabis amicos omnes et nos amabis.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/><placeName ref="l760">Solodori</placeName> 11. decembris.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z12"/>T[otus] tuus ex animo<lb xml:id="p1z14"/>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="de"><lb xml:id="p2z5"/>Zu <placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
