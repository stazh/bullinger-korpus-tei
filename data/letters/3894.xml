	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ex tuis literis intellexi te duos tantum caseos accepisse.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Addideram tertium quadratum et oblongum, et tres erant <lb xml:id="p1z3"/>in capsula; facile intelligam, quis interceperit.</s>
					<s n="4" xml:lang="la">Huiusmodi <lb xml:id="p1z4"/>non merentur gratiarum actionem; vellem occasionem mihi dari, <lb xml:id="p1z5"/>qua maiori in re tibi gratificari possem.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Que de filio scripsisti, iucundissima mihi fuerunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z7"/>De pace nihil adhuc affirmare ausim, cum in hoc sint <lb xml:id="p1z8"/>deputati et maxime difficultates se offerant.</s>
					<s n="7" xml:lang="la">Quod domino <lb xml:id="p1z9"/>visum fuerit, bonum et iustum erit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><persName>Imperator</persName> tandem <lb xml:id="p1z10"/>quinque articulos proposuit iuxta formulam consuetam <lb xml:id="p1z11"/>aliis comitiis, primum de religione, 2. de contributione contra <lb xml:id="p1z12"/><placeName ref="l2510">Turcam</placeName>, 3. de moneta, 4. de pace et tranquillitate <placeName ref="l822">Germanie</placeName>, <lb xml:id="p1z13"/>ultimum de camera imperiali.</s>
					<s n="9" xml:lang="la"><placeName ref="l1028">Treverensis</placeName> elector est <lb xml:id="p1z14"/><placeName ref="l18">Auguste</placeName>, <placeName ref="l267">Coloniensis</placeName> expectatur et brevi erit et etiam dux <lb xml:id="p1z15"/><placeName ref="l572">Wirtembergensis</placeName>; de aliis nulla fit mentio.</s>
					<s n="10" xml:lang="la"><persName ref="p1825">Rex Polonie</persName> extabescit; <lb xml:id="p1z16"/><persName>elector Brandeburgensis</persName> est paraliticus et septuagenarius, dux <lb xml:id="p1z17"/><placeName ref="l1041">Brunsvicensis</placeName> laborat quartana et morbo regio, ut de iis parva <lb xml:id="p1z18"/>sit vite spes.</s>
					<s n="11" xml:lang="la" ana="salute">Salutabis d. d. <persName ref="p8111">Martirem</persName>, <persName ref="p8011">Galterum</persName> et amicos.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z19"/>vale.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l760">Sol[uturi]</placeName> 14. martii.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z20"/>Tuus ex animo.</s>
				</p>
				<p>
					<note>[Von anderer Hand:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> pastori vigilantissimo.</s>
					<s n="16" xml:lang="de"><lb xml:id="p2z4"/>An herren <persName ref="p495">Heinrichen Bullinger</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Ti<lb xml:id="p2z6"/>guri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
