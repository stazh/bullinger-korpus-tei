	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>ch vattenwyl Ohrister hon
					<lb xml:id="p1z2"/>Lütampt Seck, Gylger
					<lb xml:id="p1z3"/>Parrher wener dorman
					<lb xml:id="p1z4"/>vortrager Ludwig arch
					<lb xml:id="p1z5"/>Zur paner houpm vone i Hag
					<lb xml:id="p1z6"/>radtgäb; der ander vener doru
					<lb xml:id="p1z7"/>Bummeister Vener pastor
					<lb xml:id="p1z8"/>zügmeister Crispin visch
					<lb xml:id="p1z9"/>hoptman zum grossem gschütz, der inn hoff enwoß
					<lb xml:id="p1z10"/>Quauritius bischoff predger
					<lb xml:id="p1z11"/>Spiessen hoptman frischin
					<lb xml:id="p1z12"/>Wälch. Jost von Dießbach obrisch
					<lb xml:id="p1z13"/>fütnampt Seck, Steyger
					<lb xml:id="p1z14"/>Henrych Hieragenus enael
					<lb xml:id="p1z15"/>8000 tütsch 2000 wülsch
				</p>
			</div>
		</body>
	</text>
