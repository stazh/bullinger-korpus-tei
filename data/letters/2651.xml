	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l491">Argentinae</placeName> 14. iunii 1555.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Expectas, sat scio, dilecte pater, tractationem illam <lb xml:id="p1z3"/>d. d. <persName ref="p4037">Zanchi</persName> de auspiciis, quam ante menses aliquot <lb xml:id="p1z4"/>iam abhinc elapsos missurum promiseram, et certe <lb xml:id="p1z5"/>misissem, nisi d. <persName ref="p4037">Zanchum</persName> gravis valetudo longo <lb xml:id="p1z6"/>iam tempore a lectione retardasset; nam ultra duos menses <lb xml:id="p1z7"/>una cum uxore sua graviter decubuit.</s>
					<s n="3" xml:lang="la" ana="salute">Nunc dei <lb xml:id="p1z8"/>gratia aliquantulum ex morbo recreatur mihique iniunxit, <lb xml:id="p1z9"/>ut tibi suo nomine plurimam salutem adscribam et inter<lb xml:id="p1z10"/>missionis suarum literarum morbi excusationem adferam.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z11"/>Praeterea literis proxime a t<lb xml:id="p1z12"/>e <lb xml:id="p1z13"/>mihi allatis iubebas bonos et doctos viros consulere de <lb xml:id="p1z14"/>loco aliquo bonis literis culto, ut, si me <placeName ref="l491">Argentina</placeName> <lb xml:id="p1z15"/>ablegare statuisses, commode eo migrare possem.</s>
					<s n="5" xml:lang="la">Iam <lb xml:id="p1z16"/>ergo, quid illi consuluerint, cognosce.</s>
					<s n="6" xml:lang="la">D. d. <persName ref="p8111">Petrus Marytr</persName> <lb xml:id="p1z17"/>cum d. <persName ref="p4037">Zancho</persName>, etsi status academiarum <placeName ref="l311">Marpurgi</placeName>, <lb xml:id="p1z18"/><placeName ref="l558">Wittenbergae</placeName> et alibi usque adeo certam notitiam <lb xml:id="p1z19"/>non habeant, tamen, quia <placeName ref="l558">Wittenberga</placeName> apud omnes pios <lb xml:id="p1z20"/>et doctos viros semper bene audivit, non tam ob pietatem <lb xml:id="p1z21"/>quam etiam propter egregia et exculta illic <lb xml:id="p1z22"/>studia, consuluerunt, ut eo potius quam <placeName ref="l311">Marpurgum</placeName> <lb xml:id="p1z23"/>eam.</s>
					<s n="7" xml:lang="la"><placeName ref="l311">Marpurgum</placeName> enim petere nemo suadet, praesertim <lb xml:id="p1z24"/>quod praeter alia hic incommoda pestis grassatur et, <lb xml:id="p1z25"/>quod maius, scola est omnino dissipata.</s>
					<s n="8" xml:lang="la">Duo praeterea <lb xml:id="p1z26"/>mei commensales <placeName ref="l830">Angli</placeName>, qui iam nunc ex <placeName ref="l558">Wittenberga</placeName> veniunt, <lb xml:id="p1z27"/>docti et pii viri, omnino suadent, ut me eo transferam, <lb xml:id="p1z28"/>attestantes, quod praeter alia hic commoda etiam parvo pretio <lb xml:id="p1z29"/>vivatur.</s>
					<s n="9" xml:lang="la">Ego, dilecte pater, me in omni re cum tibi praebeo, <lb xml:id="p1z30"/>ut ad omnia, quae tu vis, ita sim praesto, ut etiam ea, quae non <lb xml:id="p1z31"/>possum, putem me tui in honorem facere posse.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Oro tamen, <lb xml:id="p1z32"/>mi pater, ut, si tua voluntate fieri potest, nunc alio quam <placeName ref="l311">Marpu<lb xml:id="p1z33"/>rgum</placeName> porficisci liceat.</s>
					<s n="11" xml:lang="la">Postremo iuvenem illum, qui hasce <lb xml:id="p1z34"/>fert literas, commendo vobis ut bonum, pium et doctum oroque, ut, s<lb xml:id="p1z35"/>i aliquo modo fieri potest, illi subveniatis misero.</s>
					<s n="12" xml:lang="la" ana="salute">Nunc <lb xml:id="p1z36"/>vale in perpetuum cum matre et tota familia, quam meo <lb xml:id="p1z37"/>nomine officiosissime salutabis.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z38"/>Salutat te d. <persName ref="p8362">Ioannes Garnerius</persName> et omnes nostri.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale iterum.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p487">H[einr<lb xml:id="p1z40"/>ychus] Bulli<lb xml:id="p1z41"/>ngerus</persName>, <pb/><lb xml:id="p2z1"/>filius tuus dilect<lb xml:id="p2z2"/>us, <placeName ref="l491">Argen<lb xml:id="p2z3"/>tina<lb xml:id="p2z4"/>e</placeName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
