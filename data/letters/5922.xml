	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><pb type="scan" next="507r"/><lb xml:id="p1z1"/>Gratia et pax in Christo.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Etiamsi iam mihi desit ad te scribendi argumentum, Domine et p<lb xml:id="p1z3"/>raeceptor observandissime, non deest tamen animus, qui tibi optima <lb xml:id="p1z4"/>queaque praecatur.</s>
					<s n="3" xml:lang="la" ana="salute">Fuit non ita pridem apud nos Dominus <persName ref="p1227">Froschoverus</persName><lb xml:id="p1z5"/>, qui <placeName ref="l267">Coloniae</placeName> nostrae belgicae qualiacunque initia vidit, qui s<lb xml:id="p1z6"/>e tibi <lb xml:id="p1z7"/>salutem meis verbis plurimam nuntiaturum recepit, at <lb xml:id="p1z8"/>Optimus <persName ref="p8214">Paulus noster Knibbius</persName>, qui biduum apud nos haesit, <lb xml:id="p1z9"/>fusius exactiusque quo loco sint res nostrae tibi poterit exponere, <lb xml:id="p1z10"/>quem tamen hoc epistolio onerare volui, quo tibi constare <lb xml:id="p1z11"/>posset certius, nos tui nunquam non esse memores, qui pro <lb xml:id="p1z12"/>virili Deum patrem oramus, ut te Ecclesiae suae diu servet in<lb xml:id="p1z13"/>columem.</s>
					<s n="4" xml:lang="la">Quo loco sint res <placeName ref="l822">Germanicae</placeName>, non dubito quin ex <lb xml:id="p1z14"/>aliorum literis iampridem didiceris.</s>
					<s n="5" xml:lang="la"><persName>Grunpachius</persName> quidam <placeName ref="l1030">Herbis <lb xml:id="p1z15"/>polim</placeName> nuper astu cepit, potius quam armis, qua re coactus <lb xml:id="p1z16"/>est Episcopus ex Grunpachii praescripto pacis conditiones admittere.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z17"/>Alioqui vero omnia fere silent.</s>
					<s n="7" xml:lang="la">Tres Principes, <persName>Wirtembergicus</persName> <lb xml:id="p1z18"/>nimirum, <persName ref="p18935">Bipontinus</persName> et <persName>Marchio</persName>, aliquid moliri contra <lb xml:id="p1z19"/>optimum Principem nostrum visi sunt, missa insulsa adversus <lb xml:id="p1z20"/>ipsius Catechesin censura, quibus per te nonnullosque alios ita <lb xml:id="p1z21"/>responsum et satisfactum existimo, ut <persName ref="p458">Brentium</persName> Cum suo <persName>Schmede<lb xml:id="p1z22"/>lino</persName> Seriphiis ranis similes futuros sperem.</s>
					<s n="8" xml:lang="la">Voluit etiam Princeps <lb xml:id="p1z23"/>noster, quid ego sentirem de Censorum scripto, intellegere, itaque dum <lb xml:id="p1z24"/>sententiam meam Consiliariis offero, aliorum etiam iudicia perlege<lb xml:id="p1z25"/>re iubeor, inter quae sane (syncere et ex animo loquor) tuum primum <lb xml:id="p1z26"/>locum non immerito obtinet.</s>
					<s n="9" xml:lang="la">Refutarunt etiam Censuram illam <lb xml:id="p1z27"/>non infeliciter nonnulli superintendentes, itaque Principum unicuique s<lb xml:id="p1z28"/>ex <lb xml:id="p1z29"/>diversa<lb xml:id="p1z30"/>e refutationes censurae missae sunt, quas si perlegerint, <lb xml:id="p1z31"/>deprehendent sane quam toto caelo aberret ac ubique impingat <lb xml:id="p1z32"/>ubiquarius <persName ref="p458">Brentius</persName>.</s>
					<s n="10" xml:lang="la">Puto te superioribus vernalibus nundinis <lb xml:id="p1z33"/>vidisse Concionatorum <placeName ref="l157">francofurdianorum</placeName> amarulentum contra pe<lb xml:id="p1z34"/>regrinos scriptum, quos odiose <foreign xml:lang="de"><placeName>Welschen</placeName></foreign> vocant, huic amicorum <lb xml:id="p1z35"/>rogatu breviter germanice pro mea tenuitate respondi, cuiu<lb xml:id="p1z36"/>s responsionis meae exemplar ut amicitiae nostrae pignus tibi mitto, <lb xml:id="p1z37"/>quod ut tibi gratum sit obnixe oro.</s>
					<s n="11" xml:lang="la">Si quid minus dextre aut <lb xml:id="p1z38"/>pie dictum fuerit, huius quaeso me familiariter et libere admoneas.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z39"/>Caetera ex <persName>Paulo</persName> nostro intelliges.</s>
					<s n="13" xml:lang="la">Valeas, vir praestantissime, ac <lb xml:id="p1z40"/><persName ref="p772">Dathaenum</persName> tuum ut coepisti ames.</s>
					<s n="14" xml:lang="la">Raptim <placeName ref="l156">Franckendaliae</placeName> 23 Octo. 1563.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Tui studiosissimus</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><persName ref="p772">Pe<lb xml:id="p1z41"/>trus Dathaenus</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Ignosces quaeso lituris, vix licuit relegere.</s>
					<s n="18" xml:lang="la">Dominis <persName ref="p8011">Gualtero</persName>, <persName ref="p1884">Lavatero</persName>, <persName ref="p8442">Zimlero</persName> ac <persName ref="p7228">Juniori Zwinglio</persName> reverenter et officiose commendari cupio, quos in Christo veneror et amp<pb/><lb xml:id="p2z1"/>lector.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb type="scan" next="507v"/>Clarissimo praestantissimoque viro, Domino <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> Ecclesiae <lb xml:id="p2z3"/>Antistiti vigilantissimo, Domino et Praeceptori <lb xml:id="p2z4"/>suo perpetua fide et observantia <lb xml:id="p2z5"/>colendissimo.</s>
					<s n="20" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
