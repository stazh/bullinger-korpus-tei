	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia Christi tecum.</s>
					<s n="2" xml:lang="la">Quo loco sit libertas <lb xml:id="p1z2"/><placeName ref="l822">Germanica</placeName>, tot ubique viduis et orphanis <lb xml:id="p1z3"/>exulantibus, tot aerariis denique exhaustis, <lb xml:id="p1z4"/>tot frugibus a locustis non <placeName ref="l875">Hispanicis</placeName>, sed <lb xml:id="p1z5"/><placeName ref="l822">Germanicis</placeName> corrosis non fuerit operę praetium <lb xml:id="p1z6"/>significare.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Tu enim pro tua singulari prudentia <lb xml:id="p1z7"/>plus intelligis, imo divinare poteris <lb xml:id="p1z8"/>de futuro <placeName ref="l822">Germanię</placeName> statu, atque ego multis <lb xml:id="p1z9"/>verbis deprędicare possim.</s>
					<s n="4" xml:lang="la">Olim strenui fuere <lb xml:id="p1z10"/><placeName ref="l822">Germani</placeName>, sed nunc seditione, dolis, scelere <lb xml:id="p1z11"/>atque libidine et ira omnia fervent.</s>
					<s n="5" xml:lang="la">O bone <lb xml:id="p1z12"/>deus, averte iram tuam a nobis, da spiritum <lb xml:id="p1z13"/>et animum, ut te recte colentes vere resipiscamus <lb xml:id="p1z14"/>atque ut filius nos liberet; tum enim ver<lb xml:id="p1z15"/>e liberi erimus.</s>
					<s n="6" xml:lang="la">Noster princeps nondum <lb xml:id="p1z16"/>rediit; agit cum cognato.</s>
					<s n="7" xml:lang="la">Utinam felices <lb xml:id="p1z17"/>sint tractatus, ne a semel confessa veritate <lb xml:id="p1z18"/>et institutis hactenus in ecclesia nostra <lb xml:id="p1z19"/>observatis ad mores ducales, <lb xml:id="p1z20"/>quod absit, reformemur.</s>
					<s n="8" xml:lang="la">Ita sumus omnes <lb xml:id="p1z21"/>pertinaces, ut nec ad digitum latum ex veteri <lb xml:id="p1z22"/>instituto mutaturi simus.</s>
					<s n="9" xml:lang="la">Quid velim, i<lb xml:id="p1z23"/>ntelligis.</s>
					<s n="10" xml:lang="la">Ora pro nobis dei filium dominum Ie<lb xml:id="p1z24"/>sum Christum, ut nos sua solita clementia servet <lb xml:id="p1z25"/>integros etc.</s>
					<s n="11" xml:lang="la">Stipendiarii <placeName ref="l280">Lausannenses</placeName> <lb xml:id="p1z26"/>revocati ad vos mittentur.</s>
					<s n="12" xml:lang="la">Reliqua ex iuniore <lb xml:id="p1z27"/><persName ref="p4744">Fagio</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Saluta omnes in Christo.</s>
					<s n="14" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="15" xml:lang="de"><placeName ref="l411">Richen<lb xml:id="p1z28"/>villę</placeName> 6. kalendas septembris 1552.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z29"/>T[uus] <persName ref="p1010">Erbius</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z30"/>Salutant te nostri i<lb xml:id="p1z31"/>n Christo <pb/><lb xml:id="p2z1"/>Viro eximio d. <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesię <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> antistiti <lb xml:id="p2z4"/>vigilantissimo, suo <lb xml:id="p2z5"/>fratri <lb xml:id="p2z6"/>observando<lb xml:id="p2z7"/>.</s>
				</p>
			</div>
		</body>
	</text>
