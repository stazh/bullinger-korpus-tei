	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et vitae innocentiam a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Bonus hic se<lb xml:id="p1z2"/>necio<note xml:id="fn1" type="footnote" n="1">Unbekannt.</note> caussam habet matrimonialem, in qua ipsi <lb xml:id="p1z3"/>tua intelligo opus esse opera.</s>
					<s n="3" xml:lang="la">Fidem enim dedit <lb xml:id="p1z4"/><persName ref="p4919">filia</persName> <persName ref="p4920">Geysmeyeri</persName><note xml:id="fn2" type="footnote" ana="bio" n="2">Wohl <persName ref="p4919">Margareta Geißmeyer</persName>, die Tochter von <persName ref="p4920">Michael Geißmeyer</persName> (s. Emil <hi>Stauber,</hi> Geschichte der Kirchgemeinde Andelfingen, Bd. II, Zürich 1941, S. 889).</note> a <placeName ref="l193">Gyrspurg</placeName><note xml:id="fn3" type="footnote" n="3"><placeName ref="l193">Girsberg</placeName> (<placeName ref="l2583">Waltalingen</placeName>, <placeName ref="l803">Kt. Zürich</placeName>).</note> filio<note xml:id="fn4" type="footnote" n="4">Unbekannt.</note> suo.</s>
					<s n="4" xml:lang="la">Nunc, quan<lb xml:id="p1z5"/>tum intelligo, dissimulat et facta infecta esse <lb xml:id="p1z6"/>vellet.</s>
					<s n="5" xml:lang="la">Tu vero pro tua pietate nosti fidem pactam <lb xml:id="p1z7"/>maxime in nuptiis atque sponsalibus non temere <lb xml:id="p1z8"/>solvendam esse.</s>
					<s n="6" xml:lang="la">Dabis ergo operam, ut commonita <lb xml:id="p1z9"/>offitii sui caveat, ne conscientiam perfidia polluat.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Modica scintillula in fomitem recondita conscientiae in<lb xml:id="p1z11"/>credibile<note xml:id="fna" type="footnote" n="a"><hi>in der Vorlage</hi> incredebile.</note> aliquando excitabit homini incendium<note xml:id="fn5" type="footnote" n="5">Vgl. <bibl source="b473">Otto</bibl> 311f, Nr. 1604.</note>.</s>
					<s n="8" xml:lang="la">Cre<lb xml:id="p1z12"/>didit fortasse delatoribus nimis credula puella.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>Si fidem dedit, credat deo magis<note xml:id="fnb" type="footnote" n="b">magis <hi>am Rande nachgetragen.</hi></note> et stet pactis.</s>
					<s n="10" xml:lang="la">Non <lb xml:id="p1z14"/>audio quicquam hic inscia <persName ref="p4918">matre</persName><note xml:id="fn6" type="footnote" n="6">Wohl <persName ref="p4918">Magdalena Geißmeyer</persName> (s. <hi>Stauber,</hi> aaO, S. 889).</note> actum esse.</s>
					<s n="11" xml:lang="la">For<lb xml:id="p1z15"/>tassis filiae poenitentiam nescit.</s>
					<s n="12" xml:lang="la">Prudenter tamen <lb xml:id="p1z16"/>ista omnia inquires.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 9. septembris <lb xml:id="p1z17"/>anno 1537.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Quod autem huic seni impenderis <lb xml:id="p1z18"/>diligentiae, mihi putabo impensum.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z19"/><persName ref="p495">H. Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p8130">Laurentio Agricolae</persName>, <placeName ref="l2483">Stam<lb xml:id="p2z2"/>heymensi</placeName> pastori vigilantissimo <lb xml:id="p2z3"/>et longe charissimo fratri.</s>
				</p>
			</div>
