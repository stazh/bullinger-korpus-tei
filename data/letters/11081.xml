					<msContents>
						<summary>
							<p xml:id="regest1"><persName ref="p8130" cert="high">Lorenz Meyer</persName> soll der Tochter <persName ref="p4920" cert="high">Geißmeiers</persName> in <placeName ref="l193" cert="high">Girsberg</placeName> [<placeName ref="l2583" cert="high">Waltalingen</placeName>, <placeName ref="l803" cert="high">Kt. Zürich</placeName>] ins Gewissen reden, da sie leichtfertig abstreitet, dem Sohn des alten Mannes, der den Brief überbringt, die Ehe versprochen zu haben; soll auch vorsichtig der Haltung der <persName ref="p4918" cert="high">Mutter</persName> nachfragen. Wird <persName ref="p8130" cert="high">Meyer</persName> diesen Dienst hoch anrechnen.</p>
						</summary>
						<msItem>
							<textLang>Latein</textLang>
						</msItem>
					</msContents>
