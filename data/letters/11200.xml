	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto ad te, doctissime simul et integerrime <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z2"/>apocalypsim Iohannis opera <persName ref="p5837">Sebastiani Meyer</persName><note xml:id="fna" type="footnote" n="a"><hi>nach</hi> <persName ref="p5837">Meyer</persName> <hi>ein gestrichenes, unlesbares Wort.</hi></note> <lb xml:id="p1z3"/>illustratam<note xml:id="fn1" type="footnote" n="1"><persName ref="p5837">Sebastian Meyer</persName>, In apocalypsim Iohannis apostoli ... commentarius, <placeName ref="l587">Zürich</placeName> [1539] (<bibl>BZD</bibl> C 281).</note>, opus profecto non levi diligentia <lb xml:id="p1z4"/>congestum, quod plane sub nutum censuramque tuam <lb xml:id="p1z5"/>committimus hoc nomine, si non excudendum videatur, <lb xml:id="p1z6"/>ut certo nuntio incorruptum et integrum <lb xml:id="p1z8"/>remittas.</s>
					<s n="3" xml:lang="la">Titulum tu, si <lb xml:id="p1z9"/>perspexeris<note xml:id="fnb" type="footnote" n="b"><hi>korrigiert aus</hi> persperis.</note> librum<note xml:id="fnc" type="footnote" n="c">librum <hi>über der Zeile nachgetragen.</hi></note>, adiungito, atque <lb xml:id="p1z10"/>velim te praefari quoque in librum, sin minus, testimonio <lb xml:id="p1z11"/>saltem tuo commendari comprobarique.</s>
					<s n="4" xml:lang="la">Si hoc quoque grave <lb xml:id="p1z12"/>videatur, ut non confido, velim vel <persName ref="p1753">Leonem</persName><note xml:id="fnd" type="footnote" n="d"><hi>nach</hi> Leonem <hi>gestrichenes</hi> alium.</note><note xml:id="fn2" type="footnote" n="2"><persName ref="p1753">Leo Jud</persName>.</note> <lb xml:id="p1z13"/>vel <persName ref="p8171">Bibliandrum</persName> in eum praefari testimonioque suo <lb xml:id="p1z14"/>libro adesse.</s>
					<s n="5" xml:lang="la">Quod si nullus vestrum hoc munus subire <lb xml:id="p1z15"/>velit, poteris, si videatur, quam ego consarcinavi <lb xml:id="p1z16"/>tumultuariam meditationem<note xml:id="fne" type="footnote" n="e"><hi>nach</hi> meditationem <hi>gestrichenes</hi> et.</note><note xml:id="fn3" type="footnote" n="3">Der Entwurf wurde nicht verwendet (vgl. den Brief <persName ref="p3700">Eberhards von Rümlang</persName> an <persName ref="p495">Bullinger</persName> vom 13. Februar 1539, Zürich StA, E II 346, 115) und scheint auch nicht erhalten zu sein; das Werk erschien mit einer Einleitung und einem Nachwort von <persName ref="p5837">Sebastian Meyer</persName>.</note> praefationis vice <lb xml:id="p1z17"/>adiungere, tametsi rudem et agrestem nullaque <lb xml:id="p1z18"/>parte excultam, at integro animo profectam.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z19"/>Hanc vix semel recognoscere, nedum describere <lb xml:id="p1z20"/>vacabat nuntio<note xml:id="fn4" type="footnote" n="4"><persName ref="p18308">Quirinus von Leiden</persName>; vgl. unten <ref target="file11250">Nr. 1207</ref>, 1f.</note> moleste instante abitumque petente.<pb type="edition" next="192"/></s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z21"/>Scripsissem quoque <persName ref="p8171">Bibliandro</persName>, si vacaret, et quod <lb xml:id="p1z22"/>hactenus nihil literarum ad vos dederim, immensę <lb xml:id="p1z23"/>occupationes meę in causa fuere, multa siquidem <lb xml:id="p1z24"/>senatus negotia me expectarunt rationesque <lb xml:id="p1z25"/>omnium praefectorum<note xml:id="fn5" type="footnote" n="5">Gemeint sind die Jahrrechnungen der Vögte.</note>; quę<note xml:id="fnf" type="footnote" n="f"><hi>nach</hi> quae <hi>gestrichenes</hi> omni.</note> ubi primum expedivero, <lb xml:id="p1z26"/>ut negotia scribendi otium suppeditent, non committam, <lb xml:id="p1z27"/>quin vos literis meis neniisque satis obtundam.</s>
					<s n="8" xml:lang="la">Sed <lb xml:id="p1z28"/>novi facilitatem candoremque tuum etc.</s>
					<s n="9" xml:lang="la">Queso, boni <lb xml:id="p1z29"/>consule meque commendatum habeatis, et si quid a <lb xml:id="p1z30"/>me fieri velis, facito certiorem; experiere et senties <lb xml:id="p1z31"/>me tibi obsequentissimum et paratissimum fore.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Datum <lb xml:id="p1z32"/><placeName ref="l41">Bernę</placeName>, 8. idus augusti anno 1538.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z33"/>Totus tuus <persName ref="p3700">Eberardus <lb xml:id="p1z34"/>a Rümlang</persName>, <placeName ref="l555">Vituduranus</placeName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo et integerrimo <lb xml:id="p2z2"/>viro d. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiastę <placeName ref="l587">Tigurino</placeName> <lb xml:id="p2z4"/>primario, amico suo <lb xml:id="p2z5"/>semper observando colendoque<lb xml:id="p2z6"/>.</s>
				</p>
			</div>
