	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi nuper ad te literas bene longas, ornatissime <lb xml:id="p1z2"/>mi <persName ref="p495">Bullingere</persName>, in quibus monui, ne aliqua di<lb xml:id="p1z3"/>ssidii occasio ab Helvetiis permittatur grassari <lb xml:id="p1z4"/>evangelicorum contra alios et aliorum contra <lb xml:id="p1z5"/>vos.</s>
					<s n="3" xml:lang="la">Nam multis annis querunt plerique ruinas, per <lb xml:id="p1z6"/>quas monstrum aliquod in Helvetios intrudatur.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Utinam vel unam horam tecum conversari liceret; <lb xml:id="p1z8"/>aperte rem tibi delinearem, que literis non potest <lb xml:id="p1z9"/>tuto committi.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Mitto piscem star vocatum, der treibt ein hau en, <lb xml:id="p1z11"/>der 2 ceulner hat; hunc offeras d. <persName ref="p1283">Gesnero</persName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/><persName>Polwilerus</persName> valde triumphat in suis ad amicos <lb xml:id="p1z13"/>propter foelicissimos contra <placeName ref="l691">Lotharingos</placeName> et Burgund(icos) <lb xml:id="p1z14"/>successus.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Certo scribitur inducias ad septennium intra regem <lb xml:id="p1z16"/><persName ref="p18477">Ferdinandum</persName> et <placeName ref="l2510">Turcam</placeName> esse factas.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/><placeName>Weida</placeName><note xml:id="fn1" type="footnote" n="1">ein Woiwode (welcher?).</note> dicitur sponsalia contraxisse cum Galli filia.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p6469">Schnepfius</persName>, <persName>Andreas</persName>, <persName ref="p8417">Musculus</persName> ex marchionatu <lb xml:id="p1z19"/>electoris, <persName ref="p6369">Sarcerius</persName>, <persName>Victorinus</persName> ab colloquio propter <lb xml:id="p1z20"/>pertinaciam in re sacramentaria sunt exclusi.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Mirum, quam mihi libellus tuus de eucharistię negotio <lb xml:id="p1z22"/>placeat, placet plerisque bonis viris, quibus <lb xml:id="p1z23"/>secreto communicavi.</s>
					<s n="11" xml:lang="la">Non video, quid in hac re <lb xml:id="p1z24"/>amplius desiderari queat.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z25"/>Perditissimus quidam nebulo <persName>Koßler</persName>, qui vestro <lb xml:id="p1z26"/>monetario atque aliis etiam in imperio rebuspublicis <lb xml:id="p1z27"/>negocium facit, neque animo neque prudentia valet, <lb xml:id="p1z28"/>sed habet paraclaetum et directorem avarissimum et harpiis <lb xml:id="p1z29"/>rapaciorem <persName>Zehender</persName> nomine, olim hic monetarium, <lb xml:id="p1z30"/>cuius instinctu omnia fiunt.</s>
					<s n="13" xml:lang="la">Iam non licet <lb xml:id="p1z31"/>plura.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale, ornatissime <persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l18">Augustę</placeName> 19. <lb xml:id="p1z32"/>octobris anno etc. 57.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><persName ref="p2856">G[ereon]</persName> t[uus].</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Heinricho Bullingero</persName>, domino <lb xml:id="p2z2"/>et amico charissimo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>