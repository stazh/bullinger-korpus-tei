	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia et pax dei, patris nostri caelestis, sit tecum <lb xml:id="p1z2"/>per Christum Iesum, unicum redemptorem <lb xml:id="p1z3"/>fidelium.</s>
					<s n="2" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Opinio, quam conceperam non bonam de filiis <lb xml:id="p1z5"/>meis, reverende ac in Iesu Christo dilecte <lb xml:id="p1z6"/>frater <persName ref="p495">Bulinger</persName>e, iam plane ex animo meo <lb xml:id="p1z7"/>exempta, fidem enim ego scriptis dominationum <lb xml:id="p1z8"/>vestrarum adhibeo maximaeque consolationi <lb xml:id="p1z9"/>mihi tuae literae fuerunt.</s>
					<s n="4" xml:lang="la">Ex illis enim cogno<lb xml:id="p1z10"/>vi dominum nostrum caelestem per sua media bonum <lb xml:id="p1z11"/>finem fecisse harum seditionum (ut ita dicam) <lb xml:id="p1z12"/>inter ref.</s>
					<s n="5" xml:lang="la">dominum <persName ref="p3988">Vuolphium</persName>, hospitem filiorum <lb xml:id="p1z13"/>meorum, et <persName ref="p7983">Ioannem Thenaudum</persName> praeceptorem <lb xml:id="p1z14"/>illorum praeteritum.</s>
					<s n="6" xml:lang="la">Gratia itaque deo et laus perenn<lb xml:id="p1z15"/>is sit.</s>
					<s n="7" xml:lang="la">Ego, quia me liberata ex hac <lb xml:id="p1z16"/>cura et timore de meis pueris deus ordi<lb xml:id="p1z17"/>navit in locum mei tantos insignes viros, <lb xml:id="p1z18"/>qui in instituendis ac educandis filiis meis <lb xml:id="p1z19"/>id oneris subeant, gaudeo in domino <lb xml:id="p1z20"/>precorque, ut id quod coepit, perficiat in bo<lb xml:id="p1z21"/>numque finem deducat.</s>
					<s n="8" xml:lang="la">Praeterea grata <lb xml:id="p1z22"/>mihi plurimum est oratio mutua ecclesiae <lb xml:id="p1z23"/>vestrae sanguine Christi redemptae, quam pro me <lb xml:id="p1z24"/>et pro aliis fidelibus Christi membris facere non <lb xml:id="p1z25"/>obliviscimini.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Tum non minus iucunda sin<lb xml:id="p1z26"/>gularis adhortatio tua, qua hortaris me, ut <lb xml:id="p1z27"/>pergere semper non desistam in pietate, fide, dilectio<lb xml:id="p1z28"/>ne et omnibus bonis christianis operibus.</s>
					<s n="10" xml:lang="la">Dominus <lb xml:id="p1z29"/>augeat <note type="misc">[wiederholt]</note> super te benedictiones suas hic et in futur<lb xml:id="p1z30"/>a coelesti [colesti?] ac sempiterna vita.</s>
					<s n="11" xml:lang="la">Tandem te val<lb xml:id="p1z31"/>ere in domini laudem et gloriam ecclesiaeque illius <lb xml:id="p1z32"/>consolationem ex animo cupio.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Dat. ex <placeName ref="l237">Iwanowicze</placeName> <lb xml:id="p1z33"/>19. iulii anno domini 1557.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z34"/>Tui deditissima <persName ref="p824">Agnes Dlusska</persName> <lb xml:id="p1z35"/>de <placeName>Mirow</placeName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Et pietate et eru<lb xml:id="p2z2"/>ditione variisque dei <lb xml:id="p2z3"/>donis ornatissimo <lb xml:id="p2z4"/>d. <persName ref="p495">Heinricho <lb xml:id="p2z5"/>Bulingero</persName>, fideli ver<lb xml:id="p2z6"/>bi dei ministro, <lb xml:id="p2z7"/>fratri per Christum <lb xml:id="p2z8"/>coniuncto mihi <lb xml:id="p2z9"/>sincere dilecto.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z10"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
