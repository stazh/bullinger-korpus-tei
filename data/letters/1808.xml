	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Septendecim hos coronatos mittit ad te <persName ref="p8033">Beza</persName>, quo <lb xml:id="p1z2"/>nomine, tu scis sine dubio, ego nescio; hoc tantum abs me <lb xml:id="p1z3"/>petit, ut tuto eos tibi transmittam.</s>
					<s n="3" xml:lang="la">De rebus reli<lb xml:id="p1z4"/>quis referent hi nostri, qui quoniam vivę tibi <lb xml:id="p1z5"/>erunt epistolę, nolo te pluribus modo obtundere.</s>
					<s n="4" xml:lang="la" ana="farewell">Ben<lb xml:id="p1z6"/>e vale.</s>
					<s n="5" xml:lang="la" ana="salute">Nostri omnes te salutant, praesertim ii, quos nominatim <lb xml:id="p1z7"/>tibi recensebit <persName ref="p8011">Gvaltherus</persName> noster.</s>
					<s n="6" xml:lang="la" ana="salute">Salvi sint vestri <lb xml:id="p1z8"/>omnes; praesertim tua domus, cui meae quoque uxoris et fa<lb xml:id="p1z9"/>milię nomine multam dices salutem.</s>
					<s n="7" xml:lang="la"><placeName ref="l41">Bernę</placeName> 18. februarii 1553.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>T[uus] <persName ref="p8018">I[oannes] Hallerus</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> ecclesię <lb xml:id="p2z4"/>fidelissimo pastori, <lb xml:id="p2z5"/>domino et compatri suo <lb xml:id="p2z6"/>tam charo quam <lb xml:id="p2z7"/>observando.</s>
					<s n="10" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
