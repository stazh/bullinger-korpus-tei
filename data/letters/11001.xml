	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Vocatur ad nos <persName ref="p1214">Frisius</persName>, ut <lb xml:id="p1z2"/>ei ludo praesit, cui tu aliquando eras praefectus<note xml:id="fn1" type="footnote" n="1"><persName ref="p1214">Johannes Fries</persName> wurde als Nachfolger <persName ref="p4790">Benedikt Finslers</persName> an die Fraumünsterschule berufen; diese Stellung hatte bis 1531 <persName ref="p8418">Myconius</persName> innegehabt. Auf Drängen der <placeName ref="l28">Basler</placeName> erhielt <persName ref="p1214">Fries</persName> vom <placeName ref="l587">Zürcher</placeName> Rat die Erlaubnis, sein Lehramt in <placeName ref="l28">Basel</placeName> noch bis zum Herbst fortzuführen; vgl. unten <ref target="file11002">Nr. 960</ref>. 962f. 969. 976. 979. 988.</note>.</s>
					<s n="3" xml:lang="la">In<lb xml:id="p1z3"/>hortare obsecro virum optimum, ut eam functionem <lb xml:id="p1z4"/>alacri obeat animo.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><pb type="edition" next="82"/>Consultationem<note xml:id="fn2" type="footnote" n="2">Siehe oben <ref target="file10998">Nr. 956</ref>, 14 mit Anm. 7.</note> illam bene <lb xml:id="p1z5"/>longam misissem nunc, sed quaedam erant adhuc excribenda.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Proximo itaque et fidelissimo committam nuntio.</s>
					<s n="6" xml:lang="la">Ubi <lb xml:id="p1z7"/>audierit <persName ref="p1278">Gastius</persName> me illa uti, non succensebit, opinor.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/>Reddam vero immaculatam et fide optima.</s>
					<s n="8" xml:lang="la">Ad reliqua <lb xml:id="p1z9"/>respondet <persName ref="p1753">Leo</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p1753">Leo Juds</persName> Brief an <persName ref="p1365">Grynäus</persName> (vgl. unten <ref target="file11002">Nr. 960</ref>, 48; 970, 1-24) ist nicht erhalten.</note>.</s>
					<s n="9" xml:lang="la">Non potui satis mirari de mascula <lb xml:id="p1z10"/>illa consultatione.</s>
					<s n="10" xml:lang="la">Dominus confirmet nos in omni bono<note xml:id="fn4" type="footnote" n="4">Vgl. <cit type="bible"><ref>2Thess 2, 17</ref></cit>.</note>.</s>
					<s n="11" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z11"/>Nuncius hic<note xml:id="fn5" type="footnote" n="5">Unbekannt.</note> nunquam non ple<lb xml:id="p1z12"/>nis <lb xml:id="p1z13"/>buccis<note xml:id="fn6" type="footnote" n="6">Vgl. Adagia, 3, 5, 71 (<bibl source="b370">LB</bibl> II 844).</note> praedicat tua et <persName ref="p5896">uxoris tuae</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p5896">Margret</persName>, s. <bibl source="b7">HBBW V</bibl> <ref target="file10694">[Nr. 656]</ref>, S. 380, Anm. 18.</note> benefitia.</s>
					<s n="13" xml:lang="la">Dominus <lb xml:id="p1z14"/>sit merces tua.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><persName ref="p18593">Turcarum rex</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p18593">Suleiman I.</persName></note> imminet <placeName ref="l2536">Eu<lb xml:id="p1z15"/>ropae</placeName>.</s>
					<s n="15" xml:lang="la">Orandus est dominus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell">Vale una cum tuis <lb xml:id="p1z16"/>foeliciter.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Scribam et ego <placeName ref="l41">Bernatibus</placeName>, ne pro<lb xml:id="p1z17"/>scribant in ditione ipsorum Retrac[tationem] <persName ref="p467">Buc[eri]</persName><note xml:id="fn9" type="footnote" n="9">Vgl. oben <ref target="file10998">Nr. 956</ref>, 1-13 und 21f. - <persName ref="p495">Bullingers</persName> Brief ist nicht erhalten; vgl. aber <persName ref="p8412">Meganders</persName> Antwort (unten <ref target="file11007">Nr. 965</ref>).</note>.</s>
					<s n="18" xml:lang="la">Etiamsi <lb xml:id="p1z18"/>neque nobis placeant per omnia, nequaquam tamen proscribemus.</s>
					<s n="19" xml:lang="la">"<lb xml:id="p1z19"/>Omnia probate; quod bonum est, tenete", ait apostolus <cit type="bible"><ref>[1Thess 5, 21]</ref></cit>.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z20"/>Venum apud nos exponuntur et blasphemiae <persName ref="p4671">Eggii</persName> <lb xml:id="p1z21"/>et <persName ref="p20278">Fabri</persName><note xml:id="fn10" type="footnote" n="10">Schriften von <persName ref="p4671">Johannes Eck</persName> und <persName ref="p20278">Johannes Fabri</persName>.</note> etc.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">4. martii 1537.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z22"/><persName ref="p495">H. Bullingerus</persName> tuus <lb xml:id="p1z23"/>ex animo.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8418">Osvaldo <lb xml:id="p2z2"/>Myconio</persName>, domino et fratri suo <lb xml:id="p2z3"/>colendissimo.</s>
				</p>
			</div>
		</body>
