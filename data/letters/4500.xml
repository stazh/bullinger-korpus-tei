	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><placeName ref="l646">Glaronense</placeName> negotium me valde cruciat; metuo, <lb xml:id="p1z2"/>ne de ipsis sit actum, praesertim si a nostra parte nulla <lb xml:id="p1z3"/>sentiant auxilia.</s>
					<s n="3" xml:lang="la"><persName ref="p3494">Nicolaus a Diesbach</persName> omnia mihi exposuit.</s>
				</p>
				<p>
					<s n="4" xml:lang="de"><lb xml:id="p1z4"/>Displicet nostris 1. das <placeName ref="l160">Fryburg</placeName> und <placeName ref="l760">Soloturn</placeName> auch bschriben <lb xml:id="p1z5"/>uff den tag, 2. das die evangelischen Zuͦgwanten <lb xml:id="p1z6"/>nitt bschriben, 3. das man zemmen sol kon und sich <lb xml:id="p1z7"/>aber nitt erlüteren, was man thuͦn well, so man die <placeName ref="l646">Glarner</placeName> <lb xml:id="p1z8"/>bi recht nitt wil bliben lon.</s>
					<s n="5" xml:lang="de">Man meint, man <lb xml:id="p1z9"/>schwige inen vil zlang; nahen sige es an anderen auch <lb xml:id="p1z10"/>und bsonders an <placeName ref="l587">Zürich</placeName>, diewyl sy sich vil mercken <lb xml:id="p1z11"/>laßind nitt zuͦ lyden, das so vil da truckt werde <lb xml:id="p1z12"/>wider iren glauben.</s>
					<s n="6" xml:lang="de">Darum guͦt, das man inen bi zyten <lb xml:id="p1z13"/>seite, woran es glegen.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Horum te admonere volui.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Nuper, cum cursor vester hic esset, non eram domi; <lb xml:id="p1z15"/>nunc vix tantum datur, ut haec scribam.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p1541">Herterus</persName> <lb xml:id="p1z17"/>heri nobiscum fuit; ostendit mihi literas <persName ref="p5829">Metzleri</persName> ad te, <lb xml:id="p1z18"/>pro quo ad me etiam scribunt <persName ref="p8055">Blaurerus</persName>, <persName ref="p1214">Frisius</persName> <lb xml:id="p1z19"/>et frater.</s>
					<s n="10" xml:lang="de"><foreign xml:lang="la">Ego vero nihil illi prorsus consulere <lb xml:id="p1z20"/>possum nisi hoc:</foreign> Es hatt jetz juncker <persName ref="p3559">Hartman von Hall<lb xml:id="p1z21"/>wyl</persName> ein ledige pfrund uff dem <placeName ref="l1615">Bötzberg</placeName>, da <persName>Leonhar<lb xml:id="p1z22"/>dus</persName>, <persName ref="p8440">Gervasii</persName> tochterman vor gsin.</s>
				</p>
				<p>
					<s n="11" xml:lang="de">Da acht ich, so <lb xml:id="p1z23"/>er von üch dem junckeren commendiert wurde, <lb xml:id="p1z24"/>welcher lehenherr da ist, er sölti in annemmen.</s>
					<s n="12" xml:lang="de"><lb xml:id="p1z25"/>Ir mögend da vil.</s>
				</p>
				<p>
					<s n="13" xml:lang="de">Sonst weiß ich imm weder zraten <lb xml:id="p1z26"/>noch zhelffen.</s>
					<s n="14" xml:lang="la">Haec propere.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Salutant te <lb xml:id="p1z27"/><persName ref="p3494">Die<lb xml:id="p1z28"/>sbachius</persName>, <persName ref="p8417">Musculus</persName>, <persName ref="p4060">Zehenderi</persName>, quęstores etc.</s>
					<s n="16" xml:lang="la" ana="salute">Saluta <lb xml:id="p1z29"/>tuos omnes.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l41">Bernę</placeName> 16. octobris 1560.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z30"/><persName ref="p8018">Hall[erus]</persName> tuus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Clar<pb/><lb xml:id="p2z1"/>issimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/>domino suo honorando <lb xml:id="p2z4"/>et compatri charissimo.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>