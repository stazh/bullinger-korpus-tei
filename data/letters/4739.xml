	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Scribit ad me d. <placeName ref="l1854">Redonensis</placeName> episcopus expectari responsum <lb xml:id="p1z2"/>electorum imperii in consilii negocio et dieta imperiali, <lb xml:id="p1z3"/>ex quo pendet resolutio imperatoris.</s>
					<s n="3" xml:lang="la">Fuit ipse initiationis <lb xml:id="p1z4"/>arbiter aut mysticus parens filii recens nati <persName ref="p18477">regis Bohemię</persName>.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>In <placeName ref="l832">Gallia</placeName> fuerunt provincialia comitia; in aliquibus <lb xml:id="p1z6"/>statuerunt <persName ref="p18090">regi Navarre</persName> gubernationem et regimen regni <lb xml:id="p1z7"/>deberi vel eo recusante <persName>principi a Conde</persName>: nullos ecclesiasticos, <lb xml:id="p1z8"/>aut qui pontifici sunt obstricti, debere esse ex consilio regis; <lb xml:id="p1z9"/>taceo, quę contra <persName>Guisanos.</persName></s>
				</p>
				<p>
					<s n="5" xml:lang="la"><persName>Princeps a Conde</persName> per regem, eius <lb xml:id="p1z10"/>consilium et parlamentum <placeName ref="l378">Parisiense</placeName> absolutus.</s>
					<s n="6" xml:lang="la">Non probo, quae <lb xml:id="p1z11"/>in nonnullis urbibus <placeName ref="l832">Gallie</placeName> sine magistratus auctoritate acta sunt <lb xml:id="p1z12"/>tumultuosius in tollendis imaginibus.</s>
					<s n="7" xml:lang="la">Sequenti septimana proxim<lb xml:id="p1z13"/>e die lune <lb xml:id="p1z15"/>7. huius <placeName ref="l2448">Quinquepagicorum</placeName> legati conveniunt <placeName ref="l300">Lucerne</placeName>, ut deliberent <lb xml:id="p1z16"/>de <placeName ref="l646">Glaronensium</placeName> causa [EA IV/2, 170.].</s>
					<s n="8" xml:lang="la" ana="salute">Salutat te uxor et familia.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Bene vale <lb xml:id="p1z17"/>et nos ama.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l760">Solut[<lb xml:id="p1z18"/>uri]</placeName> 1. aprilis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="de"><pb/><lb xml:id="p2z1"/>An herren <persName ref="p495">Heinrichen <lb xml:id="p2z2"/>Bullinger</persName>, verkhünder <lb xml:id="p2z3"/>des wortt gottes zuͦ <lb xml:id="p2z4"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
