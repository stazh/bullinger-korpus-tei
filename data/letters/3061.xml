	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nihil equidem, quod nunc scribam, habeo.</s>
					<s n="3" xml:lang="la">Tuas in <lb xml:id="p1z2"/>Apocalypsin conciones legimus, et placet nobis apprime <lb xml:id="p1z3"/>labor iste tuus, et quantum in nobis est, non deerimus, quin <lb xml:id="p1z4"/>apud nos imprimatur.</s>
					<s n="4" xml:lang="la">Expectamus tamen praefationem et <lb xml:id="p1z5"/>tuas ad scholarchas literas.</s>
					<s n="5" xml:lang="la">Coram illis communis fiet consultatio, <lb xml:id="p1z6"/>atque tum etiam respondetur tibi.</s>
					<s n="6" xml:lang="la">Libellum quoque, quem misisti, <lb xml:id="p1z7"/>accepi, et ago tibi gratias.</s>
					<s n="7" xml:lang="la">Video, quid audeant <placeName ref="l28">Basilienses</placeName>, quamvis <lb xml:id="p1z8"/>nec typographus suum addiderit nomen et authoris quoque <lb xml:id="p1z9"/>nomen sit fictum.</s>
					<s n="8" xml:lang="la">Interea tamen miramur libellum <persName ref="p2336">Ochini</persName> de pu<lb xml:id="p1z10"/>rgatorio <placeName ref="l822">Germanicum</placeName> propter paucula verba a <placeName ref="l587">Tigurinis</placeName> fuisse <lb xml:id="p1z11"/>suppressum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Verum tamen est, quod Latina minus laedant quam <lb xml:id="p1z12"/>Germanica, utpote quę non ab omnibus intelliguntur, neque <persName ref="p1227">Frosc<lb xml:id="p1z13"/>hoverum</persName> tam Palestinos nostros vereri arbitror quam damnum, <lb xml:id="p1z14"/>quod <placeName ref="l157">Francofordię</placeName> incurrere poterat, si sub suo nomine <lb xml:id="p1z15"/>evulgaretur.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Rerum novarum nihil habemus.</s>
					<s n="11" xml:lang="la">Hac septiman<lb xml:id="p1z16"/>a transierunt hac plures <placeName ref="l862">Helvetiorum</placeName> cohortes; mirum, si [non] <lb xml:id="p1z17"/>plures frigore pereant, adeo nudi sunt plerique neque [victum] <lb xml:id="p1z18"/>neque pecunias habentes.</s>
					<s n="12" xml:lang="la">Audio mox novas copi[as ven]<lb xml:id="p1z19"/>turas.</s>
					<s n="13" xml:lang="la">Dominus faciat cum illis, quod ipsi bonum videbitur.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">[Bene] <lb xml:id="p1z20"/>vale.</s>
					<s n="15" xml:lang="la" ana="salute">Salutem tibi dicit <persName ref="p8417">Musculus</persName>, mater item mea et uxor; <lb xml:id="p1z21"/>salvi sint tui omnes.</s>
				</p>
				<p>
					<s n="16" xml:lang="de"><placeName ref="l41">Bernę</placeName> 13<lb xml:id="p1z22"/>. decembris 1556.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><persName ref="p8018">I[oannes] <lb xml:id="p1z23"/>H[allerus</persName>] tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> ecclesię <lb xml:id="p2z4"/>fidelissimo, domino <lb xml:id="p2z5"/>et compatri charissimo <lb xml:id="p2z6"/>et colendissimo suo.</s>
				</p>
