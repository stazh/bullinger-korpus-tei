	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi, dilecte frater, duos, quos misisti, libellos.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Latine scriptum diligentissime legi; quodsi adversarii <lb xml:id="p1z2"/>nostri hiis contentari nolunt, frustra laborabitur porro fidelibus.</s>
					<s n="4" xml:lang="la">In Christo satisfactum esse non dubites.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z3"/>Oblata pace indigni michi videntur..., ... propugnatores antichristi, sed ad corda multorum confirmanda <lb xml:id="p1z4"/>fidelium hunc tuum cessisse laborem firmiter credo.</s>
					<s n="6" xml:lang="la" ana="salute">Ego enim gratias ago deo meo, qui me <lb xml:id="p1z5"/>senem tuo salutari ministerio tantopere refocillat.</s>
					<s n="7" xml:lang="la">Germanice scriptum libellum ea, qua datum, diligentia <lb xml:id="p1z6"/>legam.</s>
					<s n="8" xml:lang="la">Ignosce, quod te tot tantisque negotiis adobrutum interpellavi.</s>
					<s n="9" xml:lang="la">Valeo mediocriter cum <lb xml:id="p1z7"/>mea familia.</s>
					<s n="10" xml:lang="la">Prefectus urbis nostrę <persName>Brandolffus</persName> 19. huius multa sanctę fidei constantia abiit ad dominum <lb xml:id="p1z8"/>nec sine magno et gaudio et dolore, totius ecclesię nostre precipue; abiturus per me tibi valedixit <lb xml:id="p1z9"/>et omnia bona tibi precatus est.</s>
					<s n="11" xml:lang="la" ana="salute">Vale salutatus a <persName ref="p20679">Dolpergero</persName>, a vidua, amica <lb xml:id="p1z10"/>tua.</s>
					<s n="12" xml:lang="la">Proximis literis scribam de praefecto arcis nostrę.</s>
					<s n="13" xml:lang="la">Nunctius festinat abitum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Vale amice incomparabilis <lb xml:id="p1z11"/>et tuos noine meo saluta.</s>
					<s n="15" xml:lang="la">Date <placeName ref="l285">Lentzburgi</placeName> 20. marcii 1556.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z12"/>Tuus <persName ref="p8440">Gervasius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo d. <persName ref="p495">Heynricho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurine</placeName> ecclesie <lb xml:id="p2z3"/>antistiti, amico veteri et <lb xml:id="p2z4"/>frati in Christo plurimum <lb xml:id="p2z5"/>observando.</s>
				</p>
			</div>
		</body>
	</text>
