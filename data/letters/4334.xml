	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>pridem vos certiores fecissem vir
					<lb xml:id="p1z2"/>simde statu miserae etiam afflictae ecclesiae
					<lb xml:id="p1z3"/>si semper, quos optabam contigissent tabellarii
					<lb xml:id="p1z4"/>aut tutem fuisset, quaredam nostras literim
					<lb xml:id="p1z5"/>veredera. Prebeatinm ad roanat
					<lb xml:id="p1z6"/>eritat suni criba et prasis estis
					<lb xml:id="p1z7"/>et iam nullam iustam causam accusatione
					<lb xml:id="p1z8"/>dalari adirisis e meaque opera im
					<lb xml:id="p1z9"/>misterio ecclesiastio, tamen merdunt alam
					<lb xml:id="p1z10"/>vulum emuidere omne, ut pt le eres
					<lb xml:id="p1z11"/>uri filaipanta scrispire mum etium
					<lb xml:id="p1z12"/>secreta dere elier neie,
					<lb xml:id="p1z13"/>e elea ere ei ets
					<lb xml:id="p1z14"/>eigulana at e silita liatum eum
					<lb xml:id="p1z15"/>er te desti ei eseae,
					<lb xml:id="p1z16"/>.
					<lb xml:id="p1z17"/>e lia e e asiaiue,
					<lb xml:id="p1z18"/>ire e eia ispias se aiem
					<lb xml:id="p1z19"/>in furatis lęremoniis, sed in iustia et san
					<lb xml:id="p1z20"/>eservire possimus. Mira audis ex
					<lb xml:id="p1z21"/>de sadetia Bereilenis el a
					<lb xml:id="p1z22"/>da lade sere esen e,
					<lb xml:id="p1z23"/>erga lementissime principem, cuius
					<lb xml:id="p1z24"/>ecclesiam
					<lb xml:id="p1z25"/>es l sie i ariu,
					<lb xml:id="p1z26"/>el e e pere e t is,
					<lb xml:id="p1z27"/>ete erpet, si srae eaerus,
					<lb xml:id="p1z28"/>Hailerum iberi et er ililas dise ruam
					<lb xml:id="p1z29"/>dali hlartu at e era seri,
					<lb xml:id="p1z30"/>Beselda ercetis sit praius,
					<lb xml:id="p1z31"/>liliet aie t i t tis
					<lb xml:id="p1z32"/>Tuus Iacobus Myliagrium.
					<lb xml:id="p1z33"/>symmista Erbii
					<pb/>
					<lb xml:id="p2z1"/>venerando et clarissimo
					<lb xml:id="p2z2"/>viro d. Heinrycho Bullingero,
					<lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> episcopo
					<lb xml:id="p2z4"/>vigilantissimo, praeceptori et
					<lb xml:id="p2z5"/>fratri in Christo suo
					<lb xml:id="p2z6"/>colendissimo.
					<lb xml:id="p2z7"/>.
				</p>
