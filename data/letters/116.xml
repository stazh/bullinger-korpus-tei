	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Veni <placeName ref="l41">Bernam</placeName> 3. a discessu meo die magna omnium ex<lb xml:id="p1z2"/>pectatione et summo bonorum quorundam gaudio.</s>
					<s n="3" xml:lang="la">Apparui <lb xml:id="p1z3"/>coram senatu amplissimo; congratulantur sibi et mihi.</s>
					<s n="4" xml:lang="la">Hodie concionem <lb xml:id="p1z4"/>habui et iamiam ab illo revertor.</s>
					<s n="5" xml:lang="la"><persName ref="p8031">Comes</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8031">Béat Comte</persName>.</note> a prandio <lb xml:id="p1z5"/>discedet statim; duos ei dederunt coronatos et 6 ulnas <lb xml:id="p1z6"/>panni coloris <placeName ref="l41">Bernatium</placeName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><persName ref="p3099">Sultzerum</persName> et <persName ref="p8364">Beatum</persName>, cum ipsi <lb xml:id="p1z7"/>aliquoties me visum non salutassent, ipsos tamen conveni salutaturus.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/>Cum <persName ref="p8364">Beato</persName> mox contendere coepi; cupiebat enim subinde <lb xml:id="p1z9"/>aliam ecclesiae faciem.</s>
					<s n="8" xml:lang="la">Ego, quae illa facies esset, urgebam; <lb xml:id="p1z10"/>ille nimis longum esse referre dicens ego valedixi.</s>
					<s n="9" xml:lang="la">Conquerebatur <lb xml:id="p1z11"/>de symmistarum importunitate; ipsarum harum turbarum causam esse asserens.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z12"/>Ego vero existimare illos turbas movere, qui rebus <lb xml:id="p1z13"/>studerent novis et pristinam ecclesiae faciem novis figmentis <lb xml:id="p1z14"/>deturbare vellent.</s>
					<s n="11" xml:lang="la">Post multa discessum est.</s>
					<s n="12" xml:lang="la">Tertio iam fuerunt <lb xml:id="p1z15"/>coram senatu petentes, ut possint vel adhuc semel causam suam <lb xml:id="p1z16"/>dicere coram diacosiis et suam exponere de doctrina sua mentem.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z17"/>Negatum illis bis; tertio cum peterent a sculteto convenire <lb xml:id="p1z18"/>senatum, praetenderunt nihil se quam testimonia discessus <lb xml:id="p1z19"/>sui petituros.</s>
					<s n="14" xml:lang="la">Ille hoc eis concessit.</s>
					<s n="15" xml:lang="la">Ad senatum ubi ventum <lb xml:id="p1z20"/>est, testimoniorum nulla facta mentio, sed denuo petierunt <lb xml:id="p1z21"/>haberi senatum maiorem et audiri ipsorum apologias.</s>
					<s n="16" xml:lang="la">Unde gravi<lb xml:id="p1z22"/>us in ipsorum impudentiam exarsus senatus iussit, ut quam <lb xml:id="p1z23"/>primum hinc demigrent, cum vel adhuc mentiri audeant et <lb xml:id="p1z24"/>fallere velint scultetum aliud coram ipso praetendentes, ut admittat, <lb xml:id="p1z25"/>admissi vero aliud proponentes, de quo tamen sufficienter iam audierint <lb xml:id="p1z26"/>sententias.</s>
					<s n="17" xml:lang="la">Itaque nihil restat, quam ut discedant.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Videbimus interim <lb xml:id="p1z27"/>nos, quo in ordinem pium omnia dirigantur.</s>
					<s n="19" xml:lang="la">Ego interim agam a<pb/><lb xml:id="p2z1"/>pud <persName ref="p4157">Cosmam Alderinum</persName>, qui mihi cognatus est et cum familia exigua <lb xml:id="p2z2"/>amplas habet aedes.</s>
					<s n="20" xml:lang="la">Ita videtur senatui.</s>
					<s n="21" xml:lang="la">D. <persName ref="p1804">Iodocus</persName> rogavit, ut tibi significem <lb xml:id="p2z3"/>literas tuas ad senatum <placeName ref="l41">Bernensem</placeName> scriptas suo aliorumque bonorum <lb xml:id="p2z4"/>consilio apud se esse retentas, ne, dum hae turbae in mediam interve<lb xml:id="p2z5"/>nirent causam, viderentur ipsi nescio quid commovisse etiam contra eos; te etenim <lb xml:id="p2z6"/>ipsius arbitrio hanc rem commisisse.</s>
					<s n="22" xml:lang="la" ana="salute">Alias nihil nunc habeo, quam <lb xml:id="p2z7"/>quod <persName ref="p2916">Schertlius</persName> mecum est in meo hospitio, qui te salutat millies, <persName ref="p1804">Iodocus</persName> <lb xml:id="p2z8"/>item et fratres omnes.</s>
					<s n="23" xml:lang="la">Commendo tibi familiam meam.</s>
				</p>
				<p>
					<s n="24" xml:lang="la" ana="farewell">Vale et me <lb xml:id="p2z9"/>semper ama, ut facis.</s>
					<s n="25" xml:lang="la"><placeName ref="l41">Bernae</placeName> in ipso dominicae ascensionis die 1548<lb xml:id="p2z10"/>.</s>
					<s n="26" xml:lang="la"><lb xml:id="p2z11"/>Tui studiosissimus <persName ref="p8018">Ioannes <lb xml:id="p2z12"/>Hallerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="27" xml:lang="la"><lb xml:id="p2z13"/>Praestantissimo viro D. <persName ref="p495">Heinrycho <lb xml:id="p2z14"/>Bullingero</persName>, domino et <lb xml:id="p2z15"/>compatri suo perpetuo <lb xml:id="p2z16"/>colendo.</s>
					<s n="28" xml:lang="la"><lb xml:id="p2z17"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
