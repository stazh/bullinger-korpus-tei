	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Etplicetio effecit, pater ubd ut domini
					<lb xml:id="p1z2"/>ut audio
					<lb xml:id="p1z3"/>suam quoque e emplicericit viluntatem.
					<lb xml:id="p1z4"/>conclusum est, ut Zacti discedat
					<lb xml:id="p1z5"/>elegat vero virum velit nondum, ut
					<lb xml:id="p1z6"/>autm ipse petat miss aut feret
					<lb xml:id="p1z7"/>dimeis. Utrum vero latine sit.
					<lb xml:id="p1z8"/>adhuc, ignoro. diversa sunt amicorum
					<lb xml:id="p1z9"/>epptia. Deo vero sic tuus, qui
					<lb xml:id="p1z10"/>
					<lb xml:id="p1z11"/>hic me afficet honore, ut
					<lb xml:id="p1z12"/>Ef.
					<lb xml:id="p1z13"/>veritatem. Post multis exantlatis
					<lb xml:id="p1z14"/>labores pis consumptas facultatula,
					<lb xml:id="p1z15"/>post denique multas perlatus animi
					<lb xml:id="p1z16"/>molestias eosque duotum anorum cum
					<lb xml:id="p1z17"/>dividio. tandem logor etiam urbi
					<lb xml:id="p1z18"/>eotes, cum septem menseum filich
					<lb xml:id="p1z19"/>et reliqua familiala, sine ulla
					<lb xml:id="p1z20"/>velatione cum meorum adversariorum
					<lb xml:id="p1z21"/>treum plo extodet vale et ir
