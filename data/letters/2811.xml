	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Forte inveni <placeName ref="l587">Tigurinum</placeName> hunc hic apud <placeName ref="l436">Sanenses</placeName>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Non potui ergo intermittere, quin per ipsum ad te vel <lb xml:id="p1z3"/>unum verbum scriberem, praesertim ut te gaudii mei <lb xml:id="p1z4"/>participem facerem; scias enim recte hic succedere <lb xml:id="p1z5"/>omnia per domini gratiam.</s>
					<s n="4" xml:lang="la">Idola omnia sublata sunt, et <lb xml:id="p1z6"/>sacrificuli discesserunt, et pulchre se populus evangelicę <lb xml:id="p1z7"/>disciplinae accommodare velle videtur.</s>
					<s n="5" xml:lang="la">Rudia quidem <lb xml:id="p1z8"/>adhuc sunt omnia; sed bene spero.</s>
					<s n="6" xml:lang="la">Quando <placeName ref="l41">Bernam</placeName> <lb xml:id="p1z9"/>reversurus sim, adhuc nescio; expecto, quando mittatur <lb xml:id="p1z10"/>certus aliquis pastor, qui huic ecclesiae praesit.</s>
					<s n="7" xml:lang="la">Plura propt<lb xml:id="p1z11"/>er multa negotia non possum.</s>
					<s n="8" xml:lang="la">Tu pauca hęc boni <lb xml:id="p1z12"/>consule et ad me quoque scribe, si quid habes novi.</s>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z13"/>Saluta familiam tuam omnem, fratrem quoque meum, cui n<lb xml:id="p1z14"/>unc non vacat scribere, fratres denique ac symmystas <lb xml:id="p1z15"/>omnes.</s>
					<s n="10" xml:lang="la" ana="salute">Salutat te praefectus noster d. <persName ref="p7510">Ioannes Rodolphus a Gravenried</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z16"/>Sanae 15. ianuarii 1556.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><persName ref="p8018">Io[<lb xml:id="p1z17"/>annes] Hallerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino ac <lb xml:id="p2z4"/>compatri charissimo et colendissimo <lb xml:id="p2z5"/>suo.</s>
					<s n="14" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
