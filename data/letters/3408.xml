	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p1586">Franciscus Hotomannus</persName> S. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>De tuo praestantissimo munere, quo me nuper donare <lb xml:id="p1z3"/>voluisti, gratias habeo ingentes, mi venerande <lb xml:id="p1z4"/>pater et praeceptor observandissime.</s>
					<s n="3" xml:lang="la">Utinam vicissim <lb xml:id="p1z5"/>praestare aliquid dignum, quod c(elsitudini) t(uae) offeretur possem.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Librum Institutionum, quem mihi commodaras, opinor te <lb xml:id="p1z7"/>recepisse.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Eius, cui eum deportandum commisi, praep<lb xml:id="p1z8"/>era discessio fecit, quominus una literas meas possem <lb xml:id="p1z9"/>coniungere.</s>
					<s n="6" xml:lang="la" ana="salute">Spero tamen excusationem meam tum tibi, tum domino <lb xml:id="p1z10"/><persName ref="p3988">Wolfio</persName> probatam esse, quem ego verbis meis quam officiosissime <lb xml:id="p1z11"/>salutari cupio.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Spero etiam tibi ac domino <persName ref="p8111">Martyri</persName>, parenti <lb xml:id="p1z12"/>meo colendissimo, meas literas redditas fuisse, quas duobus <lb xml:id="p1z13"/><placeName ref="l834">Italis</placeName> commisi, quos dominus <persName ref="p4037">Zanchus</persName> doctores iuris dicebat esse <lb xml:id="p1z14"/>et ad vos ante menses duos proficisci.</s>
					<s n="8" xml:lang="la"><persName ref="p1049">Farellum</persName> et <lb xml:id="p1z15"/><persName ref="p8033">Bezam</persName> opinor iam audisti a senatu nostro impetrasse, ut se <lb xml:id="p1z16"/>in <placeName ref="l862">Helveticis</placeName> et <placeName ref="l822">Germanis</placeName> theologis ad amicum aliquod <lb xml:id="p1z17"/>colloquium evocandis interponeret; id in senatu nostro nunc <lb xml:id="p1z18"/>agitur, ut audio, summo studio.</s>
					<s n="9" xml:lang="la">Heri a vicino meo, quem <lb xml:id="p1z19"/>d. d. <persName ref="p8111">Martyr</persName> novit, audivi <persName ref="p18575">Philippum</persName> regem Errico 60 <lb xml:id="p1z20"/>coronatorum millia permunerasse, ut sibi <persName>Rhingraffum</persName> habere <lb xml:id="p1z21"/>liceret, pactis legibus, ne in carcerem coniiceretur neve <lb xml:id="p1z22"/>perpetuo captivus haberetur.</s>
					<s n="10" xml:lang="la"><placeName>Bolvillani</placeName> milites accepta <lb xml:id="p1z23"/>pecunia in <placeName ref="l832">Galliam</placeName> magnis itineribus regi <persName>Henrico</persName> <lb xml:id="p1z24"/>militatum proficiscuntur.</s>
					<s n="11" xml:lang="la">Hic aliud fere nihil per urbis <lb xml:id="p1z25"/>vias occurrit.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">De colloquio dominus <persName ref="p20363">Peucerus</persName> mihi scribit <lb xml:id="p1z26"/>spei non multum superesse, adversarios tam abrumpi <lb xml:id="p1z27"/>nolle, sed muginari.</s>
					<s n="13" xml:lang="la">Dominus Iesus theologis, quos ego <lb xml:id="p1z28"/>illic vidi, animum et fortitudinem adaugeat teque ecclesiae <lb xml:id="p1z29"/>suae quam diutissime incolumem conservet.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Mi venerande <lb xml:id="p1z30"/>pater, vale et salve.</s>
					<s n="15" xml:lang="la">13. calendas decembris 1557.</s>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>theologo praestantissimo et <lb xml:id="p2z4"/>pastori ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z5"/>fidelissimo.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
