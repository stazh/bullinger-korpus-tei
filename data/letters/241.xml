	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. <lb xml:id="p1z2"/>P.</s>
					<s n="2" xml:lang="la">Vicesimo huius mensis secundo <placeName ref="l491">Argentinam</placeName> reliquit vir integerrimus, <lb xml:id="p1z3"/>amicus noster communis et singularis D. <persName ref="p1548">Richardus Hillis</persName> una cum <lb xml:id="p1z4"/>uxore pia et liberis charis <placeName ref="l830">Angliam</placeName> versus profecturus.</s>
					<s n="3" xml:lang="la">Heri primum <lb xml:id="p1z5"/>allatae sunt tuae literae, vir praestantissimae, quas, ut iusserat discedens, <lb xml:id="p1z6"/>aperui et perlegi.</s>
					<s n="4" xml:lang="la">Librum et literas ad <placeName ref="l1255">Cantuariensem</placeName> per impurum <lb xml:id="p1z7"/>Iudaeum <persName ref="p41">Michaelem Adam</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p41">Michael Adam</persName>.</note> missas dudum et accepimus et tuto ad eundem <lb xml:id="p1z8"/>misimus.</s>
					<s n="5" xml:lang="la">Iudeus vero fefellit meam expectationem multo; a me acce<lb xml:id="p1z9"/>pit mutuo tres florenos, a domino <persName ref="p1548">Richardo</persName> me absente et inscio <lb xml:id="p1z10"/>octo daleros.</s>
					<s n="6" xml:lang="la">Hinc discessit paulo post nundinas, sed tamen, quod <lb xml:id="p1z11"/>audio, quum prius per aleam magnam pecuniae vim amisisset; itaque <lb xml:id="p1z12"/>haec nostra, ni fallor, perdita sunt, nisi forsan apud vos aliquid <lb xml:id="p1z13"/>remanet, quocum et vestrates et nos possemus resolvi.</s>
					<s n="7" xml:lang="la">Si quid <lb xml:id="p1z14"/>est, oro, ut nos iuves.</s>
					<s n="8" xml:lang="la">Iactitavit <persName ref="p4851">Froschouerum</persName> ei daturum <lb xml:id="p1z15"/>florenos centum pro libro ab Hebraisimo verso; sed haec forsan <lb xml:id="p1z16"/>vera non sunt.</s>
					<s n="9" xml:lang="la">Age nostro nomine, quicquid potes, si quid spei sit <lb xml:id="p1z17"/>rel[i]quum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">De <placeName ref="l257">Constantiensium</placeName> clade dolemus valde, multo tamen <lb xml:id="p1z18"/>magis, quod victores quum sint, de defectione cogitent.</s>
					<s n="11" xml:lang="la">Dominus <lb xml:id="p1z19"/>Iesus Christus nostri omnium misereatur!</s>
				</p>
				<p>
					<s n="12" xml:lang="la">De statu <placeName ref="l830">Angliae</placeName> <lb xml:id="p1z20"/>nihildum accepimus neque quicquam de D. <persName ref="p8041">Ioanne a Lasco</persName>; <lb xml:id="p1z21"/>si quid intellexero, audies.</s>
					<s n="13" xml:lang="la">Incerta est de <placeName ref="l2524">Scotis</placeName> et <placeName ref="l830">Anglis</placeName> <lb xml:id="p1z22"/>fama; quare ea praetereo, usque dum certius quid audiatur.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z23"/>D. <persName ref="p1548">Richardus</persName> et uxor discessuri mandarunt, ut te tua[m]que et <lb xml:id="p1z24"/>liberos quam officiosissime salutarem, doctos item universos <lb xml:id="p1z25"/>ecclesiae vestrae.</s>
					<s n="15" xml:lang="la">Libellum, quem iam accepi, per proximam <lb xml:id="p1z26"/>occasionem commodam ad eum mittam, summam item liter<lb xml:id="p1z27"/>arum tuarum meis inscribam; ita enim praecepit et de tuis et <lb xml:id="p1z28"/>de aliorum omnibus.</s>
					<s n="16" xml:lang="la" ana="salute">Resalutatus es a mea quam diligentissime cum <lb xml:id="p1z29"/>uxore, liberis et familia.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Dominus vos quam diutissime con<lb xml:id="p1z30"/>stantes servet in confessione nominis domini nostri Iesu Christi et <lb xml:id="p1z31"/>nobiscum eandem gratiam impartiatur.</s>
					<s n="18" xml:lang="la">Amen.</s>
					<s n="19" xml:lang="la">Caesar, ut audio, <lb xml:id="p1z32"/>in dies <placeName ref="l471">Spirae</placeName> expectatur.</s>
					<s n="20" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z33"/>Tuus, quem nosti <persName ref="p505">I[oannes] B[urcherus</persName>].</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro D. <persName ref="p495">Bullingero</persName>, <lb xml:id="p2z2"/>amico colendo et <lb xml:id="p2z3"/>charo.</s>
					<s n="23" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
