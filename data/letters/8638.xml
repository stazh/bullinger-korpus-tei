	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Misi nuper nescio quas commendatitias, quibus <lb xml:id="p1z2"/>tamen ille, quem te conventurum existimabam, non <lb xml:id="p1z3"/>responderat.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Certiorem etiam te feci, quam immodeste <lb xml:id="p1z4"/><persName ref="p20473">Gantnerus</persName> et <persName>Marius</persName> sese gererent.</s>
					<s n="4" xml:lang="la" ana="salute">Convenit ex <lb xml:id="p1z5"/>eo tempore, quo synodus dilapsa est, suae faction s <lb xml:id="p1z6"/>homines in <placeName ref="l520">Valle Telina</placeName> <persName>Marius</persName>, et salutato <persName ref="p6860">Turriano</persName> <lb xml:id="p1z7"/>nescio quid monstri alere videntur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><persName ref="p20473">Gantnerus</persName> <lb xml:id="p1z8"/>vocatus et rogatus in senatu, num cedere vellet <lb xml:id="p1z9"/>victus et subscriptionem manu propria factam <lb xml:id="p1z10"/>confirmare, negavit et potius omnibus renunciaturum <lb xml:id="p1z11"/>dixit quam nostrae esse sententiae.</s>
					<s n="6" xml:lang="la">Idcirco a senatu <lb xml:id="p1z12"/>civitate privatus est.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Nunc rostra crepat et concursans <lb xml:id="p1z13"/>querulus omnem movet lapidem, ut populi favore <lb xml:id="p1z14"/>tutus sit etc.</s>
					<s n="8" xml:lang="la">Mitto adhaec quaedam nudiustertius a d. <lb xml:id="p1z15"/><persName ref="p8089">Lentulo</persName> ad me missa.</s>
					<s n="9" xml:lang="la" ana="farewell">Hisce vale, colendissime d. pater.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/>De caeteris alias; nunc morbus uxoris gravis [me] <lb xml:id="p1z17"/>vocat alio.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Ocyssime 1571 14. augusti.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Tuae <lb xml:id="p1z18"/>domination<lb xml:id="p1z19"/>i subiectissimus <lb xml:id="p1z20"/><persName ref="p8016">Th[obias] <lb xml:id="p1z21"/>Ic[o<lb xml:id="p1z22"/>nius</persName>].</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z23"/>Salutant te nostri omnes.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo praeclarissimoque viro <lb xml:id="p2z2"/>d. d. <persName ref="p495">H. Bullinger</persName>o, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae antistiti primario, <lb xml:id="p2z4"/>d. suo venerandissimo.</s>
					<s n="15" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
