	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto ad te, que antea te puto intellexisse ex <placeName ref="l822">Germania</placeName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">D. conestabilis <lb xml:id="p1z2"/>et alii deputati nunc sunt una, ut conferant de pacis conditionibus; <lb xml:id="p1z3"/>ea a domini voluntate pendet.</s>
					<s n="4" xml:lang="la">Expecto pecuniam, quę capitaneis promissa <lb xml:id="p1z4"/>est.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Filium tibi et amicis commendo et me illorum precibus.</s>
					<s n="6" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l760">Sol[u<lb xml:id="p1z5"/>turi]</placeName> 3. februarii.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z6"/>Tuus, quem nosti.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henricho Bullingero</persName>.</s>
				</p>
			</div>
		</body>
	</text>
