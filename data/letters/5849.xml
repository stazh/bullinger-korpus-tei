	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Incredibilis et intolleranda est <persName>Pagorum</persName> nostrorum <lb xml:id="p1z2"/>insolentia.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Victorias suas in <placeName ref="l832">Gallia</placeName> partas ad astra <lb xml:id="p1z3"/>usque evehunt.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><placeName ref="l832">Gallos</placeName> illos haereticos factos, fortes alio<lb xml:id="p1z4"/>qui, Germanos item equites, et iam <placeName ref="l830">Anglorum</placeName> <lb xml:id="p1z5"/>gentem indomitam fugarunt, fuderunt et vicerunt, <lb xml:id="p1z6"/>inquiunt, nostri milites, licet pauci sint numero: <lb xml:id="p1z7"/>unde claret, religionem vel fidem nostram, quam defendere <lb xml:id="p1z8"/>et in <placeName ref="l832">Gallia</placeName> incolumem conservare satagimus, <lb xml:id="p1z9"/>veram et victricem esse fidem, requirique a nobis <lb xml:id="p1z10"/>ut illam putidam haeresim ubique et in omnibus <lb xml:id="p1z11"/>haereticis persequamur, neque unquam tam victoriosam <lb xml:id="p1z12"/>fidem deseramus etc.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Proinde rem fecisti nobis omni<lb xml:id="p1z13"/>bus gratissimam qui significaris ultimis tuis <lb xml:id="p1z14"/>literis regem deditione Portum gratiae recepisse.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Ideoque gratias agimus tibi pro literis illis 12 huius <lb xml:id="p1z16"/>mensis scriptis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Studiosi illi mature reddiderunt.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Possumus ex illis respondere iis quos <persName>Pagi</persName> vana sua <lb xml:id="p1z18"/>iactatione dementare conantur.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Atque utinam describat <lb xml:id="p1z19"/>aliquando <persName ref="p8078">Ionvilleus</persName> noster omnem historiam recu<lb xml:id="p1z20"/>perationis illius paulo copiosius.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Fama enim est <lb xml:id="p1z21"/>plures utrinque ante deditionem occubuisse, multos <lb xml:id="p1z22"/>etiam ex militbus Helveticis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><persName ref="p1227">Froschouerus</persName> iunior <lb xml:id="p1z23"/>accepit responsionem Admiraldi ad confessa <persName>Pultroti</persName> <lb xml:id="p1z24"/>et promisit se impressurum, si non in hac urbe, <lb xml:id="p1z25"/>saltem alibi.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Sero tamen satis absolvit illam <lb xml:id="p1z26"/>interpres.</s>
					<s n="13" xml:lang="la">Ubi exempla accepero, unum et alterum ad <lb xml:id="p1z27"/>vos mittam.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Quod autem praeterita aestate futurum <lb xml:id="p1z28"/>dixi, id iam factum esse denuncio.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Dixi principem <lb xml:id="p1z29"/>Wirtenbergensem diligenter laborare ut <lb xml:id="p1z30"/>aliquibus in <placeName ref="l832">Gallia</placeName> <persName ref="p458">Brentii</persName> doctrinam de coena <lb xml:id="p1z31"/>et ubiquitate obtrudat atque commendet.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Iam vero <lb xml:id="p1z32"/>in haec verba scribit <placeName ref="l512">Tubinga</placeName> amicus quidam: <lb xml:id="p1z33"/>Princeps paucis ante diebus hic fuit, duxit secum principem <lb xml:id="p1z34"/>quendam Lituanum admodum puerum, quem aiunt <lb xml:id="p1z35"/><placeName ref="l491">Argentinae</placeName> operam literis daturum.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Inter coenandum dixit <lb xml:id="p1z36"/><placeName ref="l572">Wirtembergensis</placeName> se vehementer mirari quod Zvinglianis <lb xml:id="p1z37"/>inter alia de coena dogmata id maxime videatur ab<lb xml:id="p1z38"/>surdum quod deus esse dicitur in omni herba, saxo <lb xml:id="p1z39"/>atque etiam in diabolo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Adfuit tunc quoque tuus ille <persName ref="p458">Brentius</persName>, <lb xml:id="p1z40"/>qui dicitur novum contra te librum scribere, aut etiam <lb xml:id="p1z41"/>iam absolvisse.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Catechesis <persName ref="p458">Brentiana</persName> de qua <lb xml:id="p1z42"/>hac aestate tibi scripsi, iam dudum et versa est <lb xml:id="p1z43"/>in <placeName ref="l832">Gallicam</placeName> et impressa.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Exemplaria ad unum omnia <lb xml:id="p1z44"/>iussu principis ad ipsum sunt missa, eorumque circiter <lb xml:id="p1z45"/>200 in hac civitate colligata, quae missa sunt in <placeName ref="l832">Galliam</placeName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z46"/>Submittentur et plura alia impensis principis.</s>
					<s n="22" xml:lang="la">Conatur <pb/><lb xml:id="p2z1"/>hic modis omnibus crassam illam <persName ref="p1974">Lutheri</persName> <lb xml:id="p2z2"/>doctrinam de coena contra <persName ref="p4091">Zvinglium</persName>, <persName ref="p2442">Oecolapadium</persName> et <lb xml:id="p2z3"/><persName ref="p540">Calvinum</persName> in <placeName ref="l832">Gallicas</placeName> invehere ecclesias.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Utinam <lb xml:id="p2z4"/>conatus illius inanes redeant, et ne dissidium <lb xml:id="p2z5"/>aliquod excitet in <placeName ref="l832">Gallia</placeName> quod cursum evangelii ut in <lb xml:id="p2z6"/><placeName ref="l822">Germania</placeName> impediat etc.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Haec ex <placeName ref="l512">Tubinga</placeName><lb xml:id="p2z7"/>.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p2z8"/>Putavi autem ex officio meo esse hoc tibi serio <lb xml:id="p2z9"/>et mature indicare, ut pro tua vigilantia et <lb xml:id="p2z10"/>diligentia pravis obvies conatibus.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">Praeterea <lb xml:id="p2z11"/>quod scribam in praesenti non habeo.</s>
					<s n="27" xml:lang="la" ana="salute">Omnes <lb xml:id="p2z12"/>nostri te una cum tuis omnibus salvere iubent.</s>
				</p>
				<p>
					<s n="28" xml:lang="la" ana="salute"><lb xml:id="p2z13"/>Singulariter autem <persName ref="p8078">Ionvilleum</persName> nostrum humanissime <lb xml:id="p2z14"/>salutabis.</s>
