	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia Christi tecum.</s>
					<s n="2" xml:lang="la">Quum fueris adeo sollicitus, <lb xml:id="p1z2"/>domine et frater <persName ref="p495">Bullingere</persName> in Christo semper <lb xml:id="p1z3"/>obervande, pro mea salute ac valetudine, <lb xml:id="p1z4"/>quod in confesso tuis ex litteris colligo, non <lb xml:id="p1z5"/>potui non certiorem te facere praesentis status <lb xml:id="p1z6"/>qualique corporis constitutione degam <lb xml:id="p1z7"/>Abacta febre iam lento incedens gradu <lb xml:id="p1z8"/>aliquousque promoveo, tametsi non longius quam <lb xml:id="p1z9"/>ad templum, qui vix decem passus abest aedibus, <lb xml:id="p1z10"/>quas inhabito.</s>
					<s n="3" xml:lang="la">Non satis firmus sum manibus <lb xml:id="p1z11"/>pedibusque, propterea nondum stans d<lb xml:id="p1z12"/>eclamo, sed potius sedens animad<lb xml:id="p1z13"/>verto.</s>
					<s n="4" xml:lang="la">Consulunt phisici omnes concorditer thermas <lb xml:id="p1z14"/><placeName>Cellenses</placeName>, quę certe frigent et nonnisi <lb xml:id="p1z15"/>igne calefiunt.</s>
					<s n="5" xml:lang="la">Quodsi propitium <lb xml:id="p1z16"/>numen me non exemerit rebus humanis <lb xml:id="p1z18"/>post hybernos menses potius ad vos concederem, <lb xml:id="p1z19"/>ubi aquę natura sunt calidę.</s>
					<s n="6" xml:lang="la">Tum te cum reliqu<lb xml:id="p1z20"/>is fratribus salutarem; fiat domini voluntas.</s>
					<s n="7" xml:lang="la">Amen.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z21"/>Constans dissipatur fama <persName>Gallum</persName> a Caesareanis <lb xml:id="p1z22"/>esse superatum; sed ea fama solum <lb xml:id="p1z23"/>ab iis, qui Caesaris studiosi sunt, spargitur.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z24"/>Discordia inter ministros Christi et papę s<lb xml:id="p1z25"/>acrificos <placeName ref="l491">Argento<lb xml:id="p1z26"/>ratenses</placeName> coorta nedum penitus sedata; magistratus, qui <lb xml:id="p1z27"/>utcunque papicolis favet, male illis feriatis <lb xml:id="p1z28"/>nimium indulget.</s>
					<s n="10" xml:lang="la">Metuitur seditio.</s>
					<s n="11" xml:lang="la">D. <persName ref="p8466">Wolfgangus <lb xml:id="p1z29"/>Wissenburgius</persName> et <persName ref="p3099">Sultzerus</persName> <placeName ref="l491">Argentorati</placeName> studuerunt <lb xml:id="p1z30"/>negotium componere et redeuntes apud me fuerunt.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z31"/>Ego vero benignum deum oro, id quod incumbit <lb xml:id="p1z32"/>etiam omnibus piis, ut Satan quamprimum conteratur <lb xml:id="p1z33"/>sub pedibus bonorum virorum etc.</s>
					<s n="13" xml:lang="la" ana="farewell">Hisce vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z34"/>Raptim <placeName ref="l411">Richenvillę</placeName> 12. octobris 1554.</s>
					<s n="15" xml:lang="la" ana="salute">Salutabis <lb xml:id="p1z35"/>pręterea omnes fratres nominatim, inprimis tuam familiam.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z36"/>Salutant te nostri, presertim <persName ref="p8088">Regius</persName> ille, qui coram, <lb xml:id="p1z37"/>dum ista scribo etc.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">T[uus] <lb xml:id="p1z38"/><persName ref="p1010">Erbius</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute"><lb xml:id="p1z39"/>Salutabis et <pb/><lb xml:id="p2z1"/>senem <persName>Iacobum Schmid</persName>, nostri <lb xml:id="p2z2"/><persName ref="p8009">Fabritii</persName> Anchisen atque paren<lb xml:id="p2z3"/>tem, nostro nomine.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Eximio <lb xml:id="p2z4"/>viro pietate ac eruditione d. <persName ref="p495">Henryc<lb xml:id="p2z5"/>ho Bullingero</persName>, ecclesię <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z6"/>antistiti vigilantissimo etc.</s>
				</p>
			</div>
