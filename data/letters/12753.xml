	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Das Jahr ergibt sich aus dem Briefinhalt.</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi pridie<note xml:id="fn2" type="footnote" n="2">Mit <ref target="file12748">Nr. 2701</ref> vom 4. Dezember. -Daraus folgt, dass Brief <ref target="file12748">Nr. 2701</ref> <placeName ref="l18">Augsburg</placeName> wahrscheinlich erst am 5. Dezember verließ.</note> per <persName ref="p7125">Ioannis Albini</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p7125">Hans Wyss</persName>.</note> famulum<note xml:id="fn4" type="footnote" n="4">Unbekannt.</note> copiosius <lb xml:id="p1z2"/>aliquantum de singulis rebus.</s>
					<s n="3" xml:lang="la">Nunc autem, quoniam alius <lb xml:id="p1z3"/>se mihi non incommodus offert nuncius<note xml:id="fn5" type="footnote" n="5">Unbekannt.</note>, non possum non <lb xml:id="p1z4"/>iterum scribere, quid his diebus acceperim novi.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Quia enim haec tibi grata scio esse officia, libenter tibi <lb xml:id="p1z6"/>inservio.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="5" xml:lang="la">Rumor apud plaerosque adhuc constans est <lb xml:id="p1z7"/>obiisse <persName ref="p18538">caesarem</persName>.<note xml:id="fn6" type="footnote" n="6"><persName ref="p18538">Karl V.</persName> - Zu diesem falschen Gerücht s. die Verweise in <ref target="file12747">Nr. 2700</ref>, Anm. 20.</note></s>
					<s n="6" xml:lang="la"><persName ref="p8417">Musculus</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p8417">Wolfgang Musculus</persName>.</note> heri cum <persName ref="p2916">Schertlio</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p2916">Sebastian Schertlin von Burtenbach</persName>.</note> pransus <lb xml:id="p1z8"/>etiam ipsum hoc verum esse suspicari mihi dixit.</s>
					<s n="7" xml:lang="la">Utitur coniectura, <lb xml:id="p1z9"/>quod <persName ref="p18604">Bavariae dux</persName><note xml:id="fn9" type="footnote" n="9">Herzog <persName ref="p18604">Wilhelm IV. von Bayern</persName>.</note> nigri panni magnam copiam ex <lb xml:id="p1z10"/><placeName ref="l18">Augusta</placeName> accersivit.</s>
					<s n="8" xml:lang="la">Ego vereor, ne pfafforum sit praestigi<lb xml:id="p1z11"/>osum commentum.<pb type="edition" next="375"/></s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="9" xml:lang="la">Hodie, cum consule <persName ref="p6186">Rhelingero</persName><note xml:id="fn10" type="footnote" n="10"><persName ref="p6186">Wolfgang Rehlinger</persName>, Altbürgermeister. Zu seiner politischen Haltung s. <bibl source="b19">HBBW XVI</bibl> 77, Anm. 9; XVII 308, Anm. 29.</note>, <lb xml:id="p1z12"/>viro septuagenario et iam emerito, una cum <persName ref="p8417">Musculo</persName> <lb xml:id="p1z13"/>cum pranderem, audio etiam alias recenseri coniecturas: <lb xml:id="p1z14"/><persName ref="p7840">Episcopum</persName> scilicet <placeName ref="l18">Augustanum</placeName><note xml:id="fn11" type="footnote" n="11">Kardinal <persName ref="p7840">Otto Truchsess von Waldburg</persName>.</note>, doctorem <persName ref="p7689">Naves</persName><note xml:id="fn12" type="footnote" n="12">Reichsvizekanzler <persName ref="p7689">Johann von Naves</persName>.</note>, <persName ref="p19043">Fuggerum</persName><note xml:id="fn13" type="footnote" n="13"><persName ref="p19043">Anton Fugger</persName>, der ab Januar 1547 eine führende Rolle bei den <placeName ref="l18">Augsburger</placeName> Aussöhnungsverhandlungen mit dem Kaiser einnahm; s. Hermann Joseph <hi>Kirch,</hi> Die Fugger und der Schmalkaldische Krieg, München/Leipzig 1915 - Studien zur Fugger-Geschichte 5, S. 117-138.</note> <lb xml:id="p1z15"/>et <persName ref="p4249">Bomgartnerum</persName><note xml:id="fn14" type="footnote" n="14">Vermutlich <persName ref="p4249">Hans Baumgartner</persName>; vgl. <bibl source="b20">HBBW XVII</bibl> 322, Anm. 94.</note> nostrum <placeName ref="l360">Noͤrdlingae</placeName> (quae a caesarean<lb xml:id="p1z16"/>is sponte se offerentibus et tradentibus se illis capta est)<note xml:id="fn15" type="footnote" n="15">Zur Ergebung <placeName ref="l360">Nördlingens</placeName> s. <ref target="file12747">Nr. 2700</ref>, Anm. 7.</note> agere clam, <lb xml:id="p1z17"/>si quibus rationibus (ne quam faciant suorum debitorum <lb xml:id="p1z18"/>aerisque elocati iacturam)<note xml:id="fna" type="footnote" n="a"><hi>Klammern ergänzt.</hi></note> queant <persName ref="p18477">Perdiandum</persName><note xml:id="fnb" type="footnote" n="b"><hi>In der Vorlage hat <persName ref="p8018">Haller</persName> absichtlich</hi> Ferdinandum <hi>in</hi> Perdiandum <hi>geändert, indem er aus dem</hi> F <hi>ein</hi> P <hi>machte und das erste</hi> n <hi>senkrecht durchstrich. Damit liegt wohl eine Anspielung auf</hi> perdendum <hi>vor.</hi></note><note xml:id="fn16" type="footnote" n="16">König <persName ref="p18477">Ferdinand I.</persName></note> facere <placeName ref="l18">Augustum</placeName><note xml:id="fn17" type="footnote" n="17"><placeName ref="l425">Römischer</placeName> Kaiser, im Gegensatz zum "Semper Augustus", mit dem der Kaiser bezeichnet wird.</note> <lb xml:id="p1z19"/><persName ref="p18604">ducemque Bavariae</persName> Caesarem.</s>
					<s n="10" xml:lang="la"><persName ref="p7459">Bürensem</persName> comitem<note xml:id="fn18" type="footnote" n="18"><persName ref="p7459">Maximilian von Egmont</persName>, Graf von <placeName ref="l2126">Büren</placeName>.</note> etiam esse <lb xml:id="p1z20"/>famam deferre cadaver caesaris ad <placeName ref="l20">Inferiorem Germaniam</placeName><lb xml:id="p1z21"/>,<note xml:id="fn19" type="footnote" n="19">Ein falsches Gerücht, das auch im Brief des Rates von <placeName ref="l257">Konstanz</placeName> an den Rat von <placeName ref="l587">Zürich</placeName>, 16. Dezember (s. Zürich StA, A 177, Nr. 153), und <bibl source="b480">PC</bibl> IV/I 515, Nr. 483, zu finden ist.</note> ut ibi, ubi natus est<note xml:id="fn20" type="footnote" n="20">D.h. <placeName ref="l168">Gent</placeName>.</note>, sepeliatur iterum.</s>
					<s n="11" xml:lang="la">Certum enim <lb xml:id="p1z22"/>est magnopere festinare <persName ref="p7459">Bürensem</persName> ad <placeName ref="l640">Flandriam</placeName> suam.<note xml:id="fn21" type="footnote" n="21"><persName ref="p7459">Von Büren</persName>, der mit dem Kaiser am 3. Dezember nach <placeName ref="l1521">Rothenburg ob der Tauber</placeName> gelangt war, brach mit seinem Heer am 12. Dezember von dort auf. Am 13. nahm er Burg <placeName ref="l3375">Boxberg</placeName> (<placeName ref="l3374">Main-Tauber-Kreis</placeName>, <placeName ref="l572">Baden-Württemberg</placeName>) ein. Dann zog er vermutlich nach <placeName ref="l1879">Tauberbischofsheim</placeName> und <placeName ref="l1782">Miltenberg</placeName>, von da in die Grafschaft <placeName ref="l953">Erbach</placeName>, wo er sich im Schloss <placeName ref="l3376">Fürstenau</placeName> (<placeName ref="l2371">Michelstadt</placeName>) einquartierte und von wo aus seine Truppen einen Vorstoß bis nach <placeName ref="l2372">Beerfelden</placeName> (etwa 38 km von <placeName ref="l210">Heidelberg</placeName>) machten. Er wandte sich dann <placeName ref="l1779">Darmstadt</placeName> zu, das er am 22. Dezember einnahm. Von dort zog er vor <placeName ref="l157">Frankfurt am Main</placeName>, das sich am 24. ergab und am 29. für mehrere Monate von den kaiserlichen Truppen besetzt wurde; s. <ref target="file12748">Nr. 2701</ref>, Anm. 34; <bibl source="b480">PC</bibl> IV/I 520f, Nr. 487; Carl <hi>Arnd,</hi> Geschichte der Provinz Hanau und der untern Maingegend, Hanau 1858, S. 171; <bibl source="b280">Hasenclever, Kurpfalz</bibl> 144-146; Ludwig <hi>Schnurrer,</hi> Kaiser Karl V. in Rothenburg im Dezember 1546, in: Die Linde 56/3, 1974, 20; Hans-Michael <hi>Möller,</hi> Reichswirren, Stadtpolitik und Kriegsregiment. Frankfurt in der Krise 1546-47, in: Archiv für Frankfurts Geschichte und Kunst 55, 1976, 39-66.</note></s>
					<s n="12" xml:lang="la">Cer<lb xml:id="p1z23"/>tum est etiam hoc: A caesareanis nihil prorsus fieri eosque per<lb xml:id="p1z24"/>mittere electorem<note xml:id="fn22" type="footnote" n="22"><persName ref="p19065">Johann Friedrich I. von Sachsen</persName>. - Zu dessen Route s. <ref target="file12747">Nr. 2700</ref>, Anm. 5.</note> pro voto vastare episcopatum <placeName ref="l1030">Herbi<lb xml:id="p1z25"/>polensem</placeName> et <placeName ref="l1703">Pabergensem</placeName>.<note xml:id="fn23" type="footnote" n="23">Die Bistümer <placeName ref="l1030">Würzburg</placeName> und <placeName ref="l1703">Bamberg</placeName>.</note></s>
					<s n="13" xml:lang="la">Unde colligunt caesarem mortuum; alioqui <lb xml:id="p1z26"/>eum non permissurum occupari loca haec commodissima <lb xml:id="p1z27"/>et frugum <pb type="edition" next="376"/> copia et situ ad restaurandum bellum.</s>
					<s n="14" xml:lang="la">Fertur <lb xml:id="p1z28"/>enim electorem iamiam cepisse <placeName ref="l1962">Mergidden</placeName><note xml:id="fn24" type="footnote" n="24"><placeName ref="l1962">Bad Mergentheim</placeName> (<placeName ref="l3374">Main-Tauber-Kreis</placeName>, <placeName ref="l572">Baden-Württemberg</placeName>), 40 km südlich von <placeName ref="l1030">Würzburg</placeName>, damals Dienstsitz des Deutschen Ordens. - Hier liegt erneut ein falsches Gerücht vor.</note>, ditissimum Teu<lb xml:id="p1z29"/>tonicorum collegium, ipsamque <placeName ref="l1030">Herbipolim</placeName>.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="15" xml:lang="la"><persName ref="p18250">Dux Mauritius</persName> <lb xml:id="p1z30"/><placeName ref="l558">Wittenbergam</placeName> obsedit primoque impetu murum <lb xml:id="p1z31"/>expugnare aggressus vi recusus discessit re infecta.<note xml:id="fn25" type="footnote" n="25">Herzog <persName ref="p18250">Moritz von Sachsen</persName> hatte <placeName ref="l558">Wittenberg</placeName> schon am 18. November erfolglos angegriffen; s. dazu Nr. 2695, Anm. 7. Daraufhin zog er noch einmal in die Umgebung von <placeName ref="l558">Wittenberg</placeName>, um die Stadt zu isolieren. Davon berichten jedoch nur wenige Zeugnisse; s. <hi>Voigt, <persName ref="p18250">Moritz</persName></hi> 232f mit Anm. 3. Dabei richtete <persName ref="p18250">Moritz</persName> sein Hauptquartier in <placeName ref="l2373">Zahna</placeName> ein (etwa 25 km südwestlich von <placeName ref="l558">Wittenberg</placeName>); s. ebd., S. 234. Dieser zweite Zug in Richtung <placeName ref="l558">Wittenberg</placeName> muss kurz vor dem 1. Dezember erfolgt sein, da <persName ref="p2095">Melanchthon</persName> an diesem Tag berichtet <hi>(MBW-T</hi> XV 561, Nr. 4478), dass <persName ref="p18250">Moritz</persName> wieder ein Heer in die Gegend von <placeName ref="l558">Wittenberg</placeName> geführt habe, mit einer Belagerung aber wohl bis zum Ende des Landtages am 6. Dezember abwarten werde. Am 7. meldete <persName ref="p2095">Melanchthon</persName> (aaO, 571, Nr. 4487), dass <placeName ref="l558">Wittenberg</placeName> noch nicht belagert sei. Dann teilte er am 11. mit (aaO, 573, Nr. 4489), dass er soeben von der Belagerung <placeName ref="l558">Wittenbergs</placeName> gehört habe. Am 20. schrieb er (aaO, 597, Nr. 4505), dass die <placeName ref="l882">ungarischen</placeName> Reiter umherschweiften, Grausamkeiten verübten sowie die Versorgung der Stadt blockierten. Am 21. (aaO, 600, Nr. 4506) sprach er die dortige Lebensmittelknappheit an und hoffte auf eine baldige Befreiung der Stadt. Schließlich konnte er am 29. Dezember den Abzug der feindlichen Truppen aus <placeName ref="l558">Wittenbergs</placeName> Umgebung melden (aaO, 627f, Nr. 4524f), der laut <hi>Voigt, <persName ref="p18250">Moritz</persName></hi> 236, am 26. erfolgt war.</note></s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z32"/>Elector omnem, quem nostri universi habuere, equitatum secum <lb xml:id="p1z33"/>ducit<note xml:id="fn26" type="footnote" n="26">Laut einem Brief des <placeName ref="l157">Frankfurter</placeName> Rats vom 17. Dezember <hi>(PC</hi> IV/I 522, Nr. 489) soll der Kurfürst den größten Teil des Geschützes sowie die landgräflichen Reiter behalten haben.</note> exceptis 200 equitibus cum <persName ref="p3590">langrafio</persName><note xml:id="fn27" type="footnote" n="27"><persName ref="p3590">Philipp von Hessen</persName>. - Zu seinem Rückweg über <placeName ref="l496">Stuttgart</placeName> s. <ref target="file12749">Nr. 2702</ref>, Anm. 21.</note> <placeName ref="l496">Stugardiam</placeName> <lb xml:id="p1z34"/>profectis.</s>
					<s n="17" xml:lang="la">Hodie fertur etiam langrafium cum 12 tantum caballis <lb xml:id="p1z35"/>properare ad regem <placeName ref="l832">Galliae</placeName>.<note xml:id="fn28" type="footnote" n="28"><persName ref="p20225">Franz I.</persName> - Ein falsches Gerücht.</note></s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="18" xml:lang="la">Haec, sicuti audivi, <lb xml:id="p1z36"/>incerta volui tibi communicare.</s>
					<s n="19" xml:lang="la">Certiora si habuero, dabo qu<lb xml:id="p1z37"/>oque.</s>
					<s n="20" xml:lang="la" ana="farewell">Vale.</s>
					<s n="21" xml:lang="la">Festinantissime ex meo musaeo, <lb xml:id="p1z38"/>6. decembris.</s>
					<s n="22" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p8018">Ioannes Hallerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, venerando <lb xml:id="p2z4"/>suo patri.</s>
					<s n="24" xml:lang="de"><lb xml:id="p2z5"/>M. <persName ref="p495">Heinrych Bul<lb xml:id="p2z6"/>linger</persName> zuͦ <placeName ref="l587">Zürich</placeName> <lb xml:id="p2z7"/>in yl zuͦ überant<lb xml:id="p2z8"/>worten.</s>
				</p>
			</div>
		</body>
	</text>
