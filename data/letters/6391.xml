	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><persName>Balthesari</persName> ad vos proficiscenti non potui nihil <lb xml:id="p1z2"/>literarum dare, cum praesertim hodie a te mihi <lb xml:id="p1z3"/>reddita sit epistola amoris benevolentiaeque plena.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Hoc mihi in caeteris meis molestiis incommodisque <lb xml:id="p1z5"/>longe gratissimum accidit, quod te virum bonum <lb xml:id="p1z6"/>bonis omnibus artibus illustrem in dies mihi <lb xml:id="p1z7"/>amiciorem experior.</s>
					<s n="4" xml:lang="la">Non invitus fateor, laetus <lb xml:id="p1z8"/>sum me tuo iudicio ornari atque id praecipui beneficii <lb xml:id="p1z9"/>loco habeo, ut mihi sedula in posterum navandi <lb xml:id="p1z10"/>sit opera, uti quicquid iudicii officiique in me <lb xml:id="p1z11"/>contuleris, bene positum arbitrere.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Gratiam habeo, <lb xml:id="p1z12"/>quod me de rebus <placeName ref="l822">Germanicis</placeName> certiorem facis; <lb xml:id="p1z13"/>nihil illic magni motus metuendum videtur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>De classe <placeName ref="l2510">Turcica</placeName> multorum sermone et <lb xml:id="p1z15"/>epistolis compertum habeo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Res nostrae in <lb xml:id="p1z16"/><placeName ref="l832">Gallia</placeName> satis bono loco sunt.</s>
					<s n="8" xml:lang="la">Rex <placeName ref="l1250">Tholosae</placeName> agit, <lb xml:id="p1z17"/>ubi multum est, quod agat.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Deus principis nostri adolescentiae <lb xml:id="p1z18"/>misericorditer adesse et christianum nomen, <lb xml:id="p1z19"/>te meque sua pace donare velit.</s>
					<s n="10" xml:lang="la" ana="salute">Bene vale, vir optime, <lb xml:id="p1z20"/>cui salutem plurimam, consulibus reique publicae vestrae, <lb xml:id="p1z21"/><persName ref="p8011">Gvaltero</persName> et <persName ref="p1283">Gesnero</persName> precor.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l98">Curia</placeName> kalendis martiis 1565.</s>
				</p>
				<p>
