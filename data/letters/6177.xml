	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nihil plane est (reverende in Christo pater) quod <lb xml:id="p1z2"/>scribam, et tamen inanes has mitto, ne <lb xml:id="p1z3"/>d. consulem absque meis ad te dimitterem.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Habes tu hic homines certos, per quos, si quid <lb xml:id="p1z5"/>aut <placeName ref="l41">Bernam</placeName>, <placeName ref="l167">Genevam</placeName> aut <placeName ref="l301">Lugdunum</placeName> scribere <lb xml:id="p1z6"/>velis, id commodissime et rectissime possis.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Est in comitatu d. consulis simul cum <persName>Pellizariis</persName> <lb xml:id="p1z8"/>clarissimus vir d. d. <persName>Guiziardus</persName>, qui <lb xml:id="p1z9"/>aliquando d. d. <persName ref="p1283">Gesnero</persName> et mihi hospitium <lb xml:id="p1z10"/>dedit Telii; itaque d. <persName ref="p1283">Gesnerus</persName> de illius adventu <lb xml:id="p1z11"/>videtur commonendus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quo loco res nostrae <lb xml:id="p1z12"/>sit, ex consule audies.</s>
					<s n="6" xml:lang="la">Tuas nullas dum accepi <lb xml:id="p1z13"/>propterea, quod mercatores nostri <placeName ref="l587">Tiguro</placeName> per <lb xml:id="p1z14"/><placeName ref="l2582">Feldkirchum</placeName> (quod ibi sit mercatus) redeunt; <lb xml:id="p1z15"/>hanc nos putamus esse morae causam.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>Scripsit proxime legatus d. <persName ref="p8160">de Bellievre</persName> spem magnam <lb xml:id="p1z17"/>esse negotium <placeName ref="l176">Glaronense</placeName> confectum iri.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Quod <lb xml:id="p1z18"/>utinam ita fiat aliquando!</s>
					<s n="9" xml:lang="la">Sed magna est hominum <lb xml:id="p1z19"/>illorum ferocia, quae an compesci possit, ut nunc <lb xml:id="p1z20"/>sunt mores hominum, dubito.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">D. consulem <lb xml:id="p1z21"/>non est quod commendem, cum sit commendatus <lb xml:id="p1z22"/>tibi alioquin.</s>
					<s n="11" xml:lang="la">Si quid acciderit, quod tua <lb xml:id="p1z23"/>scire intersit, non deero officio.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale, reverende <lb xml:id="p1z24"/>in Christo pater.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l98">Curię</placeName> 26. iunii anno 1564.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">T[uus] <persName ref="p8009">Fab[ricius</persName>]</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>domino suo et in <lb xml:id="p2z4"/>Christo patri reverendo.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
