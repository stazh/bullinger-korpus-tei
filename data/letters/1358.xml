	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/><persName ref="p8098">Georg, grave zu Würtemberg <lb xml:id="p1z2"/>und zu Mümpelgart</persName> etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="de"><lb xml:id="p1z3"/>Unnsern grus zuvor, lieber besonder.</s>
					<s n="3" xml:lang="de"><lb xml:id="p1z4"/>Wir haben die drey veldthüener sampt <lb xml:id="p1z5"/>den p ellelein, ir uns aus guter <lb xml:id="p1z6"/>wolmeinung bei zoügern dis zugeschickt, <lb xml:id="p1z7"/>entpfangen, bedancken uns deren <lb xml:id="p1z8"/>gantz gnädlich gegen euch.</s>
					<s n="4" xml:lang="de">Welche <lb xml:id="p1z9"/>uns dier zeit wol komen seind; dann <lb xml:id="p1z10"/>zwen von <placeName ref="l473">Sanct Gallen</placeName> euwern schwager <lb xml:id="p1z11"/>inn der badenfardt besucht, mit denenn <lb xml:id="p1z12"/>wir sampt ime dieselbigen (will gott) <lb xml:id="p1z14"/>mit freuden niessen wollen.</s>
					<s n="5" xml:lang="de"><lb xml:id="p1z15"/>Die büechlin, so wir euch zu geschickt, seind <lb xml:id="p1z16"/>uns auch behendiget worden.</s>
					<s n="6" xml:lang="de">Das <lb xml:id="p1z17"/>wellen wir euch guter mainung nitt <lb xml:id="p1z18"/>bergen.</s>
					<s n="7" xml:lang="de">Datum <placeName ref="l515">Urdorff</placeName> den 30. iulii <lb xml:id="p1z19"/>anno etc. 51.</s>
				</p>
				<p>
					<s n="8" xml:lang="de"><persName ref="p8098">G[<lb xml:id="p1z20"/>eorg] g[raf] z[u] Wyrtembe<lb xml:id="p1z21"/>rg</persName> etc.</s>
				</p>
				<p>
					<s n="9" xml:lang="de"><lb xml:id="p1z22"/>Hütt datt würt unß gschriben, das der kayser <lb xml:id="p1z23"/>noch zu <placeName ref="l18">Augspurg</placeName> sie; man höre auch von kainem <lb xml:id="p1z24"/>vereysen, sein verucken soll heimlicher gehalten <lb xml:id="p1z25"/>werden als nie.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><placeName ref="l303">Mäidenburg</placeName> litt <lb xml:id="p1z26"/><persName ref="p18538">Carolo</persName> ernstlich im sin; vernemen mir <lb xml:id="p1z27"/>däglichs.</s>
				</p>
				<p>
					<s n="11" xml:lang="de"><pb/><lb xml:id="p2z1"/>Unserm lieben besondern <lb xml:id="p2z2"/><persName ref="p495">Hainrich <lb xml:id="p2z3"/>Bullinger</persName>, <lb xml:id="p2z4"/>predigern zu <placeName ref="l587">Zürich</placeName><lb xml:id="p2z5"/>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>