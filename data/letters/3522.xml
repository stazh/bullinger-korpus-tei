	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Habeo magnam gratiam pro rebus novis, quas <lb xml:id="p1z2"/>ex amicorum literis mihi significasti, idque ut saepe, <lb xml:id="p1z3"/>ac quotiescunque graviores occupationes te non ret(inent), <lb xml:id="p1z4"/>modo aliquid habeas, facias rogo.</s>
					<s n="3" xml:lang="la">Ante <lb xml:id="p1z5"/>literas quoque eas acceperam, quibus de vestri magist<lb xml:id="p1z6"/>ratus circa indicenda vel no<lb xml:id="p1z7"/>n indicenda potius comitia deliberation(..<lb xml:id="p1z8"/>.) me certiorem faciebas.</s>
					<s n="4" xml:lang="la">Ac scito tamen a [me] <lb xml:id="p1z9"/>tum <placeName ref="l300">Lucernenses</placeName> tum alios quoque ex Confoe(deratis) <lb xml:id="p1z10"/>petivisse, ut ea, si possem, per <placeName ref="l587">Tigurinos</placeName> cura(rem) <lb xml:id="p1z11"/>indicenda.</s>
					<s n="5" xml:lang="la">Si nolint, ego spero per alios me ef(fecturum); <lb xml:id="p1z12"/>sed propter aliquas causas rem non putavi <lb xml:id="p1z13"/>nimis accelerandam.</s>
					<s n="6" xml:lang="la">Hic ex <placeName ref="l834">Italia</placeName> habe(mus) <lb xml:id="p1z14"/><persName ref="p7255">ducem Ferrariensem</persName> maxima damna <placeName ref="l1122">Parmens(i)</placeName> <lb xml:id="p1z15"/>intulisse multaque castella in eius ditione partim <lb xml:id="p1z16"/>vi partim deditione cepisse et inter ea unum <lb xml:id="p1z17"/>tum maximi momenti tum egregie munitum, (quo) <lb xml:id="p1z18"/>occupato totus ager <placeName ref="l1122">Parmensis</placeName> mirum in modum <lb xml:id="p1z19"/>infestatur.</s>
					<s n="7" xml:lang="la">Id ipse <persName ref="p7255">dux Ferrariensis</persName> mihi scrip(sit).</s>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Spero me habiturum successorem ita utrique <lb xml:id="p2z2"/>nostrum amicum, ut alia ratio, qua saepius <lb xml:id="p2z3"/>per literas invisere nos possimus, ineunda <lb xml:id="p2z5"/>non sit, quam ut ad illum semper literae dirigantur.</s>
					<s n="9" xml:lang="la"><lb xml:id="p2z6"/>Quia tamen nondum certus sum, nomen <lb xml:id="p2z7"/>eius non scribo.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Cupio d. consulem <persName ref="p1419">Habium</persName> <lb xml:id="p2z8"/>meo nomine salutari.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l760">Solodori</placeName> calendas martii.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z9"/>Tuus <persName ref="p8183">Sanlaurent[ianus]</persName><pb/><lb xml:id="p4z1"/>.</s>
				</p>
				<p>
					<note>[vor 389:]</note>
					<s n="14" xml:lang="la">Clarissimo the(o)logo et <lb xml:id="p4z2"/>amicissimo viro d. <persName ref="p495">Henrico <lb xml:id="p4z3"/>Bullingero</persName>.</s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
					<s n="15" xml:lang="de"><lb xml:id="p4z4"/>An herren <persName ref="p495">Heinrich Bullinger</persName> <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
