	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">De comitiis scribit quidam<note xml:id="fn1" type="footnote" n="1">Ein entsprechender Brief liegt nicht vor.</note> cęsarem quidem <placeName ref="l471">Spirę</placeName> parasse sibi et suis hospitium idemque <lb xml:id="p1z2"/>fecisse <placeName ref="l491">Argentinenses</placeName>,<note xml:id="fn2" type="footnote" n="2">Kaiser <persName ref="p18538">Karl V.</persName> und die Gesandten <placeName ref="l491">Straßburgs</placeName> trafen erst am 30. Januar bzw. am 1. Februar in <placeName ref="l471">Speyer</placeName> ein; s. <bibl source="b480">PC</bibl> III 452. Zu den organisatorischen Vorbereitungen vgl. RTA JR XV/1 112, Anm. 240.</note> verum sibi non videri coitura esse ante epiphaniam<note xml:id="fn3" type="footnote" n="3">6. Januar.</note>, tum forsitan <lb xml:id="p1z3"/>adparitura cum magis<note xml:id="fn4" type="footnote" n="4">mit den Hl. Drei Königen. -Die Eröffnung des Reichstags verzögerte sich bis zum 20. Februar; s. RTA JR XV/1 118.</note>.</s>
					<s n="3" xml:lang="la">Rumor est reginam <persName ref="p19482">Galliae</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p19482">Claude de France</persName>.</note> una cum filio altero<note xml:id="fn6" type="footnote" n="6"><persName ref="p8112">Kronprinz Heinrich</persName>.</note> ad comitia <lb xml:id="p1z4"/>venturam.</s>
					<s n="4" xml:lang="la">Quod si fiet, divina, quid possit esse futurum de evangelio.</s>
					<s n="5" xml:lang="la">Unde <lb xml:id="p1z5"/>sunt, qui nihil minus credunt quam rumorem esse.</s>
					<s n="6" xml:lang="la">Sęvit malus<note xml:id="fn7" type="footnote" ana="lex" n="7">der Teufel.</note> contra evangelium, sęvi<lb xml:id="p1z6"/>unt membra eius multo crudelissime; <foreign xml:lang="el">ἀκηδία</foreign> nos occupavit valde turpiter, quamob<lb xml:id="p1z7"/>rem ego nihil aliud expecto quam malum.</s>
					<s n="7" xml:lang="la">Interim scio ecclesiam Christi non derelictum <lb xml:id="p1z8"/>iri, sed corpori semel patiendum esse.</s>
					<s n="8" xml:lang="la">Opus est itaque nobis certitudine doctrinę nostrę <lb xml:id="p1z9"/>et multo robore spiritus, quo possimus in tentationibus perdurare.</s>
					<s n="9" xml:lang="la">Ergo impellendus <lb xml:id="p1z10"/>populus, ut in emendanda vita sit diligentia et labor, in implorando iugiter domino <lb xml:id="p1z11"/>studium et fidelis constantia; secus enim si factum fuerit, periimus omnes.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale per dominum <lb xml:id="p1z12"/>cum tuis et <persName ref="p8171">Theodoro</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p8171">Theodor Bibliander</persName>.</note>.</s>
					<s n="11" xml:lang="la"><placeName ref="l28">Basileae</placeName>, 16. decembris ante lucem anno 1543.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p8418">Os. Myconius</persName> <lb xml:id="p1z14"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho Bullingero</persName> <lb xml:id="p2z2"/>doctissimo, in domino <lb xml:id="p2z3"/>suo.</s>
					<s n="14" xml:lang="de"><placeName ref="l587">Z[ürich]</placeName><note xml:id="fnb" type="footnote" n="b"><hi>Teilweise auf das nicht mehr vorhandene Verschlussband geschrieben.</hi></note>.</s>
				</p>
			</div>
