	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Dici non potest, quam grate mihi tue litere fuerint <lb xml:id="p1z2"/>scripte ad principium huius mensis, quas heri sero recepi <lb xml:id="p1z3"/>et ex animo amplexus sum tanquam patrem meum <persName ref="p495">Bullingerum</persName>, <lb xml:id="p1z4"/>quem colo et, dum vivam, amabo, teque oro, ut facias parentem <lb xml:id="p1z5"/>et utare mea opera, si usui tibi aut amicis esse possit.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Multi generosi et fortissimi milites <placeName ref="l808">Belgium</placeName> ex <placeName ref="l832">Gallia</placeName> regis <lb xml:id="p1z7"/>iniussu petierunt, quo miseris et tirannide oppressis subvenirent, <lb xml:id="p1z8"/>sed ab Albano intercepti et cęsi aut capti.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Insolentior fiet <lb xml:id="p1z9"/><persName>Hispanus</persName>, sed compescet tandem dominus tale supercilium <lb xml:id="p1z10"/>et materiam dabit nominis eius celebrandi.</s>
					<s n="5" xml:lang="la"><persName ref="p20706">Comes ab Eberstein</persName> <lb xml:id="p1z11"/>non ausus est progredi; putant multi <persName>Auraceum</persName> principem <lb xml:id="p1z12"/>cum 6000 equitum et 10 m peditum traiecisse <placeName ref="l2459">Renum</placeName>.</s>
					<s n="6" xml:lang="la">Oro, ut illi <lb xml:id="p1z13"/>dominus adsit et nostri misereatur.</s>
					<s n="7" xml:lang="la">In negocio d. <persName>Ioannis Philippi</persName> <lb xml:id="p1z14"/>ab <placeName>Alto Saxo</placeName> nihil praetermittam, et nunc puerum ad me <lb xml:id="p1z15"/>misit, ut signifficaret se fidum habere nuncium.</s>
					<s n="8" xml:lang="la">Quare hec <lb xml:id="p1z16"/>festinanter scripsi.</s>
					<s n="9" xml:lang="la" ana="salute">Salutat te uxor.</s>
					<s n="10" xml:lang="la">Scripseram filio, <lb xml:id="p1z17"/>caveret, ne inter spinas ambulando pungeretur ab eis et ne <lb xml:id="p1z18"/>eum venenum scorpionum attingeret, inter quos ambulat.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/>Rescripsit se abs te antidotum accepisse et cirothecas, <lb xml:id="p1z20"/>que impedirent, ne rosas colligendo sentiret spinas.</s>
					<s n="12" xml:lang="la">Habet <lb xml:id="p1z21"/>pium et doctum praeceptorem et probos commilitones.</s>
					<s n="13" xml:lang="la">Brevi <lb xml:id="p1z22"/>profecturus est <placeName ref="l1944">Valentiam</placeName> in <placeName ref="l2772">Delphinatu</placeName>, ubi sunt pii et <lb xml:id="p1z23"/>docti professores.</s>
					<s n="14" xml:lang="la">Eum spero servabit <lb xml:id="p1z24"/>dominus; tuis precibus me et illum commendo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Salutabis meo <lb xml:id="p1z25"/>nomine amplissimum senatum, symmistas et amicos communes.</s>
					<s n="16" xml:lang="la" ana="farewell">Bene vale <lb xml:id="p1z26"/>et nos, quod facis, ama.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l378">Parisiis</placeName> 23. iulii sero a[nno] 72.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z27"/>Tuus ex animo <persName ref="p629">Co<lb xml:id="p1z28"/>ignetius</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurine</placeName> ecclesie [pa]st<lb xml:id="p2z3"/>ori vigilantissimo.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note type="author">[Darunter von Bullingers Hand:]</note>
					<s n="21" xml:lang="la"><lb xml:id="p2z5"/>"De <persName ref="p629">Coignetii</persName> de clade <placeName ref="l832">Gallorum</placeName> <lb xml:id="p2z6"/>accepta in <placeName ref="l808">Belgio</placeName>, <lb xml:id="p2z7"/>datae 23. iulii 1572."</s>
				</p>
			</div>
		</body>
	</text>
