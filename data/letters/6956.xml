					<lb xml:id="p2z2"/>
					<lb xml:id="p2z3"/>n
					<lb xml:id="p2z4"/>
					<lb xml:id="p2z5"/>
					<lb xml:id="p2z6"/>Minem liebens
					<lb xml:id="p2z7"/>Hansen Rodolffen Bullinger
					<lb xml:id="p2z8"/>en predicanten zuͦ Berg
					<lb xml:id="p2z9"/>s.
					<lb xml:id="p2z10"/>rrchel.
					<lb xml:id="p2z11"/>
				</p>
