	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Tandiu reditum in Patriam distuli, quod <lb xml:id="p1z2"/>non ab <placeName ref="l875">Hispanis</placeName> solum, verum etiam <lb xml:id="p1z3"/>ab alia quacunque servitutis specie liberam <lb xml:id="p1z4"/>visitavi, o singulare dei benefitium <lb xml:id="p1z5"/>atque regis illius, cui nunc isti quatuo<lb xml:id="p1z6"/>r mittuntur legati, qui agent ei gratias <lb xml:id="p1z7"/>immortales.</s>
					<s n="2" xml:lang="la">Hic satis foeliciter procedunt <lb xml:id="p1z8"/>omnia.</s>
					<s n="3" xml:lang="la">Ad expugnationem <persName>Orbetelli</persName>, quod <lb xml:id="p1z9"/>unum in potestate hostium superest oppidulum, <lb xml:id="p1z10"/><placeName ref="l832">Gallicam</placeName> classem expectamus.</s>
					<s n="4" xml:lang="la">Princeps <lb xml:id="p1z11"/><placeName>Salernitanus</placeName> cum triremibus quadraginta quinque <lb xml:id="p1z12"/>ut minimum ad littora nostra apellet brevi, <lb xml:id="p1z13"/>multaque fient non pręvisa c nis.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z14"/>Nos tantum deo fidamus et non pudefiemus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Sed vos quoque pro nobis deum rogate simul et cele<lb xml:id="p1z16"/>brate.</s>
					<s n="7" xml:lang="la">Verum si plura cupis de mirabili <lb xml:id="p1z17"/>hac nostra mutatione audire, homines isti copiose tibi <lb xml:id="p1z18"/>narrabunt et non ingrata fortassis; sint tibi <pb/><lb xml:id="p2z1"/>commendati, favoreque tuo eos complecti non omittas, oro.</s>
					<s n="8" xml:lang="la"><lb xml:id="p2z2"/>Ego post festum natalis accingam me itineri <lb xml:id="p2z3"/>et deo dante apud vos ero tota deinceps aestate.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p2z4"/>Interea tu, vir clarissime, vale bene cum familia u<lb xml:id="p2z5"/>niversa.</s>
					<s n="10" xml:lang="la" ana="salute">D. d. <persName ref="p8171">Theodorum</persName>, <persName ref="p8011">Gvalterum</persName>, <lb xml:id="p2z6"/><persName ref="p1214">Frisium</persName>, <persName ref="p1283">Gesnerum</persName> et inprimis generos tuos saluta <lb xml:id="p2z7"/>meis verbis et, quod minime exciderat, <lb xml:id="p2z8"/><persName ref="p8127">Pellicanos</persName> meos omnes salvos atque foelices cupio.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z9"/>Scripsissem etiam ipsis; sed plus temporis non <lb xml:id="p2z10"/>est datum.</s>
					<s n="12" xml:lang="la">Hęc pauca boni consulite.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z11"/><placeName ref="l462">Senis</placeName> 25. settembris 1552.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z12"/><persName ref="p8101">Lęlius Sozinus</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z13"/>De <persName ref="p3375">Vergerio</persName> nostro aliquid <lb xml:id="p2z14"/>certi cognoscere aveo.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z15"/>Literas tuas <placeName ref="l55">Bononiam</placeName> ad patrem misi <lb xml:id="p2z16"/>et ipse brevi succedam<pb/><lb xml:id="p3z1"/>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p4z3"/>Doctissimo atque optimo <lb xml:id="p4z4"/>viro domino <persName ref="p495">Henrico <lb xml:id="p4z5"/>Bullingero</persName>, suo <lb xml:id="p4z6"/>inprimis colendo.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><lb xml:id="p4z7"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
