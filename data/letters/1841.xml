	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Scripseram me timere, ne commissarii <lb xml:id="p1z2"/>quidam <placeName ref="l520">Vallem Tellinam</placeName> ingres[s]i <lb xml:id="p1z3"/>turbarent mihi negotium.</s>
					<s n="2" xml:lang="la">Sed deus <lb xml:id="p1z4"/>me hoc metu liberavit; namque inde cr<lb xml:id="p1z5"/>as egrediuntur rebus salvis, gratię <lb xml:id="p1z6"/>deo; magna est victoria.</s>
					<s n="3" xml:lang="la">Ego, <lb xml:id="p1z7"/>ubi redierit is nuncius, qui literas <lb xml:id="p1z8"/>affert, statim equum con<lb xml:id="p1z9"/>scendam et recta ad te, mi <persName ref="p495">Bull<lb xml:id="p1z10"/>ingere</persName> optatissime.</s>
					<s n="4" xml:lang="la">Interea velim <lb xml:id="p1z11"/>diligentissime investiges, <placeName ref="l760">Soloduri<lb xml:id="p1z12"/>ne</placeName> an forsan alibi haereat nunc <lb xml:id="p1z13"/>legatus regis, et mone <lb xml:id="p1z14"/>meum hunc nuncium, ut eo pergat, <lb xml:id="p1z15"/>quod te etiam atque etiam rogo.</s>
					<s n="5" xml:lang="la">Cau<lb xml:id="p1z16"/>sa est Christi, mihi crede, non <lb xml:id="p1z17"/>mundi, propter quam mitto, sicut a me <lb xml:id="p1z18"/>coram audies.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z19"/>Carpinalis <lb xml:id="p1z20"/><placeName ref="l18">Augustae</placeName> in patriam redit; olfaci<lb xml:id="p1z21"/>t nescio quid.</s>
					<s n="7" xml:lang="la">Timet totus pa<lb xml:id="p1z22"/>pismus a nationali concilio.</s>
					<s n="8" xml:lang="la">Carp<lb xml:id="p1z23"/>inalis vero <placeName ref="l150">Ferrariae</placeName> agebat animam <lb xml:id="p1z24"/><placeName ref="l462">Senis</placeName>.</s>
					<s n="9" xml:lang="la">Expeditio illa vide<lb xml:id="p1z25"/>batur <pb/><lb xml:id="p2z1"/>dormitare.</s>
					<s n="10" xml:lang="la">Novi nihil habet praeterea <lb xml:id="p2z2"/><placeName ref="l834">Italia</placeName>.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale et salve.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Orate omnes <lb xml:id="p2z3"/>pro nobis.</s>
					<s n="13" xml:lang="la"><placeName ref="l93">Claven[n]ae</placeName>, 5. aprilis 155[3].</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z4"/>Utere <persName ref="p4063">Zieglero</persName> interprete, ut <lb xml:id="p2z5"/>possis cum nuncio meo loqui.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z6"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
			</div>
		</body>
	</text>
