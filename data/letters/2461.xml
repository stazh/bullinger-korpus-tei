	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p1586">Franciscus Hotmanus</persName> <lb xml:id="p1z2"/>S.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Recte mones me de <persName>Iulio</persName>, quare magnam tibi pro istoc <lb xml:id="p1z3"/>in me beneficio habeo gratiam.</s>
					<s n="3" xml:lang="la">Opinor alia effugisse, <lb xml:id="p1z4"/>quę tamen adhuc neque quisquam admonuit neque ego <lb xml:id="p1z5"/>observavi.</s>
					<s n="4" xml:lang="la">Dominus libellum nostrum habet in manibus, <lb xml:id="p1z6"/>reprehensorum libidini, si volet, obiiciet; scripsi tamen eum <lb xml:id="p1z7"/>ego animo ecclesiam iuvandi et... eram <persName ref="p974">Molinęi</persName> nostri <lb xml:id="p1z8"/>causam defendendi.</s>
					<s n="5" xml:lang="la">Si mihi tales dominus castigatores <lb xml:id="p1z9"/>daret multos, qualem te, mi pater, sum nactus, id mihi et <lb xml:id="p1z10"/>honori permagno esset et voluptati.</s>
					<s n="6" xml:lang="la">Verum si <persName>Ruffus</persName> <lb xml:id="p1z11"/>respondeat aut alius aliquis mercenarius patronus <placeName ref="l425">Romanę</placeName> tyrannidis, <lb xml:id="p1z12"/>vereor, ut multa neque inscite neque perperam dicta <lb xml:id="p1z13"/>turpissime calumnientur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Adhuc tamen de <persName>Ruffo</persName> verbum nullum, <lb xml:id="p1z14"/>nisi quod illum aiunt in multorum odium apud nostrates <lb xml:id="p1z15"/>incurrisse, pręsertim in eorum, qui suas calumnias ex libello <lb xml:id="p1z16"/>nostro didicerunt.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Do[minum] <persName ref="p974">Molinęum</persName> vehementer miror tam <lb xml:id="p1z17"/>celeriter <placeName ref="l512">Tubingeam</placeName> deserere.</s>
					<s n="9" xml:lang="la">Eodem, quo tuas literas accepi <lb xml:id="p1z18"/>die, epistolam quoque ab eo mihi dominus <persName ref="p540">Calvinus</persName> misit, in qua <lb xml:id="p1z19"/>se ferre non posse dicebat <placeName ref="l512">Tubingensium</placeName> ubiquitatem, <lb xml:id="p1z20"/>quod verbum nunquam antea fando mihi auditum erat.</s>
					<s n="10" xml:lang="la">Dominus <lb xml:id="p1z21"/>istas monstrosas opiniones hominum extinguat, quae dissidiorum <lb xml:id="p1z22"/>in ecclesia dei sementem faciunt sane perniciosam.</s>
					<s n="11" xml:lang="la">Scripsi eidem <lb xml:id="p1z23"/><persName ref="p974">Molinęo</persName>, et quod spero tibi non molestum fore, si humanitate <lb xml:id="p1z24"/>tua libere usus ero, meas ad te literas misi, ut, si facultas <lb xml:id="p1z25"/>sit, eas alicui tuto committas; nam neque hic copia est ullorum, <lb xml:id="p1z26"/>neque, quorsum mittendę sint literę, certo scio.</s>
					<s n="12" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z27"/>vale, mi pater et domine colendissime.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Dominus Iesus <lb xml:id="p1z28"/>tibi spiritum suum sanctum quotidie magis ac magis adaugeat et <lb xml:id="p1z29"/>ecclesię suę incolumem quam diutissime conservet.</s>
					<s n="14" xml:lang="la"><placeName ref="l167">Genevę</placeName> <lb xml:id="p1z30"/>pridie idus nove<pb/><lb xml:id="p2z1"/>mbris.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Clariss<lb xml:id="p2z2"/>imo viro domino <lb xml:id="p2z3"/><persName ref="p495">Heinrich<lb xml:id="p2z4"/>o Bullingero</persName>, <lb xml:id="p2z5"/>ministr<lb xml:id="p2z6"/>o ecclesię <placeName ref="l587">Tiguri<lb xml:id="p2z7"/>nensis</placeName>, parenti m<lb xml:id="p2z8"/>eo observando.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z10"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
