	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Redit ad vos <persName ref="p8399">Clebitius</persName>, homo, cuius ingenium <lb xml:id="p1z2"/>et memoriam omnes fuimus demirati.</s>
					<s n="3" xml:lang="la">Locum <lb xml:id="p1z3"/>ut apud nos haberet, non usque adeo ursit; ma<lb xml:id="p1z4"/>vult enim ipse <placeName ref="l210">Heidelbergam</placeName> redire vestro usus <lb xml:id="p1z5"/>consilio.</s>
					<s n="4" xml:lang="la">Impetravimus itaque illi a nostro quoque <lb xml:id="p1z6"/>magistratu commendationem ad principem <placeName ref="l2477">Palati<lb xml:id="p1z7"/>num</placeName> et viaticum honestum et oramus dominum, <lb xml:id="p1z8"/>ut ipsum ad defensionem et propagationem veritatis <lb xml:id="p1z9"/>suae custodire, animare et <lb xml:id="p1z10"/>conservare velit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Quod praeterea scribam, nunc non habo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l41">Bernae</placeName> <lb xml:id="p1z12"/>calendis novembris 1559.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p8018">Ioannes Hallerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
