	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. Sc<lb xml:id="p1z2"/>rips<lb xml:id="p1z3"/>i ad <persName ref="p1055">Fr<lb xml:id="p1z4"/>echtum</persName>, id quod n<lb xml:id="p1z5"/>uper m<lb xml:id="p1z6"/>e facturum si<lb xml:id="p1z7"/>gnificar<lb xml:id="p1z8"/>am, et <lb xml:id="p1z9"/>pro mea v<lb xml:id="p1z10"/>iri<lb xml:id="p1z12"/>li <lb xml:id="p1z13"/>su<lb xml:id="p1z15"/>m homine<lb xml:id="p1z16"/>m consol<lb xml:id="p1z17"/>atus <lb xml:id="p1z18"/>adhortatusqu<lb xml:id="p1z19"/>e, ne no<lb xml:id="p1z20"/>n suorum animos erigeret, et ne facile ab his<lb xml:id="p1z21"/>, quibuscum foedus tam celebre inierunt, avelli <lb xml:id="p1z22"/>se aut distrahi paterentur.</s>
					<s n="2" xml:lang="la">Quanta potui diligentia <lb xml:id="p1z23"/>admonui.</s>
					<s n="3" xml:lang="la">Rescripsit ipse satis candide et literis qui<lb xml:id="p1z24"/>dem minime ineptis, quas ad te mittere libuit, ne <lb xml:id="p1z25"/>de iis rebus, quarum nos admonuit, non fieres et ipse cer<lb xml:id="p1z26"/>tior.</s>
					<s n="4" xml:lang="la">Eas literas, ubi legeris, remitte.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="5" xml:lang="la">Constans <lb xml:id="p1z27"/>fama est, in contrahendo auro et sumptibus parandis <lb xml:id="p1z28"/>iam <persName ref="p18538">caesaris</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p18538">Karl V.</persName></note> animum angi et sollicitari, nec certum <lb xml:id="p1z29"/>esse admodum, quibus in locis ad verna proxime bellum <lb xml:id="p1z30"/>sit redintegraturus, etiamsi coniectura est, non una <lb xml:id="p1z31"/>a parte illum suo obiter conscripto milite nociturum.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z32"/>Dominus illius animum frangat et sensu meliore donet <lb xml:id="p1z33"/>aut, <lb xml:id="p1z34"/>si id in fatis non sit, profligatum <persName ref="p18847">Enceladaeis</persName> <pb/><lb xml:id="p2z1"/>antris subditum igni urat iugi.</s>
					<s n="7" xml:lang="la">Amen.</s>
					<s n="8" xml:lang="la">Sunt <lb xml:id="p2z2"/>omnia quidem et certo etiam in manu domini; sed ad<lb xml:id="p2z3"/>hibenda ratio erit nec levis nec lenta, qua <placeName ref="l822">Germanicae</placeName> <lb xml:id="p2z4"/>veteri libertati succurratur, ne sua illa avita <lb xml:id="p2z5"/>gloria in universum destituatur.</s>
					<s n="9" xml:lang="la">Tu, si quid habebis <lb xml:id="p2z6"/>me dignum, fac scribas.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="10" xml:lang="la">Mire laudatur <persName ref="p8011">Ruͦdolphi <lb xml:id="p2z7"/><span type="pronoun">nostri</span> Gvaltheri</persName> liber nuper de Antic<lb xml:id="p2z8"/>hristo aeditus<note xml:id="fn6" type="footnote" n="6"><bibl>BZD</bibl> C 367f.</note> et emitur quidem raptim et passim, quem <lb xml:id="p2z9"/>ut videam et legam, a nostro <persName ref="p4851">Froschouero</persName> dari ad me <lb xml:id="p2z10"/>percupio.</s>
					<s n="11" xml:lang="la">Velim autem ipsi meo nomine gratias ageres <lb xml:id="p2z11"/>de tertio illo operis chronici <placeName ref="l587">Tigurini</placeName> libro<note xml:id="fn7" type="footnote" n="7"><persName ref="p3067">Johannes Stumpf</persName>: Gemeiner loblicher <placeName ref="l862">Eydgnoschafft</placeName> Stetten, Landen und Voͤlckeren Chronick wirdiger thaaten beschreybung ..., <placeName ref="l587">Zürich</placeName> [Teil 3, 1546] 1547 (<bibl>BZD</bibl> C 376).</note>, quem <lb xml:id="p2z12"/>pridie abs se missum accepi.</s>
					<s n="12" xml:lang="la">Deum immortalem, <lb xml:id="p2z13"/>quam eleganter confertum copiosumque opus est et <lb xml:id="p2z14"/>quanti <persName ref="p3067">Stumphii</persName> nostri labores, quibus res tantas tam <lb xml:id="p2z15"/>latis e fontibus petit et conscribit!</s>
					<s n="13" xml:lang="la">Dominus et ipsum nobis servet.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l473">Sangalli</placeName>, 11. die decembris, anno <lb xml:id="p2z16"/>domini 1546.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><persName ref="p8049">Vadianus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse als Titel:]</note>
					<s n="17" xml:lang="la">Praestantissimo viro d. <persName ref="p495">Heinricho Bullingero</persName>, clarissima<lb xml:id="p2z17"/>e urbis <placeName ref="l587">Tigurinae</placeName> episcopo, dom<lb xml:id="p2z18"/>ino suo longe amantissimo.</s>
				</p>
			</div>
		</body>
	</text>
