	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S[alutem] d[ico].</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Accepi tuas literas, colende mi <persName ref="p8418">Myconi</persName>, <lb xml:id="p1z2"/>22. iulii scriptas<note xml:id="fn1" type="footnote" n="1">Oben <ref target="file11992">Nr. 1945</ref>.</note>.</s>
					<s n="3" xml:lang="la">In iis primum viam in<lb xml:id="p1z3"/>dicas<note xml:id="fn2" type="footnote" n="2">Siehe oben <ref target="file11992">Nr. 1945</ref>, 5-9.</note> mittendi, quae velim, ad d. <persName ref="p8377">Martinum Heintzium</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p8377">Martin Hentius</persName>.</note>.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Perplacet illa, ac ago tibi gratias oroque, ut praesentes<note xml:id="fn4" type="footnote" n="4">Der beigelegte Brief. -Nicht erhalten.</note> <lb xml:id="p1z5"/>diligenter cures.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">De <placeName ref="l267">Coloniensi</placeName><note xml:id="fn5" type="footnote" n="5"><persName ref="p8462">Hermann von Wied</persName>, Erzbischof und Kurfürst von <placeName ref="l267">Köln</placeName>.</note> quae <lb xml:id="p1z6"/>scribis,<note xml:id="fn6" type="footnote" n="6">Siehe oben <ref target="file11992">Nr. 1945</ref>, 10-23.</note> certe plausibilia.</s>
					<s n="6" xml:lang="la">Quam cuperem sic <lb xml:id="p1z7"/>esse gesta!</s>
					<s n="7" xml:lang="la">Sed quaedam sunt, quae parum verisimili<lb xml:id="p1z8"/>a videntur, illud nimirum, quod princeps <lb xml:id="p1z9"/>prudentissimus iusserit sibi cives urbis satis <lb xml:id="p1z10"/>alioqui discissae et sectis infensissimis in <lb xml:id="p1z11"/>mutuum excidium anhelantis sisti cum armis, <lb xml:id="p1z12"/>et quod ipse princeps iusserit hos <lb xml:id="p1z13"/>in has, illos in illas discedere partes.</s>
					<s n="8" xml:lang="la">Quid <lb xml:id="p1z14"/>enim hoc aliud esset quam cives inter se com<lb xml:id="p1z15"/>mittere?</s>
					<s n="9" xml:lang="la">Sed et senatus <placeName ref="l267">Coloniensis</placeName> mali<lb xml:id="p1z16"/>gnior esse videtur, quam qui populum congre<lb xml:id="p1z17"/>gatum dederit episcopo, praesertim cum cogitare <lb xml:id="p1z18"/>potuissent istam fabam in ipsorum <lb xml:id="p1z19"/>cudendam capite<note xml:id="fn7" type="footnote" n="7">dass sie die Folgen davon zu tragen hätten; s. <bibl source="b56">Adagia</bibl>, 1, 1, 84 (<bibl>ASD</bibl> II/1 192, Nr. 84); <bibl source="b473">Otto</bibl> 128, Nr. 621.</note>.</s>
					<s n="10" xml:lang="la">Novi ego <placeName ref="l267">Coloniensem</placeName> plebem;<note xml:id="fn8" type="footnote" n="8"><persName ref="p495">Bullinger</persName> hatte in <placeName ref="l267">Köln</placeName> von Juli 1519 bis April 1522 studiert; s. <bibl source="b288">HBD</bibl> 4. 6.</note> <lb xml:id="p1z20"/>adeo ad seditiones propendet ut non <lb xml:id="p1z21"/>alia aeque.</s>
					<s n="11" xml:lang="la">Credo sane ista ad te ab amicis <lb xml:id="p1z22"/>esse perscripta, verum quae me reddunt dubium, <lb xml:id="p1z23"/>indico, ut, quoniam scripsisti me non <lb xml:id="p1z24"/>credere, quae dicas,<note xml:id="fn9" type="footnote" n="9">Siehe oben <ref target="file11992">Nr. 1945</ref>, 1f.</note> intelligas me de tua <lb xml:id="p1z25"/>fide prorsus nihil dubitare, sed nonnunquam <lb xml:id="p1z26"/>ancipitem esse in re, quae tibi indicatur <lb xml:id="p1z27"/>et mihi.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Sententiam de pace religionis,<note xml:id="fn10" type="footnote" n="10">Siehe oben <ref target="file11992">Nr. 1945</ref> mit Anm. 10.</note> <lb xml:id="p1z28"/>contra quam agit <persName ref="p20318">Brunsvicensis</persName><note xml:id="fn11" type="footnote" n="11">Herzog <persName ref="p20318">Heinrich von Braunschweig-Wolfenbüttel</persName>.</note>, non vidi <lb xml:id="p1z29"/>ac, nisi tibi molestum sit, videre <lb xml:id="p1z30"/>cuperem.</s>
					<s n="13" xml:lang="la">Si quid habes praeterea ex <lb xml:id="p1z31"/><placeName ref="l832">Gallia</placeName> et <placeName ref="l20">Inferiore Germania</placeName>, fac sciam.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z32"/>Ego nihil habeo ex <placeName ref="l834">Italia</placeName> aut <placeName ref="l882">Pannoniis</placeName><note xml:id="fn12" type="footnote" n="12">Ähnlich berichtet am 31. August 1544 der <placeName ref="l830">englische</placeName> Botschafter in <placeName ref="l522">Venedig</placeName>, <persName ref="p5148">Edmund Harvell</persName>, an König <persName ref="p8375">Heinrich VIII.</persName> von <placeName ref="l830">England</placeName>, dass keine Nachrichten aus <placeName ref="l882">Ungarn</placeName> kommen (<bibl source="b388">LP</bibl> XIX/2, Nr. 163).</note>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z33"/>Mitto tibi libellum non quidem per omnia <lb xml:id="p1z34"/>felicissime redditum, sed sic utcunque satis<note xml:id="fn13" type="footnote" n="13">Die im August bei <persName ref="p4851">Christoph Froschauer</persName> erschienene lateinische Übersetzung von <persName ref="p495">Bullingers</persName> "Der alte Glaube", die von <persName ref="p8394">Diethelm Keller</persName> besorgt wurde und den Titel "Antiquissima fides et vera religio ... <persName ref="p495">Heinrychi Bullingeri</persName> Apodixis" trägt (<bibl source="b286">HBBibl</bibl> I 103; <bibl>BZD</bibl> C 332). Siehe ferner unten <ref target="file12016">Nr. 1969</ref>, 2-4.</note>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell"><lb xml:id="p1z35"/>Vale cum tuis omnibus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 28. a<lb xml:id="p1z36"/>ugusti anno 1544.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z37"/><persName ref="p495">H. Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p8418">Osvaldo Myconi<lb xml:id="p2z2"/>o</persName>, dilecto <lb xml:id="p2z3"/>fratri suo.</s>
				</p>
			</div>
		</body>
