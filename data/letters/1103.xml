	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S. D.</s>
					<s n="2" xml:lang="la">Scripsi ante paucos dies ad te, <lb xml:id="p1z3"/>compater charissime, nec est, quod in praesenti <lb xml:id="p1z4"/>addam, nisi quod <persName ref="p2916">Schertlinus</persName> ante triduum a<lb xml:id="p1z5"/>d me scripsit ducem <persName ref="p20427">Georgium a <lb xml:id="p1z6"/>Mechelburg</persName> cum 12 militum cohortibus et <lb xml:id="p1z7"/>aliquot equitibus obsidere <placeName ref="l303">Magdeburgum</placeName>, <lb xml:id="p1z8"/>sic tamen ut facili momento possit ea <lb xml:id="p1z9"/>civitas ad se intromittere et emittere <lb xml:id="p1z10"/>quoslibet.</s>
					<s n="3" xml:lang="la">Esse eam et milite et annona <lb xml:id="p1z11"/>abunde instructa, ad hęc parari exercitum <lb xml:id="p1z12"/>a principibus quibusdam ad liberandum eam.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z13"/>Deinde significavit, quae sit triplica Caesaris <lb xml:id="p1z14"/>ad duplicum principum ac statuum, praesertim <lb xml:id="p1z15"/>de concilio <placeName ref="l1107">Tridenti</placeName> continuando idque <lb xml:id="p1z16"/>ad dimidium quadragesimę sic consentiente, <lb xml:id="p1z17"/>hoc est colludente, <persName>Romano pontifice</persName>.</s>
					<s n="5" xml:lang="la">Dominus <lb xml:id="p1z18"/>dissipet concilia principum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z19"/>Quas hic mitto, obsecro, si qua ratione <lb xml:id="p1z20"/>poteris, quam primum dabitur occasio, <placeName ref="l473">Sangallum</placeName> <lb xml:id="p1z21"/>ad d. <persName ref="p8049">Vadianum</persName> mittas et a viro obtineas, <lb xml:id="p1z22"/>ne gravetur eas per occasionem <lb xml:id="p1z23"/><placeName ref="l18">Augustam</placeName> mittere.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z24"/><persName>Ester</persName> mea et <persName>Nicolaus</persName> per gratiam domini <lb xml:id="p1z25"/>adhuc videntur convalescere.</s>
					<s n="8" xml:lang="la">Pestis nondum <lb xml:id="p1z26"/>apud nos remisit.</s>
					<s n="9" xml:lang="la">Utinam saltem pestis <lb xml:id="p1z27"/>corruptorum morum et hic et in omni <lb xml:id="p1z28"/>nostra <placeName ref="l822">Germania</placeName> remittat.</s>
					<s n="10" xml:lang="la" ana="farewell">Optime vale, <lb xml:id="p1z29"/>virorum colendissime ac compater charissime.</s>
					<s n="11" xml:lang="de"><lb xml:id="p1z30"/><placeName ref="l41">Bernę</placeName> 6. decembris 1550.</s>
					<s n="12" xml:lang="la" ana="salute">Salutem tuis <lb xml:id="p1z31"/>omnibus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><persName ref="p8417">W<lb xml:id="p1z32"/>[olfgangus] Musculus</persName>, compater tuus <lb xml:id="p1z34"/>in domino.</s>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo m. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho <lb xml:id="p2z4"/>Bullingero</persName>, <lb xml:id="p2z5"/>compatri <lb xml:id="p2z6"/>suo charissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
