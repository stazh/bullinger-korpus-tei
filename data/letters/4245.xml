	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p8175">Theodericus Bitter</persName> suo domino <persName ref="p495">Henricho Bullingero</persName> <lb xml:id="p1z2"/>gratiam et pacem a domino Iesu.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Habeo gratiam, ornatissime mi domine <persName ref="p495">Henrice</persName>, pro <lb xml:id="p1z4"/><placeName ref="l587">Tügurine</placeName> ecclesie ritibus novissime transmissis, estque certe <lb xml:id="p1z5"/>tanta de singulis sollicitudo et concinnatio admodum <lb xml:id="p1z6"/>laudabilis, et optarim me de nostris <placeName ref="l267">Coloniensibus</placeName> <lb xml:id="p1z7"/>talem aut similem libellum destinare posse.</s>
					<s n="3" xml:lang="la">Verum <lb xml:id="p1z8"/>quia id negatur, in locum eiusdem veniunt ad te ta<lb xml:id="p1z9"/>bule aliquot a nostris ordinate, e quibus conatus <lb xml:id="p1z10"/>et molimina nostratium sole clarius licebit odorar<lb xml:id="p1z11"/>e possisque nacta oportunitate his arietibus tempore <lb xml:id="p1z12"/>et loco congruentibus resistere et obviare.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Meo sane <lb xml:id="p1z13"/>iuditio temerario alteram partem quam primum cedere <lb xml:id="p1z14"/>necesse erit; utrinque enim he in christiana republica <lb xml:id="p1z15"/>et religione differentie et seditiones annos iam <lb xml:id="p1z16"/>plus quadraginta lamentabiliter ventilate et dis<lb xml:id="p1z17"/>cusse sunt, ita ut veritas catholice ecclesie diutius <lb xml:id="p1z18"/>supprimi vix possit.</s>
					<s n="5" xml:lang="la">Et o utinam praesens vite cursus <lb xml:id="p1z19"/>tamdiu nobis non denegetur, donec omnes, qui christiani <lb xml:id="p1z20"/>dicuntur, revera una ore et spiritu absque ullis fidei <lb xml:id="p1z21"/>nostre aut ceremoniarum schismatibus deum, patrem <lb xml:id="p1z22"/>nostrum, qui in coelis est, unicum et verum pacis datorem <lb xml:id="p1z23"/>imploremus et huic serviamus.</s>
					<s n="6" xml:lang="la">Apud nos iam bellici <lb xml:id="p1z24"/>tumultus undique silent.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Illustris domina <persName ref="p3656">a Lupfen</persName>, <lb xml:id="p1z25"/>cuius literas, ut retulit, brevi quoque videbis, adhuc <lb xml:id="p1z26"/>bona est valetudine, non minus ego cum uxore et sex liberis, <lb xml:id="p1z27"/>optoque vicissim, ut me de similibus certiorem reddas <lb xml:id="p1z28"/>rescribasque, si tabule huiusmodi <persName>Wilhelmi Lindani</persName> non omnino <lb xml:id="p1z29"/>tibi ingrate aut reiiciende potius quam legende.</s>
					<s n="8" xml:lang="la">Quodsi <lb xml:id="p1z30"/>primum significaveris, transmittam primo nuntio <lb xml:id="p1z31"/>opus eiusdem maius, unde huiusmodi transumptae sunt.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Interim <lb xml:id="p1z32"/>in Christo Iesu valebis salutato tuo fratre domino <persName ref="p527">Io<lb xml:id="p1z33"/>anne</persName>, si adhuc in calamitoso hoc seculo superfuerit.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z34"/>Datum <placeName ref="l267">Colonie</placeName> anno domini etc.</s>
					<s n="11" xml:lang="la">60. ipsis feriis an<lb xml:id="p1z35"/>nuntiacionis beate Marie virginis<lb xml:id="p1z36"/>.</s>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo ac vere pio viro d<lb xml:id="p2z2"/>omino <persName ref="p495">Henrico Bullingero</persName>, a<lb xml:id="p2z3"/>mplissime ecclesię <placeName ref="l587">Tigurine</placeName> <lb xml:id="p2z4"/>ecclesiasti fidelissimo et primari<lb xml:id="p2z5"/>o<lb xml:id="p2z6"/>.</s>
				</p>
			</div>
		</body>
