	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Interpreti nostro iussi, ut te adiret, <persName ref="p495">Bullingere</persName> doctissime, <lb xml:id="p1z2"/>meisque verbis plurimam salutem diceret.</s>
					<s n="2" xml:lang="la">Commisi etiam ei, <lb xml:id="p1z3"/>ut, quę acta sunt <placeName ref="l300">Lucernae</placeName> pontificis nomine cum <placeName>Septem <lb xml:id="p1z4"/>Pagis</placeName> ad fedus aliquod percutiendum convocatis, tibi, quia <lb xml:id="p1z5"/>semper adfuit, de omni re amplissime communicaret.</s>
					<s n="3" xml:lang="la">De <lb xml:id="p1z6"/>bello <placeName>Svevico</placeName> et <placeName>Danico</placeName> paulo antea, quam recepissem tuas <lb xml:id="p1z7"/>litteras, intellexeram, quid gestum esset ab utroque exercitu, <lb xml:id="p1z8"/>non tamen ita exacte, quemadmodum scribis.</s>
					<s n="4" xml:lang="la">Nichil <lb xml:id="p1z9"/>apud nos novi, omnia tranquilla et quieta.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Si quid <lb xml:id="p1z10"/>acciderit, quod me scire oportere dignum iudicabis, <lb xml:id="p1z11"/>rogo, scribito et aliqua honesta usura hominis dignissimi, <lb xml:id="p1z12"/>quemadmodum tu es, laborem compensabo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l760">Solodurii</placeName> <lb xml:id="p1z13"/>die octava mensis februarii 1565.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Tibi deditissimus et perpetuo tuus <persName ref="p1869">C<lb xml:id="p1z15"/>ruxceus</persName>.</s>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p3z1"/>Ornatissi<lb xml:id="p3z2"/>mo atque <pb/><lb xml:id="p4z1"/>doctissimo viro domino <persName ref="p495">Bullingero</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Z...? <lb xml:id="p4z2"/>(<persName ref="p1869">Nicolas de la Croix</persName>, Sr. de <placeName>Nogent</placeName>, Abt von Orbais.)</s>
				</p>
			</div>
		</body>
	</text>
