	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Diu quidem nullas abs te colendissime
					<lb xml:id="p1z2"/>domine et frater charissime, literas accepi, id quod
					<lb xml:id="p1z3"/>tribuo tuis negotiis deinde etiam raritati ta
					<lb xml:id="p1z4"/>bellionum. Vivere tamen te et pro sevilis cor
					<lb xml:id="p1z5"/>pusculi ratione valere spero. Audimus hic de
					<lb xml:id="p1z6"/>Nuptiis principis vestri, cui omnia felicia
					<lb xml:id="p1z7"/>precamur; nam illum ex animo amamus etc
					<lb xml:id="p1z8"/>orantes dominum, ut animum eius in synia
					<lb xml:id="p1z9"/>pritate fidei et corpus cum incolumitate
					<lb xml:id="p1z10"/>bona conservet. Paravi illi libellos duos qad
					<lb xml:id="p1z11"/>rpro sponsa alterum pro ipso, adieci litera
					<lb xml:id="p1z12"/>ad principem, quo illi gratulor et bene pce
					<lb xml:id="p1z13"/>Portassis feret haec ad principem filius
					<lb xml:id="p1z14"/>meus Ioann Rodolphus aut certe Argentina
					<lb xml:id="p1z15"/>ubi operam literis dabit ad te mittet. Fac igitur
					<lb xml:id="p1z16"/>sine ipse venerit sive miserit literas et libel
					<lb xml:id="p1z17"/>omnia fideliter principi offerantur; cui si me con
					<lb xml:id="p1z18"/>comendaveris pergratum feceris beneficium. Si
					<lb xml:id="p1z19"/>filius meus venerit ipse, oro, ut ipsum habeam
					<lb xml:id="p1z20"/>commendatum, et ut ipsi, si quid sit memorabile
					<lb xml:id="p1z21"/>liceat videre. Nunc primum a me proficiscit
					<lb xml:id="p1z22"/>peregre. Hortari quoque ipsum ad virtutes non
					<lb xml:id="p1z23"/>eieQuod praeterea scribam nihil habes
					<lb xml:id="p1z24"/>bellis cruentis omnia pertonant. Sic meret
					<lb xml:id="p1z25"/>puniri nostra ingratitudo et vita poeniter
					<lb xml:id="p1z26"/>esciaDominus misereatur nostri et benedicat
					<lb xml:id="p1z27"/>nobis illuminet multum suum super nos et misereatus
					<lb xml:id="p1z28"/>nostri. Non ingratam feceris rem si
					<lb xml:id="p1z29"/>mihi perscripseris, quo principis fuerint
					<lb xml:id="p1z30"/>celebratae nuptiae et qui illuc venerint
					<lb xml:id="p1z31"/>principes. Salvis sit d. Nicolauus Rhegius
					<lb xml:id="p1z32"/>Salvus sit d. Hospinianus et reliqui viri
					<lb xml:id="p1z33"/>ibellum iam nunc aeditum mitto
					<lb xml:id="p1z34"/>boni.
					<lb xml:id="p1z35"/>aepietati.
					<lb xml:id="p1z36"/>Vale aeternum. Tiguri
					<lb xml:id="p1z37"/>22. augusti anno 1555.
					<lb xml:id="p1z38"/>Bullingerus tuus.
					<pb/>
					<lb xml:id="p2z1"/>Ornatissimo viro et seni optimo
					<lb xml:id="p2z2"/>me merito d. Matthiae
					<lb xml:id="p2z3"/>Erbio Rychevillano pastorius
					<lb xml:id="p2z4"/>et illustrissimo principis
					<lb xml:id="p2z5"/>concionatori, domino
					<lb xml:id="p2z6"/>colendo et fratri charissimo.
					<lb xml:id="p2z7"/>Rychenwyler
				</p>
			</div>
