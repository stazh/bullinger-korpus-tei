	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>pater, ets tuis istis tam duris
					<lb xml:id="p1z2"/>.
					<lb xml:id="p1z3"/>tamque diuturnis cruciatibus, qunam
					<lb xml:id="p1z4"/>vehementissime, sicuti par est afficior
					<lb xml:id="p1z5"/>magnopare tamten recrere istac
					<lb xml:id="p1z6"/>animi fortitudine quam tibi laggitus
					<lb xml:id="p1z7"/>e dominus, ut in te habeat posteritas
					<lb xml:id="p1z8"/>us qui obi virtulis simus ulare i emipliu
					<lb xml:id="p1z9"/>nemadendum eiu o assiduas quam
					<lb xml:id="p1z10"/>preces ad illum nostram clementissimu
					<lb xml:id="p1z11"/>palem fundimus, ita vicissim pr
					<lb xml:id="p1z12"/>nobis quandiu nobiscem idhuc peregrinari
					<lb xml:id="p1z13"/>eundem preceris velim, ut siquidem
					<lb xml:id="p1z14"/>deseri nunc alis te nos opotet sic
					<lb xml:id="p1z15"/>aimire ediveretibus nrispecratis
					<lb xml:id="p1z16"/>eo tempore, quo nescro an ulla extiterit.
					<lb xml:id="p1z17"/>patrum etiam memoria peericulosius a
					<lb xml:id="p1z18"/>certe nos ipsemet guernaculo assidendt
					<lb xml:id="p1z19"/>sic per anedias tempestates regat.
					<lb xml:id="p1z20"/>ut recto servato cursa in portum qua
					<lb xml:id="p1z21"/>provehamur. De rebus nostris parobides
					<lb xml:id="p1z22"/>Eterlicinae plurimos hic vexant, sed
					<lb xml:id="p1z23"/>mortis ericulum. Caetera bene
					<lb xml:id="p1z24"/>habent dei beneficio. Utimam
					<lb xml:id="p1z25"/>quae astis coepit, iam deferbuerit
					<lb xml:id="p1z26"/>De rebus Gallicis; Inducantur ma
					<lb xml:id="p1z27"/>incredibiliter. Post indignissimam
					<lb xml:id="p1z28"/>Momibrini caedem valde exasperata
					<lb xml:id="p1z29"/>san omnia. Iam ingressir est
					<lb xml:id="p1z30"/>Galliam Germanicus peditates, nnmirum
					<lb xml:id="p1z31"/>ut finis opus coronet. Quae in aula
					<lb xml:id="p1z32"/>patrantur, sicut in diebus nex talia
					<pb/>
					<lb xml:id="p2z1"/>ut Sodomia et honricha totaque
					<lb xml:id="p2z2"/>orlieiam plane sese vndtam fateatur
					<lb xml:id="p2z3"/>Trence vaterea furit satani Gutincon
					<lb xml:id="p2z4"/>in illis divbuxat. Vestri sares
					<lb xml:id="p2z5"/>
					<lb xml:id="p2z6"/>ingentem pecuniae sume a eo flagita
					<lb xml:id="p2z7"/>qui nuper monetam ex are qiro eude
					<lb xml:id="p2z8"/>coactus est. Aro prestors
					<lb xml:id="p2z9"/>rediisse dixerim daturum tempr
					<lb xml:id="p2z10"/>exitus tantorum maleram utinare es.
					<lb xml:id="p2z11"/>sit quem optamus. Bere Vale, cui
					<lb xml:id="p2z12"/>optime pater, si cdur maxime
					<lb xml:id="p2z13"/>velims, saltem ut licet. Donrinus
					<lb xml:id="p2z14"/>Iesus servator noster te soletur et
					<lb xml:id="p2z15"/>nos in te respiciat. Genevae eus
					<lb xml:id="p2z16"/>Septemri 1535.
					<lb xml:id="p2z17"/>Tuus Beza.
				</p>
