	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Tunc scribo, clarissime <persName ref="p495">Henrice Bullingere</persName>, quum <lb xml:id="p1z2"/>occasio nunciorum se offert; alioquin <lb xml:id="p1z3"/>frequentius meas literas videres, quum <lb xml:id="p1z4"/>te usque adeo diligam atque observam.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z5"/>Ad tuas, quas nuper meo nuncio dederas ferendas, <lb xml:id="p1z6"/>quamquam essent uberrimae, tame<lb xml:id="p1z7"/>n <lb xml:id="p1z8"/>pauca sunt ad quae rescribendum sit.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z9"/>Princeps differt profectionem ad <persName ref="p18477">Ferdi<lb xml:id="p1z10"/>nandum</persName>.</s>
					<s n="4" xml:lang="la"><persName ref="p974">Molinaeus</persName> perendie hinc <lb xml:id="p1z11"/>abibit, tametsi post petitam veniam <lb xml:id="p1z12"/>discedendi paenituerit hominem et conatus <lb xml:id="p1z13"/>fuerit manere; sic est vir.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">De<lb xml:id="p1z14"/>us scit, quam doleam eius vices, neque <lb xml:id="p1z15"/>unquam deserui; sed parere amicorum con<lb xml:id="p1z16"/>siliis omnino recusat.</s>
					<s n="6" xml:lang="la">De his duobus <lb xml:id="p1z17"/>capitibus scripseras et respondi ego.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z18"/>Forsan una cum <persName ref="p974">Molineo</persName> aut non multo <lb xml:id="p1z19"/>post cogor reverti <placeName ref="l491">Argentinam</placeName> ob <lb xml:id="p1z20"/>Christi causam; scies postea et laudabis, <lb xml:id="p1z21"/>sat scio.</s>
					<s n="8" xml:lang="la">Qua occasione spero <lb xml:id="p1z22"/>me quaedam Latina imprimenda <lb xml:id="p1z23"/>dare vel <placeName ref="l491">Argentinae</placeName> vel <placeName ref="l28">Basileae</placeName>.</s>
					<s n="9" xml:lang="la">Cer<lb xml:id="p1z24"/>tum est me in reditu velle invisere <lb xml:id="p1z25"/>bonum illum <persName ref="p495">Bullingerum</persName> procul dubio.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Quandoquidem non vacat modo ad <persName ref="p8359">Galitium</persName> <lb xml:id="p2z2"/>scribere, oro te, mone tu primo quoque <lb xml:id="p2z3"/>tempore me a principe nuper im<lb xml:id="p2z4"/>petrasse pro eius filio, quod optavit, <lb xml:id="p2z5"/>ut in nova schola <placeName ref="l496">Stutgardiae</placeName> instituta <lb xml:id="p2z6"/>admittatur, unde postea licet <lb xml:id="p2z7"/>alienigena admittetur in stipendium; <lb xml:id="p2z8"/>princeps inquam clementissime concessit.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z9"/>Scribam, quo et quando debeat puerum <lb xml:id="p2z10"/>mittere.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Eodem die impetravi <lb xml:id="p2z11"/>ducentos florenos dividendos inter <lb xml:id="p2z12"/>pauperiores exules <placeName ref="l830">Anglos</placeName>, qui ante <lb xml:id="p2z13"/>paucos dies <placeName ref="l491">Argentinam</placeName> sunt missi.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z14"/>Spero habendam rationem istorum, qui <lb xml:id="p2z15"/>apud vos sunt, et principem plura <lb xml:id="p2z16"/>daturum.</s>
					<s n="14" xml:lang="la" ana="salute">Quibus salutem velim dicas <lb xml:id="p2z17"/>meo nomine et pollicearis sancte me <lb xml:id="p2z18"/>non defuturum.</s>
					<s n="15" xml:lang="la">Eodem die eius <lb xml:id="p2z19"/>celsitu<lb xml:id="p2z20"/>do auxit mihi non petenti aliquid ad veterem <lb xml:id="p2z21"/>conditionem, praeterea dedit fruendam <lb xml:id="p2z22"/>optimam vineam, quae intra moenia <lb xml:id="p2z23"/>est et olim ad <persName>Augustinos</persName> monachos atti<lb xml:id="p2z24"/>nebat optimumque vinum et bene <lb xml:id="p2z25"/>multum fert, quae res mihi aux<lb xml:id="p2z26"/>it <lb xml:id="p2z27"/>multorum invidiam.</s>
					<s n="16" xml:lang="la">In summ<pb/><lb xml:id="p3z2"/>a: <lb xml:id="p3z3"/>u<lb xml:id="p3z4"/>tor <lb xml:id="p3z5"/>hoc principe nunc maiore quadam foe<lb xml:id="p3z6"/>licitate quam unquam antea, deo gratiae.</s>
					<s n="17" xml:lang="la"><lb xml:id="p3z7"/>Audies coram nos bonum fratrem in <lb xml:id="p3z8"/>Christo profecto habere.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Supervenit <lb xml:id="p3z9"/>comes <persName>Georgius</persName>, qui multa mecum, <lb xml:id="p3z10"/>quum forte essemus in venatione.</s>
					<s n="19" xml:lang="la"><lb xml:id="p3z11"/>Is me rogavit, rogavit inquam, <lb xml:id="p3z12"/>bene bis, ut ad te scriberem eum tibi <lb xml:id="p3z13"/>valde bene velle, et quandoquidem <lb xml:id="p3z14"/>tu librum illi inscripseris et nihil <lb xml:id="p3z15"/>hactenus dederit, se nullo modo vell<lb xml:id="p3z16"/>e <lb xml:id="p3z17"/>pati, ut indonatus abieris.</s>
					<s n="20" xml:lang="la">Et quum <lb xml:id="p3z18"/>responderem ego, quae scio te velle <lb xml:id="p3z19"/>pro te in tali re responderi, urgebat <lb xml:id="p3z20"/>se nihil admittere, sed facturum <lb xml:id="p3z21"/>nescio quid.</s>
					<s n="21" xml:lang="la" ana="salute">Salutat te aman<lb xml:id="p3z22"/>tissime.</s>
					<s n="22" xml:lang="la">Ubi <placeName ref="l491">Argentinam</placeName> venero, <lb xml:id="p3z23"/>scribam, simne illic diu mora<lb xml:id="p3z24"/>turus an vero <placeName ref="l28">Basileae</placeName>, ut possis ad <lb xml:id="p3z25"/>me rescribere.</s>
					<s n="23" xml:lang="la">Oro te, mitte has <lb xml:id="p3z26"/>ad d. <persName ref="p8296">Bassaf[ontaneum]</persName>.</s>
					<s n="24" xml:lang="la" ana="farewell">Vale et salve <lb xml:id="p3z27"/>cum tota familia, schola atque <lb xml:id="p3z28"/>ecclesia.</s>
					<s n="25" xml:lang="la">Ora pro me cum omnibus.</s>
					<s n="26" xml:lang="la"><lb xml:id="p3z29"/><placeName ref="l512">Tubingae</placeName> 28. septembris <lb xml:id="p3z30"/>1554.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p3z31"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><pb/><lb xml:id="p4z1"/><placeName ref="l513">Ulmenses</placeName> abiecto <persName ref="p18538">Caesaris</persName> timore tandem statuerunt <lb xml:id="p4z2"/>velle instaurare ecclesias eorum.</s>
					<s n="29" xml:lang="la">Iam anxie quaerunt <lb xml:id="p4z3"/>pastores pro oppidis et pagis; e <lb xml:id="p4z4"/>summo templo dudum reiecerant Intre<lb xml:id="p4z5"/>mistas, deo gratiae.</s>
					<s n="30" xml:lang="la">Tota <placeName ref="l850">Austria</placeName> <lb xml:id="p4z6"/>nuper petivit a <persName ref="p18477">Ferdinando</persName> saltem communio<lb xml:id="p4z7"/>nem sub utraque; habeo supplicationis <lb xml:id="p4z8"/>exemplum.</s>
					<s n="31" xml:lang="la">Rex respondit se delibera<lb xml:id="p4z9"/>turum neque ausus est praecise negare.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><lb xml:id="p4z10"/>Tibi <persName ref="p495">Bullingere</persName>.</s>
				</p>
			</div>
