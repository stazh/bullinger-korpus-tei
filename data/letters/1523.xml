	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Vigilantissimis <placeName ref="l587">Tigurinae</placeName> ecclesiae episcopis a verbi minist<lb xml:id="p1z2"/>ris gratiam et pacem.</s>
					<s n="2" xml:lang="la">Accessit ad nos d. <persName ref="p6769">Augustinus Talpius</persName>, qui multis annis verbi ministerio apud nos <lb xml:id="p1z3"/>praefuit, indicans se a vobis revocatum eamque vocationem <lb xml:id="p1z4"/>ipsi ultra non negligendam petiitque a nobis literas, ut <lb xml:id="p1z5"/>nostro testimonio comitatus ad vos rediret.</s>
					<s n="3" xml:lang="la">Quod primum <lb xml:id="p1z6"/>nobis molestum erat cupientes eum apud nos diutius manere <lb xml:id="p1z7"/>atque, ut id faceret, rogantes.</s>
					<s n="4" xml:lang="la">Postquam vero incumbentem necessita<lb xml:id="p1z8"/>tem nobis exposuit, eum diutius retinere importunum, <lb xml:id="p1z9"/>literas autem denegare iniquum nobis visum est.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Damus <lb xml:id="p1z10"/>igitur illi testimonium hoc non emendicatum nec occecato <lb xml:id="p1z11"/>iuditio, quod saepe fieri assolet, sed solam veritatem sequentes.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Caeterum ipsius in ministerio fidem aut in conversatione <lb xml:id="p1z13"/>integritatem magnis laudibus extollere superfluum esset; <lb xml:id="p1z14"/>haec enim sunt vobis compertissima.</s>
					<s n="7" xml:lang="la">Illud saltem <lb xml:id="p1z15"/>addendum putavimus: discessit a nobis magno sui <lb xml:id="p1z16"/>desiderio relicto non apud ecclesiam tantum, cum praefuit, <lb xml:id="p1z17"/>sed apud omnes nostrae religionis concives, qui cum multis <lb xml:id="p1z18"/>praecibus eum a consilio dimovere conati essent, <lb xml:id="p1z19"/>audita necessitate ei resistere non expedire putabant; <lb xml:id="p1z20"/>non enim aeque nobis vobiscum conditio est, cum aut senio <lb xml:id="p1z21"/>aut morbis confectis parva, quod ad victum attinet, spes <lb xml:id="p1z22"/>sit reliqua; sed nobis in deo fidendum, illi sua occasio <lb xml:id="p1z23"/>non omittenda.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Demum eum vobis commendare, ut ipsum benevole <lb xml:id="p1z24"/>suscipiatis, opus non est, cum antea prompti sitis; illud autem <lb xml:id="p1z25"/>rogamus, ut regionem nostram commendatam habeatis, si quando <lb xml:id="p1z26"/>penuria ministrorum incidat; nam quod ad ecclesiam, cui <lb xml:id="p1z27"/>praefuit <persName ref="p6769">Augustinus</persName>, attinet, ipse indicabit.</s>
					<s n="9" xml:lang="la" ana="farewell">Valete.</s>
					<s n="10" xml:lang="la">Ex <lb xml:id="p1z28"/><placeName ref="l176">Glarona</placeName> 5. ianuarii anno 1552.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z29"/>Ad mandata vestra paratissimi <lb xml:id="p1z30"/>ecclesiae ministri apud <placeName ref="l176">Glaronam</placeName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z31"/><persName ref="p3206">Valentinus Schudus</persName> obsignavit.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
