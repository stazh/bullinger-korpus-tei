			<zone xml:id="p4z2-0" points="402,1453 734,1472 849,1427 970,1478 1166,1420 1158,1349 1037,1371 916,1332 820,1368 758,1333 625,1350 482,1420 408,1374">408,1444 446,1436 484,1433 522,1430 560,1428 598,1427 636,1428 674,1423 712,1421 750,1420 788,1416 826,1410 864,1407 902,1405 940,1402 978,1400 1016,1397 1054,1395 1092,1391 1130,1388 1169,1393</zone>
			<zone xml:id="p4z3-0" points="405,1582 427,1590 454,1587 495,1566 548,1590 562,1587 566,1507 537,1494 494,1486 442,1520 408,1522">411,1563 436,1557 462,1557 488,1556 514,1555 540,1553 566,1551</zone>
