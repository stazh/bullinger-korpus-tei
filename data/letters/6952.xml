	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Pergratas tuas heri literas accepi, S. D. ac summas gratias ago tibi de tuis <lb xml:id="p1z2"/>novis, quas a <placeName ref="l822">Germania</placeName> accepisti, tum maxime de his, que in <placeName ref="l2721">Panonia</placeName> <lb xml:id="p1z3"/>accijderunt.</s>
					<s n="2" xml:lang="la">Sed illud est mihi novum creditu, quod non sit mortuus <lb xml:id="p1z4"/><persName ref="p18593">Solimanus</persName>, <placeName ref="l2510">Turcharum</placeName> imperator, nempe ultra quod illud a duobus <lb xml:id="p1z5"/>vel tribus locis ex <placeName ref="l822">Germania</placeName> accepi, adhuc nuper ex literis maiestatis <lb xml:id="p1z6"/>regine nostre mihi est confirmatum, ac quod cum summo applausu <lb xml:id="p1z7"/>sit receptus ad imperium <persName ref="p18593">Selimus</persName> <persName ref="p21130">filius</persName>.</s>
					<s n="3" xml:lang="la">Sed ut ego suspicor, est <lb xml:id="p1z8"/>maxima consuetudo <placeName ref="l822">Germanorum</placeName> nugas dicere, maxime vero illi<lb xml:id="p1z9"/>, <lb xml:id="p1z11"/>qui partes <placeName ref="l875">Hispanicas</placeName> fovent, ita id, quod cogitaverint, velint illud <lb xml:id="p1z12"/>ita fieri.</s>
					<s n="4" xml:lang="la">De transitu regis <placeName ref="l875">Hispaniae</placeName> per <placeName ref="l648">Rhetos</placeName> vel pro copiis <lb xml:id="p1z13"/>mittendis adversus <placeName ref="l640">Flandros</placeName> per illam viam, quod sit illi iter <lb xml:id="p1z14"/>brevior, si dominus <persName ref="p8160">Bellenerius</persName>, predecessor meus, impedivit conatus <lb xml:id="p1z15"/>suorum in illis partibus et passum, ego certissime ardentius et <lb xml:id="p1z16"/>cum maiori animo illud faciam, quoniam adhuc, quod nunquam <lb xml:id="p1z17"/>ex genio meo amaverim <placeName ref="l875">Hispanos</placeName>, probe scio illud non esse ex re <lb xml:id="p1z18"/>maiestatis domini regis mei.</s>
					<s n="5" xml:lang="la">Qui, si ita mihi loqui fas erit, <lb xml:id="p1z19"/>emit illum passum, neque mihi exprobrabitur, quod diligentiam <lb xml:id="p1z20"/>non solum adhibeam in illa re, sed in aliis, que damnum semper <lb xml:id="p1z21"/>adferent simili inimico domini Iesu Christi, dabo operam totis viribus <lb xml:id="p1z22"/>dare impedimentum.</s>
					<s n="6" xml:lang="la">De literis tuis dedi operam hodie, ut cito et <lb xml:id="p1z23"/>secure perferantur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Bene vale in domino, et bene sit tibi et <lb xml:id="p1z24"/>familie.</s>
					<s n="8" xml:lang="de">Ex <placeName ref="l144">Erlibach</placeName> 20. novembre.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z25"/>Amicissimus in omnibus <lb xml:id="p1z26"/><persName ref="p931">P[ie<lb xml:id="p1z27"/>rre] <lb xml:id="p1z28"/>de Grantry<pb/><lb xml:id="p3z1"/>e</persName>.</s>
					<s n="10" xml:lang="de"><pb/><lb xml:id="p4z1"/>Dem eerwürdigenn unnd <lb xml:id="p4z2"/>wolgelerten meyster <persName ref="p495">Heinrychen <lb xml:id="p4z3"/>Bullinger</persName>, dienner der <lb xml:id="p4z4"/>kilchen <placeName ref="l587">Zürich</placeName>, sinem günstigen <lb xml:id="p4z5"/>herren.</s>
					<s n="11" xml:lang="de"><lb xml:id="p4z6"/><placeName ref="l587">Zürych</placeName>.</s>
				</p>
			</div>
		</body>
