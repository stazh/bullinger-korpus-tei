	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Literas tuas 15. huius mensis scriptas heri bolnensi <lb xml:id="p1z2"/>oppido accepi cum binis tuis libris, quorum unum regiae maiestati, <lb xml:id="p1z3"/>alterum <persName>Margaritae Franciae</persName> offerri cupis.</s>
					<s n="2" xml:lang="la">Ego hodie ad r[egiam] m[<lb xml:id="p1z4"/>aiestatem], quę est in castris ad <placeName ref="l2977">Mousellam</placeName> sitis, mittam; secundum <persName>Margaritae</persName> <lb xml:id="p1z5"/>ipsemet offeram; ad reginam enim proficiscor illic non diu <lb xml:id="p1z6"/>hesurus.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Gravissime egrotavit, ita ut omnes medici de salute <lb xml:id="p1z7"/>desperarent; sed nunc convaluit.</s>
					<s n="4" xml:lang="la">Quod autem de practicis, que <lb xml:id="p1z8"/>in <placeName ref="l862">Helvetia</placeName> fovet, scribis, habeo gratiam; sed pontifex parum <lb xml:id="p1z9"/>vel nihil potest, quum exhaustus sit et pecuniis et viribus et <lb xml:id="p1z10"/>absque illis hi, cum quibus est negotium, parum faciunt.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Sed nihilominus est diligentissime vigilandum.</s>
					<s n="6" xml:lang="la">Scio enim <lb xml:id="p1z12"/>plerisque non placere hanc regiae maiestatis expeditionem, <lb xml:id="p1z13"/>que egregia habet milia.</s>
					<s n="7" xml:lang="la">Cupio certe ad vos redire; sed <lb xml:id="p1z14"/>nondum licet, nec potero proximis comitiis interesse.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Sequentibus deo adiuvante interero.</s>
					<s n="9" xml:lang="la">Interim regia m[aies<lb xml:id="p1z16"/>tas] ad <placeName ref="l862">Helvetios</placeName> scribet.</s>
					<s n="10" xml:lang="la">Que de <placeName ref="l3105">Mirandula</placeName> dicuntur, vana sunt; <lb xml:id="p1z17"/>immo milites nostri, qui illic sunt, hebdomada ante pasche <lb xml:id="p1z18"/>exierunt ex oppido, excursiones fecerunt in hostes, ita ut <lb xml:id="p1z19"/>multos occiderint, de quorum numero fuit pontificis nepos, <lb xml:id="p1z20"/>alios captivos in oppidum receperunt.</s>
					<s n="11" xml:lang="la">Credo exercitum <lb xml:id="p1z21"/>principum <placeName ref="l822">Germanorum</placeName> brevi <placeName ref="l257">Constantiam</placeName> invisurum <lb xml:id="p1z22"/>et spero me brevi te visurum, si dominus dederit, et nisi esset <lb xml:id="p1z23"/>cum regina et admirandis de seriis rebus communicandum, i<lb xml:id="p1z24"/>am <lb xml:id="p1z25"/>ad vos advolarem.</s>
					<s n="12" xml:lang="la">Hec sunt, que potui obiter scribere inter <lb xml:id="p1z26"/>multas anxietates et infinita negotia.</s>
					<s n="13" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="14" xml:lang="la">Dominus <lb xml:id="p1z27"/>te suae ecclesiae servet incolumem.</s>
					<s n="15" xml:lang="la">Ex <placeName>Drudano</placeName> <placeName ref="l631">Burgundiae</placeName> <lb xml:id="p1z28"/>28. aprilis 1552.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z29"/>Tuus ex animo <lb xml:id="p1z30"/><persName ref="p944">Maurilius Musaeus</persName>.</s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
					<s n="17" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem hochgelerten <lb xml:id="p2z2"/>eerenvesten, wysen heren <lb xml:id="p2z3"/><persName ref="p495">Heinrychen Bullinger</persName>, <lb xml:id="p2z4"/>verkünder deß heylligen <lb xml:id="p2z5"/>worts <placeName ref="l587">Zürych</placeName>, minem <lb xml:id="p2z6"/>günstigen, lieben heren.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><placeName ref="l587">Zuryc<lb xml:id="p2z7"/>h</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
