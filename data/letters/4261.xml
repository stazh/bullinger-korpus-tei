	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ego (reverende in Christo pater), quod scribam, plane <lb xml:id="p1z2"/>non habeo.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Misi ad legatum, sed ne ipse quidem <lb xml:id="p1z3"/>habet quicquam.</s>
					<s n="4" xml:lang="la">Nihil ex <placeName ref="l834">Italia</placeName> ad nos affertur; omnia <lb xml:id="p1z4"/>nunc silent.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quod quid portendat, ignoro; forsan <lb xml:id="p1z5"/>aliquid monstri alunt, quod brevi est erupturum.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/>De coronato, quoniam ita omnino vis, parebo; tunc <lb xml:id="p1z7"/>autem uberiores agam gratias, cum coniux acceperit, <lb xml:id="p1z8"/>licet invitus ab eo accipiam, cui debeo.</s>
					<s n="7" xml:lang="la">Spargebatu<lb xml:id="p1z9"/>r <lb xml:id="p1z10"/>hic pridie rumor de obitu <persName ref="p18536">Sabaudi</persName>; sed nihil <lb xml:id="p1z11"/>possum affirmare.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Quid in <placeName ref="l822">Germania</placeName> agatur, a nobis <lb xml:id="p1z12"/>ignoratur.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Veniam, si vixero, post pascham ad <lb xml:id="p1z13"/>vos, et tunc de rebus omnibus.</s>
					<s n="10" xml:lang="la">Dabis tu mihi tunc <lb xml:id="p1z14"/>aliquot horas, quas tibi suffuraberis; nec enim, quod <lb xml:id="p1z15"/>superiore anno a me factum est, tam subito a te <lb xml:id="p1z16"/>avellar, cum tu non sis postrema causa mei ad vos <lb xml:id="p1z17"/>adventus, nisi (quod certe vereor) coram mutus <lb xml:id="p1z18"/>sum futurus, qui absens tamen nunquam non habeo, quod te <lb xml:id="p1z19"/>scire velim.</s>
					<s n="11" xml:lang="la">D. d. <persName ref="p1283">Gesneri</persName> accepi omnia; <lb xml:id="p1z20"/>scribam, si vacat, post octo dies.</s>
					<s n="12" xml:lang="la">Non est, quod de vecturae <lb xml:id="p1z21"/>precio sit solicitus, cum omnia abunde sint persoluta.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z22"/>Vale, reverende in Christo pater, et quod te inanibus <lb xml:id="p1z23"/>literis obtundo, mihi ignosce; cum enim nihil haberem, qu<lb xml:id="p1z24"/>od scriberem, tamen scribere volui, ut tu quoque me nihil habere scires.</s>
					<s n="14" xml:lang="la" ana="salute">Salvum te c<lb xml:id="p1z25"/>upiunt nostri omnes.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Salutem ex nobis dicito tuis omnibus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l98">Curiae</placeName> 8. aprilis anno 1560.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p8009">Ioannes Fabricius</persName>, tui observantissimus.</s>
					<s n="18" xml:lang="la">De <persName ref="p293">Beccaria</persName> nihil timemus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Clarissimo viro er<lb xml:id="p1z27"/>uditione et pietate excellenti d. <persName ref="p495">Heinrycho Bullingero</persName>, ecclesiae <placeName ref="l803">Tigurinae</placeName> antisti<lb xml:id="p1z28"/>ti vigilantissi<pb/><lb xml:id="p2z1"/>mo, domino et pat<lb xml:id="p2z2"/>rono suo mul<lb xml:id="p2z3"/>tis nominibus observando.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>