	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Compater in domino charissime, quas ad me dedisti <lb xml:id="p1z2"/>tertia mensis huius, una cum xenio filio meo <lb xml:id="p1z3"/><persName ref="p2207">Ioanni Heinrycho</persName> misso accepi, pro qua tua <lb xml:id="p1z4"/>humanitate ac liberalitate habemus tibi gratias, <lb xml:id="p1z5"/>quam possumus maximas, precamurque toti tuae <lb xml:id="p1z6"/>domui vicissim annum hunc in domino cum primis <lb xml:id="p1z7"/>felicem et iuxta saeculum quoque haud incommodum.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z8"/>Quod mutuas attinet scribendi vices, tam <lb xml:id="p1z9"/>abest, ut raritatem tuarum ad me literarum moleste <lb xml:id="p1z10"/>ferre debeam, ut conveniat magis veniam abs <lb xml:id="p1z11"/>te petere, quod non frequentius ad te scribo; <lb xml:id="p1z12"/>verum scio te satis intelligere, quam sit torpida <lb xml:id="p1z13"/>ac frigida senectus, ideoque abunde contentum <lb xml:id="p1z14"/>esse, si amicitia nostra in veritate Christi sit <lb xml:id="p1z15"/>etiam et amen, quicquid fiat de literis.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z16"/>Compater noster <persName ref="p8018">Hallerus</persName> ut iunior est, ita <lb xml:id="p1z17"/>ad scribendum etiam est et alacrior et expeditior<lb xml:id="p1z18"/>.</s>
					<s n="5" xml:lang="la">Quare non dubito illum praestare, <lb xml:id="p1z19"/>quicquid est officii, praesertim in rebus <lb xml:id="p1z20"/>seriis, quarum communicationem communis ecclesiarum <lb xml:id="p1z21"/>nostrarum causa requirit.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z22"/>De conventu et colloquio <placeName ref="l569">Wormatiensi</placeName>, praesertim <lb xml:id="p1z23"/>de illius catastropha si quid habes, quaeso, <lb xml:id="p1z24"/>paucis communica.</s>
					<s n="7" xml:lang="la">Nihil boni ex eo mihi <lb xml:id="p1z25"/>colloquio pollicebar initio nec dubito talem <lb xml:id="p1z26"/>esse illius exitum, ut manifestum fiat omnibus <lb xml:id="p1z27"/>institutum fuisse consilio humano, non divino.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z28"/>Archigrammateum vestrum hic ex <placeName ref="l832">Gallia</placeName> reversum <lb xml:id="p1z29"/>vidi, virum et statura et forma honesta ac <lb xml:id="p1z30"/>facie admodum placida.</s>
					<s n="9" xml:lang="la" ana="salute">Obiter eum salutavi <lb xml:id="p1z31"/>post concionem, tametsi, quis esset, ignorarem; <lb xml:id="p1z32"/>nam postea demum ex d. <persName ref="p8018">Hallero</persName>, quis esset, <lb xml:id="p1z33"/>cognovi; quare te oro, excuses me illi.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z34"/>Optime vale, compater charissime.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Saluta tuos omnes <lb xml:id="p1z35"/>meo ac meorum nomine una cum symmystis <lb xml:id="p1z36"/>tuis omnibus, non Germanis tantum, sed et Italis, <lb xml:id="p1z37"/>d. <persName ref="p8111">Petro Martyre</persName> et d. <persName ref="p2336">Bernardino</persName>, fratribus in <lb xml:id="p1z38"/>domino charissimis.</s>
					<s n="12" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1557. decembris 11.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><persName ref="p8417">W[olfgangus] Musc[ulus</persName>] tuus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo theologo <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, domino <lb xml:id="p2z4"/>ac compatri cha<lb xml:id="p2z5"/>rissimo.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
