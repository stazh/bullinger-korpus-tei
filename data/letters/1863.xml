	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.I.D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Mitto demum per nostrum <persName>Burkhardum</persName><note type="misc">vgl. <bibl source="b714">Zwa</bibl> XIX/1 121, Anm. 30</note> tuas ad pie memoriae virum <persName ref="p8418">Myconium</persName> <lb xml:id="p1z3"/>epistolas omnes, quas difficulter ab hęrede tandem extorsi, <persName ref="p495">Bullingere</persName> cl<lb xml:id="p1z4"/>arissime, eo quod thesauri instar haberet, quicquid a doctis hinc inde <lb xml:id="p1z5"/>viris ad tantum virum scriptum esset.</s>
					<s n="3" xml:lang="la">In <placeName ref="l832">Galliis</placeName> (quantum ex filii, qui <lb xml:id="p1z6"/><placeName ref="l378">Lutetiae</placeName> bonis literis navat operam, intelligo) nullum est aut certe simulat<lb xml:id="p1z7"/>ur bellu<lb xml:id="p1z8"/>m, proditiones tamen vigent, et ne faba in <placeName ref="l822">Germanorum</placeName> tandem <lb xml:id="p1z9"/>caput cudatur, verendum est.</s>
					<s n="4" xml:lang="la"><persName ref="p6133">Guilielmus Postellus</persName>, qui hactenus frequen<lb xml:id="p1z10"/>ti auditorio philosophum et theologum se <placeName ref="l378">Lutetiae</placeName> praestiterat, nunc <lb xml:id="p1z11"/>invidorum malevolentiae cedens clam aufugit; indici centum coronati <lb xml:id="p1z12"/>edicto publico decreti sunt, qui latebras illius detexerit.</s>
					<s n="5" xml:lang="la">Causa nulla <lb xml:id="p1z13"/>alia est, nisi quod acrius in principum et pontificum mores quotidianis <lb xml:id="p1z14"/>huius quadragesimae transactae concionibus invectus fuerit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Accusatores tamen haereseos et seditionis illum insimularunt praetex<lb xml:id="p1z16"/>tum alium sibi fingentes.</s>
					<s n="7" xml:lang="la">De rebus <placeName ref="l850">Austriacis</placeName>, <placeName ref="l882">Hungaricis</placeName> etc. ex <lb xml:id="p1z17"/>ipso <persName>Lazio</persName>, viro doctissimo, certior fies.</s>
					<s n="8" xml:lang="la">Nos de Caesare <lb xml:id="p1z18"/>nec verbum quidem audimus, de marchionis vero <persName>Alberti</persName> furio<lb xml:id="p1z19"/>so impetu varia, qui nuper <placeName>Bombergam</placeName> deditione occupasse <lb xml:id="p1z20"/>atque episcopum ingenti pecunia mulctasse fertur.</s>
					<s n="9" xml:lang="la">Ego tuis <lb xml:id="p1z21"/>ad me literis scire percupio, quid de evangelio iterum <placeName ref="l257">Constantiae</placeName> <lb xml:id="p1z22"/>praedicando certi habeas.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale.</s>
					<s n="11" xml:lang="la"><placeName ref="l28">Basileae</placeName> anno 1553 <lb xml:id="p1z23"/>pridie nonas maii, eo videlicet die, quo olim <placeName ref="l425">Roma</placeName> tertia oppugnati<lb xml:id="p1z24"/>one a Caesarianis militibus capta, <persName>Albertus</persName>, <placeName ref="l850">Austriae</placeName> dux, rex <placeName ref="l2449">Bohemiae</placeName> <lb xml:id="p1z25"/>declaratus, et <persName>Ioannes Damascenus</persName>, insignis sui temporis theologus, <lb xml:id="p1z26"/><placeName ref="l1148">Constantinopoli</placeName> fatis concessit.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z27"/>T[uus] <persName ref="p8406">Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vigilantissimo ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z2"/>episcopo d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>domino atque amico incomparabili.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
