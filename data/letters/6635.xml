	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nihildum ex <placeName ref="l167">Geneva</placeName> recepi; ubi primum quid accepero, <lb xml:id="p1z2"/>mittam.</s>
					<s n="3" xml:lang="la">Cum vero commode se mihi hic <lb xml:id="p1z3"/>obtulerit nuncius, qui quamvis <placeName ref="l21">Badensis</placeName> sit, a multis <lb xml:id="p1z4"/>mihi tamen annis notus est, mitto tibi et <lb xml:id="p1z5"/>d. <persName ref="p8011">Gvalthero</persName> unicuique per ipsum capum <placeName ref="l2478">Sabau<lb xml:id="p1z6"/>dicum</placeName> et rogo, ut exigua munuscula boni <lb xml:id="p1z7"/>consulatis.</s>
					<s n="4" xml:lang="la">Scio me vobis plura debere; sed in <lb xml:id="p1z8"/>praesentiarum aliud non occurrit, quo possim aliquo <lb xml:id="p1z9"/>saltem modo meam vobis gratitudinem testari.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Faciam id deinceps aliquando volente domino <lb xml:id="p1z11"/>aliquanto liberalius.</s>
					<s n="6" xml:lang="la">Precor vero simul, ut dominus vobis [et] <lb xml:id="p1z12"/>vestris omnibus plurimos et faustissimos et foelicissimos largiatur <lb xml:id="p1z13"/>annos.</s>
					<s n="7" xml:lang="la">Idem vobis precantur d. <persName ref="p8063">Steigerus</persName>, <lb xml:id="p1z14"/><persName ref="p7511">Graffenrietus</persName>, <persName ref="p3659">Mülinensis</persName>, socer item meus, <lb xml:id="p1z15"/>mater et uxor.</s>
					<s n="8" xml:lang="la">Dominus vos servet semper!</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/><placeName ref="l41">Bernae</placeName> 2a.</s>
					<s n="10" xml:lang="la">ianuarii 1566.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p8018">Iohannes Hallerus</persName>, <lb xml:id="p1z18"/>vester totus idque <lb xml:id="p1z19"/>perpetuo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimis viris d. d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName> <lb xml:id="p2z3"/>et <persName ref="p8011">Rodolpho Gval<lb xml:id="p2z4"/>thero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z5"/>pastoribus fidelissimis, <lb xml:id="p2z6"/>dominis meis perpetuo <lb xml:id="p2z7"/>observandis.</s>
				</p>
			</div>
		</body>
	</text>
