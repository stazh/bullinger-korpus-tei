	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Libros, quos contra anabaptistas scripsisti, <lb xml:id="p1z2"/>magno desiderio accepi, venerande in domino pater.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Misisti, intelligo, pro tua veteri consuetudine, qua <lb xml:id="p1z4"/>me hactenus a morte clarissimi viri d. <persName ref="p8049">Vadiani</persName> <lb xml:id="p1z5"/>participem fecisti lucubrationum tuarum, qua adoptio<lb xml:id="p1z6"/>ne nihil potuisset mihi accidere gratius.</s>
					<s n="4" xml:lang="la">Sed <lb xml:id="p1z7"/>unde haec mihi gratia?</s>
					<s n="5" xml:lang="la">Nimirum, ut non possis <lb xml:id="p1z8"/>non redamare eum, qui <persName ref="p8049">Vadianum</persName> apud coelites viventem <lb xml:id="p1z9"/>et te etiamnum dei bonitate nobis superstitem ex animo <lb xml:id="p1z10"/>amat, colit et observat.</s>
					<s n="6" xml:lang="la">Tuae igitur humanitati <lb xml:id="p1z11"/>et insigni modestiae pro tua immensa benefic[entia] <lb xml:id="p1z12"/>in me indignum et nihil tale meritum hominem collata <lb xml:id="p1z13"/>immensas ago atque habeo gratias, immortales <lb xml:id="p1z14"/>vero pro vigiliis et laboribus pro Christi ecclesia <lb xml:id="p1z15"/>susceptis.</s>
					<s n="7" xml:lang="la">Sunt enim, quales hodie collapsae <lb xml:id="p1z16"/>ecclesiae instauratio et instaurate requiri de<lb xml:id="p1z17"/>fensio.</s>
					<s n="8" xml:lang="la">Rem egisti adversus irrequietum <lb xml:id="p1z18"/>hominum genus, furiosum et omnis <foreign xml:lang="el">εὐταξίας</foreign> <lb xml:id="p1z19"/>inimicum longe utilissimam saluberrimamque, <lb xml:id="p1z20"/>unde spero ecclesiae multum frugis rediturum.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z21"/>Dominus benedicat!</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Plura scribere non da<lb xml:id="p1z22"/>tur, deceptus festinantia nunciorum.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z23"/>in domino.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Domino nobis commenda tuis <lb xml:id="p1z24"/>precibus; ego in dies in orationibus meis <lb xml:id="p1z25"/>qualibuscunque tui mentionem facio.</s>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z26"/>Salvere iubeas symmystas, optimos atque <lb xml:id="p1z27"/>doctissimos viros.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><persName ref="p1789">Ioannes Keßlerus</persName>, <lb xml:id="p1z28"/>tui <lb xml:id="p1z29"/>ex animo <lb xml:id="p1z30"/>observantissimus.</s>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Nummum hunc da meo nomine tuae castissimę <lb xml:id="p2z2"/>et tibi charissimę uxori; non enim dubito, <lb xml:id="p2z3"/>qui[n] te in multam noctem lucubrante hibernis <lb xml:id="p2z4"/>his mensibus solicita et senis coniugis <lb xml:id="p2z5"/>miserta longas horas duxerit.</s>
					<s n="16" xml:lang="la">Tu <lb xml:id="p2z6"/>roga, ut humaniter accipiat bonique faciat.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z7"/>Clarissimo viro <lb xml:id="p2z8"/><persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z9"/><placeName ref="l587">Tigurinae</placeName> eccles<lb xml:id="p2z10"/>iae antistiti vigilant<lb xml:id="p2z11"/>issimo, domino suo colen<lb xml:id="p2z12"/>do.</s>
				</p>
			</div>
		</body>
	</text>
