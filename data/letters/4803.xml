	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuas recepi literas scriptas 10. huius mensis.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Puto te meas cum duobus <lb xml:id="p1z2"/>libellis epigrammatum et poematum et literis ad <persName>Flaminium</persName> recepisse.</s>
					<s n="4" xml:lang="la"><placeName ref="l28">Basileam</placeName> <lb xml:id="p1z3"/>cras proficiscar.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quid ibi fieri poterit, nescio.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><persName>Colonellus Frelich</persName> substitutus est <lb xml:id="p1z4"/>arbiter <lb xml:id="p1z5"/>in locum sculteti <persName>Choiller</persName> infirmi.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Optarem moderationem aliquam in legibus <lb xml:id="p1z6"/>vestris municipalibus nec perpetuo agi iure summo.</s>
					<s n="8" xml:lang="la">Possent domini consuetudine <lb xml:id="p1z7"/>frui civium bonorum et frugi, qui multorum annorum poenitentia satis <lb xml:id="p1z8"/>sunt mulctati nec poenam levem aut pecuniariam convertendam in usus pios <lb xml:id="p1z9"/>detrectarent.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Sed de iis aliquando coram.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Ex <placeName ref="l546">Vienna</placeName> intellexi d. <persName>a <lb xml:id="p1z10"/>Willeville</persName>, qui in praefectus est urbi <placeName ref="l322">Metensi</placeName>, profectum eo, ut imperatorem <lb xml:id="p1z11"/>regis nomine salutaret et officium rependeret per aliam legationem <lb xml:id="p1z12"/>ab imperatore pręstitum.</s>
					<s n="11" xml:lang="la" ana="salute">Ibi honorifice exceptus et dimissus 3. huius <lb xml:id="p1z13"/>mensis <placeName ref="l396">Pragam</placeName> petiit, ut etiam principem <persName ref="p18477">Ferdinandum</persName> salutaret et inde <lb xml:id="p1z14"/><placeName ref="l832">Galliam</placeName> repeteret.</s>
					<s n="12" xml:lang="la">Forsan non omnino temere est, quod ad te ex <placeName ref="l18">Augusta</placeName> <lb xml:id="p1z15"/>scriptum; sed nihil certi habeo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Regis sacratio dilata in decimum <lb xml:id="p1z16"/>octavum huius mensis.</s>
					<s n="14" xml:lang="la">Puto <persName ref="p18090">regem Navarre</persName> consuluisse securitati <lb xml:id="p1z17"/>omnium et paci, misit ipse nobiles aliquot et prudentes per omnes <lb xml:id="p1z18"/><placeName ref="l832">Gallię</placeName> provincias, qui populum suaderent ad mutuam concordiam <lb xml:id="p1z19"/>et sedarent tumultus excitatos sacerdotum opere, nec fieret <lb xml:id="p1z20"/>negocium cuiquam pio.</s>
					<s n="15" xml:lang="la">De concilio nulla fere amplius mentio.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z21"/>Alia via electos suos dominus vult in cognitionem sui deducere.</s>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z22"/>Mitto fasciculum litterarum d. <persName ref="p8011">Galthero</persName>, quem oro meis verbis salutes et <lb xml:id="p1z23"/>amicos omnes.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute">Uxor et <persName>Matheolus</persName> te salutant.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z24"/><placeName ref="l760">Solod[uri]</placeName> 17. maii.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z25"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
