	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Reverende in Christo pater, haec nunc sub noctem <lb xml:id="p1z2"/>mihi traduntur a viris <placeName ref="l834">Italis</placeName>, qui <placeName ref="l93">Clavenna</placeName> veniunt <lb xml:id="p1z3"/>et hac <placeName ref="l167">Genevam</placeName> transeunt; vix ergo pauca <lb xml:id="p1z4"/>legendo delibavi, mitto igitur omnia, ut mihi <lb xml:id="p1z5"/>sunt reddita.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Sive liber antehac ad tuas manus <lb xml:id="p1z6"/>pervenit, sin minus, tamen ad illustrem <lb xml:id="p1z7"/>virum <persName ref="p2054">Martinengum</persName> tibi scribendum iudico; multę <lb xml:id="p1z8"/>sunt causae, quas hic non addo; tu pro tua <lb xml:id="p1z9"/>prudentia satis eas intelligis.</s>
				</p>
				<p>
					<s n="4" xml:lang="de">In der <placeName ref="l1434">Etsch</placeName> faacht <lb xml:id="p1z10"/>es an eben hüpschlich an der pestilentz sterben, <lb xml:id="p1z11"/>wie ouch enert der Steig an ettlichen orten; <lb xml:id="p1z12"/>achten ich, werde dem concilio ein end geben.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z13"/>Haec subito.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale, reverende in Christo pater <lb xml:id="p1z14"/>cum tuis omnibus.</s>
					<s n="7" xml:lang="la">19. augusti anno 1563 vesperi.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Nos ex vobis expectamus res <placeName ref="l830">Anglicas</placeName> <lb xml:id="p1z16"/>et <placeName ref="l832">Gallicas</placeName>.</s>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>domino suo et in <lb xml:id="p2z4"/>Christo patri reverendo.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
