	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Rediit <persName>Genatius</persName> ille tuus in negotiorum <lb xml:id="p1z2"/>meorum undis, ita ut non potuerim copio<lb xml:id="p1z4"/>sius scribere tibi vel cum ipso colloqui.</s>
					<s n="3" xml:lang="la">Excarni<lb xml:id="p1z5"/>ficor curis publicis et exhaurior laboribus <lb xml:id="p1z6"/>indesinentibus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Interim confirmat me dominus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Mitto <lb xml:id="p1z7"/>26 conciones nostras in primam Ieremiae <lb xml:id="p1z8"/>orationem et te oro, ut benigne accipias a <lb xml:id="p1z9"/>me munusculum.</s>
					<s n="6" xml:lang="la">Quae habui nova de colloqui<lb xml:id="p1z10"/>o <placeName ref="l569">Wormatiensi</placeName> et de aliis rebus intelliges <lb xml:id="p1z11"/>ex literis ad d. <persName ref="p8009">Fabritium</persName> scriptis et con<lb xml:id="p1z12"/>dona mihi, quod iam aliquoties meis consulens <lb xml:id="p1z13"/>rebus uni scribo et hunc tecum, quae scripsi, <lb xml:id="p1z14"/>communicare iubeo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Non sufficio unus tot scrib<lb xml:id="p1z15"/>endis literis; amanuensi careo, et si esset ad manum, <lb xml:id="p1z16"/>saepe ita festinandum est, ut nihil <lb xml:id="p1z17"/>istius mihi opera profutura fuisset.</s>
					<s n="8" xml:lang="la">Si tuo <lb xml:id="p1z18"/>commodo fieri posset et citra molestiam et de<lb xml:id="p1z19"/>trimentum post nundinas <placeName>Martiniana<lb xml:id="p1z20"/>s</placeName> veni<lb xml:id="p1z21"/>res ad nos expectatus.</s>
					<s n="9" xml:lang="la">Sed quod tibi visum <lb xml:id="p1z22"/>fuerit, facias.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Filium tuum perinde ac meum <lb xml:id="p1z23"/>habeo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale una cum socero et tota tua familia.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/><placeName ref="l587">Tiguri</placeName> 29. octobris 1557.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z25"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z26"/>Non ingratam rem mihi feceris, si miseris ad me <lb xml:id="p1z27"/><persName>Conradi</persName> illius Mantuani ex<lb xml:id="p1z29"/>positionem Apocalypseos<pb/><lb xml:id="p2z1"/>.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z6"/>Et virtute et genere <lb xml:id="p2z7"/>vero nobili viro d. <lb xml:id="p2z8"/><persName ref="p8432">Friderycho a Salice</persName>, <lb xml:id="p2z9"/>domino meo colendissimo <lb xml:id="p2z10"/>et fratri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>