	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non erat opus, compater in domino <lb xml:id="p1z2"/>charissime, mortuas ad te literas, <lb xml:id="p1z3"/>cum viva ad vos omnis vitę meae veniat <lb xml:id="p1z4"/>epistola d. <persName ref="p8018">Hallerus</persName>, dilectus in Christo <lb xml:id="p1z5"/>compater.</s>
					<s n="3" xml:lang="la">Verum eam saltem ob causam scribere <lb xml:id="p1z6"/>volui, ut revertenti ad nos literas <lb xml:id="p1z7"/>vicissim dare non detractes, quibus de <lb xml:id="p1z8"/>futuro antichristianorum conciliabulo quid tibi <lb xml:id="p1z9"/>videatur, scribas.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Nostrorum constantiam <lb xml:id="p1z10"/>satis probare non possum, qui ne consul<lb xml:id="p1z11"/>tandum quidem putant quicquam supra id <lb xml:id="p1z12"/>quod antea est decretum et reliquis con<lb xml:id="p1z13"/>foederatis responsum.</s>
					<s n="5" xml:lang="la">Habent forsan <lb xml:id="p1z14"/>vestri suas rationes quibus ducuntur putantque <lb xml:id="p1z15"/>accuratius aliquid ad <placeName ref="l425">Romani</placeName> tyranni <lb xml:id="p1z16"/>petita posse responderi, quem ego sane <lb xml:id="p1z17"/>nullo dignum arbitror esse responso, et vestri, <lb xml:id="p1z18"/>puto, non illius, sed confoederatorum respectu <lb xml:id="p1z19"/>consultandum esse iudicant.</s>
					<s n="6" xml:lang="la">Miror autem <lb xml:id="p1z20"/>admodum, sintne confoederati vestri, qui <lb xml:id="p1z21"/>adhuc papae partes tuentur, ita stupidi, <lb xml:id="p1z22"/>ut non intelligant ex praeludiis istis, quale <lb xml:id="p1z23"/>futurum sit concilium, quod Martem habet <lb xml:id="p1z24"/>praesultantem, non Christum, principem pacis, <lb xml:id="p1z25"/>praesidentem.</s>
					<s n="7" xml:lang="la">Unde omnino manifestum <lb xml:id="p1z26"/>est usque adeo non agere serio pontificem, <lb xml:id="p1z27"/>quod simulat in causa concilii indicendi, <lb xml:id="p1z28"/>ut malit <placeName ref="l834">Italiam</placeName> propter unicam civitatulam <lb xml:id="p1z29"/>bello involvere et sanguine humactare <lb xml:id="p1z30"/>quam orbi christiano legitima, libera et <lb xml:id="p1z31"/>christiana synodo consulere.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Sed desino <lb xml:id="p1z32"/>de re odiosa et detestabili.</s>
					<s n="9" xml:lang="la">Illud oro, <lb xml:id="p1z33"/>si quid de <placeName ref="l303">Magdeburgensibus</placeName> accepisti, ut <lb xml:id="p1z34"/>communices.</s>
					<s n="10" xml:lang="la">Silentium hoc turbat me; vereor <lb xml:id="p1z35"/>enim, dum nihil de illis refertur, accidisse <lb xml:id="p1z36"/>aliquid, quod bonos nec scire nec referre <lb xml:id="p1z37"/>delectet.</s>
					<s n="11" xml:lang="la" ana="farewell">Optime vale.</s>
					<s n="12" xml:lang="la">Domi meae pacata <lb xml:id="p1z38"/>sunt omnia, deo sit gloria.</s>
					<s n="13" xml:lang="la" ana="salute">Idem opto tuae, <lb xml:id="p1z39"/>quam mei omnes amantissime salutant.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Saluta <lb xml:id="p1z40"/>mei nomine dominos et fratres d. <persName ref="p8127">Pellicanum</persName>, honestissimum <lb xml:id="p1z41"/>senem et ornamentum ecclesię vestrę, d. <persName ref="p8171">Theodorum</persName> <lb xml:id="p1z42"/>et <persName ref="p8011">Gvaltherum</persName> et reliquos.</s>
					<s n="15" xml:lang="la"><placeName ref="l41">Bernę</placeName> 15. iulii 1551.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><persName ref="p8417">W[olfgan<lb xml:id="p1z43"/>gus] Musculus</persName>, compater tuus in domino.</s>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo theo<lb xml:id="p2z2"/>logo m. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/>compatri <lb xml:id="p2z5"/>suo in <lb xml:id="p2z6"/>domino longe <lb xml:id="p2z7"/>charissimo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
