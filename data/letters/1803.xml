	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi heri de rebus aliis.</s>
					<s n="3" xml:lang="la">Nunc nihil habeo, nisi quod has <lb xml:id="p1z2"/>a d. <persName ref="p974">Carolo Molinaeo</persName> (de quo in tuis, quid agat, literis quaeris) <lb xml:id="p1z3"/>interea accepi, in quibus, quid agat et ubi, ex ipso<lb xml:id="p1z4"/>met cognosces, ut mihi non sit opus ea de re scribere.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Scripsi <lb xml:id="p1z5"/>proxime quaedam de illo, quę an acceperis, ignoro.</s>
					<s n="5" xml:lang="la">Historiam <lb xml:id="p1z6"/>pastoris <placeName ref="l869">Transsylvani</placeName> ex parte nosti; expectamus illum hodie; <lb xml:id="p1z7"/>ubi venerit, quę amplius cognovero, ad te scribam.</s>
					<s n="6" xml:lang="la"><persName ref="p3138">Theobaldi</persName>, <lb xml:id="p1z8"/><persName ref="p19">Achatis</persName> sui, causam habebo mihi commendatam.</s>
					<s n="7" xml:lang="la">De <lb xml:id="p1z9"/>ministro comiti <persName ref="p8098">Georgio a Wirtenberg</persName> dando cogitabo; <lb xml:id="p1z10"/>certe rari sunt tales <placeName ref="l832">Galli</placeName>, qualem ipse expetere videtur.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/>Cogitabo tamen de homine pio, docto, modesto, pacifico.</s>
					<s n="9" xml:lang="la" ana="farewell">Interea tu <lb xml:id="p1z12"/>cum tuis omnibus bene vale.</s>
					<s n="10" xml:lang="la"><persName ref="p8011">Gvaltherum</persName> nostrum expect[o]; <lb xml:id="p1z13"/>expectat eundem <persName ref="p3241">Trempius</persName>, qui te una cum illo plurim[um <lb xml:id="p1z14"/>sal]vere iubet.</s>
					<s n="11" xml:lang="la"><placeName ref="l41">Bernę</placeName> 7. februarii 1553.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z15"/><persName ref="p8018">Ioannes Hallerus</persName>, <lb xml:id="p1z16"/>totus tuus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p3429">Viretus</persName> scribit se mox ad te scripturum; nepotem suum se non habere <lb xml:id="p1z18"/>domi necdum illum quicquam certi cum d. <persName ref="p8033">Beza</persName> constituisse; <lb xml:id="p1z19"/>quamprimum autem hoc fuerit factum, eum ad te scripturum, meque <lb xml:id="p1z20"/>ut huius te admoneam, rogat.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z4"/>ecclesiae fidelissimo <lb xml:id="p2z5"/>antistiti, domino et com<lb xml:id="p2z6"/>patri suo longe charis<lb xml:id="p2z7"/>simo.</s>
				</p>
				<p>
					<s n="15" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zürich</placeName>.</s>
					<s n="16" xml:lang="de">M: <persName ref="p495">Heinrych <lb xml:id="p2z9"/>Bullingeren</persName>.</s>
				</p>
			</div>
		</body>
	</text>
