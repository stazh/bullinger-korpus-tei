			<zone xml:id="p2z2-0" points="921,1172 1032,1115 1504,1135 1723,1100 1837,1126 1839,1044 1767,1034 1580,1073 1403,1042 925,1059">928,1125 973,1118 1019,1114 1064,1111 1110,1109 1155,1106 1201,1103 1246,1102 1292,1100 1337,1099 1383,1097 1429,1096 1474,1096 1520,1096 1565,1093 1611,1093 1656,1090 1702,1090 1747,1087 1793,1090 1839,1096</zone>
			<zone xml:id="p2z3-0" points="909,1268 982,1233 1106,1262 1264,1205 1598,1195 1754,1230 1757,1138 1575,1116 1277,1168 1114,1140 912,1166">916,1224 958,1217 1000,1209 1042,1212 1084,1204 1126,1200 1168,1198 1211,1195 1253,1192 1295,1191 1337,1191 1379,1189 1421,1188 1463,1188 1506,1188 1548,1188 1590,1188 1632,1189 1674,1191 1716,1194 1759,1191</zone>
