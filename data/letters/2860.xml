	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ingentes tibi gratias ago, mi d. <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z2"/>tam pro elegantissimo numero(?) argenteo uxori meae do<lb xml:id="p1z3"/>no misso, illi certo vel tuo nomine (quem sancte <lb xml:id="p1z4"/>veneratur) gratissimo, quam etiam, idque magis pro <lb xml:id="p1z5"/>orationibus tuis mihi a te muneri datis.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Placet <lb xml:id="p1z6"/>argumentum et tractatio, libenterque in iis excudendis <lb xml:id="p1z7"/>tibi, quantum per temporis brevitatem, quod ad nundinas <lb xml:id="p1z8"/>iamiam instantes superest, licet, gratificabor.</s>
					<s n="4" xml:lang="la">Ac mitto <lb xml:id="p1z9"/>iam impressionis specimen, in qua pro virili dabo operam, <lb xml:id="p1z10"/>ut, si non ita eleganter, ut cuperemus, (properandum <lb xml:id="p1z11"/>enim est, et sunt multa adhuc etiam alia absolvenda, in <lb xml:id="p1z12"/>quibus tota hac hyeme desudatum nobis est), saltem quam <lb xml:id="p1z14"/>fieri emendatissime potest, iis excudendis nostram erga te observantiam <lb xml:id="p1z15"/>et singulari vicissim tibi gratificandi studium <lb xml:id="p1z16"/>declaremus.</s>
					<s n="5" xml:lang="la">Cęterum scripsit ad me <persName ref="p1227">Froschoverus</persName> se <lb xml:id="p1z17"/>mihi etiam conciones tuas in Apocalypsim missurum; quod <lb xml:id="p1z18"/>si fecerit, libenter et tibi et illi mea opera ad proximam <lb xml:id="p1z19"/>aestatem gratificabor, si dominus et vitam et sanitatem nobis <lb xml:id="p1z20"/>ut hactenus produxerit.</s>
					<s n="6" xml:lang="la">Unum adhuc scrupulum habeo, <lb xml:id="p1z21"/>suone an meo (quod equidem malim) sumptu ac <lb xml:id="p1z22"/>nomine impressionem fieri velit, quamquam, utrum ei libuerit, <lb xml:id="p1z23"/>operam meam non detrectabo, pro virili tamen et facultatibus, <lb xml:id="p1z24"/>quę si paulo essent instructiores, nulli omnium typographorum <lb xml:id="p1z25"/>neque industria neque laborum tolerantia cederem.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z26"/>Sed desino teque diu nobis et ecclesię superstitem atque incolumem o<lb xml:id="p1z27"/>pto <lb xml:id="p1z28"/>et ex animo precor.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l28">Basileae</placeName> <lb xml:id="p1z29"/>13. martii 1556.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z30"/><persName ref="p8126">Ioannes Oporinus</persName> tuus <lb xml:id="p1z31"/>ex animo.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Optimo atque doctissimo <lb xml:id="p2z2"/>viro d. <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesię pastori, <lb xml:id="p2z5"/>domino et amico <lb xml:id="p2z6"/>suo in primis <lb xml:id="p2z7"/>colendo.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
