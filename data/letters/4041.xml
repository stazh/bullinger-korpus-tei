	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><persName ref="p3276">Ungnadius</persName>, qui ad vos scribit viri clarissimi, etsi stematum <lb xml:id="p1z2"/>rerum gestarum gloria vir sit magnus, tamen id vobis coram <lb xml:id="p1z3"/>deo polliceri atque affirmare ausim pietate omnia superare sua.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Quapropter, quicquid in istum hominem contuleritis, id ipsi <lb xml:id="p1z5"/>deo optimo maximo datum existimatote.</s>
					<s n="4" xml:lang="la">Rem accelerate, rogo, et, <lb xml:id="p1z6"/>si fieri potest, vestrum iuditium per hunc nuncium, quem intra <lb xml:id="p1z7"/>quinque dies hic esse omnino oportet (nam ad <persName ref="p3276">Ungnadium</persName> mittendus <lb xml:id="p1z8"/>est) scribite.</s>
					<s n="5" xml:lang="la">Quodsi negotia vestra obstiterint, quantocyus <lb xml:id="p1z9"/>fieri potest, rem perpendatis, rogo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Quem mitto, affirmo virum simplicem, bonum; is inserviret homini <lb xml:id="p1z11"/>bono in re familiari fideliter, agnovi suos, vel etiam cauponi <lb xml:id="p1z12"/>non adeo incommodus esset.</s>
					<s n="7" xml:lang="la">Si quid ei hac in re prodesse poteritis, <lb xml:id="p1z13"/>in me recipiam factum vestrum omne.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Salvete et valete, viri optimi.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z14"/><persName ref="p1214">Frisio</persName> multas salutes.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l28">Basileae</placeName> 11. augusti anno 59.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z15"/>Vester deditissimus <persName ref="p1536">F. <lb xml:id="p1z16"/>Herold</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Viri<pb/><lb xml:id="p2z1"/>s clarissimis <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName> ac <persName ref="p8171">Theodoro <lb xml:id="p2z3"/>Bibliandro</persName>, <lb xml:id="p2z4"/>dominis et amicis.</s>
				</p>
			</div>
		</body>
	</text>
