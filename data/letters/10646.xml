	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>O me terque quaterque miserum<note xml:id="fn1" type="footnote" n="1">Zur Redensart vgl. Lateinisches Hexameter-Lexikon. Dichterisches Formelgut von Ennius bis zum Archipoeta, zusammengestellt v. <bibl source="b473">Otto</bibl> Schumann, Teil 5, München 1982. -Monumenta Germaniae Historica, Hilfsmittel IV/5, S. 432-434.</note>, qui toties polliceor<note xml:id="fn2" type="footnote" n="2">Siehe oben <ref target="file10626">Nr. 588</ref>, 2f.</note> <lb xml:id="p1z2"/>proximo semper tabellione me responsurum, cum hoc <lb xml:id="p1z3"/>ipsum nec iam faciam<note xml:id="fn3" type="footnote" n="3">Vgl. unten Anm. 10.</note>.</s>
					<s n="2" xml:lang="la">Sed solus candor tuus me <lb xml:id="p1z4"/>consolatur, deinde, quod non ignoras, quantum inter os <lb xml:id="p1z5"/>et offam intervenire possit<note xml:id="fn4" type="footnote" n="4">Vgl. Adagia, 1, 5, 2 (<bibl source="b370">LB</bibl> II 182); <bibl source="b473">Otto</bibl> 259,Nr. 1311.</note>.</s>
					<s n="3" xml:lang="la">Scripsit autem ad te <lb xml:id="p1z6"/>consobrinus <persName ref="p8178">Thomas</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p8178">Thomas Blarer</persName> hatte am 16. Juni an <persName ref="p495">Bullinger</persName> geschrieben, s. oben <ref target="file10630">Nr. 592</ref>.</note>.</s>
					<s n="4" xml:lang="la">Deinde non dubito, quin coram <lb xml:id="p1z7"/>de multis tecum contulerit<note xml:id="fn6" type="footnote" n="6">Nämlich bei seinem Besuch in <placeName ref="l587">Zürich</placeName> vor Mitte Juni 1535, vgl. oben <ref target="file10630">Nr. 592</ref>, 2 mit Anm. 1.</note>, praecipue quoque de praedestinationis <lb xml:id="p1z8"/>sententia, deinde, ut sese res habeant in <placeName ref="l572">Wir<lb xml:id="p1z9"/>tenbergensi</placeName> ducatu.</s>
					<s n="5" xml:lang="la">Hinc certe excusari possum, <lb xml:id="p1z10"/>si non modo differam, sed totus cessem de hisce <lb xml:id="p1z11"/>scribere, quorum<note xml:id="fna" type="footnote" n="a"><hi>vor</hi> quorum <hi>gestrichenes</hi> de.</note> ille te per literas et coram <lb xml:id="p1z12"/>fecit certissimum.</s>
					<s n="6" xml:lang="la">Deinde fieri potest, ut<pb type="edition" next="265"/> fratrem <lb xml:id="p1z13"/><persName ref="p4082">Chuͦnradum</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p4082">Konrad Zwick</persName>.</note> brevi videas apud <placeName ref="l587">Tigurum</placeName><note xml:id="fn8" type="footnote" n="8">Entgegen dieser Ankündigung kam <persName ref="p4082">Konrad Zwick</persName> nicht nach <placeName ref="l587">Zürich</placeName>, vgl. unten <ref target="file10660">Nr. 622</ref>, 121f.</note>.</s>
					<s n="7" xml:lang="la">Tum quoque <lb xml:id="p1z14"/>pro mutis literis habebis vivas.</s>
					<s n="8" xml:lang="la">Libellum tamen <lb xml:id="p1z15"/>remitto<note xml:id="fn9" type="footnote" n="9">Gemeint ist <persName ref="p495">Bullingers</persName> Karlstagsrede über die Prädestination, vgl. oben <ref target="file10626">Nr. 588</ref>, 2-4, und <ref target="file10630">Nr. 592</ref>, Anm. 2.</note>, ne forte aegre isto careas.</s>
					<s n="9" xml:lang="la">Responsionem <lb xml:id="p1z16"/>expecta<note xml:id="fn10" type="footnote" n="10"><persName ref="p4079">Zwick</persName> nahm am 27. Juli ausführlich zu <persName ref="p495">Bullingers</persName> Prädestinationsschrift Stellung, s. unten <ref target="file10660">Nr. 622</ref>, 1-76.</note>.</s>
					<s n="10" xml:lang="la">Nunc, si me eneces, dare non possum.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z18"/>Unum hoc addo, <persName ref="p6402">Sympertum</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p6402">Simprecht Schenck</persName>.</note> <placeName ref="l320">Memmingensem</placeName> a <persName ref="p5565">Capitone</persName> <lb xml:id="p1z19"/>et <persName ref="p467">Bucero</persName> vocatum <placeName ref="l491">Argentoratum</placeName>.</s>
					<s n="12" xml:lang="la">Per nos eo pr<lb xml:id="p1z20"/>ofectus est.</s>
					<s n="13" xml:lang="la">Causam vocationis ignorat, sed nisi <lb xml:id="p1z21"/>me fallat nasus, non nihil olfacio<note xml:id="fn12" type="footnote" n="12">Zur Redensart vgl. <bibl source="b56">Adagia</bibl>, 1, 6, 81 (<bibl source="b370">LB</bibl> II 253f). - <persName ref="p4079">Zwicks</persName> nachfolgende Vermutungen treffen nicht zu, wie er am 27. Juli selbst feststellte (s. unten <ref target="file10660">Nr. 622</ref>, 116-120). <persName ref="p467">Bucer</persName>, <persName ref="p5565">Capito</persName> und <persName ref="p8055">Ambrosius Blarer</persName> wollten <persName ref="p6402">Schenck</persName> wegen eines Fehltritts möglichst ohne Aufsehen aus <placeName ref="l320">Memmingen</placeName> entfernen; vgl. <bibl source="b51">Blarer BW</bibl> I 698f. 701. 734. 738.</note>.</s>
					<s n="14" xml:lang="la"><persName ref="p6402">Sympertus</persName> <lb xml:id="p1z22"/>tardior hactenus fuit in amplectenda sententia <lb xml:id="p1z23"/>exhibitionis illius ipsissimę corporis Christi in coena, <lb xml:id="p1z24"/><persName ref="p467">Bucero</persName> quoque non nihil restitit <placeName ref="l320">Memmingae</placeName>; ergo <lb xml:id="p1z25"/><placeName ref="l491">Argentoratum</placeName> vocatus esse potest, ut hanc sententiam <lb xml:id="p1z26"/>imbibat.</s>
					<s n="15" xml:lang="la">Deinde, cum <persName ref="p467">Bucerus</persName>, certe honorantissimus <lb xml:id="p1z27"/>vir, totus in hoc sit (quod suspicor), ut ecclesiarum <lb xml:id="p1z28"/>aliquot <placeName ref="l2481">Sveviae</placeName> in unum coeant et iuxta oeconomiam<pb type="scan" next="||18"/> <pb/><lb xml:id="p2z1"/>ad <placeName ref="l1097">Monasterienses</placeName> scriptam<note xml:id="fn13" type="footnote" n="13">Gemeint ist <persName ref="p467">Bucers</persName> "Bericht auß der heyligen geschrift... der Stat und kirchen zu <placeName ref="l1097">Münster in Westfal</placeName> erstlich geschriben", s. <bibl source="b6">HBBW IV</bibl> <ref target="file10387">[Nr. 355]</ref>, S. 124, Anm. 3.</note> reconcilientur, <persName ref="p6402">Sympertus</persName> <lb xml:id="p2z2"/>vero non videatur accessurus, vocatus est fortassis, <lb xml:id="p2z3"/>ut huius rei causa plenius instituatur.</s>
					<s n="16" xml:lang="la">Interim <lb xml:id="p2z4"/>absente <persName ref="p6402">Symperto</persName><note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> <persName ref="p3481">Symperto</persName> <hi>gestrichenes</hi> <persName ref="p8440">Gervasio</persName>.</note> <persName ref="p8440">Gervasius</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p8440">Gervasius Schuler</persName>.</note> agit, quod <lb xml:id="p2z5"/>illo praesente aut non posset aut non tam comode <lb xml:id="p2z6"/>posset.</s>
					<s n="17" xml:lang="la">Habet <persName ref="p467">Bucerus</persName> <placeName ref="l513">Ulmensem</placeName> <persName ref="p1055">Frechtum</persName>, <lb xml:id="p2z7"/>habet iam fratres <placeName ref="l18">Augustanos</placeName>, qui sese subscripserunt<note xml:id="fn15" type="footnote" n="15">Vgl. unten <ref target="file10663">Nr. 625</ref>, Anm. 7.</note>, <lb xml:id="p2z8"/>si modo bona fide et ex conscientia.</s>
					<s n="18" xml:lang="la">Ex <placeName ref="l491">Argentorato</placeName> <lb xml:id="p2z9"/>vero prodit lex.</s>
					<s n="19" xml:lang="la">Quodsi <placeName ref="l320">Memmingam</placeName> addiderit, de <lb xml:id="p2z10"/>reliquis ecclesiis forte minus est sollicitus.</s>
					<s n="20" xml:lang="la">De nostra <lb xml:id="p2z11"/>ecclesia nihil est, quod speret.</s>
					<s n="21" xml:lang="la"><persName ref="p8055">Ambrosium</persName><note xml:id="fnc" type="footnote" n="c"><hi>vor</hi> <persName ref="p8055">Ambrosius</persName> <hi>gestrichenes</hi> nisi.</note><note xml:id="fn16" type="footnote" n="16"><persName ref="p8055">Ambrosius Blarer</persName>.</note> an <lb xml:id="p2z12"/>habeat, plane nescio.</s>
					<s n="22" xml:lang="la">Sunt autem, qui suspicantur <lb xml:id="p2z13"/><persName ref="p467">Bucerum</persName> cum <persName ref="p5565">Capitone</persName> in <placeName ref="l832">Galliam</placeName> abiturum, <lb xml:id="p2z14"/><persName ref="p6402">Sympertum</persName> interim facturum offitium <placeName ref="l491">Argentorati</placeName>, <lb xml:id="p2z15"/>cum <placeName ref="l320">Memminga</placeName> illo non difficulter carere <lb xml:id="p2z16"/>possit.</s>
					<s n="23" xml:lang="la">Utcumque sit, brevi scivero.</s>
					<s n="24" xml:lang="la">Orandus <lb xml:id="p2z17"/>interim dominus, ne inducat nos in tentationem<note xml:id="fn17" type="footnote" n="17">Vgl. <cit type="bible"><ref>Mt 6, 13 par</ref></cit>.</note>.</s>
				</p>
				<p>
					<s n="25" xml:lang="la" ana="farewell"><lb xml:id="p2z18"/>Vale cum charissimo meo <persName ref="p8127">Pellicano</persName> et <lb xml:id="p2z21"/>familiis vestris.</s>
				</p>
				<p>
					<s n="26" xml:lang="de">3. iulii 1535.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p2z22"/>Parce, obsecro, tam minime latinae scriptioni<lb xml:id="p2z23"/>.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p2z26"/>Tuus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf S. 24:]</note>
					<s n="29" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro d. <persName ref="p495">Hainricho <lb xml:id="p4z2"/>Bullingero</persName>, domino et fratri <lb xml:id="p4z3"/>observandissimo.</s>
				</p>
			</div>
		</body>
	</text>
