	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Sessiones recepi, domine et frater colendissime, nec scio, <lb xml:id="p1z2"/>quorum culpa postremo in tuas manus venerint, <lb xml:id="p1z3"/>cum volueram, ut in tuas et <persName ref="p1278">Gastii</persName> primum venirent.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Si hic aliquando ingratus aut iniquus in me <lb xml:id="p1z5"/>fuit, id nescivi hactenus; certe fideliter curat omnia, <lb xml:id="p1z6"/>quae illi committo, quibus sane honoris causa te oneratum <lb xml:id="p1z7"/>nolo.</s>
					<s n="4" xml:lang="la">Magno cum animi mei dolore tibi nuncio pi<lb xml:id="p1z8"/>issimum et doctissimum symmystam fratrem meum charissimum <lb xml:id="p1z9"/>d. <persName ref="p8459">Otthonem Werdmullerum</persName> heri in noctis principi<lb xml:id="p1z10"/>o ad horam nonam e tenebris huius saeculi sana <lb xml:id="p1z11"/>fide migrasse ad lucem illam aeternam.</s>
					<s n="5" xml:lang="la">Optime <lb xml:id="p1z12"/>quidem cum ipso factum fatentur omnes, qui his liberatus <lb xml:id="p1z13"/>et molestiis et malis, quae dominus ommit[t]et <lb xml:id="p1z14"/>ingratissimo huic saeculo; sed nobis interim symmystis <lb xml:id="p1z15"/>et fratribus maximum reliquit maerorem.</s>
					<s n="6" xml:lang="la">Scis, qualis <lb xml:id="p1z16"/>fuerit, pius, beneficus, modestus, diligens et <lb xml:id="p1z17"/>solide doctus et mei imprimis amans.</s>
					<s n="7" xml:lang="la">Dominus, qui dat <lb xml:id="p1z18"/>ecclesiae suae doctores et pastores, alium in locum <lb xml:id="p1z19"/>eius sufficiat ecclesiae suae utilem.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Bellum hoc <placeName ref="l822">Ger<lb xml:id="p1z20"/>manicum</placeName> secundum ita me excrutiat ut nihil aeque.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z21"/>Multa metuo; si Caesar prior occuparit <placeName ref="l491">Argen<lb xml:id="p1z22"/>toratum</placeName>, brevi mira videbis.</s>
					<s n="10" xml:lang="la">Utinam, utinam <lb xml:id="p1z23"/><placeName ref="l822">Germani</placeName> adhuc agerent poenitentiam; utinam nos <lb xml:id="p1z24"/>omnes ardentiores ad dominum preces funderemus et vitam <lb xml:id="p1z25"/>pessimam mutaremus; non enim erit <lb xml:id="p1z26"/>ulla salus in equitatu <placeName ref="l832">Gallico</placeName> aut peditatu <lb xml:id="p1z27"/><placeName ref="l822">Germanico</placeName>, sed in misericordia dei nostri.</s>
					<s n="11" xml:lang="la">Quid agant <lb xml:id="p1z28"/>et consultent Pagani, dubito, scio autem certissimo <lb xml:id="p1z29"/>illos sui similes futuros, donec etc.</s>
					<s n="12" xml:lang="la">Ingentem <lb xml:id="p1z30"/>dolorem concipio ex moribus nostris nec aliud ex<lb xml:id="p1z31"/>pecta quam infanda mala.</s>
					<s n="13" xml:lang="la">Dominus misereatur nostri.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z32"/>Libellum meum nuper missum te accepisse spero, <lb xml:id="p1z33"/>eum puto, quo purgo ecclesias nostras a labe <lb xml:id="p1z34"/>haereseos et schismatis etc.</s>
					<s n="15" xml:lang="la" ana="salute">Salutant te fratres <lb xml:id="p1z35"/>et mei imprimis generi tres, <persName ref="p7228">Zvinglius</persName>, <persName ref="p1888">Lavaterus</persName> <lb xml:id="p1z36"/>et <persName ref="p8442">Simlerus</persName>, affinis <persName ref="p8011">Gvaltherus</persName> et domini ac <lb xml:id="p1z37"/>fratres <persName ref="p8127">Pellicanus</persName>, <persName ref="p8171">Theodorus</persName>, <persName ref="p1283">Gessnerus</persName>, <persName ref="p3988">Wolphius</persName> <lb xml:id="p1z38"/>et <persName ref="p1214">Frisius</persName> etc.</s>
					<s n="16" xml:lang="la" ana="farewell">Vale.</s>
					<s n="17" xml:lang="la">26. martii 1552.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p8418">Osvaldo <lb xml:id="p2z2"/>Myconio</persName>, <placeName ref="l28">Basiliensis</placeName> <lb xml:id="p2z3"/>ecclesiae fido pastori, <lb xml:id="p2z4"/>domino et fratri suo <lb xml:id="p2z5"/>colendissimo et charissimo.</s>
					<s n="20" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
