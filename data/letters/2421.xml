	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Gratę mihi fuerunt tę, sed tristes admodum, doctissime <lb xml:id="p1z2"/><persName ref="p495">Bullingere</persName>, quod id non praestiterint, quod maxim<lb xml:id="p1z3"/>e <lb xml:id="p1z4"/>volui, nempe rerum <placeName ref="l862">Helveticarum</placeName> statum; nam <lb xml:id="p1z5"/>quod plerique optant, id ego multum timeo, ne dissidiis <lb xml:id="p1z6"/>mutuis concidatis exemplo procerum <placeName ref="l822">Germanię</placeName>, qui eo <lb xml:id="p1z7"/>rem adegerunt mutua diffidentia, ut iam etiam si vellent, <lb xml:id="p1z8"/>sed nolunt adhuc, non possent futurm cavere imperii <lb xml:id="p1z9"/>interitum.</s>
					<s n="3" xml:lang="la">Ita fieri solet, cum privata spectamus, <lb xml:id="p1z10"/>ut neque publicum nec privatum obtineamus; nam <lb xml:id="p1z11"/>neglecto publico quomodo constabit privatum?</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z12"/>Quod tamen aucupantur precipui principes, <lb xml:id="p1z13"/><placeName ref="l749">Saxones</placeName> fere omnes, stipendiorum pinguium dulcedine <lb xml:id="p1z14"/>inescati ab <placeName ref="l830">Anglo</placeName> pendent, idem faciunt <placeName ref="l1041">Brunsvice<lb xml:id="p1z15"/>nses</placeName> fere omnes, evangelici non minus quam papiste <lb xml:id="p1z16"/>et marchiones aliquot.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Actum igitur iam est de <lb xml:id="p1z17"/>imperii libertate.</s>
					<s n="6" xml:lang="la">Dominus det servitutem corporum <lb xml:id="p1z18"/>tollerabilem, ut vel aliqua libertas conscientiarum maneat <lb xml:id="p1z19"/>superstes; sed hec valde periclitatur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z20"/>Dicunt <placeName ref="l41">Bernates</placeName> magis inclinati ad propagandum <lb xml:id="p1z21"/>imperium et faciendum amplius lucrum quam ad <lb xml:id="p1z22"/>conservandam vel evangelii doctrinam vel ad <lb xml:id="p1z23"/>retinendam <placeName ref="l862">Helveticam</placeName> libertatem multo sanguine <lb xml:id="p1z24"/>partam.</s>
					<s n="8" xml:lang="la">Struuntur vobis insidię undequaque; sed <lb xml:id="p1z25"/>sopiti fortasse in utranque aurem ob dormiendo <lb xml:id="p1z26"/>peribitis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Videtis coram, quid futurum sit et quam prope perditio; <lb xml:id="p1z27"/>sed que pharmaca parantur presentibus morbis?</s>
					<s n="10" xml:lang="la">Valde <lb xml:id="p1z28"/>cupio scire, quid vobis immineat; pars adversa pessima <lb xml:id="p1z29"/>quevis minatur, optat et parat.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z30"/>Mitto ad te literas per filium, qui te cum <persName ref="p1283">Gessnero</persName> et <persName ref="p8011">Gvaltero</persName> a<lb xml:id="p1z31"/>tque toto sodalitio literario et ecclesiastico plurimum valere <lb xml:id="p1z32"/>optat, ad me hodie ex <placeName ref="l834">Italia</placeName> missas.</s>
					<s n="12" xml:lang="la">Si quid <lb xml:id="p1z33"/>voles rescribere, fac, ut habeam; citius... in <placeName ref="l834">Italiam</placeName> quam <lb xml:id="p1z34"/>Tygurum perferentur<lb xml:id="p1z35"/>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/><placeName ref="l569">Wormatię</placeName> res religionis pessime habent; nam aper <lb xml:id="p2z2"/>ille <persName>Chaelidonius Eduardus Schnepfius</persName> expostulavit cum <lb xml:id="p2z3"/><persName>Philippo</persName> et <persName ref="p458">Brentio</persName> atque cum aliis fere omnibus et <lb xml:id="p2z4"/>eis Zvinglianę, ut vocat, hereseos accusavit <lb xml:id="p2z5"/>neque ullis sanioribus consiliis mitigari potuit, <lb xml:id="p2z6"/>sed rogatus magis atque magis furere coepit.</s>
					<s n="14" xml:lang="la">Hoc <lb xml:id="p2z7"/>inter nostros scisma, papistica lues, dum sensus <lb xml:id="p2z8"/>statim... cogitarunt; et hoc sibi et suę causę <lb xml:id="p2z9"/>accomodarunt, ob id legem inierunt, ne quis amplius <lb xml:id="p2z10"/>cum evangelicis colloqueretur, nisi evangelici uno ore <lb xml:id="p2z11"/>Zvinglianismum damnarent et ab confessione <lb xml:id="p2z12"/><placeName ref="l18">Augustana</placeName> secluderent.</s>
					<s n="15" xml:lang="la">Turbati sunt principum <lb xml:id="p2z13"/>legati et pii omnes.</s>
					<s n="16" xml:lang="la">Hec ad ducem <placeName ref="l619">Bavarię</placeName> in <lb xml:id="p2z14"/>proposito animandum scripsit <persName>Georgius Soldinius</persName>, <lb xml:id="p2z15"/>olim <persName>Cęsareus</persName> vicecancellarius, iam Bavaricus <lb xml:id="p2z16"/>consiliarius, et addit colloquium vel illico Lutheranorum <lb xml:id="p2z17"/>dissidio solutum iri vel fore valde diuturnum, sed <lb xml:id="p2z18"/>utrumque cum magno catholicorum honore et bono.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z19"/>Ago gratias immortales pro libro in Apocalipsin doctissi<lb xml:id="p2z20"/>mo; valde etiam placuit libellus sacrament[<lb xml:id="p2z21"/>arius]; <lb xml:id="p2z22"/>optarem illum legi a precipuis principibus et huic <lb xml:id="p2z23"/>consilio obtemperari.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Magis timeo in <placeName ref="l749">Saxonia</placeName> <lb xml:id="p2z24"/>evangelii interitum quam in media <placeName ref="l619">Bavaria</placeName>.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z25"/>Rogo te diligenter, ut me certiorem facias, quid <lb xml:id="p2z26"/>de periculo, quo <persName>Gallus</persName> cingitur, sit augurandum <lb xml:id="p2z27"/>et num spes sit aliqua, ut se vel extricare vel <lb xml:id="p2z28"/>talionem reddere possit.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><persName>Gallum</persName> novi, quo sit <lb xml:id="p2z29"/>in religionem animo, quam sint <persName>Galli</persName> insolentes, super<lb xml:id="p2z30"/>bi et temerarii; sed nolim eum succumbere, ne <lb xml:id="p2z31"/>casus illius nos et communem causam cadere faciat.</s>
					<s n="21" xml:lang="la"><lb xml:id="p2z32"/>Valde iam sum tristis et sollicitus de futuro evangelii <lb xml:id="p2z33"/>excidio.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="farewell">Vale, doctissime <persName ref="p495">Bullingere</persName>, et rescribe ocyus.</s>
					<s n="23" xml:lang="la"><lb xml:id="p2z34"/><placeName>Foedus Bavaricum</placeName> cum sponsa nova, federe nimirum <lb xml:id="p2z35"/>Franconico, hisce diebus hic fuerunt.</s>
					<s n="24" xml:lang="la"><lb xml:id="p2z36"/><placeName ref="l18">Augustę</placeName> ocyssime.</s>
					<s n="25" xml:lang="la">9. octobris anno etc. 54<pb/><lb xml:id="p3z1"/>.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p3z2"/><persName ref="p2856">G[ereon]</persName> <lb xml:id="p3z3"/>t[<lb xml:id="p3z4"/>uus].</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><pb/><lb xml:id="p4z1"/>Doctissimo pientissimoque viro d. <lb xml:id="p4z2"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p4z3"/>domino et amico perpetua <lb xml:id="p4z4"/>veneratione colendo.</s>
				</p>
			</div>
		</body>
