	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi pridie, quae te scire volui, reverende in <lb xml:id="p1z2"/>Christo pater.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Nunc te scire itidem volo literas <lb xml:id="p1z3"/>illas <persName ref="p540">Calvini</persName> ad <persName ref="p8093">Herculem</persName> auspicato <lb xml:id="p1z4"/>admodum venisse; iamiam enim aderat, <lb xml:id="p1z5"/>qui proficisceretur, et quidem eques, ita ut <lb xml:id="p1z6"/>existimem eum literas habere.</s>
					<s n="4" xml:lang="la">Interim d. <persName>Condensis</persName> <lb xml:id="p1z7"/>ad nostros scribet; quidam viri primarii <lb xml:id="p1z8"/>(sic futurum spero), nam ipsis satis de voluntate <lb xml:id="p1z9"/><placeName ref="l648">Rhętorum</placeName> constare potest, se <placeName ref="l167">Genevam</placeName> conferent.</s>
					<s n="5" xml:lang="la">(<lb xml:id="p1z10"/>Expecto tamen <persName ref="p8093">Herculem</persName>, cum quo omnia), <lb xml:id="p1z11"/>sed hodie quoque, si possum, cum <persName>Carlino</persName> omnia.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Tu si scribis, procura literis tuis, ut, cum nostri <lb xml:id="p1z13"/>venerint, <placeName ref="l167">Genevae</placeName> benigne recipiantur.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Etsi interim dei beneficio res ad aliquam <lb xml:id="p1z15"/>pacificationem tolerabilem spectaret (quod tamen <lb xml:id="p1z16"/>non crediderim) aut si nostris victoria <lb xml:id="p1z17"/>contingeret, ita ut illustrissimo principi <lb xml:id="p1z18"/>nostrorum opera amplius opus non esset, saltem <lb xml:id="p1z19"/>ita tractarentur, ut longum iter non frustra <lb xml:id="p1z20"/>suscepisse videantur.</s>
					<s n="8" xml:lang="la">Venit ad vos <lb xml:id="p1z21"/>praefectus urbis nostrae, de quo ante.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Rogo, <lb xml:id="p1z22"/>ut causam boni viri <placeName ref="l530">Walenstadiensis</placeName> <lb xml:id="p1z23"/>habeas commendatam.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale, reverende in <lb xml:id="p1z24"/>Christo pater.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l98">Curię</placeName> 22. iunii.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">T[uus] <persName ref="p8009">F[abricius</persName>].</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bulingero</persName>, <lb xml:id="p2z3"/>domino et patri suo <lb xml:id="p2z4"/>in Christo reverendo.</s>
				</p>
				<p>
					<s n="14" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zürych</placeName> an h. <persName ref="p495">Bullinger</persName>.</s>
				</p>
			</div>
		</body>
	</text>
