			<graphic xml:id="img4-0" url="https://media.sources-online.org/cantaloupe/iiif/3/bullinger!4350!Autograph!03%20Ms_F_82_69_70_00004.tif/full/max/0/default.jpg" height="5441px" width="3477px" n="4">
