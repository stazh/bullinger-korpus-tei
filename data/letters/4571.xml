	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Puto te meas accepisse, quas octo abhinc diebus ad te <lb xml:id="p1z2"/>scripsi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Misi una excerpta ex literis, quas ab <placeName ref="l834">Italia</placeName> receperam.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z3"/>Nunc filius intelligens esse, qui ad te proficiscitur, non potuit <lb xml:id="p1z4"/>manum continere a calamo.</s>
					<s n="5" xml:lang="la">Ego etiam, ne nihil esset, quod scriberem, <lb xml:id="p1z5"/>his indicare volui me a <placeName ref="l1854">Redonensi</placeName> episcopo literas accepisse, quibus <lb xml:id="p1z6"/>signifficat tres potiores principes consentire de concilio <placeName ref="l1107">Trident<lb xml:id="p1z7"/>ino</placeName>; scrupulum restare, si nova indictio fieri debeat an <lb xml:id="p1z8"/>ultimi continuatio, quam urget pontifex.</s>
					<s n="6" xml:lang="la">Filiam vult dare imperator <lb xml:id="p1z9"/>duci <placeName ref="l1060">Mantuano</placeName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Regem puto convaluisse a catarro et omnia fore quietiora <lb xml:id="p1z10"/>in <placeName ref="l832">Gallia</placeName>.</s>
					<s n="8" xml:lang="la" ana="salute">Uxor te salutat et amicos omnes mecum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l760">Solut[uri]</placeName> <lb xml:id="p1z11"/>7. decembris.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z12"/>Tuus ex animo [subscripsit].</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesie <placeName ref="l587">Tigurine</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
