	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Venit ad nos evangelista <placeName ref="l294">Luggarnensis</placeName>, qui pontificis <lb xml:id="p1z2"/>legatos, qui in via sunt, vidit.</s>
					<s n="3" xml:lang="la">Haec tu consuli <lb xml:id="p1z3"/>nostro significa, ut domum festinet.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Lege literas <lb xml:id="p1z4"/><persName ref="p8093">Hercules a Salicibus</persName> et alias remitte.</s>
					<s n="5" xml:lang="la"><placeName ref="l2448">5 Pagici</placeName> <lb xml:id="p1z5"/>nihil non tentat.</s>
					<s n="6" xml:lang="la">Quid impedit nos in Christi <lb xml:id="p1z6"/>causa aeque esse fortes, etsi modestiae limitis <lb xml:id="p1z7"/>transiliisse videamur?</s>
					<s n="7" xml:lang="la">Sed age, communicato <lb xml:id="p1z8"/>cum d. consule <persName ref="p3196">Tscharnero</persName>, an utile sit et <lb xml:id="p1z9"/>consultum vestros scribere.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Hęc subito admodum; <lb xml:id="p1z10"/>evangelista noluit expectare.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l98">Cur</placeName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Tuus <lb xml:id="p1z11"/><persName ref="p8009">F[abricius]</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Significate etiam domino <persName ref="p629">Coignetio</persName> <lb xml:id="p1z12"/>legatorum adventum.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z13"/>Literas d. <persName ref="p8093">Herculis</persName> remitte.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vere magno viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/>d. suo.</s>
				</p>
			</div>
		</body>
	</text>
