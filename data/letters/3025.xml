	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia Christi tecum.</s>
					<s n="2" xml:lang="la">Fasciculum abs te missum, optime <lb xml:id="p1z2"/><persName ref="p495">Bullingere</persName>, una cum literis tuis 12. septembris mi<lb xml:id="p1z3"/>hi allatum accepi.</s>
					<s n="3" xml:lang="la">Misi hoc principi nostro per <lb xml:id="p1z4"/>doctorem <persName>Alexandrum Puerum</persName> simul te literis <lb xml:id="p1z5"/>meis commendans, ut veterem agnoscat amicum.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Si responderit tibi litteras ad te mihi commendans <lb xml:id="p1z7"/>recipies brevi, aut si alio modo, intelliges <lb xml:id="p1z8"/>tamen, ut spero, animum illius abs te non esse <lb xml:id="p1z9"/>alienatum.</s>
					<s n="5" xml:lang="la">Alacer nunc est et ludicer, habens, quod <lb xml:id="p1z10"/>agatur.</s>
					<s n="6" xml:lang="la">Gratulatur sibi futuri successoris, si dei <lb xml:id="p1z11"/>gratia superstes fuerit, maiestatem, quod scilicet natus <lb xml:id="p1z12"/>sit ex folia Cattorum etc.</s>
					<s n="7" xml:lang="la">Quod utinam et ecclesię <lb xml:id="p1z13"/>et nobis foelix sit et faustum.</s>
					<s n="8" xml:lang="la">Audio ab iis, qui con<lb xml:id="p1z14"/>tractu sponsalibusque interfuerunt, cautum esse itteris <lb xml:id="p1z15"/>scriptis signatisque, ne post mortem principis nostri <lb xml:id="p1z16"/>vel Cattus vel dux <persName>Christophorus</persName> in religionis ne<lb xml:id="p1z17"/>gotio apud nos vel tantulum mutare audeant etc.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/>Gratulamur proinde et ecclesię et nobis, ne cogamur <lb xml:id="p1z19"/>vestem lineam superponere laneę exque interula facere <lb xml:id="p1z20"/>exterulam, ut ita dicam, vespertinasque canere <lb xml:id="p1z21"/>preces Latine aut iuxtim et alternatim Latine <lb xml:id="p1z22"/>et Germanice bonasque horas in malas ca<lb xml:id="p1z23"/>nonicas mutare horas aut alias superstitiones etc.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z24"/>Nil novi, nisi quod incendiarii ditionis <placeName>Hanoensis</placeName> <lb xml:id="p1z25"/>multas aedes pagosque voracibus flammis absumpserunt.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p18477">Ferdinandus</persName> corradit aes alienum contra vim <placeName ref="l2510">Turcę</placeName> et in <lb xml:id="p1z27"/><placeName ref="l850">Austriacis</placeName> provintiis apud nos quędam oppida oppi<lb xml:id="p1z28"/>gnoravit.</s>
					<s n="12" xml:lang="la">Colmarię in prostibulo tria scorta <lb xml:id="p1z29"/>cum vetula matre abbatissa in obscuro carcere capti<lb xml:id="p1z30"/>va servantur.</s>
					<s n="13" xml:lang="la">Mira exercuerunt veneficia.</s>
					<s n="14" xml:lang="la">Inven<lb xml:id="p1z31"/>tę sunt illic tres calvarię et nescio quae alia, quorun<lb xml:id="p1z32"/>dam cędem testantes.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Meam valetudinem <persName>Heinius</persName> significabit.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z33"/>Saluta tuam familiam, <persName ref="p8171">Bibliandrum</persName>, <persName ref="p8011">Gualtherum</persName> <lb xml:id="p1z34"/>reliquosque symmystas.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Salutant te nostri.</s>
					<s n="18" xml:lang="la" ana="farewell">Vale feliciter.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z35"/><placeName ref="l411">Richenvillę</placeName> 28. septembris 1556.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">T[<lb xml:id="p1z36"/>uus] <persName ref="p1010">Erbius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio doctori Christi <lb xml:id="p2z2"/>Iesu ecclesięque <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>etiamnum antistiti, <lb xml:id="p2z4"/>fratri et domino <lb xml:id="p2z5"/>observando.</s>
				</p>
