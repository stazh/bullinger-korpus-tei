			<zone xml:id="p4z3-0" points="739,2329 860,2312 948,2367 1133,2236 1179,2250 1317,2223 1331,2049 1244,2073 1138,2023 1063,2052 933,2038 831,2084 759,2058">753,2260 781,2251 809,2249 838,2251 866,2253 895,2254 923,2254 952,2254 980,2252 1009,2248 1037,2244 1065,2241 1094,2237 1122,2233 1151,2230 1179,2228 1208,2226 1236,2224 1265,2220 1293,2216 1322,2212</zone>
		</surface>
