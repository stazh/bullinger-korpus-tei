	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime <persName ref="p495">Bullingere</persName>, putavi remittendum... <lb xml:id="p1z2"/>quum viderem me vix intra 15 dies adhuc <lb xml:id="p1z3"/>non rediturum.</s>
					<s n="2" xml:lang="la">Scio, quot munia illi in<lb xml:id="p1z4"/>cumbant, non libenter careo societate tam <lb xml:id="p1z5"/>cari filii mei; sed non haberem eum loco <lb xml:id="p1z6"/>filii, si plus facerem mea commoda quam <lb xml:id="p1z7"/>eius.</s>
					<s n="3" xml:lang="la">Ille itaque narrabit de meo statu, <lb xml:id="p1z8"/>nihilque opus est, ut scribam ego, ipsum <lb xml:id="p1z9"/>audite.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Dicam tamen haec tria: comiti<lb xml:id="p1z10"/>a <lb xml:id="p1z11"/>indixit Caesar <placeName ref="l513">Ulmę</placeName> 16. augusti et <lb xml:id="p1z12"/>promittit se in propria persona affuturum.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z13"/><persName>Rex Romanus</persName> transegit cum duce hoc prorsus, <lb xml:id="p1z15"/>numerabuntur ultra 20m flor.</s>
					<s n="6" xml:lang="la">Iter hoc meum multis <lb xml:id="p1z16"/>multis commodum erit, praesertim cau<lb xml:id="p1z17"/>sa religionis ad gloriam dei.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z18"/>Audio papam me magno honore affecisse; <lb xml:id="p1z19"/>destinavit enim legatum, qui ad fines <placeName ref="l648">Rhae<lb xml:id="p1z20"/>tiae</placeName> se recipiat, Novio Comi resideat <lb xml:id="p1z22"/>et caveat, ne respublica a me aliquid <lb xml:id="p1z23"/>detrimenti patiatur.</s>
					<s n="8" xml:lang="la">Certe mecum non <lb xml:id="p1z24"/>pugnabit scripturis, sed subornabit viros<lb xml:id="p1z25"/>, qui pugione, sclopeto, veneno mecum <lb xml:id="p1z26"/>agant.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">At in domino confido; ego <lb xml:id="p1z27"/>nihilominus adibo et perseverabo: utinam <lb xml:id="p1z28"/>fi<lb xml:id="p1z29"/>am martir Iesu Christi; non recuso, si <lb xml:id="p1z30"/>est voluntas domini.</s>
					<s n="10" xml:lang="la">Utinam ante <lb xml:id="p1z31"/>meum discessum adveniret <persName ref="p974">Moleneus</persName>.</s>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ego antequam hinc abeam, principem rursus <lb xml:id="p2z2"/>conveniam omnino et agam gratias tuo nomine..<lb xml:id="p2z3"/>. de bono illo viro etc.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z4"/>Duo hic certa audivi, quae me valde delecta<lb xml:id="p2z5"/>runt, primum a duce: <persName>Caesarem</persName> sibi dix<lb xml:id="p2z6"/>isse se fateri, quod nihil possit efficere am<lb xml:id="p2z7"/>p<lb xml:id="p2z8"/>lius in causam evangelii, et quod oneret <lb xml:id="p2z9"/>conscientias principum, alterum a <persName ref="p458">Brentio</persName>: <lb xml:id="p2z10"/>ducem hunc omnino magis indigere fre<lb xml:id="p2z11"/>no quam calcari.</s>
					<s n="13" xml:lang="la">Quid ergo faciet nunc <lb xml:id="p2z12"/>post transactionem, id est posteaquam videt se <lb xml:id="p2z13"/>vere ducem esse sine controversia?</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z14"/>Ego rediens spero me <placeName ref="l587">Tigurum</placeName> venire; itaque <lb xml:id="p2z15"/>in meum adventum reservo reliqua.</s>
					<s n="15" xml:lang="la" ana="farewell"><lb xml:id="p2z16"/>Vale et salve.</s>
					<s n="16" xml:lang="la">D. Iesus benedicat tuis <lb xml:id="p2z17"/>laboribus.</s>
					<s n="17" xml:lang="la">Amen.</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z18"/><placeName ref="l512">Tubingae</placeName> 21. iunii 1553.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z19"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z20"/>In memoria habe de Catalogo mihi inscri<lb xml:id="p2z21"/>bendo.</s>
					<s n="21" xml:lang="la">Consultum putarem, si de priore fa<lb xml:id="p2z22"/>ceres mentionem, nempe de illo, quem <lb xml:id="p2z23"/><persName>Io[annes] della Casa</persName> aedidit.</s>
					<s n="22" xml:lang="la">Te in hoc <pb/><lb xml:id="p3z1"/>posteriore non condemnarunt, ne te <lb xml:id="p3z2"/>iratum haberent scilicet.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo d. <persName ref="p495">Bullingero</persName>, <lb xml:id="p4z2"/>fratri honorando.</s>
					<s n="24" xml:lang="la"><lb xml:id="p4z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
