	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Cum ex <placeName ref="l2477">Palatinatu</placeName> redirem, statueram <lb xml:id="p1z2"/>certis de causis <placeName ref="l587">Tigurum</placeName> transire; verum cum <lb xml:id="p1z3"/>praeter spem diutius hinc inde hererem, mutato consilio <lb xml:id="p1z4"/>domum contendendum fuit.</s>
					<s n="3" xml:lang="la">Itaque literas, quas a bonis <lb xml:id="p1z5"/>viris <placeName ref="l210">Heidelbergae</placeName> acceperam, domum reversus recta <lb xml:id="p1z6"/>d. <persName ref="p8018">Hallero</persName> tradidi, ut ad te transmitteret.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Interim me iterum collegi et recordor me apud <lb xml:id="p1z8"/>ornatissimum virum <persName ref="p8075">Erastum</persName> vidisse responsum de <lb xml:id="p1z9"/>excommunicatione postremum, quo d. <persName ref="p8033">Bezae</persName> respondit; <lb xml:id="p1z10"/>id cupiebam describi mihi; sed respondebat a vobis <lb xml:id="p1z11"/>me commodius id obtinere posse.</s>
					<s n="5" xml:lang="la">Rogo igitur, <lb xml:id="p1z12"/>vir honorande, ut illius mihi detur copia; legam <lb xml:id="p1z13"/>enim et quidem avidissime mox ad vos remissurus.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Scripta haec Italica dedit mihi d. generosus <lb xml:id="p1z15"/>comes <persName ref="p8510">Odoardus Thyeneus</persName>, quo vobis communi<lb xml:id="p1z16"/>carem, quae non erant ad manus, cum nuper <lb xml:id="p1z17"/>literas d. <persName ref="p8018">Hallero</persName> darem.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z18"/>Vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1571. 28. augusti.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/>T[otus] t[uus] <persName ref="p8092">B[enedictus] Aretius</persName>.</s>
