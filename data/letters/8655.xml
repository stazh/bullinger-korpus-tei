				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z3"/>s[acrae] theologiae sincero <lb xml:id="p2z4"/>doctori et interpreti, <lb xml:id="p2z5"/>domino suo honorando.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tigu<lb xml:id="p2z7"/>ri</placeName><note xml:id="fna" type="footnote" n="a">[Darunter von <persName ref="p495">Bullingers</persName> Hand:] "Misi d. <persName ref="p8075">Erasti</persName> scriptum librum de Excommunicatione 8. septembris per cursorem publicum Ieremiam <placeName ref="l166">Gachnang</placeName> 1571."</note><lb xml:id="p2z8"/>.</s>
