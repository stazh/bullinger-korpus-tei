	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Cum aliquid mitterem per meum mulionem ad legatum <placeName ref="l648">Rhetorum</placeName>, <lb xml:id="p1z2"/>eum nolui discedere sine meis ad te literis, ut, cum revertetur, <lb xml:id="p1z3"/>de tua valetudine intelligere possim.</s>
					<s n="3" xml:lang="la">Erat insula capta ab <placeName ref="l830">Anglis</placeName> <lb xml:id="p1z4"/>a quindecim annis, que vocatur <persName>Dorigni</persName>, in qua duo castella <lb xml:id="p1z5"/>extruxerant.</s>
					<s n="4" xml:lang="la">Ea a <placeName>Normanis</placeName> duce <placeName>Langęo</placeName> iis diebus recuperata <lb xml:id="p1z6"/>et <placeName ref="l830">Angli</placeName> cęsi ad 500.</s>
					<s n="5" xml:lang="la">Nostri munitiorem et fortiorem quam antea <lb xml:id="p1z7"/>faciunt <persName>Theodonis</persName> Villam<note type="misc"><placeName ref="l1922">Diedenhofen</placeName>/<placeName>Thionville</placeName>/<placeName ref="l691">Lothringen</placeName></note>, et <persName>Guisius</persName> victoria sua utitur.</s>
					<s n="6" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z8"/>vale et nos, quod facis, ama.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l21">Badene</placeName> 7. iulii.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z9"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henricho Bullingero</persName>, ecclesie <lb xml:id="p2z2"/>pastori meritissimo et amico.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
