	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime domine <persName ref="p495">Bullingere</persName>, domine colendissime S.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Dum essem <placeName ref="l440">Samadeni</placeName>, scripsi mittendas tuae humanitati; eas vero nunc demum <lb xml:id="p1z3"/>per famulum domini <persName ref="p6055">Petri Pernae</persName>, quem hic repperi, mitto.</s>
					<s n="3" xml:lang="la">Si vero quid nov<lb xml:id="p1z4"/>i <lb xml:id="p1z5"/>hic extitisset, utique te eius reddidissem certiorem, prout eram in aliis meis pollicitus.</s>
					<s n="4" xml:lang="la">Sed <lb xml:id="p1z6"/>nil omnino est in promptu, quod magnopere te scire conveniat, et si quidem quid <lb xml:id="p1z7"/>sit, a domino <persName ref="p8009">Fabricio</persName> nostro intelliges, quem ad nos rediisse admodum nobis <lb xml:id="p1z8"/>gratulor etc.</s>
					<s n="5" xml:lang="la" ana="salute">Commendatos habebis fratres meos tibi praesentes itemque <lb xml:id="p1z9"/>filium meum absentem et tuos domesticos omnes meo nomine admodum <lb xml:id="p1z10"/>salutabis.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Datum <placeName ref="l98">Churiae</placeName> in nundinis divi Pauli die 2. <lb xml:id="p1z12"/>februarii 1559 nocte intempesta.</s>
					<s n="7" xml:lang="la" ana="salute">Dominus genitor <lb xml:id="p1z13"/>meus, qui isthic est, te etiam atque etiam salutat seseque totum tuae humanitati offert etc.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Commendat autem et ipse tibi filios suos.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Vale perpetuo, domine colendissime <lb xml:id="p1z15"/>e<lb xml:id="p1z16"/>t observandissime.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p8432">Federicus a Salice</persName> omnium deditissimus <lb xml:id="p1z18"/>tibi tuisqu<lb xml:id="p1z19"/>e<pb/><lb xml:id="p2z5"/>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z23"/>Ornatissimo domino <persName ref="p495">Bullingero</persName>, domino meo <lb xml:id="p2z24"/>iugiter colendissimo et observandissimo.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z25"/><placeName ref="l587">Tiguri</placeName> Helvetiorum.</s>
				</p>
			</div>
		</body>
	</text>
