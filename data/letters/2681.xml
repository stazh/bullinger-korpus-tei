	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quamvis nihil sit nunc, quod scribam, nolui tamen hosce <lb xml:id="p1z2"/>tuos sine meis ad te venire; per ipsos enim abs te expecto <lb xml:id="p1z3"/>copiosiores.</s>
					<s n="3" xml:lang="la">Quid hic fiat exponunt ipsi, <placeName ref="l167">Genevae</placeName> audimus <lb xml:id="p1z4"/>exulcerata omnia.</s>
					<s n="4" xml:lang="la">Aliqui nunc supplicio affecti.</s>
					<s n="5" xml:lang="la">Nostri <lb xml:id="p1z5"/>exacerbantur quoque in illos magis ac magis.</s>
					<s n="6" xml:lang="la">Vereor peiora <lb xml:id="p1z6"/>sequutura nisi dominus avertat.</s>
					<s n="7" xml:lang="la"><persName ref="p540">Calvinus</persName> pessime audit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z7"/>Literae quaedan illius ad amicos scriptae et ab illis dum <lb xml:id="p1z8"/>incautius servarentur surreptae, seu potius antequam <lb xml:id="p1z9"/>ad illos pervenirent interceptae, magna illum gravant <lb xml:id="p1z10"/>invidia.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Nihil efficimus illum defendendo et excusando.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z11"/>Nova etiam lis inter quosdam ministros est, qui iniuriarum <lb xml:id="p1z12"/>se mutuo accusant, et vereor ne plures adhuc involvantur <lb xml:id="p1z13"/>alii.</s>
					<s n="11" xml:lang="la">Magnum hinc gignitur scandalum, et eo magis min<lb xml:id="p1z14"/>isterii deprimitur authoritas quanto magis ipsi contendendo <lb xml:id="p1z15"/>eius dignitatem extollere conantur.</s>
					<s n="12" xml:lang="la"><persName ref="p540">Calvino</persName> et <persName ref="p1049">Farello</persName> <lb xml:id="p1z16"/>parum nos praestare videmur.</s>
					<s n="13" xml:lang="la">Sed quid agamus in mari isto tur<lb xml:id="p1z17"/>barum et negotiorum, nisi ut ad clavum fortiter <lb xml:id="p1z18"/>stantes, si non fluctus compescere, saltem navem <lb xml:id="p1z19"/>incolumem servare enitamur?</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Cras praefecti creabuntur.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z20"/>Unde iniquo admodum tempore hi abs te vocati videntur.</s>
					<s n="16" xml:lang="la">Velim <lb xml:id="p1z21"/>enim eos interesse.</s>
					<s n="17" xml:lang="la">De expeditione <placeName ref="l832">Gallica</placeName> satis tibi constat.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z22"/>Ex <placeName ref="l832">Gallia</placeName> nihil habemus, nisi quod Cameraci et alibi multi <lb xml:id="p1z23"/>propter veritatis professionem in vinculis detinenur, et quot<lb xml:id="p1z24"/>idie aliqui tolluntur.</s>
					<s n="19" xml:lang="la">Dominus misereatur ecclesię suę et servet <lb xml:id="p1z25"/>nos a malo!</s>
					<s n="20" xml:lang="la" ana="salute">Salutem tuis omnibus meo meorumque nomine <lb xml:id="p1z26"/>dicito.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l41">Bernae</placeName> 27. iulii 1555.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z27"/><persName ref="p8018">H[allerus]</persName> t<pb/><lb xml:id="p2z1"/>uus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Sermones de salute fidelium accepi et gratias tibi ago magnas.</s>
					<s n="24" xml:lang="la" ana="salute"><lb xml:id="p2z2"/>Dispertivi, ut volebas, et habent tibi gratias omnes teque vicissim salutant.</s>
					<s n="25" xml:lang="la">D. <persName ref="p8018">Hallerus</persName> nondum in <lb xml:id="p2z3"/>urbem reversus est, nec, quae de illo spes sit, adhuc apparet.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">Clarissimo vir<lb xml:id="p2z4"/>o d. <persName ref="p495">Heinrycho Bul<lb xml:id="p2z5"/>lingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae pastori fidelissimo, domino ac compatri suo honorando.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>