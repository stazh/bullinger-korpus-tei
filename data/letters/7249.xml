	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Metui ipse quoque, mi <persName ref="p495">Bullingere</persName> exoptatissime, (quo<lb xml:id="p1z2"/>d dissimulavi tamen strenue), ne alienior a nobis <lb xml:id="p1z3"/>esset d. <persName ref="p8018">Hallerus</persName>, eoque magis metui, quo ille tardius <lb xml:id="p1z4"/>rescripsit.</s>
					<s n="3" xml:lang="la">Nunc eas accepi literas, unde facile i<lb xml:id="p1z5"/>ntelligo eundem eum esse, qui fuit anno superiore.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Quae quanquam fuere mihi, quod vel me tacente scis, <lb xml:id="p1z7"/>gratissimae, tamen hoc fuere gratiores, quod coniunctae <lb xml:id="p1z8"/>essent cum illis, quae tibi redderentur; neque enim dubito iu<lb xml:id="p1z9"/>cundissimas eas tibi fore, quo magis laboravi, ut quam primum <lb xml:id="p1z10"/>tibi redderentur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Misissem per <persName ref="p8371">Albertum</persName>, si mature <lb xml:id="p1z11"/>accepissem; nunc <placeName ref="l257">Constantiam</placeName> ad meos mittendae <lb xml:id="p1z12"/>sunt, qui haud scio an habituri statim sint, cui dent.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Tu si quid respondere voles d. <persName ref="p8018">Hallero</persName>, mihi item mittes, <lb xml:id="p1z14"/>qui, per quos perferri commode possit, iam ex ipso cognovi.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z15"/>Quod reliquum est, bene vale et symmystis omnibus ac <lb xml:id="p1z16"/>singulis, si molestum non est, meis verbis S.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l18">Augustae</placeName> 3. <lb xml:id="p1z17"/>octobris anno 1567.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p2899">M[atthias] Schenckius</persName> t[uus].</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pio pariter et erudito <lb xml:id="p2z2"/>viro <persName ref="p495">Heinricho Bul<lb xml:id="p2z3"/>linger</persName>o, ecclesiastae <lb xml:id="p2z4"/><placeName ref="l587">Tigurino</placeName>, domino atque amico <lb xml:id="p2z5"/>suo observando.</s>
				</p>
				<p>
					<s n="11" xml:lang="de"><lb xml:id="p2z6"/>An meister <persName ref="p495">Heinrich <lb xml:id="p2z7"/>Bullinger</persName> zu <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
