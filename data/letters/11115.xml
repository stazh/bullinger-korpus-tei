	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Am 26. November nahm <persName ref="p8129" cert="high">Jakob Meyer</persName> Stellung zur Aufforderung <persName ref="p495" cert="high">Bullingers</persName>, auf die Abberufung des <placeName ref="l41" cert="high">Berner</placeName> Pfarrers <persName ref="p5837" cert="high">Sebastian Meyer</persName> hinzuwirken (s. oben <ref target="file11113">Nr. 1070</ref>). <persName ref="p1365" cert="high">Grynäus</persName> bezieht sich offenbar auf eine gleichartige Anfrage (s. unten Z. 1f).</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>De <persName ref="p5837">Sebastiano</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p5837">Sebastian Meyer</persName> (vgl. Anm. 1).</note> videbo.</s>
					<s n="2" xml:lang="la">Nam mihi ipsi sic videtur <lb xml:id="p1z2"/>esse inutile ad concordiam, si diutius istic <lb xml:id="p1z3"/>sit.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Qualis tu esse legatus <placeName ref="l862">Helvetiorum</placeName> velles <lb xml:id="p1z4"/>in<note xml:id="fna" type="footnote" n="a"><hi>vor</hi> in <hi>gestrichenes</hi> audivi.</note> hoc concordię negotio, audivi<note xml:id="fn3" type="footnote" n="3"><persName ref="p495">Bullinger</persName> hatte in seinem Brief an <persName ref="p467">Bucer</persName> vom 6. Oktober dessen Schreiben an <persName ref="p1974">Luther</persName> vom 19. Januar kritisiert und kurz skizziert, wie er selbst argumentiert hätte; s. oben <ref target="file11096">Nr. 1053</ref>, 96-106.</note>.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Sed, ut pace tua dicam, parum attineat hoc <lb xml:id="p1z6"/>ad rem.</s>
					<s n="5" xml:lang="la">Res est, uter recte causam sacramenti <lb xml:id="p1z7"/>intelligat.</s>
					<s n="6" xml:lang="la">In ea qui fungi recte <lb xml:id="p1z8"/>sequestris<note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> sequestris <hi>ein gestrichenes, unlesbares Wort.</hi></note> <lb xml:id="p1z9"/>officio vult, apud <persName ref="p1974">Lutherum</persName> concedet non prorsus <lb xml:id="p1z10"/>nos rem intellexisse aut, si intellexerimus, non <lb xml:id="p1z11"/>ita expressisse, ut sentiebamus.</s>
					<s n="7" xml:lang="la">Vide, sic apud <lb xml:id="p1z12"/><persName ref="p1974">Lutherum</persName> est agendum necessario, et[?] qui se praebere volet <lb xml:id="p1z13"/>medium in hac quidem causa, ut<note xml:id="fnc" type="footnote" n="c"><hi>kann auch als</hi> at <hi>oder</hi> ac <hi>gelesen werden.</hi></note> aliter non potest<note xml:id="fnd" type="footnote" n="d"><hi>vielleicht als</hi> possit <hi>zu lesen.</hi></note>, apud <lb xml:id="p1z14"/>nos sic dicet: <persName ref="p1974">Lutherus</persName> aliter nunc sentit,<note xml:id="fne" type="footnote" n="e">sensit <hi>am Rande nachgetragen.</hi></note> quam olim <lb xml:id="p1z15"/>sensit <lb xml:id="p1z16"/>aut certe quam scripsit olim.</s>
					<s n="8" xml:lang="la">At neque hic <lb xml:id="p1z17"/>ratio <lb xml:id="p1z18"/>sequestrandi alia est.</s>
					<s n="9" xml:lang="la">Sed de his alias.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/>Te quaeso, ut in omni negotio Christi Christi<note xml:id="fnf" type="footnote" n="f"><hi>Die ersten drei Buchstaben</hi> des <hi>zweiten</hi> Christi <hi>in Majuskeln.</hi></note> sis, sic <lb xml:id="p1z20"/>ut es, et te regno eius impertias totum.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb type="edition" next="310"/>Hos <lb xml:id="p1z21"/>viros<note xml:id="fn4" type="footnote" n="4">Unbekannt.</note> valde cupio ut omni officio humanitatis <lb xml:id="p1z22"/>excipias.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale, mi frater dulcissime.</s>
					<s n="13" xml:lang="la" ana="salute">Saluta mihi <persName ref="p8171">Theo<lb xml:id="p1z23"/>dorum</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p8171">Theodor Bibliander</persName>.</note> et fratres diligenter.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p1365">Gryneus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/>fratri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
