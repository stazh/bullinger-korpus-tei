	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Barco. Butingere hic adunaue miss sunt ad
					<lb xml:id="p1z2"/>aepclristo episcopo Londonense, ex quibus Anglia
					<lb xml:id="p1z3"/>statum intelliges, Quis velli Uranici euentus fut
					<lb xml:id="p1z4"/>sit soptimorum, quaeancunque sollicitudine
					<lb xml:id="p1z5"/>et metu in diversa iuditia distrahatu suam hostium
					<lb xml:id="p1z6"/>potentia opes, munitę urbes plurimę cum adfunta
					<lb xml:id="p1z7"/>confederationes et papistarum mutuę angilia
					<lb xml:id="p1z8"/>contra nos in conspectu sunt. nostri rincipe
					<lb xml:id="p1z9"/>amessi Hispanorum tyrannidem et superetitio
					<lb xml:id="p1z10"/>et invisam.
					<lb xml:id="p1z11"/>exosam exosam habeant et perspigant eorum
					<lb xml:id="p1z12"/>dominationem tandem in sua capita evasuram
