	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi tuas, chare frater, ac recepi etiam <lb xml:id="p1z2"/>tuam excusationem; proinde de studio et amore <lb xml:id="p1z3"/>in te meo noli dubitare.</s>
					<s n="3" xml:lang="la"><persName ref="p8016">Eglius</persName> rediit et praedi<lb xml:id="p1z4"/>cavit <placeName ref="l108">Davosianorum</placeName> et liberalitatem et humanitatem.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="salute"><lb xml:id="p1z5"/>Gratias egi domino, quem oro, istum illuminet, ut gloriam <lb xml:id="p1z6"/>nominis divini et multorum salutem promoveat; ad <lb xml:id="p1z7"/>finem aprilis ascendet.</s>
					<s n="5" xml:lang="la">Oro, ut d. consuli tam <placeName ref="l98">Curiensi</placeName> <lb xml:id="p1z8"/>quam <placeName ref="l108">Davosiano</placeName> agas gratias idque meo nomine.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Magistratus nos<lb xml:id="p1z9"/>ter (ille enim ad hunc scribit) benigne accepit literas <lb xml:id="p1z10"/>et laudat illorum benignitatem et constantiam etc.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Scriptum <lb xml:id="p1z11"/>missum per <persName>Ioachimum</persName> accepi.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Alterum nunc mitto, <lb xml:id="p1z12"/>cuius proxime mentionem feci, nec est, ut remittas.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Tractationem <lb xml:id="p1z13"/>meam De ubiquitate coeli et corporis Christi <lb xml:id="p1z14"/>spero te accepisse.</s>
					<s n="10" xml:lang="la">Adeste fratribus laborantibus <lb xml:id="p1z15"/>et molestia affectis per episcopales; dominus exercet nos, sed non <lb xml:id="p1z16"/>deserit, non vult nos esse desides.</s>
					<s n="11" xml:lang="la"><persName>Martinum</persName> <lb xml:id="p1z18"/>illum, importunum hominem, simpliciter vel praecise <lb xml:id="p1z19"/>deiicerem gradu et abire iuberem aut agerem cum <lb xml:id="p1z20"/>ecclesia, ut ipsa amandaret ipsum.</s>
					<s n="12" xml:lang="de">Es muͦß mir <lb xml:id="p1z21"/>gwüß das letst commendieren sin, ich beckenne dann <lb xml:id="p1z22"/>bas die gesellen.</s>
				</p>
				<p>
					<s n="13" xml:lang="de">Es ist weger by zyt gefertiget <lb xml:id="p1z23"/>dann hernach und zuͦ spaat mitt schand und schaden.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z24"/>Dominus tecum.</s>
					<s n="15" xml:lang="la">28. martii 61.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
