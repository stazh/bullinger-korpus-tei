	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Queruntur legati de tua, frater et compater, i<lb xml:id="p1z2"/>mportunitate; una enim literas mittunt vester et <placeName ref="l468">Sa<lb xml:id="p1z3"/>lodurius</placeName>.</s>
					<s n="3" xml:lang="la">Petunt, ut verbis te reducam et castigem.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Sed si res ita est gesta, ut scribis, nec dubito, <lb xml:id="p1z5"/>quin ita res habeat, non est, quod tecum expostulem, <lb xml:id="p1z6"/>cum in simili casu hic idem fecissem.</s>
					<s n="5" xml:lang="la">Sed <lb xml:id="p1z7"/>expectabo rei eventum; displicet res vehemente<lb xml:id="p1z8"/>r.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Sane nunc non possum plura; nam et <lb xml:id="p1z9"/>negotia tota die me defatigarunt, et capitis <lb xml:id="p1z10"/>dolor sub vesperam ingravescit.</s>
					<s n="7" xml:lang="la">Boni consule <lb xml:id="p1z11"/>ista; alias, si dominus voluerit, plura dabo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z12"/>cum d. d consulibus et <persName ref="p2095">Philippo</persName> et <persName ref="p6130">Pontasella</persName> e<lb xml:id="p1z13"/>tc.</s>
					<s n="9" xml:lang="la">13. ianuarii 1559.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z15"/>Oro, ut bona fide cures <lb xml:id="p1z16"/>has literas deferri ad d. <lb xml:id="p1z17"/><persName ref="p8432">Friderychum a Salice</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro fideli, <lb xml:id="p2z4"/>domino et fratri suo <lb xml:id="p2z5"/>charissimo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
