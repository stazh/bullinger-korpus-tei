	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuas recepi scriptas 9. huius mensis.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Vidi sollicitudinem tuam de episcoporum <lb xml:id="p1z2"/>synodo.</s>
					<s n="4" xml:lang="la">Sed de conventu illo, qui fiet 20. huius mensis, bene multi sperant, <lb xml:id="p1z3"/>et quod pars melior et doctior maiorem vincet.</s>
					<s n="5" xml:lang="la">Avide expecto, <lb xml:id="p1z4"/>quid principes et regis consilium egerint auditis sententiis senatorum <lb xml:id="p1z5"/>omnium parlamenti <placeName ref="l378">Parisiensis</placeName> in religionis negocio.</s>
					<s n="6" xml:lang="la">Quę intellexero, tibi <lb xml:id="p1z6"/>signifficabo et, si habuero confessionem impii <placeName ref="l834">Itali</placeName>, cuius mentionem facis, mittam <lb xml:id="p1z7"/>ad te.</s>
					<s n="7" xml:lang="la"><placeName ref="l2926">Ramboletius</placeName> interpretabitur exemplar literarum, que ex <placeName ref="l875">Hispania</placeName> ad me <lb xml:id="p1z8"/>misse sunt, et que ex me intellexerit, narrabit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Itaque finem faciam satis <lb xml:id="p1z9"/>habens negocii cum legatis <placeName ref="l2448">Quinquepagicorum</placeName>, quos beneficiorum magis <lb xml:id="p1z10"/>memores et gratos optarem.</s>
					<s n="9" xml:lang="la" ana="salute">Salutabis amicos omnes.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l760">Solud[uri]</placeName> <lb xml:id="p1z11"/>14. iulii.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z12"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henrico Bullingero</persName> ecclesie<note type="misc">eclie</note> <lb xml:id="p2z2"/><placeName ref="l587">Tiguri</placeName> pastori vigilantissimo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
