	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tua accepi omnia, reverende in Christo <lb xml:id="p1z2"/>pater, et facile agnosco te difficulter <lb xml:id="p1z3"/>omnibus satisfacere; quid mihi accidat, <lb xml:id="p1z4"/>scio, qui non decimam partem tuorum <lb xml:id="p1z5"/>laborum sustineo.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Exscripsi adhuc <lb xml:id="p1z6"/>heri vesperi et misi suppresso nomine, <lb xml:id="p1z7"/>quo et alii legere possint, ad consules <lb xml:id="p1z8"/>nostros, qui sunt <placeName>Ylantii</placeName> in comitiis <lb xml:id="p1z9"/><foreign xml:lang="de">(daa besetzt man die ämpter).</foreign></s>
					<s n="4" xml:lang="la">Venit <lb xml:id="p1z10"/>quidam <placeName ref="l306">Mediolano</placeName>, qui affirmat interea <lb xml:id="p1z11"/><placeName ref="l306">Mediolani</placeName> signum laetitiae bombardis datum; <lb xml:id="p1z12"/>sed hoc fit instinctu pfafforum et <lb xml:id="p1z13"/>concilii, quo suos in aliquam spem erigant <lb xml:id="p1z14"/>et in officio contineant.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Dicitur idem <lb xml:id="p1z15"/>a <placeName ref="l257">Constantiensibus</placeName> factum, procul <lb xml:id="p1z16"/>dubio in gratiam cardinalis.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Mitto <lb xml:id="p1z17"/>orationem cardinalis <placeName>Lotharingii</placeName>, quam <lb xml:id="p1z18"/>pridem libenter habuissem nec <lb xml:id="p1z19"/>tamen ante comparare potui; si non <lb xml:id="p1z20"/>prius habes, erit non ingrata.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Mitto <lb xml:id="p1z21"/>actionis sextae decreta; quae si tu <lb xml:id="p1z22"/>habes, haec remitto, si non habes, serva.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z23"/>Plura cognoscere non potui, nisi <lb xml:id="p1z24"/>quod, qui illinc veniunt, affirmant simul <lb xml:id="p1z25"/>omnes stupris et libidinibus <placeName ref="l1107">Tridenti</placeName> <lb xml:id="p1z26"/>omnia conspurcari et cadavera <pb/><lb xml:id="p2z1"/>caesorum singulis diebus mane in plateis <lb xml:id="p2z2"/>reperiri.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">De <placeName ref="l832">Gallia</placeName> subinde expectamus <lb xml:id="p2z3"/>certiora.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Heri duo venerunt <placeName ref="l1121">Genua</placeName>, <lb xml:id="p2z4"/>qui affirmant <placeName ref="l830">Anglos</placeName> excurrere <lb xml:id="p2z5"/><placeName ref="l378">Parisios</placeName> usque et <persName ref="p18090">reginae Navarrę</persName> exercitum <lb xml:id="p2z6"/>esse in statione, ut prohibeat <placeName ref="l875">Hispanos</placeName>, <lb xml:id="p2z7"/>si qui adventare de novo molirentur;<note type="margin">dazu a.R.: "Hi nescio quid dicunt, quod <placeName>Condensis</placeName> dicatur ex custodia evasisse etc."</note> <lb xml:id="p2z8"/>item, <placeName ref="l2510">Turcicam</placeName> legationem sexaginta circiter <lb xml:id="p2z9"/>virorum <placeName ref="l1121">Genuae</placeName> appulisse se inspectantibus <lb xml:id="p2z10"/>et inde profectos in <placeName ref="l832">Galliam</placeName>.</s>
					<s n="11" xml:lang="la">Si te ex<lb xml:id="p2z11"/>scribendi onus fatigat, da partem <lb xml:id="p2z12"/>laboris affinibus meis.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Sed ubi <persName ref="p8033">Bäza</persName> <lb xml:id="p2z13"/>noster, vivitne, nihilne literarum <lb xml:id="p2z14"/>ex eo?</s>
					<s n="13" xml:lang="la">Quicquid actum sit, quocumque <lb xml:id="p2z15"/>victoria ceciderit, certe unus <persName>Guisius</persName> <lb xml:id="p2z16"/>ex altera parte superest, quem deus <lb xml:id="p2z17"/>procul dubio ad maiora fortunae <lb xml:id="p2z18"/>ludibria reservat.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Verum tamen <lb xml:id="p2z19"/>oculis tuis considerabis et retributionem <lb xml:id="p2z20"/>peccatorum videbis.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Vivemus <lb xml:id="p2z21"/>et annunciabimus opera domini.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell"><lb xml:id="p2z22"/>Vale, reverende in Christo pater.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Deum <lb xml:id="p2z23"/>rogo, ut te nobis et ecclesię diu <lb xml:id="p2z24"/>incolumem conservet.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l98">Curię</placeName> <lb xml:id="p2z25"/>18. ianuarii anno 1563.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z26"/>Tui observantissimus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Quae de me<pb/><lb xml:id="p3z1"/>o negotio scribo, serva tibi et.<lb xml:id="p3z2"/>.. ne f<lb xml:id="p3z3"/>or s exeat.</s>
					<s n="21" xml:lang="la">Forta<lb xml:id="p3z4"/>ssis ad <lb xml:id="p3z5"/>vos <lb xml:id="p3z6"/>veniam, si modo possum et r<lb xml:id="p3z7"/>es familiaris et <pb/><lb xml:id="p4z1"/>ecclesiastica me non impedit etc.<note type="misc">gestrichen und dazu a.R. bemerkt: "Scribo plures simul et hic erravi; addidi, quae ad alias pertinebant literas, ideo delevi. Ignosce."</note></s>
				</p>
				<p>
					<s n="22" xml:lang="la">Amplissimo viro d. <lb xml:id="p4z2"/><persName ref="p495">Heinrycho Bullingero</persName>, d. <lb xml:id="p4z3"/>et patri suo in Christo <lb xml:id="p4z4"/>summe colendo.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p4z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
