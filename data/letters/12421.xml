	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Das Jahr ergibt sich aus <persName ref="p495" cert="high">Bullingers</persName> Antwort vom 11. März 1546 (<ref target="file12423">Nr. 2376</ref>).</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto ad te, quas heri accepi, <persName ref="p3927">Welseri</persName> nostri literas<note xml:id="fn2" type="footnote" n="2"><persName ref="p3927">Hans Welsers</persName> Brief, 4. März (<ref target="file12416">Nr. 2369</ref>).</note>.</s>
					<s n="3" xml:lang="la">Ad me, <lb xml:id="p1z2"/>puto, eadem de pontificis<note xml:id="fn3" type="footnote" n="3"><persName ref="p19981">Paul III.</persName></note> conatibus scripsit<note xml:id="fn4" type="footnote" n="4">Nicht in <hi><persName ref="p8055">Blarer</persName> BW.</hi></note>; quod caesari<note xml:id="fn5" type="footnote" n="5"><persName ref="p18538">Karl V.</persName></note> promiserit <lb xml:id="p1z3"/>700M libra se impensurum in concilii<note xml:id="fn6" type="footnote" n="6">Das Konzil zu <placeName ref="l1107">Trient</placeName>.</note> exquutionem<note xml:id="fn7" type="footnote" n="7">= executionem.</note>, si ad hanc <lb xml:id="p1z4"/>gladio accingi velit<note xml:id="fn8" type="footnote" n="8">Siehe schon <ref target="file12375">Nr. 2328</ref>, Anm. 44. - Vgl. <persName ref="p3927">Welsers</persName> Brief an <persName ref="p495">Bullinger</persName>, wo er, allerdings ohne Angabe einer Geldsumme, diese Nachricht auch übermittelt (<ref target="file12416">Nr. 2369</ref>,22-27).</note>.</s>
					<s n="4" xml:lang="la">Dominus filium istum perditionis<note xml:id="fn9" type="footnote" n="9">Der Papst. - Vgl. <cit type="bible"><ref>2Thess 2, 3</ref></cit>.</note>, qui bonos omnes <lb xml:id="p1z5"/>perditos tantopere cupit, quamprimum perdat in gloriam regni Christi sui!</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="5" xml:lang="la" ana="farewell"><lb xml:id="p1z6"/>Bene vale et ora pro nobis.</s>
					<s n="6" xml:lang="la" ana="salute">Saluta amicos et fratres.</s>
					<s n="7" xml:lang="la">9. martii.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z7"/>Tuus <persName ref="p8055">A. Bl.</persName></s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, suo fratri colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
