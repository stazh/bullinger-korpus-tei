	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Dominus Iesus rex regum et dominus dominandu
					<lb xml:id="p1z2"/>benedicat tibi princeps illustrissimo et servet
					<lb xml:id="p1z3"/>te ab omni malo. Simul effero omnia mea obsevant,
					<lb xml:id="p1z4"/>iillustrissimae celsitudini tuae. Literas co
					<lb xml:id="p1z5"/>viro d. Seneschalo
					<lb xml:id="p1z6"/>Cltrae accepi, et propter eas iumisi
					<lb xml:id="p1z7"/>quantum potui, pro mea tenuitate caussam quam
					<lb xml:id="p1z8"/>diligenti
					<lb xml:id="p1z9"/>e fide opi
					<lb xml:id="p1z10"/>agbeisenescabas ae
					<lb xml:id="p1z11"/>suis laboribus
					<lb xml:id="p1z12"/>Doleo me plura non potuisse et illum sampliora non
					<lb xml:id="p1z13"/>impetrasse. Quo ad <placeName ref="l587">Tigurinos</placeName> dominos meos, non
					<lb xml:id="p1z14"/>defuisset ipsis voluntas, si facultas adfuisset. Qua
					<lb xml:id="p1z15"/>de re pluribus egi cum d. Benesch, quem male
					<lb xml:id="p1z16"/>monitis
					<lb xml:id="p1z17"/>haec commode narrare, quam am incommode describere.
					<lb xml:id="p1z18"/>fide omnia egerim, Sum alioqui pa
					<lb xml:id="p1z19"/>ratissimus inservire li uae in omnibus, quibus
					<lb xml:id="p1z20"/>meae pares sunt vires ac commendo me pietati et clei
					<lb xml:id="p1z21"/>entiae tuae. Dominum autem exercitum oro, sive
					<lb xml:id="p1z22"/>u benedictione omnes omnium hominim vires nullae sunt
					<lb xml:id="p1z23"/>cocedat princips
					<lb xml:id="p1z24"/>ut ipse benigne et liberaliter
					<lb xml:id="p1z25"/>leb
					<lb xml:id="p1z26"/>ntet patientiam nec no  felicitatem in grati
					<lb xml:id="p1z27"/>hoc ecclesiae eius negotio, quod sustines, ut ad
					<lb xml:id="p1z28"/>dei t ecclesiarum afflictissimarumi
					<lb xml:id="p1z29"/>aberationem et salutem perducas. Plus hic sat sci
					<lb xml:id="p1z30"/>sanctorum cessupplicationes valebunt quam
					<lb xml:id="p1z31"/>omnium principum totius mundi arma. Dominus Iesus
					<lb xml:id="p1z32"/>capat et defensor suae ecclesiae servet 15
					<lb xml:id="p1z33"/>conferat pacem. <placeName ref="l587">Tiguri</placeName> 18. octobris anno salutam 15654.
					<lb xml:id="p1z34"/>15.
					<lb xml:id="p1z35"/>addictissimus
					<lb xml:id="p1z36"/>Heinrych B.
					<lb xml:id="p1z37"/>illustrissimo principi et domino
					<lb xml:id="p1z38"/>Tigurinae ecclesiae
					<lb xml:id="p1z39"/>d. Ludovico Borgonio, Contl
					<lb xml:id="p1z40"/>mnister
					<lb xml:id="p1z41"/>dsi,duci Auguiani, Pari
					<lb xml:id="p1z42"/>Franciae etc., domino meo clenentissimo.
				</p>
			</div>
