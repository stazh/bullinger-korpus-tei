	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Eadem bene, colendissime d. pater, quae nuper Germanice misi, hodie <lb xml:id="p1z2"/>Latinis verbis a d. <persName ref="p8089">Lentulo</persName> accipio tibique per quendam <lb xml:id="p1z3"/><placeName ref="l294">Logarnensem</placeName> mitto.</s>
					<s n="3" xml:lang="la">Decumbit d. <persName ref="p8089">Lentulus</persName> graviter podagra <lb xml:id="p1z4"/>et in meis tibi immensas agit gratias pro tam honorifico tuo <lb xml:id="p1z5"/>de libello suo iudicio et testimonio.</s>
					<s n="4" xml:lang="la">Mittit denuo illum <lb xml:id="p1z6"/>ad d. <persName ref="p8011">Gv[altherum]</persName>, ut et ipse legat et de eo iudicet, antequam imprim<lb xml:id="p1z7"/>endum mittat <placeName ref="l167">Genevam</placeName>.</s>
					<s n="5" xml:lang="la">Addit simul <lb xml:id="p1z8"/>haec nova in meis, quas ad me non ipse scripsit, sed <lb xml:id="p1z9"/>dictavit, in dubio esse, an <persName>Ioannes Austriacus</persName> discessurus sit <lb xml:id="p1z10"/>ex <placeName ref="l834">Italia</placeName> in <placeName ref="l875">Hispaniam</placeName> necne; papam donasse <lb xml:id="p1z11"/>eum rosa, quam in quadragesima, quam vocant, <lb xml:id="p1z12"/>solet excantare.</s>
					<s n="6" xml:lang="la">De pace <placeName ref="l522">Venetorum</placeName> cum <placeName ref="l2510">Turca</placeName> <lb xml:id="p1z13"/>neminem iam dubitare; <placeName ref="l2510">Turcam</placeName> ingentem <lb xml:id="p1z14"/>parare classem <lb xml:id="p1z15"/>Ocyssime.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l98">Churię R[aetorum]</placeName> 1574. 17. <lb xml:id="p1z16"/>aprilis.</s>
					<s n="8" xml:lang="la">T[uu<lb xml:id="p1z17"/>s t][otus] sub[iec<lb xml:id="p1z18"/>tissimus] <persName ref="p8016">Thobias Eglius</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae antistiti primario, <lb xml:id="p2z4"/>d. suo singulari o<lb xml:id="p2z5"/>bservantia colendissimo.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><lb xml:id="p2z6"/>Ann herr <persName ref="p495">Bullinger</persName>, pfarrer <lb xml:id="p2z7"/>zuͦ <placeName ref="l587">Zürich</placeName> zuͦm Grosen <lb xml:id="p2z8"/>Münster.</s>
				</p>
			</div>
		</body>
	</text>
