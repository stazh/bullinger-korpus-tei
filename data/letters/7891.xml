	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Spero tibi redditas esse postremas literas mea
					<lb xml:id="p1z2"/>quibus abinde tibi satisfactum opinor.Ab
					<lb xml:id="p1z3"/>tempore haec pro certis et indubitatis accipe
					<lb xml:id="p1z4"/>Divisit dominus lingacis hostium, adeo ut gravissima
					<lb xml:id="p1z5"/>contentiore inter duces Aumallium et nemersum
					<lb xml:id="p1z6"/>exorta, alii alio sint dilapti et remersus quidem
					<lb xml:id="p1z7"/>Ligdunum cum multis venerit, Anallius vero
					<lb xml:id="p1z8"/>sequatur.
					<lb xml:id="p1z9"/>cum reliquis i procul praeeuntem nostrorum exercituru
					<lb xml:id="p1z10"/>et iam nemine se opponente secure progredientem
					<lb xml:id="p1z11"/>In velitatione quadam bene successit nostris apud
					<lb xml:id="p1z12"/>hostes vero plena terrorum omnia. rex cum
					<lb xml:id="p1z13"/>et cardinali Lutehae rediit, quam valde
					<lb xml:id="p1z14"/>perlubata offendit, quibusdam (quorum nomina
					<lb xml:id="p1z15"/>edit, qui haec scripsit 26 superioris mensis
					<lb xml:id="p1z16"/>ad ipsas penepontas urbis excursiones facientibus
					<lb xml:id="p1z17"/>quos inquirm ille idem a catholicis ad
					<lb xml:id="p1z18"/>Hugvenotes defecisse. Ego momerantium esse
					<lb xml:id="p1z19"/>omnino mihi persuasi. Bipontinum vero c
					<lb xml:id="p1z20"/>suis constat quidem ad ligerim progressum.
					<lb xml:id="p1z21"/>sed alii raieisse affirmant, ut sese cum Amnralio
					<lb xml:id="p1z22"/>coniungat, alii recta parsios contendere, ut
					<lb xml:id="p1z23"/>hostes ab Aunalio avertat. Ego illud potius
					<lb xml:id="p1z24"/>verum esse  arbitror. In Aquitania
					<lb xml:id="p1z25"/>caesus est Brissacus a nostris una cum aliis
					<lb xml:id="p1z26"/>aliquot celebroribus hostium ducibus apud arcentm
					<lb xml:id="p1z27"/>navarrem quam Mucidanum vocant, qua postea
					<lb xml:id="p1z28"/>nostri
					<lb xml:id="p1z29"/>oppugnata trucidati sunt ad unum , qui in arce
					<lb xml:id="p1z30"/>et oppidulo sunt inventi, milites, ut aiunt,
					<lb xml:id="p1z31"/>lusminus ducenti. Italorum subsidium,
					<lb xml:id="p1z32"/>idest peditum millia quatuor et equites mille
					<lb xml:id="p1z33"/>iam in Lugdiniensem pervenerunt. Quid sequuturum
					<lb xml:id="p1z34"/>sit novit dominus suorum custos, proxime elapso
					<lb xml:id="p1z35"/>novilimio pestis in quatuor contiguis edibus emicuit
					<lb xml:id="p1z36"/>nec tamen lognis adhuc excurrit. Ora pro nobis
					<lb xml:id="p1z37"/>dominum, mi pater, ut ego illum vicissim praecor, ut te
					<lb xml:id="p1z38"/>fratrisque omnes custodiat. Genevae, 22. maii 1565.
					<lb xml:id="p1z39"/>Tuus Beza.
					<pb/>
					<lb xml:id="p2z1"/>n 2. maii 1569.
					<lb xml:id="p2z2"/>Eximio Christi
					<lb xml:id="p2z3"/>servo.
					<lb xml:id="p2z4"/>D. Henrico Bullingero,
					<lb xml:id="p2z5"/><placeName ref="l587">Tigurinae</placeName> ecclesiae
					<lb xml:id="p2z6"/>efido pastori
					<lb xml:id="p2z7"/>patri mihi plurimum
					<lb xml:id="p2z8"/>observando.
				</p>
