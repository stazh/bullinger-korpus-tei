	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Venit ad vos nobilis hic vir et, ut <lb xml:id="p1z2"/>audio ab interprete, comes regni <placeName ref="l830">Anglicani</placeName>, <lb xml:id="p1z3"/>compater in domino charissime, commendatus mihi <lb xml:id="p1z4"/>est a domino <persName ref="p3429">Vireto</persName> <placeName ref="l280">Lausannensi</placeName> a singulari <lb xml:id="p1z5"/>verę religionis zelo, propter quem sit vincula <lb xml:id="p1z6"/>quoque perpessus et in discrimen capitis adductus, <lb xml:id="p1z7"/>unde tamen in gratiam patris liberatus sit, <lb xml:id="p1z8"/>cuius authoritas magna sit in <placeName ref="l830">Anglia</placeName>.</s>
					<s n="3" xml:lang="la">Doluit <lb xml:id="p1z9"/>mihi admodum, quod non potui illi loqui nisi <lb xml:id="p1z10"/>per interpretem; nescit enim Latine.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Signi<lb xml:id="p1z11"/>ficavit mihi interpres, qui hinc <placeName ref="l28">Basileam</placeName> <lb xml:id="p1z12"/>profectus est cum equite et ipso <lb xml:id="p1z13"/><placeName ref="l830">Anglo</placeName>, non esse in comitatu illius aliquem, <lb xml:id="p1z14"/>qui Latine sciat, et tamen sic teneri eum <lb xml:id="p1z15"/>amore virorum doctorum, ut saltem illorum delectetur <lb xml:id="p1z16"/>aspectu.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quare visum est has dare ad te <lb xml:id="p1z17"/>illius nomine, id quod et domino <persName ref="p3429">Vireto</persName> placuit; <lb xml:id="p1z18"/>non dubito esse apud vos <placeName ref="l830">Anglos</placeName>, quibus<lb xml:id="p1z19"/>cum loqui possit, quorum opera tibi non sit <lb xml:id="p1z20"/>iniucundum illius futurum colloquium.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z21"/>Caeterum de <placeName ref="l167">Genevensibus</placeName> oro consyderes, quae <lb xml:id="p1z22"/>per d. <persName ref="p8018">Hallerum</persName> ad te scripsi; causa est <lb xml:id="p1z23"/>magni momenti.</s>
					<s n="7" xml:lang="la">Vehementer metuo illi <lb xml:id="p1z24"/>ecclesiae, et nisi me fallant omnia, <persName ref="p540">Calvinus</persName> <lb xml:id="p1z25"/>non est in hoc disturbio satis providus.</s>
					<s n="8" xml:lang="la">Opus <lb xml:id="p1z26"/>esset viris cordatis, qui se interponerent; <lb xml:id="p1z27"/>officium hoc esset vestrum vel <placeName ref="l28">Basiliensium</placeName>.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z28"/>Dolet <persName>Nicolaum</persName> a Pueris non esse ad vos cum <lb xml:id="p1z29"/>d. <persName ref="p8018">Hallero</persName>, sicuti constituerat, profectum, <lb xml:id="p1z30"/>quo potuisses de hac causa abunde instrui.</s>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z31"/>Optime vale, compater charissime.</s>
					<s n="11" xml:lang="la" ana="salute">Salutem toti domui <lb xml:id="p1z32"/>tę et dominis isthic, fratribus et amicis; <lb xml:id="p1z33"/>salutant te ac tuos mei omnes.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><persName ref="p2207">Heinrychulus</persName> <lb xml:id="p1z34"/>noster et tuus hoc vesperi insolito totius <lb xml:id="p1z35"/>corporis aestu correptus matrem contristavit <lb xml:id="p1z36"/>plurimum et anxiam reddidit; mihi vero spes bona <lb xml:id="p1z37"/>est crastino fore omnia opinione meliora.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z38"/><placeName ref="l41">Bernę</placeName> 1555. 13. septembris.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><persName ref="p8417">W[olfgan<lb xml:id="p1z39"/>gus] Musc[ulus]</persName>, tuus in domino.</s>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo the<lb xml:id="p2z2"/>ologo m. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/>domino ac compatri <lb xml:id="p2z5"/>suo longe charissimo.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
