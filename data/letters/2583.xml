	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia Christi tecum.</s>
					<s n="2" xml:lang="la">Scripta tua simul cum libellis <lb xml:id="p1z2"/>recepi 4.<note type="margin">a.R. =x? ..? 4.?</note> die marcii per hominem Quadum et senem, <lb xml:id="p1z3"/>optime <persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Ago vero gratias immortales <lb xml:id="p1z4"/>ob tot beneficia, quibus immeritum obruis.</s>
					<s n="4" xml:lang="la">Referat id <lb xml:id="p1z5"/>tibi cumulatissime dives ille et copiosus deus mi<lb xml:id="p1z6"/>sericordiarum etc.</s>
					<s n="5" xml:lang="la">Evangelion Christi apud <placeName ref="l404">Rapoltsteinenses</placeName> <lb xml:id="p1z7"/>contemptim iacet; conclamatum est etc.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Princeps <lb xml:id="p1z8"/>noster tandem canus vix persuaderi potuit, ut <lb xml:id="p1z9"/>dimissa scortatione proprium vas possideret in sanctificat<lb xml:id="p1z10"/>ione.</s>
					<s n="7" xml:lang="la">Agitur in eo negotio, quamvis ille aegrotet <lb xml:id="p1z11"/>apud <placeName ref="l327">Montbelgardianos</placeName> etc., de quo scripsi <persName ref="p8071">Voglero</persName>.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/>Oramus omnes enixissime dominum, ut nobis illum <lb xml:id="p1z13"/>qui (tametsi avaritia ac libidine, ut ipse nunc ultro <lb xml:id="p1z14"/>fatetur, spurcissime peccarit) constans hactenus fuit <lb xml:id="p1z15"/>in syncero pietatis negotio promovendo, sine omni s<lb xml:id="p1z16"/>uperstitione, diutissime servet.</s>
					<s n="9" xml:lang="la">Et vos orate benignissimum <lb xml:id="p1z17"/>deum, ne illo intercepto lupi devastent ecclesiolas nostras.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>De mea valetudine <persName ref="p8071">Voglerus</persName>.</s>
					<s n="11" xml:lang="la"><placeName ref="l491">Argentoratenses</placeName> min<lb xml:id="p1z19"/>istri hauddum conveniunt cum papistis, qui non cessant <lb xml:id="p1z20"/>blasphemare Christum.</s>
					<s n="12" xml:lang="la">De <placeName ref="l294">Locarnensibus</placeName> nobis constat; <lb xml:id="p1z21"/>benignus deus sit illorum causę patronus.</s>
					<s n="13" xml:lang="la">Pauci <lb xml:id="p1z22"/>comitiis intersunt; certant de asini umbra.</s>
					<s n="14" xml:lang="la">De <placeName ref="l2510">Turcicis</placeName> <lb xml:id="p1z23"/>expeditionibus inmania referuntur; multabitur <lb xml:id="p1z24"/>rursum, ut plures autumant, Germania atque prius.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z25"/>Dominus misereatur ecclesię suę atque suos perpetim illibatos <lb xml:id="p1z26"/>servet in aestuante olla huius mundi etc.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute">Hisce vale, optime <lb xml:id="p1z27"/><persName ref="p495">Bullingere</persName>; salutabis domesticos omnesque symmystas, <lb xml:id="p1z28"/>quorum nomina subtexere longum esset etc.</s>
					<s n="17" xml:lang="la"><placeName ref="l411">Richenvillae</placeName> <lb xml:id="p1z29"/>8. die marcii 1553.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio viro inprimis pietate <lb xml:id="p2z2"/>ac eruditione d. <persName ref="p495">Henrycho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z4"/>ecclesię primario concionatori, <lb xml:id="p2z5"/>fratri observando<lb xml:id="p2z6"/>.</s>
				</p>
			</div>
		</body>
	</text>
