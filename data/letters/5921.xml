	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Ne forte suspiceris negligentiorem esse me <lb xml:id="p1z2"/>in respondendo, scias literas tuas scriptas 27. augusti <lb xml:id="p1z3"/>hoc vesperi demum 22. octobris mihi esse redditas; ubi <lb xml:id="p1z4"/>tam diu delituerint, ego nescio.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Intellexi ex his, <lb xml:id="p1z5"/>quod animo meo vehementer doluit, orbatos nos <lb xml:id="p1z6"/>esse piissimo et constantissimo viro d. <persName ref="p6831">Ioanne Traversio</persName>.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ami<lb xml:id="p1z7"/>sit in hoc uno viro <placeName ref="l648">Rhetia</placeName> permultum, amiserunt <lb xml:id="p1z8"/>ecclesiae singularem patronum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quoniam vero divina i<lb xml:id="p1z9"/>ta volu<lb xml:id="p1z11"/>it voluntas et senex fuit ne<lb xml:id="p1z12"/>c diutius vivere potuisset commode inque firma fide migravit <lb xml:id="p1z13"/>ad dominum, rursus consolationem admittere deumque <lb xml:id="p1z14"/>precari debemus, ut sublato viro optimo optimum ali<lb xml:id="p1z15"/>quem nobis sufficiat, sicut quondam in locum Heliae <lb xml:id="p1z16"/>substituit Heliseum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">De filio nostro <persName>Ioanne</persName> nihil <lb xml:id="p1z17"/>ab eo die audivi, quo hac transiens me salutavit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z18"/>Curabo, ut tuto ipsi tuae reddantur literae; imo cras <placeName ref="l294">Lo<lb xml:id="p1z19"/>carnensis</placeName> quidam <persName>Baptista</persName> a <placeName ref="l21">Badis</placeName> <placeName ref="l28">Basileam</placeName> descen<lb xml:id="p1z20"/>det, cui tradam.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">D. <persName ref="p4037">Hieronymus Zanchus</persName> vir est <lb xml:id="p1z21"/>longe doctissimus <placeName ref="l36">Bergomas</placeName>, linguarum peritus, in scriptoribus <lb xml:id="p1z22"/>vetustis versatissimus, disputator acutus et exer<lb xml:id="p1z23"/>citatus, eloquens et indefessus et in ministerio Christi <lb xml:id="p1z24"/>diu iam mihi notus fuit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l491">Argentinae</placeName> una cum <lb xml:id="p1z25"/>d. <persName ref="p8111">Martyre</persName> beatae memoriae profitebatur et eandem <lb xml:id="p1z26"/>ob causam, ob quam <persName ref="p8111">Martyr</persName> maere non potuit, et <persName ref="p4037">Zanchius</persName> <lb xml:id="p1z27"/>migrare voluit.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Nescio tamen, qui fiat, quod <lb xml:id="p1z28"/>nondum ascendit; metuo, ne quid illi eveniat adversi; <lb xml:id="p1z29"/>Lutherani enim ipsum oderunt vehementissime.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Res et <lb xml:id="p1z30"/>tempus, ubi ver aderit, dabunt consilium, quo mittas <lb xml:id="p1z31"/>filium.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Audimus hic in <placeName ref="l832">Gallia</placeName> rursus semina <lb xml:id="p1z32"/>spargi dissensionum.</s>
					<s n="13" xml:lang="la">Pro certo tamen nihil affirmo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z33"/>Ego tamen puto <placeName>Guysianis</placeName> in <placeName ref="l832">Gallia</placeName> et potestate exi<lb xml:id="p1z34"/>stentibus nullam solidam pacem futuram.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Dominus <lb xml:id="p1z35"/>iudicet.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Pro certo hic referunt in <placeName ref="l822">Germania</placeName> <lb xml:id="p1z36"/>motus graves exoriri et passim conscribi mi<lb xml:id="p1z37"/>lites; quia vero nihildum comperti habeo, malo <lb xml:id="p1z38"/>de his non plura scribere.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Cupis scire, ut <lb xml:id="p1z39"/>valeam, mi domine et frater: ut possum.</s>
					<s n="18" xml:lang="la">Quotidie <lb xml:id="p1z40"/>sentio vires animi flaccescere, utpote frac<lb xml:id="p1z41"/>tas assiduis curis et laboribus; frequentius laboro <lb xml:id="p1z42"/>gravibus capitis doloribus et aliis infirmitatibus, <lb xml:id="p1z43"/>quae res monet me, sarcinas colligam <lb xml:id="p1z44"/>et itineri accingam me desideratissimo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Ora pro <lb xml:id="p1z45"/>me semper dominum, ut mihi adsit et servet a <lb xml:id="p1z46"/>malo.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><persName ref="p8079">Iulium Mediolanensem</persName> salvum cupio et alios <lb xml:id="p1z47"/>fratres.</s>
					<s n="21" xml:lang="la" ana="farewell">Vale vir amicissime.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Dominus benedicat tibi et <lb xml:id="p1z48"/>tuis.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 22. octobris sub vesperam 1563.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z49"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p8432">Fri<lb xml:id="p2z2"/>derycho a Salice</persName>, viro apud <lb xml:id="p2z3"/><placeName ref="l648">Rhetos</placeName> primario, domino meo <lb xml:id="p2z4"/>colendo et amico syn<lb xml:id="p2z5"/>cerissimo.</s>
				</p>
