	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quid causae sit, cur nihil respondeas, facile divino.</s>
					<s n="3" xml:lang="la">Times, ne quid accidat inde mali, <lb xml:id="p1z2"/>exemplo fortasse territus.</s>
					<s n="4" xml:lang="la">Interim autem, dum taces, crede mihi, suspicionem <lb xml:id="p1z3"/>auges, rem esse multo pessimam.</s>
					<s n="5" xml:lang="la">Igitur si de hac non putas scribendum, de <persName ref="p467">Buceri</persName> <lb xml:id="p1z4"/>saltem actione<note xml:id="fn1" type="footnote" n="1">Zu <persName ref="p467">Bucers</persName> Reise durch die <placeName ref="l862">Eidgenossenschaft</placeName> s. oben <ref target="file10245">[Nr. 214]</ref> S. 112, Anm. 3.</note> significes<note xml:id="fn2" type="footnote" n="2">Demnach war <persName ref="p8418">Myconius</persName> noch nicht im Besitz der Erklärung der <placeName ref="l587">Zürcher</placeName> Geistlichen an <persName ref="p467">Bucer</persName> vom 8. Mai 1533, s. oben <ref target="file10250">Nr. 219</ref>.</note>.</s>
					<s n="6" xml:lang="la">Omnis etenim hic mora gravis est.</s>
					<s n="7" xml:lang="la"><persName ref="p5565">Capito</persName> fuit hic inter<lb xml:id="p1z5"/>ea, quamvis una tantum nocte.</s>
					<s n="8" xml:lang="la">De rebus domesticis nescio, quid fuerit negocii.</s>
					<s n="9" xml:lang="la">Dixit<pb type="edition" next="125"/> n<lb xml:id="p1z6"/>egocia alia se domum vocare.</s>
					<s n="10" xml:lang="la">Nam decem et septem comites praeter nobilitatem aliam esse, qui <lb xml:id="p1z7"/>nescio quas lites molirentur propter canonicos Argentmensibus<note xml:id="fn3" type="footnote" n="3">Es handelt sich wohl um Streitigkeiten mit den Grafen in den <placeName ref="l491">Straßburg</placeName> umgebenden Grafschaften, die zum Teil katholisch geblieben waren. Bereits unmittelbar nach Abschaffung der Messe im März 1529 hatten diese vor, <placeName ref="l491">Straßburg</placeName> auf dem Reichstag zu <placeName ref="l471">Speyer</placeName> vor den Reichsständen zu verklagen (s. <bibl source="b480">PC</bibl> I 328f. 338).</note>.</s>
					<s n="11" xml:lang="la">Ob eam causam optare, <lb xml:id="p1z8"/>ut <persName ref="p467">Bucerus</persName> properaret.</s>
					<s n="12" xml:lang="la">Celebravimus nos synodum<note xml:id="fn4" type="footnote" n="4">Zur <placeName ref="l28">Basler</placeName> Mai-Synode von 1533 s. <bibl source="b53">ABaslerRef</bibl> VI 272f.</note>.</s>
					<s n="13" xml:lang="la">Dominos invenimus semper obsequentes.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z9"/>Deus largiatur, ut perdurent.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Vale cum fratribus omnibus.</s>
					<s n="16" xml:lang="la">Rescribito, quicquid id <lb xml:id="p1z10"/>sit.</s>
					<s n="17" xml:lang="la">Carere nanque literis tuis diutius non valeo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l28">Basileae</placeName>, 13. maii anno 3<lb xml:id="p1z11"/>3.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z12"/><persName ref="p8418">Os. Myco.</persName> <lb xml:id="p1z13"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho Bullingero</persName> <lb xml:id="p2z2"/>docto pioque, amico vene<lb xml:id="p2z3"/>rando.</s>
					<s n="21" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
