	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non venit ad me hic nuncius, donec iamiam <lb xml:id="p1z2"/>discedere vellet.</s>
					<s n="3" xml:lang="la">Itaque non possum per eum omnia quę vellem <lb xml:id="p1z3"/>scribere.</s>
					<s n="4" xml:lang="la">Tuas tamen accepi, et ingentes tibi ago <lb xml:id="p1z4"/>gratias pro tuo de Gratia Dei opere sancto.</s>
					<s n="5" xml:lang="la">Habeo <lb xml:id="p1z5"/>duo exemplaria Actorum contra <persName ref="p6589">Servetum</persName>, quorum alterum <lb xml:id="p1z6"/>tibi, alterum d. <persName ref="p8011">Gvalthero</persName> pertinet.</s>
					<s n="6" xml:lang="la">Sed non potui <lb xml:id="p1z7"/>hunc his gravare.</s>
					<s n="7" xml:lang="la">Mittam ea proxime per <persName ref="p7879">Witem<lb xml:id="p1z8"/>bachii</persName> nepotem, qui ad vos cum d. <persName ref="p8011">Gvalthero</persName> <lb xml:id="p1z9"/>contubernium habiturus proficiscitur.</s>
					<s n="8" xml:lang="la">Ego ad nuptias <lb xml:id="p1z10"/>quasdam avocor.</s>
					<s n="9" xml:lang="la">Ideo nunc plura non possum.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z11"/>Commendo me tibi semper.</s>
					<s n="11" xml:lang="la" ana="farewell">Bene vale cum tuis <lb xml:id="p1z12"/>omnibus.</s>
					<s n="12" xml:lang="la">Datę <placeName ref="l41">Bernae</placeName> 19. februarii 1554.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z13"/>Tuus <persName ref="p8018">Hallerus</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName> domino <lb xml:id="p2z4"/>et compatri charissimo <lb xml:id="p2z5"/>suo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
