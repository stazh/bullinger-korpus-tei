	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nihil eram scripturus propterea, quod ad fratrem <lb xml:id="p1z2"/>quaedam mitterem, ut ea tibi communicaret.</s>
					<s n="3" xml:lang="la">Sed <lb xml:id="p1z3"/>quod tam idoneum nuncium habeam, coniunctissimum <lb xml:id="p1z4"/>nostrum dominum et affinem d. <persName ref="p6836">Emanuelem</persName>, nolui eum <lb xml:id="p1z5"/>prorsus sine meis ad te dimittere.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Omnia autem nostra <lb xml:id="p1z6"/>audies ex ipso.</s>
					<s n="5" xml:lang="la">Interea quę amplius accepi, mitto, <lb xml:id="p1z7"/>sed lingua <placeName ref="l832">Gallica</placeName>, quia non licuit, ut interea <lb xml:id="p1z8"/>transscriberentur ista in linguam Germanicam.</s>
					<s n="6" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z9"/>vale.</s>
					<s n="7" xml:lang="la">De reliquis paucis ante diebus scripsi.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/><placeName ref="l41">Bernae</placeName> 13. aprilis 1573.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><persName ref="p8018">I[<lb xml:id="p1z11"/>ohannes] Hall[erus</persName>] tuus.</s>
				</p>
				<p>
					<note>[Adresse a.t.:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, domino meo <lb xml:id="p2z3"/>honorando et compatri <lb xml:id="p2z4"/>charissimo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
