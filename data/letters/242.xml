					<s n="2" xml:lang="la">Quamvis adhuc aegerrime valeat uxor <lb xml:id="p1z2"/>et graviter decumbat ex ardore febrili, sicuti <lb xml:id="p1z3"/>opinor, et ex liberis quoque aliquot, ut <lb xml:id="p1z4"/>nesciam, quando hinc ad vos, sicuti semper <lb xml:id="p1z5"/>constitui, solvere queam, quoniam tamen ex <lb xml:id="p1z6"/>indicio D. <persName ref="p506">Butleri</persName> <placeName ref="l830">Angli</placeName>, qui has reddit, <lb xml:id="p1z7"/>cognovi dominum <persName ref="p4851">Froschouerum</persName> aedes, quas <lb xml:id="p1z8"/>mihi destinaverat, aliis accommodaturum, nisi <lb xml:id="p1z9"/>citius ad vos divertam, visum est human<lb xml:id="p1z10"/>itatem tuam, virorum charissime, hac iure <lb xml:id="p1z11"/>implorare, ut dictum hospicium ad adventum <lb xml:id="p1z12"/>meum servari cures.</s>
					<s n="3" xml:lang="la">Veniam enim cum familia <lb xml:id="p1z13"/>mea utarque gratia et benevolentia am<lb xml:id="p1z14"/>plissimi vestri senatus, quam opera vestra, <lb xml:id="p1z15"/>fratres in domino dilecti, impetratam agnosco <lb xml:id="p1z16"/>et amplector, nihil haesitans dominum, quę <lb xml:id="p1z17"/>reliqua sunt, pro sua providentia clemen<lb xml:id="p1z18"/>tissime curaturum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ceterum, quae hic <lb xml:id="p1z19"/>de rebus <placeName ref="l749">Saxoniae</placeName> spargantur, forsan <lb xml:id="p1z20"/>ante me ex literis D. <persName ref="p8049">Vadiani</persName> cognovisti.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z21"/>Utinam evigilet dominus et maliciam impiorum <lb xml:id="p1z22"/>hominum aliqua saltem ratione inspiciat et <lb xml:id="p1z23"/>exempli vice visitet.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Optime vale.</s>
					<s n="7" xml:lang="la" ana="salute">Salutem <lb xml:id="p1z24"/>uxori, liberis, fratribus et amicis omnibus<lb xml:id="p1z25"/>.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z26"/><placeName ref="l473">Sangalli</placeName> 1548.</s>
					<s n="9" xml:lang="la">2<lb xml:id="p1z27"/>5. Augusti.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><persName ref="p8417">Wolfgangus Musculus</persName>, tuus <lb xml:id="p1z28"/>in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro <lb xml:id="p2z2"/>domino <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z4"/>ecclesiae<lb xml:id="p2z5"/>pastori fidelissimo, <lb xml:id="p2z6"/>domino ac fratri <lb xml:id="p2z7"/>in Christo <lb xml:id="p2z8"/>c<lb xml:id="p2z9"/>harissimo.</s>
				</p>
			</div>
		</body>
	</text>
