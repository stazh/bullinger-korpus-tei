	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>cum consul nostr, trae esset profecturum
					<lb xml:id="p1z2"/>misit hodie ad me, si quid ad
					<lb xml:id="p1z3"/>scribere veltem; id facerem se enim
					<lb xml:id="p1z4"/>perlibenter turaturum. Ego vero etsi
					<lb xml:id="p1z5"/>plane nihil habebam, quod te scire
					<lb xml:id="p1z6"/>veem tantem propter certas causa
					<lb xml:id="p1z7"/>scribendium duxi, ne ille sine meis
					<lb xml:id="p1z8"/>literis ad te veniret, maxime, quod
					<lb xml:id="p1z9"/>intelligerem, cum non gravatim
					<lb xml:id="p1z10"/>sed cupios literae acceptireum
					<lb xml:id="p1z11"/>non est necesse, ut eum tibi commendum
					<lb xml:id="p1z12"/>qui iam ante ex virtutibus suis
					<lb xml:id="p1z13"/>tibi motus est. Nunc consulatum
					<lb xml:id="p1z14"/>administrat et legationem ob
					<lb xml:id="p1z15"/>nomine trium Foederum. Ita
					<lb xml:id="p1z16"/>non dubito, quin apud vestros
					<lb xml:id="p1z17"/>eum locum sit abetenturus, quem propter
					<lb xml:id="p1z18"/>officium meretur. Novi plane
					<lb xml:id="p1z19"/>vil e eti, quid sribio er
					<lb xml:id="p1z20"/>id ante bibliopola noster nesio
					<pb/>
					<lb xml:id="p2z1"/>quid retulit de concione Brentii Franco
					<lb xml:id="p2z2"/>forti habita, cui alius Lutheranus
					<lb xml:id="p2z3"/>contradixisset; non potui fidem homini
					<lb xml:id="p2z4"/>habere, quod tu de re tanti momenti
					<lb xml:id="p2z5"/>nihildum scripsisses. Si quid est, quaeso,
					<lb xml:id="p2z6"/>significa. Vale, reverende in Christi
					<lb xml:id="p2z7"/>pater, deum rogo, ut te nobis diu
					<lb xml:id="p2z8"/>incolumem conservet.
					<lb xml:id="p2z9"/>29. decembris anno 1562.
					<lb xml:id="p2z10"/>Tui observantissimus
					<lb xml:id="p2z11"/>Ioannes Fabrici
					<lb xml:id="p2z12"/>ostri mercatores non ad vos commeant.
					<lb xml:id="p2z13"/>propter dies festos; itaque quid Gallia
					<lb xml:id="p2z14"/>parturiat avidissime expectam.
					<lb xml:id="p2z15"/>Si consul noster redierit, antequam mercatorem
					<lb xml:id="p2z16"/>veniant, per eundem rescribus, quam habetur.
					<lb xml:id="p2z17"/>ccaeso tua paternitatem has literis affinii
					<lb xml:id="p2z18"/>crddendas curet, insunt pecuniae, ni
					<lb xml:id="p2z19"/>tuis seiungere, quominus amitterentur
				</p>
			</div>
