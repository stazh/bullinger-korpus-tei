	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Ad priores literas<note xml:id="fn1" type="footnote" n="1">Nicht erhalten.</note> respondebo, charissime frater, <lb xml:id="p1z2"/>ubi moderationem tuam in praedestinationis <lb xml:id="p1z3"/>causa<note xml:id="fn2" type="footnote" n="2">Gemeint ist <persName ref="p495">Bullingers</persName> Karlstagsrede vom 28. Januar 1535 "Quae moderatio servanda sit..." (vgl. unten <ref target="file10630">Nr. 592</ref> mit Anm. 2).</note> remisero, quod brevi fiet<note xml:id="fn3" type="footnote" n="3"><persName ref="p4079">Zwick</persName> sandte <persName ref="p495">Bullingers</persName> Schrift am 3. Juli zurück, vgl. unten <ref target="file10646">Nr. 608</ref>, 1-11.</note>.</s>
					<s n="3" xml:lang="la">Relegit <persName ref="p8178">T<lb xml:id="p1z4"/>homas</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p8178">Thomas Blarer</persName> nahm schon am 16. Juni Stellung, s. unten <ref target="file10630">Nr. 592</ref>.</note>, iam in manu est <persName ref="p4082">fratris</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p4082">Konrad Zwick</persName>.</note>, deinde <lb xml:id="p1z5"/>in meam quoque recipiam.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">In posterioribus <lb xml:id="p1z6"/>literis<note xml:id="fn6" type="footnote" n="6">Nicht erhalten; vgl. oben <ref target="file10623">Nr. 585</ref>, 22-31.</note> summe placent, quae <persName ref="p6459">Alexandrum</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p6459">Alexander Schmutz</persName>.</note> adtinent.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Ego, cum nuper ex <placeName ref="l491">Argentorato</placeName> rediisset, <lb xml:id="p1z8"/>vici coram fratribus omniaque argumenta fregi homini.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>An obtemperaturus sit, nescio, sed nihil sum <lb xml:id="p1z10"/>praetermissurus.</s>
					<s n="7" xml:lang="la">Nam pessime odi desertiones <lb xml:id="p1z11"/>ecclesiarum.</s>
					<s n="8" xml:lang="la">De aliis proxime.</s>
				</p>
				<p>
					<s n="9" xml:lang="de"><lb xml:id="p1z12"/>O wie denck ich so offt dran, wie wir <lb xml:id="p1z13"/>so guͦt leben ghept hond zuͦ <placeName ref="l515">Urdorf</placeName><note xml:id="fn8" type="footnote" n="8">Zu <persName ref="p4079">Zwicks</persName> Badeaufenthalt in <placeName ref="l515">Urdorf</placeName> (<placeName ref="l803">Kt. Zürich</placeName>) vgl. oben <ref target="file10610">Nr. 572</ref>, Anm. 37.</note> Es <lb xml:id="p1z14"/>wurt mir min lebenlang nymer als<note xml:id="fn9" type="footnote" ana="lex" n="9">so.</note> guͦt.</s>
				</p>
				<p>
					<s n="10" xml:lang="de" ana="salute"><lb xml:id="p1z15"/>Grutzen mir uwer <persName ref="p8051">husfrowen</persName><note xml:id="fn10" type="footnote" ana="bio" n="10"><persName ref="p8051">Anna Bullinger, geb. Adlischwyler</persName>.</note> und die <lb xml:id="p1z16"/><persName ref="p7042">muͦter</persName><note xml:id="fn11" type="footnote" ana="bio" n="11"><persName ref="p7042">Anna Bullinger, geb. Wiederkehr</persName>.</note> 1, ja yederman.</s>
					<s n="11" xml:lang="de">Und sye got mit <lb xml:id="p1z18"/>uch allen.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z19"/>5. <lb xml:id="p1z20"/>iunii 1535.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><persName ref="p4079">Io. Z.</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z4"/>antistiti dignissimo, <lb xml:id="p2z5"/>fratri suo bene meritissimo.</s>
				</p>
			</div>
		</body>
	</text>
