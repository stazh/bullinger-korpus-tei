	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Gratias ago
					<lb xml:id="p1z2"/>maximas pro eo quod tamen
					<lb xml:id="p1z3"/>S. D.
					<lb xml:id="p1z4"/>humaniter nos exceperis tractaveritque
					<lb xml:id="p1z5"/>liberaliter. Dominus rependat tibi et concedat
					<lb xml:id="p1z6"/>libi uxori Ioannes Rodolu et universae domini
					<lb xml:id="p1z7"/>tuaeut incolumes et laeti mox ad nos redeatur
					<lb xml:id="p1z8"/>i, ubi reversi essemus domum sub horam
					<lb xml:id="p1z9"/>per postam hae literae allatae sunt, quas cum suiam
					<lb xml:id="p1z10"/>i fore acceptissimas per proprium hunc nu
					<lb xml:id="p1z11"/>ad te mittere nolui. Per hunc eundem
					<lb xml:id="p1z12"/>hosie remittes. Salutabis omnes tuos et meos
					<lb xml:id="p1z13"/>optime vale 11. iulii 1562. Hn.
					<lb xml:id="p1z14"/>omnes nos salutant.
					<lb xml:id="p1z15"/>Bullingerus tuus.
					<pb/>
					<lb xml:id="p2z1"/>.
					<lb xml:id="p2z2"/>Smo charissimo Rodolpho
					<lb xml:id="p2z3"/>Gvalthero
					<lb xml:id="p2z4"/>Ordorff
					<lb xml:id="p2z5"/>
					<lb xml:id="p2z6"/>Dmn.
					<lb xml:id="p2z7"/>md.
				</p>
			</div>
		</body>
	</text>
