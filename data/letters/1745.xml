	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la">Literis tuis proximis, <persName ref="p495">Bullingere</persName> colendissime, gravioribus im<lb xml:id="p1z2"/>peditus negociis respondere non potui, unde veniam a te eo cit<lb xml:id="p1z3"/>ius impetraturum me non dubito.</s>
					<s n="3" xml:lang="la">Libros, de quibus tum <lb xml:id="p1z4"/>temporis ad me scribebas, apud nostrates explorare nullo <lb xml:id="p1z5"/>pacto potui, quos vix extare excusos puto.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Literas <lb xml:id="p1z6"/>ad <persName>Maurum</persName>, Francorum legatum, remitto; ea enim hora, qua <lb xml:id="p1z7"/><persName>Theodorus</persName> vester, vir ornatissimus, urbem nostram ingressu<lb xml:id="p1z8"/>s est, post longam aegrotationem in domino pie obdor<lb xml:id="p1z9"/>mivit.</s>
					<s n="5" xml:lang="la">Vocavit etiam ex hac mundi miseria <persName ref="p8418">Myconium</persName> <lb xml:id="p1z10"/>nostrum, <placeName ref="l28">Basiliensis</placeName> ecclesiae vigilantissimum pastorem, do<lb xml:id="p1z11"/>minus, qui iam sua visitatione atque paterna castigatione <lb xml:id="p1z12"/>circiter duo hominum millia absumpsit dira <lb xml:id="p1z13"/>illa lue, quae ubivis multos corripit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Literas <lb xml:id="p1z14"/>vero tuas ad <persName ref="p3207">Anglorum regis</persName> legatum <persName ref="p4639">Michaeli <lb xml:id="p1z15"/>Dillero</persName>, viro in omni scientiarum atque liguarum genere <lb xml:id="p1z16"/>clarissimo viro, curandas tradidi, qui ab <persName ref="p2411">Othone Henrico</persName>, <lb xml:id="p1z17"/>illustrissimo principe, ex agro <placeName ref="l28">Basiliensi</placeName> vo<lb xml:id="p1z18"/>catus ad ecclesiae ministerium <placeName ref="l210">Heydelbergam</placeName> properans <lb xml:id="p1z19"/>eas probe curabit.</s>
					<s n="7" xml:lang="la">Erbio propediem ea etiam, quae <lb xml:id="p1z20"/>scripsisti, certo atque tuto nuncio mittam.</s>
					<s n="8" xml:lang="la">Quae de clade <lb xml:id="p1z21"/><placeName ref="l2510">Turcica</placeName> scribis dubitative vera sunt, proh dolor; <lb xml:id="p1z22"/><placeName ref="l2510">Turca</placeName> enim foeliciter ad 29. septembris contra christia<lb xml:id="p1z23"/>nos pugnans plus quam quindecim hominum millia <lb xml:id="p1z24"/>interfecisse fertur.</s>
					<s n="9" xml:lang="la"><persName>Caesar</persName> adhuc circa <placeName>Lauterburgum</placeName>, <lb xml:id="p1z25"/><placeName>Landoiam</placeName> et <placeName>Neoburgum</placeName> moratur, et quo profecturus <lb xml:id="p1z26"/>sit tandem, paucis notum est.</s>
					<s n="10" xml:lang="la">Marchio vero <placeName ref="l1048">Brandebur<lb xml:id="p1z27"/>gensis</placeName> in <placeName ref="l1028">Trevirensi</placeName> episcopatu occupavit <placeName>Hermelstein</placeName>, <lb xml:id="p1z28"/>castrum omnium munitissimum, quo Cęsaris transitum <lb xml:id="p1z29"/>per <placeName ref="l2459">Rhenum</placeName> impediat; dicitur tamen iam ascen<lb xml:id="p1z30"/>dere, ut comeatum ex <placeName ref="l632">Alsatia</placeName> et <placeName ref="l2836">Suntgavia</placeName> im<lb xml:id="p1z31"/>peratori prohibeat.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Quid <persName>Gallus</persName> agat, nondum <lb xml:id="p1z32"/>audio.</s>
					<s n="12" xml:lang="la">Tu caetera, quae apud nos incerta fama sparguntur, <lb xml:id="p1z33"/>ex <persName ref="p8171">Theodoro</persName> vestro, viro clarissimo, intelliges, <lb xml:id="p1z34"/>quem prolixissimae epistolae instar habebis.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale cum <lb xml:id="p1z35"/>tota familia et ecclesia vestra.</s>
					<s n="14" xml:lang="la"><placeName ref="l28">Basileae</placeName> 17. octobris <lb xml:id="p1z36"/>anno 1552.</s>
					<s n="15" xml:lang="la" ana="salute">Resalutat te dominus <persName ref="p8054">Marcus Bersius</persName> <lb xml:id="p1z37"/>cum ceteris.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z38"/>Tuus ex animo <lb xml:id="p1z39"/><persName ref="p8406">Conradus Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo atque vigilantissimo <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>pastori <persName ref="p495">Henrico <lb xml:id="p2z4"/>Bullingero</persName>, fratri in Christo <lb xml:id="p2z5"/>charissimo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
