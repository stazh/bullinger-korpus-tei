	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto hic, de qua proxime scripsi, sarcinulam librorum <persName ref="p3375">Vergerii</persName>; <lb xml:id="p1z2"/>tu scis, quo amplius mittas.</s>
					<s n="3" xml:lang="la"><persName ref="p3700">Eberhardi</persName> causa <lb xml:id="p1z3"/>magis ac magis ingravescit.</s>
					<s n="4" xml:lang="la">Decretum est a senatu, <lb xml:id="p1z4"/>ut in vincula coniiciatur, non illa, ubi adulteri castigari <lb xml:id="p1z5"/>solent, sed illa, quibus facinorosi custodiuntur alii.</s>
					<s n="5" xml:lang="la">Illuc <lb xml:id="p1z6"/>quoque scortum ex adulterorum carcere translatum est, sine <lb xml:id="p1z7"/>dubio, ut amplius quid patiatur.</s>
					<s n="6" xml:lang="la">Ipse vero, ut proxime scripsi, <lb xml:id="p1z8"/>profugit.</s>
					<s n="7" xml:lang="la">Dominus misereatur nostri, ut tollat scandala illa.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z9"/>Hodie nuptias celebrat m. <persName ref="p8092">Benedictus Aretius</persName>, ludi <lb xml:id="p1z10"/>nostri moderator, valde doctus et modestus vir.</s>
					<s n="9" xml:lang="la"><placeName ref="l307">Moguntinus</placeName> <lb xml:id="p1z11"/>et <placeName ref="l1028">Trevirensis</placeName> archiepiscopi iam in itinere sunt versus <lb xml:id="p1z12"/><placeName ref="l1107">Tridentum</placeName>; ita <persName ref="p18538">Caesar</persName> urget.</s>
					<s n="10" xml:lang="la">Vigilandum nobis et o[randum].</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p6096">Sledanus</persName> quidam <placeName ref="l491">Argentorati</placeName> <persName ref="p8417">Musculum</persName> sollicitat, u[t in] <lb xml:id="p1z14"/><placeName ref="l830">Angliam</placeName> proficiscatur; sed procul est hoc ab illius mente; no[n pa]<lb xml:id="p1z15"/>tietur facile se hinc avelli.</s>
					<s n="12" xml:lang="la">Mirandulam iam obsidiari <lb xml:id="p1z16"/>audio.</s>
					<s n="13" xml:lang="la">Expecto, quid tu nobis des novi.</s>
					<s n="14" xml:lang="la" ana="salute">Vale cum <lb xml:id="p1z17"/>tuis omnibus, quos mea et <persName ref="p8417">Musculi</persName> domus una tecum <lb xml:id="p1z18"/>salutat.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Saluta nostro nomine fratres omnes.</s>
					<s n="16" xml:lang="la"><placeName ref="l41">Bernae</placeName> <lb xml:id="p1z19"/>27. augusti 1551.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z20"/>Tuus in domino <lb xml:id="p1z21"/><persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem erwirdigen <lb xml:id="p2z2"/>hochglerten m. <persName ref="p495">Heinrych <lb xml:id="p2z3"/>Bullinge[r]n</persName>, mi<lb xml:id="p2z4"/>nem günstigen, lieben <lb xml:id="p2z5"/>herren und gfatteren.</s>
				</p>
				<p>
					<s n="19" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
