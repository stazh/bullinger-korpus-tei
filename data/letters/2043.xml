	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Gratias ago tibi maximas, colendissime et charissime domine <lb xml:id="p1z2"/>compater, pro tua diligentia, qua effecisti ut responsum <lb xml:id="p1z3"/>vestrum <placeName ref="l167">Genevatibus</placeName> datum mature satis et in <lb xml:id="p1z4"/>tempore receperimus.</s>
					<s n="3" xml:lang="la">Nostrum vestro omnino convenit, idemque <lb xml:id="p1z5"/>modus in respondendo servatus.</s>
					<s n="4" xml:lang="la">Exposuimus senatui <lb xml:id="p1z6"/>nostro (sic ab illo iussi) articulatim errores <persName ref="p6589">Servet<lb xml:id="p1z7"/>i</persName> primarios.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quibus auditis adeo infremuerunt omnes <lb xml:id="p1z8"/>ut non dubitarem, si in vinculis ipsorum detineretur, quin <lb xml:id="p1z9"/>exureretur.</s>
					<s n="6" xml:lang="la">Quoniam vero materia erat illis parum <lb xml:id="p1z10"/>intelligibilis, voluerunt ut nos privato scripto sena<lb xml:id="p1z11"/>tui <placeName ref="l167">Genevensi</placeName> responderemus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Addiderunt ipsi quoque pro <lb xml:id="p1z12"/>se scriptum, quo serio hortantur <placeName ref="l167">Genevenses</placeName> ut pestem hanc <lb xml:id="p1z13"/>sic tollant, ne vicinus ager nostratium hac quoque per ipsorum <lb xml:id="p1z14"/>negligentiam inficiatur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Fit enim hoc plaerumque, ut quę <placeName ref="l167">Ge<lb xml:id="p1z15"/>nevę</placeName> turbę intricantur nobis tandem sint exedendę, cum <lb xml:id="p1z16"/>extra ipsorum moenia in ditionem urbis nostrę erumpunt.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/>Ideo serio fuerunt admoniti.</s>
					<s n="10" xml:lang="la">Nostrum vero responsum, <lb xml:id="p1z18"/>quoniam vestro consentit per omnia, non opus est ut mittam.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/>A <persName ref="p3099">Sulcero</persName> nihil accepi.</s>
					<s n="12" xml:lang="la">Responsionis autem vestrae exemplar <lb xml:id="p1z20"/>per <persName ref="p8303">Fridolinum</persName> missum d. <persName ref="p8055">Blaurero</persName> transmisi, uti iusseras.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/>Expectamus nunc eventum.</s>
					<s n="14" xml:lang="la">Quod res novas <lb xml:id="p1z22"/>attinet, nihil plane habemus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><persName ref="p8417">Musculus</persName> a <persName ref="p9046">Pistorio</persName> <lb xml:id="p1z23"/>sollicitatur, ut vocatus a landgrafio in <placeName ref="l213">Hassiam</placeName> commigret; <lb xml:id="p1z24"/>sed non est periculum, ut a nobis avellatur.</s>
					<s n="16" xml:lang="la">Videt enim nunc, quid <lb xml:id="p1z25"/>sibi, si in <placeName ref="l830">Angliam</placeName> profectus fuisset, contigisset.</s>
					<s n="17" xml:lang="la" ana="salute">Salutat <lb xml:id="p1z26"/>is te cum suis omnibus.</s>
					<s n="18" xml:lang="la">Facit idem mea uxor, quę salva <lb xml:id="p1z27"/>et incolumis huc rediit, cuius nomine tibi magnas ago gratias <lb xml:id="p1z28"/>pro humanitate et beneficentia illi praestita.</s>
					<s n="19" xml:lang="la">Faxit dominus, ut <lb xml:id="p1z29"/>rependere possim.</s>
					<s n="20" xml:lang="la">Salvi sint omnes tui.</s>
					<s n="21" xml:lang="la"><placeName ref="l41">Bernę</placeName> 19. octobris 1553.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z30"/><persName ref="p8440">Gervasii</persName> responsionem habebimus, quam primum fieri possit<lb xml:id="p1z31"/>.</s>
					<s n="23" xml:lang="la"><lb xml:id="p1z32"/><persName ref="p8018">Ioannes Hallerus</persName>, <lb xml:id="p1z33"/>tuus ex animo.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName> <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino et compatri suo <lb xml:id="p2z5"/>venerando.</s>
				</p>
				<p>
					<s n="25" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
