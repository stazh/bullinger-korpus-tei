	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l491">Argentinae</placeName> primo Junii 1549.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>S. P.</s>
					<s n="3" xml:lang="la">Posteaquam priores meas assignaveram literas, <persName ref="p495">Bullingere</persName> <lb xml:id="p1z3"/>amicissime, atque de nuntio omnino solicitus essem, incidi fort<lb xml:id="p1z4"/>e fortuna in istum nobilem <placeName ref="l168">Gandavensem</placeName>, qui sese ad vos <lb xml:id="p1z5"/>profecturus destinavit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Vir est ut genere ita moribus, fi<lb xml:id="p1z6"/>de et pietate nobilis; vixit aliquandiu <placeName ref="l491">Argentinae</placeName>, hinc <lb xml:id="p1z7"/>in <placeName ref="l830">Angliam</placeName> profectus, unde propter balneandi necessitatem <lb xml:id="p1z8"/>iam ad Thermas huc <placeName ref="l1343">Ferinas</placeName> venit.</s>
					<s n="5" xml:lang="la">A balneis placuit <lb xml:id="p1z9"/>ei invisere partes ignotas, <placeName ref="l587">Tigurum</placeName> prae ceteris tum fama <lb xml:id="p1z10"/>tum doctrina pura celebre.</s>
					<s n="6" xml:lang="la">Non abhorret a nostra religione, <lb xml:id="p1z11"/>doctus alioqui et pii iuditii; per dies quatuorde<lb xml:id="p1z12"/>cim apud vos erit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Cupiebat commendationes meas; <lb xml:id="p1z13"/>igitur tibi, humanissime <persName ref="p495">Bullingere</persName>, ita commendo, ut non <lb xml:id="p1z14"/>ingratior tibi sit et ecclesiae, quam mihi quivis <placeName ref="l587">Tigurinorum</placeName> <lb xml:id="p1z15"/>est et ubivis erit.</s>
					<s n="8" xml:lang="la"><placeName ref="l832">Gallorum</placeName> ecclesiae alumnus [alum] est, <lb xml:id="p1z16"/>qui non abhorrent a vestra religione.</s>
					<s n="9" xml:lang="la">Quod reliquum <lb xml:id="p1z17"/>est, non dubito, quin praestabis ultro, posteaquam homine<lb xml:id="p1z18"/>m iterum et tertio conveneris.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Bene vale<lb xml:id="p1z20"/>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z21"/>Tuus totus <persName ref="p505">Burcherus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Docto iuxta ac pio <lb xml:id="p2z2"/>viro D. <persName ref="p495">Bullingero</persName>, <lb xml:id="p2z3"/>amico colendo.</s>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
