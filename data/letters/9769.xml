	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>fürgelwerten ser und vorstsenwr
					<lb xml:id="p1z2"/>Linter frusnd nap spakumen
					<lb xml:id="p1z3"/>mid syrben lerende hifturs
					<lb xml:id="p1z4"/>genAugspurg, wiewoll w des ollen
					<lb xml:id="p1z5"/>Eubr Haben Mogter he
					<lb xml:id="p1z6"/>des.
					<lb xml:id="p1z7"/>klasser z
					<lb xml:id="p1z8"/>zu
					<lb xml:id="p1z9"/>.
					<lb xml:id="p1z10"/>sclicken nit frun elbed list
					<lb xml:id="p1z11"/>
					<lb xml:id="p1z12"/>d in Berzige elb vir Lory
					<lb xml:id="p1z13"/>esaden angeseh sit und e
					<lb xml:id="p1z14"/>wes wegen der dsymat
