	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gracia et pax etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Qui tibi meas reddit literas, civis <placeName ref="l441">Scaphusanus</placeName><note xml:id="fn1" type="footnote" n="1">Wer damit gemeint ist, ließ sich nicht ermitteln.</note> est haud ignobili familia <lb xml:id="p1z2"/>ortus, cui animus est scribe officio fungi.</s>
					<s n="3" xml:lang="la">Tu itaque, quicquid consilii et auxilii in eum conferes, <lb xml:id="p1z3"/>in me collatum esse putato.</s>
					<s n="4" xml:lang="la">Ceterum quae nostra intersunt, imo Christi, ipse cum venero coram<note xml:id="fn2" type="footnote" n="2">Über einen Besuch <persName ref="p2810">Ritters</persName> bei <persName ref="p495">Bullinger</persName> ist nichts bekannt.</note>, intelliges.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z4"/>Valę.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ex <placeName ref="l441">Scaphusia</placeName>, 6. martii 1533.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z5"/><persName ref="p2810">Erasmus Ritter</persName>, <lb xml:id="p1z6"/>ex animo tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Et pietate et eruditione insi<lb xml:id="p2z2"/>gni <persName ref="p495">Heinricho Bullingero</persName>, apud <placeName ref="l587">Tigurum</placeName> <lb xml:id="p2z3"/>Christi evangelium adnunctianti, fratri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
