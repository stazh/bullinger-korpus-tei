	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quatuordecim iam dies sunt, reverende in <lb xml:id="p1z2"/>Christo pater, quod ad tuas voluntatis et <lb xml:id="p1z3"/>paternae benevolentiae plenas prolixe res<lb xml:id="p1z4"/>pondi, et puto redditas.</s>
					<s n="3" xml:lang="la">Summa fuit me <lb xml:id="p1z5"/>moerori tuo saepe cogitasse aliquam medicinam verbis <lb xml:id="p1z6"/>afferre, sed reverentia <lb xml:id="p1z7"/>erga te mea adhuc <lb xml:id="p1z8"/>impeditum, ne quid tale facere <lb xml:id="p1z9"/>auderem, <lb xml:id="p1z10"/>quod de tua fortitudine et constantia, quae <lb xml:id="p1z11"/>ab omnibus vestris mirum in modum praedicatur, <lb xml:id="p1z12"/>diffidere quasi viderer, si quid tale tentarem.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z13"/>Ante octo dies etiam ad d. <persName ref="p1884">Lavaterum</persName> scripsi.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z14"/>Interim nec a meis nec tuis quicquam literarum <lb xml:id="p1z15"/>accipio et dubito valde, quo loco res meorum <lb xml:id="p1z16"/>sint, an salva omnia; silentium certe tam <lb xml:id="p1z17"/>diuturnum mihi suspectum est.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Sed ego vos <lb xml:id="p1z18"/>vestraque omnia precibus meis deo commendo, <lb xml:id="p1z19"/>plura non possum.</s>
					<s n="7" xml:lang="la">Is pater noster est; itaque <lb xml:id="p1z20"/>de nobis nonnisi paterne statuat, necesse <lb xml:id="p1z21"/>est.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Hic plane nihil novi; mercatus <lb xml:id="p1z22"/>parvus, ex <placeName ref="l520">Valletelina</placeName> nemo adfuit.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z23"/>Legatus reipublicae unam pensionem solvit; nihil<lb xml:id="p1z24"/>dum actum; expectatur, quid apud <placeName ref="l862">Helvetios</placeName> <lb xml:id="p1z25"/>fiat.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ego sperabam nostris perusaderi posse, <lb xml:id="p1z26"/>ut ipsi separatim ab Helvetiis cum Gallo <lb xml:id="p1z27"/>transigerent; sed legatus contrarium <lb xml:id="p1z28"/>urget; sed, quid futurum sit, nescio, nisi <lb xml:id="p1z29"/>quod plerique spectent, quid <placeName ref="l862">Helvetii</placeName> fa<lb xml:id="p1z34"/>c<lb xml:id="p1z35"/>tu<lb xml:id="p1z36"/>r<lb xml:id="p1z38"/>i <lb xml:id="p1z45"/>s<lb xml:id="p1z46"/>i<lb xml:id="p1z51"/>n<lb xml:id="p1z52"/>t<lb xml:id="p1z54"/>.</s>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Mitto literas d. <persName>Friderici</persName>, ut intelligas <lb xml:id="p2z2"/>amicorum pro te sollicitudinem<note type="margin">dazu a.R.: "Non est, quod remittas."</note>.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale, reverende <lb xml:id="p2z3"/>in Christo pater.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Dominum rogo, ut, quod reliquum est <lb xml:id="p2z4"/>familię tuae, clementer conservet.</s>
					<s n="14" xml:lang="la" ana="salute">Salutem ex me dicito d. <persName ref="p1884">Lavatero</persName> et reliquis tuis o<lb xml:id="p2z5"/>mnibus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l98">Curię</placeName> 20. novembris anno 1564.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Tuus <persName ref="p8009">Fabricius</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Amplissimo viro d. <persName ref="p495">Heinrycho Bullingero</persName>, domino suo et i<lb xml:id="p2z6"/>n Christo patri multum <lb xml:id="p2z7"/>reverendo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
