	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto r[everentiae] t[uae] exemplar literarum, quibus lantgravius ostendit, quid de libro ducum <lb xml:id="p1z2"/><placeName ref="l749">Saxonię</placeName>, quo plures hęreses damnantur, sentiat.</s>
					<s n="3" xml:lang="la">Scriptę sunt anno praeterito, <lb xml:id="p1z3"/>nuper autem primum mihi allatę; putavi, si illas antea non videris, lectu no<lb xml:id="p1z4"/>n iniucundas fore.</s>
					<s n="4" xml:lang="la">Rumores bellici ubique intonant, adeo tamen per<lb xml:id="p1z5"/>plexi et incerti, ut prorsus nesciam, quid de illis sit statuendum.</s>
					<s n="5" xml:lang="la">Urbis <lb xml:id="p1z6"/>nostrę obsidionem expectamus; metuit sibi etiam <placeName ref="l619">Bavaria</placeName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Conventum <lb xml:id="p1z7"/>iam agunt <placeName ref="l231">Ingolstadii</placeName> confoederati <placeName ref="l2286">Landtspergenses</placeName>, qui nobis vel bellum vel <lb xml:id="p1z8"/>pacem dare possunt.</s>
					<s n="7" xml:lang="la">Milites nostri cogunt vel aliquantula pecunia numerata <lb xml:id="p1z9"/>ipsos spe futuri delectus suspendentes.</s>
					<s n="8" xml:lang="la">Nobiles vicini rogarunt magistratum <lb xml:id="p1z10"/>nostrum, ut ipsis liceat tempore belli in urbem migrare cum suis, id quod <lb xml:id="p1z11"/>concessum esse audio.</s>
					<s n="9" xml:lang="la">Quidam putant hunc bellicum apparatum, quicunque iam <lb xml:id="p1z12"/>sit, in <placeName ref="l1028">Trevirensem</placeName> moturum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Nuper convenerunt <placeName ref="l1028">Trevirensis</placeName> et <placeName ref="l267">Coloniensis</placeName> <lb xml:id="p1z13"/>episcopi <placeName ref="l976">Confluentię</placeName> cum legatis <placeName ref="l832">Galli</placeName> et <placeName ref="l875">Hispani</placeName>.</s>
					<s n="11" xml:lang="la">Iam conveniunt <placeName ref="l569">Wormacię</placeName> <lb xml:id="p1z14"/><placeName ref="l2477">Palatini</placeName>, <persName ref="p18935">Wolfgangus</persName> et <persName ref="p8060">Fridericus</persName> elector, tum <placeName ref="l572">Wirtenbergensis</placeName> et <lb xml:id="p1z15"/>landtgravius ac nonnulli alii.</s>
					<s n="12" xml:lang="la">Regem <placeName ref="l832">Gallię</placeName>... ra percussum et a con<lb xml:id="p1z16"/>versatione hominum semotum esse ante menses duos certo mihi retulerun<lb xml:id="p1z17"/>t, idque prioribus literis tibi significare oblitus eram, quibus etiam papam <persName ref="p18515">Inno<lb xml:id="p1z18"/>centium</persName> dixi, quem <persName ref="p20347">Pium II</persName>. vocari te iam dudum comperisse puto.</s>
					<s n="13" xml:lang="la">Vesperi <lb xml:id="p1z19"/>pręterito d. <persName ref="p2856">Geryon Seylerus</persName> a magistratu vocatus custo<lb xml:id="p1z20"/>dię mandatus est (causam ignoro), hodie vesperi rursus dimissus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell"><lb xml:id="p1z21"/>Vale optime.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">De statu tam urbis quam totius fere <placeName ref="l822">Germanię</placeName> confabulari <lb xml:id="p1z22"/>iucundius et facilius esset quam scribere.</s>
					<s n="16" xml:lang="la">Datum <placeName ref="l18">Augustę Vindelicorum</placeName> 7. <lb xml:id="p1z23"/>martii anno 1560.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z24"/>R[everentiae] t[uae]studiosissimus <persName ref="p3740">Georgius a <lb xml:id="p1z25"/>Stetten iunior</persName>.</s>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Venerando atque erudito domino <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, domino et amico suo colendo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
