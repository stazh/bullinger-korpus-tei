	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Vir clarissime, spero me brevi venturum ad te; <lb xml:id="p1z2"/>nunc non licuit, pergo enim recta <placeName ref="l496">Stutgardiam</placeName>.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Misi ad te literas, quę fuissent dandę d. <persName ref="p20923">Franci<lb xml:id="p1z4"/>sco Betto</persName>, nunc addo, si ille abest, dandas <lb xml:id="p1z5"/>esse domino <persName ref="p20924">Guarnero de Castiano</persName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">D. <persName>Viclamus <lb xml:id="p1z6"/>de Schartres</persName> <placeName ref="l832">Gallus</placeName>, vir magnus, omnibus numeris, <lb xml:id="p1z7"/>quem vehementer amo, fuit nuper <placeName ref="l512">Tubingae</placeName>; <lb xml:id="p1z8"/>ibi nostra amicitia fuit incohata.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Habes tu <lb xml:id="p1z9"/>quidem plurimos, qui te ament<note type="margin">a.R.: urspr. "amant" korr. "emant"!</note> et colant, sed <lb xml:id="p1z10"/>qui te magis amet et pluris faciat, puto esse neminem.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Quare debes vicissim amare.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute">Vale et salve, <lb xml:id="p1z12"/><persName ref="p495">Bullingheri</persName> optime; saluta mihi familiam, <lb xml:id="p1z13"/>scholam atque ecclesiam; sic enim tecum soleo.</s>
					<s n="7" xml:lang="la">Pater <lb xml:id="p1z14"/>celestis augeat omnibus nobis sua dona, spiritum <lb xml:id="p1z15"/>et fidem per Christum dominum nostrum.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/><placeName ref="l441">Schaffusiae</placeName> die 15. ianuarii 1564.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p3375">Vergerius</persName> frater.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z2"/>Clarissimo viro domino <lb xml:id="p2z3"/><persName ref="p495">Henrico Bullinghero</persName>, antistiti <lb xml:id="p2z4"/><placeName ref="l587">Tigurino</placeName>, fratri ho[no]rando.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note>[Brief von anderer Hand, nur Unterschrift autograph.]</note>
				</p>
			</div>
