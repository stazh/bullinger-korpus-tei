	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ex <placeName ref="l834">Italia</placeName> prorsus nihil audimus, nisi quod iam diebus aliquot est dictum, <lb xml:id="p1z2"/>ut et apud vos, papam se parare ad bellum inferendum duci <placeName ref="l1098">Florentino</placeName>; <lb xml:id="p1z3"/>quid, si milites conscribat sub hoc titulo alio ducendos?</s>
					<s n="3" xml:lang="la">In <placeName ref="l520">Valle Tellina</placeName> <lb xml:id="p1z4"/>solis ardoribus magna parte exusta est <placeName>Ceres</placeName> et foenum; idem fere dicunt <lb xml:id="p1z5"/>de <placeName ref="l834">Italia</placeName>.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Quod quaeris de historia sive fabula sacrificuli apud <lb xml:id="p1z6"/>nos, vidimus impressionem illam legimusque scripturam illam; falsa omnia sunt <lb xml:id="p1z7"/>et ementitia, ut breviter, quod est, dicam.</s>
					<s n="5" xml:lang="la">Nihil tale usquam actum in nostris <lb xml:id="p1z8"/><placeName>Foederibus</placeName> nec in vicinis regionibus.</s>
					<s n="6" xml:lang="la"><placeName>Tria Foedera</placeName> congregata ante hebdomadas <lb xml:id="p1z9"/>aliquot egerrime tulerunt hoc, quod <placeName>Caesareani</placeName> tam impudenter <lb xml:id="p1z10"/>talia spargant et imprimant de nobis aut nostratibus, et scripserunt, <lb xml:id="p1z11"/>credo, areopagitis apud Oenipontem conquestum de hoc.</s>
					<s n="7" xml:lang="la">Caetera apud <lb xml:id="p1z12"/>nos in <placeName>Foederibus</placeName> omnia in priore sunt statu.</s>
					<s n="8" xml:lang="la">Timueramus <persName>Helvecios</persName> <lb xml:id="p1z13"/>non satis concordare; sed cogimur sperare meliora omnibus istinc venienti<lb xml:id="p1z14"/>bus bona nunciantibus.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale in Domino, vir maxime.</s>
					<s n="10" xml:lang="la" ana="salute">Salutant(!<lb xml:id="p1z15"/>) tuam humanitatem <persName ref="p3196">Tschernerus</persName>; consul <persName>Ambrosius</persName> in <placeName ref="l520">Valle Tellina</placeName> nunc est; <lb xml:id="p1z16"/>salutat etiam pater <persName ref="p654">Comander</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Ex <placeName ref="l98">Curia</placeName>, die 7. Iulii 1556.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z17"/>Tuae humanitatis totus ut semper <persName ref="p8359">Philippus Gallicius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vere magno viro <lb xml:id="p2z2"/>D. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>bonis omnibus <lb xml:id="p2z4"/>colendissimo.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
