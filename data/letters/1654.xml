	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Redii rursus domum, vir clarissime, semper <lb xml:id="p1z2"/>colende frater; aliquandiu enim lavi <placeName ref="l515">Urdorffii</placeName> <lb xml:id="p1z3"/>reparande incolumitatis gratia.</s>
					<s n="3" xml:lang="la">Expecto iam, quid <lb xml:id="p1z4"/>profecerim, et num dominus benedicere velit; sunt <lb xml:id="p1z5"/>enim, quae incolumitatem meam affligunt.</s>
					<s n="4" xml:lang="la">Ea de <lb xml:id="p1z6"/>causa parum aut raro aliquandiu ad te scripsi.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Superioribus diebus in locum d. <persName ref="p8459">Otthonis</persName> successit <lb xml:id="p1z8"/>d. <persName ref="p1453">Wolphgangus Hallerus</persName> optime tibi notus, vir <lb xml:id="p1z9"/>iuvenis et maturus, pius et doctus.</s>
					<s n="6" xml:lang="la">Revaluit <lb xml:id="p1z10"/>d. <persName ref="p1283">Gessnerus</persName>, quem omnes moriturum omnino putaveramus; <lb xml:id="p1z11"/>sed ea difficultate liberavit nos dominus.</s>
					<s n="7" xml:lang="la">Alioque[<lb xml:id="p1z12"/>-i?] recte nunc omnes valemus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z13"/>Qui has tibi offert literas, <persName ref="p20922">Heinrychus Effrem</persName> <lb xml:id="p1z14"/><placeName ref="l267">Coloniensis</placeName>, diligentissime commendatione ut probus <lb xml:id="p1z15"/>et ingenuus, pius et doctus mihi commendatus est a d. <lb xml:id="p1z16"/><persName ref="p540">Calvino</persName>; sed quia conditionem aliquam profitendi <lb xml:id="p1z17"/>quaerit nec hic quicquam sperare potuit, <lb xml:id="p1z18"/>quod multi sint apud nos professores, ad vos ut<lb xml:id="p1z19"/>pote celebriorem scholam concedere statuit.</s>
					<s n="9" xml:lang="la">Oro <lb xml:id="p1z20"/>autem tuam humanitatem, ut ipsum bonis et <lb xml:id="p1z21"/>doctis commendes, si forte recipiatur et opera <lb xml:id="p1z22"/>sua, diligentia et studio prosit studiosis.</s>
					<s n="10" xml:lang="la">Veni<lb xml:id="p1z23"/>t <placeName ref="l167">Genevam</placeName> ex <placeName ref="l832">Gallia</placeName>; <placeName ref="l378">Lutetiae</placeName> enim aliquan<lb xml:id="p1z24"/>diu operam dedit literis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z25"/>De Caesare nihil auditur.</s>
					<s n="12" xml:lang="la">Metuo illum brevi <lb xml:id="p1z26"/>revicturum cum detrimento multorum.</s>
					<s n="13" xml:lang="la">Bellum <lb xml:id="p1z27"/>geritur et in bello de pace tractatur non in alium <lb xml:id="p1z28"/>finem, quam ut principum <placeName ref="l822">Germanorum</placeName> vires <lb xml:id="p1z29"/>infringantur, sumptus augeantur et Caesar interea parare <lb xml:id="p1z30"/>se possit; tum demum erit solidum bellum, <lb xml:id="p1z31"/>iam non est nisi dimidiatum bellum, <foreign xml:lang="de">grad <lb xml:id="p1z32"/>wie unsers kriegen zuͦ <placeName ref="l242">Capell</placeName>, da man krie<lb xml:id="p1z33"/>gen wolt, und denocht den finden nut thun; <lb xml:id="p1z34"/>gällt aber, do es inen rächt kamm, sy thatend <lb xml:id="p1z35"/>uns.</foreign></s>
					<s n="14" xml:lang="la">Dominus meliora concedat et liberet a <lb xml:id="p1z36"/>malo <placeName ref="l822">Germaniam</placeName>.</s>
					<s n="15" xml:lang="la">Valde solicitus sum.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Oremus dominum <lb xml:id="p1z37"/>pro benedictione sancta et pacifica.</s>
					<s n="17" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z38"/>aeternum, domine et frater colendissime.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z39"/><placeName ref="l587">Tiguri</placeName> 12. <lb xml:id="p1z40"/>iunii anno 155<lb xml:id="p1z41"/>2.</s>
					<s n="19" xml:lang="la" ana="salute">Saluta fratres.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z42"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p8418">Osvaldo <lb xml:id="p2z2"/>Myconio</persName>, <placeName ref="l28">Basiliensi</placeName> ecclesiae <lb xml:id="p2z3"/>fido pastori, domino et <lb xml:id="p2z4"/>fratri suo colendo et longe <lb xml:id="p2z5"/>charissimo.</s>
					<s n="22" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
