	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Post obsignatas illas meas, quas hic vides, mi <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z2"/>accipio, quibus ut respondeam, minime vacat.</s>
					<s n="3" xml:lang="la">Sed gratiam habeo, quantam po<lb xml:id="p1z3"/>ssum maximam, pro tuo illo libello, quem quamprimum leg<lb xml:id="p1z4"/>am, <lb xml:id="p1z5"/>ut sum profecto insignis scriptorum tuorum helio.</s>
					<s n="4" xml:lang="la">Utinam nonnihil <lb xml:id="p1z6"/>hocce permotus rex nonnihil de tyrannide sua remittat!</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Ad maturam resipiscentiam strenue exhortemur et liberemus <lb xml:id="p1z8"/>animas nostras, sive audiat sive non audiat mundus.</s>
					<s n="6" xml:lang="la">Dominum <lb xml:id="p1z9"/>precemur pro afflictissimis <placeName ref="l2481">Svevię</placeName> ecclesiis ex harum exulibus ministris, <lb xml:id="p1z10"/>praesertim cum propemodum in eadem cum illis navi simus, quodque illi <lb xml:id="p1z11"/>hodie, nos cras aut perendie nihilo clementius experiemur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Antithesim tuam impatienti desiderio expectamus.</s>
					<s n="8" xml:lang="la" ana="salute">Salutat <lb xml:id="p1z13"/>te cum <persName ref="p4868">Funclio</persName> mea domus.</s>
					<s n="9" xml:lang="la" ana="salute">Salveant tui omnes cum fratribus <lb xml:id="p1z14"/>symmystis tuis cęterisque amicis.</s>
					<s n="10" xml:lang="la" ana="farewell">Bene vale, mi anime.</s>
					<s n="11" xml:lang="la">14. novembris <lb xml:id="p1z15"/>1551.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">T[uus] <persName ref="p8055">A[mbrosius] Bl[aurerus]</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">H[einricho] Bullingero</persName>, <lb xml:id="p2z2"/>colendo simul et <lb xml:id="p2z3"/>charissimo fratri suo.</s>
					<s n="14" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
