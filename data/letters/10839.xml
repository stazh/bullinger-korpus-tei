					<s n="13" xml:lang="la">[Clariss]<lb xml:id="p2z22"/>imo<note xml:id="fnb" type="footnote" n="b"><hi>Textverlust, entstanden beim Öffnen des Briefes.</hi></note> viro d. <persName ref="p495">Henrycho [Bulling]<lb xml:id="p2z23"/>ero</persName><note xml:id="fnc" type="footnote" n="c"><hi>Textverlust, entstanden beim Öffnen des Briefes.</hi></note>, sanctae ecclesię <placeName ref="l587">[Turicensis]</placeName><note xml:id="fnd" type="footnote" n="d"><hi>Textverlust, entstanden beim Öffnen des Briefes.</hi></note> <lb xml:id="p2z24"/>episcopo, domini suo <lb xml:id="p2z25"/>colendo.</s>
				</p>
