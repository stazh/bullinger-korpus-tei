	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Credo tibi, observande p[ater] d[omine], redditas <lb xml:id="p1z2"/>fuisse a nostro <persName ref="p2054">Ulysse Martinengo</persName> literas meas.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Nunc quod raro scribam, non est, cur me ex<lb xml:id="p1z4"/>cusem; tu ipse nosti, in quo <lb xml:id="p1z5"/>s<lb xml:id="p1z6"/>tatu sint <lb xml:id="p1z7"/>res nostrę.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Tanta est pestis, deinde tantus metus, ut non omnes <lb xml:id="p1z8"/>audeant vel literas a quopiam accipere aut tangere.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Ergo est, cur non solum me <lb xml:id="p1z10"/>habeas excusatum, quoniam per me non sit, <lb xml:id="p1z11"/>quin subinde ad te scribam; sed est maxime, <lb xml:id="p1z12"/>cur debeas precibus ecclesię tuę hanc <lb xml:id="p1z13"/>nostram afflictissimam ecclesiam commendare.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Sunt mortui in hunc usque diem in hoc <lb xml:id="p1z15"/>exiguo oppido a paschate centum <lb xml:id="p1z16"/>et octo, et quotidie aliqui tolluntur.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/>Conciones cogimur habere extra <lb xml:id="p1z18"/>templum in ipso foro; cęnam etiam domini <lb xml:id="p1z19"/>celebravimus; sed quisque suum attulit <lb xml:id="p1z20"/>calicem; cęterum ex eodem vino <lb xml:id="p1z21"/>omnes biberunt.</s>
					<s n="8" xml:lang="la" ana="salute">Affecti fuimus omnes <lb xml:id="p1z22"/>maxima consolatione ac certo scimus <lb xml:id="p1z23"/>omnia cessura in salutem ecclesię.</s>
					<s n="9" xml:lang="la">Interim <lb xml:id="p1z24"/>non possumus fateri, quin tantam calamitatem <lb xml:id="p1z25"/>doleamus, lugeamus, deprecemur; <lb xml:id="p1z26"/>vere sumus hic omnes tanquam oves in <lb xml:id="p1z27"/>ma<pb/><lb xml:id="p2z1"/>nu lanii.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Agnoscimus tamen tum <lb xml:id="p2z2"/>dei patris erga nos misericordiam, <lb xml:id="p2z3"/>tum etiam iustissima eius iudicia.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z4"/>Sit nomen eius benedictum in secula!</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z5"/>Ex <placeName ref="l834">Italia</placeName> nihil audimus; in causa <lb xml:id="p2z6"/>est hęc nostra pestis, quę <lb xml:id="p2z7"/>facit, ut <lb xml:id="p2z8"/>nemo ad nos venire audeat; <lb xml:id="p2z9"/>proinde iam/etiam?</s>
					<s n="13" xml:lang="la">metuimus, ne fames tandem <lb xml:id="p2z10"/>tollat, quos non aufert pestilen<lb xml:id="p2z11"/>tia.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z12"/>Obsecro te, ut pro nobis <lb xml:id="p2z13"/>ores et preces ab ecclesia fiant.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z14"/>Ego et familia adhuc dei be<lb xml:id="p2z15"/>neficio valemus bene; servet autem <lb xml:id="p2z16"/>clementer pater.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Idem etiam vestri <lb xml:id="p2z17"/>misereatur; audivi enim istic quoque <lb xml:id="p2z18"/>non absimilem morbum grassari.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p2z19"/>Cupio autem salutari meo nomine honestissima<lb xml:id="p2z20"/>m uxorem tuam totamque familiam, deinde <lb xml:id="p2z21"/>fratres et d. d. <persName ref="p1283">Gesnerum</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z22"/>Servet te cumprimis deus optimus!</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z23"/><placeName ref="l93">Clavenna</placeName> 28. <lb xml:id="p2z24"/>aprilis 1564.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z25"/>Tuus <persName ref="p4037">Zanch<lb xml:id="p2z26"/>us</persName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p3z1"/>Heri vesperi scripseram literas.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p3z2"/>Hac nocte mortui sunt octo, et <lb xml:id="p3z3"/>quinque <lb xml:id="p3z4"/>novas domus invasit pest<lb xml:id="p3z7"/>is; d<lb xml:id="p3z8"/>omi<lb xml:id="p3z9"/>nus mis<lb xml:id="p3z10"/>ereatur!</s>
					<s n="23" xml:lang="la"><lb xml:id="p3z11"/>Claris<lb xml:id="p3z12"/>simo <pb/><lb xml:id="p4z1"/>viro et patri optimo d. <lb xml:id="p4z2"/><persName ref="p495">H[enrico] <lb xml:id="p4z3"/>Bullingero</persName>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p4z4"/><placeName ref="l587">Tigur<lb xml:id="p4z5"/>um</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>