	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil plane nunc, quod scribam, comperti aut <lb xml:id="p1z2"/>certi habeo, nisi quod valde miror interpretis <lb xml:id="p1z3"/>impudentiam.</s>
					<s n="3" xml:lang="la">Audet ille amplissimo magistratui <placeName ref="l98">Curiensi</placeName>, <lb xml:id="p1z4"/>ut ex tuis literis intelligo, proponere, quod <lb xml:id="p1z5"/>vanissimum est; nam praecipuus concionator et <lb xml:id="p1z6"/>pastor eius ecclesiae, d. <persName ref="p8109">Ioannes Conradus Ulmerus</persName> 28. <lb xml:id="p1z7"/>huius mensis, id est heri, in haec verba ad me <lb xml:id="p1z8"/>scribit: "<persName ref="p20341">Gallorum rex</persName> <placeName ref="l301">Lugduni</placeName> duo edicta edidit, <lb xml:id="p1z9"/>quibus ex regno pelluntur evangelii ministri, auditores <lb xml:id="p1z10"/>autem et discipuli ab omnibus publicis muneribus <lb xml:id="p1z11"/>removentur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Nihilominus tamen senatui nostro <placeName ref="l441">Schaffhusiano</placeName> <lb xml:id="p1z12"/>persuadere regius legatus voluit doctrinam evangelii <lb xml:id="p1z13"/>armis non peti, sed tantum quorundam seditiosorum <lb xml:id="p1z14"/>animos nephariosque conatus reprimi etc.</s>
					<s n="5" xml:lang="la">At nostri re<lb xml:id="p1z15"/>vocarunt militum signum, quod hactenus in regiis castris <lb xml:id="p1z16"/>fuit, interdixeruntque suis severissime, ne quis post<lb xml:id="p1z17"/>hac militet."</s>
					<s n="6" xml:lang="la">Haec ille.</s>
					<s n="7" xml:lang="de">So hüpschlich gipt der <lb xml:id="p1z18"/>tollmetsch eerenlüthen fuͤr, daß sich aber anders <lb xml:id="p1z19"/>hallt.</s>
					<s n="8" xml:lang="la">Cavendi ergo, ne narrationibus suis in nassam <lb xml:id="p1z20"/>pertrahant et decipiant isti homines.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Vidi quoque literas <lb xml:id="p1z21"/>scriptas <placeName ref="l15">Antverpia</placeName>, in quibus continebatur <persName>Andelotum</persName>, <lb xml:id="p1z22"/>dum ex <placeName ref="l2976">Brittannia</placeName> ad Condeum duceret 1500 <lb xml:id="p1z23"/>equites, a regiis circumventum ad flumen quoddam <lb xml:id="p1z24"/>trucidatis aliquot suorum cum maiore parte evasisse.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/>Rursus alias vidi, in quibus continebatur famam quidem <lb xml:id="p1z26"/>sparsam esse de <persName>Andeloti</persName> accepta clade, sed id nim<lb xml:id="p1z27"/>ium esse.</s>
					<s n="11" xml:lang="la">Ita nunc quoque spargitur, nildum certi <lb xml:id="p1z28"/>adfertur, pugnatum esse in <placeName ref="l640">Flandria</placeName> et <placeName ref="l875">Hispanos</placeName> <lb xml:id="p1z29"/>delevisse primam aciem Germanorum; mox tamen, cum <lb xml:id="p1z30"/>ventum ad triarios, acrius a Germanis esse pugnatum <lb xml:id="p1z31"/>et fusos fugatosque <placeName ref="l875">Hispanos</placeName> strage edita ma<lb xml:id="p1z32"/>xima.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Nihil hic affirmo; nam certi nil habeo <lb xml:id="p1z33"/>et de tota relatione dubito.</s>
					<s n="13" xml:lang="la">Brevi, quid verum <lb xml:id="p1z34"/>sit, audiemus.</s>
					<s n="14" xml:lang="la"><placeName ref="l441">Schaffhusia</placeName> et <placeName ref="l513">Ulma</placeName> nunciatur ali<lb xml:id="p1z35"/>quot <placeName ref="l822">Germanos</placeName> episcopos ut <placeName ref="l1725">Salisburgensem</placeName>, <placeName ref="l18">Augustanum</placeName>, <lb xml:id="p1z36"/><placeName>Frisingensem</placeName> etc. et alios quosdam per mercatores <lb xml:id="p1z37"/>comparasse talerorum quinquies centena millia, <lb xml:id="p1z38"/>cumque Augustani mercatores ad <persName>ducem Albanum</persName> ar<lb xml:id="p1z39"/>gentum hoc transferre voluerint, interceptum <lb xml:id="p1z40"/>esse ab Auraniis.</s>
					<s n="15" xml:lang="la">Sed sit fides apud lectorem.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z41"/>Apparent hic quaedam pestis initia.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Faciat dominus, quod <lb xml:id="p1z42"/>bonum est in oculis eius.</s>
					<s n="18" xml:lang="la" ana="farewell">Optime vale cum tua domo <lb xml:id="p1z43"/>et amicis nostris omnibus, symmystis, d. d.d.</s>
					<s n="19" xml:lang="la">consulibus etc.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z44"/><placeName ref="l587">Tiguri</placeName> 29. [octobris], postera Simonis et Iudę 1568.</s>
					<s n="21" xml:lang="la">Ocyssime.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z45"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <lb xml:id="p2z2"/><persName ref="p8016">Tobiae Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae fideli <lb xml:id="p2z4"/>ministro, domino <lb xml:id="p2z5"/>meo colendo et fratri <lb xml:id="p2z6"/>charissimo.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Chur.</s>
				</p>
			</div>
