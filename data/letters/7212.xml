	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S Literas vestras accepi, quitus me, quam
					<lb xml:id="p1z2"/>humanissime de vestris rebus vestraque
					<lb xml:id="p1z3"/>in me benevolentia certiores facitis
					<lb xml:id="p1z4"/>haec ego non lenis beneficii loco duco; nam
					<lb xml:id="p1z5"/>si vobis viris bons bene esse liberis audio
					<lb xml:id="p1z6"/>tu vito amoris in me vextri conmumoratu.
					<lb xml:id="p1z7"/>grata mihi iucunduque scupit accidit.
					<lb xml:id="p1z8"/>ex aula lugdinoque lititaque accepi scribumt,
					<lb xml:id="p1z9"/>qui veta scribere et possunt, si volunt.
					<lb xml:id="p1z10"/>nihil propsus nobis a civilibus molibus
					<lb xml:id="p1z11"/>imminere periculi, quod quidem praevideti a
					<lb xml:id="p1z12"/>possit, sugduvo scribitur narrasse
					<lb xml:id="p1z13"/>Hispanos ncrcatores Hispaniarum regitu scibintum
					<lb xml:id="p1z14"/>mutasse, quod ad Flandricam navigationibu
					<lb xml:id="p1z15"/>attinet classetuque, quav ad eam rem instructissimu
					<lb xml:id="p1z16"/>paravetac in africame etuisisse istaque, ut
					<lb xml:id="p1z17"/>spuito e opto huu Gallis tum etiam flaudis
					<lb xml:id="p1z18"/>cafilique Getmanis, quis cendum du.
					<pb/>
					<lb xml:id="p2z1"/>Vineli in maximo noti vetrari dicuntur
					<lb xml:id="p2z2"/>quod Turca dei cripitda Cypro setio cogitare
					<lb xml:id="p2z3"/>dicatur atque ad eam retu longe marimav
					<lb xml:id="p2z4"/>Clarssimu instruxisse et portum Caramaniae
					<lb xml:id="p2z5"/>qui insulae obiacer muniisse egati sabandem
					<lb xml:id="p2z6"/>Bernatisque in restitulionem trium praefecturarum
					<lb xml:id="p2z7"/>nunc sim occupati. Bene valute Solodur
					<lb xml:id="p2z8"/>28. augusti 1567.
					<lb xml:id="p2z9"/>Itf 1x .
					<lb xml:id="p2z10"/>ao.
					<lb xml:id="p2z11"/>Turs.
					<lb xml:id="p2z12"/>S.
					<lb xml:id="p2z13"/>ondor.
					<pb/>
					<lb xml:id="p4z1"/>Ampissimis ornatissimeque
					<lb xml:id="p4z2"/>varis dominis Henrico
					<lb xml:id="p4z3"/>Bullingero et Rodolpho
					<lb xml:id="p4z4"/>Gvaltiro ecclesiae Tigurinae
					<lb xml:id="p4z5"/>pastoribus vigilantissimi,
					<lb xml:id="p4z6"/><placeName ref="l587">iguri</placeName>.
				</p>
