	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Etsi tua virtus me satis allicere potuit ad amandum, fecerunt tamen hoc <lb xml:id="p1z3"/>literae tuae cumulatius, in quibus inerat effigies humanitatis expressae<note type="misc">proess.!</note> et <lb xml:id="p1z4"/>quaedam animi tui imago non muta, quam mihi de te saepe proposueram; <lb xml:id="p1z5"/>neque enim unquam dubitavi, si quando ad te scripsissem, accepturum me <lb xml:id="p1z6"/>literas <persName ref="p495">Bullingero</persName> dignas.</s>
					<s n="3" xml:lang="la">O me fortunatum, inquam, cui unis literulis <lb xml:id="p1z7"/>ad huiuscemodi hominis amicitiam viam munire deus ille noster, verae <lb xml:id="p1z8"/>sanctaeque necessitudinis author, dedit, in quibus literis <foreign xml:lang="el">ξυλοπρός.<lb xml:id="p1z9"/>.. ἔσχατα</foreign> persequeris: excusas, gratias agis idque de nihilo.</s>
					<s n="4" xml:lang="la" ana="salute"><lb xml:id="p1z10"/>Deinde, quae optanda sunt ad Christi, optimi pastoris gloriam, gregis <lb xml:id="p1z11"/>salutem, optas; mones postremo et hortaris me, quibus rebus mea <lb xml:id="p1z12"/>imbecillitas sane indiget.</s>
					<s n="5" xml:lang="la">Quare pro isto tuo erga me animo tibi, quas <lb xml:id="p1z13"/>possum, gratias ago, habeo et habiturus sum semper; nam me <lb xml:id="p1z14"/>relaturum esse polliceri non possum, habiturum certe possum.</s>
					<s n="6" xml:lang="la">Hoc tamen <lb xml:id="p1z15"/>tibi persuadeas velim, <persName ref="p495">Bullingere</persName> doctissime, qui te magis amet, colat <lb xml:id="p1z16"/>tuamque scribendi elegantiam (aliquot enim tuas lucubrationes degustare <lb xml:id="p1z17"/>coepi) magis admiretur, te inventurum neminem, quod quidem, si <lb xml:id="p1z18"/>libeat periculum facere, facile cognosces.</s>
					<s n="7" xml:lang="la">Deus, pater domini nostri <lb xml:id="p1z19"/>Iesu christi, te longaevum votorumque compotem servet ac <lb xml:id="p1z20"/>spiritu suo sacro te ad conservationem ecclesiae suae regat.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale, <lb xml:id="p1z21"/>optimum organum ac vas electum ad Christi gloriam, et <lb xml:id="p1z22"/><persName>Grasserum</persName> tuo aere esse patere.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Salutant te fratres d. <persName ref="p20110">Severinus</persName><note xml:id="fn1" type="footnote" n="1">Erzberger(?).</note>, <lb xml:id="p1z23"/>d. <persName ref="p20376">Battmannus</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l28">Basileae</placeName> 6. septembris 1563.</s>
					<s n="11" xml:lang="la">Raptim vesperi.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/>Tuae observantiae deditissimu<lb xml:id="p1z25"/>s <persName ref="p1312">Ionas Grasserus</persName> <placeName ref="l28">Basiliens<lb xml:id="p1z26"/>is</placeName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Reverendo viro d. magistro <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bullingero</persName>, theologo <lb xml:id="p2z3"/>syncerissimo, doctori <lb xml:id="p2z4"/>verbi divini apud <placeName ref="l587">Tigurum</placeName> <lb xml:id="p2z5"/>fidelissimo, domino meo <lb xml:id="p2z6"/>observando et fratri <lb xml:id="p2z7"/>in Christo <lb xml:id="p2z8"/>percharo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
