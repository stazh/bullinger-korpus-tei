	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Prensentium latori adsis tuo consilio, si uspiam fieri potest, dei atque meo nomine, <lb xml:id="p1z2"/>mi charissime frater.</s>
					<s n="3" xml:lang="la">Ego alias cum tota familia mediocriter valeo.</s>
					<s n="4" xml:lang="la">Indies et <lb xml:id="p1z3"/>avide expecto reliquum, quod superest in Apocalipsim.</s>
					<s n="5" xml:lang="la">Transmitte, mi <persName ref="p495">Bullingere</persName>, et <lb xml:id="p1z4"/>refice senem <persName ref="p8440">Gervasium</persName> tuum.</s>
					<s n="6" xml:lang="la">Ego tam infinitis pene negotiis obrutus ad nunctii festinum <lb xml:id="p1z6"/>abitum scribere plura non possum.</s>
					<s n="7" xml:lang="la">Saltem hunc, quem tuę charitati commendo, tanquam mea <lb xml:id="p1z8"/>viscera amplectere.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale, amice inconparabilis.</s>
					<s n="9" xml:lang="la" ana="salute">Saluta tuam ex me familiam<lb xml:id="p1z9"/>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z10"/>Date 1. maii anno 1556.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z11"/>Tuus <persName ref="p8440">Schuler</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <persName ref="p495">Heynricho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesie ministro pri<lb xml:id="p2z4"/>mario, domino fratri et <lb xml:id="p2z5"/>veteri amico charissimo.</s>
				</p>
			</div>
		</body>
	</text>
