	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Cave, quicquam...</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Ego mensibus iam aliquot ne <foreign xml:lang="el">γρῇ</foreign> quidem ab amicis <lb xml:id="p1z3"/>vel Augustanis vel aliis de novis istis <placeName ref="l822">Germanię</placeName> motibus, <lb xml:id="p1z4"/>quorsum spectant, id quod mirari mecum satis omnino nequeo; <lb xml:id="p1z5"/>puto autem tibi de iis certiora constare, quę ut mihi quoque <lb xml:id="p1z6"/>significes, maximopere te peto.</s>
					<s n="3" xml:lang="la">De nostris rebus multa <lb xml:id="p1z7"/>scriberem, quę magis atque magis in peius delabuntur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><persName>[<lb xml:id="p1z8"/>Witenbachus</persName>], qui [has reddet], omnem nostram [<lb xml:id="p1z9"/>de se] expectationem [fefellit; patrem] adeo non refert, <lb xml:id="p1z10"/>ut videri haudquaquam possit [germanus] illius [filiu]s.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Interdictum erat nostris [militia] graviore quam <lb xml:id="p1z12"/>hactenus pena, non tanta tamen, quanta apud vos, quę tamen <lb xml:id="p1z13"/>nemini paulo cordatiori iniqua videbatur; verum mox lex <lb xml:id="p1z14"/>illa authoribus [<persName>Witenbacho</persName>] et [conplicibus] <lb xml:id="p1z15"/>rursum [est abrogata].</s>
					<s n="6" xml:lang="la">Ego magno animi dolore supra modum <lb xml:id="p1z16"/>discrucior; caussas alias ex me cognosces.</s>
					<s n="7" xml:lang="la" ana="farewell">Bene vale, mi <lb xml:id="p1z17"/>venerande charissimeque <persName ref="p495">Bullingere</persName>.</s>
					<s n="8" xml:lang="la">27. iunii 1558.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z18"/>Saluta tuam domum cum fratribus et amicis omnibus, <lb xml:id="p1z19"/>quos rogo, ut senectutem meam sacrarum precationum <lb xml:id="p1z20"/>adminiculis fortiter sustentent.</s>
					<s n="10" xml:lang="la" ana="farewell">Iterum iterumque vale, <lb xml:id="p1z21"/>mi anime.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Si quid certi habes, communica, obsecro.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/>Quid enim monstri parturiant <placeName ref="l822">Germani</placeName> ipsi suę <lb xml:id="p1z23"/><placeName ref="l822">Germanię</placeName>, utinam non magno nostro damno experiantur.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z24"/>T[uus] <persName ref="p8055">Ambr[osius] Bl[aureru<lb xml:id="p1z25"/>s]</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/>d. et amico modis [omnibus] <lb xml:id="p2z4"/>observando longeque [charissimo].</s>
				</p>
			</div>
		</body>
	</text>
