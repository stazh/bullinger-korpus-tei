	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Im Brief ist die Rede davon, daß <persName ref="p8465" cert="high">Melchior [Wirz]</persName> seine Stelle einem anderen überlassen habe. Dies dürfte sich vermutlich auf seine Ablösung am Basler Pädagogium durch <persName ref="p8459" cert="high">Otto Werdmüller</persName> beziehen, von der <persName ref="p1365" cert="high">Grynäus</persName> um Mitte Juli 1538 berichtet (s. oben <ref target="file11189">Nr. 1146</ref>, 11f).</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Queritur <persName ref="p8465">Melchior</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p8465">Melchior Wirz</persName>.</note>, quod male frater<note xml:id="fn3" type="footnote" n="3">Nicht namentlich bekannt.</note> abdicatam esse se inconsulto conditionem ferat, <lb xml:id="p1z3"/>ac me rogat, ut hoc factum apud fratrem excusans se<note xml:id="fna" type="footnote" n="a"><hi>vor</hi> se <hi>gestrichenes</hi> illum.</note> cum illo reducas <lb xml:id="p1z4"/>in<note xml:id="fnb" type="footnote" n="b">in <hi>korrigiert aus</hi> ing.</note> gratiam.</s>
					<s n="3" xml:lang="la">Oro, ut facias diligenter.</s>
					<s n="4" xml:lang="la">Ingenue fecit iuvenis; conditionem, <lb xml:id="p1z5"/>qua egere ipse non videbatur, cessit ei, qui<note xml:id="fnc" type="footnote" n="c"><hi>vor</hi> qui <hi>gestrichenes</hi> quod.</note> opus valde habet.</s>
					<s n="5" xml:lang="la">Deinde <lb xml:id="p1z6"/>exercitationibus obrutus consulere studiis melius voluit.</s>
					<s n="6" xml:lang="la">Est enim discendo tempus hoc <lb xml:id="p1z7"/>oportunissimum, ac certe, si quam discere disciplinam certam vult, debet nunc <lb xml:id="p1z8"/>maxime animum applicare.</s>
					<s n="7" xml:lang="la">Haec ut apud fratrem omnia diligenter excuses, oro.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z9"/>Vale in domino.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z10"/><persName ref="p1365">Grynęus</persName> tuus in domino <lb xml:id="p1z11"/>frater.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Bullingero</persName> <lb xml:id="p2z2"/>suo, amico.</s>
					<s n="11" xml:lang="la">Tygurum.</s>
				</p>
			</div>
		</body>
	</text>
