	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Georg, grave zu Wüntenkbs
					<lb xml:id="p1z2"/>unnd zu Mumpelgart.
					<lb xml:id="p1z3"/>Unnsern gruß zever, wolgelerter, lieber
					<lb xml:id="p1z4"/>besonnder Wie habent ewer schryben
					<lb xml:id="p1z5"/>sampt den newen zytungen zu gnedigem danck
					<lb xml:id="p1z6"/>nnd
					<lb xml:id="p1z7"/>unnd gefallen entpfangen.
					<lb xml:id="p1z8"/>wissent itztzumb uch nichts nüwes zu schryben,
					<lb xml:id="p1z9"/>dann daß ir in kurtzem vernemmen werden.
					<lb xml:id="p1z10"/>wie sich der hauff in Bremen untzhär gehaltten
					<lb xml:id="p1z11"/>welhs itzt der fedder nit zu vertruwen. Aber
					<lb xml:id="p1z12"/>uchnächgends, wo ir dessen nit zevor bericht,
					<lb xml:id="p1z13"/>soll unverhaltten pleiben, Habent wir üch
					<lb xml:id="p1z14"/>dißmals nit leegen wollen. E hund uch hiemit
					<lb xml:id="p1z15"/>gott dem herrn bevelhend. Datum den unser he
					<lb xml:id="p1z16"/>Bruaen, Canno etc. 7.
					<lb xml:id="p1z17"/>Wyrttemberg ec.
					<lb xml:id="p1z18"/>E.
					<pb/>
					<lb xml:id="p2z1"/>Dem wolgelerten unserm lieben
					<lb xml:id="p2z2"/>sondern Henrich Bullingern
					<lb xml:id="p2z3"/>zu Zurich etc.
					<lb xml:id="p2z4"/>zu handn.
					<lb xml:id="p2z5"/>.
				</p>
			</div>
		</body>
	</text>
