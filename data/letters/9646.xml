	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Magnas tibi habeo gratias, quod ita cito et commode <lb xml:id="p1z2"/>ad consulem nostrum et ad alterum scripseris; nondum enim <lb xml:id="p1z3"/>facta est electio.</s>
					<s n="3" xml:lang="la">Hoc unum metuo, ne <persName ref="p396">Blasio</persName> obsit, quod <lb xml:id="p1z4"/>schola <placeName ref="l280">Lausanensis</placeName> tantum non videtur corruitura per ipsius <lb xml:id="p1z5"/>discessum; pauci enim sunt nostratium, qui illi substitui <lb xml:id="p1z6"/>possint, nec domini volunt, ut <placeName ref="l832">Galli</placeName>, inquietum hominum <lb xml:id="p1z7"/>genus, illic imperitent.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Fiat autem voluntas domini, dummodo <lb xml:id="p1z8"/>non seductor aliquis nobis obtrudatur!</s>
					<s n="5" xml:lang="la">Sunt enim, qui licet <lb xml:id="p1z9"/>toties admoniti, tamen etiam de <persName ref="p21248">Haslero</persName> adhuc mussitare audent.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Cum primum electio facta fuerit, ad te scribam de eventu.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>Iam nihil aliud possum; discedit enim nuncius vester hac <lb xml:id="p1z12"/>hora, qua mihi tuas exhibuit, neque dum ego adhuc potui aliis <lb xml:id="p1z13"/>suas literas exhibere.</s>
					<s n="8" xml:lang="la">Festinat ille, ut cras rursum <placeName ref="l587">Tiguri</placeName> sit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z14"/>Proinde bene vale; proxime plura scribam.</s>
					<s n="10" xml:lang="la"><placeName ref="l41">Bernae</placeName> 24. aprilis <lb xml:id="p1z15"/>mane.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><persName ref="p8018">I[o<lb xml:id="p1z16"/>hannes] Hall[erus</persName>] tuus.</s>
				</p>
				<p>
					<note type="address">[Ohne Adresse.]</note>
				</p>
			</div>
		</body>
	</text>
