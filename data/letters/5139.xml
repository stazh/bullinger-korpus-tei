					<s n="17" xml:lang="la"><pb/><lb xml:id="p4z1"/>Doctissimo viro dno <persName ref="p495">Heynricho <lb xml:id="p4z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p4z3"/><placeName ref="l587">Tigurinae</placeName> pastori fi[delis]<lb xml:id="p4z4"/>simo, amico pluri[mum] <lb xml:id="p4z5"/>observando.</s>
