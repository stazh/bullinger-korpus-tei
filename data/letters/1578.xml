	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Iampridem libenter remisissem scriptum; sed nuncciorum defectu intermissum <lb xml:id="p1z2"/>est.</s>
					<s n="2" xml:lang="la"><placeName ref="l303">Magdeburgen[se]</placeName> negotium iam vobis quam nobis compertius est; nam <lb xml:id="p1z3"/>nunccii eius reipublicae mihi significarunt se hinc ad vos abituros.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Miles presidi<lb xml:id="p1z4"/>arius adhuc in urbe agit; sed, ut audio, nihil molestie civitati infert et <persName ref="p18250">Mauritio</persName>.<lb xml:id="p1z5"/>.. est, qui ceteras quoque primarias suas urbes presidiis communit.</s>
					<s n="4" xml:lang="la">A <persName ref="p18250">Mauritio</persName> <lb xml:id="p1z6"/>et lantgravio quotidie certiora et crebriora nova perferuntur, quod militem <lb xml:id="p1z7"/>conscribant et in conducto habeant; sed in qu m plane usum, nescimus nos; tam<lb xml:id="p1z8"/>en liberatio capti lantgravii prefertur.</s>
					<s n="5" xml:lang="la">Hessiaci (ut puto) nuper abduxerunt c<lb xml:id="p1z9"/>omitem a Solms captivum, qu semper <persName ref="p18538">Cesaris</persName> castra sequutus est.</s>
					<s n="6" xml:lang="la">In <placeName ref="l882">Hungariam</placeName> <lb xml:id="p1z10"/>defendendam rex Romanus undique milites conscribit.</s>
					<s n="7" xml:lang="la"><persName ref="p18538">Cesar</persName> adhuc<note type="margin">a.R.: eher - hinc</note> <placeName ref="l232">Oenoponti</placeName> <lb xml:id="p1z11"/>heret, nec certi quid de eius abitu auditur.</s>
					<s n="8" xml:lang="la">In concilio permanent nostri episcopi<lb xml:id="p1z12"/>; sessio ad 15. ianuarii indicta servata non est, sed in 19. martii extracta, dum nostri <lb xml:id="p1z13"/>adveniant.</s>
					<s n="9" xml:lang="la" ana="salute">Salvus conductus, prout a <persName ref="p18250">Mauritianis</persName> petitus, omnibus confessionis <lb xml:id="p1z14"/><placeName ref="l18">Augustane</placeName> statibus permissus et datus est sub sigillo presidum concilii; puto nostros s<lb xml:id="p1z15"/>uos theologos hinc propediem <placeName ref="l1107">Tridentum</placeName> versus dimissuros, et quanquam nihil <lb xml:id="p1z16"/>recti aut iusti ex hoc concilio sperandum est, ante<note type="margin">a.R.: tamen?</note> non video nobis missionem <lb xml:id="p1z17"/>omittendam; nam in duobus comitiis nos eo adventuros recepimus.</s>
					<s n="10" xml:lang="la">Vos extra <lb xml:id="p1z18"/>teli iactum estis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Nihil puto nostros ibi profecturos, quam ut testentur se fuisse <lb xml:id="p1z19"/>paratos, si recte iustę et ęquę actionis facultas concessa et impetrata fuisset, <lb xml:id="p1z20"/>adeoque puto eos protestatione opposita domum redituros.</s>
					<s n="12" xml:lang="la">Vellem nostris et <persName>Saxonicis</persName> <lb xml:id="p1z21"/>plures alios adiunctos fuisse; nam quid quinque p... s inter tam multos?</s>
					<s n="13" xml:lang="la"><persName ref="p2095">Melanthon</persName>, <lb xml:id="p1z22"/><persName>Sarcerius</persName>, <persName>Alesius</persName> et Paceus <placeName ref="l361">Nurenberge</placeName> herere dicuntur, dum certiores facti fuerint <lb xml:id="p1z23"/>a precursoribus ducis.</s>
					<s n="14" xml:lang="la">In summa concilium iustissima quaeque promittit; s<lb xml:id="p1z24"/>ed ne... quidem discedent a...<note type="margin">a.R.: inditis[?]</note> domo adlatis.</s>
					<s n="15" xml:lang="la">Hec raptissime.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute">Commenda m<lb xml:id="p1z25"/>e generis et <persName ref="p8171">Bibliandro</persName>.</s>
					<s n="17" xml:lang="la">Optime valeas.</s>
					<s n="18" xml:lang="la"><placeName ref="l491">Argentina</placeName> 27. februarii anno 1552.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p8171">Bibliandri</persName> deliberatio super 1. concilii decreto vehementer doctis omnibus placet.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z27"/><persName ref="p8121">C<pb/><lb xml:id="p2z2"/>[hrist<lb xml:id="p2z3"/>opho<lb xml:id="p2z4"/>r<lb xml:id="p2z8"/>us] <lb xml:id="p2z10"/>M[ontius<lb xml:id="p2z11"/>]</persName><lb xml:id="p2z14"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse vor 883:]</note>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p3z1"/>Iuxta pio et erudito viro d. <lb xml:id="p3z2"/><persName ref="p495">Bullingero</persName>, amico observandissimo.</s>
					<s n="22" xml:lang="la"><lb xml:id="p3z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note type="author">[Darunter von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="23" xml:lang="la"><lb xml:id="p3z4"/>D. d. <persName ref="p8121">Christophori Montii</persName> <lb xml:id="p3z5"/>litera <lb xml:id="p3z6"/>1553.</s>
				</p>
