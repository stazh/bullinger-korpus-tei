	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Quandoquidem brevi volente deo ad vos veniam, <lb xml:id="p1z2"/>colendissime domine, ideo minus prolixe et rarius scribo nunc.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Hoc per praesentem nuntium tibi proponere volo, ut tuo responso <lb xml:id="p1z4"/>maxima me leves sollicitudine.</s>
					<s n="4" xml:lang="la">Retulit mihi dominus <persName ref="p8389">Imm Hag</persName> <lb xml:id="p1z5"/>hisce diebus convenisse <placeName ref="l300">Lucernae</placeName> adversarios nostros <placeName ref="l862">Helvetiorum</placeName> <lb xml:id="p1z6"/>Pagos constituisseque inter alia se, nisi iusiurandum <lb xml:id="p1z7"/>praestemus in confirmandis foederibus iuxta formam hactenus <lb xml:id="p1z8"/>usurpatam, velle ipsum etiam nobiscum dissolutum esse foedus.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Atque inter alia addidit sibi relatum esse <placeName ref="l587">Tigurinos</placeName> etiam in hoc <lb xml:id="p1z10"/>consensisse consilium.</s>
					<s n="6" xml:lang="la">Ego vero illud neutiquam credere, neque <lb xml:id="p1z11"/>ipse omnino pro certo confirmare; iussit, ut tibi scribam utriusque <lb xml:id="p1z12"/>nomine, ut, si quid hac in re certi habeas, nobis significes.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Crescit dolor meus in dies, de quo proxime scripsi, cum indies <lb xml:id="p1z14"/>magis magisque intelligam, quam exitiosa alatur inter nostras <lb xml:id="p1z15"/>urbes simultas, quam delectentur sua invicem igno<lb xml:id="p1z16"/>minia.</s>
					<s n="8" xml:lang="la">Quid per hunc nuncium domini mei <placeName ref="l587">Tigurini</placeName> scripseri<lb xml:id="p1z17"/>nt, nondum compertum habeo.</s>
					<s n="9" xml:lang="la">Monui <persName ref="p8389">Hagium</persName> et alios, <lb xml:id="p1z18"/>ut rescribant frequenter, quo magis alatur concordia.</s>
					<s n="10" xml:lang="la">Nescio, <lb xml:id="p1z19"/>quid perficiam; arbitror eos nec nunc rescribere.</s>
					<s n="11" xml:lang="la"><persName ref="p8012">Quaestori Hal<lb xml:id="p1z20"/>lero</persName> ut scribas, denuo flagito; is enim ut multum valet, ita <lb xml:id="p1z21"/>apparet etiam candidus esse.</s>
					<s n="12" xml:lang="la" ana="salute">D. <persName ref="p8417">Musculum</persName> et tuam familiam <lb xml:id="p1z22"/>omnem et fratres singulos diligenter ex me saluta.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z23"/>Raptim, <placeName ref="l41">Bernae</placeName> 17. Octobris 1548.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p8018">Ioannes Hallerus</persName> ex <lb xml:id="p1z25"/>animo tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo clarissimoque <lb xml:id="p2z2"/>viro D. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>suo charissimo domino et compatri<lb xml:id="p2z4"/>.</s>
					<s n="17" xml:lang="de"><lb xml:id="p2z5"/>M. <persName ref="p495">Heinrych Bullinger</persName> <lb xml:id="p2z6"/>zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
