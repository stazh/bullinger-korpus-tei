	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Fasciculum literarum in vase <persName ref="p8126">Oporini</persName> inclusum nondum <lb xml:id="p1z2"/>accepi; alias, quę ex <placeName ref="l749">Saxonia</placeName> fratres scriberent, tibi communicarem.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Quo in statu sint <placeName ref="l303">Magdeburgenses</placeName>, a <persName ref="p8171">Theodoro</persName> nostro petes.</s>
					<s n="4" xml:lang="la">Utinam <lb xml:id="p1z4"/>sint liberati prostratis hostibus impiis, ut nunquam revertantur.</s>
					<s n="5" xml:lang="la">Quid <placeName ref="l2510">Turca</placeName> <lb xml:id="p1z5"/>nunc agat, vos scire non dubito.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><placeName>Bresburgum</placeName> oppidum munitissimum cum <lb xml:id="p1z6"/>arce cępit et iam habet tutissimum aditum in <placeName ref="l850">Austriam</placeName> et <placeName ref="l619">Bavariam</placeName>, <lb xml:id="p1z7"/>sicque orbis christianus evertetur brevi ab hostibus fidei; imo hostes evangelii deus <lb xml:id="p1z8"/>per hanc virgam humiliabit, si digni sunt favore domini; nam non credo <lb xml:id="p1z9"/>illos ad dominum reversuros post multas plagas.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Episcopi duo, <persName ref="p7548">Moguntinus</persName> et <placeName ref="l1028">Treverensis</placeName>, excepti prandio ab episcopo <lb xml:id="p1z11"/><placeName ref="l491">Argentoratensi</placeName> et inter prandendum varia locuti sunt de concilio.</s>
					<s n="8" xml:lang="la"><placeName ref="l491">Argentoratensis</placeName> <lb xml:id="p1z12"/>dixit: "Quid, si papales nullam admittent ecclesiae reformationem, imo vix confir<lb xml:id="p1z13"/>mabunt Interim Caesareanum?"</s>
					<s n="9" xml:lang="la">Respondit <persName ref="p20531">Moguntinus</persName>: "Si non volunt ecclesiam re<lb xml:id="p1z14"/>formare, in alium ordinem tam preces quam cantica redigere, tunc ego mox <lb xml:id="p1z15"/>abiturus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Lutherani non veniant, quum a Caesare proscribantur passim <lb xml:id="p1z16"/>in <placeName ref="l822">Germania</placeName>.</s>
					<s n="11" xml:lang="la">Ante annum consultarunt de eiiciendis concionatoribus; sed illud <lb xml:id="p1z17"/>non sunt ausi exequi."</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l1028">Treverensis</placeName> interrupit sermonem dicens: "Frustra insu<lb xml:id="p1z18"/>mimus magnos sumptus, et nihil fiet.</s>
					<s n="13" xml:lang="la">Turca disputabit cum Caesare, <lb xml:id="p1z19"/>quem <persName>Gallus</persName> armavit" etc.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p4503">Ioachimus Camerarius</persName> electus a <persName ref="p18250">Mauricio</persName>, cui confessio fidei nova <lb xml:id="p1z21"/>data est a doctis omnibus in <placeName ref="l749">Saxonia</placeName>, <placeName ref="l825">Dania</placeName>, <placeName>Bressia</placeName> et ab aliis civitatibus maritimis <lb xml:id="p1z22"/>subscripta; nolunt enim se committere pontificiis.</s>
					<s n="15" xml:lang="la">De iis fusius <lb xml:id="p1z23"/>fortassis tu nosti.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z24"/>Scripsi tibi, ne mihi mittas Annotationes <persName ref="p8111">Petri Martyris</persName> in epistolam ad <lb xml:id="p1z25"/><placeName ref="l1855">Corinthios</placeName>, quum minoris possim<note type="margin">a.R.: possüm</note> <placeName ref="l28">Basileę</placeName> emere; verum si emisti, mitte <lb xml:id="p1z26"/>ac rescribe, quos tu velis libros a me emptos, et diligenter id curabo.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z27"/>Brevi indicem librorum mittam novorum.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z28"/>Qui fit, quod vestri noluerunt comitia <placeName ref="l21">Badena</placeName> adire?</s>
					<s n="19" xml:lang="la">Sitis fortes, <lb xml:id="p1z29"/>obsecro vos per Christum, ac ne detis bello occasionem; nam pseudoevan<lb xml:id="p1z30"/>gelicis non est fidendum, et populi mores ita corrupti sunt, ut nihil <lb xml:id="p1z32"/>sani sit sperandum ab illis.</s>
					<s n="20" xml:lang="la" ana="farewell">Vale.</s>
					<s n="21" xml:lang="la">7. octobris 1<lb xml:id="p1z33"/>551.</s>
					<s n="22" xml:lang="la">Resc<lb xml:id="p1z34"/>ribe.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Tuus <persName ref="p1278">Gastius</persName>.</s>
				</p>
				<p>
					<s n="24" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem eherwürdigen <lb xml:id="p2z2"/>herren meyster <persName ref="p495">Heinrich <lb xml:id="p2z3"/>Bullinger</persName>, lüt<lb xml:id="p2z4"/>priester zuͦ <placeName ref="l587">Zurich</placeName>, <lb xml:id="p2z5"/>mynem günstigen <lb xml:id="p2z6"/>herren zuͦ handen.</s>
					<s n="25" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
