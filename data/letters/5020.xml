	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nescio, quid iterum nostri habeant <lb xml:id="p1z2"/>de commotione confoederatorum contra <placeName ref="l646">Glaronenses</placeName>; inquieti <lb xml:id="p1z3"/>tamen sunt admodum et de rumoribus hisce dubitant, dum <lb xml:id="p1z4"/>vos nihil scribitis.</s>
					<s n="3" xml:lang="la">Scribunt ergo per hunc ad <lb xml:id="p1z5"/>vestros, ut invigilent et sine mora eis communicent, <lb xml:id="p1z6"/>si quid habent.</s>
					<s n="4" xml:lang="la">Fertur inter papistas <placeName ref="l646">Glaronenses</placeName> quendam <lb xml:id="p1z7"/>confossum esse a quodam evangelico et hinc commo<lb xml:id="p1z8"/>veri Cantones; certum tamen nescimus.</s>
					<s n="5" xml:lang="la">Admonent <lb xml:id="p1z9"/>me cordati viri, ut ad te scribam, ut vestris <lb xml:id="p1z10"/>author sis frequentius ad nos scribendi; cum enim <lb xml:id="p1z11"/>vos sitis propiores, vestrum quoque magis est in hoc in<lb xml:id="p1z12"/>vigilare.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Ex <placeName ref="l832">Gallia</placeName> nihildum aliud habemus, <lb xml:id="p1z15"/>quam quod proxime scripsi, nisi quod d. <persName ref="p3429">Viretus</persName> <lb xml:id="p1z16"/><placeName ref="l358">Nemansum</placeName> profectus et deductus est, ut illic concionetur; <lb xml:id="p1z17"/>est urbs illa in <placeName ref="l832">Gallia</placeName> Narbonensi non <lb xml:id="p1z18"/>procul a <placeName ref="l328">Monte Pessulano</placeName> sita.</s>
					<s n="7" xml:lang="la"><placeName ref="l301">Lugduni</placeName> aiunt <lb xml:id="p1z19"/>ab officio motum esse praesidem <placeName ref="l301">Lugdunensis</placeName> urbis <lb xml:id="p1z20"/>et agri, qui fuit summus evangelii hostis, et sub<lb xml:id="p1z21"/>stitutum cordatum et integrum virum, ita ut spes <lb xml:id="p1z22"/>sit successum verbi nunc quoque illic futurum maiorem.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z23"/>Quod scribam alias, nunc non habeo <lb xml:id="p1z24"/>et haec quoque festinantissime scripsi, cum modo per <lb xml:id="p1z25"/><persName ref="p8389">Hagium</persName> nostrum de profectione huius et de hisce <lb xml:id="p1z26"/>omnibus commonitus sim.</s>
					<s n="9" xml:lang="la" ana="salute">Is te salutat; salvi <lb xml:id="p1z27"/>sint vestri omnes.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Salutem dic fratri meo, cui nunc <lb xml:id="p1z28"/>non vacat scribere.</s>
					<s n="11" xml:lang="la"><placeName ref="l41">Bernae</placeName> 10. octobris, qua non <lb xml:id="p1z29"/>immemor sum fatalis diei, qua patrem <lb xml:id="p1z30"/>meum charissimum ante annos 30 postremo <lb xml:id="p1z31"/>vidi.</s>
					<s n="12" xml:lang="la">Dominus aliquando vindicet sanguinem ipsius <lb xml:id="p1z32"/>et aliorum, qui tum passi sunt.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><persName ref="p8018">I[ohannes] <lb xml:id="p1z33"/>Hall[erus</persName>], totus tuus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z34"/>Fac sciamus etiam, quid apud <placeName ref="l648">Rhoetos</placeName> fiat.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, domino suo <lb xml:id="p2z3"/>honorando et compatri <lb xml:id="p2z4"/>charissimo.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
