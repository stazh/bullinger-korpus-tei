	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi binas, frater charissime, nec respondi hactenus, <lb xml:id="p1z2"/>quod non habeam, quod scribam.</s>
					<s n="3" xml:lang="la">Expectamus <persName ref="p1227">Froschou<lb xml:id="p1z3"/>erum</persName>, quem intra octiduum venturum speramus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ex <lb xml:id="p1z4"/><placeName ref="l167">Geneva</placeName> scribunt fratres in <placeName ref="l832">Galliis</placeName> regnare <persName>Guysianos</persName>, <lb xml:id="p1z5"/>infensissimos Christi hostes, ideoque gliscere persequ tionem.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Ego vero scio potentem esse Christum, et qui <lb xml:id="p1z7"/>ex insperato suis subvenire possit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Aiunt regem <lb xml:id="p1z8"/>unctum 17. septembris.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Mirum sane est <placeName ref="l425">Romae</placeName> <lb xml:id="p1z9"/>haec fieri, quae fiunt; sed regnat ubique Christus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Vigilate, ne ille a Quadriis corrumpat auro <lb xml:id="p1z11"/>multorum pectora et obtineat aliquem ad suam <lb xml:id="p1z12"/>impietatem gradum, et rectissime facis, qui <lb xml:id="p1z13"/>te opponas pro viribus.</s>
					<s n="9" xml:lang="la">Vindemia facit etiam, <lb xml:id="p1z14"/>quo sim brevior.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Remitto literas Italicas.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Rece<lb xml:id="p1z15"/>pi literas clarissimi viri d. oratoris; apud illum <lb xml:id="p1z16"/>me excusabis, quod nihil respondeam; differam <lb xml:id="p1z17"/>in aliud tempus, quo accipiam literas ex <lb xml:id="p1z18"/><placeName ref="l157">Francfordia</placeName>; si enim aliquid accepero <lb xml:id="p1z19"/>ipso dignum, communicabo.</s>
					<s n="12" xml:lang="la" ana="salute">Salutabis illum offi<lb xml:id="p1z20"/>ciosissime, salutabis d. d. consules, <persName ref="p2095">Philippum</persName>, <lb xml:id="p1z21"/><persName ref="p6130">Pontisellam</persName> et omnes amicos nostros.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Salu<lb xml:id="p1z22"/>tant te et domum tuam mei omnes.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 22. <lb xml:id="p1z23"/>septembris 1559.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. d. <persName ref="p8009">Io<lb xml:id="p2z2"/>anni Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae fideli ministro, <lb xml:id="p2z4"/>domino et fratri suo c<lb xml:id="p2z5"/>olendo et dilecto.</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
