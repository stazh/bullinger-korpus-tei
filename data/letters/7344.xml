	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi tuas omnes, quas misisti.</s>
					<s n="3" xml:lang="la">Curavi etiam <lb xml:id="p1z2"/>illico <placeName ref="l167">Genevam</placeName> perferri eas, quae illuc pertinebant.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z3"/>Scripsi autem nudiustertius ad te et revocavi ea, quę <lb xml:id="p1z4"/>in prioribus scripseram de diaconorum <placeName ref="l167">Genevensium</placeName> e<lb xml:id="p1z5"/>t <placeName ref="l301">Lugdunensium</placeName> ad vos adventu.</s>
					<s n="5" xml:lang="la">Statuerant quidem <lb xml:id="p1z6"/>illuc proficisci; sed mutarunt hic consilium.</s>
					<s n="6" xml:lang="la">De eo proxime <lb xml:id="p1z7"/>prolixius scripsi; cum tamen nesciam, quando illas <lb xml:id="p1z8"/>accepturus sis, hic repetere volui.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Alias nunc nihil <lb xml:id="p1z9"/>habeo, nisi quod confirmatur rumor ille de conflictu <lb xml:id="p1z10"/>in <placeName>Gallia</placeName> facto.</s>
					<s n="8" xml:lang="la">Videtur hoc verisimile esse; nam constat <lb xml:id="p1z11"/>pontificios nostrorum pedes quam proxime esse secutos, et <lb xml:id="p1z12"/>forte de summa rei decernere voluerunt, antequam <persName>Ger<lb xml:id="p1z13"/>manicus</persName> equitatus cum nostris coniungeretur.</s>
					<s n="9" xml:lang="la">Sed <lb xml:id="p1z14"/>nihil certi adhuc affirmare possumus; silent mirum <lb xml:id="p1z15"/>in modum <placeName ref="l160">Friburgenses</placeName> et <placeName ref="l760">Solodorenses</placeName>, et hoc nostris <lb xml:id="p1z16"/>bonum videtur esse signum; si enim illi vicissent, in omnium <lb xml:id="p1z17"/>tectis hoc iam praedicaretur.</s>
					<s n="10" xml:lang="la">Aliqui putant rumorem hunc <lb xml:id="p1z18"/>inde ortum, quod tres tantum adversariorum turmae <lb xml:id="p1z19"/>in <placeName>Campania</placeName> sint a nostris profligatae; sed nihil hic certi <lb xml:id="p1z20"/>affirmo.</s>
					<s n="11" xml:lang="de">Man macht zum ersten den scharmutz, zuͦ <lb xml:id="p1z21"/>S. Dionys bschehen, auch so groß; was hernach nitt halb <lb xml:id="p1z22"/>so übel gangen.</s>
					<s n="12" xml:lang="de">Darumb laß ichs bliben, bis gwüßers kumpt.</s>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z23"/><persName ref="p8063">Steigerus</persName>, <persName ref="p7511">Gravenrietus</persName>, <persName ref="p21017">Manuel</persName>, amici denique et <lb xml:id="p1z24"/>fratres omnes vos salutant et precantur vobis annum faustissimum <lb xml:id="p1z25"/>et foelicissimum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l41">Bernae</placeName> 27. decembris <lb xml:id="p1z26"/>sub finem anni 67.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><persName ref="p8018">I[ohan<lb xml:id="p1z27"/>nes] H[allerus</persName>], <lb xml:id="p1z28"/>tuus semper.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori <lb xml:id="p2z4"/>fidelissimo, domino meo <lb xml:id="p2z5"/>colendo et compatri <lb xml:id="p2z6"/>charissimo.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><lb xml:id="p2z7"/>M. <persName ref="p495">Heinrych Bullinger</persName><lb xml:id="p2z8"/>n zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
