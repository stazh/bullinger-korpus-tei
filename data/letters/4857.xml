	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p714">Coel. Sec. Curio</persName> per C[hristum] I[esum] s[alutem] p[l<lb xml:id="p1z2"/>urimam] d[icit].</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Quum d. <persName ref="p8298">Martinus Borrhaus</persName> mihi quasdam suas <lb xml:id="p1z3"/>quaestiones ad te mittendas tradidisset,<note xml:id="fn1" type="footnote" n="1">Vgl. <bibl source="b286">HBBibl</bibl> III 110!</note> cogitavi <lb xml:id="p1z4"/>te eadem opera, quod iam aliquandiu non feci, meis <lb xml:id="p1z5"/>literis, venerande et charissime d. <persName ref="p495">Bullingere</persName>, sa<lb xml:id="p1z6"/>lutare simulque pauca de <persName ref="p8110">Velsio</persName>, qui ad vos <lb xml:id="p1z7"/>proficiscitur, adiungere.</s>
					<s n="3" xml:lang="la">Fuit hic aliquot <lb xml:id="p1z8"/>dies neque destitit publice privatimque petere atque <lb xml:id="p1z9"/>convitiis etiam postulare, ut sibi daretur facultas <lb xml:id="p1z10"/>sua dogmata, quae apodictica esse affirmat, <lb xml:id="p1z11"/>disputandi.</s>
					<s n="4" xml:lang="la">Ut privatim cum singulis <lb xml:id="p1z12"/>vel ministris vel doctoribus conferret, <lb xml:id="p1z13"/>libera facta est potestas; ut publice disputar<lb xml:id="p1z14"/>et, non est ei permissum, quod viderentur <lb xml:id="p1z15"/>eius dogmata ad statum ecclesiae turbandum <lb xml:id="p1z16"/>et evertendum spectare.</s>
					<s n="5" xml:lang="la">Doctor autem <persName ref="p8298">Borrhaus</persName> <lb xml:id="p1z17"/>hasce, quas tibi mitto, quaestiones proponere <lb xml:id="p1z18"/>voluit in ordinaria huius academiae disputatione <lb xml:id="p1z19"/>eique, si vellet, arguendi copiam facere; <lb xml:id="p1z20"/>sed vir superbus, ut vos ipsi experiemini, et <lb xml:id="p1z21"/>proprio sensu inflatus, ore et scripto acer<lb xml:id="p1z22"/>bissimo privatos et publicos omnes detestar<lb xml:id="p1z23"/>i ac diris devovere, indignus certe co spiritu, <lb xml:id="p1z24"/>quo se dicit ad haec molienda impelli.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Haec <lb xml:id="p1z25"/>pauca ad te, optime frater et domine, scribere <lb xml:id="p1z26"/>volui hac mittendarum quaestionum occasione <lb xml:id="p1z27"/><persName ref="p8298">Borrhai</persName>, qui te amat mecum et colit.</s>
					<s n="7" xml:lang="la">Ille <lb xml:id="p1z28"/>alter, quem bene dudum nosti, duabus sedet sellis nec<lb xml:id="p1z29"/>dum eum pudet.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Vale, mi optime frater, una cum <lb xml:id="p1z30"/>tuis omnibus, quos amanter ut salutes, oro.</s>
					<s n="9" xml:lang="la"><placeName ref="l28">Basi<lb xml:id="p1z31"/>leae</placeName>, 27. iunii 1561.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> a<lb xml:id="p2z4"/>ntistiti vigilantissimo, <lb xml:id="p2z5"/>fratri et domino meo charissimo <lb xml:id="p2z6"/>et honorando.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
