	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p1557">Blasius Hollerius</persName> domino suo domino <persName ref="p495">Henrico <lb xml:id="p1z2"/>Bulingero</persName>, ecclesię <placeName ref="l587">Tigurinę</placeName> ministro pervigili, <lb xml:id="p1z3"/>per Iesum Christum pacem et salutem optat.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z4"/>Cum sese, cui ad te literas damus itineri accingeret, vir christianissi<lb xml:id="p1z5"/>me, in album <placeName ref="l587">Tigurinę</placeName> classis introduceret, rogabam.</s>
					<s n="3" xml:lang="la">Qui, <lb xml:id="p1z6"/>tuam humanitatem, hac in re longe potiorem, literis consulerem, <lb xml:id="p1z7"/>persuasit.</s>
					<s n="4" xml:lang="la">Eam ob rem pro tuo animi candore obnixe precamur, <lb xml:id="p1z8"/>ut nos ab huius sęculi iniuria pro parte vendices; id si feceris, <lb xml:id="p1z9"/>haud me maiori beneficio poteris devincere.</s>
					<s n="5" xml:lang="la">Excidunt quotidie, <lb xml:id="p1z10"/>quę a teneris conquęsivi, eo quod non habeam, cui cum <lb xml:id="p1z11"/>conferre liceat; etenim, ut ingenue fatear, Grecę literaturę bona <lb xml:id="p1z12"/>pars in me desideratur, qua sine Latialis sermo, ut probe <lb xml:id="p1z13"/>nosti, undique cecutit ac vacillat, non secus atque arbor, altas <lb xml:id="p1z14"/>quę non iecerit radices.</s>
					<s n="6" xml:lang="la">Vide igitur, num placeat mihi in hoc <lb xml:id="p1z15"/>patrocinari.</s>
					<s n="7" xml:lang="la">Nam si censeas, qui velint me suis filiis <lb xml:id="p1z16"/>pręferre, coniungam <placeName ref="l832">Gallica</placeName>, si velint, Latinis et, cum <lb xml:id="p1z17"/>dabitur, Gręcis Latina.</s>
					<s n="8" xml:lang="la">Scio tamen pubis instituendę artificum <lb xml:id="p1z18"/>rempublicam non laborare inopia; sed sua non solum a <note type="misc">(unklar: asciscit?)</note></s>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/>Charitas, ne solum videamur nobis propitii, ut tua <lb xml:id="p1z20"/>monumenta, si bene memini, attestantur.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale, et quod parum <lb xml:id="p1z21"/>excogitarim, ne molestus essem tabellario, ignoscere.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z22"/><placeName ref="l339">Neocomi</placeName> sexto calendas augusti 1548.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/>Salutassem per literas virum nostrę profectionis<note xml:id="fn1" type="footnote" n="1">i. S. v. professionis.</note> <lb xml:id="p1z24"/>doctissimum dominum <persName ref="p1283">Conradum Gesnerum</persName> <placeName ref="l587">Tigurinum</placeName> medicum, si <lb xml:id="p1z25"/>per tempus licuisset.</s>
					<s n="13" xml:lang="la" ana="farewell">Iterum vale.</s>
					<s n="14" xml:lang="la">Christus te servet.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z26"/>Amen.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Tuus ex animo <persName ref="p1557">Blasius Hollerius</persName> profectionis <lb xml:id="p1z27"/>medices.</s>
					<s n="17" xml:lang="la">Raptim plus aequo.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo simul ac christianissimo <lb xml:id="p2z2"/>domino <persName ref="p495">Henrico Bulingero</persName>, <lb xml:id="p2z3"/>ecclesię <placeName ref="l587">Tigurine</placeName> ministro.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
