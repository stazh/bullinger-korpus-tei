	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Veniens ad vos <persName ref="p8018">frater</persName> iste vester et meus in Christo<note xml:id="fn1" type="footnote" n="1"><persName ref="p8018">Johannes Haller</persName>.</note> <lb xml:id="p1z3"/>necesse non erat, ut aliquid scriberem; poterat <lb xml:id="p1z4"/>enim ipsemet oretenus tue humanitati animum <lb xml:id="p1z5"/>meum erga te exprimere, sed ex abundantia <lb xml:id="p1z6"/>cordis coactus sum tibi tum occupatissimo <lb xml:id="p1z7"/>tum doctissimo meis illiteratis literis obstrepere <lb xml:id="p1z8"/>notumque facere, quatenus te plurimum in Christo <lb xml:id="p1z9"/>diligo, quod credere mihi debes vel experientiam <lb xml:id="p1z10"/>facere.</s>
					<s n="3" xml:lang="la">Rogoque te, ut, si me diligis, quam citius <lb xml:id="p1z11"/>remittas ad nos fratrem istum; est enim modestia, <lb xml:id="p1z12"/>virtus, doctrina et pietas sua talis, ut et <lb xml:id="p1z13"/>inimici (si aliqui sunt) cogantur eum diligere.</s>
					<s n="4" xml:lang="la" ana="salute">Erimus <lb xml:id="p1z14"/>enim ut fratres in Christo coniunctissimi, dignaberisque <lb xml:id="p1z15"/>nomi<lb xml:id="p1z16"/>ne meo salutare fratres omnes in Christo, praecipue <lb xml:id="p1z17"/><persName ref="p8127">Pellicanum</persName>, mei memor in tuis orationibus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell"><lb xml:id="p1z18"/>Vale.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ex <placeName ref="l18">Augusta</placeName>, 4. ianuarii 1546.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z19"/>T[ib<lb xml:id="p1z20"/>i] d[editus]</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><persName ref="p2336">Bernardinus Ochi<lb xml:id="p1z21"/>nus</persName> <placeName ref="l462">Senensis</placeName></s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo domino <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bullingero</persName>, theologo osservandissimo.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName><note xml:id="fn2" type="footnote" n="2"><persName ref="p8018">Johannes Haller</persName> nahm diesen Brief bei seiner Rückreise nach <placeName ref="l587">Zürich</placeName> mit.</note>.</s>
				</p>
			</div>
		</body>
