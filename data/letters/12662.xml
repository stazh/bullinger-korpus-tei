	<text xml:lang="de">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Etsi viri optimi verbi contionatores <placeName ref="l587">Tigurini</placeName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8130">Lorenz Meyer (Agricola)</persName>, <persName ref="p2812">(Hans) Thoman Ruman</persName> und <persName ref="p6544">Rudolf Schwyzer d.Ä.</persName> s. <ref target="file12659">Nr. 2612</ref>, Anm. 3.</note> omnia, quę hic geruntur, <lb xml:id="p1z2"/>verbis melius consequi quam ego scribere possint, <lb xml:id="p1z3"/>et viva sint epistola,<note xml:id="fn2" type="footnote" n="2">Weil sie zu dieser Zeit nach <placeName ref="l587">Zürich</placeName> zurückkehrten, um ihren Hausrat und ihre Familie nach <placeName ref="l18">Augsburg</placeName> zu holen; s. <ref target="file12659">Nr. 2612</ref>,201-203.</note> tamen charitas me non sinit ad te <lb xml:id="p1z4"/>nonnihil non strepere.</s>
					<s n="3" xml:lang="la">Viri illi nobis hic gratissimi erunt, <lb xml:id="p1z5"/>modo autem ea lege dimissi, ut una cum uxoribus et liberis <lb xml:id="p1z6"/>ante increbescentem hiemem redeant.<note xml:id="fn3" type="footnote" n="3"><persName ref="p8130">Meyer</persName> und <persName ref="p6544">Schwyzer</persName> gelangten erst am 2. November wieder nach <placeName ref="l18">Augsburg</placeName>, doch ohne ihre Frauen (s. <ref target="file12710">Nr. 2663</ref>, Anm. 7), und <persName ref="p2812">Ruman</persName> erst etwa vierzehn Tage später mit seiner Frau; s. <ref target="file12724">Nr. 2677</ref>, Anm. 44.</note></s>
					<s n="4" xml:lang="la">Sumptus itineris hic <lb xml:id="p1z7"/>acceperunt,<note xml:id="fn4" type="footnote" n="4">Vgl. <ref target="file12659">Nr. 2612</ref>,197-200.</note> satis profecto tenues, sed quod ipsis defuerit, <lb xml:id="p1z8"/>hic supplebitur.</s>
					<s n="5" xml:lang="la">Dilectissimus frater <persName ref="p8018">Hallerus</persName>, <persName ref="p1860">Michael <lb xml:id="p1z9"/>Cellarius</persName>, <persName ref="p2336">Bernhardinus Ochinus</persName> atque ego illos fraterne <lb xml:id="p1z10"/>fovebimus.</s>
					<s n="6" xml:lang="la"><persName ref="p8417">Musculus</persName> magistrum <persName ref="p8130">Laurentium</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p8130">Lorenz Meyer</persName>.</note>, doctiorem ex <lb xml:id="p1z11"/>tribus, libenter hinc ablegaret.<note xml:id="fn6" type="footnote" n="6">Vgl. <ref target="file12660">Nr. 2613</ref>,50f.</note></s>
					<s n="7" xml:lang="la">Nos autem secus sentimus <lb xml:id="p1z12"/>dabimusque operam, ut in urbe, etiam contra odium quorundam, <lb xml:id="p1z13"/>si fieri poterit, maneat.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="8" xml:lang="la"><placeName ref="l28">Basilienses</placeName> miserunt nobis <persName ref="p5341">Sebastianum <lb xml:id="p1z14"/>Lepusculum</persName> et <persName ref="p5075">Hieronimum Guntium</persName>,<note xml:id="fn7" type="footnote" n="7">Zum Schicksal <persName ref="p5341">Lepusculus</persName>' und <persName ref="p5075">Gunz</persName>' s. <ref target="file12659">Nr. 2612</ref>, Anm. 150 und Anm. 151.</note> viros satis doctos.</s>
					<s n="9" xml:lang="la"><persName ref="p5075">Guntius</persName> <lb xml:id="p1z15"/>ingenio nostro propius accedit.</s>
					<s n="10" xml:lang="la">Videtur enim et moribus et eru<lb xml:id="p1z16"/>ditione alteri preire, quamvis alter mihi operosius per d.<note xml:id="fna" type="footnote" n="a"><hi>Über der Zeile nachgetragen.</hi></note> <persName ref="p8418">Myconium</persName> <lb xml:id="p1z17"/>literis<note xml:id="fn8" type="footnote" n="8">Unbekannter Brief.</note> commendatus sit.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="11" xml:lang="de"><lb xml:id="p1z18"/>Unnsere krigssachen steen noch im alten stannd.<note xml:id="fn9" type="footnote" n="9">Hinsichtlich der von <persName ref="p8354">Frölich</persName> erst einen Tag zuvor mitgeteilten Nachrichten in <ref target="file12660">Nr. 2613</ref>,27-47.</note></s>
					<s n="12" xml:lang="de">Bede <lb xml:id="p1z19"/>huffen liegen nahen beisamen, dringen sich umb die <lb xml:id="p1z20"/>vortail<note xml:id="fn10" type="footnote" ana="lex" n="10">vorteilhafte Stellung.</note>, darein sich der fynndt fur unnd fur<note xml:id="fn11" type="footnote" n="11">fur und fur: immer wieder.</note> legt, unnd <lb xml:id="p1z21"/>will nit schlahen, wiewol es nit möglich, das die keldti <lb xml:id="p1z22"/>das veldtgelager lanng zulassen werde.<note xml:id="fn12" type="footnote" n="12">Vgl. schon <ref target="file12660">Nr. 2613</ref>,46f.</note></s>
					<s n="13" xml:lang="de">Welcher tail <lb xml:id="p1z23"/>dann vor dem anndern weicht, der muͦß gefahre bestohn.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="14" xml:lang="de"><lb xml:id="p1z24"/>Der bunnde, auch <placeName ref="l2448">5 ort</placeName><note xml:id="fn13" type="footnote" n="13">die <placeName ref="l2448">Fünf (katholischen) Orten</placeName> der <placeName ref="l862">Eidgenossenschaft</placeName>.</note> halber, hab ich trewlich <lb xml:id="p1z25"/>gemanet.<note xml:id="fn14" type="footnote" n="14">Siehe dazu <ref target="file12660">Nr. 2613</ref>,16-19.</note></s>
					<s n="15" xml:lang="de">Will mich versehen<note xml:id="fn15" type="footnote" n="15">Will mich versehen: Ich möchte hoffen.</note>, man werde darzu thun, was <lb xml:id="p1z26"/>sich gehöret.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="16" xml:lang="de"><lb xml:id="p1z27"/>Eurn herrn, <placeName ref="l41">Bern</placeName>, <placeName ref="l28">Basel</placeName> und <lb xml:id="p1z28"/><placeName ref="l441">Schaffhusen</placeName> ist von den reichstennden geschrieben,<note xml:id="fn16" type="footnote" n="16">Gemeint ist der an diese Orte adressierte Brief der Fürsten und Stände vom 26. September; s. <ref target="file12652">Nr. 2605</ref>, Anm. 11.</note> wie inligende <lb xml:id="p1z29"/>copi ußweist.</s>
					<s n="17" xml:lang="de">Daran es alles gelegen, unnd kein <pb type="edition" next="108"/> besser <lb xml:id="p1z30"/>rate ditsmals ist.</s>
					<s n="18" xml:lang="de">Dann<note xml:id="fn17" type="footnote" ana="lex" n="17">Denn.</note> da sich die sach verzeucht<note xml:id="fn18" type="footnote" n="18">in die Länge zieht.</note> unnd <lb xml:id="p1z31"/>der fynnd nit an anndern ortten angriffen, wurdt er unns <lb xml:id="p1z32"/>des ubermessigen cosstens halb miehe<note xml:id="fn19" type="footnote" ana="lex" n="19">Mühe, Schwierigkeiten.</note> machen (dann ob<note xml:id="fn20" type="footnote" ana="lex" n="20">über, etwa.</note> 20 <lb xml:id="p1z33"/>mal hundert taussent guldin synnd schon dahin!)<note xml:id="fnb" type="footnote" n="b"><hi>Klammern ergänzt.</hi></note>,<note xml:id="fn21" type="footnote" n="21">Vgl. schon <persName ref="p8354">Frölichs</persName> Mitteilung vom 20. September in <bibl source="b20">HBBW XVII</bibl> 485,24f.</note> wiewol <lb xml:id="p1z34"/>wir yetzt wider gellt machen.<note xml:id="fn22" type="footnote" n="22">Zum einen bezieht sich <persName ref="p8354">Frölich</persName> hier auf das geplante Darlehen an die <placeName ref="l1202">Schmalkaldener</placeName>; s. dazu <ref target="file12659">Nr. 2612</ref>, Anm. 73. Zum anderen sind Geldforderungen der <placeName ref="l1202">Schmalkaldener</placeName> an die <persName ref="p20329">Fugger</persName> und <persName ref="p18910">Welser</persName> gemeint. Aus beschlagnahmten Briefen ging hervor, dass diese dem <persName ref="p18538">Kaiser</persName> 7 Tonnen Gold geliehen hatten, eine Summe, die die <placeName ref="l1202">Schmalkaldener</placeName> nun auch verlangten; s. <bibl source="b20">HBBW XVII</bibl> 243, Anm. 42; bes. 258,106-114.</note></s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="19" xml:lang="de">Wolan, die sach ist des <lb xml:id="p1z35"/>herrn!</s>
					<s n="20" xml:lang="de">Der soll billich<note xml:id="fn23" type="footnote" ana="lex" n="23">zu Recht.</note> meisster unnd hertzog darinn sein.</s>
					<s n="21" xml:lang="de"><lb xml:id="p1z36"/>Bißhere hat es nit annderst sein wollen.</s>
					<s n="22" xml:lang="de">Wir haben für<lb xml:id="p1z37"/>war lewt!<note xml:id="fn24" type="footnote" n="24">Kriegsvolk; vgl. <ref target="file12659">Nr. 2612</ref>,81-84. - Hier könnten bes. die Hauptleute gemeint sein; vgl. <ref target="file12660">Nr. 2613</ref>,13.</note></s>
					<s n="23" xml:lang="de">Wann man sie inn gantzer teütscher nation uß<lb xml:id="p1z38"/>erlesen sollt, wisst ichs nit zu verbessern.</s>
					<s n="24" xml:lang="de">Denen unnd <lb xml:id="p1z39"/>gott dem almechtigen zuvor thu ich diesen schweren hanndel <lb xml:id="p1z40"/>billich befelhen.</s>
				</p>
			</div>
			<div xml:id="div7" corresp="regest7">
				<p>
					<s n="25" xml:lang="de" ana="salute"><lb xml:id="p1z41"/>Gruesst mir die herrn burgermaister<note xml:id="fn25" type="footnote" n="25"><persName ref="p1888">Hans Rudolf Lavater</persName> und <persName ref="p1419">Johannes Haab</persName>.</note>, <persName ref="p8339">statschriber</persName><note xml:id="fn26" type="footnote" n="26"><persName ref="p8339">Hans Escher vom Luchs</persName>.</note>, <foreign xml:lang="la">d. <persName ref="p8011">Rodol<lb xml:id="p1z42"/>phum</persName><note xml:id="fn27" type="footnote" n="27"><persName ref="p8011">Rudolf Gwalther</persName>.</note>, <persName ref="p1283">Gessnerum</persName>, <persName ref="p8171">Bibliandrum</persName>, <persName ref="p1214">Frisium</persName><note xml:id="fn28" type="footnote" n="28"><persName ref="p1214">Johannes Fries</persName>.</note>, <persName ref="p8127">Pellicanum</persName>, <persName ref="p3988">Gvolfium</persName><note xml:id="fn29" type="footnote" n="29"><persName ref="p3988">Johannes Wolf</persName>.</note> <lb xml:id="p1z43"/>atque totum musarum cęlum.<note xml:id="fn30" type="footnote" ana="bio" n="30">Gemeint sind die <placeName ref="l587">Zürcher</placeName> Gelehrten; vgl. ähnliche Ausdrücke <persName ref="p8354">Frölichs</persName> in <bibl source="b20">HBBW XVII</bibl> 70,97 mit Anm. 74; 305,37.</note></foreign></s>
					<s n="26" xml:lang="la">8. octobris 1546.</s>
				</p>
				<p>
					<note type="signature">[Ohne Unterschrift.]</note>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="27" xml:lang="de"><pb/><lb xml:id="p2z1"/>Herren <persName ref="p495">Hennrichen Bullinger</persName>, vorgeern<note xml:id="fn31" type="footnote" ana="lex" n="31">Antistes.</note> <lb xml:id="p2z2"/>der christlichen gemeind.</s>
					<s n="28" xml:lang="de"><placeName ref="l587">Zurch</placeName>.<note xml:id="fn32" type="footnote" n="32">Vorliegender Brief wurde, wie auch die Briefe <ref target="file12659">Nr. 2612</ref>, <ref target="file12660">Nr. 2613</ref> und <ref target="file12664">Nr. 2617</ref>, den drei nach <placeName ref="l587">Zürich</placeName> zurückreisenden <placeName ref="l587">Zürcher</placeName> Pfarrern anvertraut; s. oben Z. 1-3.</note></s>
