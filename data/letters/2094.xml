			<zone xml:id="p2z5-0" points="1197,1608 1384,1570 1499,1597 1592,1582 1592,1512 1542,1499 1475,1504 1391,1542 1347,1519 1304,1526 1246,1495 1198,1514">1204,1572 1230,1570 1256,1568 1282,1568 1308,1568 1334,1568 1360,1568 1386,1568 1412,1568 1438,1568 1464,1568 1490,1568 1516,1568 1542,1568 1568,1568 1595,1571</zone>
