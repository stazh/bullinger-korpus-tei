	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Vergerius nuper ad me scripsit, si pridem ad te misissem sarcinas quasdam seu vasa, <lb xml:id="p1z2"/>ut ea postmodum ad me, ubi ego id a te peterem, advehenda curares.</s>
					<s n="2" xml:lang="la">Hinc fac<lb xml:id="p1z3"/>tum est, ut hoc nunc literarum ad te dederim, quibus te rogatum velim, ut, si<lb xml:id="p1z4"/>mulatque id tuo commodo fieri poterit, efficias simulque tuis ad me literis indices, <lb xml:id="p1z5"/>quantum pro vectura solvendum erit.</s>
					<s n="3" xml:lang="la">Facies enim mihi rem gratissimam, et si quid <lb xml:id="p1z6"/>est, in quo tibi vicissim commodare possim, id ubi intellexero, quam libentis<lb xml:id="p1z7"/>sime praestabo.</s>
					<s n="4" xml:lang="la">Quod aliena manu ad te scripsi, non alia sane causa factum <lb xml:id="p1z8"/>est, quam quod nulla in me Latine scribendi facultas est.</s>
					<s n="5" xml:lang="la" ana="farewell">Bene vale in domino.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/><placeName ref="l167">Genevae</placeName> pridie calendas martias etc.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Tuus in domino <persName ref="p8056">Galeatius Carac<pb/><lb xml:id="p4z1"/>iol<lb xml:id="p4z2"/>us</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
