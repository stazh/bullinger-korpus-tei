				<p>
					<lb xml:id="p1z1"/>S. D. Reverende et Clarissime vir, domin
					<lb xml:id="p1z2"/>amice patris loco iolende. Laetor mis
					<lb xml:id="p1z3"/>Ionestam et diudesideratam occasionem sri,
					<lb xml:id="p1z4"/>ad reverendam dignitatem tuam data
					<lb xml:id="p1z5"/>esse. Etsi enim mihi nunquam defuit voluntas
					<lb xml:id="p1z6"/>per literas colloquendi, tamen fateor nosi
					<lb xml:id="p1z7"/>had tenuo defucisse argumentum tua cognitione
					<lb xml:id="p1z8"/>Itaque r Taus me excusatum habebit et
					<lb xml:id="p1z9"/>nihil de sua paterna erga me benevolentia prorus
					<lb xml:id="p1z10"/>diuturnitatem silentii imninuet. 4 pue
					<lb xml:id="p1z11"/>sa ei n niis
					<lb xml:id="p1z12"/>rumpe pripter ellentem doctrinam e intus
					<lb xml:id="p1z13"/>ac plurima in ecclesiam Christi merita mista
					<lb xml:id="p1z14"/>dornatuar ed resrim Gaisi ntur
					<lb xml:id="p1z15"/>nunc ad R
					<lb xml:id="p1z16"/>D t sarlen zerest heriftium,
					<lb xml:id="p1z17"/>e ere i efis nis,
					<lb xml:id="p1z18"/>e ede fali pt e alilirs,
					<lb xml:id="p1z19"/>der phialanet fim dorti
					<lb xml:id="p1z20"/>ie er astiam neli efsic nu,
					<lb xml:id="p1z21"/>e eleaner reier stia,
					<lb xml:id="p1z22"/>sancta dicendo et sancta faciendo ornas
					<lb xml:id="p1z23"/>Prore, ut facileureum ad vrs aditum Zaberus
					<lb xml:id="p1z24"/>petivit a me, ut mea vel commendationem
					<lb xml:id="p1z25"/>lieata i i uiu aritus
					<lb xml:id="p1z26"/>liligenem eli ili st cristus
					<lb xml:id="p1z27"/>lar t fili a aius,
					<lb xml:id="p1z28"/>e libentino gratificatus sum, quia alegnot
					<lb xml:id="p1z29"/>gietatem et mores eium grobave. gi
					<lb xml:id="p1z30"/>enim in utraque frademia deptira et Herder
					<lb xml:id="p1z31"/>e es e er riti e ele ns
					<lb xml:id="p1z32"/>Cieriam anten neter lert.
					<lb xml:id="p1z33"/>Brarim prm prim
					<lb xml:id="p1z34"/>detera releris pestiriu,
					<lb xml:id="p1z35"/>e e ae iae nus,
					<lb xml:id="p1z36"/>fude praestantem trideo ac reverente
					<lb xml:id="p1z37"/>seredlia penrta freri itarius
					<lb xml:id="p1z38"/>e lega lanm elsi sipsis,
					<pb/>
					<lb xml:id="p2z1"/>Hum auditorem meum collatum fueri,
					<lb xml:id="p2z2"/>dee i sti hernie,
					<lb xml:id="p2z3"/>tum es Deinpereras ut Rd radli,
					<lb xml:id="p2z4"/>Christi et nobis er melumium et filienta
					<lb xml:id="p2z5"/>ausunt. Gem auert  d e gaet
					<lb xml:id="p2z6"/>e e a ius,
					<lb xml:id="p2z7"/>e e ere nd e iiais
					<lb xml:id="p2z8"/>R. Tuanu.
					<lb xml:id="p2z9"/>Ci lserata i
					<lb xml:id="p2z10"/>Ee serin ele,
					<pb/>
					<lb xml:id="p4z1"/>Reverendo t charissimo
					<lb xml:id="p4z2"/>viro doctrina, pietate e vir
					<lb xml:id="p4z3"/>praestanti domino Henrico
					<lb xml:id="p4z4"/>Bullingero, <placeName ref="l587">Tigurinae</placeName> ecclesiae
