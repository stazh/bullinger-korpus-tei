	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><persName>Iacobus Brenvaldus</persName>, cui literas ad te <placeName ref="l41">Bernam</placeName> <lb xml:id="p1z2"/>nuper proficiscenti dederam, <placeName ref="l41">Bernam</placeName> non <lb xml:id="p1z3"/>est praetergressus, nunc vero tandem institutum <lb xml:id="p1z4"/>iter ad vos prosequitur.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Erit is viva epistola; <lb xml:id="p1z5"/>vos ex ipso singula quaeque audietis tum de rebus <lb xml:id="p1z6"/>ipsius tum de nostris.</s>
					<s n="4" xml:lang="la">Gratissima est simulque utilissima <lb xml:id="p1z7"/>et fructuosa scholae nostrae eius opera.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Dominus nos <lb xml:id="p1z8"/>et ipsum ad promovendam nominis sui gloriam foveat.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Feres itaque non iniquo animo, pater venerande, si <lb xml:id="p1z10"/>iam pluribus tecum agere non liceat.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Socer <lb xml:id="p1z11"/>meus attulit mihi libellum tuum, hoc est, quem tu <lb xml:id="p1z12"/>mihi dono misisti, pro quo ego maximas tibi <lb xml:id="p1z13"/>ago gratias; neque enim gratius quidquam accidere <lb xml:id="p1z14"/>mihi potuisset.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Sed ego illum legere <lb xml:id="p1z15"/>coepissem, ecce ministri nostri, qui eum mihi e manibus <lb xml:id="p1z16"/>eripiunt et me diligentia invitum antevertunt.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/>Affirmarunt illi rem multo dilucidius quam <lb xml:id="p1z18"/>antehac unquam explicatam esse, quin etiam in <lb xml:id="p1z19"/>eo quaestiones varias eleganter et perspicue <lb xml:id="p1z20"/>solutas.</s>
					<s n="10" xml:lang="la">Quapropter illi tibi quoque mecum hoc <lb xml:id="p1z21"/>nomine magnas gratias agunt deumque communibus precibus <lb xml:id="p1z22"/>orant, ut te diu ecclesiae suae incolumem conservet.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z23"/>Pergit interim d. <persName ref="p8033">Beza</persName> strenue in responsio<lb xml:id="p1z24"/>ne <persName ref="p458">Brentiana</persName>, quam se propediem absoluturum per <lb xml:id="p1z25"/>literas nobis pollicitus est.</s>
					<s n="12" xml:lang="la">Vivitur porro hic satis <lb xml:id="p1z26"/>dei beneficio feliciter, adhuc ab omni pestis contagione li<lb xml:id="p1z27"/>beri, <placeName ref="l167">Genevae</placeName> non item; nam illic paulatim <lb xml:id="p1z28"/>serpit.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Deus nostri misereatur.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Reliqua, <lb xml:id="p1z29"/>ut dixi, ex d. <persName>Brenvaldo</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Vale, pater <lb xml:id="p1z30"/>observande, cum tua familia universa.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z31"/><placeName ref="l280">Lausannae</placeName> <foreign xml:lang="el">αὐτοσχεδιαστῶς</foreign> 22. septembris <lb xml:id="p1z32"/>1564.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z33"/>Tuus si suus <lb xml:id="p1z34"/><persName ref="p2041">Blasius Marcuardus</persName><pb/><lb xml:id="p2z14"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="18" xml:lang="la"><lb xml:id="p2z15"/>Clarissimo doctissimoque <lb xml:id="p2z16"/>viro d. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z17"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z18"/>pastori vigilantissimo, domino <lb xml:id="p2z20"/>meo summa observantia <lb xml:id="p2z22"/>complectendo<lb xml:id="p2z23"/>.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z25"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
