	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Expecto tuas literas, et quidnam in <placeName>Thermis</placeName> <placeName ref="l21">Badenis</placeName> a <lb xml:id="p1z2"/>pontificio legato propositum sit, cupio scire.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><persName ref="p18477">Ferdinandus</persName> rex magistratum <lb xml:id="p1z3"/>ex tribubus collectum <placeName ref="l922">Friburgi Brisgoiae</placeName> sustulit ac nobilibus omnem potestatem <lb xml:id="p1z4"/>edicendi et gubernandi dedit, hocque pessime habet cives propter monarchiam <lb xml:id="p1z5"/>illam contra privilegia a domo Austriaca data restitutam.</s>
					<s n="4" xml:lang="la">Quo putas <lb xml:id="p1z6"/>consiliarios regis respicere aut regem ipsum?</s>
					<s n="5" xml:lang="la">Sic pedetentim omnem libertatem <lb xml:id="p1z7"/>adimet etiam suis, quam hactenus habuere.</s>
					<s n="6" xml:lang="la">Miserum seculum, in quo videmus <lb xml:id="p1z8"/>omnia mutari in alium statum.</s>
					<s n="7" xml:lang="la"><persName>Brisacum</persName>, patriam meam, <persName>baroni</persName> cuidam opignoravit, <lb xml:id="p1z9"/>liberam civitatem imperialemque.</s>
					<s n="8" xml:lang="la">Tandem, si sic progredi vult, omnia <lb xml:id="p1z10"/>evertit absumetque, quę a parentibus et antecessoribus accepit.</s>
					<s n="9" xml:lang="la">Hoc non <lb xml:id="p1z11"/>est regem agere; sed nolo <placeName>Camerinam</placeName>.</s>
					<s n="10" xml:lang="la">In arce <persName>Brisaci</persName> habitat ac exagitabit <lb xml:id="p1z12"/>totam <placeName ref="l2774">Brisgoiam</placeName> et <placeName ref="l632">Alsatiam</placeName>.</s>
					<s n="11" xml:lang="la"><persName>Hagenbachum</persName>, hominem superbum et crudelem, oppresserunt; <lb xml:id="p1z13"/>videat baro iste, ne quid novi tentet, quod ullam tyrannidis speciem habeat.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p20470">Zenderium</persName> vestrum cum adolescentibus non potui circumducere propter pluviosissimum <lb xml:id="p1z15"/>cęlo, quod ab ipso audies.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z16"/>Expecto ab <placeName ref="l491">Argentina</placeName> literas de rebus <placeName ref="l749">Saxonicis</placeName>; si quid accepero, te non <lb xml:id="p1z17"/>cęlabo.</s>
					<s n="14" xml:lang="la">Confluunt <placeName ref="l18">Augustam</placeName> capitanei Cęsariani; conscribitur exercitus.</s>
					<s n="15" xml:lang="la">Nebula <lb xml:id="p1z18"/>quędam in cęlo collocata est; ad quam regionem se exoneratura sit, adhuc ignoramus.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z19"/>Si <placeName>Turca</placeName> non adest cum exercitu in <placeName ref="l882">Hungaria</placeName>, timeo <placeName ref="l303">Magdeburgensibus</placeName>; nam Caesar <lb xml:id="p1z20"/>rebelles, fideles Christi potius debebam dicere, sub iugum ducere conatur, ne aliquid <lb xml:id="p1z21"/>suę reputationi decedat.</s>
					<s n="17" xml:lang="la">Sed absque dubio Christus vicet et abominandam bestiam, <lb xml:id="p1z22"/>a qua instigatur, detrudet ad inferna usque.</s>
					<s n="18" xml:lang="la">Reliqua a <persName ref="p1214">Frisio</persName> nostro.</s>
					<s n="19" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z23"/><placeName ref="l28">Basileę</placeName> 27. iunii 1551.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">D. <lb xml:id="p1z24"/><persName ref="p8171">Theodorum</persName> plurima salute <lb xml:id="p1z25"/>imperties, cui per proximum cursorem prolixas scribam literas.</s>
					<s n="22" xml:lang="la" ana="salute">Salutabis etiam <lb xml:id="p1z26"/>nomine meo generum tuum cum <persName ref="p8011">Gvalthero</persName>, qui ad ternas literas nihil respondit.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z27"/>T[uus] <lb xml:id="p1z28"/><persName ref="p1278">Gastius</persName>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro d. <lb xml:id="p2z2"/>magistro <persName ref="p495">Heynricho <lb xml:id="p2z3"/>Bullingero</persName>, pastori vigi<lb xml:id="p2z4"/>lantissimo.</s>
					<s n="25" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
