	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Diu nullas ad te, honorande frater, literas <lb xml:id="p1z2"/>scripsi, diu nullas a te accepi vicissim.</s>
					<s n="3" xml:lang="la">Sed certo <lb xml:id="p1z3"/>scio, nihilominus me diligi a te.</s>
					<s n="4" xml:lang="la">Nam et ego te <lb xml:id="p1z4"/>colo et diligo in Domino.</s>
					<s n="5" xml:lang="la">Sed et anxius sum perpetuo, <lb xml:id="p1z5"/>dolens nihil in reparando foedere effici posse a piis.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/>Non deesset nostris voluntas, si opportunitas adesset.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z7"/>Nunc cum nihil possim in re apud multos desperata <lb xml:id="p1z8"/>hactenus converto me ad preces, certus fidelibus <lb xml:id="p1z9"/>precibus a Deo omnipotente impetrari omnia bona.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Dominus concedat magistratui vestro spiritum et <placeName ref="l41">Bernatibus</placeName> <lb xml:id="p1z11"/>quoque animum qui utrinque velit aequa et bona.</s>
					<s n="9" xml:lang="la">Orate <lb xml:id="p1z12"/>vos quoque Dominum.</s>
					<s n="10" xml:lang="la">Quod vos facere nihil dubito.</s>
					<s n="11" xml:lang="la">Dominus <lb xml:id="p1z13"/>res ecclesiae suae ita fere temperat, ut, cum videntur <lb xml:id="p1z14"/>nimium fere tribuere hominibus, a se ipso pro<lb xml:id="p1z15"/>cul abactis omnibus hominibus suspendat.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z16"/>Mortuus est optimus senex <persName ref="p8127">Pellicanus</persName> noster, quod te alias <lb xml:id="p1z17"/>audisse nihil dubito.</s>
					<s n="13" xml:lang="la">Vocatus est in locum eius D. <lb xml:id="p1z18"/><persName ref="p8111">Petrus Martyr</persName>.</s>
					<s n="14" xml:lang="la">Nam is, cum rediisset ex <placeName ref="l830">Anglia</placeName>, amice <lb xml:id="p1z19"/>s<lb xml:id="p1z20"/>e mihi obstrinxit.</s>
					<s n="15" xml:lang="la">Venit autem ad nos 17 huius mensis <lb xml:id="p1z21"/>sanus et incolumis et exceptus est publico omnium gaudio.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z22"/>Nam et concordibus votis electus est.</s>
					<s n="17" xml:lang="la">Dominus bene<lb xml:id="p1z23"/>dicat nobis et velit hoc nobis felix esse et faustum.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z24"/>Ex <placeName ref="l822">Germania</placeName> habemus multa de Lutheranorum <lb xml:id="p1z25"/>furiis.</s>
					<s n="19" xml:lang="la">Principes diligenter cavent in reformandis <lb xml:id="p1z26"/>ecclesiis, ne ullus admittatur orthodoxus, sed <lb xml:id="p1z27"/>Lutherani duntaxat quęruntur.</s>
					<s n="20" xml:lang="la">Optimus vir et sanctissimus <persName ref="p8041">Ioa<lb xml:id="p1z28"/>nnes a Lasco</persName> contulit cum <persName ref="p458">Brentio</persName>, sed ad finem colloquii <lb xml:id="p1z29"/>audio Principem hortatum ut recipiat <lb xml:id="p1z30"/>vel agnoscat confessionem <placeName ref="l18">Augustanam</placeName> et suam peregrinam <lb xml:id="p1z31"/>ecclesiam coniungat cum <placeName ref="l822">Germaniae</placeName> ecclesiis etc.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z32"/>Annon hoc futurum praedixeram?</s>
					<s n="22" xml:lang="la">Si mille instituant<lb xml:id="p1z33"/>ur colloquia, frustra agemus cum istis.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Experientia <lb xml:id="p1z34"/>probabit.</s>
					<s n="24" xml:lang="la">Interim non despero.</s>
					<s n="25" xml:lang="la">Spero enim <lb xml:id="p1z35"/>Dominum opportunitatem aliquam commodius agendi <lb xml:id="p1z36"/>daturum.</s>
					<s n="26" xml:lang="la">Oremus et hic Dominum ne nobis et toti <lb xml:id="p1z37"/><placeName ref="l822">Germaniae</placeName> desit.</s>
					<s n="27" xml:lang="la">Rursus nobis pugnandum audio <lb xml:id="p1z38"/>ad nundinas proximas.</s>
					<s n="28" xml:lang="la">Dominus Deus noster adsit <lb xml:id="p1z39"/>nobis.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><placeName ref="l830">Anglos</placeName> <persName ref="p1911">Leverum</persName>, et sotium eius tibi <lb xml:id="p1z40"/>commendo.</s>
					<s n="30" xml:lang="la" ana="salute">Salutabis eos ex me.</s>
					<s n="31" xml:lang="la">Accepi eorum literas <pb/><lb xml:id="p2z1"/>sed nunc respondere non potui.</s>
					<s n="32" xml:lang="la" ana="farewell">Vale cum omnibus fratribus et <lb xml:id="p2z2"/>cum tota ecclesia.</s>
					<s n="33" xml:lang="la">Dominus Iesus servet vos omnes et te im primis diu nobis incolumem tueatur.</s>
					<s n="34" xml:lang="la" ana="salute">Salut<lb xml:id="p2z3"/>ant te et tuos nostri omnes.</s>
				</p>
				<p>
					<s n="35" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 26. Iulii anno 1556.</s>
				</p>
				<p>
					<s n="36" xml:lang="la"><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="37" xml:lang="la">Claris<lb xml:id="p2z4"/>simo viro D. <persName ref="p540">Ioanni Calvino</persName>, <placeName ref="l167">Genevensis</placeName> ecclesiae fido pastori, domino colendiss<lb xml:id="p2z5"/>imo et frat<lb xml:id="p2z6"/>ri honorando et charomes.</s>
				</p>
			</div>
