	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Cum sese obtulerit occasio, quod certiorem te facerem de <lb xml:id="p1z2"/>statu meo, volui ad te, mi D. <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z3"/>haec scribere, cum tibi tanta debeam, tum quod mihi <lb xml:id="p1z4"/>iucundissimum esset de tua salute intelligere.</s>
					<s n="2" xml:lang="la"><placeName ref="l41">Bernam</placeName> <lb xml:id="p1z5"/>petii et tuas reddidi <persName ref="p1804">Judoco</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p1804">Jodocus Kilchmeyer</persName>.</note>, qui mihi astitit magno <lb xml:id="p1z6"/>cum studio.</s>
					<s n="3" xml:lang="la">Sed, ut potuisti meis superioribus <lb xml:id="p1z7"/>intelligere, nullus tum locus vaccabat.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Caeterum <lb xml:id="p1z8"/>accessi <placeName ref="l28">Basileam</placeName>, ubi nec amicos nec, sit ita <lb xml:id="p1z9"/>libenter possim loqui, fere nullos inveni christianos; <lb xml:id="p1z10"/>mandabit etenim mihi dominus de coelo panem.</s>
					<s n="5" xml:lang="la">Haec sunt, <lb xml:id="p1z11"/>quae possum scribere; fortassis e <placeName ref="l832">Gallia</placeName> <lb xml:id="p1z12"/>ad te alias scribam.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Librum tuum in <placeName ref="l832">Gallicam</placeName> linguam <lb xml:id="p1z13"/>traduxi; spero in lucem intra paucos dies emittere.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute"><lb xml:id="p1z14"/>Tu interim, mi D. <persName ref="p495">Bullingere</persName> valeas; <lb xml:id="p1z15"/>uxorem et ecclesiam domus tuae meo nomine saluta, <lb xml:id="p1z16"/>quibus omnibus vobis pax sit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l28">Basileae</placeName> <lb xml:id="p1z17"/>octavo idus martii.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/>Tuus in Christo Iesu ex animo <persName ref="p2317">P. <lb xml:id="p1z19"/>Naillosius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro D. <lb xml:id="p2z2"/>meo D. <persName ref="p495">H[enrico] Bullingero</persName>, aecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> episcopo vigilantissimo.</s>
				</p>
			</div>
		</body>
	</text>
