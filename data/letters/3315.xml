	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tibi et <persName ref="p1283">Gesnero</persName>, amicis integerrimis, ago gratias <lb xml:id="p1z2"/>immortales pro vestris in me meritis.</s>
					<s n="3" xml:lang="la">Libros <lb xml:id="p1z3"/>perpetuo mittitis, et ego nihil vobis rependo.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Animus <lb xml:id="p1z4"/>non deest, sed benemerendi occasio hactenus non <lb xml:id="p1z5"/>fuit oblata; qui si dabitur, sedulo curabo, ne <lb xml:id="p1z6"/>frustra et ingrato vestra exhibeatis beneficia.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Apud nos omnia sunt turbis plena.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Qui multa <lb xml:id="p1z8"/>et magna auri pondera apud <placeName ref="l830">Anglie</placeName> regem <lb xml:id="p1z9"/>deposuerunt, istis <persName>Hyblaeo</persName> melle dulcior est <lb xml:id="p1z10"/>ea victoria, vicissim <placeName ref="l832">Gallo</placeName> qui sua crediderunt, <lb xml:id="p1z11"/>istis omnia sunt adversa, omnia ruinam videntur <lb xml:id="p1z12"/>minari.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Videres <persName>Eucliones</persName> valde et ad atram <lb xml:id="p1z13"/>bilem usque redactos tristes et hinc inde <lb xml:id="p1z14"/>cursitantes, ut ollam reconditam observent <lb xml:id="p1z15"/>et, ne omnino perdatur, custodiant.</s>
					<s n="8" xml:lang="la">Sed <lb xml:id="p1z16"/>affectibus liberi et usuris istis non adeo <lb xml:id="p1z17"/>inhiantes putant hanc cladem facturam <lb xml:id="p1z18"/>ad gloriam Christi et uberiorem verbi propagationem<lb xml:id="p1z19"/>.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>partim odio pontificis, partim quod uterque <lb xml:id="p1z21"/>rex non audeat tot et tantos exercere in suos phalarimos in o<lb xml:id="p1z22"/>b religionem in subditos.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Castrum in <placeName ref="l808">Belgis</placeName> oppugnatur ab <placeName ref="l830">Anglo</placeName>; sed <lb xml:id="p1z24"/>putant frustra fieri omnia.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z25"/>Regem <placeName ref="l832">Gallię</placeName> reviviscere et recuperare vires <lb xml:id="p1z26"/>arbitrantur, immo certum este plerique predicant.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z27"/><placeName ref="l862">Helvetios</placeName> alieno periculo non secius quam olim s<lb xml:id="p1z28"/>apere prudentes autumant, quare admonitos <lb xml:id="p1z29"/>velim vos, ut iunctis viribus, que ad univer<lb xml:id="p1z30"/>sos <lb xml:id="p1z31"/>et singulos pertinent, probe perpenderetis.</s>
					<s n="13" xml:lang="la">Rex <lb xml:id="p1z32"/>si ad interitum omnino abit, imperium <placeName ref="l425">Romanum</placeName> <lb xml:id="p1z33"/>sub alienam redigetur potestatem et libertas <placeName ref="l862">Hel<lb xml:id="p1z34"/>vetica</placeName> periclitabitur.</s>
					<s n="14" xml:lang="la">Dabunt tamen superiores <lb xml:id="p1z35"/>operam, ne e manu cadat manubrium.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z36"/><persName>Bolvilerus</persName> fecit delectum militum et selectissimos <pb/><lb xml:id="p2z1"/>habet ad minus 8000; pollicitus est suis, <lb xml:id="p2z2"/>quod intra octiduum velit hostium bona eis <lb xml:id="p2z3"/>prebere diripienda.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z4"/>Voluit ducatum <placeName ref="l572">Wirtenbergensem</placeName> in recensendis militibus <lb xml:id="p2z5"/>onerare; sed optimus princeps contra regis <lb xml:id="p2z6"/><persName ref="p18477">Ferdinandi</persName> sepius de hac re scriptas literas <lb xml:id="p2z7"/>fortiter se opposuit et tantum effecit, ut ab illo <lb xml:id="p2z8"/>onere penitus suos liberaret.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z9"/>Metim dicunt civium contra <placeName ref="l832">Gallos</placeName> dissidio in hostium <lb xml:id="p2z10"/>potestatem cessisse.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="farewell">Vale optime mi <persName ref="p495">Bullingere</persName> <lb xml:id="p2z11"/>et <persName ref="p2856">Geryonem</persName> tibi per omnia devotum commendatum habeas.</s>
					<s n="19" xml:lang="la"><placeName ref="l18">Augustę</placeName> 16. septembris anno etc. 57.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="salute"><lb xml:id="p2z12"/>Saluta d. <persName ref="p1283">Gesnerum</persName> et <persName ref="p8011">Gvaltherum</persName> et <persName ref="p2336">Occhinum</persName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><persName ref="p2856">G[eryon] S[aile<lb xml:id="p2z13"/>r]</persName> t[uus].</s>
				</p>
				<p>
					<s n="22" xml:lang="la">D. <lb xml:id="p2z14"/><persName ref="p495">Heinricho Bullingero</persName> theologica eruditione et pietate insigni, d. et amico syncerissimo.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p2z15"/><placeName ref="l587">Tyguri</placeName>.</s>
				</p>
			</div>
		</body>
