	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Binas iam ad te literas misi<note xml:id="fn1" type="footnote" n="1">Oben <ref target="file11422">Nr. 1379</ref> und 1382.</note>, pater humani<lb xml:id="p1z2"/>ssime, nec dum adhuc responsum ullum video.</s>
					<s n="3" xml:lang="la">Quae res non parum <lb xml:id="p1z3"/>animum meum curis et sollicitudine implicat, cum res mihi <lb xml:id="p1z4"/>talis videatur, quę moram tantam minime postulet.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Quare <lb xml:id="p1z5"/>vęhementer te rogo, ut, quoad fieri potest, cures, ne diutius hęc res <lb xml:id="p1z6"/>procrastinetur.</s>
					<s n="5" xml:lang="la">Sed me hortatore opus forsan non est; te enim in <lb xml:id="p1z7"/>rebus meis etiam meipso diligentiorem esse credo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quod <lb xml:id="p1z8"/>tamen nunc denuo ad te scribam, tabellarius<note xml:id="fn2" type="footnote" n="2">Unbekannt.</note> hic caussa est, <lb xml:id="p1z9"/>civis <placeName ref="l587">Tigurinus</placeName> et uxoris <persName ref="p8418">Myconii</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p5896">Margret</persName>.</note> cognatus.</s>
					<s n="7" xml:lang="la">Ab hoc enim <lb xml:id="p1z10"/><persName ref="p8418">Myconii</persName> uxor pannum lineum emit florenorum duorum et dimidii <lb xml:id="p1z11"/>pretio et a me, ut tibi scriberem, petiit, ut nummos hos <lb xml:id="p1z12"/>meo nomine ex angarię, ut vocant, stipendio<note xml:id="fn4" type="footnote" n="4">d. h. aus der vierteljährlichen Teilauszahlung des Stipendiums.</note> illi solvas.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Quare te obsecro, ut hisce precibus meis satisfacere digneris <lb xml:id="p1z14"/>et huic pecuniam hanc numeres.<pb type="edition" next="93"/></s>
				</p>
				<p>
					<s n="9" xml:lang="la">Iosephi historiam <lb xml:id="p1z15"/>iamdudum absolvissem<note xml:id="fn5" type="footnote" n="5"><persName ref="p8011">Gwalthers</persName> ungedruckte Dichtung "De venditione Iosephi in Aegyptum et insano Sephirae amore" (Zürich ZB, Ms D 152, 201r.-234v.) wurde bereits in <placeName ref="l280">Lausanne</placeName> begonnen; die Widmung an <persName ref="p495">Bullinger</persName> datiert vom 15. Februar 1540.</note>, nisi curis tot perplexus ingenium <lb xml:id="p1z16"/>meum ad carminis studium applicare nequirem.</s>
					<s n="10" xml:lang="la">Sed <lb xml:id="p1z17"/>quamprimum perfecero, ad te mittam.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z18"/>Libros, de quibus <lb xml:id="p1z19"/>nuper scripsi<note xml:id="fn6" type="footnote" n="6">Siehe oben <ref target="file11422">Nr. 1379</ref>, 30-32 und 1382, 34f.</note>, quaeso, mittito.</s>
					<s n="12" xml:lang="la" ana="salute">Salutabis nomine meo <lb xml:id="p1z20"/>uxorem<note xml:id="fn7" type="footnote" ana="bio" n="7"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> et matrem<note xml:id="fn8" type="footnote" ana="bio" n="8"><persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note> tuam cum omni liberorum coetu<note xml:id="fn9" type="footnote" n="9">Siehe oben <ref target="file11387">Nr. 1344</ref>, Anm. 14.</note>.</s>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z21"/>Vale, pater charissime, deusque te mihi diu servet incolumem.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z22"/><placeName ref="l28">Basileae</placeName>, 18. calendis maii 1540.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z23"/>Tuus observantissimus</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p8011">Rodolphus Gvaltherus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesię episcopo vigilantissimo, <lb xml:id="p2z4"/>patri suo plurimum <lb xml:id="p2z5"/>colendo.</s>
					<s n="18" xml:lang="de"><lb xml:id="p2z6"/>An M. <persName ref="p495">Heinrych <lb xml:id="p2z7"/>Bullinger</persName>, <lb xml:id="p2z8"/>predicant zuͦ <lb xml:id="p2z9"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
