			<zone xml:id="p2z3-0" points="2512,1512 2550,1526 2596,1510 2664,1536 2746,1510 2792,1530 2902,1530 2902,1458 2812,1476 2760,1438 2736,1462 2686,1470 2570,1426 2512,1460">2523,1508 2548,1505 2574,1503 2599,1502 2625,1504 2650,1505 2676,1505 2701,1505 2727,1505 2752,1505 2778,1505 2803,1503 2829,1502 2854,1502 2880,1502 2906,1502</zone>
