	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quae sit domus nostrae calamitas, ex fratre <lb xml:id="p1z2"/>cognosces.</s>
					<s n="3" xml:lang="la">Fiunt illa a domino, cui me totum <lb xml:id="p1z3"/>trado cum omnibus, quae habeo; faciat ille, quod <lb xml:id="p1z4"/>bonum ei videtur in oculis suis.</s>
					<s n="4" xml:lang="la">Ea sunt tempora, <lb xml:id="p1z5"/>ut laudandus sit dominus in illis, quos hinc ab<lb xml:id="p1z6"/>ripit et in aeternam eos collocat securitatem, <lb xml:id="p1z7"/>ne videant mala secutura.</s>
					<s n="5" xml:lang="la">Interea te oro, <lb xml:id="p1z8"/>ut pro nobis preceris deum et nostros tibi semper <lb xml:id="p1z9"/>habeas commendatos.</s>
					<s n="6" xml:lang="la">Cursorem, qui proximis diebus <lb xml:id="p1z10"/>apud nos fuit, putabam a senatu missum; <lb xml:id="p1z11"/>postea intellexi illum privatim tantum aliquid <lb xml:id="p1z12"/>egisse.</s>
					<s n="7" xml:lang="la">Nihildum audio ab <placeName ref="l862">Helvetiis</placeName> responsum es<lb xml:id="p1z13"/>se; ita subsidit negotium illud.</s>
					<s n="8" xml:lang="la">Caseum tibi <lb xml:id="p1z14"/>per oeconomum <placeName ref="l269">Küngßfeldensem</placeName> mitto, quem accipies <lb xml:id="p1z15"/>illo ad vos transmittente; rogo, ut boni consul[as], <lb xml:id="p1z16"/>nihil aliud nunc habeo.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Solaberis tu fratrem meum; <lb xml:id="p1z17"/>scio enim illum plus moeroris habitu[rum<lb xml:id="p1z18"/>] ex unius filii obitu quam me ex omnium meorum, <lb xml:id="p1z19"/>quos amisi.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l41">Bernae</placeName> 13. novembris 1566.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><persName ref="p8018">I[<lb xml:id="p1z20"/>ohannes] Hallerus</persName> tuus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z21"/>Reliqua, quae mitto, a <persName ref="p4790">Vinslero</persName> accepi.</s>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Bullingero</persName>, domino <lb xml:id="p2z3"/>et compatri meo <lb xml:id="p2z4"/>colendissimo.</s>
					<s n="14" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
