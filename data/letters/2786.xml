	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Compater in domino charissime, transiit <lb xml:id="p1z2"/>per nos <persName ref="p1936">Fr[anciscus] Lysmaninus</persName> reversurus, <lb xml:id="p1z3"/>ut promisit.</s>
					<s n="3" xml:lang="la">Oro dominum, ut antichristum <lb xml:id="p1z4"/>e tota <placeName ref="l2472">Polonia</placeName> exterminet; multum adhuc <lb xml:id="p1z5"/>negocii incumbet fratribus, qui regno Christi <lb xml:id="p1z6"/>illic inserviunt, non modo a papistis, sed <lb xml:id="p1z7"/>et a falsis fratribus ad serendas contentiones <lb xml:id="p1z8"/>natis.</s>
					<s n="4" xml:lang="la">Quare orandum pro illis est <lb xml:id="p1z9"/>indesinenter.</s>
					<s n="5" xml:lang="la">Schedulam de iureiurando <lb xml:id="p1z10"/>nescio quam de <persName ref="p8018">Hallero</persName> dedi obiter scri<lb xml:id="p1z11"/>ptam, parum cogitans fore, ut in manus <lb xml:id="p1z12"/>tuas incideret.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Verum benedictus dominus, <lb xml:id="p1z13"/>qui tentationem hanc, cui prope non pauci <lb xml:id="p1z14"/>boni palmas dederunt, pro sua providentia <lb xml:id="p1z15"/>suspendit.</s>
					<s n="7" xml:lang="la">In posterum conveniet plus <lb xml:id="p1z16"/>ostendere animi in huiusmodi tentationibus.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Loci mei tarde promovent; nam semel <lb xml:id="p1z18"/>tantum per septimanam in illis lego, imo <lb xml:id="p1z19"/>dictare cogor.</s>
					<s n="9" xml:lang="la">In Apocalypsin scribere <lb xml:id="p1z20"/>nunquam cogitavi; quare nihil est, quod <lb xml:id="p1z21"/>hac de re nescio unde accepisti.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z22"/>De pace statuum imperii scriptum est ad me: <lb xml:id="p1z23"/>Qui sapiunt, ne tribuant illi nimium.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/>Pro strena <persName ref="p2207">Heynrichulo</persName> nostro missa <lb xml:id="p1z25"/>habemus tibi gratiam.</s>
					<s n="12" xml:lang="la">Det dominus, ut, ubi <lb xml:id="p1z26"/>factus fuerit sponsus firma valetuidine, <lb xml:id="p1z27"/>ad nuptias ipsius venias.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Optime <lb xml:id="p1z28"/>vale, compater charissime.</s>
					<s n="14" xml:lang="la">Hodie propter <lb xml:id="p1z29"/><placeName ref="l167">Genevenses</placeName> habitus est maior senatus <lb xml:id="p1z30"/>in causa renovandae societatis; verum <lb xml:id="p1z31"/>nihil efficitur, nisi fallat; nolunt enim <lb xml:id="p1z32"/>illi cedere in causa, de qua nostri ne <lb xml:id="p1z33"/>verbum quidem fieri sinunt.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Salutem domui <lb xml:id="p1z34"/>tuae et meo et meorum nomine.</s>
					<s n="16" xml:lang="la" ana="salute">Ubi <persName ref="p8354">Lęto</persName> <lb xml:id="p1z35"/>scripseris, salutem illi meo nomine mandes, <lb xml:id="p1z36"/>quaeso.</s>
					<s n="17" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1555. 15. decem<lb xml:id="p1z37"/>bris.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><persName ref="p8417">W[olfgangus] Musculus</persName>, tuus in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro <lb xml:id="p2z2"/>m. <persName ref="p495">Heinr[ycho] <lb xml:id="p2z3"/>Bullingero</persName>, com<lb xml:id="p2z4"/>patri suo in <lb xml:id="p2z5"/>domino charissimo.</s>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
