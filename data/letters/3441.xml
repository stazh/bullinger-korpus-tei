	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Reverende ac doctissime mi domine <persName ref="p495">Bullingere</persName>, postquam <lb xml:id="p1z2"/>non solum ex humanissimis litteris tuis <lb xml:id="p1z3"/>ad me sepius scriptis, sed etiam ex con<lb xml:id="p1z4"/>sultatione et relatione optimi at<lb xml:id="p1z5"/>que <lb xml:id="p1z6"/>eruditissimi d. <persName ref="p8101">Lelii</persName> certo cognovi me abs te <lb xml:id="p1z7"/>synceriter diligi at mea unsulsa et <lb xml:id="p1z8"/>incongrua scripta ad te aliquoties <lb xml:id="p1z9"/>transmiss placere ac grata esse.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z10"/>Quare non potui non has ad te <lb xml:id="p1z11"/>per pręnominatum <persName ref="p8101">Lelium</persName> nostrum, qui <lb xml:id="p1z12"/>hodie ambo e <placeName ref="l512">Tubinga</placeName>, ille ad vos, <lb xml:id="p1z13"/>ego <placeName ref="l907">Campidunum</placeName> versus discedimus <lb xml:id="p1z14"/>dare hicque te fatio certiorem me ab<lb xml:id="p1z15"/>solvisse 4 evangelistas et Acta apostolica <lb xml:id="p1z16"/>et excusisse typis, quibus adieci longissimam <lb xml:id="p1z17"/>pręfationem, in qu pręcipuos <lb xml:id="p1z18"/>et necessarios locos theologicos tracto, <lb xml:id="p1z19"/>inter quos est etiam tua illa eruditissima e<lb xml:id="p1z20"/>t piissima pręfatio in Iohannem <lb xml:id="p1z21"/>et integra de verbo ad verbum <lb xml:id="p1z22"/>traducta, et prędicta pręfatio habet <lb xml:id="p1z23"/>25 folia.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z24"/>Traduxi etiam <lb xml:id="p1z25"/>illud compendium et scopum totius sacre <lb xml:id="p1z26"/>scripture ex vestris Bibliis et posui <lb xml:id="p1z27"/>in primum folium mei <placeName>Sclavici</placeName> libri <lb xml:id="p1z28"/>loco illorum trium foliorum <placeName ref="l822">Germanicorum</placeName>, <lb xml:id="p1z29"/>quod illa <placeName ref="l822">Germanica</placeName>, non propter meos <lb xml:id="p1z30"/>Schlavos, sed propter superattendentes <lb xml:id="p1z31"/>typograhię, ut ex illa prefatione <lb xml:id="p1z32"/><placeName ref="l822">Germanica</placeName> intelligant me nihil <lb xml:id="p1z33"/>contra <placeName ref="l425">Romanum</placeName> regem scribere, edidi; nam neq<lb xml:id="p1z34"/>ue <placeName ref="l361">Noribergenses</placeName> neque <placeName ref="l1430">Hallenses</placeName> <lb xml:id="p1z35"/>ante annos 7 volebant permittere, <pb/><lb xml:id="p2z1"/>ut meus rythmicus cate<lb xml:id="p2z2"/>chismus <placeName>Shclavicus</placeName> ab eorum typo<lb xml:id="p2z3"/>graphis excuderetur, qui sciebant me <lb xml:id="p2z4"/>esse sub indigna(tio)ne regis, a qua <lb xml:id="p2z5"/>et sibi timebant.</s>
					<s n="5" xml:lang="la">Incepi etiam excu<lb xml:id="p2z6"/>dere annotationes breves in dominica<lb xml:id="p2z7"/>lia et festivalia, ut loquuntur, evan<lb xml:id="p2z8"/>gelia; sed eas non potui iam absolvere.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p2z9"/>Relinquo illas cuidam studio<lb xml:id="p2z10"/>so populari meo commisique, <lb xml:id="p2z11"/>ut eas corrigat.</s>
					<s n="7" xml:lang="la">Hec volui tibi <lb xml:id="p2z12"/>significare, quia scio istum meum <lb xml:id="p2z13"/>laborem <lb xml:id="p2z14"/>tibi placere.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Quo autem certior <lb xml:id="p2z15"/>fias me vera dicere, mitto 3 <lb xml:id="p2z16"/>prima folia mearum editionum.</s>
					<s n="9" xml:lang="la"><lb xml:id="p2z17"/>Ex tertio, quod caret Germanico <lb xml:id="p2z18"/>titulo, ex concordantiis sive <lb xml:id="p2z19"/>locis citatis in margine adpositis <lb xml:id="p2z20"/>facile inetlliges, tum etiam ex di<lb xml:id="p2z21"/>visione illud tuum compen<lb xml:id="p2z22"/>dium esse.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z23"/>Animadverti aliquantulum ex quibusdam <lb xml:id="p2z24"/>coniecturis quandam simultatem <lb xml:id="p2z25"/>esse inter te et <persName ref="p3375">Vergerium</persName>, licet ipse <lb xml:id="p2z26"/><persName ref="p3375">Vergerius</persName> quicquam mali me praesente <lb xml:id="p2z27"/>de te nunquam sit locutus.</s>
					<s n="11" xml:lang="la">Rogo <lb xml:id="p2z28"/>itaque atque moneo, velis et tu <lb xml:id="p2z29"/>humanos pravos affectus domare, <lb xml:id="p2z30"/>quod et <persName ref="p3375">Vergerius</persName> facturum mihi <lb xml:id="p2z31"/>pollicitus est.</s>
					<s n="12" xml:lang="la">Scio <persName ref="p3375">Vergerium</persName> <lb xml:id="p2z32"/>uno vel altero vitio ad<lb xml:id="p2z33"/>huc sicuti ante regenerationem <lb xml:id="p2z34"/>laborare; quod autem esset hypo<pb/><lb xml:id="p3z2"/>crita vel clancularius papista, hec <lb xml:id="p3z3"/>pessima nota sibi falso impingitur.</s>
					<s n="13" xml:lang="la"><lb xml:id="p3z4"/>Reliqua omnia ex d. <persName ref="p8101">Lelio</persName> liquidius <lb xml:id="p3z5"/>cognosces.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Commendabis me domino honoran<lb xml:id="p3z6"/>do seni <persName ref="p2336">Ochino</persName> et reliquis dominis meis <lb xml:id="p3z7"/>et fratribus, tuis commilitonibus, <lb xml:id="p3z8"/>sedulo.</s>
					<s n="15" xml:lang="la">Ex <placeName ref="l512">Tubinga</placeName> pręcipitanter <lb xml:id="p3z9"/>20. decembris 1557.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p3z10"/>T(ue) r(everen)<lb xml:id="p3z11"/>de dominatio<lb xml:id="p3z12"/>nis <lb xml:id="p3z13"/>obsequiosissimus <lb xml:id="p3z14"/><persName ref="p8452">Primus Truberus</persName>.</s>
					<s n="17" xml:lang="la"><lb xml:id="p3z15"/>Scripseram ad te <lb xml:id="p3z16"/>ante 9 hebdomadas <lb xml:id="p3z17"/>per <persName>Mathiam Rotto</persName> <placeName ref="l291">Lindaviensem</placeName>, quae in <lb xml:id="p3z18"/>patria mea cum <placeName ref="l2510">Turcis</placeName> hoc anno <lb xml:id="p3z19"/>patrata sint et quomodo <placeName ref="l546">Vienne</placeName> meus <lb xml:id="p3z20"/>doctus conterraneus religionem nostram <lb xml:id="p3z21"/>in publicis disputationibus cępit <lb xml:id="p3z22"/>tueri.</s>
					<s n="18" xml:lang="la">Illa scripta si habueris, quando <lb xml:id="p3z23"/>poteris, mihi significato.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p4z1"/>Eruditione et pietate viro <lb xml:id="p4z2"/>clarissimo domino <persName ref="p495">Heinricho <lb xml:id="p4z3"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p4z4"/>pastori fidelissimo, domino <lb xml:id="p4z5"/>et pręceptori meo observandis<lb xml:id="p4z6"/>simo.</s>
					<s n="20" xml:lang="la"><lb xml:id="p4z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
