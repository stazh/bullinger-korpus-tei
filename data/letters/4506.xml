	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Pium aliquem et doctum virum, qui ingenium et mores filii <lb xml:id="p1z2"/>dei auxilio formet, hic expecto.</s>
					<s n="3" xml:lang="la">Cum domino <persName ref="p8111">Martire</persName>, qua die <lb xml:id="p1z3"/>a vobis discessi, sum collocutus, quamobrem diutius apud vos <lb xml:id="p1z4"/>non sinerem filium immorari.</s>
					<s n="4" xml:lang="la">Responsum non habui ex <placeName ref="l832">Gallia</placeName> ad <lb xml:id="p1z5"/>literas, quibus tuarum exemplar addideram.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Si quid de conventu <lb xml:id="p1z6"/><placeName ref="l496">Stutcardiensi</placeName> (<placeName ref="l496">Stuthard</placeName>?), progressu aut aliis rebus scitu dignis intellexisti, <lb xml:id="p1z7"/>ea ut mihi signiffices per literas, etiam atque etiam oro.</s>
					<s n="6" xml:lang="la">Incertus sum, <lb xml:id="p1z8"/>si comitiis hoc mense indictis <placeName ref="l21">Badene</placeName> interesse potero, quod <lb xml:id="p1z9"/><placeName ref="l300">Lucernenses</placeName> velint constituta die 3. mensis proximi iudicium fieri <lb xml:id="p1z10"/>de turpi lucro, nempe interesse 16 pro centum, de quo nihil volun<lb xml:id="p1z11"/>t <lb xml:id="p1z12"/>remittere nec ullam interponi dilationem.</s>
					<s n="7" xml:lang="la">In dies augetur in <lb xml:id="p1z13"/><placeName ref="l832">Gallia</placeName> tumultus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Fama est <persName ref="p7659">ducem Florentie</persName> <placeName ref="l2801">Corsicam</placeName> occupasse, <lb xml:id="p1z14"/>papam colligere militem et velle, ut provinciales et gardiani conventuum <lb xml:id="p1z15"/>intersint consilio nationali <placeName ref="l832">Gallie</placeName>, si id disturbare non possit nec per se <lb xml:id="p1z16"/>nec per <persName ref="p18575">Philippum</persName>.</s>
					<s n="9" xml:lang="la"><persName ref="p20184">Bolvilerum</persName> pecunie summam petere a <placeName ref="l28">Basiliensibus</placeName> <lb xml:id="p1z17"/>sub interesse, ut colligat militem.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Dominus interim ociosus non erit <lb xml:id="p1z18"/>et suum aget negocium inter opera aliena.</s>
					<s n="11" xml:lang="la">Scribo d. <persName ref="p8009">Fabricio</persName> <lb xml:id="p1z19"/>et medico <placeName ref="l98">Curiensi</placeName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Mea <persName ref="p8313">Margareta</persName> cydoniatum et poma condita <lb xml:id="p1z20"/>a se stomacho utilia et cultellos <placeName ref="l832">Gallicos</placeName> uxori tue mittit <lb xml:id="p1z21"/>libri, quem ei donasti, loco et te plurimum salutat.</s>
					<s n="13" xml:lang="la" ana="salute">Amicos <lb xml:id="p1z22"/>omnes meo nomine salutabis nosque, quod facis, amabis et pro tuo <lb xml:id="p1z23"/>iure posces, si quid desideraveris, quod in mea sit facultate.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z24"/><placeName ref="l760">Solut[uri]</placeName> 21. octobris.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z25"/>Tuus ex animo <persName ref="p629">Coignetus</persName>.</s>
				</p>
				<p>
					<note>[Von anderer Hand:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>pastori vigilantissimo.</s>
					<s n="17" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
