	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Si raro scribo, domine colendissime, id occupationibus <lb xml:id="p1z2"/>tuis adscribe, quibus in publica comoda peccans <lb xml:id="p1z3"/>molestus esse nollo, non meis, quę paucę sunt.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Pro tantillo meo aut potius nullo in filium tuum <lb xml:id="p1z5"/>officio tam ingentes gratię non fuerunt agendę et <lb xml:id="p1z6"/>cum tanto foenore, ut sortem ipsam longe multo <lb xml:id="p1z7"/>excedant.</s>
					<s n="4" xml:lang="la">Relatum est aliquot nobiles <placeName ref="l522">Venetos</placeName> <lb xml:id="p1z8"/>simulatis indumentis proficisci ad commitia <placeName>Badensa</placeName>, <lb xml:id="p1z9"/>quod non credo; quid enim dissimulandum hac in re?</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Alii dicunt ipsos <placeName ref="l522">Venetos</placeName> pepigisse nova <lb xml:id="p1z11"/>foedera cum rege <placeName ref="l875">Hispaniarum</placeName> et duce <placeName ref="l2478">Sabaudię</placeName> <lb xml:id="p1z12"/>deque omnibus controversiis convenisse.</s>
					<s n="6" xml:lang="la">Quod si ita est, <lb xml:id="p1z13"/>illi mon[archę] quietem sibi pecuniis suis comparare <lb xml:id="p1z14"/>voluerunt; illi vero aliquid moliuntur.</s>
					<s n="7" xml:lang="la">Auditum <lb xml:id="p1z15"/>est, sed rumore incerto neque adhuc creditum, <persName>Trypolin</persName> <lb xml:id="p1z16"/>captam cum magna utrinque clade et occisione <lb xml:id="p1z17"/>hominum.</s>
					<s n="8" xml:lang="la">De rebus nostris in <placeName ref="l832">Gallia</placeName> et <placeName ref="l2524">Scotia</placeName> <lb xml:id="p1z18"/>nihil intelligo; illinc enim iamdudum litteras non <lb xml:id="p1z19"/>accepi.</s>
					<s n="9" xml:lang="la">Si quid d[ominatio] t[ua] habet, ab illa lubenter audiam.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/>Pontifex Romanus in suis promovendis et ad potissimos <lb xml:id="p1z21"/>gradus collocandis curam suam et studium impendit; <lb xml:id="p1z22"/>hoc est enim potissimum et precipuum sedis fundamentum.</s>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z23"/>Bene vale, domine colendissime, et me, quod facis, ama.</s>
				</p>
				<p>
					<s n="12" xml:lang="de">Ex <lb xml:id="p1z24"/><placeName ref="l200">Haltenstein</placeName> die 6. februarii 1561.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z25"/>D[o<lb xml:id="p1z26"/>mi<pb/><lb xml:id="p2z1"/>n<lb xml:id="p2z2"/>atio<lb xml:id="p2z5"/>ni] t[u<lb xml:id="p2z6"/>ae] de[<lb xml:id="p2z7"/>di]tissi<lb xml:id="p2z9"/>mus <persName ref="p8306">I[o<lb xml:id="p2z10"/>annes] <lb xml:id="p2z12"/>Ia[<lb xml:id="p2z13"/>cobus] <lb xml:id="p2z14"/>Decam<lb xml:id="p2z15"/>bray</persName>.</s>
				</p>
				<p>
					<note>[Vor 493 von anderer Hand:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro pietate et <lb xml:id="p4z2"/>eruditione excellenti domino <lb xml:id="p4z3"/><persName ref="p495">Henrico Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p4z4"/>ecclesię ministro, domino et amico <lb xml:id="p4z5"/>suo colendo.</s>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
