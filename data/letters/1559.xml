	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z2"/><persName ref="p8098">Georg, grave zu Würtemberg <lb xml:id="p1z3"/>unnd zu Mümpelgart</persName> etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="de"><lb xml:id="p1z4"/>Unnsern grus zuvor, lieber besonder.</s>
					<s n="3" xml:lang="de"><lb xml:id="p1z5"/>Wir schicken euch hiebey verwart ettliche <lb xml:id="p1z6"/>zeitungen, welche ir nach verle<lb xml:id="p1z7"/>sung uns widerumb fürderlichen<lb xml:id="p1z8"/>n zuschicken wöllendt etc.</s>
					<s n="4" xml:lang="de">Seit gott bevolhen.</s>
					<s n="5" xml:lang="de"><lb xml:id="p1z9"/>Datum <placeName ref="l441">Schaffhausen</placeName> den 4ten febru<lb xml:id="p1z10"/>arij anno etc. 1552.</s>
				</p>
				<p>
					<s n="6" xml:lang="de"><persName ref="p8098">G[eorg] g[rave] z[u] <lb xml:id="p1z11"/>Wyrttemberg</persName> etc.</s>
				</p>
				<p>
					<s n="7" xml:lang="de"><lb xml:id="p1z13"/>Ir möchts wol ettliche verdrutt sehen lassen, <lb xml:id="p1z14"/>doch das sye unß mitt dem ehesten wider <lb xml:id="p1z15"/>zu geschickt werden.</s>
				</p>
				<p>
					<s n="8" xml:lang="de"><pb/><lb xml:id="p2z1"/>Unserm lieben besondernn <lb xml:id="p2z2"/><persName ref="p495">Hainrich Bullinger</persName>, p<lb xml:id="p2z3"/>rediger zu <placeName ref="l587">Zürich</placeName><lb xml:id="p2z5"/>.</s>
				</p>
			</div>
		</body>
	</text>
