	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Gaudium et pacem in Christo.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Incidi hisce diebus <lb xml:id="p1z3"/>in venerandum nostrum senem dominum <persName ref="p1010">Mathiam Erbium</persName>, <lb xml:id="p1z4"/>vir doctissime, quem reperi tristem usque ad mortem <lb xml:id="p1z5"/>ferme; nam vidit ecclesiae, cui hactenus docendo <lb xml:id="p1z6"/>praefuit, insanabile propemodum infligi vulnus.</s>
					<s n="3" xml:lang="la">Ecce <lb xml:id="p1z7"/>advolarunt (proh dolor) ex <placeName ref="l572">Wirttenbergensi</placeName> <lb xml:id="p1z8"/>ducatu duo apostoli, quorum alter viventi <lb xml:id="p1z9"/>Mathiae succederet et esset totius comitatus <lb xml:id="p1z10"/>superintendens, alter vero dominum <persName>Iacobum Milyagrium</persName> <lb xml:id="p1z11"/>quasi expelleret.</s>
					<s n="4" xml:lang="la">Nam uterque, tam <persName>Mathias</persName> quam <lb xml:id="p1z12"/><persName>Iacobus</persName> suam a magistratu, quam hactenus avide <lb xml:id="p1z13"/>expectarunt, accepere sententiam, hic ut omni ex <lb xml:id="p1z14"/>comitatu et ducatu discedat, ille vero ut quidem <lb xml:id="p1z15"/>suo, quo hactenus victitavit, stipendiolo fruatur, <lb xml:id="p1z16"/>sed a concionandi officio desistat.</s>
					<s n="5" xml:lang="la">Haec <lb xml:id="p1z17"/>maximo cum dolore raptim quasi tibi communicar<lb xml:id="p1z18"/>e volui, ut, quo in statu essent ecclesiae nostrae intelligeres <lb xml:id="p1z19"/>et dominum sedulo pro nobis interpellares; summe <lb xml:id="p1z20"/>enim periclitantur.</s>
					<s n="6" xml:lang="la">Dominus deus misereatur nostri.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z21"/>Bene vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Salutato meo nomine omnes fratres et in primis <lb xml:id="p1z22"/>dominum <persName ref="p8011">Ruͦdolphum Waltherum</persName>, cui scripsissem, si per <lb xml:id="p1z23"/>otium licuisset.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Datum raptim <placeName ref="l335">Milthusii</placeName> in <lb xml:id="p1z25"/>aedibus <persName>Finckii</persName>, qui te salvum cupit, 3. augusti.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z26"/>Tui observandissimus <lb xml:id="p1z27"/><persName ref="p8099">Thomas Schöpfius</persName>, d[octor] <lb xml:id="p1z28"/>m[edicinae].</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro eximie docto iuxta et <lb xml:id="p2z2"/>pio domino <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>verbi divini apud <placeName ref="l587">Tigurinos</placeName> <lb xml:id="p2z4"/>praeconi dignissimo, domino et amico <lb xml:id="p2z5"/>suo plurimum colendo.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>