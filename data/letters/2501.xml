	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi heri et hisce diebus tertio abs te literas, atque <lb xml:id="p1z2"/>utinam posteriores non nimis sero venissent!</s>
					<s n="3" xml:lang="la">Ad prio<lb xml:id="p1z3"/>res prius per studiosos nostros respondi.</s>
					<s n="4" xml:lang="la">Ad posteri<lb xml:id="p1z4"/>ores heri demum acceptas respondere nihil possum.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Iam legatus delectus est ad vestros d. <persName ref="p5787">Claudius <lb xml:id="p1z6"/>Mey</persName>.</s>
					<s n="6" xml:lang="la">Quid agant et moliantur nostri, tam me <lb xml:id="p1z7"/>celant omnes, ut facile animadvertam dubiam esse <lb xml:id="p1z8"/>illis meam fidem; aegre ferunt inter nos communicari <lb xml:id="p1z9"/>omnia nec animadvertunt, quantopere expediret mutua <lb xml:id="p1z10"/>haec interdum audire et admittere consilia.</s>
					<s n="7" xml:lang="la">Sic vero <lb xml:id="p1z11"/>suae confisi prudentiae ruunt in eiusmodi delicta, <lb xml:id="p1z12"/>quae sine magna poenitentia elui non possunt.</s>
					<s n="8" xml:lang="la">Qui <lb xml:id="p1z13"/>favent rei, sunt et ipsi nimis publicorum consiliorum <lb xml:id="p1z14"/>tenaces; nostra nec contemnunt nec tamen etiam magni <lb xml:id="p1z15"/>facere videntur.</s>
					<s n="9" xml:lang="la">Dolens haec domino commendo.</s>
					<s n="10" xml:lang="la">Discessisset <lb xml:id="p1z16"/>etiam noster hic me inscio, nisi de eius instantis discessu commone<lb xml:id="p1z17"/>factus aliunde has accelerassem.</s>
					<s n="11" xml:lang="la">Utinam fieri <lb xml:id="p1z18"/>posset, ut nostri per vos inde extrahi iterum, quo pro<lb xml:id="p1z19"/>lapsi sunt, possent!</s>
					<s n="12" xml:lang="la">Tua paucis adhuc communicare po<lb xml:id="p1z20"/>tui propter brevitatem temporis et nescio, quod <lb xml:id="p1z21"/>post dimissum iam legatum efficere possimus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Quod schedulam attinet, quam postremis tuis inseruist<lb xml:id="p1z23"/>i literis de ducenda <persName>Elisabetha</persName>, <persName ref="p18554">Anglię regina</persName>, a <lb xml:id="p1z24"/>principe <placeName ref="l2478">Sabaudo</placeName>, non satis eam intelligo.</s>
					<s n="14" xml:lang="la">Quid enim <lb xml:id="p1z25"/>is duceret illam, quę prius <persName>Philippo Caesaris</persName> <lb xml:id="p1z26"/>desponsata fuit et nuptię quoque in iulio mense, ut <lb xml:id="p1z27"/>audimus, celebratae?</s>
					<s n="15" xml:lang="la">An hic mortuus, an inter<lb xml:id="p1z28"/>cessit divortium, aut quę ratio ducendi illius huic?</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z29"/>Novi nos nihil habemus.</s>
					<s n="17" xml:lang="la"><persName ref="p8292">Zebedaeus</persName> hic est et excusat <lb xml:id="p1z30"/>se non incommode, siquidem sic se res habent.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="farewell">Tu bene <lb xml:id="p1z31"/>vale et, quid illic fiat, edoce me, quaeso; <lb xml:id="p1z32"/>aegre enim hic andagere queo.</s>
					<s n="19" xml:lang="la">Poteris hoc vel per <lb xml:id="p1z33"/>te vel per fratrem praestare.</s>
					<s n="20" xml:lang="la" ana="salute">Saluta eum meo nomine; <lb xml:id="p1z34"/>non enim vacavit, ut ipsi quoque nunc scriberem.</s>
					<s n="21" xml:lang="la"><placeName ref="l41">Bernae</placeName> <lb xml:id="p1z35"/>14. decembris summo mane 54.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z36"/>Tuus <persName ref="p8018">Io[annes] H[allerus]</persName>.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z37"/>Cur non potius legatio a vestris ad nostros diacosios missa est?</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori <lb xml:id="p2z4"/>fidelissimo, domino ac <lb xml:id="p2z5"/>compatri suo ma<lb xml:id="p2z6"/>xime colendo.</s>
				</p>
				<p>
					<s n="25" xml:lang="de"><lb xml:id="p2z7"/>M. <persName ref="p495">Heinrych Bullinger<lb xml:id="p2z8"/>n</persName> zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
