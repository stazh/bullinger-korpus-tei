					<msContents>
						<summary>
							<p xml:id="regest1">Betont die Wichtigkeit einer baldigen Wiederherstellung der Eintracht zwischen <placeName ref="l41" cert="high">Bern</placeName> und <placeName ref="l587" cert="high">Zürich</placeName> und bittet um <persName ref="p495" cert="high">Bullingers</persName> weitere Mithilfe. Wünscht wiederum die Zusendung einiger <persName ref="p495" cert="high">Bullingerschriften</persName> und sendet Nachrichten über <persName ref="p8412" cert="high">Megander</persName> und <persName ref="p7232" cert="high">Wilhelm Zwingli</persName>. Grüße.</p>
						</summary>
						<msItem>
							<textLang>Deutsch</textLang>
						</msItem>
					</msContents>
