	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam a domino, charissime mi <persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><persName ref="p1753">Leonis</persName> in negocio <persName ref="p467">Buceri</persName> <lb xml:id="p1z2"/>amicam dehortationem accepimus<note xml:id="fn1" type="footnote" n="1">Der Brief, in dem <persName ref="p1753">Leo Jud</persName> wie zuvor <persName ref="p495">Bullinger</persName> (vgl. oben <ref target="file11007">Nr. 965</ref>, 2f) die <placeName ref="l41">Berner</placeName> vor einem Verbot von <persName ref="p467">Bucer</persName>-Schriften gewarnt haben muß, ist nicht erhalten.</note>, de qua non opus est multa tibi <lb xml:id="p1z3"/>dicere.</s>
					<s n="3" xml:lang="la">Non multis enim ante diebus mentem nostram accepisti<note xml:id="fn2" type="footnote" n="2">Gemeint ist der Brief vom 8. März, oben <ref target="file11007">Nr. 965</ref>.</note>, licet <lb xml:id="p1z4"/>tumultuarie opera amanuensis<note xml:id="fn3" type="footnote" n="3">Der Brief ist von unbekannter Hand geschrieben.</note>, quando ob capitis fluxum <lb xml:id="p1z5"/>ipse scribere non potui.</s>
					<s n="4" xml:lang="la"><persName ref="p1753">Leo</persName> excusat <persName ref="p467">Bucerum</persName> non dolo, sed <lb xml:id="p1z6"/>zelo omnia egisse.</s>
					<s n="5" xml:lang="la">Nescio, an zelus dici queat ex ipsissima <lb xml:id="p1z7"/>luce aliquem in abstrusissimas tenebras pertrahere velle, <lb xml:id="p1z8"/>quod egit <persName ref="p467">Bucerus</persName>.</s>
					<s n="6" xml:lang="la">Si non satis esse videtur, expectemus, <lb xml:id="p1z9"/>obsecro, paulisper, donec satis faciat, id quod haud dubie <lb xml:id="p1z10"/>brevi futurum est.</s>
					<s n="7" xml:lang="la">At sine vobis nihil tentabimus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell"><pb type="edition" next="98"/>Bene <lb xml:id="p1z11"/>vale salvis omnibus fratribus, <persName ref="p8171">Theodoro</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p8171">Theodor Bibliander</persName>.</note>, <persName ref="p8127">Bellicano</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p8127">Konrad Pellikan</persName>.</note>, <persName ref="p8364">Beato</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p8364">Beat Gering</persName>.</note>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l41">Bernę</placeName>, <lb xml:id="p1z12"/>marcii 11. anno 37.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p8412">Megander</persName> tuus totus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinrico Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tiguri</placeName> Christum profitenti, <lb xml:id="p2z3"/>fratri suo in domino charissmo.</s>
				</p>
			</div>
		</body>
