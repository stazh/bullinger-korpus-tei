	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Per studiosum quendam vestrum proximas meas dedi, quae redditas <lb xml:id="p1z2"/>esse arbitror tibi.</s>
					<s n="3" xml:lang="la">Interim nihil magnopere certi saltem allatum est; nam id, <lb xml:id="p1z3"/>quod nostris significatum est aliunde, nescio quam sit probabile, nedum certum.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Sed quod nihil quam libet iniquum absurdumque non fieri soleat aliquando, nolui et <lb xml:id="p1z5"/>hoc ipsum te celare.</s>
					<s n="5" xml:lang="la">Primum vero est, quod scribitur pacem inter <persName ref="p18538">Caesarem</persName> et <lb xml:id="p1z6"/><persName ref="p8112">Gallum</persName> coiisse, deinde eundem imperatorem cum <persName ref="p18477">Ferdinando</persName> in solidam rediisse <lb xml:id="p1z7"/>gratiam professumque aperte tantum abesse, ut filio moliatur imperii successionem, <lb xml:id="p1z8"/>ut pro ea in Maximilianum devolvenda se intercessorem futurum, <lb xml:id="p1z9"/>ut qui id unum prae rebus omnibus cupiat.</s>
					<s n="6" xml:lang="la">Caeterum quod conciliationem <lb xml:id="p1z10"/>inter <persName>Augustum</persName> <persName ref="p8371">Albertumque</persName> attinet, Caesaris eiusdem instigatu diruptam <lb xml:id="p1z11"/>esse, quod praeter officium dixerit <persName>Augustum</persName> cum eo transegisse hoste, <lb xml:id="p1z13"/>cuius manus fratris eius madeant sanguine.</s>
					<s n="7" xml:lang="la">Nihilo tamen secus <lb xml:id="p1z14"/>et imperatorem ipsum apertis subsidiis iuvare <persName ref="p8371">Albertum</persName> in obtinendis iis, quae <lb xml:id="p1z15"/>requirat ab episcopis, ut qui iam postulationem (quam nosti) ratam esse velit.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Comicia moliri et aliquot cohortes <placeName ref="l875">Hispanorum</placeName> iam nunc passim disposuisse, <lb xml:id="p1z17"/>nimirum ut pro more dictet ordinibus sententiam tollatque suffragiorum <lb xml:id="p1z18"/>libertatem.</s>
					<s n="9" xml:lang="la">Quae si vera sunt omnia, quis dubitabit artibus <placeName ref="l875">Hispanicis</placeName> <lb xml:id="p1z19"/>supplantatam adeoque et proditam iri miseram Germaniam et iam ante plus <lb xml:id="p1z20"/>quam semiservam.</s>
					<s n="10" xml:lang="la">Orandus est dominus, ut misereatur sanctorum suorum.</s>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z21"/>Bene vale in Christo Iesu cum symmistis tuis et cumprimis uxore <lb xml:id="p1z22"/>et familia.</s>
					<s n="12" xml:lang="la"><placeName ref="l28">Basileae</placeName> 25. novembris anno 1553.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z23"/>T[uus] <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo <lb xml:id="p2z2"/>d. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>domino et fratri suo <lb xml:id="p2z4"/>observando.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l587">Tig[uri]</placeName>.</s>
				</p>
