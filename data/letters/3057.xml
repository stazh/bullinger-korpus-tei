	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">De <placeName ref="l619">Bavarica</placeName> idem sentis, quod ego; artificium Satanae novum <lb xml:id="p1z2"/>est, ut linguae vernaculae obtentu tegatur impietas eoque noceat impensius.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Sed prodetur et haec larva sicut paulo ante interimistica.</s>
					<s n="4" xml:lang="la">Comicia <lb xml:id="p1z4"/><placeName ref="l410">Ratisbonensia</placeName> processura feruntur; adventum enim suum <persName ref="p18477">Ferdinandus</persName> promisit <lb xml:id="p1z5"/>ad ultimum novembris et instanter hortatur principes electores et caeteros, <lb xml:id="p1z6"/>ut et ipsi compareant, potissimum vero <placeName ref="l2477">Palatinum</placeName> electorem, quod privatim <lb xml:id="p1z7"/>cum eo cupiat de rebus magnis conferre.</s>
					<s n="5" xml:lang="la">Bellum <placeName ref="l2574">Liflandicum</placeName> et <lb xml:id="p1z8"/><placeName>Bruttoum</placeName> sedatum est; sed adparatus bellici interim et magni <lb xml:id="p1z9"/>et variis in locis.</s>
					<s n="6" xml:lang="la"><placeName ref="l302">Lubecenses</placeName> hostiliter impetuntur a quibusdam prae<lb xml:id="p1z10"/>donibus, quibus aliunde suppeditantur auxilia.</s>
					<s n="7" xml:lang="la"><placeName ref="l427">Rostochium</placeName> vero a <lb xml:id="p1z12"/>duce <placeName ref="l701">Mechelburgensi</placeName> ob nescio quas inusitatas exactiones <note type="misc">[übergeschr. "affligitur" gestrichen]</note> aliive <lb xml:id="p1z13"/>complures ad mare Balticum.</s>
					<s n="8" xml:lang="la"><placeName ref="l1041">Brunsvicensis</placeName> conflat equitum peditumque <lb xml:id="p1z14"/>iustum exercitum; sed quo intendat, ignoratur videnturque ad tumultus <lb xml:id="p1z15"/>spectare omnia, quod id mereatur prodigiosa mundi ingratitudo pacis bono <lb xml:id="p1z16"/>ad praefatam tantum licentiam abutentis.</s>
					<s n="9" xml:lang="la">Nos, qui domi secure degere <lb xml:id="p1z17"/>poteramus, exigua invitati pecunia bella alibi quęrimus accersimusque <lb xml:id="p1z18"/>sanguinis reatum in nostra et posterorum capita.</s>
					<s n="10" xml:lang="la">Captivi tenemur foedere <lb xml:id="p1z19"/>male sarto et multos per cętera pellicit insana bellandi libido; <lb xml:id="p1z20"/>dicas iurass<lb xml:id="p1z21"/>e in <lb xml:id="p1z22"/>proprium exi<lb xml:id="p1z23"/>cium pl<lb xml:id="p1z24"/>eros<lb xml:id="p1z25"/>que.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Bene vale in Christo Iesu cum tuis omnibus.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z26"/><placeName ref="l28">Basileae</placeName> calendis decembris anno 1556.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z27"/>T[uus] <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, domino et <lb xml:id="p2z3"/>fratri colendissimo et charissimo <lb xml:id="p2z4"/>suo.</s>
				</p>
			</div>
		</body>
	</text>
