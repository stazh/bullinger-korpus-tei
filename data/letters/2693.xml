	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Quod t. h. mihi ignoto in oras tam remotas mittere <lb xml:id="p1z3"/>litteras non intermiserit, ei gratias quas possum ago ha<lb xml:id="p1z4"/>beoque maximas, pręsertim cum te in eam de me opinionem <lb xml:id="p1z5"/>duci videam, me sc. singulari amore ac benevolentia <lb xml:id="p1z6"/>prosequi huius ordinis viros, qui pietatis studiosi syncerique <lb xml:id="p1z7"/>dei cultores sint.</s>
					<s n="3" xml:lang="la">De propensi ac benevoli itaque tui erga <lb xml:id="p1z8"/>me animi declaratione te multum amo in hoc amicitiae <lb xml:id="p1z9"/>nostrae initio, quam contractam tam ratam ac firmam fieri <lb xml:id="p1z10"/>aveo, ut in dies magis ac magis inter nos crescat atque <lb xml:id="p1z11"/>augeatur occasionemque dari mihi velim, qua t. h. mea <lb xml:id="p1z12"/>opera ac industria hoc benemerendi studium recompensare <lb xml:id="p1z13"/>pro voto h. t. possim.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z14"/>Munus, nempe libellum mihi a te missum, grato animo hilarique <lb xml:id="p1z15"/>fronte suscipio ac veneror, cum quod sinceriter christiane religionis <lb xml:id="p1z16"/>dogmata tractat, tum etiam quod specimen ac testi<lb xml:id="p1z17"/>monium tui erga me animi ac voluntatis continet.</s>
					<s n="5" xml:lang="la">Me igitur <lb xml:id="p1z18"/>tibi, vir excellens, humanissimeque commendo omniaque studia <lb xml:id="p1z19"/>atque officia, quibuscunque gratificari t. h. possim, polliceor et promit<lb xml:id="p1z20"/>to.</s>
					<s n="6" xml:lang="la">Datae in <placeName ref="l318">Melschtin</placeName> 20. augusti anno 1555.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">V. <lb xml:id="p1z21"/>h. amicus ex an<lb xml:id="p1z22"/>imo<note xml:id="fn1" type="footnote" n="1"><hi>Eigenhändig.</hi></note>.</s>
					<s n="8" xml:lang="la"><persName ref="p1752">Spithek Jordan</persName> de <placeName ref="l576">Zaliczin</placeName> et in <lb xml:id="p1z23"/><placeName ref="l318">Melschtin</placeName> haeres Pallatinus <placeName>Sen<lb xml:id="p1z24"/>domiriensis</placeName> <placeName>Premisliensis</placeName> <placeName>Kamiona<lb xml:id="p1z25"/>censis</placeName> capitaneus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z26"/>Idem qui supra subscripsit.</s>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximiae pietatis <lb xml:id="p2z2"/>viro domino <persName ref="p495">Henricho <lb xml:id="p2z3"/>Bulingero</persName> Tu[...]i<lb xml:id="p2z4"/>nę ecclesiae pa[...] <lb xml:id="p2z5"/>et amico long<lb xml:id="p2z6"/>e observandissimo<note xml:id="fn2" type="footnote" n="2"><hi>Eigenhändig.</hi></note>.</s>
				</p>
			</div>
		</body>
	</text>
