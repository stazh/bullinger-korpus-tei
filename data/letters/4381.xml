	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Ne nihil ad te darem, mi venerande charissimeque frater, <lb xml:id="p1z2"/>visum est scriptum <persName ref="p2899">Schenckii</persName> nostri adversus ubiquitarios suos mittere <lb xml:id="p1z3"/>missurus etiam horum contra illum defensionem, ni tergiversator iste <lb xml:id="p1z4"/><persName ref="p1227">Christophorus</persName> astuto valde consilio exhibere hanc perpetuo detrectaret.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z5"/>Sed pertrahetur tamen brevi ad lucem, a qua etiam, ut debet, clarissime <lb xml:id="p1z6"/>a<lb xml:id="p1z7"/>rguetur.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Mitto autem etiam <persName ref="p1754">Iungii</persName> nostri heri mihi redditam epistolam, ut legas, in <lb xml:id="p1z8"/>illa si quid forte insit hactenus tibi (quod haud credo) incognitum; <lb xml:id="p1z9"/>lecta, ubi vacabit, remittes.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="salute">Bene vale Christo nos diligenter commendans.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/><placeName ref="l555">Vituduri</placeName>, 5. augusti 1560.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Proxime remittam libellum supplicem.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>T[uus] <persName ref="p8055">Ambr[osius] Bl[aurerus]</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Bullingero</persName> suo.</s>
				</p>
			</div>
		</body>
	</text>
