	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Dedi in mandatis huic domestico meo e <placeName ref="l832">Gallia</placeName> <lb xml:id="p1z2"/>redeunti et <placeName ref="l98">Curiam</placeName> proficiscenti, d[ominationem] t[uam] ut invisat eamque <lb xml:id="p1z3"/>certiorem reddat earum rerum, quę et in curia regis <lb xml:id="p1z4"/>nostri (illic enim fuit) intellexit et in via.</s>
					<s n="3" xml:lang="la">Huc enim <lb xml:id="p1z5"/>ruri, ubi animi gratia per aliquot dies me recepi, nihil <lb xml:id="p1z6"/>novi est p[ietate] t[ua] dignum.</s>
					<s n="4" xml:lang="la">Ab ea autem expecto litteras, <lb xml:id="p1z7"/>quę me de sua valetudine, rebus suis et sua erga <lb xml:id="p1z8"/>me amicitię perseverantia certiorem reddant.</s>
					<s n="5" xml:lang="la">Cui <lb xml:id="p1z9"/>interim omnia felicia opto eique me totum offero et <lb xml:id="p1z10"/>commendo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ex rure meo <placeName ref="l467">Solangio</placeName> duodecima martii 1561.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>Brevi curiam regis nostri revertor indeque sępius ad p[ietatem] t[<lb xml:id="p1z12"/>uam] scribam et penas negligentię meę et tarditatis <lb xml:id="p1z13"/>preteritę persolvam.</s>
					<s n="8" xml:lang="la">D[<lb xml:id="p1z14"/>ominationis]<note type="misc">od. P(ietatis)?</note> t[uae] <lb xml:id="p1z15"/>deditissimus <persName ref="p8306">J. Ja. Cambrayus</persName><note type="misc">vor 496</note>.</s>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro domino <lb xml:id="p4z2"/><persName ref="p495">Henrico Bulingero</persName>, ecclesiae <lb xml:id="p4z3"/><placeName ref="l587">Tigurinae</placeName> ministro dignissimo <lb xml:id="p4z4"/>et amico charissimo<lb xml:id="p4z5"/>.</s>
					<s n="10" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note type="author">[von anderer Hand; Bemerkung von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="11" xml:lang="la">D. <persName ref="p8306">Ioannis Jacobi <lb xml:id="p4z6"/>Kambray</persName>, <placeName ref="l832">Galli</placeName> <lb xml:id="p4z7"/>lega<lb xml:id="p4z8"/>ti.</s>
				</p>
			</div>
		</body>
	</text>
