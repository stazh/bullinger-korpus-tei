	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Hoc vesperi, compater in domino charissime, a charissimo <lb xml:id="p1z2"/>fratre et compatre meo d. <persName ref="p8018">Hallero</persName> accepi, quod <lb xml:id="p1z3"/>ad dominum questorem <persName ref="p8012">Sulpicium Hallerum</persName> et ad antesignanum <lb xml:id="p1z4"/><persName ref="p8389">Hagium</persName> de augendo mihi salario scripseris.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Habeo <lb xml:id="p1z5"/>ob hanc tibi humanitatem iam aliquoties in hac <lb xml:id="p1z6"/>causa declaratam, quas possum maximas gratias.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Psalterium meum nuncupavi reipublicę isti; ubi <lb xml:id="p1z8"/>illud absolutum dabitur, erit forsan occasio hac de <lb xml:id="p1z9"/>re aliquid agendi.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Domus mea peste laborat iam duas septimanas.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/><persName ref="p20957">Sara</persName> mea 20. huius mensis obdormivit in domino.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/><persName>Nicolaus</persName>, nepos ex fratre, quintadecima laborare <lb xml:id="p1z13"/>coepit peste, sed per gratiam domini convaluit; consi<lb xml:id="p1z14"/>militer et <persName>Ester</persName> 22. mane peste correpta adhuc <lb xml:id="p1z15"/>cum carbunculis, quos in sinistra coxendice <lb xml:id="p1z16"/>quatuor habet, conflictatur; spes tamen est eva<lb xml:id="p1z17"/>suram gratia domini.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z18"/>Quę ad me per <placeName ref="l882">Hungaros</placeName> sunt scripta, hic <lb xml:id="p1z19"/>mitto.</s>
					<s n="9" xml:lang="la">Rogarunt amici quidam ex <placeName ref="l18">Augustanis</placeName>, ut <lb xml:id="p1z20"/>publicarem.</s>
					<s n="10" xml:lang="la">Mirabilis est cursus verbi dei.</s>
					<s n="11" xml:lang="la">Det dominus, <lb xml:id="p1z21"/>ne illo privemur.</s>
					<s n="12" xml:lang="la">De <placeName ref="l303">Magdeburgensibus</placeName> ipse scis, <lb xml:id="p1z22"/>quomodo sint obsidione cincti.</s>
					<s n="13" xml:lang="la">Rex <placeName ref="l2472">Polonię</placeName> duas <lb xml:id="p1z23"/>cohortes militum nihil obstante obsidione intromisit; <lb xml:id="p1z24"/>deinde cives eruperunt in monasterium quoddam, <lb xml:id="p1z25"/>ubi capitanei hostium convivaturi et genio <lb xml:id="p1z26"/>habenas daturi erant et cunctos occiderunt.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z27"/>Haec ad me <persName ref="p2916">Schertlinus</persName>.</s>
					<s n="15" xml:lang="la" ana="farewell">Optime vale, compater <lb xml:id="p1z28"/>in domino charissime.</s>
					<s n="16" xml:lang="la" ana="salute">Salutem tuis omnibus, dominis etiam <lb xml:id="p1z29"/>et fratribus d. <persName ref="p8171">Theodoro</persName>, <persName ref="p8127">Pellicano</persName>, <persName ref="p8011">Gvalthero</persName>.</s>
					<s n="17" xml:lang="de"><lb xml:id="p1z30"/><placeName ref="l41">Bernę</placeName> 28. novembris 1550.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><persName ref="p8417">W[o<lb xml:id="p1z31"/>lfgangus] Musc[ulus]</persName>, com<lb xml:id="p1z32"/>pater tuus <lb xml:id="p1z33"/>in domino.</s>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Excellenti theologo <lb xml:id="p2z2"/>m. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae antistiti <lb xml:id="p2z5"/>vigilantissimo, <lb xml:id="p2z6"/>d. et compatri <lb xml:id="p2z7"/>suo longe ch<lb xml:id="p2z8"/>arissimo.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z9"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
