	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Commendasti mihi non ita pridem optimum <lb xml:id="p1z2"/>virum d. <persName>Ioannem Baptistam a Pyro</persName>, <placeName ref="l93">Clavenensem</placeName> signi<lb xml:id="p1z3"/>ferum.</s>
					<s n="3" xml:lang="la">Eum, quantum potui, iuvi, maxime scripta <lb xml:id="p1z4"/>ad rempublicam <placeName ref="l41">Bernatum</placeName> supplicatione petens com<lb xml:id="p1z5"/>mendationem ad senatum <placeName ref="l98">Curiensem</placeName> et dominos <placeName>3 Ligarum</placeName>.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Impetravi illam bona gratia; uterque enim consul et <lb xml:id="p1z7"/>quaestores mihi sunt ex ipsorum humanitate ami<lb xml:id="p1z8"/>cissimi.</s>
					<s n="5" xml:lang="la">Iussit autem, si quid impetrem, tibi <lb xml:id="p1z9"/>submittam et d. <persName ref="p3958">Willio</persName>, amplissimo viro.</s>
					<s n="6" xml:lang="la">Scripsi <lb xml:id="p1z10"/>ergo literas ad d. <persName ref="p3958">Willium</persName> et inclusi eis <placeName ref="l41">Bernatum</placeName> <lb xml:id="p1z11"/>literas petens ab ipso, ut fideliter et prudenter cum <lb xml:id="p1z12"/>eis agat.</s>
					<s n="7" xml:lang="la">Tu quoque agito tuum hac in re officium; <lb xml:id="p1z13"/>puto quod utrique vestrum ea de re dixit.</s>
					<s n="8" xml:lang="la">Scit <lb xml:id="p1z14"/>d. <persName ref="p3958">Willius</persName>, quid facto opus sit, conducatne, ut <lb xml:id="p1z15"/>ipse literas illas retineat apud se, donec d. <persName>Ioannes <lb xml:id="p1z16"/>Baptista a Pyro</persName> <placeName ref="l98">Curiam</placeName> veniat et ipse literas tradat <lb xml:id="p1z17"/>a d. <persName ref="p3958">Willius</persName> tradat.</s>
					<s n="9" xml:lang="la">Scripsi etiam ad <lb xml:id="p1z18"/>ipsum <persName>a Pyro</persName> hac de re et oro, ut mature <lb xml:id="p1z19"/>literas cures ad ipsum perferri, quas tuis inclu<lb xml:id="p1z20"/>si.</s>
					<s n="10" xml:lang="la" ana="salute">Non potui hoc negotium fidelius et dili<lb xml:id="p1z21"/>gentius curare; proinde tu quoque ora illum, ut boni <lb xml:id="p1z22"/>consulat, et saluta omnes amicos.</s>
				</p>
				<p>
					<s n="11" xml:lang="de">G<lb xml:id="p1z23"/>ewüsse zytung uß <placeName ref="l832">Franckrych</placeName> vomm 12. augusti <lb xml:id="p1z24"/>biß an 16. deßselben monats tag: Zuͦ <placeName ref="l1867">Pontyrers</placeName> <lb xml:id="p1z25"/>in der statt ligend 2 junge <persName>Gwysa</persName>, h[err] <persName>Mont<lb xml:id="p1z26"/>pensier</persName>, vil herren, ritter und adels sampt 6000 <lb xml:id="p1z27"/>guͦter kriegslüten und nitt minder schuffelpuren, gräben <lb xml:id="p1z28"/>und weerinen uffzuͦwerfen etc.</s>
					<s n="12" xml:lang="de">Und diewyl so <lb xml:id="p1z29"/>vil volcks in der statt, habend sy mangel an proviandt.</s>
					<s n="13" xml:lang="de"><lb xml:id="p1z30"/>Der admiral hat s[ hert belägeret mitt des königs <lb xml:id="p1z31"/>geschütz, das er gewunnen, und mit 12000 pferden <lb xml:id="p1z32"/>und 25000 zuuͦ fuͦß; hat s] an zwey orten zum sturm <lb xml:id="p1z33"/>beschossen, zum sturm 3000 stigleytern gerüst; <lb xml:id="p1z34"/>hat inen das wasser abgraben und anderschwo<lb xml:id="p1z35"/>hin geleytet; hatt alle straassen und päß zuͦ und <lb xml:id="p1z36"/>von inen verlegt.</s>
					<s n="14" xml:lang="de">Der jung <persName>von Molüch</persName> hat <lb xml:id="p1z37"/>mitt 1200 hinyn gewöllen, ist gefangen und sin <lb xml:id="p1z38"/>volck geschlagen.</s>
				</p>
				<p>
					<s n="15" xml:lang="de">Der könig rüst sich zuͦ <placeName ref="l1497">Thurß</placeName>; <lb xml:id="p1z39"/>sin bruͦder ist da by imm.</s>
					<s n="16" xml:lang="de">Sin frömb[d] volck, <placeName ref="l822">tütsche</placeName> <lb xml:id="p1z40"/>rüter und <placeName ref="l862">eydgnossen</placeName>, ligend noch zuͦ <placeName>Losches</placeName>, wartend <lb xml:id="p1z41"/>uff den anzug des königs.</s>
				</p>
				<p>
					<s n="17" xml:lang="de">Des königs bruͦder ist <pb/><lb xml:id="p2z1"/>mit dem <persName ref="p20980">Aumala</persName> gar übel zuͦfriden, das er die <lb xml:id="p2z2"/>tütschen rüter über so vil päß und wasser her<lb xml:id="p2z3"/>yn in <placeName ref="l832">Franckrych</placeName> gelassen, das <persName ref="p20980">Aumala</persName> ab dem <lb xml:id="p2z4"/>hoff ist, und hept der cardinal, sin bruͦder, [an] ouch nitt <lb xml:id="p2z5"/>fast werd syn.</s>
					<s n="18" xml:lang="de">So vil der nüwen zytung.</s>
					<s n="19" xml:lang="de"><lb xml:id="p2z6"/>Jetzund aber kumpt wyter geschrey, doch zwyspälltig, <lb xml:id="p2z7"/>das erst: der admiral habe ungeschafft mitt schanden <lb xml:id="p2z8"/>und schaden abziehen müssen, das beschähen 27. <lb xml:id="p2z9"/>augusti; das ander: der admiral habe ge<lb xml:id="p2z10"/>wunnen mitt gewallt 28. augusti <placeName ref="l1867">Pontiers</placeName>, habe <lb xml:id="p2z11"/>darinn das kriegsvolck erschlagen und gefangen, item <lb xml:id="p2z12"/>den jüngern <persName>Gwysa</persName> und <persName>Montpensier</persName> amm sturmm <lb xml:id="p2z13"/>erschlagen, den ellteren mitt vilen <lb xml:id="p2z14"/>herren und gefangnen gen <placeName ref="l272">Roschellen</placeName> gefürt, und <lb xml:id="p2z15"/>rucke er jetzund mitt allem züg für ein <lb xml:id="p2z16"/>andere statt <placeName ref="l301">Lyen</placeName> etc.</s>
				</p>
				<p>
					<s n="20" xml:lang="de">Doch ist mir der namm em<lb xml:id="p2z17"/>pfallen etc.</s>
					<s n="21" xml:lang="de">Welchs nun war sye, kan ich <lb xml:id="p2z18"/>noch nitt sagen; diewyl aber und die in der <lb xml:id="p2z19"/>statt mitt kriegslüthen und schantzgrebern so <lb xml:id="p2z20"/>wol gefasset sind und der könig da uß sampt <lb xml:id="p2z21"/>sinem bruͦder sich häfftig zuͦ der entschüttung <lb xml:id="p2z22"/>rüst und frilich die herren, so darinn, nitt <lb xml:id="p2z23"/>bald verlassen werdent, sy sich ouch nitt <lb xml:id="p2z24"/>bald uffgäbend, alls die wüssend, woran es <lb xml:id="p2z25"/>inen stadt, ist mins kleinen erachtens <lb xml:id="p2z26"/>dem admiral, so er noch darvor ligt, gefarlich <lb xml:id="p2z27"/>gnuͦg.</s>
					<s n="22" xml:lang="de">Gott wende es zuͦm besten und gäbe ein <lb xml:id="p2z28"/>gnädigen friden, daß das arm <placeName ref="l832">Franckrych</placeName> nitt <lb xml:id="p2z29"/>so jämerlich zerstört werde.</s>
					<s n="23" xml:lang="de">Und so es<note type="margin">a.R.: <placeName ref="l1867">Pontiers</placeName></note> aber <lb xml:id="p2z30"/>gewunnen were, alls viler schryben und sagen <lb xml:id="p2z31"/>hochlich bezügend, gäb es filicht dister ee ein <lb xml:id="p2z32"/>friden.</s>
					<s n="24" xml:lang="de">Den verlyhe gott!</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p2z33"/>Haec habui, quae scriberem.</s>
					<s n="26" xml:lang="la" ana="salute">Nullas a te hodie <lb xml:id="p2z34"/>accepi; si quid habes de <placeName>Mauris</placeName>, <placeName ref="l2510">Turcis</placeName>, <lb xml:id="p2z35"/><placeName ref="l875">Hispanis</placeName> et <placeName ref="l834">Italis</placeName>, communica et saluta <lb xml:id="p2z36"/>d. d. consules<note type="margin">a.R.: coss.</note>, d. <persName ref="p6130">Pontisellam</persName>.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><persName ref="p20473">Ganthnerum</persName> et d. <persName ref="p2776">Ruinellam</persName> cae<lb xml:id="p2z37"/>terosque amicos.</s>
					<s n="28" xml:lang="la"><lb xml:id="p2z38"/>Quae autem nova consignavi, <lb xml:id="p2z39"/>habemus ex <placeName ref="l301">Lugduno</placeName>, <placeName ref="l167">Geneva</placeName>, <placeName ref="l339">Neocomo</placeName>, <placeName ref="l41">Berna</placeName> <lb xml:id="p2z40"/>et nonnullis aliis locis.</s>
				</p>
				<p>
					<s n="29" xml:lang="la" ana="farewell"><lb xml:id="p2z41"/>Vale.</s>
					<s n="30" xml:lang="la">Celerrime <lb xml:id="p2z42"/>scripsi.</s>
					<s n="31" xml:lang="la">16. septembris 1569.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><lb xml:id="p2z43"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="33" xml:lang="la" ana="salute">Amici te <lb xml:id="p2z44"/>et inprimis <lb xml:id="p2z45"/><persName ref="p1012">Ernius</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p1012">Leonhard Erni</persName>.</note> noster te salutat.</s>
				</p>
				<p>
					<s n="34" xml:lang="la">Pio et <pb/><lb xml:id="p4z1"/>erudito viro d. <persName ref="p8016">Tobiae <lb xml:id="p4z2"/>Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p4z3"/>ecclesiae fideli ministro, <lb xml:id="p4z4"/>domino meo <lb xml:id="p4z5"/>honorando et frat<lb xml:id="p4z6"/>ri dilecto.</s>
				</p>
				<p>
					<s n="35" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
