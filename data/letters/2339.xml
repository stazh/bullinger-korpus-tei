	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia Christi tecum.</s>
					<s n="2" xml:lang="la">Ecce fortunę <lb xml:id="p1z2"/>casum mirabilem.</s>
					<s n="3" xml:lang="la">Dum tę redduntur <lb xml:id="p1z3"/>per nuntium, qui nomine parentis <lb xml:id="p1z4"/><persName>Ioannis Schimidii</persName> apud vos egerat, astabat <lb xml:id="p1z6"/>mihi tum alias nuntius, qui crastino <lb xml:id="p1z7"/>ad vos profecturus rogabat, ut, si <lb xml:id="p1z8"/>quid illuc expeditum velim, diligenter <lb xml:id="p1z9"/>curaturum.</s>
					<s n="4" xml:lang="la">Ago vero tibi gratias pro fratern<lb xml:id="p1z10"/>a illa sollicitudine, qua angeris meo <lb xml:id="p1z11"/>nomine.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Dominus sua solita clementia, quem <lb xml:id="p1z12"/>tot donis spiritus sancti obruit, liberet ab omnibus <lb xml:id="p1z13"/>languoribus quę impediunt tuos labores <lb xml:id="p1z14"/>pro ecclesia dei.</s>
					<s n="6" xml:lang="la">Diem domini instare quis <lb xml:id="p1z15"/>dubitet, quando iniquitas ubundet charitate <lb xml:id="p1z16"/>neglecta et omnium vitiorum <persName>Lerna</persName> regnante.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/><persName>Heinius</persName> scribę nullos misit libellos, <lb xml:id="p1z18"/>item et fratres librum De iustificatione <lb xml:id="p1z19"/>non receperunt; quidam ex fratribus iam emerunt <lb xml:id="p1z20"/><placeName ref="l491">Argentorati</placeName>.</s>
					<s n="8" xml:lang="la">Tu ergo aut potius <lb xml:id="p1z21"/><persName>Heinius</persName> noster videatis, cui sint com<lb xml:id="p1z22"/>missi.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Scriberem nova, sed nihil novum [sub] <lb xml:id="p1z23"/>sole.</s>
					<s n="10" xml:lang="la">Omnia bellis fervent innotuit unum <lb xml:id="p1z24"/>nimirum marchionem <persName ref="p19117">Alberthum a Br[un]<lb xml:id="p1z25"/>schwigio</persName> profligatum, <persName>Brunschwigium</persName> v[ero] <lb xml:id="p1z26"/>duci <persName>Christophoro</persName> bellum indixisse, sed <lb xml:id="p1z27"/>negotium per quosdam principes in aliud tempus <lb xml:id="p1z28"/>dilatum componetur forte.</s>
					<s n="11" xml:lang="la">In maio fuit <lb xml:id="p1z29"/>conventus Saxonicorum theologorum <placeName ref="l1811">Nauburgi</placeName>; <lb xml:id="p1z30"/>interfuit <persName ref="p2095">Melanchton</persName>.</s>
					<s n="12" xml:lang="la">Condemnatus est <lb xml:id="p1z31"/>rursum <persName ref="p8441">Schwenckfeldius</persName> et decretum est <lb xml:id="p1z32"/>nunquam vel papistica et Interimistica recipi<lb xml:id="p1z33"/>enda, quum tamen utręque superstition s ilhic <lb xml:id="p1z34"/>potenter regnent etc.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Cum larvis <persName ref="p2301">Osiandri</persName> luctantur in <placeName>Bo<lb xml:id="p2z2"/>russia</placeName>; quidam legati ex <placeName ref="l512">Tubinga</placeName> missi, <lb xml:id="p2z3"/>inter quos precipuus est doctor <persName>Iacobus Büerlin</persName>.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z4"/>Si id primo fecissent serio, melius <lb xml:id="p2z5"/>forte haberet negotium; principiis obsta etc.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z6"/>Dominus servabit constantes et vere pietatis <lb xml:id="p2z7"/>cultores.</s>
					<s n="16" xml:lang="la">Amen.</s>
					<s n="17" xml:lang="la">Multi vocati, pauci electi.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="farewell">Vale et ora <lb xml:id="p2z8"/>pro me, quod itidem pro te facturus sum.</s>
					<s n="19" xml:lang="la" ana="farewell">Iterum vale et parce tumultuario calamo.</s>
					<s n="20" xml:lang="de"><placeName ref="l411">Ric<lb xml:id="p2z9"/>henvillę</placeName> 12. iulii 1554.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Tuus <persName ref="p1010">Erbius</persName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Ornatissimo pietatis ac eruditionis <lb xml:id="p2z10"/>viro d. <persName ref="p495">Henricho Bullingero</persName>, antistiti <placeName ref="l587">Tigurino</placeName>, fratri in Christo <lb xml:id="p2z11"/>obs<lb xml:id="p2z12"/>ervando.</s>
				</p>
			</div>
		</body>
	</text>
