	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Per dies 14 nihil tuae pietati scripsi di<lb xml:id="p1z2"/>lectissi[mae], quia vicissim a te nihil accepi nec <lb xml:id="p1z3"/>te dignum aliquid habui.</s>
					<s n="3" xml:lang="la">Nunc quae hisce <lb xml:id="p1z4"/>diebus accepi ex <placeName ref="l2472">Polonia</placeName> communico tum ea, <lb xml:id="p1z5"/>quae de rebus <placeName ref="l832">Gallicis</placeName> certa esse puto.</s>
					<s n="4" xml:lang="la">Vereor val<lb xml:id="p1z6"/>de, ne rursus sit descendendum in harenam<note xml:id="fn1" type="footnote" n="1"><bibl source="b56">Adagia</bibl> 1, 9, 83 (<bibl>ASD</bibl> II/2 396, Nr. 883).</note> et <lb xml:id="p1z7"/>pugnandum.</s>
					<s n="5" xml:lang="la">Quando tandem satis fusum sanguinis?</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Sed nequit cardinalis <placeName ref="l691">Lothari[ngius]</placeName> saciari saguine.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z9"/>Dominus illi rependat et nobis pacem <lb xml:id="p1z10"/>concedat, licet videamur mereri dira et plurima <lb xml:id="p1z11"/>supplicia!</s>
					<s n="8" xml:lang="la">Ego utcunque valeo et laboribus <lb xml:id="p1z12"/>perpetuis magis magisque non fatigor tantum, <lb xml:id="p1z13"/>sed et paulatim frangor vires nihilominus domino <lb xml:id="p1z14"/>mihi suppeditante, ut aliquousque repam et <lb xml:id="p1z15"/>faciam, quod possum.</s>
					<s n="9" xml:lang="la">Dominus misereatur mei et omnium <lb xml:id="p1z16"/>suorum fidelium!</s>
					<s n="10" xml:lang="la">Si quid habes de rebus <lb xml:id="p1z17"/><placeName ref="l522">Venetorum</placeName> et <placeName ref="l834">Italiae</placeName>, de pace vel bello, communica.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z18"/>Mirum est tam ferventia belli initia adeo nihil pro<lb xml:id="p1z19"/>gredi et fieri tepida adeoque nulla.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Saluta <lb xml:id="p1z20"/>d. d. consules, d. <persName ref="p1770">Gregorium Carlium</persName>, <persName ref="p6130">Pontisellam</persName> et symmystas.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/>Si reciperetur d. <persName ref="p8057">Ulrychus Campellus</persName>, optime factum putarem.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z22"/>Ego iam a te copiosas expecto.</s>
					<s n="15" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z23"/>Anno domini 1570.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z25"/>Polonica mittam deo volente post <lb xml:id="p1z26"/>octiduum; quod enim tibi destinaram <lb xml:id="p1z27"/>exemplum, sustulit alius, ut aliud <lb xml:id="p1z28"/>oporteat describi, quod hodie fieri <lb xml:id="p1z29"/>non potuit.</s>
					<s n="19" xml:lang="la">Boni ergo consulas, oro.</s>
					<s n="20" xml:lang="de"><lb xml:id="p1z30"/>Ich vermeint, ich häts an der <lb xml:id="p1z31"/>hand; so hats ein anderer vertragen, <lb xml:id="p1z32"/>wie es mir offt beschicht etc.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z33"/>30. iunii.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatiss<lb xml:id="p2z2"/>imo v<lb xml:id="p2z3"/>ir<lb xml:id="p2z4"/>o d. <persName ref="p8016">Tob<lb xml:id="p2z5"/>iae Egli<lb xml:id="p2z6"/>o</persName>, <placeName ref="l98">Curi<lb xml:id="p2z7"/>ensis</placeName> eccle<lb xml:id="p2z8"/>s<lb xml:id="p2z9"/>iae fi<lb xml:id="p2z10"/>de<lb xml:id="p2z11"/>li minis<lb xml:id="p2z12"/>tr<lb xml:id="p2z13"/>o, <lb xml:id="p2z14"/>domino <lb xml:id="p2z15"/>hono<lb xml:id="p2z16"/>rando <lb xml:id="p2z21"/>et <lb xml:id="p2z22"/>fra<lb xml:id="p2z23"/>tri <lb xml:id="p2z24"/>dile<lb xml:id="p2z26"/>ct<lb xml:id="p2z27"/>o.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p2z28"/>Chur.</s>
				</p>
			</div>
		</body>
	</text>
