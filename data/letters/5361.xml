	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. <lb xml:id="p1z2"/>P. D.</s>
					<s n="2" xml:lang="la">Redit ad vos <persName>Io. Henricus</persName>.</s>
					<s n="3" xml:lang="la">Quem mihi vestris literis com<lb xml:id="p1z3"/>mendastis.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Is sane apud nos honestissime se gessit.</s>
					<s n="5" xml:lang="la">Equidem <lb xml:id="p1z4"/>optassem illius et vestra causa plura efficere, sed non semper <lb xml:id="p1z5"/>optatis successus respondent.</s>
					<s n="6" xml:lang="la">Quod ad me attinet, nunquam <lb xml:id="p1z6"/>sane isthinc aliquis veniet mihi per vos commendatus, quin <lb xml:id="p1z7"/>sit futurus longe gratissimus.</s>
					<s n="7" xml:lang="la">Quare de meo erga vos anim<lb xml:id="p1z8"/>o et voluntate nunquam addubitetis.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Tibi et ecclesiis ve<lb xml:id="p1z9"/>stris ut omnia prospera et foelicia succedant, cupio et exopto.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z10"/>Nec plura in presentia.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale et salve cum universo <lb xml:id="p1z11"/>piorum cętu.</s>
					<s n="11" xml:lang="la"><placeName ref="l296">Londini</placeName>, 10 die iunii, 1562.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z12"/>Tuę pietati <lb xml:id="p1z13"/>addictissimus, <lb xml:id="p1z14"/><persName ref="p8026">F. <lb xml:id="p1z15"/>Bed<lb xml:id="p1z16"/>ford</persName>.</s>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, fidelissimo <lb xml:id="p2z3"/>ecclesię <placeName ref="l587">Tigurinę</placeName> ministro.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note type="author">[Vielleicht von <persName>Johannes Heinrich von Ulm</persName> geschrieben (...).]</note>
				</p>
			</div>
		</body>
	</text>
