	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>hilwps vonn gots gnadenn lanndigrave
					<lb xml:id="p1z2"/>zueHessenn grave zue catzenelnpoget etc.
					<lb xml:id="p1z3"/>Unnsernn gnedigenn gruß zuvor wurdiger unnd
					<lb xml:id="p1z4"/>wolgelarter lieber besonnder. Es hatt unnß
					<lb xml:id="p1z5"/>des churfürstenn zue sSachssenn etc. fürnehmer
					<lb xml:id="p1z6"/>rath zever Ulril vo deissenn itzo zugeschickt,
					<lb xml:id="p1z7"/>asermelis churfürstenn gelertenn unnd
					<lb xml:id="p1z8"/>theologenn zue Wittenberg unnd reüptzigs
					<lb xml:id="p1z9"/>ber denn artickell, das heilige nachtiall
					<lb xml:id="p1z10"/>belangenndt für ein bedenckenn gestelt
					<lb xml:id="p1z11"/>unnd sich deßhalbenn mit ain einhelliglichen
					<lb xml:id="p1z12"/>verglichenn, darvonn wir euch hirebey
					<lb xml:id="p1z13"/>Copienn zufertigenn,
					<lb xml:id="p1z14"/>velchs nun vonn
					<lb xml:id="p1z15"/>unnß darumb beschicht, das ir sehet, das
					<lb xml:id="p1z16"/>main h inn allenn kirkenn nicht so feindt
					<lb xml:id="p1z17"/>ist unnd euch lestert unnd verdannet
					<lb xml:id="p1z18"/>unnd dunekt
					<lb xml:id="p1z19"/>unnß sollich des chufürstenn zue Sachssen etc.
					<lb xml:id="p1z20"/>gelertenn unnd theologenn bedenckenn
					<lb xml:id="p1z21"/>sey dermassenn gesteldt, wann drobenn bey
					<lb xml:id="p1z22"/>euch (es muglich uff solliche weiße inn
					<lb xml:id="p1z23"/>etlichenn artickeln darvonn gelert unnd
					<pb/>
					<lb xml:id="p2z1"/>es mit gutsem gewissenn sein kondt, das man
					<lb xml:id="p2z2"/>zue einigkeit unnd vergleichung kommen
					<lb xml:id="p2z3"/>veurede
					<lb xml:id="p2z4"/>begerenn gnediglichenn, ir wollet unnß hirau
					<lb xml:id="p2z5"/>ewer bedenckenn zu erkennenn gebenn.
					<lb xml:id="p2z6"/>dergleichenn auch unß bey diessem unnserm
					<lb xml:id="p2z7"/>bottenn schreibenn. was fürzeittung ir ans
					<lb xml:id="p2z8"/>Franckreich unnd vonn andernn ortenn
					<lb xml:id="p2z9"/>hero, sonnderlich aber des concilii halben
					<lb xml:id="p2z10"/>habt.
					<lb xml:id="p2z11"/>Das wollenn wir zegenn euch inn sondern
					<lb xml:id="p2z12"/>gnadenn erkennen, darum dassell am 23.
					<lb xml:id="p2z13"/>iunii anno dominis 156.
					<lb xml:id="p2z14"/>alics be Hhesen uß
					<pb/>
					<lb xml:id="p4z1"/>dem wurdigenn unnd wolgelarttenn unserm
					<lb xml:id="p4z2"/>liebenn besondernn Heinrich Bullingernn
					<lb xml:id="p4z3"/>Denen den herligenn schniefft zu Zurich.
					<lb xml:id="p4z4"/>
					<lb xml:id="p4z5"/>
				</p>
			</div>
		</body>
