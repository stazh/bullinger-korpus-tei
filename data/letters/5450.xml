	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia filii tecum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Stabant isti... [in] <lb xml:id="p1z2"/>procinctu, nolebant expectare, ut domina scr[iberet].</s>
					<s n="3" xml:lang="la" ana="salute"><lb xml:id="p1z3"/>Salutat proinde te et <persName ref="p8011">Gvaltherum</persName> cum fratribus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Haec nova: aiunt <persName ref="p18538">Caesarem</persName> mortuum et <persName ref="p18575">Phillippum <lb xml:id="p1z5"/>Hispanię</persName> magno exercitu petere <placeName ref="l822">Germaniam</placeName>.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Ecclesia <placeName ref="l411">Richenvillana</placeName> expectat novum visitatorem <lb xml:id="p1z7"/>doctorem <persName ref="p4183">Iacobum Andreę Schmidlium</persName>.</s>
					<s n="6" xml:lang="la">O sancta visitatio!</s>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z8"/>Vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Altera septembris etc.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z9"/>T<lb xml:id="p1z10"/>uus <lb xml:id="p1z11"/><persName ref="p1010">Erbius</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z13"/>Valete omnes in Christo.</s>
				</p>
				<p>
					<s n="11" xml:lang="de"><pb/><lb xml:id="p2z1"/>An den hochgelerten <lb xml:id="p2z2"/>herren <lb xml:id="p2z3"/><persName ref="p495">Hanrichen Bullinger</persName> <lb xml:id="p2z4"/>zu <placeName ref="l587">Zurch</placeName> etc.</s>
				</p>
			</div>
		</body>
	</text>
