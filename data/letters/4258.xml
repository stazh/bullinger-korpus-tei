	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime vir et mihi semper observande.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Salvus redii <placeName ref="l210">Haidelbergam</placeName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Literae omnes a me <lb xml:id="p1z3"/>singulis fideliter sunt traditae.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><persName ref="p20367">Tilemannus</persName> <lb xml:id="p1z4"/>brevi ante abierat <placeName ref="l61">Bremam</placeName> vocatus a <lb xml:id="p1z5"/>senatu illius civitatis.</s>
					<s n="5" xml:lang="la">Statim in primo exor<lb xml:id="p1z6"/>dio cepit ibi novus motus; non voluit reci<lb xml:id="p1z7"/>pi nisi prius extruso <persName>Alberto</persName>; illum vero <lb xml:id="p1z8"/>ecclesia dimittere noluit.</s>
					<s n="6" xml:lang="la">Senatus <placeName ref="l61">Bremensis</placeName> <lb xml:id="p1z9"/>consuluit d. <persName ref="p3590">Philippum</persName>, an propter <persName ref="p8371">Albertum</persName> <lb xml:id="p1z10"/>et <persName ref="p20367">Tilemannum</persName> synodus ibi congreganda.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>Respondit <persName ref="p3590">Philippus</persName> <persName ref="p20367">Tilemannum</persName> non obtemperatu<lb xml:id="p1z12"/>rum ulli synodo, nisi omnes <lb xml:id="p1z13"/>capita <persName ref="p20367">Tilemannica</persName>, ideoque synodus non est <lb xml:id="p1z14"/>congregata.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Manet <persName ref="p8371">Albertus</persName> ibi adhuc; nihil <lb xml:id="p1z15"/>igitur certius est quas novas <persName ref="p20367">Tilemannum</persName> ibidem <lb xml:id="p1z16"/>quoque excitaturum turbas.</s>
					<s n="9" xml:lang="la">Res porro meae <lb xml:id="p1z17"/>dubiae et incertae plane sunt; non sum restitutus, <lb xml:id="p1z18"/>et fiunt quotidie quasi deteriores propter <lb xml:id="p1z19"/>novam commotionem, quae in ecclesia <placeName ref="l210">Heidel<lb xml:id="p1z20"/>bergensi</placeName> de eadem controversia orta est.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Qualis autem illa sit, ex <persName ref="p8111">Petro Martyre</persName> tua <lb xml:id="p1z22"/>humanitas intelliget.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Rogo igitur, ut me tibi <lb xml:id="p1z23"/>commendatum habere pergas.</s>
					<s n="12" xml:lang="la">Intremisco, quoties <lb xml:id="p1z24"/>considero miserum tantae ecclesiae statum, quae ante <lb xml:id="p1z25"/>paucos menses adeo floruit.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Tot sunt <lb xml:id="p1z26"/>occupationes meae, ut scribere res maiores <lb xml:id="p1z27"/>pluribus non possim; spero autem vos propediem <lb xml:id="p1z28"/>visuros impressam historiam eamque iucundam.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z29"/>Tuae literae sunt mihi quarto aprilis oblatae, <lb xml:id="p1z30"/>et quod hactenus non scripserim, causae sunt, <lb xml:id="p1z31"/>quod expectarim, donec de rebus meis certi <lb xml:id="p1z32"/>aliquid possim referre et quod putarim alios <lb xml:id="p1z33"/>iam dudum respondisse.</s>
					<s n="15" xml:lang="la">Caeterum ea, quae dominus <lb xml:id="p1z34"/>iniungit, sedulo effeci, et dominus responsa <lb xml:id="p1z35"/>accipiet, spero, a singulis.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Mei <lb xml:id="p1z36"/>ut memor esse digneris, rogo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Ita fremit <lb xml:id="p1z37"/>Sathan, ut, si multi boni velint mihi opitulari, <lb xml:id="p1z38"/>propter quorundam metum non ausint.</s>
					<s n="19" xml:lang="la">Datae <lb xml:id="p1z39"/><placeName ref="l210">Heidelbergae</placeName> 5. aprilis anno 60.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z40"/>Tuae humanitati(s?) <lb xml:id="p1z41"/>deditissimus <persName ref="p8399">Wilhel[mus] Klebitz</persName>.</s>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo et doctissimo <lb xml:id="p2z2"/>viro <persName ref="p495">Hainrico Bullingero</persName>, <lb xml:id="p2z3"/>domino suo <lb xml:id="p2z4"/>semper observando.</s>
				</p>
			</div>
