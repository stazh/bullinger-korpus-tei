	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">Nihil est, quod ad te scribam nisi votum anni felicissimi et cumulatiorum <lb xml:id="p1z3"/>domini donorum.</s>
					<s n="3" xml:lang="la">Conventus totius <placeName ref="l832">Gallie</placeName> remissus est in mayum mensem.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Visa est bulla illusio nec placet continuatio<note type="misc">Verweisung auf d. Rand, nus... ovum volunt pontificem adesse.</note>.</s>
					<s n="5" xml:lang="la">Oro, ut mittas ad me <lb xml:id="p1z5"/>exemplar eius, quod de consilio scripsisti<note type="misc">HB Bi... I 402</note> ad d. <placeName ref="l1854">Redonensem</placeName> episcopum et que <lb xml:id="p1z6"/>pluribus scribere constitueras, cum essem <placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Non arbitror, quod <lb xml:id="p1z7"/>ii, quos vereris futuri sint quod dicitur fac totum; videtur enim mihi <lb xml:id="p1z8"/>dominus velle adesse <placeName ref="l832">Gallie</placeName> eamque illustrare et lucem suam spargere l<lb xml:id="p1z9"/>atius.</s>
					<s n="7" xml:lang="la">Cum lubet, ignavos, inertes et dormientes excitat, ut suam vim magis <lb xml:id="p1z10"/>exerat.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Fama est voluisse <persName>Philippum</persName> mittere <placeName ref="l875">Hispanos</placeName> in ditiones <placeName ref="l1209">Navarre</placeName> <lb xml:id="p1z11"/>regis.</s>
					<s n="9" xml:lang="la">A comitatu regis <placeName ref="l832">Gallie</placeName> sunt milites omnes dimissi.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Audiemus <lb xml:id="p1z12"/>brevi, quid faciet dominus loquens pacem in suis.</s>
					<s n="11" xml:lang="la">Si quid novi habes, <lb xml:id="p1z13"/>scribes.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Salutabis amicos omnes, praesertim amplissimum senatum.</s>
					<s n="13" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Sol[u<lb xml:id="p1z14"/>turi] 3. ianuarii.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z15"/>Tuus ex animo.</s>
				</p>
				<p>
					<note type="author">[von anderer Hand:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori vigil<lb xml:id="p2z3"/>antissimo.</s>
					<s n="17" xml:lang="la">Tigury.</s>
				</p>
			</div>
		</body>
	</text>
