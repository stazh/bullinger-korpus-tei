	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Tuas desiderio magno expectamus, dilec<lb xml:id="p1z2"/>te frater <persName ref="p540">Calvine</persName>.</s>
					<s n="3" xml:lang="la">Speramus enim te accepis<lb xml:id="p1z3"/>se nostras literas et nostrum intellexisse consilium.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Quae tu in postremis tuis scribebas de adiiciendis <lb xml:id="p1z5"/>nonnullis aliis declarationi nostrae, expen<lb xml:id="p1z6"/>demus ubi habuerimus tuum responsum ultimum.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Tunc enim de omnibus et singulis fiet generalis <lb xml:id="p1z8"/>consultatio.</s>
					<s n="6" xml:lang="la">Mature accipies responsionem et sen<lb xml:id="p1z9"/>tentiam nostram.</s>
					<s n="7" xml:lang="la">Vide autem ut tuas credas <lb xml:id="p1z10"/>nunciis fidelibus.</s>
					<s n="8" xml:lang="la">Videntur enim diu haerere <lb xml:id="p1z11"/>et quasi neglectae iacere in itinere.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z12"/>Hunc D. <persName ref="p2616">Guilhelmum Plancium</persName>, quondam professorem <lb xml:id="p1z13"/><placeName ref="l378">Lutetianum</placeName>, patria <placeName ref="l832">Gallum</placeName>, virum et doctissimum et <lb xml:id="p1z14"/>piissimum tuae humanitati tanquam me ipsum commendo.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z15"/>Vale, una cum fratribus omnibus, praesertim D. <persName ref="p966">Nicolao <lb xml:id="p1z16"/>Gallasio</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 14. augusti anno 1549.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro D. <persName ref="p540">Ioanni <lb xml:id="p2z2"/>Calvino</persName> <placeName ref="l167">Genevensis</placeName> <lb xml:id="p2z3"/>ecclesiae fidelissimo <lb xml:id="p2z4"/>ministro domino et fratri <lb xml:id="p2z5"/>colendissimo suo.</s>
				</p>
			</div>
