	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mirum mihi visum est nullam te facere mentionem <lb xml:id="p1z2"/>tuis in literis scriptis 3. februarii earum, quas ante <lb xml:id="p1z3"/>scripseram de iis, que intellexeram a d. Redonensi <lb xml:id="p1z4"/>episcopo, noluisse imperatorem, ut bulla indulgentiarum <lb xml:id="p1z5"/>aut iubilei publicaretur, quod nimis<note type="misc">minus?</note> expressam f<lb xml:id="p1z6"/>aciat mentionem continuationis.</s>
					<s n="3" xml:lang="la">Sed in altera sunt <lb xml:id="p1z7"/>hec apposita "indicimus sublata omni suspensione["?].</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Sed ex aliis literis ad me scriptis ex <placeName ref="l822">Germania</placeName> et <lb xml:id="p1z9"/><placeName ref="l850">Austria</placeName> video nullos esse, qui consilium approbent, <lb xml:id="p1z10"/>non magis catholicos quam protestantes, illos <lb xml:id="p1z11"/>quidem, quod nolint pedem domo efferre, si nolentibus <lb xml:id="p1z12"/>vicinis celebretur concilium.</s>
					<s n="5" xml:lang="la">In dieta <placeName ref="l361">Numburgi</placeName> sunt <lb xml:id="p1z13"/>nunc duo pontificis nuncii et tres legati imperatoris; <lb xml:id="p1z14"/>expectamus, quid effecerint.</s>
					<s n="6" xml:lang="la">Coniicio nuncios nihil <lb xml:id="p1z15"/>permoturos et re infecta discessuros. tres legati <lb xml:id="p1z16"/>poterunt de dieta aliqua convenire, in qua de <lb xml:id="p1z17"/>concilio tractabitur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">De <placeName ref="l832">Gallia</placeName> nihil habeo nisi <lb xml:id="p1z18"/>bonas spes.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Fasciculum literarum nuper ad te misi <lb xml:id="p1z19"/>ex <placeName>Gech</placeName>, heri maiorem accepi, quem nunc mitto.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>Ex eo libenter haberem libellum, cui titulus exemplar <lb xml:id="p1z21"/>literarum ecclesie <placeName ref="l587">Tigurine</placeName> ad <placeName ref="l2472">Pol[onos]</placeName>.</s>
					<s n="10" xml:lang="la">Fuit hic legatus <placeName ref="l2478">Sabaudie</placeName> per <lb xml:id="p1z22"/>quinque ad 6 dies, <placeName ref="l339">Neocomum</placeName> petiit, ex quo nihil adhuc <lb xml:id="p1z23"/>intellexi.</s>
					<s n="11" xml:lang="la" ana="salute">Salutabis senatum amplissimum et amicos communes.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z24"/>Bene vale.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l760">Solut[uri</placeName>] 11. februarii.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z25"/>Tuus, quem nosti.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullinghero</persName>, <lb xml:id="p2z2"/>ecclesie <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z4"/>Tigury.</s>
				</p>
			</div>
