	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et misericordiam a Domino.</s>
					<s n="2" xml:lang="la">Multo iam tempore abstinui, <lb xml:id="p1z2"/>ne te meis gravarem literis, doctissime vir; sed amplius continere non potui, <lb xml:id="p1z3"/>quin te de rebus nostris certiorem facerem.</s>
					<s n="3" xml:lang="la">Res nostrae sun[t] accisae <lb xml:id="p1z4"/>et calamitatibus plenae.</s>
					<s n="4" xml:lang="la">Pensionarii ante annos fere duos offensi <lb xml:id="p1z5"/>et correctionis impatientes vindictam querunt, cum papistis conspirant, <lb xml:id="p1z6"/><persName ref="p7583">episcopum</persName> inflant et ad deteriora dirigunt, opem pollicentur.</s>
					<s n="5" xml:lang="la">Nos <lb xml:id="p1z7"/>divexamur variis modis, ut sub ipsius potestatem denuo redigamur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Deus optimus maximus suis adesse dignetur.</s>
					<s n="7" xml:lang="la"><persName ref="p396">Ioanni Blasio</persName>, collegae meo, <lb xml:id="p1z9"/>male suus cessit dyalogus.</s>
					<s n="8" xml:lang="la">Utinam continuisset se a scribendo, quod illi <lb xml:id="p1z10"/>nobisque perutile fuisset!</s>
					<s n="9" xml:lang="la">Ego iam per integrum annum et plus male <lb xml:id="p1z11"/>habui in capite meo morbo quodam, quem ego medicinae inexpertus diffinire <lb xml:id="p1z12"/>non scio.</s>
					<s n="10" xml:lang="la">Ego fere mihi aliisque inutilis factus, maxime in isto tempore, <lb xml:id="p1z13"/>cum omnia perplexa, intricata confusaque sunt, ut vix sim ferendo.</s>
					<s n="11" xml:lang="la">Ad haec <lb xml:id="p1z14"/>paupertate et penuria praemimur fere omnes, ut vix spirare possimus.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z15"/>Ex <placeName ref="l834">Italia</placeName> penitus nihil habemus scitu dignum; quae vero in <placeName ref="l822">Germania</placeName> <lb xml:id="p1z16"/>fiunt, ut vobis notiora, certiores a vobis reddi expectamus.</s>
					<s n="13" xml:lang="la">Caeterum <lb xml:id="p1z17"/>tu nos causamque nostram fratribus fidelibus ecclesiaeque tuae commendare <lb xml:id="p1z18"/>velis, qui nos praecibus suis ad Dominum iuvare dignentur.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z19"/>vir eximie.</s>
					<s n="15" xml:lang="la">Ex <placeName ref="l648">Rhetiae</placeName> <placeName ref="l98">Curia</placeName>, 19.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Novembris 1543.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z20"/>Tuus totus <persName ref="p654">Ioannes Comander</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietate et doctrina clarissimo <lb xml:id="p2z2"/>viro magistro <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z4"/>antistiti vigilantissimo, domino <lb xml:id="p2z5"/>et fratri suo inprimis <lb xml:id="p2z6"/>observando.</s>
				</p>
			</div>
