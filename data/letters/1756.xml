	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Etsi nihil novi, quod ad te scriberem, haberem, vir clarissime, <lb xml:id="p1z2"/>attamen <persName ref="p1227">Froschoverum</persName>, qui amicissimas tuas literas attulit, <lb xml:id="p1z3"/>vacuum plane literis meis abire nequaquam passus sum.</s>
					<s n="2" xml:lang="la">Scripsi <lb xml:id="p1z4"/>autem proxime tuas ad comitem <placeName ref="l572">Wirtenbergensem</placeName> literas <lb xml:id="p1z5"/>una cum fasciculo probe curatas esse, nec dubium est, <lb xml:id="p1z6"/>quin iam dudum per suos acceperit omnia.</s>
					<s n="3" xml:lang="la">Marchionem <lb xml:id="p1z7"/><placeName ref="l1048">Brandeburgensem</placeName> ad <persName ref="p18538">Carolum</persName> imperatorem a <placeName ref="l832">Gallo</placeName> desci<lb xml:id="p1z8"/>visse constans fama est, quibus autem condicionibus, nondum <lb xml:id="p1z9"/>apud nos constat.</s>
					<s n="4" xml:lang="la">Audio cardinales atque principes quosdam <lb xml:id="p1z10"/>intercedere atque cogitare de facienda pace inter <persName ref="p8112">Gallum</persName> <lb xml:id="p1z11"/>atque imperatorem, sed impiis nunquam erit pax.</s>
					<s n="5" xml:lang="la">Accepimus <lb xml:id="p1z12"/>his diebus literas a fratribus <placeName ref="l18">Augustanis</placeName>, qui fortiter <lb xml:id="p1z13"/>se evangelium praedicare scribunt ne mencionem quidem facientes <lb xml:id="p1z14"/>novae illius interitus reformationis a <persName ref="p18538">Carolo</persName> ante qua<lb xml:id="p1z15"/>driennium contra apertum dei verbum institutae.</s>
					<s n="6" xml:lang="la">Asserunt <lb xml:id="p1z16"/>etiam principem <placeName ref="l1716">Mansfeldensem</placeName> occupasse omnem <lb xml:id="p1z17"/>fere <placeName ref="l1041">Brunsvicensem</placeName> ducatum atque expilasse nescio <lb xml:id="p1z18"/>quot episcopatus; sed famae nondum fidem tribuo, <lb xml:id="p1z19"/>donec ex aliis quoque audiam similia.</s>
					<s n="7" xml:lang="la">Caetera ex <lb xml:id="p1z20"/><persName ref="p1227">Froschovero</persName> atque aliis <placeName ref="l587">Tigurinis</placeName>, qui nostras frequentarunt <lb xml:id="p1z21"/>nundinas, accipies, quos instar prolixae epistolae <lb xml:id="p1z23"/>habebis.</s>
					<s n="8" xml:lang="la">Uxor <persName ref="p8418">Myconii</persName> piae memoriae 3. no<lb xml:id="p1z24"/>vembris etiam obiit, atque subinde multi peste apud nos corripiuntur <lb xml:id="p1z25"/>atque eripiuntur nobis.</s>
					<s n="9" xml:lang="la">Speramus tamen meliora <lb xml:id="p1z26"/>adventante solstitio hyemali.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Sed fiat bona domini v<lb xml:id="p1z27"/>oluntas.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale.</s>
					<s n="12" xml:lang="la"><placeName ref="l28">Basileae</placeName> 8. novembris anno 1552.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z28"/>Resalutat te d. <persName ref="p8054">Marcus Bersius</persName> atque <persName ref="p8126">Oporinus</persName>.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z29"/>T[uus] <lb xml:id="p1z31"/><persName ref="p8406">Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vigilantissimo ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z2"/>pastori d. <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bullingero</persName>, domino atque <lb xml:id="p2z4"/>amico incomparabili.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
