	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Compater in domino charissime.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Septima mensis huius <lb xml:id="p1z2"/>tuas accepi una cum Apocalypsi, quam tandem <lb xml:id="p1z3"/>felici, ut speramus, auspicio acceptam legent <lb xml:id="p1z4"/>et melius quam hactenus intelligent ecclesiae Christi.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Habeo pro hoc dono tuo, quas possum, gratias.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Misissem <lb xml:id="p1z6"/>ad te Ieshaiam nostrum, si aliquod esset illius <lb xml:id="p1z7"/>apud me exemplar praeter unicum, quod habeo.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Senior <persName ref="p5213">Hervagius</persName> solebat decem plus minus laborum <lb xml:id="p1z9"/>meorum exemplaria mox post absolutam aeditionem <lb xml:id="p1z10"/>mittere.</s>
					<s n="7" xml:lang="la">Iam, postquam ille ad res est gerendas <lb xml:id="p1z11"/>factus inutilis, filius et gener studius illius erga <lb xml:id="p1z12"/>me subinde levius ac tepidius, quam velim, pro<lb xml:id="p1z13"/>sequuntur.</s>
					<s n="8" xml:lang="la">Urgebo tamen illos denuo, ut mittant; <lb xml:id="p1z14"/>ubi miserint, curabo, ut accipies, non quod <lb xml:id="p1z15"/>aliquid inde commodi accepturum te putem, sed ut <lb xml:id="p1z16"/>subinde per ocium inspicias et, si quid desyde<lb xml:id="p1z17"/>raveris, fraterne admoneas.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/>De conventu <placeName ref="l569">Wormatiensi</placeName> statum rerum, qui nunc <lb xml:id="p1z19"/>est, consyderans idem, quod scribis, sentio.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/>Praeterita septimana literas ex <placeName ref="l18">Augusta</placeName> primarii <lb xml:id="p1z21"/>concionatoris, qui illic est, prima septembris <lb xml:id="p1z22"/>datas accepi, in quibus de hoc conventu ne <lb xml:id="p1z23"/>verbum quidem scribit, quamvis ex iis, qui <placeName ref="l569">Wor<lb xml:id="p1z24"/>matiam</placeName> mittendi essent, sit unus fueritque paulo <lb xml:id="p1z25"/>ante in conventu <placeName ref="l157">Francofordiensi</placeName>, in quo de collo<lb xml:id="p1z26"/>quio futuro pleraque sunt constituta, et sedulo <lb xml:id="p1z27"/>ipsum monuerim, ut de illo, si quid haberet, <lb xml:id="p1z28"/>perscriberet.</s>
					<s n="11" xml:lang="la">Verum, ut sunt omnia incerta et <lb xml:id="p1z29"/>instabilia, fieri potest, ut levi momento, quod <lb xml:id="p1z30"/>semel destinatum est a principibus, ubi minus <lb xml:id="p1z31"/>putatur, in effectum ducatur.</s>
					<s n="12" xml:lang="la">Quicquid sit, <lb xml:id="p1z32"/>nostrum est orare deum, ut scandalum hoc tam <lb xml:id="p1z33"/>grave tanque diuturnum et inveteratum tandem <lb xml:id="p1z34"/>ab ecclesiis suis auferat.</s>
					<s n="13" xml:lang="la" ana="farewell">Optime vale, compater charissime.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z35"/>Saluta tuos omnes, dominos etiam ac fratres isthic <lb xml:id="p1z36"/>d. <persName ref="p8171">Bibliandrum</persName>, d. <persName ref="p8111">Petrum Martyrem</persName>, d. <persName ref="p2336">Ochinum</persName>, d. <persName ref="p8011">Ru<lb xml:id="p1z37"/>dolfum Gvalterum</persName> et reliquos.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Salutant te mei omnes, <lb xml:id="p1z38"/>praesertim <persName ref="p2207">Heinrychulus</persName> noster.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l41">Bernae</placeName> 1557 13. septembris.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><persName ref="p8417">W[olfgan<lb xml:id="p1z39"/>gus] Musculus</persName> tuus in domino.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z2"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/>compatri suo, domino <lb xml:id="p2z5"/>ac fratri in Christo <lb xml:id="p2z6"/>charissimo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
