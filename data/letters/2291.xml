	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D. P.</s>
					<s n="2" xml:lang="la">Accepi nuper amoris piissimi plenas literas tuas, vir colendissime.</s>
					<s n="3" xml:lang="la">Non crebrius <lb xml:id="p1z2"/>ad te scripsi aut citius, quod nihil haberem fere dignum, quo legendo tempus <lb xml:id="p1z3"/>tereres, nisi quaedam adhuc pertinacium, simulantium tamen et strenue dissimulantium <lb xml:id="p1z4"/>hominum paucorum repetere voluissem, de quibus loqui desino, quoad dominus compellet.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>De homine, quod scribis, expurgato utinam verum sit; mihi tamen, quod constat non <lb xml:id="p1z6"/>inanibus coniecturis, non facile dissuadebunt.</s>
					<s n="5" xml:lang="la">Novi, quam facile vel metu vel <lb xml:id="p1z7"/>calliditate mentiantur homines.</s>
					<s n="6" xml:lang="la">Sed de his satis; non possunt omnia literis credi.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/>Cronologiam <persName ref="p1234">Ioannis Functii</persName> vendit communiter <persName ref="p8126">Oporinus</persName> dimidio coronato, id est <lb xml:id="p1z9"/>12 baccionibus, ut nuperrime eius mihi famulus dixit; nam ego non emi.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Expectatur <persName ref="p17907">Ferrandus Gonzaga</persName> reversurus hac <placeName ref="l306">Mediolanum</placeName>.</s>
					<s n="9" xml:lang="la">Hic est dominus <lb xml:id="p1z11"/><persName>Aschanius Marsus</persName> ob eam rem et propter proxima <placeName ref="l21">Badę</placeName> comitia generalia.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z12"/>Certi hactenus vel de <placeName ref="l2510">Turca</placeName> vel aliis de rebus nihil habetur vel fertur.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p4037">Doctor Zancus</persName> <placeName ref="l491">Argentinę</placeName> per integram hebdomadam rogatus obnixe eam publice <lb xml:id="p1z14"/>tractavit quęstionem hęreticis odiosam, quod liceat magistratui christiano <lb xml:id="p1z15"/>animadvertere capitaliter in haereticos etc.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Fortasse prodibit in lucem.</s>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z16"/>Bene et perpetuo vale cum sancta familia tua.</s>
					<s n="14" xml:lang="la">Ex <placeName ref="l28">Basilea</placeName> <lb xml:id="p1z18"/>26. maii 1554.</s>
					<s n="15" xml:lang="la">R<lb xml:id="p1z19"/>aptim.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Minimus tuus in Christo frater <lb xml:id="p1z20"/><persName ref="p1327">Gulielmus Gratarolus</persName> medicus.</s>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo et optimo verbi dei ministro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinricho Bullingero</persName>, maiori meo colendissimo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
