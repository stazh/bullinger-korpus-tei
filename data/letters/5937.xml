	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Ex literis <placeName ref="l425">Romae</placeName> datis 2. <lb xml:id="p1z2"/>novembris.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Praeterita hac septimana expedivit <persName>Romanus <lb xml:id="p1z4"/>pontifex</persName> legatos 3: reverendissimum d. <persName>Geriam</persName> <lb xml:id="p1z5"/>ad imperatorem <persName ref="p18477">Ferdinandum</persName>, reverendissimum S. Crucis ad <persName ref="p20341">regem <lb xml:id="p1z6"/>Francorum</persName>, reverendissimum vicecomitem ad <persName ref="p18575">regem Hi<lb xml:id="p1z7"/>spaniarum</persName>.</s>
					<s n="3" xml:lang="la">Existimatur praestantissimos hos viros esse <lb xml:id="p1z8"/>missos, ut extremo hoc munere periculum <lb xml:id="p1z9"/>faciant, si istos principes eo possint adducere, <lb xml:id="p1z10"/>ut velint concilium terminari unoque certo <lb xml:id="p1z11"/>in loco convenire omnes, in quo decernatur et <lb xml:id="p1z12"/>concludatur decreta concilii <placeName ref="l1107">Tridentini</placeName> invio<lb xml:id="p1z13"/>labiter esse observanda agaturque, ut par <lb xml:id="p1z14"/>est, de privatione vel de privationis exe<lb xml:id="p1z15"/>qutione adversus omnes reges et principes, <lb xml:id="p1z16"/>denique contra urbes, respublicas et populos, <lb xml:id="p1z17"/>qui per sacrum concilii haeretici fuerint <lb xml:id="p1z18"/>declarati damnatique cum approbatione pont<lb xml:id="p1z19"/>ificis.</s>
					<s n="4" xml:lang="la">Fuit autem <persName>cardinalis Lotha<lb xml:id="p1z20"/>ringus</persName> hic <placeName ref="l425">Romae</placeName> veniens huc ex concilio <lb xml:id="p1z21"/><placeName ref="l1107">Tridentino</placeName>, qui horum consiliorum putatur <lb xml:id="p1z22"/>esse architectus.</s>
					<s n="5" xml:lang="la">Idem ille obtinuit a princip<lb xml:id="p1z23"/>ibus <lb xml:id="p1z24"/><placeName ref="l834">Italiae</placeName> duos legatos omnium <placeName ref="l834">Italiae</placeName> principum <lb xml:id="p1z25"/>nomine profecturos ad regem <placeName ref="l832">Galliae</placeName> petitum <lb xml:id="p1z26"/>vindictam, imprimis ut ducis <placeName>Guysiani</placeName> <lb xml:id="p1z27"/>sanguis pro universa republica christi<lb xml:id="p1z28"/>ana effusus repetatur ab hominibus <lb xml:id="p1z29"/>noxiis.</s>
					<s n="6" xml:lang="la">Caput legationis esse dicitur illustrissimus <lb xml:id="p1z30"/>d. <persName>Franciscus Estensis</persName>, patruus ducis <placeName ref="l150">Ferrariae</placeName> <lb xml:id="p1z31"/>etc.</s>
				</p>
				<p>
					<note>[Datum, Unterschrift und Adresse fehlen; dagegen a tergo der Vermerk:]</note>
				</p>
				<p>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>Remitte haec, v[e]<lb xml:id="p2z2"/>rum de rebus <placeName ref="l832">Ga[lliae]</placeName> <lb xml:id="p2z3"/>non est, quod rem[ittas].</s>
				</p>
			</div>
		</body>
	</text>
