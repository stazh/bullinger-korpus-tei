	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia Christi tecum.</s>
					<s n="2" xml:lang="la">En redit ad te magnus ille <lb xml:id="p1z2"/>legatus <persName>Heinius Speet</persName>, qui apud nos aliquot heb<lb xml:id="p1z3"/>domadibus putavit et fodit nonnunquam per vices <lb xml:id="p1z4"/>nunc terram nunc verafimum vineis importans, <lb xml:id="p1z5"/>quem nolui absque epistolari salutatione te convenire.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Simplex est, ut nosti, cui et pietatem animi <lb xml:id="p1z7"/>coniunxit cupiens, si posset, ut vellet, omnibus <lb xml:id="p1z8"/>comodare bonis fratribus.</s>
					<s n="4" xml:lang="la">Is et tibi referet <lb xml:id="p1z9"/>meis de rebus.</s>
					<s n="5" xml:lang="la">Ecclesia, gratię deo, adhuc salva.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Princeps expectatur cum uxore uterum gerente etc.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>Mavortiales nostri stant in procinctu, quidam <lb xml:id="p1z12"/><persName ref="p18538">Caesari</persName>, alii <placeName ref="l832">Gallo</placeName> militaturi.</s>
					<s n="8" xml:lang="la">Conscribitur exercitus <lb xml:id="p1z13"/>in <placeName ref="l2510">Turcam</placeName>, emungitur ingens pecunia.</s>
					<s n="9" xml:lang="la">Colmaria <lb xml:id="p1z14"/>ad belli subsidia confert novem millia florinorum.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/>Respublicę ubique indigne ferunt metuentes <lb xml:id="p1z16"/>regis imposturam.</s>
					<s n="11" xml:lang="la">D. <persName ref="p18137">Margbachius</persName> <placeName ref="l491">Strasburgensis</placeName> <lb xml:id="p1z17"/>rursus abiit in <placeName>Palatinatum</placeName> reformaturus ecclesiam <lb xml:id="p1z18"/>suo more.</s>
					<s n="12" xml:lang="la">Rabum aiunt certo apud <placeName ref="l513">Ulmenses</placeName> lineo <lb xml:id="p1z19"/>uti habitu remissioremque fieri.</s>
					<s n="13" xml:lang="la">Crebrescit fama de <lb xml:id="p1z20"/>colloquio, cui nacionalę colloquium sequi debeat, <lb xml:id="p1z21"/>ad calendas scilicet Graecas.</s>
					<s n="14" xml:lang="la">Ego dico cum Ezechia, <foreign xml:lang="de">Kan <lb xml:id="p1z22"/>es uberein nit besser werden,</foreign> "sit veritas tantum <lb xml:id="p1z23"/>et pax in diebus meis," nihilominus tamen semper <lb xml:id="p1z24"/>orans, ut et posteri solita dei clementia in veritate <lb xml:id="p1z25"/>serventur.</s>
					<s n="15" xml:lang="la">Certe impoenitens mundus ubique <lb xml:id="p1z26"/>fremit et tumultuanter furit charitate frigescente <lb xml:id="p1z27"/>ac dispereunte sancta disciplina.</s>
					<s n="16" xml:lang="la">Reor hoc <lb xml:id="p1z28"/>signum esse adventus filii dei.</s>
					<s n="17" xml:lang="la" ana="farewell">Hisce vale.</s>
					<s n="18" xml:lang="la" ana="salute">Salutant <lb xml:id="p1z29"/>te nostri, pręcipue <persName ref="p8088">Nicolaus Regius</persName>.</s>
					<s n="19" xml:lang="la" ana="salute">Tu vicissim <lb xml:id="p1z30"/>nominatimque tuos salutabis, <persName ref="p8011">Gualtherum</persName>, <persName ref="p8171">Bibliandrum</persName>, <lb xml:id="p1z31"/><persName ref="p8009">Ioannem Fabritium</persName>.</s>
					<s n="20" xml:lang="la">Ora dominum pro me ac pro ecclesia de<lb xml:id="p1z32"/>i.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z33"/><placeName ref="l411">Richenvillę</placeName> 15. aprilis 1557.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z34"/>Tuus ex animo <persName ref="p1010">Matthia<lb xml:id="p1z35"/>s <lb xml:id="p1z36"/>Erbius</persName> capularis senex et <lb xml:id="p1z37"/>viduus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Vestri s<lb xml:id="p1z38"/>umus vos<lb xml:id="p1z39"/>que nostri.</s>
					<s n="24" xml:lang="la"><lb xml:id="p1z40"/>Utinam perpetuo.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio ac praestanti viro <lb xml:id="p2z2"/>d. <persName ref="p495">Henrycho Bullingero</persName>, ecclesię <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> primario antistiti, <lb xml:id="p2z4"/>domino et fratri ob<lb xml:id="p2z5"/>servando etc<lb xml:id="p2z6"/>.</s>
				</p>
