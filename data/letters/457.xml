	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quo sacramento et quibus syngraphis <lb xml:id="p1z2"/>se obstrinxerit senatus et civitas <placeName ref="l257">Constantiensis</placeName> <lb xml:id="p1z3"/>erga regem <persName ref="p18477">Ferdinandum</persName> et posteros domus <lb xml:id="p1z4"/>Austriacae dominos, diserte intelliges ex co<lb xml:id="p1z5"/>nceptorum verborum exemplo, quod dare ad te volu<lb xml:id="p1z6"/>i, qui nuper fratri et mihi liberaliter com<lb xml:id="p1z7"/>municaris causam legationum inter se Helveti<lb xml:id="p1z8"/>carum de questione ratificandi concilii et <lb xml:id="p1z9"/>id genus.</s>
					<s n="3" xml:lang="la">Quęso tamen, lectum aut etiam <lb xml:id="p1z10"/>descriptum exemplum, quod mitto, ad me re<lb xml:id="p1z11"/>mittas, et si quem eius participem feceris, <lb xml:id="p1z12"/>quod nolim praeterquam fidissimos, ne prodas nomen meum.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z13"/>Res non est obscura quidem; <lb xml:id="p1z15"/>sed formae plerisque etiam civibus annotatio <lb xml:id="p1z16"/>desyderatur.</s>
					<s n="5" xml:lang="la">Obsecro et illud, reversis legatis <lb xml:id="p1z17"/>vestris e comitio Thermopolitano, si quid per<lb xml:id="p1z18"/>ceperis vel quęsitum vel responsum esse, quod per<lb xml:id="p1z19"/>tineat ad <placeName ref="l257">Constantienses</placeName> per <placeName ref="l774">Turgoiam</placeName> et <lb xml:id="p1z20"/><placeName ref="l862">Helvetiam</placeName> sparsos exules, eius uti me efficias <lb xml:id="p1z21"/>certiorem.</s>
					<s n="6" xml:lang="la" ana="salute">Commenda me symmystis tuis cęterisque <lb xml:id="p1z22"/>piis et eruditis viris.</s>
					<s n="7" xml:lang="la">Vos sic deplorate ca<lb xml:id="p1z23"/>sum nostrum, ut is fiat exemplo conservandarum rer<lb xml:id="p1z24"/>um, quę piis supersunt; qualis enim fuerit status <lb xml:id="p1z25"/>urbis nostrę non ignoratis.</s>
					<s n="8" xml:lang="la">nunc de ea veluti <lb xml:id="p1z26"/>apud Ezechielem 19,<lb xml:id="p1z27"/>13f. rite predic<lb xml:id="p1z28"/>atur:... <lb xml:id="p1z29"/>Talem ab <placeName ref="l862">Helvetia</placeName> planctum prohibeat benignus <lb xml:id="p1z30"/>pater celi, exercituum dominus, et reservet aliquas tandem relliqu<lb xml:id="p1z31"/>ias <pb/><lb xml:id="p2z1"/>nomini suo amplificando!</s>
					<s n="9" xml:lang="la" ana="farewell">In eo vale et me <lb xml:id="p2z2"/>ama.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l184">Griesenbergę</placeName> VIII. Martii MDXLIX.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z3"/><persName ref="p8178">Thomas Blaurerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse (vor 315):]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p4z1"/>D. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p4z2"/><placeName ref="l587">Tigurinorum</placeName> <lb xml:id="p4z3"/>evangelistę, amico <lb xml:id="p4z4"/>suo observando.</s>
					<s n="13" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
