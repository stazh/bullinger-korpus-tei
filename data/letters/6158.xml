	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Sęvit adhuc pestis apud nos, optime pater <lb xml:id="p1z2"/><persName ref="p495">Bullingere</persName>, ita ut nudiustertius in hoc <lb xml:id="p1z3"/>parvo oppido perierint 20. Hucusque <lb xml:id="p1z4"/>intra spatium trium mensium obiere cir<lb xml:id="p1z5"/>citer 400, et nondum finis; habes er<lb xml:id="p1z6"/>go, cur commendes nos precibus ecclesię tuę.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z7"/>Huc accedit, quod per decretum gubernatoris <lb xml:id="p1z8"/><placeName ref="l306">Mediolani</placeName> non licet amplius frumen<lb xml:id="p1z9"/>ta ex ducatu <placeName ref="l306">Mediolanensi</placeName> ad nos ex<lb xml:id="p1z10"/>portari; metuunt enim annonę penuriam propter <lb xml:id="p1z11"/>hasce toto fere mense maio continentes <lb xml:id="p1z12"/>pluvias.</s>
					<s n="3" xml:lang="la">Ita fit, ut pestem incipiat subsequi <lb xml:id="p1z13"/>fames, modo non et bellum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><placeName ref="l306">Mediolani</placeName> <lb xml:id="p1z14"/>enim colligitur miles et equitatur ad<lb xml:id="p1z15"/>versus quos, dominus nostri misereatur, <lb xml:id="p1z16"/>...</s>
					<s n="5" xml:lang="la">Ego cum familia singulari <lb xml:id="p1z17"/>beneficio dei valeo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale et tu <lb xml:id="p1z18"/>cum omnibus <lb xml:id="p1z19"/>fratribus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Salutat vos vester <persName>Friderychu</persName><note type="misc">dieser Satz von anderer Hand.</note>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z20"/><placeName ref="l93">Clavenna</placeName> prima iunii 1564.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z21"/>Tuus <persName ref="p4037">Zanchus</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">H[enrico] Bullingero</persName>, <lb xml:id="p2z2"/>ecclesię <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>pastori fidelissimo et patri optimo.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
