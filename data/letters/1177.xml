	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino, charissime <persName ref="p495">Bullingere</persName>.</s>
					<s n="2" xml:lang="la"><placeName ref="l749">Saxonicas</placeName> ecclesia<lb xml:id="p1z2"/>s pessimo esse in statu cum ob bellum crudele tum <lb xml:id="p1z3"/>ob adiaphora melius nosti ex literis, quas <persName ref="p8101">Lęlius</persName> ad te <lb xml:id="p1z4"/>misit, quam ego, etsi parum hac de re scripsit d. <persName ref="p8490">Va<lb xml:id="p1z5"/>lentinus Pacęus</persName>, contionator <placeName ref="l284">Lipsensis</placeName>; tu certiora velis <lb xml:id="p1z6"/>communicare.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Lantzknechtius quidam ad nos venit, qui <lb xml:id="p1z7"/>spargit exercitum d. <persName ref="p8034">ab Heideck</persName> dispersum et partim <lb xml:id="p1z8"/>a <persName ref="p18250">Mauritio</persName> susceptum, partim elapsum in varias <lb xml:id="p1z9"/>regiones et iam conari alium colligere, sed nervos <lb xml:id="p1z10"/>belli<note xml:id="fn1" type="footnote" n="1">Vgl. <hi>Cicero,</hi> Orationes Philippicae, 5, 5 und s. <bibl source="b17">HBBW XIV</bibl> *** .</note> deesse.</s>
					<s n="4" xml:lang="la"><placeName ref="l303">Magdeburgenses</placeName> summo in periculo sunt, <lb xml:id="p1z11"/>urgentur ab hostibus, ut nesciant, quo se vertant.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z12"/>Verum expecto a te literas, quę certiora et fortassis <lb xml:id="p1z13"/>feliciora indicabunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p8418">Myconius</persName> noster lecto affixus est, ac nihil edit, <lb xml:id="p1z15"/>sed perpetuo bibit; nequit enim sitim extinguere; senex <lb xml:id="p1z16"/>est, et natura deficit in horas, vix recuper<lb xml:id="p1z17"/>abit sanitatem pristinam, etsi domino omnia possibilia <lb xml:id="p1z18"/>sint.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale et rescribe.</s>
					<s n="8" xml:lang="la">18. februarii 1551.</s>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z19"/>Salutabis meo nomine d. <persName ref="p8171">Theodorum</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/>T[uus] <persName ref="p1278">Gastius</persName> <lb xml:id="p1z21"/>ex animo.</s>
					<s n="11" xml:lang="la">Brevi plura.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">D. <lb xml:id="p1z22"/><persName ref="p2916">Schertlinus</persName> abiit, <lb xml:id="p1z23"/>bonus vir et pius.<lb xml:id="p1z24"/>.<lb xml:id="p1z25"/>. <pb/><lb xml:id="p2z1"/>Eximio viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, concionato<lb xml:id="p2z4"/>ri apud <placeName ref="l587">Tigurinam</placeName> <lb xml:id="p2z5"/>ecclesiam diligentissimo, <lb xml:id="p2z6"/>praeceptori suo <lb xml:id="p2z7"/>charissimo.</s>
					<s n="13" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
