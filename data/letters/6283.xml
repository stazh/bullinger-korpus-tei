	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Quid hisce diebus inter dominos Bernates et ducem Sabaudi
					<lb xml:id="p1z2"/>vir clarissime, de tribe illis praefecturis restituendis
					<lb xml:id="p1z3"/>actum sit, te certiorem factum esse non dubito. Eud
					<lb xml:id="p1z4"/>autem transactionis haec fere summa est et Bernates
					<lb xml:id="p1z5"/>certis quibusdam conditionibus duci praefecturas illas redd.
					<lb xml:id="p1z6"/>quo animo vel quo consensu omnium me latet
					<lb xml:id="p1z7"/>Urbs igitur Geneva hostibus undique circumdata in
					<lb xml:id="p1z8"/>summo periculo versatur; quid enim adversarii nostri
					<lb xml:id="p1z9"/>qud dei, quotidie in christianorum perniciem machinenter
					<lb xml:id="p1z10"/>nemo est, qui non ignoret, neque dubito, quin Geneva praecipue
					<lb xml:id="p1z11"/>causa fuerit, cua prae caeteris suis ditionibus ab ysdem
					<lb xml:id="p1z12"/>Bernensibus occupatis, illas tres, Genevae proximas fangm
					<lb xml:id="p1z13"/>obnixue postularet. His ergo de causis d. princip
					<lb xml:id="p1z14"/>Christophorus ab illustrissimo d domino et patre
					<lb xml:id="p1z15"/>ut a praefecto Ottoni Hoenelio intellexi in Germani
					<lb xml:id="p1z16"/>revocabitur, cum res Gallicae etiam adhuc in eo stat
					<lb xml:id="p1z17"/>sint, ut eo locorum se conferve principi fortasse
					<lb xml:id="p1z18"/>satis tutum sit. Cogitans vero, an mihi esset
					<lb xml:id="p1z19"/>redeundum in Germaniam necne cum linguae Gallico
					<lb xml:id="p1z20"/>adhuc ignarus et vix limites patriae egressus sum.
					<lb xml:id="p1z21"/>praefectum d. principis Ottonem adii, qui mihi, quid
					<lb xml:id="p1z22"/>hac re faciendum esset, ostendet. Praefectus eta
					<lb xml:id="p1z23"/>parentes meos scribem utilissimum ratus est et quae p
					<lb xml:id="p1z24"/>de me sententia esset mihi significarent postulari
					<lb xml:id="p1z25"/>Scripsi igitur (ut decet filium obedientem) parentibus
					<lb xml:id="p1z26"/>totam rem, adiunxi simul me vel minimos fuum
					<lb xml:id="p1z27"/>adhuc in lingua Gallica et in studiis percipere
					<lb xml:id="p1z28"/>fore etiam, si in Germaniam proficiscener, ut tandem
					<lb xml:id="p1z29"/>non solum Gallicam, sed et Latinam negligerem, pauti
					<lb xml:id="p1z30"/>negligentia, partim vero, ut sit cyclopum illorum
					<lb xml:id="p1z31"/>nimiis sodalitiis, quae plerumque
					<lb xml:id="p1z32"/>aulis degentiam
					<lb xml:id="p1z33"/>studiis avocare solent. Peto itaque ab illi
					<lb xml:id="p1z34"/>saltem uniu atque alterius anni in Gallia versand
					<lb xml:id="p1z35"/>facultas mihi concedatur, quibus elapsis, si ve l
					<lb xml:id="p1z36"/>meliori commoditate me ad principem Christophorum
					<lb xml:id="p1z37"/>vel alium quendam in Germaniam mittere poterunt
					<lb xml:id="p1z38"/>Te itaque domine et, vir clarissime officiose rogo a
					<lb xml:id="p1z39"/>oro ut patri meo hac in re, ut hactenus etiam n
					<lb xml:id="p1z40"/>multis fecisti, consulas, et si fieri potest ad me
					<lb xml:id="p1z41"/>quid rebus meis consultissimum esse putes, aliquid scribas,
					<lb xml:id="p1z42"/>Tuus ex animo
					<lb xml:id="p1z43"/>Iohannes Philippus
					<lb xml:id="p1z44"/>ab altosa
					<pb/>
					<lb xml:id="p4z1"/>Clarissimo et domino meo reverendissimo
					<lb xml:id="p4z2"/>D. Heinricho Bullingero, ecclesiae
					<lb xml:id="p4z3"/><placeName ref="l587">Tigurinae</placeName> ministro fidelissimo
					<lb xml:id="p4z4"/>minim.
					<lb xml:id="p4z5"/>ur.
					<lb xml:id="p4z6"/>tiu.
					<lb xml:id="p4z7"/>.
					<lb xml:id="p4z8"/>S.
					<lb xml:id="p4z9"/>
				</p>
