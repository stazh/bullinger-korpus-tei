			<zone xml:id="p2z4-0" points="1527,1792 1722,1762 2007,1760 2214,1796 2320,1773 2321,1714 2229,1690 2103,1691 2044,1729 1769,1712 1616,1739 1574,1714 1529,1739">1534,1775 1573,1773 1612,1769 1652,1766 1691,1763 1731,1761 1770,1760 1809,1758 1849,1756 1888,1753 1928,1751 1967,1751 2006,1748 2046,1748 2085,1748 2125,1746 2164,1745 2203,1745 2243,1745 2282,1745 2322,1745</zone>
