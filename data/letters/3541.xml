	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Illustrissimus princeps <persName>marchio Vici</persName> <lb xml:id="p1z2"/>de <placeName ref="l994">Neapoli</placeName>, qui has tibi, chare compater, literas <lb xml:id="p1z3"/>offert, <placeName ref="l167">Genevae</placeName> habitat.</s>
					<s n="3" xml:lang="la">Omnibus piis et bonis <lb xml:id="p1z4"/>charissimus est propter virtutes ac dignus <lb xml:id="p1z5"/>est, quem mirentur et iuvent viri boni.</s>
					<s n="4" xml:lang="la">Proinde <lb xml:id="p1z6"/>ipsum et causam eius tibi tuaeque fidei commendo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Commendavi ipsum etiam utrique consul[um] scriptis <lb xml:id="p1z8"/>ad ipsos literis.</s>
					<s n="6" xml:lang="la">Petit recipi in civem <lb xml:id="p1z9"/>vel in defensionem <placeName ref="l648">Rhetorum</placeName>, quo gaudere <lb xml:id="p1z10"/>possit privilegio ipsis ab illustrissimis princ<lb xml:id="p1z11"/>ipibus <placeName ref="l522">Venetorum</placeName> concesso.</s>
					<s n="7" xml:lang="la">Sed ipse eam rem <lb xml:id="p1z12"/>exacte tibi referet.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Oro itaque, ut ipsum iu<lb xml:id="p1z13"/>vare digneris; valde enim mihi commen<lb xml:id="p1z14"/>datus est a piis <placeName ref="l167">Genevensibus</placeName>.</s>
					<s n="9" xml:lang="la">Nunc praeterea <lb xml:id="p1z15"/>quod scribam, habeo nihil.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Copiosas et plures <lb xml:id="p1z16"/>nunc scribo <placeName ref="l157">Francfordiam</placeName>, ut inde ad amicos <lb xml:id="p1z17"/>meos perferantur; ideo breviter sum in his <lb xml:id="p1z18"/>ad te.</s>
					<s n="11" xml:lang="la">Scribo eadem de re etiam ad d. <lb xml:id="p1z19"/><persName ref="p8432">Friderychum a Salice</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Audimus quosdam <lb xml:id="p1z20"/>valde instare, si possit synodus convocari, <lb xml:id="p1z21"/>in qua agatur de concordia ecclesiarum <placeName ref="l862">Helvetiae</placeName> <lb xml:id="p1z22"/>et <placeName ref="l822">Germaniae</placeName>.</s>
					<s n="13" xml:lang="la">Dominus det nobis, quod novit <lb xml:id="p1z23"/>facere ad aedificationem ecclesiarum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Qui <lb xml:id="p1z24"/>fit, quod d. <persName>Philippus</persName> non curat Biblia <lb xml:id="p1z25"/>sua a me accipi et ad se transportari?</s>
					<s n="15" xml:lang="la">T<lb xml:id="p1z26"/>ot<lb xml:id="p1z27"/>idem autem verbis illum oro in hac causa domini <lb xml:id="p1z28"/>comitis illustris, quot te obtestatus sum etc.</s>
					<s n="16" xml:lang="la" ana="farewell"><lb xml:id="p1z29"/>Valete, chari in domino fratres.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 18. martii <lb xml:id="p1z30"/>1558.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z31"/><persName ref="p495">Bullingerus</persName> vester.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabricio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>ministro, compatri et <lb xml:id="p2z4"/>fratri suo charissimo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>