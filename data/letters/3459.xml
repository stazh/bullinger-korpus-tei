	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non erat opus, <persName ref="p495">Bullingere</persName> vir clarissime, cur tam <lb xml:id="p1z2"/>prolixe meis literis responderes, qui paucis poteram esse <lb xml:id="p1z3"/>contentus ut negociorum tuorum, quibus occuparis, mihi con<lb xml:id="p1z4"/>scius et sententię vulgaris de coelo ignarus.</s>
					<s n="3" xml:lang="la">Igitur, ne <lb xml:id="p1z5"/>longis literis tibi molestus essem p riter utriusque ocio, quo neuter <lb xml:id="p1z6"/>abundat consulens statui paucis tibi respondere.</s>
					<s n="4" xml:lang="la">De sacrament<lb xml:id="p1z7"/>o arbitror meam sententiam tibi satis cognitam esse.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="salute">Quod <lb xml:id="p1z8"/>ad coelum divinitatis luce illustre, in quo pater cum filio habitat, <lb xml:id="p1z9"/>et ad thronum et dextram patris in hanc rerum <lb xml:id="p1z10"/>universitatem pertinentem attinet, non est visum quicquam <lb xml:id="p1z11"/>in pręsentia tibi respondere, partim quod non videris, quid e<lb xml:id="p1z12"/>go nomine coeli, <lb xml:id="p1z13"/>divinitatis et throni accipiam, percepisse, <lb xml:id="p1z14"/>partim quod hoc tempore multa sunt, quę ad publicam H<lb xml:id="p1z15"/>elvetię salutem magis intersit explicare quam hanc quęstionem <lb xml:id="p1z16"/>accuratius enodare.</s>
					<s n="6" xml:lang="la">Interea concordiam in d<lb xml:id="p1z17"/>omino et amicitiam, qua divinus spiritus nos coniunxit, <lb xml:id="p1z18"/>inter nos sartam tectam tueamur.</s>
					<s n="7" xml:lang="la">Etenim tempus ven<lb xml:id="p1z19"/>iet, <lb xml:id="p1z20"/>quo de spirituali coelo et throno Messię clarius sumus locu<lb xml:id="p1z21"/>turi.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z22"/>Tu vale cum <placeName ref="l587">Tigurina</placeName> ecclesia et eius ministris.</s>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z23"/>Tuos omnes in domino plurimum salvere iub<lb xml:id="p1z24"/>e<lb xml:id="p1z25"/>o<lb xml:id="p1z26"/>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Calendis ian<lb xml:id="p1z27"/>uarii 1558<lb xml:id="p1z28"/>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><persName ref="p8298">Ma<lb xml:id="p1z29"/>rti<lb xml:id="p1z30"/>nus Borrhaus</persName><lb xml:id="p1z31"/>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z32"/>[t<lb xml:id="p1z34"/>uu<lb xml:id="p1z35"/>s] Rev<lb xml:id="p1z36"/>er<pb/><lb xml:id="p2z1"/>endo viro doctrina <lb xml:id="p2z2"/>et pietate praestanti <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bullingero</persName>, sacri evan<lb xml:id="p2z4"/>gelii ministro apud <lb xml:id="p2z5"/><placeName ref="l587">Tigurinos</placeName>, suo in domino <lb xml:id="p2z6"/>fratri charissimo.</s>
				</p>
			</div>
