	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Commendo tuae humanitati m. <lb xml:id="p1z2"/><persName ref="p18133">Ioannem Thomam Hausęrum</persName>, legatum et civem <placeName ref="l303">Magdeburgensem</placeName>; <lb xml:id="p1z3"/>qua autem de causa sit missus, ab ipso percipies.</s>
					<s n="3" xml:lang="la">Praeterea <lb xml:id="p1z4"/>et stupenda de obsidione illa gravissima narrabit, quam <lb xml:id="p1z5"/>triennio sustinerunt.</s>
					<s n="4" xml:lang="la">Digni sunt homines, quibus omnes, <lb xml:id="p1z6"/>qui evangelium Christi amant, liberalitate vel aliqua <lb xml:id="p1z7"/>succurrant.</s>
					<s n="5" xml:lang="la">Mihi commendatus est a fratribus <placeName ref="l157">Francofordensibus</placeName>, <lb xml:id="p1z8"/>qui illum honorifice dimiserunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Misissem tibi dialogum concilii <placeName ref="l1107">Tridentini</placeName>, si commode <lb xml:id="p1z10"/>potuisset pius iste vir libellum secum ferre; aut prius accepisti <lb xml:id="p1z11"/>librum ab Oporino; nam misit aliquot exemplaria <placeName ref="l587">Tigurum</placeName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Exercitus <persName>Mauricianus</persName> in <placeName ref="l776">Thuringia</placeName> adhuc hęret, ac <lb xml:id="p1z13"/>episcopi magno sunt in metu et nesciunt, quo se vertant; <lb xml:id="p1z14"/>Caesarem precibus et literis fatigant et nihil responsi accipiunt.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Cum pfaffis crudeliter agunt lantzknechtii, aliquibus testiculos <lb xml:id="p1z16"/>auferunt, excęcant quosdam ac manus abscindunt; crudelia <lb xml:id="p1z17"/>designant exempla in papisticos; quamdiu autem sint impune <lb xml:id="p1z18"/>grassaturi, ignoratur.</s>
					<s n="9" xml:lang="la">Aiunt stipendia nuper numerata illis <lb xml:id="p1z19"/>esse ex auro <placeName ref="l832">Gallico</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Capitaneos habent principem immanissimum <lb xml:id="p1z20"/><persName>Albertum de Mechelburg</persName>, Rückgradt, Rhingraff et d. <persName ref="p8034">de Hei<lb xml:id="p1z21"/>deck</persName> et nescio quos alios.</s>
					<s n="11" xml:lang="la">Quid si exercitus iste ad <placeName ref="l832">Gallum</placeName> <lb xml:id="p1z22"/>deficeret aut sub praetextu <placeName ref="l832">Gallum</placeName> invaderet cum <placeName>Lucenburgensi</placeName> <lb xml:id="p1z23"/>milite?</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><persName>Caesar</persName> astute omnia agit et proditionibus occultis.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z24"/>Quando <persName ref="p8111">Petri Martyris</persName> libellus de eucharistia absolutus est?</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z25"/>Rogo praeterea te, ut responsum <placeName ref="l167">Genevensibus</placeName> missum ad articulos <persName ref="p20867">Hie<lb xml:id="p1z26"/>ronymi</persName> captivi ad me mittas; bona fide remissurus sum <lb xml:id="p1z27"/>et per proximum tabellarium.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z28"/><persName>Dani</persName> magno in apparatu sunt; equites passim conscribit rex, <lb xml:id="p1z29"/>contra quem autem moturus sit exercitum suum, adhuc ignor<lb xml:id="p1z30"/>atur.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z31"/>Aut novum bellum instituit aut Caesari negotium facesset aut <lb xml:id="p1z32"/>Gallo auxiliabitur.</s>
					<s n="17" xml:lang="la" ana="farewell">Vale.</s>
					<s n="18" xml:lang="la"><placeName ref="l28">Basileę</placeName> 25. ianuarii 1552.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z33"/>T[uus] <lb xml:id="p1z34"/><persName ref="p1278">Gastius</persName> ex animo.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pio et docto viro <lb xml:id="p2z2"/>m. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, pastori <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae vig<lb xml:id="p2z5"/>ilantissimo, suo in <lb xml:id="p2z6"/>domino fratri <lb xml:id="p2z7"/>charissimo.</s>
				</p>
				<p>
					<s n="21" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
