	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Qui has tibi, optime frater, literas offert, commen<lb xml:id="p1z2"/>datus mihi a d. <persName ref="p8130">Laurentio Agricola</persName>, sicut <lb xml:id="p1z3"/>vides in literis, quas his inclusi; alioqui enim <lb xml:id="p1z4"/>hominem non novi.</s>
					<s n="3" xml:lang="la">Cum autem intelligam hominem <lb xml:id="p1z5"/>esse satis eloquentem et peritum verae <lb xml:id="p1z6"/>religionis, qui et locum quaerit, in quo <lb xml:id="p1z7"/>ecclesiae servire possit, suasi, ut ad vos conce<lb xml:id="p1z8"/>deret; esse loca non pauca, quae indigeant <lb xml:id="p1z9"/>destituanturque pastoribus.</s>
					<s n="4" xml:lang="la">Oro itaque, ut ipsum <lb xml:id="p1z10"/>iuves; nolo tamen ignorare te abbatem <lb xml:id="p1z11"/><placeName ref="l473">Sancti Galli</placeName> ipsum diu detinuisse in vinculis, <lb xml:id="p1z12"/>tandem statuisse ipsum exemplum <foreign xml:lang="de">(hat <lb xml:id="p1z13"/>inn in das hal'ysen gestellt)</foreign> ac virgis cecidisse, nullam tamen <lb xml:id="p1z14"/>ob causam aliam quam religionis.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/><persName>Hylerus</persName> exposuit nuper senatui nostro a<lb xml:id="p1z16"/>mplissimo se ab eo tempore, quo patruus ipsius <lb xml:id="p1z17"/>sibi mortem conscivit, nunquam iustae sanitati <lb xml:id="p1z18"/>restitutum esse; testes produxit vicinos <lb xml:id="p1z19"/>pastores, medicos et pharmacopolas.</s>
					<s n="6" xml:lang="la">Se itaque <lb xml:id="p1z20"/>vereri, ne expectationi de ipso satisfacere <lb xml:id="p1z21"/>possit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Proinde concessum est ei manere in <lb xml:id="p1z22"/>loco, ubi nunc est.</s>
					<s n="8" xml:lang="la">Surrogatus est ei <persName ref="p8016">Thobias <lb xml:id="p1z23"/>Eglius</persName> probe tibi notus, doctus et piae sanctaeque <lb xml:id="p1z24"/>vitae.</s>
					<s n="9" xml:lang="la">Fuit is antea <placeName ref="l159">Frouenfeldiae</placeName> in <lb xml:id="p1z25"/>patria sua concionator; displicuit valde <lb xml:id="p1z26"/>papistis eius pietas et sedulitas; proinde ini<lb xml:id="p1z27"/>quis artibus effecerunt, ut in comitiis <placeName ref="l21">Ba<lb xml:id="p1z28"/>densibus</placeName> accusatus, quasi pacem illam violarit <lb xml:id="p1z29"/>docendo, atque ideo praetor iussus sit <lb xml:id="p1z30"/>illum diem et noctem in carcerem concludere, <lb xml:id="p1z31"/>deinde dimittere.</s>
					<s n="10" xml:lang="la">Ipse vero admonitus disces<lb xml:id="p1z32"/>sit, priusquam mandatum ad praetorem venisset<note type="margin">dazu a.R. von <persName ref="p8009">Fabricius</persName>: "Loquitur <persName ref="p495">Bullingerus</persName> de eo, qui Davoß mittendus."</note>.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z33"/>Hic itaque habitavit.</s>
					<s n="12" xml:lang="la">Hinc mittet eum magistratus <pb/><lb xml:id="p2z1"/>ad vos literis suis commendatum.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Adiungam et <lb xml:id="p2z2"/>ego meas ad d. <persName>Paulum Paul</persName> et ad d. <persName ref="p8055">Ambrosium</persName> consulem; nunc his i<lb xml:id="p2z3"/>llum tibi commendo.</s>
					<s n="14" xml:lang="la" ana="farewell">Vive et vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 20<note type="misc">viell. doch 21...</note> februarii 1561.</s>
					<s n="16" xml:lang="la">Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Praestantissimo <lb xml:id="p2z4"/>viro d. <persName ref="p8009">Ioanni Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae ministro, domino et fratri c<lb xml:id="p2z5"/>olendo et dilecto.</s>
					<s n="18" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
