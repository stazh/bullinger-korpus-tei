	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a deo patre per Iesum Cristum dominum nostrum, amen, <lb xml:id="p1z2"/>et fęlicissimum ac faustissimum annum tibi exoptat et toti domui <lb xml:id="p1z3"/>tue, praeceptor colende ac compater honorande.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Anno supperiori <lb xml:id="p1z4"/>vicesima prima die septembris circa horam terciam <lb xml:id="p1z5"/>in nocte uxor mea<note xml:id="fn1" type="footnote" n="1">Namentlich nicht bekannt.</note> mihi filium genuit, quem duo quidem viri <lb xml:id="p1z6"/>honesti in tuo nomine ac fratris<note xml:id="fn2" type="footnote" n="2"><persName ref="p527">Johannes Bullinger</persName>.</note> tui ex baptizmatis fonte elevaverunt.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Ideo secundum nomina vestra vocatus, videlicet <persName ref="p4642">Johannes Heinricus</persName><note xml:id="fn3" type="footnote" ana="bio" n="3">Über <persName ref="p4642">Johann Heinrich Distel</persName>, geb. 1533, ist weiter nichts bekannt.</note>.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>In hoc meam erga te et fratrem tuum fiduciam, favorem, <lb xml:id="p1z9"/>amicitiam, denique totam spem tanquam medium a deo mihi <lb xml:id="p1z10"/>assignatum et in hoc seculo collatum notificare volui, ut futuro <lb xml:id="p1z11"/>tempore, si ex hoc seculo migrarem, ipse puer meus secundum haberet <lb xml:id="p1z12"/>patrem, praeceptorem et tutorem.</s>
					<s n="5" xml:lang="la">Quem tibi soli commendavi etc.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Scultetus <placeName ref="l41">Bernensis</placeName> <persName ref="p2278">de Wattwyl</persName>[!]<note xml:id="fn4" type="footnote" n="4">Schultheiß <persName ref="p2278">Hans Jakob von Wattenwyl</persName>.</note> cum bandero<note xml:id="fn5" type="footnote" n="5">Bannerhauptmann <persName ref="p7871">Wolfgang von Wingarten</persName>.</note> uno et ceteris <lb xml:id="p1z14"/><placeName ref="l832">Francię</placeName> regem petiit<note xml:id="fn6" type="footnote" n="6">Zur <placeName ref="l41">Berner</placeName> Gesandtschaft nach <placeName ref="l832">Frankreich</placeName> s. oben <ref target="file10338">[Nr. 307]</ref> S. 271, Anm. 10.</note>, quod pauci sciver[un]t, et reversus est, et <lb xml:id="p1z15"/>rumor opem a rege quaesivisse contra cantones<note xml:id="fn7" type="footnote" n="7">Nämlich die <placeName ref="l2448">V Orte</placeName>.</note>, qui evangelium <lb xml:id="p1z16"/>extirpare nituntur, ut aput nos fama est et quod publice <lb xml:id="p1z17"/>fatentur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ceterum <placeName ref="l760">Soloturnenses</placeName> vallos construunt, propungnacula [!] <lb xml:id="p1z18"/>aedificant.</s>
					<s n="8" xml:lang="la">Eciam evangelicos praedicatores in rure iam ad nati<lb xml:id="p1z19"/>vitatis festum a beneficiis et officiis privatos et amotos esse.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>Quorum maior pars ad dominos <placeName ref="l41">Bernenses</placeName> confluxerunt<note xml:id="fn8" type="footnote" n="8">Zu den katastrophalen Folgen des <placeName ref="l760">Solothurner</placeName> Aufstandes für die Reformierten s. <hi>Haefliger</hi> 200f und oben S. 276, 49-61.</note>.</s>
					<s n="10" xml:lang="la">Ex ea parte <lb xml:id="p1z21"/>timendum actum esse de expectacione mea aput illos<note xml:id="fn9" type="footnote" n="9">Vielleicht hatte <persName ref="p8330">Distel</persName> auf eine Pfarrstelle in <placeName ref="l41">Bern</placeName> gehofft und sah nun diese Hoffnung durch den Zustrom reformierter Pfarrer aus <placeName ref="l760">Solothurn</placeName> vereitelt.</note>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Ego <lb xml:id="p1z22"/>tamen tuo praesidio te expecto suo congruo tempore.</s>
					<s n="12" xml:lang="la">Denique non imme<lb xml:id="p1z23"/>mor sum tuorum beneficiorum semper mihi collatorum.</s>
					<s n="13" xml:lang="la">Quorum gratias infini<lb xml:id="p1z24"/>tas habeo referre, opto.</s>
					<s n="14" xml:lang="la">Deus autem noster, qui retributor est omnium <lb xml:id="p1z25"/>bonorum<note xml:id="fn10" type="footnote" n="10">Vgl. <cit type="bible"><ref>Ps 18, 21</ref></cit>; <cit type="bible"><ref>Mt 6, 4 par</ref></cit>.</note>, te inesse [!] et tuo optimo proposito confortare et conservare <lb xml:id="p1z26"/>velit.</s>
					<s n="15" xml:lang="la">Deo ducente in proxima synodo celebratura<note xml:id="fna" type="footnote" n="a"><hi>in der Vorlage</hi> celebratua.</note> ad te venerim.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z27"/>Vale, et salvere velis d. <persName ref="p8447">Wernherum Steyner</persName>, <persName ref="p1753">Leonem</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p1753">Leo Jud</persName>.</note>, <lb xml:id="p1z28"/>Doctorem <persName ref="p4349">Carolstadium</persName><pb type="edition" next="279"/> ac totam familiam tuam.</s>
					<s n="17" xml:lang="la" ana="farewell">Iterum vale <lb xml:id="p1z29"/>et rescribe, ut tuis literis consolacionem accipiam.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Datum <placeName ref="l582">Zofigen</placeName>, ultima <lb xml:id="p1z30"/>die decembris anno etc. 1533.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z31"/>Tuus <persName ref="p8330">Georius [!] <lb xml:id="p1z32"/>Distel<lb xml:id="p1z34"/>lius</persName><note xml:id="fnb" type="footnote" n="b"><hi>Darunter von fremder Hand:</hi> seu <persName ref="p8330">Cardelius</persName>.</note>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Erudito ac fideli M. <lb xml:id="p2z2"/><persName ref="p495">Heinrico Bul[lingero]</persName>, ecclesiasti [!] <lb xml:id="p2z3"/><placeName ref="l587">Tigurino</placeName>, preceptori suo <lb xml:id="p2z4"/>colendissimo etc.</s>
				</p>
			</div>
