	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quae nuperrime commisisti<note xml:id="fn1" type="footnote" n="1"><persName ref="p495">Bullingers</persName> Brief ist nicht erhalten.</note>, prosequutus sum, meo quidem videre diligenter et <lb xml:id="p1z2"/>apud nostros et apud <placeName ref="l41">Bernenses</placeName>.</s>
					<s n="3" xml:lang="la">Utinam deus largiatur aliquando, ut tranquillioribus ess<lb xml:id="p1z3"/>e liceat.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">In negocio matrimoniali<note xml:id="fn2" type="footnote" n="2">Die diesbezügliche Anfrage <persName ref="p495">Bullingers</persName> zielte offenbar auf die bald danach aufgenommenen Verhandlungen der evangelischen Orte, um eine möglichst große Übereinstimmung bei der Behandlung von Ehefragen zu erreichen, s. oben <ref target="file10264">[Nr. 233]</ref> S. 141, Anm. 8.</note> non in postremis consyderanda mihi videntur <lb xml:id="p1z4"/>haec duo: Prius, quia vinculum coniugatorum est indissolubile, cavendum, ne facile quoqu<lb xml:id="p1z5"/>e vinculum istud iniiciatur.</s>
					<s n="5" xml:lang="la">Vides, ut causae coniugiorum nunquam fere sint, qua<lb xml:id="p1z6"/>les esse debebant.</s>
					<s n="6" xml:lang="la">Respicit hic carnem, ille divitias, alius quidpiam aliud, nem<lb xml:id="p1z7"/>o autem prolis propagationem et vitam deo dignam.</s>
					<s n="7" xml:lang="la">Quod si fieret, an putas <lb xml:id="p1z8"/>facile exoritura dissidia atque adulteria?</s>
					<s n="8" xml:lang="la">Alterum, si propius in adulterio pun<lb xml:id="p1z9"/>iendo accederetur ad poenam dei<note xml:id="fn3" type="footnote" n="3">Vgl. <cit type="bible"><ref>Lev 20, 10-21</ref></cit>.</note>.</s>
					<s n="9" xml:lang="la">Prudentior fuit omnino, quam ut hic statue<lb xml:id="p1z10"/>rit aliquid quam pro re crudelius.</s>
					<s n="10" xml:lang="la">Unum adiiciam adhuc: ne puellae petulantio<lb xml:id="p1z11"/>res sint, defendatur diligentius lex de matrimonio inito sine testibus probatis.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z12"/>Equidem leges multas esse bonas video<note xml:id="fna" type="footnote" n="a">video <hi>am Rande nachgetragen.</hi></note>, sed tardiores, qui debebant exequi.</s>
					<s n="12" xml:lang="la">Haec <lb xml:id="p1z13"/>non dico, ut docere velim, sed indicare, quid mihi privatim videatur.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Praeterea <lb xml:id="p1z14"/>venerunt hisce diebus ex <placeName ref="l491">Argentorato</placeName> literae<note xml:id="fn4" type="footnote" n="4">Nicht erhalten.</note> docentes <persName ref="p4810">Venetum</persName> illum<note xml:id="fn5" type="footnote" n="5"><persName ref="p4810">Bartolomeo Fonzio</persName>.</note> admodum <lb xml:id="p1z15"/>laborare ex ruptura periculumque esse de vita.</s>
					<s n="14" xml:lang="la">Orandum itaque deum, ut vitam illi <lb xml:id="p1z16"/>proferat in laudem ipsius.</s>
					<s n="15" xml:lang="la">Haec tibi tuisque, ut mentionem in precibus vestris <lb xml:id="p1z17"/>pariter habeatis pro homine pio et docto.</s>
					<s n="16" xml:lang="la">Audivimus item de <persName ref="p8127">Pellicani</persName> morb<lb xml:id="p1z18"/>o<note xml:id="fn6" type="footnote" n="6"><persName ref="p8127">Pellikans</persName> Krankheit ließ sich anderweitig nicht nachweisen.</note> plus satis gravi.</s>
					<s n="17" xml:lang="la">Per deum quaeso significes, ut valeat.</s>
					<s n="18" xml:lang="la">Crucior enim ob tanti <lb xml:id="p1z19"/>viri valetudinem non mediocriter.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="farewell">Vale, valeantque <persName ref="p3242">Utingerus</persName>, <persName ref="p1753">Leo</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p1753">Leo Jud</persName>.</note>, <persName ref="p8171">Theodorus</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p8171">Theodor Bibliander</persName>.</note> <lb xml:id="p1z20"/>omnes.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l28">Basileae</placeName>, octava iunii anno 1533.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z21"/><persName ref="p8418">Os. Myconius</persName> <lb xml:id="p1z22"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo piissimoque d. <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName>, fratri in domino <lb xml:id="p2z3"/>percolendo.</s>
					<s n="23" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
