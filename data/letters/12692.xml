	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><pb type="scan" next="207"/><lb xml:id="p1z1"/>Gratia Christi tecum.</s>
					<s n="2" xml:lang="la">Heri tuas<note xml:id="fn1" type="footnote" n="1">Nicht erhalten.</note>, mi venerande <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z2"/>accepi, pariter autem nondum acceptis illis<note xml:id="fn2" type="footnote" n="2">Gemeint ist <persName ref="p8055">Blarers</persName> Brief <ref target="file12691">Nr. 2644</ref> vom 26. Oktober.</note>, quae<note xml:id="fna" type="footnote" n="a">quae <hi>fehlt in der Vorlage.</hi></note> per adulescentem <lb xml:id="p1z3"/><persName ref="p20172">Ioannem ab Ulmis</persName> ad te scripsi.</s>
					<s n="3" xml:lang="la"><persName ref="p8178">Frater</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p8178">Thomas Blarer</persName>, der den Tag der <placeName ref="l894">Vier protestantischen Orte</placeName> in <placeName ref="l587">Zürich</placeName> (s. dazu <ref target="file12653">Nr. 2606</ref>, Anm. 60) besucht hatte; s. <ref target="file12683">Nr. 2636</ref>,2f.</note> vicissim affirmat<note xml:id="fn4" type="footnote" n="4">So schon in <ref target="file12691">Nr. 2644</ref>,17f.</note> <lb xml:id="p1z4"/>se magna voluptate <persName ref="p495">Bullingerum</persName> coram vidisse et audisse.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Interim valde sibi doluit, quod diutius illa sibi frui non licuit.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Tabellariorum negocium feliciter confectum gratulor tibique <lb xml:id="p1z7"/>magnam hoc nomine gratiam habeo.</s>
					<s n="6" xml:lang="la"><persName ref="p6501">Unoculus</persName> vester<note xml:id="fn5" type="footnote" n="5"><persName ref="p6501">Felix Schubinger</persName>; s. <ref target="file12682">Nr. 2635</ref>,25-34.</note> nostro <lb xml:id="p1z8"/>tabellioni<note xml:id="fn6" type="footnote" n="6">Unbekannt.</note> ultro confessus <pb type="edition" next="189"/> est se acriter obiurgatum a vestris <lb xml:id="p1z9"/>consulibus<note xml:id="fn7" type="footnote" n="7"><persName ref="p1888">Hans Rudolf Lavater</persName> und <persName ref="p1419">Johannes Haab</persName>.</note> praesente meo fratre ignoscique sibi petiit meliora pollicitus.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Fatum belli nostri ferendum nobis erit, quandoquidem mutare non <lb xml:id="p1z11"/>possumus.</s>
					<s n="8" xml:lang="la">Sperabimus autem haudquaquam frustratum iri <lb xml:id="p1z12"/>tot filiorum dei pia ardentissimaque vota, tametsi ob non <lb xml:id="p1z13"/>parum multas nec leves caussas<note xml:id="fnb" type="footnote" n="b"><hi>Am Rande nachgetragen.</hi></note> splendidam nostris de hoc hoste <lb xml:id="p1z14"/>victoriam polliceri haudquaquam ausim, praesertim cum nondum videam <lb xml:id="p1z15"/>veram de viribus nostris diffidentiam nec dignam pro peccatis <lb xml:id="p1z16"/>nostris consternationem, sine qua haud unquam plena in <lb xml:id="p1z17"/>domino fiducia poni potest.</s>
					<s n="9" xml:lang="la">Omnino profecto nusquam animadver<lb xml:id="p1z18"/>timus in nostris publicam et iustam sive praecandi sive <lb xml:id="p1z19"/>agendi <foreign xml:lang="el">ὁρμήν</foreign><note xml:id="fn8" type="footnote" ana="lex" n="8">Eifer.</note>, qualem praesens patrię et religionis periculum <lb xml:id="p1z20"/>iuxta scripturarum exempla requirit,<note xml:id="fn9" type="footnote" n="9">Siehe z.B. <cit type="bible"><ref>Dtn 30, 1-10</ref></cit>; <cit type="bible"><ref>Jer 29, 11-14</ref></cit>; <cit type="bible"><ref>Jo 2, 12-17</ref></cit>.</note> ut ne alia tibi <lb xml:id="p1z21"/>commemorem, non minus me terrentia.</s>
					<s n="10" xml:lang="la">Confido tamen <lb xml:id="p1z22"/>dominum non prorsus ablaturum a nobis suum regnum, sed desi<lb xml:id="p1z23"/>derium eius amplius in nobis accensurum, quando id <lb xml:id="p1z24"/>publice nondum adeo quęritur et ante omnia expetitur <lb xml:id="p1z25"/>Christus rex et servator noster, qui in hoc venit<note xml:id="fnc" type="footnote" n="c"><hi>In der Vorlage folgt</hi> in.</note> <lb xml:id="p1z26"/>mundum, ut quaereret et servaret, quod periit.<note xml:id="fn10" type="footnote" n="10"><cit type="bible"><ref>Lk 19, 10</ref></cit>.</note></s>
					<s n="11" xml:lang="la">Quamprimum <lb xml:id="p1z27"/>nos ad se vera resipiscentia convertat et salvi simus!<note xml:id="fn11" type="footnote" n="11"><persName ref="p8055">Blarer</persName> argumentiert in diesem Absatz in enger Anlehnung an den an ihn gerichteten Brief <persName ref="p467">Bucers</persName> vom 18. Oktober 1546 <hi>(<persName ref="p8055">Blarer</persName> BW</hi> II 522f, <ref target="file11401">Nr. 1358</ref>).</note></s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z28"/>Ad novam istam <persName ref="p20225">Gallię</persName><note xml:id="fn12" type="footnote" n="12">König <persName ref="p20225">Franz I.</persName> - Zu den Hinrichtungen von Protestanten in <placeName ref="l832">Frankreich</placeName> von 1546, besonders der von 14 Männern in <placeName ref="l1258">Meaux</placeName> am 6. Oktober 1546, s. Religion, Reformation and Repression in the Reign of Francis I. Documents from the Parlement of Paris, 1515-1547, hg. v. James K. Farge, Bd. 2: Documents 1544-1547, Toronto 2015, <ref target="file11039">Nr. 997</ref>, S. 1097-1104; <persName ref="p684">Jean <hi>Crespin</hi></persName>, Histoire des martyrs (1619), Nachdruck Toulouse 1885, S. 493-501; <persName ref="p8033">Theodor <hi>Beza</hi></persName>, Histoire ecclésiastique des Eglises réformées au Royaume de France (1580), Bd. 1, Nachdruck Paris 1883, S. 67-72; H[erbert] M[orris] <hi>Bower,</hi> The Fourteen of Meaux: An account of the earliest "Reformed Church" within France proper, London 1894 (Nachdruck von Proceedings of the Huguenot Society of London, Bd. 5, Jg. 1885).</note> et <persName ref="p8375">Anglię</persName> monarcharum<note xml:id="fn13" type="footnote" n="13">König <persName ref="p8375">Heinrich VIII.</persName> - Zur Hinrichtung von <persName ref="p4212">Anne Askew</persName> und anderen <placeName ref="l830">englischen</placeName> Protestanten im Sommer 1546 s. John <hi>Foxe,</hi> Acts and Monuments [1576], hg. v. Stephen Reed Cattley, Bd. 5, London 1838, S. 530-553 (auch online unter www.johnfoxe.org).</note> crudelitatem <lb xml:id="p1z29"/>plusquam tyrannicam totus cohorrui.</s>
					<s n="13" xml:lang="la">Quod <persName ref="p20225">Gallus</persName> <lb xml:id="p1z30"/>facit, in gratiam, non dubito, <persName ref="p19981">pontificis</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p19981">Paul III.</persName></note> facit, quo illum sibi <lb xml:id="p1z31"/>propicium retineat faciliusque a <persName ref="p18538">caesare</persName><note xml:id="fn15" type="footnote" n="15"><persName ref="p18538">Karl V.</persName></note> (quod iam <lb xml:id="p1z32"/>moliri ipsum nonnulli putant)<note xml:id="fnd" type="footnote" n="d"><hi>Klammern ergänzt.</hi></note> alienet.</s>
					<s n="14" xml:lang="la">Interim nostris <lb xml:id="p1z33"/>quoque non vulgaribus rationibus se insinuat illosque sibi <lb xml:id="p1z34"/>magna vi auri obstringit,<note xml:id="fn16" type="footnote" n="16">Zu den Hilfsangeboten <persName ref="p20225">Franz' I.</persName> an die <placeName ref="l1202">Schmalkaldener</placeName>, u.a. durch <persName ref="p6724">Piero Strozzi</persName>, s. <ref target="file12657">Nr. 2610</ref>,65-69; <ref target="file12659">Nr. 2612</ref>, Anm. 73.</note> quod ita in rem suam esse <lb xml:id="p1z35"/>credat, si non porro crescat caesar.</s>
					<s n="15" xml:lang="la">Verum non poterit hoc <lb xml:id="p1z36"/>illi felix esse, quod tanta christiani sanguinis iactura <lb xml:id="p1z37"/>efficere conatur.<pb type="edition" next="190"/></s>
					<s n="16" xml:lang="la">Dominus est, qui comprehendit sapientes in sua <lb xml:id="p1z38"/>ipsorum astutia;<note xml:id="fn17" type="footnote" n="17"><cit type="bible"><ref>Hi 5, 13</ref></cit>.</note> quem efflictim pro afflicta sua ecclesia interpellamus.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="17" xml:lang="la"><pb type="scan" next="206"/><pb/><lb xml:id="p2z1"/>Scribitur nunc caesarem per <placeName ref="l2865">Danubium</placeName> abitum parare,<note xml:id="fn18" type="footnote" n="18">Vgl. schon <ref target="file12682">Nr. 2635</ref>,16f.</note> sed sciri tamen <lb xml:id="p2z2"/>certo non potest.</s>
					<s n="18" xml:lang="la">Adeo ille mirifice simulat ac dissimulat omnia <lb xml:id="p2z3"/>sicque se multis rationibus velut lubricus anguis<note xml:id="fn19" type="footnote" n="19">Vgl. <hi><persName ref="p18867">Vergil</persName>,</hi> Aeneis, 5, 84.</note> intorquet, <lb xml:id="p2z4"/>ut elabi absque magno suorum periculo se posse confidat.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z5"/>Sed stat etiam ipsi sua dies,<note xml:id="fn20" type="footnote" n="20"><cit type="bible"><ref>Hi 14, 5</ref></cit>.</note> nec ullum valebit consilium contra dominum.<note xml:id="fn21" type="footnote" n="21">Vgl. <cit type="bible"><ref>Hi 5, 12</ref></cit>; <cit type="bible"><ref>Ps 37 (Vulg. 36), 12-17</ref></cit>.</note></s>
					<s n="20" xml:lang="la"><lb xml:id="p2z6"/>Huic nos cunctos permittemus,<note xml:id="fn22" type="footnote" n="22">Vgl. <cit type="bible"><ref>2Chr 20, 20</ref></cit>; <cit type="bible"><ref>Ps 4, 5</ref></cit>; <cit type="bible"><ref>62 (Vulg. 61), 8</ref></cit>; <cit type="bible"><ref>115 (Vulg. 114), 11</ref></cit>; <cit type="bible"><ref>Jes 26,4</ref></cit>.</note> hunc agnoscemus fortissimum nostrum <lb xml:id="p2z7"/>vindicem.<note xml:id="fn23" type="footnote" n="23">Vgl. <cit type="bible"><ref>Jes 1, 24</ref></cit>; <cit type="bible"><ref>1 Thess 4, 6</ref></cit>.</note></s>
					<s n="21" xml:lang="la">Sub ipsius alis securi ac tutissimi futuri.<note xml:id="fn24" type="footnote" n="24">Vgl. <cit type="bible"><ref>Ps 91 (Vulg 90), 4</ref></cit>.</note></s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="22" xml:lang="la" ana="farewell"><lb xml:id="p2z8"/>In illo bene ac perpetuo vale, mi charissime et optime frater!</s>
					<s n="23" xml:lang="la" ana="salute">Saluta <lb xml:id="p2z9"/>fratres et amicos omnes cum tua domo.</s>
					<s n="24" xml:lang="la" ana="salute">Nostri te diligenter salutant.</s>
					<s n="25" xml:lang="la">Iterum a<lb xml:id="p2z10"/>tque iterum vale!</s>
					<s n="26" xml:lang="la"><placeName ref="l257">Constantiae</placeName>, 27. octobris 1546.</s>
					<s n="27" xml:lang="la">Tuus <persName ref="p8055">Ambr[osius] Bl[arer]</persName>.</s>
				</p>
