	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Multa nunc scribere non posuum, quoniam iam <lb xml:id="p1z2"/>sub noctem demum nuncius hic mihi indicat se iturum <lb xml:id="p1z3"/><placeName ref="l587">Tigurum</placeName>.</s>
					<s n="3" xml:lang="la">Quid cum <placeName ref="l830">Anglis</placeName> actum, ex d. <persName ref="p1911">Le<lb xml:id="p1z4"/>veri</persName> literis, quas hic simul mitto, cognosces.</s>
					<s n="4" xml:lang="la">Facta <lb xml:id="p1z5"/>est illis copia, ut habitacula quęrant quacum<lb xml:id="p1z6"/>que ditionis <placeName ref="l41">Bernensis</placeName> parte velint, et huius rei publice <lb xml:id="p1z7"/>signata illis attestatio, quam ubique ostendere <lb xml:id="p1z8"/>posint, data est.</s>
					<s n="5" xml:lang="la">Hic, ut nosti, admittitur nemo, <lb xml:id="p1z9"/>quamvis, si aliqui hic habitare velint, non puto ipsis <lb xml:id="p1z10"/>fore denegandum, sed ut tanto numero recipiantur, <lb xml:id="p1z11"/>difficulter fiet neque ipsa urbs etiam admodum capax est <lb xml:id="p1z12"/>aut rebus necessariis abundans.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Iferdunum, oppidum <lb xml:id="p1z13"/>clarum duobus miliaribus supra <placeName ref="l339">Neocomum</placeName> <lb xml:id="p1z14"/>ad <placeName ref="l2857">lacum Neocomensem</placeName> situm, omnes illis suadent <lb xml:id="p1z15"/>propter artificium conficiendi panni, quod exercent.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>Eadem enim illic quoque negotiatio floret et omnia <lb xml:id="p1z17"/>huic arti necessaria ibi in promptu sunt, lana, <lb xml:id="p1z18"/>..., aqua tingendis pannis omnium accommodissima <lb xml:id="p1z19"/>molendina etc.</s>
					<s n="8" xml:lang="la">Non difficulter, ut spero, cives eius <lb xml:id="p1z20"/>oppidi eos recipient authoritate senatus nostri in<lb xml:id="p1z21"/>termediante; discent enim ab hisce meliores <lb xml:id="p1z22"/>quoque pannos conficere.</s>
					<s n="9" xml:lang="la">Sed de his omnibus sine dubio <lb xml:id="p1z23"/>copiosius ipse <persName ref="p1911">Leverus</persName>.</s>
					<s n="10" xml:lang="la">Profectus est cum comite <lb xml:id="p1z24"/>suo <placeName ref="l28">Basileam</placeName>, ut suis haec denunciet.</s>
					<s n="11" xml:lang="la">Deligent <lb xml:id="p1z25"/>ipsi aliquos, qui loca aliquot inspiciantet, quae <lb xml:id="p1z26"/>ipsis commoda videbuntur, deligant.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l28">Basilienses</placeName> <lb xml:id="p1z27"/>eos repulisse mirantur boni omnes.</s>
					<s n="13" xml:lang="la">Haec de istis, <lb xml:id="p1z28"/>proxime de aliis.</s>
					<s n="14" xml:lang="la" ana="farewell">Nunc bene vale.</s>
					<s n="15" xml:lang="la">Salva sit <lb xml:id="p1z29"/>tota domus tua et fratres omnes.</s>
					<s n="16" xml:lang="la" ana="salute">Salutant vos nostri.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z30"/><placeName ref="l41">Bernae</placeName> 14. maii 1557.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><persName ref="p8018">I[o<lb xml:id="p1z31"/>annes] Hallerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> ecclesię pastori <lb xml:id="p2z4"/>fidelissimo, domino et compatri <lb xml:id="p2z5"/>colendissimo ac <lb xml:id="p2z6"/>charissimo suo.</s>
					<s n="20" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zürich</placeName>.</s>
					<s n="21" xml:lang="de">M. <persName ref="p495">Heinrych <lb xml:id="p2z8"/>Bullingern</persName>.</s>
				</p>
			</div>
