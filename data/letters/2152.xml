			<zone xml:id="p4z3-0" points="468,1537 519,1541 569,1518 706,1569 805,1504 895,1493 897,1434 864,1427 754,1458 613,1405 554,1425 513,1411 471,1432">474,1500 500,1497 527,1495 553,1493 580,1491 606,1491 633,1491 659,1491 686,1492 712,1494 739,1493 765,1491 792,1489 818,1487 845,1484 871,1483 898,1483</zone>
