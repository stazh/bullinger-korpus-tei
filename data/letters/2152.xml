	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Cum vellem conscendere equum, tę advenerunt, <lb xml:id="p1z2"/>que sane grate fuerunt, quia ex his intellexi, <lb xml:id="p1z3"/>id quod mihi etiam ex plerisque locis scriptum est, <lb xml:id="p1z4"/>non quod ita sit; sed matrimonium illud <lb xml:id="p1z5"/><persName>Anglicanum</persName> plerosque non sine causa terret.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Tu autem habeas a me et dic, queso, dominis tuis <lb xml:id="p1z7"/>neque de pace nec de minimis quidem <lb xml:id="p1z9"/>induciis esse inter Cęsarem et nos mentionem, <lb xml:id="p1z10"/>et licet istud matrimonium effectum habeat, quo<lb xml:id="p1z11"/>d vix per seditiones [fiet], tamen hoc no<lb xml:id="p1z12"/>s non multum movet; <lb xml:id="p1z13"/>si e<lb xml:id="p1z14"/>nim <placeName ref="l830">Angli</placeName> hac <lb xml:id="p1z15"/>via hostes nobis fiant, antiquum obtinebunt.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z16"/>Sed caveant principe<lb xml:id="p1z18"/>s <lb xml:id="p1z19"/><placeName ref="l822">Germani</placeName>, ne quid contra nos faciant, alias, <lb xml:id="p1z20"/>ut tu ex literis <lb xml:id="p1z21"/>ad <persName ref="p3375">Verg[erium]</persName> vidisti, <lb xml:id="p1z22"/>nescio, quid sperari possit.</s>
					<s n="5" xml:lang="la">Re vera instat <lb xml:id="p1z23"/><persName>Caesar</persName> pro concilio <placeName ref="l1107">Tridentino</placeName> et <lb xml:id="p1z24"/>s<lb xml:id="p1z25"/>ollicitat multos; sed <lb xml:id="p1z26"/>salvo rege et fędere nostro cum dominis <lb xml:id="p1z28"/><placeName ref="l862">Helvetiis</placeName> hoc non impetrabit.</s>
					<s n="6" xml:lang="la">Uti<pb/><lb xml:id="p2z1"/>nam <placeName ref="l41">Bernates</placeName> et vos non ita dissimularetis, - <lb xml:id="p2z2"/>dabis veniam; loquor enim ex animo ut <lb xml:id="p2z3"/>christianus -; nam hac vice <lb xml:id="p2z4"/>Caesariani promittunt sibi multa, <lb xml:id="p2z5"/>que spero non eventura.</s>
					<s n="7" xml:lang="la">Sed si unum <lb xml:id="p2z6"/>corpus et fędus esset, vos vestra <lb xml:id="p2z7"/>absque ulla iniuria conservaretis et alii sua, <lb xml:id="p2z8"/>quibus omnibus inhiant <lb xml:id="p2z10"/><placeName>Caesariani</placeName> in ista anarchia.</s>
					<s n="8" xml:lang="la"><lb xml:id="p2z11"/>Habeo literas a nostro legato, qui <lb xml:id="p2z12"/>est in <placeName ref="l830">Anglia</placeName>, datas 20a altera.</s>
					<s n="9" xml:lang="la"><lb xml:id="p2z13"/>Regina vult matrimonium, misit <lb xml:id="p2z14"/>legatos et naves in <placeName ref="l875">Hispaniam</placeName>; populus <lb xml:id="p2z15"/>cum tota nobilitate contradicit etc.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z16"/>Iam sunt alique suborte rixe; <lb xml:id="p2z17"/>sed timendum, ne fortiores vincant; <lb xml:id="p2z18"/>deus tamen illis est fortior.</s>
					<s n="11" xml:lang="la">Debes <lb xml:id="p2z19"/>hoc maxime cum tuis ponderare; <lb xml:id="p2z20"/>nam est novum et a mille annis <pb/><lb xml:id="p3z1"/>inauditum et non sine causa nostri <lb xml:id="p3z2"/><placeName ref="l631">Burgundiones</placeName> vicini minantur ceteris <lb xml:id="p3z3"/>om<lb xml:id="p3z4"/>nibus nationibus.</s>
					<s n="12" xml:lang="la"><lb xml:id="p3z5"/>Ista raptim ex <placeName ref="l760">Soluturo</placeName> <lb xml:id="p3z6"/>10a ianu<lb xml:id="p3z7"/>arii.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale o<lb xml:id="p3z8"/>ptime.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p3z9"/>Tuus semper <persName ref="p8296">Ba<lb xml:id="p3z10"/>ss[a<lb xml:id="p3z11"/>fontaneus]</persName>.<note type="margin">a.R.: ...</note></s>
					<s n="15" xml:lang="la"><lb xml:id="p3z12"/>Quod de Helvetiis ex <placeName ref="l736">Pedemontio</placeName> dimissis dicitur, <lb xml:id="p3z13"/>crede hoc factum, ut a longioribus laboribus <lb xml:id="p3z14"/>quiescerent, et statim post meum reditum p<lb xml:id="p3z15"/>lures mittentur.</s>
					<s n="16" xml:lang="la">In <lb xml:id="p3z16"/><placeName ref="l2801">Corsica</placeName> omnia <lb xml:id="p3z17"/>prospera nec adhuc deo favente <lb xml:id="p3z18"/>quidquam infortunati accidit.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Tota <lb xml:id="p3z19"/><placeName ref="l834">Italia</placeName> (excepto pappa) timens sibi <lb xml:id="p3z20"/>ab isto monarcha nos respicit <lb xml:id="p3z21"/>et merito.</s>
					<s n="18" xml:lang="la">Spero etiam principes <lb xml:id="p3z22"/><placeName ref="l822">Germanos</placeName> eadem facturos vobiscum.</s>
					<s n="19" xml:lang="la" ana="farewell"><lb xml:id="p3z23"/>Vale.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p4z1"/>Optimo viro et <lb xml:id="p4z2"/>amico domino <lb xml:id="p4z3"/><persName ref="p495">Bulingero</persName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
