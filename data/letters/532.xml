	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Fuit apud me hic <placeName ref="l41">Bernę</placeName>, <persName ref="p495">Bullingere</persName> in domino <lb xml:id="p1z2"/>charissime, <persName ref="p5828">Barptolomeus Metzlerus</persName> <placeName ref="l257">Con<lb xml:id="p1z3"/>stantiensis</placeName>.</s>
					<s n="3" xml:lang="la">Promissionem accepit a senatu <lb xml:id="p1z4"/>futurae vocationis, mox atque locus aliquis <lb xml:id="p1z5"/>ipsi commodus vacaverit; nam in praesenti <lb xml:id="p1z6"/>nihil erat, quod optimo viro deputaretur.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Dederunt ei domini viaticum quoque 2 coronatos.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Itaque suo loco hęrebat, ubi hactenus mansit.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Donec vocetur.</s>
					<s n="7" xml:lang="la">Utinam et <persName ref="p8440">Gervasio</persName> nostro <lb xml:id="p1z10"/>sit pro aetate, dignitate et eruditione <lb xml:id="p1z11"/>consultum.</s>
					<s n="8" xml:lang="la">Iam incipit <persName ref="p8018">Hallerus</persName>, com<lb xml:id="p1z12"/>pater meus, causam suam agere, quan<lb xml:id="p1z13"/>doquidem terminus constitutus praeteriit, <lb xml:id="p1z14"/>ut ait.</s>
					<s n="9" xml:lang="la">Persuaderi potest, ut hic <lb xml:id="p1z15"/>maneat, si stipendium certum et auctius <lb xml:id="p1z16"/>detur; debebant hoc domini suapte sponte, <lb xml:id="p1z17"/>non admoniti, facere.</s>
					<s n="10" xml:lang="la">Meum non est, <lb xml:id="p1z18"/>ut quenquam admoneam, ne videar <lb xml:id="p1z19"/>praeter decorum etiam res meas agere.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/>Nolim illum discedere; prodest enim huic <lb xml:id="p1z21"/>ecclesiae tranquillandę plurimum et iam <lb xml:id="p1z22"/>praxim earum rerum tenet, quae fere <lb xml:id="p1z23"/>quotidie sunt agendę.</s>
					<s n="12" xml:lang="la">Stabit sententię <lb xml:id="p1z24"/>vestri senatus, modo habeatur ratio <lb xml:id="p1z25"/>necessarii stipendii.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Cętera sunt hic <lb xml:id="p1z26"/>satis commoda, etiam domi meae.</s>
					<s n="14" xml:lang="la">De <lb xml:id="p1z27"/>uxore scripsi nuper nec dubito, quin <lb xml:id="p1z28"/>acceperis.</s>
					<s n="15" xml:lang="la">Liberi utcunque incipiunt reva<lb xml:id="p1z29"/>lescere per gratiam domini, qui non deserit <lb xml:id="p1z30"/>sperantes in se.</s>
					<s n="16" xml:lang="la" ana="farewell">Optime vale, virorum <lb xml:id="p1z31"/>charissime.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Salutant teque tuosque omnes plurimum <lb xml:id="p1z32"/>et uxor et liberi, quibus <placeName ref="l587">Tigurum</placeName> perpetuo in <lb xml:id="p1z33"/>ore est.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">Salutem dominis et fratribus omnibus et <persName ref="p8440">Gervasio</persName> nostro<note type="margin">a.R.</note>.</s>
					<s n="19" xml:lang="de"><placeName ref="l41">Bernę</placeName> 26. Mai<lb xml:id="p1z34"/>i 1549.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z35"/><persName ref="p8417">W[olfgangus] Musculus</persName>, tu<lb xml:id="p1z36"/>us in domino totus</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo theolo<lb xml:id="p2z2"/>go M. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> ecclesię <lb xml:id="p2z5"/>antistiti vigilan<lb xml:id="p2z6"/>tissimo, domino <lb xml:id="p2z7"/>et fratri in <lb xml:id="p2z8"/>Christo charissimo <lb xml:id="p2z9"/>pariter et co<lb xml:id="p2z10"/>lendissimo.</s>
					<s n="22" xml:lang="la"><lb xml:id="p2z11"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
