	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime <persName ref="p495">Bulling[ere]</persName>, <lb xml:id="p1z2"/>accepi ex <lb xml:id="p1z3"/><placeName ref="l834">Italia</placeName> <lb xml:id="p1z4"/>literas a <persName ref="p8101">Lelio</persName>, quem in dies ex<lb xml:id="p1z5"/>pecto.</s>
					<s n="2" xml:lang="la">Is me rogat, ut ad te <lb xml:id="p1z6"/>mittam fasciculum, quem videbis <lb xml:id="p1z7"/>adiunctum, et tibi nun<lb xml:id="p1z9"/>ciat salutem plurimam.</s>
					<s n="3" xml:lang="la">Mitto Ita<lb xml:id="p1z10"/>licum libellum a me editum et <lb xml:id="p1z11"/>in media <placeName ref="l834">Italia</placeName> impressum, in <lb xml:id="p1z12"/>quo oportune facta est de <lb xml:id="p1z13"/><persName ref="p8171">Bibliandro</persName> mentio.</s>
					<s n="4" xml:lang="la">Quum ve<lb xml:id="p1z14"/>nero, plura exemplaria <lb xml:id="p1z15"/>afferam.</s>
					<s n="5" xml:lang="la" ana="farewell">Vale et salve <lb xml:id="p1z16"/>cum tota familia, scola <lb xml:id="p1z17"/>atque ecclesia.</s>
					<s n="6" xml:lang="la">Dominus tuis <lb xml:id="p1z18"/>la<lb xml:id="p1z19"/>boribus benedicat.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z20"/><placeName ref="l525">Vicosoprani</placeName>, pridie Michaelis 1552.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z21"/><persName ref="p3375">Verg<lb xml:id="p1z22"/>erius</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Clarissi<pb/><lb xml:id="p2z1"/>mo viro domino <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, fratri [<lb xml:id="p2z3"/>h]onor<lb xml:id="p2z4"/>an<lb xml:id="p2z5"/>do.</s>
				</p>
			</div>
		</body>
	</text>
