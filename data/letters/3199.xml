	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Spero, quae hactenus misi folia, omnia ad te <lb xml:id="p1z2"/>perlata esse; misi autem a b c d e quinque <lb xml:id="p1z3"/>terniones.</s>
					<s n="3" xml:lang="la">Iam tabellarium nactus duos proxime sequentes <lb xml:id="p1z4"/>f g mitto, brevi proxima occasione rursum alios <lb xml:id="p1z5"/>missurus.</s>
					<s n="4" xml:lang="la">Pergo, quantum licet, atque utinam plure<lb xml:id="p1z6"/>s potuissem absolvere hactenus, antequam caco<lb xml:id="p1z7"/>daemon aliquid impedimenti moliretur.</s>
					<s n="5" xml:lang="la">Mitto <lb xml:id="p1z8"/>simul literas <placeName ref="l157">Francfordia</placeName> hodie acceptas a <persName ref="p2639">Va<lb xml:id="p1z9"/>lerando Pollano</persName>, cuius etiam literarum ad me parti<lb xml:id="p1z10"/>culam, qua te et d. <persName ref="p8111">Petrum Martyrem</persName> interesse <lb xml:id="p1z11"/>colloquio <placeName ref="l569">Wormacię</placeName> propediem futuro optat et, <lb xml:id="p1z12"/>ut ad vos perscribam, hortatur.</s>
					<s n="6" xml:lang="la">Malui itaque, ut <lb xml:id="p1z13"/>ipsiusmet <persName ref="p2639">Valerandi</persName> manum videretis, neque <lb xml:id="p1z14"/>mihi prolixius scribere nunc vacat.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Opto te <lb xml:id="p1z15"/>et pios apud vos omnes bene valere in Christo.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/><placeName ref="l28">Basileae</placeName> subito 30. Maii 1557.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p8126">Ioan[nes] Oporinus</persName> <lb xml:id="p1z18"/>tu[uus] ex animo.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiastae <lb xml:id="p2z4"/><placeName ref="l587">Tigurino</placeName> <lb xml:id="p2z5"/>domino et amico <lb xml:id="p2z6"/>in<lb xml:id="p2z7"/>primis colend<lb xml:id="p2z8"/>o.</s>
				</p>
			</div>
		</body>
