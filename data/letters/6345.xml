	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Libens legi epistolam <persName ref="p3050">Stukii</persName> tui, viri medius fidius <lb xml:id="p1z2"/>elegantis et eruditi, perinvitus versus illos in <lb xml:id="p1z3"/><persName>Adriani Turnebi</persName> mortem, quo ego praeceptore amicoque <lb xml:id="p1z4"/>annos multos usus sum.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Non potest tanti viri <lb xml:id="p1z5"/>interitus <placeName ref="l832">Galliae</placeName> bonisque omnibus acerbus non esse.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Hunc tu vel <persName ref="p18991">Plinium</persName> aut potius <persName>Varronem</persName> huius <lb xml:id="p1z7"/>saeculi fuisse<note type="misc">gestrichen</note> recte censeas; nihil in eo homine <lb xml:id="p1z8"/>tumidi, nihil fuci.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Mirum autem, quam vir magnus <lb xml:id="p1z9"/>fuerit in re parva, admirabili quadam ingenii felicitate <lb xml:id="p1z10"/>bonarum omnium artium peritiam eximie erat <lb xml:id="p1z11"/>assequutus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Assentior <persName ref="p3050">Stukio</persName> tuo de <persName>Salignato</persName>; <lb xml:id="p1z12"/>cave putes excellentiorem virum <placeName ref="l832">Galliam</placeName> alere.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Laetus sum, cum audio res nostras bono loco esse; <lb xml:id="p1z14"/>faxit deus, ut haec nobis solida perpetuaque <lb xml:id="p1z15"/>gaudia sint!</s>
					<s n="8" xml:lang="la">Remitto epistolam et epitaphia; nunc <lb xml:id="p1z16"/>nihil habeo, quod tibi contra mittam, quam ipsum <lb xml:id="p1z17"/>animum tui (quod tibi omnino persuasum esse cupio) <lb xml:id="p1z18"/>quam cupidissimum, quo ego deum precor, ut te <lb xml:id="p1z19"/>sanctissimosque tuos labores bene fortunet.</s>
					<s n="9" xml:lang="la">Totum diem <lb xml:id="p1z20"/>fui molestissimum occupatus; sed tamen, ni rustice <lb xml:id="p1z21"/>nimis facio, qui te hac demum hora ad coenam <lb xml:id="p1z22"/>invito, gratissimus mihi conspectus tuus accideret.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Certe crastinum diem tibi destino.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/>Tuus ex animo <persName ref="p8160">P[omponne] <lb xml:id="p1z25"/>Bellievre</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
