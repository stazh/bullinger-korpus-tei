	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Si vales bene est; ego valeo.</s>
					<s n="3" xml:lang="la">Vir optime, doctissime, <lb xml:id="p1z3"/>scripsisti ad me superioribus diebus; quam <lb xml:id="p1z4"/>epistolam ut legi, tuae erga me benevolentię <lb xml:id="p1z5"/>significatio requirebat, ut rescriberem.</s>
					<s n="4" xml:lang="la">Verum <lb xml:id="p1z6"/>cum ita inter nos sit constituta lex, ut, si non <lb xml:id="p1z7"/>frequentius literis colloquamur, id ab alter<lb xml:id="p1z8"/>utro tamen in partem iniquiorem non esse accip<lb xml:id="p1z9"/>iendum, sed potius occupationibus id omne <lb xml:id="p1z10"/>esse tribuendum, quod ius cum ita a te sit <lb xml:id="p1z11"/>constitutum, uterque eo censebimur.</s>
					<s n="5" xml:lang="la">Cui tamen <lb xml:id="p1z12"/>(quod ad me) accedit, quod rerum nihil erat, <lb xml:id="p1z13"/>quas dignas iudicarem, de quibus aliquid <lb xml:id="p1z14"/>ad te darem.</s>
					<s n="6" xml:lang="la">Quod autem iam scribo, eam <lb xml:id="p1z15"/>ob caussam facio, ut intelligas me plurimum <lb xml:id="p1z16"/>te amare et virum hunc dominum <persName>Vitum N.</persName>, <lb xml:id="p1z17"/>hominem mea sententia bonum et doctum, <lb xml:id="p1z18"/>exulantem propter Christum servatorem, <lb xml:id="p1z19"/>tuae commendarem humanitati.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Intelliges <lb xml:id="p1z20"/>autem rem omnem ex ipso, quem accipies <lb xml:id="p1z21"/>ita, ut inter fratres domini consuetum est.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z22"/>nihil est alias, de quo tibi amplius scribam.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z23"/>Si quid tu habueris scitu dignum, ad me, si <lb xml:id="p1z24"/>voles et otium sit, scribas.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale et domino <lb xml:id="p1z25"/>Christo, <foreign xml:lang="el">[griechisch]</foreign> principem meum <lb xml:id="p1z26"/>iam trimestri fere tempore absentem et <lb xml:id="p1z27"/>me tui studiosissimum precibus tuis commenda.</s>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p1z28"/>Domino <persName ref="p8011">Gualthero</persName> salutem ex me dicas.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Exa<lb xml:id="p1z29"/>rata 15. iulii anno etc. 49.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Tuus <lb xml:id="p1z30"/><persName ref="p2039">Michael Malerius</persName> <lb xml:id="p1z31"/>doctor etc.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro optimo doctissimo domino <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurina<lb xml:id="p2z3"/>e</placeName> doctori fidelissimo, domino <lb xml:id="p2z4"/>suo observando.</s>
					<s n="16" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
