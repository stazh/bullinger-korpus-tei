	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nondum convenit inter nos, quem missuri simus <placeName ref="l582">Zovingam</placeName><note xml:id="fn1" type="footnote" n="1">Zur geplanten Zusammenkunft in <placeName ref="l582">Zofingen</placeName> (<placeName ref="l594">Kt. Aargau</placeName>) siehe oben <ref target="file10584">Nr. 548</ref>.</note>, veniemus autem certo, <lb xml:id="p1z2"/>nisi aliud interim accidat, quod vobis proprio nuncio significemus.</s>
					<s n="3" xml:lang="la">Quodsi <persName ref="p8412">Megander</persName> iter <lb xml:id="p1z3"/>suscipere noluerit, suscipiam ego; nam egre uterque diutius abesse poterit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Hodie diacosii<note xml:id="fn2" type="footnote" n="2">der Große Rat.</note> creantur, <lb xml:id="p1z4"/>postera pasce<note xml:id="fn3" type="footnote" n="3">29. März 1535.</note> novus consul et tribuni, tercia feria<note xml:id="fn4" type="footnote" n="4">30. März 1535.</note> senatus.</s>
					<s n="5" xml:lang="la">Precare dominum, ut ostendat, qui sibi <lb xml:id="p1z5"/>ad hęc munia placeant.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Deinde paucis abhinc diebus vidi literas tuas aliis inclusas <lb xml:id="p1z6"/>a <placeName ref="l285">Lenczburg</placeName> <persName ref="p2278">consuli</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p2278">Hans Jakob von Wattenwyl</persName>.</note> nostro<note xml:id="fna" type="footnote" n="a">nostro <hi>übergeschrieben.</hi></note> missas<note xml:id="fn6" type="footnote" n="6"><persName ref="p8012">Sulpitius Haller</persName> hatte <persName ref="p495">Bullingers</persName> Briefe vom 5. bzw. 19. März 1535 (oben <ref target="file10580">Nr. 544</ref> und 558) nach <placeName ref="l41">Bern</placeName> weitergesandt, s. oben <ref target="file10596">Nr. 560</ref>, 3-10.</note>.</s>
					<s n="7" xml:lang="la">Tute certe sunt, sed si in alterius consulis manus venissent <lb xml:id="p1z7"/>etiam in reipublicae nostrę bonum, vereor, ne aliquando tu erga tuos accuseris, quasi omnia nostris significes.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z8"/>Poterit tamen in his cautius agere praefectus in <placeName ref="l285">Lenczburg</placeName><note xml:id="fn7" type="footnote" n="7"><persName ref="p8012">Sulpitius Haller</persName>.</note>.</s>
					<s n="9" xml:lang="de"><foreign xml:lang="la">Huius te monere volui</foreign>, dann ich bin <lb xml:id="p1z9"/>einest ergrempt<note xml:id="fn8" type="footnote" n="8">gewitzigt, durch Schaden klug geworden (<bibl source="b590">SI</bibl> II 732).</note>.</s>
				</p>
				<p>
					<s n="10" xml:lang="de">Kumm ich gen <placeName ref="l582">Zofingen</placeName> und wissen möcht, daß du gen <placeName ref="l285">Lenczburg</placeName> kummen weltist, <lb xml:id="p1z10"/>ich welti ouch dar<note xml:id="fn9" type="footnote" ana="lex" n="9">dorthin (<bibl source="b590">SI</bibl> XII 997f).</note> kummen.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Nuncius ille<note xml:id="fn10" type="footnote" n="10">Unbekannt.</note> <placeName ref="l473">S. Gallum</placeName> petet.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Quod de bonis ecclesiasticis nuper <lb xml:id="p1z11"/>apud nos<note xml:id="fnb" type="footnote" n="b"><hi>auch als</hi> tuos <hi>lesbar, was aber keinen Sinn ergibt.</hi></note> scripseram<note xml:id="fn11" type="footnote" n="11">Siehe oben <ref target="file10593">Nr. 557</ref>, 5-28.</note>, obsecro perpende apud te; nam videtur senatus noster toto cęlo errare, cum <lb xml:id="p1z12"/>nullam horum<pb type="edition" next="168"/> habeat rationem, quatenus in ecclesię et communem reipublicae christianae usum vertantur.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z13"/>Vale rursum, charissime <persName ref="p495">Heinrice</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">25. martii anno 35.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z14"/>Tuum <persName ref="p1391">minimum nummisma</persName><note xml:id="fn12" type="footnote" n="12">Wortspiel auf <persName ref="p1391">Haller</persName>.</note>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Heinrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesię <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>antistiti, fratri suo omnium <lb xml:id="p2z4"/>charissimo.</s>
				</p>
			</div>
		</body>
