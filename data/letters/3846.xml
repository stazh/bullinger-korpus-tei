	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">D. a <persName>Rischach</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p7730">Ludwig von Reischach</persName>?</note> tuę humanitati gratias agit; <lb xml:id="p1z2"/>sed cum d. <persName>Paulus a Mülinen</persName> nondum adfuerit, se interim <lb xml:id="p1z3"/>deliberaturum de suo negocio recepit.</s>
					<s n="3" xml:lang="la">De puero a <persName>Salicibus</persName> <lb xml:id="p1z4"/>ego quidem ultro in tui gratiam eius rationem haberem, <lb xml:id="p1z5"/>tametsi procul a me habitet; sed obstant conterranei eius, <lb xml:id="p1z6"/>inter quos ita vivit, ut monitorem alium vix ferat.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Sed efficiam, ut de ipso, si quid opus erit, scias.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>De secta <persName>Davidica</persName> cur scripserim et quid hic agatur, <lb xml:id="p1z9"/>alias fuse scribam; neque enim nunc licet ob silencii <lb xml:id="p1z10"/>fidem; ut autem maxime liceret, prolixius est negocium, <lb xml:id="p1z11"/>quam ut paucis perscribi possit.</s>
					<s n="6" xml:lang="la">Rerum novarum si <lb xml:id="p1z12"/>quid est, a filio accipies; ego ad praesens nihil habeo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z13"/>Bene vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l28">Basileę</placeName> 20. ianuarii 1559.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Tuus <lb xml:id="p1z14"/><persName ref="p1754">Io[annes] Iunius [Iungius?]</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro <lb xml:id="p2z2"/>d. <persName>Henrico Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> ecclesię <lb xml:id="p2z4"/>pastori vigilantissimo, <lb xml:id="p2z5"/>domino suo venerando <lb xml:id="p2z6"/>ac fratri charissimo<lb xml:id="p2z7"/>.</s>
				</p>
			</div>
		</body>
	</text>
