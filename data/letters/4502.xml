			<zone xml:id="p2z5-0" points="1656,1810 1670,1806 1683,1821 1717,1830 1821,1778 1877,1785 1888,1690 1818,1649 1789,1656 1730,1627 1700,1643 1675,1634">1666,1768 1693,1762 1720,1758 1747,1756 1775,1754 1802,1752 1829,1748 1856,1745 1884,1741</zone>
