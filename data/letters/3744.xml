	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Fui per dies plus quam 14 adflicta ad<lb xml:id="p1z2"/>modum valetudine necdum revalui plene.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Ideo toto hoc tempore nihil potui scribere <lb xml:id="p1z4"/>neque vero adhuc prolixas exarare possum.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Clarissimo d. legato regio indicabis me eius <lb xml:id="p1z6"/>accepisse literas et agere illi gratias pro eius fide <lb xml:id="p1z7"/>et diligentia salutareque perquam humaniter.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Amplissimus vir d. <persName ref="p629">Coignetius</persName> praeterita die domin<lb xml:id="p1z9"/>ica hic erat; sed per infirmitatem non po<lb xml:id="p1z10"/>tui illum accedere.</s>
					<s n="6" xml:lang="la">Ipse pro sua humanitate <lb xml:id="p1z11"/>me accedebat ac salutabat.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Quae nova sunt <lb xml:id="p1z12"/>de expeditione in <placeName ref="l882">Hungariam</placeName> <placeName ref="l2510">Turcica</placeName>, audi<lb xml:id="p1z13"/>visti haud dubie a clarissimo viro d. <persName ref="p8432">Friderycho <lb xml:id="p1z14"/>a Salice</persName>, cuius literas accepi scriptas ex <placeName ref="l546">Vienn<lb xml:id="p1z15"/>a</placeName> omnes, deinde etiam postremas ex <placeName ref="l440">Samada</placeName> <lb xml:id="p1z16"/>una cum literis mei filii <persName ref="p475">Christophori</persName>.</s>
					<s n="8" xml:lang="la">Nihil ei <lb xml:id="p1z17"/>respondeo, maxime quod ipsum vel filium eius ad <lb xml:id="p1z18"/>me propediem venturum expecto totumque colloquium <lb xml:id="p1z19"/>in illud tempus reservo.</s>
					<s n="9" xml:lang="la" ana="salute">Salutabis <lb xml:id="p1z20"/>illum et totam illam familiam nomine mei humanissime.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Venit ad nos nuncius missus ex <placeName ref="l2472">Polonia</placeName>, <lb xml:id="p1z22"/>minister d. <persName ref="p8041">Ioannis a Lasco</persName>, cum literis copiosis <lb xml:id="p1z23"/>de toto vel universo statu eius regni.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Breviter: <lb xml:id="p1z24"/>propagatur mirum in modum syncera evangelii <lb xml:id="p1z25"/>Iesu Christi praedicatio; sed mirifice opponunt <lb xml:id="p1z26"/>se episcopi cum clero.</s>
					<s n="12" xml:lang="la">Sed ita comparatum <lb xml:id="p1z27"/>est ab initio; haec res nonnisi maximis la<lb xml:id="p1z28"/>boribus paratur.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Accepi ab illo nuncio et <lb xml:id="p1z29"/>has literas d. <persName ref="p8022">Francisco Nigro</persName> inscriptas, quas, <lb xml:id="p1z30"/>oro, diligenter curare digneris.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Ex <placeName ref="l808">Belgico</placeName> <lb xml:id="p1z31"/>nihil habemus, nisi quod coeptum sit agi de <lb xml:id="p1z32"/>pace.</s>
					<s n="15" xml:lang="la" ana="salute">Dominus illud nobis omnibus concedat, <lb xml:id="p1z33"/>quod salutare est.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell">Vive et vale cum d. <persName>Philippo</persName>, <lb xml:id="p1z34"/>d. <persName ref="p6130">Pontasella</persName>, d. d. consulibus et omnibus bonis etc.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z35"/><placeName ref="l587">Tiguri</placeName> 28. octobris 1558.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Comitia <lb xml:id="p1z36"/><placeName ref="l21">Badensia</placeName> nondum sunt finita.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Abbates nescio <lb xml:id="p1z37"/>quid mali ecludunt.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Dominator dominus respiciat <lb xml:id="p1z38"/>in consilia hominum et rependat <lb xml:id="p1z39"/>cuique pro suo iudicio sancto etc.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z40"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae fideli ministro, <lb xml:id="p2z4"/>compatri et fratri suo <lb xml:id="p2z5"/>dilectissimo.</s>
					<s n="23" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
