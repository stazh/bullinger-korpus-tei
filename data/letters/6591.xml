	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D<lb xml:id="p1z2"/>.</s>
					<s n="2" xml:lang="la">Nullas adhuc a te accepi literas dubitans te non meas <lb xml:id="p1z3"/>accepisse; nam flagranti desiderio teneor tuarum literarum.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Pater meus charissimus me una cum cognato meo in collegio <lb xml:id="p1z5"/><placeName>Praeles</placeName> collocavit cum docto et erudito praeceptore, cui existimo <lb xml:id="p1z6"/>ad nos erudiendos operam non defuturam, mihique neque animus <lb xml:id="p1z7"/>deerit, et existimo me tam bene tempus consumturum, ut tibi <lb xml:id="p1z8"/>satis in offitio meo fatiam.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Cęterum si quid de nostra valetudine <lb xml:id="p1z9"/>scire cupis, scito me prospera valetudine frui, quod utinam et vos <lb xml:id="p1z10"/>eadem valetudine fruamini.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Nihil novi iam habeo, quid tibi <lb xml:id="p1z11"/>aut scribam au mandem; sed alias copiosius, cum plus otii <lb xml:id="p1z12"/>nactus ero, ad te scribam.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Finem itaque meae epistolae fatiam.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute"><lb xml:id="p1z13"/>Salutes, obsecro, meo nomine <persName ref="p5035">Veritatem</persName> et <persName ref="p5034">Torotheam</persName> omnesque <lb xml:id="p1z14"/>nostros, quos novistis familiarissimos.</s>
					<s n="8" xml:lang="la" ana="salute">Parentes omnes charissimi et <persName ref="p3050">Stu<lb xml:id="p1z15"/>ckius</persName> te plurimum salvere iubent.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Vale in Christo, qui te semper incolumem <lb xml:id="p1z16"/>conservare velit.</s>
					<s n="10" xml:lang="la">Datum in museo quarto nonas decembris 1565.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z17"/>Tuus semper dilectissimus semperque <lb xml:id="p1z18"/>obedientissimus <persName ref="p613">filius <lb xml:id="p1z19"/>Mathaeus Coignetius</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo et amplissimo <lb xml:id="p2z2"/>viro d. <persName ref="p495">Heinrico Bulingero</persName> <lb xml:id="p2z3"/>p[atri], ecclesiae <placeName ref="l587">Tigurinae</placeName> vigilantis<lb xml:id="p2z4"/>simo, plurimum observando.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="de"><lb xml:id="p2z7"/>Zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>