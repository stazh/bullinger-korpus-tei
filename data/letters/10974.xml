	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi nuper<note xml:id="fn1" type="footnote" n="1">Am 30. Dezember 1536 (<bibl source="b8">HBBW VI</bibl>, <ref target="file10972">Nr. 930</ref>).</note> me amandatum cum fratre germa<lb xml:id="p1z2"/>no<note xml:id="fn2" type="footnote" n="2"><persName ref="p4082">Konrad Zwick</persName>.</note> <placeName ref="l491">Argentoratum</placeName>.</s>
					<s n="3" xml:lang="la">Sed mala valetudo primum <lb xml:id="p1z3"/>fratris impedivit legationem.</s>
					<s n="4" xml:lang="la">Deinde, postquam restitutus <lb xml:id="p1z4"/>est frater, veniunt litterę a principe electore<note xml:id="fn3" type="footnote" n="3">Gemeint ist die von Kurfürst <persName ref="p19065">Johann Friedrich von Sachsen</persName> und Landgraf <persName ref="p3590">Philipp von Hessen</persName> unterzeichnete Einladung zu einem Bundestag in <placeName ref="l1202">Schmalkalden</placeName> (<bibl source="b668">Volz, Urkunden</bibl> 79-81), die am 6. Januar in <placeName ref="l257">Konstanz</placeName> eintraf; s. <hi>Moeller,</hi> <persName ref="p4079">Zwick</persName> 192.</note>, in <lb xml:id="p1z5"/>quibus convocat, quicunque in evangelico illo <lb xml:id="p1z6"/>fędere, ad consultandum de futuro concilio.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Hinc nostri sumpta occasione legationem <lb xml:id="p1z8"/>ad <placeName ref="l491">Argentinenses</placeName> omnino differendam existima<lb xml:id="p1z9"/>verunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Haec paucis scire te volui.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Brevi addam alia<note xml:id="fn4" type="footnote" n="4">Siehe unten <ref target="file10982">Nr. 940</ref>.</note>; iam enim ad <persName ref="p8055">Ambrosium</persName><note xml:id="fn5" type="footnote" n="5">Zu <persName ref="p8055">Ambrosius Blarer</persName> nach <placeName ref="l512">Tübingen</placeName>.</note> <lb xml:id="p1z11"/>proficiscor.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Vale millies cum omnibus <lb xml:id="p1z12"/>fratribus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">10. ianuarii <lb xml:id="p1z13"/>1537.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/>Tuus <persName ref="p4079">Io. Zwick</persName>.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z15"/>Hanc pecuniam dato <persName ref="p1753">Leoni</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p1753">Leo Jud</persName>.</note>.</s>
					<s n="12" xml:lang="la">Sunt, ni fallor, aurei <lb xml:id="p1z16"/>quinque, quos mittendos illi misit <persName ref="p3866">Wilhelmus a Zell</persName>.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z17"/>Caeterum nullas litteras accepi pecuniae coniunctas.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z18"/>Utinam conciliorum quorundam parum <lb xml:id="p1z19"/>auspicatorum exempla a te habere possem!</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Hainricho <lb xml:id="p2z2"/>Bullingero</persName>, fratri <lb xml:id="p2z3"/>suo syncerissimo.</s>
				</p>
			</div>
		</body>
