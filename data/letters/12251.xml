					<s n="8" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem christenlichen unnd hochgelerten <lb xml:id="p2z2"/>herrn <persName ref="p495">Hainrichen Bullinger</persName>, vorgeern der <lb xml:id="p2z3"/>kirchen zu <placeName ref="l587">Zürch</placeName>, unnserm lieben herrn <lb xml:id="p2z4"/>unnd freünndt<note xml:id="fn13" type="footnote" n="13">Der Brief traf am 6. August 1545 in <placeName ref="l587">Zürich</placeName> ein; s. unten <ref target="file12256">Nr. 2209</ref>, 16f.</note>.</s>
