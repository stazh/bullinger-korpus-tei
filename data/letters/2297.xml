	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, mi d. <persName ref="p495">Bul[lingere]</persName>.</s>
					<s n="2" xml:lang="la">Scio te a magistratu tuo audivisse <lb xml:id="p1z2"/>et intellexisse, que nuper scripsi.</s>
					<s n="3" xml:lang="la">Hoc me <lb xml:id="p1z3"/>a scribendo retardavit; nihil enim istis <lb xml:id="p1z4"/>poteram addere.</s>
					<s n="4" xml:lang="la">Iam autem addo regem <lb xml:id="p1z5"/><placeName ref="l830">Anglie</placeName>, amicum et affinem nostrum cum maximo <lb xml:id="p1z6"/>totius <placeName ref="l832">Gallie</placeName> dolore ad mortem usque <lb xml:id="p1z7"/>egrotasse a quindecim diebus et pro mortuo <lb xml:id="p1z8"/>per duos dies iacuisse.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Interea <persName ref="p18538">Cesar</persName> cum <lb xml:id="p1z9"/>suis practicis misit, qui filias <lb xml:id="p1z10"/>duas heredes regni post mortem fratris <lb xml:id="p1z11"/>interciperent arte vel vi, si aliter fieri <lb xml:id="p1z12"/>non posset, ut unam filio, principi scilicet <lb xml:id="p1z13"/><placeName ref="l875">Hispanie</placeName> daret in matrimonium et <lb xml:id="p1z15"/>sic regnum obtineret.</s>
					<s n="6" xml:lang="la">Ecce ex <lb xml:id="p1z16"/>dei voluntate hic ex inopinato, <lb xml:id="p1z17"/>ope etiam medicorum, inter quos summus est <lb xml:id="p1z18"/><persName>Gallus</persName>, reiecit per os infinitum <lb xml:id="p1z19"/>toxicum et iam incipit, imo bene habet, <lb xml:id="p1z20"/>nec desunt, qui affirment ope et <lb xml:id="p1z22"/>auxilio <persName ref="p18538">Caesaris</persName> talia perpetrata.</s>
					<s n="7" xml:lang="la" ana="salute">Deus det <lb xml:id="p1z23"/>illi meliorem mentem et tibi salutem; nihil <lb xml:id="p1z24"/>enim praeterea habeo, nisi quod <persName ref="p3375">Vergerii</persName> hodie literas <lb xml:id="p1z25"/>ex <placeName ref="l441">Schaffusia</placeName> accepi, et scribit se in ducatum <pb/><lb xml:id="p2z1"/>Wirttembergensem properare<note type="margin">a.R.: Anhaltspunkt für die Datierung.</note>, quod mihi est <lb xml:id="p2z2"/>gratum.</s>
					<s n="8" xml:lang="la">Cupio maxime, ut proximo <lb xml:id="p2z3"/>convente <placeName ref="l21">Baddensi</placeName> tuus magistratus secun<lb xml:id="p2z4"/>dum tenorem tractatuum pacis non <lb xml:id="p2z5"/>recipiat hostem ducem <placeName ref="l1098">Florentinum</placeName> <lb xml:id="p2z6"/>vel saltem legatum, qui a Caesare, <lb xml:id="p2z7"/>papa et aliis eiusmodi hominibus <lb xml:id="p2z8"/>immittitur, ut nostram concordiam et <lb xml:id="p2z9"/>amicitiam per practiquas <lb xml:id="p2z10"/>interturbet.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Vale, optime et unice.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z11"/>Datum in <placeName ref="l760">Soluturo</placeName> 29. maii<note type="margin">a.R.: 23? 27</note>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z12"/>Tuus sem<lb xml:id="p2z13"/>p<lb xml:id="p2z14"/>er <lb xml:id="p2z15"/><persName ref="p8296">Bassef[o<lb xml:id="p2z16"/>ntaneus]</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z17"/>Non est credibile, quomodo seviat ille <lb xml:id="p2z18"/>marquio in omes absque discrimine, <lb xml:id="p2z19"/>omnium hostis, et crede mihi, iam <lb xml:id="p2z20"/>factus est potens; nam fere <lb xml:id="p2z21"/>viginti millia bonorum militum <lb xml:id="p2z22"/>habet et tria equitum et quia miles sub <lb xml:id="p2z23"/>eo inpune grassatur, unusquisque militatum <lb xml:id="p2z24"/>ad eum sed recipit spe rapinę.</s>
					<s n="13" xml:lang="la">Non <lb xml:id="p2z25"/>est eius scopus, ut diu hereat prope <placeName ref="l361">Nurenbergam</placeName>, <lb xml:id="p2z26"/>ubi nunc est; sed sentimus et scimus illum <lb xml:id="p2z27"/>vocari alio a Caesare, ut nuper tuis scripsi.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo et optimo <lb xml:id="p4z2"/>viro d. <persName ref="p495">Bullingero</persName>.</s>
					<s n="15" xml:lang="la"><lb xml:id="p4z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
