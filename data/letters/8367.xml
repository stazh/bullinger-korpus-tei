	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>d. Accepu malure salis, qua ad me mixisti
					<lb xml:id="p1z2"/>reges descriptas, carissimus viri d. Zrasli Tinguli
					<lb xml:id="p1z3"/>et intimi mei amici. et pro vx tibi quas
					<lb xml:id="p1z4"/>popum gratia ago maxima repensurus etiam
					<lb xml:id="p1z5"/>tipes occasionem aliquando dabitur. Non puto
					<lb xml:id="p1z6"/>autem d. Begam librum illum tuum, quo pless
					<lb xml:id="p1z7"/>te confutaste existimas, et quem privalim ad
					<lb xml:id="p1z8"/>hucnihil eculsaturum; Quantum enim
					<lb xml:id="p1z9"/>possumus obtistimux, ne alię quoque natera mo
					<lb xml:id="p1z10"/>penaluelitium, ac speramur illum tuam illam
					<lb xml:id="p1z11"/>eonsionem privatim tibi sesuaturum. Crte
					<lb xml:id="p1z12"/>icvulgaret eis haec noshi Aragli abitertio opi
					<lb xml:id="p1z13"/>acrertus dubito, an na vir alioquin magnu
					<lb xml:id="p1z14"/>am tibi auttoritatem quam aune obtinet
					<lb xml:id="p1z15"/>audmultor retineret. Ego domnum orare non
					<lb xml:id="p1z16"/>desino vl pacem cncendat ecclesiae tuae.
					<lb xml:id="p1z17"/>prudentissime fecemus, ne quid aliud dicam
					<lb xml:id="p1z18"/>qui civati suns praeclarissime. horce viro vales tese
					<lb xml:id="p1z19"/>committere, et debunt deo vindici poctrum, dominu
					<lb xml:id="p1z20"/>i benedicas tibi oteret te tuuque in aetes
					<lb xml:id="p1z21"/>Vale, vir clarissime, domine honorande etfrat,
					<lb xml:id="p1z22"/>in domino charissimos <placeName ref="l587">Tiguri</placeName> 27. augusti 1570.
					<lb xml:id="p1z23"/>Tuus Bullingerus.
					<lb xml:id="p1z24"/>alutare dignem, oro praefectum Roetelensem
					<lb xml:id="p1z25"/>illum ab Ullma veterem et mihi charissime domino ali
					<lb xml:id="p1z26"/>aminem.
					<lb xml:id="p1z27"/>insptio
					<lb xml:id="p1z28"/>Clarissimo viro d. Ioanni Iacobo Grynaeo Rotulae
					<lb xml:id="p1z29"/>in charitionatu agenti, domino meo dinorando
