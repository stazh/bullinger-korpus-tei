	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Decades tuas, munus mihi multis nominibus gratissimum, vir claris<lb xml:id="p1z3"/>sime, bona fide accepi, pro quo merito ingenteis tibi gratias <lb xml:id="p1z4"/>ago, quandoquidem referendi facultas nondum offeratur.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Dabo tamen pro virili operam, ne tibi (cuius amicitiam ob er<lb xml:id="p1z6"/>uditionis atque nominis splendorem ambire nunquam ausus fuissem <lb xml:id="p1z7"/>nisi humanitate invitatus) videatur esse ingratus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Tuum igitur erit, ut ei, quem semel in amicorum accepisti nu<lb xml:id="p1z9"/>merum, sicubi opus fuerit, pro tuo iure praecipias.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Libros autem, de quibus nuper scripsi, iam dudum <persName ref="p18291">Petro Mech<lb xml:id="p1z11"/>lingensi</persName> tibi cum caeteris, quae ad <persName ref="p8171">Theodorum</persName>, <persName ref="p8127">Pelli<lb xml:id="p1z12"/>canum</persName>, avunculum colendissimum, atque <persName ref="p1214">Frisium</persName> spectant, perferendos <lb xml:id="p1z13"/>tradidi; sed literas absque fasciculo ob vectoris nimiam <lb xml:id="p1z14"/>festinationem tantum misit.</s>
					<s n="6" xml:lang="la">Curabo tamen, ut proxima <lb xml:id="p1z15"/>oportunitate accipiatis omnia.</s>
					<s n="7" xml:lang="la">Novarum rerum plane <lb xml:id="p1z16"/>nihil habemus, quae vos latere putem; expectamus enim <lb xml:id="p1z17"/>subinde nuntios atque exploratores nostros, ex quibus mox <lb xml:id="p1z18"/>audiemus, qua demum ratione <placeName ref="l157">Francfordiensium</placeName> negotium <lb xml:id="p1z19"/>bellicum a principibus sit transactum.</s>
					<s n="8" xml:lang="la">Spargitur <lb xml:id="p1z20"/>et apud nos etiam de pacificatione Germaniae principum <lb xml:id="p1z21"/>cum imperatore nescio quae fama, cui nondum <lb xml:id="p1z22"/>fidem adhibemus a <persName ref="p2916">Schertlini</persName> filio persuasi, cui <lb xml:id="p1z23"/>cum ante quatriduum ex <placeName ref="l18">Augusta Vindelicorum</placeName> ad <lb xml:id="p1z24"/>nos venisset, de ea pace nihil se quicquam audivisse <lb xml:id="p1z25"/>dicebat.</s>
					<s n="9" xml:lang="la">Scripsit et nuper Caesaris anima <persName ref="p6920">Wesalius</persName> <lb xml:id="p1z26"/>ad <persName ref="p8126">Oporinum</persName> nostrum, cui subinde Caesaris fortunas <lb xml:id="p1z27"/>per literas praedicare solitus erat, cuius tamen <lb xml:id="p1z28"/>ne verbo quidem iam mentionem fecit.</s>
					<s n="10" xml:lang="la">Verum, quid <lb xml:id="p1z29"/>moliatur, ipsa dies mox indicabit.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Tu vale et <lb xml:id="p1z30"/>vive nobis et ecclesiae <placeName ref="l587">Tigurinae</placeName> diu salvus.</s>
					<s n="12" xml:lang="la">18. <lb xml:id="p1z32"/>calendas septembris <placeName ref="l28">Basileae</placeName> <lb xml:id="p1z33"/>anno 1552.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z34"/>T[uus] <lb xml:id="p1z35"/><persName ref="p8406">Conradus Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>pastori omnium vigilantissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
