	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et misericordiam a domino.</s>
					<s n="2" xml:lang="la">Literis meis incomptis non cesso te <lb xml:id="p1z2"/>molestare, charissime frater.</s>
					<s n="3" xml:lang="la"><persName ref="p20482">Paulus Blasii</persName> nuper domum <lb xml:id="p1z3"/>paternam rediit et post paucos dies pestilentiae contagio <lb xml:id="p1z4"/>correptus diem suum obiit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Titus illum domum veniens e <placeName ref="l587">Tiguro</placeName> a<lb xml:id="p1z5"/>egrotum reperit.</s>
					<s n="5" xml:lang="la">Die divi Martini nocte vitam finivit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/>Contraxit eas alienum <placeName ref="l28">Basileae</placeName> non modicum; ea causa literas <lb xml:id="p1z7"/>ad m[agistrum]</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><persName ref="p5047">Thomam Grinęum</persName> mittimus, ne expensae inopinatę <lb xml:id="p1z8"/>succrescant.</s>
					<s n="8" xml:lang="la">Da igitur operam, ut literae illae <persName ref="p5047">Grinęo</persName>, in coenobio <lb xml:id="p1z9"/>Augustinensium magistro, reddantur cito.</s>
					<s n="9" xml:lang="la">De filiola mea tibi curam <lb xml:id="p1z10"/>committo, et si quid opus fuerit me facere, fac ut sciam.</s>
					<s n="10" xml:lang="la"><persName>Titus</persName> in <lb xml:id="p1z11"/>domo paterna moratur; solliciti sumus, ne et illum pestis corripiat; <lb xml:id="p1z12"/>nondum enim in totum sedata est.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale.</s>
					<s n="12" xml:lang="la">Ex <placeName ref="l98">Curia</placeName>, 17. novembris <lb xml:id="p1z13"/>1550.</s>
					<s n="13" xml:lang="la" ana="salute">Salutant te plurimum <persName ref="p8013">Lutius Haim</persName>, iam denuo <lb xml:id="p1z14"/>consul electus, et <persName ref="p6130">Iohannes Pontasella</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z15"/>Tuus totus <persName ref="p654">Ioannes Comander</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro, <lb xml:id="p2z2"/>magistro <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori <lb xml:id="p2z4"/>vigilantissimo, domino <lb xml:id="p2z5"/>suo et amico precipuo.</s>
				</p>
			</div>
		</body>
	</text>
