	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p714">C[oelius] <lb xml:id="p1z2"/>S[ecundus] C[urio]</persName> S. D. per Christum Iesum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Quantam laudem in sanctorum coetu mereantur, <lb xml:id="p1z4"/>optime frater, qui <placeName ref="l2688">Aegyptiorum</placeName> spretis thesauris <lb xml:id="p1z5"/>et reliquis, quae apud ipsos in maximis habentur <lb xml:id="p1z6"/>bonis proprum Christi subeunt, non est quod te <lb xml:id="p1z7"/>unum omnium doceam.</s>
					<s n="3" xml:lang="la">Hoc fecerunt hi duo viri <lb xml:id="p1z8"/>nobilis <persName ref="p20923">Franciscus Bettus</persName> <placeName ref="l425">Romanus</placeName> et <persName>Iacobus Con<lb xml:id="p1z9"/>tius</persName> <placeName ref="l1107">Tridentinus</placeName>, uterque maximis apud suos <lb xml:id="p1z10"/>principes functus muneribus, <persName ref="p20923">Bettus</persName> apud <placeName ref="l2710">Piscariam</placeName>, <lb xml:id="p1z11"/>contius <persName ref="p7646">Madrucium cardinalem</persName>, <placeName ref="l736">Insubrium</placeName> <lb xml:id="p1z12"/>proregem.</s>
					<s n="4" xml:lang="la">Viri sunt pietate, ingenio et literis <lb xml:id="p1z13"/>non contemnendi, tuo et bonorum reliquorum, qui <lb xml:id="p1z14"/>apud vos sunt, amicitia et consuetudine digni.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Quod nunc fecerunt, ante annum hic se fa<lb xml:id="p1z16"/>cturos mihi promiserunt.</s>
					<s n="6" xml:lang="la"><placeName ref="l587">Tigurum</placeName> se conferunt, <lb xml:id="p1z17"/>ut nostros hominess et vestros, si possint, audient <lb xml:id="p1z18"/>et proficient magis.</s>
					<s n="7" xml:lang="la">Non est, quod <note type="misc">wiederholt</note> dubites <lb xml:id="p1z19"/>hos unquam vobis aut dedecus aut incommode futuros; <lb xml:id="p1z20"/>sunt enim tum a pietate et modestia tum <lb xml:id="p1z21"/>a reliquis rebus parati et instructi.</s>
					<s n="8" xml:lang="la">Hos, si <lb xml:id="p1z22"/>quid mea fides, si quid antique necessitudo inter n<lb xml:id="p1z23"/>os valet, tibi commendatos cupio, ut intelligent <lb xml:id="p1z24"/>se ad fraatres, ad patres atque ad suam civitatem, <lb xml:id="p1z25"/>dum futuram inquirunt, tantisper venisse.</s>
					<s n="9" xml:lang="la">De <lb xml:id="p1z26"/>mea petitione e superioribus literis nihil dicam, <lb xml:id="p1z27"/>nisi me abs te eandem benevolentiam expectare, <lb xml:id="p1z28"/>quam hactenus sum expertus.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale cum tota domo.</s>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p1z29"/>Salutant te et tuos mei.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l28">Basileae</placeName> calendis iulii 1557<pb/><lb xml:id="p2z22"/>.</s>
				</p>
