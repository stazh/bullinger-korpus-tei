	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Altum tuum silentium satis mirari non possum <lb xml:id="p1z2"/>in hoc rerum statu, in quo argumenta scribendi se quotidie offerunt <lb xml:id="p1z3"/>locupletissima.</s>
					<s n="3" xml:lang="la">Quid agit miles <placeName>Bolwilerianus</placeName>, quem aiunt ali pecunia <lb xml:id="p1z4"/>pfafforum et Iudaeorum?</s>
					<s n="4" xml:lang="la">Moses enim <placeName>Merspurgensis</placeName> Iudaeus, dedit 14000 fl. <lb xml:id="p1z5"/>mutuo; monachi etiam conferunt magnam pecuniam conflatis sacris vasibus.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Ubi alius miles apud nos collectus haeret, obsecro, dic.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Colligitur no<lb xml:id="p1z7"/>vus exercitus in <placeName>Marckeltzen</placeName> (est oppidulum in episcopatu <placeName ref="l491">Argentoratensi</placeName>); <lb xml:id="p1z8"/>habent 15 signa, puto <placeName ref="l64">Brisaci</placeName> per <placeName ref="l2459">Rheni</placeName> pontem ituros ad <placeName>Herciniam</placeName> <lb xml:id="p1z9"/>sylvam.</s>
					<s n="7" xml:lang="la"><placeName>Mauritianis</placeName> negotia facient, quum exercitus sit divisus in duas <lb xml:id="p1z10"/>partes.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><persName>Marchio Brandeburgensis</persName> <placeName ref="l157">Francofordiam cis Moenum</placeName> oppugnaturus <lb xml:id="p1z11"/>est, et lantgravius iunior urget ob damnum, quod intulerunt milites <lb xml:id="p1z12"/>rusticis suis.</s>
					<s n="9" xml:lang="la">Erit oppugnatio gravis.</s>
					<s n="10" xml:lang="la">Revocarunt <placeName ref="l157">Francofordienses</placeName> suos <lb xml:id="p1z13"/>cives e nundinis <placeName ref="l491">Argentoratensibus</placeName> et rogarunt, ut cito pede se domum <lb xml:id="p1z14"/>conferant, ni periclitari velint.</s>
					<s n="11" xml:lang="la">Habet apud se 15 signa, duo in <lb xml:id="p1z15"/>civitate, alia extra civitatem in pratis.</s>
					<s n="12" xml:lang="la">De Caesare nihil audimus, <lb xml:id="p1z16"/>fortassis Villaci aegrotat aut insanit, ut quidam constanter affirmant, <lb xml:id="p1z17"/>neque mirum debet esse, si in hoc morbi genus inciderit, quum ex alto <lb xml:id="p1z18"/>gradu fere deiectus sit.</s>
					<s n="13" xml:lang="la">Gallus <placeName ref="l808">Belgas</placeName> petit infesto exercitu.</s>
					<s n="14" xml:lang="la">Quid <lb xml:id="p1z19"/>autem <persName ref="p18250">Mauritius</persName> agat cum suis militibus, nihil certi audimus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Com<lb xml:id="p1z20"/>ponunt articulos, nescio quos; sed interim <persName>Caesar</persName> conscribit militem <lb xml:id="p1z21"/>ex omnibus angulis.</s>
					<s n="16" xml:lang="la">Quid futurm vero sit, dominus novit, quem precari <lb xml:id="p1z22"/>debemus assiduo pro tranquillitate tam in evangelio divulgando <lb xml:id="p1z23"/>quam in vere pace assequenda.</s>
					<s n="17" xml:lang="la">Pręterea tibi commendo hos adolescentes <lb xml:id="p1z24"/>et doctos et pios; alter est doctor medicinę, ni fallor, alter stu<lb xml:id="p1z25"/>diosus iurisprudentię.</s>
					<s n="18" xml:lang="la">Ex <placeName ref="l834">Italia</placeName> veniunt ad nos, ex quibus poteris <lb xml:id="p1z26"/>statum <placeName ref="l834">Italiae</placeName>, <placeName ref="l522">Venetiarum</placeName>, <placeName ref="l994">Neapolitani</placeName> regni perquirere, imo etiam <lb xml:id="p1z27"/>de <placeName ref="l2510">Turcicis</placeName> legatis, qui nuper <placeName ref="l522">Venetiis</placeName> fuere.</s>
					<s n="19" xml:lang="la" ana="farewell">Vale.</s>
					<s n="20" xml:lang="de">12. iulii 1552.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z28"/>Nihil scripsi d. <persName ref="p8171">Theodoro</persName>, quem in singulas horas expecto, cui precor <lb xml:id="p1z29"/>felicia quęque.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">T[uus] <lb xml:id="p1z30"/><persName ref="p1278">Gastius</persName> <placeName ref="l28">B[asiliensis]</placeName> <lb xml:id="p1z31"/>ex animo.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pio et erudito viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, pastori ecclesiae <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> vigilantis<lb xml:id="p2z5"/>simo, praeceptori suo <lb xml:id="p2z6"/>perpetuo colendo.</s>
					<s n="24" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
