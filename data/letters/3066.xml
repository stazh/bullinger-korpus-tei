	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Literas tuas accepi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la" ana="salute">Salutationes tuae ex animo paterno <lb xml:id="p1z2"/>profectae plurimum me affecerunt.</s>
					<s n="4" xml:lang="la">Ego cum ecclesiam <lb xml:id="p1z3"/>remque publicam <placeName ref="l862">Helveticam</placeName> integram adhuc esse audio, mag<lb xml:id="p1z4"/>nam ad valetudinis meae secundae partem statuo.</s>
					<s n="5" xml:lang="la">Nam <lb xml:id="p1z5"/>et relligionis ac politicae disciplinae cultum hinc uti hac<lb xml:id="p1z6"/>tenus in alias nationes regnaque sic ad nos tandem <lb xml:id="p1z7"/>plurimasque insulas disseminari posse confidimus.</s>
					<s n="6" xml:lang="la">In <lb xml:id="p1z8"/>quo certe opere studiumque multum collocastis atque ita <lb xml:id="p1z9"/>deinceps faciundum putabitis.</s>
					<s n="7" xml:lang="la">Res se hic ecclesi<lb xml:id="p1z10"/>asticae eodem quo hactenus modo habent.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/>Privatim tamen plur quam hactenus Christo ad<lb xml:id="p1z12"/>iiciuntur membra.</s>
					<s n="9" xml:lang="la">Cessat nunc aliquamdiu publica <lb xml:id="p1z13"/>in partibus his christianorum persequutio.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Studia <lb xml:id="p1z14"/>mea paulo sunt perturbatiora.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Alias plura median<lb xml:id="p1z15"/>te domino.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Salutabis totam domum tuam, cui me <lb xml:id="p1z16"/>favore beneficiisque devinctum fateor.</s>
					<s n="13" xml:lang="la">Dabitur, ut <lb xml:id="p1z17"/>spero, aliquando de eisdem benemerendi occasio.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z18"/><placeName ref="l185">Groningae</placeName> <placeName ref="l642">Phrysiorum</placeName> anno nativitatis Christi <lb xml:id="p1z19"/>1557. 8. calendas ianuarii.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p8508">Nicolaus a Starkenburg</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Celeberrimo viro verbi divin<lb xml:id="p2z2"/>i ministro vigilantissimo <lb xml:id="p2z3"/>hae literae.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tyguri</placeName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
