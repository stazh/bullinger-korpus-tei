	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et vitae innocentiam a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Nihil nunc habeo, frater in do<lb xml:id="p1z2"/>mino colendissime, quod scribam, nisi quod maximas tibi gratias ago pro <lb xml:id="p1z3"/>tua illa in <persName ref="p8011">Rodolphum</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8011">Rudolf Gwalther</persName>.</note> insigni humanitate exhibita<note xml:id="fn2" type="footnote" n="2"><persName ref="p8418">Myconius</persName> hatte <persName ref="p8011">Gwalther</persName> nach dessen Rückkehr aus <placeName ref="l491">Straßburg</placeName> wieder in sein Haus aufgenommen; vgl. oben <ref target="file11273">Nr. 1230</ref>, 32; 1232, 12-15.</note>.</s>
					<s n="3" xml:lang="la">Dominus sit <lb xml:id="p1z4"/>merces tua.</s>
					<s n="4" xml:lang="la">Quicquid autem huic impenderis, mihi impensum <lb xml:id="p1z5"/>putabo.</s>
					<s n="5" xml:lang="la">Amo enim ingenuitatem et candorem adolescentis, [p]upilli alioqui<note xml:id="fna" type="footnote" n="a">[p]upilli alioqui <hi>am Rande nachgetragen; Rand beschädigt.</hi></note><note xml:id="fn3" type="footnote" n="3">Vgl. <bibl source="b10">HBBW VIII</bibl> <ref target="file11193">[Nr. 1150]</ref>, S. 177, Anm. 5.</note>.</s>
					<s n="6" xml:lang="la">Oro ergo, <lb xml:id="p1z6"/>ut pater illius esse velis, sancte educes et a lubricitate pravitateque, <lb xml:id="p1z7"/>imo stoliditate iuvenili abstrahas.</s>
					<s n="7" xml:lang="la">Rogabis praeterea <lb xml:id="p1z8"/>meo nomine <persName ref="p1365">Grynaeum</persName>, eius meminerit, quod ei<note xml:id="fnb" type="footnote" n="b">ei <hi>anstelle von gestrichenem</hi> cum es[?] <hi>über der Zeile nachgetragen.</hi></note>, dum <placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z9"/>esset<note xml:id="fn4" type="footnote" n="4">Anläßlich der <placeName ref="l587">Zürcher</placeName> Konkordientagung von Ende April /Anfang Mai 1538 (vgl. <persName ref="p3067">Stumpf</persName>, Abendmahlsstreit 111).</note>, de <persName ref="p8011">Rodolpho</persName> suggerebam<note xml:id="fn5" type="footnote" n="5"><persName ref="p495">Bullinger</persName> muß mit <persName ref="p1365">Grynäus</persName> über die Aufnahme von <persName ref="p8011">Gwalther</persName> in sein Haus gesprochen haben; vgl. unten <ref target="file11288">Nr. 1245</ref>, 24-28; 1252, 25-30.</note>, et ut illum sibi habeat commendatum.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Recognovi hac hyeme libellos illos meos ante decennium De <lb xml:id="p1z11"/>origine erroris aeditos<note xml:id="fn6" type="footnote" n="6">Zur Neubearbeitung von "De origine erroris libri duo" s. oben <ref target="file11280">Nr. 1237</ref>, Anm. 7.</note>, imo veluti novos magnis sudoribus<note xml:id="fnc" type="footnote" n="c">magnis sudoribus <hi>am Rande nachgetragen.</hi></note> feci in gratiam <lb xml:id="p1z12"/>studiosorum et in assertionem veritatis, quam pontifitii omnibus <lb xml:id="p1z13"/>modis oppugnant.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Non displicebit, spero, bonis labor <lb xml:id="p1z14"/>noster.</s>
					<s n="10" xml:lang="la">Mitto autem tibi et <persName ref="p1365">Grynaeo</persName> unum exemplar, ut, quos <lb xml:id="p1z15"/>una copulavit charitas, unum munus constringat arctius.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Si <lb xml:id="p1z16"/>vacabit, legite et, quid iudicetis, significate.</s>
					<s n="12" xml:lang="la" ana="farewell">Valete in <lb xml:id="p1z17"/>domino.</s>
					<s n="13" xml:lang="la">10. martii 1539.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p495">H. Bullingerus</persName> vester.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p8418">Osvaldo Myconio</persName>, <lb xml:id="p2z2"/>fratri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
