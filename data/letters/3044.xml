	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ex <placeName ref="l808">Belgico</placeName> aliquid certi perlibenter scriberem, <lb xml:id="p1z2"/>si haberem; de pace dubia sunt omnia, et miror, unde auri profluvium <lb xml:id="p1z3"/>utrique monarchae tantum suppetat bello tot annis protrahendo.</s>
					<s n="3" xml:lang="la">Sed <lb xml:id="p1z4"/>interim expilantur agricolae, cives et civitates potissimum.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Comicia imperii ad calendas ianuarii indicta sunt a Caesare, <lb xml:id="p1z6"/>de quibus video bene sperare <placeName ref="l491">Argentinenses</placeName>, ut quorum nterventu <lb xml:id="p1z7"/>se liberandos idolatria existimant; sed metuo, ne frustra adeo <lb xml:id="p1z8"/>et exacerbato Cesare contra religionem et tam agentibus <lb xml:id="p1z9"/>tepide non paucis imperii statibus.</s>
					<s n="5" xml:lang="la"><placeName ref="l648">Rhetos</placeName> audimus fortiter agere <lb xml:id="p1z10"/>pro pietate propaganda et ex novo decreto <placeName ref="l520">Vallem Telinam</placeName> <lb xml:id="p1z12"/>accessuram.</s>
					<s n="6" xml:lang="la">De <placeName ref="l2472">Polonia</placeName> multa significavit optimus vir, <lb xml:id="p1z13"/>qui apud nos fuit; exhibuimus ei, quae potuimus, officia exhibituri <lb xml:id="p1z14"/>ulteriora, nisi obstitisset nundinarum strepitus.</s>
					<s n="7" xml:lang="la">Quae causa fuit, ut <lb xml:id="p1z15"/>nec <persName ref="p1214">Frisius</persName> vester pro eo, ac par fuit et perpetua vestra in nostros <lb xml:id="p1z16"/>et omnes alios humanitas meretur, tractatus sit.</s>
					<s n="8" xml:lang="la">Sed interpretatur <lb xml:id="p1z17"/>pro officio promptam voluntatem.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Bene vale, mi frater, et <lb xml:id="p1z18"/>saluta tuos omnes.</s>
					<s n="10" xml:lang="la"><placeName ref="l28">Basileae</placeName> 13. novembris anno 1556/1558?.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/>Tuus <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Hae perpetrans <lb xml:id="p1z20"/>ad suggestum.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>antistiti vigilantissimo, domino <lb xml:id="p2z4"/>colendissimo et charissimo <lb xml:id="p2z5"/>fratri.</s>
				</p>
			</div>
		</body>
