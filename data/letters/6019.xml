	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Cum <placeName ref="l18">Augusta</placeName> discederem, <placeName ref="l587">Tigurum</placeName> etiam ire de<lb xml:id="p1z2"/>creveram literasque has d. <persName ref="p3740">G[eorgii] a Stetten</persName> praesenti tibi <lb xml:id="p1z3"/>praesens quasi in manus tradere.</s>
					<s n="3" xml:lang="la">Verum affinium<note type="misc">iun! ...</note> et aliorum inter<lb xml:id="p1z4"/>pellationibus crebris precibusque meorum impedior, quominus sequi, <lb xml:id="p1z5"/>quod intenderam ceperamque consilium, possim.</s>
					<s n="4" xml:lang="la">Mitto ergo <lb xml:id="p1z6"/>illas per aurigam una cum <persName>S. Heideni</persName> confessione, quam <lb xml:id="p1z7"/>iam pridem tibi sum pollicitus.</s>
					<s n="5" xml:lang="la">Pergratum autem cum mihi <lb xml:id="p1z8"/>tum <persName ref="p3740">Stettensi</persName> feceritis, si primo quoque tempore, imo hoc ipso <lb xml:id="p1z9"/>tabellario praesente nobis rescripseritis, qui ante diem solis <lb xml:id="p1z10"/>huc reversurus dicitur quemque expectare ego constitui.</s>
					<s n="6" xml:lang="la">Velim <lb xml:id="p1z11"/>autem catechesin vestram Latinam minorem mihi mittas simul; <lb xml:id="p1z12"/>de ea enim comparanda ut cogitem, iamdudum me <lb xml:id="p1z13"/>rogavit d. <persName ref="p3740">Stettensis</persName> noster.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Bene vale et d. <persName ref="p8011">Gvalthero</persName> <lb xml:id="p1z14"/><persName>Bettoque</persName> necnon generis tuis meo nomine S. P.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l257">Constantiae</placeName> <lb xml:id="p1z15"/>18. ianuarii anno 1564.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p2899">Matthias Schencus</persName> t[uus].</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro optimo hominique <lb xml:id="p2z2"/>doctissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, ecclesiastae <lb xml:id="p2z4"/><placeName ref="l587">Tigurino</placeName>, d. atque amico <lb xml:id="p2z5"/>in primis colendo.</s>
				</p>
			</div>
		</body>
	</text>
