	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quotiescunque adversarii nostri sinceram religionem opprimere voluerunt, <lb xml:id="p1z2"/>illis ipsis suis machinamentis eam multo amplius provocarunt idque <lb xml:id="p1z3"/>ex eo tempore, quo sincera evangelii lux dei optimi gratia nobis affulgere <lb xml:id="p1z4"/>coepit, hucusque semper fortem esse animadverti.</s>
					<s n="3" xml:lang="la">Idem vero nunc multo evidentius, <lb xml:id="p1z5"/>quando antichristus cum sua cohorte supremos conatus admoliri statuens ad <lb xml:id="p1z6"/>opprimendos pios versis viribus ipse passim magis quam unquam antea <lb xml:id="p1z7"/>atteritur.</s>
					<s n="4" xml:lang="la">De bello <placeName ref="l832">Gallico</placeName> foeliciter, ut spero, confecto merito omnes pii <lb xml:id="p1z8"/>gratias deo nostro maximas agunt, ut qui cognoscunt, a quantis periculis <lb xml:id="p1z9"/>erepti nunc sint, quae ipsis ab antichristo imminebant.</s>
					<s n="5" xml:lang="la">quę de statu rerum <lb xml:id="p1z10"/>passim apud nos feruntur, in adiectam schedam congessi.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z11"/>vale, domine colendissime, cum omnibus tuis.</s>
					<s n="7" xml:lang="la">Datum <placeName ref="l18">Augustę</placeName> 31. martii <lb xml:id="p1z12"/>anno 68.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">R<lb xml:id="p1z13"/>[everentiae] t[uae] studiosissimus <persName ref="p3740">Georgius a Stetten</persName>.</s>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Venerando, pio atque erudito domino <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, ecclesię <placeName ref="l587">Tigurinę</placeName> antistiti <lb xml:id="p2z3"/>vigilantissimo, domino et amico suo <lb xml:id="p2z4"/>colendo.</s>
					<s n="10" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
