	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>De adulterio primum quaeritur, cum <lb xml:id="p1z2"/>iuxta <persName ref="p18989">Severi</persName> rescriptum qualecunque <lb xml:id="p1z3"/>matrimonium imo in desponsata <lb xml:id="p1z4"/>etiam violari non debeat et adulteriu<lb xml:id="p1z5"/>m <lb xml:id="p1z6"/>sit, an, si vir coniugatus solutam <lb xml:id="p1z7"/>corrumpat, adulterium sit et dici <lb xml:id="p1z8"/>possit, quod iurisconsulti negant.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z9"/>Secundo quaeritur, an ad imparia vir et <lb xml:id="p1z10"/>uxor iudicari debeant, cum et in <lb xml:id="p1z11"/>hoc <placeName ref="l425">Romanae</placeName> leges divinis non <lb xml:id="p1z12"/>consentiant.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z13"/>Tertio, cui accusandi adulteros <lb xml:id="p1z14"/>et adulteras concessa sit facultas et <lb xml:id="p1z15"/>utrum, si maritus sciens adulteram <lb xml:id="p1z16"/>et contra retinendo ferat, <lb xml:id="p1z17"/>magistratus, ad quem rumore per<lb xml:id="p1z18"/>crebescat, accusare debeat vel <lb xml:id="p1z19"/>possit.</s>
					<s n="4" xml:lang="la"><pb/><lb xml:id="p2z1"/>Quarto, an magistratus adulterii <lb xml:id="p2z2"/>vitium poena persequi possit et iure <lb xml:id="p2z3"/>debeat, item quo poenarum genere <lb xml:id="p2z4"/>plectendi adulter et adultera, in quo <lb xml:id="p2z5"/>et leges et consuetudo variant.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p2z6"/>Quinto, an reconciliatio inter<lb xml:id="p2z7"/>poni possit et quis reconcilia<lb xml:id="p2z8"/>tionis <lb xml:id="p2z9"/>m<lb xml:id="p2z10"/>odus<lb xml:id="p2z12"/>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p2z13"/>Hi sunt articuli quęstionis de <lb xml:id="p2z14"/>adulteris a quodam bono viro <lb xml:id="p2z15"/>memoriae gratia notata.</s>
				</p>
				<p>
					<note type="address">[ohne Adresse, nur ein Zettel.]</note>
				</p>
			</div>
