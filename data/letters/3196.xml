	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi quidem a d. <persName ref="p3375">Vergerio</persName> tale quid, <lb xml:id="p1z2"/>quale est quod scribis, compater in domino charissime, <lb xml:id="p1z3"/>verum subobscure, quod attinet coniunctionem <lb xml:id="p1z4"/><placeName ref="l2472">Poloniae</placeName> cum protestantibus.</s>
					<s n="3" xml:lang="la">De d. <persName ref="p8041">a Lasco</persName> <lb xml:id="p1z5"/>quoque nonnulla recitavit, quod vero consilia <lb xml:id="p1z6"/>illius perturbare velit, non significavit, nisi <lb xml:id="p1z7"/>quod inconsultum putat, si tam tenera initia <lb xml:id="p1z8"/>confestim per articulum coenę d[omini] in difficultatem <lb xml:id="p1z9"/>coniiciantur.</s>
					<s n="4" xml:lang="la">Venit huc inter coenandum <lb xml:id="p1z10"/>22. mensis huius, et mox altero die mane <lb xml:id="p1z11"/>discessit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Ad illum cum vocarer, tuas nondum <lb xml:id="p1z12"/>acceperam.</s>
					<s n="6" xml:lang="la">Si redierit ad nos, faciam <lb xml:id="p1z13"/>quod mones.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/><placeName ref="l167">Genevenses</placeName> iterum frustra societatem cum nostris <lb xml:id="p1z15"/>ineundam tentarunt.</s>
					<s n="8" xml:lang="la">Vereor ne res ista <lb xml:id="p1z16"/>mali aliquid quandoque sit datura.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/>Caetera quae nos concernunt, poteris ex <lb xml:id="p1z18"/>d. <persName ref="p3988">Wolf</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><persName ref="p8018">Hallero</persName> charissimo fratre cognoscere.</s>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z19"/>Optime vale.</s>
					<s n="12" xml:lang="la" ana="salute">Salutant te ac tuos mei omnes, <lb xml:id="p1z20"/>praesertim <persName ref="p2207">Heinrychulus</persName> noster.</s>
					<s n="13" xml:lang="la" ana="salute">Saluta meo nomine <lb xml:id="p1z21"/>dominos ac fratres isthic, d. <persName ref="p8111">Petrum Martyrem</persName>, <lb xml:id="p1z22"/>d. <persName ref="p8171">Bibliandrum</persName>, d. <persName ref="p8011">Gualtherum</persName>, d. <persName ref="p1214">Frysium</persName>, <lb xml:id="p1z23"/>et caeteros.</s>
					<s n="14" xml:lang="la"><placeName ref="l41">Bernae</placeName> <lb xml:id="p1z24"/>1557. 24. maii.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><persName ref="p8417">W[olfgan<lb xml:id="p1z25"/>g] Musculus</persName> tuus <lb xml:id="p1z26"/>in domino.</s>
