	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">Non potui citius habere nuncium; citius alias respondissem <lb xml:id="p1z3"/>ad tuas, maxime quod attinet illud argumentum, de quo <lb xml:id="p1z4"/>scribo in hisce inclusis.</s>
					<s n="3" xml:lang="la">Quod reliqua attinet, <lb xml:id="p1z5"/>expecto quotidie exemplaria nostra.</s>
					<s n="4" xml:lang="la">Cognovi quomodo cum <lb xml:id="p1z6"/><persName ref="p4851">Froschouero</persName> conveneris, et ago tibi pro tuis laboribus grat<lb xml:id="p1z7"/>ias.</s>
					<s n="5" xml:lang="la">Exemplaria quidem tot non admodum desidero; <lb xml:id="p1z8"/>quomodo enim illa omnia hic distraherem?</s>
					<s n="6" xml:lang="la">Tamen, quicquid <lb xml:id="p1z9"/>tibi placet, mihi quoque placebit.</s>
					<s n="7" xml:lang="la">Si 50 habuissem <lb xml:id="p1z10"/>exemplaria vel saltem 25 primae pressurae et totidem <lb xml:id="p1z11"/>secundae, 5 Helvetici idiomatis et 20 Latina, <lb xml:id="p1z12"/>fuissem contentus.</s>
					<s n="8" xml:lang="la">Si pro reliquis <persName ref="p4851">Froschouerus</persName> aliquid <lb xml:id="p1z13"/>dare voluisset, nihil petiissem nisi forte <lb xml:id="p1z14"/>Biblia <placeName ref="l822">Germanica</placeName> maioris formae, siquidem Biblia <lb xml:id="p1z15"/>mea valde commaculavi in colligendis hisce preculis.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>Tamen, quia sic cum illo convenisti, optime sum contentus, <lb xml:id="p1z17"/>et siquidem aliquid aliud tibi visum fuerit, fac pro tuo <lb xml:id="p1z18"/>arbitrio.</s>
					<s n="10" xml:lang="la">Hoc peto, ut per hunc nuncium, si interea <lb xml:id="p1z19"/>non per alium dimisisti, exemplaria accipiam; suscipiet enim <lb xml:id="p1z20"/>portanda, si illi tradita fuerint.</s>
					<s n="11" xml:lang="la">Quod alia concernit, <lb xml:id="p1z21"/>nihil quidem ex <placeName ref="l832">Gallia</placeName> habemus novi, nisi quod <lb xml:id="p1z22"/>aiunt captivi electoris filium cum duobus aliis Germanic<lb xml:id="p1z23"/>is principibus esse in <placeName ref="l832">Gallia</placeName> et impetrasse a rege <lb xml:id="p1z24"/>magnam pecunię summam pro bello contra Caesarem <lb xml:id="p1z25"/>suscipiendo et hoc bellum in <placeName ref="l749">Saxonia</placeName> iam esse in <lb xml:id="p1z26"/>procinctu.</s>
					<s n="12" xml:lang="la">Scribitur interea ex <placeName ref="l18">Augusta</placeName> <persName ref="p19065">Ioannem Fridericum</persName> <lb xml:id="p1z27"/>lętaliter aegrotare idque non sine suspicione veneni.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z28"/><persName ref="p2916">Schertlius</persName> adhuc in <placeName ref="l832">Gallia</placeName> manet.</s>
					<s n="14" xml:lang="la">De captivo <lb xml:id="p1z29"/><placeName ref="l28">Basiliensi</placeName> <persName ref="p8418">Myconius</persName> vel <persName ref="p1278">Gastius</persName> te erudire poterunt.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z30"/>Hic nihil est novi, nisi quod <persName ref="p8012">quaestor Hallerus</persName> <lb xml:id="p1z31"/>resignavit suum officium; successit illi pandereta <lb xml:id="p1z32"/><persName ref="p4639">Dilgerus</persName>, vir corpore et animo praestans.</s>
					<s n="16" xml:lang="la">Ex <lb xml:id="p1z33"/><placeName ref="l167">Geneva</placeName> nihildum habeo certi, quid fiat in causa <lb xml:id="p1z34"/><persName ref="p20867">Hieronymi</persName>.</s>
					<s n="17" xml:lang="la"><persName ref="p1049">Farellus</persName> superioribus diebus hic fuit, <lb xml:id="p1z35"/>sed necdum ipse quicquam cognovit.</s>
					<s n="18" xml:lang="la" ana="salute">Salutant te nostri, <lb xml:id="p1z36"/><persName ref="p8417">Musculus</persName>, <persName ref="p7879">Wittenbachius</persName> etc.</s>
					<s n="19" xml:lang="la" ana="salute"><lb xml:id="p1z37"/>Saluta meo nomine tuos omnes, tum quoque dominos ac <lb xml:id="p1z38"/>fratres, <persName ref="p8127">Pellicanum</persName>, <persName ref="p8171">Theodorum</persName>, <persName ref="p8011">Gvaltherum</persName> et... <foreign xml:lang="de">Ich, min husfraw und <lb xml:id="p1z39"/>kind wünschend üch und üwerem volk allem ein <lb xml:id="p1z40"/>guͦt glückhafft jar.</foreign></s>
					<s n="20" xml:lang="la">Datae <placeName ref="l41">Bernae</placeName> 7. ianuarii <lb xml:id="p1z41"/>1551.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z42"/><persName ref="p8018">Ioannes Hallerus</persName> <lb xml:id="p1z43"/>tuus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro m. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>fidelissimo pastori, domino et com<lb xml:id="p2z4"/>patri suo colendissimo.</s>
				</p>
				<p>
					<s n="23" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName>.</s>
					<s n="24" xml:lang="de"><lb xml:id="p2z6"/>M. <persName ref="p495">Heinrych Bullinger<lb xml:id="p2z7"/>en</persName>.</s>
				</p>
			</div>
