	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Reverende vir, patrone colende, <lb xml:id="p1z2"/>epistolam a te humanissime scriptam <lb xml:id="p1z3"/>mense iulio anni superioris paulo post <lb xml:id="p1z4"/>ex aula <placeName ref="l743">Pomeranica</placeName> accepi.</s>
					<s n="3" xml:lang="la">Tibi vero <lb xml:id="p1z5"/>reverenter gratiam habeo, quod memoriam <lb xml:id="p1z6"/>mei cum benevolentia conservas.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Librum <persName>Nicolai Marscalci</persName> De piscibus <lb xml:id="p1z8"/>una cum figuris ante tres menses <lb xml:id="p1z9"/>ad m. <persName ref="p4554">Rodolphum Collinum</persName> <placeName ref="l558">Vitebergam</placeName> <lb xml:id="p1z10"/>misi, ut inde <placeName ref="l587">Tigurum</placeName> prima occasione <lb xml:id="p1z11"/>perferatur ad d. <persName ref="p1283">Conradum Gesnerum</persName>, <lb xml:id="p1z12"/>qui, ut vereor, quod ad hunc <lb xml:id="p1z13"/>librum attinet, magna cura <foreign xml:lang="el">[griechis<lb xml:id="p1z14"/>ch]</foreign> inquisivit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Valde optaremus ego et multi boni <lb xml:id="p1z16"/>et docti viri d. <persName ref="p1283">Gesnerum</persName> ad hoc <lb xml:id="p1z17"/>litus maris Baltici aspatiari; commo<lb xml:id="p1z18"/>dissime enim nondinarum <placeName ref="l157">Francofordiensium</placeName> <lb xml:id="p1z19"/>tempore cum bibliopolis <placeName ref="l558">Vitebergam</placeName> <lb xml:id="p1z20"/>usque posset proficisci, unde ad nos singulis <lb xml:id="p1z21"/>mensibus auriga venit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quodsi volu<lb xml:id="p1z22"/>minum suorum exempla duci Augusto, <lb xml:id="p1z23"/>marchioni <placeName ref="l1048">Brandenburgensi</placeName>, nostris principibus <placeName>Me<lb xml:id="p1z24"/>gapolensibus</placeName> et vicinarum urbium splendidissimarum <lb xml:id="p1z25"/>senatoribus exhiberet, liberale viaticum <lb xml:id="p1z26"/>conficere posset.</s>
					<s n="7" xml:lang="la">Nec frigora istius orae <lb xml:id="p1z27"/>ipsum pertimescere velim, quae non dubito <pb/><lb xml:id="p2z1"/>mitiora apud nos hac hyeme fuisse <lb xml:id="p2z2"/>quam in <placeName>Alpibus</placeName> vobis vicinis.</s>
					<s n="8" xml:lang="la">Nos officia <lb xml:id="p2z3"/>omnia, quae viro doctissimo et optimo <lb xml:id="p2z4"/>et de communi ecclesia et republica liter<lb xml:id="p2z5"/>aria optime merito debentur, pro nostra <lb xml:id="p2z6"/>tenuitate libenter ipsi praestabimus.</s>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p2z7"/>Bene et feliciter vale et veniam mihi dato, <lb xml:id="p2z8"/>quod, cum multa mihi hoc tempore scriben<lb xml:id="p2z9"/>da essent, breviores ad te literas dedi.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><lb xml:id="p2z10"/>Rostochii die S. Matthiae 1556.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z11"/><persName ref="p583">David Chytraeus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><lb xml:id="p2z12"/>Reverendo viro <lb xml:id="p2z13"/>sapientia, eruditi<lb xml:id="p2z14"/>one et virtute pr<lb xml:id="p2z15"/>aestanti, d. <persName ref="p495">Henrico <lb xml:id="p2z16"/>Bullingero</persName>, <lb xml:id="p2z17"/>doctori ecclesiae <lb xml:id="p2z18"/><placeName ref="l587">Tigurinae</placeName>.</s>
					<s n="13" xml:lang="de"><lb xml:id="p2z19"/>Zürch.</s>
				</p>
