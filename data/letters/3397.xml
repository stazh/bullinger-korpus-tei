	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Palatino <placeName ref="l552">Villnensi</placeName>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Illustrissime princeps, domine clementissime.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Gratulamur principibus viris, tuae pietati inprimis <lb xml:id="p1z4"/>adoeque patriae univers, regno inquam <placeName ref="l2472">Poloniae</placeName> <lb xml:id="p1z5"/>felicissimae, quod tandem post difficillimas peregrinationes, <lb xml:id="p1z6"/>post labores exantlatos plurimos necnon durissim<lb xml:id="p1z7"/>os insignem pietate eruditioneque virum d. <persName ref="p8041">Ioannem a Lasco</persName> <lb xml:id="p1z8"/>receperitis redeuntem in patriam.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Est hic vir toti <lb xml:id="p1z9"/>patriae ornamento maximo.</s>
					<s n="5" xml:lang="la">Norunt ipsum pii et docti viri <lb xml:id="p1z10"/>omnes per totum orbem christianum, apud quos item magna <lb xml:id="p1z11"/>pollet authoritate.</s>
					<s n="6" xml:lang="la">Sciunt enim illum ante annos <lb xml:id="p1z12"/>viginti relictis propter evangelium dei facultatibus amplissimis <lb xml:id="p1z13"/>et honoribus dignitatibusque maximis sequtum esse Christum pauperem <lb xml:id="p1z14"/>atque in suo illo exilio ita sese per dei gratiam gessisse, <lb xml:id="p1z15"/>ut ne hostes quidem in ipso potuerint culpare <lb xml:id="p1z16"/>quicquam.</s>
					<s n="7" xml:lang="la">Eruditio illi solida est, pietas et religio <lb xml:id="p1z17"/>syncerissima experientiaque rerum plurimarum varia, <lb xml:id="p1z18"/>multiplex et singularis.</s>
					<s n="8" xml:lang="la">Insignia ab ipso se beneficio accepisse <lb xml:id="p1z19"/>testantur ecclesiae <placeName ref="l734">Phrysiacae</placeName>, <placeName ref="l830">Anglicae</placeName> atque <lb xml:id="p1z20"/><placeName ref="l822">Germanicae</placeName>.</s>
					<s n="9" xml:lang="la">Videtur sane divina bonitas hunc homin(em) <lb xml:id="p1z21"/>tentationibus et i<lb xml:id="p1z22"/>actationibus variis praeparasse rebus <lb xml:id="p1z23"/>gerendis <lb xml:id="p1z24"/>maximis adeoque reformandis amplissimis regni <placeName ref="l2472">Poloniae</placeName> ecclesiis.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/>Felices ergo arbitrantur vos futuros, quotquot usquam sunt <lb xml:id="p1z26"/>viri docti et boni, si agnoscentes hoc dei insigne <lb xml:id="p1z27"/>beneficium singulari isto dei organo utamini ad <lb xml:id="p1z28"/>reformand m legitime et syncere sacras <placeName ref="l2472">Poloniae</placeName> <lb xml:id="p1z29"/>ecclesias.</s>
					<s n="11" xml:lang="la">Inde vero exorietur regni tranquillitas <lb xml:id="p1z30"/>et felicitas ac merces a deo amplissima.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Habet<lb xml:id="p1z31"/>is <lb xml:id="p1z32"/>in hoc uno viro, quod vix alioqui assequeremini, si ex <lb xml:id="p1z33"/>variis locis viros evocaretis doctos, qua molestia <lb xml:id="p1z34"/>quibusque sumptibus nihil erit opus, cum pro pluribus <lb xml:id="p1z35"/>huc unus satis esse videatur ac ab uno audire liceat, quam <lb xml:id="p1z36"/>forte a pluribus vix tanta <lb xml:id="p1z37"/>audiretis <lb xml:id="p1z38"/>synceritate et gratia, nimirum unicam et eam unicae scripturae veritatem.</s>
					<s n="13" xml:lang="la">Hoc <lb xml:id="p1z39"/>ipsum libenter suggessissemus serenissimae maiestati regiae, <lb xml:id="p1z40"/>cui omnia felicia imprecamur ex animo, nisi spera<lb xml:id="p1z41"/>remus haec et alia salutaria te perpetuo eius in<lb xml:id="p1z42"/>spirare animo.</s>
					<s n="14" xml:lang="la" ana="salute">Dominus, qui corda principum parat et <lb xml:id="p1z43"/>dirigit, regat corda quoque omnium amplissimi <placeName ref="l2472">Polonici</placeName> regni <lb xml:id="p1z44"/>procerum, ut ea, quae dei gloriae sunt et faciunt a<lb xml:id="p1z45"/>d conservandam regni salutem<lb xml:id="p1z46"/>, sedulo <lb xml:id="p1z47"/>et <lb xml:id="p1z48"/>constanter velint et perficiant.</s>
					<s n="15" xml:lang="la" ana="salute">Salu<lb xml:id="p1z49"/>tant pietatem tua<lb xml:id="p1z50"/>m et commendant se serenissimae regiae maiestati atque tibi omne<lb xml:id="p1z51"/>s symmystae et fratres huius ecclesiae ministri, d. <lb xml:id="p1z52"/><persName ref="p8011">Gvalt[erus]</persName>, <persName ref="p3988">Wolphius</persName>, <persName ref="p8171">Bibliander</persName>, <persName ref="p8111">Martyr</persName>, <persName ref="p1888">Lavat<lb xml:id="p1z53"/>erus</persName>, <lb xml:id="p1z54"/><persName ref="p1453">Hallerus</persName>, <lb xml:id="p1z55"/><persName ref="p8461">Wickius</persName>, <persName ref="p7228">Zvinglius</persName>, <persName ref="p8442">Simlerus</persName>, d. <persName ref="p1283">Gessnerus</persName>, <lb xml:id="p1z58"/><persName ref="p1214">Frisius</persName> ac caeteri omnes.</s>
					<s n="16" xml:lang="la">Dominus benedicat tibi et <lb xml:id="p1z59"/>toti domui tuae.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Vive et vale.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 6. novembris anno 1557.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><persName ref="p495">H[einrychus] <lb xml:id="p1z60"/>Bullingerus</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p1z62"/>ecclesiae pastor etc.</s>
				</p>
			</div>
