			<zone xml:id="p2z2-0" points="2148,1078 2232,1047 2460,1062 2531,1037 2599,1074 2689,1047 2850,1063 2843,1000 2779,1026 2413,982 2358,1006 2246,979 2147,1003">2153,1033 2189,1031 2226,1030 2263,1030 2300,1029 2336,1028 2373,1032 2410,1033 2447,1033 2484,1034 2520,1036 2557,1036 2594,1036 2631,1038 2668,1039 2704,1039 2741,1039 2778,1039 2815,1039 2852,1036</zone>
