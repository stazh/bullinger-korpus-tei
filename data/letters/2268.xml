	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime vir, accepi hodie abs te literas diei 15. <lb xml:id="p1z2"/>huiusce mensis.</s>
					<s n="2" xml:lang="la">Quibus parum habeo, quod res<lb xml:id="p1z3"/>pondeam, quum nuper <persName ref="p3337">Aurelium</persName> ad te miserim <lb xml:id="p1z4"/>oneratum literis.</s>
					<s n="3" xml:lang="la">Dedi <persName ref="p974">Carolo Molinaeo</persName> <lb xml:id="p1z5"/>suas; rescribet, ut puto.</s>
					<s n="4" xml:lang="la">Scripta, quae <lb xml:id="p1z6"/>scribis te non habuisse, valde timeo, ne <lb xml:id="p1z7"/>perierint.</s>
					<s n="5" xml:lang="la">Raetus puer hic conditionem <lb xml:id="p1z8"/>quaerebat mihi ab amicis commendatus; quum <lb xml:id="p1z9"/>nulla appareret, remisi, posteaquam per aliqu<lb xml:id="p1z10"/>ot dies alui neque indonatum.</s>
					<s n="6" xml:lang="la">Huic itaque <lb xml:id="p1z11"/>dederam d. <persName>Baionensi</persName> ferenda, qui lecta <lb xml:id="p1z12"/>ad te mitteret; at quaeram, si sciero, <lb xml:id="p1z13"/>quo pervenerit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Angor pręterea, quod <lb xml:id="p1z14"/>in his tuis postremis nullam mentionem <lb xml:id="p1z15"/>facis earum, quae ex <placeName ref="l18">Augusta</placeName> ad te scrip<lb xml:id="p1z16"/>seram et <placeName ref="l441">Scaffusiam</placeName> ad <persName ref="p2757">Ruggerum</persName> mi<lb xml:id="p1z17"/>seram.</s>
					<s n="8" xml:lang="la">Deus bene vertat; etiam de <lb xml:id="p1z18"/>his erit mihi quaerendum alicubi, scio tam <lb xml:id="p1z19"/>ubi.</s>
					<s n="9" xml:lang="la">Oro te, cura, ut hae, qu<lb xml:id="p1z20"/>a<lb xml:id="p1z21"/>s ad <persName>Baionensem</persName> mitto statim dentur <lb xml:id="p1z22"/>hospiti <placeName>Coronae</placeName>; intus literae sunt ad fra<lb xml:id="p1z23"/>tres <placeName ref="l834">Italiae</placeName> nec parvi momenti.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale et <lb xml:id="p1z24"/>salve cum omnibus fratribus; orate pro me.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z25"/><placeName ref="l512">Tubingae</placeName> 21. aprilis 1554.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z27"/>Clarissimo <pb/><lb xml:id="p2z1"/>pietate atque <lb xml:id="p2z2"/>eruditione viro d. <persName ref="p495">H[en<lb xml:id="p2z3"/>rico] Bullingero</persName>, fratri ho<lb xml:id="p2z4"/>norando.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
