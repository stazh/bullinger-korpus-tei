	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quid scribam aut quid dicam, mi <lb xml:id="p1z2"/>frater <persName ref="p8009">Fabrici</persName>?</s>
					<s n="3" xml:lang="la">Moeror moerorem excipit <lb xml:id="p1z3"/>et auget supra modum.</s>
					<s n="4" xml:lang="la">Scis quantus <lb xml:id="p1z4"/>mihi ex meorum mortibus dolor sit excitatus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Nunc mors clarissimi, eruditissimi et <lb xml:id="p1z6"/>sanctissimi viri d. <persName ref="p1283">Gessneri</persName> tantum non <lb xml:id="p1z7"/>enecat me.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">O miserum me, qui semi<lb xml:id="p1z8"/>vivus tot funera sequi cogor.</s>
					<s n="7" xml:lang="la">Sed cum domino <lb xml:id="p1z9"/>sic placeat, libenter me submitto dis<lb xml:id="p1z10"/>ciplinae eius.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Hac praeterita nocte migravi<lb xml:id="p1z11"/>t ille hora 11. ad dominum; heri mihi <lb xml:id="p1z12"/>valedicens profitebatur fidem suam et misericordiae dei <lb xml:id="p1z13"/>per Christum se commendabat.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Laboravit in ext<lb xml:id="p1z14"/>remum usque halitum; heri quoque quaedam ad<lb xml:id="p1z15"/>huc scripsit.</s>
					<s n="10" xml:lang="la">Nunquam decubuit, semper vel con<lb xml:id="p1z16"/>sedit vel obambulavit.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Dominica die adhuc <lb xml:id="p1z17"/>in sacra coetu fuit.</s>
					<s n="12" xml:lang="la">Pestilentissimus anthrax <lb xml:id="p1z18"/>praecordia eius occupavit; bubo ingens sub <lb xml:id="p1z19"/>axilla eius sinistra subsedit.</s>
					<s n="13" xml:lang="la">Plura me dice<lb xml:id="p1z20"/>re dolor non sinit.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z21"/>Omnes tuae literae et ipsa quoque pecunia integra <lb xml:id="p1z22"/>recte mihi est reddita.</s>
					<s n="15" xml:lang="la">Quid dicam?</s>
					<s n="16" xml:lang="la">Multa <lb xml:id="p1z23"/>profecto tibi debeo; ideo non ingratum me <lb xml:id="p1z24"/>tibi exhibebo.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Maximas ago gratias.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Scribam <lb xml:id="p1z25"/>d. consuli <persName ref="p3196">Tscharnero</persName>, cum plus erit animi; <lb xml:id="p1z26"/>tu interim meas vices subito.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Valeto.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z27"/>Habeo plurima de detectis proditionibus <lb xml:id="p1z28"/>ex <placeName ref="l832">Gallia</placeName>, sed scribere non possum.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Ora <lb xml:id="p1z29"/>pro nobis dominum.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="farewell">Vale aeternum.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><placeName ref="l587">T<lb xml:id="p1z30"/>iguri</placeName> 14. decembris 1565.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Efferetur ad 4. <lb xml:id="p1z31"/>vespertinam.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z32"/><persName ref="p495">Bullingerus</persName> tuus</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
</TEI>