	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Qui has reddunt, compater <lb xml:id="p1z2"/>in domino charissime, <placeName ref="l18">Augustani</placeName> sunt, verbi <lb xml:id="p1z3"/>minister unus, literarii ludi magister <lb xml:id="p1z4"/>alter.</s>
					<s n="3" xml:lang="la">Minister verbi literis senatus <lb xml:id="p1z5"/><placeName ref="l18">Augustani</placeName> est revocatus, alter hunc co<lb xml:id="p1z6"/>mitatur visurus, an et ipse pristinum <lb xml:id="p1z7"/>illic locum recuperare possit.</s>
					<s n="4" xml:lang="la">Haud <lb xml:id="p1z8"/>opus est, ut eos humanitati tuae com<lb xml:id="p1z9"/>mendem, cum alioqui erga fratres animum <lb xml:id="p1z10"/>benevolum declarare soleas.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Vereor, ne non satis commode pro<lb xml:id="p1z12"/>pter tumultus bellicos iter hoc con<lb xml:id="p1z13"/>ficere queant; prudentia et circum<lb xml:id="p1z14"/>spectione opus est.</s>
					<s n="6" xml:lang="la">Quare te oro, <lb xml:id="p1z15"/>si quid rationis nosti, qua commodius <lb xml:id="p1z16"/>ac certius proficiscantur, illis <lb xml:id="p1z17"/>communices.</s>
					<s n="7" xml:lang="la">Nos hic per gratiam domini satis <lb xml:id="p1z18"/>tranquille vivimus.</s>
					<s n="8" xml:lang="la">Uxor partui vicina <lb xml:id="p1z19"/>est; ora dominum, ut prospere pariat.</s>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z20"/>Optime vale, compater in domino charissime.</s>
					<s n="10" xml:lang="la" ana="salute"><lb xml:id="p1z21"/>Salutem tuis omnibus, dominis etiam fratribus <lb xml:id="p1z22"/>et amicis.</s>
					<s n="11" xml:lang="de"><placeName ref="l41">Bernae</placeName> 12. maii 1552.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/><persName ref="p8417">W[olfgangus] Musculus</persName>, compater <lb xml:id="p1z24"/>tuus in domino.</s>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Celeberrimo theologo <lb xml:id="p2z2"/>m. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z5"/>pastori vigilan<lb xml:id="p2z6"/>tissimo, domino et <lb xml:id="p2z7"/>compatri suo <lb xml:id="p2z8"/>charissimo.</s>
