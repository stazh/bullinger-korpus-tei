	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi omnia, quae misisti, frater <lb xml:id="p1z2"/>charissime, ac spero te iam accepisse eadem ex <lb xml:id="p1z3"/>parte, quae tu misisti ad me.</s>
					<s n="3" xml:lang="la">Quae interea <lb xml:id="p1z4"/>misere amici, habes his inclusa, quae ita ad <lb xml:id="p1z5"/>te mitto, ut ad me sunt transmissa.</s>
					<s n="4" xml:lang="la">Crede, quan<lb xml:id="p1z6"/>tum voles.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Plura non possum tantum non op<lb xml:id="p1z7"/>pressus negotiis.</s>
					<s n="6" xml:lang="la" ana="farewell">Parce ergo mihi et vale aeternum.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/><placeName ref="l587">Tiguri</placeName> 5. ianuarii 1569.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z9"/><persName ref="p495">Bullingerus</persName> tuissimus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z10"/>Saluta d. d.d.</s>
					<s n="10" xml:lang="la">consules, d. <persName>Carolum</persName>, <persName ref="p6130">Pontasellam</persName>, <lb xml:id="p1z11"/><persName ref="p20473">Ganthnerum</persName> et alio[s] fratres et amicos.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <lb xml:id="p2z2"/><persName ref="p8016">Tobiae Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro, <lb xml:id="p2z4"/>domino meo colendo et <lb xml:id="p2z5"/>fratri charissimo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z6"/>Chur.</s>
				</p>
			</div>
		</body>
	</text>
