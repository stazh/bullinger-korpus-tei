	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Audivi ab omnibus regulis famulis et ab ipso <lb xml:id="p1z2"/>d. <persName ref="p944">Morlet</persName>, meo praedecessore, quantum ei charus <lb xml:id="p1z3"/>fueris et ille tibi vicissim, cupioque hanc <lb xml:id="p1z4"/>inter nos amicitiam ut renoves, imo potius <lb xml:id="p1z5"/>continues; nihil enim mihi gratius accidere <lb xml:id="p1z6"/>poterit, quam si cum docto et optimo viro <lb xml:id="p1z7"/>sepius literis communicare possim.</s>
					<s n="3" xml:lang="la">Dominus <lb xml:id="p1z8"/><persName ref="p3375">Vergerius</persName> mihi bis scripsit, et curavi, ut <lb xml:id="p1z9"/>habeat a rege, unde possit honeste vivere.</s>
					<s n="4" xml:lang="la">Illi, <lb xml:id="p1z10"/>ut petit, per te scribo; cura, si placet, ut <lb xml:id="p1z11"/>mee ei reddantur.</s>
					<s n="5" xml:lang="la"><persName ref="p18538">Caesar</persName> in regem multa contra <lb xml:id="p1z12"/>decorum publicavit in <placeName ref="l822">Germania</placeName>, et ut rex <lb xml:id="p1z13"/>principibus... satisfaciat, <lb xml:id="p1z14"/>rescripsit et alia praeterea retulit, ut videbis; <lb xml:id="p1z15"/>nam tibi et d. <persName ref="p3375">Vergerio</persName> coppiam literaru<lb xml:id="p1z16"/>m mitto.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Timuisti, ne tue litere invenirentur <lb xml:id="p1z17"/>apud heredes <persName ref="p944">Morleti</persName>; pauce reperte sunt, <lb xml:id="p1z18"/>et illas habeo, que due sunt in summa, in <lb xml:id="p1z19"/>quibus nihil est, quod non sit te dignum.</s>
					<s n="7" xml:lang="la">Si tamen <lb xml:id="p1z20"/>vis, exuram vel remittam orans te, ut, si quid in <lb xml:id="p1z21"/>utilitatem reipublice habeas aliquando, nobis significes.</s>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z22"/>Bene vale.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Datum festinanter ex <placeName ref="l760">Soluturo</placeName> 19a martii.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Tuus ex aimo <lb xml:id="p1z24"/><persName ref="p8296">De l'Aubespine</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z25"/>Optimo <lb xml:id="p1z26"/>viro d. <persName ref="p495">Bulinger<pb/><lb xml:id="p2z1"/>o</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note type="author">[Darunter von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="12" xml:lang="la"><lb xml:id="p2z3"/><persName ref="p8296">Bassefontainae</persName>, <lb xml:id="p2z4"/>oratoris <placeName ref="l832">Francici</placeName> <lb xml:id="p2z5"/>apud <placeName ref="l862">Helvetios</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
