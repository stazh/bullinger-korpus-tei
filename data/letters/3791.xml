	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto duos ex meis, qui visitent filium; sed eos nolui dimittere <lb xml:id="p1z2"/>sine meis ad te literis.</s>
					<s n="3" xml:lang="la">Alias te recepisse puto, quibus signifficabam <lb xml:id="p1z3"/>mortes reginarum <placeName ref="l830">Anglie</placeName> et <placeName ref="l882">Ungarie</placeName>.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">De pace nihil adhuc certi habemus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z4"/>Serius accessi comitia propter infirmitatem; nunc melius habeo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute">Salutabis <lb xml:id="p1z5"/>dominos <persName ref="p8011">Galterum</persName> et <persName ref="p8111">Martirem</persName>.</s>
					<s n="7" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="de"><placeName ref="l21">Badene</placeName> 12. decembris.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z6"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henr[ico] Bull[ingero]</persName>.</s>
				</p>
			</div>
		</body>
	</text>
