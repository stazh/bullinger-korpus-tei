	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus et pax Christi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Nescio, notus ne tibi sit <persName ref="p2237">Martinus Mötelinus</persName>, <lb xml:id="p1z3"/>parrochus ecclesiae <placeName ref="l538">Winfeldensis</placeName> in <placeName ref="l774">Turgoia</placeName>, <lb xml:id="p1z4"/>vir multis modis commendandus.</s>
					<s n="3" xml:lang="la">Is in <lb xml:id="p1z5"/>periculo esse videtur propter destructa <lb xml:id="p1z6"/>idola a puella quadam, quae illis praepostero <lb xml:id="p1z7"/>zelo manum intulit<note xml:id="fn1" type="footnote" ana="bio" n="1">Die durch eine Predigt <persName ref="p2237">Möttelis</persName> um Ende Dezember 1541 in <placeName ref="l538">Weinfelden</placeName> ausgelöste Bilderzerstörung hatte zur Verhaftung des Predigers sowie einer gewissen <persName ref="p5433">Anna Keller</persName> geführt. Die Frau gab unter der Folter zu Protokoll, die Tat allein begangen zu haben; s. <bibl source="b197">EA</bibl> IV/1d 95. 106f; <hi>Knittel,</hi> Kirche 136f.</note>.</s>
					<s n="4" xml:lang="la">Sed in proximis <lb xml:id="p1z8"/>comitiis <placeName ref="l21">Badensibus</placeName> cogitur accusatoribus <lb xml:id="p1z9"/>respondere, id quod faciet vere et constanter<note xml:id="fn2" type="footnote" n="2">Im Abschied der <placeName ref="l21">Badener</placeName> Tagsatzung vom 20. März (<bibl source="b197">EA</bibl> IV/1d 116-127) ist darüber nichts zu finden.</note>.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Tu vero scis, quid nonnunquam timendum sit <lb xml:id="p1z11"/>apud eos, quibus religio nostra non sapit, et <lb xml:id="p1z12"/>sunt, qui ea suspitione bonum et innocentem <lb xml:id="p1z13"/>virum gravant, quasi ipsius hortatu puella <lb xml:id="p1z14"/>patrarit facinus istud.</s>
					<s n="6" xml:lang="la">Sed tam est innocens <lb xml:id="p1z15"/>quam tu.</s>
					<s n="7" xml:lang="la">Cumque homo sit eruditus et pius, <lb xml:id="p1z16"/>rogamus te omnes, quotquot hic ministri <lb xml:id="p1z17"/>dei sunt, ut legatis tuis<note xml:id="fn3" type="footnote" n="3"><placeName ref="l587">Zürich</placeName> wurde an der erwähnten Tagsatzung durch <persName ref="p1419">Johannes Haab</persName> vertreten; s. LA IV/1d 116.</note> optimum illum <lb xml:id="p1z18"/>virum diligentissime commendes.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Scripsisset <lb xml:id="p1z19"/>ad te quoque <persName ref="p8055">Ambrosius</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p8055">Ambrosius Blarer</persName>.</note>, sed impeditur<note xml:id="fna" type="footnote" n="a"><hi>Nach</hi> impeditur <hi>ein gestrichenes, unlesbares Wort.</hi></note> <lb xml:id="p1z20"/>contionibus cras faciendis.</s>
					<s n="9" xml:lang="la" ana="salute">Salutat autem <lb xml:id="p1z21"/>te cum omnibus fratribus studiosissime.</s>
					<s n="10" xml:lang="la">Et <lb xml:id="p1z22"/>sint hae primae literae [a]d te<note xml:id="fnb" type="footnote" n="b">[a]d te <hi>am Rande nachgetragen, im engen Einband teilweise verdeckt.</hi></note> post resurrectionem <lb xml:id="p1z23"/>a mortuis<note xml:id="fn5" type="footnote" n="5">Zu <persName ref="p4079">Zwicks</persName> schwerer Erkrankung vgl. auch oben <ref target="file11638">Nr. 1595</ref>, 26-30 mit Anm. 13.</note>.</s>
					<s n="11" xml:lang="la">Utinam vicisset mors corporis, <lb xml:id="p1z24"/>ad vitam animae!</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l257">Constantiae</placeName>, <lb xml:id="p1z25"/>18. februarii 1542.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Tuus <persName ref="p4079">Io. <lb xml:id="p1z26"/>Zvic.</persName><pb type="edition" next="41"/></s>
				</p>
				<p>
					<s n="15" xml:lang="la">Frater <persName ref="p4082">Cuͦnradus</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p4082">Konrad Zwick</persName>.</note> quęrit iuvenem aliquem <lb xml:id="p1z28"/>instituendis pueris idoneum, non summe, <lb xml:id="p1z29"/>sed mediocriter in Gręcis et Latinis doctum, <lb xml:id="p1z30"/>caeterum honestum et pium.</s>
					<s n="16" xml:lang="la">Si talem scires, <lb xml:id="p1z31"/>posses me de hoc paucis certiorem facere.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z32"/>Saluta totam domum tuam.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="18" xml:lang="de"><pb/><lb xml:id="p2z1"/>An Maister <persName ref="p495">Hain<lb xml:id="p2z2"/>rich Bullinger</persName>, <lb xml:id="p2z3"/>prediger zuͦ Zürch, <lb xml:id="p2z4"/>zuͦ handen.</s>
				</p>
			</div>
		</body>
	</text>
