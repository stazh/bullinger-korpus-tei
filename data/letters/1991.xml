	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p714">C[aelius] S[ecundus] <lb xml:id="p1z2"/>C[urio]</persName> per Christum Iesum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">S. D.</s>
					<s n="3" xml:lang="la">Hic, qui hasce tibi, venerande frater literas <lb xml:id="p1z3"/>reddidit, <persName>Nicolaus Mora</persName>, cum nobilitate tum pietate <lb xml:id="p1z4"/>inter primos est huius Rethorum orae <lb xml:id="p1z5"/>et ecclesiae Christi evangelio restauratae.</s>
					<s n="4" xml:lang="la" ana="salute"><lb xml:id="p1z6"/>Habet quaedam negotia <placeName ref="l587">Tiguri</placeName>, sed in primis <lb xml:id="p1z7"/>te videre et salutare reverenter cupit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Haec non scribo, quo de tua in huius<lb xml:id="p1z9"/>modi viris amplectandis humanitate dubitem, <lb xml:id="p1z10"/>sed ut hisce meis literis ei ad te aditum, ut <lb xml:id="p1z11"/>ipse dicit, aperirem atque ut, quinam vir siet, <lb xml:id="p1z12"/>intelligeres.</s>
					<s n="6" xml:lang="la">Ab hoc de meis rebus atque item <lb xml:id="p1z13"/>de huius ecclesiae statu intelliges.</s>
					<s n="7" xml:lang="la">Scripsi <lb xml:id="p1z14"/>ad te proxime per alium; expecto responsum, si <lb xml:id="p1z15"/>ei nuncio non dedisti.</s>
					<s n="8" xml:lang="la">Velim, quae scripsi illis <lb xml:id="p1z16"/>literis apud te reservares, quamquam hoc monere <lb xml:id="p1z17"/>te, talem virum et amicum et fratrem, <lb xml:id="p1z18"/>nihil erat opus.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale.</s>
					<s n="10" xml:lang="la">Faxit deus, ut <lb xml:id="p1z19"/>brevi te revisam.</s>
					<s n="11" xml:lang="la" ana="salute">Salutant te fratres, qui <lb xml:id="p1z20"/>nobiscum sunt.</s>
					<s n="12" xml:lang="la"><placeName ref="l93">Clavenae</placeName> tertia septembris <lb xml:id="p1z21"/>1553.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Henrycho Bullingero</persName>, <lb xml:id="p2z3"/>[ec]clesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>antistiti vigilantissimo, <lb xml:id="p2z5"/>domino et fratri in domino <lb xml:id="p2z6"/>observando.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
