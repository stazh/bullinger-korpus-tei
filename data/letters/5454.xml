	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime atque doctissime d. <persName ref="p495">Bullingere</persName>, mitto tibi <persName ref="p8126">Oporini</persName> <lb xml:id="p1z2"/>nomine aliquot libros, quos ut animo bono accipias, <lb xml:id="p1z3"/>maximopere peto.</s>
					<s n="2" xml:lang="la">Sicut autem: <persName>Nicephorus Gregoras</persName>, script<lb xml:id="p1z4"/>or Graecus historiae Romanae disertissimus, historiae ec<lb xml:id="p1z5"/>clesiasticae Centuria sexta, <persName ref="p18140">Ioannis Rivii</persName> theologica <lb xml:id="p1z6"/>opera omnia, <persName ref="p5853">Friciique</persName> quaedam opuscula<note xml:id="fn1" type="footnote" n="1"><persName ref="p5853">Andreas Fricius Modrevius</persName>, Libri tres, Basel (Oporin) 1562.</note>.</s>
					<s n="3" xml:lang="la">Ignotus <lb xml:id="p1z7"/>praeterea quod tibi, eruditissime vir, scribam, mirari <lb xml:id="p1z8"/>noli, neque illud etiam mihi, sed qui mihi hoc praecepit <lb xml:id="p1z9"/>domino imputabis.</s>
					<s n="4" xml:lang="la">Impressor noster tibi hoc offeret, <lb xml:id="p1z10"/>cum quo si quid rescribere velles, faceres mihi <lb xml:id="p1z11"/>rem longe gratissimam.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="salute">Iubet te dominus plurimum <lb xml:id="p1z12"/>salvere.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l28">Basileae</placeName> 6. septembris.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">T[<lb xml:id="p1z13"/>uus] <persName ref="p8487">Hieremias Mylius</persName> <lb xml:id="p1z14"/><placeName ref="l284">Lipsensis</placeName>, <lb xml:id="p1z15"/><persName ref="p8126">Oporini</persName> minister.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro d. <persName ref="p495">Henrico Bullingero</persName> <lb xml:id="p2z2"/>apud <placeName ref="l587">Tigurinos</placeName> verbi <lb xml:id="p2z3"/>ministro fide[li]ssimo suo.</s>
					<s n="10" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
