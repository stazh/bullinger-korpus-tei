	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non sine magno animi mei dolore legi <lb xml:id="p1z2"/>tuas, colendissime mi domine et frater.</s>
					<s n="3" xml:lang="la">Scribis te <lb xml:id="p1z3"/>non uno, sed pluribus iisque gravibus gravari morbis, <lb xml:id="p1z4"/>in quibus tamen praecellat surditas.</s>
					<s n="4" xml:lang="la">Sed <lb xml:id="p1z5"/>illud maxime dolorem demit, quod servis domini <lb xml:id="p1z6"/>nihil extra aut contra voluntatem domini evenit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Hoc ipsum et te plurimum consolari nihil <lb xml:id="p1z8"/>dubito.</s>
					<s n="6" xml:lang="la">Contraxisti hos tibi morbos curis <lb xml:id="p1z9"/>et studiis nimiis; ergo non sine laude iam ae<lb xml:id="p1z10"/>grotas.</s>
					<s n="7" xml:lang="la">Alii potando, alii scortando sibi morbos <lb xml:id="p1z11"/>graves conciliarunt et decumbunt cum <lb xml:id="p1z12"/>dedecore.</s>
					<s n="8" xml:lang="la">Certe gloriosum est aliquid sufferre <lb xml:id="p1z13"/>propter studium veritatis et curam ecclesi<lb xml:id="p1z14"/>asticam, et haec est sors nostra, qui Christo <lb xml:id="p1z15"/>et ecclesiae servimus; vel enim tyranni nos <lb xml:id="p1z16"/>trucidant vel morbi graves nos excrutiant.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/>Praedixit hoc nobis dominus noster; idem pollicetur <lb xml:id="p1z18"/>vires ad sufferendum, ad fidem et <lb xml:id="p1z19"/>patientiam.</s>
					<s n="10" xml:lang="la">Hunc si sedulo invocaveris, <lb xml:id="p1z20"/>quae tua est pietas, senties auxilium et con<lb xml:id="p1z21"/>solationem praesentissimam; interim in tenta<lb xml:id="p1z22"/>tionibus et malis obdura.</s>
					<s n="11" xml:lang="la">Certo enim <lb xml:id="p1z23"/>non negliget te, qui te hactenus et res <lb xml:id="p1z24"/>tuas tam diligenter et fideliter procuravit.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z25"/>His paucis te compellare volui, ne <lb xml:id="p1z26"/>omnino nihil scriberem per hunc certum ta<lb xml:id="p1z27"/>bellionem.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z28"/>Ego in reliquis sermonibus <lb xml:id="p1z29"/>absolvendis pergo; tu ora, ut dominus laborantem <lb xml:id="p1z30"/>adiuvet.</s>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z31"/>Saluta meo nomine <lb xml:id="p1z32"/>d. <persName ref="p1278">Gastium</persName>, cuius silentium nescio quid <lb xml:id="p1z33"/>sibi velit.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z34"/>cum tuis omnibus.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z35"/><placeName ref="l587">Tiguri</placeName> 8. aprilis anno 1550.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z36"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Pr<pb/><lb xml:id="p2z1"/>aestantissimo viro d. <persName ref="p8418">Osvaldo Myconio</persName>, domino et fratri <lb xml:id="p2z2"/>suo colendissimo.</s>
				</p>
				<p>
					<s n="19" xml:lang="de"><placeName ref="l28">Basel</placeName>.</s>
				</p>
				<p>
					<note>[Auf der Rückseite neben der Adresse von der Hand des <persName ref="p8418">Myconius</persName>:]</note>
					<s n="20" xml:lang="la">Cęsar valet, exit deambul<lb xml:id="p2z3"/>atum bis aut ter per septimanam.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Comitia instituit vel <placeName ref="l410">Ratispo<lb xml:id="p2z4"/>nam</placeName> vel <placeName ref="l361">Nurenbergam</placeName> vel <placeName ref="l18">Augustam</placeName>; <lb xml:id="p2z5"/>placet <placeName ref="l18">Augusta</placeName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p2z6"/>Retromisit quendam <placeName ref="l15">Antwerpiam</placeName>, <lb xml:id="p2z7"/>qui literas paret imprimi comitia <lb xml:id="p2z8"/>denuntiantes in kalendas iulii.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p2z9"/>Scripsit pro novo concilio <placeName ref="l425">Romam</placeName> ad <lb xml:id="p2z10"/>papam novum in <placeName ref="l822">Germania</placeName> habendo, <lb xml:id="p2z11"/>constituit <placeName ref="l322">Metim</placeName> etc.</s>
					<s n="24" xml:lang="la">Papa r<lb xml:id="p2z12"/>espondit per omnia se obtemperaturum et totus <lb xml:id="p2z13"/>factus est Cęsarianus, a <placeName ref="l832">Gallo</placeName> defecit.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p2z14"/>Rex quidam <placeName ref="l2549">Aphricanus</placeName> exul factus venit <lb xml:id="p2z15"/>ad Cęsarem pro auxilio etc.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p2z16"/>Ad senatum hęc scripta <lb xml:id="p2z17"/>mense aprilis anno 1550.</s>
				</p>
			</div>
		</body>
	</text>
