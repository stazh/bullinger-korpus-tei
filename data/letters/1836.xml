	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Hodie <persName ref="p8011">Iohannes Rodolphus</persName> a <placeName>Landeberg</placeName>, <persName>Caspar Messicomerus</persName> <lb xml:id="p1z3"/>et <persName>Felix Blonslius</persName> nobis significarunt sese a vobis, <lb xml:id="p1z4"/>optimi et colendissimi fratres, domum revocari <lb xml:id="p1z5"/>et testimonium actae apud nos vitae a nobis petierunt, <lb xml:id="p1z6"/>quod illis minime putavimus denegandum.</s>
					<s n="3" xml:lang="la">Hoc <lb xml:id="p1z7"/>igitur vobis testatum esse cupimus, quamdiu apud <lb xml:id="p1z8"/>nos vixerunt, visos esse nobis pios, modestos et <lb xml:id="p1z9"/>studiosos adolescentes neque quicquam unquam in ipsis esse vel <lb xml:id="p1z10"/>a nobis animadversum vel ab aliis ad nos delatum, <lb xml:id="p1z11"/>quod ab ipsorum officio esset alienum.</s>
					<s n="4" xml:lang="la">Utinam ergo <lb xml:id="p1z12"/>dominus perficiat, quod in ipsis inchoavit, et <lb xml:id="p1z13"/>non illis modo, sed quamplurimis etiam aliis <lb xml:id="p1z14"/>opera nostra in domino prodesse possit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Hanc enim uberrimam et amplissimam laborum <lb xml:id="p1z16"/>nostrorum mercedem esse arbitrabimur, si <lb xml:id="p1z17"/>qualescunque nostros conatus neque ecclesiae dei <lb xml:id="p1z18"/>inutiles neque vobis, optimi fratres, ingratos <lb xml:id="p1z19"/>esse intelligamus.</s>
					<s n="6" xml:lang="la" ana="farewell">Bene valete in domino, <lb xml:id="p1z20"/>quem ex animo precamur, ut ecclesiam suam <lb xml:id="p1z21"/>et vos imprimis salvos et incolumes praestet.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z22"/><placeName ref="l280">Lausanae</placeName> tertio calendas aprilis 1553.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z23"/><persName ref="p8033">T<lb xml:id="p1z24"/>heodorus Beza</persName>, frater in <lb xml:id="p1z25"/>domino vestri observantissimus, <lb xml:id="p1z26"/>nomine ministrorum et <lb xml:id="p1z27"/>professorum huius ecclesiae <lb xml:id="p1z28"/><placeName ref="l280">Lausanensis</placeName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximiis servis dei <lb xml:id="p2z2"/>et fratribus in domino <lb xml:id="p2z3"/>colendissimis ministris <lb xml:id="p2z4"/>verbi et professoribus <lb xml:id="p2z5"/>bonarum artium.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
