	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quomodo nostri cives tam in civitate quam ex <lb xml:id="p1z2"/>agro proruerint in <placeName ref="l832">Gallicam</placeName> militiam, proximis literis<note xml:id="fn1" type="footnote" n="1">Oben <ref target="file11984">Nr. 1937</ref>.</note> <lb xml:id="p1z3"/>fusissime scripsi.</s>
					<s n="3" xml:lang="la">Sed quid iam agendum est, quum res facta <lb xml:id="p1z4"/>infecta iri<note xml:id="fna" type="footnote" n="a"><hi>In der Vorlage</hi> ire.</note> non potest<note xml:id="fn2" type="footnote" n="2"><bibl source="b56">Adagia</bibl>, 2, 3, 72 (<bibl>ASD</bibl> II/3 290-292, <ref target="file11315">Nr. 1272</ref>).</note>?</s>
					<s n="4" xml:lang="la"><persName ref="p8418">Myconius</persName> proxima dominica<note xml:id="fn3" type="footnote" n="3">6. Juli.</note> voluit <lb xml:id="p1z5"/>illos decimare, <persName ref="p8054">Marcus</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p8054">Markus Bertschi</persName>.</note> contra illos fulminat in omnibus suis contionibus<note xml:id="fnb" type="footnote" n="b">suis contionibus <hi>am Rande nachgetragen.</hi></note>, <lb xml:id="p1z6"/>sed in absentes; <persName ref="p6848">Iacobus</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p6848">Jakob Truckenbrot</persName>.</note>, parvę civitatis<note xml:id="fn6" type="footnote" n="6"><placeName ref="l2860">Klein-Basel</placeName>, der Pfarrei St. Theodor zugeordnet.</note> pastor, totus caesareus <lb xml:id="p1z7"/>est, omne malum illis imprecatur; si adessent, ne auderet <lb xml:id="p1z8"/>mutire contra illos hypocrita.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Ego hactenus ne verbo quidem hac <lb xml:id="p1z9"/>de re mentionem habui, quum me actum agere<note xml:id="fn7" type="footnote" n="7"><bibl source="b56">Adagia</bibl>, 1, 4, 70 (<bibl>ASD</bibl> II/1 456, <ref target="file10402">Nr. 370</ref>).</note> sciam.</s>
					<s n="6" xml:lang="la">Utinam, <lb xml:id="p1z10"/>antequam abiissent, tam audaces quidam fuissent, quo in officio cives <lb xml:id="p1z11"/>mansissent!</s>
					<s n="7" xml:lang="la">Tuum consilium hic requiro.</s>
					<s n="8" xml:lang="la">Scio Davidem in hoc laudari, <lb xml:id="p1z12"/>quod seditiosis pepercerit<note xml:id="fn8" type="footnote" n="8">Vgl. <cit type="bible"><ref>1Sam 24 und 26</ref></cit>.</note>.</s>
					<s n="9" xml:lang="la">Reliqui iam consolandi sunt, quorum animo<lb xml:id="p1z13"/>s <placeName ref="l832">Gallicum</placeName> aurum nondum tetigit.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Quid camera a nostris <lb xml:id="p1z14"/>pecuniarum postulet,<note xml:id="fn9" type="footnote" n="9"><placeName ref="l28">Basel</placeName> hatte an der <placeName ref="l21">Badener</placeName> Tagsatzung vom 23. Juni mitgeteilt, es sei vonseiten des Kaisers aufgefordert worden, 6510 Gulden an den Kriegszug gegen <placeName ref="l832">Frankreich</placeName> beizusteuern; s. <bibl source="b197">EA</bibl> IV/1c 393 i.</note> ex relatu aliorum percepisti.</s>
					<s n="11" xml:lang="la">Gliscit <lb xml:id="p1z15"/>bellum crudele.</s>
					<s n="12" xml:lang="la"><persName ref="p18538">Caesar</persName><note xml:id="fn10" type="footnote" n="10"><persName ref="p18538">Karl V.</persName></note> non cessabit, donec totam <placeName ref="l822">Germaniam</placeName> bellicis <lb xml:id="p1z16"/>tumultibus involvat.</s>
					<s n="13" xml:lang="la">Audio in illius exercitu maiorem partem <lb xml:id="p1z17"/>militum disenteria laborare, famem perpeti, nihil pecuniarum <lb xml:id="p1z18"/>accipere et ex spolio vivere.</s>
					<s n="14" xml:lang="la">Ubi nunc caesar iam sit cum <lb xml:id="p1z19"/>suo exercitu, ignoro<note xml:id="fn11" type="footnote" n="11">Der Kaiser befand sich auf dem Weg nach <placeName ref="l2013">Saint-Dizier</placeName>; s. <bibl source="b610">Stälin</bibl> 577.</note>.</s>
					<s n="15" xml:lang="la">De ducis <persName ref="p20318">Brunsvicensis</persName><note xml:id="fn12" type="footnote" n="12">Herzog <persName ref="p20318">Heinrich von Braunschweig-Wolfenbüttel</persName>.</note> exercitu<note xml:id="fn13" type="footnote" n="13">Vgl. unten <ref target="file12008">Nr. 1961</ref>, 22-25 mit Anm. 24; <ref target="file12016">Nr. 1969</ref>, 22-24.</note> nihil <lb xml:id="p1z20"/>certi possum dicere, donec certiora cognovero.<pb type="edition" next="305"/></s>
				</p>
				<p>
					<s n="16" xml:lang="la">Libellus <lb xml:id="p1z21"/><persName ref="p1974">Lutheri</persName><note xml:id="fn14" type="footnote" n="14">Das von <persName ref="p1278">Gast</persName> gesandte Buch (s. oben <ref target="file11970">Nr. 1923</ref> mit Anm. 18) scheint also nicht <persName ref="p495">Bullingers</persName> Anfrage (s. oben <ref target="file11905">Nr. 1859</ref> mit Anm. 1) entsprochen zu haben.</note> an extet, diligenter perscrutabor tabernas biblio<lb xml:id="p1z22"/>polarum.</s>
					<s n="17" xml:lang="la" ana="farewell">Vale cum uxore<note xml:id="fn15" type="footnote" ana="bio" n="15"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> et liberis<note xml:id="fn16" type="footnote" n="16">Zu <persName ref="p495">Bullingers</persName> Kindern s. oben <ref target="file11884">Nr. 1838</ref>, Anm. 19.</note>.</s>
					<s n="18" xml:lang="la" ana="salute">D. <persName ref="p8171">Theodorum</persName><note xml:id="fn17" type="footnote" n="17"><persName ref="p8171">Theodor Bibliander</persName>.</note> <lb xml:id="p1z23"/>et <lb xml:id="p1z24"/><persName ref="p1214">Frisium</persName><note xml:id="fn18" type="footnote" n="18"><persName ref="p1214">Johannes Fries</persName>.</note> nomine meo salutabis.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l28">Bas[ileae]</placeName><note xml:id="fnc" type="footnote" n="c">Bas. <hi>nachträglich eingefügt.</hi></note>, 11. iulii 1544.</s>
					<s n="20" xml:lang="la">Tuus <persName ref="p1278">Ioan. Gastius</persName> e<pb/><lb xml:id="p2z1"/>x animo.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="21" xml:lang="de"><lb xml:id="p2z2"/>Dem würdigen und <lb xml:id="p2z3"/>wolgelerten hernn M. <lb xml:id="p2z4"/><persName ref="p495">Heinrychen Bullinger</persName>, <lb xml:id="p2z5"/>pfarhernn zuͦ <placeName ref="l587">Z<lb xml:id="p2z6"/>urich</placeName> imm grossen münster <lb xml:id="p2z7"/>etc.</s>
				</p>
				<p>
					<s n="22" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
