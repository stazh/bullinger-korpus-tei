	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Haec paucula scribo, dilecte frater, ut <lb xml:id="p1z2"/>videas me tuas bona fide accepisse ultimas de <lb xml:id="p1z3"/>subdolo Rezüntziano negotio.</s>
					<s n="3" xml:lang="la">Cum vero tuum f<lb xml:id="p1z4"/>eceris officium fideliter, reliquum deo committe; <lb xml:id="p1z5"/>dabit is his quoque finem.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Scis illud: post tenebras <lb xml:id="p1z6"/>lux; scis, quid minatus sit nobis dominus et qui prae<lb xml:id="p1z7"/>decessores nostri pertulerint.</s>
					<s n="5" xml:lang="la">Animemus ergo corda <lb xml:id="p1z8"/>nostra constantia et patientia perseverantes in <lb xml:id="p1z9"/>opere bono et apud fratres, qui te amant ex animo <lb xml:id="p1z10"/>syncere.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Reconciliabit tibi dominus eos, qui nunc <lb xml:id="p1z11"/>videntur esse hostes infensissimi, et dabit tibi suam <lb xml:id="p1z12"/>benedictionem.</s>
					<s n="7" xml:lang="la">Ora quoque dominum, ut is esse pergas, <lb xml:id="p1z13"/>qui fuisti hucusque.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Utinam fusius tecum commentari <lb xml:id="p1z14"/>liceret de militia, quae instituitur, <placeName ref="l2510">Turcica</placeName>!</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>Videres, quod alias vides: bellum hoc peregrinum <lb xml:id="p1z16"/>et nihil ad nos pertinens, maximis malis <lb xml:id="p1z17"/>implicabit Helvetiam, nisi resipuerit; de quo <lb xml:id="p1z18"/>conferemus, cum ad nos veneris.</s>
					<s n="10" xml:lang="la">Dominus benedicat <lb xml:id="p1z19"/>itineri tuo.</s>
					<s n="11" xml:lang="la">Fama est <placeName ref="l587">Tigurinos</placeName> consensisse <lb xml:id="p1z20"/>in hoc bellum <placeName ref="l2510">Turcicum</placeName>.</s>
					<s n="12" xml:lang="la">Mentitissimum est; non <lb xml:id="p1z21"/>consenserunt neque consentient.</s>
					<s n="13" xml:lang="la">Qui bene vult <lb xml:id="p1z22"/>Helvetiae et posteris nostris, cavebit, ne immisceamur.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z23"/>Quae nova ex <placeName ref="l18">Augusta Vindelicorum</placeName> <lb xml:id="p1z24"/>habeo, tibi communico in inserta charta.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">S<lb xml:id="p1z25"/>alutabis utrumque consulem, <persName ref="p8057">Campellum</persName>, <persName ref="p6130">Pontisellam</persName>.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z26"/>d. <persName ref="p1770">Carolum Gregorium</persName>, <persName ref="p8186">Bonettum</persName>, medicum R[uinellam] et alios viros <lb xml:id="p1z27"/>bonos.</s>
					<s n="17" xml:lang="la">Dominus benedicat tibi et custodiat <lb xml:id="p1z28"/>te <lb xml:id="p1z29"/>ab omni malo.</s>
					<s n="18" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 25. ianuarii <lb xml:id="p1z30"/>anno salutis nostrae 1572.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z31"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <lb xml:id="p2z2"/><persName ref="p8016">Tobiae Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro <lb xml:id="p2z4"/>fideli, domino et <lb xml:id="p2z5"/>fratri suo honorando <lb xml:id="p2z6"/>et dilecto.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
