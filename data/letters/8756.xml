			<zone xml:id="p2z7-0" points="1517,1841 1533,1835 1581,1864 1608,1863 1674,1832 1747,1834 1766,1825 1768,1803 1730,1791 1718,1798 1683,1768 1639,1754 1612,1766 1574,1752 1522,1761">1528,1833 1554,1829 1581,1828 1608,1826 1635,1824 1662,1822 1689,1820 1716,1819 1743,1819 1770,1821</zone>
