	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><placeName ref="l234">Isna</placeName> redii nudiustertius<note xml:id="fn1" type="footnote" n="1">Zu <persName ref="p8055">Blarers</persName> Reise nach <placeName ref="l234">Isny</placeName> s. oben <ref target="file12181">Nr. 2134</ref>, Anm. 20.</note>, ubi plenam vereque iustam <lb xml:id="p1z2"/>d. d. <persName ref="p18137">Ioannis Marpachii</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p18137">Johannes Marbach</persName>.</note>, qui parochum illic agit praesente etiam <lb xml:id="p1z3"/><persName ref="p8440">Gervasio</persName> nostro<note xml:id="fn3" type="footnote" n="3"><persName ref="p8440">Gervasius Schuler</persName>.</note>, purgationem accepi, qui omnium testimonio <lb xml:id="p1z4"/>nunquam quicquam tale, quale tu nuper scribebas,<note xml:id="fn4" type="footnote" n="4">Ein verloren gegangener Brief <persName ref="p495">Bullingers</persName>; s. oben <ref target="file12181">Nr. 2134</ref>, Anm. 12.</note> in quemquam <lb xml:id="p1z5"/>pro concione dixit.</s>
					<s n="3" xml:lang="la">Sed <persName ref="p4628">diaconum</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p4628">Georg Denneler</persName>.</note> habet, qui aliorum <lb xml:id="p1z6"/>nonnullorum intemperie vehementer extimulatur ad <lb xml:id="p1z7"/>boni viri traductionem - ubi etiam sedulo suam operam praestat, <lb xml:id="p1z8"/>ut in omnium odium rapiatur, quum ipse nec doctus sit nec <lb xml:id="p1z9"/>cordatus -, ut <persName ref="p18137">doctor</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p18137">Marbach</persName>.</note> satius ducat illinc demigrare <lb xml:id="p1z10"/>quam sua praesentia adversariorum in se odium magis atque <lb xml:id="p1z11"/>magis inflammare, praesertim quum primarii quidam <lb xml:id="p1z12"/>sibi sint vehementer iniqui nec spes sit melioris <lb xml:id="p1z13"/>animi<note xml:id="fn7" type="footnote" n="7"><persName ref="p18137">Marbach</persName> blieb nicht mehr lange in <placeName ref="l234">Isny</placeName>, sondern wechselte durch <persName ref="p467">Bucers</persName> Vermittlung nach <placeName ref="l491">Straßburg</placeName>, wo er am 12. Juli 1545 Prediger an St. Nicolai wurde; s. oben <ref target="file12168">Nr. 2121</ref>, Anm. 18; unten <ref target="file12243">Nr. 2196</ref>, 88f.</note>.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Literas tuas <persName ref="p3927">Welsero</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p495">Bullingers</persName> Brief an <persName ref="p3927">Hans Welser</persName> ist nicht erhalten; s. dazu unten Nr. 2156, Anm. 9.</note> inscriptas accepi; <lb xml:id="p1z14"/>cras aut postridie illas <placeName ref="l18">Augustam</placeName> missurus.<pb type="edition" next="286"/></s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>In<note xml:id="fna" type="footnote" n="a"><hi>Anstreichung dieses Abschnitts und Randbemerkung von <persName ref="p8055">Blarer</persName>:</hi> Ita <persName ref="p467">Bucerus</persName>.</note><note xml:id="fn9" type="footnote" n="9">Der Abschnitt enstammt fast wörtlich dem Brief <persName ref="p467">Bucers</persName> an <persName ref="p8055">Blarer</persName> vom 13. April 1545 (<persName ref="p8055">Blarer</persName> BW II 358, <ref target="file11222">Nr. 1179</ref>). Ähnliches hatte <persName ref="p467">Bucer</persName> am 9. April auch an <persName ref="p495">Bullinger</persName> geschrieben; s. oben <ref target="file12178">Nr. 2131</ref>, 86-110.</note> comitiis<note xml:id="fn10" type="footnote" n="10">Der Reichstag zu <placeName ref="l569">Worms</placeName>.</note> scis <persName ref="p18538">imperatorem</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p18538">Karl V.</persName></note> proposuisse non <lb xml:id="p1z16"/>superesse nunc tempus tractandę religioni, <lb xml:id="p1z17"/>id est conversioni nostrę ad dominum<note xml:id="fn12" type="footnote" n="12">Vgl. oben <ref target="file12178">Nr. 2131</ref>, 88f und Anm. 53.</note>.</s>
					<s n="6" xml:lang="la"><placeName ref="l2510">Turcos</placeName> instare, <lb xml:id="p1z18"/>illis etiam sine domino occurrendum esse<note xml:id="fn13" type="footnote" n="13">Siehe oben <ref target="file12178">Nr. 2131</ref>, 87f und Anm. 52.</note>.</s>
					<s n="7" xml:lang="la">Delectum iudici<lb xml:id="p1z19"/>s et assessorum camerę sibi permittendum<note xml:id="fn14" type="footnote" n="14">Siehe oben <ref target="file12178">Nr. 2131</ref>, 96-100 und Anm. 58f.</note>.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z20"/>Nam de religione ipse medium se praestat, scilice<lb xml:id="p1z21"/>t crudelius nunc quam unquam confessores Christi <lb xml:id="p1z22"/>viros ustulando, mulieres vivas defodiendo <lb xml:id="p1z23"/>per totum <placeName ref="l808">Belgicum</placeName> lectionemque sacram undique a <lb xml:id="p1z24"/>populis suis arcendo<note xml:id="fn15" type="footnote" n="15">Zu den Verfolgungen in <placeName ref="l808">Belgien</placeName> s. oben <ref target="file12178">Nr. 2131</ref>, 86f und Anm. 48.</note>.</s>
					<s n="9" xml:lang="la">Consilium electorum et civitatum <lb xml:id="p1z25"/>de religione prius aut pace religioni ipsi <lb xml:id="p1z26"/>confirmanda - non nobis tantum, et cum<note xml:id="fn16" type="footnote" n="16">=tum.</note> iis - bona, sed <lb xml:id="p1z27"/>non numero suffragiorum maior pars concilii <lb xml:id="p1z28"/>principum contendit; pseudepiscopi omnia deferunt cęsari, <lb xml:id="p1z29"/>advocato scilicet fideli suo<note xml:id="fn17" type="footnote" n="17"><persName ref="p7706">Nicolas Perrenot von Granvelle</persName> oder <persName ref="p7689">Johann von Naves</persName>.</note>.<note xml:id="fn18" type="footnote" n="18">Zur Haltung der Fürsten und Städte s. oben <ref target="file12178">Nr. 2131</ref>, 100-104 und Anm. 61.</note></s>
					<s n="10" xml:lang="la"><persName ref="p20318">Brunsvicensis</persName><note xml:id="fn19" type="footnote" n="19">Herzog <persName ref="p20318">Heinrich d.J. von Braunschweig-Wolfenbüttel</persName>.</note> iterum <lb xml:id="p1z30"/>tumultum excitat contra <persName ref="p7843">Monasteriensem</persName><note xml:id="fn20" type="footnote" n="20"><persName ref="p7843">Franz von Waldeck</persName>, Bischof von <placeName ref="l1097">Münster</placeName>.</note>, quem pseudoclerus <lb xml:id="p1z31"/>illius prodit odio evangelii, quod praedicare ille facit<note xml:id="fn21" type="footnote" n="21">Siehe oben <ref target="file12178">Nr. 2131</ref>, 106-110 und Anm. 64 und 67, und 2133, Anm. 15.</note>.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z32"/>Magnę insidię struuntur <persName ref="p8462">Coloniensi</persName><note xml:id="fn22" type="footnote" n="22"><persName ref="p8462">Hermann von Wied</persName>.</note>.<note xml:id="fn23" type="footnote" n="23">Siehe oben <ref target="file12178">Nr. 2131</ref>, 114 und Anm. 75.</note></s>
					<s n="12" xml:lang="la">Interim <lb xml:id="p1z33"/>scribitur ex <placeName ref="l2472">Polonia</placeName><note xml:id="fn24" type="footnote" n="24">Echo eines Briefes aus <placeName ref="l2472">Polen</placeName> an <persName ref="p8374">Hedio</persName>, wie <persName ref="p1010">Erb</persName> in einem Brief an <persName ref="p495">Bullinger</persName> erwähnt; s. unten <ref target="file12196">Nr. 2149</ref>, 53-55.</note> ingentibus copiis adventare <lb xml:id="p1z34"/><persName ref="p18593">tyrannum</persName> <placeName ref="l1148">Constantinopolitanum</placeName><note xml:id="fn25" type="footnote" n="25">Sultan <persName ref="p18593">Suleiman I.</persName> -Zu dessen Rüstung s. oben <ref target="file12174">Nr. 2127</ref>, Anm. 4.</note>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb type="scan" next="128"/><pb/><lb xml:id="p2z1"/>Iis nihil iam addere possum, nisi quod legati <lb xml:id="p2z2"/>nostri<note xml:id="fn26" type="footnote" n="26"><persName ref="p5856">Matthäus Molckenpur</persName> und <persName ref="p5571">Ludwig Kürnstaller</persName>; s. oben <ref target="file12107">Nr. 2060</ref>, Anm. 3. Molckenpurs Instruktionen finden sich in RTA JR XVI/1 324-327, Nr. 54a-b. Schon am 13. Juli 1545, also vor Ende des Reichstags, war <persName ref="p5856">Molckenpur</persName> wieder in <placeName ref="l257">Konstanz</placeName>, während <persName ref="p5571">Kürnstaller</persName> als Beobachter in <placeName ref="l569">Worms</placeName> zurückblieb; s. <hi>Dobras,</hi> Ratsregiment 93.</note> 21. aprilis ad comitia profecta sunt senatus <lb xml:id="p2z3"/>decreto.</s>
					<s n="14" xml:lang="la">Tu dominum precare, ut omnia bene vertat, <lb xml:id="p2z4"/>nosque illi piis votis perpetuo commenda.</s>
					<s n="15" xml:lang="la" ana="salute">Salutant <lb xml:id="p2z5"/>te germanus meus <persName ref="p8178">frater</persName><note xml:id="fn27" type="footnote" n="27"><persName ref="p8178">Thomas Blarer</persName>.</note> cum <persName ref="p4082">Zviccio</persName><note xml:id="fn28" type="footnote" n="28"><persName ref="p4082">Konrad Zwick</persName>.</note>.</s>
					<s n="16" xml:lang="la" ana="salute">Saluta tuam domum <lb xml:id="p2z6"/>cum administris in domino, imprimis d. <persName ref="p8011">Gvaltherum</persName>, <lb xml:id="p2z7"/><persName ref="p8127">Pellicanum</persName> et <persName ref="p8171">Theodorum</persName><note xml:id="fn29" type="footnote" n="29"><persName ref="p8171">Theodor Bibliander</persName>.</note>, etc.</s>
					<s n="17" xml:lang="la">Miro dei consilio factum arbi[tror]<note xml:id="fnb" type="footnote" n="b"><hi>Wortteil hier und im Folgenden im engen Einband verdeckt. Ergänzungen aus dem 1974 von dieser Handschrift angefertigten Mikrofilm, in dem der Randtext noch zugänglich war.</hi></note>, <lb xml:id="p2z8"/>ut, quum primo <persName ref="p4082">consobrinus</persName><note xml:id="fn30" type="footnote" n="30"><persName ref="p4082">Konrad Zwick</persName>.</note>, deinde <persName ref="p8178">Thomas</persName> <lb xml:id="p2z9"/>frater<note xml:id="fn31" type="footnote" n="31"><persName ref="p8178">Thomas Blarer</persName>.</note><pb type="edition" next="287"/> huic legationi destinatus sit, neuter ta[men] <lb xml:id="p2z10"/>abierit.</s>
					<s n="18" xml:lang="la">Utinam, quod meditor,<note xml:id="fn32" type="footnote" n="32">Zu den Verhandlungen überein mögliches Bündnis zwischen <placeName ref="l587">Zürich</placeName> und <placeName ref="l257">Konstanz</placeName>, in dem auch <persName ref="p4082">Zwicks</persName> Kriegskunst eine Rolle spielt, s. oben <ref target="file12131">Nr. 2084</ref>, Anm. 1, und <ref target="file12181">Nr. 2134</ref>, 70-85 und Anm. 36.</note> dominus aliqua[ndo] <lb xml:id="p2z11"/>effectum nobis reddat idque feliciter et ita, ut <lb xml:id="p2z12"/>nomen suum inde sanctificetur!</s>
					<s n="19" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z13"/><persName ref="p5829">Iacobum Metzlerum</persName>, adulescentem nostrum, tibi commen[do], ut, <lb xml:id="p2z14"/>quemadmodum cępisti, constanter pergas<note xml:id="fn33" type="footnote" n="33">Zu <persName ref="p5829">Jakob Metzler</persName> s. zuletzt oben <ref target="file12187">Nr. 2140</ref>, 18f.</note>.</s>
					<s n="21" xml:lang="la">26. ap[rilis] 154[5].</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Tuus <persName ref="p8055">Ambr. Blaurerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse darunter:]</note>
