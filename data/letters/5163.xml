	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>ste.
					<lb xml:id="p1z2"/>discuterentur certa quaedam postulata concionatorum
					<lb xml:id="p1z3"/>nostrirum Sabauditorum adeoque et in ea pergere cn
					<lb xml:id="p1z4"/>cnstituermus praesertim, cum intelligerem benigne
					<lb xml:id="p1z5"/>concesses esse a vobis vestros ministros, interim
					<lb xml:id="p1z6"/>tamen expendimus diligentius praesentis temporis per
					<lb xml:id="p1z7"/>insidias, concilii Tridentini conatum et practi
					<lb xml:id="p1z8"/>varias, intelleximus item, quae Bullingerus ad
					<lb xml:id="p1z9"/>Hallarum nostrum scripsit, quae incommoda sint consequturus
					<lb xml:id="p1z10"/>si infectis rebus solvatur synodas, ideoque his omnibus
					<lb xml:id="p1z11"/>praesenti tensore
					<lb xml:id="p1z12"/>peritatis visum est melis esse non
					<lb xml:id="p1z13"/>comvonre in synodum, sed scriptam consultationem
					<lb xml:id="p1z14"/>scholarcharum et ministrorum nostrorum
					<lb xml:id="p1z15"/>bsSabadicis nostris concionatoribus satis fieri posse
					<lb xml:id="p1z16"/>mittere ministris vestris et consilium iudiciam
					<lb xml:id="p1z17"/>oru super hac audire, si forte dominus concedat
					<lb xml:id="p1z18"/>ortia sua, ut ex nostrorum nec non vestrorum con
					<lb xml:id="p1z19"/>concionatorum iudicio mediu aliquod inveniamu
					<lb xml:id="p1z20"/>quo rebus consulatur et concionatores Sabaudia
					<lb xml:id="p1z21"/>suis ecclesiis pacifice agere possint. Ideoque
					<lb xml:id="p1z22"/>mittimus hic nobis contultatione nostrorum et
					<lb xml:id="p1z23"/>oramus, qua possumus maxime, ut proponatis hanc
					<lb xml:id="p1z24"/>ministris vestris, quo hic libere quid ipsis
					<lb xml:id="p1z25"/>deatur vel servandum vel mutandum aut ad
					<lb xml:id="p1z26"/>tollendumve scripto exponat. Quod
					<lb xml:id="p1z27"/>et ab eis benigne petimus. Ubi autem ipsorum
					<lb xml:id="p1z28"/>iudicium habuerimus, diligenter deo auxiliante
					<lb xml:id="p1z29"/>consultabimus, et quod aequum fuerunt faciemus
					<lb xml:id="p1z30"/>tabrire
				</p>
			</div>
		</body>
	</text>
