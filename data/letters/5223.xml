	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>.
					<lb xml:id="p1z2"/>hilips von gots gnaden landgrave
					<lb xml:id="p1z3"/>zu thessen, grove zu Sayenelupogn etc.
					<lb xml:id="p1z4"/>Unserm gredigenn gruß zuvon wirdiger und
					<lb xml:id="p1z5"/>wolgelarther, lieber besonder. Wir haben
					<lb xml:id="p1z6"/>ewerschreibenn underm dato Zurich den
					<lb xml:id="p1z7"/>20. i. februarii nebenn, den darbey
					<lb xml:id="p1z8"/>wartenn zeitungenn empfangenn gelessen
					<lb xml:id="p1z9"/>unnd thunn uns solcher überschickung zegenn
					<lb xml:id="p1z10"/>euch gnediglichern bedanckenn o
					<lb xml:id="p1z11"/>ir auch weiter zeitung vom concilio oder
					<lb xml:id="p1z12"/>wie es min der religion inn Franckerich
					<lb xml:id="p1z13"/>steher bebohumet. begehrenn
					<lb xml:id="p1z14"/>wirgnediglichenn, ir wölle uns dieselben
					<lb xml:id="p1z15"/>mittheilenn. Wann es auch was
					<lb xml:id="p1z16"/>trefflichs wehre. als dann uns solchs
					<lb xml:id="p1z17"/>uff unsernn ceisten zu schreiben,
					<lb xml:id="p1z18"/>wollenn wirdas bottenlohen
					<lb xml:id="p1z19"/>ußrichtenn und bevalen lassenn.
					<lb xml:id="p1z20"/>sir gesinnenn auchann euch gneriglichenn
					<lb xml:id="p1z21"/>In wollet als einn cristlicher mann
					<lb xml:id="p1z22"/>den sachenn nachdencken, os man
					<lb xml:id="p1z23"/>inn dem Rrfickell das nachtmall
					<lb xml:id="p1z24"/>belangende zu vergleichung biesunen
					<pb/>
					<lb xml:id="p2z1"/>beent; dann solchs gehr eim guot cristlich
					<lb xml:id="p2z2"/>Weerch wehr.
					<lb xml:id="p2z3"/>Das wir euch uff ewer schreibenn anzergen
					<lb xml:id="p2z4"/>gewoltt unndsenndr euch mit sondern
					<lb xml:id="p2z5"/>gnaden gneigt. Datum Dassell am
					<lb xml:id="p2z6"/>13 aumeii anno domini 153.
					<lb xml:id="p2z7"/>fesis.
					<lb xml:id="p2z8"/>hosser e.
				</p>
			</div>
		</body>
	</text>
