	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>De came<lb xml:id="p1z3"/>lis a <lb xml:id="p1z4"/><placeName ref="l2510">T<lb xml:id="p1z6"/>ur<lb xml:id="p1z7"/>c<lb xml:id="p1z8"/>a</placeName> Caesari <lb xml:id="p1z9"/>mis<lb xml:id="p1z10"/>sis <placeName ref="l18">A<lb xml:id="p1z12"/>ugusta</placeName> s<lb xml:id="p1z13"/>cribit<lb xml:id="p1z14"/>ur tre<lb xml:id="p1z15"/>s <lb xml:id="p1z17"/>fu<lb xml:id="p1z18"/>isse auro et a<lb xml:id="p1z19"/>rgento s<lb xml:id="p1z20"/>imu<lb xml:id="p1z22"/>l et ge<lb xml:id="p1z25"/>mm<lb xml:id="p1z28"/>is ornata su<lb xml:id="p1z29"/>p<lb xml:id="p1z30"/>pell<lb xml:id="p1z31"/>ect<lb xml:id="p1z32"/>il<lb xml:id="p1z33"/>i onustos, praeterea christianos aliquot multis iam annis in vincu<lb xml:id="p1z34"/>lis <lb xml:id="p1z35"/>detentos <lb xml:id="p1z36"/>i<lb xml:id="p1z37"/>n Caesaris gratiam abso<lb xml:id="p1z38"/>lutos.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z39"/>Fu<lb xml:id="p1z40"/>it hic iam <placeName ref="l257">Consta<lb xml:id="p1z41"/>ntiensibus</placeName>, meis olim civi<lb xml:id="p1z42"/>bus, valde quam comis et familiaris..<lb xml:id="p1z43"/>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z44"/><placeName ref="l157">Francoforti</placeName> cu<lb xml:id="p1z45"/>m a <lb xml:id="p1z46"/>tribus principibus ele<lb xml:id="p1z47"/>ctoribu<lb xml:id="p1z48"/>s, <placeName ref="l749">Saxone</placeName>, <placeName ref="l2477">Palatino</placeName> <lb xml:id="p1z49"/>et <placeName ref="l1048">Brandenburgensi</placeName>, petiisset, ut in filii inauguratione solitis cerimoniis et <lb xml:id="p1z50"/>papisticis sacris adessent, et illi hoc sibi haudquaquam per conscientiam et dei verbi regulam licere <lb xml:id="p1z51"/>affirmarent: "Ha", dixit, "est et filius meus in hac sententia, <foreign xml:lang="de">und ich sich wol, wan<lb xml:id="p1z52"/>n ich stirb, so wirt die mesß ouch gestorben sin."</foreign></s>
					<s n="4" xml:lang="la">Quod utinam vates minime <lb xml:id="p1z53"/>vanus dixerit!</s>
					<s n="5" xml:lang="la">Scribunt eum duas iam filias alteram <placeName ref="l150">Ferrariensi</placeName>, alteram <placeName ref="l572">Wirtempergensi</placeName> <lb xml:id="p1z54"/>principibus elocaturum, quod mihi sane de Wirtempergensi non fit verisimile.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z55"/><persName ref="p458">Brentium</persName> mortuum esse quominus credam, facit, quod affinis meus <persName ref="p8500">Scherus</persName>, <lb xml:id="p1z56"/>qui non pridem hinc abiit, nihil prorsum de hoc nobis indicavit, quum non semel <lb xml:id="p1z57"/>in familiaribus colloquiis mentio nobis viri inciderit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Quodsi repentino quodam casu <lb xml:id="p1z58"/>abreptus est, dominum illi precabor propicium; nam quod homines attinet, ineluibilem <lb xml:id="p1z59"/>maculam apud syncęros et doctos viros post se reliquit multis alioqui dotibus <lb xml:id="p1z60"/>a domino praeter multos alios exornatus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Librum tuum, quo illi respondes, cum multis aliis <lb xml:id="p1z61"/>magno desyderio expectamus.</s>
				</p>
				<p>
					<s n="9" xml:lang="de" ana="salute">Lebe wohl; <lb xml:id="p1z62"/>bete für mic<lb xml:id="p1z63"/>h mit den <lb xml:id="p1z64"/>Deinen und grüße sie.</s>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Prid<lb xml:id="p2z2"/>ie <lb xml:id="p2z3"/>calendas feb[ruarii].</s>
				</p>
			</div>
