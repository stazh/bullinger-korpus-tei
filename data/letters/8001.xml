	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Ergo accidit, quod vos istic praesagiebatis
					<lb xml:id="p1z2"/>et ego hic retuebam Bibliander, dum
					<lb xml:id="p1z3"/>persuaderi se non sinit, ut hinc discedat
					<lb xml:id="p1z4"/>et praeterea cum aliis quibusdam
					<lb xml:id="p1z5"/>temere, quamvis praemonitus et obiurgatus
					<lb xml:id="p1z6"/>commiscet, peste post illos mortuos tactus,
					<lb xml:id="p1z7"/>septimo post die moritur et ipse, pre quidem
					<lb xml:id="p1z8"/>e valde religiose, sed morte sibi ullo
					<lb xml:id="p1z9"/>accersita. Hoc mihi valde et tua et
					<lb xml:id="p1z10"/>matris eius causa dolet. Sed quod deo
					<lb xml:id="p1z11"/>visum est, id sane ut optimum implectamur
					<lb xml:id="p1z12"/>oportet, quod unum in hac calamitate
					<lb xml:id="p1z13"/>consolatur. De rebus Gallicis, sunt qu
					<lb xml:id="p1z14"/>pictavos expuguatos a nostras affirment
					<lb xml:id="p1z15"/>superioris mensis 26. quodsi verum
					<lb xml:id="p1z16"/>est, maximam cladem hostes acceperit.
					<lb xml:id="p1z17"/>alii negant adhuc captos, sed arcte usque adeo
					<lb xml:id="p1z18"/>obsessos, ut intromitti subsilium nollum
					<lb xml:id="p1z19"/>possit ac proinde pro perditis habeantur
					<lb xml:id="p1z20"/>quum rex iustas copias non tam et
					<lb xml:id="p1z21"/>colligere possit, quibus obsidionem solvat
					<lb xml:id="p1z22"/>Aareliae interea, quum mandato regis
					<lb xml:id="p1z23"/>inclusę essent certis domibus vultorum
					<lb xml:id="p1z24"/>fratrum familiae, quod ab eorum coniurationibus
					<lb xml:id="p1z25"/>metuenerum esse diceret sardinali
					<lb xml:id="p1z26"/>quavis inermes imbelles, quiesti seper
					<lb xml:id="p1z27"/>fuissent, ecces inaudita humanitate
					<lb xml:id="p1z28"/>annati milites una cum fuerosa
					<lb xml:id="p1z29"/>in miseros captivos impetum
					<lb xml:id="p1z30"/>faciunt, nec contenti obvios nonnullos
					<lb xml:id="p1z31"/>iungulasse, igni illis domibus subiecto
					<lb xml:id="p1z32"/>sunctos nullo neque sexus nec aetatis discrimine
					<lb xml:id="p1z33"/>etiam cum ipsius urbis periculo concre
					<lb xml:id="p1z34"/>Hoc exemplo valde metuo ne
					<lb xml:id="p1z35"/>aliae pleraeque urbe, sequantur, quum praesertim
					<lb xml:id="p1z36"/>hoc constet Albanum ducem regi
					<lb xml:id="p1z37"/>sualissinec aliud sit
					<lb xml:id="p1z38"/>brevius s ad regnum illud suapte manu
					<lb xml:id="p1z39"/>semel perdendum, cui tot iam amime
					<lb xml:id="p1z40"/>inhiat Hispanus. Ho si forte abtineri
					<lb xml:id="p1z41"/>hostis, quid sit nobis quoque expectandum
					<lb xml:id="p1z42"/>utinam nunc saltem plerius intelligerent.
					<lb xml:id="p1z43"/>et periculis non tam remotis quam pitant
					<lb xml:id="p1z44"/>magis commoverentur. Sed haec
					<lb xml:id="p1z45"/>156p. 14. Angli.
					<pb/>
					<lb xml:id="p2z1"/>frustra toties, ut nosti, tentata, facilius
					<lb xml:id="p2z2"/>est optare quam obtinere. Dominus est
					<lb xml:id="p2z3"/>incaeus, qui omnibus providebit. Ubi quid
					<lb xml:id="p2z4"/>certi accepero, scotem redcribo. Interim
					<lb xml:id="p2z5"/>pater, volim, ut quod facilis, porra etiam
