	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi tuas literas, colendissime domine, et <lb xml:id="p1z2"/>ago gratias pro animi tui in me propensione <lb xml:id="p1z3"/>paterna.</s>
					<s n="3" xml:lang="la">Non est autem verendum, ut praecipitanter <lb xml:id="p1z4"/>nostri agant; frigidiores enim sunt, quam <lb xml:id="p1z5"/>ut pro veritate bellum suscipiant.</s>
					<s n="4" xml:lang="la">Verbis <lb xml:id="p1z6"/>rem tractant, nec fieri posse ullo modo crediderim, <lb xml:id="p1z7"/>ut monachi <placeName ref="l329">Morbennio</placeName> expellantur; adeo altas <lb xml:id="p1z8"/>egere radices speculatores isti.</s>
					<s n="5" xml:lang="la"><placeName ref="l306">Mediolanenses</placeName> <lb xml:id="p1z9"/>etiam prae se ferunt omnia officia, quae a vicinis pacificis <lb xml:id="p1z10"/>exspectari debent, et nisi anguis lateat in herba, <lb xml:id="p1z11"/>quam bene affecti erga nostros videri volunt!</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Doctor medicus ille <placeName ref="l329">Morbenniensis</placeName> palinodiam <lb xml:id="p1z13"/>nobis cecinit et nos nostro et aliorum nomine <lb xml:id="p1z14"/>vera attulisse fateri coactus est.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ascanius, quem <lb xml:id="p1z15"/>te nescire scribis, ipsus est, quem comes Han[n]ibal <lb xml:id="p1z16"/>tyrannice perdere et in carcere enecare conatus est, <lb xml:id="p1z17"/>quem etiam ita insectatus est, ut in iudicio nostro <lb xml:id="p1z18"/>extrema fortuna steterit.</s>
					<s n="8" xml:lang="la"><persName>Pompeius Romanus</persName> <lb xml:id="p1z19"/>per legatum nostrum totius actionis cursum et <lb xml:id="p1z20"/>processum, ut vocant, a magistratu nostro ex<lb xml:id="p1z21"/>petivit; sed denegatus ei est, qui ipsi tamen <lb xml:id="p1z22"/><persName>Han[n]ibali</persName> fuit concessus.</s>
					<s n="9" xml:lang="la">Quae et qualis actio fuerit, <lb xml:id="p1z23"/>superiore tempore ad vos misi scripto <placeName ref="l822">Germanico</placeName> <lb xml:id="p1z24"/>nec te puto ignorare.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">De latrocinio isto <persName>Albanico</persName> <lb xml:id="p1z25"/><placeName ref="l28">Basilea</placeName> quoque ad nos perscriptum est, sed de 15 tantum <lb xml:id="p1z26"/>interemptis, non 50.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Nimirum crabrones irri<lb xml:id="p1z27"/>tabit; utinam in suam suorumque pernitiem, ut <lb xml:id="p1z28"/>dignus est!</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Literas tuas hodie <placeName ref="l108">Davosium</placeName> mittam; <lb xml:id="p1z29"/>inde <placeName ref="l499">Susiam</placeName> commode ferentur.</s>
					<s n="13" xml:lang="la">D. Iesus te <lb xml:id="p1z30"/>cum tuis omnibus quam diutissime et aeternum serve<lb xml:id="p1z31"/>t.</s>
					<s n="14" xml:lang="la" ana="salute">Salvum velim d. <persName ref="p1012">Ernium</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p1012">Leonhard Erni</persName>.</note>.</s>
					<s n="15" xml:lang="la" ana="salute">Resalutant te <lb xml:id="p1z32"/>nostri omnes sedulo.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z33"/>29. Iunii <placeName ref="l98">Curiae</placeName> 68.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Tuae amplitudini totus dedit<lb xml:id="p1z34"/>us <persName ref="p8016">Th[obias] Eg[lius</persName>].</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z35"/>Ampliss<pb/><lb xml:id="p2z1"/>imo viro d. <persName ref="p495">H[ennricho] <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z4"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> parocho <lb xml:id="p2z5"/>summo, d. suo <lb xml:id="p2z6"/>clementissimo.</s>
				</p>
				<p>
					<s n="19" xml:lang="de">Zürch.</s>
				</p>
			</div>
