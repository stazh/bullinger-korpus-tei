					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Cum tabellarium ad d. parentem meum <lb xml:id="p1z2"/>colendissimum mitterem, non potui inter<lb xml:id="p1z3"/>mittere, quin te, etsi quod magnopere <lb xml:id="p1z4"/>scriptionem mereretur, nihil haberem, <lb xml:id="p1z5"/>saltem tribus verbis compellarem.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Admonui et d. <persName ref="p8030">Wittgensteinum</persName> comitem, <lb xml:id="p1z7"/>si forte aliquid literarum ad vos <lb xml:id="p1z8"/>dare vellet, qui hasce adiunctas mihi <lb xml:id="p1z9"/>transmisit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>Iam tibi, clarissime vir, quem rebus <lb xml:id="p1z11"/>meis prosperis omnino affici scio, <lb xml:id="p1z12"/>et hoc significare placuit me 14. <lb xml:id="p1z13"/>kale<lb xml:id="p1z14"/>ndas augusti ab illustrissimo principe <lb xml:id="p1z15"/>electore in arctius consilium receptum esse.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z16"/>In quo vitae genere si quid tibi vel <lb xml:id="p1z17"/>tuis prodesse queam, re ipsa quam verbis <lb xml:id="p1z18"/>ostendere mallem, quanti te faciam.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z19"/>Vale, ornatissime vir.</s>
					<s n="7" xml:lang="la">16. kalendas septembris <lb xml:id="p1z20"/><placeName ref="l210">Heidelbergae</placeName> anno 75.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Salutem <lb xml:id="p1z21"/>domino <persName ref="p8011">Gvalthero</persName> et <persName ref="p8442">Simlero</persName> plurimam<lb xml:id="p1z22"/>.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z23"/>Tuus ex animo <lb xml:id="p1z25"/><persName ref="p8081">Iohann Philipp freyherr <lb xml:id="p1z26"/>von Hoen Sax</persName> etc.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Reverendo viro <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae fidelissimo ministro, <lb xml:id="p2z4"/>amico suo colendissimo.</s>
				</p>
				<p>
					<s n="11" xml:lang="de"><lb xml:id="p2z5"/>Herrn <persName ref="p495">Heinrych Bullinger</persName> <lb xml:id="p2z6"/>den elteren.</s>
				</p>
				<p>
					<s n="12" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
