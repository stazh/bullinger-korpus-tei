	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nudiustertius scripsi per <persName>Paulum</persName> quendam Iudaeum.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Nunc, illis quod addam, non habeo, nisi quod <lb xml:id="p1z3"/>maximopere peto, ad meas illas ut respondeas; nisi <lb xml:id="p1z4"/>enim tu indicaveris aliquem, qui <placeName ref="l280">Lausannae</placeName> theologi<lb xml:id="p1z5"/>cam lectionem profiteri possit, fiet, ut hic deliberatio <lb xml:id="p1z6"/>fiat de nostrate aliquo, qualiscunque is tandem siet.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Utinam electio haec careat periculo!</s>
					<s n="5" xml:lang="la">Fratrem meum <lb xml:id="p1z8"/>admoneas etiam, oro, ut per hosce rescribat; habeo enim, <lb xml:id="p1z9"/>ab ipso quoque quod exspectem.</s>
					<s n="6" xml:lang="la"><persName ref="p8351">Frischingos</persName> non est <lb xml:id="p1z10"/>necesse ut tibi commendem, cum ipsa eos tibi propin<lb xml:id="p1z11"/>quitas, qua tibi iuncti sunt, commendet.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Utrunque <lb xml:id="p1z12"/>biennio apud me habui; bonae indolis sunt.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Senior, ut simplicior, ita probior est, alter ingenio<lb xml:id="p1z14"/>sus, sed et petulans magis est.</s>
					<s n="9" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l41">Bernae</placeName> 25. iunii s<lb xml:id="p1z15"/>ub noctem 1559.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><persName ref="p8018">I[oannes] H[allerus]</persName> t[uus].</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrych<lb xml:id="p2z2"/>o Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastor<lb xml:id="p2z4"/>i fidelissimo, domino et <lb xml:id="p2z5"/>compatri suo observan<lb xml:id="p2z6"/>dissimo.</s>
					<s n="13" xml:lang="de"><lb xml:id="p2z7"/>M. <persName ref="p495">Heinrych Bullingern</persName> <lb xml:id="p2z8"/>zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
