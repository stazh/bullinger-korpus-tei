	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Has literas proxime per <persName ref="p540">Calvinum</persName> et <persName ref="p1049">Farellum</persName> missurus eram; redierant <lb xml:id="p1z2"/>enim huc 6. martii ituri etiam <placeName ref="l587">Tigurum</placeName>, ut impetrarent ab <lb xml:id="p1z3"/>illis civitatibus legationem ad regem pro remittenda persecutionis sęvitia.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Sperabant enim hoc posse impetrari modo, postquam rex ex foedere <lb xml:id="p1z5"/>cum Germanis principibus orto mitior esset factus; dedit enim omnibus <lb xml:id="p1z6"/>Germanis liberam pro sua religione in suo regno vivendi facultatem, <lb xml:id="p1z7"/>et hoc publice per universum regnum promulgatum est.</s>
					<s n="4" xml:lang="la">Sed cum senatui nostro videretur <lb xml:id="p1z8"/>nimis mature hoc tentari, flexo itinere <placeName ref="l28">Basilęam</placeName> profecti sunt, <lb xml:id="p1z9"/>nescio quid illic acturi.</s>
					<s n="5" xml:lang="la">Intelligis harum literarum rationem, quas quia <lb xml:id="p1z10"/>alia quoque quędam continerent, nihilominus mittere volui.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">De rebus novis <lb xml:id="p1z11"/>nihil est, quod scribam; plenius nimirum ea omnia apud vos habentur.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Certum est regem maximis copiis intraturum Germaniam.</s>
					<s n="8" xml:lang="la">A <persName ref="p18250">Mauritio</persName> <lb xml:id="p1z13"/>aiunt <placeName ref="l157">Francofurtum</placeName> obsideri, a classe <placeName ref="l830">Anglica</placeName> et <placeName ref="l832">Gallica</placeName> <placeName ref="l15">Antverpiam</placeName>.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z14"/>Iacta est alea belli gravissimi et periculosissimi, de quo nesci[o, <lb xml:id="p1z15"/>quid] boni mihi promittam.</s>
					<s n="10" xml:lang="la">Certe horret animus.</s>
					<s n="11" xml:lang="la">Uti nostri domi [man<lb xml:id="p1z16"/>e]rent et suis essent finibus contenti!</s>
					<s n="12" xml:lang="la">Metuo irruptionem in <placeName ref="l631">Burg[undiam]</placeName>; <lb xml:id="p1z17"/>sed hęc apud te.</s>
					<s n="13" xml:lang="la"><persName ref="p2916">Schertlius</persName> 1000 hastas a nostris emit, milites <lb xml:id="p1z18"/>suos in agro nostro congregat; molitur nescio quid.</s>
					<s n="14" xml:lang="la">Petiit a senatu <lb xml:id="p1z19"/>nostro, ut <persName ref="p8417">Musculus</persName> et <persName ref="p18113">Mecardus</persName> ei darentur, quorum ministerio <lb xml:id="p1z20"/>uteretur inter suos milites.</s>
					<s n="15" xml:lang="la"><persName ref="p8417">Musculus</persName> est negatus; <persName>Mecardo</persName>, <lb xml:id="p1z21"/>quoniam nihil ad nos pertinet, data est cum illo proficiscendi potestas; <lb xml:id="p1z22"/>is modo accingitur itineri.</s>
					<s n="16" xml:lang="la">Haec habui modo.</s>
					<s n="17" xml:lang="la">Miror te quid <lb xml:id="p1z23"/>impediat, quod tanto tempore nihil scribis.</s>
					<s n="18" xml:lang="la" ana="salute">Vale cum tuis <lb xml:id="p1z24"/>omnibus, quos meo meorumque tum etiam <persName ref="p8417">Musculorum</persName> nomine salutabis.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z25"/>15. martii 1552.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z26"/>Tuus <persName ref="p8018">Ioannes Ha<pb/><lb xml:id="p2z1"/>llerus</persName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Clarissimo viro d. <persName ref="p495">Heinrych<lb xml:id="p2z2"/>o Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesię fidelissimo <lb xml:id="p2z4"/>pastori, domino et compatri <lb xml:id="p2z5"/>suo colendissimo.</s>
				</p>
				<p>
					<s n="22" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zürich</placeName>.</s>
					<s n="23" xml:lang="de">M. <lb xml:id="p2z7"/><persName ref="p495">Heinrych Bull<lb xml:id="p2z8"/>inger</persName>en.</s>
				</p>
			</div>
		</body>
	</text>
