	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Cur ne nunc quidem faciam, quod iam pridem <lb xml:id="p1z2"/>factum oportuit, mi pater, utinam tam idoneam <lb xml:id="p1z3"/>caussam non haberem.</s>
					<s n="3" xml:lang="la">Sed laus deo, qui <lb xml:id="p1z4"/>suos ita erudire solet, non perdere.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Miror <lb xml:id="p1z5"/>me nihil adhuc prorsus intellexisse de quatuor <lb xml:id="p1z6"/>exemplaribus bibliorum, quae iam pridem misi <lb xml:id="p1z7"/>ad d. <persName ref="p7228">Zvinglium</persName>, ut pollicitus eram.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Habes <lb xml:id="p1z8"/>reliquam partem ultimae responsionis d. <persName ref="p540">Calvini</persName>, <lb xml:id="p1z9"/>hominis nimirum digni vel propter s[anctum] laborem, <lb xml:id="p1z10"/>quem vicini magis quam ipsum Satanam perditum <lb xml:id="p1z11"/>cum tot exulum chiliadibus cupiant.</s>
					<s n="6" xml:lang="la">Nequeo plura <lb xml:id="p1z12"/>prae tristitia et morbo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Commendo tibi et meam et uxoris <lb xml:id="p1z13"/>salutem.</s>
					<s n="8" xml:lang="la">Haec aegre mea manu.</s>
					<s n="9" xml:lang="la">18a augusti.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Tuus <persName ref="p8033">Beza</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Caeteros fratres et symmy<lb xml:id="p1z14"/>stas una comprehendo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio Christi servo <lb xml:id="p2z2"/>d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>patri mihi in primis <lb xml:id="p2z4"/>observando.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
