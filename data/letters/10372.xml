			<zone xml:id="p2z3-0" points="1278,1300 1511,1314 1586,1287 1641,1314 1690,1309 1692,1226 1667,1216 1577,1255 1447,1233 1424,1255 1403,1243 1331,1270 1278,1265">1287,1290 1312,1289 1337,1287 1363,1285 1388,1284 1413,1284 1439,1284 1464,1284 1490,1284 1515,1284 1540,1282 1566,1281 1591,1281 1616,1280 1642,1278 1667,1279 1693,1281</zone>
