	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Hodie demum obtulit se mihi filius hic <lb xml:id="p1z2"/>tuus postulans, pararem, si quid ad te literarum <lb xml:id="p1z3"/>dare vellem, ita ut nihil potuerim in ipsum <lb xml:id="p1z4"/>beneficii conferre vel propter te.</s>
					<s n="3" xml:lang="la">Quamquam heri demum <lb xml:id="p1z5"/>ad vesperam redii ex peregrinatione, quam <lb xml:id="p1z6"/>animi et aliarum rerum gratia comite <persName ref="p8011">Gvalt<lb xml:id="p1z7"/>hero</persName> per agrum <placeName ref="l41">Bernensem</placeName> susceperam, ita ut <lb xml:id="p1z8"/>non potuerit ad me commodius pervenire.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Caeterum non contemnis bonam animi propensionem, <lb xml:id="p1z10"/>quando opus bonum iustis causis impeditur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Ni<lb xml:id="p1z11"/>hil autem habeo, quod scribam, nolui tamen occasionem <lb xml:id="p1z12"/>negligere, praesertim cum hic tabellio offerretur <lb xml:id="p1z13"/>longe certissimus.</s>
					<s n="6" xml:lang="la">Ego tuas magis expecto, <lb xml:id="p1z14"/>quibus mihi significes urbis <placeName ref="l491">Argentoratensis</placeName> <lb xml:id="p1z15"/>statum et instituta; varia enim hic iactantur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/><placeName ref="l257">Constantia</placeName> et <placeName ref="l291">Lindaugia</placeName> perstant adhuc; <lb xml:id="p1z17"/>quid porro futurum sit, novit dominus, quem <lb xml:id="p1z18"/>oramus, ut eis adsit.</s>
					<s n="8" xml:lang="la">Non possunt illa urbes <lb xml:id="p1z19"/>citra magnum incommodum <placeName ref="l862">Helvetiae</placeName> occupari <lb xml:id="p1z20"/>a Caesare; sed surdo narratur fabula, si quis <lb xml:id="p1z21"/>videlicet <placeName ref="l862">Helvetiis</placeName> aliquid occinat.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z22"/>Certum est <persName ref="p18250">ducem Mauritium</persName>, miserum alioqui <lb xml:id="p1z23"/>hominem, convocasse <placeName ref="l1863">Fribergam</placeName> omnes no<lb xml:id="p1z24"/>biles et plebeios ex <placeName ref="l749">Saxonia</placeName> consultatum super <lb xml:id="p1z25"/>Interim, hocne accipere velint proiecta <lb xml:id="p1z26"/>hactenus usurpata religione, at illos una<lb xml:id="p1z27"/>nimes respondisse malle sanguinem suum profun<lb xml:id="p1z28"/>dere quam a recepta deficere religione.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z29"/>Ita nihil effecit Caesar cum suo Interim in <lb xml:id="p1z30"/><placeName ref="l749">Saxonia</placeName>.</s>
					<s n="11" xml:lang="la"><persName ref="p19065">Dux Saxoniae</persName> captus constantissime <lb xml:id="p1z31"/>negat Interim; <lb xml:id="p1z32"/>dux <placeName ref="l743">Pomeraniae</placeName>, princeps <lb xml:id="p1z33"/><placeName ref="l2562">Prussiae</placeName>, urbes <placeName ref="l749">Saxonicae</placeName> et maritime una <lb xml:id="p1z34"/>cum <persName ref="p3671">rege Daniae</persName> pertinacissime reiiciunt Caesaris <lb xml:id="p1z35"/>Interim.</s>
					<s n="12" xml:lang="la">Id quod mones propter famam sparsam, <lb xml:id="p1z36"/>quae asseveravit omnes illos defecisse.</s>
					<s n="13" xml:lang="la">Oremus <lb xml:id="p1z37"/>dominum, ut suis adsit aeternum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l587">Tigu<lb xml:id="p1z38"/>ri</placeName> 3. augusti <lb xml:id="p1z39"/>anno 1548.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><persName ref="p495">H<lb xml:id="p1z40"/>(einr<lb xml:id="p1z41"/>ychus) B(ullingerus)</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro D. <persName ref="p8418">Os<lb xml:id="p2z2"/>valdo Myconio</persName>, fratri <lb xml:id="p2z3"/>charissimo suo.</s>
					<s n="18" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
