				<p>
					<lb xml:id="p1z1"/>Utinam verum esset, quod ille vasso hanc praeterions et
					<lb xml:id="p1z2"/>a Vireconitibus ad Bipontinum missus nobis de Condensii
					<lb xml:id="p1z3"/>victore et superstite sic deierabat, ut nullum unquam
					<lb xml:id="p1z4"/>viderim artis mentiendi peritiorem? Fassus est autem
					<lb xml:id="p1z5"/>persemet tandem imperatum sibi ab illis fuisse
					<lb xml:id="p1z6"/>ut ista spargeret, ne constrario nnitio turbarentur
					<lb xml:id="p1z7"/>equitum Germanium animi; sed ipsi vicecomites
					<lb xml:id="p1z8"/>nella cratione se patiuntur a suis provinciis
					<lb xml:id="p1z9"/>abdus, causam huic malo mume dicabili praesuerunt
					<lb xml:id="p1z10"/>cuius non dubito, quin iustas poenas ante istius belli
					<lb xml:id="p1z11"/>exitum persolvant. Optimus igitur et
					<lb xml:id="p1z12"/>fatissimus ille princeps, quod mihi Muceto disceden
					<lb xml:id="p1z13"/>sua scripsit, sese videlicet eo animo proficisi
					<lb xml:id="p1z14"/>ad istud bellum, quo ultima necessitas ipsum
					<lb xml:id="p1z15"/>doci
					<lb xml:id="p1z16"/>abriperet, ut semetipsum inctinam Christo
					<lb xml:id="p1z17"/>offerret, re ipsa nunc praestitit, fortissime, donec
					<lb xml:id="p1z18"/>decertans et tandem, quum iam captus et
					<lb xml:id="p1z19"/>examnatus esset a scelerato latrone, cui Argentzo
					<lb xml:id="p1z20"/>nomen est quem ipsemet princeps in deditione
					<lb xml:id="p1z21"/>Augelissensi a isevaratu indignissime
					<lb xml:id="p1z22"/>interemptus. Mortuum esse ex regnae
					<lb xml:id="p1z23"/>ipsius manu
					<lb xml:id="p1z24"/>ipsius Navanenae literis ad me i scriptis, quas
					<lb xml:id="p1z25"/>Latine compissis ad te mitto, cognosces, mortis
					<lb xml:id="p1z26"/>apse tabellario intellexi. Quid postea
					<lb xml:id="p1z27"/>sit onseitin nostro exercitu, eaedem litera
					<lb xml:id="p1z28"/>tibi significabunt. Adiiciebat tabellarius habere
					<lb xml:id="p1z29"/>nostrumad octodecim peditum bomubardariorum nulli
					<lb xml:id="p1z30"/>pertaliquenot munitas urbes collocata; equitum autem
					<lb xml:id="p1z31"/>ad sex millia, qui non procul ab hoste castra
					<lb xml:id="p1z32"/>semper habuerint, nec dubitare se quin iam
					<lb xml:id="p1z33"/>coniunctae copiae progredi coeperint. Bipontinus
					<lb xml:id="p1z34"/>in ipsis hostium oculis Dratonem praetergressus
					<lb xml:id="p1z35"/>tertia huius mensis Augustodunum, quod veluti
					<lb xml:id="p1z36"/>centrum est Burgundici ducatus transiit, Vezelios
					<lb xml:id="p1z37"/>patriam meam versus quae a nostrorum praesidio
					<lb xml:id="p1z38"/>sue difficultate
					<lb xml:id="p1z39"/>tenetur inde procul dubio  ligerim progressurum
					<lb xml:id="p1z40"/>a qua procul agesse iam non potest. Fostu
					<lb xml:id="p1z41"/>1561. ilui.
					<pb/>
					<lb xml:id="p2z1"/>autem ropiae non tantum plivisse feruntur, nemerso quide
					<lb xml:id="p2z2"/>Inquadumium versus, Aunalio vero secundum Ararii
					<lb xml:id="p2z3"/>progresso, verum etiam magna ex parte ob
					<lb xml:id="p2z4"/>pestis contagionem dilapsae, rex una cum
					<lb xml:id="p2z5"/>adhuc valetudinaria et cu
					<lb xml:id="p2z6"/>cardinali vel iam est parisiis vel inde n
					<lb xml:id="p2z7"/>procul abest. Itali a ponetifice summissi, nempe
					<lb xml:id="p2z8"/>quatuor peditum millia et equites mille, iam
					<lb xml:id="p2z9"/>dicuntur adventare, quae res nos cogit.
					<lb xml:id="p2z10"/>excubras regere multo etiam quam antea
					<lb xml:id="p2z11"/>diligentius. Eebres  hic incipiunt
					<lb xml:id="p2z12"/>regnare et multos bonos mos nobis eripiunt.
					<lb xml:id="p2z13"/>quamvis absque contagione. Sic nobis nudiusquantu
					<lb xml:id="p2z14"/>Albrechtus noster.
					<lb xml:id="p2z15"/>ereptus est Georgenm.
					<lb xml:id="p2z16"/>iacturam fecerunt
					<lb xml:id="p2z17"/>nogas
					<lb xml:id="p2z18"/>in quo hominem
					<lb xml:id="p2z19"/>Gallicae ecclesiae; Feri enim profecto rara
					<lb xml:id="p2z20"/>in terris, hmo videlicet simul et
					<lb xml:id="p2z21"/>diveset vere pius, quod et tota vita
					<lb xml:id="p2z22"/>dominus
					<lb xml:id="p2z23"/>vlio
					<lb xml:id="p2z24"/>etiam ipsa monte declaratio.
					<lb xml:id="p2z25"/>ut et ipsi nostro tempore et similiter
					<lb xml:id="p2z26"/>obdormiamus, et sic vigilemus interea, ut
					<lb xml:id="p2z27"/>dormientes non deprehendamur. Bene vale.
					<lb xml:id="p2z28"/>pater, cum caeteris fueribus et collegis
					<lb xml:id="p2z29"/>quos velim, ex me totoque ingerare cae tu
					<lb xml:id="p2z30"/>salutari. D. Iesus vos semernestrissime
					<lb xml:id="p2z31"/>sanctis laboribus mmagis  mmages beredicat.
					<lb xml:id="p2z32"/>Genevae 12. maii  sibgei
					<lb xml:id="p2z33"/>pmpisa.
