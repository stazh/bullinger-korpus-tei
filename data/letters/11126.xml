	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus et pacata conscientia per Christum Iesum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Pridie quam haec scriberem, doctissime <persName ref="p495">Bullingere</persName>, senatus <lb xml:id="p1z3"/>populusque <placeName ref="l41">Bernensis</placeName> propter aucti et immutati catechismi <lb xml:id="p1z4"/>aeditionem coactus est<note xml:id="fn1" type="footnote" n="1">Zu den Verhandlungen des Großen und Kleinen Rates über den Katechismus vgl. <persName ref="p2810">Ritters</persName> Bericht vom Vortag, oben <ref target="file11124">Nr. 1081</ref>, 79-83; <hi>Straßer</hi> 148.</note>.</s>
					<s n="3" xml:lang="la">In quo cum et communes vestrae <lb xml:id="p1z5"/>literae ad nos communes huius ecclesiae ministros<note xml:id="fn2" type="footnote" n="2">Oben <ref target="file11116">Nr. 1073</ref>.</note> <lb xml:id="p1z6"/>diligentissime a <persName ref="p4610">Cyrone</persName>, huius urbis a secretis<note xml:id="fn3" type="footnote" n="3">Stadtschreiber <persName ref="p4610">Peter Cyro</persName>.</note>, recitat<lb xml:id="p1z7"/>ae essent, diu et multum perpensae, tandem sic uterque <lb xml:id="p1z8"/>senatus decrevit: Praedictum catechismum omnino publicandum <lb xml:id="p1z9"/>ac typis statim excudendum.</s>
					<s n="4" xml:lang="la">Quod si qui autem<note xml:id="fnb" type="footnote" n="b">autem <hi>über der Zeile nachgetragen.</hi></note> e<lb xml:id="p1z10"/>x verbi ministris <foreign xml:lang="el">οὕτως κατηχεῖν τοὺς κατηχουμένο<lb xml:id="p1z11"/>υς οὐ θέλωσι</foreign>, illis iam copiam discedendi amicam esse factam.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z12"/>Quod decretum ubi praetor <persName ref="p2278">Vadivillius</persName><note xml:id="fn4" type="footnote" n="4">Schultheiß <persName ref="p2278">Hans Jakob von Wattenwyl</persName>.</note> eodem die sub ve<lb xml:id="p1z13"/>speram ecclesiastis in templum convocatis enarrasset, <lb xml:id="p1z14"/>duo ex eis<note xml:id="fn5" type="footnote" n="5"><persName ref="p5837">Sebastian Meyer</persName> und <persName ref="p8401">Peter Kunz</persName>.</note> illud obviis amplexi sunt manibus; alii <lb xml:id="p1z15"/>vero<note xml:id="fn6" type="footnote" n="6"><persName ref="p8412">Kaspar Megander</persName> und <persName ref="p2810">Erasmus Ritter</persName>.</note> (quos facile agnoscis) petito deliberandi cum <lb xml:id="p1z16"/>doctis spacio polliciti sunt se brevi daturos senatui <lb xml:id="p1z17"/>responsum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Unde, mi <persName ref="p495">Bullingere</persName>, facile deprehendis <lb xml:id="p1z18"/>nostram ecclesiam a vestra semiavulsam et, ni in tempore <lb xml:id="p1z19"/>succuratur, penitus avellendam.</s>
					<s n="7" xml:lang="la">Certe, quod ad <persName ref="p8412">Megandrum</persName> <lb xml:id="p1z20"/>et <persName ref="p2810">Erasmum</persName> nostrum pertinet, et hactenus et <lb xml:id="p1z21"/>nunc rerum suarum sategerunt uterque; sed nescio quo fato <lb xml:id="p1z23"/>et quibus machinis uterque plaerisque <foreign xml:lang="el">διακοσίοις</foreign><note xml:id="fn7" type="footnote" n="7">Angehörige des Rates der Zweihundert.</note> adeo exosus <lb xml:id="p1z24"/>s<lb xml:id="p1z25"/>it factus, ut cum clarissima etiam veritate explodantur <lb xml:id="p1z26"/>omniaque non veritatis retinendae, sed contentionis <lb xml:id="p1z27"/>studio facere dicantur.</s>
					<s n="8" xml:lang="la">Proinde tibi cum tuis symmyst<lb xml:id="p1z28"/>is dispiciendum esse putarim,<pb type="edition" next="340"/> quonam remedio tantae <lb xml:id="p1z29"/>lui medendum sit.</s>
					<s n="9" xml:lang="la">Mihi profecto dubium non est, quin, si ex <lb xml:id="p1z30"/>vobis et <placeName ref="l473">Sangallensibus</placeName> aliqui legati huc venirent <lb xml:id="p1z31"/>vestramque sententiam et controversiam, quae etiamnum <lb xml:id="p1z32"/>in eucharistiae negotio est, exponeretis, vestram respicien<lb xml:id="p1z33"/>do aut<lb xml:id="p1z34"/>horitatem nihil privatim novaturi essent <placeName ref="l41">Bernenses</placeName><note xml:id="fnc" type="footnote" n="c">Bernenses <hi>am Rande nachgetragen.</hi></note>, do<lb xml:id="p1z35"/>nec commune a <persName ref="p1974">Luthero</persName> super concordia absolvenda r<lb xml:id="p1z36"/>esponsum acceperimus.</s>
					<s n="10" xml:lang="la">Haec mea cum fratribus aliis sententia est.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z37"/>Interim tamen nihil nec tibi nec aliis praescriptum <lb xml:id="p1z38"/>volo; scio enim vos (quae vestra tum eruditio tum <lb xml:id="p1z39"/>prudentia est) aliquid melius invenire posse.</s>
					<s n="12" xml:lang="la">Quidqu<lb xml:id="p1z40"/>id autem excogitaveritis et provideritis, rogo, oro, <lb xml:id="p1z41"/>obsecro et per christianam charitatem obtestor, ut quam <lb xml:id="p1z42"/>ocyssime periclitanti ecclesiae nostrae plus quam credi possit, <lb xml:id="p1z44"/>suppetias feratis.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Pluribus hac de re tecum agerem, <lb xml:id="p1z45"/>ni scirem super eadem cum a <persName ref="p8412">Megandro</persName> tum <persName ref="p2810">Erasmo</persName> <lb xml:id="p1z46"/>copiosius scribi<note xml:id="fn8" type="footnote" n="8">Siehe oben <ref target="file11124">Nr. 1081</ref>f.</note>.</s>
					<s n="14" xml:lang="la">Haec autem<note xml:id="fnd" type="footnote" n="d">autem <hi>über der Zeile nachgetragen.</hi></note> qualiacunque <persName ref="p8171">Theodoro</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p8171">Theodor Bibliander</persName>.</note> nostro communi<lb xml:id="p1z47"/>ces velim.</s>
					<s n="15" xml:lang="la">Cui et hoc dicas, me per <persName ref="p5319">Huiufium</persName> tornatorem<note xml:id="fn10" type="footnote" n="10"><persName ref="p2810">Ritter</persName> bezeichnet <persName ref="p5319">Huiuff</persName> als Krämer; s. oben <ref target="file11124">Nr. 1081</ref>, 17.</note> <lb xml:id="p1z48"/>literas<note xml:id="fn11" type="footnote" n="11">Nicht erhalten.</note> ad ipsum dedisse, quibus non<note xml:id="fne" type="footnote" n="e"><hi>vor</hi> non <hi>gestrichenes</hi> et.</note> solum ipsius scripta <lb xml:id="p1z49"/>ad me transmissa<note xml:id="fn12" type="footnote" n="12">Vgl. oben <ref target="file11117">Nr. 1074</ref>, 140f.</note>, verumetiam catechismum a <persName ref="p5565">Capitone</persName> <lb xml:id="p1z50"/>et <persName ref="p467">Bucero</persName> emendatum et auctum adiunxi.</s>
					<s n="16" xml:lang="la">Quae omnia ei <lb xml:id="p1z51"/>nondum reddita fuisse, dum <persName ref="p5124">Hagerus</persName><note xml:id="fn13" type="footnote" n="13"><persName ref="p5124">Hans Hager</persName>.</note> ad nos proficiscebatur, <lb xml:id="p1z52"/>et tuum et illius silentium arguit; scripseram enim<pb type="scan" next="||458"/> a v. <pb/><lb xml:id="p2z1"/><persName ref="p8171">Bibliandro</persName>, ut correctum catechismum tecum conferret.</s>
					<s n="17" xml:lang="la" ana="salute">De quibus omni<lb xml:id="p2z2"/>bus per <persName ref="p8171">Theodorum</persName> certior fieri cuperem, quem et una cum <foreign xml:lang="el">συνεργοῖς σου</foreign> plurimum <lb xml:id="p2z3"/>salvere iubeto.</s>
					<s n="18" xml:lang="la">Et facite simul omnes, praecipue autem tu, <lb xml:id="p2z4"/>mi patrone, ut <lb xml:id="p2z5"/><persName ref="p8428">Rhellicano</persName> <foreign xml:lang="el">ἤδη μὲν πάλαι ἀποσυναγώγῳ γεγονότι</foreign><note xml:id="fn14" type="footnote" n="14">Vgl. <cit type="bible"><ref>Joh 16, 2</ref></cit>.</note>, statim <lb xml:id="p2z6"/>vero penitus relegando, de provincia aliqua apud vos prospiciatis<lb xml:id="p2z7"/>, si modo aliquis mei apud vos usus esse potest.</s>
					<s n="19" xml:lang="la">Quod si nihil sp<lb xml:id="p2z8"/>ei isthic mihi foret, velim id quoque mihi notum fieri, <lb xml:id="p2z9"/>quo<note xml:id="fnf" type="footnote" n="f"><hi>vor</hi> quo <hi>gestrichenes</hi> cert.</note> <lb xml:id="p2z10"/>alibi fortassis mihi prospicere queam, imo dominum rogare possem, <lb xml:id="p2z11"/>ut, quemadmodum me <lb xml:id="p2z12"/>huc per <persName ref="p4091">Zvinglium</persName>, felicis recordationis <lb xml:id="p2z13"/>v<lb xml:id="p2z14"/>irum, l[ega]vit<note xml:id="fng" type="footnote" n="g"><hi>Rand beschädigt.</hi></note>, ita seu per te seu per alios alio leger.</s>
					<s n="20" xml:lang="la">Nihil nanque m[ihi]<note xml:id="fnh" type="footnote" n="h"><hi>Rand beschädigt.</hi></note> certius est, qu<lb xml:id="p2z15"/>am quod rebus se ad hunc modum heic habentibus et permanentibus brevi<note xml:id="fni" type="footnote" n="i"><hi>vor</hi> brevi <hi>gestrichenes</hi> quam quod.</note> propter posthabitum Buceranismum ab offitio movendus sim.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p2z16"/>Ex <placeName ref="l41">Berna</placeName> supra modum perturbata, 22. decembris anno 1537.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><persName ref="p8428">Ioan. Rhellicanus</persName><lb xml:id="p2z17"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse darunter:]</note>
					<s n="24" xml:lang="la">Vigilantissimo christiani gregis apud <placeName ref="l587">Tigurinos</placeName> pastori, d. <persName ref="p495">Heinrycho Bul<lb xml:id="p2z18"/>lingero</persName>, amico <lb xml:id="p2z19"/>et patrono s[u]o observan[dis]simo<note xml:id="fnk" type="footnote" n="k"><hi>Text beim Öffnen des Siegels beschädigt.</hi></note>.</s>
				</p>
