	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Gratias ago servatori nostro omnium; qui nostri ecclesiar<lb xml:id="p1z2"/>umque nostrarum misertus te diutius nobis fruen<lb xml:id="p1z3"/>dum concessit.</s>
					<s n="3" xml:lang="la">Confirmet is, quod coepit, in annos <lb xml:id="p1z4"/>multos!</s>
					<s n="4" xml:lang="la">Sane valde gaudent in hoc omnes pii, qui <lb xml:id="p1z5"/>te propter dominum diligunt et votis suis pro tua salute interpellant.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/><persName ref="p1039">Evandri</persName> apud <placeName ref="l1390">Brugenses</placeName> ob<lb xml:id="p1z7"/>itum a<lb xml:id="p1z8"/>udisti nimirum.</s>
					<s n="6" xml:lang="la">Oro ergo, ut, quantum ope tua <lb xml:id="p1z9"/>possis, pro <persName>Clausero</persName> illis dando labores apud dominos <lb xml:id="p1z10"/><placeName ref="l587">Tigurinos</placeName>; etenim apud <placeName ref="l1390">Brugenses</placeName> nulla mihi <lb xml:id="p1z11"/>videtur restare difficultas, siquidem commendavimus <lb xml:id="p1z12"/>illum eis, ut non dubitem, quin brevi illum <lb xml:id="p1z13"/>sint vocaturi, modo vos ipsum illis concedatis.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Conditio vix alia obtingere potuisset eius magis <lb xml:id="p1z15"/>conveniens genio et ingenio.</s>
					<s n="8" xml:lang="la">Sunt et hodie <lb xml:id="p1z16"/>hic nobiscum <placeName ref="l1390">Brugensium</placeName> praecipui, vulpecula scultetus, <lb xml:id="p1z17"/>archigrammatęus et alii, qui nobis certam vocationis eius sp<lb xml:id="p1z18"/>em faciunt; penes ipsos enim eligendi l<lb xml:id="p1z19"/>u<lb xml:id="p1z20"/>dimagistrum est potestas; nostri praeter confirmationem <lb xml:id="p1z21"/>nihil habent.</s>
					<s n="9" xml:lang="la">Rogo ergo, ne hic vel illi vel scholę <lb xml:id="p1z22"/>et ecclesię nostrę desis; nescio enim, ita me deus amet, <lb xml:id="p1z23"/>quis alius huic scholę commodius praefici possit; nos <lb xml:id="p1z24"/>certe nullum habemus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/>Quod res novas <lb xml:id="p1z26"/>attinet, nihil habemus, nisi quod <persName ref="p2916">Schertlius</persName> nu<lb xml:id="p1z27"/>diustertius huc venit hodie, ut puto, discessurus.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z28"/>Coenavi heri apud illum, sed nihil certi ex ipso <lb xml:id="p1z29"/>elicere potui.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Puto, quod sub ver hoc novum <lb xml:id="p1z30"/>corrasurus sit militem; nullam enim dicit se <lb xml:id="p1z31"/>adhuc odorari pacem.</s>
					<s n="13" xml:lang="la"><placeName ref="l18">Augustę</placeName> ministri tan<lb xml:id="p1z32"/>tumnon inter se conflictantur; tres enim ex <placeName ref="l749">Saxonia</placeName> vocati <lb xml:id="p1z33"/>ministri nescio quibus novis ceremoniis ecclesiam <lb xml:id="p1z34"/>gravare conantur, quibus obsistunt alii veterem formam retinere <lb xml:id="p1z35"/>cupientes, et magistratus Caesareanus illos inter se committat <lb xml:id="p1z36"/>frigidamque suffundit in odium religionis.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Alias nihil <lb xml:id="p1z37"/>nunc habemus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Ecclesia nostra satis nunc est pacata; dominus <lb xml:id="p1z38"/>confirmet nos hac in pace!</s>
					<s n="16" xml:lang="la">Magistratus noster nescio quid <lb xml:id="p1z39"/>monstri alat; scio quędam, quę cuperem tibi communicata; sed <lb xml:id="p1z40"/>non est tutum per literas illa agere.</s>
					<s n="17" xml:lang="la">Ora dominum pro nobis, <lb xml:id="p1z41"/>ne inducat nos in tentationem.</s>
					<s n="18" xml:lang="la" ana="farewell">Vale cum tuis <lb xml:id="p1z42"/>omnibus.</s>
					<s n="19" xml:lang="la" ana="salute">D. <persName ref="p8012">quęstor Hallerus</persName> te vicissim salutat et <lb xml:id="p1z43"/>pro tuo libello magnas agit gratias.</s>
					<s n="20" xml:lang="la">Rogo, ut, si illi <lb xml:id="p1z44"/>aliquando scripseris, <persName ref="p2919">Schlatterum</persName> ei commendes, est enim <lb xml:id="p1z45"/>vicinus illi, ut propter te etiam maiore illum complectatur <lb xml:id="p1z46"/>benevolentia.</s>
					<s n="21" xml:lang="la" ana="salute"><persName ref="p8417">Musculus</persName> quoque, <persName ref="p2919">Schlatterus</persName> et alii resalutant; <lb xml:id="p1z47"/>saluta ex me meisque tuam totam domum.</s>
					<s n="22" xml:lang="la"><persName ref="p8011">Gvaltherum<lb xml:id="p1z48"/>que</persName> quoque et <persName ref="p1214">Frisium</persName>, quos usque expecto.</s>
					<s n="23" xml:lang="la"><placeName ref="l41">Bernę</placeName> <lb xml:id="p1z49"/>6. februarii 1553.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z50"/>T[uus] <persName ref="p8018">Ioan[nes] Hallerus</persName>.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro fide<lb xml:id="p2z2"/>lissimoque Christi et <lb xml:id="p2z3"/>ecclesię ministro d. <persName ref="p495">Hein<lb xml:id="p2z4"/>rycho Bullingero</persName>, <lb xml:id="p2z5"/><placeName ref="l587">Tigurinę</placeName> ecclesię pastori <lb xml:id="p2z6"/>vigilantissimo, charissimo <lb xml:id="p2z7"/>suo domino et <lb xml:id="p2z8"/>compatri.</s>
				</p>
