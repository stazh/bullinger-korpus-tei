	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Am 18. August 1539 beschloß <placeName ref="l320" cert="high">Memmingen</placeName>, den Lehrkörper der Lateinschule auf drei Lehrer zu erweitern. Bürgermeister <persName ref="p1257" cert="high">Balthasar Funk</persName> wurde nach <placeName ref="l491" cert="high">Straßburg</placeName> entsandt, um <persName ref="p5469" cert="high">Hans Kleber</persName> als Schulmeister zurückzuholen. Funks Besuch in <placeName ref="l28" cert="high">Basel</placeName> und <placeName ref="l587" cert="high">Zürich</placeName>; wo er einen Provisor (Hilfslehrer) anzuwerben versuchte, dürfte im selben Zusammenhang erfolgt sein. Vgl. Emil <hi>Reichenhart,</hi> Die lateinische Schule zu <placeName ref="l320" cert="high">Memmingen</placeName> im Reformationszeitalter, in: Neue Jahrbücher für Philologie und Pädagogik, Bd. 122 (= Abt. 2, Jg. 26), 1880, S. 278.</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Is, qui has ad te perfert, consul <placeName ref="l320">Memmingensis</placeName><note xml:id="fn2" type="footnote" n="2"><persName ref="p1257">Balthasar Funk</persName>, s. oben Anm. 1.</note>, vir optimus, quaerit scolę, <lb xml:id="p1z2"/>quam diligentius paulo adornant, <foreign xml:lang="el">ὑποδιδάσκαλον</foreign>.</s>
					<s n="3" xml:lang="la">Indicabimus <persName ref="p5072">Sebasti<lb xml:id="p1z3"/>anum Goldebeckium</persName> idoneum ei provincię<note xml:id="fn3" type="footnote" n="3"><persName ref="p5072">Guldibeck</persName> war Provisor an der Großmünsterschule, eine Funktion übrigens, die auch <persName ref="p495">Bullinger</persName> gelegentlich mit "hypodidascalus" umschreibt (vgl. Zürich ZB, Ms F 37, 405v.).</note>.</s>
					<s n="4" xml:lang="la">Oro te, ut hic quoque velis <lb xml:id="p1z4"/>Christi negotium promovere.</s>
					<s n="5" xml:lang="la">Non addo plura; scio, quae est humanitas <lb xml:id="p1z5"/>et synceritas tua, frater mihi dilectissime.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale in domino.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z6"/><persName ref="p1365">Simon Gryn.</persName> tuus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z7"/>Saluta fratres omnes diligenter, <lb xml:id="p1z8"/>pręsertim <persName ref="p8171">Theodorum</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p8171">Theodor Bibliander</persName>.</note> nostrum.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z9"/>Christus<note xml:id="fnb" type="footnote" n="b"><hi>in der Vorlage</hi> <foreign xml:lang="el">ΧΡΣ</foreign>.</note> dominus nos conservet.</s>
					<s n="10" xml:lang="de">A[men]<note xml:id="fnc" type="footnote" n="c"><hi>Rand beschädigt.</hi></note>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo <lb xml:id="p2z2"/>viro d. <persName ref="p495">Henrico Bullingero,</persName> <lb xml:id="p2z3"/>amico et fratri.</s>
					<s n="12" xml:lang="de"><lb xml:id="p2z4"/>Zürc<lb xml:id="p2z5"/>h.</s>
				</p>
			</div>
