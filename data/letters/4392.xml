	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S<lb xml:id="p1z2"/>. D.</s>
					<s n="2" xml:lang="la">Subin<lb xml:id="p1z3"/>de repeto a <lb xml:id="p1z4"/>te, op<lb xml:id="p1z5"/>time frat<lb xml:id="p1z6"/>er, supplicat<lb xml:id="p1z7"/>ionem illam <persName ref="p20133">Genen<lb xml:id="p1z8"/>sium</persName> impre<lb xml:id="p1z9"/>ssa<lb xml:id="p1z10"/>m n<lb xml:id="p1z11"/>uper <lb xml:id="p1z12"/>ad te missa<lb xml:id="p1z13"/>m; sed <lb xml:id="p1z14"/>t<lb xml:id="p1z15"/>u <lb xml:id="p1z16"/>n<lb xml:id="p1z17"/>ec remitti<lb xml:id="p1z18"/>s nec respo<lb xml:id="p1z19"/>ndes.</s>
					<s n="3" xml:lang="la">Ego vero illa carere non possum, nec aliud hic e<lb xml:id="p1z20"/>xemplum est; oro itaque, ut matures.</s>
					<s n="4" xml:lang="la"><placeName ref="l41">Bernam</placeName> misissem hisce diebus; <lb xml:id="p1z21"/>sed cum non haberem, mittere non potui.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Iuvenis hic pro<lb xml:id="p1z22"/>ficiscitur <placeName ref="l18">Augustam Vindelicorum</placeName> recta rediturus ad nos; <lb xml:id="p1z23"/>si ei tradere volueris literas vel ad d. <persName ref="p2899">Matthiam Schenckium</persName> <lb xml:id="p1z24"/>vel ad alios amicos tuos, probe curabit, ac mandavi illi, ut ad <lb xml:id="p1z25"/>te iret, solius huius rei causa, ut hac in re inservirem tibi.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z26"/>Pacem inter <placeName ref="l2524">Scotos</placeName>, <placeName ref="l830">Anglos</placeName> et <placeName ref="l832">Gallos</placeName> confectam scribunt <lb xml:id="p1z27"/>amici ex <placeName ref="l830">Anglia</placeName> <placeName ref="l296">Londini</placeName> literis datis 22. iulii.</s>
					<s n="7" xml:lang="la"><placeName ref="l2524">Scotorum</placeName> <lb xml:id="p1z28"/>res bene habent; nam obtinuerunt, quod voluerunt; <placeName ref="l832">Galli</placeName> fracti <lb xml:id="p1z29"/>sunt.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Dicuntur in <placeName ref="l832">Gallia</placeName> novi motus oriri.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Dominus oppressis <lb xml:id="p1z30"/>hostibus suis faciat triumphare veritatem etc.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Aiunt <placeName ref="l1139">Linzii</placeName> in <lb xml:id="p1z31"/><placeName ref="l850">Austria</placeName> ab imperatore comitia celebrari, in quibus consultetur de <lb xml:id="p1z32"/>concilio et opprimendo evangelio.</s>
					<s n="11" xml:lang="la">Confluxisse illuc dicuntur <lb xml:id="p1z33"/>papae legatus <persName ref="p20236">Stanislaus Hosius</persName>, <placeName>Wariensis</placeName> episcopus, tres episcopi <lb xml:id="p1z34"/>electores, episcopus <placeName ref="l1725">Salisburgensis</placeName>, dux <placeName ref="l619">Bavariae</placeName>, legatus <lb xml:id="p1z35"/>regis <placeName ref="l832">Galliae</placeName> San-Laurentianus.</s>
					<s n="12" xml:lang="la">Tu, si quid certi habes de hisce <lb xml:id="p1z36"/>rebus, fac, sciam.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Quid vero agunt principes nostri?</s>
					<s n="14" xml:lang="la">Docti certe ipsorum <lb xml:id="p1z37"/>contra nos instaurant bellum minime necessarium; <foreign xml:lang="de">es kumpt aber die zyt, das s<lb xml:id="p1z38"/>y sähen werdent, was sy thuͦnd.</foreign></s>
					<s n="15" xml:lang="la" ana="farewell">Vale una cum familia tua, cum d. <persName ref="p2899">Matthia</persName> et bonis omnibus.</s>
					<s n="16" xml:lang="la">18. augusti anno 1560.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><persName ref="p495">Bullingerus</persName> <lb xml:id="p1z39"/>tuus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Clarissimo viro d. <persName ref="p8055">Ambrosio Blaurero</persName> nunc <placeName ref="l555">Vituduri</placeName> agenti, domino et fratri suo observandissimo et charissi<lb xml:id="p1z40"/>mo.</s>
					<s n="19" xml:lang="de"><placeName ref="l555">Wintherdur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
