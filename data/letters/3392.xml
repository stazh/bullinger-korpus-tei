	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Commendarem tuae humanitati hos duos <lb xml:id="p1z2"/>adolescentes, <persName ref="p495">Bullingere</persName> humanissime, ni cognitum habere<lb xml:id="p1z3"/>m omnes et pios et studiosos alioquin tibi commendatissimos <lb xml:id="p1z4"/>esse.</s>
					<s n="3" xml:lang="la">Hactenus <placeName ref="l491">Argentorati</placeName> haud sine profectu bonis literis <lb xml:id="p1z5"/>operam navarunt; nunc visum est dominis scholarchis, ut <lb xml:id="p1z6"/>se <placeName ref="l587">Tigurum</placeName> recipiant theologiae operam daturi.</s>
					<s n="4" xml:lang="la">Dominus <lb xml:id="p1z7"/>ipsis det in sanctis studiis spiritus sui incrementum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Nollemus <lb xml:id="p1z8"/>ipsos confusana <persName ref="p18137">Marpachii</persName> eiusque farinę hominum doctrina <lb xml:id="p1z9"/>imbui nostro edocti periculo.</s>
					<s n="6" xml:lang="la">Dextre apud vos dei gratia <lb xml:id="p1z10"/>tractantur sacra, neque periculum est quod isthic pravo aliquo <lb xml:id="p1z11"/>et contentioso dogmate inficiantur.</s>
					<s n="7" xml:lang="la">Hoc praestabitis, sat scio, <lb xml:id="p1z12"/>universi, ne adolescentiae illecebris corrupti nostram de ipsis <lb xml:id="p1z13"/>expectationem fallant.</s>
					<s n="8" xml:lang="la">Novum hoc seminat rumor a<lb xml:id="p1z14"/>pud nos, quod <placeName ref="l2524">Scoti</placeName> magnis viribus irruerint in <placeName ref="l830">Angliam</placeName> <lb xml:id="p1z15"/>oppugnarintque urbem regni a <placeName ref="l296">Londino</placeName> validissimam <lb xml:id="p1z16"/>eoque <persName>Philippum</persName> coactum ad Fanum Quintini decem milium <lb xml:id="p1z17"/>militum et in alio quodam oppido quinque milium relicto <lb xml:id="p1z18"/>praesidio in <placeName ref="l830">Angliam</placeName> iter maturare, quo suo regno in tempore occurrat.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Gal<lb xml:id="p1z19"/>lus dicitur cum 30000 militum manu versus Atrebatensem urbem<note xml:id="fn1" type="footnote" n="1">Arras.</note> <lb xml:id="p1z20"/>proficisci magna spe fretus se damnum, quod in mis<lb xml:id="p1z21"/>ero illo conflictu accepit, resarcire posse.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z22"/>Eventus est domini.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Dissipet dominus con<lb xml:id="p1z23"/>silium <persName>Achitophelis</persName> regnetque ipse solus in secula.</s>
					<s n="12" xml:lang="la">Amen.</s>
					<s n="13" xml:lang="la" ana="salute">Salutant te sym<lb xml:id="p1z24"/>mystę mei.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Salvos esse cupio <persName ref="p8171">Theodorum</persName>, <persName ref="p8111">Martyrem</persName>, <persName ref="p8011">Gvaltherum</persName>, <lb xml:id="p1z25"/>omnes.</s>
					<s n="15" xml:lang="la"><placeName ref="l441">Scaffhusii</placeName> 3. novembris anno 1557.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z26"/>Tuus ex animo <lb xml:id="p1z27"/><persName ref="p3481">Simpertus Vogt</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctrina et pietate insigni <lb xml:id="p2z2"/>viro d. <persName ref="p495">Heinrycho Bul<lb xml:id="p2z3"/>lingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>pastori vigilantissimo, <lb xml:id="p2z5"/>domino et fratri suo <lb xml:id="p2z6"/>observando.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>