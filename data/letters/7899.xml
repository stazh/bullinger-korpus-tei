	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Litteras mitto clarissimi d. <persName ref="p8075">Erasti</persName>, quas studiosi tres <lb xml:id="p1z2"/>obtulerunt, qui propediem ad vos <placeName ref="l587">Tigurum</placeName> a schol<lb xml:id="p1z3"/>archis mittentur.</s>
					<s n="2" xml:lang="la">Accidit autem mihi cum literis tuis, <lb xml:id="p1z4"/>quod tacere non decet.</s>
					<s n="3" xml:lang="la">Eiusdem formae in mensa <lb xml:id="p1z5"/>ab eodem <persName ref="p8075">Erasto</persName> ad me scripta epistola iacebat cum <lb xml:id="p1z6"/>aliorum literis.</s>
					<s n="4" xml:lang="la">Aderat matrona honestissima, quae <lb xml:id="p1z7"/>me interpellabat, cum literas d. <persName ref="p21258">Ietzleri</persName> fere perlegissem.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Inter loquendum aperiebam literas, ut credebam, quas <lb xml:id="p1z9"/>ad me dedisset d. <persName ref="p8075">Erastus</persName>.</s>
					<s n="6" xml:lang="la">At ecce, cum illis <lb xml:id="p1z10"/>imprudenter apertis primos versus obiter per<lb xml:id="p1z11"/>lustro, sentio ad me illas non spectare inspectaque <foreign xml:lang="el">ἐπιγ<lb xml:id="p1z12"/>ραφή</foreign> profecto exhorresco et tuas esse video.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Peto igitur veniam delicti; confestim enim non sine animi <lb xml:id="p1z14"/>magno dolore iterum conclusi, et crede mihi nihil <lb xml:id="p1z15"/>illorum, quae illa continent, plane cognovi.</s>
					<s n="8" xml:lang="la">Hoc ideo <lb xml:id="p1z16"/>quoque dissimulare nolui, ne suspiceris ab alio forte <lb xml:id="p1z17"/>apertam fuisse epistolam.</s>
					<s n="9" xml:lang="la">Scribit ad me d. <persName ref="p8075">Erastus</persName> <lb xml:id="p1z18"/>de victoria <persName ref="p18935">Bipontini</persName> insigni quidem et gloriosa, <lb xml:id="p1z19"/>attamen cruenta.</s>
					<s n="10" xml:lang="la">Idem confirmatur ex <placeName ref="l98">Curia <lb xml:id="p1z20"/>Rhetorum</placeName> et <placeName ref="l361">Norinberga</placeName>.</s>
					<s n="11" xml:lang="la">Metuo, ne <persName ref="p18935">Bipontinus</persName> <lb xml:id="p1z21"/>in <placeName ref="l832">Gallia</placeName> victor ecclesiae similes turbas det, quas <lb xml:id="p1z22"/><persName ref="p18233">Illyricus</persName> movit cum sociis in <placeName ref="l808">Belgio</placeName>; sed haec <lb xml:id="p1z23"/>domino commendanda sunt.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z24"/>Tuus <persName ref="p8109">Iohannes Conradus <lb xml:id="p1z25"/>Ulmerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
