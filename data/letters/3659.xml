					<lb xml:id="p1z1"/>Animo sum equidem lęto, sed corpor fatigatissimus nec non tepori
					<lb xml:id="p1z2"/>angustia valde pressus reddo literas et vitras et iubinas
					<lb xml:id="p1z3"/>scribo utrisque hoc ipso momento quar ignoscas
					<lb xml:id="p1z4"/>constat
					<lb xml:id="p1z5"/>etsi iam ex proscriptione nuper ad te missa quales, sit
					<lb xml:id="p1z6"/>isti modeatorus, qui spiem concordię nobis faciebant
					<lb xml:id="p1z7"/>quoque prgiversarii amplius non piderit se
					<lb xml:id="p1z8"/>me inscio, quor postea confessus est literas ad te nescium
					<lb xml:id="p1z9"/>quas dedit anonimas ortorogicarium vero uram dutam
					<lb xml:id="p1z10"/>partem, in qua scit hominem utcunque placare
					<lb xml:id="p1z11"/>studebat offensum graviter ab iis, quae
					<lb xml:id="p1z12"/>srcesserant, non fidas illi et cum ad vos erdierit.
					<lb xml:id="p1z13"/>quod brevi futurum spero, dicas aprerte et Christia
					<lb xml:id="p1z14"/>in re tam seria non esse ita ludendum
					<lb xml:id="p1z15"/>imo perfide agendum conatus eius omnes sunt, ut
					<lb xml:id="p1z16"/>Cacoviam ad regem mittatur, quacunque iationi
					<lb xml:id="p1z17"/>
