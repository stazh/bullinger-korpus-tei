					<lb xml:id="p1z20"/>reddet sua oppugnatione magis illustien
					<lb xml:id="p1z21"/>quia tandem corsnore et vicret apisratum
					<lb xml:id="p1z22"/>Mecardius eiusque primit omes apicipe virtebens
