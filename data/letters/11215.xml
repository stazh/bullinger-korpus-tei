	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Der Briefinhalt entspricht dem ersten Teil des Briefes von Myconius vom 9. September (s. oben <ref target="file11214">Nr. 1171</ref>, 1-11).</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Obsecro te, mi <persName ref="p495">Bullingere</persName><note xml:id="fna" type="footnote" n="a">Obsecro te, mi <persName ref="p495">Bullingere</persName> <hi>durch größere Schrift hervorgehoben.</hi></note>, ut puerum<note xml:id="fn2" type="footnote" n="2"><persName ref="p8469">Heinrich Hindermann</persName>; s. ebd.</note> ingenio praestanti, <lb xml:id="p1z2"/>quantum multorum testimonio intelligo, vestratemque, si potest ullo pacto <lb xml:id="p1z3"/>fieri, ne negligatis.</s>
					<s n="3" xml:lang="la">Adiutus hic a nostris fuit aliquamdiu; verum <lb xml:id="p1z4"/>sic nunc habet res, ut versari cum parentibus amplius commode non <lb xml:id="p1z5"/>possit, noverca<note xml:id="fn3" type="footnote" n="3">Nicht namentlich bekannt.</note> et vitrico<note xml:id="fn4" type="footnote" n="4"><persName ref="p5533">Peter Kriesi</persName>; s. ebd.</note>.</s>
					<s n="4" xml:lang="la">Dabis operam, sicubi possit iuvari; <lb xml:id="p1z6"/>est indignum, si non excolatur ingenium tam aptum.</s>
					<s n="5" xml:lang="la">Rogarunt me <lb xml:id="p1z7"/><persName ref="p164">Amerbachius</persName> et alii quidam, ut ea de re te caeterosque fratres rogarem.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Valebis in domino Christo, qui nos in sancta voluntate ipsius <lb xml:id="p1z9"/>conservet.</s>
					<s n="7" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/><persName ref="p1365">Simon Grynęus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heynricho <lb xml:id="p2z2"/>Bullingero</persName>, amico<lb xml:id="p2z3"/>.</s>
				</p>
			</div>
		</body>
	</text>
