	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Erwurdiger, wolgelertter, insunders günstiger, lieber
					<lb xml:id="p1z2"/>herr min willig dienst sind üch begegtt zimer
					<lb xml:id="p1z3"/>von aller ersten, so wünschen ich uch sampt alle
					<lb xml:id="p1z4"/>uwern und gantzer chrrstenheytt ein
					<lb xml:id="p1z5"/>guͦtt bluckhafftig frydlich und gesund Nün
					<lb xml:id="p1z6"/>mitt pitt, das unß der trüw gott gnadg
					<lb xml:id="p1z7"/>wölle vor allen besen faltschen rattschleg
					<lb xml:id="p1z8"/>und prattuken behutten und in eynigkeitt
					<lb xml:id="p1z9"/>und erkantnis sines lebenden und heykl
					<lb xml:id="p1z10"/>samen worts infuren durch Jesum Christi
					<lb xml:id="p1z11"/>unsern er loser und selligmachers am
					<lb xml:id="p1z12"/>wie es in Franckrich stande, mag ich nitt
					<lb xml:id="p1z13"/>gruntlich wüssen. aber uß disem schriben si
					<lb xml:id="p1z14"/>der Belliever uffgester mine herren
					<lb xml:id="p1z15"/>geschickt, verstan ich das die hugenotten nitt
					<lb xml:id="p1z16"/>all er schlagen und noch anmer lutten lyt. den
					<lb xml:id="p1z17"/>friden zuͦ machen dan an Reschellen, wie
					<lb xml:id="p1z18"/>zuͦvor ußgeten, wellichen brieff ich uc
					<lb xml:id="p1z19"/>nchtnachts hab obgeschriben, daruß urtheylen
					<lb xml:id="p1z20"/>üch gfalt; der eer herr hatt wol dem vogt
					<lb xml:id="p1z21"/>vogel ouch geschriben, was oder wie es stande
					<lb xml:id="p1z22"/>halt er im noch selbs, wol achten ich erhabe, es
					<lb xml:id="p1z23"/>sinen gesellen wol anzeigt, doch wyset alle
					<lb xml:id="p1z24"/>küntsch, das der gmeyn man wol friden erlyd
					<lb xml:id="p1z25"/>mocht, welliche unß der truw gott bald
					<lb xml:id="p1z26"/>geben und frome christen der schwäre burden
					<lb xml:id="p1z27"/>lade, welliche in trüwen, eott ich üch bruelche
					<lb xml:id="p1z28"/>Datum den 3. ianuarii ano 1570.
					<lb xml:id="p1z29"/>w
					<lb xml:id="p1z30"/>soachim bälen.
					<lb xml:id="p1z31"/>8. Comre.
					<lb xml:id="p1z32"/>Grutzen mir gutte herren mit wunschnugemes
					<lb xml:id="p1z33"/>Chritris etc.
					<lb xml:id="p1z34"/>guͦtten gbuckhafftgen nüwr
					<pb/>
					<lb xml:id="p2z1"/>1n iano 1570.
					<lb xml:id="p2z2"/>Em erwurdigen, wolgelertten
					<lb xml:id="p2z3"/>herren hern HeinrichenBullinger,
					<lb xml:id="p2z4"/>Oberster predicant zuͦ Zurich.
					<lb xml:id="p2z5"/>minem insunders günstigen
					<lb xml:id="p2z6"/>lieben heerren
					<lb xml:id="p2z7"/>
					<lb xml:id="p2z8"/>.
				</p>
