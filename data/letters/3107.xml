	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nihil scribo; <persName ref="p7228">Zvinglius</persName> viva erit epistola.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Iam hoc momento venio a senatu et <lb xml:id="p1z3"/>negotium tuum ursi; heri toto die expectavi; <lb xml:id="p1z4"/>sed prae multitudine negotiorum non potui <lb xml:id="p1z5"/>admitti.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Summa est: non volunt, ut hic in<lb xml:id="p1z6"/>primatur; suspicantur nescio quas turbas, praesertim <lb xml:id="p1z7"/>quod <persName ref="p1227">Froschoverus</persName> non velit suum nomen libro <lb xml:id="p1z8"/>addi.</s>
					<s n="5" xml:lang="la">Itaque remitto totum opus.</s>
					<s n="6" xml:lang="la">Nostram ut <lb xml:id="p1z9"/>operam boni consulas, rogamus; per nos enim non <lb xml:id="p1z10"/>stetit, quum/quin?</s>
					<s n="7" xml:lang="la">et hic et sub nomine urbis huius <lb xml:id="p1z11"/>aederetur.</s>
					<s n="8" xml:lang="la">De reliquis gener.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l167">Genevense</placeName> <lb xml:id="p1z12"/>negotium valde nos turbat.</s>
					<s n="10" xml:lang="la">Nunquam magis <lb xml:id="p1z13"/>in procinctu res fuit, ut ad bellum aut turbas <lb xml:id="p1z14"/>aliquas procedatur; nam exulibus <placeName ref="l167">Genevatibus</placeName> <lb xml:id="p1z15"/>concessum est invadere omnia <placeName ref="l167">Genevensium</placeName> bona, <lb xml:id="p1z16"/>quę in finibus ditionis <placeName ref="l41">Bernensis</placeName> habent, si <placeName ref="l167">Ge<lb xml:id="p1z17"/>nevenses</placeName> pergant ipsis illorum bona invadere, quę <lb xml:id="p1z18"/>ipsi adhuc habent <placeName ref="l167">Genevę</placeName>.</s>
					<s n="11" xml:lang="la">Itaque ad bellum et turbas <lb xml:id="p1z19"/>omnia spectare videntur, nisi deus avertat.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z20"/>Non licet nobis <persName ref="p540">Calvino</persName> aut aliis quicquam scribere, <lb xml:id="p1z21"/>ne rempublicam prodere videamur.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/><placeName ref="l41">Bernę</placeName> die <lb xml:id="p1z23"/>Caroli.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale et ignosce tumultuanter <lb xml:id="p1z24"/>et summa quoque cum indignatione scribenti.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><persName ref="p8018">H[allerus]</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><lb xml:id="p1z25"/>Clarissimo viro d. <persName ref="p495">Heinry<lb xml:id="p1z26"/>cho Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> ecclesiae pastori fidelissimo, <lb xml:id="p1z27"/>domino et compatri charissimo colendissimoque suo.</s>
				</p>
				<p>
					<note type="author">[Darunter von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="17" xml:lang="de"><lb xml:id="p1z28"/>Abschlag zuͦ <lb xml:id="p1z29"/>drucken 28. ianuarii 1557.</s>
				</p>
				<p>
					<note type="author">[Auf der Vorderseite ist von <persName ref="p495">Bullinger</persName> bemerkt:]</note>
					<s n="18" xml:lang="la">Si nullum la<lb xml:id="p1z30"/>titaret periculum, <placeName ref="l587">Tiguri</placeName> fuisset impressa; nam hactenus nihil huc est missum ab illis.</s>
					<s n="19" xml:lang="la">Fore periculos m libri huius impressuram <lb xml:id="p1z31"/>patet ex <persName>Gualtheri Antichristo</persName>.</s>
				</p>
				<p>
					<note>[Darunter ein Zusatz:]</note>
					<s n="20" xml:lang="la">et <lb xml:id="p1z32"/>quod <persName ref="p1227">Froschoverus</persName> singulariter voluerit imprimi absque <lb xml:id="p1z33"/>suo nomine <placeName ref="l41">Bernae</placeName> ab Apiario.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z34"/>Nullam inde oriri utilitatem nisi <lb xml:id="p1z35"/>privatam Apiarii, qui cupiat imprimi, <lb xml:id="p1z36"/>ut lucrum faci<lb xml:id="p1z38"/>at.</s>
					<s n="22" xml:lang="la"><lb xml:id="p1z39"/>Privatam utilitatem non esse praepone<lb xml:id="p1z40"/>ndam publicae adeoque exponendam <lb xml:id="p1z41"/>periculo totam rempublic<lb xml:id="p1z42"/>am.</s>
					<s n="23" xml:lang="la"><lb xml:id="p1z43"/>Praesertim cum ex bibliorum Germ... et <lb xml:id="p1z44"/>de<lb xml:id="p1z45"/>isp... colliquescat Apocalypsim <lb xml:id="p1z46"/>non recenseri inter canonicos libros, <lb xml:id="p1z47"/>cuius quidem rei author creditur <lb xml:id="p1z48"/><persName>Zvinglius</persName>, cui expositio Apocalypsis <lb xml:id="p1z49"/>haec non consentiat, dum canonicum <lb xml:id="p1z50"/>asserit, et ideo non propter huiusmodi <lb xml:id="p1z51"/>librum ullum subeundum periculum.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Hae<pb/><lb xml:id="p2z1"/>c rationes gener d. <persName ref="p7228">Zving<lb xml:id="p2z2"/>lius</persName> mihi r<lb xml:id="p2z3"/>etulit ex ore d. <lb xml:id="p2z4"/><persName ref="p8018">Halleri</persName>, cur senatus <lb xml:id="p2z5"/><placeName ref="l41">Bernensis</placeName> noluerit co<lb xml:id="p2z6"/>nsentire <lb xml:id="p2z7"/>in aedi<lb xml:id="p2z8"/>tionem <lb xml:id="p2z9"/>Apocalypsis.</s>
				</p>
			</div>
