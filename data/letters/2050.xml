	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Domine, quum/quid nobilis hac per postas transiens mihi <lb xml:id="p1z2"/>narravit sibi obviam factum esse dominum <lb xml:id="p1z3"/><persName ref="p3375">Vergerium</persName> et cum eo collocutum, ego statim cogitavi, <lb xml:id="p1z4"/>quod ergo ad te equitaret et inde ad me; cupio en<lb xml:id="p1z5"/>im illum videre et de multis cum eo colloqui, antequam <lb xml:id="p1z6"/>ducatum <placeName ref="l572">Wirttembergensem</placeName> ingrediatur.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Quod <lb xml:id="p1z7"/>maxime desidero ut intelligat.</s>
					<s n="4" xml:lang="la">Ego adeo <lb xml:id="p1z8"/><placeName ref="l922">Friburgum</placeName>, ubi sum per tres vel quatuor dies <lb xml:id="p1z9"/>commoraturus et statim rediturus.</s>
					<s n="5" xml:lang="la">Quodsi <lb xml:id="p1z10"/>forsitan non possit ad me venire, ut per s<lb xml:id="p1z11"/>uas spem fecit, scribat mihi, quo tandat <lb xml:id="p1z12"/>et qua via et ratione meas ei reddi poterunt.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Nova a me preter ultimo scripta nihil <lb xml:id="p1z14"/>expecta; arma cano et gravissima bella; <lb xml:id="p1z15"/>nam in pace et induciis nulla spes.</s>
					<s n="7" xml:lang="la"><persName ref="p18538">Caesar</persName> <lb xml:id="p1z16"/>vocat filium et parat se pro certo ad iter, ut <lb xml:id="p1z17"/>beatus ille imperium hereditarium reddat scilicet<lb xml:id="p1z18"/>.</s>
					<s n="8" xml:lang="la">Si queras, cur <persName ref="p18538">Caesar</persName> non pacem rescendat in <lb xml:id="p1z19"/><placeName ref="l822">Germania</placeName>, audi: certum est in fine novembris <lb xml:id="p1z20"/>venturum, si per principes et suam valetudinem <lb xml:id="p1z21"/>liceat.</s>
					<s n="9" xml:lang="la">Interea magnis donis, artibus, practicis tentat pro filio <lb xml:id="p1z22"/>matrimonium <placeName ref="l830">Anglicanum</placeName>; <pb/><lb xml:id="p2z1"/>resistunt fortiter magnates, sed tamen nonnulli <lb xml:id="p2z2"/>victi sunt donis, et ipsa regina non videtur <lb xml:id="p2z3"/>aliena; spero tamen deum reipublicae christianae adfuturum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z4"/>Ex <placeName ref="l822">Germania</placeName> habemus regem Romanum et filios cum <lb xml:id="p2z5"/>principibus contra <persName ref="p18538">Caesarem</persName> et istam monarchiam co<lb xml:id="p2z6"/>nsentire.</s>
					<s n="11" xml:lang="la">Sed laudo syncerum tuum de istis <lb xml:id="p2z7"/>conventibus iudicium; a quindecim annis omnibus <lb xml:id="p2z8"/>fere interfui, sed certa esse scio, que de illis <lb xml:id="p2z9"/>scribis.</s>
					<s n="12" xml:lang="la">Propterea timeo semper, ne <persName ref="p18538">Caesarum</persName> artes <lb xml:id="p2z10"/>vincant fratris bonitatem et <lb xml:id="p2z12"/>principum multorum simplicitatem et tandem <lb xml:id="p2z13"/>fiat ex re seria collusio quedam inter <lb xml:id="p2z14"/>eos in preiudicium imperii et totius reipublicae c<lb xml:id="p2z15"/>hristianae.</s>
					<s n="13" xml:lang="la">Quare lubenter haberem tuum super <lb xml:id="p2z16"/>istis iudicium, an scilicet credas fratrem <lb xml:id="p2z17"/>et principes serio agere.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale bene, vir <lb xml:id="p2z18"/>optime.</s>
					<s n="15" xml:lang="la">Ex <placeName ref="l760">Soluturo</placeName> 26a octobris festinanter.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Tuus <lb xml:id="p2z19"/>semper <persName ref="p8296">Bassafontaneus</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z20"/>Princeps <placeName ref="l875">Hispanię</placeName> instituerat filiam <lb xml:id="p2z21"/><placeName ref="l2530">Portugalię</placeName> ducere; sed audita <lb xml:id="p2z22"/>morte regis <persName ref="p8375">Anglię</persName> illa <lb xml:id="p2z23"/>statim omisit.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p3z1"/>Optimo viro et <lb xml:id="p3z2"/>amico domino <persName ref="p495">Bulingero</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l803">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
