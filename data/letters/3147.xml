	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quem mihi commendasti et tuo et <persName ref="p3099">Sulceri</persName> nomine, loquentem <lb xml:id="p1z2"/>diligenter audivi.</s>
					<s n="3" xml:lang="la">Ilico vidi regionibus nostris non aptum; <lb xml:id="p1z3"/>ne tamen suspicari posset me minus fraterne agere aut in <lb xml:id="p1z4"/>vestri graciam non omnia voluisse tentare, misi eum in loca, <lb xml:id="p1z5"/>quae pastores non habent et tamen indigent illis quaeque lo<lb xml:id="p1z6"/>quuntur <placeName ref="l822">Germanice</placeName> et <placeName>Retice</placeName>, additis meis literis, sicut sciebam <lb xml:id="p1z7"/>ipsum opus habere.</s>
					<s n="4" xml:lang="la">Ivit, concionatus est; non tamen <lb xml:id="p1z8"/>receptus est.</s>
					<s n="5" xml:lang="la">Sunt quidem loca apud nos carencia conciona<lb xml:id="p1z9"/>toribus; sed percipi non possunt nisi <placeName>Rhetice</placeName> loquentes.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Interrogare eum potes de fide ed sedulitate mea in <lb xml:id="p1z11"/>vestri graciam eciam.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ad me venerunt hoc ipso die <lb xml:id="p1z12"/>viri primates ex communitatibus circum urbem asseverantes se <lb xml:id="p1z13"/>iam quatuor diebus mane post horam sextam vidis<lb xml:id="p1z14"/>se duos soles, unum illum solitum et verum, alterum <lb xml:id="p1z15"/>illo minorem et priorem legitimum sequentem; ro<lb xml:id="p1z16"/>garunt, ut animum advorterem.</s>
					<s n="8" xml:lang="la">Ex <placeName ref="l834">Italia</placeName> redeunt <lb xml:id="p1z17"/>saepius nostratium aliqui milites; multa non loquuntur; <lb xml:id="p1z18"/>satis tamen animadvertitur milites Retos male tractari.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/>His diebus quidam centurias aliquot militum abduxisse <lb xml:id="p1z20"/>ex <placeName ref="l648">Retia</placeName> fertur in <placeName ref="l834">Italiam</placeName> loca suppleturus eorum, qui <lb xml:id="p1z21"/>illinc abierint.</s>
					<s n="10" xml:lang="la"><persName>Petere</persName> regem dicitur milia aliquot mi<lb xml:id="p1z22"/>litum in <placeName ref="l2589">Picardiam</placeName>, quae vos istic nostis.</s>
					<s n="11" xml:lang="la"><persName ref="p8009">Fabricium</persName> vidimus; <lb xml:id="p1z23"/>expectamus, quam similis sit tibi futurus.</s>
					<s n="12" xml:lang="la">Homo hic, <lb xml:id="p1z24"/>qui literas fert, multum se turbat.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale in domino Iesu, <lb xml:id="p1z25"/>vir bonis omnibus longe colendissime, et <persName>Philippum</persName> tuum redamare <lb xml:id="p1z26"/>perge.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Ex <placeName ref="l98">Curia</placeName>, die 10. Aprilis 1557.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z27"/>Tuae humanitatis totus <persName ref="p8359">Philippus Gallicius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vero magno viro D. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>bonis omnibus colen<lb xml:id="p2z4"/>dissimo.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
