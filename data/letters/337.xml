	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accipio, diem esse praescriptum <placeName ref="l587">Tigurum</placeName>, ubi de responso Immontanis pagis <lb xml:id="p1z2"/>dando Tetrapolis illa vestra sit deliberatura.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Gratissimum mihi isthoc consiliu<lb xml:id="p1z3"/>m est, et confido domini gratiam aspiraturam, ut illud tandem sanum et pium <lb xml:id="p1z4"/>et Christi cultoribus dignum futurum sit.</s>
					<s n="4" xml:lang="la">Ibi, te sancte rogo, id agere velis, <lb xml:id="p1z5"/>ne sociorum negligatur ratio neve res ita geratur, ceu seclusi divisive videamur.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Societ charitas, quos iunxit Christus et unctim etiam non uno tentationis <lb xml:id="p1z7"/>genere probavit.</s>
					<s n="6" xml:lang="la">Sedulo agere neque quicquam fidelis officii intermittere <lb xml:id="p1z8"/>tuae fuerit integritatis, de qua spectata mihi et comperta nihil mihi <lb xml:id="p1z9"/>non polliceor.</s>
					<s n="7" xml:lang="la">Mitto <persName ref="p8354">Georgii Laeti</persName> literas, quas reddi tibi sum[m]opere <lb xml:id="p1z10"/>postulavit.</s>
					<s n="8" xml:lang="la">Quid velit, intelliges; si quicquam rescripturus es, ad me <lb xml:id="p1z11"/>remittas, ut et tuas certo aliquo nuncio, et brevi quidem, recipiat.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z12"/>et, quae nostra referre putaris, pro tua in me fide significa.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l473">San<lb xml:id="p1z13"/>galli</placeName>, Nonis Novembris, celerrime, anno MDXLVIII.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p8049">Ioachimus Vadianus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrycho Bullingero</persName>, <lb xml:id="p2z3"/>suo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
