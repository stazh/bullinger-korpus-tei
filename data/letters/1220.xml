	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Expecto, mi <persName ref="p1278">Gasti</persName>, quid indicaturus <lb xml:id="p1z3"/>sis de mea Decade V.; nam in ea vel <lb xml:id="p1z4"/>aliquid te legisse confido.</s>
					<s n="3" xml:lang="la">Deinde alterum <lb xml:id="p1z5"/>ex te efflictim et maximopere peto.</s>
					<s n="4" xml:lang="la">Agit <lb xml:id="p1z6"/>apud vos <placeName ref="l28">Basileae</placeName> <persName ref="p20686">Ludovicus Vergerius</persName>, <lb xml:id="p1z7"/>d. <persName ref="p3375">Vergerii</persName> nepos.</s>
					<s n="5" xml:lang="la">De eo in haec verba scribit <lb xml:id="p1z8"/>ad me d. <persName ref="p3375">Vergerius</persName> literis datis 12. martii <lb xml:id="p1z9"/><placeName ref="l525">Vicosoprani</placeName>: "Fidum nuntium modo non <lb xml:id="p1z10"/>habeo, qui pecuniam ad meum nepotem deferat, <lb xml:id="p1z11"/>quem scio interim egere.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quamobrem <lb xml:id="p1z12"/>te vehementer rogatum velim, ut alicui amico <lb xml:id="p1z13"/><placeName ref="l28">Basiliensi</placeName> tuo singulari scribas, ut ei <lb xml:id="p1z14"/>numeret 10 florenos, quos tibi confestim <lb xml:id="p1z15"/>reddam.</s>
					<s n="7" xml:lang="la">Crede homini christiano et expe<lb xml:id="p1z16"/>rire eius fidem."</s>
					<s n="8" xml:lang="la">Haec vir tantus.</s>
					<s n="9" xml:lang="la">Tibi ergo, <lb xml:id="p1z17"/>singulari amico meo scribo et per amicitiam <lb xml:id="p1z18"/>nostram peto, ut hasce pecunias nepoti eius <lb xml:id="p1z19"/>numeres.</s>
					<s n="10" xml:lang="la">Quamprimum venerit ad nos <lb xml:id="p1z20"/>(veniet autem duabus aut 3 a pascha sept<lb xml:id="p1z21"/>imanis) monebo efficiamque, ut confestim <lb xml:id="p1z22"/>reddantur; quinimo ipse tibi non sine <lb xml:id="p1z23"/>gratia reddet, quia et ad vos venturus est.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/>Quodsi tibi aut amicis tuis commodum non est <lb xml:id="p1z25"/>ill m pecuniolam exponendi, indica mihi; <lb xml:id="p1z26"/>ipse enim vel a <placeName ref="l587">Tiguro</placeName> mittere malo <lb xml:id="p1z27"/>quam ferre, ut amicus tantus egeat.</s>
					<s n="12" xml:lang="la">Quapropte<lb xml:id="p1z28"/>r effice, ut hic tuam (si fieri potest) <lb xml:id="p1z29"/>humanitatem experiatur.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z30"/>Ex <placeName ref="l834">Italia</placeName> habemus <lb xml:id="p1z31"/><placeName ref="l2510">Turcam</placeName> cert in magna esse expeditione contra <lb xml:id="p1z32"/>Caesarem et fratrem eius.</s>
					<s n="14" xml:lang="la">Cardinalem a Crescentiis, legatum <lb xml:id="p1z33"/><placeName ref="l55">Bononiensem</placeName>, consilio <placeName ref="l1107">Tridentino</placeName> datum esse legatum <lb xml:id="p1z34"/>a pontifice, qui cum 2 episcopis praesideat.</s>
					<s n="15" xml:lang="la">Per<lb xml:id="p1z35"/>sequtionem fervere in <placeName ref="l834">Italia</placeName>.</s>
					<s n="16" xml:lang="la">Catalogum <lb xml:id="p1z36"/>librorum expecto.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Aiunt res <placeName ref="l303">Magdeburgensium</placeName> <lb xml:id="p1z37"/>rectius habere, quam putaveramus, utinam.</s>
					<s n="18" xml:lang="la">Oremus <lb xml:id="p1z38"/>dominum, ut nostri et ecclesiae universae mi<lb xml:id="p1z39"/>sereatur.</s>
					<s n="19" xml:lang="la" ana="farewell">Vale una cum <lb xml:id="p1z40"/>observandissimo <persName ref="p8418">My<lb xml:id="p1z42"/>conio</persName>, cui haec communicabis.</s>
					<s n="20" xml:lang="la">24. martii 51.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z43"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p1278">Ioanni Gastio</persName>, s<lb xml:id="p2z2"/>ingulari suo amico.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l28">Basileae</placeName>.</s>
				</p>
