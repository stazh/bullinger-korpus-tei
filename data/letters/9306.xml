	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S.
					<lb xml:id="p1z2"/>tsi non habeo  . qod ad
					<lb xml:id="p1z3"/>te scribam novi; non potui tamen
					<lb xml:id="p1z4"/>praetermittere, quin per nnprim
					<lb xml:id="p1z5"/>Boghium te salutarem. Saluta itaque
					<lb xml:id="p1z6"/>preterque deum te deu nubes servet.
					<lb xml:id="p1z7"/>et in Belgio et in Halliis
					<lb xml:id="p1z8"/>sates feliciter, ut audimus, succe
					<lb xml:id="p1z9"/>Poloniae ref madum ess
					<lb xml:id="p1z10"/>Electus, neque etiam nostet Ehemius
					<lb xml:id="p1z11"/>inde ad nos rediit. Vidi leteta
					<lb xml:id="p1z12"/>srutoris, in quibus erget multorum
					<lb xml:id="p1z13"/>piorum animis offendi et vero
					<lb xml:id="p1z14"/>etiam labefritari scripto Caspen.
					<lb xml:id="p1z15"/>Galli, qui dem prifessus est
					<lb xml:id="p1z16"/>Genevae, nun vero aulam
					<lb xml:id="p1z17"/>prfitetur. Scribo ad d. Beza.
					<lb xml:id="p1z18"/>curet illud scriptum refutandum.
					<lb xml:id="p1z19"/>sed tua quoque adhortateo nonn
					<lb xml:id="p1z20"/>perum profuerit. Saluta fratres.
					<lb xml:id="p1z21"/>et commendi reptum iulium.
					<lb xml:id="p1z22"/>Heid cl ianius.
					<lb xml:id="p1z23"/>3.
					<lb xml:id="p1z24"/>Tuge .
					<lb xml:id="p1z25"/>sude H. Rehen.
					<pb/>
					<lb xml:id="p2z1"/>.
					<lb xml:id="p2z2"/>Cet.
					<pb/>
					<lb xml:id="p4z1"/>patri d. Henrico
					<lb xml:id="p4z2"/>Bullingero, ecclesiae
					<lb xml:id="p4z3"/>Tigurinae papiri o
				</p>
			</div>
		</body>
	</text>
