	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>s<lb xml:id="p1z3"/>uccessit mihi negotium meum, quemadmodum ex d. <persName ref="p4851">Froschoueri</persName> relatione <lb xml:id="p1z4"/>fusius intelliges.</s>
					<s n="2" xml:lang="la">De <persName>Floriani</persName> negotiis non potuit mihi d. <persName ref="p8041">a Lasco</persName> referre <lb xml:id="p1z5"/>neque quicquam ab illo audivi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Invisam nostrum principem tuis literis, consolabitur <lb xml:id="p1z6"/>iis.</s>
					<s n="4" xml:lang="la">Ante 14 dies obiit senior frater, qui fuit <placeName ref="l1097">Monasteriensis</placeName> episcopus, <lb xml:id="p1z7"/>qui sine ulla pompa sepeliri voluit summaque constantia ad dominum migravit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Ago gratias pro libro mutuae consensionis.</s>
					<s n="6" xml:lang="la">Valde urget d. <persName ref="p8111">Petrus Martyr</persName> <lb xml:id="p1z9"/>aeditionem commentariorum in suis ad me literis statim post <persName ref="p4851">Froschoueri</persName> abitum acceptis <lb xml:id="p1z10"/>una cum praefatione hisce inclusa.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Admoneatur <persName ref="p4851">Froschouerus</persName>, ut maturet aeditionem <lb xml:id="p1z12"/>chartasque post mensem imprimendas et impressas unam ex singulis transmittat.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/><placeName ref="l2529">Brabanti</placeName> silent, <placeName ref="l734">Phrisia</placeName> indies magis erumpit.</s>
					<s n="9" xml:lang="la">D. <persName ref="p536">Caesarius</persName> ante festa <lb xml:id="p1z14"/>natalitia ad dominum migravit constantissima fide et gratia.</s>
					<s n="10" xml:lang="la">Habeo penes me varia <lb xml:id="p1z15"/>carmina ab illo scripta, prima occasione ad te mittam; si tibi visum fuerit, imprimantur.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z16"/>Literas bona fide <placeName ref="l138">Aembdam</placeName> curabo deo volente.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Negotium d. <persName ref="p1560">Hoperi</persName> credo te <lb xml:id="p1z17"/>accepisse.</s>
					<s n="13" xml:lang="la">D. <persName ref="p467">Bucerus</persName> quoque ex hoc seculo ante mensem migravit.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z18"/>De <placeName ref="l303">Magdeburgensibus</placeName> varia narrantur; si sunt vera, apertum est non ex humana industria, <lb xml:id="p1z19"/>sed brachio divino omnia fieri.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Gropperus, qui iam est archidiaconus <placeName ref="l267">Coloniensis</placeName>, <lb xml:id="p1z20"/>valde vehemens est in sua visitatione, an ex syncero vel fiet corde, ignoro; <lb xml:id="p1z21"/>tamen negotium illud ex voto non succedit semper.</s>
					<s n="16" xml:lang="la" ana="salute">Queso, saluta omnes mihi <lb xml:id="p1z22"/>amicos.</s>
					<s n="17" xml:lang="la">Quod <persName>Echtius</persName> noster d. <persName ref="p1283">Gesnero</persName> non respondit, non mea culpa factum est; <lb xml:id="p1z23"/>obstant variae occupationes.</s>
					<s n="18" xml:lang="la">Interim tamen d. <persName ref="p1283">Gesneri</persName> negotium non negligitur.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z24"/>Si forte scripseris ad d. <persName ref="p674">Cantuariensem</persName> vel ad magnates, optarem mentionem fieri <lb xml:id="p1z25"/>bibliorum <placeName ref="l830">Anglicorum</placeName> tuaque commendatione aedatur magis.</s>
					<s n="20" xml:lang="la" ana="farewell">Vale, mi colendissime d. <lb xml:id="p1z26"/><persName ref="p495">Bullingere</persName> et me pro tuo utere.</s>
					<s n="21" xml:lang="la">D. Iesus servet te incolumem<lb xml:id="p1z27"/>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z28"/>Tuus ex animo addictissimus <lb xml:id="p1z29"/><persName ref="p380">Iohannes Byrchmannus</persName> senior.</s>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, domino et amico colendissimo.</s>
					<s n="24" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>