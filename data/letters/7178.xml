	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Viderer non abs re ingratus tibi optimo et
					<lb xml:id="p1z2"/>charissimes Oporine, qui accepto a te amplissimu mu
					<lb xml:id="p1z3"/>
					<lb xml:id="p1z4"/>libr Hyperus et clae scriptr tanto tempore
					<lb xml:id="p1z5"/>irespondeo neque gratias ago, nisi probitas et
					<lb xml:id="p1z6"/>candor tuus de me rectius iudicare didicisset
					<lb xml:id="p1z7"/>ac Ianiu belneo dalere
					<lb xml:id="p1z8"/>Affni ab urbe septimanis aliquot , i redisse
					<lb xml:id="p1z9"/>vix aliquot septimanis ex negotiorum turba
					<lb xml:id="p1z10"/>me expedire potui. Sunt ergo iustissimo causae cur
					<lb xml:id="p1z11"/>nihil scripserim. Sed si ea re peccavi, oro
					<lb xml:id="p1z12"/>ut mn delictum condones. Nunc vero amplissimus
					<lb xml:id="p1z13"/>tibi gratias ago et polliceor me tibi gratu
					<lb xml:id="p1z14"/>siquidem possum, futurum. Uxori tuae honestissima
					<lb xml:id="p1z15"/>uncaurem unum Tigurini mitto, non
					<lb xml:id="p1z16"/>et beneficium compensem, sed ut habeaa ne
					<lb xml:id="p1z17"/>iliquod saltem gratitudinis symbolum. Coror
					<lb xml:id="p1z18"/>mimum aurem mitto coronae matro
					<lb xml:id="p1z19"/>plus quam aureae uxori tuae et praecor
					<lb xml:id="p1z20"/>ei benedictionem a domino et utrique nostrum
					<lb xml:id="p1z21"/>felicitatem stabilem. Te vero mn carisim
					<lb xml:id="p1z22"/>frater Oporine oro per redemptorem nostrum
					<lb xml:id="p1z23"/>imprimas d. Eriti librum, certe contra
					<lb xml:id="p1z24"/>Christum scriptum. Inspexi illum per transemm
					<lb xml:id="p1z25"/>quemattulit manu scriptum d. Tretius Rolmnus
					<lb xml:id="p1z26"/>Qunque eiusmodi libelli offeruntur imprimendi
					<lb xml:id="p1z27"/>oro te sis circumspectus et amicus filii dei
					<lb xml:id="p1z28"/>Alioqui enim maledictioni eras obnoxius
					<lb xml:id="p1z29"/>At benedicit nobis Christus benedictus dei filius
					<lb xml:id="p1z30"/>In hoc aeterni vale. Saluta uxorem tua
					<lb xml:id="p1z31"/>quam salva et incolumem velit dominus. Saluta
					<lb xml:id="p1z32"/>d. Wyssenburgium, Hospinianum et alios fratres
					<lb xml:id="p1z33"/>Salutant te mei omnes. Dominus adsit tib semper.
					<lb xml:id="p1z34"/>Tiguri 1. augusti 156.
					<lb xml:id="p1z35"/>b
					<lb xml:id="p1z36"/>Bullingerus.
					<pb/>
					<lb xml:id="p2z1"/>Indistrio viro d. Ioanni
					<lb xml:id="p2z2"/>Oporino Basiliensis, civi
					<lb xml:id="p2z3"/>et typographo optimo domino
					<lb xml:id="p2z4"/>meo colendo et amico
					<lb xml:id="p2z5"/>Lirtegerrino.
					<lb xml:id="p2z6"/>Oporino zuͦ
					<lb xml:id="p2z7"/>Basel.
				</p>
