	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Per Christum Iesum.</s>
					<s n="2" xml:lang="la">S. D.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Ago tibi gratias, charissime mi atque optime frater, <lb xml:id="p1z4"/>tum meo tum eius fratris nomine, quem tam humaniter <lb xml:id="p1z5"/>ac potius pie curasti; ago, inquam, tibi i<lb xml:id="p1z6"/>mmortales gratias agamque, dum vivam, et oro te <lb xml:id="p1z7"/>per nostram amicitiam et Christi charitatem, quae <lb xml:id="p1z8"/>nostrę vinculum est necessitudinis, ut, quibuscunque i<lb xml:id="p1z9"/>n rebus voles, me et meis utare; sumus enim omnes <lb xml:id="p1z10"/>et nexu et usu tui.</s>
					<s n="4" xml:lang="la">Quod reliquum est, certior <lb xml:id="p1z11"/>fieri cuperem, num iuvenis ille, <persName ref="p2928">Antonius Schnebergerus</persName> <lb xml:id="p1z12"/>nimirum, quem mihi proxime commendaras, tibi meas <lb xml:id="p1z13"/>literas reddiderit.</s>
					<s n="5" xml:lang="la">Optarim enim tibi redditas esse, ut <lb xml:id="p1z14"/>meum erga te animum, qui perpetuo fuerit, intelligeres.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z15"/>Vale, mi amicissime <persName ref="p495">Bullingere</persName> fraterque amantissime, <lb xml:id="p1z16"/>mihique ignosce, si negotium tibi homini occupatissimo <lb xml:id="p1z17"/>exhibeo.</s>
					<s n="7" xml:lang="la" ana="salute">Deum precor, ut te cum tota familia incolumem <lb xml:id="p1z18"/>servet, cui salutem nostro omnium nomine dices.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z19"/><placeName ref="l28">Basileae</placeName> 8. ianuarii 1551.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>Curio ex animo tuus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>evangelistae et [pa]stori <lb xml:id="p2z4"/>vigilantissimo, <lb xml:id="p2z5"/>suo amantissimo et <lb xml:id="p2z6"/>colendissimo fratri.</s>
					<s n="11" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
