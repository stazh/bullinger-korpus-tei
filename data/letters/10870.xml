			<zone xml:id="p2z35-0" points="483,3521 1037,3458 1166,3505 1300,3450 1539,3524 1785,3469 1961,3508 2564,3486 2668,3532 2668,3414 2608,3403 2348,3398 2271,3439 1991,3387 1533,3423 1451,3376 1075,3376 1009,3417 823,3398 483,3456">498,3493 606,3479 715,3469 824,3458 933,3452 1042,3449 1151,3449 1260,3450 1369,3451 1478,3453 1587,3457 1695,3461 1804,3461 1913,3464 2022,3467 2131,3469 2240,3470 2349,3470 2458,3470 2567,3470 2676,3473</zone>
