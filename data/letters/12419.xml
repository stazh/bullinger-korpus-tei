	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Catalogum librorum nunc non mitto, quia nondum per<lb xml:id="p1z2"/>reptavi typographias<note xml:id="fn1" type="footnote" n="1">Druckereien; s. <bibl source="b527">Ramminger</bibl> s.v.</note> omnium.</s>
					<s n="3" xml:lang="la">Mittam autem brevi non solum librorum <lb xml:id="p1z3"/>indicem,<note xml:id="fn2" type="footnote" n="2">Die Sendung erfolgte erst am 7. Juni 1546; s. <ref target="file12409">Nr. 2362</ref>, Anm. 50.</note> sed etiam quicquid volueris.</s>
					<s n="4" xml:lang="la"><persName ref="p18989">Boethii</persName> opera in vas inclusi, <lb xml:id="p1z4"/>quę recipies cum libris <persName ref="p4851">Froscophori</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p4851">Christoph Froschauer</persName>. - Zur <persName ref="p18989">Boethius</persName>-Ausgabe s. <ref target="file12409">Nr. 2362</ref> und Anm. 43; <ref target="file12415">Nr. 2368</ref> und Anm. 28. Die Übermittlung dieser Edition erfolgte erst nach dem 25. März; s. <ref target="file12441">Nr. 2394</ref>,1-3.</note>.</s>
					<s n="5" xml:lang="la">Simul etiam accipies literas <persName ref="p8073">Gil<lb xml:id="p1z5"/>berti</persName> nostri<note xml:id="fn4" type="footnote" ana="bio" n="4"><persName ref="p8073">Gilbert Cousin</persName>. -Angekündigt wird hier <persName ref="p8073">Cousins</persName> Brief an <persName ref="p495">Bullinger</persName> vom 25. März (<ref target="file12440">Nr. 2393</ref>). <persName ref="p1278">Gast</persName> wird davon durch <persName ref="p8073">Cousins</persName> Bruder <persName ref="p4575">Antoine</persName> (s. unten Z. 6) oder durch einen Brief <persName ref="p8073">Cousins</persName> erfahren haben.</note> et ad te et <persName ref="p8011">Gvaltherum</persName>;<note xml:id="fn5" type="footnote" n="5">Nicht erhalten.</note> cui si vultis scribere, potestis ad <lb xml:id="p1z6"/>me mittere ante paschatos festum<note xml:id="fn6" type="footnote" n="6">25. April 1546.</note>.</s>
					<s n="6" xml:lang="la">Nam in ipsa paschę die rever<lb xml:id="p1z7"/>surus ad nos est <persName ref="p8073">Gilberti</persName> <persName ref="p4575">frater</persName><note xml:id="fn7" type="footnote" n="7">Vielleicht <persName ref="p4575">Antoine Cousin</persName>; s. <ref target="file12415">Nr. 2368</ref>, Anm. 30.</note> coempturus libros nuper excusos.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/>Novi nihil habeo nisi quędam incerta.</s>
					<s n="8" xml:lang="la">Sparserunt mercatores quidam <lb xml:id="p1z9"/><placeName ref="l3451">Tuneti</placeName> <persName ref="p46">regem</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p46">Achmed III.</persName>, Kalif aus der Dynastie der <persName ref="p20057">Hafsiden</persName> bis 1570; s. <bibl source="b16">HBBW XIII</bibl> 328, Anm. 3.</note> esse captum a <persName ref="p19042">Barbarossa</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p19042">Cheireddin Barbarossa</persName>.</note> et <placeName ref="l2792">Argeriam</placeName> insulam<note xml:id="fn10" type="footnote" n="10"><placeName ref="l2792">Argeriam</placeName> insulam: Zu dieser Bezeichnung s. <bibl source="b18">HBBW XV</bibl> 669, Anm. 6. - Zu <placeName ref="l2792">Algerien</placeName> vgl. auch die im Briefe <persName ref="p5026">Groppers</persName> vom 20. April 1546 übermittelte Nachricht; s. <bibl source="b263">Gropper BW</bibl> I 409.</note> obsessam <lb xml:id="p1z10"/>ac <placeName ref="l875">Hispanos</placeName> periclitari<note xml:id="fn11" type="footnote" n="11">Über diese Ereignisse konnte nichts Näheres ermittelt werden.</note>.</s>
					<s n="9" xml:lang="la">Propterea <persName ref="p18538">cęsarem</persName><note xml:id="fn12" type="footnote" n="12"><persName ref="p18538">Karl V.</persName></note> properare <placeName ref="l410">Ratisbonam</placeName>, <lb xml:id="p1z11"/>compositurus<pb type="edition" next="206"/> ecclesie negotium aliquo modo,<note xml:id="fn13" type="footnote" n="13">Gleich nach seiner Ankunft in <placeName ref="l410">Regensburg</placeName> am 10. April 1546 (s. <ref target="file12378">Nr. 2331</ref>, Anm. 3) nahm sich Kaiser <persName ref="p18538">Karl V.</persName> der Religionsfrage an; s. dazu <bibl source="b663">Vogel</bibl> 503-516.</note> dein per <placeName ref="l834">Italiam</placeName> <placeName ref="l875">Hispaniam</placeName> <lb xml:id="p1z12"/>aditurus<note xml:id="fn14" type="footnote" n="14"><persName ref="p18538">Karl V.</persName> kam erst wieder im Jahre 1556 nach <placeName ref="l875">Spanien</placeName>; s. <bibl source="b610">Stälin</bibl> 582.</note>.</s>
					<s n="10" xml:lang="la">Utinam nunquam reversurus eo animo, quo hactenus fuit praeditus!</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z13"/>Calamitatibus obruitur variis, cruce premitur in ipso corpore,<note xml:id="fn15" type="footnote" n="15"><persName ref="p18538">Karl V.</persName> litt an Gicht und Syphilis.</note> attamen <lb xml:id="p1z14"/>omnes dei minas et plagas parvi facit.</s>
					<s n="12" xml:lang="la">Consiliarios pessimos <lb xml:id="p1z15"/>habet et impios,<note xml:id="fn16" type="footnote" n="16">Gemeint sind wohl vor allem <persName ref="p7689">Johann von Naves</persName>, Reichsvizekanzler, und <persName ref="p7706">Nicolas Perrenot de Granvelle</persName>; vgl. <ref target="file12423">Nr. 2376</ref>,62f.</note> qui bonum consilium non admittunt; timent, ne aliquid <lb xml:id="p1z16"/>decedat eis.</s>
					<s n="13" xml:lang="la">Dominus illuminet illos luce veritate, ne in perpetuis <lb xml:id="p1z17"/>tenebris pereant.</s>
					<s n="14" xml:lang="la">Amen.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="15" xml:lang="la" ana="farewell">Vale in domino.</s>
					<s n="16" xml:lang="la"><placeName ref="l28">Basileę</placeName>, 7. martii 1<lb xml:id="p1z18"/>546.</s>
					<s n="17" xml:lang="la" ana="salute">D. <persName ref="p8171">Theodorum</persName><note xml:id="fn17" type="footnote" n="17"><persName ref="p8171">Theodor Bibliander</persName>.</note> cum <persName ref="p8127">Pellicano</persName> et <persName ref="p8011">Gvalthero</persName> salutabis.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z19"/>Tuus <persName ref="p1278">Gastius</persName> ex animo.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Docto et pio m. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesiae pastori diligentissi<lb xml:id="p2z4"/>mo, amico suo et <lb xml:id="p2z5"/>domino perpetuo colendo.</s>
				</p>
				<p>
					<s n="20" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
