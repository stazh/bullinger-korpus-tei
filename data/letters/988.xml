	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Pro admonitione fideli literis 2. augusti <lb xml:id="p1z2"/>scriptis ago tibi gratias.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Utinam coniectus fuisset <lb xml:id="p1z3"/>in vincula et per tormenta quaesitus, qui mina<lb xml:id="p1z4"/>s illas Caes[aris] effutivit; fuerunt et alii plures, <lb xml:id="p1z5"/>qui eadem effuderunt, verum spero illos <lb xml:id="p1z6"/>vanissimos vates futuros.</s>
					<s n="4" xml:lang="la">Nostri diligenter <lb xml:id="p1z7"/>advigilant.</s>
					<s n="5" xml:lang="la">Caesar ab <placeName ref="l18">Augusta</placeName> concessit <placeName ref="l336">Monacum</placeName>; ibi decum<lb xml:id="p1z8"/>bere dicitur ex morbo suo, quem contraxit sibi ex persequtione evangelii (a. R.: nescio, <lb xml:id="p1z9"/>quam vere hoc scribatur decumbere; certum est illum agere modo in <placeName ref="l619">Bavaria</placeName>); non procul <lb xml:id="p1z10"/>autem ab urbe agit in arce aut domo constructo no<lb xml:id="p1z11"/>n ita pridem a <placeName ref="l619">Bavaro</placeName> voluptatis gratia<lb xml:id="p1z12"/>.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Huiusmodi enim homines merito se non perventuros <lb xml:id="p1z14"/>in paradysum metuunt; hic ergo amoe<lb xml:id="p1z15"/>nissimas paradysos extruunt, ut aliqua saltem <lb xml:id="p1z16"/>voluptate fruantur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Age, haereat et numquam egredia<lb xml:id="p1z17"/>tur ex illa <placeName ref="l619">Bavarica</placeName> paradyso Caesar; non in<lb xml:id="p1z18"/>videbo illi hanc voluptatem aut felicitatem; de<lb xml:id="p1z19"/>litiis <placeName ref="l619">Bavaricis</placeName> non potest abesse porcus.</s>
					<s n="8" xml:lang="la">Aiunt <lb xml:id="p1z20"/><persName>Philippum</persName> parare reditum in <placeName ref="l875">Hispanias</placeName>; ita di<lb xml:id="p1z21"/>vexantur <placeName ref="l2530">Portugallenses</placeName> a <placeName ref="l2923">Mauris</placeName> et <persName>Zaripha <lb xml:id="p1z22"/>Draguto</persName>; parabit dominus clemens et misericors <lb xml:id="p1z23"/>fortassis <placeName ref="l2550">Palestinos</placeName> suo Davidi gementi sub <lb xml:id="p1z24"/>oppressione Saulina.</s>
					<s n="9" xml:lang="la">Caesar enim certo instituit <lb xml:id="p1z25"/>concilium continuare <placeName ref="l1107">Tridenti</placeName> ac sub hoc prae<lb xml:id="p1z26"/>textu primum quidem dissidia serere in <placeName ref="l822">Germania</placeName>, <lb xml:id="p1z27"/>deinde opprimere eorum libertatem, nec <lb xml:id="p1z28"/>carebimus hoc malo in <placeName ref="l862">Helvetia</placeName>, cum non de<lb xml:id="p1z29"/>erunt, qui volent nos abire disputatum in <lb xml:id="p1z30"/>illud concilium.</s>
					<s n="10" xml:lang="la">Mitto tuae humanitati, <lb xml:id="p1z31"/>quod reliquum est Decadis 4.</s>
					<s n="11" xml:lang="la">Disputo in hac <lb xml:id="p1z32"/>de potissimis religionis nostrae mysteriis, uti<lb xml:id="p1z33"/>nam sancte et feliciter.</s>
					<s n="12" xml:lang="la">Tu munus ab amico <lb xml:id="p1z34"/>excipe amica mente et libere de his et aliis <lb xml:id="p1z35"/>meis omnibus iudica et rescribe.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vale cum <lb xml:id="p1z36"/>tuis aeternum.</s>
					<s n="14" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 15. augusti anno 1550.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z37"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8418">Os<lb xml:id="p2z2"/>valdo Myconio</persName>, domino et <lb xml:id="p2z3"/>fratri colendissimo suo.</s>
				</p>
				<p>
					<s n="17" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
