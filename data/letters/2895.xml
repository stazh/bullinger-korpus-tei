	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi literas; fuerunt mihi magno solatio, <lb xml:id="p1z2"/>et quidem nihil mihi gratius evenire poterat quam <lb xml:id="p1z3"/>hic loci tuam fere totam familiam, officio<lb xml:id="p1z4"/>sissimam uxorem, honestissimas filias, optimos et <lb xml:id="p1z5"/>doctos suavissimęque consuetudinis homines, generos <lb xml:id="p1z6"/>tuos, invenisse.</s>
					<s n="3" xml:lang="la">Sumus omnes apud eundem hos<lb xml:id="p1z7"/>pitem, ita ut non intercedat nisi area.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Satis honesto pretio habito.</s>
					<s n="5" xml:lang="la">Redditis tuis <lb xml:id="p1z10"/>literis honestissima uxor tua inprimis et duo generi <lb xml:id="p1z11"/>cum filiabus mihi offitiosissime adfuerunt et <lb xml:id="p1z12"/>hospiti commendarunt omniaque humanitatis officia sunt <lb xml:id="p1z13"/>polliciti.</s>
					<s n="6" xml:lang="la">Plurimum id et mihi et inprimis meę <lb xml:id="p1z14"/>uxori attulit consolationis et solatii.</s>
					<s n="7" xml:lang="la">Pro <lb xml:id="p1z15"/>tanta et tua et tuorum erga nos benevolent<lb xml:id="p1z16"/>ia atque humanitate gratias habemus et agimus, <lb xml:id="p1z17"/>quam possumus maximas.</s>
					<s n="8" xml:lang="la">Vicissim, si qua in re <lb xml:id="p1z18"/>possum illis esse commodo et tibi tuisque grati<lb xml:id="p1z19"/>ficari, en tuum semper presto <persName ref="p4037">Hieronymum</persName>.</s>
					<s n="9" xml:lang="la">Velim <lb xml:id="p1z20"/>credas me tibi etiam devinctissimum tuique studiosissimum.</s>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z21"/>Vale igitur, optime pater <persName ref="p495">Bullingere</persName>, et pro nobis roga <lb xml:id="p1z23"/>dom<pb/><lb xml:id="p2z1"/>inum.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z2"/>Ex Th<lb xml:id="p2z4"/>ermi<lb xml:id="p2z5"/>s <lb xml:id="p2z7"/><placeName ref="l21">Bade<lb xml:id="p2z8"/>[nsib<lb xml:id="p2z9"/>u<lb xml:id="p2z10"/>s]</placeName> <lb xml:id="p2z11"/>15. aprilis 1556.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z13"/>T. s<lb xml:id="p2z14"/>t<lb xml:id="p2z15"/>. <lb xml:id="p2z16"/><persName ref="p4037">H[ie<lb xml:id="p2z17"/>ron<lb xml:id="p2z18"/>ymus] Zanchus</persName>.</s>
				</p>
