	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Dum haec scribo, nihil adhuc tuarum vidi <lb xml:id="p1z2"/>literarum, chare frater, et tamen 8. abhinc die <lb xml:id="p1z3"/>breves etiam ad te misi, non tamen ullius <lb xml:id="p1z4"/>momenti, ut ne hae quidem sunt.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Dumtaxat <lb xml:id="p1z5"/>inclusi his nova, quae huc sunt aliunde allata.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Fortasse copiosius, nisi etiam aliter, eadem narrat <lb xml:id="p1z7"/>apud vos <persName>Balltazar</persName>, id quod forte audiam alias.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Valemus hic satis recte per dei gratiam, nisi quod <lb xml:id="p1z9"/>incipit magna esse ministrorum inopia.</s>
					<s n="6" xml:lang="la">Dominus extrudere <lb xml:id="p1z10"/>dignetur operarios in messem suam!</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z11"/>una cum familia tua.</s>
					<s n="8" xml:lang="la">Dominus benedicat tibi et fa<lb xml:id="p1z12"/>miliae tuae et servet ab omni malo.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 10. <lb xml:id="p1z13"/>decembris 1568.</s>
					<s n="10" xml:lang="la" ana="salute">Saluta ordine amicos, quos <lb xml:id="p1z14"/>nosti, omnes.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z15"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="12" xml:lang="de"><lb xml:id="p1z16"/>Waar ist's, das die, so für <placeName ref="l327">Mümpelgart</placeName> <lb xml:id="p1z17"/>herabzogen, da niden von <placeName>Aumalischen</placeName> <lb xml:id="p1z18"/>uff 500 erschlagen, ir oberister, der <persName>Con<lb xml:id="p1z19"/>disch</persName>, gefangen.</s>
					<s n="13" xml:lang="de">Für war bestät man <lb xml:id="p1z20"/>ouch, daß der von <placeName>Uranien</placeName> dem <persName>Conde</persName> <lb xml:id="p1z21"/>zuͦzücht, uff <persName>S. Quintin</persName> kummen<pb/><lb xml:id="p2z1"/>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z2"/>Ornatissimo viro d. <lb xml:id="p2z3"/><persName ref="p8016">Tobiae Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z4"/>ecclesiae ministro, domino <lb xml:id="p2z5"/>colendo et fratri charissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
