	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Si ultra Herculis extremas columnas degeretis, <persName ref="p495">Bulinger</persName>e <lb xml:id="p1z2"/>charissime, sępius quam nunc (opinor) vestras <lb xml:id="p1z3"/>literas acciperem; iam enim annus est, quod mihi nihil <lb xml:id="p1z4"/>harum redditur.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Itaque non possum non esse solicitus, <lb xml:id="p1z5"/>quid in causa sit, et inprimis, ne forte quid vobis <lb xml:id="p1z6"/>acciderit, quod non sit mihi iucundum futurum ex <lb xml:id="p1z7"/>vestris literis cognoscere.</s>
					<s n="4" xml:lang="la">Ab hanc animi anxietate <lb xml:id="p1z8"/>quam primum liberari cupio.</s>
					<s n="5" xml:lang="la"><placeName ref="l862">Helvetios</placeName> iam minus <lb xml:id="p1z9"/>se miscere alienis negotiis gaudeo.</s>
					<s n="6" xml:lang="la">Fuerunt hic ali<lb xml:id="p1z10"/>quot aulici principis <placeName>Aurangiae</placeName>, qui negant hoc <lb xml:id="p1z11"/>anno bellum fore in <placeName ref="l822">Germania</placeName> est maritimae <lb xml:id="p1z12"/><placeName ref="l749">Saxonum</placeName> civitates libere navigare <placeName ref="l15">Antverpiam</placeName> <lb xml:id="p1z13"/>et negotiari.</s>
					<s n="7" xml:lang="la">n. Aiunt post duos ab hinc menses <lb xml:id="p1z14"/><placeName ref="l471">Spiram</placeName> venturum ad comitia, quibus in filium <lb xml:id="p1z15"/>translaturus sit imperii fasces.</s>
					<s n="8" xml:lang="la">Deus prosperet, <lb xml:id="p1z17"/>quicquid ad ipsius gloriam pertinet.</s>
					<s n="9" xml:lang="la">Mense Martio excessit et <lb xml:id="p1z18"/>vita pater meus.</s>
					<s n="10" xml:lang="la">Aliud hic novi nihil est.</s>
					<s n="11" xml:lang="la">Cupio <lb xml:id="p1z19"/>te quam optime et quam rectissime valere, domine <lb xml:id="p1z20"/>mi et amice incomparabilis.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l356">Nozerethi</placeName> 7. calendas <lb xml:id="p1z21"/>Julii anno christiano 1549.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Tuus ac suus <persName ref="p8073">Gilbertus Cognatus</persName> <lb xml:id="p1z23"/>noz.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Consummatissimo theologię <lb xml:id="p2z2"/>professori D. <persName ref="p495">Henrycho <lb xml:id="p2z3"/>Bullingero</persName>, D. suo incom<lb xml:id="p2z4"/>parabili.</s>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
