	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S. D.</s>
					<s n="2" xml:lang="la">Vinum per affinem tuum <persName ref="p8171">Theodorum</persName> accepi <lb xml:id="p1z3"/>et pro hoc maximas tuae humanitati gratias <lb xml:id="p1z4"/>ago redditurus, si vixero.</s>
					<s n="3" xml:lang="la">Miror valde, cur <lb xml:id="p1z5"/>nullas a te accipiam, quas summo desiderio <lb xml:id="p1z6"/>expecto.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Sum iam in luctu et moerore non <lb xml:id="p1z7"/>levi: a <persName ref="p8011">Gvaltheri</persName> uxoris morte mox <persName>Elizabeth<lb xml:id="p1z8"/>a</persName> dilecta mea decubuit et 3. die feliciter <lb xml:id="p1z9"/>spiritum suum deo tradidit; uxor fuit d. <persName ref="p8442">Simleri</persName>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Nunc animam agit etiam mea filia <lb xml:id="p1z11"/><persName ref="p7224">Anna</persName>, uxor <persName ref="p7228">Zvinglii</persName>, in cuius aedibus haec scribo.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Quid de me meisque aliis deus statuerit, ipse <lb xml:id="p1z13"/>novit; ego sum paratus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Si migravero <lb xml:id="p1z14"/>hinc, quaeso, cura, ut liberi mei accipiant <lb xml:id="p1z15"/><persName>Suͤleri</persName> pecunias, quas debet etc.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale aeternum, <lb xml:id="p1z16"/>frater in Christo colendissime; plura me nunc dolor <lb xml:id="p1z17"/>scribere non sinit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Quia homo sum, interim cons<lb xml:id="p1z18"/>olor me promissionibus Christi, et quod filia<lb xml:id="p1z19"/>e m<lb xml:id="p1z20"/>eae in syncera confessione et invocatione Christi <lb xml:id="p1z21"/>expirant.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ora pro nobis dominum.</s>
					<s n="11" xml:lang="de">23. novembris 1565.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute"><lb xml:id="p1z22"/>Salutant te <persName ref="p1884">Lavaterus</persName> <lb xml:id="p1z23"/>et <persName ref="p7228">Zvinglius</persName>, <lb xml:id="p1z24"/>qui morienti assistunt.</s>
					<s n="13" xml:lang="la" ana="salute">Saluta <lb xml:id="p1z26"/>d. consules et amicos.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z27"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z2"/>Praestantissimo viro d. <lb xml:id="p2z3"/><persName ref="p8009">Ioanni Fabritio</persName>, <lb xml:id="p2z4"/><placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z5"/>ministro, domino meo <lb xml:id="p2z6"/>colendo et fratri <lb xml:id="p2z7"/>charissimo.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l98">C<lb xml:id="p2z10"/>hur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>