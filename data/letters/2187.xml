	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime <persName ref="p495">Bullingere</persName>.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Scripsi ad te ante octo dies et literas misi <lb xml:id="p1z3"/><placeName ref="l291">Lindavium</placeName>; spero te habuisse.</s>
					<s n="3" xml:lang="la">Significabam <lb xml:id="p1z4"/>de <persName>Beato</persName> illo tuo visum fuisse <placeName ref="l410">Rat<lb xml:id="p1z5"/>isponae</placeName> visum esse incolumem, quum a <placeName ref="l2721">Pannomia<lb xml:id="p1z6"/>e</placeName> bello rediisset.</s>
					<s n="4" xml:lang="la">Dies <persName>Halcyonios</persName> <lb xml:id="p1z7"/>dixeris ita et apud nos et in tota <lb xml:id="p1z8"/><placeName ref="l822">Germania</placeName> pacata sunt (quod ad evan<lb xml:id="p1z9"/>gelium pertinet) omnia, utinamque <lb xml:id="p1z10"/>in eo promovendo essemus diligentiores; <lb xml:id="p1z11"/>sed frigemus nimium, neque credidis<lb xml:id="p1z12"/>sem ego tantum esse hic frigoris.</s>
					<s n="5" xml:lang="la">Or<lb xml:id="p1z13"/>emus dominum, ut misso spiritu suo <lb xml:id="p1z14"/>sancto calfaciat corda nostra.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Dux e <placeName ref="l496">Stucardia</placeName> huc brevi est venturus <lb xml:id="p1z16"/>et per aliquot menses haesurus.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/>Quotidie pleni erimus rebus novis, si <lb xml:id="p1z18"/>quas mundus produxerit.</s>
					<s n="8" xml:lang="la">Ego totos <lb xml:id="p1z19"/>dies toto animo incumbo in mea studia; <lb xml:id="p1z20"/>at mirum, ut non possim vita<lb xml:id="p1z21"/>re invidiam.</s>
					<s n="9" xml:lang="la">Sunt enim hic (inter profes<lb xml:id="p1z22"/>sores loquor) insignes aliquot papistae, <lb xml:id="p1z23"/>qui me etiam tacentem et fere la<lb xml:id="p1z25"/>titantem ferre non possunt; quamquam <lb xml:id="p1z26"/>non omnino latito neque taceo.</s>
					<s n="10" xml:lang="la">Cupio <lb xml:id="p1z27"/>habere tuum librum De iustificatione; <lb xml:id="p1z28"/>si incideris in aliquam occasionem, <lb xml:id="p1z29"/>mitte ad me primo quoque tempore.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Princeps iussit, ut differam profectionem <lb xml:id="p2z2"/>meam <placeName ref="l18">Augustam</placeName>; ait se timere, ne o<lb xml:id="p2z3"/>pprimar, quin iubet, ut caveam mihi undique.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z4"/>Ego quidem non usque qua<lb xml:id="p2z5"/>que ti<lb xml:id="p2z6"/>meo; sed ut eius celsitudinis consilium <lb xml:id="p2z7"/>ne videar contemnere, <placeName ref="l512">Tubinga</placeName> n<lb xml:id="p2z8"/>on <lb xml:id="p2z9"/>exeo.</s>
					<s n="13" xml:lang="la">At non potero me diu continere, <lb xml:id="p2z10"/>quin aliquo eam et clamem atque <lb xml:id="p2z11"/>excitem dormientes.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale et <lb xml:id="p2z12"/>salve cum tota familia, generis <lb xml:id="p2z13"/>tuis, cum tota schola atque ecclesia, <lb xml:id="p2z14"/>pastoribus et professoribus.</s>
					<s n="15" xml:lang="la">Iuvate <lb xml:id="p2z15"/>me, obsecro, vestris precibus apud <lb xml:id="p2z16"/>d. deum nostrum.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z17"/><placeName ref="l512">Tubingae</placeName> 15. februarii 1554.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z18"/><persName ref="p3375">Ve<pb/><lb xml:id="p4z2"/>rge<lb xml:id="p4z3"/>r<lb xml:id="p4z5"/>ius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
