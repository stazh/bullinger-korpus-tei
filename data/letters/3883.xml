			<zone xml:id="p2z6-0" points="1196,2787 1222,2792 1254,2773 1273,2781 1299,2770 1346,2773 1373,2759 1412,2787 1453,2766 1465,2770 1466,2720 1397,2738 1373,2726 1286,2731 1249,2705 1235,2714 1197,2711">1203,2758 1229,2760 1256,2760 1282,2759 1309,2757 1335,2755 1362,2757 1388,2758 1415,2758 1441,2758 1468,2758</zone>
