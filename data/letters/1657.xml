	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quantum ex iis, quae <placeName ref="l18">Augustani</placeName> ad me <lb xml:id="p1z2"/>scribunt, coniicere datur, compater in domino <lb xml:id="p1z3"/>charissime, committetur brevi inter se Ger<lb xml:id="p1z4"/>mania gravissimis motibus, utinam non et <lb xml:id="p1z5"/>cladibus.</s>
					<s n="3" xml:lang="la"><persName ref="p18477">Ferdinandus</persName> paulatim vires idque variis <lb xml:id="p1z6"/>in locis collegit, interea dum <persName ref="p18250">Mauricio</persName> verba <lb xml:id="p1z7"/>dedit; sic tractandi sunt stupidi <placeName ref="l822">Germani</placeName>.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Exercitus principum <placeName ref="l410">Ratisbonam</placeName> descendunt, <lb xml:id="p1z9"/>ubi <persName ref="p18477">Ferdinandus</persName> 12 cohortes habet; 16000 collecta <lb xml:id="p1z10"/>sunt in <placeName ref="l2485">Carinthia</placeName> et <placeName ref="l2486">Stiria</placeName>.</s>
					<s n="5" xml:lang="la">Electoris <lb xml:id="p1z11"/>captivi hactenus, iam liberi, senior filius gener <lb xml:id="p1z12"/><persName ref="p18477">Ferdinandi</persName> factus esse scribitur; ipse <persName ref="p20484">Ioannes <lb xml:id="p1z13"/>Fridenrichus</persName>, si vera scribuntur, per <placeName ref="l2449">Bohemos</placeName> <lb xml:id="p1z14"/>in <placeName ref="l749">Saxoniam</placeName> redit idque cum copiis <placeName ref="l2449">Bohemorum</placeName> <lb xml:id="p1z15"/>negocium facturus <persName ref="p18250">Mauricio</persName> ac par pari <lb xml:id="p1z16"/>redditurus; verum <persName ref="p17854">comes ab Oldenbuerg</persName> ad <lb xml:id="p1z17"/>resistendum fertur esse paratus.</s>
					<s n="6" xml:lang="la">Deinde <lb xml:id="p1z18"/>ab <placeName ref="l3382">Aschenburg</placeName> exercitus quidam Caesarianus <lb xml:id="p1z19"/>nomine, reipsa episcoporum <placeName ref="l307">Moguntinensis</placeName>, <placeName ref="l1703">Bambergensis</placeName> <lb xml:id="p1z20"/>et <placeName ref="l1030">Wirtzburgensis</placeName> ad liberandum <placeName ref="l361">Nurnberg[enses]</placeName> <lb xml:id="p1z21"/>ascendit.</s>
					<s n="7" xml:lang="la"><placeName ref="l619">Bavaria</placeName> et <placeName ref="l572">Wirtenberg</placeName> im<lb xml:id="p1z22"/>plentur selectis militibus, ut ad resistendum <lb xml:id="p1z23"/>principibus sese parare videantur.</s>
					<s n="8" xml:lang="la"><placeName ref="l18">Au<lb xml:id="p1z24"/>gustani</placeName> haec intelligentes in metu sunt <lb xml:id="p1z25"/>constituti.</s>
					<s n="9" xml:lang="la">Dum ista lego, cogito verissimum <lb xml:id="p1z26"/>esse, quod ille dixit: "Tolle moras; <lb xml:id="p1z27"/>semper nocuit differre paratis."</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Satius <lb xml:id="p1z28"/>erat cum exercitu ad pugnandum quam <lb xml:id="p1z29"/>ad practicandum descendere <placeName ref="l1139">Lintzium</placeName> et <lb xml:id="p1z30"/><placeName ref="l1204">Passaviam</placeName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z31"/>Ecclesia <placeName ref="l18">Augustana</placeName> sustinet etiamnum Interi<lb xml:id="p1z32"/>mistas, metaxycos illos vertumnos, cum <lb xml:id="p1z33"/>in promptu habeat pristinos suos conci<lb xml:id="p1z34"/>onatores a Caesare olim profligatos; <lb xml:id="p1z35"/>sunt enim illi iam <placeName ref="l18">Augustae</placeName> omnes praeter <lb xml:id="p1z36"/>eum, qui hic apud nos agit.</s>
					<s n="12" xml:lang="la">Verum senatus <lb xml:id="p1z37"/>ministerium illis concedere detrectat, priusquam <lb xml:id="p1z38"/>vinculo praestiti sacramenti liberentur.</s>
					<s n="13" xml:lang="la">Ipsa civitas <lb xml:id="p1z39"/>et ecclesia libertatem amplexa est reiecta <lb xml:id="p1z40"/>Caesaris tyrannide; soli ministri adhuc pro ligatis <lb xml:id="p1z41"/>et iuratis habentur, cum sint et ipsi reipubli<lb xml:id="p1z42"/>cae huius cives.</s>
					<s n="14" xml:lang="la">Si quid ex <placeName ref="l834">Italia</placeName> habes, <lb xml:id="p1z43"/>quaeso, communices.</s>
					<s n="15" xml:lang="la">De Caesare nihil certi.</s>
					<s n="16" xml:lang="de">Es ist <lb xml:id="p1z44"/>allenthalben <persName ref="p18477">Ferdinandus</persName> im spil.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Optime vale, compater <lb xml:id="p1z45"/>charissime.</s>
					<s n="18" xml:lang="la" ana="salute">Salutem toti domui tuę, fratribus item, <lb xml:id="p1z46"/>dominis et amicis.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l41">Bernę</placeName> 12. iunii.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><persName ref="p8417">W[olfgangus] Mus[culus]</persName>, tuus in domino.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo m. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/>compatri suo <lb xml:id="p2z5"/>charissimo.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
