	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><persName ref="p8055">Ambrosio</persName> scribente<note xml:id="fn1" type="footnote" n="1"><persName ref="p8055">Ambrosius Blarer</persName> schrieb ungefähr gleichzeitig einen undatierten Brief an <persName ref="p495">Bullinger</persName>; s. unten <ref target="file11515">Nr. 1472</ref>.</note> facile possum silere, <lb xml:id="p1z2"/>nisi quod gratias ago munificentiae et magnificentiae <lb xml:id="p1z3"/>tuae pro libro<note xml:id="fn2" type="footnote" n="2">Von welchem Buch die Rede ist, bleibt offen.</note> dono nobis misso, deinde, quod <lb xml:id="p1z4"/>nostra culpa impeditus est adolescens<note xml:id="fn3" type="footnote" n="3">Unbekannt.</note> tuus diutius, <lb xml:id="p1z5"/>atque ipse voluerit.</s>
					<s n="3" xml:lang="la">Mihi ergo succenseas, si quid <lb xml:id="p1z6"/>neglexit.</s>
					<s n="4" xml:lang="la">De aliis <persName ref="p8055">Ambrosius</persName>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z7"/>cum tota familia.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>2. martii 1541.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z9"/>Tuus <persName ref="p4079">Io. Zwick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z2"/>fratri observand<lb xml:id="p2z3"/>issim<lb xml:id="p2z7"/>o<lb xml:id="p2z8"/>.</s>
				</p>
			</div>
		</body>
	</text>
