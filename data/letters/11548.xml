	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Die Datierung ergibt sich aus der Bemerkung über <persName cert="high" ref="p8455">Hans Vogler</persName> (unten Z. 4-6); <persName ref="p1365" cert="high">Grynäus</persName> erwähnt dessen unehrenhafte Entlassung nach <placeName ref="l587" cert="high">Zürich</placeName> in seinem Brief vom Vortag (oben <ref target="file11547">Nr. 1504</ref>, 5f).</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Commendo vobis hos fratres<note xml:id="fn2" type="footnote" n="2">Unbekannt.</note> in domino.</s>
					<s n="3" xml:lang="la">Pie<lb xml:id="p1z2"/>tatem videntur intelligere.</s>
					<s n="4" xml:lang="la">Vestram ecclesiam <lb xml:id="p1z3"/>cupiunt cognoscere, deinde in <placeName ref="l832">Galliam</placeName> redituri <lb xml:id="p1z4"/>ea, ut videtur, lege, si inde ad nos transferre <lb xml:id="p1z5"/>possint sua omnia.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><persName ref="p8455">Voglerum</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p8455">Hans Vogler d.J.</persName></note> coges, ut <lb xml:id="p1z6"/>contiones sacras audiat quottidie, tum, ut eas <lb xml:id="p1z7"/>alicui repetat.</s>
					<s n="6" xml:lang="la">Hęc verbi dei meditatio<note xml:id="fna" type="footnote" n="a"><hi>Vielleicht als</hi> meditacio <hi>zu lesen.</hi></note> <lb xml:id="p1z8"/>faciet, arbitror, ut animus stabilimentum <lb xml:id="p1z9"/>accipiat.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Vale in domino, frater mihi dilectissime.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>24. aprilis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z11"/><persName ref="p1365">Simon Grynęus</persName> tuus.<pb type="edition" next="167"/></s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName> suo, <lb xml:id="p2z3"/>amico et fratri <lb xml:id="p2z4"/>colendo.</s>
					<s n="11" xml:lang="la"><placeName ref="l587">Tyguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
