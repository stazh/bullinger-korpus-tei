	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Iampridem rogavi 15 pagos vestro, ut ti
					<lb xml:id="p1z2"/>regi Francorum redeunti ex Polonia usuvemu
					<lb xml:id="p1z3"/>efacere per ditum crrę reginis
					<lb xml:id="p1z4"/>commeatum Ill ultro offerre reletis
					<lb xml:id="p1z5"/>scilitet.
					<lb xml:id="p1z6"/>pro mutuu inter ro amicitia atque fider
					<lb xml:id="p1z7"/>Nunc de sipsum curarem admonitus
					<lb xml:id="p1z8"/>um fuis liis veltrera scriptis vi hu
					<lb xml:id="p1z9"/>dubio adduc rege quiam viam.
					<lb xml:id="p1z10"/>capedceret. nisi iute, vir optime, nihl
					<lb xml:id="p1z11"/>venerande satis perspiceres quati mumenti
					<lb xml:id="p1z12"/>sit, ut hac potii, qua per Hispani
					<lb xml:id="p1z13"/>regiones transeat pluribus decum agere
					<lb xml:id="p1z14"/>Itaque ut mes commoncas de hac re
					<lb xml:id="p1z15"/>etim etque etia voro denrat
					<lb xml:id="p1z16"/>mmeu.
					<lb xml:id="p1z17"/>semper ano Tyolodurus.
					<lb xml:id="p1z18"/>S.
					<lb xml:id="p1z19"/>mentus iulii 14.
					<lb xml:id="p1z20"/>Tui et studiorissimu
					<lb xml:id="p1z21"/>Salaauorius.
					<lb xml:id="p1z22"/>Io.
					<lb xml:id="p1z23"/>m
					<pb/>
					<lb xml:id="p4z1"/>veverando atque optimo
					<lb xml:id="p4z2"/>viro Henrico Bullingero,
					<lb xml:id="p4z3"/>ecclesi Tigurine mnistu
					<lb xml:id="p4z4"/>Cpsira.
					<lb xml:id="p4z5"/>In meyster Heinrichen Bullinger,
					<lb xml:id="p4z6"/>dienene den kilchen Zu rich
					<lb xml:id="p4z7"/>Zürich.
				</p>
			</div>
		</body>
	</text>
