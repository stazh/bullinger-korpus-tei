	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Compater in domino charissime, gratulor tibi et <lb xml:id="p1z2"/>reliquis symmystis tuis doctissimorum pariter et <lb xml:id="p1z3"/>fidelissimorum athletarum Christi optimorum senum <lb xml:id="p1z4"/>d. <persName ref="p2336">Bernardini</persName> et <persName ref="p8111">Petri Martyris</persName> solatia, quibus <lb xml:id="p1z5"/>labores tuos et curas pro sua benevolentia dominus <lb xml:id="p1z6"/>relevare et ecclesiam, scholam ac rempublicam <lb xml:id="p1z7"/>vestram ornare dignatur.</s>
					<s n="3" xml:lang="la">Sic pro uno <persName ref="p8127">Pellicano</persName> <lb xml:id="p1z8"/>piae memoriae, qui diu ecclesiam vestram vel <lb xml:id="p1z9"/>sola praesentia sua decoravit, iam duos habetis <lb xml:id="p1z10"/>claros et insignes senes, per quos amissi <lb xml:id="p1z11"/>prioris iactura non sine luculento cumulo <lb xml:id="p1z12"/>sarcitur.</s>
					<s n="4" xml:lang="la">Oro dominum, ut diuturna vobis sit <lb xml:id="p1z13"/>ista felicitas.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z14"/>De rebus <placeName ref="l822">Germaniae</placeName> nostrae non dubito quin ad <lb xml:id="p1z15"/>te plura quam ad me ab amicis perscribantur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z16"/>Quemadmodum enim ipse raro scribo ad alios, <lb xml:id="p1z17"/>ita alii vicissim ad me rarissime scribunt <lb xml:id="p1z18"/>uno dempto <persName>Mekardo</persName> <placeName ref="l18">Augustanae</placeName> ecclesiae m<lb xml:id="p1z20"/>inistro, qui ante biduum haec scripsit: "<lb xml:id="p1z21"/>Exercitus noster cruenta victoria liberavit Siget, arcem <lb xml:id="p1z22"/>munitissimam, ab obsidione <placeName ref="l2510">Turcorum</placeName>, ubi in primo <lb xml:id="p1z23"/>congressu periculose dimicatum est a nostris fugientibus <lb xml:id="p1z24"/>Ungaris et nonnullis aliis eius nationis <lb xml:id="p1z25"/>hominibus.</s>
					<s n="7" xml:lang="la">Verum constans atque fortissima <placeName ref="l822">German<lb xml:id="p1z26"/>orum</placeName> virtus tandem <placeName ref="l2510">Turcos</placeName> fudit, quibus fugatis <lb xml:id="p1z27"/>qui antea fugerant, iterum pugnare ceperunt et victoria <lb xml:id="p1z28"/>potiti sunt.</s>
					<s n="8" xml:lang="la">In hoc conflictu <persName ref="p20184">Bolwil</persName> ille summus <lb xml:id="p1z29"/><persName ref="p18477">Ferdinandi</persName> capitaneus, fratrem suum germanum mortuum <lb xml:id="p1z30"/>reliquit cum potioribus nobilium et ipse pede trans<lb xml:id="p1z31"/>fixo vix evasit.</s>
					<s n="9" xml:lang="la">nona huius mensis literas habuimus <lb xml:id="p1z32"/>fere totum <placeName ref="l2510">Turcorum</placeName> exercitum a nostris esse prostratum.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z33"/>Hodie abit <persName ref="p4863">Iohannes Fuggerus</persName> cum 50 equitibus in auxilium <lb xml:id="p1z34"/><persName ref="p18477">Ferdinandi</persName> iunioris regis <placeName ref="l882">Ungariae</placeName>.</s>
					<s n="11" xml:lang="la"><persName ref="p19368">Ioannes Walther <lb xml:id="p1z35"/>ab Hirnheym</persName> 500 equitibus sumptibus regis <placeName ref="l425">Romani</placeName>, <lb xml:id="p1z36"/>elector <placeName ref="l749">Saxoniae</placeName> praeterita septimana misit 2000 <lb xml:id="p1z37"/>equites nobilissimos ad <persName ref="p18477">Ferdinandum</persName> proprio sumptu.</s>
					<s n="12" xml:lang="la">Summus <lb xml:id="p1z38"/>capitaneus <persName ref="p18477">Ferdinandus</persName> iunior habet iam instructum <lb xml:id="p1z39"/>exercitum 7000 equitum" etc.</s>
					<s n="13" xml:lang="la">Si tu praeterea <lb xml:id="p1z40"/>quid habes per dilectissimum nostrum compatrem d. <persName ref="p8018">Hallerum</persName>, <lb xml:id="p1z41"/>significa, praesertim de <placeName ref="l830">Anglia</placeName> et <placeName ref="l2472">Polonia</placeName>.</s>
					<s n="14" xml:lang="la" ana="farewell">Optime vale.</s>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z42"/>Saluta totam tuam domum meo et meorum nomine et <lb xml:id="p1z43"/>symmystas tuos, dominos et fratres charissimos.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l41">Bernę</placeName> 25. augusti 1556.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z44"/><persName ref="p8417">W[olfgangus] Musculus</persName>, tuus in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo theologo <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>compatri in <lb xml:id="p2z4"/>domino charissimo.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z19"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
