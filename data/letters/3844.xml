	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quamvis libenter legerim diligenter <lb xml:id="p1z2"/>descriptam tuam illam historiam, nihil tamen <lb xml:id="p1z3"/>opus fuisset tantis te molestari laboribus.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Tametsi scripserint ea de re ad me legati, <lb xml:id="p1z5"/>attamen nihil sum commotus contra te; quinimo dico <lb xml:id="p1z6"/>et sentio te boni pastoris officio functum <lb xml:id="p1z7"/>esse.</s>
					<s n="4" xml:lang="la">Sis ergo pacato et quieto animo; dominus <lb xml:id="p1z8"/>omnes illas turbas feliciter componet.</s>
				</p>
				<p>
					<s n="5" xml:lang="de">Ir müs<lb xml:id="p1z9"/>send des rumores gewhonen; die grossen herren <lb xml:id="p1z10"/>sitzend uff eyern; man mag ein kleins <lb xml:id="p1z11"/>stössli gen: sy schrygend gar lut und fürchtend <lb xml:id="p1z12"/>ir eyern.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Mitto hic responsionem, quam do <lb xml:id="p1z13"/>ad literas mihi ante octiduum excriptas.</s>
					<s n="7" xml:lang="la">Tu cura, <lb xml:id="p1z14"/>ut ei tradantur meae literae.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Curavi autem, <lb xml:id="p1z15"/>ut tuae caussae exemplum describeretur, ut vi<lb xml:id="p1z16"/>deres, quid responderem ei.</s>
					<s n="9" xml:lang="la">Cura autem tu, <lb xml:id="p1z17"/>ut tuis inclusas hoc rescriptum per proximum <lb xml:id="p1z18"/>tabellionem ad me remittas; cupio enim <lb xml:id="p1z19"/>exemplum apud me retinere.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale et sis <lb xml:id="p1z20"/>forti et imperterrito animo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Plura iam pe<lb xml:id="p1z21"/>r negotia non possum; vix haec potui.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/><placeName ref="l587">Tiguri</placeName> 20. ianuarii 1559.</s>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z23"/>Salutant <lb xml:id="p1z24"/>te mei omnes.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z25"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z26"/>Caesar venit <placeName ref="l18">Augustam</placeName> 31. decembris; <lb xml:id="p1z28"/>pauci aut nulli legati ibi fuerunt <lb xml:id="p1z29"/>8. adhuc ianuarii.</s>
					<s n="16" xml:lang="la">In itinere a<lb xml:id="p1z30"/>misit cancellarium d. Ionam, magnum <lb xml:id="p1z32"/>hostem dei et sanctorum; <lb xml:id="p1z33"/>mortuus est etc.</s>
				</p>
				<p>
					<note>[Darunter von <persName ref="p8009">Johannes Fabricius</persName> beigefügt:]</note>
					<s n="17" xml:lang="la"><lb xml:id="p1z34"/><placeName ref="l1107">Tridentinus</placeName> habet ibi legationem et alii sacrificuli etc.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><lb xml:id="p1z35"/>Ein chorherr von <placeName ref="l18">Augspurg</placeName> seit für gewüß, das diser d. <persName ref="p5378">Jonas</persName>, <lb xml:id="p1z36"/>als er vermerckt, das synes dings nütt mee gesyn, hat er zuͦ im <lb xml:id="p1z37"/>berüffen laßen ettliche herren des hoffes und dann im <lb xml:id="p1z38"/>bysyn irer vylen offenlich bekant, das er sich wider die erk<lb xml:id="p1z39"/>ant warheyt bißhar gesetzt; bitten sy, sy wö<lb xml:id="p1z40"/>llind im helfen gott <lb xml:id="p1z41"/>bitten um verzychung und sich an im <lb xml:id="p1z42"/>nitt er<lb xml:id="p1z43"/>geren etc.</s>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>ministro vigilantissimo, domino <lb xml:id="p2z4"/>et fratri colendo et dilecto.</s>
					<s n="20" xml:lang="de"><lb xml:id="p2z5"/>An h. <persName ref="p8009">Johan Schmiden</persName>, pfar<lb xml:id="p2z6"/>reren zuͦ S. Martin <lb xml:id="p2z7"/>ze <placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
