	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S[alut<lb xml:id="p1z2"/>em] d[<lb xml:id="p1z3"/>ico].</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Do<lb xml:id="p1z4"/>minus aff<lb xml:id="p1z5"/>ligit, dum ex <lb xml:id="p1z6"/>senatu ia<lb xml:id="p1z7"/>m a<lb xml:id="p1z8"/>liquant<lb xml:id="p1z10"/>o tempore <lb xml:id="p1z11"/>sustulit senes <lb xml:id="p1z12"/>et pios prude<lb xml:id="p1z13"/>ntesque vi<lb xml:id="p1z14"/>ros plu<lb xml:id="p1z15"/>rimos; nun<lb xml:id="p1z16"/>c etiam a <lb xml:id="p1z17"/>nobis av<lb xml:id="p1z18"/>ocavit <persName ref="p8111">Martyr<lb xml:id="p1z19"/>em</persName>, virum incomp<lb xml:id="p1z20"/>arabilem.</s>
					<s n="3" xml:lang="la">Mi<lb xml:id="p1z21"/>gravit hic in <lb xml:id="p1z22"/>vera <lb xml:id="p1z24"/>fide huius <lb xml:id="p1z25"/>mensis 12.<lb xml:id="p1z26"/>, <lb xml:id="p1z27"/>cum vix aliquot decubuisset dies.</s>
					<s n="4" xml:lang="la">Vehementer me turbant mortes t<lb xml:id="p1z28"/>ot virorum, quorum donis vehementer iuvari potuisset ecclesia, quam vereor abducendam <lb xml:id="p1z29"/>i<lb xml:id="p1z30"/>n fluctus graves.</s>
					<s n="5" xml:lang="la">Utinam d. <persName ref="p8417">Musculus</persName> susciperet munus respondendi <persName ref="p458">Brentio</persName> pro <persName ref="p8111">Martyre</persName> <lb xml:id="p1z31"/>in causa unionis personalis et duarum in Christo naturarum permanentium.</s>
					<s n="6" xml:lang="la">Concilium <placeName ref="l1107">Tridenti</placeName> egregie <lb xml:id="p1z32"/>procedit.</s>
					<s n="7" xml:lang="la">Venit eo <placeName ref="l691">Lothar[ingus]</placeName> card[inalis] cum praelatis <placeName ref="l832">Galliae</placeName>.</s>
					<s n="8" xml:lang="de">Sy wöllend die sach ußmachen, und <lb xml:id="p1z33"/>sind wunderbar rathschleg; das alles glaubend wir nit.</s>
					<s n="9" xml:lang="de">Gott thuͤye[?] uns die <lb xml:id="p1z34"/>ougen auf.</s>
					<s n="10" xml:lang="de">Sunst fürcht ich eines grossen falls etc.</s>
					<s n="11" xml:lang="de">Die von <placeName ref="l646">Glariß</placeName> sind aber <lb xml:id="p1z35"/>gestillet biß auf den tag zuͦ <placeName ref="l21">Baden</placeName> 3. ianuarii, dahin sy aufzogen.</s>
					<s n="12" xml:lang="de"><persName ref="p8108">Tschudi</persName> ist von inen <lb xml:id="p1z36"/>zogen gen <placeName ref="l968">Rapperschwil</placeName>.</s>
					<s n="13" xml:lang="la">Non bonum praesagium.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Insuavem vivo vitam; sed quia domino ita <lb xml:id="p1z37"/>placet, propter dominum sustineo.</s>
					<s n="15" xml:lang="la">Inservivi iam ecclesiae ad 40 fere annos, coepi enim in mense ianuario anni 1523<lb xml:id="p1z38"/>.</s>
					<s n="16" xml:lang="la">Cuperem itaque ex <lb xml:id="p1z39"/>animo, ut dominus l<lb xml:id="p1z40"/>i<lb xml:id="p1z41"/>bera<lb xml:id="p1z42"/>ret me et a<lb xml:id="p1z43"/>d se in regnum e<lb xml:id="p1z45"/>ius evocaret.</s>
					<s n="17" xml:lang="la">Sequerer voca<lb xml:id="p1z47"/>ntem animo l<lb xml:id="p1z48"/>aetissimo.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z49"/>Sed fiat voluntas <lb xml:id="p1z50"/>dom<lb xml:id="p1z51"/>ini.</s>
					<s n="19" xml:lang="la" ana="farewell">In hoc vale.</s>
				</p>
				<p>
					<note type="address">[Ohne Adresse.]<note xml:id="fna" type="footnote" n="a"><hi>Datum, Unterschrift und Adresse wurden vom Abschreiber durch einen Vermerk am Briefanfang ersetzt:</hi> Idem eidem. <placeName ref="l587">Tiguro</placeName> Bernam. 27. novembris 1562.</note></note>
				</p>
			</div>
		</body>
