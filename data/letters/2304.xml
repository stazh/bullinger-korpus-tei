	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>In summa: veniendum putavi huc clanculum, <lb xml:id="p1z2"/>nec poenitet.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Discedam paulo post.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Multus de te sermo cum <persName ref="p8296">Bassafon<lb xml:id="p1z4"/>taneo</persName>, qui scripserat et postea <lb xml:id="p1z5"/>narravit invenisse te in silva apost<lb xml:id="p1z6"/>olice et te omnino magni facit.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/><placeName ref="l294">Locarnenses</placeName> accusabantur utpote ana<lb xml:id="p1z8"/>baptistę, sed certe immerito.</s>
					<s n="5" xml:lang="la">Itaque scr<lb xml:id="p1z9"/>ipsi illis hic fidei confessionem, <lb xml:id="p1z10"/>quam ad te mitto.</s>
					<s n="6" xml:lang="la">Ostende istic, <lb xml:id="p1z11"/>si videtur, senatoribus aut coram <lb xml:id="p1z12"/>de illis pollicearis.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale et <lb xml:id="p1z13"/>salve.</s>
					<s n="8" xml:lang="la">Ora pro me.</s>
					<s n="9" xml:lang="la"><placeName ref="l21">Badae</placeName> 7. <lb xml:id="p1z14"/>iunii 1554.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori<lb xml:id="p2z4"/>.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
