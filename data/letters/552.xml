	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">En extorsi tandem, diu abs te desideratam <lb xml:id="p1z2"/>Apocham a <persName>Bälero</persName>.</s>
					<s n="3" xml:lang="la">Gratias is agit maximas tuis officiis.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z3"/>Quod vero praeterea scribam, nunc non habeo, quum quia <lb xml:id="p1z4"/>praeteritis diebus et frequentius et sopiosius scripsi, tum <lb xml:id="p1z5"/>quod ocii non multum supersit.</s>
					<s n="5" xml:lang="la">Proinde te gratiae domini comm<lb xml:id="p1z6"/>endo una cum uxore et liberis tuis.</s>
					<s n="6" xml:lang="la">Congratulor <lb xml:id="p1z7"/><persName ref="p7228">Zvinglio</persName> de sua vocatione et conditione.</s>
					<s n="7" xml:lang="la">Excitet in ipso dominus <lb xml:id="p1z8"/>spriritum paternum, ut ecclesiae huic tam sit ornamento et uti<lb xml:id="p1z9"/>litati, quantum fuit ipsius pater!</s>
					<s n="8" xml:lang="la" ana="salute">Salutat vos mea uxor <lb xml:id="p1z10"/>et <persName ref="p8417">Musculus</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z11"/><placeName ref="l41">Bernae</placeName> 7. Iunii 1549 <persName ref="p8018">I<lb xml:id="p1z12"/>[oannes] Hallerus</persName>, ex animo <lb xml:id="p1z13"/>tuus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p8440">Gervasium</persName> commendare potes <placeName>Agroviensibus</placeName>, penes quos <lb xml:id="p1z15"/>ministri est electio.</s>
					<s n="11" xml:lang="la">Faciam idem ego.</s>
				</p>
				<p>
					<note>[Adresse auf der Rückseite?:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo celeberrimoque viro D. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, fidelissimo <placeName ref="l587">Tigurinae</placeName> ecclesiae praesuli, domino <lb xml:id="p2z3"/>suo et compatri venerando.</s>
					<s n="13" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
