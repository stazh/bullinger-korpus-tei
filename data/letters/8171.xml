	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi tuas, dilecte frater, ac gratulor tibi, <lb xml:id="p1z2"/>quod dominus nova te prole parentem fecerit; dominus <lb xml:id="p1z3"/>idem benedicat ei tibique et uxori, quam incolumem <lb xml:id="p1z4"/>peperisse gaudeo.</s>
					<s n="3" xml:lang="la">Toties vero expertus, quid sit <lb xml:id="p1z5"/>augeri liberis et habere puerperam et quanta <lb xml:id="p1z6"/>incumbant negotia, facile tibi condono, qui sis scribendo <lb xml:id="p1z7"/>brevior.</s>
					<s n="4" xml:lang="la">Literas <placeName ref="l28">Basileam</placeName> destinatas per primum <lb xml:id="p1z8"/>quemque tutum tabellionem expediam; <lb xml:id="p1z9"/>sensi enim pecunias esse inclusas, unde intelligo <lb xml:id="p1z10"/>maiore fide opus esse et diligentia.</s>
					<s n="5" xml:lang="la">Faciam <lb xml:id="p1z11"/>ergo, quod potero.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute"><persName ref="p8057">Campellum</persName> et ordine omnes, quos <lb xml:id="p1z12"/>mihi commemoras, oro ut familiarissime resaluta<lb xml:id="p1z13"/>re digneris.</s>
					<s n="7" xml:lang="la">Literas accepi satis copiosas <lb xml:id="p1z14"/><placeName ref="l301">Lugduno</placeName>, <placeName ref="l167">Geneva</placeName>, <placeName ref="l41">Berna</placeName>, <placeName>Nerobergo</placeName>, <placeName ref="l210">Heydelberga</placeName> <lb xml:id="p1z15"/>et aliunde.</s>
					<s n="8" xml:lang="la">Summa omnium agitari de comitiis im<lb xml:id="p1z16"/>perialibus <placeName ref="l18">Augustam Vindelicorum</placeName> conscribendis, quae <lb xml:id="p1z17"/>alii quidem processura putent certo, alii abdubitent.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/>Ego propter res <placeName ref="l2510">Turcicas</placeName> aliquando indicendas puto, <lb xml:id="p1z19"/>nisi iam sunt indictae.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l21">Badam</placeName> quoque ad 26. huius <lb xml:id="p1z20"/>mensis generalia Helvetiorum comitia a nostris sunt <lb xml:id="p1z21"/>conscripta, ut scis.</s>
					<s n="11" xml:lang="la">In <placeName ref="l832">Gallia</placeName> scribunt in hybernis <lb xml:id="p1z22"/>agere admirallium non procul a <placeName ref="l1250">Tolosa</placeName>; regios <lb xml:id="p1z23"/>sese accingere et reniti illis; regem <placeName ref="l378">Lutetiae</placeName> esse; <lb xml:id="p1z24"/>agitari de pace, quam alii dolosam fore suspicantur, <lb xml:id="p1z25"/>alii tollerabilem, quod utraque pars bello sit fatigata.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z26"/>Dominus concedat bonam pacem!</s>
					<s n="13" xml:lang="la"><persName ref="p6789">Albanus</persName> in <placeName ref="l808">Belgio</placeName> saevit <lb xml:id="p1z27"/>inhumaniter.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Creditur seditionem in <placeName ref="l830">Anglia</placeName> excitasse <lb xml:id="p1z28"/>aliis quoque adiuvantibus.</s>
					<s n="15" xml:lang="la"><placeName ref="l2590">Northumbrus</placeName> collegerat ad <lb xml:id="p1z29"/>18000 seditiosorum contra reginam.</s>
					<s n="16" xml:lang="la">Haec supra 30000 <lb xml:id="p1z30"/>duxit; priusquam confligeret, pacem obtulit et veniam <lb xml:id="p1z31"/>omnibus reversis domum.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Ergo plus quam 3. pars <lb xml:id="p1z32"/>defecit a <placeName ref="l2590">Northumbro</placeName>; alii et residui dicuntur <lb xml:id="p1z33"/>dilapsi, authores malorum in arce quadam obsessi.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z34"/><placeName ref="l2590">Northumbrus</placeName> tamen captivus ductus est in turrim <placeName ref="l296">Londinensem</placeName>.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z35"/>Dicitur seditio compressa.</s>
					<s n="20" xml:lang="la">In <placeName ref="l875">Hispania</placeName> feliciter <lb xml:id="p1z36"/><persName>Mauri</persName> dicuntur procedere, rex <persName>Madrillo</persName> derelicto <lb xml:id="p1z37"/>progredi <placeName>Cordubam</placeName>, grandem magistrum <placeName ref="l2523">Maltae</placeName> ab <lb xml:id="p1z38"/><placeName ref="l875">Hispano</placeName> petere auxilium.</s>
					<s n="21" xml:lang="la">Huius generis infinita sunt <lb xml:id="p1z39"/>alia, quae scribere non vacat.</s>
					<s n="22" xml:lang="la">Oremus dominum, ut <lb xml:id="p1z40"/>nostri misereatur.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Dominus tecum.</s>
					<s n="24" xml:lang="la">Festinantissime has <lb xml:id="p1z41"/>scripsi.</s>
					<s n="25" xml:lang="la" ana="salute">Saluta etiam doctorem <persName ref="p2776">Ruinellam</persName>.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 10. <lb xml:id="p1z42"/>februarii 1570.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p1z43"/>Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <lb xml:id="p2z2"/><persName ref="p8016">Tobiae Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae <lb xml:id="p2z4"/>fideli ministro, domino <lb xml:id="p2z5"/>meo honorando <lb xml:id="p2z6"/>et fratri charissimo.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><lb xml:id="p2z7"/>Chur.</s>
				</p>
			</div>
