	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nihil possum nunc addere his, quae heri per archigrammate<lb xml:id="p1z2"/>um vestrum scripsi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Is hodie demum discessit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Interea <lb xml:id="p1z3"/>tuas per <persName>Tumisium</persName> missas accepi.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Illorum causa hodie <lb xml:id="p1z4"/>audita est, sed nihildum decisum.</s>
					<s n="6" xml:lang="la">Cras audientur testes.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z5"/>Metuo, ne nimium diserte adolescens ille se obstrinxerit.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z6"/>Nihil tamen fiet praeter aequum et iustum, et quod leges nostrae <lb xml:id="p1z7"/>ferre poterunt.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Eventum audies ex illis.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Mitto per <lb xml:id="p1z8"/>illos literas hasce a <persName ref="p4060">Ludovico Zehendero</persName> et <persName ref="p8351">Frischinga</persName> mihi <lb xml:id="p1z9"/>traditas; non potui per tutiores mittere nuncios.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Si <lb xml:id="p1z10"/>quid tu interea amplius acceperis, cupio cognoscere.</s>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z11"/>Bene vale.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Salutant te amici nostri omnes, praesertim <lb xml:id="p1z12"/><persName ref="p4060">Zehenderi</persName> tui simul et mei.</s>
					<s n="14" xml:lang="la"><placeName ref="l41">Bernae</placeName> 2. augusti 60.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z13"/>Proxima lunę aut Martis <placeName ref="l280">Lausannam</placeName> proficiscar.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><persName ref="p8018">I[oan<lb xml:id="p1z14"/>nes] Hallerus</persName> tuus <lb xml:id="p1z15"/>ex animo.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrych<lb xml:id="p2z2"/>o Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori <lb xml:id="p2z4"/>fidelissimo, domino suo <lb xml:id="p2z5"/>honorando et compatri <lb xml:id="p2z6"/>charissimo.</s>
					<s n="18" xml:lang="de"><lb xml:id="p2z7"/>M. <persName ref="p495">Heinrych Bullinger</persName> <lb xml:id="p2z8"/>zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
