	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi ad te 28. Martii per <persName ref="p8393">Hieronymi Empori</persName> filium <lb xml:id="p1z2"/>cum literis, quas cupiebam per legatos vestros <placeName ref="l28">Basiliensium</placeName> legatis <lb xml:id="p1z3"/>reddi, ut per illos nobili matronę a Schönaugia perferrentur.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Eas an acceperis, scire vehementer aveo.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Nihil prorsus iam est <lb xml:id="p1z5"/>extra illa, quę literis illis significavi, quod ad te perscribam.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Tu dominum constanter pro nobis interpella, ut ne tolerabile hoc <lb xml:id="p1z7"/>nostrum exilium novis oneribus gravet.</s>
					<s n="6" xml:lang="la">Frater nondum rediit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute"><lb xml:id="p1z8"/>Salutant te tuamque domum uxor me[a] cum sorore.</s>
					<s n="8" xml:lang="la" ana="salute">Salveant amici <lb xml:id="p1z9"/>omnes et fratres.</s>
					<s n="9" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Calendis Aprilis 1549.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z10"/>Literas ad <persName ref="p8440">Gervasium</persName> cum mihi inscriptis sero recepi.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z11"/>T[uus] <persName ref="p8055">Ambr[osius] Bl[aurerus]</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho Bullingero</persName> <lb xml:id="p2z2"/>suo.</s>
					<s n="14" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
