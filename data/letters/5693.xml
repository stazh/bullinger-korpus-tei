	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Haec tibi bona fide remitto, simul <lb xml:id="p1z2"/>etiam maximas tibi gratias ago.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Et ut ali<lb xml:id="p1z3"/>quid rependam, conditiones<note type="misc">-tionis!</note> vel articu<lb xml:id="p1z4"/>los pacis mitto, ita ut heri ex <placeName ref="l167">Geneva</placeName> <lb xml:id="p1z5"/>accepi.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Scribit <persName ref="p8033">Beza</persName> <placeName ref="l367">Aurelia</placeName> 29. martii <lb xml:id="p1z6"/>admiraldum in deditionem accepisse omnes <lb xml:id="p1z7"/>in <placeName ref="l2770">Normandia</placeName> gentes, <placeName>Brittones</placeName>, <placeName ref="l1867">Picta<lb xml:id="p1z8"/>vos</placeName>, <placeName>Cenomannos</placeName>, <placeName ref="l1497">Turones</placeName> et reliquos c<lb xml:id="p1z9"/>is <lb xml:id="p1z10"/>Sequanam et instructum maxime equitatu et peditatu <lb xml:id="p1z11"/>ascendisse, ut <placeName ref="l367">Aureliam</placeName> obsidione solverent; <lb xml:id="p1z12"/>in itinere obviam habuisse cursores, qui <lb xml:id="p1z13"/>pacem factam nunciarint.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z14"/>An vero haec pax ita sit accipienda, <lb xml:id="p1z15"/>intelligo dubitare plurimos; si quid <lb xml:id="p1z16"/>certius accepero, faciam, ut noris.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/><placeName ref="l587">Tiguri</placeName> 18. aprilis 1563.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z18"/>Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/>Non est, quod tibi d. <persName ref="p4037">Hieronymum Zanchum</persName> <lb xml:id="p1z20"/>commendem, scio illum tibi commendatissimum; <lb xml:id="p1z21"/>habet is pacis <placeName ref="l832">Gallicae</placeName> capita.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z22"/>Miror, quid magistratus dixerit et quomodo <lb xml:id="p1z23"/>acceperit literas magistratus nostri, quibus <lb xml:id="p1z24"/>commendavit causam <persName>Pellizariorum</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z25"/>De tua quoque caussa cupio audire omnia.</s>
					<s n="12" xml:lang="la">Dicis: "<lb xml:id="p1z26"/>Utinam modo alio egissetis."</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Ego vero dico <lb xml:id="p1z27"/>nos, qui examinatores vocamur, pro more <lb xml:id="p1z28"/>nostro te nominasse inter deputandos etc., non autem <lb xml:id="p1z29"/>iussisse, ut magistratus noster scribat ad vestrum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z30"/>Nostrum non est illi praescribere aut, quod decrevit, <lb xml:id="p1z31"/>infringere.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Quid ergo egissemus?</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Nulla <lb xml:id="p1z32"/>nobis potestas mera est.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Et quod te nominavimus, <lb xml:id="p1z33"/>arbitror nominasse iustas ob caussas, ut ex priore <lb xml:id="p1z34"/>intelligis scripto etc.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabricio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>pastori, domino colendo et <lb xml:id="p2z4"/>fratri charissimo meo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z5"/>Chur.</s>
				</p>
			</div>
		</body>
	</text>
