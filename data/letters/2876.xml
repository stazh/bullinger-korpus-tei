	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia Christi tecum.</s>
					<s n="2" xml:lang="la">Tametsi nuntius ille celeriter <lb xml:id="p1z2"/>abituriret, tamen impetraui tantum spacioli, dum <lb xml:id="p1z3"/>salutatorias scriberem etc.</s>
					<s n="3" xml:lang="la">- Captiuum concionatorem <lb xml:id="p1z4"/>nondum vidimus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Scripserunt pro illo <placeName ref="l28">Basilienses</placeName>; item <lb xml:id="p1z5"/>et noste<lb xml:id="p1z6"/>r ille missa legatione pręfecto nobili <lb xml:id="p1z7"/>ex <placeName ref="l327">Montbelgardo</placeName> rogauit liberationem boni hominis, <lb xml:id="p1z8"/>sed nil effectum est.</s>
					<s n="5" xml:lang="la">Fama certe crebescit magis <lb xml:id="p1z9"/>et magis, missum <placeName>Vesontium</placeName>.</s>
					<s n="6" xml:lang="la">Quod si verum fuerit, <lb xml:id="p1z10"/>certo imminebit illi vitę periculum etc.</s>
					<s n="7" xml:lang="la">Orate <lb xml:id="p1z11"/>pro illo, ut constans Christi martir fiat etc.</s>
					<s n="8" xml:lang="la">Orate pro illo, ut constans C<lb xml:id="p1z12"/>hristi martir fiat etc.</s>
					<s n="9" xml:lang="la">Sic itur ad astra.</s>
					<s n="10" xml:lang="la">- Copiosiora per <persName>Heinium</persName> nostrum, <lb xml:id="p1z13"/>postquam lassus remiserit longum illum bidentem <lb xml:id="p1z14"/>in sequentem annum, accipies et forte certiora.</s>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z15"/>Vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Raptim 30. Martii 1536.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z16"/>T[uus] <persName ref="p1010">Erbius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio viro <lb xml:id="p2z2"/>ac domino <persName ref="p495">Henricho <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/><placeName ref="l587">Tigurino</placeName> <lb xml:id="p2z5"/>ecclesiaste, fratri <lb xml:id="p2z6"/>ac patrono o<lb xml:id="p2z7"/>bservando.</s>
				</p>
			</div>
		</body>
	</text>
