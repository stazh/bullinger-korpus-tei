	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia Christi tecum.</s>
					<s n="2" xml:lang="la">Epistolam tuam una cum <lb xml:id="p1z2"/>duabus declamationibus per <persName ref="p8009">Ioannem Fabritium</persName>, <lb xml:id="p1z3"/>virum pietate et eruditione eximium, accepi.</s>
					<s n="3" xml:lang="la">Ago <lb xml:id="p1z4"/>tibi gratias immortales, vir doctissime, atque ut vellem, <lb xml:id="p1z5"/>ita optarem, ut et possem id tibi cumu<lb xml:id="p1z6"/>latius referre.</s>
					<s n="4" xml:lang="la">Stipendiarii duo a <placeName ref="l280">Lausanensibus</placeName> <lb xml:id="p1z7"/>revocati in obscuro carcere philosophantur iam <lb xml:id="p1z8"/>biduo vescentes pane hordeaceo et potantes aquam <lb xml:id="p1z9"/>ob plura commissa.</s>
					<s n="5" xml:lang="la">Cras forte liberati stabunt <lb xml:id="p1z10"/>in duro examine procerum; postea <placeName ref="l512">Tubingam</placeName> <lb xml:id="p1z11"/><persName ref="p1055">Martino Frechto</persName> ex principis iussu commendabuntur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Maluissem vestrę theologię, imo syncerioris <lb xml:id="p1z13"/>quam illic a quibusdam tractatur, futuros <lb xml:id="p1z14"/>auditores; sed sententia procerum ducatus pręvaluit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Missa rursum abrogabitur in tota ditione <placeName ref="l572">Wirtembergensi</placeName>, <lb xml:id="p1z16"/>ut facile intelligis, ex schedula et <lb xml:id="p1z17"/>autographo principis, quod litteris nuper kalendis <lb xml:id="p1z18"/>septembris datis<note type="margin">a.R.: datas!</note> inclusit.</s>
					<s n="8" xml:lang="la">Heri nobilis noster <lb xml:id="p1z19"/>pręfectus retulit esse abrogatam, sed quo modo <lb xml:id="p1z20"/>vel ratione, ignoro; quodsi rescivero, te certiore<lb xml:id="p1z21"/>m fatiam.</s>
					<s n="9" xml:lang="la">Princeps lavat in thermis <placeName ref="l195">Gep<lb xml:id="p1z22"/>pingensibus</placeName>.</s>
					<s n="10" xml:lang="la"><persName ref="p18538">Cęsaris</persName> profectionem ad <placeName ref="l491">Argentoratenses</placeName>, <lb xml:id="p1z23"/>quam habeo ex doctore <persName>Paulo Helio</persName>, <lb xml:id="p1z24"/>qui hic agit vindemiam, ad te nunc dedi.</s>
					<s n="11" xml:lang="la">Si <lb xml:id="p1z25"/>ex <persName ref="p8374">Hedione</persName> plura, cui ob id scripsi, recepero, <lb xml:id="p1z26"/>id et tibi communicabo.</s>
					<s n="12" xml:lang="la"><persName ref="p18538">Caesar</persName> non est procul <lb xml:id="p1z27"/>a <placeName ref="l2345">Keisersluther</placeName>.</s>
					<s n="13" xml:lang="la">Metuunt, ne in <placeName ref="l632">Alsatia</placeName>, si <lb xml:id="p1z28"/>a <placeName ref="l832">Gallo</placeName> fugatus fuerit, hybernet; reliquę <lb xml:id="p1z29"/>enim provintię propemodum omnes sunt exhaustę.</s>
					<s n="14" xml:lang="la">Fiat <lb xml:id="p1z30"/>domini voluntas; merentur enim ista peccata nostra <lb xml:id="p1z31"/>et impoenitentia.</s>
					<s n="15" xml:lang="la">O bone deus, serva ecclesiam <lb xml:id="p1z32"/>Christi etc.</s>
					<s n="16" xml:lang="la">Raptim.</s>
					<s n="17" xml:lang="la"><placeName ref="l411">Richenvillę</placeName> 27. septembris 1552.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z33"/>T[uus] e<lb xml:id="p1z34"/>x animo <lb xml:id="p1z35"/><persName ref="p1010">Matthias Erbius</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio viro pietate <lb xml:id="p2z2"/>et eruditione d. <lb xml:id="p2z3"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z4"/>theologo et antistiti <lb xml:id="p2z5"/>ecclesię <placeName ref="l587">Tigurinę</placeName>, <lb xml:id="p2z6"/>domino suo semper <lb xml:id="p2z7"/>observando.</s>
				</p>
			</div>
		</body>
