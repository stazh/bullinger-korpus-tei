	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ad te scripsi per d. <persName ref="p8009">Fabricium</persName> me omnes tuas literas recepisse.</s>
					<s n="3" xml:lang="la">Videbis, que de <placeName ref="l882">Ungaria</placeName> feruntur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z2"/>Accepi advenisse <persName ref="p18575">Philippo</persName> multas naves ex <placeName ref="l2898">India</placeName> et <placeName ref="l3739">Nova Hispania</placeName> plenas auro et argento.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z3"/>Ea res illum forsan magis inflatum et alienum reddit ab honesta pace.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ea fruemur, quando <lb xml:id="p1z4"/>dominus volet.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Salutabis d. d. <persName ref="p8011">Galterum</persName> et <persName ref="p8111">Martirem</persName> et valebis.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l760">Solut[uri]</placeName> 2. decembris.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Tuus ex <lb xml:id="p1z5"/>animo.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Reginam <placeName ref="l830">Anglie</placeName> mortuam esse certum est et reginam <placeName ref="l882">Ungarie</placeName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z6"/><persName ref="p18477">Ferdinandus</persName> electus imperator est in extremis aut obiit.</s>
				</p>
				<p>
					<note>[Von anderer Hand?]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tigurine</placeName> eclesie pastori.</s>
				</p>
			</div>
		</body>
	</text>
