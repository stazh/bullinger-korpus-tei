	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Magna nos affecit voluptate schedula haec, quam <lb xml:id="p1z2"/>hic per eundem, per quem eam ad nos misisti, remitto.</s>
					<s n="3" xml:lang="la">Non <lb xml:id="p1z3"/>dubito de domini auxilio, modo esset aliquis, qui in illud confideret.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Sed antiquam illud experiamur, desperamus prius omneque robur animi amittimus.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Interea apud nos nihil est memoratu dignum, quod non scripserim antea.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/>Pestis cessavit; non cessant tamen causae, propter quas eam dominus nobis immittit, <lb xml:id="p1z7"/>scelera scilicet, avaritia, libido, invidia et petulantia, unde metuo <lb xml:id="p1z8"/>flagellum, cum virgo nihil effecit in nobis.</s>
					<s n="7" xml:lang="la">Dominus det nobis spiritum <lb xml:id="p1z9"/>poenitentiae et precum.</s>
					<s n="8" xml:lang="la">Amen.</s>
					<s n="9" xml:lang="la">Dominus tibi tuisque omnibus annum <lb xml:id="p1z10"/>hunc faciat auspicatissimum et foelicissimum!</s>
					<s n="10" xml:lang="la" ana="salute">Salutant vos mei omnes et <lb xml:id="p1z11"/><persName ref="p8417">Musculus</persName> cum suis omnibus.</s>
					<s n="11" xml:lang="la"><placeName ref="l41">Bernae</placeName> 23. decembris 1550.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z12"/>T[uus] in domino totus <persName ref="p8018">I[o<lb xml:id="p1z13"/>annes] Hallerus</persName>.</s>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, domino <lb xml:id="p2z3"/>et compatri suo venerando.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
