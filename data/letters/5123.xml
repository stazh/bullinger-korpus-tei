	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Unnsern fründtlichenn gruͦs und alles guͦts zuͦvorn
					<lb xml:id="p1z2"/>Ersamer, hochgelerter, günstiger, lieber herr und guͦter
					<lb xml:id="p1z3"/>frund. Unns hat der edell vest unnser
					<lb xml:id="p1z4"/>getruwer, lieber mittkhat Miclaus von Dießbach
					<lb xml:id="p1z5"/>ettliche nüwe zytungenn, ime von ucf und üch
					<lb xml:id="p1z6"/>vonn dem hochgebornen fürsten und hern hern
					<lb xml:id="p1z7"/>Philipp landtgraffen zu Hessenn und anderßwohar
					<lb xml:id="p1z8"/>zugeschickt, sachennhalb gegennwurtiger löuggenn
					<lb xml:id="p1z9"/>gmeynen stadt und besonnders der religion belan
					<lb xml:id="p1z10"/>fürgelegt, unnd darnäbenn uns ouch bericht
					<lb xml:id="p1z11"/>was ir ime derohalb wyther zuͦgeschribenn.
					<lb xml:id="p1z12"/>darab wir höchst wolgevallens unnd befröuwenns
					<lb xml:id="p1z13"/>obgedachts hern landtgraffenn unnd üwers geneigt
					<lb xml:id="p1z14"/>guͦterm willens und getrüwenn uffechens halb
					<lb xml:id="p1z15"/>so ir zuͦ uns tragend empfangenn. Sagenn
					<lb xml:id="p1z16"/>hart üch und vorab ir fürstlichenn gnad durch
					<lb xml:id="p1z17"/>ein sonderbar byligend schrybenn an sy, (so wir
					<lb xml:id="p1z18"/>üch bittend iro by verhäbner, aber doch gwüsser
					<lb xml:id="p1z19"/>bottschafft zeüberschickenn) vlyssigenn hochen danck
					<lb xml:id="p1z20"/>Unnd bittennd uch, ir wöllind zn sollichem üwern
					<lb xml:id="p1z21"/>gutenn willenn beharren und uns federzyt, alles deß
					<lb xml:id="p1z22"/>so ir sollicher sachenn halb, da und anderscwogarv
					<lb xml:id="p1z23"/>nmögend, unserm vertrüwen nach theilhafftig
					<lb xml:id="p1z24"/>machenn. Sind wir urbüttig söllichs umb üch
					<lb xml:id="p1z25"/>gantz fründtlich ze beschuldenn. Damit sind gott
					<lb xml:id="p1z26"/>dem herrn trüwlich bevolchenn. Datum 3. ianuarii
					<lb xml:id="p1z27"/>1562.
					<lb xml:id="p1z28"/>schulths und rhat.
					<lb xml:id="p1z29"/>zuͦ Bernn.
					<pb/>
					<lb xml:id="p2z1"/>ein hochgelertenn, achtbaren, er
					<lb xml:id="p2z2"/>würdigenn herrn Heynrich Bullinger,
					<lb xml:id="p2z3"/>dienern der kilchenn zu Zürich
					<lb xml:id="p2z4"/>unnserm liebenn herrenn und guten
					<lb xml:id="p2z5"/>frynd.
					<lb xml:id="p2z6"/>
					<lb xml:id="p2z7"/>.
				</p>
			</div>
		</body>
