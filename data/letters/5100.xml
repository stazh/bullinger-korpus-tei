	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salutem.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Miror, qui fiat, quod tanto tempore nihil a te <lb xml:id="p1z2"/>acceperim.</s>
					<s n="3" xml:lang="la">Verebar, ne non prospera valetudo in causa <lb xml:id="p1z3"/>esset, nisi hisce diebus per d. <persName ref="p8055">Ambrosium Blaurerum</persName> <lb xml:id="p1z4"/>meliora de te audissem.</s>
					<s n="4" xml:lang="la">Misi heroinę a <placeName ref="l404">Rapoltstein</placeName> <lb xml:id="p1z5"/>libros; sed negligentia vectorum factum est, ut duo postremi <lb xml:id="p1z6"/>quaterniones in Apocalipsi sint viciati; itaque petit domina, <lb xml:id="p1z7"/>ut mittas mihi duas quaterniones illas, quo defectum <lb xml:id="p1z8"/>complere possit.</s>
					<s n="5" xml:lang="la">Mittit domina cum literis suis capsellam aut <lb xml:id="p1z9"/>nescio quid papyro inclusum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Raptim.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/><placeName ref="l28">Basileę</placeName> 20. decembris 1561.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z11"/>Nihil novi, quid scribam, habeo.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z12"/>Tuus <persName ref="p1754">Ioannes Iungi<pb/><lb xml:id="p2z1"/>us</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z2"/>Praestantissimo viro <lb xml:id="p2z3"/>domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z4"/>domino suo observando <lb xml:id="p2z5"/>fratrique charissimo.</s>
					<s n="12" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
