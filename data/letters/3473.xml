	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto tibi, honorande pater et compater, per <lb xml:id="p1z2"/>hunc cursorem vestrum praefationes tuas versas, <lb xml:id="p1z3"/>ut illas inspicias; addidi illis etiam symbola, quae, <lb xml:id="p1z4"/>praeterquam quod in se difficultatis multum habent, <lb xml:id="p1z5"/>tumultuarie et festinanter admodum heri demum <lb xml:id="p1z6"/>et hodie a me versa sunt.</s>
					<s n="3" xml:lang="la">Si videntur tibi operi <lb xml:id="p1z7"/>adiungenda, fiat, sin minus, omittantur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Re<lb xml:id="p1z8"/>mitto etiam praefationem meam, cui praeter ea, quorum <lb xml:id="p1z9"/>tu admonuisti, alia etiam quaedam addidi, quo membra <lb xml:id="p1z10"/>omnia plenius sibi mutuo responderent, uti videbis; <lb xml:id="p1z11"/>si quid addere aut decidere tibi placuerit, per <lb xml:id="p1z12"/>me licet.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Mitto autem propterea, quod <persName ref="p4191">Apiarius</persName> <lb xml:id="p1z13"/>ea imprimere non potest; non enim poterit, <lb xml:id="p1z14"/>quod dudum praedixi, ante nundinas opus ip<lb xml:id="p1z15"/>sum uno tantum prelo absolvere, et quamvis in <lb xml:id="p1z16"/>tempore monitus sit, alterum tamen nondum ador<lb xml:id="p1z17"/>nare voluit.</s>
					<s n="6" xml:lang="la">Nunc <placeName ref="l28">Basilęam</placeName> est profectus; quid <lb xml:id="p1z18"/>agat, nescio, pluresne adducturus sit typo<lb xml:id="p1z19"/>graphicos famulos necne.</s>
					<s n="7" xml:lang="la">Operę ergo precium <lb xml:id="p1z20"/>erit, ut <persName ref="p1227">Froschouerus</persName> et haec et fortassis etiam <lb xml:id="p1z21"/>operis partem imprimat, si ante nundinas <lb xml:id="p1z22"/>absolutum velit opus<note type="margin">dazu a.R.: "Ideo non opus erit, ut remittas mihi."</note>.</s>
					<s n="8" xml:lang="la">Indices etiam requirent <lb xml:id="p1z23"/>aliquot dierum laborem.</s>
					<s n="9" xml:lang="la">Scribo ipse quoque ea de re ad <lb xml:id="p1z24"/><persName ref="p1227">Froschouerum</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Terniones nunc nullos propter <persName ref="p4191">Apiarii</persName> <lb xml:id="p1z25"/>absentiam mitto.</s>
					<s n="11" xml:lang="la">Versantur tamen nunc in ternion<lb xml:id="p1z26"/>e postremo secundi alphabeti.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z27"/>Titulum iuxta praescriptum tuum una aut alte<lb xml:id="p1z28"/>ra tantum voce mutata formavi et voces <lb xml:id="p1z29"/>displicentes tibi omisi.</s>
					<s n="13" xml:lang="la">Addidi etiam quędam de tuis <lb xml:id="p1z30"/>praefationibus, symbolis item et mea praefatione, <lb xml:id="p1z31"/>quę pro arbitrio tuo aut mutabis aut delebis <lb xml:id="p1z32"/>prorsus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Si quid amplius facto opus sit, me <lb xml:id="p1z33"/>admonebis in tempore.</s>
					<s n="15" xml:lang="la">Novi nihil habeo, prae<lb xml:id="p1z34"/>terquam quod dominica praeterita et <placeName ref="l167">Genevę</placeName> et hic foedus <lb xml:id="p1z35"/>sacramento confirmatum est.</s>
					<s n="16" xml:lang="la">Faxit dominus, ut sit hoc <lb xml:id="p1z36"/>omnibus nobis faustum et foelix!</s>
					<s n="17" xml:lang="la"><persName>Gallus</persName> videtur <lb xml:id="p1z37"/>plures petiturus milites.</s>
					<s n="18" xml:lang="la"><persName ref="p8417">Musculus</persName> non satis <lb xml:id="p1z38"/>bene valet propter tussim acrem satis.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">In agro <lb xml:id="p1z39"/><placeName ref="l150">Ferrariensi</placeName> <placeName ref="l862">Helvetios</placeName> relictos cum <placeName ref="l875">Hispanis</placeName> con<lb xml:id="p1z40"/>flixisse ferunt, sed nescimus, quam sit certum.</s>
					<s n="20" xml:lang="la">Ex <placeName ref="l378">Lutetia</placeName> <lb xml:id="p1z41"/>de captivis nihil certi habemus.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Expecto tuas <lb xml:id="p1z42"/>quotidie.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="salute">Vale cum tuis omnibus foeliciter; nostri <lb xml:id="p1z43"/>te salutant.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><placeName ref="l41">Bernae</placeName> 12. ianuarii 1558.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><persName ref="p8018">H[allerus]</persName> tuus.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>fidelissimo pastori, domino <lb xml:id="p2z4"/>et compatri suo omnibus <lb xml:id="p2z5"/>modis honorando.</s>
				</p>
			</div>
