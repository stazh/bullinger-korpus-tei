	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Magis scribo (reverende in Christo pater), ut <lb xml:id="p1z2"/>morem meum servem, quam ut habeam, <lb xml:id="p1z3"/>de quibus te edoceam.</s>
					<s n="3" xml:lang="la"><persName>Philippi</persName> legatus nondum <lb xml:id="p1z4"/>rediit; qui utinam non redeat, ne turbarum <lb xml:id="p1z5"/>sit author!</s>
					<s n="4" xml:lang="la">Quid <persName>Galli</persName> legatus petat, ex <lb xml:id="p1z6"/>illis intellexisti, quos misi.</s>
					<s n="5" xml:lang="la">Cum legato ipse <lb xml:id="p1z7"/>nondum collocutus sum, licet interim <lb xml:id="p1z8"/>secundo me ad convivium evocarit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ego <lb xml:id="p1z9"/>enim biduum non satis recte habui; sed dei <lb xml:id="p1z10"/>gratia nunc convalesco.</s>
					<s n="7" xml:lang="la">Quantum coniectura <lb xml:id="p1z11"/>assequor, foedus hoc cum <persName>Gallo</persName> redintegrabitur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/>Tu per occasionem in schedam coniicies, <lb xml:id="p1z13"/>quoniam omnino instaurandum, quibus id capitibus <lb xml:id="p1z14"/>commodissime fieri queat.</s>
					<s n="9" xml:lang="la">Ita enim mecum <lb xml:id="p1z15"/>post multam deliberationem tandem constitui: <lb xml:id="p1z16"/>me quidem, ut foedus illud faciant, authorem <lb xml:id="p1z17"/>non futurum, sed moniturum tamen, <lb xml:id="p1z18"/>postquam illuc eos perpendere intellexero, iis <lb xml:id="p1z19"/>capitibus sanciant, quae et patriae et ecclesię <lb xml:id="p1z20"/>salutaria esse possint.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Tu si aliter sentis, <lb xml:id="p1z21"/>de eo me edoce.</s>
					<s n="11" xml:lang="la">- Postquam ad legatum venire <lb xml:id="p1z22"/>non potui, scripsit literas satis humanas, <lb xml:id="p1z23"/>ex quibus simul perspexi eum non illiteratum; <pb/><lb xml:id="p2z1"/>de caetero iudicabo ex congressu.</s>
					<s n="12" xml:lang="la">Nuper certe magni <lb xml:id="p2z2"/>viri affirmarunt eum factionis esse <persName>Guisianę</persName>, <lb xml:id="p2z3"/>quibus etsi nonnullam fidem adhibeo, tamen <lb xml:id="p2z4"/>temere iudicare nolo, dum rem exactius cognovero.</s>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p2z5"/>Vale, reverende in Christo pater, cum tuis omnibus quam felicissi<lb xml:id="p2z6"/>me et diutissime.</s>
					<s n="14" xml:lang="la"><placeName ref="l98">Curię</placeName> 8. maii anno 1564.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l93">Clavennae</placeName> pestis saevissime grassatur et magis magisque ingravescit; hic apud nos salva sunt omina, <lb xml:id="p2z8"/>utinam et apud vos.</s>
					<s n="16" xml:lang="la">T[uus] <persName ref="p8009">F[abricius</persName>].</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Amplissimo viro d. <persName ref="p495">Heinrycho Bullingero</persName>, domino suo et in Christo patri <lb xml:id="p2z9"/>reverendo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>