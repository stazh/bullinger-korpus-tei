			<zone xml:id="p2z37-0" points="1637,3366 1791,3398 1887,3352 2134,3354 2168,3386 2207,3366 2296,3391 2296,3268 2107,3300 1958,3308 1857,3276 1752,3320 1637,3308">1651,3359 1683,3353 1716,3353 1748,3351 1781,3350 1813,3350 1846,3348 1878,3347 1911,3346 1943,3344 1976,3344 2009,3344 2041,3344 2074,3344 2106,3344 2139,3344 2171,3344 2204,3344 2236,3344 2269,3345 2302,3347</zone>
