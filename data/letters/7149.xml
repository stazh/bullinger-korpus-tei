	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quae de episcopis <placeName ref="l98">Curiensibus</placeName> hactenus acta <lb xml:id="p1z2"/>sint, non te latere puto, vir clarissime.</s>
					<s n="3" xml:lang="la">Di<lb xml:id="p1z3"/>ligenter tamen a d. <persName ref="p8432">Friderico S[alice]</persName> cum aliis quibusdam <lb xml:id="p1z4"/>ad se pertinentibus iis literis, quas ad te mittit, <lb xml:id="p1z5"/>cognosces.</s>
					<s n="4" xml:lang="la">Causam suam hisce demum diebus <lb xml:id="p1z6"/>peraget, nisi a quibusdam sibi male consciis <lb xml:id="p1z7"/>delusus fuerit; rem enim immoderatam, imo nefariam m<lb xml:id="p1z8"/>oderate nimis meo iudicio plectunt.</s>
					<s n="5" xml:lang="la">Quicquid <lb xml:id="p1z9"/>tamen factum fuerit, ut scias, faciam.</s>
					<s n="6" xml:lang="la">D. <persName ref="p4037">Zanchus</persName> <lb xml:id="p1z10"/><placeName ref="l93">Clavennae</placeName> adhuc moratur, maxime propter morbum <lb xml:id="p1z11"/>comitis <persName ref="p2054">Ulyssis</persName>, quem gravius sibi accidere <lb xml:id="p1z12"/>quam suam causam lachrymis apud me saepe <lb xml:id="p1z13"/>testatus est.</s>
					<s n="7" xml:lang="la">Quin et nunc scribit <persName ref="p2054">Ulyssem</persName> instar <lb xml:id="p1z14"/>angeli alicuius coelitus delapsi nihil nisi diviniss[im]a <lb xml:id="p1z15"/>cogitare et loqui et tanta maiestate de deo, <lb xml:id="p1z16"/>de coelo, de vita aeterna, gloriosa Christi resurrectione <lb xml:id="p1z17"/>verba facere, ut omnes in summam sui pertrahat admi<lb xml:id="p1z18"/>rationem etc.</s>
					<s n="8" xml:lang="la">Haec... d. Iesus balnea tibi <lb xml:id="p1z19"/>tua ita temperaverit, ut quam diutissime <lb xml:id="p1z20"/>ecclesiae suae et nobis omnibus incolumis esse <lb xml:id="p1z21"/>queas.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Vale, vir clarissime, tuaeque fidei <lb xml:id="p1z22"/>nos tuos servulos commendatum habeas, quaeso.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Ocyus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l98">Curiae</placeName> 1567. 10. iulii</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/>Tibi deditissimus <persName ref="p8016">Thob<lb xml:id="p1z25"/>ias Iconius</persName>.</s>
				</p>
				<p>
