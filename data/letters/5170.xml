	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Accepi literas, quas misisti per d.
					<lb xml:id="p1z2"/>Augustinum. Commendo hunc tibi tanquam virum
					<lb xml:id="p1z3"/>bonum quantum ego quidem de rebus eius scire
					<lb xml:id="p1z4"/>possum. Impetrabit ab amplissimo magistratu
					<lb xml:id="p1z5"/>urbis nostrae dimissionem et testimonium. Non
					<lb xml:id="p1z6"/>enim nhonesta petit. Miror autem per
					<lb xml:id="p1z7"/>illum te nihil praeterea scripsisse, praesertim
					<lb xml:id="p1z8"/>de concilio Tridentino, utpote quod in v
					<lb xml:id="p1z9"/>consultat. Utinam possis per viros cer
					<lb xml:id="p1z10"/>et fidos aliquid certi de hoc subidia
					<lb xml:id="p1z11"/>rescissere et scribere. Cogita. Operae precium
					<lb xml:id="p1z12"/>facies.D. Fridercos alias scribam. Literae
					<lb xml:id="p1z13"/>illis coniunctae mittuntur ex Hungaria a
					<lb xml:id="p1z14"/>nobili viro imperatoe officiali. Pase
					<lb xml:id="p1z15"/>sunt mese septembris anii praeteriti. Cupit
					<lb xml:id="p1z16"/>ille amicitia mecum coniugi propter religione
					<lb xml:id="p1z17"/>eandem. Videtur esse vir prudens et prim
					<lb xml:id="p1z18"/>varius et religiosus Sribam ad illum
					<lb xml:id="p1z19"/>qua primum dlicuerit per otium. Ex Gallia
					<lb xml:id="p1z20"/>et aliude nihil habeo. Increscit tamen
					<lb xml:id="p1z21"/>fama constans de bello contra nos et Galliam
					<lb xml:id="p1z22"/>suscipiendo. Es gloubs aber nitt yeder
					<lb xml:id="p1z23"/>man.Die wöllend filichter lieber empfinden
					<lb xml:id="p1z24"/>dann glouben, das muͦß man beschähen lassen
					<lb xml:id="p1z25"/>Infatua deus consilium Achitophelis et misser
					<lb xml:id="p1z26"/>Davidis tui, ne propter adulterium et
					<lb xml:id="p1z27"/>siguine fusum opprimatur. Saltem propter glorias
					<lb xml:id="p1z28"/>mis tuu. ne dicat, ubi est deus eorum ubi
					<lb xml:id="p1z29"/>religioe? Interim quod boni est in occlesii
					<lb xml:id="p1z30"/>Domini fiat. Sit is dumtaxat nobis vi
					<lb xml:id="p1z31"/>et mortuis clemens et propitius. Ipse
					<lb xml:id="p1z32"/>oria In hoc aeterni vale, na cum tui
					<lb xml:id="p1z33"/>omnibus.Saluta d. d. consules et Philippum
					<lb xml:id="p1z34"/>et amicos. <placeName ref="l587">Tiguri</placeName> 13. februarii
					<lb xml:id="p1z35"/>Pommissellam
					<lb xml:id="p1z36"/>anno 151.
					<lb xml:id="p1z37"/>Bullingerus tuissinus.
					<lb xml:id="p1z38"/>et perpetuo
					<pb/>
					<lb xml:id="p2z1"/>Praestantissimo viro d.
					<lb xml:id="p2z2"/>Ioanni Fabritio
					<lb xml:id="p2z3"/>Curiensis ecclesiae
					<lb xml:id="p2z4"/>ministro fideli domino
					<lb xml:id="p2z5"/>suo colendso
					<lb xml:id="p2z6"/>fratri charissimo.
				</p>
			</div>
