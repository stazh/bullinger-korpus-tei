			<zone xml:id="p2z2-0" points="865,1345 909,1350 1024,1317 1055,1354 1096,1367 1202,1315 1282,1310 1286,1262 1260,1253 1220,1270 1171,1224 1112,1246 1086,1229 980,1268 932,1253 872,1262">877,1324 902,1322 928,1318 954,1315 979,1312 1005,1310 1031,1308 1056,1304 1082,1301 1108,1297 1133,1295 1159,1294 1185,1292 1210,1290 1236,1289 1262,1288 1288,1288</zone>
			<zone xml:id="p2z3-0" points="898,1407 1033,1405 1075,1442 1107,1425 1158,1440 1182,1423 1218,1429 1262,1405 1293,1414 1299,1315 1207,1315 1112,1367 1055,1354 1035,1332 901,1348">907,1396 933,1398 959,1398 985,1396 1011,1393 1038,1390 1064,1390 1090,1389 1116,1387 1142,1386 1169,1384 1195,1382 1221,1380 1247,1379 1273,1377 1300,1375</zone>
