	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Hinc coniicio te magnis distineri negotiis, <lb xml:id="p1z2"/>quod cum domino tuo d. <persName ref="p505">Burchero</persName> alioqui occu<lb xml:id="p1z3"/>patissimo et d. d. <persName ref="p8111">Martyri</persName> copiose ad me scribere <lb xml:id="p1z4"/>licuit, soli tibi maioribus nimirum involuto <lb xml:id="p1z5"/>neque parentibus neque fratribus neque sororibus aut <lb xml:id="p1z6"/>aliis amicis tantillum scribere licuit.</s>
					<s n="3" xml:lang="la">Forte <lb xml:id="p1z7"/>defuerunt tibi tabelliones, neque ulli ad vos <lb xml:id="p1z8"/>in nundinas praeteritas advenere <placeName ref="l587">Tigurini</placeName>.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Si non est incuria, inertia certe est.</s>
					<s n="5" xml:lang="la">Expecto <lb xml:id="p1z10"/>ratiotinationem tuam ut in schedam consignes in<lb xml:id="p1z11"/>de auspicans, unde nuper desieras, expensa.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Dominus postulat pro victu coronatos octodecim <lb xml:id="p1z13"/>admodum vili precio te alens.</s>
					<s n="7" xml:lang="la">Vide itaque, ne sis ingratus, <lb xml:id="p1z14"/>superbus, sed modestus, humilis et illi <lb xml:id="p1z15"/>inserviens in omnibus, in quibus citra literarum <lb xml:id="p1z16"/>detrimentum inservire potes.</s>
					<s n="8" xml:lang="la">Uxori eius <lb xml:id="p1z17"/>nunc mitto munusculum, aureum et argenteum <lb xml:id="p1z18"/>nummos.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale.</s>
					<s n="10" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 30. iulii a<lb xml:id="p1z19"/>nno <lb xml:id="p1z20"/>1554.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z21"/>Salvi sint studiosi nostri.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><persName ref="p495">H[einr<lb xml:id="p1z22"/>ychus] Bullingerus.</persName></s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Dilecto meo filio <lb xml:id="p2z2"/><persName ref="p487">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l491">Argentorati</placeName> in <lb xml:id="p2z4"/>aedibus d. <persName ref="p505">Burcheri</persName><lb xml:id="p2z5"/>.</s>
				</p>
				<p>
					<s n="14" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l491">Straßburg</placeName>.</s>
				</p>
			</div>
