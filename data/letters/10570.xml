	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Pacem et gratiam per Christum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/><persName ref="p8178">Thomas</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8178">Thomas Blarer</persName>.</note> noster deprehendit <persName ref="p467">Bucerum</persName><note xml:id="fn2" type="footnote" n="2">Zur Begegnung der beiden vgl. oben <ref target="file10562">Nr. 526</ref>, 10-13 mit Anm. 8.</note> apud <persName ref="p8055">Ambrosium</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p8055">Ambrosius Blarer</persName> in <placeName ref="l512">Tübingen</placeName>.</note>, <lb xml:id="p1z3"/>verum quo fructu cum illo egerit, <lb xml:id="p1z4"/>non possum scire, cum non redierit <persName ref="p8178">Thomas</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p8178">Thomas Blarer</persName> kehrte zwischen dem 17. und dem 23. Februar nach <placeName ref="l257">Konstanz</placeName> zurück; vgl. Blarer BW I 660f und 663f.</note>.</s>
					<s n="3" xml:lang="la">Post <lb xml:id="p1z5"/>reditum scies omnia.</s>
					<s n="4" xml:lang="la">Utcumque enim non <lb xml:id="p1z6"/>semper tutum sit singula literis demandare <lb xml:id="p1z7"/>neque omnium fides probata est, tamen non possum <lb xml:id="p1z8"/>non omnia in sinum tuum fundere.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Epistolam <lb xml:id="p1z9"/>vero <persName ref="p467">Buceri</persName> iam non mitto<note xml:id="fn5" type="footnote" n="5"><persName ref="p4079">Zwick</persName> schickte die versprochene Kopie des Briefes von <persName ref="p467">Bucer</persName> (vgl. oben <ref target="file10562">Nr. 526</ref>, Anm. 1) am 27. Februar, siehe unten <ref target="file10573">Nr. 537</ref>, 8f. 33-35.</note>; habet enim aliquot <lb xml:id="p1z10"/>folia nec licuit describere et forte, ubi redierit <lb xml:id="p1z11"/><persName ref="p8178">Thomas</persName>, usui futura est.</s>
					<s n="6" xml:lang="la">Sed non carebis ea.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Pro tuo consilio<note xml:id="fn6" type="footnote" n="6">Gemeint ist <persName ref="p495">Bullingers</persName> Brief an <persName ref="p8310">Chelius</persName>, oben <ref target="file10550">Nr. 514</ref>.</note> multas gratias ago.</s>
					<s n="8" xml:lang="la">Ego totus <lb xml:id="p1z13"/>iuro in tua verba.</s>
					<s n="9" xml:lang="la">Utinam illi nostri<note xml:id="fn7" type="footnote" n="7">Nämlich <persName ref="p467">Bucer</persName> und <persName ref="p2095">Melanchthon</persName>.</note> paria <lb xml:id="p1z14"/>respondissent, quominus occasionem haberent <lb xml:id="p1z15"/>calumniandi hostes, imo et qui a nostris stant.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/>Consilium <persName ref="p8127">Pellicani</persName><note xml:id="fn8" type="footnote" n="8">Siehe dazu oben <ref target="file10550">Nr. 514</ref>, Anm. 16.</note> cum tuo remitto<note xml:id="fn9" type="footnote" n="9"><persName ref="p495">Bullinger</persName> erhielt die beiden Gutachten erst mit dem nächsten Brief <persName ref="p4079">Zwicks</persName> zurück; vgl. unten <ref target="file10573">Nr. 537</ref>, 2-7.</note>.</s>
					<s n="11" xml:lang="la">Utraque placent, <lb xml:id="p1z17"/>quando plana sunt et verbo Christi fulta.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z18"/>Pręterea incertus, an habeas consilia <persName ref="p467">Buceri</persName> et <lb xml:id="p1z19"/><persName ref="p2095">Philippi</persName> descripta, hoc tabellione ad te mitto<note xml:id="fn10" type="footnote" n="10">Die von <persName ref="p4079">Zwick</persName> übersandten Kopien der Gutachten von <persName ref="p467">Bucer</persName> und <persName ref="p2095">Melanchthon</persName> scheinen nicht erhalten zu sein. - Zum Überbringer s. <bibl source="b700">Z</bibl>. 19.</note>, <lb xml:id="p1z20"/>quo diligentius lectis tuisque in diversum rationibus <lb xml:id="p1z21"/>collectis nobis manum iungas.</s>
					<s n="13" xml:lang="la">Statuimus enim <lb xml:id="p1z22"/>omnibus nervis<note xml:id="fn11" type="footnote" n="11">Zur Redensart vgl. <bibl source="b56">Adagia</bibl>, 1, 4, 16 (<bibl source="b370">LB</bibl> II 157).</note> refragari, sed tu nosti meam <lb xml:id="p1z23"/>pueritiam; itaque expectabo abs te et <persName ref="p8127">Pellicano</persName> <lb xml:id="p1z24"/>argumenta potiora, quibus tanquam coniunctis<pb type="scan" next="||16"/> <pb/><lb xml:id="p2z1"/>copiis resistere et fortius respondere possimus.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z2"/>Vide, ne desis nobis<note xml:id="fn12" type="footnote" n="12"><persName ref="p495">Bullinger</persName> und <persName ref="p8127">Pellikan</persName> erfüllten diese Bitte, vgl. unten <ref target="file10599">Nr. 563</ref> und 572, 5-12.</note>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb type="edition" next="114"/><lb xml:id="p2z3"/>Deinde habet hic <persName ref="p4082">Cuͦnradus</persName><note xml:id="fn13" type="footnote" n="13">Siehe oben <ref target="file10568">Nr. 532</ref>, Anm. 2.</note>, quod tecum <lb xml:id="p2z4"/>loquatur <persName ref="p7073">Hospiniani</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p7073">Leonhard Hospinian</persName>.</note> nomine, qui mihi scolam <lb xml:id="p2z5"/>in opido<note xml:id="fna" type="footnote" n="a"><hi>vor</hi> opido <hi>gestrichenes</hi> oppido.</note> <placeName ref="l489">Stain</placeName><note xml:id="fn15" type="footnote" n="15"><placeName ref="l489">Stein am Rhein</placeName> (Kt. Schaffhausen).</note> ambire videtur; nam relicturus <lb xml:id="p2z6"/>est <placeName ref="l907">Campodunum</placeName><note xml:id="fn16" type="footnote" ana="bio" n="16"><placeName ref="l907">Kempten (Allgäu)</placeName>. - In diesen Zusammenhang gehört wohl ein undatierter und unsignierter Brief <persName ref="p4079">Zwicks</persName>, in dem dieser eine nicht genannte Person unter Hinweis auf eine vorausgegangene Unterredung dazu auffordert, mit <persName ref="p495">Bullinger</persName> und anderen <placeName ref="l587">Zürcher</placeName> Gelehrten über eine Anstellung von <persName ref="p7073">Hospinian</persName> als Schulmeister von <placeName ref="l489">Stein</placeName> zu verhandeln (Zürich StA, E II 441, 65).</note>.</s>
					<s n="16" xml:lang="la">Obsecro, ut omnem lapidem <lb xml:id="p2z7"/>moveas<note xml:id="fn17" type="footnote" n="17">Zur Redensart vgl. <bibl source="b56">Adagia</bibl>, 1, 4, 30 (<bibl source="b370">LB</bibl> II 161f).</note> in promovendo hoc tam docto et pio <lb xml:id="p2z8"/>homine.</s>
					<s n="17" xml:lang="la">Facies hoc, sat scio, non illibenter <lb xml:id="p2z9"/>idque in gratiam studiorum.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="farewell">Sed iam vale <lb xml:id="p2z10"/>cum tota familia tua omnibusque fratribus, <lb xml:id="p2z11"/><persName ref="p8127">Pellicano</persName>, <persName ref="p8171">Theodoro</persName><note xml:id="fn18" type="footnote" n="18"><persName ref="p8171">Theodor Bibliander</persName>.</note>, <persName ref="p1753">Leone</persName><note xml:id="fn19" type="footnote" n="19"><persName ref="p1753">Leo Jud</persName>.</note> etc.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z12"/>20. februarii <lb xml:id="p2z13"/>1535.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z14"/>I. Z. tuus.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z15"/>Et ne illud ignores: <lb xml:id="p2z16"/><persName ref="p1055">Frechtus</persName> <placeName ref="l513">Ulmae</placeName><note xml:id="fnb" type="footnote" n="b"><hi>Die Namen und der Schluß des Satzes stehen auf der rechten Blattseite untereinander.</hi></note>, <lb xml:id="p2z17"/><persName ref="p8440">Gervasius</persName><note xml:id="fn20" type="footnote" n="20"><persName ref="p8440">Gervasius Schuler</persName>.</note> <placeName ref="l320">Memmingae</placeName>, <lb xml:id="p2z18"/><persName ref="p1387">Thomas</persName><note xml:id="fn21" type="footnote" n="21"><persName ref="p1387">Thomas Gaßner</persName>.</note> <placeName ref="l291">Lindavię</placeName> <lb xml:id="p2z19"/>subscripserunt consiliis <lb xml:id="p2z20"/><persName ref="p467">Buceri</persName> et <persName ref="p2095">Philippi</persName> <lb xml:id="p2z21"/>datis et signatis <lb xml:id="p2z22"/>chyrographis<note xml:id="fn22" type="footnote" n="22">Zu den Stellungnahmen von Theologen aus mehreren oberdeutschen Reichsstädten vgl. <bibl source="b588">Seidel</bibl> 79-81.</note>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf S. 26:]</note>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p4z1"/>Colendissimo suo in <lb xml:id="p4z2"/>domino fratri <persName ref="p495">Hainricho <lb xml:id="p4z3"/>Bullingero</persName>, <lb xml:id="p4z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
