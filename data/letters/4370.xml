	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Dum haec scripsi, mi <lb xml:id="p1z2"/><persName ref="p495">Bullingere</persName>, quatriduo <lb xml:id="p1z3"/>hęseram in lectulo <lb xml:id="p1z4"/>et corpusculum iam agens <lb xml:id="p1z5"/>annum sexagesimum quintum vi<lb xml:id="p1z6"/>x e grabbattulo erexeram <lb xml:id="p1z7"/>et cogor scribere.</s>
					<s n="2" xml:lang="la">Quare <lb xml:id="p1z8"/>obsecro, si quid erratum, <lb xml:id="p1z9"/>tu melius interpretare.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z10"/>Hoc oro: <lb xml:id="p1z11"/>Sufficit mihi; tolle, <lb xml:id="p1z12"/>quęso, animam meam.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z13"/>Fiat domini voluntas.</s>
					<s n="5" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>viro domino <lb xml:id="p2z3"/><persName ref="p495">Henrycho Bul<lb xml:id="p2z4"/>lingero</persName>, <placeName ref="l587">Tigurino</placeName> <lb xml:id="p2z5"/>theologo, suo <lb xml:id="p2z6"/>domino observando etc.</s>
					<s n="6" xml:lang="de"><lb xml:id="p2z7"/>Zürch.</s>
				</p>
				<p>
					<note>[Darunter von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="7" xml:lang="de"><lb xml:id="p2z8"/><placeName>Rychenwyler</placeName> enderung.</s>
				</p>
			</div>
		</body>
	</text>
