	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Accepi literas tuas cum libello 17. aprilis a tabellario ve<lb xml:id="p1z2"/>strate; sed nunc temporis legato absente et <placeName ref="l301">Lugduni</placeName> degente non possum ei c<lb xml:id="p1z3"/>om<lb xml:id="p1z4"/>mode offerre nisi per publicum nuntium, quem in singulas horas expectamus.</s>
					<s n="3" xml:lang="la">Abiice <lb xml:id="p1z5"/>omnem curam; ego curabo, ut libelli probe muniti in manus legati perveniant, <lb xml:id="p1z6"/>etsi nihil adhuc apud me constituerim, quid cum libello regi inscripto agere velim<lb xml:id="p1z7"/>, quum rex expectetur et forte per <placeName ref="l632">Alsatiam</placeName> ducturus est exercitum: possem commodius <lb xml:id="p1z8"/><persName ref="p2916">Schertlino</persName> mittere, sed deliberabo quid agendum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Doleo ex animo <placeName ref="l830">Anglicam</placeName> populi inconstantiam et crudelitatem in optimos viros: <lb xml:id="p1z10"/>mallem habitare apud <placeName ref="l2510">Turcam</placeName> et tutior fortassis essem quam apud illum populum, <lb xml:id="p1z11"/>qui perpetuo seditionibus variis tumultuatur.</s>
					<s n="5" xml:lang="la">Putas tu evangelium diu apud <lb xml:id="p1z12"/>tales mansurum, qui non semel reformationem instituerunt, quam mox levi e<lb xml:id="p1z13"/>x causa abrogar<lb xml:id="p1z14"/>unt?</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Nova hęc habeo: <lb xml:id="p1z15"/>Aiunt <persName ref="p17907">Gonzagam</persName> in arce <placeName ref="l306">Mediolani</placeName> suspensum a Cęsareanis; volunt enim <lb xml:id="p1z16"/>tradere arcem <placeName ref="l832">Gallis</placeName> et multi alii in quatuor secti sunt partes.</s>
					<s n="7" xml:lang="la"><persName ref="p7705">Granvellae</persName> <lb xml:id="p1z17"/>filium praeterea aiunt a Caesare decollatum eo, quod induxerit Caesarem, ut <placeName ref="l822">Germanis</placeName> <lb xml:id="p1z18"/>vincula iniiciat expellatque concionatores.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z19"/>D. <persName ref="p2916">Schertlini</persName> tabellarius suspensus a nobili de <persName>Granwill</persName>.</s>
					<s n="9" xml:lang="la">Turbas excitabit <lb xml:id="p1z20"/>in <placeName ref="l882">Hungaria</placeName> nobilis iste absque dubio; nam nobiles quosdam expetant e <persName ref="p2916">Schertliniani</persName>, <lb xml:id="p1z21"/>quos impunitos non dimittent.</s>
					<s n="10" xml:lang="la">Mandavit episcopus et reliqui proceres, <lb xml:id="p1z22"/>ut omnes nostri in <placeName ref="l632">Alsatia</placeName> victum parent nescio quibus.</s>
					<s n="11" xml:lang="de">Es sol ein jetlicher <lb xml:id="p1z23"/>bur zwen segk mit mel in sym huß haben; wers nit vermag, so sol der <lb xml:id="p1z24"/>reicher bur im fursetzen; das ist um Palmarum gebotten.</s>
					<s n="12" xml:lang="la">Sunt in magno timore <lb xml:id="p1z25"/>rustici.</s>
					<s n="13" xml:lang="la"><placeName ref="l491">Argentina</placeName> tria signa habet, quos iussere migrare in pfafforum <lb xml:id="p1z26"/>domos.</s>
					<s n="14" xml:lang="la">Rex <placeName ref="l832">Galliae</placeName> in nanse est, munitissimo oppido.</s>
					<s n="15" xml:lang="la">Metis se dedit.</s>
					<s n="16" xml:lang="la">Pro<lb xml:id="p1z27"/>pediem aut <placeName ref="l2459">Rheni</placeName> flumen transibit aut <placeName ref="l808">Belgas</placeName> petiturus est.</s>
					<s n="17" xml:lang="la">Magna pecunia<lb xml:id="p1z28"/>e apud nos est, quam missuri sunt regi, quum superaverit Alpes.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z29"/><persName ref="p458">Brent<lb xml:id="p1z30"/>ius</persName> cum ministris <placeName ref="l491">Argentoratensibus</placeName> nondum est <placeName ref="l1107">Tridenti</placeName> auditus.</s>
					<s n="19" xml:lang="la">Legatus <placeName ref="l491">Argentinensis</placeName> <lb xml:id="p1z31"/><persName ref="p6096">Sleidanus</persName> rediit et dicit propediem redituros concionatores infecta re.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Considera, <lb xml:id="p1z32"/>quid instituant episcopi illi fallaces.</s>
					<s n="21" xml:lang="la">Qui redeunt e <placeName ref="l1107">Tridento</placeName> nihil de apparatu <lb xml:id="p1z33"/>Cęs[areae] m[aiestatis] se vidisse dicunt; alii dicunt illum iam pridem mortuum, alii vero alia, prout <lb xml:id="p1z34"/>vulgus solet.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="farewell">Vale.</s>
					<s n="23" xml:lang="la">Plura data occasione.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z35"/>Nescio, quos velis libros; significa.</s>
					<s n="25" xml:lang="la">Literas enim tuas non potui <lb xml:id="p1z36"/>reperire.</s>
					<s n="26" xml:lang="la">Mitto autem unum et alterum, ne omnino vacuus domum <lb xml:id="p1z37"/>redeat tabellarius.</s>
					<s n="27" xml:lang="la"><placeName ref="l28">Basileę</placeName> 18. aprilis 1552.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p1z38"/>T[uus] <persName ref="p1278">Gastius</persName>.</s>
				</p>
				<p>
					<s n="29" xml:lang="la">Polonię statum nosti ex <persName ref="p714">Cęlio</persName> et <lb xml:id="p1z40"/><placeName ref="l2653">Moscovitarum</placeName> cum <placeName ref="l2472">Polono</placeName> belli initia.</s>
				</p>
				<p>
					<s n="30" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem wolgelerten <lb xml:id="p2z2"/>herren herren <persName ref="p495">Hein<lb xml:id="p2z3"/>rychen Bullinger</persName>, myn<lb xml:id="p2z4"/>em gunstigen herren, <lb xml:id="p2z5"/>zuͦ handen.</s>
				</p>
				<p>
					<s n="31" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
