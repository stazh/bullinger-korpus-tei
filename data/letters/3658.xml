	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>In hac pra dochossimo e charissimo Bullingero,
					<lb xml:id="p1z2"/>Tuas 28 iruii datas a  iulio pogino
					<lb xml:id="p1z3"/>accep, que fuerunt mihi gratissimum
					<lb xml:id="p1z4"/>sed iisse respandese iapuo possum.
					<lb xml:id="p1z5"/>prestans notus Brevi u cive, monachi
					<lb xml:id="p1z6"/>u sfilium tuum causilio et auxilio una
					<lb xml:id="p1z7"/>Felandro e inprimus Martha
					<lb xml:id="p1z8"/>res bene habbet vidi literas.
					<lb xml:id="p1z9"/>clandintmii annctissimos
					<lb xml:id="p1z10"/>e postea.
					<lb xml:id="p1z11"/>Sopamum ita tractabo, ut me
					<lb xml:id="p1z12"/>etiam ractori uslum. experiens hac ui
					<lb xml:id="p1z13"/>.
					<lb xml:id="p1z14"/>ipsi
					<lb xml:id="p1z15"/>Vglipsimo cteris vale o
					<lb xml:id="p1z16"/>1.
					<pb/>
					<lb xml:id="p2z1"/>Heinricho Bullingero,
					<lb xml:id="p2z2"/>Polligo o et amico
					<lb xml:id="p2z3"/>Bucerissimo.
				</p>
			</div>
		</body>
	</text>
