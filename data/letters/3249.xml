	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Quia spero me brevi affuturum paucis ad <lb xml:id="p1z2"/>tuas literas respondebo, <persName ref="p495">H. Bullingere</persName> frater.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Sic dixi de libro <persName>Coelii</persName>, ut scripseram, non <lb xml:id="p1z4"/>impium atque haereticum.</s>
					<s n="3" xml:lang="la">Sed fac me dixisse.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Annon impius atque haereticus est liber, in quo <lb xml:id="p1z6"/>docetur hominem posse servari sine Christo?</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>An dixerit, vide in pagina 196.</s>
					<s n="6" xml:lang="la">Deinde <lb xml:id="p1z8"/>addis nondum cognitum esse pro lupo, at <lb xml:id="p1z9"/>ego dico iam cognitum ab his, qui <lb xml:id="p1z10"/>voluerunt librum perlegere, et bre[...] videbis <lb xml:id="p1z11"/>iudicium multorum, quae extabunt.</s>
					<s n="7" xml:lang="la">Postre<lb xml:id="p1z12"/>mo ais te male habere, quod illum irri<lb xml:id="p1z13"/>taverim et non potius tuo consilio paru<lb xml:id="p1z14"/>erim.</s>
					<s n="8" xml:lang="la">At me male habet, quod non possis <lb xml:id="p1z15"/>ferre eum, qui talem librum allatret.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>Quid ergo?</s>
					<s n="10" xml:lang="la">[...]iendum erat, ut error <lb xml:id="p1z17"/>ut cancer serperet et ecclesias vastaret.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z18"/>Ais hominem apologiam adornare, non dubito, <lb xml:id="p1z19"/>atque in ea producturum tuas literas, <lb xml:id="p1z20"/>quas iactat se habere, et tunc, qui respondebunt, <lb xml:id="p1z21"/>cogentur te peragere reum fere eiusdem <lb xml:id="p1z22"/>criminis (boni consule, fraterne scribo), <pb/><lb xml:id="p2z1"/>atque ita vereor, ne accidat, si sic scripsisti, ut <lb xml:id="p2z2"/>ille affirmat.</s>
					<s n="12" xml:lang="la">Si illi esset contentio cum [me] <lb xml:id="p2z3"/>privato homine, adhuc causa cadedret, quia <lb xml:id="p2z4"/>malum fovet; sed qaunto magis, cum pro <lb xml:id="p2z5"/>me pugnent mei principes, qui gravissimis <lb xml:id="p2z6"/>literis monuerunt senatum <placeName ref="l28">Basiliensem</placeName>, uti compescat <lb xml:id="p2z7"/>maledicentiam hominis.</s>
					<s n="13" xml:lang="la">Quoniam iuste accu<lb xml:id="p2z8"/>satus nolluit acquiescere, habeat, quod meritus <lb xml:id="p2z9"/>est.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Adhuc per mensem subsistam, antequam <lb xml:id="p2z10"/>in <placeName>Sarmatiam</placeName> redeam.</s>
					<s n="15" xml:lang="la">Dux noster con<lb xml:id="p2z11"/>demnavit <persName ref="p20206">Gribaldi</persName> dogmata <lb xml:id="p2z12"/>magna sol[l]ennitate; affuit in iuditio senatus <lb xml:id="p2z13"/>scholae, multi consiliarii ex praecepuis, <lb xml:id="p2z14"/>multi theologi.</s>
					<s n="16" xml:lang="la">Sic res est; abibit notatus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z15"/>Certissime scio me (licet autor fuerim duci <lb xml:id="p2z16"/>de homine accersendo) immunem esse <lb xml:id="p2z17"/>omnis suspitionis, quasi cum illo unquam senserim.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z18"/>Ardet in septentrione bellum.</s>
					<s n="19" xml:lang="la">Rex in persona adoritur <lb xml:id="p2z19"/><placeName ref="l2574">Livonienses</placeName>; vereor, ne involvatur <placeName ref="l822">Germ<lb xml:id="p2z20"/>ania</placeName>.</s>
					<s n="20" xml:lang="la">Colloquium fiet, <placeName ref="l471">Spirae</placeName> episcopus intererit <lb xml:id="p2z21"/>pro <persName ref="p18477">Ferdinando</persName>.</s>
					<s n="21" xml:lang="la">Meus haerus non ibit, quia <lb xml:id="p2z22"/><persName>Augustus</persName> datus autoritate comitiorum collega ait <lb xml:id="p2z23"/>sibi in <placeName ref="l825">Daniam</placeName> ad socerum eundum<pb/><lb xml:id="p3z5"/>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p3z10"/>Iterum te oro, <persName ref="p495">Bullingere</persName>, boni consule, quod <lb xml:id="p3z11"/>liberius, ut fratrem decet, tecum de libro <lb xml:id="p3z12"/><persName>Coelii</persName> egerim.</s>
					<s n="23" xml:lang="la" ana="farewell">Vale m<lb xml:id="p3z18"/>eque <lb xml:id="p3z19"/>brev<lb xml:id="p3z20"/>i exp<lb xml:id="p3z21"/>ecta.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p3z22"/><placeName ref="l512">Tub<lb xml:id="p3z23"/>i<lb xml:id="p3z24"/>ngae</placeName> <lb xml:id="p3z25"/>20. i<lb xml:id="p3z26"/>ulii 1557.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><persName ref="p3375">V<lb xml:id="p3z27"/>ergeri<lb xml:id="p3z28"/>us</persName></s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
					<s n="26" xml:lang="la">C<lb xml:id="p3z29"/>lar<lb xml:id="p3z30"/>iss<lb xml:id="p3z31"/>imo <lb xml:id="p3z33"/>vori <lb xml:id="p3z34"/>d. <persName ref="p495">Heinr<lb xml:id="p3z35"/>ico Bu<lb xml:id="p3z37"/>l<lb xml:id="p3z38"/>l<lb xml:id="p3z40"/>i<lb xml:id="p3z41"/>nge<lb xml:id="p3z42"/>r<lb xml:id="p3z46"/>o</persName>, <lb xml:id="p3z47"/>fra<lb xml:id="p3z48"/>tri <lb xml:id="p3z49"/>ho<lb xml:id="p3z51"/>no<lb xml:id="p3z52"/>ran<pb/><lb xml:id="p4z1"/>do.</s>
					<s n="27" xml:lang="la"><placeName ref="l587">T<lb xml:id="p4z2"/>iguri</placeName><lb xml:id="p4z3"/>.</s>
				</p>
