	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quicquid qui<note xml:id="fn1" type="footnote" n="1">Wahrscheinlich der in <persName ref="p495">Bullingers</persName> Antwort vom 31. März genannte Bote, s. unten <ref target="file10376">[Nr. 344]</ref> S. 99f, 4.17 und Anm. 13.</note> meas has reddit, tecum communicabit, in mandatis habet.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Quamobrem ei credito et, quod poteris in hisce negociis<note xml:id="fn2" type="footnote" n="2">Wahrscheinlich handelte es sich um eine Warnung vor einer kriegerischen Bedrohung der reformierten Orte von <placeName ref="l834">Italien</placeName> her, s. <persName ref="p495">Bullingers</persName> Antwort, unten S. 99, 5-11.</note>, exhibeto, <lb xml:id="p1z3"/>ut aliquit certi ferat responsi.</s>
					<s n="4" xml:lang="la">Vir talis est, ut omnes omnia bona de <lb xml:id="p1z4"/>ipso<note xml:id="fna" type="footnote" n="a">ipso <hi>am Rande nachgetragen.</hi></note> sperent.</s>
					<s n="5" xml:lang="la">Scripsit senatus noster ad tuos<note xml:id="fn3" type="footnote" n="3">an den <placeName ref="l587">Zürcher</placeName> Rat.</note>, sed in genere, reconditiora <lb xml:id="p1z5"/>haec multitudini non ausi concredere, quod effluant omnia mox, ubi <lb xml:id="p1z6"/>sunt cognita.</s>
					<s n="6" xml:lang="la">Vides ad quidnam esset senatus, de quo nuper<note xml:id="fn4" type="footnote" n="4">Siehe oben S. 841, 17-26 und 96, 11-19.</note>, clancularius<lb xml:id="p1z7"/>.</s>
					<s n="7" xml:lang="la">Discordia illa nostra<note xml:id="fn5" type="footnote" n="5">Gemeint ist die Uneinigkeit unter den reformierten Orten, wovor <persName ref="p8418">Myconius</persName> unermüdlich immer wieder gewarnt hat, vgl. <hi>Kirchhofer,</hi> Myconius 114-127; <hi>Rudolf,</hi> Aussöhnungsversuch; <bibl source="b5">HBBW III</bibl> <ref target="file10335">Nr. 304</ref>. 306 und 310 sowie oben <ref target="file10345">Nr. 314</ref>.</note> quid aliud quam nos pessundabit, si illi volue<lb xml:id="p1z8"/>rint?</s>
					<s n="8" xml:lang="la">Oppriment enim imparatos, consiliis et omnibus rebus carentes.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z9"/>Orabis cum tuis deum, ut nobis succurrat.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale per Christum.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z10"/><placeName ref="l28">Basileae</placeName>, in die palmarum anno 34.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z11"/><persName ref="p8418">Os. Myconius</persName> <lb xml:id="p1z12"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>amico prima<lb xml:id="p2z4"/>r<lb xml:id="p2z9"/>i<lb xml:id="p2z10"/>o <lb xml:id="p2z14"/>suo<lb xml:id="p2z15"/>.</s>
				</p>
			</div>
