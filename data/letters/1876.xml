	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Staphylus vel Strophilus ille Plautinus, <lb xml:id="p1z2"/>quum ab urbe <placeName ref="l396">Pragensi</placeName> sex adhuc mi<lb xml:id="p1z3"/>liaribus curru vectus abesset, sereno <lb xml:id="p1z4"/>coelo prope lucum aliquem exiguum <lb xml:id="p1z5"/>tempestas extrema repente exoritur <lb xml:id="p1z6"/>et aurigam eius anteriori equo insi<lb xml:id="p1z7"/>dentem fulgure ilico petit.</s>
					<s n="2" xml:lang="la">Exanimis <lb xml:id="p1z8"/>ille equo procidit, quum etiam ille <lb xml:id="p1z9"/>equus, dextra manu quem ad temonem <lb xml:id="p1z10"/>gubernabat, in terram prostratus <lb xml:id="p1z11"/>iaceret.</s>
					<s n="3" xml:lang="la">Staphylus cum scriba vix <lb xml:id="p1z12"/>se colligens aurigam nonnihil a psy<lb xml:id="p1z13"/>cholypsia redeuntem, media tamen cor<lb xml:id="p1z14"/>poris parte tabe seu apoplexiae simi<lb xml:id="p1z15"/>li stupore consumptum currui aegre <lb xml:id="p1z16"/>imponit ac ad proximum pagum <lb xml:id="p1z17"/>proficiscitur.</s>
					<s n="4" xml:lang="la">Ibi affinem suum d. d. <lb xml:id="p1z18"/><persName>Ioannem</persName> <placeName ref="l213">Hessum</placeName> iureconsultum in hospitio <lb xml:id="p1z19"/>offendit, cui detegit historiam uni<lb xml:id="p1z20"/>versam sperans fore, ut, qui condole<lb xml:id="p1z21"/>ret ei, amicum deprehenderet.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z22"/>Is vero quum Saulis exemplum Sta<lb xml:id="p1z23"/>phylo obiiceret eumque ad constantiam, <lb xml:id="p1z24"/>quae viri integritas est et prudentia, hor<lb xml:id="p1z25"/>taretur, furibundus sycophanta in haec <lb xml:id="p1z26"/>verba adversus eum prorumpit <lb xml:id="p1z27"/>inquiens: "Tu semper hactenus es <lb xml:id="p1z28"/>adversatus mihi.</s>
					<s n="6" xml:lang="la">An vero nescis <lb xml:id="p1z29"/>haec ratione naturali contingere posse?</s>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>Quinimo, ni tanta fuisset erga me <lb xml:id="p2z2"/>clementia divina, quidni putes <lb xml:id="p2z3"/>iram dei alias eandem in me <lb xml:id="p2z4"/>excandescere debuisse, quae et <lb xml:id="p2z5"/>aurigam meum oppressit?"</s>
					<s n="8" xml:lang="la">Tandem, <lb xml:id="p2z6"/>quum apud transfugam vir optimus <lb xml:id="p2z7"/>ille neque monitis nec hortatu <lb xml:id="p2z8"/>quicquam proficeret, obturatum <lb xml:id="p2z9"/>corde et maiori supplicio dignum <lb xml:id="p2z10"/>indignabundus, et huc <lb xml:id="p2z11"/>ad comitia quum legatus adpulisset, <lb xml:id="p2z12"/>intrepide cunctis explicuit.</s>
					<s n="9" xml:lang="la"><lb xml:id="p2z13"/>His porro fidem adhibere potes, mi <lb xml:id="p2z14"/>praestantissime domine <persName ref="p495">Bullingere</persName>, quoniam <lb xml:id="p2z15"/>res tota iam adhuc tribus septi<lb xml:id="p2z16"/>manis palam in confessu esse <lb xml:id="p2z17"/>apud nos coepit.</s>
					<s n="10" xml:lang="la" ana="salute">Salutem toti <lb xml:id="p2z19"/>ecclesiae et collegio vestro, S. P. domino <lb xml:id="p2z20"/><persName ref="p1283">Gesnero</persName> caeterisque singulis et omnibus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z21"/>Humanitatis tuae per omnia <lb xml:id="p2z22"/>observantissimus <lb xml:id="p2z23"/><persName ref="p8430">Raphael Seiler</persName>, iur[<lb xml:id="p2z24"/>is]consultus.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
