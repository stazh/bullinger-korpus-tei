				<p>
					<lb xml:id="p1z1"/>2x calenis ept. 5.
					<lb xml:id="p1z2"/>Vesus
					<lb xml:id="p1z3"/>obsidetur castilio (admiratii domicilium raderent me hominem
					<lb xml:id="p1z4"/>plus minus centum satis expediti rogantque n doni mea
					<lb xml:id="p1z5"/>arma de nocte occultent. Eram autem tiicd Montergii
					<lb xml:id="p1z6"/>cum ferrario, qe ducussa reiuta) obsessis postridię auxilium
					<lb xml:id="p1z7"/>Respondeo de lecto, in quo tunc ex febr decum
					<lb xml:id="p1z8"/>illud mihi igratissimi fore. Sed annis ex mei
					<lb xml:id="p1z9"/>ęrdibssumptis progredientes revocantur de via. Videbant
					<lb xml:id="p1z10"/>enim ne castilioem cocendio conflagrare nequitia
					<lb xml:id="p1z11"/>impuri illius sigonis, quem nosti. Interea Montargii
					<lb xml:id="p1z12"/>omnes tumultuari et vocferari urbem a me et
					<lb xml:id="p1z13"/>reliquis fidelibus prodi; testimoniis urgeor, arma
					<lb xml:id="p1z14"/>adompmeque maximo numero repecta fuisse (ud
					<lb xml:id="p1z15"/>anillis? Euę hoc ipso momento exerctus Germanorum
					<lb xml:id="p1z16"/>ad obsidenda charitatem urbem festinat. o
					<lb xml:id="p1z17"/>dmmonihi in tempore suam Trissaus comitatus regi
					<lb xml:id="p1z18"/>triu ad nos prehendendos Amelia missus erat
					<lb xml:id="p1z19"/>contems istineribus nocti diem iungentes per medium
					<lb xml:id="p1z20"/>hoc pa
					<lb xml:id="p1z21"/>hostis exercitum ad muros charitatis, deo duce
					<lb xml:id="p1z22"/>proditer.
					<lb xml:id="p1z23"/>erltis.
					<lb xml:id="p1z24"/>falii pervenimus. Ibi Bruelius  excitat inter
					<lb xml:id="p1z25"/>paco
					<lb xml:id="p1z26"/>ducem illum Bipontinum et comitem Mansfeldensem
					<lb xml:id="p1z27"/>autas lites, ut commes illius legatum posthac e
					<lb xml:id="p1z28"/>esse noluerit. dux item qui suis tormentis videbat
					<lb xml:id="p1z29"/>se nihil promovere simurum enim tantum de summo
					<lb xml:id="p1z30"/>qualiebant) exilatuat, quoniam ad copiendam
					<lb xml:id="p1z31"/>urbes non advenerit, sed tantum ut ad Bigerim
					<lb xml:id="p1z32"/>nostros obvios haberet, se nud pono progressurum
					<lb xml:id="p1z33"/>.
					<lb xml:id="p1z34"/>Dum ille sic constituit, Gallorum, qui in exhena
					<lb xml:id="p1z35"/>ponte pro praesidio collocati fuerant, duces duo,
					<lb xml:id="p1z36"/>Normanus parvus et Lodocus ille ipse, qui paulo
					<lb xml:id="p1z37"/>ante scalis admolis tuos Vegelios a papistis occupatos
					<lb xml:id="p1z38"/>receperat, per summam crepidinem unius et alterius
					<lb xml:id="p1z39"/>diruptae ab hostibus formias, ventre repunt et
					<lb xml:id="p1z40"/>proxime ad milium accedunt, ubi ignominiae causa
					<lb xml:id="p1z41"/>fura ex arce summa vident, idolum, cui Prxce
					<lb xml:id="p1z42"/>densis inscriptum erat, pendere apprehensa
					<lb xml:id="p1z43"/>conscendunt iurum, ad sumum quatuor, quos
					<lb xml:id="p1z44"/>1569. 23. auu.
					<lb xml:id="p1z45"/>sur . Ien.
					<lb xml:id="p1z46"/>erro.
					<pb/>
					<lb xml:id="p2z1"/>s.
					<lb xml:id="p2z2"/>.
					<lb xml:id="p2z3"/>reperiunt obnios in inuro caedunt urbemque
					<lb xml:id="p2z4"/>aptavi conclamant. Tum hostium aliquot partim exhad
					<lb xml:id="p2z5"/>urbem, partim intra se praecipitant, porte demum
					<lb xml:id="p2z6"/>ad hunc tumultu aperitis horrenda editur strages.
					<lb xml:id="p2z7"/>Viae urbis cadaveribus amplius quatuor dies repletae
					<lb xml:id="p2z8"/>unt. Postquam exmissu d. Morvilleru, qui postea
					<lb xml:id="p2z9"/>agro Lemonicum febru ardente interiit et
					<lb xml:id="p2z10"/>reliquorum ducum sum concionatus et ad deo gratias
					<lb xml:id="p2z11"/>agendas cohortatius, dum salutate. princape
					<lb xml:id="p2z12"/>Aurargiano et caeteris me iraeccipro ad Francurim
					<lb xml:id="p2z13"/>im i sium hospitum humanissime exceperat
					<lb xml:id="p2z14"/>intra  horam captus satus ipro verbis praefecto
					<lb xml:id="p2z15"/>eisque papista a Germanis, partim Galliae loquentibus
					<lb xml:id="p2z16"/>partim Latins et nisi ad vocem metu domo
					<lb xml:id="p2z17"/>exisset Francorbus periissem. Ibi eidaninam
					<lb xml:id="p2z18"/>tuus plare
					<lb xml:id="p2z19"/>ageret  enquerius, dux illefertissimus
					<lb xml:id="p2z20"/>et ingeriosissimus ad fui homini, donec in meo
					<lb xml:id="p2z21"/>complexum moreretur, deinde sancerras profectus
					<lb xml:id="p2z22"/>una cum tuo fratre, uterque incidimus in morbum et
					<lb xml:id="p2z23"/>ut mutato coelo meliuscule nos haberemus, huc
					<lb xml:id="p2z24"/>venimus vestram videlicet domum. Ille dei gratia
					<lb xml:id="p2z25"/>edvaluit. Ego ad meas febricitationes perpetuas
					<lb xml:id="p2z26"/>redii. Praetermiseram ab illo ipse Lidovico
					<lb xml:id="p2z27"/>cuius auspiciis capta fuerat charitas, eandem sub
					<lb xml:id="p2z28"/>suvercio vestrate, quem optime nosti, adversus
					<lb xml:id="p2z29"/>quindecim hominum millia, bis mille bombardarum
					<lb xml:id="p2z30"/>iuliberatam suiisse postea liberata arcensque
					<lb xml:id="p2z31"/>Nuceti ab eodem rursus occupata hodie teneri.
					<lb xml:id="p2z32"/>upxore et
					<lb xml:id="p2z33"/>Tuus frater cum  ex liberis sese tibi commendat.
					<lb xml:id="p2z34"/>Deullius Marescalli Villevillam gener in charitatis
					<lb xml:id="p2z35"/>obsidione aeneo tormento in vallo pervussus occubuit
					<lb xml:id="p2z36"/>Item duo ministri, Quinso et Burgoinus, dum
					<lb xml:id="p2z37"/>obsidebamur, cruribus utrique, eodem termentigense
					<lb xml:id="p2z38"/>amputatis. Vale cum symmystis charissime Vegeliis.
					<lb xml:id="p2z39"/>1. calendas septembris 1569.
					<lb xml:id="p2z40"/>tuus  Qnocus.
