	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Quem cogitaveram foras in lucem brevi christianum <lb xml:id="p1z3"/>fętum emittere, eum adhuc parumper in <lb xml:id="p1z4"/>utero continere a nonnullis hic minime contemne<lb xml:id="p1z5"/>ndis fratribus multis neque illis levibus nominibus compul<lb xml:id="p1z6"/>sus fui."</s>
					<s n="3" xml:lang="la">Non sunt" (inquiunt) "tyrannis sua sponte ad <lb xml:id="p1z7"/>sęviendum in filios dei currentibus calcaria nostris <lb xml:id="p1z8"/>libris in publicum editis addenda, hoc praesertim <lb xml:id="p1z9"/>tempore, quo cum ubique fere terrarum tum praesertim <lb xml:id="p1z10"/>in <placeName ref="l832">Gallia</placeName> et <placeName ref="l830">Anglia</placeName> infiniti prope religionis caus<lb xml:id="p1z11"/>a <lb xml:id="p1z12"/>in carceribus detinentur et quidem viri doctissimi atque omni <lb xml:id="p1z13"/>virtutum genere ornatissimi, quorum saluti, qui<lb xml:id="p1z14"/>buscunque possumus rationibus consulere debemus, non autem ad <lb xml:id="p1z15"/>ipsorum necem principes ullo modo incitare.</s>
					<s n="4" xml:lang="la">Hoc enim <lb xml:id="p1z16"/>exigit christiana charitas."</s>
					<s n="5" xml:lang="la">Vides, doctissime <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z17"/>quid me potissimum adduxerit, ut horum consilio in prę<lb xml:id="p1z18"/>sentia parendum duxerim, et quem iam fętum partu<lb xml:id="p1z19"/>riebam, eum adhuc aliquamdiu in utero retinere decreverim<lb xml:id="p1z20"/>.</s>
					<s n="6" xml:lang="la">Ita se res habet de illo fętu, quem ex<lb xml:id="p1z21"/>pectabas.</s>
					<s n="7" xml:lang="la">Quem vero neque tu expectabas <lb xml:id="p1z22"/>neque ego edere cogitabam, imo et quem vix <lb xml:id="p1z23"/>ex philosophico semine conceperam, illum nescio <lb xml:id="p1z24"/>quo pacto coactus fui cito in lucem dare, ita <lb xml:id="p1z25"/>ut abortum compulsus sim facere.</s>
					<s n="8" xml:lang="la">Displicet quidem <lb xml:id="p1z26"/>mihi ita, ut etiam me pudeat illum a quopiam <lb xml:id="p1z27"/>videri; sed tamen, quando ita natus est, ne officio et <lb xml:id="p1z28"/>debito meo desim, eum ad te, qualisqualis est, <lb xml:id="p1z29"/>mitto cum sua nutrice.</s>
					<s n="9" xml:lang="la">Si quid vel in me parente v<lb xml:id="p1z30"/>el in ipso filio tibi displicuerit, tua intererit <lb xml:id="p1z31"/>candide, sicuti es, me admonere, mea vero tibi, <lb xml:id="p1z32"/>ut par est, obtemperare, boni tamen consulere puer<lb xml:id="p1z33"/>ilia hęc mea.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale et me ama.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z34"/><placeName ref="l491">Argentina</placeName> 2. septembris 1554.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Tui studiosissim<lb xml:id="p1z35"/>us <pb/><lb xml:id="p2z2"/><persName ref="p4037">H[ieronymus] <lb xml:id="p2z4"/>Zanc<lb xml:id="p2z5"/>hus</persName>.</s>
					<s n="13" xml:lang="la">Do<lb xml:id="p2z6"/>ctissi<lb xml:id="p2z8"/>m<lb xml:id="p2z10"/>o atque egregio <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z12"/>ecclesię pastori d. <persName ref="p495">Henrico <lb xml:id="p2z14"/>Bullingero</persName> ceu patri colendissim<lb xml:id="p2z15"/>o.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z16"/><placeName ref="l587">Tigurum</placeName><lb xml:id="p2z34"/>.</s>
				</p>
			</div>
		</body>
