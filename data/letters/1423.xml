	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Finita sunt comitia et indicta alia <lb xml:id="p1z2"/>ad 22. novembris, si recte memini.</s>
					<s n="3" xml:lang="la">I<lb xml:id="p1z3"/>nterea vellem omnino, imo nostri vellent ex <lb xml:id="p1z4"/>animo Urbes christianas convenire et ante <lb xml:id="p1z5"/>illa comitia de rebus omnibus consultare; <lb xml:id="p1z6"/>rursus enim in quaestionem plurima veniunt: <lb xml:id="p1z7"/>consultatio de concilio adeundo <lb xml:id="p1z8"/>vel recusando, de foedere novo iureiurando <lb xml:id="p1z9"/>semel confirmando; <persName ref="p8112">Gallus</persName> protestationis <lb xml:id="p1z10"/>suae contra <placeName ref="l1107">Tridentinum</placeName> concilium factae copiam <lb xml:id="p1z11"/>dedit <placeName ref="l862">Helvetiis</placeName>, et ea admodum extinxit <lb xml:id="p1z12"/>ardorem quorundam flagrantium amore et <lb xml:id="p1z13"/>desiderio concilii non propter Christum, sed <lb xml:id="p1z14"/>propter <persName>Lazarum</persName>.</s>
					<s n="4" xml:lang="la">Caesar <persName ref="p8112">Gallum</persName> graviter <lb xml:id="p1z15"/>accusat; <persName ref="p8112">Gallus</persName> fortiter se purgat.</s>
					<s n="5" xml:lang="la">Quid <lb xml:id="p1z16"/>futurum putas?</s>
					<s n="6" xml:lang="la">De concilio <placeName ref="l1107">Tridentino</placeName> <lb xml:id="p1z17"/>nihil scribunt amici ex <placeName ref="l834">Italia</placeName>.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z18"/>Si potes, suggere viris bonis, ut privatim <lb xml:id="p1z19"/>concilia celebrentur et amice collo<lb xml:id="p1z21"/>quantur de rebus omnibus etc.</s>
				</p>
				<p>
					<s n="8" xml:lang="de">Vornächst ist <lb xml:id="p1z22"/>uns by dem schwären wynd <placeName ref="l187">Gruͤnigen</placeName> <lb xml:id="p1z23"/>(leyder) verbrunnen biß an das schloß und <lb xml:id="p1z24"/>ein huß oder zwey; sol in des vogts stall durch <lb xml:id="p1z25"/>sorglose anggangen sin.</s>
					<s n="9" xml:lang="de">Gott behuͤt uns vor <lb xml:id="p1z26"/>grösserm unfal.</s>
					<s n="10" xml:lang="de">Es ist so ein groß fhüwr <lb xml:id="p1z27"/>xin, das man es wyt und breyt gesähen hatt, <lb xml:id="p1z28"/>ist vor den 12 umb mitternacht angangen <lb xml:id="p1z29"/>und hatt biß zuͦ dem tag gewäret.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Dedi <lb xml:id="p1z30"/>imprimendum libellum De perfectione christian<lb xml:id="p1z31"/>orum ad regem <placeName ref="l832">Galliarum</placeName> <persName ref="p8112">Heinrychum</persName> <lb xml:id="p1z32"/>Latine et Germanice; d. <persName ref="p3375">Vergerius</persName> <lb xml:id="p1z33"/>vertit eum <placeName ref="l834">Italice</placeName> et <placeName ref="l832">Gallice</placeName>; exiguus <lb xml:id="p1z34"/>est liber, forte 4 vel 5 foliorum.</s>
					<s n="12" xml:lang="la" ana="salute">Vale <lb xml:id="p1z35"/>et saluta <persName ref="p1278">Gastium</persName>, cum quo haec de <placeName ref="l185">Groninga</placeName> et <lb xml:id="p1z36"/>libro meo communicabis; non vacabat <lb xml:id="p1z37"/>illi scribere, iube tamen, ut, si commodum <lb xml:id="p1z38"/>sit, rescribat ad priores.</s>
					<s n="13" xml:lang="la">7. octobris 1551.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p8418">Osvaldo <lb xml:id="p2z2"/>Myconio</persName>, <placeName ref="l28">Basiliensis</placeName> <lb xml:id="p2z3"/>ecclesiae vigilantissimo <lb xml:id="p2z4"/>antistiti, domino venerando <lb xml:id="p2z5"/>et fratri charissimo suo.</s>
					<s n="16" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
