	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">In tuis<note xml:id="fn1" type="footnote" n="1"><persName ref="p8418">Myconius</persName>' Brief <ref target="file13084">Nr. 3035</ref> vom 8. Oktober.</note>, colende frater, nihil est, ad quod <lb xml:id="p1z2"/>respondere necesse sit.</s>
					<s n="3" xml:lang="la">Certum est <persName ref="p18538">caesarem</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p18538">Karl V.</persName> - <persName ref="p495">Bullinger</persName> bezieht sich hier auf <persName ref="p8418">Myconius</persName>' Mitteilung in <ref target="file13084">Nr. 3035</ref>,<ptr target="qvzl17304-11" type="qv"/>.</note>, ubi <lb xml:id="p1z3"/>commode poterit, nobis non parsurum, ac modo se af<lb xml:id="p1z4"/>fert commoda occasio, qua nos adoriri poterit.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Ambit foedus <persName ref="p8112">rex Gallorum</persName>.<note xml:id="fn3" type="footnote" n="3"><persName ref="p8112">Heinrich II.</persName> - Siehe dazu <ref target="file13086">Nr. 3037</ref>, <ptr target="qvfn17306-3" type="qv"/>.</note></s>
					<s n="5" xml:lang="la">Inter alia queritur <lb xml:id="p1z6"/><persName ref="p4758">principem Placentinum</persName><note xml:id="fn4" type="footnote" ana="bio" n="4"><persName ref="p4758">Pièr Luigi Farnese</persName>, Herzog von <placeName ref="l1122">Parma</placeName> und <placeName ref="l1161">Piacenza</placeName>, Sohn des Papstes; s. <ref target="file13013">Nr. 2964</ref>, <ptr target="qvfn17229-4" type="qv"/>.</note> periisse miserabiliter.<note xml:id="fn5" type="footnote" ana="bio" n="5">Dies findet sich in einem Schreiben des <placeName ref="l832">französischen</placeName> Gesandten in der <placeName ref="l862">Eidgenossenschaft</placeName>, <persName ref="p4620">Louis Daugerant, Seigneur de Boisrigaut</persName>, an die Stadt <placeName ref="l587">Zürich</placeName>, welches vom 12. Oktober 1547 aus <placeName ref="l300">Luzern</placeName> datiert, und in dem der gewaltsame Tod von <persName ref="p4758">Pièr Luigi Farnese</persName> als mahnendes Exempel angeführt wird; s. <bibl source="b197">EA</bibl> IV/1d 893 zu x.<ptr target="zfnfn17311-2" type="zfn"/></note></s>
					<s n="6" xml:lang="la"><lb xml:id="p1z7"/>Unde ego coniicio inter <persName ref="p19981">papam</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p19981">Paul III.</persName></note> et <persName ref="p8112">Gallum</persName> esse syncretismum.<note xml:id="fn7" type="footnote" n="7">Vereinbarung; s. <bibl source="b353">Kirsch</bibl> 2783.</note></s>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/>Si ergo nos<note xml:id="fn8" type="footnote" n="8">Gemeint sind die protestantischen Orte der <placeName ref="l862">Eidgenossenschaft</placeName>.</note> coniunxerimus vires nostras <lb xml:id="p1z9"/><placeName ref="l832">Gallo</placeName>, papae sumus milites.</s>
					<s n="8" xml:lang="la">Ego in magnis versor <lb xml:id="p1z10"/>difficultatibus et anxietatibus!</s>
					<s n="9" xml:lang="la">Oro dominum, ut is <lb xml:id="p1z11"/>ecclesiae suae adsit.</s>
					<s n="10" xml:lang="la">Quidam putant res suas non <lb xml:id="p1z12"/>fore salvas, nisi per amicitiam cum <persName ref="p8112">Gallo</persName>.</s>
					<s n="11" xml:lang="la">Ego vi<lb xml:id="p1z13"/>deo et certo scio ita nos perituros per <lb xml:id="p1z14"/>amicitiam <placeName ref="l832">Gallicam</placeName>, ut perierunt hactenus <lb xml:id="p1z15"/>confoederati nostri.<note xml:id="fn9" type="footnote" n="9">Gemeint sind die <placeName ref="l3259">Innerschweizer</placeName>, die ein Abkommen mit <placeName ref="l832">Frankreich</placeName> hatten.</note></s>
					<s n="12" xml:lang="la">Domino displicet hoc foedus.<note xml:id="fn10" type="footnote" n="10">Siehe dazu <bibl source="b21">HBBW XVIII</bibl> 26 und Anm. 67; XIX 32 und Anm. 129.</note></s>
					<s n="13" xml:lang="la"><lb xml:id="p1z16"/>Dissipabit ergo cum interitu et inte<lb xml:id="p1z17"/>rnicione<note xml:id="fn11" type="footnote" n="11">= internecione; s. <bibl source="b616">Stotz</bibl> II 291, Nr. 48.3.</note> <lb xml:id="p1z18"/><placeName ref="l832">Galliae</placeName> et <placeName ref="l862">Helvetiae</placeName>.</s>
					<s n="14" xml:lang="la">Utinam vanus sim vates!</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z19"/><persName ref="p19845">Ioannem Buchterum</persName><note xml:id="fn12" type="footnote" ana="bio" n="12"><persName ref="p19845">Johannes Buchter</persName>, der sich damals in <placeName ref="l28">Basel</placeName> aufhielt; s. <ref target="file12921">Nr. 2872</ref>, <ptr target="qvfn17139-2" type="qv"/>. Er traf seinen Vater nicht mehr lebend an; s. <ref target="file13095">Nr. 3046</ref>,<ptr target="qvzl17315-4" type="qv"/>.</note> protinus ad te vocato.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z20"/>Iubeto, ut sine mora ascendat <placeName ref="l587">Tigurum</placeName>.</s>
					<s n="17" xml:lang="la">La<lb xml:id="p1z21"/>borat <persName ref="p473">pater</persName><note xml:id="fn13" type="footnote" ana="bio" n="13"><persName ref="p473">Heinrich Buchter</persName>. - Er starb um 3 Uhr nachts am 15. Oktober; s. <bibl source="b288">HBD</bibl> 35,16-18.<ptr target="zfnfn17311-1" type="zfn"/></note> eius laetali morbo.</s>
					<s n="18" xml:lang="la">Utinam non se<lb xml:id="p1z22"/>pultus sit, priusquam ille <placeName ref="l587">Tigurum</placeName> perveniat!</s>
					<s n="19" xml:lang="la">Quod<lb xml:id="p1z23"/>si morietur (ut certo moriturum brevi au<lb xml:id="p1z24"/>tumant medici - ac ipse signa mortis in eo <lb xml:id="p1z25"/>deprehendi)<note xml:id="fna" type="footnote" n="a"><hi>Klammern ergänzt.</hi></note>, non frustra redierit filius: Est <lb xml:id="p1z26"/>enim mater<note xml:id="fn14" type="footnote" n="14">Unbekannt.</note> vidua multis liberis onerat<lb xml:id="p1z27"/>a, non habens <pb type="edition" next="563"/> ullum solatium.</s>
					<s n="20" xml:lang="la">Hic ergo matri <lb xml:id="p1z28"/>adsit, oportet.</s>
					<s n="21" xml:lang="la">Ne ergo differat, sed protinus accingat <lb xml:id="p1z29"/>se itineri!</s>
					<s n="22" xml:lang="la">Id serio illi dices parentum <lb xml:id="p1z30"/>et meo nomine.</s>
					<s n="23" xml:lang="la">Pater in morbo semel et <lb xml:id="p1z31"/>iterum clamavit:</s>
					<s n="24" xml:lang="de">„Louff, <persName ref="p19845">Hans</persName>, du findst mich <lb xml:id="p1z32"/>sunst nitt mee!“</s>
					<s n="25" xml:lang="la">Dominus illum confirmet in <lb xml:id="p1z33"/>vera fide.</s>
					<s n="26" xml:lang="la">Ego iam ad ipsum redeo.</s>
					<s n="27" xml:lang="la">Mea <lb xml:id="p1z34"/>sententia non attinget crastinum diem, sed deo <lb xml:id="p1z36"/>omnia possibilia.<note xml:id="fn15" type="footnote" n="15">Vgl. <cit type="bible"><ref>Mt 19, 26</ref></cit>.</note></s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="28" xml:lang="la" ana="farewell"><lb xml:id="p1z37"/>Vale aeternum.</s>
					<s n="29" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, <lb xml:id="p1z38"/>14. octobris 1547.</s>
					<s n="30" xml:lang="la"><lb xml:id="p1z39"/>Salvi sint <lb xml:id="p1z40"/><persName ref="p8032">Dryander</persName><note xml:id="fn16" type="footnote" n="16"><persName ref="p8032">Francisco de Enzinas</persName>, der damals in <placeName ref="l28">Basel</placeName> wohnte.</note>, <persName ref="p1278">Gastius</persName> et reliqui.</s>
					<s n="31" xml:lang="la"><lb xml:id="p1z41"/><persName ref="p495">Bullingerus</persName>.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="32" xml:lang="de">Sagend <lb xml:id="p1z42"/><persName ref="p1278">Gasten</persName>, das ich nienan kein<lb xml:id="p1z43"/>en<note xml:id="fn17" type="footnote" n="17">nienan keinen: niemals ein (Exemplar von). - Über die von <persName ref="p495">Bullinger</persName> gewünschte Ausgabe der Satiren des <persName ref="p18967">Persius</persName> s. <ref target="file13033">Nr. 2984</ref>, <ptr target="qvfn17249-6" type="qv"/>.</note> <lb xml:id="p1z44"/><persName ref="p18967">Persium</persName> gesähen habe.</s>
					<s n="33" xml:lang="de">Höusch<note xml:id="fn18" type="footnote" n="18">(Ich) erbitte; s. <bibl source="b590">SI</bibl> II 1754 (s.v. heischen).</note> inn <pb/><lb xml:id="p2z1"/>noch.</s>
				</p>
				<p>
