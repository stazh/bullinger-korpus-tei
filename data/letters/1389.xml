	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Accessi d. <persName ref="p20430">Valentinum Nusboum</persName>, qui dixit <lb xml:id="p1z2"/>se misisse fasciculum ante 14 dies ad se missum ex <placeName ref="l491">Argentina</placeName> <lb xml:id="p1z3"/>per civem quendam ex <placeName ref="l21">Badenis</placeName>, fortassis iis diebus accepisse.</s>
					<s n="3" xml:lang="la">Dedit <lb xml:id="p1z4"/>et has, quas dixi se ante 6 dies accepisse, nec incidisse in tabellionem<lb xml:id="p1z5"/>.</s>
					<s n="4" xml:lang="la">Mirum quid scribas de commentario in epistolam 1. Cor. <persName ref="p8111">Petri <lb xml:id="p1z6"/>Martyris</persName>, quum non extet.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Scribit ad <persName ref="p8126">Oporinum</persName> d <persName ref="p5626">Lazius</persName> e <placeName ref="l546">Wienna</placeName> <placeName ref="l2510">Turcam</placeName> imminere <lb xml:id="p1z8"/>maximis viribus et incursiones facere in rusticanum populum et multos <lb xml:id="p1z9"/>abducere.</s>
					<s n="6" xml:lang="la">Imminet gravissimum bellum <placeName ref="l850">Austriacis</placeName>; conscribitur miles <lb xml:id="p1z10"/>in <placeName ref="l882">Ungariam</placeName> mittendus.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale.</s>
					<s n="8" xml:lang="la">Si quid habes ex <placeName ref="l830">Anglia</placeName> <lb xml:id="p1z11"/>et ex <placeName ref="l834">Italia</placeName>, obsecro, velis communicare.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><persName ref="p8418">Myconius</persName> noster aegrotat, <lb xml:id="p1z12"/>et pestis incipit p... grassari in optimos viros.</s>
					<s n="10" xml:lang="la">Ora igitur pro nobis.</s>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z13"/>Vale iterum.</s>
					<s n="12" xml:lang="la">29. augusti.</s>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z14"/><persName ref="p8171">Theodorum</persName> salutabis.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z15"/>Tuus <lb xml:id="p1z16"/><persName ref="p1278">Gastius</persName> ex animo.</s>
				</p>
				<p>
					<s n="15" xml:lang="de"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z2"/>pfarrher zuͦ <placeName ref="l587">Zurich</placeName> <lb xml:id="p2z3"/>im Münster, mynem <lb xml:id="p2z4"/>lieben herren.</s>
				</p>
				<p>
					<s n="16" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
