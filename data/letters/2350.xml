	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z3"/>Gratia domin tecum, frater in Christo observande etc.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z4"/>Cum hic <persName ref="p8121">Montius</persName> petiturus <placeName ref="l587">Tigurum</placeName> me casu <lb xml:id="p1z5"/>praeteriret, grande, ni fallor, peccatum in te <lb xml:id="p1z6"/>commisissem, si te non certiorem de rebus <lb xml:id="p1z7"/>meis fecissem etc.</s>
					<s n="3" xml:lang="la">Septem mensibus quartana <lb xml:id="p1z8"/>graviter laborans omnibus viribus exantlatis <lb xml:id="p1z9"/>tandem ad portum salutis adpuli, atque dum gratias <lb xml:id="p1z10"/>agerem benigno deo mihi ipso congratulans, <lb xml:id="p1z11"/>ecce reliquerat duriorem post se tyrannidem, <lb xml:id="p1z12"/>totiusque corporis omniumque membrorum tumorem, adeo <lb xml:id="p1z13"/>ut nec ad latum digitum iam trimestri promovere <lb xml:id="p1z14"/>potuerim nisi aliorum ope.</s>
					<s n="4" xml:lang="la">Sed iam contracta <lb xml:id="p1z15"/>membra ad solitum redeunt, ut vides hac scriptura, <lb xml:id="p1z16"/>officium.</s>
					<s n="5" xml:lang="la">Ora pro me, ut benigna domini <lb xml:id="p1z17"/>voluntas in me perficiatur; cupio enim dissolvi <lb xml:id="p1z18"/>et esse cum Christo;<note xml:id="fn1" type="footnote" n="1">Vgl. <cit type="bible"><ref>Phil 1, 23</ref></cit>.</note> cursum consummavi.</s>
					<s n="6" xml:lang="la">Plura <lb xml:id="p1z19"/>scriberem; sed fessa membra non sinunt; alias <lb xml:id="p1z20"/>copiosiora.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Vale igitur cum omnibus symmystis tuis, <lb xml:id="p1z22"/>qui, ut audio, dominum quoque sedulo orarunt pro me.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z23"/>Liberet vos dominus ab omni malo etc.</s>
					<s n="9" xml:lang="la"><placeName ref="l411">Richen<lb xml:id="p1z24"/>villę</placeName> ex cubili, cui hybernos et aestivos <lb xml:id="p1z25"/>menses adfixus fui.</s>
					<s n="10" xml:lang="la" ana="salute">Salutabis fratres nominatim etc.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z26"/>27. iulii 1554.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z27"/>Tuissimus <lb xml:id="p1z28"/><persName ref="p1010">Matthias <lb xml:id="p1z29"/>Erbius</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z31"/>Salutant te nostri.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrycho Bullingero</persName>, <lb xml:id="p2z2"/>pietate ac eru<lb xml:id="p2z3"/>ditione ornatissimo etc. <lb xml:id="p2z4"/>ecclesię <placeName ref="l587">Tigurinę</placeName> antistiti <lb xml:id="p2z5"/>celeberrimo etc. <lb xml:id="p2z6"/>fratri observando.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>