	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Im Jahr des Abgangs von <persName cert="high" ref="p8455">Hans Vogler</persName> aus <placeName ref="l28" cert="high">Basel</placeName> und des <placeName ref="l410" cert="high">Regensburger</placeName> Religionsgesprächs; vgl. bes. oben <ref target="file11547">Nr. 1504</ref>.</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Reliquit hic <persName ref="p8071">Voglerus</persName> librum unum et alterum; <lb xml:id="p1z3"/>eos hic cum isto<note xml:id="fn2" type="footnote" n="2">Unbekannt.</note> mitto.</s>
					<s n="3" xml:lang="la">Vas, in quo est omnis <lb xml:id="p1z4"/>eius suppellex, nemo hactenus aufert; miror, <lb xml:id="p1z5"/>qui fiat.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Sunt quaedam debita perexigua, <lb xml:id="p1z6"/>quae patri nuper scripsi,<note xml:id="fn3" type="footnote" n="3">Der Brief an <persName ref="p8071">Hans Vogler d.Ä.</persName> ist nicht erhalten.</note> et valde cupiam dissolvi.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell"><lb xml:id="p1z7"/>Vale in domino cum omnibus tuis.</s>
					<s n="6" xml:lang="la">14. maii.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/><persName ref="p1365">S. Grynęus</persName> <lb xml:id="p1z9"/>tuus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>A comitiis<note xml:id="fn4" type="footnote" n="4">Gemeint ist zweifellos der Reichstag zu <placeName ref="l410">Regensburg</placeName>.</note> si quid habes, impert<lb xml:id="p1z11"/>i.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">H. Bullingero</persName> <lb xml:id="p2z2"/>suo, amico.</s>
				</p>
			</div>
		</body>
	</text>
