			<zone xml:id="p2z5-0" points="392,1682 459,1657 505,1672 540,1664 566,1674 591,1663 658,1670 662,1617 624,1616 598,1601 565,1618 531,1607 445,1640 396,1630">400,1655 426,1653 452,1651 478,1649 505,1648 531,1646 557,1642 584,1639 610,1638 636,1637 663,1637</zone>
