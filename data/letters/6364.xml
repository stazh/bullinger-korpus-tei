	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Viro doctissimo domino <persName ref="p495">Bullingero</persName>, <lb xml:id="p1z2"/>apud <placeName ref="l587">Tiguros</placeName> ministro dignissimo.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Proficiscenti ad vos rerum suarum causa d. <persName>Tuchinero</persName>, <lb xml:id="p1z4"/>civi vestro, quem amo, iussi, ut tibi salutem <lb xml:id="p1z5"/>meis verbis nuntiaret tecumque de certis rebus ageret, <lb xml:id="p1z6"/>quę cum michi cordi sunt, tum nostra utriusque interest <lb xml:id="p1z7"/>ea confieri.</s>
					<s n="3" xml:lang="la">Ei ipsi non secus ac michi, si tecum <lb xml:id="p1z8"/>praesens essem, fidem adhibebis.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">De comitiis <placeName ref="l300">Lucernę</placeName> <lb xml:id="p1z9"/>ad diem 29. nomine pontificis convocatis diffusius <lb xml:id="p1z10"/>cum <persName>Tuchinero</persName> poteris colloqui.</s>
					<s n="5" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ama me.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/><placeName ref="l760">Solloduri</placeName> die 22a mensis ianuarii 1555.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">D[ignita<lb xml:id="p1z12"/>ti] t[uae] deditissimus <lb xml:id="p1z13"/><persName ref="p1869">N. Cruxceius</persName>.</s>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Bullingero</persName>.</s>
				</p>
				<p>
					<note type="author">[Bemerkung von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="10" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l760">Saloduro</placeName> scribit <lb xml:id="p2z4"/>has legatus R[egiae] M[aiestatis] mense <lb xml:id="p2z5"/>ianuario 1565.</s>
				</p>
			</div>
		</body>
	</text>
