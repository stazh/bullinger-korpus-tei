					<s n="2" xml:lang="la"><persName ref="p7073">Hospinianus</persName> noster sit loco <lb xml:id="p1z2"/>epistolę, mi <persName ref="p495">Bullingere</persName>, frater in Christo pie et <lb xml:id="p1z3"/>observande.</s>
					<s n="3" xml:lang="la">Is procul dubio bona fide omnes <lb xml:id="p1z4"/>res nostras apud te deponet.</s>
					<s n="4" xml:lang="la">Ego si plura <lb xml:id="p1z5"/>scribere conarer, non possum tamen, cum iam <lb xml:id="p1z6"/>octiduo fere graviter laborarim erysypila ita, <lb xml:id="p1z7"/>ut ex grabbatulo nonnisi pedo innixus promovea<lb xml:id="p1z8"/>m etc.</s>
					<s n="5" xml:lang="la">Eum morbum, si propitio numini <lb xml:id="p1z9"/>visum fuerit, mihi aliquando fatalem existimo; <lb xml:id="p1z10"/>adeo graviter et importune ac saepius me mo<lb xml:id="p1z11"/>lestat.</s>
					<s n="6" xml:lang="la">Fiat domini voluntas.</s>
					<s n="7" xml:lang="la">Ut pergant vicini <lb xml:id="p1z12"/>nostri <placeName>Keiserspergani</placeName> cum <placeName>Monasterianis</placeName> in valle <lb xml:id="p1z13"/>S. Gregorii significabit <persName ref="p7073">Hospinianus</persName>.</s>
					<s n="8" xml:lang="la">Baro <placeName ref="l404">Rapolt<lb xml:id="p1z14"/>steinensis</placeName> agit cum principi <placeName ref="l327">Montbelgardi</placeName> consilium <lb xml:id="p1z15"/>quęrens, quo <placeName ref="l1273">Ensenheimensibus</placeName> adversariis respondeat <lb xml:id="p1z16"/>etc.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale in Christo Iesu.</s>
					<s n="10" xml:lang="la">Ora pro me deum <lb xml:id="p1z17"/>per Iesum Christum, amen.</s>
					<s n="11" xml:lang="la" ana="salute">Saluta fratres omnes nomina<lb xml:id="p1z18"/>tim.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l411">Richenvillę</placeName> 4. iunii 1556.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z19"/>Tuus tuissimus <persName ref="p1010">Erbius</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="de">Lieber her <persName ref="p495">Bullinger</persName>, helffent dem <lb xml:id="p1z20"/><persName ref="p7073">Hospiniano</persName> etwa umb 10 agenden, <lb xml:id="p1z21"/>damit wirs den <foreign xml:lang="la">renascentibus ecclesiis</foreign> <lb xml:id="p1z22"/>khunden mitteilen und <foreign xml:lang="la">in administratione <lb xml:id="p1z23"/>sacramentorum concordes seyent et<lb xml:id="p1z24"/>c.</foreign></s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro pręstantissimo <lb xml:id="p2z2"/>pietate inprimis <lb xml:id="p2z3"/>ac doctrina <lb xml:id="p2z4"/>d. <persName ref="p495">Henrycho <lb xml:id="p2z5"/>Bullingero</persName>, ecclesię <lb xml:id="p2z6"/><placeName ref="l587">Tigurinę</placeName> antistiti, <lb xml:id="p2z7"/>fratri observan<lb xml:id="p2z8"/>do<lb xml:id="p2z9"/>.</s>
				</p>
			</div>
		</body>
	</text>
