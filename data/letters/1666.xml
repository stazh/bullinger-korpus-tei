	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/><persName ref="p8098">Georg, grave zu Würtemberg <lb xml:id="p1z2"/>unnd zu Mümpelgart</persName> etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="de"><lb xml:id="p1z3"/>Unnsern grus zuvor, lieber besonder.</s>
					<s n="3" xml:lang="de">Wir schicken <lb xml:id="p1z4"/>dir hiebey die aynsthäls alt unnd neüw <lb xml:id="p1z5"/>sindt, versehehn unns, es werden bald neuwe <lb xml:id="p1z6"/>zeyttungen khomen, deren sich villeich nit versehen wer<lb xml:id="p1z7"/>den.</s>
					<s n="4" xml:lang="de"><lb xml:id="p1z8"/>Seith gott bevolhen.</s>
					<s n="5" xml:lang="de">Datum <placeName ref="l441">Schaffhausen</placeName> <lb xml:id="p1z9"/>den 27den juny anno etc 52.</s>
				</p>
				<p>
					<s n="6" xml:lang="de"><lb xml:id="p1z11"/>Neuwe zeyttung.</s>
					<s n="7" xml:lang="de">Der <persName ref="p18593">Türgk</persName> ist den 27den aprilis <lb xml:id="p1z12"/>mit 70000 mann auff <placeName ref="l869">Sibenburg</placeName> zuzogen unnd <lb xml:id="p1z13"/>den 21. may mit 300 seglen und schiffen auff <lb xml:id="p1z14"/><placeName ref="l2556">Sicylien</placeName> oder <placeName ref="l994">Napolis</placeName> gefaren.</s>
					<s n="8" xml:lang="de">Der künig von <lb xml:id="p1z15"/><placeName ref="l832">Frangkreich</placeName> ligt an <persName ref="p7364">Marthin von Rossen</persName>, schar<lb xml:id="p1z16"/>mutzlet täglich.</s>
					<s n="9" xml:lang="de">Das künigreich<note type="margin">a.R.: -reüch</note> <placeName ref="l994">Neapolis</placeName> <lb xml:id="p1z17"/>ist auffrurisch unnd zum thail <placeName ref="l832">frantzosisch</placeName> worden.</s>
					<s n="10" xml:lang="de">Wolt ü[c<lb xml:id="p1z18"/>h] g[nädiglich] auch nit verhalten.</s>
					<s n="11" xml:lang="de">Datum <placeName ref="l1204">Passauw</placeName> den 13den iunii anno etc. 52.</s>
				</p>
				<p>
					<s n="12" xml:lang="de"><persName ref="p8098">G[eorg] g[<lb xml:id="p1z19"/>rave] z[u] Wyrttemberg</persName> etc.</s>
				</p>
				<p>
					<note>[Zur Nachschrift am Rand:]</note>
					<s n="13" xml:lang="de">Sölch hatt g[rave] <persName ref="p7432">Fridrich von Castells</persName> <lb xml:id="p1z20"/>under <lb xml:id="p1z21"/>anderm zugschriben vür warhafftig nuwe z<pb/><lb xml:id="p2z1"/>eitt[ung].</s>
				</p>
				<p>
					<s n="14" xml:lang="de">Unserm lieben besondern <persName ref="p495">Heinrich <lb xml:id="p2z2"/>Bullinger</persName>, predigern zu <placeName ref="l587">Zürich</placeName><lb xml:id="p2z3"/>.</s>
				</p>
			</div>
		</body>
	</text>
