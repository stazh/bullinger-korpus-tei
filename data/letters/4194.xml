	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Si quid fuerit in literis, quas recens <placeName ref="l491">Argentinę</placeName> acceptas <lb xml:id="p1z2"/>ad te damus, sanctissime <persName ref="p495">Bullingere</persName>, ex quo intelligam, in <placeName ref="l830">An<lb xml:id="p1z3"/>glia</placeName> quid fiat et quę sit spes de regno futuro, quęso me eius <lb xml:id="p1z4"/>certiorem efficias.</s>
					<s n="3" xml:lang="la">Nam ex filio nihil accepi, nisi quod scribit se <lb xml:id="p1z5"/>epistolam ex <placeName ref="l830">Anglia</placeName> ad me dedisse, quę nondum est reddita.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Quodsi per otium licuerit, ut ad me aliquid rescribas, poteris hoc <lb xml:id="p1z7"/>per alios vel per <persName ref="p2259">Mangoldum</persName> nostrum <placeName ref="l257">Constantię</placeName> reddi ad manus <lb xml:id="p1z8"/><persName ref="p8474">Hieronymi Hurusii</persName> aut <persName ref="p8401">Petri Kunzeri</persName>, affinium meorum, curare.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Magnifico <persName ref="p8111">Petro Martyri</persName> ne dedigneris indicare me meum <lb xml:id="p1z10"/>desyderium de pacandis ecclesiis amplius paratum esse ad suas <lb xml:id="p1z11"/>literas illi demonstrare, utque me diligat in numero christiani <lb xml:id="p1z12"/>nominis amatorum.</s>
					<s n="6" xml:lang="la" ana="farewell">In Christo vale, in eodem me, quod facis, ama.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute"><lb xml:id="p1z13"/>Salutat te meus affinis <persName ref="p8500">Petrus Scherus</persName> et <persName ref="p7216">Iacobus Zviccus</persName>, cognatus <lb xml:id="p1z14"/>meus.</s>
					<s n="8" xml:lang="la"><placeName ref="l489">Lithopoli</placeName> 20. ianuarii 1560.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>Tuus ex animo <lb xml:id="p1z16"/><persName ref="p8178">Thomas Blaurerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
