	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Binas<note xml:id="fn1" type="footnote" n="1">Nämlich die Briefe <ref target="file12718">Nr. 2671</ref> und <ref target="file12719">Nr. 2672</ref> vom 12. November.</note> iam postremo simul misi et antea nullum tabellionem, quantum sciverim, meis <lb xml:id="p1z2"/>non oneravi.</s>
					<s n="3" xml:lang="la">Miror ergo, quod conquereris<note xml:id="fn2" type="footnote" n="2">In einem nicht erhaltenen Brief.</note> rarius me scribere.</s>
					<s n="4" xml:lang="la">Ignoro autem, si <lb xml:id="p1z3"/>non accepi omnes, quas tu dedisti, nam ex actorum ordine patere videtur, quod dico.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z4"/>Mendacia spargi<note xml:id="fn3" type="footnote" n="3">Nämlich mit Nr. 2658,56-58.</note> dolet; putaram ego nihil ex <placeName ref="l257">Constantia</placeName> scribi non verissimum; <lb xml:id="p1z5"/>nam inde fuit, quod narratum est de <persName ref="p19981">papa</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p19981">Paul III.</persName></note> contra <persName ref="p18538">cęsarem</persName>.<note xml:id="fn5" type="footnote" n="5"><persName ref="p18538">Karl V.</persName></note></s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/>De <persName ref="p18250">Mauricio</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p18250">Moritz von Sachsen</persName>. -Bezug auf <persName ref="p495">Bullingers</persName> Mitteilung in <ref target="file12706">Nr. 2659</ref>,40f. 79-81.</note> profecto male nuncias.</s>
					<s n="7" xml:lang="la">Iurassem fuisse bonum virum!</s>
					<s n="8" xml:lang="la">Doleo valde <lb xml:id="p1z7"/>perfidiam eius.</s>
					<s n="9" xml:lang="la">Quod abit autem elector<note xml:id="fn7" type="footnote" n="7">Kurfürst <persName ref="p19065">Johann Friedrich I. von Sachsen</persName>, der im Begriff stand, in sein Herzogtum aufzubrechen; s. <ref target="file12709">Nr. 2662</ref>, Anm. 20.</note> ad suos liberandos, non valde me terret.</s>
					<s n="10" xml:lang="la">Nam <lb xml:id="p1z8"/>quod adtinet ad ipsum, scio, qui<note xml:id="fn8" type="footnote" n="8">Zum Beispiel <persName ref="p467">Bucer</persName>; s. dessen Brief an <persName ref="p8418">Myconius</persName> vom 26. Oktober 1546 (Zürich StA, E II 358, 1706)- wir danken Rainer Henrich für diesen Hinweis.</note> iam pridem optassent fuisset domi.</s>
					<s n="11" xml:lang="la">De equitibus eius <lb xml:id="p1z9"/>scripsit nuper bonus vir<note xml:id="fn9" type="footnote" n="9">Unbekannt.</note>: „Ex equitibus optimi sunt <placeName ref="l213">Hessici</placeName> et <placeName ref="l2477">Palatinenses</placeName>.</s>
					<s n="12" xml:lang="la"><foreign xml:lang="el">Οἱ μοίσι<lb xml:id="p1z10"/>οι</foreign><note xml:id="fn10" type="footnote" n="10">Die <placeName ref="l1682">Meißener</placeName>. - Offensichtlich benutzt <persName ref="p8418">Myconius</persName> hier diese Bezeichnung für die <placeName ref="l749">Sachsen</placeName> allgemein.</note> sui sunt similes.“</s>
					<s n="13" xml:lang="la">Si abfuisset, putant quidam iam debellatum esse.</s>
					<s n="14" xml:lang="la">Constat <lb xml:id="p1z11"/>enim tertio in manus datum cęsaris exercitum, si ille<note xml:id="fn11" type="footnote" n="11">Der Kurfürst.</note> rem non impedivisset.</s>
					<s n="15" xml:lang="la">Age, <lb xml:id="p1z12"/>dominus invocandus ut hactenus, et sperandum firmiter daturum esse, quod dedit <lb xml:id="p1z13"/>hucusque.<pb type="edition" next="295"/></s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z14"/>Transeunt milites cęsareani satis multi iuxta urbem nostram.</s>
					<s n="17" xml:lang="la">Nemo aliter puta<lb xml:id="p1z15"/>vit quam vel dimissos a cęsare vel fuga elapsos.</s>
					<s n="18" xml:lang="la">Expectavimus ergo lętum <lb xml:id="p1z16"/>a vobis nuncium aliquod.</s>
					<s n="19" xml:lang="la">Redeunt item <placeName ref="l862">Helvetii</placeName> ab <placeName ref="l491">Argentinensibus</placeName> et ali<lb xml:id="p1z17"/>unde.<note xml:id="fn12" type="footnote" n="12">Zu den von <placeName ref="l491">Straßburg</placeName> angeworbenen Söldnern aus der <placeName ref="l862">Eidgenossenschaft</placeName> s. <bibl source="b20">HBBW XVII</bibl> 134. 208. 235. 246. 251. 260. Die bei <placeName ref="l513">Ulm</placeName> dienenden <placeName ref="l862">Eidgenossen</placeName> waren ebenfalls schon Anfang November beurlaubt worden; s. <ref target="file12707">Nr. 2660</ref>, Anm. 6.</note></s>
					<s n="20" xml:lang="la">Quare persuasimus nobis ad menses aliquot tranquillitatem.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z18"/>Legatus <persName ref="p20225">Galli</persName><note xml:id="fn13" type="footnote" n="13">König <persName ref="p20225">Franz I.</persName> (gest. 31. März 1547).</note> <persName ref="p944">Maurus</persName><note xml:id="fn14" type="footnote" n="14">Der ordentliche <placeName ref="l832">französische</placeName> Botschafter <persName ref="p944">Antoine Morelet du Museau</persName> war am 5. November 1546 von <placeName ref="l28">Basel</placeName> nach <placeName ref="l832">Frankreich</placeName> abgereist. Ihm folgte interimistisch <persName ref="p17922">François de La Rivière</persName> (November 1546 bis Februar 1547). Unter <persName ref="p8112">Heinrich II.</persName> wurde <persName ref="p944">Morelet du Museau</persName> erst wieder im Februar 1551 (und dies bis Oktober 1552) ordentlicher Botschafter <placeName ref="l832">Frankreichs</placeName> in der <placeName ref="l862">Schweiz</placeName>; s. Edouard <hi>Rott,</hi> Histoire de la Représentation Diplomatique de la France auprès des Cantons Suisses, de leurs Alliées et leurs Confédérés, Bd. I: 1430-1559, Bern 1900, S. 334. 430-433. 565.</note> illis diebus abiit in <placeName ref="l832">Galliam</placeName>.</s>
					<s n="22" xml:lang="la">Ad hoc enim rex con<lb xml:id="p1z19"/>cessit duos menses.</s>
					<s n="23" xml:lang="la">Sunt, qui ob id gaudeant.</s>
					<s n="24" xml:lang="la">Arbitrantur enim regem <lb xml:id="p1z20"/>instructum iri a legato in rem communem.<note xml:id="fn15" type="footnote" n="15">Gemeint ist die gemeinsame Angelegenheit der Protestanten in ihrer Auseinandersetzung mit Kaiser <persName ref="p18538">Karl V.</persName></note></s>
					<s n="25" xml:lang="la">Dominus vero mihi adiutor; et <lb xml:id="p1z21"/>non timebo, quid faciat mihi homo.<note xml:id="fn16" type="footnote" n="16"><cit type="bible"><ref>Ps 118 (Vulg. 117), 6</ref></cit>; <cit type="bible"><ref>Hebr 13, 6</ref></cit>.</note></s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p1z22"/>Qui redeunt a cęsare circa <placeName ref="l28">Basileam</placeName>, piscibus sunt magis muti.<note xml:id="fn17" type="footnote" n="17"><hi>Siehe Adagia</hi> 1,5,29 <hi>(ASD</hi> II/1 502-504, <ref target="file10464">Nr. 429</ref>); <bibl source="b681">Wander</bibl> IV 9401. Nr. 13.</note></s>
					<s n="27" xml:lang="la">Tristicia <lb xml:id="p1z23"/>sola docent non actum secum feliciter.</s>
					<s n="28" xml:lang="la">In pago <placeName ref="l2356">Lanser</placeName><note xml:id="fn18" type="footnote" n="18"><placeName ref="l2356">Landser</placeName> (<placeName ref="l2894">Dép. Haut-Rhin</placeName>, <placeName ref="l832">F</placeName>), im <placeName ref="l632">Elsass</placeName>, etwa 25 km nordwestlich von <placeName ref="l28">Basel</placeName>.</note> quidam<note xml:id="fn19" type="footnote" n="19">Unbekannt.</note> rogatus est <lb xml:id="p1z24"/>a suis: „Quid ais? qui successit? loquere vel verbum!“</s>
					<s n="29" xml:lang="de"><foreign xml:lang="la">Nihil respondet <lb xml:id="p1z25"/>nisi:</foreign> „Gand<note xml:id="fn20" type="footnote" ana="lex" n="20">Gehet.</note> und erfarends als wol als ich.“</s>
					<s n="30" xml:lang="la">In pago <placeName ref="l2357">Krentzach</placeName><note xml:id="fn21" type="footnote" n="21"><placeName ref="l2357">Grenzach</placeName> (Lkr. <placeName ref="l2225">Lörrach</placeName>, <placeName ref="l572">Baden-Württemberg</placeName>), 6 km östlich von <placeName ref="l28">Basel</placeName>.</note> est, qui<note xml:id="fn22" type="footnote" n="22">Unbekannt.</note> <lb xml:id="p1z26"/>dixit:</s>
					<s n="31" xml:lang="de">„Mir gescheche ja glich wol old wee<note xml:id="fn23" type="footnote" n="23">wol old wee: Gutes oder (s. <bibl source="b590">SI</bibl> I 187) Schlechtes.</note>, zum keyser kumm ich nümmer<lb xml:id="p1z27"/>mee!“</s>
					<s n="32" xml:lang="de">Und der ist ein kriegsman von juget<note xml:id="fn24" type="footnote" ana="lex" n="24">Jugend.</note> uff.</s>
				</p>
			</div>
			<div xml:id="div7" corresp="regest7">
				<p>
					<s n="33" xml:lang="la"><lb xml:id="p1z28"/>Adest, qui<note xml:id="fn25" type="footnote" n="25">Unbekannt.</note> has<note xml:id="fn26" type="footnote" ana="lex" n="26">vorliegenden Brief.</note> vult auferre.</s>
					<s n="34" xml:lang="la">Desinere cogor.</s>
					<s n="35" xml:lang="la" ana="farewell">Vale per Christum <lb xml:id="p1z29"/>Iesum.</s>
					<s n="36" xml:lang="la"><placeName ref="l28">Basileę</placeName> raptim, 17. novembris anno 1546.</s>
					<s n="37" xml:lang="la"><lb xml:id="p1z30"/>Tuus <persName ref="p8418">Myco.</persName></s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="38" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>domino suo <lb xml:id="p2z3"/>venerandissimo.</s>
					<s n="39" xml:lang="de"><placeName ref="l587">Zü[rich]</placeName>.<note xml:id="fna" type="footnote" n="a"><hi>Textverlust bei Entfernung des Siegels.</hi></note></s>
				</p>
			</div>
		</body>
	</text>
