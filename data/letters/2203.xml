	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Accepi heri primum tres tuos libellos de iustifi<lb xml:id="p1z2"/>catione.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Dabo mox compingendum unum ele<lb xml:id="p1z3"/>gantissime, quem duci mea manu offeram, <lb xml:id="p1z4"/>alterum <persName ref="p458">Brentio</persName>, tertium ego vorabo, <lb xml:id="p1z5"/>quo nomine ago maximas gratias.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Omnia hic salva et pacata.</s>
					<s n="4" xml:lang="la" ana="salute"><persName ref="p974">Molinaeus</persName>, <lb xml:id="p1z7"/><persName ref="p1055">Frektus</persName>, <persName ref="p8113">Volmarius</persName> resalutant te.</s>
					<s n="5" xml:lang="la">Primus <lb xml:id="p1z8"/>horam cras habiturus est orationem <lb xml:id="p1z9"/>in scholis valde acrem adversus bestiam, <lb xml:id="p1z10"/>quippe quae etiam ius civile corruperit suis <lb xml:id="p1z11"/>decretalibus.</s>
					<s n="6" xml:lang="la">Scio fore, ut multi frem<lb xml:id="p1z12"/>ant; verum ego, illos ut mitigem, contin<lb xml:id="p1z13"/>uo dabo imprimendam cum mea prae<lb xml:id="p1z14"/>fatione.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Humana prudentia saepe me <lb xml:id="p1z15"/>monet, ut sileam ac quiescam neque ir<lb xml:id="p1z16"/>ritem et concitem mihi maiorem invidi<lb xml:id="p1z17"/>am; sed spiritus statim adest et illius <lb xml:id="p1z18"/>consilia disturbat.</s>
					<s n="8" xml:lang="la">Non sumus nostri, <lb xml:id="p1z19"/>itaque, etiamsi maxime vellem tacere, <lb xml:id="p1z20"/>dominus non sineret.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Versor nunc <lb xml:id="p1z21"/>in materia antichristi; iuvisti me tuo <lb xml:id="p1z22"/>commentario in epistolam ad Thessalonicenses, unde <lb xml:id="p1z23"/>multa hausi.</s>
					<s n="10" xml:lang="la">At moleste tuli <persName ref="p540">Calvinum</persName> <lb xml:id="p1z24"/>in espositione illorum verborum "nisi vene<lb xml:id="p1z25"/>rit deffectio" ita abs te atque omni<lb xml:id="p1z26"/>bus etiam veteribus dissentire.</s>
					<s n="11" xml:lang="la">Ego tuam <lb xml:id="p1z27"/>sententiam secutus sum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Scribis mira <lb xml:id="p1z28"/>istic nuntiari de nostra <placeName ref="l822">Germania</placeName>; at <pb/><lb xml:id="p2z1"/>nos, qui hic sumus, nihil horum audimus <lb xml:id="p2z2"/>aut certe non talia, quae commendari debeant <lb xml:id="p2z3"/>eo vocabulo "mira"; aut nos hic stertimus, <lb xml:id="p2z4"/>aut vobis falsa nunciantur.</s>
					<s n="13" xml:lang="la">Sum quide<lb xml:id="p2z5"/>m (ob multas graves causas) indiligens in <lb xml:id="p2z6"/>talibus investigandis; sed si mira <lb xml:id="p2z7"/>contingerent, etiam nollens cogerer audire.</s>
					<s n="14" xml:lang="la"><persName ref="p8111">P[etr<lb xml:id="p2z8"/>us] Martyr</persName> tandem vicit et <lb xml:id="p2z9"/><placeName ref="l491">Argentinae</placeName> haerebit.</s>
					<s n="15" xml:lang="la">Commendat mihi <lb xml:id="p2z10"/><persName ref="p6836">Emanuelem</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p6836">Tremellius</persName>?</note>, sanctae linguae professorem, <lb xml:id="p2z11"/>si posset hic conditionem habere, dabo <lb xml:id="p2z12"/>operam.</s>
					<s n="16" xml:lang="la">Accepi abs te missas <lb xml:id="p2z13"/>binas d. <persName ref="p8332">Baionensis</persName> et ago tibi gratias; misi <lb xml:id="p2z14"/>ante triduum quaedam scripta ad eum, quae <lb xml:id="p2z15"/>ille mox ad te misurus est.</s>
					<s n="17" xml:lang="la">Scripsi de <lb xml:id="p2z16"/>tuo Beato rediisse incolumem ex <placeName ref="l2721">Pannonia</placeName> <lb xml:id="p2z17"/><placeName ref="l410">Ratisbonam</placeName> usque; deinde quo profectus <lb xml:id="p2z18"/>sit, ignorari.</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z19"/>Absoluto libello, <lb xml:id="p2z20"/>quem adorno de antichristo aggrediar <lb xml:id="p2z21"/>parum mundam materiam, nempe <lb xml:id="p2z22"/>de lupanaribus, qua in re mire possum <lb xml:id="p2z23"/>exagitare papatum.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="farewell">Vale et salve <lb xml:id="p2z24"/>cum tota familia, schola atque ecclesia.</s>
					<s n="20" xml:lang="la"><lb xml:id="p2z25"/>Orate pro me, quod vos valde oro.</s>
					<s n="21" xml:lang="la"><lb xml:id="p2z26"/><placeName ref="l512">Tubingae</placeName> 26. februarii 1554.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p2z27"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
