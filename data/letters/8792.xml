	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Commendo reverentiae tuae hunc <persName>Stephanum <lb xml:id="p1z2"/>Canensem</persName> Foro-Iuliensem, hominem non ineptum, <lb xml:id="p1z3"/>simulque <placeName ref="l108">Davosium</placeName> iamiam petiturus tuis precibus <lb xml:id="p1z4"/>nos omnes commendamus.</s>
					<s n="3" xml:lang="la">Interea non <persName>Scipionem <lb xml:id="p1z5"/>Calandrinum</persName> <placeName ref="l329">Morbenniensem</placeName> illum esse, qui <lb xml:id="p1z6"/>vulneratus fuerit, sed alium ministrum, Mälensem <lb xml:id="p1z7"/>Laurentiani nomine, de quo tibi superiore tempore <lb xml:id="p1z8"/>scribebam, cum acta synodi nostrae tibi expon<lb xml:id="p1z9"/>erem.</s>
					<s n="4" xml:lang="la">Ita vero, ut scripsi, acciderunt <lb xml:id="p1z10"/>omnia.</s>
					<s n="5" xml:lang="la">Plura non possum.</s>
					<s n="6" xml:lang="la">Deus te <lb xml:id="p1z11"/>nobis patrem servet quam diutissime incolumem.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Amen.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Ocyssime 1572. 25. februarii.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>Attribuerunt nobis domini <lb xml:id="p1z14"/>quendam honestum civem, <lb xml:id="p1z15"/>qui serviat nobis.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae doctori cele<lb xml:id="p2z4"/>berrimo, domino suo <lb xml:id="p2z5"/>singulari observantia <lb xml:id="p2z6"/>colendissimo.</s>
				</p>
				<p>
					<s n="11" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
