	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Cpisto non opulem
					<lb xml:id="p1z2"/>adio.
					<lb xml:id="p1z3"/>educes qu.
					<lb xml:id="p1z4"/>S. Accepi una cum tuis literis Carmeni
					<lb xml:id="p1z5"/>illud elegans, quod tamen, fili dilecte, scripsisti
					<lb xml:id="p1z6"/>Rod. Zui
					<lb xml:id="p1z7"/>in obitum nepotis mei charissimi, ro quo tibi
					<lb xml:id="p1z8"/>gratias ago, quas possum maximas, certo etiam
					<lb xml:id="p1z9"/>relaturus aliqua saltem gratitudinisss
					<lb xml:id="p1z10"/>nificatione. Interim te, mi fili et affinis
					<lb xml:id="p1z11"/>dilectissime, hortor valde, ut in studio et piet
					<lb xml:id="p1z12"/>et literarum progrediaris alacriter
					<lb xml:id="p1z13"/>et utiliter, simul etiam sumptibus parcas, ne
					<lb xml:id="p1z14"/>vmi excrescant atque ita parenti, alioqui
					<lb xml:id="p1z15"/>benvolo, molestiam conduplices. dum ille
					<lb xml:id="p1z16"/>sub meo viveret magisterio et apud extero
					<lb xml:id="p1z17"/>studiorum gratia ageret, stipendio suo, licet
					<lb xml:id="p1z18"/>satis acciso contentus nec inutiles sumptus
					<lb xml:id="p1z19"/>eit nec debitis se creditoribus obstrinxit, mi
					<lb xml:id="p1z20"/>contentus, luxum et voluptates refugit
					<lb xml:id="p1z21"/>e summa cum laude domum ad me rediit. quibus
					<lb xml:id="p1z22"/>cum illo vixerat, dabant illi testimonium.
					<lb xml:id="p1z23"/>vitae frugaliter sobrie caste et modeste per
					<lb xml:id="p1z24"/>quodque tractabilis poter eruditionem non
					<lb xml:id="p1z25"/>vulgarem, non nmum sibi tribuerit, sed
					<lb xml:id="p1z26"/>emonitores libenter audierit, bonaque sugper
					<lb xml:id="p1z27"/>rentibus, cum gratiarum actione obtemperaver
					<lb xml:id="p1z28"/>Eadere possem adhuc epistolas clarorum
					<lb xml:id="p1z29"/>virorum demonstrare. Hoc exemplum pat
					<lb xml:id="p1z30"/>sancten et pulchrum, imitarempotius.
					<lb xml:id="p1z31"/>dilecte, mi fili quam eorum, qui ex schola
					<lb xml:id="p1z32"/>amica didicerunt, ineptis suis illud obtendere,
					<lb xml:id="p1z33"/>portet semel in vita insanire, satius est aute
					<lb xml:id="p1z34"/>id in iuventute quam senectate facere.
					<lb xml:id="p1z35"/>meus opulentus est, qui et ipse aliquando g
					<lb xml:id="p1z36"/>indulsit etc. Id qud de parente tuo  dicere
					<lb xml:id="p1z37"/>non potes; nam ut ex haereditate paterna nihil
					<lb xml:id="p1z38"/>accepit, ita aliquid rerum necessriarum, non opes
					<lb xml:id="p1z39"/>amplas, sibi paravit, prudentisses frugali oecono.
					<lb xml:id="p1z40"/>Sed eo me testem habet, qui a puero ipsum
					<lb xml:id="p1z41"/>aeducavi, quod modessissime et frugaliter cum apud
					<lb xml:id="p1z42"/>me tum apud exteros semper vixit. Hoc itaque pat
					<lb xml:id="p1z43"/>ioptimu et mihi charissime exemplum tibi unice comma
					<lb xml:id="p1z44"/>comendo et te optime valere opto. <placeName ref="l587">Tiguri</placeName> 2. augusti 157.
					<lb xml:id="p1z45"/>Bullingerus senior tuus.
					<lb xml:id="p1z46"/>ut parentis tu.
					<pb/>
					<lb xml:id="p2z1"/>Buttlerum meum salutabis diligentissime,
					<lb xml:id="p2z2"/>cui etiam gratias ago pro omnibus beneficiis
					<lb xml:id="p2z3"/>officiisque Rodolpho meo S exhibitis.
				</p>
			</div>
