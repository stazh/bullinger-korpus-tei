	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D. P.</s>
					<s n="2" xml:lang="de">Ich han üweren brief, 21. octobris geben, empfangen, <lb xml:id="p1z2"/>aber nit zuͦ rechter zyt.</s>
					<s n="3" xml:lang="de">Der bott ist sumig gsin; er <lb xml:id="p1z3"/>hat den brieff nit überantwort.</s>
					<s n="4" xml:lang="de">Darum bitt ich, ir wellen <lb xml:id="p1z4"/>an mich nit zürnen und uns wyter berichten, wie es <lb xml:id="p1z5"/>stande; dann by uns sind mengerley reden; yeder redt <lb xml:id="p1z6"/>nach sinem gunst.</s>
				</p>
				<p>
					<s n="5" xml:lang="de">Wir hand vil papisten und vil keiserisch; <lb xml:id="p1z7"/>da sagt jetlicher nach sinem gevallen.</s>
					<s n="6" xml:lang="de">By uns ist nüt <lb xml:id="p1z8"/>besunders, denn die <placeName ref="l832">Frantzosen</placeName> postieren uß und in on <lb xml:id="p1z9"/>underlaß.</s>
					<s n="7" xml:lang="de">Die keiserischen sind huglich; sy meinen, das <lb xml:id="p1z10"/>glück hab sich zuͦ inen verbunden.</s>
					<s n="8" xml:lang="de">Gott schicke es zuͦ dem <lb xml:id="p1z11"/>besten end.</s>
					<s n="9" xml:lang="de">Unser sünd erfordren söliche straff und noch <lb xml:id="p1z12"/>bösers.</s>
					<s n="10" xml:lang="de">Gott der her syge uns gnädig.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale in domino.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z13"/><placeName ref="l98">Curiae</placeName>, kalendis novembris 1552.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z14"/>Tuus <persName ref="p654">Ioannes Comander</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z15"/>Salutant te <persName ref="p8359">Philippus</persName>, <persName ref="p6130">Pontasella</persName>, <persName ref="p8013">Haimius</persName>, <persName ref="p3196">Tscharnerus</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo doctissimo<lb xml:id="p2z2"/>que viro magistro <lb xml:id="p2z3"/><persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z4"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z5"/>vigilantissimo, domino <lb xml:id="p2z6"/>ac fratri suo colendo.</s>
				</p>
			</div>
		</body>
