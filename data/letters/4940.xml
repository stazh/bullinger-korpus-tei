	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Venerunt huc Expo Augusti Vellium
					<lb xml:id="p1z2"/>Demontanam, diu iam religionis verae gratia affic.
					<lb xml:id="p1z3"/>legati, comitati optimu sene d. Wilhelmofacr
					<lb xml:id="p1z4"/>lopastore Neoconensi ac amplissimu senatua huius
					<lb xml:id="p1z5"/>urbis scriptam obtularunt supplicationem, deinde
					<lb xml:id="p1z6"/>etiam literas obsignatas amplissimus reipublicae Genevensis quo
					<lb xml:id="p1z7"/>ipsorum commendabatur diligentissime. Exposuerunt
					<lb xml:id="p1z8"/>praeterea, quid responso accepissent Basileae Milhusii
					<lb xml:id="p1z9"/>Argentinae et Schaffhusii ac expositionis suae testero
					<lb xml:id="p1z10"/>obsignatas et publicas illarum aliquot rerumpublica literas
					<lb xml:id="p1z11"/>addiderunt, obsecrantes, ut subsidium aliquid laborant
					<lb xml:id="p1z12"/>extrema inopia mitteretur Genevam ad magisrm
					<lb xml:id="p1z13"/>rtInde enim tuto benedictionem illam in Valles
					<lb xml:id="p1z14"/>ipsorum perferri posse. Respondit benigne senatus
					<lb xml:id="p1z15"/>amplissimu sibi caussam hanc curae fore diligenterque e
					<lb xml:id="p1z16"/>mature de ipsa a deputatis consultandum, et quicquid
					<lb xml:id="p1z17"/>argiri voluerint vel Berna vel Geneva mittem.
					<lb xml:id="p1z18"/>tc. Venissent autem recta ad vos, deinde
					<lb xml:id="p1z19"/>profecti fuissent et Clavennam, quoniam vero plium
					<lb xml:id="p1z20"/>et graves causae ipsos absterruerunt et retrarer.
					<lb xml:id="p1z21"/>ex profectione illa difficili ac ego affire
					<lb xml:id="p1z22"/>remministros Curiensis et Rheticarum ecclesiam
					<lb xml:id="p1z23"/>pro singulari sua pietate nihil hic vestes
					<lb xml:id="p1z24"/>mihi in mandatis dederunt, ut cau iporum
					<lb xml:id="p1z25"/>vobis commendarem et supplicatione una cum pa
					<lb xml:id="p1z26"/>capitibus ad vos mitterem. Officium hoc d
					<lb xml:id="p1z27"/>trectare non potui, ideoque nunc scripta mihi
					<lb xml:id="p1z28"/>commissa vobis reverendis viris dominis colendisime
					<lb xml:id="p1z29"/>et fratribus meis charissime mitto, obsecrans
					<lb xml:id="p1z30"/>propter dominum deum nostrum, cuius ministrismus
					<lb xml:id="p1z31"/>ut causam hanc diligenter magistratui vestro
					<lb xml:id="p1z32"/>clarissimo commenditis et inopes iuvetis fratres
					<lb xml:id="p1z33"/>sed et Clavennensibus et quibuscunque putaveritis
					<lb xml:id="p1z34"/>operae precium esse itidem commendetis. Nolo opero
					<lb xml:id="p1z35"/>haec vobis inculcare. Scio ea esse pietatem
					<lb xml:id="p1z36"/>vestram, quae hic nihil sit neglecturus
					<lb xml:id="p1z37"/>ocatus est superioribus diebus clarissime vir d. Petrus
					<lb xml:id="p1z38"/>Martyr in Galliam ad colloquium a rege christi
					<lb xml:id="p1z39"/>stianissimu et a regina matre gubernatrice a seren
					<pb/>
					<lb xml:id="p2z1"/>item regem Navarrae et ab admiraldo
					<lb xml:id="p2z2"/>tafide publica ad menses 4. Ideoque 28.
					<lb xml:id="p2z3"/>augusti dimissus ab amplissimo huius urbis magistratu
					<lb xml:id="p2z4"/>quod felix et faustum sit, abiit. Deducitur in balls
					<lb xml:id="p2z5"/>a nobili quodam misso a serenissimo rege
					<lb xml:id="p2z6"/>Navarrae et a legato regis Galliae d. Coigneti
					<lb xml:id="p2z7"/>qui Saloduri agit et legati munere ad Helvetios
					<lb xml:id="p2z8"/>utitur. Is enim nunc etiam in Galliam abit et
					<lb xml:id="p2z9"/>Petrum in sum comitatum recepit, diligenter commentm
