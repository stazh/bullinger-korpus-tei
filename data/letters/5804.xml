	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non tam cupide, reverende in Christo pater, tu <lb xml:id="p1z2"/>audires, quam ego studiose perscriberem, si quid <lb xml:id="p1z3"/>de concilio rebusque <placeName ref="l834">Italicis</placeName> comperti haberem; sed <lb xml:id="p1z4"/>silent nunc omnia et hoc octiduum amicorum literae <lb xml:id="p1z5"/>prorsus cessant, quas tamen in via esse non dubito.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Audio ex viris fide dignis <placeName ref="l1107">Tridentinos</placeName> patres nihil <lb xml:id="p1z7"/>non moliri pro tyrannidis pontificię firmamento.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Sunt, qui affirment cardinalem <placeName ref="l691">Lotharingum</placeName> cum <lb xml:id="p1z9"/>alio, nescio quo, primario <placeName ref="l425">Romam</placeName> evolasse; <lb xml:id="p1z10"/>causa profectionis non additur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Tibi multum nos <lb xml:id="p1z11"/>debere fatemur omnes, qui non cessas nos edocere <lb xml:id="p1z12"/>de rebus <placeName ref="l832">Gallicis</placeName> et <placeName ref="l822">Germanicis</placeName>; mei vero me <lb xml:id="p1z13"/>non semel pudet, qui, quam referam gratiam, cum non <lb xml:id="p1z14"/>habeam, tuas tamen subinde eliciam.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Remitto <lb xml:id="p1z15"/>tua omnia bona fide et gratias, quas possum, <lb xml:id="p1z16"/>ago maximas; dabo operam, ut brevi quid certi <lb xml:id="p1z17"/>perscribam.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Haec nunc scribo, ut meum silentium honesta <lb xml:id="p1z18"/>aliqua ratione tibi excusem.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Vale, reverende pater, <lb xml:id="p1z19"/>cum tuis omnibus quam felicissime et diutissime.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/><placeName ref="l98">Curię</placeName> 13. iulii anno 1563.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Tui observantissimus <persName ref="p8009">Ioan[nes] Fab[ricius</persName>].</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Has literas, <lb xml:id="p1z22"/>quas ideo cum tuis compegi, <lb xml:id="p1z23"/>ne solae amitterentur, quaeso, pro tua <lb xml:id="p1z25"/>singulari humanitate d. <persName ref="p4554">Collino</persName> <lb xml:id="p1z26"/>reddendas cures.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro omni<lb xml:id="p2z2"/>gena eruditione et pietate <lb xml:id="p2z3"/>instructissimo d. <persName ref="p495">Heinrycho <lb xml:id="p2z4"/>Bullingero</persName>, d. et patri <lb xml:id="p2z5"/>suo in Christo unice <lb xml:id="p2z6"/>reverendo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>