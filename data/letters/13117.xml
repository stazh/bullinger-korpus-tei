	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Libellum de reformatione <placeName ref="l830">Anglica</placeName> ad te missum, si dignum esse <lb xml:id="p1z2"/>fide putas, oro, d. <persName ref="p8055">Ambrosio Blaurero</persName> meo nomine transmittere digneris.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Anxie enim ipsum habere et legere cupit.</s>
					<s n="4" xml:lang="la">Demum ipse curabit, ut ali<lb xml:id="p1z4"/>quando ad me revertatur.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="5" xml:lang="la">Non vacabat plura scribere ob abiturientem <lb xml:id="p1z5"/>tabellarium<note xml:id="fn3" type="footnote" n="3">Unbekannt.</note>.</s>
					<s n="6" xml:lang="la">Scripsi haec propemodum stans pede in uno.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z6"/>Valebis igitur per Christi gratiam et, ubi vacarit, ad me non gravatim scri<lb xml:id="p1z7"/>bes.</s>
					<s n="8" xml:lang="la"><placeName ref="l473">Sangalli</placeName>, tertio nonas novembres anno 1547.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z8"/><persName ref="p8049">Ioachimus Vadianus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrycho Bullingero</persName>, <lb xml:id="p2z2"/>clarę urbis <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>praesidi, domino suo <lb xml:id="p2z4"/>et amico colendissimo<lb xml:id="p2z5"/>.</s>
				</p>
			</div>
		</body>
	</text>
