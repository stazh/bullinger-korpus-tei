				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quid rebus adeo perplexis et perturbatis ad <lb xml:id="p1z2"/>te scribam, reverende pater, non habeo.</s>
					<s n="3" xml:lang="la">Episcopi <lb xml:id="p1z3"/>causa haeret adhuc.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Viceramus, si qui victoria <lb xml:id="p1z4"/>uti voluissent; nunc cessantibus nostris <lb xml:id="p1z5"/>exitum rei nondum satis perspicio.</s>
					<s n="5" xml:lang="la">Hic <lb xml:id="p1z6"/>comitia futura fuerant; <placeName ref="l646">Glaronenses</placeName> <lb xml:id="p1z7"/>iis causam dederant.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Sed <placeName ref="l2592">Superioris Foederis</placeName> <lb xml:id="p1z8"/>homines et ipsi et <lb xml:id="p1z9"/>ipsi int<lb xml:id="p1z10"/>er se s<lb xml:id="p1z11"/>epara<lb xml:id="p1z12"/>tim conventu<lb xml:id="p1z13"/>s agita<lb xml:id="p1z14"/>nt, et r<lb xml:id="p1z15"/>es <placeName ref="l646">Glaronen<lb xml:id="p1z16"/>siu<lb xml:id="p1z17"/>m</placeName>, quod <lb xml:id="p1z18"/>a<lb xml:id="p1z19"/>d illo<lb xml:id="p1z20"/>s, <lb xml:id="p1z21"/><placeName ref="l2592">Superioris Foederis</placeName> homines<lb xml:id="p1z22"/>, <lb xml:id="p1z23"/>attinet, <lb xml:id="p1z24"/>vide<lb xml:id="p1z25"/>tur i<pb/><lb xml:id="p2z1"/>n lu<lb xml:id="p2z2"/>brico sita.</s>
					<s n="7" xml:lang="la"><lb xml:id="p2z3"/>Hoc e<lb xml:id="p2z4"/>go mu<lb xml:id="p2z5"/>lto ti<lb xml:id="p2z6"/>meb<lb xml:id="p2z7"/>a<lb xml:id="p2z8"/>m ante<lb xml:id="p2z9"/>, ideoque om<lb xml:id="p2z10"/>n<lb xml:id="p2z11"/>is mo<lb xml:id="p2z13"/>ra m<lb xml:id="p2z14"/>i<lb xml:id="p2z15"/>hi</s>
				</p>
