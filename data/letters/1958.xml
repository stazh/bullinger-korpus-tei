	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l491">Argentinae</placeName>, 16. augusti 155<lb xml:id="p1z2"/>3.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">S. <lb xml:id="p1z3"/>P.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Quae scripsi in prioribus iis literis, <persName ref="p495">Bullingere</persName> <lb xml:id="p1z5"/>colende, in dies confirmantur et scriptis optimorum virorum <lb xml:id="p1z6"/>augentur.</s>
					<s n="4" xml:lang="la">Hor[r]enda portendaque aluit monstrum <lb xml:id="p1z7"/>illud verius quam homo, dux <placeName ref="l2590">Northumbriae</placeName>: regem <lb xml:id="p1z8"/>optimum nostrum scribit quidem fide dignus indignissime <lb xml:id="p1z9"/>sublatum veneno.</s>
					<s n="5" xml:lang="la">Priusquam mortuus est, deciderunt <lb xml:id="p1z10"/>ungues et capillitium, adeo ut plane omnem amiserat <lb xml:id="p1z11"/>formam ali[o]qui formosissimus.</s>
					<s n="6" xml:lang="la">Puduit autores <lb xml:id="p1z12"/>venefitii corpus defuncti regis spectandum in exe<lb xml:id="p1z13"/>quiis populo (ut moris est) praeponere; proinde <lb xml:id="p1z14"/>in vivario suo palatio adiu[n]cto clam sepelierunt <lb xml:id="p1z15"/>et iuvenem non adeo ei dissimilem, quem in<lb xml:id="p1z16"/>terfecerant ferro, eius loco spectandum posuerunt.</s>
					<s n="7" xml:lang="la">Haec co[<lb xml:id="p1z17"/>n]fessus<note type="margin">a.R.: confessuus</note> est unus ex ducis <placeName ref="l2590">Northumbriae</placeName> filiis.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z18"/>Dux cum quinque filiis ac nobilibus fere viginti <lb xml:id="p1z19"/>captus est, inter quos et dominus <persName ref="p591">Chekus</persName>, dominus <lb xml:id="p1z20"/>doctor <persName ref="p672">Coxeus</persName> et episcopus <placeName ref="l296">Londoniensis</placeName> cum aliis tibi <lb xml:id="p1z21"/>neque nomine neque fama notis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Hos consentiisse[?] creditur <lb xml:id="p1z22"/>atque patrocinas[s]e, ut <persName>Iohanna</persName>, uxor filii ducis, decla<lb xml:id="p1z23"/>rata foret regina; quodsi verum fuerit, actum <lb xml:id="p1z24"/>est de illis.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/>Rex <placeName ref="l832">Galliae</placeName> scripsit ad civitatem <placeName ref="l2235">Calais</placeName><note type="margin">a.R.: <placeName>Calleß</placeName></note> et <lb xml:id="p1z26"/><placeName ref="l2625">Guines</placeName><note type="margin">a.R.: <placeName ref="l2625">Guynes</placeName></note>, ut cives discederent sedibus sibique civitatem <lb xml:id="p1z27"/>et castrum <placeName ref="l2625">Guines</placeName><note type="margin">a.R.: <placeName ref="l2625">Guynes</placeName></note> vacuum relinquerent; id <lb xml:id="p1z28"/>sibi promissum fuisse a consiliariis <placeName ref="l830">Angliae</placeName>.</s>
					<s n="11" xml:lang="la">Dux u<lb xml:id="p1z29"/>na c<lb xml:id="p1z30"/>um secum captivis arbitrantur huius facinoris rei.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z31"/>In <placeName ref="l830">Anglia</placeName> colligitur miles ad civitatem et territori<lb xml:id="p1z32"/>um muniendum.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z33"/>Vereor, ne <placeName ref="l862">Helvetii</placeName> vestri in nostros <lb xml:id="p1z34"/>fueri<lb xml:id="p1z35"/>nt<note type="margin">a.R.: fuerant</note> collecti.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z36"/>Vides, <persName ref="p495">Bullingere</persName> amicissime, quam privatus sis <lb xml:id="p1z37"/>omni expectatione tua de <placeName ref="l830">Anglia</placeName> nostra; proinde <lb xml:id="p1z38"/>vide, quid statuendum de filio.</s>
					<s n="15" xml:lang="la">Meae aedes <lb xml:id="p1z39"/>ei patent, nec deerit auxilium.</s>
					<s n="16" xml:lang="la" ana="salute">Bene vale <lb xml:id="p1z40"/>et diligenter, obsecro, salutes doctos omnes, gratiasque vobis omnibus habeo ing<lb xml:id="p1z41"/>entes pro humani[ta]te mihi ostensa.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Tuus <persName ref="p505">Burcherus</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="de">Dem ffurnemmen, wysen hern <persName ref="p495">Heynrych Bullynger</persName>, myne<lb xml:id="p1z42"/>m güns<lb xml:id="p1z43"/>tigen hern praedycanten.</s>
				</p>
				<p>
					<s n="19" xml:lang="de"><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
