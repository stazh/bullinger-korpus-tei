	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>P.
					<lb xml:id="p1z2"/>studium meum et operam omni tempore paratissimam
					<lb xml:id="p1z3"/>quam possum studiosissime ad te defero, clarissime
					<lb xml:id="p1z4"/>domine maecenas. Generosus atque doctissimus comes,
					<lb xml:id="p1z5"/>una cum concionatore regiae dignitatis Maximiliani
					<lb xml:id="p1z6"/>petiere, ut illis occasionem darem te accedendi, cum mihi
					<lb xml:id="p1z7"/>semper fueris colendissimus praeceptore tuumque animum
					<lb xml:id="p1z8"/>pium et bonum erga me semper animadvertterim tum
					<lb xml:id="p1z9"/>etiam erga omnes pios intermittere non potui, quin tua
					<lb xml:id="p1z10"/>humanitatem, quantum possam rogarem et illos, ut
					<lb xml:id="p1z11"/>excipias, ut sentiant me tibi charum esse et cum
					<lb xml:id="p1z12"/>sacramenti mentio facta fuerit, illis diffecentiam
					<lb xml:id="p1z13"/>inter nos et Lutheranos ostendas, quam ob causam
					<lb xml:id="p1z14"/>maxime accenut, me cum antea valde, nunc
					<lb xml:id="p1z15"/>omnino habebis devinctissimum, uxorem tuam honestissimum
					<lb xml:id="p1z16"/>una cum prolibus et domino meo Lavatero eiusque uxore et
					<lb xml:id="p1z17"/>filio foelici meo nomine plurimum salutabis. Darae faver
					<lb xml:id="p1z18"/>spurgii 18. aprilis et5.
					<lb xml:id="p1z19"/>tui studiosissimus.
					<lb xml:id="p1z20"/>Bregerig Karlin
					<pb/>
					<lb xml:id="p2z1"/>Clarissimo atque doctissimo
					<lb xml:id="p2z2"/>maximeque pro virio
					<lb xml:id="p2z3"/>magistro Henrico
					<lb xml:id="p2z4"/>Bullingero, domino
					<lb xml:id="p2z5"/>moecenati atque praeceptr
					<lb xml:id="p2z6"/>suo colendissimo.
					<lb xml:id="p2z7"/>Tiguri.
				</p>
			</div>
		</body>
	</text>
