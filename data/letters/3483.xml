	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l2235">Caletum</placeName> arx et civitas nono huius m(ensis) <lb xml:id="p1z2"/>die capta est, arx vi, civitas deditione.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Qua ratione res gesta sit, ex literis, quas <lb xml:id="p1z4"/>ad d. d. <placeName ref="l587">Tigurinos</placeName> scribo, poteris cognoscere.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Magna omnino res gesta est; deus reliquum <lb xml:id="p1z6"/>belli successum fortunet.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><placeName ref="l760">S[olodori]</placeName> 19a i<lb xml:id="p1z7"/>a(nuarii).</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Tuus <persName ref="p8183">Sanlaurentianus</persName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo theologo d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>.</s>
				</p>
			</div>
		</body>
	</text>
