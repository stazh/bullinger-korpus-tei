	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Sunder gunstiger, lieber herr.</s>
					<s n="2" xml:lang="de">Mir ist die zeit zu <lb xml:id="p1z2"/>kurz, euch, wie es umb <placeName ref="l257">Costanz</placeName> gestaltett, zu <lb xml:id="p1z3"/>schr[e]iben, hab aber <persName>Clausen</persName> von <placeName ref="l1821">Walesselen</placeName><note xml:id="fn1" type="footnote" n="1"><placeName ref="l1821">Wallisellen</placeName>?</note>, <lb xml:id="p1z4"/>briezaiger, bevolhen, euch, so vil sich unserem <lb xml:id="p1z5"/>dasein zugetragen und unß bewust, anzuzeigen.</s>
					<s n="3" xml:lang="de"><lb xml:id="p1z6"/>Der herr welle gnad und bessere mittel <lb xml:id="p1z7"/>furwenden und das bald; dan es nahend <lb xml:id="p1z8"/>am zweckh, wie ir vernemen werdend.</s>
					<s n="4" xml:lang="de"><lb xml:id="p1z9"/>Hiemit der eur <persName ref="p8498">M[arcell] <lb xml:id="p1z10"/>Dietrich</persName> etc.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="5" xml:lang="de"><pb/><lb xml:id="p2z1"/>Hernn <persName ref="p495">Hainrichen Bullinger</persName> zh<lb xml:id="p2z2"/>anden.</s>
					<s n="6" xml:lang="la">[Fall <lb xml:id="p2z3"/><placeName ref="l257">Con<lb xml:id="p2z4"/>stanz</placeName>'s 1548.]</s>
				</p>
			</div>
		</body>
