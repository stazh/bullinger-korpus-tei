	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Paucis post diebus, quam meas ad te, vir clarissime, <lb xml:id="p1z2"/>misissem <placeName ref="l157">Francofortum</placeName>, redditę mihi sunt etiam tę ad diem <lb xml:id="p1z3"/>20. inquam septembris.</s>
					<s n="3" xml:lang="la">Itaque visum fuit tribus saltem <lb xml:id="p1z4"/>verbis id nunc significare.</s>
					<s n="4" xml:lang="la">Doleo autem ob affectam tuam <lb xml:id="p1z5"/>valetudinem atque perpetuos capitis dolores, quibus te graviter <lb xml:id="p1z6"/>molestari ais.</s>
					<s n="5" xml:lang="la">Hęc ętas, tot labores ad tot annos sine <lb xml:id="p1z7"/>intermissione exhausti vires non attenuant modo, sed paulatim <lb xml:id="p1z8"/>plane frangunt.</s>
					<s n="6" xml:lang="la">Sed pater cęlestis haud dubie bene vertet, <lb xml:id="p1z9"/>quicquid isthuc est incommodi.</s>
					<s n="7" xml:lang="la">Certe concio, quam ad me misisti, <lb xml:id="p1z10"/>inscripta De salute credentium, nihil de donis spiritus in <lb xml:id="p1z11"/>te esse diminutum, quin potius auctiora et illustriora quotidie <lb xml:id="p1z12"/>reddi omnia abunde arguit.</s>
					<s n="8" xml:lang="la">Ubi autem spiritus fit vegetior <lb xml:id="p1z13"/>atque domini ille spiritus tam potenter sese exerit, ibi corporis <lb xml:id="p1z14"/>debilitas ęquiore ferri animo poterit.</s>
					<s n="9" xml:lang="la">Ago vero pro ea concione <lb xml:id="p1z15"/>gratias quam possum maximas, non tam quod a te profecta <lb xml:id="p1z16"/>est atque animo benevolo ad me missum scio, quam quod eius <lb xml:id="p1z17"/>lectione ipse sentio animum meum mirifice confirmatum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Quod ad <lb xml:id="p1z18"/>filium tuum <persName ref="p495">Henricum Bullingerum</persName> attinet, audio eum <lb xml:id="p1z19"/><placeName ref="l157">Francoforto</placeName> profectum recta <placeName ref="l558">Vitebergam</placeName>; si tamen contigerit eum <lb xml:id="p1z20"/>venire <placeName ref="l311">Marpurgum</placeName>, dabo operam, ut ne dicere unquam possit <lb xml:id="p1z21"/>se officium in me desiderasse; recipiam eum in meas ędes <lb xml:id="p1z22"/>et, quod licebit, pręstabo perquam libenter.</s>
					<s n="11" xml:lang="la">Literas ad d. <lb xml:id="p1z23"/><persName ref="p1903">Ioannem Leningum</persName> curabo quam primum perferri <placeName>Molosin<lb xml:id="p1z24"/>gum</placeName>.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale.</s>
					<s n="13" xml:lang="la">Raptim.</s>
					<s n="14" xml:lang="de"><placeName ref="l311">Marpurgi</placeName> die 23. septembris <lb xml:id="p1z25"/>1555.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p8386">Andreas Hyperius</persName> <lb xml:id="p1z27"/>tuus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, ecclesię <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> antistiti longe <lb xml:id="p2z4"/>dignissimo, domino suo <lb xml:id="p2z5"/>observando.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
