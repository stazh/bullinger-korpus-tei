	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam a deo etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Si non perspectum haberemus animum tuum, <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z2"/>ergo quosvis studiosos, praesertim ecclesiae nostrae alumnos, multis <lb xml:id="p1z3"/>fortasse ambagibus te obtunderemus.</s>
					<s n="3" xml:lang="la">Nunc autem, cum te hactenus patrem <lb xml:id="p1z4"/>erga nostrates praestiteris, oramus, ut et hunc nostrum latorem harum <lb xml:id="p1z5"/>ea, qua caeteros cura fovere velis.</s>
					<s n="4" xml:lang="la">Gentis et patriciae et satis <lb xml:id="p1z6"/>pius, neque dubitamus, quin per eos annos, quibus <placeName ref="l491">Argentorati</placeName> dedit <lb xml:id="p1z7"/>operam literis, satis diligens fuerit, id quod testantur ipsius literae <lb xml:id="p1z8"/>testimoniales.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Nunc iussu dominorum scholarcharum ad vos proficiscitur, <lb xml:id="p1z9"/>ut sacras discat literas.</s>
					<s n="6" xml:lang="la">Eum igitur si cum caeteris nostratibus in severiore <lb xml:id="p1z10"/>disciplina retinueritis, rem facietis dominis scholarchis acceptissimam, <lb xml:id="p1z11"/>deo veo gratam.</s>
					<s n="7" xml:lang="la">Literas, quas ad nos misisti, ut <placeName ref="l512">Tubingam</placeName> <lb xml:id="p1z12"/>mitteremus, tandem huius mensis 25. una cum iis, quas Iacobo trans<lb xml:id="p1z13"/>miseras, per illum studiosum, qui d. <persName ref="p1283">Gessnerum</persName> comitatus est, curavimus <lb xml:id="p1z14"/>illuc perferendas; citius non potuimus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Non potuimus citius [ne]que a nobis s<lb xml:id="p1z15"/>tetit, quominus illuc iamdudum perlatae fuissent.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">N [ovi] nihil habemus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute"><lb xml:id="p1z16"/>Salutem dicito nomine meo d. d. <persName ref="p8111">Martyri</persName>, <persName ref="p8171">Bibliandro</persName>, <persName ref="p8011">Gvalthero</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Dominus <lb xml:id="p1z17"/>conservet te ecclesiae suae diu incolumem, frater ac domine in Christo obser<lb xml:id="p1z18"/>vande.</s>
					<s n="12" xml:lang="la" ana="salute">Salutant te symmystae mei.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l441">Scaffhusii</placeName> anno <lb xml:id="p1z19"/>ab orbe redempto 1559. 6. kalendas maii.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z20"/>Tuus ex animo <lb xml:id="p1z21"/><persName ref="p3481">Simpertus Vogt</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietate, candore atque eruditione <lb xml:id="p2z2"/>praestantissimo d. <persName ref="p495">Henrycho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> urbis <lb xml:id="p2z4"/>pastori vigilantissimo, <lb xml:id="p2z5"/>fratri ac <lb xml:id="p2z6"/>domino suo o<lb xml:id="p2z7"/>bservando.</s>
					<s n="17" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
