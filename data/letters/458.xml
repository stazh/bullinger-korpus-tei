	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l491">Argentinae</placeName> 12. Martii 1549.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>S. P.</s>
					<s n="3" xml:lang="la">Res quidem misera et lachrimis digna se nobis ob<lb xml:id="p1z3"/>tulit <placeName ref="l491">Argentinensibus</placeName> scribenda.</s>
					<s n="4" xml:lang="la"><persName ref="p467">Bucerus</persName>, atque ille, um eloquentior <lb xml:id="p1z4"/>tum meo juditio solide doctior, <persName ref="p4744">Paulus Fagius</persName>, ab concionatoris <lb xml:id="p1z5"/>functionibus depositi sunt magistratus autoritate, civitatemque <lb xml:id="p1z6"/>cogentur relinquere, ni vellent in Caesaris manu tradi.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Reliquos adhuc concionatores habemus, nihilque immutatum est, <lb xml:id="p1z8"/>quam quod cogimur piscibus quadragesima hac vesci, atque <lb xml:id="p1z9"/>Veneris et Sabati diebus per totum annum.</s>
					<s n="6" xml:lang="la">Episcopus expectatur <lb xml:id="p1z10"/>indies, qui quicquid immutaverit, per literas <lb xml:id="p1z11"/>meas intelliges.</s>
					<s n="7" xml:lang="la">Accepi jam primum ab <placeName ref="l830">Anglia</placeName> literas, in <lb xml:id="p1z12"/>quibus nihil novi est.</s>
					<s n="8" xml:lang="la">Nihil parleamenti decreto publicatum <lb xml:id="p1z13"/>est.</s>
					<s n="9" xml:lang="la">Caesaris filius hodie, ut fertur, <placeName ref="l210">Heidelbergam</placeName> <lb xml:id="p1z14"/>venit, comitatus duce <persName ref="p18250">Mauricio</persName> et aliis.</s>
					<s n="10" xml:lang="la">In <lb xml:id="p1z15"/><placeName ref="l749">Saxonia</placeName> audio graviter ferre <placeName ref="l749">Saxones</placeName> ab evangelio <lb xml:id="p1z16"/>ad Interim trudi.</s>
					<s n="11" xml:lang="la">Civitates maritimas<note xml:id="fn1" type="footnote" n="1">die Hansestädte ("Seestädte").</note> fama est <lb xml:id="p1z17"/>Caesari respondisse, Interim se non posse recipere.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z18"/>Regem <placeName ref="l855">Daciae</placeName>, <placeName ref="l2472">Poloniae</placeName>, et ducem aliquem, ni fallor, <lb xml:id="p1z19"/><placeName ref="l449">Slesiae</placeName>, cum maritimis civitatibus foedus iniisse fertur.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z20"/>Haec habui, quae modo paucis scriberem, ne te me <lb xml:id="p1z21"/>oblitum accuses.</s>
					<s n="14" xml:lang="la">Alio me vocant negotia, neque sinunt <lb xml:id="p1z22"/>in iis diutius immorari.</s>
					<s n="15" xml:lang="la">Scripsit ad me <persName ref="p1560">Hoperus</persName> noster <lb xml:id="p1z23"/>bene convenisse <placeName ref="l862">Helvetios</placeName>, quod utinam verum esset; verum <lb xml:id="p1z24"/>eadem a te scire cupio.</s>
					<s n="16" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z25"/>Tuus, quem nosti, <persName ref="p505">J[oan<pb/><lb xml:id="p2z1"/>nes] B[urcherus</persName>].</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="18" xml:lang="de">Dem ersamen, <lb xml:id="p2z2"/>wisen hern <persName ref="p495">Bullinger</persName>, predi<lb xml:id="p2z3"/>canten, mynem gun<lb xml:id="p2z4"/>stigen hern und freundt, <lb xml:id="p2z5"/>wonhaft vor dem <lb xml:id="p2z6"/>Muster.</s>
					<s n="19" xml:lang="de"><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>