	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Min willig dienst bevoran. Günstiger, lieber herr
					<lb xml:id="p1z2"/>und bruͦder schrybend flyssig uff üwer ynkummen
					<lb xml:id="p1z3"/>und nutz uwer pfrund, was ir von und uß iren
					<lb xml:id="p1z4"/>gäntzlich habind, und schickend mirs zuͦ; dann die
					<lb xml:id="p1z5"/>wyl man üwer pfruͦnd halbzehandlen willes ist, muß
					<lb xml:id="p1z6"/>all üwer iusabens und ynkumens ein wüssen
					<lb xml:id="p1z7"/>haben. Gott mitt üch. Datum 25. februarii 1559.
					<lb xml:id="p1z8"/>Bullingerus tuus.
					<pb/>
					<lb xml:id="p2z1"/>Dem frommen, wolgelerten
					<lb xml:id="p2z2"/>und getruwen h. Hansen
					<lb xml:id="p2z3"/>Rrodolffen Stumppffen pfarren
					<lb xml:id="p2z4"/>zuͦ Kylclber
					<lb xml:id="p2z5"/>lieben herren und
					<lb xml:id="p2z6"/>Kylchberg
				</p>
			</div>
		</body>
	</text>
