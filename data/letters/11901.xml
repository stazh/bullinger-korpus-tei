	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia et pax etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Ut res humane caduce sunt et mortales, factum est, ut praesidium carnale multorum <lb xml:id="p1z2"/>debitum universe carnis solverit<note xml:id="fn1" type="footnote" n="1">Als formelhafte Redewendung seit dem Mittelalter belegt; s. etwa Gesta Innocentii III., <bibl source="b446">MPL</bibl> CCXIV, Sp. XXXIX u.a.</note>, <persName ref="p8401">Contzenus</persName> scilicet<note xml:id="fn2" type="footnote" n="2"><persName ref="p8401">Peter Kunz</persName> war am 11. Februar gestorben; s. oben <ref target="file11887">Nr. 1841</ref>, Anm. 66.</note>.</s>
					<s n="3" xml:lang="la">Post hac non valde pertimescendi duo superstites <lb xml:id="p1z3"/>Lutherane factionis;<note xml:id="fn3" type="footnote" n="3"><persName ref="p3099">Simon Sulzer</persName> und <persName ref="p8364">Beat Gering</persName>; zu ihrer fragwürdigen Charakterisierung als Lutheraner s. Amy Nelson <hi>Burnett,</hi> The Myth of the Swiss Lutherans: Martin Bucer and the Eucharistic Controversy in Bern, in: <bibl source="b714">Zwa</bibl> 32, 2005, 45-70.</note> nam incertum est, num illis adiiciendus sit tercius, imo nobis non minor spes est <lb xml:id="p1z4"/>de veritatis pio patrono, quare et vestrum erit vestras admovere manus auxiliatrices, ut ecclesia nostra <lb xml:id="p1z5"/>ab isto onere levetur.</s>
					<s n="4" xml:lang="la">Quod si vero nullus adiungetur, nihilominus maiori et spe et fructu pugnabimus; <lb xml:id="p1z6"/>nam <persName ref="p8401">Contzeni</persName> importunitati concedendum erat plurimum, ne simul totum edificium destrueretur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Adolescens <lb xml:id="p1z7"/>hic<note xml:id="fn4" type="footnote" n="4">Unbekannt.</note>, qui has meas ad te perfert litteras, a nobis anno elapso est receptus sicque vixit, ut forsitan<note xml:id="fna" type="footnote" n="a"><hi>Am Wortende ein gestrichener Buchstabe.</hi></note> <lb xml:id="p1z8"/>propediem ad munus diaconatus vocabitur.</s>
					<s n="6" xml:lang="la">Tu moneto, ne aliam quam sinceram et piam doctrinam et claram <lb xml:id="p1z9"/>professionem imitetur, quae<note xml:id="fnb" type="footnote" n="b"><hi>Vor</hi> quae <hi>gestrichenes</hi> quam eam.</note> vulgata hactenus in ecclesiis <placeName ref="l862">Helveticis</placeName>.<pb type="edition" next="108"/></s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Saluta meo nomine fratres omnes.</s>
				</p>
				<p>
					<s n="8" xml:lang="de"><lb xml:id="p1z10"/>Datum <placeName ref="l41">Berne</placeName>, 23. februarii 1544.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z11"/><persName ref="p2810">Erasmus Ritter</persName> <lb xml:id="p1z12"/>ex animo tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Et pio et docto viro domino <persName ref="p495">Henrichio <lb xml:id="p2z2"/>Bullingero</persName><note xml:id="fnc" type="footnote" n="c"><hi>Vor</hi> <persName ref="p495">Bullingero</persName> <hi>gestrichenes</hi> Bl.</note>, ecclesie <placeName ref="l587">Tigurine</placeName> antistiti, <lb xml:id="p2z3"/>fratri charissimo.</s>
				</p>
			</div>
		</body>
