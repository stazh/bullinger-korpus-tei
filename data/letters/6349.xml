	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Innsonders lieber herr gfatter.</s>
				</p>
				<p>
					<s n="2" xml:lang="de">Dem doctor <persName>Thadeo</persName> ist geordnet <lb xml:id="p1z2"/>jerlich inn die frovasten abteilt 12 m[utt] k[ernen], 40 gl. und im herpst <lb xml:id="p1z3"/>samenthafft 8 eimer wyn.</s>
				</p>
				<p>
					<s n="3" xml:lang="de"><lb xml:id="p1z4"/>Und gitt man imm yetzt mittwuchen 3 mu[tt] k[ernen] 10 gl. und 3 eimer wyn <lb xml:id="p1z5"/>vomm 64. jar.</s>
					<s n="4" xml:lang="de">Ü[<lb xml:id="p1z6"/>wer]guͦtwilliger gfatter <lb xml:id="p1z7"/><persName ref="p3015">Bern[hard] Spr[üngli]</persName>.</s>
				</p>
				<p>
					<note type="address">[Ohne Adresse.]</note>
				</p>
			</div>
		</body>
	</text>
