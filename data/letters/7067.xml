	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scrpsi ante biduum.</s>
					<s n="3" xml:lang="la">His nihil habeo quod addam, nisi <lb xml:id="p1z2"/>quod interea auditus est comes Anguisolae, legatus <lb xml:id="p1z3"/><placeName ref="l875">Hispani</placeName>.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Petiit transitum, non quidem per terras dominorum <lb xml:id="p1z4"/>nostrorum, sed prope illas et bona verba dedit.</s>
					<s n="5" xml:lang="la">Hoc quo<lb xml:id="p1z5"/>niam impediri non potuit extra fines nostros, illi, ut audio <lb xml:id="p1z6"/>est concessum, <foreign xml:lang="de">so vil min herren blanget.</foreign></s>
					<s n="6" xml:lang="de">Acht wol, es werd <lb xml:id="p1z7"/>jetz auch uff den tag kon für gmein <placeName ref="l862">Eidtgnossen</placeName>.</s>
					<s n="7" xml:lang="la">Cum <lb xml:id="p1z8"/><placeName ref="l922">Friburgensibus</placeName> interea nihil est actum.</s>
					<s n="8" xml:lang="la">Expecto, quid tibi <lb xml:id="p1z9"/>afferatur ex nundinis his <placeName ref="l157">Francofurdianis</placeName>.</s>
					<s n="9" xml:lang="la">Nostros mer<lb xml:id="p1z10"/>catores quotidie expectamus.</s>
					<s n="10" xml:lang="la">Poteris per hunc mittere, <lb xml:id="p1z11"/>si quę habueris.</s>
					<s n="11" xml:lang="la">Deperit is adhuc illam puellam, et cupio <lb xml:id="p1z12"/>per vos aut vestratium aliquos cum domino <persName ref="p20864">de Mülinen</persName> agi, <lb xml:id="p1z13"/>ut ei in matrimonium concedatur.</s>
					<s n="12" xml:lang="la">Mihi hoc imponere <lb xml:id="p1z14"/>voluit; sed malo per alios hoc cum ipso agi, ut cum maio<lb xml:id="p1z15"/>re pondere fiat.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute"><persName ref="p396">Blasius</persName> meus heri iterum discessit; <lb xml:id="p1z16"/>is te plurimum salutat.</s>
					<s n="14" xml:lang="la"><persName ref="p8417">Musculo</persName> nostro hodie duo pueri<lb xml:id="p1z17"/>, qui tamen non ex suis sunt, peste obiere; ita subinde <lb xml:id="p1z18"/>malum hoc recurrit.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Dominus servet ipsum et nos omnes a malo!</s>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z19"/>Salutant te nostri omnes.</s>
					<s n="17" xml:lang="la">Fratri nihil nunc scribo.</s>
					<s n="18" xml:lang="la" ana="salute">Saluta er<lb xml:id="p1z20"/>go eum meo nomine cum tuis omnibus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l41">Bernae</placeName> 5. aprilis 15<lb xml:id="p1z21"/>57.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><persName ref="p8018">I[ohannes] <lb xml:id="p1z22"/>Hallerus</persName> tuus.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino meo <lb xml:id="p2z4"/>honorando et compatri cha<lb xml:id="p2z5"/>rissimo.</s>
				</p>
			</div>
		</body>
	</text>
