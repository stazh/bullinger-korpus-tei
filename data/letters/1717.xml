	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a deo patre nostro per dominum nostrum Iesum Christum.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Tabellarium nactus ydoneum non sustinui, ut absque literis meis te adiret, <lb xml:id="p1z3"/>neque decuit; non quod pluribus tecum agerem, nam ad proximas praeteritas <lb xml:id="p1z4"/>nundinas scripsi, que habebam; interim nihil amplius accidit scriptu <lb xml:id="p1z5"/>dignum, et praesertim cum <persName ref="p3196">Tscharnerus</persName>, unus ex senatoribus et mercatoribus <lb xml:id="p1z6"/>notissimis, melius de singulis disserere norit<note type="margin">a.R.: ... novit/ Bemerkung am Schluss: deutlich "norut"</note> quam ego scribere.</s>
					<s n="3" xml:lang="la">Tabellarius <lb xml:id="p1z7"/>ille, qui tibi meas novissimas reddidit literas, <persName ref="p8013">Haimii</persName> gener, nihil <lb xml:id="p1z8"/>retulit nec literas nec verbum aliquod, nec illum domi suae offendere <lb xml:id="p1z9"/>potui nec uspiam deprehendere, ut interrogarem etc.</s>
					<s n="4" xml:lang="la" ana="farewell">Vale.</s>
					<s n="5" xml:lang="la">Ex <placeName ref="l98">Curia</placeName> <lb xml:id="p1z10"/><placeName ref="l648">Rhetiae</placeName>, 13. septembris 1552.</s>
					<s n="6" xml:lang="la" ana="salute">Salutant te pii fratres <persName ref="p8013">Haimius</persName>, <lb xml:id="p1z11"/><persName ref="p8359">Philippus</persName> et <persName ref="p6130">Pontasella</persName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Tuus <persName ref="p654">Ioannes Comander</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro <lb xml:id="p2z2"/>magistro <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z4"/>ecclesiae antistiti, <lb xml:id="p2z5"/>domino suo colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
