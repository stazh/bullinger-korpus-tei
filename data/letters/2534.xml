	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quid mecum hic fiat et factum sit, ex fratris literis, opi<lb xml:id="p1z2"/>nor, intellexisti.</s>
					<s n="3" xml:lang="la">Haberem multa, quę te scire <lb xml:id="p1z3"/>referret; sed literis talia committere non est tutum.</s>
					<s n="4" xml:lang="la">Partem <lb xml:id="p1z4"/>tu una mecum licet absens huius tragoediae <lb xml:id="p1z5"/>sustinuisti.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><persName>Wingartnerus</persName> adhuc furit; <persName ref="p2305">Negelinus</persName> <lb xml:id="p1z6"/>mox, atque audivit meam apologiam, mitior <lb xml:id="p1z7"/>factus est; non enim de ipsis legatis mihi sermo <lb xml:id="p1z8"/>fuit, sed de re ipsa.</s>
					<s n="6" xml:lang="la">Hodie in ipsum incidi et satis <lb xml:id="p1z9"/>propitium ex ipsius sermonibus cognovi.</s>
					<s n="7" xml:lang="la">Suadent alii, <lb xml:id="p1z10"/>ut <persName>Wingartnerum</persName> accedam, alii dissuadent.</s>
					<s n="8" xml:lang="la">Charitati christianę <lb xml:id="p1z11"/>libenter hoc darem, si nihil inde detrimenti acce<lb xml:id="p1z12"/>deret bonitati causae; vereor enim, ne pii hoc mihi <lb xml:id="p1z13"/>pro servili imputent subiectione, impii vero, quasi de <lb xml:id="p1z14"/>sententia cesserim, glorientur.</s>
					<s n="9" xml:lang="la">Itaque dubius adhuc sum animi.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/>Postridie hinc discedet <placeName ref="l21">Badenam</placeName> ad comitia.</s>
					<s n="11" xml:lang="la">Adiungitur <lb xml:id="p1z16"/>illi d. <persName ref="p3544">Wolphgangus ab Erlach</persName>, vir modestissimus <lb xml:id="p1z17"/>et piissimus, qui sine dubio, si vita illi detur, tandem <lb xml:id="p1z18"/>ad consulatum pertinget.</s>
					<s n="12" xml:lang="la">Velim, ut vestri legatum hunc <lb xml:id="p1z19"/>complectantur; pacificus enim est et communi causae bene vult.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z20"/>Alterum suspicor pro sua intemperie me mirum <lb xml:id="p1z21"/>in modum apud legatos vestros traducturum <placeName ref="l21">Badenae</placeName>.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z22"/>Cuperem ergo, ut illi, quicunque sint, prius ea de re ad<lb xml:id="p1z23"/>monerentur et instruerentur.</s>
					<s n="15" xml:lang="la">Sed fortassis, ut erga <placeName ref="l587">Tiguri<lb xml:id="p1z24"/>nos</placeName> affectus est, tanto non dignabitur eos alloquio; ego <lb xml:id="p1z25"/>cupio illi sanam a domino dari mentem.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Defensionem <lb xml:id="p1z26"/>Consensus sacramentarii vos iam accepisse spero.</s>
					<s n="17" xml:lang="la">Nobis <lb xml:id="p1z27"/>cum <placeName ref="l832">Gallis</placeName> nostris perpetuo aliquid agendum est; enecant <lb xml:id="p1z28"/>me tantum non odiosis suis actionibus.</s>
					<s n="18" xml:lang="la">No<lb xml:id="p1z29"/>vi nihil <lb xml:id="p1z30"/>habemus, nisi quod nostri et <placeName ref="l922">Friburgensis</placeName> in comitatu <lb xml:id="p1z31"/>Gruerię emendo sunt occupati.</s>
					<s n="19" xml:lang="la"><placeName ref="l436">Sanenses</placeName>, ut audio, <lb xml:id="p1z32"/>detrectant evangelium recipere, conspirant nonnihil cum <lb xml:id="p1z33"/><placeName ref="l300">Lucernatibus</placeName> et <placeName>Subsylvanis</placeName>; sed quid ipsis profuturi sint, <lb xml:id="p1z34"/>nescio.</s>
					<s n="20" xml:lang="la">Utinam tam essemus solliciti de promovendo regno <lb xml:id="p1z35"/>dei quam de dilatandis externis imperii finibus!</s>
					<s n="21" xml:lang="la" ana="farewell"><lb xml:id="p1z36"/>Bene vale.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="salute">Nostri te omnes salutant, praesertim <persName ref="p8417">Musculus</persName> <lb xml:id="p1z37"/>et <persName ref="p2919">Schlatterus</persName>; uxor quoque mea te tuamque plurimum <lb xml:id="p1z38"/>salutat; d. item <persName ref="p8012">Hallerus</persName> et <persName ref="p3494">Nicolaus a Dießbach</persName> <lb xml:id="p1z39"/>te salutant.</s>
					<s n="23" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><placeName ref="l41">Bernę</placeName> 16. ianuarii 1555.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z40"/><persName ref="p8018">Ioannes Hallerus</persName> tuus.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, domino <lb xml:id="p2z4"/>et compatri suo honorando.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
