			<zone xml:id="p2z4-0" points="2058,1290 2428,1277 2548,1312 2661,1264 2954,1266 2956,1222 2817,1184 2766,1213 2512,1200 2342,1244 2059,1244">2066,1273 2110,1270 2155,1270 2199,1267 2244,1267 2289,1264 2333,1261 2378,1261 2422,1258 2467,1258 2512,1255 2556,1255 2601,1252 2645,1249 2690,1249 2735,1246 2779,1246 2824,1246 2868,1243 2913,1243 2958,1249</zone>
