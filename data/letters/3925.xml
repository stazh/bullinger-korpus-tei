	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Heri tuas recepi literas scriptas 17. huius mensis.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Videbis conditiones <lb xml:id="p1z2"/>pacis ad me ab amico missas, quarum participes facio dominos <lb xml:id="p1z3"/>et senatum amplissimum.</s>
					<s n="4" xml:lang="la">Eos etiam oro, ut non moleste ferant, si solita pensio <lb xml:id="p1z4"/>illis serius solvatur, quam putaveram, quia rex vult dimittere <lb xml:id="p1z5"/>militem extraneum, qui onere immenso illi est, et quia humanus animus <lb xml:id="p1z6"/>vix potest quiescere et pacatiora sequi consilia.</s>
					<s n="5" xml:lang="la" ana="salute">Multi somniant <lb xml:id="p1z7"/>et scribunt multa de cogitationibus principum; sed dominus est, <lb xml:id="p1z8"/>qui illorum consilia moderatur et convertit omnia ad suam gloriam <lb xml:id="p1z9"/>et salutem suorum et continet ac reprimit furores hominum.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Quod attinet ad causam hospitis <persName>Ciconie</persName>, per me non stabit, quominus <lb xml:id="p1z11"/>sit in tuto et maneat eius posta aliis eiectis et abl tis.</s>
					<s n="7" xml:lang="la">Nihil adhuc <lb xml:id="p1z12"/>certi possum polliceri; sed que potero et intellexero, tibi signifficabo.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Vester legatus, qui est in comitiis <placeName ref="l18">Augustanis</placeName>, die 13. huius mensis et <lb xml:id="p1z14"/>alii legati pransi sunt cum legatis regis et bene valent.</s>
					<s n="9" xml:lang="la">Non <lb xml:id="p1z15"/>bene convenit inter omnes de articulo religionis.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Scis ob inducias factas <lb xml:id="p1z16"/>cum <placeName>Turca</placeName> multos recusare pecuniam.</s>
					<s n="11" xml:lang="la">Rex <placeName>Bohemie</placeName> in id regnum a <persName>Cesare</persName> <lb xml:id="p1z17"/>mittitur, ut pecuniam postulet; idem urget in <placeName ref="l850">Austria</placeName> archidux <persName ref="p18477">Ferdinandus</persName>.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z18"/>Maguntinus et <placeName>Treverensis</placeName> ibi sunt; dux <placeName ref="l572">Wirtembergensis</placeName> in thermis valetudinem <lb xml:id="p1z19"/>curat; <placeName ref="l2477">Palatinum</placeName> excusant curę electoratus recens oblati, Clivensem ducem im<lb xml:id="p1z20"/>becillitas valetudinis, nescio quid <placeName ref="l267">Coloniensem</placeName>.</s>
					<s n="13" xml:lang="la">Saxonici principes ob <lb xml:id="p1z21"/>Moscovitam, qui <persName>Livonie</persName> bonam partem occuparunt, adesse non possunt.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z22"/>Electoris marchionis <persName>Ioachimi</persName> filiam in matrimonium ducit dux <lb xml:id="p1z23"/><placeName>Luneburgensis</placeName>; ad eas nuptias vicini conveniunt.</s>
					<s n="15" xml:lang="la">Magnas parat <lb xml:id="p1z24"/>copias <persName>im<lb xml:id="p1z25"/>perator Turcicus</persName>, ut filium minorem natu Baiasetum invadat et opprimat, qui <lb xml:id="p1z26"/>patri inobediens strangulavit suum gubernatorem et alios.</s>
					<s n="16" xml:lang="la">Est in <lb xml:id="p1z27"/>exercitu cum triginta millibus equit et multis peditibus et bombardis <lb xml:id="p1z28"/>et fingens fratrem ag[g]redi vult fieri dominus Egipti.</s>
					<s n="17" xml:lang="la">Deus permittit <lb xml:id="p1z29"/>furias et demones vagari per mundum, ut infideles torqueant, <lb xml:id="p1z30"/>cum interim boni fruantur pace, quę superat omnem intellectum, <lb xml:id="p1z31"/>etiam in mediis procellis mundi.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Filium tibi commendo et d. d. <persName ref="p8111">Martiri</persName> <lb xml:id="p1z32"/>et <persName ref="p8011">Galtero</persName> et me illorum precibus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="farewell">Bene vale et nos, quod facis, ama.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z33"/>Sol[uturi] 20. aprilis.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z34"/>Tuus ex animo.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Commodius erit, ut <lb xml:id="p1z35"/>hospes filii vestimenta, que ind<lb xml:id="p1z36"/>icaverit necessaria, illi comparet.</s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
					<s n="24" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
