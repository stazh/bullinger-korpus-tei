	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non licuit rescribere per syndicum vestrum, <lb xml:id="p1z2"/>virum sane ornatissimum, quia detinebar adhuc ne<lb xml:id="p1z3"/>gotiis nostrae synodi; quinimo cogor etiam nunc esse <lb xml:id="p1z4"/>brevior.</s>
					<s n="3" xml:lang="la">Verum conducit hoc tibi occupatiori utilioribus <lb xml:id="p1z5"/>rebus quam prolixis meis legendis literis.</s>
					<s n="4" xml:lang="la">Exempl<lb xml:id="p1z6"/>ar literarum <persName ref="p8033">Bezae</persName> accepi et pro eo ingentes ago <lb xml:id="p1z7"/>gratias, maximas vero deo nostro gratias ago pro singulari <lb xml:id="p1z8"/>sua gratia, qua dignatur <placeName ref="l832">Galliam</placeName>.</s>
					<s n="5" xml:lang="la">Intelligis ex illis <lb xml:id="p1z9"/>actionibus, quid moliantur crassi illi Lutherani et <lb xml:id="p1z10"/>quousque provexerint in <placeName ref="l832">Gallia</placeName> suam illam <placeName ref="l18">Augustanam</placeName> <lb xml:id="p1z11"/>confessionem, quam cum papistae ferre possint, qualis sit, a<lb xml:id="p1z12"/>pparet.</s>
					<s n="6" xml:lang="la">Non frustra nuper me copiosius ea de re <lb xml:id="p1z13"/>scripsisse deprehendis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Audiuntur adhuc <persName>Thrasonum</persName> voces: "<lb xml:id="p1z14"/>Brevi recipietur nostra confessio in <placeName ref="l832">Gallia</placeName>, eiicietur <lb xml:id="p1z15"/>Calvinismus."</s>
					<s n="8" xml:lang="la">Proinde vigilandum arbitror.</s>
					<s n="9" xml:lang="la">Qua de <lb xml:id="p1z16"/>re scripsi ad d. <persName ref="p8111">Martyrem</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Video perversos illos <lb xml:id="p1z17"/>homines malle cum papistis hac in c[ausa] facere quam <lb xml:id="p1z18"/>nobiscum.</s>
					<s n="11" xml:lang="la">Narrationem istam d. <persName ref="p8033">Bezae</persName> communicavi <lb xml:id="p1z19"/>d. <persName ref="p8055">Blaurero</persName>, communicabo et cum <persName ref="p8018">Hallero</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Pro ex<lb xml:id="p1z20"/>emplaribus eorum, quae misisti in <placeName ref="l2472">Poloniam</placeName> ago gratias <lb xml:id="p1z21"/>ac ea hic remitto.</s>
					<s n="13" xml:lang="la">In eandem sententiam scripsi <lb xml:id="p1z22"/>et ego ac gaudeo ex uno spiritu eadem nos loqui; pro<lb xml:id="p1z23"/>lixius tamen principi exposui, quae hic egerit <persName ref="p7955">Blan<lb xml:id="p1z24"/>drata</persName> et quam turpiter contra me mentitus sit apud <lb xml:id="p1z25"/>principem.</s>
					<s n="14" xml:lang="la">Cum autem existimem <persName ref="p8053">Balduinum</persName>, <lb xml:id="p1z26"/>licet librum eius non viderim, artificem <lb xml:id="p1z27"/>esse religionis aut fidei Samaritanae, operae precium <lb xml:id="p1z28"/>fecisse te iudico, qui detexeris eius artes pessimas.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z29"/>Fortassis utuntur<note type="misc">... utentur...</note> hoc homine in obtrudenda <lb xml:id="p1z30"/>sua confessione <placeName ref="l18">Augustana</placeName>.</s>
					<s n="16" xml:lang="la">Dominus confirmet robur <lb xml:id="p1z31"/>tuum, ut diu utilibus scriptionibus prodesse possis <lb xml:id="p1z32"/>ecclesiae!</s>
					<s n="17" xml:lang="la">Oremus sedulo dominum, ut benedicat <lb xml:id="p1z33"/>rebus <placeName ref="l832">Galliae</placeName> et infringat consilium <persName>Achitophelis</persName>.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z34"/>Datus est nobis superioribus diebus vicinus omnium <lb xml:id="p1z35"/>pessimus cardinalis <placeName>Empsensis</placeName> factus <placeName ref="l257">Constantiensis</placeName> <lb xml:id="p1z36"/>episcopus.</s>
					<s n="19" xml:lang="la">Hic exercebit nos abunde.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Foederati <lb xml:id="p1z37"/>nostri heri demum ingressi sunt iuridicam actionem <lb xml:id="p1z38"/>cum <placeName ref="l646">Claronensibus</placeName>; fortassis extorquebuntur <lb xml:id="p1z39"/>se ex illa aut abrumpent eam pro sua libidine.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z40"/>Si intellexero legatos principis <placeName>Sabaudię</placeName> vel in <lb xml:id="p1z41"/>illis comitiis vel hic aliquid moliri etc., non <lb xml:id="p1z42"/>ignorabis; mature significabo.</s>
					<s n="22" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">D<lb xml:id="p1z43"/>omi<lb xml:id="p1z44"/>nus servet te nobis diu incolumem.</s>
				</p>
				<p>
					<s n="24" xml:lang="la" ana="salute">Saluta symmystas et fratres, <lb xml:id="p1z45"/>imprimis d. <persName ref="p2740">Rosetum</persName>, d. <persName ref="p4440">Budaeum</persName> et <persName ref="p8078">Jonvilleum</persName>, <persName ref="p4227">Badium</persName>, <persName>Norm<lb xml:id="p1z46"/>andium</persName> et <persName ref="p4791">Crispinum</persName>.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 23. octobris 1561.</s>
					<s n="26" xml:lang="la" ana="salute"><lb xml:id="p1z47"/>Salutant te symmystae et fratres mei.</s>
					<s n="27" xml:lang="la">Tuus ex animo <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p540">Ioanni Calvino</persName>, <lb xml:id="p2z2"/><placeName ref="l167">Genevensis</placeName> ecclesiae <lb xml:id="p2z3"/>fidelissimo pastori, domino <lb xml:id="p2z4"/>suo colendo et fratri longe <lb xml:id="p2z5"/>charissimo.</s>
					<s n="29" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l167">Genff</placeName>.</s>
				</p>
			</div>
