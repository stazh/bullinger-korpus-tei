	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hac ipsa hora, qua haec nunc scribo, consultavi<lb xml:id="p1z2"/>mus de theologo alio in locum <persName ref="p8386">Hyperii</persName>, qui nobis a landgravio d<lb xml:id="p1z3"/>enegatus<note type="margin">Zusatz a.R.: "qui - denegatus"</note>, pro schola <placeName ref="l280">Lausanensi</placeName> vocando, et obtinui, <lb xml:id="p1z4"/>quod optabam, ut in d. <persName ref="p4037">Zanchum</persName> omnes fratres <lb xml:id="p1z5"/>consentirent.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Placuit tamen, ut, si senatui <lb xml:id="p1z6"/>ita placeat, per literas privatas primum solicitetur, <lb xml:id="p1z7"/>ut, si consensum illius habeamus, commodius <lb xml:id="p1z8"/>postea a senatu vocari possit.</s>
					<s n="4" xml:lang="la">Et ea de re <lb xml:id="p1z9"/>nuncnunc senatum adeo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quoniam vero nuncius <lb xml:id="p1z10"/>hic expectare meum a senatu reditum non <lb xml:id="p1z11"/>potest, uno verbo oro, ut, quid tibi hac in <lb xml:id="p1z12"/>re videatur, mihi ocissime significes.</s>
					<s n="6" xml:lang="la">Scio illum <lb xml:id="p1z13"/><placeName ref="l491">Argentinensi</placeName> scholae utilissimum esse nec esse e <lb xml:id="p1z14"/>re illius ecclesię, si indeavocetur; sed nostra <lb xml:id="p1z15"/>necessitas et fides, quam huic nostrae debeo sc<lb xml:id="p1z16"/>holae et reipublicae, facit, ut magis huc propen<lb xml:id="p1z17"/>dere debeam, ut noster fiat; audiam <lb xml:id="p1z18"/>tamen tuum quoque consilium.</s>
					<s n="7" xml:lang="la">Scribes ad me <placeName ref="l2">Aro<lb xml:id="p1z19"/>viam</placeName> aut <placeName ref="l69">Brugas</placeName>; 24. enim huius mensis <lb xml:id="p1z20"/><placeName ref="l2">Arovię</placeName> ero et 26.</s>
					<s n="8" xml:lang="la"><placeName ref="l69">Brugis</placeName> synodos ibi <lb xml:id="p1z21"/>celebraturus, et spero fratrem meum <placeName ref="l69">Brugas</placeName> <lb xml:id="p1z22"/>ad me descensurum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Vellem quidem ipse ad <lb xml:id="p1z23"/>vos ascendere; sed nescio, an nunc possim.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z24"/>Quicquid illius fiat, scribe tu ad me, ut ego <lb xml:id="p1z25"/><persName ref="p8417">Musculum</persName> eius mox certiorem facere possim; <lb xml:id="p1z26"/>nam res amplam dilationem ferre non <lb xml:id="p1z27"/>potest, cum alias nimis diu professio <lb xml:id="p1z28"/>theologica <placeName ref="l280">Lausannę</placeName> vacaverit.</s>
					<s n="11" xml:lang="la">De rebus <lb xml:id="p1z29"/>aliis alias scribam.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Velim, si tibi non <lb xml:id="p1z30"/>esset incommodum, ut ipse quoque ad nos <lb xml:id="p1z31"/><placeName ref="l69">Brugas</placeName> venires; aderit illic una mecum <lb xml:id="p1z32"/>d. <persName ref="p5787">Claudius a Madiis</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Salutant te nostri <lb xml:id="p1z33"/>amanter omnes; salutem tuis quoque precor omnibus.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z34"/><placeName ref="l41">Bernae</placeName> 18. maii hora 8. antemeridiana.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z35"/><persName ref="p8018">I[ohannes] <pb/><lb xml:id="p2z1"/>Hall[<lb xml:id="p2z2"/>erus</persName>] tuus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z3"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z4"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z5"/>ecclesiae pastori f<lb xml:id="p2z6"/>idelissimo, domino et compatri <lb xml:id="p2z7"/>suo charissimo et colendissimo.</s>
				</p>
			</div>
