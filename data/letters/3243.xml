	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">Mitto iam duos postremos terniones una cum tu<lb xml:id="p1z3"/>o exemplari archetypo, quod servar<lb xml:id="p1z4"/>i iusseras, et ultimo ternioni etiam inclusi unicam <lb xml:id="p1z5"/>columnam, quę adhuc remansit, ut, si opus sit, <lb xml:id="p1z6"/>ad colligendum indicem inservire ei, qui colligit, <lb xml:id="p1z7"/>queat.</s>
					<s n="3" xml:lang="la">Vestrum erit, ut, ubi index absolutus <lb xml:id="p1z8"/>fuerit, id quod brevi cuperem fieri, ad me <lb xml:id="p1z9"/>una cum duabus illis manuscriptis pagellis, in <lb xml:id="p1z10"/>quibus prima columna ternionis D secundi alphabeti <lb xml:id="p1z11"/>continetur, illum prima quoque occasione mittere, ut <lb xml:id="p1z12"/>extremam manum imponere operi possimus.</s>
					<s n="4" xml:lang="la">Vix <lb xml:id="p1z13"/>potui haec ad te scribere, adeo festinabat tabel<lb xml:id="p1z14"/>larius; alioqui, si plus fuisset ocii, et tibi et <lb xml:id="p1z15"/>aliis amicis apud vos egissem, quantas par <lb xml:id="p1z16"/>esset, gratias pro singulari humanitate et muni<lb xml:id="p1z17"/>ficentia, qua uxorem meam ad vos a <placeName>Thermis</placeName> <lb xml:id="p1z18"/>profectam adeo liberaliter excepistis atque donastis.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z19"/>Sed dabo operam, ut, quacunque ratione potero, meam <lb xml:id="p1z20"/>erga singulos gratitudinem declarem.</s>
					<s n="6" xml:lang="la" ana="farewell">Bene vale, <lb xml:id="p1z21"/>mi d. <persName ref="p495">Bullingere</persName>, et si quid apud d. <persName ref="p2336">Ber<lb xml:id="p1z22"/>nardinum</persName> aut <persName ref="p8111">Petrum Martyrem</persName> aut utrumque potius <lb xml:id="p1z23"/>de hoc pontifice antichristo<note type="margin">a.R. von der Hand <persName ref="p495">Bullingers</persName>: "valde placent... in... Vidi itam semel et iterum."</note>, qui nunc in loco <lb xml:id="p1z24"/>sancto sedet, certi expiscari licuit, quod illu<lb xml:id="p1z25"/>strandę eius vitę et catalogo Balei addendę <lb xml:id="p1z26"/>inservire possit, quaeso proxima occasione ad nos <lb xml:id="p1z27"/>mittito.</s>
					<s n="7" xml:lang="la" ana="salute">Salutat te officiose d. <persName>Baleus</persName> noster <lb xml:id="p1z28"/>et <persName ref="p8406">Lycosthenes</persName>.</s>
					<s n="8" xml:lang="la" ana="farewell">Bene vale iterum atque iterum.</s>
					<s n="9" xml:lang="la">18. iulii 1557.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z29"/><persName ref="p8126">Ioan[nes] Operinus</persName> <lb xml:id="p1z30"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, ecclesi<lb xml:id="p2z3"/>astae <placeName ref="l587">Tigurino</placeName> <lb xml:id="p2z4"/>etc., domino et amico <lb xml:id="p2z5"/>suo inprimis <lb xml:id="p2z6"/>colendo.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
