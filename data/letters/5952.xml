	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quam primum et quam tuto fieri potest, <lb xml:id="p1z2"/>mitte has meas literas ad d. <persName ref="p2054">Martinengum</persName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Accinguntur legati, <placeName ref="l473">Sangallensis</placeName>, <persName>Heremitanus</persName> <lb xml:id="p1z4"/>et <persName>Lussius</persName>, ut redeant in concilium; ergo conclusio <lb xml:id="p1z5"/>expectatur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Diligenter nobis hic vigilandum, <lb xml:id="p1z6"/>ut sciamus, qualis conclusio, quid fiat <lb xml:id="p1z7"/>cum illis nostris legatis.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Tu si quid potes, an<lb xml:id="p1z8"/>nitere, ut sciamus; res est necessaria.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>22. huius mensis excussa <persName ref="p2336">Bernardini</persName> causa; <lb xml:id="p1z10"/>amplissimus senatus ipsum deposuit <lb xml:id="p1z11"/>et urbe ac agro eiecit; non conceduntur <lb xml:id="p1z12"/>illi ad profectionem amplius quam 3 septimanae <lb xml:id="p1z13"/>ad summum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ab initio protinus migrare <lb xml:id="p1z14"/>iussus fuerat; precibus impetravit dies 14.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Omnes in illum frendent.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Vereor, ne ullus <lb xml:id="p1z16"/>amplius pastor dandus sit <placeName ref="l294">Locarnensi</placeName> vel <lb xml:id="p1z17"/><placeName ref="l834">Italicae</placeName> ecclesiae, et utilius multi esse putant <lb xml:id="p1z18"/>nullum amplius dare, ne spinosa ingenia <lb xml:id="p1z19"/>novas nobis turbas dent.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Voluit eiectione <lb xml:id="p1z20"/>in exilium testari magistratus <placeName ref="l587">Tigurinam</placeName> <lb xml:id="p1z21"/>ecclesiam non probare istos 30 dialogos.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z22"/>Iussi sumus legere istius dialogos; <lb xml:id="p1z24"/>ita labores et molestiae in diem conduplicantur.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z25"/>Nisi dominus clementer manum suam <lb xml:id="p1z26"/>supposuerit, vix potero tantis par esse <lb xml:id="p1z27"/>laboribus, maxime cum in diem sentiam de<lb xml:id="p1z28"/>crescere vires.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Dominus adsit nobis et <lb xml:id="p1z29"/>infelici silicernio concedat mentem meliorem.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell"><lb xml:id="p1z30"/>Vale et ora pro nobis dominum.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Saluta <lb xml:id="p1z31"/>amicos.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Tuas expecto cum desiderio etc.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z32"/><placeName ref="l587">Tiguri</placeName> 26. novembris festinantissime <lb xml:id="p1z33"/>1563.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z34"/>Tuus ille <persName ref="p495">B[u<lb xml:id="p1z35"/>llingerus]</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Literas his inclusas <lb xml:id="p1z36"/>remitte; videbis, <lb xml:id="p1z37"/>quid agatur <placeName ref="l210">Heydelbergae</placeName>.</s>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae fideli ministro, <lb xml:id="p2z4"/>fratri et symmystae cha<lb xml:id="p2z5"/>rissimo meo.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
