	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime vir, quum iam literas obsignassem, <lb xml:id="p1z3"/>accepi aliquid rerum novarum ab <placeName ref="l834">Italia</placeName>, <lb xml:id="p1z4"/>nempe declaratum esse legatum futuri <lb xml:id="p1z5"/>conciliabuli cardinalem <persName>Crescentium Leguleum</persName>, <lb xml:id="p1z6"/>quemadmodum in mea ad regem <lb xml:id="p1z7"/><placeName ref="l830">Angliae</placeName> epistola prędixeram futurum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z8"/>Alii cardinales cum eo non praesidebunt, <lb xml:id="p1z9"/>sed duo episcopi, quorum unus <lb xml:id="p1z10"/>futurus est <placeName>Fanensis</placeName> (ut arbitror).</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z11"/><placeName ref="l425">Romae</placeName> laboratur penuria magna rei <lb xml:id="p1z12"/>frumentariae.</s>
					<s n="4" xml:lang="la">Obiit <persName>cardinalis <lb xml:id="p1z13"/>Cornarus</persName> <placeName ref="l522">Venetus</placeName>, vir insigniter <lb xml:id="p1z14"/>malus.</s>
					<s n="5" xml:lang="la">Sed alia audi, que <lb xml:id="p1z15"/>me excruciant et te quoque ex<lb xml:id="p1z16"/>cruciabunt, sat scio: exorta est <lb xml:id="p1z17"/><placeName ref="l377">Patavii</placeName> heresis pestilentissima, <lb xml:id="p1z18"/>quae non modo suadet rebaptizan<lb xml:id="p1z19"/>dos esse viros, sed Christum natum <lb xml:id="p1z20"/>esse ex corruptibili semine Ioseph; <lb xml:id="p1z21"/>atque ut horrendam hanc blas<lb xml:id="p1z22"/>femiam possint astruere, negant <lb xml:id="p1z23"/>magnam partem evangeliorum, <lb xml:id="p1z24"/>proh pudor!</s>
					<s n="6" xml:lang="la">Res est certa.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>Expecto in dies novos fratres, qui parant <lb xml:id="p2z2"/>fugam, sed sincerae doctrinae, non <lb xml:id="p2z3"/>fanaticos illos et impios homines.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p2z4"/>Multa sunt praeterea, quae libenter <lb xml:id="p2z5"/>audies, sed ea malo mecum ferre <lb xml:id="p2z6"/>quam literis committere, pręsertim quum <lb xml:id="p2z7"/>certum nuncium non habeam.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p2z8"/>Est apud nos vir bonus atque idem dives, <lb xml:id="p2z9"/>qui cupit emere Vetus et Novum <lb xml:id="p2z10"/>Testamentum Germanice in folio <lb xml:id="p2z11"/>bene compactum.</s>
					<s n="10" xml:lang="la">Si d. <persName>Michael</persName> <lb xml:id="p2z12"/>illud ad d. <persName ref="p654">Comandrum</persName> mitteret, <lb xml:id="p2z13"/>qui ad me curaret, afferem ego <lb xml:id="p2z14"/>illi pecuniam.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale in domino <lb xml:id="p2z15"/>et roga pro omnibus ecclesiis, quae <lb xml:id="p2z16"/>ita turbantur hac fęda tempestate.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Sal<lb xml:id="p2z17"/>uto ecclesiam <lb xml:id="p2z18"/>et scholam <lb xml:id="p2z19"/>totam.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z20"/><placeName ref="l525">Vicosoprani</placeName>, i<lb xml:id="p2z22"/>dibus martii <lb xml:id="p2z23"/>1551.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z24"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p3z1"/>Clarissim<lb xml:id="p3z2"/>o viro d. <pb/><lb xml:id="p4z1"/><persName ref="p495">H[enri<lb xml:id="p4z2"/>co] Bullingero</persName> <lb xml:id="p4z3"/>etc.</s>
				</p>
