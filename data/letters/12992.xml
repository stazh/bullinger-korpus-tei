			<zone xml:id="p2z4-0" points="1205,2454 1306,2411 1693,2401 1735,2422 1866,2402 1867,2344 1480,2352 1431,2379 1277,2321 1207,2322">1211,2411 1243,2405 1276,2403 1309,2400 1342,2399 1375,2399 1408,2397 1440,2395 1473,2393 1506,2393 1539,2393 1572,2393 1605,2393 1638,2393 1670,2393 1703,2393 1736,2393 1769,2393 1802,2391 1835,2391 1868,2393</zone>
			<zone xml:id="p2z5-0" points="1197,2513 1256,2535 1407,2505 1685,2506 1803,2559 1939,2541 1940,2449 1750,2409 1618,2464 1371,2421 1198,2460">1202,2509 1239,2508 1276,2506 1313,2506 1350,2506 1387,2504 1424,2502 1461,2499 1498,2497 1535,2497 1572,2497 1609,2497 1646,2496 1683,2495 1720,2497 1757,2497 1794,2497 1831,2497 1868,2497 1905,2497 1942,2497</zone>
