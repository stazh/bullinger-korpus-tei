	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil habeo, nisi quod d. <persName ref="p540">Calvinus</persName> <lb xml:id="p1z2"/><placeName ref="l167">Geneva</placeName> nunciat persequtionem contra fideles <lb xml:id="p1z3"/>institui in <placeName ref="l832">Gallia</placeName>; regem tribus <lb xml:id="p1z4"/>cardinalibus permisisse inquisitionem <lb xml:id="p1z5"/>et potestatem cessisse vitae et necis in sanctos <lb xml:id="p1z6"/>absque ulla provocatione.</s>
					<s n="3" xml:lang="la">Orandum est ergo <lb xml:id="p1z7"/>pro fratribus et membris eiusdem corporis<lb xml:id="p1z8"/>.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Alioqui magni apparatus <lb xml:id="p1z10"/>fiunt in <placeName ref="l832">Gallia</placeName>; maximę exactiones quoque <lb xml:id="p1z11"/>fiunt.</s>
					<s n="5" xml:lang="la">Dominus consoletur miseros et adventu <lb xml:id="p1z12"/>suo glorioso dirimat sanguinolentum <lb xml:id="p1z13"/>hoc proelium.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>D. <persName ref="p8101">Laelius</persName> tulit ad <lb xml:id="p1z15"/>me literas has, quas oro diligenter cu<lb xml:id="p1z16"/>res.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Vive et vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Quae nuper <lb xml:id="p1z17"/>scribebas, subinde comperior vera esse.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z18"/>4. martii anno 1558.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p1z21"/>Saluta fratres et <lb xml:id="p1z22"/>amicos omnes.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p8009">Ioanni Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae fideli <lb xml:id="p2z4"/>ministro, compatri et <lb xml:id="p2z5"/>fratri suo charissimo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
