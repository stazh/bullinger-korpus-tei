	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi praeteritis diebus tuas, colendissime domine compater, <lb xml:id="p1z2"/>quibus adiunctae erant etiam aliae ad d. <persName ref="p8063">Steigerum</persName> pertinentes, <lb xml:id="p1z3"/>quas illi exhibui.</s>
				</p>
				<p>
					<s n="3" xml:lang="la" ana="salute">Gaudet is suas tibi esse redditas et tibi pro <lb xml:id="p1z4"/>his gratias agit et te salutat.</s>
					<s n="4" xml:lang="la">Is rursus proximis diebus <lb xml:id="p1z5"/>secundum nostrae reipublicae consuetudinem consulatum iniit, qui <lb xml:id="p1z6"/>utinam illi denuo sit faustus et foelix!</s>
					<s n="5" xml:lang="la">Factae sunt etiam quędam <lb xml:id="p1z7"/>aliae electiones, de quibus privatim ad fratrem scribo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quod ad <lb xml:id="p1z8"/>theologicam professionem, nullus adhuc in locum d. <persName ref="p8092">Aretii</persName> electus <lb xml:id="p1z9"/>est; fiet tamen id, ut opinor, brevi.</s>
					<s n="7" xml:lang="la">Domini, quantum intelligo, <lb xml:id="p1z10"/>nullum peregrinum admittent.</s>
					<s n="8" xml:lang="la">Ex nostris fortassis in electionem <lb xml:id="p1z11"/>venient <persName ref="p4339">Adrianus</persName><note xml:id="fn1" type="footnote" n="1">Blauner.</note>, <placeName ref="l2">Aroviensis</placeName> minister, qui theologiam <lb xml:id="p1z12"/>prius etiam <placeName ref="l280">Lausannae</placeName> per aliquot annos professus est; sed ab illo <lb xml:id="p1z13"/>non parum abhorremus, non tantum propter certa alia, quibus laborat, <lb xml:id="p1z14"/>vitia, garrulitatis videlicet et temulentiae, sed quod de illius <lb xml:id="p1z15"/>etiam in doctrina integritate subdubitamus, utpote quem scimus <lb xml:id="p1z16"/>Basiliensi episcopo addictiorem.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Huic coniungentur fortassis <persName>Turingus <lb xml:id="p1z17"/>Ruͦstius</persName> et <persName>Christophorus Lüthardus</persName> <placeName>Arbergensis</placeName> atque ex nostris <lb xml:id="p1z18"/><persName>Christianus</persName> in Portu et <persName ref="p8052">Valentinus Ampelander</persName>.</s>
					<s n="10" xml:lang="la">Ad <persName>Blasium</persName> <lb xml:id="p1z19"/>meum multi respiciunt, et forte non inutilis esset; senatus <lb xml:id="p1z20"/>quoque ad ipsum propendet.</s>
					<s n="11" xml:lang="la">Fiat autem voluntas domini.</s>
					<s n="12" xml:lang="la">Hoc tantum <lb xml:id="p1z21"/>vereor, ne <foreign xml:lang="el">ἑτερογνωμοσύνην</foreign> aliquis nobis obtrudatur, et si Blasius <lb xml:id="p1z22"/>tibi utilis videretur, rogarem, ut statim ad <persName ref="p8063">Steigerum</persName> et <persName ref="p7449">Dies<lb xml:id="p1z23"/>bachium</persName> aliquid pro illo scriberes; multum enim tua hic posset <lb xml:id="p1z24"/>authoritas et intercessio.</s>
					<s n="13" xml:lang="la" ana="salute">Fuit is mecum diebus hisce pascha<lb xml:id="p1z25"/>libus et scribit ad d. <persName ref="p8442">Simlerum</persName> teque cum omnibus, qui sunt <lb xml:id="p1z26"/>illic, salutat.</s>
					<s n="14" xml:lang="la">Nova quotidie feruntur multa; sed ita incerta <lb xml:id="p1z27"/>ea sunt et confusa, ut de his scribere pigeat.</s>
					<s n="15" xml:lang="la">Constat <placeName ref="l378">Lutetię</placeName> <lb xml:id="p1z28"/>publicatum esse bellum et in armis esse totam fere <placeName>Galliam</placeName>.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z29"/>Aiunt multa oppida circa <placeName ref="l1867">Pictavium</placeName> ab Hugenothis esse occupata, <lb xml:id="p1z30"/>qui tamen non amplius Hugenothi nuncupentur, sed Malecontenti, <lb xml:id="p1z31"/>et ad illos promiscue confluere evangelicos et catholicos <lb xml:id="p1z32"/>nec iam de religione agi, sed de libertate <persName>regni Gallię</persName> asserenda.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z33"/>Audent etiam quidam affirmare fratrem regis iuniorem illos fovere.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z34"/>Rex libenter militem externum conduceret; sed non habet pecunias.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z35"/>Alios dicunt, quod tamen mirum est, pecuniis abundare.</s>
					<s n="20" xml:lang="la"><persName>La<lb xml:id="p1z36"/>vallius</persName> noster et <persName>Castillionaei</persName> nihil iam aliud habent.</s>
					<s n="21" xml:lang="la">Ex<lb xml:id="p1z37"/>pectamus, quid mercatores ex <placeName ref="l157">Francofurto</placeName> afferant.</s>
					<s n="22" xml:lang="la">De <placeName ref="l862">Helvetiis</placeName> <lb xml:id="p1z38"/>nostris multus est sermo, quod copias in <placeName ref="l808">Belgium</placeName> pro <persName ref="p18575">rege Hispano</persName> <lb xml:id="p1z39"/>ducere velint, quorum summus capitaneus esse debeat <persName>Schorrus <lb xml:id="p1z40"/>Svitensis</persName>.</s>
					<s n="23" xml:lang="la">Miror autem tuas nihil hac de re continere.</s>
					<s n="24" xml:lang="la">Scio mult <lb xml:id="p1z41"/>de his secreto inter nostros ferri, quę non omnia investigare volo <lb xml:id="p1z42"/>nec possum.</s>
					<s n="25" xml:lang="la">Utinam coniunctioribus essemus inter nos animis; <lb xml:id="p1z43"/>faxit hoc dominus!</s>
				</p>
				<p>
					<s n="26" xml:lang="la">Nostri miserunt nuncium <placeName ref="l210">Heidelbergam</placeName>, quem <lb xml:id="p1z44"/>spero propediem rediturum et aliquid nobis allaturum.</s>
				</p>
				<p>
					<s n="27" xml:lang="la" ana="farewell">Si quid tu <lb xml:id="p1z45"/>ex <placeName ref="l157">Francofurto</placeName> acceperis, communica nobis, quęso, et bene vale.</s>
				</p>
				<p>
					<s n="28" xml:lang="la" ana="salute">Sa<lb xml:id="p1z46"/>lutant te nostri vicissim omnes, <persName ref="p4060">Zehenderi</persName> etiam, <persName ref="p8351">Frischingi</persName> et <persName ref="p7879">Wytenbachii</persName> <lb xml:id="p1z47"/>cum <placeName ref="l269">Küngßfeldianis</placeName>.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><placeName ref="l41">Bernae</placeName> 17. aprilis 1574.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><persName ref="p8018">I[o<lb xml:id="p1z48"/>hannes]<lb type="manual"/> Hall[erus]</persName>, t[otus] t[<pb/><lb xml:id="p2z1"/>uus].</s>
				</p>
				<p>
					<s n="31" xml:lang="la">Clarissimo viro d. <persName ref="p495">Bullingero</persName> <lb xml:id="p2z2"/>seniori, domino et <lb xml:id="p2z3"/>compatri meo charissimo.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
