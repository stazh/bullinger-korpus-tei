	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>scripta priore epistola et cui dari astitutar
					<lb xml:id="p1z2"/>poeictionam vistulit, quod Ioannis Himicum
					<lb xml:id="p1z3"/>Fashianana, quis negoliorium cauta Ionna han
					<lb xml:id="p1z4"/>Hic potuis expectare constituat, pratirum
					<lb xml:id="p1z5"/>ertliana nomulla die tibut in Belpas pestis
					<lb xml:id="p1z6"/>allehi pue ti commanicane volui est, qua
					<lb xml:id="p1z7"/>scib si vi benuos sc temum tuar ignarus
					<lb xml:id="p1z8"/>fare valu Soliburo ex felruani 5.
					<lb xml:id="p1z9"/>Dominus Gvulturus plurimam Tuus ex animu
					<lb xml:id="p1z10"/>Salutem hic tibi a me ascistam..
					<lb xml:id="p1z11"/>fecer.
					<lb xml:id="p1z12"/>.
					<lb xml:id="p1z13"/>Nullus dunus celertus et he llegim
					<lb xml:id="p1z14"/>Poloniae Palatini duttimi fruventum.
					<lb xml:id="p1z15"/>adilibę regue nullus impitata
					<lb xml:id="p1z16"/>faciuns. aprili nunsu rursus de ea
					<lb xml:id="p1z17"/>elissoni agetur hodie litibas at aua
					<lb xml:id="p1z18"/>ma accepi, quo ad Gntina cuipicalor
					<lb xml:id="p1z19"/>nihil non mover misceris, ut filius successa
					<lb xml:id="p1z20"/>destinitur aque februvarii auum vale
					<pb/>
					<lb xml:id="p4z1"/>Praestantissimo viro
					<lb xml:id="p4z2"/>et multum verurando
					<lb xml:id="p4z3"/>domino Henrico Bullingero,
					<lb xml:id="p4z4"/>ecclesiae Tigurina
					<lb xml:id="p4z5"/>pastori dignissimo.
				</p>
			</div>
		</body>
	</text>
