	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nesciebam, an mihi tabellio contingeret <lb xml:id="p1z2"/>propter nundinas nostras, in quibus <lb xml:id="p1z3"/>magna tabellionum raritas, ideoque ad <lb xml:id="p1z4"/>d. <persName ref="p4554">Collinum</persName>, cuius tamen mihi literae <lb xml:id="p1z5"/>redditae, scribere nolui; periculum enim <lb xml:id="p1z6"/>erat, ne frustra scriberem.</s>
					<s n="3" xml:lang="la">Domino <lb xml:id="p1z7"/>doctori etiam <persName ref="p1283">Gesnero</persName> vina emi Rhetica, <lb xml:id="p1z8"/>sed scribere non potui, quod die lunae <lb xml:id="p1z9"/>sub vesperam mihi de nuncio non constaret <lb xml:id="p1z10"/>egoque plurimas alias literas scribendas <lb xml:id="p1z11"/>haberem in hoc episcopi negocio.</s>
					<s n="4" xml:lang="la">Vexant <lb xml:id="p1z12"/>nos etiam ecclesiae Rheticae, et Iesuitae <lb xml:id="p1z13"/>redeunt.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Excusa ergo me.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Negocium <lb xml:id="p1z14"/>contra episcopum adhuc satis feliciter processit; <lb xml:id="p1z15"/>sed expectamus exitum.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Exitus acta probat; careat successibus opto, <lb xml:id="p1z17"/>Quisquis ab eventu facta notanda putat.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><persName ref="p8009">Fabr<pb/><lb xml:id="p2z1"/>icius</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Clarissimo viro erudition<lb xml:id="p2z2"/>e et pietate ex<lb xml:id="p2z3"/>cellenti d. <persName ref="p495">Heinrycho <lb xml:id="p2z4"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z5"/><placeName ref="l587">Tigurinae</placeName> antistiti <lb xml:id="p2z6"/>vigilantissimo, <lb xml:id="p2z7"/>domino et patron<lb xml:id="p2z8"/>o suo.</s>
				</p>
			</div>
		</body>
	</text>
