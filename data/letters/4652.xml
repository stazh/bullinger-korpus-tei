	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Heri recepi literas, quas ad te mitto, cum libello, quem <lb xml:id="p1z2"/>ipse devoravi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Nuper ad te scripsi me existimare optimam <lb xml:id="p1z3"/>occasionem <placeName ref="l167">Genevensibus</placeName> oblatam ex regiis literis, qua se <lb xml:id="p1z4"/>a calumniis purgent.</s>
					<s n="4" xml:lang="la"><placeName ref="l2478">Sabaudie</placeName> legatus hic triduo mansit, <lb xml:id="p1z5"/>sperat senatum amplissimum <placeName ref="l587">Tigurinum</placeName> sequuturum, quod <placeName ref="l2448">Quinquepagici</placeName> cum eo transegerunt.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Maturius expendet omnia.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ea de re alias pluribus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Per me non <lb xml:id="p1z7"/>stabit, quominus honestissimum, salutare, christianum et utile foedus <lb xml:id="p1z8"/>fiat inter amplissimum se[natum] <placeName ref="l587">Tigurinum</placeName> et <placeName ref="l832">Francie</placeName> coronam, quod pene necessarium <lb xml:id="p1z9"/>quis iudicare posset graves ob causas, quas in praesens taceo.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Ante dietam proximam te invisam.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Nunc quando non occurrit, <lb xml:id="p1z11"/>quod scribam aliud, finem faciam te orans, ut salutes d. d. <lb xml:id="p1z12"/><persName ref="p8111">Martirem</persName>, <persName ref="p8011">Galterum</persName>, generum et amicos alios cum senatu amplissimo.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z13"/>Bene vale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l760">Solut[uri]</placeName> 5. februarii.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z14"/>Tuus ex animo.</s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullinghero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tigury</placeName>.</s>
				</p>
				<p>
					<note>[daneben von Bullingers Hand:]</note>
					<s n="15" xml:lang="la">D. <lb xml:id="p2z5"/><persName ref="p629">Matthaei <lb xml:id="p2z6"/>Coignetii</persName>, legati regis <lb xml:id="p2z7"/>literae.</s>
				</p>
			</div>
		</body>
	</text>
