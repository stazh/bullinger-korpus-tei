	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quod feci, debui tibi, chare frater, et libenter <lb xml:id="p1z2"/>quidem feci facturus, dum vixero, amici fidelissimi <lb xml:id="p1z3"/>et fratris coniunctissimi officium.</s>
					<s n="3" xml:lang="la">Ubi consul redierit ex <lb xml:id="p1z4"/>comitiis, qua possum fide et diligentia tuum agam negotium.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Suͤleri et meum negotium vicissim tibi commendo.</s>
					<s n="5" xml:lang="la">Praeter <lb xml:id="p1z6"/>meam spem accepit filius meus <persName>Ioannes Rodolfus</persName> <placeName>Bergensem</placeName> <lb xml:id="p1z7"/>ecclesiam curandam.</s>
					<s n="6" xml:lang="la">Dominum oro, ut hoc sit felix et <lb xml:id="p1z8"/>faustum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Dudum <persName ref="p1753">Leoni</persName> nostro vel propter patris piae me<lb xml:id="p1z9"/>moriae beneficia libentissime adfuissem; sed in <lb xml:id="p1z10"/>senatu res aliter cadit, quam institueramus; spero <lb xml:id="p1z11"/>dominum ei non defuturum.</s>
					<s n="8" xml:lang="la" ana="salute">Omnes mei, quos salutabas, <lb xml:id="p1z12"/>mecum erant, dum redderentur tuae literae; omnes <lb xml:id="p1z13"/>vicissim te salutant.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Ex <placeName ref="l830">Anglia</placeName> heri accipio <lb xml:id="p1z15"/>literas 21. iunii <placeName ref="l296">Londini</placeName> datas nihil aliud continentes <lb xml:id="p1z16"/>quam ecclesiae et religionis res optimo esse loco, <persName ref="p18212">reginam <lb xml:id="p1z17"/>Scotiae</persName> ambire nuptias principis cuiusdam <lb xml:id="p1z18"/><placeName ref="l830">Angli</placeName> non sine dolo et suspitione rerum novan<lb xml:id="p1z19"/>darum.</s>
					<s n="10" xml:lang="la">Si successerit res, audio <placeName ref="l830">Anglam</placeName> et ipsam <lb xml:id="p1z20"/>cogitare de novis nuptiis; ambit eam <persName ref="p18538">Carolus <lb xml:id="p1z21"/>Austriacus</persName>, et spes est aliqua, si integer esse velit <lb xml:id="p1z22"/>in religione; sed haec nostra<note type="misc">mea?</note> sententia satis incerta, dum <lb xml:id="p1z23"/>in horas principes sententias suas mutant.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/>Rediit <persName>Baltazar</persName>, interpres d. legati; refert convenisse <lb xml:id="p1z25"/><placeName ref="l875">Hispanos</placeName> et <placeName ref="l832">Gallos</placeName> <placeName>Baionae</placeName> magna cum pompa, venisse <lb xml:id="p1z26"/>et <placeName ref="l2510">Turcae</placeName> legationem, sed non admissam ad aulam propter <placeName ref="l875">His<lb xml:id="p1z27"/>panos</placeName>; caeterum, dum morę impatiens <placeName ref="l2510">Turca</placeName> <lb xml:id="p1z28"/>discessum minaretur, auditum a rege.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Petit, an rex <lb xml:id="p1z29"/>pacta inita cum patre velit incolumia, an transitum <lb xml:id="p1z30"/>concedere, an proventum dari classi in mari.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z31"/>Quid responsum sit, nescio; hoc audio omnes trepidare, <lb xml:id="p1z32"/>famam spargere arcem <placeName ref="l2523">Maltae</placeName> captam, oc[c]u<lb xml:id="p1z33"/>patum etiam <placeName>Tunetum</placeName> a <placeName ref="l2510">Turcis</placeName>, hos imminere <lb xml:id="p1z34"/><placeName ref="l2556">Siciliae</placeName> et <placeName ref="l425">Romae</placeName>.</s>
					<s n="14" xml:lang="la">Certiora a te expecto ex <lb xml:id="p1z35"/><placeName ref="l834">Italia</placeName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l587">Tiguri</placeName> festinantissime 20. <lb xml:id="p1z36"/>iulii 1565.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Comitia nondum sunt finita.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z37"/>Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae pastori, domino <lb xml:id="p2z4"/>compatri et fratri meo <lb xml:id="p2z5"/>colendissimo et charissimo.</s>
					<s n="20" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
