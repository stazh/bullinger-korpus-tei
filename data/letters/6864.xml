	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, mi frater et dilectissime compater.</s>
					<s n="2" xml:lang="la">Dominus <lb xml:id="p1z2"/>benedicat tibi efficiatque, ut ablatio illa tua tibi <lb xml:id="p1z3"/>felix sit et fausta; idem ille benignus et [clemen]<lb xml:id="p1z4"/>tissimus dominus liberet te ab omni malo et prae[ser]vet <lb xml:id="p1z5"/>te tuosque a peste.</s>
					<s n="3" xml:lang="la">Oremus sedulo dominum, <lb xml:id="p1z6"/>ut is noster sit, nos tueatur et nobis benedicat.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>- Haberem innumeras prope, quae scriberem; sed del... <lb xml:id="p1z8"/>satus<note type="misc">delassatus?</note> colloquiis continuis nihil possum.</s>
					<s n="5" xml:lang="la">Vener[unt] <lb xml:id="p1z9"/>huc quaestor aerarius <placeName ref="l41">Bernas</placeName> cum d. <persName ref="p8018">Hallero</persName>, syndicus <lb xml:id="p1z10"/><placeName ref="l167">Genevensis</placeName> <persName ref="p2740">Rosetus</persName> cum d. <persName ref="p8033">Beza</persName>, <persName ref="p8421">Ludovicus Bovillus</persName> [cum] <lb xml:id="p1z11"/><placeName ref="l513">Ulmensi</placeName>, legati.</s>
					<s n="6" xml:lang="la">Cras negotium suum proponent <lb xml:id="p1z12"/>senatui, de quo alias.</s>
					<s n="7" xml:lang="la">- Sara, <persName>Ioannis Petri</persName> a <placeName>Fulach</placeName> <lb xml:id="p1z13"/>uxor, ubi <placeName>Wedeschvylam</placeName> attigisset, in aedibus <lb xml:id="p1z14"/>fratris magno cum suorum moerore mortua est.</s>
					<s n="8" xml:lang="la">Incipit in <lb xml:id="p1z15"/>infima urbis parte pestis serpere mediocriter.</s>
					<s n="9" xml:lang="la">- <lb xml:id="p1z16"/>Scribitur <placeName ref="l2510">Turcam</placeName> quadripartitio cum exercitu ve<lb xml:id="p1z17"/>nire in <placeName ref="l882">Hungariam</placeName>.</s>
					<s n="10" xml:lang="la">Tu si quid habes ex <placeName ref="l834">It[alia]</placeName>, <lb xml:id="p1z18"/>communica.</s>
					<s n="11" xml:lang="la"><placeName ref="l15">Antverpiae</placeName> praedicatur evangelium; <lb xml:id="p1z19"/>sed multi resistunt.</s>
					<s n="12" xml:lang="la">Metuo turbam et bellum <lb xml:id="p1z20"/>civile.</s>
					<s n="13" xml:lang="la">Omnia passim periculis sunt plena.</s>
					<s n="14" xml:lang="la" ana="farewell"><lb xml:id="p1z21"/>Vale.</s>
					<s n="15" xml:lang="la">Dominus benedicat tibi.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 2. augusti, an<lb xml:id="p1z22"/>no 1566.</s>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z23"/>Mei omnes te salutant; <lb xml:id="p1z24"/>s<lb xml:id="p1z25"/>aluta tu amicos et fratres.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p495">Bullingerus</persName> tuissimus.</s>
				</p>
				<p>
