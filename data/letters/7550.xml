	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. Mitto ad te d. Cognetii literas, Albanus exercitum
					<lb xml:id="p1z2"/>duxit in Phrysiam castra metatus est ad Grunganm
					<lb xml:id="p1z3"/>non procul ab exercitu Ludovici vanssovis res
					<lb xml:id="p1z4"/>ad praesium spectare videtur, statutum est Albane
					<lb xml:id="p1z5"/>antequam se Turaicus Ludovico coniungar
					<lb xml:id="p1z6"/>alterum opprimere exitus in manu dei est
					<lb xml:id="p1z7"/>magna est expectatio huius iudicii fit desectu
					<lb xml:id="p1z8"/>peditum a Granvillito et poluilito, quorum utirque
					<lb xml:id="p1z9"/>spieis ab illinaem dictirus 1 2. taraius.
					<lb xml:id="p1z10"/>eir i mege e a ie ert iu,
					<lb xml:id="p1z11"/>cdlesunt studia propinquorum regina Scotiae cetinatur
					<lb xml:id="p1z12"/>ab Angla in libera cor aium custodia, sed tamunti
					<lb xml:id="p1z13"/>lotus isti Flandrici, facium veit in Gallia
					<lb xml:id="p1z14"/>minus tuta pace fruamur. Classis Turcica grassatui
					<lb xml:id="p1z15"/>in mari siculo hoc nobis ad miserias supereta
					<lb xml:id="p1z16"/>Angusola petr quinque pagos comuni rediit Albam
