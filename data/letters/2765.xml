	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z6"/>Amici<lb xml:id="p1z8"/>s<lb xml:id="p1z10"/>sim<lb xml:id="p1z11"/>a<lb xml:id="p1z14"/>s literas pietatis tuae, princeps il<lb xml:id="p1z15"/>lustrissime, accepi et quidem maximo cum gaudio.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z16"/>Gratulor enim mihi et gratias ago domino <lb xml:id="p1z17"/>deo nostro et tua humanitati, quod inter <lb xml:id="p1z18"/>amicos viri tanti sum ascriptus, apud quem <lb xml:id="p1z19"/>vel inter familiares et servulos haerere <lb xml:id="p1z20"/>satis esse existimavero.</s>
					<s n="3" xml:lang="la">Efficiam deo iuvante, <lb xml:id="p1z21"/>ne unquam illius insignis tuae erga me benevolentiae [<lb xml:id="p1z22"/>te] poenitere possit.</s>
					<s n="4" xml:lang="la">Ac si quid nunc etiam <lb xml:id="p1z23"/>in tui gratiam, princeps optime, potero facere, <lb xml:id="p1z24"/>impigrum me experieris.</s>
					<s n="5" xml:lang="la">Unum oro <lb xml:id="p1z25"/>tuam pietatem.</s>
					<s n="6" xml:lang="la">ut in promovendo pietatis <lb xml:id="p1z26"/>veritatisque evangelicae negotio omnes vires <lb xml:id="p1z27"/>intendas.</s>
					<s n="7" xml:lang="la">Non deerit ille, qui se nois in <lb xml:id="p1z28"/>piis institutis affuturum pollicitus est in finem us<lb xml:id="p1z29"/>que saeculi.</s>
					<s n="8" xml:lang="la">Neque vero lucernam verbi sui in te ac<lb xml:id="p1z30"/>cendit, ut modio cooperiatur.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z31"/>Fac ergo sedulo, quod facis, heros i<lb xml:id="p1z32"/>ncly<lb xml:id="p1z33"/>te, ac caus<lb xml:id="p1z34"/>am renasc<lb xml:id="p1z35"/>entis evan<lb xml:id="p1z36"/>gelii adiuva.</s>
					<s n="10" xml:lang="la">Festinantissime <lb xml:id="p1z37"/>has scripsi ideoque boni consulas oro.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale, princeps optime, <lb xml:id="p1z38"/>et me tuae pietati atque clementiae semper com<lb xml:id="p1z39"/>mendatum habeas oro.</s>
					<s n="12" xml:lang="la"><placeName ref="l587">Tiguri</placeName> in primaria <placeName ref="l862">Helvetiorum</placeName> urbe, <lb xml:id="p1z40"/>12. Novembris 1555.</s>
				</p>
				<p>
					<note type="address">[Adresse auf...:]</note>
					<s n="13" xml:lang="la">Illustrissimo principi d. <lb xml:id="p1z41"/><persName ref="p1752">Spithek Jordan</persName> de Zaliczin et in <placeName>Melstin</placeName> haer<lb xml:id="p1z42"/>edi, palatino <placeName>Sendomiriensi</placeName> ac <placeName>Praemislen<lb xml:id="p1z43"/>si</placeName> <placeName>Ramionacensique</placeName> capitaneo, domino <lb xml:id="p1z44"/>suo colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
