	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Si quid ultra ea, que tuis dominis cum his <lb xml:id="p1z2"/>mitto, haberem, significarem; sed quia omnia <lb xml:id="p1z3"/>illic continentur, non repeto.</s>
					<s n="3" xml:lang="la">Utinam <lb xml:id="p1z4"/><persName>Caesar</persName>, qui hucusque iactavit acies et <lb xml:id="p1z5"/>fulgura, pugnasset; nam una hora <lb xml:id="p1z6"/>christianos ab infinitis vexationibus <lb xml:id="p1z7"/>et ruinis liberasset.</s>
					<s n="4" xml:lang="la">Sed domini fiat <lb xml:id="p1z8"/>voluntas.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Libenter ex te <lb xml:id="p1z10"/>scirem, <lb xml:id="p1z11"/>quid de moaquione habeas; certum <lb xml:id="p1z12"/>est illum adiutum a <persName>Cesare</persName> et sua <lb xml:id="p1z13"/>incendia renovare, et interea scribit <lb xml:id="p1z14"/><persName>Caesar</persName> contra illum, <lb xml:id="p1z15"/>qua<lb xml:id="p1z16"/>si non nosset.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z17"/>Legatus pape, ut audi, non audet <placeName ref="l648">Retiam</placeName> ingredi; <lb xml:id="p1z18"/>sed speratur, quod cum <persName ref="p20604">Angelo <lb xml:id="p1z19"/>Ritio</persName>, Caesaris apud <placeName ref="l862">Helvetios</placeName> legat<lb xml:id="p1z20"/>o, <lb xml:id="p1z21"/>sit <placeName ref="l98">Curiam</placeName> brevi <lb xml:id="p1z22"/>venturus, ut sub umbra et practicis eius <lb xml:id="p1z23"/>lateat.</s>
					<s n="7" xml:lang="la">Ille <persName ref="p20604">Angelus</persName> vult nonnulla <lb xml:id="p1z24"/>capitula renovare et propterea venturus <lb xml:id="p1z25"/>ex <placeName ref="l306">Mediolano</placeName>, ubi iam est.</s>
					<s n="8" xml:lang="la" ana="salute">Quod potes <lb xml:id="p1z26"/>d. <persName ref="p3375">Vergerio</persName> scribere et eum, si placet, meis <lb xml:id="p1z27"/>verbis salutare.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale bene, vir optime.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z28"/>Ex <placeName ref="l760">Soluturo</placeName> <lb xml:id="p1z29"/>30a septembris.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Tuus semper <persName ref="p8296">Bass[a<pb/><lb xml:id="p4z1"/>fontaneus]</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p4z2"/>Optimo viro et <lb xml:id="p4z3"/>amico d. <persName ref="p495">Bulingero</persName><lb xml:id="p4z4"/>.</s>
				</p>
				<p>
					<note>[<placeName ref="l587">Tiguri</placeName> von anderer Hand:]</note>
					<s n="13" xml:lang="de"><lb xml:id="p4z5"/>Dem hochgelerten herren <lb xml:id="p4z6"/><persName ref="p495">doctor Bulingerius</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="de"><lb xml:id="p4z7"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
