	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><persName>Wilhelmus</persName> noster, ita persuasus ab uxore et socru sua, colendissime domine <lb xml:id="p1z2"/><persName ref="p495">Bullingere</persName> et frater animo meo charissime, credidit instare partum; <lb xml:id="p1z3"/>itaque hucusque profectionem suam ad vos procrastinavit.</s>
					<s n="3" xml:lang="la">Nunc vero, quum <lb xml:id="p1z4"/>partus tam diu differatur, ad vos venit; testimonium tamen sine maioribus <lb xml:id="p1z5"/>sumptibus accipere non potuit, quum modo ordinarii conventus nulli celebrentur <lb xml:id="p1z6"/>et extraordinarios emere oporteat.</s>
					<s n="4" xml:lang="la">Ergo, ne in quam suspicionem <lb xml:id="p1z7"/>inciderit, quasi res eius integrae non forent, paucula haec scribere <lb xml:id="p1z8"/>placuit.</s>
					<s n="5" xml:lang="la">Arbitror autem eum legitimo tempore testimonium impetraturum, <lb xml:id="p1z9"/>quo contenti futuri sitis.</s>
					<s n="6" xml:lang="la">Me impellente sine testimonio profectus est; <lb xml:id="p1z10"/>etenim, quo diutius hic haeserit, eo magis aes creverit alienum, quum non <lb xml:id="p1z11"/>habeat, unde se sustentet.</s>
					<s n="7" xml:lang="la">Recepisse autem vos eum propter intercessionem nostr<lb xml:id="p1z12"/>am in gratiam et succurrisse eius indigentiae non aliter aestimamus, atque <lb xml:id="p1z13"/>si hoc beneficii in non contulissetis.</s>
					<s n="8" xml:lang="la">Sed frater noster m. <persName ref="p8301">Brandmullerus</persName> <lb xml:id="p1z14"/>iam (nisi fallor) vobis egit gratias.</s>
					<s n="9" xml:lang="la">Bona spe ducimur, ut charitas iubet, <lb xml:id="p1z15"/>eum variis et multis malis vexatum et exploratum in posterum prudentiorem <lb xml:id="p1z16"/>et correctiorem futurum.</s>
					<s n="10" xml:lang="la">Quem semel cepistis iuvare, denuo periclitari <lb xml:id="p1z17"/>non sinetis.</s>
					<s n="11" xml:lang="la">Plura igitur in hanc sententiam dare, necesse non habeo.</s>
					<s n="12" xml:lang="la">R<lb xml:id="p1z18"/>eliqua vero scribam (deo volente) non ita multo post ad d. <persName ref="p1453">Wolfgangum <lb xml:id="p1z19"/>Hallerum</persName>; nam haec exarari subito, quum aliis negotiis implicatus tenerer.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z20"/>Tu, mi venerande domine et perdilecte frater, boni consule.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Cupiunt <lb xml:id="p1z21"/>te, quos hic salutasti, d. doctor <persName ref="p8466">Wyssenburgius</persName> et (qui non admodum <lb xml:id="p1z22"/>bene valet) d. <persName ref="p8126">Oporinus</persName>, amantissime resalutatum.</s>
					<s n="15" xml:lang="la" ana="salute">Obsecro, meis verbis <lb xml:id="p1z23"/>salutes omnes dominos et fratres.</s>
					<s n="16" xml:lang="la">Christus conservet te cum <lb xml:id="p1z24"/>omnibus tuis.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l28">Basileae</placeName> iunii 21. anno humanae salutis 1568.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z25"/>Totus ex animo tuus <lb xml:id="p1z26"/><persName ref="p8384">Ioannes Hospinianus</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Sapientissimo atque optimo <lb xml:id="p2z2"/>theologo d. m. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, domino et <lb xml:id="p2z4"/>fratri suo perpetuo in <lb xml:id="p2z5"/>oculis ferendo.</s>
				</p>
				<p>
					<s n="20" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
