	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/><persName ref="p8101">Laelius</persName> noster narrabit tibi, optime frater, cur <lb xml:id="p1z3"/>nunc non venerim et quando et quamobrem <lb xml:id="p1z4"/>sim venturus ad vos.</s>
					<s n="2" xml:lang="la">Valeo dei beni<lb xml:id="p1z5"/>gnitate, sed obruor laboribus tamen, et <lb xml:id="p1z6"/>dominus sustentat me.</s>
					<s n="3" xml:lang="la">Orant me fratres, <lb xml:id="p1z7"/>qui <placeName ref="l522">Venetiis</placeName> sunt, ne praetermittam occasionem <lb xml:id="p1z8"/>hanc compellandi legatum illum, de <lb xml:id="p1z9"/>quo narrabit <persName ref="p8101">Laelius</persName>; nam sciunt magnam <lb xml:id="p1z10"/>existere inter nos necessitudinem iam a pueris.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z11"/>Ego itaque tum fratrum eorum causa, tum <lb xml:id="p1z12"/>quum legatus me invitavit, ad colloquium <lb xml:id="p1z13"/>hodie <placeName ref="l512">Tubingam</placeName> descendens confero me <placeName>Ch<lb xml:id="p1z14"/>epingam</placeName>, ubi illum expectabo.</s>
					<s n="5" xml:lang="la">Urgent frigora, <lb xml:id="p1z15"/>mala sunt itinera, maioribus valde sum<lb xml:id="p1z16"/>ptibus premar; sed negotium Christi est, cui <lb xml:id="p1z17"/>servio, neque ommittendum.</s>
					<s n="6" xml:lang="la">Princeps me <lb xml:id="p1z18"/>audiente legit, quid de te scripserim in responso <lb xml:id="p1z19"/>meo impresso ad Catalogum haereticorum, <lb xml:id="p1z20"/>in quo fuisti neglectus; tres enim concinavi <lb xml:id="p1z21"/>ex neglectis, ducem, te, <placeName>Fallesium</placeName>.</s>
					<s n="7" xml:lang="la">Facio <lb xml:id="p1z22"/>nunc eum libellum Latinum hortatu ducis.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z23"/>Tandem <persName ref="p8113">Volm[arius]</persName> eiecit <persName>Theod[orum]</persName>, iniuria quidem, <lb xml:id="p1z24"/>sat scio; imo omnes convictores deseruerunt <lb xml:id="p1z25"/>hominem.</s>
					<s n="9" xml:lang="la">Suscepi ego adolescentem in gratiam <lb xml:id="p1z26"/>patris et <placeName ref="l587">Tigurinorum</placeName> meorum, quibus cupio <lb xml:id="p1z27"/>maiora officia praestare.</s>
					<s n="10" xml:lang="la">Nunc discessurus, <lb xml:id="p1z28"/>quia me ab<lb xml:id="p1z29"/>sente co<lb xml:id="p1z30"/>quina mea conquies<pb/><lb xml:id="p2z1"/>cit, <lb xml:id="p2z2"/>curavi illi bonum civem, apud quem degat; ubi <lb xml:id="p2z3"/>rediero, si mecum esse voluerit, non recusabo.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z4"/>Oravit me, ut haec ad te et ut <lb xml:id="p2z5"/>patri eum commendarem, quod facio.</s>
					<s n="12" xml:lang="la">Iure <lb xml:id="p2z6"/>testor illum proficere; saltem excitatus est a <lb xml:id="p2z7"/>quodam veluti somno, quo superiore <lb xml:id="p2z8"/>anno mihi videbatur oppressus, et bene spero <lb xml:id="p2z9"/>de eo.</s>
					<s n="13" xml:lang="la" ana="salute">Salvere iubeo tres generos, filios <lb xml:id="p2z10"/>meos carissimos, atque alios etiam fratres.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z11"/>Orate pro me.</s>
					<s n="15" xml:lang="la">Deus vobiscum.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z12"/><placeName ref="l512">Tubingae</placeName> 20. decembris 1554.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z13"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">D. <lb xml:id="p2z14"/><persName ref="p495">Bullingero</persName>.</s>
				</p>
			</div>
