	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Compater in domino charissime, causa d. <persName>Philippi</persName> sollicitat <lb xml:id="p1z2"/>me plurimum, non quod de animo ipsius ad<lb xml:id="p1z3"/>dubitem, sed quod vereor, ne improborum hominum <lb xml:id="p1z4"/>malicia non modo impediatur, ne ad nos concedat, <lb xml:id="p1z5"/>sed et in gravia discrimina coniiciatur.</s>
					<s n="3" xml:lang="la">Liberet <lb xml:id="p1z6"/>eum dominus ex ore non unius aut alterius, sed multorum <lb xml:id="p1z7"/>leonum et ursorum, in quorum medio versatur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Quod Apocalypsim tuam attinet, ne dubita; faciam, <lb xml:id="p1z9"/>quod hic potero.</s>
					<s n="5" xml:lang="la">Utinam per illam fiat, ut antichristus <lb xml:id="p1z10"/>in universo terrarum orbe reveletur et conspiciatur.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Quod te ad d. <persName ref="p4082">Conradum Zviccium</persName> scripturum promittis, quo in <lb xml:id="p1z12"/>arte lignaria, cuius spe detineor, certi aliquid <lb xml:id="p1z13"/>accipiam, sic mihi gratum est, ut vix possis gratius <lb xml:id="p1z14"/>aliquid efficere.</s>
					<s n="7" xml:lang="la">Quare te oro, ut prima quavis <lb xml:id="p1z15"/>occasione huc incumbas.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">De obitu consulis vestri <lb xml:id="p1z16"/>pię memoriae condoleo vobis omnibus et reipublicę <lb xml:id="p1z17"/>vestrae oroque dominum, ut substituat in illius locum <lb xml:id="p1z18"/>virum dupla pietate ac prudentia praeditum, quemad<lb xml:id="p1z19"/>modum Elizeum substituit olim Elię.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>Lieteras <persName ref="p8320">Dasypodii</persName> <lb xml:id="p1z21"/>remitto.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Gratias habeo humanitati tuę, quod legen<lb xml:id="p1z22"/>das dare volueris.</s>
					<s n="11" xml:lang="la" ana="farewell">Optime vale, compater charissime.</s>
					<s n="12" xml:lang="la" ana="salute"><lb xml:id="p1z23"/>Salutant te mei omnes, praesertim <persName ref="p2207">Heinrychulus</persName> tuus.</s>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z24"/>Tu meo nomine saluta tuos, dominos etiam sym<lb xml:id="p1z25"/>mystas et professores.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1557. 15. ianuarii.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p8417">Wolfg[angus] Musc[ulus</persName>] tuus in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z4"/>pastori vigilantissimo, <lb xml:id="p2z5"/>domino ac compatri <lb xml:id="p2z6"/>charissimo.</s>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName><note xml:id="fn1" type="footnote" n="1">Hinweis zur Holzsparkunst: In den Instruktionen in Zürich StA bezieht sich ein Dokument auf ein Privileg für <persName ref="p4082">[Konrad] Zwicks</persName> Erfindung; gefunden in: Weisses Register XXV 799, Nr. 21. Vgl. auch in den gedruckten Eidg. Abschieden, Stichwort "Erfindungen". Publikation zu diesem Thema von <persName ref="p1888">Hans Rudolf Lavater</persName> in FS Dellsperger!</note>.</s>
				</p>
			</div>
