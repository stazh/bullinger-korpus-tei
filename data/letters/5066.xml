	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quoniam d. <persName>Petrus</persName> nondum rediit <lb xml:id="p1z2"/>nec ab ultimis tibi, chare frater, communicatis <lb xml:id="p1z3"/>quicquam scripsit, non habeo, quod scribam <lb xml:id="p1z4"/>de rebus <placeName ref="l832">Gallicis</placeName>, de quibus est iam magn<lb xml:id="p1z5"/>um silentium.</s>
					<s n="3" xml:lang="la">Bene spero de gratia domini.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Si <lb xml:id="p1z6"/>propter adventum Germanicorum quorundam doctorum <lb xml:id="p1z7"/>ad aulam non est instituta collatio <lb xml:id="p1z8"/>inter ipsos et nostros, existimamus d. <persName>Petrum</persName> <lb xml:id="p1z9"/>propediem ad nos rediturum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Dominus dirigat <lb xml:id="p1z10"/>iter eius!</s>
					<s n="6" xml:lang="la">Tantus est hostium veritatis <lb xml:id="p1z11"/>furor, ut citra periculum redire vix <lb xml:id="p1z12"/>possit; sed satis tutus est, qui est in protectione <lb xml:id="p1z13"/>domini dei nostri.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Si quid certi acceperis <lb xml:id="p1z14"/>de <placeName ref="l522">Venetis</placeName>, de <placeName ref="l834">Italia</placeName>, de concilio <lb xml:id="p1z15"/><placeName ref="l1107">Tridentino</placeName>, de quibus omnibus scrutaberis, <lb xml:id="p1z16"/>communices diligenter et mature.</s>
					<s n="8" xml:lang="la">De <persName ref="p3375">Vergerio</persName> <lb xml:id="p1z17"/>hoc dico: me vix credere, quod <placeName ref="l587">Tigurum</placeName> sit <lb xml:id="p1z18"/>venturus; si venerit, cogetur etiam alios au<lb xml:id="p1z19"/>dire, non loqui solus.</s>
					<s n="9" xml:lang="la">Qualis sit, potuisti facile <lb xml:id="p1z20"/>ex congressu et colloquiis eius intelligere.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Ego nunquam offendi illum, quod sciam; <lb xml:id="p1z22"/>ille nulla de caussa me negligere coepit.</s>
					<s n="11" xml:lang="de"><lb xml:id="p1z23"/><foreign xml:lang="la">Ego, dum hoc animadverterem,</foreign> da han ich inn <lb xml:id="p1z24"/>blyben lassen, der er ist, und bin ouch, wie <lb xml:id="p1z25"/>ich bin.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">De principe eius et <persName ref="p458">Brentio</persName> iam n<lb xml:id="p1z26"/>ihil dico; horum ille est mancipium.</s>
					<s n="13" xml:lang="la">Vidisti, opinor, <lb xml:id="p1z27"/><persName ref="p458">Brentii</persName> librum contra me scriptum.</s>
					<s n="14" xml:lang="la">- <lb xml:id="p1z28"/><placeName ref="l646">Claronensium</placeName> caussa nondum conquievit.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Utinam sub <lb xml:id="p1z29"/>cinere non lateat ignis et ignis quidem <lb xml:id="p1z30"/>domini.</s>
					<s n="16" xml:lang="la">Orandus ergo dominus, ut nostri misereatur.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z31"/>Cuperem libellum <persName ref="p3375">Vergerii</persName> videre, remitterem <lb xml:id="p1z32"/>inspectum.</s>
					<s n="18" xml:lang="la" ana="salute">Saluta d. d. consules, <persName ref="p8359">Gallicium</persName>, <lb xml:id="p1z33"/><persName ref="p6130">Pontasellam</persName> et alios viros bonos, in<lb xml:id="p1z34"/>primis vero d. <persName ref="p8093">Herculem a Salice</persName>, cuius viri <lb xml:id="p1z35"/>amcitiam mihi conciliari per te cuperem; <lb xml:id="p1z36"/>audio enim virum esse in religione in<lb xml:id="p1z37"/>tegrum et alioqui etiam prudentem, fortem e<lb xml:id="p1z38"/>t humanum.</s>
					<s n="19" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 21. novembris <lb xml:id="p1z39"/>1561.</s>
					<s n="21" xml:lang="la" ana="salute"><lb xml:id="p1z40"/>Saluta et d. <persName ref="p8432">Friderychum a Salice</persName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z41"/>En, dum <lb xml:id="p1z42"/>haec <lb xml:id="p1z43"/>scribo, venit feliciter incolumis et l<lb xml:id="p1z44"/>aetus d. <persName ref="p8111">Martyr</persName>.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="salute">Dumtaxat salutavi eum; rogavi, <lb xml:id="p1z45"/>an res evangelii in <placeName ref="l832">Gallia</placeName> recte habeant; respondit optime.</s>
					<s n="24" xml:lang="la">D<lb xml:id="p1z46"/>eductus est huc a duobus capitaneis huc etc.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Post octiduum plura aut cit<lb xml:id="p1z47"/>ius, si possum; nondum enim cum eo collocutus sum etc.</s>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Io<lb xml:id="p2z2"/>anni Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro, <lb xml:id="p2z4"/>domino colendo et <lb xml:id="p2z5"/>fratri suo charissimo.</s>
					<s n="27" xml:lang="la">Chur.</s>
				</p>
			</div>
		</body>
