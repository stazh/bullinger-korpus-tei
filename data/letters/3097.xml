	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Ad nuperas tuas properanter, quemadmodum et nunc, scripsi.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Interea iis, de quibus in aliis meis literis mentionem feci, <lb xml:id="p1z3"/>diligentius perpensis te <persName ref="p458">Brenzii</persName> responsionem consulto et prudenter <lb xml:id="p1z4"/>omisisse deprehendo, neque digna sunt ipsius iamdudum <lb xml:id="p1z5"/>explosa puerilia, ne dicam phanatica argumenta, quibus <lb xml:id="p1z6"/>singulatim obviam eatur.</s>
					<s n="4" xml:lang="la">Fatentur sane omnes pii, quos <lb xml:id="p1z8"/><placeName ref="l210">Heidelberge</placeName> ex doctis maiorem partem a te stare scias, te ad<lb xml:id="p1z9"/>versariorum omnium argutias viriliter expunxisse.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quare deo <lb xml:id="p1z10"/>nostro imprimis, deinde et tibi gratię debitę agendę semper erunt.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Princeps noster ut male institutus et iuditio nondum pollens <lb xml:id="p1z12"/>libenter ecclesiam <placeName ref="l558">Wittenbergicam</placeName> sectaretur.</s>
					<s n="7" xml:lang="la">Hinc est, cur <lb xml:id="p1z13"/>diligentissime disquirit pro veteri et primęvo <persName ref="p18846">Lutherano</persName>.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Igitur ex multis tandem <persName ref="p18233">Illyricum</persName> sibi delegit, qui <placeName ref="l210">Heidelbergic<lb xml:id="p1z15"/>ę</placeName> ecclesię episcopus sit etc. et si quid integri hic inven<lb xml:id="p1z16"/>iatur, destruat, ut multi hic sentiunt.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/>In colloquium consenserunt omnes imperii status; sed modus, locus, <lb xml:id="p1z18"/>persone et tempus non possunt conveniri; credo illud ad <lb xml:id="p1z19"/>kalendas Gręcas effectum sortiturum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/><persName>Marchio Albertus</persName> vitam <placeName ref="l386">Pfortzemii</placeName> die 8. ian.</s>
					<s n="11" xml:lang="la">fęlicissime <lb xml:id="p1z22"/>adeoque christiane finivit, ut secundum vitę anteacte rationem <lb xml:id="p1z23"/>pro miraculo dei merito habendum sit, deo laus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Sacrifici <lb xml:id="p1z24"/>encomium cantant, haud dubie ante victoriam.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z25"/>De rebus imperii nil boni mihi polliceor.</s>
					<s n="14" xml:lang="la">Saxonum lapsus <lb xml:id="p1z26"/>vagatur in plateis.</s>
					<s n="15" xml:lang="la"><placeName ref="l587">Tigurinorum</placeName> hortus apud synceros <lb xml:id="p1z27"/>omnes floret.</s>
					<s n="16" xml:lang="la">Auxilium <placeName ref="l2510">Turcicum</placeName> daturi sunt ordines in suorum <lb xml:id="p1z28"/>ipsorum perniciem.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Vale cum senatu sanctissimo, symmistis et <lb xml:id="p1z29"/>aliis amicis fratribusque in domino.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z30"/>Brevi hin deo dante solvam <placeName ref="l410">Ratisbonam</placeName> repedaturus, <lb xml:id="p1z31"/>ubi tempus nobile mihi inutiliter terendum erit.</s>
					<s n="19" xml:lang="la" ana="salute">Vale et d. <lb xml:id="p1z32"/><persName ref="p8111">Petrum Martirem</persName> nominatim ex me saluta.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z33"/><persName ref="p2095">Philippo Melanchtoni</persName> studebo huc facere vocationem, <lb xml:id="p1z34"/>licet fortassis frustra laborabo.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Ex <placeName ref="l210">Heidelberga</placeName> <lb xml:id="p1z35"/>13. ianuarii anno etc. 57.</s>
					<s n="22" xml:lang="la"><lb xml:id="p1z36"/>Tuus <persName ref="p8354">G[eorgius] L[aet<lb xml:id="p1z37"/>us</persName>].</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Epitaphium: <lb xml:id="p1z38"/>Hic iacet <persName>Albertus</persName> princeps, dux, marchio, terror <lb xml:id="p1z39"/>Sacrificis ingens spesque decusque piis.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="24" xml:lang="de"><pb/><lb xml:id="p4z1"/>Dem erwurdigen unnd hoch<lb xml:id="p4z2"/>gelerten herrn <persName ref="p495">Hennrichen <lb xml:id="p4z3"/>Bullinger</persName>, der kirchen <lb xml:id="p4z4"/><placeName ref="l587">Zurch</placeName> frumen und treu<lb xml:id="p4z5"/>em vorgeeren<note xml:id="fn1" type="footnote" n="1">Antistes.</note>, zu hannden.</s>
					<s n="25" xml:lang="de"><lb xml:id="p4z6"/><placeName ref="l587">Zurch</placeName>.</s>
				</p>
			</div>
