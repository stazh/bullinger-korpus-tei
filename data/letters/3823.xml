					<lb xml:id="p3z5"/>quo
					<lb xml:id="p3z6"/>Satis
					<lb xml:id="p3z7"/>beret.
					<lb xml:id="p3z8"/>phero
					<lb xml:id="p3z9"/>fratri
					<lb xml:id="p3z10"/>elim
					<pb/>
					<lb xml:id="p4z1"/>Ornatissimo et longe clarissimo viro
					<lb xml:id="p4z2"/>domino Henrico Bullingero, domino ac
					<lb xml:id="p4z3"/>patrono meo colendissimo et observando.
					<lb xml:id="p4z4"/>Tiguri Helvetiorum
