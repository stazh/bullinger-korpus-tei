	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ultimam partem responsionis ad <persName ref="p458">Brentium</persName> tuae quaestori <persName ref="p3015">Sprünglio</persName> die Mercurii proxima<note type="misc">proxime?</note> <lb xml:id="p1z2"/>misi, spero autem eam tibi propediem redditum iri, ac quoniam voluisti, quid observassem, tibi <lb xml:id="p1z3"/>indicari, illud unum tibi in memoriam revocandum putavi, <foreign xml:lang="de">das der nam deß <lb xml:id="p1z4"/>wäterhanens ime <persName ref="p458">Brentio</persName> vorlangest eintweders von <persName>Staphylo</persName> oder Latino <lb xml:id="p1z5"/>zuͦgstellt, als er inn ouch wol verdient mitt dem, das er sich dem Interim zuͦgeleint, <lb xml:id="p1z6"/>und deßhalb</foreign> hic asimus d. <persName ref="p8111">Martyri</persName> nondum vendi potest.</s>
					<s n="3" xml:lang="la">Qua de re <lb xml:id="p1z7"/>d. <persName ref="p8442">Iosiam</persName>, generum tuum, pluribus verbis admonui.</s>
					<s n="4" xml:lang="la">Porro peto a te, reverende <lb xml:id="p1z8"/>d. compater, ut <persName ref="p17746">Tertulliani</persName> tui mihi facias copiam; cras eum reddam.</s>
					<s n="5" xml:lang="la" ana="farewell"><lb xml:id="p1z9"/>Vale.</s>
					<s n="6" xml:lang="la">Gratulor etiam, quod te exoneraris <persName ref="p458">Brentianis</persName> molestiis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/><persName ref="p3988">Wolphius</persName> tuus.</s>
				</p>
				<p>
					<note>[nur ein Zettel; keine Adresse]</note>
				</p>
			</div>
		</body>
	</text>
