	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l491">Argentinae</placeName>, primo maii, 1553.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>S. D.</s>
					<s n="3" xml:lang="la"><persName ref="p8437">Erasmi Fabricii</persName> piae memoriae filius dedit <lb xml:id="p1z4"/>mihi literas tuas gratissimas, <persName ref="p495">Bullingere</persName> colendissime: <lb xml:id="p1z5"/>si possem ei aut alii officio meo prodesse, non deer<lb xml:id="p1z6"/>o umquam; nam vel <placeName ref="l587">Tigurini</placeName> nomine mihi commendatis<lb xml:id="p1z7"/>simus est, qui a vobis huc proficiscitur.</s>
					<s n="4" xml:lang="la"><placeName ref="l157">Franko<lb xml:id="p1z8"/>fordiae</placeName> pro <placeName ref="l830">Anglis</placeName> literas et libros curavi in <placeName ref="l830">Angliam</placeName> <lb xml:id="p1z9"/>vehi.</s>
					<s n="5" xml:lang="la">Conciones tuas in <placeName>Ionam</placeName> accepimus, in quibus <lb xml:id="p1z10"/>valde delectatur uxor mea.</s>
					<s n="6" xml:lang="la">Pecuniolam etiam dudum <lb xml:id="p1z11"/>accepimus, ut nuper scripseram.</s>
					<s n="7" xml:lang="la">Fasciculum ad <lb xml:id="p1z12"/>d. d. <persName>Wolfgangum Wormacensem</persName> non attulerunt secum <lb xml:id="p1z13"/>iuvenes, sed incluserunt aliis suis rebus, neque adferentur <lb xml:id="p1z14"/>ante nundinas nostras.</s>
					<s n="8" xml:lang="la">Quum recepero, mittam tute.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>D. <persName ref="p8121">Christophorus Montius</persName> vivit et valet: abfuit ali<lb xml:id="p1z16"/>quandiu, quae fuit silentii occasio.</s>
					<s n="10" xml:lang="la" ana="salute">Salutavi et ad<lb xml:id="p1z17"/>monui virum tuo nomine: promisit se scripturum.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z18"/>Nova quae certa sunt haec habemus, quae lubens <lb xml:id="p1z19"/>scribo, quod nobiscum congratulari posses.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z20"/>Loco <lb xml:id="p1z21"/>d. <persName>Heduonis</persName> defuncti nacti sumus virum tum doctum <lb xml:id="p1z22"/>tum verae religionis alumnum, qui in divinis profitetur <lb xml:id="p1z23"/>et praelegit publice.</s>
					<s n="13" xml:lang="la">Lutheranis adversatur, atque omnibus <lb xml:id="p1z24"/>qui humanae Christi naturae proprietates attribuunt <lb xml:id="p1z25"/>soli divinitati adscribendas.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Confundunt Lutherani, <lb xml:id="p1z26"/>etsi non verbis tamen re ipsa, Christi naturas.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z27"/>Oppugnat is publice, atque audet eos erroris arguere.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z28"/>Utinam possent aperiri eorum oculi, ne videntes caecutiant!</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z29"/>De rebus <placeName ref="l822">Germanicis</placeName> et bello <lb xml:id="p1z31"/>haec audio.</s>
					<s n="18" xml:lang="la">Maii 16 convenient principes et com<lb xml:id="p1z32"/>missarii Caesaris et <persName>Ferdinandi</persName> <placeName ref="l157">Frankofordiae</placeName> ad <lb xml:id="p1z33"/>componendam discordiam.</s>
					<s n="19" xml:lang="la">Utinam id fieret!</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z34"/>Marchio <placeName ref="l1048">Brandenburgensis</placeName> <persName ref="p8616">Albrechtus</persName> aliquot milites <lb xml:id="p1z35"/>pfafforum caecidit; ad quadringentos alii, alii quin<lb xml:id="p1z36"/>gentos affirmant.</s>
					<s n="21" xml:lang="la">Alios spoliavit, iuramento acce<lb xml:id="p1z37"/>pto, ne in eum aut <persName>Caesarem</persName> per tres menses arma moveant.</s>
					<s n="22" xml:lang="la">In <lb xml:id="p1z38"/><placeName ref="l830">Anglia</placeName> sunt omnia quieta de<lb xml:id="p1z39"/>i <lb xml:id="p1z40"/>maximo benefitio.</s>
					<s n="23" xml:lang="la">Legatos iam secundo misit rex nost<lb xml:id="p1z41"/>er ad <persName>Caesarem</persName> et <persName>Gallum</persName> ad bellum componendum.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z42"/>Utinam fieret!</s>
					<s n="25" xml:lang="la">Quid factum sit, scribam quum <lb xml:id="p1z43"/>rescivero.</s>
					<s n="26" xml:lang="la" ana="salute">Saluta uxorem et liberos charos com<lb xml:id="p1z44"/>muni meo et uxoris nomine.</s>
					<s n="27" xml:lang="la" ana="salute">Saluta doctos et <lb xml:id="p1z45"/>pios quosque.</s>
					<s n="28" xml:lang="la" ana="farewell"><lb xml:id="p1z46"/>Bene vale.</s>
					<s n="29" xml:lang="la" ana="salute">Saluta <persName ref="p506">Butlerum</persName> <lb xml:id="p1z47"/>nostrum multies cum coniuge chara.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><lb xml:id="p1z48"/>Tui deditissimus, <persName ref="p505">Io. Burcherus</persName>, <lb xml:id="p1z49"/><placeName ref="l830">Anglus</placeName>.</s>
					<s n="31" xml:lang="la"><pb/><lb xml:id="p2z1"/>Verae religionis antistiti <lb xml:id="p2z2"/>d. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z3"/>amico et domino <lb xml:id="p2z4"/>meo colendissimo.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
