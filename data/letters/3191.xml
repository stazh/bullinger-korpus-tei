	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Diebus praeteritis adobrui te, colendissime <lb xml:id="p1z2"/>domine et frater charissime, literis meis, <lb xml:id="p1z3"/>ut nunc, cum vivam hic epistolam habeas, tibi <lb xml:id="p1z4"/>existimem parcendum alioqui occupatissimo.</s>
					<s n="3" xml:lang="la" ana="salute"><lb xml:id="p1z5"/>Si non vidisti dudum Confessionem urbium <placeName ref="l862">Helvetiae</placeName> <lb xml:id="p1z6"/>conscriptam anno 1536, cum primum <lb xml:id="p1z7"/>te <placeName ref="l28">Basileae</placeName> vidi et salutavi, nunc habebis <lb xml:id="p1z8"/>ab his descriptam.</s>
					<s n="4" xml:lang="la">Quid privatim (nihil <lb xml:id="p1z9"/>adhuc contuli cum fratribus) consultaverimus super <lb xml:id="p1z10"/>hac Confessione, ipsi copiose referent.</s>
					<s n="5" xml:lang="la">Rem <lb xml:id="p1z11"/>feliciter omnem per dei gratiam perfecerunt, ob <lb xml:id="p1z12"/>quam legati sunt missi.</s>
					<s n="6" xml:lang="la">Deo gratia.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale diu <lb xml:id="p1z13"/>nobis superstes.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 22. maii 1557.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p540">Ioanni Calvino</persName>, <lb xml:id="p2z2"/>fratri suo charissimo.</s>
					<s n="11" xml:lang="de"><placeName ref="l167">Genff</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
