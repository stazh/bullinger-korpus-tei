	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salutem adeo exopto et obsequium<note type="margin">a.R.: sequiuum!</note>, quam possum obse<lb xml:id="p1z2"/>quiosissime defero, clarissime domine <persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Pridie idus novembris <placeName ref="l159">Frowenfeld</placeName> venimus praeter <lb xml:id="p1z4"/>nostram opinionem; ibi forte incidimus in sectatores <lb xml:id="p1z5"/>Epicureorum, nosti, quos putem, certe egregios.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Inter alia, cum facta esset mentio de rebus <lb xml:id="p1z7"/>novis, accepimus ex insigni etc.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><placeName ref="l257">Constantię</placeName> con<lb xml:id="p1z8"/>gregatos iri hisce diebus 100 equites in uno hospitio, <lb xml:id="p1z9"/>quid in aliis, ignoramus, cum eo venerimus, audiemus; <lb xml:id="p1z10"/>puto tamen, ut intellexi, eos venturos <placeName ref="l21">Badenam</placeName>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Hoc tuam dignitatem, si quid forte ad rem foret, <lb xml:id="p1z12"/>ignorare nolui; intellexi tamen [nihil boni].</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Plura lubens etc.</s>
					<s n="7" xml:lang="la">Non fert incertus tabellarius.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Valae plurimum.</s>
					<s n="9" xml:lang="la" ana="salute">Salutat te dominus meus magi <lb xml:id="p1z15"/>datae pridie idus novembris anno 1554.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/>Tuus ex animo et obsequentissimus <lb xml:id="p1z17"/><persName ref="p1770">Gregorius Karlin</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Et pietate et doctrina pre<lb xml:id="p2z2"/>stanti viro magistro <persName ref="p495">Heinrico <lb xml:id="p2z3"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>fideli antistiti, domino <lb xml:id="p2z5"/>suo colendissimo.</s>
					<s n="12" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zurch</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
