	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Veniunt ad vos vivae epistolae mater, <persName ref="p2041">Blasius</persName><note xml:id="fn1" type="footnote" n="1">Blasius/<persName ref="p2041">Blaise Marcuard</persName>.</note> <lb xml:id="p1z2"/>et filia mea, illius uxor; itaque non est, ut ego pluribus <lb xml:id="p1z3"/>te obtundam.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Blasius matrem meam illuc <lb xml:id="p1z4"/>deducit, ut simul, dum illi adhuc ocium est, <lb xml:id="p1z5"/>vos invisat vobisque pro acceptis beneficiis agat <lb xml:id="p1z6"/>gratias amicitiamque per literas initam praesentia sua <lb xml:id="p1z7"/>confirmet.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Itaque illum vobis commendo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Tuas interea accepi 24. maii scriptas.</s>
					<s n="6" xml:lang="la">Illis erant <lb xml:id="p1z9"/>adiunctae non modo, quę d. <persName ref="p8063">Steigero</persName>, sed etiam alterae, <lb xml:id="p1z10"/>quę domino de <persName ref="p7682">Mülinen</persName> pertinebant.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Itaque illas <placeName ref="l21">Baden<lb xml:id="p1z11"/>am</placeName> ad ipsum (nam lavat illic cum sua familia) re<lb xml:id="p1z12"/>misi.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Eas, quę ex <placeName ref="l2472">Polonia</placeName> ad d. <persName ref="p540">Calvinum</persName> mittebantur, curavi.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z14"/>Quod <persName ref="p8063">Steigero</persName> de <persName ref="p3099">Sultzero</persName> scripsisti, fecisti bene; vigila<lb xml:id="p1z15"/>bit diligenter, ne quid moliatur, etiamsi huc accedat, nec <lb xml:id="p1z16"/>puto ipsum hic tentaturum aliquid, nisi forte priva<lb xml:id="p1z17"/>tim apud suos, quos novit.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Dominus comprehendet illum tandem <lb xml:id="p1z18"/>in suis practicis et confundet.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Vellem hoc nomine <lb xml:id="p1z19"/>libenter, ut tu quoque tibi patereris persuaderi tandem, <lb xml:id="p1z20"/>ut ad nos venires; ita enim valde debilitarentur <lb xml:id="p1z21"/>illius molimina.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/>De <placeName>Gallis</placeName> referet quędam <persName ref="p2041">Blasius</persName> meus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Ferunt nunc <lb xml:id="p1z23"/>falsum fuisse, quod nuper pro certo affirmabatur de con<lb xml:id="p1z24"/>flictu <placeName ref="l367">Aureliae</placeName> facto.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Itaque quid scribam tandem aut <lb xml:id="p1z25"/>quid credam, nescio; quantum tamen cognoscere et iu<lb xml:id="p1z26"/>dicare possum, res fidelium non bene habent: dimit<lb xml:id="p1z27"/>tunt nostri auxiliares suas copias; reliqui retinent <lb xml:id="p1z28"/>et augent etiam.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z29"/>De rebus nostris <placeName>Sabaudicis</placeName> proxime scripsi.</s>
					<s n="16" xml:lang="la">Valde me affligunt <lb xml:id="p1z30"/>et metuo (apud te hoc depono) grave inter cives <lb xml:id="p1z31"/>dissidium: volent aliqui reddere aliquid, alii nolent, <lb xml:id="p1z32"/>et utraque pars nos vellet suarum esse partium et sibi quasi <lb xml:id="p1z33"/>vicisse videretur, si nos astipularemur.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Sed ego me <lb xml:id="p1z34"/>non immisceo, nisi quantum ad religionem; ibi sedulo <lb xml:id="p1z35"/>hortor, ut illius primaria habeatur ratio, ne peccemus <lb xml:id="p1z36"/>contra deum nobisque illum faciamus hostem, dum homines <lb xml:id="p1z37"/>volumus nobis fieri amicos.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Quod reliquum attinet, non <lb xml:id="p1z38"/>curarem, si totum, quod habent, principi restituerent, modo <lb xml:id="p1z39"/>regnaret Christus; sed quoniam video utrumque esse coniunctum, <lb xml:id="p1z40"/>non possum non esse sollicitus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Interea scio esse, qui nos <lb xml:id="p1z41"/>observent, ut tandem, si quid turbarum oriretur, culpam <lb xml:id="p1z42"/>in nos derivare possent.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Itaque summa cautione opus est<lb xml:id="p1z43"/>; eam ut nobis, qua moderatione decet, concedat <lb xml:id="p1z44"/>dominus, nobiscum precare, obsecro.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="salute">Salutant te amici et <lb xml:id="p1z45"/>fratres omnes, praesertim <persName ref="p8063">Steigerus</persName>, <persName ref="p3494">Diesbachius</persName>, <persName ref="p8417">Musculus</persName> etc., socer <lb xml:id="p1z46"/>item et <persName ref="p8012">Hallerus</persName> q[uaestor] cum <persName ref="p7511">Gravenriedo</persName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="farewell">Vale in domino <lb xml:id="p1z47"/>optime.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><placeName ref="l41">Bernae</placeName> 2a iunii 1563.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z48"/><persName ref="p8018">Ioannes Hallerus</persName>, <lb xml:id="p1z49"/>perpetuo tuus.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino suo <lb xml:id="p2z4"/>honorando et compatri charissimo.</s>
				</p>
			</div>
