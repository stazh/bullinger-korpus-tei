	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la">Sat cito quoniam sat bene et gratissime literis meis (vir <lb xml:id="p1z2"/>clarissime) respondisti.</s>
					<s n="3" xml:lang="la">Quid enim gratius mihi contigisset quam <lb xml:id="p1z3"/>illa tua amicitiae meae et voluntatis acceptio?</s>
					<s n="4" xml:lang="la">Sed de hoc alias et <lb xml:id="p1z4"/>coram, cum sese obtulerit occasio, quam studiose expecto et, spero, <lb xml:id="p1z5"/>nanciscar.</s>
					<s n="5" xml:lang="la">Novi quod ad te scribam, hoc tempore non habeo; <lb xml:id="p1z6"/>quantum enim ex tuis ad egregium d. <persName ref="p8009">Fabritium</persName> literis vidi, intellexisti <lb xml:id="p1z7"/>ea, quae nobis aliquanto sinistre contigerunt in <placeName ref="l832">Gallia</placeName> neque tamen <lb xml:id="p1z8"/>omnia tam sinistre, quemadmodum ipsi <persName ref="p8009">Fabritio</persName> exposui et rescripturum <lb xml:id="p1z9"/>promisit, et par aequalisque clades dici potest; utrinque enim <lb xml:id="p1z10"/>idem militum numerus cecidit; capti quidem ex nostris aliqui <lb xml:id="p1z11"/>primates exercitus cum duce d. de <placeName>Termes</placeName>, at ex aliis eiusdem <lb xml:id="p1z12"/>gradus homines nonnulli interfecti sunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Caetera ab ipso <persName ref="p8009">Fabritio</persName>, <lb xml:id="p1z13"/>alia quoque nova, ubi primum sese obtulerint, a me expecta.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Interim bene valeas, d. colendissime, et me, ut cepisti, ama.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Ex <placeName ref="l98">Curia Rhetorum</placeName> die 15. augusti 1558.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/>Tuus opera et studio deditissimus <persName ref="p8306">J. <lb xml:id="p1z18"/>Ja. Decambray</persName>.</s>
				</p>
				<p>
					<note>[vor 486:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo et doctissimo viro domino <lb xml:id="p4z2"/><persName ref="p495">Henrico Bullingero</persName>, ecclesię <lb xml:id="p4z4"/><placeName ref="l587">Tigurinae</placeName> ministro digni<lb xml:id="p4z5"/>ssimo.</s>
					<s n="11" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note type="author">[Bemerkung von <persName ref="p495">Bullingers</persName> Hand, wieder gestrichen:]</note>
					<s n="12" xml:lang="la">Primae d. a. <lb xml:id="p4z6"/><placeName>Cambray</placeName><lb xml:id="p4z7"/>.</s>
				</p>
			</div>
		</body>
	</text>
