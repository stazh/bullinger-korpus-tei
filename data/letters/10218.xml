	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et innocentiam a domino, charissime frater.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Adde, quęso, christiane <lb xml:id="p1z2"/>tuę prudentiae epicheremata, ut praesentium latoris<note xml:id="fn1" type="footnote" n="1">Weder der Überbringer des Briefes noch der Zweck seiner Reise nach <placeName ref="l587">Zürich</placeName> sind bekannt.</note> conatus in salutem <lb xml:id="p1z3"/>eant.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Ceterum <persName ref="p8440">Gervasii</persName> tui memor mitte celerius ad nos quae <lb xml:id="p1z4"/>furtim commentaris in epistolam Pauli ad Rhomanos<note xml:id="fn2" type="footnote" n="2">Zu <persName ref="p495">Bullingers</persName> Römerbriefkommentar s. oben <ref target="file10217">[Nr. 186]</ref> S. 59, Anm. 2.</note>.</s>
					<s n="4" xml:lang="la">Furtim <lb xml:id="p1z5"/>dico, quia alienorum relatione excepimus, non tua, que in te singu<lb xml:id="p1z6"/>laris est demissio.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="salute">Vale, delitie meę; parentes tuos<note xml:id="fn3" type="footnote" ana="bio" n="3"><persName ref="p20449">Dekan Heinrich Bullinger</persName> und <persName ref="p7042">Anna Bullinger, geb. Wiederkehr</persName>.</note> <lb xml:id="p1z7"/>apud me magnos nomine meo saluta, interim uxorem <lb xml:id="p1z8"/>tuam<note xml:id="fn4" type="footnote" ana="bio" n="4"><persName ref="p8051">Anna Bullinger, geb. Adlischwyler</persName>.</note>, ut soles, mea salute plurimum refice.</s>
					<s n="6" xml:lang="la" ana="farewell">Iterum vale <lb xml:id="p1z9"/>atque iterum (charitas loquitur atque repetit), dimidium animi <lb xml:id="p1z10"/>mei<note xml:id="fn5" type="footnote" n="5">Vgl. <bibl source="b473">Otto</bibl> 26, Nr. 111.</note><lb xml:id="p1z11"/>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Datum 5. die februarii anno sesquimillesimo <lb xml:id="p1z13"/>tricesimo 3.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Tuus tuus <persName ref="p8440">Gervasius</persName>, <lb xml:id="p1z15"/>si quisquam tuus ex animo.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Charissimo meo <lb xml:id="p2z2"/>fratri <persName ref="p495">Heynricho <lb xml:id="p2z3"/>Bullingero</persName>.</s>
				</p>
			</div>
		</body>
	</text>
