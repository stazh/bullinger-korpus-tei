			<zone xml:id="p2z6-0" points="1211,1172 1258,1147 1267,1153 1303,1117 1322,1119 1383,1167 1397,1153 1417,1161 1478,1147 1478,1042 1436,1036 1392,1064 1367,1064 1339,1039 1322,1042 1283,1019 1264,1033 1239,1017 1208,1025">1227,1098 1252,1093 1278,1091 1304,1089 1329,1089 1355,1089 1381,1091 1406,1093 1432,1095 1458,1095 1484,1095</zone>
