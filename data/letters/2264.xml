	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Multa sane et magna de <placeName ref="l587">Tigurinis</placeName> meis praedicaveram; <lb xml:id="p1z2"/>sed nuper vos longe maiora praestitistis homini <placeName ref="l834">Italo</placeName> <lb xml:id="p1z3"/>et ignoto istac iter facienti, qui iam canescentem et <lb xml:id="p1z4"/>longam barbam alit; tanta illum excepistis humanitate, <lb xml:id="p1z5"/>ut eius nomine tibi multum ac reliquis omnibus <lb xml:id="p1z6"/>non solum me debere agnoscam, sed nobilem hunc <lb xml:id="p1z7"/>meum conterraneum etiam commendare nunc audeam <lb xml:id="p1z8"/>atque sperem non ingratum fore; scio enim et saepe iam <lb xml:id="p1z9"/>expertus sum, quanti facias doctos et amicos veritatis, <lb xml:id="p1z10"/>qualis dominus <persName>Hugulinus</persName> hic est.</s>
					<s n="2" xml:lang="la">Mi domine <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z11"/>non aliud cupit quam te videre, te audire tuamque inire <lb xml:id="p1z12"/>familiaritatem.</s>
					<s n="3" xml:lang="la">Videor videre, quam affabilem, quam <lb xml:id="p1z13"/>iucundum simul et gravem te illi praebeas, quapropter iam <lb xml:id="p1z14"/>gratulor ipsi et tibi gratias ago.</s>
					<s n="4" xml:lang="la">Literas tantum <lb xml:id="p1z15"/>expecto, quibus certi aliquid scribas de <persName ref="p3375">Vergerio</persName> nostro <lb xml:id="p1z16"/>et mihi in suum vel amicorum commodum faciendum <lb xml:id="p1z17"/>aliquid mandes.</s>
					<s n="5" xml:lang="la" ana="salute">Saluto fratres omnes, imprimis autem <lb xml:id="p1z18"/>generum tuum <persName ref="p2827">Simlerum</persName>, cui literas vacuas mittere nolim, <lb xml:id="p1z19"/>cum ipse ad me plenas miserit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Interim habeo gratiam.</s>
					<s n="7" xml:lang="la" ana="salute"><lb xml:id="p1z20"/>Salutabis quoque, si grave et molestum non erit d. <persName ref="p4063">Ioannem <lb xml:id="p1z21"/>Zieglerum</persName> illum meum, cui mea omnia etiam commendata velim.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z22"/>Quid praeterea?</s>
					<s n="9" xml:lang="la">Deus sit, qui suo spiritu te corroboret, <lb xml:id="p1z23"/>ut ecclesie sue diu ac foeliciter adesse queas.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z24"/><placeName ref="l167">Genevę</placeName> 19. aprilis 1554.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z25"/>Tui studiosissimus <lb xml:id="p1z26"/><persName ref="p8101">Lelius Sozinus</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>De origine erroris circa missam librum tuum Italice scriptum, quod <lb xml:id="p2z2"/>apud te deposueram, huc ad nos mittes quam primum; offeretur <lb xml:id="p2z3"/>occasio, ut brevi eundem impressum ad te remittere possim.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z4"/>Mittes aut ad dominum <persName ref="p540">Calvinum</persName> vel dominum marchionem, <lb xml:id="p2z5"/>ut tutissime perferatur.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z6"/>Doct<lb xml:id="p2z7"/>rin et pietate clarissim<lb xml:id="p2z8"/>o viro domino <persName ref="p495">Henrico Bulling<lb xml:id="p2z9"/>ero</persName>, mihi semper colendo.</s>
				</p>
				<p>
					<s n="15" xml:lang="de"><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
