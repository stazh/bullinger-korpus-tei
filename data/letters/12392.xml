	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem.</s>
					<s n="2" xml:lang="la">Gratias ago domino nostro Iesu Chris<lb xml:id="p1z2"/>to, qui totum <lb xml:id="p1z3"/><placeName ref="l2477">Palatinatum</placeName> lumine evangelii su<lb xml:id="p1z4"/>i illustravit <placeName ref="l822">Germaniamque</placeName> beneficiis obruere <lb xml:id="p1z5"/>non cessat<note xml:id="fn1" type="footnote" n="1">Siehe <persName ref="p8418">Myconius</persName>' Brief vom 31. Januar 1546 (<ref target="file12388">Nr. 2341</ref>).</note>.</s>
					<s n="3" xml:lang="la" ana="salute">Cedent haec nobis ad salutem, si <lb xml:id="p1z6"/>beneficiis dei recte usi fuerimus; cedent rur<lb xml:id="p1z7"/>sus ad interitum idque nostra culpa, si ingrati <lb xml:id="p1z8"/>esse perrexerimus.</s>
					<s n="4" xml:lang="la">Utinam vero non nimium <lb xml:id="p1z9"/>innitantur in robur <placeName ref="l1202">foederis</placeName><note xml:id="fn2" type="footnote" n="2">Der <placeName ref="l1202">Schmalkaldische</placeName> Bund.</note> sui fideles iisque <lb xml:id="p1z10"/>eveniat, quod nobis usu venit, ut unica hora <lb xml:id="p1z11"/>a pauculis iisque pessimis nebulonibus su<lb xml:id="p1z12"/>perati prorsus dissipentur<note xml:id="fn3" type="footnote" n="3">Anspielung auf die eidgenössischen Protestanten im Zweiten <placeName ref="l242">Kappeler</placeName> Krieg.</note>.</s>
					<s n="5" xml:lang="la">Video ego foedera <lb xml:id="p1z13"/>huiusmodi non fuisse fausta perpetuo.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="6" xml:lang="la">Dominus <lb xml:id="p1z14"/>gratiam suam illis et nobis aspiret.</s>
					<s n="7" xml:lang="la">Aiunt non<lb xml:id="p1z15"/>nulli <persName ref="p20225">Gallum</persName><note xml:id="fn4" type="footnote" n="4">König <persName ref="p20225">Franz I.</persName></note> et <persName ref="p8375">Anglum</persName><note xml:id="fn5" type="footnote" n="5">König <persName ref="p8375">Heinrich VIII.</persName></note> ambire fere foedus <lb xml:id="p1z16"/>illud evangelicum aut saltem amicitiam cum <lb xml:id="p1z17"/>confęderatis exposcere.</s>
					<s n="8" xml:lang="la">Quod an verum sit <lb xml:id="p1z18"/>an falsum, non facile divinarim.</s>
					<s n="9" xml:lang="la">Novi princ<lb xml:id="p1z19"/>ipum artes et simulationes.</s>
					<s n="10" xml:lang="la">Scio <persName ref="p20225">Gallum</persName> ali<lb xml:id="p1z20"/>quando petivisse civitatem christianam;<note xml:id="fn6" type="footnote" n="6">Anspielung auf die früheren Annäherungsversuche <persName ref="p20225">Franz' I.</persName> an die protestantischen <placeName ref="l862">eidgenössischen</placeName> Orte bzw. Städte; s. <bibl source="b680">Walther</bibl> <hi>Köhler,</hi> Zu Zwinglis französischen Bündnisplänen, in: <bibl source="b714">Zwa</bibl> 4/10, 1925, 302-311. - Wir danken Herrn Rainer Henrich, uns auf diesen Aufsatz aufmerksam gemacht zu haben.</note> tem<lb xml:id="p1z21"/>pore enim felici multos numeramus amicos<note xml:id="fn7" type="footnote" n="7">Vgl. <bibl source="b639">TPMA</bibl> IV 11, Nr. 104f.</note>.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z22"/>Ubi vero dominus igni nos probavit,<note xml:id="fn8" type="footnote" n="8">Vgl. <cit type="bible"><ref>1Kor 3, 13</ref></cit>; <cit type="bible"><ref>1Petr 1, 7</ref></cit>.</note> declaravit <lb xml:id="p1z23"/><persName ref="p20225">Gallus</persName> interea sibi magis Cainicae urbis<note xml:id="fn9" type="footnote" ana="bio" n="9">Vgl. <cit type="bible"><ref>Gen 4, 17.</ref></cit> - Die Stadt, die Kain bauen ließ, benannte er nach seinem Sohn Henoch.</note> <lb xml:id="p1z24"/>quam Abelicae<note xml:id="fn10" type="footnote" n="10">Zu Abels Gottgefälligkeit s. <cit type="bible"><ref>Gen 4, 4</ref></cit>.</note> municipium<note xml:id="fn11" type="footnote" n="11">Hier im Sinne von Bürgerschaft; s. <bibl source="b353">Kirsch</bibl> 1831. - Vgl. <hi><persName ref="p18700">Augustin</persName>,</hi> De civitate dei, 15, 1, 5-9.</note> placere<note xml:id="fn12" type="footnote" n="12">Zu verstehen ist, dass <persName ref="p20225">Franz I.</persName> lieber wie Kain Anhänger eines von Gott nicht gewollten Gottesdienstes (bzw. der Papstkirche) bleiben wollte, als sich wie Abel Gottes Willen zu unterwerfen.</note>.</s>
					<s n="12" xml:lang="la">Cave<lb xml:id="p1z25"/>ant ergo pii, ne onerent se sociis qualibuscunque <lb xml:id="p1z26"/>et tandem sua mole ruant.</s>
					<s n="13" xml:lang="la">Non stertit aut <lb xml:id="p1z27"/>dormit caesar<note xml:id="fn13" type="footnote" n="13"><persName ref="p18538">Karl V.</persName></note>.</s>
					<s n="14" xml:lang="la">Habet ille latas aures et <lb xml:id="p1z28"/>longe videntes oculos, nam habet ubique fautores <lb xml:id="p1z29"/>suos.</s>
					<s n="15" xml:lang="la">Habemus item plures, quam ipsi putemus, <lb xml:id="p1z30"/>hostes, etiam inter coniunctissimos.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="16" xml:lang="la">Rem <lb xml:id="p1z31"/>vero longe gratissimam faceres, si in tempore <lb xml:id="p1z32"/>moneres de bello, cuius mentionem fecisti i<lb xml:id="p1z33"/>n postremis<note xml:id="fn14" type="footnote" n="14">Siehe <ref target="file12388">Nr. 2341</ref>,19-21.</note>.</s>
					<s n="17" xml:lang="la">Maximam inde utilitatem <lb xml:id="p1z34"/>caperem, si verum esse audirem idque in tempore, <lb xml:id="p1z35"/>quod dicitur <persName ref="p20225">Gallum</persName> et <persName ref="p18538">Aquilam</persName><note xml:id="fn15" type="footnote" n="15">Kaiser <persName ref="p18538">Karl V.</persName></note> denuo aleam <lb xml:id="p1z36"/>Martis<note xml:id="fn16" type="footnote" n="16">Mars, der römische Kriegsgott. - aleam Martis: das ungewisse Kriegsglück.</note> experturos.</s>
					<s n="18" xml:lang="la">Proinde oro, ne hic quid <lb xml:id="p1z37"/>negligas.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="19" xml:lang="la"><persName ref="p1278">Gastius</persName> libenter curabit literas; denique <lb xml:id="p1z38"/>observanti<note xml:id="fn17" type="footnote" n="17">Damit ist <persName ref="p1278">Gast</persName> gemeint.</note> semper in tempore offerentur, qui <placeName ref="l587">Tigurum</placeName> abeunt<note xml:id="fn18" type="footnote" n="18">Anspielung auf <ref target="file12388">Nr. 2341</ref>,1.</note>.<pb type="edition" next="134"/></s>
					<s n="20" xml:lang="la"><lb xml:id="p1z39"/>Recte hic valemus omnes grati<lb xml:id="p1z41"/>a <lb xml:id="p1z42"/>domino.</s>
					<s n="21" xml:lang="la">Utinam tu quoque cum tuis <lb xml:id="p1z43"/>valeas!</s>
					<s n="22" xml:lang="la" ana="farewell">Vale.</s>
					<s n="23" xml:lang="la" ana="salute">Salutant te <persName ref="p8127">Pellicanus</persName>, <persName ref="p8171">Bibliander</persName>, <persName ref="p8011">Gvaltherus</persName>, <lb xml:id="p1z44"/><persName ref="p473">Buchterus</persName><note xml:id="fn19" type="footnote" n="19"><persName ref="p473">Heinrich Buchter</persName>, der Nachfolger von <persName ref="p8412">Kaspar Megander</persName>; s. <bibl source="b18">HBBW XV</bibl> 481f, Anm. 12. 535, <ref target="file12294">Nr. 2247</ref>.</note> et reliqui.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z45"/><placeName ref="l587">Tiguri</placeName>, 4. februarii an<lb xml:id="p1z46"/>no 1546.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z47"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p8418">Osvaldo <lb xml:id="p2z2"/>Myconio</persName>, vigilantissimo <placeName ref="l28">Basiliensis</placeName> <lb xml:id="p2z3"/>ecclesiae pastori, domino <lb xml:id="p2z4"/>et fratri colendo et di<lb xml:id="p2z5"/>lecto.</s>
				</p>
			</div>
