	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D. P.</s>
					<s n="2" xml:lang="la">Ante 10 dies, vir honestissime, dedi ad te literas meas cuidam iuveni, nepoti <persName ref="p8222">Massarii</persName>, istac transeunti, <lb xml:id="p1z2"/>quibus tuis proxime ad me missis respondebam.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Hac solum de causa nunc rursus scribo, ut illius nuncii <lb xml:id="p1z3"/>fidelitatem sciam, an videlicet eas reddiderit necne, id quod tuo commodo uno verbo indicare <lb xml:id="p1z4"/>mihi pro tua humanitate recordaberis.</s>
					<s n="4" xml:lang="la">Aliud, quod scribam, nunc non habeo.</s>
					<s n="5" xml:lang="la">Ferunt tamen certum esse populum <lb xml:id="p1z5"/><placeName ref="l830">Anglicum</placeName> arma deposuisse ac regem novum, nempe <persName>Philippum</persName>, adventasse.</s>
					<s n="6" xml:lang="la">Cęsar ea re letior factus in dies <lb xml:id="p1z6"/>validior factus est, ita ut venationem iam exerceat.</s>
					<s n="7" xml:lang="la">Germani principes in armis, quiete tamen, sunt <lb xml:id="p1z7"/>in Caesaris gratiam.</s>
					<s n="8" xml:lang="la">De <persName>Alberto</persName> fere actum est.</s>
					<s n="9" xml:lang="la">Existimant <placeName ref="l648">Rhetos</placeName> paucos in reditu superfuturos etc.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z8"/>Dominus sospitem feliciter ac diutissime te servet.</s>
					<s n="11" xml:lang="la">Ex <placeName ref="l28">Basilea</placeName> 4. die iunii 1554.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z9"/>Tuus ex animo <lb xml:id="p1z10"/><persName ref="p1327">Gulielmus Gratarolus</persName> medicus.</s>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Optimo <placeName ref="l587">Tigurinae</placeName> ecclesiae pastori <lb xml:id="p2z2"/>d. <persName ref="p495">Heinricho Bullingero</persName>, fratri meo observandissimo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tigurum</placeName>.</s>
					<s n="15" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
