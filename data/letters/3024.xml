	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l646">Glareanorum</placeName> negocium valde me tenet sollicitum, quia non <lb xml:id="p1z2"/>videntur quieturi 5 Pagi, dum votis suis satisfiat, et nimio sibi <lb xml:id="p1z3"/>blandiuntur optimi viri, quod leve adeo delictum existiment consensionem <lb xml:id="p1z4"/>ad erigendum missae idolum, quod citra coactionem accedendi admittatur.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z5"/>Est autem dominus, qui posuit mari terminos quique etiam mala nostra <lb xml:id="p1z6"/>novit convertere ad sui nominis gloriam.</s>
					<s n="3" xml:lang="la"><placeName ref="l167">Genevenses</placeName> Paterniaci <lb xml:id="p1z7"/>cum <placeName ref="l41">Bernatibus</placeName> nuper tractarunt super controversis articulis quibusdam; <lb xml:id="p1z8"/>sed quid effectum sit, ignoratur.</s>
					<s n="4" xml:lang="la">Marchio nobis vicinus in reformandis <lb xml:id="p1z9"/>ecclesiis progreditur, quanquam ad nos usque nondum pervenerit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/><persName>Maximilianus</persName> restituisse fertur concionatores evangelicos <lb xml:id="p1z11"/>a patre <persName ref="p18477">Ferdinando</persName> in Boemia pulsos.</s>
					<s n="6" xml:lang="la">Quod si verum <lb xml:id="p1z12"/>est, facilius obtinebunt sua vota Austriaci.</s>
					<s n="7" xml:lang="la">Promisit idem se <lb xml:id="p1z13"/>cum sororio <persName ref="p18423">ALBERTO Bavaro</persName> acturum, ut de religione cum <lb xml:id="p1z14"/>reliquis principibus Germaniae consentiat.</s>
					<s n="8" xml:lang="la">Scribit ad me ex <lb xml:id="p1z15"/><placeName ref="l231">Ingolstadio</placeName> vir doctissimus et pientissimus <persName>Löscherus</persName> celebratam <lb xml:id="p1z16"/>caenam dominicam sub utraque specie in 8 aut 9 parrhochiis <lb xml:id="p1z17"/>magno populi concursu et adplausu, urgeri sine inte<lb xml:id="p1z18"/>rmissione reformationem a nobilitate, cui se opponant <lb xml:id="p1z19"/>3 consiliarii principis; sed incassum laboraturos in tanto <lb xml:id="p1z20"/>tamque consentiente nobilitatis studio.</s>
					<s n="9" xml:lang="la"><persName ref="p8371">Albertus</persName> marchio <lb xml:id="p1z21"/>laetaliter aegrotat, quo nomine graviter lugere dicuntur episcopi.</s>
					<s n="10" xml:lang="la"><persName>Marsilii <lb xml:id="p1z22"/>Patavini</persName> librum mitto.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Bene vale in Christo Iesu cum tuis <lb xml:id="p1z23"/>omnibus.</s>
					<s n="12" xml:lang="la"><placeName ref="l28">Basileae</placeName> 26. septembris anno 1556.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">T<lb xml:id="p1z24"/>[uus] <persName ref="p3099">Sculce<lb xml:id="p1z25"/>rus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>antistiti, domino et fratri <lb xml:id="p2z4"/>colendissimo et charissimo <lb xml:id="p2z5"/>suo.</s>
				</p>
			</div>
		</body>
	</text>
