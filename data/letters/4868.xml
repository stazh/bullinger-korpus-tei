	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Venerunt hi fratres ex <placeName>valle Angronia</placeName> et aliis vicinis <lb xml:id="p1z2"/>ad rogandum inopię suę subsidium.</s>
					<s n="3" xml:lang="la">Non insultavimus in calamitatem, <lb xml:id="p1z3"/>quod arma parum considerate sumpserunt, certe nobis <lb xml:id="p1z4"/>dissuadentibus.</s>
					<s n="4" xml:lang="la">Ita sunt diruti omnibus fortunis, ut eorum <lb xml:id="p1z5"/>miserię omnes eos, qui humanitate pręditi sunt, ad misericordiam <lb xml:id="p1z6"/>flectant.</s>
					<s n="5" xml:lang="la">Apud nos minor summa confecta est, quod tertia <lb xml:id="p1z7"/>pars hospitum hinc evolavit, pauperes tantum relicti sunt.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Contraximus autem ęs alienum ad quatuor millia coronatorum, <lb xml:id="p1z9"/>quo tempore, etsi non sapienter, recte tamen fecimus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Qui <lb xml:id="p1z10"/>persolvere debuerat, surdus est.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Ita a nobis, quod turpe <lb xml:id="p1z11"/>erit <placeName>Navarro</placeName>, numerandum erit, quod optimo iure in suas <lb xml:id="p1z12"/>tabulas referre debuerat.</s>
					<s n="9" xml:lang="la">Iam ad vos, sicuti mandatum <lb xml:id="p1z13"/>est, proficiscuntur.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l41">Bernę</placeName> eos commendare stultum fuisset; <lb xml:id="p1z14"/>literas ad vos negare integrum non fuit.</s>
					<s n="11" xml:lang="la">Si ita censueritis, <lb xml:id="p1z15"/>qu[u]m <placeName ref="l441">Schaffusiam</placeName> transire volent, eos consilio regetis et <lb xml:id="p1z16"/>adiuvabitis vestra gratia et authoritate.</s>
					<s n="12" xml:lang="la" ana="farewell">Valete, viri <lb xml:id="p1z17"/>pręstantissimi et ex animo venerandi fratres.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Dominus vos <lb xml:id="p1z18"/>semper gubernet, tueatur, benedicat.</s>
					<s n="14" xml:lang="la"><placeName ref="l167">Genevę</placeName> 14. <lb xml:id="p1z19"/>iulii 1561.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p540">Johannes Calvinus</persName> vester <lb xml:id="p1z21"/>fratrum nomine et mandato.</s>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimis viris et <lb xml:id="p2z2"/>fidelibus Christi servis <lb xml:id="p2z3"/>ecclesię <placeName ref="l587">Tigurinę</placeName> pasto<lb xml:id="p2z4"/>ribus et doctoribus, <lb xml:id="p2z5"/>symmystis et fratribus <lb xml:id="p2z6"/>vere observandis.</s>
				</p>
			</div>
		</body>
	</text>
