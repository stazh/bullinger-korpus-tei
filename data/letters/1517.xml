	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Spero vos isthic, compater in domino charissime, <lb xml:id="p1z2"/>recte valere omnes.</s>
					<s n="3" xml:lang="la">Nostrae civitati vicina tota <lb xml:id="p1z3"/>peste corrupta nescio quid mali minantur.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Scatent omnia vitę depravatae corruptelis, <lb xml:id="p1z5"/>quare mirum non est, quod subinde flagello dei <lb xml:id="p1z6"/>invisimur.</s>
					<s n="5" xml:lang="la"><placeName ref="l28">Basilienses</placeName> atra lues admodum <lb xml:id="p1z7"/>infestat ac quotidie multos absumit.</s>
					<s n="6" xml:lang="la">Septi<lb xml:id="p1z8"/>mana praeterita migravit ex hoc saeculo <lb xml:id="p1z9"/><persName ref="p8418">Myconius</persName> noster, vir pius ac veteranus <lb xml:id="p1z10"/>Christi minister.</s>
					<s n="7" xml:lang="la">De <persName ref="p1804">Iodoco</persName> nostro audisti iam <lb xml:id="p1z11"/>antea.</s>
					<s n="8" xml:lang="la">Migrant ex hac vita plurimi, <lb xml:id="p1z12"/>quorum ministeriis diu adiuta fuit ecclesia Christi; <lb xml:id="p1z13"/>quibus utinam succedant, etsi non potiores, <lb xml:id="p1z14"/>pares saltem ac priorum curriculo ex aequo <lb xml:id="p1z15"/>respondentes.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>Quas hic inclusas reperis, <persName ref="p8055">Ambrosii</persName> nostri <lb xml:id="p1z17"/>sunt; misit eas ad me ante octiduum, ut, <lb xml:id="p1z18"/>quamprimum possem, mitterem <placeName ref="l18">Augustam</placeName>.</s>
					<s n="10" xml:lang="la">Quoniam <lb xml:id="p1z19"/>vero nec est ad manum quisquam nec sperare <lb xml:id="p1z20"/>possum, ut brevi certus aliquis homo detur, <lb xml:id="p1z21"/>cui illas concedam, visum est eas tuae curae <lb xml:id="p1z22"/>committere, ut per te <placeName ref="l473">Sangallum</placeName> ad amicum <lb xml:id="p1z23"/>aliquem mittantur, cuius opera tabellario <lb xml:id="p1z24"/>frequenter <placeName ref="l18">Augustam</placeName> eunti tradantur.</s>
					<s n="11" xml:lang="la">Scio <lb xml:id="p1z25"/>te in gratiam <persName ref="p8055">Ambrosii</persName> nostri officium hoc haud <lb xml:id="p1z26"/>gravatim subiturum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z27"/>De bellicis motibus, quos forsan imminens <lb xml:id="p1z28"/>hyems brevi compescet, ne gry quidem <lb xml:id="p1z29"/>ad nos adfertur, neque de rebus <placeName ref="l882">Hungariae</placeName> <lb xml:id="p1z30"/>quicquam post cladem nuper acceptam audimus.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z31"/>Si quid harum rerum habes, quaeso communices.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z32"/><persName ref="p1278">Gastius</persName> noster solebat subinde nova utcunque audita <lb xml:id="p1z33"/>scribere; post illius obitum nemo est <placeName ref="l28">Basileę</placeName>, <lb xml:id="p1z34"/>qui pari studio res auditu perceptas communicet.</s>
					<s n="15" xml:lang="la" ana="farewell"><lb xml:id="p1z35"/>Optime vale, compater in domino charissime.</s>
					<s n="16" xml:lang="la" ana="salute">Salutem tuis <lb xml:id="p1z36"/>omnibus; salutant te mei omnes, uxor ac <lb xml:id="p1z37"/>liberi.</s>
					<s n="17" xml:lang="la"><placeName ref="l41">Bernae</placeName> 1552.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z38"/><persName ref="p8417">W[olfgangus] Musc[ulus]</persName>, <lb xml:id="p1z39"/>com<pb/><lb xml:id="p2z1"/>pater tuus <lb xml:id="p2z2"/>in domino<lb xml:id="p2z3"/>.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z4"/>Clarissimo <lb xml:id="p2z5"/>viro m. <lb xml:id="p2z6"/><persName ref="p495">Heinrycho <lb xml:id="p2z7"/>Bullingero</persName>, <lb xml:id="p2z8"/><placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z9"/>ecclesiae antistiti, <lb xml:id="p2z10"/>compatri <lb xml:id="p2z11"/>suo charissimo.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z12"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
