	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Gratia d. Paxi a domino nostro Iesu Ci150, qui
					<lb xml:id="p1z2"/>met ipsum offerendo nos patri coelesti reconciliavit
					<lb xml:id="p1z3"/>Gratulor vobis vestraeque ecclesiae plurimum, qui eandem in doctin
					<lb xml:id="p1z4"/>vitae genere, quam hactenus semper retineatis costan
					<lb xml:id="p1z5"/>quam ut indies magis magisque coelebrem ad maiestatem
					<lb xml:id="p1z6"/>nominis divini amplificandam reddatis, etiam atque etiam rogo.
					<lb xml:id="p1z7"/>quo exemplo vestro moti ad facuendum simile spiritu menteque
					<lb xml:id="p1z8"/>reddamur alacriores; nam superioribus his diebus cum et
					<lb xml:id="p1z9"/>ris ecclesiae nostrae quidam magnam in mari fuerint
					<lb xml:id="p1z10"/>calamitatem perpessi, ita ut adverso vito ac tempestatis
					<lb xml:id="p1z11"/>ad scopulos naves iisae atque confractae, dum alii aliis ferendo
					<lb xml:id="p1z12"/>episcopo praesto essent signoque sublato pericutum adesse sociis
					<lb xml:id="p1z13"/>significassent, contestim id suspicati pyratae omni vi mi
					<lb xml:id="p1z14"/>petum in ipsos faciunt, cum paltera manu cum fluctibus
					<lb xml:id="p1z15"/>ipsis, altera vero cum hostibus pugnandum esset labore multo
					<lb xml:id="p1z16"/>hostiumque victi numero, partim cesi partimque capti acmenditi
					<lb xml:id="p1z17"/>ad stuiam aliaque servilia munera in varias distrahuntur regiones
					<lb xml:id="p1z18"/>ab ecclesia subornati, qui collectis eleemosinis ipsos quae
					<lb xml:id="p1z19"/>suntque ab hostium manibus redempturi. Hi ergo
					<lb xml:id="p1z20"/>afflictis rebus cum eam vestrae ecclesiae atque reipublicae costatim
					<lb xml:id="p1z21"/>intelligant, ut contemptis rebus fortuitis foederi
					<lb xml:id="p1z22"/>bellico praetroque Gallico, malitis cum Chrsto vivere
					<lb xml:id="p1z23"/>in paupertate quam omnis afflicere animae facere iacturam, maior
					<lb xml:id="p1z24"/>res certe ad res gerendas ferendaque miseriam animos suscipuit
					<lb xml:id="p1z25"/>Ferendo igitur adversa neque animis rebus secundis sublatise
					<lb xml:id="p1z26"/>emplo solatioque nos mutuo siamus, quo fortiter pugnantes
					<lb xml:id="p1z27"/>coronam immertescibistis gloriae adipiscamur. Reliqua noti
					<lb xml:id="p1z28"/>tabellarius ipsus narrabit. Vale. Salutabis inprimis hosus
					<lb xml:id="p1z29"/>meum d. Swinglium tuamque totam familiam et, qui
					<lb xml:id="p1z30"/>me norunt fratres spiritu et animo. Groingae Phrysurum
					<lb xml:id="p1z31"/>anno nativitatis Messiae nostri 1558 18. calendi.
					<lb xml:id="p1z32"/>Mey.
					<lb xml:id="p1z33"/>Nicolaus a Starkeburg vester.
					<lb xml:id="p1z34"/>iclientulus in verbo veritatis.
					<pb/>
					<lb xml:id="p2z1"/>.
					<lb xml:id="p2z2"/>Henrico Bullingero,
					<lb xml:id="p2z3"/>ecclesiae Tygurinae episco
					<lb xml:id="p2z4"/>vigriantissimo d.
					<lb xml:id="p2z5"/>suo perpetuo colendo.
					<lb xml:id="p2z6"/>Tyguri Zürich.
				</p>
