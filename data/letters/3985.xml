	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><persName>Polonus</persName> hic praesentium lator istuc profecturus cupivit se t[<lb xml:id="p1z2"/>uae] h[umanitati] commendari, quod ut facerem, haud gravatim impetravit.</s>
					<s n="3" xml:lang="la">Vir est optimus, <lb xml:id="p1z3"/>quantum ego pervidere potui, doctrina non poenitenda, candore et synceritate sin<lb xml:id="p1z4"/>gulari praeditus.</s>
					<s n="4" xml:lang="la">Theologica studia religiose sectatur, quo praestare olim <lb xml:id="p1z5"/>ministrum ecclesiae non erubescendum possit.</s>
					<s n="5" xml:lang="la">Excipies ergo eum pro consueta hum<lb xml:id="p1z6"/>anitate et pietate tua.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><persName>Davidici Brabanti</persName> die hesterna coram refertissimo <lb xml:id="p1z7"/>ecclesiae coetu errorem et impietatem abiurarunt et reconciliati sunt ecclesiae.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Historiam <lb xml:id="p1z8"/>rei gestae ex hoc, quem commendo, si libebit, prolixe cognosces, ut qui <foreign xml:lang="el">αὐ<lb xml:id="p1z9"/>τοπτῆς</foreign> interfuit.</s>
					<s n="8" xml:lang="la">Articulos mittere decreveram ex libris autoris <lb xml:id="p1z10"/>hinc inde descriptos, sed ad manum in praesentia non erant; ubi recepero, <lb xml:id="p1z11"/>mittam prima occasione.</s>
					<s n="9" xml:lang="la">Ex comiciis nihildum certi audimus; fama <lb xml:id="p1z12"/>tulerat a Gallo imperio restitutum iri Metas et alia, quae imperio abrepta teneat; <lb xml:id="p1z13"/>sed quid futurum sit, ignoratur.</s>
					<s n="10" xml:lang="la"><persName>Philippum</persName> etiamnum copias habet nec persolutas; <lb xml:id="p1z14"/>speciem existimant dilatam solutionem esse, qua moliantur nova consilia.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z15"/>Si quae tu habes ab amicis, rogo, communica.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale in Christo Iesu <lb xml:id="p1z16"/>cum uxore et tuis omnibus.</s>
					<s n="13" xml:lang="la"><placeName ref="l28">Basileae</placeName> 7a iunii anno 1559.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Ar<lb xml:id="p1z17"/>ticulos <persName>Davidicos</persName> praesentium lator <lb xml:id="p1z18"/>communicabit.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z19"/>Tuus <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName> domino et fratri <lb xml:id="p2z3"/>colendissimo et charissimo <lb xml:id="p2z4"/>suo.</s>
				</p>
			</div>
		</body>
	</text>
