	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Cum nuper cursor vester hic esset, non <lb xml:id="p1z2"/>eram domi, et antequam reverterer, ipse discesserat.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Hinc fit, ut literas has d. <persName ref="p8417">Musculi</persName>, quas <lb xml:id="p1z4"/>nunc mitto, serius accipias; erant enim tum <lb xml:id="p1z5"/>mittendae, sed propter meam absentiam hoc ne<lb xml:id="p1z6"/>glectum fuit.</s>
					<s n="4" xml:lang="la">Scribit forte aliquid de rebus <lb xml:id="p1z7"/>quoque <placeName ref="l18">Augustanis</placeName>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Interea tamen, dum illae scriptae <lb xml:id="p1z8"/>sunt, accepimus ab <placeName ref="l18">Augusta</placeName> alias literas.</s>
					<s n="6" xml:lang="la">Scribunt <lb xml:id="p1z9"/>viri cordati esse ibi quendam ex ministris novis <lb xml:id="p1z10"/>ubiquitarium, qui ubiquitatem corporis Christi <lb xml:id="p1z11"/>publice propugnet damnetque omnes diversum sentientes <lb xml:id="p1z12"/>clamitetque eos e finibus imperii eiici debere, <lb xml:id="p1z13"/>eo quod dissentiant a Confessione <placeName ref="l18">Augustana</placeName>.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Reliqui aut dissimulant aut connivent; populus <lb xml:id="p1z15"/>scinditur in partes et affligitur valde dogmate hoc <lb xml:id="p1z16"/>novo.</s>
					<s n="8" xml:lang="de"><foreign xml:lang="la">Scribunt etiam,</foreign> das vil rütery hin und <lb xml:id="p1z17"/>wider schwäbe, da 30, da 40 mitt einander, <lb xml:id="p1z18"/>besonder uff <placeName ref="l361">Nürenberg</placeName> zuͦ; sigind weder lüth <lb xml:id="p1z19"/>noch güter sicher, und wüß nieman, wäm si zuͦghörig.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>De principe <placeName ref="l2478">Sabaudię</placeName> audimus <lb xml:id="p1z22"/>illum esse <placeName>Nyßae</placeName> ibique in suam fidem recepisse <lb xml:id="p1z23"/><placeName>Corsos</placeName>, qui iuxta pacis conditiones <placeName ref="l1121">Genuensibus</placeName> <lb xml:id="p1z24"/>restitui debuerant; sed cum illi ad eos redire <lb xml:id="p1z25"/>nollent, Sabaudum se interposuisse eosque in fidem <lb xml:id="p1z26"/>suam recepisse esseque eius rei nomine belli aliqua <lb xml:id="p1z27"/>initia in procinctu inter ipsum et <placeName ref="l1121">Genuenses</placeName>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z28"/>Audimus etiam nunc ex testibus certis, quod prius <lb xml:id="p1z29"/>nonnisi ex incertis habebamus, eum dotis uxoris <lb xml:id="p1z30"/>suę nomine <placeName ref="l301">Lugduni</placeName> recepisse trecenta millia <lb xml:id="p1z31"/>coronatorum eam pecuniam universam, <lb xml:id="p1z32"/>cum per <placeName ref="l3048">Rhodanum</placeName> deveheretur, esse submersam.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z33"/>Habemus haec ex nobili quodam, qui modo ex aula <lb xml:id="p1z34"/>illius venit.</s>
					<s n="12" xml:lang="la">Refert is etiam ea, quę de <placeName ref="l2801">Corsis</placeName> et <lb xml:id="p1z35"/><placeName ref="l1121">Genuensibus</placeName> scripsi.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Dicit etiam eum munire castrum <lb xml:id="p1z36"/>in <placeName>Valla Franca</placeName>.</s>
					<s n="14" xml:lang="la">Addit esse hominem <lb xml:id="p1z37"/>papismi superstitionibus mire deditem et factum <lb xml:id="p1z38"/>nuper, ut a comite de <persName>Tschalan</persName>, qui est aulae <lb xml:id="p1z39"/>illius magister, introducti sint ad illum mimi <lb xml:id="p1z40"/>quidam, qui alias phiolis coram eo ludere so<lb xml:id="p1z41"/>lebant, ut recitarent coram eo ludicra aliquae, <lb xml:id="p1z42"/>quorum ludorum varia genera nossent.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Ibi eos reci<lb xml:id="p1z43"/>tasse quaedam contra luxum sacerdotum facientia; <lb xml:id="p1z44"/>sed principem interrupisse actionem et eos a conspectu <lb xml:id="p1z45"/>suo discedere iussisse.</s>
					<s n="16" xml:lang="la">Excusavit comes factum <lb xml:id="p1z46"/>monuitque, ut aliam fabulam luderent.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Reversi er<lb xml:id="p1z47"/>go luserunt quiddam, cuius argumentum fuit: "Totum, <pb/><lb xml:id="p2z1"/>nihil, aliquid; <foreign xml:lang="de">nüt, etwas, gar."</foreign></s>
					<s n="18" xml:lang="la">Recitarunt historias <lb xml:id="p2z2"/>eorum, qui cum totum habere vellent, nihil obtinuerunt, <lb xml:id="p2z3"/>et alia eiusmodi.</s>
					<s n="19" xml:lang="la">Ea actione plus est offensus quam <lb xml:id="p2z4"/>priore iussitque eos in vincula coniicere missisque <lb xml:id="p2z5"/>inquisitoribus, quoniam Lutheranismi eos suspectos habuit, <lb xml:id="p2z6"/>de religione examinari curavit, et nisi <lb xml:id="p2z7"/>ipsi se excusassent, vix supplicia evasissent extrema.</s>
					<s n="20" xml:lang="la"><lb xml:id="p2z8"/>De morte <persName>Philippi</persName> aliunde quoque rumores ad nos afferuntur; se<lb xml:id="p2z9"/>d nemo tamen adhuc est, qui certo eam affirmare <lb xml:id="p2z10"/>velit.</s>
					<s n="21" xml:lang="la">Quod praeterea nunc scribam, non habeo.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p2z11"/>Itaque te domino commendo.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="salute">Salutem dic uxori tuę, liberis, <lb xml:id="p2z12"/>generis, amicis et fratribus omnibus.</s>
				</p>
				<p>
					<s n="24" xml:lang="la" ana="salute">Salutant te nostri, inprimis socer, <persName ref="p8012">Hallerus</persName>, <persName ref="p4791">Vischerus</persName>, <persName ref="p3494">Diesba<lb xml:id="p2z13"/>chius</persName> etc.</s>
					<s n="25" xml:lang="la"><placeName ref="l41">Bernae</placeName> 3. decembris 1559.</s>
				</p>
