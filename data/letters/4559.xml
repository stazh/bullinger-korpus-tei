					<lb xml:id="p2z5"/>factum dica alias
					<lb xml:id="p2z6"/>novembris. Salutant te tuosque
					<lb xml:id="p2z7"/>Tiguri.
					<lb xml:id="p2z8"/>domino
					<lb xml:id="p2z9"/>e.Saluta Philicum Pontas consules 1560.
