	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Tertia mensis huius, compater in domino <lb xml:id="p1z2"/>charissime, tuas accepi, ex quibus intelligo <lb xml:id="p1z3"/>redditos esse tibi Commentarios meos <lb xml:id="p1z4"/>in Genesim, quemadmodum <persName ref="p8416">Abrahae</persName>, filio meo, <lb xml:id="p1z5"/>cum <placeName ref="l28">Basileę</placeName> essem, constitueram.</s>
					<s n="3" xml:lang="la">Non est, <lb xml:id="p1z6"/>ut pro illis tantopere gratias agas; scio <lb xml:id="p1z7"/>me tibi multo debere maiora.</s>
					<s n="4" xml:lang="la">Admodum <lb xml:id="p1z8"/>autem placet, quod Genesim es ecclesiae <lb xml:id="p1z9"/>vestrae dominicis diebus explicaturus; spero <lb xml:id="p1z10"/>fore, ut subinde, quae me vel fugerunt <lb xml:id="p1z11"/>vel torserunt, per te attingantur et <lb xml:id="p1z12"/>explicentur, de quibus oro per occasionem <lb xml:id="p1z13"/>ad me scribas, praesertim si quid de<lb xml:id="p1z14"/>praehenderis, quod emendandum esse <lb xml:id="p1z15"/>putaveris; fieri non potest, ut in eius<lb xml:id="p1z16"/>modi prolixis operibus non obrepat <lb xml:id="p1z17"/>quantumvis diligenter intento somnolen<lb xml:id="p1z18"/>tia et lapsus, etiamsi animus integer <lb xml:id="p1z19"/>sit et ab omnis generis erroribus <lb xml:id="p1z20"/>abhorrens.</s>
					<s n="5" xml:lang="la">Nemo sua ipsius cogitata et <lb xml:id="p1z21"/>dicta satis vigilanter observat; in ea, <lb xml:id="p1z22"/>quae sunt aliorum, fere omnes plus satis <lb xml:id="p1z23"/>habemus acuminis.</s>
					<s n="6" xml:lang="la">Et est hic liber <lb xml:id="p1z24"/>alias sic comparatus, ut amplissimas <lb xml:id="p1z25"/>habeat ostendendi ingenii materias, <lb xml:id="p1z26"/>in quibus scio me hominibus illis, <lb xml:id="p1z27"/>qui delicato palato aliorum scripta super<lb xml:id="p1z28"/>ficietenus degustant, haudquaquam satisfacere.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z29"/>Bonorum virorum iudicia non metuo, <lb xml:id="p1z30"/>quae errantibus quoque non solum innoxia <lb xml:id="p1z31"/>sunt, sed et plurimum conducunt.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z32"/>Caeterum obsecro, ne sit molestum, quas <lb xml:id="p1z33"/>hic inclusas reperis, prima commoda occasione <lb xml:id="p1z34"/>mittere <placeName ref="l473">Sangallum</placeName>, ut illinc opera <lb xml:id="p1z35"/>ministri alicuius <placeName ref="l18">Augustam</placeName> per mercatores <lb xml:id="p1z36"/>deferantur.</s>
					<s n="9" xml:lang="la" ana="salute">Vivo cum meis satis commode, <lb xml:id="p1z37"/>gratia sit domino, qui te ac totam domum tuam ex <lb xml:id="p1z38"/>animo salutant.</s>
					<s n="10" xml:lang="la" ana="salute">Tu vive in domino felicissime et saluta <pb/><lb xml:id="p2z1"/>meo nomine d. <persName ref="p8127">Pellicanum</persName>, d. <persName ref="p8171">Bibliandrum</persName>, <lb xml:id="p2z2"/>d. <persName ref="p8011">Gvaltherum</persName>, <persName ref="p1214">Phrysium</persName> et reliquos.</s>
					<s n="11" xml:lang="de"><lb xml:id="p2z3"/><placeName ref="l41">Bernę</placeName> 1554. 11. novembris.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z4"/><persName ref="p8417">W[olfgangus] <lb xml:id="p2z7"/>Musculu<lb xml:id="p2z8"/>s</persName> com<lb xml:id="p2z10"/>pat<lb xml:id="p2z11"/>er i<lb xml:id="p2z12"/>n <lb xml:id="p2z13"/>domino.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z14"/>[<lb xml:id="p2z15"/>D<lb xml:id="p2z16"/>]oc<lb xml:id="p2z17"/>tiss<lb xml:id="p2z18"/>i<lb xml:id="p2z19"/>mo vi<lb xml:id="p2z20"/>ro m<lb xml:id="p2z23"/>. <lb xml:id="p2z28"/><persName ref="p495">H<lb xml:id="p2z29"/>einrycho <lb xml:id="p2z31"/>Bull<lb xml:id="p2z32"/>ingero</persName>, <lb xml:id="p2z33"/>compatri <lb xml:id="p2z34"/>suo in <lb xml:id="p2z35"/>domino cha<lb xml:id="p2z36"/>rissimo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z37"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
