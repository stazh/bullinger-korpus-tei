	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Heus tu, in quem angulum se proripuit que ̨stor aerarius<note type="margin">a.R.: <persName ref="p182">Gabr. Arnold</persName>?</note>: <lb xml:id="p1z2"/><placeName ref="l749">Saxoniam</placeName> petit, fortassis inserviturus est <persName ref="p18250">Mauritio</persName> quemadmodum et dominus <persName ref="p8034">de Hei<lb xml:id="p1z3"/>deck</persName>.</s>
					<s n="3" xml:lang="la">Quales homines hactenus in <placeName ref="l862">Helvetiis</placeName> habuimus, quibus hospitia <lb xml:id="p1z4"/>dedimus commoda ac defensionem cum nostrorum periculo?</s>
					<s n="4" xml:lang="la">Evangelium multos nebu<lb xml:id="p1z5"/>lones vestit pulchra specie.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quibus putas fidendum esse?</s>
					<s n="6" xml:lang="la">Quis non intelligit <lb xml:id="p1z6"/>practicas, quo nobis incommodet tale genus hominum?</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z7"/><placeName ref="l303">Magdeburgum</placeName> graviter esse obsessum a magna caterva militum ab omni <lb xml:id="p1z8"/>parte certissimum est, et expectant graviorem obsidionem.</s>
					<s n="8" xml:lang="la">Quis illos bonos vi<lb xml:id="p1z9"/>ros liberabit, deusne sua potenti manu an <placeName ref="l2510">Turca</placeName>, servus dei?</s>
					<s n="9" xml:lang="la">Et prodigia <lb xml:id="p1z10"/>quędam visa sunt in <placeName ref="l749">Saxonia</placeName>, puto/puta, quinque soles visi per tres <lb xml:id="p1z11"/>dies, noctu vero tres lunas.</s>
					<s n="10" xml:lang="la">Turca absque dubio dilatabit cornu suum <lb xml:id="p1z12"/>et lunam tandem claudet superveniente extremo die.</s>
					<s n="11" xml:lang="la">Et <persName ref="p2095">Philippus Melanchton</persName> <lb xml:id="p1z13"/>scripsit quędam de hoc prodigio.</s>
					<s n="12" xml:lang="la">Terrent me etiam multa, quę sentio.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z14"/>Bellum <placeName ref="l832">Gallicum</placeName> gliscit, nec poterimus nostros retinere in offitio; animi <lb xml:id="p1z15"/>illorum tumultuantur et aurum sitiunt; pauperes sunt ob convivia assidua <lb xml:id="p1z16"/>peracta et adhuc in singulos dies continuata, nihili curantes, qui pecuni<lb xml:id="p1z17"/>am contractam solvat.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Populus fere est sine deo, etsi contiones perpetuae <lb xml:id="p1z18"/>sonent; multi audiunt verbum dei, sed nihilominus meliores sunt, quod mirum <lb xml:id="p1z19"/>est apud me.</s>
					<s n="15" xml:lang="la">Durę cervicis est populus et digna plaga magna.</s>
					<s n="16" xml:lang="la">Orbis <lb xml:id="p1z20"/>christianus concutitur variis plagis et tenebris densissimis obruitur <lb xml:id="p1z21"/>et in singulos dies novis morbis et inauditis inficimur, annona <lb xml:id="p1z22"/>premimur, bulimia vexamur et ab omni parte impetimur, <lb xml:id="p1z23"/>sed nullam penitentiam agimus, imo peiores et deteriores efficimur, <lb xml:id="p1z24"/>o deum immortalem!</s>
					<s n="17" xml:lang="la" ana="farewell">Vale.</s>
					<s n="18" xml:lang="la"><placeName ref="l28">Basileę</placeName> 25. amii 1551.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z25"/><persName ref="p8112">Galliae regis</persName> legatus heri ad nos rediit; quidam aiunt onustum venisse <lb xml:id="p1z26"/>coronatis milites conducturus ad lanienamque rapturus.</s>
					<s n="20" xml:lang="la" ana="salute"><lb xml:id="p1z27"/>D. <lb xml:id="p1z29"/><persName ref="p8171">Theodorum</persName> meo nomine salutabis <lb xml:id="p1z30"/>cum uxore <lb xml:id="p1z31"/>tua charissima.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">T[uus] <persName ref="p1278">Gastius</persName> ex animo.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Integerrimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z4"/>pastori vigilantissimo, <lb xml:id="p2z5"/>ad manus.</s>
				</p>
				<p>
					<s n="23" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
