	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nolui, ut hic nuncius tam oportunus sine meis literis ad <lb xml:id="p1z2"/>vos rediret, etsi nihil sit, quo te oblectare queam.</s>
					<s n="3" xml:lang="la"><placeName ref="l830">Angliam</placeName> nostram <lb xml:id="p1z3"/>misere scissam esse significatum est et obtinuisse Mariam artibus <lb xml:id="p1z4"/>rerumque potiri repulsa altera, quam reginam voluissent cordatiores.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Quare nihil expectatur quam calamitosa ecclesiae puraeque religionis <lb xml:id="p1z6"/>subversio multiplicesque clades, nisi ceu a machina ferat auxilium <lb xml:id="p1z7"/>misericorditer dominus, quem par est nos omnes precibus assiduis interpellare <lb xml:id="p1z8"/>et, ceu in eodem versantes corpore, afflictissimis indubie fratribus <lb xml:id="p1z9"/>compati.</s>
					<s n="5" xml:lang="la">Porro mox te certa illinc habiturum esse coniiciam; quaeso <lb xml:id="p1z10"/>etiam nobis communicare digneris, maxime vero, si faustiora acceperis, <lb xml:id="p1z11"/>ut consolatione eatenus reficiamur.</s>
					<s n="6" xml:lang="la"><persName ref="p18509">Augustum</persName>, <persName ref="p18250">Mauricii</persName> fratrem, <lb xml:id="p1z12"/>mortuum ferunt aliosque duos <persName ref="p20318">Heinrichi Brunsvicensis</persName> filios, <lb xml:id="p1z13"/>qui pugnae non interfuerant, ut senx orbus et delirus tantum <lb xml:id="p1z14"/>non in furias agatur.</s>
					<s n="7" xml:lang="la"><placeName ref="l361">Norimbergae</placeName> agitantur principum aliquot <lb xml:id="p1z15"/>et urbium comicia, de quibus tanto sperarim boni aliquid facilius, <lb xml:id="p1z16"/>quod ad eadem accersitus <persName ref="p8034">Heideckerus</persName> sit, quem fama prima <lb xml:id="p1z17"/>extinctum tulerat, vir mirando consilio praeditus et singulari ani<lb xml:id="p1z18"/>mi cum magnitudine tum pietate, cuiusque autoritas plurimum ponderis <lb xml:id="p1z19"/>apud ordines imperii habere dicitur.</s>
					<s n="8" xml:lang="la"><persName ref="p8282">Maximilianus</persName> <persName ref="p18477">Ferdinandi</persName>, <lb xml:id="p1z20"/>regem nunc <placeName ref="l2449">Boaemiae</placeName>, locum evangelio Christi fecisse d. <persName ref="p4326">Bartolo<lb xml:id="p1z21"/>meus Blaurerus</persName> constanter affirmat, sed vereor, ne relata <lb xml:id="p1z22"/>potius quam certo explorata significet.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><persName ref="p8616">Albertus</persName> 30 vexilla <lb xml:id="p1z23"/>peditum habere dicitur et 4000 equitum instructumque pecuniis partim ab imperatore, <lb xml:id="p1z24"/>partim a matre <persName ref="p18716">Erici Brunsvicensis</persName> et iam a <placeName ref="l61">Bremensibus</placeName> tormenta <lb xml:id="p1z25"/>bellica postulare, quod promittat se <persName ref="p20318">Heinrichum Brunsvicensem</persName>, hostem <lb xml:id="p1z26"/>avitum, extincturum penitus.</s>
					<s n="10" xml:lang="la">Verum quid impetrarit, nondum narratur.</s>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z27"/>Sed bene vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l28">Basileae</placeName> 16. augusti anno 1553.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z28"/>T[uus] <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Sa<lb xml:id="p1z29"/>luta meis verbis <lb xml:id="p1z30"/>fratres omnes.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>domino et fratri suo <lb xml:id="p2z4"/>observandissimo.</s>
				</p>
			</div>
		</body>
	</text>
