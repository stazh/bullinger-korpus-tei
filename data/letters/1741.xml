	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Nihil nunc quod scribam habeo iisi
					<lb xml:id="p1z2"/>bona fide me accepisse, quae misisti
					<lb xml:id="p1z3"/>per Fabricium vetum. Gratias ago tuae
					<lb xml:id="p1z4"/>humanitati pro descriptione diligenti
					<lb xml:id="p1z5"/>Introitus Caesar in Argentin. Si plura de
					<lb xml:id="p1z6"/>hisce turbulentis acceperis ac
					<lb xml:id="p1z7"/>scripseris rem feceris gratissimam
					<lb xml:id="p1z8"/>Apud nos omnia deo gratia sunt tranguilla
					<lb xml:id="p1z9"/>quod ad 2 huius mensis comiti
					<lb xml:id="p1z10"/>Badenam sunt conscripta. Expectamus
					<lb xml:id="p1z11"/>quid futurum sit. Dominus servet no
					<lb xml:id="p1z12"/>pace et oppressos bello relevet.
					<lb xml:id="p1z13"/>etliberet. Valemus hic alioqui si
					<lb xml:id="p1z14"/>satis recte. Orate pro nobis. Sabi
					<lb xml:id="p1z15"/>sint Rhegius Ulstetterus et reliqui
					<lb xml:id="p1z16"/>viri boni.
					<lb xml:id="p1z17"/>Valete in Christo omnes
					<lb xml:id="p1z18"/>Tiguri, 1. octobris anno 1552.
					<lb xml:id="p1z19"/>Tuus ille t.
					<pb/>
					<lb xml:id="p2z1"/>Praestantissimo viro d.
					<lb xml:id="p2z2"/>Matthiae Erbio
					<lb xml:id="p2z3"/>chevillensis ecclesiae
					<lb xml:id="p2z4"/>fido pastori, domino
					<lb xml:id="p2z5"/>et fratri suo colendio
					<lb xml:id="p2z6"/>
					<lb xml:id="p2z7"/>rychenwyle.
				</p>
			</div>
		</body>
	</text>
