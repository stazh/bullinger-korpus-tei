			<div>
				<p>
					<lb xml:id="p1z1"/>servet te dominus, obs pater adhuc
					<lb xml:id="p1z2"/>annos aliquit suae ecclesiae. Gratissima
					<lb xml:id="p1z3"/>mihi fuerunt literae, quibus de tot
					<lb xml:id="p1z4"/>rebus novis, ad me scripsist accisse e
					<lb xml:id="p1z5"/>Tu haec cettissa popt expugnatum ab
					<lb xml:id="p1z6"/>noprili Arlemium noptri occupavut, priu
					<lb xml:id="p1z7"/>um munitissimam et sit natura inex
					<lb xml:id="p1z8"/>pugnabilem artim quam Namerdinum vo,
					<lb xml:id="p1z9"/>in Zeledita non procul a menotisti
					<lb xml:id="p1z10"/>d Chertrndbergen, quae ab Andversia non
					<lb xml:id="p1z11"/>silitet.
					<lb xml:id="p1z12"/>sepiat, nisi   millioribus. Albanus
					<lb xml:id="p1z13"/>solvet obsidione novam in obindia, ut
					<lb xml:id="p1z14"/>nemum enim non teneo in pręsentia et
					<lb xml:id="p1z15"/>una tamen filer et aaedila creli venit
					<lb xml:id="p1z16"/>Antversiam, deliberatum, quid focto q
					<lb xml:id="p1z17"/>sitSuspectum enim salet Antversoiensem se
					<lb xml:id="p1z18"/>nodum.Viena eccesi leteras
					<lb xml:id="p1z19"/>ii Cęsar impedivisset coiurat non
					<lb xml:id="p1z20"/>Inturum, ut mense Augusto oppremo
					<lb xml:id="p1z21"/>enter fidelet, qui in cuusdam
					<lb xml:id="p1z22"/>nobilis aedibus, audiende contionis causa
					<lb xml:id="p1z23"/>cillecti eta. Confirmat haec fint proe
					<lb xml:id="p1z24"/>frater habbet verbi minister, qui
					<pb/>
					<lb xml:id="p2z1"/>compipit e prasae erapi tu i ser
					<lb xml:id="p2z2"/>sedde
					<lb xml:id="p2z3"/>multis viena eo venientibus haec accipe
					<lb xml:id="p2z4"/>piebat. Cogita tum dice, quid lateat in
					<lb xml:id="p2z5"/>nei sepieum, quius consiliorum cectum set
					<lb xml:id="p2z6"/>frimae. Coesit quidam Gallix, sed sliu
					<lb xml:id="p2z7"/>est, tui pripinatu sit sic consilium
					<lb xml:id="p2z8"/>Interim. Dominus dessesabet consilet
					<lb xml:id="p2z9"/>sentium. Audimus vero, regem
					<lb xml:id="p2z10"/>Poloniae, non deserturum pro hoc tepei
					<lb xml:id="p2z11"/>et .
					<lb xml:id="p2z12"/>Halligeru magira iebintut hptea
					<lb xml:id="p2z13"/>vestri vermieunt in utramque aurem.
					<lb xml:id="p2z14"/>sed vegelat dominus supet isptaetem.
					<lb xml:id="p2z15"/>1.
					<lb xml:id="p2z16"/>valemu. hic bone dominus ese vi
					<lb xml:id="p2z17"/>servet.Heid 7 septemusu
					<lb xml:id="p2z18"/>rou erasasi igr et
					<lb xml:id="p2z19"/>Tui exex
					<lb xml:id="p2z20"/>M.
					<lb xml:id="p2z21"/>is qui erpunias ri
					<lb xml:id="p2z22"/>e vr pum. neri.
					<lb xml:id="p2z23"/>HTarzinus.
					<lb xml:id="p2z24"/>.
					<lb xml:id="p2z25"/>e uo e ulim
					<lb xml:id="p2z26"/>Adent.
					<lb xml:id="p2z27"/>us.
					<pb/>
					<lb xml:id="p4z1"/>et su vero.
					<lb xml:id="p4z2"/>d. H. Bullingero,
					<lb xml:id="p4z3"/>erititeu, patri
					<lb xml:id="p4z4"/><placeName ref="l587">Tigurum</placeName>.
				</p>
