	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Literae tuae de isto Interim Sathanico me magno <lb xml:id="p1z2"/>dolore affecerunt, qui dolor novis et rumoribus et <lb xml:id="p1z3"/>nunciis in dies mihi accrevit, neque opportunius ad <lb xml:id="p1z4"/>haec tanta, quae impendere cervicibus nostris mala <lb xml:id="p1z5"/>videmus, remedium novi quam veram et seriam poenitentiam <lb xml:id="p1z6"/>et preces non frigidas aut fictas, sed <lb xml:id="p1z7"/>ferventissimas et verissimas ad dei clementiam implorandam.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z8"/>Et ipse, ut clementissimus est, suorum ne<lb xml:id="p1z9"/>quaquam gemitus et lachrymas co(n)temnet, sed in hostem <lb xml:id="p1z10"/>nostrum eundemque suum omnia, quae nobis mala minatur, <lb xml:id="p1z11"/>convertet, quod quidem te, mi <persName ref="p495">Bullingere</persName>, et facere <lb xml:id="p1z12"/>et pro tuo munere ad id faciendum <lb xml:id="p1z13"/>adhortari, non dubito, sed haec, ut me ipsum accendam, <lb xml:id="p1z14"/>ad te scribo; nam quid aliud hoc tempore scriberem?</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z15"/>Sed mittamus haec.</s>
					<s n="5" xml:lang="la"><persName ref="p2019">Augustinus Maynardus</persName>, vir non <lb xml:id="p1z16"/>solum doctus, sed etiam sanctus, redit iam ad vos, ut <lb xml:id="p1z17"/>eius doctrinam ecclesiae suae vestra autoritate et <lb xml:id="p1z18"/>testimonio commendetis.</s>
					<s n="6" xml:lang="la">Nam <placeName ref="l28">Basilienses</placeName>, ut videbis <lb xml:id="p1z19"/>subscripserunt, vosque idem facturos non dubito.</s>
					<s n="7" xml:lang="la">Sed tamen <lb xml:id="p1z20"/>sanctum hunc senem et mihi iam ante multos annos non <lb xml:id="p1z21"/>cognitum modo, sed etiam amicum, fratrem et in domino <lb xml:id="p1z22"/>patrem meumque gentilem tibi commendo, qui ista ętate <lb xml:id="p1z23"/>hosce labores pro ecclesiae suae incolumitate et concordia <lb xml:id="p1z24"/>sustinere non dubitet.</s>
					<s n="8" xml:lang="la">Unum est, quod te <lb xml:id="p1z25"/>latere nolui, ne forte mireris, si in eius confessione <lb xml:id="p1z26"/>unum atque alterum verbum repereris, quod in ea, quam <lb xml:id="p1z27"/>apud vos reliquit, non reperiatur; nam; dum una illam <lb xml:id="p1z28"/>legeremus, autor ei fui, ut illa adderet verba: <lb xml:id="p1z29"/>"non autem ad gratiam dei sive remissionem peccatorum conferendam" <lb xml:id="p1z30"/>etc. idque, ubi de sacramentis agit generatim.</s>
					<s n="9" xml:lang="la">Quod <lb xml:id="p1z31"/>idcirco feci, ut ea quasi antithesi contrarium sentientes ex<lb xml:id="p1z32"/>cluderet.</s>
					<s n="10" xml:lang="la">Sed haec ipse melius tibi narrabit.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Vale et <lb xml:id="p1z33"/>deum pro nobis ora et familiam tuam sanctam fratresque <lb xml:id="p1z34"/>omnes meo nomine saluta.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l28">Basileae</placeName> 17. iunii <lb xml:id="p1z35"/>1548.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><persName ref="p714">Coelius</persName> ex animo tuus scripsit.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Sanctissimo et clarissimo viro <lb xml:id="p2z2"/>D. <persName ref="p495">Heynricho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>antistiti vigilantissimo, <lb xml:id="p2z5"/>fratri in domino observandissimo <lb xml:id="p2z6"/>suo.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
