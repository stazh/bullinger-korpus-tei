	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>diuturnum illam gegrotationem meam exceperunt molestissimum
					<lb xml:id="p1z2"/>occupationes tibi ut excusatus esse debeam, di nihil interea de preserim
					<lb xml:id="p1z3"/>nunc offert de quidem amplissimo argumentem. Ita Varia
					<lb xml:id="p1z4"/>Italia tuum in Germania maxime in spem gravioris belli cudentur
					<lb xml:id="p1z5"/>de actum agere molo neque danctioribus studiis tuis nostris hi
					<lb xml:id="p1z6"/>alegatione teicis obstrepere. Ebi itaque, ut est a Vergerio nostro scripti
					<lb xml:id="p1z7"/>quasdam ad eum literas millendas duxi, ut commondo tuo perfere
					<lb xml:id="p1z8"/>cures me quacunique in re potero habebis semper obsequentissimu. Val
					<lb xml:id="p1z9"/>Curite 4 idominus octibris
					<lb xml:id="p1z10"/>. ep.ur.
					<pb/>
					<lb xml:id="p2z1"/>Doctissimo viro domino Bulingero,
					<lb xml:id="p2z2"/>aiieo charissimo.
					<lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.
				</p>
			</div>
		</body>
	</text>
