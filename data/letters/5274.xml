	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Sum in <placeName>Genins</placeName> cum domino consule et fratre <lb xml:id="p1z3"/><persName>Philippo</persName> ideoque mihi, reverende in Christo pater, <lb xml:id="p1z4"/>ignoscas velim, si sum scribendo brevior; <lb xml:id="p1z5"/>nam domi quidem scripsi, cum mihi tuae nondum <lb xml:id="p1z6"/>essent redditae, illas vero nunc mittere nequeo, <lb xml:id="p1z7"/>quod praeter opinionem mihi hic sit haerendum hodie.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z8"/>Saltem tibi significare volui mihi tua omnia <lb xml:id="p1z9"/>bona fide reddita.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Scriptum de concilio prima <lb xml:id="p1z10"/>quaque occasione exscribam et cum tabellario <persName>Knöullio</persName> <lb xml:id="p1z11"/>remittam.</s>
					<s n="5" xml:lang="la">Interea scribitur ex <placeName ref="l834">Italia</placeName> rumorem <lb xml:id="p1z12"/>de pontificis morbo et quod vicinus sit morti, <lb xml:id="p1z13"/>esse adhuc constantem.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Consul mihi dixit, quod <persName>Emsensis</persName> <lb xml:id="p1z14"/>ex concilio <placeName ref="l425">Romam</placeName> magnis itineribus citato cursu <lb xml:id="p1z15"/>contenderit, ut invisat avunculum.</s>
					<s n="7" xml:lang="la">Haec habeo, non plura.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Tu, quaeso, de rebus <placeName ref="l832">Gallicis</placeName> nos edoce, et an <persName>Philippus</persName>, <lb xml:id="p1z17"/>landtgravius iunior, illuc penetrarit, quo loco res <lb xml:id="p1z18"/>sint ecclesię, quid moliantur <persName>Guisiani</persName> et quem apud <lb xml:id="p1z19"/>regem locum obtineant.</s>
					<s n="9" xml:lang="la">Ignosce mihi, quod tanta <lb xml:id="p1z20"/>et tot simul audeo a te petere, quod tamen nunquam <lb xml:id="p1z21"/>facerem, nisi sperarem me pro tua humanitate <lb xml:id="p1z22"/>impetrare posse.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale, reverende pater.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Salutem <lb xml:id="p1z23"/>me tibi ascribere iusserunt d. d. consul, <persName ref="p1770">G[regorius] Carlin</persName>, <lb xml:id="p1z24"/>d. <persName>Philippus</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Haec in <placeName>Genins</placeName> in aedibus <persName ref="p1770">Carlinis</persName> <lb xml:id="p1z25"/>festinanter 13. aprilis anno 1562.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z26"/>Quaeso te rogoque significare digneris d. <lb xml:id="p1z27"/><persName ref="p4554">Rodolpho Collino</persName> socero suas mihi redditas <lb xml:id="p1z28"/>et rem mihi omnino curae fore.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Eodem <lb xml:id="p1z29"/>fere momento, quo mihi vestrae reddebantur, <lb xml:id="p1z30"/>cum causam affinis consuli ante mandarem et <lb xml:id="p1z31"/>simul <placeName ref="l399">Pesclavium</placeName> scripsissem, mihi equus <lb xml:id="p1z32"/>fuit conscendendus; ideo rescribere ei non potui.</s>
					<s n="15" xml:lang="la">T[uus] <lb xml:id="p1z33"/><persName ref="p8009">Fab[ricius</persName>].</s>
				</p>
				<p>
					<s n="16" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem eerwyrdigen, hochge<lb xml:id="p2z2"/>lerten, frommen und ge<lb xml:id="p2z3"/>trüwen herren herren <lb xml:id="p2z4"/><persName ref="p495">Heinrych Bullingern</persName>, <lb xml:id="p2z5"/>vorstender der kilchen <lb xml:id="p2z6"/><placeName ref="l587">Zurich</placeName>, synem eerenden <lb xml:id="p2z7"/>herren, ze ant<lb xml:id="p2z8"/>worten.</s>
				</p>
			</div>
		</body>
	</text>
