	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Gratum tibi fuisse, reverende et mihi <lb xml:id="p1z2"/>summa observantia colende domine, quod ad <lb xml:id="p1z3"/>te miserim et librum principum <placeName ref="l749">Saxonię</placeName> et de <lb xml:id="p1z4"/>eo illustrissimi principis nostri atque d. <persName ref="p2095">Philippi <lb xml:id="p1z5"/>Melanchthonis</persName> iudicium, equidem vehementer <lb xml:id="p1z6"/>gaudeo.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Licet sane ex libro illo cognoscere <lb xml:id="p1z7"/>fontem omnis mali et offendiculorum, quę <lb xml:id="p1z8"/>ex colloquio <placeName ref="l569">Vormatiensi</placeName> emanarunt.</s>
					<s n="4" xml:lang="la">Pro <lb xml:id="p1z9"/>libris autem vicissim ad me missis, Catechesi <lb xml:id="p1z10"/>nempe et 44 concionibus in Ieremiam <lb xml:id="p1z11"/>prophetam gratias habeo atque eo maiores, <lb xml:id="p1z12"/>quod ex tua officina admodum fęcunda <lb xml:id="p1z13"/>excultissimaque prodierint.</s>
					<s n="5" xml:lang="la">Apud nos eiusmodi <lb xml:id="p1z14"/>fruges minime nascuntur; haud scio, <lb xml:id="p1z15"/>an solum et cęlum culpare debeam, magis <lb xml:id="p1z16"/>certe crediderim accusandam nostram tum <lb xml:id="p1z17"/>ignorantiam tum segnitiem.</s>
					<s n="6" xml:lang="la">Qualenam <lb xml:id="p1z18"/>sit iudicium principis <placeName ref="l749">Saxonię</placeName> de tuo libro, <lb xml:id="p1z19"/>rescire nondum potui, spero tamen me <lb xml:id="p1z20"/>propediem auditurum aut ex illustrissimo <lb xml:id="p1z21"/>principe Philippo aut ex filio eius natu <lb xml:id="p1z22"/>maximo Gulielmo.</s>
					<s n="7" xml:lang="la">Nam aula tota huc <lb xml:id="p1z23"/>commigrat, dum arcis <placeName ref="l244">Cassellanę</placeName> pars quędam <lb xml:id="p1z24"/>diruitur atque ab ipsis fundamentis instauratur.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z25"/>Faciam te eius, quod intellexero, <lb xml:id="p1z26"/>certiorem.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Spero insuper paulo postquam <pb/><lb xml:id="p2z1"/>illustrissimi principes huc advenerint, audire <lb xml:id="p2z2"/>aliquid de scholę nostrę emendatione.</s>
					<s n="10" xml:lang="la">Quodsi conatus <lb xml:id="p2z3"/>meos omnes impediri animadvertero et <lb xml:id="p2z4"/>nihil aut parum in schola corrigetur, tum <lb xml:id="p2z5"/>rursus cogitabo alio.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Maxime habebam in <lb xml:id="p2z6"/>votis migrare <placeName ref="l280">Lausannam</placeName>, tum ut vobis <lb xml:id="p2z7"/>essem vicinior, tum alias ob causas plures.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z8"/>Sed princeps illustrissimus me est remoratus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z9"/>Illud autem didici, si occasio similis iterum <lb xml:id="p2z10"/>obtigerit, rem neque esse ad illustrissimum <lb xml:id="p2z11"/>principem deferendum.</s>
					<s n="14" xml:lang="la">Versor hic omnium <lb xml:id="p2z12"/>prope gravatus odiis et invidia, nec dici <lb xml:id="p2z13"/>potest, quibus artibus nonnulli mihi perpetuo <lb xml:id="p2z14"/>facessant negotium, cunque omnia videam <lb xml:id="p2z15"/>tendere inprimis ad impediendum sacrorum <lb xml:id="p2z16"/>studiorum cursum, supra, quam quisquam <lb xml:id="p2z17"/>credat, doleo angorque.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Sed forte alias de <lb xml:id="p2z18"/>hac re plura.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z19"/>Iam de filio tuo <persName ref="p477">Ioanne <lb xml:id="p2z20"/>Rodolpho</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Venit ad me annos 20 annos <lb xml:id="p2z21"/>circiter, ut ipse mihi narrat, natus; quid <lb xml:id="p2z22"/>igitur potui ad eam progresso ętatem pręstare?</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z23"/>Frequenter fassus est se <placeName ref="l491">Argentorati</placeName> fuisse <lb xml:id="p2z24"/>neglectum et sibi dolere impense, quod non <lb xml:id="p2z25"/>citius ad me venerit.</s>
					<s n="19" xml:lang="la">Ego neque privatim <lb xml:id="p2z26"/>quędam enarrando neque hortando, incitando <lb xml:id="p2z27"/>aliisque id genus officiis ei defui, atque ipse <lb xml:id="p2z28"/>me etiam asperius obiurgantem benigne <lb xml:id="p2z29"/>aud<pb/><lb xml:id="p3z2"/>ivit, moribus alioqui non insuavibus <lb xml:id="p3z3"/>atque ingenio tractabili.</s>
					<s n="20" xml:lang="la">Quantos autem <lb xml:id="p3z4"/>in literis progressus fecerit, ipse, <lb xml:id="p3z5"/>qui falli hac in parte minime potes, iudicium <lb xml:id="p3z6"/>facias.</s>
					<s n="21" xml:lang="la">Mihi profecto bene conscius sum <lb xml:id="p3z7"/>adhibitę a me diligentię.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Porro sumptuum <lb xml:id="p3z8"/>hic factorum ac debitorum eius, <lb xml:id="p3z9"/>de quibus explorare aliquid potui, rationem <lb xml:id="p3z10"/>ex charta, quam appositam vides, licebit <lb xml:id="p3z11"/>cognoscere.</s>
					<s n="23" xml:lang="la">Quid item de adolescentibus <lb xml:id="p3z12"/>studiosis sentiam, paucis expono nihil <lb xml:id="p3z13"/>dubitans, quin cęteri quoque professores <lb xml:id="p3z14"/>ac, nisi fallor, in eandem prorsus sententiam <lb xml:id="p3z15"/>paria faciant.</s>
					<s n="24" xml:lang="la" ana="salute">Uxor mea te <lb xml:id="p3z16"/>totanque familiam saluta ac lęta precatur.</s>
				</p>
				<p>
					<s n="25" xml:lang="la" ana="salute"><lb xml:id="p3z17"/>Salutem peto meo nomine dici clarissimis <lb xml:id="p3z18"/>viris d. <persName ref="p8111">Petro Martyri</persName>, <persName ref="p8171">Bibliandro</persName>, <lb xml:id="p3z19"/><persName ref="p8011">Rodolpho Gvalthero</persName>, <persName ref="p1884">Lavatero</persName>, <lb xml:id="p3z20"/><persName ref="p8442">Simlero</persName> et cęteris.</s>
				</p>
				<p>
					<s n="26" xml:lang="la" ana="farewell">Vale.</s>
					<s n="27" xml:lang="de"><lb xml:id="p3z21"/>25. septembris 1559.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p3z22"/><persName ref="p8386">Andreas Hyperius</persName>, <lb xml:id="p3z23"/>tuus quantus est.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo pietate atque doctrina <lb xml:id="p4z2"/>viro d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p4z3"/>ecclesię <placeName ref="l587">Tigurinę</placeName> antistiti <lb xml:id="p4z4"/>dignissimo, domino summa <lb xml:id="p4z5"/>observantia colendo.</s>
					<s n="30" xml:lang="la"><lb xml:id="p4z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
