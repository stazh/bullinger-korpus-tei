	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Scripsi nuper ad te <placeName ref="l167">Geneva</placeName>, mi pater, et libellum <lb xml:id="p1z3"/>nostrum ad te misi, quem opinor tibi esse redditum.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Ex eo nihil hic accidit, de quo magnopere <lb xml:id="p1z5"/>tibi scribam, nisi hoc fortassis, quod te audisse <lb xml:id="p1z6"/>opinor, duchissam <placeName ref="l150">Ferrariensem</placeName> aperte et <lb xml:id="p1z7"/>constanter Christum professam esse in carcerem <lb xml:id="p1z8"/>coniectam marito.</s>
					<s n="4" xml:lang="la">Rarum et insigne est <lb xml:id="p1z9"/>hoc exemplum in principe omnium, quae hodie <lb xml:id="p1z10"/>vivunt, ut ego quidem existimo, <foreign xml:lang="el">εὐγενεστάτ<lb xml:id="p1z11"/>η</foreign>.</s>
					<s n="5" xml:lang="la">Rogemus ergo dominum, ut, quod coepit, <lb xml:id="p1z12"/>in ea perficiat.</s>
					<s n="6" xml:lang="la">Caeterum, qui tibi <lb xml:id="p1z13"/>has literas reddit, plane noster est, homo <lb xml:id="p1z14"/>et genere et opibus olim potens, nunc dei grati<lb xml:id="p1z15"/>a <lb xml:id="p1z16"/>fidelis dei servus, cuius pietate <lb xml:id="p1z17"/>et consuetudine multum hic delector.</s>
					<s n="7" xml:lang="la">Is igitur <lb xml:id="p1z18"/>tecum de quibusdam negociis aget, minime <lb xml:id="p1z19"/>levibus quidem illis, sed quae ad gloriam <lb xml:id="p1z20"/>dei magnopere pertinent.</s>
					<s n="8" xml:lang="la">Itaque non dubito, <lb xml:id="p1z21"/>quin, si qua in re poteris ea promovere, <lb xml:id="p1z22"/>libenter id sis facturus, atque id ut <lb xml:id="p1z23"/>facias, etiam atque etiam a te peto.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z24"/>De rebus nostris: nostri omnes satis recte <lb xml:id="p1z25"/>dei beneficio.</s>
					<s n="10" xml:lang="la">D. <persName ref="p3429">Viretus</persName> noster, quum <lb xml:id="p1z26"/>haec scriberem, <placeName ref="l167">Genevam</placeName> erat profectus.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z27"/><persName>Samuel</persName> quoque noster, quem mihi commendasti, <lb xml:id="p1z28"/>satis recte.</s>
					<s n="12" xml:lang="la">Det mihi dominus, ut <lb xml:id="p1z29"/>eius studia possim promovere, illi vero, <lb xml:id="p1z30"/>ut tuam et caeterorum expectationem ne <lb xml:id="p1z31"/>fallat.</s>
					<s n="13" xml:lang="la" ana="farewell">Bene vale, mi pater, cum tota <lb xml:id="p1z32"/>tua familia.</s>
					<s n="14" xml:lang="la">D. Iesus te tueatur <lb xml:id="p1z33"/>et <lb xml:id="p1z34"/>conservet.</s>
					<s n="15" xml:lang="la">D. <persName ref="p8011">Gvalter[um</persName> <lb xml:id="p1z35"/>et caet]eros fratres, <lb xml:id="p1z36"/>obsecro, ut ex me <lb xml:id="p1z37"/>s[alutes et v<lb xml:id="p1z38"/>estra<pb/><lb xml:id="p2z1"/>e nos preci]bus ecclesiae commendes.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z2"/>Iterum [vale...] octobris...</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="17" xml:lang="la"><lb xml:id="p2z3"/>Eximio servo dei d. <persName ref="p495">Henrico Bu<lb xml:id="p2z4"/>llingero</persName>, fidelissimo <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z5"/>ecclesiae pastori et <lb xml:id="p2z6"/>patri mihi observandissimo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
