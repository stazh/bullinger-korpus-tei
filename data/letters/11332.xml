	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Aut non legi aut non observavi, <persName ref="p495">Bullingere</persName> <lb xml:id="p1z2"/>suavissime, eum locum, ubi <persName ref="p1974">Lutherus</persName> <persName ref="p4091">Zvinglium</persName> <lb xml:id="p1z3"/>perstringit<note xml:id="fn1" type="footnote" n="1">Gemeint ist eine Stelle in <persName ref="p1974">Luthers</persName> Schrift "Von den Konziliis und Kirchen" (<bibl source="b671">WA</bibl> L 488-653; vgl. oben <ref target="file11329">Nr. 1286</ref>, 10f), an der <persName ref="p4091">Zwingli</persName> in die Nähe der Nestorianer gerückt wird (aaO, S. 591, 9-14).</note>.</s>
					<s n="3" xml:lang="la">Caeterum cavendum est forte, <lb xml:id="p1z4"/>ne quid in illum retorqueatur.</s>
					<s n="4" xml:lang="la">Excusan<lb xml:id="p1z5"/>dus tamen esset praeceptor a discipulo amicis <lb xml:id="p1z6"/>literis erga <persName ref="p1974">Lutherum</persName>, non solum propter excusationem, <lb xml:id="p1z7"/>sed ut audires, quid ille contra <lb xml:id="p1z8"/>aut quo animo in vos etc.<pb type="edition" next="180"/></s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Quod vestri conventum negaverunt<note xml:id="fn2" type="footnote" n="2">Wahrscheinlich ist das geplante Religionsgespräch in <placeName ref="l361">Nürnberg</placeName> gemeint (vgl. oben <ref target="file11304">Nr. 1261</ref>, Anm. 6). Ein formeller Ablehnungsbeschluß ist zwar nicht bekannt, vgl. aber die Gutachten eines Unbekannten und <persName ref="p495">Bullingers</persName> in Zürich StA, E II 347, 190-203.</note>, libenter <lb xml:id="p1z10"/>audimus; sic enim se res habet, quemadmodum <lb xml:id="p1z11"/>scribis<note xml:id="fn3" type="footnote" n="3"><persName ref="p495">Bullingers</persName> Brief ist nicht erhalten.</note>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/><persName ref="p8055">Ambrosius</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p8055">Ambrosius Blarer</persName>; vgl. oben <ref target="file11329">Nr. 1286</ref>, 2f.</note> de instituenda domo dei apud <lb xml:id="p1z13"/><placeName ref="l18">Augustanos</placeName> nec sperat aliquid nec desperat <lb xml:id="p1z14"/>etiamnum.</s>
					<s n="7" xml:lang="la">In neutram partem satis habet <lb xml:id="p1z15"/>coniecturarum; preces autem ad dominum extorquet <lb xml:id="p1z16"/>a nobis omnibus, quibus iuvetur in conatibus <lb xml:id="p1z17"/>suis.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z18"/>Tu de epistola <persName ref="p8049">Vadiani</persName> de glorificatione Christi<note xml:id="fn5" type="footnote" n="5">Vgl. oben <ref target="file11325">Nr. 1282</ref>, 22-24.</note> <lb xml:id="p1z19"/>nichil rescripsisti, cum ipsius iussu ad me <lb xml:id="p1z20"/>dare illam possis et debeas; nam sic impetravi.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z22"/>Nec de adolescente<note xml:id="fn6" type="footnote" n="6">Vgl. oben <ref target="file11329">Nr. 1286</ref>, 14-18.</note> quicquam addidisti, <lb xml:id="p1z23"/>quanquam non mittendo, sed describendo.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z24"/>Quid <persName ref="p4225">Michael</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p4225">Michael Back</persName>(?); vgl. oben <ref target="file11263">Nr. 1220</ref>, 121 mit Anm. 9.</note> ad me ex <placeName ref="l546">Wienna</placeName><note xml:id="fn8" type="footnote" n="8">Der Brief aus <placeName ref="l546">Wien</placeName> ist nicht erhalten.</note>, dicet <lb xml:id="p1z25"/><persName ref="p1753">Leo</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p1753">Leo Jud</persName>.</note>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Tu vale.</s>
					<s n="12" xml:lang="de">22. iulii 1539.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z26"/>Totam familiam tuam salvam volo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Tuus <lb xml:id="p1z27"/><persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tigurinae</placeName> ecclesię <lb xml:id="p2z3"/>pastori vigilantissimo, <lb xml:id="p2z4"/>fratri et domino unice <lb xml:id="p2z5"/>deamando.</s>
				</p>
			</div>
		</body>
