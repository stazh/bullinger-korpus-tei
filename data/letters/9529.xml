	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>iff goffer morgen, kam dem herren
					<lb xml:id="p1z2"/>adn bagett, als oe aber sestter na
					<lb xml:id="p1z3"/>am iis vershitten wellt, da wott
					<lb xml:id="p1z4"/>mis der fer statt sche iber herseckre
					<lb xml:id="p1z5"/>agester Astsye ud ander her nit
					<lb xml:id="p1z6"/>rotten lassen sunder unnstw
					<lb xml:id="p1z7"/>von Hhrunncken nite iner ihan
					<lb xml:id="p1z8"/>de ward serel der kulich
					<lb xml:id="p1z9"/>sitt dem hereen selbs geschriben
					<lb xml:id="p1z10"/>den far mitirmern wor
					<lb xml:id="p1z11"/>schlagen und es solhs zyefangen.
					<lb xml:id="p1z12"/>es, war so helff zn
					<lb xml:id="p1z13"/>Gotte das ab ich ech dals einem
					<lb xml:id="p1z14"/>lieben heren und je ier weben.
					<lb xml:id="p1z15"/>frund nitt künden se
					<lb xml:id="p1z16"/>sewen ist has war, o werdes is
					<lb xml:id="p1z17"/>s nun me buch wüsse.
					<lb xml:id="p1z18"/>der truw sywi eey halte, d i
					<lb xml:id="p1z19"/>allo glebigen in sinem dirnn
					<lb xml:id="p1z20"/>in M.
					<lb xml:id="p1z21"/>Et  farnd
					<lb xml:id="p1z22"/>
					<lb xml:id="p1z23"/>.
					<lb xml:id="p1z24"/>Jott.
					<lb xml:id="p1z25"/>ts.
					<lb xml:id="p1z26"/>Es.
					<pb/>
					<lb xml:id="p2z1"/>d jer Bullinger.
				</p>
			</div>
		</body>
