	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D. et se commendat.</s>
					<s n="2" xml:lang="la">Habes, quem tantopere a me <lb xml:id="p1z2"/>petiisti, libellum, clarissime et michi charissime <persName ref="p495">Bullingere</persName>.</s>
					<s n="3" xml:lang="la">Tardus <lb xml:id="p1z3"/>ad me <placeName ref="l907">Campidona</placeName> rediit, tum tardi sese offerunt nuntii certi et <lb xml:id="p1z4"/>fideles: alioqui pridem accepisses.</s>
					<s n="4" xml:lang="la">Westphalicum illud iudicium, per <lb xml:id="p1z5"/>omnem <placeName ref="l822">Germaniam</placeName> et <placeName ref="l2507">Westphaliam</placeName> ipsam abolitum et obliteratum, <lb xml:id="p1z6"/>instaurare nobis adeoque postliminio restituere carnalibus ac cruentis <lb xml:id="p1z7"/>suis scriptis visus est nobis velle <persName ref="p7024">Westphalus</persName> ille.</s>
					<s n="5" xml:lang="la">Nam importuni quidam <lb xml:id="p1z8"/>stentores, seu rixosos sophistas dixeris, certe convitiatores potius dicendi <lb xml:id="p1z9"/>quam concionatores, ex <placeName ref="l749">Saxonia</placeName> prodeuntes, huius scriptis inbuti, <lb xml:id="p1z10"/>vel magis infecti et inflati, deus bone, quas nobis turbas movent, <lb xml:id="p1z11"/>ecclesias perturbant pacataque dissipant.</s>
					<s n="6" xml:lang="la">Testis est <placeName ref="l18">Augusta</placeName> ipsa cum <lb xml:id="p1z12"/><placeName ref="l907">Campidona</placeName> et <placeName ref="l409">Ravenspurgo</placeName>.</s>
					<s n="7" xml:lang="la">Speramus tamen tranquilliora, cum vide<lb xml:id="p1z13"/>amus quosdam nonnichil mitiores aequanimioresque redditos script<lb xml:id="p1z14"/>o pio modesto et solido d. <persName ref="p540">Calvini</persName>, viri pii docti modesti et solidi, <lb xml:id="p1z15"/>quod multi pii ministri et alii sinceri et constantes in linguam Germani<lb xml:id="p1z16"/>cam versum cupiunt vehementer, cum videant Westphali<lb xml:id="p1z17"/>cos a <placeName ref="l361">Nurenbergensi</placeName> quodam ministro in Germanicam translatos.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z18"/>Rogo igitur, humanissime <persName ref="p495">Bullingere</persName>, ut in hac quoque re fatribus <lb xml:id="p1z19"/>piis, imo ecclesiis sanctis inservire velis, et in hoc incumbere, ut sim<lb xml:id="p1z20"/>plicem de eucharistia veritatem, olim Christi verbis institutione et spiritu <lb xml:id="p1z21"/>doctam, nunc testatam ac adsertam audiant et confirmentur.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z22"/>De tragoedia <placeName ref="l409">Ravenspurgi</placeName> per clamosum et damnosum concionatorem, <lb xml:id="p1z23"/>quem potius convitiatorem dixero, excitata credo aut ex <persName ref="p3959">Willingi</persName> <lb xml:id="p1z24"/>ipso aut ex eius literis iam acceperis; sin minus, ex literis percipies, <lb xml:id="p1z25"/>modo volueris, quas ad maecenatem meum summum <persName ref="p1234">Iohannem Functium</persName>, <lb xml:id="p1z26"/>virum pietatis, prudentię et humanitatis summę, de hac re et aliis dedi <lb xml:id="p1z27"/>longissim s, de doctore item <persName ref="p20249">Ludovico Rabus</persName>, nunc <placeName ref="l491">Argentoratens<lb xml:id="p1z28"/>is</placeName> ecclesię pastore, ut ferunt, primario, quid is apud nos egerit et <lb xml:id="p1z29"/>de coena nobiscum contulerit, demum et de hominibus aliquot apud nos <lb xml:id="p1z30"/><persName>Arriana</persName> labe horrendum infectis.</s>
					<s n="10" xml:lang="la">Hec et alia, si quando vacat garrire, <lb xml:id="p1z31"/>ut inquit ille, ad focum a coena, audies abunde et ad nauseam usque.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z32"/>Vale et vive, pristinis recuperatis dei bonitate viribus, cum tuis omnibus <lb xml:id="p1z33"/>foeliciter, et cura ut <persName ref="p540">Calvinus</persName> nobis Germanis loquatur.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z34"/>Ex <placeName ref="l320">Meminga</placeName> 11. kalendis iunii anno Christi 1555.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z35"/>Tuae humanitatis deditissimus <persName ref="p330">Bartholomaeus Bertlinus</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro humanissimo <lb xml:id="p2z2"/>eruditione et pietate in<lb xml:id="p2z3"/>signi d. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z4"/>ecclesie <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z5"/>antistiti fideli et pru<lb xml:id="p2z6"/>denti domino et amico suo <lb xml:id="p2z7"/>reverenter observando.</s>
				</p>
				<p>
					<s n="15" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zürch</placeName>.</s>
				</p>
			</div>
		</body>
