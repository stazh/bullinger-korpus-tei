	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ace<lb xml:id="p1z2"/>rbissimas <lb xml:id="p1z3"/>et longe alias mihi literas, charissime <lb xml:id="p1z4"/>frater <persName ref="p8087">Hieronyme</persName>, scripsisti, quam a sene et a iuvenili<lb xml:id="p1z5"/>bus affectibus defecato expectavissem.</s>
					<s n="3" xml:lang="la"><persName>Debacharis</persName> <lb xml:id="p1z6"/>in <placeName ref="l513">Ulmium</placeName>, cum ille neque in te neque in fratres <lb xml:id="p1z8"/>peccasse videatur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Certe apud me tui nunquam nisi <lb xml:id="p1z9"/>honorificam mentionem fecit.</s>
					<s n="5" xml:lang="la">Scio autem, quid fiat, <lb xml:id="p1z10"/>cum animi disiunguntur, opera linguarum immoderata <lb xml:id="p1z11"/>adiungit se Sathanas et scintillas futuri incendii <lb xml:id="p1z12"/>excitat neque desinit, donec in immensum <lb xml:id="p1z13"/>excrescat incendium.</s>
					<s n="6" xml:lang="la">Hortor ergo te, mi frater, ut <lb xml:id="p1z14"/>memineris <placeName>Paulinae</placeName> illius, apostolicae inquam, <lb xml:id="p1z15"/>sententiae: Irascimini, et nolite peccare; sol ne occida<lb xml:id="p1z16"/>t super iram vestram neque detis locum diabolo."</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/>Nosco te hic aliquid humanum passum.</s>
					<s n="8" xml:lang="la">Redito ad ani<lb xml:id="p1z18"/>mum (amicum?) et complectere in domino nostro.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Plura <lb xml:id="p1z19"/>intelliges ex fideli ministro <placeName ref="l487">Steckburanae</placeName> <lb xml:id="p1z20"/>ecclesiae, fratre charo, et ex literis publicis.</s>
					<s n="10" xml:lang="la">Amo te, mi <lb xml:id="p1z21"/><persName ref="p8087">Hieronyme</persName>, et te una cum tuis in Christo optime valere opto<lb xml:id="p1z22"/>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 20. octobris 1557.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Amatissimo viro d. <persName ref="p8087">Hieronymo Krantzio</persName>, domino et fratri colendissimo e<lb xml:id="p1z24"/>t charissimo suo.</s>
					<s n="14" xml:lang="de"><placeName ref="l113">Dießenhoven</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
