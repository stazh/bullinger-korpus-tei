				<p>
					<lb xml:id="p1z1"/>S. Reverende in Christo pater, etsi quod ad te
					<lb xml:id="p1z2"/>scribam non habeo. Scribo tamen, ut te doceam
					<lb xml:id="p1z3"/>superioribus debus, cum interprete d. Laget
					<lb xml:id="p1z4"/>fasciculum misisse et spero redditum. Tum
					<lb xml:id="p1z5"/>comitiorum non erint ad manu, quae tu
					<lb xml:id="p1z6"/>foctissis interim legisti, et tamen mitto exemplar
					<lb xml:id="p1z7"/>ut puer exscripsit. Quod nostri dicunt se
					<lb xml:id="p1z8"/>esere elher qud ei in
					<lb xml:id="p1z9"/>mmalis prastrant, dt fecti proptem de ptrs
					<lb xml:id="p1z10"/>omnulbius madis ibium verei sare, quis mairs
					<lb xml:id="p1z11"/>itue asti esalie et ille eisert u
					<lb xml:id="p1z12"/>de rber celeria, et liti ius
					<lb xml:id="p1z13"/>e e elen ae sa i,
					<lb xml:id="p1z14"/>etei u en dise e ulis neis,
					<lb xml:id="p1z15"/>et, quo suentus dublibatur, hube hc sosu
					<lb xml:id="p1z16"/>aler ide er l tu us
					<lb xml:id="p1z17"/>in Germuniaum. Scribo go al o
					<lb xml:id="p1z18"/>et l n e espilia u,
					<lb xml:id="p1z19"/>nibi invitus moliste sci; sed tamen tu m
					<lb xml:id="p1z20"/>et ei res ili ntaiu,
					<lb xml:id="p1z21"/>u n ipt re e n hi n
					<lb xml:id="p1z22"/>se tpse re. Expeler, quod remasissi at o
					<lb xml:id="p1z23"/>ete, et uxt si vir samme modisse primanm
					<lb xml:id="p1z24"/>sirilli er cn lidi sari cat
					<lb xml:id="p1z25"/>cospidenm sit ptri bsitu icnda e
					<lb xml:id="p1z26"/>det le ai felir anis ae,
					<lb xml:id="p1z27"/>ecgelit glapi. si cedt nihil hoc
					<lb xml:id="p1z28"/>dis mnre deicata harisus, qua
					<pb/>
					<lb xml:id="p2z1"/>cantellaris, dra Lotharingum, praesente rege ex regina,
					<lb xml:id="p2z2"/>et durius essit dictum. Misi heri episcopo
					<lb xml:id="p2z3"/>legendum. Monui, ne partes Hispanorum tutandus
					<lb xml:id="p2z4"/>sscipere vellet, si secus faceret, cum mihi quidem
					<lb xml:id="p2z5"/>aliquam molestiam fecessere posse, sed eiusmodu
					<lb xml:id="p2z6"/>tamen, quae cum suo quoque periculo coniuncta futura
					<lb xml:id="p2z7"/>esset. Expecto, quid ille. Gratum fuisset, si eiidem
					<lb xml:id="p2z8"/>sum libellum misisses et paucis monisses de
					<lb xml:id="p2z9"/>scripto naceo. Alia nunc non hibeo. Te revernde
					<lb xml:id="p2z10"/>poter at vivere et valere gaudeo. Dunuss rogo
					<lb xml:id="p2z11"/>ut dein incolumis valeas.
					<lb xml:id="p2z12"/>C 5. mati.
					<lb xml:id="p2z13"/>anno 1555.
					<lb xml:id="p2z14"/>obserntissimo
					<lb xml:id="p2z15"/>S.
					<lb xml:id="p2z16"/>Italicę schediae, sum ni faller haec est
					<lb xml:id="p2z17"/>cardindem Caessum cardinalium omnium ditissimum
					<lb xml:id="p2z18"/>xrertuum esse. coniurationem in pontificem detectam
					<lb xml:id="p2z19"/>autsores emisere eruncatos, inter quos etiaam fuisse
					<lb xml:id="p2z20"/>dict sardendis de Ancona, Benedictus
					<lb xml:id="p2z21"/>de Rcokefilis.
					<lb xml:id="p2z22"/>o Lnpar g.
					<lb xml:id="p2z23"/>Pantificum nunquam laetum anspentium.
					<pb/>
					<lb xml:id="p4z1"/>Amplissimo viro d.
					<lb xml:id="p4z2"/>Heinrycho Bullingero, domino
					<lb xml:id="p4z3"/>osuo et in Chriti
					<lb xml:id="p4z4"/>patri reverendo
					<lb xml:id="p4z5"/>Tiguri.
