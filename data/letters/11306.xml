	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Cum nuper per publicum illum tabellarium<note xml:id="fn1" type="footnote" n="1"><persName ref="p6240">Ulrich Appenzeller</persName> (vgl. unten Z. 6f mit Anm. 5).</note> <lb xml:id="p1z2"/>literas<note xml:id="fn2" type="footnote" n="2">Oben <ref target="file11303">Nr. 1260</ref>.</note> ad te scripsissem, patrone humanissime, <lb xml:id="p1z3"/>scriptasque obsignassem et ille discessum<note xml:id="fna" type="footnote" n="a"><hi>in der Vorlage</hi> discessu.</note> iam adornaret, <lb xml:id="p1z4"/>rogabat d. <persName ref="p8418">Miconii</persName> <persName ref="p5896">uxor</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p5896">Margret</persName>.</note>, ut per hunc nuntium te iuberem <lb xml:id="p1z5"/>ipsius gratia de pecunia mea dimidiatum florenum dare <lb xml:id="p1z6"/><persName ref="p5025">Rodolpho Grob</persName><note xml:id="fn4" type="footnote" n="4">Weiter nicht bekannt.</note> aurigae, nam eius cognatus est; hunc <lb xml:id="p1z7"/>ego deinde ratione subducam.</s>
					<s n="3" xml:lang="la">Hoc si, ut <persName ref="p6240">Appenzellero</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p6240">Ulrich Appenzeller</persName> war als amtlicher Bote nach <placeName ref="l28">Basel</placeName> geschickt worden, vgl. Zürich StA, F III 32, Seckelamtsrechnung 1538[-39], Ausgaben, S. 78.</note> man<lb xml:id="p1z8"/>davi, curavisti, bene est; quod si certiores a me expe<lb xml:id="p1z9"/>ctavisti literas, rogo, ut nunc expedias.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><persName ref="p4830">Adamum Fry</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p4830">Adam Frey</persName>.</note> <lb xml:id="p1z10"/>ipse conveni, qui satis dignas gratias se nunquam pro <lb xml:id="p1z11"/>libro<note xml:id="fn7" type="footnote" n="7"><persName ref="p495">Bullingers</persName> "Bericht der Kranken", vgl. oben <ref target="file11297">Nr. 1254</ref>, 12-16; 1260, 7-9.</note> referre posse ait.</s>
					<s n="5" xml:lang="la">Pietatem certe exercet egregiam <lb xml:id="p1z12"/>patientiaque utitur incredibili.</s>
					<s n="6" xml:lang="la">Deus faxit, ut hoc morbo <lb xml:id="p1z13"/>liberetur.<pb type="edition" next="126"/></s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Te rursum rogo, charissime praeceptor, ut <lb xml:id="p1z15"/>de pecuniis, quas habes, mihi florenum mittas, ut aestivas <lb xml:id="p1z16"/>vestes et alia comparare possim; incredibile enim, quam me <lb xml:id="p1z17"/><placeName ref="l491">Argentina</placeName> exhauserit.</s>
					<s n="8" xml:lang="la">De proximis enim nummis mihi <lb xml:id="p1z18"/>missis florenos sex et sex bazones <persName ref="p315">Bedroto</persName> mittere <lb xml:id="p1z19"/>oportuit; huic enim debui pro victu florenos novem <placeName ref="l491">Argentin<lb xml:id="p1z20"/>ensis</placeName> monetae, ante dederam quinque.</s>
					<s n="9" xml:lang="la">Pręterea <lb xml:id="p1z21"/>florenum ibi insumpsi in ligno, florenum <persName ref="p5203">Herlino</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p5203">Christian Herlin</persName>.</note> <lb xml:id="p1z22"/>pro Ptolemęi lectione dedi, dimidiatum florenum p<lb xml:id="p1z23"/>ro hypocausto cubiculoque; reliquos duos pro aliquot libellis <lb xml:id="p1z24"/>et viatico insumpsi.</s>
					<s n="10" xml:lang="de">Und hatt mich fürwar also <placeName ref="l491">Straß<lb xml:id="p1z25"/>burg</placeName> wit hindersich<note xml:id="fn9" type="footnote" n="9">in den Rückstand.</note> bracht.</s>
					<s n="11" xml:lang="la">Quare, patrone humanissime, <lb xml:id="p1z26"/>te rogo, ut, si quo pacto fieri potest, aliquod saltem <lb xml:id="p1z27"/>meo stipendio addatur augmentum, quo facilius literis <lb xml:id="p1z28"/>operam dare possim.</s>
					<s n="12" xml:lang="la">Testor certe illos, quibuscum habito, <lb xml:id="p1z29"/>me nullos inutiles sumptus impendere; sed quo modo <lb xml:id="p1z30"/>huc penurię iam pervenerim, satis intellexisti.</s>
					<s n="13" xml:lang="la">Plura, <lb xml:id="p1z31"/>quae scribam, non habeo.</s>
					<s n="14" xml:lang="la">Te rogo, ut hęc aequi bonique consulas <lb xml:id="p1z32"/>meque tibi habeas commendatissimum.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Salutat<note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> Salutat <hi>gestrichenes</hi> Basile.</note> <lb xml:id="p1z33"/>te plurimum <persName ref="p6192">Ioannes Reyfenstein</persName><note xml:id="fn10" type="footnote" n="10"><persName ref="p6192">Johann Wilhelm Reiffenstein</persName>.</note> mei amantissimus et <persName ref="p8459">Otho</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p8459">Otto Werdmüller</persName>.</note> noster.</s>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z34"/>Salutabis et meis verbis <persName ref="p8051">uxorem</persName><note xml:id="fn12" type="footnote" ana="bio" n="12"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> <persName ref="p7042">matremque</persName><note xml:id="fn13" type="footnote" ana="bio" n="13"><persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note> tuam, hone<lb xml:id="p1z35"/>stissimas foeminas, cum omni liberorum coetu<note xml:id="fn14" type="footnote" n="14">Vgl. oben <ref target="file11260">Nr. 1217</ref>, Anm. 46.</note>.</s>
					<s n="17" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z36"/>bene, patrone observande.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l28">Basileę</placeName>, ex aedibus d. <persName ref="p8418">Miconii</persName>, <lb xml:id="p1z37"/>3. maii 1539.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z38"/>Tui observantissim<lb xml:id="p1z39"/>us</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z40"/><persName ref="p8011">Rodolphus Gvaltherus</persName><note xml:id="fnc" type="footnote" n="c"><hi>Darunter Notiz von <persName ref="p495">Bullingers</persName> Hand:</hi> Vigilius, Tubingae, Tridentinus episcopus, Urspurgensis Latinus <hi>(zur Sache vgl. unten <ref target="file11313">Nr. 1270</ref>, 7-12).</hi></note>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vere docto et pio viro <lb xml:id="p2z2"/>M. <persName ref="p495">Heinrycho Bul<lb xml:id="p2z3"/>lingero</persName>, patrono suo <lb xml:id="p2z4"/>imprimis colendo.</s>
					<s n="22" xml:lang="de"><lb xml:id="p2z5"/>An M. <persName ref="p495">Heinrich <lb xml:id="p2z6"/>Bullinger</persName> zuͦ <lb xml:id="p2z7"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
