	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Reverende vir, praeceptor et <lb xml:id="p1z2"/>patrone colende, inter praecipua hominis scholas<lb xml:id="p1z3"/>tici ornamenta recenseo communicationem cum iis <lb xml:id="p1z4"/>viris, qui pietate, doctrina, virtute et sapientia <lb xml:id="p1z5"/>reliquo generi humano antecellunt.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Quare, cum <lb xml:id="p1z6"/>superiori anno facultas mihi ineunde tecum <lb xml:id="p1z7"/>amiciciae data sit et tu eam interea literis <lb xml:id="p1z8"/>ad me amantissime scriptis confirmaveris, <lb xml:id="p1z9"/>ex animo mihi de ea felicitate gratulor, <lb xml:id="p1z10"/>eruntque tuae literae mihi perpetuo velut pre<lb xml:id="p1z11"/>ciossimum <foreign xml:lang="el">κειμήλιον</foreign> et certissimum testimonium <lb xml:id="p1z12"/>ac pignus verae et ardentis erga me benevolentiae.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z13"/>Utinam vero vicissim tibi aliquo officio <lb xml:id="p1z14"/>meam observantiam declarare possem; sed cum <lb xml:id="p1z15"/>longissimo intervallo a vobis remotus sim, <lb xml:id="p1z16"/>spero te memorem meam mentem et in te <lb xml:id="p1z17"/>colendo fidem ac constantiam probaturum esse.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z18"/>Vivo enim nunc in extrema mundi ora <lb xml:id="p1z19"/>ad littus maris Balthici ac deo gratias ago, <lb xml:id="p1z20"/>quod in haec loca me collocavit, quae sola <lb xml:id="p1z21"/>fere optime et sanctissime constitutis ecclesiis <lb xml:id="p1z22"/>et scholis tranquillum hospitium praebent.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z23"/>Ego in hac academia auditoribus <lb xml:id="p1z24"/>elementa doctrinae christianae propono <lb xml:id="p1z25"/>ac plurimum tuis Decadibus adiuvor.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z26"/>Ut autem meae erga te observantiae et exercici<lb xml:id="p1z27"/>orum meorum specimen aliquod tibi <lb xml:id="p1z28"/>ostenderem, adiunxi literis disputatiunculam <pb/><lb xml:id="p2z1"/>De essentia dei et discriminibus personarum <lb xml:id="p2z2"/>a me superiori anno habitam, in qua cernes me <lb xml:id="p2z3"/>tua orthodoxa adsertione utriusque naturae in <lb xml:id="p2z4"/>Christo saepe usum esse.</s>
					<s n="8" xml:lang="la">Addidi etiam orationem <lb xml:id="p2z5"/>funebrem de principe <persName>Henrico</persName> <lb xml:id="p2z6"/>ac te oro, ut has chartas aequo animo acci<lb xml:id="p2z7"/>pias et me, tu cepisti, perpetuo ames.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p2z8"/>Bene et feliciter vale.</s>
					<s n="10" xml:lang="la" ana="salute">Salutem reverenter <lb xml:id="p2z9"/>et officiose opto clarissimis viris d. <persName ref="p1283">Con<lb xml:id="p2z10"/>rado Gesnero</persName> et d. <persName ref="p8011">Rudolpho Gvalter</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z11"/><placeName ref="l427">Rostochii</placeName> in feriis pentecostes anno 1552.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z12"/><persName ref="p583">David Chytraeus</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z13"/>Reverendo viro <lb xml:id="p2z14"/>eruditione et vir<lb xml:id="p2z15"/>tute praestanti d. <lb xml:id="p2z16"/><persName ref="p495">Henrico Bullingero</persName> <lb xml:id="p2z17"/>gubernanti <lb xml:id="p2z18"/>ecclesiam dei in <lb xml:id="p2z19"/>inclyta urbe <placeName ref="l587">T<lb xml:id="p2z20"/>iguro</placeName>, domino <lb xml:id="p2z21"/>suo et praeceptori <lb xml:id="p2z22"/>reverenter colendo.</s>
				</p>
			</div>
		</body>
	</text>
