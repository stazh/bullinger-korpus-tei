	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi literas tuas cum <persName ref="p8111">Petri Martyris</persName>.</s>
					<s n="3" xml:lang="la">Scripsi diligenter ac satis di<lb xml:id="p1z2"/>lucide <placeName ref="l93">Claven[n]am</placeName> ad <persName ref="p2019">Augustinum Maynardum</persName> et ad alios, quos iussisti, <lb xml:id="p1z3"/>per certos nuncios.</s>
					<s n="4" xml:lang="la"><persName ref="p8111">Petri Martyris</persName> literas remitto ad te, ut vides.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z4"/>Batzios 12 pro libro mitto eciam hic.</s>
					<s n="6" xml:lang="la">Nova habeo nulla, <lb xml:id="p1z5"/>nisi quod heri allatum est <placeName ref="l425">Romanum</placeName> pontificem milites conscribere <lb xml:id="p1z6"/>ut et ducem <placeName ref="l1196">Urbini</placeName>.</s>
					<s n="7" xml:lang="la">De ludimagistro scribent ipsi <lb xml:id="p1z7"/>domini proxima die Martis; placuit enim ipsis, quod tu misisti <lb xml:id="p1z8"/>ad me.</s>
					<s n="8" xml:lang="la" ana="farewell">Interim vale in Domino Iesu, vir praestantissime.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z9"/>Ex <placeName ref="l98">Curia</placeName>, die 5. Februarii 1556.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z10"/>Tuae humanitatis <persName ref="p8359">Philippus Gallicius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vere magno viro D. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>bonis omnibus <lb xml:id="p2z4"/>colendissimo.</s>
					<s n="12" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
