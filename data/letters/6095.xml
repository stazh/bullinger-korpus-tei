	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Reverende in Christo pater, etsi sciam <persName ref="p8075">Erastum</persName> nostrum <lb xml:id="p1z2"/>diffuse ad te iam scribere, existimavi tamen gratius <lb xml:id="p1z3"/>tibi fore, si aliquid adderem literarum, quam si verbis <lb xml:id="p1z4"/>dumtaxat salutem per <persName>Zachariam</persName> hunc, pium adolescentem, <lb xml:id="p1z5"/>tibi dicerem.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Paucis igitur hoc scito, pater <lb xml:id="p1z6"/>honorande, opus nobis esse hoc tempore vestris precibus <lb xml:id="p1z7"/>et quidem contentissimis; etenim in certamen vocamur <lb xml:id="p1z8"/>quorundam hominum imprudentia, quam utinam deus sua <lb xml:id="p1z9"/>providentia in bonum convertat!</s>
					<s n="4" xml:lang="la">Ex <persName ref="p8075">Erasti</persName> literis <lb xml:id="p1z10"/>dubio procul intellexisti rem copiosius.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Utinam non sint <lb xml:id="p1z11"/>magnorum malorum initia!</s>
					<s n="6" xml:lang="la">Reliquam concionum partem <lb xml:id="p1z12"/>ad te mitto.</s>
					<s n="7" xml:lang="la"><persName ref="p18233">Illyricus</persName> nominatim contra me <lb xml:id="p1z14"/>scripsit; an ei respondendum iudices, cupio ex <lb xml:id="p1z15"/>te intelligere.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Si respondendum sit, faciam mo<lb xml:id="p1z16"/>deste et graviter, quantum dominus dederit, et <lb xml:id="p1z17"/>eo consilio faciam, ut ipsius nomine pro larva <lb xml:id="p1z18"/>utar et occasione ad propugnandam veritatem.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/>Cum enim exosus sit multis per <placeName ref="l822">Germaniam</placeName>, <lb xml:id="p1z21"/>in ipsius contemptum volent plerique, quae adversu<lb xml:id="p1z22"/>s ipsum scribuntur, legere.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Nollem etiam <lb xml:id="p1z23"/>affixus esse ipsius scripto, sed mea metho<lb xml:id="p1z24"/>do causam totam tractare atque suo quoque <lb xml:id="p1z25"/>loco refutare.</s>
					<s n="11" xml:lang="la">Quid suadeas, rogo ut <lb xml:id="p1z26"/>paucis rescribas.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Dominus Iesus te servet ecclesię.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z27"/>Vale et pro nobis ora.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Datum <placeName ref="l210">Heidelbergę</placeName> 5. aprilis <lb xml:id="p1z28"/>anno 1564.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z29"/>Tuus ex animo <persName ref="p8125">Casparus Olevianus</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Reverendo in Christo patri domino <lb xml:id="p2z2"/><persName ref="p495">Heynricho Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesię ministro fidelissimo, <lb xml:id="p2z4"/>domino meo honorando.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
