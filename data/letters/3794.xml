	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Heri tuas accepi literas, quibus nihil respondi, quod expectarem, quid ii, quos ad te <lb xml:id="p1z2"/>miseram, referrent.</s>
					<s n="3" xml:lang="la">Scripsisse me puto antea curaturum, ut hospes <persName>Ciconie</persName> intelligat <lb xml:id="p1z3"/>tuam commendationem multum illi profuisse eique te posse polliceri me praestaturum, que tu <lb xml:id="p1z4"/>faceres, si ipse legatus esses.</s>
					<s n="4" xml:lang="la">Mors regine <placeName ref="l830">Anglie</placeName> interrupit colloquium de pace, et omnia <lb xml:id="p1z5"/>sunt dilata ad principium februarii, estque semper spes pacem coalituram, tametsi multe <lb xml:id="p1z6"/>sint difficultates et multa minori tempore accidere possint, que dissipent omnia.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Accepi cardinalem <persName>Paulum</persName> finxisse se mortuum et funus elatum, omnia ad id disposita, <lb xml:id="p1z8"/>dum aufugeret.</s>
					<s n="6" xml:lang="la">Fertur etiam <placeName ref="l306">Mediolani</placeName> colligi militem et omnia parari ad bellum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Deus, <lb xml:id="p1z9"/>quod commodum erit et ad gloriam suam pertinebit, faciet.</s>
					<s n="8" xml:lang="la">In statu <placeName ref="l862">Helvetiorum</placeName> <lb xml:id="p1z10"/>ut pax constet et omnes quieta sequantur consilia, annitar nec aliquid praetermittam.</s>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z11"/>Salutabis amicos omnes.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l21">Badene</placeName> 13. decembris.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z12"/>Tuus ex animo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henricho Bullingero</persName>, ecles<lb xml:id="p2z2"/>ie <placeName ref="l587">Tigurine</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
