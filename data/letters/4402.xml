	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Hoc momento hasce a fratre <persName ref="p8178">Thoma</persName> accipio, qui petit, ut, si ad <lb xml:id="p1z2"/><persName ref="p1341">Gryndallum</persName> scripseris, eas cum tuis coniunctas ad hunc mittas.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Mittit praeterea pasquillum de novo papatu necessario editum, <lb xml:id="p1z4"/>quem lectum ad te mox misero, si forte dignum iudices, qui typis excudatur, <lb xml:id="p1z5"/>quamquam non sunt forte magis irritandi isti crabrones.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>21. <lb xml:id="p1z7"/>augusti 1560.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>T[uus] <persName ref="p8055">Ambr[osius</persName>].</s>
				</p>
				<p>
					<s n="5" xml:lang="la">D. <pb/><lb xml:id="p2z1"/><persName ref="p495">Bullingero</persName> suo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
