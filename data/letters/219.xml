	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Min fründlichenn grus samptt, was ich eerenn, <lb xml:id="p1z2"/>liebs unnd gutts vermag, zuvor.</s>
					<s n="2" xml:lang="de">Eerwürdiger, <lb xml:id="p1z3"/>hoch gellerter sonnders eerennder, günstiger, lieber <lb xml:id="p1z4"/>herr, üwer schrybenn hab ich empfanngenn, <lb xml:id="p1z5"/>bedannck üch zum höchsten üwer mü unnd arbeytt <lb xml:id="p1z6"/>unnd bin vast woll zefrydenn, minenn <lb xml:id="p1z7"/>bruͦdersun by herren <persName ref="p8011">Walltherio</persName> ze thunde.</s>
					<s n="3" xml:lang="de"><lb xml:id="p1z8"/>Diewyll aber ich des fürnämenns bin, <lb xml:id="p1z9"/>anheimsch ze ryttenn, wird ich söllichs <lb xml:id="p1z10"/>meinem schwächer anzeygenn unnd mitt <lb xml:id="p1z11"/>ime ze ratt wärden, wenn wir ine <lb xml:id="p1z12"/>genn <placeName ref="l587">Zürych</placeName> schickenn wellind.</s>
					<s n="4" xml:lang="de">Hiemitt mich <lb xml:id="p1z13"/>üch bevelchennde, gott denn allmächtigenn <lb xml:id="p1z14"/>getrüwlich bittennde, das er üch inn <lb xml:id="p1z15"/>sinem göttlichem schirm welle erhalltenn.</s>
				</p>
				<p>
					<s n="5" xml:lang="de"><lb xml:id="p1z16"/>Datum ze <placeName ref="l21">Baddenn</placeName> 7. augusti 15<lb xml:id="p1z17"/>48.</s>
					<s n="6" xml:lang="de"><lb xml:id="p1z20"/>Üwer williger diener <lb xml:id="p1z21"/><persName ref="p8519">Hannß Wunderlich</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="7" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem erwürdigenn, <lb xml:id="p2z2"/>hochgelertenn herren <lb xml:id="p2z3"/><persName ref="p495">Heynrich Bullinger</persName>, <lb xml:id="p2z4"/>verkhünder des heylligen <lb xml:id="p2z5"/>wortts <placeName ref="l587">Zürych</placeName>, <lb xml:id="p2z6"/>minem insonders <lb xml:id="p2z7"/>eerenden, lieben herren<lb xml:id="p2z8"/>.</s>
				</p>
			</div>
		</body>
	</text>
