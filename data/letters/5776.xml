	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Venit hoc vesperi d. <persName ref="p8114">Balingketus</persName> <persName ref="p8186">Bonetus</persName> <lb xml:id="p1z3"/>rogans, si quid scribere vellem; esse enim, <lb xml:id="p1z4"/>qui perferret.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Ego vero tunc nihil habebam <lb xml:id="p1z5"/>et iam ante literas civi dederam, quas <persName>Stephano <lb xml:id="p1z6"/>Heimio</persName> (qui nunc tamen non profectus est) <lb xml:id="p1z7"/>dare cogitabam.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Interim scribit d. <persName ref="p2054">Marti<lb xml:id="p1z8"/>nengus</persName>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Summa literarum haec est: se <lb xml:id="p1z9"/>literas accepisse recens <placeName ref="l1121">Genuae</placeName> datas, in quibus <lb xml:id="p1z10"/>nuncietur classem <placeName ref="l2510">Turcicam</placeName> appulisse ad Oranum, <lb xml:id="p1z11"/><persName>Philippi</persName> regis urbem munitam primariamque <lb xml:id="p1z12"/>in ora <placeName>Africana</placeName> e regione <placeName ref="l875">Hispaniae</placeName>, <lb xml:id="p1z13"/>qua si potitus fuerit <placeName ref="l2510">Turca</placeName> timendum esse, <lb xml:id="p1z14"/>ne brevi postea totam illam regionem occupet.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Iam <placeName ref="l834">Italiae</placeName> maritima solvi timore, quo <lb xml:id="p1z16"/>percellebantur, priusquam cognovissent, quid sibi <lb xml:id="p1z17"/>vellet classis tam tempestiva.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Rumorem <lb xml:id="p1z18"/>spargi concilium mense <persName>Augusto</persName> primum dissol<lb xml:id="p1z19"/>vendum; scribi <placeName ref="l691">Lotaringum</placeName> adhuc <placeName ref="l1107">Tridenti</placeName> <lb xml:id="p1z20"/>commorari, animo tamen esse perturbatissimo, <lb xml:id="p1z21"/>eo quod a fratre, Guisiano cardinale, signi<lb xml:id="p1z22"/>ficatum ei fuerit, sibi caveret; esse enim <lb xml:id="p1z23"/>25 viros <placeName ref="l832">Gallos</placeName>, qui in ipsius <placeName ref="l691">Lotaringi</placeName> <lb xml:id="p1z24"/>necem coniurassent; propterea quoque misisse <lb xml:id="p1z25"/>ei imagines ad vivum depictas, quae expri<pb/><lb xml:id="p2z1"/>merent quatuor ex coniuratis.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><persName>Lotaringum</persName> a <placeName ref="l522">Venetis</placeName> <lb xml:id="p2z2"/>impetrasse diligentissimam portarum custodiam.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Superioribus <lb xml:id="p2z3"/>diebus tres <placeName ref="l832">Gallos</placeName>, probos viros et mercatores, <lb xml:id="p2z4"/><placeName ref="l1936">Brixiae</placeName> hac de causa detentos et adhuc detineri.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l522">Venetos</placeName> acriter Christum in suis membris persequi.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z6"/><persName>Philippi</persName> legatum <placeName ref="l425">Roma</placeName> nondum discessisse <lb xml:id="p2z7"/>necdum responsum tulisse, sed magnam spem esse <lb xml:id="p2z8"/>eum omnia impetrare posse aut plaeraque saltem.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z9"/>Haec subito vesperi a coena; ignosce.</s>
					<s n="13" xml:lang="la">15. iunii anno 1563.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">T[uus] <persName ref="p8009">F<lb xml:id="p2z10"/>ab[ricius</persName>].</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
