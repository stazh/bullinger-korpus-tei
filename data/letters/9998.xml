				<p>
					<lb xml:id="p1z1"/>pero meas postremas tibi esse redditas, quibus
					<lb xml:id="p1z2"/>alteras coniunxi, de quibus, qui oportunum
					<lb xml:id="p1z3"/>esset, cum parente nostro aqu ores. Ad eas
					<lb xml:id="p1z4"/>responsum tuum nunc expecto una cum ii literis
					<lb xml:id="p1z5"/>quas ad me remitti postulam. Caeterum
					<lb xml:id="p1z6"/>frater, pegregiam operam in illo tu
					<lb xml:id="p1z7"/>scripto navis, quod nobis nuperab
					<lb xml:id="p1z8"/>observandis nostris Bernensibus fratribus
					<lb xml:id="p1z9"/>vestra voluntate missum perlegimus.
					<lb xml:id="p1z10"/>adeo quidem, ut nihil vel brevius vel
					<lb xml:id="p1z11"/>commodius vel his nostris temporibus accommodatius
					<lb xml:id="p1z12"/>eam de re scribi potuisse existimemus.
					<lb xml:id="p1z13"/>qulinam is eventus hunc laboreen tu
					<lb xml:id="p1z14"/>hocque consalui commirne nostrum consequatur.
					<lb xml:id="p1z15"/>quem optare potius quam sperorre licet
					<lb xml:id="p1z16"/>Qud autem nostris de re tota videatur.
					<lb xml:id="p1z17"/>ad vos perscriptum ab iisdem Bernensibus
					<lb xml:id="p1z18"/>fratribus opinor. De rebus Gallicis ex
					<lb xml:id="p1z19"/>icognosces, quae ad ipsum parentem nostram
					<lb xml:id="p1z20"/>scribo, pro cuius saltem miligandis doloribus
					<lb xml:id="p1z21"/>desistimus deum optimem maximu noctes ac
					<lb xml:id="p1z22"/>precar. Meus Terbilhianus quietem
					<lb xml:id="p1z23"/>ame imiuto extersit, tot aliis occupationibus
					<lb xml:id="p1z24"/>quae niterumtt d possunt oppreto, ut
					<lb xml:id="p1z25"/>vxpossim respicare. De Hilario tuo
					<lb xml:id="p1z26"/>aliud spero. Bene vale, vir exime
					<lb xml:id="p1z27"/>et frater plorimum observande d Iesus
					<lb xml:id="p1z28"/>te servor ecclesiae suae tuisque laboribus magis
					<lb xml:id="p1z29"/>ac magis benedicat. Genevae, ib Augusti
					<lb xml:id="p1z30"/>S.
					<lb xml:id="p1z31"/>Tuus Bedae.
					<lb xml:id="p1z32"/>Qui has libri literas reddidit, mittitur a matre adolescensu
					<lb xml:id="p1z33"/>beniusdam nobilis, qui apud vos est, cui cognomentum
					<lb xml:id="p1z34"/>estde nennis Habet itide. literas abtat
					<lb xml:id="p1z35"/>benior, cuius liberi istic sunt. Quoniam autem
					<lb xml:id="p1z36"/>est vestrae linguae prorsus ignarus, rogo te, ut
					<lb xml:id="p1z37"/>eum ad illorum hospitium dedicendu scures
					<pb/>
