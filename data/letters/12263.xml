	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuas tam ad senatum nostrum<note xml:id="fn1" type="footnote" n="1">Oben <ref target="file12255">Nr. 2208</ref>.</note> quam ad me datas literas<note xml:id="fn2" type="footnote" n="2">Nicht erhalten. Siehe aber oben <ref target="file12258">Nr. 2211</ref>, Anm. 16.</note>, desyderabi<lb xml:id="p1z2"/>lissime vir, perlegi.</s>
					<s n="3" xml:lang="la">Quantum ad d. <persName ref="p1010">Erbium</persName> pertinet,<note xml:id="fn3" type="footnote" n="3">Zur Berufung <persName ref="p1010">Matthias Erbs</persName> nach <placeName ref="l18">Augsburg</placeName> s. zuletzt oben <ref target="file12260">Nr. 2213</ref>.</note> expectabimus, <lb xml:id="p1z3"/>quid adulescens<note xml:id="fn4" type="footnote" n="4"><persName ref="p18219">Markus Wüst</persName>; s. oben <ref target="file12256">Nr. 2209</ref> und Anm. 11.</note> tibi ad ipsum ablegatus reportaturus <lb xml:id="p1z4"/>sit.</s>
					<s n="4" xml:lang="la">Magistratus noster interim agit tibi gratias pro diligentia <lb xml:id="p1z5"/>et labore in hac re impensis polliceturque se aliquando tibi <lb xml:id="p1z6"/>regratificaturum.</s>
					<s n="5" xml:lang="la">Ego, etsi negotiis distringar, tamen amicos <lb xml:id="p1z7"/>pręterire neutiquam debeo, cum plęraque facere cogar, quę <lb xml:id="p1z8"/>multo minoris momenti sunt quam ea, quę in amicos, omni <lb xml:id="p1z9"/>metallo preciosiores, iure optimo semper vel scriptitando vel <lb xml:id="p1z10"/>respondendo conferenda sunt.</s>
					<s n="6" xml:lang="la">Utinam illis pro decoro et <lb xml:id="p1z11"/>dignitate satisfacere queam!<pb type="edition" next="453"/></s>
				</p>
				<p>
					<s n="7" xml:lang="la">Quod d. d. <persName ref="p1283">Gesnerus</persName> et <lb xml:id="p1z12"/><persName ref="p4851">Froschouerus</persName> tam honeste de me sentiant,<note xml:id="fn5" type="footnote" n="5"><persName ref="p1283">Gessner</persName> und <persName ref="p4851">Froschauer</persName> waren in <placeName ref="l18">Augsburg</placeName> von <persName ref="p8354">Frölich</persName> zum Essen eingeladen worden; s. oben <ref target="file12250">Nr. 2203</ref>, 8-11.</note> ipsis decori adscribo, <lb xml:id="p1z13"/>qui etiam negligentiam et tenuitatem amiculi candide accipiunt.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Volui sane plura cum illis conferre, nisi quasi insperato <lb xml:id="p1z15"/>abiissent.</s>
					<s n="9" xml:lang="la"><persName ref="p19043">Fuggeri</persName> vocatio viri tanti, nostri nempe d. <persName ref="p1283">Gesneri</persName>,<note xml:id="fn6" type="footnote" n="6">Zu <persName ref="p19043">Anton Fuggers</persName> Interesse an <persName ref="p1283">Konrad Gessner</persName> s. oben <ref target="file12232">Nr. 2185</ref>, 27-36; 2203, 14-19.</note> <lb xml:id="p1z16"/>fęcit mihi varias cogitationes, cum sciveram <persName ref="p19043">Fuggerum</persName> esse <lb xml:id="p1z17"/>extreme papistam, illum vero per omnia pium; inde non <lb xml:id="p1z18"/>mirum est, si de conditione inter eos parum convenerit.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Dominus <lb xml:id="p1z19"/>virum hunc<note xml:id="fn7" type="footnote" n="7">Gemeint ist <persName ref="p1283">Gessner</persName>.</note> ad meliorem frugem nobis servaturus est.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/>An <persName ref="p1974">Lutherus</persName> adversum vos iam denuo scripserit, mihi omnino <lb xml:id="p1z21"/>non constat,<note xml:id="fn8" type="footnote" n="8">Ähnlich hatte sich <persName ref="p8354">Frölich</persName> schon am 28. Juli geäußert; s. oben <ref target="file12250">Nr. 2203</ref>, 20-22.</note> neque aliud exemplum quam illud ipsum,<note xml:id="fn9" type="footnote" n="9"><persName ref="p1974">Luthers</persName> "Kurtz bekentnis"; s. oben <ref target="file12108">Nr. 2061</ref>, Anm. 7.</note> ad quod <lb xml:id="p1z22"/>tu tam pie tamque necessario respondisti,<note xml:id="fn10" type="footnote" n="10">Das "Warhaffte Bekanntnuß"der <placeName ref="l587">Zürcher</placeName>; s. oben <ref target="file12108">Nr. 2061</ref>, Anm. 9.</note> hactenus vidi.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/>Verum, si quid pro more suo relatravit, brevi crędo ad nos <lb xml:id="p1z24"/>venturum.</s>
					<s n="13" xml:lang="la">Habet enim <persName ref="p1974">Lutherus</persName> et hic suę farinę<note xml:id="fn11" type="footnote" n="11">von seinem Schlag; vgl. <bibl source="b56">Adagia</bibl>, 3, 5, 44 (<bibl>ASD</bibl> II/5 321f, <ref target="file12491">Nr. 2444</ref>).</note> homines, qui <lb xml:id="p1z25"/>regnum ipsius propagatum velint; sed, deo gratia, frustra.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Quamprimum <lb xml:id="p1z26"/>tale quid prodierit, tibi citra moram communicabo.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z27"/>Comitia iam tandem dirempta sunt cum magno deludibrio<note xml:id="fn12" type="footnote" n="12">deludibrio = ludibrio.</note> tam <lb xml:id="p1z28"/><persName ref="p18538">caęsaris</persName><note xml:id="fn13" type="footnote" n="13"><persName ref="p18538">Karl V.</persName></note> quam ordinum imperii;<note xml:id="fn14" type="footnote" n="14">Zum Reichstag zu <placeName ref="l569">Worms</placeName> s. zuletzt <ref target="file12258">Nr. 2211</ref>, Anm. 24. 28; 2213, 85-88.</note> nam nihil pręter technas et imposturas <lb xml:id="p1z29"/>pepererunt, maxime vero ad id instituta, quomodo status imperii <lb xml:id="p1z30"/>alioqui male concordes discordiores redderentur.</s>
					<s n="16" xml:lang="la">Discessum <lb xml:id="p1z31"/>est ex <placeName ref="l569">Wormatia</placeName><note xml:id="fn15" type="footnote" n="15">Zur Abreise des Kaisers aus <placeName ref="l569">Worms</placeName> s. oben <ref target="file12258">Nr. 2211</ref>, 36f und Anm. 23.</note> rębus omnino inconfectis, ita ut neque pacis con<lb xml:id="p1z32"/>ditiones neque ius et iustitię administratio<note xml:id="fn16" type="footnote" n="16">Anspielung auf die Probleme, die das Reichskammergericht damals hatte; s. oben <ref target="file12178">Nr. 2131</ref>, 96-100 und Anm. 58f.</note> extent.</s>
					<s n="17" xml:lang="la">Velint profecto <lb xml:id="p1z33"/>et ex animo cuperent <placeName ref="l834">Itali</placeName> et <placeName ref="l875">Hispani</placeName> <placeName ref="l822">Germaniam</placeName> totam pessum iri.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z34"/><persName ref="p2301">Osiander</persName> iam valeat.</s>
					<s n="19" xml:lang="la">His diebus<note xml:id="fn17" type="footnote" n="17">Der Ehevertrag datiert vom 20. Juli 1545 und wurde am 27. Juli 1545 verkündet; s. <persName ref="p2301">Osiander</persName> GA VIII 367-369, <ref target="file10355">Nr. 324</ref>.</note> tertiam<note xml:id="fn18" type="footnote" n="18"><persName ref="p2301">Osiander</persName> war von 1525 bis 1537 mit <persName ref="p21109">Katharina Preu</persName>, von 1537 bis Mai 1545 mit <persName ref="p21110">Helena Kunhofer</persName> verheiratet gewesen; s. <persName ref="p2301">Osiander</persName> GA III 450, Anm. 14.</note> duxit uxorem, iuvenculam <lb xml:id="p1z35"/>omnino, doctoris <persName ref="p7649">Magenbuchi</persName><note xml:id="fn19" type="footnote" ana="bio" n="19"><persName ref="p7649">Johann Magenbuch</persName>, geb. 1487 in <placeName ref="l52">Blaubeuren</placeName> (<placeName ref="l3074">Alb-Donau-Kr.</placeName>, <placeName ref="l572">Baden-Württemberg</placeName>), gest. 14. Oktober 1546 in <placeName ref="l133">Eichstätt</placeName> (<placeName ref="l619">Bayern</placeName>). 1518 immatrikuliert in <placeName ref="l558">Wittenberg</placeName>. Am 9. Dezember 1523 dort Dr. med.; <cit type="bible"><ref>Am 20.</ref></cit> Juni 1524 Stadtarzt in <placeName ref="l361">Nürnberg</placeName>. Mit <persName ref="p2301">Osiander</persName> kollegial und freundschaftlich verbunden. - Lit.: <persName ref="p2301">Osiander</persName> GA III 57 (mit weiterer Lit.); Wikipedia.</note> <persName ref="p5724">filiam</persName>,<note xml:id="fn20" type="footnote" ana="bio" n="20"><persName ref="p5724">Helena Magenbuch</persName>, geb. 14. März 1523, gest. 8. September 1597 in <placeName ref="l2194">Hohenacker</placeName> (zu <placeName ref="l1784">Waiblingen</placeName>, <placeName ref="l572">Baden-Württemberg</placeName>) als Tochter von <persName ref="p7649">Johann Magenbuch</persName> und dessen erster Gattin <persName ref="p7770">Priskia Hunnia von Schweinitz</persName>. <persName ref="p5724">Helena Magenbuch</persName> verfügte über Kenntnisse in Botanik und Arzneikunde und interessierte sich für Alchemie. Juli/August 1545 Hochzeit mit <persName ref="p2301">Andreas Osiander</persName>. 1549 ging sie mit <persName ref="p2301">Osiander</persName> nach <placeName ref="l268">Königsberg</placeName> (s. dazu Gottfried <hi>Seebaß,</hi> Zwei Briefe von Andreas Osiander, in: Mitteilungen des Vereins für Geschichte der Stadt Nürnberg 57, 1970, 213f). Nach <persName ref="p2301">Osianders</persName> Tod (1552) heiratete sie 1556 <persName ref="p6279">Johannes Rucker oder Rückher</persName> (gest. 6. Dez. 1579), mit dem sie zwei Söhne und drei Töchter hatte. Nach <persName ref="p6279">Ruckers</persName> Tod zog sie nach <placeName ref="l496">Stuttgart</placeName>, wo sie unter der Herzogin von <placeName ref="l572">Württemberg</placeName>, <persName ref="p21111">Sibylla von Anhalt</persName>, bis zum 14. März 1597 als Hofapothekerin wirkte. Danach wurde ihr ein jährliches Leibgeding ausgesetzt. Sie lebte dann wahrscheinlich bei ihrer Tochter <persName ref="p6280">Maria</persName> (verheiratet mit Pfarrer <persName ref="p7153">Stephan Zahn</persName>) in <placeName ref="l2194">Hohenacker</placeName> (zu <placeName ref="l1784">Waiblingen</placeName>, <placeName ref="l3035">Lkr. Rems-Murr-Kreis</placeName>, <placeName ref="l572">Baden-Württemberg</placeName>), wo sie starb. - Lit.: G[ustav] <hi>Bossert,</hi> Die dritte Gattin von Andreas Osiander, in: <bibl source="b73">ARG</bibl> 12, 1915, 158-160; <bibl source="b472">Osiander GA</bibl> VIII 367, Anm. 8; <bibl source="b457">NDB</bibl> XIX 608f.</note> tanta cum pompa et <lb xml:id="p1z36"/>apparatu, ut <persName ref="p19868">Sardanapali</persName><note xml:id="fn21" type="footnote" n="21"><persName ref="p19868">Sardanapal</persName>, legendärer <placeName ref="l3149">assyrischer</placeName> Herrscher, Besitzer großer Reichtümer und berüchtigt wegen seiner ausschweifend-verweichlichten Lebensart; s. <bibl source="b479">Pauly/Wissowa</bibl> 11/2 2436-2475; Adagia, 3, 7, 27 (<bibl>ASD</bibl> II/6 439f, Nr. 2627).</note> insolentię sponsalia ista conferri <lb xml:id="p1z37"/>audierim.<pb type="edition" next="454"/></s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z38"/>D. <persName ref="p8122">Nicolaus Mayer</persName><note xml:id="fn22" type="footnote" ana="bio" n="22"><persName ref="p8122">Nikolaus Müller gen. Maier</persName>.</note>, tibi olim et adhuc addictissimus,<note xml:id="fn23" type="footnote" n="23"><persName ref="p8354">Frölich</persName> bezieht sich auf <persName ref="p495">Bullingers</persName> Briefwechsel mit <persName ref="p8122">Maier</persName> aus dem Jahr 1541.</note> <lb xml:id="p1z39"/>iam consiliarium nostrum agit<note xml:id="fn24" type="footnote" ana="bio" n="24"><persName ref="p8122">Maier</persName> wirkte von 1544 bis 1548 als Stadtadvokat in <placeName ref="l18">Augsburg</placeName>; s. <bibl source="b14">HBBW XI</bibl> <ref target="file11560">[Nr. 1517]</ref> 185, Anm.1.</note>.</s>
					<s n="21" xml:lang="la">Fuitque per totum comitiorum tempus <lb xml:id="p1z40"/><placeName ref="l569">Wormatię</placeName><note xml:id="fn25" type="footnote" n="25">Zu <persName ref="p8122">Maiers</persName> Teilnahme am <placeName ref="l569">Wormser</placeName> Reichstag s. RTAJRXVI/2 1495-1508 u.ö. Er war an den Verhandlungen über die Wiederbelebung des <placeName ref="l2481">Schwäbischen</placeName> Bundes (s. dazu oben <ref target="file12220">Nr. 2173</ref>, 40-42 und Anm. 23; unten 2227, 611) beteiligt.</note>.</s>
					<s n="22" xml:lang="la">Ante triduum vero reversus domi delitescit.</s>
					<s n="23" xml:lang="la">Vir pius et <lb xml:id="p1z41"/>optimus, mihi in fratrem selectus.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z42"/>Bibliothecam d. <persName ref="p1283">Gesneri</persName><note xml:id="fn26" type="footnote" n="26">Zu <persName ref="p1283">Gessners</persName> Bibliotheca universalis s. oben <ref target="file12250">Nr. 2203</ref>, 28-30 und Anm. 13.</note> mihi ex <placeName ref="l157">Franckfordia</placeName><note xml:id="fn27" type="footnote" n="27">Zum Termin der <placeName ref="l157">Frankfurter</placeName> Herbstmesse s. oben <ref target="file12142">Nr. 2095</ref>, Anm. 26.</note> advehi curabo,<note xml:id="fn28" type="footnote" n="28">Schon in seinem Brief vom 28. Juli hatte <persName ref="p8354">Frölich</persName> dieses Vorhaben geäußert; s. oben <ref target="file12250">Nr. 2203</ref>, 28-30 und Anm. 13.</note> <lb xml:id="p1z43"/>neque operibus divi<note xml:id="fna" type="footnote" n="a">divi <hi>am Rande nachgetragen.</hi></note> <persName ref="p4091">Zvinglii</persName><note xml:id="fn29" type="footnote" n="29">Zur Gesamtausgabe der Werke <persName ref="p4091">Zwinglis</persName> s. oben <ref target="file12116">Nr. 2069</ref>, Anm. 30.</note>, papę fulminis illius trisulci<note xml:id="fn30" type="footnote" n="30">Das "fulmen trisulcum", der dreizackige Blitz, ist Attribut Jupiters; vgl. etwa <hi>Ovid,</hi> Metamorphosen, 2, 848f ("trisulcis ... ignibus"). -"pape" ist als Dativ aufzufassen: der für den Papst bestimmte Blitz.</note>, carebo.</s>
					<s n="25" xml:lang="la" ana="salute">Vale <lb xml:id="p1z44"/>in domino et salutem ex me dicito viris incomparabilibus dominis <lb xml:id="p1z45"/><persName ref="p8412">Megandro</persName>, <persName ref="p8127">Pellicano</persName>, <persName ref="p8171">Bibliandro</persName>, <persName ref="p1283">Gesnero</persName> et <persName ref="p8011">Gvaltero</persName>, cuius <lb xml:id="p1z46"/>delectabilem venam in carmine<note xml:id="fn31" type="footnote" n="31">Wohl "<persName ref="p8011">Rodolphus Gvaltherus</persName> <placeName ref="l587">Tigurinus</placeName> de quinque primariis evangelicae doctrinae instauratoribus"; s. oben <ref target="file12261">Nr. 2214</ref>. 24f und Anm. 16.</note> vidi et ob id, antea dilectus, <lb xml:id="p1z47"/>mihi dilectior erit.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">Celerrime, 18. augusti 1545.</s>
					<s n="27" xml:lang="la">Ignosce oscitantię<note xml:id="fn32" type="footnote" n="32">Fahrlässigkeit; s. <hi>Hoven,</hi> s.v.</note>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf f. 164a,v.:]</note>
					<s n="28" xml:lang="la"><pb/><lb xml:id="p4z1"/>Incomparabili viro domino <persName ref="p495">Henricho <lb xml:id="p4z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> ecclesię <lb xml:id="p4z3"/>anthistiti vigilantissimo, amico et <lb xml:id="p4z4"/>fratri perpetuo.</s>
				</p>
