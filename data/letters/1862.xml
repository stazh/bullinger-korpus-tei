	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ad literas tuas per dominum Rostium redditas, nihil aliud respondeo, quam quod <lb xml:id="p1z2"/>inconsulto pro <persName ref="p20383">Iona</persName> meo apud te institi et, nisi id ipsum boni <lb xml:id="p1z3"/>viri suasissent, nunquam ausus fuissem ea a te contendere.</s>
					<s n="3" xml:lang="la">Tu abunde <lb xml:id="p1z4"/>apud me excusatus es.</s>
					<s n="4" xml:lang="la">Quid autem de <persName ref="p20383">Iona</persName> statuero, iam incertus <lb xml:id="p1z5"/>sum; ipse enim ex vesica vehementer laborare cępit, ita ut <lb xml:id="p1z6"/>ipsi non parum timeam.</s>
					<s n="5" xml:lang="la">Quodsi intra quatriduum non melius <lb xml:id="p1z7"/>habuerit, eum ad matrem suam mittere decrevi, donec revalue<lb xml:id="p1z8"/>rit aut aliud dei nutu ipso procuratum fuerit.</s>
					<s n="6" xml:lang="la">Id <lb xml:id="p1z9"/>porro ita actum preripiet mihi occasionem modo ad te veniendi.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Dabo autem operam, ut cum <persName ref="p20383">Iona</persName> hac estate adhuc te invisam.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/>Marggravius <persName ref="p7882">episcopum</persName> <placeName ref="l1030">Herbipolensem</placeName> mediocri clade affecit, <lb xml:id="p1z12"/><placeName ref="l1703">Bambergam</placeName> cepit et <placeName ref="l361">Norinbergensibus</placeName> magnum terrorem incussit.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p18250">Dux Mauritius</persName> properat ad <placeName ref="l2481">Svevos</placeName> et <placeName ref="l3537">Silvę Hercinia</placeName> <lb xml:id="p1z14"/>adiacentes.</s>
					<s n="10" xml:lang="la">Ego propter imminentia pericula a <lb xml:id="p1z15"/>meis domum revocor, quos tamen parum iuvare possum.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z16"/>Videte et cavete, precor, vos <placeName ref="l862">Helvecii</placeName>, ne olim talia et <lb xml:id="p1z17"/>graviora quam nobis eveniant: coram dicerem apertius, si <lb xml:id="p1z18"/>dominus concederet.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z19"/>Munus tuum chartaceum est mihi super aurum et topazion; <lb xml:id="p1z20"/>incepi enim librum heri legere nec desinam, quin lectus et <lb xml:id="p1z21"/>relectus sit.</s>
					<s n="13" xml:lang="la">Dominus te servet ecclesię sę.</s>
					<s n="14" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Vale.</s>
					<s n="16" xml:lang="de"><lb xml:id="p1z22"/>3. maii 1553.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z23"/>Tuus <persName ref="p8354">Georgius Lętus</persName> etc.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Incomparabili viro domino <lb xml:id="p2z3"/><persName ref="p495">Henricho Bullingero</persName> etc. <lb xml:id="p2z4"/>amico et fratri unice dilecto<lb xml:id="p2z5"/>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>