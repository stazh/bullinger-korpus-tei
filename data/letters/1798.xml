	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Literas tuas ad d. <persName ref="p8121">Christophorum Montium</persName>, <persName ref="p3207">Anglorum regis</persName> legatum, <lb xml:id="p1z2"/>scriptas, vir clarissime, iam dudum per civem <placeName ref="l28">Basiliensem</placeName> <lb xml:id="p1z3"/><placeName ref="l491">Argentinam</placeName> miseram, qui hac ipsa ad nos rediens die eas <lb xml:id="p1z4"/>retulit atque <persName ref="p8121">Montium</persName> diem iam obiisse aut, <lb xml:id="p1z5"/>cum literas curare vellet.</s>
					<s n="3" xml:lang="la">Eas igitur nunc tibi etiam remitto, <lb xml:id="p1z6"/>cum alias etiam insertas esse credam.</s>
					<s n="4" xml:lang="la">Accepimus hodie <lb xml:id="p1z7"/><placeName>Hedinem</placeName>, oppidum regis <placeName ref="l832">Galliae</placeName>, ante aliquot menses i<lb xml:id="p1z8"/>mperatori proditione traditum iam a <placeName>Gallo</placeName> <placeName ref="l862">Helveticorum</placeName> <lb xml:id="p1z9"/>auxilio deditione cum arce receptum esse magno <lb xml:id="p1z10"/>Caesaris incommodo, qui iam relicta <placeName ref="l322">Metensi</placeName> obsidione <lb xml:id="p1z11"/><placeName ref="l168">Gandavum</placeName> in patriam properare dicitur.</s>
					<s n="5" xml:lang="la">Regis adventus <lb xml:id="p1z12"/>propediem <placeName ref="l378">Lutetiae Parisiorum</placeName> expectatur.</s>
					<s n="6" xml:lang="la">Dux <persName ref="p2916">Schertlinus</persName>, <lb xml:id="p1z13"/>qui octo militaria signa abduxit, iam graviter decumbens <lb xml:id="p1z14"/>vix quatuor adhuc signa, sub quibus circiter 600 militant, <lb xml:id="p1z15"/>habere fertur, unde colligimus non tam imperatorem <lb xml:id="p1z16"/>quam Gallum magnam militum in tanta hiemis improbitate <lb xml:id="p1z17"/>iacturam fecisse, cum tamen nullibi aperto Marte sit <lb xml:id="p1z18"/>pugnatum.</s>
					<s n="7" xml:lang="la">Sed quicquid delirant reges, plectuntur <persName>Achivi</persName>.</s>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z19"/>Vale.</s>
					<s n="9" xml:lang="la"><placeName ref="l28">Basileae</placeName> septimo calendas februarii anno 1553.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/>Tuus <persName ref="p8406">Conradus Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> pastori omnium <lb xml:id="p2z4"/>vigilantissimo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
