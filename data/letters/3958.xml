	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuas recepi literas scriptas 6. huius mensis.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">De comitiis <placeName ref="l18">Augustanis</placeName> <lb xml:id="p1z2"/>ex vestro legato intellexisti et vidisti propositionem legatorum regis; responsum mitto.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z3"/>Iis, que de pace vulgo dictitant, te non commoveri scio, cum dominus <lb xml:id="p1z4"/>regnet et moderetur omnia.</s>
					<s n="5" xml:lang="la">Spero me brevi te visurum et colloquemur.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z5"/>Interim bene vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Salutabis d. d. <persName ref="p8111">Martirem</persName>, <persName ref="p8011">Galterum</persName>, et qui de me percunctabuntur.</s>
					<s n="8" xml:lang="la"><placeName ref="l760">S<lb xml:id="p1z6"/>ol[uturi]</placeName> 18. maii.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z7"/>Tuus ex animo, quem nosti.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinę</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
				</p>
				<p>
					<note>[von anderer Hand.]</note>
				</p>
			</div>
		</body>
	</text>
