	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p714">C[aelius] S[ecundus] C[urio]</persName> per Christum <lb xml:id="p1z2"/>Iesum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">S. P. D.</s>
					<s n="3" xml:lang="la">Sermonem De coena domini, clarissime simul et <lb xml:id="p1z3"/>charissime <persName ref="p495">Bullingere</persName>, postridie paschę accepi; <lb xml:id="p1z4"/>nam audio, antequam mihi redderetur, a quodam <lb xml:id="p1z5"/>diu retentum fuisse.</s>
					<s n="4" xml:lang="la">Legi et probo, quid dico <lb xml:id="p1z6"/>probo, imo totis ulmis accipio tibique gratias <lb xml:id="p1z7"/>ago, quod video te in me amando perseverare <lb xml:id="p1z8"/>nullisque absterreri vocibus et sermunculis ab <lb xml:id="p1z9"/>amicitia nostra veteri conservanda.</s>
					<s n="5" xml:lang="la">Quodsi ego <lb xml:id="p1z10"/>rarius idem erga te facio neque negligentiae <lb xml:id="p1z11"/>neque amoris parvitati ascribes, sed reverentiae <lb xml:id="p1z12"/>potius erga te meae et pudori, deinde etiam <lb xml:id="p1z13"/>occupationibus tuis gravissimis et innumeris, <lb xml:id="p1z14"/>quibus scio te in isto tuo amplissimo et sanctissimo <lb xml:id="p1z15"/>munere pene obrui.</s>
					<s n="6" xml:lang="la">Amo enim te et observo <lb xml:id="p1z16"/>memoriamque tuam apud me tuis maximis meritis <lb xml:id="p1z17"/>immortalem conservo.</s>
					<s n="7" xml:lang="la">Quare et de te, de uxore <lb xml:id="p1z18"/>sanctissima, de liberis et propinquis, qui [quͦi] et quam <lb xml:id="p1z19"/>prospere agant, ubicunque terrarum sint, nosse <lb xml:id="p1z20"/>aveo.</s>
					<s n="8" xml:lang="la">Facies igitur mihi rem longe gratissimam, <lb xml:id="p1z21"/>si me de his certiorem feceris, praesertim de iis, qui <lb xml:id="p1z22"/>peregre adhuc degunt in <placeName ref="l822">Germania</placeName> <placeName ref="l2472">Poloniave</placeName>, <lb xml:id="p1z23"/>ecquid studeant, proficiant, quod studiorum genus, <lb xml:id="p1z24"/>si fas est, sequantur.</s>
					<s n="9" xml:lang="la">Hic nihil aliud <lb xml:id="p1z25"/>est novi, nisi quod opinio illa, de qua alias, sensim <lb xml:id="p1z26"/>gliscit iisdem, qui alias, procurantibus.</s>
					<s n="10" xml:lang="la">Principiis <lb xml:id="p1z27"/>obsta, inquit ille; sero medicina paratur<note xml:id="fn1" type="footnote" n="1"><hi>Ovid,</hi> Remedium amoris 91(f?) (<bibl source="b473">Otto</bibl> 287, Nr. 1470).</note>; id <lb xml:id="p1z28"/>sentimus aliquando.</s>
					<s n="11" xml:lang="la" ana="salute">Vale et mihi meeque <lb xml:id="p1z29"/>uxoris nomine tuam tuosque omnes saluta amantissime.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z30"/><placeName ref="l28">Basileae</placeName> 14. calendas maii 1558.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z31"/>Tuus qui semper <persName ref="p714">C[ae<lb xml:id="p1z32"/>liu<lb xml:id="p1z33"/>s] S[ec<lb xml:id="p1z34"/>undus</persName>] sub<lb xml:id="p1z35"/>scr<lb xml:id="p1z36"/>ipsit.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo atque optimo <lb xml:id="p2z2"/>viro d. <persName ref="p495">Hey[nricho] <lb xml:id="p2z3"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z4"/><placeName ref="l587">Ti[gurinae]</placeName> antistiti <lb xml:id="p2z5"/>vigilantissimo, suo <lb xml:id="p2z6"/>domino colendissimo.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
