	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Marcii 26. cum omnibus meis <placeName ref="l28">Basilęam</placeName> appuli, utinam <lb xml:id="p1z3"/>bonis (ut aiunt) avibus.</s>
					<s n="3" xml:lang="la">Quę mihi proximis literis rescripseris, <lb xml:id="p1z4"/>mente teneo, nempe quod multis egeris argumentis <lb xml:id="p1z5"/>iisque sane fortibus, ne me iuri civili manciparem.</s>
					<s n="4" xml:lang="la">Sed que <lb xml:id="p1z6"/>persuasio possit adferri contra necessitatem, non video.</s>
					<s n="5" xml:lang="la">Nusquam <lb xml:id="p1z7"/>est auxilium ab aliquo iam anno in dimidio.</s>
					<s n="6" xml:lang="la">Derelinquor, <lb xml:id="p1z8"/>fastidior, conculcor passim ut advena et peregrinus, quę ego <lb xml:id="p1z9"/>profecto ab evangelicis viris nunquam expectassem.</s>
					<s n="7" xml:lang="la">Tibi magnas <lb xml:id="p1z10"/>habeo gratias, qui tuum obtuleris patrocinium, quo isthic recipere<lb xml:id="p1z11"/>r in civitatem, quod mihi magni loco beneficii esset, <lb xml:id="p1z12"/>si quid praeterea isthinc sperandum foret.</s>
					<s n="8" xml:lang="la">Non sum adeo pecu<lb xml:id="p1z13"/>niosus, ut meo me succo (quod aiunt) possim diu alere, <lb xml:id="p1z14"/>etiamsi de sumptibus permulta detraham.</s>
					<s n="9" xml:lang="la">Quamobrem, ut <lb xml:id="p1z15"/>illud <persName ref="p4863">Fuggeri</persName> beneficium recipiam, necesse est.</s>
					<s n="10" xml:lang="la">Si quid tamen <lb xml:id="p1z16"/>interea ecclesiastici aut scholastici negocii occurrerit, recipiam.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z17"/>Potero fortasse <persName ref="p4863">Fuggero</persName> sua restituere nec moleste laturum <lb xml:id="p1z18"/>scio; nihil enim ille indigens mei.</s>
					<s n="12" xml:lang="la">Te rogo, si me hinc, <lb xml:id="p1z19"/>hoc est, ab iuris studio retrahere potes, non verbis, sed factis, <lb xml:id="p1z20"/>ne intermittas; mallem enim hoc, quicquid superest ętatis <lb xml:id="p1z21"/>in alio negocio conterere.</s>
					<s n="13" xml:lang="la">Hęc cursim et vesperi, alias <lb xml:id="p1z22"/>plura.</s>
					<s n="14" xml:lang="la" ana="salute">Bene vale, mi frater, et me commendatum habe.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Ex <lb xml:id="p1z23"/><placeName ref="l28">Basilęa</placeName> 30. marcii 1551.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p8124">Thomas Naog[eorgus</persName>] <lb xml:id="p1z25"/>tuus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo atque humanissimo <lb xml:id="p2z2"/>viro d. <persName ref="p495">Heinricho Bulli[nger<lb xml:id="p2z3"/>o]</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae doctori.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>