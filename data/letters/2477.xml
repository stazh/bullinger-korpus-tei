	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Hac transiens <placeName ref="l294">Locarnensium</placeName> christianorum nuncius contulit <lb xml:id="p1z2"/>mecum de negocio; inter alia dixit se habere in mandatis, <lb xml:id="p1z3"/>ut christiani alium mitterent statim ad dominos <placeName ref="l587">Tigurinos</placeName><lb xml:id="p1z4"/>, [qui] quicquid actum in comitiis esset, <placeName ref="l294">Locarnum</placeName> refferet.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z5"/>Sed quia longum est iter perdifficileque, decrevimus inter nos, <lb xml:id="p1z6"/>hinc ut ille <placeName ref="l294">Locarnum</placeName> quam citius accederet, ego vero ad <lb xml:id="p1z7"/>te scriberem hunc in modum, nempe si videris illorum rem <lb xml:id="p1z8"/>perditum iri, velis propriis sumptibus nostris nuncium <lb xml:id="p1z9"/>huc curiam mittere ad <persName ref="p8359">Filippum Gallicium</persName>, cum quo ego <lb xml:id="p1z10"/>egi, ut et ipse ad me <placeName ref="l93">Clavenam</placeName> proprium nuncium mitteret <lb xml:id="p1z11"/>cum literis tuis.</s>
					<s n="3" xml:lang="la">Hoc autem dicco, si cognoveris <placeName ref="l294">Locar<lb xml:id="p1z12"/>nensibus</placeName> periculum vitę aut naufragium substantie totius <lb xml:id="p1z13"/>imminere, sin minus, literas tuas solito more mittas ad <lb xml:id="p1z14"/><persName ref="p8359">Gallicium</persName>, qui mihi eas reddendas curabit.</s>
					<s n="4" xml:lang="la">Quicquid autem <lb xml:id="p1z15"/>exposueris, si opus fuerit, hoc meo nomine a <lb xml:id="p1z16"/>domino <persName>Sebastiano</persName> petes.</s>
					<s n="5" xml:lang="la">Inclusas autem domino <persName ref="p8101">Lelio</persName> reddendas <lb xml:id="p1z17"/>curare digneris.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale, mi clarissime vir et domine <lb xml:id="p1z18"/>colendissime.</s>
					<s n="7" xml:lang="la"><placeName ref="l98">Curię</placeName> pridie kalendas decembris 1554.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z19"/>Dominationis et humanitatis tę deditissimum <lb xml:id="p1z20"/>mancipium <persName ref="p8168">Antonius Marius Besutus</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietate, doctrina ac moribus <lb xml:id="p2z2"/>clarissimo viro domino <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bulingero</persName>, antistiti <placeName ref="l587">Tigurino</placeName>, <lb xml:id="p2z4"/>domino suo colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
