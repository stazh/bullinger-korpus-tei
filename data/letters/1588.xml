	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Doleo <lb xml:id="p1z4"/>valde bonis viris hoc molestiae exhibendum, <lb xml:id="p1z5"/>vir omnibus modis mihi colendissime, quod in tam truc<lb xml:id="p1z6"/>ulentis cruentissimi belli principiis in tale mittuntur concilium, unde nemo bonus aliqui<lb xml:id="p1z7"/>d boni speraverit.</s>
					<s n="3" xml:lang="la">Praesidet in eo pontifex, merum ibi <lb xml:id="p1z8"/>obtinet imperium; consident enim coniurati et <lb xml:id="p1z9"/>in verba pontificis iurati.</s>
					<s n="4" xml:lang="la">Bullis aeditis testati <lb xml:id="p1z10"/>sunt, cur coierit concilium: ut extirpentur <lb xml:id="p1z11"/>haereses.</s>
					<s n="5" xml:lang="la">Olim libris et edictis evulgatis professi <lb xml:id="p1z12"/>sunt nostram doctrinam esse haeresim illam ven<lb xml:id="p1z13"/>enatam, nos vero esse haereticos illos orbis christiani <lb xml:id="p1z14"/>perturbatores.</s>
					<s n="6" xml:lang="la">Vidit hic orbis decreta <lb xml:id="p1z15"/>7 sub Paulo aedita; norunt omnes ea decreta <lb xml:id="p1z16"/>per continuationem esse ratificata; scribunt episcopi <lb xml:id="p1z17"/>et viri magni iniquum esse, ut audiantur haeretici, <lb xml:id="p1z18"/>nisi recantare et in gremium sanctae matris <lb xml:id="p1z19"/>ecclesiae irruere velint.</s>
					<s n="7" xml:lang="la">Notum est lippis et ton<lb xml:id="p1z20"/>soribus<note xml:id="fn1" type="footnote" n="1"><hi>Horaz,</hi> Sat., 1, 7, 3 (u.a.?).</note>, qui coierint <placeName ref="l1107">Tridenti</placeName>, quales hactenus <lb xml:id="p1z21"/>fuerint et quid vel hodie ab eis fiat, et in hoc <lb xml:id="p1z22"/>et in tale et in tam pudendum et in probrosum <lb xml:id="p1z23"/>et factiosum et cruentem proditoriumque concilium <lb xml:id="p1z24"/>mittuntur adhuc viri boni.</s>
					<s n="8" xml:lang="la">Vocavit pon<lb xml:id="p1z25"/>tificis <pb/><lb xml:id="p2z1"/>orator etiam doctores Hel<lb xml:id="p2z2"/>veticarum ecclesiarum.</s>
					<s n="9" xml:lang="la">Nos pluribus <lb xml:id="p2z3"/>ea exposuimus, quae iam tibi paucis recen<lb xml:id="p2z4"/>sui; protestati sumus nos nolle illuc <lb xml:id="p2z5"/>ire, dominum tentare et veritatem <lb xml:id="p2z6"/>dei ridendam prebere professis hostibus evangelii; <lb xml:id="p2z7"/>obtulimus liberam collationem in loco ali<lb xml:id="p2z8"/>quo aequo.</s>
					<s n="10" xml:lang="la">Addimus Christum et apostolos docuisse, <lb xml:id="p2z9"/>sed noluisse abire in concilium pontific<lb xml:id="p2z10"/>ale, Christum semel in hoc abductum, mox in <lb xml:id="p2z11"/>crucem esse adactum, apostolos in conciliis <lb xml:id="p2z12"/>esse caesos, <persName>Paulum</persName> maluisse appellare <lb xml:id="p2z13"/>ad Neronem quam venire in concilium <lb xml:id="p2z14"/>Hierosolymitanum.</s>
					<s n="11" xml:lang="la">Miseret ergo me bon<lb xml:id="p2z15"/>orum virorum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Qui[c]quid delyrant reges, <lb xml:id="p2z16"/>plectuntur Achivi.</s>
					<s n="13" xml:lang="la">Quod principes <lb xml:id="p2z17"/>et magnates in comitiis impe<lb xml:id="p2z18"/>ratoriis peccant etc., <foreign xml:lang="de">muͤßend die armen pfaffen buͤ<lb xml:id="p2z19"/>ßen oder wider ze rächt bringen.</foreign></s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z20"/>Dominus concedat optimis illis fratribus <lb xml:id="p2z21"/>nostris fidem, patientiam et constantiam.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z22"/>Tanquam oves ad lanienam du<lb xml:id="p2z23"/>cuntur; iam completur: Ecce, mitto vos ve<lb xml:id="p2z24"/>luti oves in medium luporum.</s>
					<s n="16" xml:lang="la">Tem<lb xml:id="p2z25"/>pus ergo, ut condoleamus et oremus pro fratribus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p3z1"/>Ex <placeName ref="l830">Anglia</placeName> literas accepi 8. februarii scriptas <lb xml:id="p3z2"/><placeName ref="l376">Oxonii</placeName>.</s>
					<s n="18" xml:lang="la">Inter alia comemorant amici tractari <lb xml:id="p3z3"/>iam de seria et iusta reformatione r<lb xml:id="p3z4"/>ecipienda per universam <placeName ref="l830">Angliam</placeName> et <placeName ref="l2665">Hyberniam</placeName>; <lb xml:id="p3z5"/>deputatos esse ei negotio singulariter <lb xml:id="p3z6"/><placeName ref="l1255">Cantuariensem</placeName>, <placeName ref="l136">Elyensem</placeName>, <placeName ref="l296">Londoniensem</placeName>, <persName ref="p8111">Martyrem</persName>, <lb xml:id="p3z7"/><persName ref="p672">Coxum</persName> et nescio quos alios viros bonos.</s>
					<s n="19" xml:lang="la">Addu<lb xml:id="p3z8"/>nt decollatum esse iis diebus ducem <placeName ref="l2671">Somer<lb xml:id="p3z9"/>setsi</placeName>.</s>
					<s n="20" xml:lang="la">Utinam non inde aliquid turbarum <lb xml:id="p3z10"/>exoriatur.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Dominus servet regnum illud et illuminet luce evangelii fili<lb xml:id="p3z11"/>i sui.</s>
					<s n="22" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="farewell">Vale.</s>
					<s n="24" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 6. martii anno 1552.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">Clarissimo viro d. d. <persName ref="p8121">C<lb xml:id="p3z12"/>hristophoro Montio</persName>, serenissimi <persName ref="p3207">regis Angliae</persName> sec<lb xml:id="p3z13"/>retario, domino suo colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>