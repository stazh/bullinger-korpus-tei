			<zone xml:id="p4z6-0" points="1862,1756 1894,1746 1911,1758 1957,1752 1972,1740 2001,1752 2019,1742 2099,1789 2150,1783 2150,1718 2119,1721 2060,1695 2017,1714 1862,1699">1869,1738 1894,1734 1920,1733 1946,1732 1972,1732 1998,1732 2023,1732 2049,1734 2075,1735 2101,1735 2127,1734 2153,1732</zone>
