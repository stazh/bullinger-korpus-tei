	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Venit ad me nunc cursor hic <placeName ref="l587">Tigurinus</placeName>, tempore <lb xml:id="p1z2"/>satis incommodo, quum intra horam suggestum <lb xml:id="p1z3"/>conscendere debeam.</s>
					<s n="3" xml:lang="la">Parce ergo, si sim brevior.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Tuas <persName>Anglo</persName> cuidam, ut scribis, datas non <lb xml:id="p1z5"/>accepi, quo abierit ille nescio: inquiram <placeName ref="l280">Lau<lb xml:id="p1z6"/>sannae</placeName> et <placeName ref="l167">Genevae</placeName>, si forte quo ierit, aut ubi r<lb xml:id="p1z7"/>eliquerit literas, indagare queam.</s>
					<s n="5" xml:lang="la">Quamvis, si nebulo <lb xml:id="p1z8"/>sit, ut videtur, abstulisse eum illas secum facile <lb xml:id="p1z9"/>cogitari possit.</s>
					<s n="6" xml:lang="la">Dolet mihi hoc maximopere.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Sed quid agamus?</s>
					<s n="8" xml:lang="la">Cautius deinceps utemur <lb xml:id="p1z11"/>illis hominibus.</s>
					<s n="9" xml:lang="la">Tibi non minus ingentes ago <lb xml:id="p1z12"/>gratias pro munere in illis literis uxori me<lb xml:id="p1z13"/>ae <lb xml:id="p1z14"/>mis<lb xml:id="p1z15"/>so<lb xml:id="p1z16"/>, quam <lb xml:id="p1z17"/>si i<lb xml:id="p1z18"/>llu<lb xml:id="p1z19"/>d a<lb xml:id="p1z20"/>ccep<lb xml:id="p1z21"/>iss<lb xml:id="p1z22"/>emus<lb xml:id="p1z24"/>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/>Captivos <placeName ref="l378">Parisienses</placeName> nondum esse dimissos, sed graviorem <lb xml:id="p1z26"/>inquisitionem commissam esse tribus cardinalibus <lb xml:id="p1z27"/>affirmant nobis <persName ref="p8033">Beza</persName> et <persName ref="p4440">Budaeus</persName>, qui heri hic fuerunt <lb xml:id="p1z28"/><placeName ref="l157">Francofurtum</placeName> profecturi et a principibus intercessionem <lb xml:id="p1z29"/>pro illis petituri.</s>
					<s n="11" xml:lang="la"><persName ref="p8033">Beza</persName> a senatu veni<lb xml:id="p1z30"/>am abeundi petiit quae illi data est, ea conditione, <lb xml:id="p1z31"/>ne quidquam aliud agat quam captivorum n<lb xml:id="p1z32"/>egotium.</s>
					<s n="12" xml:lang="la">Videntur enim omnino denuo aliud agere velle.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z33"/>Nos senatum huius obiter admonuimus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Itaque graves <lb xml:id="p1z34"/>illi additae sunt minae (nec erunt illae inanes) <lb xml:id="p1z35"/>si tertio compertum fuerit, illum aliquid aliud agere aut <lb xml:id="p1z36"/>moliri.</s>
					<s n="15" xml:lang="la">Nos quoque ipsi illum severiter et corripuimus <lb xml:id="p1z37"/>propter praeterita, et ne quid tale deinceps com<lb xml:id="p1z38"/>mittat admonuimus: alias enim nos non posse am<lb xml:id="p1z39"/>plius dissimulare.</s>
					<s n="16" xml:lang="la">Hoc se facturum recepit.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z40"/><placeName ref="l41">Bernae</placeName>, dominica invocavit 1558.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z41"/><persName ref="p8018">I. Hallerus</persName> tuus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Clarissimo viro d. <lb xml:id="p1z42"/><persName ref="p495">Heinrycho Bullingero</persName> <placeName ref="l587">Tigurinae</placeName> ecclesiae pastori fi<lb xml:id="p1z43"/>delissimo domino et comp<lb xml:id="p1z44"/>atri s<pb/><lb xml:id="p2z1"/>uo carissimo col<lb xml:id="p2z2"/>endissim<lb xml:id="p2z3"/>oque.</s>
				</p>
			</div>
