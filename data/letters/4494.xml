	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>P. Trę tuę plurimum me delectarunt
					<lb xml:id="p1z2"/>et hoc potissimum nomine, quod hinc tuum
					<lb xml:id="p1z3"/>roga me singulare strdium, amore et benin
					<lb xml:id="p1z4"/>envolentiam cognoscere licuit, qui infinitis
					<lb xml:id="p1z5"/>occupatus negotiis tantu tibi ad me scriber
					<lb xml:id="p1z6"/>otium sumpsius. Utinam vicissim.
					<lb xml:id="p1z7"/>tibi, quod gratum sit praestare possim.
					<lb xml:id="p1z8"/>turbium plurimum amo et colo propter
					<lb xml:id="p1z9"/>hominis et sunceritatem et constantiam
					<lb xml:id="p1z10"/>dignus meliori fortuna; miseret me illiu
					<lb xml:id="p1z11"/>qui iam emeritus miles iude donandum
					<lb xml:id="p1z12"/>erat in tantam calamitatem praecipitari
					<lb xml:id="p1z13"/>Ego, quantum in me est, nihil pretrmitti
					<lb xml:id="p1z14"/>quod ad ipsius sublivationem facere
					<lb xml:id="p1z15"/>potest. Dominus confortet illum  equo animo frara
					<lb xml:id="p1z16"/>quemadmodum nupe cum una essemus,
					<lb xml:id="p1z17"/>receperam me velle Nicelaum a Diesbu
					<lb xml:id="p1z18"/>certiorem facere, si uspiam fieri posset
					<lb xml:id="p1z19"/>ante comcitias Eremitanas te conveniret,
					<lb xml:id="p1z20"/>quod quam potui diligenter literis curavi.
					<lb xml:id="p1z21"/>illas recepuit aut ad te venerit
					<lb xml:id="p1z22"/>non constat hoc eo scribo ne videar
					<lb xml:id="p1z23"/>sponsor malę fidu. De eremo ni
					<lb xml:id="p1z24"/>adhuc, dum nos quicquam certi accepr
					<lb xml:id="p1z25"/>nec est, ut nobis quicquam boni aut
					<lb xml:id="p1z26"/>Placati de illis hominibus tantis emcesi
					<lb xml:id="p1z27"/>tenibus polliceamur. dominus det illis viram
					<lb xml:id="p1z28"/>lucem, ut nobis gratiam, ut illorum et
					<lb xml:id="p1z29"/>prvicatia et insolentia exreceamur.
					<lb xml:id="p1z30"/>ad omne opus bonum, quo tandem et
					<pb/>
					<lb xml:id="p2z1"/>ipsi resipiscant. Videmus ferme ubique
					<lb xml:id="p2z2"/>terarum, queadmodum etiam tua ad nos
					<lb xml:id="p2z3"/>epistola testatur, foelicem evangelii
					<lb xml:id="p2z4"/>proventuri et domnabili dei benificii
					<lb xml:id="p2z5"/>etspiritus Trngia contra varios Sathane
					<lb xml:id="p2z6"/>et mundi conatus unitate succeess.
					<lb xml:id="p2z7"/>Dominus largiatici nobis per suam gratiam
					<lb xml:id="p2z8"/>ut misiricordiam, ut quibus rationibus
					<lb xml:id="p2z9"/>apud primam Christi ecclesiam evangelica
					<lb xml:id="p2z10"/>veritas semper et propugata et Lofi
					<lb xml:id="p2z11"/>mata est, iisdem apud nos conscivetur
					<lb xml:id="p2z12"/>inque inter nos res denuo ad manus
					<lb xml:id="p2z13"/>veniat. Nos adhuc dum in oti
					<lb xml:id="p2z14"/>agimus et rursum spes offertur
					<lb xml:id="p2z15"/>corpositiois cum Sautiiensi animus
					<lb xml:id="p2z16"/>me fallit, nisi ille huiusmodi praestixi
					<lb xml:id="p2z17"/>nos cucuvenire conatur. Bene consu
					<lb xml:id="p2z18"/>deo, vir oenatissimo nostras ineptias
					<lb xml:id="p2z19"/>quod diutius te obtundere ausus sum
					<lb xml:id="p2z20"/>Bene vale cum uxore tua honestissimo et
					<lb xml:id="p2z21"/>tota familia. Statim Brugis 1. d
					<lb xml:id="p2z22"/>octobris anno 1560.
					<lb xml:id="p2z23"/>Herrman von Haltys
					<pb/>
					<lb xml:id="p3z1"/>
					<lb xml:id="p3z2"/>uxelica
					<lb xml:id="p3z3"/>elu.
					<lb xml:id="p3z4"/>r
					<lb xml:id="p3z5"/>novo
					<lb xml:id="p3z6"/>Stipii.
					<lb xml:id="p3z7"/>Consi.
					<lb xml:id="p3z8"/>et
					<lb xml:id="p3z9"/>Shum.
					<lb xml:id="p3z10"/>et
					<lb xml:id="p3z11"/>din.
					<lb xml:id="p3z12"/>B.
					<pb/>
					<lb xml:id="p4z1"/>Pietate et doctrina clarissimo
					<lb xml:id="p4z2"/>virod. Heinrico Bullingero,
					<lb xml:id="p4z3"/>ecclesiae Thigurini
					<lb xml:id="p4z4"/>ecclesiasti, domino et amico
					<lb xml:id="p4z5"/>colendissimo.
				</p>
