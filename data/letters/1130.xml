	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Rursus pergo tibi esse molestus, domine <lb xml:id="p1z2"/>et frater colende et chare.</s>
					<s n="3" xml:lang="la">Venit enim <lb xml:id="p1z3"/>ad nos exul hic <persName ref="p20919">Franciscana</persName> cuculla adhuc, <lb xml:id="p1z4"/>ut vides, tectus, elapsus ex <placeName ref="l832">Galliis</placeName>, inquilinus <lb xml:id="p1z5"/><placeName ref="l1290">Andegavensis</placeName>.</s>
					<s n="4" xml:lang="la">Videtur esse homo minime <lb xml:id="p1z6"/>malus; instruximus eum viatico.</s>
					<s n="5" xml:lang="la">Digneris <lb xml:id="p1z7"/>ergo propter Christum ipsum recipere et iuvare, <lb xml:id="p1z8"/>praeterea commendare <placeName ref="l491">Argentoratensibus</placeName>, nec <lb xml:id="p1z9"/>dubito, quin opus sis facturum deo acceptum.</s>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z10"/>Vale et nos semper ama; te ac <lb xml:id="p1z11"/>tuos amamus ex animo.</s>
					<s n="7" xml:lang="la">Summa festinatione <lb xml:id="p1z12"/><placeName ref="l587">Tiguri</placeName> 1551.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p8418">Osvaldo <lb xml:id="p2z2"/>Myconio</persName>, <placeName ref="l28">Basiliensis</placeName> <lb xml:id="p2z3"/>ecclesiae fido pastori, domino <lb xml:id="p2z4"/>colendo et fratri <lb xml:id="p2z5"/>charissimo suo.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
