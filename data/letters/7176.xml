	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>17 octobris abs te literas accepi, item 16 maii; pro quibus et pro doctissimis tuis in <lb xml:id="p1z2"/>Esaiam homiliis ago gratias quam possum maximas.</s>
					<s n="2" xml:lang="la">Superiori estate obiit <persName>Nicolaus <lb xml:id="p1z3"/>Carvilius</persName>, initio huius mensis <persName>Robertus Beamundus</persName>, collegii S.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Trinitatis in academia <lb xml:id="p1z4"/><placeName ref="l86">Cantabrigiensi</placeName> praeses.</s>
					<s n="4" xml:lang="la">Illi praeivere; nos, cum domino visum fuerit, sequemur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/><persName>Iohannes Neale</persName> princeps, et maximae authoritatis apud barbaros et inurbanos <placeName ref="l2665">Hyber<lb xml:id="p1z6"/>nos</placeName>, non obstante iureiurando, contra nostram reginam seditionem movit.</s>
					<s n="6" xml:lang="la">Toto hoc anno <lb xml:id="p1z7"/>ab armis non quievit.</s>
					<s n="7" xml:lang="la">Nuper in conflictu occisus est.</s>
					<s n="8" xml:lang="la">Iam spes est, rudes illos <lb xml:id="p1z8"/>et inhumanos et spoliis solum viventes humaniores et urbaniores futuros.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z9"/>Occiso <persName>Henrico</persName> <persName ref="p18212">Scotiae rege</persName>, regina nupsit comiti <placeName>Bothwelliae</placeName>, qui non ita pridem <lb xml:id="p1z10"/>creatus est dux <placeName>Orchadum</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Uxor eius adhuc vivit, foemina nobilissima et <lb xml:id="p1z11"/>optima, ut audio.</s>
					<s n="11" xml:lang="la">Divortium, interveniente papae authoritate, factum est.</s>
					<s n="12" xml:lang="la">Proceres <lb xml:id="p1z12"/>reginam in ordinem coegerunt, et tamen humanissime tractant, non obliti (ut decet) <lb xml:id="p1z13"/>debitae obedientiae.</s>
					<s n="13" xml:lang="la">Dux nescio quo aufugit, invisus fere omnibus, eo quod suum <lb xml:id="p1z14"/>regem tam crudeliter occiderit: quibus consentientibus id fecerit, non scribam; <lb xml:id="p1z15"/>sed fama mira et horrenda divulgat:</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Fama, malum quo non aliud velocius <lb xml:id="p1z16"/>ullum, Tam ficti pravique tenax, quam nuntia veri.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Principes <placeName ref="l2524">Scotiae</placeName> <lb xml:id="p1z17"/>aliquot habent cohortes, et in omnibus vexillis sive insigniis hanc habent <lb xml:id="p1z18"/>pictam imaginem.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Pingitur viridis et perpulchra arbor, sub qua iacet vir procerus <lb xml:id="p1z19"/>et nudus, et fune strangulatus: prope hunc nudus iuvenis multis confossus vul<lb xml:id="p1z20"/>neribus.</s>
					<s n="17" xml:lang="la">Deinde pingitur puerulus corona aurea redimitus, genibus flexis, manibus <lb xml:id="p1z21"/>in altum sublatis, et haec verba scripta ab eius ore promanantia, "domine, miserere mei, <lb xml:id="p1z22"/>et patris mei sanguinem vindica!"</s>
					<s n="18" xml:lang="la">Per haec designantur rex, famulus, filius.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z23"/>Non possum plura.</s>
					<s n="20" xml:lang="la">Urgent negotia.</s>
					<s n="21" xml:lang="la">Festinat tabellio.</s>
					<s n="22" xml:lang="la">Caetera tibi <persName ref="p8011">Rodolphus <lb xml:id="p1z24"/>Gvaltherus</persName>.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Scripsissem <persName ref="p3988">Wolphio</persName>, <persName ref="p1884">Lavatero</persName>, <persName ref="p8442">Simlero</persName>, <persName>Vonlichio</persName>, <persName ref="p1227">Froschouero</persName>, <lb xml:id="p1z25"/><persName>Iulio</persName>; at non licet: utinam liceret!</s>
					<s n="24" xml:lang="la">Illi in bonam partem interpretentur.</s>
					<s n="25" xml:lang="la">Alias <lb xml:id="p1z26"/>scribam.</s>
				</p>
				<p>
					<s n="26" xml:lang="la" ana="farewell">Vale.</s>
					<s n="27" xml:lang="la" ana="salute">Saluta amicos meos omnes.</s>
				</p>
				<p>
					<s n="28" xml:lang="la">Raptim.</s>
					<s n="29" xml:lang="la"><placeName ref="l299">Ludhamiae</placeName>, iulii 31 <lb xml:id="p1z27"/>1567.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><lb xml:id="p1z28"/>Tuus <persName ref="p2473">Ioannes Parkhurstus</persName>, <placeName ref="l352">Nor<lb xml:id="p1z29"/>.</placeName></s>
				</p>
				<p>
					<s n="31" xml:lang="la"><lb xml:id="p1z30"/>Cl. <pb/><lb xml:id="p2z1"/>viro d. <persName ref="p495">Henrico Bullingero</persName>.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><lb xml:id="p2z2"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
