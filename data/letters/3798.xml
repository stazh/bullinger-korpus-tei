	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z3"/>S. D.</s>
					<s n="2" xml:lang="la">Quidquid novi habui, vir clarissime et amice colendissime, omnia spectabili <lb xml:id="p1z4"/>viro domino <persName ref="p8009">Fabritio</persName> exposui, ut tibi notificaret, qui literas pietatis <lb xml:id="p1z5"/>tuae nona huiusce mensis scriptas mihi reddiderat, ita ut nihil <lb xml:id="p1z6"/>mihi istis meis addendum relictum sit, nisi obsequia mea, <lb xml:id="p1z7"/>commendationes meas et alias huiusmodi officiorum oblationes <lb xml:id="p1z8"/>addi velles.</s>
					<s n="3" xml:lang="la">Pontifex eadem valetudine, qua prius, se habet <lb xml:id="p1z9"/>neque excrescente neque decrescente morbo.</s>
					<s n="4" xml:lang="la">Mira et nova audies ex <lb xml:id="p1z10"/>litteris ipsius domini <persName ref="p8009">Fabritii</persName> de rebus cardinalis Poli, si tamen <lb xml:id="p1z11"/>vera sunt, quę illi exposui eaque a domino nostro <lb xml:id="p1z12"/><persName ref="p629">Cognetio</persName> habeo, unde et eadem et forsitam copiosiora ad pietatem <lb xml:id="p1z13"/>tuam pervenerunt.</s>
					<s n="5" xml:lang="la">Cui me offero deditissimum eamque felicissime <lb xml:id="p1z14"/>in Christo valere opto.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Datum <placeName ref="l98">Curiae</placeName> 16a decembris 1<lb xml:id="p1z15"/>558.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">P[ietatis] t[u<lb xml:id="p1z16"/>ae] obsequentissimus amicus <persName ref="p8306">J. <lb xml:id="p1z17"/>Ja.</persName></s>
				</p>
				<p>
					<s n="8" xml:lang="de"><persName ref="p8306">Decambray</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro pietate et <lb xml:id="p4z2"/>eruditione excellenti domino <lb xml:id="p4z3"/><persName ref="p495">Henrico Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p4z4"/>ecclesiae ministro, domino et amico <lb xml:id="p4z5"/>suo colendo.</s>
					<s n="10" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
