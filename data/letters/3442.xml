	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Praefationem in Decades misi proxime ad fratrem; <lb xml:id="p1z2"/>non enim erat mihi tum ad te, colendissime domine <lb xml:id="p1z3"/>compater, scribendi ocium.</s>
					<s n="3" xml:lang="la">Oro, ut illam corrigas, <lb xml:id="p1z4"/>mutes, deleas, adiicias, detrunces, quicquid <lb xml:id="p1z5"/>visum fuerit.</s>
					<s n="4" xml:lang="la">Titulum autem pro tuo arbitrio fingas.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Vereor Apiarium ante nundinas opus hoc absolvere <lb xml:id="p1z7"/>non posse, si non altero adhuc utatur proelo; vix <lb xml:id="p1z8"/>enim ante calendas ianuarii admedium illius pertinget.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Commentaria tua in Apocalypsin quoque versa iam <lb xml:id="p1z10"/>esse audio; cupit <persName ref="p1227">Froschouerus</persName> ea apud nos <lb xml:id="p1z11"/>imprimi idque sub ipsius nomine, quod quidem <lb xml:id="p1z12"/>Apiario valde erit gratum, nec quisquam hoc impediet.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Expecto usque quid tibi videatur de confessio<lb xml:id="p1z14"/>ne illa altera <persName ref="p8033">Bezae</persName> et <persName ref="p1049">Farelli</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Ego quid sit illud: <lb xml:id="p1z15"/>Panis est <foreign xml:lang="el">κοινωνία</foreign> corporis, id est, res illa quam quum <lb xml:id="p1z16"/>sumimus filius dei vere adest, capere non <lb xml:id="p1z17"/>possum.</s>
					<s n="9" xml:lang="la">Lego quidem <persName>Paulum</persName> panem vocare <foreign xml:lang="el">κοι<lb xml:id="p1z18"/>νωνίαν τοῦ σώματος</foreign>, sed quod filius dei vere quum illum <lb xml:id="p1z19"/>sumimus adsit, non satis intelligo.</s>
					<s n="10" xml:lang="la">Si enim volunt <lb xml:id="p1z20"/>corporaliter illum tum adesse, errant et nos deci<lb xml:id="p1z21"/>pere hac loquendi formula conantur.</s>
					<s n="11" xml:lang="la">Si vero spiritualiter, <lb xml:id="p1z22"/>hoc est gratia et virtute sua illum tum adesse volunt, <lb xml:id="p1z23"/>quum hanc rem sumimus, videntur gratiam symbolo alligare <lb xml:id="p1z24"/>velle.</s>
					<s n="12" xml:lang="la">Quid enim impedit, quominus sic ante et <lb xml:id="p1z25"/>post sumptionem quoque nobis adsit, et non tantum tum q<lb xml:id="p1z26"/>uum sumimus?</s>
					<s n="13" xml:lang="la">Faciunt ergo istis sutelis, ut val<lb xml:id="p1z27"/>de a conventu, quem tantopere urgent, abhorream.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z28"/>Quomodo enim consuletur veritati, si nunc incipiant <lb xml:id="p1z29"/>nostri in tam varias se vertere formas?</s>
					<s n="15" xml:lang="la">Quae <lb xml:id="p1z30"/>vero poterit esse concordia in dubiis istis loquutionibus<lb xml:id="p1z31"/>?</s>
					<s n="16" xml:lang="la">Simplicem esse veritatis orationem gentiles <lb xml:id="p1z32"/>quoque agnoscunt et scribunt autores.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Eam multo <lb xml:id="p1z33"/>magis inter nos obtinere vellem.</s>
					<s n="18" xml:lang="la">Quid vero <lb xml:id="p1z34"/>sperabimus pacis ab istis, qui congestis confessionibus <lb xml:id="p1z35"/>tam pertinaciter opinioni suae inhaerent, sicuti facere <lb xml:id="p1z36"/>videmus <placeName ref="l749">Saxones</placeName>?</s>
					<s n="19" xml:lang="la">Quid, obsecro, putas faciendum, <lb xml:id="p1z37"/>si ad colloquium requiramur?</s>
					<s n="20" xml:lang="la">Satius esset, meo i<lb xml:id="p1z38"/>udicio, ab illo abstinere, quam re infecta ad certa<lb xml:id="p1z39"/>men redire.</s>
					<s n="21" xml:lang="la">Quid vero effici possit, non vi<lb xml:id="p1z40"/>deo.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Novi nihil habemus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Foedus <placeName ref="l167">Genevense</placeName> iam prorsus <lb xml:id="p1z41"/>confirmatum est et instrumenta obsignata.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Expectamus <lb xml:id="p1z42"/>abs te, quid tu habeas.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Mitto iterum terniones <lb xml:id="p1z43"/>aliquot <persName>Decadum</persName>.</s>
				</p>
				<p>
					<s n="26" xml:lang="la" ana="salute">Nostri te omnes salutant, inprimis <lb xml:id="p1z44"/><persName ref="p8417">Musculus</persName>.</s>
					<s n="27" xml:lang="la">Salvam cupio totam domum tuam una <lb xml:id="p1z45"/>cum omni ecclesia.</s>
				</p>
				<p>
					<s n="28" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><placeName ref="l41">Bernae</placeName> <lb xml:id="p1z46"/>21. decembris 1557.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><lb xml:id="p1z47"/><persName ref="p8018">Ioan(nes) Hall(erus)</persName> tuus.</s>
				</p>
				<p>
					<s n="31" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino et com<lb xml:id="p2z4"/>patri suo observandissimo.</s>
					<s n="32" xml:lang="de"><lb xml:id="p2z5"/>M. <persName ref="p495">Heinrych Bullingern</persName> <lb xml:id="p2z6"/>zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
