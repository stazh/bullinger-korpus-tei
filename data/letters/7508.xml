	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto ad te, domine colendissime, schedam ex qua, quae apud nos feruntur <lb xml:id="p1z2"/>et nuper in <placeName ref="l808">Belgio</placeName> gesta sunt, percipies.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Mitto etiam literas d. <persName ref="p8018">Halleri</persName>, <lb xml:id="p1z3"/>quas m. <persName ref="p2899">Schenkius</persName> rogavit ut meis includerem.</s>
					<s n="4" xml:lang="la" ana="salute">Is quoque, te plurimum ut <lb xml:id="p1z4"/>suo nomine salutem, rogavit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Datum <placeName ref="l18">Augustę</placeName> 21. iunii <lb xml:id="p1z5"/>anno 1568.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">R[<lb xml:id="p1z6"/>everentiae] t[uae] studiosissimus <persName ref="p3740">Georgius a Stetten</persName>.</s>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Reverendo, pio atque erudito domino <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, ecclesię <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>antistiti fidelissimo, domino et amico suo <lb xml:id="p2z4"/>colendo.</s>
					<s n="9" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
