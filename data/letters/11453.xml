	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quod me hortaris<note xml:id="fn1" type="footnote" n="1">Ein entsprechender Brief <persName ref="p495">Bullingers</persName> ist nicht vorhanden.</note>, doctissime <persName ref="p495">Bullingere</persName>, ut de <lb xml:id="p1z2"/>puerorum vestrorum apud <persName ref="p8418">Myconium</persName> iam agentium<note xml:id="fn2" type="footnote" n="2"><persName ref="p6755">Konrad Suter</persName>, <persName ref="p2811">Christoph Rotacher</persName> und <persName ref="p8383">Christian Wirth</persName>; vgl. oben <ref target="file11420">Nr. 1377</ref>, Anm.1.</note> studiis <lb xml:id="p1z3"/>deque publicis etiam lectionibus nostris ad <lb xml:id="p1z4"/>te certi aliquid scribam, libenter certe facerem, <lb xml:id="p1z5"/>nisi vel odiosum esset de aliorum vel neglectu <lb xml:id="p1z6"/>vel etiam diligentia nimis curiose inquirere, eorum <lb xml:id="p1z7"/>dico, quorum cura sit aliis commissa, vel si per <lb xml:id="p1z8"/>privatas etiam occupationes mihi, quid ab aliis agatur, <lb xml:id="p1z9"/>inspicere atque observare liberum esset.</s>
					<s n="3" xml:lang="la">Itaque, <lb xml:id="p1z10"/>quas lectiones vel audiant vel non audiant, <lb xml:id="p1z11"/>affirmare citius ac verius ignorare me quam <lb xml:id="p1z12"/>scire possim.</s>
					<s n="4" xml:lang="la">Puto autem <persName ref="p8418">Myconium</persName>, eorum hospitem, ne<lb xml:id="p1z13"/>quaquam ipsos negligere.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Alioqui certe lectiones publicę <lb xml:id="p1z14"/>sunt satis multae: In dialecticis quotidie praelegi<lb xml:id="p1z15"/>t <persName ref="p4208">Hieronymus Rhetus</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p4208">Hieronymus Artulf</persName>.</note>, in iure <persName ref="p164">Amerbachius</persName>, in <lb xml:id="p1z16"/>philosophia Aristotelica <persName ref="p4924">Gemusaeus</persName>, in oratoria <lb xml:id="p1z17"/>sive <persName ref="p4543">Ciceronis</persName> orationibus <persName ref="p4140">Affinius</persName><note xml:id="fn4" type="footnote" ana="bio" n="4"><persName ref="p4140">Johannes Afinius (Affinius, Avinius)</persName>, gest. 1541, aus <placeName ref="l781">Uri</placeName>, immatrikulierte sich 1538 an der <placeName ref="l28">Basler</placeName> Universität und wurde 1540 Professor für Rhetorik, Dekan der Artistenfakultät sowie Corregens des Augustinerkollegs. - Lit.: Basel, Matrikel II 18, Nr. 30; Rudolf <hi>Thommen,</hi> Geschichte der Universität Basel 1532-1632, Basel 1889, S. 355f, Nr. 11.</note>, in mathematicis <lb xml:id="p1z18"/><persName ref="p4209">Vitus</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p4209">Veit Ardüser</persName>.</note>, in Hebraicis <persName ref="p2270">Monsterus</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p2270">Sebastian Münster</persName>.</note>, in Gręcis ego, <lb xml:id="p1z19"/>in theologia <persName ref="p4349">Carolstadius</persName> et <persName ref="p1365">Grynaeus</persName> alternis <lb xml:id="p1z20"/>septimanis.</s>
					<s n="6" xml:lang="la">Taceo lectiones paedagogii, quas <lb xml:id="p1z21"/>omnium minime cessare arbitror.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">De mea possum dicere <lb xml:id="p1z22"/>puerorum vestrorum unum tantum adesse ei interdum <lb xml:id="p1z23"/>solere, et ita facilis alioqui est autor, quem praelegim<lb xml:id="p1z24"/>us, ut privato studio assequi facillime possint <lb xml:id="p1z25"/>neque interprete forte alio aut viva enarrantis voce <lb xml:id="p1z26"/>habere opus videantur.</s>
					<s n="8" xml:lang="la">Forsitan autem domi privatis <lb xml:id="p1z27"/>studiis, qui fere <placeName ref="l587">Tigurinorum</placeName> hactenus apud nos degentium <lb xml:id="p1z28"/>mos fuit, plus se proficere quam<pb type="edition" next="138"/> audiendis aliis posse putan<lb xml:id="p1z29"/>t<lb xml:id="p1z30"/>.<pb type="scan" next="35v."/></s>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Quicquid est, dicere certo nec possum nec, si possem, <lb xml:id="p2z2"/>libenter in alterius messem falcem immittere meam <lb xml:id="p2z3"/>vellem<note xml:id="fn7" type="footnote" n="7">Vgl. Adagia, 1, 4, 41 (<bibl source="b370">LB</bibl> II 167f).</note>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">De cessatione item aliorum professorum nihil <lb xml:id="p2z4"/>affirmare certi queo, nisi solorum medicorum, quibus a <lb xml:id="p2z5"/>praelectionibus abstinere, cum duo<note xml:id="fn8" type="footnote" n="8"><persName ref="p4477">Oswald Bär</persName> und <persName ref="p6618">Sebastian Sinckeler</persName>; vgl. <hi>Thommen,</hi> aaO, S. 212f.</note> tamen sint, ita<note xml:id="fnb" type="footnote" n="b"><hi>nach</hi> ita <hi>ein gestrichener Wortanfang.</hi></note> <lb xml:id="p2z6"/>frequens est ut nihil magis.</s>
					<s n="11" xml:lang="la">Ego toto hoc anno <lb xml:id="p2z7"/>non cessavi quam eo tempore, quo et apud vos fui, et <lb xml:id="p2z8"/>nunc per octo dies, dum <placeName ref="l199">Hagenoam</placeName> essem profectus, <lb xml:id="p2z9"/>pro qua neglectione totum iam mensem, quo alioqui <lb xml:id="p2z10"/>quiescere etiam academię privilegio licebat<note xml:id="fn9" type="footnote" n="9">Vgl. <hi>Thommen,</hi> aaO, S. 40.</note>, lectionem <lb xml:id="p2z11"/>meam continuo, nempe quia summo mane minus <lb xml:id="p2z12"/>nobis infestus esse calor ille<note xml:id="fn10" type="footnote" n="10">Die außergewöhnliche Hitze dieses Sommers vermerkt auch <persName ref="p495">Bullinger</persName> in seinem Diarium; s. <bibl source="b288">HBD</bibl> 28, 1-30.</note> potest.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Haec habui, <lb xml:id="p2z13"/>doctissime atque humanissime <persName ref="p495">Bullingere</persName>, quę super inter<lb xml:id="p2z14"/>rogatis tuis subito<note xml:id="fnc" type="footnote" n="c"><hi>nach</hi> subito <hi>ein gestrichener Wortanfang.</hi></note> nimisque tumultuanter <lb xml:id="p2z15"/>responderem.</s>
					<s n="13" xml:lang="la">Tu igitur animum potius aestima tibi ac <lb xml:id="p2z16"/>vestris omnibus deditissimum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale meque redamare, <lb xml:id="p2z17"/>ut facis, perge.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l28">Basileę</placeName>, 22. iulii 1540.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z18"/><persName ref="p8126">Ioan. Oporinus</persName> tuus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z19"/>De rebus <placeName ref="l199">Hagenoicis</placeName> melius ex <persName ref="p18308">Quirino</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p18308">Quirinus von Leiden</persName>.</note> <lb xml:id="p2z20"/>intelliges et amicorum literis; nam ego, quod v<lb xml:id="p2z21"/>el narratione dignum sit, nihil vidi.</s>
				</p>
				<p>
					<note type="address">[Adresse darunter:]</note>
					<s n="18" xml:lang="la">Domino <persName ref="p495">Henrico Bullingero</persName>, amico et fratri charissimo suo.</s>
				</p>
			</div>
		</body>
