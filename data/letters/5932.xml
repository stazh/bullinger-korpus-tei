	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Mitto cum tuis literis, doctissime <persName ref="p495">Bullingere</persName>, librum vocabulorum rei <lb xml:id="p1z2"/>numariae, ponderum, mensurarum etc. et hunc tibi muneri dono neque <lb xml:id="p1z3"/>pro donis tuis praestantibus tibi, ut debeo, gratias ago, quoniam, quibus <lb xml:id="p1z4"/>id verbis faciam, non invenio.</s>
					<s n="3" xml:lang="la">Verum pro gratiarum actione amorem <lb xml:id="p1z5"/>mutuum fidemque repono, quibus te in sinu fero nec discingor.</s>
					<s n="4" xml:lang="la">Quare <lb xml:id="p1z6"/>sic velim (mi <persName ref="p495">Bullingere</persName>) penitus tibi persuadeas me omnibus <lb xml:id="p1z7"/>rebus iis, quae ad rationes tuas et commoda pertinebunt, diligenter <lb xml:id="p1z8"/>curaturum, ut, quam de meo erga te amore benevolentiaque opinionem <lb xml:id="p1z9"/>habes, ea nunquam fallat, utque in me uno facile omnium <lb xml:id="p1z10"/>amicorum tuorum, quos amisisse te doles, studia et officia cognoscas.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Confessioni <placeName ref="l28">Basiliensi</placeName> nihil additum nihilque detractum est, sed integra <lb xml:id="p1z12"/>et ex veteri exemplari deprompta atque impressa est.</s>
					<s n="6" xml:lang="la">Novi, quod ad te <lb xml:id="p1z13"/>scribam, in praesentia nihil habeo.</s>
					<s n="7" xml:lang="la">Oro deum, patrem domini <lb xml:id="p1z14"/>nostri Iesu Christi, ut te tueatur, uti ecclesiae suae commodis <lb xml:id="p1z15"/>et utilitati diu inservire queas.</s>
					<s n="8" xml:lang="la">Tu vicissim pro fructu meae <lb xml:id="p1z16"/>vocationis ora.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Tibi plurimam salutem asscribunt fratres, d. <persName ref="p5341">Lepusculus</persName>, <lb xml:id="p1z17"/>d. <persName ref="p20110">Severinus</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p20110">Erzberger</persName>(?).</note>, d. <persName ref="p20376">Battmannus</persName>.</s>
					<s n="11" xml:lang="la" ana="salute">Salutem meis verbis nuncia doctissimo <lb xml:id="p1z18"/>viro d. <persName ref="p8011">R[odolpho] Gvalthero</persName>, d. <persName ref="p3988">Wolffio</persName>, d. <persName ref="p1453">Hallero</persName> et reliquis, quibus saltem <lb xml:id="p1z19"/>nomine notus sum, in primis vero <persName ref="p7228">Zvingglio</persName> mihi semper amantissimo.</s>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z20"/>Iterum vale, mi pater, qui mihi semper haeres es in medullis neque <lb xml:id="p1z21"/>unquam tui me capiet oblivio, dum spiritus hos regit artus<note xml:id="fn2" type="footnote" n="2">Vgl. <hi>Vergil,</hi> Aeneis, 4, 336.</note>.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z22"/>et salve.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l28">Basileae</placeName> 30. octobris 1563 raptim.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z23"/>Tuus ex animo <persName ref="p1312">Ionas Grasserus</persName>, <lb xml:id="p1z24"/><placeName ref="l28">Basiliensis</placeName> ecclesiae minister <lb xml:id="p1z25"/>in <placeName>Rynach</placeName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro m. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>episcopo vigilantissimo, amico <lb xml:id="p2z4"/>et fratri suo charissimo, <lb xml:id="p2z5"/>domino meo plurimum <lb xml:id="p2z6"/>colendo.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
