	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Graciam et pacem a domino.</s>
					<s n="2" xml:lang="la">Tempus ad scribendum non habeo, tabellarius <lb xml:id="p1z2"/>festinat, charissime <persName ref="p495">Bullingere</persName>, sed tantum, ut te adeundi <lb xml:id="p1z3"/>occasionem habeat.</s>
					<s n="3" xml:lang="la">Qui ipse, quaecumque ex <placeName ref="l688">Insubria</placeName><note xml:id="fn3" type="footnote" n="3"><placeName ref="l688">Lombardei</placeName>.</note> et ex tota <placeName ref="l834">Italia</placeName> <lb xml:id="p1z4"/>scitu digna sunt, melius novit quam ego et ore suo recensebit omnia.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Que vos habetis <placeName ref="l587">Tiguri</placeName>, ad nos scribite.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="5" xml:lang="la" ana="farewell">Vale et fratres omnes nostra salute <lb xml:id="p1z6"/>impertire.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ex <placeName ref="l98">Curia</placeName>, 6. iulii 46.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z7"/>Tuus <persName ref="p654">Comander</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro magistro <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, urbis <placeName ref="l587">Tigurinae</placeName> episcopo, <lb xml:id="p2z3"/>domino suo et amico primario.</s>
				</p>
			</div>
		</body>
	</text>
