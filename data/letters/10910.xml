	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">In hisce literis offendes, opinor, <persName ref="p2095">Melanchthonis</persName> epistolam<note xml:id="fn1" type="footnote" n="1">Gemeint ist der (nicht erhaltene) Brief <persName ref="p2095">Melanchthons</persName> vom 1. Juli; s. unten <ref target="file10924">Nr. 883</ref>, 5-7.</note>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/><placeName ref="l491">Argentorati</placeName> fuimus <persName ref="p1365">Grynęus</persName> et ego; tentavimus concordię pacisque communi<lb xml:id="p1z3"/>s ecclesiarum articulos<note xml:id="fn2" type="footnote" n="2"><persName ref="p1365">Grynäus</persName> und <persName ref="p4349">Karlstadt</persName> waren zu Gesprächen über die <placeName ref="l558">Wittenberger</placeName> Konkordie nach <placeName ref="l491">Straßburg</placeName> eingeladen worden; s. oben <ref target="file10906">Nr. 866</ref>, 30-35.</note>.</s>
					<s n="4" xml:lang="la">Interlocuti sumus elicuimusque sententiam <lb xml:id="p1z4"/>meo iudicio et tolerandam et ad pacem non parva momenta habituram<note xml:id="fn3" type="footnote" n="3">Zur Stellungnahme der <placeName ref="l491">Straßburger</placeName> s. unten <ref target="file10911">Nr. 871</ref>, 1 mit Anm. 1.</note>.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Non vacat autem mihi nunc plenius scribere, quod referre me oportet illic <lb xml:id="p1z6"/>acta idque hodie a prandio.</s>
					<s n="6" xml:lang="la">Instigabo d. <persName ref="p1365">Gryneum</persName>, quo omnia <lb xml:id="p1z7"/>scribat, et totus in hoc ero, ut vobis mittatur expositurus <lb xml:id="p1z8"/>cuncta.</s>
					<s n="7" xml:lang="la">Hec pauca, queso, boni consule.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l28">Basileę</placeName>, <lb xml:id="p1z9"/>die 29. iulii anno 36.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z10"/>Tuus <persName ref="p4349">Carolostadius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="10" xml:lang="la"><lb xml:id="p1z12"/>E<pb/><lb xml:id="p2z1"/>ruditissimo viro d. <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tiguri</placeName> primario <lb xml:id="p2z3"/>pastori, maiori suo <lb xml:id="p2z4"/>colendissimo<note xml:id="fna" type="footnote" n="a"><hi>Darunter von unbekannter Hand:</hi> No. 7.</note>.</s>
				</p>
			</div>
		</body>
	</text>
