	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Si nihil in his turbulentis temporibus habeam, quod m<lb xml:id="p1z2"/>e consoletur et reficiat, saltem hoc tue faciunt <lb xml:id="p1z3"/>litere, quas binas accepi sane cum maximo <lb xml:id="p1z4"/>gaudio; nam sunt docte et pie, ita ut <lb xml:id="p1z5"/>terrestrem et mu[n]danum omnino possint ad <lb xml:id="p1z6"/>celestia et spiritualia revocare.</s>
					<s n="3" xml:lang="la">Perge <lb xml:id="p1z7"/>ergo, cum licebit; non enim cupio tuos iustos <lb xml:id="p1z8"/>labores et continuos aliis oneribus gravare.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Scribes tamen amico et qui in optimam <lb xml:id="p1z10"/>partem, ut debet, omnia consulet.</s>
					<s n="5" xml:lang="la">Nec <lb xml:id="p1z11"/>possum nec debeo, quod ad Quinque illos <lb xml:id="p1z12"/>attinet, tibi per literas respondere; habeas <lb xml:id="p1z13"/>tamen a me hoc nec culpa nec voluntate <lb xml:id="p1z14"/>maioris potestatis actum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Cetera coram <lb xml:id="p1z15"/>aliquando et, ut spero, brevi; nam a comitiis <lb xml:id="p1z16"/><placeName ref="l21">Baddensibus</placeName>, ubi die Martis adero, si per otium <lb xml:id="p1z17"/>et infinita negotia liceat, dominos tuos <lb xml:id="p1z18"/>et te invisam vos salutaturus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Nihil est <lb xml:id="p1z19"/>enim, quod magis cupiam quam tecum libere <lb xml:id="p1z20"/>et de omnibus agere.</s>
					<s n="8" xml:lang="la">Interea autem credas <lb xml:id="p1z21"/>me, qui omnino dominis bene volo, facturum <lb xml:id="p1z22"/>et procuraturum, que in rem sue maiestatis et <lb xml:id="p1z23"/>eorum erunt, tam diligenter, quam qui diligentissime, <pb/><lb xml:id="p2z1"/>et si omnia non possim, cetera cum tempore dabit <lb xml:id="p2z2"/>dominus.</s>
					<s n="9" xml:lang="la">Nec est, ut nuper <persName ref="p3375">Vergerio</persName> dixi, quod <lb xml:id="p2z3"/>tanto impetu quidam ita urgeant, quoniam <lb xml:id="p2z4"/>potius rem perdunt quam promovent, tanquam <lb xml:id="p2z5"/>si vellent aliquem ex aperto et certo naufragio <lb xml:id="p2z6"/>invitis diis et ventis vi et rixis statim ret[<lb xml:id="p2z7"/>r]ahere.</s>
					<s n="10" xml:lang="la">Ergo ex contentione oritur vindic[ta], <lb xml:id="p2z8"/>et sic omnem viam prudentioribus praescindunt.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z9"/>Sed hactenus.</s>
					<s n="12" xml:lang="la">Omnia, diis gratia, bene <lb xml:id="p2z10"/>apud nos habent, et parat rex contra <lb xml:id="p2z11"/>infinitas practiquas cum multis amicis magnos <lb xml:id="p2z12"/>exercitus, et breviter credas s<lb xml:id="p2z13"/>uam maiesta<lb xml:id="p2z14"/>tem cum principibus <placeName ref="l822">Germanis</placeName> <lb xml:id="p2z16"/>optime convenire; intelligo de iis, <lb xml:id="p2z17"/>qui patriam et libertatem amant.</s>
					<s n="13" xml:lang="la">Cetera/um <lb xml:id="p2z19"/>ex literis dominorum intelliges.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Si quid <lb xml:id="p2z20"/>gadde offeratur, habebis ex me; eadem a te <lb xml:id="p2z21"/>expectabo.</s>
					<s n="15" xml:lang="la" ana="farewell">Vale optime, vir bone.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z22"/>Datum hoc die sabbati <placeName ref="l760">Soluturi</placeName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z23"/>Tuus sem<lb xml:id="p2z24"/>per <persName ref="p8296">Bas[<lb xml:id="p2z25"/>safo<lb xml:id="p2z26"/>ntaneus]</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z27"/>Habemus certas literas <lb xml:id="p2z28"/><persName ref="p18538">Caesarem</persName> in extremis esse; <lb xml:id="p2z29"/>sed quia est mala bestia, pauci <lb xml:id="p2z30"/>sunt, qui audent credere.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p3z1"/>Optimo viro domino <lb xml:id="p3z2"/><persName ref="p495">Bulingero</persName>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="de"><lb xml:id="p3z3"/>Zuͦ <lb xml:id="p3z4"/><placeName ref="l587">Zurich</placeName><lb xml:id="p3z6"/>.</s>
				</p>
			</div>
