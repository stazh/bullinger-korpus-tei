			<zone xml:id="p2z4-0" points="2404,1398 2520,1363 2580,1392 2705,1350 2793,1382 2957,1385 3081,1364 3083,1306 2888,1331 2828,1293 2702,1329 2635,1290 2499,1337 2405,1322">2411,1355 2444,1353 2478,1352 2512,1351 2546,1349 2579,1347 2613,1346 2647,1345 2681,1343 2714,1343 2748,1343 2782,1343 2816,1343 2849,1343 2883,1343 2917,1343 2951,1343 2984,1343 3018,1343 3052,1344 3086,1346</zone>
