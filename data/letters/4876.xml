	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Etsi heri per <persName>Iudeum</persName> baptizatum ad te scripsi, nunc <lb xml:id="p1z2"/>tamen rogatus a praesentium latore iterum tibi molestus sim <lb xml:id="p1z3"/>oportet.</s>
					<s n="3" xml:lang="la">Hic hactenus praefuit ecclesię apud <placeName ref="l648">Rhetos</placeName> in ea <lb xml:id="p1z4"/>parte ditionis, quae vocatur <placeName ref="l2701">Prettigöw</placeName>.</s>
					<s n="4" xml:lang="la">Vocatus autem a quodam <lb xml:id="p1z5"/>fratre suo in ditionem marchionis <placeName ref="l2978">Badensis</placeName> <persName>Philiberti</persName> <lb xml:id="p1z6"/>speravit isthic se conditionem habiturum.</s>
					<s n="5" xml:lang="la">Sed repulsam <lb xml:id="p1z7"/>passus sive ob non sufficientem eruditionem sive ob articulum <lb xml:id="p1z8"/>coenę domini sive ob utrumque nunc plane exul est una cum uxore <lb xml:id="p1z9"/>pia et duobus liberis, nisi iterum recipiatur a suis in <lb xml:id="p1z10"/><placeName ref="l2701">Prettigeu</placeName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Rogo ergo te (quoniam ipse non possum plura), ut, si aliquis <lb xml:id="p1z11"/>locus vacaret in <placeName ref="l774">Turgovia</placeName> aut <placeName ref="l507">Dockenburg</placeName>, tu ipsis eum <lb xml:id="p1z12"/>commendare velis.</s>
					<s n="7" xml:lang="la">Rogo etiam, ut exhorteris eum ad diligentem <lb xml:id="p1z13"/>scripturę lectionem et vitam piam; nam audio ab uxore <lb xml:id="p1z14"/>querelas graves, ut exhortatione, imo et consilio et consolatione <lb xml:id="p1z15"/>opus habeat, ne cogitet de redeundo in <placeName>Egiptum</placeName> ad <lb xml:id="p1z16"/>ollas carnium<note xml:id="fn1" type="footnote" n="1">Vgl. <cit type="bible"><ref>Ex 16, 3</ref></cit>.</note>.</s>
					<s n="8" xml:lang="la">Spero simul etiam, si libros haberet et in <lb xml:id="p1z17"/>loco aliquo esset, ubi conversari posset cum piis et doctioribus, <lb xml:id="p1z18"/>se ipsum ad meliorem frugem rediturum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Quid si <lb xml:id="p1z19"/>scriberes etiam d. <persName ref="p8018">Hallero</persName> pro illo, si forte dominus per agrum <lb xml:id="p1z20"/><placeName ref="l41">Bernensem</placeName> apud aliquam ecclesiolam locum assignaret ei.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Tu pro tua prudentia, quid factu optimum sit, iudicabis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z22"/>Bene <lb xml:id="p1z23"/>vale, ac, quod facis, boni consule.</s>
					<s n="12" xml:lang="la">Debemus <lb xml:id="p1z24"/>enim aliquid etiam talibus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l28">Basileę</placeName> 16. iulii 1561.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z25"/>Tuus <persName ref="p1754">Ioannes Iungius</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctrina ac virtute <lb xml:id="p2z2"/>ornatissimo viro domino <lb xml:id="p2z3"/><persName ref="p495">Henrico Bullingero</persName>, domino <lb xml:id="p2z4"/>suo ac fratri observandissimo.</s>
					<s n="16" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
