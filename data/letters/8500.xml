	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Scribo haec, ne nihil ad te, chare frater, scribam.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Iam nunc <lb xml:id="p1z2"/>tuae mihi defatigato scribendi munere offeruntur ad 2. pomeridianam, <lb xml:id="p1z3"/>quod refero, ut qualecunque hoc scriptum boni consulas.</s>
					<s n="4" xml:lang="la">Sed <lb xml:id="p1z4"/>et negotia difficilia et plurima me tantum non adobruunt atque <lb xml:id="p1z5"/>opprimunt.</s>
					<s n="5" xml:lang="la">Cum dolore legi, quae scribis de tua inopia; magis <lb xml:id="p1z6"/>conturbarunt ea, quae scribis de conatibus <persName ref="p20473">Ganthneri</persName>, hominis <lb xml:id="p1z7"/>seditiosi, cuius artes malignas iuvet <persName ref="p8057">Campelli</persName> nostri in dicendo <lb xml:id="p1z8"/>non satis parata promptitudo.</s>
					<s n="6" xml:lang="la">Sed confidite domino; <lb xml:id="p1z9"/>hunc orate sedulo, ut vobis adsit, animos ad suam voluntate<lb xml:id="p1z10"/>m sanctam flectat.</s>
					<s n="7" xml:lang="la">Quod si eiecerint vos, quod tamen non <lb xml:id="p1z11"/>puto facile futurum, domini providentia minime vos deseret.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/>Dicebat Abraham ad filium suum unigenitum: "Dominus providebit.<lb xml:id="p1z13"/>"</s>
					<s n="9" xml:lang="la">Pergite vos in via domini nec cedite malis.</s>
					<s n="10" xml:lang="la">Nosti illud <lb xml:id="p1z14"/>ethnici<note xml:id="fn1" type="footnote" n="1">Aristoteles(?).</note>: "Tu ne cede malis, sed contra audentior ito."</s>
					<s n="11" xml:lang="la">Aliquot <lb xml:id="p1z15"/>iam dies diligenter inquisivi, si quidem invenirem clari <lb xml:id="p1z16"/>viri d. <persName ref="p6210">Urbani Rhegii</persName> et universi ducatus <placeName ref="l1750">Luneburgensis</placeName> <lb xml:id="p1z17"/>iudicium de puniendis haereticis, de quo dicis.</s>
					<s n="12" xml:lang="la">Pridie <lb xml:id="p1z18"/>autem inveni impressum in <placeName ref="l749">Saxonia</placeName>, <placeName>Cellae Saxonum</placeName>; <lb xml:id="p1z19"/>ilico ergo dedi describendum; libellum est Germanicus et certe <lb xml:id="p1z20"/>elegans et brevis.</s>
					<s n="13" xml:lang="la">Sapit <persName ref="p20473">Ganthnerus</persName> ex chronicis <persName>Sebastiani <lb xml:id="p1z21"/>Franci</persName>; is enim in capite de haereticis in anabaptistis <lb xml:id="p1z22"/>ponit iudicium et <persName ref="p458">Brentii</persName> et <persName>Oedembachii</persName> de non puniendis <lb xml:id="p1z23"/>haereticis.</s>
					<s n="14" xml:lang="la">Unus satis et <persName ref="p6210">Rhegii</persName> libellus admodum idoneus <lb xml:id="p1z24"/>confutandis istorum naeniis.</s>
					<s n="15" xml:lang="la">Spero te brevi ad nos <lb xml:id="p1z25"/>venturum, cum scilicet commoditas ecclesiae ocium dederit; colloquemur <lb xml:id="p1z26"/>tunc de rebus omnibus copiosius, etiam de <persName>Hegelino</persName>.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z27"/>Non possumus nos omnes ad nos colligere.</s>
					<s n="17" xml:lang="la">Serviat ille suae <lb xml:id="p1z28"/>ecclesiae, in qua nimirum etiam boni sunt; dissimulet malorum <lb xml:id="p1z29"/>iniurias.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Nullibi talem inveniet ecclesiam, <lb xml:id="p1z30"/>in qua non sint spinae.</s>
					<s n="19" xml:lang="la">Sed puto uxorem, quia <placeName ref="l587">Tigurina</placeName> <lb xml:id="p1z31"/>est, <placeName ref="l587">Tigurum</placeName> omnino redire velle; nunquam enim ab eo tempore, <lb xml:id="p1z32"/>quo illam duxit, aliud quam <placeName ref="l587">Tiguri</placeName> haerere sibi proposuit<lb xml:id="p1z33"/>.</s>
					<s n="20" xml:lang="la">Sed plures sunt, qui merentur ante ipsum promoveri.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z34"/>Sed et nullis ad vos testimoniis publicis venit <lb xml:id="p1z35"/>commendatus; unus et alter eum commendarunt, sed iuxta regulam: <lb xml:id="p1z36"/>Rogatus rogat.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Cum plus ocii et animi erit, <lb xml:id="p1z37"/>copiosius scribam.</s>
					<s n="23" xml:lang="la">Dicas, oro, d. <persName ref="p8057">Campello</persName> me eius <lb xml:id="p1z38"/>accepisse literas, quibus alias respondebo.</s>
					<s n="24" xml:lang="la">Dominus illi bene<lb xml:id="p1z39"/>dicat!</s>
					<s n="25" xml:lang="la" ana="salute">Salutabis ipsum.</s>
					<s n="26" xml:lang="la">Si quid habes de rebus <placeName ref="l834">Italicis</placeName> <lb xml:id="p1z40"/>et <placeName ref="l522">Venetorum</placeName>, tum <placeName ref="l150">Ferrarien[si]</placeName> urbe, significa per <lb xml:id="p1z41"/>occasionem.</s>
				</p>
				<p>
					<s n="27" xml:lang="la" ana="farewell">Vale aeternum.</s>
					<s n="28" xml:lang="la"><persName ref="p7228">Zvinglius</persName>, gener meus, apo<lb xml:id="p1z42"/>plexia tactus 11. februarii feliciter migravit ad dominum.</s>
					<s n="29" xml:lang="la">Non<lb xml:id="p1z43"/>nulli alii viri boni hic et alibi eodem morbo sunt extin<lb xml:id="p1z44"/>cti.</s>
					<s n="30" xml:lang="la">Dominus servet nos!</s>
				</p>
				<p>
					<s n="31" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 23. februarii anno 1571.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><lb xml:id="p1z45"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="33" xml:lang="la"><lb xml:id="p1z46"/>Salvi sint d. d. consules, <persName ref="p8186">Bonettus</persName>, <persName ref="p6130">Pontisella</persName>, <lb xml:id="p1z47"/><persName>Gregorius</persName> et alii nostri amici, etiam d. <persName ref="p2776">Ruinella</persName> etc.</s>
				</p>
				<p>
					<s n="34" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <lb xml:id="p2z2"/><persName ref="p8016">Tobiae Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae fideli <lb xml:id="p2z4"/>ministro, domino <lb xml:id="p2z5"/>meo honorando et <lb xml:id="p2z6"/>fratri dilecto.</s>
				</p>
				<p>
					<s n="35" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
