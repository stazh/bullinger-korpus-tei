		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Ad <lb xml:id="p1z2"/><persName ref="p8075">Erastum</persName>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>S. D.</s>
					<s n="3" xml:lang="la">Plurimum perturbarunt me tuae literae, domine honoran<lb xml:id="p1z4"/>de et frater in Christo charissime.</s>
					<s n="4" xml:lang="la">Valde enim metuo, ne quid <lb xml:id="p1z5"/>mali illustrissimo et optimo principi eveniat ex consiliis non <lb xml:id="p1z6"/>admodum bene pensitatis.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="salute">Quando vero admonitus est antea <lb xml:id="p1z7"/>hac de re abunde satis, quod reliquum est, commendemus <lb xml:id="p1z8"/>totum domino precantes sedulo, ut ipse pro sua misericord<lb xml:id="p1z9"/>ia omnia in bonum finem dirigat ad gloriam nominis sui et <lb xml:id="p1z10"/>fidelium suorum salutem.</s>
					<s n="6" xml:lang="la">Nihil alioquin dubito optimum principem <lb xml:id="p1z11"/>statim experturum, quod reliqui omnes, qui hoc saxum vo<lb xml:id="p1z12"/>lverunt.</s>
					<s n="7" xml:lang="la">Eventus multa docebit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Vehement<lb xml:id="p1z13"/>er <lb xml:id="p1z14"/>quoque animo meo dolet vos duos, te et <persName ref="p8033">Bezam</persName>, inter vos <lb xml:id="p1z15"/>committi.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Expertus scio, quid possit disputationis fervor.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/>Homines sumus; semper humani aliquid, imo plurimum <lb xml:id="p1z17"/>intercurrit in eorum quoque pugnis, qui alioquin optimi <lb xml:id="p1z18"/>sunt et modestissimi.</s>
					<s n="11" xml:lang="la">Utrumque vehementem esse <lb xml:id="p1z19"/>scio.</s>
					<s n="12" xml:lang="la">Quod ergo dudum rogavi, id ipsum nunc repeto et<lb xml:id="p1z20"/>, ut affectibus cohercitis et oculis a persona aversis <lb xml:id="p1z21"/>causam ipsam duntaxat moderato animo agas et cogites <lb xml:id="p1z22"/><persName ref="p8033">Bezam</persName> esse fratrem nostrum, virum pium et doctum et <lb xml:id="p1z23"/>per quem dominus egregia fecerit plurima.</s>
					<s n="13" xml:lang="la">Cave item, mi fr<lb xml:id="p1z24"/>ater, ne spargantur illa nostra scripta, ne ex privato <lb xml:id="p1z25"/>publicum oriatur incendium.</s>
					<s n="14" xml:lang="la">Qua de re autem quoque <lb xml:id="p1z26"/>ad te scripsi; puto enim nobis diligenter advigi<lb xml:id="p1z27"/>landum, ut pax, quantum quidem fieri potest, in ecclesia <lb xml:id="p1z28"/>conservetur, litibus via intercludatur et ne occasionem <lb xml:id="p1z29"/>hostibus exultandi de nostris certaminibus obiiciam<lb xml:id="p1z30"/>us et infirmorum praeterea animos offendendo <lb xml:id="p1z31"/>vulneremus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Dominum ex animo oro, ut nostri misertus <lb xml:id="p1z32"/>omnia sopiat dissidia et concordiam ac pacem concedat etc.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell"><lb xml:id="p1z33"/>Vale.</s>
					<s n="17" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 15.12.1569<note type="misc">diese Zeile von <persName ref="p495">Bullinger</persName> selbst beigefügt.</note>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>