	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Scribit <persName ref="p8116">Franciscus Portus</persName> ex <placeName ref="l834">Italia</placeName> haberi magnos <lb xml:id="p1z2"/>a <placeName ref="l2510">Turca</placeName> apparatus fieri terraque marique, <placeName ref="l522">Venetos</placeName> <lb xml:id="p1z3"/>timere, parare ipsos quoque classem satis magnam, <lb xml:id="p1z4"/>80 scilicet triremes et quinque grandiores, quas <lb xml:id="p1z5"/>vulgo galeas grossas vocant.</s>
					<s n="2" xml:lang="la">Ducem <placeName ref="l1098">Florentiae</placeName> <lb xml:id="p1z6"/>sibi timere a <persName ref="p18575">rege Hispaniarum</persName>, qui filium comitis <lb xml:id="p1z7"/>Petiliani fecit emissarium in ipsum ducem; <lb xml:id="p1z8"/>is comitis filius loca quaedam munita et portum <lb xml:id="p1z9"/>prope <placeName ref="l462">Senam</placeName> occupasse dicitur, unde incursionibus <lb xml:id="p1z10"/>quotidianis agrum <placeName ref="l462">Senensem</placeName> et <placeName ref="l1098">Florentinum</placeName> <lb xml:id="p1z11"/>infestet.</s>
					<s n="3" xml:lang="la">[a t<pb/><lb xml:id="p2z1"/>ergo] <placeName>Nova</placeName> pro d. <persName ref="p495">Bullingero</persName>.</s>
				</p>
			</div>
		</body>
	</text>
