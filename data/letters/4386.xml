	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Legatus regius adhuc haeret hic in <lb xml:id="p1z2"/>diversorio Ciconiae, cras opinor discessurus.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Amanter mecum contulit de variis.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ego cum pro<lb xml:id="p1z4"/>fluvio ventris (honor sit auribus tuis) laborem, <lb xml:id="p1z5"/>nunquam potui cum ipso vel prandere vel <lb xml:id="p1z6"/>coenare.</s>
					<s n="5" xml:lang="la">Egregio amicitiae symbolo pro sua <lb xml:id="p1z7"/>humanitate me donare voluit; ego vero gratias <lb xml:id="p1z8"/>egi, nihil accepi promittens me in Christo alias <lb xml:id="p1z9"/>perseveraturum in amicitia.</s>
					<s n="6" xml:lang="la">Scis <placeName ref="l2542">7 Cantones</placeName>, <lb xml:id="p1z10"/>id est <placeName ref="l160">Friburgenses</placeName> cum <placeName ref="l760">Salodoriis</placeName> et <placeName ref="l2448">5 Pagis</placeName>, misisse <lb xml:id="p1z11"/>legationem in <placeName ref="l791">Valesiam</placeName>.</s>
					<s n="7" xml:lang="la">Venerunt initio ad omnium <lb xml:id="p1z12"/>turbulentissimos rusticos <foreign xml:lang="de">im zenden <placeName>Goms</placeName>.</foreign></s>
				</p>
				<p>
					<s n="8" xml:lang="la">Habuerunt <lb xml:id="p1z13"/>orationem apud illos contra nostram religionem; postularunt, <lb xml:id="p1z14"/>ut asseclas nostrae religionis gravissime <lb xml:id="p1z15"/>puniant, libros nostros tollant, liberos ad evangelic<lb xml:id="p1z16"/>as scholas non mittant, se fortiter novae religioni <lb xml:id="p1z17"/>opponant; si magistratus dissimulet et nolit <lb xml:id="p1z18"/>extirpare eam, utantur sua illa maza, quam velint <lb xml:id="p1z19"/>quidem abrogatam, sed in omnibus aliis c[auss]is, non <lb xml:id="p1z20"/>autem in negotio religionis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Rustici eius loci <lb xml:id="p1z21"/>receperunt haec omnia et confirmarunt iureiurando <lb xml:id="p1z22"/>et literis datis.</s>
					<s n="10" xml:lang="la">Episcopus vero et praefectus, <foreign xml:lang="de">der landt<lb xml:id="p1z23"/>houptman,</foreign> et senatores indignissime tulerunt, quod <lb xml:id="p1z24"/>insciis eis coetus habuerunt etc., vocaruntque legatos <lb xml:id="p1z25"/><placeName>Leucam</placeName>.</s>
					<s n="11" xml:lang="la">Illi vero tentarunt <foreign xml:lang="de">im zenden</foreign> Brig <lb xml:id="p1z26"/>etiam concionari; maior vero eius loci fortissime <lb xml:id="p1z27"/>restitit.</s>
					<s n="12" xml:lang="la">Venerunt ergo <placeName>Leucam</placeName>, ubi ab episcopo <lb xml:id="p1z28"/>et senatoribus auditi sunt.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Proposuerunt eis, quod <lb xml:id="p1z29"/>antea <placeName>Gomsensibus</placeName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Sunt in illa propositione multa ab<lb xml:id="p1z30"/>surda, intolleranda, amara etc.</s>
					<s n="15" xml:lang="la">Responsum est eis <lb xml:id="p1z31"/>eorum praesentia nihil fuisse opus, cum literae publicae, <lb xml:id="p1z32"/>scriptae a comitiis <placeName ref="l21">Badensibus</placeName> ad eos, lectae sint in <lb xml:id="p1z33"/>omnibus partibus et approbatae; se non discessuros <lb xml:id="p1z34"/>a fide christiana et, cum quidam superioribus <lb xml:id="p1z35"/>diebus temere quaedam contra religionem designarint, <lb xml:id="p1z36"/>punitos esse; nolle se autem <placeName ref="l2542">7 Cantonibus</placeName> dare <lb xml:id="p1z37"/>aut colligere coetus, cum nunc quoque non sit possibile.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z38"/>Legati et ipsi responsionem non aequo tulere animo <lb xml:id="p1z39"/>et postularunt eam sibi dari scripto, quod factum <lb xml:id="p1z40"/>est.</s>
					<s n="17" xml:lang="la">Ita discessere.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Ubi legati <placeName ref="l41">Bernenses</placeName> venerunt, <lb xml:id="p1z41"/>benignissime excepti et dimissi sunt.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z42"/>Audio magnam esse spem; dominus benedicat eis etc.</s>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Noster legatus et <placeName ref="l441">Schaffhusianorum</placeName> usque <placeName ref="l41">Bernam</placeName> <lb xml:id="p2z2"/>progressi fuerunt ingressuri et ipsi <placeName ref="l791">Valesiam</placeName>, <lb xml:id="p2z3"/>sed instructi a legatis <placeName ref="l41">Bernatum</placeName> revertentibus cum <lb xml:id="p2z4"/>expositione rerum domum redierunt.</s>
					<s n="21" xml:lang="la">Vides ex brevi <lb xml:id="p2z5"/>narratione, quid expectemus ab istis hominibus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Dominus <lb xml:id="p2z6"/>liberet nos a malo.</s>
					<s n="23" xml:lang="la">- <placeName ref="l1139">Linzii</placeName> in <placeName ref="l850">Austria</placeName> <lb xml:id="p2z7"/>comitia celebrat <persName ref="p18477">Ferdinandus</persName> cum tribus episcopis electoribus, <lb xml:id="p2z8"/>episcopo <placeName ref="l1725">Salisburgensi</placeName> et <persName ref="p18604">Bavaro</persName> principe de celebrando <lb xml:id="p2z9"/>concilio contra nos.</s>
					<s n="24" xml:lang="la">Venit ad eos <persName ref="p8183">Sanlaurentianus</persName> <lb xml:id="p2z10"/>missus a cardinale <placeName ref="l691">Lotharingio</placeName> nomine regis <placeName ref="l832">Galliae</placeName>.</s>
					<s n="25" xml:lang="la"><lb xml:id="p2z11"/>Dominus dissipet consilia impiorum.</s>
					<s n="26" xml:lang="la">Impeditus nuptiis filii mei <lb xml:id="p2z12"/><persName ref="p477">Ioannis Rodolphi</persName> ampliora non possum.</s>
				</p>
				<p>
					<s n="27" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 9. augusti.</s>
				</p>
				<p>
					<s n="29" xml:lang="la" ana="salute">Salutant te mei omnes.</s>
					<s n="30" xml:lang="la">1560.</s>
				</p>
				<p>
					<s n="31" xml:lang="la">Tuus ex animo <lb xml:id="p2z13"/>semper.</s>
				</p>
				<p>
					<s n="32" xml:lang="la">Praestan<lb xml:id="p2z14"/>tissimo viro d. <persName ref="p8009">Ioanni Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae ministro, domino et fratri colen<lb xml:id="p2z15"/>dissimo et charissimo suo.</s>
					<s n="33" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
