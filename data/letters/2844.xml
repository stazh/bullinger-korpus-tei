	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Libellus <persName>Bertrami</persName> de sacramento corporis etc.</s>
					<s n="2" xml:lang="la">Christi <lb xml:id="p1z2"/>mihi plurimum commendatur.</s>
					<s n="3" xml:lang="la">Quem si potes tam populari <lb xml:id="p1z3"/>quam Latina ad me des lingu, oro; conabor quippe <lb xml:id="p1z4"/>aliquid contra sacramentarios, qui ex sacramentis res <lb xml:id="p1z5"/>sacramentorum faciunt.</s>
					<s n="4" xml:lang="la">Si contingeret lucrari principem nostrum, <lb xml:id="p1z6"/>plurimum me effecisse existimarem.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Ego pro exemplaribus <lb xml:id="p1z7"/>tibi satisfacturus sum.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
