	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Quum mihi non satis esset compertum, ubinam <lb xml:id="p1z3"/>locorum reverendus d. <persName ref="p3375">Vergerius</persName> nunc <lb xml:id="p1z4"/>ageret, atque <lb xml:id="p1z5"/>arbitrarer te non tantum id istic scire posse, <lb xml:id="p1z6"/>verum etiam commodam facultatem mittendi <lb xml:id="p1z7"/>ad illum, quicquid opus esset, habere, duos fa<lb xml:id="p1z8"/>sciculos, alterum literarum<note type="margin">a.R.: ...</note>, alterum quorundam <lb xml:id="p1z9"/>libellorum, per d. <persName ref="p8168">Marium Besucium</persName>, qui tibi <lb xml:id="p1z10"/>hanc epistolam reddidit, ad te afferendos curavi, <lb xml:id="p1z11"/>quo deinde tu illos istinc ad ipsum <persName ref="p3375">Vergerium</persName>, <lb xml:id="p1z12"/>ubi fuerit, transmittas, quod libenter te pro tua <lb xml:id="p1z13"/>in illum observantia esse facturum minime <lb xml:id="p1z14"/>dubito.</s>
					<s n="3" xml:lang="la" ana="salute">Vale, mi d. <persName ref="p495">Bulinger</persName>e, ac reverendos <lb xml:id="p1z15"/>istic patres ac fratres in domino ex me salvere iube.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z16"/><placeName ref="l93">Clavennae</placeName>, pridie kalendas novem[bres] 1553.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z17"/>Tuus, quicquid est, <persName ref="p8022">Franciscus Niger</persName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z2"/>suo plurimum obs<lb xml:id="p2z3"/>ervando.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p2z4"/>Cum fasciculo uno libellorum<lb xml:id="p2z6"/>.</s>
				</p>
			</div>
		</body>
	</text>
