	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>D. <persName ref="p8016">Tobię</persName> significabo, quae mandas.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Aegerrime hoc <lb xml:id="p1z2"/>homine carebo, cuius opera mihi usui esse <lb xml:id="p1z3"/>potuit, sed non invideo tamen <lb xml:id="p1z4"/>ei meliora.</s>
					<s n="3" xml:lang="la">Coniugem habet <lb xml:id="p1z5"/>molestissimam, quae eum dies noctesque vexat, <lb xml:id="p1z6"/>cuius importunitas aliter expugnari <lb xml:id="p1z7"/>non potest, quam si revocetur etc.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Rogat te d. <persName ref="p8093">Hercules</persName>, ut has literas occasione <lb xml:id="p1z9"/>aliqua d. <persName ref="p2054">Martinengo</persName> transmittere <lb xml:id="p1z10"/>digneris.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, domino <lb xml:id="p2z3"/>suo et in Christo patri <lb xml:id="p2z4"/>reverendo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><placeName ref="l587">T[igur]i</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
