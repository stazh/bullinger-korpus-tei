	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Etiamsi festinet praesentium lator hanc tam etiam <lb xml:id="p1z2"/>festinanter scriptam a me habebis, ut scias adveni<note type="margin">a.R.: advehi? advetu?</note> <lb xml:id="p1z3"/>meum filium deo iuvante.</s>
					<s n="3" xml:lang="la">Nova si que vis, <lb xml:id="p1z4"/>ex literis, quas dominis tuis scribo, intelliges <lb xml:id="p1z5"/>et ex memoriali incluso, ex quo etiam ea, <lb xml:id="p1z6"/>que in <placeName ref="l830">Anglia</placeName> orta sunt in principio <lb xml:id="p1z7"/>huius mensis, percipies.</s>
					<s n="4" xml:lang="la">Cupio tuas, ut <lb xml:id="p1z8"/>sciam, quomodo <lb xml:id="p1z9"/>valeas.</s>
					<s n="5" xml:lang="la" ana="farewell"><lb xml:id="p1z10"/>Optime vale.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Ex <placeName ref="l760">Soloturo</placeName> <lb xml:id="p1z12"/>16<lb xml:id="p1z13"/>a februarii.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Tuus semper <lb xml:id="p1z15"/><persName ref="p8296">Bass</persName> <pb/><lb xml:id="p4z1"/>Optimo viro et amico <lb xml:id="p4z2"/>domino <persName ref="p495">Bulingero</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p4z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="de"><lb xml:id="p4z4"/>Ann herren <persName ref="p495">Bullinger</persName><note type="misc">von anderer Hand</note>.</s>
				</p>
			</div>
		</body>
	</text>
