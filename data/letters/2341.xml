	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Literas, quas domino <persName ref="p6130">Ioanni Pontisellę</persName> ad me dedisti, <lb xml:id="p1z2"/>nuper accepi, vir clarissime, easque statim fidelibus <lb xml:id="p1z3"/><placeName ref="l294">Locarnensibus</placeName> reddendas curavi, quo sciant, quid <lb xml:id="p1z4"/>actum sit in comitiis et quomodo se gerere <lb xml:id="p1z7"/>debeant crescente persequtione.</s>
					<s n="2" xml:lang="la">Tibi vero fidelium <lb xml:id="p1z9"/>n<lb xml:id="p1z10"/>omine ingentes habeo <lb xml:id="p1z11"/>gratias ob tuam in <lb xml:id="p1z12"/>hoc Christi negotio diligentiam ac sedulitatem.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z13"/>Deus ille cordium servator reddat tibi iuxta <lb xml:id="p1z15"/>misericordiam suam ac animi tui synceritatem.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z16"/>Rogamus te insuper, domine <persName ref="p495">Henrice</persName>, per viscera Christi, <lb xml:id="p1z19"/>ut in ea, quam hilari animo suscepisti, provincia <lb xml:id="p1z21"/>perdures pręvaleasque pręcationibus m. p. ad <lb xml:id="p1z24"/>conditorem, exhortatione ad magistratum, sedu<lb xml:id="p1z25"/>litate vero apud omnes <placeName ref="l587">Tigurinos</placeName>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Confidimus <lb xml:id="p1z26"/>enim humanitati tę, quod ultra, quam petimus et <lb xml:id="p1z27"/>oramus, sis ipse facturus.</s>
					<s n="6" xml:lang="la">Quę nunc in <placeName ref="l834">Italia</placeName> <lb xml:id="p1z28"/>agitantur, a me paucis intelliges.</s>
					<s n="7" xml:lang="la">Ante quatuor <lb xml:id="p1z29"/>dies falsus ad nos pervenerat rumor, nempe <lb xml:id="p1z30"/><persName ref="p6724">Petrum Strocium</persName> cum <placeName ref="l648">Rethis</placeName> omnibus occubuisse; <lb xml:id="p1z31"/>id ad vos quoque permanasse suspicor.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Sed longe <lb xml:id="p1z32"/>alia veritas; nam heri mercatores fide digni <lb xml:id="p1z33"/>ad nos appulerunt nunciantes omnia <persName ref="p6724">Petri Strocii</persName> <lb xml:id="p1z34"/>ac <placeName ref="l648">Rhetorum</placeName> prospera succedere, multa castella ab <lb xml:id="p1z35"/><placeName ref="l875">Hyspanis</placeName> obsessa in <placeName ref="l462">Senensium</placeName> ditione <lb xml:id="p1z36"/>ipso <persName ref="p6724">Strocio</persName> vi capta, in quibus quadringenti <pb/><lb xml:id="p2z1"/><placeName ref="l875">Hyspani</placeName> trucidati dicuntur multique capti.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Populis <lb xml:id="p2z2"/>vero <placeName ref="l1098">Florentinis</placeName> desideratissima libertas promittitur <lb xml:id="p2z3"/>nullisque eorum, quantum fieri potest, iniuria <lb xml:id="p2z4"/>infertur, adeo ut spes sit, non solum <placeName ref="l462">Senenses</placeName> <lb xml:id="p2z5"/>liberari posse, sed etiam <placeName ref="l1098">Florentinos</placeName> ad <placeName ref="l832">Gallum</placeName> <lb xml:id="p2z6"/>defecturos.</s>
					<s n="10" xml:lang="la">In <placeName ref="l736">Pedemontana</placeName> terra planicium <lb xml:id="p2z7"/>omnem obtinent <placeName ref="l832">Galli</placeName> nemine prohibente, Cęsariensium <lb xml:id="p2z8"/>segetes, fenum reliquosque commeatus omnes dirripiunt <lb xml:id="p2z10"/>asportantque et, ut uno verbo dicam, omnia <lb xml:id="p2z12"/><placeName ref="l832">Gallis</placeName> ex voto succedunt.</s>
					<s n="11" xml:lang="la">Hęc pauca tibi <lb xml:id="p2z13"/>scribenda censui eaque vera omnia; si quid <lb xml:id="p2z14"/>insuper evenerit memoria dignum, de eodem <lb xml:id="p2z15"/>quoque te certiorem facere conabor.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale.</s>
					<s n="13" xml:lang="la" ana="salute">Salutant <lb xml:id="p2z16"/>te viri pii dominus <persName ref="p2336">Bernardinus Occhinus</persName> ac <lb xml:id="p2z17"/><persName ref="p2019">Augustinus Maynardus</persName> et <persName ref="p8022">Niger</persName>.</s>
					<s n="14" xml:lang="la">Gratia domini <lb xml:id="p2z18"/>Iesu Christi cum omnibus vobis.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z19"/><placeName ref="l93">Clavenę</placeName> 3. idus <lb xml:id="p2z20"/>iulii.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Humanitatis tę <lb xml:id="p2z22"/>deditissimum mancipium <lb xml:id="p2z26"/><persName ref="p8168">Antonius Marius Besutius</persName><lb xml:id="p2z34"/>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro <lb xml:id="p4z2"/>domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p4z3"/>antistiti <placeName ref="l587">Tigurino</placeName>, domino <lb xml:id="p4z4"/>meo colendissimo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p4z5"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>