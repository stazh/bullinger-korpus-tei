	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nihil habeo neque publici neque privati, quod scribam <lb xml:id="p1z2"/>in praesentiarum, quod te scire referat, humanissime d. compater, <lb xml:id="p1z3"/>nisi quod literas illas a quodam, qui ex <placeName ref="l734">Frysia</placeName> venit, acceptas <lb xml:id="p1z4"/>ad te mitto; deinde, quod forte miraberis, <persName ref="p6168">Rappensteinium</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p6168">Andreas</persName> oder <persName ref="p21378">Salomon Rappenstein</persName>? Vgl. Lohner 212. Näheres im Berner Ratsmanual? (Auszüge in Bern Burgerbibl., Ms. Hist. helv. XI 43).</note> <lb xml:id="p1z5"/>nostrum vocatum esse ad ministerium ecclesiasticum et praefectum <lb xml:id="p1z6"/>ecclesiae <placeName ref="l1019">Frutingensi</placeName>.</s>
					<s n="3" xml:lang="la" ana="salute">Salutat te tuosque mea familia, <persName ref="p8417">Mu<lb xml:id="p1z7"/>sculus</persName> quoque cum sua, qui nondum omnino convaluit ex sua erysipela<lb xml:id="p1z8"/>.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Iodocus ad thermas quasdam in summa <placeName ref="l41">Bernensis</placeName> <lb xml:id="p1z9"/>ditionis parte concessit.</s>
					<s n="5" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><placeName ref="l41">Bernae</placeName> 19. iunii 1550.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Illud etiam adiiciam m. <persName ref="p21377">Conradum Svertzenbach</persName>, civem et senatorem <lb xml:id="p1z11"/><placeName ref="l587">Tigurinum</placeName>, hic graviter et laetaliter decumbere; vergit <lb xml:id="p1z12"/>morbus in hydropisin; paratus est mori, expectat hodie <lb xml:id="p1z13"/>adventum uxoris suae.</s>
					<s n="8" xml:lang="la">Dominus illum confirmet et transferat <lb xml:id="p1z14"/>ad regnum suum coeleste.</s>
					<s n="9" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">T[uus<lb xml:id="p1z15"/>] <persName ref="p8018">Io[annes] Hallerus</persName><lb xml:id="p1z16"/>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo praestantissimoque <lb xml:id="p2z2"/>viro d. <persName ref="p495">Heinrycho Bul<lb xml:id="p2z3"/>lingero</persName>, domino et compatri <lb xml:id="p2z4"/>suo venerando.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
