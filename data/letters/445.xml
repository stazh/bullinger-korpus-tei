	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Ad hunc usque diem, <persName ref="p495">Bullingere</persName> in domino charissime, <lb xml:id="p1z2"/>nihil actum et constitutum est in caussa vocationis <lb xml:id="p1z3"/>meae; desunt enim plerique domini, quorum praesentia <lb xml:id="p1z4"/>ad hanc rem desyderatur.</s>
					<s n="3" xml:lang="la">Et <persName ref="p8018">Hallerus</persName> quoque a<lb xml:id="p1z5"/>best, ut audio ultra <placeName ref="l280">Lausannam</placeName> <placeName ref="l167">Gebennam</placeName> quoque <lb xml:id="p1z6"/>petiit, expectatur tamen ad crastinum.</s>
					<s n="4" xml:lang="la">Heri et <lb xml:id="p1z7"/>hodie comparui in senatu, sed frustra ob <lb xml:id="p1z8"/>supradictas causas.</s>
					<s n="5" xml:lang="la">Hac hora iussus sum comitem <lb xml:id="p1z9"/>meum ad vos remittere, quem cum honorario <lb xml:id="p1z10"/>2 florenorum ultra solutionem sumptuum dimiserunt.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Itaque dimisso illo hic expecto, quid statuat senatus.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>inteea commendo fidei tuę uxorem ac liberos <lb xml:id="p1z13"/>meos.</s>
					<s n="8" xml:lang="la">Ut apparet, non sum reversurus ad <lb xml:id="p1z14"/>vos nisi peractis synodis, ut verisimile <lb xml:id="p1z15"/>sit mansurum me hic ad spatium 3 septi<lb xml:id="p1z16"/>manarum.</s>
					<s n="9" xml:lang="la">Uxor non satis habebit pecunię; <lb xml:id="p1z17"/>nam 2 tantum florenos illi dedi, cum abirem.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Oro igitur, ut, si necesse fuerit, des illi, <lb xml:id="p1z19"/>quantum necessitas requiret.</s>
					<s n="11" xml:lang="la">Ubi rediero, <lb xml:id="p1z20"/>reddam bona fide.</s>
					<s n="12" xml:lang="la" ana="farewell">Optime vale, virorum <lb xml:id="p1z21"/>charissime.</s>
					<s n="13" xml:lang="la" ana="salute">Salutem toti domui tuę et reliquis <lb xml:id="p1z22"/>dominis ac fratribus meis, D. <persName ref="p8127">Pellicano</persName>, D. <persName ref="p8171">Theodoro</persName> <lb xml:id="p1z23"/>et <persName ref="p8011">Gualtero</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Salutant te fratres hic et <persName ref="p3700">Eberhardus</persName> <lb xml:id="p1z24"/>quoque, <placeName ref="l41">Bernę</placeName> 26. Februarii 1549.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><persName ref="p8417">W[o<lb xml:id="p1z25"/>lfgangus] Musculus</persName>, tuus <lb xml:id="p1z26"/>in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo M. <persName ref="p495">Heinrich<lb xml:id="p2z3"/>o Bullingero</persName>, <lb xml:id="p2z4"/>domino ac fratri <lb xml:id="p2z5"/>in Christo longe <lb xml:id="p2z6"/>charissimo.</s>
					<s n="17" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
