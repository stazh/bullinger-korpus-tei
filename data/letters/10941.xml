	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Im Jahr nach dem Besuch <persName ref="p7604" cert="high">Balthasars von Kuenring</persName>; vgl. unten Z. 2-4 mit Anm. 3.</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Scripsit ad me literas<note xml:id="fn2" type="footnote" n="2">Nicht erhalten.</note> <persName ref="p7604">Balthassar baro ille a Khienring</persName>, <lb xml:id="p1z3"/>qui anno iam lapso, ni fallor, apud vos <lb xml:id="p1z4"/>fuit<note xml:id="fn3" type="footnote" n="3">Vgl. <persName ref="p4079">Zwicks</persName> Empfehlungsschreiben für <persName ref="p7604">Balthasar von Kuenring</persName> vom 25. August 1535 (<bibl source="b7">HBBW V</bibl>, <ref target="file10670">Nr. 632</ref>).</note>, ecclesiae scilicet videndae et consilii petendi causa.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Et quod tunc mecum agebat pręsens, nunc quoque <lb xml:id="p1z6"/>literis agit idque perquam anxie.</s>
					<s n="4" xml:lang="la">Inter caetera sic <lb xml:id="p1z8"/>scribit: "Quotienscumque apud<note xml:id="fnb" type="footnote" n="b">apud <hi>über der Zeile nachgetragen.</hi></note> animum meum perpendo, qualis <lb xml:id="p1z9"/>mihi incumbat provintia regendi, quos mihi deus <lb xml:id="p1z10"/>credidit, non aliud invenire possum, quam eum tum <lb xml:id="p1z11"/>demum digne gubernacula suscepisse, qui non tantum cor<lb xml:id="p1z12"/>poribus externisque bonis praesit, verum etiam et <lb xml:id="p1z13"/>multo magis, ut animi subditorum verbo vivo <lb xml:id="p1z14"/>inbuantur, ut multi lucrifiant, curam agat.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Quapropter, mi <persName ref="p4079">Zvicci</persName>, hunc nuntium<note xml:id="fn4" type="footnote" n="4">Unbekannt.</note> ad te mitto, <lb xml:id="p1z16"/>summa fide et animo<pb type="edition" next="436"/> syncero abs te requiro, ut <lb xml:id="p1z17"/>aliquem ad me mitti procures, qui plebeculam <lb xml:id="p1z18"/>meam pascat.</s>
					<s n="6" xml:lang="la">Talem autem esse cupio iuxta <lb xml:id="p1z19"/>Pauli doctrinam etc., maxime, qui tempori se <lb xml:id="p1z20"/>accomodare nosset, quemadmodum et apostolorum <lb xml:id="p1z21"/>princeps omnibus omnia fuit<note xml:id="fn5" type="footnote" n="5">Vgl. <cit type="bible"><ref>1Kor 9, 22</ref></cit>.</note>, ut Christo non nullos <lb xml:id="p1z22"/>lucrifaceret, Timotheum denique circumcidit<note xml:id="fn6" type="footnote" n="6">Vgl. <cit type="bible"><ref>Apg 16, 1-3</ref></cit>.</note>; <lb xml:id="p1z23"/>qui Christo charius haberet nihil, quem neque mors <lb xml:id="p1z24"/>neque vita a salvatore avelleret.</s>
					<s n="7" xml:lang="la">Nam et ipse <lb xml:id="p1z25"/>ego cuperem sanguinem meum in Christi gloriam <lb xml:id="p1z26"/>effundi, si dignus martirio reperirer.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z27"/>Intelligite vocationem vestram, subvenite his, qui <lb xml:id="p1z28"/>ad verbum dei audiendum avidi sunt; mittite, qui <lb xml:id="p1z29"/>et apud nos seminent spiritualia.</s>
					<s n="9" xml:lang="la">Quod ad stipendium <lb xml:id="p1z30"/>adtinet: Quod pręsens pollicitus sum et <lb xml:id="p1z31"/>maiora Dabo etc.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z32"/>Expecto autem tuum responsum,<pb type="scan" next="||569v."/> <pb/><lb xml:id="p2z1"/>neque me fallet spes mea, quin verbi dei ministrum <lb xml:id="p2z2"/>recipiam" etc.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z3"/>Nunc fac, sciam per hunc tabellionem<note xml:id="fn7" type="footnote" n="7">Unbekannt.</note>, si quis<note xml:id="fnc" type="footnote" n="c">quis <hi>aus</hi> quispiam <hi>oder</hi> quisquam <hi>korrigiert.</hi></note> <lb xml:id="p2z4"/>apud vos sit, qui a me posset mitti viro <lb xml:id="p2z5"/>isti optimo.</s>
					<s n="12" xml:lang="la">Caeterum opus esset illum ingenium <lb xml:id="p2z6"/>habere placidum et aequum et omnino tollerantissimam <lb xml:id="p2z7"/>animam.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Non plura possum.</s>
					<s n="14" xml:lang="la">Accingo enim me <lb xml:id="p2z8"/>profectioni ad <persName ref="p8055">Ambrosium</persName><note xml:id="fn8" type="footnote" n="8">Zu <persName ref="p4079">Zwicks</persName> Treffen mit <persName ref="p8055">Ambrosius Blarer</persName> und <persName ref="p2095">Melanchthon</persName> in <placeName ref="l512">Tübingen</placeName> s. unten <ref target="file10944">Nr. 902</ref> und 908, 2-10.</note> etc.</s>
					<s n="15" xml:lang="la">Ora pro <lb xml:id="p2z9"/>me et rescribe<note xml:id="fn9" type="footnote" n="9"><persName ref="p495">Bullingers</persName> Antwort ist nicht erhalten.</note>.</s>
					<s n="16" xml:lang="la">Deinde obsecro, ut epistolam <lb xml:id="p2z10"/>meam descriptam ad me mittas coniuncta<note xml:id="fnd" type="footnote" n="d"><hi>nach</hi> coniuncta <hi>gestrichenes</hi> ea.</note>, <lb xml:id="p2z11"/>quam <persName ref="p1753">Leo</persName><note xml:id="fn10" type="footnote" n="10"><persName ref="p1753">Leo Jud</persName>.</note> in <placeName ref="l822">Germanicum</placeName> vertit<note xml:id="fn11" type="footnote" n="11">Oben <ref target="file10920">Nr. 879</ref>; vgl. oben <ref target="file10927">Nr. 886</ref>, 10f.</note>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Vale, vale, <lb xml:id="p2z13"/>mi frater in Christo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z14"/>5. <lb xml:id="p2z15"/>octobris.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z16"/>Tuus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse darunter:]</note>
					<s n="20" xml:lang="la"><lb xml:id="p2z17"/>Domino <persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z18"/><placeName ref="l587">Tigurina<lb xml:id="p2z19"/>e</placeName> e<lb xml:id="p2z20"/>cclesiae ministro, <lb xml:id="p2z21"/>fratri optimo.</s>
				</p>
			</div>
		</body>
