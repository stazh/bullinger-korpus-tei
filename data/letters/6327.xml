	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Reverendi, charissimi et ornatissimi <lb xml:id="p1z2"/>viri, domini observandi, salutem et offitiorum <lb xml:id="p1z3"/>meorum commendationem.</s>
					<s n="2" xml:lang="la">Dum responsum <lb xml:id="p1z4"/>ad proxime missas a principe meo <lb xml:id="p1z5"/>seniore literas ab excell. vestris <lb xml:id="p1z6"/>expecto, superveniunt aliae, quas per <lb xml:id="p1z7"/>praesentem excell. vestris transmitto <lb xml:id="p1z8"/>et vehementer rogo, cum pestem illic <lb xml:id="p1z9"/>mitius agere audiam, ut propter <lb xml:id="p1z10"/>ecclesiam Christi tantum laboris sumant <lb xml:id="p1z11"/>et responsum suum ad priores et ad has <lb xml:id="p1z12"/>literas maturent simulque <placeName ref="l167">Genevenses</placeName> <lb xml:id="p1z13"/>urgeant, ut idem facere non dedignentur.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z14"/>Demerebuntur excell. <lb xml:id="p1z15"/>vestrae hoc pacto sibi bonum princ<lb xml:id="p1z16"/>ipem de religionis concordia plane <lb xml:id="p1z17"/>pio zelo laborantem, quod non dubito <lb xml:id="p1z18"/>excell. vestras brevi facturas <lb xml:id="p1z19"/>propter gloriam dei et immor<lb xml:id="p1z20"/>talitatem famę suae, quam sibi hoc modo <lb xml:id="p1z21"/>sicut aliis piis vigiliis et curis compa<lb xml:id="p1z23"/>rabunt.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Quod onus eo confidentius non <lb xml:id="p1z24"/>dubito excell. vestras subituras, <lb xml:id="p1z25"/>quod proximis suis literis mag<lb xml:id="p1z26"/>nam mihi spem eius rei fecerint.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Me <lb xml:id="p1z27"/>commendo rev. excell. vestris.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Dat. <placeName ref="l512">Tubingae</placeName> <lb xml:id="p1z28"/>8. decembris raptissime 1564.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z29"/>Excellentiarum vestrarum studiosissimus <lb xml:id="p1z30"/><persName ref="p3655">Baltasar a Lewalt</persName>, iunioris <lb xml:id="p1z31"/>principis <persName ref="p8117">Radziwili</persName> etc.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p4z1"/>Reverendis, clarissimis et o<lb xml:id="p4z2"/>rnatissimis viris dominis <lb xml:id="p4z3"/>superintendenti, senio[<lb xml:id="p4z4"/>ribus] et ministris eccle[siae] <lb xml:id="p4z5"/><placeName ref="l587">Tigurinae</placeName> etc., domin<lb xml:id="p4z6"/>is et amicis obser<lb xml:id="p4z7"/>vandissimis.</s>
					<s n="9" xml:lang="la"><lb xml:id="p4z8"/>Cito.</s>
				</p>
			</div>
		</body>
	</text>
