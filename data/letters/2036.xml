	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. <lb xml:id="p1z2"/>P. D.</s>
					<s n="2" xml:lang="la">Etsi nihil occurrat modo, <persName ref="p495">Bullingere</persName> ornatissime, quod <persName ref="p3099">Sul<lb xml:id="p1z3"/>zeri</persName> nostri (qui <persName ref="p6589">Serveti</persName> negotium, quomodo apud nos trans<lb xml:id="p1z4"/>actum sit, enarrabit) literis addendum putem, attamen cum scire <lb xml:id="p1z5"/>percupias, quid librorum a <placeName ref="l28">Basiliensibus</placeName> typographis ad elaps<lb xml:id="p1z6"/>um mercatum <placeName ref="l157">Francfordianum</placeName> sit excusum: dedit nobis officina <lb xml:id="p1z7"/><persName ref="p8126">Oporiniana</persName> <persName>Ioannis Dugonis</persName> Philoini Tilianam sive de be<lb xml:id="p1z8"/>ne moriendi scientia libellum, <persName ref="p8417">Musculi</persName> explanationem <lb xml:id="p1z9"/>in decalogum praeceptorum dei, <persName>Engelberti</persName> abbatis <placeName>Admontensis</placeName> <lb xml:id="p1z10"/>(qui sub <persName ref="p20126">Rodolpho Habspurgico</persName> vixit) de ortu et fine Ro<lb xml:id="p1z11"/>mani imperii librum, <persName>Cydonii</persName> de contemnenda morte orationem <lb xml:id="p1z12"/>et <persName>Hermiae</persName> philiosophi irrisionem gentilium philosophorum cum trans<lb xml:id="p1z13"/>latione <persName ref="p8430">Raphaelis Seyleri</persName>, <persName>Postelli</persName> de originibus libellum, <lb xml:id="p1z14"/><persName ref="p17836">Bruschii</persName> historiam de <placeName>Laureaco</placeName> veteri, quam <persName ref="p5626">Wolffgangus <lb xml:id="p1z15"/>Lazius</persName>, historicus et medicus regius, furto sibi ablatam scribit, <lb xml:id="p1z16"/>Novum Testamentum a Castaleone versum, Ptolemaei de praedicationibus <lb xml:id="p1z17"/>astronomicis librum <persName ref="p2095">Philippo Melanchthone</persName> interprete, Con<lb xml:id="p1z18"/>ciliorum omnium canones per <persName ref="p1882">Ioannem Sagittarium</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p1882">Jean L'Archer</persName>, s. <bibl source="b14">HBBW XI</bibl>.</note> <placeName ref="l1765">Burdegalensem</placeName> <lb xml:id="p1z19"/>collectas, <persName>Theodori</persName> vestri monarchiae Romanae <lb xml:id="p1z20"/>vaticinium et de restituenda pace in regno <placeName ref="l822">Germanico</placeName> <lb xml:id="p1z21"/>orationem, <persName>Cuspiniani</persName> consules et quaedam alia antea quoque <lb xml:id="p1z22"/>excusa.</s>
					<s n="3" xml:lang="la">Officina autem <persName ref="p8353">Frobeniana</persName> in recudendis patribus <lb xml:id="p1z23"/>occupata dedit tantum <persName ref="p6125">Angeli Politiani</persName> omnia opera et <lb xml:id="p1z24"/>Psalterium <placeName>Campensis</placeName>, iam vero occupata est Philonis Iudei <lb xml:id="p1z25"/>operibus a <persName ref="p18340">Sigismundo Gelenio</persName> Latinitate donatis, in <lb xml:id="p1z26"/>que iam indicem paro.</s>
					<s n="4" xml:lang="la">Functii Chronicon ante proximas <lb xml:id="p1z27"/>nundinas non absolvetur.</s>
					<s n="5" xml:lang="la">Tu igitur si quid ex enumeratis <lb xml:id="p1z28"/>placuerit, fac ut proximis literis sciam, et mittam quam <lb xml:id="p1z29"/>primum oportunitas oblata fuerit.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
					<s n="7" xml:lang="la"><placeName ref="l28">Basileae</placeName> 15. <lb xml:id="p1z30"/>octobris anno <lb xml:id="p1z31"/>1553.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Salutabis autem meo nomine <lb xml:id="p1z32"/>d. <persName ref="p8127">Pellicanum</persName> avunculum, cui iam scribere non vacat, <persName ref="p8171">Bibliandrum</persName>, <lb xml:id="p1z33"/><persName ref="p8011">Gvaltherum</persName> et reliquos fratres.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z34"/>T[uus] <persName ref="p8406">Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>antistiti, amico ac fratri charissimo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
