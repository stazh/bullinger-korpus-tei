	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Per Christum Iesum.</s>
					<s n="2" xml:lang="la">S. D.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Vidi, <persName ref="p495">Bullingere</persName>, mi iucundissime simul et observandissime, quae <lb xml:id="p1z3"/>dexteritate ac pietate, quae mihi videbantur in vestro scripto <lb xml:id="p1z4"/>duriora, mollieris et declararis.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Qua ostendis satis aperte te nolle <lb xml:id="p1z5"/>illa tueri nisi in eo sensu, qui divinis scriptis et testimoniis <lb xml:id="p1z6"/>sit maxime consentaneus.</s>
					<s n="5" xml:lang="la">Qua in sententia me quoque <lb xml:id="p1z7"/>esse ex proximis meis literis potuisti non obscure cognoscere.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Quodsi tamen ea verba et locutiones in contentionem adducantur, <lb xml:id="p1z9"/>malim ea perdere quam veram et germanam divinarum <lb xml:id="p1z10"/>autoritatum sententiam obscurari, et contra ea retinere <lb xml:id="p1z11"/>et aliquo dignari loco non gravarer, si illis reiectis <lb xml:id="p1z12"/>et amissis una etiam partem aliquam religionis labefactari <lb xml:id="p1z13"/>necesse esset.</s>
					<s n="7" xml:lang="la">Rerum enim ratio primo loco habenda est, <lb xml:id="p1z14"/>deinde verba sunt adhibenda, quę rem illustrent, non obscurent.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Quod quidem, optime ac doctissime frater, non scribo, ut te <lb xml:id="p1z16"/>vel doceam vel admoneam, qui longe melius ista mihi <lb xml:id="p1z17"/>possis subiicere quam ego tibi; sed haec scribo, ut intelligas <lb xml:id="p1z18"/>mihi minimam esse curam verborum, rerum maximam.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/>Quare, ut paucis dicam, mihi vix fas esse duco ac <lb xml:id="p1z20"/>ne fas quidem omnino ab eo, quod ipse probaris, dissentire.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Me igitur comitem habebis tuae sententiae, ut voles.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Quod <lb xml:id="p1z22"/>autem liberius, quid sentiam, scripsi, effecit meus nativus <lb xml:id="p1z23"/>candor et tua erga me perspecta benevolentia.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Vale <lb xml:id="p1z24"/>et ex nobis tuam honestissimam familiam officiose saluta et <lb xml:id="p1z25"/>me semper, ut facis, ama.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l28">Basileae</placeName> 26. augusti 1549.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p714">Caelius <lb xml:id="p1z27"/>S[ecundus] C[urio]</persName> subs<lb xml:id="p1z28"/>cripsit, ex animo tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro D. <lb xml:id="p2z2"/><persName ref="p495">He[n]richo Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> [pa]sto<lb xml:id="p2z4"/>ri vigilantissimo, <lb xml:id="p2z5"/>patrono singulari.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
