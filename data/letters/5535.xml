	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Min guͦttwillig uinst zefer, lieber
					<lb xml:id="p1z2"/>und guͦtta frewndt, ewer mir mmge
					<lb xml:id="p1z3"/>in fürgeschriffen gon Franckfurt darck
					<lb xml:id="p1z4"/>ich euch zw dem röchsten, das ich euch
					<lb xml:id="p1z5"/>dadane augs meitt geschriben, ist, o
					<lb xml:id="p1z6"/>deslich, das wir so gar neiet gewussen
					<lb xml:id="p1z7"/>venemen handt des zuschreiben, verdr
					<lb xml:id="p1z8"/>gewessen hab mich des selbs verwondert
					<lb xml:id="p1z9"/>von religion sache, wiewol fil lerert
					<lb xml:id="p1z10"/>wrolgehaffet, ist dach ger wenget gehein
					<lb xml:id="p1z11"/>Es haben die chur und fursten
					<lb xml:id="p1z12"/>inmal fingenomen umn froo sicheren
					<lb xml:id="p1z13"/>gegen dem keysser ze handlen erhat sir
					<lb xml:id="p1z14"/>aber känceln gestalt wellen inlassen
					<lb xml:id="p1z15"/>anderst; dan es sige im dr ruch ein
					<lb xml:id="p1z16"/>gemuner religions friden ufgericht disß
					<lb xml:id="p1z17"/>sollent si sich halte, daran welle
					<lb xml:id="p1z18"/>kan vehinderorg oder intrag than
					<lb xml:id="p1z19"/>desse in sune.
					<lb xml:id="p1z20"/>Gorgagen weller er sich
					<lb xml:id="p1z21"/>elande ouch nach seine gefallen haben.
					<lb xml:id="p1z22"/>und si hermn erastlichiste gefelten wellen
					<lb xml:id="p1z23"/>im nit weitter anmutte, dan in far
					<lb xml:id="p1z24"/>frindlong welle er sich nit mlassen und
					<lb xml:id="p1z25"/>irem hahssen bezaget bi sinner hergeprach
					<lb xml:id="p1z26"/>Darbi ist er
					<lb xml:id="p1z27"/>Peligen vell e stidium
					<lb xml:id="p1z28"/>Darff weider wirder kunig noch
					<lb xml:id="p1z29"/>slibi.
					<lb xml:id="p1z30"/>fursc in gedencken. Also gidenck
					<lb xml:id="p1z31"/>aramus, i herer. non rupporsta
					<lb xml:id="p1z32"/>fürnemen, der one mittel undr damhi
					<lb xml:id="p1z33"/>s bird.
					<lb xml:id="p1z34"/>possum allus vet.
					<lb xml:id="p1z35"/>Ostraicus .
					<pb/>
					<lb xml:id="p2z1"/>um sunst sin werde ouch mine hu
					<lb xml:id="p2z2"/>wie ir wüst nit stat haben w
					<lb xml:id="p2z3"/>nut deim herre got befelch
					<lb xml:id="p2z4"/>epen
					<lb xml:id="p2z5"/>grucker den
				</p>
