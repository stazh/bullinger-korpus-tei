	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z6"/>Vir clarissime, credo d. legatum esse sincerum virum, <lb xml:id="p1z7"/>praestare autem, quae promittit.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Promissit mihi sancte <lb xml:id="p1z8"/>pecuniam; cur non credam me habiturum, cum tibi prae<lb xml:id="p1z9"/>sertim dederit bona verba.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Non nocet scripsisse.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>Salve, <persName ref="p495">Bullingere</persName> optime, deus te servet cum tota fa<lb xml:id="p1z11"/>milia, schola atque ecclesia.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Valeo ego quidem; si vales, <lb xml:id="p1z12"/>bene est.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Acceperam tuas litteras <placeName ref="l646">Claronenses</placeName>, quae <lb xml:id="p1z13"/>magna me laetitia affecerunt.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Laudetur deus; triumphat il<lb xml:id="p1z14"/>lustrissimus, qui optime valet.</s>
					<s n="8" xml:lang="la">Gratia et pax <lb xml:id="p1z15"/>domini nostri <lb xml:id="p1z16"/>Iesu Christi tecum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/>Si mittenda pecunia, mittatur peculiarem <placeName ref="l512">Tubingam</placeName> <lb xml:id="p1z18"/>ad filium <persName>Cellarii</persName>, notissimi hominis, <persName>Rudolphi Riepi</persName>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/><placeName ref="l512">Tubingae</placeName> 5. augusti 1564.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurino</placeName> antis<lb xml:id="p2z3"/>titi, fratri honorando.</s>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
