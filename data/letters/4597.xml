	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hodie primum advenit hic nuncius vester; <lb xml:id="p1z2"/>nunc iterum discedit, ut neminem interea <lb xml:id="p1z3"/>senatorum, qui nondum pransi sunt, convenire <lb xml:id="p1z4"/>potuerim.</s>
					<s n="3" xml:lang="la">Audio tamen a senatu responderi <lb xml:id="p1z5"/>vestratibus; audio et <persName ref="p3494">Diesbachium</persName> nostrum <lb xml:id="p1z6"/>ipsum scripturum ad te.</s>
					<s n="4" xml:lang="la">Ego nihil aliud ad<lb xml:id="p1z7"/>huc ex <placeName ref="l832">Gallia</placeName> habeo, quam <persName>Vandomio</persName> gu<lb xml:id="p1z8"/>bernationem regni commissam, donec status <lb xml:id="p1z9"/>regni conveniant et de administratione de<lb xml:id="p1z10"/>inceps regno certi aliquid constituant.</s>
					<s n="5" xml:lang="la">Concil<lb xml:id="p1z11"/>ii nullam audimus fieri mentionem; disiecit <lb xml:id="p1z12"/>sine dubio dominus iterum mirabiliter <lb xml:id="p1z13"/>multa hostium consilia per mortem regis.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Sperant nostri quoque facilius nunc cum <lb xml:id="p1z15"/><persName>Allobrogo</persName> transigi posse.</s>
					<s n="7" xml:lang="la">Ex <placeName ref="l167">Geneva</placeName> nihil <lb xml:id="p1z16"/>habemus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName>Vallis Angronię</placeName> incolas deletos <lb xml:id="p1z17"/>audiveramus ipsi quoque; sed ex archigrammat<lb xml:id="p1z18"/>aeo nostro <persName ref="p4610">Gyrono</persName> habeo falsum hoc esse, <lb xml:id="p1z19"/>redemisse vero eos pacem ingenti pecunia.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>Quibus tamen hoc factum sit conditionibus, referre <lb xml:id="p1z21"/>non potuit.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Literas <placeName>Stetensis</placeName> remitto et <lb xml:id="p1z22"/>ago tibi gratias.</s>
					<s n="11" xml:lang="la">Accepimus nos quoque his diebus <lb xml:id="p1z23"/>ex <placeName ref="l18">Augusta</placeName> literas eadem propemodum continentes.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/>Palatinus ad <persName ref="p8417">Musculum</persName> scribit et gratias illi agit <lb xml:id="p1z25"/>pro dedicatione <persName>Locorum</persName> communium.</s>
					<s n="13" xml:lang="la">Per <persName ref="p8075">Erastum</persName> <lb xml:id="p1z26"/>offert operam suam, si necessaria sit in compositione <lb xml:id="p1z27"/>cum <persName>Philiberto</persName> <placeName ref="l736">Pedemontio</placeName>.</s>
					<s n="14" xml:lang="la">Gaudeo <lb xml:id="p1z28"/>sub ipso nostros esse in precio et veritatem promoveri.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z29"/>Aedidit nunc quidam <persName>Locos</persName> quosdam ex <persName ref="p2095">Melanchthon<lb xml:id="p1z30"/>is</persName> pię memorię operibus collectos, quibus probare <lb xml:id="p1z31"/>conatur illum contra nos scripsisse; sic fiet, <lb xml:id="p1z32"/>ut, dum ille paci nimium studuit, maioribus <lb xml:id="p1z33"/>contentionibus occasionem dedisse videatur.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z34"/>Quęlibet enim pars se ipsius authoritate tueri <lb xml:id="p1z35"/>conabitur.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Valet tamen illud praecipui, quod posterius <lb xml:id="p1z36"/>sensit, et quamvis hoc non valeret, praevalet <lb xml:id="p1z37"/>tamen omnibus veritas.</s>
					<s n="18" xml:lang="la">Eam dominus dilatet et propaget <lb xml:id="p1z38"/>per universum mundum.</s>
					<s n="19" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="20" xml:lang="de">Die von <placeName ref="l160">Fryburg</placeName> <lb xml:id="p1z39"/>habend min herren gantz früntlich ghalten, sich <lb xml:id="p1z40"/>über die maß vil erbotten; dwort sind guͦt, <lb xml:id="p1z41"/><foreign xml:lang="la">sed exitus acta probabit.</foreign></s>
					<s n="21" xml:lang="la" ana="farewell">Bene vale, vir colen<lb xml:id="p1z42"/>dissime, imo ut optime valeas, dominum ex animo oro; <lb xml:id="p1z43"/>doleo enim, quod audio te minus bene habere.</s>
					<s n="22" xml:lang="la"><lb xml:id="p1z44"/>Servet te dominus ecclesiarum nostrarum necessitatibus <lb xml:id="p1z45"/>incolumem quam diutissime.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Precor tibi tuisque <lb xml:id="p1z46"/>omnibus annum foelicissimum.</s>
					<s n="24" xml:lang="la" ana="salute">Salutat te <persName ref="p8417">Musculus</persName>, <lb xml:id="p1z47"/>qui hisce diebus et ipse scripsit ad te.</s>
				</p>
				<p>
					<s n="25" xml:lang="la" ana="salute">Salutant te <lb xml:id="p1z48"/>amici et fratres omnes, nominatim d. <persName>Emanuel</persName>; <lb xml:id="p1z49"/>reliquorum nullos adhuc hodie convenire potui.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><placeName ref="l41">Bernę</placeName> <lb xml:id="p1z50"/>27. decembris ineuntis anni 61.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p1z51"/><persName ref="p8018">I[oannes] <lb xml:id="p1z52"/>H[allerus</persName>] <lb xml:id="p1z53"/>tuus.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino <lb xml:id="p2z4"/>suo et compatri perpetuo <lb xml:id="p2z5"/>colendo.</s>
				</p>
			</div>
