	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non potui iam per scribam reipublicae nostrae remittere, quae miseras, qui etiam scholarcha <lb xml:id="p1z2"/>est, Germanico nomine dicitur <foreign xml:lang="de">underschryber,</foreign> sed brevi et certo recipies.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Caeterum tui nominis mentionem nullam feci; attamen d. consuli <persName>Peyero</persName>, qui primus est scho<lb xml:id="p1z4"/>larcharum, indicavi, quae ad me scripta sint de <persName>Schaltenbrandio</persName>.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Id quod ideo feci, <lb xml:id="p1z5"/>si quando senatores rudiores (tecum loquor) certiores fierent, forsan conarentur <lb xml:id="p1z6"/>omnia evertere.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Decretum itaque scholarcharum et summa petitio est, ut praesente <lb xml:id="p1z7"/><persName ref="p5307">Ioanne Oschvaldo Huͦbero</persName>, qui significavit, quando adesse queat, tua humanitas convocet <lb xml:id="p1z8"/>in auditorium, qui convocandi sunt, exprobretisque prodigalitatem, negligentiam, circumva<lb xml:id="p1z9"/>gationem inveni, si brevi quid huiusmodi de illo audietur, eum experturum, quali animo <lb xml:id="p1z10"/>sint nostrates erga huiusmodi.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Hinc coram profiteatur, an duxerit vel <lb xml:id="p1z11"/>se ducturum promiserit filiam <persName>Grübelii</persName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">De his omnibus per <persName>Huͦberum</persName> scholarchas <lb xml:id="p1z12"/>reipublicae nostrae certiores facere non dedignemini, summopere rogant.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Urget <lb xml:id="p1z13"/>summa necessitas, ut dispiciatur de vita, moribus, studiis nostrorum; promittunt <lb xml:id="p1z14"/>interim, si par pari referre nequeunt, se ingratos nunquam futuros.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z15"/>Consul <persName ref="p6234">Ringgius</persName> multum celebravit apud nos tuam et d. <persName ref="p8011">Gvaltheri</persName> humanitatem, <lb xml:id="p1z16"/>vestro etiam nomine me salvere iussit; praedicat beneficia ei aliisque <placeName>Schaffhusianis</placeName> <lb xml:id="p1z17"/>ibidem praestita; dominus rependat.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Non dubito, ut dixi, nostros ingratos nunquam <lb xml:id="p1z18"/>futuros.</s>
					<s n="11" xml:lang="la">Sed desino iam.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale in Christo, qui te diu incolumem nobis conservet.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z19"/>Minantur omnia ruinam; nulla alia nova habeo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Saluta meo nomine omnes, <lb xml:id="p1z20"/>qui de me percontabuntur.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z21"/><placeName ref="l441">Schaffhusiae</placeName> 22. iunii 1563.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z22"/>Tuae humanitati deditissimus <persName ref="p2757">Iacobus <lb xml:id="p1z23"/>Ruͤger</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo et doctissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, antistiti ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> vigilantissimo, domino suo et <lb xml:id="p2z4"/>fratri in Christo plurimum observando.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
