	<text xml:lang="de">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Die gnad gottes mitt unns allen.</s>
					<s n="2" xml:lang="de">Amen.</s>
				</p>
				<p>
					<s n="3" xml:lang="de">Gelieptter herr und bruͦder, dess handels<note xml:id="fn1" type="footnote" n="1">Angelegenheit, Sache (<bibl source="b590">SI</bibl> II 1397).</note> der <lb xml:id="p1z2"/>schencky halb herr <persName ref="p2816">Rösten</persName><note xml:id="fn2" type="footnote" n="2">Zum Badegeschenk für Bürgermeister <persName ref="p2816">Röist</persName> s. oben <ref target="file10469">[Nr. 434]</ref> S. 304, Anm.3.</note> etc. hatt min her <persName ref="p8049">Docter von Wadt</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p8049">Joachim Vadian</persName>.</note> truwlich<note xml:id="fn4" type="footnote" n="4">gewissenhaft, sorgfältig (<bibl source="b590">SI</bibl> XIV 1652).</note> ghandlett, <lb xml:id="p1z3"/>namlich aim burger<note xml:id="fn5" type="footnote" n="5">Unbekannt.</note> 1 gulden geben, der den nächsten<note xml:id="fn6" type="footnote" ana="lex" n="6">unverzüglich (<bibl source="b260">Grimm</bibl> VII 281).</note> zuͦ her <persName ref="p7551">Jörg von Hewen</persName> ritte, welchen <lb xml:id="p1z4"/>guldin er für in, mich och üch, dargebenden<note xml:id="fn7" type="footnote" ana="lex" n="7">gegeben hat.</note>.</s>
					<s n="4" xml:lang="de">Der bott ist zuͦ dem von <pb type="edition" next="330"/><persName ref="p7551">Hewen</persName> komen.</s>
					<s n="5" xml:lang="de">Der <lb xml:id="p1z5"/>hat ylentz<note xml:id="fn8" type="footnote" ana="lex" n="8">eilends.</note> dem hertzogen<note xml:id="fn9" type="footnote" n="9"><persName ref="p9708">Ulrich, Herzog von Württemberg</persName>.</note> ain aignen botten<note xml:id="fn10" type="footnote" n="10">Unbekannt.</note> gschickt.</s>
					<s n="6" xml:lang="de">Der hertzog ist zuͦ <placeName ref="l514">Urach</placeName> funden, und <lb xml:id="p1z6"/>am fritag wider uff <placeName ref="l496">Stuͦtgarten</placeName> zuͦ wellen.</s>
					<s n="7" xml:lang="de">Der hertzog hat geantwort, er söll her <persName ref="p7551">Jorgen</persName> <lb xml:id="p1z7"/>sagen, er well dess schribens nitt vergessen.</s>
					<s n="8" xml:lang="de">Der bott achtet<note xml:id="fn11" type="footnote" n="11">meint, vermutet (<bibl source="b590">SI</bibl> I 80).</note>, im wurde etwas gen <placeName ref="l587">Zurich</placeName> <lb xml:id="p1z8"/>komen, und so es durch <placeName ref="l441">Schaffhusen</placeName> für wildprät, wurd es wol us prätt<note xml:id="fn12" type="footnote" n="12">Das Wortspiel «wildprät ... us prätt» ist nicht aufzuhellen.</note>.</s>
					<s n="9" xml:lang="de">Nit wais <lb xml:id="p1z9"/>ich, ob etwas sid<note xml:id="fn13" type="footnote" n="13">seither, später (<bibl source="b590">SI</bibl> VII 1445).</note> gen <placeName ref="l587">Zurich</placeName> komen ist.</s>
					<s n="10" xml:lang="de">Der <persName ref="p7551">von Hewen</persName>, sagt der bott, hab och selb <lb xml:id="p1z10"/>zwen tag gejagt; hette gern her <persName ref="p2816">Rösten</persName> für sich etwas geschickt, aber dieselben tag nie <lb xml:id="p1z11"/>kain grät<note xml:id="fn14" type="footnote" n="14">wohl verschrieben für: prät (Wildbret).</note> gfangen etc.</s>
				</p>
				<p>
					<s n="11" xml:lang="de">Witer hab ich <persName ref="p6984">Petern Weber</persName> dess <placeName ref="l2822">Zürichbergs</placeName> halb<note xml:id="fn15" type="footnote" ana="bio" n="15">Vermutlich ging es um wirtschaftliche Ansprüche der Frau von <persName ref="p8071">Hans Vogler</persName>; s. auch oben S. 305, 11-16.</note> anzaigt <lb xml:id="p1z12"/>und befelt, was er an minem hern <persName ref="p2816">Rösten</persName> finden<note xml:id="fn16" type="footnote" n="16">welche Hilfe er erwarten darf.</note>, oder sunst hoffnung.</s>
					<s n="12" xml:lang="de">Dann ich hofte <lb xml:id="p1z13"/><persName ref="p6984">Petter Weber</persName> als bald, da ich wär<note xml:id="fn17" type="footnote" n="17">Konstruktion unklar, Sinn vielleicht: Ich vertraue <persName ref="p6984">Peter Weber</persName> so gut wie mir selbst.</note>, so ver es sin fuͦg wäre<note xml:id="fn18" type="footnote" n="18">wenn es nach seinem Sinn ist (vgl. <bibl source="b590">SI</bibl> I 700).</note>.</s>
				</p>
				<p>
					<s n="13" xml:lang="de" ana="salute">Gruͤtzend uns üwer <lb xml:id="p1z14"/>lieb <persName ref="p8051">husfrowen</persName><note xml:id="fn19" type="footnote" n="19"><persName ref="p8051">Anna Bullinger, geb. Adlischwyler</persName>.</note>, kind<note xml:id="fn20" type="footnote" n="20"><persName ref="p7224">Anna</persName>, geb. 1530, <persName ref="p5608">Margaretha</persName>, geb. 1531, <persName ref="p6609">Elisabeth</persName>, geb. 1532, und <persName ref="p487">Heinrich</persName>, geb. 1534; s. <bibl source="b483">Pestalozzi</bibl> 314.</note>, vatter im <placeName ref="l2822">Zürychberg</placeName><note xml:id="fn21" type="footnote" n="21">Unbekannt.</note> etc.</s>
				</p>
				<p>
					<s n="14" xml:lang="de">Actum <placeName ref="l473">S. G[allen]</placeName>, sontag vor Michahely <lb xml:id="p1z15"/>anno 34.</s>
				</p>
				<p>
					<s n="15" xml:lang="de"><lb xml:id="p1z16"/>U[wer] w[illiger] <persName ref="p8071">Hans Vogler</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="16" xml:lang="de"><pb/><lb xml:id="p2z1"/>An min gliepttenn hernn und <lb xml:id="p2z2"/>gunner M. <persName ref="p495">Hainrichen Bulligernn</persName>, <lb xml:id="p2z3"/>prediger zuͦ <placeName ref="l587">Zurych</placeName>.</s>
				</p>
			</div>
