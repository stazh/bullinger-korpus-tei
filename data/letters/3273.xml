	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Dominum <persName ref="p1878">Hubertum Languetum</persName>, virum et pium <lb xml:id="p1z2"/>et eruditum, tibi, mi d. <persName ref="p495">Bullingere</persName>, etiam atque <lb xml:id="p1z3"/>etiam commendo.</s>
					<s n="3" xml:lang="la">Is est, a quo literas has acci<lb xml:id="p1z4"/>pies, cuius si experimentum accipere et pietatis <lb xml:id="p1z5"/>et eruditionis volueris, non pigebit, spero, <lb xml:id="p1z6"/>aliquantulum temporis ei impendere.</s>
					<s n="4" xml:lang="la">Annis ali<lb xml:id="p1z7"/>quot familiarissime cum d. <persName ref="p2095">Philippo Melanch<lb xml:id="p1z8"/>thone</persName> versatus est, cui etiam intime charus est <lb xml:id="p1z9"/>et rerum ipsius etiam secretissimarum conscius.</s>
					<s n="5" xml:lang="la">Quaeso te, <lb xml:id="p1z10"/>mi d. <persName ref="p495">Bullingere</persName>, da operam, ut intelligat meam <lb xml:id="p1z11"/>hancce commendatiunculam aliquid habuisse apud te ponderis.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Bene va<lb xml:id="p1z12"/>le.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l28">Basileae</placeName> 18. augusti 1557.</s>
					<s n="8" xml:lang="la">Subito, proinde ignosce.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><persName ref="p8126">Ioan[nes] Oporinus</persName> tuus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Quaeso, <lb xml:id="p1z13"/>commenda eum etiam d. <persName ref="p8171">Theodoro</persName>, <persName ref="p8111">P. Martyri</persName>, <lb xml:id="p1z14"/><persName ref="p8011">Gvalthero</persName>, <persName ref="p1283">Gesnero</persName> etc.</s>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesie pa<lb xml:id="p2z4"/>stori fidelissimo, <lb xml:id="p2z5"/>domino et amico <lb xml:id="p2z6"/>suo plurimum colendo<lb xml:id="p2z7"/>.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
