	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, colendissime <persName ref="p495">Bullingere</persName>, d. <persName ref="p3099">Simon Sulcerus</persName> mihi has literas <lb xml:id="p1z2"/>tę humanitati perferendas tradidit; ego, quia hoc tempore <lb xml:id="p1z3"/>domum properandum erat, hasce d. <persName ref="p5230">Iohanni Hilero</persName> concredidi, qui <lb xml:id="p1z4"/>accepit se primo quoque tempore et nuntio ad te missurum.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z5"/>Laborarunt quidem <placeName ref="l28">Basilienses</placeName> fratres omnemque moverunt <lb xml:id="p1z6"/>lapidem, ut senatus religionis in iureiurando illo inauspicato, <lb xml:id="p1z7"/>quod Confoederati nostri a nobis extorquere nituntur, <lb xml:id="p1z8"/>meminissent; at, quid profecerint, puduit scribere.</s>
					<s n="3" xml:lang="la">Dominus <lb xml:id="p1z9"/>res Helvetię nostrę deploratissimas in bonum suis finem dirigat.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>D. <persName ref="p8298">Cellarius</persName> et frater meus <persName ref="p8384">Hospinianus</persName> te cum omnibus fratribus salvum <lb xml:id="p1z11"/>cupiunt.</s>
					<s n="5" xml:lang="la" ana="salute">D. <persName ref="p8418">Osvaldus</persName> medicus patri venerando d. <persName ref="p8127">Pellicano</persName> <lb xml:id="p1z12"/>salutem dicit.</s>
					<s n="6" xml:lang="la" ana="salute">Vale et me commendatun habe.</s>
					<s n="7" xml:lang="la">E <lb xml:id="p1z13"/><placeName ref="l82">Bü<lb xml:id="p1z14"/>laco</placeName> 7. augusti 55. raptim in transitu.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Tę humanitati devinctissimus <lb xml:id="p1z16"/><persName ref="p8383">Christianus Hospinianus</persName><lb xml:id="p1z17"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
