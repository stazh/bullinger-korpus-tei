	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/><persName ref="p8096">Wilhelm vonn gotts gnaden landtgrave <lb xml:id="p1z2"/>zu Hessen, grave zu Catzenelnpogen</persName> etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="de"><lb xml:id="p1z3"/>Unnsern gnedigen gruͦß zuvor.</s>
					<s n="3" xml:lang="de">Wirdiger <lb xml:id="p1z4"/>unnd hochgelarter, lieber besonder, welcher <lb xml:id="p1z5"/>gestaldt wir doctoris <persName ref="p8386">Hyperii</persName> seligen nach<lb xml:id="p1z6"/>gelassene wittwe uff ir demüetigß schrifftlich<lb xml:id="p1z7"/>s suppliciren an einen ersamen rath <lb xml:id="p1z8"/>zu <placeName ref="l587">Zurich</placeName> verschriebenn, darvon senden <lb xml:id="p1z9"/>wir euch inligende abschrifft.</s>
				</p>
				<p>
					<s n="4" xml:lang="de"><lb xml:id="p1z10"/>Diewill wir nhun ermeltte wittwe inn <lb xml:id="p1z11"/>diessem irem unsers ermessens nicht <lb xml:id="p1z12"/>untziemblichen suchen gerne gefordert <lb xml:id="p1z13"/>sehenn unnd sie nicht allein unseren vor<lb xml:id="p1z14"/>schrifft, sondern darbeneben auch ewerer <lb xml:id="p1z15"/>guten beforderung hierinnen zu geniessen <lb xml:id="p1z16"/>verhofft, so <lb xml:id="p1z17"/>ersuchen wir <lb xml:id="p1z18"/>euch gnediglichen gesinende, ir wollet euch <lb xml:id="p1z19"/>diß ir anligen zum besten bevolhen sein <lb xml:id="p1z20"/>lassenn unnd ir hierinnen alle gute befor<lb xml:id="p1z21"/>derung erzeigen, damitt irer pillichen bitt <lb xml:id="p1z22"/>stadt gegebenn unnd sie daher etzwaß ergetzlich<lb xml:id="p1z23"/>heidt ir selbst unnd iren kindern zum <lb xml:id="p1z24"/>besten erlangen möge.</s>
				</p>
				<p>
					<s n="5" xml:lang="de"><lb xml:id="p1z25"/>Daß thun wir unnß versehen unnd seindt euch <lb xml:id="p1z26"/>mitt gnedigem guten willen wohll gewogen.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z27"/>Datum <placeName ref="l244">Cassel</placeName> den 10ten octobris anno <lb xml:id="p1z28"/>domini 1566.</s>
				</p>
				<p>
					<s n="7" xml:lang="de"><persName ref="p8096">Wilhelm <lb xml:id="p1z29"/>l[andgrave] z[u] Hesßen</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="de"><pb/><lb xml:id="p4z1"/>Dem wurdigen und hochgelartenn unnserm <lb xml:id="p4z2"/>lieben besondernn ehrnn <persName ref="p495">Heinrichen Bul<lb xml:id="p4z3"/>linger</persName>n, der heiligen schrifft lehrern zu <lb xml:id="p4z4"/>Zuerich.</s>
				</p>
				<p>
					<note type="author">[Darunter von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="9" xml:lang="de"><lb xml:id="p4z5"/>"<lb xml:id="p4z6"/><persName ref="p8096">Lantgraff Wilhelm</persName> von wägen <lb xml:id="p4z7"/><persName ref="p8386">Hyperii</persName> seligen buchern, nitt zu<lb xml:id="p4z8"/>ͦ trucken, und ouch an radt <placeName ref="l587">Zürych</placeName> brieff."</s>
				</p>
			</div>
		</body>
	</text>
