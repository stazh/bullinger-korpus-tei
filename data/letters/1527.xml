	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Nihil gratius potuissem audire, quam <placeName ref="l830">Angliam</placeName> <lb xml:id="p1z2"/>pacatam esse et protectorem, regni <placeName ref="l830">Anglicanę</placeName> decus, adhuc esse incolumem.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Quae ego scripsi, habui ex veteratore, qui in <placeName>Cales</placeName> oppido <lb xml:id="p1z4"/>fuit, quando spiculator vocatus est ab regia maiestate.</s>
					<s n="4" xml:lang="la">Pereant, qui <lb xml:id="p1z5"/>male volunt piis hominibus.</s>
					<s n="5" xml:lang="la">Sed de <placeName ref="l830">Anglis</placeName> quid sperandum, qui <lb xml:id="p1z6"/>perpetuo seditiosi fuerunt, quemdmodum et illorum historiographi scribunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z7"/><persName ref="p8111">P[etrum] Martyrem</persName> optime valere gaudeo, et quod illius Propositiones de <lb xml:id="p1z8"/>negotio eucharistię apud vos excuduntur, grata erit res omnibus, <lb xml:id="p1z9"/>qui veram religionem amant, quo fucus <placeName ref="l1107">Tridentinorum</placeName> patrum <lb xml:id="p1z10"/>appareat etiam simplicioribus, qui parum norunt iudicare in religio<lb xml:id="p1z11"/>ne vera ob innatas superstitiones, quas imbiberunt ab ineunte <lb xml:id="p1z12"/>aetate, et scis etiam populi mores.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/><placeName ref="l303">Magdeburgum</placeName> pacem habet Caesareis literis confirmatam, licet <lb xml:id="p1z14"/>milites omnes non dimiserunt.</s>
					<s n="8" xml:lang="la">Miles iste episcoporum agros depopulatus <lb xml:id="p1z15"/>rusticis molestus est.</s>
					<s n="9" xml:lang="la"><placeName ref="l307">Moguntinus</placeName> apud nos fuit tribus <lb xml:id="p1z16"/>equitibus comitatus, sed occulte latuit.</s>
					<s n="10" xml:lang="la">Servus abituriens dixit: "<lb xml:id="p1z17"/>Hac nocte episcopum hostes habuit"<note type="margin">a.R.: habent?</note>, sicque abiit nullo honore <lb xml:id="p1z18"/>a nostro senatu acceptus.</s>
					<s n="11" xml:lang="la">Exercitus iste <persName>Mauricianus</persName> hostis est <lb xml:id="p1z19"/>episcoporum, <placeName ref="l1030">Wirtzburgensis</placeName>, <placeName ref="l1703">Bambergensis</placeName>, <placeName ref="l307">Moguntini</placeName> et <placeName ref="l267">Coloniensis</placeName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z20"/>Hagnoię colligere vult episcopus <placeName ref="l307">Moguntinensis</placeName>; sed <lb xml:id="p1z21"/>pauci nomen dant pfaffis, et hodie rumor ad nos venit <lb xml:id="p1z22"/>exercitum illum esse in oppidulo <placeName ref="l2243">Höist</placeName>, non procul a <placeName ref="l157">Francofordia</placeName>, <lb xml:id="p1z23"/>cis <placeName ref="l2459">Rhenum</placeName>.</s>
					<s n="13" xml:lang="la">Turbas habebit varias <placeName ref="l822">Germania</placeName> hoc anno.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z24"/>Quid putas <persName ref="p18250">Mauricium</persName> instituere?</s>
					<s n="15" xml:lang="la">aiunt enim a Caesare vocatum; <lb xml:id="p1z25"/>sed publicum conductum petiit, et Caesar respondit: "Quid <lb xml:id="p1z26"/>opus habet elector, cui Caesar bene vult et quem Caes[area] m[aiestas] <lb xml:id="p1z27"/>in tantum honorem evexit?"</s>
					<s n="16" xml:lang="la">Verum non vult fidere Caesareanis <lb xml:id="p1z28"/>promissis, quemadmodum lupus non credidit rusticis.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z29"/>De Guͦtschick<note type="margin">a.R.: -schück?</note> scribam hebdomada futura, nam <lb xml:id="p1z30"/>a nostris adiudicatus est, hoc est, <foreign xml:lang="de">man hat in verurteilt <lb xml:id="p1z31"/>von amptleuten zur ax, und was darzuͦ ghört,</foreign> quem puto <lb xml:id="p1z32"/>pęnam subiturum die sabbati proxima.</s>
					<s n="18" xml:lang="la">Quid autem egerit, quando <lb xml:id="p1z33"/>fuerit publicatum, te non celabo.</s>
					<s n="19" xml:lang="la" ana="farewell">Vale et <persName ref="p1278">Gastium</persName> ama, qui <lb xml:id="p1z34"/>tibi et tuę precatur felicem et fortunatum annum.</s>
					<s n="20" xml:lang="la"><placeName ref="l28">Basileę</placeName> 7. ianuarii <lb xml:id="p1z35"/>1552.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z36"/>T[uus <pb/><lb xml:id="p2z1"/><persName ref="p1278">G]astius</persName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><persName ref="p8417">Musculus</persName> ex <placeName ref="l18">Augusta</placeName> hęc habet: <lb xml:id="p2z2"/><persName>Huberinus</persName> locatus est in aedes <persName>Heldii</persName> praedicaturus apud <lb xml:id="p2z3"/>S. Annam; habet tres eiusdem nequitię mystas.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p2z4"/>De electore captivo scribitur suspitionem esse, quod datum <lb xml:id="p2z5"/>sit illi pharmacum non vitę, sed mortis; fertur enim lethaliter <lb xml:id="p2z6"/>decumbere vel certe mortuus esse.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">De <lb xml:id="p2z7"/><persName>Diatzio</persName> fratricida scribitur, quid vita vitam infelix laqueo sibi ademerit ipsi.</s>
					<s n="25" xml:lang="la" ana="farewell">Vale iterum atque iterum.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p2z8"/>Praestanti theologo d. <persName ref="p495">Heinrycho Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae pastori, suo in domino charissimo<lb xml:id="p2z9"/>.</s>
				</p>
				<p>
					<s n="27" xml:lang="de"><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
