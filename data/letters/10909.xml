	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><pb type="scan" next="||70"/><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Scripsi, ut superioribus <lb xml:id="p1z2"/>literis petieras, ante aliquot dies responsionem<note xml:id="fn1" type="footnote" n="1">Am 18. Juli (oben <ref target="file10904">Nr. 864</ref>).</note>, <lb xml:id="p1z3"/>sed per inopiam tabellionum non misi, quae <lb xml:id="p1z4"/>scripseram.</s>
					<s n="3" xml:lang="la">Verum nunc mitto.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Placent, imo <lb xml:id="p1z5"/>perplacent, quae respondistis super confessione Saxonica <lb xml:id="p1z6"/>senatui<note xml:id="fn2" type="footnote" n="2"><persName ref="p8418">Myconius</persName> und <persName ref="p1365">Grynäus</persName> hatten den Dreizehn ein ablehnendes Gutachten zur <placeName ref="l558">Wittenberger</placeName> Konkordie (vgl. Anm. 3) vorgelegt; s. oben <ref target="file10906">Nr. 866</ref>, 25-29 mit Anm. 14.</note>.</s>
					<s n="5" xml:lang="la">Nolumus subscribere nos neque <lb xml:id="p1z7"/>conscriptioni <placeName ref="l558">Wittembergensi</placeName> neque confessioni <lb xml:id="p1z8"/>Saxonicae<note xml:id="fn3" type="footnote" n="3"><persName ref="p8418">Myconius</persName> verwendet die Bezeichnung "<placeName ref="l749">sächsische</placeName> Konfession" auch für die <placeName ref="l558">Wittenberger</placeName> Konkordie, während <persName ref="p495">Bullinger</persName> darunter die <placeName ref="l18">Confessio Augustana</placeName> versteht; vgl. oben <ref target="file10903">Nr. 863</ref>, Anm. 1.</note>.</s>
					<s n="6" xml:lang="la">Responsionem vestram remitto et gratia[s]<note xml:id="fna" type="footnote" n="a">Textverlust <hi>wegen Beschädigung des Randes.</hi></note> <lb xml:id="p1z9"/>ago.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Inter caetera scribis<note xml:id="fn4" type="footnote" n="4">Oben <ref target="file10906">Nr. 866</ref>, 34f.</note>: "Tum et de con<lb xml:id="p1z10"/>ventu communi erit consultatio."</s>
					<s n="8" xml:lang="la">Scias igitur, vene<lb xml:id="p1z11"/>rande mi <persName ref="p8418">Myconi</persName>, nos posthac in nullum venturos <lb xml:id="p1z12"/>conventum.</s>
					<s n="9" xml:lang="la">Semel convenimus <placeName ref="l28">Basileae</placeName>, <lb xml:id="p1z13"/>semel confessi sumus<note xml:id="fn5" type="footnote" n="5">Zum Ersten Helvetischen Bekenntnis s. oben <ref target="file10775">Nr. 737</ref>, Anm. 1.</note>.</s>
					<s n="10" xml:lang="la">Nihil causae est, cur <lb xml:id="p1z14"/>conveniamus amplius, nisi in confessa veritate <lb xml:id="p1z15"/>perseverare nolimus.</s>
					<s n="11" xml:lang="la">Quid sollicitamur ac te[n]<lb xml:id="p1z16"/>tamur<note xml:id="fnb" type="footnote" n="b">Textverlust <hi>wegen Beschädigung des Randes.</hi></note> toties?</s>
					<s n="12" xml:lang="de">Kurtz dannen<note xml:id="fn6" type="footnote" ana="lex" n="6">kurzweg (<bibl source="b590">SI</bibl> XIII 96).</note>: Ee<note xml:id="fn7" type="footnote" ana="lex" n="7">eher.</note> wil ich di[e]<note xml:id="fnc" type="footnote" n="c">Textverlust <hi>wegen Beschädigung des Randes.</hi></note> <lb xml:id="p1z17"/>ein mol gestellt confession hälffend scherppff[en]<note xml:id="fnd" type="footnote" n="d">Textverlust <hi>wegen Beschädigung des Randes.</hi></note> <lb xml:id="p1z18"/>dann miltern.</s>
					<s n="13" xml:lang="de">Was tript man hür und fer[n]<note xml:id="fne" type="footnote" n="e">Textverlust <hi>wegen Beschädigung des Randes.</hi></note><note xml:id="fn8" type="footnote" n="8">treibt man immerzu (<bibl source="b590">SI</bibl> II 1585).</note> <lb xml:id="p1z19"/>mit unß?</s>
					<s n="14" xml:lang="la">Si <persName ref="p1974">Lutherus</persName> cum suis nostram <lb xml:id="p1z20"/>ferre potest confessionem, gratias ago deo.</s>
					<s n="15" xml:lang="la">Si non potest, <lb xml:id="p1z21"/>nobis de confessione vel tantillum mutare non <lb xml:id="p1z22"/>erit integrum, nisi erroris prius convicerin[t]<note xml:id="fnf" type="footnote" n="f">Textverlust <hi>wegen Beschädigung des Randes.</hi></note>.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z23"/>Subscripserunt <placeName ref="l491">Argentoratenses</placeName> sancte pollic[i]ti<note xml:id="fng" type="footnote" n="g">Textverlust <hi>wegen Beschädigung des Randes.</hi></note> <lb xml:id="p1z24"/>posthac se contra hanc confessionem nil <lb xml:id="p1z25"/>daturos, sine nobis<pb type="edition" next="375"/> acturos nihil<note xml:id="fn9" type="footnote" n="9">Im Abschied vom 4. Februar ist nur festgehalten, Dass keine eidgenössische Stadt ohne Vorwissen der anderen etwas am gemeinsamen Bekenntnis ändern oder dieses drucken lassen dürfe (<bibl source="b197">EA</bibl> IV/1c 617 c; vgl. <hi>Köhler,</hi> ZL II 460).</note>.</s>
					<s n="17" xml:lang="la">Expecto <lb xml:id="p1z26"/>eventum rei.</s>
					<s n="18" xml:lang="la">Non est, quod illi aliud [ex]<lb xml:id="p1z27"/>pectent<note xml:id="fnh" type="footnote" n="h">Textverlust <hi>wegen Beschädigung des Randes.</hi></note> de nobis; quod semel sumus confessi, <lb xml:id="p1z28"/>confitemur hodie quoque.</s>
					<s n="19" xml:lang="la">Quid quaerunt amplius?</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="farewell"><lb xml:id="p1z29"/>Vale, mi charissime frater, una cum <persName ref="p1365">Gryneo</persName>, <lb xml:id="p1z30"/>domino observando.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><persName ref="p6592">Onoffrius Setzstabius</persName> urbe el[ap]<lb xml:id="p1z31"/>sus<note xml:id="fni" type="footnote" n="i">Textverlust <hi>wegen Beschädigung des Randes.</hi></note> clanculo militiam ingressus est mercen[na]riam<note xml:id="fnk" type="footnote" n="k">Textverlust <hi>wegen Beschädigung des Randes.</hi></note><note xml:id="fn10" type="footnote" n="10">Wegen des unerlaubten Solddienstes für <placeName ref="l832">Frankreich</placeName> wurde <persName ref="p6592">Setzstab</persName>, wie aus einem Begnadigungsgesuch der <placeName ref="l2454">X Orte</placeName> vom 16. April 1540 (Zürich StA, A 26. 2, Nr. 72) hervorgeht, des Landes verwiesen; vgl. Georg <hi>Gerig,</hi> Reisläufer und Pensionenherren in <placeName ref="l587">Zürich</placeName> 1519-1532, Zürich 1947. - Schweizer Studien zur Geschichtswissenschaft, NF 12, S. 113.</note>.</s>
					<s n="22" xml:lang="la"><lb xml:id="p1z32"/><placeName ref="l2450">Svitii</placeName> et <placeName ref="l507">Togeni</placeName> tribus, ut aiunt, sign[is]<note xml:id="fnl" type="footnote" n="l">Textverlust <hi>wegen Beschädigung des Randes.</hi></note> <lb xml:id="p1z33"/>ad <persName ref="p20225">Gallum</persName><note xml:id="fn11" type="footnote" n="11">König <persName ref="p20225">Franz I.</persName></note> profecti sunt.</s>
					<s n="23" xml:lang="la">Profecturos aiunt e[t]<note xml:id="fnm" type="footnote" n="m">Textverlust <hi>wegen Beschädigung des Randes.</hi></note> <lb xml:id="p1z34"/><placeName ref="l300">Lucernates</placeName>.</s>
					<s n="24" xml:lang="la">Nostri perpetuo sui similes persever<lb xml:id="p1z35"/>ant <lb xml:id="p1z36"/>nec ullius se partibus iungunt.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Abbas<pb type="scan" next="||69"/><pb/><lb xml:id="p2z1"/><placeName ref="l473">Sangallensis</placeName><note xml:id="fn12" type="footnote" n="12"><persName ref="p8179">[Diethelm] Blarer von Wartensee</persName>.</note> comitatus legatis <placeName ref="l300">Lucernatum</placeName> et <placeName ref="l2450">Schviciorum</placeName> <lb xml:id="p2z2"/>in senatum nostrum ingressus petiit quaeda<lb xml:id="p2z3"/>m contra <placeName ref="l507">Doggios</placeName><note xml:id="fn13" type="footnote" n="13">Zu den Verhandlungen über den Loskauf des <placeName ref="l507">Toggenburgs</placeName> s. oben <ref target="file10905">Nr. 865</ref>, 5-10, und 868, 2-12.</note>, sed nihil impetravit.</s>
					<s n="26" xml:lang="la">Nostri <lb xml:id="p2z4"/><persName ref="p1888">Lavaterum</persName> miserunt ad <placeName ref="l507">Doggios</placeName>; huius expectamus <lb xml:id="p2z5"/>reditum.</s>
					<s n="27" xml:lang="de">Er, der apt, näm inen gern <lb xml:id="p2z6"/>den kouff wider und brächt sy widerumb an das <lb xml:id="p2z7"/>klotzhuss<note xml:id="fn14" type="footnote" n="14">Die verächtliche Bezeichnung eines Klosters abs Klotz- oder Kotzhaus (statt: Gotteshaus) spielt auf die Völlerei der Mönche an; s. <bibl source="b590">SI</bibl> II 1715f.</note>.</s>
					<s n="28" xml:lang="la">Nos pro publica contione monacho <lb xml:id="p2z8"/>detraximus leoninum<note xml:id="fn15" type="footnote" n="15"><persName ref="p495">Bullinger</persName> scheint auf die Fabel vom Esel in der Löwenhaut anzuspielen; vgl. <bibl source="b541">Röhrich</bibl> I 242.</note>.</s>
					<s n="29" xml:lang="la">Adortus est illum et <persName ref="p8127">Pellicanus</persName> <lb xml:id="p2z9"/>in diversorio monens, ut resipiscat; sed contempsit Antron<lb xml:id="p2z10"/>ius<note xml:id="fn16" type="footnote" n="16">Abschätzige Bezeichnung für den Abt; vgl. <bibl source="b4">HBBW II</bibl> <ref target="file10110">[Nr. 81]</ref>, S. 88, Anm. 3; 263, Anm. 6.</note>.</s>
				</p>
				<p>
					<s n="30" xml:lang="la" ana="farewell">Vale.</s>
					<s n="31" xml:lang="la">Plura iam non sinu<lb xml:id="p2z11"/>nt <lb xml:id="p2z12"/>occupationes.</s>
				</p>
				<p>
					<s n="32" xml:lang="la">Responde mihi ad hanc quaestionem, <lb xml:id="p2z13"/>obsecro<note xml:id="fn17" type="footnote" n="17"><persName ref="p8418">Myconius</persName>' Antwort ist nicht überliefert.</note>:</s>
					<s n="33" xml:lang="de">Ob man by üch zuͦliesse, das ein key<lb xml:id="p2z14"/>benschynder<note xml:id="fn18" type="footnote" n="18">Wasenmeister, Abdecker (<bibl source="b590">SI</bibl> VIII 914f).</note> oder hänckersbuͦb<note xml:id="fn19" type="footnote" ana="lex" n="19">Henkersknecht (<bibl source="b590">SI</bibl> IV 932).</note> oder sust ein unerliche<note xml:id="fn20" type="footnote" ana="lex" n="20">unehrenhafte (<bibl source="b590">SI</bibl> I 395).</note> <lb xml:id="p2z15"/>person einem frommen<note xml:id="fn21" type="footnote" ana="lex" n="21">ehrenwerten (<bibl source="b590">SI</bibl> I 1295).</note> burger sin dochter zuͦ der ee näme?</s>
					<s n="34" xml:lang="de"><lb xml:id="p2z16"/>By unß ist sömlichs beschähen<note xml:id="fn22" type="footnote" ana="bio" n="22">solches geschehen. - <persName ref="p5032">Hans Großholz</persName>, Sohn des Wasenmeisters <persName ref="p5033">Heitz Großholz</persName> (s. Anm. 23), und <persName ref="p5295">Barbara Hottinger</persName> von <placeName ref="l583">Zollikon</placeName> hatten einander heimlich die Ehe versprochen. Am 20. Juli überwies das von den Verwandten der Frau angerufene Ehegericht den Präzedenzfall an den Rat. Dieser beauftragte die Eherichter, <persName ref="p495">Bullinger</persName> zur Beratung beizuziehen. Am 27. Juli wurde die Ehe nach langer Verhandlung für unzulässig erklärt, da die Zustimmung der Eltern und Verwandten nicht im voraus eingeholt worden war. Außerdem wurde festgehalten, der Sohn (nicht aber die Tochter) eines "unehrlichen" Mannes sei für eine bürgerliche Familie unzumutbar, da Name und Zunftunfähigkeit auf die Kinder übergehen würden. Siehe Zürich StA, YY 1. 5, S. 741-744.</note>; hat<lb xml:id="p2z17"/>t <lb xml:id="p2z18"/>deß <persName ref="p5033">Heytzen</persName><note xml:id="fn23" type="footnote" n="23"><persName ref="p5033">Heitz (Heinz, Heinrich) Großholz</persName>; vgl. Wilhelm Heinrich <hi>Ruoff,</hi> Von ehrlichen und unehrlichen Berufen, besonders vom Scharfrichter und Wasenmeister im alten <placeName ref="l587">Zürich</placeName>, in: Zürcher Taschenbuch 54, 1934, S. 28 (Anm. 7) und 34.</note> sun einem sin dochter genommen und <lb xml:id="p2z19"/>sy inn.</s>
				</p>
				<p>
					<s n="35" xml:lang="de"><pb type="edition" next="376"/>Der vatter<note xml:id="fn24" type="footnote" n="24"><persName ref="p5297">Konrad Hottinger</persName>.</note> ist allt; hatt gemeindt, es muͤsse <lb xml:id="p2z20"/>sin.</s>
					<s n="36" xml:lang="de">Allß er aber underrycht, hatt er sich mitt der <lb xml:id="p2z21"/>früntschafft<note xml:id="fn25" type="footnote" ana="lex" n="25">Verwandtschaft.</note> darwider gestellt, und sind geteylt<note xml:id="fn26" type="footnote" ana="lex" n="26">getrennt worden.</note>.</s>
					<s n="37" xml:lang="de"><lb xml:id="p2z22"/>Dann noch sy nitt zamen gäben noch bygelägen.</s>
				</p>
				<p>
					<s n="38" xml:lang="la">28. iulii 1536.</s>
				</p>
				<p>
					<s n="39" xml:lang="la"><persName ref="p495">H. Bullingerus</persName> tu<lb xml:id="p2z23"/>us.</s>
				</p>
				<p>
					<note type="address">[Adresse darunter:]</note>
					<s n="40" xml:lang="la">Optimo viro d. <persName ref="p8418">Osv<lb xml:id="p2z24"/>aldo Myconio</persName>, charissimo fratri.</s>
					<s n="41" xml:lang="la"><placeName ref="l28">B[asileae]</placeName><note xml:id="fnn" type="footnote" n="n"><hi>Über den (nicht mehr erhaltenen) Verschlußstreifen geschrieben.</hi></note>.</s>
				</p>
			</div>
		</body>
