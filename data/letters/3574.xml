	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Literas tuae humanitatis accepi, et quo longiores <lb xml:id="p1z2"/>hoc gratiores.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Oro autem dominum, ut balneum illud tibi <lb xml:id="p1z3"/>velit esse felix et faustum uxorique tuae, matronae ho<lb xml:id="p1z4"/>nestissimae saluberrimum.</s>
					<s n="4" xml:lang="la">Filio iterum scabies collum <lb xml:id="p1z5"/>obsedit; accessit ulcus, e quo magna vis purulentiae <lb xml:id="p1z6"/>profluit.</s>
					<s n="5" xml:lang="la">Spero hunc fluxum ipsi fore salutarem.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">De <lb xml:id="p1z7"/>thermis nihil cogito, nec conduceret iuvenem tam <lb xml:id="p1z8"/>frequenter lavare.</s>
					<s n="7" xml:lang="la">Consultum minime esset <persName>Hectorem</persName> <lb xml:id="p1z9"/>aliquo ablegare, cum quod aegre domi in officio retinetur, <lb xml:id="p1z10"/>quid foris faceret aut quis illos sibi labores <lb xml:id="p1z11"/>sumeret custodiendi illius?</s>
					<s n="8" xml:lang="la">tum quod revertens novos <lb xml:id="p1z12"/>mihi pareret labores; de integro enim ille mihi <lb xml:id="p1z13"/>cohercendus esset.</s>
					<s n="9" xml:lang="la">Haec scribo, quod huius aliquid intellexis<lb xml:id="p1z14"/>se aut subolfecisse videor cupere ipsos adire thermas.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/>Pro diligentia adhibita in revocando meo filio immortales <lb xml:id="p1z16"/>ago gratias; spero illum meis pariturum mandatis.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z17"/>Nuper misi per <persName>Laurentium Lumagam</persName> <placeName ref="l93">Clavennensem</placeName> <lb xml:id="p1z18"/>decem coronatos illi et literas, quibus revoco, prius per <lb xml:id="p1z19"/><persName>Bellizarium</persName> 4 coronatos misi.</s>
					<s n="12" xml:lang="la">Sufficiunt hi ad sumptus <lb xml:id="p1z20"/>itineris faciendos, unde non est, quod tu des quicquam; <lb xml:id="p1z21"/>interim ago gratias pro prompta tua voluntate.</s>
					<s n="13" xml:lang="la">Multa <lb xml:id="p1z22"/>hic feruntur de expeditionibus regum, multa quoque de <lb xml:id="p1z23"/>pacificatione, ad quam perficiendam dicitur conestabilis <lb xml:id="p1z24"/>dimissus ex vinculis.</s>
					<s n="14" xml:lang="la">Affirmant multi <persName ref="p18477">Ferdinandum</persName> regem <lb xml:id="p1z25"/>coronatum imperatorem ea conditione, ne confirmationem <lb xml:id="p1z26"/>a pontifice petat; ego certum asseverare non possum, <lb xml:id="p1z27"/>nescio, quid verum sit; dum hic ait, ille negat.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z28"/>Libenter scribendo essem copiosior; sed negotia avocant.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z29"/>Sunt hic viri docti, cum quibus nunc per biduum <lb xml:id="p1z30"/>contulimus; sunt et alia multa, ut aegre has scripserim.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z31"/>Ne tamen nihil darem, has malui exarare.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z32"/>Accepi literas parentis tui, viri amplissimi, <lb xml:id="p1z33"/>breves, sed senilem prudentiam, candorem et <lb xml:id="p1z34"/>insignem probitatem spirantes.</s>
					<s n="19" xml:lang="la" ana="salute">Salutabis illum <lb xml:id="p1z35"/>officiosissime et dices me patris facturum officium; <lb xml:id="p1z36"/>certe, nisi eius me commoveret authoritas <lb xml:id="p1z37"/>et tua amicitia, hac mallem carere molestia; <lb xml:id="p1z38"/>sed vestri gratia libens, quod possum, facio.</s>
					<s n="20" xml:lang="la">Commen<lb xml:id="p1z39"/>do me vobis.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Salvi sint d. <persName ref="p6831">Traversus</persName>, d. <lb xml:id="p1z40"/><persName ref="p8492">Bergomas</persName> et reliqui noti; salva sit tota domus <lb xml:id="p1z41"/>tua.</s>
					<s n="22" xml:lang="la" ana="farewell"><lb xml:id="p1z42"/>Vale et iterum vale.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Non re<lb xml:id="p1z43"/>legi.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 22. aprilis 1558.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z44"/><persName ref="p495">Bullingerus</persName> tuus<pb/><lb xml:id="p2z6"/>.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p2z7"/>Clarissimo viro d. <persName ref="p8432">Fri<lb xml:id="p2z8"/>derycho a Salice</persName>, <placeName ref="l440">Sa<lb xml:id="p2z9"/>madeno</placeName> <placeName ref="l648">Rheto</placeName>, domino <lb xml:id="p2z10"/>suo colendissimo et fratri <lb xml:id="p2z11"/>charissimo.</s>
					<s n="27" xml:lang="la"><lb xml:id="p2z12"/><placeName ref="l440">Samada</placeName>.</s>
				</p>
			</div>
