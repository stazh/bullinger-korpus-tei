	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi literas tuas, chare frater, et inter turbas <lb xml:id="p1z2"/>varias et multiplices brevibus tibi respondeo.</s>
					<s n="3" xml:lang="la">Placet <lb xml:id="p1z3"/>relatio, quae passim per <placeName ref="l648">Rhetiam</placeName> denunciatur com<lb xml:id="p1z4"/>munitatibus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Tua vero epistola displicet per omnia, non <lb xml:id="p1z5"/>quod scripta sit per te, et quatenus te attinet, sed quatenus <lb xml:id="p1z6"/>attinet [iniusticiam, perfidiam et <lb xml:id="p1z7"/>corruptelam]<note type="margin">a.R.: ...</note> Dominum oro, ut in his difficultatibus <lb xml:id="p1z8"/>vobis consulat et medeatur.</s>
					<s n="5" xml:lang="la">Video<note type="margin">a.R.: ...</note> [.<lb xml:id="p1z9"/>..]</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Hac septimana transiit hac illustrissimus princeps d. <lb xml:id="p1z11"/><persName>Christophorus</persName>, dux <placeName ref="l619">Bavariae</placeName> Palatinus, electoris filius, iuvenis <lb xml:id="p1z12"/>17 annorum.</s>
					<s n="7" xml:lang="la">Studuit <placeName ref="l167">Genevae</placeName>, per <placeName ref="l41">Bernam</placeName> ad nos <lb xml:id="p1z13"/>venit.</s>
					<s n="8" xml:lang="la">Amicissime et honorificentissime exceptus <lb xml:id="p1z14"/>et dimissus abiit <placeName ref="l28">Basileam</placeName> comitatus nostris et <lb xml:id="p1z15"/><placeName ref="l41">Bernatibus</placeName> quibusdam.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Princeps est spei maximae; dominus <lb xml:id="p1z16"/>benedicat illi!</s>
					<s n="10" xml:lang="la">Venit hisce quoque diebus d. <persName ref="p772">Petrus <lb xml:id="p1z17"/>Dathenus</persName>; quid egerit, intelliges ex hoc apposito <lb xml:id="p1z18"/>scripto.</s>
					<s n="11" xml:lang="la">Oravit, ut te hortarer c[auss]ae adsis et, si <lb xml:id="p1z19"/>quem noris, qui opibus polleat, ipsi hortator sis, ut <lb xml:id="p1z20"/>aliquid conferat.</s>
					<s n="12" xml:lang="la">Tu itaque fungere boni nuncii <lb xml:id="p1z21"/>munere et responde, si quid sit spei.</s>
					<s n="13" xml:lang="la">Dicta sunt <lb xml:id="p1z22"/>comitia <placeName ref="l2">Aaroviam</placeName> 4 urbibus <placeName ref="l587">Tigurinae</placeName>, <placeName ref="l41">Bernati</placeName>, <lb xml:id="p1z23"/><placeName ref="l28">Basiliensi</placeName> et <placeName ref="l441">Schaffhusianae</placeName> ad 8. augusti.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Aiunt de novo <lb xml:id="p1z24"/>conflixisse ad <placeName ref="l185">Groningam</placeName> copias et rursus circiter <lb xml:id="p1z25"/>300 <placeName>Albanorum</placeName><note type="margin">a.R.: eigtl. <placeName>Albarum</placeName> geschr.</note> desideratos; Albanum misisse eo <lb xml:id="p1z26"/><persName ref="p8089">Scipionem Vitellium</persName>; ipsum delitescere in muni<lb xml:id="p1z27"/>tissima arce <placeName ref="l3070">Hertzogenbusch</placeName>; venire item ex <lb xml:id="p1z28"/><placeName ref="l875">Hispania</placeName> et <placeName ref="l834">Italia</placeName> copias novas.</s>
					<s n="15" xml:lang="la">Quo praetextu <lb xml:id="p1z29"/>occiderit <persName>Egmundanum</persName>, habes hic.</s>
					<s n="16" xml:lang="de"><lb xml:id="p1z30"/>Der tütschen rüttern rittmeister, so in <placeName ref="l832">Franckrych</placeName> <lb xml:id="p1z31"/>xin under <persName>Casimiro</persName> und <persName>hertzog Wilhelmen</persName>, die <lb xml:id="p1z32"/>besten habend sich versprochen Uraniensi.</s>
					<s n="17" xml:lang="de"><persName>Claus</persName> <lb xml:id="p1z33"/>von <placeName>Hattstatt</placeName> fuͤrt imm zuͦ ein regiment lantzknecht <lb xml:id="p1z34"/>und sunst ein graff ouch ein regiment, item ein <lb xml:id="p1z35"/>fryherr uß <placeName ref="l691">Lothringen</placeName> uff 4000 <placeName ref="l2730">Gaschgonyer</placeName> <lb xml:id="p1z36"/>und <placeName ref="l832">Franzosen</placeName>; werdent 1. augusti an der Maaß <lb xml:id="p1z37"/>sin, und wirt grosser ernst angewendt.</s>
				</p>
				<p>
					<s n="18" xml:lang="de">Gott <lb xml:id="p1z38"/>der allmächtig gäbe gnad; dann es sin gar wol be<lb xml:id="p1z39"/>darff.</s>
					<s n="19" xml:lang="de">Bättend ouch gott trüwlich.</s>
					<s n="20" xml:lang="de" ana="salute">Gruͤssend <lb xml:id="p1z40"/>mir die 3 herren burgermeister, <foreign xml:lang="la">h. <persName ref="p1770">Carolum</persName>, <persName ref="p6130">Ponti<lb xml:id="p1z41"/>sellam</persName>, <persName ref="p20473">Ganthnerum</persName>, omnes.</foreign></s>
				</p>
				<p>
					<s n="21" xml:lang="la">Festinantissime.</s>
					<s n="22" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z42"/><placeName ref="l587">Tiguri</placeName> 30. iulii 1568.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z43"/>Tuus ex animo.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
