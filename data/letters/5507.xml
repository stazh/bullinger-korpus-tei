	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. Ante paucos dies scripsi ad Frisium nostrum, missis
					<lb xml:id="p1z2"/>etiam libellus aliquot locorum communti collect aneus nemper
					<lb xml:id="p1z3"/>Ioannis Maulii, a quo literas hasce accipis iam
					<lb xml:id="p1z4"/>d. Bullingere, oramique Frisium tum in iis literis
					<lb xml:id="p1z5"/>ut eius commendationem etiam, priusquam ad vos ipsene
					<lb xml:id="p1z6"/>veniret(quani Bernam prims censere instituisset Iapr
					<lb xml:id="p1z7"/>te et alios doctos vestrates curaret. Oro igitur te n
					<lb xml:id="p1z8"/>d Bullingere, ut vel meo vel Philippi p
					<lb xml:id="p1z9"/>praeceptoris ipsius vel comm literarum atque religionis nomine
					<lb xml:id="p1z10"/>ipsum amice excipias et doctorum etiam aliorum apud no
					<lb xml:id="p1z11"/>familiaritem atque gratia eim concilies, quo reversus
					<lb xml:id="p1z12"/>aliquando ad suos Saxones, virtutum atque humanitatis
					<lb xml:id="p1z13"/>vestrę praedicatione male de vobis et sentientium et
					<lb xml:id="p1z14"/>quentium ora obstruere possit. Commersatus est dom
					<lb xml:id="p1z15"/>meae per menses aliquot, ut qualis sit omnino probi
					<lb xml:id="p1z16"/>hi esse perspectum putam. Itaque dignum iudicavi, quem
					<lb xml:id="p1z17"/>etiam vobis commendarem. Ignosces autem, quod subinde ta
					<lb xml:id="p1z18"/>commendationibus negotium et tibi et aliis exhi
					<lb xml:id="p1z19"/>ipse potuius commendatiarm apud nos opus habens
					<lb xml:id="p1z20"/>Arte si quid vicissim grati offuci exhibere vobis
					<lb xml:id="p1z21"/>ipse etiam possem, nulli meque labori neque fidei
					<lb xml:id="p1z22"/>meque operae percerem. Bene vale proque nostris
					<lb xml:id="p1z23"/>laboribus ac studiis deum, quaeso, ora. Basileae 12.
					<lb xml:id="p1z24"/>novembris 1562.
					<lb xml:id="p1z25"/>Ioannes Oporinus.
					<lb xml:id="p1z26"/>et P. Martyri
					<lb xml:id="p1z27"/>ex animo
					<lb xml:id="p1z28"/>icisplur Saluteam mei
					<lb xml:id="p1z29"/>nomine dices, ita Theodoro nostro inprimis, de qui
					<lb xml:id="p1z30"/>diu nihil audivi. Bene certe valere ipsum, ex a
					<lb xml:id="p1z31"/>opto.
					<pb/>
					<lb xml:id="p2z1"/>Optimo atque doctissimo
					<lb xml:id="p2z2"/>viro d. Henrico
					<lb xml:id="p2z3"/>Bullingero, Tigurinae
					<lb xml:id="p2z4"/>Turae ecclesiae pastoris
					<lb xml:id="p2z5"/>et domino et aimo
					<lb xml:id="p2z6"/>suo in piis
					<lb xml:id="p2z7"/>colendo.
					<lb xml:id="p2z8"/><placeName ref="l587">Tiguri</placeName>.
				</p>
