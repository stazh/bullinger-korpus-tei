	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z6"/>S<lb xml:id="p1z8"/>.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z9"/>Reverende in Christo pater, semper motus motum <lb xml:id="p1z10"/>excipit.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Heri mortuus est episcopus noster.</s>
					<s n="4" xml:lang="la">Pridie, <lb xml:id="p1z11"/>antequam tuum librum misissem, primum febricitare <lb xml:id="p1z12"/>incoepit; moeror ei exitio fuit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Deus bone, quot <lb xml:id="p1z13"/>iam fluctus denuo, quot procellas prospicio!</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Sic miser nunquam me expedio.</s>
					<s n="7" xml:lang="la">Intestatus mortuus <lb xml:id="p1z15"/>est et inopinato.</s>
					<s n="8" xml:lang="la">Expectatur transitus episcopi <lb xml:id="p1z16"/><placeName ref="l257">Constantiensis</placeName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Mirae sunt in <placeName ref="l862">Helvetia</placeName> practicae; <lb xml:id="p1z17"/>pontificii de foedere sibi omnia promittunt.</s>
					<s n="10" xml:lang="la">In <placeName ref="l822">Germania</placeName> <lb xml:id="p1z18"/>pontifex nihil non molitur.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Iliadem haber<lb xml:id="p1z19"/>em, s<lb xml:id="p1z20"/>i tecum essem.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">29. aprilis, <lb xml:id="p1z21"/>anno 1565.</s>
				</p>
				<p>
					<note>[P.S.:]</note>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Creditur rediturus <placeName ref="l875">Hispani</placeName> <lb xml:id="p1z23"/>legatus.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z24"/>Acta exscribi cura<lb xml:id="p1z25"/>vi et, <lb xml:id="p1z26"/>si qu<pb/><lb xml:id="p2z1"/>is <lb xml:id="p2z2"/>ex n<lb xml:id="p2z3"/>ost<lb xml:id="p2z4"/>ris proficisci<lb xml:id="p2z5"/>tur, da<lb xml:id="p2z6"/>bo.</s>
				</p>
			</div>
		</body>
	</text>
