	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Visum est, pientissime <persName ref="p495">Bullingere</persName>, ut rescires <lb xml:id="p1z2"/>efficere <persName ref="p8474">Hieronymum Hurusium</persName>, cum nuper <placeName ref="l760">Solidurę</placeName> <lb xml:id="p1z3"/>in comitio est visus, nihil habuisse mandati a <persName ref="p4082">Conrado <lb xml:id="p1z4"/>Zviccio</persName>; de me nuper tibi significabam, quod ignorante me <lb xml:id="p1z5"/>illic fuit.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Nolui et illud vos ignorare his diebus venturum <placeName ref="l257">Constantiam</placeName> <lb xml:id="p1z7"/>dici non postremi nominis capitaneum, Caesaris <lb xml:id="p1z8"/>consiliarium, pontem autem, cuius partem <placeName ref="l875">Hispani</placeName> e<lb xml:id="p1z9"/>xcusserant atque deiecerant, subita opera et festinanter <lb xml:id="p1z10"/>refici curare magistratum, regem expectari ad <lb xml:id="p1z11"/><placeName ref="l232">Oenopontem</placeName>, unde pridie do[minus] <persName ref="p20184">Bolvilerus</persName> rediit epistolam <lb xml:id="p1z12"/>ad me ex urbe mittens millenum aureorum multam <lb xml:id="p1z13"/>mihi imponentem pręservata tamen expostulatione atque iure <lb xml:id="p1z14"/>senatus <placeName ref="l257">Constantiensis</placeName>.</s>
					<s n="4" xml:lang="la">Similis exempli epistola red<lb xml:id="p1z15"/>dita est <persName ref="p4082">Conrado Zviccio</persName>.</s>
					<s n="5" xml:lang="la">Quid ad pęne mtigationem <lb xml:id="p1z16"/>et duriorum conditionum explicationem pertinere <lb xml:id="p1z17"/>videatur, dispiciemus; sin duri esse perrexerint <lb xml:id="p1z18"/>regii, utar consilio senatus <placeName ref="l587">Tigurini</placeName>, patrum meorum.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z19"/>Meditor cum familia mea hoc mense commigrare <lb xml:id="p1z20"/>in predium coemptum <placeName ref="l907">Campidonense</placeName>, nisi occupationibus <lb xml:id="p1z21"/>necessariis fuero prępeditus.</s>
					<s n="7" xml:lang="la">Christum oro compellas <lb xml:id="p1z22"/>nostris verbis, ut secundet introitum istum.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z23"/>D. <persName ref="p506">Butlero</persName>, amico nostro, dicens ex me salutem <lb xml:id="p1z24"/>refer me ex <persName ref="p8474">Onophoro</persName> didicisse litteras suas <lb xml:id="p1z25"/>unas atque alteras sibi redditas esse, verum quod <lb xml:id="p1z26"/>respondeat nondum se habere, sed eodem de negocio <lb xml:id="p1z27"/>scripsisse aliis, quorum nunc expectet responsum.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z28"/>Ego illum hortatus sum, ut maturet; igitur maturaturum <lb xml:id="p1z29"/>se recepit.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale, honorifice <persName ref="p495">Bullinger</persName>, et me, <lb xml:id="p1z30"/>quod facis, ama in domino cum fratribus nostris.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z31"/>In predio meo <placeName ref="l193">Vultureio</placeName> iuxta <placeName ref="l257">Constantiam</placeName>.</s>
					<s n="12" xml:lang="de"><lb xml:id="p1z32"/>21. die iulii 1549.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z33"/><persName ref="p8178">Thomas Bl[aurerus</persName>] tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
