	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hodie sedente senatu venit ile noster nuncius; itaque <lb xml:id="p1z2"/>neminem super hac re alloqui potui.</s>
					<s n="3" xml:lang="la">Literae mox lectae et de<lb xml:id="p1z3"/>cretum, ut aliae illuc scribantur; quid illae contineant, ignoro; <lb xml:id="p1z4"/>iamiam enim senatus surrexit.</s>
					<s n="4" xml:lang="la">Legi interea, quas misisti, <lb xml:id="p1z5"/><persName>Philippi</persName>, <persName ref="p8041">Ioannis a Lasco</persName> et <persName ref="p8386">Hyperii</persName> literas et ago <lb xml:id="p1z6"/>tibi magnas gratias, quod illas communicaveris mihi.</s>
					<s n="5" xml:lang="la">Legit illas quoque <lb xml:id="p1z7"/><persName ref="p8417">Musculus</persName> atque etiam <persName>Mauritius</persName> atque illis delectati sunt admodum.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/><persName ref="p8417">Musculus</persName> heri scripsit literas, quas his inclusas mitto.</s>
					<s n="7" xml:lang="la">Valde nos <lb xml:id="p1z9"/>torquet iurisiurandi comunis negotium.</s>
					<s n="8" xml:lang="la">Nostri hactenus per domini gr<lb xml:id="p1z10"/>atiam firmi fuere.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Nunc audio (sed quam hoc verum sit, nescio) <lb xml:id="p1z11"/><placeName ref="l587">Tigurinorum</placeName> legatos spem aliquam fecisse reliquis <placeName ref="l21">Badenae</placeName> fore, <lb xml:id="p1z12"/>ut cum ipsis consentiant, quod tamen nunquam futurum spero.</s>
					<s n="10" xml:lang="la">Nos <lb xml:id="p1z13"/>hic serio negotium urgemus hoc, ut constantes maneant et cogitent, <lb xml:id="p1z14"/>quantum sit hoc peccatum contra deum, quantum etiam offendiculi apud exteros <lb xml:id="p1z15"/>hinc sit oriturum.</s>
					<s n="11" xml:lang="la">Hodie pariter consules super hac re conveniemus.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z16"/>Senatum etiam et diacosios hac septimana, si necesse sit, <lb xml:id="p1z17"/>accedere decrevimus.</s>
					<s n="13" xml:lang="la">Nolumus, ut nostra negligentia <lb xml:id="p1z18"/>hinc quicquam peccetur, et speramus dominum affuturum nobis et successum <lb xml:id="p1z19"/>daturum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z20"/>Quod <placeName ref="l167">Genevenses</placeName> attinet, fuit illic hisce diebus <lb xml:id="p1z21"/><persName>Mauritius</persName> noster; humaniter fuit exceptus.</s>
					<s n="15" xml:lang="la">Retulit <persName ref="p540">Calvino</persName> <lb xml:id="p1z22"/>varia, quę de eo dicantur; ille negavit omnia.</s>
					<s n="16" xml:lang="la">Simul audivit per totam <lb xml:id="p1z23"/><placeName ref="l2478">Sabaudiam</placeName> miros rumores de <persName ref="p540">Calvino</persName> et aliis ministris; vix cen<lb xml:id="p1z24"/>tesimus reperitur, qui de eo aliquid loquatur boni.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Is, qui hic <lb xml:id="p1z25"/>captivus detinetur, nihildum confessus est.</s>
					<s n="18" xml:lang="la">Miserunt nostri <lb xml:id="p1z26"/>nuncium <placeName ref="l167">Genevam</placeName> pro confessione, quam illic fecit; ea ubi <lb xml:id="p1z27"/>allata fuerit, amplius cum eo agetur.</s>
					<s n="19" xml:lang="la">Natus est <persName>Romanus</persName> <lb xml:id="p1z28"/>et qualitercunque doctus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Ego his diebus mecum habui [d.<lb xml:id="p1z29"/>] <lb xml:id="p1z30"/><persName ref="p1911">Thomam Leverum</persName> <placeName ref="l830">Anglium</placeName> cum tribus aliis: biduo mecum fu[erunt], <lb xml:id="p1z31"/>hodie hinc discesserunt <placeName ref="l280">Lausannam</placeName> versus.</s>
					<s n="21" xml:lang="la">Praedicant illi valde <lb xml:id="p1z32"/>vestram humanitatem.</s>
					<s n="22" xml:lang="la">His non habeo, quod nunc addam.</s>
					<s n="23" xml:lang="la"><lb xml:id="p1z33"/>Scribam hisce diebus plura de versione Decadum tuarum <lb xml:id="p1z34"/>per <persName ref="p4191">Apiarium</persName> nostrum illuc profecturum.</s>
					<s n="24" xml:lang="la" ana="salute"><lb xml:id="p1z35"/>Salutant te nostri omnes; <lb xml:id="p1z36"/>salvos cupimus etiam tuos omnes.</s>
					<s n="25" xml:lang="la"><placeName ref="l41">Bernae</placeName> 7. octobris 1555.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p1z37"/>Tuus <persName ref="p8018">I[oan<lb xml:id="p1z38"/>nes] H[a<lb xml:id="p1z39"/>llerus</persName>].</s>
				</p>
				<p>
					<s n="27" xml:lang="la">Heri obiit d. <persName>Petrus Waltherus</persName>, consistorii <lb xml:id="p1z40"/>nostri pedellus, apud quem studiosi vestrates <lb xml:id="p1z41"/>egerunt; illis ergo de alio hospitio prospiciendum <lb xml:id="p1z42"/>erit; nescio, ubi commode collocari possint<pb/><lb xml:id="p2z1"/>.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p2z3"/>Clarissimo viro d. <persName ref="p495">Heinrycho Bulli<lb xml:id="p2z4"/>ngero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae pastori <lb xml:id="p2z5"/>fidelissimo, domino et compatri <lb xml:id="p2z6"/>suo et colendissimo et charissimo.</s>
				</p>
				<p>
					<s n="29" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zürich</placeName>.</s>
					<s n="30" xml:lang="de">M. <persName ref="p495">Heinrych Bullingern</persName>.</s>
				</p>
				<p>
					<note>[Von <persName ref="p495">Bullingers</persName> Hand auf der Rückseite noch die Bemerkung:]</note>
					<s n="31" xml:lang="de">Das pündts<lb xml:id="p2z8"/>chweren by den heylig<lb xml:id="p2z9"/>en.</s>
				</p>
			</div>
