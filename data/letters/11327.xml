	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/><persName ref="p4830">Adamus Phry</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p4830">Adam Frey</persName>.</note> apud me est.</s>
					<s n="3" xml:lang="la">Consultamus, quid amplius a<lb xml:id="p1z3"/>gendum.</s>
					<s n="4" xml:lang="la">Est medicus doctor <persName ref="p6618">Sebastianus</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p6618">Sebastian Sinckeler</persName>.</note> mihi amicissimus, qui, tam<lb xml:id="p1z4"/>etsi nihil promittit ob temporis et morbi longitudinem, tamen <lb xml:id="p1z5"/>tentabit aliquid, quod non nocebit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quod si processerit, ibit <lb xml:id="p1z6"/>fortassis <persName ref="p4830">Adamus</persName> ad thermas.</s>
					<s n="6" xml:lang="la">Quęso per dominum te, ut <lb xml:id="p1z7"/>pro tua authoritate sis illi auxilio.</s>
					<s n="7" xml:lang="la">Videtur mihi vir <lb xml:id="p1z8"/>bonus et dei gnarus, unde et dignus, cui praestent <lb xml:id="p1z9"/>omnes boni, quo succurratur.</s>
					<s n="8" xml:lang="la">Apud dominos commendabis more <lb xml:id="p1z10"/>tuo diligenter, quęso, virum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><persName ref="p8011">Rodulfus</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p8011">Rudolf Gwalther</persName>.</note> ivit <placeName ref="l280">Lausannam</placeName>, <lb xml:id="p1z11"/>nescio quo consilio<note xml:id="fn4" type="footnote" n="4">In einem Brief an <persName ref="p8418">Myconius</persName> entschuldigte sich <persName ref="p8011">Gwalther</persName> für seine grußlose Abreise; s. Corr. des réformateurs V 365f, <ref target="file10847">Nr. 808</ref> (Juli 1539).</note>.</s>
					<s n="10" xml:lang="la">Causa nostra<note xml:id="fn5" type="footnote" n="5">Gemeint ist der Konflikt um die neuen Universitätsstatuten; vgl. zuletzt oben <ref target="file11321">Nr. 1278</ref>, 45-57 und 63-66.</note> (nisi mutetur) <lb xml:id="p1z12"/>et te et <persName ref="p8401">Conzenum</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p8401">Peter Kunz</persName>.</note> et <placeName ref="l491">Argentinenses</placeName><note xml:id="fn7" type="footnote" n="7"><persName ref="p5565">Capito</persName> und <persName ref="p467">Bucer</persName>.</note> expetit et expectat <lb xml:id="p1z13"/>brevi post hęc.</s>
					<s n="11" xml:lang="de">Der libhaftig tüfel hedt ein ding <lb xml:id="p1z14"/>angehept; ist inn schir gerüwen<note xml:id="fn8" type="footnote" n="8">er bereut es beinahe.</note>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Vale semper cum tuis <lb xml:id="p1z15"/>et officiosissime salutabis <persName ref="p8127">Pellicanum</persName> et <persName ref="p8171">Theodorum</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p8171">Theodor Bibliander</persName>.</note>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l28">Bas<lb xml:id="p1z16"/>ileę</placeName><note xml:id="fnb" type="footnote" n="b"><hi>korrigiert aus</hi> Basilaeae.</note>, 2. iulii anno 39.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z17"/>Tuus <persName ref="p8418">Myco<lb xml:id="p1z18"/>nius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>antistiti <placeName ref="l587">Tigurino</placeName>, <lb xml:id="p2z3"/>fratri in Christo observando <lb xml:id="p2z5"/>suo.</s>
				</p>
			</div>
