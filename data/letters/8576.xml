	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil nunc erat, clarissime vir et pater in Christo summe colende, <lb xml:id="p1z2"/>de quo peculiariter literas darem.</s>
					<s n="3" xml:lang="la">Cum vero nobilis <lb xml:id="p1z3"/><persName>Schorzius</persName> visendae urbis inspiciendaeque ecclesiae et scholae <lb xml:id="p1z4"/>vestrae gratia ad vos iter facturus adiuncto sibi comi<lb xml:id="p1z5"/>te d. <persName ref="p21258">Ietzlero</persName> esset, ut occasionem uterque tuam quoque <lb xml:id="p1z6"/>humanitatem alloquendi haberet, hanc saltem schedulam <lb xml:id="p1z7"/>simul mittere volui.</s>
					<s n="4" xml:lang="la">D. <persName ref="p21258">Ietzlerus</persName> tibi haud ignotus <lb xml:id="p1z8"/>qualis sit, non est, quod multis referam; equidem <lb xml:id="p1z9"/>ipse unice illum et ex animo amo magnique facio ut <lb xml:id="p1z10"/>hominem eruditione singulari, pietate, modestia, iudici<lb xml:id="p1z11"/>o omnibusque breviter virtutibus ornatissimum, <lb xml:id="p1z12"/>quem solum inter <placeName ref="l441">Scaphusianae</placeName> ecclesiae alumnos peculia<lb xml:id="p1z13"/>re patriae nostrae lumen fore summa animi laetitia <lb xml:id="p1z14"/>in domino spero.</s>
					<s n="5" xml:lang="la">Unum illi deest, quod videlicet ab <lb xml:id="p1z15"/>idiotis nondum agnoscitur et propter temporis importunitatem <lb xml:id="p1z16"/>in eum locum nondum provehi potuit, quo <lb xml:id="p1z17"/>prae caeteris dignissimus esset.</s>
					<s n="6" xml:lang="la">Sed dominus, qui humilia <lb xml:id="p1z18"/>respicit, suo illo constituto et praefinito tempore exaltabit.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z19"/>D. vero <persName>Schorzius</persName> cum <persName ref="p21258">Ietzlero</persName> praeceptore utatur, non dubium <lb xml:id="p1z20"/>est, quin illum et eruditionis et virtutum laude sub<lb xml:id="p1z21"/>sequi contendat.</s>
					<s n="8" xml:lang="la">Talis igitur uterque cum sit, etiam atque etiam <lb xml:id="p1z22"/>te oro, ut faciem illos tuam perbenigne intueri coram <lb xml:id="p1z23"/>et monita oris tui suavissima et saluberrima au<lb xml:id="p1z24"/>dire concedas.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Hoc beneficium tam mihi quam illis <lb xml:id="p1z25"/>erit gratum quam quod gratissimum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z26"/>Vale.</s>
					<s n="11" xml:lang="la" ana="salute">Meo et fratrum nomine omnes symmystas et fratres, <lb xml:id="p1z27"/>qui apud vos sunt, reverenter salutabis.</s>
					<s n="12" xml:lang="la" ana="salute">Salutant <lb xml:id="p1z28"/>te consules et symmystae nostri.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Datum 2. iunii <lb xml:id="p1z29"/>anno 1571.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z31"/>Tui studiosissimus <lb xml:id="p1z32"/><persName ref="p8109">Ioannes Conradus Ulmerus</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro eximioque Christi servo <lb xml:id="p2z2"/>d. <persName ref="p495">Henrico Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae antistiti vigilantissimo, <lb xml:id="p2z4"/>amico et patri suo in Christo <lb xml:id="p2z5"/>summe colendo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>