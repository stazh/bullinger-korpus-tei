	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>grsar wysen gestrung edel vost
					<lb xml:id="p1z2"/>frmm ersen fürsichtig und wyse gl lieb h, wiewol ich
					<lb xml:id="p1z3"/>i etwas libdings vomm huß buliken ein zythar versä
					<lb xml:id="p1z4"/>evar
					<lb xml:id="p1z5"/>alls der  dem selben huß yngelibet und des coments
					<lb xml:id="p1z6"/>daselbs gewäsen, so stand doch mine sachen in disem minen
					<lb xml:id="p1z7"/>allter, das ich mitt dem, das mir bestimpt ist schwarlich mich
					<lb xml:id="p1z8"/>erhallten mag, und do ich vormalen amm dienst der kylchen noch
					<lb xml:id="p1z9"/>und mich ettwas mögen erbesseren, das ich diser zyt
					<lb xml:id="p1z10"/>dister komlicher läben könde, hab ich ettliche stuckdorb
					<lb xml:id="p1z11"/>ich in mine und nitt
					<lb xml:id="p1z12"/>gehept, die mich emglöst, alls der
					<lb xml:id="p1z13"/>gott
					<lb xml:id="p1z14"/>er
					<lb xml:id="p1z15"/>mitt kleinen kosten ein sun, der diser zyt uch inen
					<lb xml:id="p1z16"/>gnädige herren zuͦ Kylchberg uff der pfarr dienet
					<lb xml:id="p1z17"/>d das
					<lb xml:id="p1z18"/>dökundund ein kranckt Schwyger hyn hat, erzogen
					<lb xml:id="p1z19"/>Duwt sarziinn
					<lb xml:id="p1z20"/>von Heirychen forster selig ein huß  erkoufft, das wol
					<lb xml:id="p1z21"/>kost und aber einschlächte burlose herberig ist, zuͦ
					<lb xml:id="p1z22"/>dem allem ich dann ouch ein guͦte zyt ein kränk wyb
					<lb xml:id="p1z23"/>an miner lieben huffen gehept und sunst ouch allerley kostens
					<lb xml:id="p1z24"/>ichs ettlichen eeren lüshen und nanlic
					<lb xml:id="p1z25"/>tragen, und do sö
					<lb xml:id="p1z26"/>üch  ming nit unbewüst, welche ouch
					<lb xml:id="p1z27"/>das wüssend, das ich uß der gnad gottes in 40 jar lang
					<lb xml:id="p1z28"/>üwer miner glhr biderberlüth uff dem pfarren buͦbick
					<lb xml:id="p1z29"/>gewesen
					<lb xml:id="p1z30"/>mitt allen trüwen, wie ich
					<lb xml:id="p1z31"/>und stannen k
					<lb xml:id="p1z32"/>sy vrgseche.
					<lb xml:id="p1z33"/>ehar aber über min järliche
					<lb xml:id="p1z34"/>vermögen.
					<lb xml:id="p1z35"/>daren ich mich gebotten
					<lb xml:id="p1z36"/>von üch mie ge herren geforen
					<lb xml:id="p1z37"/>besollung dienm.
					<lb xml:id="p1z38"/>gebätten noch empfangen, habend sy vermeint
					<lb xml:id="p1z39"/>so ferr ir min gn h sömliches bericht, wurdint  mich
					<lb xml:id="p1z40"/>in gnaden bedäncken, habend mich och hiemitt so gehertz
					<lb xml:id="p1z41"/>acht das ich sunst schwarlich dörffen hätte, aber jetzund
					<lb xml:id="p1z42"/>vor üch ng h erschyn und bitten zuͦ früntlichisch
					<lb xml:id="p1z43"/>Ggott und
					<lb xml:id="p1z44"/>und rderthänigisten. sewyl igh, üoch minren g hi über
					<lb xml:id="p1z45"/>die 40 jar gedienet und üch it ye beschwerlich
					<lb xml:id="p1z46"/>gewesen, ir min gh wöllind nit ettliche sauf
					<lb xml:id="p1z47"/>zuͦ den lybding gnädicklichen thuͦn, damitt ich in min
					<lb xml:id="p1z48"/>ineo
					<lb xml:id="p1z49"/>b min notturfft gehaben möge. Dorumb wil
					<lb xml:id="p1z50"/>ich mich underthanig und dankbarlich erzeigen mitt alle
					<lb xml:id="p1z51"/>denden uch mie ggefellig und mir üüglich. Bitten under
					<lb xml:id="p1z52"/>thänig dise in supplication in geaaden anzuͦnen
					<lb xml:id="p1z53"/>eere
					<lb xml:id="p1z54"/>und zuͦ bedencken, und gott wölle uwer wyßfeit ingwolstand
					<lb xml:id="p1z55"/>und feiden lang lassen regieren.
					<pb/>
					<lb xml:id="p2z1"/>für den dechan
					<lb xml:id="p2z2"/>vo Stantheyn
					<lb xml:id="p2z3"/>H. Hans Stupff
					<lb xml:id="p2z4"/>1569.
				</p>
