	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Ad communes literas rescribit, opinor, <lb xml:id="p1z2"/>dilectus compater meus d. <persName ref="p8018">Hallerus</persName>, compater <lb xml:id="p1z3"/>in domino charissime.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Ostendit nobis principia re<lb xml:id="p1z4"/>rum magnarum, quae iam in <placeName ref="l749">Saxonia</placeName> tentantur.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Orandus nobis dominus est et privatim <lb xml:id="p1z6"/>et publice, ut conatibus afflictorum in extremis <lb xml:id="p1z7"/>necessitatibus constitutorum adversus antichristianorum <lb xml:id="p1z8"/>impietatem et improbitatem virtute spiritus <lb xml:id="p1z9"/>sui adesse velit et ecclesiis suis pro sua <lb xml:id="p1z10"/>infinita providentia consulere.</s>
					<s n="5" xml:lang="la">Alioqui motus <lb xml:id="p1z11"/>isti iam non medebuntur horum temporum malis, <lb xml:id="p1z12"/>ut magis intolerabilem sint allaturi rerum omnium <lb xml:id="p1z13"/>perturbationem et exacerbationem, nisi adiuvemus <lb xml:id="p1z14"/>gratia et auxilio dei.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Nec cogitandum est <lb xml:id="p1z15"/>vestris sicuti nec nostris res vestras nunc <lb xml:id="p1z16"/>minus agi quam aliorum.</s>
					<s n="7" xml:lang="la">Periculum imminet prorsus <lb xml:id="p1z17"/>communi; si male cesserit istis, qui nunc <lb xml:id="p1z18"/>vitam et omnia sua in periculum exponunt, v<lb xml:id="p1z19"/>idebimus confestim incendii huius flammas <lb xml:id="p1z20"/>nostris imminere parietibus, id quod clemen<lb xml:id="p1z21"/>tissimus pater avertere dignetur.</s>
					<s n="8" xml:lang="la">Verum de his <lb xml:id="p1z22"/>non est opus, ut prudentiam tuam admoneam.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z23"/>Videndum nobis est, ut sic sapiamus, ne pi<lb xml:id="p1z24"/>etatis et charitati fraternę desimus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Domino te <lb xml:id="p1z25"/>cum tuis omnibus, compater in Christo charissime, <lb xml:id="p1z26"/>commendo.</s>
					<s n="11" xml:lang="la" ana="salute">Salutem omnibus dominis ac fratribus <lb xml:id="p1z27"/>isthic et cum primis uxori honestissimae et <lb xml:id="p1z28"/>liberis.</s>
					<s n="12" xml:lang="la">Domus mea adhuc satis est per <lb xml:id="p1z29"/>gratiam domini tranquilla, quamvis pestis nonnihil <lb xml:id="p1z30"/>hactenus sedata denuo nos invisere coeperit.</s>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z31"/>Rursus vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1551. 13. ianuarii.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><persName ref="p8417">W[ol<lb xml:id="p1z32"/>fgangus] Musc[ulus]</persName>, tuus compater <lb xml:id="p1z33"/>in domino totus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo m. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho Bul<lb xml:id="p2z4"/>lingero</persName>, com<lb xml:id="p2z5"/>patri suo in <lb xml:id="p2z6"/>Christo longe <lb xml:id="p2z7"/>charissimo.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
