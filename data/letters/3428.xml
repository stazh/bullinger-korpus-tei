	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime vir et mihi tamquam pater observande, <lb xml:id="p1z2"/>ita abruptum est colloquium, <lb xml:id="p1z3"/>ut res sit reiecta ad proxima comitia, <lb xml:id="p1z4"/>in quibus melior forma prę<lb xml:id="p1z5"/>scribetur; iam discesserunt omnes.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z6"/>Ego cum <placeName ref="l572">Virtembergensibus</placeName> hucusque <lb xml:id="p1z7"/>vix potui; quando per valetudinem <lb xml:id="p1z9"/>licebit, quod etiam spero, ante natalem ad vos <lb xml:id="p1z10"/>veniam.</s>
					<s n="3" xml:lang="la">Utinam literas vestras <lb xml:id="p1z11"/>recepisset <persName ref="p2095">Melanton</persName>; o quam multa inde <lb xml:id="p1z12"/>secuta fuissent commoda reipublicę <lb xml:id="p1z13"/>christianę.</s>
					<s n="4" xml:lang="la">Sed plura de his coram <lb xml:id="p1z14"/>deo dante.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell">Interea vos omnes longe <lb xml:id="p1z15"/>melius valete et pro me deum <lb xml:id="p1z16"/>orate, qui gravissima affligor tussi et <lb xml:id="p1z17"/>catarrho oppressus quiescere cogor.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z18"/><placeName ref="l512">Tubingae</placeName> 8. decembris 1557.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z19"/>O. f. <lb xml:id="p1z20"/><persName ref="p8101">Lelius Sozinus</persName>. <pb/><lb xml:id="p2z1"/>(obediens filius)</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Clarissimo et in omni <lb xml:id="p2z2"/>virtutum genere <lb xml:id="p2z3"/>praestantissimo domino <lb xml:id="p2z4"/><persName ref="p495">Henrico Bullingero</persName> <lb xml:id="p2z5"/>tanquam patri observandissimo.</s>
					<s n="9" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
