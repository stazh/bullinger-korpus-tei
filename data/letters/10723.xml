	<text xml:lang="de">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Min früntlich diennst zuͦvor.</s>
				</p>
				<p>
					<s n="2" xml:lang="de">Ersamer, getrüwer, <lb xml:id="p1z2"/>lieber her gfatter<note xml:id="fn1" type="footnote" n="1">Zur verwandtschaftlichen Anrede vgl. <hi>Bächtold,</hi> <persName ref="p495">Bullinger</persName> vor dem Rat 208f, Anm. 62.</note>, uff üwer beger schick ich üch ein kalb.</s>
					<s n="3" xml:lang="de"><lb xml:id="p1z3"/>Han ich by einem nachpuren<note xml:id="fn2" type="footnote" n="2">Unbekannt.</note> erfragt.</s>
					<s n="4" xml:lang="de">Gott wellt, es wär <lb xml:id="p1z4"/>üch zuͦ diser zit gelegenn.</s>
					<s n="5" xml:lang="de">Ich han aber keiner zit künnen <lb xml:id="p1z5"/>faren; dann<note xml:id="fn3" type="footnote" ana="lex" n="3">deshalb (<bibl source="b590">SI</bibl> XIII 37).</note>, dwyl sy jetz seltzam<note xml:id="fn4" type="footnote" n="4">rar, knapp (<bibl source="b590">SI</bibl> VII 872f).</note> sinnd, han ichs gschickt, <lb xml:id="p1z6"/>so bald ichs han ankommen<note xml:id="fn5" type="footnote" n="5">sobald ich es bekommen habe.</note>.</s>
					<s n="6" xml:lang="de">Darumb nemmend min dienst <lb xml:id="p1z7"/>imbesten an unnd sinnd damit gott bevolhenn.</s>
					<s n="7" xml:lang="de"><lb xml:id="p1z8"/>So ich zuͦ üch komm, wil ich sagen, was es kost.</s>
				</p>
				<p>
					<s n="8" xml:lang="de">Datum <lb xml:id="p1z9"/>zinstags vor Cathrinen 1535.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z10"/><persName ref="p8443">Petrus Simler</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="10" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem wolgelerten, ersamen <lb xml:id="p2z2"/>heren Meister <persName ref="p495">Heinrich Bullinger</persName>, <lb xml:id="p2z3"/>predicant <placeName ref="l587">Zürich</placeName>, minen lieben <lb xml:id="p2z4"/>heren und gfatter.</s>
				</p>
			</div>
		</body>
	</text>
