	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non est, quo[d literis tu?] is<note xml:id="fna" type="footnote" n="a"><hi>Ein Stück des Textes wurde herausgeschnitten.</hi></note> respondeam,<note xml:id="fn1" type="footnote" n="1"><persName ref="p495">Bullingers</persName> Brief ist nicht erhalten.</note> nisi quod boni consulo, quicq<lb xml:id="p1z2"/>uid iniectum est <lb xml:id="p1z3"/>remorarum huic, quod nosti, instituto, <lb xml:id="p1z5"/>mi venerande pariter et charissime frater, neque dubito, quin <lb xml:id="p1z6"/>singulari cęlestis patris consilio<pb type="edition" next="320"/> factum sit, quod non potuit <lb xml:id="p1z7"/>successus aliquis esse tot annorum in hac re conatuum<note xml:id="fn2" type="footnote" n="2"><persName ref="p8055">Blarer</persName> bezieht sich wahrscheinlich auf den möglichen Anschluss von <placeName ref="l257">Konstanz</placeName> an die <placeName ref="l862">Eidgenossenschaft</placeName>; s. zuletzt oben <ref target="file11966">Nr. 1919</ref>, 18-45.</note>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z8"/>Olim, tamen, puto utrinque videbimus consilii huius non <lb xml:id="p1z9"/>obscuram rationem.</s>
					<s n="4" xml:lang="la">Valde me solatur in istis dubiis <lb xml:id="p1z10"/>temporibus, quod non certa solum, sed optima quoque de <lb xml:id="p1z11"/>nobis constituit, qui solus rerum, velit nolit mundus<note xml:id="fn3" type="footnote" n="3"><persName ref="p18986">Hieronymus</persName>, Epistulae, 45, 7.</note>, <lb xml:id="p1z12"/>potitur; illi nos, quam feliciter possumus, tam etiam, <lb xml:id="p1z13"/>quanti quanti sumus, permittamus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="salute">Bene vale, mi <lb xml:id="p1z14"/><persName ref="p495">Bullingere</persName>, nosque sanctissima pertinacia perpetuo ama, <lb xml:id="p1z15"/>Christo nos et nostros piis votis diligenter commendans.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z16"/>Mitto <persName ref="p8417">Musculi</persName> literas<note xml:id="fn4" type="footnote" n="4">Oben <ref target="file11990">Nr. 1943</ref>.</note>; ad quem si quid forte rescribere <lb xml:id="p1z17"/>volueris, mitte<note xml:id="fn5" type="footnote" n="5">Auf <persName ref="p495">Bullingers</persName> (verschollene) Antwort antwortete <persName ref="p8417">Musculus</persName> am 19. September 1544, unten <ref target="file12038">Nr. 1991</ref>.</note>.</s>
					<s n="7" xml:lang="la" ana="salute">Saluta omnes fratres et amicos <lb xml:id="p1z18"/>cum tota tua domo.</s>
					<s n="8" xml:lang="la">Commenda nos optimo consuli <persName ref="p2816">Röstio</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p2816">Diethelm Röist</persName>.</note>.</s>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z19"/><persName ref="p8011">Gvalthero</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p8011">Rudolf Gwalther</persName>.</note> scribam, ubi primum vacabit;<note xml:id="fn8" type="footnote" n="8">Der nächste erhaltene Brief <persName ref="p8055">Blarers</persName> an <persName ref="p8011">Gwalther</persName> datiert vom 8. Oktober (<persName ref="p8055">Blarer</persName> BW II 305f, <ref target="file11175">Nr. 1132</ref>).</note> tu hominem <lb xml:id="p1z20"/>mea vice amantissime saluta.</s>
					<s n="10" xml:lang="la" ana="farewell">Iterum vale.</s>
					<s n="11" xml:lang="la">29. iulii<note xml:id="fnb" type="footnote" n="b"><hi>Darunter von Traugott Schieß' Hand:</hi> 1544.</note><lb xml:id="p1z21"/>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/>Pecuniam accepi<note xml:id="fn9" type="footnote" n="9">Möglicherweise handelt es sich um die Bezahlung eines Boten.</note>.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z23"/>Tuus <persName ref="p8055">Ambr.</persName></s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo pietate et eruditi<lb xml:id="p2z2"/>one viro d. <persName ref="p495">Heinricho Bul<lb xml:id="p2z3"/>lingero</persName>, amico modis omnibus <lb xml:id="p2z4"/>summo.</s>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
