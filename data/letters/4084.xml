	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Mitto acta consilii <placeName ref="l18">Augustani</placeName> coniuncta.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">De rebus <placeName ref="l832">Gallie</placeName> nihil adhuc certi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Potest ullus scribere, ante quam ex inauguratione et unctione redierint omnes <lb xml:id="p1z3"/>ad loca quietiora?</s>
					<s n="4" xml:lang="la">Utitur dominus suis mediis extra captum humani <lb xml:id="p1z4"/>ingenii et momento convertit multa negocia et obstinatissimos animos emollit <lb xml:id="p1z5"/>et imbecillitatem confirmat et desperatas res erigit et reficit.</s>
					<s n="5" xml:lang="la">Que de concertationibus <lb xml:id="p1z6"/><placeName ref="l749">Saxonicis</placeName> scripsisti, gratissima mihi fuerunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Expectare debemus magnos progressus <lb xml:id="p1z7"/>ubique.</s>
					<s n="7" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Salutabis amicos omnes.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l760">Sol[uturi]</placeName> 20. septembris.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z8"/>Tuus ex animo <persName ref="p629">C[oignetius]</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
