	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Dominus <persName ref="p8089">Scipio</persName> impetravit ab amplissimis <lb xml:id="p1z2"/>nostris dominis intercessione tua et nostra, <lb xml:id="p1z3"/>quae voluit; est ergo, quod tibi gratias agat; <lb xml:id="p1z4"/>clementissimos enim dominos est <lb xml:id="p1z5"/>expertus, quod testificabitur ipse.</s>
					<s n="3" xml:lang="la">Velim ergo, <lb xml:id="p1z6"/>si quando per occasionem liceret, aut ipse consulibus <lb xml:id="p1z7"/>gratias ageres aut saltem in tuis ad me <lb xml:id="p1z8"/>literis Germanice aspergeres aliquid eiusmodi, <lb xml:id="p1z9"/>ex quo intelligere possent officia sua, quae <lb xml:id="p1z10"/>promptissime praestitere, grata nobis et aliis <lb xml:id="p1z11"/>piis accidisse.</s>
					<s n="4" xml:lang="la">Heri venit <persName ref="p3375">Vergerius</persName> praeter <lb xml:id="p1z12"/>omnem spem nostram et de multis multa; <lb xml:id="p1z13"/>periclitari potius voluit hanc viam quam res <lb xml:id="p1z14"/>tantas (ita ipse dicit, nondum audivi, quid sit), <lb xml:id="p1z15"/>quas tractandas suscepit, negligere.</s>
					<s n="5" xml:lang="la">Ego <lb xml:id="p1z16"/>omnia diligenter observabo adque te diligentissime <lb xml:id="p1z17"/>perscribam.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Tu tibi eo nomine servabis, quo <lb xml:id="p1z18"/>plura mihi experiri liceat; tacebo tantisper, <lb xml:id="p1z19"/>dum veritatis negocium agatur mihique per religionem <lb xml:id="p1z20"/>amplius tacere non datur.</s>
					<s n="7" xml:lang="la">Haec obiter et breviter <lb xml:id="p1z21"/>et subito.</s>
					<s n="8" xml:lang="la">27. martii anno 1562.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z22"/>T[uus] <persName ref="p8009">Fab[ricius</persName>].</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Tu, quaeso, has literas legito et postea <persName ref="p4554">Rodolpho <lb xml:id="p1z23"/>Collino</persName> affini reddendas curato.</s>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>d. et patri suo in <lb xml:id="p2z4"/>Christo reverendo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
