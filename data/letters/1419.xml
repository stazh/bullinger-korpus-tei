	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Cum in hunc oportunum nunccium incidissem, ornatissime <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z2"/>nolui omittere, quin has ad te darem.</s>
					<s n="2" xml:lang="la">Misi nuper ad te unas literas <lb xml:id="p1z3"/>per <persName ref="p1227">Froschouerum</persName> diutius apud me tabellionum defectu retentas, quam <lb xml:id="p1z4"/>voluissem.</s>
					<s n="3" xml:lang="la">Medio tempore nihil novi huc allatum aut hic natum.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Scriptum huc <placeName ref="l18">Augusta</placeName> ad nos ex Caesaris aula fuit eius maiestatem <lb xml:id="p1z6"/>constituisse illinc discedere 25. septembris; verum totis mediis <lb xml:id="p1z7"/>diebus nihil certi accepimus, an illinc abierint an non.</s>
					<s n="5" xml:lang="la">Insignia 6 <lb xml:id="p1z8"/>peditum <placeName ref="l18">Augustę</placeName> remanebunt, an pręsidio an oppressioni urbis, <lb xml:id="p1z9"/>non satis scio, et eis quidem civitas stipendia numerabit.</s>
					<s n="6" xml:lang="la">Hodie <lb xml:id="p1z10"/>mihi narratum est imperatorem 4000 equitum in <placeName ref="l39">Luccenburgensi</placeName> ducatu <lb xml:id="p1z11"/>habere et <persName>Martinum Rossmium</persName> propediem adventurum cum longe <lb xml:id="p1z12"/>maximis (si credere libet) equitum et peditum copiis ad invadendam <lb xml:id="p1z13"/><placeName ref="l832">Galliam</placeName>.</s>
					<s n="7" xml:lang="la">Equidem vix credere possum imperatorem quicpiam hoc anno tem<lb xml:id="p1z14"/>ptaturum bello, nisi id in animo habeat <persName>Gallum</persName> ex <placeName>Italia</placeName> detra<lb xml:id="p1z15"/>here et vires eius disiungere.</s>
					<s n="8" xml:lang="la">Et cum <placeName ref="l2510">Turca</placeName> tum in <placeName ref="l2549">Africa</placeName> <lb xml:id="p1z16"/>tum in <placeName ref="l882">Hungaria</placeName> magnis cladibus christianos persequatur, <lb xml:id="p1z17"/>verisimile est imperatorem comitia indicturum, ut ordinum imperii <lb xml:id="p1z18"/>auxilio et sociis armis <placeName ref="l2510">Turcę</placeName> et <placeName ref="l832">Gallo</placeName> resistat, quod in his partibus <lb xml:id="p1z19"/>commodius quam in <placeName ref="l808">Belgis</placeName> faciet.</s>
					<s n="9" xml:lang="la">Quicquid erit, propediem <lb xml:id="p1z20"/>sciemus.</s>
					<s n="10" xml:lang="la" ana="salute">Commenda me d. <persName ref="p506">Butlero</persName> <placeName ref="l830">Anglo</placeName> et tuis generis.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z21"/>Mea in te perpetuo offitia constabunt.</s>
					<s n="12" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
