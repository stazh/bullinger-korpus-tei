			<zone xml:id="p2z4-0" points="2087,770 2156,781 2193,765 2291,804 2342,802 2376,775 2464,823 2509,823 2496,664 2397,696 2320,688 2262,720 2204,709 2097,637 2076,645">2099,740 2124,737 2150,734 2176,734 2202,736 2227,739 2253,743 2279,746 2305,748 2330,749 2356,751 2382,753 2408,755 2433,758 2459,761 2485,765 2511,764</zone>
