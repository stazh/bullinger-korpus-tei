	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, optime <persName ref="p495">Bullingere</persName>.</s>
					<s n="2" xml:lang="la">Has scribo ex <placeName ref="l491">Argentina</placeName>, <lb xml:id="p1z2"/>quo ante sex dies veni abiturus hodie.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Contuli scripta quaedam mea cum <lb xml:id="p1z4"/>d. <persName ref="p8111">Martyre</persName>, qui mihi summe placuit.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Attuli huc librum cardinalis <persName>Poli</persName>, qui omnium <lb xml:id="p1z6"/>piorum animas valde commovet; per<lb xml:id="p1z7"/>ficiam, ut etiam tu videre eum possis.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Legi magnam partem historiae, quam <persName ref="p6096">Sleidanus</persName> <lb xml:id="p1z9"/>adornat; spero eam vehementissim<lb xml:id="p1z10"/>e perturbaturam esse infoelicem pa<lb xml:id="p1z11"/>patum, qui sollicitus est hoc nomine <lb xml:id="p1z12"/>inprimus, ut extinguat lucem hac <lb xml:id="p1z13"/>beata aetate exortam.</s>
					<s n="6" xml:lang="la">At historia <lb xml:id="p1z14"/>haec fere illustriorem eam reddat.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Non paenitet me laboris et sumptus, <lb xml:id="p1z16"/>quem feci huc veniens, quandoquidem <lb xml:id="p1z17"/>videor mihi bene multum ad eam <lb xml:id="p1z18"/>contulisse et posse porro afferre.</s>
					<s n="8" xml:lang="la">Vidi <lb xml:id="p1z19"/>tuum filium, qui mihi sane placet, et <lb xml:id="p1z20"/>tu sapienter fecisti, qui illum huc extru<lb xml:id="p1z21"/>xeris; iam se mire accommodavit blan<lb xml:id="p1z22"/>dissimis moribus <placeName ref="l830">Anglorum</placeName>, dixeris unum <lb xml:id="p1z23"/>ex illis esse.</s>
					<s n="9" xml:lang="la">Vidi eum cotidie in auditorio <lb xml:id="p1z24"/><persName ref="p8111">Martyris</persName>; deus eum tibi servet.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Morosinum non vidi, quem tantopere optabam; <lb xml:id="p2z2"/>descendit <placeName ref="l569">Wormatiam</placeName>, quin et <placeName ref="l267">Co<lb xml:id="p2z3"/>loniam</placeName> quaesitum celebrem quendam me<lb xml:id="p2z4"/>dicum, qui curet genu filii.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z5"/>Tandem puto futura comitia; scio, quid <lb xml:id="p2z6"/>dicam.</s>
					<s n="12" xml:lang="la">Ferunt marchionem <placeName>Bran<lb xml:id="p2z7"/>deburgensem</placeName> esse Meti, <placeName>Brunsvicensem</placeName> <lb xml:id="p2z8"/>cum magna manu peditum atque equitum <lb xml:id="p2z9"/>ad <persName>Caesarem</persName> mox iturum.</s>
					<s n="13" xml:lang="la">Ita libe<lb xml:id="p2z10"/>rata esset <placeName ref="l822">Germania</placeName> bello.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale <lb xml:id="p2z11"/>et salve; ora pro me cum tota <lb xml:id="p2z12"/>familia, schola atque ecclesia.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z13"/><placeName ref="l491">Argentinae</placeName> 26. iulii 1554.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z14"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
