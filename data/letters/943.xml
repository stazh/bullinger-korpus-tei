	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Accepi postremas tuas 17. iunii, et mirum, quod nullam <lb xml:id="p1z2"/>facias mentionem de meis postremis, quas per mulierculas curavi ad te <lb xml:id="p1z3"/>perferendas.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Gratissimum autem fuit, quod, que tractaturus sis in Decadibus <lb xml:id="p1z4"/>tuis, tam fuse significaveris, neque utiliorem laborem potuisses ecclesiae turbatę <lb xml:id="p1z5"/>conferre, et prudenter etiam facis, quod articulos Interimistarum refellis <lb xml:id="p1z6"/>sine stomacho sicque piis ingentem consolationem offers in iis turbis, cum <lb xml:id="p1z7"/>nemo audeat<note type="margin">a.R.: audiat!</note> publice contra tam superbum et fastuosum librum scribere sine <lb xml:id="p1z8"/>periculo.</s>
					<s n="4" xml:lang="la">Quod si voles de statu Saxonicarum ecclesiarum certissima scire, hunc <lb xml:id="p1z9"/>tabellarium examinare poteris et mira quędam audies stupendaque.</s>
					<s n="5" xml:lang="la"><persName ref="p2301">Osiander</persName> <lb xml:id="p1z10"/>taxat nostras ecclesias in suis libellis, quos in <placeName ref="l2562">Prussia</placeName> edidit, quos tamen <lb xml:id="p1z11"/>nondum vidi, sed habebo brevi.</s>
					<s n="6" xml:lang="la">Dissident pastores in <placeName ref="l749">Saxonia</placeName> et certant <lb xml:id="p1z12"/>ad sanguinem usque de adiaphoris.</s>
					<s n="7" xml:lang="la">Dominus illorum misereatur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Nosti praeterea Psalterium <persName ref="p8417">Musculi</persName> commentariis illustratum sub prelo esse <lb xml:id="p1z14"/><persName ref="p8126">Oporinico</persName> et <persName>Nazianzeni</persName> opera Gręca et Latina, quę extant, <persName ref="p5213">Hervagius</persName> <lb xml:id="p1z15"/>conatur imprimere <persName ref="p17832">Bernhardi</persName> opera, si sciret exemplaria quędam manuscripta, <lb xml:id="p1z16"/>ut posset quędam conferre.</s>
					<s n="9" xml:lang="la">Si tu nosti aliqua, rogo, velis indicare in <lb xml:id="p1z17"/>gratiam studiosorum, neque dubito alibi latere aut <placeName ref="l473">Sangalli</placeName> aut in Eremo <lb xml:id="p1z18"/>d. Virginis vel alio in quodam loco.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/>Vestros exhibuisse spectaculum egregium de creatione mundi et aliis rebus <lb xml:id="p1z20"/>quis non laudaret cum ob materiam convenientem tum ob industriam, qua <lb xml:id="p1z21"/>vos <placeName ref="l587">Tigurini</placeName> uti soletis prę cęteris.</s>
					<s n="11" xml:lang="la">Nihil autem de nostro sentis?</s>
					<s n="12" xml:lang="la">Quod <lb xml:id="p1z22"/>cum ingenti magistratus sumptu fuit exhibitum.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale.</s>
					<s n="14" xml:lang="la">20. iunii 1550.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z23"/>Salutato nomine meo d. <persName ref="p8171">Theodorum</persName>, <persName ref="p8127">Pellicanum</persName>, <persName ref="p8011">Gvaltherum</persName> et <persName ref="p1214">Frisium</persName>.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z24"/>Scripsi nuper de mittendo ceracio<note type="margin">a.R.: seraceo...!</note> sed timeo, ne acceperis literas; s<lb xml:id="p1z25"/>i <lb xml:id="p1z26"/>commode poteris, <foreign xml:lang="de">so schicken mir ein guͦten <placeName ref="l646">Glarner</placeName> krut ziger, und was <lb xml:id="p1z27"/>ir darumb gegen,</foreign> hoc reddam bona fide.</s>
					<s n="17" xml:lang="la" ana="farewell">Vale iterum et aeternum.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z28"/>T[uus] <persName ref="p1278">Gastius</persName> ex animo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z29"/>D. <persName>Tragutum</persName> <placeName ref="l2556">Siciliae</placeName> imminere multis navigiis nosti.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z30"/>Gliscit bellum aut in <placeName ref="l875">Hispania</placeName> aut in <placeName ref="l834">Italia</placeName>.</s>
					<s n="21" xml:lang="la">D. <persName ref="p944">Maurus</persName>, <lb xml:id="p1z31"/><placeName ref="l832">Gallicus</placeName> legatus, ad nos heri venit telam orsurus novam.</s>
					<s n="22" xml:lang="la"><lb xml:id="p1z32"/><persName ref="p3375">Paulus Vergerius</persName> <placeName ref="l491">Argentoratum</placeName> petiit.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Insigni theologo et <lb xml:id="p2z2"/>pastori vigilantissimo <lb xml:id="p2z3"/>d. <persName ref="p495">Heinrycho <lb xml:id="p2z4"/>Bullingero</persName>, praeceptori suo <lb xml:id="p2z5"/>pepetuo laudando.</s>
				</p>
				<p>
					<s n="24" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
