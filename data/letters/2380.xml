	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Dedit tibi, dilecte fili, bonum testimonium <lb xml:id="p1z2"/>d. <persName ref="p505">Burcherus</persName> cum diligentiae <lb xml:id="p1z3"/>in literis tum frugalitatis in faciendis sumptibus.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Perge sic, mi fili, temetipsum superare <lb xml:id="p1z5"/>in illa tua diligentia et frugalitate; <lb xml:id="p1z6"/>ita enim et mihi et matri gratificaberis <lb xml:id="p1z7"/>plurimum et temetipsum ornabis.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Expecto adhuc schedam expensarum ad primam usq<lb xml:id="p1z9"/>ue septembris, ut inde coniiciam, quid <lb xml:id="p1z10"/>exposueris, quid tibi sit residuum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Ora pro fratre meo dominum, ut dignetur ill<lb xml:id="p1z12"/>i sanitatem conferre; nam maximis differtur <lb xml:id="p1z14"/>doloribus.</s>
					<s n="6" xml:lang="la">Magna tamen affulget nobis spes <lb xml:id="p1z15"/>fore, ut a m. <persName>Felice Wirzio</persName> curetur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">S<lb xml:id="p1z16"/>ingulariter ille te salvere iubet.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/><placeName ref="l648">Rheti</placeName> confoederati nostri caesi sunt in <placeName ref="l834">Italia</placeName>; <lb xml:id="p1z18"/>ceciderunt eorum duces ad unum omnes exceptis <lb xml:id="p1z19"/>duobus, qui pugnae non interfuerunt per morbum, <lb xml:id="p1z20"/>amiserunt signa omnia.</s>
					<s n="9" xml:lang="la">Caesi sunt plures <lb xml:id="p1z21"/>300, capti 450, sed mox a <persName>Müssio</persName> dimissi perbenign<lb xml:id="p1z22"/>e.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l822">Germani</placeName>, qui nomina <placeName ref="l832">Gallo</placeName> dederunt <lb xml:id="p1z23"/>e<lb xml:id="p1z24"/>t militarunt sub duce <persName>Reckenrat</persName>, bona pa<lb xml:id="p1z25"/>rte deleti sunt; <placeName ref="l834">Italicus</placeName> enim peditatus <lb xml:id="p1z26"/>et <placeName ref="l832">Gallicus</placeName> equitatus nullas <placeName ref="l648">Rhaetis</placeName> et <placeName ref="l822">Germanis</placeName> <lb xml:id="p1z27"/>tulere suppetias iustas, sed mox sibi <lb xml:id="p1z28"/>fuga consuluerunt.</s>
					<s n="11" xml:lang="la"><placeName ref="l832">Gallicum</placeName> equitatum intelligo, <lb xml:id="p1z29"/>qui in <placeName ref="l834">Italia</placeName> sub signa <placeName ref="l832">Galli</placeName> fuit collectus.</s>
					<s n="12" xml:lang="la">Alioqui <lb xml:id="p1z30"/>nihil dubito de <placeName ref="l832">Gallorum</placeName> virtute, si <lb xml:id="p1z31"/><placeName ref="l832">Galli</placeName> ipsi <placeName ref="l648">Rhetis</placeName> et <placeName ref="l822">Germanis</placeName> adfuissent, strenue <lb xml:id="p1z32"/>pugnassent cum ipsis haud dubie.</s>
					<s n="13" xml:lang="la">Orandus <lb xml:id="p1z33"/>est dominus, ut graves hos motus componat.</s>
					<s n="14" xml:lang="la">Obsidentur <lb xml:id="p1z34"/>modo <placeName ref="l462">Senae</placeName> a Caesare fortiter defendentibus has <lb xml:id="p1z35"/>civibus et <placeName ref="l832">Gallis</placeName>.</s>
					<s n="15" xml:lang="la">Novum conscribit exercitum <lb xml:id="p1z36"/><persName ref="p6724">Strozius</persName>, primas in <placeName ref="l834">Italia</placeName> <placeName ref="l832">Gallisantium</placeName>.</s>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z37"/>Salutat te mater, salutant te sorores et <lb xml:id="p1z38"/>nostri omnes.</s>
					<s n="17" xml:lang="la"><persName>Ioannes Esslingerus</persName>, nobilis chirurgus, <lb xml:id="p1z39"/>hac nocte praepropera morte extinctus migravit <lb xml:id="p1z40"/>religiose ad dominum; nam morienti <lb xml:id="p1z41"/>astiti.</s>
					<s n="18" xml:lang="la" ana="farewell">Vale.</s>
					<s n="19" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 1. septembris 1554.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z42"/><persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Dilecto meo filio <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l491">Argentinae</placeName> in aedibus d. <persName ref="p505">Ioannis <lb xml:id="p2z4"/>Burcheri</persName> <placeName ref="l830">Angli</placeName> agenti.</s>
				</p>
				<p>
					<s n="22" xml:lang="de"><lb xml:id="p2z5"/><persName ref="p495">Heinric<lb xml:id="p2z6"/>hen <lb xml:id="p2z7"/>Bullingern</persName> zuͦ <placeName ref="l491">Straßburg</placeName>.</s>
				</p>
			</div>
		</body>
