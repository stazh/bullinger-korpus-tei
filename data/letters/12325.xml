	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Equidem verba sum intuitus et inde mentem coniectavi<note xml:id="fn1" type="footnote" n="1"><persName ref="p8418">Myconius</persName> antwortet damit auf <persName ref="p495">Bullingers</persName> Vorwurf in oben <ref target="file12318">Nr. 2271</ref>, 3f.</note>!</s>
					<s n="3" xml:lang="la">Aliter profecto non licuit<lb xml:id="p1z2"/>.</s>
					<s n="4" xml:lang="la">Nemo mecum excepto <persName ref="p18067">Heldo</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p18067">Jakob Held von Tiefenau</persName>.</note> pro <persName ref="p8441">Schwencfeldio</persName> quicquam<note xml:id="fn3" type="footnote" n="3">Bezug auf <ref target="file12309">Nr. 2262</ref>, 27f, wo <persName ref="p495">Bullinger</persName> <persName ref="p8418">Myconius</persName> aufforderte, die Seinen vor <persName ref="p8441">Schwenckfeld</persName> zu bewahren. - Siehe auch oben <ref target="file12302">Nr. 2255</ref>, 5.</note>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Contra eundem <lb xml:id="p1z3"/>multi loquuntur.</s>
					<s n="6" xml:lang="la">Si igitur animus tibi fuit, qualem nunc indicas,<note xml:id="fn4" type="footnote" n="4">Im Brief <ref target="file12318">Nr. 2271</ref>.</note> significasses <lb xml:id="p1z4"/>schedula adposita, et ego omnia interpretatus essem, ut nunc, dexterrime.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z5"/>Summa: Convenit de non contaminanda <placeName ref="l862">Helvetia</placeName> per praesentiam <persName ref="p8441">Schwencfeldii</persName>, minus etiam <lb xml:id="p1z6"/>per dogma eius.</s>
					<s n="8" xml:lang="la">Reliqua, in quibus paulo contumeliosior videris, condono <lb xml:id="p1z7"/>amiciciae nostrę.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z8"/>De <persName ref="p3590">Hesso</persName><note xml:id="fn5" type="footnote" n="5">Landgraf <persName ref="p3590">Philipp von Hessen</persName>.</note> et eius victoria, de capto <persName ref="p20318">Brunswicensi</persName><note xml:id="fn6" type="footnote" n="6">Herzog <persName ref="p20318">Heinrich d.J. von Braunschweig-Wolfenbüttel</persName>.</note> et filio<note xml:id="fn7" type="footnote" n="7">Karl Victor.</note> eiusdem si n<lb xml:id="p1z9"/>escis, legito, quę his sunt inclusa; <persName ref="p1278">Gastii</persName> scheda<note xml:id="fn8" type="footnote" n="8">Es handelt sich dabei um das bereits von <persName ref="p1278">Gast</persName> angeführte Dokument oben <ref target="file12324">Nr. 2277</ref>, 5 und Anm. 5.</note> est.</s>
					<s n="10" xml:lang="la">Illa autem, quae se<lb xml:id="p1z10"/>quuntur, ea non continet, et profecto sunt admiranda: <persName ref="p7523">Episcopi Trevirensis</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p7523">Johannes IV. Ludwig von Hagen</persName>, Erzbischof und Kurfürst von <placeName ref="l1028">Trier</placeName>.</note> <lb xml:id="p1z11"/>et <persName ref="p7882">Würtzburgensis</persName><note xml:id="fn10" type="footnote" n="10"><persName ref="p7882">Melchior Zobel</persName>, von 1544 bis 1558 Bischof von <placeName ref="l1030">Würzburg</placeName>.</note>, praeterea canonici <placeName ref="l307">Maguntinenses</placeName>, quorum <persName ref="p20531">episcopus</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p20531">Albrecht V. von Brandenburg</persName>, Erzbischof und Kurfürst von <placeName ref="l307">Mainz</placeName>.</note> paucis <lb xml:id="p1z12"/>hinc diebus migravit,<note xml:id="fn12" type="footnote" n="12">Am 24. September; s. oben <ref target="file12315">Nr. 2268</ref>, 10f.</note> auxilia miserunt <persName ref="p3590">Catto</persName><note xml:id="fn13" type="footnote" n="13">Landgraf <persName ref="p3590">Philipp von Hessen</persName>.</note>.</s>
					<s n="11" xml:lang="la"><persName ref="p8462">Coloniensis</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p8462">Hermann von Wied</persName>, Erzbischof und Kurfürst von <placeName ref="l267">Köln</placeName>.</note> nulla misit!</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z13"/>Fortasse, quod domi satis abunde habet, quod agat.<pb type="edition" next="618"/></s>
				</p>
				<p>
					<s n="13" xml:lang="la"><persName ref="p18538">Cęsar</persName><note xml:id="fn15" type="footnote" n="15"><persName ref="p18538">Karl V.</persName></note> vi conatus <lb xml:id="p1z14"/>est intrudere<note xml:id="fn16" type="footnote" n="16">aufdringen; s. <hi>Horen 295.</hi></note> in ditionem <placeName ref="l307">Maguntinam</placeName> filium <persName ref="p18477">Ferdinandi</persName>,<note xml:id="fn17" type="footnote" ana="bio" n="17">Wohl ein Gerücht. Vielmehr unterstützte <persName ref="p18538">Karl</persName> den Kardinal <persName ref="p7840">Otto Truchsess von Waldburg</persName> (s. Friedrich <hi>Zoepfl,</hi> Geschichte des Bistums Augsburg und seiner Bischöfe, Bd. 2: Das Bistum Augsburg und seine Bischöfe im Reformationsjahrhundert, München und Augsburg 1969, S. 205). Doch äußerte er dann Zufriedenheit mit der Wahl <persName ref="p7548">Heusenstamms</persName>, den er als guten, gelehrten Katholiken ansah (s. <bibl source="b456">NBD</bibl> VIII 376, 16-18).</note> sed canonici <lb xml:id="p1z15"/>praevenerunt.</s>
					<s n="14" xml:lang="la">Elegerunt enim nobilem quendam<note xml:id="fn18" type="footnote" n="18"><persName ref="p7548">Sebastian von Heusenstamm</persName>.</note> notę vilioris<note xml:id="fn19" type="footnote" n="19">note vilioris: von weniger bedeutendem Namen. -Zu dieser Junktur s. <hi>Columella,</hi> De re rustica, 9, 4.</note>, et eundem do<lb xml:id="p1z16"/>ctorem hominem vafrum et mirabiliter hypocritam, ut ferunt, atque ita iam <lb xml:id="p1z17"/>desistendum cęsari.</s>
					<s n="15" xml:lang="la">Letaliter aiunt decumbere <placeName ref="l1028">Trevirensem</placeName>,<note xml:id="fn20" type="footnote" n="20">Siehe dazu oben <ref target="file12324">Nr. 2277</ref>, 10f und Anm. 13.</note> et certo <lb xml:id="p1z18"/>fertur <persName ref="p18477">Ferdinandus</persName> se <persName ref="p18593">Turcae</persName><note xml:id="fn21" type="footnote" n="21">Sultan <persName ref="p18593">Suleiman I.</persName></note> fecisse tributarium,<note xml:id="fn22" type="footnote" n="22">Siehe dazu oben <ref target="file12214">Nr. 2167</ref>. Laut dem Friedensvertrag durfte <persName ref="p18593">Suleiman I.</persName> bei den gewonnenen Ländern bleiben; <persName ref="p18477">Ferdinand</persName> musste ihm jährlich 2100 Dukaten Tribut zahlen; s. <bibl source="b41">Vadian BW VI</bibl> 419.</note> non ob aliud, nisi <lb xml:id="p1z19"/>ut nos perdant.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z20"/>A <placeName ref="l907">Campidonensibus</placeName> bombardę, quas haggen<note xml:id="fn23" type="footnote" ana="lex" n="23">Hakenbüchsen.</note> vocant, detentę dicuntur <lb xml:id="p1z21"/>ad numerum 20000.</s>
					<s n="17" xml:lang="la">Tributę sunt <persName ref="p18477">Ferdinando</persName>.</s>
					<s n="18" xml:lang="la">Verum re comperta ad <lb xml:id="p1z22"/><placeName ref="l1041">Brunsvicensem</placeName> ducebantur ex <placeName ref="l834">Italia</placeName><note xml:id="fn24" type="footnote" n="24">Siehe zuletzt oben <ref target="file12324">Nr. 2277</ref>, 12 und Anm. 16.</note>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z23"/>Protestantes, sollicitati magis ab <persName ref="p8375">Anglo</persName><note xml:id="fn25" type="footnote" n="25">König <persName ref="p8375">Heinrich VIII.</persName></note> quam <persName ref="p20225">Gallo</persName><note xml:id="fn26" type="footnote" n="26">König <persName ref="p20225">Franz I.</persName></note>, ut bellum componere <lb xml:id="p1z24"/>inter ipsos tentarent, miserunt legatos<note xml:id="fn27" type="footnote" n="27">Die <placeName ref="l1202">Schmalkaldener</placeName> sandten <persName ref="p7394">Ludwig von Baumbach</persName> und <persName ref="p6096">Johannes Sleidanus</persName> nach <placeName ref="l830">England</placeName> sowie <persName ref="p7698">Johann Bruno von Niedbruck (alias Dr. Bruno von Metz, Hans von Metz, Johann von Niedbruck, Jean Bruno de Pont-de-Nied)</persName> und <persName ref="p7833">Christopher von Venningen</persName> nach <placeName ref="l832">Frankreich</placeName>. <persName ref="p7394">Baumbach</persName> und <persName ref="p6096">Sleidanus</persName> waren am 19. September 1545 am Hof zu <placeName ref="l554">Windsor</placeName> angekommen, bevor sich die Verhandlungen nach <placeName ref="l832">Frankreich</placeName> verlagerten, und reisten im Oktober nach <placeName ref="l832">Frankreich</placeName>, wo sie mit <persName ref="p7698">Niedbruck</persName> und <persName ref="p7833">Venningen</persName> zusammentrafen. Im November kamen die <placeName ref="l830">englischen</placeName> Repräsentanten <persName ref="p6026">William Paget</persName> und <persName ref="p6858">Cuthbert Tunstall</persName> hinzu. Die Friedensverhandlungen begannen am 26. November 1545. Siehe Rory <hi>McEntegart,</hi> Henry VIII, the League of Schmalkaden and the English Reformation, Woodbridge 2000, S. 209f; Alexandra <hi>Kess,</hi> Johann Sleidan and the Protestant Vision of History, Aldershot 2008, S. 54f; <hi>Potter,</hi> 410-426; oben <ref target="file12274">Nr. 2227</ref>, Anm. 48.</note>.</s>
					<s n="20" xml:lang="la">Admissi sunt satis commode, <lb xml:id="p1z25"/>et <persName ref="p20225">Gallus</persName> visus ab ęquis conditionibus non abhorrere.</s>
					<s n="21" xml:lang="la"><persName ref="p18538">Imperator</persName> <lb xml:id="p1z26"/>tamen vias invenit, ut <persName ref="p8375">Anglus</persName>, iam turpiter ab eo deceptus,<note xml:id="fn28" type="footnote" n="28">Mit "eo" ist Kaiser <persName ref="p18538">Karl V.</persName> gemeint, der zu König <persName ref="p8375">Heinrichs</persName> Enttäuschung im Jahr 1544 nur mit König <persName ref="p20225">Franz I.</persName> den Frieden von <placeName ref="l2110">Crépy</placeName> geschlossen hatte.</note> ipsum<note xml:id="fn29" type="footnote" n="29">Gemeint sind <persName ref="p18538">Karl V.</persName> bzw. dessen Vertreter bei den Vermittlungsbemühungen.</note> <lb xml:id="p1z27"/>prę protestantibus ad actionem admiserit<note xml:id="fn30" type="footnote" n="30">Zur Rolle <persName ref="p18538">Karls V.</persName> bei der Vermittlung im <placeName ref="l830">englisch</placeName>-<placeName ref="l832">französischen</placeName> Krieg s. <hi>Potter,</hi> 402-409.</note>.</s>
					<s n="22" xml:lang="la">Quid futurum sit, expectamus.<pb type="edition" next="619"/></s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z28"/>De comitiis <placeName ref="l862">Helvetiorum</placeName> quae scribis,<note xml:id="fn31" type="footnote" n="31"><persName ref="p495">Bullingers</persName> Mitteilungen über den Tag zu <placeName ref="l21">Baden</placeName>; s. oben <ref target="file12318">Nr. 2271</ref>, 26-35.</note> satis placent.</s>
					<s n="24" xml:lang="la">Legati<note xml:id="fn32" type="footnote" n="32">Die nach <placeName ref="l306">Mailand</placeName> abgeordneten Gesandten aus <placeName ref="l587">Zürich</placeName>, <placeName ref="l300">Luzern</placeName>, <placeName ref="l781">Uri</placeName> und <placeName ref="l2450">Schwyz</placeName>; s. oben <ref target="file12318">Nr. 2271</ref>, 26-30.</note>, postquam <lb xml:id="p1z29"/>venerint <placeName ref="l306">Mediolanum</placeName>, comperient, verumne sit necne<note xml:id="fn33" type="footnote" n="33">verumne sit necne: Damit bezieht <persName ref="p8418">Myconius</persName> sich auf die von <persName ref="p495">Bullinger</persName> angedeuteten Rüstungen in <placeName ref="l834">Italien</placeName>; s. oben <ref target="file12318">Nr. 2271</ref>. 29f und Anm. 12.</note>.</s>
					<s n="25" xml:lang="la">Volat <lb xml:id="p1z30"/>enim rumor expectari illic decem millia <placeName ref="l875">Hispanorum</placeName>, quę pertineant <lb xml:id="p1z31"/>ad <persName ref="p18538">cęsarem</persName><note xml:id="fn34" type="footnote" n="34">Dieselbe Nachricht findet sich im Brief der <placeName ref="l2728">Dreizehn</placeName> von <placeName ref="l28">Basel</placeName> an die von <placeName ref="l491">Straßburg</placeName>, 29. Oktober 1545 (<bibl source="b480">PC</bibl> III 665, Nr. 627). Im Brief des Rates von <placeName ref="l257">Konstanz</placeName> an <placeName ref="l587">Zürich</placeName> vom 20. Oktober 1545 (Zürich StA, A 205/1, <ref target="file10229">Nr. 198</ref>) wird berichtet, dass ca. 4000 Mann von <placeName ref="l1671">Pisa</placeName>, <placeName ref="l1098">Florenz</placeName> und <placeName ref="l1862">Lucca</placeName> auf dem Weg nach <placeName ref="l306">Mailand</placeName> waren.</note>.</s>
					<s n="26" xml:lang="la">Confirmat rumor, quantum in ipso, quę tu prius<note xml:id="fn35" type="footnote" n="35">In dem nicht erhaltenen Brief <persName ref="p495">Bullingers</persName> an <persName ref="p8418">Myconius</persName> von September 1545; s. oben <ref target="file12299">Nr. 2252</ref>, 26-30 und Anm. 24.</note> <lb xml:id="p1z32"/>ad me de <persName ref="p7251">marchione</persName> illo<note xml:id="fn36" type="footnote" n="36"><persName ref="p7251">Alfonso d'Avalos</persName>, Marchese del <placeName ref="l3273">Vasto (Guasto)</placeName>.</note>.</s>
					<s n="27" xml:lang="la" ana="farewell">Vale una cum tuis et <persName ref="p8171">Theodoro</persName><note xml:id="fn37" type="footnote" n="37"><persName ref="p8171">Theodor Bibliander</persName>.</note>.</s>
					<s n="28" xml:lang="la">Equidem <lb xml:id="p1z33"/>plura non potui, nam hęc mox a prandio.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><placeName ref="l28">Basileae</placeName>, 2. novembris <lb xml:id="p1z34"/>anno 1545.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><lb xml:id="p1z35"/><persName ref="p8418">Os. Myco.</persName> tuus.</s>
				</p>
				<p>
					<s n="31" xml:lang="la">Rapuit tant<lb xml:id="p1z36"/>um non <lb xml:id="p1z37"/>has tabellio<note xml:id="fn38" type="footnote" n="38">Unbekannt.</note> e manibus <lb xml:id="p1z38"/>s<lb xml:id="p1z39"/>cribentis.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="32" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesię <lb xml:id="p2z4"/>episcopo, domino et fratri colend<lb xml:id="p2z5"/>issimo suo<note xml:id="fn39" type="footnote" n="39">Dieser Brief wurde zusammen mit <persName ref="p1278">Gasts</persName> Brief (<ref target="file12324">Nr. 2277</ref>) befördert; s. <bibl source="b700">Z</bibl>. 9 und Anm. 8.</note>.</s>
				</p>
			</div>
