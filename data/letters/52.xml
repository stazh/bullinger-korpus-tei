	<text>
		<note xml:id="fna" type="footnote" subtype="metadata" corresp="signature" n="a"><hi rend="italic">Ohne Schnitt- oder Nadelstichspuren.</hi></note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.P. <ptr target="zl18042-6A" type="zzl"/>Binas<note xml:id="fn1" type="footnote" n="1"><ref target="18033">18033</ref> und <ref target="18037">18037</ref>. - Beide Briefe sind mit Adresse und Siegel versehen. Wahrscheinlich waren sie zu einem Briefbündel zusammengefasst.</note> tuas colligatas recepi.<ptr target="zl18042-6E" type="zzl"/></s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Merito times de <placeName ref="l832">Gallo</placeName><note xml:id="fn2" type="footnote" n="2"><persName ref="p8112">Heinrich II.</persName><note type="entity">Heinrich II. von <placeName ref="l832">Frankreich</placeName></note>, der die Erhaltung jenes Soldbündnisses<note type="entity">Schweiz, Soldbündnis (1521)</note> verfolgte, das sein Vater Franz I.<note type="entity">Franz I.</note> mit den Eidgenossen<note type="entity">Schweiz</note> abgeschlossen hatte. - Bullinger<note type="entity">Schweiz, Debatte über ein Bündnis mit <placeName ref="l832">Frankreich</placeName></note> war im Gegensatz zu <persName ref="p8418">Myconius</persName> gegen ein solches Bündnis. Letzterer befürchtete jedoch, dass sich <persName ref="p8112">Heinrich II.</persName>, sollten die Eidgenossen<note type="entity">Schweiz</note> einen Vertrag mit ihm ablehnen<note type="entity">Schweiz, Debatte über ein Bündnis mit <placeName ref="l832">Frankreich</placeName></note>, mit <persName ref="p18538">Karl V.</persName> verbünden könnte; s. <ref target="18027">18027</ref>, <ref target="fn18027-1" type="fn">fn18027-1</ref>; <ref target="18037">18037</ref>,<ref source="zl18037-1A" target="zl18037-1E" type="zl">18037</ref>.</note>.</s>
					<s n="3" xml:lang="la">Nollem nos <lb xml:id="p1z3"/>ei coniunctos.</s>
					<s n="4" xml:lang="la">Certum enim est illum cru<lb xml:id="p1z4"/>delissime persequi evangelium.<note xml:id="fn3" type="footnote" n="3">Zur Verfolgung und Verbrennung von Evangelischen in <placeName ref="l378">Paris</placeName> s. unten Z. <ref source="zl18042-1A" target="zl18042-1E" type="zl">18042</ref> sowie <ref target="18338">18338</ref>,<ref source="zl18338-5A" target="zl18338-5E" type="zl">18338</ref> und <ref target="18342">18342</ref>,<ref source="zl18342-1A" target="zl18342-1E" type="zl">18342</ref>.</note></s>
					<s n="5" xml:lang="la">Odiunt <lb xml:id="p1z5"/>multi caesarem<note type="entity"><persName ref="p18538">Karl V</persName>.</note> velut sanguinarium, <lb xml:id="p1z6"/><placeName ref="l832">Gallo</placeName><note type="entity">Heinrich II. von <placeName ref="l832">Frankreich</placeName></note> aequiores sunt utpote clementiori.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z7"/>Sed utrumque video esse hostem Christi, <lb xml:id="p1z8"/>utrumque nobis ex aequo fugiendum, <lb xml:id="p1z9"/>nisi tandem et cum ipsis in hoc et <lb xml:id="p1z10"/>in futuro seculo perire liceat.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="7" xml:lang="la"><ptr target="zl18042-1A" type="zzl"/>Circa <lb xml:id="p1z11"/>principium februarii lento igni <lb xml:id="p1z12"/>tostus est <placeName ref="l378">Parisiis</placeName> <persName ref="p4757">Octavianus</persName><note type="entity">Blondel, Octavien</note><note xml:id="fn4" type="footnote" n="4">Zur Hinrichtung des evangelisch gesinnten Octavien Blondel am 4. Februar 1548 in <placeName ref="l378">Paris</placeName> und den erfolglosen Einsatz des Zürcher<note type="entity">Zurich</note>, St. Galler<note type="entity">Sankt Gallen, Burgermeister</note> und <placeName ref="l41">Berner</placeName> Rates<note type="entity"><placeName ref="l41">Bern</placeName>, Schultheiss bzw Rat</note> s. <ref target="18038">18038</ref>,<ref source="zl18038-1A" target="zl18038-1E" type="zl">18038</ref> mit <ref target="fn18038-2" type="fn">fn18038-2</ref>.</note> quidam, <lb xml:id="p1z13"/>nobilis <placeName ref="l832">Gallus</placeName>, <placeName ref="l301">Lugduni</placeName> apud mercatores <lb xml:id="p1z14"/><placeName ref="l473">Sangallenses</placeName><note type="entity">N.N., Kaufleute aus <placeName ref="l473">St. Gallen</placeName></note> captus in publico <lb xml:id="p1z15"/>diversorio.</s>
					<s n="8" xml:lang="la">Mercatores curarunt, <lb xml:id="p1z16"/>ut <placeName ref="l587">Tigurinus</placeName><note type="entity">Zurich</note>, <placeName ref="l41">Bernensis</placeName> et <placeName ref="l473">Sangallensis</placeName><note type="entity">Sankt Gallen, Burgermeister</note> <lb xml:id="p1z17"/>senatus scripserit pro capto.</s>
					<s n="9" xml:lang="la">Sive vero <lb xml:id="p1z18"/>suppressae sint literae, sin minus, <persName ref="p8049">Vadianus</persName> <lb xml:id="p1z19"/>scribit bonum virum esse exustum!<note xml:id="fn5" type="footnote" n="5">Vgl. hierzu <ref target="18038">18038</ref>,<ref source="zl18038-5A" target="zl18038-5E" type="zl">18038</ref>.</note></s>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/>Haec scilicet spectacula exhibentur, etc.<ptr target="zl18042-1E" type="zzl"/></s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="11" xml:lang="la"><ptr target="zl18042-7A" type="zzl"/><placeName ref="l257">Con<lb xml:id="p1z21"/>stantia</placeName> constanter sperat se clementer<ptr target="zl18042-4A" type="zzl"/> <lb xml:id="p1z22"/>a caesore<note type="entity"><persName ref="p18538">Karl V</persName>.</note><note xml:id="fn6" type="footnote" n="6">Totschläger. - Gemeint ist <persName ref="p18538">Karl V</persName>. - Das Wortspiel caesar-caesor, das im Briefwechsel von Bullinger und <persName ref="p8418">Myconius</persName> des Öfteren verwendet wird, findet sich zuletzt in <ref target="18037">18037</ref>,<ref source="zl18037-3A" target="zl18037-3E" type="zl">18037</ref>.<ptr target="fn18042-1" type="zfn"/></note><ptr target="zl18042-4E" type="zzl"/> recipiendam<note type="entity"><placeName ref="l257">Konstanz</placeName>, Versöhnungsgesuch</note>.<note xml:id="fn7" type="footnote" n="7">Zum <placeName ref="l257">Konstanzer</placeName> Versöhnungsantrag an den Kaiser s. zuletzt <ref target="18039">18039</ref>,<ref source="zl18039-5A" target="zl18039-5E" type="zl">18039</ref>.</note></s>
					<s n="12" xml:lang="la">Utinam bene ce<lb xml:id="p1z23"/>dat illis negotium, et melius, quam ego <lb xml:id="p1z24"/>putem, cessurum.<ptr target="zl18042-7E" type="zzl"/></s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="13" xml:lang="la"><ptr target="zl18042-2A" type="zzl"/>Putatur filius<note type="entity">Philipp II. von <placeName ref="l875">Spanien</placeName></note><note xml:id="fn8" type="footnote" n="8">Philipp II. von <placeName ref="l875">Spanien</placeName> sollte erst im Oktober 1548 (zum ersten Mal in seinem Leben) <placeName ref="l875">Spanien</placeName> verlassen, um durch die Territorien seines Vaters zu reisen; s. <ref target="18012">18012</ref>, <ref target="fn18012-4" type="fn">fn18012-4</ref>.</note> caesoris<note type="entity"><persName ref="p18538">Karl V</persName>.</note> <lb xml:id="p1z25"/>naves <lb xml:id="p1z26"/>appulisse <placeName ref="l1121">Genuam</placeName>.</s>
					<s n="14" xml:lang="la">Adeo non <lb xml:id="p1z28"/>excipietur aut intercipietur ab navibus <lb xml:id="p1z29"/>paratis.</s>
					<s n="15" xml:lang="la">Creabitur, ut fama est, <lb xml:id="p1z30"/>rex Romanorum.<note xml:id="fn9" type="footnote" n="9">Besonders in Augsburg verbreiteten sich Gerüchte um die Bestrebung Karls V.<note type="entity"><persName ref="p18538">Karl V</persName>.</note>, seinen Sohn<note type="entity">Philipp II. von <placeName ref="l875">Spanien</placeName></note> zu Ungunsten seines Bruders <persName ref="p18477">Ferdinand I.</persName><note type="entity">Ferdinand I.</note> zum Römischen König und später zu seinem Nachfolger als Kaiser wählen zu lassen; s. <ref target="18039">18039</ref>, <ref target="fn18039-4" type="fn">fn18039-4</ref>.</note></s>
					<s n="16" xml:lang="la">Hispani<note type="entity"><placeName ref="l875">Spanien</placeName></note> dominari <lb xml:id="p1z31"/>volunt.</s>
					<s n="17" xml:lang="la"><placeName ref="l822">Germani</placeName> libenter recipiunt.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z32"/>Fruantur ergo sua obedientia.<ptr target="zl18042-2E" type="zzl"/></s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="19" xml:lang="la"><ptr target="zl18042-5A" type="zzl"/><persName ref="p3590">Hessum</persName><note type="entity">Philipp I. der Grossmütige, Gefangenschaft</note><note xml:id="fn10" type="footnote" n="10"><persName ref="p3590">Philipp von Hessen</persName> und <persName ref="p19065">Johann Friedrich I. von Sachsen</persName><note type="entity">Johann Friedrich I. der Grossmuetige, Gefangenschaft</note> befanden sich seit ihrer Niederlage im schmalkaldischen Krieg<note type="entity"><placeName ref="l822">Deutschland</placeName>, Schmalkaldischer Krieg (1546-1547)</note> in Gefangenschaft. Der Landgraf wurde zu dieser Zeit in Nördlingen<note type="entity">Nordlingen</note>, der Herzog in Augsburg<note type="entity">Augsburg</note> festgehalten. Beide sollten erst 1552 aus der kaiserlichen Haft entlassen werden; s. <bibl source="b23">HBBW XX</bibl>, <ref target="file12966">Nr. 2917</ref>, Anm. 12; Nr. 2948, Anm. 9; <ref target="18000">18000</ref>, <ref target="fn18000-3" type="fn">fn18000-3</ref> und <ref target="fn18000-6" type="fn">fn18000-6</ref>.</note> <lb xml:id="p1z33"/>et <persName ref="p19065">Saxonem</persName><note type="entity">Johann Friedrich I. der Grossmuetige, Gefangenschaft</note> putant <lb xml:id="p1z34"/>mox a caesare di<lb xml:id="p1z35"/>mittendos.<ptr target="zl18042-5E" type="zzl"/></s>
				</p>
			</div>
			<div xml:id="div7" corresp="regest7">
				<p>
					<s n="20" xml:lang="la"><persName ref="p18538">Caesar</persName> iussit a <placeName ref="l157">Franc<lb xml:id="p1z36"/>fordia</placeName><note type="entity">Frankfurta M</note> per <placeName ref="l2459">Rhenum</placeName><note type="entity">Rhein</note> tormenta deportari in <lb xml:id="p1z37"/>Inferiorem <placeName ref="l822">Germaniam</placeName><note type="entity"><placeName ref="l20">Niederlande</placeName></note>.</s>
					<s n="21" xml:lang="la"><ptr target="zl18042-3A" type="zzl"/>Imminet<note xml:id="fnb" type="footnote" n="b"><hi rend="italic">In der Vorlage</hi> Iminet.</note> for<lb xml:id="p1z38"/>te <lb xml:id="p1z39"/><persName ref="p3671">Dano</persName><note type="entity">Christian III., Koenig</note><note xml:id="fn11" type="footnote" n="11"><persName ref="p3671">Christian III.</persName> von Dänemark. - Zu den angeblichen Plänen Karls V.<note type="entity"><persName ref="p18538">Karl V.</persName></note>, seinen Schwager <persName ref="p18448">Christian II.</persName><note type="entity">Christian II., Koenig</note> wieder als König von Dänemark einzusetzen, s. <ref target="18032">18032</ref>,<ref source="zl18032-14A" target="zl18032-14E" type="zl">18032</ref> mit <ref target="fn18032-10" type="fn">fn18032-10</ref>.<ptr target="fn18042-2" type="zfn"/></note>.<ptr target="zl18042-3E" type="zzl"/></s>
				</p>
			</div>
			<div xml:id="div8" corresp="regest8">
				<p>
					<s n="22" xml:lang="la" ana="farewell"><lb xml:id="p1z40"/>Vale.</s>
					<s n="23" xml:lang="la">Plura non poss<lb xml:id="p1z41"/>um. 25. <lb xml:id="p1z42"/>februarii, <lb xml:id="p1z43"/><placeName ref="l587">Tiguri</placeName>, 1548<lb xml:id="p1z44"/>.</s>
				</p>
				<p>
					<note type="signature">[Unterschrift:]</note>
					<s n="24" xml:lang="la"><lb xml:id="p1z45"/>Bullinger.</s>
				</p>
				<p>
					<note type="address">Adresse auf der Rückseite:</note>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z2"/>D. <persName ref="p8418">Osvaldo Myconio</persName>, <lb xml:id="p2z3"/>fratri charissimo <lb xml:id="p2z4"/>suo.</s>
					<s n="26" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
