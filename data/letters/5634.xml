	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Ago tibi gratias quas possum maximas, reverende vir <lb xml:id="p1z2"/>et domine colendissime fraterque charissime, pro illi felicissimo <lb xml:id="p1z3"/>evangelio.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Multa enim in unis literis coniunxisti leta de liberata <lb xml:id="p1z4"/>obsidione (quae propter exemplum <placeName ref="l2771">Rothomagi</placeName> mirum in modum nos torsit) <placeName ref="l367">Aurelia</placeName> per reditum inopinatum <lb xml:id="p1z5"/><persName>Admiraldi</persName>, de iuvene rege <placeName>Navarrae</placeName> et de ipsa regina <lb xml:id="p1z6"/>matre.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Dominum oramus ut hos confirmet, et <placeName ref="l367">Au<lb xml:id="p1z7"/>reliam</placeName>, si nondum est liberata, mature liberet <lb xml:id="p1z8"/>pacemque concedat stabilem.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Si lupus ille in hoc <lb xml:id="p1z9"/>Christi stabulum irrumperet, quantis nos, deus bone, <lb xml:id="p1z10"/>malis afficeret.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Redierunt ex castris <placeName>Guysianis</placeName> <lb xml:id="p1z11"/>aliquot milites, et inter hos dux unus et alter.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Petunt ab illis pagis, vel pagis et duobus oppidis, <lb xml:id="p1z13"/>militem recentem, illi vocant supplementum <lb xml:id="p1z14"/>vexillorum in <placeName ref="l832">Gallia</placeName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Audimus illos mentiri pro<lb xml:id="p1z15"/>digiose, ac inter alia in pugna forte 300 esse d<lb xml:id="p1z16"/>esideratos, alios peste extinctos.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Unde iam petunt <lb xml:id="p1z17"/>sibi concedi 1500 vel 2000.</s>
					<s n="10" xml:lang="la">Et quidem arbitrantur <lb xml:id="p1z18"/>alii 14 signa nova submittenda, ne si pauculi illi <lb xml:id="p1z19"/>mittantur intercipiantur in itinere.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Sciunt enim novum <lb xml:id="p1z20"/>militem vel equitatum <placeName ref="l822">Germanicum</placeName> recentem <lb xml:id="p1z21"/><placeName ref="l301">Lugdunum</placeName> venturum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Sunt alii qui nullum mittendum <lb xml:id="p1z22"/>suadent.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Omnes tamen quotquot audivi mittenda <lb xml:id="p1z23"/>saltem 2000 existimant.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Quod si <persName>Admiraldus</persName> <lb xml:id="p1z24"/>obsidione <placeName ref="l367">Aureliam</placeName> solvit, frustra de supplemento <lb xml:id="p1z25"/>mittendo consultant.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Si rediit ex <placeName ref="l2770">Normandia</placeName>, facile <lb xml:id="p1z26"/>prohibebit ne exercitus possint coniungere.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Te <lb xml:id="p1z27"/>valde rogo ut, si quid certi acceperis de <placeName ref="l367">Aurelia</placeName> <lb xml:id="p1z28"/>et copiis <persName>Admiraldi</persName> ac <placeName ref="l830">Anglorum</placeName>, per <persName ref="p8078">Ionvilleum</persName> scribi <lb xml:id="p1z29"/>ad nos cures.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><persName ref="p8033">Bezae</persName> in <placeName ref="l830">Angliam</placeName> traiecturo <lb xml:id="p1z30"/>benedictionem a domino precamur, oramusque ut, si quando <lb xml:id="p1z31"/>ad ipsum scripseris, ipsum nostro nomine salutes hu<lb xml:id="p1z32"/>manissime.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Mitto hic Historiam sacramentariam <lb xml:id="p1z33"/>a genero meo <persName ref="p1884">Lavatero</persName> consignatam, et Orationem <lb xml:id="p1z34"/>alterius mei generi <persName ref="p8442">Iosiae Simleri</persName> in obitum <persName ref="p8111">Martyris</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z35"/>Alterum tibi servabis, alterum (quod volueris) <persName ref="p8078">Ion<lb xml:id="p1z36"/>villeo</persName> nostro dabis, una cum 10 illis batzonibus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Ago illi <lb xml:id="p1z37"/>maximas gratias et meum ei vicissim offero obsequium.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z38"/>Quam primum excusa fuerit responsio mea data <persName ref="p458">Brentio</persName> <lb xml:id="p1z39"/>et responsio Iosiae data <persName ref="p3018">Stancaro</persName>, per primum quemque nuncium <lb xml:id="p1z40"/>ad vos mittam.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Germanica mea iam excusa est etc.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ex <placeName ref="l834">Italia</placeName> alii scribunt, <placeName ref="l691">Lotharingium</placeName> a principibus <lb xml:id="p2z2"/><placeName ref="l834">Italiae</placeName> petiisse auxilia contra Hugonothos.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p2z3"/>Alii aiunt promissam illi esse certam pecuniam.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p2z4"/>Alii negant, quod metuant <placeName ref="l2510">Turcicam</placeName> classem.</s>
					<s n="26" xml:lang="la"><lb xml:id="p2z5"/>Alii scribunt ictum foedus <placeName>Brusillae</placeName> non <lb xml:id="p2z6"/>procul a <placeName ref="l55">Bononia</placeName>, ubi convenerint, et foederis <lb xml:id="p2z7"/>imperatorem esse <persName>Sabaudiae principem</persName>, qui communi <lb xml:id="p2z8"/>nomine iussus sit iusto exercitu aggredi, <lb xml:id="p2z9"/>dubium an <placeName ref="l167">Genevam</placeName> primum an <placeName ref="l301">Lugdunum</placeName>.</s>
				</p>
				<p>
					<s n="27" xml:lang="la">Et <lb xml:id="p2z10"/>haec omnia fieri auspitiis <placeName ref="l691">Lotharingii</placeName>.</s>
				</p>
				<p>
					<s n="28" xml:lang="la">Certa <lb xml:id="p2z11"/>tamen non refero tibi, frater, sed ea tantum quae ex <lb xml:id="p2z12"/>amicorum literis ex <placeName ref="l648">Rhetia</placeName> missis intellexi.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><lb xml:id="p2z13"/>Haec itaque tibi ut rumoribus sparsa scribo.</s>
				</p>
				<p>
					<s n="30" xml:lang="la" ana="farewell"><lb xml:id="p2z14"/>Vale aeternum, una cum symmystis omnibus.</s>
					<s n="31" xml:lang="la" ana="salute">Omnes <lb xml:id="p2z15"/>symmystae te salutant humanissime cum omnibus tuis.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><lb xml:id="p2z16"/>Dominus servet vos incolumes ab omni malo.</s>
				</p>
				<p>
					<s n="33" xml:lang="la"><lb xml:id="p2z17"/><placeName ref="l587">Tiguri</placeName> 8. martii 1563.</s>
				</p>
				<p>
					<s n="34" xml:lang="la"><lb xml:id="p2z18"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="35" xml:lang="la"><lb xml:id="p2z20"/>Oro vos quam maxime curetis ne haec duo exempla <lb xml:id="p2z21"/>a <persName ref="p1227">Froschouero</persName> in ullius manus perveniant <lb xml:id="p2z22"/>qui typis recudat atque ita damnum det.</s>
				</p>
				<p>
					<s n="36" xml:lang="la"><lb xml:id="p2z23"/>Iam nunc prodiere recentia ex typographia.</s>
					<s n="37" xml:lang="la"><lb xml:id="p2z24"/>Mea vobis exempla mitto: nulli <lb xml:id="p2z25"/>dedisset alii.</s>
				</p>
				<p>
					<s n="38" xml:lang="la"><lb xml:id="p2z26"/>Festinavi, non relegi.</s>
				</p>
				<p>
					<s n="39" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro d. <persName ref="p540">Ioanni <lb xml:id="p4z2"/>Calvino</persName> fidelissimo <lb xml:id="p4z3"/><placeName ref="l167">Genevensis</placeName> ecclesiae ministro <lb xml:id="p4z4"/>domino meo honorando <lb xml:id="p4z5"/>et fratri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>