	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Compater in domino charissime, ante paucos dies <lb xml:id="p1z2"/>sententiam meam de vestro ad landgra[vium] responso <lb xml:id="p1z3"/>ad te misi nec dubito, quin acceperis.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Mitto iam Locos meos, quos dudum ab <persName ref="p5213">Her<lb xml:id="p1z5"/>vagio</persName> accepisse te conveniebat; <lb xml:id="p1z6"/>verum quod ab illo per oblivionem admissum <lb xml:id="p1z7"/>et iam a me tam sero sarcitur, tu <lb xml:id="p1z8"/>boni consulas quaeso.</s>
					<s n="4" xml:lang="la">Non peto, ut eos legas, <lb xml:id="p1z9"/>sed ut aliquem illis locum in refertissima <lb xml:id="p1z10"/>tua bibliotheca concedas.</s>
					<s n="5" xml:lang="la">Lectio illorum destinata <lb xml:id="p1z11"/>est non doctis, sed adolescentibus sacrarum <lb xml:id="p1z12"/>literarum candidatis, nec aliud pollicetus operis <lb xml:id="p1z13"/>huius titulus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Quo consilio antichristus et satellites illius concilium <lb xml:id="p1z15"/>iam denuo moliantur, nemo cordatus ignorat, <lb xml:id="p1z16"/>neque enim divinandum hoc est, sed ex <lb xml:id="p1z17"/>anteactis omnium manifestissimum.</s>
					<s n="7" xml:lang="la">Forsan ad <lb xml:id="p1z18"/>priora accedit aliquid maliciae; novus enim <lb xml:id="p1z19"/>papa novam excogitat maliciam necesse est et <lb xml:id="p1z20"/>huic conveniens.</s>
					<s n="8" xml:lang="la">Ast deus in coelo est, <lb xml:id="p1z21"/>qui dissipat omnia prorsus paparum quamvis <lb xml:id="p1z22"/>callida consilia.</s>
					<s n="9" xml:lang="la" ana="farewell">Optime vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Salutem opto tuis <lb xml:id="p1z23"/>omnibus, dominis item ac fratribus.</s>
					<s n="11" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1560. ultima augusti.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p8417">Wolfg[angus] Musculus</persName> tuus in domino.</s>
				</p>
				<p>
