	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino, <persName ref="p495">Bullingere</persName> charissime.</s>
					<s n="2" xml:lang="la">Salva omnia <lb xml:id="p1z2"/>sunt apud nos, etsi quidam male de nobis divinent.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Satan ubique se miris modis apud papistas se ostendit; <lb xml:id="p1z4"/>attamen cęci esse volunt nec discere Satanę astus.</s>
					<s n="4" xml:lang="la">Dices: <lb xml:id="p1z5"/>"Quidnam factum est insolens apud vestrates?"</s>
					<s n="5" xml:lang="la">Paucis <lb xml:id="p1z6"/>accipe.</s>
					<s n="6" xml:lang="la">In pago <placeName ref="l2836">Sungavię</placeName>, nomen nondum potui scire, <lb xml:id="p1z7"/>fuit sacrificulus, qui in ultima quadra[ge]simę mulierculam, <lb xml:id="p1z8"/>commatrem suam, in sacristiam, ut vocant, duxit confitenteni <lb xml:id="p1z9"/>peccata sua simulantem.</s>
					<s n="7" xml:lang="la">Diu detenta est eo in loco.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Reliqui admirati, quid iam agat sacrificus cum muliercula <lb xml:id="p1z11"/>in loco clauso; quidam per rimam perspexit et sacrificulum <lb xml:id="p1z12"/>e<lb xml:id="p1z13"/>t fęminam iacentes deprehendit ac clamavit: Subagit... <lb xml:id="p1z14"/>se in loco sacro.</s>
					<s n="9" xml:lang="la">Abierunt omnes e templo stupefacti <lb xml:id="p1z15"/>ob indignam rem, quę acciderat.</s>
					<s n="10" xml:lang="la">Episcopo res innotuit, <lb xml:id="p1z16"/>qui sacrificulum abduxit et in carcerem in <placeName ref="l2301">Altkirch</placeName> <lb xml:id="p1z17"/>oppido coniecit pane et aqua hominem macerans, qua <lb xml:id="p1z18"/>cautior sit in audienda confessione.</s>
					<s n="11" xml:lang="la">Cur nebulonem <lb xml:id="p1z19"/>illum non perdit episcopus?</s>
					<s n="12" xml:lang="la">De iis plura re<note type="margin">a.R.: er schreibt "res"</note> <lb xml:id="p1z20"/>exactius cognita; sed, quod scripsi, verissimum est.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/>Haberem alias multa in sinum tuum effundenda <lb xml:id="p1z22"/>de proditionibus evangelii, si mihi certus est nuntius, <lb xml:id="p1z23"/>cui tuto possem ea committere.</s>
					<s n="14" xml:lang="la">Aiunt d. <persName ref="p8034">a Heideck</persName> <lb xml:id="p1z24"/>esse in <placeName ref="l404">Ropolstein</placeName> et in gratiam Caesaris et <persName ref="p18477">Ferdinandi</persName> <lb xml:id="p1z25"/>receptum.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Frater quęstoris aerarii <placeName ref="l491">Argentinę</placeName> fuit, ne<lb xml:id="p1z26"/>scio, quidnam illic agat.</s>
					<s n="16" xml:lang="la">Dominus nos conservet ab <lb xml:id="p1z27"/>malesanis hominibus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Vale.</s>
					<s n="18" xml:lang="la"><placeName ref="l28">B[asileae]</placeName> 12. aprilis 1551.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z28"/>T[uus] <persName ref="p1278">Gastius</persName>, <lb xml:id="p1z29"/>raptim sub noctem.</s>
				</p>
				<p>
					<s n="20" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem eherwurdigen <lb xml:id="p2z2"/>und wolgelerten herren <lb xml:id="p2z3"/>meyster <persName ref="p495">Heinrych <lb xml:id="p2z4"/>Bullinger</persName>, pre<lb xml:id="p2z5"/>dicant zuͦ <placeName ref="l587">Zurich</placeName>, <lb xml:id="p2z6"/>mynem lieben, gun<lb xml:id="p2z7"/>stigen herren.</s>
					<s n="21" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
