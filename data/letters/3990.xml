	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Qua fide accipiuntur et reddantur hoc <lb xml:id="p1z2"/>pessimo saeculo literę, <persName ref="p495">Bullingere</persName> frater et compater <lb xml:id="p1z3"/>in domino charissime, experiuntur boni viri plus <lb xml:id="p1z4"/>satis.</s>
					<s n="3" xml:lang="la">De commentariis meis in ambas apostoli <lb xml:id="p1z5"/>ad Corinthios epistolas deque strena missa <lb xml:id="p1z6"/><persName ref="p2207">Heinricho</persName>, filiolo nostro, iam dudum ad te <lb xml:id="p1z7"/>scripsi; verum cui commissae fuerint eę <lb xml:id="p1z8"/>literae, recordari nequeo senili vicio <lb xml:id="p1z9"/>impeditus.</s>
					<s n="4" xml:lang="la">Accepi item abs te, quae in <lb xml:id="p1z10"/><placeName ref="l619">Bavaricae</placeName> examinationis articulos <lb xml:id="p1z11"/>aedidisti, quos et <persName ref="p2095">Melanchthonem</persName> in publicis <lb xml:id="p1z12"/>lectionibus perstrinxisse accepi.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z13"/>Raro quidem scribo, fateor; sed <lb xml:id="p1z14"/>c<lb xml:id="p1z15"/>ogitandum est amicis, quam sit <lb xml:id="p1z16"/>senectus torpida ac tarda, illique condonandum, <lb xml:id="p1z17"/>si quid officii desyderatur, id quod te <lb xml:id="p1z18"/>quoque facere non dubito.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z19"/>Legi, quae ad d. <persName ref="p8018">Hallerum</persName> compatrem <lb xml:id="p1z20"/>meum de disputatione sacramentaria <lb xml:id="p1z21"/>scripsisti, quae habita est in acade<lb xml:id="p1z22"/>mia <placeName ref="l210">Heidelbergensi</placeName>.</s>
					<s n="7" xml:lang="la">Oro dominum, ut, quod <lb xml:id="p1z23"/>fęliciter coeptum est, provehatur <lb xml:id="p1z24"/>quoque fęliciter.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Si quid ea de re <lb xml:id="p1z25"/>certius adhuc acceperis, oro, communices.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z26"/>Quodsi princeps elector pius est et <lb xml:id="p1z27"/>veritatis amans, cogito de Locis meis <lb xml:id="p1z28"/>illi nuncupandis idque certas ob <lb xml:id="p1z29"/>causas, qua in re iuvare me poteris.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z30"/><persName ref="p3429">Vireti</persName> exasperatio nihil efficiet <lb xml:id="p1z31"/>aliud, quam ut ipsius corculum acerbitate <lb xml:id="p1z32"/>propria adhuc amplius corrodatur.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z33"/>Concedendum non est, quod existimat <lb xml:id="p1z34"/>ecclesiam Christi esse non posse, quae non sit <lb xml:id="p1z35"/>secundum conceptam ab ipsis disciplinam <lb xml:id="p1z36"/>instituta.</s>
					<s n="12" xml:lang="la">Sed hoc tu melius.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Optime vale, com<lb xml:id="p1z37"/>pater charissime.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Saluta <persName ref="p8171">Bibliandrum</persName>, <persName ref="p8111">Petrum Martyrem</persName>, <lb xml:id="p1z38"/><persName ref="p2336">Bernardinum</persName>, <persName ref="p8011">Waltherum</persName> et reliquos una cum domu tua.</s>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z39"/>Salutat te filiolus tuus <persName ref="p487">Heinrichus</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l41">Bernę</placeName> 59., 12. iunii.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><persName ref="p8417">Musculus</persName> tuus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo m. <lb xml:id="p2z3"/><persName ref="p495">Heinricho Bul<lb xml:id="p2z4"/>lingero</persName>, com<lb xml:id="p2z5"/>patri suo in <lb xml:id="p2z6"/>domino longe <lb xml:id="p2z7"/>charissimo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
