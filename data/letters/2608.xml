			<zone xml:id="p2z6-0" points="1201,1930 1255,1919 1301,1939 1345,1940 1368,1953 1394,1949 1398,1797 1378,1796 1328,1817 1265,1782 1203,1796">1208,1871 1235,1870 1262,1868 1289,1868 1317,1868 1344,1868 1371,1867 1399,1865</zone>
		</surface>
