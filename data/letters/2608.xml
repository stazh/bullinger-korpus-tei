	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Quando accepy librum d. mariti mei, compater amantissime, <lb xml:id="p1z2"/>cupiebam, sicut mihy mandabat per suas literas, ut ederetur <lb xml:id="p1z3"/>ante has nundinas, quare<note type="margin">a.R.: ...</note> misi illum d. <persName ref="p8111">Petro Martiiry</persName>, ut hoc <lb xml:id="p1z4"/>curaret <placeName ref="l491">Argentine</placeName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Hoc excusavit propter doctrinam de eucharistia, <lb xml:id="p1z5"/>que non iby est recepta.</s>
					<s n="4" xml:lang="la">Posset hic imprimi com bona venia <lb xml:id="p1z6"/>senatus; sed melius est, ut tu ipse librum prius revideas [at]que is<lb xml:id="p1z7"/>tic imprimi cures.</s>
					<s n="5" xml:lang="la">Quia autem non ignoro memoriam illius esse tibi sanctissimam, <lb xml:id="p1z8"/>non dubito, quin eque nunc sis illi hac in re gratificaturus, <lb xml:id="p1z9"/>ac si viveret.</s>
					<s n="6" xml:lang="la">Imo vivit iam ille coum omnibus sanctis <lb xml:id="p1z10"/>martiribus et Christo suo, martirum capite; ego vero hic morior, <lb xml:id="p1z11"/>donec deus me rursoum illi adiungat.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Habeo gratiam <lb xml:id="p1z12"/>pro sanctissimis tuis literis; Eego certe iam opus habeo talibus <lb xml:id="p1z13"/>consolationibus et vestris presibus; rogo te igitur per sanctam <lb xml:id="p1z14"/>amicitiam sanctissimi martiiris marity mey, quo nunc orbata <lb xml:id="p1z15"/>vitam hanc mortem esse duco, ne me deseras.</s>
					<s n="8" xml:lang="la">Ego non soum <lb xml:id="p1z16"/>illa, que possim reddere paria; sed deo prestabis obsequium gratum, qui <lb xml:id="p1z17"/>vobis vuiduas imprimis com[m]endat.</s>
					<s n="9" xml:lang="la">Ego et <persName>Rahela</persName> mea tiby agimu<lb xml:id="p1z18"/>s <lb xml:id="p1z19"/>gratias pro elegante xeniio misso in novo anno.</s>
					<s n="10" xml:lang="la">S[a]luta optimam uxorem <lb xml:id="p1z20"/>tuam, com[m]atrem cahrissimam, et omnes amicos.</s>
					<s n="11" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l157">Francofordia</placeName> <lb xml:id="p1z21"/>11. aprilis 1555.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Tui amantissima com[m]ater <lb xml:id="p1z23"/>et soror in Christo <persName ref="p8473">Anna Hoper</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><persName>Rachela</persName> tu<lb xml:id="p1z24"/>a mittit tibi nummulum <persName>Angli</persName><note type="margin">a.R.: Angl. Angli?</note>, <lb xml:id="p1z25"/>in quo eff<lb xml:id="p1z26"/>igies sunt Ahab et <lb xml:id="p1z28"/>Iezabel.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo theologo et <lb xml:id="p2z2"/>fidelissimo Christi servo d. <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bullingero</persName>, ecclesiaste <placeName ref="l587">Tigurini</placeName>, <lb xml:id="p2z4"/>d. compatri venerando<lb xml:id="p2z5"/>.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>