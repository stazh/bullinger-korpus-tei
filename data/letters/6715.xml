	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Lieber gevatter <persName ref="p1227">Froschower</persName>, gäbend exemplaria der <lb xml:id="p1z2"/>jetzt ußgangnen Confession disen nachvolgenden: <lb xml:id="p1z3"/>H. <persName ref="p1453">Wolffgang Hallern</persName>:</s>
				</p>
				<p>
					<s n="2" xml:lang="de"><lb xml:id="p1z4"/><placeName ref="l587">Zürych</placeName> minen gn[ädigen] herren 12 tütsche, die er einem <lb xml:id="p1z5"/>burgermeister gäben sol, wie ich mitt imm abgeredt; <lb xml:id="p1z6"/><placeName ref="l41">Bernn</placeName> 12, namlich 6 latinische und 6 tütsche; <lb xml:id="p1z7"/><placeName ref="l49">Byel</placeName> 12, namlich 4 latinisch und 8 tütsche; <lb xml:id="p1z8"/><placeName ref="l167">Genff</placeName> 6, alle latinisch.</s>
				</p>
				<p>
					<s n="3" xml:lang="de"><lb xml:id="p1z9"/>H. <persName ref="p8011">Rodolffen Waltharten:</persName> <lb xml:id="p1z10"/><placeName ref="l441">Schaffhusen</placeName> 12, namlich 6 latinisch und 6 tütsche; <lb xml:id="p1z11"/><placeName ref="l28">Basel</placeName> 12, namlich 6 latinisch, 6 tütsche; <lb xml:id="p1z12"/><placeName ref="l335">Mylnhusen</placeName> 12, namlich 4 latinisch, 8 tütsche.</s>
				</p>
				<p>
					<s n="4" xml:lang="de"><lb xml:id="p1z13"/><persName ref="p495">Heinrych Bullingern</persName>: <lb xml:id="p1z14"/>dem pfaltzgraven 12, 6 latin, 6 tütsch; <lb xml:id="p1z15"/>dem lantgraven 6, namlich 2 latin, 4 tütsch; <lb xml:id="p1z16"/><placeName ref="l473">Santgallen</placeName> 12, namlich 6 latinisch, 6 tütsch; <lb xml:id="p1z17"/><placeName ref="l98">Chur</placeName> 12, namlich 6 Latin, 6 tütsch.</s>
					<s n="5" xml:lang="de"><lb xml:id="p1z18"/>ise alle exemplaria, deren sind in summa 120, sol <lb xml:id="p1z19"/>min lieber gevatter h. <persName ref="p1453">Wolffgang Haller</persName> uß dem <lb xml:id="p1z20"/>studentenampt bezalen, wie es min herren er<lb xml:id="p1z21"/>kendt habend.</s>
					<s n="6" xml:lang="la">9. martij 1566.</s>
				</p>
				<p>
					<s n="7" xml:lang="de"><lb xml:id="p1z22"/><persName ref="p495">Heinrych Bullinger</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
