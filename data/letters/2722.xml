					<pb/>
					<lb xml:id="p4z1"/>Amplissimo viro ac d. d. Heinrycho Bullingero,
					<lb xml:id="p4z2"/>nostro Christi ac dispensatori mysteriorum dei
					<lb xml:id="p4z3"/>fidelissimo, suo in paceis praeceptori colendiio
					<lb xml:id="p4z4"/>charissimoq.
					<lb xml:id="p4z5"/>8. septembris 1555.
					<lb xml:id="p4z6"/>Mittit adhuc 200 fl. pro domi
					<lb xml:id="p4z7"/>natione libera
