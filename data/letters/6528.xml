	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Humanissimo atque mihi multum <lb xml:id="p1z2"/>observando pastori et patri <lb xml:id="p1z3"/>domino <persName ref="p495">Heinrico Buͦlingero</persName> <lb xml:id="p1z4"/>seniori S. P. <lb xml:id="p1z5"/>D.</s>
					<s n="2" xml:lang="la">Iamdudum (observande pater) ad te scribere desiderabam, quomodo <lb xml:id="p1z6"/>hic vivamus, sed quum per otium non licuisset neque ullos <lb xml:id="p1z7"/>tabellarios reperiremus, nobis hucusque differendum fuit.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z8"/>Cum in hanc urbem adventavimus, d. <persName ref="p8075">doctorem Erastum</persName> <lb xml:id="p1z9"/>invisimus, qui nos tuo nomine convictores apud se recepit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>Laute apud illum vivimus; sed tamen, quoniam in illius aedibus <lb xml:id="p1z11"/>hypocaustum habere non potuimus, alio locare nos oportuit, <lb xml:id="p1z12"/>quod nobis hieme valde incommodum, presertim nocte <lb xml:id="p1z13"/>vigentibus magnis frigoribus, cum nobis per urbem <lb xml:id="p1z14"/>discurendum erit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Germanicae linguae bonisque scientiis quottidie <lb xml:id="p1z15"/>studemus; preceptores doctos habemus, sub quibus nos <lb xml:id="p1z16"/>optime operam daturos literis speramus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quod ad te p<lb xml:id="p1z17"/>lus scribam, nescio, nisi quod tibi maximas agam gratias <lb xml:id="p1z18"/>pro beneficiis, quae a te accepimus; quae in memoria <lb xml:id="p1z19"/>mea semper excussa erunt.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Oro deum, ut <lb xml:id="p1z20"/>te incolumem serv longevamque tibi det.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l210">Heidelbergae</placeName> <lb xml:id="p1z21"/>8. dei septembris anno 1565.</s>
