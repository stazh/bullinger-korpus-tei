	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Putabam me librum hunc, quemad<lb xml:id="p1z2"/>modum ultimis ad te, domine colendissime, literis <lb xml:id="p1z3"/>meis significabam, ad adventum usque tuum <lb xml:id="p1z4"/>servaturum.</s>
					<s n="3" xml:lang="la">Sed ecce, venit ad nos patruelis <lb xml:id="p1z5"/>ille tuus eiusdem tecum nominis atque ideo etiam <lb xml:id="p1z6"/>mihi charior adducens ad me <persName ref="p20466">Hectorem</persName>, <lb xml:id="p1z7"/>fratrem tuum, una cum literis venerandi <lb xml:id="p1z8"/>senis parentis tui efflagitantis, ut r[ecipe]re<lb xml:id="p1z9"/>m iterum in disciplinam et curam me[am] <lb xml:id="p1z10"/><persName ref="p20466">Hectorem</persName> etc.</s>
					<s n="4" xml:lang="la">Recepi; neque enim optimo [sen<lb xml:id="p1z11"/>i] quicquam negare potui; sed et me tibi quoque grati<lb xml:id="p1z12"/>ficaturum credidi, qui ab initio hunc vel <lb xml:id="p1z13"/>nolenti obtrusisti.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Sed libenter tamen <lb xml:id="p1z14"/>recepi, quod colendis amicis inservire cupiv[i].</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Saepe interea, dum vestri absunt, oblati sunt pueri, ac potuissem <lb xml:id="p1z16"/>illustris viri d. <persName ref="p613">Matthaei Coignetii filium</persName> <lb xml:id="p1z17"/>unicum ad me nullo meo incommodo recipere.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z18"/><placeName ref="l587">Tigurum</placeName> enim ipsum adduxit et apud nobilem <lb xml:id="p1z19"/>quendam affinem meum collocavit; sed locum illis <lb xml:id="p1z20"/>retinui vestris, quamquam interim, si vestros <lb xml:id="p1z21"/>illos nunquam venturos scivissem, ullos facile alio<lb xml:id="p1z22"/>s recepissem aut reciperem adhuc eas <lb xml:id="p1z23"/>maxime ob caussas, quas aliquando exposui praesenti.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z24"/>Tuo ergo isti patrueli meum illud munus <lb xml:id="p1z25"/>imposui ad te deferendum, ac libenter <lb xml:id="p1z26"/>hoc oneris in se accepit, ut saltem ita <lb xml:id="p1z27"/>tibi gratificaretur.</s>
					<s n="9" xml:lang="la">Accipe ergo a me, quod <lb xml:id="p1z28"/>benigno et faventissimo tuique amantissimo animo <lb xml:id="p1z29"/>offero.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Sub finem invenies sermones duos <lb xml:id="p1z30"/>de magistratu et iureiurando, qui non <lb xml:id="p1z31"/>inutiles tibi fore videntur.</s>
					<s n="11" xml:lang="la">Dominus servet <lb xml:id="p1z32"/>te incolumem diu.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Salvus sit <persName ref="p6831">Ioannes <span type="pronoun">noster</span> Tra<lb xml:id="p1z33"/>versus a Salice</persName> filius; salva sit uxor tua; <lb xml:id="p1z34"/>salva sit tota domus tua.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Spero te meas <lb xml:id="p1z35"/>illas literas, quarum in initio harum literarum <lb xml:id="p1z36"/>memini, te recepisse; miseram eas <lb xml:id="p1z37"/><placeName ref="l98">Curiam</placeName> die abhinc 4. ad d. <persName ref="p8009">Ioannem Fabritium</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell"><lb xml:id="p1z38"/>Vale et rescribe aliquando, an meae <lb xml:id="p1z40"/>tibi fideliter sint redditae.</s>
					<s n="15" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z41"/>15. novembris 1558.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z42"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z2"/>Clarissimo viro d. <persName ref="p8432">Fride<lb xml:id="p2z3"/>rycho a Salice</persName>, pretori <lb xml:id="p2z4"/>designato c<lb xml:id="p2z6"/>om<lb xml:id="p2z7"/>itatus <pb/><lb xml:id="p3z1"/><placeName ref="l520">Val<lb xml:id="p3z2"/>lis Telli<lb xml:id="p3z3"/>nae</placeName><lb xml:id="p3z4"/>, <placeName ref="l440">Sa<lb xml:id="p3z5"/>m<lb xml:id="p3z6"/>adae</placeName> <lb xml:id="p3z8"/>agenti, <lb xml:id="p3z9"/>d<lb xml:id="p3z10"/>omi<lb xml:id="p3z11"/>no su<lb xml:id="p3z13"/>o <lb xml:id="p3z14"/>colendissim<lb xml:id="p3z15"/>o <lb xml:id="p3z16"/>et f<lb xml:id="p3z17"/>r<lb xml:id="p3z18"/>atr<lb xml:id="p3z19"/>i cha<lb xml:id="p3z20"/>ris<lb xml:id="p3z21"/>simo<lb xml:id="p3z22"/>.</s>
					<s n="19" xml:lang="la"><lb xml:id="p3z23"/><placeName ref="l440">Samada</placeName>.</s>
				</p>
				<p>
					<note>[Zu dem Brief gehört noch folgender Zettel:]</note>
					<s n="20" xml:lang="de"><lb xml:id="p3z24"/>Ich hab ettlich maculaturn u<lb xml:id="p3z25"/>mb h. <persName ref="p6831">Traversen</persName> und üwer <lb xml:id="p3z26"/>bücher geschlagen.</s>
				</p>
				<p>
					<s n="21" xml:lang="de">Darus werdend <lb xml:id="p3z27"/>ir verstan, was wercks man <lb xml:id="p3z28"/>hie druckt d. d. <persName ref="p8111">Petro <lb xml:id="p3z29"/>Martyri</persName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Est opus supra <lb xml:id="p3z30"/>230 folia de eucharistiae caussa <lb xml:id="p3z31"/>contra <placeName ref="l553">Wintoniensem</placeName> episcopum, <lb xml:id="p3z32"/>virum doctum, qui contra nos pro <lb xml:id="p3z33"/>transsubstantiatione scripsit.</s>
					<s n="23" xml:lang="la">Erit <lb xml:id="p3z34"/>hoc opus iustum, quod tractabit et s<lb xml:id="p3z35"/>cripturae et patrum omnia <lb xml:id="p3z36"/>de <lb xml:id="p3z40"/>ha<lb xml:id="p3z41"/>c <lb xml:id="p3z42"/>cau<lb xml:id="p3z43"/>ssa <lb xml:id="p3z45"/>edita.</s>
					<s n="24" xml:lang="la" ana="farewell">Vale <lb xml:id="p3z46"/>i<lb xml:id="p3z47"/>terum.</s>
				</p>
			</div>
		</body>
	</text>
