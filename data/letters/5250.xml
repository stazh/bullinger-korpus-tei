	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>14. argumentum, quod desumumus ab exemplo Cornthedus
					<lb xml:id="p1z2"/>ecclesiae in sectas divisae, scortatione plusquam ethvica contaminatae, in
					<lb xml:id="p1z3"/>usu disciplinae cessantis idolorum sacrificiis se polluentis Cornant
					<lb xml:id="p1z4"/>prophanantis ac articulum resurrectionis in quaestionem vocanti
					<lb xml:id="p1z5"/>Galaticae item ecclesiae pergaviensis ac Thyatirensis Apori 9 nostri
					<lb xml:id="p1z6"/>huic instituto aptum esse iudicamius, ut doceatur pios impiorum
					<lb xml:id="p1z7"/>in ministerio ecclesiae commertio non confaminari
					<lb xml:id="p1z8"/>Hisce igitur aliisque scripturae testimoniis freti, comprehensam hoc sun
					<lb xml:id="p1z9"/>sententiam bona confrientia hactenus defendimus, parati tamen
					<lb xml:id="p1z10"/>et audire et sequi meliorem si quae melior ex
					<lb xml:id="p1z11"/>scripturae fontibus nobis adferri posset, et oramus pios ecclesiae
					<lb xml:id="p1z12"/>pastores et ministros, ne quid hic sentiant nobis
					<lb xml:id="p1z13"/>saperte significare delignentur, ut hac ratione ad idem sentinm
					<lb xml:id="p1z14"/>et confitendum inducamur. Amen.
					<lb xml:id="p1z15"/>Petrus Dathaenus.
					<lb xml:id="p1z16"/>Tumultuario haec in hoc mercatu turbis molestiisque plene
					<lb xml:id="p1z17"/>exarrani, quae paulo mundius explicatiusque rescribere librissimu
					<lb xml:id="p1z18"/>sed non tulit temporis angustia. Oro igitur fratres
					<lb xml:id="p1z19"/>ut parum ornatam orationum boni consulant, ac de re ipsa
					<lb xml:id="p1z20"/>in timore domini iudicent.
					<lb xml:id="p1z21"/>Vster Petrus Dathaenus
					<pb/>
					<lb xml:id="p2z1"/>Ornatissimis viris domino Heyricho
					<lb xml:id="p2z2"/>Bullingero aliisque ecclesiae Tygurinae
					<lb xml:id="p2z3"/>ministris et pastoribus
					<lb xml:id="p2z4"/>Tiguri.
					<lb xml:id="p2z5"/>Pathemo Baptismus
