			<zone xml:id="p4z3-0" points="315,1385 365,1349 457,1393 690,1349 938,1394 1389,1380 1389,1254 1043,1319 315,1285">322,1342 375,1335 429,1333 482,1333 536,1336 589,1333 643,1331 696,1333 750,1331 803,1330 857,1330 911,1330 964,1331 1018,1333 1071,1333 1125,1336 1178,1337 1232,1339 1285,1339 1339,1337 1393,1336</zone>
