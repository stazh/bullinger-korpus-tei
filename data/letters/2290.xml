	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. <lb xml:id="p1z2"/>P.</s>
					<s n="2" xml:lang="la">Scripsissem sepius, si quid dig...; <lb xml:id="p1z3"/>sed hucusque tantum cogitant <lb xml:id="p1z4"/>principes de cogendis exercitibus, et <lb xml:id="p1z5"/>proximo mense audiemus conatus illorum<lb xml:id="p1z6"/>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Dominus velit nostris adesse.</s>
					<s n="4" xml:lang="la">Rex n[oster] magnis <lb xml:id="p1z8"/>viribus ubique hostem aggreditur satisque i<lb xml:id="p1z9"/>am p<lb xml:id="p1z10"/>erspicit... dinatis pa lus(?) suos conatus <lb xml:id="p1z11"/>vanos <lb xml:id="p1z12"/>et illa <persName ref="p18538">Caesari</persName> promiserat <lb xml:id="p1z13"/>irrita.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z14"/><persName>Rex R[omanus]</persName> cum principibus conven<lb xml:id="p1z15"/>iunt <lb xml:id="p1z16"/><placeName ref="l18">Auguste</placeName>, ut scis, credo, quos etiam regina <lb xml:id="p1z17"/><placeName ref="l882">Hungaria</placeName> <persName ref="p18215">Maria</persName> ex mandato <persName ref="p18538">Caesari<lb xml:id="p1z18"/>s</persName> propter eius infirmitatem statuit <lb xml:id="p1z19"/>invisere.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Que tibi mitto iamiam <lb xml:id="p1z20"/>a domino <placeName ref="l1206">Bayonensi</placeName>, nostro legato apud <lb xml:id="p1z21"/><placeName ref="l648">Rhetos</placeName>, accepi, et mir<lb xml:id="p1z22"/>atur ipse, quod <lb xml:id="p1z23"/>tamdiu illa heserint in via, ut <lb xml:id="p1z24"/>videas, credo ex data <lb xml:id="p1z25"/>literarum d. <persName ref="p3375">Verg[erii]</persName>, qui mihi <lb xml:id="p1z26"/>scribit et rogat, ut ad te statim <lb xml:id="p1z27"/>mittam, que hic reperies.</s>
					<s n="7" xml:lang="la">Illud statim erit <lb xml:id="p1z28"/>longum nimis, sed <lb xml:id="p1z29"/>cu<lb xml:id="p1z30"/>ius culpa accidat nescio; nam <lb xml:id="p1z31"/>noster legatus non significat, quis ei m<lb xml:id="p1z32"/>iserit.</s>
					<s n="8" xml:lang="la">Literae <persName ref="p3375">Vergerii</persName> ad <lb xml:id="p1z33"/>me sunt date <lb xml:id="p1z34"/>22. febru<lb xml:id="p1z35"/>ari<lb xml:id="p1z36"/>i.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute"><pb/><lb xml:id="p2z1"/>Saluto dominos tuos, quos recte <lb xml:id="p2z2"/>admonebo de his, que hac estate <lb xml:id="p2z3"/>succedunt, ne quis illis<note type="margin">a.R.: gestr.</note></s>
					<s n="10" xml:lang="la"><persName>Caesareanus</persName> <lb xml:id="p2z4"/>more solito imponat.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale optime.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z5"/>Ex <placeName ref="l760">Soluturo</placeName> <lb xml:id="p2z6"/>26. maii.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Tuus semper <persName ref="p8296">Bass[e<lb xml:id="p2z7"/>fontaneus]</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p3z1"/>Optimo viro d. <lb xml:id="p3z2"/><persName ref="p495">Bulingero</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p3z3"/><placeName ref="l587">Tiguri</placeName></s>
				</p>
			</div>
