	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus et pax Christi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Nec iam michi ullum scribendi argumentum <lb xml:id="p1z3"/>est, <persName ref="p495">Bullingere</persName> charissime, hoc uno, quod <lb xml:id="p1z4"/><persName ref="p7201">Iacobus</persName><note xml:id="fn1" type="footnote" n="1">Gemeint ist zweifellos <persName ref="p7201">Jakob Zorn</persName>; vgl. unten <ref target="file11290">Nr. 1247</ref>.</note> ille, qui nuper apud te miseriam <lb xml:id="p1z5"/>suam detexit, anxie rogavit, ut commendaretur <lb xml:id="p1z6"/>a me tibi.</s>
					<s n="3" xml:lang="la">Est autem bonus certe vir, dignus, <lb xml:id="p1z7"/>cui adsis, si qua ratione potes.</s>
					<s n="4" xml:lang="la">Persequuntur <lb xml:id="p1z8"/>illum quidam furiosi ad internitiem usque.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Invasit eum hisce diebus nebulo quidam nemini <lb xml:id="p1z10"/>notus et prostratum conatus est vulnerare, <lb xml:id="p1z11"/>sed defendit eum pileus insigniter lęsus, <lb xml:id="p1z12"/>ut intelligat se non posse sine vitae discrimine <lb xml:id="p1z13"/>diutius hic hęrere<note xml:id="fnb" type="footnote" n="b"><hi>nach</hi> haerere <hi>gestrichenes</hi> posse.</note>, atque ea est publica <placeName ref="l774">Tur<lb xml:id="p1z14"/>goye</placeName> iustitia, scilicet ut bonus vir non sit <lb xml:id="p1z15"/>tutus.</s>
					<s n="6" xml:lang="la">Dominus respitiat aliquando suos.</s>
					<s n="7" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Nosti forte <persName ref="p5565">Capitonem</persName> brevi profecturum <lb xml:id="p1z17"/><placeName ref="l41">Bernam</placeName><note xml:id="fn2" type="footnote" n="2">Das Gerücht, <persName ref="p5565">Capito</persName> wolle <placeName ref="l41">Bern</placeName> besuchen, bewahrheitete sich nicht; vgl. unten <ref target="file11267">Nr. 1224</ref>, 87-89.</note>; causam vero ignoro.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale cum <lb xml:id="p1z18"/><persName ref="p8127">Pellicano</persName> et bonis omnibus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ex <placeName ref="l257">Constantia</placeName>, <lb xml:id="p1z19"/>7. ianuarii 1539.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/>Tuus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Hainricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> antistiti, <lb xml:id="p2z4"/>observando meo in <lb xml:id="p2z5"/>Christo fratri<lb xml:id="p2z6"/>.</s>
					<s n="13" xml:lang="de"><lb xml:id="p2z7"/>Zürch.</s>
				</p>
			</div>
		</body>
	</text>
