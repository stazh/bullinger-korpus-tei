	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non occurrunt admodum multa, quę modo <lb xml:id="p1z2"/>scribam; si quę enim sunt nova, ea ipse soles <lb xml:id="p1z3"/>scire prius quam nos.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Reliquis, quę scilicet ecclesias <lb xml:id="p1z4"/>nostras attinent, te obtundere non possum.</s>
					<s n="4" xml:lang="la">Hodie habuimus <lb xml:id="p1z5"/>classis nostrae synodum.</s>
					<s n="5" xml:lang="la">Conqueruntur fratres <lb xml:id="p1z6"/>omnes de regnante passim apud nos corruptione.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z7"/>Omnia vergunt in peius, nec corrigimur etiam sub <lb xml:id="p1z8"/>manu domini feriente nos.</s>
					<s n="7" xml:lang="la">Concurrunt omnes <lb xml:id="p1z9"/>plagae, caritas rerum horribilis, pestis quoque iterum <lb xml:id="p1z10"/>apud nos grassans, et bella quoque sunt prae <lb xml:id="p1z11"/>foribus; sed exigua apparet poenitentia.</s>
					<s n="8" xml:lang="la">Me<lb xml:id="p1z12"/>tuo ergo valde, ne simus visuri maximas plagas, <lb xml:id="p1z13"/>utinam non extremum gentis nostrae excidium.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Val<lb xml:id="p1z14"/>de me deiecerunt atrocia, quę audivi patrari scelera, <lb xml:id="p1z15"/>ideoque plura scribere non possum, donec animum <lb xml:id="p1z16"/>et spiritum aliquantum iterum recepero.</s>
					<s n="10" xml:lang="la">Sunt et alia quotidia<lb xml:id="p1z17"/>na, quę me affligunt; sed parco tibi, ne tuas <lb xml:id="p1z18"/>molestias recensendo meas maiores reddam.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z19"/>Bene vale.</s>
					<s n="12" xml:lang="la">Sunt hic multę literae, quas singulis <lb xml:id="p1z20"/>reddi curabis.</s>
					<s n="13" xml:lang="la" ana="salute">Mei omnes dei beneficio bene valent <lb xml:id="p1z21"/>teque omnes plurimum salutant.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l41">Bernę</placeName> 8. iunii <lb xml:id="p1z22"/>152.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Tu<lb xml:id="p1z23"/>us <persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Bul<lb xml:id="p2z2"/>lingero</persName>.</s>
					<s n="17" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
					<s n="18" xml:lang="de"><lb xml:id="p2z3"/>M. <persName ref="p495">Heinrych <lb xml:id="p2z4"/>Bullingeren</persName> <lb xml:id="p2z5"/>zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
