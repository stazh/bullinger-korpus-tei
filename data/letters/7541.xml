	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Equidem quid ad te scribam, mi pater, nescio, cum Tretius loco <lb xml:id="p1z2"/>longissimae epistolae omnibus istic vobis esse possit.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">De disci<lb xml:id="p1z3"/>plina ego quoque ipse dubito, ut in hanc ecclesiam tam sero induci <lb xml:id="p1z4"/>queat.</s>
					<s n="3" xml:lang="la">Soli sunt opinor hac tempestate nostri fratres <placeName ref="l2449">Bohe<lb xml:id="p1z5"/>mici</placeName>, qui eam servant; de quibus hisce diebus conscripsi <lb xml:id="p1z6"/>commentarium, quem, si voles, tibi quoque et tuis legendum mittam.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Tecum sentio de ortu <placeName>Waldensium</placeName>; sed diversi sunt nostri ab illis, <lb xml:id="p1z8"/>qui non a pauperibus de <placeName ref="l301">Lugduno</placeName>, sed ab <placeName>Husso</placeName>, hic vero a <lb xml:id="p1z9"/><persName>Wicleico Anglo</persName> prodierunt.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Iuve t vos omnes dominus, ut bene <lb xml:id="p1z10"/>incoepta perficiatis.</s>
					<s n="6" xml:lang="la"><placeName ref="l734">Frisia</placeName> bellis ardet, ad quam vastandam <lb xml:id="p1z11"/>magnae <placeName ref="l875">Hispanorum</placeName> copiae descendere dicuntur.</s>
					<s n="7" xml:lang="la">Opitulantur <lb xml:id="p1z12"/>principi <placeName>Uraniae</placeName> duces <placeName ref="l822">Germanie</placeName>.</s>
					<s n="8" xml:lang="la">Video, mi pater, tempus <lb xml:id="p1z13"/>iam illud instare, quo adventus nostri liberatoris exspectandus <lb xml:id="p1z14"/>est.</s>
					<s n="9" xml:lang="la">Veni igitur, domine, cito nosque his malis libera.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z15"/>Vale quam diutissime.</s>
				</p>
				<p>
					<s n="11" xml:lang="de"><placeName ref="l210">Heidelberge</placeName> 24. iulii 1568.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z16"/>Tui observantissimus <persName ref="p8041">Iohannes <lb xml:id="p1z17"/>Lasicius</persName>.</s>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Nobilissimo theologo <lb xml:id="p2z2"/><persName ref="p495">Henricho Bullingero</persName> <lb xml:id="p2z3"/>tanquam patri observando.</s>
				</p>
			</div>
		</body>
