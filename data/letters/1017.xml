	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Ago tibi gratias pro novis istis.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><placeName ref="l1041">Brunsvicensis</placeName> dux capitaneos <lb xml:id="p1z2"/>non potest acquirere aptos ad res bellicas, inexercitatos recusat; misit <placeName ref="l491">Argentinam</placeName> <lb xml:id="p1z3"/>militem quendam, qui capitaneum conduxit ingenti ęre, sed milites paucos invenit, <lb xml:id="p1z4"/>qui cum talici infelici duce militare velint.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Dicunt timido principi et infortunato <lb xml:id="p1z5"/>ad eventus bellicos nolle servire ac pios Christi confessores nolle ullo damno <lb xml:id="p1z6"/>afficere; se non latere principem turpi fuga dereliquisse milites in acie pugnantes <lb xml:id="p1z7"/>et ad lanienam duxisse; malle praeterea hyeme domi latere, quam in frigore arma <lb xml:id="p1z8"/>ferre et apud talem principem, qui pecunia careat.</s>
					<s n="5" xml:lang="la">Timet fortassis damnum ingens <lb xml:id="p1z9"/>illatum iri a civitatibus <placeName ref="l749">Saxonię</placeName> post cladem acceptam; ideo credo iam secundo ducem <lb xml:id="p1z10"/>illum profligatum esse.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Manum dei tetigisse Caesarem, ut triduo mutus fuerit nec lectum reliquerit, <lb xml:id="p1z12"/>aiunt quidam.</s>
					<s n="7" xml:lang="la">Fortassis instituit aliquid contra evangelium dei et in media consultatione <lb xml:id="p1z13"/>dominus illum admonuit, ne ultra pergat, nisi velit mori.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Praeterea aiunt Caesarem pessime velle <persName ref="p18250">Mauritio</persName> principi; nam privata con<lb xml:id="p1z15"/>silia habet cum <persName ref="p18477">Ferdinando</persName> regi contra Caesaris potentiam.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><persName ref="p18477">Ferdinandus</persName> ambit Caesar<lb xml:id="p1z16"/>eam dignitatem post mortem fratris; ideo revocavit <persName ref="p8282">Maximilianum</persName> filium ex <placeName ref="l875">Hispaniis</placeName>; <lb xml:id="p1z17"/>videbimus mira futura in aestate.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Lantgravius aiunt esse mortuum, quo autem genere mortis sublatus sit, ad<lb xml:id="p1z19"/>huc ignoratur; quidam aiunt veneno interiisse, quidam ex nimio męrore confectum.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/>Ad hęc fama spargit <persName ref="p7706">Granvellam</persName> extremum diem clausisse, qui anima <lb xml:id="p1z21"/>fuit Caesaris, neque puto Cesarem diu victurum anima emissa.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/><placeName ref="l1430">Halę</placeName> in <placeName ref="l749">Saxonia</placeName> dicunt ex limpidissimo fonte sanguinem tribus diebus <lb xml:id="p1z23"/>effluxisse stupentibus omnibus, qui prodigium illud viderunt.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z24"/>Nauseam scias <placeName ref="l922">Friburgi</placeName> fuisse; pręposituram enim habet in <placeName ref="l1020">Waldkirch</placeName> pinguem, cui <lb xml:id="p1z25"/>scriptum est ex aula, ut domum redeat, <placeName ref="l2510">Turcam</placeName> augere suum exercitum.</s>
					<s n="14" xml:lang="la">Qui mox lectis <lb xml:id="p1z26"/>literis valedixit amicis, quos illic habet, et abiit celerrimo gradu, ne <placeName ref="l875">Hispani<lb xml:id="p1z27"/>cus</placeName> exercitus illius aedes occupet, qui <placeName ref="l546">Wiennam</placeName> missus est.</s>
					<s n="15" xml:lang="la" ana="salute">Neque mihi quicquam <lb xml:id="p1z28"/>negotii est cum <persName ref="p7688">Nausea</persName>, neque illum unquam salutavi; sed si venisset <placeName ref="l28">Basileam</placeName>, illum <lb xml:id="p1z29"/>adiissem collocutusque fuissem hominem ob veteram amicitiam, quam olim <placeName ref="l307">Moguntię</placeName> <lb xml:id="p1z30"/>habebamus inter nos.</s>
					<s n="16" xml:lang="la">Plura <persName ref="p8418">Myconius</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Vale.</s>
					<s n="18" xml:lang="la"><placeName ref="l28">Basileę</placeName> 2. septembris 1550.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z31"/>T[uus] <persName ref="p1278">Gastius</persName>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z32"/>Hęc tibi scribo: Sparsit quidam ex <placeName ref="l587">Tigurinis</placeName> <placeName ref="l28">Basileę</placeName> d. <persName ref="p8171">Bibliandrum</persName> Pelagii <lb xml:id="p1z33"/>dogma de libero arbitrio tenere velleque contra quosvis defendere tanquam ex scripturis <lb xml:id="p1z34"/>divinis fundatum.</s>
					<s n="21" xml:lang="la">Quod tamen nunquam volui credere neque adhuc credam; habent <lb xml:id="p1z35"/>osores, qui illius doctrinam audent reprehendere, quam imitari non possunt.</s>
					<s n="22" xml:lang="la" ana="salute"><lb xml:id="p1z36"/>D. <persName ref="p2916">Schertlinus</persName> te resalutat.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Lege, si tempus perdere vis, chronographiam <persName ref="p2463">Panthaleonis</persName> <lb xml:id="p2z2"/>nostri, qui, quicquid cogitat, audet, et expende, quo calculo tuo numeraris annos.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">De libris editis his nundinis bre<lb xml:id="p2z3"/>vi scribam fuse.</s>
					<s n="25" xml:lang="de">Dem ehrwürdigen und wolgelerten herren meyster <persName ref="p495">Heinrych Bullinger</persName>, lütpriester zuͦ <placeName ref="l587">Züric<lb xml:id="p2z4"/>h</placeName>, mynem lieben, günstigen herren, zuͦ handen.</s>
				</p>
				<p>
					<s n="26" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
