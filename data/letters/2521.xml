	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Is, qui tibi has reddet, optime <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z2"/>dimidium est animae meae.</s>
					<s n="2" xml:lang="la">Quid plura?</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Traxit eum ex <placeName ref="l834">Italia</placeName> media adeo <lb xml:id="p1z4"/>hyeme caritas hucusque, tantum ut me <lb xml:id="p1z5"/>videret.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Tu complectere hominem, qui <lb xml:id="p1z6"/>per <placeName ref="l587">Tigurum</placeName> iter facit, ut te videat.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Scribunt ad me ex <placeName ref="l491">Argentina</placeName> fratres partitam <lb xml:id="p1z8"/>fuisse pecuniam principis nostri inter <placeName ref="l830">Anglos</placeName>; <lb xml:id="p1z9"/>an habita fuerit ratio eorum, qui istic sunt, <lb xml:id="p1z10"/>ignoro; ego certe ur i, quin in eorum <lb xml:id="p1z11"/>praecipue gratiam impetravi.</s>
					<s n="6" xml:lang="la">Dux <lb xml:id="p1z12"/>nunc aliam pecuniam subministrat <lb xml:id="p1z13"/>pro novo testamento in Slavicam lin<lb xml:id="p1z14"/>guam vertendo, quod opus antequam agre<lb xml:id="p1z15"/>diar, cupio vobiscum conferre; at venis<lb xml:id="p1z16"/>sem nunc quidem, nisi maximum negotium <lb xml:id="p1z17"/>me retineret; at veniam spero.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z18"/>Tandem rex Romanus ingressus est <placeName ref="l18">Aug<lb xml:id="p1z19"/>ustam</placeName> comitiorum gratia, sed nullus adh<lb xml:id="p1z20"/>uc princeps, noster adhuc domi.</s>
					<s n="8" xml:lang="la">Sum nu<lb xml:id="p1z21"/>diustertius cum eo locutus et cum comite, <lb xml:id="p1z22"/>qui Mompelgardum rediit uxorem, <pb/><lb xml:id="p2z1"/>ut speramus, ducturus lantgravii filiam.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p2z2"/>Tace, quum opportunum fuerit, spero <lb xml:id="p2z3"/>te rem totam cogniturum.</s>
					<s n="10" xml:lang="la">An<lb xml:id="p2z4"/>thiocus, u<lb xml:id="p2z5"/>t allyciat ad iuvandum bellum, quod <lb xml:id="p2z6"/>gesturus est in oriente et occidente, cu<lb xml:id="p2z7"/>ravit dictari, proh deum immortalem <lb xml:id="p2z8"/>qua astutia.</s>
					<s n="11" xml:lang="la">Dixi sententiam, neque si <lb xml:id="p2z9"/>angelus de caelo recipiendum.</s>
					<s n="12" xml:lang="la">Primum <lb xml:id="p2z10"/>caput est de anabaptisitis, secundum <lb xml:id="p2z11"/>de <persName>Zvinglianis</persName>, nempe ut prorsus <lb xml:id="p2z12"/>valeant neque admittantur.</s>
					<s n="13" xml:lang="la">Sed plura <lb xml:id="p2z13"/>scripsi, quam volui, at ea lege, ne <lb xml:id="p2z14"/>ulli mortalium verbum facias.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z15"/>Poteris ad me rescribere per equitem, qui <lb xml:id="p2z16"/>istum meum fratrem istuc conduxit; <lb xml:id="p2z17"/>quod ut facias, rogo, at fuse et liberaliter.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z18"/>Si venerit doliolum ex <lb xml:id="p2z20"/><placeName ref="l491">Argentina</placeName> plenum libris, accipe, quod <lb xml:id="p2z21"/>vis, deinde da Laelio.</s>
					<s n="16" xml:lang="la" ana="salute">Salvere cupio <lb xml:id="p2z22"/><persName ref="p7228">Zvinglium</persName>, <persName ref="p1884">Lavaterum</persName>, <persName ref="p8442">Simblerum</persName> <lb xml:id="p2z23"/>atque omnes fratres.</s>
					<s n="17" xml:lang="la">Adhuc quaere cata<lb xml:id="p2z24"/>logum haereticorum et tuam epistolam <pb/><lb xml:id="p3z1"/>ad me, quod de valde oro, frater.</s>
					<s n="18" xml:lang="la"><lb xml:id="p3z2"/>Princeps quaedam vidit, quae nuper concinnavi <lb xml:id="p3z3"/>de illo reverendo nugarum patre <persName ref="p18489">Gregorio</persName>, <lb xml:id="p3z4"/>et in summa serio hortatus est, ut <lb xml:id="p3z5"/>caveam mihi ab antichristo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">"Vix", inquit, "<lb xml:id="p3z6"/>feret te toties irritantem."</s>
					<s n="20" xml:lang="la">Cavebo, <lb xml:id="p3z7"/>sed spes mea in domino exercituum.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p3z8"/>De causa <persName ref="p2301">Osiandrica</persName> scriberem, nam <lb xml:id="p3z9"/>tractatur nunc; sed laudo te <lb xml:id="p3z10"/>etiam, quod ab hoc genere contentionum abhor<lb xml:id="p3z11"/>res, quod et ego facio.</s>
					<s n="22" xml:lang="la" ana="farewell">Vale e<lb xml:id="p3z12"/>t ora pro me.</s>
					<s n="23" xml:lang="la"><lb xml:id="p3z13"/><placeName ref="l512">Tubingae</placeName> kalendis <lb xml:id="p3z14"/>ianuarii 1555.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p3z15"/><persName ref="p3375">Vergerius</persName> frater.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p3z16"/>Scribe ad me, quid <lb xml:id="p3z18"/>de <placeName ref="l294">Locarno</placeName>.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p3z19"/>Oro te mirandum in modum, mitte <lb xml:id="p3z20"/>nunc per istum raitter libellum Italicum <lb xml:id="p3z21"/><persName>Ioannis della Casa</persName> de laudibus (honor sit <lb xml:id="p3z22"/>verbo) sodomiae; princeps meus <lb xml:id="p3z23"/>cupit videre, quia cardinalis <placeName ref="l18">Augustae</placeName>, <lb xml:id="p3z24"/>cum quo nuper collocatus est, negavit <lb xml:id="p3z25"/>fuisse unquam scriptum.</s>
					<s n="27" xml:lang="la"><lb xml:id="p3z26"/>Quin oro etiam, <pb/><lb xml:id="p4z1"/>ut mittas pontificale; utrumque sancte reddam.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p4z2"/>[Cla]ris<lb xml:id="p4z3"/>simo viro domino Henrico [<lb xml:id="p4z4"/>B]ullinghero, ministro <placeName ref="l587">Tigurino</placeName>, <lb xml:id="p4z5"/>[f]ratri honorando.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><lb xml:id="p4z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
