	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la">Redeunt ad vos fratres duo <persName ref="p8130">Laurentius</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8130">Lorenz Meyer (Agricola)</persName>.</note> et <persName ref="p6544">Svitzerus</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p6544">Rudolf Schwyzer d.Ä.</persName></note> <lb xml:id="p1z2"/>senatu facile hoc eis concedente,<note xml:id="fn3" type="footnote" n="3">Vgl. <ref target="file12835">Nr. 2786</ref>,57-61; <ref target="file12840">Nr. 2791</ref>,66-70; <ref target="file12854">Nr. 2805</ref>,11-13.</note> quandoquidem parvus vel <lb xml:id="p1z4"/>nullus eorum in ecclesia <pb type="edition" next="388"/> nostra usus fuit<note xml:id="fna" type="footnote" n="a"><hi>Über der Zeile nachgetragen.</hi></note>, cum quotidie confluant <lb xml:id="p1z5"/>ministri exules multi.<note xml:id="fn4" type="footnote" n="4">Vgl. etwa <bibl source="b21">HBBW XVIII</bibl> 281f,46-51; und <ref target="file12888">Nr. 2839</ref>,10f.</note></s>
					<s n="3" xml:lang="la">Laboravi multum, ut retinerem eos, <lb xml:id="p1z6"/>si quo modo vel una haec possit conservari ecclesia; sed nec apud ipsos <lb xml:id="p1z7"/>hoc impetrare potui nec senatum cogere, ut invitos detineret.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/><persName ref="p2812">Romanum</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p2812">(Hans) Thoman Ruman (Römer)</persName>.</note>, quia uxorem<note xml:id="fn6" type="footnote" n="6">Unbekannt.</note> secum habet, retinuerunt, ne ego essem solus.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Quomodo se res habeant modo, narrabunt ipsi, quamvis non <lb xml:id="p1z10"/>dubito exaggeraturos valde, ut reditus iustiorem videantur <lb xml:id="p1z11"/>habere causam.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="6" xml:lang="la"><persName ref="p8130">Laurentium</persName> amo valde propter eruditionem.<note xml:id="fn7" type="footnote" n="7">Vgl. <bibl source="b21">HBBW XVIII</bibl> 96.176f; 107,8; 285,142f; 306,52f.</note></s>
					<s n="7" xml:lang="la">Eum, <lb xml:id="p1z13"/>tibi alias commendatum, iterum commendo.</s>
					<s n="8" xml:lang="la">Alter indigne mecum <lb xml:id="p1z14"/>egit.<note xml:id="fn8" type="footnote" n="8">Siehe aaO, 306,57f; 363,161-163.</note></s>
					<s n="9" xml:lang="la">Dominus illi condonet, quia ego remisi dudum.</s>
					<s n="10" xml:lang="la">Nolo etiam, ut <lb xml:id="p1z15"/>propter me minus a vobis promoveatur.</s>
					<s n="11" xml:lang="la">Hoc unum oro, ut, si <lb xml:id="p1z16"/>me sit traducturus, in tempore significes.</s>
					<s n="12" xml:lang="la" ana="salute">Non video <lb xml:id="p1z17"/>in eo spiritum apostolicum, qui ecclesiae pacem et salutem quaerat, <lb xml:id="p1z18"/>qui possit se accommodare etiam ignotorum ingeniis.<note xml:id="fn9" type="footnote" n="9">Anspielung auf <cit type="bible"><ref>1Kor 9, 19-23</ref></cit>.</note></s>
					<s n="13" xml:lang="la">Satius ergo <lb xml:id="p1z19"/>est, ut apud suos rusticos<note xml:id="fn10" type="footnote" n="10"><persName ref="p6544">Schwyzer d.Ä.</persName> war vor seiner Anstellung in <placeName ref="l18">Augsburg</placeName> Pfarrer in <placeName ref="l1562">Richterswil</placeName> (<placeName ref="l803">Landschaft Zürich</placeName>) gewesen (s. <bibl source="b20">HBBW XVII</bibl> 380, Anm. 64), wohin er nach seinem <placeName ref="l18">Augsburger</placeName> Aufenthalt zurückkehrte.</note> retineatur, qui tales magnifaciunt <lb xml:id="p1z20"/>concionatores.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="14" xml:lang="la">Speramus militem<note xml:id="fn11" type="footnote" n="11">Die kaiserliche Besatzung; s. <ref target="file12870">Nr. 2821</ref>,10f. 184-187. - Am 27. Februar gelangte das siebte und am 14. März (vielleicht aber schon am 12. oder kurz davor - s. nämlich <ref target="file12893">Nr. 2844</ref>,15-17) die drei letzten Fähnlein der Besatzung in die Stadt; s. <hi>Roth, <placeName ref="l18">Augsburg</placeName></hi> IV 13f. Auch <bibl source="b570">Schertlin, Leben</bibl> 61 berichtet von zehn Fähnlein.</note> mox ab urbe discessurum.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z21"/><persName ref="p18538">Caesarem</persName><note xml:id="fn12" type="footnote" n="12"><persName ref="p18538">Karl V.</persName> - Zu dessen Aufbruch von <placeName ref="l513">Ulm</placeName> s. Nr. 2835, Anm. 19.</note> <placeName ref="l513">Ulmam</placeName> reliquisse fama est.</s>
					<s n="16" xml:lang="la">Summus ille capi<lb xml:id="p1z22"/>taneus<note xml:id="fn13" type="footnote" n="13"><persName ref="p7760">Bernhard von Schaumburg</persName>, Hauptmann der kaiserlichen Besatzung in <placeName ref="l18">Augsburg</placeName>.</note> proxime per sacerdotem<note xml:id="fn14" type="footnote" n="14">Unbekannt.</note> (qui et miles est) privatim <lb xml:id="p1z23"/>missam celebrari fecit in stuba<note xml:id="fn15" type="footnote" n="15">Kapitelstube. - Vgl. <hi>Henrich, <persName ref="p8418">Myconius</persName> BW</hi> 948f, <ref target="file11105">Nr. 1062</ref>.</note> collegii S. Ulrychi.</s>
					<s n="17" xml:lang="la">Monuimus <lb xml:id="p1z24"/>senatum.</s>
					<s n="18" xml:lang="la">Allocuti sunt ipsum consules.<note xml:id="fn16" type="footnote" n="16"><persName ref="p1410">Jakob Herbrot</persName> und <persName ref="p3927">Hans Welser</persName>.</note></s>
					<s n="19" xml:lang="la">Quid impetraverint, nescio.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z25"/>Vereor, ne ita pedetentim relabatur satan.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="21" xml:lang="la"><persName ref="p18604">Dux Bavariae</persName><note xml:id="fn17" type="footnote" n="17">Herzog <persName ref="p18604">Wilhelm IV. von Bayern</persName>. - Er hatte eine Gesandtschaft nach <placeName ref="l18">Augsburg</placeName> geschickt, die am 2. März dort ankam und mit dem Rat aushandelte, dass dem Herzog 20000 Gulden entrichtet wurden, woraufhin dieser die Sperre gegen die Stadt aufhob; s. <hi>Roth, <placeName ref="l18">Augsburg</placeName></hi> IV 25-27.</note>, <lb xml:id="p1z26"/><persName ref="p7840">episcopus Augustanus</persName><note xml:id="fn18" type="footnote" n="18">Kardinal <persName ref="p7840">Otto Truchsess von Waldburg</persName>. - Siehe dazu <ref target="file12885">Nr. 2836</ref>, Anm. 11.</note> et <persName ref="p18477">Ferdinandus</persName><note xml:id="fn19" type="footnote" n="19">König <persName ref="p18477">Ferdinand I.</persName> - Siehe <ref target="file12885">Nr. 2836</ref>, Anm. 12.</note> iam etiam cum nostris agunt <lb xml:id="p1z27"/>de pecuniis.</s>
					<s n="22" xml:lang="de">Ich mein, die seck werdind einmal<note xml:id="fn20" type="footnote" ana="lex" n="20">schließlich.</note> glert.</s>
					<s n="23" xml:lang="la"><lb xml:id="p1z28"/>Sed possunt omnia ferri, modo salva sit religio.<pb type="edition" next="389"/></s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="24" xml:lang="de">27. februarii <lb xml:id="p1z29"/>hatt der rat dem graff <persName ref="p20485">Friderychen von Fürstenberg</persName> gschworen <lb xml:id="p1z30"/>in nammen deß keisers.<note xml:id="fn21" type="footnote" n="21">Siehe <hi>Roth, <placeName ref="l18">Augsburg</placeName></hi> IV 10f.</note></s>
					<s n="25" xml:lang="de">Die gmein<note xml:id="fn22" type="footnote" ana="lex" n="22">Bürgergemeinde.</note> hatt nitt wellen schweeren, <lb xml:id="p1z31"/>aber man fuͤrt si bi der nasen umb, das unser keiner weißt, wo<lb xml:id="p1z32"/>ran wir sind.</s>
					<s n="26" xml:lang="la">Metuimus, ne ita libera nobis relinquatur doctrina, <lb xml:id="p1z33"/>ut etiam sua interim libera pfaffis et monachis in urbe restituatur <lb xml:id="p1z34"/>et permittatur religio.</s>
					<s n="27" xml:lang="la">Non video, quem alium finem hoc negotium <lb xml:id="p1z35"/>sit habiturum.</s>
					<s n="28" xml:lang="la">Tu itaque, venerande pater, mihi tanquam filio <lb xml:id="p1z36"/>rebus sic habentibus, quid agere debeam, consule, quaeso, meque habeto tib<lb xml:id="p1z37"/>i commendatum.</s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="29" xml:lang="la" ana="salute">Salvos cupio patres<note xml:id="fnb" type="footnote" n="b"><hi>In der Vorlage aus</hi> fratres <hi>korrigiert.</hi></note> ac dominos venerandos <lb xml:id="p1z38"/><persName ref="p8127">Pellicanum</persName>, <persName ref="p8171">Bibliandrum</persName>, <persName ref="p8011">Gvaltherum</persName> et reliquos una cum familia tua.</s>
					<s n="30" xml:lang="la"><lb xml:id="p1z39"/>Proxima septimana quidam civis <placeName ref="l18">Augustanus</placeName><note xml:id="fn23" type="footnote" n="23">Der unbekannte <placeName ref="l18">Augsburger</placeName>, den <persName ref="p8018">Haller</persName> auch in <ref target="file12893">Nr. 2844</ref>,2, erwähnt.</note> ad vos proficiscetur, per quem, <lb xml:id="p1z40"/>si quae habuero, scribam plura.</s>
					<s n="31" xml:lang="la">5. martii 1547.</s>
					<s n="32" xml:lang="la"><lb xml:id="p1z41"/><persName ref="p8018">Ioan. Hallerus</persName>, perpetuo tuus.</s>
				</p>
			</div>
			<div xml:id="div7" corresp="regest7">
				<p>
					<s n="33" xml:lang="la" ana="salute"><lb xml:id="p1z42"/><persName ref="p5413">Socero</persName> meo<note xml:id="fn24" type="footnote" n="24"><persName ref="p5413">Ulrich Kambli</persName>.</note> dicas salutem et salva esse omnia.</s>
					<s n="34" xml:lang="la">Non vacat ei scribere.</s>
					<s n="35" xml:lang="la"><lb xml:id="p1z43"/>Literas vitrico<note xml:id="fn25" type="footnote" n="25">Unbekannt. - Er lebte in <placeName ref="l82">Bülach</placeName>; s. <bibl source="b21">HBBW XVIII</bibl> 155, Anm. 101.</note> mittendas ei modo tradas.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="36" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>domino et <lb xml:id="p2z4"/>patri suo veneran<lb xml:id="p2z5"/>do.</s>
					<s n="37" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.<note xml:id="fn26" type="footnote" n="26">Dieser Brief wie auch die Briefe gleichen Datums von <persName ref="p1860">Michael Keller</persName> (Nr. 2838) und <persName ref="p8417">Wolfgang Musculus</persName> (<ref target="file12888">Nr. 2839</ref>) wurden durch <persName ref="p8130">Meyer</persName> und <persName ref="p6544">Schwyzer</persName> übermittelt, denen <persName ref="p7197">Hans Wilpert Zoller</persName> als Begleiter zugewiesen wurde; s. <ref target="file12893">Nr. 2844</ref>,1f.</note></s>
				</p>
			</div>
		</body>
	</text>
</TEI>