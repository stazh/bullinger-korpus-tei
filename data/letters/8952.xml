	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>iut tibi redditas esse, mod alluama meas
					<lb xml:id="p1z2"/>ilidem literas mihi d. Rosetus affirmavit, ita
					<lb xml:id="p1z3"/>etimutcasque toli vestro collegio ud iniucundas
					<lb xml:id="p1z4"/>fuisse consendo. Certe hoc possu sancte confirmare
					<lb xml:id="p1z5"/>me vel Gallorum meorum ingeniand nosse vel
					<lb xml:id="p1z6"/>passuros nunquam, ut a nobis disiungantur
					<lb xml:id="p1z7"/>nisinquam, qua ut communi coram deo et angelii
					<lb xml:id="p1z8"/>et hominisus confessioni subscripsimus, ita etiam
					<lb xml:id="p1z9"/>ut spero, umi semper erimus in ddmo. et quanquam
					<lb xml:id="p1z10"/>illos, qui nos tam malitiose cignosce, mi pater,
					<lb xml:id="p1z11"/>dicent, quod res est, nulla cum animi acerbitate
					<lb xml:id="p1z12"/>seiunctos voluerunt, spero pecatus agunturos.
					<lb xml:id="p1z13"/>tamen quum quid moliti sint et quomodo
					<lb xml:id="p1z14"/>aoloti sine cogito, non possum non adhuc admovere
					<lb xml:id="p1z15"/>Dominus tamen illis condonet. De rebus mih
					<lb xml:id="p1z16"/>tuemur scholae reliquias; Etsi enim levissimo
					<lb xml:id="p1z17"/>est contagio, tamen, quoniam fuit tam diuturna
					<lb xml:id="p1z18"/>quodam consensu alii alio dilabuntur.
					<lb xml:id="p1z19"/>Pergimus tamen et perxenus, quoad licebit,
					<lb xml:id="p1z20"/>In Saxonia salis recte omnia, ut aliund
					<lb xml:id="p1z21"/>intelligere potuisti. Certe videtur mihi dominus
					<lb xml:id="p1z22"/>illuc etiam perempturus, quod ut spero, precibus
					<lb xml:id="p1z23"/>et sancto silentio potius impetrabimus, quam
					<lb xml:id="p1z24"/>ullis scriptis extorquebimus. In Gallia solenmpsi
					<lb xml:id="p1z25"/>itu publice vitatum et promulgatum est
					<lb xml:id="p1z26"/>Galliae et Angliae foedus die 15 superioris
					<lb xml:id="p1z27"/>Halles.
					<lb xml:id="p1z28"/>mensis. Certalim in Belgium  conciritur
					<lb xml:id="p1z29"/>Ludovicum Rassovium. Successorem
					<lb xml:id="p1z30"/>Albano missum eectum est praelionanali ciu
					<lb xml:id="p1z31"/>prGalliae classe profligatum, ex quo vix ipse
					<lb xml:id="p1z32"/>cum paucissimis salvus evasit. In tota Gallia
					<lb xml:id="p1z33"/>delectus habentur, et quum omnia palam ad
					<lb xml:id="p1z34"/>bellum spectent; regem tamen aiunttestor
					<lb xml:id="p1z35"/>se cum Hispano servare pacem constituisse. Multo
					<lb xml:id="p1z36"/>vobis patefaciet tempus. Interea sedulo precenui
					<lb xml:id="p1z37"/>ut quocunque istae tempestates vergant, ipsius
					<lb xml:id="p1z38"/>fucere, qui toti terrarum orbi prorsus immunet
					<lb xml:id="p1z39"/>involvamur. Amisimus Navanenam, ab, mi pater
					<lb xml:id="p1z40"/>qualem et quantam foemina? Scripsi ad illius filiu
					<lb xml:id="p1z41"/>et horede quam potui diligentissime. sed quigem
					<lb xml:id="p1z42"/>multa hic metuo, quae scribere non possum. Verum
					<lb xml:id="p1z43"/>bene habet, quod spes nostra uno deo viditur. Quicquid cest
					<lb xml:id="p1z44"/>accepero statum significabo. Bene vale, vii fratercum
					<lb xml:id="p1z45"/>iulii.
					<pb/>
					<lb xml:id="p2z1"/>S.
					<lb xml:id="p2z2"/>Christi
					<lb xml:id="p2z3"/>servo.
					<lb xml:id="p2z4"/>Henrico Bullingero,
					<lb xml:id="p2z5"/>patri mihi plurimum
					<lb xml:id="p2z6"/>observando et
					<lb xml:id="p2z7"/><placeName ref="l587">Tigurinae</placeName> ecclesiae
					<lb xml:id="p2z8"/>viere fido pastori.
					<lb xml:id="p2z9"/><placeName ref="l587">Tiguri</placeName>.
				</p>
