	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Gratias tibi et <persName>Belinchetto</persName> ago maximas <lb xml:id="p1z3"/>pro libello <persName ref="p2336">Bernardini</persName>; dedi illum trans<lb xml:id="p1z4"/>ferendum, ut videam, quid in eo commentetur <lb xml:id="p1z5"/>et quid facto sit opus.</s>
					<s n="3" xml:lang="la">Video mihi singulariter <lb xml:id="p1z6"/>opus esse copioso fidelique dei auxilio, qui <lb xml:id="p1z7"/>unus petar a tot hostibus; sed scio dominum <lb xml:id="p1z8"/>mihi nunquam defuturum, cui me totum <lb xml:id="p1z9"/>commendo et hunc oro, ut vires meas paulo <lb xml:id="p1z10"/>firmius solidet; nam sentio subinde et animi <lb xml:id="p1z11"/>et corporis vires non parum deficere.</s>
					<s n="4" xml:lang="la">Sed <lb xml:id="p1z12"/>fiat voluntas domini.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">De rebus <placeName ref="l832">Galliae</placeName> et <lb xml:id="p1z13"/><persName ref="p540">Calvino</persName> nihil habeo, nisi quod hic graviter <lb xml:id="p1z14"/>decumbat; dominus illum nobis restituat et c<lb xml:id="p1z15"/>onsoletur ecclesiam suam!</s>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 24. <lb xml:id="p1z16"/>martii 1564.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Tuus ille <persName ref="p495">B[ulli<lb xml:id="p1z18"/>ngerus]</persName>.</s>
					<s n="9" xml:lang="la">Consul fuit apud nos cum suis; dixit omnia de foedere.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/>Amice et diu confabulati sumus; sperat ille foedus <lb xml:id="p1z20"/>illud non processurum.</s>
					<s n="11" xml:lang="la">Dedi literas commen<lb xml:id="p1z21"/>datitias ei ad d. <persName ref="p629">Coignetium</persName> et ad <persName ref="p8033">Bezam</persName> <lb xml:id="p1z22"/>et d. <persName ref="p3429">Viretum</persName> <placeName ref="l301">Lugduni</placeName> iam agentem; habent <lb xml:id="p1z23"/>illi suos amicos in aula, per quos potest iuvari <lb xml:id="p1z24"/>consul in sua causa, id quod ab illis postulavi.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z25"/>Excepit illum magistratus sex vini ciathis; <lb xml:id="p1z26"/>ederunt cum illo 4 e senatu; ego quoque <lb xml:id="p1z27"/>me illis adiunxi.</s>
					<s n="13" xml:lang="la">Dominus ipsum sanum re<lb xml:id="p1z28"/>ducat; videtur bonus vir marcescere, ac <lb xml:id="p1z29"/>me quoque ille aiebat plurimum a me ipso mutatum <lb xml:id="p1z30"/>esse; sed senium hoc et ita solet.</s>
					<s n="14" xml:lang="la" ana="farewell">Iterum <lb xml:id="p1z31"/>iterumque vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>ministro, domino et fratri <lb xml:id="p2z4"/>meo colendo et dilectissimo.</s>
					<s n="16" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>