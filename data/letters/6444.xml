	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Reverende pater.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Venit ad nos illustris <lb xml:id="p1z2"/>vir d. comes <persName ref="p2054">Martinengus</persName>, incidit <lb xml:id="p1z3"/>autem in tempus longe occupatissimum <lb xml:id="p1z4"/>et nunc praeter opinionem subito discedit.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Eum tibi commendare non est necesse.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Tamen eum sine meis ad te literis <lb xml:id="p1z7"/>venire nolui, quod id videretur <lb xml:id="p1z8"/>ab instituto et officio meo alienum.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Si quae sunt, quae hic vulgo feruntur, <lb xml:id="p1z10"/>ex ipso audies; sed pauca tamen sunt, <lb xml:id="p1z11"/>quae tu scire labores.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Nos exepctamus <lb xml:id="p1z12"/>ex te, quid nundinae pepererint.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Negotium <persName>Philippi</persName> pendet et, ut puto, <lb xml:id="p1z14"/>refrigescet; sed tamen nihildum <lb xml:id="p1z15"/>affirmo.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Tu nullam occasionem <lb xml:id="p1z16"/>praetermittes nos docendi, quid <lb xml:id="p1z17"/>in <placeName ref="l822">Germania</placeName> fiat, Inferiori <lb xml:id="p1z18"/>maxime, in qua dicuntur aliquot <lb xml:id="p1z19"/><placeName ref="l875">Hispanorum</placeName> millia appulisse; quam <lb xml:id="p1z20"/>vere, nescio.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Haec subito.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z21"/>Caetera d. comes, qui scit, quam fuerim <lb xml:id="p1z22"/>occupatus; ideo mihi ignosces.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z23"/><placeName ref="l98">Curię</placeName> vesperi ante pascha.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">T[uus] <persName ref="p8009">F[abricius</persName>].</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>domino suo et in <lb xml:id="p2z4"/>Christo patri reverendo.</s>
					<s n="16" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
