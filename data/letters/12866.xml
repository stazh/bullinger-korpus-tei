	<text xml:lang="de">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>G[nad] und f[rid].</s>
					<s n="2" xml:lang="de">Vergangner tagen hab ich üch, <lb xml:id="p1z3"/>fürgeliebter herr, vilfaltig und vertruwklich ge<lb xml:id="p1z4"/>schriben, zum ersten by <persName ref="p6277">Augustin Ruchen</persName>, dem<lb xml:id="p1z5"/>nach by minem besonders lieben herren m<lb xml:id="p1z6"/>[eister] <persName ref="p6990">Johan Wägman</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p6990">Hans Wegmann</persName>.</note>.</s>
					<s n="3" xml:lang="de">Vertruw, es sye üch alles eigentlic<lb xml:id="p1z7"/>h überantwort.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="4" xml:lang="de"><lb xml:id="p1z8"/>Siderhar ist nüt <lb xml:id="p1z9"/>nüwers, dann das <persName ref="p8498">Dietrych Marcell</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p8498">Marcell Dietrich von Schankwitz</persName>.</note>, deren von <lb xml:id="p1z10"/><placeName ref="l513">Ulmm</placeName> houptman, aber von <placeName ref="l513">Ulm</placeName> gen <placeName ref="l257">Constant<lb xml:id="p1z11"/>z</placeName> zogen, diser tagen hie durchgeritten uff <placeName ref="l28">Ba<lb xml:id="p1z12"/>sel</placeName>.</s>
					<s n="5" xml:lang="de">Ist mir vertruwklich geschriben, da sye <lb xml:id="p1z13"/>der von <persName ref="p8034">Haidegg</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p8034">Johann Freiherr von Heideck</persName>.</note>, <placeName ref="l749">saxisch</placeName>, by imm gewest.</s>
					<s n="6" xml:lang="de">So habend <lb xml:id="p1z14"/>die von <placeName ref="l41">Bern</placeName> ein <lb xml:id="p1z15"/>ylenden tag beschriben<note xml:id="fn10" type="footnote" n="10">schriftlich einberufen; s. <bibl source="b590">SI</bibl> IX 1521f.</note> <lb xml:id="p1z16"/>gen <placeName ref="l21">Baden</placeName> uff Invocavit<note xml:id="fn11" type="footnote" n="11">27. Februar 1547. - Die Tagsatzung begann am 28. Februar; s. <bibl source="b197">EA</bibl> IV/1d 771.</note>, darvon ir ongezweifflet <lb xml:id="p1z17"/>von minen herren selbs bericht empfangen.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="7" xml:lang="de"><lb xml:id="p1z18"/>Die sag ist (wie waar es sye, weiß ich nitt), <lb xml:id="p1z19"/>das hertzog <persName ref="p1546">Christoffel von Wirtenberg</persName> und <lb xml:id="p1z20"/>graff <persName ref="p8098">Jörg</persName><note xml:id="fn12" type="footnote" n="12"><persName ref="p8098">Georg von Württemberg-Mömpelgard</persName>.</note> ir land dem <persName ref="p20225">Franzosen</persName><note xml:id="fn13" type="footnote" n="13"><persName ref="p20225">Franz I.</persName></note> versetzt<note xml:id="fn14" type="footnote" n="14">verpfändet; s. <bibl source="b590">SI</bibl> VII 1680.</note>, <lb xml:id="p1z21"/>und mache der <persName ref="p20225">Franzos</persName> sine schillt<note xml:id="fn15" type="footnote" n="15">Wappen; Abzeichen; s. <bibl source="b590">SI</bibl> VIII 728-730. 734.</note> und gylgen<note xml:id="fn16" type="footnote" n="16">Lilien (als Symbol für <placeName ref="l832">Frankreich</placeName>); s. <bibl source="b590">SI</bibl> I 179f; II 232.</note> <lb xml:id="p1z22"/>zuͦ <placeName ref="l327">Muͦmpelgart</placeName> uff<note xml:id="fn17" type="footnote" n="17">mache uff: bringe an; s. <bibl source="b590">SI</bibl> IV 40.</note>.</s>
					<s n="8" xml:lang="de"><persName ref="p1278">Gastius</persName> hatt mirs ouch <lb xml:id="p1z23"/>zuͦgeschriben<note xml:id="fn18" type="footnote" n="18">Mit Brief <ref target="file12802">Nr. 2753</ref>.</note>.</s>
					<s n="9" xml:lang="de">Wyters ist mir nitt ze wüssen.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="10" xml:lang="de"><lb xml:id="p1z24"/>Gott mitt üch.</s>
					<s n="11" xml:lang="la">Haec scripsi, ne scriberem prorsus <lb xml:id="p1z25"/>nihil per hunc nostrum <persName ref="p5483">Alexium</persName><note xml:id="fn19" type="footnote" n="19"><persName ref="p5483">Alexius Knoblauch</persName>, ein Bote zwischen <placeName ref="l473">St. Gallen</placeName> und <placeName ref="l587">Zürich</placeName>.</note>, cu<lb xml:id="p1z26"/>i s<lb xml:id="p1z27"/>emper soleo meas dare.</s>
					<s n="12" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 20. februarii, anno <lb xml:id="p1z28"/>1547.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="13" xml:lang="de" ana="salute">Gruͤssend mir früntl<lb xml:id="p1z29"/>ich <lb xml:id="p1z30"/><persName ref="p3878">Widenhuͦbern</persName><note xml:id="fn20" type="footnote" n="20"><persName ref="p3878">Hans Widenhuber</persName>.</note> und <persName ref="p6355">Saylern</persName><note xml:id="fn21" type="footnote" n="21"><persName ref="p6355">Hieronymus Sailer</persName>.</note> sampt anderen <lb xml:id="p1z31"/>guͦten herren und fründen.</s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="14" xml:lang="de"><persName ref="p495">H. <lb xml:id="p1z32"/>Bullinger</persName>, der <lb xml:id="p1z33"/>üwer.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la">Clarissimo <pb/><lb xml:id="p2z1"/>viro d[octori]<note xml:id="fna" type="footnote" n="a"><hi>Textverlust durch spätere Verkürzung des Blattes, sodass der zweite Teil der Adresse fehlt.</hi></note> <persName ref="p8049">[Ioachi]mo Vadiano</persName>, <lb xml:id="p2z2"/>c[onsuli <placeName ref="l473">Sangal<lb xml:id="p2z3"/>lensi</placeName>], domino suo semper [observando].</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l473">Sangall[en]</placeName>.</s>
				</p>
			</div>
