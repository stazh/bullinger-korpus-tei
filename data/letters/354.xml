	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Binas a tua humanitate literas accepi, colendi mi <lb xml:id="p1z2"/><persName ref="p8418">Myconi</persName>, nec necesse est, ut ad eas responde<lb xml:id="p1z3"/>am operose; maximas interim gratias ago pro tua <lb xml:id="p1z4"/>diligentia et tuis laboribus oroque dominum, ut res <lb xml:id="p1z5"/>pulchre et ad gloriam suam animarumque nostrarum <lb xml:id="p1z6"/>salutem et ad consolationem afflictorum dirigat.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Ego nullas habeo res novas, nisi quod certum habui <lb xml:id="p1z8"/>ex <placeName ref="l834">Italia</placeName> nuncium, ex quo didici <persName ref="p18575">Philippum</persName> regem <lb xml:id="p1z9"/><placeName ref="l2853">Castellę</placeName> vel <placeName ref="l875">Hispaniarum</placeName> naves nondum appulis<lb xml:id="p1z10"/>se.</s>
					<s n="4" xml:lang="la">Paratur quidem illi multo cum apparatu <lb xml:id="p1z11"/>locus <placeName ref="l306">Mediolani</placeName>, et sunt, qui credant ipsum nunquam <lb xml:id="p1z12"/>venturum per <placeName ref="l834">Italiam</placeName> in <placeName ref="l822">Germaniam</placeName>; forte ve<lb xml:id="p1z13"/>niet per Oceanum; utinam in me<lb xml:id="p1z14"/>dio Ocean<lb xml:id="p1z15"/>o natent <lb xml:id="p1z16"/>ambiciosa illa et irrequieta capita ad <lb xml:id="p1z17"/>unum omnia.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z18"/>Optime convenit legatis in omnibus articulis, <lb xml:id="p1z19"/>id quod ominis felicissimi loco habemus omnes.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z20"/>liberrime et amicissime collatum est de omnibus.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z21"/>Valde gaudeo rem feliciter cecidisse.</s>
					<s n="8" xml:lang="la">Soli dis<lb xml:id="p1z22"/>sident vestrates in articulo consilii a nostratibus, <lb xml:id="p1z23"/><placeName ref="l41">Bernatum</placeName> et <placeName ref="l441">Schaffusianis</placeName>; vestri volunt <lb xml:id="p1z24"/>simpliciter et absque disputatione aut declaratione <lb xml:id="p1z25"/>consentire in consilium generale, liberum et christianum; <lb xml:id="p1z26"/>tres urbes aliae putant omnino declaratione opus <lb xml:id="p1z27"/>esse, ne capiamur in verbis, putentque adversarii <lb xml:id="p1z28"/>nos promisisse, quod non promisimus.</s>
					<s n="9" xml:lang="la">Sperant <lb xml:id="p1z29"/>vestros flecti posse in ipsorum sententiam, ne <lb xml:id="p1z30"/>videamur quatuor urbes reliquae ex tot urbibus <lb xml:id="p1z31"/>dissentire et in re summa neque posse convenire.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z32"/>Ideoque comitia nova sunt indicta <placeName ref="l28">Basilęam</placeName> <lb xml:id="p1z33"/>ad 9. Decembris; convenient ibi rursus 4 urbes, <lb xml:id="p1z34"/>ut fiat concors responsum.</s>
					<s n="11" xml:lang="la">Deinde mittent<lb xml:id="p1z35"/>ur legati, qui verbis referent <placeName ref="l2542">7 Pagicis</placeName> <lb xml:id="p1z36"/>responsum alio qui prudens, piium et firmum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Tuum <lb xml:id="p1z37"/>ergo fuerit hortari tuos, ne pergant privatam <lb xml:id="p1z38"/>aliquam retinere sententiam, sed consentiant <lb xml:id="p1z39"/>in communem.</s>
					<s n="13" xml:lang="la">Bene spero de domini gratia, auxilio et <lb xml:id="p1z40"/>liberatione.</s>
					<s n="14" xml:lang="la">Hortare tuos constanter ad preces <lb xml:id="p1z41"/>et poenitentiam.</s>
					<s n="15" xml:lang="la">Plura iam n<lb xml:id="p1z42"/>on possum.</s>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z43"/>Saluta[n]t te fratres D. <persName ref="p8127">Pellic[anus]</persName>, <persName ref="p8171">Theod[orus]</persName>, <persName ref="p8011">Gvalth[erus]</persName>, <persName ref="p8459">Ottho</persName>, <lb xml:id="p1z44"/><persName ref="p8018">Hallerus</persName>, qui hic quoque fuit.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">[...], 8. Novembris.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><persName ref="p495">H[einrychus] B[<lb xml:id="p1z45"/>ullin<lb xml:id="p1z46"/>gerus]</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro D. <persName ref="p8418">Osvaldo <lb xml:id="p2z2"/>Myconio</persName>, <placeName ref="l28">Basiliensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro fideli, <lb xml:id="p2z4"/>domino et fratri colendissimo.</s>
				</p>
			</div>
