	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Spero te meas nuper ad te missas accepisse <lb xml:id="p1z2"/>literas, <persName ref="p8432">Frideryche</persName>, colendissime domine et frater <lb xml:id="p1z3"/>charissime.</s>
					<s n="3" xml:lang="la">In his pleraque exposui, quae habui et quae <lb xml:id="p1z4"/>tu in postremis ad me tuis 10. maii <placeName ref="l440">Samadeni</placeName> datis <lb xml:id="p1z5"/>scire postulabas.</s>
					<s n="4" xml:lang="la">Filius noster <persName ref="p6831">Ioannes Traversus <lb xml:id="p1z6"/>a Salicibus</persName> est <placeName ref="l21">Badenae</placeName> et lavat.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Superioribus diebus <lb xml:id="p1z7"/>misi ad illum, ut scirem, et quid ageret <lb xml:id="p1z8"/>et valeret, ac res omnis, deo gratia, erat in tuto.</s>
					<s n="6" xml:lang="la">Rursus <lb xml:id="p1z9"/>illum ad nos venturum brevi expectamus; intelligo e<lb xml:id="p1z10"/>nim illum nostri desiderio teneri, utcunque liber<lb xml:id="p1z11"/>aliter foveatur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Gaudemus te post nundinas venturum <lb xml:id="p1z12"/>ad nos ac hortamur te, ne sinas ullam <lb xml:id="p1z13"/>remoram impedire tuam profectionem.</s>
					<s n="8" xml:lang="la">Fama <lb xml:id="p1z14"/>est hic quoque <persName ref="p17907">Ferrandum Gonzagam</persName> descensurum ex <placeName ref="l834">Italia</placeName> <lb xml:id="p1z15"/>in <placeName ref="l808">Belgicum</placeName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Hodie retulit mihi <placeName ref="l830">Anglus</placeName> quidam <lb xml:id="p1z16"/>medicus recta ascendens ex <placeName ref="l157">Francfordia</placeName> literas <lb xml:id="p1z17"/>esse ex <placeName ref="l830">Anglia</placeName> allatas significantes 10. maii in <placeName ref="l808">Belgicum</placeName> <lb xml:id="p1z18"/>ex <placeName ref="l830">Anglia</placeName> traiecisse <persName>Philippum</persName> et parasse <lb xml:id="p1z19"/>sibi militem <placeName ref="l830">Anglum</placeName> et impetrasse pecuniam non <lb xml:id="p1z20"/>exiguam contra Gallum.</s>
					<s n="10" xml:lang="la">Ego tamen hoc pro com<lb xml:id="p1z21"/>perta veritate non asseveraverim; metuo tamen <lb xml:id="p1z22"/>regem brevi plures habitur hostes quam velit.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z23"/>Eo impulit illum papa, Antichristus sceleratissimus.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/>Urbes evangelicae 4 in <placeName ref="l862">Helvetia</placeName> mittent ad regem l<lb xml:id="p1z25"/>egationem pro Waldensibus in <placeName ref="l736">Pedemonte</placeName> supplicatum; <lb xml:id="p1z26"/>nam hos per parlamentum <placeName ref="l1291">Taurinense</placeName> stat<lb xml:id="p1z27"/>uerat rex persequi.</s>
					<s n="13" xml:lang="la">Sunt religionis nostrae.</s>
					<s n="14" xml:lang="la">D. <lb xml:id="p1z28"/><persName ref="p8009">Ioannem Fabricium</persName> <placeName ref="l98">Curiae</placeName> agentem tanquam me ipsum <lb xml:id="p1z29"/>commendo iterum; commendo item amplissimum regis <lb xml:id="p1z30"/>legatum d. <persName ref="p629">Mathaeum Cognetum</persName>, qui nuper missus est <lb xml:id="p1z31"/>a rege in <placeName ref="l648">Rhetiam</placeName>; fratrum literis mihi commendatus est, <lb xml:id="p1z32"/>ut qui syncerissimus sit in vera fide, regi quoque charissimus, <lb xml:id="p1z33"/>et qui plura religionis in profectum egerit.</s>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z34"/>Saluta illum meo nomine diligentissime.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Colloquium <lb xml:id="p1z35"/>celebrabitur 24. augusti <placeName ref="l569">Wormaciae</placeName> insti<lb xml:id="p1z36"/>tutum ab ordinibus imperii evangelicis et papisticis; <lb xml:id="p1z37"/>deputatus est praeses, designati assessores, colloqutores, <lb xml:id="p1z38"/>notarii, adiuncti, supernumerarii, de quibus <lb xml:id="p1z39"/>omnibus longum esset et molestum scribere.</s>
					<s n="17" xml:lang="la">Reparata <lb xml:id="p1z40"/>est tamen persequtio in <placeName ref="l808">Belgico</placeName> contra fideles.</s>
					<s n="18" xml:lang="la">Comicia <lb xml:id="p1z41"/>erunt principum <placeName ref="l157">Francfordiae</placeName> 18. iunii de rebus <pb/><lb xml:id="p2z1"/>instituta variis.</s>
					<s n="19" xml:lang="la"><placeName ref="l822">Germani</placeName> principes evangelici et <lb xml:id="p2z2"/>ipsi mittent legatos cum <placeName ref="l862">Helvetiis</placeName> ad regem.</s>
					<s n="20" xml:lang="la"><placeName ref="l749">Saxones</placeName> <lb xml:id="p2z3"/>quidam concionatores rursus in nos aediderunt <lb xml:id="p2z4"/>libellos maledicos, acerbos et ineptissimos.</s>
					<s n="21" xml:lang="la" ana="salute">Singuli <lb xml:id="p2z5"/>te salutant, quos salvere iusseras, inprimis autem d. <persName ref="p8111">Martyr</persName> et gen<lb xml:id="p2z6"/>eri mei et reliquus chorus.</s>
					<s n="22" xml:lang="la" ana="farewell">Vive et vale una cum honestissima coniuge, tota domo tua et d. <lb xml:id="p2z7"/><persName ref="p6831">Traverso</persName>.</s>
					<s n="23" xml:lang="la" ana="farewell">Iterum vale.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 21. maii 1557.</s>
					<s n="25" xml:lang="la">Festinantissime.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="27" xml:lang="la">Insigni <lb xml:id="p2z8"/>pietate et nobilitate claro viro d. <persName ref="p8432">Friderycho a Salice</persName> <placeName ref="l440">Rheto Sama<lb xml:id="p2z9"/>deni</placeName> agenti, domino meo colendissimo e<lb xml:id="p2z10"/>t fratri charissimo.</s>
				</p>
			</div>
