	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi tuas nuper missas, ad quas nihil habeo <lb xml:id="p1z2"/>quod respondeam, nec etiam multa nunc vacat <lb xml:id="p1z3"/>scribere, cum sim occupatissimus.</s>
					<s n="3" xml:lang="la">Quę habui, ad <lb xml:id="p1z4"/><persName ref="p8011">Gvaltherum</persName> nostrum scripsi; is ea tibi communicabit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Concilium <lb xml:id="p1z5"/><placeName ref="l257">Constantię</placeName> futurum vix mihi persuadere <lb xml:id="p1z6"/>possum; <placeName ref="l1107">Tridenti</placeName> non processit, quomodo procederet aut succe<lb xml:id="p1z7"/>deret hic?</s>
					<s n="5" xml:lang="la">Agit eos spiritus vertiginis, ut, quo se <lb xml:id="p1z8"/>vertere debeant, nesciant; cupiunt reprimere <lb xml:id="p1z9"/>causam veritatis, sed non possunt neque poterunt <lb xml:id="p1z10"/>per domini gratiam, qui potenter ipsorum conatibus <lb xml:id="p1z11"/>resistit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ex <placeName ref="l832">Gallia</placeName> nihildum habemus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>D. <persName ref="p8417">Musculi</persName> Locos nunc mitto per hunc; puta<lb xml:id="p1z13"/>vit typographum suo nomine ad te missurum.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Hoc cum non fecerunt, mittit ipse tibi exemplar.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>Proxime plura.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><placeName ref="l41">Bernę</placeName> 2. septembris 1560.</s>
					<s n="11" xml:lang="la">Salvi <lb xml:id="p1z16"/>sint tui omnes.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><persName ref="p8018">I[oannes] <lb xml:id="p1z17"/>Hallerus</persName> <lb xml:id="p1z18"/>tuus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae pastori <lb xml:id="p2z5"/>fidelissimo, domino suo <lb xml:id="p2z6"/>colendissimo et com<lb xml:id="p2z7"/>patri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
