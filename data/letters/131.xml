	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p8114">Nicolaus Artopoeus</persName> d. <persName ref="p495">H[ein<lb xml:id="p1z2"/>ryc<lb xml:id="p1z3"/>ho] <lb xml:id="p1z4"/>Bullingero</persName> suo S. <lb xml:id="p1z5"/>D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Quo in loco sit negotium d. <persName>Benedicti</persName>, <lb xml:id="p1z7"/>eruditissime vir, ipse tibi coram <lb xml:id="p1z8"/>exponet.</s>
					<s n="3" xml:lang="la">Nobis non admodum perplex<lb xml:id="p1z9"/>um videtur, si tantummodo apud dominum <lb xml:id="p1z10"/>consulem <persName ref="p2305">Negelinum</persName> componi queat.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z11"/>Is prę cęteris (non immerito quidem, <lb xml:id="p1z12"/>quantum ego possum intelligere) eius <lb xml:id="p1z13"/>ęgre fert inconstantiam sive mavis <lb xml:id="p1z14"/>imprudentiam, qui prius ictus non <lb xml:id="p1z15"/>sapuit, cum publicaret libellum illum <lb xml:id="p1z16"/>doctoris <persName ref="p8466">Wissemburgii</persName> de autoritate <lb xml:id="p1z17"/>synodorum nescio quibus fretus.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z18"/>D. <persName ref="p1804">Iodocus</persName> et ergo te plurimum rogamus, <lb xml:id="p1z19"/>ut miserulo non desis e<lb xml:id="p1z20"/>t, <lb xml:id="p1z21"/>si tibi videatur ac citra tuo incom<lb xml:id="p1z22"/>modo fieri queat, eum D. consuli <lb xml:id="p1z23"/>per epistolam reconcilies.</s>
					<s n="6" xml:lang="la">no<lb xml:id="p1z24"/>lumus autem, ut id facias, si tibi <lb xml:id="p1z25"/>res non omnino fuerit cordi.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z26"/>Vale, vir integerrime, et fac pro <lb xml:id="p1z27"/>tua humanitate, quemadmodum <pb/><lb xml:id="p2z1"/>hactenus solitus es.</s>
					<s n="8" xml:lang="la">Hodie discessit <lb xml:id="p2z2"/>hinc <lb xml:id="p2z3"/><persName ref="p3099">Sulcerus</persName> insalutato, ut <lb xml:id="p2z4"/>fertur, <persName ref="p8364">Batto</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8364">Beat Gering</persName>.</note>, qui, quo se conferat, <lb xml:id="p2z5"/>adhuc ignorare dicitur.</s>
					<s n="9" xml:lang="la" ana="salute">V<lb xml:id="p2z6"/>ale et <lb xml:id="p2z7"/>nostro nomine salutabis plurimum d. <persName ref="p8018">Hallerum</persName> et symmystas tuos omnes.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><placeName ref="l41">Ber<lb xml:id="p2z8"/>nę</placeName> 24. maii.</s>
				</p>
				<p>
					<note type="signature">[Unterschrift fehlt.]</note>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><persName ref="p495">Hen[rycho] Bullingero</persName>, viro eruditione et piet<lb xml:id="p2z9"/>ate clarissimo.</s>
				</p>
			</div>
		</body>
