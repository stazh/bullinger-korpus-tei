	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="de">Diewyl die <placeName ref="l2450">Schwyzer</placeName> die <lb xml:id="p1z2"/>mittel nitt angenommen und ein uffzügige <lb xml:id="p1z3"/>antwort gäbend, unangesähen, das die <lb xml:id="p1z4"/>4 ort <placeName ref="l41">Bern</placeName><note type="misc">gestrichen?</note>, <placeName ref="l781">Ury</placeName>, <placeName ref="l2469">Underwalden</placeName>, <placeName ref="l801">Zug</placeName> vor inen <lb xml:id="p1z5"/>gesin an der gmeind und sy vermanet ruͤwig <lb xml:id="p1z6"/>zuͦ sin etc., so habend min herren ein <lb xml:id="p1z8"/>tag gen Baden beschriben in yl, von <lb xml:id="p1z9"/>zinstag über 8 tag, 20. augusti.</s>
				</p>
				<p>
					<s n="3" xml:lang="de">Man <lb xml:id="p1z10"/>sagt, <placeName ref="l41">Bern</placeName> und <placeName ref="l2478">Saffoy</placeName> habind <lb xml:id="p1z11"/>sich vertragen und sygend eins.</s>
					<s n="4" xml:lang="de"><lb xml:id="p1z12"/>Der keyser sye gestorben uff Jacobi; <lb xml:id="p1z13"/>der türckisch keysser sye ouch todt.</s>
				</p>
				<p>
					<s n="5" xml:lang="de"><lb xml:id="p1z14"/>Der her burgermeister hat üch uß <placeName ref="l832">Franckr<lb xml:id="p1z15"/>ych</placeName> wol alles gesagt; wyters ist <lb xml:id="p1z16"/>nitt kummen.</s>
				</p>
				<p>
					<s n="6" xml:lang="de"><lb xml:id="p1z17"/>Er hat üch ouch <lb xml:id="p1z18"/>gäben <foreign xml:lang="la">Danicam et Suecam historiam <lb xml:id="p1z19"/>lugubrem</foreign>.</s>
					<s n="7" xml:lang="la">Dominus tecum.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Ora pro me.</s>
				</p>
				<p>
					<s n="9" xml:lang="de"><lb xml:id="p1z20"/>Hütt ist zuͦ mir kummen <persName>Heinrych Da<lb xml:id="p1z21"/>mür</persName> von <placeName ref="l98">Chur</placeName>, ist vor zuͦ <placeName ref="l28">Basel</placeName> xin, <lb xml:id="p1z22"/>heruff kummen von wägen des grusamen <lb xml:id="p1z23"/>sterbens daselbs; wil hie luͦgen, ob <lb xml:id="p1z24"/>er fürfuͦre mitt studieren.</s>
				</p>
				<p>
					<s n="10" xml:lang="de">Sag[t], <persName>Basti<lb xml:id="p1z25"/>an Zock</persName> wüsse umb sin sachen.</s>
					<s n="11" xml:lang="de"><lb xml:id="p1z26"/>Bitt, ir wöllindts demselben anzeigen.</s>
				</p>
				<p>
					<s n="12" xml:lang="de">In <lb xml:id="p1z27"/>yl.</s>
				</p>
				<p>
					<s n="13" xml:lang="de">Datum 11. augusti 1564.</s>
				</p>
				<p>
					<s n="14" xml:lang="de"><lb xml:id="p1z28"/><persName ref="p495">Bullinger</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae fideli ministro, <lb xml:id="p2z4"/>compatri et fratri meo charissimo.</s>
					<s n="16" xml:lang="de"><placeName ref="l98">Chur</placeName>.</s>
				</p>
