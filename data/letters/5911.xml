	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Reddidit mihi et tuas et illustris viri <lb xml:id="p1z2"/><persName ref="p2054">Martinengi</persName> literas amplissimus vir <persName>Pellizarius</persName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la" ana="salute"><lb xml:id="p1z3"/>Tu me apud <persName ref="p2054">Martinengum</persName> excusabis; alias, <lb xml:id="p1z4"/>cum plus erit ocii, scribam et agam gratias pro libro <lb xml:id="p1z5"/>Reginaldi Poli De conciliis; salutabis illum <lb xml:id="p1z6"/>humanissime.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Eius ad te exaratas, prout <lb xml:id="p1z7"/>voluisti, remitto.</s>
					<s n="5" xml:lang="la">8. octobris et <persName ref="p540">Calvinus</persName> et <lb xml:id="p1z8"/><persName ref="p8033">Beza</persName> scribunt <placeName ref="l167">Geneva</placeName>, sed nil nisi res fidelium <lb xml:id="p1z9"/>in <placeName ref="l832">Gallia</placeName> habere peroptime; regem edictis <lb xml:id="p1z10"/>adversarios valde cohercere.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Unum queruntur: <lb xml:id="p1z11"/><persName>Guysianos</persName> non desinere odia exercere <lb xml:id="p1z12"/>contra pios aliquot principes, unde metuendus <lb xml:id="p1z13"/>sit motus aliquis, si non compescantur a rege, <lb xml:id="p1z14"/>quod tamen speretur futurum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Qui <placeName ref="l361">Neroberga</placeName> <lb xml:id="p1z15"/>veniunt, nunciant <persName>Guilhelmum a Gruntbach</persName> non <lb xml:id="p1z16"/>sine favore iuniorum principum <placeName ref="l749">Saxoniae</placeName> pe<lb xml:id="p1z17"/>pulisse sedibus suis expiscopos <placeName ref="l1030">Wirzburgensem</placeName> et <placeName ref="l1703">Bam<lb xml:id="p1z18"/>bergensem</placeName> et hos <placeName ref="l361">Nerobergam</placeName> confugisse; hos militem <lb xml:id="p1z19"/>colligere.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Hoc tibi, ut audivi, refero, nil <lb xml:id="p1z20"/>affirmo; nihil ea de re certi habeo; <foreign xml:lang="de">aber der <lb xml:id="p1z21"/>tüfel macht gern allenthalben lärman etc.</foreign></s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z22"/>Vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Scio te occupatum esse cum tuis illis <lb xml:id="p1z23"/>loqutuleis <placeName ref="l875">Hispaniensibus</placeName>.</s>
					<s n="11" xml:lang="la">15. octobris 1563.</s>
					<s n="12" xml:lang="la" ana="salute"><lb xml:id="p1z24"/>Saluta amicos.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z25"/>Tuus ille.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z2"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z3"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z4"/>ecclesiae fideli ministro, <lb xml:id="p2z5"/>domino et fratri meo <lb xml:id="p2z6"/>colendissimo et charissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
