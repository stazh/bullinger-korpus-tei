	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. a domino.</s>
					<s n="2" xml:lang="la">Vocatio illius, de quo nuper tibi dixi, rata habita et confirmata est <lb xml:id="p1z2"/>a senatu <placeName ref="l41">Bernensi</placeName>.</s>
					<s n="3" xml:lang="la">Mirari satis nequeo, qui id factum; hoc solum mihi <lb xml:id="p1z3"/>polliceri habeo dominum tali pastore puniturum ingratitudinem nostrorum <lb xml:id="p1z4"/>hominum.</s>
					<s n="4" xml:lang="la">Consilium tuum sequar, hac tamen conditione, ne diutius negligas, <lb xml:id="p1z5"/>ne tunc tandem vocer, cum nullus alius vocandus sit; nolim enim me <lb xml:id="p1z6"/>quemvis in locum detrudi.</s>
					<s n="5" xml:lang="la">Tu nosti, quid hactenus tulerim, quantis in laboribus <lb xml:id="p1z7"/>fuerim, quam etiam tenuiter mihi vivendum fuerit.</s>
					<s n="6" xml:lang="la">Pares <lb xml:id="p1z8"/>iam palam inter nos video.</s>
					<s n="7" xml:lang="la">nondum pastor ille novus ad nos venit, veni<lb xml:id="p1z9"/>et autem propediem.</s>
					<s n="8" xml:lang="la">Nostri suo more pergunt, ingrati sunt prorsus.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z10"/>Ego, quod tibi placere vidi, faciem sedulo diem expectans redemptionis.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z11"/>Miseret me simplicis plebeculae, quę praecessores habet admodum clau<lb xml:id="p1z12"/>dos et caecos.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Expectabo, qualis erga me futurus sit; h<lb xml:id="p1z13"/>aud <lb xml:id="p1z15"/>dubie more suorum hominum vivet, qui ipsum vocarunt, quibus morem <lb xml:id="p1z16"/>gerere cogetur aut misere tractabitur.</s>
					<s n="12" xml:lang="la">Minantur mihi quidam <lb xml:id="p1z17"/>nescio quid mali propter aliquot conciones habitas, priusquam ad <lb xml:id="p1z18"/>vos proxime venerim, non audent tamen negotium aggredi, quia <lb xml:id="p1z19"/>plebem metuunt.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Habebo iam collegam nimis levem; ego tamen <lb xml:id="p1z20"/>ut hactenus pergam.</s>
					<s n="14" xml:lang="la">Canon apostolicus prorsus apud nos iacet; <lb xml:id="p1z21"/>non enim praeter unum atque alterum in isto invenies, idque adeo exiguum, <lb xml:id="p1z22"/>ut umbro potius esse videatur.</s>
					<s n="15" xml:lang="la">Dominus misereatur nostri.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell"><lb xml:id="p1z23"/>Vale et, quod facturum in re mea confido, fac sedulo.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z24"/><placeName ref="l2">Aarovię</placeName> 4. augusti 1549.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z25"/>Totus tuus <persName ref="p1553">Christianus <lb xml:id="p1z26"/>Hochholzer</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo et doctrina <lb xml:id="p2z2"/>et pietate viro D. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z4"/>ecclesię antistiti vigilantissimo, <lb xml:id="p2z5"/>domino suo colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>