	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Iuvenem hunc, compater in domino charissime, <lb xml:id="p1z2"/>quem scholarchę nostri ad scholam vestram <lb xml:id="p1z3"/>literis bonis et sacris instituendum mittunt, <lb xml:id="p1z4"/>ego quoque fidei et humanitati tę commendo, <lb xml:id="p1z5"/>quandoquidem illius profectus, quatenus ex <lb xml:id="p1z6"/>auditoribus meis est, et ecclesiae dei destinatur, <lb xml:id="p1z7"/>etiam mihi cordi est.</s>
					<s n="3" xml:lang="la">Scimus vestram isthic <lb xml:id="p1z8"/>diligentiam et sedulitatem, de qua nemo nostrum <lb xml:id="p1z9"/>haesitat; attamen facimus, quod nostri est <lb xml:id="p1z10"/>officii.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z11"/>Domus mea incipit per gratiam domini paululum re<lb xml:id="p1z12"/>creari post uxoris gravissimum casum et <lb xml:id="p1z13"/>fere extremam debilitationem.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Subinde visi<lb xml:id="p1z14"/>tamur a domino et castigamur, morti tamen <lb xml:id="p1z15"/>non tradimur; qui percutit, vicissim percussos <lb xml:id="p1z16"/>consolatur; cui sit gloria in sempiternum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z17"/>De concilio <placeName ref="l1107">Tridentino</placeName> scribitur ad me ab <lb xml:id="p1z18"/>amicis <placeName ref="l18">Augustanis</placeName> esse suspensum ad <lb xml:id="p1z19"/>menses aliquot; utinam laqueus ille, quo <lb xml:id="p1z20"/>suspensum est, nunquam solvatur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z21"/>De Caesare nemo ex <placeName ref="l18">Augustanis</placeName> ne verbum <lb xml:id="p1z22"/>quidem significat.</s>
					<s n="8" xml:lang="la">Principem, filium illius, <lb xml:id="p1z23"/>ferunt 19. mensis huius <placeName ref="l18">Augustam</placeName> egressum, <lb xml:id="p1z24"/>ut <placeName ref="l834">Italiam</placeName> peteret indeque in <placeName ref="l875">Hispaniam</placeName> abiret, <lb xml:id="p1z25"/>verum vix unius diei itinere confecto confestim <lb xml:id="p1z26"/><placeName ref="l18">Augustam</placeName> esse reversum.</s>
					<s n="9" xml:lang="la">Causa ignoratur; <lb xml:id="p1z27"/>divinant aliqui impeditum esse a classe <lb xml:id="p1z28"/><placeName ref="l2510">Turcica</placeName>, ne per <placeName ref="l1121">Genuam</placeName> in <placeName ref="l875">Hispaniam</placeName> traiicere <lb xml:id="p1z29"/>posset, alii nescio quo illum morbo subito <lb xml:id="p1z30"/>correptum esse dicunt.</s>
					<s n="10" xml:lang="la">De <placeName ref="l303">Magdeburgensibus</placeName> <lb xml:id="p1z31"/>nihil hic certi habemus.</s>
					<s n="11" xml:lang="la">Literas amicorum <placeName ref="l18">Augustanorum</placeName> <lb xml:id="p1z32"/><placeName ref="l586">Zurzaccum</placeName> allatas nondum accepi; cui con<lb xml:id="p1z33"/>creditae sunt, inclusit eas vasculo, quod <lb xml:id="p1z34"/>nondum est allatum.</s>
					<s n="12" xml:lang="la">Si quid ex illis novi <lb xml:id="p1z35"/>ac certi accepero, communicabo.</s>
					<s n="13" xml:lang="la" ana="farewell">Optime <lb xml:id="p1z36"/>vale, compater in domino charissime.</s>
					<s n="14" xml:lang="la" ana="salute">Salutant te ac <lb xml:id="p1z37"/>domum tuam mei omnes.</s>
					<s n="15" xml:lang="de"><foreign xml:lang="la">Filiolus tuus <persName ref="p2207">Iohannes Heinricus</persName> <lb xml:id="p1z38"/>incipiens garrire nihil adeo frequens in ore <lb xml:id="p1z39"/>habet atque</foreign> "du Schwab;" er will kein <lb xml:id="p1z40"/>Schwab seyn, schwabet die andern kinder alle.</s>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z41"/>Salutem dominis et fratribus, d. <persName ref="p8171">Theodoro Bibliandro</persName>, <persName ref="p8011">Rudolfo</persName>, <lb xml:id="p1z42"/><persName ref="p8127">Pellicano</persName> et <persName ref="p506">Butlero</persName>.</s>
					<s n="17" xml:lang="de"><placeName ref="l41">Bernę</placeName> 30. maii 1551.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z43"/><persName ref="p8417">W[olfgangus] Musculus</persName>, compater tuus <lb xml:id="p1z44"/>in domino.</s>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Celeberrimo theologo <lb xml:id="p2z2"/>m. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> ecclesię <lb xml:id="p2z4"/>pastori vigilantissimo, <lb xml:id="p2z5"/>compatri suo in <lb xml:id="p2z6"/>domino charissimo.</s>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
