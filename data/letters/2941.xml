	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, <persName ref="p495">H[enrice] Bullingere</persName> frater.</s>
					<s n="2" xml:lang="la">Quod promisi me facturum, <lb xml:id="p1z2"/>scilicet adhuc semel scripturum ad te, priusquam abirem, <lb xml:id="p1z3"/>facio.</s>
					<s n="3" xml:lang="la" ana="farewell">Vale ergo, ora pro me cum tota ecclesia.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Occasio meae profectionis est.</s>
					<s n="5" xml:lang="la">quod dux <placeName>Prussiae</placeName> dissidet <lb xml:id="p1z5"/>a maiore parte suae ipsius aulae, consiliariorum intimorum <lb xml:id="p1z6"/>dico, quare petivit a meo duce, ut me eo ableget; <lb xml:id="p1z8"/>sperat enim nescio quid a tantillo homuncione.</s>
					<s n="6" xml:lang="la">Sed et <lb xml:id="p1z9"/>alia occasio est non minoris ponderis, quae literis <lb xml:id="p1z10"/>non committetur.</s>
					<s n="7" xml:lang="la">Dux legit, quod scio, tuum librum; <lb xml:id="p1z11"/>nihil mecum nisi bona verba, cum aliis quoque.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/>Sui quoque laudant, inprimis <persName>Sebastianus Coccius</persName>, iunio<lb xml:id="p1z13"/>ris <lb xml:id="p1z14"/>principis praeceptor.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">De altero tuo libello, nem<lb xml:id="p1z15"/>pe eucharistico, aiunt moderatum esse valde, <persName ref="p540">Calvini</persName> <lb xml:id="p1z18"/>acrem nimis, <persName>Occhini</persName> urbanum.</s>
					<s n="10" xml:lang="la">Sed audi in hoc ge<lb xml:id="p1z19"/>nere reliqua.</s>
					<s n="11" xml:lang="la">Venit <persName ref="p8041">a Lasco</persName> in aulam, recta <lb xml:id="p1z20"/>ad principem, petivit se admitti conferendum <lb xml:id="p1z21"/>cum <persName ref="p458">Brentio</persName> et reliquis theologis.</s>
					<s n="12" xml:lang="la">Admissus est, <lb xml:id="p1z22"/>ferme quattuor horas disputatum summa modestia <lb xml:id="p1z23"/>utrinque.</s>
					<s n="13" xml:lang="la">Princeps excepit hominem om<lb xml:id="p1z24"/>ni clementia, mox donavit etiam non le<lb xml:id="p1z25"/>viter.</s>
					<s n="14" xml:lang="la">Sed ex disputatione fructus nullus, qui <lb xml:id="p1z26"/>quidem hactenus apparuerit.</s>
					<s n="15" xml:lang="la">Ego disputationi <lb xml:id="p1z27"/>non interfui, quia sero veneram e <placeName ref="l512">Tubinga</placeName>, sed <lb xml:id="p1z28"/>postea quibus potui officiis prosecutus illum <lb xml:id="p1z29"/>venerandissimum virum.</s>
					<s n="16" xml:lang="la">Videbo nunc rursum; nam <lb xml:id="p1z30"/>per <placeName ref="l157">Francofordiam</placeName> iter facio, inde recta ad <lb xml:id="p1z31"/><placeName>Melanthonem</placeName>, inde ad Augustum, praeterea <pb/><lb xml:id="p2z1"/>ad electorem Brandenburgensem; cum omnibus his est <lb xml:id="p2z2"/>mihi negotium.</s>
					<s n="17" xml:lang="la">Per quae loca scilicet tran<lb xml:id="p2z3"/>sivi olim cum pompa antichristiana, per <lb xml:id="p2z4"/>eadem nunc proficiscar velut in triumphum <lb xml:id="p2z5"/>ductus a Christo spectaculum futurus omnibus <lb xml:id="p2z6"/>illis populis.</s>
					<s n="18" xml:lang="la">Age gratias domino.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z7"/>Quinque sunt capti Germani ab <placeName ref="l2477">electore Palatino</placeName><lb xml:id="p2z8"/>, qui erant <placeName ref="l2510">Turcae</placeName> exploratores; confessi <lb xml:id="p2z9"/>sunt, interrogati, an plura habeant socios, <lb xml:id="p2z11"/>negant, an in <placeName ref="l834">Italia</placeName>, negant, quia, inquiunt, <lb xml:id="p2z12"/><placeName ref="l2510">Turcae</placeName> se iactant papam esse bonum ami<lb xml:id="p2z13"/>cum illorum.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z14"/>Pulchre adornatur fabula: Ex comitiis omnes prin<lb xml:id="p2z15"/>cipes protestantes volunt gravissime conqueri <lb xml:id="p2z16"/>atque expostulare cum Venetis, qui in eorum <lb xml:id="p2z17"/>republica sinant tales libros excudi (mitto <lb xml:id="p2z18"/>ad te aliquot).</s>
					<s n="21" xml:lang="la">Sunt, qui putent me <lb xml:id="p2z19"/>instigante fabulam agi; forsan ita est, <lb xml:id="p2z20"/>nec pudet.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p2z21"/>Mitto annotationes in Catalogum; lege obsecro <lb xml:id="p2z22"/>diligenter; erit, quod placebit, opnor.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p2z23"/>Iubeo optime sperare; nam <placeName ref="l2510">Turcica</placeName> causa exc<lb xml:id="p2z24"/>epta nulla vel levis suspitio (apud es, <lb xml:id="p2z25"/>qui rem intelligunt) alicuius incommodi bellici.</s>
					<s n="24" xml:lang="la"><lb xml:id="p2z26"/><persName>Fredericus</persName> totus occupatus in <placeName ref="l2721">Pannonia</placeName>, <lb xml:id="p2z27"/>imo <placeName>Austria</placeName> defendenda, Caesar iulio mense <pb/><lb xml:id="p3z1"/>est in suas <placeName ref="l875">Hispanias</placeName> migraturus; sic enim cogitur.</s>
					<s n="25" xml:lang="la"><lb xml:id="p3z2"/><persName ref="p8282">Maximilianus</persName> ad illum, priusquam e <placeName ref="l808">Belgico</placeName> abeat, <lb xml:id="p3z3"/>una cum uxore.</s>
					<s n="26" xml:lang="la"><lb xml:id="p3z4"/>Pacata, inquam, omnia per Germaniam, deo gratiae.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p3z5"/>Plura non habeo, quae scribam in <lb xml:id="p3z7"/>hac valedictione.</s>
					<s n="28" xml:lang="la">Ora tris generos tuos, <lb xml:id="p3z8"/>ut pro me rogent, imo et d. <persName ref="p8011">Rodolphum Gulterum</persName> <lb xml:id="p3z9"/>et reliquos symmistas ac fratres.</s>
					<s n="29" xml:lang="la">Vos <lb xml:id="p3z10"/>interea abrepuistis <persName ref="p8111">Martyrem</persName> <placeName ref="l2477">Palatino electori</placeName>.</s>
					<s n="30" xml:lang="la"><lb xml:id="p3z11"/>O boni viri, prosit!</s>
					<s n="31" xml:lang="la">Sed profecto magis <lb xml:id="p3z12"/>profuisset apud istum; sic sentio.</s>
					<s n="32" xml:lang="la">Scribit ad <lb xml:id="p3z13"/>me se iturum ad instaurandam scholam, si <lb xml:id="p3z14"/>accersitus fuerit; sed vix vocabitur, si scierit <lb xml:id="p3z15"/>princeps illum non permansurum apud <lb xml:id="p3z16"/>se, aut vobis non reddet, si accesserit.</s>
					<s n="33" xml:lang="la"><lb xml:id="p3z17"/>Aeternus pater domini nostri Iesu Christi augeat vobis omnibus <lb xml:id="p3z18"/>dona coelestia.</s>
				</p>
				<p>
					<s n="34" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="35" xml:lang="la"><lb xml:id="p3z19"/><placeName ref="l512">Tubingae</placeName> 5. iunii 1556.</s>
				</p>
				<p>
					<s n="36" xml:lang="la"><lb xml:id="p3z20"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse (von anderer Hand?):]</note>
					<s n="37" xml:lang="la"><pb/><lb xml:id="p4z1"/><persName ref="p495">Bullingero</persName></s>
				</p>
