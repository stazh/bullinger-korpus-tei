	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Litteras hasce meis inclusas <persName ref="p8286">Reinhartus a <lb xml:id="p1z2"/>Ratlo</persName> ante duos menses heic apud me relinquebat, <lb xml:id="p1z3"/>ut eas ad te, vir reverende, oblata occasione <lb xml:id="p1z4"/>mitterem.</s>
					<s n="3" xml:lang="la">Ego, qui amici voluntati satisfacere <lb xml:id="p1z5"/>cuperem, non multo post <placeName ref="l832">Gallo</placeName> cuidam eas dabam, <lb xml:id="p1z6"/>qui et <placeName ref="l587">Tigurum</placeName> se iturum et te conventurum <lb xml:id="p1z7"/>aiebat.</s>
					<s n="4" xml:lang="la">Verum mutato consilio <placeName ref="l167">Genevam</placeName> <lb xml:id="p1z8"/>profectus longo temporis interiecto spatio mihi <lb xml:id="p1z9"/>cum meis, quibus erant inclusae, remisit.</s>
					<s n="5" xml:lang="la">Quam <lb xml:id="p1z10"/>ob rem serius ad te illas pervenire sane doleo <lb xml:id="p1z11"/>meque hac in parte ut excusatum habeas, oro.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Epithalamia istaec poematia <persName ref="p8286">Reinhartus</persName> <lb xml:id="p1z13"/>ipse suis adiunxerat, titulum <persName ref="p17965">Nazianzeni</persName> <lb xml:id="p1z14"/>ego, qui quidem studio meo totum iam biennium <lb xml:id="p1z15"/>qua interpretationem qua veteres ad <lb xml:id="p1z16"/>libros collationem insigniter ornatus hac <lb xml:id="p1z17"/>hyeme typis chalcographicis excudetur.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z18"/>Spero illam operam viros bonos probaturos; <lb xml:id="p1z19"/>a me quidem certe magnus impensus est labor, <lb xml:id="p1z20"/>cuius me minime poenitebit, si aequa hominum <lb xml:id="p1z21"/>iudicia experiar; nam ceteroqui dolerem me <lb xml:id="p1z22"/>tam diu studium iuris civilis intermisisse, quod <lb xml:id="p1z23"/>ego iamdudum amplexus urgere non desino.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z24"/>Vale, vir clarissime, meaeque veniam audaciae <lb xml:id="p1z25"/>dato, qui ad te hactenus ignotus scribere <lb xml:id="p1z26"/>non dubitaverim.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Ante diem 3. kalendas septembres <lb xml:id="p1z27"/><placeName ref="l28">Basilea</placeName>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z28"/>Tui studiosus <lb xml:id="p1z29"/><persName ref="p8408">Ioannes Lewenkla</persName> scr<lb xml:id="p1z30"/>ipsit.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Reverendo et charissimo viro <lb xml:id="p2z2"/>d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>pastori ecclesiae <placeName ref="l587">Tigurino</placeName>, <lb xml:id="p2z4"/>domino suo colendo.</s>
				</p>
				<p>
					<note type="author">[Darunter von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="12" xml:lang="la"><lb xml:id="p2z5"/><persName ref="p8408">Ioannes Löwenklau</persName>, interpres <lb xml:id="p2z6"/><persName ref="p17965">Gregorii Nazianzeni</persName>, <lb xml:id="p2z7"/>1570.</s>
				</p>
			</div>
