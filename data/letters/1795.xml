	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Posterioribus tuis literis, compater in domino <lb xml:id="p1z2"/>charissime, adiuncta erat strena, quam <persName ref="p2207">Ioanni <lb xml:id="p1z3"/>Heinrycho</persName>, filio tuo in Christo, misisti.</s>
					<s n="3" xml:lang="la">Pro hac <lb xml:id="p1z4"/>magnas habemus tibi gratias oramusque <lb xml:id="p1z5"/>dominum, ut per prosperam valetudinem et <lb xml:id="p1z6"/>vitam diuturnam possis aliquando officium <lb xml:id="p1z7"/>fidelis compatris erga illum declarare.</s>
					<s n="4" xml:lang="la">Quod m<lb xml:id="p1z8"/>e attinet, non credis, <lb xml:id="p1z9"/>quam hac hyeme <lb xml:id="p1z10"/>senectutis incommodis praeter consuetum hactenus <lb xml:id="p1z11"/>sim attritus, a quibus paulatim ad me ipsum <lb xml:id="p1z12"/>redeo.</s>
					<s n="5" xml:lang="la">Agnosco tamen peccatum esse mea ipsius <lb xml:id="p1z13"/>negligentia; defui mihi ipsi initio hyemis, <lb xml:id="p1z14"/>cuius postea negligentię poenas dedi.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>De valetudine tua accepi ab aliis; condoleo <lb xml:id="p1z16"/>tibi, ecclesię et domui tuae.</s>
					<s n="7" xml:lang="la">Et nisi fallor, <lb xml:id="p1z17"/>quod multis cordatis et magnis viris accidit, <lb xml:id="p1z18"/>id tibi quoque usuvenit: labor irremissus <lb xml:id="p1z19"/>non corpus modo, sed et animi vires debi<lb xml:id="p1z20"/>litat et uno anno absumit, quod in <lb xml:id="p1z21"/>multos sufficere poterat, atque ita incommodat <lb xml:id="p1z22"/>non tibi tantum, sed et ecclesiae.</s>
					<s n="8" xml:lang="la">Scimus esse <lb xml:id="p1z23"/>modum in rebus; verum utut docti simus, <lb xml:id="p1z24"/>meliora scientes deteriora facimus.</s>
					<s n="9" xml:lang="la">Spero <lb xml:id="p1z25"/>tamen per gratiam domini factam esse aegritu<lb xml:id="p1z26"/>dinis ac morbi tui conversionem ac credo <lb xml:id="p1z27"/>preces fidelium isthic plurimum valere in con<lb xml:id="p1z28"/>spectu domini.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Oro dominum, ut brevi te restituat <lb xml:id="p1z29"/>ecclesiae suae.</s>
					<s n="11" xml:lang="la">Gratissimum erit, si quispiam <lb xml:id="p1z30"/>tuorum vel filiorum vel amicorum paucis de <lb xml:id="p1z31"/>spe ac statu valetudinis tuae scripserit.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z32"/>Commendo te gratię dei.</s>
					<s n="13" xml:lang="la" ana="salute">Salutem domui <lb xml:id="p1z33"/>tuę toti; salutant vos omnes uxor <lb xml:id="p1z34"/>mea et liberi.</s>
					<s n="14" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1553. 18. ianuarii.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><persName ref="p8417">W[olfga<lb xml:id="p1z35"/>ngus] Musculus</persName> tuus <lb xml:id="p1z36"/>in domino.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio theologo <lb xml:id="p2z2"/>m. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae <lb xml:id="p2z5"/>antistiti fidelissimo, <lb xml:id="p2z6"/>domino ac compatri <lb xml:id="p2z7"/>suo charissimo.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
