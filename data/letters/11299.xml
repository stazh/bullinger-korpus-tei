	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et vitae innocentiam a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Praeter meritum expostula<lb xml:id="p1z2"/>veram tecum proximis litteris<note xml:id="fn1" type="footnote" n="1">Oben <ref target="file11296">Nr. 1253</ref>, 2-7.</note> super diuturno silentio tuo, <lb xml:id="p1z3"/><persName ref="p8418">Myconi</persName> charissime.</s>
					<s n="3" xml:lang="la">Pulchre enim missis interim litteris<note xml:id="fn2" type="footnote" n="2">Oben <ref target="file11295">Nr. 1252</ref>.</note> <lb xml:id="p1z4"/>resarcisti, quod quaerebar deesse.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">De caesareanis insidiis seu <lb xml:id="p1z5"/>proditionibus<note xml:id="fn3" type="footnote" n="3">Vgl. ebd., Z. 3-21.</note> nihil dubito.</s>
					<s n="5" xml:lang="la">Dominum oro, ut virum sanguinem <lb xml:id="p1z6"/>et bella volentem<note xml:id="fn4" type="footnote" n="4">Gemeint ist Kaiser <persName ref="p18538">Karl V.</persName></note> opprimat ad gloriam nominis sui.</s>
					<s n="6" xml:lang="la">Si <lb xml:id="p1z7"/><persName ref="p8375">Anglus</persName><note xml:id="fn5" type="footnote" n="5">König <persName ref="p8375">Heinrich VIII.</persName></note> in foedus christianum receptus est<note xml:id="fn6" type="footnote" n="6">Vgl. oben <ref target="file11291">Nr. 1248</ref>, 9-11 mit Anm. 8.</note>, fac sciam.</s>
					<s n="7" xml:lang="la">Nostri <lb xml:id="p1z8"/>mercatores huius nihil retulere.</s>
					<s n="8" xml:lang="la">Illi res suas agunt.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z9"/>Nihil quaestionis aut curae illis est de religione aut <lb xml:id="p1z10"/>periculis evangelio imminentibus.</s>
					<s n="10" xml:lang="de">Ich hoff alls<note xml:id="fn7" type="footnote" ana="lex" n="7">immer.</note>, wölle <lb xml:id="p1z11"/>ye der keysser dem bapst imm arß stecken<note xml:id="fn8" type="footnote" n="8">Vgl. oben <ref target="file11295">Nr. 1252</ref>, 21 mit Anm. 11.</note>, er werde <lb xml:id="p1z12"/>ze letst drinn ersticken.</s>
					<s n="11" xml:lang="la">Quamvis perpetuo me terreat <lb xml:id="p1z13"/>nostra ingratitudo, perversitas, ambitio, luxus nimius <lb xml:id="p1z14"/>vitaque impoenitens.</s>
					<s n="12" xml:lang="la">Sed „non nobis, domine, sed nomini <lb xml:id="p1z15"/>tuo da gloriam, ne dicant gentes: Ubi est deus eorum<note xml:id="fn9" type="footnote" n="9"><cit type="bible"><ref>Ps 115, 1f (113, 9f Vulg.)</ref></cit>.</note>.“</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z16"/>Oremus hoc ardentius, quaseo, et vigilemus, quo vehementiu<lb xml:id="p1z17"/>s isti nobis malum parant.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">De <persName ref="p8394">Cellario</persName><note xml:id="fn10" type="footnote" n="10"><persName ref="p8394">Diethelm Keller</persName>; vgl. oben <ref target="file11295">Nr. 1252</ref>, 22-24.</note> nihildum <lb xml:id="p1z18"/>scriptum novi.</s>
					<s n="15" xml:lang="la">Pro tua diligentia gratias tibi ago.</s>
					<s n="16" xml:lang="la"><persName ref="p8011">Ro<lb xml:id="p1z19"/>dolphus</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p8011">Rudolf Gwalther</persName>.</note> meus non potest satis praedicare tuam beneficentiam <lb xml:id="p1z20"/>et humanitatem<note xml:id="fn12" type="footnote" n="12">Vgl. oben <ref target="file11275">Nr. 1232</ref>, 12-15.</note>.</s>
					<s n="17" xml:lang="la">Dominus sit merces tua.</s>
					<s n="18" xml:lang="la">Iuvabis <lb xml:id="p1z21"/>illum porro haud dubie, quemadmodum hactenus parentis <lb xml:id="p1z22"/>et tutoris loco fuisti.</s>
					<s n="19" xml:lang="la">Utinam reciperetur a d. <lb xml:id="p1z23"/><persName ref="p1365">Grynaeo</persName><note xml:id="fn13" type="footnote" n="13">Vgl. oben <ref target="file11295">Nr. 1252</ref>, 25-32.</note>; non quod apud te male illi prospectum sit, <lb xml:id="p1z24"/>sed quod volentem et benevolum te<note xml:id="fna" type="footnote" n="a">te <hi>über der Zeile nachgetragen.</hi></note> non gravo impudenter <lb xml:id="p1z25"/>neque onero libenter.</s>
					<s n="20" xml:lang="la"><persName ref="p1365">Grynaeus</persName> rebus ecclesiasticis minus <lb xml:id="p1z26"/>occupatus est te.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Novi apud nos nihil habemus.</s>
					<s n="22" xml:lang="la"><lb xml:id="p1z27"/>Faxit dominus, ut non infausta habeamus brevi non ab u<lb xml:id="p1z28"/>no loco.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="farewell">Vale et me ama.</s>
					<s n="24" xml:lang="la"><lb xml:id="p1z29"/>18. aprilis.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><persName ref="p8011">Ro<lb xml:id="p1z30"/>dolphum</persName>, <persName ref="p506">Buttlerum</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p506">John Butler</persName> ist der Überbringer dieses Briefs; vgl. unten <ref target="file11302">Nr. 1259</ref>, 4.</note> et <persName ref="p6192">Ryfenstein</persName> amato; nam te ex <lb xml:id="p1z31"/>animo colunt.</s>
					<s n="26" xml:lang="la"><lb xml:id="p1z32"/>Anno 1539.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p1z33"/><persName ref="p495">H. Bullingerus</persName> tuus ut semper.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="28" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p8418">Osvaldo Myconio</persName>, antistiti <lb xml:id="p2z2"/>clarissimo <placeName ref="l28">Basileiensis</placeName> ecclesiae, <lb xml:id="p2z3"/>charissimo fratri.</s>
				</p>
			</div>
