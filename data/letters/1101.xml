	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Studiosi quidam <placeName ref="l55">Bononia</placeName> venientes <lb xml:id="p1z2"/>et descendentes in <placeName ref="l749">Saxoniam</placeName> hasce <lb xml:id="p1z3"/>mihi tibi, chare frater, mature trans<lb xml:id="p1z4"/>mittendas crediderunt.</s>
					<s n="3" xml:lang="la">Ego eas pro <lb xml:id="p1z5"/>amore nostro libenter accepi, et quia nunc <lb xml:id="p1z6"/>tabellionem certum nactus sum, mitto <lb xml:id="p1z7"/><placeName ref="l41">Bernam</placeName> ad nostros.</s>
					<s n="4" xml:lang="la">Vivimus hic, ut semper, <lb xml:id="p1z8"/>in gratia Christi.</s>
					<s n="5" xml:lang="la">Non licuit plura.</s>
					<s n="6" xml:lang="la">Festinavit <lb xml:id="p1z9"/>tabellio.</s>
					<s n="7" xml:lang="la" ana="salute">Omnes te amant fratres, <lb xml:id="p1z10"/>omnes te salutant.</s>
					<s n="8" xml:lang="la" ana="salute">Vale aeternum ac d. <lb xml:id="p1z11"/><persName ref="p8299">a Burgundia</persName> me commenda.</s>
					<s n="9" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z12"/>6. decembris 1550.</s>
					<s n="10" xml:lang="la" ana="salute">Saluta fratres <lb xml:id="p1z13"/>omnes inprimis <persName ref="p966">Gallasium</persName> et <persName ref="p1049">Farellum</persName> opt[imum].</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p540">Ioanni <lb xml:id="p2z2"/>Calvino</persName> <placeName ref="l167">Genev<lb xml:id="p2z3"/>ensis</placeName> ecclesiae fido <lb xml:id="p2z4"/>pastori domino suo observ<lb xml:id="p2z5"/>ando et fratri long<lb xml:id="p2z6"/>e charissimo et incom<lb xml:id="p2z7"/>parabili.</s>
				</p>
			</div>
		</body>
	</text>
