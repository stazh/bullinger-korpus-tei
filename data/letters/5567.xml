	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Diu quidem excruciavit me fama incerta <lb xml:id="p1z2"/>de capto <placeName ref="l2771">Rothomago</placeName>, quam tamen nimis veram esse <lb xml:id="p1z3"/>timebam, quod felicia fere semper vana, infelicia <lb xml:id="p1z4"/>certa esse soleant.</s>
					<s n="3" xml:lang="la">Nunc vero tantum me non conficit <lb xml:id="p1z5"/>vera et crudelis illa narratio de truculentia <lb xml:id="p1z6"/>plusquam <persName>Scythica</persName> in occupato <placeName ref="l2771">Rothomago</placeName> ex<lb xml:id="p1z7"/>ercita et de optimo fratre nostro <persName ref="p7988">Marlorato</persName> ad foras <lb xml:id="p1z8"/>templi suspenso.</s>
					<s n="4" xml:lang="la">O domine, usque quo?</s>
					<s n="5" xml:lang="la">Nunc nova <lb xml:id="p1z9"/>nos fama misere exercet; audimus enim <persName ref="p8315">Condensem</persName> <lb xml:id="p1z10"/>credere <persName>Guysianorum</persName> blanditiis pacem offerenti<lb xml:id="p1z11"/>bus, cum prudentissimi quique hoc tendere <lb xml:id="p1z12"/>existiment ad interitum optimi principis <persName ref="p8315">Condensis</persName> <lb xml:id="p1z13"/>et ad perniciem omnium per <placeName ref="l832">Galliam</placeName> fidelium.</s>
					<s n="6" xml:lang="la">Dominum <lb xml:id="p1z14"/>oro, ut dirigat <persName ref="p8315">Condensem</persName> et servet a malo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Heri sparsus est rumor de pugna, in qua nostri <lb xml:id="p1z16"/>vicerint; mox diversum affirmatur.</s>
					<s n="8" xml:lang="la">Domino re<lb xml:id="p1z17"/>m committere cogor.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Ego pro iis, quae scripsisti <lb xml:id="p1z18"/>per <persName ref="p1918">Linerum</persName>, maximas ago gratias et oro te imprimis, <lb xml:id="p1z19"/>deinde <persName ref="p8078">Ionvilleum</persName> nostrum, ne unquam scribere <lb xml:id="p1z20"/>desinatis.</s>
					<s n="10" xml:lang="la">Vix creditis, quantopere vestras literas <lb xml:id="p1z21"/>desideremus et cum animi gratitudine accipiamus.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z22"/>Non admodum firma nunc sum valetudine; at<lb xml:id="p1z23"/>tamen diu et multum perquisivi, quid habeam <lb xml:id="p1z24"/>rerum tuarum; nam nihil perinde<note type="misc">pereinde!</note> vellem, <lb xml:id="p1z25"/>quam ut aliquid reponder[e]s<note type="misc">responders!</note> <persName ref="p3018">Stancaro</persName>.</s>
					<s n="12" xml:lang="la">Sed <lb xml:id="p1z26"/>fatigatus diligenti perquisitione nihil aliud <lb xml:id="p1z27"/>inveni, quam quod in praesenti mitto.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Oro autem, <lb xml:id="p1z28"/>ut remittas; nam tua mihi communicata dudum <lb xml:id="p1z29"/>remisi<note type="misc">remissi!</note>; tunc haec excribenda curavi.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z30"/>Alia non habeo nec scio, quod unquam quicquam de <persName ref="p3018">St<lb xml:id="p1z31"/>ancari</persName> rebus aliquid ad me miseris.</s>
					<s n="15" xml:lang="la">24. <lb xml:id="p1z32"/>novembris electus est in regem <persName>Romanorum Maximilianus</persName>, <lb xml:id="p1z33"/>coronatus 29. eiusdem.</s>
					<s n="16" xml:lang="la">Missa dicitur eo le<lb xml:id="p1z34"/>gatio <placeName ref="l2510">Turcica</placeName>, quae iactat <placeName ref="l2510">Turcarum</placeName> imperatorem <lb xml:id="p1z35"/>auxilia laturum contra rebelles <placeName ref="l832">Galliae</placeName>.</s>
					<s n="17" xml:lang="la">Ego mihi <lb xml:id="p1z36"/>persuadeo illa conflata esse arte pontificis, imperatoris, <lb xml:id="p1z37"/><placeName ref="l150">Ferrariensis</placeName> et <placeName ref="l691">Lotharingii</placeName>.</s>
					<s n="18" xml:lang="la">Dominus dissipet con<lb xml:id="p1z38"/>silia impiorum et servet invocantes nomen <lb xml:id="p1z39"/>eius.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="farewell">Vale una cum <persName ref="p8078">Ionvilleo</persName> et bonis omnibus.</s>
					<s n="20" xml:lang="la" ana="salute"><lb xml:id="p1z40"/>Omnes nostri te salutant; saluta etiam <lb xml:id="p1z41"/>fratres et symmystas omnes.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 31. decembris 1562.</s>
					<s n="22" xml:lang="la"><lb xml:id="p1z42"/>Non relegi.</s>
					<s n="23" xml:lang="la" ana="salute">Salvus sit <persName ref="p8511">Trecius</persName> <placeName ref="l2472">Polonus</placeName>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z43"/>Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse vor 441:]</note>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro d. <persName ref="p540">Ioanni <lb xml:id="p4z2"/>Calvino</persName>, <placeName ref="l167">Genevensis</placeName> <lb xml:id="p4z3"/>ecclesiae fideli pastori, dom<lb xml:id="p4z4"/>ino colendo et fratri <lb xml:id="p4z5"/>charissimo suo.</s>
					<s n="26" xml:lang="de"><lb xml:id="p4z6"/><placeName ref="l167">Genff</placeName>.</s>
				</p>
			</div>
