	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Etsi, quod ad te scribam, vir clarissime, nihil fere nunc occurrit, <lb xml:id="p1z2"/>quum tamen istuc mihi scribendum esset, quod tibi non ingratum <lb xml:id="p1z3"/>esse testatus es officium prętermittere nolui.</s>
					<s n="3" xml:lang="la">Et quoniam aliud non <lb xml:id="p1z4"/>habeo, quod literis meis significem, tibi gratias ago pro tuis illis, quas <lb xml:id="p1z5"/>huc reversus accepi et quibus singularem tuam erga me benevolentiam <lb xml:id="p1z6"/>rursum ita declaras, ut me tibi longe devinctiorem esse profitear.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/><persName>Cristpino</persName> nostro, quod volebas, significavi; sed se suaque omnia optimo <lb xml:id="p1z8"/>iure tua esse respondit.</s>
					<s n="5" xml:lang="la" ana="salute">Ille te plurimum salutat.</s>
					<s n="6" xml:lang="la">Iam si quid hic <lb xml:id="p1z9"/>esset, quod tuo nomine possemus lubentissime omnes praestaremus.</s>
					<s n="7" xml:lang="la" ana="salute"><lb xml:id="p1z10"/><persName ref="p4440">Budaeus</persName>, frater mihi charissimus, et <persName>Iacobus</persName>, qui mecum erat, quum vos primum <lb xml:id="p1z11"/>invisi, reverenter te salutant.</s>
					<s n="8" xml:lang="la">Ego vero tibi pacem perpetuam a <lb xml:id="p1z12"/>domino precor ac rogo, ut spiritu suo semper te regat tuosque labores <lb xml:id="p1z13"/>benedicat.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Vale, vir ornatissime et mihi imprimis colende.</s>
					<s n="10" xml:lang="la"><placeName ref="l167">Genevae</placeName> 13. <lb xml:id="p1z14"/>kalendas ianuarii 1556.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z15"/><persName ref="p8078">Carolus Ionvillaeus</persName>, tui studiosissimus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo atque clarissimo <lb xml:id="p2z2"/>viro d. <persName ref="p495">Henrico Bulingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z4"/>fidelissimo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
