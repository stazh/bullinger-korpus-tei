	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Magno cum dolore literas tuas legi, vir <lb xml:id="p1z2"/>amplissime, cum intelligerem te infirmiorem e<lb xml:id="p1z3"/>sse.</s>
					<s n="3" xml:lang="la">Sed mirum non esset, si penitus exhaurirere, <lb xml:id="p1z4"/>cum instar amplissimi et ditissimi sis lacus, <lb xml:id="p1z5"/>ad quem omnes undique ad hauriendum accurrunt.</s>
					<s n="4" xml:lang="la" ana="salute"><lb xml:id="p1z6"/>D. Iesus te fulciat et quam diutissime in nominis sui <lb xml:id="p1z7"/>gloriam et nostram salutem incolumem et salvum <lb xml:id="p1z8"/>conservet.</s>
					<s n="5" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Causa episcopalis me nihil attinet; <lb xml:id="p1z9"/>ago tamen ingentes gratias, qui me paterne mones <lb xml:id="p1z10"/>quique certius exploratum habeas, quid damni hinc <lb xml:id="p1z11"/>inde mihi esset, si me odiose ingererem.</s>
					<s n="7" xml:lang="la">Paci nunquam <lb xml:id="p1z12"/>deero, quantum per verbum dei licebit, maxime hoc tempore <lb xml:id="p1z13"/>exulcerato, quo simul una pariter pacem almam poscere <lb xml:id="p1z14"/>debemus omnes.</s>
					<s n="8" xml:lang="la">Certum est d. <persName>Bartolomaeum a Salicibus</persName> <lb xml:id="p1z15"/><placeName>Romam</placeName> esse profectum movendi gratia turbas novas.</s>
					<s n="9" xml:lang="la">- <lb xml:id="p1z16"/>Ex minoribus prophetis (ut suades prudentissime), quem <lb xml:id="p1z17"/>mihi eligam, videbo et postea de auxilio mihi dispiciam.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Ago gratias mille pro benevolentia ista voluntaria.</s>
					<s n="11" xml:lang="la">- Ex <lb xml:id="p1z19"/><placeName ref="l834">Italia</placeName> nunciatur regem in Italis suis incomparabilem <lb xml:id="p1z20"/>cladem accepisse a <persName>Condaeis</persName>.</s>
					<s n="12" xml:lang="la">Referunt aliquot mille <lb xml:id="p1z21"/>periisse; id ipsum pfaffi quoque nostri mussitant et <lb xml:id="p1z22"/>Galli <placeName ref="l648">Rhaeti</placeName>.</s>
					<s n="13" xml:lang="la">- Pro certo hodie mihi dictum est episcopum <lb xml:id="p1z23"/>nostrum conscribere et convocare concilium nationale <lb xml:id="p1z24"/>in Veldkirch, ubi omnes iurati sui confluant, ubi etiam <lb xml:id="p1z25"/>comes Han[n]ibal ab <placeName>Ems</placeName> sit futurus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Quid illis <lb xml:id="p1z26"/>deliberandum sit hoc tempore, suo id tempore <lb xml:id="p1z27"/>publicabitur.</s>
					<s n="15" xml:lang="la">Ex <placeName ref="l834">Italia</placeName> praeterea nihil; pauci enim <lb xml:id="p1z28"/>propter coeli intemperiem et inclementiam iter <lb xml:id="p1z29"/>facere potuerunt.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell">Hisce vale, mundi totius <lb xml:id="p1z30"/>lumen maximum.</s>
					<s n="17" xml:lang="la" ana="salute">Te salutant omnes, consules, d. <persName ref="p6130">Pontisella</persName>, d. <persName ref="p20473">G[an<lb xml:id="p1z31"/>tnerus]</persName>, d. <persName ref="p1770">Carolus</persName> et d. denique <persName ref="p8186">Bonettus</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l98">Curiae</placeName> <lb xml:id="p1z32"/>ocyssime 1568. 8. martii.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z33"/>Tuae excellentiae sub<lb xml:id="p1z34"/>iectissimus <persName ref="p8016">Th[obias] Eg[lius]</persName>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">D. <persName ref="p8057">Campello</persName> scripsi; <lb xml:id="p1z35"/>vidi libellum, vidit et d. <persName ref="p4037">Zanchus</persName>.</s>
					<s n="21" xml:lang="la">Sed quid <lb xml:id="p1z36"/>Ingadinus ille post tot tantorumque virorum eruditissimos de s[anctae] <lb xml:id="p1z37"/>scripturae autoritate lucubrationes furtum istud <lb xml:id="p1z39"/>suum foras dare tentat?</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Hennrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae parocho ce<lb xml:id="p2z5"/>leberrimo, d. <lb xml:id="p2z6"/>suo aeternum <lb xml:id="p2z7"/>honorando.</s>
				</p>
			</div>
		</body>
