	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto rursum 2 terniones, x et y. Quae ad <lb xml:id="p1z2"/>nos misisti, baleo dedi, qui magno certe <lb xml:id="p1z3"/>cum gaudio literas quoque tuas et munus libri ad <lb xml:id="p1z4"/>se missi excepit, et quia ipsi iam rescribere <lb xml:id="p1z5"/>propter occupationum, quibus in opere suo quasi ad <lb xml:id="p1z6"/>praelum absolvendo tantum non obruitur, molem non <lb xml:id="p1z7"/>vacabat, me exoravit, ut ipsius nomine et gratias <lb xml:id="p1z8"/>agerem et, quod in praesentia non rescriberet, excusarem<lb xml:id="p1z9"/>.</s>
					<s n="3" xml:lang="la">Cupit idem etiam impetrari sibi tua opera <lb xml:id="p1z10"/>a d. <persName ref="p8111">Petro Martyre</persName> sive d. <persName ref="p2336">Bernardino</persName> sive <lb xml:id="p1z11"/>etiam utroque potius, si quid de postremis pontificibus <lb xml:id="p1z12"/>aliquot, ut <persName ref="p4532">Marcello II.</persName>, <persName ref="p19981">Paulo III.</persName> et eo, <lb xml:id="p1z13"/>qui nunc antichristi vices agit, certi atque explorati <lb xml:id="p1z14"/>habeant, quo et illa suo de pontificibus catalogo <lb xml:id="p1z15"/>inserere possit, quem alioqui iam ad umbilicum <lb xml:id="p1z16"/>perduxit.</s>
					<s n="4" xml:lang="la">Communicavit ei <persName ref="p3375">Vergerius</persName> quędam, sed <lb xml:id="p1z17"/>de <persName ref="p4532">Marcello II.</persName> tantum.</s>
					<s n="5" xml:lang="la">Facies itaque operę precium, <lb xml:id="p1z18"/>si hac etiam parte optimum senem iuveris, et ego libenter <lb xml:id="p1z19"/>monstris illis suis, quod aiunt, coloribus depingendis <lb xml:id="p1z20"/>et operam et oleum impendam.</s>
					<s n="6" xml:lang="la">Literas ad <persName ref="p8124">Naogeorgum</persName> <lb xml:id="p1z21"/>adhuc habeo neque video (quod per certum tabellarium mitti <lb xml:id="p1z22"/>cupis), quomodo cito mitti possint; raros enim <lb xml:id="p1z24"/>habemus stuggardiam recta proficiscentes tabellarios.</s>
					<s n="7" xml:lang="la">Alioqui <lb xml:id="p1z25"/>per <placeName ref="l491">Argentinensem</placeName> mercatum curari iam potuissent.</s>
					<s n="8" xml:lang="la">Idem <lb xml:id="p1z26"/>impedit, ut et literas ad Cognatum nondum miserim, <lb xml:id="p1z27"/>a quo tamen brevi certum tabellarium expecto; tum <lb xml:id="p1z28"/>et illas curabo.</s>
					<s n="9" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Resalutant te amici omnes.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z29"/><placeName ref="l28">Basileae</placeName> 16. iulii 1557.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><persName ref="p8126">Ioan[nes] Oporinus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesia<lb xml:id="p2z3"/>stae <placeName ref="l587">Tigurino</placeName>, <lb xml:id="p2z4"/>domino et <lb xml:id="p2z5"/>amico suo in <lb xml:id="p2z6"/>primis observando.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
