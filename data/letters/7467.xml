	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><persName>Daniel Schram</persName>, <persName>Silesius</persName>, qui hasce tibi offert <lb xml:id="p1z2"/>literas, commendatus est mihi literis d. <persName ref="p8033">Bezae</persName> et magistri <lb xml:id="p1z3"/>aulae <persName ref="p8060">principis Palatini</persName> qui <placeName ref="l167">Genevae</placeName> agit.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Excepimus eum hic, qua potuimus humanitate, ac <lb xml:id="p1z5"/>ex colloquio deprehendimus iuvenem esse egregium <lb xml:id="p1z6"/>et honore dignum.</s>
					<s n="4" xml:lang="la">Proficiscitur in <placeName ref="l834">Italiam</placeName> gratia <lb xml:id="p1z7"/>studiorum; incumbit iurisprudentiae.</s>
					<s n="5" xml:lang="la">Rogatum <lb xml:id="p1z8"/>autem te volo, ut illum commendes etiam meo nomine <lb xml:id="p1z9"/>illis apud vos praeclaris viris, qui ipsum poterunt <lb xml:id="p1z10"/>iuvare in suo itinere vel commendationibus <lb xml:id="p1z11"/>ad amicos in <placeName ref="l834">Italia</placeName> scriptis vel in commonstrando <lb xml:id="p1z12"/>itinere et profectione commoda.</s>
					<s n="6" xml:lang="la">Non addam <lb xml:id="p1z13"/>his plura; scio enim te tua sponte currere nec opus e<lb xml:id="p1z14"/>sse calcaribus.</s>
					<s n="7" xml:lang="la">P<lb xml:id="p1z15"/>oterit is vobis <lb xml:id="p1z16"/>de rebus <placeName ref="l832">Galliae</placeName> varia exponere.</s>
					<s n="8" xml:lang="la"><persName ref="p8033">Beza</persName> nihil a<lb xml:id="p1z17"/>liud scribit per hunc quam turbulentas esse ad<lb xml:id="p1z18"/>huc in <placeName ref="l832">Gallia</placeName> res, quod sint, qui pacem nolint, <lb xml:id="p1z19"/>quos in ordinem cogat rex, ac spem esse pacis <lb xml:id="p1z20"/>solidae; omnem vero belli tempestatem in <placeName ref="l808">Belgium</placeName> <lb xml:id="p1z21"/>certo incubituram.</s>
					<s n="9" xml:lang="la">Dominus etiam his <lb xml:id="p1z22"/>adsit et nos omnes servet!</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Vale tu quoque cum domo <lb xml:id="p1z23"/>tua et amicis nostris omnibus, quos ordine et <lb xml:id="p1z24"/>nominatim salutabis omnes et singulos.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z25"/><placeName ref="l587">Tiguri</placeName> 25. maii 1568.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note>[Darunter von anderer Hand (nicht Eglis?):]</note>
					<s n="13" xml:lang="la">"<lb xml:id="p1z27"/><persName ref="p7458">Comes ab Egmont</persName> in uxorem habet <lb xml:id="p1z28"/>filiam sororis <persName ref="p8060">Palatini <lb xml:id="p1z29"/>principis</persName>, unde auxilia etc.?"</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <persName ref="p8016">Tobiae <lb xml:id="p2z2"/>Eglio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>fideli ministro, domino <lb xml:id="p2z4"/>meo honorando et fratri <lb xml:id="p2z5"/>charissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Chur.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>