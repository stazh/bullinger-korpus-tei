	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Gratum mihi fuit, ex tuis literis<note xml:id="fn7" type="footnote" n="7">Nicht erhalten.</note> cognoscere tibi redditas esse <lb xml:id="p1z2"/>fideliter epistolas, de quibus nihil certi intellexeram; gratius quod <persName ref="p1560">Anglum</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p1560">John Hooper</persName>.</note> <lb xml:id="p1z3"/>cum <persName ref="p8473">uxore</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p8473">Anna de Tserclas</persName>.</note> acceperis peramanter<note xml:id="fn10" type="footnote" n="10">am 29. März (<bibl source="b288">HBD</bibl> 35, 5-7).</note>, ut illi suis ad me literis<note xml:id="fn11" type="footnote" n="11">Nicht erhalten.</note> testantur.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="3" xml:lang="la">Nunc <lb xml:id="p1z4"/>vero conferes cum domino <persName ref="p3240">Theodosio</persName><note xml:id="fn12" type="footnote" n="12"><persName ref="p3240">Teodosio Trebellio</persName>.</note>, homine erudito et verae religionis perstudioso, <lb xml:id="p1z5"/>qui ut caeteri omnes boni te propter doctrinam ac pietatem valde amat et, cum <lb xml:id="p1z6"/>sibi nunc esset iter in <placeName ref="l834">Italiam</placeName> constitutum, voluit <placeName ref="l587">Tigurum</placeName> venire, ut te conveniret <lb xml:id="p1z7"/>et tecum de communibus negotiis cum reipublicae tum vero religionis conferret.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Non dubito, quin eius colloquium tibi erit futurum valde gratum ut hominis <lb xml:id="p1z9"/>intelligentis et rectae sententiae.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="5" xml:lang="la">Novi quid scribam, nescio.</s>
					<s n="6" xml:lang="la">De morte <lb xml:id="p1z10"/><persName ref="p20225">regis Galliae</persName><note xml:id="fn13" type="footnote" ana="bio" n="13"><persName ref="p20225">Franz I.</persName> starb am 31. März 1547.</note> iamdudum vos accepisse arbitror.</s>
					<s n="7" xml:lang="la">Hac hora mihi annunciavit <lb xml:id="p1z11"/>dominus <persName ref="p8299">Fallesius</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p8299">Jacques de Bourgogne, sieur de Falais</persName>.</note> <persName ref="p18538">imperatorem</persName><note xml:id="fn15" type="footnote" n="15"><persName ref="p18538">Karl V.</persName></note> esse propediem venturum <placeName ref="l491">Argentinam</placeName>, ut ex <lb xml:id="p1z12"/>eadem civitate scribitur.</s>
					<s n="8" xml:lang="la">Quid moliatur istud latebrosum pectus, non satis <lb xml:id="p1z13"/>assequor.</s>
					<s n="9" xml:lang="la">Reliqua a domino <persName ref="p3240">Theodosio</persName> cognosces.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="10" xml:lang="la">Adolescentibus studiosis<note xml:id="fn16" type="footnote" n="16">Siehe <persName ref="p495">Bullinger</persName> an <persName ref="p8418">Myconius</persName>, 4. April.</note>, <lb xml:id="p1z14"/>qui mihi tuas literas attulerunt, obtuli officiose meam operam neque ulla in re sum <lb xml:id="p1z15"/>illis defuturus, quam arbitrabor ad eorum utilitatem pertinere.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="11" xml:lang="la" ana="salute">Salutabis meis <lb xml:id="p1z16"/>verbis omnes fratres, dominum patrem <persName ref="p8127">Pellicanum</persName>, dominum <persName ref="p8171">Theodorum</persName><note xml:id="fn17" type="footnote" n="17"><persName ref="p8171">Theodor Bibliander</persName>.</note>, <persName ref="p8011">Gvalterum</persName>, <lb xml:id="p1z17"/>doctorem <persName ref="p1283">Gesnerum</persName>, <persName ref="p1214">Frisium</persName><note xml:id="fn18" type="footnote" n="18"><persName ref="p1214">Johannes Fries</persName>, der seit der zweiten Hälfte des Jahres 1546 Lehrer an der Großmünsterschule war; s. <bibl source="b22">HBBW XIX</bibl> 173, Anm. 18.</note> et reliquos.</s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="12" xml:lang="la">Consulto nolui hactenus interpellare <lb xml:id="p1z18"/>dominum <persName ref="p8171">Theodorum</persName>, quem sciebam gravioribus negotiis occupatum, quam ut vacaret <lb xml:id="p1z19"/>legere inanes literas, et quia nihil ab eo certi intelligo, arbitror adhuc eum in hoc totum <lb xml:id="p1z20"/>esse, ut perficiat id, quod, cum ego isthic essem, instituerat.</s>
					<s n="13" xml:lang="la">Utinam iam esset <lb xml:id="p1z21"/>hoc labore perfunctus et se totum ad intermissum opus conferret.</s>
					<s n="14" xml:lang="la">Sciat sibi rem <lb xml:id="p1z22"/>esse cum difficili creditore, qui ultra tempus praescriptum non prorogabit debitum <lb xml:id="p1z23"/>et crimen intendet violatae fidei, nisi promissum praestabit.</s>
				</p>
			</div>
			<div xml:id="div7" corresp="regest7">
				<p>
					<s n="15" xml:lang="la" ana="farewell">Bene vale cum tota <lb xml:id="p1z24"/>ecclesia et, si quid habes, communica.</s>
				</p>
			</div>
			<div xml:id="div8" corresp="regest8">
				<p>
					<s n="16" xml:lang="la"><placeName ref="l28">Basileae</placeName>, 10. Aprilis 1547.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Tuus <persName ref="p8032">Franciscus Dryander</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z25"/>Adfuissem libenter vobis in hoc festo <lb xml:id="p1z26"/>pasc<lb xml:id="p1z27"/>hatis<note xml:id="fn19" type="footnote" n="19">10. April.</note>, si licuisset; sed quod iam <lb xml:id="p1z28"/>facere non potui, praestabo deo volente in festo penthecostes<note xml:id="fn20" type="footnote" n="20">29. Mai 1547.</note></s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>.</s>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
