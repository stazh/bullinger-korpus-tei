	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Nos hic toto hoc anno, vir ornatissime, labo<lb xml:id="p1z2"/>ravimus vertendo Novum Testamentum Christi domini in <lb xml:id="p1z3"/>eiusmodi linguam, quę toti <placeName ref="l20">Inferiori Germanię</placeName> usui <lb xml:id="p1z4"/>esse possit, idque ad exemplar <persName ref="p8102">Roberti Stephani</persName> anno 1550 <lb xml:id="p1z5"/><placeName ref="l378">Lutecię</placeName> magna forma excusum.</s>
					<s n="3" xml:lang="la">Postquam vero opera <lb xml:id="p1z6"/><persName>Godfredi Wingii</persName>, qui mecum vivit, adiutus nostram <lb xml:id="p1z7"/>versionem absolvissem, contulimus eam cum nostro <lb xml:id="p1z8"/><persName ref="p8415">Micronio</persName> ac etiamnum <persName>P. Delęno</persName>, ministris nostrę <lb xml:id="p1z9"/><placeName ref="l822">Germanicę</placeName> <placeName ref="l296">Londinensis</placeName> ecclesię nunc dissipatę ad illud <lb xml:id="p1z10"/>ipsum aphtographon adhibitis interim aliis Gręcis ex<lb xml:id="p1z11"/>emplaribus variisque Latinis ac nonnullis <placeName ref="l822">Germanicis</placeName>, <lb xml:id="p1z12"/><placeName ref="l862">Helveticis</placeName>, <placeName ref="l749">Saxonicis</placeName>, <placeName ref="l2529">Brabanticis</placeName>, <placeName ref="l832">Gallicis</placeName>, <placeName ref="l830">Anglicisque</placeName> <lb xml:id="p1z13"/>versionibus.</s>
					<s n="4" xml:lang="la">Nos enim, quia ignoratorum <lb xml:id="p1z14"/>authorum labores obnoxii fere esse solent suspicionibus, <lb xml:id="p1z15"/>volumus nostram/um?</s>
					<s n="5" xml:lang="la">evulgare sub nomine illius <lb xml:id="p1z16"/>ecclesię ac etiam domini <persName ref="p8041">a Lasco</persName>, qui suas iam nunc <lb xml:id="p1z17"/>observationes in meum Testamentum ad me misit.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z18"/>Atqui hinc factum magna ex parte, ut amicis meis, ne <lb xml:id="p1z19"/>colendissimis quidem, licuerit interea operam scribendo <lb xml:id="p1z20"/>dare.</s>
					<s n="7" xml:lang="la">Itaque te rogo ex animo, ut non ęgre feras meum <lb xml:id="p1z21"/>hoc diuturnum silentium.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Scripsit nunc nobis d. <lb xml:id="p1z22"/><persName ref="p8041">a Lasco</persName>, d. <persName ref="p540">Calvinum</persName> non ita pridem accepisse <lb xml:id="p1z23"/>literas vere benevolas a <persName ref="p1825">Sigismundo</persName> rege <placeName ref="l2472">Poloniae</placeName>, <lb xml:id="p1z24"/>quo nomine admodum sumus exhilarati, existimantes <lb xml:id="p1z25"/>verosimiliter, eum bonamque Poloniae partem a doctrina <lb xml:id="p1z26"/><persName ref="p540">Calvini</persName> non abhorrere, id quod nobis hic aliunde <lb xml:id="p1z27"/>etiam non semel est significatum.</s>
					<s n="9" xml:lang="la">Faxit dominus <lb xml:id="p1z28"/>ut regnum illud a tyrannide Satanae papisticaque <lb xml:id="p1z29"/>impietate tandem liberetur, sinceraque religione imbuatur, <pb/><lb xml:id="p2z1"/>ne ulo modo fanatica illa lue <persName>Lutheranorum</persName> inficiatur <lb xml:id="p2z2"/>qui non minus infensi infestique sunt nobis, quam summis <lb xml:id="p2z3"/>papistis ac Anabaptistis ipsis, ne dicam magis.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z4"/>Admonui nunc <persName ref="p540">Calvinum</persName> dum de re sacramentaria <lb xml:id="p2z5"/>scribit, ab obscurioribus loquendi formulis abstineret <lb xml:id="p2z6"/>propter rationes varias, quas non est operae pretium apud <lb xml:id="p2z7"/>te recensere, et te rogo, quanto possum studio, ut et <lb xml:id="p2z8"/>tu et d. <persName ref="p8171">Bibliander</persName> eum huius etiam admoneatis.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z9"/>Quantum enim periculi in illis loquendi formulis sit <lb xml:id="p2z10"/>situm, ipsi me multo melius nostis.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Possem quidem <lb xml:id="p2z11"/>pluribus tecum nunc agere, si non existimarem nostrum <persName ref="p8415">Mi<lb xml:id="p2z12"/>cronium</persName> fusius de omnibus rebus, quę hic geruntur, ad te <lb xml:id="p2z13"/>perscribere.</s>
					<s n="13" xml:lang="la">Quare supersedeo ac finem nunc faciam.</s>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p2z14"/>Salutat te <persName>Godfredus Wingius</persName>, tametsi de facie tibi <lb xml:id="p2z15"/>ignotus.</s>
					<s n="15" xml:lang="la" ana="salute">Saluta mihi, quaeso, d. <persName ref="p8171">Bibliandrum</persName>, d. <persName ref="p8127">Pellica<lb xml:id="p2z16"/>num</persName>, d. <persName ref="p8011">Gualterum</persName>, <persName ref="p7228">H. Zvinglium</persName> ac <persName ref="p3988">Ioannem Wolfium</persName> perofficiose; d. <persName ref="p1283">Guesnerum</persName> mihi quoque <lb xml:id="p2z17"/>peramanter saluta.</s>
					<s n="16" xml:lang="la" ana="farewell">Vale, vir ornatissime, in Christo domino, <lb xml:id="p2z18"/>cui ego te tuumque ministerium, ut illud fructuosum <lb xml:id="p2z19"/>reddat, commendo ex animo.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l351">Nordę</placeName> <placeName ref="l734">Phrysiorum</placeName> 1556. <lb xml:id="p2z20"/>9. martii.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z21"/>Tuus ut suus <persName ref="p8061">Ioannes Utenhovius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro domino <lb xml:id="p4z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p4z3"/>pstori ecclesię <placeName ref="l587">Tigurinorum</placeName> <lb xml:id="p4z4"/>vigilantissimo, amico ac fratri <lb xml:id="p4z5"/>vere observando.</s>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
