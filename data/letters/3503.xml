	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil prorsus nunc habeo nisi <lb xml:id="p1z2"/>hoc unum: oro te, ut diligenter curas <lb xml:id="p1z3"/>has literas urgeasque, ut nobis respondea(tur).</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Consanguinea illa nostra exponit nobis se <lb xml:id="p1z5"/>fraudatam esse sua facultate et paupertate.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Eam rem si ita habere intellexerimus, <lb xml:id="p1z7"/>iure agetur cum illis, qui iniuria ipsam <lb xml:id="p1z8"/>miseram affecere.</s>
					<s n="5" xml:lang="la">Scribe per proximum <lb xml:id="p1z9"/>tabellionem.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale cum omnibus piis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z10"/>11. februarii anno 1558.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantis<lb xml:id="p2z2"/>simo viro <lb xml:id="p2z3"/>d. <persName ref="p8009">Ioanni <lb xml:id="p2z4"/>Fabritio</persName>, <lb xml:id="p2z5"/><placeName ref="l98">Curiens<lb xml:id="p2z6"/>is</placeName> ec<lb xml:id="p2z7"/>clesiae min<lb xml:id="p2z8"/>i<lb xml:id="p2z9"/>str<lb xml:id="p2z10"/>o, <lb xml:id="p2z11"/>domino <lb xml:id="p2z12"/>et com<lb xml:id="p2z13"/>patr<lb xml:id="p2z14"/>i meo <lb xml:id="p2z15"/>colen<lb xml:id="p2z16"/>dis<lb xml:id="p2z17"/>simo <lb xml:id="p2z18"/>et chariss<lb xml:id="p2z19"/>i<lb xml:id="p2z20"/>mo.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z22"/><placeName ref="l98">Ch<lb xml:id="p2z23"/>ur</placeName><lb xml:id="p2z25"/>.</s>
				</p>
			</div>
		</body>
	</text>
