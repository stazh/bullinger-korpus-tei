	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi tuas per nepotem meum et gratias ago, quod <lb xml:id="p1z2"/>de <placeName ref="l2478">Sabaudico</placeName> negocio me reddideris certiorem plenius; <lb xml:id="p1z3"/>suspectum et mihi fuit, quod agitur, nec tamen satis perspicie<lb xml:id="p1z4"/>bam, cum hac methodo dux rem esset exorsus.</s>
					<s n="3" xml:lang="la">Responsum idem <lb xml:id="p1z5"/>a nostris tulerunt, quod et a vestris, legati.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Dominus <lb xml:id="p1z6"/>aperiat oculos Confoederatis, ne quid in perniciem patriae statuant <lb xml:id="p1z7"/>et motibus intestinis ne qua aperiatur fenestra.</s>
					<s n="5" xml:lang="la">Commeruimus (scio) <lb xml:id="p1z8"/>graviora; sed non desinamus tamen misericordiam domini invocare et vigi<lb xml:id="p1z9"/>lare.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ex <placeName ref="l832">Gallia</placeName> prorsus nihil accipimus, sed nec <lb xml:id="p1z10"/>e<lb xml:id="p1z11"/>x <placeName ref="l822">Germania</placeName>; expecto tamen ex <placeName ref="l157">Francfurtensi</placeName> mercatu literas <lb xml:id="p1z12"/>amicorum, unde et ad te perventuras esse quam plurimas nihil dubito; <lb xml:id="p1z13"/>si quid tamen accepero scitu dignum, te non celabo.</s>
					<s n="7" xml:lang="la">Qui has <lb xml:id="p1z14"/>perfert, magister <placeName>Virtembergensis</placeName> <persName>Silesius</persName>, <persName>Philippi</persName> <lb xml:id="p1z15"/>commendatus est testimonio ampliter, quod et exhibebit <lb xml:id="p1z16"/>tibi; modesto et pio videtur ingenio praeditus; quem te scio <lb xml:id="p1z17"/>consueta humanitate excepturum.</s>
					<s n="8" xml:lang="la" ana="farewell">Bene vale in Christo Iesu.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/><placeName ref="l28">Basileae</placeName> 11 [IV?] septembris anno 1559.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/>Tuus <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, domino colendissimo <lb xml:id="p2z3"/>et charissimo fratri suo.</s>
				</p>
			</div>
		</body>
	</text>
