	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la">Etsi subvereor, vir excellens, ne meis indoctis et frequentioribus excellentiae <lb xml:id="p1z2"/>tuae sim molestus epistolis, tamen quoniam gratitudinem meam de<lb xml:id="p1z3"/>clarare cupio aliaque ratione hoc tempore cum nequeam, ideo dabit <lb xml:id="p1z4"/>mihi tua excellentia veniam, si toties scribendo contra decorum<note type="misc">docorum!</note> faciam.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Nunc aequidem etsi nihil novi hoc tempore habuerimus, quod <lb xml:id="p1z6"/>excellentia tua<note type="misc">excellentiam tuam!</note> scitu dignum existimaremus, tamen inique me <lb xml:id="p1z7"/>facturum existimabam, si tantam commoditatem mittendi epistolas <lb xml:id="p1z8"/>ad excellentiam tuam intermitteremus, igitur aliqua nunc, quę hic au<lb xml:id="p1z9"/>diebantur, scribere non dubitavi.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Auditur hic <placeName>Moscum</placeName> ad regem <lb xml:id="p1z10"/>nostrum legatos foederis ineundi cum eo gratia misisse, filium <lb xml:id="p1z11"/>suum <lb xml:id="p1z12"/>ad educandum se ei traditurum pollicens sed hac conditione, <lb xml:id="p1z13"/>ut post obitum regis nostri ille in regnum succederet, sed re<lb xml:id="p1z14"/>pulsa passus est, foedus autem usque ad festum Michaelis obtinuit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Litterae nobis non ita pridem redditę sunt a parente, <lb xml:id="p1z16"/>ex quibus intelleximus nobis hic per hiemem manendum esse <lb xml:id="p1z17"/>Germanicae linguae discendę gratia.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ipse vero contra <placeName>Moscum</placeName> iam <lb xml:id="p1z18"/>proficiscitur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Nos hactenus gratia dei prospera valetudine <lb xml:id="p1z19"/>usi sumus, <persName>Laurentio</persName> quidem aer iste non admodum commodus <lb xml:id="p1z20"/>est, iam enim per aliquot tempus dolore capitis affligitur, <lb xml:id="p1z21"/>medico etiam usus est aliquamdiu, sed dominus deus, qui est ipse <lb xml:id="p1z22"/>verus medicus, istos dolores omnes lenire et pristinę valetudini <lb xml:id="p1z23"/>restituere eum facile poterit, si a nobis invocabitur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Plura me nunc ad excellentiam tuam et res et tempus non patitur scribere.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p2z2"/>Optime igitur, vir excellentissime, vale et nos pro tua pietate et amo<lb xml:id="p2z3"/>re paterno diligere ne desistas.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Data <placeName ref="l284">Lipsiae</placeName> 25. augusti anno <lb xml:id="p2z4"/>domini 1563.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z5"/>Tuae excellentiae observantissimus <lb xml:id="p2z6"/><persName ref="p8047">Stanislaus Czikowski</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Clarissimo viro domino <persName ref="p495">Henricho <lb xml:id="p2z7"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae pastori [<lb xml:id="p2z8"/>v]igilantissimo, domino ac pa[trono] <lb xml:id="p2z9"/>omnibus modis colendis[<lb xml:id="p2z10"/>sim<lb xml:id="p2z11"/>o].</s>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
