	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Domino Buderus tandem fratrem suum natu
					<lb xml:id="p1z2"/>maximum patri, ut aiunt semillinm
					<lb xml:id="p1z3"/>huic eccelis civitabique nostrę parait.
					<lb xml:id="p1z4"/>Ea quotidia minibiliter Gallorum
					<lb xml:id="p1z5"/>adictu amplificatur.
					<lb xml:id="p1z6"/>Fasciculos duos ad domin Veceum et dominom.
					<lb xml:id="p1z7"/>volvarium tibi commendiat deram.
					<lb xml:id="p1z8"/>quęs ut eos fidel tabullorio conmtas
					<lb xml:id="p1z9"/>
					<lb xml:id="p1z10"/>
				</p>
			</div>
		</body>
	</text>
