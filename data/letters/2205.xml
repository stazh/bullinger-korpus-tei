	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/><persName>Richardus Thürr</persName>, honestus civis <placeName ref="l98">Curiensis</placeName> et meus familiaris, mihi <lb xml:id="p1z3"/>abs te (colendissime domine) literas et librum, quo me donas, reddidit.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Quam iucundae vero et gratae cum literae, tum liber fuerit, verbis <lb xml:id="p1z5"/>consequi nequeo.</s>
					<s n="4" xml:lang="la">Quis enim sum ego, ut tu (vir longe clarissime pra<lb xml:id="p1z6"/>estantissimeque) me libris donandis ornes?</s>
					<s n="5" xml:lang="la">Mihi equidem nihil gratius, <lb xml:id="p1z7"/>nihil acceptius hoc dono potuisset accidere.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Cęterum epistola <lb xml:id="p1z8"/>tua plena amoris et benevolentiae mihi hoc aspersit doloris, <lb xml:id="p1z9"/>quod ab initio commemoravit te, domine, me hoc exemplo donare, <lb xml:id="p1z10"/>ne te mihi ingratum existimem.</s>
					<s n="7" xml:lang="la">Quare obsecro, mi colendissime <lb xml:id="p1z11"/>domine, hoc?</s>
					<s n="8" xml:lang="la">Quid a me in te profectum, cuius meminisse <lb xml:id="p1z12"/>oporteat, cui gratia tribui debeat?</s>
					<s n="9" xml:lang="la">Abs te aut[em] in me <lb xml:id="p1z13"/>collata sunt omnia, quę ad meum commodum, quę ad hono<lb xml:id="p1z14"/>rem pertinerent.</s>
					<s n="10" xml:lang="la">Me vero nullam partem horum beneficiorum <lb xml:id="p1z15"/>non modo referenda, sed ne cogitanda quidem etiam gratia <lb xml:id="p1z16"/>consequi posse facile intelligo.</s>
					<s n="11" xml:lang="la">Voluntas colendi tui nunquam <lb xml:id="p1z17"/>mihi deerit.</s>
					<s n="12" xml:lang="la">Quod mandas, domine, ut exemplum meo <lb xml:id="p1z18"/>coniunctum curem ad dominum <persName ref="p8186">Bonett</persName> tuto transmitti, faciem <lb xml:id="p1z19"/>id, et studiose, ne sis sollicitus de hoc.</s>
					<s n="13" xml:lang="la">Cognatus <lb xml:id="p1z20"/>meus <persName>Bartholomaeus Cornu</persName> a Castromuris huc <placeName ref="l98">Curiam</placeName> af<lb xml:id="p1z21"/>futurus est hac septimana, ut una cum aliis scholae nostrae <lb xml:id="p1z22"/>praesidibus rationem subducant cum coenobii oeconomo.</s>
					<s n="14" xml:lang="la">Illi <lb xml:id="p1z23"/>meo cognato id negotii tradam; exequetur fideliter - sat scio - <lb xml:id="p1z24"/>et commode quoque, cum <placeName ref="l93">Cleven[n]ensibus</placeName> sit vicinus.</s>
					<s n="15" xml:lang="la" ana="farewell">His <lb xml:id="p1z25"/>vale, domine colendissime, meque tuae fidei commissum habe.</s>
					<s n="16" xml:lang="la">Totam <lb xml:id="p1z26"/>tuam familiam salvam cupio, imprimis praestantissimum virum d. <lb xml:id="p1z27"/><persName ref="p1884">Ludovicum Lavaterum</persName>, amicum et dominum meum colendum, dominum <lb xml:id="p1z28"/>praepositum, patronum ac mecenatem meum singularem.</s>
					<s n="17" xml:lang="la"><placeName ref="l98">Curiae <lb xml:id="p1z29"/>Rhetorum</placeName>, 27. februarii, anno <lb xml:id="p1z30"/>1554.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><persName ref="p6130">Iohannes Pontis<lb xml:id="p1z31"/>ella</persName>, <lb xml:id="p1z32"/>clientulus tuus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro, domino <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>antisteti[!], domino ac mecoenati meo <lb xml:id="p2z4"/>colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
