	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Mitto tibi literas ad <persName ref="p3375">Vergerium</persName>, quas iurisconsulto <lb xml:id="p1z2"/><persName ref="p20206">Gribaldo</persName>, qui propediem tecum erit, nisi <lb xml:id="p1z3"/>nunc etiam sit, velim consignes.</s>
					<s n="2" xml:lang="la">Gratissimum <lb xml:id="p1z4"/>mihi fuit, quod tuum de <persName>Clemente</persName> iudicium <lb xml:id="p1z5"/>statim aperueris; omnino tecum sentio.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Sed, quicunque est autor, sive alter <persName>Clemens</persName> <lb xml:id="p1z7"/>sive alius, omnino nomine veteris illius <persName>Clementis</persName> <lb xml:id="p1z8"/>scriptum constat.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="farewell">Si per studia tua <lb xml:id="p1z9"/>aliquando aliquid ad me scribere tibi licuerit, <lb xml:id="p1z10"/>mihi rem gratissimam et iucundissimam facies, Vale.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>4a octobris.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Tuus <persName ref="p8183">Sanlaurent</persName>[ianus<pb/><lb xml:id="p2z1"/>].</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Clarissimo et doctissimo theologo <lb xml:id="p2z2"/>d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z4"/>amico carissimo.</s>
				</p>
			</div>
		</body>
	</text>
