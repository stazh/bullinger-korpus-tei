	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>D. <persName ref="p495">Henrico Bulingero</persName> seniori, <lb xml:id="p1z2"/><placeName ref="l587">Tigurinae</placeName> ecclesiae ministro, <lb xml:id="p1z3"/>patri meo observando <lb xml:id="p1z4"/>S. P. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z5"/>Cum tot tantaque beneficia, quae in nos contulisti (observande pater) <lb xml:id="p1z6"/>in memoriam revoco, me, ne tanti beneficii immemor videar, ad gratias <lb xml:id="p1z7"/>immortales tibi agendas compellunt ac te alterum parentem <lb xml:id="p1z8"/>agnoscendum cogunt.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Nos dei gratia <placeName ref="l210">Heidelbergam</placeName> 4. die iulii <lb xml:id="p1z9"/>venimus ac eadem literas tuas d. <persName ref="p8075">Errasto</persName> dedimus, quibus perlectis <lb xml:id="p1z10"/>nos nomine tuo apud se convictores accepit, quod alias non fecisset; <lb xml:id="p1z11"/>multos enim prius recusaverat.</s>
					<s n="4" xml:lang="la">Sed cum pro nobis apud se nullum <lb xml:id="p1z12"/>hipocaustum haberet, curavit, ut non longe a suis aedibus unum reperir<lb xml:id="p1z13"/>emus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Nos imbribus fere continuis in nostra navigatione aspersi fuimus, <lb xml:id="p1z14"/>et nisi adfuissent nobis mercatores <placeName ref="l587">Tigurini</placeName>, qui tuo nomine multis <lb xml:id="p1z15"/>nos demeruerunt beneficiis, male nobiscum actum fuisset.</s>
					<s n="6" xml:lang="la">Hic <lb xml:id="p1z16"/>dei gratia florent literae, magnamque copiam doctorum virorum <lb xml:id="p1z18"/>habemus, a quibus nos magnum fructum reportaturos deo auxiliante speramus.</s>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z19"/>Bene vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute"><persName ref="p5035">Veritatem</persName> et <persName ref="p5034">Thoratheam</persName> saluto.</s>
				</p>
				<p>
					<s n="9" xml:lang="de"><placeName ref="l210">Heidelbergae</placeName> 8. die <lb xml:id="p1z20"/>septembris 1565.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Tuus obsequentissimus filius <lb xml:id="p1z22"/><persName ref="p8278">Antonius de Cougnees</persName>.</s>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henrico Bulinger</persName>o, ecclesiae <lb xml:id="p2z2"/><placeName ref="l587">Tigurinae</placeName> vigilantissimo pastori <lb xml:id="p2z3"/>et patri mihi plurimum observando.</s>
					<s n="12" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
