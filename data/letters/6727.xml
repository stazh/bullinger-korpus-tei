			<zone xml:id="p2z3-0" points="1285,1886 1506,1857 1682,1897 1822,1850 1977,1922 2109,1847 2351,1876 2400,1815 2161,1778 1905,1825 1286,1801">1293,1869 1348,1861 1403,1856 1459,1851 1514,1848 1570,1848 1625,1846 1680,1845 1736,1842 1791,1842 1847,1842 1902,1839 1957,1842 2013,1842 2068,1842 2124,1840 2179,1839 2234,1843 2290,1845 2345,1847 2401,1857</zone>
			<zone xml:id="p2z4-0" points="1586,2258 1630,2284 1741,2238 1763,2255 1807,2241 1873,2276 1929,2227 1949,2227 1954,2174 1931,2180 1893,2149 1784,2148 1700,2108 1682,2122 1595,2096">1594,2251 1619,2248 1645,2244 1670,2241 1696,2239 1722,2239 1747,2237 1773,2233 1799,2231 1824,2230 1850,2228 1876,2227 1901,2227 1927,2230 1953,2233</zone>
