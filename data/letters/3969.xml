	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Vivo, valeo, venio evangeliumque adfero vobis omnibus, <lb xml:id="p1z2"/>inprimis autem domine <persName>Manriche</persName> laetissimum.</s>
					<s n="2" xml:lang="la">Orate <lb xml:id="p1z3"/>deum, ut me cito liberet ex <placeName ref="l834">Italia</placeName>, et quo loco <lb xml:id="p1z4"/><placeName>Sarmaticę</placeName> res sint, paucissimos nosse credatis.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Forsitan <persName>Uthenovius</persName>, si isthac transierit, poterit <lb xml:id="p1z6"/>multa, quae nemo alius.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><persName>Maximilianus</persName> <lb xml:id="p1z7"/>hodie civitatem egressus est, ne intersit cir<lb xml:id="p1z8"/>cumgestationi idololatricę.</s>
					<s n="5" xml:lang="la">Ipse mihi dixit et praeterea <lb xml:id="p1z9"/>nonnulla, quae vos libenter audietis et me<lb xml:id="p1z10"/>cum gratias agetis deo, qui me tueatur in hoc residuo <lb xml:id="p1z11"/>itineris periculosissimo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Aliud nihil iam possum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Reli<lb xml:id="p1z12"/>qua <persName ref="p505">Burcherus</persName> noster, qui ausus est cum Iudis et <lb xml:id="p1z13"/>Iesuitis congredi simul uno eodemque tempore, mi<lb xml:id="p1z14"/>rabilis disputator ac <placeName ref="l587">Tigurinorum</placeName> amantissimus, <lb xml:id="p1z15"/>qui tamen in hoc <persName>Lęlio</persName> cedat libentissime.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Faxit deus, ut illi me vicissim benevolentia <lb xml:id="p1z17"/>amplecti non desinant, et satis est.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Viennę.</s>
					<s n="10" xml:lang="la">24.<note type="misc">Tag unsicher.</note> <lb xml:id="p1z18"/>maii 1559<note type="misc">Kalendis/10./29. maii?</note>.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/>V[ester] f[ilius] <pb/><lb xml:id="p2z1"/><persName ref="p8101">Lęlius Socinus</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Cla<lb xml:id="p2z2"/>rissimo domino <lb xml:id="p2z3"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z5"/>tanquam patri observandissimo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
