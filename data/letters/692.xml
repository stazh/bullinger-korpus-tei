	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Elegerunt nostri <persName>Onophrium</persName> in provisorem; sed a <persName>Bernatum</persName> <lb xml:id="p1z2"/>senatu nondum confirmatus est, et ne confirmaretur, decanus <lb xml:id="p1z3"/>noster et <persName>Nicolaus Bernę</persName> sedulo studuerunt.</s>
					<s n="3" xml:lang="la">Ad<lb xml:id="p1z4"/>versatur enim mihi decanus propter <persName>Ioachimum</persName>, quem contra ius <lb xml:id="p1z5"/>et aequum etiam vi et malis artibus defendere voluit.</s>
					<s n="4" xml:lang="la">Sed <lb xml:id="p1z6"/>cum eum in ius vocassem et vicissem (feci autem <lb xml:id="p1z7"/>coactus), senatus noster illum dimisit, et quia iam decanus <lb xml:id="p1z8"/>intelligit et mihi favere senatum et <persName>Onophrium</persName> a me <lb xml:id="p1z9"/>diligi, si per eum staret, vellet mihi alium obtrudi, quo<lb xml:id="p1z10"/>cum mihi etiam esset litigandum.</s>
					<s n="5" xml:lang="la">Vereor igitur, quia <lb xml:id="p1z11"/>me nostri defendunt et <persName>Omophrium</persName> elegerunt, ne, si <lb xml:id="p1z12"/><placeName ref="l41">Bernam</placeName> veniat, importunis eum interrogationibus <persName>Nicolaus</persName> <lb xml:id="p1z13"/>perturbet; est enim totus addictus decano.</s>
					<s n="6" xml:lang="la">Te <lb xml:id="p1z14"/>itaque, humanissime <persName ref="p495">Bullingere</persName>, etiam atque etiam rogo, <lb xml:id="p1z15"/>quo faveas adolescenti, ut D. <persName ref="p8018">Hallero</persName> eum commendes, <lb xml:id="p1z16"/>ne in examinando velint esse duriores.</s>
					<s n="7" xml:lang="la">Dabit <lb xml:id="p1z17"/>ei testimonium coram te praeceptor eius <persName>Frisius</persName>, et ego <lb xml:id="p1z18"/>in me collatum hoc esse beneficium putabo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z19"/>cum honestissima tua familia, quam incolumem tibi <lb xml:id="p1z20"/>teque nobis et ecclesię diu salvum et florentem <lb xml:id="p1z21"/>conservet deus optimus maximus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Brugis 3. calendas <lb xml:id="p1z22"/>octobris 1549.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Humanitati tuę <lb xml:id="p1z24"/>deditissimus <persName ref="p8450">Mich<lb xml:id="p1z25"/>ael Toxites</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Verę pietatis atque omnis eruditionis ornatissimo <lb xml:id="p2z2"/>viro D. <persName ref="p495">Heinricho Bullingero</persName>, ecclesia<lb xml:id="p2z3"/>stę <placeName ref="l587">Tigurino</placeName> fidelissimo, domino suo et <lb xml:id="p2z4"/>amico observandissimo<note xml:id="fn1" type="footnote" n="1">Notiz von Bull's Hand: "Hanns Zehender, radtschryber zuͦ Bern."</note>.</s>
				</p>
			</div>
		</body>
	</text>
