	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Pro libello misso summas tibi ago gratias, ornatissime <persName ref="p495">Bullingere</persName>.</s>
					<s n="2" xml:lang="la">Nostra <lb xml:id="p1z2"/><placeName ref="l822">Germania</placeName> pene elinguis et mutua modo est adeo, ut nihil eorum fateri <lb xml:id="p1z3"/>ausit, que pro officio sint.</s>
					<s n="3" xml:lang="la">De <persName ref="p8112">Galli regis</persName> instituto et progressu omnia <lb xml:id="p1z4"/>vobis nota esse non dubito.</s>
					<s n="4" xml:lang="la">Conesstabili dux <placeName ref="l1860">Nivernensis</placeName> et <persName>Guisius</persName> <placeName ref="l322">Metim</placeName> <lb xml:id="p1z5"/>ingressi sunt 4. aprilis 12000 exercitu <placeName>Gorsam</placeName> abbatiam prope <placeName ref="l322">Metz</placeName> si<lb xml:id="p1z6"/>tam centum peditibus Cesarianis defensam vi expugnaverunt et diripuerunt <lb xml:id="p1z7"/>cesis omnibus, qui repugnarunt.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Rex ipse maioribus copiis subsequitur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/><persName>Mauritius</persName> cum suis coniuratis <placeName ref="l18">Augusta</placeName> abiit et secundum Licum flumen <lb xml:id="p1z9"/>ascendit; quo porro profecturi sint, nondum certo scire possumus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Bella, horrida bella.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>In <placeName ref="l830">Anglia</placeName> modo magna omnium ordinum comitia habentur, in quibus optimas leges <lb xml:id="p1z11"/>tam pro religione quam regni publico statu condi audio.</s>
					<s n="9" xml:lang="la">Inter imperatorem et <lb xml:id="p1z12"/><persName ref="p3207">Angliae regem</persName> satis convenire audio, ut mutua commutatio et comertium inter <lb xml:id="p1z13"/>utrasque ditiones exercetur.</s>
					<s n="10" xml:lang="la">Quid hoc bellum nobis pariturum sit, inter varias <lb xml:id="p1z14"/>animi cogitationes sollicitor.</s>
					<s n="11" xml:lang="la"><placeName ref="l1107">Tridentinum</placeName> concilium continuatur.</s>
					<s n="12" xml:lang="la">Episcopi <placeName ref="l875">Hisp<lb xml:id="p1z15"/>anici</placeName> intersunt 25, totidem fere <placeName ref="l834">Italici</placeName>, <placeName ref="l822">Germanici</placeName> omnes abierunt preter unum <lb xml:id="p1z16"/>Civensem; relinquere tamen omnes coacti sunt vicarios et procuratores, qui cepta <lb xml:id="p1z17"/>peragunt.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Sessio ad 19. martii indicta prorogata est in calendas maias.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z18"/>A nostris omnium decretorum cassatio expetita est et nova controversiarum disceptat<lb xml:id="p1z19"/>io et cognitio, quod abnegatum audio a <persName ref="p18538">Cesaris</persName> legatis et pontifici<lb xml:id="p1z20"/>is detrectantibus acta iterum agere velle.</s>
					<s n="15" xml:lang="la">Hoc tempore leonem et vulpum coniuncti<lb xml:id="p1z21"/>onem tentari videmus; sed spero nullum contra dominum consilium prevaliturum.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z22"/>Quęso, ut me commendes <persName ref="p8171">Bibliandro</persName> et tuis generis.</s>
					<s n="17" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="18" xml:lang="la"><placeName ref="l491">Argentina</placeName> 16. <lb xml:id="p1z23"/>aprilis anno 1552.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><persName ref="p8121">C[hristophorus] M[ontius</persName>].</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Iuxta pio atque erudito viro <lb xml:id="p2z2"/>d. <persName ref="p495">Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesię pręsidi.</s>
				</p>
			</div>
		</body>
	</text>
