	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Gratissimum mihi fuit, ornatissime vir, in hunc eo <lb xml:id="p1z2"/>praesertim tempore tabellionem vestratem incidis<lb xml:id="p1z3"/>se, quo de d. <persName>Philippi</persName> ad haec comitia ad<lb xml:id="p1z4"/>ventu crebrior subinde rumor spargebatur.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Quamvis autem aspectum eius vehementer <lb xml:id="p1z6"/>exoptabam, horas eum tamen absque emolumento <lb xml:id="p1z7"/>tam longinquis oris edere [adire?] dispendio <lb xml:id="p1z8"/>mihi plenum visum est.</s>
					<s n="4" xml:lang="la">Itaque non tam <lb xml:id="p1z9"/>absentiam hominis aequo animo ferimus quam <lb xml:id="p1z10"/>vitae ipsius cursu non impedito nos omnino <lb xml:id="p1z11"/>consolamur.</s>
					<s n="5" xml:lang="la">Comitiorum porro status is est, <lb xml:id="p1z12"/>ut post octiduum exequias fratris imperatorem <lb xml:id="p1z13"/>solenni pompa executurum putemus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ad id <lb xml:id="p1z14"/>spectaculum, quo in loco d. <persName ref="p8417">Musculus</persName> olim <lb xml:id="p1z15"/>pie concionatus est, undequaque <persName>Canopoea</persName> (?<lb xml:id="p1z16"/>) in palatia <foreign xml:lang="el">μέλανα</foreign> muris obducta magnam <lb xml:id="p1z17"/>prae se religionem, vellem etiam fructum <lb xml:id="p1z18"/>ferunt.</s>
					<s n="7" xml:lang="la">Exequiis transmissis convocati conses<lb xml:id="p1z19"/>sus imperialis causae tandem in pleno princi<lb xml:id="p1z20"/>pum conventu proponentur, quae fortassis <lb xml:id="p1z21"/>istius generis erunt, ut auxiliis adversum <lb xml:id="p1z22"/><placeName ref="l2510">Turcas</placeName> decretis concordiae religionis negocium <lb xml:id="p1z23"/>in aliud commodius forte tempus differatur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z24"/>Principum in urbe nemo adhuc est praeter <lb xml:id="p1z25"/>legatos fere singulorum, qui ut repudiati <lb xml:id="p1z26"/>nondum plane fuerunt, ita parum decoro <lb xml:id="p1z27"/>consonum habitum fuit primam hanc dietam <lb xml:id="p1z28"/>imperatoris huius nullorum quasi ducum <lb xml:id="p1z29"/>adventu frequentari.</s>
					<s n="9" xml:lang="la">Sabbato <placeName ref="l307">Moguntinus</placeName> <lb xml:id="p1z30"/>interim expectatur et fortasse <placeName ref="l619">Bavarus</placeName>, <placeName ref="l572">Wirtembergensi<lb xml:id="p1z31"/>s</placeName> caeterique vicini nulli dum adpule<lb xml:id="p1z32"/>re.</s>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Literis equidem tuis respondissem, nisi tum <lb xml:id="p2z2"/>parentis adversa et dubia valetudo eas posce<lb xml:id="p2z3"/>re ab eo prohibuisset, tum non viles occu<lb xml:id="p2z4"/>pationes nostrae indagandi ulterius occasionem <lb xml:id="p2z5"/>abripuissent.</s>
					<s n="11" xml:lang="la" ana="salute">Vale, vir praestantissime, <lb xml:id="p2z6"/>et officiosissimam salutem d. d. <persName ref="p1283">Gesnero</persName> meo <lb xml:id="p2z7"/>nomine.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l18">Augusta</placeName> 8. februarii ocyssime <lb xml:id="p2z8"/>1559.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z9"/>Totus animo studioqu<lb xml:id="p2z10"/>e <lb xml:id="p2z11"/>tuus <lb xml:id="p2z12"/><persName ref="p8430">Raphael Seilerus</persName> iureconsu<lb xml:id="p2z13"/>ltus manu propri<lb xml:id="p2z14"/>a.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt]</note>
				</p>
			</div>
		</body>
