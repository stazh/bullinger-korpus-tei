	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Heri sub noctem accepi tuas, quas una cum <lb xml:id="p1z2"/>12 exemplaribus et tribus aliis Confessionis <lb xml:id="p1z3"/>nostrae communis ad me misisti, pro quibus omnibus <lb xml:id="p1z4"/>tibi magnas ago gratias, praesertim pro illo quoque, quod <lb xml:id="p1z5"/>mihi singulariter inscripsisti.</s>
					<s n="3" xml:lang="la">Faxit dominus, ut in illa <lb xml:id="p1z6"/>Confessione concorditer semper vivamus et moriamur!</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Reliqua exemplaria distribuam, sicut iussisti.</s>
					<s n="5" xml:lang="la" ana="salute"><persName ref="p8063">Steigero</persName> <lb xml:id="p1z8"/>duo dedi, Latinum et Germanicum, tuo nomine, <lb xml:id="p1z9"/>quia singularem nobis in hac re promovenda praestitit <lb xml:id="p1z10"/>operam; is tibi gratias agit et te salutat mihique <lb xml:id="p1z11"/>novitates has communicavit, quas tibi communicarem suo <lb xml:id="p1z12"/>nomine.</s>
					<s n="6" xml:lang="la">Inter caetera intelligo alias literas <lb xml:id="p1z13"/>abs te esse in itinere, quas nondum accepi, quibus <lb xml:id="p1z14"/>de <placeName ref="l28">Basiliensibus</placeName> fortassis scribis, qui quid respon<lb xml:id="p1z15"/>derint, valde miramur.</s>
					<s n="7" xml:lang="la"><persName ref="p3099">Sulcerus</persName> iis ipsis diebus <lb xml:id="p1z16"/>multas huc literas misit, quibus d. <persName ref="p8011">Gvaltherus</persName> <lb xml:id="p1z17"/>illic fuit.</s>
					<s n="8" xml:lang="la">Quid singulis scripserit, nescio; apud <lb xml:id="p1z18"/>me (nam mihique scripsit) egregie hoc negotium dissimula<lb xml:id="p1z19"/>vit nec ullam eius fecit mentionem.</s>
					<s n="9" xml:lang="la">Ego <lb xml:id="p1z20"/>rescripsi illi me mirari, cur de hoc non scribat; <lb xml:id="p1z21"/>audiam, quid respondeat.</s>
					<s n="10" xml:lang="la">Per nuncium <placeName ref="l167">Genevensem</placeName>, qui <lb xml:id="p1z22"/>has novitates attulit, et literas et exemplaria, quę <lb xml:id="p1z23"/>ad illos pertinebant, eis commode misi; habebunt illa <lb xml:id="p1z24"/>proxima sabbati aut solis.</s>
					<s n="11" xml:lang="la">Aliud non habeo, quod <pb/><lb xml:id="p2z1"/>nunc scribam.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Salutant te amici et fratres <lb xml:id="p2z2"/>omnes.</s>
					<s n="13" xml:lang="la" ana="salute">Saluta meo nomine eos, qui a[pud] <lb xml:id="p2z3"/>vos sunt, praesertim qui de tua sunt fa[milia].</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l41">Bernae</placeName> 15. martii 1566.</s>
				</p>
