	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">De rebus nostris copiose ad vos scripsi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Ab eo <lb xml:id="p1z2"/>tempore nihil novi est ad nos allatum, quod <lb xml:id="p1z3"/>ex ipsis legatis abunde non cognoveritis; <lb xml:id="p1z4"/>sed speramus fore, ut brevi aliquid accipiamus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Veremur autem, ne bis sit peccatum, nempe <lb xml:id="p1z6"/>quo<lb xml:id="p1z7"/>d cardinalis opera sint usi, quocum (quicum?) non temere <lb xml:id="p1z8"/>monueramus, ut nihil omnino agerent, sed <lb xml:id="p1z9"/>diserte potius significarent, sibi nihil prorsus cum <lb xml:id="p1z11"/>eo fore negotii, deinde quod accepto responso <lb xml:id="p1z12"/>iterum ad ipsum regem non adierint, vaferrimi <lb xml:id="p1z13"/>nimirum hominis responso et pollicitis decepti.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z14"/>Mallemus profecto illos re infecta et ipso <lb xml:id="p1z15"/>insalutato rege rediisse; sed tamen non <lb xml:id="p1z16"/>dubitamus, quin omnia optimo zelo acta sint <lb xml:id="p1z17"/>ab amplissimis legatis, quibus etiam hoc nomine <lb xml:id="p1z18"/><placeName ref="l832">Gallicae</placeName> omnes ecclesiae plurimum debere <lb xml:id="p1z19"/>se profitentur.</s>
					<s n="6" xml:lang="la">Neque vero dubitamus, quin <lb xml:id="p1z20"/>dominus haec omnia in suam gloriam et <lb xml:id="p1z21"/>suorum consolationem convertat.</s>
					<s n="7" xml:lang="la">Quod ad <lb xml:id="p1z22"/>sumptus legatorum attinet, meministi, quid <lb xml:id="p1z23"/>nobis responderetur, quum id ipsum senatui proposuisses.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z24"/>Ea res effecit, ut tantam pecuniam repente <lb xml:id="p1z25"/>non potuerimus conferre, quanta fortassis opus <lb xml:id="p1z26"/>erat; sed tamen, si putaris ita faciendum, <lb xml:id="p1z27"/>curabimus, ut prorsus iis satisfiat.</s>
					<s n="9" xml:lang="la"><placeName ref="l822">Germanos</placeName> <lb xml:id="p1z28"/>legatos arbitramur nunc apud regem esse, de <lb xml:id="p1z29"/>quibus tamen nihildum certi accepimus.</s>
					<s n="10" xml:lang="la">Ad natalia <lb xml:id="p1z30"/>domini celebranda ferunt delphini et <persName ref="p18212">reginae <lb xml:id="p1z31"/>Scotiae</persName> desponsationem.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Convenient quoque tres <lb xml:id="p1z32"/>regni status <placeName ref="l378">Lutetiae</placeName>.</s>
					<s n="12" xml:lang="la">Hic nullum non lapidem <lb xml:id="p1z33"/>movebimus, ut libertas aliquid virium recipiat <lb xml:id="p1z34"/>aut saltem, ut cardinalis impudentia longius progredi <lb xml:id="p1z35"/>non possit.</s>
					<s n="13" xml:lang="la"><placeName ref="l513">Ulmae</placeName> indictum auditum conventum electorum <lb xml:id="p1z36"/>postridie regalium creando imperatori, id est <lb xml:id="p1z37"/>inaugurando <persName ref="p18477">Ferdinando</persName>.</s>
					<s n="14" xml:lang="la">Dominus convertat <pb/><lb xml:id="p2z1"/>impiorum consilia in ipsorum caput et spiritu constanti <lb xml:id="p2z2"/>suos induat.</s>
					<s n="15" xml:lang="la" ana="salute">Bene vale, mi pater, cum fratribus <lb xml:id="p2z3"/>omnibus, quos quidem rogo ut sigillatim ex me <lb xml:id="p2z4"/>quam diligentissime salutes.</s>
					<s n="16" xml:lang="la">Cupio vero etiam <lb xml:id="p2z5"/>admoneri d. <persName ref="p4091">Zwinglium</persName> valde mihi instare <lb xml:id="p2z6"/><persName ref="p8102">Robertum Stephanum</persName> de quatuor illorum bibliorum <lb xml:id="p2z7"/>pretio, qu iam pridem accepit.</s>
					<s n="17" xml:lang="la" ana="farewell">Iterum vale.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z8"/>D. Iesus tuis sanctis laboribus magis ac magis <lb xml:id="p2z9"/>benedicat.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l280">Laus[annae]</placeName> 17. decembris <lb xml:id="p2z11"/>1557.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z13"/>Tuu<lb xml:id="p2z15"/>s <persName ref="p8033">Beza</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="21" xml:lang="la"><lb xml:id="p2z16"/>E<lb xml:id="p2z18"/>ximio <lb xml:id="p2z21"/>Chris<lb xml:id="p2z22"/>ti ser<lb xml:id="p2z23"/>vo <lb xml:id="p2z24"/>d. <lb xml:id="p2z26"/><persName ref="p495">Hen<lb xml:id="p2z27"/>r<lb xml:id="p2z29"/>ico <lb xml:id="p2z30"/>Bul<lb xml:id="p2z33"/>lingero</persName>, <lb xml:id="p2z34"/>eccles<lb xml:id="p2z35"/>iae <lb xml:id="p2z36"/><placeName ref="l587">Tiguri<lb xml:id="p2z37"/>nae</placeName> ve<lb xml:id="p2z38"/>r<lb xml:id="p2z39"/>e fi<lb xml:id="p2z42"/>do pa<lb xml:id="p2z44"/>s<lb xml:id="p2z45"/>t<lb xml:id="p2z46"/>o<lb xml:id="p2z47"/>ri.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p2z48"/><placeName ref="l587">Ti<lb xml:id="p2z49"/>guri</placeName>.</s>
				</p>
