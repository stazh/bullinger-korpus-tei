	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Priusquam in <placeName ref="l587">Tigurinum</placeName> agrum me <lb xml:id="p1z2"/>recepissem, scripsi hoc ad te, quod nunc accipis, <lb xml:id="p1z3"/>epistolium.</s>
					<s n="3" xml:lang="la">Veniebant autem ad nos <persName ref="p506">Buttlerus</persName> noster <lb xml:id="p1z4"/>et quęstor cum eo <placeName ref="l339">Neoburgensis</placeName>, quibus <persName ref="p4082">Conradus</persName> <lb xml:id="p1z5"/>atque ego exponebamus adventum capitaneorum in <lb xml:id="p1z6"/>urbem; que causa fuit, cur epistolam istam detinerem.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Verum crebescente fama de <persName ref="p18477">Ferdinando</persName> etiam rege in urbe<lb xml:id="p1z8"/>m statim venturo volui abiectas <lb xml:id="p1z10"/>literas ad officium revocare ociosasque ad te <lb xml:id="p1z11"/>mittere.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Observandum enim <placeName ref="l862">Helvetiis</placeName> diligenter <lb xml:id="p1z12"/>existimo, quid hac tempestate agant aut <lb xml:id="p1z13"/>meditentur reges.</s>
					<s n="6" xml:lang="la">De mearum rerum statu <lb xml:id="p1z14"/>propediem coram.</s>
					<s n="7" xml:lang="la">Uxorem et liberos secun<lb xml:id="p1z15"/>dante divina voluntate inculumes huc <lb xml:id="p1z16"/>adduxi, quibus plane mansuescit locus.</s>
					<s n="8" xml:lang="la">Itaque <lb xml:id="p1z17"/>illos mecum tibi patribusque cęteris commendo.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p8171">Theodoro</persName> dicme illius epistolam <lb xml:id="p1z19"/>de <persName ref="p8424">Phrigio</persName> apud fratrem accepisse.</s>
					<s n="10" xml:lang="la">Mox <lb xml:id="p1z20"/>intelleximus ex <persName ref="p4082">Conrado</persName>, consobrino nostro, <lb xml:id="p1z21"/>illum uxori responsum misisse; optare me igitur, <lb xml:id="p1z22"/>ut id vertat bene.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale in Christo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/><placeName ref="l247">Campidonę</placeName> 8. augusti 1549.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p8178">Thomas Bl[aurerus</persName>] tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="14" xml:lang="de"><pb/><lb xml:id="p2z1"/>An mai<lb xml:id="p2z2"/>ster <persName ref="p495">Hainrich <lb xml:id="p2z3"/>Bullinger</persName>.</s>
				</p>
			</div>
