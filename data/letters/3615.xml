	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Quod ad te, vir clarissime, uti debeo sepe non scribo, noli <lb xml:id="p1z2"/>putare, quod vel tui sim oblitus vel reverentia non movear sive amoris <lb xml:id="p1z3"/>penuria cessem, nihil horum est; nam et te maxime colo et singulariter <lb xml:id="p1z4"/>amo, et a memoria mea nunquam excidis, quoniam<note type="misc">qm</note> monumenta tua, <lb xml:id="p1z5"/>quae oculis meis quottidie sese offerunt, animo meo ita te imprimunt, ut <lb xml:id="p1z6"/>nullo pacto deleri possis.</s>
					<s n="2" xml:lang="la">Imputa potius, si quid vitii in me est, <lb xml:id="p1z7"/>etati ac senio, magis tamen nature mee timiditati; cum enim nihil te <lb xml:id="p1z8"/>dignum, ut literis meis moneri possis, mihi occurat, vereor h<lb xml:id="p1z9"/>ominem in maximis negotiis alioqui occupatissimum in legendis <lb xml:id="p1z10"/>literis meis detinere.</s>
					<s n="3" xml:lang="la">Boni igitur consule, vir dei, tarditatem meam.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Marius <lb xml:id="p1z11"/>noster, ad quem latius scribo, te de causa Christi Iesu, quae apud <lb xml:id="p1z12"/>nos agitur, plenius informabit; si quid opis et auxilii ferre potes, <lb xml:id="p1z13"/>uti vere potes, totum deo patri ac domino nostro Iesu Christo, non hominibus, no<lb xml:id="p1z14"/>veris esse dedicatum.</s>
					<s n="5" xml:lang="la" ana="farewell">Bene in domino vale.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Dominus Iesus Christus te nobis <lb xml:id="p1z15"/>servet incolumem.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/><placeName ref="l93">Clavene</placeName> nonis iunii 1558.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p2019">Augustinus Mainardus</persName> tuus<pb/><lb xml:id="p2z2"/>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p2z3"/>Cl<lb xml:id="p2z4"/>aris<lb xml:id="p2z5"/>simo <lb xml:id="p2z7"/>domino domino <persName ref="p495">Henrico <lb xml:id="p2z8"/>Bullingero</persName>, divine scripture expositori <lb xml:id="p2z9"/>eximio<lb xml:id="p2z11"/>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z19"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
