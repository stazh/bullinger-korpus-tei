	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tametsi nihil occurrat, quod scribi mereatur, ne ocium suppetat, <lb xml:id="p1z2"/>possis etiam e <placeName ref="l301">Lugduno</placeName> et <placeName ref="l167">Geneva</placeName> temporum nostrorum rationem et res <placeName ref="l832">Gallie</placeName> <lb xml:id="p1z3"/>intelligere, hoc solum libuit scribere, quod habere te puto persuasissimum, <lb xml:id="p1z4"/>me esse tuum tibique gratificari posse cupere admodum; experieris, cum <lb xml:id="p1z5"/>voles.</s>
				</p>
				<p>
					<s n="3" xml:lang="la" ana="salute">Uxor te salutat.</s>
					<s n="4" xml:lang="la" ana="salute">Salutabis amplissimum senatum, d. <persName ref="p8011">Gvaltherum</persName> et amicos omnes.</s>
					<s n="5" xml:lang="la" ana="farewell"><lb xml:id="p1z6"/>Bene vale.</s>
					<s n="6" xml:lang="la"><placeName ref="l378">Parisiis</placeName> 29. martii 1566.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z7"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio viro d. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l803">Tigurine</placeName> ecclesie pastori fido.</s>
					<s n="9" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l803">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
