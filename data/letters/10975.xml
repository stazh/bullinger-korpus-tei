	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam a Domino!</s>
					<s n="2" xml:lang="la">Ludum <placeName ref="l280">Lauzan[ie]</placeName> instituimus, lectionemqne Theologicam.</s>
					<s n="3" xml:lang="la">Quare opus <lb xml:id="p1z2"/>erit nobis, praefectis utrinue doctis et eruditis, ludi praesertim moderatore, qui galli<lb xml:id="p1z3"/>cam teneat linguam: in quem locum <persName ref="p1214">Frisium</persName> <placeName ref="l587">Tigurinum</placeName> haud dubie vocat<lb xml:id="p1z4"/>uri sumus, nisi nobis per vos fuerit denegatum.</s>
					<s n="4" xml:lang="la">Curabimus quo stipendium ac <lb xml:id="p1z5"/>praemium habeat se dignum, videlicet, nostrae monetae aureos centum, aut circiter.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Salarium itaqne quod habet ab ecclesia <placeName ref="l587">Tigurina</placeName> in aliquem alium converti <lb xml:id="p1z7"/>poterit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Praeterea, quo hebreae linguae professorem habeamus diligenter <lb xml:id="p1z8"/>inquiremus.</s>
					<s n="7" xml:lang="la">Utinam <persName ref="p1039">Evauder</persName> nobis contingat!</s>
					<s n="8" xml:lang="la"><persName ref="p4518">Carolus</persName> Veteris <lb xml:id="p1z9"/>Testamenti, <persName ref="p3429">Viretus</persName> vero Novi theologum praestabit.</s>
					<s n="9" xml:lang="la">Utroque enim quottidie <lb xml:id="p1z10"/>publica erit lectio, ubi ludi moderator utrinque graeca interpretabitur.</s>
					<s n="10" xml:lang="la" ana="salute"><lb xml:id="p1z11"/>Caeterum ministri nostri linguae <placeName ref="l832">gallicae</placeName>, multis in locis, concionibus <placeName ref="l631">Burgundiones</placeName> <lb xml:id="p1z12"/>salutant, quos speramus Deum suo spiritu brevi invisurum.</s>
					<s n="11" xml:lang="la" ana="farewell">Bene valete, c<lb xml:id="p1z13"/>harissimi mei fratres.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l41">Bern</placeName>, 15 Januarii, anno 37.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p8412">Megand[er]</persName> vester totus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinrico Bullingero</persName> <lb xml:id="p2z2"/>ac <persName ref="p1753">Leoni Judae</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>Ecclesiae prafectis, fratribus <lb xml:id="p2z4"/>suis in Domino charissimis.</s>
				</p>
			</div>
		</body>
	</text>
