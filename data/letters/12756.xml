			<zone xml:id="p2z3-0" points="764,1526 813,1522 921,1587 1028,1525 1120,1554 1181,1536 1238,1568 1471,1555 1468,1443 1214,1416 1160,1442 957,1425 934,1446 817,1396 761,1412">770,1513 805,1508 840,1507 875,1506 910,1504 945,1507 980,1507 1015,1507 1050,1508 1085,1510 1120,1512 1155,1513 1190,1512 1225,1510 1260,1513 1295,1513 1330,1515 1365,1516 1400,1516 1435,1519 1471,1516</zone>
