	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Cupis, ut scribam copiose de rebus <placeName ref="l832">Gallicis</placeName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Ego vero, quod scribam, nihil habeo nisi rumores, <lb xml:id="p1z3"/>et iam nunc ex <placeName ref="l41">Berna</placeName> literas accipio testantes ex <lb xml:id="p1z4"/><placeName ref="l832">Gallia</placeName> nunc rumores afferri coniuratorum esse <lb xml:id="p1z5"/>ad 60000 et detecta esse ipsorum consilia, unde <lb xml:id="p1z6"/>ex primoribus ipsorum quidam capti sint, ex quibus <lb xml:id="p1z7"/>per tormenta extorqueatur rei veritas.</s>
					<s n="4" xml:lang="la"><persName>Guysianum</persName> <lb xml:id="p1z8"/>quoque instructum milite oberrare et cohortes <lb xml:id="p1z9"/>diffusas necdum viribus iunctis collectas disturbare <lb xml:id="p1z10"/>et caedere.</s>
					<s n="5" xml:lang="la">Quod si ita est, evenit sane, <lb xml:id="p1z11"/>quod ego eventurum putavi, exoriturum inquam in <placeName ref="l832">Gallia</placeName> sicuti q<lb xml:id="p1z12"/>uondam in <placeName ref="l822">Germania</placeName> bellum rusticum, quo trucidentur in<lb xml:id="p1z13"/>numeri et evangelium audiat pessime ob crimen <lb xml:id="p1z14"/>seditionis.</s>
					<s n="6" xml:lang="la">Oremus dominum, ne praepro<lb xml:id="p1z15"/>pera et immatura quorundam consilia ecclesiae noceant.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>Cum uxori tuae coronatus datur, tibi nihil datur.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Agnosco autem me tibi permultum debere.</s>
				</p>
				<p>
					<s n="9" xml:lang="de">Es ist <lb xml:id="p1z18"/>alein ein zeychen der erkantnus.</s>
					<s n="10" xml:lang="la">Proinde ne re<lb xml:id="p1z19"/>spuas exile donum.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Ego nihil omnino postulo <lb xml:id="p1z20"/>pro equo a d. <persName>Philippo</persName>, nisi hoc unum et precium, <lb xml:id="p1z21"/>quod debetur fabro.</s>
				</p>
				<p>
					<s n="12" xml:lang="de">Sind ir zuͦfriden, so bin ichs ouch.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Filius aegre revalescit colore inter medicandum <lb xml:id="p1z23"/>refers cotoneas.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Videte, ne cedatis <lb xml:id="p1z24"/>in eiiciendo <persName ref="p293">Beccaria</persName>, ne illi male coeptum n<lb xml:id="p1z25"/>egotium in aliis et pluribus pessime finiant.</s>
					<s n="15" xml:lang="de">Handle man <lb xml:id="p1z26"/>mitt rächt, nitt mitt gwallt; hat er neißwas <lb xml:id="p1z27"/>usser der religion unerlichs gethan, <foreign xml:lang="la">convincatur; <lb xml:id="p1z28"/>alioqui iubebunt quemlibet pro sua libidine <lb xml:id="p1z29"/>eiicere</foreign>.</s>
					<s n="16" xml:lang="la">Ita eritis <persName>Rheti</persName><note type="misc">"Pagorum" gestrichen</note> subditi, qui <lb xml:id="p1z30"/>suis vos gubernabunt mandatis etc.</s>
					<s n="17" xml:lang="la" ana="salute">Vale et salu<lb xml:id="p1z31"/>ta d. legatum, d. <persName>Philippum</persName>, d. <persName ref="p6130">Pontasellam</persName>, d. d. consules.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Literas <lb xml:id="p1z32"/>quoque, quam primum poteris, tuas ad nos mitte, <lb xml:id="p1z33"/>ex quibus intelligemus, quid habeat legatus, quid <lb xml:id="p1z34"/>fiat apud vos et in <placeName ref="l834">Italia</placeName>.</s>
					<s n="19" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 5. aprilis 60.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z35"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p8009">Ioanni Fabritio</persName>, <lb xml:id="p2z3"/><placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z4"/>fideli ministro, domino <lb xml:id="p2z5"/>et fratri suo <lb xml:id="p2z6"/>colendissimo et charissimo.</s>
					<s n="22" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
