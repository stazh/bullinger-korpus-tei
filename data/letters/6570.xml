	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Assidenti mensę hic fasciculus mihi est redditus.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Cum autem <lb xml:id="p1z2"/>statim a prandio mihi sit alio proficiscendum et forte adesset nuntius <lb xml:id="p1z3"/><placeName ref="l257">Constantiensis</placeName>, tradidi ei istum.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Plura addere <lb xml:id="p1z4"/>non possum ob temporis angustiam.</s>
					<s n="4" xml:lang="la">Comitia proclamata sunt apud <lb xml:id="p1z5"/>no<lb xml:id="p1z6"/>s; ego puto nulla futura.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell"><lb xml:id="p1z7"/>Vale etc.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Datum <placeName ref="l18">Augustę</placeName> 4. novembris anno 65.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><persName ref="p3740">Georgius <lb xml:id="p1z9"/>a Stetten</persName>, t[ui] obs[er<pb/><lb xml:id="p2z1"/>vantissimus].</s>
					<s n="8" xml:lang="la">Venerando atque <lb xml:id="p2z2"/>erudito domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>domino et amico suo colendo.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note>[Darunter von anderer Hand:]</note>
					<s n="10" xml:lang="de"><lb xml:id="p2z4"/>An meister <persName ref="p495">Heinrich <lb xml:id="p2z5"/>Bullinger</persName> zu<lb xml:id="p2z6"/>ͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="de"><lb xml:id="p2z7"/>Heren <lb xml:id="p2z8"/><persName ref="p495">Bullinger</persName> zuͦgehörig.</s>
				</p>
			</div>
		</body>
	</text>
