	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Iam diu, <persName ref="p495">Bullingere</persName> in domino charissime, nihil <lb xml:id="p1z2"/>literarum ab <persName ref="p8018">Hallero</persName> nostro accepi; causam hanc esse <lb xml:id="p1z3"/>opinor, quod hactenus nullo certo loco constiti, <lb xml:id="p1z4"/>quo literas mittere posset.</s>
					<s n="3" xml:lang="la">Significo illi itaque, <lb xml:id="p1z5"/>et ubi sim et quis rerum mearum status existat; <lb xml:id="p1z6"/>rogo, literas istis inclusas ad eum mittas, <lb xml:id="p1z7"/>ubi per occasionem licuerit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Cęterum de valetudine uxoris nihildum divinare <lb xml:id="p1z9"/>possum, quorsumnam illa sit desitura.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Interdiu videtur habere levius ac spem facit <lb xml:id="p1z11"/>brevi recuperandae sanitatis; noctu vero tantum <lb xml:id="p1z12"/>non ardore consumitur, sic ut aliquoties <lb xml:id="p1z13"/>rationis ac mentis deliquio laboret.</s>
					<s n="6" xml:lang="la">Ante biduum <lb xml:id="p1z14"/>accessit etiam febris molestia.</s>
					<s n="7" xml:lang="la">Liberi, qui aegrot<lb xml:id="p1z15"/>abant, incipiunt per gratiam domini convalescere, <lb xml:id="p1z16"/>ut iam de solius uxoris valetudine incertus <lb xml:id="p1z17"/>hęream.</s>
					<s n="8" xml:lang="la">Commendo et illam et me et omnia <lb xml:id="p1z18"/>mea precibus vestris et ecclesię vestrę.</s>
					<s n="9" xml:lang="la">Scio, <lb xml:id="p1z19"/>scio clementiam Christi servatoris, propter cuius <lb xml:id="p1z20"/>aeternam veritatem huic me exilio tradidi, <lb xml:id="p1z21"/>tam esse magnam tamque certam, ut hisce mo<lb xml:id="p1z22"/>lestiis brevi sit finem facturus; interea tamen <lb xml:id="p1z23"/>et pium est et necessarium, ut orationibus piorum <lb xml:id="p1z24"/>utar in conspectu dei, quae nunquam non magn<lb xml:id="p1z25"/>i sunt momenti.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z26"/>De domino <persName ref="p8354">Lęto</persName>, archigrammatęo <placeName ref="l18">Augustano</placeName>, forsan <lb xml:id="p1z27"/>iam antea audisti, quod a munere, quo functus <lb xml:id="p1z28"/>fuit, sit per novum illum magistratum <placeName ref="l18">Augustę</placeName> <lb xml:id="p1z29"/>remotus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">De <persName ref="p1055">Frechto</persName> si quid habes, quaeso, cribas.</s>
					<s n="12" xml:lang="la" ana="salute"><lb xml:id="p1z30"/>optime vale; salutem uxori honestissimae, liberis, fratribus et ami<lb xml:id="p1z31"/>cis.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l473">Sangalli</placeName> 8. Septembris 1548.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><persName ref="p8417">Wolf[gangus] Musculus</persName>, tuus in domino.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Quoniam <persName ref="p4851">Frosc<lb xml:id="p1z32"/>houerus</persName> aedes suas aliis lo<lb xml:id="p1z33"/>cavit, interea, <lb xml:id="p1z34"/>obsecro circums<pb/><lb xml:id="p2z1"/>picite apud vos, ubi maner<lb xml:id="p2z2"/>e possim cum meis; nam mox atq<lb xml:id="p2z3"/>ue uxor vel convaluerit vel ad do<lb xml:id="p2z4"/>minum migraverit, ad vos concedam, nisi <lb xml:id="p2z5"/>per voluntatem domini i<lb xml:id="p2z6"/>mpediar.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la">Praestantissimo theologo domino <persName ref="p495">Hei<lb xml:id="p2z7"/>nricho Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ec<lb xml:id="p2z8"/>clesię pastori vigilantissimo, dom<lb xml:id="p2z9"/>ino ac fratri observandis<lb xml:id="p2z10"/>simo.</s>
					<s n="17" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
