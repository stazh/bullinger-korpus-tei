	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non prius scivi hunc nuncium<note xml:id="fn1" type="footnote" n="1">Unbekannt.</note> abiturum, quam cum iam <lb xml:id="p1z2"/>abiturus esset.</s>
					<s n="3" xml:lang="la">Proinde non possum, quae vellem, scribere omnia.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z3"/>Scribam tamen intra triduum, deo volente, per <persName ref="p4941">Andraeam</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p4941">Andreas Gessner d.J.</persName>; vgl. <ref target="file12943">Nr. 2894</ref>, <ptr target="qvfn17159-10" type="qv"/>. - Er verließ <placeName ref="l18">Augsburg</placeName> erst etwa am 9. September; s. <ref target="file13054">Nr. 3005</ref>,<ptr target="qvzl17272-1" type="qv"/>.</note>, <lb xml:id="p1z4"/>pugilem illum <placeName ref="l587">Tigurinum</placeName>, copiosius; nam habeo, quae vos <lb xml:id="p1z5"/>scire maxime vellem.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="5" xml:lang="la" ana="farewell">Interea vale et literas has aliquamd<lb xml:id="p1z6"/>iu apud me servatas propter tabellionum raritatem <lb xml:id="p1z7"/><persName ref="p4851">Froschovero</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p4851">Christoph Froschauer d.Ä.</persName></note> des.</s>
					<s n="6" xml:lang="la">Misit eas ad me ipsius mater.<note xml:id="fn4" type="footnote" n="4">Unbekannt.</note><pb type="edition" next="436"/></s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/>Die Iovis proxime, calendis scilicet septembris, comitia<note xml:id="fn5" type="footnote" n="5">Der <placeName ref="l18">Augsburger</placeName> Reichstag; s. dazu <ref target="file13001">Nr. 2952</ref>, <ptr target="qvfn17218-1" type="qv"/>.</note> incoeperint<note xml:id="fna" type="footnote" n="a"><hi>In der Vorlage</hi> incoeperunt.</note>, <lb xml:id="p1z9"/>de quibus plura brevi.</s>
					<s n="8" xml:lang="la">7. calendas septembris 1547.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z10"/><persName ref="p8018">Ioan. Hallerus</persName>, perpetuo <lb xml:id="p1z11"/>tuus.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z12"/>D. <persName ref="p8354">Laetus</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p8354">Georg Frölich</persName>.</note> laetali tantumnon <lb xml:id="p1z13"/>decubuit et adhuc decumbit <lb xml:id="p1z14"/>apostemate,<note xml:id="fn7" type="footnote" n="7">Vgl. <ref target="file13078">Nr. 3029</ref>,<ptr target="qvzl17298-1" type="qv"/>.</note> sed convalescit iterum.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z15"/>Domino sit laus!</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrych<lb xml:id="p2z2"/>o Bullingero</persName>, do<lb xml:id="p2z3"/>mino suo tanquam <lb xml:id="p2z4"/>patri venerando.</s>
					<s n="13" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName>.</s>
					<s n="14" xml:lang="de"><lb xml:id="p2z6"/>An m. <persName ref="p495">Heinrych <lb xml:id="p2z7"/>Bullinger</persName>.</s>
				</p>
			</div>
		</body>
