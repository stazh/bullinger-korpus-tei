	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Interea, quo tuas accepi, quas 29. <lb xml:id="p1z2"/>octobris misisti, <persName ref="p495">Bullingere</persName> compater in <lb xml:id="p1z3"/>domino charissime, nulla sese obtulit rescribendi <lb xml:id="p1z4"/>occasio, et dum hasce scribo, nemo ad <lb xml:id="p1z5"/>manum est, per quem mittam.</s>
					<s n="3" xml:lang="la">Quod D. <lb xml:id="p1z6"/><persName ref="p8018">Hallero</persName>, reipublicę huius quęstori, <lb xml:id="p1z7"/>mea caussa scripsisti tam diligenter, <lb xml:id="p1z8"/>habeo tibi gratiam plurimam; dominus rependat <lb xml:id="p1z9"/>isti tuę erga nos benevolentię.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>Ante quatriduum interrogavi dominum <persName ref="p8018">Hallerum</persName> com<lb xml:id="p1z11"/>patrem meum, num quid in ipsius caussa <lb xml:id="p1z12"/>egerint <placeName ref="l41">Bernates</placeName>; respondit, quod ipse sciat <lb xml:id="p1z13"/>nihil plane; tacere illos, taciturum se quoque, <lb xml:id="p1z14"/>donec terminus adveniat, ut hinc migret.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Id ubi percepi, constituebam accedere D. <lb xml:id="p1z16"/><persName ref="p8018">Hallerum</persName> (nam reliquorum senatorum nemo <lb xml:id="p1z17"/>est, qui aliquid familiaritatis ostendat) <lb xml:id="p1z18"/>illudque monere in tempore; verum ecce, <lb xml:id="p1z19"/>quod intervenerit.</s>
					<s n="6" xml:lang="la">Audio illum laborare <lb xml:id="p1z20"/>graviter ex podagra; videbatur importunum <lb xml:id="p1z21"/>fore, si sic laborantem interpellarem.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z22"/>Mox altera imcommoditas nascitur domi <lb xml:id="p1z23"/>meae, per quam rursus impedior; nam <lb xml:id="p1z24"/><persName ref="p20454">Iudith</persName> filia mea natu grandior 17. mensis <lb xml:id="p1z25"/>huius peste correpta est et hodie inter <lb xml:id="p1z26"/>nonam et decimam promeridianam <lb xml:id="p1z27"/>ex hoc saeculo ad coelestem patriam evocata.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z28"/>Quapropter sic in moerore sumus ac <lb xml:id="p1z29"/>luctu, ut nihil eorum agere potuerim, <lb xml:id="p1z30"/>quę constitueram.</s>
					<s n="9" xml:lang="la">Manus domini tangit nos.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z31"/>Verum oro illius misericordiam, ut nos in <lb xml:id="p1z32"/>gratia sua et veritate conservet; obsecro, <lb xml:id="p1z33"/>commendes nos illius providentię.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Ecclesiasti<lb xml:id="p1z34"/>cas historias ad te misi 21. octobris <lb xml:id="p1z35"/>nec dubito, quin acceperis.</s>
					<s n="12" xml:lang="la" ana="farewell">Optime vale, com<lb xml:id="p1z36"/>pater charissime.</s>
					<s n="13" xml:lang="la" ana="salute">Dominus te cum tuis omnibus conservet, <lb xml:id="p1z37"/>quos salvere iubeas meo ac meorum nomine.</s>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z38"/>Salutem etiam dominis ac fratribus isthic et <persName ref="p8440">Ger<lb xml:id="p1z39"/>vasio</persName> nostro, cui utinam prospiciatur in <pb/><lb xml:id="p2z1"/><placeName ref="l2">Arow</placeName>; posset enim nunc illo vocari in locum <lb xml:id="p2z2"/>Christiani, qui ad diaconatum huius nostrę <lb xml:id="p2z3"/>ecclesię vocatur.</s>
				</p>
				<p>
					<s n="15" xml:lang="de"><placeName ref="l41">Bernę</placeName> 21. novembris <lb xml:id="p2z4"/>1549.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z5"/><persName ref="p8417">W[olfgangus] Musculus</persName> compater <lb xml:id="p2z6"/>tuus in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="17" xml:lang="la"><lb xml:id="p2z7"/>Praestantissim<lb xml:id="p2z8"/>o theologo <lb xml:id="p2z9"/>M. <persName ref="p495">Hei<lb xml:id="p2z10"/>nrycho Bullingero</persName>, <lb xml:id="p2z11"/><placeName ref="l587">Tigurinę</placeName> eccles<lb xml:id="p2z12"/>iae pastori fidelissimo, compatri i<lb xml:id="p2z13"/>n Christo ch<lb xml:id="p2z14"/>arissimo.</s>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
