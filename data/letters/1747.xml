	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la">Etsi nihil habeam, quod scribendi necessitatem efflagitet, <lb xml:id="p1z2"/><persName ref="p495">Bullingere</persName> ornatissime, attamen hunc literis meis plane vacuum <lb xml:id="p1z3"/>abire nequaquam passus sum, qui scribendi ad amicos quam <lb xml:id="p1z4"/>minimam occasionem non intermittere soleo, nisi gravioribus <lb xml:id="p1z5"/>impediatur.</s>
					<s n="3" xml:lang="la">Nunciata est mihi his diebus mors doctoris <lb xml:id="p1z6"/><persName ref="p8374">Hedionis</persName> funestissima, qui vigesimo huius mensis <lb xml:id="p1z7"/>die in domino magno <placeName ref="l491">Argentinensis</placeName> ecclesiae planctu <lb xml:id="p1z8"/>obdormivit; utinam ut tantorum virorum funera <lb xml:id="p1z9"/>non verbi divini per <placeName ref="l822">Germaniam</placeName> famem ingentem <lb xml:id="p1z10"/>nobis portendant.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><persName>Caesar</persName> a <placeName ref="l832">Gallo</placeName> ad quatuor tantum <lb xml:id="p1z11"/>milliaria distare dicitur <placeName ref="l822">Germanica</placeName>, quo <lb xml:id="p1z12"/>fit, ut subinde aliquid novi expectemus, sive boni <lb xml:id="p1z13"/>sive mali, ut deus dederit.</s>
					<s n="5" xml:lang="la"><persName>Dux de Alba</persName> <placeName ref="l322">Metim</placeName> <lb xml:id="p1z14"/>dum properavit cum suo equitatu, ut urbem iam a <lb xml:id="p1z15"/>Caesare obsidendam specularetur, a <placeName ref="l832">Gallis</placeName> sive <placeName ref="l822">Germa<lb xml:id="p1z16"/>nis</placeName>, qui in pręsidio erant, magno impetu adortus <lb xml:id="p1z17"/>vix fuga evasisse vigesimo octobris die neque <lb xml:id="p1z18"/>multos amisisse dicitur.</s>
					<s n="6" xml:lang="la">De marchione <placeName>Brandebu<lb xml:id="p1z19"/>rgensi</placeName> nihil certi audio, cui tamen multi male fidunt.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z20"/>Princeps a <placeName ref="l1716">Mansfeld</placeName> cum viginti quatuor signis <lb xml:id="p1z21"/>peditum et mille equitibus ex <placeName ref="l20">Inferiori Germania</placeName> adventare <lb xml:id="p1z22"/>dicitur, ut Gallo nimirum succurrat aut Caesaris <lb xml:id="p1z23"/>transitum per <placeName ref="l2459">Rhenum</placeName> impediat.</s>
					<s n="8" xml:lang="la">Orandus et exo<lb xml:id="p1z24"/>randus est deus, ut <placeName ref="l822">Germaniam</placeName> a tantorum tyrannorum <lb xml:id="p1z25"/>improbitate demum liberet, conservet pios et tueatur <lb xml:id="p1z26"/>forti brachio suam ecclesiam adversus antichristum et <lb xml:id="p1z27"/>portas inferorum.</s>
					<s n="9" xml:lang="la">Amen.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l28">Basileę</placeName> 28. octobris <lb xml:id="p1z28"/>anno 1552.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z29"/>T[uus] <persName ref="p8406">Conradus Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Spectatę eruditionis viro d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z4"/>vigilantissimo, amico incom<lb xml:id="p2z5"/>parabili.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
