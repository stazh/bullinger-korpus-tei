	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p8024">Christophorus dei gratia comes Palatinus <lb xml:id="p1z2"/>Reni, dux Bavariae</persName> etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Salutem in domino Iesu Christo salvatore nostro.</s>
					<s n="3" xml:lang="la" ana="salute"><lb xml:id="p1z4"/>Litterae tuae, vir reverende, quibus mihi adolescentem <persName ref="p8081">Johannem <lb xml:id="p1z5"/>Philippum</persName>, <persName ref="p3619">Ulrici Philippi, baronis ab Alto Saxo</persName> etc. filium, commendas <lb xml:id="p1z6"/>petisque, ut eum in familiam meam recipiam, libenter accepi, <lb xml:id="p1z7"/>tum quod iamdudum mihi offerri tibi gratificandi con<lb xml:id="p1z8"/>ditionem desiderarem, tum etiam, quod hanc mihi dari occasionem <lb xml:id="p1z9"/>te salutandi gaudeam, nimirum quod praesens ex itinere <lb xml:id="p1z10"/>te convenire vestramque ecclesiam et rempublicam videre, ut certo <lb xml:id="p1z11"/>decreveram, ob pestis in <placeName ref="l587">Tigurino</placeName> agro et urbe grassantis me<lb xml:id="p1z12"/>tum non licuerit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z13"/>Ad praesens quod attinet, tale est, ut me studiorum causa <lb xml:id="p1z14"/>peregrinantem atque in illustrissimi principis <persName ref="p8060">Friderici Palatini</persName> <lb xml:id="p1z15"/>electoris et parentis mei potestate constitutum absque celsitudinis <lb xml:id="p1z16"/>suae consensu atque mandato illud, etiamsi maxime cupiam, <lb xml:id="p1z17"/>aggredi non deceat.</s>
					<s n="5" xml:lang="la">Spero tamen me apud celsitudinem <lb xml:id="p1z18"/>suam effecturum, ut senatus <placeName ref="l587">Tigurinus</placeName> et tu in hoc qualiquali <lb xml:id="p1z19"/>officii genere intelligatis me et patriae vestrae et tibi saltem <lb xml:id="p1z20"/>bene velle.</s>
					<s n="6" xml:lang="la">Interim me tuis tuaeque ecclesiae precibus commendo.</s>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z21"/>Bene vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Datum <placeName ref="l167">Genevae</placeName> ipsis calendis ianuarii <lb xml:id="p1z22"/>anno 1567.</s>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p4z1"/>Reverendo viro <persName ref="p495">Heinrico Bullingero</persName>, ecclesiae <lb xml:id="p4z2"/><placeName ref="l587">Tigurinae</placeName> pastori fidelissimo etc<lb xml:id="p4z6"/>.</s>
				</p>
				<p>
					<note type="author">[Bemerkung von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="10" xml:lang="de"><lb xml:id="p4z7"/><persName ref="p8024">Christoff</persName> der jung pfaltzgraff von <lb xml:id="p4z8"/>des jungen herren <persName ref="p8081">von Sax</persName> wägen.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>