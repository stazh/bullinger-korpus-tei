	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Copiam litium attulit, ve<lb xml:id="p1z2"/>nerande mi <persName ref="p1365">Grynęe</persName>, qui <persName ref="p467">Buceri</persName> copiosam apologiam<note xml:id="fn1" type="footnote" n="1">Oben <ref target="file11148">Nr. 1105</ref>.</note> <lb xml:id="p1z3"/>attulit<note xml:id="fn2" type="footnote" n="2">Überbringer des Briefes war laut einer Mitteilung von <persName ref="p8418">Myconius</persName> an <persName ref="p467">Bucer</persName> vom 27. März "scriba noster", d. h. wohl der Basler Stadtschreiber <persName ref="p2804">Heinrich Ryhiner</persName> (s. Zürich ZB, Ms F 81, 362).</note>.</s>
					<s n="3" xml:lang="la">De hac nihil nunc dico, quam quod omne iuditium <lb xml:id="p1z4"/>deo iusto iudici<note xml:id="fn3" type="footnote" n="3">Vgl. <cit type="bible"><ref>Ps 7. 12</ref></cit>.</note> committo.</s>
					<s n="4" xml:lang="la">Non contendam cum <lb xml:id="p1z5"/>homine amplius, nisi aliud suggesserit spiritus<note xml:id="fn4" type="footnote" n="4">Vgl. <cit type="bible"><ref>Joh 14, 26</ref></cit>.</note>, neque <lb xml:id="p1z6"/>prius contendi aut tam maliciose scripsi, ut ipse <lb xml:id="p1z7"/>scriptum interpretatur.</s>
					<s n="5" xml:lang="la">Pluris faciam et meam et publicam <lb xml:id="p1z8"/>tranquillitatem quam privatam vindictam.</s>
					<s n="6" xml:lang="la">Interim, quod <lb xml:id="p1z9"/>pridem testatus sum, non odi <persName ref="p467">Bucerum</persName>, nullas in <lb xml:id="p1z10"/>eum vel privatim vel publice iis literis exceptis<note xml:id="fna" type="footnote" n="a">iis literis exceptis <hi>am Rande nachgetragen.</hi></note> accusationes protuli.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>Sit ergo animo tranquillo.</s>
					<s n="8" xml:lang="la">Porro nostram ecclesiam curabimus, <lb xml:id="p1z12"/>ipse suam curet.</s>
					<s n="9" xml:lang="la">Quod omnes literae eius nihil <lb xml:id="p1z13"/>aliud habent quam „conveniatur, indicatur conventus, <lb xml:id="p1z14"/>conferamus, disputemus, iudicent sancti“, nos non pu<lb xml:id="p1z15"/>tamus singulis conveniendum mensibus neque vi<lb xml:id="p1z16"/>detur usqueadeo necessarium<pb type="edition" next="117"/> aut fructuosum.</s>
					<s n="10" xml:lang="la">Convenerunt <lb xml:id="p1z17"/><placeName ref="l41">Bernae</placeName>; disputatum est diebus 20<note xml:id="fn5" type="footnote" n="5">Zur Beteiligung <persName ref="p467">Bucers</persName> an der <placeName ref="l41">Berner</placeName> Disputation vom Januar 1528 s. <bibl source="b135">BucerDS</bibl> IV 15-160.</note>.</s>
					<s n="11" xml:lang="la">Convenerunt <lb xml:id="p1z18"/>saepe <placeName ref="l587">Tiguri</placeName>, saepe <placeName ref="l28">Basileae</placeName><note xml:id="fn6" type="footnote" n="6">Zu denken ist etwa an das Theologengespräch von Anfang September 1530 in <placeName ref="l587">Zürich</placeName> (s. <hi>Köhler,</hi> ZL II 228-233), den Besuch <persName ref="p467">Bucers</persName> in <placeName ref="l587">Zürich</placeName> und <placeName ref="l28">Basel</placeName> im Oktober desselben Jahres (s. <hi>Köhler,</hi> ZL II 243) sowie die Tagsatzung vom 13. Februar 1531 in <placeName ref="l28">Basel</placeName> (s. <hi>Köhler,</hi> ZL II 265-267).</note>, item <placeName ref="l311">Marpurgi</placeName><note xml:id="fn7" type="footnote" n="7">Zum <placeName ref="l311">Marburger</placeName> Religionsgespräch von 1529 s. Gerhard <hi>May,</hi> in: <bibl source="b641">TRE</bibl> XXII 75-79 (mit weiterer Lit.).</note>.</s>
					<s n="12" xml:lang="la">Nos ter <lb xml:id="p1z19"/>convenimus <placeName ref="l28">Basileae</placeName><note xml:id="fn8" type="footnote" n="8">Gemeint sind die Tagungen des Jahres 1536 (s. <hi>Köhler,</hi> ZL II 412-416. 493-496. 498f).</note>.</s>
					<s n="13" xml:lang="de">Wenn wers ouch gnuͦg?</s>
					<s n="14" xml:lang="la">Nos <lb xml:id="p1z20"/>tenemus religionis verae summam<note xml:id="fn9" type="footnote" n="9">Nämlich das Erste <placeName ref="l862">Helvetische</placeName> Bekenntnis von 1536 (<bibl source="b132">BSRK</bibl> 101-109) bzw. dessen Auslegung im Brief der reformierten Städte der <placeName ref="l862">Eidgenossenschaft</placeName> an <persName ref="p1974">Luther</persName> vom 12. Januar 1537 (<bibl source="b671">WA</bibl> Briefwechsel XII 241-275, Nr. 4268).</note>.</s>
					<s n="15" xml:lang="la">In hac perseve<lb xml:id="p1z21"/>rabimus.</s>
					<s n="16" xml:lang="la">Non disputabimus de hac ut incerta in <lb xml:id="p1z22"/>dies.</s>
					<s n="17" xml:lang="la">Quem hactenus laesimus concionibus aut scriptis <lb xml:id="p1z23"/>nostris?</s>
					<s n="18" xml:lang="la">Legisti, opinor, libros ad regem <placeName ref="l830">Angliae</placeName> <lb xml:id="p1z24"/>scriptas<note xml:id="fn10" type="footnote" n="10">"De scripturae sanctae authoritate ... ad sereniss. <placeName ref="l830">Angliae</placeName> regem <persName ref="p8375">Heinrychum VIII.</persName> <persName ref="p495">Heinrychi Bullingeri</persName> libri duo", Zürich 1538 (<bibl source="b286">HBBibl</bibl> I 111).</note>.</s>
					<s n="19" xml:lang="la">In his quid peccavi?</s>
					<s n="20" xml:lang="la">Quid in illis poterit <lb xml:id="p1z25"/>displicere piis adeoque ipsi <persName ref="p1974">Luthero</persName>, cui <lb xml:id="p1z26"/>exemplum misi additis simul amicissimis literis<note xml:id="fn11" type="footnote" n="11">Oben <ref target="file11157">Nr. 1114</ref>.</note>?</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z27"/>Concordiam, non discordiam quaero.</s>
					<s n="22" xml:lang="la">Quod si <persName ref="p467">Bucerus</persName> <lb xml:id="p1z28"/>ad diem illam sive conventum Helveticis tantum urbibus <lb xml:id="p1z29"/>indictum<note xml:id="fn12" type="footnote" n="12">Am 27. März hatte <placeName ref="l587">Zürich</placeName> die evangelischen Städte der <placeName ref="l862">Eidgenossenschaft</placeName> zu einer Tagung eingeladen, die am 28. April in <placeName ref="l587">Zürich</placeName> beginnen sollte (Entwurf der Einladungsschreiben an <placeName ref="l41">Bern</placeName> und <placeName ref="l28">Basel</placeName> in Zürich StA, B IV 9, 97r. und v.; vgl. <hi>Bizer,</hi> Abendmahlsstreit 218).</note> venerit, metuo magnam concertationem.</s>
					<s n="23" xml:lang="la"><lb xml:id="p1z30"/>Forte negotium melius sine eo perficeretur.</s>
					<s n="24" xml:lang="la">Sed <lb xml:id="p1z31"/>fiat voluntas domini.</s>
					<s n="25" xml:lang="la">Haec ad cor tuum, mi <persName ref="p1365">Grynęe</persName>, <lb xml:id="p1z32"/>dictum puta.</s>
				</p>
				<p>
					<s n="26" xml:lang="la" ana="salute">Salutabis <persName ref="p8418">Myconium</persName>.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 30. <lb xml:id="p1z33"/>martii 1538.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p1z34"/>Tuus ut semper ex animo <lb xml:id="p1z35"/><persName ref="p495">H. Bullingerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="29" xml:lang="la"><pb/><lb xml:id="p2z1"/>Charissimo suo <persName ref="p1365">Simoni Gryneo</persName> <lb xml:id="p2z2"/>ad manus proprias.</s>
					<s n="30" xml:lang="de"><lb xml:id="p2z3"/>Dem herren <persName ref="p1365">Si<lb xml:id="p2z4"/>moni Gryneo</persName>.</s>
				</p>
			</div>
