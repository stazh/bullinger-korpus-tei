	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
					<s n="2" xml:lang="la"><persName ref="p6382">Ioannes Adamus Schad</persName>, conterraneus tuus, <lb xml:id="p1z2"/>meus autem concivis, hisce diebus me convenit significans se, <lb xml:id="p1z3"/>cum iam paupertate premeretur bonisque suis exutus esset, eo re<lb xml:id="p1z4"/>dactum, ut alia via rationibus suis consulere cogeretur quam antehac, <lb xml:id="p1z5"/>petiitque, ut ipsi mutuo darem aliquantam summam pecuniarum, <lb xml:id="p1z6"/>ut sibi isthic merces comparare queat, quibus sperat se facile et cum fructu <lb xml:id="p1z7"/>victurum.</s>
					<s n="3" xml:lang="la">Ego cum pecunias non haberem in numerato nollem<lb xml:id="p1z8"/>que amicum inopem penitus reiicere, hac via me ipsius necessitati consulturum <lb xml:id="p1z9"/>speravi, si erga <persName>Ioannem Rempf</persName>, qui eiusmodi merces venditat, <lb xml:id="p1z10"/>sponsor essem pro decem guldinis, quos vocant, ut nisi in an<lb xml:id="p1z11"/>num eos creditori renumeret, ego ipsi absque aliqua ipsius noxa <lb xml:id="p1z12"/>satisfacerem.</s>
					<s n="4" xml:lang="la">Placuit ipsi negotium; veretur tamen, cum ipsi ne a faci<lb xml:id="p1z13"/>e quidem cognitus sim, ne non abhorreat a mea fideiussione.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z14"/>Quare te vel meo nomine oratum velim, non ut pro me spondeas, sed <lb xml:id="p1z15"/>hoc solum, ut ipsi significes meas res non tam esse accisas, quin pro hac <lb xml:id="p1z16"/>summa ipsi possim adhuc esse numerando.</s>
					<s n="6" xml:lang="la">Gratissimum utrique re<lb xml:id="p1z17"/>m feceris; miseret enim me pauperis amici neque alia via ipsi <lb xml:id="p1z18"/>consulere potero.</s>
					<s n="7" xml:lang="la">Novi nil habeo, quod scribam.</s>
					<s n="8" xml:lang="la" ana="farewell">Quare va<lb xml:id="p1z19"/>le ac vive Christo ac nobis diu incolumis.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale iterum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Raptim.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/><placeName ref="l441">Scaffhusii</placeName> anno 1557.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z21"/>Tuus ex animo <lb xml:id="p1z22"/><persName ref="p3481">Simpertus Vogt</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio viro <persName ref="p495">Henrycho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>pastori vigi<lb xml:id="p2z4"/>lantissimo, domino ac <lb xml:id="p2z5"/>fratri suo charissimo.</s>
					<s n="14" xml:lang="de"><placeName ref="l587">Zü<lb xml:id="p2z6"/>rich</placeName>.</s>
				</p>
			</div>
		</body>
