	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Citius tuis literis scriptis 24. novembris non respondi, <lb xml:id="p1z2"/>quod nihil exigere videbatur.</s>
					<s n="3" xml:lang="la">Scripseram ad te antea <lb xml:id="p1z3"/><placeName ref="l1209">Navarre</placeName> regem esse <placeName ref="l367">Aurelie</placeName> cum rege et fratrem, <lb xml:id="p1z4"/>principem a <persName>Conde</persName>, captivum ibi detineri.</s>
					<s n="4" xml:lang="la">Fama est ex primoribus <lb xml:id="p1z5"/>multos usos esse <placeName>Alcibiadis</placeName> consilio: cum licet fugere, <lb xml:id="p1z6"/>litem ne quęsieris.</s>
					<s n="5" xml:lang="la">Sed multis in locis non pauci in <lb xml:id="p1z7"/>carceres sunt coniecti, quod existimentur abusi regis clementia <lb xml:id="p1z8"/>et iuvasse motus, atque cardinalis <persName ref="p7314">Turnonius</persName> e <placeName ref="l425">Roma</placeName> nova <lb xml:id="p1z9"/>attulit consilia obtinuitque, ut probaretur continuatio consilii <lb xml:id="p1z10"/><placeName ref="l1107">Tridentini</placeName> antea suffragiis omnibus improbata.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Decima die <lb xml:id="p1z11"/>huius mensis incipient comitia vel totius <placeName ref="l832">Gallie</placeName> consilium <lb xml:id="p1z12"/>apud <placeName ref="l367">Aurelios</placeName>, ubi sunt adhuc aliquot insignia militum <lb xml:id="p1z13"/>ad incutiendum timorem novarum rerum cupidis.</s>
					<s n="7" xml:lang="la">Legati <lb xml:id="p1z14"/>ducis <placeName ref="l2478">Sabaudie</placeName> et <placeName ref="l41">Bernatum</placeName> <placeName ref="l339">Neocomo</placeName> discesserunt re infecta, <lb xml:id="p1z15"/>et dilata omnia in decimum februarii.</s>
					<s n="8" xml:lang="la">Qui <placeName ref="l300">Lucerne</placeName> erant, <lb xml:id="p1z16"/>hac transierunt confecto foedere cum <placeName ref="l2448">5 Pagis</placeName> et <placeName ref="l760">Soludorensibus</placeName>.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/>Non puto 5 Pagos quicquam moturos ante comitia proximi mensis; <lb xml:id="p1z18"/>coierant ob cuiusdam baillivi <persName>Freuwler</persName> verba.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Sunt, qui apud eos <lb xml:id="p1z19"/>fasces accendant et fallere conentur, ut se in prędam et <lb xml:id="p1z20"/>periculum coniiciant.</s>
					<s n="11" xml:lang="la">Mitto ad te summam eorum, que ad me <lb xml:id="p1z21"/>ex <placeName ref="l834">Italia</placeName> scripta sunt, que domino <persName ref="p8111">Martiri</persName> communia erunt cum <lb xml:id="p1z22"/>salutatione et amicis.</s>
					<s n="12" xml:lang="la">Si quid novi habueris, ad nos <lb xml:id="p1z23"/>scribas, ne postarum equi ocio nimio pereant.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z24"/><placeName ref="l760">Solut[uri]</placeName> 2. decembris.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z25"/>Tuus ex animo.</s>
				</p>
				<p>
					<note>[Von anderer Hand:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bulingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>pastori vigilantissimo.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
