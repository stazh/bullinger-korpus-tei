	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam e<lb xml:id="p1z2"/>t pacem a <lb xml:id="p1z3"/>deo patre per Christum servatorem etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Decreverunt <lb xml:id="p1z4"/>domini nostri scholarchae<lb xml:id="p1z5"/>, viri ac fratres in Christo unice amandi, ut vobis singulis vini rufi veteris do<lb xml:id="p1z6"/>liolum transmitteretur, non quo par pari redde<lb xml:id="p1z7"/>re vellent tam pro libris bibliothecae nostrae donatis quam pro vestri singulari cura et diligentia, quam hact<lb xml:id="p1z8"/>enus declarastis erga ecclesiae nostrae alumnos, <lb xml:id="p1z9"/>sed quo vel aliquam sig<lb xml:id="p1z10"/>nificationem darent grati ac benevoli erga vos animi.</s>
					<s n="3" xml:lang="la">Quod hactenus dilatum fuit, eius re<lb xml:id="p1z11"/>i rationem novit d. <persName ref="p8011">Gvaltherus</persName>; sed sat cito, si sat bene.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Vinum est sumptum ex uno dolio.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Oeconomus noster vol<lb xml:id="p1z12"/>uit, ut vini de bonitate delectus et iudicium penes me esset ex omnibus vinis.</s>
					<s n="6" xml:lang="la">Igitur si quid hac in <lb xml:id="p1z13"/>parte erratum este, mihi imputetur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Si palatum <persName ref="p1214">Frisii</persName> habuissem, non aberra<lb xml:id="p1z15"/>ssem.</s>
					<s n="8" xml:lang="de">Ich gloub aber, ich sye zum rächten boden <lb xml:id="p1z16"/>gangen.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Iudicium eius rei penes vo<lb xml:id="p1z17"/>s habetis.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Nomina vestra tum rufa tum <lb xml:id="p1z18"/>candida creta doliis ins<lb xml:id="p1z19"/>cripsi; ea cuilibet suum re<lb xml:id="p1z20"/>ddent.</s>
					<s n="11" xml:lang="la" ana="farewell">Interim valete ac v<lb xml:id="p1z21"/>ivite diu ecclesię Christi inco<lb xml:id="p1z22"/>lumes<lb xml:id="p1z23"/>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Salutant vos sym<lb xml:id="p1z24"/>mystae mei.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Salvos cu<lb xml:id="p1z25"/>pio dominos <persName ref="p8171">Bibli<pb/><lb xml:id="p2z1"/>andrum</persName>, <persName ref="p8111">Martyrem</persName>, <persName ref="p3988">Volfium</persName>, <persName ref="p1453">Hallerum</persName>, omnes.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Raptim <placeName ref="l441">Sca<lb xml:id="p2z2"/>fhusii</placeName> 6. novembris anno 1558.</s>
					<s n="15" xml:lang="la">Vester totus ex animo <persName ref="p3481">Simpert<lb xml:id="p2z3"/>us Vogt</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="de">Den wolgelerten herren m. <persName ref="p495">Heinrichen Bullinger</persName>, <lb xml:id="p2z4"/><persName ref="p8011">Ruͦdolffen Gvalthern</persName>, m. <persName ref="p1214">Hans Frieß</persName>, sinen günstig<lb xml:id="p2z5"/>en herren, zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
