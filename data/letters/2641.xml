	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime <persName ref="p495">Bullingere</persName>, princeps noster illustrissimus accepit d. <persName ref="p20206">Gri<lb xml:id="p1z2"/>baldum</persName> cum clementia, qua speravi, ascivit eum sib<lb xml:id="p1z3"/>i consiliarium, constituit professorem in schola <placeName ref="l512">Tubin<lb xml:id="p1z4"/>gensi</placeName> cum honorifico stipendio.</s>
					<s n="2" xml:lang="la">Quare laetus redit <lb xml:id="p1z5"/>ad vos, ut domum eat, intra 4 septimanas huc venturus.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Laus domino.</s>
					<s n="4" xml:lang="la">Laetor me talem virum <lb xml:id="p1z7"/>ac velut talem praedam adduxisse nunc mecum <lb xml:id="p1z8"/>in ducatum.</s>
					<s n="5" xml:lang="la">Audi nunc nova: de pace credunt <lb xml:id="p1z9"/>sapientes viri nihil esse futurum.</s>
					<s n="6" xml:lang="la">Uterus <persName ref="p18212">Mariae</persName>, <lb xml:id="p1z10"/><placeName ref="l830">Anglorum</placeName> reginae, in ventum abivit.</s>
					<s n="7" xml:lang="la"><persName ref="p3590">Philippus</persName> scrib<lb xml:id="p1z11"/>it militem per <placeName ref="l822">Germaniam</placeName>, putant, ut in <placeName ref="l830">Angliam</placeName> <lb xml:id="p1z12"/>adducat.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><persName ref="p1825">Poloniae rex</persName> celebrat comitia <placeName ref="l260">Graco<lb xml:id="p1z13"/>viae</placeName>, ubi speramus eum recepturum nostras re<lb xml:id="p1z14"/>formationes; favet eius conthoralis, etiamsi <persName ref="p18477">Ferdi<lb xml:id="p1z15"/>nandi</persName> sit filia.</s>
					<s n="9" xml:lang="la">Suscepi eam ego e sacro fonte, <lb xml:id="p1z16"/>quare fiat praesagium mutationis religionis <lb xml:id="p1z17"/>in ea.</s>
					<s n="10" xml:lang="la">De comitiis vide in his literis d. <persName>legati</persName> <lb xml:id="p1z18"/>electoris <placeName ref="l749">Saxonici</placeName> quid fiat.</s>
					<s n="11" xml:lang="la">Proximior sedi antichristi <lb xml:id="p1z19"/>erat <persName>Theatinus</persName>, quo praeter mortuum <persName ref="p8498">Marcellum</persName> <lb xml:id="p1z20"/>nemo est in toto terrarum orbe inimicitior e<lb xml:id="p1z21"/>vangelio; fuit aliquando ex ea secta, <lb xml:id="p1z22"/>quam Iesuitarum appellant, dignus in summa, <lb xml:id="p1z23"/>qui illic sedeat.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Classis <placeName ref="l2510">Turcarum</placeName> rediit, <lb xml:id="p1z24"/>ubi audivit agi de pace inter christianos.</s>
					<s n="13" xml:lang="la">Fama <lb xml:id="p1z25"/>est <persName>Maximilianum</persName> <placeName ref="l2449">Bohemiae</placeName> regem com<lb xml:id="p1z26"/>municasse sub utraque; certe d. <persName ref="p1340">Ludovicus Grem<lb xml:id="p1z27"/>pius</persName> iureconsultus rediens <placeName ref="l18">Augustam</placeName> mihi affirmavit, <lb xml:id="p1z28"/>patrem vero excandisse et episcopum <placeName>Labacensem</placeName> <pb/><lb xml:id="p2z1"/>ad filium ablegasse confestim.</s>
					<s n="14" xml:lang="la">Tolletur ab <placeName ref="l875">Hispanis</placeName>, <lb xml:id="p2z2"/>si hoc egit.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Tu scis, quid dixerim tibi in eo <lb xml:id="p2z3"/>articulo magni momenti, nempe quod non sitis <lb xml:id="p2z4"/>exclusi ab amicitia etc. neque ullum incommodum <lb xml:id="p2z5"/>adversum vos adornetur, quum hec recitassem, <lb xml:id="p2z6"/>quid dixerim, ratum habuerim et laudarunt e<lb xml:id="p2z7"/>tiam me.</s>
					<s n="16" xml:lang="la">Quare exuite omnem solicitudinem.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z8"/>Si quid vicissim habes, <persName ref="p495">H. Bullingere</persName>, mone me; nam <lb xml:id="p2z9"/>dux datus est d. <persName ref="p20206">Gribaldo</persName> et rediens feret tuas <lb xml:id="p2z10"/>ad me.</s>
					<s n="18" xml:lang="la">Comendo tibi et omnibus meos <lb xml:id="p2z11"/>fratres <placeName ref="l294">Locarnenses</placeName>; in me certe existimabo <lb xml:id="p2z12"/>collatum, quicquid officiorum in eos contuleritis.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z13"/>Oro te, aliquid agas contra <persName>P. a Soto</persName>; suscipe <lb xml:id="p2z14"/>unum aut alterum articulum inprimis de traditio<lb xml:id="p2z15"/>nibus et tracta.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Iuvabis quidem ecclesiam, sed nulla <lb xml:id="p2z16"/>re magis poteris placere principi nostro.</s>
					<s n="21" xml:lang="la">Quis scit, quam <lb xml:id="p2z17"/>multa bona hinc deinde possint oriri.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="salute"><lb xml:id="p2z18"/>S<lb xml:id="p2z19"/>alvere iubeo d. consulem, tuos generos atque omnes <lb xml:id="p2z20"/>symmistas; orate pro me.</s>
					<s n="23" xml:lang="la"><lb xml:id="p2z21"/><placeName ref="l496">Stutgardiae</placeName> pridie kalendas iunii 1555.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p2z22"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p2z23"/>Comunica nova cum <lb xml:id="p2z24"/>d. <persName>Martino Mural</persName> to doctore.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
