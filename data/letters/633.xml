	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Indicuntur comitia per hunc <placeName ref="l21">Badenam</placeName> <lb xml:id="p1z2"/>ad 3. septembris futuram.</s>
					<s n="3" xml:lang="la">Hodie enim <placeName ref="l2450">Svicii</placeName> <lb xml:id="p1z3"/>nostris scribunt proscriptos aliquot <lb xml:id="p1z4"/>occidisse praesidem <persName>Mendresii</persName>, qui <placeName ref="l2450">Svicius</placeName> <lb xml:id="p1z5"/>fuit <persName>Mertz</persName> cognominatus, et cum praeside <lb xml:id="p1z6"/><persName>Osvaldum Wydlerum</persName>, scribam, et apposito<lb xml:id="p1z7"/>res duos, <foreign xml:lang="de">zwen weybel.</foreign></s>
					<s n="4" xml:lang="la">Causam non <lb xml:id="p1z8"/>scribunt, nec quales fuerint caesores aut <lb xml:id="p1z9"/>quorsum evaserint.</s>
					<s n="5" xml:lang="la">Nostri hortantur, omnem rem <lb xml:id="p1z10"/>diligenter perquirant, prudenter agant <lb xml:id="p1z11"/>ac mature, ne quid praecipitanter.</s>
					<s n="6" xml:lang="la">Haec <lb xml:id="p1z12"/>scilicet videntur malorum prognostica.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Multa <lb xml:id="p1z13"/>alia iungere his possem, si vacaret.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Hortemur ergo populum ad poenitentiam <lb xml:id="p1z15"/>et preces, ad constantiam et patientiam.</s>
					<s n="9" xml:lang="la">Roga, num <lb xml:id="p1z16"/>quid velit <persName ref="p1278">Gastius</persName> ad me scribere, <lb xml:id="p1z17"/><persName ref="p8101">Laelius</persName> et <persName ref="p714">Caelius</persName>; hic enim ta<lb xml:id="p1z18"/>bellio ad me tuto omnia perferret; est enim vir bonus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z19"/>Vale cum tuis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l587">Tig<lb xml:id="p1z20"/>uri</placeName> 17. <lb xml:id="p1z21"/>augusti 1549.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p8418">Osvaldo Myconio</persName>, <lb xml:id="p2z2"/>domino et fratri <lb xml:id="p2z3"/>colendissimo suo.</s>
					<s n="14" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
