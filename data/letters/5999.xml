	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Si retineri posset in <placeName ref="l648">Rhetia</placeName> d. <lb xml:id="p1z2"/><persName ref="p4037">Zanchus</persName>, vir in rebus ecclesiae utilissimus <lb xml:id="p1z3"/>et toti <placeName ref="l648">Rhetiae</placeName> necessarius, pr<lb xml:id="p1z4"/>udentissime et optime fieret; sed <lb xml:id="p1z5"/>oportebat provideri viro tanto, ne <lb xml:id="p1z6"/>indigeret re ulla etc.</s>
				</p>
				<p>
					<note>[Zettel ohne Datum, Unterschrift und Adresse.]</note>
				</p>
			</div>
		</body>
	</text>
