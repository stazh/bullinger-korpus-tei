	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Cum tu, mi pater, valetudine tam infirma adeo non modo humaniter, <lb xml:id="p1z2"/>verum etiam copiose ad me scribas, pudet me brevitatis mearum literarum <lb xml:id="p1z3"/>et non minus pudet inanibus nugis te obtundere, cum alioqui <lb xml:id="p1z4"/>praeter nugas nihil fere habeamus et agamus.</s>
					<s n="3" xml:lang="la">Sed, quoniam hoc potissimum <lb xml:id="p1z5"/>est, gratias ingentes ago /agere?</s>
					<s n="4" xml:lang="la">habeo tibi meo et <persName>Ioannis</persName> nomine pro tuo <lb xml:id="p1z6"/>consilio, cui ille libenter acquiescit, nec minus grata nobis <lb xml:id="p1z7"/>fuere nova, quę ad nos misisti.</s>
					<s n="5" xml:lang="la">Speramus ecclesias <placeName ref="l832">Gallię</placeName> dei <lb xml:id="p1z8"/>beneficio in tranquilliorem statum restituendas.</s>
					<s n="6" xml:lang="la">Utinam vero <lb xml:id="p1z9"/>patrię nostrę communis melior esset status, ut non cogeremur a<lb xml:id="p1z10"/>liquam quodammodo lętitiam ex confoederatorum nostrorum clade percipere.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>Sed quoniam hęc volunt et persequuntur, suis his delitiis fruantur <lb xml:id="p1z12"/>et sentiant tandem, quę sit merces meretricis <persName>Babilonicę</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z13"/>Vale.</s>
					<s n="9" xml:lang="la" ana="salute">Salutant te nostri omnes.</s>
					<s n="10" xml:lang="la" ana="salute">Salutato mihi filias, sororem meam <lb xml:id="p1z14"/>et <persName ref="p2827">Henricum</persName> nostrum eumque hortare, ut brevi ad nos veniat, ne <lb xml:id="p1z15"/>uxor nimis eius desiderio tabescat.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">In <placeName ref="l173">Vulturina</placeName> 26. iunii.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p8442">Iosias Simlerus</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">C<pb/><lb xml:id="p2z1"/>larissimo viro domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>vigilantissimo ecclesię <placeName ref="l587">Tigurinę</placeName> pastori, <lb xml:id="p2z3"/>patri suo honorando.</s>
				</p>
				<p>
					<s n="14" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
