	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">De <placeName ref="l832">Gallicis</placeName> tumultibus nihil intelligo nisi spem esse <placeName ref="l1209">Navarre</placeName> regem <lb xml:id="p1z3"/>venturum <placeName ref="l378">Lutetiam</placeName> et ad aulam regis 20. huius mensis et illius fratrisque <lb xml:id="p1z4"/>adventu omnia fore quietiora.</s>
					<s n="3" xml:lang="la">Pontifex prae se fert optare concilium modo <lb xml:id="p1z5"/><placeName ref="l1107">Tridentinum</placeName> continuetur aut celebretur in alia <placeName ref="l834">Italie</placeName> urbe aut in <placeName ref="l736">Pedemontio</placeName>.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/><placeName ref="l822">Germanie</placeName> urbes omnes suspectas habet.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Hac loci contentione protrahetur <lb xml:id="p1z7"/>in tempus aliud vel potius in aliud seculum; aliquando Christus et electi <lb xml:id="p1z8"/>testimonium dicent de evangelio.</s>
					<s n="6" xml:lang="la">Si quid de conventu <placeName ref="l496">Stutgardiensi</placeName> <lb xml:id="p1z9"/>intellexeris aut de temporum ratione <placeName ref="l822">Germanie</placeName> et <placeName ref="l648">Rhetie</placeName>, ut me certiorem <lb xml:id="p1z10"/>facias, etiam atque etiam oro, nec timeas gravare postam, hospitem meum, <lb xml:id="p1z11"/>quem scis maximum habere stipendium, ut <placeName ref="l21">Badenam</placeName> usque tuto literas mittat <lb xml:id="p1z12"/>ad me perferendas, et quem potissimum et solummodo conservavi in eo <lb xml:id="p1z13"/>munere, ut sepius tuis literis frui possem.</s>
					<s n="7" xml:lang="la">Responsum expecto <lb xml:id="p1z14"/>liberale et regium ab amplissimo magistratu super regis honesta <lb xml:id="p1z15"/>postulatione iamque, quale optabam, habui a <placeName ref="l41">Bernatibus</placeName>.</s>
					<s n="8" xml:lang="la">Te servet <lb xml:id="p1z16"/>dominus incolumem.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Amicos communes salutabis nosque, quod facis, <lb xml:id="p1z17"/>amabis.</s>
					<s n="10" xml:lang="la"><placeName ref="l760">Soluturi</placeName> 3. octobris.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z18"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo<lb xml:id="p2z4"/>.</s>
				</p>
			</div>
		</body>
	</text>
