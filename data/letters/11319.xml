	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus et pax Christi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Adhuc quiescunt omnia, nec scitur, quid con<lb xml:id="p1z3"/>cessurus sit <persName ref="p18538">cęsar</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p18538">Kaiser Karl V.</persName> schob eine Stellungnahme zum <placeName ref="l157">Frankfurter</placeName> Anstand hinaus; vgl. <bibl source="b236">Fuchtel</bibl> 196-200.</note>.</s>
					<s n="3" xml:lang="la">Quidam optare videntur <lb xml:id="p1z4"/><placeName ref="l361">Nurenbergensem</placeName> conventum<note xml:id="fn2" type="footnote" n="2">Zum geplanten Religionsgespräch in <placeName ref="l361">Nürnberg</placeName> s. oben <ref target="file11304">Nr. 1261</ref>, Anm. 6.</note> freti bona spe <lb xml:id="p1z5"/>capi posse quosdam isto colloquio.</s>
					<s n="4" xml:lang="la">Quod ut <lb xml:id="p1z6"/>fiat, nos quoque optamus nichil tamen minus <lb xml:id="p1z7"/>credentes; negamus enim rhete evangelicum<note xml:id="fn3" type="footnote" n="3">In Anspielung auf Bibelstellen wie <cit type="bible"><ref>Mt 4, 18f</ref></cit>; vgl. etwa <bibl source="b671">WA</bibl> IV 633, 5-16.</note> <lb xml:id="p1z8"/>esse illas scandalis plenas concordantias<note xml:id="fna" type="footnote" n="a"><hi>korrigiert aus</hi> concordantiis.</note>, quando <lb xml:id="p1z9"/>scilicet non fidei reddenda ratio, sed discutiendu[m]<pb type="edition" next="149"/><note xml:id="fnb" type="footnote" n="b"><hi>Randtext im Einband verdeckt.</hi></note>, <lb xml:id="p1z10"/>quibus rationibus cum furibus et latronibus <lb xml:id="p1z11"/>ineas amicitiam.</s>
					<s n="5" xml:lang="la">Interim de nobis vix <lb xml:id="p1z12"/>sumus tam solliciti quam de vobis vestrisque <lb xml:id="p1z13"/>ecclesiis; veremur enim, ne vestrum aliquot <lb xml:id="p1z14"/>ad hoc quoque negotium rapiantur vel alliciantu<lb xml:id="p1z15"/>r.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Hoc vero si communibus votis fieret, <lb xml:id="p1z16"/>minus esset periculi; sed si cum nova scissio[ne]<note xml:id="fnc" type="footnote" n="c"><hi>Randtext im Einband verdeckt.</hi></note> <lb xml:id="p1z17"/>fiat, timendum est, ne ex uno malo nascant[ur]<note xml:id="fnd" type="footnote" n="d"><hi>Randtext im Einband verdeckt.</hi></note> <lb xml:id="p1z18"/>multa, quod dominus avertat.</s>
					<s n="7" xml:lang="la">Proxim[o]<note xml:id="fne" type="footnote" n="e"><hi>Randtext im Einband verdeckt.</hi></note> <lb xml:id="p1z19"/>tabellione addam alia forte; hęrent enim <lb xml:id="p1z20"/>adhuc omnia.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Interim vale, amantissime <lb xml:id="p1z21"/>in domino, nosque semper ama.</s>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z22"/><persName ref="p4082">Cuͦnradus</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p4082">Konrad Zwick</persName>.</note> frater et symmystę omnes salutant <lb xml:id="p1z23"/>te studiosissime.</s>
					<s n="10" xml:lang="la">Uxorem<note xml:id="fn5" type="footnote" ana="bio" n="5"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> tuam, matrem<note xml:id="fn6" type="footnote" ana="bio" n="6"><persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note> <lb xml:id="p1z24"/>et puellas<note xml:id="fn7" type="footnote" n="7">Gemeint sind <persName ref="p495">Bullingers</persName> Töchter <persName ref="p7224">Anna</persName>, <persName ref="p5608">Margaretha</persName> und <persName ref="p6609">Elisabeth</persName>.</note> omniaque tua<note xml:id="fnf" type="footnote" n="f">omniaque tua <hi>am Rande nachgetragen.</hi></note> salva iubeo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Ex <placeName ref="l257">Constantia</placeName>, 24. <lb xml:id="p1z25"/>maii 1539.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Tuus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p7201">Iacobum</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p7201">Jakob Zorn</persName>; vgl. oben <ref target="file11290">Nr. 1247</ref>.</note> illum, qui ex <placeName ref="l774">Turgoya</placeName> <lb xml:id="p1z27"/>iniuste pulsus nunc apud <lb xml:id="p1z28"/>v<lb xml:id="p1z29"/>os est, commendo tibi; nam <lb xml:id="p1z30"/>vere bonus est et magnam <lb xml:id="p1z31"/>iniuriam pertulit<note xml:id="fng" type="footnote" n="g"><hi>vor</hi> pertulit <hi>ein gestrichener Buchstabe.</hi></note>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tigurino</placeName> episcopo <lb xml:id="p2z3"/>insigniter pio, fratri <lb xml:id="p2z4"/>meo charissimo.</s>
				</p>
			</div>
		</body>
	</text>
