	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Explicare non possum, quam ego tuis literis scriptis prima aprilis <lb xml:id="p1z2"/>voluptatem cepi et quantum te in spiritu amplexus sim deumque <lb xml:id="p1z3"/>laudibus extulerim, quod incolumem te nobis servaverit.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Literas vero, <lb xml:id="p1z4"/>quas te scribis tradidisse <persName>Ioanni Ulricho</persName>, non recepi nec ullas <lb xml:id="p1z5"/>expecto, quę illi committentur; iuvenis enim est valde ingratus, ut nihil <lb xml:id="p1z6"/>dicam gravius.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Sed oro, ut per eos, qui <placeName ref="l301">Lugdunum</placeName> proficiscuntur, tuas <lb xml:id="p1z7"/>mittas literas <persName>Petro Sent</persName>, cuius filii sunt cum d. <persName ref="p8011">Galthero</persName>; nihil enim mihi <lb xml:id="p1z8"/>gratius accidere potest quam de tua valetudine et rebus scitu <lb xml:id="p1z9"/>dignis per te fieri certior.</s>
					<s n="5" xml:lang="la"><persName>Lętor</persName> <placeName ref="l648">Rhetię</placeName> turbas compositas legatorum <lb xml:id="p1z10"/>vestrorum opera et iure agi omnia.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Novum non est nostras profusiones multos <lb xml:id="p1z11"/>perdere nec consueta remedia multum posse, nec miror, si mihi <lb xml:id="p1z12"/>gratulentur amici, quod a tam inquietis <placeName ref="l2448">5 P[agicis]</placeName> evolaverim.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Sunt, qui <lb xml:id="p1z13"/>consulant, ut filium revocem; hic enim bone litere florent et satis pacata <lb xml:id="p1z14"/>videntur omnia, tametsi non desint otii turbatores, et qui classicum canant.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Tuam super ea re sententiam libenter intelligerem.</s>
					<s n="9" xml:lang="la" ana="salute">Salutabis meo <lb xml:id="p1z16"/>nomine amplissimum senatum et amicos omnes persuasum habens nihil mihi magis <lb xml:id="p1z17"/>in votis esse, quam ut tibi aliqua in re gratificari possim.</s>
					<s n="10" xml:lang="la" ana="salute">Salutat <lb xml:id="p1z18"/>etiam te plurimum uxor.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l378">Parisiis</placeName> 20. maii 1565.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z19"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tigurine</placeName> ecclesie pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
