	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non possum iam multis respondere et rescribere <lb xml:id="p1z2"/>propter festinum <persName ref="p8426">Rasdorferi</persName> abitum.</s>
					<s n="3" xml:lang="la">Illius heri causa <lb xml:id="p1z3"/>senatui proposita, hodie demum absoluta est; receptus est <lb xml:id="p1z4"/>ad hanc conditionem, quam suspensam hactenus illi, sed <lb xml:id="p1z5"/>difficulter admodum reservavi; successit tamen consilium, <lb xml:id="p1z6"/>quandoquidem a domino profectum erat.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Utinam tam foeli<lb xml:id="p1z7"/>citer <persName ref="p8417">Musculi</persName> causa succederet!</s>
					<s n="5" xml:lang="la">Sunt, qui in decla<lb xml:id="p1z8"/>ratione illa sua adhuc desyderent hoc, quod expositionem <lb xml:id="p1z9"/>EST vocabuli per significat non expresse ponat, cum tamen talia <lb xml:id="p1z10"/>ponat, quae necessario evincant sic exponendum esse EST; alio<lb xml:id="p1z11"/>qui omnia ruerent dogmata, quae tamen ipse asseruit.</s>
					<s n="6" xml:lang="la">Hoc <lb xml:id="p1z12"/>ut urgeant, facit, quod offenderunt in suis commentariis <lb xml:id="p1z13"/>locum, quo cavendum hanc expositionem esse monet.</s>
					<s n="7" xml:lang="la">Qui <lb xml:id="p1z14"/>quidem locum etiam mihi durissimus esse videtur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Haec vero tibi <lb xml:id="p1z15"/>tantum significo, ne iuditium nostrum nescias.</s>
					<s n="9" xml:lang="la">Quam vero <lb xml:id="p1z16"/>aegre hanc conditionem in adventum <persName ref="p8426">Rasdorfferi</persName> retinuerim, <lb xml:id="p1z17"/>exponam; nam hoc etiam te scire conveniens erit.</s>
					<s n="10" xml:lang="la">Venit hisce diebus <lb xml:id="p1z18"/>huc <persName>Adamus Piperinus</persName> (quem nosti) evocatus a suo filio, ludi<lb xml:id="p1z19"/>magistro <placeName ref="l1105">Burgdorffensi</placeName>, qui a quibusdam adductus erat <lb xml:id="p1z20"/>in spem, quod illi haec cessura esset conditio.</s>
					<s n="11" xml:lang="la">Venit itaque nihil <lb xml:id="p1z21"/>aliud expectans.</s>
					<s n="12" xml:lang="la">Cum autem intelligeremus, quibus machinis <lb xml:id="p1z22"/>hoc actum fuisset, et quod insciis nobis et dominis <placeName ref="l587">Tigurinis</placeName> <lb xml:id="p1z23"/>venisset et quod salarii tantum sequeretur quantitatem, effecimus, ut <lb xml:id="p1z24"/>non modo repulsam simplicem, sed et turpem passus sit a <lb xml:id="p1z25"/>principibus nostris, quorum tamen aliqui miserum hunc <lb xml:id="p1z26"/>hominem huic ecclesiae obtrudere conabantur.</s>
					<s n="13" xml:lang="la">Sed dissolvit dominus <lb xml:id="p1z27"/>ipsorum consilium et promovit nostrum, quod spero plurimum e re <lb xml:id="p1z28"/>ecclesiae futurum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Caeterum de consilio tuo nihil adhuc <lb xml:id="p1z29"/>aperui <persName ref="p4191">Apiario</persName>.</s>
					<s n="15" xml:lang="la">Scripsi proxime meum per quosdam nobiles, <lb xml:id="p1z30"/>quos interim tecum fuisse puto.</s>
					<s n="16" xml:lang="la">Scripseram illas literas ante <lb xml:id="p1z31"/>prandium; in prandio vero demum illos recognoscere <lb xml:id="p1z32"/>coepi, quod mihi aliquando <placeName ref="l512">Tubingae</placeName> apud D. <persName ref="p8113">Volmarium</persName> <lb xml:id="p1z33"/>familiares fuerint; ipsis vero statim abeuntibus literas <lb xml:id="p1z34"/>mutare non potui.</s>
					<s n="17" xml:lang="la">Sed non possum nunc plura.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Per <lb xml:id="p1z35"/>proximum nuntium tibi et D. <persName ref="p8417">Musculo</persName> plura scribam, quem <lb xml:id="p1z36"/>cum tua suaque familia optime valere opto.</s>
					<s n="19" xml:lang="la" ana="farewell">Vale, <lb xml:id="p1z37"/>colendissime et dilectissime pater.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l41">Bernae</placeName> 6. Octobris 1548.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><persName ref="p8018">I[oan<lb xml:id="p1z38"/>nes] H[allerus</persName>] perpet<lb xml:id="p1z39"/>uo tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro D. <persName ref="p495">Bullingero</persName>, <lb xml:id="p2z2"/>charissimo suo patri <lb xml:id="p2z3"/>et domino observando.</s>
					<s n="23" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
