	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Misi literas vel copiam literarum cum rustico quodam, <lb xml:id="p1z2"/><foreign xml:lang="de">nent sich <persName>Hanß Pfenninger</persName> von <placeName>Üricken</placeName>.</foreign></s>
					<s n="3" xml:lang="de">Yetz kompt <lb xml:id="p1z3"/>houptman <persName>Meyß</persName>, mit dem ich die ding alle geredet; <lb xml:id="p1z4"/>der meint, es sye nüt ze besorgen.</s>
					<s n="4" xml:lang="de">Darumb mögend <lb xml:id="p1z5"/>ir ester minder daruß machen; doch schadt nütt, <lb xml:id="p1z6"/>guͦte fürsorg tragen.</s>
					<s n="5" xml:lang="la">Tu omnia ex <persName>Mayßio</persName> intelliges.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z7"/>Certum est iacta seminaria belli <placeName ref="l522">Veneti</placeName>.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/><placeName ref="l98">Curię</placeName> vesperi ante natales.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">T[uus] <persName ref="p8009">Fab[ricius</persName>].</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>antistiti vigilantis<lb xml:id="p2z5"/>simo, domino suo.</s>
				</p>
			</div>
		</body>
	</text>
