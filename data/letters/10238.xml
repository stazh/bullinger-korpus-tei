			<zone xml:id="p2z4-0" points="2817,1524 2850,1519 2919,1541 2955,1520 3039,1523 3071,1510 3098,1518 3101,1448 3069,1443 3052,1453 3034,1433 2998,1431 2982,1414 2934,1443 2877,1423 2840,1443 2821,1436">2825,1487 2850,1487 2875,1487 2900,1486 2926,1484 2951,1482 2976,1480 3001,1479 3027,1478 3052,1478 3077,1479 3103,1481</zone>
