	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Binas nunc abs te, suavissime et colendissime <lb xml:id="p1z2"/>domine compater, satis infaustas accepi literas; prioribus <lb xml:id="p1z3"/>enim <persName ref="p8386">Hyperii</persName>, posterioribus <persName ref="p2757">Rügeri</persName> nostri significas <lb xml:id="p1z4"/>obitum.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Utinam vero pro illis in suum coelum mi<lb xml:id="p1z5"/>grasset delirus ille <persName ref="p458">Brentius</persName>!</s>
					<s n="4" xml:lang="la">Sed sic videtur domino, <lb xml:id="p1z6"/>cuius nos voluntati subiicere aequum est.</s>
					<s n="5" xml:lang="la">Nos quoque <lb xml:id="p1z7"/>interdum affligimur bonorum interitu; heri enim, paulo <lb xml:id="p1z8"/>antequam tuas accepissem, ex vivis excessit d. <persName ref="p8012">quęstoris <lb xml:id="p1z9"/>Halleri</persName>, optimi compatris ac vicini deside<lb xml:id="p1z10"/>ratissima uxor, cuius obitu mirum quam affligatur <lb xml:id="p1z11"/>misellus ille senex, qui, quamvis nepo<lb xml:id="p1z12"/>tum stipetur corona, optimum tamen, quod in hac vita <lb xml:id="p1z13"/>habere potuit, solamen amisit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Decumbit etiam ipse, <lb xml:id="p1z14"/>neque manus ob chiragram neque pedes propter perpe<lb xml:id="p1z15"/>tuum illum rigorem movere potest; oculos tantum ad dominum <lb xml:id="p1z16"/>levat et animum eique satis patienter sortem committit <lb xml:id="p1z17"/>suam.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Bene feceris, si illum literis soleris tuis.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z18"/>Quod vestram concultationem concernit, accepi <lb xml:id="p1z19"/>illius descriptum a fratre, pro quo tibi ago gratias.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Mihi <lb xml:id="p1z20"/>peroptime placet; neutiquam enim committendum, ut <lb xml:id="p1z21"/>nos solos coniicimus cum Lutheranis in certamen, <lb xml:id="p1z22"/>cum tam nobilia et illustria regna nostram <lb xml:id="p1z23"/>sequantur doctrinam, quaeque nostra praeiudicia, si <lb xml:id="p1z24"/>quicquam sine illis statuerimus, aegerrime essent latura.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/>Quid nostri respondeant, nescio; non dubito tamen, <lb xml:id="p1z26"/>quin illis optime sint placitura omnia.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Ubi primum <lb xml:id="p1z27"/>potero, <persName ref="p8063">Steigerum</persName> super hac re conveniam.</s>
					<s n="12" xml:lang="la">Nun<lb xml:id="p1z28"/>cius nunc parat abitum; iccirco brevior esse cogor.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z29"/>Quae de rebus nostris, scripsi ad fratrem; is illa omnia <lb xml:id="p1z30"/>tibi communicabit.</s>
					<s n="14" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Salutant te <lb xml:id="p1z31"/>iterum d. <persName ref="p3659">a Mülinen</persName>, <persName ref="p7511">Grafenrietus</persName> et <persName ref="p4060">Zehen<lb xml:id="p1z32"/>deri</persName>, amici denique et fratres atque <persName ref="p8051">uxor</persName>, quę <lb xml:id="p1z33"/>tibi tuisque fausta precatur omnia.</s>
					<s n="16" xml:lang="la">Salvi sint fratres <lb xml:id="p1z34"/>omnes et tota domus tua.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l41">Bernae</placeName> 16. martii 156<lb xml:id="p1z35"/>4.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><persName ref="p8018">I[ohan<lb xml:id="p1z36"/>nes] Hallerus</persName>, tuus <lb xml:id="p1z37"/>perpetuo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro ecclesiaeque <lb xml:id="p2z2"/><placeName ref="l587">Tigurinae</placeName> pastori fidelissimo, <lb xml:id="p2z3"/>d. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z4"/>domino suo et compatri <lb xml:id="p2z5"/>perpetua observantia colendo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>