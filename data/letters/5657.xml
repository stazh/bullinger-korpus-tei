					<lb xml:id="p2z5"/>Obrepsit error
					<lb xml:id="p2z6"/>literas insterhenti
					<lb xml:id="p2z7"/>quam pro tua humani
					<lb xml:id="p2z8"/>ignosces
					<lb xml:id="p2z9"/>parum aut abfuit
					<lb xml:id="p2z10"/>dui hac alii
