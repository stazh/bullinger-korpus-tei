	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime vir, salvus sis.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Puto non esse necesse efferre, quo sim in te <lb xml:id="p1z2"/>animo; deus novit et <persName>Aurelius</persName> novit.</s>
					<s n="3" xml:lang="la">Quare non est, quod <lb xml:id="p1z3"/>scribam pluribus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><persName>Aurelius</persName> <placeName ref="l98">Curiam</placeName> <placeName ref="l648">Rhetorum</placeName> proficiscitur ius<lb xml:id="p1z4"/>su illustrissimi principis.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Volui autem te meis litteris invisere <lb xml:id="p1z5"/>tamquam patrem, quem in dies magis diligo et pluris facio; <lb xml:id="p1z6"/>tu me redama vicissim.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute">Saluta mihi familiam atque schol<lb xml:id="p1z7"/>am et deum roga pro me, quod caput est.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/><placeName ref="l512">Tubingae</placeName> 13. maii 1564.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z9"/><persName ref="p3375">Vergerius</persName> tuus.</s>
				</p>
				<p>
					<note>[Von der Adresse nur "<placeName ref="l587">Tiguri</placeName>" erhalten:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
