	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, anime mi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Ego te per dominum nostrum Iesum Christum <lb xml:id="p1z3"/>obtestor, ut literas hasce boni consulas.</s>
					<s n="3" xml:lang="la">Sic toto illo <lb xml:id="p1z4"/>die distentus fui, ut nihil praeterea virium supersit, quo animum <lb xml:id="p1z5"/>meum tibi probem.</s>
					<s n="4" xml:lang="la">Confirmatius quidem <lb xml:id="p1z7"/>nunc brachium<note xml:id="fn1" type="footnote" n="1">Zu <persName ref="p8055">Blarers</persName> Erkrankung vgl. oben <ref target="file11786">Nr. 1740</ref>.</note> est.</s>
					<s n="5" xml:lang="la">Sed nunc compensare magna molestia, <lb xml:id="p1z8"/>velim nolim<note xml:id="fn2" type="footnote" n="2"><bibl source="b473">Otto</bibl> 362, Nr. 1852.</note>, cogor, que toto mense neglexi.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Novi nihil erat, quod scriberem; alioqui vel aliorum manu <lb xml:id="p1z10"/>officium fecissem.</s>
					<s n="7" xml:lang="la">Mitto, que hodie et nudius tertius <lb xml:id="p1z12"/>accepi<note xml:id="fn3" type="footnote" n="3">Die Beilagen sind nicht erhalten.</note>, et sedulo curabo, ne porro<note xml:id="fna" type="footnote" n="a">porro <hi>über der Zeile nachgetragen.</hi></note>, quod ipse scio, tu ignores.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Commenda nos domino et amicis.</s>
					<s n="9" xml:lang="la" ana="farewell">Bene vale iterum atque <lb xml:id="p1z14"/>iterum cum tota tua domo, quam dominus perpetuo ędificet.</s>
					<s n="10" xml:lang="la" ana="salute"><lb xml:id="p1z15"/>In primis <persName ref="p8011">Gvaltherum</persName> meum officiosissime salutabis, ad quem <lb xml:id="p1z16"/>omnino scribere opportebat; sed nulla prorsus data opportunitas.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z17"/>5. maii 1543.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z18"/>Tuus <persName ref="p8055">Ambr. Blaurerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Bullingero</persName> <lb xml:id="p2z2"/>suo.</s>
					<s n="14" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
