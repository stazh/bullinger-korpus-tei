	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literae tuae, reverende in Christo pater, circa vesperam mihi <lb xml:id="p1z2"/>sunt redditae, quare libellum de institutis Iesuitarum <lb xml:id="p1z3"/>legere nondum potui; remittam cum bona posto dies.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Demoliuntur <placeName ref="l232">Oeniponti</placeName><note xml:id="fn1" type="footnote" n="1"><placeName ref="l232">Innsbruck</placeName>.</note> amplissima splendidissimaque <lb xml:id="p1z5"/>aedificia ibi exaedificaturi monasterium pro Iesuitis.</s>
					<s n="4" xml:lang="la">Si quis <lb xml:id="p1z6"/>vestrum scriberet commonitionem ad fideles, ut sibi caverent <lb xml:id="p1z7"/>ab istiusmodi hypocritis et emitteret libellum brevi Latine <lb xml:id="p1z8"/>et Germanice, nescio quid fieri posset utilius.</s>
					<s n="5" xml:lang="la">Haec <lb xml:id="p1z9"/>raptim, cum iam nobilis hic iuvenis generosae <lb xml:id="p1z10"/>admodum indolis, senis <persName ref="p3196">Tscharneri</persName> filius, abitum summo <lb xml:id="p1z11"/>mane maturaret.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Qui et te videre cupit et sine <lb xml:id="p1z12"/>meis ad te venire noluit.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale, reverende pater <lb xml:id="p1z13"/>in Christo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Salvum te cupiunt nostri.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l98">Curię</placeName> 28. <lb xml:id="p1z14"/>novembris anno 1559.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro eruditione <lb xml:id="p2z2"/>et pietate excellenti d. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>antistiti vigilantissimo, <lb xml:id="p2z5"/>domino et patrono suo <lb xml:id="p2z6"/>multum honorandum.</s>
				</p>
			</div>
		</body>
