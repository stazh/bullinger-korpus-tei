	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Non dubito, quin remiserit d. <persName ref="p8418">Myconius</persName> <placeName ref="l1107">Tridentina<lb xml:id="p1z2"/>e</placeName> sessionis scripta.</s>
					<s n="3" xml:lang="la">Plures autem ego habeo epistolas, quas tu fortassis nondum <lb xml:id="p1z3"/>vidisti, nempe <persName>regis Galliae</persName> et <persName>Anglię regis</persName>, <persName ref="p18520">Ioachimi de Brandenburg</persName> <lb xml:id="p1z4"/>et alia quędam a paucis visa; si non habes, significa.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Dominus <persName ref="p2916">Schertlinus</persName> abiturus est fortassis die martis proxima; expectat <lb xml:id="p1z6"/>equitatum, qui illum deducet in terram opimam episcoporum; nam digni <lb xml:id="p1z7"/>sunt, tandem ut pereant, post tot homicidia cruentissima, quę perpetrarunt <lb xml:id="p1z8"/>in pios Christi fideles martyres.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Fama fert cancellarium episcopi <persName ref="p7548">Moguntini</persName> ab <placeName ref="l213">Hessis</placeName> captum, et si parum <lb xml:id="p1z10"/>expectassent, cępissent episcopum, qui vix evasit a rustico admonitus.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Concilium <placeName ref="l1107">Tridentinum</placeName> finem habet; evolant episcopi omnes nidos alios <lb xml:id="p1z12"/>quaerentes tutiores.</s>
					<s n="7" xml:lang="la"><placeName ref="l18">Augustę</placeName> proclamatum buccina nullas nundinas <lb xml:id="p1z13"/><placeName ref="l157">Francofordiae</placeName> fore.</s>
					<s n="8" xml:lang="la">Papa conqueritur <persName>Caesarem</persName> in Lutheranos esse <lb xml:id="p1z14"/>mitem; se velle <placeName ref="l832">Gallo</placeName> adhęrere.</s>
					<s n="9" xml:lang="la"><persName ref="p18250">Mauritius</persName> in armis est.</s>
					<s n="10" xml:lang="la">Quid <lb xml:id="p1z15"/>putas futurum?</s>
					<s n="11" xml:lang="la">Vertetur brevi tota <placeName ref="l822">Germania</placeName> et digna, ut pereat, <lb xml:id="p1z16"/>quę alias nationes perdidit devastavitque.</s>
					<s n="12" xml:lang="la">D. <persName ref="p2916">Schertlino</persName> venient brevi, <lb xml:id="p1z17"/>hoc est 18. die huius mensis, 200 equites, quos vult ad defensionem <lb xml:id="p1z18"/>contra hostes armatos habere, quo locum commodum exercitui paret.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Quo autem <lb xml:id="p1z19"/>tu putas <persName ref="p2916">Schertlinum</persName> exercitum illum ducturum?</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z20"/>Rustici <placeName ref="l2836">Sungavię</placeName> omnes die noctuque vigilant in sylvis, in oppidulis et in <lb xml:id="p1z21"/>pagis; invitus est miles, qui mallet hostem quam amicos.</s>
					<s n="15" xml:lang="la">Onerantur variis rebus, <lb xml:id="p1z22"/>ut ne seminare possint; exactio gravis imposita est a <persName ref="p18477">Ferdinando</persName>.</s>
					<s n="16" xml:lang="la"><placeName ref="l2510">Turcam</placeName> timent <lb xml:id="p1z23"/>et nihilominus excitant isti homines varias tragędias.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Vale.</s>
					<s n="18" xml:lang="la"><placeName ref="l28">Basileę</placeName> 17. m[artii] 1552.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">T[uus] <persName ref="p1278">Gastius</persName>.</s>
				</p>
