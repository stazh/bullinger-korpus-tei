	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi heri, compater in domino charissime, quos <lb xml:id="p1z2"/>ad me misisti, sermones tuos de festis diebus <lb xml:id="p1z3"/>ipsum dominum concernentibus, pro quo tibi munere <lb xml:id="p1z4"/>gratiam habeo, quam pari formiter rependere <lb xml:id="p1z5"/>malim, si vetus amicus meus <persName ref="p5213">Johannes <lb xml:id="p1z6"/>Hervagius</persName> adhuc esset in vivis.</s>
					<s n="3" xml:lang="la">Sentio nanque <lb xml:id="p1z7"/>haeredes illius sic esse comparatos, ut decimam <lb xml:id="p1z8"/>vix ausim partem petere ab illis eorum, quae <lb xml:id="p1z9"/>bona cum fiducia a parente ipsorum petebam <lb xml:id="p1z10"/>et accipiebam, qua de re et antea, nisi <lb xml:id="p1z11"/>fallor, ad te scripsi.</s>
					<s n="4" xml:lang="la">Quicquid hoc sit, <lb xml:id="p1z12"/>oro dominum, ut laboribus tuis benedicat detque <lb xml:id="p1z13"/>tibi senectam longaevam, commodam et consuetis <lb xml:id="p1z14"/>laboribus sufficientem simulque det talia <lb xml:id="p1z15"/>tempora, in quibus bonorum virorum lucu<lb xml:id="p1z16"/>brationes locum inveniant ac bene collocentur.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z17"/>Incidimus in ea tempora, in quibus <lb xml:id="p1z18"/>corpora eorum, qui in opera domini strenue <lb xml:id="p1z19"/>laborarunt, alia viva alia sepulchris <lb xml:id="p1z20"/>impie effossa Vulcano traduntur, imo ipsa <lb xml:id="p1z21"/>sacra biblia hereseos damnantur et rogis <lb xml:id="p1z22"/>ardentibus iniiciuntur.</s>
					<s n="6" xml:lang="la">Si haec obtinente <lb xml:id="p1z23"/>adhuc veritatis luce fiunt, quid futurum <lb xml:id="p1z24"/>putabimus, ubi illa peccatis nostris sic merentibus <lb xml:id="p1z25"/>e medio fuerit ablata?</s>
					<s n="7" xml:lang="la">Interea tamen <lb xml:id="p1z26"/>non erunt inanes eorum labores, qui veritatem <lb xml:id="p1z27"/>evangelii dei sive docendo sive lucu<lb xml:id="p1z28"/>brando illustrarunt; vel ad hoc nanque facient, <lb xml:id="p1z29"/>ut nulla futura sit impiis et incredulis ex<lb xml:id="p1z30"/>cusatio, id quod et ipsum ad gloriam dei facit.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z31"/>De causa <placeName ref="l280">Lausannensium</placeName> dubio procul a d. <lb xml:id="p1z32"/><persName ref="p8018">Hallero</persName>, compatri meo, accepisti.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Boni viri <lb xml:id="p1z33"/>scrupulosius in opere domini versantur, quam praesentium <lb xml:id="p1z34"/>temporum status ferat.</s>
					<s n="10" xml:lang="la" ana="farewell">Optime vale, compater charissime<lb xml:id="p1z35"/>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Salutem apprecor toti domui tuae et d. <lb xml:id="p1z36"/><persName ref="p8171">Bibliandro</persName>, <persName ref="p8111">Petro Martyri</persName>, <persName ref="p8011">Gvalthero</persName>, <persName ref="p2336">Bernardino</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l41">Bernę</placeName> 11. septembris.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z37"/><persName ref="p8417">Wolfg[angus] Musc[ulus</persName>], compater tuus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo m. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z4"/>domino fratri <lb xml:id="p2z5"/>ac compatri <lb xml:id="p2z6"/>in Christo charissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l587">Tigu<lb xml:id="p2z8"/>ri</placeName>.</s>
				</p>
			</div>
