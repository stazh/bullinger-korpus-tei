	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi ab <persName ref="p7409">Adamo</persName><note xml:id="fn1" type="footnote" ana="bio" n="1">Gemeint ist wohl <persName ref="p7409">Adam von Bodenstein</persName>, der Sohn <persName ref="p4349">Karlstadts</persName> (vgl. oben <ref target="file11574">Nr. 1531</ref>, 9f).</note> omnia tua<note xml:id="fn2" type="footnote" n="2">Die Rede ist von den brieflichen Stellungnahmen zu <persName ref="p1365">Grynäus</persName>' "De coena domini [...] dictata" von <persName ref="p1753">Leo Jud</persName> (nicht erhalten) und <persName ref="p495">Bullinger</persName> (oben <ref target="file11593">Nr. 1550</ref>); vgl. unten <ref target="file11604">Nr. 1561</ref>, 17-19, und <ref target="file11614">Nr. 1571</ref>, 1-18.</note> et, dum aliud ago, <persName ref="p8054">Marco</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p8054">Markus Bertschi</persName>.</note> ad legendum <lb xml:id="p1z2"/>dedi.</s>
					<s n="3" xml:lang="la">Is eo mane remisit, quo tabellio pararat abitum.</s>
					<s n="4" xml:lang="la">Equidem <lb xml:id="p1z3"/>ne literam quidem adhuc legi.</s>
					<s n="5" xml:lang="la">Nihil putavi periculi esse, si tantisper <lb xml:id="p1z4"/>adhuc retinerem, dum legere possem per ocium.</s>
					<s n="6" xml:lang="la">De reliquis omnibus scripsi <lb xml:id="p1z5"/>ad <persName ref="p8011">Gwalterum</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p8418">Myconius</persName> bezieht sich offenbar auf seinen Brief an <persName ref="p8011">Rudolf Gwalther</persName> vom 13. August; vgl. oben <ref target="file11597">Nr. 1554</ref>, Anm. 7.</note> per eundem <persName ref="p7409">Adamum</persName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">In templum nunc eundum.</s>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z6"/>Vale in Christo cum tuis et <persName ref="p8171">Theodoro</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p8171">Theodor Bibliander</persName>.</note>.</s>
					<s n="9" xml:lang="la">Raptim, <placeName ref="l28">Basileę</placeName>, 21. <lb xml:id="p1z7"/>augusti anno 41.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z8"/><persName ref="p8418">Os. Myconius</persName> <lb xml:id="p1z9"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>in domino suo.</s>
				</p>
			</div>
		</body>
	</text>
