	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime vir.</s>
					<s n="2" xml:lang="la">Nunc, quum consignarem literas d. <lb xml:id="p1z2"/><persName>Nicolao Morae</persName>, (quem iterum tibi ex animo commendo), <lb xml:id="p1z3"/>redditae sunt mihi literae illae, quas <lb xml:id="p1z4"/>scribebas te pridie scripsisse ad me.</s>
					<s n="3" xml:lang="la">Quibus <lb xml:id="p1z5"/>coram respondebo, quod ad <persName ref="p458">Brentium</persName> et ducem <lb xml:id="p1z6"/>attinet.</s>
					<s n="4" xml:lang="la">Boni consule, si tandiu distuli; <lb xml:id="p1z7"/>non sine causa feci.</s>
					<s n="5" xml:lang="la">De libello et coronato - <lb xml:id="p1z8"/>sane perierit - non est quod te afflictes; <lb xml:id="p1z9"/>tantum scribe ad <persName ref="p1327">Gratarolum</persName>, <lb xml:id="p1z10"/>quo tempore nuncius ille abs te acceper<lb xml:id="p1z11"/>it libellum et coronatum.</s>
					<s n="6" xml:lang="la">Rogo meum <lb xml:id="p1z12"/>Iosiam, mittat scripta ex meis sarcinis, <lb xml:id="p1z13"/>inter quas aliud est exemplum eiusdem l<lb xml:id="p1z14"/>ibelli, et mittat vasculum, si quod <lb xml:id="p1z15"/>e <placeName ref="l28">Basilea</placeName> ad eum pervenit.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z16"/>et salve cum tota familia, schola <lb xml:id="p1z17"/>atque ecclesia.</s>
					<s n="8" xml:lang="la">Rogate pro me.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/><placeName ref="l93">Claven[n]ae</placeName>, 3. <lb xml:id="p1z19"/>septembris <lb xml:id="p1z20"/>1553.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori, <lb xml:id="p2z4"/>fratri et d[omino] honorando.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
