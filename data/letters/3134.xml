	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil alioqui erat quod scriberem de causa <lb xml:id="p1z2"/>communi: cum audiam senatum amplissimum omnia <lb xml:id="p1z3"/>perscripturum vestratibus.</s>
					<s n="3" xml:lang="la">Dolet non immerito <lb xml:id="p1z4"/>nostris hactenus apud B. se adeo potuisse nihil, cum <lb xml:id="p1z5"/>tamen tentarint omnia.</s>
					<s n="4" xml:lang="la">Caeterum venient <lb xml:id="p1z6"/>procul dubio tempora magis prospera, ac dabit <lb xml:id="p1z7"/>Dominus, si voluerit vos rursus coalescere, u<lb xml:id="p1z8"/>beriorem opportunitatem.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Sin illi visum fuerit <lb xml:id="p1z9"/>aliud, quid nos possumus quam orare: Fiat <lb xml:id="p1z10"/>voluntas tua?</s>
					<s n="6" xml:lang="la">Spero Dominum nobis/vobis nuspiam <lb xml:id="p1z11"/>defuturum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">De adventu meo nescio quid fut<lb xml:id="p1z12"/>urum sit, cum non sim admodum firma <lb xml:id="p1z13"/>instructus valetudine et varia me in diem adobruant <lb xml:id="p1z14"/>negotia, et molestiae me divexent in<lb xml:id="p1z15"/>numerae.</s>
					<s n="8" xml:lang="la">Venient, si poterunt, alii fortassis.</s>
					<s n="9" xml:lang="la">Sed <lb xml:id="p1z16"/>utcunque ea res habeat, metuo ego non sine causis <lb xml:id="p1z17"/>exiguis, colloquium hoc non magno cum fructu, <lb xml:id="p1z18"/>sic ut ille putat, processurum.</s>
					<s n="10" xml:lang="la">Periculum erit ex <lb xml:id="p1z19"/>itinere.</s>
					<s n="11" xml:lang="la">Sunt et alia non pauca incom[m]oda.</s>
					<s n="12" xml:lang="la">Et <lb xml:id="p1z20"/>si vera sunt, quae scribuntur ex <placeName ref="l822">Germania</placeName>, cele<lb xml:id="p1z21"/>brabitur colloquium <placeName ref="l410">Ratisponae</placeName> mense Septembri <lb xml:id="p1z22"/>proximo: in quod attrahetur inter primos <persName>Philippus</persName>.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z23"/>Nec scio qua cum utilitate et illi sint colloqu[u]<lb xml:id="p1z24"/>turi, cum praescribatur illis res impia, ut <lb xml:id="p1z25"/>concilient pugnantes inter se religiones, conenturque <lb xml:id="p1z26"/>papismum et evangelium concordare.</s>
					<s n="14" xml:lang="la">Val<lb xml:id="p1z27"/>de metuo quosdam veritatis peręsos, vias quaerere <lb xml:id="p1z28"/>per quas redeant in papismum, aut saltem <lb xml:id="p1z29"/>evangelium et religionem consequantur, cuius gratia <lb xml:id="p1z30"/>nihil incom[m]oditatis accipiant.</s>
					<s n="15" xml:lang="la">Sed videt omnia <lb xml:id="p1z31"/>Deus.</s>
					<s n="16" xml:lang="la">Video in <placeName ref="l822">Germania</placeName> omnia esse convulsa et <lb xml:id="p1z32"/>disiecta omnesque concionatorum sermones dirigi <lb xml:id="p1z33"/>contra sacramentarios, quasi nihil sit, quod agant <lb xml:id="p1z34"/>aliud.</s>
					<s n="17" xml:lang="la">Ex <placeName ref="l834">Italia</placeName> diversa adferuntur nuncia, iam <lb xml:id="p1z35"/>progredi exercitum, mox tractari de pace.</s>
					<s n="18" xml:lang="la">Dominus <lb xml:id="p1z36"/>misereatur nostri et servet nos.</s>
					<s n="19" xml:lang="la" ana="farewell">Vale aeternum.</s>
					<s n="20" xml:lang="la" ana="salute"><lb xml:id="p1z37"/>Saluta symmystas.</s>
					<s n="21" xml:lang="la" ana="salute">Salutant te et tuos nostri omnes.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z38"/><placeName ref="l587">Tiguri</placeName> 24.</s>
					<s n="23" xml:lang="la">Anno 1557.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro D. <persName ref="p540">Ioanni <lb xml:id="p2z2"/>Calvino</persName> <placeName ref="l167">Genevensis</placeName> ecclesiae <lb xml:id="p2z3"/>ministro fideli domino <lb xml:id="p2z4"/>suo colendo et fratri charissimo.</s>
					<s n="26" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l167">Genff</placeName>.</s>
				</p>
