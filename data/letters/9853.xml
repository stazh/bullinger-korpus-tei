	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>
					<lb xml:id="p1z2"/>Deer allmächtig gott verlyhe unß
					<lb xml:id="p1z3"/>vil guͦter jaren. Amen. Diewyll
					<lb xml:id="p1z4"/>mir Susanna geschickt räckholter vogel
					<lb xml:id="p1z5"/>schicken ich iren disen pfennig und
					<lb xml:id="p1z6"/>dancken iren trüwlich. Dem kundn
					<lb xml:id="p1z7"/>schicken ich von den minen dru dirg
					<lb xml:id="p1z8"/>zel. Gott beware und sägne üch
					<lb xml:id="p1z9"/>gewiklich. Lieber laß mich mörn
					<lb xml:id="p1z10"/>egüssen, wie es gangen mitt minem
					<lb xml:id="p1z11"/>herren von Kyburg, ist er noch by üch
					<lb xml:id="p1z12"/>so wüsch mir mun ein guͦt glückhafft
					<lb xml:id="p1z13"/>frowen
					<lb xml:id="p1z14"/>simer eeren lieben hun
					<lb xml:id="p1z15"/>und allem sinen huß etc.
					<lb xml:id="p1z16"/>Hiemitt schickt den kinden min liebe
					<lb xml:id="p1z17"/>dorothe das guͦt jar. wie da daruff
					<lb xml:id="p1z18"/>findst geschriben. Wir wünschend
					<lb xml:id="p1z19"/>üch und den kinden hundert tustend
					<lb xml:id="p1z20"/>Gott mitt üch eewi
					<lb xml:id="p1z21"/>gue g.
					<lb xml:id="p1z22"/>Uff donstag post Thomae
					<lb xml:id="p1z23"/>anno odmi 1574.
					<lb xml:id="p1z24"/>Bullinger.
					<pb/>
					<lb xml:id="p2z1"/>lieben
					<lb xml:id="p2z2"/>Hansenre
					<lb xml:id="p2z3"/>Sin.
					<lb xml:id="p2z4"/>dolffen Bullingern.
					<lb xml:id="p2z5"/>zuͦ
					<lb xml:id="p2z6"/>Berg.
				</p>
			</div>
		</body>
	</text>
