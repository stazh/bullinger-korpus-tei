			<zone xml:id="p2z4-0" points="1634,2139 1758,2104 1870,2147 2010,2087 2266,2138 2359,2091 2516,2081 2515,2024 2162,1937 1868,2037 1748,1978 1633,2010">1641,2059 1684,2059 1728,2060 1772,2062 1816,2062 1860,2062 1904,2062 1948,2062 1992,2062 2036,2063 2080,2065 2123,2065 2167,2065 2211,2065 2255,2068 2299,2065 2343,2065 2387,2065 2431,2068 2475,2065 2519,2056</zone>
