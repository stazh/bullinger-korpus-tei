	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/><persName ref="p8098">G<lb xml:id="p1z2"/>eorg, grave zu Wirtemberg <lb xml:id="p1z3"/>unnd zu Mümpelgart</persName> etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="de"><lb xml:id="p1z4"/>Unnsern gruß zuvor, lieber besonnder.</s>
					<s n="3" xml:lang="de">Ewer schreyben sambt <lb xml:id="p1z5"/>dem ingebundnen exemplar des unns zugeschribnen büchlins <lb xml:id="p1z6"/>haben wir neben eurm entpieten gegen unns empfanngen <lb xml:id="p1z7"/>unnd zu sonnderm wolgefallen verstannden und angenommen, <lb xml:id="p1z8"/>wöllen auch solichs gegen euch mit gnedigem bedenncken <lb xml:id="p1z9"/>unnd gegen erkanntnuß erkennen.</s>
					<s n="4" xml:lang="de"><lb xml:id="p1z10"/>Wo euch <lb xml:id="p1z11"/>auch das nit zu wider, möchten wir wol gern ettliche ex<lb xml:id="p1z12"/>emplar, lateinische und teutsche, haben.</s>
					<s n="5" xml:lang="de">Wollten wir <lb xml:id="p1z13"/>euch uff ewer schreiben gnediger meinung nit verhallten <lb xml:id="p1z15"/>und seind euch zu g[naden] geneigt.</s>
					<s n="6" xml:lang="de">Datum <lb xml:id="p1z16"/><placeName ref="l441">Schafhausen</placeName> den 27ten martij anno etc. 52.</s>
				</p>
				<p>
					<s n="7" xml:lang="de"><persName ref="p8098">G[eorg] g[rave] <lb xml:id="p1z17"/>z[u] <lb xml:id="p1z18"/>Wyrttemberg</persName> etc.</s>
				</p>
				<p>
					<s n="8" xml:lang="de"><pb/><lb xml:id="p2z1"/>Unserm lieben besonndern <lb xml:id="p2z2"/><persName ref="p495">Heinrich Bullinger</persName>, predigern zu <lb xml:id="p2z3"/><placeName ref="l587">Zuͤrch</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
