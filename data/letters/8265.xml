	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S.
					<lb xml:id="p1z2"/>nos risiliba
					<lb xml:id="p1z3"/>Cistiplpur aonir Volis
					<lb xml:id="p1z4"/>d annno Billinenum
					<lb xml:id="p1z5"/>ledillitu  in prostetec
					<lb xml:id="p1z6"/>Cagi pule et discendore i Egistoe
					<lb xml:id="p1z7"/>fupiulber iula proverbim, aola bonus
					<lb xml:id="p1z8"/>Varilians par et Inqullitastitu.
					<lb xml:id="p1z9"/>a qualdoquidam quidam sonile sea
					<lb xml:id="p1z10"/>sposionibus Galline illorum acome.
					<lb xml:id="p1z11"/>Si ihar pocissioibus ecli
					<lb xml:id="p1z12"/>Iauud et cersimam terum criba a
					<lb xml:id="p1z13"/>Iantey  colendona lani
					<lb xml:id="p1z14"/>Iesse aidirnus pubelę e dinoge oma
					<lb xml:id="p1z15"/>sevolunil on a i ri
					<lb xml:id="p1z16"/>Sidur costihi voleatis ab alia pie obl.
					<lb xml:id="p1z17"/>Iam lodide semitilus ngnsci at coputu not
					<lb xml:id="p1z18"/>Syend aomin fud sene a Norlen
					<lb xml:id="p1z19"/>I mac sins a Plareca in Christi
					<lb xml:id="p1z20"/>Ioade Bal pcossimus su
					<lb xml:id="p1z21"/>e
					<lb xml:id="p1z22"/>S.
					<pb/>
					<lb xml:id="p2z1"/>ds brrfige et defectoribus d hos up.
					<lb xml:id="p2z2"/>siato Larfaciseg Cistia
					<lb xml:id="p2z3"/>nihil suppili duubus semilibus eiiaser
					<lb xml:id="p2z4"/>datum ubm qrique puderest
					<lb xml:id="p2z5"/>Ropta fallis daberabir defierit
					<lb xml:id="p2z6"/>est depe iuvore aun et nisi deg
					<lb xml:id="p2z7"/>Palo sona a coi, qui eche au
					<lb xml:id="p2z8"/>as cactale aqpelle pro vicili vielaa
					<lb xml:id="p2z9"/>Cypa doni i tola
					<lb xml:id="p2z10"/>Golum alte vuerum ec Gonva garedie.
					<lb xml:id="p2z11"/>rego ngoq aoddesit dura amcilia
					<lb xml:id="p2z12"/>dolemnde doo olloscirita
					<lb xml:id="p2z13"/>parta apu fes quid lapa craver
					<lb xml:id="p2z14"/>ubua Tloratana, oenar olledica
					<lb xml:id="p2z15"/>nonue hattura cucia, quid eo an
					<lb xml:id="p2z16"/>Pibi et art Ionarum dapecium a ga
					<lb xml:id="p2z17"/>na et Vales baupere novibus.
					<lb xml:id="p2z18"/>sunt.
					<pb/>
					<lb xml:id="p3z1"/>sud olio a constantropolitatis gelaria
					<lb xml:id="p3z2"/>sal Taria gernui
					<lb xml:id="p3z3"/>tua fu et ad too Chia Calvaina
					<lb xml:id="p3z4"/>miscendam daperata provada
					<lb xml:id="p3z5"/>qqua consilia diposss. Malia quoqur
					<lb xml:id="p3z6"/>Oe et vendte conllia dari capa e
