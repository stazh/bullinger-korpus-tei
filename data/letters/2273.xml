	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Ad tempus domo abfui ecclesiarum ditionis nostrae visitatione occupatus, quo factum, <lb xml:id="p1z2"/>ut tardius scribam.</s>
					<s n="2" xml:lang="la">De <placeName ref="l294">Lucarnensium</placeName> negocio pridem cum civitatis capitibus <lb xml:id="p1z3"/>egi, <lb xml:id="p1z4"/>qua potui summa fide, ac gaudeo, quod videam suam operam etiam et autoritatem <lb xml:id="p1z5"/>senatum nostrum interponere, quam vel eo usque valituram spero, ut et reliquorum ordinum <lb xml:id="p1z6"/>evangelicorum suffragio accedente mitigatio furoris saltem aliqua impetrari queat.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Pecuniam bona fide accepi, officium libens praestiti uberiora praestaturus, sicut debeo, <lb xml:id="p1z8"/>si offeratur occasio.</s>
					<s n="4" xml:lang="la">Affinem tuum nondum vidi, quem, simulac venerit, non patiar <lb xml:id="p1z9"/>operam meam desiderare.</s>
					<s n="5" xml:lang="la">Nova nunc nulla hic feruntur, quia de <persName>Alberti</persName> expeditio<lb xml:id="p1z10"/>ne altum silentium, cuius tamen arcem <placeName>Hochen-Landenberg</placeName> aiunt ab hostibus confoederatis <lb xml:id="p1z11"/>occupatam inventaque in ea ipsa tormenta bellica 50 et iam denuo <placeName ref="l1031">Svin<lb xml:id="p1z12"/>furti</placeName> obsidionem parari.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><persName>Palatinus Otto</persName> comicia processura significat <lb xml:id="p1z13"/>et thermarum usum hac aestate meditatur; tamen pecora ex <placeName ref="l862">Helvetia</placeName> atque pasto<lb xml:id="p1z14"/>res comparat, quibus argumentum ędit, non[n]ullam se Germaniae pacem <lb xml:id="p1z15"/>hoc anno praesagire et expectare.</s>
					<s n="7" xml:lang="la">Precemur dominum eam ut sartam in ipso diu<lb xml:id="p1z16"/>turnamque esse velit.</s>
					<s n="8" xml:lang="la">Si quid tu aliunde habes, rogo, significa.</s>
					<s n="9" xml:lang="la" ana="farewell">Vive <lb xml:id="p1z17"/>et vale cum uxore, liberis et tuis omnibus.</s>
					<s n="10" xml:lang="la"><placeName ref="l28">Basileae</placeName> 26. aprilis <lb xml:id="p1z18"/>anno 1554.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">T[u<lb xml:id="p1z19"/>us] <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Salutant te reverenter mei symmistae.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, domino <lb xml:id="p2z3"/>et symmistae colendissimo <lb xml:id="p2z4"/>suo.</s>
				</p>
			</div>
		</body>
	</text>
