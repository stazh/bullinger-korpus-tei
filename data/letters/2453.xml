	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S.
					<lb xml:id="p1z2"/>Eidi nihil fere habeam, quod ad te scribam,
					<lb xml:id="p1z3"/>id facio tamen, ut intelligas heri mihi
					<lb xml:id="p1z4"/>redditus fuisse literas,  quae a te priden
					<lb xml:id="p1z5"/>non. Datae erant meque fesciculum stati
					<lb xml:id="p1z6"/>galitium perferendum curasse, non
					<lb xml:id="p1z7"/>dubito tibi aliisquam doctis et piis vixis
					<lb xml:id="p1z8"/>rem odiosam videri bellum uosque plani
					<lb xml:id="p1z9"/>olfacere iiddem nestigiis, quibus antea Caesarem
					<lb xml:id="p1z10"/>ingredi, ut inflexo Germaniae viribus reg
					<lb xml:id="p1z11"/>meo eam postea liberius opprimat. Ideum
					<lb xml:id="p1z12"/>si tanta est corcitas, ut quae ante pedes suns
					<lb xml:id="p1z13"/>homines ni cernant, conselo equidem tibi
					<lb xml:id="p1z14"/>ut ea, quae acciderunt et impendent reque
					<lb xml:id="p1z15"/>animo feras, ne ipsi quidem Angli duo
					<lb xml:id="p1z16"/>malo sapere didicerunt. Ego hic interim
					<lb xml:id="p1z17"/>endeo animi ita re ipsu video vana
					<lb xml:id="p1z18"/>esse, quae de discessu meo ex literis meorum
					<lb xml:id="p1z19"/>sperabam, quo nihil mihi inquenium
					<lb xml:id="p1z20"/>optatius potest contingere. Vale
					<lb xml:id="p1z21"/>, qui nomles
					<lb xml:id="p1z22"/>certi de Vogerio
					<lb xml:id="p1z23"/>Valert sanes me certiorem.
					<lb xml:id="p1z24"/>et Bi.
					<lb xml:id="p1z25"/>
					<pb/>
					<lb xml:id="p2z1"/>Clarissimo viro
					<lb xml:id="p2z2"/>D. H. Bullingero,
					<lb xml:id="p2z3"/>theologo primario
					<lb xml:id="p2z4"/><placeName ref="l587">Tguri</placeName>.
					<lb xml:id="p2z5"/>amico observando.
				</p>
			</div>
		</body>
	</text>
