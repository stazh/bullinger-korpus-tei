	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Supplicationem, quam mihi novissimis tuis literis misisti, <lb xml:id="p1z2"/>clarissime vir, <placeName ref="l93">Clavenę</placeName> descriptam per proprium nuncium <lb xml:id="p1z3"/><placeName ref="l294">Locarnensibus</placeName> christianis reddendam statim curavi.</s>
					<s n="2" xml:lang="la">Illi vero <lb xml:id="p1z4"/>oratorem proprium cum supplicatione ad dominos Helveticos <lb xml:id="p1z5"/><placeName ref="l21">Badenę</placeName> congregatos, sicuti indicaras, miserunt.</s>
					<s n="3" xml:lang="la">Agunt <lb xml:id="p1z6"/>interim deo ad domino Iesu Christo gratias, qui te veluti medium <lb xml:id="p1z7"/>quoddam ad hanc provinciam suscipiendam elegit, hominem <lb xml:id="p1z8"/>inprimis pium, diligentem ac strenum.</s>
					<s n="4" xml:lang="la">Rogant insuper <lb xml:id="p1z9"/>humanitatem tuam, ut, quemadmodum coepisti, desistere ne <lb xml:id="p1z10"/>pergas, pręsertim precibus apud dominum cum totta ecclesia <lb xml:id="p1z11"/><placeName ref="l587">Tigurina</placeName>, a quo omnia servantur; cui honor et <lb xml:id="p1z12"/>gloria sempiterna.</s>
					<s n="5" xml:lang="la" ana="farewell">Vale, mi domine <persName ref="p495">Henrice</persName>, et <persName ref="p8168">Antonii <lb xml:id="p1z13"/>Marii</persName> tui, qui tibi ac familię tę omnia lęta precatur, <lb xml:id="p1z14"/>ne obliviscaris.</s>
					<s n="6" xml:lang="la"><placeName ref="l98">Curię</placeName> 5. calendas (decembris) 9bris 1554.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Humanitatis tę deditissimum <lb xml:id="p1z16"/>mancipium <persName ref="p8168">Antonius Marius Besutius</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietate, doctrina ac moribus <lb xml:id="p2z2"/>clarissimo viro domino <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bulingero</persName> antistiti <placeName ref="l587">Tigurino</placeName>, <lb xml:id="p2z4"/>domino suo colendissimo.</s>
				</p>
				<p>
					<s n="9" xml:lang="de"><lb xml:id="p2z5"/>Gen <placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
