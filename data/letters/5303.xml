			<zone xml:id="p4z3-0" points="1856,2260 1900,2289 1914,2277 1969,2296 2043,2351 2078,2343 2160,2382 2220,2355 2218,2186 2161,2163 2126,2170 2106,2152 2006,2155 1855,2198">1862,2280 1887,2278 1913,2277 1938,2275 1964,2274 1990,2274 2015,2274 2041,2274 2067,2274 2092,2274 2118,2274 2144,2276 2169,2279 2195,2283 2221,2286</zone>
