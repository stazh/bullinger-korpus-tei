	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><persName ref="p8101">Laelius</persName> noster rediens ex <placeName ref="l2472">Polonia</placeName> per <placeName ref="l546">Vienn<lb xml:id="p1z2"/>am</placeName> et <placeName ref="l18">Augustam</placeName> poterit tibi referre <lb xml:id="p1z3"/>certissima fide res <placeName ref="l2510">Turcicas</placeName>, <placeName ref="l2721">Pannonias</placeName>, <lb xml:id="p1z4"/><placeName ref="l850">Austriacas</placeName> et Caesareas.</s>
					<s n="3" xml:lang="la">Declaratum est bellum <lb xml:id="p1z5"/>et proclamatum inter Caesarem et <persName ref="p8112">Gallum</persName>, inter <lb xml:id="p1z6"/><placeName ref="l2510">Turcam</placeName> et <persName ref="p18477">Ferdinandum</persName>.</s>
					<s n="4" xml:lang="la">Miseret me tot mi<lb xml:id="p1z7"/>serabilium hominum, et utinam nos ipsi non <lb xml:id="p1z8"/>abstrahamur in mali medium.</s>
					<s n="5" xml:lang="la">Concilium <lb xml:id="p1z9"/>aiunt procedere.</s>
					<s n="6" xml:lang="la">Quid actum sit aut agatur <lb xml:id="p1z10"/><placeName ref="l21">Badenae</placeName>, ignoramus adhuc, expectamus in <lb xml:id="p1z11"/>horas; rumor est varius, nec omnia au<lb xml:id="p1z12"/>spicata sunt, quae feruntur.</s>
					<s n="7" xml:lang="la">Dominus nos componat <lb xml:id="p1z13"/>omnes pro sancta sua voluntate.</s>
					<s n="8" xml:lang="la">Vicarius <lb xml:id="p1z14"/><persName ref="p18477">Ferdinandi</persName> <placeName ref="l1148">Constantiae</placeName> tres onerarias naves, <lb xml:id="p1z15"/>quod dicerentur merces portare <placeName ref="l832">Gallicas</placeName>, <lb xml:id="p1z16"/>exoneravit.</s>
					<s n="9" xml:lang="la">Vivit <persName ref="p8111">Petrus Martyr</persName> et co<lb xml:id="p1z17"/>piosissimas ad me dedit.</s>
					<s n="10" xml:lang="la">Decubuere ex sudore <lb xml:id="p1z18"/><placeName ref="l830">Anglico</placeName> d. <persName ref="p8041">Ioannes a Lasco</persName> et <persName ref="p1560">Hopperus</persName>, <lb xml:id="p1z19"/>sed restituti sunt per gratiam dei.</s>
					<s n="11" xml:lang="la">Duo no<lb xml:id="p1z20"/>bilissimi principes duces suffolciae <lb xml:id="p1z21"/>interierunt.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Deferbuit lues.</s>
					<s n="13" xml:lang="la">De <placeName ref="l303">Magde<lb xml:id="p1z22"/>burgensibus</placeName> magna est spes.</s>
					<s n="14" xml:lang="la">Tuas expecto <lb xml:id="p1z23"/>de <placeName ref="l491">Argentoratensibus</placeName>.</s>
					<s n="15" xml:lang="la" ana="farewell">Vale cum omnibus <lb xml:id="p1z24"/>bonis.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 3. octobris 1551.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z25"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
