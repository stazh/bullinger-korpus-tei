	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la">[...] <lb xml:id="p1z1"/>commissum habeas adolescentulum<note xml:id="fn1" type="footnote" n="1">Unbekannt.</note>; polliceor et ego <lb xml:id="p1z2"/>me non ingratum fore.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">De comitiis <placeName ref="l471">Spirensibus</placeName><note xml:id="fn2" type="footnote" n="2">Vgl. oben <ref target="file11881">Nr. 1835</ref>, Anm. 3.</note> <lb xml:id="p1z3"/>si quid habes certi, fac sciam.</s>
					<s n="3" xml:lang="la">Nos <lb xml:id="p1z4"/>nihil habemus rerum novarum, nisi quod <persName ref="p18593">Turca</persName><note xml:id="fn3" type="footnote" n="3">Sultan <persName ref="p18593">Suleiman I.</persName></note> a <placeName ref="l522">Venetis</placeName> <lb xml:id="p1z5"/>dicitur<note xml:id="fnb" type="footnote" n="b">dicitur <hi>am Rande nachgetragen.</hi></note> transitum petiisse in <placeName ref="l834">Italiam</placeName> ac <lb xml:id="p1z6"/><placeName ref="l832">Gallum</placeName><note xml:id="fn4" type="footnote" n="4">König <persName ref="p20225">Franz I.</persName> von <placeName ref="l832">Frankreich</placeName>.</note> non infeliciter pulsis e <placeName ref="l736">Pedemontana</placeName> <lb xml:id="p1z7"/>regione <placeName ref="l875">Hispanis</placeName><note xml:id="fn5" type="footnote" n="5">Die Mitteilung ist ungenau: Zwar wurden die <placeName ref="l875">Spanier</placeName> im Winter 1543/1544 in einigen <placeName ref="l736">piemontesischen</placeName> Orten von den <placeName ref="l832">Franzosen</placeName> besiegt, aber nicht völlig aus der Region vertrieben; s. <persName ref="p17970">Du Bellay</persName>, Mémoires IV 194-200.</note> properare versus <lb xml:id="p1z8"/><placeName ref="l306">Mediolanum</placeName>.</s>
					<s n="4" xml:lang="la">Quam vera sint, nescio; sunt tam<lb xml:id="p1z9"/>en, qui pro certissimis venditent.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/><placeName ref="l587">Tiguri</placeName>, 20. februarii anno 1544.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/><persName ref="p495">H. Bullingerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p8418">Osvaldo Myconio</persName>, <lb xml:id="p2z2"/><placeName ref="l28">Basileiensis</placeName> ecclesiae vigilantissimo <lb xml:id="p2z3"/>pastori, fratri colendissimo.</s>
					<s n="9" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
