	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Vgl. <ref target="file12809">Nr. 2760</ref>, Anm. 2.</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. Qui tibi meas reddit, mi <persName ref="p495">Bulingere</persName>, potest tibi multa <lb xml:id="p1z2"/>narrare, quae praeteritis diebus hic evenerunt, quomodo noster ab <lb xml:id="p1z3"/>omni gubernatione per commissarios caesarianos amotus, et <lb xml:id="p1z4"/>alia.</s>
					<s n="2" xml:lang="la">Ego mitto ad te tria scripta, ex quibus etiam non pauca <lb xml:id="p1z5"/>cognosces et leges, quod sat scio, non sine stomacho.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Vellem illam veram narrationem, quae, mihi hic credas velim, <lb xml:id="p1z7"/>est verissima, a multis isthic legi et inprimis <lb xml:id="p1z8"/>a vestrae reipublicae moderatoribus.</s>
					<s n="4" xml:lang="la">Concionatoribus, ut scribitur, <lb xml:id="p1z9"/>nullus amplius manendi locus concedetur.</s>
					<s n="5" xml:lang="la">Ego etiam coepi con<lb xml:id="p1z10"/>vasare fortassis iturus <placeName ref="l491">Argentinam</placeName>.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="6" xml:lang="la">In <placeName ref="l808">Belgico</placeName> nova insti<lb xml:id="p1z11"/>tuitur persequutio.</s>
					<s n="7" xml:lang="la"><placeName ref="l1322">Lovanienses</placeName> d. <persName ref="p8371">Albertum</persName> denuo apud <lb xml:id="p1z12"/>caesarem accusarunt, cui <persName ref="p7610">Cornei</persName>, summus ducatus <placeName ref="l2925">Gelrici</placeName> <lb xml:id="p1z13"/>praefectus,<note xml:id="fn7" type="footnote" n="7"><persName ref="p7610">Philip de Lalaing</persName>, Herr von <placeName>Corney</placeName> und von <placeName ref="l2925">Gelderland</placeName>.</note> valde insidiatus fuit, quando adhuc <placeName ref="l2388">Kem<lb xml:id="p1z14"/>penae</placeName> docebat.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="8" xml:lang="la">Oro, ut rescribas copiose.</s>
					<s n="9" xml:lang="la">Ego nullam occasionem <lb xml:id="p1z15"/>scribendi ad te neglexero.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">4. februarii 1547.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z16"/>Tuus toto pectore<note xml:id="fn8" type="footnote" n="8"><bibl source="b56">Adagia</bibl>, 1, 4, 26 (<bibl>ASD</bibl> II/1 428, <ref target="file10357">Nr. 326</ref>).</note>, etc.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z17"/>Utinam vere intelligeretis, quorsum <persName ref="p18538">Caroli</persName> molimina <lb xml:id="p1z18"/>tendant!</s>
					<s n="13" xml:lang="la">Quid enim habuit aliud contra nostrum, quam cau<lb xml:id="p1z19"/>sam religionis?</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henrico Bullingero</persName>, sacrarum <lb xml:id="p2z2"/>literarum in <placeName ref="l587">Tigurina</placeName> ecclesia pr<lb xml:id="p2z3"/>ofessori diligentissimo, viro o<lb xml:id="p2z4"/>rnatissimo, suo colendo. S.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>