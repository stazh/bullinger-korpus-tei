	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Mitto tibi tandem libros, quos in epistola tua signasti; <lb xml:id="p1z2"/>reliqua non existant apud nos.</s>
					<s n="3" xml:lang="la"><persName ref="p8111">Petri Martyris</persName> commentarium in 1. epist. ad <placeName ref="l1855">Corinthi<lb xml:id="p1z3"/>os</placeName> non venit.</s>
					<s n="4" xml:lang="la">Qui autem libri apud nos edantur, nihil certi nunc temporis <lb xml:id="p1z4"/>scribere possum, quum nondum sint absoluti; sed brevi diligenter omnes omnium <lb xml:id="p1z5"/>libros, quos impressere, annotabo tibique mittam.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>De <placeName ref="l2510">Turca</placeName> audimus horrenda; occupavit in <placeName ref="l882">Hungaria</placeName> munitissimum <lb xml:id="p1z7"/>castrum, nec <placeName ref="l882">Hungaria</placeName> habuit munitiorem locum ad defendendas <placeName ref="l2510">Turcicas</placeName> incursio<lb xml:id="p1z8"/>nes.</s>
					<s n="6" xml:lang="la">Volunt <persName ref="p18477">Ferdinandini</persName> colligere exercitum, sed post acceptam cladem.</s>
					<s n="7" xml:lang="la">Verum <lb xml:id="p1z9"/>de iis quęstor<note type="margin">a.R.: <persName>G. Arnold</persName></note> aerarius absque dubio plura ad te scripsit, quem audio literas <lb xml:id="p1z10"/>ab Augusta accepisse variis de rebus, quem non potui nunc temporis alloqui, <lb xml:id="p1z11"/>quia non visus neque mea negotia hactenus locum dedere illum accedendi.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/><placeName>Parthenopolitani</placeName> adhuc fortiter hostibus suis resistunt.</s>
					<s n="9" xml:lang="la">Si <placeName ref="l2510">Turca</placeName> in armis <lb xml:id="p1z13"/>esset, dissolveretur absque dubio exercitus <persName>Mauricianus</persName> in varias partes, quod <lb xml:id="p1z14"/>quidam coniiciunt.</s>
					<s n="10" xml:lang="la">Nihil denique certius est quam <persName>Anglicum</persName> sudorem in <placeName ref="l2529">Brabantia</placeName> <lb xml:id="p1z15"/>grassari crudelissime in optimos quoque, etsi quidam adfirmant iam cessasse <lb xml:id="p1z16"/>parum.</s>
					<s n="11" xml:lang="la">Pestilens lues nos parum infestat.</s>
					<s n="12" xml:lang="la"><persName ref="p8418">Myconius</persName> noster gravissime <lb xml:id="p1z17"/>laborat domestico suo morbo, quem tandem absumet.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z18"/>Nicephori historiam excudet <persName ref="p8126">Oporinus</persName>, puto hac hyeme, quam <persName ref="p18477">Ferdinandus</persName> <lb xml:id="p1z19"/>rex illi mittet; in Latinum sermonem translata est, nescio a quo, in qua varia <lb xml:id="p1z20"/>quędam de ecclesiastico statu inveniemus ad concordiam ecclesiarum dissipatarum <lb xml:id="p1z21"/>instituendam accommodatissima.</s>
					<s n="14" xml:lang="la">Et <placeName>Abadię</placeName> quędam, historici ecclesiastici.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z22"/>Dominus variis opusculis iuvat ecclesiae reformationem; sed episcopi nolunt <lb xml:id="p1z23"/>sapere, nolunt emendari.</s>
					<s n="16" xml:lang="la">Pereant igitur cum ista pompa et pessimis institutis, <lb xml:id="p1z24"/>quę quotidie excogitant, quo verbum dei obscurent.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z25"/>Papa quid agit, ubinam latet?</s>
					<s n="18" xml:lang="la">De concilio, quid speras?</s>
					<s n="19" xml:lang="la">Rumor apud <lb xml:id="p1z26"/>nos est <persName ref="p20531">episcopum Moguntinum</persName> proficisci cum 40 equis ad concilium <placeName ref="l1107">Tridentinum</placeName>.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z27"/>Quando <placeName ref="l862">Helvetii</placeName> aliquos mittent ad lanienam?</s>
					<s n="21" xml:lang="la">Aiunt papam <placeName ref="l1409">Ancone</placeName> esse illicque <lb xml:id="p1z28"/>monstri aliquid parturire.</s>
					<s n="22" xml:lang="la">Non cessabit bestia suis dolis ecclesiam vexare, <lb xml:id="p1z29"/>sed perire debet cum omnibus suis, fiat, fiat.</s>
					<s n="23" xml:lang="la"><placeName ref="l28">Basileę</placeName> 27. augusti 1551.</s>
					<s n="24" xml:lang="la" ana="salute"><lb xml:id="p1z30"/>Salutabis d. <persName ref="p8171">Theodorum</persName>, cui brevi literas <lb xml:id="p1z31"/>et libell<lb xml:id="p1z32"/>os dabo.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">T[uus] <persName ref="p1278">Gast[ius</persName>].</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, pastori <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae vig<lb xml:id="p2z4"/>ilantissimo.</s>
					<s n="27" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
