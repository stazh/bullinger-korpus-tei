				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la">Observandissime (in Christo) cogitanti mihi saepius ad te scribere <lb xml:id="p1z2"/>per hosce aliquot menses nihil occurrit, quod dignum videbatur <lb xml:id="p1z3"/>ut literis mandaretur, propterea, quod variabili <lb xml:id="p1z4"/>rumores spargebantur.</s>
					<s n="3" xml:lang="la">Iam vero constat, acerbum illud <lb xml:id="p1z5"/>divinae justitiae flagellum sublatum esse ex hac vita, hominem <lb xml:id="p1z6"/>nostra memoria crudelissimum et sanguinem sanctorum <lb xml:id="p1z7"/>maxime sitientem.</s>
					<s n="4" xml:lang="la">Etsi autem nostra peccata commerita erant <lb xml:id="p1z8"/>tantum malum et judicium severius propter torporem et <foreign xml:lang="el">[griechisch]</foreign> <lb xml:id="p1z9"/>quae maxima ex parte nostram pervaserat patriam, <lb xml:id="p1z10"/>cum concederetur liber evangelii(?) cursus; tamen Pater <lb xml:id="p1z11"/>noster coelestis(?) et idem omnipotens Deus ostendit benignitatem <lb xml:id="p1z12"/>suam ac potentiam quomod solet.</s>
					<s n="5" xml:lang="la">Praeclarum illud <lb xml:id="p1z13"/>par.</s>
					<s n="6" xml:lang="la">D. <persName ref="p21391">Ridleus</persName> et D. <persName ref="p7623">Latymerus</persName>, paulo ante se obtulerun<lb xml:id="p1z14"/>g Deo spectabile atque eximium sacrificium; quorum <lb xml:id="p1z15"/>cineres et aliorum, qui ante emigraverunt et apud <lb xml:id="p1z16"/>Dominum et Servatorem nostrum vivunt, puto devocas<lb xml:id="p1z17"/>se Dei sententiam in superius commemoratum Dei <lb xml:id="p1z18"/>flagellum.</s>
					<s n="7" xml:lang="la">Alia non habemus certa aut explorata <lb xml:id="p1z19"/>(quod sciam impresentiarum), te digna.</s>
					<s n="8" xml:lang="la">Quinetiam <lb xml:id="p1z20"/>commemorata te arbitror jam ab aliis plenius aut <lb xml:id="p1z21"/>ante cognovisse; tamen mei esse quoque arbitratus sum, <lb xml:id="p1z22"/>ad te de eisdem scribere; nam mihi videtur jam diu, <lb xml:id="p1z23"/>quod tecum collocutus fuerim.</s>
					<s n="9" xml:lang="la" ana="salute">Quaeso salutes mihi <lb xml:id="p1z24"/>D. <persName ref="p1283">Gesnerum</persName>.</s>
					<s n="10" xml:lang="la">Mei meminisse vis in tuis precibus et <lb xml:id="p1z25"/>conditionis patriae nostrae: quod non dubito quin facias.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z26"/>Deus tibi adsit tuoque ministerio, et te conservet ad suae <lb xml:id="p1z27"/>ecclesiae commodum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l491">Argentinae</placeName>, 7 Decembris, 1555.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z28"/>Tuus, <persName ref="p1422">Jacobus Haddonus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro et observandissimo in <lb xml:id="p2z2"/>Christo patri, D. <persName ref="p495">Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> fidelissimo <lb xml:id="p2z4"/>pastori.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>