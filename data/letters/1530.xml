	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Salve, colendissime mi Laeli. paucis, quod petebas tuae
					<lb xml:id="p1z2"/>humanitati exhibeo. Scripsit nuper colendissime
					<lb xml:id="p1z3"/>compater meus d. V. Musculus fidelissime Augusta
					<lb xml:id="p1z4"/>ecclesiae pastor libellum vere pium contra
					<lb xml:id="p1z5"/>Catechismum scriptum ab impostoribus, in quo
					<lb xml:id="p1z6"/>consilium dat veris Augustanae ecclesiae piis, qumodo
					<lb xml:id="p1z7"/>se gerant in illa gravi tentatione. Inter
					<lb xml:id="p1z8"/>alia suadet, ut sibi ab illorum baptismo
					<lb xml:id="p1z9"/>caveant. Ei consilio per omnia subscribo
					<lb xml:id="p1z10"/>Olim quidem omnes baptisatisumus non papae
					<lb xml:id="p1z11"/>quidem, sed Christi baptismo; sed enim administra
					<lb xml:id="p1z12"/>ministri pontificii; nemo autem nos
					<lb xml:id="p1z13"/>a de causa rebaptisatus est. At tunc alia
					<lb xml:id="p1z14"/>ecrant tempora; nunc sunt alia. et qui mon
					<lb xml:id="p1z15"/>urgenti baptismum, ipsum pro confirmatione
					<lb xml:id="p1z16"/>antchristianismi urget, cupiunque condem
					<lb xml:id="p1z17"/>vera Christi doctrina et baptis
					<lb xml:id="p1z18"/>Unde censeo ab illorum
					<lb xml:id="p1z19"/>legitimi.
					<lb xml:id="p1z20"/>sacromentis uti et a doctrina modis omnibus
					<lb xml:id="p1z21"/>est abstinendum; iubet enim Christus cum
					<lb xml:id="p1z22"/>apostolis fugere et antchristum et omnia
					<lb xml:id="p1z23"/>ulcare antichristi figmenta. Vale, chare
					<lb xml:id="p1z24"/>Laeli et Bullingerum tuum amare
					<lb xml:id="p1z25"/>perge. 11. ianuaii 1552.
					<lb xml:id="p1z26"/>Ho. tuus.
					<pb/>
					<lb xml:id="p2z1"/>D. Bullingeri, V
				</p>
			</div>
		</body>
	</text>
