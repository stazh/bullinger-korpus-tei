	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Scripsi literas ad vos in fine februarii; spero esse redditas.</s>
					<s n="2" xml:lang="la">11. maii <lb xml:id="p1z2"/><persName ref="p495">Bullinger</persName>i et <persName ref="p1884">Lavateri</persName> literas accepi, tuas vero, <persName ref="p8011">Gwalthere</persName>, 18. eiusdem <lb xml:id="p1z3"/>mensis.</s>
					<s n="3" xml:lang="la"><persName ref="p18212">Regina Scotiae</persName> e carcere evasit circa idem tempus.</s>
					<s n="4" xml:lang="la">Cruentum <lb xml:id="p1z4"/>subito commissum est proelium inter papistas reginae amicos et pro<lb xml:id="p1z5"/>testantes regis fautores.</s>
					<s n="5" xml:lang="la">Illa, cum bellum ferveret, in colle celeri <lb xml:id="p1z6"/>equo innsidens omnia oculis lustrabat; sed cum tandem videret vic<lb xml:id="p1z7"/>toriam cessisse d. <persName>Iacobo</persName> et suis, aufugit cum paucis in <placeName ref="l830">Angliam</placeName>; <lb xml:id="p1z8"/>maluit enim se <persName>Anglis</persName> committere quam suis <placeName ref="l2524">Scotis</placeName>, et credo tutius <lb xml:id="p1z9"/>fuisse.</s>
					<s n="6" xml:lang="la">Agit iam <persName>Carleoli</persName>, in loco satis munito, brevi in <lb xml:id="p1z10"/>medio <placeName ref="l830">Angliae</placeName> commoratura, ut audio.</s>
					<s n="7" xml:lang="la">13. iulii d. <persName ref="p3222">Gulielmus <lb xml:id="p1z11"/>Turnerus</persName>, medicus bonus et vir optimus, <placeName ref="l296">Londini</placeName> obiit; <persName>Leverus</persName> <lb xml:id="p1z12"/>in eius funere est concionatus.</s>
					<s n="8" xml:lang="la">Scripsi unicas has ad vos literas <lb xml:id="p1z13"/>et breves quidem; dubito enim, utrum hae in tantis rerum tumultibus <lb xml:id="p1z14"/>ad vestras manus sint perventurae, quare plures in praesentia scribere <lb xml:id="p1z15"/>nolui.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Salutate meo nomine amicos meos omnes et praecipue d. <lb xml:id="p1z16"/><persName ref="p8442">Simlerum</persName>, <persName ref="p1884">Lavaterum</persName>, <persName ref="p3988">Wolphium</persName>, <persName ref="p1453">Hallerum</persName>, <persName ref="p8461">Wickium</persName>, <persName>Vonlichium</persName>, <persName ref="p7228">Zvinglium</persName> <lb xml:id="p1z17"/>etc.</s>
					<s n="10" xml:lang="la" ana="farewell">Bene valete.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Raptim <placeName ref="l299">Ludhamiae</placeName> 4. augusti 1568.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z18"/>Vester quantus quantus est <lb xml:id="p1z19"/><persName ref="p2473">Ioannes P[a<lb xml:id="p1z20"/>rkh<lb xml:id="p1z21"/>urstus</persName>], <placeName ref="l352">N[ordovicensis]</placeName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimis viris et i<lb xml:id="p2z2"/>ntegerrimis amicis d. <persName ref="p8011">Rod[olpho] <lb xml:id="p2z3"/>Gwalthero</persName> et d. <persName ref="p495">Henrico <lb xml:id="p2z4"/>Bullingero</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
