	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto tibi tumultuarie excerptas quasdam <lb xml:id="p1z2"/>novitates ex literis ab <placeName ref="l18">Augusta</placeName> ad d. <persName ref="p8417">Musculum</persName> scriptis<lb xml:id="p1z3"/>.</s>
					<s n="3" xml:lang="la">Alias nihil nunc habeo, quod scribam, nisi quod te cum omnibus tuis bene iubeo valere.</s>
					<s n="4" xml:lang="la" ana="farewell"><lb xml:id="p1z4"/>Vale.</s>
					<s n="5" xml:lang="la">4. aprilis 1553.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><persName ref="p8018">I. Hallerus</persName>, t[otus] t[uus].</s>
				</p>
				<p>
					<note>[Adresse a. t.:]</note>
					<s n="7" xml:lang="la">Clarissimo viro d. <persName ref="p495">Heinrycho Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> ec<lb xml:id="p1z5"/>clesię antistiti fidelissimo, dom<lb xml:id="p1z6"/>ino ac compatri suo colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
