	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Ut primum <placeName ref="l968">Raperschvicum</placeName> appuli, scire volui, quid ageret <lb xml:id="p1z2"/><persName ref="p8108">Aegidius Schudicus</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8108">Ägidius Tschudi</persName>.</note>; magno enim eius videndi desiderio tenebar.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Nunciatum est a suis ad abbatem <placeName ref="l473">Sancti Galli</placeName> divertisse, inde <lb xml:id="p1z4"/>ad marescalcum et <placeName>Lemovicensem</placeName> profecturus.</s>
					<s n="3" xml:lang="la"><placeName ref="l1066">Vaisae</placeName><note xml:id="fn2" type="footnote" n="2">Weesen?</note> obviam <lb xml:id="p1z5"/>mihi venit <persName>Iodocus Schudicu</persName>s<note xml:id="fn3" type="footnote" n="3">Tschudi.</note>, qui legionem duxit, et cum <lb xml:id="p1z6"/>eo <placeName ref="l176">Glareani</placeName> tres ex suis.</s>
					<s n="4" xml:lang="la">Multus mihi sermo cum <persName>Iodoco</persName>, <lb xml:id="p1z7"/>quem ad pacem et concordiam, quam accuratissime potui, sum <lb xml:id="p1z8"/>hortatus.</s>
					<s n="5" xml:lang="la">Sic a me abiit, ut aliquid monitis meis daturus <lb xml:id="p1z9"/>videretur, polliceretur saltem.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Tempestivum est, ut communi saluti <lb xml:id="p1z10"/>in commune omnes prospiciatis.</s>
					<s n="7" xml:lang="la">Scripsi statim ad marescalcum <lb xml:id="p1z11"/>et Lemovicensem, quid mihi in eo negocio curandum videretur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/>Ego bonae causae non deero.</s>
					<s n="9" xml:lang="la">- <placeName ref="l98">Curiae</placeName> satis quieta omnia offendi.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z13"/>Frigere <persName>Philippici</persName> videbantur et meam ultro gratiam inire, <lb xml:id="p1z14"/>hoc quia solus sum; adveniat alter: nonnisi vacuus remittetur.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z15"/>Sed ecce advenere literae a praefecto <placeName ref="l520">Vallis Telinae</placeName>, quibus <lb xml:id="p1z16"/>nunciat praefectum <placeName ref="l306">Mediolanensium</placeName> <placeName>Grawedonam</placeName>, quae in finibus <lb xml:id="p1z17"/><placeName ref="l520">Vallis Telinae</placeName> sita est, cum quadringentis equitibus venisse <lb xml:id="p1z18"/>atque eum subsequi duo millia peditum; id se ex literis praetoris <lb xml:id="p1z19"/><placeName>Morbensis</placeName> compertum habere, qui non procul <placeName>Grawedona</placeName> habitat; <lb xml:id="p1z20"/>aliorum etiam literis id rescisse itaque statuisse statim illo <lb xml:id="p1z22"/>obequitare, ut saluti publicae prospiciat; magno enim in metu versari <lb xml:id="p1z23"/>totam eam regionem; rem enim esse insolitam, ut tam vicinis <lb xml:id="p1z24"/>locis tantus armatorum hominum numerus conspiciatur.</s>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Scribit etiam se hac nocte nuncium remissurum, <lb xml:id="p2z2"/>ut de toto negocio senatus <placeName ref="l893">Trium Foederum</placeName> certius <lb xml:id="p2z3"/>edoceat.</s>
					<s n="13" xml:lang="la">Satis coniicere non possum, si modo haec vera sunt, <lb xml:id="p2z4"/>quid moliatur <placeName ref="l875">Hispanus</placeName>; nec enim ulla est a <placeName ref="l648">Rhaetis</placeName> <lb xml:id="p2z5"/>iniuria lacessita et se foedus aliquod cum his hominibus <lb xml:id="p2z6"/>contrahere velle hactenus simulavit.</s>
					<s n="14" xml:lang="la">Quodsi ea est <lb xml:id="p2z7"/>perfidia, vide ne aliquod maius monstrum alat.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Varii varia <lb xml:id="p2z8"/>in hac re comminiscuntur, eo scilicet factum, ut terrorem <lb xml:id="p2z9"/><placeName ref="l648">Rhaetis</placeName> incutiat atque ea ratione vel invitos ad foedus <lb xml:id="p2z10"/>contrahendum impellat.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Sed hoc admodum ineptum commentum <lb xml:id="p2z11"/>videtur.</s>
					<s n="17" xml:lang="la"><persName ref="p8112">Rex Franciae</persName> nullo iam ad tuendos <placeName ref="l648">Rhaetos</placeName> <lb xml:id="p2z12"/>foedere est obligatus, sed tamen pace, quae ei cum <lb xml:id="p2z13"/>rege <placeName ref="l875">Hispano</placeName> intercedit, Helvetios Rhaetosque diserte <lb xml:id="p2z14"/>comprehensos voluit.</s>
					<s n="18" xml:lang="la">Harum rerum causa hic <placeName ref="l98">Curiae</placeName> coactus es<lb xml:id="p2z15"/>t de nocte senatus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Sed cras mane aliquid certius <lb xml:id="p2z16"/>scietur, et addam huic epistolae.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Instat undecima et i<lb xml:id="p2z17"/>am multa hoc die scripsi, ut mihi iam quiescendum sit.</s>
					<s n="21" xml:lang="la"><lb xml:id="p2z18"/>Dominus <persName ref="p8011">Gvalterus</persName> salvebit meo nomine.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Si pestis <lb xml:id="p2z19"/><placeName ref="l587">Tiguri</placeName> ingravescat, velim, pro sua prudentia <persName ref="p629">Cognetiis</persName> <lb xml:id="p2z20"/>et <persName>Scevis</persName> prospiciat.</s>
					<s n="23" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><placeName ref="l98">Curiae</placeName> 18. septembris.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Tuus <persName ref="p8160">P[omponne] <lb xml:id="p2z21"/>Bellievre</persName>.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p3z1"/>Hac epistola scripta hodie 19. septembris redditae <lb xml:id="p3z2"/>sunt consulibus et senatui <placeName ref="l98">Curiensi</placeName> literae a <placeName ref="l37">Bregalia</placeName>.</s>
					<s n="27" xml:lang="la"><lb xml:id="p3z3"/>Nunciant se audisse quingentos <placeName ref="l875">Hispanos</placeName> <placeName>Travonam</placeName> <lb xml:id="p3z4"/>occupasse, quod oppidum in <placeName ref="l520">Valle Telina</placeName> situm est.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p3z5"/>Omnino ad arma consternati sunt popularium animi; <lb xml:id="p3z6"/>indicitur delectus in tota <placeName ref="l648">Rhetia</placeName>.</s>
					<s n="29" xml:lang="la">Sed quum certius <lb xml:id="p3z7"/>aliquid expectare constituissem, tandem refrixit <lb xml:id="p3z8"/>panicus rumor ille.</s>
				</p>
				<p>
					<s n="30" xml:lang="la">Advenere nonnulli e <placeName ref="l520">Valle Telina</placeName> <lb xml:id="p3z9"/>et <placeName ref="l306">Mediolano</placeName>.</s>
					<s n="31" xml:lang="la">Aiunt praeffectum <placeName ref="l306">Mediolanensem</placeName> <lb xml:id="p3z10"/>regiones <placeName ref="l648">Rhaetiae</placeName> conterminas obequitare ea gratia, <lb xml:id="p3z11"/>ut praesidia et munitiones oppidorum dispiciat; esse <lb xml:id="p3z12"/>quidem cum aliquo equitatu, de peditibus nihil audiri; <lb xml:id="p3z13"/>nihil porro in Rhoetos movisse.</s>
				</p>
				<p>
					<s n="32" xml:lang="la">Non dubito <lb xml:id="p3z14"/>rumorem hunc a perfidis quibusdam sparsum inepto, <lb xml:id="p3z15"/>ut dixi, commento, quo Rhoetis <placeName ref="l306">Mediolanensium</placeName> potentia <lb xml:id="p3z16"/>terrori sit; sed spero importunum dolum autori male <lb xml:id="p3z17"/>cessurum.</s>
				</p>
				<p>
					<s n="33" xml:lang="la">Nunciatur comitem <persName>Ioannem Angusolam</persName>, <lb xml:id="p3z18"/><persName>Philippi</persName> legatum, statuisse ad <placeName ref="l648">Rhoetos</placeName> redire, <lb xml:id="p3z19"/>ut de foedere agat et absolvat.</s>
					<s n="34" xml:lang="la">Haec si vera <lb xml:id="p3z20"/>sunt, maior rerum mihi nascitur ordo.</s>
				</p>
				<p>
					<s n="35" xml:lang="la">Si quid praeterea <lb xml:id="p3z21"/>audiero, faciam te certio[rem].</s>
					<s n="36" xml:lang="la" ana="farewell">Bene vale, vir <lb xml:id="p3z22"/>praestantissime.</s>
				</p>
				<p>
					<s n="37" xml:lang="la"><placeName ref="l98">Curia</placeName> 20. septembris.</s>
				</p>
				<p>
					<s n="38" xml:lang="la"><pb/><lb xml:id="p4z1"/>Amplissimo viro domino <lb xml:id="p4z2"/><persName ref="p495">Bullingero</persName>, ecclesiae <lb xml:id="p4z3"/><placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p4z4"/>dignissimo.</s>
				</p>
				<p>
					<s n="39" xml:lang="la"><lb xml:id="p4z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
