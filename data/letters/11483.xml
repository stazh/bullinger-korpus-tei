	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Ex literis<note xml:id="fn1" type="footnote" n="1">Oben <ref target="file11479">Nr. 1436</ref>.</note> tuis, <persName ref="p495">Bullingere</persName> pater, quas tu ad <persName ref="p8011">Rodolphum</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p8011">Rudolf Gwalther</persName>.</note> nostrum <lb xml:id="p1z2"/>dedisti, intellexi te mihi cum propter meam istam profectionem<note xml:id="fn3" type="footnote" n="3">Gemeint ist die eigenmächtige Abreise der Zürcher Studenten aus <placeName ref="l512">Tübingen</placeName>; vgl. ebd., Z. 20f mit Anm. 12.</note> <lb xml:id="p1z3"/>tum propter gradum seu, ut vocant, magisterii rationem<note xml:id="fn4" type="footnote" n="4">Vgl. ebd., Z. 4-14.</note> <lb xml:id="p1z4"/>succensere, id quod mihi non mediocrem attulit <lb xml:id="p1z5"/>molestiam; neque enim mihi lene debet videri, si <lb xml:id="p1z6"/>te<note xml:id="fna" type="footnote" n="a"><hi>vor</hi> te <hi>gestrichenes</hi> ad.</note>, ad quem semper ceu sacram anchoram<note xml:id="fn5" type="footnote" n="5">Vgl. Adagia, 1, 1, 24 (<bibl source="b370">LB</bibl> II 35f).</note> confugio, habeam <lb xml:id="p1z7"/>iratum, qui uno te authore omnes fortunae meae <lb xml:id="p1z8"/>fundatas presertim atque optime constitutas opes possideam.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z9"/>Proinde cum nequeam animo meo aliquam saltem <lb xml:id="p1z10"/>tranquillitatem parere, antequam me<note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> me <hi>gestrichenes</hi> te.</note> tecum in <lb xml:id="p1z11"/>gratiam rediisse cognoverim, te, ut mihi ignoscas, <lb xml:id="p1z12"/>iterum atque iterum oro; nam quod proximis literis ad <lb xml:id="p1z13"/>matrem datis<note xml:id="fn6" type="footnote" ana="bio" n="6"><persName ref="p3988">Wolfs</persName> Brief an seine Mutter (<persName ref="p7092">Margaretha Leu</persName>) ist nicht erhalten.</note> pecuniam iterum postularim<note xml:id="fn7" type="footnote" n="7">Vgl. oben <ref target="file11479">Nr. 1436</ref>, 14-19.</note>, id graduum <lb xml:id="p1z14"/>ratione (sic enim isti eas dignitates vocant) ad<lb xml:id="p1z15"/>ductus feci, quod alioquin omisissem, neque enim opus <lb xml:id="p1z16"/>erat propter huiusce loci commoditatem.</s>
					<s n="3" xml:lang="la">Sumus enim in <lb xml:id="p1z17"/>ea nunc civitate, ut studiis nostris optime consultum <lb xml:id="p1z18"/>videamus et multo minoris vivere possimus, quam vel <lb xml:id="p1z19"/>etiam <placeName ref="l587">Tiguri</placeName>.</s>
					<s n="4" xml:lang="la">Ego dabo operam, ut bonorum virorum de me <lb xml:id="p1z20"/>expectationi pro virili mea satisfaciam, si modo quę <lb xml:id="p1z21"/>superest; nam literis <persName ref="p167">Ammiani</persName><note xml:id="fn8" type="footnote" n="8">Gemeint ist der oben <ref target="file11479">Nr. 1436</ref>, 11 erwähnte Brief <persName ref="p167">Johann Jakob Ammanns</persName> an <persName ref="p8011">Gwalther</persName>.</note> ita sum afflictus, ut <lb xml:id="p1z22"/>nihil mihi pristinae existimationis reliquum putem, quam quod <lb xml:id="p1z23"/>clementia retineatur vestra.</s>
					<s n="5" xml:lang="la">Sed quia tibi plura scio <lb xml:id="p1z24"/>negotia, quam ut hisce meis nugis vacare<note xml:id="fnc" type="footnote" n="c"><hi>korrigiert aus</hi> vaf.</note> possis, <lb xml:id="p1z25"/>finem iam scribendi faciam teque orabo, ut, quem <lb xml:id="p1z26"/>olim pluribus adiuvisti beneficiis, eum<note xml:id="fnd" type="footnote" n="d">eum <hi>über der Zeile nachgetragen.</hi></note> nunc pristinae existimationi <lb xml:id="p1z27"/>restituas.</s>
					<s n="6" xml:lang="la">Quod ut velis, te vehementer <lb xml:id="p1z28"/>etiam atque etiam oro.<pb type="edition" next="207"/></s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Vale et me, quod soles, amare <lb xml:id="p1z29"/>perge.</s>
					<s n="8" xml:lang="la">Dominus velit hunc annum tibi tuisque felicem <lb xml:id="p1z30"/>et <lb xml:id="p1z31"/>faustum, pręcor.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l311">Marpurgi</placeName>, 21. decembris anno 1540.</s>
					<s n="10" xml:lang="la">Christi<note xml:id="fne" type="footnote" n="e">Christi <hi>in Majuskeln.</hi></note>.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z32"/>Tuus <persName ref="p3988">Iohannes Wolphius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinorum</placeName> episcopo vigi<lb xml:id="p2z4"/>lantissimo, patri suo reve<lb xml:id="p2z5"/>rendo.</s>
				</p>
