	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Principem <persName ref="p2411">Otto Henrichum Palatinum</persName> electoratum ingressurum et aditurum <lb xml:id="p1z2"/>binos nunc menses comitatus sum.</s>
					<s n="3" xml:lang="la">A quo heri tandem redii <lb xml:id="p1z3"/>incolumis, deo sit laus.</s>
					<s n="4" xml:lang="la">Successerunt illi omnia prospere, neque <lb xml:id="p1z4"/>dubito, si illi tot virium quantum corporis esset, ipsum multa egregia <lb xml:id="p1z5"/>conaturum facturumque, licet nondum plene in rebus divinis <lb xml:id="p1z6"/>sit institutus.</s>
					<s n="5" xml:lang="la">Nam neque <persName ref="p4639">Michael Dillerus</persName>, ipsius ille concionator, <lb xml:id="p1z7"/>satis dexter est, praesertim in eo, quod sacramenta attinet, quę <lb xml:id="p1z8"/>ita frigide tractat, ut se ipsum intelligere neutiquam videatur, atque <lb xml:id="p1z9"/>eam ob rem adulatur mirum in modum, tum adulando etiam optimis <lb xml:id="p1z10"/>quibusdam impedimento est, quemadmodum magister <persName ref="p8130">Laurentius <span type="pronoun">noster</span> <lb xml:id="p1z11"/>Agricola</persName> nuper a me intellexit, qui tibi haud dubie etiam expo<lb xml:id="p1z12"/>siturus est, qualem camarinam malevoli quidam ipsi moverint.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Omnia Sathan, nihil minus quam puritatem circa sacramentorum usum <lb xml:id="p1z14"/>ferre potest.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Illud porro sciens ea sibi idololatria sublata <lb xml:id="p1z15"/>tantam nundinationem raro postea obventurum.</s>
					<s n="8" xml:lang="la">Ego defendo, ego <lb xml:id="p1z16"/>interpello, adversariorum ictus, quantumquantum possum, excutio nec <lb xml:id="p1z17"/>vereor propter veritatem malam gratiam etiam apud principem <lb xml:id="p1z18"/>inire.</s>
					<s n="9" xml:lang="la">Scripsi pręterea <persName ref="p2095">Philippo Melanchthoni</persName> et iudicium <lb xml:id="p1z19"/>ipsius super <placeName ref="l167">Genevensium</placeName> et <placeName ref="l862">Helvetiorum</placeName> consensione petii, sed qui <lb xml:id="p1z20"/>nihil respondit et pisce mutior fuit.</s>
					<s n="10" xml:lang="la">Hippus ille est, id quod <lb xml:id="p1z21"/>insynceritatis ipsius mihi argumentum dat.</s>
					<s n="11" xml:lang="la">Sed bene est; <lb xml:id="p1z22"/>maneat ille <persName ref="p18585">Pithagorę</persName> suo discipulus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/>Ad indutias inter <persName ref="p18538">Cęsarem</persName> et <persName ref="p20225">Gallum</persName> etiam transactio <persName ref="p18477">Ferdinandi</persName> <lb xml:id="p1z24"/>cum <placeName ref="l2510">Turca</placeName> facta esse dicitur non sine magna regii nominis <lb xml:id="p1z25"/>ignominia.</s>
					<s n="13" xml:lang="la">Nunc conventus prius <placeName ref="l410">Ratisponam</placeName> indictus <lb xml:id="p1z26"/>ad 1. iulii iterum reintegratus est; sed principes nostri eo non venturi <lb xml:id="p1z27"/>sunt, nisi ipsis ad omnia de religione recte caveatur.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z28"/>Papistę moliti sunt bellum; sed, ut audio, pessimi isti conatus <lb xml:id="p1z29"/>in spongiam reciderunt.</s>
					<s n="15" xml:lang="la">Cardinalis <placeName ref="l18">Augustanus</placeName> fortassis aliquid <lb xml:id="p1z30"/>olfecit, quapropter ipsi a consuetis penatibus iam abstinet et <lb xml:id="p1z31"/>sese hinc inde apud raclam continet.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z32"/>Exemplaria contra <placeName ref="l2507">Westphalum</placeName> etc., item <placeName ref="l822">Germanicum</placeName> et Latinum <lb xml:id="p1z33"/><persName>Bertramum</persName> de sacramentis habere pervelim.</s>
					<s n="17" xml:lang="la"><persName ref="p8130">Laurentius</persName> <lb xml:id="p1z34"/>solvet.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="farewell">Vale et pro <persName ref="p8354">Laeto</persName> ora dominum.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z35"/>Quid quadrati vestri <persName>Tugiani</persName> moliantur et quousque ipsorum <lb xml:id="p1z36"/>insania pervagata sit, ex te discere cupio.</s>
					<s n="20" xml:lang="la" ana="salute">Fratres singulos <lb xml:id="p1z37"/>salutabis.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Ex laribus propriis 27. aprilis 1556.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z38"/>Astrorum facies ita me nunc ludere cogit: <lb xml:id="p1z39"/>Omnia pernitiem terris elemanta minantur <lb xml:id="p1z40"/>Ve tibi, qui necdum cęperis esse pius.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z41"/>Tuus <persName ref="p8354">G[eorgius] Lętus</persName> a <placeName>Lemnicz</placeName>, <lb xml:id="p1z42"/>electoratus <persName>Palatini Rheni</persName> etc. <lb xml:id="p1z43"/>consiliarius.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p2z1"/>Fratri et amico suo <lb xml:id="p2z2"/>d. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z3"/>antistiti <placeName ref="l587">Tigurino</placeName>.</s>
				</p>
			</div>
