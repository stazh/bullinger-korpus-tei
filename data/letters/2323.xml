	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Statueram ex conventu <placeName ref="l21">Badensi</placeName> vos invisere; <lb xml:id="p1z2"/>sed tot bellicis tumultibus obruimur, ut <lb xml:id="p1z3"/>non licuerit.</s>
					<s n="3" xml:lang="la">Spero tamen brevi fore; nam <lb xml:id="p1z4"/>scis proxima alia esse commitia indicta <lb xml:id="p1z5"/>nec etiam rationem ignoras, quam rogo <lb xml:id="p1z6"/>cum omnibus bonis velis diligenter <lb xml:id="p1z7"/>et serio ponderare, ne quid inde ex <lb xml:id="p1z9"/>pace publica perturbetur.</s>
					<s n="4" xml:lang="la">Scis <lb xml:id="p1z10"/>artes Caesaris et quantum delect[et]<lb xml:id="p1z11"/>ur civilibus discordiis.</s>
					<s n="5" xml:lang="la" ana="salute">Novi si quid <lb xml:id="p1z12"/>habeo, ex memoriali hic incluso <lb xml:id="p1z13"/>videbis, quare non addo; communicabis et <lb xml:id="p1z14"/>offeres, si placet, dominis, inter quos <lb xml:id="p1z15"/>multum saluto dominum vestrum consulem <lb xml:id="p1z16"/><persName ref="p1419">Hab[ium]</persName>, qui vir et probus et integer est.</s>
					<s n="6" xml:lang="la">Rap<lb xml:id="p1z17"/>tim ex <placeName ref="l760">Soluturo</placeName> 26<lb xml:id="p1z18"/>a iuni<lb xml:id="p1z19"/>i.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z20"/>Tuus sem<lb xml:id="p1z21"/>per <persName ref="p8296">Bas[safontaneus]</persName> s[cripsit].</s>
					<s n="8" xml:lang="la">Scis marquionem iterum victum, <lb xml:id="p1z22"/>fugatum et <placeName ref="l1031">Schevinfurdium</placeName> <lb xml:id="p1z23"/>occupatum exustumque.</s>
					<s n="9" xml:lang="la">Brunche... <lb xml:id="p1z24"/>ille iterum occupat thyrannidem in <placeName ref="l822">Germania</placeName> <lb xml:id="p1z25"/>et plus sibi ab illo timent principes quam <lb xml:id="p1z26"/>ante marquione nec sine causa; est enim <lb xml:id="p1z27"/>totus Caesarianus et nebulo, si quis alius; <lb xml:id="p1z28"/>nosti hominem<pb/><lb xml:id="p3z1"/>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p4z1"/>Optimo viro domino <lb xml:id="p4z2"/><persName ref="p495">Bulingero</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p4z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
