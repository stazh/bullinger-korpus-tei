	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Gratissimae fuerunt mihi tuae dominationis literae, mi D. <persName ref="p495">Bullingere</persName>.</s>
					<s n="3" xml:lang="la">Si unquam tibi vel tuis meo officio inservire possum, <lb xml:id="p1z3"/>habebis me paratum.</s>
					<s n="4" xml:lang="la">Ostendam reverendissimo nostro literas tuas offeramque illi quo nomine officium tuum.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z4"/>Literas tuas ad D. <persName>Florianum</persName>, qui ante sex dies adhuc <placeName ref="l157">Franckfordiae</placeName> fuit, curabo; inveniam illum <placeName ref="l267">Coloniae</placeName> <lb xml:id="p1z5"/>deo favente.</s>
					<s n="6" xml:lang="la">Loquutus sum cum doctore <persName ref="p8121">Christophoro Mont</persName>, qui <placeName ref="l491">Argentinae</placeName> habitat prope <persName>Carmelitas</persName> <lb xml:id="p1z6"/>de parandis libris; potes illi omnia committere; is, ut est syncerus et probus, bona fide transmittet; <lb xml:id="p1z7"/>est enim commissarius et a secretis regis <placeName ref="l830">Angliae</placeName>.</s>
					<s n="7" xml:lang="la" ana="salute">Salutavit tuam dominationem ante aliquot dies per D. <lb xml:id="p1z8"/><persName ref="p506">Iohannem Botlerum</persName> <placeName ref="l830">Anglum</placeName>, qui <placeName ref="l587">Tiguri</placeName> apud vos est; cupit tuam familiaritatem et notitiam.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z9"/>Queso, mi D. <persName ref="p495">Bullingere</persName>, tua dominatio velit indicare D. <persName ref="p4851">Christophoro Foschovero</persName>, ut omnia paret, que neces<lb xml:id="p1z10"/>saria sunt in imprimenda Biblia, et ut nemini communicet se velle Biblia imprimere, et si potest <lb xml:id="p1z11"/>habere diligentem lectorem Anglum, ut neque sumptus neque pecunia parcat, ut tandem ad dei <lb xml:id="p1z12"/>gloriam prodeat castigatissima.</s>
					<s n="9" xml:lang="la">Tua dominatio apud D. <persName ref="p506">Botlerum</persName> aliquid potest, ut is sua diligentia et opera <lb xml:id="p1z13"/>iuvet pro honore dei et patriae amore.</s>
					<s n="10" xml:lang="la" ana="salute">Salutat tuam dominationem doctor <persName ref="p8121">Christophorus Mont</persName> <lb xml:id="p1z14"/>et D. <persName ref="p506">Botlerum</persName>.</s>
					<s n="11" xml:lang="la" ana="salute">Salutabis meo nomine D. <persName ref="p8127">Pellicanum</persName>, D. <persName ref="p1283">Gesnerum</persName>, D. <persName ref="p8011">Gualterum</persName> et tuum generum <lb xml:id="p1z15"/>D. <persName ref="p7228">Zwinglium</persName> et D. <persName ref="p4851">Froschoverum</persName>.</s>
					<s n="12" xml:lang="la">D. <persName ref="p8127">Pellicani</persName> literas ad <persName>Gerardum Veltwichium</persName> expectavi <lb xml:id="p1z16"/>frustra.</s>
					<s n="13" xml:lang="la">Commendo me vestris precibus ad dominum.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale in Christo cum omnibus tuis.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z17"/>Tuus <persName ref="p380">Iohannes Byrchmannus</persName> scripsit.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo multeque lectionis <lb xml:id="p2z2"/>viro D. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>domino plurimum colendo.</s>
					<s n="17" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
