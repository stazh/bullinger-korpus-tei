	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuas tantum accepi et nostro <persName ref="p3375">V[ergerio]</persName> <lb xml:id="p1z2"/>respondeo.</s>
					<s n="3" xml:lang="la">Quod autem scribit de <lb xml:id="p1z3"/>quinquaginta coronatum, nihil <lb xml:id="p1z4"/>profecto antea audierim; sed curabo st<lb xml:id="p1z5"/>atim post adventum meum <placeName ref="l760">Solo[turum(<lb xml:id="p1z6"/>duri?)]</placeName> <lb xml:id="p1z7"/>et illud per aliam viam quam tua <lb xml:id="p1z8"/>opera faciam, nam hoc par<lb xml:id="p1z9"/>um <lb xml:id="p1z10"/>conveniens nec ratione <lb xml:id="p1z11"/>consentaneum propter tuum munus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z12"/>Dominus vester consul narrabit tibi <lb xml:id="p1z13"/>ordine, quo in statu res nostre vestreque sese <lb xml:id="p1z14"/>hic habuerint.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Fere ventum est <lb xml:id="p1z16"/>ad iurgia; propterea rogo te et obtesto, <lb xml:id="p1z17"/>ut consulatis paci publice <lb xml:id="p1z19"/>et <lb xml:id="p1z20"/>aliorum ruditati aliquid condonetis.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z21"/>Crede mihi, plus hac ratione <lb xml:id="p1z22"/>facili in tempore perficietis.</s>
					<s n="7" xml:lang="la">Caeterea, <lb xml:id="p1z23"/>que penę non audeo committere, narrabit dom<lb xml:id="p1z24"/>inus consul; nam cum illo et domino secretario <lb xml:id="p1z25"/>pluribus egi.</s>
					<s n="8" xml:lang="la">Nova nostra ab illis <lb xml:id="p1z26"/>audietis.</s>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z27"/>Vale, vir optime.</s>
					<s n="10" xml:lang="la"><placeName ref="l21">Badde</placeName> dec<lb xml:id="p1z28"/>ima sept[embris].</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z29"/>Tuus sem<lb xml:id="p1z30"/>per <persName ref="p8296">Bass[afontaneus]</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p3z1"/>Optim<pb/><lb xml:id="p4z1"/>o viro domino <lb xml:id="p4z2"/><persName ref="p495">Bulingero</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p4z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
