	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Revertitur ad vos, compater in domino <lb xml:id="p1z2"/>charissime, dilectus frater noster <persName ref="p3178">Ioannes Traberus</persName>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Non fuisset mihi oneri s mansisset; verum <lb xml:id="p1z4"/>quoniam arbitratur citius fieri posse, ut vel <lb xml:id="p1z5"/>apud <placeName ref="l648">Rhoetos</placeName> vel <placeName ref="l646">Glareanos</placeName> vel <placeName ref="l17">Appenzellanos</placeName> <lb xml:id="p1z6"/>vocationem inveniat, si ad <lb xml:id="p1z7"/>vos concedat, quam si hic haereat, statuit opera <lb xml:id="p1z8"/>tua et benevolentia adiutus tantisper apud <lb xml:id="p1z9"/>vos manere, dum aliqua ipsi ratione pro<lb xml:id="p1z10"/>spiciatur.</s>
					<s n="4" xml:lang="la">Plane syncerus est et expers <lb xml:id="p1z11"/>omnis vafriciei, sanus doctrina et vita <lb xml:id="p1z12"/>innocens.</s>
					<s n="5" xml:lang="la">Obsecro, iuves eum, quod licuerit; <lb xml:id="p1z13"/>nihil habet; quae accepit ab <placeName ref="l18">Augustanis</placeName>, <lb xml:id="p1z14"/>reliquit uxori et filiae profectusque est modi<lb xml:id="p1z15"/>co viatico contentus ac sperans fore, ut <lb xml:id="p1z16"/>haudquaquam ope d[omini]<note type="margin">a.R.: d[ivinae</note>?] providentiae destituatur.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z17"/>Caeterum mitto hic divisionem decalogi, qua in <lb xml:id="p1z18"/>ecclesiis Christi utimur, testimoniis patrum con<lb xml:id="p1z19"/>firmatam eo consilio, ut ocurram nebulo<lb xml:id="p1z20"/>nibus et impostoribus illis, qui iam <placeName ref="l18">Augustae</placeName> <lb xml:id="p1z21"/>secundum praeceptum de vitandis imaginibus <lb xml:id="p1z22"/>e catechsimis auferunt, quod non papistę <lb xml:id="p1z23"/>modo et Interimistae, sed et Lutherani <lb xml:id="p1z24"/>faciunt, quo usum imaginum in ecclesias <lb xml:id="p1z25"/>evangelicas post liminio reducant.</s>
					<s n="7" xml:lang="la">Oro, si qua <lb xml:id="p1z26"/>ratione poteris, mittas ista per <placeName ref="l473">Sangallenses</placeName> <lb xml:id="p1z27"/><placeName ref="l18">Augustam</placeName> vel ad <placeName ref="l320">Memmingenses</placeName> vel <lb xml:id="p1z28"/><placeName ref="l907">Campidonenses</placeName> etc.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z29"/>De conciliabulo <lb xml:id="p1z30"/><placeName ref="l1107">Tridentino</placeName> magnum est silentium.</s>
					<s n="9" xml:lang="la">Caesar haeret <lb xml:id="p1z31"/>adhuc <placeName ref="l18">Augustae</placeName> nec scitur, quando sit <lb xml:id="p1z32"/>discessurus, id quod a tabellario quodam <lb xml:id="p1z33"/><placeName ref="l18">Augustano</placeName> pridie accepi, qui referebat <lb xml:id="p1z34"/>sexcentos equites expectari <placeName ref="l18">Augustae</placeName>, quibus <lb xml:id="p1z35"/>usurus sit Caesar vel in <placeName ref="l834">Italiam</placeName> vel <lb xml:id="p1z36"/>in <placeName ref="l822">Germaniam</placeName> Inferiorem discessurus.</s>
					<s n="10" xml:lang="la" ana="farewell">Optime vale, <lb xml:id="p1z37"/>compater charissime.</s>
					<s n="11" xml:lang="la">Opto nuptiis <persName ref="p6609">Elizabethę</persName> tuę <lb xml:id="p1z38"/>omnia prospera.</s>
					<s n="12" xml:lang="la">Dominus te ac tuos diu <lb xml:id="p1z39"/>servet incolumes.</s>
					<s n="13" xml:lang="la" ana="salute">Salutant te ac domum tuam <lb xml:id="p1z40"/>mei omnes.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1551. 8. octobris.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z41"/><persName ref="p8417">W[olfgangus] Mus[culus]</persName>, tuus in domino compater.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo theologo <lb xml:id="p2z2"/>m. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, compatri suo <lb xml:id="p2z4"/>in domino charissimo.</s>
				</p>
			</div>
		</body>
