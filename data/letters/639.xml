	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hospes in <placeName ref="l1099">Balstall</placeName>, si recte memini, duos pavit per dies plus minus decem.</s>
					<s n="3" xml:lang="la">Vestiti fuerunt <lb xml:id="p1z2"/>serico villoso <placeName ref="l834">Italorum</placeName> et <placeName ref="l875">Hispanorum</placeName> more.</s>
					<s n="4" xml:lang="la">Post simul profecti sunt <placeName ref="l21">Badenam</placeName> <lb xml:id="p1z3"/>versus; pernoctarunt in pago quodam non longe ab <placeName ref="l2">Arovia</placeName>.</s>
					<s n="5" xml:lang="la">Convenerant, quod mane <lb xml:id="p1z4"/>vellent hora tertia pergere, ne ęstus eos divexaret.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ita factum.</s>
					<s n="7" xml:lang="la">Posteaquam igitur aliquo<lb xml:id="p1z5"/>usque sunt profecti, duo isti pugione confoderunt hospitem tollentes ab eo pecuniam, equum, <lb xml:id="p1z6"/>et quicquid conferre potuerunt.</s>
					<s n="8" xml:lang="la">Super <placeName>Arulam</placeName> fuit piscator, qui ut audivit gemitus <lb xml:id="p1z7"/>et eiulatum, putavit primo vocem esse alicuius umbrę; tandem vero adplicata navicula <lb xml:id="p1z8"/>reperit, quod erat patratum latrocinium; latrones autem aufugerant.</s>
					<s n="9" xml:lang="la">Dicuntur <lb xml:id="p1z9"/>ante paucos dies hac in equis transiisse.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Par pari.</s>
					<s n="11" xml:lang="la">Pręludia videntur esse, sicut <lb xml:id="p1z10"/>divinas, futurorum malorum.</s>
					<s n="12" xml:lang="la">Dominus, quem confitemur, nobis adsit.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z11"/>Cęsar voluit, ut <placeName ref="l808">Belgę</placeName> iurarent filio; quod dum renuerunt, illud invenit: iura<lb xml:id="p1z12"/>mentum non debere valere, nisi post obitum suum, atque ita persuasit.</s>
					<s n="14" xml:lang="la">Causa videtur <lb xml:id="p1z13"/>esse multis, quia stultus est filius, timuit pater iuramentum non praestaturos <lb xml:id="p1z14"/>illos, si mortem obiret ipse.</s>
					<s n="15" xml:lang="la">Rediturus iterum <placeName ref="l1284">Bruxellas</placeName> repetet lingnum <placeName>Ba<lb xml:id="p1z15"/>iacum</placeName>.</s>
					<s n="16" xml:lang="la">Sic consul <placeName ref="l491">Argentinensis</placeName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z16"/><placeName ref="l491">Argentinenses</placeName>, qui procrastinant, quicquid agendum cum episcopo, timent fere Cęsarem <lb xml:id="p1z17"/>venturum aliquando ad se.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Quamobrem multi boni viri de migrando cogitant, <lb xml:id="p1z18"/>ex quibus et mecum aliquot egerunt.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z19"/>Interrogavi tabellionem de mersis <placeName ref="l648">Grisonibus</placeName> in <placeName ref="l2456">lacu Tigurino</placeName>; respondit <lb xml:id="p1z20"/>se non audivisse vel unum verbum.</s>
					<s n="20" xml:lang="la">Mirabar; tum ille: "Non pugnabo; nam ra<lb xml:id="p1z21"/>ro sum domi; interim accidunt multa, quę ad me non pertingunt."</s>
					<s n="21" xml:lang="la">Plura <lb xml:id="p1z22"/>non sunt.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="farewell">Vale in domino cum tuis et fratribus omnibus.</s>
					<s n="23" xml:lang="la"><placeName ref="l28">Basileę</placeName> raptim 19. augusti anno <lb xml:id="p1z23"/>1549.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z24"/>T[uus] <persName ref="p8418">Os[waldus] Myconius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>in domino suo.</s>
				</p>
			</div>
		</body>
	</text>
