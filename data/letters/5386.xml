	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Certissimum est papam missurum grandem <lb xml:id="p1z2"/>pecuniam, et petiturum 4000 <placeName ref="l862">Helvetiorum</placeName>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Praetexit defensionem sui corporis et sellae, <lb xml:id="p1z4"/>sed compertum est, usurum illo milite pro <lb xml:id="p1z5"/><persName ref="p20225">Guysio</persName>.</s>
					<s n="4" xml:lang="la">Certissimum est aliquot centurias <lb xml:id="p1z6"/>equitum <placeName ref="l1041">Brunsvigicorum</placeName> conscriptas esse, et <lb xml:id="p1z7"/>a comite <placeName ref="l2459">Rheni</placeName>, <persName>Rhyngraff</persName>, conscribi 2 <lb xml:id="p1z8"/>legiones lanzknechtorum pro <persName ref="p20225">Guysio</persName>.</s>
					<s n="5" xml:lang="la">Haec <lb xml:id="p1z9"/>si nostri ignorant, moneantur in tempore omnium.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Rursus inculco: Vigilate ne <placeName ref="l301">Lugdunum</placeName> veniat <lb xml:id="p1z11"/>in manus hostium.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Festinantissime<lb xml:id="p1z12"/>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/><placeName ref="l587">Tiguri</placeName> 3. iulii 156<lb xml:id="p1z14"/>2.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Tuus quem nosti.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro <lb xml:id="p2z2"/>d. <persName ref="p540">Ioanni Calv<lb xml:id="p2z3"/>ino</persName> domino <lb xml:id="p2z4"/>et fratri suo <lb xml:id="p2z5"/>colendo et dilecto.</s>
					<s n="12" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l167">Genff</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
