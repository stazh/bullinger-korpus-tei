	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Etsi multa, que ad te scriberem, habebam, ornatissime <lb xml:id="p1z2"/>vir, non potui tamen, quod maxime volui, recensere et <lb xml:id="p1z3"/>de multis et gravibus rebus animi sententiam ex<lb xml:id="p1z4"/>ponere.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z5"/>Nuntius enim in platea mihi obviam factus iam<lb xml:id="p1z6"/>iam abiturus erat.</s>
					<s n="3" xml:lang="la">Scribam prima occasione mihi <lb xml:id="p1z7"/>oblata verbosissime.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/><persName ref="p8112">Gallorum rex</persName> in <placeName ref="l2529">Brabantia</placeName> magna victorię fecit <lb xml:id="p1z9"/>fundamenta, sed rem feliciter inchoatam non <lb xml:id="p1z10"/>admodum et ex omni parte prudenter absolvit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Heri circa horam 6tam postmeridianam <lb xml:id="p1z12"/>duo <placeName ref="l875">Hispani</placeName> per equos celeres ex <placeName ref="l834">Italia</placeName> <lb xml:id="p1z13"/>ad Cęsarem celerrime properarunt, qui iactarunt <lb xml:id="p1z14"/>gloriosius <persName ref="p6724">Strotii</persName>, hoc est <placeName>Galli</placeName> exercitum esse <lb xml:id="p1z15"/>dissipatum, cęsum et prostratum, quare Cęsari s<lb xml:id="p1z16"/>e apportaturos victorum signorum letissimum <lb xml:id="p1z17"/>nuntium.</s>
					<s n="6" xml:lang="la">Quod si ita est, satius fuisset non <lb xml:id="p1z18"/>committere signa quam cum periculo turpiter deserere.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z19"/>Nostri Lutherani nihil in ore habent quam <lb xml:id="p1z20"/>schwermeros; iam enim ex professo quidam <lb xml:id="p1z21"/><persName>Petrus</persName> rem sacramentariam tractat.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z22"/>D. <persName ref="p1283">Gesneri</persName> librum quotidie expecto, ut <lb xml:id="p1z23"/>eo habito privilegium impetrem.</s>
					<s n="9" xml:lang="la">Hunc c<lb xml:id="p1z24"/>um aliis vestrę ecclesię et scholę columnis <lb xml:id="p1z25"/>ex animo cupio esse incolumes.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><persName>Maximilianum</persName> <lb xml:id="p1z26"/>iterum recepi, quamvis habueram hominem probum <lb xml:id="p1z27"/>et doctum, quem <placeName ref="l491">Argentoratenses</placeName> miserunt; huic <lb xml:id="p1z28"/>alia conditione curabo consultum.</s>
					<s n="11" xml:lang="la"><persName>Maximilianus</persName> [in] <lb xml:id="p1z29"/>biennium addixit suam operam; difficile enim esset <lb xml:id="p1z30"/>omni anno tantas et tam sumptuosas facere <lb xml:id="p1z31"/>mutationes.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale, mi <persName ref="p495">Bullingere</persName>, et <persName ref="p2856">Gereonem</persName> tibi <lb xml:id="p1z32"/>per omnia devotum ama.</s>
					<s n="13" xml:lang="la">Si quid apud vos lectu dignum pro<lb xml:id="p1z33"/>diit, rogo, ut meo aere ad me veniat.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z34"/><placeName ref="l18">Augustae</placeName> ocyssime <lb xml:id="p1z35"/>8. augusti anno etc. 54.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z36"/><persName ref="p2856">Geryon</persName> tuus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo atque doctissimo viro <lb xml:id="p2z2"/>d. <persName ref="p495">Henricho Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesię episcopo dignissimo, <lb xml:id="p2z4"/>domino et amico observandissimo.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
