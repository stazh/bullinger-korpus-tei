	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Nulla mihi commodior facultas adest, qua possim litteras <lb xml:id="p1z3"/>ad reverendum d. <persName ref="p3375">Vergerium</persName> mittere, quam per te.</s>
					<s n="2" xml:lang="la">Tu igitur, quae <lb xml:id="p1z4"/>tua benignitas est, utrique nostrum id officii praestabis, ut <lb xml:id="p1z5"/>fasciculum hunc per aliquem fidum nuntium cures ad illum <lb xml:id="p1z6"/>deferri, quod nihilominus tuo commodo fiat.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Hoc [c]erte <lb xml:id="p1z7"/>et illi et mihi gratissimum erit.</s>
					<s n="4" xml:lang="la" ana="salute">Bene vale, mi d. <persName ref="p495">Bul<lb xml:id="p1z8"/>lingere</persName>, ac reverendos istic patres fratresque in domino ex me salvere iube.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/><placeName ref="l93">Clavennae</placeName>, 12. novembris 1553.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Tuus ex animo <persName ref="p8022">Franciscus Niger</persName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z2"/>suo plurimum observa<lb xml:id="p2z3"/>ndo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
