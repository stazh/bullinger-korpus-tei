	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, humanissime <persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Librum tuum contra <persName ref="p458">Brentium</persName> recepi 16 <lb xml:id="p1z2"/>maii: quem nondum legi; dedi enim bibliopolae compingendum.</s>
					<s n="3" xml:lang="la">Sed legam <lb xml:id="p1z3"/>intra pauculos hosce dies, quamprimum remiserit bibliopola <placeName ref="l352">Nordovicensis</placeName>.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Pro eo ago gratia ingentes.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Obsecro, ut ad me semper mittas doctissimas <lb xml:id="p1z5"/>tuas lucubrationes: nihil mihi gratius facere poteris.</s>
					<s n="6" xml:lang="la"><persName>Storaeus</persName>, <lb xml:id="p1z6"/>homo leguleius et papista impudentissimus, in partibus <placeName ref="l830">Angliae</placeName> <lb xml:id="p1z7"/>occidentalibus, more aulico vestitus, est captus, ut audio: nihil <lb xml:id="p1z8"/>enim praeter auditum habeo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><persName ref="p8009">Fabricius</persName> 15 maii ad me venit, <lb xml:id="p1z9"/>quem ut <placeName ref="l587">Tigurinum</placeName> et ut meipsum tracto.</s>
					<s n="8" xml:lang="la">Doleo illum diutius <lb xml:id="p1z10"/>mecum non mansurum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Malim eum aliquot menses, imo aliquot <lb xml:id="p1z11"/>annos mecum detinere, quam aliquot dies.</s>
					<s n="10" xml:lang="la">Loquor cum eo Latine, <lb xml:id="p1z12"/>Anglice et (quod tu mireris) Germanice: miratur et ille, me tam <lb xml:id="p1z13"/>bene posse germanizare.</s>
					<s n="11" xml:lang="la">Vertigo capitis adhuc me non reliquit, <lb xml:id="p1z14"/>sed mitius aliquantulo sese habet.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Caetera ex <persName ref="p8011">Gvalthero</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z15"/>Scripsi circa finem aprilis literas ad te, ad d. <persName ref="p8111">Martyrem</persName>, d. <persName ref="p1283">Gesner<lb xml:id="p1z16"/>um</persName>, <persName ref="p1884">Lavaterum</persName>, <persName ref="p8442">Simlerum</persName>, <persName>Iulium</persName> et <persName ref="p1227">Forschoverum</persName>, <lb xml:id="p1z17"/>quas spero vos accepisse.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">D. <persName ref="p8011">Gvaltherus</persName> <persName ref="p1422">Haddonus</persName> ante <lb xml:id="p1z18"/>triduum mecum pransus est, homo doctus et pius.</s>
					<s n="15" xml:lang="la" ana="salute">Salutem <lb xml:id="p1z19"/>tibi iussit adscribi, et d. <persName ref="p8111">Martyri</persName> et aliis.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute">Saluta meo <lb xml:id="p1z20"/>nomine tuos omnes.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Omnia prospera opto <placeName ref="l587">Tigurinis</placeName> omnibus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="farewell">Vale, <lb xml:id="p1z21"/>charissime <persName ref="p495">Bullingere</persName>, et me, quod facis, ama, <lb xml:id="p1z22"/>et deum pro me ora.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Raptim.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l299">Ludhamiae</placeName>, <lb xml:id="p1z23"/>25 maii, 1562.</s>
					<s n="21" xml:lang="la">Mea vo<lb xml:id="p1z24"/>s omnes.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Obsignavi has literas <lb xml:id="p1z25"/>ultimo(a?) maii, 1562.</s>
					<s n="23" xml:lang="la"><lb xml:id="p1z26"/>Tuus, <persName ref="p2473">Ioannes Parkhurstus</persName>, <lb xml:id="p1z27"/><placeName ref="l352">Nordovicensis</placeName><lb xml:id="p1z29"/>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>