	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi heri cum <persName ref="p458">Brentii</persName> libello literas <persName ref="p1568">Hoseri</persName> nostri <placeName ref="l18">Augustani</placeName> per <persName>Leonardum Schnider</persName>, <lb xml:id="p1z2"/>nunc iam <placeName ref="l18">Augustanum</placeName>, qui, ni fallor, <placeName ref="l587">Tigurum</placeName> quoque profectus est.</s>
					<s n="3" xml:lang="la">Ego vero cum post <lb xml:id="p1z3"/>ipsius digressum fasciculum explicarem, epistolam hanc tibi inscriptam repperi, iratus mihi, <lb xml:id="p1z4"/>quod non ante tabellarii discessum omnia resignassem.</s>
					<s n="4" xml:lang="la">Verum, quod factum est, infectum esse nequit,<note xml:id="fn1" type="footnote" n="1"><bibl source="b56">Adagia</bibl>, 2, 3, 72 (<bibl>ASD</bibl> II-3 290-292, Nr. 1272).</note> <lb xml:id="p1z5"/>quamquam bene est, quod <placeName ref="l587">Tigurinos</placeName> adhuc, qui nuptias hic nudius tertius sua praesentia ornave<lb xml:id="p1z6"/>runt, abiturientes nunc invenio, per quos literas istas reddi tibi curavi.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Misissem una <lb xml:id="p1z7"/><persName ref="p458">Brentii</persName> libellum, ni scriberet <persName ref="p1568">Hoserus</persName> a d. <persName ref="p8486">Engelberto</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p8486">Eppelmann/Milander</persName>.</note> missum ad te exemplum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z8"/>Bene vale, mi colendissime et optime in domino frater.</s>
					<s n="7" xml:lang="la">Commenda nos domino diligenter.</s>
					<s n="8" xml:lang="la">12. martii.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z9"/>T[uus] <persName ref="p8055">Ambr[osius] Bl[aurerus]</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, colendo suo <lb xml:id="p2z3"/>longeque charissimo fratri.</s>
					<s n="11" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
