	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literas tuas, amantissime vir, una cum obsignato fasciculo accepi et ingentes ago <lb xml:id="p1z2"/>gratias tuae Humanitati ob illam tuam eximiam benevolentiam, qua me prosequeris.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Literas legi confestim et gaudeo, illo tandem rem omnem inclinare, ut inlaesa <lb xml:id="p1z4"/>pietate redire in gratiam mutuam Pagi possunt; postulat hoc et illachrymans etiam <lb xml:id="p1z5"/>petit et orat avita illa nostra et multo sanguine parta LIBERTAS, praeterea <lb xml:id="p1z6"/>et coniugum et liberorum pudicitia.</s>
					<s n="4" xml:lang="la">Dominus aperiat Immontanorum oculos, ut <lb xml:id="p1z7"/>nosse tandem et recte expendere maiorum suorum studia possint!</s>
					<s n="5" xml:lang="la">Acta ipsa, quam<lb xml:id="p1z8"/>primum potero, summa fide remittam, legam autem diligenter, ut inde et sena<lb xml:id="p1z9"/>tui nostro ore nec citato authore generatim omnia queam recensere.</s>
					<s n="6" xml:lang="la">Id ve<lb xml:id="p1z10"/>ro non fiet sine interventu iuramenti; solent enim consules nostri, quoties res silent<lb xml:id="p1z11"/>ii <lb xml:id="p1z13"/>fide dignae in senatu referuntur, de praestitio iuramento admonere omnes et <lb xml:id="p1z15"/>serio interdicere, ne quid quis eius rei, quae summa fide undecunque concreditur, <lb xml:id="p1z16"/>extra curiam ullo verbo meminerit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Interim <persName ref="p1278">Gastii</persName> literas his inclusas remitto.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Quid multa?</s>
					<s n="9" xml:lang="la">Ambiunt <placeName ref="l875">Hispani</placeName> non monarchiam modo orbis christiani, sed etiam <lb xml:id="p1z18"/>totius <placeName ref="l822">Germanię</placeName>, hoc est <placeName ref="l822">Germanorum</placeName> omnium, miseram servitutem.</s>
					<s n="10" xml:lang="la">Tribuni <lb xml:id="p1z19"/><placeName ref="l257">Const<lb xml:id="p1z21"/>antienses</placeName> iam nunc experiuntur, quantum prosit bonis vel tantilla spe rerum <lb xml:id="p1z22"/>me<lb xml:id="p1z25"/>liorum in Caesaris sinum profugere.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l473">Sangalli</placeName> obiter, ut lic<lb xml:id="p1z26"/>ebat per negocia, IIII. die Februarii anno MDXLVIII.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z27"/><persName ref="p8049">Ioachimus Vadianus</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z28"/>Commendabis me amplissimis viris dominis consulibus et salutabis meo nomine collegas.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z29"/>Mirum, quo <persName ref="p8417">Musculi</persName> nostri reciderint res; adeo plane de illo in tuis <lb xml:id="p1z30"/>mutus es.</s>
					<s n="16" xml:lang="la">Piaculares estis, si vestra opera vir tam humanus, doctus et pius <lb xml:id="p1z31"/>non habet longe optime; sed ipso tuo silentio persuadeor, ut non ambigam bene il<lb xml:id="p1z32"/>lum habere.</s>
					<s n="17" xml:lang="la" ana="farewell"><lb xml:id="p1z33"/>Vale iterum.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z34"/>Literas ad <persName ref="p8354">Laetum</persName> diligenter curabo.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo et integerrimo <lb xml:id="p2z2"/>viro D. <persName ref="p495">Henrycho <lb xml:id="p2z3"/>Bullingero</persName>, amplissimae urbis <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> episcopo, domino <lb xml:id="p2z5"/>meo semper colendo.</s>
				</p>
			</div>
