	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et vitae innocentiam a Domino.</s>
					<s n="2" xml:lang="la">Literas ad te dederam his diebus, <lb xml:id="p1z2"/>amantissime <persName ref="p495">Bullingere</persName>, per <persName ref="p6425">Rudolphum Schintium</persName>; an redditae sint, <lb xml:id="p1z3"/>non constat.</s>
					<s n="3" xml:lang="la">Illud vero potissimum est, quod continent, ut <persName ref="p495">Bullingeri</persName> <lb xml:id="p1z4"/>commentarios in omnes divi Patli epistolas ceterasque cononicas in <lb xml:id="p1z5"/>forma maiori, codice eleganter illigato apud te invenirem.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Coronatum et batzium mitto; si quid defuerit, sine dilatione quoque <lb xml:id="p1z7"/>mittam.</s>
					<s n="5" xml:lang="la">Praesentium latori tuto committere poteris librum, - <lb xml:id="p1z8"/>probe enim curabit, ut integre ad me veniat -, et si usu venerit, <lb xml:id="p1z9"/>ut tibi servire vel in aliqua re prodesse potuero, iubeto.</s>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z10"/>Vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ex <placeName ref="l648">Rhetiae</placeName> <placeName ref="l98">Curia</placeName>, 6. Martii 42.</s>
					<s n="8" xml:lang="la" ana="salute">Salvos optamus <lb xml:id="p1z11"/>omnes fratres.</s>
					<s n="9" xml:lang="la">Pro nobis orate; nam in periculo sumus haud <lb xml:id="p1z12"/>exiguo vel negligendo.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z13"/>Tuus <persName ref="p654">Ioannes Comander</persName><pb/><lb xml:id="p2z1"/>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z3"/>Pietate et doctrina <lb xml:id="p2z4"/>spectabili viro magi<lb xml:id="p2z5"/>stro <persName ref="p495">Heinricho <lb xml:id="p2z6"/>Ballingero</persName>, domino ac f<lb xml:id="p2z7"/>ratri suo observando.</s>
				</p>
				<p>
					<s n="12" xml:lang="de">Meister <persName ref="p495">He<lb xml:id="p2z8"/>inrichen Bullinger</persName>.</s>
				</p>
			</div>
		</body>
