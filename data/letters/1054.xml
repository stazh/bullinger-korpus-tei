	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Mitto charitati tuę, mi frater, hoc <persName ref="p20727">Vespasiani</persName> numisma vetustissimum in agro <placeName ref="l285">Lentzburgensi</placeName> nuper repertum, <lb xml:id="p1z2"/>quod a quodam rustico viro parvo emi pretio, ob vetustatem vero gratissimum michi.</s>
					<s n="2" xml:lang="la">Vetus numisma <lb xml:id="p1z3"/>veteris amicitię argumentum gratanter suscipe, obsecro; nunc hoc tantum, quantus tibi esse possum, mitto.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Quodsi <lb xml:id="p1z4"/>tale numisma marsupium tuum desiderarit, nichil eque desidero, quam ut hoc uno vetustissimo nummo decoretur; <lb xml:id="p1z5"/>sin minus, remittere potes.</s>
					<s n="4" xml:lang="la" ana="farewell">Vale, męcenas optime.</s>
					<s n="5" xml:lang="de" ana="salute">Gruͤß mir das müterlin etc.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z6"/>Datum <placeName ref="l285">Lentzburgi</placeName> 19. octobris ann<lb xml:id="p1z7"/>o 1550.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z8"/>Cum uxore mea ad me reditura iam uno saltem verbo responde.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z9"/>Tuus <persName ref="p8440">Gervasius</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><lb xml:id="p1z10"/>Liebe muͦß zancket han.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Bullingero</persName> meo <lb xml:id="p2z2"/>charissimo in <lb xml:id="p2z3"/>domino.</s>
				</p>
			</div>
		</body>
	</text>
