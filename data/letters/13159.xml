	<text xml:lang="la">
		<body>
			<div>
				<p>
					<note type="regest">Empfiehlt einen vornehmen <placeName ref="l830">Engländer</placeName>, der nach <placeName ref="l834">Italien</placeName> reist und <persName ref="p495">Bullinger</persName> besuchen möchte.</note>
				</p>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus in domino nostro Iesu Christo.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Fateor ego, vir ornatissime <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z3"/>meam in scribendo tarditatem, sed quae <lb xml:id="p1z4"/>de meo erga te amore et fide nihil im<lb xml:id="p1z5"/>minuat.</s>
					<s n="3" xml:lang="la">In praesentia autem cur has ad te <lb xml:id="p1z6"/>literas scribo, in caussa est <placeName ref="l830">Anglus</placeName> is, vir <lb xml:id="p1z7"/>pietate, doctrina, generis nobilitate eximius, <lb xml:id="p1z8"/>qui in <placeName ref="l834">Italiam</placeName> profecturus relicta patria, <lb xml:id="p1z9"/>uxore, liberis quoniam pro more magn<lb xml:id="p1z10"/>orum virorum istac transeuntium te invisere <lb xml:id="p1z11"/>statuit, nolui committere, ut sine his <lb xml:id="p1z12"/>ad te meis veniret, ex quibus intelligeres, <lb xml:id="p1z13"/>quo animo et erga te et praestantes viros <persName ref="p8298">Borrh<lb xml:id="p1z14"/>aus</persName> esset, non vero impellerere[?], ut in hunc virum <lb xml:id="p1z15"/>tua humanitatis plena officia et studia <lb xml:id="p1z16"/>declarares, quod nihil aliud esset quam <lb xml:id="p1z17"/>currentem ad cursum incitare.</s>
					<s n="4" xml:lang="la" ana="farewell">Tu vale, <lb xml:id="p1z18"/>vir clarissime, et <persName ref="p8298">Borrhaum</persName> in tuis a<lb xml:id="p1z19"/>mici<lb xml:id="p1z20"/>s numera.</s>
					<s n="5" xml:lang="la" ana="salute">Salvere meo nomine omnes <lb xml:id="p1z21"/>bonos apud te viros volo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><placeName ref="l28">Basileae</placeName>.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z22"/><persName ref="p8298">Martinus Borrhaus</persName> <lb xml:id="p1z23"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>suo in domino <lb xml:id="p2z4"/>amico et fratri <lb xml:id="p2z5"/>observando.</s>
				</p>
			</div>
		</body>
	</text>
