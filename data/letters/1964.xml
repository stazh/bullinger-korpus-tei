	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p714">C[aelius] S<lb xml:id="p1z2"/>[ecundus] C[urio]</persName> per Christum Iesum S. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Putabam me intra biduum rediturum esse; secus <lb xml:id="p1z4"/>domino visum est.</s>
					<s n="3" xml:lang="la">Meam filiam adhuc recipere non potui; <lb xml:id="p1z5"/>sed statutum est non discedere, donec eam recepero, et <lb xml:id="p1z6"/>spero dominum meo huic pio voto felicem tandem exitum <lb xml:id="p1z7"/>daturum, id quod maxime vestris ad deum patrem <lb xml:id="p1z8"/>precibus fieri posse non dubito.</s>
					<s n="4" xml:lang="la">Quod reliquum est, <lb xml:id="p1z9"/>frater optime, nolo te latere huius ecclesiae <placeName ref="l834">Italicae</placeName> <lb xml:id="p1z10"/>perturbationem aut tentationem potius, quae eo gravior <lb xml:id="p1z11"/>et periculosior accidit, quo ab eo excitata est, <lb xml:id="p1z12"/>a quo minime sperabatur.</s>
					<s n="5" xml:lang="la" ana="salute">Quod quidem non sine magn<lb xml:id="p1z13"/>o dolore scribo; sed tamen, ut aliquid a te, qui potes, <lb xml:id="p1z14"/>consilium accipiamus, quem salutem nostrarum ecclesiarum <lb xml:id="p1z15"/>non minus procurare scimus, quoad eius fieri potest, <lb xml:id="p1z16"/>quam suarum, tibi aperire non dubito.</s>
					<s n="6" xml:lang="la">Rediit <persName ref="p3375">Vergerius</persName> <lb xml:id="p1z17"/>a <persName ref="p458">Brentio</persName> (intelligis, quid velim) confessionem principis <lb xml:id="p1z18"/>nomine editam a se conversam et approbato eucharistiae <lb xml:id="p1z19"/>dogmate attulit, parvulum <persName ref="p458">Brentii</persName> catechismum <lb xml:id="p1z20"/>edidit etiam a se conversum, in quo sunt haec verba: <lb xml:id="p1z21"/>Corpus Christi in ipso pane et sanguinem in vino <lb xml:id="p1z22"/>exhiberi.</s>
					<s n="7" xml:lang="la">Catechismo titulum fecit Fundamentum <lb xml:id="p1z23"/>christianae doctrinae pro <placeName ref="l520">Valetellina</placeName>.</s>
					<s n="8" xml:lang="la">Puto v<lb xml:id="p1z24"/>os <lb xml:id="p1z25"/>aliquid subolfecisse aut etiam, qua confidentia est, <lb xml:id="p1z26"/>exemplaria aliquot ad vos misisse.</s>
					<s n="9" xml:lang="la">Haec ecclesia <lb xml:id="p1z27"/>nihil unquam vidit indignius.</s>
					<s n="10" xml:lang="la">Voluit eos libros <lb xml:id="p1z28"/>per hasce ecclesias spargere; prohibitus est.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z29"/>In <placeName ref="l834">Italiam</placeName> multa transmisit exemplaria invitis <lb xml:id="p1z30"/>nobis omnibus; audet etiam palam dicere <lb xml:id="p1z31"/>vobis haec non displicere te quoque, mi frater, no<lb xml:id="p1z32"/>minato.</s>
					<s n="12" xml:lang="la">Haec pauca nunc, plura coram deo volente <lb xml:id="p1z33"/>agemus; nam nuntius fere discedebat, dum scriberem.</s>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z34"/>Expecto ab hoc eodem tuas, quae nos ac pręsertim <lb xml:id="p1z35"/><persName ref="p2019">Augustinum</persName>, bonum senem, consolentur, qui te et ecclesiam <lb xml:id="p1z36"/>istam vestram plurimum salutat seque et ecclesiam <lb xml:id="p1z37"/>suam vestris precibus commendat.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Librum, quem apud t<lb xml:id="p1z38"/>e reliqui, si legisti, huic nuntio dare poteris.</s>
					<s n="15" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z39"/>in domino frater.</s>
					<s n="16" xml:lang="la"><placeName ref="l93">Clavenae</placeName> 22. augusti 1553.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z40"/>Salutat te <persName>Paulus</persName> noster.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
