	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Dominum <persName ref="p8009">Fabricium</persName> dimittere nolui sine meis ad te literis, ut certior <lb xml:id="p1z2"/>esses me accepisse literas, quas illi dederas, et priores alteras <lb xml:id="p1z3"/>habeasque persuasum ea, que scripsisti, mihi magne sollicitudini fore <lb xml:id="p1z4"/>nec quicquam in iis me praetermissurum.</s>
					<s n="3" xml:lang="la">Dominus solet compescere <lb xml:id="p1z5"/>insolentiam et superbiam hominum impiorum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">De aliis rebus et iis, que <lb xml:id="p1z6"/><placeName ref="l28">Basileę</placeName> sparguntur, intelliges a domino <persName ref="p8009">Fabricio</persName>, cui libenter in <lb xml:id="p1z7"/>re aliqua essem gratificatus.</s>
					<s n="5" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><placeName ref="l760">Soluturi</placeName> ultima novembris<lb xml:id="p1z8"/>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z9"/>Tuus ex animo <persName ref="p629">Laberius</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z10"/>D. d. <persName ref="p8011">Galterum</persName> et <persName ref="p8111">Martirem</persName> <lb xml:id="p1z11"/>saluto et illis filium commendo.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z2"/>eclesie <placeName ref="l587">Tigurine</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
