	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Dominus benedicat tibi et faxit, ut hic annus <lb xml:id="p1z2"/>tibi sit faustus et felicissimus, tibi inquam et domui <lb xml:id="p1z3"/>tuae.</s>
					<s n="2" xml:lang="la">Quia hodie nullas a te accepi <lb xml:id="p1z4"/>literas, solicitus sum, quod ultimis tuis literis <lb xml:id="p1z5"/>significabas te ęgrotare.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Dominus te tuae <lb xml:id="p1z6"/>ecclesiae et nobis restituere dignetur!</s>
					<s n="4" xml:lang="la">Valemus <lb xml:id="p1z7"/>hic utcunque per dei gratiam; dominus pergat nobis bene<lb xml:id="p1z8"/>d<lb xml:id="p1z9"/>icere!</s>
					<s n="5" xml:lang="la">Legatus regis Orbais <placeName ref="l760">Saloduro</placeName> 26. decembris <lb xml:id="p1z10"/>ad nos scribit: "rex meus indixit comitia <lb xml:id="p1z11"/>magna, ad quae coibunt <placeName>Blesas</placeName> omnes principes <lb xml:id="p1z12"/>cum universa nobilitate.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quid futurum sit, nescio; <lb xml:id="p1z13"/>ego certe eo quoque sum vocatus, cras ingrediar <lb xml:id="p1z14"/>iter et festinabo.</s>
					<s n="7" xml:lang="la">Bellum in <placeName ref="l830">Anglia</placeName> et <lb xml:id="p1z15"/><placeName ref="l2524">Scotia</placeName> excitatum interventu regis mei bene <lb xml:id="p1z16"/>est sopitum.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l2524">Scotia</placeName> retinet evangelium.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Pro <lb xml:id="p1z17"/>certo affirmatur pontifex Romanus mortuus."</s>
					<s n="10" xml:lang="la">Haec ille.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p1010">Matthias Erbius</persName> 23. decembris <placeName ref="l968">Raperschwyla</placeName> <lb xml:id="p1z19"/>ad me scribit decem urbes, inter quas primatum <lb xml:id="p1z20"/>tenet <placeName ref="l1300">Hagnoa</placeName>, consultare de reformatione etc. et <lb xml:id="p1z21"/><placeName ref="l1300">Hagnoam</placeName> quidem iam eiectis sacrificibus <lb xml:id="p1z22"/>substituisse concionatores.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l1300">Hagnoam</placeName> sequtos <lb xml:id="p1z23"/>esse cives <placeName>Obernehenses</placeName>; idem brevi expectari <lb xml:id="p1z24"/>a <persName>Selestadio</persName> et <placeName ref="l101">Colmaria</placeName>.</s>
					<s n="13" xml:lang="la">Insanire interim ubiq<lb xml:id="p1z25"/>u[it]arios <placeName ref="l411">Rychenvillae</placeName>; <persName>Farzbachium</persName> (ut vocant) <lb xml:id="p1z26"/>clamare fortiter <placeName ref="l491">Argentorati</placeName>, sed fortiter quoque a <lb xml:id="p1z27"/>cordatis civibus contemni.</s>
					<s n="14" xml:lang="la">Magistratum solicitum <lb xml:id="p1z28"/>esse et caute agere, ne oboriatur turba.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName>Palatinum</placeName> <lb xml:id="p1z29"/>constantissime progredi.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Expectari com<lb xml:id="p1z30"/>itia imperialia ad 15. ianuarii <placeName ref="l18">Augustae</placeName> etc.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z31"/>Haec ille.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Haec ego tecum communicare pro nostro <lb xml:id="p1z32"/>more volui et tibi omnia felicia imprecari.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="farewell"><lb xml:id="p1z33"/>Aeternum vale cum omnibus amicis nostris.</s>
					<s n="20" xml:lang="de"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z34"/>28. decembris 1566.<note type="margin">a.R.: Es ist daran korrigiert, doch fraglich ob 1565 gelesen werden soll oder in 1566 geändert ist.</note></s>
					<s n="21" xml:lang="la"><lb xml:id="p1z35"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p8009">Ioanni Fabritio</persName>, <lb xml:id="p2z3"/><placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z4"/>fideli ministro, domino <lb xml:id="p2z5"/>meo colendo et fratri <lb xml:id="p2z6"/>dilecto.</s>
					<s n="23" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
