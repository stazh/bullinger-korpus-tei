	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Diu nunc tuas expectavi literas Erbiu
					<lb xml:id="p1z2"/>optime, sed frustra. Promiseras te scriptum
					<lb xml:id="p1z3"/>nuptiarum ordinem et historiam. Nihil
					<lb xml:id="p1z4"/>vidi. Tribuo id tuis negotiis. Spero
					<lb xml:id="p1z5"/>valere in domino. Valemus nos per dei gratiam
					<lb xml:id="p1z6"/>licet ego propemodum valetudinarius subinde
					<lb xml:id="p1z7"/>aegrotem. Tribui id curis et maximis laboribus
					<lb xml:id="p1z8"/>quibus enecor. Quae laboraverim hac hye
					<lb xml:id="p1z9"/>me vides hic. Ad preces enim multorum
					<lb xml:id="p1z10"/>constantes et nolestas tandem summant
					<lb xml:id="p1z11"/>hans vulgavi. Misissem et illustrissimo principus
					<lb xml:id="p1z12"/>picipi exemplum; sed cum is frequentes
					<lb xml:id="p1z13"/>dederit, intra biennium nullas literas, qui
					<lb xml:id="p1z14"/>misermm quaedam ad illum munera
					<lb xml:id="p1z15"/>amptialia, nec satis sciam, quo exceperit
					<lb xml:id="p1z16"/>metune illi suum molestus meaque ipsi
					<lb xml:id="p1z17"/>parum sint grata amplius. Nihilominus illum
					<lb xml:id="p1z18"/>amo et veneror. Dominus illum servet. Scrib
					<lb xml:id="p1z19"/>nunc Apologiam ad 5 libros Saxonum
					<lb xml:id="p1z20"/>in causa eccharistiae contra nos editos. Mittam
					<lb xml:id="p1z21"/>deo volente exemplu responsionis impressum
					<lb xml:id="p1z22"/>Iam enim sub solo est. Nova a tea
					<lb xml:id="p1z23"/>ire percupio. In fluctibus negotiorum scribe
					<lb xml:id="p1z24"/>haec; boni ergo consule brevitatem. Commend
					<lb xml:id="p1z25"/>tuis et fratrum precibus. Saluta omnes pi
					<lb xml:id="p1z26"/>his L. Hospinian et Rhegium etc. Salv
					<lb xml:id="p1z27"/>nte nostri omnes. Vale. Tiguri ultimae
					<lb xml:id="p1z28"/>1556.
					<lb xml:id="p1z29"/>bruarii.
					<lb xml:id="p1z30"/>Bullingerus tuus.
					<pb/>
					<lb xml:id="p2z1"/>Ornatissimo viro d. Hatr
					<lb xml:id="p2z2"/>aErbio Ryche
					<lb xml:id="p2z3"/>villano domino colendio.
					<lb xml:id="p2z4"/>et fratri suo
					<lb xml:id="p2z5"/>rissimo.
					<lb xml:id="p2z6"/>Rychanwyler
					<lb xml:id="p2z7"/>Elsas.
				</p>
