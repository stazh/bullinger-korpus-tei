			<zone xml:id="p2z23-0" points="803,2762 970,2720 1042,2782 1371,2749 1505,2772 1587,2713 1714,2720 1714,2668 1672,2654 1404,2681 1166,2645 1097,2671 953,2625 803,2638">821,2697 865,2700 910,2703 955,2706 1000,2709 1045,2712 1090,2715 1134,2712 1179,2709 1224,2709 1269,2708 1314,2705 1359,2703 1404,2703 1448,2703 1493,2703 1538,2703 1583,2703 1628,2703 1673,2703 1718,2697</zone>
