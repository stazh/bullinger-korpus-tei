	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Diu nullas a tua humanitate <lb xml:id="p1z2"/>literas accepi, vir clarissime, ideoque eas [<lb xml:id="p1z3"/>mag]no cum desiderio expecto.</s>
					<s n="3" xml:lang="la">Qui hasce tibi <lb xml:id="p1z4"/>literas tradit, <persName ref="p6704">Maternus</persName> etc., vir est doctus <lb xml:id="p1z5"/>et pius; aliquandiu <placeName ref="l558">Witenbergae</placeName> egit, deinde <lb xml:id="p1z6"/><placeName ref="l167">Genevam</placeName> abiit, inde rediit ad nos ac convictor <lb xml:id="p1z7"/>aliquandiu fuit d. <persName ref="p8111">Petri Martyris</persName>; nunc i<lb xml:id="p1z8"/>ngreditur <placeName ref="l834">Italiam</placeName>, ut ipsam quoque videat.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="salute">Postulavit <lb xml:id="p1z9"/>a me commendationes; non potui ei negare, <lb xml:id="p1z10"/>quippe cum dignum putem, quem omnes pii ament <lb xml:id="p1z11"/>et quem omnes boni iuvent.</s>
					<s n="5" xml:lang="la">Iuvare ipsum poteris <lb xml:id="p1z12"/>commendationibus et consilio.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Facies autem hic [<lb xml:id="p1z13"/>ut] scio, plus quam postulem et ut intelligam <lb xml:id="p1z14"/>commendationem nostram aliquid apud te ponderis habuis<lb xml:id="p1z15"/>se.</s>
					<s n="7" xml:lang="la">Scripsi his hybernis mensibus <lb xml:id="p1z16"/>6 libros contra anabaptistas <placeName ref="l822">Germanice</placeName>; continent <lb xml:id="p1z17"/>folia... ergo non potui commode literis coniungere <lb xml:id="p1z18"/>neque in... tis coniicere sinum.</s>
					<s n="8" xml:lang="la">Valemus per dei gratiam <lb xml:id="p1z19"/>si[ngularem] satis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Salutant te omnes nostri,; <lb xml:id="p1z20"/>saluta [<lb xml:id="p1z21"/>patrem <lb xml:id="p1z22"/>cum filii]s nostris.</s>
					<s n="10" xml:lang="la">18. martii <placeName ref="l2451">Abbatiscella</placeName> <lb xml:id="p1z23"/>pen[itus igni] <lb xml:id="p1z24"/>ex domo cuiusdam pastoris exorto <lb xml:id="p1z25"/>conflagravit.</s>
					<s n="11" xml:lang="la">Heri misit illuc amplissimus se<lb xml:id="p1z26"/>natus noster legatum, qui consoletur afflictos et donet <lb xml:id="p1z27"/>munere 200 coronatorum.</s>
					<s n="12" xml:lang="la">Dominus adsit eis et c<lb xml:id="p1z28"/>onfirmet eos in bono.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Per <placeName ref="l822">Germaniam</placeName> audimus ali<lb xml:id="p1z29"/>quanto tempore militem conscriptum esse, quem tamen hodie <lb xml:id="p1z30"/>dimissum audimus et dimittendum.</s>
					<s n="14" xml:lang="la">Plura fessus <lb xml:id="p1z31"/>scribendo iam non possum; totos enim iam dies <lb xml:id="p1z32"/>5 impendi scribendis epistolis, hodie enim <lb xml:id="p1z33"/><placeName ref="l157">Francfordiam</placeName> abivit <persName ref="p1227">Froschouerus</persName>.</s>
					<s n="15" xml:lang="la" ana="farewell">Vive et <lb xml:id="p1z34"/>vale cum tota domo tua, cum <persName ref="p1043">Ioanne</persName> nostro et <lb xml:id="p1z35"/>imprimis patre <persName ref="p6831">Traversio</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><persName ref="p20466">Hector</persName> adversa laborat valetudi<lb xml:id="p1z36"/>ne.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 22. martii 1560.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Clarissimo viro d. <persName ref="p8432">Friderycho a <lb xml:id="p1z37"/>Salice</persName>, commissa<lb xml:id="p1z38"/>rio comitat<pb/><lb xml:id="p2z1"/>us <placeName ref="l93">Clavennensis</placeName> dign<lb xml:id="p2z2"/>issimo, domino suo col<lb xml:id="p2z3"/>endissimo et fratr<lb xml:id="p2z4"/>i charissimo.</s>
					<s n="20" xml:lang="de"><placeName ref="l93">Cläfen</placeName> im <lb xml:id="p2z5"/><placeName ref="l520">Veltlin</placeName>.</s>
				</p>
			</div>
