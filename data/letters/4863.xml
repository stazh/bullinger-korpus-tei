	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nuper ad te scripsi, que te digna iudicaveram.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Oblitus eram scribere <lb xml:id="p1z2"/>ducem <placeName ref="l2478">Sabaudie</placeName> coactum pacisci cum subditis <placeName>Vallis Angronie</placeName>; illis <lb xml:id="p1z3"/>permittitur libere religione uti.</s>
					<s n="4" xml:lang="la"><persName>Principes Gallie</persName> per octo aut decem <lb xml:id="p1z4"/>dies cum iis, qui regi sunt a conciliis fuerunt in parlamento <placeName ref="l378">Parisiensi</placeName>, <lb xml:id="p1z5"/>ut de negocio religionis despicerent, et fuere libere voces.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Nondum scio, quid statutum sit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">In domibus regis <placeName ref="l1209">Navarre</placeName> et principis <lb xml:id="p1z7"/>a Conde <placeName ref="l378">Parisiis</placeName> sunt conciones publice.</s>
					<s n="7" xml:lang="la">Ex consule prudentissimo intelligere potuisti, <lb xml:id="p1z8"/>quam indigne me vexarint, qui usuram petunt.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Petit <placeName ref="l2478">Sabaudus</placeName> dietam <placeName ref="l28">Basileę</placeName> <lb xml:id="p1z9"/>continuari 14. mensis proximi; controversia est maximi momenti.</s>
					<s n="9" xml:lang="la">Mitto <lb xml:id="p1z10"/>ad te epistolam episcopi <persName>Ivonis</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Salutabis amicos omnes.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z11"/><placeName ref="l760">Sol[uturi]</placeName> 8. iulii.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z12"/>Tuus ex animo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Si?</s>
					<s n="15" xml:lang="la">Ne?</s>
					<s n="16" xml:lang="la">[...] grave sit senatui mittere, qui liberalitatem.<lb xml:id="p1z13"/>.. gram <lb xml:id="p1z14"/>pacis nomine petant, curabo ut ad eos perferatur [<lb xml:id="p1z15"/>cu]m libuerit moneta aurea vel argentea.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Id d. consuli <persName>Rhaan</persName> [<lb xml:id="p1z16"/>po]es denuntiare.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henricho Bullingero</persName>, ecclesie <lb xml:id="p2z2"/><placeName ref="l587">Tygurine</placeName> pastori vigilantissimo.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
