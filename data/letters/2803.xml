	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quod animus praesagiebat et multi praedicebant, <lb xml:id="p1z2"/>tandem evenit, ut deligerer ad apostolatum ecclesiarum <lb xml:id="p1z3"/>Sanensium; decretum est hoc 27. decembris.</s>
					<s n="3" xml:lang="la">Hodie hinc <lb xml:id="p1z4"/>discedo; tu pro me orabis dominum, ut incrementum laboribus <lb xml:id="p1z5"/>meis addat amplum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Gravis est mihi haec vocatio; sed <lb xml:id="p1z6"/>domino vocanti reluctari non possum, concepi vero spem <lb xml:id="p1z7"/>bonam fore, ut recte procedant omnia.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><persName ref="p3429">Viretus</persName> alteram novę <lb xml:id="p1z8"/>huius ditionis partem reformabit, quae <placeName ref="l832">Gallica</placeName> utitur lingua; <lb xml:id="p1z9"/>itaque in eodem illic coniuncti erimus ministerio.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Ad tuas autem, quos proxime misisti, nihil habeo, quod respondeam, <lb xml:id="p1z11"/>nisi quod tibi gratias habeo quum pro diligentia, qua nobis <lb xml:id="p1z12"/>amicorum scripta communicas, tum pro Epistolis obscurorum virorum ad <lb xml:id="p1z13"/>nos missis.</s>
					<s n="7" xml:lang="la">Laeti literas tibi remitto.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Quod affinem <lb xml:id="p1z14"/>tuum attinet, commendavi illum amicis, qui in sua <lb xml:id="p1z15"/>eum profectione iuvare et promovere poterunt.</s>
					<s n="9" xml:lang="la">Promisit <lb xml:id="p1z16"/>mihi <persName ref="p8095">Nicolaus zer Kinden</persName> suam operam, quamvis idem metuat <lb xml:id="p1z17"/>quod ego.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Expedire videretur, ut ipsemet huc veniret, <lb xml:id="p1z18"/>quo et illius persona, ingenium et scientia conspici <lb xml:id="p1z19"/>et postea tanto commodius promoveri posset; nam illo non <lb xml:id="p1z20"/>viso difficile est conditionem aliquam ei committere.</s>
					<s n="11" xml:lang="la">Fac e<lb xml:id="p1z21"/>rgo, quod tibi videbitur.</s>
					<s n="12" xml:lang="la">Quamdiu abfuturus sim, ignoro.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Tres parochias habeo reformandas et instituendas; populus <lb xml:id="p1z23"/>est cervicis durae et omnium licentiosissimus; sentina ibi fuit <lb xml:id="p1z24"/>omnium lenonum, scortorum, homicidarum etc., ut in hoc Augię <lb xml:id="p1z25"/>stabulo repurgando plus quam Herculeis mihi opus sit <lb xml:id="p1z26"/>viribus; quas nisi dominus suppeditet, nihil efficiam.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z27"/>Te vero rogo, ut nihilominus ad me scribas; pote[runt] <lb xml:id="p1z28"/>enim singulis fere diebus literae ad me transmit[ti; ego] <lb xml:id="p1z29"/>quoque vicissim scribam, quid apud nos fiat.</s>
					<s n="15" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z30"/>vale et boni consule haec mea, quae iamiam <lb xml:id="p1z31"/>abiturus scribo.</s>
					<s n="16" xml:lang="la" ana="salute"><persName ref="p8416">Musculum</persName> mihi affinitate <lb xml:id="p1z32"/>iunxi;<note xml:id="fna" type="footnote" n="a">Durch die geplanten Hochzeit von <persName ref="p8416">Abraham Musculus</persName> (Sohn von <persName ref="p8417">Wolfgang</persName>) mit <persName ref="p20607">Cleopha (Kleopha) Haller</persName> am 11. Februar 1556. Wie diese allerdings mit <persName ref="p8018">Johannes Haller</persName> verwandt ist, bleibt noch ungeklärt.</note> is te salutat.</s>
					<s n="17" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l41">Bernae</placeName> 2. ianuarii.</s>
					<s n="19" xml:lang="de"><lb xml:id="p1z33"/>Min volk und ich wünschend üch und den üweren <lb xml:id="p1z34"/>allen ein guͦt, glückhafft jar.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><persName ref="p8018">Io[h<lb xml:id="p1z35"/>annes] Hall[erus</persName>] tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesię <lb xml:id="p2z3"/>pastori fidelissimo, domino et comp<lb xml:id="p2z4"/>atri suo colendissimo et <lb xml:id="p2z5"/>charissimo.</s>
					<s n="22" xml:lang="de"><lb xml:id="p2z6"/>M. <persName ref="p495">Heinrych <lb xml:id="p2z7"/>Bullingern</persName> zuͦ <lb xml:id="p2z8"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
