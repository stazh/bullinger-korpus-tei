	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Exhibui literas tuas 24. iunii ad me scriptas <lb xml:id="p1z2"/>baleo nostro.</s>
					<s n="3" xml:lang="la">Dici non potest, quanto gaudio <lb xml:id="p1z3"/>optimus senex eas legerit; te enim ob eruditionem <lb xml:id="p1z4"/>ac pietatem singularem iampridem et amabat ex <lb xml:id="p1z5"/>animo et venerabatur.</s>
					<s n="4" xml:lang="la">iam totus est in suis <lb xml:id="p1z6"/>scriptoribus <placeName ref="l830">Britannicis</placeName> scriptoribus, quod cum 12 centurias <lb xml:id="p1z7"/>descripserit, in tertia adhuc typis nostris exprim<lb xml:id="p1z8"/>enda hęremus.</s>
					<s n="5" xml:lang="la">Alioqui ipsemet ad te scripsisset.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Oravit tamen, ut ego ipsum apud te excusarem <lb xml:id="p1z10"/>et de meliore, quod aiunt, nota officiose commendare<lb xml:id="p1z11"/>m.</s>
					<s n="7" xml:lang="la">Orat etiam rursum, ut, si <persName>Theoderychi</persName> a <lb xml:id="p1z12"/><placeName ref="l1221">Niceno</placeName> scripto de <persName>pontificibus Romanis</persName> aut schismate ecclesię <lb xml:id="p1z13"/>carere potes, ad paucos dies ipsi des mutuo; <lb xml:id="p1z14"/>brevi enim remittetur.</s>
					<s n="8" xml:lang="la">Scripsi heri idem ad te in <lb xml:id="p1z15"/>aliis literis per <persName ref="p6055">Petrum Pernam</persName>, a quo forte etiam has <lb xml:id="p1z16"/>accipies simulque terniones aliquot ab o usque ad <lb xml:id="p1z17"/>s inclusive ad te misi Apocalypsis tuae.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z18"/>vale et strenue in vienea domini colenda elabora.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/><placeName ref="l28">Basileae</placeName> 26. iunii 1557.</s>
				</p>
