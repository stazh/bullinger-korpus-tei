	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Maxime volui, sed non potui verbosissimas <lb xml:id="p1z2"/>ad te scribere literas, ornatissime <persName ref="p495">Bullingere</persName>.</s>
					<s n="3" xml:lang="la">Iesuitę <lb xml:id="p1z3"/>iam concedunt <placeName>Monachium</placeName>, occupant alioqui splendidum <lb xml:id="p1z4"/>nidum <placeName ref="l231">Ingolstadii</placeName>; eorum munus est administrare <lb xml:id="p1z5"/>ludum literarium non tantum Monachii, verum <lb xml:id="p1z6"/>etiam per totam <placeName ref="l619">Bavariam</placeName> presidente <persName>Staphylo</persName>.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Video, nisi potenti manu adsit dominus, <lb xml:id="p1z8"/>errores papisticos incrudescere et indies magis <lb xml:id="p1z9"/>ingravescere.</s>
					<s n="5" xml:lang="la">Magna culpę pars in mutos, <lb xml:id="p1z10"/>elingues et ociosos canes, qui propter ingluviem <lb xml:id="p1z11"/>in rebus publicis maximis consulunt ventri.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/><persName>Canisius</persName> hic in cathedrali ecclesia concionatur; <lb xml:id="p1z13"/>procul dubio aliquid parturit.</s>
					<s n="7" xml:lang="la">Ago gracias <lb xml:id="p1z14"/>immortales pro <persName>Hieremia</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Scripsit ad me <lb xml:id="p1z15"/>quidam, ut hac monstrat tabula; si poteris <lb xml:id="p1z16"/>iuvare, rogo, facis.</s>
					<s n="9" xml:lang="la"><placeName>Neogeorgus</placeName> dicitur <lb xml:id="p1z17"/>carmen egregium scripsisse contra Catalogum <lb xml:id="p1z18"/>hereticorum per pontificem damnatorum.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/>Tabellario nihil eroges.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Ocyssime<lb xml:id="p1z20"/>.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/>22. septembris anno 1559.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z22"/><persName ref="p2856">G[ereon] <lb xml:id="p1z23"/>S[ailerus</persName>] t[uus].</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Heinricho Bullingero</persName>, theologo et <lb xml:id="p2z2"/>amico summa reverentia <lb xml:id="p2z3"/>colendo.</s>
				</p>
			</div>
		</body>
	</text>
