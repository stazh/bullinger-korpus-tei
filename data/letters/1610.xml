	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Satisfactum meae tandem est expectationi; nam <lb xml:id="p1z2"/>et abs te literas et a <persName ref="p1227">Froschovero</persName> exemplaria accepi.</s>
					<s n="3" xml:lang="la">Gratias <lb xml:id="p1z3"/>ago tibi pro tuis pro me susceptis laboribus, tum etiam <lb xml:id="p1z4"/>pro libello illo tuo, quo diserte nostras ecclesias ab <lb xml:id="p1z5"/>haereseos crimine purgas.</s>
					<s n="4" xml:lang="la">Reliqua exemplaria distribui, <lb xml:id="p1z6"/>prout cuique erant inscripta, excepto, quod <persName ref="p3530">Ioanni Rodolpho <lb xml:id="p1z7"/>ab Erlach</persName> est nuncupatum, quod adhuc mecum propter illius <lb xml:id="p1z8"/>ab urbe absentiam habeo.</s>
					<s n="5" xml:lang="la">Agunt magnas omnes gratias, <lb xml:id="p1z9"/>hocque ut tibi ipsorum nomine significem, rogant.</s>
					<s n="6" xml:lang="la">Descriptio<lb xml:id="p1z10"/>nem bellici in <placeName ref="l822">Germania</placeName> apparatus remitto hic et hoc <lb xml:id="p1z11"/>quoque nomine ago gratias.</s>
					<s n="7" xml:lang="la">Rogo, ut diligenter deinceps omnia quoque <lb xml:id="p1z12"/>communices.</s>
					<s n="8" xml:lang="la">Silent apud nos nunc omnia, licet varius et <lb xml:id="p1z13"/>apud nos sit rumor de <persName ref="p2916">Schertlio</persName> ab hostibus concluso; sed <lb xml:id="p1z14"/>rumor iste non meretur fidem.</s>
					<s n="9" xml:lang="la"><placeName ref="l862">Helvetii</placeName> valde in <lb xml:id="p1z15"/>ipsum sunt exacerbati, nonnisi sacrilegium appellant, <lb xml:id="p1z16"/><foreign xml:lang="de">den kelchdieben,</foreign> quoties de ipso loquuntur, et nostris <lb xml:id="p1z17"/>quoque infensi sunt, eo quod passi sunt ipsum militem <lb xml:id="p1z18"/>in sua ditione colligere.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Simulaverant se auxilia <persName ref="p8112">Gallo</persName> <lb xml:id="p1z19"/>negaturos; sed auri sacra fames facit, ut danti pe<lb xml:id="p1z20"/>cunias nihil negare possint, sed omnem prostituant pudorem.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z21"/>Hac transierunt pridie <placeName ref="l300">Lucernates</placeName>; hodie <placeName ref="l781">Urnenses</placeName> venturos aiunt; iam ve<lb xml:id="p1z22"/>nere <placeName ref="l587">Tugiani</placeName> et quidam alii, 2 vexilla;<note type="margin">a.R.: iam - vexilla Zusatz a. R.</note> <placeName ref="l760">Solodorum</placeName> transeunt.</s>
					<s n="12" xml:lang="la">Legati ad <lb xml:id="p1z23"/>comitia missi sunt consul <persName ref="p2305">Negelinus</persName>, et qui <persName ref="p8018">Hallero</persName> suc<lb xml:id="p1z24"/>cessit, quaestor novus <persName ref="p6801">Tilgerus</persName>, qui paucos ante <lb xml:id="p1z25"/>dies ex aula regis venit.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Expectamus ex his comitiis <lb xml:id="p1z26"/>aliquid novi.</s>
					<s n="14" xml:lang="la">Oremus dominum diligenter, ut non <lb xml:id="p1z27"/>pro meritis nostris nobis retribuat, sed pro sua nos <lb xml:id="p1z28"/>in his turbis tueatur gratia detque spiritum fortitudinis, sapientiae et <lb xml:id="p1z29"/>pacis, per quem possimus quaevis declinare adversa!</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z30"/><persName>Ottonis</persName>, charissimi affinis, mors me quoque graviter affligit; <lb xml:id="p1z31"/>utinam nihil portendat mali!</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><persName>Hieronymus</persName> ille <lb xml:id="p1z32"/><placeName ref="l167">Genevensis</placeName> tandem nobis quoque negotium <lb xml:id="p1z33"/>facessere incepit; <lb xml:id="p1z34"/>accusatus est hic a classe <placeName ref="l1280">Tononiensi</placeName>, in qua agit, quod <lb xml:id="p1z35"/>etiam illic suos privatim incipiat colligere discipulos, unde <lb xml:id="p1z36"/>maiores possint turbę sequi.</s>
					<s n="17" xml:lang="la">Accersitus et obiurgatus <lb xml:id="p1z37"/>est.</s>
					<s n="18" xml:lang="la">Voluit se nobis quoque multis ingerere; sed paucis cum eo <lb xml:id="p1z38"/>egimus cupientes ecclesias nostras in pace conservare.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z39"/>Magno <persName ref="p540">Calvini</persName> laborat odio, ex quo hęc omnia proficiscuntur.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z40"/>Conabatur contra illum scribere; sed hoc a senatu <lb xml:id="p1z41"/>nostro prudentissime illi interdictum est.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z42"/><placeName ref="l303">Magdeburgensibus</placeName> <lb xml:id="p1z43"/>nihil a nobis est missum, quia neminem habebamus, qui <placeName ref="l157">Franco<lb xml:id="p1z44"/>furtum</placeName> proficisceretur, nec tutum erat aliis committere.</s>
					<s n="22" xml:lang="la"><lb xml:id="p1z45"/><placeName ref="l28">Basilienses</placeName> audio collegisse iustam summam; sed an miserint, <lb xml:id="p1z46"/>ignoro.</s>
					<s n="23" xml:lang="la" ana="farewell">Haec habui modo, quę ad tuas responderem; <lb xml:id="p1z47"/>tu boni consule et in domino optime vale.</s>
				</p>
				<p>
					<s n="24" xml:lang="la" ana="salute">Salutat <lb xml:id="p1z48"/>te tuamque mea familia.</s>
					<s n="25" xml:lang="la"><placeName ref="l41">Bernę</placeName> 6. aprilis <lb xml:id="p1z49"/>1552.</s>
					<s n="26" xml:lang="la"><lb xml:id="p1z50"/>T[uus] <persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>fidelissimo pastori, domino et co<lb xml:id="p2z4"/>mpatri suo observando.</s>
				</p>
				<p>
					<s n="28" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
