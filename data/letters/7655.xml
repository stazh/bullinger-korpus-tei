	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi literas tuas proximo sabbato, clarissime vir <lb xml:id="p1z2"/>et pater in Christo observande, et gratias tuae <lb xml:id="p1z3"/>humanitati singulares ago, quo sententiam <lb xml:id="p1z4"/>super catecheseos formulam humaniter <lb xml:id="p1z5"/>communicasti.</s>
					<s n="3" xml:lang="la">Vocabulum <foreign xml:lang="de">kelch,</foreign> quia in <lb xml:id="p1z6"/>omnibus reformatis ecclesiis in usu est et in <lb xml:id="p1z7"/><placeName ref="l210">Heidelbergensi</placeName> etiam catechismo ponitur, ipse <lb xml:id="p1z8"/>quoque retinui in verbis institutionis et <lb xml:id="p1z9"/>carmine super illis composito; non dis<lb xml:id="p1z10"/>plicet autem sententia tua, ut commutetur in <lb xml:id="p1z11"/>verbis institutionis vocabulo <foreign xml:lang="de">trinckgeschirr,</foreign> <lb xml:id="p1z12"/>quo vestra utitur translatio Germanica, <lb xml:id="p1z13"/>salvo tamen iudicio tuo; nolo enim <foreign xml:lang="el">λογομαχεῖν</foreign>.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z14"/>Nam ut vocabulum <foreign xml:lang="de">kelch</foreign> quiddam papisticum, <lb xml:id="p1z15"/>ita vox <foreign xml:lang="de">becher</foreign> inter rudes huic voci minus <lb xml:id="p1z16"/>in hac causa assuetos prophanius quiddam <lb xml:id="p1z17"/>sonare videbitur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quantum ad carmen attinet <lb xml:id="p1z18"/>de coena, postquam ante id tempus tuo iudicio <lb xml:id="p1z19"/>subieci et per literas haud displicere tibi <lb xml:id="p1z20"/>intellexi, postea communicavi ministris <lb xml:id="p1z21"/>ecclesiarum <placeName>Franconiae</placeName>, quibus praefui, quo nunc <lb xml:id="p1z22"/>fortasse utuntur.</s>
					<s n="6" xml:lang="la">Quare si in eo commutatio <lb xml:id="p1z23"/>fieret, forte offenderentur aliqui, cum rithmus <lb xml:id="p1z24"/>ipse quoque mutandus propter dissyllabum <lb xml:id="p1z25"/>vocabulum esset.</s>
					<s n="7" xml:lang="la">At malo iudicium tuum, <lb xml:id="p1z26"/>si ita placet, sequi quam meis insistere.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z27"/>Duplex decalogi carmen et <persName>Greyteri</persName> symbolum <lb xml:id="p1z28"/>lubens mitto; ideo enim tantum inserueram, quod <lb xml:id="p1z29"/>longa consuetudine in ecclesiis nostris usurpante.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z30"/>Symbolum autem sequens a <persName ref="p1974">Luthero</persName> compositum, <lb xml:id="p1z31"/>quod in omnibus ecclesiis reformatis honorifice <lb xml:id="p1z32"/>canitur et syncerum est, retineri cupio; secundum <lb xml:id="p1z33"/>enim catecheseos caput hoc omisso suo carmine <lb xml:id="p1z34"/>careret; potest autem praemitti titulus: <lb xml:id="p1z35"/><foreign xml:lang="de">Der christlich glaub in gesangsweis</foreign>; <lb xml:id="p1z36"/>fateor mihi priorem titulum displicere.</s>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Et cum <persName>Greyteri</persName> symbolum intermit[t]eretur, <lb xml:id="p2z2"/>intermitterem eandem ob causam etiam <lb xml:id="p2z3"/>orationem dominicam notulis consignatam; <lb xml:id="p2z4"/>textum enim prius suo loco positum tantum <lb xml:id="p2z5"/>continet.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z6"/>De novis rebus audies symmystam, <lb xml:id="p2z7"/>fratrem dilectum, qui pius, syncerus et christiano <lb xml:id="p2z8"/>zelo vere praeditus est.</s>
					<s n="12" xml:lang="la">Ex illo consilii quoque <lb xml:id="p2z9"/>mei in omnibus rationem et pios conatus <lb xml:id="p2z10"/>cognosces.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Datum raptim <lb xml:id="p2z12"/>1. novembris 1568.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z13"/>Tuu<lb xml:id="p2z14"/>s <persName ref="p8109">Iohannes <lb xml:id="p2z16"/>Conradus Ulmeru<pb/><lb xml:id="p3z3"/>s</persName><lb xml:id="p3z6"/>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo omnique eruditonis <lb xml:id="p4z2"/>et virtutis genere ornatissimo <lb xml:id="p4z3"/>viro d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p4z4"/>domino et patri suo in Christo <lb xml:id="p4z5"/>plurimum colendo.</s>
				</p>
			</div>
		</body>
	</text>
