	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Tandem assequutus exoptatum tabellionm
					<lb xml:id="p1z2"/>Heyninum
					<lb xml:id="p1z3"/>mitto libellos
					<lb xml:id="p1z4"/>per a te postulatos. 6 exempla librorum
					<lb xml:id="p1z5"/>meorum de gratia dei etc. Precium horum est
					<lb xml:id="p1z6"/>8battus nostrates. 16 valent aurem. Singuli
					<lb xml:id="p1z7"/>ergo constant 3 batz. Reliqui libelli omnes
					<lb xml:id="p1z8"/>precium huc 11 solidorum Tigurinorum, id est,
					<lb xml:id="p1z9"/>4 batzioni et S. Tabellioni dabis merce
					<lb xml:id="p1z10"/>deportationis. Viliori forsan precio
					<lb xml:id="p1z11"/>habes, quam si accepisses a bibliopobis.
					<lb xml:id="p1z12"/>bellos Germanicos non potui, mittere contr
					<lb xml:id="p1z13"/>ctos. Tu ipse rectius curabis, ut confut
					<lb xml:id="p1z14"/>Hactenus tibi libeniter inservivi.
					<lb xml:id="p1z15"/>Spero te non ita praidem a d. Sulcero
					<lb xml:id="p1z16"/>Basiliensis ecclesiae pastore literas meas accepe
					<lb xml:id="p1z17"/>pisse una cum libro meis de gratia etc domo
					<lb xml:id="p1z18"/>tsibi datis. Valemus hic sic satis recte
					<lb xml:id="p1z19"/>deo gratia et tranquilla sunt omnia. Dominus hoc
					<lb xml:id="p1z20"/>nobis esse diuturnum. Cuperemus
					<lb xml:id="p1z21"/>os de nobis audire fausta. Intelligi
					<lb xml:id="p1z22"/>quotam esse in Anglia seditionem a quodm
					<lb xml:id="p1z23"/>Wäyet nobili; accessisse ei aliquot millia
					<lb xml:id="p1z24"/>postulasse a regia, ut revunciet Hispanico,
					<lb xml:id="p1z25"/>vera religionem restituat denique
					<lb xml:id="p1z26"/>nuptis
					<lb xml:id="p1z27"/>publica pascua erepta nobilibus reddat
					<lb xml:id="p1z28"/>plebeis. regina se illi opposuit. Tandem
					<lb xml:id="p1z29"/>trecentis equitibus fusus et captus est
					<lb xml:id="p1z30"/>Nondum certo novimus, quid reliquo eveneru
					<lb xml:id="p1z31"/>exercitui. Seditio magis magisque
					<lb xml:id="p1z32"/>vires acquirere scribitur. Interea audiu
					<lb xml:id="p1z33"/>decollata esse Ioanna designatam mense iulio
					<lb xml:id="p1z34"/>in vincula coniectu ducem suffolciae cum
					<lb xml:id="p1z35"/>fratribus viris bonis; suspendi illic plures
					<lb xml:id="p1z36"/>valeniari. Catastropheu nondum plene
					<lb xml:id="p1z37"/>cepi, expecto
					<lb xml:id="p1z38"/>horas. Dominus bene vertat
					<lb xml:id="p1z39"/>et adsit suae ecclesia. Commenda me
					<lb xml:id="p1z40"/>nisi ipse me amplius
					<lb xml:id="p1z41"/>non norit. Salvus sit
					<lb xml:id="p1z42"/>Vale, cum omnibus piis imprimis Rhegio, Hospinians
					<lb xml:id="p1z43"/>paedagogo et reliquis. Tiguri 13. martii 1554.
					<lb xml:id="p1z44"/>Bullingeruss
					<pb/>
					<lb xml:id="p2z1"/>Praestantissimo viro d. Matthiae
					<lb xml:id="p2z2"/>Erbio Rychevillano pastori
					<lb xml:id="p2z3"/>aut hoc absente d.
					<lb xml:id="p2z4"/>Nicolao rhegio, dominis
					<lb xml:id="p2z5"/>colendis et fratribus charisimo
					<lb xml:id="p2z6"/>cirissimis suis.
					<lb xml:id="p2z7"/>Rychenwyler.
				</p>
