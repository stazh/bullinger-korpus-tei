	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">En, reverende pater, alias literas, quibus perscribitur <lb xml:id="p1z2"/>concilium paulatim dissolvi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Hodie legi <lb xml:id="p1z3"/>alias literas, quae erant <placeName ref="l36">Bergomi</placeName> scriptae, in <lb xml:id="p1z4"/>quibus erat ad illos nunciatam pontificis <lb xml:id="p1z5"/>mortem, quam tamen ego nondum credo.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Sed argumento est eum lethaliter decumbere.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell"><lb xml:id="p1z7"/>Vale.</s>
					<s n="6" xml:lang="la">26. martii.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/>De concilio certiora brevi.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Vides magnam <lb xml:id="p1z9"/>varietatem.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z10"/>T[<lb xml:id="p1z11"/>uu<lb xml:id="p1z12"/>s] <lb xml:id="p1z13"/><persName ref="p8009">Fab[<lb xml:id="p1z14"/>riciu<lb xml:id="p1z15"/>s</persName>]<lb xml:id="p1z16"/>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>domino suo <lb xml:id="p2z4"/>et in Christo patri <lb xml:id="p2z5"/>reverendo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
