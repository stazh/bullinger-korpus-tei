			<zone xml:id="p2z2-0" points="1190,1415 1502,1387 1622,1428 1748,1416 1796,1451 1955,1390 2088,1399 2100,1342 1831,1301 1629,1339 1542,1314 1460,1353 1377,1312 1192,1330">1197,1394 1242,1392 1287,1386 1332,1385 1377,1385 1423,1385 1468,1382 1513,1382 1558,1382 1603,1379 1649,1382 1694,1379 1739,1382 1784,1382 1829,1382 1875,1385 1920,1382 1965,1382 2010,1382 2055,1385 2101,1385</zone>
			<zone xml:id="p2z3-0" points="1246,1615 1346,1648 1475,1599 1550,1621 1641,1576 1697,1589 1703,1506 1573,1449 1543,1470 1463,1467 1343,1535 1255,1487">1257,1560 1283,1561 1309,1561 1335,1561 1362,1560 1388,1558 1414,1556 1441,1554 1467,1551 1493,1548 1519,1546 1546,1545 1572,1543 1598,1541 1625,1539 1651,1538 1677,1536 1704,1534</zone>
