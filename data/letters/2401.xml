	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S.
					<lb xml:id="p1z2"/>Otthodoxum euti ex Anglia pervenerint ad vos
					<lb xml:id="p1z3"/>Recepti, duricussime inter vos viguans, ut exulis
					<lb xml:id="p1z4"/>vosceribus misericoadiae
					<lb xml:id="p1z5"/>vri Paulus Appellar ellius mitter.
					<lb xml:id="p1z6"/>binos singutas. ex itarum
					<lb xml:id="p1z7"/>nurierandos, dotemicus loco, ut exitium patuu
					<lb xml:id="p1z8"/>ancto proposite, sientes, ut pati ut habore si
					<lb xml:id="p1z9"/>mons sdangeat illis pacientiae spiritum,
					<lb xml:id="p1z10"/>n agno valeros, Bullingere, pterum
					<lb xml:id="p1z11"/>depembris anno etc..
					<lb xml:id="p1z12"/>us
				</p>
			</div>
		</body>
	</text>
