	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Etsi novum scribendi argumentum non erat, nisi quod tribus verbis mox <lb xml:id="p1z2"/>intelliges, cogor tamen propter incommodam valetudinem literas quodammodo <lb xml:id="p1z3"/>abrumpere; nam hoc quatriduo dysenteria mihi perquam molesta fuit et nunc <lb xml:id="p1z4"/>parum relaxationis concedit.</s>
					<s n="2" xml:lang="la">Rogavit me ante mensem <placeName ref="l834">Italus</placeName> quidam, <lb xml:id="p1z5"/>qui huc cum familia migravit, an ius civitatis apud vos possit impetrare, <lb xml:id="p1z6"/>quamvis in ditione vestra non habitet.</s>
					<s n="3" xml:lang="la">Neque enim vellet locum domicilii mutare <lb xml:id="p1z7"/>nec alia de causa civis vester fieri appetit, nisi ut fratribus suis obtemperet, <lb xml:id="p1z8"/>qui sibi odiosum fore putant, quod huc concesserit.</s>
					<s n="4" xml:lang="la">Hoc ideo diserte <lb xml:id="p1z9"/>testari volui, ne putares eum astute aliquid venari; est autem vir integer <lb xml:id="p1z10"/>optimęque existimationis.</s>
					<s n="5" xml:lang="la">Peto abs te, venerande frater, ubi primum dabitur <lb xml:id="p1z11"/>occasio, hac de re ut me certiorem facias.</s>
					<s n="6" xml:lang="la">Gaudeo nuper ad reformandum <lb xml:id="p1z12"/>ducatum <placeName ref="l572">Badensem</placeName> cum <persName ref="p3099">Sulcero</persName> vocatum fuisse doctorem quendam <persName ref="p4183">Iacobum <lb xml:id="p1z13"/>Andreę</persName>, pium et moderatum virum neque alienum a nobis.</s>
					<s n="7" xml:lang="la">Certe ex ipsius <lb xml:id="p1z14"/><persName ref="p3099">Sulceri</persName> literis intelligo valde utilem fuisse eius pręsentiam.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Vale, eximie <lb xml:id="p1z15"/>vir et mihi observande frater.</s>
					<s n="9" xml:lang="la" ana="salute">Saluta meo nomine diligenter symmystas <lb xml:id="p1z16"/>omnes.</s>
					<s n="10" xml:lang="la">Dominus vos semper gubernet, tueatur, benedicat.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l167">Genevę</placeName> 3. calendas <lb xml:id="p1z17"/>decembris 1556.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro et fratri <lb xml:id="p2z2"/>mihi observando symmystęque <lb xml:id="p2z3"/>integerrimo <lb xml:id="p2z4"/>d. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z5"/>ecclesię <placeName ref="l587">Tigurinę</placeName> fido pastori.</s>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
