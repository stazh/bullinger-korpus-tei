	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Heri certo sum admonitus <placeName ref="l2510">Turcam</placeName>, posteaquam <lb xml:id="p1z2"/>de induciis inter regem et Caesarem factis <lb xml:id="p1z3"/>comperit, totum illum apparatum belli reliquisse <lb xml:id="p1z4"/>neque amplius aut in <placeName ref="l882">Ungariam</placeName> exercitum aut <lb xml:id="p1z5"/>in maritimas provincias Caesaris classem <lb xml:id="p1z6"/>esse missurum.</s>
					<s n="2" xml:lang="la">Nunc considerent Germani, <lb xml:id="p1z7"/>quo se exercitus iste a rege <placeName ref="l425">Romano</placeName> <lb xml:id="p1z8"/>collectus convertere debeat.</s>
					<s n="3" xml:lang="la">Iam revera <lb xml:id="p1z9"/>habent, quod timeant; antea non habuerunt.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>Tu quibus ista indicare voles, a quo <lb xml:id="p1z11"/>habeas, ne nomines; caeterum pro certissimis <lb xml:id="p1z12"/>et compertissimis tibi scribo.</s>
					<s n="5" xml:lang="la">Meis <lb xml:id="p1z13"/>ultimis literis oblitus eram addere induciarum <lb xml:id="p1z14"/>tractatum, quem postea misi.</s>
					<s n="6" xml:lang="la">Hospitem Ciconiae, <lb xml:id="p1z15"/>quod in me erit, commendatum habeo.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale.</s>
					<s n="8" xml:lang="la" ana="salute">Com<lb xml:id="p1z16"/>menda me tuis dominis.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/><placeName ref="l760">S[olodori]</placeName> 29a maii.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Tuus <persName ref="p8183">S. Laurentius</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">De suppliciis <lb xml:id="p1z18"/>legatorum regis et <placeName ref="l522">Venetorum</placeName> <lb xml:id="p1z19"/>falsum et <lb xml:id="p1z20"/>confictum est.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo theologo et amicissimo <lb xml:id="p2z2"/>viro domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>d. d. <placeName ref="l587">Tigurinorum</placeName> concionatori.</s>
				</p>
			</div>
		</body>
	</text>
