	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Has tibi mitto, ut clare intelligas nunquam ad lupum <lb xml:id="p1z2"/>conclamari, quin sit aliquid in vicinia.</s>
					<s n="2" xml:lang="la">Ex eisdem <lb xml:id="p1z3"/>harum ecclesiarum statum praesentem brevique <lb xml:id="p1z4"/>futurum facile poteris animo comprehendere.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Hic sit finis, neque literis superiore hebdomade <lb xml:id="p1z6"/>scriptis est, quod addam detrahamve.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Illas vero <lb xml:id="p1z7"/>accepisse vos qui dubitarem, cum lator fuerit <lb xml:id="p1z8"/>quidam magister noster <placeName ref="l587">Tigurinus</placeName>, ex quo, reliqui <lb xml:id="p1z9"/>si quid erat, cognovistis certius sive de aliis sive <lb xml:id="p1z10"/>de ipso me, quem tuum tuique studiosissimum esse <lb xml:id="p1z11"/>fore in perpetuum miror, si dubium, si scrupulum <lb xml:id="p1z12"/>adhuc ullum habes, si habes, quod sciam et eximam, <lb xml:id="p1z13"/>si non habes, idem et tuis suade symmistis, ut <lb xml:id="p1z14"/>persuadeant sibi declarentque mihi tanquam re sua <lb xml:id="p1z15"/>utendo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell">Hoc tantum peto, hoc tantum rogo a vobis <lb xml:id="p1z16"/>impetrari sinite impetratumque ostendite et valete <lb xml:id="p1z17"/>in domino faelicissime <placeName ref="l558">Witembergę</placeName> 20. augusti 1550.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p8101">Laelius Sozinus</persName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo optimoque viro domino <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, plurim<lb xml:id="p2z3"/>um observando.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
