	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Destituor subinde nunciis; hinc fit, ut rarius ad te scribam, <lb xml:id="p1z2"/>et hanc ob causam me rariores quoque abs te accipere puto.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Accepi tamen illas, quas proxime misisti, una cum his, quas <lb xml:id="p1z4"/>nunc omnes tibi remitto et pro istis ago gratias.</s>
					<s n="4" xml:lang="la">Scribere ego in <lb xml:id="p1z5"/>praesentiarum non multa possum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Transierunt hac aliquot <lb xml:id="p1z6"/><placeName ref="l862">Helvetiorum</placeName> cohortes 23. et 24. huius mensis; quo profecturi <lb xml:id="p1z7"/>sint et in cuius auxilia, ipsimet ignorunt.</s>
					<s n="6" xml:lang="la">Magni timentur <lb xml:id="p1z8"/>motus; nemo tamen certi quicquam novit.</s>
					<s n="7" xml:lang="la">Communiter asseritur <lb xml:id="p1z9"/>regem hos tantum evocasse ad defensionem finium suorum, <lb xml:id="p1z10"/>cum videat alibi fieri quoque apparatus.</s>
					<s n="8" xml:lang="la">Brevi tamen audiemus, <lb xml:id="p1z11"/>quo res evasura.</s>
					<s n="9" xml:lang="la">Putant multi omnino contra <placeName ref="l167">Genevam</placeName> impe<lb xml:id="p1z12"/>tum fuisse vertendum, nisi pax illa cum <persName>Sabaudo</persName> intercessisset; <lb xml:id="p1z13"/>alii id negant.</s>
					<s n="10" xml:lang="la">Certum est praeteritis diebus dominum <persName>de Movans</persName>, <lb xml:id="p1z14"/>qui praesidio <placeName ref="l167">Genevensi</placeName> praefuit, <placeName ref="l339">Neocomum</placeName> transiisse cum 12 <lb xml:id="p1z15"/>equitibus <placeName ref="l822">Germaniam</placeName> versus.</s>
					<s n="11" xml:lang="la">Colligunt inde omnes illum Germanicas <lb xml:id="p1z16"/>copias exciturum esse et in <placeName ref="l832">Galliam</placeName> ducturum.</s>
					<s n="12" xml:lang="la">De eo, quod <lb xml:id="p1z17"/>imperator <placeName ref="l832">Gallo</placeName> bellum inferre velit, nihil amplius audimus; <lb xml:id="p1z18"/>spero me abs te brevi certum aliquid habiturum.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Interea <lb xml:id="p1z19"/>negotium illud, de quo nuper scripsi, hic volvitur.</s>
					<s n="14" xml:lang="la">Instant <persName>Galli</persName>; <lb xml:id="p1z20"/>multi nostratium et praesertim potentiores ad eos valde <lb xml:id="p1z21"/>inclinant; qui magis pii sunt abhorrent.</s>
					<s n="15" xml:lang="la">Nos clamamus <lb xml:id="p1z22"/>et facimus officium; quid effecturi simus, novit dominus.</s>
					<s n="16" xml:lang="la">Res <lb xml:id="p1z23"/><placeName ref="l832">Galliae</placeName> in tali nunc sunt statu, ut insani videantur, qui <lb xml:id="p1z24"/>cum illis iam foedera iungere velint; sed privata emo<lb xml:id="p1z25"/>lumenta occaecant oculos etiam prudentium.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Dominus resistat Satanę <lb xml:id="p1z26"/>et consiliis <persName>Ahitofelis</persName>!</s>
					<s n="18" xml:lang="la"><persName ref="p8063">Steigerus</persName> noster uxorem duxit <lb xml:id="p1z27"/>his diebus filiam domini consulis <persName ref="p2305">Negelini</persName>; proxima lunę, <lb xml:id="p1z28"/>quę erit 4. augusti, nuptias cum illa celebrabit in castro <lb xml:id="p1z29"/><placeName ref="l62">Bremgarten</placeName><note xml:id="fn1" type="footnote" n="1">wohl Bremg. b. Bern?</note>; Magdalena illa vocatur.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Obiit vero domini <lb xml:id="p1z30"/><persName>Weberi</persName> uxor ex partu relictis misero seni 6 parvulis <lb xml:id="p1z31"/>liberis, quos ex ipsa, quam non ante multos annos i<lb xml:id="p1z32"/>uvenculam duxerat, sustulit.</s>
					<s n="20" xml:lang="la">Alias nihil nunc occurrit.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z33"/>Mitto has <persName>Brugas</persName>, ut inde eas accipias, cum alium non <lb xml:id="p1z34"/>habeam nuncium.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="23" xml:lang="la" ana="salute">Salutant te tuosque mei <lb xml:id="p1z35"/>omnes; precor ipse quoque tuis omnibus salutem.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><placeName ref="l41">Bernae</placeName> <lb xml:id="p1z36"/>30. iulii 1567.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><persName ref="p8018">I[ohan<lb xml:id="p1z37"/>nes] Hall[erus</persName>] tuus.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z4"/>pastori fidelissimo, <lb xml:id="p2z5"/>domino meo honorando <lb xml:id="p2z6"/>et compatri charissimo.</s>
				</p>
				<p>
					<s n="27" xml:lang="de"><lb xml:id="p2z7"/>M. <persName ref="p495">Heinrych Bullingern</persName> <lb xml:id="p2z8"/>zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
