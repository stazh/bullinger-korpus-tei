	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus et pax Christi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Certe gavisus sum nuper plus, quam possim explicare, <lb xml:id="p1z3"/><persName ref="p495">Bullingere</persName> suavissime, cum ex tuis literis<note xml:id="fn1" type="footnote" n="1">Nicht erhalten.</note> audirem <lb xml:id="p1z4"/>bene compositam causam conventus vestri<note xml:id="fn2" type="footnote" n="2">Zur <placeName ref="l587">Zürcher</placeName> Tagung vom 28. April bis 3. Mai s. oben <ref target="file11171">Nr. 1128</ref>, Anm. 1.</note>.</s>
					<s n="3" xml:lang="la">Idem <lb xml:id="p1z5"/>mihi referebat <persName ref="p467">Bucerus</persName> ipse, quem studiosissime <lb xml:id="p1z6"/>sum exhortatus, ut porro quietiore animo sit erga <lb xml:id="p1z7"/>vos, id quod facturum crediderim.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Apud nos <lb xml:id="p1z8"/>vero, quod scire desyderas, nihil actum est, nec <lb xml:id="p1z9"/>quidquam tentavit <persName ref="p467">Bucerus</persName>; tantum apud paucos <lb xml:id="p1z10"/>eius rei gratia congregatos excusavit sese, quod <lb xml:id="p1z11"/>in toto concordandi negotio nihil egerit mala <lb xml:id="p1z12"/>conscientia et iniussus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><persName ref="p1365">Gryneus</persName> quoque paucula quę<lb xml:id="p1z13"/>dam addidit<note xml:id="fna" type="footnote" n="a">addidit <hi>am Rande nachgetragen.</hi></note>, qua ratione ipse aliquando restiterit, deinde <lb xml:id="p1z14"/>qua<note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> qua <hi>gestrichenes</hi> quid.</note> in hanc sententiam adductus sit.</s>
					<s n="6" xml:lang="la">Nos <lb xml:id="p1z15"/>nihil nisi amica respondimus et quibus nullam <lb xml:id="p1z16"/>daremus contentionibus occasionem.</s>
					<s n="7" xml:lang="la">Colloquium <lb xml:id="p1z17"/>totum vix fuit duarum horarum.</s>
					<s n="8" xml:lang="la">Privatim vero <lb xml:id="p1z18"/>contuli cum <persName ref="p467">Bucero</persName> de<pb type="edition" next="135"/> multis, ut sperem non <lb xml:id="p1z19"/>sine fructu fuisse ipsius ad nos adventum.</s>
					<s n="9" xml:lang="la"><persName ref="p1365">Grynei</persName> <lb xml:id="p1z20"/>autem praesentia omnibus nobis fuit exoptatissima.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>Apud vos quid actum sit, scire <lb xml:id="p1z22"/>cupio, quantum scilicet ad capita et locos<note xml:id="fnc" type="footnote" n="c">et locos <hi>am Rande nachgetragen.</hi></note> disputationis<note xml:id="fnd" type="footnote" n="d"><hi>vor</hi> disputationis <hi>gestrichenes</hi> tract.</note> <lb xml:id="p1z23"/>adtinet, in quo potissimum<note xml:id="fne" type="footnote" n="e"><hi>vor</hi> potissimum <hi>mehrere gestrichene Buchstaben.</hi></note> contentionis articulo <lb xml:id="p1z24"/>sitis conversati.</s>
					<s n="11" xml:lang="la">Deinde, cum scribis concordiam <lb xml:id="p1z25"/>et<note xml:id="fnf" type="footnote" n="f">et <hi>am Rande nachgetragen.</hi></note> in confessionem et expositionem <placeName ref="l28">Basiliensem</placeName><note xml:id="fn3" type="footnote" n="3">Gemeint ist das Erste <placeName ref="l862">Helvetische</placeName> Bekenntnis (<bibl source="b132">BSRK</bibl> 101-109) bzw. dessen Auslegung im Brief der reformierten Städte der <placeName ref="l862">Eidgenossenschaft</placeName> an <persName ref="p1974">Luther</persName> vom 12. Januar 1537 (<bibl source="b671">WA</bibl> Briefwechsel XII 241-275, Nr. 4268).</note> <lb xml:id="p1z26"/>reiectam esse, optarem videre utramque, si liceret; <lb xml:id="p1z27"/>remitterem cum<note xml:id="fng" type="footnote" n="g">cum <hi>über der Zeile nachgetragen.</hi></note> tabellario primo, qui contingeret.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z28"/>Responsionem ad<note xml:id="fnh" type="footnote" n="h">ad <hi>über der Zeile nachgetragen.</hi></note> <persName ref="p1974">Lutherum</persName><note xml:id="fn4" type="footnote" n="4">Zum Schreiben der reformierten Städte an <persName ref="p1974">Luther</persName> vom 4. Mai s. oben <ref target="file11171">Nr. 1128</ref>, Anm. 8.</note> non ausim petere; scio enim, <lb xml:id="p1z29"/>quanta fide in istis negotiis<note xml:id="fni" type="footnote" n="i">negotiis <hi>am Rande nachgetragen.</hi></note> agendum sit.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb type="scan" next="102v."/><pb/><lb xml:id="p2z1"/>Porro unum est, quod abs te impetrare cupio, <lb xml:id="p2z2"/>utcunque te illibenter gravem istis molestiis.</s>
					<s n="14" xml:lang="la">Tamen, <lb xml:id="p2z3"/>quia nonnunquam ad rem facit benignius tractare <lb xml:id="p2z4"/>quosvis, cupio etiam abs te fieri in meam gratiam <lb xml:id="p2z5"/>erga Landenbergium<note xml:id="fn5" type="footnote" n="5">Gemeint ist wohl <persName ref="p7564">Sigmund von Landenberg</persName>, der sich wegen eines Zinsstreits mit <persName ref="p3856">Kaspar von Hallwyl</persName> und <persName ref="p19225">Hans von Hinwil</persName> an den <placeName ref="l587">Zürcher</placeName> Rat wandte, wie aus einem Empfehlungsschreiben des <placeName ref="l257">Konstanzer</placeName> Rates vom 28. März hervorgeht (s. Zürich StA, A 205. 1, Nr. 169). Die Angelegenheit hatte bereits 1533 eine Tagsatzung beschäftigt (s. <bibl source="b197">EA</bibl> IV/1c 143f); über ihren Ausgang ist nichts bekannt.</note> illum, quocum <persName ref="p5741">Ioachimus</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p5741">Joachim Maler</persName>.</note> <lb xml:id="p2z6"/>noster ad vos iam profectus est.</s>
					<s n="15" xml:lang="la">Habet autem ille <lb xml:id="p2z7"/>nescio quid causae coram senatu <placeName ref="l587">Tigurino</placeName> - <persName ref="p5741">Ioachimus</persName> <lb xml:id="p2z8"/>novit -, cumque iam fortassis expectet sententiam, <lb xml:id="p2z9"/>rogavit, ut non gravarer amico cuipiam ipsum <lb xml:id="p2z10"/>commendare.</s>
					<s n="16" xml:lang="la">Utcunque ergo ille religionem nostram <lb xml:id="p2z11"/>nulla ratione insectetur, tamen talis est, ut <lb xml:id="p2z12"/>mirer, cur me roget pro commendatione ista.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z13"/>Duo itaque abs te vellem fieri: primum, ut <persName ref="p2816">Röstio</persName><note xml:id="fnk" type="footnote" n="k"><hi>vom Schreiber korrigiert aus</hi> Röstium.</note><note xml:id="fn7" type="footnote" n="7"><persName ref="p2816">Diethelm Röist</persName>.</note>, <lb xml:id="p2z14"/>et si quos alios habes bonos ex ordine senatorio, <lb xml:id="p2z15"/>causam istius <persName ref="p7564">Landenbergii</persName> commendes; alterum, <lb xml:id="p2z16"/>ut saltem uno verbo salutares<note xml:id="fnl" type="footnote" n="l"><hi>vor</hi> salutares <hi>gestrichenes</hi> testa.</note> illum nobilem, <lb xml:id="p2z17"/>certe non mali ingenii virum, eique meam diligentiam, <lb xml:id="p2z18"/>deinde tuam quoque testareris.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z19"/>De <persName ref="p1049">Farello</persName> et <persName ref="p540">Calvino</persName> excidit<note xml:id="fnm" type="footnote" n="m"><hi>vor</hi> excidit <hi>gestrichenes</hi> nes.</note>, quid nuper <lb xml:id="p2z20"/><persName ref="p467">Bucerus</persName> retulerit nobis; cuperem ergo et illud <lb xml:id="p2z21"/>abs te scire, qua causa coacti sint abire <placeName ref="l167">Gebenna</placeName><note xml:id="fnn" type="footnote" n="n"><hi>in der Vorlage irrtümlich</hi> Gebennam.</note><note xml:id="fn8" type="footnote" n="8">Die beiden <placeName ref="l167">Genfer</placeName> Reformatoren hatten an der <placeName ref="l587">Zürcher</placeName> Tagung über den Konflikt berichtet, der am 23./24. April zu ihrer Ausweisung geführt hatte (s. <bibl>CO</bibl> X/2 1921, <ref target="file10142">Nr. 112</ref>; <bibl source="b197">EA</bibl> IV/1c 958 c; vgl. auch das bisher übersehene Schreiben der reformierten Städte an <placeName ref="l167">Genf</placeName> vom 3. Mai, Zürich StA, B IV 9, 134).</note>.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z22"/><persName ref="p8055">Ambrosius</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p8055">Ambrosius Blarer</persName>.</note> noster omnino rogat, ut illos duci <lb xml:id="p2z23"/><persName ref="p8098">Georgio</persName><note xml:id="fn10" type="footnote" n="10">Gemeint ist zweifellos Graf <persName ref="p8098">Georg von Württemberg</persName>.</note> commendetis.<pb type="edition" next="136"/></s>
					<s n="20" xml:lang="la" ana="farewell">Iam vale, fratrum <lb xml:id="p2z24"/>charissime, cum matre<note xml:id="fn11" type="footnote" ana="bio" n="11"><persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note>, uxore<note xml:id="fn12" type="footnote" ana="bio" n="12"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note>, liberis<note xml:id="fn13" type="footnote" n="13">Siehe oben <ref target="file11149">Nr. 1106</ref>, Anm. 11.</note> et bonis <lb xml:id="p2z25"/>omnibus.</s>
					<s n="21" xml:lang="la" ana="salute">Consul noster <persName ref="p8178">Thomas</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p8178">Thomas Blarer</persName>.</note> et frater <persName ref="p4082">Cuͦnradus</persName><note xml:id="fn15" type="footnote" n="15"><persName ref="p4082">Konrad Zwick</persName>.</note> <lb xml:id="p2z26"/>iubent te diligenter salutare.</s>
					<s n="22" xml:lang="la">Ex <placeName ref="l257">Constantia</placeName>, <lb xml:id="p2z27"/>17. maii 1538.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p2z28"/>Tuus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p2z29"/>Sed de leprosis istis quid a me tibi commendati<pb/><lb xml:id="p3z3"/>s<note xml:id="fn16" type="footnote" n="16">Ein Empfehlungsschreiben für den als aussätzig erklärten Prediger Stephan und seine Frau an <persName ref="p495">Bullinger</persName> ist nicht bekannt, wohl aber eines an <persName ref="p8049">Vadian</persName> (<persName ref="p8049">Vadian</persName> BW V 485, <ref target="file11047">Nr. 1005</ref>; vgl. ebd., 492, <ref target="file11054">Nr. 1012</ref>, und unten <ref target="file11184">Nr. 1141</ref>).</note><lb xml:id="p3z4"/>?</s>
				</p>
				<p>
					<note type="address">[Adresse auf f. 103v.:]</note>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p4z1"/>Domino <persName ref="p495">Hainricho <lb xml:id="p4z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p4z3"/><placeName ref="l587">Tigurinae</placeName> diligentissimo <lb xml:id="p4z4"/>pastori, domino <lb xml:id="p4z5"/>et fratri meo charissimo.</s>
				</p>
			</div>
		</body>
