	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scrupulum perquam molestum exemit nuper d. <persName ref="p3740">a <lb xml:id="p1z2"/>Stetten</persName> mihi, qui te literas d. <persName ref="p8018">Halleri</persName> superiori mense <lb xml:id="p1z3"/>a me missas accepisse indicavit.</s>
					<s n="3" xml:lang="la">Cum enim earum <lb xml:id="p1z4"/>te cupidissimum esse exploratum haberem, non commissurum <lb xml:id="p1z5"/>putavi, ut non primo quoque tempore ad eas tibi redditas <lb xml:id="p1z6"/>responderes; quod cum non fieret, prorsus su<lb xml:id="p1z7"/>spicari aliud non potui quam id, quod non esse factum <lb xml:id="p1z8"/>magnopere gaudeo, perlatas eas ad te non esse, quan<lb xml:id="p1z9"/>quam homini noto dederam.</s>
					<s n="4" xml:lang="la">Nec sane nunc habeo, <lb xml:id="p1z10"/>quod scribam, aliud quam expectare me avidissime literas tuas, <lb xml:id="p1z11"/>quibus fidem d. <persName ref="p8018">Hallero</persName> faciam redditas suas tibi esse; <lb xml:id="p1z12"/>scripsit enim is semel et iterum mihi nec obscure signavit <lb xml:id="p1z13"/>subdubitare se.</s>
					<s n="5" xml:lang="la">Expecto autem hoc magis, quod eas non inanes <lb xml:id="p1z14"/>fore spero hoc tam tristi rerum statu, sed rerum <lb xml:id="p1z15"/>novarum plenas, <placeName ref="l832">Gallicarum</placeName> praesertim, quarum te nihil facile <lb xml:id="p1z16"/>praeterit, et <placeName ref="l808">Belgicarum</placeName>, de quibus ipse quoque d. <persName ref="p8018">Hallerus</persName> literas <lb xml:id="p1z17"/>tuas expectat.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute">Quod reliquum est, d. <persName ref="p8011">Gvaltherum</persName>, <lb xml:id="p1z18"/><persName ref="p3988">Wolfium</persName>, <persName ref="p2827">Simlerum</persName> meis verbis salvere iube cum fa<lb xml:id="p1z19"/>milia tua, quibus omnibus insequentem annum faustissimum esse <lb xml:id="p1z20"/>cupio optoque.</s>
					<s n="7" xml:lang="la" ana="farewell">Bene vale, charissime mi d. <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z21"/>meque commendatum habe.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l18">Augustae</placeName> pridie natalis <lb xml:id="p1z22"/>Christi, qui aetate profecit, non statura, cum cunae illi esset <lb xml:id="p1z23"/>mundus ipse totus: hui quantum praesepe!</s>
					<s n="9" xml:lang="la" ana="farewell">Sed vale.</s>
					<s n="10" xml:lang="la">1567.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p2899">M[atthias] Schenckius</persName> t[uus].</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro optimo atque in <lb xml:id="p2z2"/>primis erudito <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/>ecclesiastae <placeName ref="l587">Tigurino</placeName>, d. <lb xml:id="p2z5"/>atque amico suo obser<lb xml:id="p2z6"/>vando.</s>
				</p>
				<p>
					<s n="13" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zü[rich]</placeName><lb xml:id="p2z8"/>.</s>
				</p>
			</div>
		</body>
	</text>
