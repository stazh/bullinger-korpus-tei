	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Hic egregius iuvenis mihi tuas reddidit, que <lb xml:id="p1z2"/>grate fuerunt.</s>
					<s n="3" xml:lang="la">Ago gratias pro iis, que significasti, <lb xml:id="p1z3"/>et rogo te, mi <persName ref="p495">Bullingere</persName>, ut scribas, cum <lb xml:id="p1z4"/>veritatem eorum, que petebam per ultimas meas, <lb xml:id="p1z5"/>habueris.</s>
					<s n="4" xml:lang="la">Agetur enim hoc anno <lb xml:id="p1z6"/>serio inter Caes[arem] et regem; nam rex non <lb xml:id="p1z7"/>vult pacem, nec fiet, quidquid tentent Cae<lb xml:id="p1z8"/>sar[eani], nisi principes Germani in <lb xml:id="p1z9"/>causa sint, quod non spero; non enim <lb xml:id="p1z10"/>melius sue libertati <lb xml:id="p1z11"/>valedicere possunt.</s>
					<s n="5" xml:lang="la">Omnia apud nos <lb xml:id="p1z12"/>recta.</s>
					<s n="6" xml:lang="la"><placeName ref="l2801">Corsica</placeName> tota <placeName ref="l832">Galli</placeName>; quam si <lb xml:id="p1z14"/><persName>Caesariani</persName> cum <placeName ref="l1121">Genuensibus</placeName> <lb xml:id="p1z15"/>hac hyeme aggrediuntur, ut dicunt, excipientur <lb xml:id="p1z16"/>a fortibus viris.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ceterea in <lb xml:id="p1z17"/><placeName ref="l832">Gallia</placeName> satis <lb xml:id="p1z18"/>pacifica exceptis velitationibus <lb xml:id="p1z19"/>ordinariis, quę utrinque fiunt in limitibus.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z20"/>Filius Cęsaris cogitat de ducenda <persName ref="p3207">regina <lb xml:id="p1z21"/>Anglię</persName>; sed iamiam audio illum milor <lb xml:id="p1z22"/>de <placeName>Courtenay</placeName>, quam regina ex longo carcere <lb xml:id="p1z23"/>liberavit, ducturum.</s>
					<s n="9" xml:lang="la">Expecto per primam postam <pb/><lb xml:id="p2z1"/>novum secretarium, qui tecum fuit, et ille <lb xml:id="p2z2"/>ex <placeName ref="l832">Gallia</placeName> certa omnia adferet, quod statim significabo.</s>
					<s n="10" xml:lang="la" ana="salute"><lb xml:id="p2z3"/>Saluto dominos et te u<lb xml:id="p2z4"/>nnice.</s>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p2z5"/>Vale bene, vir optime.</s>
					<s n="12" xml:lang="la">Ex <lb xml:id="p2z6"/><placeName ref="l922">Friburgo</placeName> 3<lb xml:id="p2z7"/>a novembris.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z8"/>Tuus semper <persName ref="p8296">B[<lb xml:id="p2z9"/>assafontane<lb xml:id="p2z10"/>us]</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
