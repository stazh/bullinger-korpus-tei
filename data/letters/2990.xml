	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quod iam diu animus praesagivit mihi, hodie proh dolor <lb xml:id="p1z2"/>eventum habuit.</s>
					<s n="3" xml:lang="la"><persName ref="p8130">Laurentius</persName> noster, cui solidam fidem adhibebis, <lb xml:id="p1z3"/>casum flebilem tibi declarabit.</s>
					<s n="4" xml:lang="la">Ego illi dedi testimoniales <lb xml:id="p1z4"/>ad magistratum vestrum magnificum, quas haud dubie ipse videbis.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Meos successus frater ille noster optimus narrabit.</s>
					<s n="6" xml:lang="la">Plura prę męrore <lb xml:id="p1z6"/>nequeo.</s>
					<s n="7" xml:lang="la">Cura, ut literę meę apud senatum probe custodiantur, <lb xml:id="p1z7"/>ne in discrimen meus me candor ducat.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Vale propere <lb xml:id="p1z8"/>ex <placeName ref="l447">Schlachtegkh</placeName> 21. augusti 1556.</s>
					<s n="9" xml:lang="la">Tuus <persName ref="p8354">G[eorgius] L[aetus</persName>].</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henricho Bullingero</persName>, antistiti <lb xml:id="p2z2"/><placeName ref="l587">Tigurino</placeName>, fratri et amico desiderabili.</s>
				</p>
			</div>
		</body>
	</text>
