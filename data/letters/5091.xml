	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime vir, domine et frater colendissime, S. <lb xml:id="p1z2"/>Rescripsi d. <persName ref="p3988">Ioanni Wolphio</persName>, ex quo scies, quę utriusque refert <lb xml:id="p1z3"/>te scire, modo scribo, ut diligentissime tibi commendem filios <lb xml:id="p1z4"/>generosi et pii viri domini <persName ref="p753">Stanislai Czikowski</persName>, de ecclesia dei <lb xml:id="p1z5"/>optime meriti.</s>
					<s n="2" xml:lang="la">Literas alligatas his, ut d. <persName ref="p540">Calvino</persName> reddi cu<lb xml:id="p1z6"/>res, te etiam atque etiam rogo.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Exemplum tuarum literarum, quibus respondes ad nescio quas literas <lb xml:id="p1z8"/>ad te missas per d. <persName ref="p20298">Martinum Czechovium</persName>, ill.</s>
					<s n="4" xml:lang="la">mi palatini <lb xml:id="p1z9"/><placeName ref="l552">Vilnensis</placeName> nuntium, ac si nomine ecclesiarum <placeName ref="l673">Minoris Polonię</placeName> <lb xml:id="p1z10"/>essent scriptę tibi mitto.</s>
					<s n="5" xml:lang="la">Cum rev [...] d. <persName>Felix</persName> <placeName ref="l260">Cracovia</placeName> discederet, <lb xml:id="p1z11"/>commisit mihi hanc provintiam.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Video tibi viro alioqui prudentissimo et d. <persName ref="p540">Calvino</persName> fuisse <lb xml:id="p1z13"/>impositum a nescio quo, qui titulum <placeName ref="l260">Cracoviensis</placeName> ecclesię pastoris <lb xml:id="p1z14"/>sibi usurpat, ut facilius imponat.</s>
					<s n="7" xml:lang="la">Is persuaso quodam <lb xml:id="p1z15"/>ministro, ambitiosi et turbulenti ingenii homine, et circum<lb xml:id="p1z16"/>vento d. <persName ref="p8318">Felice Crucigero</persName> superintendente, alioqui viro <lb xml:id="p1z17"/>integerrimo, d. <persName ref="p8480">Martino Crovitio</persName> allecto scripsit <lb xml:id="p1z18"/>ad te literas nomine ecclesiarum <placeName ref="l673">Minoris Polonię</placeName> et inseruit <lb xml:id="p1z19"/>quandam confessionem.</s>
					<s n="8" xml:lang="la">Cęterum ne amplius credatis <lb xml:id="p1z20"/>huiusmodi literis, synodus seniorum celebrata <placeName ref="l260">Cracoviae</placeName> <lb xml:id="p1z21"/>10. huius mensis te et d. <persName ref="p540">Calvinum</persName> per literas a super<lb xml:id="p1z22"/>intendentibus ecclesiarum et aliquot senioribus equestris <lb xml:id="p1z23"/>ordinis subscriptas vos facit cautos.</s>
					<s n="9" xml:lang="la" ana="salute">Quod in tuis ad d. <persName>Felicem</persName> <lb xml:id="p1z24"/>me salvere iubes, habeo gratiam, quod vero hortaris, ut sim <lb xml:id="p1z25"/>integer, esset, unde tecum familiariter expostulare possem, <lb xml:id="p1z26"/>si non magis te amarem, quam tu mihi fidis.</s>
					<s n="10" xml:lang="la">Sed his <lb xml:id="p1z27"/>copiosius alias.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale, vir clarissime, et scias <persName ref="p1936">Lismaninum</persName> <pb/><lb xml:id="p2z1"/>tuum errare posse, sed hereticum esse non posse nec velle.</s>
					<s n="12" xml:lang="la" ana="salute"><lb xml:id="p2z2"/>Saluto per te reverenter omnes tuos et domesticos et symmistas.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l260">Cracoviae</placeName> 14. decembris 1561.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z4"/><persName ref="p1936">Franciscus Lismaninus</persName> ex animo tuus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z5"/>Clarissimo viro domino <persName ref="p495">Heinricho <lb xml:id="p2z6"/>Bullingero</persName>, ec[cl]<lb xml:id="p2z7"/>esię <placeName ref="l587">Tigurinę</placeName> pa[sto]<lb xml:id="p2z8"/>ri fidelissimo domino et <lb xml:id="p2z9"/>fratri colendissimo.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z10"/><placeName ref="l587">Tiguri</placeName> alias <placeName ref="l587">Zurik</placeName>.</s>
				</p>
			</div>
