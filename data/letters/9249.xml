	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Fasciculos literarum tuarum omnes, colendissime domine <lb xml:id="p1z2"/>compater, rursus accepi, alteros quidem nudiustertius per <lb xml:id="p1z3"/>cursorem nostrum, secundos vero heri per huncce vestratem.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Communicavi mox domino <persName ref="p8063">Steigero</persName>, intimo meo, omnia.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Is, <lb xml:id="p1z5"/>quae visa fuerunt, ad senatum retulit.</s>
					<s n="5" xml:lang="la">Nunc ego tibi <placeName ref="l98">Curi<lb xml:id="p1z6"/>enses</placeName> ad regem literas remitto et simul <lb xml:id="p1z7"/>posteriores quoque <placeName ref="l646">Glaronenses</placeName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quod ad <placeName ref="l648">Rhoetos</placeName>, nostri vestrorum <lb xml:id="p1z8"/>exemplo moti scripserunt quoque ad illos et se p<lb xml:id="p1z9"/>ariter excusarunt de literis illis ex <placeName ref="l21">Badena</placeName> ad illos <lb xml:id="p1z10"/>scriptis; affirmant enim de se idem nostri legati, quod et <lb xml:id="p1z11"/>vestri, quod non hac ratione in ullum scriptum consenserint, <lb xml:id="p1z12"/>qua pensionarii illi interpretantur.</s>
					<s n="7" xml:lang="la">Expectant vero adhuc <lb xml:id="p1z13"/>responsum ab illis.</s>
					<s n="8" xml:lang="la">Quid nunc vestris nostri scribant, <lb xml:id="p1z14"/>scire ego nondum possum; habitus est enim hodie senatus <lb xml:id="p1z15"/>extraordinarius, cum iam de novo deligatur magistratus; <lb xml:id="p1z16"/>puto tamen te hoc cogniturum ex tuis.</s>
					<s n="9" xml:lang="la" ana="salute"><persName ref="p8063">Steigerus</persName> ad me <lb xml:id="p1z17"/>remisit omnia neque quicquam mandavit aliud, nisi ut tibi <lb xml:id="p1z18"/>salutem illius nomine dicam tibique agam gratias.</s>
					<s n="10" xml:lang="la">Literas <lb xml:id="p1z19"/><placeName ref="l167">Genevam</placeName> pertinentes statim illuc transmisi, cum commo<lb xml:id="p1z20"/>de istis allatis tabellarius <placeName ref="l167">Genevensis</placeName> esset praesens, qui <lb xml:id="p1z21"/>illas suscepit.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Quod res attinet <placeName ref="l832">Gallicas</placeName>, praeter ea, quae <lb xml:id="p1z22"/>a d. <persName ref="p8276">Gracili</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8276">Etienne Le Gresle</persName>.</note> nuper accepimus, nihil audimus quicquam, quod fidem <lb xml:id="p1z23"/>aliquam mereatur.</s>
					<s n="12" xml:lang="la">Si res <placeName ref="l850">Austriacae</placeName> ita habeant, <lb xml:id="p1z24"/>ut ex te intelligimus, sequentur sine dubio mala ampliora, <lb xml:id="p1z25"/>et fortassis vindex dominus ulciscetur aliquando insolentiam illam <lb xml:id="p1z26"/>inerratandam(?) principum et nobilium; ipsa enim humanitas vix <lb xml:id="p1z27"/>amplius potest ferre illam non minus ac sacrificorum et ponti<lb xml:id="p1z28"/>ficum.</s>
					<s n="13" xml:lang="la">Problemata Aretii iam mitterem; sed un[um] <lb xml:id="p1z29"/>est mihi tandem exemplar mihi inscriptum, quod libent[er] <lb xml:id="p1z30"/>tibi mitterem, sicut et d. <persName ref="p8063">Steigerus</persName>, cui opus illud ded[icatum] <lb xml:id="p1z31"/>est, suum exmplar obtulit; sed statim cras aut proximis diebus <lb xml:id="p1z32"/><persName ref="p2041">Blasius Marcuardus</persName>, gener meus, afferet mihi <lb xml:id="p1z33"/>plura; tum promissis meis satisfaciam.</s>
					<s n="14" xml:lang="la">Cupio etiam ad te <lb xml:id="p1z34"/>mittere correctum exemplar; mirum enim est, quantum <lb xml:id="p1z35"/>typographus noster <placeName ref="l280">Lausanensis</placeName> impegerit idque propter <foreign xml:lang="el">κ<lb xml:id="p1z36"/>ακογραφίαν</foreign> opinor d. Aretii; ne te ergo morae <lb xml:id="p1z37"/>taedeat.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Alias non habeo, quod nunc scribam, nisi quod <lb xml:id="p1z38"/>te gratiae dei commendo cum omnibus tuis, quos ut <lb xml:id="p1z39"/>ex me salutes, plurimum oro.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l41">Bernae</placeName> 19. martii <lb xml:id="p1z40"/>1573.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Nostri te omnes salutant et omnes communiter tibi <lb xml:id="p1z41"/>pro opera tua et pro libellis tuis maximas gratias agunt <lb xml:id="p1z42"/>tuique non sine summa reverentia mentionem faciunt.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z43"/>Tuus singularis <lb xml:id="p1z44"/><persName ref="p8018">Iohannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino meo honorando <lb xml:id="p2z5"/>et compatri charissimo.</s>
				</p>
			</div>
