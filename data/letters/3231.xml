	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto rursum duos terniones t et u per <lb xml:id="p1z2"/>hosce bonos viros italos, qui etiam amicissime me tuo <lb xml:id="p1z3"/>et <persName ref="p8171">Theodori</persName> nostri nomine salutarunt.</s>
					<s n="3" xml:lang="la">Brevi, si dominus <lb xml:id="p1z4"/>volet, ultimam manum imposituri sumus universo operi, <lb xml:id="p1z5"/>quod equidem prolixius esse vellem; sed ita placuit <lb xml:id="p1z6"/><persName>Euclioni Froschovero</persName> minutiore charactere nos uti, <lb xml:id="p1z7"/>quo paucioribus foliis absolveretur et ne ego (si diis <lb xml:id="p1z8"/>placet), si maiore Paulo charactere essem usus, <lb xml:id="p1z9"/>inde ditescerem, quin serio etiam iniunxit, ne plura <lb xml:id="p1z10"/>quam mille centum exemplaria excuderem, quum, si etiam duo <lb xml:id="p1z11"/>milia imprimi voluisset, distrahi facillime potuisse <lb xml:id="p1z12"/>existimem.</s>
					<s n="4" xml:lang="la">Sed ita est ingenium hominis.</s>
					<s n="5" xml:lang="la">Ego, quod possum, <lb xml:id="p1z13"/>in praesentia praesto, utinam possem melius, idque tua magis <lb xml:id="p1z14"/>quam illius gratia, cui inservire, quicquid in me est studii <lb xml:id="p1z15"/>atque operae, ex animo.</s>
					<s n="6" xml:lang="la">Cupio.</s>
					<s n="7" xml:lang="la" ana="farewell">Bene vale et <persName>Theo<lb xml:id="p1z16"/>derychi</persName> a <placeName ref="l1221">Niceno</placeName>, quaeso, in <placeName>Balei</placeName> nostril gratiam <lb xml:id="p1z17"/>ne obliviscitor.</s>
					<s n="8" xml:lang="la" ana="salute">Is te quam officiosissime salvere iubet.</s>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z18"/>Iterum vale cum amicis et fratribus nostris atque <lb xml:id="p1z19"/>cum patribus omnibus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l28">Basileae</placeName> cal. Iulii <lb xml:id="p1z20"/>1557.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z21"/><persName ref="p8126">Ioan[nes] Oporinus</persName> <lb xml:id="p1z22"/>tuus ex animo.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Optimo atque doctissimo <lb xml:id="p2z2"/><placeName ref="l587">Tigurinae</placeName> ecclesię <lb xml:id="p2z3"/>pastori d. <persName ref="p495">Heinricho <lb xml:id="p2z4"/>Bullingero</persName>, <lb xml:id="p2z5"/>domino et amico <lb xml:id="p2z6"/>suo plurimum colendo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
