	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">In praesentiarum non habeo multa, quae scribam, <lb xml:id="p1z2"/>nisi quod <placeName ref="l2478">Sabaudiae</placeName> dux diem con<lb xml:id="p1z3"/>ventus <placeName ref="l339">Neocomi</placeName> constitutum nostris abre<lb xml:id="p1z4"/>nunciavit causatus infirmitatem et occupationes <lb xml:id="p1z5"/>nec interea constituit alium.</s>
					<s n="3" xml:lang="la">Vellen<lb xml:id="p1z6"/>t nostri eum ad calendas usque Graecas differre <lb xml:id="p1z7"/>omnia, mirantur tamen interea, quid sibi ab<lb xml:id="p1z8"/>renunciatio ista velit; fertur enim exercitum <lb xml:id="p1z9"/>eum colligere, imo iam paratum habere in <lb xml:id="p1z10"/><placeName ref="l736">Pedemontio</placeName>.</s>
					<s n="4" xml:lang="la">Quo res evasura sit, novit <lb xml:id="p1z11"/>dominus; is nobis adsit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Scribit alias humanissime <lb xml:id="p1z12"/>ad nostros.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Literas <persName ref="p8009">Fabritii</persName> tibi remitto <lb xml:id="p1z13"/>et ago tibi gratias pro earum communicatione.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Ex <placeName ref="l832">Gallia</placeName> nihil habemus, nisi quod cardinales <lb xml:id="p1z15"/>hoc unum meditentur, ut <placeName ref="l167">Geneva</placeName> deleatur.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Deleat eorum consilia dominus et ecclesiam suam se<lb xml:id="p1z17"/>rvet.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Apud <placeName ref="l1028">Trevirenses</placeName> religionis ergo <lb xml:id="p1z18"/>tumultus esse quosdam audimus; certam <lb xml:id="p1z19"/>tamen narrationem non habemus.</s>
					<s n="10" xml:lang="la">Si quid <lb xml:id="p1z20"/>tu habeas, communices nobis, quaeso.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Nostri <lb xml:id="p1z21"/>te omnes humanissime resalutant, <persName ref="p3494">Diesbachius</persName>, <lb xml:id="p1z22"/><persName ref="p8012">Hallerus</persName>, <persName ref="p8389">Hagius</persName>, <persName ref="p3241">Trempius</persName>, qui tantum <lb xml:id="p1z23"/>non in extremis laborat.</s>
					<s n="12" xml:lang="la" ana="salute">Salutem dic <lb xml:id="p1z24"/>tuis omnibus nostro nomine.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l41">Bernae</placeName> 24. oct<lb xml:id="p1z25"/>obris 1559.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><persName ref="p8018">I[oannes] H[alle<lb xml:id="p1z26"/>rus</persName>] tuus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>antistiti fidelissimo, domino et <lb xml:id="p2z4"/>compatri suo honorando.</s>
					<s n="16" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName> m. <persName ref="p495">Heinrych <lb xml:id="p2z6"/>Bullinger</persName>en.</s>
				</p>
