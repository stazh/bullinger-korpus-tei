	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Omnipotens deus et pater aeternus domini et ser<lb xml:id="p1z2"/>vatoris nostri Iesu Christidignetur te per spiritum <lb xml:id="p1z3"/>sanctum suum conservare in vera filii sui agnitione, <lb xml:id="p1z4"/>per quem nobis rursus erecta salus et aeterna restituta <lb xml:id="p1z5"/>vita, ut ne defatigeris in promovendo aedificio ecclesiae suae.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z6"/>Fronte capillata (aiunt) posthac occasio calva est.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Quod cum ita sit, mearum quoque partium esse duxi, <lb xml:id="p1z8"/>ne hanc amicitiae nostrae occasionem, quae mihi abs <lb xml:id="p1z9"/>te oblata est, incuria negligam, frustra posthac captaturus, <lb xml:id="p1z10"/>si amissa fuerit.</s>
					<s n="4" xml:lang="la">Quamvis enim de tua <lb xml:id="p1z11"/>constantis animi fortitudine nihil ambigam, quin <lb xml:id="p1z12"/>eum, quem erga me coepisti declarare, amorem <lb xml:id="p1z13"/>me diutius tacente adhuc tamen lubens retineas, <lb xml:id="p1z14"/>verum enimvero mea interest, huic tam benigno <lb xml:id="p1z15"/>fato morem gerere, ut te praevium fidelis <persName>Achates</persName> sequar.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z16"/>Neque vero hic animus fuit, <persName ref="p495">Bullingere</persName> doctissime, <lb xml:id="p1z17"/>te levi hoc et succincto in procinctu scripto compellare.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z18"/>Volui enim et adhuc animus est ad tuas, quas <lb xml:id="p1z19"/>ad me per nostrum <persName ref="p1936">Lysmaninum</persName> dedisti, literas <lb xml:id="p1z20"/>copiosus respondere, quo possis quoque mentem meam <lb xml:id="p1z21"/>de his quaestionibus cognoscere, quantopere ad tuam <lb xml:id="p1z22"/>accedat.</s>
					<s n="7" xml:lang="la">Caeterum hoc quum tam subito expedire <lb xml:id="p1z23"/>non potuerim propter istorum nunciorum subitam <lb xml:id="p1z24"/>profectionem, hoc, quod tibi mitto, scriptum <lb xml:id="p1z25"/><persName ref="p1936">Lysmaninus</persName> extorsit planeque renuentem compulit.</s>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z26"/>Quod cum nihil praeter salutes continet, salute <lb xml:id="p1z27"/>quoque finiendum duxi longa et fastidiosa missa <lb xml:id="p1z28"/>excusatione.</s>
					<s n="9" xml:lang="la">Valebis itaque, <persName ref="p495">Bullingere</persName> hum<lb xml:id="p1z29"/>anissime, meque, qui tuum totum pectus amplector, <lb xml:id="p1z30"/>in fraternum amorem christianamque consuet<lb xml:id="p1z31"/>udinem recipe.</s>
					<s n="10" xml:lang="la">Cumque istic in pace sis, <lb xml:id="p1z32"/>nos, qui hic propter evangelium tumultuamur, <lb xml:id="p1z33"/>precibus apud coelestem patrem adiuva.</s>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z34"/>Etiam atque etiam vive et <lb xml:id="p1z35"/>vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Ex <placeName>Iwano<lb xml:id="p1z36"/>wicze</placeName> 18. d[i]e augusti anno 1556.</s>
					<s n="13" xml:lang="de"><lb xml:id="p1z37"/>Der herr <lb xml:id="p1z38"/><persName ref="p1936">Lysmaninus</persName> wil, das ich auch <lb xml:id="p1z39"/>ein mal dteusch schreibe, <lb xml:id="p1z40"/>welches mus zue gelegener zeit geschehen.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Frater <lb xml:id="p1z41"/>in Christo deditissimus <persName ref="p8513">Alexander Vitrelinus</persName>, eccle<lb xml:id="p1z42"/>siae <placeName ref="l957">Pinczoviensis</placeName> minister.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo et doctissimo viro <lb xml:id="p2z2"/>d. <persName ref="p495">Henrico Bullingero</persName>, pastori <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> praeci[p]<lb xml:id="p2z4"/>uo, domino et fratri in [<lb xml:id="p2z5"/>Ch]risto observandissimo.</s>
				</p>
				<p>
					<note>[Darunter von <persName ref="p495">Bullingers</persName> Hand die Bemerkung:]</note>
					<s n="16" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l2472">Polonicae</placeName> literae <lb xml:id="p2z7"/>octobris mense <lb xml:id="p2z8"/>1556.</s>
				</p>
