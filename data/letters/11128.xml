	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Nunc primum apud nos aeditae sunt hae quinque tabulae propositionum<note xml:id="fn1" type="footnote" n="1">Die Drucke, die dem Brief beigegeben waren, konnten nicht identifiziert werden.</note>, <lb xml:id="p1z2"/>quas tibi mittere volui, quia gratas fore sperabam, <lb xml:id="p1z3"/>nec vero in his leviculis solum, sed in qua re cunque potero, <lb xml:id="p1z4"/>tibi lubentissime gratificabor.</s>
					<s n="3" xml:lang="la">Propediem plura scribam.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="farewell"><lb xml:id="p1z5"/>Interim optime vale.</s>
					<s n="5" xml:lang="la">Salvam cupio totam familiam tuam, <lb xml:id="p1z6"/>deinde d. <persName ref="p8127">Pellicanum</persName>, <persName ref="p8171">Theodorum</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p8171">Theodor Bibliander</persName>.</note>, Ammanium, <persName ref="p4554">Collinum</persName>, praeceptores <lb xml:id="p1z7"/>nostros humanissimos.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><placeName ref="l558">Vitebergae</placeName> 1537, 28. decembris.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/><persName ref="p8459">Otho</persName>, tibi obsequentissimus<note xml:id="fna" type="footnote" n="a"><hi>Darunter von der Hand <persName ref="p1628">Johann Heinrich Hottingers</persName></hi> <persName ref="p8459">Werdmyllerus</persName>.</note><lb xml:id="p1z9"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vigilantissimo verbi ministro <lb xml:id="p2z2"/>d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>patri suo plurimum <lb xml:id="p2z4"/>colendo.</s>
				</p>
			</div>
		</body>
	</text>
