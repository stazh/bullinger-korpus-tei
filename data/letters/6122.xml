	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Si literas priores non signavi, inepte admodum et <lb xml:id="p1z2"/>incogitanter plane feci; etsi enim nihil arcani <lb xml:id="p1z3"/>in se continent, tamen molestum esset eas in <lb xml:id="p1z4"/>alienas manus devenire.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Sed, ut scias, binas scripsi, <lb xml:id="p1z5"/>et priores quidem <persName ref="p8114">Balingketus</persName> <placeName ref="l93">Clavennensi</placeName> dedit, <lb xml:id="p1z6"/>qui <placeName ref="l28">Basileam</placeName> per vos proficiscebatur; in illis erat, <lb xml:id="p1z7"/>quid inter <persName>Philippi</persName> legatum et d. <persName ref="p3375">Vergerium</persName> accidisset, <lb xml:id="p1z8"/>in posterioribus, quid famulus <persName ref="p3375">Vergerii</persName> perpetrasset, <lb xml:id="p1z9"/>qui postmodum intercessione nostra liberatus est.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>Fuimus autem authores d. <persName ref="p3375">Vergerio</persName>, ut, quoniam <lb xml:id="p1z11"/>adversa multa haberet, hinc discederet.</s>
					<s n="5" xml:lang="la">Paruit <lb xml:id="p1z12"/>et se quam primum in viam dedit; discedens autem nescio <lb xml:id="p1z13"/>quae de suo ad nos reditu pollicebatur nec <lb xml:id="p1z14"/>intelligit bonus senex, quam ad res agendas nunc <lb xml:id="p1z15"/>sit ineptus et plerisque insuper in his partibus exosus.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z16"/>Si redit, novas de integro turbas concitabit.</s>
					<s n="7" xml:lang="la">- Legatum regi<lb xml:id="p1z17"/>s <placeName ref="l832">Gallici</placeName> nec vidi nec conveni, nec ipse <lb xml:id="p1z18"/>congressus nostros unquam expetivit, quod mihi <lb xml:id="p1z19"/>argumento est eum religioni nostrae non propitium, <lb xml:id="p1z20"/>de quo tamen nihil affirmo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Quae dominis <placeName ref="l893">Trium <lb xml:id="p1z21"/>Foederum</placeName> proposuit, hic mitto.</s>
					<s n="9" xml:lang="la">Tu per occasionem <lb xml:id="p1z22"/>remitte nam nullum exemplar servavi; potes <lb xml:id="p1z23"/>tamen octiduum servare et vestris legenda exhibere.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z24"/>Ego undique sum circumventus; multa mecum ipse disputo, <lb xml:id="p1z25"/>quid sit faciendum.</s>
					<s n="11" xml:lang="la">Unum timeo, ne redeat <persName>Philippi</persName> <lb xml:id="p1z26"/>legatus (quem hic non obscure pungit) et res <lb xml:id="p1z27"/>deinde in nervum erumpat.</s>
					<s n="12" xml:lang="la">- Ad haec mala accedit <lb xml:id="p1z28"/>ecclesię <placeName ref="l93">Clavennensis</placeName> misera et afflicta facie<pb/><lb xml:id="p2z2"/>s.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z3"/>Ecclesia varie est discerpta, utrinque factiones potentissimae.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z4"/>Duo sunt ministri: <persName>Florillus</persName> et <persName ref="p4037">Zanchus</persName>; uterque suas habet <lb xml:id="p2z5"/>partes et quidem alteri infensissimas.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Deum immortalem, <lb xml:id="p2z6"/>quid tandem fiet?</s>
					<s n="16" xml:lang="la">Pestis <placeName ref="l93">Clavennam</placeName> crudeliter infestat <lb xml:id="p2z7"/>et, ut scribit <persName ref="p4037">Zanchus</persName>, media civitas infecta est.</s>
					<s n="17" xml:lang="la">Conciona<lb xml:id="p2z8"/>ntur in publico foro, non intra parietes etc. <lb xml:id="p2z9"/>et ne haec quidem dei tam evidens plaga eos <lb xml:id="p2z10"/>redintegrare potest.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Saepe dubito, an aliquid spiritus sit <lb xml:id="p2z11"/>in istiusmodi hominibus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Audio tamen <persName ref="p4037">Zanchi</persName> mo<lb xml:id="p2z12"/>destiam praedicari, illius vero alterius rigorem et ambitionem <lb xml:id="p2z13"/>reprehendi.</s>
					<s n="20" xml:lang="la">Sed, quod dixi, partes sunt, et suum quaeque <lb xml:id="p2z14"/>doctorem defendit, in alterum invehitur.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Habeo tibi <lb xml:id="p2z15"/>gratias pro novis illis, quae paterne communicas.</s>
					<s n="22" xml:lang="la">Perge nobis <lb xml:id="p2z16"/>manum porrigere, quo facilius ex his omnibus fluctibus <lb xml:id="p2z17"/>eluctari possim.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Deum rogo, ut te nobis diu incolumem conservet.</s>
					<s n="24" xml:lang="la" ana="farewell">Vale, reverende <lb xml:id="p2z18"/>pater.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><placeName ref="l98">Curię</placeName> calendis maii anno 1564.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">T[uus] <persName ref="p8009">F[abricius</persName>].</s>
				</p>
				<p>
					<s n="27" xml:lang="la">Amplissimo viro d. <persName ref="p495">Heinrycho Bullingero</persName>, domino suo et in Christo patri reverendo.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p2z19"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
