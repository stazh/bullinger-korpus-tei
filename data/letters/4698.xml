	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Fasciculum literarum, quem mihi commiseras, <lb xml:id="p1z2"/>ut ad dominum <persName>Redonensem</persName> mitterem, adhuc <lb xml:id="p1z3"/>apud me retinui nec mittam, donec <lb xml:id="p1z4"/>nihil amplius periculi vobis inde i<lb xml:id="p1z5"/>mminere existimavero, quemadmodum <lb xml:id="p1z6"/>in proximis tuis ad me literis petiisti.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Accepimus ex aula ducis <persName ref="p1227">Christophori</persName>, <lb xml:id="p1z8"/>quid electores et principes in proximo <lb xml:id="p1z9"/><placeName>Numbergico</placeName> conventu legato pontificis, <lb xml:id="p1z10"/>qui concilii ergo eo erat profectus, <lb xml:id="p1z11"/>responderint; ea nostrates <lb xml:id="p1z12"/>communicarunt vestris, a quibus tu <lb xml:id="p1z13"/>facile legenda impetrabis; nec enim <lb xml:id="p1z14"/>mihi ad illa denuo rescribenda superfuit <lb xml:id="p1z15"/>tempus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Vix credis, quantum voluptatis <lb xml:id="p1z16"/>inde perceperim, quod principes illos <lb xml:id="p1z17"/>intellexerim tam aperte iisdem uti <lb xml:id="p1z18"/>argumentis contra papistica illa concilia, <lb xml:id="p1z19"/>quibus tu usus es in tuo de conciliis <lb xml:id="p1z20"/>libello, adeo ut maxime sperandum, <lb xml:id="p1z21"/>quod non parum fructus inde multi <lb xml:id="p1z22"/>sint percepturi, cum consensus animorum <lb xml:id="p1z23"/>ut in aliis rebus, maxime tamen in reli<lb xml:id="p1z24"/>gionis negotio altas agat radices ac propag<lb xml:id="p1z25"/>etur.</s>
					<s n="5" xml:lang="la" ana="salute">Domin<lb xml:id="p1z26"/>o <persName ref="p8011">Rodolpho</persName>, amico veteri, meis verbis <lb xml:id="p1z27"/>salutem dicito.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Iterum vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l441">Schaphusiae</placeName> <lb xml:id="p1z28"/>8. martii anno 1561.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z29"/>Tuus ex animo <persName ref="p2553">Martinus Peyer</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, sacrarum <lb xml:id="p2z3"/>literarum in ecclesia <placeName ref="l587">Tigurinorum</placeName> <lb xml:id="p2z4"/>doctori, domino et amico suo <lb xml:id="p2z5"/>plurimum colendo<lb xml:id="p2z7"/>.</s>
				</p>
			</div>
		</body>
	</text>
