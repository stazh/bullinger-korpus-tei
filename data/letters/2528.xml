	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Diuturniore silentio et praeter morem et voluntatem usus sum, quod <lb xml:id="p1z2"/>tabellionum copia destituerer; neque enim ullus praeter hunc praesentium latorem se <lb xml:id="p1z3"/>mihi obtulit eoque magis gavisus sum, cum obtingeret.</s>
					<s n="3" xml:lang="la">De <placeName ref="l294">Locarnensibus</placeName> <lb xml:id="p1z4"/>plane tibi tuisque subscribo neque dubito, quin reliquae civitates alieno delicto <lb xml:id="p1z5"/>se ipsos illigarint; neque enim vel species consensionis minima ex portione <lb xml:id="p1z6"/>admitti debuit, ubi de religionis subversione agitur, neque facienda sunt [<lb xml:id="p1z7"/>vel] per dissimulationem mala, ut bona aut minus mala eveniant.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">[<lb xml:id="p1z8"/>Dominus] ergo vestros confirmet nostros zoelo sui amoris ardentiore inflammet.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Quid nunc agatur cum optimis fratribus, scire cupio.</s>
					<s n="6" xml:lang="la">Pro scrip<lb xml:id="p1z10"/>to c<lb xml:id="p1z11"/>ommunicato summam arbitrariae sententiae complectente et epistola <persName>Philippi</persName> ad <persName ref="p540">Calvinum</persName> gratias ago vicis<lb xml:id="p1z12"/>sim tibi communicaturus, si quid lectu dignum accepero.</s>
					<s n="7" xml:lang="la"><placeName ref="l822">Germania</placeName> etiamnum urget <placeName ref="l18">Augustana</placeName> <lb xml:id="p1z13"/>comitia, et sunt, qui iam regem <persName ref="p18477">Ferdinandum</persName> et <persName ref="p1546">Christophorum</persName>, ducem <lb xml:id="p1z14"/><placeName ref="l572">Virtembergensem</placeName>, eo concessisse affirment; alii negant et per <placeName ref="l2510">Turcae</placeName> <lb xml:id="p1z15"/>in <placeName ref="l869">Transsylvaniam</placeName> irruptiones <persName ref="p18477">Ferdinandum</persName> detineri.</s>
					<s n="8" xml:lang="la">Pontifex Romanus feudum <lb xml:id="p1z16"/>ducatus <placeName ref="l306">Mediolanensis</placeName> <persName ref="p18575">Philippo</persName> regi concessit et confirmavit.</s>
					<s n="9" xml:lang="la">In <placeName ref="l2801">Cor<lb xml:id="p1z17"/>sica</placeName> <persName>Gallus</persName> valde premere dicitur hostem et commeatus vim ingentem <lb xml:id="p1z18"/><placeName ref="l1176">Massiliam</placeName> convexisse, in <placeName ref="l736">Pedemontio</placeName> copias augere, nimirum ut mole belli <lb xml:id="p1z19"/>versus <placeName ref="l834">Italiam</placeName> conversa Senas obsidione liberet.</s>
					<s n="10" xml:lang="la">Franciscani apud Gallos <lb xml:id="p1z20"/>nuper virginem nobilem, cum locum et horam in ipsorum templum destinav<lb xml:id="p1z21"/>erat <lb xml:id="p1z22"/>iuvenis quidam de matrimonio cum ea secreto collocuturus, abripuisse <lb xml:id="p1z23"/>dicuntur, eaque cum tribus noctibus essent abusi, interemptam in templo eo <lb xml:id="p1z24"/>sepelivisse, animadversum autem facinus a quodam, qui ea ipsa nocte in tem<lb xml:id="p1z25"/>plo conclusus erat, divina nimirum providentia, cum in vespertinis precibu<lb xml:id="p1z26"/>s <lb xml:id="p1z27"/>obdormivisset, ac cum sibi metuens in angulo se continuisset, diluculo <lb xml:id="p1z28"/>reseratis portis rem ad magistratus illico detulisse atque ita correptos <lb xml:id="p1z29"/>monachos ad palos esse condemnatos, sed quia provocaverunt ab eorum <lb xml:id="p1z30"/>iudicum sententia <placeName ref="l378">Lutetiam</placeName> duobus curribus deportatos esse, <pb/><lb xml:id="p2z1"/>ut a parlamento iudicentur.</s>
					<s n="11" xml:lang="la" ana="farewell">Sed vale in domino cum tuis omnibus.</s>
					<s n="12" xml:lang="la"><placeName ref="l28">B[asil<lb xml:id="p2z2"/>eae]</placeName> 12. ianuarii anno 1555.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z3"/>T[uus] <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
