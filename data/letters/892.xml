	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>.
					<lb xml:id="p1z2"/>fromm vest, ersam
					<lb xml:id="p1z3"/>ürsichtig und wyse
					<lb xml:id="p1z4"/>günstige liebeher
					<lb xml:id="p1z5"/>Unser willig dienst
					<lb xml:id="p1z6"/>liebs und guͦts beny
					<lb xml:id="p1z7"/>vi
					<lb xml:id="p1z8"/>köndend sye üch bevor. Der
					<lb xml:id="p1z9"/>h fridln käller pfarrer
					<lb xml:id="p1z10"/>künlung unser lieber bruͦder hat uns be
					<lb xml:id="p1z11"/>wie uwere schil zuͦ bischoffhck
					<lb xml:id="p1z12"/>diser zyt ledig ßb ir eines anderen
					<lb xml:id="p1z13"/>aori
					<lb xml:id="p1z14"/>schulmeisters nodtwendig fynd, da
					<lb xml:id="p1z15"/>er gantz vertröster hoffnung sye die
					<lb xml:id="p1z16"/>wyl er ein kend von bischoffhell und
					<lb xml:id="p1z17"/>sich bäßhar dermassen gehallten, das sin
					<lb xml:id="p1z18"/>vatterland sinen gar kein vewyssen
					<lb xml:id="p1z19"/>furohin, ob gott wil haben
					<lb xml:id="p1z20"/>geheptn
