	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino, frater charissime.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">An libelli <persName ref="p1974">Lutheri</persName> <placeName ref="l558">Witembergę</placeName><note xml:id="fna" type="footnote" n="a"><placeName ref="l558">Witembergae</placeName> <hi>über der Zeile nachgetragen.</hi></note> suppressi sint,<note xml:id="fn1" type="footnote" n="1">Zu dieser Nachricht siehe oben <ref target="file12127">Nr. 2080</ref>, 21-23 und Anm. 10.</note> a tabellione <lb xml:id="p1z2"/><placeName ref="l558">Witembergensi</placeName><note xml:id="fn2" type="footnote" n="2">Unbekannt. Er war offenbar via <placeName ref="l587">Zürich</placeName> und <placeName ref="l648">Graubünden</placeName> nach <placeName ref="l834">Italien</placeName> gesandt; s. unten <ref target="file12136">Nr. 2089</ref>.</note> expiscari poteris.</s>
					<s n="3" xml:lang="la"><placeName ref="l18">Augustanos</placeName> prohibuisse certum est<note xml:id="fn3" type="footnote" n="3">Siehe oben <ref target="file12127">Nr. 2080</ref>, 23f und Anm. 11.</note>.</s>
					<s n="4" xml:lang="la">De impressore<note xml:id="fn4" type="footnote" n="4">Unbekannt.</note> <lb xml:id="p1z3"/><placeName ref="l491">Argentinensi</placeName> historiam<note xml:id="fn5" type="footnote" n="5">Die Begebenheit, die <persName ref="p1278">Gast</persName> <persName ref="p495">Bullinger</persName> in seinem Brief vom 9. Februar 1545 mitgeteilt hatte; s. oben <ref target="file12127">Nr. 2080</ref>, 25-30.</note> accepi ab eo<note xml:id="fn6" type="footnote" n="6">Unbekannt.</note>, qui vidit, qui hominem<note xml:id="fn7" type="footnote" n="7">Unbekannt.</note> ad annos aliquot no<lb xml:id="p1z4"/>vit.</s>
					<s n="5" xml:lang="la"><persName ref="p18593">Turcam</persName><note xml:id="fn8" type="footnote" n="8">Sultan <persName ref="p18593">Suleiman I.</persName></note> in expeditione esse, <placeName ref="l1074">Budam</placeName> in regiam sedem elegisse constans spargit <lb xml:id="p1z5"/>fama,<note xml:id="fn9" type="footnote" n="9">Ein Gerücht, denn <persName ref="p18593">Suleiman</persName> befand sich zu dieser Zeit in <placeName ref="l1517">Edirne</placeName>; s. oben <ref target="file12118">Nr. 2071</ref>, Anm. 30.</note> et ab ipso nuntio id etiam hauries.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Expectamus tuam Responsionem<note xml:id="fn10" type="footnote" n="10">Das "Warhaffte Bekanntnuß"der <placeName ref="l587">Zürcher</placeName>, das kurz vordem 12. März 1545 erschien; s. oben <ref target="file12108">Nr. 2061</ref>, Anm. 9.</note> <lb xml:id="p1z6"/>quam commodissime.</s>
					<s n="7" xml:lang="la">Si absoluta est, <placeName ref="l558">Witembergensi</placeName> tabellioni dabis <persName ref="p1974">Luthero</persName> per<lb xml:id="p1z7"/>ferendam.</s>
					<s n="8" xml:lang="la">Non credis, quantum gaudium papistę habeant ob <persName ref="p1974">Lutheri</persName> libellum<note xml:id="fn11" type="footnote" n="11"><persName ref="p1974">Luthers</persName> "Kurtz Bekentnis"; s. oben <ref target="file12108">Nr. 2061</ref>, Anm. 7.</note>; <lb xml:id="p1z8"/>gloriantur et iactant victoriam<pb type="edition" next="138"/> ante pugnam<note xml:id="fn12" type="footnote" n="12">Vgl. Adagia, 1, 7, 55 (<bibl>ASD</bibl> II/2 180, Nr. 655).</note>.</s>
					<s n="9" xml:lang="la">Cave, ne <persName ref="p467">Bucerus</persName> tibi et <persName ref="p8171">Theodoro</persName><note xml:id="fn13" type="footnote" n="13"><persName ref="p8171">Theodor Bibliander</persName>.</note> <lb xml:id="p1z9"/>nostro oculos sua loquacitate fascinet, quominus id, quod ad defensionem <lb xml:id="p1z10"/>attinet, scribatis.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Novi illius animum; habet spiritum valde tristem ac depressum; timet, <lb xml:id="p1z11"/>ne pars huius tragędiae fiat.</s>
					<s n="11" xml:lang="la">Apparet iam, qualis concordia cum nostris ecclesiis instituta <lb xml:id="p1z12"/>sit.</s>
					<s n="12" xml:lang="la">Pergite itaque forti spiritu<note xml:id="fn14" type="footnote" n="14">Vgl. z.B. <cit type="bible"><ref>2Tim 4, 7</ref></cit>.</note> et constanti.</s>
					<s n="13" xml:lang="la">Dominus auxilio suo aderit, sapienti<lb xml:id="p1z13"/>am veram suppeditabit ex panoplia<note xml:id="fn15" type="footnote" n="15">Vgl. <cit type="bible"><ref>Eph 6, 11. 13</ref></cit>; und schon oben <ref target="file12126">Nr. 2079</ref>, Anm. 9.</note> divinę scripturę, ut hunc <persName ref="p1974">Goliath</persName><note xml:id="fn16" type="footnote" n="16">Gemeint ist <persName ref="p1974">Luther</persName>.</note> primo <lb xml:id="p1z14"/>ictu in terram prosternatis,<note xml:id="fn17" type="footnote" n="17">Vgl. <cit type="bible"><ref>1Sam 17</ref></cit>.</note> imo usque ad inferos detrudatis, si se victum dare et <lb xml:id="p1z15"/>herbam porrigere<note xml:id="fn18" type="footnote" n="18">Vgl. Adagia, 1, 9, 78 (<bibl>ASD</bibl> II/2 394, Nr. 878).</note> noluerit.</s>
					<s n="14" xml:lang="la">Dominus nos ita probat, nostram fidem et constantiam <lb xml:id="p1z16"/>exercet.</s>
					<s n="15" xml:lang="la">Aderit ipse ac praecedit nos,<note xml:id="fn19" type="footnote" n="19">Vgl. <cit type="bible"><ref>Ex 13, 21</ref></cit> und passim.</note> quo omnia mala commodius superare possimus.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z17"/>Si enim deus pro nobis, quis contra nos<note xml:id="fn20" type="footnote" n="20">Rm 8, 31.</note>?</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Vale in domino et d. <persName ref="p8171">Theodorum</persName> <lb xml:id="p1z18"/>nomine meo salutabis, quem scio iam occupatissimum esse; alias illi scripsissem <lb xml:id="p1z19"/>proprias literas.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z20"/>Naves tres heri ad nos venerunt ab <placeName ref="l491">Argentina</placeName> expansis velis tritico plenae<note xml:id="fnb" type="footnote" n="b"><hi>In der Vorlage</hi> plenas, <hi>das in Eile aus</hi> pienis <hi>korrigiert wurde.</hi></note><lb xml:id="p1z21"/>, quem senatus noster emit, quo civibus succurrat, qui inopia laborant<note xml:id="fn21" type="footnote" n="21"><persName ref="p1278">Gast</persName> hatte schon im Juli 1544 von einer Teuerung in <placeName ref="l28">Basel</placeName> geschrieben, gegen die der <placeName ref="l28">Basler</placeName> Rat Abhilfe zu schaffen suchte; s. <bibl source="b17">HBBW XIV</bibl>, <ref target="file11989">Nr. 1942</ref>, 16-20. Diese Teuerung war durch einen Kornmangel verursacht; s. die Angaben dazu aus Dezember 1544, April und Juni 1545 in <bibl source="b197">EA</bibl> IV/Id 433 a. 439 s. 472 e. 488 j; und <hi><persName ref="p1278">Gast</persName>,</hi> Tagebuch 214f und Anm. 2.</note>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Navis <lb xml:id="p1z22"/>quęlibet saccos habuit centum.</s>
				</p>
				<p>
					<s n="20" xml:lang="de">Die bauren ins <placeName ref="l3548">merckgrafen landt</placeName><note xml:id="fn22" type="footnote" n="22">Das <placeName ref="l3548">Markgräflerland</placeName> im Südwesten <placeName ref="l572">Württembergs</placeName> an der Grenze zu <placeName ref="l832">Frankreich</placeName> und der <placeName ref="l862">Schweiz</placeName>, damals zur <placeName ref="l3409">Markgrafschaft Baden</placeName> gehörend; es umfasste die Herrschaften <placeName ref="l434">Rötteln</placeName> und <placeName ref="l2149">Badenweiler</placeName> sowie die <placeName ref="l2150">Landgrafschaft Sausenberg</placeName>.</note> muͤssen <lb xml:id="p1z23"/>alle harnisch<note xml:id="fn23" type="footnote" ana="lex" n="23">Rüstung.</note> kouffen; lassen fenlin<note xml:id="fn24" type="footnote" ana="lex" n="24">Feldzeichen.</note> machen, die mann inen vorhin im bauren<lb xml:id="p1z24"/>krieg genomen hatt.</s>
					<s n="21" xml:lang="la">Dissidium habent cum <placeName ref="l572">Wirtembergensi</placeName> <persName ref="p9708">Udalrico</persName><note xml:id="fn25" type="footnote" n="25">Herzog <persName ref="p9708">Ulrich von Württemberg</persName>.</note>.</s>
					<s n="22" xml:lang="la">Idem faciunt <lb xml:id="p1z25"/>rustici in <placeName ref="l632">Alsatia</placeName> et <placeName ref="l2836">Sungavia</placeName><note xml:id="fn26" type="footnote" n="26"><placeName ref="l2836">Sundgau</placeName> (Landschaft im <placeName ref="l632">Elsass</placeName>, <placeName ref="l2894">Dép. Haut-Rhin</placeName>, <placeName ref="l832">Frankreich</placeName>).</note> propter <placeName ref="l875">Hispanos</placeName>, qui in <placeName ref="l691">Lotharingia</placeName> quęque obvia ra<lb xml:id="p1z26"/>piunt ac devastant<note xml:id="fn27" type="footnote" n="27">Vgl. oben <ref target="file12115">Nr. 2068</ref>, 11-16; und <bibl source="b197">EA</bibl> IV/Id 457f g.</note>.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Dux <persName ref="p1546">Christophorus Wirtembergensis in Mompelgart</persName><note xml:id="fn28" type="footnote" n="28">Graf <persName ref="p1546">Christoph von Württemberg</persName> hatte seit 1542 die Grafschaft <placeName ref="l327">Mömpelgard</placeName> als Statthalter inne.</note> proscripsit <lb xml:id="p1z27"/>contionatorem <persName ref="p4338">Panthaleonem Blasium</persName><note xml:id="fn29" type="footnote" n="29"><persName ref="p4338">Pantaleon Blasius</persName> war eigentlicher Hofprediger bzw. Prediger der <placeName ref="l822">deutschen</placeName> Pfarrei in <placeName ref="l327">Mömpelgard</placeName>; s. <bibl source="b17">HBBW XIV</bibl>, <ref target="file12051">Nr. 2004</ref>, Anm. 8.</note>, eo quod noluit consentire cum altero <persName ref="p18126">contionatore</persName><note xml:id="fn30" type="footnote" n="30"><persName ref="p18126">Johann(es) Engelmann</persName>; s. <bibl source="b17">HBBW XIV</bibl>, <ref target="file12051">Nr. 2004</ref>, Anm. 8.</note><pb type="edition" next="139"/> in <lb xml:id="p1z28"/>negotio eucharistię et aliis ceremoniis externis, quas dux subinde mutat, <lb xml:id="p1z29"/>quo tandem totum papatum invehat<note xml:id="fn31" type="footnote" n="31">Siehe dazu <bibl source="b17">HBBW XIV</bibl>, <ref target="file12051">Nr. 2004</ref>, Anm. 8; <bibl source="b657">Viénot</bibl> 1137, Nr.23 (<persName ref="p6820">Pierre Toussain</persName> an den Rat von Herzog <persName ref="p9708">Ulrich von Württemberg</persName>, <placeName ref="l28">Basel</placeName>, [Juli] 1545). <persName ref="p4338">Blasius</persName> wurde unter Graf <persName ref="p18576">Philipp IV. von Hanau-Lichtenberg</persName> Pfarrer in <placeName ref="l3549">Pfaffenhoffen</placeName> (<placeName ref="l3230">Dép. Bas-Rhin</placeName>, <placeName ref="l832">Frankreich</placeName>) und Superintendent der Grafschaft <placeName ref="l2093">Hanau-Lichtenberg</placeName>; s. Timotheus Wilhelm <hi>Röhrich,</hi> Mittheilungen aus der Geschichte der evangelischen Kirche des Elsasses, Bd. 2, Paris/Straßburg 1855, S. 70f; Ludwig Albert <hi>Kiefer,</hi> Pfarrbuch der Grafschaft Hanau-Lichtenberg. Nach Urkunden, Straßburg 1890, S. 295, Nr. 1; <hi>Bopp</hi> I 64, <ref target="file10467">Nr. 432</ref>. Zur Situation der Kirche in Mömpelgard s. <hi>leyd</hi> III 144-157.</note>.</s>
					<s n="24" xml:lang="la"><persName ref="p6820">Petrus Tussanus</persName>, contionator <placeName ref="l832">Gallicus</placeName>, paraly<lb xml:id="p1z30"/>si laborat<note xml:id="fn32" type="footnote" n="32">Vgl. <bibl>CO</bibl> XII 94: "<persName ref="p6820">Tossanus</persName> quasi frangitur plebis moribus et principis importunitate" (<persName ref="p1049">Farel</persName> an <persName ref="p540">Calvin</persName>, 14. Juni 1545). Bald darauf verließ <persName ref="p6820">Toussain</persName> <placeName ref="l327">Mömpelgard</placeName> für einige Wochen; s. <hi>Viénot,</hi> 1112-116; II 37.</note>.</s>
					<s n="25" xml:lang="la">Tristitia, quam conceperat ob principum<note xml:id="fn33" type="footnote" n="33">Damit sind <persName ref="p1546">Christoph</persName> und <persName ref="p9708">Ulrich von Württemberg</persName> gemeint.</note> abalienatum animum in religionem <lb xml:id="p1z31"/>synceram, in causa fuit huius morbi.</s>
				</p>
				<p>
					<s n="26" xml:lang="la" ana="farewell">Vale iterum atque iterum et ora pro eccles<lb xml:id="p1z32"/>ia nostra.</s>
					<s n="27" xml:lang="la"><placeName ref="l28">Basileę</placeName>, 25. februarii <lb xml:id="p1z33"/>1545.</s>
				</p>
				<p>
