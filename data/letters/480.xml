	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Gratiam et pacem a Domino.</s>
					<s n="3" xml:lang="la">Obtempero jussui tuo D. <lb xml:id="p1z2"/>ac compater colendissime, quod de itineris nostri progressu <lb xml:id="p1z3"/>facio te semper certiorem.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><placeName ref="l491">Argentinam</placeName> venimus 29. die mensis Martii, <lb xml:id="p1z4"/>omnes salvi et incolumes, Dei beneficio <lb xml:id="p1z6"/>et gratia: hic nobis sistendum opinor ad tertium diem <lb xml:id="p1z7"/>Aprilis, ut nos adjungamus bonis ac probis comitibus, <lb xml:id="p1z8"/>qui ad nundinas jam proficiscuntur.</s>
					<s n="5" xml:lang="la">Obstat itineri etiam <lb xml:id="p1z9"/>aliqua ex parte filiolę nostrę <persName ref="p21204">Rahelis</persName> morositas: crescunt <lb xml:id="p1z10"/>dentes, et aeris afflatus duplicant nascentis morbi <lb xml:id="p1z11"/>molestias.</s>
					<s n="6" xml:lang="la">Quę feruntur de <persName ref="p8374">Hedione</persName>, credo non esse <lb xml:id="p1z12"/>vera.</s>
					<s n="7" xml:lang="la">30 die Martii interfui lectioni illius, quę <lb xml:id="p1z13"/>erat ex x capite ad Romanos.</s>
					<s n="8" xml:lang="la">Candide satis <lb xml:id="p1z14"/>de dignitate verbi Dei et aperte multa dixit, et <lb xml:id="p1z15"/>admonuit suos auditores, ut ab Interdeneti lenociniis <lb xml:id="p1z16"/>diligentissime caverent.</s>
					<s n="9" xml:lang="la">Nimio terrore et metu, <lb xml:id="p1z17"/>non odio, puto esse com[m]issum, quicquid commissum.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Non deest ei pietas, sed adversum Cęsarem <lb xml:id="p1z19"/>nimium extimescit.</s>
					<s n="11" xml:lang="la">Eodem die interfui concioni <lb xml:id="p1z20"/>vespertinę: inter cętera concionata (quod <lb xml:id="p1z21"/>egre audieram) magno stomacho insulse <lb xml:id="p1z22"/>invehebat in <persName>Swermeros</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Dominus ei ignoscat, <lb xml:id="p1z23"/>et det ei mentem meliorem.</s>
					<s n="13" xml:lang="la"><persName ref="p4744">Paulus Fagius</persName> <lb xml:id="p1z25"/>discessit ante adventum nostrum.</s>
					<s n="14" xml:lang="la"><persName ref="p467">Bucerus</persName> credo <lb xml:id="p1z26"/>hac nocte discedet, quo nescio adhuc.</s>
					<s n="15" xml:lang="la">Vocatus <lb xml:id="p1z27"/>est in <placeName ref="l830">Angliam</placeName>, in <placeName ref="l2472">Poloniam</placeName>, et in <placeName ref="l749">Saxoniam</placeName>.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z28"/>Ex[c]epit me heri convivio, ubi invenimus <lb xml:id="p1z29"/><persName ref="p3088">Jo. Sturmium</persName>, <persName ref="p6368">Sapidum</persName>, <persName ref="p8121">Christopherum Montium</persName>.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z30"/>Valde grata illis erat Helvetiorum concordia, <lb xml:id="p1z31"/>quam Dominus semper ratam ac firmam velit esse <lb xml:id="p1z32"/>precor.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">Ego, uxor, <persName ref="p21204">Rahel</persName>, <persName>Joanna</persName> tuam charitatem, <lb xml:id="p1z33"/>ac totius familię tuę incolumitatem, ac omnium <lb xml:id="p1z34"/>aliorum vestrę ecclesię pientissimorum ministrorum <lb xml:id="p1z35"/>salutem, Deo Opt.</s>
					<s n="19" xml:lang="la" ana="salute">Max. que sedulo nostris precibus <lb xml:id="p1z36"/>commendamus, quos omnes vere et ex animo salutamus.</s>
					<s n="20" xml:lang="la" ana="farewell"><lb xml:id="p1z37"/>Vale, vir praestantissime ac mihi semper colendissime.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z38"/><placeName ref="l491">Argentinę</placeName> ultimo Martii.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z39"/>Tui obsequentissimus, <lb xml:id="p1z40"/><persName ref="p1560">Jo. Hoperus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro D. <persName ref="p495">Heinrico <lb xml:id="p2z2"/>Bullingero</persName>, domino et <lb xml:id="p2z3"/>amico suo colendissimo.</s>
				</p>
			</div>
		</body>
