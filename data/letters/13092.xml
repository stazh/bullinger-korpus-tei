	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p396">Ioannes Blasius</persName> d. <persName ref="p495">Bullingero</persName> suo <lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">Nihil ex <placeName ref="l834">Italia</placeName> novarum est rerum, vir in domino prestantissime, <lb xml:id="p1z3"/>nisi quod exercitus caesaris<note xml:id="fn14" type="footnote" n="14"><persName ref="p18538">Karl V.</persName></note> cottidie augetur novorum <lb xml:id="p1z4"/>militum conscripcione atque inter <placeName ref="l1122">Parmam</placeName> et <placeName ref="l1161">Pla<lb xml:id="p1z5"/>cenciam</placeName> castrametatur<note xml:id="fn15" type="footnote" n="15">castrametari: das Lager aufschlagen; s. <bibl source="b173">Dasypodius, Dict.</bibl> 26v.</note>.</s>
					<s n="3" xml:lang="la">Nos vero speramus dominum (eo medio) <placeName ref="l822">Ger<lb xml:id="p1z6"/>maniam</placeName> <placeName ref="l875">Hyspanis</placeName> tyrannis liberaturum, quandoquidem <placeName ref="l2582">Veld<lb xml:id="p1z7"/>kirchii</placeName> hisce diebus quidam ex caesareis <placeName ref="l822">Germanicum</placeName> cepi<lb xml:id="p1z8"/>t conscribere exercitum et eundem nominatim in <placeName ref="l834">Italiam</placeName> <lb xml:id="p1z9"/>ducturus<note xml:id="fna" type="footnote" n="a"><hi>In der Vorlage</hi> ducturum.</note>.</s>
					<s n="4" xml:lang="la">Interea si quid scitu dignum ad nos deferetur, <lb xml:id="p1z10"/>te per literas diligenter admonebo, et si et hec duo ad <lb xml:id="p1z11"/>nos ex <placeName ref="l834">Italia</placeName> pro vero sint allata.</s>
					<s n="5" xml:lang="la">Nempe 40 <placeName ref="l875">Hyspani</placeName><note xml:id="fnb" type="footnote" n="b"><hi>In der Vorlage</hi> Hyspanos.</note> <lb xml:id="p1z12"/>indutis minoritarum cucullis principem <placeName ref="l1122">Parmanensem</placeName><note xml:id="fn16" type="footnote" n="16"><persName ref="p4758">Pièr Luigi Farnese</persName>, Herzog von <placeName ref="l1122">Parma</placeName> und <placeName ref="l1161">Piacenza</placeName>.</note> <lb xml:id="p1z13"/>nixi sunt suis cum dolis, tum technis <placeName ref="l875">Hyspanicis</placeName> interficere, <lb xml:id="p1z14"/>sed in eam ipsi, quam foderunt, ceciderunt foveam,<note xml:id="fn17" type="footnote" n="17">Vgl. <cit type="bible"><ref>Ps 57 (Vulg. 56), 7</ref></cit>.</note> <lb xml:id="p1z15"/>hoc est, plecti sunt capite.</s>
					<s n="6" xml:lang="la">Alterum est <persName ref="p18164">caesarem legatum</persName><note xml:id="fn18" type="footnote" n="18"><persName ref="p18164">Juan Figueroa</persName>.</note> <lb xml:id="p1z16"/>ad <persName ref="p19981">papam</persName><note xml:id="fn19" type="footnote" n="19"><persName ref="p19981">Paul III.</persName></note> eius <persName ref="p4758">filium</persName><note xml:id="fn20" type="footnote" n="20"><persName ref="p4758">Pièr Luigi Farnese</persName>.</note> condolendi gracia misisse, quem <lb xml:id="p1z17"/>papa mox laqueo suspendisse fertur, etc.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z18"/>Proinde discordiam illam inter d. <persName ref="p2019">Augustinum</persName><note xml:id="fn21" type="footnote" n="21"><persName ref="p2019">Agostino Mainardi</persName>.</note> et <persName ref="p2807">Camillum</persName><note xml:id="fn22" type="footnote" n="22"><persName ref="p2807">Camillo Renato</persName>.</note>, <placeName ref="l93">Cla<lb xml:id="p1z19"/>venensis</placeName> ecclesię<note xml:id="fn23" type="footnote" n="23"><placeName ref="l93">Chiavenna</placeName>.</note> ministros, de qua proximis in literis ad te<note xml:id="fn24" type="footnote" n="24">Brief <ref target="file13065">Nr. 3016</ref> vom 20. September.</note> scripsi, <lb xml:id="p1z20"/>egerrime ferimus, quam videmus a sathana esse excitatam <lb xml:id="p1z21"/>ad conturbandam ecclesiam nostram.</s>
					<s n="8" xml:lang="la">Quid putas nobis faciundum?</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z22"/>Num tacendum?</s>
					<s n="10" xml:lang="la">Num in ecclesia hoc in doctrina dissidium ferendum?</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z23"/>Unus<note xml:id="fn25" type="footnote" n="25"><persName ref="p2019">Mainardi</persName>.</note> asserit promissa dei sacramentis quodammodo <lb xml:id="p1z24"/>confirmari; alter<note xml:id="fn26" type="footnote" n="26"><persName ref="p2807">Renato</persName>.</note> constantissime negat, etc.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z25"/>Tuum ergo fuerit (doctissime <persName ref="p495">Bullingere</persName>), nobis ad suppri<lb xml:id="p1z26"/>mendam hanc inanem verborum contencionem, et consilium et <lb xml:id="p1z27"/>auxilium tuum prebere.</s>
					<s n="13" xml:lang="la">Citavimus enim utrosque ad futuram <lb xml:id="p1z28"/>nostram synodum, que dicta est proximis post divi Martini<note xml:id="fn27" type="footnote" n="27">11. November.</note> diebus, <lb xml:id="p1z29"/>qua utrique, quo contencionis sue racionem reddat, iniungetur.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z30"/>Postremo miramur quoque, quo in statu sint res ecclesiarum <placeName ref="l822">Ger<lb xml:id="p1z31"/>manicarum</placeName>, num <persName ref="p8018">Hallerus</persName> vester adhuc <placeName ref="l18">Augustę</placeName> concionetur, quove <lb xml:id="p1z32"/>pervenerit d. <persName ref="p2095">Philippus Melanchthon</persName>.</s>
					<s n="15" xml:lang="la">Hic sparserat incertus tamen rumor <lb xml:id="p1z33"/>eundem <placeName ref="l28">Basileam</placeName> vocatum iri, etc.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="16" xml:lang="la" ana="farewell">De his omnibus, si tibi non vacat, <lb xml:id="p1z34"/>commendabis <persName ref="p20482">Paulo</persName><note xml:id="fn28" type="footnote" n="28"><persName ref="p20482">Paulus Blasius</persName>.</note>, ut respondeat, ac vale.</s>
					<s n="17" xml:lang="la">Raptim, <placeName ref="l98">Curie</placeName>, 16. <lb xml:id="p1z35"/>kalendas novembris, anno 1547.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z36"/>Idem tuus ex animo, ibidem apud <pb/><lb xml:id="p2z1"/><placeName ref="l98">Curie[nses]</placeName></s>
				</p>
				<p>
					<s n="19" xml:lang="he">קה<lb xml:id="p2z2"/>לת</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="20" xml:lang="la"><lb xml:id="p2z3"/>Ornatissimo viro d. <persName ref="p495">H. <lb xml:id="p2z4"/>Bullinger</persName>o, amplissimę <lb xml:id="p2z5"/>ecclesię <placeName ref="l587">Tigurine</placeName> antistiti <lb xml:id="p2z6"/>vigilantissimo, d. <lb xml:id="p2z7"/>suo colendissimo, etc.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>