	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia domini tecum.</s>
					<s n="2" xml:lang="la">non opus est, frater in Christo <lb xml:id="p1z2"/>observandissime, pluribus significare ecclesię nostrorumque <lb xml:id="p1z3"/>omnium statum; nam te audisse haec ex nostro illo, <lb xml:id="p1z4"/>qui superioribus diebus apud te fuit, non dubito.</s>
					<s n="3" xml:lang="la">Reli<lb xml:id="p1z5"/>qua <persName>Heinius</persName> noster, nisi fuerit elinguis, pronuntiabit.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Verum ut summam teneas, brevibus hęc ex me.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Satan non cessat in istis, qui rerum potiuntur, etiam in <lb xml:id="p1z8"/>Nostro illo, sed urget, ut quamprimum <persName ref="p18538">Caesaris</persName> <lb xml:id="p1z9"/>Interim nobis ablegatis pacifice ac maximis <lb xml:id="p1z10"/>pollicitationibus ecclesiis obtrudatur, miris certe <lb xml:id="p1z11"/>et dolosis technis.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">O mores, o tempora.</s>
					<s n="7" xml:lang="la">Vere <lb xml:id="p1z12"/>dixit ille: "Maledictus, qui confidit in homine" etc. <lb xml:id="p1z13"/>atque alius: "Omnibus in aulis tenet insipientia sceptra; <lb xml:id="p1z14"/>illius et sequitur regia turba pedes."</s>
					<s n="8" xml:lang="la">Hinc merito <lb xml:id="p1z15"/>in seniorem illum ducem, qui tot animas seducit, ex<lb xml:id="p1z16"/>clamare licebit: "Conspiratio, conspiratio."</s>
					<s n="9" xml:lang="la">Orate <lb xml:id="p1z17"/>pro nobis sine intermissione, optimi fratres, ne defitiat <lb xml:id="p1z18"/>fides nostra etc.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/>Synodum impiissimam <placeName>Tabernę</placeName> actam audisti, opinor, <lb xml:id="p1z20"/>ab aliis.</s>
					<s n="11" xml:lang="la"><persName>Episcopus Eras[mus]</persName> a duobus suffraganeis ceromate <lb xml:id="p1z21"/>episcopali delibutus in festo Annunciationis.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/>D. Marię missarum primitias Satanę obtulit, <lb xml:id="p1z23"/>quibus synodus celeberrima sequuta multorum <lb xml:id="p1z24"/>pręlatorum, ut vocant, insolita pompa.</s>
					<s n="13" xml:lang="la">Quattuor <lb xml:id="p1z25"/>ex abbatibus electi, qui sint hęretice pravitatis <lb xml:id="p1z26"/>exquisitores, inter quos tyr<lb xml:id="p1z27"/>annus ille abbas in <placeName>Schotteren</placeName>, <persName>Rudolphus <lb xml:id="p1z28"/>Garb</persName>, princeps erit, reformator ecclesiarum in <lb xml:id="p1z29"/><placeName ref="l632">Alsatia</placeName>.</s>
					<s n="14" xml:lang="la"><placeName ref="l491">Argentoratenses</placeName> nihil aliud expectant quam <lb xml:id="p1z30"/>missastas iamque dudum sacrificassent, si vulgi <lb xml:id="p1z31"/>tumultum non metuissent; in choro summi templi <lb xml:id="p1z32"/>parantur omnia etc.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Comes a <placeName ref="l2313">Hanau</placeName> urgenti episcopo necdum cessit, <lb xml:id="p2z2"/>sed suos ministros tutatur pro virili nec <lb xml:id="p2z3"/>vult etiam infimum ablegare, nisi episcopus substituat <lb xml:id="p2z4"/>interimisticos pfaffones.</s>
					<s n="16" xml:lang="la">idem facit et <lb xml:id="p2z5"/><persName>dux Bipohtinus</persName> etc.</s>
					<s n="17" xml:lang="la">Hęc de nostris.</s>
					<s n="18" xml:lang="la"><placeName ref="l749">Saxonia</placeName> <lb xml:id="p2z6"/>adhuc salva est et maritimę civitates etc.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z7"/>Hęc ad te brevibus, frater observandissime, quę certa <lb xml:id="p2z8"/>sunt; passim feruntur plurima vulgo, sed incerta.</s>
					<s n="20" xml:lang="la"><lb xml:id="p2z9"/>Verum quid moramur hominum rumores?</s>
					<s n="21" xml:lang="la">Certum <lb xml:id="p2z10"/>est dei verbum, solidum et immutabile, quod <lb xml:id="p2z11"/>nec papę nec <persName ref="p18538">Caesaris</persName> tyrannide exterminabitur, <lb xml:id="p2z12"/>modo resipiscamus.</s>
					<s n="22" xml:lang="la">Servabit dominus aliquas reliqu<lb xml:id="p2z13"/>ias suę <placeName ref="l822">Germanię</placeName>.</s>
					<s n="23" xml:lang="la">Audio enim plerasque civitates, <lb xml:id="p2z14"/>de quibus conclamatum, nunc respirare.</s>
					<s n="24" xml:lang="la">Videbimus <lb xml:id="p2z15"/>propediem maiestatem Christi, ut spero, multo <lb xml:id="p2z16"/>clariorem quam unquam.</s>
					<s n="25" xml:lang="la" ana="farewell">Vale et orate pro nobis, <lb xml:id="p2z17"/>ut facitis, sedulo, ne lupi irruant in caulam <lb xml:id="p2z18"/>ovium Christi apud nos.</s>
				</p>
				<p>
					<s n="26" xml:lang="la" ana="farewell">Vale cum ecclesia et familia.</s>
					<s n="27" xml:lang="la"><lb xml:id="p2z19"/>Nolui scribere; sed <persName>Heinius</persName> persuasit, ex quo <lb xml:id="p2z20"/>reliqua expiscaberis.</s>
					<s n="28" xml:lang="la" ana="salute">Salutabis omnes symmystas.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><placeName ref="l411">Richenvillę</placeName> 2<lb xml:id="p2z21"/>5. Aprilis etc. 49.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><persName ref="p1010">Erbius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="31" xml:lang="la">D. <persName ref="p495">Henrycho Bullingero</persName>, fratri observandissimo etc.</s>
				</p>
