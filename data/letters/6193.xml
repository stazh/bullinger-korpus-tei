	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Tuas accepi, chare frater, <lb xml:id="p1z2"/>et semper ago gratias pro diligentia.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>De exercitu, qui colligatur in <placeName ref="l822">Germania</placeName>, <lb xml:id="p1z4"/>nihil audimus, nec puto fa<lb xml:id="p1z5"/>cile ad arma venturos <placeName ref="l41">Bernates</placeName> cum <lb xml:id="p1z6"/><placeName ref="l2478">Allobroge</placeName>; res enim sic temperatur, <lb xml:id="p1z7"/>ut videantur brevi consensuri.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Sed <lb xml:id="p1z8"/>agnosco interim mirifica esse mundi <lb xml:id="p1z9"/>consilia; dominus ergo protegat nos.</s>
					<s n="5" xml:lang="la">Nunc <lb xml:id="p1z10"/>nihil habeo, quod mittam, nisi hoc, quod <lb xml:id="p1z11"/>inclusum est; remitte et cave, ne <lb xml:id="p1z12"/>temere spargas, imo ex manibus tuis nulli cedas.</s>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z13"/>Ora semper pro me <lb xml:id="p1z14"/>d<lb xml:id="p1z15"/>ominum ac vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 14. iulii <lb xml:id="p1z16"/>anno 1564.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Tuus qui semper.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro fidelissimo, <lb xml:id="p2z4"/>domino compatri et fratri <lb xml:id="p2z5"/>meo colendissimo et charissimo.</s>
					<s n="10" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
