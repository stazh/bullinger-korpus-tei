	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quae misi praeteritis diebus per illum, <lb xml:id="p1z3"/>qui literas a te d. <persName ref="p1283">Gessnero</persName> attulit, expecto.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Interea venit tabellio principis <placeName ref="l213">Hassiae</placeName> <lb xml:id="p1z5"/>ad me missus propter quaestiones aliquot; eum hodie <lb xml:id="p1z6"/>demum expedire potui.</s>
					<s n="4" xml:lang="la">Attulit is varia, <lb xml:id="p1z7"/>imprimis quae attinent concilium <placeName ref="l1107">Tridentinum</placeName>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Celebrarunt <lb xml:id="p1z8"/><placeName ref="l1570">Fuldae</placeName> 12. septembris comitia principes maxime <lb xml:id="p1z9"/>consultantes de concilio.</s>
					<s n="6" xml:lang="la">Concluserunt nolle se <lb xml:id="p1z10"/>mittere in concilium,<note type="margin">dazu a.R.: "hoc enim pertinaciter petit <persName>Caesar</persName>, papae mancipium etc."</note> pararunt autem scripta du<lb xml:id="p1z11"/>o, prius ad <persName>Caesarem</persName>, in quo hortantur, ut abroget <lb xml:id="p1z12"/><placeName ref="l1107">Tridentinum</placeName>, legitimum indicat in <placeName ref="l822">Germania</placeName> concilium.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Hoc iam oblaturi sunt <persName>Caesari</persName> in comitiis <placeName ref="l157">Franc<lb xml:id="p1z14"/>fordianis</placeName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Alterum et posterius est copiosum, <lb xml:id="p1z15"/>quo rationem reddunt, cur nolint se subiicere <lb xml:id="p1z16"/>aut communicare cum concilio <placeName ref="l1107">Tridentino</placeName>.</s>
					<s n="9" xml:lang="la">Utriusque <lb xml:id="p1z17"/>exemplum ad me misit.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Spero principes <lb xml:id="p1z18"/>ipsos suo sub nomine publicaturos ac arbitror <lb xml:id="p1z19"/>principem <placeName ref="l749">Saxoniae</placeName> habere in mandatis, ut i<lb xml:id="p1z20"/>mprimi curet <placeName ref="l558">Wittenbergae</placeName>.</s>
					<s n="11" xml:lang="la">Quae interim <lb xml:id="p1z21"/>nova accepi, communico in hac charta, quam <lb xml:id="p1z22"/>inclusam literis tuis proximis ad me remittes.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/>Valebis una cum charis fratribus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Mei omnes <lb xml:id="p1z24"/>te salutant.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Galli 1562.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z25"/>Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z26"/>Sive scribam sive non exprimam <lb xml:id="p1z27"/>scripto, semper salutabis d. <persName ref="p8359">Gallicium</persName>, <lb xml:id="p1z28"/>utrumque consulem et <persName ref="p6130">Pontasellam</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae fideli ministro, <lb xml:id="p2z4"/>domino et compatri meo <lb xml:id="p2z5"/>colendo et dilecto.</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z6"/>Chur.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>