	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salvi, mi <persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">De statu rerum <placeName ref="l808">Belgicarum</placeName> scriberem libenter, <lb xml:id="p1z2"/>si aliquid certi constaret.</s>
					<s n="3" xml:lang="la">Mirum est silentium.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Fama tulerat reversura ex <lb xml:id="p1z3"/><placeName ref="l808">Belgico</placeName> 13 vexilla <placeName ref="l862">Helvetica</placeName>, et nostri in horas expectabantur; sed, ut video, <lb xml:id="p1z4"/>in auram spes evanuit, bellaque maiora parari inde coniicimus, ceu non satis <lb xml:id="p1z5"/>diuturna fuerit calamitas neque satis cladium.</s>
					<s n="5" xml:lang="la">Itaque nihil mirum, si <lb xml:id="p1z6"/>et monarchae et gentes bella volentes sitientesque sanguinem bellis et <lb xml:id="p1z7"/>sanguine satientur tandem, qui tot modis provocare in se iram domini non de<lb xml:id="p1z8"/>sinunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ex <placeName ref="l832">Gallis</placeName> retulit in collegio nostro vir quidam honestus se <lb xml:id="p1z9"/>diebus proximis <placeName ref="l378">Lutetiae</placeName>, unde recta venire se affirmabat, vidisse <lb xml:id="p1z10"/>horrenda vigenorum martyrum supplicia, inter quos praestantissimi aliquot <lb xml:id="p1z11"/>viri et foeminae nobilitate illustres cum reliquis miserum in modum <lb xml:id="p1z12"/>ustulati sint.</s>
					<s n="7" xml:lang="la">Quae si vera sunt, adparet legationem nostratem et principum <lb xml:id="p1z13"/>ponderis minimum habuisse; siquidem etiam admissa et audita est.</s>
					<s n="8" xml:lang="la">Non <lb xml:id="p1z14"/>erunt interim cassae ecclesiarum assiduae orationes, quibus et martyribus pacientia <lb xml:id="p1z15"/>et constantia et hostibus confusio postulatur.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Colloquium <placeName ref="l569">Vormaciense</placeName> ad tem<lb xml:id="p1z16"/>pus, ut nosti, suspensum denuo instauratum esse arbitror, posteaquam a rege <lb xml:id="p1z17"/><persName ref="p18477">Ferdinando</persName> responsum intra dies 6 allatum significatur, quo iubentur collocutores <lb xml:id="p1z18"/>progredi; spero autem mox me certa habiturum.</s>
					<s n="10" xml:lang="la" ana="farewell">Bene vale in Christo <lb xml:id="p1z19"/>Iesu cum tuis omnibus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l28">Basileae</placeName> 8. decembris anno 1557.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p2095">Philippi Melanchtonis</persName> uxor in domino obdormivit, <lb xml:id="p1z21"/>matronarum decus, fidele optimi seni adiutorium.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Tuus <persName ref="p3099">S[imo<lb xml:id="p1z23"/>n] Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, domino et symmistae <lb xml:id="p2z3"/>colendissimo suo.</s>
				</p>
			</div>
		</body>
	</text>
