	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Temporis brevitas non sinit me <lb xml:id="p1z2"/>pluribus tecum agere.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Scias ergo d. <persName ref="p8111">Martyrem</persName> <lb xml:id="p1z3"/>26. huius hinc discessisse, quod felix et faustum sit, <lb xml:id="p1z4"/>in <placeName ref="l832">Galliam</placeName>; deducet ipsum per <placeName ref="l631">Burgundiam</placeName> in <lb xml:id="p1z5"/><placeName ref="l832">Galliam</placeName> usque d. <persName ref="p629">Coignetius</persName>, cum quo egit a<lb xml:id="p1z6"/>mplissimus huius urbis magistratus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ora cum omnibus <lb xml:id="p1z7"/>piis dominum, ut profectioni et universo n<lb xml:id="p1z8"/>egotio benedicat.</s>
					<s n="5" xml:lang="la">Gravia exoriuntur apud <lb xml:id="p1z9"/><placeName ref="l648">Rhetos</placeName> pericula: papa et <persName ref="p18575">rex Hispaniarum</persName> <lb xml:id="p1z10"/>missis legatis omnino conantur ex <placeName ref="l520">Valle <lb xml:id="p1z11"/>Tellina</placeName> eiicere evangelium.</s>
					<s n="6" xml:lang="la">Dicuntur naves <lb xml:id="p1z12"/>28 Ianuam deportasse <placeName ref="l875">Hispanicum</placeName> exercitum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Veneti muniunt nescio quam ob causam <lb xml:id="p1z14"/><placeName ref="l36">Bergomum</placeName>.</s>
					<s n="8" xml:lang="la">Non desunt, qui suspicentur <lb xml:id="p1z15"/><placeName ref="l875">Hispanos</placeName> cum <persName ref="p17889">Sabaudo principe</persName> aliquid moliri <lb xml:id="p1z16"/>contra regnum <placeName ref="l832">Galliae</placeName>, ut consilia disturbent <lb xml:id="p1z17"/>piorum.</s>
					<s n="9" xml:lang="la">Vigilandum ergo erit piis et <lb xml:id="p1z18"/>maxime precibus ad dominum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Si quid audieris <lb xml:id="p1z19"/>et certe habueris ex <placeName ref="l832">Gallia</placeName>, communices <lb xml:id="p1z20"/>mature, obsecro.</s>
					<s n="11" xml:lang="la">Quid responsum sit <lb xml:id="p1z21"/>legatis <placeName ref="l2">Agronien[sium]</placeName>, ipsi exponent.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z22"/>aeternum.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Salutant te symmystae et fratres.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z23"/><placeName ref="l587">Tiguri</placeName> 30. augusti 1561.</s>
					<s n="15" xml:lang="la" ana="salute">Salutabis <lb xml:id="p1z24"/>fratres.</s>
					<s n="16" xml:lang="la">Festinantissime.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z25"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p540">Io<lb xml:id="p2z2"/>anni Calvino</persName>, <placeName ref="l167">Ge<lb xml:id="p2z3"/>nevensis</placeName> ecclesiae pastori <lb xml:id="p2z4"/>fideli, domino et <lb xml:id="p2z5"/>fratri colendissimo et <lb xml:id="p2z6"/>charissimo suo.</s>
					<s n="19" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l167">Genff</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>