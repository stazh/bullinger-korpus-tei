	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Pridie demum eas accepi, quas tu <lb xml:id="p1z2"/>10. octobris dedisti.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Quereris in illis, <lb xml:id="p1z3"/>quod nullas a me accipias; sed mihi copio<lb xml:id="p1z4"/>sas per filium d. <persName ref="p8320">Dasypodii</persName>, quas.<lb xml:id="p1z5"/>.. te certo <lb xml:id="p1z6"/>accepisse inde colligo, quod dominus tuus, <lb xml:id="p1z7"/>singularis meus amicus, ad eas respondit, quibus <lb xml:id="p1z8"/>tuas coniunxeram.</s>
					<s n="4" xml:lang="la">Interea nihil occurrebat, <lb xml:id="p1z9"/>quod scriberem.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Identidem tibi i<lb xml:id="p1z10"/>nculco, quod plurimum profuturum spero: quoties <lb xml:id="p1z11"/>colloqui cum patre desideras, lege libellum mea manu <lb xml:id="p1z12"/>scriptum et tibi abeunt<lb xml:id="p1z13"/>i <lb xml:id="p1z14"/>creditum.</s>
					<s n="6" xml:lang="la" ana="salute">Ita studia et vitam tuam in<lb xml:id="p1z15"/>stitue, ut ex tua eruditione et pieta<lb xml:id="p1z16"/>te aliquando capiam voluptatem, neque <lb xml:id="p1z17"/>vero aliud feceris matri gratius, quae <lb xml:id="p1z18"/>te salutat.</s>
					<s n="7" xml:lang="la">Valemus sic recte satis uni<lb xml:id="p1z19"/>versi.</s>
					<s n="8" xml:lang="la">Post mensem, certe ante ferias <lb xml:id="p1z20"/>natales, domino et uxori strenam strenam per te <lb xml:id="p1z21"/>eis dandam mittam, modo fidos recepero <lb xml:id="p1z22"/>nuncios.</s>
					<s n="9" xml:lang="la">Si non antea misero, saltem <lb xml:id="p1z23"/>post festum, non tamen post festum, ut dici s<lb xml:id="p1z24"/>olet, subinsero.</s>
					<s n="10" xml:lang="la">Cedet et tibi tua portio.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z25"/>Stude, oro, frugalitati, pietati, rebus optimis; <lb xml:id="p1z26"/>cave a pravo aut prophano so<lb xml:id="p1z27"/>dalitio.</s>
					<s n="12" xml:lang="la">Tibi et literis vivito, in <lb xml:id="p1z28"/>his omnem voluptatem quaerito; fructum <lb xml:id="p1z29"/>enim uberrimum et gaudia voluptat<lb xml:id="p1z30"/>es vere plenas aliquando inde hau<lb xml:id="p1z31"/>ries.</s>
					<s n="13" xml:lang="la" ana="farewell">Vive et vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 17. novembris <lb xml:id="p1z32"/>1553.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z33"/>Tuas ad priores meas expecto.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z34"/><persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">In<lb xml:id="p1z35"/>de tuum studium in me diligentiamq<lb xml:id="p1z36"/>ue <lb xml:id="p1z37"/>aestimabo, si redeuntem videro omne<lb xml:id="p1z38"/>s e<lb xml:id="p1z39"/>t singulas posse et <lb xml:id="p1z40"/>anumerare e<lb xml:id="p1z41"/>t ostendere patris literas toto illo tem<lb xml:id="p1z42"/>pore, quo peregrinabaris, a me scriptas.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p487">Heinrycho Bullingero</persName>, <lb xml:id="p2z2"/>dilecto suo filio.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l491">Argentinae</placeName>.</s>
				</p>
			</div>
