	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Ago tibi ingentes gratias pro diligenti historia <lb xml:id="p1z2"/>rei apud vos et in Romania gesta.</s>
					<s n="3" xml:lang="la">Pridie <lb xml:id="p1z3"/>de Helvetiis papistis ad Paleanum caesis eadem reci<lb xml:id="p1z4"/>tat <placeName ref="l306">Mediolano</placeName> rediens <persName ref="p6055">Petrus Perna</persName>, qui et <lb xml:id="p1z5"/>literas affert de <placeName ref="l522">Venetorum</placeName> urbe a d. <persName ref="p8432">Friderycho <lb xml:id="p1z6"/>a Salice</persName> 1. augusti datas id ipsum testantes et cladis <lb xml:id="p1z7"/>acceptae diem 23. iulii designantes.</s>
					<s n="4" xml:lang="la">Dolendum <lb xml:id="p1z8"/>est tot quidem periclitari animas, sed laudandus <lb xml:id="p1z9"/>interim dominus in sanctis suis iudiciis; is convertat, <lb xml:id="p1z10"/>oro, omnia ad gloriam nominis sui.</s>
					<s n="5" xml:lang="la">Confoeder<lb xml:id="p1z11"/>ati nostri comitiis <placeName ref="l21">Badae</placeName> propter regem celebratis con<lb xml:id="p1z12"/>venire non potuerunt, sed scissi in diversas <lb xml:id="p1z13"/>sententias domum redierunt; sunt enim, qui <lb xml:id="p1z14"/>querantur militem contra pacta ductum esse in <placeName ref="l994">Neapolim</placeName> per <lb xml:id="p1z15"/><placeName ref="l306">Mediolanum</placeName>.</s>
					<s n="6" xml:lang="la">Hi militem regi negant; <lb xml:id="p1z17"/>alii existimant periclitanti regi et laborantibus <lb xml:id="p1z18"/>nostris nunc esse subveniendum.</s>
					<s n="7" xml:lang="la"><placeName ref="l646">Claronenses</placeName>, <lb xml:id="p1z19"/><placeName ref="l28">Basilienses</placeName>, <placeName ref="l441">Schaffhusiani</placeName> et quidam alii, ut audio, militem <lb xml:id="p1z20"/>negarunt; <placeName ref="l300">Luceriani</placeName> autem aut nonnulli <lb xml:id="p1z21"/>alii dicuntur adornare expeditionem, et profecturi <lb xml:id="p1z22"/><placeName ref="l2450">Svicii</placeName> postulatum regis ubi retulere ad populum <lb xml:id="p1z23"/>in coetu, adeo infestis animis commissi sunt, <lb xml:id="p1z24"/>ut parum ab armis abfuerint.</s>
					<s n="8" xml:lang="la">Adeo vero militem <lb xml:id="p1z25"/>regi non concesserunt, ut plurimi clamaverint <lb xml:id="p1z26"/>foedus regi renunciandum.</s>
					<s n="9" xml:lang="la">Et haec quidem <lb xml:id="p1z27"/>facta sunt, priusquam fama spargeret caesa esse pont<lb xml:id="p1z28"/>ificis <lb xml:id="p1z29"/>vexilla.</s>
					<s n="10" xml:lang="la">Quid nunc futurum putas, <lb xml:id="p1z30"/>quid, si audiant bellum inferri nunc <placeName ref="l150">Ferrariensi</placeName>?</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z31"/>Sic facile intelligent concludi illis, qui cum <persName>Guysiano</persName> <lb xml:id="p1z32"/>sunt, itinera?</s>
					<s n="12" xml:lang="la">Oremus dominum, ut has res <lb xml:id="p1z33"/>omnes temperet ad gloriam nominis sui; periculis <lb xml:id="p1z34"/>enim referta sunt omnia.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vive et vale <lb xml:id="p1z35"/>cum d. d. consulibus et <persName>Philippo</persName> et <persName ref="p6130">Pontasella</persName> et amicis <lb xml:id="p1z36"/>omnibus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Commendabis me et salutabis diligentissi<lb xml:id="p1z37"/>me d. <persName ref="p629">Matthiam Coignetum</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 20. a<lb xml:id="p1z38"/>ugusti 1557.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z40"/>Has literas curato, obsecro, diligenter.</s>
					<s n="18" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem hoch- und wolgelerten, frommen <lb xml:id="p2z2"/>und getruwen herren <persName ref="p8009">Johansen <lb xml:id="p2z3"/>Schmiden</persName>, pfarreren zuͦ <lb xml:id="p2z4"/><placeName ref="l98">Chur</placeName> by Sant Martin, sinem <lb xml:id="p2z5"/>lieben herren und bruͦder.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
