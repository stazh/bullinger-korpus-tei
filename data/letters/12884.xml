	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Gratulor tibi, honorande mi <persName ref="p8418">Myconi</persName>, ob re<lb xml:id="p1z2"/>cuperatam sanitatem tuam,<note xml:id="fn1" type="footnote" n="1">Bezug auf <ref target="file12882">Nr. 2833</ref>,1-4.</note> quam dominus velit esse <lb xml:id="p1z3"/>diuturnam, ut diu utilis esse pergas ecclesiae <lb xml:id="p1z4"/>suae; quo etiam omnia tua studia convertas!</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>A comitiis <placeName ref="l21">Badensibus</placeName><note xml:id="fn2" type="footnote" n="2">Die am 28. Februar begonnene <placeName ref="l21">Badener</placeName> Tagsatzung; s. <ref target="file12866">Nr. 2817</ref>, Anm. 4.</note> ne hac quidem hora quicquam <lb xml:id="p1z6"/>certi habemus.</s>
					<s n="4" xml:lang="la">Legati enim nostri<note xml:id="fn3" type="footnote" n="3"><persName ref="p1419">Johannes Haab</persName> und <persName ref="p6793">Itelhans Thumysen</persName>; s. <bibl source="b197">EA</bibl> IV/1d 771, Nr. 350 (Vorspann).</note> nec redierunt <lb xml:id="p1z7"/>nec literam ulla de re scripserunt.</s>
					<s n="5" xml:lang="la">Nihil ergo <lb xml:id="p1z8"/>vel de literis <persName ref="p18538">caesaris</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p18538">Karl V.</persName></note>, quibus de tu scribis,<note xml:id="fn5" type="footnote" n="5">Nämlich in <ref target="file12882">Nr. 2833</ref>,5-li.</note> <lb xml:id="p1z9"/>vel de ullis aliis rebus scribere possum.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/><placeName ref="l491">Argentinam</placeName><note xml:id="fn6" type="footnote" n="6">In Bezug auf <ref target="file12882">Nr. 2833</ref>,12-14.</note> vix aliis recipiet in gratiam c<lb xml:id="p1z11"/>onditionibus caesar quam alias urbes, quas mel<lb xml:id="p1z12"/>litis verbis et nimbo quodam promissionum oc<lb xml:id="p1z13"/>caecat; in fine videbitur cuius.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="7" xml:lang="la">Splendida dict<lb xml:id="p1z14"/>a sunt de <placeName ref="l18">Augusta</placeName> recepta.<note xml:id="fn7" type="footnote" n="7">Zur Unterwerfung <placeName ref="l18">Augsburgs</placeName> s. <ref target="file12818">Nr. 2769</ref>, Anm. 7.</note></s>
					<s n="8" xml:lang="la">Ego ex fide dignis <lb xml:id="p1z15"/>hominibus intelligo miseris turpiter esse <lb xml:id="p1z16"/>impositum blandiloquentia.</s>
					<s n="9" xml:lang="la">21. februarii<note xml:id="fna" type="footnote" n="a"><hi>Am Rande nachgetragen.</hi></note> recepta sunt <lb xml:id="p1z17"/>6 signa caesaris in urbem.</s>
					<s n="10" xml:lang="la">Aiunt adhuc 6 ex<lb xml:id="p1z18"/>pectari.<note xml:id="fn8" type="footnote" n="8"><persName ref="p495">Bullinger</persName> bezieht sich hier auf <persName ref="p8018">Hallers</persName> Mitteilung vom 21. Februar; s. <ref target="file12870">Nr. 2821</ref>,10-25. 184-187.</note></s>
					<s n="11" xml:lang="la">Ubi superiorem se numero et viribus <lb xml:id="p1z19"/>putaverit, videbis, quid ista hominum fex <lb xml:id="p1z20"/>tentatura sit.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="12" xml:lang="la"><placeName ref="l513">Ulma</placeName> et reliquae miserę urbes<note xml:id="fn9" type="footnote" n="9">Zu den Städten, die sich dem Kaiser ergeben hatten, s. <ref target="file12783">Nr. 2734</ref>, Anm. 4; <ref target="file12790">Nr. 2741</ref>, Anm. 4; <ref target="file12792">Nr. 2743</ref>, Anm. 40; <ref target="file12795">Nr. 2746</ref>, Anm. 9.</note> <lb xml:id="p1z21"/>exemplum praebent.</s>
					<s n="13" xml:lang="de">Was doͤrffend sich<note xml:id="fn10" type="footnote" n="10">Was dörffend sich: Warum mussten sich.</note> die barm<lb xml:id="p1z22"/>hertzigen<note xml:id="fn11" type="footnote" ana="lex" n="11">erbärmlichen.</note> lüt also uffzegaͤben?</s>
					<s n="14" xml:lang="de">Was naͤmend <lb xml:id="p1z23"/>sy das tüfelvolck<note xml:id="fn12" type="footnote" n="12">Damit sind die kaiserlichen Söldner gemeint.</note> hinyn?</s>
					<s n="15" xml:lang="de">Was behaltend sy ir <lb xml:id="p1z24"/>stett nitt unbefleckt und unbeherrschet?<note xml:id="fn13" type="footnote" ana="lex" n="13">selbstständig.</note></s>
					<s n="16" xml:lang="la"><lb xml:id="p1z25"/>Sed <pb type="edition" next="384"/> haec est manus domini<note xml:id="fn14" type="footnote" n="14">Vgl. z.B. <cit type="bible"><ref>1Sam 5, 11</ref></cit>.</note> percutientis nos propter <lb xml:id="p1z26"/>ingratitudinem nostram <lb xml:id="p1z27"/>et vitam poenitere nesciam.</s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z28"/>Non reconciliabitur caesar <placeName ref="l491">Argentinae</placeName>, <lb xml:id="p1z29"/>nisi signis aliquot in urbem receptis.<note xml:id="fn15" type="footnote" n="15">Den Straßburgern blieb jedoch eine Besatzung durch kaiserliche Truppen erspart; s. <ref target="file12871">Nr. 2822</ref>, Anm. 16.</note></s>
					<s n="18" xml:lang="la">Ita enim <lb xml:id="p1z30"/>vult ubique et in omnibus potentissimis <lb xml:id="p1z32"/>maxime <placeName ref="l822">Germaniae</placeName> urbibus signa luculenta extare <lb xml:id="p1z33"/>et relucere suae victoriae et deditionis <lb xml:id="p1z34"/><placeName ref="l822">Germanorum</placeName> turpissimae.</s>
				</p>
			</div>
			<div xml:id="div7" corresp="regest7">
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z35"/>Utinam vincat <persName ref="p19065">Saxo</persName><note xml:id="fn16" type="footnote" n="16"><persName ref="p19065">Johann Friedrich I. von Sachsen</persName>.</note> ad gloriam nominis dei et con<lb xml:id="p1z36"/>solationem afflictorum!</s>
					<s n="20" xml:lang="la">Metuo tamen illum quoque suo <lb xml:id="p1z37"/>tempore deserendum a sotiis.<note xml:id="fn17" type="footnote" n="17">= sociis.</note></s>
					<s n="21" xml:lang="la">Sed aliud forte <lb xml:id="p1z38"/>visum est domino.</s>
					<s n="22" xml:lang="la">In <placeName ref="l2779">Hegavia</placeName><note xml:id="fn18" type="footnote" n="18"><placeName ref="l2779">Hegau</placeName>. -Diese Meldung geht vermutlich auf das gleiche Gerücht zurück, das auch <persName ref="p8418">Myconius</persName> und <persName ref="p1278">Johannes Gast</persName> meldeten; vgl. <ref target="file12881">Nr. 2832</ref>,24-26; <ref target="file12882">Nr. 2833</ref>,16-19.</note> audio spargi a <lb xml:id="p1z40"/>militibus e <lb xml:id="p1z41"/>pugna infelici cruentatis capitibus <lb xml:id="p1z42"/>redeuntibus vicisse <placeName ref="l749">Saxonem</placeName> et caesarea<lb xml:id="p1z43"/>norum occubuisse ad 3000.</s>
					<s n="23" xml:lang="la">Verum<lb xml:id="p1z44"/>ne an falsum <lb xml:id="p1z45"/>dicatur, ignoro et dubito.</s>
					<s n="24" xml:lang="la">Aiunt caesarem 26. fe<lb xml:id="p1z46"/>bruarii movisse ab <placeName ref="l513">Ulma</placeName> contra <placeName ref="l749">Saxonem</placeName>.<note xml:id="fn19" type="footnote" n="19">Der Kaiser verließ <placeName ref="l513">Ulm</placeName> erst am 4. März; s. <ref target="file12783">Nr. 2734</ref>, Anm. 4; <ref target="file12803">Nr. 2754</ref>, Anm. 18. -Eine Zeitlang meinte man aber, dass er <placeName ref="l513">Ulm</placeName> schon am 26. Februar verlassen würde; s. <bibl source="b480">PC</bibl> IV/1 614.</note></s>
				</p>
			</div>
			<div xml:id="div8" corresp="regest8">
				<p>
					<s n="25" xml:lang="la"><pb type="scan" next="v."/><pb/><lb xml:id="p2z1"/>Recte iudicas de concordia et discordia <lb xml:id="p2z2"/>caesaris et <persName ref="p19981">papae</persName>.<note xml:id="fn20" type="footnote" n="20"><persName ref="p19981">Paul III.</persName> -Vgl. <ref target="file12882">Nr. 2833</ref>,23f.</note></s>
					<s n="26" xml:lang="la">Ego arbitror saepiae esse <lb xml:id="p2z3"/>atrorem.<note xml:id="fn21" type="footnote" n="21">die Schwärze (s. <bibl source="b353">Kirsch</bibl> 296) der Tinte des Tintenfisches (um die Leute besser verblenden zu können).</note></s>
					<s n="27" xml:lang="de">Es ist buͦbery<note xml:id="fn22" type="footnote" n="22">schändliches Treiben; s. <bibl source="b590">SI</bibl> IV 946.</note>, damitt die lüt umb<lb xml:id="p2z4"/>gand.<note xml:id="fn23" type="footnote" n="23">damitt die lüt umbgand: womit diese Leute [hier: Kaiser und Papst] irreführen.</note></s>
					<s n="28" xml:lang="de">Trüw inen<note xml:id="fn24" type="footnote" n="24">Es traue ihnen.</note> ja frylich der tüfel!</s>
					<s n="29" xml:lang="la">Quin <lb xml:id="p2z5"/>potius annunciemus nos regnum dei et saluti<lb xml:id="p2z6"/>ferum evangelium filii dei, pontificis et regis <lb xml:id="p2z7"/>nostri,<note xml:id="fn25" type="footnote" n="25">Gemeint ist Christus; vgl. <cit type="bible"><ref>Hebr 4, 14</ref></cit>; <cit type="bible"><ref>7, 1f. 21f</ref></cit>; <cit type="bible"><ref>8, 1</ref></cit>; <cit type="bible"><ref>10, 21</ref></cit>.</note> qui syncere agit, neminem fallit et <lb xml:id="p2z8"/>mox venturus est in iustitia, iudicaturus <lb xml:id="p2z9"/>vivos et mortuos.<note xml:id="fn26" type="footnote" n="26">Vgl. <cit type="bible"><ref>Ps 96 (Vulg. 95), 13</ref></cit>; <cit type="bible"><ref>98 (Vulg. 97), 9</ref></cit>; <cit type="bible"><ref>2Tim 4, 1</ref></cit>; <cit type="bible"><ref>1Petr 4, 5</ref></cit>.</note></s>
					<s n="30" xml:lang="la">Huic placere in omnibus satagamus!</s>
					<s n="31" xml:lang="la" ana="farewell"><lb xml:id="p2z10"/>In illo vale cum omnibus bonis.</s>
					<s n="32" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 4. <lb xml:id="p2z11"/>martii circa 9 ante<lb xml:id="p2z12"/>meridianam 1547.</s>
					<s n="33" xml:lang="la" ana="salute">Saluta fratres.</s>
					<s n="34" xml:lang="la"><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse darunter:]</note>
					<s n="35" xml:lang="la">Clarissimo viro d. <lb xml:id="p2z13"/><persName ref="p8418">Osvaldo Myconio</persName>, <lb xml:id="p2z14"/>domino et fratri c<lb xml:id="p2z15"/>olendo et dilecto.</s>
					<s n="36" xml:lang="de"><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>