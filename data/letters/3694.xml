	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quia varii et falsi rumores sparguntur de nostro exercitu <lb xml:id="p1z2"/>te certiorem facere volui de iis, que certo intellexi ex literis ad <lb xml:id="p1z3"/>me scriptis 26. augusti, castra <persName ref="p18575">Philippi</persName> posita tribus miliaribus <lb xml:id="p1z4"/>ultra urbem <placeName>Dourlens</placeName> et ibi se munivisse altis aggeribus, <lb xml:id="p1z5"/>ut a nostris securi sint, qui Somonam fluvium occupant, <lb xml:id="p1z6"/>ubi rex etiam debebat esse praesens 28. augusti.</s>
					<s n="3" xml:lang="la">Fuit certamen inter <placeName ref="l875">Hispanos</placeName> <lb xml:id="p1z7"/>et <placeName ref="l822">Germanos</placeName> <persName ref="p18575">Philippi</persName> et ex <placeName ref="l875">Hispanis</placeName> ad tria millia cecidere.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Non puto unumquemque ex illis exercitibus in utramque dormire aurem.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Ex illi potest dominis aliquid boni efficere, quod pacis tempore <lb xml:id="p1z10"/>difficilius esset.</s>
					<s n="6" xml:lang="la">Si quid maius et certius habuissem scripsissem <lb xml:id="p1z11"/>amplissimo senatui.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Illum salutabis meis verbis et hęc, si videbuntur <lb xml:id="p1z12"/>digna, communicabis et amicis.</s>
					<s n="8" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l760">Suluduri</placeName> 4. septembris.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Tuus ex <lb xml:id="p1z13"/>animo <persName ref="p629">Coignetius</persName><lb xml:id="p1z14"/>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l210">Haidelbergae</placeName> prinis scripsit ad me <placeName ref="l2477">Palat<lb xml:id="p1z15"/>inum</placeName> cum alio electore et nonnullis [pr<lb xml:id="p1z16"/>]incipibus in eo esse, ut notiones ineant <lb xml:id="p1z17"/>pacis componende.</s>
					<s n="12" xml:lang="la">Nil adhuc rescripsit imperator... dieta <lb xml:id="p1z18"/><placeName ref="l18">Augustana</placeName> urget tamen contributionem contra <lb xml:id="p1z19"/><placeName ref="l2510">Turcam</placeName>.</s>
					<s n="13" xml:lang="la">Coniectura est esse contra regem, cum edicta <lb xml:id="p1z20"/>gravissima publicari faciat contra eos, qui sunt <lb xml:id="p1z21"/><placeName ref="l18">Augustane</placeName> confessionis pacta ei iuramenta negligent[ur].</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z22"/><persName ref="p18575">Philippus</persName> aliquot <placeName ref="l822">Germanos</placeName> adhuc expectat, qui <lb xml:id="p1z23"/>veniunt ab ecclesiasticis.</s>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z2"/>ecclesie <placeName ref="l587">Tigurine</placeName> pastori vigilantissimo.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
