	<text xml:lang="de">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Es handelt sich um die Antwort auf <persName ref="p8418" cert="high">Myconius</persName>' Anfrage vom 9. Februar (oben <ref target="file10985">Nr. 943</ref>).</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Quid agendum putem, <lb xml:id="p1z2"/>si <persName ref="p1974">Luthero</persName> non placeat confessio nostra, rogas<note xml:id="fn2" type="footnote" n="2">Siehe ebd., Z. 1-3.</note>.</s>
					<s n="3" xml:lang="la">Relinquend<lb xml:id="p1z3"/>um censeo <persName ref="p1974">Lutherum</persName> et veritati confessae adhaerendum.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Consilium illud de recipiendis confessionibus<note xml:id="fn3" type="footnote" n="3"><persName ref="p4079">Johannes Zwick</persName> hatte den Schweizern empfohlen, dem Vierstädte- und dem <placeName ref="l18">Augsburger</placeName> Bekenntnis unter bestimmten Bedingungen zuzustimmen; vgl. oben <ref target="file10982">Nr. 940</ref>, 31-50, und <ref target="file10985">Nr. 943</ref>, 3-9.</note> nullis <lb xml:id="p1z5"/>nostrorum placere video.</s>
					<s n="5" xml:lang="la">Olim quidem recipere volebamus <lb xml:id="p1z6"/>urbium 4 confessionem, sed obstitere <placeName ref="l41">Bernates</placeName><pb type="edition" next="61"/><note xml:id="fn4" type="footnote" n="4">Siehe <bibl source="b197">EA</bibl> IV/1c 683 b und <bibl source="b8">HBBW VI</bibl> <ref target="file10878">[Nr. 839]</ref>, S. 318f; vgl. auch das undatierte Gutachten der <placeName ref="l41">Berner</placeName> Pfarrer zur Tetrapolitana in Bern StA, A V 1455, 81.</note>.</s>
					<s n="6" xml:lang="la">Quid ergo <lb xml:id="p1z7"/>facturos putas, si audiant et Saxonicam<note xml:id="fn5" type="footnote" n="5">das <placeName ref="l18">Augsburger</placeName> Bekenntnis.</note> esse recipiendam?</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/>Sic itaque scinderemur.</s>
					<s n="8" xml:lang="la">Quid verbis opus est?</s>
					<s n="9" xml:lang="la">Confessionem <lb xml:id="p1z9"/>conscripsimus, in illam consensimus unanimes, <lb xml:id="p1z10"/>in hac perseveremus.</s>
					<s n="10" xml:lang="de">Wenn hatt man uns ouch gnuͦg umb<lb xml:id="p1z11"/>gefuͤrt<note xml:id="fn6" type="footnote" n="6">zum Narren gehalten.</note>?</s>
					<s n="11" xml:lang="de">Wie ist doch unser ding denen lüten so bitter?</s>
					<s n="12" xml:lang="de">Ich <lb xml:id="p1z12"/>wust es aber vor<note xml:id="fn7" type="footnote" ana="lex" n="7">im voraus.</note> wol, das, diewyl wir dem <persName ref="p1974">Luther</persName>, der <lb xml:id="p1z13"/>sexischen confession nitt underschribind, das da ghein <lb xml:id="p1z14"/>frid sin wurde<note xml:id="fn8" type="footnote" n="8">Vgl. <bibl source="b8">HBBW VI</bibl> <ref target="file10915">[Nr. 875]</ref>, S. 385, 51-53.</note>.</s>
					<s n="13" xml:lang="de">Kurtz, es ist nüt dann blast<note xml:id="fn9" type="footnote" n="9">Aufblähung, Überheblichkeit.</note> und hoffart.</s>
					<s n="14" xml:lang="de"><lb xml:id="p1z15"/>Dann unser confässion ist kurtz, klar und warhafft; <lb xml:id="p1z16"/>denocht gilt sy nüt, und wil mans undertrucken.</s>
					<s n="15" xml:lang="de">Ist <lb xml:id="p1z17"/>das nitt ein blaast?</s>
					<s n="16" xml:lang="de">Dorumb lassend uns in an<lb xml:id="p1z18"/>gefängter einighevt blyben.</s>
					<s n="17" xml:lang="de">Dann ists mitt dem <persName ref="p1974">Lu<lb xml:id="p1z19"/>ther</persName> nüt, so wil ich schlächt<note xml:id="fn10" type="footnote" ana="lex" n="10">schlechterdings.</note> mitt der sach nützid zu<lb xml:id="p1z20"/>ͦ schaffen haben.</s>
					<s n="18" xml:lang="la">Haec non dico propter <persName ref="p4079">Zviccium</persName><note xml:id="fn11" type="footnote" n="11">Vgl. oben Anm. 3.</note>, quem <lb xml:id="p1z21"/>prorsus nostrum esse novi, sed propter illorum pollicitatio<lb xml:id="p1z22"/>nes, qui hactenus nos vana spe lactarunt.</s>
					<s n="19" xml:lang="de">Und wil <lb xml:id="p1z23"/>mich beduncken, es wöl ye länger ye minder an <lb xml:id="p1z24"/>der sach sin<note xml:id="fn12" type="footnote" n="12">schlechter um die Sache stehen.</note>.</s>
					<s n="20" xml:lang="de">Dorumb muͦß mir uuß sin<note xml:id="fn13" type="footnote" n="13">Schluß damit sein.</note></s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z25"/>Cuperem videre consultationem super <lb xml:id="p1z26"/>articulis <lb xml:id="p1z27"/><placeName ref="l491">Argentoratensium</placeName> habentem arcus 13<note xml:id="fn14" type="footnote" n="14">Siehe oben <ref target="file10985">Nr. 943</ref>, 20-22.</note>.</s>
					<s n="22" xml:lang="la">Bona fide <lb xml:id="p1z28"/>remittam proximo nuncio.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="salute"><lb xml:id="p1z29"/>Vale et <persName ref="p1365">Gryneum</persName> <lb xml:id="p1z30"/>una cum symmistis salvere iubeto.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">12. <lb xml:id="p1z32"/>februarii 1537.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z33"/>Tuus <persName ref="p495">H. Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p1z34"/><persName ref="p8199">Clotius Aesch<lb xml:id="p1z35"/>erius</persName><note xml:id="fn15" type="footnote" ana="bio" n="15"><persName ref="p8199">Hans Escher vom Glas</persName>, wegen seiner Grobheit "Klotz" genannt. Näheres über seinen (bisher auf 1538 datierten) Tod berichtet <persName ref="p5072">Sebastian Guldibeck</persName> in einem Brief an <persName ref="p8418">Myconius</persName> vom 20. Februar [1537]; s. Zürich ZB, Ms F 80, 667.</note> excessit.</s>
					<s n="27" xml:lang="de"><lb xml:id="p1z36"/>Noch denocht habend wir der puuren pögen <lb xml:id="p1z37"/>nitt gemanglet<note xml:id="fn16" type="footnote" n="16">Allerdings haben wir keinen Mangel an Leuten gehabt, die sich bäurisch aufführen (vgl. <bibl source="b590">SI</bibl> IV 1084).</note> Wir hand darzuͦ <lb xml:id="p1z38"/>ouch affen<note xml:id="fn17" type="footnote" ana="lex" n="17">Nachahmer.</note>. ghan.</s>
				</p>
				<p>
					<note type="address">[Ohne Adresse.]</note>
				</p>
			</div>
		</body>
