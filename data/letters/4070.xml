	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Sabaudum moliri foedus cum ordinibus Helveticis, ut audio, ita, <lb xml:id="p1z3"/>quo id fiat consilio, non satis possum intelligere; si fraude aliqua fiat, <lb xml:id="p1z4"/>magnopere cavendum sit, si quod ipsum attinet <persName ref="p19982">Allobrogum</persName> syncero etiam <lb xml:id="p1z5"/>animo, tamen et sic, ne quid temere recipiatur, dispiciendum.</s>
					<s n="3" xml:lang="la">Cupio <lb xml:id="p1z6"/>vehementer ea in re sententiam cognoscere.</s>
				</p>
				<p>
					<s n="4" xml:lang="de"><foreign xml:lang="la">Novi nihil <lb xml:id="p1z7"/>nunc habeo, nisi quod quidam certę fidei ita ad me scribit:</foreign> "<lb xml:id="p1z8"/>Nüwer zytung haben wir diser zyt anders nichts, denn der k<lb xml:id="p1z9"/>ai[serlich] may[estat] noch styff und vest uff irer opinion und <lb xml:id="p1z10"/>meinung verharren und von nichten, was die heilig religion <lb xml:id="p1z11"/>antryfft, wychen wöllen und also von den fursten abgescheiden, <lb xml:id="p1z12"/>zuͦ besorgen, es werde sich in kurtz etwas anders ereugen <lb xml:id="p1z13"/>und sechen lassen etc."</s>
					<s n="5" xml:lang="la">Haec volui scires.</s>
					<s n="6" xml:lang="la">Ex <placeName ref="l832">Gallia</placeName> multa quidem, <lb xml:id="p1z14"/>sed dubia omnia feruntur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Conestabilem tamen aula cessisse pro certo <lb xml:id="p1z15"/>affirmatur et <placeName ref="l691">Lotharingicum</placeName> cardinalem primum favoris et existi<lb xml:id="p1z16"/>mationis gradum apud regem obtinere.</s>
					<s n="8" xml:lang="la">Ustulationes sanctorum <lb xml:id="p1z17"/>frequentes et horribiles exerceri.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Bene vale, charissime domine <lb xml:id="p1z19"/>et frater.</s>
					<s n="10" xml:lang="la"><placeName ref="l28">Basileae</placeName> 4. septembris anno 1<lb xml:id="p1z20"/>559.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Tuus <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Saluta meis verb<lb xml:id="p1z21"/>is symmistas <lb xml:id="p1z22"/>tuos et professores<lb xml:id="p1z23"/>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, domino colen<lb xml:id="p2z3"/>dissimo et charis<lb xml:id="p2z4"/>simo <lb xml:id="p2z5"/>fratri suo.</s>
				</p>
			</div>
		</body>
	</text>
