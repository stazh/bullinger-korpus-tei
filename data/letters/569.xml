	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>wwernfeybe
					<lb xml:id="p1z2"/>
					<lb xml:id="p1z3"/>habend t.
					<lb xml:id="p1z4"/>Geagen
					<lb xml:id="p1z5"/>h. Jolum, Bernern von Scher
					<lb xml:id="p1z6"/>ipu
					<lb xml:id="p1z7"/>unse
					<lb xml:id="p1z8"/>iben im h gethan sins ynhallts verstandn
					<lb xml:id="p1z9"/>und darff gedachthn luln und
					<lb xml:id="p1z10"/>er ordnung nach.
					<lb xml:id="p1z11"/>och üch zuͦ gefallen  3 disggfft aber
					<lb xml:id="p1z12"/>schwach und uuldru
					<lb xml:id="p1z13"/>
					<lb xml:id="p1z14"/>nitt habend könend imm
					<lb xml:id="p1z15"/>a.
					<lb xml:id="p1z16"/>gschicktg
					<lb xml:id="p1z17"/>das ist uns m in tr
					<lb xml:id="p1z18"/>tze versähen erckon
					<lb xml:id="p1z19"/>a leyd, dann ir uns deß vertruwe söllend, das
					<lb xml:id="p1z20"/>inn uff uwer unsers günstigen junctheren für
					<lb xml:id="p1z21"/>wir
					<lb xml:id="p1z22"/>beschrifft unst vern hättend gefürderet, diewyl
					<pb/>
					<lb xml:id="p2z1"/>.
					<lb xml:id="p2z2"/>aber
					<lb xml:id="p2z3"/>nitt anders gestalltet ist ha
					<lb xml:id="p2z4"/>S.
					<lb xml:id="p2z5"/>wir üb sölichs nitt verhallten wöllen, das irewy
					<lb xml:id="p2z6"/>üwer gelägenhei nach, was ze handlen ist ze
					<lb xml:id="p2z7"/>wüssend.
					<lb xml:id="p2z8"/>nitt krüntlichen enbieten
					<lb xml:id="p2z9"/>liebs und dienst bewysen kön
					<lb xml:id="p2z10"/>wow
					<lb xml:id="p2z11"/>wirt
					<lb xml:id="p2z12"/>willig. Datum Zürych donstags
					<lb xml:id="p2z13"/>1549.
					<lb xml:id="p2z14"/>des 27. tags
				</p>
