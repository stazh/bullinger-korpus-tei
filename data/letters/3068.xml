	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Brevior sum colendissime mi <persName ref="p540">Calvine</persName>, frater <lb xml:id="p1z2"/>in Domino charissime, quod optimus hic frater <lb xml:id="p1z3"/>et symmysta noster omnia rectius possit narrare <lb xml:id="p1z4"/>quam ego scribere.</s>
					<s n="3" xml:lang="la">Ego pro meo in vos <lb xml:id="p1z5"/>amore, observantia et studio, quae potui feci.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Puto amplissimum Dom.</s>
					<s n="5" xml:lang="la">Consulem una cum senatu non <lb xml:id="p1z7"/>imprudenter negotium aggressuros.</s>
					<s n="6" xml:lang="la">Qua de re <lb xml:id="p1z8"/>scribitur ad clarissimum senatum vestrae reipublicae.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z9"/>Civitas <placeName ref="l834">Italo</placeName> illi de quo scribis non concedetur.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Nam tanta est hominum in hac civitate copia, <lb xml:id="p1z11"/>ut cives postularint, ne qui recipiantur amplius <lb xml:id="p1z12"/>aliquanto tempore: qud et decreto publico <lb xml:id="p1z13"/>confirmatum est.</s>
					<s n="9" xml:lang="la">Absentes minus recipiuntur.</s>
					<s n="10" xml:lang="la">D. <lb xml:id="p1z14"/>Consul uno verbo mihi significavit frustra hoc <lb xml:id="p1z15"/>nos tentaturos negotium.</s>
					<s n="11" xml:lang="la">At literae tuae ea de re <lb xml:id="p1z16"/>dudum scriptae non multas ante horas quam ven<lb xml:id="p1z17"/>iret <persName>Macharius</persName> mihi sunt redditae.</s>
					<s n="12" xml:lang="la">Nescio <lb xml:id="p1z18"/>ubi delituerint aut oberrarint in itinere.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z19"/>De rebus novis ex <placeName ref="l284">Lipsia</placeName> ad me scriptis referet <lb xml:id="p1z20"/>D. <persName>Macharius</persName>.</s>
					<s n="14" xml:lang="la">Fama est brevi <persName ref="p8282">Maximilianum</persName> <lb xml:id="p1z21"/>creandum <placeName ref="l425">Rom</placeName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Regem etc.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell">Vive et <lb xml:id="p1z22"/>vale.</s>
					<s n="17" xml:lang="la">Dominus Iesus faxit ut hic annus tibi <lb xml:id="p1z23"/>ac tuis sit felix et faustus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName> ultima <lb xml:id="p1z24"/>die anni 1556.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute">Salutant te fratres <lb xml:id="p1z26"/>omens.</s>
					<s n="20" xml:lang="la" ana="salute">Saluta tu fratres etc.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Festinantissime.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z27"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro D. <persName ref="p540">Ioanni <lb xml:id="p2z2"/>Calvino</persName> <placeName ref="l167">Genevensis</placeName> <lb xml:id="p2z3"/>ecclesiae fido pastori, <lb xml:id="p2z4"/>domino colendo et <lb xml:id="p2z5"/>fratri suo charissimo.</s>
				</p>
