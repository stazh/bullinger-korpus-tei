	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tu vero (reverende in Christo pater) nimis <lb xml:id="p1z2"/>copiosus es scribendo inter tantasque <lb xml:id="p1z3"/>tuas occupationes; itaque excusatione apud <lb xml:id="p1z4"/>me plane non opus erat.</s>
					<s n="3" xml:lang="la">Ago tibi immor<lb xml:id="p1z5"/>tales gratias, qui omnia communicaris; <lb xml:id="p1z6"/>sed tamen scripta tua nunc remittere <lb xml:id="p1z7"/>non potui, propterea quod nuntius intempest<lb xml:id="p1z8"/>ive ea attulisset, mittam tamen proximo <lb xml:id="p1z9"/>mercatu aut tempestivius, si sunt, quibus <lb xml:id="p1z10"/>commode dem.</s>
					<s n="4" xml:lang="la">Non habeo, quo te remunerer, <lb xml:id="p1z11"/>nisi quod mitto historiam <persName>Gruͦnbachi</persName>, sic ut <lb xml:id="p1z12"/>ad nostros consules pro certa per mercatores scripta<note type="margin">dazu a.R.: "Fuit mecum <persName ref="p5994">Iodocus Oesenbry</persName>, qui haec exscripsit, sed subito; serva [exemp</note>lar, <lb xml:id="p1z13"/>noli [remi]ttere."].</s>
					<s n="5" xml:lang="la">Nihil dubito de eius fide.</s>
					<s n="6" xml:lang="la">Ego memor <lb xml:id="p1z14"/>ero praeceptorum tuorum, et alias eram brevior <lb xml:id="p1z15"/>futurus; sed diu in Latinis <lb xml:id="p1z16"/>authoribus nihil legi et video iam, quam <lb xml:id="p1z17"/>sim imparatus, et mihi ipsi displiceo; <lb xml:id="p1z18"/>tamen dominum oro, qui mihi praesto <lb xml:id="p1z19"/>est.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z20"/>Unum me angit, ubi excudi possit, <lb xml:id="p1z21"/>et nunc ad d. <persName ref="p8126">Oporinum</persName> scribere non <lb xml:id="p1z22"/>vacat<note type="margin">dazu a.R.: "Estne <persName ref="p8126">Oporinus</persName> adhuc <placeName ref="l28">Basileae</placeName>? Audieram eum istinc migrasse."</note>.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale, reverende in Christo <lb xml:id="p1z23"/>pater.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l98">Curię</placeName> festinantissime anno <lb xml:id="p1z24"/>1563 calendis novembris.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/>Tui observans <persName ref="p8009">Fabri<lb xml:id="p1z26"/>cius</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Absurdas scripturae interpretationes non <lb xml:id="p2z2"/>paucas ex ipsis decretis colligere licet <lb xml:id="p2z3"/>et omni iure pontificio, qualis <lb xml:id="p2z4"/>illa est de aqua lustrali (nam et consequentia huc <lb xml:id="p2z5"/>numero); <lb xml:id="p2z6"/>non ponam ergo nisi confessa, ne dubita etc.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Amplissimo viro <lb xml:id="p2z7"/>d. <persName ref="p495">Heinrycho Bullingero</persName>, domino suo et in Christo patri aeternum <lb xml:id="p2z8"/>colendo.</s>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
