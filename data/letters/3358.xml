	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Delectus quidem apud nos fieri coepit, quam<lb xml:id="p1z2"/>vis nondum promulgatus sit, sed non pro Gallo, verum <lb xml:id="p1z3"/>pro finibus huius ditionis tuendis.</s>
					<s n="3" xml:lang="la">Itaque nihil <lb xml:id="p1z4"/>est, quod isti sperant fore, ut <placeName ref="l832">Gallo</placeName> suppetiae ferantur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Novi alias apud nos nihil est.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Ego secundo nunc tussi <lb xml:id="p1z6"/>capitisque defluxu laboro, ut plura scribere <lb xml:id="p1z7"/>non possum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Mitto tibi principium Decadum tuarum; <lb xml:id="p1z8"/>inspice et admone nos in tempore eorum, quę <lb xml:id="p1z9"/>videntur.</s>
					<s n="7" xml:lang="la">Literas <persName ref="p8055">Blaurero</persName> cras mittam.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z10"/>vale cum tuis omnibus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l41">Bernae</placeName> 8. octobris 1557.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><persName ref="p8018">I[<lb xml:id="p1z11"/>oannes] Hallerus</persName> tuus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>charissimo suo colendissimoque <lb xml:id="p2z5"/>domino et compatri.</s>
					<s n="12" xml:lang="de"><lb xml:id="p2z6"/>M. <persName ref="p495">Heinrych <lb xml:id="p2z7"/>Bullingeren</persName>.</s>
				</p>
			</div>
		</body>
	</text>
