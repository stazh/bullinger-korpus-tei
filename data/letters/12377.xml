	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Scripsi ad te,<note xml:id="fn1" type="footnote" n="1">Nr. 2328 vom 6. Januar 1546.</note> mi venerande et charissime frater, nudius tertius<note xml:id="fn2" type="footnote" n="2">Am 7. Januar.</note> <lb xml:id="p1z3"/>per lanios nostros simul et eas literas, quas <persName ref="p8354">Lętus</persName> dedit,<note xml:id="fn3" type="footnote" n="3"><persName ref="p8354">Frölichs</persName> Brief an <persName ref="p495">Bullinger</persName> vom 25. Dezember 1545 <hi>(HBBW</hi> XV, <ref target="file12360">Nr. 2313</ref>).</note> per <lb xml:id="p1z4"/>hos misi.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="3" xml:lang="la">Nunc nihil aliud quam vehementer gratulor <placeName ref="l18">Augustanis</placeName> <lb xml:id="p1z5"/>meis <persName ref="p8018">Hallerum</persName> nostrum<note xml:id="fn4" type="footnote" n="4">Zur Anstellung <persName ref="p8018">Johannes Hallers</persName> in <placeName ref="l18">Augsburg</placeName> s. <ref target="file12370">Nr. 2323</ref>,1f.</note>, qui ita mihi a doctrina docendique <lb xml:id="p1z6"/>perspicuitate, a modestia, innocentia morum et singulari pietate <lb xml:id="p1z7"/>commendatur idque ab optimis nec vulgaris iudicii hominibus<note xml:id="fn5" type="footnote" n="5">Unter ihnen <persName ref="p8173">Sixt Birck</persName> in einem Brief vom 4. Januar 1546 <hi>(<persName ref="p8055">Blarer</persName> BW</hi> II 406, <ref target="file11280">Nr. 1237</ref>).</note>, <lb xml:id="p1z8"/>ut nec vos egregii huius dati nec <placeName ref="l18">Augustanos</placeName> accepti <lb xml:id="p1z9"/>pęnitere unquam possit.</s>
					<s n="4" xml:lang="la">Tu animos illi addes, ut quorundam <lb xml:id="p1z10"/>odium et invidiam, quę praeclaras virtutes perpetuo ceu umbra corpus <lb xml:id="p1z11"/>consequuntur, infracto animo et excelso spiritu perferat ac vincat, <lb xml:id="p1z12"/>sibique abunde satis esse ducat, si optimis et dei filiis placeat, <lb xml:id="p1z13"/>quamquam ita omnino mihi animus iuvenis comparatus videtur, <lb xml:id="p1z14"/>ut suapte sponte absque ullius stimulis pulchre sit perrecturus.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Tam sunt iam nostri senatus molestę occupationes, ut nondum <lb xml:id="p1z16"/>lectum sit <persName ref="p1974">Lutheri</persName>, <persName ref="p2095">Philippi</persName> et <persName ref="p4443">Pomerani</persName> consilium<note xml:id="fn6" type="footnote" n="6">Das Gutachten von <persName ref="p1974">Martin Luther</persName>, <persName ref="p2095">Philipp Melanchthon</persName>, <persName ref="p4443">Johannes Bugenhagen</persName>, <persName ref="p4587">Kaspar Cruciger</persName> und <persName ref="p5733">Georg Maior</persName> zur Erstreckung des <placeName ref="l1202">Schmalkaldischen</placeName> Bundes; s. <ref target="file12375">Nr. 2328</ref>, Anm. 15. Die Verlesung vor dem <placeName ref="l257">Konstanzer</placeName> Rat erfolgte erst am 11. Januar; s. <ref target="file12375">Nr. 2328</ref>, Anm. 16.</note>, de quo ad <lb xml:id="p1z17"/>te, ubi primum, quid sit, rescivero, scribam<note xml:id="fn7" type="footnote" n="7"><persName ref="p8055">Blarer</persName> schrieb darüber am 27. Januar (<ref target="file12382">Nr. 2335</ref>,2-5).</note>.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="6" xml:lang="la" ana="farewell">Bene vale, mi <lb xml:id="p1z18"/>charissime et optime <persName ref="p495">Bullingere</persName>, cum omnibus tuis.</s>
					<s n="7" xml:lang="la">Ora pro me <lb xml:id="p1z19"/>nostraque ecclesia dominum, ne unquam tueri ac fovere nos cesset.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z20"/>Saluta fratres et amicos, cumprimis <persName ref="p8171">Theodorum</persName><note xml:id="fn8" type="footnote" n="8"><persName ref="p8171">Theodor Bibliander</persName>.</note>, <persName ref="p8011">Gvaltherum</persName> <lb xml:id="p1z21"/>et <persName ref="p8127">Pellicanum</persName>.</s>
					<s n="9" xml:lang="la">Commendo tibi diligenter <persName ref="p8472">Curionem</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p8472">Konrad Hofherr</persName>.</note> et <persName ref="p5829">Mezlerum</persName><note xml:id="fn10" type="footnote" n="10"><persName ref="p5829">Jakob Metzler</persName>.</note> nostros<note xml:id="fn11" type="footnote" n="11">1545 waren <persName ref="p8472">Hofherr</persName> und <persName ref="p5829">Metzler</persName> auf Empfehlung <persName ref="p8055">Blarers</persName> zum Studium nach <placeName ref="l587">Zürich</placeName> gekommen, s. <bibl source="b18">HBBW XV</bibl> passim.</note>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z22"/>Bene vale.</s>
					<s n="11" xml:lang="la">9. ianuarii 1546.</s>
					<s n="12" xml:lang="la" ana="salute">Salutat te seque tibi commendat <persName ref="p4082">Zviccius</persName><note xml:id="fn12" type="footnote" n="12"><persName ref="p4082">Konrad Zwick</persName>.</note>.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z23"/>Tuus <persName ref="p8055">Ambr. Bl.</persName></s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>amico et fratri incomparabili<note xml:id="fn13" type="footnote" n="13">Dieser Brief wurde <persName ref="p8018">Johannes Haller</persName> auf seiner Durchreise durch <placeName ref="l257">Konstanz</placeName> anvertraut; vgl. oben Z. 3-7 und <bibl source="b18">HBBW XV</bibl> 692 und Anm. 1.</note>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>