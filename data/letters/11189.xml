					<msContents>
						<summary>
							<p xml:id="regest1">Sieht sich im Schmerz um seine Schwester vorläufig außerstande, <persName ref="p8011" cert="high">Rudolf [Gwalther]</persName> bei sich aufzunehmen. <persName ref="p8459" cert="high">Otto [Werdmüller]</persName> hat <persName ref="p8465" cert="high">Melchior [Wirz]</persName> als Leiter des Pädagogiums abgelöst. <persName ref="p1365" cert="high">Grynäus</persName> hat an <persName ref="p1974" cert="high">Luther</persName> geschrieben. Grüße.</p>
						</summary>
						<msItem>
							<textLang>Latein</textLang>
						</msItem>
					</msContents>
