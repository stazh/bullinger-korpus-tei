	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Postquam priores ad te datas obsignavissem, <lb xml:id="p1z2"/>en libellum apportat compactor.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Protinus ergo ad<lb xml:id="p1z3"/>iungo libello epistolam brevem, quam hic vides; <lb xml:id="p1z4"/>primas enim eius lineas hic inclusi, ut, quid <lb xml:id="p1z5"/>scripserim, videas.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">In tui gratiam scripsi alioqui <lb xml:id="p1z6"/>nihil ad ipsum scripturus; stat igitur hoc, quicquid <lb xml:id="p1z7"/>est, in tua manu.</s>
					<s n="5" xml:lang="la">Si ita videtur, tradito illi; si <lb xml:id="p1z8"/>non probatur, servato tibi, copiam tamen aut <lb xml:id="p1z9"/>ipsam etiam epistolam ad me remitte; libellum <lb xml:id="p1z10"/>dona, cui volueris.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
					<s n="7" xml:lang="la">9. martii 1565<lb xml:id="p1z12"/>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p8009">Ioanni Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae minis<lb xml:id="p2z4"/>tro, domino et fratri <lb xml:id="p2z5"/>meo colendo et dilecto.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
