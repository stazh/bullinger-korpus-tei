	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Quanquam nunc varie multumque impedirer, <lb xml:id="p1z2"/>nolui tamen committere, quin aliquid ad te scriberem, quo <lb xml:id="p1z4"/>animi erga te mei propensionem aliquo saltem modo declararem.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Porro progressum nostrę hic ecclesię adeo fęliciter ce<lb xml:id="p1z6"/>dere nobis te sane celare non possum, quo nomine <lb xml:id="p1z7"/>est, quod immortales agamus gratias deo optimo maximo.</s>
					<s n="4" xml:lang="la">Is <lb xml:id="p1z8"/>vero ita ex animi nostri succedit sententia, ut meliorem <lb xml:id="p1z9"/>vixdum optare liceat.</s>
					<s n="5" xml:lang="la"><persName ref="p8415">Martinus</persName> noster plane viriliter <lb xml:id="p1z10"/>perfungitur suo munere, qui fideliter, prudenter diligenter<lb xml:id="p1z11"/>que omnia sua persequi<lb xml:id="p1z12"/>tur.</s>
					<s n="6" xml:lang="la">D. <persName ref="p1560">Hoperum</persName>, espicopum <lb xml:id="p1z13"/><placeName ref="l567">Vigorniensem</placeName>, ante quatuor menses hinc sum comitatus <lb xml:id="p1z14"/><placeName ref="l567">Vigorniam</placeName>, cui adfui ad septem fere hebdomadas; <lb xml:id="p1z15"/>eius vero fidem studiumque satis commendare non possum.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>Dominus deus fructuosum reddat eius ministerium, quo <lb xml:id="p1z17"/>eventus rei votis studiisque hominis respondeat.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z18"/>Hic nunc a paucis saltem diebus subortę sunt turbę <lb xml:id="p1z19"/>quędam inter episcopos ex concione pii cuiusdam viri, <lb xml:id="p1z20"/>concionatoris ducis <placeName ref="l2590">Nortumbrię</placeName>, quam habuit <lb xml:id="p1z21"/>coram rege ac consiliariis eius, in qua vere libere <lb xml:id="p1z22"/>invectus est in geniculationem cęne dominicę, quę <lb xml:id="p1z23"/>hic etiamnum inter <placeName ref="l830">Anglos</placeName> adhuc servatur.</s>
					<s n="9" xml:lang="la">Ille <lb xml:id="p1z24"/>tamen vir bonus, Scotus natione, ita affecit multorum <lb xml:id="p1z25"/>animos, ut speremus aliquid boni inde tandem ad <lb xml:id="p1z26"/>ecclesiam rediturum esse.</s>
					<s n="10" xml:lang="la">Quod ut faxit dominus <lb xml:id="p1z27"/>etiam atque etiam rogo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">D. <persName ref="p8041">a Lasco</persName> acce<lb xml:id="p1z28"/>pit iam nunc literas ab aliquot proceribus regni <lb xml:id="p1z29"/><placeName ref="l2472">Polonię</placeName> ac magnę <placeName ref="l841">Lithuanię</placeName> nec non et ab <lb xml:id="p1z30"/>ipso <persName ref="p1825">Polonię rege</persName> accepit literas omnimodę humanitatis <lb xml:id="p1z31"/>plenas, quibus omnibus invitatur ille, ut <lb xml:id="p1z32"/>veniat in <placeName ref="l2472">Poloniam</placeName> sub comitia publica <lb xml:id="p1z33"/>illius regni, quę circa regum ad r<pb/><lb xml:id="p2z1"/>eformandam religionem sunt indicta.</s>
					<s n="12" xml:lang="la">Illud vero <lb xml:id="p2z2"/>imprimis cupiunt (ad evitandam omnem suspicionem <lb xml:id="p2z3"/>ab adversariis fidei) ut per occasionem aliquam tanquam <lb xml:id="p2z4"/>legatus a rege nostro eo mittatur.</s>
					<s n="13" xml:lang="la">Quę res hodie <lb xml:id="p2z5"/>primum duci <placeName ref="l2590">Nortumbrię</placeName> ab <persName ref="p674">archiepiscopo Cantuariensi</persName> est <lb xml:id="p2z6"/>proposita.</s>
					<s n="14" xml:lang="la">Faxit dominus, ut cedat ad sui nominis gloriam.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z7"/>D. <persName ref="p8041">a Lasco</persName> ac d. <persName ref="p8415">Martinus</persName>, qui varie nunc distringunt<lb xml:id="p2z8"/>ur, cupiunt apud te excusari, quod nihil scribant.</s>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p2z9"/>Interim peramanter te voluerunt salutatum.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Saluta <lb xml:id="p2z10"/>mihi quaeso d. <persName ref="p8171">Bibliandrum</persName> ac reliquos mihi isthic <lb xml:id="p2z11"/>notos patres ac fratres, ut interim d. <persName ref="p506">Butleri</persName> mentionem <lb xml:id="p2z12"/>faciam.</s>
					<s n="18" xml:lang="la" ana="farewell">Vale, mi domine <persName ref="p495">Bul[l]ingere</persName> animo meo <lb xml:id="p2z13"/>charissime observantissimeque in domino, cui ego <lb xml:id="p2z14"/>ministerium tuum commendo ex animo.</s>
					<s n="19" xml:lang="la"><placeName ref="l296">Londini</placeName> <lb xml:id="p2z15"/>12. octobris 1552.</s>
					<s n="20" xml:lang="la">Ex aedibus d. <persName ref="p8041">a Lasco</persName>, cui convivo.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z16"/>Tuus vere et ex animo <lb xml:id="p2z17"/><persName ref="p8061">Io[annes] Utenhovius</persName><pb/><lb xml:id="p3z1"/>.</s>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro domino <lb xml:id="p4z2"/><persName ref="p495">Henricho Bul[l]ingero</persName>, <lb xml:id="p4z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori <lb xml:id="p4z4"/>vigilantissimo, amico ac <lb xml:id="p4z5"/>fratri multo carissimo.</s>
				</p>
				<p>
					<note type="author">[Darunter von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="23" xml:lang="la">"<persName ref="p8061">Utenhoffius</persName>."</s>
				</p>
			</div>
