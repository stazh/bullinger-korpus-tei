	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Utrasque tuas et penultima aprilis et 4. maii <lb xml:id="p1z2"/>datas accepi, et nihil est, quod ad illas respondeam, <lb xml:id="p1z3"/>nisi quod d. <persName ref="p8417">Musculi</persName> uxor paulatim revalescit <lb xml:id="p1z4"/>iterum, domino sit laus, quamvis satis adhuc sit <lb xml:id="p1z5"/>debilis.</s>
					<s n="3" xml:lang="la" ana="salute">Resalutat te cum suis omnibus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Quae vis, <lb xml:id="p1z7"/>ut scribam <persName ref="p2919">Michaeli Schlattero</persName>, curabo.</s>
				</p>
				<p>
					<s n="5" xml:lang="de"><foreign xml:lang="la">Caeterum <lb xml:id="p1z8"/>interea</foreign> <lb xml:id="p1z9"/>hatt der küng uß <placeName ref="l832">Franckrych</placeName> gester minen herren zuͦ gschriben <lb xml:id="p1z10"/>under anderem, das der bapst selbst an <lb xml:id="p1z11"/>keiser beger uffschlag deß concilij biß uff den ersten <lb xml:id="p1z12"/>tag septembris, demnach das er Parma dem <lb xml:id="p1z13"/>römschen stuͦl wider inhendig mache.</s>
					<s n="6" xml:lang="de">Das welle der <lb xml:id="p1z14"/>keiser nitt thuͦn, und achte er deßhalb, das uß dem <lb xml:id="p1z15"/>concilio gar nützit werde.</s>
					<s n="7" xml:lang="de">Darbi schript er auch, <lb xml:id="p1z16"/>das <placeName ref="l303">Meidenburg</placeName> noch starck halte und innert wenig <lb xml:id="p1z17"/>tagen <persName ref="p18250">hertzog Moritzen</persName> vil volkh erschlagen und 6 <lb xml:id="p1z18"/>stuck büchßen eroberet habind.</s>
					<s n="8" xml:lang="la">Haec ille.</s>
				</p>
				<p>
					<s n="9" xml:lang="de"><lb xml:id="p1z19"/>Hütt kumpt mir schriben von <persName ref="p1010">Erbio</persName> von <placeName ref="l411">Richenwyl</placeName>, <lb xml:id="p1z20"/><foreign xml:lang="la">qui inter alia haec:</foreign></s>
					<s n="10" xml:lang="la">"Studiosi ex <placeName ref="l558">Wittenberga</placeName> discedent<lb xml:id="p1z21"/>es ad nos veniunt referentes <persName ref="p2095">Philippum Melanchtonem</persName> <lb xml:id="p1z22"/>et <persName ref="p4443">Pomeranum</persName> gymnasium reliquisse et nunc agere <lb xml:id="p1z23"/>cum duobus capti ducis filiis in <placeName ref="l537">Weinmar</placeName>, propterea <lb xml:id="p1z24"/>quod <persName ref="p18250">Mauritius</persName> <placeName ref="l558">Wittenbergae</placeName> papisticas restituerit <lb xml:id="p1z25"/>ceremonias.</s>
					<s n="11" xml:lang="la"><placeName ref="l303">Magdeburgenses</placeName> obsessi non morantur <lb xml:id="p1z26"/>adversariorum minas.</s>
					<s n="12" xml:lang="la">Caesar, cadaver vivum, <lb xml:id="p1z27"/>solus cum mitratis illis est <placeName ref="l18">Augustae</placeName>.</s>
					<s n="13" xml:lang="la"><persName ref="p18477">Ferdinandus</persName> <lb xml:id="p1z28"/>cum <persName ref="p18575">Philippo</persName> <placeName ref="l875">Hispanico</placeName> certat de regno; ille ait <lb xml:id="p1z29"/>se creatum in Caesarem a proceribus <placeName ref="l822">Germanię</placeName>, is <lb xml:id="p1z30"/>vero se natum Cęsarem; certum est."</s>
					<s n="14" xml:lang="la">Haec <persName ref="p1010">Erbius</persName>.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z31"/>Nihil praeterea nunc habeo.</s>
					<s n="16" xml:lang="la">Oremus, oremus, oremus <lb xml:id="p1z32"/>extendentes puras per poenitentiam manus ad <lb xml:id="p1z33"/>dominum, si forte misereatur nostri et parcat.</s>
					<s n="17" xml:lang="la" ana="farewell">Vale.</s>
					<s n="18" xml:lang="la" ana="salute"><lb xml:id="p1z34"/>Salutem ex me dominis et fratribus omnibus atque uxori <lb xml:id="p1z35"/>et universae familiae dicas.</s>
					<s n="19" xml:lang="la"><placeName ref="l41">Bernae</placeName> die ascensionis <lb xml:id="p1z36"/>dominicę 1551.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><persName ref="p8018">Io[<lb xml:id="p1z37"/>annes] Hallerus</persName> tuus.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z38"/>Velim te ad d. <persName ref="p8012">Hallerum</persName> quaestorem scribere eique <lb xml:id="p1z39"/>gratias agere pro liberalitate <persName ref="p8417">Musculo</persName> praestita.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Fidelissimo Christi domini et <lb xml:id="p2z2"/>ecclesiae ministro domino <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, pastori <lb xml:id="p2z4"/>ecclesiae <placeName ref="l587">Tigurinae</placeName>, domino et <lb xml:id="p2z5"/>compatri suo venerando.</s>
				</p>
				<p>
					<s n="23" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zürich</placeName> an m. <persName ref="p495">Heinryc<lb xml:id="p2z7"/>h Bullinger</persName>.</s>
				</p>
			</div>
		</body>
