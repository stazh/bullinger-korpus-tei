	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. <lb xml:id="p1z2"/>D.</s>
					<s n="2" xml:lang="la">Illustris dominus marchio comes <lb xml:id="p1z3"/>Vici a <placeName ref="l994">Neapoli</placeName>, qui hasce tibi, colendissime <lb xml:id="p1z4"/>mi <persName>Frideryche</persName> offert, <placeName ref="l167">Genevae</placeName> habitat <lb xml:id="p1z5"/>et commendatur mihi de meliore nota a multis <lb xml:id="p1z6"/>viris bonis.</s>
					<s n="3" xml:lang="la">Ego quoque novi ipsum iam <lb xml:id="p1z7"/>annis aliquot; pius est multisque donis <lb xml:id="p1z8"/>instructus; dignus est, quem viri boni iuvent.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Hunc ergo et socero tuo, viro amplissimo d. <lb xml:id="p1z10"/><persName ref="p6831">Ioanni Traverso</persName>, et tibi commendo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Cuperet <lb xml:id="p1z11"/>recipi in societatem <placeName ref="l648">Rhetorum</placeName>, quo gau<lb xml:id="p1z12"/>dere posset privilegio dominorum <placeName ref="l522">(Vene)torum</placeName> (te <lb xml:id="p1z13"/>in)tercessore <placeName ref="l648">Rhetis</placeName> concesso.</s>
					<s n="6" xml:lang="la">Fac ergo, mi amice <lb xml:id="p1z14"/>et frater, ut sentiat meam commendationem <lb xml:id="p1z15"/>ipsi fuisse utilem.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Nihil praeterea, quod <lb xml:id="p1z16"/>scribam, habeo; cupio ergo te cum tuis optim<lb xml:id="p1z17"/>e valere.</s>
					<s n="8" xml:lang="la" ana="salute">Salvus et incolumis est <persName>Ioannes</persName> <lb xml:id="p1z18"/>cum <persName ref="p1410">Hectore</persName>; salutant vos omnes.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/><placeName ref="l587">Tiguri</placeName> 18. martii anno 1558.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z8"/>Clarissimo viro d. <persName ref="p8432">Fride<lb xml:id="p2z9"/>rycho a Salice</persName>, <placeName ref="l648">Rheto</placeName> <lb xml:id="p2z10"/><placeName ref="l440">Samadeni</placeName> in <placeName ref="l638">Ingadina</placeName> <lb xml:id="p2z11"/>agenti, domino suo <lb xml:id="p2z12"/>colendo et fratri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>