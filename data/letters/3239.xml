	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Laboravi <lb xml:id="p1z2"/>diligenter pro impetrandis ad principes literis.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Legationem enim non mittendam facile intellig<lb xml:id="p1z4"/>ebam.</s>
					<s n="3" xml:lang="la">Sed non successit quod institui.</s>
					<s n="4" xml:lang="la">Senatus <lb xml:id="p1z5"/>noster amplissimus, sicuti(?) et <placeName ref="l41">Bernensis</placeName>, non putavit hic <lb xml:id="p1z6"/>sibi agendum quicquam.</s>
					<s n="5" xml:lang="la">Interea mittitur ad d. <persName ref="p8111">Petrum <lb xml:id="p1z7"/>Martyrem</persName> confessio a te in legatione propter fratres <lb xml:id="p1z8"/><placeName ref="l2469">Waldenses</placeName> suscepta ad principes apud eosdem <lb xml:id="p1z9"/>deposita.</s>
					<s n="6" xml:lang="la">Quae si a te concepta et exhibita est, ad<lb xml:id="p1z10"/>monitos saltem eius rei nos oportuerat.</s>
					<s n="7" xml:lang="la">Spargi <lb xml:id="p1z11"/>eam audimus magno cum adversariorum iubilo <lb xml:id="p1z12"/>nostrorumque dolore.</s>
					<s n="8" xml:lang="la">Sic a <placeName ref="l157">Francfordia</placeName> et <placeName ref="l210">Hay<lb xml:id="p1z13"/>delberga</placeName> nunciatur.</s>
					<s n="9" xml:lang="la">Confessiones decet esse claras <lb xml:id="p1z14"/>et minime involutas aut ancipites, in iis praeci<lb xml:id="p1z15"/>pue de quibus contravertitur.</s>
					<s n="10" xml:lang="la">Ego certe huiusmodi <lb xml:id="p1z16"/>confessionem neque facerem, neque ab aliis factae aut <lb xml:id="p1z17"/>conscriptae subscriberem.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Cuperem autem a te <lb xml:id="p1z18"/>talem non esse exhibitam, si modo per te est ex<lb xml:id="p1z19"/>hibita.</s>
					<s n="12" xml:lang="la">Idem iudicant mecum et reliqui qui <lb xml:id="p1z20"/>viderunt.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Quanquam paucis adhuc eius facta sit copia.</s>
					<s n="14" xml:lang="la" ana="farewell"><lb xml:id="p1z21"/>Vale.</s>
					<s n="15" xml:lang="la">Salvi sint D. <persName ref="p540">Calvinus</persName>, d. <persName ref="p1049">Pharellus</persName> <lb xml:id="p1z22"/>et reliqui fratres.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 16. iulii 1557<lb xml:id="p1z36"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse... fehlt?]</note>
				</p>
			</div>
		</body>
