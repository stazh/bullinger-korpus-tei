	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Duas decades sermonum tuorum mittente communi amico et domino <persName ref="p8049">Ioachimo <lb xml:id="p1z3"/>Vadiano</persName> hodie accepi; Christus noster vindex sit tua retributio, qui <lb xml:id="p1z4"/>inexhausta sua bonitate nunquam etiam in mediis trubinibus et procellis <lb xml:id="p1z5"/>nos deserit, quin a patre luminum semper prophetas extimulet, <lb xml:id="p1z6"/>qui aliquid lucubrentur, unde consolationem sumamus.</s>
					<s n="3" xml:lang="la">Ego, quia <lb xml:id="p1z7"/>tui sermones ad hęc tempora plurimum factura ex literis <persName ref="p8049">Vadiani</persName> <lb xml:id="p1z8"/>intelligo, in eisdem eo intentius versabor.</s>
					<s n="4" xml:lang="la">Quo se vestri <lb xml:id="p1z9"/>symmiste omnes atque ubi <persName ref="p8417">Musculus</persName> agat et profugi fratres <placeName ref="l491">Argentoratens<lb xml:id="p1z10"/>es</placeName>, lubens scirem.</s>
					<s n="5" xml:lang="la">Ego hic inter Scithas prorsus idolatras dego <lb xml:id="p1z11"/>periculis pluribus expositus.</s>
					<s n="6" xml:lang="la">Numa quidam consului <persName>Egeriam</persName>, quę <lb xml:id="p1z12"/>respondit brevi gentem confluxuram, quę bellica manu conatura <lb xml:id="p1z13"/>sit omnes cis et ultra <placeName ref="l2459">Rhenum</placeName> proximas civitates occupare et <lb xml:id="p1z14"/>postea pactionem non recusaturam.</s>
					<s n="7" xml:lang="la">Hic fama est <persName ref="p8112">Gallum</persName> et <persName ref="p18538">Cesarem</persName> <lb xml:id="p1z15"/>concordiam iniisse, inter <placeName ref="l830">Anglum</placeName> quoque et <persName ref="p18538">Cesarem</persName> bene convenire.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Civitates <placeName ref="l749">Saxonię</placeName>, etiam illę, quę dicionibus <persName ref="p18250">ducis Mauricii</persName> subiacent, <lb xml:id="p1z17"/>deinde quoque <persName ref="p3671">rex Danię</persName>, dux Augustus, frater Mauricii, duces <placeName ref="l743">Pomeranię</placeName> ac marchio <placeName ref="l1048">Brandenburgensis</placeName> <lb xml:id="p1z18"/><persName>Ioannes</persName> novam ecclesię ordinationem Interim nondum rece<lb xml:id="p1z19"/>perunt, mori se potius affirmantes quam in id consensuros.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">De quo <lb xml:id="p1z20"/>parum dubito.</s>
					<s n="10" xml:lang="la">Nihilo minus hic annus illis marcialia ingentia <lb xml:id="p1z21"/>non minatur.</s>
					<s n="11" xml:lang="la">Quidam putant proditorem illum in propria viscera <lb xml:id="p1z22"/>amplius seviturum, sed subtili modo.</s>
					<s n="12" xml:lang="la">uxor legitima landgra<lb xml:id="p1z23"/>phii ab <placeName ref="l213">Hessia</placeName> fertur ad dominum migrasse, ipsum vero datis <lb xml:id="p1z24"/>duobus filiis vadibus ex captivitate brevi liberandum.</s>
					<s n="13" xml:lang="la">Filii <lb xml:id="p1z25"/>capti ducis <persName ref="p19065">Ioannis Friderichi</persName> recusant Interim constanter; prop<lb xml:id="p1z26"/>terea eos patria calamitas manet.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale, mi anime.</s>
					<s n="15" xml:lang="la" ana="salute">Salveant <lb xml:id="p1z27"/>universi fratres, <persName ref="p8011">Gualtherus</persName> etc.</s>
					<s n="16" xml:lang="la">Raptim ex <placeName ref="l245">Kauffburna</placeName> 18. Aprilis <lb xml:id="p1z28"/>1549.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z29"/>T<lb xml:id="p1z30"/>uus <persName ref="p8354">G[<lb xml:id="p1z31"/>eorgius] L[aetus</persName>].</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro D. <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName>, antistiti apud <lb xml:id="p2z3"/><placeName ref="l587">Tigurinos</placeName> vigilantissimo, <lb xml:id="p2z4"/>domino et amico observand<lb xml:id="p2z5"/>issimo.</s>
				</p>
			</div>
		</body>
	</text>
