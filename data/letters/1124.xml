	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Nova, quae apud nos sunt, ex d. <lb xml:id="p1z2"/><persName ref="p2916">Schertlino</persName> fusissime habes, qui ultro se obtulit velle <lb xml:id="p1z3"/>ad te scribere, quae in <placeName ref="l749">Saxonicis</placeName> civitatibus aguntur.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Dominus adiuvet fortes milites illos et spiritu fortitudinis <lb xml:id="p1z5"/>donet, quo omnibus hostibus Christi resistant et ne mo<lb xml:id="p1z6"/>dum per impęnitentem vitam excedant.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/><placeName ref="l749">Saxonum</placeName> animi dubii sunt, et nescio, quo se vertant <lb xml:id="p1z8"/>ob imminens periculum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Mallent <persName ref="p18250">Mauritium</persName>; est ultra <placeName>Caspios</placeName> <lb xml:id="p1z9"/>montes.</s>
					<s n="6" xml:lang="la">Videbimus domini iustum iudicium.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Aiunt <placeName ref="l749">Saxonem</placeName> ducem veterem a <persName ref="p18477">Ferdinando</persName> rege invitatum <lb xml:id="p1z11"/>et inter cętera mentionem fuisse de regis maiestate <lb xml:id="p1z12"/>Romana, quam indeptus est <persName ref="p18477">Ferdinandus</persName> per reliquos electores.</s>
					<s n="8" xml:lang="de"><lb xml:id="p1z13"/>Ad hęc dixit <persName ref="p18477">Ferdinandus</persName>: "Her..., so ir mit mir hetten <lb xml:id="p1z14"/>gholffen die chur k[uniglicher]<note type="margin">a.R.: (c)hen?</note> m[ajestät] bestetigen, so welte ich langist <lb xml:id="p1z15"/>gluͦgt haben, das ir weren ledig von diser captivitet <lb xml:id="p1z16"/>worden."</s>
					<s n="9" xml:lang="la">Quid sibi hoc portendat, non ignoras absque dubio.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z17"/>Legatus regis <placeName ref="l832">Galliae</placeName> hodie ad nos venit; d. <persName ref="p944">Maurus</persName> <lb xml:id="p1z18"/>aliquid novi adportabit et pro <persName ref="p2916">Schertlino</persName> operam dabit, <lb xml:id="p1z19"/>ne eiicietur homo dignus maiori honore.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z20"/><placeName ref="l28">Basileae</placeName> 1550. 29. decembris.</s>
					<s n="13" xml:lang="la">Precor tibi et tuis felicissimum <lb xml:id="p1z21"/>annum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">T[uus] <persName ref="p1278">G[astius</persName>].</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z4"/>pastori vig<lb xml:id="p2z5"/>ilantissimo.</s>
					<s n="16" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
