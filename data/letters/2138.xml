	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Primas tuas accepi cum novis inclusis, <lb xml:id="p1z2"/>pro quibus summas gratias ago; sentio enim tuum <lb xml:id="p1z3"/>propensum erga nos animum, et iam diu <lb xml:id="p1z4"/>respondissem; sed isti milites ita me <lb xml:id="p1z5"/>occuparunt, ut etiam valde necessaria sim <lb xml:id="p1z6"/>coactus intermittere.</s>
					<s n="3" xml:lang="la">Posthac tamen non <lb xml:id="p1z7"/>desiderabis amici officium.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ecce autem <lb xml:id="p1z8"/>secunde tue traduntur, quibus significas <lb xml:id="p1z9"/>de marquione eadem, que ego etiam tuis <lb xml:id="p1z10"/>dominis eodem tempore misi, et gratum <lb xml:id="p1z11"/>est, quod ita, amice omnia communicemus; <lb xml:id="p1z12"/>inde enim veritas Caesarianis incognita pot<lb xml:id="p1z13"/>est dici.</s>
					<s n="5" xml:lang="la">Et cum hanc scriberem, <lb xml:id="p1z14"/>etia<lb xml:id="p1z15"/>m fasciculum d. <persName ref="p3375">Verg[erii]</persName> accepi, <lb xml:id="p1z16"/>quem scio a te dimissum; eadem scribit, <lb xml:id="p1z18"/>sed addit <persName ref="p18250">Mauricium</persName> mortuum, quod <lb xml:id="p1z19"/>nondum credo; habeo enim hodie a <lb xml:id="p1z20"/><placeName ref="l361">Nuremberga</placeName> literas recentes, que de is<lb xml:id="p1z21"/>tis multam faciunt mentionem<lb xml:id="p1z22"/>.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z23"/>Sed preterea, se brevi in Rethia fore et, si quid velim<lb xml:id="p1z24"/>, petit, ut meas litera<lb xml:id="p1z25"/>s ad legatu<pb/><lb xml:id="p2z1"/>m nostrum legatum mittam, quod sum <lb xml:id="p2z2"/>facturus prima occasione; pollicetur <lb xml:id="p2z3"/>enim se illuc venturum intra 12 di<lb xml:id="p2z4"/>es, et miror, quod in transitu <lb xml:id="p2z5"/>non sit te invisurus.</s>
					<s n="7" xml:lang="la">Quodsi <lb xml:id="p2z6"/>aliter accidat, ei, si placet, <lb xml:id="p2z7"/>significabis me quatuor tuos <lb xml:id="p2z9"/><placeName ref="l572">Wirttembergenses</placeName> fasciculos accepisse, <lb xml:id="p2z10"/>sed libellum illum, de quo in ultimis <lb xml:id="p2z11"/>mentionem facit, non recepi, et est, <lb xml:id="p2z12"/>credo, oblitus.</s>
					<s n="8" xml:lang="la">Expectas a me nova: <lb xml:id="p2z13"/>habebis ex memoriali hic incluso <lb xml:id="p2z14"/>omnia verissima; <lb xml:id="p2z15"/>leges, p<lb xml:id="p2z16"/>ostea autem <lb xml:id="p2z17"/>magistratui et consilio meo nomine <lb xml:id="p2z18"/>dabis; alias proprium misissem.</s>
					<s n="9" xml:lang="la">Egre <lb xml:id="p2z19"/>ferimus mortem illius iuvenis regis, qui in <lb xml:id="p2z20"/>futurum multa propter <lb xml:id="p2z22"/>summam affinitatem et amicitiam potuisset <lb xml:id="p2z23"/>apud nostros.</s>
					<s n="10" xml:lang="la">Sunt <persName ref="p18538">Cesaris</persName> artes, <lb xml:id="p2z24"/>cuius furor et practica nemin<lb xml:id="p2z25"/>i <lb xml:id="p2z27"/>parcunt.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z28"/>Dominus si<lb xml:id="p2z29"/>t iudex.</s>
					<s n="12" xml:lang="la">Rex <lb xml:id="p2z30"/>cum <pb/><lb xml:id="p3z1"/>potentissimo exercitu properat versus <lb xml:id="p3z2"/><persName>Hesdin</persName>, quod si <persName>Cesariani</persName> expectant, <lb xml:id="p3z3"/>magno prelio brevi pugnabitur.</s>
					<s n="13" xml:lang="la">In <lb xml:id="p3z4"/><placeName ref="l736">Pedemontio</placeName> omnia pro[s]pera; noster exercitus <lb xml:id="p3z5"/>decem civitates et aliquot castra <lb xml:id="p3z6"/>et deditione accepit et semper <lb xml:id="p3z7"/>properat.</s>
					<s n="14" xml:lang="la"><persName>Caesar</persName> voluit colligere illic e<lb xml:id="p3z8"/>xercitum, sed quia pecunie desunt, <lb xml:id="p3z9"/>nemo vult adesse nec promissa sequi.</s>
					<s n="15" xml:lang="la"><lb xml:id="p3z10"/>Redii ex <placeName ref="l922">Friburgo</placeName> et sum per mensem hic <lb xml:id="p3z11"/>hesurus; fac interea, ut gratissimas <lb xml:id="p3z12"/>tuas literas sepe, et cum licebit, habeam.</s>
					<s n="16" xml:lang="la" ana="farewell"><lb xml:id="p3z13"/>Vale optime.</s>
					<s n="17" xml:lang="la"><placeName ref="l760">Soluturi</placeName> hoc die <lb xml:id="p3z14"/>Mercurii raptim.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p3z15"/>Tuus semper <persName ref="p8296">Bas[safontaneus]</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Princeps <placeName>Salernitanus</placeName> <lb xml:id="p3z16"/>occupa<lb xml:id="p3z17"/>t cum exercitu <placeName ref="l2510">Turcico</placeName> totum <lb xml:id="p3z18"/>mare mediterraneum, ita <lb xml:id="p3z19"/>quod filius Caesaris non sit ausus transire, et quia sentit nullam am<lb xml:id="p3z20"/>plius spem esse in matrimonio Anglicano, ut sperabat, incipit agere cum <persName>rege <lb xml:id="p3z21"/>Portugalie</persName>, ut filiam ducat.</s>
				</p>
				<p>
					<note>[Auf d. vorangeh. Seite unten a. R.:]</note>
					<s n="20" xml:lang="la">Scripsissem ante multos dies <persName ref="p3375">[Ver]g[e<lb xml:id="p3z22"/>rio]</persName> in ducatum <placeName ref="l572">Wirttembergensem</placeName>; sed semper mihi significavit se <lb xml:id="p3z23"/>nolle [ibi] diu [hae]rere.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p4z1"/>Optimo viro domino <lb xml:id="p4z2"/><persName ref="p495">Bulingero</persName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p4z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
