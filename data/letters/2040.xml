	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Accepi a <persName ref="p714">Cęlio</persName>, socero meo, libellum <lb xml:id="p1z2"/>tuum de cęna abs te pro tua liberalitate <lb xml:id="p1z3"/>mihi dono datum.</s>
					<s n="3" xml:lang="la">Qui quam gratis <lb xml:id="p1z4"/>mihi fuerit, non possum dicere; nam cum <lb xml:id="p1z5"/>omnes tui libri, quos hactenus mihi videre <lb xml:id="p1z6"/>licuit (vidi nunc permultum non solum dili<lb xml:id="p1z7"/>genter, sed etiam libenter), grati mihi, adde et u<lb xml:id="p1z8"/>tiles propter eximiam et christianam tuam <lb xml:id="p1z9"/>in illis erud<lb xml:id="p1z10"/>itionem semper fuerint, <lb xml:id="p1z11"/>tum <lb xml:id="p1z12"/>vero hic libellus nunc quam maxime idque pro<lb xml:id="p1z13"/>pter ea quod non solum ut reliqui tui omnes, optimam <lb xml:id="p1z14"/>et vere piam doctrinam continet, verum etiam <lb xml:id="p1z15"/>quia et mihi symbolum et aliis testim<lb xml:id="p1z16"/>onium <lb xml:id="p1z17"/>fuit benevolentię erga me tuę, dum te <lb xml:id="p1z18"/>mei esse memorem <lb xml:id="p1z19"/>hoc ad me misso <lb xml:id="p1z20"/>libello aperte declarasti.</s>
					<s n="4" xml:lang="la">Quid autem mih<lb xml:id="p1z21"/>i <lb xml:id="p1z22"/>gratius contingere potuit, <lb xml:id="p1z23"/>quam videre me a tanto <lb xml:id="p1z24"/>viro diligi atque in cęterorum amicorum suorum <lb xml:id="p1z25"/>numero haberi?</s>
					<s n="5" xml:lang="la">Ergo gratias ago pro <lb xml:id="p1z26"/>libello quidem magnas, pro amore autem et opere maxim<lb xml:id="p1z27"/>as et obsecro, ut pergas tua me benevo<lb xml:id="p1z28"/>lentia prosequi, quandoquidem a me vicissim ut <lb xml:id="p1z29"/>pater a filio maximopere observaris.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z31"/>Filius tuus bene valet, egregie (ut audio) <lb xml:id="p1z32"/>bonis literis [...] et ab omnibus bonis (ut <pb/><lb xml:id="p2z1"/>debet) cum propter virtutes suas optimamque <lb xml:id="p2z2"/>indolem tum propter te valde diligitur.</s>
					<s n="7" xml:lang="la">Ego <lb xml:id="p2z3"/>(ut de aliis taceam) nulla in re, quod <lb xml:id="p2z4"/>ad me attinet, deesse illo potero.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p2z5"/>De spe vero obtinendę apud amicum illum <lb xml:id="p2z6"/>(de quo tecum, istic cum essem) verę <foreign xml:lang="el">περὶ <lb xml:id="p2z7"/>τοῦ κυριακοῦ δείπνου</foreign> sententię, etsi non <lb xml:id="p2z8"/>omnino mihi est adempta, debilitatem tamen <lb xml:id="p2z9"/>eam nescio quo pacto post reditum meum <lb xml:id="p2z10"/>inveni.</s>
					<s n="9" xml:lang="la">Quamdiu enim abfui (ut tu optime di<lb xml:id="p2z11"/>vinasti), non defuit Satan [.<lb xml:id="p2z12"/>..] <note type="misc">[zwei hebräisch geschr. Worte "aschär satan"]</note>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z13"/>Rogandus <lb xml:id="p2z14"/>igitur a vobis est dominus, ut omnia im<lb xml:id="p2z15"/>pedimenta auferat doctrinę suę promovendę.</s>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p2z16"/>Vale et me ama salutatoque doctos <lb xml:id="p2z17"/>istos et pios viros.</s>
					<s n="12" xml:lang="la" ana="salute">Uxor mea <lb xml:id="p2z18"/>bene valet tibique ex animo multam precatur <lb xml:id="p2z21"/>salutem.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z22"/><placeName ref="l491">Argentina</placeName> 16. octobris 1553.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z23"/>Tui studiosissimus <lb xml:id="p2z24"/><persName ref="p4037">Hieronymus <lb xml:id="p2z25"/>Zanc<pb/><lb xml:id="p4z1"/>hus</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p4z2"/>Ornatissimo dignissimoque <placeName ref="l587">Tigurinę</placeName> ecclesię <lb xml:id="p4z3"/>pastori, d. <persName ref="p495">Henrico Bullingero</persName> <lb xml:id="p4z4"/>[pa]tri meo observandissimo et colendissimo.</s>
					<s n="16" xml:lang="la"><lb xml:id="p4z5"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
