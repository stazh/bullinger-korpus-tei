	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Si vera spargit fama, colendissime <persName ref="p540">Calvine</persName>, non <lb xml:id="p1z2"/><placeName ref="l167">Genevę</placeName> tibi hae meae offeruntur, cum dudum sis pr<lb xml:id="p1z3"/>ofectus in <placeName ref="l832">Galliam</placeName>.</s>
					<s n="3" xml:lang="la">Dicitur enim rex neminem <lb xml:id="p1z4"/>missurum in concilium <placeName ref="l1107">Tridentinum</placeName>, insuper nationale <lb xml:id="p1z5"/>celebraturus in <placeName ref="l832">Gallia</placeName>, ad quod te cum nonnullis <lb xml:id="p1z6"/>aliis evocarit.</s>
					<s n="4" xml:lang="la">Ego multas ob c[aus]as omnia illa <lb xml:id="p1z7"/>plane vana esse credo, nisi certiora a te edoctus <lb xml:id="p1z8"/>fuero.</s>
					<s n="5" xml:lang="la">O quam gratum esset nuncium, quod vera <lb xml:id="p1z9"/>esse nunciaret.</s>
					<s n="6" xml:lang="la">Video autem raros in hoc mun<lb xml:id="p1z10"/>do esse principes qui non adhaereant Antichristo, <lb xml:id="p1z11"/>et hunc Christo oppresso regnare cupiant.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ex <placeName ref="l834">Italia</placeName> <lb xml:id="p1z12"/>scribitur concilium omnino procedere adeoque pontificem <lb xml:id="p1z13"/>festinare et in hoc esse totum ut salvis <lb xml:id="p1z14"/>7 sessionibus habitis alias mox coniungat.</s>
					<s n="8" xml:lang="la">Fervet <lb xml:id="p1z15"/>persequ[u]tio in <placeName ref="l834">Italia</placeName>, id quod ex cive hoc <lb xml:id="p1z16"/>Cremonense intelliges qui mihi commendatus est a <lb xml:id="p1z17"/><persName ref="p3375">Vergerio</persName> nostro<note type="margin">a.R.: nostra.</note>.</s>
					<s n="9" xml:lang="la">Commendarem eundem etiam tibi nisi <lb xml:id="p1z18"/>perspectissima mihi esset tua charitas atque <lb xml:id="p1z19"/>humanitas.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Struuntur nobis insidię, frater.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/>Vigilemus itaque et oremus.</s>
					<s n="12" xml:lang="la">Non deseret nos dominus, <lb xml:id="p1z21"/>modo ipsi per eius gratiam constanter adhaereamus.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Mitto tibi quae a d. <persName ref="p3375">Vergerio</persName> accepi, tecum <lb xml:id="p1z23"/>autem communico tanquam <lb xml:id="p1z24"/>cum intimo meo et <lb xml:id="p1z25"/>coniunctissimo fratre.</s>
					<s n="14" xml:lang="la"><placeName ref="l834">Italica</placeName> non intelligo: alterum tamen <lb xml:id="p1z26"/>exemplum pro me retinui.</s>
					<s n="15" xml:lang="la">Nam duo misit.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z27"/>Miror an Decadem nostram 5. acceperis.</s>
					<s n="17" xml:lang="la">Certo <lb xml:id="p1z28"/>enim illam per <placeName ref="l834">Italum</placeName> quendam misi.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Consensionem <lb xml:id="p1z29"/>nostram in gemanicam verti, cuius exemplum <lb xml:id="p1z30"/>hic mitto, ne ulla re nostra careas.</s>
					<s n="19" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z31"/>aeternum, colendissime frater.</s>
					<s n="20" xml:lang="la" ana="salute">Commenda me d. <lb xml:id="p1z32"/>a <placeName ref="l631">Burgundia</placeName> et caeteris fratribus.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 29. <lb xml:id="p1z33"/>aprilis anno 1551.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z34"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p540">Ioanni <lb xml:id="p2z2"/>Calvino</persName> <placeName ref="l167">Genevensis</placeName> ecclesiae <lb xml:id="p2z3"/>fido pastori domino suo <lb xml:id="p2z4"/>colendissimo et fratri charissimo.</s>
				</p>
				<p>
					<s n="24" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l167">Genff</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
