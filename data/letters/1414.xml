	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z23"/>Has literas a 6. septembris mecum habui, sed nullum commodum <lb xml:id="p1z24"/>nunctium habere potui, quo eas ad te darem; omnes enim mercatores <placeName ref="l157">Francfordiam</placeName> <lb xml:id="p1z25"/>profecti erant, adeoque modo simul vetera et nova mitto.</s>
					<s n="2" xml:lang="la"><placeName ref="l18">Augustanorum</placeName> concio<lb xml:id="p1z26"/>natorum relegatio omnium animos conturbat et a concilio adeundo avocat <lb xml:id="p1z27"/>et dehortatur; nam quid patres facturos credamus tali pręiuditio animatos?</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z28"/>De navibus 17 <placeName ref="l875">Hispanicis</placeName> a <persName>Pollino</persName> <placeName ref="l832">Gallo</placeName> et <placeName ref="l2524">Scotis</placeName> interceptis et in <placeName ref="l2770">Norman<lb xml:id="p1z29"/>diam</placeName> adductis scio iam vos dudum certiores factos; <placeName ref="l832">Gallicarum</placeName> actionum omnium <lb xml:id="p1z30"/>certior apud vos cognitio quam hic est.</s>
					<s n="4" xml:lang="la"><persName ref="p3671">Rex Danie</persName>, <persName ref="p1825">rex Polonie</persName>, electores <lb xml:id="p1z31"/>et <placeName ref="l749">Saxonicus</placeName> et <placeName ref="l1048">Brandenburgensis</placeName> et <placeName ref="l2477">Palatinus</placeName>, tum dux <placeName ref="l572">Wirtenbergensis</placeName>, dux <placeName ref="l743">Pome<lb xml:id="p1z32"/>ranie</placeName>, dux <placeName ref="l2562">Prussie</placeName> pro lantgravio in futuro <placeName>Castrinense</placeName> intercedere constitu<lb xml:id="p1z33"/>erunt apud Cesaream maiestatem; sed pręcibus nihil eos impetraturos verisimile est.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z34"/>Audio esse actum cum <placeName ref="l361">Nurnbergensibus</placeName>, ut suos quoque concionatores dimittant; sed eos <lb xml:id="p1z35"/>respondisse imperatorem religionis caussam consilio libero et christiano determi<lb xml:id="p1z36"/>nandam sancivisse et id ipsum omnes imperii ordines decrevisse, quare se confidere <lb xml:id="p1z37"/>imperatorem promissis et imperii decretis staturum nec ante concilii peractionem ullam mutationem <lb xml:id="p1z38"/>invecturum, et concionatores adhuc retinere.</s>
					<s n="6" xml:lang="la">Iterum valeas.</s>
					<s n="7" xml:lang="de">23. septembris.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eruditissimo et piissimo <lb xml:id="p2z2"/>viro d. <persName ref="p495">Bullingero</persName>, amico <lb xml:id="p2z3"/>observandissimo.</s>
					<s n="9" xml:lang="de"><placeName ref="l587">Zeurg</placeName>.</s>
				</p>
				<p>
					<note type="PS">[PS. zu 1551 Sept. 6.; Vgl. auch <bibl source="b51">Blarer BW</bibl> III 137]</note>
				</p>
