	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Remisi literas scriptas <placeName ref="l546">Vienna</placeName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Ex literis a rege scriptis 12. huius <lb xml:id="p1z2"/>mensis nihil intellexi nisi omnia recte habere in exercitu, in quo <lb xml:id="p1z3"/>ipse presens est.</s>
					<s n="4" xml:lang="la"><persName>Colonellus Frelich</persName> mihi signifficat regem <lb xml:id="p1z4"/>non constituisse aggredi adversarium, cui cum fame et morbo <lb xml:id="p1z5"/>conflictandum est quique est in summa difficultate nummaria, cum tam<lb xml:id="p1z6"/>en numero nostros excedat.</s>
					<s n="5" xml:lang="la">Utinam deus inclinaret principum <lb xml:id="p1z7"/>animos ad pacem et ea, quę potissimum curare debent!</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Si quid vis ad me mittere, ne dubites dare magistro poste, <lb xml:id="p1z9"/>qui tutius ad me quidvis mittet quam proprius nuncius.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Quando aliquid habuero dignum, quod literis committatur, scribam <lb xml:id="p1z11"/>amplissimo senatui vestro aut d. consuli.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Eos et amicos meis verbis salutabis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z12"/>Bene vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l760">Soluthuri</placeName> 20. septembris 1558.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z13"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Castrum Santal in <placeName ref="l736">Pedemontio</placeName> captum <lb xml:id="p1z14"/>ab adversariis cum maxima suorum <lb xml:id="p1z15"/>i<lb xml:id="p1z16"/>actura.</s>
					<s n="13" xml:lang="la">Dux <placeName ref="l1098">Florentie</placeName> arma parat.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z17"/><persName>Pape</persName> magna est infirmitas.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tigurine</placeName> ecclesie pastori vigilantissimo.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
