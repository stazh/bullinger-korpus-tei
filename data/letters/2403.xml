	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Literae tuae, compater amantissime, periucundae mihi fuerunt, <lb xml:id="p1z2"/>et gratias ago, quod ita de me solicitus esse pergis.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>De d. <persName ref="p1560">Hoppero</persName> quoque quod sic sis solicitus, magnam habeo gratiam; <lb xml:id="p1z4"/>is per dei gratiam constanter et forti animo fert omnia atque <lb xml:id="p1z5"/>adeo mortis minas.</s>
					<s n="4" xml:lang="la">Tuas literas scio illi pergratas <lb xml:id="p1z6"/>fore, uti iam aliquoties mihi significavit; rogo te et <lb xml:id="p1z7"/>per Christum, ne hoc illi deneges.</s>
					<s n="5" xml:lang="la">Ego si literas tuas accepero, <lb xml:id="p1z8"/>facile efficiam, ut reddantur; hactenus enim dei beneficio semper <lb xml:id="p1z9"/>illi fas fuit ad me scribere measque literas accipere.</s>
					<s n="6" xml:lang="la">Fac <lb xml:id="p1z10"/>tantum, literae tuae <placeName ref="l491">Argentinae</placeName> reddantur d. <persName ref="p505">Burkero</persName> aut <lb xml:id="p1z11"/>d. <persName ref="p8362">Ioanni Garnerio</persName>, pastori ecclesiae <placeName ref="l832">Gallicae</placeName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Ego hactenus valeo sic satis et, quam fortiter possum, hanc <lb xml:id="p1z13"/>calamitatem perfero; dominus adiuvabit et succurret meae imbecillitati.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Precibus opus est bonorum amicorum et suavibus <lb xml:id="p1z15"/>consolationibus; quare te vehementer rogo, ne me negligas.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>In novis rebus nihil est, quod sciam, quin possis ex <lb xml:id="p1z17"/>mercatoribus, qui hinc istuc redeunt, cognoscere.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Salutem, <lb xml:id="p1z18"/>rogo, meo nomine dicas optimae commatri meae, uxori tuae castissimae, <lb xml:id="p1z19"/>d. <persName ref="p8011">Ghaltero</persName>, d. <persName ref="p8171">Bibiliandro</persName>, d. <persName ref="p8127">Pellicano</persName> et eorum uxoribus.</s>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p1z20"/>Resalutant te d. <persName>Cechelles</persName> et <persName ref="p2639">Valerandus Pollanus</persName>, qui <lb xml:id="p1z21"/>tibi hunc libellum mittit, ex quo cognoscas nostrae ecclesiolae <lb xml:id="p1z22"/>constitutionem et ordinem universum.</s>
					<s n="12" xml:lang="la">In quo si quid erit, cuius <lb xml:id="p1z23"/>monendum putes, feceris illi rem longe gratissimam, et te oro, ut id <lb xml:id="p1z24"/>facias per Christum.</s>
					<s n="13" xml:lang="la">Ego me et meos liberos tę pietati <lb xml:id="p1z25"/>et precibus sanctissimis commendo.</s>
					<s n="14" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="15" xml:lang="la"><placeName ref="l157">Francofordiae</placeName> <lb xml:id="p1z26"/>22. septembris 1554.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z27"/>Tui amantissima commater <lb xml:id="p1z28"/><persName ref="p8473">Anne Hoper</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo theologo d. <persName ref="p495">Henrico <lb xml:id="p4z2"/>Bullingero</persName>, compatri et <lb xml:id="p4z3"/>amico venerando.</s>
					<s n="18" xml:lang="la"><lb xml:id="p4z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
