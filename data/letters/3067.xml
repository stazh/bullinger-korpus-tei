	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non ignoras colendissime mi domine compater<lb xml:id="p1z2"/>, quomodo ego erga ecclesiam <placeName ref="l587">Tigurinam</placeName> <lb xml:id="p1z3"/>adeoque <placeName ref="l587">Tigurinos</placeName> omnes sim affectus, neque ipse <lb xml:id="p1z4"/>quoque nescio, quid illis debeam; sed vicissim quoque <lb xml:id="p1z5"/>non ignoras, quam mihi non sit possibile iuvare eos <lb xml:id="p1z6"/>apud nostrates, sicuti tamen maxime vellem.</s>
					<s n="3" xml:lang="la">Est enim <lb xml:id="p1z7"/>ea<lb xml:id="p1z8"/>dem fere nostrae ecclesiae ratio, quae et vestrae; ha<lb xml:id="p1z9"/>bemus etenim per dei gratiam studiosos multos et <lb xml:id="p1z10"/>ex his plurimos, ut vocant, expectantes, ut, si aliqua <lb xml:id="p1z11"/>conditio vacet, plurimi sint, qui illas occupare conentur, <lb xml:id="p1z12"/>ita ut in tanta eorum multitudine sepenumero in <lb xml:id="p1z13"/>conferendis beneficiis admodum perplexi simus conquere<lb xml:id="p1z14"/>ntibus de nobis iis, qui diutius negligi videntur.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z15"/>Atque ego mihi eo nomine plurimum invidiae apud aliquos <lb xml:id="p1z16"/>comparavi promovendo interdum eos, qui mihi a vobis <lb xml:id="p1z17"/>commendabantur, ut nunc vix audeam amplius <lb xml:id="p1z18"/>peregrini cuiusdam mentionem facere.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Itaque re infecta <lb xml:id="p1z19"/>ad vos redit <persName ref="p8130">Laurentius</persName> noster; impetravi <lb xml:id="p1z20"/>tamen illi viaticum a senatu, duos videlicet coronatos; <lb xml:id="p1z21"/>unum praeterea de suo addidit <persName ref="p8063">Steigerus</persName>; deder<lb xml:id="p1z22"/>unt item alii aliquid, ut sic, quamvis nihil impetrasse, n<lb xml:id="p1z23"/>jon tamen suarum rerum iacturam huc veniendo fecisse <lb xml:id="p1z24"/>videri possit.</s>
					<s n="6" xml:lang="la">Tu meam operam boni consule.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z25"/>De Apocalypsi et consilio nostro proxime per <persName ref="p4851">Froschoverum</persName> <lb xml:id="p1z26"/>scripsi, ut iam non opus sit, his plura addere.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Nunc <lb xml:id="p1z27"/>in legendo opere versantur reliqui symmystae mei.</s>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z28"/>Bene vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l41">Bernae</placeName> 26. decembris sub finem anni <lb xml:id="p1z29"/>56.</s>
					<s n="11" xml:lang="la" ana="salute">Salutant te tuosque nostri omnes, praesertim <lb xml:id="p1z31"/>mater et uxor mea.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><persName ref="p8018">I[ohannes] <lb xml:id="p1z32"/>H[allerus</persName>] tuus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z33"/>Fuere hic hisce diebus <placeName ref="l280">Lausanenses</placeName> postulantes synodum <lb xml:id="p1z34"/>generalem, in qua tractetur negotium praedestinationis; <lb xml:id="p1z35"/>sed nos totis viribus eorum conatui restitimus non <lb xml:id="p1z36"/>ignorantes tractationem hanc maioris incendii initium <lb xml:id="p1z37"/>fore.</s>
					<s n="14" xml:lang="la">Itaque hoc illis a senatu nostro magnifico negatum, <lb xml:id="p1z38"/>decretum vero, ut proxim aestate classium denuo fiat <lb xml:id="p1z39"/>visitatio.</s>
					<s n="15" xml:lang="la"><persName ref="p957">Eustachius quoque Quercetanus</persName> <lb xml:id="p1z40"/>ad suam et illorum omnium petitionem sua functione <lb xml:id="p1z41"/>liber factus est.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesię pastori fidelissimo, <lb xml:id="p2z4"/>domino et compatri suo charissimo <lb xml:id="p2z5"/>colendissimoque.</s>
				</p>
			</div>
