	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus et pax Christi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Multas gratias vobis ago pro literis vestris<note xml:id="fn1" type="footnote" n="1">Nicht erhalten.</note>, <lb xml:id="p1z3"/>observandissimi fratres.</s>
					<s n="3" xml:lang="la">Satis enim factum est <lb xml:id="p1z4"/>mihi magna ex parte, imo non mihi solum, <lb xml:id="p1z5"/>sed etiam aliis aeque mecum dilucida exoptantes.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Quodsi videor ineptiora quędam interrogasse<note xml:id="fn2" type="footnote" n="2"><persName ref="p4079">Zwick</persName> hatte in seinem Brief vom 23. Februar (oben <ref target="file10789">Nr. 751</ref>) kritische Fragen zu verschiedenen Artikeln des Ersten Helvetischen Bekenntnisses gestellt.</note> aut <lb xml:id="p1z7"/>articulos oscitantius legisse, dabitis veniam.</s>
					<s n="5" xml:lang="la">Ego <lb xml:id="p1z8"/>gratulor me quacumque tandem ineptitudine extorsisse <lb xml:id="p1z9"/>a vobis dilucidiorem articulorum interpretationem.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Si quid est, quod me posthac amplius gravet, libere <lb xml:id="p1z11"/>indicabo.</s>
					<s n="7" xml:lang="la">Feretis me, sat scio, more vestro humanissime.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/>Nunc nihil habeo, neque otium est plura scribendi.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>Flegmata etiam tantum non enecant me.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Valete <lb xml:id="p1z14"/>ergo in Christo, semper pro nostra ecclesia solliciti.</s>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p1z15"/><persName ref="p8178">Thomas</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p8178">Thomas Blarer</persName>.</note>, frater <persName ref="p4082">Cuͦnradus</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p4082">Konrad Zwick</persName>.</note> et symmystae omnes <lb xml:id="p1z16"/>vos salutant diligentissime.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z17"/>Articulos vestros remitto, a quibus nostri plerisque <lb xml:id="p1z18"/>in locis variant; sed iuxta vestrum exemplar <lb xml:id="p1z19"/>emendavi<note xml:id="fn5" type="footnote" n="5">Bereits in seinem letzten Brief hatte <persName ref="p4079">Zwick</persName> auf die Verschiedenheit der deutschen und der lateinischen Fassung hingewiesen; vgl. oben Nr. 751, 133f.</note>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z20"/><placeName ref="l257">Constantiae</placeName>, 24. martii 1536.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z21"/>Totus vester <persName ref="p4079">Johannes<lb type="manual"/> <lb xml:id="p1z22"/>Zvick</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z23"/>Uxores vestras<note xml:id="fn6" type="footnote" ana="bio" n="6"><persName ref="p8051">Anna Bullinger, geb. Adlischwyler</persName>, und <persName ref="p5390">Katharina Jud, geb. Gmünder</persName>.</note> cum omni familia opto <lb xml:id="p1z24"/>bene habere<note xml:id="fna" type="footnote" n="a">habere <hi>korrigiert aus</hi> v[alere].</note> in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>D[ominis]<note xml:id="fnb" type="footnote" n="b"><hi>in der Vorlage</hi> DD.</note> <persName ref="p495">Hainricho Bullingero</persName> <lb xml:id="p2z2"/>et <persName ref="p1753">Leoni Iudae</persName>, <lb xml:id="p2z3"/>fratribus in Christo <lb xml:id="p2z4"/>colendissimis.</s>
				</p>
