	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Regis Galliae edictum de pacificatione religionis,
					<lb xml:id="p1z2"/>aut vero eiusdem explicationem regiam, forte foatuna
					<lb xml:id="p1z3"/>actusex Gallica invernaculam linguam transtuli.
					<lb xml:id="p1z4"/>in meum et cuiusdam vicini usum. Linemus
					<lb xml:id="p1z5"/>autem vir praestantissimu eius rei ceatior factus, cum
					<lb xml:id="p1z6"/>Elgovium pride transicet, exemplar Gallicum
					<lb xml:id="p1z7"/>a me petiit et accepit; Illud autem, quod transtuleram,
					<lb xml:id="p1z8"/>tibi dmeoe patri colendissime describi voluit et quidem
					<lb xml:id="p1z9"/>festinanter. Ego qui non dubitem, quin idem edidu
					<lb xml:id="p1z10"/>et eiusdem translationem Germanica multo exactionem
					<lb xml:id="p1z11"/>iam ante acceperis, tamen eximio hiic viro mori
					<lb xml:id="p1z12"/>gessi, tum illius consilio adductus, tum bonitate tu
					<lb xml:id="p1z13"/>singulari factus, qua hactenus mea omnia boni consu
					<lb xml:id="p1z14"/>Vale in Christo, qui te ecclesiae suae munn
					<lb xml:id="p1z15"/>turbis obiectae, sed et patriae nostrae diu serdet
					<lb xml:id="p1z16"/>incolumem. Ex Elgovio <placeName ref="l587">Tigurinorum</placeName> municipio
					<lb xml:id="p1z17"/>idus septembris anno salutis 1564.
					<lb xml:id="p1z18"/>Tuae singulari humanitati
					<lb xml:id="p1z19"/>deditissimus.
					<lb xml:id="p1z20"/>Iosua Malerus, elego
					<lb xml:id="p1z21"/>ecclesiae ministro
					<pb/>
					<lb xml:id="p2z1"/>Clarissimo laudatissimae Tigurinae
					<lb xml:id="p2z2"/>ecclesiae ministro d. Heinrycho
					<lb xml:id="p2z3"/>Bullingero, suo tanquam patri et
					<lb xml:id="p2z4"/>domino colendissimo.
					<lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.
				</p>
			</div>
		</body>
	</text>
