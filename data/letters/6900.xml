	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Clarissimo viro d. Guilhelmo
					<lb xml:id="p1z2"/>Turnero Anglo doctori
					<lb xml:id="p1z3"/>dico domino meo colendo et fratri
					<lb xml:id="p1z4"/>charissimo.
					<lb xml:id="p1z5"/>S. D. Legi, quas ad me misisti literas Turvere
					<lb xml:id="p1z6"/>doctissime, Intellexi ex iis, quae sit sententiarum
					<lb xml:id="p1z7"/>e Anglia varientas, ex epistola illa
					<lb xml:id="p1z8"/>nostra in Angliam scripta ad fratres aliquot exortar
					<lb xml:id="p1z9"/>intellexi etiam tuu consilium, quod suggeris, oppos
					<lb xml:id="p1z10"/>se publicationi, libellum aliquem, qui
					<lb xml:id="p1z11"/>me expurgem et msta authoritatem graviter habetu
					<lb xml:id="p1z12"/>factatam, mature et fortiter asseram, quam tu, utpote
					<lb xml:id="p1z13"/>mei studiosissimus, salvam integramque manere
					<lb xml:id="p1z14"/>cupias. Ego vero mihi Turnere, tua erga me
					<lb xml:id="p1z15"/>benevolentiae, maximas ago gratias ac dominum rogo, ut
					<lb xml:id="p1z16"/>ipse tibi pro sua clementia liberalitateque mexhas
					<lb xml:id="p1z17"/>rependat. Caeterum scias, mi domine et frater
					<lb xml:id="p1z18"/>me nihil moveri illa sententiarum varietate
					<lb xml:id="p1z19"/>Fretus enim synceritate conscientiae meae et boni
					<lb xml:id="p1z20"/>causae, spero prudentes et pios viros facile
					<lb xml:id="p1z21"/>ex ipso scripto nostro intellecturos, quo consilio epistola
					<lb xml:id="p1z22"/>illa a me et a fidelissimo dilectissimoque symmysta
					<lb xml:id="p1z23"/>et affine meo Gvalthero sit exarata. Hi pro
					<lb xml:id="p1z24"/>sua pietate et prudentia institutum nostrum neque
					<lb xml:id="p1z25"/>caluniabuntur neque alio rapient, quam a nobis si
					<lb xml:id="p1z26"/>scripta epistola neque improbabunt. De aliorum in
					<lb xml:id="p1z27"/>udiciis nihil sumus solicitis quippe cum omnibus
					<lb xml:id="p1z28"/>sclus, optime de ecclesia et rapublica meriti, ma
					<lb xml:id="p1z29"/>retulerint gratiam calumniisque multorum
					<lb xml:id="p1z30"/>fuerint expositi; domemus vero iudex iustus,
					<lb xml:id="p1z31"/>semper et veritatem et integritatem suorum
					<lb xml:id="p1z32"/>aesserverit. Attamen ne videremur admonita
					<lb xml:id="p1z33"/>amicorum contemnere aut confidentio
					<lb xml:id="p1z34"/>negligere, scribimus viris aliquot cordatis testinus
					<lb xml:id="p1z35"/>vos de re vestiaria dumtaxat, fratribus
					<lb xml:id="p1z36"/>illis suasisse, quod nobis visum sit e re fore
					<pb/>
					<lb xml:id="p2z1"/>pietatis et ecclesiae de aliis controversis apud
					<lb xml:id="p2z2"/>vos articules, nullam instituisse disputationem
					<lb xml:id="p2z3"/>neque abiusus aut errores papisticos aut supersti
					<lb xml:id="p2z4"/>vel tueri vel approbare
					<lb xml:id="p2z5"/>Porro
					<lb xml:id="p2z6"/>minime consultum mihi videtur libellum aliquem
					<lb xml:id="p2z7"/>adversarium publicatae nostrae opponere epistolae.
					<lb xml:id="p2z8"/>Nondi enim et alteram audivimus partem. sed e
					<lb xml:id="p2z9"/>alioqui imo plus nimium est in ecclesia alter
					<lb xml:id="p2z10"/>et huiusmodi libellorum, quorum acerbi
					<lb xml:id="p2z11"/>rixarumque in ipsis varietas et inextricabilis
					<lb xml:id="p2z12"/>assiduitas, ecclesiae hactenus plus t quam prom
					<lb xml:id="p2z13"/>Fuit dominum oro, ut nobis omnibus placidos lar
					<lb xml:id="p2z14"/>animos et ecclesiae suae verram tranquillitat
					<lb xml:id="p2z15"/>reddat. Haec existimavi tibi domino et
					<lb xml:id="p2z16"/>fratri meo utpote viro pio et pruedenti in prei
					<lb xml:id="p2z17"/>sentiarum satisfacere. Rogo ut haec boni consulas
					<lb xml:id="p2z18"/>et me tui amantem vicissim amare pergas.V
					<lb xml:id="p2z19"/>aeternum. Dominus tibi et piis omnibus benedicat.
					<lb xml:id="p2z20"/><placeName ref="l587">Tiguri</placeName> 10. septembris anno domino 1566.
					<lb xml:id="p2z21"/>Heinrychus Bullingerus
					<lb xml:id="p2z22"/>senior Tigurinae ecclesiae
					<lb xml:id="p2z23"/>minister tuus totus.
				</p>
			</div>
		</body>
