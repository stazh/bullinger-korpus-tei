	<text xml:lang="la">
		<body>
			<div>
				<p>
					<note>[Autograph: Zürich StA, E II 357, 319 Bl. III, 12R.]</note>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Mitto exemplum [li<lb xml:id="p1z2"/>terarum] mearum ad <placeName ref="l41">Bernenses</placeName>, <lb xml:id="p1z3"/>praeterea epistolas ad <persName ref="p8018">Hallerum</persName> et <persName ref="p8417">Musculum</persName> nostros, quas diebus <lb xml:id="p1z4"/>hisce in codice quodam nihil minus quam ipsas quaerens <lb xml:id="p1z5"/>repperi.</s>
					<s n="2" xml:lang="la">Volebam autem illas proximis ad te datis literis coniungere; <lb xml:id="p1z6"/>verum cum abmandandus esset nuncius, diu quaesitas nusquam <lb xml:id="p1z7"/>inveniebam, quia imprudens in codice concluseram.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z8"/>Iam igitur vel sero accipient, officium tamen meum qualitercunque <lb xml:id="p1z9"/>sensuri.</s>
					<s n="4" xml:lang="la">Ah ora pro nobis, mi amice et charissime frater.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Sęculum videtur, quod nihil abs te redditur literarum.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Admone nos tempestiviter, si quid forte proximis <lb xml:id="p1z12"/>comitiis adversum exules nos apud vestros C[aesar].</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Si quid quando scribere velis, <placeName ref="l555">Vitodurum</placeName> mitte hospiti, <lb xml:id="p1z14"/>cui Corona insigne est; nam illuc subinde <persName ref="p8393">Hieronymus <lb xml:id="p1z15"/>Emporus</persName>, porrochus hic noster, proficiscitur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z16"/>Germanus meus frater cum optima sorore meaque coniuge te <lb xml:id="p1z17"/>tuamque domum plurimo plus in domino salvere et valere <lb xml:id="p1z18"/>iubent vestris se piis votis diligentissime commendantes.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z19"/>Salveant omnes fratres et amici, inprimis administri tui, <lb xml:id="p1z20"/>in domino cum <persName ref="p8440">Gervasio</persName> nostro et utroque <placeName ref="l830">Anglo</placeName>, <persName ref="p506">Butlero</persName> et <persName ref="p1560">Hopero</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z21"/>Bene vale.</s>
					<s n="11" xml:lang="la">14. Februarii 1549.</s>
				</p>
				<p>
