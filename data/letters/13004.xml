			<zone xml:id="p1z34-0" points="550,3158 630,3160 711,3202 957,3138 1170,3194 1175,3066 1123,3050 1084,3069 1042,3042 979,3080 915,3050 799,3061 697,3100 664,3066 556,3086">569,3135 599,3132 630,3130 660,3129 691,3129 722,3129 752,3126 783,3123 813,3123 844,3122 875,3120 905,3117 936,3115 966,3113 997,3111 1028,3111 1058,3110 1089,3108 1119,3106 1150,3106 1181,3108</zone>
