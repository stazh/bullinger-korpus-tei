	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quomodo res meae habeant, ex iis, quas nu<lb xml:id="p1z2"/>per ad fratrem scripsi, intellexisti.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Interea accepi <lb xml:id="p1z3"/>tuas, quibus mihi de restituta sanitate gratularis, <lb xml:id="p1z4"/>pro qua gratulatione summa tibi ago gratias, tum etiam <lb xml:id="p1z5"/>pro precibus tuis, quibus apud dominum pro me i<lb xml:id="p1z6"/>ntercessisti.</s>
					<s n="4" xml:lang="la">Exaudivit illas cum multorum aliorum <lb xml:id="p1z7"/>dominus; sit nomen eius benedictum in secula!</s>
					<s n="5" xml:lang="la" ana="salute">Illum <lb xml:id="p1z8"/>oro, ut, quam denuo dedit vitam, dirigat totam <lb xml:id="p1z9"/>ad nominis sui gloriam multorumque et inter hos <lb xml:id="p1z10"/>meam quoque salutem.</s>
					<s n="6" xml:lang="la">Incipio domo egredi, <lb xml:id="p1z11"/>nondum tamen concionari cepi; fiet id con<lb xml:id="p1z12"/>firmatis paulo magis viribus.</s>
					<s n="7" xml:lang="la">Accepimus interea <lb xml:id="p1z13"/>quoque, quę nunc remitto.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Communicavi ea d. a <lb xml:id="p1z14"/><persName ref="p7682">Mülinen</persName>, quia propter vindemias pauci senatorum <lb xml:id="p1z15"/>sunt in urbe et uterque etiam consulum abest.</s>
					<s n="9" xml:lang="la">Gratias <lb xml:id="p1z16"/>tibi is agit maximas, ago etiam ego, tum etiam inprimis <lb xml:id="p1z17"/>pro exemplari tuarum in Danielem homiliarum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Quid mihi contigerit prima huius libri inspectione, <lb xml:id="p1z19"/>intellexisti; interea restitutus non potui me <lb xml:id="p1z20"/>continere, quin totum una cum Epitome per<lb xml:id="p1z21"/>currerim.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Fuit hic unicus meus labor per aliquot <lb xml:id="p1z22"/>nunc dies.</s>
					<s n="12" xml:lang="la">Multis me liberasti difficultatibus, <lb xml:id="p1z23"/>praesertim in Danielis quibusdam obscurioribus locis <lb xml:id="p1z24"/>intelligendis.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Gratias itaque ago domino, qui tanta in te <lb xml:id="p1z25"/>contulit dona, et oro illum, ut te diutissime con<lb xml:id="p1z26"/>servet, quo tuis laboribus plurimum adhuc ecclesiae <lb xml:id="p1z27"/>commodi afferre possis.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Dabo operam, ut me quoque <lb xml:id="p1z28"/>gratum tibi exhibeam.</s>
					<s n="15" xml:lang="la">Quid hic nuncius ferat, <lb xml:id="p1z29"/>nescio; modo enim me admonet, si quid scribere <lb xml:id="p1z30"/>velim, ut id parem; se enim intra horam aut semi<lb xml:id="p1z31"/>horam abiturum.</s>
					<s n="16" xml:lang="la">Colligavi itaque ista et paucula haec <lb xml:id="p1z32"/>scribo scripturus propediem plura, ubi plus ocii na<lb xml:id="p1z33"/>ctus fuero et aliquanto melius convaluero.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z34"/>Salutant te uxor, mater, socer, amici denique <lb xml:id="p1z35"/>et fratres omnes.</s>
					<s n="18" xml:lang="la">Tuas ad <persName ref="p8033">Bezam</persName> scriptas curavi, tum <lb xml:id="p1z36"/>etiam alteras.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute">Salutem meo nomine dicas, obsecro, <lb xml:id="p1z37"/>d. <persName ref="p8011">Gvalthero</persName> tuisque filiis ac generis omnibus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="farewell"><lb xml:id="p1z38"/>Bene vale.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l41">Bernę</placeName> 6. octobris 1565.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p8018">Iohan[nes] Hallerus</persName> tuus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino <lb xml:id="p2z4"/>meo et compatri per<lb xml:id="p2z5"/>petua observantia colendo.</s>
				</p>
			</div>
