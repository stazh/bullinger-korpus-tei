	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S.
					<lb xml:id="p1z2"/>Geliepter her und freint, ich hab
					<lb xml:id="p1z3"/>zwedschreiben, sampt meines sonh
					<lb xml:id="p1z4"/>ze meinem diener eimpfargen
					<lb xml:id="p1z5"/>und bedanck meich der nüwen
					<lb xml:id="p1z6"/>zeitungen. Demanach pitt ich ei
					<lb xml:id="p1z7"/>so ir botchafft syen, hidelbei
					<lb xml:id="p1z8"/>hetten oder in khurze liber kemend.
					<lb xml:id="p1z9"/>ir welt meich desen berichten. dan
					<lb xml:id="p1z10"/>ich was aldar ze schreiben thett.
					<lb xml:id="p1z11"/>Dnem liebe haußfraw und kun
					<lb xml:id="p1z12"/>lasen bis inen gruß sagen. Hib
					<lb xml:id="p1z13"/>befchig die zn Eern gott
					<lb xml:id="p1z14"/>Dattem vster, das 10. ionnari 1574.
					<lb xml:id="p1z15"/>G. Fren.
					<lb xml:id="p1z16"/>.
					<lb xml:id="p1z17"/>Wlech philips freycher
					<lb xml:id="p1z18"/>D.
					<lb xml:id="p1z19"/>fast bar
					<lb xml:id="p1z20"/>o.
					<pb/>
					<lb xml:id="p2z1"/>Dem hochgelertten meinem
					<lb xml:id="p2z2"/>geliepten freudt Meister
					<lb xml:id="p2z3"/>Heinrich Bullinger, diener
					<lb xml:id="p2z4"/>der kilchen ZZurih.
					<lb xml:id="p2z5"/>uffn
					<lb xml:id="p2z6"/>H.
				</p>
			</div>
		</body>
	</text>
