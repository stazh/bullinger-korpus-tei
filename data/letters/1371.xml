	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Salvus redii ad meos domini gratia.</s>
					<s n="3" xml:lang="la">Inveni hic <lb xml:id="p1z2"/>d. <persName ref="p3375">Vergerium</persName>, qui omnino <placeName ref="l280">Lausannae</placeName> esse cupiens, heri a senatu <lb xml:id="p1z3"/>nostro receptus est ad trimestre tempus et hodie <placeName ref="l280">Lausannam</placeName> proficiscitur.</s>
					<s n="4" xml:lang="la">Habebit singulis mens<lb xml:id="p1z4"/>ibus 4 coronatos, donec ei amplius prospiciatur<note type="margin">Zusatz a. R.: "Hab. - prosp.".</note>.</s>
					<s n="5" xml:lang="la">Collegit hic in unum <lb xml:id="p1z5"/>fasciculum praecipua illa capita, quae nos concilium <lb xml:id="p1z6"/><placeName ref="l1107">Tridentinum</placeName> detrectare iubent; imprimet, <lb xml:id="p1z7"/>ut puto, <placeName ref="l28">Basileae</placeName>.</s>
					<s n="6" xml:lang="la">Videbunt hic omnes cordati, quam <lb xml:id="p1z8"/>iustis de causis concilio reclamemus.</s>
					<s n="7" xml:lang="la">Alias novi, <lb xml:id="p1z9"/>quid scribam, nihil est, nisi quod <persName ref="p1804">Iodocus</persName> <persName ref="p3375">Vergerium</persName> <lb xml:id="p1z10"/>alloquio nunquam sit dignatus et quinquies vocatus <lb xml:id="p1z11"/>ad conventum fratrum, ut de <persName ref="p3375">Vergerio</persName> ageretur, nunquam venire <lb xml:id="p1z12"/>voluit semper alia praetendens.</s>
					<s n="8" xml:lang="la">Nec cum ego invitassem <lb xml:id="p1z13"/><persName ref="p3375">Vergerium</persName> eumque simul cum fratribus reliquis vocassem, comparuit; <lb xml:id="p1z14"/>sed hodie pro publico suggestu eum non me<lb xml:id="p1z15"/>diocriter nec leviter taxavit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Est magnum onus <lb xml:id="p1z16"/>ecclesiae nostrae hic homo.</s>
					<s n="10" xml:lang="la">Dominus inspiciat et det illi spiritum <lb xml:id="p1z17"/>magis christianum!</s>
					<s n="11" xml:lang="la">De <persName ref="p3700">Eberhardo</persName> vereor ne mox <lb xml:id="p1z18"/>mira sitis audituri; Satan nos undique impetit.</s>
					<s n="12" xml:lang="la">D. <lb xml:id="p1z19"/>quaestor podagra graviter decumbit.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Salutat te una cum <lb xml:id="p1z20"/>d. <persName ref="p8417">Musculo</persName> et meis omnibus.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale.</s>
					<s n="15" xml:lang="la"><placeName ref="l41">Bernae</placeName> <lb xml:id="p1z21"/>8. augusti 1551.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><persName ref="p2301">Osiandri</persName> propositiones remitto, quas mecum in<lb xml:id="p1z22"/>de avexeram.</s>
					<s n="17" xml:lang="la"><persName ref="p8018">I[oannes] <lb xml:id="p1z23"/>Hallerus</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrych<lb xml:id="p2z2"/>o Bullingero</persName>, <lb xml:id="p2z3"/>antistiti ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>fidelissimo, domino <lb xml:id="p2z5"/>et compatri suo charis<lb xml:id="p2z6"/>simo.</s>
				</p>
				<p>
					<s n="19" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
