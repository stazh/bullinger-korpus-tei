	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Ago tibi immensas gratias pro rebus, quas <lb xml:id="p1z2"/>in literis tuis inveni; non negligens ero in rependenda vicissitudine.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Ibiscum civitatem nostri traditam et <persName>baronem de Mansfeld</persName> captum, qui volebat <lb xml:id="p1z4"/>impressione facta evadere.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Nunc <placeName>Avene</placeName> a <placeName ref="l832">Gallo</placeName> oppugnati <placeName>Caesareani</placeName> <lb xml:id="p1z5"/>timore sunt perculsi, fugiunt aut se dedunt, quum nihi auxilii a Cęsare <lb xml:id="p1z6"/>sperant.</s>
					<s n="5" xml:lang="la"><persName>Martinus de Rossa</persName> fugit; aiunt illum esse <placeName ref="l168">Gandavi</placeName> in arce.</s>
					<s n="6" xml:lang="la">Regina <lb xml:id="p1z7"/><placeName ref="l1284">Bruxellę</placeName> est, ad fugam paratissima.</s>
					<s n="7" xml:lang="la"><placeName ref="l157">Francofordia</placeName> est obsessa ab <persName>Alberto</persName> <lb xml:id="p1z8"/>marchione et <persName ref="p18250">Mauritio</persName>; coniunxerunt enim exercitus, ne quid insperatum <lb xml:id="p1z9"/>accidat.</s>
					<s n="8" xml:lang="la"><persName>Hessus</persName> conqueritur se magnum accepisse damnum et ab illis, qui <lb xml:id="p1z10"/>ab eo nunquam laesi fuere.</s>
					<s n="9" xml:lang="la">De <placeName ref="l2510">Turca</placeName> hęc a d. <persName>Lazio</persName> habemus: <lb xml:id="p1z11"/><placeName ref="l2510">Turca</placeName> magnum in <placeName ref="l869">Transsylvanos</placeName> et nos exercitum mittit; sed rex <lb xml:id="p1z12"/>Transsylvaniam tribus Germanorum legionibus et una <placeName ref="l875">Hispanorum</placeName>, <lb xml:id="p1z13"/>item <placeName ref="l882">Hungarorum</placeName> 18 millibus firmavit, ut sine periculo esse pos<lb xml:id="p1z14"/>sit contra omnes <placeName ref="l2510">Turcicos</placeName> conatus.</s>
					<s n="10" xml:lang="la">In <placeName ref="l882">Hungaria</placeName> sparsim <lb xml:id="p1z15"/>sunt Germani, Itali ac Hungari numero 30 millia, <lb xml:id="p1z16"/>congregantur adhuc plura.</s>
					<s n="11" xml:lang="la"><persName ref="p18477">Rex Ferdinandus</persName> vocatur ab <placeName ref="l882">Hungaris</placeName>, <lb xml:id="p1z17"/>qui propediem instructo exercitu, quem in <placeName ref="l2449">Bohemia</placeName> collegit, <lb xml:id="p1z18"/><placeName ref="l2510">Turcę</placeName> obviam iturus est et prostraturus omnes illius copias.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z19"/>Hęc ille.</s>
					<s n="13" xml:lang="la">Sic videmus <placeName ref="l822">Germaniam</placeName>, <placeName ref="l808">Belgas</placeName>, <placeName ref="l850">Austriam</placeName>, <placeName ref="l869">Transylvani<lb xml:id="p1z20"/>am</placeName> et <placeName ref="l994">Neapolitanum</placeName> regnum, imo totam fere <placeName ref="l2536">Europam</placeName> <lb xml:id="p1z21"/>turbulentissimam esse.</s>
					<s n="14" xml:lang="la">Sed pauci reperiuntur tam ex regibus <lb xml:id="p1z22"/>quam principibus, qui emendent vitam, religionem sanam instituant <lb xml:id="p1z23"/>et deum ex cordis affectu invocant et colant.</s>
					<s n="15" xml:lang="la">Hęc paucis.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z24"/>Mittam brevi libros, quos petis, si ullo modo possum adsequi.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z25"/>Scripsi <placeName ref="l491">Argentinam</placeName>, sed responsum nullum accepi.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Protoscriba <lb xml:id="p1z26"/>respondebit pro se.</s>
					<s n="19" xml:lang="la">Quidam ex militibus... e castris <persName>Galli</persName>..<lb xml:id="p1z27"/>. redeunt infirmi, laceri <foreign xml:lang="el">καὶ ἀχρήματοι</foreign> neque possunt <lb xml:id="p1z28"/>ferre aestum et labores bellicos.</s>
					<s n="20" xml:lang="la">Tumultus fere excitatus fuit a <lb xml:id="p1z29"/>paganis nostris, qui noluerunt attingere <persName ref="p18538">Caesaris</persName> terras; sed subscripserunt ci<lb xml:id="p1z30"/>vitatum consilia.</s>
					<s n="21" xml:lang="la" ana="farewell">Vale.</s>
					<s n="22" xml:lang="de">20. <lb xml:id="p1z31"/>iulii 1552.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">T[uus] <persName ref="p1278">Io[annes] <lb xml:id="p1z32"/>Gas<lb xml:id="p1z33"/>tius</persName> <lb xml:id="p1z34"/>ex anim<pb/><lb xml:id="p2z1"/>o.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p2z2"/>Pio et docto viro <lb xml:id="p2z3"/>d. magistro <persName ref="p495">Heinrycho <lb xml:id="p2z4"/>Bullingero</persName>, pastori <lb xml:id="p2z5"/>apud <placeName ref="l587">Tigurinam</placeName> ecclesiam <lb xml:id="p2z6"/>vigilantissimo, <lb xml:id="p2z7"/>praeceptori suo charissimo<lb xml:id="p2z8"/>.</s>
					<s n="25" xml:lang="de"><lb xml:id="p2z9"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
