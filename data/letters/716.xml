	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Pridie idus octobris huc redii salvus salvis etiam meis omnibus <lb xml:id="p1z2"/>inventis.</s>
					<s n="3" xml:lang="la">Gratias tibi ago maximas pro tua humanitate et bene<lb xml:id="p1z3"/>volentia mihi exhibita.</s>
					<s n="4" xml:lang="la">Memor ero semper et rependam, si quando <lb xml:id="p1z4"/>possum.</s>
					<s n="5" xml:lang="la">Literas tuas hic inveni, quibus commendas denuo D. <persName ref="p8440">Gervasium</persName><lb xml:id="p1z5"/>.</s>
					<s n="6" xml:lang="la">Sed quia D. <persName>Metzlerus</persName> hinc nondum migravit, quamvis <lb xml:id="p1z6"/>exigua ei vitae spes supersit, nihil nunc possum; memor tamen <lb xml:id="p1z7"/>ero eius et enitar, si quo pacto ipsi tandem prospici queat.</s>
					<s n="7" xml:lang="la">Iuvenes <lb xml:id="p1z8"/>hos nostros denuo tibi commendo; sunt pii, studiosi et non indocti, <lb xml:id="p1z9"/>in quibus non exigua esset spes, si daretur, ut ad illorum eruditionem <lb xml:id="p1z10"/>accederet experientia rerum non vulgaris.</s>
					<s n="8" xml:lang="la">Tu labora, quaeso, pro ipsis <lb xml:id="p1z11"/>apud D. praepositum, ut et hos recipiat.</s>
					<s n="9" xml:lang="la">uxorem eius magis fore <lb xml:id="p1z12"/>propitiam confido, postquam ei talerum tuo suasu dedi, neque detrectabunt <lb xml:id="p1z13"/>domini deinceps addere plura, si eius intellexerint benevolentiam et <lb xml:id="p1z14"/>hoc qualecunque munusculum aliquid apud ipsam potuisse.</s>
					<s n="10" xml:lang="la">D. <persName ref="p540">Calvino</persName> literas <lb xml:id="p1z15"/>tuas iam misi.</s>
					<s n="11" xml:lang="la">Nihil habeo praeterea in praesentiarum neque, si <lb xml:id="p1z16"/>haberem, possem, cum sim occupatus hodie et cras continuis concionibus.</s>
					<s n="12" xml:lang="la" ana="salute"><lb xml:id="p1z17"/>Bene ergo vale et saluta ex me uxorem tuam et liberos suavissimos.</s>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z18"/>Salutat vos mea, D. <persName ref="p8417">Musculus</persName> quoque cum universa sua familia.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z19"/><placeName ref="l41">Bernae</placeName> 20. octobris 1549.</s>
					<s n="15" xml:lang="la" ana="salute">Salutat te quoque <persName ref="p3700">Eberhardus</persName> noster.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z20"/>Tuus ex animo <lb xml:id="p1z21"/><persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro D. <persName ref="p495">Bul<lb xml:id="p2z2"/>lingero</persName>, domino suo <lb xml:id="p2z3"/>et compatri venerando.</s>
				</p>
			</div>
		</body>
