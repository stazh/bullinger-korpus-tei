	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hodie denuo adsunt <placeName ref="l280">Lausanenses</placeName> gravissimam <lb xml:id="p1z2"/>intendentes contra <persName ref="p8292">Zebedaeum</persName> accusationem.</s>
					<s n="3" xml:lang="la">Me tantum <lb xml:id="p1z3"/>non ad insaniam adigunt.</s>
					<s n="4" xml:lang="la">Quid futurum sit, deinceps scribam.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z4"/>Contigit hic mihi nuncius intra horam discessurus, ut non possim <lb xml:id="p1z5"/>plura.</s>
					<s n="6" xml:lang="la">Hoc unum peto, ut ad meas proxime per <persName>Felkium</persName> <lb xml:id="p1z6"/>missas tandem rescribas; dubius enim sum, receperisne <lb xml:id="p1z7"/>eas necne.</s>
					<s n="7" xml:lang="la">Scripsi per eundem senatui, quas literas inter<lb xml:id="p1z8"/>cidisse nollem, cum aperuerim eis, quid mecum hic sit <lb xml:id="p1z9"/>actum.</s>
					<s n="8" xml:lang="la">Misi etiam 12 coronatos studiosis nostris <placeName ref="l41">Ber<lb xml:id="p1z10"/>natibus</placeName>, qui tamen nec ipsi respondent, an receperint vel non <lb xml:id="p1z11"/>acceperint, unde non modo dubius, sed et anxius et sollicitus fio.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z12"/>Responde, obsecro; ego enim nondum quicquam nostris respondi, <lb xml:id="p1z13"/>quamvis spatium illud temporis iam sit lapsum, quo me responsur<lb xml:id="p1z14"/>um promiseram.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale.</s>
					<s n="11" xml:lang="la" ana="salute">Salutat te cum uxore tua et liberis <lb xml:id="p1z15"/>mea, quae iam triduo ex angina decumbit.</s>
					<s n="12" xml:lang="la" ana="salute">Salutat vos <lb xml:id="p1z16"/>etiam <persName ref="p8417">Musculus</persName> cum familia sua.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l41">Bernae</placeName> 7. augusti 1549.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z17"/>Tuus, quem nosti.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
