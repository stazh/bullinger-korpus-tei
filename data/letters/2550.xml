	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salutem sempiternam in Christo Iesu.</s>
					<s n="2" xml:lang="la">Quemadmodum ad <lb xml:id="p1z2"/>meam magnam consolationem et comoditatem inveni apud te pietate <lb xml:id="p1z3"/>consilium, doctrinam et exemplum, cum pręsens essem <placeName ref="l587">Tiguri</placeName>, <lb xml:id="p1z4"/>sic nunc, colendissime in Christo pater, ad aedificandam Christi <lb xml:id="p1z5"/>ecclesiam <placeName ref="l830">Anglorum</placeName> <placeName ref="l157">Frankfordii</placeName> spero semper habiturum me <lb xml:id="p1z6"/>adiutrices tuas pias preces, et cum reliqui <placeName ref="l830">Angli</placeName> multi te <lb xml:id="p1z7"/>suum patronum habent, ego te mihi patrem etiam fuisse <lb xml:id="p1z8"/>agnosco et perseveraturum spero atque opto.</s>
					<s n="3" xml:lang="la">Atque quoniam <lb xml:id="p1z9"/>video me omni facultate et occasione referendi gratias esse <lb xml:id="p1z10"/>desitutum, haec nunc scribo, ut intelligas me nec immemorem <lb xml:id="p1z11"/>esse nec ingratum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ex <placeName ref="l830">Anglia</placeName> nihil certi; sed ex incertis <lb xml:id="p1z12"/>rumoribus accepi reginam non omnino fuisse gravidam atque <lb xml:id="p1z13"/>concilium, quod vocant parlamentum, subito fuisse finitum <lb xml:id="p1z14"/>idque propterea, quod rex non solum negavit, verum etiam contempsit <lb xml:id="p1z15"/>tres petitiones a magistratibus propositas, quarum prima erat, <lb xml:id="p1z16"/>ut veram religionem restauraret, secunda ut pacem cum <placeName ref="l832">Gallis</placeName> <lb xml:id="p1z17"/>firmaret, et tertia ut neminem extra <placeName ref="l830">Angliam</placeName> natum sibi <lb xml:id="p1z18"/>a conciliis esse admitteret.</s>
					<s n="5" xml:lang="la">Intelligo plures ex vanis <lb xml:id="p1z19"/>rumoribus quam ex vera resipiscentia consolationem querere.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute"><lb xml:id="p1z20"/>Ne graveris, quaeso, meo nomine salutare matrem meam uxorem <lb xml:id="p1z21"/>tuam reliquamque quoque vestram familiam, quibus omnibus <lb xml:id="p1z22"/>optima precari nunquam desinam.</s>
					<s n="7" xml:lang="la">Dominus Iesus te diu <lb xml:id="p1z23"/>nobis custodiat ad ecclesiae suae utilitatem.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale.</s>
					<s n="9" xml:lang="de"><placeName ref="l157">Frankfordii</placeName> <lb xml:id="p1z24"/>12. die februarii.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/>Tuus tibi in Christo deditissimus <lb xml:id="p1z26"/>filius <persName ref="p1911">Thomas Leverus</persName>.</s>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Colendissimo meo in Christo <lb xml:id="p2z2"/>patri d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>doctissimo et piissimo <lb xml:id="p2z4"/>ecclesiae pastori.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
