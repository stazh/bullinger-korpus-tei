	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Unum mihi nudius tertius exciderat de <persName ref="p3099">Sulcero</persName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Si quid fuisset in vestris <lb xml:id="p1z2"/>hominibus animi, statim conventum indici oportuit ut reliqui socii graviter <lb xml:id="p1z3"/>cum <placeName ref="l28">Basiliensibus</placeName> expostularent, et tandem ab ipsis exigerent ingenuam <lb xml:id="p1z4"/>et apertam sententiae suae declarationem.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ita in arenam pertracta fuisset <lb xml:id="p1z5"/>vulpes.</s>
					<s n="5" xml:lang="la">Atque in ea re curanda vos cessare miror.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Nam si haec dissidii <lb xml:id="p1z6"/>materia fovetur, in apertum ignem paulo post erumpet.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Vobiscum optime <lb xml:id="p1z7"/>consentiunt <placeName ref="l41">Bernates</placeName>, <placeName ref="l441">Schaffusiani</placeName>, <placeName ref="l473">Sangalenses</placeName>, ut nihil sit periculi <lb xml:id="p1z8"/>a minima controversia.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Si ergo pastores earum urbium postularent <lb xml:id="p1z9"/>a <persName ref="p3099">Sulcero</persName> quid sibi velit, turpiter cogeretur a temeraria subscriptione <lb xml:id="p1z10"/>discedere, ad quam eum mera ambitio impulit, vel saltem <lb xml:id="p1z11"/>detegeret quod hactenus occultavit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Nisi enim valde fallor <lb xml:id="p1z12"/>alio adspirat.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Certe nisi occurritis non sine vestra ignominia iacta<lb xml:id="p1z13"/>bunt adversarii Helvetios iam esse divisos.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Iam vicit <persName ref="p18137">Marpachii</persName> <lb xml:id="p1z14"/>importunitas ut <placeName ref="l832">Gallis</placeName> fuerint clausae templi fores.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Ita ecclesiola <lb xml:id="p1z15"/>quae 25 annis floruerat, furioso huius bestiae impetu eversa est.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z16"/><persName>Sturmius</persName> et <persName>Ottomannus</persName> pastorem demulcent, quo se ad mediam <lb xml:id="p1z17"/>aliquam rationem inflectat.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Volebant me habere suffragatorem, <lb xml:id="p1z18"/>sed consilium dedi quale mihi veritas dictabat.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Respondeo literis <lb xml:id="p1z19"/>domini <persName>Stanislai</persName> cuius cognomen manu eius scriptum non potui legere.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z20"/>Nisi mihi novus stimulus fuisset additus, tacere in animo habebam, <lb xml:id="p1z21"/>quia mihi suspecta nunc est ea natio quod pauci sincere agunt.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z22"/>Cum tamen intelligam liberos eius fuisse tuos contubernales, officio <lb xml:id="p1z23"/>deesse nolui.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Responsionem meam rogo ut perferendam cures.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="farewell">Vale, <lb xml:id="p1z24"/>clarissime vir et mihi plurimum observande frater.</s>
					<s n="20" xml:lang="la" ana="salute">Collegis omnibus <lb xml:id="p1z25"/>salutem plurimam.</s>
				</p>
				<p>
					<s n="21" xml:lang="de"><placeName ref="l167">Genevae</placeName> 12. sept. 1563.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><persName ref="p540">Io<lb xml:id="p1z26"/>hannes Calvinus</persName> tuus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="salute"><persName ref="p8078">Ionvillaeu<lb xml:id="p1z27"/>s</persName> tuus reverenter et <lb xml:id="p1z28"/>ex animo salutat.</s>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> fido pastori, fratri <lb xml:id="p2z3"/>ac symmystae mihi plurimum observando.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>