	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quod ad clarissimum virum d. <persName ref="p4082">Conradum Zviccium</persName>, compater <lb xml:id="p1z2"/>in domino charissime, meo nomine scripsisti, est, quod animo grato <lb xml:id="p1z3"/>agnoscam, et utinam vacario aliquo negocio rependere possim.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Infirmitati illius condoleo; oro dominum, ut virum utilem usibus hu<lb xml:id="p1z5"/>manis prolixiore ac magis incolumi vita donet.</s>
					<s n="4" xml:lang="la">Humanitatem <lb xml:id="p1z6"/>ac benevolentiam illius obviis ulnis amplector, qua mihi artis huius <lb xml:id="p1z7"/>lignariae communicationem per te polliceri dignatus est.</s>
					<s n="5" xml:lang="la">Mirum, <lb xml:id="p1z8"/>quam aegre expectem, donec voti huius compos evadam.</s>
					<s n="6" xml:lang="la">Quaeso, <lb xml:id="p1z9"/>agas illi meo nomine maximas gratias.</s>
					<s n="7" xml:lang="la">Tam enim certus <lb xml:id="p1z10"/>mihi de hoc videor illius beneficio, quam si iam re ipsa in <lb xml:id="p1z11"/>manibus, quod promisit, habeam; nam est mihi integritas <lb xml:id="p1z12"/>illius iam inde ab anno quadragesimo primo notissima, quo <lb xml:id="p1z13"/>mihi <placeName ref="l410">Ratisbonę</placeName> in comitiis primum innotescere coepit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Caeterum, quid sit a dominis nostris in causa Apocalypseos tuae de<lb xml:id="p1z15"/>cretum, nondum rescire potui.</s>
					<s n="9" xml:lang="la">Quod si opus hic apud nos <lb xml:id="p1z16"/>imprimitur, haud secus invigilabo, ut caste exeat, quam si <lb xml:id="p1z17"/>me ipsum concernat; est enim typographus mihi vicinus, <lb xml:id="p1z18"/>ut facile sit utrique, tam illi quam mihi, in hanc curam <lb xml:id="p1z19"/>incumbere.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/>Quae de <placeName ref="l2472">Polonia</placeName> scripsisti, nonnihil recrearunt animum meum <lb xml:id="p1z21"/>ac spem pristinam de reformatione ecclesiarum illic olijm conceptam <lb xml:id="p1z22"/>nonnihil erexerunt.</s>
					<s n="11" xml:lang="la">Iuvandi sunt precibus ad dominum, qui <lb xml:id="p1z23"/>in hoc opere tam sancto ac magno occupantur.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/>Ex <placeName ref="l18">Augusta</placeName> scriptum est ad me marchionem <persName ref="p18422">Albertum</persName>... <lb xml:id="p1z25"/>hostem ex hac vita migrasse nona mensis huius hora <lb xml:id="p1z26"/>pomeridiana secunda.</s>
					<s n="13" xml:lang="la">Mirabilia sunt iudicia dei.</s>
					<s n="14" xml:lang="la">De <lb xml:id="p1z27"/>expeditione <placeName ref="l2510">Turcorum</placeName> aliunde quoque accepi; misereatur <lb xml:id="p1z28"/>dominus <placeName ref="l822">Germanię</placeName> nostrae, quae in magno domi ac foris <lb xml:id="p1z29"/>discrimine versatur.</s>
					<s n="15" xml:lang="la" ana="farewell">Optime vale, compater charissime.</s>
					<s n="16" xml:lang="la" ana="salute">Salutem <lb xml:id="p1z30"/>toti domui tuae, dominis item ac fratribus, symmystis ac <lb xml:id="p1z31"/>professoribus.</s>
					<s n="17" xml:lang="la" ana="salute">Salutant vos omnes, uxor et domestici me<lb xml:id="p1z32"/>i.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1557. <lb xml:id="p1z33"/>27. ianuarii.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z34"/><persName ref="p8417">Wolfg[angus] Musculus</persName>, <lb xml:id="p1z35"/>compater tuus in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo m. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho <lb xml:id="p2z4"/>Bullingero</persName>, domino <lb xml:id="p2z5"/>ac compatri <lb xml:id="p2z6"/>suo charissimo.</s>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
