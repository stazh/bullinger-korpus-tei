	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Oblatus est mihi libellus contra articulos <placeName ref="l619">Bavaricos</placeName>, <lb xml:id="p1z2"/>ornatissime <persName ref="p495">Bullingere</persName>, quem expassis ulnis accepi, dignum <lb xml:id="p1z3"/>per se magna reverentia.</s>
					<s n="3" xml:lang="la">Dolet marschalcho nostro, <lb xml:id="p1z4"/>quod nullum habeat exemplum; tuum erit pro eo et eius <lb xml:id="p1z5"/>amicis mittere exemplaria.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Comitia in eo statu sunt, quem antea tibi descripsi; <lb xml:id="p1z7"/>diu certatum est, velintne oratores <placeName ref="l832">Gallicos</placeName> audire, <lb xml:id="p1z8"/>nec defuerunt, qui non audiendos putarint, nempe <lb xml:id="p1z9"/>ut offensum <persName>Gallum</persName> non haberent offensi propicium nec <lb xml:id="p1z10"/><placeName ref="l832">Gallia</placeName> afflictis esset posthac asilum; sed post <lb xml:id="p1z11"/>multa impetratum est, ut audire[n]tur.</s>
					<s n="5" xml:lang="la">Nihil <lb xml:id="p1z12"/>interea actum est in senatu imperii.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Affirmant mercatores constanter inducias ad <lb xml:id="p1z14"/>triennium inter <placeName ref="l2510">Turcam</placeName> et imperatorem <lb xml:id="p1z15"/>esse factas, quod tamen Cęsariani negant.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>Si inducię sunt factę, parum succedet <placeName ref="l850">Austriaco</placeName> <lb xml:id="p1z17"/>in impetranda pecunia.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z18"/>De pace inter <persName>Philippum</persName> et <persName ref="p8112">Gallum</persName> a[d]huc nihil c<lb xml:id="p1z19"/>erti habetur.</s>
					<s n="9" xml:lang="la">Pauci hic sunt legati et pręter <lb xml:id="p1z20"/>episcopos et <persName ref="p18604">Bavarum</persName> princeps nullus; qui tibi <lb xml:id="p1z21"/>hasce offert, multa novit.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z22"/>Fac me certiorem, num libellus de sectis papisticis <lb xml:id="p1z23"/>sit tibi oblatus.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Ocyssime 12. martii anno etc. 59.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><persName ref="p2856">G[ereon]</persName> <lb xml:id="p1z24"/>t[<lb xml:id="p1z25"/>uus].</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo atque doctissimo viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinricho Bullingero</persName>, domino et fratri <lb xml:id="p2z3"/>charissimo.</s>
				</p>
			</div>
		</body>
	</text>
