	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Excusabam negocia, que a scribendo impediverunt; spero etiam me <lb xml:id="p1z2"/>brevi ad vos profecturum et nos posse multis de rebus colloqui.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Nescio, quid d. <persName>S. Laurentii</persName> ad te scripsit de eis literis, quas ad me scripseras, <lb xml:id="p1z4"/>que in optimam partem semper sum interpretatus.</s>
					<s n="4" xml:lang="la">Tu per hunc, quem ad <lb xml:id="p1z5"/><persName>Rhetos</persName> mitto, ad me scribes.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="salute">Salutat te uxor.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute">Amicos communes salutabis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z6"/>Bene vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l760">Soluturi</placeName> 23. iunii raptim.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z7"/>Tuus ex animo <persName ref="p629">Coignetiu<lb xml:id="p1z8"/>s</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henricho Bullingero</persName>.</s>
				</p>
			</div>
		</body>
	</text>
