	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>ad Nicolaum Reritindem, Bernalem, data eum haec epiitola, vide ipsiuse
					<lb xml:id="p1z2"/>Ferchende Cuin ad Buvingurum d. 2. mai
					<lb xml:id="p1z3"/>Valde gratum mihi est, qu
					<lb xml:id="p1z4"/>verailla mea
					<lb xml:id="p1z5"/>chartacea ad te per me missa, tibi, vir amplissm
					<lb xml:id="p1z6"/>et amice ac frater honorande placuerunt. Equidem
					<lb xml:id="p1z7"/>in omnibus aliis officiis ex animo tibi cupio gratia
					<lb xml:id="p1z8"/>fcri.Iudicium vero tantum de mysteriis Christi
					<lb xml:id="p1z9"/>aapostolis simpliciter et minime spinose traditi
					<lb xml:id="p1z10"/>ecclesiae, eadem vero involvi et obscurari humano
					<lb xml:id="p1z11"/>temeritate et subtilitatibus parum perspicuis e
					<lb xml:id="p1z12"/>
					<lb xml:id="p1z13"/>utilibus  modi omnibus approbo, ut, qui nunquam tote
					<lb xml:id="p1z14"/>illo ministerii mei tempore istis sim vel usus
					<lb xml:id="p1z15"/>vel delectatus Studui semper et studeo adhuc a
					<lb xml:id="p1z16"/>vixero studebo mysteria illa salutaria
					<lb xml:id="p1z17"/>servatoris domini et redemptoris nostri. simpliciter
					<lb xml:id="p1z18"/>perspicue et ad captum popularium tradere, proant
					<lb xml:id="p1z19"/>apostolis et apostolicis viris accepi. Scotina
					<lb xml:id="p1z20"/>illa Scheggiana odi, a Somonianis vero acum
					<lb xml:id="p1z21"/>irreligiosis abherreo prorsus, ut de ipso
					<lb xml:id="p1z22"/>thoreiam dicam nihil. Quod vero respondendo in
					<lb xml:id="p1z23"/>Andreana illa prophana obiecta nos immersimus
					<lb xml:id="p1z24"/>profundius, provocati et inviti, interim necessitate
					<lb xml:id="p1z25"/>cogentes fecimus. Non ignoras, quas in ecclesia
					<lb xml:id="p1z26"/>fabulas invexere Valentiniani, quibus
					<lb xml:id="p1z27"/>et sanctissimi viri Irenaeus Tertilli et caeteru respond
