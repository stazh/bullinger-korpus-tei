	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Literas tuas, <persName ref="p495">Bullingere</persName> colendissime, cum doctissimis tuis de eucharistiae <lb xml:id="p1z3"/>negocio sermonibus bona fide accepi, quo nomine et me <lb xml:id="p1z4"/>plurimum tibi debere fateor, qui in dies novis me obruis beneficiis, <lb xml:id="p1z5"/>quibus quidem gratus, par autem nequaquam esse possum, qui in <lb xml:id="p1z6"/>paucis et levibus tantam meam tibi operam inpendere possum.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Novarum rerum nihil plane habemus, licet fama sit nescio quos <lb xml:id="p1z8"/>principes <placeName ref="l822">Germanos</placeName> marchionis crudelitati iam oppositos <lb xml:id="p1z9"/>esse, ut vi ab instituta crudelitate, qua <placeName ref="l822">Germania</placeName> labe<lb xml:id="p1z10"/>factatur, hominem ad meliora vi etiam revocent.</s>
					<s n="4" xml:lang="la">Silent nunc <lb xml:id="p1z11"/>apud nos omnia; nam de <placeName ref="l749">Saxonica</placeName> etiam, de qua scribis, expe<lb xml:id="p1z12"/>ditione nihil audivimus.</s>
					<s n="5" xml:lang="la">Mitto tibi papistici regni <lb xml:id="p1z13"/>veram, poeticam tamen descriptionem a <persName ref="p8124">Naogeorgo</persName> editam, <lb xml:id="p1z14"/>quam tibi non ingratam ob argumenti rationem fore <lb xml:id="p1z15"/>confido.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Raptim <placeName ref="l28">Basileae</placeName> 22. iunii anno <lb xml:id="p1z16"/>1552.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Tuus <lb xml:id="p1z21"/><persName ref="p8406">Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>pastori, domino <lb xml:id="p2z4"/>suo colendissimo.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
