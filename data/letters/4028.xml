	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi tuas 24. iulii scriptas.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Quo<lb xml:id="p1z2"/>niam vero hisce diebus domestico et gravi <lb xml:id="p1z3"/>dolore capitis mei laboro, nihil nunc scribo, <lb xml:id="p1z4"/>nisi quod tuas accepi, et gratias ago pro di<lb xml:id="p1z5"/>ligentia.</s>
					<s n="4" xml:lang="la">Dominus manifesto iudicio regem <lb xml:id="p1z6"/>sustulit, qui gravem manum in ecclesiam dei <lb xml:id="p1z7"/>incutere voluit.</s>
					<s n="5" xml:lang="la">Faxit dominus, ut hoc <lb xml:id="p1z8"/>agnoscant consiliarii <persName ref="p5497">Francisci</persName>, cui <lb xml:id="p1z9"/>omnia felicia precor.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute">Commenda me d. le<lb xml:id="p1z10"/>gato, d. d. consulibus, d. <persName ref="p8359">Gallicio</persName>, <persName ref="p6130">Pontasellae</persName> <lb xml:id="p1z11"/>et omnibus bonis.</s>
					<s n="7" xml:lang="la">Quaeso, diligenter has <lb xml:id="p1z12"/>cura deferri a d. <persName>Friderycho</persName>, qui iussit <lb xml:id="p1z13"/>eas <placeName ref="l440">Samadenum</placeName> mitti, ubi nunc est.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z14"/><placeName ref="l587">Tiguri</placeName> 27. iulii 1559.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Io<lb xml:id="p2z2"/>anni Fabritio</persName>, <placeName ref="l98">Curiae <lb xml:id="p2z3"/>Rhetorum</placeName> Christum <lb xml:id="p2z4"/>annuncianti, compatri <lb xml:id="p2z5"/>et fratri suo charissimo.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
