	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi modo literas tuas per hunc ministrum <lb xml:id="p1z2"/><persName>Petri Sprecheri</persName> una cum consignatione rerum actarum <lb xml:id="p1z3"/>a iudicibus, quantum habere potuisti.</s>
					<s n="3" xml:lang="la">Gratias tibi ago, <lb xml:id="p1z4"/>nec dubito, quin binas ad te missas per cursorem <lb xml:id="p1z5"/>nostrum publicum et per Lumagas acceperis.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Quid petiverim non abs re in literis per cursorem <lb xml:id="p1z7"/>publicum missis, intellexisti.</s>
					<s n="5" xml:lang="la">Ab iis nihil interim <lb xml:id="p1z8"/>accepi amplius, nisi quod illevi in chartam <lb xml:id="p1z9"/>his impositam.</s>
					<s n="6" xml:lang="la">Literae <placeName ref="l18">Augustae Vindelicorum</placeName> scriptae in <lb xml:id="p1z10"/>itinere substitere diutius; ergo tardius<note type="margin">a.R.: tradius!</note> mihi <lb xml:id="p1z11"/>sunt redditae.</s>
					<s n="7" xml:lang="la">Si quid allatum fuerit vel <lb xml:id="p1z12"/>ex <placeName ref="l822">Germania</placeName> vel <placeName ref="l832">Gallia</placeName>, communicabo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Tu diligenter <lb xml:id="p1z13"/>perquire in res <placeName ref="l834">Italicas</placeName>, praesertim, cum modo <lb xml:id="p1z14"/><placeName ref="l862">Helvetica</placeName> signa imposita sint urbibus Venetorum, <lb xml:id="p1z15"/>quid ibi fiat; an bellum inter Venetos, <lb xml:id="p1z16"/>papam et <placeName ref="l875">Hispanos</placeName> exoriturum sit; quid feratur <lb xml:id="p1z17"/>de rebus <placeName ref="l2510">Turcicis</placeName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">De Caesare nondum certum <lb xml:id="p1z18"/>aliquid habemus, mortuus an vivus sit; fama in<lb xml:id="p1z19"/>crebuerat mortuum esse, maxime quod <persName ref="p18477">Ferdinandus</persName> <lb xml:id="p1z20"/>pullis cum tota aula vestitus descenderet <lb xml:id="p1z21"/><placeName ref="l546">Viennam</placeName>.</s>
					<s n="10" xml:lang="la">Nunc rediit ille et transit nunc per <lb xml:id="p1z22"/><placeName ref="l257">Constanciam</placeName>, <placeName ref="l441">Schaffhusium</placeName> in <placeName ref="l632">Alsatiam</placeName>, ubi <lb xml:id="p1z23"/>illum plus timere dicuntur quam pruinam et nives, <lb xml:id="p1z24"/>quae vineas perdidere et ad inopiam redegere <lb xml:id="p1z25"/>ut et nos.</s>
					<s n="11" xml:lang="la">Calamitates multae et graves <lb xml:id="p1z26"/>atterunt mundum prope insensibilem factum.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z27"/>Dominus misereatur nostri!</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Vale una cum familia <lb xml:id="p1z28"/>et symmystis, fratribus et amicis omnibus, quos <lb xml:id="p1z29"/>ordine salutabis.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 1. maii 1573.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z30"/>Nostri omnes te salutant.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z31"/>Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem frommen, wolgelerten <lb xml:id="p2z2"/>und getruwen herren <persName ref="p8016">Thobia <lb xml:id="p2z3"/>Egli</persName>, pfarreren zuͦ <lb xml:id="p2z4"/>Sant Martin, minem <lb xml:id="p2z5"/>lieben herren etc. zuͦ <lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>