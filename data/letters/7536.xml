	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non arbitror te aegrotare neque tabellionibus d<lb xml:id="p1z2"/>estitui, qui literas tuas, chare frater, ad nos perferant; miror <lb xml:id="p1z3"/>itaque, qui fiat, quod integris 3 septimanis nihil <lb xml:id="p1z4"/>scripseris.</s>
					<s n="3" xml:lang="la">Ego quoque nullas ad te dedi; non enim habui, <lb xml:id="p1z5"/>quod scriberem.</s>
					<s n="4" xml:lang="la">Tu vero hac excusatione, uti non potes, <lb xml:id="p1z6"/>qui potuisses perscribere negotium 3 legatorum <placeName ref="l306">Mediolano</placeName> <lb xml:id="p1z7"/>redeuntium.</s>
					<s n="5" xml:lang="la">Audio rediisse illos, sed sine <persName ref="p19166">Francesco</persName>, <lb xml:id="p1z8"/>qui traditus sit bestiis immanissimis inquisitoribus; <lb xml:id="p1z9"/>unde plane mihi persuadeo iam cum eo esse actum.</s>
					<s n="6" xml:lang="la">Sed serv<lb xml:id="p1z10"/>abit in se sperantem dominus, et saluberrimum est eripi <lb xml:id="p1z11"/>ex hoc saeculo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Si interea, quid actum sit in legatione, <lb xml:id="p1z12"/>intellexeris, scribe, oro, id quid sit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Interim dum expecto, quid de rebus, quae alibi fiunt, <lb xml:id="p1z14"/>ad te possim scribere, ex nundinis <placeName ref="l491">Argentoraten[sibu<lb xml:id="p1z15"/>s]</placeName> literas [ex] <placeName ref="l830">Anglia</placeName> scriptas 19. iunii accipio; sunt reverendissimi <lb xml:id="p1z16"/>episcopi <placeName ref="l296">Londoniensis</placeName>.</s>
					<s n="9" xml:lang="la">Significat ille res <placeName ref="l830">Anglorum</placeName> <lb xml:id="p1z17"/>bono et felici esse statu.</s>
					<s n="10" xml:lang="la">Nunc demum turbas [seda]<lb xml:id="p1z18"/>tas in <placeName ref="l2524">Scotia</placeName>; nam 2. maii ex carceribus e[vasisse<lb xml:id="p1z19"/>] <persName ref="p18212">reginam Scotiae</persName> in arcem <placeName>Hamiltoniam</placeName>.</s>
					<s n="11" xml:lang="la">Ibi d[uces] <lb xml:id="p1z20"/>conscribit repetitura regnum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Adest gubernator et [copias] <lb xml:id="p1z21"/>illas fundit fugatque maii 13.</s>
					<s n="13" xml:lang="la">Regina cum paucis <lb xml:id="p1z22"/>effugit Cariolensem usque in urbem <placeName ref="l830">Angliae</placeName>; inde <lb xml:id="p1z23"/>supplicat reginae Angliae, ut ipsam iuvet et regn<lb xml:id="p1z24"/>o restituat.</s>
					<s n="14" xml:lang="la">At <persName ref="p18212">reginam Scoticam</persName> illam custodire; <lb xml:id="p1z25"/>etenim petitur illa ad supplicium a gubernatore Scoti<lb xml:id="p1z26"/>ae; rursus petitur eadem a <persName ref="p20341">rege Galliae</persName> ad liberationem.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z27"/><persName ref="p18465">Regina Angliae</persName> neutris illam adhuc concessit.</s>
					<s n="16" xml:lang="la">Quid futurum s<lb xml:id="p1z28"/>it, brevi audiemus.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z29"/>In <placeName ref="l808">Belgio</placeName> post stragem <lb xml:id="p1z30"/>clademve acceptam <placeName ref="l875">Hispanorum</placeName> furit dux <lb xml:id="p1z31"/>Albanus impatientia infortunii; dicitur enim insignes <lb xml:id="p1z32"/><placeName ref="l875">Hispanos</placeName> <placeName ref="l875">Hispanorumque</placeName> duces ibi cecidisse.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Ergo <placeName ref="l1284">Bruxellae</placeName> <lb xml:id="p1z33"/>iunii 5. obtruncare iubet nobiles et heroas <placeName ref="l808">Belgas</placeName> <lb xml:id="p1z34"/>olim captos plerosque, <persName>Egmondanum</persName>, <persName>Hornum</persName>, comites <lb xml:id="p1z35"/><placeName>Battenburgenses</placeName>, d. a <persName>Wyllers</persName> ac circiter 50, <lb xml:id="p1z36"/>inter quos intercepit etiam iuvenes aliquot annorum <lb xml:id="p1z37"/>forte 15, heroum filios.</s>
					<s n="19" xml:lang="la">Iis confectis cum 17 vexillis <lb xml:id="p1z38"/>progreditur <placeName ref="l15">Antverpiam</placeName> ibidem quoque mactaturus; <lb xml:id="p1z39"/>verum <placeName ref="l15">Antverpiae</placeName> accepit nuncium, unde vehementer <lb xml:id="p1z40"/>dicitur contristatus.</s>
					<s n="20" xml:lang="la">Neminem ergo ibi occidit, <lb xml:id="p1z41"/>sed 4. die, ex quo appulit, recessit <placeName ref="l185">Groningam</placeName> versus <lb xml:id="p1z42"/>omnibus praesidiis eo confluere iussis.</s>
					<s n="21" xml:lang="la">Dicitur autem rursus pugnatum, <lb xml:id="p1z43"/>antea scilicet et priusquam <placeName ref="l15">Antverpia</placeName> ille sit profectus, levibus proeliis, in quibus ceciderint <lb xml:id="p1z44"/>circiter 600 <placeName ref="l875">Hispanorum</placeName>; Wallonum signa 13 et <placeName ref="l185">Groni<pb/><lb xml:id="p2z1"/>ngam</placeName> sese dedidisse principi Uranio et <lb xml:id="p2z2"/>fratri, <persName ref="p20180">Ludovico Nassoviensi</persName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Dicuntur item novae <lb xml:id="p2z3"/>copiae accedere ad principem et duo millia <lb xml:id="p2z4"/>equitum Germanorum ad ducem Albanum.</s>
					<s n="23" xml:lang="la">Putant <lb xml:id="p2z5"/>omnes copiis signisque collatis confligendum aut <lb xml:id="p2z6"/>nunc esse pugnatum.</s>
					<s n="24" xml:lang="la">De qua re si quid certi ac<lb xml:id="p2z7"/>cepero, alias ad te perscribam.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Nunc te bene <lb xml:id="p2z8"/>valere opto.</s>
					<s n="26" xml:lang="la" ana="salute">Salutabis d. d.d consules, d. <persName ref="p1770">Carolum</persName>, <lb xml:id="p2z9"/>d. <persName ref="p6130">Pontisellam</persName>, <persName ref="p20473">Ganthnerum</persName> et omnes nostros.</s>
					<s n="27" xml:lang="la" ana="farewell">Iterum <lb xml:id="p2z10"/>iterumque vale.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 23. iulii 1568.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><lb xml:id="p2z11"/><persName ref="p495">Bullingerus</persName> senior tuus.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><pb/><lb xml:id="p4z1"/>Ornatissimo viro d. <lb xml:id="p4z2"/><persName ref="p8016">Tobiae Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p4z3"/>ecclesiae fideli <lb xml:id="p4z4"/>ministro, domino <lb xml:id="p4z5"/>et fratri meo <lb xml:id="p4z6"/>colendo et dilecto.</s>
				</p>
				<p>
					<s n="31" xml:lang="la"><lb xml:id="p4z7"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
