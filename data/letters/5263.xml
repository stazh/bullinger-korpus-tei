	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non fuit scribendi otium.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Quia tam <lb xml:id="p1z2"/><persName>Petrus</persName> hic <persName>Bontinus</persName>, pharmacopola, iuvenis <lb xml:id="p1z3"/>valde pius, ad vos erat profecturus, nolui eum <lb xml:id="p1z4"/>sine meis literis dimittere, quibus saltem signi<lb xml:id="p1z5"/>ficarem tuas me accepisse, quibus summam l<lb xml:id="p1z6"/>egationis exponis <persName>Ramboletii</persName> et <persName ref="p1586">Hottomani</persName>.</s>
					<s n="4" xml:lang="la">Video <lb xml:id="p1z7"/>et experior inter principes vix alius iniquio<lb xml:id="p1z8"/>res esse nobis quam <placeName>Bipontinum</placeName> et <placeName ref="l572">Wirtemb[ergensem]</placeName>; audio <lb xml:id="p1z9"/>hunc prohibuisse in sua ditione orationem <lb xml:id="p1z10"/><persName ref="p8033">Bezae</persName> habitam in colloquio Possiaco, pro certo <lb xml:id="p1z11"/>tamen non refero.</s>
					<s n="5" xml:lang="la">Ita aiunt nova comitia <lb xml:id="p1z12"/>instituta esse ad <placeName ref="l2074">Tabernas</placeName> illas <placeName ref="l632">Alsaticas</placeName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Audivi, quid designarit <persName>Guysianus</persName> et quid <lb xml:id="p1z14"/>conatus sit; conatum eius fractum a domino <lb xml:id="p1z15"/>spero et avide a te expecto, quid ea de re sis <lb xml:id="p1z16"/>scripturus.</s>
					<s n="7" xml:lang="la">Quae misi de concilio <placeName ref="l1107">Tridentino</placeName> <lb xml:id="p1z17"/>et liberi conditionibus concilii, si placet, <lb xml:id="p1z18"/>in <placeName ref="l832">Galliam</placeName> mittes; non displicuere nostris.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z19"/>Si nondum allatum est ad te decretum sessionis <lb xml:id="p1z20"/>primae, mittam ad te.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Bremae in <placeName ref="l749">Saxonia</placeName> <lb xml:id="p1z21"/>audio excitatum tumultum maximum et eiectum <lb xml:id="p1z22"/>inde <persName>Musaeum</persName> et <persName>Lutheranis</persName> caeteris <lb xml:id="p1z23"/>frenum esse iniectum.</s>
					<s n="10" xml:lang="la"><persName ref="p4664">Paulum Eberum</persName> aiunt <lb xml:id="p1z24"/>territum <persName ref="p20367">Hesshusii</persName> libro conciliasse se hostibus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z25"/>Comitia Heremitana non procedunt; nam alter <lb xml:id="p1z26"/>iudicum in c[aus]a <placeName ref="l646">Claronensi</placeName>, amanus <placeName ref="l781">Uriensis</placeName>, <lb xml:id="p1z27"/>mortuus est, unde alium iudicem in eius locum <lb xml:id="p1z28"/>oportet substitui.</s>
					<s n="12" xml:lang="la">Audiuntur passim minae, <lb xml:id="p1z29"/>quanta ferocia finito concilio invadere <lb xml:id="p1z30"/>velint evangelicos papistę et redigere in <lb xml:id="p1z31"/>ordinem, imo ad unum trucidare omnes.</s>
					<s n="13" xml:lang="la">Orandus <lb xml:id="p1z32"/>ergo dominus, ut servet invocantes nomen <lb xml:id="p1z33"/>eius et convertat vel evertat persequentes <lb xml:id="p1z34"/>veritatem etc.</s>
					<s n="14" xml:lang="la" ana="farewell">Optime vale, domine <lb xml:id="p1z35"/>colendissime et frater charissime, una cum collegis, fratribus <lb xml:id="p1z36"/>et amicis.</s>
					<s n="15" xml:lang="la" ana="salute">Salutabis veterem amicum d. <lb xml:id="p1z37"/><persName ref="p8078">Jonvilleum</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Quae communicabat d. <persName ref="p4440">Budaeus</persName> <lb xml:id="p1z38"/>mox mittebam ad Coignetium etc.</s>
					<s n="17" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z39"/>5. aprilis 1562.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z40"/>Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z41"/>Non relegi.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p540">Ioanni <lb xml:id="p2z2"/>Calvino</persName>, fidelissimo <placeName ref="l167">Ge<lb xml:id="p2z3"/>nevensis</placeName> ecclesiae pastori, <lb xml:id="p2z4"/>domino suo colendo <lb xml:id="p2z5"/>et fratri charissimo.</s>
					<s n="21" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l167">Genff</placeName>.</s>
				</p>
			</div>
