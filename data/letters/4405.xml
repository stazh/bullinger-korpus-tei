	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Vog. 223..
					<lb xml:id="p1z2"/>fama est Tolulerum
					<lb xml:id="p1z3"/>Eiscopo Laybacensis venisse
					<lb xml:id="p1z4"/>cnstantiam et agere de de
					<lb xml:id="p1z5"/>ponendo episcopo Mezlero et
					<lb xml:id="p1z6"/>rogendo ei Gabriele ab
					<lb xml:id="p1z7"/>Eups cardinale, Fabrica
					<lb xml:id="p1z8"/>illo mille sacramenta
					<lb xml:id="p1z9"/>Quodsi verum
					<lb xml:id="p1z10"/>quis non videat, qid
					<lb xml:id="p1z11"/>homines isto moliantur?
					<lb xml:id="p1z12"/>ffe
					<lb xml:id="p1z13"/>Der
				</p>
			</div>
		</body>
	</text>
