	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Observande pater S.</s>
					<s n="2" xml:lang="la">Literas tuas datas <placeName ref="l587">Tiguro</placeName> 5. iulii accepi <lb xml:id="p1z2"/>die 26. septembris; nunc vide, quid possint <lb xml:id="p1z3"/>interiecta haec vos inter atque nos saxa.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Miratus tu es fortasse, quod non responderim; sed <lb xml:id="p1z5"/>ego multo magis miror hominum rusticitatem, <lb xml:id="p1z6"/>ne dicam improbitatem.</s>
					<s n="4" xml:lang="la">Verum cum nova hęc non <lb xml:id="p1z7"/>sint, sed usitata hominibus huius mundi, desinam <lb xml:id="p1z8"/>mirari.</s>
					<s n="5" xml:lang="la">Erat in illis tuis literis de <lb xml:id="p1z9"/><persName ref="p20227">Valentino Gentili</persName> eum tunc captivum <placeName ref="l41">Bernam</placeName> duci; <lb xml:id="p1z10"/>sed nihil praeterea audivi et aveo audire, quid <lb xml:id="p1z11"/>cum eo actum sit.</s>
					<s n="6" xml:lang="la">Venit huc nuper <lb xml:id="p1z12"/>ex <placeName ref="l2472">Polonia</placeName> <persName ref="p5942">Georgius Niger</persName>, <persName ref="p8022">F[rancisci] N[igri]</persName> filius; <lb xml:id="p1z13"/>retulit multa e <placeName ref="l2472">Polonia</placeName>, quę nimis longum <lb xml:id="p1z14"/>fuerit recensere; sed hęc praecipua non possem <lb xml:id="p1z15"/>omittere <persName ref="p2336">Ochinum</persName> sese palam declarare Ser<lb xml:id="p1z16"/>vetanum, anabaptistam et harum socium e<lb xml:id="p1z17"/>cclesiarum; <persName ref="p1936">Lismaninum</persName> sese praecipitem <lb xml:id="p1z18"/>dedisse in puteum quendam ibique misere <lb xml:id="p1z19"/>periisse.</s>
					<s n="7" xml:lang="la">Totum regnum propter tot tamque <lb xml:id="p1z20"/>grandes et horrendas hęreses <lb xml:id="p1z21"/>perturbatum, <lb xml:id="p1z22"/>multos resilire ad papatum, alios fieri <lb xml:id="p1z23"/>vel hęreticos vel<foreign xml:lang="el">ἄθεος</foreign> Summa: maxima<lb xml:id="p1z24"/>m ibi iam esse<foreign xml:lang="el">ἀταξίαν</foreign> religionis; <lb xml:id="p1z25"/>est igitur pro illis ecclesiis assidue orandum.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z26"/>In <lb xml:id="p1z27"/><placeName ref="l834">Italia</placeName> tanta est persecutio, quantam nunquam antea fuisse <lb xml:id="p1z28"/>accepi.</s>
					<s n="9" xml:lang="la">Ubique decretum hoc pontificium receptum <pb/><lb xml:id="p2z1"/>est, ut ne medici quempiam antea curent <lb xml:id="p2z2"/>ęgrotum, quam ille sacrifico suo confiteatur <lb xml:id="p2z3"/>peccata et<foreign xml:lang="el">εὐχαριστίαν</foreign> sumat.</s>
					<s n="10" xml:lang="la">Ferun<lb xml:id="p2z4"/>t papam cum principibus <placeName ref="l834">Italię</placeName> constituisse, ut, <lb xml:id="p2z5"/>quando iam fere totus orbis infectus <lb xml:id="p2z6"/>est heresibus, saltem <placeName ref="l834">Italia</placeName> maneat mun<lb xml:id="p2z7"/>da et pura (si deo placet) in <lb xml:id="p2z8"/>religione, tum sanctam degere vitam, severem <lb xml:id="p2z9"/>esse in omnes sceleratos, scortis etiam [.<lb xml:id="p2z10"/>..] purgasse, popul s novis omnibus <lb xml:id="p2z11"/>et iniquis <foreign xml:lang="el">ἀγγαρείοις</foreign> liberent; denique <lb xml:id="p2z12"/>magnam simulare aequitatem et sanctitatem <lb xml:id="p2z13"/>hac ratione, ut sit crudelior in pios.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z14"/>Pestilentia interim quam plurimos tollit <placeName ref="l425">Romę</placeName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z15"/>Sed heu, quantum mihi attulit doloris obitus <lb xml:id="p2z16"/>nostri <persName ref="p8009">Fabritii</persName>, viri docti, pii et fidi <lb xml:id="p2z17"/>pastoris fratrisque carissimi; e multis amicis, <lb xml:id="p2z18"/>quos in <placeName ref="l822">Germania</placeName> reliqui, unus ille <lb xml:id="p2z19"/>supererat, cuius pręsentia et consuetudine <lb xml:id="p2z20"/>aliquando possem frui.</s>
					<s n="13" xml:lang="la">At deus hunc <lb xml:id="p2z21"/>etiam eripuit.</s>
					<s n="14" xml:lang="la">Cęterum magis doleo vices <lb xml:id="p2z22"/>non illius tantum, hoc est <placeName ref="l98">Curiensis</placeName>, sed <lb xml:id="p2z23"/>harum et omnium ecclesiarum, qui <lb xml:id="p2z24"/>tantum amiserimus virum.</s>
					<s n="15" xml:lang="la">Sed quid nostra <lb xml:id="p2z25"/>non merentur peccata?</s>
					<s n="16" xml:lang="la">Dum <placeName ref="l98">Curienses</placeName> <lb xml:id="p2z26"/>voluerunt defendere episcopos papisticos, hoc <lb xml:id="p2z27"/>est lupos, veros amiserunt past<pb/><lb xml:id="p3z1"/>ores.</s>
					<s n="17" xml:lang="la"><lb xml:id="p3z2"/>Faxit dominus, ut nostri, postquam <lb xml:id="p3z3"/>senserint <lb xml:id="p3z4"/>manum domini, resipiscant.</s>
					<s n="18" xml:lang="la">Credo petituros <lb xml:id="p3z5"/>aliquem alium a vobis pastorem; rog<lb xml:id="p3z6"/>o, cures, ut aliquem nobis detis <lb xml:id="p3z7"/>haud dissimilem <persName ref="p8009">Fabricio</persName>.</s>
					<s n="19" xml:lang="la">Opus certe <lb xml:id="p3z8"/>habet illa ecclesia cordato et forti <lb xml:id="p3z9"/>pastore.</s>
					<s n="20" xml:lang="la">Nos hic dei beneficio valemus, <lb xml:id="p3z10"/>et novi subinde ex <placeName ref="l834">Italia</placeName> <lb xml:id="p3z11"/>fratres ad nos confugiunt pulsi ab antichristo.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="farewell"><lb xml:id="p3z12"/>Vale, et pro nobis orate.</s>
					<s n="22" xml:lang="la" ana="salute">Quibus <lb xml:id="p3z13"/>salutem dixi tuo nomine, te perhumaniter resalutant.</s>
					<s n="23" xml:lang="la"><lb xml:id="p3z14"/><placeName ref="l93">Clavenna</placeName> 7. octobris 66.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p3z15"/>T[uus] <lb xml:id="p3z16"/><persName ref="p4037">H[ieronymus] <pb/><lb xml:id="p4z1"/>Zanchus</persName>.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p4z2"/>Clarissimo viro <lb xml:id="p4z3"/>d. <persName ref="p495">H[enrico] Bullingero</persName>, ecclesię <lb xml:id="p4z4"/><placeName ref="l587">Tigurinę</placeName> pastori et <lb xml:id="p4z5"/>patri colendissimo.</s>
					<s n="26" xml:lang="la"><lb xml:id="p4z6"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
