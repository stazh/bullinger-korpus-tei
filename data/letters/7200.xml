	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D.
					<lb xml:id="p1z2"/>Literas tuas, 8. augusti ad me scriptas, clarissime vir,
					<lb xml:id="p1z3"/>et pater in Christo colendissime, undevima eius.
					<lb xml:id="p1z4"/>mensis olie vesperi accepi. Illae et mihi et
					<lb xml:id="p1z5"/>fratribus omnibus per omnia satisfaciunt.
					<lb xml:id="p1z6"/>grahasque summas pro summa tua humanitati
					<lb xml:id="p1z7"/>et incessabili labore atque diligentia agimus
					<lb xml:id="p1z8"/>deumque toto pectore oramus, ut te, verum vera
					<lb xml:id="p1z9"/>patriae, hoc est, ecclesiae patrem in Nestoreos, quoa
					<lb xml:id="p1z10"/>iur annos incolumem nobis conservare dign.
					<lb xml:id="p1z11"/>Probati autem imprimis, quod stolidissima
					<lb xml:id="p1z12"/>superbissimumque marpachium cum libri
					<lb xml:id="p1z13"/>suo et asseclis illustrissimo principi, ut dignum
					<lb xml:id="p1z14"/>omnino et necessarium erat, depinxisti.
					<lb xml:id="p1z15"/>Cum illae olim Vitebergae Philippum Melanthorm
					<lb xml:id="p1z16"/>interrogaret, cui se facultati applicaret,
					<lb xml:id="p1z17"/>ntuens ille hominem accuratius, ut solebat, manibus
					<lb xml:id="p1z18"/>redibusque theologiae studium dissuasit et ad
					<lb xml:id="p1z19"/>viris scientiam discendam hortatus est.
					<lb xml:id="p1z20"/>Hoc nullam aliam ob causam faciebat, quam
					<lb xml:id="p1z21"/>quod ingenium et naturam in eo cernebat
					<lb xml:id="p1z22"/>vanae gloriae cupidissimum. Inde factum est
					<lb xml:id="p1z23"/>ut contra tanti viri consilium et voluntatem.
					<lb xml:id="p1z24"/>eo nihilomnius contenderet, quo non celestis
					<lb xml:id="p1z25"/>impetus ecclesiaeque salus, sed vanae gloriae cupi
					<lb xml:id="p1z26"/>rapiebat; nuncque unum pedem in curca
					<lb xml:id="p1z27"/>alterum habeat in ecclesia. Pergrata est
					<lb xml:id="p1z28"/>fuere nova, quae communicasti, eoque gratiora
					<lb xml:id="p1z29"/>quod apud nostros Scaphusianos perpetuum
					<lb xml:id="p1z30"/>fere de his et similibus silentium est.
					<lb xml:id="p1z31"/>est aut et felicitatis et in felicitatis ecclesia
					<lb xml:id="p1z32"/>communicatio inter fratres, non solum utilis
					<lb xml:id="p1z33"/>sed etiam necessaria, ut scilicet communibus
					<lb xml:id="p1z34"/>vigilantia gratiarum actione aliisque
					<lb xml:id="p1z35"/>officiis piis gloria dei ecclesiaeque salus
					<lb xml:id="p1z36"/>tpromoveri possit. Pc
					<pb/>
					<lb xml:id="p2z1"/>articulos illius Waldneri mihi alias ignoti,
					<lb xml:id="p2z2"/>aut impudentissima mendacia aut foe
					<lb xml:id="p2z3"/>calumnias continent. Unum tam
					<lb xml:id="p2z4"/>est quod me movet, quodque meo iudicio,
					<lb xml:id="p2z5"/>ut libere loquar, in ecclesiis nostris corrigi facile
					<lb xml:id="p2z6"/>et non sine fructu posset. Quod nimirum
					<lb xml:id="p2z7"/>in ecclesiis nostris, licet non omnibus rarissima
					<lb xml:id="p2z8"/>dominicae coenae usus est, qui tamin
					<lb xml:id="p2z9"/>ipsis apostolicis et purioris ecclesiae temporibus
					<lb xml:id="p2z10"/>frequentissimus fuit. Equidem vix scio, an
					<lb xml:id="p2z11"/>ullum aliud plausibilius arguem proferre contra
					<lb xml:id="p2z12"/>possint, quo in magno apud nos conse
					<lb xml:id="p2z13"/>temptu tantum mysterium esse suis auditorius
					<lb xml:id="p2z14"/>persuadere conenti, quam sit hoc unicum
					<lb xml:id="p2z15"/>et frequentior Basileae Argentinae etiam
					<lb xml:id="p2z16"/>cum nobiscum consentierent, usus fuit,
					<lb xml:id="p2z17"/>et nunc quoque in pasalmatu est, quam in
					<lb xml:id="p2z18"/>plerisque Helvetiae ecclesiis sit. Scio quidem
					<lb xml:id="p2z19"/>liberum debere esse huius mysterii usum.
					<lb xml:id="p2z20"/>quam ad tempus et alias circumstantias
					<lb xml:id="p2z21"/>attinet, attamen, quod ita liberum ned
					<lb xml:id="p2z22"/>ut qui temporibus apostolicis ex institieto
					<lb xml:id="p2z23"/>Christi frequentissimus fuit, nunc rarissimus
					<lb xml:id="p2z24"/>sit videre nondum possum. Optarim igitur
					<lb xml:id="p2z25"/>nostras ecclesias, praecidere hanc adversariis
					<lb xml:id="p2z26"/>nostris, sicut et alias quascunque, calumni
					<lb xml:id="p2z27"/>ansam, praesertim cum libertatem nostram
					<lb xml:id="p2z28"/>ita nos moderari deceat, ne cuiquam offendicu
					<lb xml:id="p2z29"/>quanum in nobis est simus. Haec colendissimi
					<lb xml:id="p2z30"/>me in Christo patert non disputandi, sed discendi
					<lb xml:id="p2z31"/>studio scribo, ut, qui omnibus ecclesiis optime
					<lb xml:id="p2z32"/>consultum cupio, interim reverentes
					<pb/>
					<lb xml:id="p3z1"/>ae
					<lb xml:id="p3z2"/>lic
					<lb xml:id="p3z3"/>orans, ut, quae tua sit sententia, uno saltem
					<lb xml:id="p3z4"/>atque altero verbo per ocium signare velis.
					<lb xml:id="p3z5"/>et ne tibi plus nimium molestus sui, hi
					<lb xml:id="p3z6"/>scribendi fenem facio. Salutant tuam
					<lb xml:id="p3z7"/>humanitatem omnesque fratres reverenter
					<lb xml:id="p3z8"/>omnes symmystae et fratres nostri. resalutant
					<lb xml:id="p3z9"/>et humaniter cossule nostri, doctor Marhnus
					<lb xml:id="p3z10"/>Peyerus et d. Bovillus tibique tuisque omnia
					<lb xml:id="p3z11"/>fausta atque foelicia mecum praecanti. Vale.
					<lb xml:id="p3z12"/>Datam 14. augusti anno 1567.
					<lb xml:id="p3z13"/>Tui studiosissimus et
					<lb xml:id="p3z14"/>observantissimu
					<lb xml:id="p3z15"/>Iohannes Conradus
					<lb xml:id="p3z16"/>Ulmerus.
					<pb/>
					<lb xml:id="p4z1"/>Clarissimo omimque pietatis
					<lb xml:id="p4z2"/>atque eruditionis genere orna
					<lb xml:id="p4z3"/>viro d. Heinricho
					<lb xml:id="p4z4"/>Bullingero seniori, ecclesiae
					<lb xml:id="p4z5"/><placeName ref="l587">Tigurinae</placeName> antistiti vigilantissimo,
					<lb xml:id="p4z6"/>patri suo in Christo colendissimo.
					<lb xml:id="p4z7"/>
					<lb xml:id="p4z8"/>Zürich.
				</p>
