	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Non possum mihi temperare, <persName ref="p495">Bullingere</persName> optime, quin ea tibi scribam, <lb xml:id="p1z2"/>quę nuper nobis maximam attulerunt voluptatem, ut tu cum tuis <lb xml:id="p1z3"/>symmystis parte aliqua fruaris.</s>
					<s n="2" xml:lang="la">Habita est <placeName ref="l296">Londini</placeName> decimo nono <lb xml:id="p1z4"/>calendas Ianuarii, ni fallor, disputatio <foreign xml:lang="el">[griechisch]</foreign> in consessu <lb xml:id="p1z5"/>omnium pene procerum totius <placeName ref="l830">Angliae</placeName>.</s>
					<s n="3" xml:lang="la">Decertatum est acriter inter <lb xml:id="p1z6"/>episcopos.</s>
					<s n="4" xml:lang="la"><placeName ref="l1255">Cantuariensis</placeName> pręter omnium exspectationem sententiam <lb xml:id="p1z7"/>vestram de hoc negocio apertissime, constantissime doctissimeque <lb xml:id="p1z8"/>defendit.</s>
					<s n="5" xml:lang="la">Haec fuerunt illius argumenta: <foreign xml:lang="el">[griech<lb xml:id="p1z9"/>isc<lb xml:id="p1z10"/>h]</foreign> etc.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Sequutus est deinceps <placeName ref="l1653">Roffensis</placeName>, qui tanta eloquentia, perspicuitate, <lb xml:id="p1z12"/>eruditione atque argumentorum <foreign xml:lang="el">[griechisch]</foreign> hanc rem tractavit, ut <lb xml:id="p1z13"/>acerrimo papistae <placeName ref="l567">Wigorniensios</placeName> obturaverit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Nunquam splendidiorem <lb xml:id="p1z14"/>victoriam veritas apud nos reportavit.</s>
					<s n="8" xml:lang="la">Video plane actum de <lb xml:id="p1z15"/>Lutheranismo, cum, qui prius habiti sunt summi ac pene soli illius <lb xml:id="p1z16"/>fautores, nostri toti facti sint.</s>
					<s n="9" xml:lang="la">Multum debemus domino, qui hac <lb xml:id="p1z17"/>quoque in parte nobis consultum vult.</s>
					<s n="10" xml:lang="la">Nolui te fraudare, vir <lb xml:id="p1z18"/>charissime, tanta voluptate, qua deum precor ut diu [fr]uaris.</s>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p1z19"/>D. <persName ref="p8171">Bibliandrum</persName> et caeteros charissimos fratres salutabis accurate; <lb xml:id="p1z20"/>uxori tuae et liberis omnibus opto salutem ex animo.</s>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z21"/>Vale.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l376">Chaoniae</placeName><note type="misc"><placeName ref="l376">Oxoniae</placeName>?</note> pridie calendas Ianuar<lb xml:id="p1z22"/>ias.</s>
					<s n="14" xml:lang="la"><persName ref="p8107">Barthol[o<lb xml:id="p1z23"/>maeus] Traheron</persName>.</s>
				</p>
				<p>
					<note type="PS">[P.S.:]</note>
					<s n="15" xml:lang="la"><lb xml:id="p1z24"/>Ecce, cum suas esset traditurus <lb xml:id="p1z25"/>literas D. <persName ref="p8107">Trehernius</persName>, forte fortuna <lb xml:id="p1z26"/>adveni.</s>
					<s n="16" xml:lang="la">Facere non potui, quin <lb xml:id="p1z27"/>et tibi salutatiunculam scriberem; <lb xml:id="p1z28"/>plura enim prae festinatione nimia <lb xml:id="p1z29"/>tabellarii scribere non possum.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z30"/>Propediem de omnibus rebus certior <lb xml:id="p1z31"/>ut fias, faciam.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z32"/>Raptim.</s>
					<s n="19" xml:lang="la"><placeName ref="l296">Lo<lb xml:id="p1z33"/>ndini</placeName> mira fit stultorum episcoporum <lb xml:id="p1z34"/>recantatio.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z35"/><persName ref="p20172">Ioannes ab Ulm[is</persName>]</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro D. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, ami<lb xml:id="p2z3"/>corum summo.</s>
					<s n="22" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
