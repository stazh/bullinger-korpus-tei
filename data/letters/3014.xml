	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/><placeName ref="l558">Wittenbergae</placeName>.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Obsignatis meis, quas ad te dedi, literis hic honestus <lb xml:id="p1z3"/>iuvenis <persName>Albertus Brinck</persName>, natione <placeName>Gellrus</placeName>, se m. <persName ref="p4554">Ro<lb xml:id="p1z4"/>dolpho Collino</persName> comitem itineris futurum mihi significavit <lb xml:id="p1z5"/>ac obnixe rogavit, ut illum tibi commendarem, quod libenter <lb xml:id="p1z6"/>feci, non tam propter eruditionem quam etiam <lb xml:id="p1z7"/>vitae integritatem.</s>
					<s n="3" xml:lang="la">Ille enim amans Christi et <lb xml:id="p1z8"/>synceram ac puram evangelii doctrinam praeferens <lb xml:id="p1z9"/>impuris papistarum dogmatibus ac posthabitis parentibus, <lb xml:id="p1z10"/>cognatis, amicis patriaque <placeName>Gellriam</placeName> ipsam reliquit <lb xml:id="p1z11"/>ac <placeName ref="l558">Wittenbergam</placeName> se contulit ibique pie et hones<lb xml:id="p1z12"/>tae vivens summa diligentia in literarum studio versatus <lb xml:id="p1z13"/>per dimidum annum.</s>
					<s n="4" xml:lang="la">Iam vero, quia fortassis <placeName ref="l862">Helveticae</placeName> <lb xml:id="p1z14"/>ecclesiae magis illi quam <placeName ref="l749">Saxonicae</placeName> placent, hinc <lb xml:id="p1z15"/>in <placeName ref="l862">Helvetiam</placeName> statuit proficisci.</s>
					<s n="5" xml:lang="la">Ipsum ergo, iuvenem honestum, <lb xml:id="p1z16"/>pium et doctum commendo tuae humanitati rogoque<lb xml:id="p1z17"/>, <lb xml:id="p1z18"/>ut illum in omnibus, quibus potes, iuvare velis.</s>
					<s n="6" xml:lang="la">Si vero illi ea <lb xml:id="p1z19"/>in re, quam petit apud vos, prodesse non poteris propter <lb xml:id="p1z20"/>multitudinem studiososrum, quos alitis, tamen <placeName ref="l28">Basileae</placeName> aut alibi <lb xml:id="p1z21"/>apud doctos viros illum testimonio tuo aut aliqua commendatio<lb xml:id="p1z22"/>ne iuvato.</s>
					<s n="7" xml:lang="la">Haec brevibus ad te scribere volui <lb xml:id="p1z23"/>propter familiaritatem et amicitiam, quae inter nos fuit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z24"/>Vale nunc in perpetuum, dilectissime pater.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z25"/><persName ref="p495">Heinrychus Bullingerus</persName>, <lb xml:id="p1z26"/>filius tuus dilectus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximio et praestanti viro <lb xml:id="p2z2"/>domino <persName ref="p495">Heinrycho Bul<lb xml:id="p2z3"/>lingero</persName>, antistiti <lb xml:id="p2z4"/>ecclesiae in urbe <lb xml:id="p2z5"/><placeName ref="l587">Tiguro</placeName>, <lb xml:id="p2z6"/>patri suo dilecto.</s>
					<s n="11" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zürych</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
