	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Ornatissime vir, accepi iamdudum literas praestantiae tuae 3. aprilis scriptas nec <lb xml:id="p1z2"/>quod ad e m prius scriberem, hactenus habui.</s>
					<s n="2" xml:lang="la">Extremis postea praestantiae tuae <lb xml:id="p1z3"/>literis ad <persName ref="p8009">Fabritium</persName> <persName ref="p8359">Gallitiumque</persName> datis ascriptae mihi salutis rerumque in <lb xml:id="p1z4"/>eis narratarum periucunda mihi fuit lectio.</s>
					<s n="3" xml:lang="la">Nunc, quod tuo scitu dignum <lb xml:id="p1z5"/>arbitrer, hoc occurrit: die 6. februarii resutam pacem inter <persName ref="p18593">Turcam</persName> <lb xml:id="p1z6"/>et imperatorem <persName ref="p18477">Ferdinandum</persName> conciliante maxime rege nostro; solvet <lb xml:id="p1z7"/><persName ref="p18477">Ferdinandus</persName> annua 30 m olim pacta pro eo, quod <placeName ref="l2721">Pannoniae</placeName> possidet, <lb xml:id="p1z8"/>et quaedam aulae dona vel portae, ut vocant ipsi, castrumque a <placeName ref="l2510">Turcis</placeName> <lb xml:id="p1z9"/>captum ipsis remanebit, non tamen gratuitum; cum enim deberet <lb xml:id="p1z10"/><persName ref="p18477">Ferdinandus</persName> quinquennii tributum, duas ex eo partes infra tres menses <lb xml:id="p1z11"/>solvet, reliquum ei pro castro acceptum referetur.</s>
					<s n="4" xml:lang="la">Amicos hostesque <lb xml:id="p1z12"/>alterius <persName ref="p18477">Ferdinandus</persName> pro amicis hostibusque habebit; <placeName ref="l2721">Pannonia</placeName> autem <lb xml:id="p1z13"/>regnum in tria distributum apertis limitibus disterminabitur, ut omnis <lb xml:id="p1z14"/>belli tollatur occasio et regulo <placeName ref="l869">Transylvaniae</placeName> suum maneat inoffensum.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>De pace autem inter maximos christianorum reges, quod nec praestantia tua potest <lb xml:id="p1z16"/>ignorare, certus fere rumor affertur et res in portu esse videtur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z17"/>Papa crysipelate in crure laborat, quod lethale arbitrantur, non <lb xml:id="p1z18"/>tamen offensiones contra suos deponit nec aliquid de inventione <lb xml:id="p1z19"/>curarum remittit edixitque, ut ad sextum aprilis omnes episcopi suis <lb xml:id="p1z20"/>in sedibus reperiantur eo perpetuo commoraturi, nisi pernecessaria <lb xml:id="p1z21"/>causa bimestrem absentiam concesserit, idque sub gravissimis poenis.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z22"/>Addunt nonnulli et papae senectuti hydropisim.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Praestantia tua interim bene <lb xml:id="p1z23"/>valebit, cui ex animo bona omnia opto.</s>
					<s n="9" xml:lang="la">Ex <placeName ref="l98">Curia Rhetorum</placeName> 30. martii 1559.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">P<lb xml:id="p1z24"/>raestantiae tuae <lb xml:id="p1z25"/>obsequentissimus amicus <persName ref="p8306">Io[a<lb xml:id="p1z26"/>nnes] Ia[cobus] Decambray</persName>.</s>
				</p>
				<p>
					<note>[vor 538:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro domino <persName ref="p495">Henrico <lb xml:id="p4z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p4z4"/>ministro dignissimo.</s>
					<s n="12" xml:lang="la"><placeName ref="l587">Ti<lb xml:id="p4z5"/>guri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
