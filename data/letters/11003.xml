	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Visum est, honorande <persName ref="p495">Bullingere</persName>, optimatibus <lb xml:id="p1z2"/>nostris, ut responsum<note xml:id="fn1" type="footnote" n="1">Nämlich die Antwort auf <persName ref="p495">Bullingers</persName> Anfrage vom 2. Februar (oben <ref target="file10983">Nr. 941</ref>; vgl. auch oben <ref target="file10994">Nr. 952</ref> und unten <ref target="file11008">Nr. 966</ref>).</note>, quod ex me expectari debebat, <lb xml:id="p1z3"/>ad senatum devolveretur, quo minus, qui bene volu<lb xml:id="p1z4"/>nt reipublicę nostrę, amici <placeName ref="l587">Tiguricenses</placeName> dubitarent, <lb xml:id="p1z5"/>quam alienum sit a salute civitatis huius denuo cum <lb xml:id="p1z6"/>istis heroibus commisceri.</s>
					<s n="3" xml:lang="la">Esse enim in foribus<note xml:id="fn2" type="footnote" n="2"><bibl source="b56">Adagia</bibl>, 2, 2, 85 (<bibl source="b370">LB</bibl> II 478).</note>, ut <lb xml:id="p1z7"/>iam inde misertus dominus afflictionum nostrarum <lb xml:id="p1z8"/>suo consilio pacem nobis restituat, valde confidimus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Is autem scorpionem pro pisce non dabit<note xml:id="fn3" type="footnote" n="3">Vgl. <cit type="bible"><ref>Lk 11, 11f</ref></cit>.</note> aut pacem, <lb xml:id="p1z10"/>vere pax quae non sit.</s>
					<s n="5" xml:lang="la">Scis enim fidelem deum, <lb xml:id="p1z11"/>cuius<pb type="edition" next="86"/> providentia id factum esse intelligimus, <lb xml:id="p1z12"/>ut cum ipsa persuasę relligionis <foreign xml:lang="el">ἐθελοθρη<lb xml:id="p1z13"/>σκείᾳ</foreign><note xml:id="fn4" type="footnote" n="4">Vgl. <cit type="bible"><ref>Kol 2, 23</ref></cit>.</note> eius vitii artifices urbe excederent.</s>
					<s n="6" xml:lang="la">Petulantiam <lb xml:id="p1z14"/>illorum aegre perferimus, quid tamen?</s>
					<s n="7" xml:lang="la">Levius est ab <lb xml:id="p1z15"/>externis vexari quam a domesticis.</s>
					<s n="8" xml:lang="la">Praestat civili <lb xml:id="p1z16"/>concordia gaudere et pietatem colere potius quam <lb xml:id="p1z17"/>periculo se exponere intestino ob alienorum astutiam <lb xml:id="p1z18"/>falsis pollicitationibus exornatam.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>Annos ab hinc <lb xml:id="p1z21"/>non minus decem ut Ulisses ille fabulosus laborem <lb xml:id="p1z22"/>de ventis et fluctibus exantlavimus, ita tamen, ut <lb xml:id="p1z23"/>nostram Ithacam nobis iam apparere gaudeamus.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z24"/>Quod si cum procis decertandum adhuc fuerit, optandum <lb xml:id="p1z25"/>tamen, ne in his tectis et quam potest remota <lb xml:id="p1z26"/>ab illis Penelope<note xml:id="fn5" type="footnote" n="5">Die Heimkehr des Odysseus nach Ithaka und sein Kampf mit den Freiern Penelopes ist Inhalt der zweiten Hälfte von <persName ref="p18514">Homers</persName> "Odyssee".</note>.</s>
					<s n="11" xml:lang="la">Sin quis contendat non patriam <lb xml:id="p1z27"/>nos hactenus reperisse, sed fugisse potius ut ducem <lb xml:id="p1z29"/>Vergilianum<note xml:id="fn6" type="footnote" n="6">Gemeint ist <persName ref="p20035">Aeneas</persName>.</note>, ecce tamen hic<note xml:id="fna" type="footnote" n="a">hic <hi>über der Zeile nachgetragen.</hi></note> <placeName ref="l2219">Troiam</placeName> novam et Simoenta<note xml:id="fn7" type="footnote" n="7">Fluß in der Gegend von <placeName ref="l2219">Troia</placeName>; vgl. Ludwig <hi>Bürchner,</hi> in: <bibl source="b479">Pauly/Wissowa</bibl> III A 160f.</note> <lb xml:id="p1z30"/>novum<note xml:id="fn8" type="footnote" n="8">Vgl. <persName ref="p18867">Vergil</persName>, Aeneis 3, 302.</note>, ad quem appulimus, ut nec <placeName ref="l2219">Troianis</placeName> ad <lb xml:id="p1z31"/>abolitam urbem nec <placeName ref="l2531">Gręcis</placeName> ad confectum negocium <lb xml:id="p1z32"/>postliminio sit remigrandum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z33"/>Utinam tamen <lb xml:id="p1z34"/><placeName ref="l862">Helvetia</placeName>, cui toties et tam amice ob oculos po<lb xml:id="p1z35"/>suimus difficultatem navigationis nostrę, fluctibus <lb xml:id="p1z36"/>istis aliquando, quod possunt, imperitaret<note xml:id="fnb" type="footnote" n="b"><hi>Dieses und die beiden folgenden Verben von Plural in Singular korrigiert.</hi></note> et <lb xml:id="p1z37"/>ventos folle cohiberet aut increparet saltem <lb xml:id="p1z38"/>ministros Aeoli collectasque fugans nubes solemque <lb xml:id="p1z39"/>reducens his aut talibus verbis<note xml:id="fn9" type="footnote" n="9"><persName ref="p18867">Vergil</persName>, Aeneis 1, 132-141.</note>:</s>
				</p>
				<p>
					<s n="13" xml:lang="la">"<lb xml:id="p1z40"/>Tantane vos generis tenuit fiducia vestri;<pb type="scan" next="||25"/> <pb/><lb xml:id="p2z1"/>iam cęlum terramque meo sine numine, venti, <lb xml:id="p2z2"/>miscere et tantas audetis tollere moles<note xml:id="fnc" type="footnote" n="c"><hi>vor</hi> moles <hi>gestrichenes</hi> nubes.</note>?</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z3"/>Quos ego...!</s>
					<s n="15" xml:lang="la">Sed motos pręstat componere fluctus; <lb xml:id="p2z4"/>post mihi non simili poena commissa luetis.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z5"/>Maturate fugam regique haec dicite vestro: <lb xml:id="p2z6"/>Non illi imperium pelagi sęvumque tridentem, <lb xml:id="p2z7"/>sed mihi sorte datum; tenet ille immania saxa, <lb xml:id="p2z8"/>vestras, Eure, domos; illa se iactet in aula <lb xml:id="p2z9"/>Aeolus et clauso ventorum carcere regnet" etc.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z10"/>Est autem in primis cavendum, <persName ref="p495">Bullingere</persName>, ne cui <lb xml:id="p2z11"/>per<lb xml:id="p2z12"/>suadeant hęc flamina<note xml:id="fnd" type="footnote" n="d"><hi>vor</hi> flamina <hi>gestrichenes</hi> flamina se.</note><note xml:id="fn10" type="footnote" n="10">Wortspiel mit flamina (Winde) und flamines (Priester).</note> posse<note xml:id="fne" type="footnote" n="e">posse <hi>über der Zeile nachgetragen.</hi></note> se cum nostro <lb xml:id="p2z13"/>commodo scindi<note xml:id="fn11" type="footnote" n="11">Vgl. oben <ref target="file10983">Nr. 941</ref>, 25f.</note>, si pars recipiatur.</s>
					<s n="18" xml:lang="la">Hac enim simul<lb xml:id="p2z14"/>atione res maximas saepe obtinuerunt, et inventus <lb xml:id="p2z15"/>est tertius semper, cuius exitio illi redirent <lb xml:id="p2z16"/>in gratiam.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb type="edition" next="87"/>Superiorum a<lb xml:id="p2z17"/>nnorum <lb xml:id="p2z18"/>res gestas ad te dabimus<note xml:id="fn12" type="footnote" n="12">Ein entsprechender Bericht ist nicht bekannt.</note>, ex quibus intelliges, <lb xml:id="p2z19"/>quo plebis scito interposito illorum reditus ad nos <lb xml:id="p2z20"/>prohibeatur<note xml:id="fn13" type="footnote" n="13">Der Rat kämpfte seit dem freiwilligen Auszug des Domkapitels (1527) entschlossen gegen dessen Rückkehr; vgl. <hi>Moeller,</hi> Zwick 1421.</note>, ne quis porro de ea re dubitare queat.</s>
					<s n="20" xml:lang="la" ana="salute"><lb xml:id="p2z21"/>Quare quam potes modestissime nostros excusa <lb xml:id="p2z22"/>et saluta meis verbis gravissimum virum <persName ref="p2816">Dithelmum <lb xml:id="p2z23"/>Röstum</persName><note xml:id="fn14" type="footnote" n="14">Bürgermeister <persName ref="p2816">Diethelm Röist</persName>.</note> aliosque bonos.</s>
					<s n="21" xml:lang="la"><persName ref="p8171">Theodoro</persName><note xml:id="fn15" type="footnote" n="15"><persName ref="p8171">Theodor Bibliander</persName>.</note> ne nunc quidem <lb xml:id="p2z24"/>scribere potui, scribam tamen per ocium.</s>
					<s n="22" xml:lang="la">Dominum <lb xml:id="p2z25"/>ora, ut rem publicam nostram conservet et augeat in re<lb xml:id="p2z26"/>gni sui honestamentum.</s>
					<s n="23" xml:lang="la">Et poetari me in re tanta <lb xml:id="p2z27"/>boni et equi consulito.</s>
				</p>
				<p>
					<s n="24" xml:lang="la" ana="farewell">Vale in servatore nostro <lb xml:id="p2z28"/>cum vestris omnibus, ornatissime <persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Constantię, <lb xml:id="p2z29"/>7. martii 1537.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p2z30"/><persName ref="p8178">Th. Blaurerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse vor S. 17 (neu: 29v.):]</note>
					<s n="27" xml:lang="la"><pb/><lb xml:id="p3z1"/>Domino <persName ref="p495">Henricho Bul<lb xml:id="p3z2"/>lingero</persName>, pręconi eva<lb xml:id="p3z3"/>ngelicae veritatis, <lb xml:id="p3z4"/>amico suo venerando <lb xml:id="p3z5"/>apud <placeName ref="l587">Tigurum</placeName>.</s>
					<s n="28" xml:lang="de"><lb xml:id="p3z6"/><placeName ref="l587">Zurch</placeName>.</s>
				</p>
			</div>
		</body>
