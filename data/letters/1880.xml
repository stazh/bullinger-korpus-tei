	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Pro singulari vestra erga me humanitate et benevolentia, qua me <lb xml:id="p1z3"/>nuper indignum cum domino <persName ref="p8073">Gilberto Cognato</persName>, viro doctissimo, <lb xml:id="p1z4"/>obruistis, vir omnium clarissime, gratias merito ingentes ago darique <lb xml:id="p1z5"/>occasionem aliquando cupio, qua grati animi significationem intelligatis.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z6"/>Peciisti autem, ut ad te mitterem, quae de tragedia in <lb xml:id="p1z7"/><placeName>Brussia</placeName> per <persName ref="p2301">Osiandrum</persName> concitata haberemus, cuius tamen rei certa <lb xml:id="p1z8"/>fama ad nos nondum perlata est, cum omnium literis in hac re non <lb xml:id="p1z9"/>sit fidendum.</s>
					<s n="3" xml:lang="la">Accepimus tamen ex <persName>Petri Artopaei</persName> literis, quae <lb xml:id="p1z10"/><persName>Stetini</persName> calendis martiis ad nos scripta sunt, quomodo de <lb xml:id="p1z11"/>vera hominis iustificatione negotium per principem Prussiae Albertum, <lb xml:id="p1z12"/>marchionem seniorem, sit transactum, qui collectis omnium evangelicoru<lb xml:id="p1z13"/>m doctorum iudiciis, inter quae d. <persName ref="p458">Ioannis Brencii</persName> et suorum <lb xml:id="p1z14"/>coniunctorum concionatorum iudicium visum est aequissimum et veritati <lb xml:id="p1z15"/>evangelicae magis consentaneum, nempe quod Christus ipse <lb xml:id="p1z16"/>secundum suam divinam et humanam naturam seu essentiam sit nostra <lb xml:id="p1z17"/>iustitia aeterna et essentialis; eius merita autem <lb xml:id="p1z18"/>esse instrumenta nostrae iustificationis et quoque nominari <lb xml:id="p1z19"/>iustitiam nostram: eam fide apprehendendam esse ideoque nos <lb xml:id="p1z20"/>reputari iustos et operari in nobis veros fructus iustitiae, <lb xml:id="p1z21"/>donum spiritus sancti cum omnibus suis donis remissionem <lb xml:id="p1z22"/>peccatorum, opera obedientiae et charitatis.</s>
					<s n="4" xml:lang="la">Cui <lb xml:id="p1z23"/>opinioni cum subscripsisset <persName ref="p2301">Osiander</persName> ceteros omnes princeps <lb xml:id="p1z24"/>repudiavit et serio mandato prohibuit, ne quisquam post<lb xml:id="p1z25"/>hac in ea causa disputaret apud suos etc.</s>
					<s n="5" xml:lang="la">Mitto autem <lb xml:id="p1z26"/>tibi responsionem ministrorum ecclesiae Christi, quae est <placeName ref="l204">Ham<lb xml:id="p1z27"/>burgi</placeName> et <placeName ref="l1750">Luneburgi</placeName> ad eandem disputationem in februario <lb xml:id="p1z28"/>missa.</s>
					<s n="6" xml:lang="la">Verum totum eius negocii rationem copiose de<lb xml:id="p1z29"/>scriptam habet <persName ref="p3099">Sulzerus</persName> noster typis evulgatam, a quo <lb xml:id="p1z30"/>si pecieris, nequaquam ad tempus denegabit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Vale cum uxore <lb xml:id="p1z31"/>et tota familia felicissime.</s>
					<s n="8" xml:lang="la" ana="salute">Resalutant te dominus <persName ref="p8054">Marcus <lb xml:id="p1z32"/>Bersius</persName> et <persName ref="p8126">Oporinus</persName> noster officiosissime.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l28">Basileae</placeName> <lb xml:id="p1z33"/>30. maii anno 1553.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z34"/>T[uus] <persName ref="p8406">Lycos<lb xml:id="p1z35"/>thenes</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>pastori fidelissimo <lb xml:id="p2z4"/>atque amico incomparabili.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tigurum</placeName><lb xml:id="p2z6"/>.</s>
				</p>
