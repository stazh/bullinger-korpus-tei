	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Erwirdig, hoch unnd wolgelert, ersam gnädig ouch günstg
					<lb xml:id="p1z2"/>lieb herren, uwer erwird und gunst syen unnserm
					<lb xml:id="p1z3"/>ereg guͦtwillig diennst nederzit mit flyß
					<lb xml:id="p1z4"/>gnädig, günstig, lieb herrenn
					<lb xml:id="p1z5"/>raich zuvor.
					<lb xml:id="p1z6"/>nach dem bi w.k. und gingst wir von wägen unnd
					<lb xml:id="p1z7"/>er gfarr unnd predigatur, die dann jetzo ai guͦt
					<lb xml:id="p1z8"/>zuflanng vaciert und ledig gwässen ist) erntas
					<lb xml:id="p1z9"/>für zuͦbruwen unnd zuͦwarben. Derwägen
					<lb xml:id="p1z10"/>haben mir jeogter buchman unnsern nitburger zaig,
					<lb xml:id="p1z11"/>die mit mundtlichem befälch abgeferttiget. wir
					<lb xml:id="p1z12"/>ernd das von im vernemen wirt, unnder
					<lb xml:id="p1z13"/>thenig unnd flyssig pittende. die atellen im in
					<lb xml:id="p1z14"/>siner warbung von unnsers wägen günstig andrenn
					<lb xml:id="p1z15"/>unnd glouben gäben, ouch sich daruf zu günstiger
					<lb xml:id="p1z16"/>betrachtung dises nochwenndigen christenlichen
					<lb xml:id="p1z17"/>unnd von unns lanngbegärten wärtts also gnädig
					<lb xml:id="p1z18"/>günstig und willfarin erzaigen und bemeysten wie
					<lb xml:id="p1z19"/>unnser sonnder underthenig nechgruwen zu ir staat
					<lb xml:id="p1z20"/>das begaren gegen v. f. unnd sunst mir samert
					<lb xml:id="p1z21"/>und sonnderlich zusammt, dem das dieran alin gad
					<lb xml:id="p1z22"/>gehelligs warc erstadet wiitt) unnderthenig und
					<lb xml:id="p1z23"/>Darum ghyn den
					<lb xml:id="p1z24"/>Ggutwillig zuwer diennen
					<lb xml:id="p1z25"/>istem jenner anno etc. 5569.
					<lb xml:id="p1z26"/>M.
					<lb xml:id="p1z27"/>und gunst
					<lb xml:id="p1z28"/>thunderthenngs und
					<lb xml:id="p1z29"/>untwulligen
					<lb xml:id="p1z30"/>Elergumnichs rog zu fig.
					<lb xml:id="p1z31"/>Grorg verladf.
					<lb xml:id="p1z32"/>Dues purgermeister and ain
					<lb xml:id="p1z33"/>ganngze gmannd zuͦ Rehyn
					<lb xml:id="p1z34"/>.
					<pb/>
					<lb xml:id="p3z1"/>1309.
					<pb/>
					<lb xml:id="p4z1"/>Dnn erwirdigen, hoch und wolgelertenn
					<lb xml:id="p4z2"/>irsdane herren. dem brocht uug cappidel
					<lb xml:id="p4z3"/>der stifft sanct Helve uns regula zuͦ Züri,
					<lb xml:id="p4z4"/>ich unnsertn gnarigen gunstigen, liebenn
					<lb xml:id="p4z5"/>herrenn.
					<lb xml:id="p4z6"/>
					<lb xml:id="p4z7"/>m
					<lb xml:id="p4z8"/>H..
					<lb xml:id="p4z9"/>
					<lb xml:id="p4z10"/>
					<lb xml:id="p4z11"/>.
				</p>
