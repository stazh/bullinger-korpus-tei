	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus et pax Christi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Cessarunt febres, sed remansit summa totius <lb xml:id="p1z3"/>corporis imbecillitas, cui putant quidam <lb xml:id="p1z4"/>non nisi balneo aut alia quiete medendum<note xml:id="fn1" type="footnote" n="1">Zur Erkrankung <persName ref="p4079">Zwicks</persName> vgl. auch unten <ref target="file11440">Nr. 1397</ref>, 18-20.</note>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Quid autem futurum sit, nescio.</s>
					<s n="4" xml:lang="la">Praestaret <lb xml:id="p1z6"/>dissolvi et esse cum Christo<note xml:id="fn2" type="footnote" n="2">Vgl. <cit type="bible"><ref>Phil 1, 23</ref></cit>.</note>; sed fiet istud <lb xml:id="p1z7"/>quoque hora statuta.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>De actione <placeName ref="l1202">Schmalkaldica</placeName> scribit ad te <persName ref="p8055">Am<lb xml:id="p1z9"/>brosius</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p8055">Ambrosius Blarer</persName>; s. oben <ref target="file11438">Nr. 1395</ref>, 1-17.</note> et mittit, quae dederunt principes <lb xml:id="p1z10"/>et ministri verbi, plana certe et plausibilia; <lb xml:id="p1z11"/>tantum ora deum,<pb type="edition" next="114"/> ne sint verba.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Sed iam dies condictus est <placeName ref="l471">Spiram</placeName><note xml:id="fn4" type="footnote" n="4">Vgl. ebd., Z. 18-21.</note> ad sextum <lb xml:id="p1z13"/>iunii, ubi rex <persName ref="p18477">Ferdinandus</persName> fratris <persName ref="p18538">Caroli</persName><note xml:id="fn5" type="footnote" n="5">Kaiser <persName ref="p18538">Karl V.</persName></note> <lb xml:id="p1z14"/>nomine adhuc semel tentabit, quae pacis <lb xml:id="p1z15"/>sunt.</s>
					<s n="7" xml:lang="de" ana="farewell">Da würt man uns vilicht das <lb xml:id="p1z16"/>valete geben<note xml:id="fn6" type="footnote" n="6">Zur Redenart vgl. <bibl source="b260">Grimm</bibl> XII/I 9.</note>; <foreign xml:lang="la">sed fiat voluntas domini.</foreign></s>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Quae mittimus, etiam <persName ref="p8127">Pellicano</persName> da legenda.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/>Sed rogo, induite amicum animum erga <lb xml:id="p1z19"/><placeName ref="l491">Argentoratenses</placeName><note xml:id="fn7" type="footnote" n="7">Vgl. oben Nr. 1395, 26-44.</note>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale, mi frater, et commenda <lb xml:id="p1z20"/>nos domino.</s>
					<s n="11" xml:lang="la" ana="salute">Uxorem<note xml:id="fn8" type="footnote" ana="bio" n="8"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> tuam et <lb xml:id="p1z21"/>matrem<note xml:id="fn9" type="footnote" ana="bio" n="9"><persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note> et liberos<note xml:id="fn10" type="footnote" n="10">Siehe oben <ref target="file11387">Nr. 1344</ref>, Anm. 14.</note> saluta studiosissime.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/>Ex <placeName ref="l257">Constantia</placeName>, 17. maii 1540.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z23"/>Tuus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Hainricho <lb xml:id="p2z2"/>Bullingero</persName> <placeName ref="l587">Tigurino</placeName>, <lb xml:id="p2z3"/>fratri suo <lb xml:id="p2z4"/>colendo.</s>
				</p>
