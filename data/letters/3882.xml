	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Honorande domine, facit hoc tua humanitas <lb xml:id="p1z2"/>omnibus fere nota mihi vero etiam experta, ut te rurs<lb xml:id="p1z3"/>um <lb xml:id="p1z4"/>in piorum quorundam hominum et ornatissimorum causa inte<lb xml:id="p1z5"/>rpellare audeam eaque non levi, utpote conscientiam attingente, <lb xml:id="p1z6"/>quę ut est in optimis quoque tenerrima et offensioni imprimis <lb xml:id="p1z7"/>obnoxia, tamquam maxime ex divino potissimum verbo temperat<lb xml:id="p1z8"/>o pharmaco et a docto viro ac huiusmodi morborum <lb xml:id="p1z9"/>curandorum perito subministrato opus habet.</s>
					<s n="3" xml:lang="la">Cum <lb xml:id="p1z10"/>autem ad levationem et curationem morbi imprimis faciat <lb xml:id="p1z11"/>fiducia medici, plurimum certe in hoc negocio <lb xml:id="p1z12"/>id tua efficere et pręstare poterit, cum hi omnes, quorum <lb xml:id="p1z13"/>res agitur, tum ob singularis humanitatis opinionem multorum <lb xml:id="p1z14"/>relatione conceptam tum ob exim<lb xml:id="p1z15"/>iam conditionem et sacrarum literarum peritiam ex <lb xml:id="p1z16"/>librorum tuorum lectione perspectam in tuo consilio atque <lb xml:id="p1z17"/>ope summam spem repositam habeant.</s>
					<s n="4" xml:lang="la">Quę spes ne eos <lb xml:id="p1z18"/>fallat, orarem te, nisi tuum istud de omnibus benemerendi <lb xml:id="p1z19"/>divinitus insitum studium probe nossem.</s>
					<s n="5" xml:lang="la">Negocium <lb xml:id="p1z20"/>omne ex literis hisce adiunctis cognosces, quas vir quidam <lb xml:id="p1z21"/>pius et nobilis tuique nominis studiosus ad te scribit, qui amici <lb xml:id="p1z22"/>sibi coniunctissimi causam commendandam suscepit; nam <lb xml:id="p1z23"/>is, cuius res agitur, certis et gravibus de causis ignorari cupit.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z24"/>Ubi tuae humanitati per oportunitatem <lb xml:id="p1z25"/>et ocium consilii sui rationem conscribere et ad nos transmittere <lb xml:id="p1z26"/>visum fuerit, scriptum diligenter obsignatum mittes ad <lb xml:id="p1z27"/>officinam Pinguis gallinae <placeName ref="l267">Coloniae</placeName> cum inscriptione <lb xml:id="p1z28"/>ad <persName ref="p4310">Arnoldum Birckmannum</persName> bibliopolam vel eius fratrem <lb xml:id="p1z29"/><persName ref="p380">Ioannem</persName> vel his absentibus ad eum, qui officinę pręest; <lb xml:id="p1z30"/>in altera vero pagina interiore huius chartae tribus verbis <lb xml:id="p1z31"/>scribas, ut scriptum hoc tradant d. <persName ref="p8152">Adolpho Baers</persName> aut, si <lb xml:id="p1z32"/>is longius absit, <persName ref="p581">Georgio Cassandro</persName> ad illum transmittendas.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z33"/>Hec ad te amici bene de me meriti gratia scripsi manu <lb xml:id="p1z34"/>titubante iam octo fere mensium aegritudine afflictus <lb xml:id="p1z35"/>et pene consumptus.</s>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z36"/>Vale, observande domine, et nos <lb xml:id="p1z37"/>tuis et ecclesiae tuae precibus adiuvare ne dedigneris.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z38"/><placeName ref="l125">Duisburgi</placeName> <placeName ref="l1049">Clivorum</placeName> 5. nonas martii 1559.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z39"/>Tui observantissimus <lb xml:id="p1z40"/><persName ref="p581">G[<pb/><lb xml:id="p2z1"/>eorgius] Cassander</persName>.</s>
					<s n="11" xml:lang="la">Venerando domino et s[acrarum<lb xml:id="p2z2"/>] literarum peritissimo... <lb xml:id="p2z3"/>d. <persName ref="p495">Heinrico Bullinge[ro</persName>...<lb xml:id="p2z4"/>] divini verbi ministro [dili]<lb xml:id="p2z5"/>gentissimo.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName> ad ma[nus] <lb xml:id="p2z7"/>proprias.</s>
				</p>
