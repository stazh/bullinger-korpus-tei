	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, clarissime vir <persName ref="p495">H[enrice] Bulli[n]g[ere]</persName>.</s>
					<s n="2" xml:lang="la">Mitto peculia<lb xml:id="p1z2"/>rem nuncium istuc, quaesitum scilicet, <lb xml:id="p1z3"/>ubi gentium d. <persName ref="p20206">Gribaldus</persName> degat, et <lb xml:id="p1z4"/>scribo <persName ref="p8101">Lelio</persName>, ut alium mittat ulterius.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Mirum, ubi tandiu haereat.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Haec itaque est occasio meae scriptionis <lb xml:id="p1z7"/>nunc.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Pulchre valeo; absolvi <lb xml:id="p1z8"/><persName>Sclavica</persName>.</s>
					<s n="6" xml:lang="la">Ad aulam redii, sed mox <lb xml:id="p1z9"/>ad typographiam rediturus.</s>
					<s n="7" xml:lang="la">Verti enim <lb xml:id="p1z10"/>librum d. <persName ref="p458">Brentii</persName>, et mandata prin<lb xml:id="p1z11"/>cipis incipiet ingemiscere sub praelo <lb xml:id="p1z12"/>intra 15 dies.</s>
					<s n="8" xml:lang="la">Mihi valde acer vi<lb xml:id="p1z13"/>detur; sed mitigavi ego multo ver<lb xml:id="p1z14"/>tendo (si credere dignum est), vere <lb xml:id="p1z15"/>oleum addidi camino.</s>
					<s n="9" xml:lang="la">Factus est <lb xml:id="p1z16"/>comitiorum recessus atque alia in<lb xml:id="p1z17"/>dicta ad kalendas martias <placeName ref="l410">Ratisponae</placeName>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Uti possidetis, ita possideatis, hoc in <lb xml:id="p1z19"/>summa pepererunt nobis, quod <lb xml:id="p1z20"/>semper speravi et scrispi.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><persName>Caesar</persName> in <placeName ref="l875">His<lb xml:id="p1z21"/>paniam</placeName> cogitur proficisci; eat in <lb xml:id="p1z22"/>bonam rem.</s>
					<s n="12" xml:lang="la">Noster <persName ref="p8041">Lascus</persName> valde <lb xml:id="p1z23"/>sollicitus est de sarci<lb xml:id="p1z24"/>enda concordi<lb xml:id="p1z25"/>a <pb/><lb xml:id="p2z1"/>in articulo eucharistiae; nullum non mo<lb xml:id="p2z2"/>vet lapidem; ad me nuperrime dili<lb xml:id="p2z3"/>genter scripsit.</s>
					<s n="13" xml:lang="la">Sed nihil proficiet, <lb xml:id="p2z4"/>quod non sine magno animi dolore <lb xml:id="p2z5"/>pronuntio.</s>
					<s n="14" xml:lang="la">Sum hic veluti in quadam <lb xml:id="p2z6"/>specula, cerno multa, quae reliqui non <lb xml:id="p2z7"/>possunt.</s>
					<s n="15" xml:lang="la">Ego commendo causam domino.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z8"/><persName>Georgius Morrhardus</persName>, qui una mecum fuit <lb xml:id="p2z9"/><placeName ref="l587">Tiguri</placeName>, dedit pro me coronatum <placeName ref="l157">Frank<lb xml:id="p2z10"/>fordiae</placeName> <persName ref="p4191">Matthiae Appiario</persName>, typo<lb xml:id="p2z11"/>grapho <placeName ref="l41">Bernensi</placeName>, pro imagine quadam <lb xml:id="p2z12"/>et petiit ab eo, ut ad te primo quoque <lb xml:id="p2z13"/>tempore mitteret (sic enim man<lb xml:id="p2z14"/>daram).</s>
					<s n="17" xml:lang="la">Si missa est, velim huic <lb xml:id="p2z15"/>nuncio des ad me ferendam; si <lb xml:id="p2z16"/>nondum missa, oro atue obsecro, quum<lb xml:id="p2z17"/>primum mittetur, cura ad me mitti.</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z18"/>Si velis istic aliquot habere, plane <lb xml:id="p2z19"/>assentior.</s>
					<s n="19" xml:lang="la">Papa scortum parit in cir<lb xml:id="p2z20"/>cuitu seu processione, hoc est in ima<lb xml:id="p2z21"/>gine valde eleganti.</s>
					<s n="20" xml:lang="la">Audisti, opinor, <lb xml:id="p2z22"/>quid nunc <placeName ref="l425">Romae</placeName> fiat; turbat enim omnia <lb xml:id="p2z23"/>bello, veneno, periuriis e<pb/><lb xml:id="p3z4"/>t<lb xml:id="p3z10"/>c.</s>
					<s n="21" xml:lang="la"><lb xml:id="p3z14"/>Sunt fructus papales.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="salute">Salvere iubeo <lb xml:id="p3z15"/>tris generos, d. <persName ref="p8011">Gvalterum</persName> ac <lb xml:id="p3z16"/>reliquos fratres.</s>
					<s n="23" xml:lang="la">Dux <placeName ref="l2562">Prussiae</placeName> <lb xml:id="p3z17"/>viriliter coepit agere nec <lb xml:id="p3z18"/>vult amplius ferre <persName ref="p2301">Osiandricos</persName>.</s>
					<s n="24" xml:lang="la"><lb xml:id="p3z19"/><persName ref="p2095">Melanthon</persName> eam ob causam <placeName ref="l361">Nor<lb xml:id="p3z20"/>renbergae</placeName> fuit.</s>
					<s n="25" xml:lang="la">Bone deus, cer<lb xml:id="p3z21"/>tamus inter nos, quasi desint <lb xml:id="p3z22"/>nobis hostes; quae oscitantia aut <lb xml:id="p3z23"/>praeposterum iuditium<lb xml:id="p3z24"/>.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p3z25"/><placeName ref="l496">Stutgardiae</placeName> 8. octobris 1555.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p3z26"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><persName ref="p495">H[e<pb/><lb xml:id="p4z1"/>nrico] Bulling[ero]</persName>.</s>
				</p>
			</div>
		</body>
