	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia filii dei tecum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Ne vacuus ad te rediret <lb xml:id="p1z2"/><persName ref="p3988">Ioannes Wolfius</persName> noster, <persName ref="p495">Bullingere</persName> in Christo <lb xml:id="p1z3"/>piissime, hasce breviter exaravi vice salutationis; <lb xml:id="p1z4"/>nam (ut non dubito) referet, quę in <lb xml:id="p1z5"/>hac republica tum in ecclesia <placeName ref="l411">Richenvillensi</placeName> <lb xml:id="p1z6"/>agantur.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Illic enim cęremoniastę conscientias <lb xml:id="p1z7"/>piorum contorquentes ita molestant ubiquitate <lb xml:id="p1z8"/>corporis Christi, quam recipere nolunt <lb xml:id="p1z9"/>neque credunt; tamen quidem formidine poenę <lb xml:id="p1z10"/>metuque carceris ac proscriptionis carnivoris <lb xml:id="p1z11"/>eucharistię participes se faciunt, scilicet sua <lb xml:id="p1z12"/>hypocrisi addentes prevaricationem prevaricati<lb xml:id="p1z13"/>oni, ut propheta ait etc.</s>
					<s n="4" xml:lang="la">Et quid futurum <lb xml:id="p1z14"/>speras nisi gravem divine ultionis vin<lb xml:id="p1z15"/>dictam et animadversionem?</s>
					<s n="5" xml:lang="la">Hinc eni<lb xml:id="p1z16"/>xissime te oro tuosque pios symmystas propter Christum <lb xml:id="p1z17"/>verum deum et hominem sua humanitate <lb xml:id="p1z18"/>in coelo degentem tantisper, dum <lb xml:id="p1z19"/>venerit iudicaturus vivos et mortuos, <lb xml:id="p1z20"/>reliquias eius ecclesię vestrę ecclesię precibus <lb xml:id="p1z21"/>commendetis, ne Satan pietatis doctrinam, <lb xml:id="p1z22"/>quę illic supra triginta annos locum habuit, <lb xml:id="p1z23"/>adeo pręcipitanter obliteret et revellat etc.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">De poedot<lb xml:id="p1z24"/>riba <placeName>Keisergense</placeName>, pio ac docto adolescente, narra<lb xml:id="p1z25"/>bit <persName ref="p8466">Wolfius</persName>, qui, postquam a patria redierit, ad v<lb xml:id="p1z26"/>os/nos? divertet.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Eum tuę humanitati <lb xml:id="p1z27"/>commendo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Hisce vale, athleta Christi for<lb xml:id="p1z28"/>tissime, cuius precibus me commendo.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Salu<lb xml:id="p1z29"/>tabis tuam familiam et symmistas etc.</s>
					<s n="10" xml:lang="la"><placeName ref="l406">Rapolts<lb xml:id="p1z30"/>villę</placeName> 30. iulii 1564. raptim.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">T[<lb xml:id="p1z31"/>uus] <persName ref="p1010">Matthias Erbius</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Salutat te <persName>Georgius P<pb/><lb xml:id="p2z1"/>ennarius</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Praestantissimo pietate <lb xml:id="p2z2"/>inprimis synceręque <lb xml:id="p2z3"/>theologię doctori d. <lb xml:id="p2z4"/><persName ref="p495">Henrycho Bullingero</persName> <lb xml:id="p2z5"/><placeName ref="l587">Tigurino</placeName>, fratri obser<lb xml:id="p2z6"/>vando<lb xml:id="p2z7"/>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>