	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Nihil novi habeo nunc temporis, quod <lb xml:id="p1z2"/>ad te vel scribam vel mittam.</s>
					<s n="3" xml:lang="la"><persName>Panthaleon</persName> noster disputabit <lb xml:id="p1z3"/>iis diebus quęstiones <placeName>Borrhai</placeName>, quo facilius doctoratus titulum <lb xml:id="p1z4"/>assequatur, quem iam olim concupivit; nam est gloriae manci<lb xml:id="p1z5"/>pium.</s>
					<s n="4" xml:lang="la">Quales autem quęstiones sint, nondum excussi; si scirem <lb xml:id="p1z6"/>tibi gratam rem fore, misissem.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Dedi nuper etiam literas ad te, quas perfert d. <persName>Ioannes <lb xml:id="p1z8"/>Thomas Hausierus</persName> <placeName ref="l303">Magdeburgensis</placeName>, legatus a civitate missus <lb xml:id="p1z9"/>ad <placeName ref="l862">Helveticas</placeName> ecclesias pro subsidio colligendo; quam rem melius <lb xml:id="p1z10"/>ab ipso intellige.</s>
					<s n="6" xml:lang="la">Omnia apud nos tranquilla sunt, etsi <lb xml:id="p1z11"/>parum pestis nos adhuc vexet.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Si dialogum concilii <placeName ref="l1107">Tridentini</placeName> nondum accepisti, rescribe, <lb xml:id="p1z13"/>et mittam, ut legas, quid instituant isti episcopi, qui iam <lb xml:id="p1z14"/><placeName ref="l1107">Tridenti</placeName> agunt, et ut nomina illorum tibi sint nota, qui <lb xml:id="p1z15"/>columnae omnium ecclesiarum volunt esse.</s>
					<s n="8" xml:lang="la">Nolunt disputare <lb xml:id="p1z16"/>cum hęreticis, sed monere, ut ad ecclesiam redeant etc.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p4541">Chrysostomi</persName> homiliae inventę sunt Gręce nunquam [factę]<note type="margin">a.R.: ... könnte Abkürzg. f. hactenus sein /man erw. hactenus.</note> hactenus visae, <lb xml:id="p1z18"/>quas <persName ref="p8126">Oporinus</persName> sub prelo habet, quarum te participem faciam.</s>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z19"/>Vale et <persName ref="p1278">Gastium</persName> amare perge.</s>
					<s n="11" xml:lang="la"><placeName ref="l28">Basileę</placeName> 4. februarii <lb xml:id="p1z20"/>1552.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z21"/>T[uus] <persName ref="p1278">Gastius</persName> ex <lb xml:id="p1z22"/>animo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z23"/><placeName ref="l18">Augustani</placeName> concionatores <lb xml:id="p1z24"/>omnem gratiam in concionando amiserunt.</s>
					<s n="14" xml:lang="la">Principio <lb xml:id="p1z25"/>blandi fuere; sed quum contiones suas iuxta pręscriptum <lb xml:id="p1z26"/>Interim dirigant, incipit populus sapere veterem papismum.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z27"/>Ideo raros habent auditores; domi manent fideles.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z28"/>Omnia ad seditionem illic spectant.</s>
					<s n="17" xml:lang="la">Dominus suos custodiat <lb xml:id="p1z29"/>ab omni hęresi.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, pa<lb xml:id="p2z3"/>stori <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae vigilantis<lb xml:id="p2z5"/>simo.</s>
					<s n="19" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>