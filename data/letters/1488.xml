	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Monachus hic venit ad nos ex <placeName ref="l832">Galliis</placeName>; <placeName ref="l280">Lausannę</placeName> <persName ref="p3429">Viretum</persName> et alios <lb xml:id="p1z2"/>est allocutus, nullum tamen ab illis vel aliis attulit testimonium.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Fuit apud nos aliquot diebus, quibus visus fuit nobis veritatis <lb xml:id="p1z4"/>ad modum esse cupidus; licet enim in quibusdam adhuc haereat, cupit <lb xml:id="p1z5"/>tamen erudiri, ut non omnino mala spes de ipso videatur habenda.</s>
					<s n="4" xml:lang="la">Commendavim<lb xml:id="p1z6"/>us eum senatui nostro, sed praeter viaticum nihil impetravimus <lb xml:id="p1z7"/>illi.</s>
					<s n="5" xml:lang="la">Visum ergo fuit illi <placeName ref="l587">Tigurum</placeName> adire.</s>
					<s n="6" xml:lang="la">Rogavit me, ut ipsum tibi <lb xml:id="p1z8"/>commendarem; fac ergo, quod tibi visum fuerit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Bene vale cum <lb xml:id="p1z9"/>tuis omnibus.</s>
					<s n="8" xml:lang="la"><placeName ref="l41">Bernae</placeName> pridie calendas decembres 1551.</s>
					<s n="9" xml:lang="la">Expectamus <lb xml:id="p1z10"/>vestrum super <placeName ref="l167">Genevensi</placeName> negotio consilium.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Submisit etiam urbs <placeName ref="l167">Gene<lb xml:id="p1z11"/>vensis</placeName> proprium cursorem ea de re, quem ad vos iam pervenisse puto.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z12"/>Nos nihil constituemus, donec, quid vobis placuerit, intelligamus.</s>
					<s n="12" xml:lang="la" ana="salute">Nu<lb xml:id="p1z13"/>diustertius <persName ref="p18113">Mecardi</persName> et <persName ref="p4612">Dachseri</persName> uxores huc appulerunt, qui <lb xml:id="p1z14"/>omnes una cum <persName ref="p8417">Musculo</persName> vos plurimum salutant.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">T[<lb xml:id="p1z15"/>uus] <persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori <lb xml:id="p2z4"/>fidelissimo, domino et <lb xml:id="p2z5"/>compatri suo vene<lb xml:id="p2z6"/>rando.</s>
				</p>
				<p>
					<s n="15" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
