			<zone xml:id="p2z31-0" points="1623,2304 1762,2318 1851,2297 1907,2339 1993,2290 2076,2309 2179,2290 2179,2225 2148,2220 2113,2241 2000,2204 1944,2220 1844,2195 1790,2216 1762,2192 1623,2206">1635,2294 1662,2290 1689,2288 1717,2288 1744,2287 1772,2285 1799,2284 1826,2282 1854,2282 1881,2282 1909,2282 1936,2282 1963,2282 1991,2282 2018,2282 2046,2282 2073,2284 2100,2285 2128,2285 2155,2286 2183,2287</zone>
