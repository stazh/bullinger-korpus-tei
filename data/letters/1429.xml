	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Vir clarissime, accepi heri literas tuas, quibus <lb xml:id="p1z3"/>mihi inter reliqua significabas de nuptiis <lb xml:id="p1z4"/><persName ref="p8442">Iosiae</persName> et <persName ref="p6609">Elisabet</persName>, quas opto ut dominus deus <lb xml:id="p1z5"/>fortunet per Iesum Christum; gratulor omnibus <lb xml:id="p1z6"/>vobis.</s>
					<s n="2" xml:lang="la">Intellexi, quae scripserit <lb xml:id="p1z7"/>d. <persName ref="p8018">Halerus</persName>.</s>
					<s n="3" xml:lang="la">Modo non est mihi ad illum <lb xml:id="p1z8"/>scribendi ocium; sed te oro, tu rescribe <lb xml:id="p1z9"/>me brevi ad vos rediturum et me <lb xml:id="p1z10"/>versari nunc in negotiis, quae prorsus ad <lb xml:id="p1z11"/>totam rempublicam Christianam pertinent; <lb xml:id="p1z12"/>nam certe sic est.</s>
					<s n="4" xml:lang="la">Missi hominem <lb xml:id="p1z13"/>in <placeName ref="l834">Italiam</placeName> ad amicos, qui scribebant <lb xml:id="p1z14"/>se nescire, ubi degerem, et propterea <lb xml:id="p1z15"/>eos parum ad me literarum dare; <lb xml:id="p1z16"/>alium vero missi ad personatos patres.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z17"/>Itaque brevi expecta a me prolixas <lb xml:id="p1z18"/>epistolas.</s>
					<s n="6" xml:lang="la">Nunc id tantum affirmo: <lb xml:id="p1z19"/>verum est, quod dicis proclamatum <lb xml:id="p1z20"/>esse bellum inter Cęsarem et regem; <lb xml:id="p1z21"/>sic omnes affirmant.</s>
					<s n="7" xml:lang="la"><placeName ref="l104">Cremonae</placeName> in<lb xml:id="p1z22"/>cubuerat horrida persecutio contra Christi <lb xml:id="p1z23"/>membra; at d. <persName ref="p17907">Fernandus Gongaza</persName> <lb xml:id="p1z24"/>eam penitus sustulit dei gratia, ut <lb xml:id="p1z25"/>miseri illi fratres modo possint respirare.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z26"/>Ter <pb/><lb xml:id="p2z1"/>in hebdomada coepi concionari, at <lb xml:id="p2z2"/>bone deus, quanta impiorum rabie; nam <lb xml:id="p2z3"/>omnino sperabant me nunquam amplius <lb xml:id="p2z4"/>rediturum.</s>
					<s n="9" xml:lang="la">At eos male habet, quod <lb xml:id="p2z5"/>ego is sim, qui non possim sedate <lb xml:id="p2z6"/>predicare et parcere Antichristo.</s>
					<s n="10" xml:lang="la">Et <lb xml:id="p2z7"/>quis eorum, qui Christum sentiat, possit<note type="margin">a.R.: ... possunt</note> <lb xml:id="p2z8"/>parcere?</s>
					<s n="11" xml:lang="la">Affirmo me hic degere <lb xml:id="p2z9"/>in aliquo periculo, sed in domino con<lb xml:id="p2z10"/>fido.</s>
					<s n="12" xml:lang="la">Commendo tibi ex animo <lb xml:id="p2z11"/>meos nepotes, id est ut urgeas saepe, <lb xml:id="p2z12"/>ut tum ipsi sint diligentes, tum praeceptor <lb xml:id="p2z13"/>severus; hac re nihil mihi potes <lb xml:id="p2z14"/>facere gratius.</s>
					<s n="13" xml:lang="la">Utcumque res <lb xml:id="p2z15"/>cadant, ego primo quoque tempore ad <lb xml:id="p2z16"/>vos redibo et portabo versiones et <lb xml:id="p2z17"/>alia non[n]ulla.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale et salve, vir <lb xml:id="p2z18"/>optime.</s>
					<s n="15" xml:lang="la" ana="salute">Saluta mihi omnes fratres.</s>
				</p>
