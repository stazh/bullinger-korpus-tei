	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Adest nobis inexpectatus<note xml:id="fna" type="footnote" n="a">ta in inexpectatus <hi>über der Zeile nachgetragen.</hi></note> vestras<note xml:id="fn1" type="footnote" ana="lex" n="1">Landsmann.</note> hic <persName ref="p4155">Gallus Albertus</persName><note xml:id="fn2" type="footnote" n="2">Zu seiner Person ließ sich nichts ermitteln.</note>, qui, ut ipse <lb xml:id="p1z3"/>ad iter accinctus est, ita me occupatissimum compellat, ut <lb xml:id="p1z4"/>nihil nunc possim praeter vulgaria, quę prius te nosse non dubito.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>De <persName ref="p5829">Mezlero</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p5829">Jakob Metzler</persName>, der sich anscheinend gebessert hatte; s. <persName ref="p495">Bullingers</persName> Bericht vom 14. Januar über dessen anstößiges Verhalten (<ref target="file12379">Nr. 2332</ref>,26-41).</note> quod scribis,<note xml:id="fn4" type="footnote" n="4">In einem nicht erhaltenen Brief; s. auch Anm. 9.</note> gratissimum fuit, et facile condonamus <lb xml:id="p1z6"/>omnia, postquam vobis fecit satis.</s>
					<s n="4" xml:lang="la">Mitto literas<note xml:id="fn5" type="footnote" n="5">Nr. 2351.</note>, quas nudius tertius<note xml:id="fn6" type="footnote" n="6">Am 28. Februar.</note> <lb xml:id="p1z7"/>a <persName ref="p8354">Lęto</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p8354">Georg Frölich</persName>.</note> nostro tibi mittendas accepi.</s>
					<s n="5" xml:lang="la">Deinde etiam schedulas <lb xml:id="p1z8"/>hic leges ad me datas,<note xml:id="fn8" type="footnote" n="8">Dokumente mit ähnlichen Nachrichten wie in <persName ref="p8418">Myconius</persName>' Brief vom 22. Februar (<ref target="file12410">Nr. 2363</ref>,21-39) über Bilderentfernungen in den Kirchen <placeName ref="l869">Siebenbürgens</placeName> und <placeName ref="l882">Mittelungarns</placeName> - und die dabei erwiesene, unerwartete Unterstützung vonseiten des Beylerbegs von <placeName ref="l1074">Buda (Ofen)</placeName>, <persName ref="p5807">Mehmed Yahya Pascha</persName> (vgl. nämlich <ref target="file12422">Nr. 2375</ref>,11f und <ref target="file12423">Nr. 2376</ref>,3-5) - wie auch eine Abschrift der auf dem <placeName ref="l1107">Trienter</placeName> Konzil gefassten Beschlüsse (vgl. <ref target="file12422">Nr. 2375</ref>,20f).</note> quas rogo, ut proximo nuncio remittas.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Librum tuum<note xml:id="fn9" type="footnote" n="9">Es handelt sich um <persName ref="p495">Bullingers</persName> Schrift "De sacramentis", deren Inhaltsverzeichnis <persName ref="p495">Bullinger</persName> schon am 14. Januar übersandt hatte (<ref target="file12379">Nr. 2332</ref>,42-45). Im Brief vom 27./25. Januar hatte <persName ref="p8055">Blarer</persName> die Bitte um Übermittlung der gesamten Schrift geäußert (<ref target="file12382">Nr. 2335</ref>,27f), der <persName ref="p495">Bullinger</persName> wohl mit dem oben Z. 4 erwähnten, nicht erhaltenen Brief an <persName ref="p8055">Blarer</persName> nachkam.</note> bona fide asservatum legam lectumque quamprimum rursus <lb xml:id="p1z10"/>ad te dabo<note xml:id="fn10" type="footnote" n="10">Nämlich am 15. März; s. <ref target="file12428">Nr. 2381</ref>,21-24.</note>.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="7" xml:lang="la">Scripsi ad te 28. ianuarii<note xml:id="fn11" type="footnote" n="11">Nr. 2335.</note> per lanios nostros, nec <lb xml:id="p1z11"/>scio, an eas literas acceperis.</s>
					<s n="8" xml:lang="la">Non enim illę sunt, quas per <persName ref="p8472">Curionem</persName><note xml:id="fn12" type="footnote" n="12"><persName ref="p8472">Konrad Hofherr</persName>.</note> <lb xml:id="p1z12"/>3. februarii<note xml:id="fn13" type="footnote" n="13">Nr. 2344.</note> dedi, nec<pb type="edition" next="189"/> illę<note xml:id="fn14" type="footnote" n="14">Nr. 2354.</note>, quas proxime per nostratem<note xml:id="fn15" type="footnote" n="15">Unbekannt; vielleicht der Metzger, der <ref target="file12382">Nr. 2335</ref> übermittelt hatte; s. <ref target="file12401">Nr. 2354</ref>,24 und Anm. 37.</note>.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>Vide igitur, num invenias; nolim enim eas perditas.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/>Quę de <persName ref="p8472">Curione</persName> admonui, valde rogo, ut <persName ref="p8171">Theodorus</persName><note xml:id="fn16" type="footnote" n="16"><persName ref="p8171">Theodor Bibliander</persName>.</note> <lb xml:id="p1z15"/>pecuniam dispenset, 27 florenos, quos istic a <persName ref="p20962">Wellenbergo</persName><note xml:id="fn17" type="footnote" n="17"><persName ref="p20962">Hans Peter von Wellenberg</persName>.</note> accepit<note xml:id="fn18" type="footnote" n="18">Siehe dazu <ref target="file12401">Nr. 2354</ref>,28-35.</note>.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p1z16"/>Commenda me domino Iesu Christo cum tuis diligentissime, <lb xml:id="p1z17"/>quos meis verbis amantissime salutabis.</s>
					<s n="12" xml:lang="la" ana="salute">Salveant <lb xml:id="p1z18"/>fratres et amici omnes.</s>
					<s n="13" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="14" xml:lang="la">2. martii 1546.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z19"/>Tuus <persName ref="p8055">Ambr. Blaurerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf f. 160a:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p4z1"/>D. <persName ref="p495">Heinricho <lb xml:id="p4z2"/>Bullingero</persName> suo, <lb xml:id="p4z3"/>venerando et <lb xml:id="p4z4"/>charissimo fratri.</s>
					<s n="17" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
