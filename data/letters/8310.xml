	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quas tibi mitto, d. <persName ref="p495">Bullingere</persName> humanissime, literas <lb xml:id="p1z2"/>d. <persName ref="p8018">Halleri</persName>, eas hoc ipso die accepi, utut ab illo iam <lb xml:id="p1z3"/>pridem scriptas.</s>
					<s n="3" xml:lang="la">In quibus mittendis me spero gratiam apud <lb xml:id="p1z4"/>utrumque initurum aliquam, quod unum specto.</s>
					<s n="4" xml:lang="la">Cum enim debeam <lb xml:id="p1z5"/>multum tibi referreque gratiam pro tuis in me m<lb xml:id="p1z6"/>eritis omnino cupiam, accidere mihi gratius nihil potest, <lb xml:id="p1z7"/>quam declarandae meae erga te mutuae benevolentiae oc<lb xml:id="p1z8"/>casionem subministrare mihi.</s>
					<s n="5" xml:lang="la">Neque vero, quod scribam, <lb xml:id="p1z9"/>habeo hoc tempore aliud quidquam, et ut esset maxime <lb xml:id="p1z10"/>aliquid, eo tamen labore me levat d. <persName ref="p3740">a Stetten</persName>, <lb xml:id="p1z11"/>qui omnia ad te et saepe et verbose et diligenter.</s>
					<s n="6" xml:lang="la">Ignosces <lb xml:id="p1z12"/>ergo brevitati, cuius causa non ea modo est, quam scripsi, <lb xml:id="p1z13"/>sed et tabellarii festinatio, cui dandae epistolae plures erant <lb xml:id="p1z14"/><placeName ref="l257">Constantiam</placeName> perferendae.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Valebis ergo, mi d. <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z15"/>meque amabis et tuos meis verbis salutabis.</s>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z16"/>Vale.</s>
					<s n="9" xml:lang="de">3. iulii 1570.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p2899">M[atthias] Schenckius</persName> t[uus].</s>
				</p>
				<p>
					<s n="11" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem erenhafften, wol<lb xml:id="p2z2"/>gelerten meister <persName ref="p495">Heinrich <lb xml:id="p2z3"/>Bullinger</persName>, mein<lb xml:id="p2z4"/>em günstigen herren <lb xml:id="p2z5"/>zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
