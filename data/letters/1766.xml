	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Electus fuit a nobis <persName ref="p8417">Musculus</persName>; sed res aliter coram <lb xml:id="p1z2"/>diacosiis, quam nos speraveramus, evenit, siquidem ab illis <lb xml:id="p1z3"/>diaconus noster praeter voluntatem nostram electus <lb xml:id="p1z4"/>est.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Suffragiorum tam fere aequus fuit numerus, ut bis <lb xml:id="p1z5"/>numerandę essent suffragantium manus, et senatus <lb xml:id="p1z6"/>fere totus <persName ref="p8417">Musculo</persName> astipulatus est; sed plebis prae<lb xml:id="p1z7"/>valuit turba magno omnium bonorum dolore.</s>
					<s n="4" xml:lang="la">Quod <lb xml:id="p1z8"/>nos attinet liberrime de omnibus praemonuimus eos, ut <lb xml:id="p1z9"/>valde gaudeam nostras nos liberasse conscientias.</s>
					<s n="5" xml:lang="la">I[deo] <lb xml:id="p1z10"/>omnia aequius fero et animosius posthac omnia quam ha[ctenus] g<lb xml:id="p1z11"/>eram, ut intelligant omnes, quantum ipsis in ecclesię pace <lb xml:id="p1z12"/>sit situm.</s>
					<s n="6" xml:lang="la">Et quamvis <persName ref="p8417">Musculi</persName> reiectio mihi plurimum <lb xml:id="p1z13"/>doleat, quia video hanc ecclesiam tanto bono non esse dignam, <lb xml:id="p1z14"/>tamen tanto maiori spiritu rapior ad viriliter agendum <lb xml:id="p1z15"/>omnia.</s>
					<s n="7" xml:lang="la">Dabo vero operam, ne quid imprudenter aut <lb xml:id="p1z16"/>incogitate; devinciam illum mihi hominem, quantum quidem possum, <lb xml:id="p1z17"/>mansuetudine, ita tamen ut in metu simul et officio ipsum <lb xml:id="p1z18"/>contineam; non enim tanta est eius authoritas, ut ab illa <lb xml:id="p1z19"/>mihi timeam.</s>
					<s n="8" xml:lang="la">Interea tamen, quia Satanę astus varii s<lb xml:id="p1z20"/>unt, rogo, ut, quicquid mihi accidat, me pro vestro <lb xml:id="p1z21"/>semper agnoscatis.</s>
					<s n="9" xml:lang="la">Haec raptim.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">De praedestinationis negocio, <lb xml:id="p1z22"/>quod valde serpit, proxime scribam; nunc non vacat plura.</s>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z23"/>Vale.</s>
					<s n="12" xml:lang="de">27. novembris 1552.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z24"/>T[uus] <persName ref="p8018">Hall[erus</persName>]<pb/><lb xml:id="p2z1"/>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z4"/>ecclesię antistiti v<lb xml:id="p2z5"/>igilantissimo, domino et <lb xml:id="p2z6"/>compatri charissimo <lb xml:id="p2z7"/>suo.</s>
				</p>
