	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quia nondum ex nundinis rediit <persName ref="p4791">Crispinus</persName> noster, quem ex <lb xml:id="p1z2"/>aliorum relatu intelligo mihi a <persName>Philippo</persName> afferre literas, quędam <lb xml:id="p1z3"/>supersedeo scribere usque ad reditum illius adulescentis, per quem <lb xml:id="p1z4"/>mihi nuper scripsisti.</s>
					<s n="3" xml:lang="la">Tantum in pręsentia volui de fratrum nostrorum <lb xml:id="p1z5"/>statu facere te certiorem.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Fratres <placeName>Alpini</placeName> rursus vexantur non solum <lb xml:id="p1z6"/>a curia <placeName>Taurinensi</placeName> sed etiam <placeName>Gratianolopolitana</placeName> [Gratianopolitana?], <lb xml:id="p1z7"/>nam sub huius ditione sunt duę valles.</s>
					<s n="5" xml:lang="la">Multi <persName>Gratianopolin</persName> tracti sunt, <lb xml:id="p1z8"/>cum ad reddendam fidei confessionem vocati essent.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Omnibus dies est <lb xml:id="p1z9"/>dictus, quo se ad papatus abominationes recipiant.</s>
					<s n="7" xml:lang="la">Si quis vel <lb xml:id="p1z10"/>ministros verbi vel ludimagistros capiat, promissi sunt in singula <lb xml:id="p1z11"/>capita aurei scutati quinquaginta.</s>
					<s n="8" xml:lang="la">Decretum ut manu armata <lb xml:id="p1z12"/>rapiantur nisi intra tempus pręfixum obtemperent.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l378">Parisiis</placeName> <lb xml:id="p1z13"/>ante dies octo tres fuerunt exusti.</s>
					<s n="10" xml:lang="la">Et si autem probabile est <lb xml:id="p1z14"/>paucorum supplicio hostes voluisse incutere omnibus terrorem: brevi <lb xml:id="p1z15"/>tamen audiemus, si constanter alii pergant, singula urbis <lb xml:id="p1z16"/>compita flagrare.</s>
					<s n="11" xml:lang="la">Videtur <persName>Pharaonis</persName> stupor hac una in re <lb xml:id="p1z17"/>expergefieri cladibus bellicis, ut atrocius sęviat contra pios.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z18"/>Dominus omnes eius furias compescat.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Quod tuos commentarios Christi exulibu<lb xml:id="p1z19"/>s dicando tuum erga nos amorem publice testatum esse voluisti, qui <lb xml:id="p1z20"/>hic sunt peregrini tibi communibus literis gratias agunt et cuperent <lb xml:id="p1z21"/>plenius, si daretur occasio, suam gratitudinem re ipsa testari.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z22"/>Ego quoque officii mei esse duxi verbum hoc instar suffragii <lb xml:id="p1z23"/>addere.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Vale, ornatissime vir et mihi observande frater, una <lb xml:id="p1z24"/>cum familia et symmystis.</s>
					<s n="16" xml:lang="la">Dominus vos omnes conservet et regat <lb xml:id="p1z25"/>et benedicere pergat usque in finem.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l167">Genevę</placeName> nonis octobris <lb xml:id="p1z26"/>1557.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z27"/><persName ref="p540">Ioannes Calvinus</persName> tuus<pb/><lb xml:id="p2z12"/>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z14"/>Clarissimo viro d. <lb xml:id="p2z16"/><persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z19"/>ecclesię <placeName ref="l587">Tigurinę</placeName> pastori <lb xml:id="p2z20"/>symmstę et fratri observando<lb xml:id="p2z22"/>.</s>
				</p>
			</div>
		</body>
	</text>
