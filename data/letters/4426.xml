	<text xml:lang="la">
		<body>
			<div>
				<p>
					<note>[Anfang fehlt (ist abgeschnitten), Anfang der nächstoberen Zeile noch sichtbar: "mira"]</note>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l257">Constantiae</placeName> <lb xml:id="p1z2"/>fuere legati mi<lb xml:id="p1z3"/>ssi pontificius Italus quidam, <persName>Bolwylerus</persName> ab imperatore et episcopus <placeName>Labacensis</placeName>.</s>
					<s n="2" xml:lang="la">Postularunt ab <lb xml:id="p1z4"/>episcopo, ut patiatur sibi coadiutorem dari illum ab <placeName>Emps</placeName>, cum senio sit confectus; hactenus <lb xml:id="p1z5"/>vero neque episcopus neque capitulum induci potuit, ut consentirent.</s>
					<s n="3" xml:lang="la">Creditur <lb xml:id="p1z6"/>ergo pontifex citaturus episcopum et capitulum Romam; modis enim omnib<lb xml:id="p1z7"/>us cogitant intrudere hunc.</s>
					<s n="4" xml:lang="la">Quare?</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>scis <placeName>Amisum</placeName>, castrum <placeName>Empsensium</placeName>, Reguscis<note xml:id="fn1" type="footnote" n="1">Bewohner des Rheintales, vgl. <bibl source="b15">HBBW XII</bibl>...</note> opponi, <lb xml:id="p1z9"/>sub e<lb xml:id="p1z10"/>piscopi potestate esse <placeName>Arbonam</placeName>, <placeName>Maiorem <lb xml:id="p1z11"/>Augiam</placeName>, <placeName>Oeningam</placeName>, <placeName>Keyserstuͦl</placeName>, <placeName>Klingnouw</placeName> etc.</s>
				</p>
				<p>
					<s n="6" xml:lang="de"><foreign xml:lang="la">Nunc quidem <lb xml:id="p1z12"/>nulla mentio <lb xml:id="p1z13"/>facta est concilii; sed, si hic intrudatur,</foreign> wirt's zuͦ vilen dingen <lb xml:id="p1z14"/>guͦt sin wider die eydgnossen, insonders wider <lb xml:id="p1z15"/>uns.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>Comitiis futuris et 8. septembris celebrandis <placeName>Badae</placeName> <lb xml:id="p1z17"/>mira audiemus.</s>
					<s n="8" xml:lang="la">Dominus adsit fidelibus suis et frangat anti<lb xml:id="p1z18"/>christo <lb xml:id="p1z19"/>brachium suum etc.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p8429">Milyagrius</persName> habitat <placeName ref="l28">Basileae</placeName> cum uxo<lb xml:id="p1z21"/>re et liberis expectaturus principissae reditum, si forte af<lb xml:id="p1z22"/>fulgeat lux.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Si nulla, scribet ad me; vicissim ad te scribam.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Hic tanta es<lb xml:id="p1z24"/>t inopum studiosorumque turba, ut consuli non po<lb xml:id="p1z25"/>ssit <lb xml:id="p1z26"/>illis hic.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Multa sunt, <lb xml:id="p1z27"/>quae me moerore <lb xml:id="p1z28"/>conficiunt.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Festi<lb xml:id="p1z29"/>nantissim<lb xml:id="p1z30"/>e, 30./31?</s>
					<s n="15" xml:lang="la">au<lb xml:id="p1z31"/>gusti 1560.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z32"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
