	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/><persName ref="p8098">Georg, grave zu Wirtemberg <lb xml:id="p1z3"/>und zu Mümpelgart</persName> etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="de"><lb xml:id="p1z4"/>Unnsern gruß zuvor, wolgelerter, lieber besonder, <lb xml:id="p1z5"/>wiewol wir auß gnaden genaigt, euch etwas <lb xml:id="p1z6"/>besonnders newer zeytung zuzuschicken, haben <lb xml:id="p1z7"/>wir doch diser zeyt annders nichtz dann wie <lb xml:id="p1z8"/>hierinn beygelegtem zedel begriffen ist.</s>
					<s n="3" xml:lang="de">Wo ir <lb xml:id="p1z9"/>dann etwas wüssens oder erfarung, mögen ir <lb xml:id="p1z10"/>uns daßelbig by zaygern diß zuschryben.</s>
					<s n="4" xml:lang="de">Seind <lb xml:id="p1z11"/>wir in gnaden gegen euch zu erkhennen genaigt.</s>
					<s n="5" xml:lang="de"><lb xml:id="p1z12"/>Seyt gott dem allmechtigen bevolhen.</s>
				</p>
				<p>
					<s n="6" xml:lang="de">Datum <placeName ref="l28">Basel</placeName> <lb xml:id="p1z13"/>den 24. April anno etc. 49.</s>
					<s n="7" xml:lang="de"><persName ref="p8098">G[eorg] <lb xml:id="p1z14"/>g[raf] <lb xml:id="p1z15"/>z[u] Wyrttemberg</persName> <lb xml:id="p1z16"/>etc.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="8" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem wolgelerten unnserm lieben <lb xml:id="p2z2"/>besondern <persName ref="p495">Hainrichen Bullingern</persName>, <lb xml:id="p2z3"/>predicanten zu <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
