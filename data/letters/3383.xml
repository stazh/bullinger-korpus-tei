	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Commodum se mihi obtulit hic <persName>Genatius</persName> <lb xml:id="p1z2"/><placeName ref="l638">Engadinus</placeName>, cui videlicet vel meam epistolam ad te <lb xml:id="p1z3"/>hodie missam de rebus novis tradere potes vel eius <lb xml:id="p1z4"/>rescriptum, ut <persName ref="p8432">Friderycho a Salice</persName> ferat.</s>
					<s n="3" xml:lang="la">M. <persName>Rodolphus</persName>, frater uxoris tuae <lb xml:id="p1z5"/>dicit se illam viro tradidisse certo, dedisse huic alioqui.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Ac cum obsignassem priores literas ad te datas, veni<lb xml:id="p1z7"/>t ad me d. <persName>Ludovicus Arcadius Mantuanus</persName>, <placeName>En<lb xml:id="p1z8"/>sebergensis</placeName> ecclesiae apud vos minister, et proposuit <lb xml:id="p1z9"/>mihi has quaestiones: an aequum et pium sit fratres <lb xml:id="p1z10"/>decreto obligare ad symbolum Athanasii, an oporteat <lb xml:id="p1z11"/>eucharistiam deferre ad aegrotantes, an <lb xml:id="p1z12"/>iure audiantur in synodis accusationes absentibus <lb xml:id="p1z13"/>et non coram audientibus accusatis?</s>
					<s n="5" xml:lang="la">Cum vero <lb xml:id="p1z14"/>dubitarem, quo vergerent illae quaestiones, et subol<lb xml:id="p1z15"/>facerem forte altercationem ipsi esse vobiscum, <lb xml:id="p1z16"/>dixi me cogitaturum, quid responderi possit, sed prius <lb xml:id="p1z17"/>etiam exploraturum, quid fratres <placeName ref="l98">Curienses</placeName> hac de <lb xml:id="p1z18"/>re et insuper de <persName>Ludovico</persName> hoc sentiant.</s>
					<s n="6" xml:lang="la">Itaque hortatus <lb xml:id="p1z19"/>sum illum ad concordiam etc. ac dimisi illum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z20"/>Quis itaque ille sit et quid sit negotii, proximis <lb xml:id="p1z21"/>mihi significes, oro, et an conveniat ei respondere script<lb xml:id="p1z22"/>o.</s>
					<s n="8" xml:lang="la" ana="farewell">Vive et vale cum piis omnibus.</s>
					<s n="9" xml:lang="la">29. octobris <lb xml:id="p1z23"/>anno 1557.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
