	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Recepi a te frater in domino colendissime,
					<lb xml:id="p1z2"/>et charissime. literas tuas batae memoriae Paulia
					<lb xml:id="p1z3"/>traditas. Sed studiosos vestros Lausaner
					<lb xml:id="p1z4"/>venientes nondum vidimus. Ad reliqua n
					<lb xml:id="p1z5"/>est, quod pluribus respondeam. A principe vestri
					<lb xml:id="p1z6"/>nullas a tribus mensibus literas accipio. Id
					<lb xml:id="p1z7"/>quod miror; Prius enim singulis septimanti
					<lb xml:id="p1z8"/>fere scribere solebat. Verum tribuo
					<lb xml:id="p1z9"/>taciturvitatem illa itineris incommodita
					<lb xml:id="p1z10"/>Diu enim iam abest ab Helvetiis. Nescio
					<lb xml:id="p1z11"/>sit. Porro vestrae ecclesiae recte et secundum
					<lb xml:id="p1z12"/>verbim dei sunt institutae. Quodsi quis in
					<lb xml:id="p1z13"/>ntitutionem domini subvertere et humaniss
					<lb xml:id="p1z14"/>placitis convutare voluerit, tui officii erit
					<lb xml:id="p1z15"/>resistere, symmystarum erit socias manus consi
					<lb xml:id="p1z16"/>iungere, nisi quis diserto dei verbo demon
					<lb xml:id="p1z17"/>costraverit et enicerit instituta vestra in
					<lb xml:id="p1z18"/>melius posse et debere mutari. Non autem
					<lb xml:id="p1z19"/>utantur in melius cum substiruuntur Saxonica
					<lb xml:id="p1z20"/>et nescio quorum placita. De rebus nostris modo
					<lb xml:id="p1z21"/>nihil scribo. Habes hic vivam epistolam
					<lb xml:id="p1z22"/>dilectum filium Ioannem Fabricium, virum doctissime,
					<lb xml:id="p1z23"/>spyissimum. Is rerum omnium nostrum peritissimum cer
					<lb xml:id="p1z24"/>diserte exponere poterit. Bellum
					<lb xml:id="p1z25"/>illud ego Germaniae divinitus, immitti nihil
					<lb xml:id="p1z26"/>ubigo. Merentur hoc ingratitudo duritie
					<lb xml:id="p1z27"/>nostra poenitentiae nescia, nec c
					<lb xml:id="p1z28"/>imo sat scio nulla re nobis mederim
					<lb xml:id="p1z29"/>posse in unica poenitentia. Quam quia respubni
					<lb xml:id="p1z30"/>certum est certum nobis invinere eximi
					<lb xml:id="p1z31"/>
					<lb xml:id="p1z32"/>Dominus misereatur nostri et inspiret atque
					<lb xml:id="p1z33"/>inflamment mentes nostras, ut tandem illum
					<lb xml:id="p1z34"/>requiramus ion veritate. Vale. Homelius
					<lb xml:id="p1z35"/>hasce duas muneris loco offero. Tu
					<lb xml:id="p1z36"/>inigne a tui amantissimo accupito. Valeto
					<lb xml:id="p1z37"/>iterum
					<lb xml:id="p1z38"/>mivitoaeterum cum regio et
					<lb xml:id="p1z39"/>Hosponiano item et Ulstettero nostris
					<lb xml:id="p1z40"/>Tiguri 16. septembris anno
					<lb xml:id="p1z41"/>1552.
					<lb xml:id="p1z42"/>Bullingerus.
					<pb/>
					<lb xml:id="p2z1"/>Ornatissimo et optime
					<lb xml:id="p2z2"/>viro d. Matthiae
					<lb xml:id="p2z3"/>Erbio Richevillanae
					<lb xml:id="p2z4"/>ecclesiae fido pastori domin
					<lb xml:id="p2z5"/>et fratri suo
					<lb xml:id="p2z6"/>olendissimo et
					<lb xml:id="p2z7"/>charissimo.
					<lb xml:id="p2z8"/>Reyhenwyr.
				</p>
			</div>
