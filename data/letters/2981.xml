	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. <lb xml:id="p1z2"/>D.</s>
					<s n="2" xml:lang="la">Reverende vir, accepi literas <lb xml:id="p1z3"/>et libellos superiori anno ad me per <lb xml:id="p1z4"/>d. <persName ref="p1283">Conradum Gesnerum</persName> <placeName ref="l18">Augusta</placeName> missos, <lb xml:id="p1z5"/>quibus accesserunt hoc anno aliae literae <lb xml:id="p1z6"/>ac munera, quae velut <foreign xml:lang="el">[griechisch]</foreign> <lb xml:id="p1z7"/>tuae erga me constantis benevolentiae <lb xml:id="p1z8"/>inter mea <foreign xml:lang="el">[griechisch]</foreign> adservo.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z9"/>In hac ora <placeName>Baltica</placeName> dei beneficio studia <lb xml:id="p1z10"/>verae de filio dei doctrinae in ecclesii<lb xml:id="p1z11"/>s et scholis florent.</s>
					<s n="4" xml:lang="la">Nostra <lb xml:id="p1z12"/>academia hoc anno ornata est acces<lb xml:id="p1z13"/>sione duorum praestantium theologorum <lb xml:id="p1z14"/>doctoris <persName>Georgii Veneti</persName> et doctoris <persName ref="p20367">Tilem<lb xml:id="p1z15"/>ani Heshusii</persName>, quorum ille epistolam <lb xml:id="p1z16"/>ad Romanos, hic vero Psalmos Davidis <lb xml:id="p1z17"/>interpretatur.</s>
					<s n="5" xml:lang="la">D. <persName>Iohannes Draconites</persName> <lb xml:id="p1z18"/>prophetarum enarrationem intra quadriennium <lb xml:id="p1z19"/>fere ad finem deduxit.</s>
					<s n="6" xml:lang="la">Ego nunc evangelium <lb xml:id="p1z20"/>secundum Lucam et locos <lb xml:id="p1z21"/>theologicos <persName>Philippi</persName> auditoribus propono <lb xml:id="p1z22"/>ac in Luca plurimum tuis doctissimis com<lb xml:id="p1z23"/>mentariis adiuvor.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z24"/>Principes nostri <persName>Iohannes Albertus</persName> et <persName>Ulricus</persName> <lb xml:id="p1z25"/>fratres hac aestate es reditibus bonorum ecclesiasti<pb/><lb xml:id="p2z1"/>corum attribuerunt academiae et consistorio <lb xml:id="p2z2"/>fovendo aureos ter mille et quingentos.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p2z3"/>In <placeName ref="l2574">Livonia</placeName> atrox bellum exardescit propterea, <lb xml:id="p2z4"/>quod domini ordinis Theutonici <lb xml:id="p2z5"/>archiepiscopum <persName>Rigensem Wilhelmum</persName>, fratrem <lb xml:id="p2z6"/>ducis <placeName ref="l2562">Prussiae</placeName>, et episcopi coadiutorem <lb xml:id="p2z7"/><persName>Christophorum</persName>, ducem <placeName>Megapolensem</placeName>, obsidione cinctos <lb xml:id="p2z8"/>ceperunt.</s>
					<s n="9" xml:lang="la">Ad hos liberandos coniunxerunt <lb xml:id="p2z9"/>copias <persName ref="p1825">rex Poloniae</persName>, dux <placeName ref="l2562">Prussiae</placeName> et <lb xml:id="p2z10"/>nostri duces <placeName>Megapolenses</placeName>.</s>
					<s n="10" xml:lang="la">Deum oro, <lb xml:id="p2z11"/>ut inter hos bellorum tumultus ecclesias, <lb xml:id="p2z12"/>quae praeclare alioqui in <placeName ref="l2574">Livonia</placeName> constitutae <lb xml:id="p2z13"/>sunt, servet et protegat.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z14"/><placeName ref="l427">Rostochii</placeName> pridie Laurentii 1556.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z15"/><persName ref="p583">David Chytraeus</persName><lb xml:id="p2z16"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="14" xml:lang="la"><lb xml:id="p2z17"/>Reverendo viro <lb xml:id="p2z18"/>sapientia et vir<lb xml:id="p2z19"/>tute praestanti <lb xml:id="p2z20"/>d. <persName ref="p495">Henrico <lb xml:id="p2z21"/>Bullingero</persName>, <lb xml:id="p2z22"/>pastori ecclesiae <placeName ref="l587">Tig<lb xml:id="p2z23"/>urinae</placeName>, domino <lb xml:id="p2z24"/>suo colendo.</s>
					<s n="15" xml:lang="de"><placeName ref="l587">Zürch</placeName>.</s>
				</p>
				<p>
					<note>[Daneben von anderer Hand:]</note>
					<s n="16" xml:lang="de">Zalt dem botten ei<lb xml:id="p2z25"/>n drinckgelt.</s>
				</p>
			</div>
		</body>
	</text>
