	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>sgi.
					<lb xml:id="p1z2"/>rom vest, ersamm fürsechtig und wys herr Bure,
					<lb xml:id="p1z3"/>germeister und gnedig, lieb herren, herr Heinryh
					<lb xml:id="p1z4"/>yhhußherr pfarrer zuͦ Rorbos, bericht mich
					<lb xml:id="p1z5"/>das diser knab Marxn Sulzer von hettlingen,e
					<lb xml:id="p1z6"/>sye erboren von imm getoufft imm 1537 jarson
					<lb xml:id="p1z7"/>von3. Marxen schuldheyssen uß dem touff gehept
					<lb xml:id="p1z8"/>worden. Des knaben vatter Melchior Sultzer, habe
					<lb xml:id="p1z9"/>der kanden vil gehept, doch alle mitt siner arbeit
					<lb xml:id="p1z10"/>verlich ernert; disen knaben aber zuo der leer
					<lb xml:id="p1z11"/>zoenUnd alls er der leer nachzogen habe er
					<lb xml:id="p1z12"/>zuͦ Basel ettlich jar in der schuͦl gelernet
					<lb xml:id="p1z13"/>Dannen bringt der knab jetzt an mich ein schrybe
					<lb xml:id="p1z14"/>harlangend von sinem schuͦlmeister Meister
					<lb xml:id="p1z15"/>Thoman blatter, welther mir anzeigt, wie der
					<lb xml:id="p1z16"/>absich in der schuͦl zuͦ Basel wol und eerlich
					<lb xml:id="p1z17"/>gehallten, ouch flyssig gestudiert habe, jetzund aber
					<lb xml:id="p1z18"/>in sinem vatterland wyter ze studieren begiri
					<lb xml:id="p1z19"/>sye, mitt früntlicher pitt dem knaben hiern
					<lb xml:id="p1z20"/>zuͦ behelffen und beradten ze sin. Diewyl ich dann
					<lb xml:id="p1z21"/>nch den knaben verhört, der mir zymlich mitt
					<lb xml:id="p1z22"/>antworten begegnet, das zuͦ hoffen ist, möchte
					<lb xml:id="p1z23"/>imm hilff von u. w. begegnen, die wurde, so
					<lb xml:id="p1z24"/>ferr er also fürfuͤre nitt übel angelegt werden
					<lb xml:id="p1z25"/>so bitten ich u. w. underthänig den knaben in
					<lb xml:id="p1z26"/>dbevolhen ze haben und imm mitt zimlich
					<lb xml:id="p1z27"/>u beradten ze sin, damitt er in der leer
					<lb xml:id="p1z28"/>wol möge fürfaren, Es wölle ouch u. w. die
					<lb xml:id="p1z29"/>min begären in gnaden von mir uffnemmen
					<lb xml:id="p1z30"/>und verstan etc. Datum des ersten tags imm mern
					<lb xml:id="p1z31"/>anno domin 1555.
					<lb xml:id="p1z32"/>Uw.
					<lb xml:id="p1z33"/>underthänig
					<lb xml:id="p1z34"/>sertirer
					<lb xml:id="p1z35"/>diener
					<lb xml:id="p1z36"/>M.
					<lb xml:id="p1z37"/>
					<lb xml:id="p1z38"/>Heinrych Bullinger,
					<lb xml:id="p1z39"/>Muurg.
				</p>
			</div>
		</body>
	</text>
