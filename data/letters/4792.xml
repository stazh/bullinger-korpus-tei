	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Cum scribo ad nostri d. Petrum
					<lb xml:id="p1z2"/>ob sere pater fontt, id te quique scriptum
					<lb xml:id="p1z3"/>enxiciar seque enim, ut tecum
					<lb xml:id="p1z4"/>omne mea, si deguc sent communica
					<lb xml:id="p1z5"/>communitet. Semper vero, t salutet
					<lb xml:id="p1z6"/>Ergo, ne mereres, obsecro, quod verem
					<lb xml:id="p1z7"/>ad te.
					<lb xml:id="p1z8"/>silitu erum pos adiutu
					<lb xml:id="p1z9"/>u vis, scribam observantis,
					<lb xml:id="p1z10"/>mea erga te, non silum eadem esse, qui
					<lb xml:id="p1z11"/>antea, si multi ei maiit fit
					<lb xml:id="p1z12"/>est dies, cum mente et memires ecoloiu.
					<lb xml:id="p1z13"/>quarte semper fuerit, ne non in me silu
					<lb xml:id="p1z14"/>si cumprimis d. Petrum et omnes nos
					<lb xml:id="p1z15"/>talia lanvitatia. De causa mir
					<lb xml:id="p1z16"/>cum d. mem aliis Faguribus, nihi
					<lb xml:id="p1z17"/>scribo. quim an delegiter de e.
					<lb xml:id="p1z18"/>Conrade aostro, sciem vere picet
					<lb xml:id="p1z19"/>omnium nostrum audicsessom amico et qui
					<lb xml:id="p1z20"/>vere est ei reliquiis semines sancti
					<lb xml:id="p1z21"/>h.
					<lb xml:id="p1z22"/>lique fere ees.
					<lb xml:id="p1z23"/>in sac urbem
					<lb xml:id="p1z24"/>sene coleiictores mottui sint. Unsem
					<lb xml:id="p1z25"/>d. Iengliran merielant. Sere iitus
					<lb xml:id="p1z26"/>est Theobuldus negre, qutm senemer, nu
					<lb xml:id="p1z27"/>misi neqotia, sum cum iumonibus
					<lb xml:id="p1z28"/>qui titam aliquam in venerim putrine
					<lb xml:id="p1z29"/>antequata vetta vel pteria dico.
					<pb/>
					<lb xml:id="p2z1"/>Guliemus vester et mene redet tu
					<lb xml:id="p2z2"/>virie. praelet testimneum ammove.
					<lb xml:id="p2z3"/>sic eum illi vo, purę viarine
					<lb xml:id="p2z4"/>modicue singeleris et in audii
					<lb xml:id="p2z5"/>bonar irarum imune dilegentię.
					<lb xml:id="p2z6"/>frec erit cene vestrę cepulica
					<lb xml:id="p2z7"/>orutentes. deus illum diu ser
					<lb xml:id="p2z8"/>et suę divis, magis
					<lb xml:id="p2z9"/>mages tumulet. vale fratre
					<lb xml:id="p2z10"/>optimo Tum tespecu supperaci in
					<lb xml:id="p2z11"/>libelli et contiliis et altero coltra
					<lb xml:id="p2z12"/>vligtatem . Iterum vale.
					<lb xml:id="p2z13"/>Arget 17. Aatii 61. Celerrime.
					<lb xml:id="p2z14"/>iread.
					<lb xml:id="p2z15"/>.
					<lb xml:id="p2z16"/>Tu pi u.
					<lb xml:id="p2z17"/>du i odm sua ai
					<lb xml:id="p2z18"/>persii.
					<lb xml:id="p2z19"/>Acsus
					<lb xml:id="p2z20"/>vera5.
					<lb xml:id="p2z21"/>es.
					<lb xml:id="p2z22"/>Sensi.
				</p>
			</div>
