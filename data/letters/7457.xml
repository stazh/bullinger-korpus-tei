	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Extra ea, quae abhinc octiduo scribebam, <lb xml:id="p1z2"/>nihil memoratu dignum habeo, chare frater, <lb xml:id="p1z3"/>nisi quod ea pacis capita, quae tunc mittebam, <lb xml:id="p1z4"/>supposititia esse autumo.</s>
					<s n="3" xml:lang="la">Quae primo misi, vera <lb xml:id="p1z5"/>esse reor.</s>
					<s n="4" xml:lang="la">Interim constat certo regem alia <lb xml:id="p1z6"/>quoque plurima promisisse proceribus, quae si praestit<lb xml:id="p1z7"/>erit, salvę erunt res.</s>
					<s n="5" xml:lang="la">Has literis <persName ref="p2054">Ulissi</persName> <lb xml:id="p1z8"/>nostro inscriptas, quaeso, cures diligenter et valeas <lb xml:id="p1z9"/>una cum tuis omnibus, symmystis et communibus <lb xml:id="p1z10"/>amicis nostris.</s>
					<s n="6" xml:lang="la">Quia vero nulli alii nuncii <lb xml:id="p1z11"/>de morte <persName>Philippi</persName> tantillum nunciant, addubito <lb xml:id="p1z12"/>et de illa narratione, quamquam et <persName>dux Hessius</persName> <lb xml:id="p1z13"/><placeName ref="l646">Claronam</placeName> scripserit famam esse in <placeName ref="l832">Gall[i]a</placeName> <persName ref="p18575">Philippum</persName>, <lb xml:id="p1z14"/>regem <placeName ref="l875">Hispaniarum</placeName>, esse mortuum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Vale iterum iterumque<lb xml:id="p1z15"/>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 7. amii 1568.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z2"/>Praestantissimo viro d. <persName ref="p8016">Thobiae <lb xml:id="p2z3"/>Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z4"/>ecclesiae ministro fidelissimo, <lb xml:id="p2z5"/>fratri meo honorando et dilecto.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
