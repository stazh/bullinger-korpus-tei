	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Humanissime vir, misi etiam cum typographo <lb xml:id="p1z3"/>confessionem domini <persName ref="p20367">Tilemanni Heshusii</persName>; <lb xml:id="p1z4"/>ea est impressa <placeName ref="l361">Norinbergae</placeName>; hic reperi <lb xml:id="p1z5"/><placeName ref="l157">Francfordiae</placeName> venalem apud typographum, <lb xml:id="p1z6"/>qui excudit, et ubi perlegi, typographo dixi, <lb xml:id="p1z7"/>quare aliqua omisisset et cur non rectius <lb xml:id="p1z8"/>in presisset.</s>
					<s n="3" xml:lang="la">Is respondit: "Annon, ut debui, <lb xml:id="p1z9"/>impressi?"</s>
					<s n="4" xml:lang="la">Respondi: "Non, quia nomen <persName ref="p4639">Michaelis <lb xml:id="p1z10"/>Dille</persName>, concionatoris aulici, est expunctum <lb xml:id="p1z11"/>et omissum."</s>
					<s n="5" xml:lang="la">"O", dicebat, "nolite tangere <lb xml:id="p1z12"/>unctos meos.</s>
					<s n="6" xml:lang="la"><persName ref="p4639">Dillerus</persName> est contionator aulicus."</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Quęsivi, num consilio <persName ref="p20367">Tilemanni</persName> delevisset <lb xml:id="p1z14"/>nomen <persName ref="p4639">Dilleri</persName>; respondit sibi exemplar <lb xml:id="p1z15"/>non a <persName ref="p20367">Tilemanno</persName>, sed a <persName>Pesoldo</persName>, contio<lb xml:id="p1z16"/>natore <persName>Norico</persName> datum esse.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p20367">Tilemannus</persName> praeterea omisit vocem <foreign xml:lang="de">"mundtlich"</foreign> <lb xml:id="p1z18"/>et illius loco posuit <foreign xml:lang="de">"wesentlich"</foreign><note type="margin">a.R.: "(o)misit quoque epitheta... nea... ba(ccalaureus <placeName ref="l210">Heidelbergensis</placeName>)"</note>.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/>Hinc ego, praestantissime vir, concludo, si adver<lb xml:id="p1z20"/>sario doctori licuit mutare confessionem <lb xml:id="p1z21"/>et diminuere, mihi liberum quoque <lb xml:id="p1z22"/>erit meam confessionem, quae brevis est, augere <lb xml:id="p1z23"/>et declarare.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z24"/>Et quandoquidem, ut videbis, vobis sum <lb xml:id="p1z25"/>annumeratus, etiam atque etiam rogo, quando hic <lb xml:id="p1z26"/>manere non erit tutum et ex rebus meis, <lb xml:id="p1z27"/>ut mihi in vestra vicinia subveniatis; <lb xml:id="p1z28"/>pro viribus a deo concessis officio <lb xml:id="p1z29"/>meo satisfaciam.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale et me tibi com<lb xml:id="p1z30"/>mendatum habeas, quaeso.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Datae <placeName ref="l157">Francofur<lb xml:id="p1z31"/>die</placeName> 10. aprilis anno 60.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z32"/>Tuae dignitatis <lb xml:id="p1z33"/>observantissimus <lb xml:id="p1z34"/><persName ref="p8399">Wilhelmus Klebitz</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro <lb xml:id="p2z2"/><persName ref="p495">Hainrico Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ministro fidelissimo, <lb xml:id="p2z5"/>domino suo colendo.</s>
				</p>
			</div>
		</body>
	</text>
