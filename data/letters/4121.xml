	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Si quid ego novi ex <placeName ref="l834">Italia</placeName> habuissem, tuam paternitatem <lb xml:id="p1z3"/>minime celassem; sed creationem pontificis nondum <lb xml:id="p1z4"/>procedere certum est.</s>
					<s n="3" xml:lang="la">Exeunt quotidie pasquilli acuti, ut <lb xml:id="p1z5"/>audio, et faceti admodum (ego enim, quod Italice scripti <lb xml:id="p1z6"/>sunt, intelligere nequeo) in eos, ad quos haec electio pertinet.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Galli dicunt <placeName>Italorum</placeName> cardinalium tantam esse nequitiam, ut <lb xml:id="p1z8"/>nemo illorum sit, quem non insigne aliquod scelus nobilitaverit; <lb xml:id="p1z9"/>vix ergo aut aegre admodum Italum aliquem electum iri.</s>
					<s n="5" xml:lang="la">Sperant <lb xml:id="p1z10"/>ergo pontificatum ad <persName>Gallum</persName> tandem devolvendum, cumque Bellaius <lb xml:id="p1z11"/>et <persName>Turnonius</persName> plurimum valeant, uterque prudentiae, alter <lb xml:id="p1z12"/>etiam eruditionis opinione, spem bonam esse alterum illorum <lb xml:id="p1z13"/>posse hanc dignitatem obtinere.</s>
					<s n="6" xml:lang="la">Sed causae tamen sunt, <lb xml:id="p1z14"/>cur cardinales magis in partes <placeName>Turnonii</placeName> propensuri credantur.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Ita quidem <persName>Galli</persName>; sed alii <placeName ref="l306">Mediolanensem</placeName> pontificatum <lb xml:id="p1z16"/>in manibus portare aiunt.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Haec sunt, quae auditione <lb xml:id="p1z17"/>percepi; quae etsi non admodum sunt ponderosa, tamen <lb xml:id="p1z18"/>non praetermittenda duxi.</s>
					<s n="9" xml:lang="la">Mitto nunc puerum ad legatum in <lb xml:id="p1z19"/><placeName>Haldenstein</placeName> (arcem enim eam nunc incolit); is si <lb xml:id="p1z20"/>quid praeterea habebit, pro sua humanitate non gravatim <lb xml:id="p1z21"/>communicabit.</s>
					<s n="10" xml:lang="la"><persName ref="p17889">Ducem Sabaudiae</persName> audio magnam pecuniae <lb xml:id="p1z22"/>vim undique conficere, quae et ad alendum exercitum sufficiat; <lb xml:id="p1z23"/>videtur hoc nescio quid portendere <placeName ref="l167">Genevensibus</placeName>; ducem nomina q<lb xml:id="p1z24"/>uam plurima facere cer<lb xml:id="p1z25"/>tum est.</s>
					<s n="11" xml:lang="la">Rex Navarrae filiam <persName>Heinrici <lb xml:id="p1z26"/>Philippo</persName> in <placeName ref="l875">Hispaniam</placeName> ducere scribitur, quod mihi argumento <lb xml:id="p1z27"/>est motus in <placeName ref="l875">Hispania</placeName> esse compositos.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z28"/>Scoti, ut audio a <persName>Gallis</persName> defecerunt; legatus tamen dicebat <lb xml:id="p1z29"/>se non audire regem suum cogitare hanc iniuriam in praesenti <lb xml:id="p1z30"/>lo persequi, quod ille videretur certo consilio facere, cum quod <lb xml:id="p1z31"/>currenti furori non obviam eundum censeret, tum ne, cum <placeName ref="l2524">Scotis</placeName> <lb xml:id="p1z32"/>vim faceret, Angli quoque hac occasione socia arma cum <lb xml:id="p1z33"/>Scotis coniungerent.</s>
					<s n="13" xml:lang="la">Haec quidem nuper legatus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Addebat etiam <pb/><lb xml:id="p2z1"/>connestablium hoc incendium diu providisse et <persName>Heinrico</persName> regi etiamnum <lb xml:id="p2z2"/>praedixisse tunc, cum tractarentur nuptiae inter delphinum et <lb xml:id="p2z3"/>puellam <placeName ref="l2524">Scoticam</placeName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Dicebat enim comestablius: "Nunc tu, o rex, <lb xml:id="p2z4"/>videris magno emere velle, quod gratis hactenus habuisti <lb xml:id="p2z5"/>et porro habere poteras.</s>
					<s n="16" xml:lang="la">Nam cum <persName>Scotis</persName> ad alienam vim propulsandam <lb xml:id="p2z6"/>non satis sit virium, ultro et quidem suplices ad te rogatum de <lb xml:id="p2z7"/>auxiliis venirent; si militem miseris, ipsi stipendia solvent ex <lb xml:id="p2z8"/>suo; nihil illis pręter titulum regni reliqui erit, cętera in <lb xml:id="p2z9"/>tua potestate erunt omnia.</s>
					<s n="17" xml:lang="la">Si autem invitis imperare cogitas, <lb xml:id="p2z10"/>periculum est, ne illi vectigalia regni sibi reservent, sumptus autem <lb xml:id="p2z11"/>belli tibi soli relinquant tuque titulum quidem regni usurpes, commoditatibus <lb xml:id="p2z12"/>vero careas" etc.</s>
					<s n="18" xml:lang="la">Sed vicit sententia <persName>Guisiani</persName> cardinalis, qui <lb xml:id="p2z13"/>suam familiam illustrare et maiore in gratia apud regem ponere <lb xml:id="p2z14"/>cogitavit.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z15"/>Fama est, sed obscura adhuc regem <persName>Philippum</persName> in venatione <lb xml:id="p2z16"/>cum equo praecipitem ivisse et tertio die post esse mortuum; <lb xml:id="p2z17"/>sed haec nondum affirmare ausim.</s>
					<s n="20" xml:lang="la">Si verum est, nuptiae bis <lb xml:id="p2z18"/>sunt funestae.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z19"/>Interim, dum haec scribo, legatus ex <placeName>Haldenstein</placeName> nunciat <lb xml:id="p2z20"/>se novi nihil plane habere, audire tamen <placeName ref="l425">Romanos</placeName> esse adhuc <lb xml:id="p2z21"/>impontificatos (haec illius verba sunt).</s>
					<s n="22" xml:lang="la" ana="farewell"><lb xml:id="p2z22"/>Vale, vir clarissime, quam diutissime et felicissime cum tuis omnibus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="salute"><lb xml:id="p2z23"/>Salutem tibi ascribere me iusserunt d. d. consules, senex<note xml:id="fn1" type="footnote" n="1">Lucius</note> Ts<lb xml:id="p2z24"/>charnerus, d. Philippus, <persName ref="p6130">Pontisella</persName> et amici omnes, qui, <lb xml:id="p2z25"/>cum mihi tuae redderentur, mecum fuerunt.</s>
					<s n="24" xml:lang="la" ana="salute">Salvere ex me <lb xml:id="p2z26"/>iubebis mecoenates et praeceptores meos mihi semper observandos.</s>
				</p>
				<p>
					<s n="25" xml:lang="la" ana="farewell"><lb xml:id="p2z27"/>Vale iterum.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><placeName ref="l98">Curię</placeName> 6. novembris anno 1559.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><pb/><lb xml:id="p4z2"/>Clarissimo viro eruditione et <lb xml:id="p4z3"/>pietate excellenti d. <persName ref="p495">Heinrycho <lb xml:id="p4z4"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p4z5"/>antistiti vigilantissimo, <lb xml:id="p4z6"/>domino et patrono suo <lb xml:id="p4z7"/>inprimis colendo.</s>
					<s n="28" xml:lang="de"><lb xml:id="p4z8"/><placeName ref="l587">Zürych</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
