	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Qui tibi, frater, bene volunt, ex impru<lb xml:id="p1z2"/>dentia, ut ego quidem iudico, iuvando non iu<lb xml:id="p1z3"/>vare instituerant.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Non improbandus est eorum <lb xml:id="p1z4"/>conatus; sed laudem tamen illi merentur, qui et ipsi <lb xml:id="p1z5"/>tibi non male volunt videruntque in summam inopiam <lb xml:id="p1z6"/>te detrusum fuisse ideoque dissuaserunt.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Qui <placeName>Wangensi</placeName> <lb xml:id="p1z7"/>ecclesiae inserviunt, rebus prope destituuntur omnibus<lb xml:id="p1z8"/>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quando vero liberatus fuisses ex hac miseria?</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Sciunt omnes te vehementer diligi et magni <lb xml:id="p1z10"/>fieri apud eos, apud quos nunc ministrum Christi <lb xml:id="p1z11"/>agis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Hi postea vehementer improbassent tuam illam <lb xml:id="p1z12"/>desertionem, maxime cum vixdum expleris bienniu<lb xml:id="p1z13"/>m.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Consultius ergo multo est, ut fideliter adhuc <lb xml:id="p1z14"/>ei inservias ecclesiae, ad quam te vocavit dominus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>Non obliviscentur tui, si ita perrexeris, ut fecis<lb xml:id="p1z16"/>ti hactenus, viri boni; quinimo ipse dominus a <placeName ref="l90">Cham</placeName> <lb xml:id="p1z17"/>consul, vir clarissimus, dissuasit et ipse hanc mutationem, <lb xml:id="p1z18"/>bene autem pollicetur, si tui semper sis similis.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/>Ac ego quoque, si quid possem et vivere daretur, <lb xml:id="p1z20"/>longius tui semper meminero.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Sed et dominus, qui ante <lb xml:id="p1z21"/>omnia est spectandus, nunquam fideli deerit.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">In hoc <lb xml:id="p1z22"/>te valere opto.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Salutabis <persName ref="p3728">Remigium a Schou<lb xml:id="p1z23"/>enstein</persName>, quem etsi nunquam viderim, audio tamen <lb xml:id="p1z24"/>virum esse fortem et bonum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Inprimis salutabis optimum <lb xml:id="p1z25"/>senem amanum <persName>Paulum</persName> etc.</s>
					<s n="15" xml:lang="la">14. februarii 1563.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Fideli ministro ecclesiae <lb xml:id="p2z2"/><placeName ref="l108">Davosianae</placeName> d. <persName ref="p8016">Thobiae <lb xml:id="p2z3"/>Eglio</persName>, symmystae <lb xml:id="p2z4"/>et fratri meo charissimo.</s>
				</p>
			</div>
