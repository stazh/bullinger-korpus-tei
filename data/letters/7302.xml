			<zone xml:id="p2z38-0" points="236,3600 563,3582 763,3610 843,3566 1061,3587 1063,3460 820,3499 695,3470 508,3507 449,3473 239,3509">253,3549 293,3549 334,3549 375,3548 416,3546 457,3546 498,3545 539,3543 580,3543 621,3540 662,3540 702,3538 743,3537 784,3535 825,3534 866,3533 907,3531 948,3530 989,3527 1030,3522 1071,3519</zone>
		</surface>
