	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuas recepi scriptas 12. iunii nec dubito, quin perlata sint ad te, <lb xml:id="p1z2"/>que nuper scripsi.</s>
					<s n="3" xml:lang="la">De <placeName ref="l832">Gallia</placeName> nihil possum scribere nisi quosdam nimis esse <lb xml:id="p1z3"/>sollicitos, quod pontifex omnes principes concitare velit in regnum, quia se <lb xml:id="p1z4"/>preparet ad nationale concilium et in eo perstet nec tam chare plumbum emere.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Rex non est ingressurus <placeName ref="l378">Luteciam</placeName> ante ianuarium mensem.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Anglie <lb xml:id="p1z6"/>regina nubit millord <persName>Roberto</persName> nec admittere in suis ditionibus <lb xml:id="p1z7"/>voluit pape nuncios volentes eam invitare ad concilium.</s>
					<s n="6" xml:lang="la">Permissa<note type="misc">permisissa!</note> <lb xml:id="p1z8"/>Metis et aliquot aliis urbibus templa ad concionandum evangelium et <lb xml:id="p1z9"/>liberam sacramentorum administrationem.</s>
					<s n="7" xml:lang="la">Intra novem aut 10 dies ero <placeName ref="l21">Badene</placeName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z10"/>Salutabis amicos omnes nosque amabis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">De <placeName>Angrone Valle</placeName> audio constantes <lb xml:id="p1z11"/>esse plusque dare incommodi quam accipere.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l760">Sol[uduri]</placeName> 10. iunii.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z12"/>Tuus ex animo, quem nosti.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tigurine</placeName> eclesie pastori vigilantissimo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
