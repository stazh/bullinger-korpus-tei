	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Literae tuae proximae, vir clarissime, pergratę <lb xml:id="p1z3"/>mihi fuerunt, quod a te de filio tuo eleganti <lb xml:id="p1z4"/>et tibi charissimo scriptę essent.</s>
					<s n="3" xml:lang="la">Is cum rogasset <lb xml:id="p1z5"/>me, ut in eius libello, quem secum in hunc usum <lb xml:id="p1z6"/>circumfert, sententiam aliquam sacram, qua <lb xml:id="p1z7"/>pietatis admoneretur, ascriberem, id feci libenter, <lb xml:id="p1z8"/>quod rem sibi utilem, parenti tibi gratam et meis <lb xml:id="p1z9"/>studiis dignam postulasset.</s>
					<s n="4" xml:lang="la">De exulibus <placeName ref="l294">Lucarnens<lb xml:id="p1z10"/>ibus</placeName> cum magistratu nostro, quod fieri potuit, <lb xml:id="p1z11"/>diligenter egi de praesidio aliquo, quo pii homines <lb xml:id="p1z12"/>iuventur, parando.</s>
					<s n="5" xml:lang="la">Is sane se daturum operam <lb xml:id="p1z13"/>pollicitus est, ut aliquo beneficio a republica <lb xml:id="p1z14"/><placeName ref="l28">Basiliensi</placeName> ornatos se sentiant; nam id ut facerent <lb xml:id="p1z15"/>pietatem requirere, quae pręscribat exules propter <lb xml:id="p1z16"/>evangelii professionem benigne tractandos <lb xml:id="p1z17"/>esse, quos peculiariter cum viduis et pupillis deus <lb xml:id="p1z18"/>commendatos habeat.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Utinam mihi tam <lb xml:id="p1z19"/>benemerendi de hoc hominum genere facultas <lb xml:id="p1z20"/>esset quam voluntas; eis praesidia earum rerum, <lb xml:id="p1z21"/>quę ad victum necessarię sunt, a me defutura <lb xml:id="p1z22"/>non essent.</s>
					<s n="7" xml:lang="la" ana="farewell">Tu vale, vir clarissime, cum <lb xml:id="p1z23"/>uxore et liberis et evangelii ministris, quos <lb xml:id="p1z24"/>in Christo bene valere cupio.</s>
					<s n="8" xml:lang="la"><placeName ref="l28">Basileę</placeName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z25"/><persName ref="p8298">Martinus Borrhaus</persName> t[uus].</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>vigilanti ecclesię <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> pastori<lb xml:id="p2z5"/>.</s>
				</p>
				<p>
					<note>[v.a.Hd?]</note>
					<s n="11" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zurich</placeName></s>
				</p>
			</div>
		</body>
	</text>
