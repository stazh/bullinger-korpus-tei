	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Tuas accepi, nec est, quod vicissim nunc ad te scribam, nisi <lb xml:id="p1z3"/>quod maximas tibi gratias ago, quod occupatissimus licet <lb xml:id="p1z4"/>non intermittas tamen scribendi officium.</s>
					<s n="2" xml:lang="la"><persName ref="p3375">Vergerio</persName>, si istic adhuc <lb xml:id="p1z5"/>est, ut reverenter me commendes, etiam atque etiam te obsecro.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Quę bene ominatis verbis vocationi meę precaris, dominus et servator <lb xml:id="p1z7"/>noster Christus rata esse velit.</s>
					<s n="4" xml:lang="la">Legati, qui has tibi exhibent <lb xml:id="p1z8"/><placeName ref="l49">Bielenses</placeName>, senator <persName>Nicolaus</persName>, optimus sane vir et Christi glorię studiosus, <lb xml:id="p1z9"/>cum charissimo filio meo <persName ref="p4868">Funclio</persName> coram tibi omnia optima fide exponent.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Fasciculus, quem misisti, tam diligenter medicis illis reddi curabo, <lb xml:id="p1z11"/>quam te, mi <persName ref="p495">Bullingere</persName>, amo ac velut summum amicum observo <lb xml:id="p1z12"/>ac colo, nec opus erat in tantillo negocio tantis obtestationibus; <lb xml:id="p1z13"/>velim enim tibi hoc omnino persuasum nihil tam arduum ac difficile <lb xml:id="p1z14"/>esse, quod tua causa non sim, si ita iubeas, promptissimo animo suscepturus, <lb xml:id="p1z15"/>ingratissimus plane futurus, nisi me ipsum quoque, quantuluscunque <lb xml:id="p1z16"/>sum, tibi impendam.</s>
					<s n="6" xml:lang="la" ana="farewell">Bene vale cum tuis omnibus ac me cum <lb xml:id="p1z17"/>meis piis apud cęlestem patrem nostrum interpellationibus fortiter <lb xml:id="p1z18"/>adiuva.</s>
					<s n="7" xml:lang="la"><placeName ref="l555">Vituduri</placeName>, 5. iulii anno 1551.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z19"/>T[uus] <persName ref="p8055">Ambr[osius] Bl[aurerus]</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>Quid mali inter episcopum <lb xml:id="p1z21"/><placeName ref="l257">Constantiensem</placeName> et senatum <lb xml:id="p1z22"/>aut illum a <persName>Bolvilla</persName> acciderit, <lb xml:id="p1z23"/>narrabunt tibi legati illi, <lb xml:id="p1z24"/>ubi huius admonueris.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, amico suo cum<lb xml:id="p2z3"/>primis colendo fratrique <lb xml:id="p2z4"/>longe omnium charissimo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
