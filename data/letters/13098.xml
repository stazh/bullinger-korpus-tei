	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Credo vos omnes mei prorsus oblivionem cepisse.</s>
					<s n="2" xml:lang="la">Tertia est haec, quam ad te scribo, <lb xml:id="p1z2"/>epistola.<note xml:id="fn1" type="footnote" n="1">Neben dem vorliegenden Brief ist nur noch Brief <ref target="file13074">Nr. 3025</ref> vom 1. Oktober 1547 erhalten.</note></s>
					<s n="3" xml:lang="la">Domino <persName ref="p8127">Pellicano</persName> et <persName ref="p8171">Bibliandro</persName> secundo scripsi.<note xml:id="fn2" type="footnote" n="2">Keiner dieser Briefe ist erhalten.</note></s>
					<s n="4" xml:lang="la">Hospiti meo<note xml:id="fn3" type="footnote" n="3"><persName ref="p17939">Georg Rubli</persName>; s. <ref target="file13105">Nr. 3056</ref>,<ptr target="qvzl17329-2" type="qv"/>.</note>, qui <lb xml:id="p1z3"/>sarcinas meas huc transmittendas in se receperat, totidem, quot ad te, dedi.</s>
					<s n="5" xml:lang="la">Ab ullo <lb xml:id="p1z4"/>nihil accipio, nec possum satis mirari, qui fiat.</s>
					<s n="6" xml:lang="la">Non enim neque hominum huc<note xml:id="fn4" type="footnote" n="4">Nach <placeName ref="l41">Bern</placeName>, wo er sich befindet; s. <ref target="file13074">Nr. 3025</ref>, <ptr target="qvfn17294-2" type="qv"/>.</note> <lb xml:id="p1z5"/>commeantium inopiam neque temporis paucitatem<note xml:id="fn5" type="footnote" n="5">temporis paucitatem: Gemeint ist seine Wartezeit in <placeName ref="l41">Bern</placeName>.</note> <pb type="edition" next="576"/> neque quicquam accusare possum, <lb xml:id="p1z6"/>nisi id in fortunam meam vel in negligentiam eorum, qui se mihi coram amicos <lb xml:id="p1z7"/>esse dictitarunt, reiiciam.</s>
					<s n="7" xml:lang="la">Id si (ut debeo) aegre fero, malo tamen in me esse <lb xml:id="p1z8"/>commissum quam in alios a me, cum enim semper veritus sum, ne cuivis <lb xml:id="p1z9"/>inoffitiosus esse videar<note xml:id="fna" type="footnote" n="a"><hi>In der Vorlage</hi> videarer.</note>, tum maxime erga amicos, aut saltem mea amicitia <lb xml:id="p1z10"/>dignos.</s>
					<s n="8" xml:lang="la">Talia officia negligere iniustum esse duxi.</s>
					<s n="9" xml:lang="la">Hic iuvenis<note xml:id="fn6" type="footnote" n="6">Unbekannt.</note> commodum <lb xml:id="p1z11"/>se mihi obtulit, per quem ultimo id ad vos scriberem, dum video vos offitium <lb xml:id="p1z12"/>meum ita aspernari.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="10" xml:lang="la" ana="salute">Dominus <persName ref="p1804">Iodocus</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p1804">Jodocus Kilchmeyer</persName>.</note> dat tibi salutem.</s>
					<s n="11" xml:lang="la">Dominis <persName ref="p8127">Pellicano</persName> et <lb xml:id="p1z13"/><persName ref="p8171">Bibliandro</persName> eandem meis verbis (si lubet) dices.</s>
					<s n="12" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="13" xml:lang="la"><placeName ref="l41">Bernae</placeName>, <lb xml:id="p1z14"/>21 octobris 1547.</s>
					<s n="14" xml:lang="la">Tui <lb xml:id="p1z15"/>studiosissimus <persName ref="p985">Ioa. de <pb/><lb xml:id="p2z1"/>Hotot</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la">Clarissimo viro doctrina et virtute <lb xml:id="p2z2"/>praestanti, domino <persName ref="p495">Heynrico Bulingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori.</s>
					<s n="16" xml:lang="la">A.<note xml:id="fn8" type="footnote" n="8">Ist damit vielleicht <hi>Antistiti</hi> gemeint?</note> <placeName ref="l587">Tiguri</placeName>.<note xml:id="fn9" type="footnote" n="9"><persName ref="p495">Bullinger</persName> erhielt den vorliegenden Brief erst etwa um den 10. November; s. <ref target="file13105">Nr. 3056</ref>,<ptr target="qvzl17329-11" type="qv"/>. <ptr target="qvzl17329-2" type="qv"/>, und <ptr target="qvfn17329-2" type="qv"/>.</note></s>
				</p>
			</div>
		</body>
	</text>
