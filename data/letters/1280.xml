	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Tandem occasionem nactus, compater <lb xml:id="p1z2"/>in domino charissime, mitto foeturam Psalterii <lb xml:id="p1z3"/>mei; oro, ut qualemcunque hanc animi <lb xml:id="p1z4"/>mei gratitudinem pro humanitate <lb xml:id="p1z5"/>tua boni consulas.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Domus mea inde a 18. aprilis haud levi <lb xml:id="p1z7"/>incommodo turbari coepit.</s>
					<s n="4" xml:lang="la">Uxor de gradibus <lb xml:id="p1z8"/>quibusdam prolapsa abortivit; <lb xml:id="p1z9"/>uterum gestaverat mensibus quinque, <lb xml:id="p1z10"/>infans erat masculus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Post abortionem <lb xml:id="p1z11"/>sic immodice fluere coepit, ut pene <lb xml:id="p1z12"/>cum sanguine vitam amisisset.</s>
					<s n="6" xml:lang="la">Iam per <lb xml:id="p1z13"/>gratiam domini paululum restituitur.</s>
					<s n="7" xml:lang="la">Interea <lb xml:id="p1z14"/>benivolentia dominorum, qua stipendium annuum <lb xml:id="p1z15"/>auxerunt, aliquid solatii attulit.</s>
					<s n="8" xml:lang="la">Domino <lb xml:id="p1z16"/>cumprimis, deinde et amicis, tibi et <lb xml:id="p1z17"/>aliis, sit gratia.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p8416">Abrahamum</persName> meum sub pentecosten mittam <lb xml:id="p1z19"/>volente domino <placeName ref="l512">Tubingam</placeName>; nam ibi aletur <lb xml:id="p1z20"/>stipendio civis cuiusdam <placeName ref="l18">Augustani</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Quod<lb xml:id="p1z21"/>si quem ex doctis illis nosti tibi et communi <lb xml:id="p1z22"/>causae bene velle, obsecro, commendes illi <lb xml:id="p1z23"/>filium meum.</s>
					<s n="11" xml:lang="la"><persName>Nicolaum</persName> nepotem ex fratre <lb xml:id="p1z24"/>mittam <placeName ref="l18">Augustam</placeName>, ut aliquid mechanicum <lb xml:id="p1z25"/>ibi discat.</s>
					<s n="12" xml:lang="la">Constitui sumptus domesticos <lb xml:id="p1z26"/>nonnihil relevare, quo commodius cum <lb xml:id="p1z27"/>reliqua familia vivam.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z28"/>De conciliabulo <placeName ref="l1107">Tridentino</placeName> sparsus est hic <lb xml:id="p1z29"/>rumor esse suspensum ad calendas usque <lb xml:id="p1z30"/>septembris.</s>
					<s n="14" xml:lang="la">Utinam in patibulo, unde <lb xml:id="p1z31"/>nunquam liberetur.</s>
					<s n="15" xml:lang="la">De <placeName ref="l303">Magdeburg[ensibus]</placeName> summum <lb xml:id="p1z32"/>silentium; sed <placeName ref="l586">Zurzacum</placeName> forsan adferet <lb xml:id="p1z33"/>aliquid, utinam nihil mali.</s>
					<s n="16" xml:lang="la">Si quid habes, <lb xml:id="p1z34"/>communica.</s>
					<s n="17" xml:lang="la" ana="farewell">Optime vale, compater in domino charissime.</s>
					<s n="18" xml:lang="la" ana="salute"><lb xml:id="p1z35"/>Salutem tuis omnibus meo meorumque omnium nomine, <lb xml:id="p1z36"/>item fratribus reliquis, dominis et amicis, d. <persName ref="p8127">Pellicano</persName>, <persName ref="p8171">Biblia<lb xml:id="p1z37"/>ndro</persName>, <persName ref="p8011">Rudolfo</persName>.</s>
					<s n="19" xml:lang="de"><placeName ref="l41">Bernę</placeName> 1551. 13. maii.</s>
					<s n="20" xml:lang="la"><persName ref="p8417">W[olfgangus] Musc[ulus]</persName> compater tuus in <lb xml:id="p1z38"/>domino.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="salute">De domino <persName ref="p506">Butl<lb xml:id="p1z39"/>ero</persName> iam diu nihil audio; si adhuc apud vo<lb xml:id="p1z40"/>s est, dicas ill<lb xml:id="p1z41"/>i meo nomine plurimam salutem.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo m. <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> ecclesię <lb xml:id="p2z5"/>antistiti vigilan<lb xml:id="p2z6"/>tissimo, com<lb xml:id="p2z7"/>patri suo in <lb xml:id="p2z8"/>Christo charissimo.</s>
					<s n="23" xml:lang="la"><lb xml:id="p2z9"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
