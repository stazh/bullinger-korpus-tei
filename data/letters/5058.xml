	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non fuissem passus te tamdiu meis carere, nisi tabellionum <lb xml:id="p1z2"/>copia destitutus fuissem.</s>
					<s n="3" xml:lang="la">Interea tuas omnes accepi et ago <lb xml:id="p1z3"/>gratias.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Cretensis is, de quo scribis, huc non venit, sed per <lb xml:id="p1z4"/><placeName ref="l760">Solodorum</placeName> transiit et inde ad me tuas literas misit.</s>
					<s n="5" xml:lang="la">Quod <lb xml:id="p1z5"/>res <placeName ref="l832">Gallicas</placeName> attinet, nihil ferme habemus aliud praeter id <lb xml:id="p1z6"/>quod vos quoque habetis, sicut ex tuis cognovi.</s>
					<s n="6" xml:lang="la">Hodie primum <lb xml:id="p1z7"/>fertur colloquium esse finitum et d. <persName>Petrum</persName> mox adfuturum, <lb xml:id="p1z8"/>fidelibus publicas congregationes concessas, ita tamen ut templa suis se<lb xml:id="p1z9"/>rventur sacrificulis; esse interea principes et nobiles, qui multis in <lb xml:id="p1z10"/>locis de suis bonis publica construere velint auditoria et <lb xml:id="p1z11"/>hoc a regina fuisse concessum.</s>
					<s n="7" xml:lang="la">Sed an sit verum, pro certo nond<lb xml:id="p1z12"/>um affirmo, quamvis vero non absimile videatur; habebimus <lb xml:id="p1z13"/>tamen mox de his et aliis certa.</s>
					<s n="8" xml:lang="la"><persName ref="p1049">Farellus</persName> superiore septimana <lb xml:id="p1z14"/><placeName ref="l339">Neocomo</placeName> discessit et profectus est in <placeName ref="l2772">Delphinatum</placeName>, unde et oriundus <lb xml:id="p1z15"/>est, ut illic Christum praedicet.</s>
					<s n="9" xml:lang="la">Ex nostris partibus omnes fere ministri <lb xml:id="p1z16"/><placeName ref="l832">Gallici</placeName> discedunt; praetendunt, quod disciplinam, qualem vellent, <lb xml:id="p1z17"/>obtinere non possint; sed ego puto eos amore patrię et spe meliorum <lb xml:id="p1z18"/>proventuum magis duci.</s>
					<s n="10" xml:lang="la">Novit dominus, quid quisque quaerat.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/>Puto <persName ref="p3494">Diesbachium</persName> de his tecum locutum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Consulueramus senat<lb xml:id="p1z20"/>ui, ut tolerabilem aliquam disciplinae formam ipsis concederet; <lb xml:id="p1z21"/>sed et ipsis et nobis hoc fuit negatum; sunt enim plaerique <lb xml:id="p1z22"/>persuasi omnes, quotquot huius rei faciunt mentionem, dominia <lb xml:id="p1z23"/>et nescio quas claves iterum quaerere.</s>
					<s n="13" xml:lang="la">Sunt tamen e diverso multi <lb xml:id="p1z24"/>etiam, qui negotio non male fervent quique vident ecclesiae necessitatem <lb xml:id="p1z25"/>severiorem aliquam correctionem requirere.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Faxit dominus, <lb xml:id="p1z26"/>ut talis disciplina instituatur, quę non maioris destructionis quam <lb xml:id="p1z27"/>aedificationis sit occasio.</s>
					<s n="15" xml:lang="la">Sed de his alias plura.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Haec vix ex <lb xml:id="p1z28"/>mediis turbis nundinarum et accedentium me frequentia <lb xml:id="p1z29"/>impediente, ut nunc plura non possim.</s>
					<s n="17" xml:lang="la">Remitto tibi <persName ref="p8009">Fa<lb xml:id="p1z30"/>bricii</persName> literas et ago gratias.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">Salutem tibi dicunt <persName ref="p3494">Diesbachius</persName>, <lb xml:id="p1z31"/><persName ref="p8063">Steigerus</persName>, <persName ref="p8417">Musculus</persName>, <persName ref="p8012">Hallerus</persName> quaestor, <persName ref="p4060">Zehenderi</persName> et multi alii.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z32"/><placeName ref="l41">Bernae</placeName> in die Martini 1561.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="salute">Salutem dic uxori, familię <lb xml:id="p1z33"/>et fratribus omnibus.</s>
					<s n="21" xml:lang="la"><persName ref="p8018">I[oannes] <lb xml:id="p1z34"/>Hallerus</persName>, perpetuo <lb xml:id="p1z35"/>tuus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino suo honorando et com<lb xml:id="p2z5"/>patri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
