	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quod iamdudum p[raestantiae] t[uae] non scripserim, in causa fuit penuria novarum, <lb xml:id="p1z2"/>non voluntatis et obsequentię.</s>
					<s n="3" xml:lang="la"><placeName ref="l425">Roma</placeName> nihil habeo (et habui nunc literas), quod non <lb xml:id="p1z3"/>sit vetus et non antea tibi notum; nota enim mihi omnia erant.</s>
					<s n="4" xml:lang="la">Sed literę nostrę <lb xml:id="p1z4"/>vetustatem sibi comparant in circuitu illo et ambitu itineris, cum amplius <lb xml:id="p1z5"/>cursores hac non transeant.</s>
					<s n="5" xml:lang="la">Si quid p[raestantiae] t[ua] habet, rogo, nobiscum communicet.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/>E <placeName ref="l1148">Constantinopoli</placeName> scribitur <persName>Bayazetem</persName> circunsessum a fratre <persName ref="p21130">Selimo</persName> et <lb xml:id="p1z7"/>quasi in extremum periculum vitę aut captivitatis redactum, tandem capta <lb xml:id="p1z8"/>occasione ex incuria ipsius <persName ref="p21130">Selimi</persName> in solemnitate festiva, quam tunc celebrabat <lb xml:id="p1z9"/>totus exercitus, occupati, obsidione sese liberasse et versus Persas confugisse.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Quod quidem maximum damnum allaturum est illi imperio propter discordias <lb xml:id="p1z11"/>et divisiones istorum fratrum.</s>
					<s n="8" xml:lang="la">Deus aperiat oculos principum nostrorum et <lb xml:id="p1z12"/>dirigat corda ad expellendos istos, qui veri sunt infideles.</s>
					<s n="9" xml:lang="la">E <placeName ref="l832">Gallia</placeName> nihil <lb xml:id="p1z13"/>intelligo, quod novum sit aut inauditum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Novus dux <placeName ref="l522">Venetiis</placeName> nondum est <lb xml:id="p1z14"/>creatus, et oriuntur inter eos magnę controversię et insolitę propter <lb xml:id="p1z15"/>ambitionem aliquorum, quod quidem primates angit et torquet.</s>
					<s n="11" xml:lang="la">Offero me p[raestanti<lb xml:id="p1z16"/>ae] t[uae] deditissimum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l98">Curie Rhetorum</placeName> die 18. septembris 1559.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z17"/>P[r<lb xml:id="p1z18"/>aestantiae] t[uae] obs[ervans] et stu[diosus] t<lb xml:id="p1z19"/>otus <persName ref="p8306">J[ean] J[acques] Decambray</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro pietate et <lb xml:id="p2z2"/>eruditione excellenti domino <lb xml:id="p2z3"/><persName ref="p495">Henrico Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z4"/>ecclesię ministro, domino et <lb xml:id="p2z5"/>amico suo colendo.</s>
				</p>
			</div>
		</body>
	</text>
