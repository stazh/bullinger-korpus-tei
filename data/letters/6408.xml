	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil plane nunc, quod scribam, habeo, nisi <lb xml:id="p1z2"/>quod tuae postremae 12. martii datae, mihi hodie <lb xml:id="p1z3"/>sunt redditae.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Dominum oro, ut motus istos componat.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Aliunde nihil scribitur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Expecto in horas literas <lb xml:id="p1z5"/>ex <placeName ref="l210">Heydelberga</placeName> et <placeName ref="l18">Augusta Vindelicorum</placeName>.</s>
					<s n="6" xml:lang="la">D. <persName>Müllnero</persName> <lb xml:id="p1z6"/>praedicabo tuam fidem et diligentiam.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Saluta d. consules, <lb xml:id="p1z7"/>d. <persName ref="p1770">Carlinum</persName>, d. <persName ref="p6130">Pontasellam</persName> et vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 16. martii <lb xml:id="p1z8"/>1565.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Heri <persName>Sebastianus <span type="pronoun">noster</span> Guldibecus</persName> apoplexia <lb xml:id="p1z9"/>afflictus migravit ad dominum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ita subinde spoliamur <lb xml:id="p1z10"/>doctis, bonis et utilibus hominibus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Quid futurum sit, <lb xml:id="p1z11"/>novit dominus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Iterum vale et ora pro me dominum.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z12"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z7"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z8"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z9"/>ecclesiae fideli ministro, <lb xml:id="p2z10"/>domino et fratri meo <lb xml:id="p2z11"/>colendo et dilecto.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z12"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
