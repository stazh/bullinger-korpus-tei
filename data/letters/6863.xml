	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime ac colendissime pater, deus te servet nobis <lb xml:id="p1z2"/>incolumem atque salvum diutissime votaque tua omnia fortunet!</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Non ita pridem scripsi ad te fusissime et ad reliquos praeceptores <lb xml:id="p1z4"/>meos omni officio observandos, misi praeterea tres meos <lb xml:id="p1z5"/>discipulos <placeName ref="l28">Basilaeam</placeName> etiam <persName ref="p20351">Mischcovios</persName>, quorum unus est germanus <lb xml:id="p1z6"/>frater eorum, qui cum <persName ref="p3988">Wolphio</persName> vivunt, duo reliqui patrueles <lb xml:id="p1z7"/>illorum<lb xml:id="p1z8"/>, nostri palatini <placeName ref="l260">Cracoviensis</placeName> nepotes.</s>
					<s n="3" xml:lang="la">Intermittere ta<lb xml:id="p1z9"/>men nolui etiam in mediis meis gravissimis occupationibus, <lb xml:id="p1z10"/>quin ad has proximas nundinas <placeName ref="l157">Francoford[iam]</placeName> aliquid ad te scriberem <lb xml:id="p1z11"/>et eandem cantilenam canerem<note xml:id="fn1" type="footnote" n="1"><bibl source="b56">Adagia</bibl>, 2, 5, 76 (<bibl source="b370">LB</bibl> II 574).</note> de perturbatissimo videlicet rerum <lb xml:id="p1z12"/>omnium cum religionis tum public..</s>
					<s n="4" xml:lang="la">civilique in nostra <lb xml:id="p1z13"/><placeName ref="l2472">Sarmatia</placeName> statu.</s>
					<s n="5" xml:lang="la">Nam ut de confusione <placeName>Arianicae</placeName> et anabapti<lb xml:id="p1z14"/>sticae religionis taceam, cuius progressum cum <persName>Blandraticis</persName> oraculis <lb xml:id="p1z15"/>ad vos misimus, scito, huic regno a tribus potentissimis hostibus <lb xml:id="p1z16"/>magna pericula impendere.</s>
					<s n="6" xml:lang="la"><persName>Moschus</persName> copiosissimis exercitibus <lb xml:id="p1z17"/><placeName ref="l841">Lituaniam</placeName> invasurus est, nisi deus avertat.</s>
					<s n="7" xml:lang="la"><placeName>Tartari</placeName> superiori<lb xml:id="p1z18"/>bus diebus in finibus <placeName ref="l2561">Podoliae</placeName> multa depopulando ac vas<lb xml:id="p1z19"/>tando damna dederunt, omnes autem propter <placeName ref="l2510">Turcam</placeName> nu<lb xml:id="p1z20"/>merosissimo exercitu descendentem in <placeName ref="l882">Hungariam</placeName> timent, ne <lb xml:id="p1z21"/>vicinum bellum, quamvis <placeName ref="l2510">Turca</placeName> cum <placeName ref="l2472">Polono</placeName> foedere unctus <lb xml:id="p1z22"/>sit, irruptionibus et incursionibus in regni fines valde noxium <lb xml:id="p1z23"/>sit ac perniciosum.</s>
					<s n="8" xml:lang="la">A <placeName ref="l2562">Prussia</placeName> quoque nescio quid novi <lb xml:id="p1z24"/>affertur, quasi et ibi cogitarent de defectione, proinde amplissima <lb xml:id="p1z25"/>legatio est eo missa.</s>
					<s n="9" xml:lang="la"><persName ref="p8100">Scalichius</persName> male hic audit, vix effugiet <pb/><lb xml:id="p2z2"/>principum manus.</s>
					<s n="10" xml:lang="la">De <persName ref="p1936">Lismanini</persName> horrenda morte ex me<lb xml:id="p2z3"/>is literi<lb xml:id="p2z4"/>s, qu<lb xml:id="p2z5"/>as.<lb xml:id="p2z6"/>.<lb xml:id="p2z7"/>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z9"/>Nos oramus filium dei regnantem ad patris <lb xml:id="p2z10"/>dexteram, ut ipse ecclesiam et gloriam suam adversus <lb xml:id="p2z11"/>furores diabolorum his postremis mundi temporibus tueatur <lb xml:id="p2z12"/>vosque et ecclesiam vestram in tranquili statu <lb xml:id="p2z13"/>florere patietur.</s>
					<s n="12" xml:lang="la" ana="salute">Cui me et officia mea humilit<lb xml:id="p2z14"/>er commendo atque saluto universos tuamque imprimis <lb xml:id="p2z15"/>domesticam ecclesiam.</s>
					<s n="13" xml:lang="la" ana="farewell">Iterum vale, pater omni <lb xml:id="p2z16"/>observantia colendissime.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Datum <placeName ref="l260">Cracoviae</placeName> calendis au<lb xml:id="p2z17"/>gusti 1566.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z18"/>Addictissimus ac tui <lb xml:id="p2z19"/>observantissimus <lb xml:id="p2z20"/><persName ref="p8511">Christophorus Thretius</persName><pb/><lb xml:id="p3z2"/>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p3z6"/>Cl<pb/><lb xml:id="p4z1"/>arissimo atque piissimo viro do... <lb xml:id="p4z2"/>mini d. <persName ref="p495">Henricho Bul[lingero</persName>, <lb xml:id="p4z3"/>ex]imio Iesu Christi servo, <placeName ref="l587">[Tigurinae</placeName> ec<lb xml:id="p4z4"/>c]lesiae pastori fidelissimo, [<lb xml:id="p4z5"/>domino et] patri omni observantia co<lb xml:id="p4z6"/>lendo<lb xml:id="p4z7"/>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p4z8"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
