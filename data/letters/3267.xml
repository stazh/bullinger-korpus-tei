	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Mitto ad te praefationem cum titulo Apo<lb xml:id="p1z3"/>calypseos; indicem ad calcem operis poni <lb xml:id="p1z4"/>curavimus et in eo excudendo adhuc hęremus; <lb xml:id="p1z5"/>finietur tamen et is, ut spero, proxima septimana.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>In caeteris, quae iam pridem coepta fuerunt, aegre <lb xml:id="p1z7"/>nos explicari ad proximas calendas septembres posse video; <lb xml:id="p1z8"/>adeo multa praeter opinionem supersunt, <lb xml:id="p1z9"/>et tempus nimis breve est reliquum.</s>
					<s n="4" xml:lang="la">Volui <lb xml:id="p1z10"/>itaque inprimis absolvendę Apocalypsi vacare, <lb xml:id="p1z11"/>ut cuius lectionem praesenti rerum statui praecipue <lb xml:id="p1z12"/>et utilem et necessariam putarem.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">De <placeName ref="l1255">Cantuariens<lb xml:id="p1z13"/>i</placeName> libro quid actum sit, ex ipso <persName ref="p1227">Froschoue<lb xml:id="p1z14"/>ri</persName> nepote melius intelligis; dixit enim is <lb xml:id="p1z15"/>se cum ipsomet <persName ref="p1145">Foxo</persName> de eo acturum.</s>
					<s n="6" xml:lang="la">Non prohib<lb xml:id="p1z16"/>ita est a nostris eius editio, sed semel atque <lb xml:id="p1z17"/>iterum sollicitanti pro ea ipso <persName ref="p1145">Foxo</persName> apud <persName ref="p3099">Sulcerum</persName> <lb xml:id="p1z18"/>nostrum nondum impetrari licuit, ut <lb xml:id="p1z19"/>permitteretur.</s>
					<s n="7" xml:lang="la">Adeo ad colloquium <lb xml:id="p1z20"/>illud <placeName ref="l569">Wormacien<lb xml:id="p1z21"/>s<lb xml:id="p1z22"/>e</placeName> tanquam corvi hiantes pendent neque tranquilli<lb xml:id="p1z23"/>tati rerum conducturum putant, si hoc praesertim <lb xml:id="p1z24"/>tempore ita hac in re insanientibus adversariis <lb xml:id="p1z25"/>quicquam eius argumenti a nostris proferatur in medium.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z26"/>Ego vero longe alia in sententia essem, quanto <lb xml:id="p1z27"/>magis illi insaniunt, tanto nobis magis competere, <lb xml:id="p1z28"/>ne laboranti causae desimus, sed eo artius <lb xml:id="p1z29"/>obsistendum, et si ullo unquam tempore utile fuisset <lb xml:id="p1z30"/>scriptum illud edi, hoc tam exacerbato seculo <pb/><lb xml:id="p2z1"/>ita virus suum improbe spargentibus in nos adversariis <lb xml:id="p2z2"/>et utilissimum id fore et summe necessarium putarim.</s>
					<s n="9" xml:lang="la"><lb xml:id="p2z3"/>Atque utinam in eo excudendo mihi etiam <lb xml:id="p2z4"/>versari liceat aut qualicunque opera mea id, <lb xml:id="p2z5"/>ut per alium quemvis fiat, promovere; ita enim <lb xml:id="p2z6"/>me de republica christiana non mediocriter meriturum <lb xml:id="p2z7"/>sperarim.</s>
					<s n="10" xml:lang="la" ana="farewell">Bene vale et de mea erga <lb xml:id="p2z8"/>te fide atque observantia in perpetuum dubitare <lb xml:id="p2z9"/>noli.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Orationes, cum primum potero, vel simul omnes <lb xml:id="p2z10"/>tres vel tertiam seorsim excudam, pro qua mihi <lb xml:id="p2z11"/>dono data ingentes, quantas omnino par est, <lb xml:id="p2z12"/>gratias ago.</s>
					<s n="12" xml:lang="la" ana="salute">Resalutant te officiose d. <persName ref="p8298">Borrhaus</persName>, <lb xml:id="p2z13"/><persName>Iunius</persName>, <persName ref="p8406">Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><persName ref="p3099">Sulcero</persName> literas tuas nondum <lb xml:id="p2z14"/>potui ostendere.</s>
					<s n="14" xml:lang="la">Sed et d. <persName ref="p1145">Foxus</persName> atque <persName ref="p8155">Balaeus</persName> plurimu<lb xml:id="p2z15"/>m se tibi uterque commendant.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Iterum vale.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l28">Basileae</placeName> 10. augusti 1557.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><persName ref="p8126">Ioan[nes] Oporinus</persName> t<lb xml:id="p2z16"/>uus ex animo.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Optimo atque doctissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z17"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> ecclesię pastor<lb xml:id="p2z18"/>i vigilantissimo, domino et amico suo plu<lb xml:id="p2z19"/>rimum colendo.</s>
					<s n="19" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
