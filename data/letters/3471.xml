	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D<lb xml:id="p1z2"/>.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/><persName ref="p540">Calvino</persName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Faxit Christus ut hic annus nobis felicissimus sit totus.</s>
					<s n="4" xml:lang="la">Gratulor vobis <lb xml:id="p1z4"/>reparatum foedus et amicitiam vete<lb xml:id="p1z5"/>rem innovatam cum vicinis <lb xml:id="p1z6"/>et veteribus amicis.</s>
					<s n="5" xml:lang="la">Recte ille monebat, sacius esse vicinos et veteres amicos retinere <lb xml:id="p1z7"/>quam his praeteritis novos ex longinquo sibi compa<lb xml:id="p1z8"/>rare <lb xml:id="p1z9"/>velle.</s>
					<s n="6" xml:lang="la">Et quidem docuit hoc nos colloquium quoque <placeName>Wormaciense</placeName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Melius erit <lb xml:id="p1z10"/>initam nostram amicitiam et consensionem synceram retin<lb xml:id="p1z11"/>ere, <lb xml:id="p1z12"/>quam apud eos <lb xml:id="p1z13"/>novam quaerere, <lb xml:id="p1z14"/>qui nostram amicitiam <lb xml:id="p1z15"/>non modo nihili faciunt, sed et nos ut hostes condemnant.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Scis colloquium <lb xml:id="p1z16"/>esse finitum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Scis nos esse damnatos.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Principio quidem a furiosis illis <lb xml:id="p1z17"/><placeName>Saxonibus</placeName>, qui oblata praesidi damnatione nostrarum ecclesiarum relictis <lb xml:id="p1z18"/>symmystis mox ab initio colloquii domum redierunt.</s>
					<s n="11" xml:lang="la">Illi ipsi nominatim <lb xml:id="p1z19"/><persName>Zvinglium</persName> damnarunt, nominatim ei iunxerunt <persName ref="p2301">Osiandrum</persName>, <placeName>Schwenckfeldi<lb xml:id="p1z20"/>um</placeName> et<lb xml:id="p1z21"/>c.</s>
					<s n="12" xml:lang="la">Moderatiores, ut <persName>Philippus</persName>, <persName ref="p458">Brentius</persName>, <persName>Iacobus Andreae</persName>, <persName ref="p9046">Pistorius</persName>, <lb xml:id="p1z22"/><persName>Dillerus</persName> et caeteri, obstitere initio symmystis illis suis et <lb xml:id="p1z23"/>iniquum putarunt non auditos damnare.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Mox tamen, cum viderent collo<lb xml:id="p1z24"/>quium haerere hic nec progredi velle, 21. octobris oblata ipsi quoque <lb xml:id="p1z25"/>protestatione praesidi nominatim condemnarunt <persName>Zvinglium</persName>, et quidem <lb xml:id="p1z26"/>solum: reliquos nominatim non expresserunt, quia <persName ref="p2301">Osiandro</persName> <lb xml:id="p1z27"/><persName ref="p458">Brentius</persName> favet, <persName>Philippus</persName> facile regitur ab aliis.</s>
					<s n="14" xml:lang="la">Habemus ergo nunc de<lb xml:id="p1z28"/>clarationem <persName>Philippi</persName>, quid nunc sentiat de eucharistia.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Si pr<lb xml:id="p1z29"/>otestationem illam nondum vidisti, mittemus illam ad te.</s>
					<s n="16" xml:lang="la">Post obla<lb xml:id="p1z30"/>tam illam protestationem papistae in colloquio pertinatius quam antea <lb xml:id="p1z31"/>progredi noluerunt (vol?).</s>
					<s n="17" xml:lang="la">Habuerunt enim quod voluerunt (et quaesierunt)<note type="misc">fehlt 387b.</note></s>
					<s n="18" xml:lang="la">Ha<lb xml:id="p1z32"/>ctenus in tot comitiis non potuit impetrari a principibus e<lb xml:id="p1z33"/>vangelicis ut ipsi nominatim voluerint damnare <persName>Zvinglium</persName>.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z34"/>At hoc iam confectum dederunt docti principum, forte minus <lb xml:id="p1z35"/>circumspecti.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Neque vero hoc contenti fuerunt.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Nam prius<lb xml:id="p1z36"/>quam discesserint <placeName ref="l569">Wormacia</placeName> conscripto consensu profitentur, <lb xml:id="p1z37"/>se non mutare neque unquam mutaturos esse quod semel pro<lb xml:id="p1z38"/>fessi sunt in confessione <placeName ref="l18">Augustana</placeName>.</s>
					<s n="22" xml:lang="la">Atque hoc est quod saepissime <lb xml:id="p1z39"/>dixi: si conveniatur millies in colloquium cum istis hominibus, <lb xml:id="p1z40"/>regula et formula consensionis erit confessio <placeName ref="l18">Augustana</placeName>, <lb xml:id="p1z41"/>cui qui non subscripserit exclusus manebit.</s>
					<s n="23" xml:lang="la">Hoc iam <lb xml:id="p1z42"/>vulgato scripto confirmarunt.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Amemus ergo nos mutuum: pro<lb xml:id="p1z43"/>fiteamur et ipsi quod verum esse scim<lb xml:id="p1z44"/>us, relinquentes illis quod o<lb xml:id="p1z45"/>mnino sibi relinqui volunt atque contendunt intactum.</s>
					<s n="25" xml:lang="la">Non deerit nobis dominus<lb xml:id="p1z46"/>.</s>
				</p>
				<p>
					<s n="26" xml:lang="la" ana="farewell"><lb xml:id="p1z47"/>Vale.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 12. ianuarii 1558.</s>
				</p>
				<p>
					<note type="address">[Ohne Adresse.]</note>
				</p>
			</div>
