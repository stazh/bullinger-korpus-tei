	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Immortales omnino pro saluberrima tua institutione <lb xml:id="p1z2"/>gratias habeo tibi, observandissime mi d. <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z3"/>quae quantopere me confirmaverit, magis ac magis <lb xml:id="p1z4"/>in dies deprehendo.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">En literas etiam ad d. <persName ref="p1283">Gesnerum</persName>, <lb xml:id="p1z5"/>a quo licet nunc intervallo locorum iterum aliquo <lb xml:id="p1z6"/><placeName ref="l377">Patavium</placeName> cras iter arripiens seiungar, non tamen <lb xml:id="p1z7"/>intermittam, quin illic pisces optatos, quoscunque <lb xml:id="p1z8"/>potero impetrare, ac ad te, quae digna scitu <lb xml:id="p1z9"/>fuerint, crebro transmittam.</s>
					<s n="4" xml:lang="la">Sed heus vos ho<lb xml:id="p1z10"/>mines acerbos et vehementes, <persName ref="p7024">Westphalus</persName> ea, qua <lb xml:id="p1z11"/>solet uti modestia, contra neminem hominum nec <lb xml:id="p1z12"/>maledictis nec immani ulla impudentia hactenus <lb xml:id="p1z13"/>insurrexit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">En tibi simplicitatis in eo exemplum!</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Proh dolor, quantus vetus papismus denuo per <lb xml:id="p1z15"/>istos nebulones, vereor, ne integer invectus <lb xml:id="p1z16"/>adeo increb escat.</s>
					<s n="7" xml:lang="la">Temperantiam vestram sibi co<lb xml:id="p1z17"/>natur adscribere, quam ne imitari quidem <lb xml:id="p1z18"/>novit, livorem suum in vos reiicit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Cavete <lb xml:id="p1z19"/>tamen serio, ne non homini triobulari graviter <lb xml:id="p1z20"/>respondeatis.</s>
					<s n="9" xml:lang="la">Icones aut tale aliquid, quod officium iu<lb xml:id="p1z21"/>re non erat, neutiquam mittere conveniebat, <lb xml:id="p1z22"/>quod ibi sumptus haud dubie non pucos feceris, <lb xml:id="p1z23"/>quamvis eos non spernens eo certe maiori aestimation<lb xml:id="p1z24"/>e chariores habeo, quo ab homine amantis<lb xml:id="p1z25"/>simo sunt profecti.</s>
					<s n="10" xml:lang="la">Caetera apud nos recte <lb xml:id="p1z26"/>se habent, nisi quod praedae latronum et <lb xml:id="p1z27"/>reliquiis ita bellicorum tumultuum passim iter <lb xml:id="p1z28"/>facientes quicunque exponuntur.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale, vir honora<lb xml:id="p1z29"/>ndissime.</s>
					<s n="12" xml:lang="la">Faxit deus, uti salvum ac incolumem <lb xml:id="p1z30"/>te iterum intueri mihi liceat.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l18">Augustae</placeName> 2. maii <lb xml:id="p1z31"/>1556.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Commenda me de meliori nota d. <persName ref="p1283">Gesnero</persName> <lb xml:id="p1z32"/>et amicis nostris.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z33"/>Tui ex animo observantissimus <lb xml:id="p1z34"/><persName ref="p8430">Raphael Seiler</persName> scripsit.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo fidelissimoque <lb xml:id="p2z2"/>divini praeconii ministro <lb xml:id="p2z3"/>domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z4"/>domino et amico <lb xml:id="p2z5"/>suo colendissimo.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
