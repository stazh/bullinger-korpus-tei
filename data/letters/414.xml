			<zone xml:id="p2z8-0" points="1859,2825 2197,2801 2399,2826 2444,2859 2450,2740 2384,2765 2257,2707 2109,2746 2048,2703 1946,2684 1858,2714">1864,2798 1893,2794 1923,2793 1952,2795 1982,2795 2011,2794 2041,2792 2070,2794 2100,2796 2129,2798 2159,2800 2189,2800 2218,2796 2248,2797 2277,2799 2307,2801 2336,2801 2366,2801 2395,2801 2425,2799 2455,2798</zone>
