	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Min früntlich, willig dienst, samptt was ich <lb xml:id="p1z2"/>liebs unnd gutts vermag, zuvor, frommer, ersammer, <lb xml:id="p1z3"/>hochgelertter, lieber herr vetter.</s>
					<s n="2" xml:lang="de">Ich hab <lb xml:id="p1z4"/>uß üwerm, ouch uß mines bruͦders <persName ref="p20470">Davidenn</persName> <lb xml:id="p1z5"/>schrybenn erlernett, mitt was frünttlichem, <lb xml:id="p1z6"/>gnädigem unnd vätterlichem gneigttem willenn <lb xml:id="p1z7"/>ir ine inn üwer huß empfanngen, daselbs <lb xml:id="p1z8"/>manchen tag wie üwer eigen khind, biß <lb xml:id="p1z9"/>ir ime underschlouff gebenn, uff üwern <lb xml:id="p1z10"/>costenn ganntz unverdienter dinngen enthalltte<lb xml:id="p1z11"/>n.</s>
					<s n="3" xml:lang="de">Deßhalb nun min mütt<lb xml:id="p1z12"/>erli <lb xml:id="p1z13"/>unnd ich üch deß höchstenn, früntlichesten <lb xml:id="p1z14"/>danck sagen unnd wüssenn mitt erpiettung, <lb xml:id="p1z16"/>sölichs, wo ienen<note xml:id="fn1" type="footnote" n="1">irgendwie.</note> moglich, umb üch old <lb xml:id="p1z17"/>die üwernn mitt gneigttem willenn ze ver<lb xml:id="p1z18"/>dienenn, hiemitt üwern bevelch unnd <lb xml:id="p1z19"/>willenn iemerdar erwarttennde.</s>
				</p>
				<p>
					<s n="4" xml:lang="de" ana="salute">Ich <lb xml:id="p1z20"/>hab üwere grüß ußgricht, unnd lassen <lb xml:id="p1z21"/>dieselbigen üch hinwiderum früntlich <lb xml:id="p1z22"/>grüssenn unnd danncken.</s>
					<s n="5" xml:lang="de">Der allmechtig, <lb xml:id="p1z23"/>eewig, güttig gott verliche unns allen s<lb xml:id="p1z24"/>in gnad.</s>
				</p>
				<p>
					<s n="6" xml:lang="de">Datum 22<lb xml:id="p1z25"/>ten Januarij 1549.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z26"/><placeName ref="l41">Bernae</placeName>.</s>
					<s n="8" xml:lang="de">Ü[<lb xml:id="p1z27"/>wer] g[antz] w[illiger] vetter <lb xml:id="p1z28"/><persName ref="p4055">Hanns Zechennder</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="9" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem frommen, wysen, hoch<lb xml:id="p2z2"/>gelertten herren meister <lb xml:id="p2z3"/><persName ref="p495">Heinrich Bullinger</persName>, <lb xml:id="p2z4"/>vorstennder der kilchen <lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName>, sinem insonnde[rs] <lb xml:id="p2z6"/>lieben und gün[stigen] <lb xml:id="p2z7"/>vetteren<lb xml:id="p2z8"/>.</s>
				</p>
			</div>
		</body>
	</text>
