	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Puto te vidisse, que in mentem mihi venerant de regis institutione.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Tuum iudicium expecto avidissime.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Percommode accidit, quod <persName ref="p18090">rex Navarre</persName> <lb xml:id="p1z3"/>19. huius mensis venit in aulam regis; illi, spero, tuum scriptum communicabit <lb xml:id="p1z4"/><placeName>Gallice</placeName> versum.</s>
					<s n="5" xml:lang="la">Conestabilem puto ab aula discessisse.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><persName>Rex Remos</persName> petiit <lb xml:id="p1z5"/>pro unctione et inauguratione.</s>
					<s n="7" xml:lang="la">20. huius mensis imperator <placeName ref="l546">Viennam</placeName> petiit <lb xml:id="p1z6"/>et principes omnes abiere.</s>
					<s n="8" xml:lang="la">Obiit papa 18. huius mensis [<persName>Paul IV.</persName> mort. 18. Aug. 1559]</s>
					<s n="9" xml:lang="la">Nihil <lb xml:id="p1z7"/>prętermittam, ut magistro <persName>Ciconię</persName> maneat posta; nam alii expungetur stipendiis, cum illorum <lb xml:id="p1z8"/>opera opus non sit pacis tempore.</s>
					<s n="10" xml:lang="la" ana="salute">Salutabis amicos omnes.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l760">S[oluturi]</placeName> <lb xml:id="p1z9"/>28. augusti.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z10"/>Tuus ex animo, quem nosti.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. H[enrico] Bull[ingero].</s>
				</p>
			</div>
		</body>
	</text>
