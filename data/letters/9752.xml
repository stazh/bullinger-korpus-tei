			<graphic xml:id="img2-0" url="https://media.sources-online.org/cantaloupe/iiif/3/bullinger!9752!Autograph!01%20Ms%20F%2037%20%28337%29_00002.tif/full/max/0/default.jpg" n="2">
				<desc subtype="path">9752/Autograph/01 Ms F 37 (337)_00002.tif</desc>
			</graphic>
		</surface>
