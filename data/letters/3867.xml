	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Qui hic ad tuam humanitatem venit, vir est nacione Hebraeus, <lb xml:id="p1z2"/>eruditioni, qua quidem Hebraei nostra tempestate pollent, quan<lb xml:id="p1z3"/>tum mea tenuitas assequitur, admodum praestans, et qui nomine <lb xml:id="p1z4"/>eo plane commendatissimus esse debeat doctioribus.</s>
					<s n="3" xml:lang="la">Deinde, quod <lb xml:id="p1z5"/>maximum est, ex infideli factus est christianus, in cuius rei <lb xml:id="p1z6"/>evidens testimonium sacri baptismatis aqua etiam est ablutus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Quanti factus olim in <placeName ref="l834">Italia</placeName> sit, declarant literae, quas vel <lb xml:id="p1z8"/>ab ipso impietatis capite, <placeName ref="l425">Romano</placeName> inquam pontifice, huiusque princip<lb xml:id="p1z9"/>ibus habet, apud quos maximus esse potuisset, si voluisset.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Ego certe memor Pauli apostoli verborum: "Debitores illorum <lb xml:id="p1z11"/>sumus" etc.</s>
					<s n="6" xml:lang="la">Rom. 15. iudico eum commendatum esse debere cum <lb xml:id="p1z12"/>christianis omnibus, tum maxime linguarum studiosis, etiamsi <lb xml:id="p1z13"/>praeter Hebraicam linguam et Italicam nullam satis teneat.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Sed nae ineptus ego, qui tot tibi, qui audire et iudicare poteris <lb xml:id="p1z15"/>ipsum.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Caeterum, cum invenero nuncium, librum filii <lb xml:id="p1z16"/>nostri a te auferam; refert enim mihi d. <persName ref="p8009">Fabricius</persName> noster <lb xml:id="p1z17"/>iam paratum esse.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Vale in domino Iesu, vir longe do<lb xml:id="p1z18"/>ctissime, et <persName ref="p8359">Philippum</persName> tuum redamare perge.</s>
					<s n="10" xml:lang="la">Ex <placeName ref="l98">Curia</placeName> <lb xml:id="p1z19"/>die 20. februarii anni 1559.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/>Tuae integritatis totus <persName ref="p8359">Philippus Gallicius</persName>.</s>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vere magno viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>domino sibi et <lb xml:id="p2z4"/>bonis omnibus longe <lb xml:id="p2z5"/>colendissimo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
