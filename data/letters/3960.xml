	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Gratas tibi esse literas, quas misi, vehementer <lb xml:id="p1z2"/>gaudeo, mi d. <persName ref="p495">Bullingere</persName>, nec est, quod <lb xml:id="p1z3"/>tam officiose gratias agas, quum tibi adhuc longe <lb xml:id="p1z4"/>plura debere me ingenue agnoscam ac fateri <lb xml:id="p1z5"/>non erubescam, daboque etiam in posterum operam, si quid <lb xml:id="p1z6"/>ex nostris tibi non ingratum fore existimavero, ut <lb xml:id="p1z7"/>meum erga te animum declarem.</s>
					<s n="3" xml:lang="la">De <persName>Davidicis</persName> etiam <lb xml:id="p1z8"/>apud nos mira ferebantur, antequam ipsius <persName>Da<lb xml:id="p1z9"/>vidis Georgii</persName> cadavere exhumato et publice (una cum <lb xml:id="p1z10"/>non parvo librorum ipsius tam manuscriptorum <lb xml:id="p1z12"/>quam excusorum acervo et effigie elegantissime depicta) <lb xml:id="p1z13"/>combusto tanquam catastrophe huic fabulę <lb xml:id="p1z14"/>est imposita simulque etiam ipsis eius reliquiis <lb xml:id="p1z15"/>frenum iniectum et rumoribus illis tanquam igni <lb xml:id="p1z16"/>subducta materia.</s>
					<s n="4" xml:lang="la">Certe tantum mihi domesticę <lb xml:id="p1z17"/>occupationes facessunt negotii, ut neque articulis illius, <lb xml:id="p1z18"/>cum praelegerentur publice, neque actui illi, cum de cadavere <lb xml:id="p1z19"/>illud quasi supplicium sumeretur, interesse potuerim, et <lb xml:id="p1z20"/>ab aliis melius te illa intelligere posse non dubito.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z21"/>Sollicitabo tamen d. <persName>Iunium</persName>, ut per ocium de his aliquid <lb xml:id="p1z22"/>ad te scribat.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Nos in Apocalypsi tua paulatim pergim<lb xml:id="p1z23"/>us simulque apud <persName>Brilingerum</persName> curamus martyrum <lb xml:id="p1z24"/>nostri temporis historiam a <persName ref="p1145">Foxo</persName> descriptam excudi; sed <lb xml:id="p1z25"/>desideramus non pauca.</s>
					<s n="7" xml:lang="la">Proinde, si quid ad hanc rem <lb xml:id="p1z26"/>iuvare nos posses, rem gratissimam faceres, si per occasionem <lb xml:id="p1z27"/>communicares.</s>
					<s n="8" xml:lang="la">Vix haec respondere ad tuas licuit; proinde <lb xml:id="p1z28"/>oro, ut ignoscas et boni consulas.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="10" xml:lang="la">19. maii 1559.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z29"/><persName ref="p8126">Ioannes Oporinus</persName> <lb xml:id="p1z31"/>tuus ex animo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Optimo atque doctissimo <lb xml:id="p2z2"/>viro d. <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bullingero</persName>, ecclesia<lb xml:id="p2z4"/>stae <placeName ref="l587">Tigurino</placeName>, <lb xml:id="p2z5"/>domino et amico <lb xml:id="p2z6"/>suo in primis <lb xml:id="p2z7"/>colendo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
