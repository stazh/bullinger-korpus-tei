	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Georg, grave zu Würtembero
					<lb xml:id="p1z2"/>unnd zuMümpelgart.
					<lb xml:id="p1z3"/>Unnsern grus zuvor, lieber besonder, r
					<lb xml:id="p1z4"/>ubersenden euch gnädiger mainung lierenn
					<lb xml:id="p1z5"/>verwartezeittungenDie wollen allso
					<lb xml:id="p1z6"/>doch unser gder das sie euch von uns zukomen
					<lb xml:id="p1z7"/>unvermerckt) imn pestem uffnemen, dann
					<lb xml:id="p1z8"/>wir euch die wie sie an uns gelaudt mitthailen
					<lb xml:id="p1z9"/>Der allmächtig wolle es allenthalben zu seinem
					<lb xml:id="p1z10"/>robrichten, wolten wir euch, dern wir
					<lb xml:id="p1z11"/>in gronen genaigt, gnädiglich nit verhaltten, das
					<lb xml:id="p1z12"/>Basel den 1. aprilis annoet. .
					<lb xml:id="p1z13"/>Jht Wyrtteberg .
					<lb xml:id="p1z14"/>.
					<pb/>
					<lb xml:id="p2z1"/>Unserm lieben besondern Hain
					<lb xml:id="p2z2"/>Bullinger, predigern zu
					<lb xml:id="p2z3"/>Zurich.
				</p>
			</div>
		</body>
	</text>
