	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Nescio, qua in re tot beneficia in <lb xml:id="p1z2"/>me collata rependam.</s>
					<s n="3" xml:lang="la">Perplacent omnia, quę in tomo isto dedisti.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z3"/>Praefationem de concilio futuro adiecisti, quae veritatem ipsam in se <lb xml:id="p1z4"/>continet, etsi Caesarea constitutio omnibus liberum accessum praescribat <lb xml:id="p1z5"/>et iuxta conscientiam et scripturas divinas argumentandi locum concedat.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Sed sic capiuntur vulpes.</s>
					<s n="6" xml:lang="la">Papa nostrates suos vocat; <persName>Caesar</persName> omnibus <lb xml:id="p1z7"/>liberam confessionem admittit; sed cupio videre, quę tu scribas <lb xml:id="p1z8"/>de concilio futuro, et que spes sit piis habenda de istis, qui destinato <lb xml:id="p1z9"/>animo sunt fidei hostes et evangelii persecutores.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Novi habeo nihil, quod nunc scribam; omnia cum silentio aguntur <lb xml:id="p1z11"/>tandemque erumpent.</s>
					<s n="8" xml:lang="de"><foreign xml:lang="la">Hoc autem spargunt quidam:</foreign> <lb xml:id="p1z12"/>Es sol <persName>herzog Heinrich</persName> ein buren gfangen haben; derselbig soll <lb xml:id="p1z13"/>hirtzen geschossen haben.</s>
					<s n="9" xml:lang="de">Diser ist furgestelt: das urteil ist gefallen, <lb xml:id="p1z14"/>mann soll inn eim hirtzen uff die hoerner bynden und yn lassen <lb xml:id="p1z15"/>louff.</s>
					<s n="10" xml:lang="de">Mann hat ein grossen hirtzen gfangen, den buren doruff <lb xml:id="p1z16"/>gebunden, den hirtzen lassen in wald louffen; <foreign xml:lang="la">insequuti sunt <lb xml:id="p1z17"/>equites et non potuere ullum vestigium viri excussi vel perditi invenirea</foreign></s>
					<s n="11" xml:lang="la"><lb xml:id="p1z18"/>En crudelitatem incendiarii illius, quem dominus tandem ad tartara usque <lb xml:id="p1z19"/>deiiciet.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z20"/>Indicem librorum perfectis nundinis mittam.</s>
					<s n="13" xml:lang="la">Capitis dolores <lb xml:id="p1z21"/>vehementissimos nostri sentiunt et multi animum exhalant, etsi <lb xml:id="p1z22"/>variis medicaminibus utantur.</s>
					<s n="14" xml:lang="la"><persName ref="p8418">Myconius</persName> noster parum convaluit, <lb xml:id="p1z23"/>quod a <persName>Iacobo</persName> accipies fusius.</s>
					<s n="15" xml:lang="la" ana="farewell">Vale.</s>
					<s n="16" xml:lang="la"><placeName ref="l28">Basileę</placeName> 12. martii <lb xml:id="p1z24"/>1551.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z25"/>Salutabis nomine meo d. <persName ref="p8171">Bibliandrum</persName>, cui brevi scribam <lb xml:id="p1z26"/>fusissime variis de rebus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z27"/>T[uus] <persName ref="p1278">Gastius</persName> <lb xml:id="p1z28"/>ex animo.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z29"/>Raptim.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Docto et pio <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> e<lb xml:id="p2z4"/>cclesiae pastori vigilanti<lb xml:id="p2z5"/>ssimo, praeceptori <lb xml:id="p2z6"/>suo charissimo.</s>
				</p>
				<p>
					<s n="21" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>