	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Erbii vices doleo et dudum in hoc sum
					<lb xml:id="p1z2"/>qu pacto illi consulatur, non video tamen rationes, quibu
					<lb xml:id="p1z3"/>possit, spes erat, quod illo functio aliqua
					<lb xml:id="p1z4"/>ecclesiastica posset obvenire autm apud Tigurinos
					<lb xml:id="p1z5"/>t serenates, sed postruiqum vertumque confrendis
					<lb xml:id="p1z6"/>ecclesiasticis functionibus una eallemque ratio
					<lb xml:id="p1z7"/>habeatur vireor aegre fuca possit, ut aliquot
					<lb xml:id="p1z8"/>stipendium in illum conferatur. Deinde quid
					<lb xml:id="p1z9"/>ab hiis, quibus bonorum ecclesia cura demandat
					<lb xml:id="p1z10"/>est liberalitatis expectandum sit, inscio, praecertim
					<lb xml:id="p1z11"/>qui illos novumque trnaciores erga domisices
					<lb xml:id="p1z12"/>comperiantur, quid ergo in alienos ipsisque
					<lb xml:id="p1z13"/>ignotos profundant. Ego quod unum potui
					<lb xml:id="p1z14"/>pro mea tenuitate dudum obtuli tectutu vidiu.
					<lb xml:id="p1z15"/>et mensam quousque doinus melius illi proser
					<lb xml:id="p1z16"/>Ante tres fere menses per occasionem
					<lb xml:id="p1z17"/>locutus sum cum nonnullis principum consiliarii
					<lb xml:id="p1z18"/>illi optima quoque de Erbro pollicebant ad
					<lb xml:id="p1z19"/>quidem deferri illum plus aequo anxium et
					<lb xml:id="p1z20"/>solicitu esse quasi illi aliquid mali intrclao
					<lb xml:id="p1z21"/>et ad conprobandum illorum institutum cogendus
					<lb xml:id="p1z22"/>sit hoc tu esi vera non esse, imo omnes maximopuu
					<lb xml:id="p1z23"/>cupie, ut apud si maneat, utatur fruatu
					<lb xml:id="p1z24"/>hiis, que ad usum suum necessarium designata
					<lb xml:id="p1z25"/>Suns unicum hoc caveat, posteque iust
					<lb xml:id="p1z26"/>illorum publice adprobare nolit nusquam
					<lb xml:id="p1z27"/>calumietur, si hoc prestet immunitatem sibi
					<lb xml:id="p1z28"/>esse paratam, num illa tantum sint autira
					<lb xml:id="p1z29"/>verba in medio relinquo aut quid porro
					<lb xml:id="p1z30"/>intrim mutatu sit, sci non possum.
					<lb xml:id="p1z31"/>intra paucos dies Basileam proficisciat ibi
					<lb xml:id="p1z32"/>perserutabor, quomodo se res habeat
					<pb/>
					<lb xml:id="p2z1"/>Inter magistratum nostrum et Saloudum in
					<lb xml:id="p2z2"/>deliberatione venit, quibus rationibus contro
					<lb xml:id="p2z3"/>vcesia possit placide componi, Sabousus
					<lb xml:id="p2z4"/>proposuit arbitros utrumque regem et Galliarum
					<lb xml:id="p2z5"/>et Hispaniarum, quos Beenatis, ut suspectos
					<lb xml:id="p2z6"/>repudiarunt et vicissim proposuerunt
					<lb xml:id="p2z7"/>undecim Cantonibus Helvetiorum, quos ipse
					<lb xml:id="p2z8"/>propter Foederis coniunctione non possit feres
					<lb xml:id="p2z9"/>demonstravit, iam hoc suxum volvitur.
					<lb xml:id="p2z10"/>quid praeterea actum sit, nondum accepimus.
					<lb xml:id="p2z11"/>Vale in Christo. Datum Bruges 22. februarii
					<lb xml:id="p2z12"/>anno
					<lb xml:id="p2z13"/>hartman von Halmyt
					<pb/>
					<lb xml:id="p4z1"/>theologo, domino
					<lb xml:id="p4z2"/>Heinricho Bullingero,
					<lb xml:id="p4z3"/>domino et amico colendissimo.
				</p>
			</div>
