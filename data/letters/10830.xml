					<msContents>
						<summary>
							<p xml:id="regest1">Da ihr Pfarrer <persName ref="p2813" cert="high">Peter [Rümeli]</persName> seinen Rücktritt zurückgenommen hat und da [<persName ref="p7598" cert="high">Markus von Knöringen</persName>], der Abt des Klosters <placeName ref="l1017" cert="high">Reichenau</placeName> [und Kirchherr in <placeName ref="l159" cert="high">Frauenfeld</placeName>], durch Obervogt <persName ref="p17834" cert="high">Burkard von Dankenschweil</persName> sein Einverständnis gegeben hat, bitten sie nun auch <placeName ref="l587" cert="high">Zürich</placeName>, ihnen <persName ref="p2813" cert="high">Rümeli</persName> zu belassen.</p>
						</summary>
