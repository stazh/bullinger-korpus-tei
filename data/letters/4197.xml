	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Habeo tibi gratiam, compater in domino charissime, quod <lb xml:id="p1z2"/>in ipsis occupationibus tuis petitioni meę deesse <lb xml:id="p1z3"/>noluisti.</s>
					<s n="3" xml:lang="la">Placet consilium tuum; nam et ipse ad <lb xml:id="p1z4"/><persName ref="p8101">Lelium</persName> nostrum eadem scripsi, timendum videlicet esse, <lb xml:id="p1z5"/>ne <persName ref="p8282">Max[imiliano]</persName> rem magis ingratam quam gratam <lb xml:id="p1z6"/>facerem propter parentem et forsan mihi quoque <lb xml:id="p1z7"/>nescio quid turbarum concitem.</s>
					<s n="4" xml:lang="la">Quare persto in <lb xml:id="p1z8"/>eo, quod de <persName ref="p8060">Palatino</persName> cogitavi propter singulares <lb xml:id="p1z9"/>quasdam causas, quae mihi cum <placeName ref="l2477">Palatinatu</placeName> intercedunt, <lb xml:id="p1z10"/>sub quo vixi, priusquam me Christus servator per <lb xml:id="p1z11"/>evangelii sui lucem et gratiam e tenebris papisticis <lb xml:id="p1z12"/>evocavit.</s>
					<s n="5" xml:lang="la">Poteram ex <persName ref="p8399">Wilhelmo</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8399">Klebitz</persName>.</note>, diacono <placeName ref="l210">Heidelbergensi</placeName>, <lb xml:id="p1z13"/>cum hic esset, abunde rescire omnia ad hanc <lb xml:id="p1z14"/>causam necessaria, sed neglexi tam commodam <lb xml:id="p1z15"/>occasionem, quia tum nondum constitueram, quid <lb xml:id="p1z16"/>facerem.</s>
					<s n="6" xml:lang="la">Impetravit ille a senatu nostro literas <lb xml:id="p1z17"/>ad electorem, interea tamen ne verbum quidem scripsit, <lb xml:id="p1z18"/>ut nesciamus, quomodo et ubi iam agat; <lb xml:id="p1z19"/>si quid de illo habes, oro, significes.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z20"/>De strena praesentis anni, quam communi nostro filiolo <lb xml:id="p1z21"/><persName ref="p2207">Ioanni Heinricho</persName> pro benevolentiae tuae more misisti, <lb xml:id="p1z22"/>iam tertio scribo; quare vehementer miror, <lb xml:id="p1z23"/>quonam, quas ad te misi, pervenerint <lb xml:id="p1z24"/>meę literae.</s>
					<s n="8" xml:lang="la">Quicquid sit, ago tibi una cum illo, <lb xml:id="p1z25"/>quas possumus maximas gratias, et oramus dominum, <lb xml:id="p1z26"/>ut, quod facis, ad centesimum usque vitę tuę annum <lb xml:id="p1z27"/>facias.</s>
					<s n="9" xml:lang="la" ana="farewell">Optime vale, compater charissime.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute"><lb xml:id="p1z28"/>Salutem opto toti domui tuę.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Salutant te ac tuos <lb xml:id="p1z29"/>mei omnes.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1560. <lb xml:id="p1z30"/>22. ianuarii.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z31"/><persName ref="p8417">Wolfg[angus] Musculus</persName>, compater <lb xml:id="p1z32"/>tuus in domino.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>domino ac compatri suo <lb xml:id="p2z4"/>longe charissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
