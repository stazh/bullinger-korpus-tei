	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia filii dei tecum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Venit ad me mu<lb xml:id="p1z2"/>lier illa stans in procinctu, adeo ut plura <lb xml:id="p1z3"/>scribere nequiverim.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Sed haec paucis: Ecclesia <lb xml:id="p1z4"/>nostra salva est cottidieque gliscit, <lb xml:id="p1z5"/>reformata, quantum attinet ad sanam <lb xml:id="p1z6"/>doctrinam et administrationem sacramentorum, <lb xml:id="p1z7"/>ad modulum vestrę ecclesie.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Faxit deus, <lb xml:id="p1z8"/>ut perseveremus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Heri mortuus est <persName ref="p21254">Adam Diem</persName>, <lb xml:id="p1z9"/>cancellarius, pietatis et scholę adversarius, <lb xml:id="p1z10"/>et ni matrona dei auxilio constanter <lb xml:id="p1z11"/>restitisset, dudum actum fore de religione.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Non est, ut plura scribam de moribus <lb xml:id="p1z13"/>illius, ne videar mortuis detrahere.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Gratulantur, imo triumphant omnes cives, <lb xml:id="p1z15"/>quasi ex carcere liberati essent etc.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Herus noster forte cum Caesare hiemabit; est <lb xml:id="p1z17"/>enim sesquimenses, quod abiit.</s>
				</p>
				<p>
					<s n="9" xml:lang="de">Wir hoffen <lb xml:id="p1z18"/>all, er soll der religion halber ettwaß <lb xml:id="p1z19"/>wyters erlangen etc.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Vale sospiter, vale ter <lb xml:id="p1z20"/>quaterque, saluta fratres.</s>
