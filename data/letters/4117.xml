	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><placeName ref="l646">Claronenses</placeName> non pugnant neque ex iis ulli ceci<lb xml:id="p1z2"/>derunt.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Ita vero res habet: intestina dissentio eis <lb xml:id="p1z3"/>nocet; omne malum ex ipsis.</s>
					<s n="4" xml:lang="la">Dudum convenerunt cum <lb xml:id="p1z4"/>5 Pagicis certis conscriptis capitibus pacis.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">In his polliciti <lb xml:id="p1z5"/>sunt se habituros missificem <placeName>Schwandaenae</placeName>, ita tamen <lb xml:id="p1z6"/>ut nemo, qui non sponte accedat missam, vi adigatur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z7"/>Cum autem nemo in toto illo coetu sit, qui missam <lb xml:id="p1z8"/>sibi celebrari velit, factum est, ut nullum conduxerint <lb xml:id="p1z9"/>missificem.</s>
					<s n="7" xml:lang="la">Hinc <persName>Pagi</persName> coeperunt conqueri et quidam <lb xml:id="p1z10"/>ex his turbulenti minari nescio quid.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Constititum <lb xml:id="p1z11"/>ergo aiunt a senatu <placeName ref="l646">Claronensi</placeName> missificem ita, ut conven<lb xml:id="p1z12"/>erat olim mox ab infelici bello nostro <placeName>Cappellano</placeName>.</s>
					<s n="9" xml:lang="la">Interim <lb xml:id="p1z13"/>nemo accedit missam palamque profitentur se nullo <lb xml:id="p1z14"/>modo accessuros.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Haec summa est totius huius negotii.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Ex <lb xml:id="p1z15"/><placeName ref="l2472">Polonia</placeName> venit ad nos superioribus diebus minister d. <persName ref="p8041">Ioan[nis] <lb xml:id="p1z16"/>a Lasco</persName>, qui nunciaret, quid fieret in <placeName ref="l2472">Polonia</placeName>.</s>
					<s n="12" xml:lang="la">Decumbit <lb xml:id="p1z17"/>quidem ex gravi morbo d. <persName ref="p8041">Lascus</persName>; sed egregie pr<lb xml:id="p1z18"/>ocedit religio vera.</s>
					<s n="13" xml:lang="la">Quid quod illa quoque per <placeName ref="l882">Hungariam</placeName>, <lb xml:id="p1z19"/>etiam per illam, quae bassis subest <placeName ref="l2510">Turcicis</placeName>, celeriter currit <lb xml:id="p1z20"/>et recipitur ab innumeris.</s>
					<s n="14" xml:lang="la"><placeName ref="l673">Minor Polonia</placeName> nunc <lb xml:id="p1z21"/>peste vexatur.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l2574">Livonienses</placeName> subdiderunt se regi <persName>Polonorum</persName>, <lb xml:id="p1z22"/>qui nunc <placeName ref="l552">Vilnae</placeName> est.</s>
					<s n="16" xml:lang="la"><persName>Palatinus Vilnensis</persName> pro<lb xml:id="p1z23"/>greditur subinde sene ipso fortior.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Legatus papae <placeName ref="l260">Craco<lb xml:id="p1z24"/>viae</placeName> per pestem est extinctus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Scribit d. <persName ref="p1936">Franciscus Lysmanninus</persName> <lb xml:id="p1z25"/>tibi cognitus <persName ref="p3018">Franciscum Stancarum</persName> turbare prer<lb xml:id="p1z26"/>egrinis dogmatibus ecclesias <placeName ref="l2472">Polonicas</placeName>, sed exclusum esse <lb xml:id="p1z27"/>a synodo piorum ac repulsum.</s>
					<s n="19" xml:lang="la">Ex <placeName ref="l830">Anglia</placeName> nihil habemus <lb xml:id="p1z28"/>certi nunc, expectamus tamen varia.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Fama spargit filium <lb xml:id="p1z29"/>regis <persName>Svetiae</persName> nuptias reginae ambire.</s>
					<s n="21" xml:lang="la">Fama eadem <lb xml:id="p1z30"/>spargit <persName>Guysianos</persName> (qui nunc sunt reges <placeName ref="l832">Galliae</placeName>) pa<lb xml:id="p1z31"/>rasse peditatum 20000 peditum et iustum equitatum, quo <lb xml:id="p1z32"/>velint subigere <placeName ref="l2524">Scotos</placeName>.</s>
					<s n="22" xml:lang="la">Trevirorum urbs tumultuat<lb xml:id="p1z33"/>a dicitur ob praedicationem evangelii.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Fuit hic apud nos <lb xml:id="p1z34"/>vir pius et doctus doctor <persName>Casparus Olevitanus</persName> Trevir, <lb xml:id="p1z36"/>qui vocabatur illuc circa pascha in patriam, ubi Christum praedicare coepit.</s>
					<s n="24" xml:lang="la"><lb xml:id="p1z37"/>Vir est nobilis et rerum peritissimus.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Expectamus, <lb xml:id="p1z38"/>vivat an caesus sit.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">Fama spargit rem esse com<lb xml:id="p1z39"/>positam sine sanguine et cives obtinuisse evan<lb xml:id="p1z40"/>gelium.</s>
				</p>
				<p>
					<s n="27" xml:lang="la">Si alia accepero aut certiora, communicabo.</s>
					<s n="28" xml:lang="la"><lb xml:id="p1z41"/>Certum est illum isthic constantissime praedicare etc.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><lb xml:id="p1z42"/>Ora dominum, ut omnia bene vertat.</s>
				</p>
				<p>
					<s n="30" xml:lang="la">Quid habes de con<lb xml:id="p1z43"/>clavi, de papa et papaficibus a Romana urbe <lb xml:id="p1z44"/>aut ex <placeName ref="l834">Italia</placeName>?</s>
				</p>
				<p>
					<s n="31" xml:lang="la" ana="salute">Salvi sint amici nostri; salutant te mei.</s>
					<s n="32" xml:lang="la" ana="farewell"><lb xml:id="p1z45"/>Vale.</s>
					<s n="33" xml:lang="de">3. novembris 1559.</s>
				</p>
				<p>
					<s n="34" xml:lang="la" ana="salute"><lb xml:id="p1z46"/>Salvus sit d. legatus <lb xml:id="p1z47"/>etc.</s>
				</p>
				<p>
					<s n="35" xml:lang="la">Tuus H[einrychus] <lb xml:id="p1z48"/>B[ullingerus].</s>
				</p>
				<p>
					<s n="36" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p8009">Ioanni Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae <lb xml:id="p2z4"/>ministro, domino et fratri <lb xml:id="p2z5"/>suo charissimo.</s>
					<s n="37" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
