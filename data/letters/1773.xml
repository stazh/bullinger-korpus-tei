	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. <lb xml:id="p1z2"/>D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Scripsi nuper ad <persName ref="p8127">Pellicanum</persName>, avunculum meum colendissimum, me tuas ad <lb xml:id="p1z4"/><placeName ref="l830">Angliae</placeName> secretarium literas, vir clarissime, fidissimo nuntio <lb xml:id="p1z5"/><placeName ref="l491">Argentinam</placeName> misisse, quo te omni sollicitudine liberaret, cui tum desti<lb xml:id="p1z6"/>tutus tempore scribere nequaquam poteram nec habebam etiam, quod <lb xml:id="p1z7"/>epistola dignum esset.</s>
					<s n="3" xml:lang="la">Accepi autem <persName ref="p8111">Petri Mart<lb xml:id="p1z8"/>yris</persName> de negotio e<lb xml:id="p1z9"/>ucharistiae doctissimam tractationem, pro quo munere gratias <lb xml:id="p1z10"/>nunquam intermorituras ago, cum remunerandi facultate plane destituar.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z11"/>Obruis autem me tuis beneficiis adeo, ut, quo nomine magis devinctus <lb xml:id="p1z12"/>sim tua liberalitate ignorem; cupio tamen aliquando <lb xml:id="p1z13"/>dari occasionem mihi, qua nequaquam in hominem ingratum collocas<lb xml:id="p1z14"/>se beneficium deprehendere possis.</s>
					<s n="5" xml:lang="la">Sum modo valetudinarius, <lb xml:id="p1z15"/>qui iam per octiduum atrocissimis morbis, adhuc tamen incognitis, <lb xml:id="p1z16"/>divexatus sum adeo, ut finem mihi vitae instare plane semel <lb xml:id="p1z17"/>iterumque persuaserim; nulla experior pestis indicia, quae tamen <lb xml:id="p1z18"/>apud nos 2500 atque plures etiam absumpsit per biennium.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z19"/>Morbus tamen circa praecordia interdum est tam atrox, ut repentino <lb xml:id="p1z20"/>eius recursu ad multos me clamores urgeat atque sudore<lb xml:id="p1z21"/>m ubique expellat, mox totus evanescit impetus atque <lb xml:id="p1z22"/>doloris improbitas omnis longe amovetur.</s>
					<s n="7" xml:lang="la">Nunc tamen <lb xml:id="p1z23"/>ex dei benignitate iterum convalui atque nullas plane dolores <lb xml:id="p1z24"/>sentio; expecto tamen singulis horis, quando morbus recurrat <lb xml:id="p1z25"/>suaque rabie me divexet.</s>
					<s n="8" xml:lang="la">Novarum rerum nihil habeo; sed <lb xml:id="p1z26"/>typographos nostros expecto, qui post biduum ex nundinis <lb xml:id="p1z27"/><placeName ref="l157">Francfordianis</placeName> redibunt; qui si boni quidpiam nobis <lb xml:id="p1z28"/>attulerint, tecum lubenter (si valetudinem dominus <lb xml:id="p1z29"/>redonaverit sua benignitate) communicabo.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z30"/><placeName ref="l28">Basileae</placeName> 4. decembris anno 1552.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z31"/>T[uus] <persName ref="p8406">Conradus Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietate atque eruditione inprimis <lb xml:id="p2z2"/>claro viro d. <persName ref="p495">Heinricho <lb xml:id="p2z3"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>pastori vigilantissimo, <lb xml:id="p2z5"/>amico incomparabili.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
