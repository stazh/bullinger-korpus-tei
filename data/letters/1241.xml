	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nudiustertius tuas, venerande compater, <lb xml:id="p1z2"/>per <placeName ref="l832">Gallos</placeName> illos nobiles accepi et habeo tibi gratias <lb xml:id="p1z3"/>pro tuo in me studio.</s>
					<s n="3" xml:lang="la">Quod <persName ref="p8417">Musculum</persName> <lb xml:id="p1z4"/>convenit, nuncio tibi laeta, quae scio tibi <lb xml:id="p1z5"/>non minus quam mihi gaudio futura esse; <lb xml:id="p1z6"/>heri enim senatui librum suorum in Ps[almos] commentario<lb xml:id="p1z7"/>rum obtuli et commendavi, prius quoque pri<lb xml:id="p1z8"/>vatim singulis ferme senatoribus ea de re <lb xml:id="p1z9"/>instructis.</s>
					<s n="4" xml:lang="la">Susceperunt gratulanter eique <lb xml:id="p1z10"/>pro honorario munere dedere 100 libras, praeterea <lb xml:id="p1z11"/>suo stipendio auctionem fecerunt 40 libras et dolium <lb xml:id="p1z12"/>vini <placeName>Ripensis</placeName>; videbatur enim illis bono s<lb xml:id="p1z13"/>eni optimum id vini genus competere; nulli enim <lb xml:id="p1z14"/>alias hactenus contigit, ut huius generis vinum ei <lb xml:id="p1z15"/>daretur.</s>
					<s n="5" xml:lang="la">Continet dolium 4 urnas nostrates; urna <lb xml:id="p1z16"/>100 mensuris, ut vocamus, constat, ita ut dolium <lb xml:id="p1z17"/>tale communiter ematur 10, 12 aut etiam 20 aliquando coronatis.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z18"/>In summa: res cecidit ex animi sententia, atque ipse <lb xml:id="p1z19"/>quoque optime est contentus.</s>
					<s n="7" xml:lang="la">Haec tibi per hunc n<lb xml:id="p1z20"/>uncium significare volui, qui quoniam iamiam <lb xml:id="p1z21"/>abit, plura non possum, nisi quod <persName ref="p8055">Blaureri</persName> <lb xml:id="p1z22"/>illa, quae scribis tibi a me non missa, inter omnia <lb xml:id="p1z23"/>mea inquirens invenire non potui ut proinde <lb xml:id="p1z24"/>omnino me misisse puto, quomodocunque tandem exciderint; <lb xml:id="p1z25"/>quaeram tamen amplius.</s>
					<s n="8" xml:lang="la">Ex <placeName ref="l832">Gallia</placeName> nihil habeo <lb xml:id="p1z26"/>interea certi; ubi habuero, scribam.</s>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z27"/>Vale <lb xml:id="p1z28"/>cum tuis omnibus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l41">Bernae</placeName> 11. aprilis <lb xml:id="p1z29"/>1551.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">T[<lb xml:id="p1z30"/>uus] <persName ref="p8018">I[oannes] Hallerus</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="de"><persName ref="p8417">Musuc<lb xml:id="p1z31"/>ulus</persName> hat an <lb xml:id="p1z32"/>[pfennig] <lb xml:id="p1z33"/>120 <lb xml:id="p1z34"/>gulden, an dinckel <lb xml:id="p1z35"/>40 mutt, <lb xml:id="p1z36"/>an haber <lb xml:id="p1z37"/>10 mutt, <lb xml:id="p1z38"/>an lantwyn <lb xml:id="p1z39"/>10 soum, <lb xml:id="p1z40"/>an <persName>Ryffwyn</persName> <lb xml:id="p1z41"/>4 soum: <lb xml:id="p1z42"/>macht diß jar uff 220 gulden.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>fidelissimo antistiti, domino et <lb xml:id="p2z4"/>compatri suo colendissimo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
