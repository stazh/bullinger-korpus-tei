	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam a deo patre et domino nostro Iesu Christo <lb xml:id="p1z2"/>et annum hunc novum felicem tibi, observande mihi in domino pater, <lb xml:id="p1z3"/>ac tuis omnibus opto ex animo.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z4"/>Deinde scias, quod accepi literas tuas cum strena argentea, pro quibus maximas <lb xml:id="p1z5"/>tibi gratias habeo.</s>
					<s n="3" xml:lang="la">Diligenter custodio strenas, quas mihi misisti, volo eas <lb xml:id="p1z6"/>in memoriam paternę tuae benevolentiae per omnem meam vitam servare.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Tertio curabo etiam, ut secundum admonitionem tuam timeam deum et <lb xml:id="p1z8"/>obediam parenti meo ac matri et diligenter studeam.</s>
					<s n="5" xml:lang="la">Deus det mihi suam gratiam.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Commendo me tibi et peto, ut deum pro me ores; ego pro te quoque diligenter orabo.</s>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z10"/>Optime vale, charissime in Christo pater.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Salutant te parentes ac fratres mei.</s>
				</p>
				<p>
					<s n="9" xml:lang="de"><lb xml:id="p1z11"/>Datum <placeName ref="l41">Bernę</placeName> 1562.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z12"/><persName ref="p2207">Ioannes Heinricus Musculus</persName>, <lb xml:id="p1z13"/>obediens tuus in Christo <lb xml:id="p1z14"/>filius.</s>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Heinrico Bullingero</persName>, patri <lb xml:id="p2z3"/>meo in Christo omnium <lb xml:id="p2z4"/>charissimo et semper <lb xml:id="p2z5"/>observando.</s>
					<s n="12" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
