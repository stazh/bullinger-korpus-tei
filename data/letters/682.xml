	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Anno 49. ad 21. septembris franckfordiae.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>S. P.</s>
					<s n="3" xml:lang="la">Clarissime D. <persName ref="p495">Bullingere</persName>, binas tuas literas accepi, alteras in <placeName ref="l830">Angliam</placeName> misi, <lb xml:id="p1z3"/><persName ref="p3100">Floriano</persName> etiam tuas reddidi; sed insalutato me discessit, quod multis dolet; <lb xml:id="p1z4"/>si ad nos venerit, commonefaciam tuo nomine.</s>
					<s n="4" xml:lang="la">Dolemus reliquosque alios cum <placeName ref="l832">Gallo</placeName> i<lb xml:id="p1z5"/>niisse foedus.</s>
					<s n="5" xml:lang="la">Reverendissimus noster in ea in ea constantia perseverat; oramus deum, ut perseveret <lb xml:id="p1z6"/>usque ad finem.</s>
					<s n="6" xml:lang="la">Orarem tuam dominationem, ut ad illum scriberes et ut per dei gratiam in ea, qua est, <lb xml:id="p1z7"/>opinione maneat.</s>
					<s n="7" xml:lang="la" ana="salute">D. <persName ref="p536">Caesarius</persName> te, domine, salvere iubet.</s>
					<s n="8" xml:lang="la">Peto tuam opera in Biblia <placeName ref="l830">Anglicana</placeName>.</s>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z8"/>Saluta omnes pios viros.</s>
					<s n="10" xml:lang="la">Raptim.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z9"/>Tuus obseq[uens] <persName ref="p380">Ioannes Byrchmannus</persName> scr[ipsit].</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro D. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, domino observando.</s>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
