	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. et mentem quietam.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">De Cuͦnharto<note xml:id="fn1" type="footnote" n="1">Nicht weiter bekannt (vgl. auch <bibl source="b12">HBBW X</bibl> <ref target="file11482">[Nr. 1439]</ref>, S. 205, 24).</note> et hic rumor erat, dum latronum socius <lb xml:id="p1z2"/>ducebatur, occisum esse.</s>
					<s n="3" xml:lang="la">Verum hic confessus fuerat, ante annum iuvenem <lb xml:id="p1z3"/>a suis interfectum et septem coronatos secum habuisse, de his se partem suam <lb xml:id="p1z4"/>accepisse, non autem latronibus adfuisse.</s>
					<s n="4" xml:lang="la">Equidem mox: „Ergo Conhartus <lb xml:id="p1z5"/>ab his non est occisus.“</s>
					<s n="5" xml:lang="la">De ancilla<note xml:id="fn2" type="footnote" n="2">Unbekannt.</note> nihil est, quod ego audiverim.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><persName ref="p18538">Cęsar</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p18538">Karl V.</persName></note> <lb xml:id="p1z6"/>ab <placeName ref="l210">Heidelbergensibus</placeName> expectatus est diu, sed frustra, a <placeName ref="l471">Spirensibus</placeName> similiter; nam <lb xml:id="p1z7"/><persName ref="p18548">Palatinus</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p18548">Ludwig V.</persName>, Kurfürst von der <placeName ref="l2477">Pfalz</placeName>.</note> ceperat in illius adventum usque ad ducentas feras, et prohibitum <lb xml:id="p1z8"/>erat vendi<note xml:id="fna" type="footnote" n="a"><hi>Vor</hi> vendi <hi>ein gestrichenes, unlesbares Wort.</hi></note>, quicquid in macellum fertur.</s>
					<s n="7" xml:lang="la">Sed retrocessisse dicitur, <lb xml:id="p1z9"/>eo quod <persName ref="p18548">Palatinum</persName> acceperit concionatorem evangelicum a se habere;<note xml:id="fn5" type="footnote" n="5">Gemeint ist der Hofprediger <persName ref="p21361">Heinrich Stoll</persName> (vgl. <bibl source="b12">HBBW X</bibl> <ref target="file11484">[Nr. 1441]</ref>, S. 208, 18f mit Anm. 3).</note> nunc <lb xml:id="p1z10"/>autem ubi sit, ignoratur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Comitia nondum sunt renunciata, et constat <lb xml:id="p1z11"/>multos <placeName ref="l410">Ratisponae</placeName> sic se comparasse, ut, si<note xml:id="fnb" type="footnote" n="b">si <hi>über der Zeile nachgetragen.</hi></note> illa non procederent, redigerentur <lb xml:id="p1z12"/>ad mendicitatem.</s>
					<s n="9" xml:lang="la">Circumfertur hic forma cometę, quem dicunt ad<lb xml:id="p1z13"/>paruisse;<note xml:id="fn6" type="footnote" n="6">Vgl. <bibl source="b12">HBBW X</bibl> <ref target="file11481">[Nr. 1438]</ref>, S. 199, 41-44 mit Anm. 22.</note> quia vero <persName ref="p1365">Grynęus</persName> nihil ea de re scripsit, vilifacio.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/>De <persName ref="p18520">Palatino, Brandenburgensi</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p18520">Joachim II.</persName>, Kurfürst von <placeName ref="l1048">Brandenburg</placeName>.</note>, <persName ref="p18605">Clivensi</persName><note xml:id="fn8" type="footnote" n="8">Herzog <persName ref="p18605">Wilhelm von Jülich, Berg und Kleve</persName>.</note> et <persName ref="p8462">Coloniensi</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p8462">Hermann von Wied</persName>, Erzbischof von <placeName ref="l267">Köln</placeName>.</note> rumor etiam apud nos <lb xml:id="p1z15"/>est subscripsisse confessioni <placeName ref="l18">Augustanę</placeName> ipsos<note xml:id="fn10" type="footnote" n="10">Die Gesandten der drei erstgenannten Fürsten hatten sich in ihren Gutachten vom 15. Dezember positiv zur Confessio <placeName ref="l18">Augustana</placeName> geäußert; s. <bibl source="b71">ARCEG</bibl> III/1 310-323.</note>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">De colloquio<note xml:id="fn11" type="footnote" n="11"><persName ref="p8418">Myconius</persName> bezieht sich auf einen nicht erhaltenen Bericht über das <placeName ref="l569">Wormser</placeName> Kolloquium, den <persName ref="p1365">Grynäus</persName> am 13. Januar abgefasst hatte. <persName ref="p8418">Myconius</persName> verdankte das am 18. Januar eingetroffene Schreiben am selben Tag; s. Zürich ZB, Ms F 81, 366.</note>: Nostri, postquam nul<lb xml:id="p1z16"/>la via potuit inveniri ad colloquendum sana, libris omnibus inclusis ad abitu<lb xml:id="p1z17"/>m sese pararant.</s>
					<s n="12" xml:lang="la">Et ecce subito spiritus novus obsidet adversarios, <lb xml:id="p1z18"/>ut congredi velint<note xml:id="fnc" type="footnote" n="c">velint <hi>in der Vorlage korrigiert aus</hi> volint.</note>.</s>
					<s n="13" xml:lang="la">Tredecima igitur ianuarii notariis et substitutis <lb xml:id="p1z19"/>datur iuramentum; sequenti die inceptum est colloquium<note xml:id="fn12" type="footnote" n="12">Vgl. <bibl source="b480">PC</bibl> III 160f.</note>.</s>
					<s n="14" xml:lang="la">Initium est <lb xml:id="p1z20"/>de peccato originali.</s>
					<s n="15" xml:lang="la">Qua quidem de re tam probe, dicit <persName ref="p1365">Grynęus</persName>, instructos <lb xml:id="p1z21"/>fratres, ut speret ignorantiam et impietatem istorum in lucem facile protractum <lb xml:id="p1z22"/>iri posse.</s>
					<s n="16" xml:lang="la">Diem aut tres arbitratur disputationem duraturam ut<lb xml:id="p1z23"/>pote ceptam sub adventum cęsaris, ut citius dissolveretur, si<pb type="edition" next="36"/> venisset <lb xml:id="p1z24"/>eo.</s>
					<s n="17" xml:lang="la">Constat enim, quicquid agunt, fraudem esse; huc nanque tendit <lb xml:id="p1z25"/>omnis eorum conatus, ut Christus cum omni regno suo pellatur.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">De modo colloqui<lb xml:id="p1z26"/>i tametsi possem aliquid scribere, occupationes tamen in praesens non <lb xml:id="p1z27"/>sinunt.</s>
					<s n="19" xml:lang="la">Misit senatus <placeName ref="l491">Argentinensis</placeName> eam formulam nostris<note xml:id="fn13" type="footnote" n="13">Mehrere Dokumente aus den Verhandlungen über die Gesprächsformalitäten wurden von <persName ref="p6733">Jakob Sturm</persName> nach <placeName ref="l491">Straßburg</placeName> geschickt (s. <bibl source="b480">PC</bibl> III 158. 160f); offenbar teilte man sie auch dem <placeName ref="l28">Basler</placeName> Rat mit (vgl. auch den Bericht von <persName ref="p8374">Kaspar Hedio</persName> an <persName ref="p164">Bonifacius Amerbach</persName> vom 14. Januar in <persName ref="p164">Amerbach</persName>, Korr. V 315f).</note>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Equidem ubique <lb xml:id="p1z28"/>noto gratiam Christi fortiter hactenus adfuisse nostris.</s>
					<s n="21" xml:lang="la">Idem spero et <lb xml:id="p1z29"/>deinceps futurum; adeo sunt enim concordes, item et alacres, ut de <lb xml:id="p1z30"/>praesentia domini dubitare non liceat et de fiducia causę certitudo sit.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z31"/>Pręter hęc de literis communibus Helvetiorum ad cameram<note xml:id="fn14" type="footnote" n="14"><placeName ref="l28">Basel</placeName> hatte das Schreiben der <placeName ref="l862">Eidgenossen</placeName> wegen des Konflikts mit <persName ref="p20278">Johannes Fabri</persName> um die Dompropstei erbeten; vgl. <bibl source="b12">HBBW X</bibl> <ref target="file11480">[Nr. 1437]</ref>, S. 195f, 12-21.</note> res sic habet: Descriptę <lb xml:id="p1z32"/>sunt et missę iam in <placeName ref="l749">Saxoniam</placeName>, in <placeName ref="l1682">Misiam</placeName><note xml:id="fn15" type="footnote" n="15"><placeName ref="l1682">Meißen</placeName>.</note>, in <placeName ref="l213">Hassiam</placeName>, ad <placeName ref="l1048">Branden<lb xml:id="p1z33"/>burgens[em]</placeName>, ad omnes; nemo non petiit eas, et spes est magna exemplum <lb xml:id="p1z34"/>fore ad<note xml:id="fnd" type="footnote" n="d">ad <hi>über der Zeile nachgetragen.</hi></note> libertatem <placeName ref="l822">Germanię</placeName> sustinendam.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Insuper de novo rege scriberem, <lb xml:id="p1z35"/>nisi coniectarem vos iam pridem ea de re doctos<note xml:id="fn16" type="footnote" n="16">Im oben Anm. 11 erwähnten Brief schreibt <persName ref="p8418">Myconius</persName> etwas ausführlicher: "De novo rege ad episcopum <placeName ref="l28">Basiliensem</placeName> scriptum, qui Iudaeos sit repositurus in regnum. Nisi coniectarem fabulam vobis notam esse, non tederet me perscribere integram." Näheres ist dazu nicht bekannt.</note>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">De <persName ref="p20225">Gallo</persName><note xml:id="fn17" type="footnote" n="17"><persName ref="p20225">Franz I.</persName>, König von <placeName ref="l832">Frankreich</placeName>.</note> ru<lb xml:id="p1z37"/>mor est ex <placeName ref="l832">Gallia</placeName> defunctum esse.</s>
					<s n="25" xml:lang="la">Tandem consideremus, quam bonum sit et <lb xml:id="p1z38"/>iucundum fratres habitare in unum<note xml:id="fn18" type="footnote" n="18">Vgl. <cit type="bible"><ref>Ps 133, 1 (Vulg. 132, 1)</ref></cit>.</note>.</s>
					<s n="26" xml:lang="la" ana="salute"><persName ref="p1365">Grynęus</persName> quoties scribit, vos diligenter <lb xml:id="p1z39"/>salutat et te inprimis.</s>
					<s n="27" xml:lang="la">Cum legatis nostris<note xml:id="fn19" type="footnote" n="19">Gemeint sind <persName ref="p8349">Hans Rudolf Frey</persName> und <persName ref="p5269">Onofrius Holzach</persName>, die zur Tagsatzung vom 10. Januar nach <placeName ref="l21">Baden</placeName> reisten; vgl. <bibl source="b197">EA</bibl> IV/1d 3.</note> dimisi literas eius ad <lb xml:id="p1z40"/>vos;<note xml:id="fn20" type="footnote" n="20"><bibl source="b12">HBBW X</bibl>, <ref target="file11484">Nr. 1441</ref> (vgl. auch oben Nr. 1452, 1-3).</note> non scribis, an sint redditę.</s>
					<s n="28" xml:lang="la" ana="farewell">Vale cum tuis in Christo.</s>
					<s n="29" xml:lang="la">Literę sint communes <lb xml:id="p1z41"/>cum <persName ref="p8171">Theodoro</persName><note xml:id="fn21" type="footnote" n="21"><persName ref="p8171">Theodor Bibliander</persName>.</note>; utrique scribere non valui.</s>
				</p>
				<p>
					<s n="30" xml:lang="la">Raptim, <placeName ref="l28">Basileę</placeName>, 19. ianu<lb xml:id="p1z42"/>arii anno 1541.</s>
					<s n="31" xml:lang="la"><lb xml:id="p1z43"/><persName ref="p8418">Os. Myconius</persName> <lb xml:id="p1z44"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="32" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>in domino suo.</s>
					<s n="33" xml:lang="de"><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
