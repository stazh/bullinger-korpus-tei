	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuas accepi literas scriptas 20. et 25. decembris.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Hospitem <lb xml:id="p1z2"/><persName>Ciconie</persName> certiorem facio de mea voluntate, nec dubitare debes, <lb xml:id="p1z3"/>quin praestaturus sim, quę in mea erunt facultate; sed expectanda <lb xml:id="p1z4"/>opportunitas, ut cum regis bona gratia id fiat.</s>
					<s n="4" xml:lang="la">Heri literas recepi <lb xml:id="p1z5"/>a d. conestabili, qui rediit e captivitate.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Circa finem huius mensis <lb xml:id="p1z6"/>deputati debent convenire Cameraci, ut incoepta colloquia de <lb xml:id="p1z7"/>pace perficiant, et magna spes est pacis.</s>
					<s n="6" xml:lang="la">Turca maximos <lb xml:id="p1z8"/>facit apparatus contra <persName>Hangarium [Hungarium</persName>?]; verendum est, ne ea res comitia im<lb xml:id="p1z9"/>perialia impediat.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Scribo magistro poste etiam, ut ferat xenia <lb xml:id="p1z10"/>honestissimae matrone, quę filii hospes est et illi loco matris est.</s>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z11"/>Salutabis d. d. <persName ref="p8111">Martirem</persName> et <persName ref="p8011">Galterum</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Tibi illisque opto et familiis foelicem <lb xml:id="p1z12"/>annum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l760">Soluturi</placeName> 2. ianuarii.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z13"/>Tuus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z2"/>ecclesie <placeName ref="l587">Tigurine</placeName> pastori vigilantissimo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
