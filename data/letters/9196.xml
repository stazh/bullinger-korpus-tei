	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Ali pater, non prius discessurum senii nestru
					<lb xml:id="p1z2"/>Lochmannum, quam esset in procivetu
					<lb xml:id="p1z3"/>itaque nunc paulum scribo, ut me no
					<lb xml:id="p1z4"/>et tuais postrema et qua illis erant
					<lb xml:id="p1z5"/>adiuncta adeoque pecuniam illam
					<lb xml:id="p1z6"/>accepisse. Rupelle, Sancenae, Nomansi
					<lb xml:id="p1z7"/>et ubicunque supersunt ecclesiae
					<lb xml:id="p1z8"/>tibi significo res nostrorum optimo loco
					<lb xml:id="p1z9"/>esse. Brevi aute plura tamannes
					<lb xml:id="p1z10"/>usquead ore fauces pogus ressus,
					<lb xml:id="p1z11"/>renxit, quem morbium re
					<lb xml:id="p1z12"/>ipse crediderat. Bone vale, cum pater
					<lb xml:id="p1z13"/>Genevat, 6. felruarii 1573.
					<lb xml:id="p1z14"/>Tuus Beza.
					<pb/>
					<lb xml:id="p2z1"/>smmo Christi servo
					<lb xml:id="p2z2"/>D. Henrico Bullingero,
					<lb xml:id="p2z3"/>patri mihi plurimum.
					<lb xml:id="p2z4"/>pessvirandis u ulia i ri ie
					<lb xml:id="p2z5"/>
					<lb xml:id="p2z6"/>Prtiat  m.
					<lb xml:id="p2z7"/>siguruu.
					<lb xml:id="p2z8"/>E Pet   r hwer .
					<lb xml:id="p2z9"/>.
					<lb xml:id="p2z10"/>qu
					<lb xml:id="p2z11"/>
					<lb xml:id="p2z12"/>atim a u regu prodere aetirt
					<lb xml:id="p2z13"/>us  artia
					<lb xml:id="p2z14"/>i si us psisla e i um letur cirista
					<lb xml:id="p2z15"/>me  o mer
					<lb xml:id="p2z16"/>ssum  imu
					<lb xml:id="p2z17"/>
					<lb xml:id="p2z18"/>l llli ali.
					<lb xml:id="p2z19"/>ler .
				</p>
			</div>
		</body>
	</text>
