	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Quoniam certo persuasum habemus, domine et pater nobis modis omnibus <lb xml:id="p1z2"/>colendissime, tuam excellentiam et coniugem tuam, matrem inquam nostram longe chariss<lb xml:id="p1z3"/>imam, una cum dilectissima tota familia tua aeque desyderio nostri atque <lb xml:id="p1z4"/>nos vestri teneri et aliquid certi de statu profectionis nostrae scire velle <lb xml:id="p1z5"/>ideoque, quantum per otium licuit, aliquid vobis significandum duxi, nam <lb xml:id="p1z6"/>pluribus impediti praecipue vero in describendis adversae partis de negotio s. tri<lb xml:id="p1z7"/>ados scriptis in gratiam hic doctorum virorum, qui diligentia domini <persName ref="p8511">Tretii</persName> in<lb xml:id="p1z8"/>stigati ad scribendum <placeName ref="l2472">Polonicis</placeName> ecclesiis animum appulerunt, copiosiores dare <lb xml:id="p1z9"/>non licuit.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Scias itaque, mi pater colendissime, hactenus omnia nobis dei <lb xml:id="p1z10"/>beneficio ex animi sententia succedere.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Verum ut dominus opt. max. porro <lb xml:id="p1z11"/>nostrum hoc iter secundet, vestrum erit, ut pro nobis, ita ut coepistis, divinam <lb xml:id="p1z12"/>imploretis opem.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Plura propediem sumus <placeName ref="l491">Argentina</placeName> omnes scripturi, quam <lb xml:id="p1z13"/>cras summo mane navigio sumus profecturi.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute">Pueri nostri <persName>Stanislaus</persName> et <lb xml:id="p1z14"/><persName>Andreas</persName> cum <placeName ref="l2472">Polonis</placeName> hic <placeName ref="l28">Basiliensibus</placeName> occupati scribere nequiverunt, qui <lb xml:id="p1z15"/>plurimum vos omnes salutant deprecanturque, quod non scribant, veniam.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Iubemus <lb xml:id="p1z16"/>tuam excellentiam paternam una cum matre nostra amatissima et reliquos nostros optime val<pb/><lb xml:id="p2z1"/>ere.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Datae <placeName ref="l28">Basi<lb xml:id="p2z2"/>leę</placeName> 9. maii 1563.</s>
					<s n="9" xml:lang="la">Secunda noctis ex[a]rata.</s>
					<s n="10" xml:lang="la">Tuae eccellentiae paterna<lb xml:id="p2z3"/>e in omnibus obsequentissimus filius <lb xml:id="p2z4"/><persName ref="p8293">Laurentius Semlinus</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z5"/>Clarissimo et doctissimo viro domino <lb xml:id="p2z6"/><persName ref="p495">H[einrycho] Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z7"/>ecclesiae inspectori <lb xml:id="p2z8"/>diligentissimo, domino suo <lb xml:id="p2z9"/>perpetuo plurimum colendo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z10"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
