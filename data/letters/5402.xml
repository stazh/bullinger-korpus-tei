			<zone xml:id="p2z2-0" points="750,379 2342,412 2340,350 2292,342 1698,359 1400,315 1212,352 1136,311 969,344 750,303">761,367 840,361 919,361 998,361 1078,364 1157,367 1236,369 1315,367 1395,370 1474,370 1553,372 1632,373 1712,376 1791,376 1870,376 1949,379 2029,379 2108,382 2187,390 2266,389 2346,394</zone>
