	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Etsi novi  nihil habeo, quod scribam, nelii
					<lb xml:id="p1z2"/>tamen Linerum nosttrum sine meis ad te
					<lb xml:id="p1z3"/>literis pervenire. Ex eo cognosces quam
					<lb xml:id="p1z4"/>varia et quam vana lugdum ferantur
					<lb xml:id="p1z5"/>de pace. Quid vero sit cum nostris actu
					<lb xml:id="p1z6"/>us ad 28. martii, quid item nostri
					<lb xml:id="p1z7"/>responderint, spero istuc esse perlaturii
					<lb xml:id="p1z8"/>Comes lodoicus Nassovius, tracecto
					<lb xml:id="p1z9"/>Rhodano, cum aliquot equitum turnus
					<lb xml:id="p1z10"/>et pedibus echertibus, fertur Monlimardum
					<lb xml:id="p1z11"/>oppidum eius regionis non ignobile obsidere,
					<lb xml:id="p1z12"/>principes veco cum universo exercitu
					<lb xml:id="p1z13"/>pontem a S. Spiritu vocatum oppugnare.
					<lb xml:id="p1z14"/>dum nostri circa Montempessulum
					<lb xml:id="p1z15"/>vnocturns et
					<lb xml:id="p1z16"/>palantes versantur; amiserunt pentino
					<lb xml:id="p1z17"/>hostim incursu, tria peditum
					<lb xml:id="p1z18"/>signa cum equitibus aliquot, quorum
					<lb xml:id="p1z19"/>dux erat nobilis quidam a lova rarae
					<lb xml:id="p1z20"/>virtutis homo et cuiusmodi paucos habet
					<lb xml:id="p1z21"/>Gallia. Postridae nostri oppidulum
					<lb xml:id="p1z22"/>vicini expignatum diripuerunt,
					<lb xml:id="p1z23"/>suando.
					<lb xml:id="p1z24"/>Sic mutiis datnis certatur. sit autem
					<lb xml:id="p1z25"/>futurus harum calamitatum finis, dominus
					<lb xml:id="p1z26"/>novit. Belgici loge melior es
					<lb xml:id="p1z27"/>conditio, quod vix credas, et tamen
					<lb xml:id="p1z28"/>ita est, sicut tibi pluribus brevi, dec
					<lb xml:id="p1z29"/>favente, significabo. Scis Bernae nunc
					<lb xml:id="p1z30"/>agi de media quadam vicini regali
					<lb xml:id="p1z31"/>cum hac civitate transactione
					<lb xml:id="p1z32"/>de qua haud satis scio, quid nobis sit
					<lb xml:id="p1z33"/>sperandum. Quid pnim velit non est obscuruntum.
					<lb xml:id="p1z34"/>Qud autem possit res ipsa ostendet.
					<lb xml:id="p1z35"/>Bene vale, mi pater. Domin. Iesus te totumque
					<lb xml:id="p1z36"/>vestrum collegium servet. Genevae 4. maii
					<lb xml:id="p1z37"/>regdilimus est exemplar commentariam.
					<lb xml:id="p1z38"/>Tuus Iesa.
					<lb xml:id="p1z39"/>fratris d. Voltii in Nehemiam, dequi
					<lb xml:id="p1z40"/>pretioso munere magnam ipsi gratiam habeo.
					<pb/>
					<lb xml:id="p2z1"/>n maii 1516.
					<lb xml:id="p2z2"/>irmo Christsmo
					<lb xml:id="p2z3"/>servec.
					<lb xml:id="p2z4"/>D. Henrico
					<lb xml:id="p2z5"/>Bullingero.
					<lb xml:id="p2z6"/>Tigurinae ecclesiae
					<lb xml:id="p2z7"/>fido pastori,
					<lb xml:id="p2z8"/>et patri mihi
					<lb xml:id="p2z9"/>obbervando.
				</p>
