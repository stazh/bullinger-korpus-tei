	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.P.</s>
					<s n="2" xml:lang="la">Cum hic<note xml:id="fn1" type="footnote" n="1">Unbekannt.</note>, qui has <persName ref="p1278">Gastio</persName> nostro reddet isthuc<note xml:id="fn2" type="footnote" n="2">nach <placeName ref="l587">Zürich</placeName>.</note> transmittendas, se recta <lb xml:id="p1z2"/><placeName ref="l28">Basileam</placeName> iturum significaret, meae erga te observantiae esse duxi, <lb xml:id="p1z3"/>si te his longo post tempore salutarem, significaremque post meum a <lb xml:id="p1z4"/><placeName ref="l832">Gallica</placeName> legatione reditum<note xml:id="fn3" type="footnote" n="3">Vgl. <ref target="file12415">Nr. 2368</ref>,25-27.</note> hic me pristinae molae operam dare, <lb xml:id="p1z5"/>ut scires, ubi gentium tuo prisco in me iure uti valeas.</s>
					<s n="3" xml:lang="la">Nam <lb xml:id="p1z6"/>si unquam alias, nunc maxime meum illud erga te studium viget; <lb xml:id="p1z7"/>quod re potius quam verbis testari recipio.</s>
					<s n="4" xml:lang="la">Certe, si cuiusquam, <lb xml:id="p1z8"/>tui maxime, causa nihil non conabor, mi <persName ref="p495">Bullingere</persName>, et, ut peri<lb xml:id="p1z9"/>culum facias, te etiam atque etiam rogo.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="5" xml:lang="la">Interim serva te nobis in<lb xml:id="p1z10"/>columem, nam quamdiu vixeris, tandiu et literariae reipublicae <lb xml:id="p1z11"/>et christiano nomini consultum iri arbitramur.</s>
					<s n="6" xml:lang="la">Ego (quod <lb xml:id="p1z12"/>mihi tantum licet)<note xml:id="fna" type="footnote" n="a">Klammern <hi>ergänzt.</hi></note> quotidie te in tuis scriptis disserentem audio <lb xml:id="p1z13"/>et pene conspicor.</s>
					<s n="7" xml:lang="la">Inprimisque sum tuis defensionibus mirabiliter <lb xml:id="p1z14"/>delectatus.</s>
					<s n="8" xml:lang="la">Summam enim illae doctrinam et illam, quam ego <lb xml:id="p1z15"/>maxime probo, egregie redolent animi moderationem<note xml:id="fn4" type="footnote" n="4">Zu diesen Büchern <persName ref="p495">Bullingers</persName> siehe bereits <bibl source="b18">HBBW XV</bibl> 378 und Anm. 7.</note>.</s>
					<s n="9" xml:lang="la">Annotationum <lb xml:id="p1z16"/>tuarum<note xml:id="fn5" type="footnote" n="5">Offensichtlich hatte <persName ref="p495">Bullinger</persName> ihm auch noch seinen im August 1545 erschienenen Markuskommentar <bibl source="https://gateway-bayern.de/VD16+B+4904">(VD16 B4904</bibl>; <bibl source="b286">HBBibl</bibl> I 170) zukommen lassen, zusammen mit einem nicht erhaltenen Brief, der auf <bibl source="b18">HBBW XV</bibl>, <ref target="file12234">Nr. 2187</ref>, vom 22. Juni 1545 antwortete.</note> iam bonam perlegi partem.</s>
					<s n="10" xml:lang="la" ana="farewell">Bene atque optime <lb xml:id="p1z17"/>vale, et me in tuo aere<note xml:id="fn6" type="footnote" n="6"><hi><persName ref="p4543">Cicero</persName>,</hi> Epistulae ad familiares, 15, 14, 1.</note> semper censeas et, ut vales et si quid <lb xml:id="p1z18"/>novi excudis, significes quandoque, rogo atque obsecro.</s>
					<s n="11" xml:lang="la" ana="farewell">Iterum vale.<pb type="edition" next="263"/></s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z19"/>Datum <placeName ref="l356">Nozerethi</placeName>, 8. calendas aprilis anno christiano 1546.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z20"/>Tui studiosissimus et observandissimus</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
