	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Discessum doctissimi humanissimique viri d. <persName>Mülleri</persName> <lb xml:id="p1z2"/>a nobis aegerrime ferimus ac dolentissimo animo <lb xml:id="p1z3"/>singulare hoc totius <placeName ref="l648">Rhetiae</placeName> decus inviti dimittimus.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Cum vero regi tam cruento servire amplius non possit, <lb xml:id="p1z5"/>nec pro ea pietate, qua pollet, velit adque vos primum <lb xml:id="p1z6"/>aliam conditionem ineundi gratia iter sit suscepturus, <lb xml:id="p1z7"/>non potui illum absque meis literis ad vos dimittere, quibus <lb xml:id="p1z8"/>saltem significem me tuas cum duobus huius operis <lb xml:id="p1z9"/>exemplis accepisse.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ingentes d. consul mecum tibi agit gratias, <lb xml:id="p1z10"/>qui preciosissimis eiuscemodi muneribus et honoribus <lb xml:id="p1z11"/>nunquam non afficere nos digneris.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Utinam re ipsa <lb xml:id="p1z12"/>gratis nobis esse quamprimum nobis liceat.</s>
					<s n="6" xml:lang="la">Quid de <placeName ref="l875">Hispanis</placeName> <lb xml:id="p1z13"/>circa limites nostros frementes audiatur, malo ex literis <lb xml:id="p1z14"/>praesidum <placeName ref="l520">Vallis Tellinae</placeName> te cognoscere quam dubia aliorum <lb xml:id="p1z15"/>relatione.</s>
					<s n="7" xml:lang="la">Scripsit praefectus <placeName ref="l469">Sondrio</placeName>, <placeName>Trahomensis</placeName> et <placeName>Mor<lb xml:id="p1z16"/>benienses</placeName> etiam praesides, ad d. consulem nostrum: gubernatorem <lb xml:id="p1z17"/><placeName ref="l306">Mediolano</placeName> una cum nobilibus et senatoribus aliisque <lb xml:id="p1z18"/>hominibus ad 1500 numero fines lustrandi gratia, <lb xml:id="p1z19"/>idque antiquo more, <placeName ref="l1058">Comum</placeName> usque navigio pervenisse, <lb xml:id="p1z20"/>et licet nihil periculi hinc nobis imminere existiment, <lb xml:id="p1z21"/>monere tamen nos, ut vigilemus et ad futuros, si <lb xml:id="p1z22"/>qui oborirentur, casus parati simus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l93">Claven[n]ens<lb xml:id="p1z23"/>is</placeName> etiam commissarius, d. <persName ref="p8433">Ioannes a Salicibus</persName>, <persName ref="p8432">Friderici</persName> p[raeclarae] m[emori<lb xml:id="p1z24"/>ae] filius, singulares ad d. consulem scripsit, quarum exemplum <lb xml:id="p1z25"/>vobis descriptum exhibeo, ut ipsi, quid iudicent, coram <lb xml:id="p1z26"/>quodam[m]odo audiatis videatisque.</s>
					<s n="9" xml:lang="la">Sparg[e]ntur eiuscemodi <lb xml:id="p1z27"/>nuncii per singulas <placeName ref="l648">Rhetię</placeName> communitates, quas simul <lb xml:id="p1z28"/>domini nostri ad vigilantiam et curam hortando <lb xml:id="p1z29"/>armabunt.</s>
					<s n="10" xml:lang="la">Mirum vero <persName>Paganos</persName> evocatos <lb xml:id="p1z30"/>conticuisse adeo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><persName>Baltasar Planta</persName>, frater <placeName ref="l648">Rhetiensis</placeName>, <lb xml:id="p1z31"/>vindictam cogitans crudelissime invexit in fratres <lb xml:id="p1z32"/><placeName ref="l638">Ingaddinenses</placeName>; sed probro affectus iuramenti religione <lb xml:id="p1z33"/>sibi ipsi grande dedecus conflavit ad palinodiam <lb xml:id="p1z34"/>adactus et 40 aureorum iacturam passus.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z35"/>Vanus autem rumor spargitur ipsum etiam esse incarceratum.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z36"/>V<pb/><lb xml:id="p2z1"/>ix autem et ne vix quidem nobis temperamus, quin vocem <lb xml:id="p2z2"/>exaltemus in confoederationem illam, quam nostri cum <lb xml:id="p2z3"/><placeName ref="l832">Gallo</placeName> perfidissimo habent.</s>
					<s n="14" xml:lang="la">Molestum hoc quidem foret benefici<lb xml:id="p2z4"/>ariis regiis; sed qua honestate latronem pro socio habebimus?</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z5"/>num illorum gratia, qui omnem honestatem venalem <lb xml:id="p2z6"/>habent, latronem amicitia et favore prosequemur?</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z7"/>Sed haec hactenus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Resalutant vos omnes salutati.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Ocyssime <lb xml:id="p2z8"/><placeName ref="l98">Curię</placeName> 1572. 20. octobris.</s>
					<s n="19" xml:lang="la">Estote omnes salvi et incolumes.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p2z9"/>Tuae reverentię <lb xml:id="p2z10"/>observantissimus <lb xml:id="p2z11"/><persName ref="p8016">Th[obias] Ic[<lb xml:id="p2z12"/>onius]</persName>.</s>
					<s n="21" xml:lang="la"><lb xml:id="p2z13"/>Amplissimo viro d. <lb xml:id="p2z14"/>d. <persName ref="p495">Heinrych<lb xml:id="p2z15"/>o Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesi<lb xml:id="p2z16"/>ae antistiti primario, <lb xml:id="p2z17"/>domino suo singulari obs<lb xml:id="p2z18"/>ervantia colendissimo.</s>
				</p>
			</div>
		</body>
