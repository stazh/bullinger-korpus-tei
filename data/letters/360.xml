	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/><persName ref="p8098">Georg, grave zu Württemberg <lb xml:id="p1z2"/>und zwͦ Muͦmpelgart</persName> etc.</s>
					<s n="2" xml:lang="de"><lb xml:id="p1z3"/>Unsern gruß zu vor.</s>
				</p>
				<p>
					<s n="3" xml:lang="de">Lieber, besonder, <lb xml:id="p1z4"/>wyr habent <persName ref="p8071">Johan Vogler dem elter</persName> <lb xml:id="p1z5"/>uff euwer jünst gethon schriben und <lb xml:id="p1z6"/>anders befelch geben, euch müntlich <lb xml:id="p1z7"/>ze berichten; dan wyr wissen und können <lb xml:id="p1z8"/>euch nichs sichers oder gutz zuͦ schriben, <lb xml:id="p1z9"/>derwegen wyr sölchs schrybens und übels <lb xml:id="p1z10"/>gantz matt und mudt sendt.</s>
					<s n="4" xml:lang="de">Der gnedi<lb xml:id="p1z11"/>g <lb xml:id="p1z12"/>gott verlihe bössere zeitten und ufrechtere hertzer <lb xml:id="p1z13"/>im herren; dan wyr leider noch sehen, by <lb xml:id="p1z14"/>allen steenden.</s>
					<s n="5" xml:lang="de">Waß vier zeyttungen in röden <lb xml:id="p1z15"/>stendt mit <placeName ref="l491">Straßburg</placeName>, kan üch der <lb xml:id="p1z16"/><persName ref="p8071">Vogler</persName> berichten.</s>
					<s n="6" xml:lang="de">Seidt gott befollen.</s>
				</p>
				<p>
					<s n="7" xml:lang="de"><lb xml:id="p1z17"/>Dattum unser hant.</s>
					<s n="8" xml:lang="de"><placeName ref="l28">Bassel</placeName> den 6. Decem<lb xml:id="p1z18"/>ber anno 48.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="9" xml:lang="de"><pb/><lb xml:id="p2z2"/>Dem wolgelerten <persName ref="p495">Heinrichen Bul<lb xml:id="p2z3"/>linger</persName>, predicanten zuͦ <placeName ref="l587">Zürich</placeName>, <lb xml:id="p2z4"/>unserm lieben, besunder<lb xml:id="p2z7"/>n.</s>
				</p>
			</div>
		</body>
	</text>
