	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gaspar ille, nobilis <persName ref="p4443">Pomeranus</persName>, qui nuper ex <lb xml:id="p1z2"/><placeName ref="l834">Italia</placeName> redibat et cui tu scriptum <persName ref="p6589">Serveti</persName> <lb xml:id="p1z3"/>ostendere te posse dicebas, nuntium mihi <lb xml:id="p1z5"/>tristissimum attulit matrem charissimam excessiss<lb xml:id="p1z6"/>e e vivis, quod me consiliaque mea valde <lb xml:id="p1z7"/>perturbavit, quamvis non desperem neque abiiciam <lb xml:id="p1z8"/>animum, quin potius humiliatus sub potenti <lb xml:id="p1z9"/>manu dei expetto, quid ipse de me quoque <lb xml:id="p1z10"/>statuerit.</s>
					<s n="2" xml:lang="la">Verum tu precibus, ut adsit mihi <lb xml:id="p1z11"/>atque eripiat omni malo, contendere non cessabis.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z12"/>Literas ad <persName>Vergerium</persName> quaque mittas, oro.</s>
					<s n="4" xml:lang="la">De gratia <lb xml:id="p1z13"/>dei libros tuos devorabo, quamprimum videre et <lb xml:id="p1z14"/>consequi potero.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Diutius hic hęsi, quam putaram; <lb xml:id="p1z15"/>sed cras deo dante discedam et scribam ad te <lb xml:id="p1z16"/><placeName ref="l167">Geneva</placeName> copiosius.</s>
					<s n="6" xml:lang="la" ana="farewell">Interea bene vale <lb xml:id="p1z17"/><persName ref="p8101">Laeliique</persName> tui cum aliqua benevolentia recordare.</s>
					<s n="7" xml:lang="la" ana="salute"><lb xml:id="p1z18"/>Amicos omnes saluto.</s>
					<s n="8" xml:lang="la"><placeName ref="l28">Basileę</placeName> 5.<note type="misc">vielleicht 15.</note> februarii <lb xml:id="p1z19"/>1554.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>Tui studiosissimus <persName>Lelius Sozinus</persName><lb xml:id="p1z21"/>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">In <placeName>Burgundia</placeName> rursus <lb xml:id="p1z22"/>excitata est magna <lb xml:id="p1z24"/>persecutio.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo atque optimo <lb xml:id="p2z2"/>viro domino <persName ref="p495">Henric<lb xml:id="p2z3"/>o Bullingero</persName> <lb xml:id="p2z4"/>imprimis colendo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
