	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>
					<lb xml:id="p1z2"/>Literas tuas 29. augusti datas hic Mosbachii
					<lb xml:id="p1z3"/>quo me cum cancellaria ob grassantem spides
					<lb xml:id="p1z4"/>pestem ex mandato principis contuli
					<lb xml:id="p1z5"/>mihi redditas scito, Ex quibus suam singularim
					<lb xml:id="p1z6"/>erga nos benevolensiam et in comunia
					<lb xml:id="p1z7"/>periculo sollicitudinem cognovi. Responsio
					<lb xml:id="p1z8"/>ntuam accepi, quae etiam a principe pere
					<lb xml:id="p1z9"/>fuit. Volo autem tibi penitus persuadeas
					<lb xml:id="p1z10"/>tua nobis gratissima esse et me ma
					<lb xml:id="p1z11"/>um laboris gratitudinem. Nunc in ista
					<lb xml:id="p1z12"/>dissupatione parum possum, dum animi et
					<lb xml:id="p1z13"/>cogitationes ob nostram rerum domesticarum
					<lb xml:id="p1z14"/>distractae sunt. Principibus tandem respondi
					<lb xml:id="p1z15"/>pie, modeste et meo iuditio sine ulta
					<lb xml:id="p1z16"/>offensione. Addidimus quatuor defensiones
					<lb xml:id="p1z17"/>catechismi contra quorundam fleom
					<lb xml:id="p1z18"/>logorum nimis acerbas censurus, quae
					<lb xml:id="p1z19"/>fortassis ob liberiorem refutationem ab ipsis
					<lb xml:id="p1z20"/>aegro amimo excipiensur Cuperem hanc v
					<lb xml:id="p1z21"/>a theologis tractari et ne principes se
					<lb xml:id="p1z22"/>immiscerent. Habemus homines, qui lubente
					<lb xml:id="p1z23"/>in arenam prosilirent. Sed immaturam
					<lb xml:id="p1z24"/>velitationem cohibendam censemus ob pari
					<lb xml:id="p1z25"/>studium ac temporum iniquitate. Expecta
					<lb xml:id="p1z26"/>nunc replicas. Dominus suae ecclesiae
					<lb xml:id="p1z27"/>adsit et nos spiritu sancto corfirmet.
					<lb xml:id="p1z28"/>ut opus incoeptum masculo animo perfitiamus
					<lb xml:id="p1z29"/>Vale feliciter, mi amantissime Bullingere,
					<lb xml:id="p1z30"/>et me tuum prorsus esse scias. Saluta
					<lb xml:id="p1z31"/>meo nomine dol Simlerium. Gvaltherum
					<lb xml:id="p1z32"/>Lanatemum et Volphium Masbachii exheremts
					<lb xml:id="p1z33"/>22. septembris anno etc.3.
					<lb xml:id="p1z34"/>Tuus ex anino
					<lb xml:id="p1z35"/>Stephanus Gelerus.
					<lb xml:id="p1z36"/>secretarius.
					<pb/>
					<lb xml:id="p4z1"/>Pietate et eruditione praestanti
					<lb xml:id="p4z2"/>irissimo viro d. Henrico Bullingero,
					<lb xml:id="p4z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> antistiti
					<lb xml:id="p4z4"/>fidelissimo, domino et amico
					<lb xml:id="p4z5"/>longe carissimo.
					<lb xml:id="p4z6"/>Zirich.
					<lb xml:id="p4z7"/>Steffanus Cyrlerus.
				</p>
			</div>
		</body>
