	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quę pauca nova habui, ea d. <persName>Fabritio</persName> comunicavi, <lb xml:id="p1z2"/>ut p[ietatem] t[uam] faceret participem, ut et semper feci antea.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Nunc illud superest, ut illi pro suis gratiam agam, <lb xml:id="p1z4"/>quod facio maiores quas possum et pro libello, quem <lb xml:id="p1z5"/>legendum mihi et ipsi d. <persName>Fabritio</persName> retinui per aliquot <lb xml:id="p1z6"/>paucos dies; eum enim non multis ante horis accepi.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Prima vero occasione remittam aut forsam ego deferam <lb xml:id="p1z8"/>brevi.</s>
					<s n="5" xml:lang="la">Interim mitto icones insulę <persName>Zerlę</persName> et civitatis <lb xml:id="p1z9"/><placeName ref="l1374">Tripolis</placeName>, quę omnia nuper <placeName ref="l425">Roma</placeName> accepi.</s>
					<s n="6" xml:lang="la">Ea vero p[ietas] t[ua] <lb xml:id="p1z10"/>penes se adservet usque ad meum illic adventum meque <lb xml:id="p1z11"/>interim amet et sui studiosissimum credat.</s>
					<s n="7" xml:lang="de">Datum in <lb xml:id="p1z12"/><placeName>Haldenstein</placeName> die 22. iulii 1560.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>P[iet<lb xml:id="p1z14"/>atis<pb/><lb xml:id="p2z1"/>] t[uae<lb xml:id="p2z2"/>] de<lb xml:id="p2z3"/>ditissimu<lb xml:id="p2z5"/>s <persName ref="p8306">I[oan<lb xml:id="p2z8"/>nes] I<lb xml:id="p2z9"/>[<lb xml:id="p2z10"/>acob<lb xml:id="p2z11"/>us] <lb xml:id="p2z12"/>Cambr<lb xml:id="p2z13"/>a<lb xml:id="p2z15"/>yu<lb xml:id="p2z16"/>s</persName>.</s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro pietate et conditione <lb xml:id="p4z2"/>excellenti d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p4z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae ministro dignissimo et <lb xml:id="p4z4"/>amico suo honrando.</s>
					<s n="10" xml:lang="la">Tigury.</s>
				</p>
			</div>
		</body>
	</text>
