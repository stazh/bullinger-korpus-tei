	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hodie tuas, compater in domino charissime, accepi <lb xml:id="p1z2"/>una cum strena pro <persName ref="p2207">Heinrichulo</persName> nostro, pro <lb xml:id="p1z3"/>qua tibi magnopere gratias agimus, cum primis <lb xml:id="p1z4"/>pro constanti hac tua in illum benevolentia.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Dominus <lb xml:id="p1z5"/>rependat tibi ac tuis millecuplum!</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Apocalypsim tuam nondum vidi, nihil autem dubito, <lb xml:id="p1z7"/>quin omnia consueta tua moderatione tractaris, <lb xml:id="p1z8"/>nec ego is sum, quem par sit iudicium sibi in <lb xml:id="p1z9"/>aliorum sumere vigilias et labores, tametsi hoc <lb xml:id="p1z10"/>a me pro iure amicitię nostrę poscas, quod <lb xml:id="p1z11"/>tuae magis modestiae quam meae dandum est existi<lb xml:id="p1z12"/>mationi.</s>
					<s n="5" xml:lang="la">Et praeterea sic sum erga vos animatus, <lb xml:id="p1z13"/>qui in vinea domini excolenda laborant, <lb xml:id="p1z14"/>praesertim erga eos, cum quibus mihi aliqua fami<lb xml:id="p1z15"/>liaritas intercedit, ut ea, quae scribunt, haud <lb xml:id="p1z16"/>putem mihi curiosius esse diiudicanda.</s>
					<s n="6" xml:lang="la">Longe aliud <lb xml:id="p1z17"/>est, si frater fratris lucubrationes legat, quam si <lb xml:id="p1z18"/>legat eas adversarius aliquis, qui sibi omnes <lb xml:id="p1z19"/>apices inspiciendos et divexandos esse censet.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z20"/>Quare non est, ut dissimulationem voces, nisi <lb xml:id="p1z21"/>accuratam mihi laborum tuorum censuram sumpsero.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z22"/>Absit, ut dissimulanter invicem agamus, absit etiam, <lb xml:id="p1z23"/>ut curiosius alter alterius scripta inspiciat <lb xml:id="p1z24"/>et examinet.</s>
					<s n="9" xml:lang="la">Si tamen inter legendum occurrerit, <lb xml:id="p1z25"/>quod vel ipse non intelligam vel alios <lb xml:id="p1z26"/>non recte accepturos putem, candide monebo, <lb xml:id="p1z27"/>quandoquidem ita vis ut faciam.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z28"/>Caeterum te oro, ut, ubi d. <persName ref="p8354">Laeto</persName> nostro scripseris, <lb xml:id="p1z29"/>moneas eum, ut, quam putet principis sui <lb xml:id="p1z30"/>de Commentariis meis in Ioannem esse sententiam, <lb xml:id="p1z31"/>scribat.</s>
					<s n="11" xml:lang="la">Ab eo nanque tempore, quo eos nomini <lb xml:id="p1z32"/>ipsius nuncupavi, rescire non licuit, probet<lb xml:id="p1z33"/>ne officium meum vel respuat.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute"><lb xml:id="p1z34"/>D. <persName ref="p8111">Petrum Martyrem</persName>, charissimum in domino fratrem, et <lb xml:id="p1z35"/>d. <persName ref="p2336">Bernardinum Ochinum</persName>, veterem amicum, et reliquos <lb xml:id="p1z36"/>isthuc symmystas tuos cum d. <persName ref="p8171">Bibliandro</persName>, quaeso, <lb xml:id="p1z37"/>meo nomine plurimum salutes.</s>
					<s n="13" xml:lang="la">Uxori tuę <lb xml:id="p1z38"/>honestissimę ac liberis totique domui tuę nos omnes <lb xml:id="p1z39"/>plurimum salutis apprecamur.</s>
				</p>
				<p>
					<s n="14" xml:lang="de"><placeName ref="l41">Bernę</placeName> 1556. <lb xml:id="p1z40"/>22. novembris.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z41"/><persName ref="p8417">W. Musculus</persName>, compater <lb xml:id="p1z42"/>tuus in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo theologo <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho Bul<lb xml:id="p2z3"/>lingero</persName>, domino ac <lb xml:id="p2z4"/>compatri suo charissimo.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note>[Notiz von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="18" xml:lang="de"><lb xml:id="p2z6"/>22. novemb. <lb xml:id="p2z7"/>1556.</s>
				</p>
