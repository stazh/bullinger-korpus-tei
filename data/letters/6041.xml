			<zone xml:id="p2z6-0" points="1016,1626 1088,1602 1128,1622 1168,1602 1202,1612 1258,1598 1356,1602 1384,1624 1424,1616 1424,1524 1296,1534 1266,1558 1218,1522 1182,1540 1090,1516 1016,1552">1027,1580 1052,1580 1077,1580 1102,1580 1127,1580 1152,1580 1177,1580 1202,1580 1227,1581 1252,1583 1277,1583 1302,1583 1327,1583 1352,1583 1377,1583 1402,1584 1427,1586</zone>
