	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nuper scripsi humanitati tuae, <lb xml:id="p1z2"/><persName ref="p8418">Myconi</persName> colendissime, per <placeName ref="l640">Flandrum</placeName> quendam <lb xml:id="p1z3"/><placeName ref="l168">Gandavensem</placeName> civem nec dubito, quin <lb xml:id="p1z4"/>eas modo receperis.</s>
					<s n="3" xml:lang="la">Interea audio te <lb xml:id="p1z5"/>subinde rectius convalescere; dominus con<lb xml:id="p1z6"/>firmet id in te; tu quoque cura, ut valeas.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Ex <placeName ref="l882">Hungaria</placeName> scriptis ad me literis vir <lb xml:id="p1z8"/>quidam clarus testatur pulchre proceder<lb xml:id="p1z9"/>e religionis negotium et praedicari <lb xml:id="p1z10"/>evangelium Christi in ipsam usque <placeName ref="l2891">Thraciam</placeName>.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Quo nomine est, quod agamus bonitati divinae <lb xml:id="p1z12"/>maximas gratias.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Quid agatur in <placeName ref="l834">Italia</placeName> intelliges ex his <lb xml:id="p1z15"/>viris bonis et piis.</s>
					<s n="7" xml:lang="la">Primus in his est <persName ref="p8222">Hieronymus <lb xml:id="p1z16"/>Massarius</persName> <placeName ref="l1637">Vicentinus</placeName> commendatus <lb xml:id="p1z17"/>mihi a d. <persName ref="p3375">Vergerio</persName> nostro, quocirca et hunc <lb xml:id="p1z18"/>tibi vicissim commendo.</s>
					<s n="8" xml:lang="la">Sectatur studia <lb xml:id="p1z19"/>medicinae; ergo apud nos haerere non pot<lb xml:id="p1z20"/>uit, apud quos medicinae studium plane <lb xml:id="p1z21"/>nullum est.</s>
					<s n="9" xml:lang="la">Poteris autem illum <lb xml:id="p1z22"/>medicis vestris commendare et ipsi adesse <lb xml:id="p1z23"/>tuis consiliis; facies rem te dignam, <lb xml:id="p1z24"/>qui non nescias, quomodo excipiendus sit i<lb xml:id="p1z25"/>n membris suis Christus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z26"/>Putant multi bellum hoc anno transferendum <lb xml:id="p1z27"/>a <placeName ref="l2510">Turca</placeName> in <placeName ref="l2549">Aphricam</placeName>, incur<lb xml:id="p1z28"/>siones vero faciendas ex <placeName ref="l882">Hungaria</placeName>, <lb xml:id="p1z29"/>ut Caesaris vires dirimantur.</s>
					<s n="11" xml:lang="la">Dabit pri<lb xml:id="p1z30"/>ncipi sanguinario sat belli dominus.</s>
					<s n="12" xml:lang="la" ana="farewell">Tu vale <lb xml:id="p1z31"/>et brevi rescribe.</s>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 8. <lb xml:id="p1z32"/>maii anno 1551.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z33"/>Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8418">Os<lb xml:id="p2z2"/>valdo Myconio</persName>, <placeName ref="l28">Basiliensis</placeName> <lb xml:id="p2z3"/>ecclesiae fido pa<lb xml:id="p2z4"/>stori, domino et fratri suo <lb xml:id="p2z5"/>colendissimo.</s>
				</p>
				<p>
					<s n="16" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
