			<zone xml:id="p2z3-0" points="1286,1637 1388,1662 1476,1662 1548,1635 1607,1659 1671,1660 1661,1588 1612,1586 1567,1612 1515,1584 1427,1571 1395,1592 1363,1580 1329,1600 1286,1598">1292,1632 1317,1629 1342,1629 1368,1629 1393,1629 1419,1629 1444,1629 1470,1630 1495,1632 1521,1632 1546,1632 1572,1632 1597,1631 1623,1629 1648,1629 1674,1629</zone>
