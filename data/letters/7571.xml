	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi tuas per d. <persName ref="p8511">Tretium</persName> missas una cum volu<lb xml:id="p1z2"/>mine novo operis tui De origine erroris et conciliis, pro <lb xml:id="p1z3"/>quo, colendissime domine et compater, tibi magnas <lb xml:id="p1z4"/>rursus ago gratias.</s>
					<s n="3" xml:lang="la">Video, quam me diligas, quod mei <lb xml:id="p1z5"/>subinde in distribuendis lucubrationum tuarum exemplaribus <lb xml:id="p1z6"/>recordaris; <lb xml:id="p1z7"/>utinam ad referendum par essem!</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Referat autem ille, qui haec in te dona contulit, ut <lb xml:id="p1z10"/>ita scribendo et docendo ecclesię suae prodesses.</s>
					<s n="5" xml:lang="la">Quod <lb xml:id="p1z11"/>res <placeName ref="l832">Gallicas</placeName> concernit, referet tibi <persName ref="p8511">Tretius</persName> omnia, quę <lb xml:id="p1z12"/><placeName ref="l167">Genevae</placeName> audivit.</s>
					<s n="6" xml:lang="la">Deploratissimae sunt illae, et intra <lb xml:id="p1z13"/>multos annos tam misera rerum facies in <placeName ref="l832">Gallia</placeName> <lb xml:id="p1z14"/>non fuit, quam nunc est.</s>
					<s n="7" xml:lang="la">Turbantur inde nostri non pa<lb xml:id="p1z15"/>rum.</s>
					<s n="8" xml:lang="la">Sabaudus etiam cristas erigit contra <placeName ref="l167">Genevates</placeName> <lb xml:id="p1z16"/>et, quibus potest modis, commeatum illis intercludit; me<lb xml:id="p1z17"/>tuo, ne brevi novi aliquid inde quoque oriatur.</s>
					<s n="9" xml:lang="la">Ex <placeName ref="l808">Belgio</placeName> <lb xml:id="p1z18"/>nihil habemus, nisi quod communiter fertur copias <persName>Lu<lb xml:id="p1z19"/>dovici Nassoviensis</persName> ad internecionem usque esse deletas; <lb xml:id="p1z20"/>nescio vero, an adversarii hoc fingant.</s>
					<s n="10" xml:lang="la">Nostras <lb xml:id="p1z21"/>quidem<note type="margin">a.R.: ..., quidam</note> his diebus ex <placeName ref="l691">Lotharingia</placeName> rediit; is narrat, <lb xml:id="p1z22"/>quantas ob hanc victoriam triumphos agant in Bur<lb xml:id="p1z23"/>gundia (nam illac transiit).</s>
					<s n="11" xml:lang="la">Audio etiam nostros <lb xml:id="p1z24"/>confoederatos esse valde inquietos; fingunt sibi propter <lb xml:id="p1z25"/>conventum illum <placeName ref="l2">Arovię</placeName> habitum nostras Respublicas cum <lb xml:id="p1z26"/><persName>Palatino</persName> et <placeName ref="l491">Argentinensibus</placeName> novum pangere foedus <lb xml:id="p1z27"/>velle et alia eiusmodi.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Vestri male audiunt hic <lb xml:id="p1z28"/>apud nonnullos, quod nihil contribuere voluerint, <lb xml:id="p1z29"/>cum illud facturi esse viderentur <placeName ref="l28">Basilienses</placeName> et <placeName ref="l441">Sca<lb xml:id="p1z30"/>phusiani</placeName>, si vestrorum etiam voluntas accessisset.</s>
					<s n="13" xml:lang="la">Intell<lb xml:id="p1z31"/>ectae sunt tamen rationes, quibus se excusarunt.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z32"/>Alias nihil est, quod scribam, cum <persName ref="p8511">Tretium</persName> habeas <lb xml:id="p1z33"/>omnium rerum nostrarum vivum expositorem, quem <lb xml:id="p1z34"/>non opus est ut commendem, cum alias tibi sit <lb xml:id="p1z35"/>commendatissimus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Salutant te consules nostri <lb xml:id="p1z36"/>et quęstores, amici item et fratres reliqui.</s>
					<s n="16" xml:lang="la"><persName>Fride<lb xml:id="p1z37"/>rychum Musculum</persName> nesciebam illuc iturum; alioqui per ipsum <lb xml:id="p1z38"/>quoque scripsissem aliquid.</s>
					<s n="17" xml:lang="la">Cupio scire, quomodo res <placeName ref="l648">Rheticae</placeName> <lb xml:id="p1z39"/>habeant; si quid habes, communica nobis.</s>
					<s n="18" xml:lang="la" ana="salute">Ante omnes offi<lb xml:id="p1z40"/>ciosissime te salutat <persName ref="p7449">Diesbachius</persName> noster.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l41">Bernae</placeName> <lb xml:id="p1z41"/>20. augusti 1568.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><persName ref="p8018">I[ohan<lb xml:id="p1z42"/>nes] <lb xml:id="p1z43"/>Hallerus</persName> tuus.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori f<lb xml:id="p2z4"/>idelissimo, domino meo et <lb xml:id="p2z5"/>compatri summa perpetuaque <lb xml:id="p2z6"/>fide colendo.</s>
				</p>
			</div>
