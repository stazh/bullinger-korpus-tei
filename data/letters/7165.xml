	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Auch wurdiger unnd hochgelerter, lieber <lb xml:id="p1z2"/>besonder, wollen wir ewern sohn <persName ref="p475">Chri<lb xml:id="p1z3"/>stoffen</persName> zuͦ unserm diener annehmen und <lb xml:id="p1z4"/>ime umb ewertwillen alle gnedige und <lb xml:id="p1z5"/>guͦtte befurderung erzeigen.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Datum ut in literi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>24. iulii 1567<note type="misc">Notiz von <persName ref="p495">Bullinger</persName></note></s>
				</p>
				<p>
					<s n="4" xml:lang="de"><lb xml:id="p1z7"/><persName ref="p8096">Wilhelm <pb/><lb xml:id="p2z2"/>L[<lb xml:id="p2z3"/>andgra<lb xml:id="p2z4"/>f] z[u] <lb xml:id="p2z5"/>Hesßen</persName>.</s>
				</p>
				<p>
					<note>[Keine Adresse; Bemerkung von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="5" xml:lang="de"><lb xml:id="p2z6"/>Des <persName ref="p8096">hertzogen Wilhelmen</persName> <lb xml:id="p2z7"/>zuͦsag dem <persName ref="p475">Stoffel</persName>, <lb xml:id="p2z8"/>24. iulii 1567.</s>
				</p>
			</div>
		</body>
	</text>
