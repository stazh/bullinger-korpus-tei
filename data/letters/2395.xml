	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Noli mirari, quod a <placeName ref="l21">Baddensi</placeName> conventu nihil <lb xml:id="p1z2"/>a me habueris.</s>
					<s n="3" xml:lang="la">Quidquid illi novi fuit, <lb xml:id="p1z3"/>dedi dominis tuis et scio te copiam <lb xml:id="p1z4"/>omnium vidisse.</s>
					<s n="4" xml:lang="la">Preterea meus secretarius <lb xml:id="p1z5"/>mihi narravit, quomodo te salutarit <lb xml:id="p1z6"/>et partem eorum, que habuerit, exposuerit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Ergo istis nihil potuissem addere.</s>
					<s n="6" xml:lang="la">Ab <lb xml:id="p1z8"/>illo tempore ex <placeName ref="l2589">Picardia</placeName> habui, pro novi<lb xml:id="p1z9"/>s, que hic<note type="margin">a.R.: gestrichen.</note> <lb xml:id="p1z10"/>mitto in duo<lb xml:id="p1z11"/>bus memorialibus, <lb xml:id="p1z12"/>quorum, si placet, coppiam dominis tuis dab<lb xml:id="p1z13"/>is, ut legantur in con<lb xml:id="p1z14"/>silio; nam <lb xml:id="p1z15"/>est veritas rerum Picardicarum usque ad 10. <lb xml:id="p1z16"/>huius mensis.</s>
					<s n="7" xml:lang="la">Quod ad <placeName ref="l822">Germaniam</placeName>, <lb xml:id="p1z18"/>revera <persName>Augustus</persName>, frater <persName ref="p18250">Mauricii</persName>, fratris<lb xml:id="p1z19"/>at et cum auxilio <persName ref="p3671">regis <lb xml:id="p1z20"/>Danię</persName> et <placeName ref="l425">Romanorum</placeName> <lb xml:id="p1z21"/>tuetur su<lb xml:id="p1z22"/>ccessionem <lb xml:id="p1z23"/>et electoratum.</s>
					<s n="8" xml:lang="la">Misit legatos ad regem, <lb xml:id="p1z24"/>qui ei non deerit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Audio eum amare <lb xml:id="p1z25"/>viros doctos et fovere diligenter, quod m<lb xml:id="p1z26"/>ihi <lb xml:id="p1z27"/>gratissimum est.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z28"/>Expectabo a te, <pb/><lb xml:id="p2z1"/>si quid inde amplius habeas.</s>
					<s n="11" xml:lang="la"><persName ref="p3375">Verg[erius]</persName> <lb xml:id="p2z2"/>mihi scripsit et significavit, quod <lb xml:id="p2z3"/>omnia mea ei tua opera sint reddita.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z4"/>Ago ergo gratias.</s>
					<s n="13" xml:lang="la">Cum plus otii erit, ei <lb xml:id="p2z5"/>scribam.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale optime, vir bo<lb xml:id="p2z6"/>ne.</s>
					<s n="15" xml:lang="la">Datum ex <placeName ref="l760">Soluturo</placeName> 1<lb xml:id="p2z7"/>8a septem<lb xml:id="p2z8"/>bris.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Tuus semper <persName ref="p8296">Bas[saf<lb xml:id="p2z9"/>ontaneu<lb xml:id="p2z10"/>s]</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z11"/>Pluvie maxime molestarunt <lb xml:id="p2z12"/>nostrum exercitum in principio <lb xml:id="p2z13"/>huius mensis, et timeo maxime <lb xml:id="p2z14"/><placeName>Camerarensibus</placeName>, qui in hunc diem <lb xml:id="p2z15"/>fuerant inter hos duos principes <lb xml:id="p2z16"/>neutrales et iam recepto Caea[aris] <lb xml:id="p2z17"/>praesidi in aperta pericula sese coniecerunt.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt. Einzelblatt zu obigem Brief gehörig?]</note>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p3z1"/>Cum hunc fasciculum clauderem, accepi secundas <lb xml:id="p3z2"/>literas <persName ref="p3375">Vergerii</persName>, quas ad te miserat.</s>
					<s n="19" xml:lang="la"><lb xml:id="p3z3"/>Ago gratias et illi per primas meas <lb xml:id="p3z4"/>satisfaciam.</s>
					<s n="20" xml:lang="la">Et quia etiam cum <lb xml:id="p3z5"/>multis aliis <placeName ref="l832">Gallicis</placeName> literis <lb xml:id="p3z6"/>e <placeName ref="l378">Lutetia</placeName> mis is inveni pro uno ex civibus <lb xml:id="p3z7"/>vestris, que hic includuntur, cu<lb xml:id="p3z8"/>rabis, si placet, <lb xml:id="p3z9"/>reddi; nam alias non <lb xml:id="p3z10"/>novi.</s>
					<s n="21" xml:lang="la" ana="farewell"><lb xml:id="p3z11"/>Vale.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p3z12"/>Domino <pb/><lb xml:id="p4z1"/><persName ref="p495">Bulingero</persName>.</s>
				</p>
			</div>
