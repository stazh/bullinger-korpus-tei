	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">Nuper ad te scripsi, que scitu digna iudicaveram.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">In <placeName ref="l832">Gallia</placeName> presbiteri <lb xml:id="p1z3"/>et ecclesiastici, ne quid de luchro decedat, maximas movent turbas <lb xml:id="p1z4"/>et concitant populum ad seditionem multis in locis et leges <lb xml:id="p1z5"/>sunt irrite, ideoque multi boni timent ruinam aliquam, nec <lb xml:id="p1z6"/>sunt in usu certiora remedia; coniicis reliqua me tacente.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Vellem super ea re, cum vacabit, scribere, quid tibi sanis et prudentibus <lb xml:id="p1z8"/>factu melius videretur.</s>
					<s n="5" xml:lang="la" ana="salute">Salutabis amicos omnes.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l760">S[olutur<lb xml:id="p1z9"/>i]</placeName> 2. maii.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Tuus, quem nosti.</s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
					<s n="9" xml:lang="de">An <pb/><lb xml:id="p2z1"/>herren <persName ref="p495">Heinrichen <lb xml:id="p2z2"/>Bullinger</persName> zuͦ <placeName ref="l587">Zürich</placeName><lb xml:id="p2z3"/>.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
