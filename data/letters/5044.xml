	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Si nescis: <persName>Navarrus</persName> petivit sibi a <lb xml:id="p1z2"/>principibus <placeName ref="l822">Germanis</placeName> viros aliquot doctos mitti.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Certo autem scio <placeName ref="l572">Wirtemb[ergensem]</placeName> misisse <persName>Beurlinum</persName>, <lb xml:id="p1z4"/><persName>Palatinum electorem</persName> <persName ref="p4639">Dillerum</persName> et <persName>Boquinum</persName>; de <lb xml:id="p1z5"/>aliis, an miserint et quos miserint, nescio.</s>
					<s n="4" xml:lang="la">Audio <lb xml:id="p1z6"/>synodum <placeName ref="l1750">Luneburgensem</placeName> damnasse <placeName ref="l558">Wittenbergen[sem]</placeName> <lb xml:id="p1z7"/>et inprimis <persName ref="p20363">Peucerum</persName>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quae superioribus <lb xml:id="p1z8"/>diebus scripsi ad te de conatibus Lutheranorum <lb xml:id="p1z9"/>et confessione <placeName ref="l18">Augustana</placeName> <placeName ref="l832">Gallis</placeName> obtrudenda, quoti<lb xml:id="p1z10"/>die magis magisque confirmantur.</s>
					<s n="6" xml:lang="la">Non male spero <lb xml:id="p1z11"/>de <placeName ref="l2477">Palatino electore</placeName> et <placeName ref="l213">Hesso</placeName>; de aliis varia referuntur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Rursus ergo vigilandum et orandum esse puto.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Comitia <placeName ref="l648">Rhetica</placeName> sunt finita.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Discesserunt summa <lb xml:id="p1z14"/>cum indignatione legati; oleum enim <lb xml:id="p1z15"/>et operam perdiderunt.</s>
					<s n="10" xml:lang="la">Rheti manent in r<lb xml:id="p1z16"/>eligione constantes.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Comitia <placeName>Haeremitana</placeName> <lb xml:id="p1z17"/>inter <placeName ref="l646">Claronenses</placeName> et <placeName ref="l2448">5 Pag[os]</placeName> sunt et ipsa finita.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z18"/>Oblata sunt rursus a 4 iudicibus quaedam pacis <lb xml:id="p1z19"/>capita, quae non possunt recipi a <placeName ref="l646">Claronensibus</placeName> <lb xml:id="p1z20"/>citra religionis verae pernitiem.</s>
					<s n="13" xml:lang="la">Arbitror <lb xml:id="p1z21"/>itaque vel sententia iudicum iuridica c[aus]am <lb xml:id="p1z22"/>terminandam vel armis, quod absit, discutiendum.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z23"/>Principes aliquot in <placeName ref="l822">Germania</placeName> <lb xml:id="p1z24"/>coeperant conscribere militem, quem iam rur<lb xml:id="p1z25"/>sus dimittunt; non perspicue, quae c[au]sa fuerit, <lb xml:id="p1z26"/>rescire adhuc potuimus.</s>
					<s n="15" xml:lang="la">D. <persName ref="p8511">Christo<lb xml:id="p1z27"/>phorum Trecium</persName> <placeName ref="l2472">Polonum</placeName> tibi, domine colende, <lb xml:id="p1z28"/>commendo; integer est et spes de eo maxima <lb xml:id="p1z29"/>est.</s>
					<s n="16" xml:lang="la">Amat te et colit; hybernabit apud <lb xml:id="p1z30"/>vos, ut te audiat.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Si hunc amaveris et studia <lb xml:id="p1z31"/>eius iuveris, universae <placeName ref="l2472">Poloniae</placeName> <lb xml:id="p1z32"/>inservies; amatur ab optimis etc.</s>
					<s n="18" xml:lang="la" ana="farewell">Vale, charissime <lb xml:id="p1z33"/>frater, una cum symmystis et fratribus, d. <persName ref="p2740">Roseto</persName> inprimis.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute"><lb xml:id="p1z34"/>Salutant te nostri <lb xml:id="p1z35"/>o<lb xml:id="p1z36"/>mnes.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Si quid ex <placeName ref="l832">Gallia</placeName> habes, communica; <lb xml:id="p1z37"/>a postremis illis tuis nihil audivi.</s>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z38"/>31. octobris 1561.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p540">Ioanni Calvino</persName>, <lb xml:id="p2z3"/><placeName ref="l167">Genevensis</placeName> ecclesiae <lb xml:id="p2z4"/>fidelissimo pastori, <lb xml:id="p2z5"/>domino suo colendo <lb xml:id="p2z6"/>et fratri charissimo.</s>
				</p>
			</div>
		</body>
