	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">Significavit mihi tabellio noster, qui meas dederat, priores, <lb xml:id="p1z3"/>quas <placeName ref="l586">Zurzachium</placeName> miseram, ad te non pervenisse, et per tuos, qui nuptias comitis <lb xml:id="p1z4"/><persName>Georgii</persName> invisuri essent, te scripturum; quod factumne sit an secus, nescio, <lb xml:id="p1z5"/>nullas enim ego dum vidi.</s>
					<s n="3" xml:lang="la"><placeName ref="l294">Locarnensium</placeName> collectam ursi diligenter, nec <lb xml:id="p1z6"/>difficiles se nostri ostendunt, modo quid et qua ratione a reliquis <lb xml:id="p1z7"/>ordinibus evangelicis praestitum sit, intelligant; quare legatis ad comitia <placeName ref="l21">Badensia</placeName> <lb xml:id="p1z8"/>abeuntibus id negocii dederunt, ut eam rem diligenter explorent.</s>
					<s n="4" xml:lang="la">Ex <lb xml:id="p1z9"/>comiciis <placeName ref="l18">Augustanis</placeName> scripsere fratres ad me pendere adhuc omnia in <lb xml:id="p1z10"/>incerto; <persName ref="p18477">Ferdinandum</persName> prorogationem molire et promittere librum eam in <lb xml:id="p1z11"/>religione moderationem declaraturum, quam non dubitet utrique parti et <lb xml:id="p1z12"/>tolerabilem et acceptam fore, novum nimirum Interim.</s>
					<s n="5" xml:lang="la">Verum, <lb xml:id="p1z13"/>quid responsuri sint et admissuri principes, in eius est manu, qui regit <lb xml:id="p1z14"/>corda regum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">In <placeName ref="l736">Pedemontio</placeName> ferunt turpiter a Caesariano exercitu <lb xml:id="p1z15"/>relictam oppugnationem urbis <persName>S. Iacobi</persName>, quamlibet validis eam machinis <lb xml:id="p1z16"/>consusserint, et viceregem Neapolitanum glande ictum bombardae <lb xml:id="p1z17"/>interiisse.</s>
					<s n="7" xml:lang="la">Historiam lachrymabilem narrabit praesentium la<lb xml:id="p1z18"/>tor de episcopi <placeName ref="l830">Anglici</placeName> casu, pro quo orandus est dominus, ut in tam <lb xml:id="p1z19"/>gravi calamitate animum obtineat infractum, sicut obtinuisse ha<lb xml:id="p1z20"/>ctenus accipimus.</s>
					<s n="8" xml:lang="la" ana="farewell">Sed vale.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l28">Basileae</placeName> 8. septembris anno 1555.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>T[uus] <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, domino et symmistae <lb xml:id="p2z3"/>colendissimo suo.</s>
				</p>
			</div>
		</body>
	</text>
