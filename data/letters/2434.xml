	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Nova plura scriberem, si haberem; sed expecto <lb xml:id="p1z2"/>potius a te; nam expectamus semper exitum <lb xml:id="p1z3"/>commitiorum <placeName ref="l822">Germanicorum</placeName>, in quibus <lb xml:id="p1z4"/><persName>rex Romanus</persName> contra <persName>Caesarem</persName> multa pro <lb xml:id="p1z5"/>successione imperii agit.</s>
					<s n="3" xml:lang="la">Interea <lb xml:id="p1z6"/><persName>Augustus</persName> pacem fecit cum marquione.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Ex <placeName ref="l832">Gallia</placeName> omnia iam quieta sunt; in <lb xml:id="p1z8"/><placeName ref="l2589">Picardia</placeName> Caesar omnes suos milites <lb xml:id="p1z9"/>dimisit insoluto stipendio ut antea.</s>
					<s n="5" xml:lang="la">Ante <lb xml:id="p1z10"/>Mętim et in hoc totus est, ut vocet fil<lb xml:id="p1z11"/>ium ex <placeName ref="l875">Hispania</placeName>, qui parat se ad iter, <lb xml:id="p1z13"/>non in utilitatem <placeName ref="l822">Germanię</placeName>.</s>
					<s n="6" xml:lang="la">Scriberem <lb xml:id="p1z14"/>dominis tuis de induciis ruptis in <lb xml:id="p1z15"/><placeName ref="l736">Pedemontio</placeName>; sed quia hoc solum novi <lb xml:id="p1z16"/>habeo, tibi committo.</s>
					<s n="7" xml:lang="la">Si queras, quare <lb xml:id="p1z17"/>rupte?</s>
					<s n="8" xml:lang="la">quia <persName>Caesar</persName> voluit solus <lb xml:id="p1z18"/>inducias inter se et regem non comprehensis <lb xml:id="p1z19"/>amicis, quod rex noluit admittere.</s>
					<s n="9" xml:lang="la">Quid <lb xml:id="p1z20"/>enim indignius amico esset aperta <pb/><lb xml:id="p2z1"/>proditio.</s>
					<s n="10" xml:lang="la"><placeName ref="l2801">Corsica</placeName> insula magna et opulenta <lb xml:id="p2z2"/>tota nostra est; restabant due arces <lb xml:id="p2z3"/>munitissime et inexpugnabiles, quas <lb xml:id="p2z4"/><placeName ref="l875">Hispani</placeName> et <placeName ref="l1121">Genuenses</placeName> defendebant; sed <lb xml:id="p2z5"/>partim vi, partim iuvantibus civibus <lb xml:id="p2z6"/>recepte sunt, et sic iam tota <lb xml:id="p2z7"/>insula, que 24 urbes... sas <lb xml:id="p2z8"/>et infinitos pagos habet, nostra <lb xml:id="p2z9"/>est.</s>
					<s n="11" xml:lang="la">Rex illic habet iam decem <lb xml:id="p2z10"/>millia peditum, quod <persName>Caesar</persName> omnin<lb xml:id="p2z11"/>o egre fert..<lb xml:id="p2z12"/>. non in Hispam f<lb xml:id="p2z13"/>acile, postea in <placeName ref="l834">Italiam</placeName> <lb xml:id="p2z14"/>descendant.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Scriberem domino <lb xml:id="p2z15"/><persName ref="p3375">Vergerium</persName>; sed fecit mihi spe<lb xml:id="p2z16"/>m <lb xml:id="p2z17"/>per suas ultimas, quod velit nos <lb xml:id="p2z18"/>visitare, quod spero.</s>
					<s n="13" xml:lang="la" ana="farewell">Interea bene <lb xml:id="p2z19"/>vale, vir bone.</s>
					<s n="14" xml:lang="la">Ex <placeName ref="l760">Soluturo</placeName> 21<lb xml:id="p2z20"/>a octobris.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z21"/>Tuus sem<lb xml:id="p2z22"/>per <persName ref="p8296">Bassa<lb xml:id="p2z23"/>fontaneus</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z24"/>Arces ille munitissime <lb xml:id="p2z25"/>in <placeName ref="l2801">Corsica</placeName> vocantur <persName ref="p7101">Bonifacium</persName> et <persName ref="p540">Calvi</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p3z1"/>Viro optimo et amico, <lb xml:id="p3z2"/>domino <persName ref="p495">Bulingero</persName>.</s>
					<s n="18" xml:lang="la"><lb xml:id="p3z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
