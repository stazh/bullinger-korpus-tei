	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">De <placeName>Castalione</placeName> non est quod sis sollicitus, colendissime <lb xml:id="p1z2"/>domine compater; eadem enim prius novimus omnia, quorum <lb xml:id="p1z3"/>tu admones.</s>
					<s n="3" xml:lang="la">Interea tibi pro tua diligentia et <lb xml:id="p1z4"/>sollicitudine pia, quam pro nobis geris, ago gratias maximas.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Puto te interea ex meis cognovisse, quae circa <persName ref="p8386">Hyperii</persName> <lb xml:id="p1z6"/>vocationem contigerint.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Nuncius ipsum accersens iam <lb xml:id="p1z7"/>abivit et speramus intra paucas septimanas nos optatum <lb xml:id="p1z8"/>ab ipso responsum, imo non responsum, sed ipsummet ha<lb xml:id="p1z9"/>bituros.</s>
					<s n="6" xml:lang="la">Sumus etiam de d. <persName ref="p4037">Zancho</persName> loquuti; sed nostri <lb xml:id="p1z10"/>homines Italos supra modum horrent, ut non potuerit ob<lb xml:id="p1z11"/>tineri illius vocatio.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ex <placeName ref="l167">Geneva</placeName> nihildum habemus <lb xml:id="p1z12"/>aliud, quam quę scripsi prius, neque etiam aliquid aliud <lb xml:id="p1z13"/>rerum novarum.</s>
					<s n="8" xml:lang="la">Hic, qui has defert, cupit te alloqui, <lb xml:id="p1z14"/>cui etiam, ut occasionem te conveniendi haberet, has tra<lb xml:id="p1z15"/>didi, quas alioqui <persName>Löffelspergero</persName>, per quem tuas misisti, <lb xml:id="p1z16"/>daturus eram.</s>
					<s n="9" xml:lang="la"><persName>Silesianus</persName> est natione et concionatorem <lb xml:id="p1z17"/>agit aulicum <placeName ref="l327">Mompelgardi</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Venit in has <lb xml:id="p1z18"/>partes <placeName ref="l862">Helvetiae</placeName> videndae gratia.</s>
					<s n="11" xml:lang="la">Praestitimus illi, quae potuimus <lb xml:id="p1z19"/>officia; qua humanitate vos peregrinos excipere soleatis, <lb xml:id="p1z20"/>non ignoro; itaque, ut ipsum operosius tibi commendem, opus <lb xml:id="p1z21"/>non est.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale, mi exoptatissime et colendissime compater..</s>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z22"/>Salutem uxori universaeque domui tuae una cum fratribus <lb xml:id="p1z23"/>omnibus et symmystis meo nomine dicas, velim.</s>
					<s n="14" xml:lang="la" ana="salute">Salutant te <lb xml:id="p1z24"/>nostri omnes.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l41">Bernae</placeName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori <lb xml:id="p2z4"/>fidelissimo, domino <lb xml:id="p2z5"/>suo colendissimo com<lb xml:id="p2z6"/>patrique charissimo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>