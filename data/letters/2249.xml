	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>C<lb xml:id="p1z3"/>laris<lb xml:id="p1z4"/>s<lb xml:id="p1z5"/>i<lb xml:id="p1z6"/>mo atque ornatissimo domino, salutem per Iesum Christum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z7"/>Accepi iampridem a d. d. <persName ref="p8111">Petro M[artyre</persName>] doctissimum tuum, quem <lb xml:id="p1z8"/>ad me misisti, de gratia dei iustificante libellum, du<lb xml:id="p1z9"/>plice nomine mihi longe gratissimum, primum quod materiam contineat <lb xml:id="p1z10"/>piis omnibus gratissimam et singulari a te gratia <lb xml:id="p1z11"/>explicatam, deinde quod, quatenus a te mihi dono <lb xml:id="p1z12"/>est datus, apertum sit testimonium amoris erga me tui, <lb xml:id="p1z13"/>ita ut simul, qui et gratiam dei in nos per Christum tradit, <lb xml:id="p1z14"/>idem in quanta sim tecum gratia facile testetur idque <lb xml:id="p1z15"/>nulla alia de causa quam quę tua et humanitas et <lb xml:id="p1z16"/>pietas singularis.</s>
					<s n="3" xml:lang="la">Qua de re habui quidem et <lb xml:id="p1z17"/>voluntarie retuli iustam debitamque tibi gratiam; sed literis <lb xml:id="p1z18"/>hactenus meis multis variisque negotiis distentus agere <lb xml:id="p1z19"/>nequivi, et ut par erat et ut percupiebam.</s>
					<s n="4" xml:lang="la">Nunc e<lb xml:id="p1z20"/>rgo iisce literis gratias ago maximas tibi, doctissime mi <lb xml:id="p1z21"/><persName ref="p495">Bullingere</persName>, pro tuo ad me misso libello et singulari <lb xml:id="p1z22"/>gratia gratiam dei per Christum nobis partam explicante et <lb xml:id="p1z23"/>testimonium gratię atque amoris erga me tui praebente, <lb xml:id="p1z24"/>deinde obsecro, si tardior ad debitam tibi referendam <lb xml:id="p1z25"/>gratiam fuerim, quam tamen certe mente persolvi, mihi <lb xml:id="p1z26"/>ignoscas bonique consulas mea ad scribendum tar<lb xml:id="p1z27"/>ditatem.</s>
					<s n="5" xml:lang="la">Sum etenim tot tantisque negotiis et occupationi<lb xml:id="p1z28"/>bus tum studiorum meorum necessariorum tum rei fami<lb xml:id="p1z29"/>liaris et domesticę districtus, ut vix ad te, mihi obser<lb xml:id="p1z30"/>vandissimum patrem, nedum ad alios possim vel quatuor <lb xml:id="p1z31"/>lineas scribere; usque adeo parum a necessariis <lb xml:id="p1z32"/>occupationibus mihi superest otii.</s>
					<s n="6" xml:lang="la">Gravida est uxor, d<lb xml:id="p1z33"/>estituor servo, legendum et in theologia et in <lb xml:id="p1z34"/>philosophia et quid non.</s>
					<s n="7" xml:lang="la">Curabo tamen, quoad eiu<lb xml:id="p1z35"/>s fieri poterit, ut, si non longas propter occupationes, <lb xml:id="p1z36"/>aliquas tamen etsi perbreves propter officium ad te literas mittam, <lb xml:id="p1z37"/>tum vero praesertim, cum aliquid inciderit vel novi <lb xml:id="p1z38"/>vel necessarii, quod ad te scribatur, non indignum.</s>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z39"/>Interim bene vale et me, ut facis, amare pergas.</s>
					<s n="9" xml:lang="la" ana="salute"><lb xml:id="p1z40"/>Saluto omnes istos sanctos et doctos viros.</s>
					<s n="10" xml:lang="la">Deus vos <lb xml:id="p1z41"/>conservet.</s>
					<s n="11" xml:lang="la"><placeName ref="l491">Argentina</placeName> <lb xml:id="p1z42"/>calendis aprilis <lb xml:id="p1z43"/>1554.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>T<lb xml:id="p2z2"/>ui s<lb xml:id="p2z3"/>tudiosissim<lb xml:id="p2z4"/>us <persName ref="p4037">Hi<lb xml:id="p2z5"/>erony<lb xml:id="p2z6"/>mus <lb xml:id="p2z7"/>Zanchus</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z8"/>Doctiss<lb xml:id="p2z9"/>im<lb xml:id="p2z12"/>o simul et piissimo viro d. <lb xml:id="p2z13"/><persName ref="p495">Henrico Bullingero</persName>, ecclesię <lb xml:id="p2z14"/><placeName ref="l587">Tigurinę</placeName> pastori di<lb xml:id="p2z15"/>gniss<lb xml:id="p2z16"/>im<lb xml:id="p2z17"/>o <lb xml:id="p2z23"/>e<lb xml:id="p2z25"/>t patri <lb xml:id="p2z26"/>obs<lb xml:id="p2z27"/>er<lb xml:id="p2z29"/>va<lb xml:id="p2z30"/>ndi<lb xml:id="p2z31"/>ssi<lb xml:id="p2z35"/>mo<lb xml:id="p2z36"/>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z37"/><placeName ref="l587">T<lb xml:id="p2z38"/>i<lb xml:id="p2z39"/>g<lb xml:id="p2z40"/>u<lb xml:id="p2z41"/>ru<lb xml:id="p2z44"/>m</placeName>.</s>
				</p>
