	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Gratissimae mihi fuerunt tuae literę (observandissime) <lb xml:id="p1z3"/>cum propter <foreign xml:lang="el">συμπάθειαν</foreign>, quam in meis adversis ostendunt, <lb xml:id="p1z4"/>tum propter pietatis tuae studium erga me et amorem <lb xml:id="p1z5"/>iam mihi perspectum vere paternum.</s>
					<s n="3" xml:lang="la">Post <lb xml:id="p1z6"/>duas hebdomadas quam superiores meas ad te <lb xml:id="p1z7"/>dedissem, literae ex <placeName ref="l830">Anglia</placeName> mihi redditae sunt, <lb xml:id="p1z8"/>quae declarant me penitus exutum, quomodo <lb xml:id="p1z9"/>ante fuit expositum, sed tamen aliunde spem iam <lb xml:id="p1z10"/>aliquam apparere.</s>
					<s n="4" xml:lang="la">Mei igitur putavi te certiorem <lb xml:id="p1z11"/>de eo facere primo quoque tempore, ut quem<lb xml:id="p1z12"/>ad<lb xml:id="p1z13"/>modum antea dolorem mea causa cępisti, ita <lb xml:id="p1z14"/>gratias iam agas deo patri nostro mecum: <lb xml:id="p1z15"/>quem non dubito quin mecum comprecatus fueris, <lb xml:id="p1z16"/>meque ei commendaveris et causam meam.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z17"/>Et de <persName>Bancho</persName> est quamobrem magnopere <lb xml:id="p1z18"/>tibi gratias agam.</s>
					<s n="6" xml:lang="la">Leverus enim (charissimus <lb xml:id="p1z19"/>noster frater) mihi ostendit d. <persName ref="p3099">Sulserum</persName> consti<lb xml:id="p1z20"/>tuisse, ut <persName>Banchum</persName> mittam (ad nundinas <placeName ref="l157">Ffran<lb xml:id="p1z21"/>cofordienses</placeName>) <placeName ref="l28">Basileam</placeName>: nam is <placeName>Parchum</placeName> quendam <lb xml:id="p1z22"/>convenit (typographum puto) apud quem <persName>Banchum</persName> <lb xml:id="p1z23"/>collocabit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Plura vellem, sed subito interpellor <lb xml:id="p1z24"/>de nuncio, qui has perferat extemplo primo mane.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z25"/>Quęso igitur a te, ut in eam partem accipias quam <lb xml:id="p1z26"/>mea soles omnia.</s>
					<s n="9" xml:lang="la">Nam hęc arbitrabar me debere <lb xml:id="p1z27"/>in presenti potius quam nihil, ne maiori tibi dolori <lb xml:id="p1z28"/>et solicitudini essemus quam par est; quia non modo <lb xml:id="p1z29"/>ex tuis literis perspexi, sed ex aliis intellexi, <lb xml:id="p1z30"/>de sollicita diligentia quam suscipere statueras, si <lb xml:id="p1z31"/>hac non successisset pro <persName>Bancho</persName>.</s>
					<s n="10" xml:lang="la">Deus te diu <lb xml:id="p1z32"/>conservet ad suae ecclesiae commodum et multorum <lb xml:id="p1z33"/>consolationem.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l491">Argentinae</placeName>, 8 ianiarii, 1555.<note type="misc">"1554"</note></s>
					<s n="12" xml:lang="la"><lb xml:id="p1z34"/>Tui studiosissimus, <persName ref="p1422">Ia<lb xml:id="p1z35"/>cobus Haddonus</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro et observan<lb xml:id="p2z2"/>dissimo (in Christo) patri, <lb xml:id="p2z3"/>d. <persName ref="p495">Bullingero</persName>, ecclesię <lb xml:id="p2z4"/><placeName ref="l587">Tigurinę</placeName> antistiti.</s>
				</p>
			</div>
