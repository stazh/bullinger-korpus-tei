	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S. <lb xml:id="p1z6"/>D<lb xml:id="p1z7"/>.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z8"/>Nihil nunc habeo, quod scribam, dilecte <lb xml:id="p1z10"/>frater et compater, nisi quod ea, quae nuper <lb xml:id="p1z11"/>ad te scripsi de clade regis accepta ad <placeName ref="l1777">S. <lb xml:id="p1z12"/>Quintinum</placeName>, quotidie magis magisque confirmantur.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z13"/>De colloquio <placeName ref="l569">Wormaciensi</placeName> nunc nihil habeo <lb xml:id="p1z14"/>certi.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ex illa clade erigunt cristas papistae <lb xml:id="p1z15"/>per Germaniam, non quod existiment evangelium <lb xml:id="p1z16"/>a Gallo iri promotum, sed quod viribus eis <lb xml:id="p1z17"/>fractis pollicentur sibi <persName>Philippum</persName> omnes vires <lb xml:id="p1z18"/>conversurum ad defensionem papatus.</s>
					<s n="5" xml:lang="de">Es darff inen <lb xml:id="p1z19"/>aber fälen wie bißhar; <foreign xml:lang="la">vivit, qui vicit.</foreign></s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z20"/>En mitto tibi <persName>Centum</persName> meas conciones editas <lb xml:id="p1z21"/>in Apocalypsim.</s>
					<s n="7" xml:lang="la">Tuo arbitrio autem permitto, in <lb xml:id="p1z22"/>manibus et possessione tua retineas et ita d. <persName>Philippo</persName> <lb xml:id="p1z23"/>et amicis communices an deponas in biblio<lb xml:id="p1z24"/>t<lb xml:id="p1z25"/>hecam ecclesiae vestrae, ut sic omnes, qui voluerint, <lb xml:id="p1z26"/>hoc opere uti queant.</s>
					<s n="8" xml:lang="la" ana="farewell">Germanicum libellum <lb xml:id="p1z27"/>d. <persName>Ioannis Anastasii Geldri [i. e. Veluanus]</persName>, qui se nuncupant <lb xml:id="p1z28"/><persName>Adamum Christianum</persName>, exhibere potes etiam d. d. consulibus, <lb xml:id="p1z29"/>et cui volueris, iamque aeternum vale una cum <lb xml:id="p1z30"/>uxore tua, liberis, domo tua, d. d. consulibus, d. <persName>Philippo</persName>, <lb xml:id="p1z31"/>d. <persName ref="p6130">Pontasella</persName> et amicis omnibus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z32"/>2. septembris anno 1557.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z33"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Io<lb xml:id="p2z2"/>anni Fabritio</persName>, com<lb xml:id="p2z3"/>patri et fratri colendissim<lb xml:id="p2z4"/>o et charissimo suo.</s>
				</p>
				<p>
					<s n="12" xml:lang="de"><lb xml:id="p2z5"/>Dem herren pfarrer <lb xml:id="p2z6"/>zuͦ Sant Martin ze <lb xml:id="p2z7"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
