	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ex tuis literis de tua valutudine parum firma certior sum factus, <lb xml:id="p1z2"/>meliorem spero, cum tamen non possit non esse bona tibi, qui omnia <lb xml:id="p1z3"/>suscipis tamquam e manu patris benevolentissimi, qui suis ea reddit <lb xml:id="p1z4"/>dulcia, que aliis amara et dura solent apparere, et te iandiu <lb xml:id="p1z5"/>instruxit et armavit contra omnes insultus et tentationes.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Si quid haberem, quo posses recreari et convalescere, non <lb xml:id="p1z7"/>prętermitterem.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Tuę quęso incolumitati eorumque, qui a te pendent, <lb xml:id="p1z8"/>consule et omnia a me studia officiaque expecta.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Misi d. <persName ref="p8011">Valtero</persName>, <lb xml:id="p1z9"/>que ex <placeName ref="l822">Germania</placeName> et <placeName ref="l736">Pedemontio</placeName> ad me scripta sunt, que communicabit <lb xml:id="p1z10"/>puto <placeName ref="l822">Germanos</placeName> et <placeName ref="l862">Helvetios</placeName> e castris discessisse et redire ad <lb xml:id="p1z11"/>suos.</s>
					<s n="6" xml:lang="la">Adhuc suspenso animo sum, quę sit futura catastrophe colloquii <lb xml:id="p1z12"/>de pace.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Ubi aliquid certi intellexero, amplissimo senatui <placeName ref="l587">Tigurino</placeName> scribam, <lb xml:id="p1z13"/>quem meis verbis salutabis.</s>
					<s n="8" xml:lang="la">Erit mihi maiorem in modum gratum, <lb xml:id="p1z14"/>si filium commendatum habueris.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l760">Soluturi</placeName> 12. novembris.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z15"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z2"/>ecclesie <placeName ref="l587">Tigurine</placeName> pastori et <lb xml:id="p2z3"/>symmiste vigilantissimo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
