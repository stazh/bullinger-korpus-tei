	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Humanissimas tuas literas 23. iunii scriptas accepi ultimo(a?)</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Augusti, doctissime <persName ref="p495">Bullingere</persName>.</s>
					<s n="3" xml:lang="la">Quae quantum mihi animum addidere, <lb xml:id="p1z3"/>quantum inflammarint, ut in functione mea alacris sim et fortis <lb xml:id="p1z4"/>in domino, haud facile dixero: tu huiusmodi calcaribus sub<lb xml:id="p1z5"/>inde me instiges oro.</s>
					<s n="4" xml:lang="la">Equo tardigrado admovenda calcaria.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Dominus convertat aut conterat quinque Palaestinorum satrapias, quae <lb xml:id="p1z7"/>piis molestias exhibere non desinunt!</s>
					<s n="6" xml:lang="la">Quod <persName ref="p505">Burcherus</persName> a putido <lb xml:id="p1z8"/>illo scorto, facto divortio, sit avulsus, gaudeo; quod aliam <lb xml:id="p1z9"/>duxerit, felix illi faustumque sit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">De <persName ref="p505">Burchero</persName> <persName ref="p505">Burcherique</persName> rebus <lb xml:id="p1z10"/>ad <persName ref="p505">Burcherum</persName> nunc scribo.</s>
					<s n="8" xml:lang="la">Ab illo cetera disces.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Ubiquitistis <lb xml:id="p1z11"/>meliorem mentem opto, si modo mentem habeant, cum sint et <lb xml:id="p1z12"/>amentes et dementes; quos facile debellabitis tu et dominus <lb xml:id="p1z13"/><persName ref="p8111">Martyr</persName>.</s>
					<s n="10" xml:lang="la">Sed novi gloriosorum ingenium.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Victi non cedent; <lb xml:id="p1z14"/>at nisi resipuerint, vincet eos Christus, vinciet et Satanas.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z15"/>Dominus <persName>Palatinum</persName> <persName>Rheni</persName> et <persName>Hessum</persName> suo spiritu corrob ret, <lb xml:id="p1z16"/>et incolumes diu servet!</s>
					<s n="13" xml:lang="la">Caetera narravit tibi <persName ref="p4491">Iulius</persName>, <lb xml:id="p1z17"/>qui fuit multorum non tantum auritus, sed et oculatus testis.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z18"/>Resaluta nostro nomine optimam tuam uxorem, filios, filias, <lb xml:id="p1z19"/>generos, d. <persName ref="p8111">Martyrem</persName>, d. <persName ref="p1283">Gesnerum</persName>, <persName ref="p3988">Wolphium</persName> et omnes.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Mea <lb xml:id="p1z20"/>vos omnes.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Raptim, <placeName ref="l299">Ludhamiae</placeName>, 1 septembris 1561.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z21"/>Tuus <persName ref="p2473">Ioannes Parkhurstus</persName> <lb xml:id="p1z22"/><placeName ref="l352">Nordovicensis</placeName><lb xml:id="p1z23"/>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z24"/>Omnibus verbi ministris per totam <placeName ref="l1956">Suffolciam</placeName> et <placeName ref="l722">Norfolciam</placeName> in man<lb xml:id="p1z25"/>datis dedi, ut tuas conciones in Apocalypsim sibi comparent <lb xml:id="p1z26"/>vel Latine vel Anglice.</s>
					<s n="19" xml:lang="la">In nostram enim vernaculam linguam <lb xml:id="p1z27"/>transtulit <persName>Iohannes Daus</persName>, vir bonus et doctus, ludimoderator <lb xml:id="p1z28"/>in urbe <placeName>Ypsvico</placeName>.</s>
					<s n="20" xml:lang="la" ana="farewell"><lb xml:id="p1z29"/>Iterum vale, et valeant <placeName ref="l587">Tigurini</placeName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
