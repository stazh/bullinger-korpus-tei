	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Accepi, que a <persName ref="p3375">Verg[erio]</persName> misisti et gratias ago; illi <lb xml:id="p1z2"/>raptim respondi et rogo, velis per fidelem <lb xml:id="p1z3"/>dimittere, ne litere perdantur; ego enim satisfaciam <lb xml:id="p1z4"/>expensum.</s>
					<s n="3" xml:lang="la">Videbis, que illi scribo; nolui <lb xml:id="p1z5"/>enim literas claudere, ut, si quid te dignum sit et novu<lb xml:id="p1z6"/>m, legas.</s>
					<s n="4" xml:lang="la">Timeo <placeName ref="l830">Anglica<lb xml:id="p1z7"/>num</placeName> <lb xml:id="p1z8"/>matrimonium, cui cum <persName ref="p18538">Caesare</persName> iste papa contra nos adheret.</s>
					<s n="5" xml:lang="la" ana="salute"><lb xml:id="p1z9"/>Saluto tuos dominos e te imprimis et cupio, ut <lb xml:id="p1z10"/>valeas.</s>
					<s n="6" xml:lang="la">Ex <placeName ref="l760">Soluturo</placeName> 29a decembris.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Tuus semper <lb xml:id="p1z11"/><persName ref="p8296">Bass[afontan<lb xml:id="p1z12"/>eus]</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
