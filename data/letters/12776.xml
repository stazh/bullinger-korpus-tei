	<text xml:lang="de">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Novi nihil habeo, quod <persName ref="p8418">Myconius</persName> non <lb xml:id="p1z2"/>scribat.<note xml:id="fn1" type="footnote" n="1">Gemeint ist <persName ref="p8418">Myconius</persName>' Brief vom gleichen Tag (<ref target="file12777">Nr. 2729</ref>).</note></s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="3" xml:lang="de"><persName ref="p19065">Saxo</persName><note xml:id="fn2" type="footnote" n="2">Kurfürst <persName ref="p19065">Johann Friedrich I. von Sachsen</persName>.</note> hat dem <persName ref="p7548">bischoff</persName> von <placeName ref="l307">Mentzs</placeName><note xml:id="fn3" type="footnote" n="3"><persName ref="p7548">Sebastian von Heusenstamm</persName>, Erzbischof von <placeName ref="l307">Mainz</placeName>.</note> <lb xml:id="p1z3"/>syne stettli geschetz<note xml:id="fn4" type="footnote" n="4">gebrandschatzt, Lösegeld gefordert; s. <bibl source="b260">Grimm</bibl> XIV 2281. - Zur Sache s. <ref target="file12770">Nr. 2723</ref>,115f; <ref target="file12773">Nr. 2725</ref>.41: <ref target="file12777">Nr. 2729</ref>,28f.</note>, probant<note xml:id="fn5" type="footnote" ana="lex" n="5">Proviant.</note> in dörfferen gnomen, <lb xml:id="p1z4"/>keyni bezalt.</s>
					<s n="4" xml:lang="de">Het dem bischoff vil schadens gethon, <lb xml:id="p1z5"/>ouch den geistlichen, die er im durchziehen<note xml:id="fn6" type="footnote" n="6">Nämlich auf dem Weg zurück nach <placeName ref="l749">Sachsen</placeName>. - Zur Route des Kurfürsten s. <ref target="file12747">Nr. 2700</ref>, Anm. 5.</note> hat <lb xml:id="p1z6"/>begriffen.<note xml:id="fn7" type="footnote" n="7">angegriffen; s. <bibl source="b590">SI</bibl> II 719.</note></s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="5" xml:lang="la">De morte <persName ref="p18538">caesaris</persName><note xml:id="fn8" type="footnote" ana="bio" n="8"><persName ref="p18538">Karl V.</persName> - Zum falschen Gerücht über dessen Tod s. die Verweise in <ref target="file12747">Nr. 2700</ref>, Anm. 20.</note> fama incerta.</s>
					<s n="6" xml:lang="de">Ich <lb xml:id="p1z7"/>vermerck<note xml:id="fn9" type="footnote" n="9">bemerke; s. <bibl source="b590">SI</bibl> IV 408.</note>, das die stett unwillig sindt zuͦ kriegen.</s>
					<s n="7" xml:lang="de"><lb xml:id="p1z8"/>Moͤ<lb xml:id="p1z9"/>gen nütt umb Christi willen liden,<note xml:id="fn10" type="footnote" n="10">Anspielung auf die mehr oder weniger freiwillige Unterwerfung der Städte unter den Kaiser, die von <persName ref="p1278">Gast</persName> wie auch von <persName ref="p8418">Myconius</persName> als Abfall vom Evangelium gedeutet wurde; vgl. <ref target="file12773">Nr. 2725</ref>,9-14. 37- 42; <ref target="file12777">Nr. 2729</ref>,15-17.</note> so<note xml:id="fn11" type="footnote" ana="lex" n="11">während.</note> sy doch <lb xml:id="p1z11"/>umbs düffels willen vil muͤssen liden, so die baͤpst<lb xml:id="p1z12"/>liche tyrannei wider anheben<note xml:id="fn12" type="footnote" ana="lex" n="12">anfangen.</note> wirt.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="8" xml:lang="de">Ich hette üch <lb xml:id="p1z13"/>langest<note xml:id="fn13" type="footnote" ana="lex" n="13">längst.</note> wollen<note xml:id="fn14" type="footnote" n="14">die Wolle. - Zu dieser Angelegenheit s. zuletzt <ref target="file12771">Nr. 2724</ref>,28-31.</note> koufft, so ich ein gwüssen<note xml:id="fn15" type="footnote" n="15">zuverlässigen. - <persName ref="p1278">Gast</persName> vertraute die Sendung dem von <persName ref="p495">Bullinger</persName> in <ref target="file12771">Nr. 2724</ref>,291, empfohlenen (unbekannten) Boten an.</note> botten hette <lb xml:id="p1z14"/>gehan.</s>
					<s n="9" xml:lang="de">Ir solten lassen kouffen umb pfingsten.</s>
					<s n="10" xml:lang="de">Do <lb xml:id="p1z15"/>fynde mann die waal<note xml:id="fn16" type="footnote" n="16">beste Qualität; s. <bibl source="b590">SI</bibl> XV 1129f.</note>, <pb type="edition" next="451"/> nachdem sy geferwt<note xml:id="fn17" type="footnote" ana="lex" n="17">gefärbt.</note> <lb xml:id="p1z16"/>haben.</s>
					<s n="11" xml:lang="de">Aber dise kostet 2 gulden.</s>
					<s n="12" xml:lang="de">Sindt 5 lib.<note xml:id="fn18" type="footnote" n="18">Pfund (Gewicht). Es entspricht etwa 0,53 kg. <persName ref="p1278">Gast</persName> hat also etwa 2,6 kg Wolle für <persName ref="p495">Bullinger</persName> erworben.</note></s>
					<s n="13" xml:lang="de"><lb xml:id="p1z17"/>Kostet ein pfundt 10 ß.<note xml:id="fn19" type="footnote" n="19">Schilling. - 1 Pfund (Währung) = 20 Schilling. Demzufolge waren damals in <placeName ref="l28">Basel</placeName> 50 Schillinge, d.h. 2,5 Pfund (Währung), etwa 2 Gulden wert.</note></s>
					<s n="14" xml:lang="de">Es sindt ouch etlich strangen.<note xml:id="fn20" type="footnote" n="20">Strähnen; s. <bibl source="b590">SI</bibl> XI 2288f.</note></s>
					<s n="15" xml:lang="de"><lb xml:id="p1z18"/>Die sindt zertheilt.</s>
					<s n="16" xml:lang="de">Haben feden.<note xml:id="fn21" type="footnote" ana="lex" n="21">Fäden.</note></s>
					<s n="17" xml:lang="de">Darumb sondt<note xml:id="fn22" type="footnote" n="22">sollt; vgl. <bibl source="b590">SI</bibl> VII 770.</note> ir nit <lb xml:id="p1z19"/>gedencken, das es wuͤrmstüchige<note xml:id="fn23" type="footnote" n="23">"wurmstichige", hier: von zweifelhafter Qualität, schlechte; s. <hi>SI X</hi> 1310.</note> wollen sey.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="18" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z20"/>in domino.</s>
					<s n="19" xml:lang="de" ana="salute">Gruesset mir ewer <persName ref="p8051">hußfrowen</persName><note xml:id="fn24" type="footnote" ana="bio" n="24"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> und kinder<note xml:id="fn25" type="footnote" n="25">Zu deren Namen s. <ref target="file12651">Nr. 2604</ref>, Anm. 25.</note> <lb xml:id="p1z21"/>alle, etc.</s>
					<s n="20" xml:lang="de"><placeName ref="l28">Basel</placeName>, die Innocentum<note xml:id="fn26" type="footnote" n="26">Innocentum puerorum, der Tag der Unschuldigen Kinder; vgl. <cit type="bible"><ref>Mt 2, 16</ref></cit>.</note> 1546.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z22"/>Tuus <persName ref="p1278">Gastius</persName> <lb xml:id="p1z23"/>ex animo.</s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="22" xml:lang="de"><lb xml:id="p1z24"/>Ich hab nit kynnen, <lb xml:id="p1z25"/>ja<note xml:id="fn27" type="footnote" n="27">Hier im Sinne von "genauer gesagt" oder "also"; vgl. <bibl source="b590">SI</bibl> III 3.</note> min <persName ref="p4970">frow</persName><note xml:id="fn28" type="footnote" ana="bio" n="28"><persName ref="p4970">Apollonia, geb. Glaser</persName>.</note>, mynder<note xml:id="fn29" type="footnote" ana="lex" n="29">weniger.</note> <lb xml:id="p1z26"/>wollen nemen.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="23" xml:lang="de"><pb/><lb xml:id="p2z1"/>Diser brieff gehoͤrt <lb xml:id="p2z2"/>dem wolgelerten herren, <lb xml:id="p2z3"/>meyster <persName ref="p495">Heinrich <lb xml:id="p2z4"/>Bullinger</persName>, leutprie<lb xml:id="p2z5"/>steren zuͦ <placeName ref="l587">Zürich</placeName>, <lb xml:id="p2z6"/>mynem lieben, guͤnsti<lb xml:id="p2z7"/>gen herren, zuͦ han<lb xml:id="p2z8"/>den.</s>
				</p>
			</div>
		</body>
	</text>
