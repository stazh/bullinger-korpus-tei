	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Remitto tibi, colendissime domine compater, con<lb xml:id="p1z2"/>fessionem illam nostratium una cum reliquis, <lb xml:id="p1z3"/>quae simul misisti, et ago tibi pro his magnas <lb xml:id="p1z4"/>gratias.</s>
					<s n="3" xml:lang="la">Vides me non sine ratione parum fidere nos<lb xml:id="p1z5"/>tris <placeName ref="l832">Gallis</placeName>; versipelles sunt et plurimum de <lb xml:id="p1z6"/>spiritu <persName ref="p467">Buceri</persName> suxerunt, qui hos vocum dubiarum <lb xml:id="p1z7"/>lusus in ecclesiam relicta veritatis synceritat<lb xml:id="p1z8"/>e et simplicitate induxit.</s>
					<s n="4" xml:lang="la">Si res fieret <lb xml:id="p1z9"/>cognita apud senatum nostrum, gravissime <lb xml:id="p1z10"/>scio plecteretur <persName ref="p8033">Beza</persName>; alter enim minus ad nos <lb xml:id="p1z11"/>pertinet.</s>
					<s n="5" xml:lang="la">Vides igitur, quid efficeremus per illos homines, <lb xml:id="p1z12"/>si ad colloquium esset deveniendum; proderent illi <lb xml:id="p1z13"/>nos una cum simplicitate veritatis, et si ab <lb xml:id="p1z14"/>ipsis dissentire vellemus, maius oriretur schisma <lb xml:id="p1z15"/>et gravius quam antea infligeretur ecclesię <lb xml:id="p1z16"/>vulnus.</s>
					<s n="6" xml:lang="la">Ego tamen haec, uti mones, nemini pro<lb xml:id="p1z17"/>palabo.</s>
					<s n="7" xml:lang="la">Mihi cum <persName ref="p18846">Lutherano</persName> quodam praet<lb xml:id="p1z18"/>eritis diebus concertatio fuit, quamvis non de <lb xml:id="p1z19"/>doctrina; itaque in terrorem aliorum hic quoque e <lb xml:id="p1z20"/>ditione <placeName ref="l41">Bernensi</placeName> a magnifico senatu nostro re<lb xml:id="p1z21"/>legatus est.</s>
					<s n="8" xml:lang="la"><placeName ref="l167">Genevenses</placeName> pergunt suo more; quendam <lb xml:id="p1z22"/>suorum civium nuper, qui cum exulibus <lb xml:id="p1z23"/>ipsorum prandium sumpserat in hospitio quodam <lb xml:id="p1z24"/>ditioni ipsorum confini, tortum decollarunt <lb xml:id="p1z25"/>et caput palo infixerunt erecto e regione eius <lb xml:id="p1z26"/>hospitii, ubi pransi erant, ut videatur in illud [in]tu<lb xml:id="p1z27"/>eri.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Quid ex eo tandem secuturum sit, pru[dentes] <lb xml:id="p1z28"/>facile cognoscunt.</s>
					<s n="10" xml:lang="la">Dominus avertat a nobis haec m[ala].</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z29"/>Rerum novarum nihil habemus, quam quę habetis <lb xml:id="p1z30"/>ipsi.</s>
					<s n="12" xml:lang="la">Puerum <persName>Pfenningeri</persName> habebo commendatum; <lb xml:id="p1z31"/>quamvis mihi sit magna molestia ipsis debitum <lb xml:id="p1z32"/>praestare officium, praesertim cum sint negligentes; <lb xml:id="p1z33"/>aut enim dissimulandum hoc, quod pie fieri non <lb xml:id="p1z34"/>potest, aut offendendi patres cum filiis.</s>
					<s n="13" xml:lang="la">Faciam <lb xml:id="p1z35"/>tamen, quod potero.</s>
					<s n="14" xml:lang="la" ana="farewell">Tu cum tuis bene vale.</s>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z36"/>Saluta quaeso meo nomine d. <persName ref="p8111">Martyrem</persName>, <persName ref="p8171">Bibliandrum</persName>, <lb xml:id="p1z37"/><persName ref="p8011">Gualtherum</persName> et generos tuos omnes.</s>
					<s n="16" xml:lang="la" ana="salute">Salutant te <lb xml:id="p1z38"/>nostri diligenter.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l41">Bernę</placeName> 26. iulii 1557.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p8018">I[oannes] H[allerus</persName>] tu<pb/><lb xml:id="p2z1"/>us.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="19" xml:lang="la">Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, domino <lb xml:id="p2z4"/>et compatri colendissimo <lb xml:id="p2z5"/>charissimoque suo <lb xml:id="p2z6"/><foreign xml:lang="de">M. <persName ref="p495">Heinrych Bullingeren</persName> <lb xml:id="p2z7"/>zuͦ <placeName ref="l587">Zürich</placeName>.</foreign></s>
				</p>
			</div>
