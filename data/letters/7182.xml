	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>humanissimas literas tuas accepi cum tu
					<lb xml:id="p1z2"/>Thermis rediisses et ego in maximo negotiorum
					<lb xml:id="p1z3"/>versarer, ad eos, qui ad te de rebus Gallicis
					<lb xml:id="p1z4"/>afferebantur rumores nihil erat, quod responderim,
					<lb xml:id="p1z5"/>neque enim mihi quicquam horum vel compertum
					<lb xml:id="p1z6"/>erat vel unde expiscari possem satis perspiceri
					<lb xml:id="p1z7"/>potiram. tunc vero alia omnia amicorum ad
					<lb xml:id="p1z8"/>continebam, non video, cur nos (ut Hispanicam
					<lb xml:id="p1z9"/>besnvolentiam promereamur vel potius impotitiam
					<lb xml:id="p1z10"/>augeamus tam facile tamquam imprudentir in tam
					<lb xml:id="p1z11"/>apertium periculum certam potius nuinam consinienr.
					<lb xml:id="p1z12"/>velimus. euorcum autem sa tantae belli malorumque
					<lb xml:id="p1z13"/>evasurae sint iudicar deus, cui non modo
					<lb xml:id="p1z14"/>futurae hominum acticu, virum etiam consilia in
					<lb xml:id="p1z15"/>mumirato eum quoque eusque lege exceptis caelita omnia
					<lb xml:id="p1z16"/>flura caduca incerta instabiliaque enum. Hispani
					<lb xml:id="p1z17"/>in infrioritu Germaniam contilidum aiunt nonnulli
					<lb xml:id="p1z18"/>peticulum ab eis niminite Frisiis, si comitibus emboorii
					<lb xml:id="p1z19"/>qui Flandros horpitio excepite. Caerar de Miseto Paxoni
					<lb xml:id="p1z20"/>triumphas Turcae de impetio omnibus impetii suffragii
					<lb xml:id="p1z21"/>triumphum defert Augustus novae monentae inscribi. Tandem
					<pb/>
					<lb xml:id="p2z1"/>bona causa triumphar. Cum homicus strphavus
					<lb xml:id="p2z2"/>somutum nonnullosque alios poctus eius typis excuto
					<lb xml:id="p2z3"/>ad me misisset tibi Gvalttoqus, doctissimos scriptar
					<lb xml:id="p2z4"/>doctissimis viris communicandos putavi remisit ide
					<lb xml:id="p2z5"/>Strphanus veltum poctorum idetu syntagina, dicet
					<lb xml:id="p2z6"/>aliquis priorium illam divisionem tinar uibisque a
					<lb xml:id="p2z7"/>limine tantum salutatis a me factum ego contra
					<lb xml:id="p2z8"/>audicio factam esse contendo. Quid etim Bullingero
					<lb xml:id="p2z9"/>ei millus coniunctiusve Gvaltto esse potest, sed tamen
					<lb xml:id="p2z10"/>n in tite improba presevctare viderir Baltazariui.
					<lb xml:id="p2z11"/>nostrum cum iisditu pocitis ad vos remittardinm putavi
					<lb xml:id="p2z12"/>a quo etiam de rebus nostris cetliora audiex. bave vale.
					<lb xml:id="p2z13"/>dominus Gvalthus hic sibi plurimam salutimi ascristam
					<lb xml:id="p2z14"/>oper Grecam valu Sobednio 4 fugusti issi
					<lb xml:id="p2z15"/>14m.
					<lb xml:id="p2z16"/>S.
					<lb xml:id="p2z17"/>Voli.
					<lb xml:id="p2z18"/>Iars.
					<lb xml:id="p2z19"/>.
					<lb xml:id="p2z20"/>E.
					<lb xml:id="p2z21"/>S.
					<pb/>
					<lb xml:id="p3z1"/>.
					<pb/>
					<lb xml:id="p4z1"/>Reverendo domino
					<lb xml:id="p4z2"/>Henrico Bullingero,
					<lb xml:id="p4z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastoris
					<lb xml:id="p4z4"/>dignissimo.
				</p>
