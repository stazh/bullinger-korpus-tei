	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p714">C[oelius] S[ecundus] C[urio]</persName> per Christum Iesum S. P. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Iactavit hic <persName ref="p3375">Vergerius</persName>, <persName ref="p495">Bullingere</persName> frater venerande, <lb xml:id="p1z3"/>abs te dialogos nostros De amplitudine r[egni] d[ivini] tanquam <lb xml:id="p1z4"/>impios condemnatos.</s>
					<s n="3" xml:lang="la">Ego autem de tam pio et moderat<lb xml:id="p1z5"/>o viro tantoque ac tali amico homini praesertim aulico <lb xml:id="p1z6"/>referenti non tam facile credendum existimavi, donec <lb xml:id="p1z7"/>ipse abs te de tota hac re edoctus essem.</s>
					<s n="4" xml:lang="la">Oro igitur te <lb xml:id="p1z8"/>per veterem nostram amicitiam, imo per deum ipsum, quem animo <lb xml:id="p1z9"/>et sincera fide colo per Iesum Christum, ut hunc scrupulum <lb xml:id="p1z10"/>ex animo meo velis eximere, ut, mihi porro quid sit <lb xml:id="p1z11"/>agendum, intelligam; neque enim ullae unquam tuae literae, <lb xml:id="p1z12"/>quas ad me dedisti plurimas, tale quicquam prae se ferebant.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z13"/>Nam etiamsi propter novitatem quandam amanter <lb xml:id="p1z14"/>monebas, ut cautior essem a <placeName ref="l572">Virtemberga</placeName> periculum <lb xml:id="p1z15"/>imminere (a quo autem vel cuius instinctu facile <lb xml:id="p1z16"/>intelligebam), ex tuis verbis nunquam tamen vel sub<lb xml:id="p1z17"/>olfacere potui a te ut pernitiosum et impium notari.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z18"/>Itaque, ut dixi, te per omnia, quae tibi charissima sunt, <lb xml:id="p1z19"/>obsecro, mihi, condemnaveris necne et qua formula, <lb xml:id="p1z20"/>perscribas.</s>
					<s n="7" xml:lang="la" ana="salute">Vale et saluta uxorem cum liberis et affinibus <lb xml:id="p1z21"/>nobis charissimis tuis meo, uxoris et liberorum nomine.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z22"/><placeName ref="l28">Basileae</placeName> 3. idus iunii 1557.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Tuus ut <lb xml:id="p1z23"/>semper idem <persName ref="p714">C[oelius] S[ecundus</persName>] <lb xml:id="p1z24"/>s[ub] s[<pb/><lb xml:id="p2z1"/>cripsit].</s>
