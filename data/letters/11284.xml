	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">En denuo te meis interturbo literis, <lb xml:id="p1z2"/>verum veniam ut des, rogo, quod tua studia meis nugis <lb xml:id="p1z3"/>subinde interturbo; causae enim non desunt.</s>
					<s n="3" xml:lang="la">Misi antea<note xml:id="fn1" type="footnote" n="1">am 4. März; vgl. oben <ref target="file11278">Nr. 1235</ref>, 13-16.</note> per <lb xml:id="p1z4"/><persName ref="p8418">Miconii</persName> ancillam<note xml:id="fn2" type="footnote" n="2">Nicht namentlich bekannt.</note> spheram, quam te accepisse spero; <lb xml:id="p1z5"/>verum centrum spherę plumbeasque compages, quę <lb xml:id="p1z6"/>coluros coniungunt axemque mundi sustinent, mittere <lb xml:id="p1z7"/>oblitus sum.</s>
					<s n="4" xml:lang="la">Haec nunc ad te mitto et rogo, ut <lb xml:id="p1z8"/>hęc aequo<note xml:id="fna" type="footnote" n="a"><hi>vor</hi> aequo <hi>gestrichenes</hi> te.</note> animo suscipias.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Plura nunc non scribo, <lb xml:id="p1z9"/>ne tibi molestus sim.</s>
					<s n="6" xml:lang="la">Hoc saltem rogo, ut cures, <lb xml:id="p1z10"/>ut <persName ref="p2553">Martinus Peyer</persName> papyrum, quam cupit, accipiat <lb xml:id="p1z11"/>per <persName ref="p4851">Froschouerum</persName> et ut <persName ref="p8418">Miconio</persName> eadem mittatur<note xml:id="fn3" type="footnote" n="3">Vgl. oben <ref target="file11278">Nr. 1235</ref>, 20-26.</note>.<pb type="edition" next="82"/></s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute"><lb xml:id="p1z12"/>Salutabis, quaeso, nomine meo matrem<note xml:id="fn4" type="footnote" ana="bio" n="4"><persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note> et uxorem<note xml:id="fn5" type="footnote" ana="bio" n="5"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> <lb xml:id="p1z13"/>tuam cum universa familia.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale bene, pater <lb xml:id="p1z14"/>humanissime, et me tibi commendatum habeto.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/><placeName ref="l28">Basileae</placeName>, ex aedibus d. <persName ref="p8418">Miconii</persName>, 11. martii 1539.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/>Tui observantissimus</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p8011">Rodolphus Gvalterus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vere pio et erudito viro <lb xml:id="p2z2"/>M. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>patrono suo imprimis <lb xml:id="p2z4"/>colendo.</s>
				</p>
			</div>
