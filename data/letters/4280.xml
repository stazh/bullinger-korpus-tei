	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">De <placeName ref="l832">Gallico</placeName> tumultu multa adhuc vari que feruntur.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Ex quibus, ut forte non omnia vera sunt, tamen <lb xml:id="p1z3"/>non omnia quoque falsa esse poterunt.</s>
					<s n="4" xml:lang="la">Certum est <lb xml:id="p1z4"/>aliquos illorum, qui regem in castro <placeName>Ambiens</placeName> invadere <lb xml:id="p1z5"/>voluerunt, repressos et oppressos esse; certum est <lb xml:id="p1z6"/>etiam gravem fieri inquisitionem in coniuratos <lb xml:id="p1z7"/>et praesertim eorum duces.</s>
					<s n="5" xml:lang="la">Metuunt nostri, ne <placeName ref="l167">Genevae</placeName> <lb xml:id="p1z8"/>inveniantur omnia haec esse composita eaque ratione <lb xml:id="p1z9"/><placeName ref="l167">Genevensibus</placeName> bellum inferatur, cui nos quoque involvamur<lb xml:id="p1z10"/>.</s>
					<s n="6" xml:lang="la">Quid olfaciant, plane satis nondum cognosco; <lb xml:id="p1z11"/>reviserunt tamen his diebus omnia, quae ad expeditionem <lb xml:id="p1z12"/>pertinent, ut quocunque die, quacunque hora suscipienda <lb xml:id="p1z13"/>sit, parati sint.</s>
					<s n="7" xml:lang="la"><placeName ref="l1944">Valentiam</placeName> ferunt teneri adhuc a <lb xml:id="p1z14"/>coniuratis, qui constituerint illic pro defensione su <lb xml:id="p1z15"/>fortiter mori potius quam dira carnificum supplicia <lb xml:id="p1z16"/>ferre.</s>
					<s n="8" xml:lang="la">De ministro etiam quodam fertur triduo miserabilit<lb xml:id="p1z17"/>er ustulato, antequam morti penitus traditus sit.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/>Feruntur et alia multa, quibus nescio quam fide <lb xml:id="p1z19"/>habere debeam.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ex <placeName ref="l21">Badena</placeName> forte aliquid certi acci<lb xml:id="p1z20"/>piemus; ex nostris illuc proficiscuntur d. <persName ref="p3494">Nicolaus <lb xml:id="p1z21"/>de Diesbach</persName> et d. <persName>Hieronymus Emanuel</persName>; dominus quęstor <lb xml:id="p1z22"/><persName ref="p8063">Steigerus</persName> illic nunc lavat.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Expecto, ut abs te accipiam, <lb xml:id="p1z23"/>si quid ex <placeName ref="l830">Anglia</placeName> his nundinis tibi allatum sit.</s>
					<s n="12" xml:lang="la">Feruntur <lb xml:id="p1z24"/>hic rumores diversi; alii enim dicunt Scotos cum <lb xml:id="p1z25"/>Gallorum rege pacem iniisse eosque ipsum pro rege <lb xml:id="p1z26"/>suo agnoscere, eum vicissim ipsis religionis libertatem <lb xml:id="p1z27"/>concessisse; alii dicunt <persName ref="p18465">Elizabetham</persName> <placeName ref="l830">Anglam</placeName> <lb xml:id="p1z28"/>comiti cuidam <placeName ref="l2524">Scoto</placeName> nupsisse et utrumque regnum <lb xml:id="p1z29"/>certis conditionibus coadunatum.</s>
					<s n="13" xml:lang="la">Ego neutrum adhuc <lb xml:id="p1z30"/>credo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Quod scribam praeterea nunc non habeo, nisi <lb xml:id="p1z31"/>quod interea opus tuum contra anabaptistas legi... <lb xml:id="p1z32"/>cum magna voluptate nec possum satis... <lb xml:id="p1z33"/>dare tuam fidem et diligentiam; excipitur magno <lb xml:id="p1z34"/>favore ab omnibus, praesertim ministris, pro quibus <lb xml:id="p1z35"/>utiliter laborasti; nam habemus huius fermenti <lb xml:id="p1z36"/>multum adhuc in multis parocciis.</s>
					<s n="15" xml:lang="la">Dominus <lb xml:id="p1z37"/>te nobis ad veritatis suae defensionem diu servet <lb xml:id="p1z38"/>incolumem.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell">Bene vale, suavissime compater, meque <lb xml:id="p1z39"/>tibi semper commendatum habe.</s>
					<s n="17" xml:lang="la" ana="salute">Salutant te nostri <lb xml:id="p1z40"/>omnes praesertim <persName ref="p8417">Musculus</persName>, socer, mater etc. quae propediem <lb xml:id="p1z41"/>ad vos redibit.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">Salutem dic etiam tuis omnibus meo nomine.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z42"/><placeName ref="l41">Bernae</placeName> 5. maii 1560.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z43"/><persName ref="p8018">Ioannes Hallerus</persName>, tuus <lb xml:id="p1z44"/>perpetuo.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Cum has iamiam essem occlusurus, tuę mihi offeruntur.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">E<lb xml:id="p2z2"/>go lectas et d. <persName ref="p8417">Musculo</persName> communicatas mox tibi remitto et <lb xml:id="p2z3"/>ago gratias.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Dolet nobis obitus clarissimi viri <persName ref="p8041">Ioannis a Lasco</persName>.</s>
					<s n="24" xml:lang="la">Quod tamen <placeName ref="l830">Anglicae</placeName> et <lb xml:id="p2z4"/><placeName ref="l2524">Scoticae</placeName> res salvę sint, domino agimus gratias.</s>
				</p>
				<p>
					<s n="25" xml:lang="la" ana="farewell">Vale iterum.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">Mitto has per legatos nostros, qui <placeName ref="l21">Badenam</placeName> proficiscuntur.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p2z5"/>Clarissimo viro d. <lb xml:id="p2z6"/><persName ref="p495">Heinrycho Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae pastori fidelissimo, <lb xml:id="p2z7"/>domino suo honorando et compatri charissimo.</s>
				</p>
			</div>
