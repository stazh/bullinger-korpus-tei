	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>früntlicher, lieber h. schwager dise zytungen
					<lb xml:id="p1z2"/>kamend mir nächt von Sangallen. Die
					<lb xml:id="p1z3"/>läsend und schickend mirs wider. möcht wol
					<lb xml:id="p1z4"/>lyden üwer bruͦder her Obman Kaller, hatts ouch
					<lb xml:id="p1z5"/>geläsen, daß mir doch weder wurde, Hiemitt
					<lb xml:id="p1z6"/>htt bevolhen, duct es üch wirdig, nöchtend
					<lb xml:id="p1z7"/>occasipur
					<lb xml:id="p1z8"/>irs mir h. Burgermenn, ouch anzeigen persocium etc.
					<lb xml:id="p1z9"/>Dominus terum.
					<lb xml:id="p1z10"/>Bullininger
				</p>
			</div>
		</body>
	</text>
