	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto ad te, charissime mi pater et domine <persName ref="p495">Bullingere</persName>, per filium <lb xml:id="p1z2"/>sororis meę septem aureos ob debitum boni <persName>Hiachi</persName>, quos certe ad te dedissem <lb xml:id="p1z3"/>dudum, si mihi contigisset fidelis et certus nuncius.</s>
					<s n="3" xml:lang="la">Impedivit etiam <lb xml:id="p1z4"/>hęc inclementissima inclementia cęli et me et alios quoque multos.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Tuam igitur obsecro humanitatem, ne mihi succenseas quasi homini mini<lb xml:id="p1z6"/>me fido et veraci; non potui, spero tamen etiam hodie praestitisse fidem <lb xml:id="p1z7"/>in tempore etc.</s>
					<s n="5" xml:lang="la">Valemus bene, utinam et vos.</s>
					<s n="6" xml:lang="la">Quid apud nos agatu<lb xml:id="p1z8"/>r, nihil aliud habeo, quam quod laboravimus hactenus magnis <lb xml:id="p1z9"/>in nivibus et frigoribus pene Scythicis.</s>
					<s n="7" xml:lang="la"><persName>Pindus</persName> et <persName>Hemus</persName> rigent.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Ex<lb xml:id="p1z10"/>pectamus a te, quid actum sit apud vos, qui habitatis in Thessalicis <lb xml:id="p1z11"/>hortis clementiore vestiti cęlo semotique a tantis nivium horro<lb xml:id="p1z12"/>ribus et glaciali situ.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Vale in domino.</s>
					<s n="10" xml:lang="la">Raptim <placeName ref="l458">Schwanden</placeName> 3. Februarii <lb xml:id="p1z13"/>anno 49.</s>
					<s n="11" xml:lang="la">Familiam tuam sanctam in domino valere desyderamus <lb xml:id="p1z14"/>una omnibus cum piis et sanctis fratribus.</s>
					<s n="12" xml:lang="la" ana="salute">Salutat te <persName ref="p8303">Fonteius</persName>, <lb xml:id="p1z15"/><persName>Paulus Schola</persName> et D. <persName ref="p3206">Valentinus Tschudi</persName> <persName ref="p252">Beldiusque</persName> <lb xml:id="p1z16"/>etc.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z17"/>Tuus <persName ref="p8130">Laurentius Agricola</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
