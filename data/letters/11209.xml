	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, mi venerande et optime <persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><placeName ref="l257">Constantiam</placeName> <lb xml:id="p1z2"/>nuper, hoc est 26. augusti, cum bona <placeName ref="l572">Wirtempergensis</placeName> <lb xml:id="p1z3"/>principis<note xml:id="fn1" type="footnote" n="1"><persName ref="p9708">Ulrich, Herzog von Württemberg</persName>.</note> gratia redii, nisi quod ille malignius <lb xml:id="p1z4"/>ęquo mihi numeravit; nam tantum non 300 aureorum <lb xml:id="p1z5"/>iacturam feci toto illo quadriennio, quo in ipsius ditione <lb xml:id="p1z6"/>non ferendorum laborum molestia oppressus prorsumque enectus sum.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Et tamen gratias ago deo meo, quod bona conscientia illinc <lb xml:id="p1z8"/>explicitus iam meis restituor.</s>
					<s n="4" xml:lang="la">Volui autem, licet occupatissimus, <lb xml:id="p1z9"/>istuc tibi paucis indicare, quod sciam, quid amicorum meorum <lb xml:id="p1z10"/>rumusculi iactitent, nempe irato me principe missum <lb xml:id="p1z11"/>factum, ne desit, quod illis obiicias; nam quicquid hic peccavit <lb xml:id="p1z12"/>princeps, non pro ira, sed pro consuetudine fecit<note xml:id="fn2" type="footnote" n="2">Über die Entlassung <persName ref="p8055">Blarers</persName> am 30. Mai 1538 und deren unklare Hintergründe vgl. Martin <hi>Brecht,</hi> <persName ref="p8055">Ambrosius Blarer</persName>s Wirksamkeit in <placeName ref="l2481">Schwaben</placeName>, in: Der <placeName ref="l257">Konstanzer</placeName> Reformator <persName ref="p8055">Ambrosius Blarer</persName> 1492-1564. Gedenkschrift zu seinem 400. Todestag, hg. v. Bernd Moeller, <placeName ref="l257">Konstanz</placeName>/<placeName ref="l496">Stuttgart</placeName> 1964, S. 140-171, hier 166-168, und Theodor <hi>Pressel,</hi> <persName ref="p8055">Ambrosius Blaurer</persName>'s des schwäbischen Reformators Leben und Schriften, Stuttgart 1861, S. 437f. 441-444.</note>.</s>
					<s n="5" xml:lang="la">Sic <lb xml:id="p1z13"/>enim solet.</s>
					<s n="6" xml:lang="la">Spero autem fore, ut olim per commodam aliquam <lb xml:id="p1z14"/>occasionem, quod nunc desidero, benigne compenset et dignam <lb xml:id="p1z15"/>principe munificentiam exerat, quum sit in me alioqui <lb xml:id="p1z16"/>non iniquo animo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Commenda me clarissimis viris <lb xml:id="p1z17"/><persName ref="p8127">Pellicano</persName>, <persName ref="p1753">Leoni</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p1753">Leo Jud</persName>.</note>, <persName ref="p8171">Theodoro</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p8171">Theodor Bibliander</persName>.</note> ac cęteris fratribus et amicis, <lb xml:id="p1z18"/>quorum me precibus tuis quoque additis apud Christum iuvari <lb xml:id="p1z19"/>vehementer cupio.</s>
					<s n="8" xml:lang="la" ana="salute">Salutant te <persName ref="p4082">Zviccii</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p4079">Johannes</persName> und <persName ref="p4082">Konrad Zwick</persName>.</note> cum germano <lb xml:id="p1z20"/>meo <persName ref="p8178">fratre</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p8178">Thomas Blarer</persName>.</note> et <persName ref="p4334">sorore</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p4334">Margaretha Blarer</persName>.</note>.</s>
					<s n="9" xml:lang="la" ana="farewell">Bene vale, mi plus quam charissime <lb xml:id="p1z21"/>et optime frater.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l257">Constantiae</placeName>, ultima augusti anno 1538.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z22"/>Tuus <persName ref="p8055">Ambrosius Blaurerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tiguricensis</placeName> ecclesiae <lb xml:id="p2z3"/>episcopo, domino et fratri observando <lb xml:id="p2z4"/>atque charissimo etc.</s>
				</p>
			</div>
		</body>
	</text>
