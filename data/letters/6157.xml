	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi tuas heri <placeName ref="l2">Arovię</placeName>, et quoniam ad nos, quod <lb xml:id="p1z2"/>maxime desiderabamus, venire non potes, ecce ascendit <lb xml:id="p1z3"/>ad vos, sicuti futurum praemonueram, d. <persName ref="p5787">Claudius a Madiis</persName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Is te unum convenire cupit et proinde, ut ad diversorium <lb xml:id="p1z5"/>illius venire digneris, orat; mox enim, postquam tecum lo<lb xml:id="p1z6"/>cutus fuerit, discedet iterum, ut cras nobiscum in synodo <lb xml:id="p1z7"/>seu capitulo <placeName ref="l69">Brugensi</placeName> esse possit.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Arovia heri sero admodum <lb xml:id="p1z8"/>discessimus, ita ut paulo ante noctem huc <placeName ref="l285">Lentzburgum</placeName> <lb xml:id="p1z9"/>cum praefecto venerimus, ubi et pernoctavimus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Iam ego una <lb xml:id="p1z10"/>cum altero collegarum <placeName ref="l269">Küngßfeldum</placeName> proficiscor, ubi non <lb xml:id="p1z11"/>dubito quin me frater expectet.</s>
					<s n="6" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ex arce <lb xml:id="p1z12"/><placeName ref="l285">Lentzburgensi</placeName> prima iunii summo mane 1564.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p8018">Hallerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.; D. unt. Teil des Blattes ist abgeschnitten.]</note>
				</p>
			</div>
		</body>
	</text>
