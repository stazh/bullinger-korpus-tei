			<zone xml:id="p2z4-0" points="2478,1323 3497,1314 3499,1185 3372,1227 3188,1201 2805,1257 2625,1197 2479,1267">2484,1288 2534,1284 2585,1280 2636,1279 2687,1277 2738,1273 2789,1270 2839,1269 2890,1266 2941,1264 2992,1264 3043,1262 3094,1261 3145,1261 3195,1261 3246,1263 3297,1266 3348,1264 3399,1264 3450,1261 3501,1261</zone>
