	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Hodie veni et iveni, qui reducerun, equos
					<lb xml:id="p1z2"/>e
					<lb xml:id="p1z3"/>brviter scribo atque oro te, mi observando.
					<lb xml:id="p1z4"/>si Pario fuerit opus
					<lb xml:id="p1z5"/>ad me certum aliquem nuntium, ut et
					<lb xml:id="p1z6"/>velis adsse cupio enim illum Tigurinum sperue,
					<lb xml:id="p1z7"/>fidei hominem esse, qui abs te mitti vidat,
					<lb xml:id="p1z8"/>Augusta, ubi quaeret me apud
					<lb xml:id="p1z9"/>Gerionem anucum tuum; nam es aliuu
					<lb xml:id="p1z10"/>momenti concrndent esi caetera ex da
					<lb xml:id="p1z11"/>Vergerius abesti expectabo done red
					<lb xml:id="p1z12"/>eschalichiris est ipsius convitorm
					<lb xml:id="p1z13"/>tabilior etiam quam iudicetur ab omnibus pluram
					<lb xml:id="p1z14"/>per illum scribam
					<lb xml:id="p1z15"/>non lieo et Augusta.
					<lb xml:id="p1z16"/>tibi copiose de multis intera brneva
					<lb xml:id="p1z17"/>lete omnes et agite deo gratias. Pro illa s
					<lb xml:id="p1z18"/>mi eai rara erede die
					<lb xml:id="p1z19"/>xestis ac nos perpetuo vitunt ess cohi,
					<lb xml:id="p1z20"/>Ego tibi plurimum dbeo et gratifimam
					<lb xml:id="p1z21"/>in omnibus lugio. dubinge 10. iulii
					<lb xml:id="p1z22"/>o1550.
					<lb xml:id="p1z23"/>Ob filica Lęlius sc.
					<lb xml:id="p1z24"/>saluto amicos fratres
					<lb xml:id="p1z25"/>et spisnis obser praeces
					<lb xml:id="p1z26"/>gratissimum feceris, si de nuntio mittendo
					<lb xml:id="p1z27"/>prorus tavens
					<pb/>
