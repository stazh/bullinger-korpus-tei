			<div>
				<p>
					<lb xml:id="p1z1"/>d. Wintertuus.
					<lb xml:id="p1z2"/>Fromm vest, ersam fürsichtig und wyse herr
					<lb xml:id="p1z3"/>burgermeister und gnedig, lieb herren.
					<lb xml:id="p1z4"/>demnach ir unser gnedig herren den hälff
					<lb xml:id="p1z5"/>zuͦ Wyntherdur her Oßwalden fäsy hinuff gen
					<lb xml:id="p1z6"/>hal in die pfarr verordnet, bedarff der pfarrer
					<lb xml:id="p1z7"/>zuͦ Wintherdur h. Bernhart Lindewer eines
					<lb xml:id="p1z8"/>anderen hälffers, insonders, so diser zyt ettliche
					<lb xml:id="p1z9"/>pfarrer imm capittel kranck ligend und immer
					<lb xml:id="p1z10"/>darumb hilff anruffend, diewyl dann er der pfarer
					<lb xml:id="p1z11"/>das bißhar von üch unsern gnedigen herren
					<lb xml:id="p1z12"/>gehept, das er u. w. einen zur bestätug presen
					<lb xml:id="p1z13"/>und fürstellt und das ouch jetzund uff üwer
					<lb xml:id="p1z14"/>unser g herren gefallen mitt den verordneten.
					<lb xml:id="p1z15"/>examinatoribus gehandlet, so benaupset er herren
					<lb xml:id="p1z16"/>Eraßmum kouffmon purtig von Wintherdur, welln
					<lb xml:id="p1z17"/>in üwer miner herren Stipendio uffzogen
					<lb xml:id="p1z18"/>ouch examiniert und der massen funden worden
					<lb xml:id="p1z19"/>das er den stand mitt gott wol versähen mag
					<lb xml:id="p1z20"/>So hatt er noch sin stipendun, deß er sich mus
					<lb xml:id="p1z21"/>Martini künfftig behälffen, diewyl das ynkumme
					<lb xml:id="p1z22"/>der hälffery uß üwer unser ghr gnädig
					<lb xml:id="p1z23"/>verwilligung, h. Oßwalden nachvolgen wirt.
					<lb xml:id="p1z24"/>Und diewyb uns ouch befolben ein fürschlag
					<lb xml:id="p1z25"/>syrnach in das Thurgöw zuͦ thuͦn, so be
					<lb xml:id="p1z26"/>nempsend wir Steffanum Aberli und sohansen
					<lb xml:id="p1z27"/>Heinrychen locher, welche beid in uwer unser
					<lb xml:id="p1z28"/>ho Stipendio ufferzogen, examiniert und
					<lb xml:id="p1z29"/>worden, das wir hoffend, welcher under denen
					<lb xml:id="p1z30"/>zegeyen dahin gesandt wirt, das er die kylchen
					<lb xml:id="p1z31"/>zuͦ syrnach wol werde mögen versähen etc.
					<lb xml:id="p1z32"/>und eben diß zwen habend wir noch, sunst
					<lb xml:id="p1z33"/>sind diser zyt keine me die examiniert und
					<lb xml:id="p1z34"/>fürohin mögind fürgestellt werden, also vil
					<lb xml:id="p1z35"/>werdent für und fürhin und har verschickt
					<lb xml:id="p1z36"/>und zuͦ verwallten die predicaturen gesendt
					<lb xml:id="p1z37"/>bitten u. w. wölle disen fürschlag in gnaden
					<lb xml:id="p1z38"/>von uns uffnemmen. Der gemachet ist zinstags
					<lb xml:id="p1z39"/>des 1. martii, in jar Christi 1569.
					<lb xml:id="p1z40"/>w.
					<lb xml:id="p1z41"/>underthänige
					<lb xml:id="p1z42"/>verordnete exap
					<lb xml:id="p1z43"/>minatores.
					<pb/>
					<lb xml:id="p2z1"/>Gilianioque mnospou dtoru ca
					<lb xml:id="p2z2"/>aate bereisu mea ooe e aa
					<lb xml:id="p2z3"/>exulerantique magante ese quaaat
					<lb xml:id="p2z4"/>ut ale vaniore ala
