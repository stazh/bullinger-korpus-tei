	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuae mihi literae, doctissime vir, ut semper gratissimae fuere, et hoc quidem <lb xml:id="p1z2"/>gratiores quo longiores.</s>
					<s n="3" xml:lang="la">Unum doluit, quod te purgandum esse ob ingenuam <lb xml:id="p1z3"/>tuam libertatem, qua tuis ad me literis usus es, dignum duxisti, quasi vero non <lb xml:id="p1z4"/>aequo animo tulerim, quicquid libertatis et candoris hactenus literis tuis infudisti.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Nosti vero, quam levibus de caussis magni quondam viri labefacti sint, ade[o]<note xml:id="fna" type="footnote" n="a"><hi>Hier und unten Textverlust am rechten Papierrand.</hi></note> <lb xml:id="p1z6"/>ut acuratis etiam consolationibus fuerit opus, quominus aegre ferrent communes <lb xml:id="p1z7"/>casus et hoc, citius ad sese ut redirent, evincerentur.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="5" xml:lang="la">Sane igitur et fratern[e] <lb xml:id="p1z8"/>abs te admonitus fuissem, si quicquam tale admisissem vel commisissem potius.</s>
					<s n="6" xml:lang="la">V[e]ru<lb xml:id="p1z9"/>m quum factum non sit, ego te meo de morbo doloreque certiorem facere nolui.</s>
					<s n="7" xml:lang="la">Pr[o]<lb xml:id="p1z10"/>inde te oro, me ne suspicari quidem pergas sic moroso esse ingenio, ut omnia tua <lb xml:id="p1z11"/>mihi non longe erga me studia quam gratissima esse possint et debea[nt].</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/>Ad institutum autem ut veniam, scito, me literas <persName ref="p8018">Hallero</persName> reddendas certo bonęque fid[ei] <lb xml:id="p1z13"/>tabellioni tradidisse, et spero iam ipsum tuis illis frui.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="9" xml:lang="la"><persName ref="p18538">Caesar</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p18538">Karl V.</persName></note> <placeName ref="l18">Augustam</placeName> venit <lb xml:id="p1z14"/>circiter decimum calendas augusti comite <persName ref="p7840">episcopo</persName><note xml:id="fn15" type="footnote" n="15"><persName ref="p7840">Otto Truchsess von Waldburg</persName>.</note> eius urbis et aliis insignis notae <lb xml:id="p1z15"/>principibus et in hoc totus est, ut comitia ad calendas septembres indicta sin[e] <lb xml:id="p1z16"/>mora celebrentur.</s>
					<s n="10" xml:lang="la">Pollicetur autem <placeName ref="l822">Germanię</placeName> ius integrum, fidem mutui offici<lb xml:id="p1z17"/>i et pacem perennem.</s>
					<s n="11" xml:lang="la">Religionis nulla mentio!</s>
					<s n="12" xml:lang="la">Multa iactantia victoriae <lb xml:id="p1z18"/>adversum perduelliones, cum tamen a perduellionibus victoriam stetisse<note xml:id="fnb" type="footnote" n="b"><hi>In der Vorlage</hi> stetissi.</note> m[ulti] <lb xml:id="p1z19"/>boni viri sibi persuadeant.</s>
					<s n="13" xml:lang="la">Verum fucandi facultas penes victorem est!</s>
					<s n="14" xml:lang="la">Omnes [boni] <lb xml:id="p1z20"/>timent monarchiae factionem et studia, et ex <placeName ref="l18">Augusta</placeName>, quanquam sint qui s[cri]bant <lb xml:id="p1z21"/>multam inter <persName ref="p19981">papam</persName><note xml:id="fn16" type="footnote" n="16"><persName ref="p19981">Paul III.</persName></note> et caesarem simultatem vigere, tamen frigide, ut credam.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z22"/>Faciunt caussae multae, illa inprimis, quod <persName ref="p3207">Anglo</persName><note xml:id="fn17" type="footnote" n="17"><persName ref="p3207">Eduard VI.</persName></note> papa per <persName ref="p6122">Polum</persName> cardinalem in <placeName ref="l2524">Scotiam</placeName> <lb xml:id="p1z23"/>missum evangelii inprimis nomine insidias struit conniventibus <persName ref="p18538">caesare</persName> et <persName ref="p20225">Gallo</persName><note xml:id="fn18" type="footnote" n="18"><persName ref="p8112">Heinrich II.</persName></note>, <lb xml:id="p1z24"/>et quod certe fertur, quod papa satagente caesar de vexandis <placeName ref="l2449">Bohemis</placeName> consilium <lb xml:id="p1z25"/>inierit, non alia magis caussa, quam quod religio (qua quidem parte papisticae <lb xml:id="p1z26"/>vaesanię non consentit) de medio auferatur.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="16" xml:lang="la"><persName ref="p1055">Frechto</persName> coniunx peste ablata est, dolenti <lb xml:id="p1z27"/>vehementer, et publicum casum haud aequo admodum animo ferenti.</s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="17" xml:lang="la" ana="farewell">Vale.</s>
					<s n="18" xml:lang="la">Brev[<lb xml:id="p1z28"/>i] plura scribam.</s>
					<s n="19" xml:lang="la"><placeName ref="l473">Sangalli</placeName>, calendis augusti, anno 1547.</s>
				</p>
			</div>
			<div xml:id="div7" corresp="regest7">
				<p>
					<s n="20" xml:lang="la"><persName ref="p8049">Vadianus</persName>.</s>
				</p>
			</div>
			<div xml:id="div8" corresp="regest8">
				<p>
					<s n="21" xml:lang="la"><pb type="scan" next="v."/><pb/><lb xml:id="p2z1"/><persName ref="p18538">Caesar</persName>, ut primum omnium <placeName ref="l18">Augusta</placeName> venit, praesidia urbi ante imposita <lb xml:id="p2z2"/>dimisit.</s>
					<s n="22" xml:lang="la">Qua id caussa factum sit, ambigitur.</s>
					<s n="23" xml:lang="la">Sunt, qui bonam ea de re spem <lb xml:id="p2z3"/>conceperunt, paterne et clementer ipsum omnia ordinaturum; alii fucum <lb xml:id="p2z4"/>illis fieri<note xml:id="fn19" type="footnote" n="19">fucum fieri: Vgl. <bibl source="b56">Adagia</bibl> 1, 5, 52 (<bibl>ASD</bibl> II/1 525f, Nr. 452).</note> arbitrantur, ne atrociora praesentiant.</s>
					<s n="24" xml:lang="la">Ego urbe abire iussos <lb xml:id="p2z5"/>puto, quo magis vacua commodaque iis hospitia consignari possint, <lb xml:id="p2z6"/>qui undique ad illa foelicia comitia sunt convolaturi.</s>
					<s n="25" xml:lang="la">Heri senatus <lb xml:id="p2z7"/>noster et ipse diploma accepit, quo de comitiis adeundis admonemur.</s>
					<s n="26" xml:lang="la"><lb xml:id="p2z8"/>Sed intra saepes nostras nos, ut in praesentia contineamus, iam consultum <lb xml:id="p2z9"/>et decretum est.</s>
				</p>
			</div>
			<div xml:id="div9" corresp="regest9">
				<p>
					<s n="27" xml:lang="la">Quaerebam tabellionem, num et <persName ref="p8179">abbati</persName><note xml:id="fn20" type="footnote" n="20"><persName ref="p8179">Diethelm Blarer von Wartensee</persName>.</note> caesaris mandatum <lb xml:id="p2z10"/>attulerit?</s>
					<s n="28" xml:lang="la">Negabat aiebatque eas literas, quae abbatem evocarent, <persName ref="p7852">episcopo</persName> <lb xml:id="p2z11"/><placeName ref="l257">Constantiensi</placeName><note xml:id="fn21" type="footnote" n="21"><persName ref="p7852">Johannes von Weeze</persName>.</note> missas, qui caesaris nomine eam rem esset<note xml:id="fnc" type="footnote" n="c"><hi>In der Vorlage</hi> esse.</note> curaturus.</s>
					<s n="29" xml:lang="la">Sibi negoci<lb xml:id="p2z12"/>um ad urbes datum, itaque se recta dicebat <placeName ref="l752">Schafhusiam</placeName> petiturum, <lb xml:id="p2z13"/>quo et ipsis suum diploma offerret.</s>
					<s n="30" xml:lang="la">Vide syncretissimos<note xml:id="fn22" type="footnote" ana="lex" n="22">kompromissbereite.</note> plus quam pyraticos<note xml:id="fn23" type="footnote" n="23">= piraticos (zur Kaperei gehörig).</note>.</s>
				</p>
				<p>
					<s n="31" xml:lang="la" ana="farewell">Sed vale <lb xml:id="p2z14"/>iterum iterumque, amantissime mi <persName ref="p495">Bullingere</persName>, et me amare non desiste.<note xml:id="fnd" type="footnote" n="d"><hi>Darunter folgt wie eine Art Paraphe.</hi></note></s>
				</p>
				<p>
					<note type="address">[Adresse darunter:]</note>
					<s n="32" xml:lang="la">Doctissimo pientissimoque viro d. <persName ref="p495">Henryc<lb xml:id="p2z15"/>ho Bullingero</persName>, amplissimae ecclesiae <placeName ref="l587">Tigurinae</placeName> episcopo, domino et amic<lb xml:id="p2z16"/>o inprimis observando.</s>
					<s n="33" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>