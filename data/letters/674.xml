	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">De concordia sacramentaria, <persName ref="p495">Bullingere</persName> <lb xml:id="p1z2"/>in domino charissime, quid fratribus hic commun<lb xml:id="p1z3"/>iter videatur, communibus ad vos literis <lb xml:id="p1z4"/>scribitur; quorum sententiam reprobare non <lb xml:id="p1z5"/>possum.</s>
					<s n="3" xml:lang="la">Plane gratulor ecclesiis hunc vestrum <lb xml:id="p1z6"/>consensum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Scriptum illud, quod misistis, <lb xml:id="p1z7"/>nihil habet, quod a priori dissentiat, etiamsi <lb xml:id="p1z8"/>uno et altero loco aliquid accesserit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Probantur <lb xml:id="p1z9"/>omnia, et utinam in hanc sententiam con<lb xml:id="p1z10"/>cedant omnes contentiosi et superstitiosi.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>De vulgatione scripti huius et mihi non <lb xml:id="p1z12"/>apparet tantum ex illa foret utilitatis in <lb xml:id="p1z13"/>communi, quantum rixarum et turbarum, non <lb xml:id="p1z14"/>propterea, quod tale non sit, quod per <lb xml:id="p1z15"/>se plurimum prodesse nequeat, sed propter <lb xml:id="p1z16"/>praesentium temporum incredibilem maliciam et <lb xml:id="p1z17"/>rerum omnium disturbationem, id quod ad te pri<lb xml:id="p1z18"/>vatim, sicuti volebas, scribo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z19"/>De rebus meis nihil habeo quod scribam <lb xml:id="p1z20"/>in praesenti, nisi quod omnia satis tran<lb xml:id="p1z21"/>quilla sunt domi meę.</s>
					<s n="8" xml:lang="la">Uxor quidem <lb xml:id="p1z22"/>nonnihil molesta est propter nimiam mentis <lb xml:id="p1z23"/>angustiam et et sollicitudinem rerum necessariarum; <lb xml:id="p1z24"/>sentit nos insumere parta propter st<lb xml:id="p1z25"/>ipendii tenuitatem ideoque timet futurum <lb xml:id="p1z26"/>aliquando, ut consumptis facultatibus nostris <lb xml:id="p1z27"/>egestatem cum liberis ferre cogatur.</s>
					<s n="9" xml:lang="la">Haec <lb xml:id="p1z28"/>illam cura mordet noctes ac dies; quam <lb xml:id="p1z29"/>utinam animo illius eximere possem.</s>
					<s n="10" xml:lang="la">Verum <lb xml:id="p1z30"/>est, fateor, insumo paulatim, quę sunt <lb xml:id="p1z31"/>in manibus; spero tamen non defuturum dominum <lb xml:id="p1z32"/>et mihi et meis.</s>
					<s n="11" xml:lang="la">Quid possum aliud?</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z33"/>quando hęc respublica vel non intelligit <lb xml:id="p1z34"/>vel non curat, quę mea sit necessitas <lb xml:id="p1z35"/>vel quis usus mei ad hanc possit <lb xml:id="p1z36"/>redire ecclesiam, quam ut hęc domino commendem, <lb xml:id="p1z37"/>qui providus omnia curat?</s>
					<s n="13" xml:lang="la">Quod uxorem attinet, <lb xml:id="p1z38"/>spero illam animo futuram liberiore post <lb xml:id="p1z39"/>partum, quem 26. huius mensis futurum domino volenta <lb xml:id="p1z40"/>iudicat.</s>
					<s n="14" xml:lang="la" ana="salute">Domum tuam universam, honestissimam uxorem <lb xml:id="p1z41"/>et liberos, mei omnes amicissime salutant; respon<lb xml:id="p1z42"/>debunt literis acceptis, iam non licuit.</s>
					<s n="15" xml:lang="la" ana="farewell">Optime vale, <lb xml:id="p1z43"/>virorum observandissime, et <persName ref="p8417">Musculum</persName> tuum curę tuę <lb xml:id="p1z44"/>commendatum habe.</s>
					<s n="16" xml:lang="la" ana="salute">Salutem dominis et fratribus omnibus <lb xml:id="p1z45"/>et <persName ref="p8440">Gervasio</persName> nostro in domino charissimo.</s>
				</p>
				<p>
					<s n="17" xml:lang="de"><placeName ref="l41">Bernę</placeName> 10. septembris 1549.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z46"/><persName ref="p8417">W[olfgangus] Musc[ulus</persName>] tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo theo<lb xml:id="p2z2"/>logo M. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/><placeName ref="l587">Tigurinę</placeName> ecclesię <lb xml:id="p2z5"/>antistiti, domino <lb xml:id="p2z6"/>ac fratri in <lb xml:id="p2z7"/>Christo longe <lb xml:id="p2z8"/>charissimo.</s>
				</p>
