			<zone xml:id="p2z10-0" points="905,1217 980,1218 1012,1234 1050,1231 1081,1249 1120,1249 1186,1233 1186,1185 1160,1178 1143,1186 1130,1175 1071,1184 977,1139 959,1148 904,1132">910,1209 935,1207 960,1206 985,1206 1011,1206 1036,1206 1061,1206 1086,1206 1112,1206 1137,1206 1162,1208 1188,1212</zone>
