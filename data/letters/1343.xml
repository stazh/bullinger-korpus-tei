	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Cras mane proficiscitur filius <lb xml:id="p1z2"/>tuus <placeName ref="l555">Witudurum</placeName> comitatus praestantissimo <lb xml:id="p1z3"/>viro d. <persName ref="p3988">Ioanne Wolphio</persName> et meis quoque <lb xml:id="p1z4"/>literis instructus.</s>
					<s n="3" xml:lang="la">Scripsi praetori <persName>Gyslero</persName> <lb xml:id="p1z5"/>et ministris ecclesiae.</s>
					<s n="4" xml:lang="la">Utinam <lb xml:id="p1z6"/>faustum et felix sit, quod instituit!</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Ego optime spero.</s>
					<s n="6" xml:lang="la">Quodsi hac non <lb xml:id="p1z8"/>successerit, non deerit ipsi dominus.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z9"/>Conabimur iuvante deo illum modis <lb xml:id="p1z10"/>omnibus iuvare, ut aliquando apud nos <lb xml:id="p1z11"/>habeat locum oportunum.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale, vir <lb xml:id="p1z12"/>colendissime, et meos charissimos generos <lb xml:id="p1z13"/>tibi habe commendatos.</s>
					<s n="9" xml:lang="la">Ago tibi gratias <lb xml:id="p1z14"/>pro beneficiis in familiam meam collatis.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/><placeName ref="l587">Tiguri</placeName>, die Margaritae circa <lb xml:id="p1z16"/>horam noctis 10.</s>
					<s n="11" xml:lang="la">Salva sit uxor, <lb xml:id="p1z17"/>salvi sint omnes tui.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z18"/>1551.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z19"/><persName ref="p495">Bullinger[us]</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro <lb xml:id="p2z2"/>d. <persName ref="p8127">Conrado Pellicano</persName>, <lb xml:id="p2z3"/>domino compa<lb xml:id="p2z4"/>tri et fratri suo <lb xml:id="p2z5"/>honorando et charo.</s>
				</p>
				<p>
					<s n="15" xml:lang="de"><placeName ref="l21">Baden</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
