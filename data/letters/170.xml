	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Laudavit mirum in modum vestram <lb xml:id="p1z3"/>omnium humanitatem D. D. <persName>Augustinus</persName> et oravit, <lb xml:id="p1z4"/>ut etiam ego tibi inprimis maximas pro beneficii<lb xml:id="p1z5"/>s gratias agerem.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Reddidit mihi D. <persName ref="p2463">Panthaleon</persName> literas tuas atque <lb xml:id="p1z7"/>utinam illi praestare potuissem, quo dignus <lb xml:id="p1z8"/>erat is, quem tu mihi commendasti.</s>
					<s n="4" xml:lang="la">Certe vo<lb xml:id="p1z9"/>luntas mihi non defuit, sed facultas.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Pro novis illis ago tibi gratias; aequum est, vicissim ut <lb xml:id="p1z11"/>ego nova quoque mea communice<lb xml:id="p1z12"/>m.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Ea certe prolixa sunt; viva ergo epistola erit <lb xml:id="p1z14"/>lator praesentium, vir bonus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/><persName ref="p18477">Ferdinandus</persName> colligit exercitum contra <placeName ref="l869">Septem Castrenses</placeName> [<placeName ref="l869">Siebenbürgen</placeName>?].</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Caesar conscribit <placeName ref="l822">Germanum</placeName> <lb xml:id="p1z18"/>militem ad signa 12.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/>Urbes pium responsum pa<lb xml:id="p1z20"/>rarunt super impium Interim Caesari dandum.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z21"/>A <placeName ref="l257">Constantiensibus</placeName> iniqua postulantur, inprimis <lb xml:id="p1z22"/>ut episcopum cum suis restituant, - <lb xml:id="p1z23"/>episcopus 14. iuni<lb xml:id="p1z24"/>i paralysi tactus excessit; ut recipiant praefectum a Caesar<lb xml:id="p1z25"/>e in urbem sicuti <placeName ref="l410">Ratisbona</placeName>, cui quotanni<lb xml:id="p1z26"/>s <lb xml:id="p1z27"/>pendant 500 gl. etc.</s>
					<s n="11" xml:lang="la">Sed intelligo illos n<lb xml:id="p1z28"/>on recepturos conditiones; nondum tamen illae <lb xml:id="p1z29"/>populo sunt propositae.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z30"/>A <placeName ref="l291">Lindaviensibus</placeName> <lb xml:id="p1z31"/>simpliciter postulavit Caesar, ut recipiant Interim <lb xml:id="p1z32"/>et missas celebrent ac de 100 gl. solvant <lb xml:id="p1z33"/>4 gl.</s>
					<s n="13" xml:lang="la">Quid amicus ex <placeName ref="l830">Anglia</placeName> scripserit, <lb xml:id="p1z34"/>exponet D. M. <persName ref="p8375">Heinrychus</persName>.</s>
					<s n="14" xml:lang="la">Plura possum.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z35"/>Vereor non esse verum, quod pro vero multi <lb xml:id="p1z36"/>retulere: <placeName ref="l2524">Scotum</placeName> cum <placeName ref="l822">Germanis</placeName> <placeName ref="l832">Gallisantibus</placeName> esse <lb xml:id="p1z37"/>fusum ab <placeName ref="l830">Anglis</placeName> et <lb xml:id="p1z38"/><placeName>Novam Buloniam</placeName> occupatum.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z39"/>Tu, si quid certi acceperis, significa.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Vive et <lb xml:id="p1z40"/>vale.</s>
					<s n="18" xml:lang="la" ana="salute">Communica haec D. <persName ref="p1278">Gastio</persName>, quem amic<lb xml:id="p1z41"/>e salutabis.</s>
					<s n="19" xml:lang="la">Valebis aeternum.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 25. <lb xml:id="p1z42"/>iunii anno 1548.</s>
					<s n="21" xml:lang="la">Festinantissime scripsi.</s>
					<s n="22" xml:lang="la"><lb xml:id="p1z43"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z44"/>Iudico illum <persName>Mic<lb xml:id="p1z45"/>haelem</persName> esse impostorem idque <lb xml:id="p1z46"/>ex Interim, quod <lb xml:id="p1z47"/>potissimum contexuisse dicitur; alioqui <lb xml:id="p1z49"/>sermones eius <lb xml:id="p1z50"/>nondum legi nec scio, quando <lb xml:id="p1z52"/>legam.</s>
					<s n="24" xml:lang="la">Viri <lb xml:id="p1z53"/>improbi verba venenum, <lb xml:id="p1z54"/>et cum bona <lb xml:id="p1z55"/>loquitur, bonum tamen suspectum est propter malum.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro D. <persName ref="p8418">Osvaldo <lb xml:id="p2z2"/>Myconio</persName>, symmistae <lb xml:id="p2z3"/>et fratri charissimo suo.</s>
					<s n="26" xml:lang="de"><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
