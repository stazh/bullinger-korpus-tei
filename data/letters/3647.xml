	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Condona mihi vir praestantissime, quod
					<lb xml:id="p1z2"/>ignotus ad ignotum scribo tam familiariter
					<lb xml:id="p1z3"/>Audio charissime meum affinem d. d. Georgium
					<lb xml:id="p1z4"/>pellarium profectum Bononiam ita voluisse, ut
					<lb xml:id="p1z5"/>literas et pecunias ad ipsum pertinentes
					<lb xml:id="p1z6"/>et Patavium missas acciperes et ei procup
					<lb xml:id="p1z7"/>reOro ergo tuam humanitatem, ut has
					<lb xml:id="p1z8"/>literas una cum viginti coronatis Gallicis
					<lb xml:id="p1z9"/>ad ipsum mittas. Si vero tu ille es, qui
					<lb xml:id="p1z10"/>ilio meo duos coronatos dedisti mutuo tu
					<lb xml:id="p1z11"/>ipse duos accipito, residuos decem et octo
					<lb xml:id="p1z12"/>ad d. Cellarium perferri tuto curato. Ego quoque
					<lb xml:id="p1z13"/>tuis
					<lb xml:id="p1z14"/>pro beneficiis  in filium meum collatis maxim
					<lb xml:id="p1z15"/>ago gratias et omnia mea officia vicissim
					<lb xml:id="p1z16"/>tibi debeo set offers. Rem vero gratissimam mihi
					<lb xml:id="p1z17"/>feceris, vir praestantissime, si per hunc verca
					<lb xml:id="p1z18"/>Laurentium Lumagavi rescripseris
					<lb xml:id="p1z19"/>pecunia accepisse et quomodo procuraveris
					<lb xml:id="p1z20"/>Ita enim ero traquillior, Ac poteris hic nestri
					<lb xml:id="p1z21"/>nulla tua molestia gratificari.Vale.
					<lb xml:id="p1z22"/>iguri 14. iulii anno 1558.
					<lb xml:id="p1z23"/>Heinrychus Bullingerus.
					<lb xml:id="p1z24"/>Scripsisset haud dubie copiosissimus
					<lb xml:id="p1z25"/>ad te filius meus nosi lavaret
					<lb xml:id="p1z26"/>Bedae in Thermus. excusatum
					<lb xml:id="p1z27"/>itaque habebis.
					<lb xml:id="p1z28"/>Salutabis humanissimo et d
					<lb xml:id="p1z29"/>igentissimo, si apud vos est
					<lb xml:id="p1z30"/>d. d. Ioannes Culmannu
					<pb/>
					<lb xml:id="p2z1"/>Praestantissimo viro d. d.
					<lb xml:id="p2z2"/>Theodoro Zuingenio
					<lb xml:id="p2z3"/>Basiliensis Helvetio
					<lb xml:id="p2z4"/>medico, Latavii agenti
					<lb xml:id="p2z5"/>homino suo colendmo
					<lb xml:id="p2z6"/>et fratri charissimo.
				</p>
			</div>
		</body>
	</text>
