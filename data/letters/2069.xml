	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quid cum <persName ref="p6589">Serveto</persName> actum sit, nullus dum ami<lb xml:id="p1z2"/>corum ad me scripsit; tamen ex aliis certis, imo <foreign xml:lang="el">αὐτόπταις</foreign> <lb xml:id="p1z3"/>cognovi ipsum 27. octobris dignas suarum blasphemi<lb xml:id="p1z4"/>arum per ignem luisse poenas.</s>
					<s n="3" xml:lang="la">Perstitit ad mortem <lb xml:id="p1z5"/>usque in suis erroribus nec perpercit sanctissimae <lb xml:id="p1z6"/>trinitati, quin eam ad ignem usque blasphemare<lb xml:id="p1z7"/>t tricipitem<note type="margin">a.R.: tricicipitem</note> appellans bestiam.</s>
					<s n="4" xml:lang="la">Adfuit ei ad <lb xml:id="p1z8"/>supplicium eunti <persName ref="p1049">Farellus</persName>, nescio an ad id evocatus, <lb xml:id="p1z9"/>quem spero brevi totam ad me transmissurum <lb xml:id="p1z10"/>historiam.</s>
					<s n="5" xml:lang="la">Quam si accepero, communicabo tibi quoque, <lb xml:id="p1z11"/>quamvis interea minime dubitem, quin typis <lb xml:id="p1z12"/>sit tota est actio excudenda.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quod res novas <lb xml:id="p1z13"/>alias concernit, fertur apud nos <persName ref="p2916">Schertlium</persName> <lb xml:id="p1z14"/>esse <placeName ref="l18">Augustae</placeName> et dominatum suum in <placeName ref="l76">Burtenbach</placeName> <lb xml:id="p1z15"/>integrum iterum recepisse idque beneficio regis <lb xml:id="p1z16"/><persName>Ferdinandi</persName>, cuius ille nunc sequi videtur partes.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/>De comitiis indictis idem apud nos fertur, quod et <lb xml:id="p1z18"/>apud vos.</s>
					<s n="8" xml:lang="la"><persName>Marchio Albertus</persName> firmata cum <lb xml:id="p1z19"/><persName>Augusto</persName> pace <placeName ref="l361">Norinbergensibus</placeName> iterum infestus est, <lb xml:id="p1z20"/>occupatam ab ipsis suam ditionem recuperat, et in <lb xml:id="p1z21"/>maiore quam antehac unquam ipsi versantur periculo.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z22"/>Compositam quoque ferunt omnem controversiam, quę <lb xml:id="p1z23"/>fuit inter <persName ref="p19065">Ioannem Fridericum</persName> et <persName ref="p18509">Augustum</persName>, <placeName ref="l749">Saxoniae</placeName> <lb xml:id="p1z24"/>duces, et <persName ref="p19065">Ioannem Fridericum</persName> omnem suam recepisse, <lb xml:id="p1z25"/>quam prius possederat, ditionem, solam electora<lb xml:id="p1z26"/>tus causam pendere adhuc a iudicio statuum <lb xml:id="p1z27"/>imperialium.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ex <placeName ref="l832">Gallia</placeName> nihil habemus, neque ullae <lb xml:id="p1z28"/>ad me pervenerunt literae, quę tibi debeantur.</s>
					<s n="11" xml:lang="la">T[uas] <lb xml:id="p1z29"/>ad <persName ref="p540">Calvinum</persName> curabo hodie.</s>
					<s n="12" xml:lang="la">Nostrum responsum <lb xml:id="p1z30"/>proxime ad te mittam; curabo enim describi, sicut [a me] <lb xml:id="p1z31"/>petiisti; tu, ut promittis, <placeName ref="l28">Basiliensium</placeName> quoque communica.</s>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z32"/>Bene vale cum tuis omnibus, quos cupio salvos, <lb xml:id="p1z33"/>dominos item fratres ac symmistas universos.</s>
					<s n="14" xml:lang="la" ana="salute">Salutant <lb xml:id="p1z34"/>vos nostri quoque.</s>
					<s n="15" xml:lang="la">Hodie satis frequens hic est <lb xml:id="p1z35"/>mercatus, qui facit, ut plura non possim.</s>
					<s n="16" xml:lang="la">Datum <lb xml:id="p1z36"/>Martino nuncupata die 1553.</s>
					<s n="17" xml:lang="la"><placeName ref="l41">Bernae</placeName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><persName ref="p8018">I[oa<lb xml:id="p1z37"/>nnes] Hallerus</persName> tuus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, domino <lb xml:id="p2z4"/>ac compatri suo venerando.</s>
				</p>
				<p>
					<s n="20" xml:lang="de"><lb xml:id="p2z5"/>M. <persName ref="p495">Heinrych Bullinger<lb xml:id="p2z6"/>en</persName> zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
