	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Tua diligentia arguit me peccati; nam <lb xml:id="p1z2"/>dudum ego accepi descriptionem pugnae <placeName ref="l2653">Mosco<lb xml:id="p1z3"/>viticae</placeName> seu <placeName ref="l2472">Polonicae</placeName> ex <placeName ref="l18">Augusta</placeName> nec communicavi.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Remitto tibi tuam descriptionem et ago gratias.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Interea scribitur ad me ecclesias brevi missuras <lb xml:id="p1z6"/><placeName ref="l260">Cracovia</placeName> legatum ad nos et <placeName ref="l167">Genevenses</placeName> propter <lb xml:id="p1z7"/>quaestiones varias <foreign xml:lang="de">(erfröwt mich wol, das mir <lb xml:id="p1z8"/>aber zuͦ werch geschnitten wirt, deren arbeit <lb xml:id="p1z9"/>mir sunst vil ander zuͦbereitend)</foreign> et <placeName ref="l2653">Moscos</placeName> <lb xml:id="p1z10"/>subsidium accepisse a <placeName>Tartaris</placeName> 30000 equitum et <lb xml:id="p1z11"/>se apparare ad pugnam novam etc.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Apparere passim <lb xml:id="p1z12"/>in <placeName ref="l2472">Polonia</placeName> multa et stupenda e coelo prodigia etc.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Dominus misereatur nostri et ipsorum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Coepta sunt <lb xml:id="p1z14"/>comitia <placeName>Badae</placeName>; sed nihildum habeo certi de c[ausa] <lb xml:id="p1z15"/><placeName ref="l646">Claronensi</placeName>; multi male ominantur; utinam res melius <lb xml:id="p1z16"/>cedat quam hactenus.</s>
					<s n="8" xml:lang="de">Söllend wir buͤssen und <lb xml:id="p1z17"/>zuͦ grund gan, sind guͦte mittel darzuͦ.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Fastus <lb xml:id="p1z18"/>et superbia [istorum] ascendit in coelum; minarum <lb xml:id="p1z19"/>nullus est finis.</s>
					<s n="10" xml:lang="la">Forte pervenit ad vos <persName ref="p3375">Vergerius</persName>; <lb xml:id="p1z20"/>diligenter perquisivit, quid egisset legatus <persName>Philippi</persName> <lb xml:id="p1z21"/>apud <placeName ref="l648">Rhetos</placeName>; exposui ipsi rem, qua potui fide.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z22"/>Ex ipso audies plura; videtur iam desipere <foreign xml:lang="de">und <lb xml:id="p1z23"/>fast an der kinden statt sin.</foreign></s>
				</p>
				<p>
					<s n="12" xml:lang="la">Redditus est mihi <persName ref="p458">Brentii</persName> <lb xml:id="p1z24"/>liber vastus et amarulentus, perplexus et <lb xml:id="p1z25"/>maliciosissime scriptus etc.</s>
					<s n="13" xml:lang="la">Crescunt mea negotia <lb xml:id="p1z26"/>in horas, et vires decrescunt.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Sed ita visum est deo <lb xml:id="p1z27"/>patri meo, qui si mihi adfuerit gratia sua, nihil <lb xml:id="p1z28"/>amplius peto in mundo.</s>
					<s n="15" xml:lang="de">Ich bin sunst die 8 tag nitt <lb xml:id="p1z29"/>fast starck gesin, hab gar nüt thuͦn mögend, <lb xml:id="p1z30"/>und hept mich an min schweche fast hinderen <lb xml:id="p1z31"/>an allen minen sachen.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Sed ita placet domino, <lb xml:id="p1z32"/>placet itaque et mihi etc.</s>
					<s n="17" xml:lang="la">A <placeName ref="l157">Francfordia</placeName> nunquam <lb xml:id="p1z33"/>habui plus ocii; paucae literae, vix 10 aut 12, <lb xml:id="p1z34"/>allatae sunt; propter pestem enim pauci accessere.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z35"/>Sed deferbuit illa illic; schola quoque rediit <lb xml:id="p1z36"/><placeName ref="l210">Heydelbergam</placeName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Principes <placeName ref="l822">Germani</placeName> ediderunt <lb xml:id="p1z37"/>scripto c[aus]as, cur nolint recipere concilium <placeName ref="l1107">Tridentinum</placeName>, <lb xml:id="p1z38"/>Germanice etc.</s>
					<s n="20" xml:lang="la">Posterioribus tuis vera scribis <lb xml:id="p1z39"/>aenigmata; nunquam vidi comitem ab <persName>Helfenstein</persName>, <lb xml:id="p1z40"/>ac profectus est ille <placeName ref="l425">Romam</placeName> magno comitatu etc. nec <placeName ref="l587">Tigurum</placeName> veni<lb xml:id="p1z41"/>t.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="farewell">Vale cum omnibus bonis.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 14. <lb xml:id="p1z43"/>aprilis 1564.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="salute">Salutant te mei omnes.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Tuus <persName ref="p495">H[einrychu<lb xml:id="p1z44"/>s] B[ullingerus]</persName>.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro, domino <lb xml:id="p2z4"/>et fratri meo colendo et dilecto.</s>
					<s n="26" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
