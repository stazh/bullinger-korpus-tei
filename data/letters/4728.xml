	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literas tuas nunc recepi scriptas 21. huius cum tractatione <lb xml:id="p1z2"/>verborum domini In domo patris mei et gratiam habeo.</s>
					<s n="3" xml:lang="la">Denuo <lb xml:id="p1z3"/>ab aula literas accepi, quibus signifficant amici gratissima <lb xml:id="p1z4"/>fuisse, que tu scripsisti.</s>
					<s n="4" xml:lang="la">Puto in bona causa et pia regi <lb xml:id="p1z5"/>non defuturos amicos et deum illi adfuturum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Die octava <lb xml:id="p1z6"/>aut nona aprilis te invisam et coram pluribus agemus.</s>
					<s n="6" xml:lang="la" ana="salute"><lb xml:id="p1z7"/>Salutat te tota familia.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Salutabis meo nomine amicos omnes.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z8"/><placeName ref="l760">Soluturi</placeName> 24. martii.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z9"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="de"><pb/><lb xml:id="p2z1"/>An herren <persName ref="p495">Heinrich <lb xml:id="p2z2"/>Bullinger</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
