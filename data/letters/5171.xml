	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Reverende pater S. <lb xml:id="p1z2"/>Huiusce futuri colloquii inter principes <lb xml:id="p1z3"/><placeName ref="l572">Wirt[empergensem]</placeName>, <placeName>Bipont[inum]</placeName> et <placeName>Guis[ianum]</placeName> causam hanc <lb xml:id="p1z4"/>esse quidam aiunt: <placeName>Guis[ianum]</placeName> simulare se <lb xml:id="p1z6"/><placeName ref="l18">Augustanam</placeName> confessionem recepturos curaturosque <lb xml:id="p1z7"/>ut alii quoque eam recipiant, sed vicissim <lb xml:id="p1z8"/>favorem ab ipsis principibus <placeName ref="l822">Germaniae</placeName> petere apud <lb xml:id="p1z9"/><placeName ref="l832">Gallum</placeName>, ut ipsis <placeName>Guisianis</placeName> liceat ex <placeName ref="l832">Galliis</placeName> <lb xml:id="p1z10"/>omnes suos census atque proventus habere; <lb xml:id="p1z11"/>illos enim retineri a rege seu impediri, <lb xml:id="p1z12"/>dum causa illius de <placeName>Namors</placeName> cognoscitur.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z13"/>Sed alius, qui melius novit, quid sit in <lb xml:id="p1z14"/>olla, ait Guis[ianum]meditari aliquid contra <lb xml:id="p1z15"/><placeName>Gallum</placeName>, optare tantum, ne principes <lb xml:id="p1z16"/>confessionis <placeName ref="l18">Augustane</placeName> se impediant, et <lb xml:id="p1z17"/>ut hoc obtineant, simulare se velle com<lb xml:id="p1z18"/>plecti confessionem <placeName ref="l18">Augustanam</placeName> et pro ea pugnaturos <lb xml:id="p1z19"/>curaturosque, ut eam <placeName>Gallia</placeName> recipiat<lb xml:id="p1z20"/>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z21"/>Nolui hęc te celare.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Hoc alterum magis <lb xml:id="p1z22"/>credo, quia is, a quo accepi, levis homo <lb xml:id="p1z23"/>non est et multa novit.</s>
					<s n="5" xml:lang="la">Sed quicquid <lb xml:id="p1z24"/>fuerit, scribam mox ad te.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z25"/>Sententiam nondum tulit senatus pro causa <lb xml:id="p1z26"/>nostra neque contra causam.</s>
					<s n="7" xml:lang="la">Heri in conventu <lb xml:id="p1z27"/>fuit Marb[achius].</s>
					<s n="8" xml:lang="la">Propositum fuit, an videatur <lb xml:id="p1z28"/>consultum, ut organa pulsantur, dum celebratur <lb xml:id="p1z29"/>cęna; idem enim etiam fieri iam <placeName ref="l28">Basileę</placeName>, <lb xml:id="p1z30"/>quamquam duo ibi capita contorta (Germanic<lb xml:id="p1z31"/>um vocabulum ignoro), quorum unum <pb/><lb xml:id="p2z1"/>mortuum iam est (alludebatur ad nostrum <lb xml:id="p2z2"/>Iunium) acerrime restiterint, nunc <lb xml:id="p2z5"/>ex iis <lb xml:id="p2z6"/>cogita reliqua; sunt <lb xml:id="p2z8"/>autem, <lb xml:id="p2z9"/>quę scribo, verissima -, et bonum <lb xml:id="p2z11"/><persName>Conradum</persName> inversis omnes oculis intuentur seque <lb xml:id="p2z12"/>nolle illum agnoscere pro fratre.</s>
					<s n="9" xml:lang="la">Stur[mius] <lb xml:id="p2z13"/>et professores sunt constantissime pro <lb xml:id="p2z14"/>causa Christi.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z15"/>Raptim hęc, <lb xml:id="p2z18"/>et boni consule meas ineptas literas; <lb xml:id="p2z19"/>malui inepte quam nihil.</s>
					<s n="11" xml:lang="la" ana="salute">Vale <lb xml:id="p2z21"/>et salutem dicito nostro reverendo patri d. <persName ref="p8111">Pe[tro] Martyri</persName> et <lb xml:id="p2z22"/>fratribus omnibus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z24"/><placeName ref="l491">Argentina</placeName> 13. februarii.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Cras expectatur <lb xml:id="p2z25"/>hic Wirt[emperge<lb xml:id="p2z26"/>nsis].</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z27"/>T[uae] prae<lb xml:id="p2z28"/>stanti<lb xml:id="p2z29"/>ae totus, quantusquant<lb xml:id="p2z31"/>u<lb xml:id="p2z32"/>s est, <lb xml:id="p2z34"/><persName ref="p4037">Hi[erony<lb xml:id="p2z35"/>mus] Z[anchus]</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z36"/>[Hin<lb xml:id="p2z37"/>ter 836:<lb xml:id="p2z38"/>] Re<lb xml:id="p2z39"/>ve<lb xml:id="p2z40"/>re<lb xml:id="p2z41"/>ndo <lb xml:id="p2z42"/>atque <pb/><lb xml:id="p3z1"/>obser<lb xml:id="p3z2"/>vandissim<pb/><lb xml:id="p4z1"/>o patri d. <lb xml:id="p4z2"/><persName ref="p495">Henrico Bullingero</persName>, ecclesię <lb xml:id="p4z3"/><placeName ref="l587">Tigurinę</placeName> pastori <lb xml:id="p4z4"/>vigilantissimo.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p4z5"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
