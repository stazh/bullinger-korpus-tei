	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Omnes tuas et omnia accepi et pro his omnibus <lb xml:id="p1z2"/>magnas ago gratias.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Cum ultimas accepissem, quibus sign<lb xml:id="p1z3"/>ificas arcem <placeName ref="l2678">Ramüs</placeName> combustam et d. consulem <persName>Martinum</persName> <lb xml:id="p1z4"/>a me petere, ut consuli nostro significem, ac ilico venissem <lb xml:id="p1z5"/>ad consulem, acceperat is iam ipse literas eadem de re testantes <lb xml:id="p1z6"/>rectaque petebat curiam senatoriam expositurus se<lb xml:id="p1z7"/>natui totum hoc negotium.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ego recta ibam ad diversorium <lb xml:id="p1z8"/>Ciconiae, ubi audieram agere legatum vestrum d. <lb xml:id="p1z9"/><persName>Ioannem a Capaul</persName>, qui sub vesperam <placeName ref="l21">Bada</placeName> rediisse dicebatur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Ei, prout iusseras, totum exposui negotium.</s>
					<s n="6" xml:lang="la">Expavit; ego <lb xml:id="p1z11"/>illum confirmabam.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Mox veniebat senator e senatu, qui <lb xml:id="p1z12"/>ipsi referebat iam in senatu decretum, ut literae acceptae <lb xml:id="p1z13"/>mitterentur <placeName ref="l21">Badam</placeName> ad consulem; adhuc enim legati <placeName ref="l862">Hel<lb xml:id="p1z14"/>vetiorum</placeName> haerent cras demum abituri.</s>
					<s n="8" xml:lang="la">Festinatione <lb xml:id="p1z15"/>alioqui opus erit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Caeterum nomine omnium <placeName ref="l862">Helvetiorum</placeName> ibunt <lb xml:id="p1z16"/>in <placeName ref="l648">Rhetiam</placeName> legati <placeName ref="l587">Tigurinorum</placeName>, <placeName ref="l300">Lucernatum</placeName>, <placeName ref="l2450">Svitensium</placeName> <lb xml:id="p1z17"/>et <placeName ref="l646">Clareanorum</placeName>.</s>
					<s n="10" xml:lang="la">Familiariter multa colloqutus sum cum <lb xml:id="p1z18"/>nobili <persName>a Capaal</persName>; plurimum is te praedicabat etc.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Libellum <lb xml:id="p1z19"/>ille, qui compingit, nondum plane paravit; alioqui nunc mitterem <lb xml:id="p1z20"/>ad episcopum; sed sat cito, si sat bene.</s>
					<s n="12" xml:lang="la">Doleo illi <lb xml:id="p1z21"/>combustam esse arcem, quam audio elegantem fuisse.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Utinam brevi non audiamus furiosos illos et alia <lb xml:id="p1z23"/>loca devastasse!</s>
					<s n="14" xml:lang="de">Wil ein nüwen purenkrieg gäben.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z24"/>Dominus donet nobis pacem!</s>
					<s n="16" xml:lang="la">Praeter ea, quae ab<lb xml:id="p1z25"/>hinc octiduo scripsi, nihil ab amicis accepi.</s>
					<s n="17" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z26"/><placeName ref="l587">Tiguri</placeName> 9. martii.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute">Amplissimum virum d. legatum salutabis <lb xml:id="p1z27"/>humanissime et d. consules.</s>
				</p>
				<p>
					<s n="20" xml:lang="de">Des wyns vergessend nitt <lb xml:id="p1z28"/>minem h. burgermeister zuͦ schicken.</s>
				</p>
				<p>
					<s n="21" xml:lang="de">Ich hab imm üwer <lb xml:id="p1z30"/>schriben geläsen; danckt er üch trüwlich, und <lb xml:id="p1z31"/>zuͦ üwer gelägenheit söllend ir inn fertigen.</s>
					<s n="22" xml:lang="de">Erstlich l<lb xml:id="p1z32"/>uͦgen, das er üch gerächt, unverfelscht werde, <lb xml:id="p1z33"/>demnach das er uff der fart hiehar nitt verderpt <lb xml:id="p1z34"/>werdi; da mag üch min herr <persName ref="p3196">Tscharner</persName> wol hälffen, <lb xml:id="p1z35"/>das er etwan yngemacht, das man nitt köne darüber <lb xml:id="p1z37"/>kummen.</s>
					<s n="23" xml:lang="de">1565.</s>
					<s n="24" xml:lang="la"><lb xml:id="p1z38"/><persName ref="p495">Bullinger</persName>.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fideli, domino <lb xml:id="p2z4"/>et fratri meo colendo et dilecto.</s>
				</p>
			</div>
