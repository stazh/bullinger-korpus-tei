	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nihil habeo, quod modo ad te scribam.</s>
					<s n="3" xml:lang="la">Tantum, quia <lb xml:id="p1z2"/>nuncius ille illuc abit, volui illi has ad te dare, ut <lb xml:id="p1z3"/>tibi, si quid ad nos per ipsum mittere velles, certus daretur <lb xml:id="p1z4"/>tabellarius.</s>
					<s n="4" xml:lang="la">Valde enim desydero tuas ingruentibus <lb xml:id="p1z5"/>tantis motibus nec possum non<note type="margin">a.R.: non...? .. satis.</note> mirari, qui fiat, quod ita <lb xml:id="p1z6"/>prorsus nunc sileas.</s>
					<s n="5" xml:lang="la"><persName ref="p8417">Musculus</persName> cum Mecardo <placeName ref="l28">Basilęam</placeName> <lb xml:id="p1z7"/>est profectus.</s>
					<s n="6" xml:lang="la">Rediit pridie; narrat <persName ref="p2916">Schertlium</persName> per episcopatum <lb xml:id="p1z8"/><placeName ref="l28">Basiliensem</placeName> suum militem ducere in <placeName ref="l691">Lotharingiam</placeName>, ut ibi se <lb xml:id="p1z9"/>regis coniungat copiis.</s>
					<s n="7" xml:lang="la">Quo sint proposito aut quid agant <lb xml:id="p1z10"/>aquilonares, vel ipse nescit vel ego ab eo extorquere n<lb xml:id="p1z11"/>equeo.</s>
					<s n="8" xml:lang="la">Rumor est <persName ref="p18477">Ferdinandum</persName> a <placeName ref="l2510">Turca</placeName> inducias <lb xml:id="p1z12"/>impetrasse; hoc si verum est, viderint nostri, quid agant.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>Nostri homines (quod et prius scripsi) nimium ferociunt, et est <lb xml:id="p1z14"/>magnum nobis modo cum illis negotium, ut ipsos cohibeamus.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/>Metuo valde consulatum <persName ref="p2305">Negelini</persName>, quem inibit <lb xml:id="p1z16"/>sub festum paschae futurum.</s>
					<s n="11" xml:lang="la">Dominus cohibeat illius spiritum <lb xml:id="p1z17"/>et conatus, ut nostro contenti in domino tranquille vi<lb xml:id="p1z18"/>vamus.</s>
					<s n="12" xml:lang="la">Amen.</s>
					<s n="13" xml:lang="la">Varia haberem, quę cuperem in sinum <lb xml:id="p1z19"/>tuum effundere, sed literis commendare non ausim.</s>
					<s n="14" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z20"/>vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute">Salvi sint fratres omnes, tum quoque domestici tui, <lb xml:id="p1z21"/>quos ex me meisque omnibus diligenter salutabis.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z22"/><placeName ref="l41">Bernę</placeName> 26. martii 1552.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">T[<lb xml:id="p1z23"/>uus] <persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Bul<lb xml:id="p2z2"/>lingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesię pastori fidelissi<lb xml:id="p2z4"/>mo, domino et compatri <lb xml:id="p2z5"/>suo colendissimo.</s>
				</p>
				<p>
					<s n="19" xml:lang="de"><lb xml:id="p2z6"/>M. <persName ref="p495">Heinrych Bullinger<lb xml:id="p2z7"/>n</persName> zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
