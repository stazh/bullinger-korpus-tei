	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Binas abs tua humanitate literas accepi, colendissime <lb xml:id="p1z2"/>mi <persName ref="p540">Calvine</persName>.</s>
					<s n="3" xml:lang="la">Ex posterioribus intelligo quanti <lb xml:id="p1z3"/>feceris faciasque illa mea officia, vobis in causa <lb xml:id="p1z4"/>illa communi praestita.</s>
					<s n="4" xml:lang="la">Ego vero me totum et tibi et tuis <lb xml:id="p1z5"/>debere scio.</s>
					<s n="5" xml:lang="la">Unde si quid posthac in vestri gratiam <lb xml:id="p1z6"/>facere potero, me totum vobis impendam.</s>
					<s n="6" xml:lang="la">Legati <lb xml:id="p1z7"/>ipsi caetera referent.</s>
					<s n="7" xml:lang="la">Nam brevitas temporis <lb xml:id="p1z8"/>et negotia quibus distrahor, brevem in scribendo <lb xml:id="p1z9"/>esse iubent.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Non inique fero, si a me in causa illa <lb xml:id="p1z10"/>dissentias.</s>
					<s n="9" xml:lang="la">Ego vero, mi <persName ref="p540">Calvine</persName>, hodie minus spei <lb xml:id="p1z11"/>habeo quam habuerim heri.</s>
					<s n="10" xml:lang="la">Scio homines illos nihil <lb xml:id="p1z12"/>mutaturos, in sententia illa sua carnali.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Exper<lb xml:id="p1z13"/>ieris ipse.</s>
					<s n="12" xml:lang="la">Scribunt his diebus ad me ex aula <lb xml:id="p1z14"/><persName ref="p17927">Palatini</persName> et ex <placeName ref="l572">Wirtenbergensi</placeName> ducatu, nihil esse <lb xml:id="p1z15"/>spei fore ut recipiatur syncera de coena Domini doctrina<lb xml:id="p1z16"/>.</s>
					<s n="13" xml:lang="la">Quotidie enim homines illos duriores per<lb xml:id="p1z17"/>tinaciores et intractabiliores reddi in suo illo <lb xml:id="p1z18"/>Lutheranismo.</s>
					<s n="14" xml:lang="la">Missi sunt ad me (tres) 3 sermones ger<lb xml:id="p1z19"/>manice scripti et excusi vulgatique a <persName ref="p458">Brentio</persName>.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z20"/>Hui, quam crasse et papistice scribit hic <lb xml:id="p1z21"/>senex theologus de coena Domini.</s>
					<s n="16" xml:lang="la">Hic autem obse<lb xml:id="p1z22"/>quentes sibi principes habet <placeName ref="l2477">Palatinum</placeName> electorem et <placeName ref="l572">Wir<lb xml:id="p1z23"/>tenbergensem</placeName>, a quibus fere dependent reliqui.</s>
					<s n="17" xml:lang="la">Unde <lb xml:id="p1z24"/>arbitror non ambienda colloquia.</s>
					<s n="18" xml:lang="la">Quod si vocati <lb xml:id="p1z25"/>fuerimus ab illis, puto pro ratione temporis ten<lb xml:id="p1z26"/>tandum quod tum videbitur optimum.</s>
					<s n="19" xml:lang="la">Illud vero <lb xml:id="p1z27"/>non sine periculo tentat D. <persName ref="p8041">a Lasco</persName>, quod nostram <lb xml:id="p1z28"/>sententiam vult conciliare cum confessione <placeName ref="l18">Augustana</placeName>.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z29"/>Scio quando et quomodo edita sit et exhibita <persName ref="p18538">Caesari</persName>, <lb xml:id="p1z30"/>quibus scripta authoribus.</s>
					<s n="21" xml:lang="la">Nimis crassa est Apologia.</s>
					<s n="22" xml:lang="la"><lb xml:id="p1z31"/>Reddet se et doctrinam suam suspectam si ita perrex<lb xml:id="p1z32"/>erit.</s>
					<s n="23" xml:lang="la">Omnes clamabunt imprudentissime, imo <lb xml:id="p1z33"/>impudentissime factum.</s>
					<s n="24" xml:lang="la">Utinam ergo rem propius <lb xml:id="p1z34"/>pensitet.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">In <placeName ref="l2574">Livonia</placeName> maximum est exortum <lb xml:id="p1z35"/>bellum.</s>
					<s n="26" xml:lang="la">Exoritur iam cruentissimum inter <persName ref="p18538">Caesarem</persName> et <persName ref="p19981">Pa<lb xml:id="p1z36"/>pam</persName>.</s>
					<s n="27" xml:lang="la">Conscribitur in <placeName ref="l822">Germania</placeName> miles.</s>
					<s n="28" xml:lang="la">Speramus <lb xml:id="p1z37"/>D. <persName ref="p8111">Petrum Martyrem</persName> magno ecclesiae bono ad nos <lb xml:id="p1z38"/>venisse.</s>
					<s n="29" xml:lang="la">Oramus Dominum ut rem bene fortunet<pb/><lb xml:id="p2z1"/>.</s>
					<s n="30" xml:lang="la"><lb xml:id="p2z2"/>Dominus Iesus benedicat tibi et tuis omnibus.</s>
				</p>
				<p>
					<s n="31" xml:lang="la" ana="salute"><lb xml:id="p2z3"/>Salutant te fratres.</s>
					<s n="32" xml:lang="la" ana="salute">Saluta nobis fratres et symmystas.</s>
					<s n="33" xml:lang="la" ana="farewell">Vale aeternum.</s>
				</p>
				<p>
					<s n="34" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 28. Augusti ann<lb xml:id="p2z4"/>o Domini 1556.</s>
				</p>
				<p>
					<s n="35" xml:lang="la"><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="36" xml:lang="la">Clarissimo viro D. <persName ref="p540">Ioanni Calvino</persName> <placeName ref="l167">Genevensis</placeName> ecclesiae fid<lb xml:id="p2z5"/>o pastori, domino colendissimo <lb xml:id="p2z6"/>et fratri charissimo suo.</s>
					<s n="37" xml:lang="de"><placeName ref="l167">Genff</placeName>.</s>
				</p>
