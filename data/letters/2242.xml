	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quod proxime de transitu <persName ref="p17907">Gonzagae</persName> permisso scripsi, <lb xml:id="p1z2"/>ea conditione interea factum intellexi, ut sine omni <lb xml:id="p1z3"/>armatura bellioque apparatu, si velit, transeat, id quod <lb xml:id="p1z4"/>cum ipse nolit, alia via exercitum deducet in <placeName ref="l20">Inferiorem <lb xml:id="p1z5"/>Germaniam</placeName>, per vallem scilicet Athesinam.</s>
					<s n="3" xml:lang="la">Accepimus quoque <lb xml:id="p1z6"/>interea ex <placeName ref="l18">Augusta</placeName> literas, quibus significatur <persName ref="p19065">Ioannem <lb xml:id="p1z7"/>Friderychum</persName>, <placeName ref="l749">Saxonię</placeName> ducem 3. martii e vivis excessisse <lb xml:id="p1z8"/>simulque 9 diebus ante ipsum obiisse uxorem suam.</s>
					<s n="4" xml:lang="la">Obiit <lb xml:id="p1z9"/>quoque <persName>Arnoldus</persName> ille, ducis <persName ref="p8105">Ottonis Heinrychi</persName> quaestor, quem <lb xml:id="p1z10"/>nosti.</s>
					<s n="5" xml:lang="la">Alias ex <placeName ref="l18">Augusta</placeName> nihil habemus, nisi quod de comitiis <lb xml:id="p1z11"/>a Caesare indictis scribunt, quae tamen non futura sperant.</s>
					<s n="6" xml:lang="de"><lb xml:id="p1z12"/>Es sol hertzog <persName ref="p1546">Christoff von Wirtenberg</persName> imm anfang diß monats <lb xml:id="p1z13"/>ußgezogen sin für <placeName ref="l1426">Hohen-Rechberg</placeName>, das schloß, von wegen <lb xml:id="p1z14"/>das imm derselbig edelman, <persName>Uͦtz von Rechberg</persName> genannt, <lb xml:id="p1z15"/>zwen puren erstochen.</s>
					<s n="7" xml:lang="de">Die <placeName ref="l361">Nürenbergischen</placeName> söllend <lb xml:id="p1z16"/>auch noch vor <placeName>Blasenburg</placeName> ligen, <placeName>Ruchenpalm</placeName> eroberet <lb xml:id="p1z17"/>haben, deß kriegens muͤd sin und deß marggrafen halb <lb xml:id="p1z18"/>in großen sorgen ston.</s>
				</p>
				<p>
					<s n="8" xml:lang="de">Zuͦ <placeName ref="l513">Ulm</placeName> hatt man wider ei<lb xml:id="p1z19"/>n predicanten, der gar lutherisch, und halt man in <lb xml:id="p1z20"/>einer kirchen 3 religiones nacheinander.</s>
					<s n="9" xml:lang="de"><lb xml:id="p1z21"/>Diß schript <persName ref="p5355">Onoffrius Hürus</persName> <persName ref="p8055">Blaurero</persName>, der selb da gwesen.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z22"/>Idem de <placeName ref="l830">Anglia</placeName> multa et plausibilia, sed non admodum <lb xml:id="p1z23"/>certa.</s>
					<s n="11" xml:lang="la">Scribit <persName ref="p2916">Schertlinum</persName> Caesari quidem reconciliatum, <lb xml:id="p1z24"/>nondum vero <persName ref="p18477">Ferdinando</persName> regi, id quod diversum <lb xml:id="p1z25"/>est ab eo, quid hic de illo fuit sparsum; <foreign xml:lang="de">hatt ein pre<lb xml:id="p1z26"/>dicanten widerumb gen <placeName ref="l76">Burtenbach</placeName>, da sin herrschafft ist, <lb xml:id="p1z27"/>gesetzt.</foreign></s>
					<s n="12" xml:lang="la">Haec quoniam ex <placeName ref="l18">Augusta</placeName> partim, partim a <lb xml:id="p1z28"/>Blaurero accepimus, volui tibi quoque communicare, quamvis <lb xml:id="p1z29"/>haec ipsa et multa alia et certiora te habere existimem.</s>
					<s n="13" xml:lang="la">Hodie <lb xml:id="p1z30"/>lecti sunt senatores novi 3, inter quos <persName ref="p3544">Wolphgangus <lb xml:id="p1z31"/>ab Erlach</persName> fratri <persName ref="p3530">Ioanni Rodolpho</persName> successit, quem etiam <lb xml:id="p1z32"/>(non dubito) prudentia superabit, humanitate certe <lb xml:id="p1z33"/>nunc antecellit longe.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Salutat te quęstor <persName ref="p8012">Hallerus</persName>, <lb xml:id="p1z34"/><persName ref="p8417">Musculus</persName> noster et <persName ref="p2919">Schlatterus</persName>, simul quoque uxor mea; <lb xml:id="p1z35"/>salvi sint omnes tui.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="16" xml:lang="la"><placeName ref="l41">Bernae</placeName> 28. martii.</s>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z36"/>Fratri meo nihil scribo; salutabis illum ex me et ex <lb xml:id="p1z37"/>his, quę videbuntur, poteris communicare.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z38"/><persName ref="p8018">Hallerus</persName> tuus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae fidelissimo pastori, domino <lb xml:id="p2z4"/>et compatri suo charissimo.</s>
				</p>
				<p>
					<s n="20" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zürich</placeName>.</s>
					<s n="21" xml:lang="de">M. <persName ref="p495">Heinrych <lb xml:id="p2z6"/>Bullingeren</persName>.</s>
				</p>
			</div>
