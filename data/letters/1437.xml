	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil nunc, quod scribam, habeo, vene<lb xml:id="p1z2"/>rande domine et frater colendissime, nisi quod <lb xml:id="p1z3"/>tuas illas desideratas certe accepi.</s>
					<s n="3" xml:lang="la">De <lb xml:id="p1z4"/>concilio in horas expecto certa ex <placeName ref="l834">Italia</placeName>; <lb xml:id="p1z5"/>ea communicabo, ubi accepero.</s>
					<s n="4" xml:lang="la">Caesar miro <lb xml:id="p1z6"/>apparatu accingitur contra <persName ref="p8112">Gallum</persName>; suum illu<lb xml:id="p1z7"/>d "plus ultra" corr[u]ptis spirat ex extis.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Utinam rex et regnum potentissimum convertatur ad <lb xml:id="p1z9"/>dominum, ne effusum sanguinem <lb xml:id="p1z10"/>vindicet.</s>
					<s n="6" xml:lang="la">Si quid habes, diligenter significa.</s>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z11"/>Vale aeternum.</s>
					<s n="8" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 15. octobris 51.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z12"/><persName ref="p495">Bullingerus</persName> <lb xml:id="p1z13"/>tuus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/>Habitat hic <persName>Hector</persName> in m<lb xml:id="p1z15"/>inore urbe non procul <lb xml:id="p1z16"/>ab aedituo <lb xml:id="p1z17"/><persName ref="p164">Bonifacii Amorbachii</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p8418">Osvaldo Myconio</persName>, <lb xml:id="p2z3"/>domino <lb xml:id="p2z4"/>venerando et fratri <lb xml:id="p2z5"/>suo colendissimo.</s>
				</p>
				<p>
					<s n="12" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
