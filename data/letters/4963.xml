	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quoniam d. <persName ref="p8111">Petrus Martir</persName> ad te scribit, non dubito, quin ex eius literis <lb xml:id="p1z2"/>satis intelligas bonam eius valetudinem, quodque in ea conservanda nihil <lb xml:id="p1z3"/>prętermiserim.</s>
					<s n="3" xml:lang="la">Certior etiam fies de progressu religionis; posthac pluribus <lb xml:id="p1z4"/>scribam.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="salute">Salutabis amicos omnes.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Apud <placeName ref="l478">Sanctum Germanum</placeName> <lb xml:id="p1z5"/>14. septembris.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z6"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullinghero</persName>, ecclesiae <lb xml:id="p2z2"/><placeName ref="l587">Tigurinae</placeName> pastori vigilantissimo.</s>
					<s n="9" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
