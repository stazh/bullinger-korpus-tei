	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1"><persName ref="p8073" cert="high">Cousins</persName> (Cognatus') erster Brief an <persName ref="p495" cert="high">Bullinger</persName>.</note>
		<note xml:id="fn2" type="footnote" subtype="metadata" n="2">Siegel in Papier eingebunden, darauf Abdruck Abdruck "G". "G".</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus a salutis authore Iesu.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Quum hodie pauci admodum vivant homines, <lb xml:id="p1z2"/>vir in omni doctrinarum genere eminentissime ac bonorum omnium <lb xml:id="p1z3"/>celebratissime, qui apposite citraque reprehensionem tibi scribere queant <lb xml:id="p1z4"/>utpote viro extra omnem ingenii aleam posito<note xml:id="fn3" type="footnote" ana="bio" n="3">vir extra omnem ingenii aleam positus: <persName ref="p18991">Plinius d.Ä.</persName>, Naturalis historia, Praefatio, 7. Zu verstehen ist etwa: "ein zuverlässiger Mensch", "ein Mann von sicherer Begabung".</note>, videbar mihi non <lb xml:id="p1z5"/>leve admittere piaculum, si ego homuncio undique minimus tantum <lb xml:id="p1z6"/>heroa divinissimis negociis addictum <foreign xml:lang="el">ἀκαίροις</foreign><note xml:id="fna" type="footnote" n="a"><hi>In der Vorlage</hi> <foreign xml:lang="el">ἀκαιροῖς</foreign>.</note> <foreign xml:lang="el">λόγοις</foreign> vexarem <lb xml:id="p1z7"/>molestiaque afficerem.</s>
					<s n="3" xml:lang="la">Verum plurima et cedro quidem dignissima<note xml:id="fn4" type="footnote" n="4"><bibl source="b56">Adagia</bibl>, 4, 1, 54 (<bibl>ASD</bibl> II/7 73f. <ref target="file13103">Nr. 3054</ref>).</note> <lb xml:id="p1z8"/>monumenta, quibus te deum mortalibus prebes (vel nusquam locum <lb xml:id="p1z9"/>habet illud verbum <foreign xml:lang="el">ἄνθρωπος ἀνθρώπου</foreign><note xml:id="fnb" type="footnote" n="b"><hi>In der Vorlage</hi> <foreign xml:lang="el">ἄνθρωπου</foreign>.</note> <foreign xml:lang="el">δαιμόνιον</foreign>)<note xml:id="fn5" type="footnote" n="5"><bibl source="b56">Adagia</bibl>, 1, 1, 69 (<bibl>ASD</bibl> II/1 180-182, Nr. 69).</note>, <lb xml:id="p1z10"/>cum te pingunt, effigiant, exprimunt, ut in spem veniam hasce <lb xml:id="p1z11"/>nostras naenias boni aequique consulturum, pręsertim cum ab eo <lb xml:id="p1z12"/>proficiscantur pectore, cui numen quoddam divinissimum sis colendum <lb xml:id="p1z13"/>vel toto vitae spacio.</s>
					<s n="4" xml:lang="la">Quis enim nisi pessimus <persName ref="p495">Bullingerum</persName> <lb xml:id="p1z14"/>non suspiciat, veneretur, colat, qui divinitus e coelo delapsus orbis <lb xml:id="p1z15"/>terrarum utilitati verissime creditur et ab omnibus predicatur,<pb type="edition" next="268"/> <lb xml:id="p1z16"/>qua patet trium linguarum peritia?</s>
					<s n="5" xml:lang="la"><foreign xml:lang="el">Ω</foreign> ter et amplius felices,<note xml:id="fn6" type="footnote" n="6"><persName ref="p19882">Horaz</persName>, Carmina, 1, 13, 17.</note> <lb xml:id="p1z17"/>quibus tuo seculo nasci contigit!</s>
					<s n="6" xml:lang="la">Haec nimirum dies saeculum illud <lb xml:id="p1z18"/>aureum, quod vates divinissimi laudare sibi permisere<note xml:id="fn7" type="footnote" n="7">Vgl. z.B. <persName ref="p18867">Vergil</persName>, Aeneis, 6, 791f; 8, 324f und <persName ref="p19911">Ovid</persName>, Metamorphosen, 1, 89. - Lit.: Hartwig <hi>Heckel,</hi> in: <bibl source="b185">DNP</bibl> XII/2 706-710 (mit weiterer Lit.).</note>.</s>
					<s n="7" xml:lang="la">Iam reddita <lb xml:id="p1z19"/>est virgo illa Pallas, reddita per <persName ref="p495">Bullingerum</persName> Saturnia regna,<note xml:id="fn8" type="footnote" n="8">reddita <persName ref="p21112">Pallas</persName>, reddita Saturnia regna: Vgl. <persName ref="p18867">Vergil</persName>, Eclogae, 4, 6.</note> <lb xml:id="p1z20"/>hoc est syncerae theologiae et divinae doctrinae vera cognitio.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z21"/>Sit citra invidiae morsum dictum: „Tu maximus ille est unus, <lb xml:id="p1z22"/>qui nobis cunctando<note xml:id="fnc" type="footnote" n="c"><hi>In der Vorlage</hi> conctando.</note>, imo scribendo restituis rem“<note xml:id="fn9" type="footnote" n="9">Vgl. <persName ref="p19207">Ennius</persName>, Annales, 12, 370 und z.B. <persName ref="p18867">Vergil</persName>, Aeneis, 6, 845; <persName ref="p18986">Hieronymus</persName>, Epistula adversus <persName ref="p18889">Rufinum</persName> presbyterum Aquileiensem (= Liber tertius), 29 (<bibl>CChr-L</bibl> LXXIX 101, 14f).</note>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Rem dii servent <lb xml:id="p1z23"/>in Nestoreos annos<note xml:id="fn10" type="footnote" n="10">Vgl. Adagia, 1, 6, 66 (<bibl>ASD</bibl> II/2 93f, Nr. 566).</note>!</s>
					<s n="10" xml:lang="la">Dignus enim vir es, qui nunquam senescas <lb xml:id="p1z24"/>aut moriaris.</s>
					<s n="11" xml:lang="la">Sed quid te marmoreum facere pergo, quum in <lb xml:id="p1z25"/><placeName ref="l2084">Olympia</placeName>, imo in <placeName ref="l2084">Olympo</placeName> aureus erectus sis, et de <placeName ref="l971">Carthagine</placeName> <lb xml:id="p1z26"/>prestet tacere quam pauca dicere<note xml:id="fn11" type="footnote" n="11">de Carthagine prestet tacere quam pauca dicere: Vgl. Sallust, De bello lugurthino, 19, 2. Hier steht <placeName ref="l971">Karthago</placeName> als Metapher für <persName ref="p495">Bullinger</persName>.</note>?</s>
					<s n="12" xml:lang="la">Proinde mecum habitabo <lb xml:id="p1z27"/>cognoscens, quam mihi sit curta supellex<note xml:id="fn12" type="footnote" n="12">Vgl. <persName ref="p18967">Persius</persName>, Saturae, 4, 52.</note>, atque huic parti <lb xml:id="p1z28"/>coronide impacta ad reliqua properabo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">De eucharistia, <lb xml:id="p1z29"/>clarissime <persName ref="p495">Bullingere</persName>, in ea et fui et sum sententia, ut manducationem <lb xml:id="p1z30"/>spiritualem sola in Christum fide, qua pro nobis mortuum <lb xml:id="p1z31"/>et pro peccatis nostris satisfecisse credimus, peragi non dubitem.<pb type="scan" next="296"/></s>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Caeterum sacramentum coenę non solum notam esse et signum professionis, <lb xml:id="p2z2"/>sed et augendae fidei nostrae atque adeo excitandae relictum credo, in quo <lb xml:id="p2z3"/>nobis duo praecipua, nisi fallor, habenda sunt: alterum, ut in memoriam <lb xml:id="p2z4"/>domini faciamus pro ineffabili in nos collocato beneficio <foreign xml:lang="el">εὐχαριστοῦντες</foreign>, <lb xml:id="p2z5"/>alterum, ut verbis suis fidem<note xml:id="fnd" type="footnote" n="d"><hi>Nach</hi> fidem <hi>gestrichenes</hi> fidem.</note> habeamus.</s>
					<s n="15" xml:lang="la">Quum enim omnipotens <lb xml:id="p2z6"/>sit, eum longe maiora, quam quae verba promittunt, posse, an est cur <lb xml:id="p2z7"/>ambigamus?</s>
					<s n="16" xml:lang="la">Verba porro quum sic habeant: „Hoc est corpus meum, <lb xml:id="p2z8"/>hic est sanguis meus“<note xml:id="fn13" type="footnote" n="13"><cit type="bible"><ref>Mt 26, 26-28</ref></cit>; vgl. <cit type="bible"><ref>Lk 22, 19f</ref></cit>.</note>, adducor, imo perpellor (ne quid de unanimi <lb xml:id="p2z9"/>horum interpretatione tot seculis recepta dicam), ut corpus et <lb xml:id="p2z10"/>sanguinem Christi vere adesse et in coena distribui credam.</s>
					<s n="17" xml:lang="la">Qui <lb xml:id="p2z11"/>autem id accidat, ut rationi humanae est impervium, ita fidei <lb xml:id="p2z12"/>ex verbo domini notum adfirmo.</s>
					<s n="18" xml:lang="la">Ab hac sententia cum multi hodie <lb xml:id="p2z13"/>nonnihil varient, nonnunquam hęreo et, ut ingenue fatear, inter sacrum <lb xml:id="p2z14"/>et saxum sto<note xml:id="fn14" type="footnote" n="14"><bibl source="b56">Adagia</bibl>, 1, 1, 15 (<bibl>ASD</bibl> II/1 128f, Nr. 15).</note>.</s>
					<s n="19" xml:lang="la">Est in hoc mihi tuo consilio opus; quod si non habita <lb xml:id="p2z15"/>dignitatis tuae ratione imploro, qua humanitate es, boni consules.</s>
					<s n="20" xml:lang="la"><lb xml:id="p2z16"/>Haec sane facit, ut nihil mihi non apud te licere putem.</s>
					<s n="21" xml:lang="la">Te igitur <lb xml:id="p2z17"/>per Christum servatorem, ut hunc mihi scrupulum eximere <lb xml:id="p2z18"/>tuumque consilium communicare ne graveris, et rogo et obtestor<note xml:id="fn15" type="footnote" n="15"><persName ref="p495">Bullingers</persName> Antwort ist durch <persName ref="p8073">Cousins</persName> Brief vom 12. März 1545 (Zürich StA, E II 345, 289) bezeugt, aber nicht erhalten.</note>.<pb type="edition" next="269"/></s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="farewell"><lb xml:id="p2z19"/>Vale, theologorum omnium altissimum decus, et felicissime vive.</s>
					<s n="23" xml:lang="la"><lb xml:id="p2z20"/><placeName ref="l356">Nozerethi</placeName> <placeName ref="l631">Burgundionum</placeName><note xml:id="fn16" type="footnote" n="16"><placeName ref="l356">Nozeroy</placeName> (<placeName ref="l3575">Franche-Comté</placeName>), <placeName ref="l832">Frankreich</placeName>.</note>, 17. calendas iul[ias] anno Christiano <lb xml:id="p2z21"/>1544.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Tuus <lb xml:id="p2z22"/>addictissimus discipulus <lb xml:id="p2z23"/><persName ref="p8073">Gilbertus Cognatus</persName> <placeName ref="l356">Nozerenus</placeName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf f. 296a v.:]</note>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro d. domino <lb xml:id="p4z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p4z3"/>verae theologiae decori, <lb xml:id="p4z4"/>domino et pręceptori <lb xml:id="p4z5"/>observando.</s>
					<s n="26" xml:lang="la"><lb xml:id="p4z6"/><placeName ref="l587">Tiguri</placeName> <placeName ref="l862">Helvetiorum</placeName>.</s>
				</p>
			</div>
