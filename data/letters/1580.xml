	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Fasciculus literarum, quem proxime misisti <lb xml:id="p1z2"/>ad me, non venit neque mihi visus.</s>
					<s n="3" xml:lang="la">Celio nostro acta concilii <lb xml:id="p1z3"/>data sunt, mihi literę.</s>
					<s n="4" xml:lang="la">Postea misit ad me <persName>Cęlius</persName> tres sessio<lb xml:id="p1z4"/>nes, praeterea nihil.</s>
					<s n="5" xml:lang="la"><persName ref="p8298">Borrhaus</persName> noster literas tuas accepit, qui <lb xml:id="p1z5"/>nes<lb xml:id="p1z6"/>cio quid sit responsurus; nam totus, ut mihi videtur, in ist<lb xml:id="p1z7"/>is <lb xml:id="p1z8"/>arti<lb xml:id="p1z9"/>culis, quos misi, <persName ref="p2301">Osiandro</persName> favet.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Musęo, legato regis <persName>Gallię</persName> dedi literas tuas, qui hoc tempus <lb xml:id="p1z11"/>erat occupatissimus; dixit, si commode posset, velle rescribere.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>D. <persName ref="p2916">Schertlinum</persName> non vidi; nam adhuc latitat apud nos, neque ego <lb xml:id="p1z13"/>volui illi molestus esse ob varias causas.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Sed filio legi tuas, <lb xml:id="p1z14"/>et hae <persName ref="p18538">Cęsaris</persName> minae eum non terrent, neque latuerunt hactenus S. <lb xml:id="p1z15"/>insidiae illi dispositę.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Armat suos servos, conscribit militem, <lb xml:id="p1z16"/>sed occulte dimittit, nescio in quem locum, brevi abiturus ad <lb xml:id="p1z17"/><persName>Gallię</persName> regem.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l922">Friburgi</placeName> et in pagis <placeName ref="l2774">Brisgoicis</placeName> collig[un]tur<note type="margin">a.R.: colligitur!</note> milites, <lb xml:id="p1z18"/>cui datur 5 batz.</s>
					<s n="11" xml:lang="la">usque ad <placeName>Donnenberg</placeName>, quo <placeName ref="l2510">Turcicis</placeName> inc<lb xml:id="p1z19"/>ursionibus resistant.</s>
					<s n="12" xml:lang="la">Quid si alium in locum ducturus sit exercitum <lb xml:id="p1z20"/>illum <persName ref="p18538">Cęsar</persName>, quem colligit contra <placeName ref="l2510">Turcam</placeName>.</s>
					<s n="13" xml:lang="la">Astus illius novi.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z21"/>Comitia erunt in <placeName ref="l1273">Ensisheim</placeName>.</s>
					<s n="15" xml:lang="la">Vocati sunt omnes prelati, <lb xml:id="p1z22"/>nobiles cum civitatibus.</s>
					<s n="16" xml:lang="la">Rex petit militem et pecunias.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z23"/>Ducum...<note type="margin">a.R.: ministri?</note> debent adesse cum plena potestate.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z24"/><placeName ref="l691">Lotharingia</placeName> tota favet Caesari et <persName>Gallum</persName> ut hostem persequi <lb xml:id="p1z25"/>vult; idque conclusum est a nobilibus <placeName ref="l691">Lotharingicis</placeName> <persName ref="p18538">Cęsaris</persName> <lb xml:id="p1z26"/>instinctu.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z27"/>Si pluviosum cęlum non fuisset, remisissem tibi sessiones <lb xml:id="p1z28"/><placeName ref="l1107">Tridentinas</placeName>; sed brevi per civem quendam <placeName ref="l28">Basiliensem</placeName>, qui brevi <lb xml:id="p1z29"/>ad vos ascensurus est, remittam.</s>
					<s n="20" xml:lang="la">Oporinus noster summo in <lb xml:id="p1z30"/>discrimine est propter libellum <persName ref="p7688">Nauseę</persName>.</s>
					<s n="21" xml:lang="la">Pereat <persName ref="p7688">Nausea</persName> cum <lb xml:id="p1z31"/>suis libellis.</s>
					<s n="22" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><placeName ref="l28">Basileę</placeName> 28. februarii 1552.</s>
					<s n="24" xml:lang="la"><lb xml:id="p1z32"/>Raptim.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">T[uus] <persName ref="p1278">G[as<lb xml:id="p1z33"/>tius</persName>].</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p1z34"/><placeName>Brabantinus</placeName> miles collectus <lb xml:id="p1z35"/>est, quo autem iturus, adhuc ignoratur.</s>
					<s n="27" xml:lang="la"><lb xml:id="p1z36"/><placeName ref="l378">Lutetiam</placeName> proficiscitur absque <lb xml:id="p1z38"/>dubio, nisi rex obiiciat fortiorem <lb xml:id="p1z39"/>militem.</s>
					<s n="28" xml:lang="la">At <persName>Helevtios</persName> <lb xml:id="p1z40"/>vexabit.</s>
				</p>
				<p>
					<s n="29" xml:lang="la">Raptim sub noctem.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vigilantissimo <lb xml:id="p2z2"/>pastori d. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName> <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> ecclesiae, <lb xml:id="p2z5"/>suo in domino <lb xml:id="p2z6"/>perpetuo colendissi<lb xml:id="p2z7"/>mo.</s>
				</p>
				<p>
					<s n="31" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
