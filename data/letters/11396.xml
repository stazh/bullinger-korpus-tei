	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Iesus Christus<note xml:id="fna" type="footnote" n="a">in <hi>der Vorlage</hi> IC XC.</note>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Gratiam et pacem in Christo Ihesu, deo ac servatore nostro.</s>
					<s n="3" xml:lang="la">Licet iuxta externum <lb xml:id="p1z2"/>hominem tu mihi et ego tibi, <persName ref="p495">Bullingere</persName> integerrime, ignotus sim, tamen <lb xml:id="p1z3"/>iuxta internam conversationem verę vitę et purę doctrinę mihi iam admodum <lb xml:id="p1z4"/>familiariter a multis annis notus es<note xml:id="fnb" type="footnote" n="b"><hi>Vom Schreiber korrigiert aus</hi> essem[?].</note>.</s>
					<s n="4" xml:lang="la">Utor enim tua opera tuoque ministerio <lb xml:id="p1z5"/>in enarrandis plerumque sacris literis.</s>
					<s n="5" xml:lang="la">Audio crebro te magistrum <lb xml:id="p1z6"/>mihi per libros loquentem, et in te Christum ipsum audio.</s>
					<s n="6" xml:lang="la">Ea vis est <lb xml:id="p1z7"/>purę doctrinę, quę ex fonte veritatis, quę Christus est, scaturit, <lb xml:id="p1z8"/>ut etiam ignotissimos et magnis locorum spatiis dissitos, arctissimis <lb xml:id="p1z9"/>christianę charitatis vinculis copulet et quodam modo uniat.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Hęc <lb xml:id="p1z10"/>cum ita se habeant, scio te in optimam partem interpretaturum, quod <lb xml:id="p1z11"/>sanctis tuis laboribus tantisper obstrepam, dum harum literarum exhibitorem<note xml:id="fn1" type="footnote" n="1">Unbekannt.</note> <lb xml:id="p1z12"/>tibi commendem.</s>
					<s n="8" xml:lang="la">Est, ut paucis dicam, natione <placeName ref="l830">Britannus</placeName>, verę religionis <lb xml:id="p1z13"/>studiosissimus, peregrinatur autem non ad ostentationem inanem, sed ut discat <lb xml:id="p1z14"/>ea, quae postea apud suos doceat.</s>
					<s n="9" xml:lang="la">Cupit enim esse vas utile in domo domin<lb xml:id="p1z15"/>i<note xml:id="fn2" type="footnote" n="2">Vgl. <cit type="bible"><ref>2Tim 2, 20f</ref></cit>.</note>.</s>
					<s n="10" xml:lang="la">Tres praecipuas linguas degustavit satis foeliciter.</s>
					<s n="11" xml:lang="la">Audivit autem <lb xml:id="p1z16"/>apud vos vigere sacrarum literarum studium, servata certa praecipuarum linguarum <lb xml:id="p1z17"/>enarratione.</s>
					<s n="12" xml:lang="la">Quare aliquot mensibus isthic morari cupit, ut <lb xml:id="p1z18"/>discat, quae in se desiderat.</s>
					<s n="13" xml:lang="la">Hinc oro dilectionem tuam, ut eum benigne, <lb xml:id="p1z19"/>ut soles huiusmodi bonos viros, excipias, et ne cuiquam gravis sit, impetr<lb xml:id="p1z20"/>es ei aliquam conditionem docendi privatim ditiorum aliquot vestrę urbis <lb xml:id="p1z21"/>civium liberos.</s>
					<s n="14" xml:lang="la">Cętera ex ipso audies.</s>
					<s n="15" xml:lang="la">Versatus est hic aliquandiu <lb xml:id="p1z22"/>honeste ac frugaliter.</s>
					<s n="16" xml:lang="la">Quicquid ergo huic beneficiorum impenderis, ipsi <lb xml:id="p1z23"/>Ihesu Christo te impendisse non ignoras.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Si ego vicissim tibi tuisve <lb xml:id="p1z24"/>quapiam in re servire potero, en offero me tibi servum ac fratrem <lb xml:id="p1z25"/>in Christo obsequentissimum.</s>
					<s n="18" xml:lang="la">Commendabis me sanctis<pb type="edition" next="45"/> orationibus symmistarum <lb xml:id="p1z26"/>et fratrum tuorum, nominatim d. <persName ref="p8127">Pellicani</persName>, <persName ref="p1753">Leonis Iudę</persName>, <persName ref="p8171">Bibliandri</persName>, <persName ref="p8412">Me<lb xml:id="p1z27"/>gandri</persName> etc.</s>
					<s n="19" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Datę <placeName ref="l311">Marburgi</placeName>, 29. ianuarii 1540.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z28"/>Toto pectore<note xml:id="fn3" type="footnote" n="3"><bibl source="b56">Adagia</bibl>, 1, 4, 26 (<bibl source="b370">LB</bibl> II 160f).</note> tibi addictissimus <lb xml:id="p1z29"/><persName ref="p8363">Gerardus Geldenhaurius Noviomagus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietate eruditioneque praestantissimo <lb xml:id="p2z2"/>viro, d. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> ecclesię doctori ac <lb xml:id="p2z4"/>pastori vigilantissimo, domino et <lb xml:id="p2z5"/>praeceptori unice observando.</s>
					<s n="23" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zurych</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
