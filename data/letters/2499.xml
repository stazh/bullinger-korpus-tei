	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Binas ab humanitate tua recepi literas, vir clarissime, <lb xml:id="p1z2"/>quas <placeName ref="l294">Locarnensibus</placeName> per proprium nuncium mittendas <lb xml:id="p1z3"/>curavi; ego enim inprimis gratias ago omnipotenti deo <lb xml:id="p1z4"/>pro tua erga miseros Christicolas benevolentia, animi <lb xml:id="p1z5"/>promptitudine ac in illorum caussa diligentia et solicitudine.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z6"/>Reddat tibi deus coronam iusticię, quemadmodum <lb xml:id="p1z7"/>et strenum militem ac in negocio Christi diligentem te <lb xml:id="p1z8"/>constituit.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Rogo igitur humanitatem tuam ac magni[fi]cos <lb xml:id="p1z9"/>dominos meos <placeName ref="l587">Tigurinos</placeName>, ne moleste ferant, etiamsi res <lb xml:id="p1z10"/>non successit ex sententia; sat enim est, quod pro <lb xml:id="p1z11"/>viribus certarunt, quo evangelium Christi promoveretur.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z12"/>Domini nunc est eventum concedere.</s>
					<s n="5" xml:lang="la">Quemadmodum <lb xml:id="p1z13"/>nescimus, quid petamus, ita minus, quid faciendum sit.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Desinant, supplices oramus, crabrones irritare,<note xml:id="fn1" type="footnote" n="1"><bibl source="b56">Adagia</bibl>, ***.</note> ne forte <lb xml:id="p1z15"/>apud gentem male audiat verbum dei.</s>
					<s n="7" xml:lang="la">Sat est impietatibus <lb xml:id="p1z16"/>non consensisse; dei enim est impios impietatesque punire.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Ne dubitent, dominus nobis in tempore aderit; ipse solus <lb xml:id="p1z18"/>novit suos a tentationibus eripere facietque una cum <lb xml:id="p1z19"/>tentatione eventum.</s>
					<s n="9" xml:lang="la">Clementiam enim dominorum nostrorum <lb xml:id="p1z20"/>rogamus proclivi sanctorum necessitatibus velle succurrere, <lb xml:id="p1z21"/>si opus fuerit, in praesens ut aliquot sedes apud vos aut <lb xml:id="p1z22"/><placeName ref="l41">Bernates</placeName> habere queant, ne incerti sedibus errare <lb xml:id="p1z23"/>cogantur.</s>
					<s n="10" xml:lang="la">Negocium autem hoc per proprium <placeName ref="l294">Locarnensium</placeName> <lb xml:id="p1z24"/>nuncium alias coram senatu vestro explicabitur.</s>
					<s n="11" xml:lang="la">Tę tunc <lb xml:id="p1z25"/>erit humanitatis, sicuti ad hunc usque diem illis presto fuisti, <lb xml:id="p1z26"/>ita ad finem quoque illos benevolentia tua comitari.</s>
					<s n="12" xml:lang="la" ana="farewell">Val<lb xml:id="p1z27"/>e.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z28"/><placeName ref="l93">Clavenę</placeName> 14. 10bris 1554.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z29"/>T[uae] h[umanitatis] deditis<pb/><lb xml:id="p2z1"/>s<lb xml:id="p2z2"/>imum manci<lb xml:id="p2z3"/>pium <persName ref="p8168">Antonius <lb xml:id="p2z4"/>Marius <lb xml:id="p2z5"/>Besutiu<pb/><lb xml:id="p3z1"/>s</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p4z1"/>Pietate, doctrina ac moribus <lb xml:id="p4z2"/>clarissimo viro domino <persName ref="p495">Henrico <lb xml:id="p4z3"/>Bulingero</persName>, <placeName ref="l587">Tigurinorum</placeName> <lb xml:id="p4z4"/>antistiti, domino meo <lb xml:id="p4z5"/>colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
