	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">De concionibus in Apocalypsim sancti Ioannis <lb xml:id="p1z2"/>editis et mihi earum exemplari donato <lb xml:id="p1z3"/>gratias non exiguas tibi ago.</s>
					<s n="3" xml:lang="la">Ego vicissim, ut <lb xml:id="p1z4"/>aliquam erga tuum beneficium grati animi sig<lb xml:id="p1z5"/>nificationem ostendam, meos in sacram historiam <lb xml:id="p1z6"/>Commentarios tibi mitto.</s>
					<s n="4" xml:lang="la">Qui si tibi probabuntur, <lb xml:id="p1z7"/>longe id gratissimum mihi erit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Fieri potest, <lb xml:id="p1z8"/>ut in explicatione numerorum, quos Apocal<lb xml:id="p1z9"/>ypsis ponit, inter nos non conveniat; sed ea dissen<lb xml:id="p1z10"/>sio tanti non erit, ut inter nos amicitiam, quę <lb xml:id="p1z11"/>in Christo coaluit, dissuat.</s>
					<s n="6" xml:lang="la">Caeterum in locum c<lb xml:id="p1z12"/>ommunem de sacramentis digredior, de cuius expositi<lb xml:id="p1z13"/>one quid tu iudices, in tempore cupio certior <lb xml:id="p1z14"/>fieri.</s>
					<s n="7" xml:lang="la" ana="farewell">Tu vale in domino bene cum d. <persName ref="p8171">Bibliandro</persName>, <lb xml:id="p1z15"/>d. <persName ref="p8111">Petro Martyre</persName> d. <persName ref="p8011">Gvalthero</persName>, <persName ref="p2336">Occhino</persName> <lb xml:id="p1z16"/>et aliis ecclesiae vestrę pastoribus et ministris.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/><placeName ref="l28">Basileę</placeName> 57. calendis septembribus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p8298">Martinus Borrhaus</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vigilanti <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z2"/>pastori d. <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bullingero</persName>, amico <lb xml:id="p2z4"/>et fratri in domino obser<lb xml:id="p2z5"/>vando.</s>
				</p>
			</div>
		</body>
	</text>
