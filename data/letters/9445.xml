	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Salvus cum uxore ex [Alv.<lb xml:id="p1z2"/>.] novis redii, reverendi<lb xml:id="p1z3"/>ssime d. pater.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Ago gratias, qui [no]s tuis eo usque etiam tam <lb xml:id="p1z5"/>paterne sis prosequutus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Acta novissimi iudicii libenter <lb xml:id="p1z6"/>misissem, nisi una impeditus essem causa.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Submitto, <lb xml:id="p1z7"/>quae d. <persName ref="p8089">Lentulus</persName> misit.</s>
					<s n="6" xml:lang="la">Proxime mittam descriptionem <lb xml:id="p1z8"/>miraculi Sculliani.</s>
					<s n="7" xml:lang="la">Caetera bene admodum se habent <lb xml:id="p1z9"/>et nisi oligarchę quidam novi aliquid denuo moliantur, <lb xml:id="p1z10"/>speranda et optanda tandem esset pax firma et quies.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/>Proxime plura; tantum hec volui, ut reduces nos salvos <lb xml:id="p1z12"/>esse scires.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale, pater reverendissime; dominus te quam diutissime <lb xml:id="p1z13"/>conservet incolumem nobis omnibus.</s>
					<s n="10" xml:lang="la">Legatus nuper <lb xml:id="p1z14"/>in <placeName ref="l638">Ingaddinam</placeName> abiit; reversus per suum interpretem <lb xml:id="p1z15"/>ad prandium me vocavit, sed causas habui <lb xml:id="p1z16"/>multas, quae me deterruerunt.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Salutant praestantiam tuam <lb xml:id="p1z17"/>d. consul[es]<note type="margin">a.R.: coss.</note>, d. <persName ref="p6130">Pontisella</persName>, d. <persName ref="p8057">Campellus</persName> etc.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Ocyssime 1573. <lb xml:id="p1z18"/>8. septembris <placeName ref="l98">Curię</placeName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z19"/>Tuae amplitudinis subiecti<lb xml:id="p1z20"/>ssimus <persName ref="p8016">Th[ob<lb xml:id="p1z21"/>ias] Ic[oni<pb/><lb xml:id="p2z1"/>us]</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Amplissimo viro d. d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> ecclesię antistiti <lb xml:id="p2z4"/>primario, d. <lb xml:id="p2z6"/>suo colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
