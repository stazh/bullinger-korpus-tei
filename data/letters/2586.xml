	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la">Cum commodum haberem nuntium nolui te <lb xml:id="p1z2"/>ignorare, pater charissime, hodie matrem meam ex hac <lb xml:id="p1z3"/>vita ad aeternam illam transmigrasse atque (quod me <lb xml:id="p1z4"/>potissimum consolatur) in fide vera atque ardenti invocatione <lb xml:id="p1z5"/>Iesu Christi.</s>
					<s n="3" xml:lang="la">Itaque omnes nos deo optimo maximo gratias agimus, <lb xml:id="p1z6"/>qui illam gravi hoc morbo tandem liberare dignatus est.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Ego postridie aut ad summum tertio die domum rediturus <lb xml:id="p1z8"/>sum; manebo enim ad biduum cum patre propter disponendas <lb xml:id="p1z9"/>res domesticas.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Adiunxi his meis literis epistolam <lb xml:id="p1z10"/>ad affinem meum Liberianum, quam rogo ancillę meę des <lb xml:id="p1z11"/>perferendum fratri illius, quo istam quam primum per <lb xml:id="p1z12"/>suum Liberiano transmittat.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
					<s n="7" xml:lang="la" ana="salute">Salutat <lb xml:id="p1z13"/>vos omnes pater, uxor sororque mea.</s>
					<s n="8" xml:lang="la" ana="salute">Saluta meo nomine <lb xml:id="p1z14"/>omnem familiam.</s>
					<s n="9" xml:lang="la" ana="farewell">Iterum vale.</s>
					<s n="10" xml:lang="la">12. martii 1555.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">T[i<lb xml:id="p1z15"/>bi] d[editus] <persName ref="p8442">Iosias Simlerus</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vigilantissimo <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z2"/>ecclesię pastori d. <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bullingero</persName>, patri suo venerando.</s>
				</p>
				<p>
					<s n="13" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
