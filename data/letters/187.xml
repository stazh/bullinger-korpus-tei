	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Dolorem excute, mi frater, me tantum insumpsisse <lb xml:id="p1z2"/>sumptuum, eo quod tabellionem ad tuam misi humanitatem; <lb xml:id="p1z3"/>versuram enim feci, cuius me nunquam pęnitebit.</s>
					<s n="2" xml:lang="la">Diomedis <lb xml:id="p1z4"/>certe et <persName ref="p18844">Glauci</persName> mutatio fuit, quicquid exposui.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Argentum dedi, non aurum neque aes <placeName>Corinthium</placeName>, sed <lb xml:id="p1z6"/>divina, quae nunquam pensare possum, accepi, nempe <lb xml:id="p1z7"/>commentarios in Marcum, Lucam, Acta apostolorum et <lb xml:id="p1z8"/>Seriem temporum cum 4 libris Adversus catabaptistas.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Nunc aureum per <persName>Ioannem Scholasticum</persName> calceatorem <lb xml:id="p1z10"/><placeName ref="l587">Tigurinum</placeName>, qui in amaro fonte lavit, tibi remitto, <lb xml:id="p1z11"/>ut <persName ref="p4851">Froscho</persName> - vero satisfacere possis; quod supererit, tuae <lb xml:id="p1z12"/>uxori meo nomine loco mnemosyni dabis.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quatuor <lb xml:id="p1z13"/>calendarii Decem in margine tenentes praecepta <lb xml:id="p1z14"/>sive verba, quibus implicuit libros, perplacent.</s>
					<s n="6" xml:lang="la">Nos <lb xml:id="p1z15"/>brevitatis caussa olim ea utcunque comprehendimus <lb xml:id="p1z16"/>hoc disticho: <lb xml:id="p1z17"/>Unum, simulachrum, iuravit, sabbato sancto, <lb xml:id="p1z18"/>Ah pater, occisor, moechus, fur, testis, et optat.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z19"/>Te sursum ac deorsum nostri caussa cursitasse, gratiam <lb xml:id="p1z20"/>habeo, relaturus etiam, ubicunque sese occasio <lb xml:id="p1z21"/>obtulerit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Quis ad te argumenta vel <lb xml:id="p1z22"/>sophismata potius miserit, divinare non <lb xml:id="p1z23"/>possum.</s>
					<s n="9" xml:lang="la">In re politica ac ecclesiastica eque <lb xml:id="p1z24"/>instantes video clamatores nostros, <pb/><lb xml:id="p2z1"/>declamatores nominare hos Protheos <lb xml:id="p2z2"/>atque Euripos minime decet.</s>
					<s n="10" xml:lang="la">Nunc de <lb xml:id="p2z3"/>libris abscondendis, non emendis solliciti <lb xml:id="p2z4"/>sumus; adeo omnia apud nos versantur in trivio.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z5"/>Octava die iulii fama ad nos venit <lb xml:id="p2z6"/>comitem de <placeName>Beirren</placeName> (sub cuius potestate <lb xml:id="p2z7"/>ante biennium 30000 pedites erant) brevi <lb xml:id="p2z8"/>adducturum multos equites, qui aliquamdiu <lb xml:id="p2z9"/>sese apud nos vasa inexplebilia strenuosque <lb xml:id="p2z10"/>potatores et episcythizantes ostenderunt.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z11"/>Quid caput sine lingua ranaque <placeName>Seriphia</placeName> <lb xml:id="p2z12"/>coaxet sive, ut cum <persName>Aristophane</persName> loquar, frexet <lb xml:id="p2z13"/>cardignostis novit.</s>
					<s n="13" xml:lang="la">Nuper quadringenti cives <lb xml:id="p2z14"/>Wirtenbergenses Moraviam Austriamque petiere; <lb xml:id="p2z15"/>multi his diebus sequentur eos, nisi copiam <lb xml:id="p2z16"/>mutandi locum Stuͦtgardiae impetrare non <lb xml:id="p2z17"/>possint.</s>
					<s n="14" xml:lang="la">Lerna et <persName>Camarina</persName> malorum, <lb xml:id="p2z18"/>imo onus <placeName ref="l2131">Babylonis</placeName> in civitatibus hinc<lb xml:id="p2z19"/>inde adeo fervet ac sevit ob missam <lb xml:id="p2z20"/>non missam, ut ille non male mihi cecinisse <lb xml:id="p2z21"/>hoc versu videatur: <lb xml:id="p2z22"/>Cunctorum genitrix et nutrix missa malorum<pb/><lb xml:id="p3z1"/>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p3z2"/>Bene <persName ref="p18253">Nestor</persName> in comoedia dixit: "O stulte <lb xml:id="p3z3"/>popule, ut ad speciem semper es intentus <lb xml:id="p3z4"/>exteram", et <persName ref="p6927">Ludovicus Vives</persName> De veritate fidei <lb xml:id="p3z5"/>christiana lib. 2. cap. 13.: "Daemon vult <lb xml:id="p3z6"/>etiam recitari missam vel missas.<lb xml:id="p3z7"/>"</s>
					<s n="16" xml:lang="la"><persName ref="p4497">Domitius Calderinus</persName> ne missam quidem <lb xml:id="p3z8"/>volebat audire, et quum ab amicis eo <lb xml:id="p3z9"/>duceretur, dixisse fertur: "Eamus ad <lb xml:id="p3z10"/>communem errorem."</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Amplectenda igitur <lb xml:id="p3z11"/>nostris temporibus illa carmina: <lb xml:id="p3z12"/>Iam satis est, missam missam faciamus oportet, <lb xml:id="p3z13"/>Ut rem iam valeat nomen habere suam.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p3z14"/>Missa quidem toties, sed nondum est facta, vocatur; <lb xml:id="p3z15"/>Nil opus est dici, ni quoque fiat idem.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p3z16"/>De amuso et atheo Interim libro ad interitum <lb xml:id="p3z17"/>evangelii fictum libentius tacere volo quam <lb xml:id="p3z18"/>parum dicere.</s>
					<s n="20" xml:lang="la">Tedet meminisse flebile hoc <lb xml:id="p3z19"/>pondus, mundum inquam immundum a diabolo adeo <lb xml:id="p3z20"/>fascinatum, ut mendacio libentius quam veritati, <lb xml:id="p3z21"/>lucro potius quam pietati adhaereat.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="farewell">Vale <lb xml:id="p3z22"/>meque, ut facis, ama.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><placeName ref="l211">Heyningae</placeName> 10. die iulii <lb xml:id="p3z23"/>anno 1548.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p3z24"/><persName ref="p8">Ioachim Aberlin</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p4z1"/>Docto ac pio <persName ref="p495">Heinricho <lb xml:id="p4z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinorum</placeName> <lb xml:id="p4z3"/>episcopo S.</s>
				</p>
