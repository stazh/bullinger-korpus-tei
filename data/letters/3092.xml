	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Postremas tuas per m. <persName>Fierzium</persName> missas accepi, <lb xml:id="p1z2"/>ad quas non est ut nunc multis respondeam; nondum <lb xml:id="p1z3"/>enim plene omnes tua in Apocalypsin commentaria perlegerunt.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Urgeo eos vehementer et spero intra paucos dies <lb xml:id="p1z5"/>omnes lectionem absoluturos.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Praefatio Germanica lecta <lb xml:id="p1z6"/>est a dominis scholarchis <persName ref="p8012">quęstore Hallero</persName> et <persName ref="p5787">Claudio <lb xml:id="p1z7"/>a Madiis</persName>.</s>
					<s n="5" xml:lang="la">Si quid decretum ab illis fuerit in hac re, <lb xml:id="p1z8"/>mature significabo et Germanicam quoque praefationem <lb xml:id="p1z9"/>restituam, ubi ea satis usi fuerimus.</s>
					<s n="6" xml:lang="la">Consulum nomina <lb xml:id="p1z10"/>ita, ut iussisti, delebo; videbo etiam, quomodo inseri possit <lb xml:id="p1z11"/>hoc, quod ex <placeName ref="l832">Galli</placeName> illius scripto de nomine aut <lb xml:id="p1z12"/>numero bestię excerpisti.</s>
					<s n="7" xml:lang="la">Si concessum fuerit Apiario, <lb xml:id="p1z13"/>ut imprimat, excudet unum atque alterum folium <lb xml:id="p1z14"/>et secum afferet, ut formam literarum probare possitis.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Ego vel <persName ref="p8417">Musculus</persName> praestabimus operam in corrigendo.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/><placeName ref="l167">Genevenses</placeName> (uti huius rei mihi authores sunt <lb xml:id="p1z17"/>consul <persName ref="p2305">Nägelinus</persName> et quaestor <persName>Dilgerus</persName>) in die nativitatis <lb xml:id="p1z18"/>dominicae quendam maleficum virgis per forum <lb xml:id="p1z19"/>ceciderunt.</s>
					<s n="10" xml:lang="la">Ex quo facto tam exacerbati sunt de novo <lb xml:id="p1z20"/>nostrorum animi, ut nihil supra.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Apparet enim illos sua <lb xml:id="p1z21"/>quam iactant christiana libertate non secundum dilectionem <lb xml:id="p1z22"/>et ad aedificationem, sed prorsus ad contemptum aliorum et <lb xml:id="p1z23"/>destructionem multorum uti.</s>
					<s n="12" xml:lang="la">Incredibile enim est, quantum <lb xml:id="p1z24"/>ex eiusmodi factis abalienentur eorum animi, qui in <placeName ref="l832">Gallia</placeName> <lb xml:id="p1z25"/>et alibi adhuc in superstitione papistica haerent.</s>
					<s n="13" xml:lang="la">Aiunt <lb xml:id="p1z26"/>etiam ministrum (cuius tamen nomen nescio, <persName ref="p540">Calvinus</persName> ne <lb xml:id="p1z27"/>fuerit, an alius quispiam) qui eo die concionatus sit, <lb xml:id="p1z28"/>cum vidisset frequentiorem convenisse ecclesiam, <lb xml:id="p1z29"/>quam aliis diebus profestis consuetum erat, debachatum <lb xml:id="p1z30"/>esse mirum in modum, quod cerneret ex ipsorum frequentia, <lb xml:id="p1z31"/>superstitionem et observationem diei huius adhuc illorum animis <lb xml:id="p1z32"/>inhaerere.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Quid haec tandem paritura sint, novit <lb xml:id="p1z33"/>dominus.</s>
					<s n="15" xml:lang="la">Nemo reprehendit libertatem christianam in e[iusmodi] <lb xml:id="p1z34"/>rebus, sed quod illa non videntur uti secundum [regulam] <lb xml:id="p1z35"/>apostolicam.</s>
					<s n="16" xml:lang="la">Hoc disiungit ab illis etiam illorum animos [qui] <lb xml:id="p1z36"/>hactenus visi fuerunt illis quam plurimum favere.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z37"/>Construxere item navigii genus maritimum, quod <persName>Galeo<lb xml:id="p1z38"/>nem</persName> vocant, quo in lacu Lemano utantur.</s>
					<s n="18" xml:lang="la">Cuius usus <lb xml:id="p1z39"/>non poterit esse nisi contra nos, cum tota fere lacui <lb xml:id="p1z40"/>ab utraque parte adiacens regio <placeName ref="l41">Bernensis</placeName> sit ditionis.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z41"/>Accedunt et alia, quae me valde affligunt, quod metuam, <lb xml:id="p1z42"/>ne illa simultas tandem erumpat in maius aliquod <lb xml:id="p1z43"/>malum, quod deus sua clementia avertat.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z44"/>Amen.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="farewell">Vale.</s>
					<s n="22" xml:lang="la" ana="salute">Salutant te tuosque mater et uxor <lb xml:id="p1z45"/>mea, fratres item omnes, <persName ref="p8417">Musculus</persName> ipse scribit.</s>
					<s n="23" xml:lang="la"><lb xml:id="p1z46"/>Salvi sint, qui apud vos sunt, domini et fratres omens, d. <lb xml:id="p1z47"/><persName ref="p8111">Martyr</persName>, <persName ref="p8011">Gualtherus</persName>, <persName ref="p8171">Theodorus</persName> etc.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><placeName ref="l41">Bernae</placeName> 8. ianuarii <lb xml:id="p1z48"/>1557.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><persName ref="p8018">I[<lb xml:id="p1z49"/>oannes] H[allerus</persName>] tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino suo et <lb xml:id="p2z4"/>compatri charissimo et <lb xml:id="p2z5"/>colendissimo.</s>
				</p>
