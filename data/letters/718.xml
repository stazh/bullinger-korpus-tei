	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Interea, quo <persName ref="p8127">Pellicano</persName> ad te literas <lb xml:id="p1z2"/>dedi, compater in domino charissime, loquutus <lb xml:id="p1z3"/>sum <persName ref="p8012">quaestori Hallero</persName> de retinendo <lb xml:id="p1z4"/>hic compatre meo <persName ref="p8018">Ioanne Hallero</persName>.</s>
					<s n="3" xml:lang="la">Is <lb xml:id="p1z5"/>respondit expectare dominos, donec ipse <persName ref="p8018">Hal<lb xml:id="p1z6"/>lerus</persName> mentem suam hac in re declaret: <lb xml:id="p1z7"/>Postea et ipsum quoque compatrem meum con<lb xml:id="p1z8"/>veni percontatusque sum, num causam <lb xml:id="p1z9"/>suam isthic <placeName ref="l587">Tiguri</placeName> coram transegisset.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>Respondit paucis: "Cur hoc facerem, cum nemo <lb xml:id="p1z11"/>sit, qui urgeat?"</s>
					<s n="5" xml:lang="la">Subieci non posse ipsum <lb xml:id="p1z12"/>ecclesiam hanc relinquere bona cum conscientia.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Regessit: "Sicut semper dixi, ita nunc quoque <lb xml:id="p1z14"/>dico.</s>
					<s n="7" xml:lang="la">Causam hanc commendo dominis meis <lb xml:id="p1z15"/><placeName ref="l587">Tigurinis</placeName>, qui me huc miserunt.</s>
					<s n="8" xml:lang="la">Illis <lb xml:id="p1z16"/>obtemperabo, modo <placeName ref="l41">Bernates</placeName> faciant, <lb xml:id="p1z17"/>quod aequum est et necessitatibus meis <lb xml:id="p1z18"/>non incommodum."</s>
					<s n="9" xml:lang="la">Iam pro tua prudentia <lb xml:id="p1z19"/>causam hanc apud vestros isthic tandem <lb xml:id="p1z20"/>ad finem perducas, necesse est.</s>
					<s n="10" xml:lang="la">Adiecit <lb xml:id="p1z21"/>etiam quaestor accepisse se literas abs te, <lb xml:id="p1z22"/>quibus horteris, ut necessitatibus meis <lb xml:id="p1z23"/>paulo liberalius consulatur, idque se pro <lb xml:id="p1z24"/>viribus curaturum.</s>
					<s n="11" xml:lang="la">Pro qua tua sollicitu<lb xml:id="p1z25"/>dine tibi maximas habeo gratias.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z26"/>Caeterum mitto hic ecclesiasticas historias, <lb xml:id="p1z27"/>ut, quae hactenus truncatim legisti, <lb xml:id="p1z28"/>posthac continua ac plena serie legere <lb xml:id="p1z29"/>possis.</s>
					<s n="13" xml:lang="la">Dominus te cum tuis omnibus per gratiam <lb xml:id="p1z30"/>suam conservet, compater charissime.</s>
					<s n="14" xml:lang="la" ana="salute">Salutant <lb xml:id="p1z31"/>mei tuos omnes.</s>
					<s n="15" xml:lang="la" ana="salute">Saluta dominos ac <lb xml:id="p1z32"/>fratres, D. <persName ref="p8171">Bibliandrum</persName>, <persName ref="p8011">Gualterum</persName>, <persName ref="p8127">Pellicanum</persName>, <lb xml:id="p1z33"/><persName ref="p8440">Gervasium</persName> nostrum iam trigamum et papistico <lb xml:id="p1z34"/>sacerdotio duplici nomine ineptum.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z35"/><placeName ref="l41">Bernę</placeName> 21. octobris 1549.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z36"/><persName ref="p8417">W[olfgangus] Musculus</persName>, tuus in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo M. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z5"/>antistiti fide<lb xml:id="p2z6"/>lissimo, com<lb xml:id="p2z7"/>patri suo in <lb xml:id="p2z8"/>domino charissimo.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z9"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
