	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Cętera cum d. <persName>Valentino</persName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="de">Siderhar entpütet mir <persName>Gorgius Carly</persName> <lb xml:id="p1z2"/><foreign xml:lang="la">per proconsulem (nam ipse peregre abiit),</foreign> er wüsse eigentlich, <lb xml:id="p1z3"/>das bäpstischen [...] in <placeName ref="l176">Glariß</placeName> ir kleinod flöchnind, zuͦm <lb xml:id="p1z4"/>theil uff <placeName>Gräpelen</placeName>, zuͦm theil anderswohin.</s>
					<s n="4" xml:lang="la">Hoc tu nimirum <lb xml:id="p1z5"/>scis; sed si nescis, mone pios <placeName ref="l646">Glaronenses</placeName>, et vigilate; est signum <lb xml:id="p1z6"/>belli et praesagium.</s>
					<s n="5" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z7"/>T[uus] <persName ref="p8009">Fabricius</persName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/>domino <lb xml:id="p2z5"/>suo.</s>
				</p>
			</div>
		</body>
	</text>
