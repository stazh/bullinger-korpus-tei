	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><placeName ref="l21">Badenam</placeName> profecti sunt d. <persName ref="p3494">Nicolaus a Dies<lb xml:id="p1z2"/>bach</persName> et dominus <persName>Emanuel</persName>.</s>
					<s n="3" xml:lang="la"><persName ref="p3494">Diesbachius</persName> tibi <lb xml:id="p1z3"/>communicabit, quę erunt nova.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Gratę illi <lb xml:id="p1z4"/>admodum fuere tuę proximę; puto illas in se<lb xml:id="p1z5"/>natu quoque lectas esse.</s>
					<s n="5" xml:lang="la">Communicavit eas mihi <lb xml:id="p1z6"/>etiam.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Melduni nihil est actum, eo quod arbiter <lb xml:id="p1z7"/><persName>Svitensis</persName> non comparuit.</s>
					<s n="7" xml:lang="la"><placeName ref="l2448">Quinquepagicos</placeName> <lb xml:id="p1z8"/>audiveramus alteram legationem ad <lb xml:id="p1z9"/><placeName ref="l791">Valesianos</placeName> missuros, et nostri de eo <placeName ref="l791">Valesia<lb xml:id="p1z10"/>nos</placeName> praemonuerant; sed interea non audio, <lb xml:id="p1z11"/>quod quenquam miserint.</s>
					<s n="8" xml:lang="la">Ex <placeName ref="l21">Badena</placeName> forte co<lb xml:id="p1z12"/>gnoscemus aliquid.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Nescio adhuc, an nostri lega<lb xml:id="p1z13"/>tionem ad <placeName>Heremum</placeName> sint missuri necne.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/>Obscuri intellexi per affinem quendam, <lb xml:id="p1z15"/>qui <placeName ref="l300">Lucernae</placeName> senatorii ordinis est, <placeName ref="l2448">Quinque P[agos]</placeName> <lb xml:id="p1z16"/>cum <placeName ref="l2478">Sabaudię</placeName> principe confirmasse foedus; <lb xml:id="p1z17"/>quibus tamen conditionibus, nescio.</s>
					<s n="11" xml:lang="la">Ita miseri <lb xml:id="p1z18"/>nihil intermittunt, quod in odium nostri <lb xml:id="p1z19"/>fieri posse putant; sed spero deum aliquando hu<lb xml:id="p1z20"/>miliaturum ipsos.</s>
					<s n="12" xml:lang="la">Nostri octiduo post <persName>Martini</persName> <lb xml:id="p1z21"/><placeName ref="l339">Neocomi</placeName> cum duce <placeName ref="l2478">Sabaudię</placeName> agent.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Dominus faxit, ut prosper sit rerum eventus et omnia foe<lb xml:id="p1z23"/>liciter succedant!</s>
					<s n="14" xml:lang="la">Ex <placeName ref="l832">Gallia</placeName> multo nunc <lb xml:id="p1z24"/>tempore nihil certi cognovimus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z25"/>Quod <lb xml:id="p1z26"/>studiosos vestros attinet, quos revocastis <lb xml:id="p1z27"/>et qui has deferunt, <persName ref="p6544">Svitzerus</persName> videlicet et <persName>Abben<lb xml:id="p1z28"/>cellerus</persName>, bene se hic gesserunt, ut bonum <lb xml:id="p1z29"/>possimus illis pietatis, modestię et diligentię <lb xml:id="p1z30"/>praebere testimonium, et rogamus, ut sint <lb xml:id="p1z31"/>vobis commendati.</s>
					<s n="16" xml:lang="la">D. <persName ref="p8417">Musculi</persName> <persName>Locos</persName> te accepisse <lb xml:id="p1z32"/>spero.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Salutat is te; idem faciunt quę<lb xml:id="p1z33"/>stores, socer, <persName ref="p4060">Zehenderi</persName>, <persName ref="p4772">Fellenbergerus</persName>.</s>
					<s n="18" xml:lang="la" ana="salute"><lb xml:id="p1z34"/>Saluta domum tuam universam meo nomine.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute">M<lb xml:id="p1z35"/>ater mea salva et incolumis per domini gratiam ad <lb xml:id="p1z36"/>nos reversa est, quę et ipsa te tuosque omnes sa<lb xml:id="p1z37"/>lutat.</s>
					<s n="20" xml:lang="la"><placeName ref="l41">Bernae</placeName> 11. septembris 1560.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z38"/><persName ref="p8018">Ioannes Hallerus</persName> <lb xml:id="p1z39"/>tuus perpetuo.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> ecclesiae <lb xml:id="p2z3"/>antistiti fidelissimo, <lb xml:id="p2z4"/>domino suo honorando et <lb xml:id="p2z5"/>compatri dilectissimo.</s>
				</p>
			</div>
