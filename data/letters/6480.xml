	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Et <persName ref="p8033">Bezae</persName> libellum, quo tuam, imo ecclesiae causam agit, et acta col<lb xml:id="p1z2"/>loquii <placeName>Maulbrunnensis</placeName> perlegi et avide quidem.</s>
					<s n="3" xml:lang="la">Perplacet utrumque <lb xml:id="p1z3"/>scriptum; sed ut gloriae suae quam Christi cupidior studiosiorque vi<lb xml:id="p1z4"/>detur et <persName ref="p458">Brentius</persName> et <persName ref="p4183">Iacobus Andreae</persName>, non spero cessuros; esset enim turpe <lb xml:id="p1z5"/>viris tantis aliquid videri nescisse et a <persName ref="p4091">Zvinglianis</persName> didicisse.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Sed haec <lb xml:id="p1z6"/>alias.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Nunc illud te rogatu boni cuiusdam viri rogo, ut tuorum aliquis <lb xml:id="p1z7"/>(neque enim tibi imponere hoc oneris ausim) certiorem me faciat, num <lb xml:id="p1z8"/>quae in republica vestra et urbe aedes sint, in quibus annumerata pecunia <lb xml:id="p1z9"/>certa alantur, qui senio confecti aut alias quasvis ob causas rem do<lb xml:id="p1z10"/>mesticam instituere ipsi domi nolunt aut non possunt, <foreign xml:lang="el">ταρονοτρ<lb xml:id="p1z11"/>οφεῖον</foreign> puto recte dixerimus, ain pfraindhaus.</s>
					<s n="6" xml:lang="la">Item, pateatne ea domus <lb xml:id="p1z12"/>omnibus et quanta pecunia sit ei, qui recipi velit (est autem quin<lb xml:id="p1z13"/>quagenarius et ipse et uxor) opus, denique quae sit tractatio, et si quid <lb xml:id="p1z14"/>aliud huius generis.</s>
					<s n="7" xml:lang="la">Neminem habeo alium, cui demandem, et spero ali<lb xml:id="p1z15"/>quem ex generis tuis hoc laboris mea causa non gravate suscepturum.</s>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z16"/>D. <persName ref="p8011">Gvalthero</persName> meis verbis salutem dicas, cui diligentius, quam occupationes <lb xml:id="p1z17"/>meae nunc ferant, scribendum est; miso enim dono mihi suas in <lb xml:id="p1z18"/><persName>Iohannem</persName> homilias.</s>
					<s n="9" xml:lang="la">Haec pauca scribere festinanter visum est, cum <lb xml:id="p1z19"/>essent domini a <persName ref="p3740">Stetten</persName> literae mittenda tibi.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale optime, humanissime <lb xml:id="p1z20"/>mi d. <persName ref="p495">Bullingere</persName>, et me amare perge.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l18">Augustae</placeName> 26. maii <lb xml:id="p1z21"/>anno 1565.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/><persName ref="p2899">Matthias Schenckius</persName>, <lb xml:id="p1z23"/>t[otus] t[uus].</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro pio tum erudito <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bul<lb xml:id="p2z3"/>lingero</persName> <placeName ref="l587">Tigurino</placeName>, domino <lb xml:id="p2z4"/>atque amico observand<lb xml:id="p2z5"/>o.</s>
				</p>
			</div>
		</body>
	</text>
