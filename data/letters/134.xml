	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non dubito, mi venerande <persName ref="p495">Bullingere</persName>, quin proximas meas literas acceperis.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Scire autem vehementer aveo, quid istic in suo negocio promoverit <persName ref="p7242">Claudius ille <lb xml:id="p1z3"/>Sabaudus</persName> anque illi mutuo dederis aliquantam pecuniam, id quod te per literas <lb xml:id="p1z4"/>ab ipso tibi redditas rogaveram; nam si dedisti, rursus ab hoc <persName ref="p506">Butlero</persName> nostro, <lb xml:id="p1z5"/>vere angelico <placeName ref="l830">Anglo</placeName>, accipies.</s>
					<s n="4" xml:lang="la">Is etiam de nostris rebus, quo loco sint, coram <lb xml:id="p1z6"/>reddet certiorem.</s>
					<s n="5" xml:lang="la">Commendarem illum tibi, ni scirem iam dudum fuisse ob <lb xml:id="p1z7"/>egregias doteis suas commendatissimum.</s>
					<s n="6" xml:lang="la">Expectamus in horas nunc, <lb xml:id="p1z8"/>quid legati nostri per tabellarium et unum ex famulis, qui equos reducet, <lb xml:id="p1z9"/>scribant.</s>
					<s n="7" xml:lang="la">Tu, quod facis, scio, domino pro nostrae urbis salute vota facere nunquam <lb xml:id="p1z10"/>cesses, obsecro.</s>
					<s n="8" xml:lang="la">Ego a proximis literis ne unam quidem literam ex <placeName ref="l18">Augusta</placeName> <lb xml:id="p1z11"/>accepi.</s>
					<s n="9" xml:lang="la" ana="farewell">Bene vale, cor meum et anima mea, in domino.</s>
					<s n="10" xml:lang="de">26. Maii 1548.</s>
					<s n="11" xml:lang="la" ana="salute"><lb xml:id="p1z12"/>Salveant tui omnes in Christo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z13"/>Tuus <persName ref="p8055">Amb[rosius] Bl[aurerus</persName>].</s>
				</p>
				<p>
					<s n="13" xml:lang="de"><lb xml:id="p1z14"/>Man sagt glouplich, <persName ref="p9708">hertzog Ulrich</persName> muͤsß des regiments abtretten, <lb xml:id="p1z15"/>und seyen im ettlich vogteyen ingeben, namlich <placeName ref="l512">Tubingen</placeName>, <placeName ref="l1234">Herrenberg</placeName>, <lb xml:id="p1z16"/><placeName ref="l26">Balingen</placeName>, <placeName ref="l1333">Duttlingen</placeName> etc.</s>
				</p>
				<p>
					<s n="14" xml:lang="de">Sonst solle der jung herr an das regiment stohn; <lb xml:id="p1z17"/>der solle ouch dem romischen könig auff bestympt zyl zwaymal<lb xml:id="p1z18"/>hunderttausend gulde erlegen.</s>
					<s n="15" xml:lang="de">ouch soll die alt fuͤrstin <placeName ref="l514">Urach</placeName> innhaben.</s>
					<s n="16" xml:lang="de" ana="salute"><lb xml:id="p1z19"/>Aber ich warten all stund meines lieben schwagers <persName ref="p8500">Peter Schären</persName> des jungen, <lb xml:id="p1z20"/>der euch allweg gantz fruntlich bevilcht von seinen wegen ze gruͤssen; <lb xml:id="p1z21"/>der wirt wol allen bschaid sagen konnen; allsdann schrib ich weyter.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>amico et fratri incomparabili.</s>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
