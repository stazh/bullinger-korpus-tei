	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Causam, propter quam ad vos veniunt <persName ref="p540">Calvinus</persName> et <persName ref="p1049">Farellus</persName>, <lb xml:id="p1z2"/>intelliges ex ipsis, tum quoque quid hic egerint et impetraverint.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Mihi propter magna negotia scribere multa nunc <lb xml:id="p1z4"/>non licet.</s>
					<s n="4" xml:lang="la"><placeName ref="l303">Magdeburgensis</placeName> contributio dilata est in conventum 4 <lb xml:id="p1z5"/>Civitatum; sed quando ille fiet?</s>
					<s n="5" xml:lang="la">Nundinę <placeName ref="l157">Franckfordianę</placeName> ap<lb xml:id="p1z6"/>propinquant; opere precium esset prius constitui aliquid.</s>
					<s n="6" xml:lang="la">De <placeName ref="l832">Gallo</placeName> <lb xml:id="p1z7"/>ferunt hic, quod magnum in <placeName ref="l822">Germaniam</placeName> exercitum per <placeName ref="l691">Lotho<lb xml:id="p1z8"/>ringiam</placeName> sit ducturus; <placeName ref="l825">Danos</placeName> et <placeName ref="l749">Saxones</placeName> quoque ascensuros in <placeName ref="l822">Ger<lb xml:id="p1z9"/>maniam</placeName>.</s>
					<s n="7" xml:lang="de"><persName ref="p2916">Schertli</persName> hatt von m[einen] herren begert, das man imm <lb xml:id="p1z10"/><placeName ref="l2">Arow</placeName>, <placeName ref="l69">Brugg</placeName> oder <placeName ref="l285">Lentzburg</placeName> zuͦ eim musterplatz erlaube; ist <lb xml:id="p1z11"/>imm abgschlagen einstheils von unsers landtvolks anders<lb xml:id="p1z12"/>theils <foreign xml:lang="la">propter vicinos, quibus hoc nunquam est datum.</foreign></s>
					<s n="8" xml:lang="la">Mitto schedulam <lb xml:id="p1z13"/>de inundatione facta in <placeName ref="l20">Inferiore Germania</placeName>.</s>
					<s n="9" xml:lang="la">Ex <lb xml:id="p1z14"/><placeName ref="l311">Marburgo</placeName> scribunt <persName ref="p18135">Lonicerus</persName> et alii 12. ianuarii ita excre<lb xml:id="p1z15"/>visse <placeName ref="l3381">Lanum</placeName>, ut lapideum pontem una cum duobus aliis, <lb xml:id="p1z16"/>prae aquarum violentia deiecerit et totam fere <placeName ref="l213">Hassiam</placeName> <lb xml:id="p1z17"/>inundarit; tum quoque horrenda audita esse tonitrua <lb xml:id="p1z18"/>et fulgura visa!</s>
					<s n="10" xml:lang="la">Utinam non sint magni alicuius mali prae<lb xml:id="p1z19"/>sagia.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Hic diebus hisce tota civitas nostra <lb xml:id="p1z20"/>fuit in armis et egressa in vicinum campum ad <lb xml:id="p1z21"/>expugnandam arcem quandam ligneam ad hoc factam.</s>
					<s n="12" xml:lang="la">Metuo, <lb xml:id="p1z22"/>ne hoc quoque aliquid mali portendat.</s>
					<s n="13" xml:lang="la">Abs te avide expecto <lb xml:id="p1z23"/>literas; multo enim iam tempore nihil abs te accepi.</s>
					<s n="14" xml:lang="la"><persName ref="p1227">Froscho<lb xml:id="p1z24"/>verus</persName> scribit de exemplaribus meis, quę <lb xml:id="p1z25"/>mittat; sed is, cui tradidit, <lb xml:id="p1z26"/>ea <placeName ref="l587">Tiguri</placeName> reliquit.</s>
					<s n="15" xml:lang="la" ana="farewell">Vale.</s>
					<s n="16" xml:lang="la">Salvi sint fratres omnes, tum <lb xml:id="p1z27"/>quoque tui domestici.</s>
					<s n="17" xml:lang="la" ana="salute">Salutant vos nostri.</s>
					<s n="18" xml:lang="la"><placeName ref="l41">Bernę</placeName> 8. martii 1552.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z28"/>T[uus] <persName ref="p8018">I[oannes] H<lb xml:id="p1z29"/>allerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt, dafür auf d. Rückseite ein kurzer Brief von <persName ref="p8417">Musculus</persName>, s. a. folg. Blatt.]</note>
				</p>
			</div>
		</body>
	</text>
