	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><foreign xml:lang="de">Ich han alle ding erkundiget</foreign>, et quae scribo, sunt certa.</s>
				</p>
				<p>
					<s n="3" xml:lang="de">Der <lb xml:id="p1z2"/>tag ist velengert biß uff sontag vor Galli, <foreign xml:lang="la">id est</foreign> den <foreign xml:lang="la">12. <lb xml:id="p1z3"/>octobers, invitis legatis</foreign>, und einmal uff <placeName ref="l108">Davoß</placeName> <lb xml:id="p1z4"/>gesetzt.</s>
					<s n="4" xml:lang="de">Hoff aber, die uß dem <placeName ref="l648">Oberen Pundt</placeName> sprechend, <lb xml:id="p1z5"/>sy habind siderhar im protocol funden, das er inen gehöre.</s>
					<s n="5" xml:lang="de"><lb xml:id="p1z6"/><foreign xml:lang="la">Quicquid est</foreign>, es ist verlengeret.</s>
				</p>
				<p>
					<s n="6" xml:lang="de">Nun so schrybend ir <lb xml:id="p1z7"/>h. <persName ref="p629">Coignet</persName> das alles, damit es ester stattlicher <lb xml:id="p1z8"/>zuͦgange und des künigs bottschafft selbs <lb xml:id="p1z9"/>möge kommen.</s>
					<s n="7" xml:lang="de"><lb xml:id="p1z10"/><foreign xml:lang="la">Adhuc unum</foreign>: Des bapsts und des <persName>Philippi</persName> bottschafft <lb xml:id="p1z11"/>sint nächt so bitterlich mit einander uneinß <lb xml:id="p1z12"/>worden, das sy hinacht uß der kammer <lb xml:id="p1z13"/>von einander theylt hand.</s>
					<s n="8" xml:lang="la">Hęc certa.</s>
					<s n="9" xml:lang="la">3. septembri<lb xml:id="p1z14"/>s.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">T[uus] <persName ref="p8009">Fab[ricius</persName>]<pb/><lb xml:id="p2z1"/>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Vere magno et in primis <lb xml:id="p2z2"/>pio viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, domino <lb xml:id="p2z4"/>suo.</s>
				</p>
				<p>
					<s n="12" xml:lang="de"><lb xml:id="p2z5"/>An <lb xml:id="p2z6"/>h. <persName ref="p495">Bullinger</persName>.</s>
					<s n="13" xml:lang="de"><lb xml:id="p2z7"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
