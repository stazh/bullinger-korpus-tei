	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z8"/>In<lb xml:id="p1z9"/>t<lb xml:id="p1z10"/>ere<lb xml:id="p1z11"/>a d<lb xml:id="p1z12"/>um nullas scribo <persName ref="p6589">Servetus</persName> infelix <lb xml:id="p1z13"/><placeName ref="l167">Genevae</placeName> coniectus est in vincula.</s>
					<s n="2" xml:lang="la">Contulerunt <lb xml:id="p1z14"/>cum ipso fratres nostri.</s>
					<s n="3" xml:lang="la">Superbe et pertinacite<lb xml:id="p1z15"/>r restitit bestia.</s>
					<s n="4" xml:lang="la">Tandem disputata ad nos <lb xml:id="p1z16"/>misit amplissimus eius reipublicae senatus.</s>
					<s n="5" xml:lang="la">Pro<lb xml:id="p1z17"/>bavimus sententiam fratrum.</s>
					<s n="6" xml:lang="la">Damnavimus <persName ref="p6589">Serveti</persName> <lb xml:id="p1z18"/>blasphemias.</s>
					<s n="7" xml:lang="la">Idem fecerunt aliae <lb xml:id="p1z19"/>ecclesiae, <placeName ref="l41">Bernensis</placeName>, <placeName ref="l441">Schaffhusiana</placeName>, <placeName ref="l28">Basiliensis</placeName> etc.</s>
					<s n="8" xml:lang="la">Quumque <lb xml:id="p1z20"/>in blasphemiis pergeret, sub finem octobris <lb xml:id="p1z21"/>combustus est <placeName ref="l167">Genevae</placeName>.</s>
					<s n="9" xml:lang="la">Horrendis blasphemiis <lb xml:id="p1z22"/>refertum librum edidit sceleratus ille.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Hoc referes illustrissimo principi, qu<lb xml:id="p1z24"/>em m<lb xml:id="p1z25"/>iror i<lb xml:id="p1z26"/>ta si<lb xml:id="p1z27"/>ler<lb xml:id="p1z28"/>e.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l587">T<lb xml:id="p1z29"/>igur<lb xml:id="p1z30"/>i</placeName> 29. <lb xml:id="p1z31"/>decemb<lb xml:id="p1z32"/>ris a <lb xml:id="p1z33"/>natal<lb xml:id="p1z35"/>i dom<lb xml:id="p1z36"/>ini <lb xml:id="p1z38"/>1554.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p1010">Matthi<lb xml:id="p2z2"/>ae Erbo</persName>, pastori <lb xml:id="p2z3"/><placeName ref="l411">Rychevillano</placeName>, domino et <lb xml:id="p2z4"/>fratri suo colendo et <lb xml:id="p2z5"/>caro.</s>
				</p>
				<p>
					<s n="14" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l411">Rychenwyr</placeName>.</s>
				</p>
			</div>
