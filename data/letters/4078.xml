	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Non potui, tum tabellarius, ut vos resderet
					<lb xml:id="p1z2"/>optime prater B tuis suavissimis literis
					<lb xml:id="p1z3"/>prespondere. Gravissimis enim tilię negotii
					<lb xml:id="p1z4"/>ut novit Hotomannus etiam olcupaturr dix.
					<lb xml:id="p1z5"/>tmn vestri lectu adolescenti <placeName ref="l587">Tigurino</placeName>, qui
					<lb xml:id="p1z6"/>apud Hetrincium est, ut me apud te ex
					<lb xml:id="p1z7"/>cuscrt id quod ei ab eo factum fuisse
					<lb xml:id="p1z8"/>credo nunc tibi affermum, adilescenter nic
					<lb xml:id="p1z9"/>scripsisti, misi fire (ut tua
					<lb xml:id="p1z10"/>de g
					<lb xml:id="p1z11"/>dic
					<lb xml:id="p1z12"/>me merita piculet) qua commendat et
					<lb xml:id="p1z13"/>quicquid no illorum ornamentum peacnt poter.
					<lb xml:id="p1z14"/>ilud me praeciturum reciper, modi
					<lb xml:id="p1z15"/>quibus rebus opus habeam et quid a me
					<lb xml:id="p1z16"/>enperte Gtistigsn ecclesia nostra
					<lb xml:id="p1z17"/>fuit valde turbata, idque perpernimes
					<lb xml:id="p1z18"/>effremen et nocentem linguum pastoris, quomp
					<lb xml:id="p1z19"/>et ab offmo deiectus est et inm graviter
					<lb xml:id="p1z20"/>egritat. Dileo dileo vehementer eius vetes.
					<lb xml:id="p1z21"/>et voluerit unitim consiliis ficrerem.
					<lb xml:id="p1z22"/>ium.
					<lb xml:id="p1z23"/>spert iare propter diversitatem doctrine
					<lb xml:id="p1z24"/>in re sacramentaria fuisse a ministris
					<lb xml:id="p1z25"/>suo conventu eiectum et a magistrat
					<lb xml:id="p1z26"/>de offeteo depositum; sed sic falsum est.
					<lb xml:id="p1z27"/>et pastores animu en senatus
					<lb xml:id="p1z28"/>ispe mihi rotendes verbis affirmavit.
					<lb xml:id="p1z29"/>enim espoculaveram cum iampade
					<lb xml:id="p1z30"/>et quod si sroper dictrinam de re satramenti
					<lb xml:id="p1z31"/>eam eupellam; Respetiat enm
					<lb xml:id="p1z32"/>metum fugo eandem quoque doctrinem
					<lb xml:id="p1z33"/>prfeteat et doteam in respondera, nosta
					<pb/>
					<lb xml:id="p2z1"/>15.
					<lb xml:id="p2z2"/>ab se muntionum doctrinę fratam fuisse
					<lb xml:id="p2z3"/>neque lecte est verissimile; nam cupi
					<lb xml:id="p2z4"/>scuber Lochetum in pastorum, ei
					<lb xml:id="p2z5"/>iedegiam. Platerum igeneum et gratiam
					<lb xml:id="p2z6"/>apud tiliam; ipe tamen eiusdem est doctu
					<lb xml:id="p2z7"/>tuis ei plei. Ego libere
					<lb xml:id="p2z8"/>de huc re diceo, nec diteo tamtun, quod
					<lb xml:id="p2z9"/>ese dictaus in silcta, sesput christo
					<lb xml:id="p2z10"/>non mandutari, nisi ab iis, qer fere praere
					<lb xml:id="p2z11"/>ad lęutem ilterum et quoarem fide, ne
					<lb xml:id="p2z12"/>animo detilii manducari et tamen non sol
					<lb xml:id="p2z13"/>non empetla me hin; sed enim ut i
					<lb xml:id="p2z14"/>meum rigant, sed in omnius opus est
					<lb xml:id="p2z15"/>more sa ve rteritate plateretate deni
					<lb xml:id="p2z16"/>nihil est nostro aamgestratui grateur.
					<lb xml:id="p2z17"/>turbilentis iongeniiss em effrenitu linguuis
					<lb xml:id="p2z18"/>displicuit senatus ime fulsus rumur.
					<lb xml:id="p2z19"/>qui quorsum spectet, optime vedet
					<lb xml:id="p2z20"/>Benus vester, quantus esset vutherams.
					<lb xml:id="p2z21"/>strnesciet. ipse tamen suo me
					<lb xml:id="p2z22"/>nepereo fuerat abditatus, quam qd
					<lb xml:id="p2z23"/>ob eudem, id quam et feu.
					<lb xml:id="p2z24"/>dileo hunc hatres vetes et eo magis
					<lb xml:id="p2z25"/>diteo, quod praeclares alioqui vive dei
					<lb xml:id="p2z26"/>eHęc non libenter ad te
					<lb xml:id="p2z27"/>scribo.
					<lb xml:id="p2z28"/>scriberem, seveve
					<lb xml:id="p2z29"/>eccei me
					<lb xml:id="p2z30"/>idpuleri, non qui
					<lb xml:id="p2z31"/>velem diterum. Soliountur sterim
					<lb xml:id="p2z32"/>d. Halielmus, qui fuerint pastor ecclesię
					<lb xml:id="p2z33"/>Hallitane
					<pb/>
					<lb xml:id="p3z1"/>eti
					<lb xml:id="p3z2"/>is.
					<lb xml:id="p3z3"/>
					<lb xml:id="p3z4"/>
					<lb xml:id="p3z5"/>
					<lb xml:id="p3z6"/>S8.
					<lb xml:id="p3z7"/>To.
					<lb xml:id="p3z8"/>assi
					<lb xml:id="p3z9"/>et
					<lb xml:id="p3z10"/>t
					<lb xml:id="p3z11"/>.
					<lb xml:id="p3z12"/>hcofueri, inis est bene doctus et gratiam
					<lb xml:id="p3z13"/>habet ditendi, quamvis et ecclesię. geni
					<lb xml:id="p3z14"/>veste platedi dextri, fateles, non est
					<lb xml:id="p3z15"/>auactic non irctundus, sed suammet
					<lb xml:id="p3z16"/>tenet linguia et est ver sane di
					<lb xml:id="p3z17"/>trenę si Lochetus nilit respderem. esim
					<lb xml:id="p3z18"/>i comitatum cimentes a Nasso et ibi aget
					<lb xml:id="p3z19"/>pastorum et omnius est gratia) speramur
					<lb xml:id="p3z20"/>habituros hunc nost. Msit quoi deus
					<lb xml:id="p3z21"/>suę iuliterę e rogo, nostram sunc tuliam
					<lb xml:id="p3z22"/>commende prętitus tui popim nisil
					<lb xml:id="p3z23"/>Ppraeterea, quod scribam, habeo novi
					<lb xml:id="p3z24"/>bene vale et domino te veu
					<lb xml:id="p3z25"/>ad utiletur similtię insilimu conservet.
					<lb xml:id="p3z26"/>Argentirato 15. septembris 53.
					<lb xml:id="p3z27"/>Tad.
					<lb xml:id="p3z28"/>Hier rudzi
					<pb/>
					<lb xml:id="p4z1"/>vigilantur et optimo ecclesię
					<lb xml:id="p4z2"/><placeName ref="l587">Tigurinę</placeName> pritiri e
					<lb xml:id="p4z3"/>d. Henrio Bullingero,
					<lb xml:id="p4z4"/>siri obserd et solendissim.
					<lb xml:id="p4z5"/>T quri.
					<lb xml:id="p4z6"/>m.
					<lb xml:id="p4z7"/>o.
					<lb xml:id="p4z8"/>vio.
					<lb xml:id="p4z9"/>atvaled
				</p>
