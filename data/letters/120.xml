	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi tuas expectatissimas, charissime <persName ref="p8418">Myconi</persName>, per <persName ref="p7070">H<lb xml:id="p1z2"/>(einrychum) Wirtium</persName>, quem commendasti.</s>
					<s n="3" xml:lang="la">Ego illum <lb xml:id="p1z3"/>libenter iuvabo, quantum possum salva conscientia, idque <lb xml:id="p1z4"/>propter tuam commendationem.</s>
					<s n="4" xml:lang="la">Postulavi ab ipso literas, <lb xml:id="p1z5"/>quas vocant testimonii, scriptas a ministris <lb xml:id="p1z6"/>ecclesiae <placeName ref="l507">Doggianae</placeName>; eas expecto.</s>
					<s n="5" xml:lang="la">Vixit alioqui <lb xml:id="p1z7"/>hucusque satis libidinose et exercuit usuram; <lb xml:id="p1z8"/>mercator enim fuit etc.</s>
				</p>
				<p>
					<s n="6" xml:lang="de"><foreign xml:lang="la">De <placeName ref="l257">Constantiensibus</placeName> hoc <lb xml:id="p1z9"/>habeo:</foreign> "Unser botten ligend zuͦ <placeName ref="l18">Augspurg</placeName> und <lb xml:id="p1z10"/>wie man fürgäben, so wir uns ergäbin<lb xml:id="p1z11"/>d <lb xml:id="p1z12"/>und gnad begärind, werde nit me von <lb xml:id="p1z13"/>uns erfordert, ist es jetzung ein anders, und <lb xml:id="p1z14"/>wil man mitt den botten vorhin articul<lb xml:id="p1z15"/>ieren.</s>
				</p>
				<p>
					<s n="7" xml:lang="de"><lb xml:id="p1z16"/>Also gadt es" etc.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Capita Interim <lb xml:id="p1z18"/>accepi ab <placeName ref="l18">Augusta</placeName>, de quo tu m<lb xml:id="p1z19"/>eliora accepisti, quam revera res ipsa habeat.</s>
					<s n="9" xml:lang="la">Certe quo <lb xml:id="p1z20"/>ab initio disputantur de statu hominis ante et post <lb xml:id="p1z21"/>lapsum, de servitute et captivitate, de li<lb xml:id="p1z22"/>bertate et redemptione hominis per Christum, de iusti<lb xml:id="p1z23"/>ficatione etc. non omnino impia dicuntur esse.</s>
					<s n="10" xml:lang="la">Sed <lb xml:id="p1z24"/>reliqua de 7 sacramentis, de incarnatione <lb xml:id="p1z25"/>et intercessione sanctorum, de festis, cerem<lb xml:id="p1z26"/>oniis, missis, oratione per mortuis etc. plane <lb xml:id="p1z27"/>papistica sunt et quae doctrinam sanam de Christo <lb xml:id="p1z28"/>subvertunt.</s>
					<s n="11" xml:lang="la">Lusit ergo quidam in Interim: <lb xml:id="p1z29"/><persName ref="p18538">Caesar Carolus</persName> Interim pudendum, <lb xml:id="p1z30"/>Mendax, falsiloquu dolisque plenum <lb xml:id="p1z31"/>Finxit.</s>
					<s n="12" xml:lang="la">Si: Quid id est requiris, audi: <lb xml:id="p1z32"/>Forma est, qua pietas fidesque vera <lb xml:id="p1z33"/>Et quicquid superest in orbe sancti <lb xml:id="p1z34"/>Ceu diro misere interit veneno.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z35"/>Certe oportebit nos probari.</s>
					<s n="14" xml:lang="la">Qui persevera<lb xml:id="p1z36"/>verit in finem usque, salvus erit.</s>
					<s n="15" xml:lang="la">Articulus <lb xml:id="p1z37"/>de eucharistia transubstantionem et ado<lb xml:id="p1z38"/>rationem retinet mordicus etc.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z39"/>Scis <persName ref="p8018">Hallerum</persName> <lb xml:id="p1z40"/>a nostris postulatum <placeName ref="l41">Bernam</placeName> esse missum.</s>
					<s n="17" xml:lang="la">Audio <persName ref="p8364">Battum</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8364">Beat Gering</persName>.</note> <lb xml:id="p1z41"/>et <persName ref="p3099">Sulcerum</persName> <placeName ref="l28">Basileam</placeName> concessuros.</s>
					<s n="18" xml:lang="la">Tuum fuerit <lb xml:id="p1z42"/>diligenter curare, ut ecclesia vestra in tran<lb xml:id="p1z43"/>quillitate maneat.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="farewell">Vale et me, ut soles, ama.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z44"/>Nova habeo plura, sed quae dubia apud <lb xml:id="p1z45"/>me sunt; nolui his te gravare.</s>
					<s n="21" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z46"/><placeName ref="l587">Tiguri</placeName> 14. maii 1548.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z47"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro D. <persName ref="p8418">Os<lb xml:id="p2z2"/>valdo Myconio</persName>, <lb xml:id="p2z3"/>domino et fratri semper <lb xml:id="p2z4"/>colendo suo.</s>
					<s n="25" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
