	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Literas tuas legi nec sine dolore inter
					<lb xml:id="p1z2"/>Turcas imminere regno Tiprico;
					<lb xml:id="p1z3"/>extrema regnat ibi barbaries, ubi Turcę in
					<lb xml:id="p1z4"/>peritant. Sed oportet ita castigari, quod reliqui
					<lb xml:id="p1z5"/>est orbis christianum, quod alioqui omnes fideles
					<lb xml:id="p1z6"/>admonitiones non tantum contemnit, sed persequitur
					<lb xml:id="p1z7"/>etiam truculentissime, sic per omnes oras
					<lb xml:id="p1z8"/>principes rer
					<lb xml:id="p1z9"/>inspirantem diabolo
					<lb xml:id="p1z10"/>dominos.D. Aurelium Schytartham salutabis
					<lb xml:id="p1z11"/>amicissime. Imprimis vero gaudeo amplissimu
					<lb xml:id="p1z12"/>magistratum nostrum tam mili precio) Cerberum illi
					<lb xml:id="p1z13"/>que scis placavisse. Mercatores nostri nondi
					<lb xml:id="p1z14"/>redierunt a nundinis Francfordeni. Audio
					<lb xml:id="p1z15"/>Saxoniam parare equites et sclopetarios
					<lb xml:id="p1z16"/>gratiam Galli et Gallum gravissima exacti
					<lb xml:id="p1z17"/>suis imposuisse. Ex Cracovia scribi
					<lb xml:id="p1z18"/>D. Ioanns Burcherus Anglus miranda plurimo
					<lb xml:id="p1z19"/>inprimis tamen illud veritatem subinde
					<lb xml:id="p1z20"/>magisque radices agere altius. Scribit
					<lb xml:id="p1z21"/>quidam e Sangallo amicus meus ad me Ferdnium
					<lb xml:id="p1z22"/>ando commissam imperii gubernatione, ipsum
					<lb xml:id="p1z23"/>.
					<lb xml:id="p1z24"/>festinare citos equis Viennam.
					<lb xml:id="p1z25"/>aute comicia celebranda fore Augustae.
					<lb xml:id="p1z26"/>delicorum, illuc evocatis nonnullis picipibus
					<lb xml:id="p1z27"/>Doni vero Nerobergae universalia
					<lb xml:id="p1z28"/>scribenda comitia. uut Revocavi est .
					<lb xml:id="p1z29"/>Ratavina filium nostrum Heirychum et
					<lb xml:id="p1z30"/>hunc expecto in diem. Iussi per literas, ut te
					<lb xml:id="p1z31"/>salutet cum Curia attigerit; te oro illi
					<lb xml:id="p1z32"/>significes, non diu haereat in itunere et
					<lb xml:id="p1z33"/>nhic ad nos in urbem venerit, e
					<lb xml:id="p1z34"/>in alias quam meas aedes divertat. Hoam
					<lb xml:id="p1z35"/>ideo scribo, quod intelligo quosdam illi sis
					<lb xml:id="p1z36"/>inificasse, ut prius in Iosiae generi ei
					<lb xml:id="p1z37"/>quam in meas divertat. Fessus et fratis
					<lb xml:id="p1z38"/>laboribus aegre hodie ista scribo.
					<lb xml:id="p1z39"/>gratias clarissimis viris d. d. consules, ita, ut su
					<lb xml:id="p1z40"/>Optime vale cum Philippo ponticis
					<lb xml:id="p1z41"/>bella et fratribus. <placeName ref="l587">Tiguri</placeName> 8. aprilis 1558.
					<lb xml:id="p1z42"/>Bullingerus tuus.
					<pb/>
					<lb xml:id="p2z1"/>Praestantissimo viro d. Ioanni
					<lb xml:id="p2z2"/>Fabritio, Curiensis ecclesiae
					<lb xml:id="p2z3"/>in Rhetia fideli ministro
					<lb xml:id="p2z4"/>compatri et fratri nostro
					<lb xml:id="p2z5"/>dilectissimo.
				</p>
			</div>
