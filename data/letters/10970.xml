	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Impetrastis, quod petistis<note xml:id="fn1" type="footnote" n="1">Der <placeName ref="l587">Zürcher</placeName> Rat stimmte am 16. Dezember der von <placeName ref="l28">Basel</placeName> vorgeschlagenen Änderung des Schreibens an <persName ref="p1974">Luther</persName> zu; vgl. oben <ref target="file10968">Nr. 926</ref>, 1 -26, und <bibl source="b671">WA</bibl> Briefwechsel XII 244.</note>, <lb xml:id="p1z2"/>quia haec, quae nunc reddidistis, multo sunt circumspectiora <lb xml:id="p1z3"/>(ut non fuerit <persName ref="p1753">Leoni</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p1753">Leo Jud</persName>.</note> et mihi grave in ipsa consentire <lb xml:id="p1z4"/>ipsaque recipere), quam fuerint priora<note xml:id="fn3" type="footnote" n="3">Siehe oben <ref target="file10966">Nr. 924</ref>.</note>.</s>
					<s n="3" xml:lang="la">Cum <lb xml:id="p1z5"/>libere mecum agis et mones, non est, quod praefari <lb xml:id="p1z6"/>pergas et veluti deprecari culpam.</s>
					<s n="4" xml:lang="la">Libenter recipio <lb xml:id="p1z7"/>fratrum liberas admonitiones.</s>
					<s n="5" xml:lang="la">Tuum erit curare, <lb xml:id="p1z8"/>ne quid insciis <placeName ref="l41">Bernensibus</placeName> fiat<note xml:id="fn4" type="footnote" n="4">Die auch im Schreiben <placeName ref="l587">Zürichs</placeName> an <placeName ref="l28">Basel</placeName> ausdrücklich genannte Bedingung scheint nicht erfüllt worden zu sein; s. <bibl source="b671">WA</bibl> Briefwechsel XII 244.</note>.</s>
					<s n="6" xml:lang="la">Non iam dico fratres, <lb xml:id="p1z9"/>hoc est verbi ministros, sed senatores.</s>
					<s n="7" xml:lang="la">Nolunt isti <lb xml:id="p1z10"/>se praeterin.</s>
					<s n="8" xml:lang="la">Faxit dominus, ut induratus <persName ref="p1974">Lutheri</persName> <lb xml:id="p1z11"/>suorumque animus nos ferat, nob iam dicere, nostra <lb xml:id="p1z12"/>recipiat.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Fratres <placeName ref="l491">Argentinenses</placeName> satis acerbe agunt cum <lb xml:id="p1z13"/><placeName ref="l257">Constantiensibus</placeName><note xml:id="fn5" type="footnote" n="5">Vgl. <persName ref="p4079">Zwicks</persName> Bericht vom 30. November (oben <ref target="file10963">Nr. 921</ref>, 27-58).</note>.</s>
					<s n="10" xml:lang="la">Ibi nunc <persName ref="p8178">Thomas Blaurerus</persName> con<lb xml:id="p1z14"/>sul designatus est.</s>
					<s n="11" xml:lang="la">Nolunt isti sic compelli <lb xml:id="p1z15"/>ad subscriptionem; ea libertate uti volunt, qua vident <lb xml:id="p1z16"/>ecclesias <placeName ref="l862">Helveticas</placeName> esse usas.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Nollem autem, <lb xml:id="p1z17"/>quis apud nostros sciret, quam promptis animis ad rem <lb xml:id="p1z18"/>tam exilem discessionem a nobis minitemini<note xml:id="fn6" type="footnote" n="6">Vgl. oben <ref target="file10966">Nr. 924</ref>, 20-22, und 926, 20f.</note>.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z19"/>Libere, quod sentio, dicam.</s>
					<s n="14" xml:lang="la">Non potui non commo<lb xml:id="p1z20"/>veri, et etiamnum commoveor.</s>
					<s n="15" xml:lang="la">Nec scio, quid <lb xml:id="p1z21"/>fecisset senatus, nisi <persName ref="p1753">Leo</persName> et ego summis conatibus <lb xml:id="p1z22"/>egissemus negotium.</s>
					<s n="16" xml:lang="la">Si vel tantillum huius per<lb xml:id="p1z23"/>cepissent, nescio, quid actum esset.</s>
					<s n="17" xml:lang="la">Nosti nostra ingenia.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z24"/>Obsecro, eum vobis erga nos animum habetote <lb xml:id="p1z25"/>inditum, qualem videtis nos erga vos gerere.</s>
					<s n="19" xml:lang="la">Mors <lb xml:id="p1z26"/>nulla nos dividet.</s>
					<s n="20" xml:lang="la">Et tamen scio iactare quosdam <lb xml:id="p1z27"/><placeName ref="l28">Basileienses</placeName> in solidum consentire, reliquos non ite<lb xml:id="p1z28"/>m<note xml:id="fn7" type="footnote" n="7">Vgl. oben <ref target="file10963">Nr. 921</ref>, 7f.</note>.</s>
					<s n="21" xml:lang="la">Invenias, qui dicant: "Utinam non recipia<lb xml:id="p1z29"/>t <lb xml:id="p1z30"/><persName ref="p1974">Lutherus</persName> id responsi!</s>
					<s n="22" xml:lang="la">Priusquam enim <placeName ref="l28">Basileienses</placeName> istum <lb xml:id="p1z31"/>offenderint, recipient<note xml:id="fna" type="footnote" n="a">recipient <hi>korrigiert aus</hi> receperint.</note> articulos adeoque subscribent<note xml:id="fnb" type="footnote" n="b">subscribent <hi>korrigiert aus</hi> subscripserint.</note>.</s>
					<s n="23" xml:lang="la"><lb xml:id="p1z32"/>Sic autem findemus, quos hactenus <lb xml:id="p1z33"/>vidimus coniunctissimos."</s>
					<s n="24" xml:lang="la">Haec tibi in sinum.</s>
					<s n="25" xml:lang="la">Nosti m<lb xml:id="p1z34"/>e.</s>
					<s n="26" xml:lang="la">Nosti, quali sim erga vos animo praeditus.</s>
				</p>
				<p>
					<s n="27" xml:lang="la" ana="farewell">Iam <lb xml:id="p1z35"/>vale et schedulam hanc<note xml:id="fn8" type="footnote" n="8">Nicht erhalten.</note> <persName ref="p1365">Gryneo</persName> dato, ut mihi <lb xml:id="p1z36"/>respondeat, qualia sint folia anabuli<note xml:id="fn9" type="footnote" n="9">Ein Pflanzenname; vgl. Mittellateinisches Wörterbuch bis zum ausgehenden 13. Jahrhundert, Bd. I, München 1967, Sp. 604 (anabulla).</note>.</s>
					<s n="28" xml:lang="la" ana="salute">Salutem <lb xml:id="p1z37"/>illi ex me dicito et reliquis fratribus.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><lb xml:id="p1z38"/><persName ref="p467">Bucero</persName> has<note xml:id="fn10" type="footnote" n="10">Das am 13. Dezember in einem Brief <persName ref="p495">Bullingers</persName> an <persName ref="p8049">Vadian</persName> angekündigte Schreiben an <persName ref="p467">Bucer</persName> ist nicht erhalten (vgl. oben <ref target="file10969">Nr. 927</ref>, 24).</note> deferri curato.</s>
				</p>
				<p>
					<s n="30" xml:lang="la">16. decembris 1536.</s>
				</p>
				<p>
					<s n="31" xml:lang="la"><lb xml:id="p1z39"/>Tuus <persName ref="p495">H. Bullingerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="32" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8418">Osvaldo Myconi<lb xml:id="p2z2"/>o</persName>, <placeName ref="l28">Basileien[sium]</placeName> antistiti <lb xml:id="p2z3"/>vigilantissimo, suo in domino fratri.</s>
				</p>
			</div>
