	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Nach dem Tod von <persName ref="p1365" cert="high">Simon Grynäus</persName> (1. August 1541) und der Rückkehr von <persName ref="p4082" cert="high">Konrad Zwick</persName> aus <placeName ref="l410" cert="high">Regensburg</placeName> (vgl. die folgende Anm.).</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Heri frater rediit<note xml:id="fn2" type="footnote" n="2"><persName ref="p4082">Konrad Zwick</persName> hatte <placeName ref="l257">Konstanz</placeName> am Reichstag zu <placeName ref="l410">Regensburg</placeName> vertreten (vgl. oben <ref target="file11569">Nr. 1526</ref>, Anm. 3); das genaue Datum seiner Rückkehr ist nicht bekannt.</note>.</s>
					<s n="3" xml:lang="la">Relationem senatui <lb xml:id="p1z2"/>non fecit adhuc.</s>
					<s n="4" xml:lang="la">Qua facta etiam nos sciemus <lb xml:id="p1z3"/>certa, quae te non celabo tabellione proximo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z4"/>De <persName ref="p1365">Grynei</persName> obitu<note xml:id="fn3" type="footnote" ana="bio" n="3">Zum Tod von <persName ref="p1365">Simon Grynäus</persName> vgl. oben <ref target="file11595">Nr. 1552</ref>, Anm. b.</note> omnes sumus consternati.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z5"/>Tuus <lb xml:id="p1z6"/><persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l803">Tigurinae</placeName> ecclesię pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
				</p>
			</div>
		</body>
	</text>
