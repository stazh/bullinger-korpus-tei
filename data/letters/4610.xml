	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Scripsi ad te per <persName ref="p1541">Herterum</persName> nudius tertius.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Nunc mitto, quę heri sub cenam accepi; <lb xml:id="p1z2"/>nam casu in idi in bonum virum, nostratem civem, qui omnia bona fide, scio, ad te perferet.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/><persName ref="p1568">Hoserus</persName> ad me duo exemplaria misit eius libelli, quem hic accipis, alterum igitur tibi <lb xml:id="p1z4"/>mitto.</s>
					<s n="4" xml:lang="la">Quodsi in literis tibi inscriptis alius forte est alterius argumenti insinuatus, <lb xml:id="p1z5"/>age fac mecum communices.</s>
					<s n="5" xml:lang="la" ana="farewell">Bene vale, mi venerande charissimeque frater.</s>
					<s n="6" xml:lang="la">3. ianuarii 1561.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z6"/>T[uus] <persName ref="p8055">Ambrosius Blaurerus</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><persName ref="p1568">Hoserus</persName> nihil pr<lb xml:id="p1z7"/>orsus novi scribit, <lb xml:id="p1z8"/>nisi quod hactenus solet de <lb xml:id="p1z9"/>ubiquitariis istis etc.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
