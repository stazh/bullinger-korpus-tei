			<zone xml:id="p2z43-0" points="676,3456 2358,3442 2306,3390 1823,3430 1778,3390 1541,3379 1340,3414 676,3388">689,3440 772,3440 856,3440 940,3439 1024,3437 1108,3437 1191,3439 1275,3440 1359,3439 1443,3440 1527,3441 1610,3443 1694,3446 1778,3446 1862,3446 1946,3443 2029,3444 2113,3443 2197,3443 2281,3440 2365,3434</zone>
		</surface>
