	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi nuper ad te per <persName>Andream Iociscum</persName> neque nunc sane <lb xml:id="p1z2"/>quidquam habeo, quod addam, quam vulgaria illa, quae minore molestia <lb xml:id="p1z3"/>ex eo, qui literas perfert, cognosces, <persName ref="p8371">Alberti</persName> magistro, quare ignosces <lb xml:id="p1z4"/>brevitati.</s>
					<s n="3" xml:lang="la"><persName ref="p8371">Albertum</persName> quidem ipsum quominus vobis commendem, ve<lb xml:id="p1z5"/>ster erga ipsius patrem, <persName ref="p3740">Georgium a Stetten</persName>, singularis amor benevo<lb xml:id="p1z6"/>lentiaque facit, qui vos non conquiescere, scio, sinet, quoad effeceritis, <lb xml:id="p1z7"/>ut nostrae expectationi satisfaciat, id quod vobis facile erit; <lb xml:id="p1z8"/>neque enim eo ingenio est, ut de ipso praeclarum aliquid (loquor autem de <lb xml:id="p1z9"/>ingenii cultura et eruditione) polliceri nobis possimus; est tamen <lb xml:id="p1z10"/>prodire quodam, si non datur ultra.</s>
					<s n="4" xml:lang="la">Ab <persName ref="p8018">Hallero</persName> nihildum ac<lb xml:id="p1z11"/>cepi.</s>
					<s n="5" xml:lang="la">De puero pharmacopola quid fiat, scire velim, cum equi <persName ref="p3740">Stettense<lb xml:id="p1z12"/>s</persName> sint reducendi vacui.</s>
					<s n="6" xml:lang="la" ana="salute">D. <persName ref="p8011">Gvalthero</persName> atque <persName ref="p3988">Wolfio</persName> scripsi superi<lb xml:id="p1z13"/>ori mense; qui quia nihil rescripsere, non mirabuntur nihil se modo a me <lb xml:id="p1z14"/>accipere, salutem tamen multissimam dices cum ipsis tum <persName ref="p1453">Hallero</persName> <persName ref="p8442">Simleroque</persName>.</s>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z15"/>Quod reliquum est, bene vale, humanissime mi d. <persName ref="p495">Bullingere</persName>, et <lb xml:id="p1z16"/>me amare perge.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l18">Augustae</placeName> 10. septembris 1567.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p2899">M[atthias] Schenckius</persName>, t[otus] t[<pb/><lb xml:id="p2z1"/>uus].</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ornatissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>d. atque amico observando.</s>
				</p>
			</div>
