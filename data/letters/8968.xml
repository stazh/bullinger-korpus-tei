			<zone xml:id="p2z5-0" points="1980,1747 2045,1723 2171,1761 2248,1718 2363,1778 2444,1725 2527,1712 2587,1760 2625,1753 2625,1634 2405,1624 2324,1658 2209,1621 2131,1674 2057,1632 1980,1634">1987,1721 2019,1717 2051,1715 2083,1715 2115,1715 2147,1715 2179,1715 2211,1714 2243,1713 2275,1713 2308,1715 2340,1715 2372,1715 2404,1715 2436,1715 2468,1715 2500,1715 2532,1715 2564,1717 2596,1718 2629,1718</zone>
			<zone xml:id="p2z6-0" points="2027,1833 2069,1841 2120,1820 2159,1828 2202,1865 2220,1865 2281,1826 2327,1814 2327,1749 2307,1736 2269,1761 2184,1775 2169,1788 2143,1784 2092,1733 2027,1742">2035,1805 2061,1802 2088,1800 2115,1799 2142,1799 2169,1799 2195,1799 2222,1801 2249,1802 2276,1802 2303,1801 2330,1799</zone>
