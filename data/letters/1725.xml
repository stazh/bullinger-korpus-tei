	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Perturbatam huc reversus inveni domum meam; siquidem <lb xml:id="p1z2"/>absente me <persName>Caleph Bschörlius</persName>, stipendiarius et alumnus e<lb xml:id="p1z3"/>cclesię vestrae, meus autem commensalis, peste correptus 18. septembris <lb xml:id="p1z4"/>ad dominum migravit.</s>
					<s n="3" xml:lang="la">Auxit familię dolorem mea absentia; <lb xml:id="p1z5"/>sed quamvis praesens fuissem, non tamen, quod dominus constituerat, averte<lb xml:id="p1z6"/>re potuissem.</s>
					<s n="4" xml:lang="la">Consolatione non indiguit, siquidem <persName ref="p8417">Musculus</persName> <lb xml:id="p1z7"/>sedulo illi affuit et pulchre de fide et patientia eius testatur.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Obiere in agro duo quoque interea ministri, alter <placeName ref="l582">Zofingensis</placeName><note xml:id="fn1" type="footnote" n="1"><persName ref="p20647">Johannes Räber</persName> (Zofinger Njbl., 1977, 15).</note>, <lb xml:id="p1z9"/>et <persName>Theobaldus</persName> in <placeName ref="l1101">Hertzogenbuchs</placeName><note xml:id="fn2" type="footnote" n="2"><persName ref="p4730">Diebold Etter</persName>, s. Lohner.</note>.</s>
					<s n="6" xml:lang="la">Decumbit adhuc ludimagister<note xml:id="fn3" type="footnote" n="3"><persName ref="p8052">Valentin Rebmann/Ampelander</persName>?</note> <lb xml:id="p1z10"/><placeName ref="l582">Zofingę</placeName>.</s>
					<s n="7" xml:lang="la">Hic non admodum, imo nihil alias grassatur pestis; <lb xml:id="p1z11"/>suspicor tamen magnam luem subsequuturam.</s>
					<s n="8" xml:lang="la">Fiat autem voluntas domini.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z12"/>Beatus ille dicendus est vere, quem dominus ex hoc perturbatissimo erga<lb xml:id="p1z13"/>stulo transfert in aeternum regni sui gaudium.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Habes hic <lb xml:id="p1z14"/>quaedam excerpta ex literis ab <placeName ref="l18">Augusta</placeName> ad nos missis.</s>
					<s n="11" xml:lang="la"><persName>Caesarem <lb xml:id="p1z15"/>Argentinę</persName> esse constans asseverat rumor.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Tu si quid habes, <lb xml:id="p1z16"/>vicissim nobis communica.</s>
					<s n="13" xml:lang="la" ana="salute">Salutat te tuosque <persName ref="p8417">Musculus</persName><note type="margin">a.R.: kleingeschr.</note> cum suis <lb xml:id="p1z17"/>omnibus; facit idem mea uxor et omnis familia.</s>
					<s n="14" xml:lang="la"><persName ref="p8417">Musculus</persName> <lb xml:id="p1z18"/>ipse scribit.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Studiosos hos nostros proxime tibi praesens praesenti commenda<lb xml:id="p1z19"/>vi, ut pluribus nunc non sit opus.</s>
					<s n="16" xml:lang="la">Bene de eis spero, siquidem <lb xml:id="p1z20"/>non incommode se hic gesserunt.</s>
					<s n="17" xml:lang="la">Inculcavi eis graviter, quomodo se <lb xml:id="p1z21"/>illic gerere debeant; spero ipsos obsequuturos esse.</s>
					<s n="18" xml:lang="la">Si quid delin<lb xml:id="p1z22"/>quant vel illi vel alii, rogo privatim ad me prius quam communiter <lb xml:id="p1z23"/>ad scholarchas scribatis, idque certas ob causas; dabo enim operam, ut <lb xml:id="p1z24"/>commodius quam illi nuperi corripiantur aut castigentur.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><persName>Iodocus</persName> adhuc <lb xml:id="p1z25"/>decumbit; quid de ipsius sanit[at]e sperem, nescio.</s>
					<s n="20" xml:lang="la">Dominus det illi patientiam.</s>
					<s n="21" xml:lang="de"><lb xml:id="p1z26"/><placeName ref="l41">Bernę</placeName> 25. septembris 1552.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z27"/>Tuus <persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z28"/>Fasciculum sermonum tuorum domi inveni <lb xml:id="p1z29"/>et, prout cuique inscripti erant, distribui; <lb xml:id="p1z30"/>magnas omnes tibi habent aguntque gratias.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesię pastori fidelissimo<lb xml:id="p2z4"/>, domino et compatri s<lb xml:id="p2z5"/>uo colendissimo.</s>
				</p>
				<p>
					<s n="25" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
