	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Strenue nobis laborandum est contra perditissimum illum <lb xml:id="p1z2"/>hominem a Quadriis, qui nescio quorum nitatur auxilio.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Hoc certum est eum donationem iam fecisse et in <lb xml:id="p1z4"/>possessionem misisse duodecim homines <placeName ref="l875">Hispanos</placeName> <lb xml:id="p1z5"/>et alios sacrificulos duos, qui sacra illorum peragerent, <lb xml:id="p1z6"/>et praesidem <placeName ref="l520">Vallis Tellinae</placeName> (capitaneum vulgo appellant), <lb xml:id="p1z7"/>qui in illis partibus summo cum imperio est, han<lb xml:id="p1z8"/>c <lb xml:id="p1z9"/>donationem ratam habuisse.</s>
					<s n="4" xml:lang="la">En hominum extremam <lb xml:id="p1z10"/>impudentiam!</s>
					<s n="5" xml:lang="la">Quid tu nunc ageres, si hic esses?</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Nos clamamus ex gutture, modo hos, modo illos manu <lb xml:id="p1z12"/>prensamus, nihil denique intentatum relinquimus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Causam obtinemus denuo: fit senatus consultum contra <lb xml:id="p1z14"/>monachos et capitaneum acerrimum; rescinditur omnis <lb xml:id="p1z15"/>capitanei actio; monachi iubentur <placeName ref="l520">Valle Tellina</placeName> excedere.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Sed haec tamen non tanto cessabunt cardine rerum.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Potens <lb xml:id="p1z17"/>est illa altera factio; sed potentior est Christus cum suis.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Plura si petis, dicet nobilis vir <persName>Rhodolphus Landolfus</persName>, <lb xml:id="p1z19"/>qui et ipse Christi causam strenue defendit.</s>
					<s n="11" xml:lang="la">Accedit ad haec <lb xml:id="p1z20"/>malum aliud.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Rusticus quidam in <placeName ref="l93">Superiore Foedere</placeName>, <lb xml:id="p1z21"/>apparitionem iactat nescio quam angelicam; dicit enim <lb xml:id="p1z22"/>a <lb xml:id="p1z23"/>se conspectum esse angelum, qui iusserit tria sacella <lb xml:id="p1z24"/>in illis locis extrui missamque in illis celebrari, opus <lb xml:id="p1z25"/>plane apostolicum, quod ex quo intermissum sit, hisce <lb xml:id="p1z26"/>regionibus multum damni dederit.</s>
					<s n="13" xml:lang="la">Videas homines <lb xml:id="p1z27"/>attonitos rustico credere, videas ad illum locum frequentem <lb xml:id="p1z28"/>concursum, ligna, lapides, caementum comportari, quo <lb xml:id="p1z29"/>opus tam pium effectum habeat.</s>
					<s n="14" xml:lang="la">Et quod magis est, <lb xml:id="p1z30"/>narrant fratres, qui istinc veniunt, quandam <lb xml:id="p1z31"/>communitatem nomine This tis rustici verba interveniente <pb/><lb xml:id="p2z1"/>authoritate publica diplomata et sigillo a sam confirmare, <lb xml:id="p2z2"/>quo testimonio ille fretus pergat in vicinam <placeName ref="l862">Helvetiam</placeName> <lb xml:id="p2z3"/>cum illis quoque laetum hoc visum communicaturus.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z4"/>Narrant iidem fratres se vidisse literas a <placeName ref="l2805">Tribus Pagis</placeName> scriptas <lb xml:id="p2z5"/>ad <placeName ref="l2592">Superioris Foederis</placeName> homines, quibus eis exprobrant, quod <lb xml:id="p2z6"/>homines a se proscriptos contra foederis capita sustentent.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z7"/>Haec contra <persName ref="p293">Beccariam</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z8"/>Nova quaedam <placeName ref="l425">Roma</placeName> veniunt, quorum summam d. <persName>Philippus</persName> <lb xml:id="p2z9"/>ex <placeName ref="l834">Italico</placeName> Latinam fecit.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z10"/>Plura nunc non habeo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute">Salvum te cupiunt nostri <lb xml:id="p2z11"/>omnes.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="salute">Salutem ex me et coniuge mea dicito tuis omnibus <lb xml:id="p2z12"/>in primis, postea etiam clarissimis viris <lb xml:id="p2z13"/>mecoenatibus meis.</s>
					<s n="21" xml:lang="la" ana="farewell">Vale, pater in Christo reverende.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p2z14"/><placeName ref="l98">Curię</placeName> 20. novembris anno 1559.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p2z15"/><persName ref="p8009">Ioannes Fabricius</persName> <lb xml:id="p2z16"/>tui observantissimus.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro eruditione et <lb xml:id="p4z2"/>pietate excellenti d. <persName ref="p495">Heinrycho <lb xml:id="p4z3"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p4z4"/>antistiti vigilantissimo, <lb xml:id="p4z5"/>domino et patrono suo <lb xml:id="p4z6"/>semper observando.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>