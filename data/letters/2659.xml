	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p714">C[oelius] S[ecun<lb xml:id="p1z2"/>dus] C[urio]</persName> per Christum Iesum S. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Non potui <persName ref="p8101">Laelium</persName> nostrum doctoremque <lb xml:id="p1z3"/><persName>Martinum</persName>, optime <lb xml:id="p1z4"/><persName ref="p495">Bullingere</persName> frater, sine meis ad te literis dimittere, etsi nullas <lb xml:id="p1z5"/>tuas ipsi mihi attulerunt, quid dico attulerunt, <lb xml:id="p1z6"/>immo ne alius quidem quisquam iam biennium fere ullas <lb xml:id="p1z7"/>tuas mihi reddidit.</s>
					<s n="3" xml:lang="la">Scio te esse occupatum variis <lb xml:id="p1z8"/>et maximis, adeo etiam utilissimis negotiis; at di<lb xml:id="p1z9"/>ligentiam etiam novi tuam in scribendo, si quem <lb xml:id="p1z10"/>amore prosequeris, quam quidem sum et ipse <lb xml:id="p1z11"/>per multos annos expertus.</s>
					<s n="4" xml:lang="la">Dicamne me <lb xml:id="p1z12"/>non amari abs te?</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Haud equidem existimo t<lb xml:id="p1z13"/>e, nul<lb xml:id="p1z14"/>la insigni de caussa amare tam repente <lb xml:id="p1z15"/>desiisse.</s>
					<s n="6" xml:lang="la">Dicam te aut oblitum mei aut fastidire?</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>cum neminem unquam aut magis memorem <lb xml:id="p1z17"/>amicorum aut magis levem et suavem <lb xml:id="p1z18"/>quam te cognoverim?</s>
					<s n="8" xml:lang="la">Quid igitur dicam?</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/>linguas aliquid apud te perversas virulentasque <lb xml:id="p1z20"/>potuisse?</s>
					<s n="10" xml:lang="la">qui scias illam legem in amicitia esse, <lb xml:id="p1z21"/>ut ne criminibus aut inferendis delectetur amicus <lb xml:id="p1z22"/>aut credat oblatis, quae duo pertinent ad amicitiae <lb xml:id="p1z23"/>constantiam et perpetuitatem.</s>
					<s n="11" xml:lang="la">Cum igitur <lb xml:id="p1z24"/>nihil horum in te existimem, quam igitur caussam <lb xml:id="p1z25"/>esse putem, quamobrem, etiam a me amanter et <lb xml:id="p1z26"/>moderate provocatus, iam per tot temporum <lb xml:id="p1z27"/>intervalla ne unam quidem aut literam <lb xml:id="p1z28"/>scripseris aut verbo salutaveris?</s>
					<s n="12" xml:lang="la">Tuae erit <lb xml:id="p1z29"/>pietatis, bonitatis, humanitatis, addo etiam <lb xml:id="p1z30"/>benevolentiae scribere, quicquid illud est, ac <lb xml:id="p1z31"/>mihi, qui te ita amo et colo ut neminem magis, hunc scrupulum, qui nunc <lb xml:id="p1z32"/>me coquit et versat sub pectore fixus, eximere.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z33"/>cum tua sancta familia tota, uxore, liberis, <lb xml:id="p1z34"/>generis et propinquis.</s>
					<s n="14" xml:lang="la" ana="salute">Saluto meo nomine fra<lb xml:id="p1z35"/>tres istos eruditos et mihi certe charissimos.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z36"/>De nostris rebus a <persName ref="p8101">Lęlio</persName> audies.</s>
					<s n="16" xml:lang="la" ana="salute">Salutat <lb xml:id="p1z37"/>vos domus mea tota <lb xml:id="p1z38"/>in domino.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l28">Basileae</placeName> <lb xml:id="p1z39"/>19. iunii 1555.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z40"/>Ignosce meae scribendi <lb xml:id="p1z41"/>negligentiae, quae tibi nota est.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Henrycho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> [<lb xml:id="p2z4"/>ant]istiti vigilantissimo, <lb xml:id="p2z5"/>[domino et] fratri col<lb xml:id="p2z6"/>endissimo suo.</s>
					<s n="20" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
