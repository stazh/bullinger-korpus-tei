	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Laus <lb xml:id="p1z2"/>Deo!</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Salutem et pacem a Domino!</s>
					<s n="3" xml:lang="la">Literas tuas mense Junii datas, vir observande <lb xml:id="p1z4"/>et in Christo carissime, per <persName ref="p4747">Falcknerum</persName> nostris hic nundinis accepi, <lb xml:id="p1z5"/>habeoque tibi gratias maximas pro responsione tua ad libellum <persName ref="p8312">Cochleii</persName>, <lb xml:id="p1z6"/>qua me donasti: legi enim eandem mense <persName ref="p18538">Augusti</persName>, et me in vera <lb xml:id="p1z7"/>Domini nostri et Servatoris religione non modicum confirmavit: sed <lb xml:id="p1z8"/>etiam quam plurimum me tuae pietati devinctum arbitror, quod <lb xml:id="p1z9"/>me dignatus fueris admonere jam secundo in tuis proximis per <lb xml:id="p1z10"/>D. <persName ref="p4851">Froschoverum</persName> literis, ut ita mundo utar, ne quid amittam coelestium; <lb xml:id="p1z11"/>ut Dominum Deum ante omnia et super omnia diligam, et ne rebus <lb xml:id="p1z12"/>perituris, negotiationi et pecuniae, nimium immergar.</s>
					<s n="4" xml:lang="la">Nunc scio quod <lb xml:id="p1z13"/>caritas Christi in te maneat, quia praeceptum ejus servas, ut <lb xml:id="p1z14"/>decet bonum pastorem.</s>
					<s n="5" xml:lang="la">"Si frater tuus,” inquit Dominus, "in te pec<lb xml:id="p1z15"/>caverit,” etc.</s>
					<s n="6" xml:lang="la">Ne dubites, praeceptor dilecte, quin quo magis mei officii admoneas <lb xml:id="p1z16"/>negligentiaeve reprehendas, tanto pluris tui faciam et ex animo <lb xml:id="p1z17"/>diligam.</s>
					<s n="7" xml:lang="la">Fateor me variis forteque nimiis negotiationibus occupatum <lb xml:id="p1z18"/>esse; domo tamen praeterquam nundinis <placeName ref="l157">Francofordicnsibus</placeName> raro absum: <lb xml:id="p1z19"/>indeque est, quod rarius incumbo lectioni sacrae quam cupio, quia <lb xml:id="p1z20"/>famulum neminem habeo: omnia mea negotia fere solus facio, <lb xml:id="p1z21"/>maxime hic <placeName ref="l491">Argentinae</placeName>; semper etiam fere occupatus sum literis et <lb xml:id="p1z22"/>rationibus describendis, et hujusmodi rebus.</s>
					<s n="8" xml:lang="la">Proxima tamen hy<lb xml:id="p1z23"/>eme, divina gratia, totam bibliam sacram, quam mihi dedisti, <lb xml:id="p1z24"/>praeter novum testamentum, perlegi quanto potui studio.</s>
					<s n="9" xml:lang="la">Ex hac <lb xml:id="p1z25"/>sancta lectione, si nihil pluris, hunc autem fructum cepi, quod <lb xml:id="p1z26"/>cum prophetae secundum hanc vestram versionem deceptorem <lb xml:id="p1z27"/>aut impostorem denominare voluerunt, mercatorem eum vocabant.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z28"/>Hinc disco, sicuti tu etiam dicis, quod periculosa res est et lubrica mercatura, in qua <lb xml:id="p1z29"/>vocatione quam citissime labi possim: <lb xml:id="p1z30"/>u<lb xml:id="p1z31"/>tinam non saepissime lapsus essem!</s>
					<s n="11" xml:lang="la">Porro ex illa lectione poenit<lb xml:id="p1z32"/>entiam didici.</s>
					<s n="12" xml:lang="la">Tu, domine, juva me tuis orationibus sicut et <lb xml:id="p1z33"/>illis piissimis et crebris tuis tempestivis admonitionibus; quibus revera (uti <lb xml:id="p1z34"/>scribis) pro amici et fratris officio facis, proque salute mea invigilas: pro <lb xml:id="p1z35"/>hoc reddet tibi Deus mercedem in die illo!</s>
					<s n="13" xml:lang="de">Amen.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z36"/>Quod superest, libellum tuum, quem mihi proxime per dominum <lb xml:id="p1z37"/><persName ref="p4851">Froschoverum</persName> misisti, ab uxore hic post reditum meum accepi, et quam <lb xml:id="p1z38"/>cito mihi vacabit, Deo volente, perlegam.</s>
					<s n="15" xml:lang="la">Multas enim laudes <lb xml:id="p1z39"/>a nostratibus, qui evangelio favent, habet: Michael enim noster <lb xml:id="p1z40"/>(de <persName ref="p671">Milone Coverdalo</persName> loquor) <lb xml:id="p1z41"/>statim post meum ex <placeName ref="l830">Anglia</placeName> adventum in <lb xml:id="p1z42"/>has partes eum libellum <placeName ref="l830">Anglicum</placeName> fecit; ego tamen magis <lb xml:id="p1z43"/>delector lectione Latina.</s>
					<s n="16" xml:lang="la">Pro eo libello habeo tibi etiam <lb xml:id="p1z44"/>magnas gratias: sed doleo te mihi semper dona mittere, <lb xml:id="p1z45"/>cum hic nihil boni habeam, quod tuae caritati remittam.</s>
					<s n="17" xml:lang="la"><persName ref="p5231">Uxor</persName> <lb xml:id="p1z46"/>quoque mea habet tuae gratias (sicuti non dubito a <persName ref="p4747">Falck<lb xml:id="p1z47"/>nero</persName> audisti) pro vetere illo numismate, concordiae typo.</s>
					<s n="18" xml:lang="la">Nova <lb xml:id="p1z48"/>ex <placeName ref="l830">Anglia</placeName>, si quae sunt, multo melius referet tibi Joannes <lb xml:id="p1z49"/>noster, harum literarum lator, quam ego ea meo hoc barbar<lb xml:id="p1z50"/>issimo stylo et incongruo, ut vereor, describere tibi potero.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z51"/>Idem in hisce meis inclusis duodecim coronatos <placeName ref="l834">Italicos</placeName> pro <lb xml:id="p1z52"/>pauperibus exulibus afferet una secum.</s>
					<s n="20" xml:lang="la">Eosdem distribuas <lb xml:id="p1z53"/>precor adventante anno, prout occasionem habueris; et pro m<lb xml:id="p1z54"/>e ores Dominum, ut hanc oblationem parvam benigne res<lb xml:id="p1z55"/>piciat, utque nobis omnibus misereatur.</s>
					<s n="21" xml:lang="de">Amen.</s>
					<s n="22" xml:lang="la" ana="salute">Dominum <persName ref="p8171">Theodorum</persName>, <lb xml:id="p1z56"/>D. <persName ref="p8127">Pellicanum</persName>, D.<persName ref="p8412">Megandrum</persName>, ceterosque vestros tum pios <lb xml:id="p1z57"/>tum <lb xml:id="p1z58"/>doctissimos viros meo nomine salutare non dedignaberis.</s>
					<s n="23" xml:lang="la" ana="salute">Salutat <lb xml:id="p1z59"/>te mea <persName ref="p5231">uxor</persName> una cum <persName ref="p8051">conjuge</persName> tua piissima, cui <lb xml:id="p1z60"/>etiam meo nomine salutem dicas oro.</s>
					<s n="24" xml:lang="la">Et Dominus Jesus spes <lb xml:id="p1z61"/>nostra det tibi, ut ministerium tuum implere pergas usque <lb xml:id="p1z62"/>in finem; ut indo cum apparuerit ille, pastorum Princeps, deportes <lb xml:id="p1z63"/>immarcescibilem gloriae coronam.</s>
					<s n="25" xml:lang="de">Amen.</s>
					<s n="26" xml:lang="la"><placeName ref="l491">Argentinae</placeName>, 2<lb xml:id="p1z64"/>6 die Septembris, 1544.</s>
				</p>
				<p>
					<s n="27" xml:lang="la">Tuus in Domino, <persName ref="p1548">R. HILLES</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="28" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo ac pient<lb xml:id="p2z2"/>issimo theologo domino <persName ref="p495">Henrico <lb xml:id="p2z3"/>Bullingero</persName> <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae concion<lb xml:id="p2z5"/>atori primario, <lb xml:id="p2z6"/>mihigue imprimis observando, <lb xml:id="p2z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
