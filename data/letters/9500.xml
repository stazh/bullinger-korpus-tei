	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ego quidem distractus sum prorsus, ut <lb xml:id="p1z2"/>vix haec possim.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Quae aliunde accepi, his <lb xml:id="p1z3"/>inserui; fides sit apud te.</s>
					<s n="4" xml:lang="la">Ego, quod accip<lb xml:id="p1z4"/>io et sicut accipio, tibi communico; <foreign xml:lang="de">sye <lb xml:id="p1z5"/>alles alls war, alls möge.</foreign></s>
					<s n="5" xml:lang="la">Timetur bellum <lb xml:id="p1z6"/>ingruiturum propter <placeName ref="l471">Spiram</placeName> et <placeName ref="l569">Wormatiam</placeName>; <lb xml:id="p1z7"/>sed ita tecte et involute haec res ad me <lb xml:id="p1z8"/>scribitur, ut certum et apertum prodere nequeam<lb xml:id="p1z9"/>.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Dicitur <persName ref="p3753">Poloniae rex</persName> pedem ex itinere coepto referre in <placeName ref="l832">Galliam</placeName>, <lb xml:id="p1z11"/>quod pontifex magnam vim auri promittat, si non <lb xml:id="p1z12"/>abeat in <placeName ref="l2472">Poloniam</placeName>, et quod rex graviter morbo <lb xml:id="p1z13"/>loethali non sine veneni suspitione dicatur <lb xml:id="p1z14"/>laborare.</s>
					<s n="7" xml:lang="la">Practica est multiplex; sed deus <lb xml:id="p1z15"/>superabit haec omnia.</s>
					<s n="8" xml:lang="la">Nec ego haec pro certis <lb xml:id="p1z16"/>scribo, sed narrata narro.</s>
					<s n="9" xml:lang="la">Experior in <lb xml:id="p1z17"/>dies mentiendi summam esse licentiam.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Viri aliquot boni apud nos repentino et loe<lb xml:id="p1z19"/>thali capitis morbo correpti ad dominum mi<lb xml:id="p1z20"/>grarunt, et decumbunt etiam aliqui.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Imo iam <lb xml:id="p1z21"/>vocor ad d. <persName ref="p2242">Ioannem Mullerum</persName> senatorem, qui animam <lb xml:id="p1z22"/>agere dicitur.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Abrumpo ergo scriptum, quod festinanter <lb xml:id="p1z23"/>et ideo pessime exaravi.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Tu vale cum omnibus <lb xml:id="p1z24"/>nostris amicis et familia tua.</s>
					<s n="14" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 20. <lb xml:id="p1z25"/>novembris 1573.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="16" xml:lang="de"><pb/><lb xml:id="p2z1"/>Minem lieben herren <lb xml:id="p2z2"/>und guͦten fründt h. <lb xml:id="p2z3"/><persName ref="p8016">Thobia Egli</persName>, pfarreren <lb xml:id="p2z4"/>zuͦ S. Martin zuͦ <lb xml:id="p2z5"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
