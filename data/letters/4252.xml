			<zone xml:id="p2z3-0" points="2755,1884 3072,1860 3202,1902 3261,1871 3700,1852 3685,1785 3592,1825 3541,1788 3421,1819 3374,1788 2989,1842 2756,1791">2764,1862 2811,1859 2858,1856 2905,1859 2952,1855 2999,1853 3046,1852 3093,1849 3140,1847 3187,1846 3234,1844 3281,1844 3328,1844 3375,1844 3422,1844 3469,1844 3516,1846 3563,1847 3610,1847 3657,1847 3704,1844</zone>
		</surface>
