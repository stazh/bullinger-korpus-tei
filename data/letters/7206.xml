	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la">Magna sane lętitia affecti sumus, cum ex literis tuis, vir clarissime, intelleximus <lb xml:id="p1z2"/>te humanitate tua comprehensurum <persName>Gedeonem</persName>, filium piae memoriae domini <persName ref="p8359">Gallitii</persName>, qui <lb xml:id="p1z3"/>longo tempore fortissimo constantissimoque animo ac primis annis etiam cum vitae suae periculo <lb xml:id="p1z4"/>evangelium propagavit.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Haec nisi mihi constarent, pro filio eius tantopere laborare et tibi molestus <lb xml:id="p1z6"/>esse noluissem.</s>
					<s n="4" xml:lang="la">Non est autem, quod metuas, domine, si huic successerit, nos alios sub<lb xml:id="p1z7"/>missuros; satis erit nobis hunc voti compotem factum fuisse.</s>
					<s n="5" xml:lang="la">Haecque quod ad <persName>Ge<lb xml:id="p1z8"/>deonem</persName>.</s>
					<s n="6" xml:lang="la">Nova illa dd.</s>
					<s n="7" xml:lang="la">concionatoribus et amplissimo d. <persName ref="p3958">consuli Willio</persName>, d. item <lb xml:id="p1z9"/><persName ref="p1770">Carolo</persName> communicavi.</s>
					<s n="8" xml:lang="la">Nos omnes pro laboribus tuis habemus maximas gratias.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z10"/>D. <persName ref="p1770">Carolus</persName> promisit, quam primum aliquid certi de synodo illa habuerit, se tibi, <lb xml:id="p1z11"/>domine, communicaturum.</s>
					<s n="10" xml:lang="la">Quod mihi et filio adeo benigne operam <lb xml:id="p1z12"/>tuam polliceris, habemus maximas gratias et, si dominus vitam con<lb xml:id="p1z13"/>cesserit, non immemores et ingrati futuri.</s>
					<s n="11" xml:lang="la">D. d. <persName ref="p4037">Zanchius</persName> [re<lb xml:id="p1z14"/>]tulit mihi <persName ref="p8089">Lentulum</persName> illum sibi <placeName ref="l93">Clavenae</placeName> successisse; primo quoque [<lb xml:id="p1z15"/>ig]itur tempore illum literis meis admonebo debiti; nunc commode <lb xml:id="p1z16"/>satis facere poterit.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Amplissimus d. consul <persName ref="p3958">Willius</persName> necnon d. <lb xml:id="p1z17"/><persName ref="p1770">Carolinus</persName> amantissime humanitatem tuam resalutant.</s>
					<s n="13" xml:lang="la" ana="salute">Ex me <lb xml:id="p1z18"/>quoque dominum <persName ref="p1884">Ludovicum</persName>, filios tuos ac reliquos generos tuos, dominos meos <lb xml:id="p1z19"/>colendissimos, salutes velim.</s>
					<s n="14" xml:lang="la">Clementissimus dominus te nobis <lb xml:id="p1z20"/>diutissime incolumem conservet.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l98">Curiae Rhętorum</placeName> 25. augusti 1567<lb xml:id="p1z21"/>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><persName ref="p6130">Iohannes Pontisella</persName> <lb xml:id="p1z23"/>tui observantissimus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae anti<lb xml:id="p2z3"/>stiti, domino meo colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
