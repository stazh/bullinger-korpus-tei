	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Proximis tuis literis, d. <persName ref="p495">Bullingere</persName> observande, cum responderem, <lb xml:id="p1z2"/>decretum vestrum expectaturos pollicebar<note xml:id="fn1" type="footnote" n="1">Siehe oben <ref target="file11447">Nr. 1404</ref>, 9-11. - Die Rede ist außer von <persName ref="p3988">Wolf</persName> selbst auch von <persName ref="p8461">Wick</persName> und <persName ref="p8018">Haller</persName>.</note>.</s>
					<s n="2" xml:lang="la">Verum, quoniam quasi <lb xml:id="p1z3"/>certissimo<note xml:id="fna" type="footnote" n="a"><hi>korrigiert aus</hi> certissimam.</note> proficiscendi facultatem a vobis datum iri animis nostris <lb xml:id="p1z4"/>conceperamus, non potuimus cum temporis, tum vero maxime <lb xml:id="p1z5"/>itineris quam commodissimam oblatam occasionem praetermittere, ne <lb xml:id="p1z6"/>amissa illa frustra recuperandi tantum non assequendi copia <lb xml:id="p1z7"/>concederetur.</s>
					<s n="3" xml:lang="la">Proinde petitis et comparatis a d. rectore<note xml:id="fn2" type="footnote" n="2"><persName ref="p6943">Kaspar Volland</persName>; s. <placeName ref="l512">Tübingen</placeName>, Matrikel I 300.</note> et uni<lb xml:id="p1z8"/>versitat[e] scholae <placeName ref="l512">Thubingensis</placeName> [necessari]is[?] testimoniis<note xml:id="fnb" type="footnote" n="b">[necessari]is testimoniis <hi>am Rande nachgetragen,</hi> im engen Einband nur teilweise lesbar.</note><note xml:id="fn3" type="footnote" n="3">Nicht erhalten.</note><pb type="edition" next="167"/> una cum typographo<note xml:id="fn4" type="footnote" n="4">Gemeint ist gewiß der <placeName ref="l512">Tübinger</placeName> Buchdrucker <persName ref="p5871">Ulrich Morhart</persName>; s. <hi>Benzing,</hi> Buchdrucker 465.</note>, homine piissimo, <lb xml:id="p1z9"/><placeName ref="l157">Francfordiam</placeName> profecti sumus et illinc nunc <placeName ref="l311">Marpurgum</placeName>.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>Quare te et patronum et patrem seu sacram anchoram<note xml:id="fn5" type="footnote" n="5">Vgl. Adagia, 1, 1, 24 (<bibl source="b370">LB</bibl> II 35f).</note> <lb xml:id="p1z11"/>oratum quammaxime voluerim, ne id, quod factum est, indignius <lb xml:id="p1z12"/>feras, siquidem totum id factum est, ut aeris alieni obligationem <lb xml:id="p1z13"/>evitaremus, praesertim, quod ob nostri aeris tantam tenuitatem <lb xml:id="p1z14"/>diutius manere non licuisset.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell">Quin iam vale <lb xml:id="p1z15"/>et <persName ref="p3988">Wolffium</persName> tuum, quod soles, ama.</s>
					<s n="6" xml:lang="la"><placeName ref="l157">Francfordię</placeName>, raptim, 1540, 15. <lb xml:id="p1z16"/>septembris.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Salutabis matrem<note xml:id="fn6" type="footnote" n="6"><persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note>, uxorem<note xml:id="fn7" type="footnote" n="7"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note>, liberos<note xml:id="fn8" type="footnote" n="8">Siehe oben <ref target="file11387">Nr. 1344</ref>, Anm. 14.</note> <lb xml:id="p1z17"/>etc.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p3988">Iohan. Wolffius</persName> <lb xml:id="p1z19"/>tuus quam etc.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Cum docto tum integro <lb xml:id="p2z2"/>viro d. <persName ref="p495">Heinricho Bul<lb xml:id="p2z3"/>lingero</persName>, <placeName ref="l587">Tigurinę</placeName> ecclesię <lb xml:id="p2z4"/>episcopo vigilantissimo.</s>
				</p>
			</div>
