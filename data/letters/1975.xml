	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a deo patre per Christum servatorem precor tibi ex <lb xml:id="p1z2"/>animo, <persName ref="p495">Bullingere</persName> colendissime, gratiam interim agens pro mu<lb xml:id="p1z3"/>nusculo literario, quod mihi nuper donasti.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Utinam se aliquando <lb xml:id="p1z4"/>offerat occasio aut par referendi aut sane animi erga te mei be<lb xml:id="p1z5"/>nevolentiam promptissimam declarandi.</s>
					<s n="3" xml:lang="la">Cum tamen hucusque tuam <lb xml:id="p1z6"/>erga quosvis, praesertim erga Christi ecclesias et diligentiam et sollicitud<lb xml:id="p1z7"/>inem perspectam habeam, nactus oportunitatem, quicquid hoc <lb xml:id="p1z8"/>est oneris tibi imponere non erubui, licet infinitis negociis <lb xml:id="p1z9"/>tantum non obruto.</s>
					<s n="4" xml:lang="la">Igitur, frater charissime, <lb xml:id="p1z10"/>non dubito, quin certior sis <lb xml:id="p1z11"/>factus, quibus technis aposcopus ille <placeName ref="l257">Constantiensis</placeName> circumscripserit <lb xml:id="p1z12"/>eum, quem ecclesiae nostrae in <placeName ref="l3011">Buͦchberg</placeName> concionatorem declararat.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z13"/>Is cum ab amplissimo nostro senatu iustas quasdam ob causas non admissus <lb xml:id="p1z14"/>esset alterque in locum eius per ipsum oeconomo in <placeName>Oeningen</placeName> <lb xml:id="p1z15"/>praesentatus esset per <persName ref="p8421">L[udovi<lb xml:id="p1z16"/>cum] Bovillum</persName>, tres expunxit, in reliquos consenti<lb xml:id="p1z17"/>ens, cumque nos huius certiores fecisset, nos indigne ferre, quod <lb xml:id="p1z18"/>ministris Christi ecclesiarum ab antichristi satellitibus praescriberetur non si<lb xml:id="p1z19"/>ne gravi ecclesiarum damno.</s>
					<s n="6" xml:lang="la">Igitur consulem adeuntes per ipsum admonemus <lb xml:id="p1z20"/>senatum periculi imminentis.</s>
					<s n="7" xml:lang="la">Senatus iam consenserat in ea, <lb xml:id="p1z21"/>qua <persName ref="p8421">Bovillus</persName> proposuerat; non tamen decretum manifestatum erat oeconomo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z22"/>Mutant decretum; decernitur, ut primis <placeName ref="l21">Badensium</placeName> comitiis <lb xml:id="p1z23"/>a legatis vestrae et <placeName ref="l41">Bernensium</placeName> reipublicae quaeratur, quomodo ipsi <lb xml:id="p1z24"/>se huiuscemodi in rebus gerant, ut et ipsi in posterum cautius et liberi<lb xml:id="p1z25"/>us erga huiusmodi papistas agere queant.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Ego te rogatum velim, <lb xml:id="p1z26"/>ut, si tantum fuerit otii, nos per literas Germanice scriptas eius <lb xml:id="p1z27"/>usus, quem apud vos habetis, certiores facias.</s>
					<s n="10" xml:lang="la">Superest adhuc unum, <lb xml:id="p1z28"/>quod a te peto, ut mihi declares, quomodo utamini manuum impositi<lb xml:id="p1z29"/>one et per quos, deinde quid potissimum pro concione tractetis.</s>
					<s n="11" xml:lang="la">Mihi <lb xml:id="p1z30"/>enim hoc iniunctum est oneris, bovi sane clitellae.</s>
					<s n="12" xml:lang="la">Igitur malo hac in <lb xml:id="p1z31"/>re vestro uti exemplo quam propriam declarare impudentiam.</s>
					<s n="13" xml:lang="la">Novi <lb xml:id="p1z32"/>enim, quibus prae cęteris dotati sitis a spiritu d[omini] donis, quae non dubito <lb xml:id="p1z33"/>te pro tua in nos humanitate libenter nobis communicaturum.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z34"/>Nova, quae habeo, nuper ad me scripsit d. <persName ref="p3099">Sultzerus</persName>; haec <lb xml:id="p1z35"/>sic se habent: <placeName ref="l1031">Svinfurtum</placeName> ab <placeName ref="l1030">Herbipolense</placeName> et <placeName ref="l1703">Bambergense</placeName> episcopis obsidetur, <lb xml:id="p1z36"/><placeName>Blasemberg</placeName>, arx <persName>Alberti</persName>, a <placeName ref="l361">Norimbergensibus</placeName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l1041">Brunsvicensi<lb xml:id="p1z37"/>bus</placeName> et <placeName ref="l205">Hannober</placeName> indixit bellum <persName ref="p20318">Heinricus Brunsvicensis</persName>, senex <lb xml:id="p1z38"/>orbus tantum non delyrus et furiosus, propterea, quod <persName>Alberto</persName> sese coniunxissent.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z39"/>Sed augentur et reparantur etiam <persName>Alberti</persName> copiae.</s>
					<s n="17" xml:lang="la"><persName>Augustus</persName>, <persName ref="p18250">Mauricii</persName> frater, <lb xml:id="p1z40"/>defunctus dicitur rediens ex <placeName ref="l825">Dania</placeName>; verum id tum demum credam, cum certio<lb xml:id="p1z41"/>ra accepero, utcunque hoc ipsum constans fama ferat, sicut et de <persName>Ma<lb xml:id="p1z42"/>ximiliano</persName>, <persName>Boemiae rege</persName>, quem pro certo affirmant quidam evangelio <lb xml:id="p1z43"/>locum in eo regno fecisse et ex <placeName ref="l749">Saxonia</placeName> ministros adminus <lb xml:id="p1z44"/>70 submissos, qui doctrinam Christi administrent; sed metuo, n<lb xml:id="p1z45"/>e et hoc ipsum minus verum sit.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z46"/>De <placeName ref="l830">Anglia</placeName> scripsit etiam quaedam, <lb xml:id="p1z47"/>quibus longe certiora tibi significata esse non dubito.</s>
					<s n="19" xml:lang="la"><persName ref="p3964">Ioannis Winzürn</persName> <lb xml:id="p1z48"/>monachalis impudentia tandem magno cum ecclesiae et ministrorum <lb xml:id="p1z49"/>scandalo erupit.</s>
					<s n="20" xml:lang="la">Dominus tribuat ipsi veram paenitentiam, cuius adhuc <lb xml:id="p1z50"/>penitus nullam dedit significationem.</s>
					<s n="21" xml:lang="la" ana="salute">D. <persName ref="p8171">Theodoro</persName>, d. <persName ref="p8127">Pellicano</persName>, d. <persName ref="p8011">Gvalthero</persName> <lb xml:id="p1z51"/>plurimam ex me salutem dicito.</s>
					<s n="22" xml:lang="la" ana="salute">Salutant te <persName ref="p1309">Grübelius</persName> et <persName ref="p2757">Rügerus</persName>.</s>
					<s n="23" xml:lang="la" ana="farewell"><lb xml:id="p1z52"/>Vale in Christo.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Raptim.</s>
					<s n="25" xml:lang="la"><placeName ref="l441">Scaffusii</placeName> 3. kalendas septembris <lb xml:id="p1z53"/>anno 1553.</s>
					<s n="26" xml:lang="la"><lb xml:id="p1z54"/>Tuus ex animo <lb xml:id="p1z55"/><persName ref="p3481">Simpertus Vogtius</persName>.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pro re nostra futurum censerem, ut ii, qui ecclesiis nostratibus sufficerentur <lb xml:id="p2z2"/>parochi, eadem iurisiurandi formula ligarentur, <lb xml:id="p2z3"/>qua vos utimini, nec dubito, quin ea si commode senatui <lb xml:id="p2z4"/>nostro proponatur, libens eam sit amplexurus.</s>
					<s n="28" xml:lang="la">Audio eam isthi<lb xml:id="p2z5"/>c <lb xml:id="p2z6"/>efflagitari coram universa synodo.</s>
					<s n="29" xml:lang="la"><lb xml:id="p2z7"/>Igitur te oratum velim, <lb xml:id="p2z8"/>ut una mitteres eius iuramenti capita, ut et certe et <lb xml:id="p2z9"/>commode ea possimus proponere magistratui nostro.</s>
					<s n="30" xml:lang="la" ana="farewell">Rursus <lb xml:id="p2z10"/>vale.</s>
				</p>
				<p>
					<s n="31" xml:lang="la"><lb xml:id="p2z11"/>Pietate et doctrina eximio <lb xml:id="p2z12"/>viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z13"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z14"/>antistiti, d. suo <lb xml:id="p2z15"/>observando.</s>
				</p>
				<p>
					<s n="32" xml:lang="de"><lb xml:id="p2z16"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
