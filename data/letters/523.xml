	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z4"/>S.</s>
					<s n="2" xml:lang="la">Quam iucunda mihi fuit praeteritorum <lb xml:id="p1z5"/>dierum conventiculum illud litteratorum fratrum, <lb xml:id="p1z6"/>qui me salutabatis <placeName ref="l587">Tiguri</placeName>, tam avide expecto <lb xml:id="p1z7"/>senatus vestri de emptione mea decretum.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z8"/>Quare non potui intermittere, quominus te, <lb xml:id="p1z9"/>per quem certiorem me volebant efficere consules <lb xml:id="p1z10"/>vestri, admonerem, ut, quoad eius fieri queat, <lb xml:id="p1z11"/>tempestive resciscam de voluntate senatus.</s>
					<s n="4" xml:lang="la">Ac<lb xml:id="p1z12"/>cedit enim hoc etiam negocii desyderio meo; <lb xml:id="p1z13"/>postquam enim in <placeName ref="l774">Turgoiam</placeName> revenissem, offendi lit<lb xml:id="p1z14"/>teras, quibus me baro <persName ref="p20184">Bolvilerus</persName>, praefectu<lb xml:id="p1z15"/>s regius, ad 18. mensis diem vult in urbe comparere <lb xml:id="p1z16"/>per vicarium procuratorem, qui percipiat regis <lb xml:id="p1z17"/>de proscriptione bonorum meorum sententiam.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z18"/>Quamobrem proposito meo consultum erat, si <lb xml:id="p1z19"/>ante hunc diem certus esset mihi aliquis resi<lb xml:id="p1z20"/>dendi locus, quem possem prętexere (si quę sunt) <lb xml:id="p1z21"/>adversis sententiae meę consiliis.</s>
					<s n="6" xml:lang="la">Nolo tamen, <lb xml:id="p1z22"/>sanctissime <persName ref="p495">Bullingere</persName>, importunius quicquam <lb xml:id="p1z23"/>solicites, tantum imperato responso id ut celeriter <lb xml:id="p1z24"/>accipiam vel oblato aliquo vel certo conducto nuncio <lb xml:id="p1z25"/>contende.</s>
					<s n="7" xml:lang="la">Me non oportebat hoc genus officiis te <lb xml:id="p1z26"/>adhibere, quem distineri scio occupationibus <lb xml:id="p1z27"/>sanctissimae provincię tuę docendi lucubran<lb xml:id="p1z28"/>dique, sed in amicorum gratiam recipi solent <lb xml:id="p1z29"/>vel alienę curę et saepenumero leviores, atque hic amicorum <lb xml:id="p1z30"/>valet temeritas inepta petentium.</s>
					<s n="8" xml:lang="la">Tal<lb xml:id="p1z31"/>e es<pb/><lb xml:id="p2z1"/>t et<lb xml:id="p2z2"/>ia<lb xml:id="p2z3"/>m, quo<lb xml:id="p2z4"/>d nunc <lb xml:id="p2z5"/>petam, <lb xml:id="p2z6"/>uti ne dedi<lb xml:id="p2z7"/>gner<lb xml:id="p2z8"/>i<lb xml:id="p2z9"/>s <lb xml:id="p2z10"/>co<lb xml:id="p2z11"/>n<lb xml:id="p2z14"/>so.<lb xml:id="p2z15"/>..</s>
				</p>
			</div>
		</body>
	</text>
