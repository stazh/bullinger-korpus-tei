	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Exactis feriarum laboribus scribendi intercapedinem <lb xml:id="p1z2"/>literarum crebritate sarcire quidem debebam; <lb xml:id="p1z3"/>sed spero pacis compositionem tam esse certam et <lb xml:id="p1z4"/>veram, ut multum occasionis ad scribendum sit <lb xml:id="p1z5"/>nobis detractura.</s>
					<s n="3" xml:lang="la">Quod ut ita siet, faxit deus optimus <lb xml:id="p1z6"/>maximus.</s>
					<s n="4" xml:lang="la">Libellos tuos, colendissime domine, accepi magno <lb xml:id="p1z7"/>cum gaudio eosque nunc evolvo et in meum succum <lb xml:id="p1z8"/>converto, simul etiam ipsius <persName ref="p8441">Schvencfeldii</persName> opuscula <lb xml:id="p1z9"/>quaedam ab ipso bibliopola<note xml:id="fn1" type="footnote" n="1">Frell</note> nostro sunt impetrata, <lb xml:id="p1z10"/>ex quorum collatione, quicquid inerit veneni, per<lb xml:id="p1z11"/>sentiscam et, quamprimum fieri potest, tuto remittam.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z12"/>Homines fide digni pacis articulos ita proferunt: <lb xml:id="p1z13"/>1. religionem in toto regno liberam esse; 2. <persName>Condensi</persName> <lb xml:id="p1z14"/>7 urbes praeclaras traditas; 3. 18000 viros a rege <lb xml:id="p1z15"/>ipsi <persName>Condensi</persName> alendos, donec rex adoleverit.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z16"/>Ad hanc vero servilem conditionem regios esse adactos <lb xml:id="p1z17"/>maxime etiam ex strenuitate ducis <persName>Wilhelmi Saxoniae</persName>, <lb xml:id="p1z18"/>qui in regis auxilium venerit, comperta autem <lb xml:id="p1z19"/>vera belli causa reflexerit et facta protestatione <lb xml:id="p1z20"/>se nolle professioni suae esse iniurius regi ipse con<lb xml:id="p1z21"/>suluerit, ut conditiones, qualesquales sese <lb xml:id="p1z22"/>offer[r]ent, a <placeName>Condensi</placeName> acciperet.</s>
					<s n="7" xml:lang="la">- Ex <placeName ref="l834">Italia</placeName> nihil <lb xml:id="p1z23"/>certi.</s>
					<s n="8" xml:lang="la">Festinat <persName ref="p4226">Baderus</persName> noster.</s>
					<s n="9" xml:lang="la">Comes <persName>Han[<lb xml:id="p1z24"/>n]ibal</persName> hodie per praesidem Dietägium pro<lb xml:id="p1z25"/>cessum negocii et causae <persName>Ascanii</persName> a magistra<lb xml:id="p1z26"/>tu nostro eblandiri conatur.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Quid effecerit, <lb xml:id="p1z27"/>nondum scio; petiit tamen nomine vici[ni]tatis <lb xml:id="p1z28"/>etc.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Valete.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Ocyus <placeName ref="l98">Curiae</placeName> 1568. 21. aprilis.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z29"/>Salutant te omnes nostr<lb xml:id="p1z30"/>i<lb xml:id="p1z31"/>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z32"/>Tuae dignitatis <lb xml:id="p1z33"/>subiectissimus <persName ref="p8016">Th[obias] <lb xml:id="p1z34"/>Eg[lius</persName>].</s>
				</p>
				<p>
					<s n="15" xml:lang="la">D. <persName ref="p8018">Hallero</persName> scribam <lb xml:id="p1z35"/>alias; nunc vix haec <lb xml:id="p1z36"/>potui suffurari.</s>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Amplissimo viro d. m. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> antistiti <lb xml:id="p2z4"/>primario, d. suo <lb xml:id="p2z5"/>clementissimo et aeternum obse<lb xml:id="p2z6"/>rvando.</s>
					<s n="17" xml:lang="de"><placeName ref="l587">Z[ürich]</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
