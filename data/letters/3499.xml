	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Brevior sum; vivam habes epistolam.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Sed <lb xml:id="p1z2"/>de iis, de quibus illum non admonui et quae nescit <lb xml:id="p1z3"/>ille, paucis respondeo.</s>
					<s n="4" xml:lang="la">Amica compositio con<lb xml:id="p1z4"/>troversiae vestrorum et abbatis omnino probanda.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Si nostri, ut scripsi, interpellantur, sponte et diligenter <lb xml:id="p1z6"/>suam operam conferent.</s>
					<s n="6" xml:lang="la">De reformatione <lb xml:id="p1z7"/>episcopi et totius collegii diu et multum contuli cum d. <persName>F(riderycho)</persName>, <lb xml:id="p1z8"/>ac ostendit is mihi graves casus et difficultates <lb xml:id="p1z9"/>maximas.</s>
					<s n="7" xml:lang="la">Convenit tamen utrinque non <lb xml:id="p1z10"/>desperandum in re optima.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Pollicetur ille omnem <lb xml:id="p1z11"/>operam; ego meam negare qui potui, qui prior <lb xml:id="p1z12"/>ipsum ea de re compellavi?</s>
					<s n="9" xml:lang="la">Sed audi: laborem <lb xml:id="p1z13"/>mihi alioqui laboribus oppresso imposui; pollici<lb xml:id="p1z14"/>tus sum enim me scripturum de reformatione <lb xml:id="p1z15"/>in universum, quomodo tentari possit, quid <lb xml:id="p1z16"/>dandum utrinque etc.</s>
					<s n="10" xml:lang="la">Praestabo autem hoc primo <lb xml:id="p1z17"/>quoque tempore; scio enim in his moram esse <lb xml:id="p1z18"/>periculis refertam.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/>Scripta, quae communicavi, <lb xml:id="p1z20"/>omnia recepi.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Caleti occupati historiam <lb xml:id="p1z21"/>si nancisci queas, oro, communices; n<lb xml:id="p1z22"/>ihil perinde desidero; aiunt typis excusam, <lb xml:id="p1z23"/>sed ad me nihildum pervenit.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Anicula <lb xml:id="p1z24"/>illa, quam mihi commendas et quae praetoris <placeName ref="l2619">Me<lb xml:id="p1z25"/>llingensis</placeName> soror est, mihi sanguine iuncta est; recte <lb xml:id="p1z26"/>dixit matrem eius fuisse <persName ref="p495">Bullingeram</persName>.</s>
					<s n="14" xml:lang="la">Misera <lb xml:id="p1z27"/>est prorsus, nupta diabolo potius quam marito, <lb xml:id="p1z28"/>ac mirum est illam vivere potuisse apud <lb xml:id="p1z29"/>feram illam et rabiosam beluam; sed habet is <lb xml:id="p1z30"/>suum iudicem.</s>
					<s n="15" xml:lang="la">Nunc cum ancilla agit in <lb xml:id="p1z31"/>meis aedibus concessura post dies aliquot ad fratrem <lb xml:id="p1z32"/>cum commendatitiis meis.</s>
					<s n="16" xml:lang="la">Praedicat tua <lb xml:id="p1z33"/>in ipsam beneficia collata, pro quibus tibi gratias <lb xml:id="p1z34"/>ago.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Vive et vale una cum d. d. consulibus, <persName ref="p6130">Ponti<lb xml:id="p1z35"/>sella</persName> et aliis amicis et fratribus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">Salutant te <lb xml:id="p1z36"/>mei omnes.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 6. februarii 1558.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z37"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Praes<pb/><lb xml:id="p2z1"/>tantissimo <lb xml:id="p2z2"/>viro d. <persName ref="p8009">Ioan<lb xml:id="p2z3"/>ni Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z4"/>ecclesiae <lb xml:id="p2z5"/>ministro, compatr<lb xml:id="p2z6"/>i <lb xml:id="p2z7"/>et fratri meo charissimo.</s>
					<s n="22" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
