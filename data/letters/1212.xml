	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime vir, salvus sis.</s>
					<s n="2" xml:lang="la">Cogor differre adven<lb xml:id="p1z2"/>tum meum ad vos post pascha.</s>
					<s n="3" xml:lang="la">Sunt enim <lb xml:id="p1z3"/>multae et graves causae, quae me retinent <lb xml:id="p1z4"/>implicitum; at possum me ex<lb xml:id="p1z5"/>plicare hisce tribus septimanis.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Communicabit tibi d. <persName ref="p8011">Gvalterus</persName> alias me<lb xml:id="p1z7"/>as literas, et intelliges, quid ad aures <lb xml:id="p1z8"/>meas de <placeName ref="l830">Angliae</placeName> negotio pervenerit; <lb xml:id="p1z9"/>illud tu coepisti atque potes perficere.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Quod ut sedulo facias, te etiam atque <lb xml:id="p1z11"/>etiam rogo; agitur enim Christi causa, <lb xml:id="p1z12"/>quae tibi tantopere cordi est.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Fidum nuntium modo non habeo, <lb xml:id="p1z14"/>qui pecuniam ad meum nepotem <lb xml:id="p1z15"/>deferat, quem scio interim egere.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/>Quamobrem te vehementer rogatum <lb xml:id="p1z17"/>velim, ut vel mittas ad eum vel <lb xml:id="p1z18"/>alicui amico <placeName ref="l28">Basiliensi</placeName> scribas, ut <lb xml:id="p1z19"/>ei numeret decem florenos, quos tibi <lb xml:id="p1z20"/>confestim reddam.</s>
					<s n="8" xml:lang="la">Crede homini <lb xml:id="p1z21"/>christiano et experire eius fidem.</s>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z22"/>Vale in domino; roga pro nobis cum tota <lb xml:id="p1z23"/>ecclesia.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l525">Vicosoprani</placeName>, 12. martii 1551.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Cla<pb/><lb xml:id="p2z1"/>rissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">H[enr<lb xml:id="p2z3"/>ico] Bullingero</persName>, <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
