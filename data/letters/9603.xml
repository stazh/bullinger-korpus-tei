	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>non sine grave dolore trenerande vir atque optime
					<lb xml:id="p1z2"/>amplissimum tenarum vestrum admonere aogrr de novi
					<lb xml:id="p1z3"/>Gall motibus su quid praeterea accepero, non vos elat
					<lb xml:id="p1z4"/>ne forte aliunde a melevolis deterioru nuncientur.
					<lb xml:id="p1z5"/>scio enim veobis ex animo nostras dolere calamittes
					<lb xml:id="p1z6"/>faxit deus, ut feliciora liceat, quod utique non
					<lb xml:id="p1z7"/>despero. Nonnunquam enim ficati in morbis, ita et
					<lb xml:id="p1z8"/>in dutensionibus cum publicis tum privatis usu veni
					<lb xml:id="p1z9"/>ut cum detinere volunt, maximi metus fiant atque e
					<lb xml:id="p1z10"/>mal iudicatio atque finmi esse coleat.
					<lb xml:id="p1z11"/>Accepi literas tuas cum oratione Luciana sytum
					<lb xml:id="p1z12"/>agnoscere mihi videor, porsumque tibi scriptorem
					<lb xml:id="p1z13"/>nec non affirmare. Rome eam factam cee
					<lb xml:id="p1z14"/>suominus mecum videis debet, si quid mut non patus
					<lb xml:id="p1z15"/>accommodatum ad mores atque instituta. Populi Helvetis
					<lb xml:id="p1z16"/>Non soli in Gallia laboramu; nam et in Belgica
					<lb xml:id="p1z17"/>HHiopanus.
					<lb xml:id="p1z18"/>l fere experitur fortuna. Non dubito te sampu
					<lb xml:id="p1z19"/>accepisse Wuldeburgum domin radem deditione
					<lb xml:id="p1z20"/>in potestatem iuraies venise simulque admiltum
					<lb xml:id="p1z21"/>usque aureorum meriues illic inctas este, proquibus
					<lb xml:id="p1z22"/>u qui st Anticiuia pam puagota
					<lb xml:id="p1z23"/>offecitur t parum abfuit, quin ara et psius satucii
					<lb xml:id="p1z24"/>capta fuerit
					<lb xml:id="p1z25"/>preditione ninullos Hispanius prodet spuri
					<lb xml:id="p1z26"/>decem cupi fane petrb capi siputatu slneter
					<lb xml:id="p1z27"/>mltu falist n licis prodetrines prasiu apuur
					<pb/>
					<lb xml:id="p2z1"/>adeo ut novum prorex, quo te verent immiliter.
					<lb xml:id="p2z2"/>neccuit imprestione maxime facunte, alia ex perte i
					<lb xml:id="p2z3"/>Christoporo et comiteludovico, quos citeriore
					<lb xml:id="p2z4"/>urbis mastricę partem ium cepisse iumir
					<lb xml:id="p2z5"/>tsed evumirem videtur. Alia exo parte
					<lb xml:id="p2z6"/>mnciat Turcam ingentem nam confecit
					<lb xml:id="p2z7"/>renctorus desperantes de pace mura ad bellum
					<lb xml:id="p2z8"/>rogi. Hęc omnia miteribilia sunt maxime
					<lb xml:id="p2z9"/>calamitoram, qeus optimus maximus ne
					<lb xml:id="p2z10"/>ropiano relit, que etiqum oro et felicit
					<lb xml:id="p2z11"/>atque propecos tibi vir optimus proreget
					<lb xml:id="p2z12"/>Patum foleduru vos mensus martii
					<lb xml:id="p2z13"/>Mrxius.
					<lb xml:id="p2z14"/>Tu amatissimus.
					<lb xml:id="p2z15"/>elra.
					<pb/>
					<lb xml:id="p4z1"/>Venerando viro atque
					<lb xml:id="p4z2"/>optimo d omnio Henrico
					<lb xml:id="p4z3"/>Bulingero, ecclesiastę
					<lb xml:id="p4z4"/>Tigurinę.
				</p>
