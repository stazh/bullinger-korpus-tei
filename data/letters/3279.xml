	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Centenę literę non sufficerent ad scribendas <lb xml:id="p1z2"/>portentosas et inauditas rerum difficultates; <lb xml:id="p1z3"/>sed simul presentia et abitus tabellarii non <lb xml:id="p1z4"/>admisit plura.</s>
					<s n="2" xml:lang="la">Sufficiat tibi hoc unum, quo <lb xml:id="p1z5"/>insignis calamitas auguranda est, que nobis et <lb xml:id="p1z6"/>vobis impendet.</s>
					<s n="3" xml:lang="la"><persName ref="p8112">Rex Gallię</persName> vel prorex contestabilis <lb xml:id="p1z7"/><persName>S. Quintinum</persName> novo presidio et commeatu munire <lb xml:id="p1z8"/>voluit.</s>
					<s n="4" xml:lang="la"><persName ref="p18554">Regis Anglię</persName> exercitus hoc in tempore rescivit, <lb xml:id="p1z9"/>abiturientes a Quintino vulneribus adfectos prostravit <lb xml:id="p1z10"/>ita ut aliquot milia peditum et equitum <persName>Gallici</persName> <lb xml:id="p1z11"/>exercitus sint extincta.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Contestabilis, comes a <placeName>Rheno</placeName>, <lb xml:id="p1z12"/><placeName>Rokgrad</placeName> et plerique ex maxima <placeName>Gallicarum</placeName> <lb xml:id="p1z13"/>familiarum nobilitate sint vel <lb xml:id="p1z14"/>capti vel interempti.</s>
					<s n="6" xml:lang="la">Tria millia peditum <lb xml:id="p1z15"/><placeName ref="l822">Germanicorum</placeName> capta et ea lege dimissa, <lb xml:id="p1z16"/>ut nunquam se sinant adversus <placeName>Austriacam</placeName> <lb xml:id="p1z17"/>domum conduci.</s>
					<s n="7" xml:lang="la">Pfaffi erigunt cristas, non ideo <lb xml:id="p1z18"/>quod <persName>Gallus</persName> evangelio faveat, sed quod fractis <lb xml:id="p1z19"/>illius viribus <persName>Anglus</persName> commodius papatum <lb xml:id="p1z20"/>defendere possit.</s>
					<s n="8" xml:lang="la"><persName>Polwilerus</persName> animosior <lb xml:id="p1z21"/>factus sua aget; <placeName>Germania</placeName> sentiet denuo, <lb xml:id="p1z22"/>quid sit futurm ex hac strage.</s>
					<s n="9" xml:lang="la">Hac <lb xml:id="p1z23"/>calamitate fiet, ut pleraque emergant clandestina <lb xml:id="p1z25"/>facinora, que hactenus latuerunt abscondita.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z26"/>Nostra unica salus fuit ex hoc, quod Gallus <lb xml:id="p1z27"/><placeName ref="l875">Hispanos</placeName> et <placeName ref="l875">Hispani</placeName> <placeName ref="l832">Gallos</placeName> a proposito <lb xml:id="p1z28"/>retraxerunt.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Ocyssime 20. augusti anno 57.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z29"/><persName ref="p2856">G[ereon]</persName> t[u<lb xml:id="p1z30"/>us].</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Equites, quos nigros vocant, <lb xml:id="p1z31"/>sub <persName>Ernesto Brunsvicensi</persName> <lb xml:id="p1z32"/>et <persName ref="p18716">Ericho Brunsvicensi</persName> militantes potissimam huius <lb xml:id="p1z33"/>victorię partem obtinent.</s>
					<s n="15" xml:lang="la">D. <pb/><lb xml:id="p2z1"/><persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z2"/>viro doctissimo et <lb xml:id="p2z3"/>pientissimo, domino <lb xml:id="p2z4"/>et fratri charissimo.</s>
					<s n="16" xml:lang="de">Z(ü)rch.</s>
				</p>
			</div>
		</body>
