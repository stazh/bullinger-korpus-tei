	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nudius tertius per <placeName ref="l2472">Polonum</placeName> illum pauculis, <lb xml:id="p1z2"/>ne vacuus ad te veniret, scripsi; fortas<lb xml:id="p1z3"/>sis non rediit ad te.</s>
					<s n="3" xml:lang="la">Quid cum ipso factum <lb xml:id="p1z4"/>sit, paucis accipe:</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Toties peregrini turpiter <lb xml:id="p1z5"/>et enormiter imposuerunt nobis, ut non habeant <lb xml:id="p1z6"/>favorem, nisi probe cogniti.</s>
					<s n="5" xml:lang="la">Praeterea <lb xml:id="p1z7"/>magna est nobis (deo sit laus) copia studiosorum <lb xml:id="p1z8"/>et ministrorum, ut nihil necesse sit <lb xml:id="p1z9"/>peregrinos asciscere nostris e gradu deiectis.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Quod beneficentiam attinet, malunt nostri hanc <lb xml:id="p1z11"/>erga suos exercere, quos noverunt, quam <lb xml:id="p1z12"/>erga alienos, praesertim cum tantae nobis ope<lb xml:id="p1z13"/>s non suppetant, ut possimus nostris omnibus <lb xml:id="p1z14"/>succurrere.</s>
					<s n="7" xml:lang="la">Dati ergo sunt illi duo aurei, et <lb xml:id="p1z15"/>dimissus est.</s>
					<s n="8" xml:lang="la">Ingens est nobis pauperum turba; <lb xml:id="p1z16"/>non puto intra 40 annos tantam fuisse calamitatem<lb xml:id="p1z17"/>.</s>
					<s n="9" xml:lang="la">Peiora metuimus, quia nullus est <lb xml:id="p1z18"/>apud quosdam perpotandi modus; scientes <lb xml:id="p1z19"/>et volentes multi luxu intereunt.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Sed <lb xml:id="p1z20"/>hoc iam ubilibet terrarum omnibus quasi <lb xml:id="p1z21"/>vulgare est.</s>
					<s n="11" xml:lang="la">Expecto, quae remittenda <lb xml:id="p1z22"/>esse novisti, frater.</s>
					<s n="12" xml:lang="la">De <persName ref="p2463">Henrycho Pantaleon<lb xml:id="p1z23"/>e</persName> quid dicam?</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Annumeravit optimum virum <lb xml:id="p1z24"/>d. <persName ref="p8435">Christophorum Schoppelerum</persName>, verbi dei apud <placeName ref="l473">San<lb xml:id="p1z25"/>gallenses</placeName> ministrum pessimis reipublicae pertur<lb xml:id="p1z26"/>batoribus <persName ref="p5927">Münzero</persName> et <persName ref="p20920">Storkio</persName> ac impegit <lb xml:id="p1z27"/>illi horrenda, sed falsissima, id quod in<lb xml:id="p1z28"/>dignissime fert optimus quisque in ecclesia illa.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z29"/>Sed spero d. <persName ref="p8171">Bibliandrum</persName> hoc incendii feliciter <lb xml:id="p1z30"/>consopire posse.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Valde improbo imprudentiam <lb xml:id="p1z31"/>et incogitantiam iuniorum quorundam.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z32"/>Praeterea indignum est ecclesiae Helveticae <lb xml:id="p1z33"/>ministrum accusare rei tantae alium eiusdem <lb xml:id="p1z34"/>ecclesiae ministrum.</s>
					<s n="17" xml:lang="de">Wenn einer nitt wüste, wer <lb xml:id="p1z35"/>die lüt werend, so solt et vragen oder schwygen.</s>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vir est senex doctus et pius; interfuit etiam primis <lb xml:id="p2z2"/><placeName ref="l587">Tigurinae</placeName> ecclesiae disputationibus; semper <lb xml:id="p2z3"/>fidelis fuit domino et ecclesiae nec quicquam negotii <lb xml:id="p2z4"/>habuit cum seditiosis.</s>
					<s n="19" xml:lang="la">Iam vero illam gratiam <lb xml:id="p2z5"/>refert a <persName ref="p2463">Pantaleone</persName>, ut libro in <placeName ref="l862">Helvetia</placeName> <lb xml:id="p2z6"/>impresso Helveticae ecclesiae minister proscindatur.</s>
					<s n="20" xml:lang="la"><lb xml:id="p2z7"/>Certe Dares Entellum, ni viri boni <lb xml:id="p2z8"/>incendium restinguere satagerent.</s>
					<s n="21" xml:lang="la">Valde irascitur <lb xml:id="p2z9"/>indignissimae rei d. d. <persName ref="p8049">Vadianus</persName>; verum <lb xml:id="p2z10"/>nos, quantum possumus, sedamus motus illos.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="farewell">Vale aeternum.</s>
					<s n="23" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 24. <lb xml:id="p2z11"/>octobris anno 1550.</s>
					<s n="24" xml:lang="la"><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Clarissimo viro d. <persName ref="p8418">Osvaldo Myconio</persName>, domino et <lb xml:id="p2z12"/>fratri suo observandissimo.</s>
				</p>
				<p>
					<s n="26" xml:lang="de"><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
