	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non possum te la[..., m]i <persName ref="p495">Bullingere</persName>, praeterita die dominica <lb xml:id="p1z2"/>Pagos ad magistratum nostrum misisse tabellarium, quo mandarunt, <lb xml:id="p1z3"/>ut ad comitia <placeName>Eremitana</placeName> iam praesentia ex nostris legatos <lb xml:id="p1z4"/>mittat, qui Pagis accepti et non ingrati sint, alias ipsis consessum <lb xml:id="p1z5"/>et audientiam non admissuros.</s>
					<s n="3" xml:lang="la">Pręscripserunt ad hec nostris <lb xml:id="p1z6"/>nominatim, quos mittere legatos debeant.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ex adversariis nostris <lb xml:id="p1z7"/>volunt habere consulem Scudum, praefectum <persName>Madium</persName>, <persName>Dolderum</persName> <lb xml:id="p1z8"/>et <persName>Lienhertz Avienum</persName>, ex nostris Schuͦlerium, <persName>Pfendlerum</persName>, <lb xml:id="p1z9"/><persName>Iacobum Becker</persName> et quaestorem aerarium.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Vide, bone vir, quae hec <lb xml:id="p1z10"/>sit praesumptio et arrogantia, qui non verentur nostrum magistra<lb xml:id="p1z11"/>tum contemnere et dictaturę authoritatem sibi attribuere.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Quę hec portendant, mediocriter sanus expendere valet.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Magistratus mandatis <persName>Pagorum</persName> est ex bonitate obsecutus <lb xml:id="p1z14"/>praedictosque nominatos legatos misit, cum his eciam <placeName>Hessium</placeName>, <lb xml:id="p1z15"/>huius anni electum consulem, quem in numero habere spreverunt, <lb xml:id="p1z16"/>item <persName>Iacobum Avienum</persName> et alios misit.</s>
					<s n="8" xml:lang="la">Dominus res <lb xml:id="p1z17"/>nostras bene vertat.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Vale bene.</s>
				</p>
				<p>
					<s n="10" xml:lang="de">Datę 2. die octobris.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p8303">Fridolinus Fonteius</persName> <lb xml:id="p1z19"/><placeName>Glareanus</placeName>, tuus.</s>
				</p>
				<p>
					<s n="12" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem erwirdigen m. <lb xml:id="p2z2"/><persName ref="p495">Heinrich Bullinger</persName>, <lb xml:id="p2z3"/>predicant zuͦ <placeName ref="l587">Zürich</placeName>, mi<lb xml:id="p2z4"/>nem günstigen herren.</s>
					<s n="13" xml:lang="de">Tag zu Einsiedeln 6. Oktober 1560<note type="misc">EA IV,2 S. 142 - 144.</note></s>
				</p>
			</div>
		</body>
