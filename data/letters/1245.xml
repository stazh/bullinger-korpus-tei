	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Qui has reddit, compater in domino charissime, <lb xml:id="p1z2"/>iam in procinctu est expectans, dum pauculas <lb xml:id="p1z3"/>istas literas scripsero; quare boni consule, <lb xml:id="p1z4"/>quod non scribo fusius, quanquam nihil adeo <lb xml:id="p1z5"/>magni momenti est in praesenti, quod scribam.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Causa mea 10. mensis huius in senatu acta <lb xml:id="p1z7"/>et transacta est.</s>
					<s n="4" xml:lang="la">Psalterium meum dominis obtulit <lb xml:id="p1z8"/>dilectus meus compater <persName ref="p8018">Ioannes Hallerus</persName> et simul <lb xml:id="p1z9"/>necessitatem meam domesticam exposuit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Nolui hoc ipse facere, sed, ut decorum servaremus, <lb xml:id="p1z11"/>usus sum opera d. <persName ref="p8018">Halleri</persName>.</s>
					<s n="6" xml:lang="la">Domini dederunt <lb xml:id="p1z12"/>loco honorarii 30 coronatos, deinde stipendium <lb xml:id="p1z13"/>auxerunt in singulos annos florenis viginti <lb xml:id="p1z14"/>et uno vase vini Rifensis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Qua re <lb xml:id="p1z15"/>et tibi et d. <persName ref="p8018">Hallero</persName>, compatribus meis, <lb xml:id="p1z16"/>multum debeo, pro officio hoc, quod necessitatibus <lb xml:id="p1z17"/>meis fideliter impendistis.</s>
					<s n="8" xml:lang="la">Oro dominum, <lb xml:id="p1z18"/>ut vicissim vestrę semper et ubique necessi<lb xml:id="p1z19"/>tatis rationem habeat.</s>
					<s n="9" xml:lang="la">Mitto hic, quae <lb xml:id="p1z20"/>ex <placeName ref="l18">Augusta</placeName> de <placeName ref="l303">Magdeburgensibus</placeName> ad me scripta <lb xml:id="p1z21"/>heri accepi.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Filius Caesaris hoc mense <lb xml:id="p1z22"/>constituit discedere a patre et redire in <lb xml:id="p1z23"/><placeName ref="l875">Hispania</placeName>.</s>
					<s n="11" xml:lang="la"><persName ref="p18215">Regina Maria</persName> quoque rediit in <lb xml:id="p1z24"/><placeName ref="l20">Germaniam Inferiorem</placeName>.</s>
					<s n="12" xml:lang="la">Itaque Caesar solus <lb xml:id="p1z25"/>hęrebit <placeName ref="l18">Augustę</placeName>, utinam inde <foreign xml:lang="de">zum alten haufen!</foreign></s>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z26"/>Optime vale, compater charissime.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Bene sit omnibus <lb xml:id="p1z27"/>tuis, etiam dominis et amicis et fratribus.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z28"/><placeName ref="l41">Bernę</placeName> 14. aprilis 1551.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><persName ref="p8417">W<lb xml:id="p1z29"/>[olfgangus] Musculus</persName>, compat<lb xml:id="p1z30"/>er tuus in domino.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z31"/>Domino <persName ref="p8127">Pellicano</persName> scribam proxima oc<lb xml:id="p1z32"/>casione.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z33"/>Commentarios <persName>R. Sal.</persName> ab ipso <lb xml:id="p1z36"/>versos dedi famulo <persName ref="p8102">Roberti Steph[ani]</persName>, <lb xml:id="p1z37"/>sicuti ad me scripsit.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">De <lb xml:id="p1z38"/>Psalterio meo cogita/to, <lb xml:id="p1z39"/>quomodo ad te perferri possit.</s>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo m. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho Bul<lb xml:id="p2z4"/>lingero</persName>, com<lb xml:id="p2z5"/>patri suo in <lb xml:id="p2z6"/>domino charissimo.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
