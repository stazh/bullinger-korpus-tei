	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi iam olim tibi me, cum tuis literis magno<lb xml:id="p1z2"/>pere delecter, facile tamen pati, ut valetudinis tuae <lb xml:id="p1z3"/>occupationumque rationem habeas nec nisi commode et sine <lb xml:id="p1z4"/>molestia, cum potes, ad me scribas.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Idem nunc, exoptatissime <lb xml:id="p1z5"/>mi d. <persName ref="p495">Bullingere</persName>, repeto atque hoc magis, quod <lb xml:id="p1z6"/>cum literis postremis tuis homilias in Danielem coniun<lb xml:id="p1z7"/>xisti, quibus legendis me oblectare aliquot menses possum, <lb xml:id="p1z8"/>etiamsi abs te nihil interim accepero.</s>
					<s n="4" xml:lang="la">Qu<lb xml:id="p1z9"/>are te <lb xml:id="p1z10"/>ill<lb xml:id="p1z11"/>a cura <lb xml:id="p1z12"/>libe<lb xml:id="p1z13"/>ro <lb xml:id="p1z14"/>ac in <lb xml:id="p1z15"/>a<lb xml:id="p1z16"/>ur<lb xml:id="p1z17"/>em, <lb xml:id="p1z18"/>quod d<lb xml:id="p1z19"/>icit<lb xml:id="p1z20"/>ur, ut<lb xml:id="p1z21"/>ramque dormi<lb xml:id="p1z22"/>re iube<lb xml:id="p1z23"/>o<lb xml:id="p1z24"/>.<lb xml:id="p1z25"/>..</s>
				</p>
			</div>
		</body>
	</text>
