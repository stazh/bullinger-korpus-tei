	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepimus et legimus, clarissimi viri, domini, patres et fratres in Christo <lb xml:id="p1z2"/>observandi, literas vestras superioribus diebus ad nos dat<lb xml:id="p1z3"/>as, <lb xml:id="p1z4"/>in qu<lb xml:id="p1z5"/>ibus <lb xml:id="p1z6"/>ex<lb xml:id="p1z7"/>po<lb xml:id="p1z10"/>ni<lb xml:id="p1z11"/>t<lb xml:id="p1z12"/>i<lb xml:id="p1z13"/>s <lb xml:id="p1z14"/>caus<lb xml:id="p1z15"/>as<lb xml:id="p1z16"/>, quae <lb xml:id="p1z17"/>v<lb xml:id="p1z18"/>os impu<lb xml:id="p1z19"/>le<lb xml:id="p1z20"/>rin<lb xml:id="p1z21"/>t<lb xml:id="p1z22"/>, <lb xml:id="p1z24"/>ut c<lb xml:id="p1z25"/>om<lb xml:id="p1z26"/>mun<lb xml:id="p1z27"/>i s<lb xml:id="p1z28"/>cript<lb xml:id="p1z29"/>o a <lb xml:id="p1z30"/>cla<lb xml:id="p1z31"/>riss<lb xml:id="p1z32"/>imo v<lb xml:id="p1z33"/>iro d<lb xml:id="p1z34"/>omino <persName ref="p8442">I<lb xml:id="p1z35"/>osia <lb xml:id="p1z36"/>Sim<lb xml:id="p1z37"/>lero</persName>, do<lb xml:id="p1z38"/>mino fratr<lb xml:id="p1z39"/>eq<lb xml:id="p1z40"/>ue <lb xml:id="p1z41"/>nost<pb/><lb xml:id="p2z1"/>r<lb xml:id="p2z2"/>o <lb xml:id="p2z3"/>i<lb xml:id="p2z4"/>n <lb xml:id="p2z5"/>Christ<lb xml:id="p2z6"/>o hon<lb xml:id="p2z7"/>ora<lb xml:id="p2z8"/>ndo, co<lb xml:id="p2z9"/>mp<lb xml:id="p2z10"/>osito n<lb xml:id="p2z11"/>obis<lb xml:id="p2z12"/>que com<lb xml:id="p2z13"/>municato <lb xml:id="p2z14"/>illust<lb xml:id="p2z15"/>rissimo<lb xml:id="p2z16"/>s <placeName ref="l822">Germ<lb xml:id="p2z17"/>ani<lb xml:id="p2z18"/>ae</placeName> principes <lb xml:id="p2z19"/>i<lb xml:id="p2z20"/>n com<lb xml:id="p2z21"/>it<lb xml:id="p2z22"/>iis imperi<lb xml:id="p2z23"/>alib<lb xml:id="p2z24"/>us pr<lb xml:id="p2z25"/>oxim<lb xml:id="p2z26"/>e fut<lb xml:id="p2z27"/>uris<lb xml:id="p2z28"/>, si nece<lb xml:id="p2z29"/>ssita<lb xml:id="p2z30"/>s <lb xml:id="p2z31"/>it<lb xml:id="p2z32"/>a pos<lb xml:id="p2z33"/>tu<lb xml:id="p2z34"/>let, <lb xml:id="p2z35"/>app<lb xml:id="p2z36"/>ell<lb xml:id="p2z37"/>are <lb xml:id="p2z38"/>co<lb xml:id="p2z39"/>gitet<lb xml:id="p2z40"/>is etc.</s>
				</p>
				<p>
					<note>[Schluss:]</note>
					<s n="3" xml:lang="de"><lb xml:id="p2z41"/>Amen.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Clarissimo viro et patri nostro in Christo colendissimo <pb/><lb xml:id="p3z5"/>d. <persName ref="p495">Bullingero</persName> fidei et constantiae robur ex animo praecamur nostraque pro ipso <lb xml:id="p3z6"/>assidua ad dominum vota deferimus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell">Valete in Christo, domini fratresque <lb xml:id="p3z7"/>colendissimi.</s>
					<s n="6" xml:lang="la"><placeName ref="l441">Scaphusii</placeName> 18. augusti anno domini 1575.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p3z8"/>Vestrae pietatis <lb xml:id="p3z9"/>studiosissimi <lb xml:id="p3z10"/>ministri ecclesiae <placeName ref="l441">Scaphusianae</placeName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p4z1"/>Doctrina et pietate clarissimis <lb xml:id="p4z2"/>viris ecclesiae <placeName ref="l587">Tigurinae</placeName> et <lb xml:id="p4z3"/>scholae ministris ac professoribus <lb xml:id="p4z4"/>fidelissimis, dominis et fratribus <lb xml:id="p4z5"/>suis in Christo colendissim<lb xml:id="p4z6"/>i<lb xml:id="p4z7"/>s.</s>
				</p>
			</div>
