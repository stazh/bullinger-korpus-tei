	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime <persName ref="p495">Bulling[ere]</persName>, scribo nunc, quia sese <lb xml:id="p1z2"/>obtulit mihi occasio nuncii boni, <lb xml:id="p1z3"/>qui <placeName ref="l98">Curiam</placeName> venit et facile poterit <lb xml:id="p1z4"/>has ad te.</s>
					<s n="2" xml:lang="la">Obsecro diligenter, <lb xml:id="p1z5"/>scribe ad me, quid audias de apparatu <lb xml:id="p1z6"/>bellico, qui fiat in <placeName ref="l822">Germania</placeName> <lb xml:id="p1z7"/>adversus papam.</s>
					<s n="3" xml:lang="la">Nam undique reso<lb xml:id="p1z8"/>nat fama nescio quid huius<lb xml:id="p1z9"/>modi.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Permultum vero mea in<lb xml:id="p1z10"/>terest scire, quid hoc sit.</s>
					<s n="5" xml:lang="la">Nam (ut <lb xml:id="p1z11"/>tibi aperte dicam) ego continuo volarem <lb xml:id="p1z12"/>ad principes illos neque essem <lb xml:id="p1z13"/>inutilis, quippe qui sim in <lb xml:id="p1z14"/><placeName ref="l834">Italia</placeName> educatus habeamque illic <lb xml:id="p1z15"/>multorum studia et voluntates pro<lb xml:id="p1z16"/>pensas.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Sunt et apud nos poet<lb xml:id="p1z17"/>ae<note type="margin">a.R.: poaete</note>, qui luserunt de <placeName ref="l303">Magdeburgo</placeName> <lb xml:id="p1z18"/>et <placeName ref="l322">Metz</placeName>, <persName ref="p8022">Niger</persName> tetrastico, <lb xml:id="p1z19"/>alius, bonus papae amicus, hen<lb xml:id="p1z20"/>decasyllabo.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale et salve.</s>
					<s n="8" xml:lang="la"><placeName ref="l93">Claven[<lb xml:id="p1z21"/>n]ae</placeName>, idibus <lb xml:id="p1z22"/>mart[iis] 1553.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
