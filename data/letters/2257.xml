	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Binas tuas accepi, nec est credibile, quantum <lb xml:id="p1z2"/>voluptatis conceperim ex earum lectura; perge <lb xml:id="p1z3"/>ergo, mi <persName ref="p495">Bullingere</persName>, et existima te eum locum <lb xml:id="p1z4"/>apud me habere, qualem apud amicum <lb xml:id="p1z5"/>summe optares.</s>
					<s n="3" xml:lang="la">Hunc remitto ad d. <lb xml:id="p1z6"/><persName ref="p3375">Vergerium</persName> et ei iuxta eius postulata <lb xml:id="p1z7"/>pecuniam per eundem mitto; nescio tamen, <lb xml:id="p1z8"/>an sit tutum, nam hominem non novi, <lb xml:id="p1z9"/>neque eius conditionem.</s>
					<s n="4" xml:lang="la">Sed audi: non <lb xml:id="p1z10"/>credas, quam mihi fuerit iucundum ultimas <lb xml:id="p1z11"/>tuas legere; nam tu non solum mecum <lb xml:id="p1z12"/>convenis, sed rem/cum omnibus <placeName ref="l822">Germaniae</placeName> statibus, <lb xml:id="p1z13"/>nam in summa Caesar utitur marchione <lb xml:id="p1z14"/><persName>Alberto</persName> tanquam Catilina ad perdendam <lb xml:id="p1z15"/>et penitus evertandam <placeName ref="l822">Germaniam</placeName> sub <lb xml:id="p1z16"/>praetextu belli contra episcopos.</s>
					<s n="5" xml:lang="la">Scis artem: <lb xml:id="p1z17"/>vivet marchio ex bonis ecclesiasticis et <lb xml:id="p1z18"/>absque Caesaris pecuniis colliget militem, <lb xml:id="p1z19"/>quem fovebit per ali<lb xml:id="p1z20"/>quod tempus, donec <lb xml:id="p1z21"/>coniunctis cum Caesare copiis alios principes <lb xml:id="p1z22"/>possit cogere et ad pristinum iugum revocare<lb xml:id="p1z23"/>.</s>
					<s n="6" xml:lang="la">Marchio scripsit literas a<lb xml:id="p1z24"/>nte <pb/><lb xml:id="p2z1"/>aliquot dies episcopo Atrebatensi, que versus <lb xml:id="p2z2"/><placeName ref="l39">Lucenburgum</placeName> a nostris sunt intercepte et <lb xml:id="p2z3"/>coppia ad me missa <placeName ref="l832">Gallice</placeName> translata, <lb xml:id="p2z4"/>ex qua coppia articulum extraxi et <lb xml:id="p2z5"/>iussi rursum Germanice fieri, ut tu <lb xml:id="p2z6"/>posses intelligere.</s>
					<s n="7" xml:lang="la">Hunc mitto et <lb xml:id="p2z7"/>fac, ut diligenter legas; nam nisi <lb xml:id="p2z8"/>fallor, interest reipublicae, ut omnes status <lb xml:id="p2z9"/>illa sciant et videant conspirationem <lb xml:id="p2z11"/>nefandam.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Cetera omnia leta in <lb xml:id="p2z12"/><placeName ref="l832">Gallia</placeName>, et fore prevideo Cesarem velle <lb xml:id="p2z13"/>in confinibus nostris et vestris bellum <lb xml:id="p2z14"/>connectere versus <placeName ref="l631">Burgundiam</placeName> et <lb xml:id="p2z15"/><placeName ref="l2478">Sabaudiam</placeName>.</s>
					<s n="9" xml:lang="la">Propterea omnes boni debent <lb xml:id="p2z16"/>maxime vigilare et <lb xml:id="p2z17"/>contra talem ferocem bestiam unionem tue<lb xml:id="p2z18"/>ri.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Scribe, queso, de illo fędere <placeName ref="l2481">Svevico</placeName>, <lb xml:id="p2z19"/>si <lb xml:id="p2z20"/>quid audias, quod non credo fore, <lb xml:id="p2z21"/>ut tu ipse.</s>
					<s n="11" xml:lang="la">Nam si unquam, nunc principes <lb xml:id="p2z22"/>debent suo periculo sapere.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale <lb xml:id="p2z23"/>optime et me ama.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Datum 10a ap[r<lb xml:id="p2z24"/>ilis] raptim.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Tuus semper <lb xml:id="p2z25"/><persName ref="p8296">Bassefontaneus</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p3z1"/>Id, quod vobis scriptum est de Hedino, <lb xml:id="p3z2"/>est falsum; nam nostri, qui 12a <lb xml:id="p3z3"/>die viderunt, non posse defendi, <lb xml:id="p3z4"/>dediderunt Caesarianis absque ulla <lb xml:id="p3z5"/>iactura; nam salvi sunt reversi exceptis <lb xml:id="p3z6"/>tribus captivis, <lb xml:id="p3z7"/>et <lb xml:id="p3z9"/>videns <persName ref="p18538">Cesar</persName> castellum illud parum <lb xml:id="p3z10"/>munitum, ipse reliquid.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p4z1"/>Domino <persName ref="p495">Bullingero</persName>.</s>
				</p>
			</div>
