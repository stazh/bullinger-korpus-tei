	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">De rebus <placeName ref="l822">Germanicis</placeName> copiose, scio, referet <lb xml:id="p1z3"/>omnia <persName ref="p1227">Froschoverus</persName> noster neque mihi praeterea quicquam constat, nisi <lb xml:id="p1z4"/>quod dux <placeName ref="l630">Brutenus</placeName> e vivis excessisse scribitur; de successore vero <lb xml:id="p1z5"/>nihil accepi, quis futurus sit.</s>
					<s n="3" xml:lang="la">Dominus donet talem, qui circa iusti<lb xml:id="p1z6"/>ficationis doctrinam puram veritatem profiteatur cum sancta simplicitate <lb xml:id="p1z7"/>eamque ecclesiam nonnihil turbatam tranquillitati et paci restituat.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Tuginorum factum multos conturbat neque iniuria, utpote etiam <lb xml:id="p1z9"/>crudelissimis persecutoribus nominis Christi inusitatum, verum si ut apud <lb xml:id="p1z10"/><placeName ref="l791">Valesianos</placeName> parem sortiatur eventum, pro paucis mox exustis bibliis, <lb xml:id="p1z11"/>complurima sint alia habituri et in exustorum vicem ex cine (...) <lb xml:id="p1z12"/>dominus sit cum foenore alia excitaturus.</s>
					<s n="5" xml:lang="la">De ea re cup (...) <lb xml:id="p1z13"/>certior fieri, et quod adversariorum Christi molimina attinet, <lb xml:id="p1z14"/>bene factum, quod in tempore innotuerunt sic providente domino, ne <lb xml:id="p1z15"/>quis obrueretur ex improviso, ac vigilatur quidem serio a <lb xml:id="p1z16"/>nostris ubique, sed frustra tamen, nisi, qui unus potest <lb xml:id="p1z17"/>omnia, custodierit civitatem.</s>
					<s n="6" xml:lang="la">Ad eum confugiamus precibus <lb xml:id="p1z18"/>et urgeamus paenitentiam.</s>
					<s n="7" xml:lang="la" ana="farewell">Bene vale in Christo Iesu cum <lb xml:id="p1z19"/>tuis omnibus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l28">Basileae</placeName> 11. aprilis anno 1556.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>Tuus <persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, domino <lb xml:id="p2z3"/>et fratri colendissimo suo.</s>
				</p>
			</div>
		</body>
