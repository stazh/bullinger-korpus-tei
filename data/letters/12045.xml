	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Adeo non offendit me tua illa admoniti<lb xml:id="p1z2"/>o fraterna,<note xml:id="fn1" type="footnote" n="1"><persName ref="p495">Bullinger</persName> bezieht sich auf <persName ref="p467">Bucers</persName> Brief vom 9. September 1544 (oben <ref target="file12024">Nr. 1977</ref>).</note> ut magis pro ipsa tibi, <persName ref="p467">Bucere</persName> <lb xml:id="p1z3"/>dilecte, gratias agam.</s>
					<s n="3" xml:lang="la">Consolatur interim nos nostra con<lb xml:id="p1z4"/>scientia, quae sibi nullius criminis ea in re con<lb xml:id="p1z5"/>scia tranquille agit<note xml:id="fn2" type="footnote" n="2">Vgl. <cit type="bible"><ref>2Kor 1, 12</ref></cit>.</note>.</s>
					<s n="4" xml:lang="la">Ac mirum est, quomodo per opera <lb xml:id="p1z6"/><persName ref="p4091">Zvinglii</persName> in nos potuerit inflammari <persName ref="p1974">Lutherus</persName><note xml:id="fna" type="footnote" n="a">Lutherus <hi>am Rande nachgetragen.</hi></note>, cum nondum <lb xml:id="p1z7"/>sint vulgata<note xml:id="fn3" type="footnote" n="3"><persName ref="p467">Bucer</persName> hatte die geplante Neuausgabe der Werke <persName ref="p4091">Zwinglis</persName> kritisiert; s. oben <ref target="file12024">Nr. 1977</ref>, 9-12 mit Anm. 6.</note>.</s>
					<s n="5" xml:lang="la">Si vulgatio eorum librorum, <lb xml:id="p1z8"/>quos illi effuderunt in certamine de coena, iustam <lb xml:id="p1z9"/>pugnandi causam suppeditat, iustas ob causas nos i<lb xml:id="p1z10"/>nstaurassemus pugnam ante annos aliquot, cum libr<lb xml:id="p1z11"/>i <lb xml:id="p1z12"/>contra <persName ref="p4091">Zvinglium</persName> scripti a <persName ref="p1974">Luthero</persName> vel suis saepius<note xml:id="fnb" type="footnote" n="b">vel suis saepius <hi>über der Zeile nachgetragen.</hi></note> sin<lb xml:id="p1z13"/>t recusi.</s>
					<s n="6" xml:lang="la">Quid, quod in singulis fere libris a cer<lb xml:id="p1z14"/>tamine illo editis <persName ref="p4091">Zvinglium</persName> <persName ref="p1974">Lutherus</persName> notavit?</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Id quod ex ipsis libris demonstrare licebit.</s>
					<s n="8" xml:lang="la">Prae<lb xml:id="p1z16"/>terea nosti, quae scripserit de nobis ad <persName ref="p4851">Froschou<lb xml:id="p1z17"/>erum</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p495">Bullinger</persName> hatte <persName ref="p467">Bucer</persName> den Brief <persName ref="p1974">Luthers</persName> an <persName ref="p4851">Christoph Froschauer</persName> vom 31. August 1543 (<bibl source="b671">WA</bibl> Briefwechsel X 384-388, Nr. 3908) wörtlich mitgeteilt; s. <bibl source="b16">HBBW XIII</bibl> <ref target="file11843">[Nr. 1797]</ref> 282f, 67-82.</note>.</s>
					<s n="9" xml:lang="la">Scis, quam obstinate ad illa omnia compresse<lb xml:id="p1z18"/>rimus et ora et calamum.</s>
					<s n="10" xml:lang="la">Proinde non sumus <lb xml:id="p1z19"/>reparatae pugnae authores.</s>
					<s n="11" xml:lang="la">Nihil nunc dico, quales <lb xml:id="p1z20"/>nos in sarciendae concordiae negotio praestiterimus.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z21"/>Non metuimus <persName ref="p1974">Lutherum</persName>, rursus non contemnimus.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Non descendimus libenter cum illo in harenam,<note xml:id="fn5" type="footnote" n="5">Vgl. <bibl source="b56">Adagia</bibl> 1, 9, 83 (<bibl>ASD</bibl> II/2 396, <ref target="file10924">Nr. 883</ref>).</note> <lb xml:id="p1z23"/>rursus non fugiemus trepidi, sed alacres, <lb xml:id="p1z24"/>bonitati causae freti et superno muniti auxilio <lb xml:id="p1z25"/>summa cum modestia respondebimus homini, siqui<lb xml:id="p1z26"/>dem illi respondendum erit.</s>
					<s n="14" xml:lang="la">Certo novimus nos <lb xml:id="p1z27"/>tenere catholicam et orthodoxam fidem, doctrinam et <lb xml:id="p1z28"/>religionem; hanc deo iuvante ad extremum usque <lb xml:id="p1z29"/>spiritum contra papam, <persName ref="p1974">Lutherum</persName>, <persName ref="p8441">Schvenkfeldium</persName>, <lb xml:id="p1z30"/>anabaptistas et caeteros eius generis<note xml:id="fnc" type="footnote" n="c"><hi>In der Vorlage</hi> id genus.</note> cervicos<lb xml:id="p1z31"/>os doctores confitebimur.</s>
					<s n="15" xml:lang="la">Noli aegrius ferre, <lb xml:id="p1z32"/>quod <persName ref="p1974">Lutherum</persName> illis annumero.</s>
					<s n="16" xml:lang="la">Nam si ille perrexerit <lb xml:id="p1z33"/>nostram doctrinam, quae pietatis est, oppugnare<note xml:id="fnd" type="footnote" n="d"><hi>Vor</hi> oppugnare <hi>ein gestrichenes, unlesbares Wort.</hi></note>, <lb xml:id="p1z34"/>illum<note xml:id="fne" type="footnote" n="e">illum <hi>am Rande nachgetragen.</hi></note> non possumus non inter illos numerare, <lb xml:id="p1z35"/>quatenus scilicet oppugnat veritatem.</s>
					<s n="17" xml:lang="la">„At nondum e<lb xml:id="p1z36"/>vicistis“, ais, „vos tenere et tueri veritatem.“</s>
					<s n="18" xml:lang="la">Iu<lb xml:id="p1z37"/>dicet ecclesia, quae etiam intelliget, cuius vitio <lb xml:id="p1z38"/>pugna <lb xml:id="p1z39"/>haec reparata sit.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Oro te, mi frater, ut <lb xml:id="p1z40"/>haec quoque nostra benigne consulas et ores pro nobis <lb xml:id="p1z41"/>dominum, in quo solo omnis spes nostra figitur.<pb type="edition" next="428"/></s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="farewell"><lb xml:id="p1z42"/>Vale cum omnibus tuis.</s>
					<s n="21" xml:lang="la" ana="salute">Salutant te fratres.</s>
					<s n="22" xml:lang="la"><lb xml:id="p1z43"/><placeName ref="l587">Tiguri</placeName>, 29. septembris anno 1544.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z44"/><persName ref="p495">H. Bullingerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p467">Martino <lb xml:id="p2z2"/>Bucero</persName>, domino et fratri <lb xml:id="p2z3"/>colendo atque dilecto.</s>
					<s n="25" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l491">Straßburg</placeName>.</s>
				</p>
			</div>
