	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Nudiusquartus <placeName ref="l287">Lutmercham</placeName> redii <placeName ref="l555">Vituduro</placeName>, unde semel atque iterum ad te scripsi anxie, quid <lb xml:id="p1z2"/>respondeas, expectans, praesertim de negocio illo matrimoniali, super quo forte etiam <persName>Bernardus</persName> <lb xml:id="p1z3"/>noster tecum contulit quemadmodum etiam de censura.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">De foedere illo vestris cum <persName>Gallo</persName> ineundo quid tibi <lb xml:id="p1z4"/>videatur, age ne me cęles.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Ego iam nihil prorsum habeo scitu dignum, quod scribam.</s>
					<s n="4" xml:lang="la">De conscripto <lb xml:id="p1z5"/>milite omnia nunc etiam apud <placeName ref="l257">Constantienses</placeName> sunt sopita.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Dominus nos sua, hoc est solida et ęterna pace dignetur.</s>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z6"/>Vale iterum atque iterum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l287">Lutmerchę</placeName> 4. iunii 1542.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Salveat tua domus cum omnibus amicis et fratribus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z7"/>T[uus] <persName ref="p8055">Ambr[osius] Bl[aurerus]</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo d. <persName ref="p495">H[einricho] <lb xml:id="p2z2"/>Bullingero</persName>, domino suo <lb xml:id="p2z3"/>valde quam colendo longeque <lb xml:id="p2z4"/>charissimo fratri etc.</s>
				</p>
			</div>
		</body>
	</text>
