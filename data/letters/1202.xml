	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quam bene mecum agitur, colende mi <lb xml:id="p1z2"/><persName ref="p8418">Myconi</persName>, quod mercator noster ad te pro<lb xml:id="p1z3"/>ficiscitur; nam hic vivae epistolae loco esse <lb xml:id="p1z4"/>potest.</s>
					<s n="3" xml:lang="la">Ego tantis distringor capitis doloribus <lb xml:id="p1z5"/>contractis ex nimiis vigiliis, curis <lb xml:id="p1z6"/>et laboribus, ut vix haec potuerim exarare, <lb xml:id="p1z7"/>qui tamen tibi copiosissimas promiseram <lb xml:id="p1z8"/>per <persName ref="p1278">Gastium</persName> nostrum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Verum habes hic <lb xml:id="p1z9"/>copiosam Decadem nostram 5., habes Co<lb xml:id="p1z10"/>nsensionem nostram et chari fratris <persName ref="p540">Calvini</persName>, qui <lb xml:id="p1z11"/>iam aedet Commentarios in Isaiam et 7 canonicus[-as] <lb xml:id="p1z12"/>cum praefatione contra concilium <lb xml:id="p1z13"/>ad <persName ref="p3207">Edouardum VI</persName>. Oro, ut hoc meum <lb xml:id="p1z14"/>munusculum boni consulas.</s>
					<s n="5" xml:lang="la">Utinam vero<note type="margin">a.R.: et per?</note> ocium <lb xml:id="p1z15"/>diligenter liceret legere; scio tibi haec <lb xml:id="p1z16"/>non displicitura.</s>
					<s n="6" xml:lang="la">Scio satis plurimos <lb xml:id="p1z17"/>rectius de nobis iudicaturos, qui hactenus <lb xml:id="p1z18"/>pro sacramentariis condemnarunt.</s>
					<s n="7" xml:lang="la">Neque <lb xml:id="p1z19"/>enim frustra multum laboris insumpsis<lb xml:id="p1z20"/>se me spero in scribendis 4 sermonibus <lb xml:id="p1z21"/>de sacramentis; sed cupio et tuum <lb xml:id="p1z22"/>audire iudicium.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z23"/>Habes, inquam, et <lb xml:id="p1z24"/>mercatorem nostrum, in quem magno cum fructu <lb xml:id="p1z25"/>contulisti, quaecunque contulisti.</s>
					<s n="9" xml:lang="la">Examinatus <lb xml:id="p1z26"/>apposite et docte respondit; receptus <lb xml:id="p1z27"/>est ergo a praefectis collegio in numerum <lb xml:id="p1z28"/>stipendiariorum.</s>
					<s n="10" xml:lang="la">Gratulor ergo tibi de <lb xml:id="p1z29"/>tam bonae spei homine.</s>
					<s n="11" xml:lang="la">Tu hortare, ut <lb xml:id="p1z30"/>pergat esse optimus et studiosissimus.</s>
					<s n="12" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z31"/>aeternum.</s>
					<s n="13" xml:lang="de"><foreign xml:lang="la">Dominus mox te nobis incolumem <lb xml:id="p1z32"/>restituat,</foreign> das wir mitteinandren könni<lb xml:id="p1z33"/>nd faren ins concilium zuͦ <placeName ref="l1107">Trient</placeName>; <lb xml:id="p1z34"/>dann ein kranck houpt und bos[?] fuͤß <lb xml:id="p1z35"/>wellend sunst nitt wol fuͤgen.</s>
					<s n="14" xml:lang="la">Martii <lb xml:id="p1z36"/>6. <lb xml:id="p1z37"/>anno 1551.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z38"/>Salvi sint fratres omnes; <lb xml:id="p1z39"/>salutant te fratres.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z40"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p8418">Osvaldo Myconio</persName>, <lb xml:id="p2z2"/>colendissimo domino suo <lb xml:id="p2z3"/>et fratri.</s>
					<s n="18" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
