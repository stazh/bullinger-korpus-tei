	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Boni consule, si te nimis diu obtudi; coegit <lb xml:id="p1z2"/>me necessitas causae.</s>
					<s n="2" xml:lang="la">Salvere iubeo ge<lb xml:id="p1z3"/>neros, d. <persName ref="p8011">Gvalterum</persName>, d. <persName ref="p8127">Pellicanum</persName>, d. <lb xml:id="p1z4"/><persName ref="p8171">Bibliandrum</persName> ac reliquos fratres.</s>
					<s n="3" xml:lang="la">Iuvate <lb xml:id="p1z5"/>me vestris precibus, optimi fratres.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/><placeName ref="l412">Reutlingae</placeName> 14. septembris 1555.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Velim ostendas illi bono viro, quam magnus sit <lb xml:id="p1z9"/>liber, pro quo tantopere excandescit; <lb xml:id="p1z10"/>potuissem uni... ballum, si voluissem.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
