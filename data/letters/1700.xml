	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quod nihil adhuc literarum acceperis, vir omnium clarissime, <lb xml:id="p1z2"/><persName ref="p18291">Petrus Mechlingensis</persName> in culpa est, qui iam dudum accepit ea, <lb xml:id="p1z3"/>de quibus nuper ad te scripsi, confessionem scilicet <placeName ref="l572">Wir<lb xml:id="p1z4"/>tenbergensem</placeName>, libellum de neutralibus atque Germanice <lb xml:id="p1z5"/>scriptos libellos contra eos, qui syncerioris doctrinę m<lb xml:id="p1z6"/>inistros ex ecclesiis suis eiecerunt, collationem papatus <lb xml:id="p1z7"/>cum caeteris haeresibus, quae unquam in Christi ecclesiam <lb xml:id="p1z8"/>irrepserunt, quae omnia dubio procul proxima vectura <lb xml:id="p1z9"/><persName ref="p1227">Froschoverus</persName> accipiet cum reliquis ad <persName ref="p8171">Theodorum</persName>, <persName ref="p8127">Pel<lb xml:id="p1z10"/>licanum</persName> et <persName ref="p1214">Frisium</persName> spectantibus.</s>
					<s n="3" xml:lang="la">Inscripsi autem <lb xml:id="p1z11"/>singulis fasciculis nomina, ut videat <persName ref="p1227">Froschoverus</persName>, <lb xml:id="p1z12"/>ad quos spectent.</s>
					<s n="4" xml:lang="la">Novarum rerum nihil certi habemus, cu<lb xml:id="p1z13"/>m rumoribus vanis plena sint omnia.</s>
					<s n="5" xml:lang="la">Magistratui <lb xml:id="p1z14"/>tamen nostro relatum est <persName>Moritium</persName>, virum illum bonum, <lb xml:id="p1z15"/>post pacem cum imperatore factam incendisse castra <lb xml:id="p1z16"/>sua prope <placeName ref="l157">Francfordiam</placeName>, in quibus et plus quam 300 mi<lb xml:id="p1z17"/>lites aegritudine atque variis morbis affectos reli<lb xml:id="p1z18"/>quit, ut incendio perirent, atque tormenta etiam <lb xml:id="p1z19"/>bell, quae in <placeName ref="l157">Francfordiensium</placeName> manus venerunt.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z20"/>Unde nova obsidione a marchione <placeName ref="l1048">Brandeburgensi</placeName> <lb xml:id="p1z21"/>premi dicuntur, quem et a <placeName ref="l832">Gallo</placeName> <persName ref="p2916">Schertlinum</persName> cum selectissimo <lb xml:id="p1z22"/>milite petere ferunt, quo coniunctis viribus <lb xml:id="p1z23"/>imperatoreos tuto aggrediatur atque bello <placeName ref="l822">Ger<lb xml:id="p1z24"/>manico</placeName> finem demum imponat.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Moritius autem <lb xml:id="p1z25"/>desertor recta via movere in <placeName ref="l882">Ungariam</placeName>, quae <lb xml:id="p1z26"/>a <placeName ref="l2510">Turcis</placeName> infestatur, exercitum suum di<lb xml:id="p1z27"/>citur.</s>
					<s n="8" xml:lang="la"><placeName ref="l546">Vienna</placeName> <placeName ref="l822">Germanorum</placeName> praesidio munitur contra <lb xml:id="p1z28"/><placeName ref="l2510">Turcarum</placeName> incursionem, de quibus tamen iam aliquot <lb xml:id="p1z29"/>menses a <persName ref="p5626">Wolffgango Lazio</persName> nihil audivimus, quem <lb xml:id="p1z30"/>tamen in aula regis <persName ref="p18477">Ferdinandi</persName> esse non dubitamus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z31"/>Raptim datae <placeName ref="l28">Basileae</placeName> 17. augusti anno 1552.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z32"/>T[uus] <persName ref="p8406">Conra[dus] Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo atque vigilantissimo <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z3"/>d. <persName ref="p495">Henrichi Bullingero</persName>, <lb xml:id="p2z4"/>domino suo colendissimo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
