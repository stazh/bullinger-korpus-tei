	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Vigilantissimo <placeName ref="l587">Tigurinae</placeName> ecclesiae episcopo, D. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p1z2"/>felicissima quaeque in Christo exoptat <persName ref="p506">J. Butlerus</persName>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>JANUARII ultimo datae in <placeName ref="l830">Anglia</placeName> literae <persName ref="p6063">Petersoniae</persName> <placeName ref="l28">Basileam</placeName> ad me sextis calendis Martiis <lb xml:id="p1z4"/>perlatae fuere.</s>
					<s n="3" xml:lang="la">Novi nihil ex iis accepi.</s>
					<s n="4" xml:lang="la">Perseverat eadem in conditione regnum, quam <lb xml:id="p1z5"/>proximis literis tibi descripsimus: magna tamen spes est, idque optimi quique jugis precibus a Deo <lb xml:id="p1z6"/>contendunt, propediem hanc multo integriorem fore futuram.</s>
					<s n="5" xml:lang="la">Ceterum jam tibi haud referam ex <lb xml:id="p1z7"/>mercatis lignis quantam jacturam fecerit <persName ref="p6063">W. Peterson</persName>: quod ipse multo luculentius cito, Deo <lb xml:id="p1z8"/>duce, praesens praesenti indicabit.</s>
					<s n="6" xml:lang="la">At sua certa culpa ut plurimum hoc perfectum est; qui sanis fissilibus <lb xml:id="p1z9"/>non melius providerit, quum ea <placeName ref="l646">Claronae</placeName> primum licitaretur.</s>
					<s n="7" xml:lang="la">Priusquam hinc abiret, dixi apud e<lb xml:id="p1z10"/>um coram, protinus a primo aspectu suorum fissilium, fore futurum ubi <placeName ref="l830">Angliam</placeName> appulisset, <lb xml:id="p1z11"/>susceptae profectionis in hujusmodi lignis emundis nonnihil eum poeniteret.</s>
					<s n="8" xml:lang="la">Nimis vere <lb xml:id="p1z12"/>equidem, quod ejus causa mihi valde dolet, vaticinatus sum.</s>
					<s n="9" xml:lang="la">Attamen me vatem hoc nomine perspicaciorem n<lb xml:id="p1z13"/>on est quod judicet quisquam; ipsa namque arcuum materies hoc detrimenti huic comminata <lb xml:id="p1z14"/>est certissime antea quam <placeName ref="l28">Basilea</placeName> solveret.</s>
					<s n="10" xml:lang="la">Nam quum unumquodque arcuum fissile, tres digitos <lb xml:id="p1z15"/>crassum, quadratumque, septemque pedes longum, et sine nodis bene politum, confici oportuisset, <lb xml:id="p1z16"/>vix ullum huic normae ac descriptioni respondebat.</s>
					<s n="11" xml:lang="la">Itaque literis ad me scriptis impensissime <lb xml:id="p1z17"/>te orat, hos homines hujus sui damni digneris praemonere, ut juxta hoc exemplar, quod <lb xml:id="p1z18"/>proxime circumscripsi, omnia examinent: sed vereor ne non seriuscule moneat; ne, ut prius, operam cum im<lb xml:id="p1z19"/>pensis sumat inanem.</s>
					<s n="12" xml:lang="la">Tu igitur super hac re, quod tuae erga hunc benignitati videbitur <lb xml:id="p1z20"/>consultum, facias oro.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale in Domino felicissime.</s>
					<s n="14" xml:lang="la" ana="salute">Porro conjugi optimae matronae ex me <lb xml:id="p1z21"/>salutem dicas totique familiae, obsecro.</s>
					<s n="15" xml:lang="la"><placeName ref="l28">Basileae</placeName>, circa noctis horam undecimam datae <lb xml:id="p1z22"/>Hart. 29, <lb xml:id="p1z23"/>1540.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z24"/>Tuus ex imo pectore, <persName ref="p506">JO. BUTLERUS</persName>.</s>
				</p>
				<p>
					<note type="PS">P.S.</note>
					<s n="17" xml:lang="la"><lb xml:id="p1z25"/>Hactenus nihil intellex<lb xml:id="p1z26"/>i a<lb xml:id="p1z27"/>n numismata <placeName ref="l425">Romana</placeName> <lb xml:id="p1z28"/>exceperis.</s>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eruditissimo viro D. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae episcopo <lb xml:id="p2z4"/>vigilantissimo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>