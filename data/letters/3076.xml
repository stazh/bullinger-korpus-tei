	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Cum intellexi a d. <persName ref="p8011">Rodolpho</persName>, <lb xml:id="p1z2"/>affine tuo, virum hic esse, <lb xml:id="p1z3"/>cui literae tuto possint credi, <lb xml:id="p1z4"/>inclusi has, quas vides, quas <lb xml:id="p1z5"/>alioqui non cuivis credidissem.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z6"/>Tu cura, ut mature et tuto <lb xml:id="p1z7"/>remittantur ad me.</s>
				</p>
				<p>
					<s n="3" xml:lang="la" ana="farewell">Vale iterum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro fidelissimo<lb xml:id="p2z4"/>, domino et fratri <lb xml:id="p2z5"/>colendo et dilectissimo.</s>
					<s n="5" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
