	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Sancte <persName ref="p495">Bullingere</persName>, salutem aeternam in Christo nostro <lb xml:id="p1z2"/>servatore opto tibi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Miraris forsan, quod ego te meis <lb xml:id="p1z3"/>audeam interpellare literis.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Parce, paucis <lb xml:id="p1z4"/>scribam.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Non ita pridem habui <placeName ref="l587">Tiguri</placeName>, cuius possem <lb xml:id="p1z5"/>omnia mea in sinum effundere; eiusdem apud vos exuvias <lb xml:id="p1z6"/>habetis.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Tygurum ergo sepius mihi venit in mentem.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z7"/>Sed ad quid ego effutirem ea, quae tum cogito?</s>
					<s n="7" xml:lang="la">Vivit <lb xml:id="p1z8"/><persName ref="p8111">Martyr</persName>; valeat et feliciter vivat Tygurum.</s>
					<s n="8" xml:lang="la">Et <lb xml:id="p1z9"/>ne una cum <persName ref="p8111">Martyre</persName> intereat etiam <placeName ref="l587">Tygurinae</placeName> apud <lb xml:id="p1z10"/>me <lb xml:id="p1z11"/>benignitatis memoria, te nunc compello.</s>
					<s n="9" xml:lang="la">Tuguriolum aliquando <lb xml:id="p1z12"/>dabatur mihi <placeName ref="l587">Tyguri</placeName>: si meis votis nunc deus annueret, <lb xml:id="p1z13"/>id obnixe repeterem.</s>
					<s n="10" xml:lang="la">Me forsan quero, dum talia <lb xml:id="p1z14"/>opto; non diffiteor.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">At cum Christi, domini nostri, gloria unice <lb xml:id="p1z15"/>sit querenda, meas desero petitiones, quatenus me spectant.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z16"/>Hac in re (in querendo hospitiolo) nolo tibi iterum esse <lb xml:id="p1z17"/>molestus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">O si aliquando daretur attingere mansiones <lb xml:id="p1z18"/>a Christo domino nobis paratas in coelis!</s>
					<s n="14" xml:lang="la">Interim, sanctissime <lb xml:id="p1z19"/>pater, <placeName ref="l830">Angliam</placeName> nostram et me quoque tuis precibus commendo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z20"/><placeName ref="l830">Angliae</placeName> res male se habent; peiora vereor, ne dicam <lb xml:id="p1z21"/>pessima.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">At Christo domino interim inserviendum est.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Foelix <lb xml:id="p1z22"/>ille est, quem Christus noster in famulitium adsciscit.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l830">Angliam</placeName> <lb xml:id="p1z23"/>ergo tibi commendatissimam habe in precibus necnon et <lb xml:id="p1z24"/>mei sis memor.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">In perpetuum amoris erga te mei signum <lb xml:id="p1z25"/>mitto cirothecas <placeName ref="l376">Oxonienses</placeName> per d. <persName ref="p8055">Blaurerum</persName> vestratem.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z26"/>Illae inveterascent; nunquam tamen apud te <placeName ref="l830">Angliae</placeName> meique <lb xml:id="p1z27"/>inveterascat amor.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="farewell">Vale et in domino vive <lb xml:id="p1z28"/>felicissime, charissime pater.</s>
					<s n="22" xml:lang="la"><placeName ref="l376">Oxonii</placeName> di<lb xml:id="p1z29"/>e 26. iulii 1563.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>T[uus] <persName ref="p2866">Tho[mas] Sam<lb xml:id="p2z2"/>pson</persName>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la" ana="salute">Saluta, quaeso, meo nomine et m<lb xml:id="p2z3"/>eae uxoris <persName ref="p8104">Iulium Terentianum</persName>.</s>
					<s n="25" xml:lang="la"><lb xml:id="p2z4"/>Eximio viro d. <persName ref="p495">Henrico <lb xml:id="p2z5"/>Bullingero</persName>, verbi divini concionatori <lb xml:id="p2z6"/>fidelissimo.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><placeName ref="l587">Tyguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
