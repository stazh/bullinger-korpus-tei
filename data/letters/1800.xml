					<s n="2" xml:lang="la">Quod tanto temporis intervalle nullas a me accepisti literas, <lb xml:id="p1z2"/>vir ornatissime, non est, quod ossitantiam meam aut ignaviam <lb xml:id="p1z3"/>accuses, sed internuntiorum potius penuriam.</s>
					<s n="3" xml:lang="la">Scio enim <lb xml:id="p1z4"/>me in mensis unius spatio ad minimum tres ad tuam pietatem <lb xml:id="p1z5"/>scripsisse epistolas, quas <persName ref="p18291">Petrus Mechlingensis</persName> <lb xml:id="p1z6"/>noster in fasciculo hactenus ob vectorum raritatem <lb xml:id="p1z7"/>inclusas servavit diutius sane, quam conveniebat.</s>
					<s n="4" xml:lang="la">Verum <lb xml:id="p1z8"/>propediem omnes accipies a vectore, qua hac ipsa <lb xml:id="p1z9"/>hora fasciculum librorum ad <persName ref="p8171">Theodorum Bibliandrum</persName> <lb xml:id="p1z10"/>atque <persName ref="p8127">Pellicanum</persName> spectantium a <persName>Petro</persName> nostro accepit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/><persName ref="p8112">Rex Galliae</persName> <placeName ref="l378">Lutetiae Parisiorum</placeName> esse fertur, imperator <lb xml:id="p1z12"/>vero in <placeName>Theonis Villa</placeName>.</s>
					<s n="6" xml:lang="la">Nos expectamus etiam <lb xml:id="p1z13"/>ducum <placeName ref="l832">Gallicorum</placeName>, <persName ref="p2916">Schertlini</persName> et <persName>Rollvagii</persName> adventum, <lb xml:id="p1z14"/>quorum posterior hisce diebus uxorem suam praemisit.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Abbas Murbacensis, qui ante annum fere nobiles quosdam <lb xml:id="p1z16"/><placeName ref="l832">Gallos</placeName> ad regem properantes intercepit atque parum <lb xml:id="p1z17"/>humaniter tractavit, timet militum eruptiones, <lb xml:id="p1z18"/>qui iam dudum de eius facti ultione cogitarunt, quo factum <lb xml:id="p1z19"/>est, ut per <placeName ref="l632">Alsatiam</placeName> et <placeName ref="l2836">Suntgoiam</placeName> omnes timor <lb xml:id="p1z20"/>magnus invaserit.</s>
					<s n="8" xml:lang="la">Haec praesenti te minime <lb xml:id="p1z21"/>latere volui, ut ob literas tuas ad <persName ref="p8121">Montium</persName> omni <lb xml:id="p1z22"/>sollicitudine te liberarem; intelliges enim brevi, quam <lb xml:id="p1z23"/>diligenter <persName ref="p8126">Oporinus</persName> noster omnia curaverit.</s>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z24"/>Vale cum tota familia felicissime.</s>
					<s n="10" xml:lang="la"><placeName ref="l28">Basileae</placeName> 30. ia<lb xml:id="p1z25"/>nuarii anno 1553.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z26"/>T[uus] <persName ref="p8406">Lycos<lb xml:id="p1z27"/>thenes</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietate atque eruditione insigni <lb xml:id="p2z2"/>viro d. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pa<lb xml:id="p2z4"/>stori vigilantissimo atque <lb xml:id="p2z5"/>amico colendissimo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>