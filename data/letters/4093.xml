	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Spero meas tibi, vir praestantissime, literas <lb xml:id="p1z3"/>non ita pridem scriptas esse redditas.</s>
					<s n="3" xml:lang="la">Nunc non <lb xml:id="p1z4"/>est, quod illis adiiciam, nisi quod in <placeName>Gal</placeName> iis persequtio <lb xml:id="p1z5"/>magis atque magis fervet.</s>
					<s n="4" xml:lang="la">Rerum potiuntur <placeName>Guysian<lb xml:id="p1z6"/>i</placeName> fratres, capitales Christi et evangelii eius hostes.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Caeteri, quibus satis cognitus est Christus, omnia dissi<lb xml:id="p1z8"/>mulant et simulant eversi cura huius seculi <lb xml:id="p1z9"/>atque adeo caecati rerum terrenarum desiderio.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Nuper capti sunt multi <placeName ref="l378">Lutetiae</placeName>, qui in <lb xml:id="p1z11"/>domo nobilis cuiusdam matronae convenerant in <lb xml:id="p1z12"/>coetum sacrum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><persName ref="p18090">Rex Navarrae</persName> et regina [<lb xml:id="p1z13"/>vid]ua quoque dissimulare omnia dicuntur, nescio quam <lb xml:id="p1z14"/>vere.</s>
					<s n="8" xml:lang="la">Proinde video verissimas esse illas aeternae <lb xml:id="p1z15"/>veritatis sententias: Quam difficile est divitem i<lb xml:id="p1z16"/>ngredi in regnum dei, item: "Nolite confidere in <lb xml:id="p1z17"/>principibus neque in filiis hominum, in quibus non est salus" <lb xml:id="p1z18"/>[Ps 146, 3 (145, 2f Vulg.)].</s>
					<s n="9" xml:lang="la">Video itaque causam hanc relictam <lb xml:id="p1z19"/>esse in manibus omnipotentis dei, qui procul dubio <lb xml:id="p1z20"/>ipsam invitis interim omnibus impiis tuebitur <lb xml:id="p1z21"/>et promovebit.</s>
					<s n="10" xml:lang="la">Nam tota <placeName ref="l830">Anglia</placeName> Christum <lb xml:id="p1z22"/>amplexa est, tota <placeName ref="l2524">Scotia</placeName> evangelium recepit et <lb xml:id="p1z23"/><placeName>Gallos</placeName> eiecit, qui insolenter (ut fere solent) se gessere.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/>Quo nomine quondam eiecti sunt etiam <lb xml:id="p1z25"/>ex re<lb xml:id="p1z26"/>gno <placeName ref="l994">Neapolitano</placeName> et ex <placeName ref="l306">Mediolano</placeName> et<lb xml:id="p1z27"/>c.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z28"/>Metuunt quidam bellum reparandum inter <placeName ref="l830">Angliam</placeName> <lb xml:id="p1z29"/>et <placeName ref="l832">Galliam</placeName>; sed cum mercatores nostri <placeName ref="l157">Francfurto</placeName> <lb xml:id="p1z30"/>nondum redierint et literas ex <placeName ref="l830">Anglia</placeName> nondum <lb xml:id="p1z31"/>attulerint, [al]ias copiosius de his scribam.</s>
					<s n="13" xml:lang="la">Filius <lb xml:id="p1z32"/>meus <lb xml:id="p1z33"/><persName>Christophorus Tarvisii</persName> apud d. <persName>Ieronymum <lb xml:id="p1z34"/>de la Gessia</persName> in augusto aegrotavit.</s>
					<s n="14" xml:lang="la">Spero illum <lb xml:id="p1z35"/>revaluisse.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Misi ad ipsum pecunias per <placeName ref="l587">Tigurinum</placeName> <lb xml:id="p1z36"/>civem <persName>Patavium</persName> hoc mense proficiscentem et item <lb xml:id="p1z37"/>per <placeName ref="l18">Augustam Vindelicorum</placeName>, ut ei nihil deesse <lb xml:id="p1z38"/>putem.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z39"/>Si tamen <lb xml:id="p1z40"/>coronato uno aut altero indiguerit, <lb xml:id="p1z41"/>quaeso, des illi mutuo, si quid eius intellexeris.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z42"/>Has vero literas ei inscriptas mature et <lb xml:id="p1z43"/>tuto mittas, etiam atque etiam oro.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">Mei omnes <lb xml:id="p1z44"/>te, <persName>Ioannem</persName> nostrum et omnes tuos salutant.</s>
					<s n="19" xml:lang="la" ana="salute">Salvus sit uterque <lb xml:id="p1z45"/>pater tuus et d. <persName ref="p8011">Rodolphus</persName> et d. <persName ref="p6831">Traversus</persName>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z46"/>die Michaelis 1559.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z47"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z48"/><persName>Laurentius <pb/><lb xml:id="p2z1"/>Lumaga</persName> a patre creditas pecunias et mihi propter <persName>Hectorem</persName> debitas <lb xml:id="p2z2"/>bona fide numeravit etc.</s>
					<s n="24" xml:lang="la">Clarissimo viro d. <persName ref="p8432">Friderycho a Salice</persName>, comitatus <placeName ref="l93">Claven<lb xml:id="p2z3"/>nensis</placeName> comissario dignissimo, domino suo colendo et fratri [charissimo].</s>
					<s n="25" xml:lang="de"><placeName ref="l93">Cläven</placeName> <lb xml:id="p2z4"/>oder <placeName ref="l440">Samada</placeName> in <placeName ref="l648">Pündten</placeName>.</s>
				</p>
			</div>
