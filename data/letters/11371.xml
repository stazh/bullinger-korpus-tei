	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et tranquillam conscientiam etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>A synodo<note xml:id="fn1" type="footnote" n="1">Die Zürcher Herbstsynode 1539 hatte am 21. Oktober stattgefunden; s. Zürich StA, E II 1, 238.</note> ut cum molesta podagra in ędes refocillaturus sitim cum fratribus <lb xml:id="p1z3"/><persName ref="p8380">Mathię</persName> <placeName ref="l555">Vituduri</placeName><note xml:id="fn2" type="footnote" n="2"><persName ref="p8380">Matthias Hirsgarter</persName> in <placeName ref="l555">Winterthur</placeName>.</note>, humanissime vir, redii, idem scripturam<note xml:id="fn3" type="footnote" n="3">Nicht erhalten.</note> tradidit <lb xml:id="p1z4"/>mihi legem tuam continentem valetudinario me cuidam ad numerum o<lb xml:id="p1z5"/>rationem dominicam pro pristina recuperanda sanitate iniunxis<lb xml:id="p1z6"/>se etc.</s>
					<s n="3" xml:lang="la">Oro, ne me tantillum et infidelem, artis et medices<note xml:id="fn4" type="footnote" n="4">d. h. medicinae (wohl in falscher Analogie zu griech. <foreign xml:lang="el">ϕυσικῆς</foreign>.</note> virtutis<lb xml:id="p1z7"/>que naturalium facere velis ignarum.</s>
					<s n="4" xml:lang="la">Si gratia et fides deessent, <lb xml:id="p1z8"/>longa tamen dies, quae etiam homini leones parere facit<note xml:id="fn5" type="footnote" n="5">Vgl. <persName ref="p19948">Tibull</persName>, Elegiae, 1, 4, 17.</note>, et docti ethnici, in quorum <lb xml:id="p1z9"/>contumeliam, si fidei et Christo, cuius uterque sumus, parcere non velim, <lb xml:id="p1z10"/>superstitionem hanc iniunxisse prohibuissent ipsaque meamet utcunque te<lb xml:id="p1z11"/>nuis Minerva<note xml:id="fn6" type="footnote" n="6">im Sinne von: Bildung.</note>.</s>
					<s n="5" xml:lang="la">Delatus ergo apud te.</s>
					<s n="6" xml:lang="la">Mendacem habe delatorem, <lb xml:id="p1z12"/>mi doctissime pręceptor.</s>
				</p>
				<p>
					<s n="7" xml:lang="de">Ex <placeName ref="l2712">Rickenbach</placeName>, Martini etc. 39.</s>
				</p>
				<p>
					<s n="8" xml:lang="de"><lb xml:id="p1z13"/><persName ref="p3876">Huldrichus Werdmüller</persName>, s<lb xml:id="p1z14"/>ervulus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Et docto atque pio magistro <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullinger</persName>, pręceptori suo in domino <lb xml:id="p2z3"/>charissimo.</s>
				</p>
			</div>
		</body>
	</text>
