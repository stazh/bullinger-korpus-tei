	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hic est, quem nuper tibi commendaram,<note xml:id="fn1" type="footnote" n="1">Vgl. oben <ref target="file11850">Nr. 1804</ref>, 1-20.</note> iuvenis, filius inquam <persName ref="p17776">Alexandri de Rischach</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p18224">Martin(?) Rischacher</persName>; vgl. ebd., Anm. 2.</note>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Ab initio dedit operam literis; impensę gravantes patrem impulerunt, ut doceret <lb xml:id="p1z3"/>artem sarctoriam.</s>
					<s n="4" xml:lang="la">Hanc dum probe didicisset, dimisit <placeName ref="l491">Argentinam</placeName>, ut laboraret.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z4"/>Ubi dum aliquandiu fuisset, oculi laborem ad lumen renuerunt; nam sicut pater <lb xml:id="p1z5"/>oculos habet lusciosos et hac ratione rediit ad literas, quas nunquam reliquisset, <lb xml:id="p1z6"/>si non coactus fuisset patris sequi consilium.</s>
					<s n="6" xml:lang="la">Tu, quęso, quod in te est, iuvenem <lb xml:id="p1z7"/>habeas commendatum.</s>
					<s n="7" xml:lang="la">Dixi d. <persName ref="p17776">de Rischach</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p17776">Alexander Rischacher</persName> (oder eventuell <persName ref="p7730">Ludwig von Reischach</persName>; vgl. ebd., Anm. 6).</note>, quo animo hac in re ipsi <lb xml:id="p1z8"/>inservieris; agebat et nunc agit tibi gratias quęrens, ut intelligas ali<lb xml:id="p1z9"/>quando, quanti te tuumque favorem faciat.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Transeunt Confoederati<note xml:id="fn4" type="footnote" n="4">Gemeint sind eidgenössische Söldner.</note> per <placeName ref="l632">Alsatiam</placeName>, mirum quod tam temere, cum non audiam <lb xml:id="p1z11"/>pacem esse factam inter <persName ref="p18538">cęsarem</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p18538">Karl V.</persName></note> et <persName ref="p20225">Gallum</persName><note xml:id="fn6" type="footnote" n="6">König <persName ref="p20225">Franz I.</persName></note>.</s>
					<s n="9" xml:lang="la">Est vir nobilis<note xml:id="fn7" type="footnote" n="7">Unbekannt (zu denken ist eventuell an <persName ref="p7730">Ludwig von Reischach</persName>, über dessen Sympathien für den Kaiser sich <persName ref="p8418">Myconius</persName> bereits im Brief vom 1. Oktober verwundert gezeigt hatte; vgl. oben <ref target="file11838">Nr. 1792</ref>, 14f).</note> circa <placeName ref="l28">Basileam</placeName>, <lb xml:id="p1z12"/>qui supra modum vexatur melancholia, quod cęsar ante nativitatem domini <lb xml:id="p1z13"/>non est factus <persName ref="p20225">rex Gallię</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale per Christum cum tuis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l28">Basileę</placeName>, ra<lb xml:id="p1z14"/>ptim, ante lucem, 4. decembris anno 1543.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z15"/><persName ref="p8418">Os. Myconius</persName> <lb xml:id="p1z16"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName> doctissimo, <lb xml:id="p2z3"/>in domino v<lb xml:id="p2z4"/>enerando suo.</s>
					<s n="14" xml:lang="de"><placeName ref="l587">Z[ürich]</placeName><note xml:id="fnb" type="footnote" n="b"><hi>Teilweise auf das nicht mehr vorhandene Verschlussband geschrieben.</hi></note>.</s>
				</p>
			</div>
