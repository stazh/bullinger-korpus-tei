	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Desideratissimas tuas, domine honorande, <lb xml:id="p1z2"/>domine colendissime et frater charissime, accepi <lb xml:id="p1z3"/>per clarissimum virum d. <persName ref="p8305">Ioannem Budaeum</persName>, fratrem <lb xml:id="p1z4"/>charissimum.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Doleo vehementer innoxium cruorem <lb xml:id="p1z5"/>sanctorum in <placeName ref="l832">Gallia</placeName> tanta effundi copia <lb xml:id="p1z6"/>et oro dominum, ut ecclesiae suae misereatur effun<lb xml:id="p1z7"/>datque iram suam super eos, qui nomen eius <lb xml:id="p1z8"/>non invocant.</s>
					<s n="4" xml:lang="la">Gaudeo rursus nostros alicubi <lb xml:id="p1z9"/>iuvari a domino, quem indesinenter rogo, ut <lb xml:id="p1z10"/>iusto auxilio liberet nos a malo hostiumque <lb xml:id="p1z11"/>copias fundat et atterat, si eorum misereri et <lb xml:id="p1z12"/>eos convertere non vult.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">De iis, quae in man<lb xml:id="p1z13"/>datis das, copiose de singulis colloquutus sum cum <lb xml:id="p1z14"/>d. <persName ref="p4440">Budaeo</persName>, qui referet.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Breviter: faciam summa <lb xml:id="p1z15"/>fide et diligentia, quod possum.</s>
					<s n="7" xml:lang="la">Literas <persName ref="p8093">Her<lb xml:id="p1z16"/>culi a Salice</persName> inscriptas hodie curavi diligenter <lb xml:id="p1z17"/>misique <placeName ref="l98">Curiam Rhetorum</placeName>.</s>
					<s n="8" xml:lang="la">Non negligetis <lb xml:id="p1z18"/><placeName ref="l648">Rhetos</placeName>; si necesse sit, militem peritum et bene<lb xml:id="p1z19"/>volum dare poterunt; sed in tempore, et priusquam <lb xml:id="p1z20"/>desperatae et dissipatae sint nostrorum res, agendum <lb xml:id="p1z21"/>cum illis.</s>
					<s n="9" xml:lang="la">Postquam fortuna inclinare coeperit, <lb xml:id="p1z22"/>languescunt animi eorum quoque, qui antea rebus <lb xml:id="p1z23"/>nondum infortunatis alacres erant.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ad <persName ref="p3559">Hall<lb xml:id="p1z24"/>vylerum</persName> scripsi item hodie diligenter; sed et ad <lb xml:id="p1z25"/>d. <persName ref="p3494">Nicolaum Diesbach</persName> eadem de re scripsi <placeName ref="l41">Bern<lb xml:id="p1z26"/>am</placeName> per <persName ref="p8305">Budaeum</persName> hortans, ut <persName ref="p3559">Hallvylerum</persName> urgeat; <lb xml:id="p1z27"/>est illi iunctus affinitate.</s>
					<s n="11" xml:lang="la">Peto a <persName ref="p3559">Hallvylero</persName>, ut, <lb xml:id="p1z28"/>si quid possit, totum ad te negotium perscribat.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z29"/>Literas vero <persName ref="p8315">Condensis</persName> et amirallii hodie curavi <lb xml:id="p1z30"/>deferre <placeName ref="l21">Badam</placeName> ad comitia Helvetiorum.</s>
					<s n="13" xml:lang="la">Legatos <lb xml:id="p1z31"/>nostros adhortatus sum, ut impediant, quantum possunt, <lb xml:id="p1z32"/>profectionem.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Impediverunt hucusque; iam vero <lb xml:id="p1z33"/>dicuntur passim expandisse vexilla et cras pr<lb xml:id="p1z34"/>ofecturos, quod eis pessime cedat, dominum oro.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z35"/>Vigilate, vigilate de <placeName ref="l301">Lugduno</placeName>; prima cura est.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z36"/><placeName ref="l301">Lugdunum</placeName> cupiunt recuperare; sunt ea de re <lb xml:id="p1z37"/>multa et varia consilia.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Ideo non libenter legi <lb xml:id="p1z38"/>baronem, praefectum <placeName ref="l301">Lugduni</placeName>, profectum esse <placeName ref="l1944">Valentiam</placeName>; <lb xml:id="p1z39"/>ea de re nuper etiam ad te scripsi.</s>
					<s n="18" xml:lang="la">Vigilate; <lb xml:id="p1z40"/><placeName ref="l301">Lugdunum</placeName> iam spe devorarunt.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Dominus protegat <lb xml:id="p1z41"/>et servet <placeName ref="l301">Lugdunum</placeName>!</s>
					<s n="20" xml:lang="la">Oremus absque intermissione <pb/><lb xml:id="p2z1"/>dominum, ut nos servet; multa enim et m<lb xml:id="p2z2"/>agna instant pericula.</s>
					<s n="21" xml:lang="la">Simus tamen fortes in domino.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="salute"><lb xml:id="p2z3"/>In hoc vale una cum fratribus et symmystis omnibus; <lb xml:id="p2z4"/>nostri omnes vos, te inprimis, salutant.</s>
					<s n="23" xml:lang="la" ana="salute">Si quando <lb xml:id="p2z5"/>ad <persName ref="p8033">Bezam</persName> scripturus es, saluta illum omnium nostrum <lb xml:id="p2z6"/>nomine.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Dominus ei benedicat et liberet ipsum a malo!</s>
					<s n="25" xml:lang="la" ana="farewell">Iterum iterumqu<lb xml:id="p2z7"/>e vale.</s>
					<s n="26" xml:lang="la">19. iunii 1562.</s>
				</p>
				<p>
					<s n="27" xml:lang="la">Caetera <persName ref="p4440">Budaeus</persName>.</s>
				</p>
				<p>
					<s n="28" xml:lang="la">Tuus ex animo <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="29" xml:lang="la">Dicet de lit<lb xml:id="p2z8"/>eris <persName ref="p20484">Ioan[nis] Frideri[ci</persName>] <placeName ref="l749">Sa<lb xml:id="p2z9"/>xonis</placeName> ad senatum huius urbis missis.</s>
					<s n="30" xml:lang="la">Clarissimo viro <lb xml:id="p2z10"/>d. <persName ref="p540">Ioanni Calvino</persName>, <placeName ref="l167">Genevensis</placeName> eccle<lb xml:id="p2z11"/>siae pastori fidelissimo, <lb xml:id="p2z12"/>domino meo colendo et fratri c<lb xml:id="p2z13"/>harissimo.</s>
					<s n="31" xml:lang="de"><placeName ref="l167">Genff</placeName>.</s>
				</p>
			</div>
