	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil me apud magistratum nostrum efficere <lb xml:id="p1z2"/>potuisse intellexisti ex <persName ref="p8033">Beza</persName>, ad quem hisce diebus <lb xml:id="p1z4"/>scripsi.</s>
					<s n="3" xml:lang="la">Interea intelligo principes germanos ante annum ita <lb xml:id="p1z5"/>convenisse cum rege <persName ref="p18477">Ferdinando</persName> ut nos pro exclusi<lb xml:id="p1z6"/>s agnoscant et non foveant.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Frustra ergo ageretur, <lb xml:id="p1z7"/>cum illis nisi quis simpliciter reciperet <lb xml:id="p1z8"/><placeName ref="l18">Augustanam</placeName> confessionem.</s>
					<s n="5" xml:lang="la">Id quod ante annos aliquot varie <lb xml:id="p1z9"/>et multum a <persName ref="p467">Bucero</persName> tentatum a nostris nunquam <lb xml:id="p1z10"/>impetrari potuit.</s>
					<s n="6" xml:lang="la">Exhibebit hic edictum principum <lb xml:id="p1z11"/><placeName>Stettinensium</placeName> ex quo intelliges non omnino <lb xml:id="p1z12"/>vana esse quae modo commemoravi et ab amicis fidis <lb xml:id="p1z13"/>perscribuntur ad me.</s>
					<s n="7" xml:lang="la">Pontificii arte veteratoria <lb xml:id="p1z14"/>et diabolica illos sibi coniungunt, ut eos a nobis a<lb xml:id="p1z15"/>vellant.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Sed satis nobis fuerit coniunctos nos esse <lb xml:id="p1z16"/>cum Christo et nos consentire, quibus Dominus dedit unum <lb xml:id="p1z17"/>et idem sentire.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Cavendum ne et nos divellamur.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Variae enim et graves sunt tentatione<lb xml:id="p1z19"/>s Sathanae.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Commendo tibi hunc virum bonum <persName>Ioannem <lb xml:id="p1z20"/>Limum</persName> <placeName ref="l2524">Scotum</placeName>.</s>
					<s n="12" xml:lang="la">Multa tibi referre poterit de <lb xml:id="p1z21"/><persName>Philippo</persName> nostro, qui, si fortior esset et libere quod <lb xml:id="p1z22"/>sentit proferret, apud multos rectius haberet res.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z23"/>Quamquam satis certum sit adversarios nostros <lb xml:id="p1z24"/>nihil commovendos.</s>
					<s n="14" xml:lang="la">Insano enim furore feruntur.</s>
					<s n="15" xml:lang="la" ana="farewell"><lb xml:id="p1z25"/>Vale, domine colendissime et frater charissime.</s>
					<s n="16" xml:lang="la" ana="salute">Salutabis <lb xml:id="p1z26"/>symmystas omnes.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Salutabis D. <persName ref="p4440">Budaeum</persName>, D. <persName ref="p8078">Ion<lb xml:id="p1z27"/>villeum</persName>, D. <persName ref="p4227">Badium</persName>, D. <persName>Laur</persName>.</s>
					<s n="18" xml:lang="la"><persName>Normandium</persName> et alios nobis notos.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z28"/>Ex <placeName ref="l834">Italia</placeName> audimus inter pontificem et <lb xml:id="p1z30"/>reges serio tractari de pace etc.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 19<lb xml:id="p1z31"/>. <lb xml:id="p1z32"/>Iulii Anno 1557.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z33"/><persName ref="p495">Bullingerus</persName> Tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro D. <persName ref="p540">Ioanni <lb xml:id="p2z2"/>Calvino</persName> <placeName ref="l167">Genevensis</placeName> <lb xml:id="p2z3"/>ecclesiae fido pastori, Domino <lb xml:id="p2z4"/>colendo et fratri <lb xml:id="p2z5"/>charissimo suo.</s>
					<s n="23" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l167">Genff</placeName>.</s>
				</p>
			</div>
		</body>
