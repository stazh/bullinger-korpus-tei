	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Redii salvus et incolumis cum mea familia <lb xml:id="p1z2"/>per dei gratiam ex <placeName ref="l21">Balneo Vultureno</placeName>.</s>
					<s n="3" xml:lang="la">Eo ad me <lb xml:id="p1z3"/>delatae sunt tuae literae, ex quibus non modicum doloris <lb xml:id="p1z4"/>concepi, quod viderim c[auss]am, quam tibi com<lb xml:id="p1z5"/>mendaram, d. <persName ref="p4037">Zanchi</persName> non ita, ut speraram, <lb xml:id="p1z6"/>esse compositam.</s>
					<s n="4" xml:lang="la"><placeName ref="l648">Rhetia</placeName> non habet multos <persName ref="p4037">Zanchos</persName>; <lb xml:id="p1z7"/>ergo si fratres hunc dimiserint, viderint, quomodo <lb xml:id="p1z8"/>sarciant suum damnum.</s>
					<s n="5" xml:lang="la">Forte dabit adhuc dominus, <lb xml:id="p1z9"/>ut amice componatur dissidium et restituatur <persName ref="p4037">Zanchus</persName>.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Dominus praestet auxilium!</s>
					<s n="7" xml:lang="la">Petitur a nobis, <lb xml:id="p1z11"/>ut videbis in appositis his literis, studium pacis <lb xml:id="p1z12"/>per principes.</s>
					<s n="8" xml:lang="la">Quid vobis videatur, <lb xml:id="p1z13"/>libenter audiemus.</s>
					<s n="9" xml:lang="la">Nam haec ad vos quoque ut <lb xml:id="p1z14"/>eiusdem nobiscum confessionis consortes referimus.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/>Ecclesia <placeName ref="l808">Belgarum</placeName> vehementer affligitur; res ergo <lb xml:id="p1z16"/>poscit, ut pro illa supplicemus domino.</s>
					<s n="11" xml:lang="la">Variae <lb xml:id="p1z17"/>circumferuntur narrationes de <placeName ref="l875">Hispanico</placeName> et <placeName ref="l834">Italico</placeName> <lb xml:id="p1z18"/>exercitu, qui <placeName ref="l306">Mediolani</placeName> et in <placeName ref="l736">Pedem<lb xml:id="p1z19"/>ontio</placeName> est collectus.</s>
					<s n="12" xml:lang="la">Alii ducendum putant <lb xml:id="p1z20"/>contra <placeName ref="l808">Belgas</placeName>, alii contra <placeName ref="l167">Genevam</placeName>.</s>
					<s n="13" xml:lang="la">Sunt, qui affirment <lb xml:id="p1z21"/>coniurasse authore pontifice imperatorem, <lb xml:id="p1z22"/>reges <placeName ref="l832">Galliae</placeName> et <placeName ref="l875">Hispaniae</placeName>, principes <lb xml:id="p1z23"/><placeName ref="l834">Italiae</placeName>, episcopos ac praelatos in excidium nostrum <lb xml:id="p1z24"/>omniumque Christi verbo credentium.</s>
					<s n="14" xml:lang="la">Orandus <lb xml:id="p1z25"/>est dominus, ut suorum misereatur.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Vale, domine <lb xml:id="p1z26"/>et frater colende atque dilecte.</s>
					<s n="16" xml:lang="la">Brevior sum, <lb xml:id="p1z27"/>quam velim, quia variis distrahor negotiis.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z28"/><placeName ref="l587">Tiguri</placeName> 4. iulii 1567.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z29"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <persName ref="p8016">Thobiae <lb xml:id="p2z2"/>Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fido, domino <lb xml:id="p2z4"/>et fratri meo colendo et <lb xml:id="p2z5"/>dilecto.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
