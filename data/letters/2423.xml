	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Laboro iam diebus aliquot gravi capitis <lb xml:id="p1z2"/>distillatione in corpus, scotomia, doloribus <lb xml:id="p1z3"/>dentium maximis et aliis incommodis; ideo scribo partius[i. <lb xml:id="p1z4"/>S.v. parcius]; nam aegre haec exarare potui.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Schedam expensarum accepi, et placet <lb xml:id="p1z6"/>mihi <lb xml:id="p1z7"/>tua frugalitas; perge sic et probaberis.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Literas hic mitto, alias quidem inscriptas <lb xml:id="p1z9"/>illustrissimo principi <placeName ref="l213">Hessorum</placeName> et d. d. <persName ref="p8386">Andreae <lb xml:id="p1z10"/>Hyperio</persName>, alias commatri <persName ref="p1560">Hopperae</persName>, alias <lb xml:id="p1z11"/>d. d. <persName ref="p3902">Wolphgango Waydnero</persName> <placeName ref="l569">Wormaciam</placeName>; <lb xml:id="p1z12"/>has, oro, procura mature et tuto.</s>
					<s n="5" xml:lang="la">Uteris <lb xml:id="p1z13"/>auxilio et consilio domini tui d. <persName ref="p505">Burcheri</persName>, <lb xml:id="p1z14"/>d. <persName ref="p8111">Martyris</persName>, cui has dabis ipsi inscriptas.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Consulet et d. <persName ref="p8362">Garnerius</persName> etc.</s>
					<s n="7" xml:lang="la"><persName ref="p3375">Vergerio</persName> <lb xml:id="p1z16"/>inscriptas servato; brevi enim <lb xml:id="p1z17"/>ad vos venturus est; nisi nunc apud vos sit.</s>
					<s n="8" xml:lang="la">Si dis<lb xml:id="p1z18"/>cessit, remitte ad me per primum forte oblatum nuncium; <lb xml:id="p1z19"/>sunt enim momenti alicuius istae literae, quippe ad m<lb xml:id="p1z20"/>e missae per legatum regium, qui modo <lb xml:id="p1z21"/><placeName ref="l760">Soloduro</placeName> discessit; in locum eius successit al<lb xml:id="p1z22"/>ius.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Res nostrae alioqui sunt in sat<lb xml:id="p1z23"/>is <lb xml:id="p1z24"/>felici statu, deo gratia.</s>
					<s n="10" xml:lang="la">Dominus stabilitatem <lb xml:id="p1z25"/>et augmentum felicitatis concedat.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p7224">Anna</persName> iam aucta est ex <persName ref="p4091">Zvinglio</persName> filiola <lb xml:id="p1z27"/><persName ref="p7224">Anna</persName>.</s>
					<s n="12" xml:lang="la">Valent reliqui liberi omnes.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z28"/><persName>Ioannes Otmarus Wipfius</persName> excusatus est, et <lb xml:id="p1z29"/>quantum intelligo, locum habet satis commodum.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z30"/>Miramur, an <placeName>Zellia</placeName> migrarit ad dominum.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z31"/>D. d. <persName ref="p4037">Zanchum</persName> salutabis, indicabis illi me <lb xml:id="p1z32"/>binas ab eo accepisse literas una cum praefatione; <lb xml:id="p1z33"/>maluissem vidisse tractationem de <lb xml:id="p1z34"/>plectendis haereticis, atamen gratias agito <lb xml:id="p1z35"/>diligentissime pro isti eleganti munere.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z36"/>D. <persName ref="p1422">Iacobum Haddonum</persName> <placeName ref="l830">Anglum</placeName> diligenter salutabis; <lb xml:id="p1z37"/>indicabis curaturum me, ne quid <lb xml:id="p1z38"/>libelli illius edatur, de quo ille ad me scrip<lb xml:id="p1z39"/>sit.</s>
					<s n="17" xml:lang="la">Nihil nunc, quod scriberem, habe.</s>
					<s n="18" xml:lang="la" ana="salute"><lb xml:id="p1z40"/>Vale una cum tota domo vestra; omnes nostri <lb xml:id="p1z41"/>vos salutant.</s>
					<s n="19" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 12. octobris a<lb xml:id="p1z42"/>nno <lb xml:id="p1z43"/>1554.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z45"/><persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Dilecto meo filio <lb xml:id="p2z2"/><persName ref="p487">Heinrycho Bullingero</persName> <lb xml:id="p2z3"/><placeName ref="l491">Argentinae</placeName> <lb xml:id="p2z4"/>agenti in aedibus d. <lb xml:id="p2z5"/><persName ref="p505">Burcheri</persName> <placeName ref="l830">Angli</placeName>.</s>
				</p>
				<p>
					<s n="22" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l491">Straßburg</placeName><lb xml:id="p2z7"/>.</s>
					<note>Nach Notiz am 25. Oktober erhalten.</note>
				</p>
			</div>
