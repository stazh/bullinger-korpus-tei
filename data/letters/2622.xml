	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Mitto proprium hunc nuncium, tantum ut <lb xml:id="p1z2"/>te rogem, <persName ref="p495">H[einrice] Bullingere</persName>, ut nuncies d. <lb xml:id="p1z3"/><persName ref="p20206">Gribaldo</persName>, qui brevi per <placeName ref="l587">Tigurum</placeName> iter facturus <lb xml:id="p1z4"/>est, ut istic subsistat, dum ego possim <lb xml:id="p1z5"/>cum eo loqui, et affirma me <lb xml:id="p1z6"/>ad summum die 15. maii affuturum.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z7"/>Qu<lb xml:id="p1z8"/>in non modo te, sed magnificum d. consu<lb xml:id="p1z9"/>lem nostrorum consiliariorum <lb xml:id="p1z10"/>nomine rogo, ut hoc, quod peto, fiat.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z11"/>Significato omnibus hospitibus, ut, si talis <lb xml:id="p1z12"/>persona venerit, vobis renuncient, ut <lb xml:id="p1z13"/>possitis indicare, quod petimus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z14"/>Adero, inquam, egomet procul dubio.</s>
					<s n="5" xml:lang="la">Audies <lb xml:id="p1z16"/>me vocari in <placeName ref="l2562">Prussiam</placeName> (ad tempus), aud<lb xml:id="p1z17"/>ies fabam cudi in alia capita quam Luteran<lb xml:id="p1z18"/>orum in comitiis, hos liberos futuros, <lb xml:id="p1z19"/>alios persecutionem passuros (saltem verbis).</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z20"/>Glosam afferam <lb xml:id="p1z21"/>ego, <lb xml:id="p1z22"/>qua<lb xml:id="p1z23"/>mquam satis puto <lb xml:id="p1z24"/>te intelligere.</s>
					<s n="7" xml:lang="la">Sed omnia tandem recte <lb xml:id="p1z25"/>sic afferam.</s>
					<s n="8" xml:lang="la" ana="salute">Salvere iubeo tres generos tuos ac reli<lb xml:id="p1z26"/>quos fratres, item <placeName ref="l830">Anglo<lb xml:id="p1z27"/>s</placeName> e<lb xml:id="p1z28"/>t <placeName ref="l294">Locarnenses</placeName>; audio enim auctum esse numer<lb xml:id="p1z29"/>um filiorum dei <lb xml:id="p1z30"/>exulumque.</s>
					<s n="9" xml:lang="la">Dux adhuc <pb/><lb xml:id="p2z1"/><placeName ref="l18">Augustae</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z2"/><placeName ref="l496">Stut<lb xml:id="p2z3"/>gardiae</placeName> 27. aprilis <lb xml:id="p2z4"/>1555.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z5"/>Scribe, quid istic de novo antichristo.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z6"/>Nos audimus de <persName>Sancta Cruce</persName>, <lb xml:id="p2z7"/>qui multis crucem dabit; <lb xml:id="p2z8"/>non est in orbe inimicitior <lb xml:id="p2z9"/>vi<lb xml:id="p2z10"/>r evangelio, crede mihi; <lb xml:id="p2z11"/>ille dictavit breve, ubi <lb xml:id="p2z12"/>vocamur deteriores <placeName ref="l2510">Tur<lb xml:id="p2z13"/>cis</placeName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z14"/>Clarissimo viro domino <persName ref="p495">H[ei<lb xml:id="p2z15"/>nrico] Bullingero</persName>, antistiti <lb xml:id="p2z16"/><placeName ref="l587">Tigurino</placeName>, fratri honorando.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z17"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
