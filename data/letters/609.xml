	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Ob eam potissimum causam, <persName ref="p495">Bullingere</persName> in <lb xml:id="p1z2"/>domino observandissime, ad te iam scribere volui, <lb xml:id="p1z3"/>ut, qui has reddit, occasionem habeat vicissim <lb xml:id="p1z4"/>literas abs te accipiendi.</s>
					<s n="3" xml:lang="la">Alias enim nihil est <lb xml:id="p1z5"/>in praesenti, quod magnopere ut scribatur <lb xml:id="p1z6"/>referat, nisi unum hoc, quod uxor petit <lb xml:id="p1z7"/>ut scribam.</s>
					<s n="4" xml:lang="la">Indicat illa mihi cupere te <lb xml:id="p1z8"/>infantem, quod in utero gestat, e sacro <lb xml:id="p1z9"/>baptismatis fonte levare, si masculus sit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Hic animus tuus non solum uxori, sed et <lb xml:id="p1z11"/>aliis nonnullis innotuit, tandem uxoris <lb xml:id="p1z12"/>indicio mihi significatus est; quem ego in te <lb xml:id="p1z13"/>tanquam candidum et syncerum cupidissime <lb xml:id="p1z14"/>complector.</s>
					<s n="6" xml:lang="la">Illud autem scire cupimus, quid <lb xml:id="p1z15"/>facturus sis, si non masculum dominus, sed femellam <lb xml:id="p1z16"/>dederit.</s>
					<s n="7" xml:lang="la">Optaremus in eo casu honestissimam <lb xml:id="p1z17"/>uxorem tuam nobis fieri commatrem, nisi illud <lb xml:id="p1z18"/>plus haberet molestię, quam ab illa propter cor<lb xml:id="p1z19"/>pusculi debilitatem praestari possit.</s>
					<s n="8" xml:lang="la">Restant adhuc <lb xml:id="p1z20"/>circiter 8 septimanę usque ad tempus partus.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z21"/>Obsecro, scribas interea, quid faciendum existimes.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z22"/>Si masculum dederit dominus, iam hoc ipso te <lb xml:id="p1z23"/>in compatrem eligimus; si femellam, quid <lb xml:id="p1z24"/>tum facere velis, significa.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z25"/>Cęterum res meae utcunque tolerabiliter habent, <lb xml:id="p1z26"/>nisi quod nondum plene convalui a molestia <lb xml:id="p1z27"/>febrili, quę me post uxorem ac liberos <lb xml:id="p1z28"/>sanitati restitutos corripuit.</s>
					<s n="12" xml:lang="la">Spes tamen est <lb xml:id="p1z29"/>brevi fore, ut pristinę sanitati ex integro <lb xml:id="p1z30"/>restituar.</s>
					<s n="13" xml:lang="la" ana="farewell">Optime vale, virorum charissime.</s>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z31"/>Salutem honestissimę uxori ac toti domui tuę <lb xml:id="p1z32"/>meo ac meorum nomine.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1549 <lb xml:id="p1z33"/>ultima iulii.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z34"/>Salutem etiam <persName ref="p8440">Gervasio</persName> <lb xml:id="p1z36"/>nostro, quem viduum dominus <lb xml:id="p1z37"/>in exilio consoletur.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><persName ref="p8417">W[ol<lb xml:id="p1z38"/>fgangus] Musculus</persName>, tuus in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo M. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho <lb xml:id="p2z4"/>Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z5"/>ecclesię antistiti <lb xml:id="p2z6"/>vigilantissimo, <lb xml:id="p2z7"/>domino ac fratri <lb xml:id="p2z8"/>in Christo charissimo.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z9"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
