	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, clarissime vir.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Adest tibi meus nepos, qui de <lb xml:id="p1z2"/>rebus, quae ad me pertinent, reddet te certiorem.</s>
					<s n="3" xml:lang="la">Quare non <lb xml:id="p1z3"/>est, quod de his ego scribam.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ostendet tibi praefationem <lb xml:id="p1z4"/>libri, qui hic erat excudendus, nisi ego pręsertim invi<lb xml:id="p1z5"/>gilarem.</s>
					<s n="5" xml:lang="la">Nunquid pro hoc opere lapidabor quoque quemad<lb xml:id="p1z6"/>modum et pro eiecto <persName ref="p20206">Gribaldo</persName> et pro altero libello accusato <lb xml:id="p1z7"/>lapidatus sum?</s>
					<s n="6" xml:lang="la">Ergo debui ferre omnia ista venena.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/>Misera est nostra condicio; si prohibemus, si eiicimus, <lb xml:id="p1z9"/>armamus multorum importunitatem contra nos; si non pro<lb xml:id="p1z10"/>hibemus, non eiicimus, inficiuntur ecclesiae.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Sed mallo <lb xml:id="p1z11"/>ferre insolentiam hominum quam iram dei.</s>
					<s n="9" xml:lang="la">In summa: <lb xml:id="p1z12"/>talia scripta sparguntur, qualia vides; unde autem hoc pro<lb xml:id="p1z13"/>dierit, nepos indicabit.</s>
					<s n="10" xml:lang="la">Affuit nuper ex <placeName ref="l2472">Polonia</placeName> <lb xml:id="p1z14"/>legatus ad meum principem, qui affirmavit in sua <lb xml:id="p1z15"/>patria non deesse initia istius pestilentiae.</s>
					<s n="11" xml:lang="la">Etsi <lb xml:id="p1z16"/>pacem videas, etsi inducias cum <placeName ref="l2510">Turca</placeName>, nos tamen <lb xml:id="p1z17"/>scimus, nihil esse nobis ab his comitiis metuendum.</s>
					<s n="12" xml:lang="la">Ec<lb xml:id="p1z18"/>quid non beo te?</s>
					<s n="13" xml:lang="la">Mitto libellos propediem habiturus <lb xml:id="p1z19"/>et quatuor de <persName>Osio</persName> dialogos; sunt enim sub praelo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z20"/>Non desunt et profectionum et studiorum labores, <lb xml:id="p1z22"/>quos libenter fero; magis molestae sunt quorundam <lb xml:id="p1z23"/>falsae de meis actionibus interpretationes <lb xml:id="p1z24"/>atque invidiae.</s>
					<s n="15" xml:lang="la">Sed omnia iudicio dei relinquo sus<lb xml:id="p1z25"/>tentoque me bona conscientia interea.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Ora pro <lb xml:id="p1z26"/>me cum tota familia, schola atque ecclesia.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z27"/><placeName ref="l512">Tubingae</placeName> die 29. aprilis 1559.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z28"/><persName ref="p3375">Vergerius</persName> tuus.</s>
				</p>
				<p>
					<note>[Von anderer Hand:]</note>
					<s n="20" xml:lang="la">Clarissi<pb/><lb xml:id="p2z1"/>mo viro domino <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bulingero</persName>, fratri honorando.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
