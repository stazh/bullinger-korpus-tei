	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Augusti 7. coepi aegrotare et hactenus <lb xml:id="p1z2"/>decumbo, aliquoties obambulo, ut possum.</s>
					<s n="3" xml:lang="la">In<lb xml:id="p1z3"/>gentes sustineo dolores ex latere dextro <lb xml:id="p1z4"/>maxime ea parte, qua cingor.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Doctores putant <lb xml:id="p1z5"/>esse calculum; sed, quae adhibent, non iuvant.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Annus prope est, quando eodem decubui morbo, <lb xml:id="p1z7"/>tum cum pestis me corripuisset; tunc quoque varia <lb xml:id="p1z8"/>adhibuerunt medicamenta, sed frustra omnia.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Subsidit <lb xml:id="p1z9"/>deinde dolor per se, imo per die gratiam; ei me <lb xml:id="p1z10"/>nunc quoque commendo.</s>
					<s n="7" xml:lang="la">Tu pro me precaberis.</s>
				</p>
				<p>
					<s n="8" xml:lang="de">Ich han <lb xml:id="p1z11"/>kein ruͦw, ouch minder kurtzwyl dann etc.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z12"/>Omnes tuae et singulae mihi redditae sunt literae, <lb xml:id="p1z13"/>priores per <persName>Walderum</persName> cursorem, posteriores <lb xml:id="p1z14"/>hodie.</s>
					<s n="10" xml:lang="la">Valde et me angit negotium episcopale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z15"/>Canonici in literis suis prolixis illis resipiuin<lb xml:id="p1z16"/>t antiquum; gaudeo Domum Dei adegisse eos <lb xml:id="p1z17"/>ad palinodiam.</s>
					<s n="12" xml:lang="la">Quae de <placeName ref="l2510">Turcis</placeName> fusis <lb xml:id="p1z18"/>scibuntur, fabulosa puto; cum enim <placeName ref="l2510">Turcae</placeName> oppugn<lb xml:id="p1z19"/>ent <persName>S. Michaelis</persName> castrum, omnia tenent maris, <lb xml:id="p1z20"/>ut nemo in urbem <placeName>Melitensem</placeName> aut ex urbe ven<lb xml:id="p1z21"/>ire possit, qui haec nuntiet.</s>
					<s n="13" xml:lang="la">Omnia capta suspicor <lb xml:id="p1z22"/>et haec fingi, ut terror <placeName ref="l834">Italiae</placeName> minuatur.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z23"/>3. septembris comitia conscripta sunt <placeName ref="l300">Lucernam</placeName> 7 Pagis <lb xml:id="p1z24"/>Catholycis et papae; divina, quid futurum.</s>
					<s n="15" xml:lang="de"><lb xml:id="p1z25"/>Es ist hie ein müntztag xin; <foreign xml:lang="la">quid factum ignoro;</foreign> <lb xml:id="p1z26"/>dann ich minem wee zuͦ losen hab.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z27"/>Pro copiosa et diligenti scriptione tua ago tibi <lb xml:id="p1z28"/>gratias; ubi revaluero, urgebo tuum negotium, de quo <lb xml:id="p1z29"/>bene spero; prohibui [nominiuͦs]<note type="misc">... modis</note> omnibus, ne quid ad vestros scribatur.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z30"/>Dum haec obsignaturus sum, <placeName ref="l167">Geneva</placeName> feruntur literae a d. <persName ref="p2740">Roseto</persName> <lb xml:id="p1z31"/>syndico.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><persName>Cardinalis Loth[aringiae</persName>] accusatur apud regem, qui gra<lb xml:id="p1z32"/>viter illi indignatur; amici <placeName ref="l691">Lotharingi</placeName> hostes facti sunt; <lb xml:id="p1z33"/>dicitur se insinuasse in tutelam alterius principis.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z34"/>Legati <placeName ref="l875">Hispani</placeName> <placeName>Baionae</placeName> postularunt a rege <persName>Francisco</persName>, 1. <lb xml:id="p1z35"/>renunciet <placeName ref="l2510">Turcico</placeName> foederi, 2. aboleat edictum de religionis <lb xml:id="p1z36"/>pace, 3. recipiat concilium <placeName ref="l1107">Tridentinum</placeName> et ei subscribat, <lb xml:id="p1z37"/>4. nihil sibi iuris sumat in <placeName>Terra Florida</placeName> etc.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="farewell">Val<lb xml:id="p1z38"/>e.</s>
				</p>
				<p>
					<s n="21" xml:lang="de">Ich mag nitt me.</s>
					<s n="22" xml:lang="la">17. augusti.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="salute">Salvus sit d. legatus, <lb xml:id="p1z40"/>salvi d. d. consules et amici nostri.</s>
					<s n="24" xml:lang="la">1565.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z41"/>Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
