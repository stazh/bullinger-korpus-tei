	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Audio te libellum accepisse de <lb xml:id="p1z2"/>omnibus, quę acta sunt <placeName ref="l546">Wiennae</placeName> <placeName ref="l850">Austrię</placeName> cum pistore.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Ego paucis hanc historiam habeo... descriptam; si <lb xml:id="p1z4"/>non vultis excudere hoc crudele exemplum, mitte ad me ea, <lb xml:id="p1z5"/>quę tu habes, et si vis aliquid addere, adde, et ego curabo, <lb xml:id="p1z6"/>ut apud nos excudatur tam crudelis historia.</s>
					<s n="4" xml:lang="la">Si autem <lb xml:id="p1z7"/>scire vis, quę <placeName ref="l491">Argentinę</placeName> aguntur, poteris affinem <lb xml:id="p1z8"/>meum profugum interrogare, qui ea fusissime nar<lb xml:id="p1z9"/>raturus est, quę acta sunt hactenus <placeName ref="l491">Argentinę</placeName> <lb xml:id="p1z10"/>et quę spes sit futura tam de civibus quam de <lb xml:id="p1z11"/>concionatoribus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Caesar <placeName ref="l1284">Bruxellę</placeName> adhuc in latebris <lb xml:id="p1z12"/>occlusus est foedus inter <persName>Gallum</persName> et <persName>Anglum</persName> omnibus modis <lb xml:id="p1z13"/>impedire satagens, quo monarcha fiat <placeName ref="l2536">Europae</placeName> <lb xml:id="p1z14"/>aut saltem <placeName ref="l822">Germanię</placeName>.</s>
					<s n="6" xml:lang="la">Si <placeName ref="l832">Galliam</placeName> invasurus est, <lb xml:id="p1z15"/>in spe habet et <placeName ref="l862">Helvetiam</placeName>, quę hactenus illius consilia <lb xml:id="p1z16"/>impedivit.</s>
					<s n="7" xml:lang="la">Expectamus Decadem tertiam.</s>
					<s n="8" xml:lang="la">A <lb xml:id="p1z17"/><persName ref="p8418">Myconio</persName> habebis literas podogram a medico <persName ref="p1278">Gastio</persName> <lb xml:id="p1z18"/>divinatam negantes.</s>
					<s n="9" xml:lang="la">Utinam ita sit, et sim hac in <lb xml:id="p1z19"/>re fallax divinator.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale.</s>
					<s n="11" xml:lang="la">11. februarii 1550.</s>
					<s n="12" xml:lang="la" ana="salute"><lb xml:id="p1z20"/>D. <persName ref="p8171">Theodorum</persName> et <persName ref="p8127">Pellicanum</persName> salutabis meo nomine.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><persName ref="p1278">I[oannes] G[astius</persName>].</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z21"/>Mitto tibi pr<pb/><lb xml:id="p2z1"/>aeterea literas ex <placeName ref="l830">Anglia</placeName> missas...</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><persName ref="p8121">Montio</persName>.</s>
					<s n="16" xml:lang="la">Si quid habes communicandum, ne <persName ref="p1278">Gastium</persName> celes oro.</s>
					<s n="17" xml:lang="la">D. <persName ref="p495">Heinrycho Bul<lb xml:id="p2z2"/>lingero</persName>, pastori vigilantissimo <placeName ref="l587">Tigurinae</placeName> ecclesiae, suo in domino charissimo.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><placeName ref="l587">Z<lb xml:id="p2z3"/>urich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
