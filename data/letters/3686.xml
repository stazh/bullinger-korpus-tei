	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tuas accepi literas, cum essem <placeName ref="l41">Berne</placeName>, et habeo gratiam, quod <lb xml:id="p1z2"/>adeo sis sollicitus pro filio.</s>
					<s n="3" xml:lang="la">De nostris, an sint congressuri, dubito.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z3"/>Que tibi sunt renunciata de <persName ref="p18995">Andelotio</persName>, de d. <persName>a Thermes</persName>, de navibus captis <lb xml:id="p1z4"/>aut demersis, nihil intellexi et puto falsa esse et non verissimilia, <lb xml:id="p1z5"/>cum <persName>Caletum</persName> non opus habeat commeatu et sit munitissimum.</s>
					<s n="5" xml:lang="la"><placeName ref="l830">Angli</placeName>, qui <lb xml:id="p1z6"/>in <placeName ref="l2705">Aquitaniam</placeName> volebant descendere, clade accepta eiecti sunt.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Eorum <persName ref="p18554">regina</persName> <lb xml:id="p1z7"/>hidropisi laborat incurabili.</s>
					<s n="7" xml:lang="la">Tuas misi literas d. <persName>Sanlaurentio</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Ex amicis <lb xml:id="p1z8"/>et affinibus misit ad me carmen, quod dedit d. cardinali, cum sermo esset <lb xml:id="p1z9"/>de pace; non displicebit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">D. <persName ref="p8011">Galtero</persName> et <persName ref="p8111">Martiri</persName> multam ex me salutem dicito <lb xml:id="p1z10"/>meque tuis precibus Christo commenda.</s>
					<s n="10" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l760">Soluturi</placeName> 29. augusti.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z11"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Henrico Bullingero</persName>.</s>
				</p>
				<p>
					<note>[Von anderer Hand.]</note>
				</p>
			</div>
		</body>
	</text>
