	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l957">Pinsoviae</placeName> 4. novembris 1557.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Salutem in domino nostro Iesu Christo perpetuam.</s>
					<s n="3" xml:lang="la">Non dubito, <lb xml:id="p1z3"/>domine et amice longium omnium charissime, quin anxio solicitoque <lb xml:id="p1z4"/>animo expectes nuntium laetum de meo salvo in <lb xml:id="p1z5"/><placeName ref="l2472">Poloniam</placeName> adventu.</s>
					<s n="4" xml:lang="la"><persName ref="p8354">Laetus</persName>, salvis incolumisque dei optimi <lb xml:id="p1z6"/>maximi benefitio ante octiduum <placeName ref="l260">Cracoviam</placeName> veni et <lb xml:id="p1z7"/>a <placeName ref="l260">Cracovia</placeName> <placeName ref="l957">Pinzoviam</placeName>.</s>
					<s n="5" xml:lang="la">D. <persName ref="p8041">Ioannem a Lasco</persName> virum <lb xml:id="p1z8"/>omnibus modis observandum tuique amantissimum salvum <lb xml:id="p1z9"/>reperi.</s>
					<s n="6" xml:lang="la">Is me propter commendationes tuas perhu<lb xml:id="p1z10"/>maniter accepit causamque meam diligenter apud <lb xml:id="p1z11"/>ducem palatinumque <placeName ref="l552">Vilnensem</placeName> per literas egit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Pri<lb xml:id="p1z12"/>vilegium me consequturum non dubito.</s>
					<s n="8" xml:lang="la">Proinde hinc <lb xml:id="p1z13"/>recta <placeName ref="l552">Vilnam</placeName> ad ducem ipsum et regiam maiestatem <lb xml:id="p1z14"/>post paucos dies profecturus sum.</s>
					<s n="9" xml:lang="la">Comitem iti<lb xml:id="p1z15"/>neris d. <persName>Guilhelmum Marlo</persName> olim <placeName>Badensis</placeName> sive <lb xml:id="p1z16"/><placeName>Thermopolis</placeName> <placeName ref="l830">Angliae</placeName> episcopum reperio, quem <lb xml:id="p1z17"/>mihi d. <persName ref="p8041">a Lasco</persName> adiunctum vult.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ex <placeName ref="l552">Vilna</placeName> tuae <lb xml:id="p1z18"/>humanitati, quid promoverim, diligenter scripturus sum.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/>Nova non sunt quam de victoria regis <placeName ref="l2472">Poloniae</placeName> <lb xml:id="p1z20"/>in <placeName ref="l2574">Livonenses</placeName>; verum deditio potius quam victoria <lb xml:id="p1z21"/>dici potest, licet coacti se dediderunt.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Pacis con<lb xml:id="p1z22"/>ditiones hae sunt: <lb xml:id="p1z23"/>Sumptus belli, nempe quadraginta milia aureorum <lb xml:id="p1z24"/><placeName ref="l2574">Livonenses</placeName> acceperant se daturos; sed rex eis haec <lb xml:id="p1z25"/>munifice condonavit.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z26"/>Certum numerum equitum regi in militiam dabunt; <lb xml:id="p1z27"/>de numero non constat, quamvis sint, qui putant qua<lb xml:id="p1z28"/>tuor quatuor milia, quandocunque iis opus habeat.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z29"/>Homicidas, qui legatos regis interfecerant, mittent <lb xml:id="p1z30"/>regi <placeName ref="l2472">Poloniae</placeName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z31"/>Si quid vi aut dolo acceperint a ducatu <placeName ref="l841">Lithuanae</placeName>, <lb xml:id="p1z32"/>id omne restituent.</s>
					<s n="16" xml:lang="la">Haec de conditionibus pacis.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z33"/>Caeterum quoniam scio humanit(at)em tuam avide sen<lb xml:id="p1z34"/>tentiam certam et apertam <persName ref="p2095">Melanchthonis</persName> de humanitate <lb xml:id="p1z35"/>Christi expectare, mitto tibi hanc, quam d. <persName ref="p8041">a <lb xml:id="p1z36"/>Lasco</persName> mihi describendam dedit.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Ea est exerpta <lb xml:id="p1z37"/>ex lectionibus viri et dictata, haecque sunt, quae Lu<lb xml:id="p1z38"/>therani eum recantare <placeName ref="l569">Wormatiae</placeName> voluerunt.</s>
					<s n="19" xml:lang="la">Dominus <lb xml:id="p1z39"/>det gratiam, ut aperte et palam veritatem tueatur.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z40"/>Hic in <placeName ref="l2472">Polonia</placeName> veritas dei optimi maximi benefitio <lb xml:id="p1z41"/>altius radices figit.</s>
					<s n="21" xml:lang="la">Nobilitatem docet confidenter <lb xml:id="p1z42"/>d. <persName ref="p8041">a Lasco</persName>, hodie per duas horas sermonem <lb xml:id="p1z43"/>habuit de vero et genuino intellectu verborum Christi, <lb xml:id="p1z44"/>hoc est corpus meum in mensa nobilis.</s>
					<s n="22" xml:lang="la">Convertit multos <lb xml:id="p1z45"/>et confirmat veram non lutheranam sententiam.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Dominus oran<pb/><lb xml:id="p2z1"/>dus, ut confirmetur.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Apud principem <placeName ref="l260">Cracoviae</placeName> septuagenarium <lb xml:id="p2z2"/>iam fuit, quem eo duxit, ut vere fateatur papam antichristum <lb xml:id="p2z3"/>esse neque quicquam eum moratur quam abusus, in quos <lb xml:id="p2z4"/>vertuntur ecclesiastica bona, et coenae dominicae genuinus <lb xml:id="p2z5"/>intellectus.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">De bonis ecclesiasticis, ut in pios usus vertantur, <lb xml:id="p2z6"/>facile consentient, paulatimque, ut imbibat verum <lb xml:id="p2z7"/>intellectum verborum Christi, sperat d. <persName ref="p8041">a Lasco</persName>.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">Vos com<lb xml:id="p2z8"/>mendate utrumque precibus domino.</s>
					<s n="27" xml:lang="la">Nam si lucrari posset, <lb xml:id="p2z9"/>magna spes est de tota <placeName ref="l2472">Polonia</placeName> hac minori.</s>
				</p>
				<p>
					<s n="28" xml:lang="la" ana="farewell">Vale <lb xml:id="p2z10"/>bene cum familia universa.</s>
				</p>
				<p>
					<s n="29" xml:lang="la" ana="salute">Haec, quaeso, qualiacunque <lb xml:id="p2z11"/>sint, communices d. <persName ref="p3988">Ioanni Wolfio</persName>, d. <persName>Sebastiano</persName>, <lb xml:id="p2z12"/>tuis generis et nobilibus <placeName ref="l2472">Poloniae</placeName>, quibus omnibus offitiosam salutem <lb xml:id="p2z13"/>a me dicito.</s>
					<s n="30" xml:lang="la">Tuus <persName ref="p505">Burcherus</persName>.</s>
				</p>
				<p>
					<s n="31" xml:lang="la">Uxorem meam tuo patrocinio com<lb xml:id="p2z14"/>mendo.</s>
				</p>
				<p>
					<s n="32" xml:lang="de">Dem ffürnemmen, <lb xml:id="p2z15"/>wysen hern <persName ref="p495">Heynrych Bullynger</persName>, predicanten, mynem gunstigen hern zuͦ <placeName>Zurych</placeName>.</s>
				</p>
