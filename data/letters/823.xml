	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. compater charissime.</s>
					<s n="2" xml:lang="la">Quas 17. mensis huius <lb xml:id="p1z2"/>dedisti, hodie primum accepi.</s>
					<s n="3" xml:lang="la">Quas <placeName ref="l822">Germanice</placeName> <lb xml:id="p1z3"/>de causa compatris nostri d. <persName ref="p8018">Halleri</persName> scripsisti, <lb xml:id="p1z4"/>mox domino quęstori legenda exhibui.</s>
					<s n="4" xml:lang="la">Iussit ille, <lb xml:id="p1z5"/>ut senatum accederem et archigrammatęo <lb xml:id="p1z6"/>evocato illa significarem; nam pedibus aeger <lb xml:id="p1z7"/>domum ipse iam menses aliquot non egreditur, <lb xml:id="p1z8"/>id quod in plerisque negociis tam ecclesiasticis <lb xml:id="p1z9"/>quam scholasticis haud parum impedimenti parit.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Significavi archigrammateo tua consilia; <lb xml:id="p1z11"/>respondit ille esse ista legatis ipsorum quam dili<lb xml:id="p1z12"/>gentissime in mandatis data, ut non <lb xml:id="p1z13"/>sit opus denuo monere senatum.</s>
					<s n="6" xml:lang="la">Itaque et <lb xml:id="p1z14"/>tu et ego et bonus quęstor, quod <lb xml:id="p1z15"/>causam hanc concernit, fecimus, quod decet <lb xml:id="p1z16"/>viros ecclesię consultum cupientes; iam, <lb xml:id="p1z17"/>quod reliquum est, curet dominus, et tu isthic <lb xml:id="p1z18"/>procul dubio facies sedulo, quod <lb xml:id="p1z19"/>fecisti hactenus.</s>
					<s n="7" xml:lang="la">Fiat vero et fiet etiam, <lb xml:id="p1z20"/>quod bonum est in oculis domini.</s>
					<s n="8" xml:lang="la">In calce literarum <lb xml:id="p1z21"/>obtestaris me, ne hinc discedam, quicquid <lb xml:id="p1z22"/>tandem fiat.</s>
					<s n="9" xml:lang="la">Animus meus, charissime compat<lb xml:id="p1z23"/>er, non parturit discessum, quamvis sit <lb xml:id="p1z24"/>hic locus multis de causis admodum molestus.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/>Interea tamen cogitabis, quam sit durum <lb xml:id="p1z26"/>telum necessitas, quę et nolentem impellit, <lb xml:id="p1z27"/>ut faciat, quod facere nollet.</s>
					<s n="11" xml:lang="la">Admodum <lb xml:id="p1z28"/>grave est servire tam opulentę reipublicę <lb xml:id="p1z29"/>cum rerum mearum detrimento et ea <lb xml:id="p1z30"/>insumere, quę erant in usus uxoris et <lb xml:id="p1z31"/>liberorum ad viduitatis et orphanię tempus <lb xml:id="p1z32"/>paterna sollicitudine et cura conservanda.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z33"/>Tenuiori ecclesię multo ad hunc modum ser<lb xml:id="p1z34"/>virem alacrius, quantumvis res meas in <lb xml:id="p1z35"/>illius gratiam insumerem.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Verum, quicquid sit, <lb xml:id="p1z36"/>domini sumus ego, uxor, liberi, et quae dedit, <lb xml:id="p1z37"/>omnia; illius providentia sic non est ampla et <lb xml:id="p1z38"/>augusta, ut necessitatis nostrę angustias spernat.</s>
					<s n="14" xml:lang="la" ana="farewell"><lb xml:id="p1z39"/>Optime vale, compater in domino charissime.</s>
					<s n="15" xml:lang="la" ana="salute">Salutem tuis <lb xml:id="p1z40"/>omnibus meo ac meorum omnium nomine.</s>
					<s n="16" xml:lang="la"><placeName ref="l41">Bernę</placeName> 29. ianuarii 1550.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><persName ref="p8417">W[olfgangus] <lb xml:id="p1z41"/>Musculus</persName> tuus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo m. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z5"/>ecclesiae pastori <lb xml:id="p2z6"/>vigilantissimo, <lb xml:id="p2z7"/>domino ac compatri <lb xml:id="p2z8"/>suo longe <lb xml:id="p2z9"/>charissimo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z10"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
