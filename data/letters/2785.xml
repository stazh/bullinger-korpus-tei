	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Tuas, honorande domine compater, per d. <persName ref="p1936">Lysmaninum</persName> <lb xml:id="p1z2"/>missas accepi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Exposuit is nobis copiose successum <lb xml:id="p1z3"/>veritatis in <placeName ref="l2472">Polonia</placeName>.</s>
					<s n="4" xml:lang="la">Dominus provehat eam passim magis <lb xml:id="p1z4"/>ac magis.</s>
					<s n="5" xml:lang="la">Apud nos nihil est rerum novarum, nisi quod <lb xml:id="p1z5"/>d. <persName ref="p7510">Ioannes Rodolphus a Grafenriett</persName>, tribunus ille, qui me <lb xml:id="p1z6"/>primo e <placeName ref="l587">Tiguro</placeName> excivit, <placeName>Sanensibus</placeName> praefectus datus <lb xml:id="p1z7"/>est.</s>
					<s n="6" xml:lang="la">Novum hoc exemplum fuit in urbe nostra, ut tribunus <lb xml:id="p1z8"/>et tantus vir ad praefecturam aliquam ablegaretur; sed visus <lb xml:id="p1z9"/>est ipsemet hoc postulare et facile impetravit, quo authoritate <lb xml:id="p1z10"/>sua gentem efferam et omnis disciplinae impatientissim<lb xml:id="p1z11"/>am facilius cicuraret.</s>
					<s n="7" xml:lang="la">Dominus illi adsit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Addetur ei aliquis <lb xml:id="p1z12"/>ex numero nostro, qui una cum ipso proficiscatur ad reformand<lb xml:id="p1z13"/>as illic ecclesias.</s>
					<s n="9" xml:lang="la">Metuo, ne mihi haec sarcina subeunda <lb xml:id="p1z14"/>sit; omnes enim iam ante videntur in me consentire.</s>
					<s n="10" xml:lang="la">Grave <lb xml:id="p1z15"/>hoc erit mihi et <placeName ref="l18">Augustana</placeName> certe vocatione difficilius propter <lb xml:id="p1z16"/>incredibilem gentis barbariem et insolentem licentiam; si <lb xml:id="p1z17"/>tamen domino ita visum fuerit, praestabo, quae potero; dominus <lb xml:id="p1z18"/>dabit successum.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/>Quod te <persName>Mauritio</persName> et <persName>Benedicto</persName> <lb xml:id="p1z20"/>scripturum recipis, bene facis.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><persName>Benedictus</persName> et homo doctus <lb xml:id="p1z21"/>admodum et d. <persName ref="p1283">Gessnero</persName> familiaris.</s>
					<s n="13" xml:lang="la">Cuperem eos man<lb xml:id="p1z22"/>suetudine in amicitia retinere.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z23"/>Quod autem affinem <lb xml:id="p1z24"/>tuum attinet, locutus iam sum cum aliquibus amicis, <lb xml:id="p1z25"/>qui illius ordinis sunt, qui in tuam, quod scio, gratiam, <lb xml:id="p1z26"/>praestabunt, quantum poterunt, sed nullam dum mihi <lb xml:id="p1z27"/>certam spem facere potuerunt; fit enim hic, quod et <lb xml:id="p1z28"/>illic apud vos.</s>
					<s n="15" xml:lang="la">Magna scribarum est copia; hac enim ratione <lb xml:id="p1z29"/>plurimi ad praefecturas et alias dignitates conscendunt.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z30"/>Inde fit, ut civium plures suos hac arte instruant filios, <lb xml:id="p1z31"/>qui, si qua conditio vacaverit, multo numero ad expetendam <lb xml:id="p1z32"/>eam convolant.</s>
					<s n="17" xml:lang="la">Instabo tamen amplius et videbo, <lb xml:id="p1z33"/>quid obtineri possit.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z34"/><placeName ref="l167">Genevensium</placeName> hic nunc est m<lb xml:id="p1z35"/>agna legatio; agitur de continuando foedere.</s>
					<s n="19" xml:lang="la">Videtur <lb xml:id="p1z36"/>non posse convenire, et valde timemus omnes, ne nihil <lb xml:id="p1z37"/>fiat indeque oriatur gravioris dissidii materia et occasio.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z38"/>Sunt nebulones, qui frigidam semper suffundunt.</s>
					<s n="21" xml:lang="la">Praesente <lb xml:id="p1z39"/>enim nuper hic <persName ref="p1936">Lysmanino</persName> quidam, qui se <placeName ref="l167">Genevensem</placeName> <lb xml:id="p1z40"/>nominavit, alteram <persName ref="p1936">Lysmanini</persName> famulam occulte rogavit, <lb xml:id="p1z41"/>ut, quoniam ad <persName ref="p540">Calvinum</persName> proficisceretur, diceret ei libros <lb xml:id="p1z42"/>suos <placeName ref="l41">Bernae</placeName> esse exustos.</s>
					<s n="22" xml:lang="la">Ille perculsus me de ea re rogavit.</s>
					<s n="23" xml:lang="la"><lb xml:id="p1z43"/>Cum ego negarem, intelleximus proditorium huius <lb xml:id="p1z44"/>nebulonis consilium, quo <persName ref="p540">Calvinum</persName> hoc nuntio incerto <lb xml:id="p1z45"/>per certum hominem exagitare voluit.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Cum vero rogarem, ut osten<lb xml:id="p1z46"/>deret mihi hominem, inveniri non potui; quantum vero con<lb xml:id="p1z47"/>iecturis assequi potuimus, unus est ex secretariis, qui legatis <lb xml:id="p1z48"/><placeName ref="l167">Genevensium</placeName> coniuncti sunt.</s>
					<s n="25" xml:lang="la">Tales nebulones et calumni<lb xml:id="p1z49"/>atores mendaces plurimum utrinque serunt dissidii.</s>
					<s n="26" xml:lang="la">Dominus <lb xml:id="p1z50"/>excindat linguas eorum.</s>
					<s n="27" xml:lang="la">Haec modo ad e; plura eni<lb xml:id="p1z51"/>m non habeo.</s>
					<s n="28" xml:lang="la" ana="salute">Dominus te servet diu incolumem cum tuis <lb xml:id="p1z52"/>omnibus, quibus ex me salutem dicas, oro.</s>
					<s n="29" xml:lang="la" ana="salute">Salutant vos nostri <lb xml:id="p1z53"/>quoque omnes.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><placeName ref="l41">Bernae</placeName> 14. decembris 1555.</s>
				</p>
				<p>
					<s n="31" xml:lang="la"><lb xml:id="p1z54"/><persName ref="p8018">Ioannes Hallerus</persName> <lb xml:id="p1z55"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="32" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino et compatri <lb xml:id="p2z5"/>colendissimo suo.</s>
				</p>
