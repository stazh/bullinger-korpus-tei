	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. 24. demum huius mensis reversus <persName ref="p5787">Claudius Maius</persName> tuas <lb xml:id="p1z2"/>mihi attulit.</s>
					<s n="2" xml:lang="la">Remitto per hunc tibi, quae per illum <lb xml:id="p1z3"/>miseras.</s>
					<s n="3" xml:lang="la">His nihil possum addere, nisi quod aliquot <lb xml:id="p1z4"/>nunc diebus expectavi, ut aut ad senatum aut (ut <lb xml:id="p1z5"/>quidem comminati fuerant) in ius vocarer propter <placeName ref="l294">Locarnens<lb xml:id="p1z6"/>em</placeName> causam a me pro suggestu aliquantum exagitatam.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Quamvis enim hoc modestissime fecerim idque pro officio, <lb xml:id="p1z8"/>mire tamen offendi multos, qui furiunt quasi in me, <lb xml:id="p1z9"/>praesertim illi, quos proxima comitia legatos habuere.</s>
					<s n="5" xml:lang="la">In se <lb xml:id="p1z10"/>enim solos omnia dicta putant.</s>
					<s n="6" xml:lang="la">Sed nemodum me vocavit.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>Ferit illos sine dubio conscientia delicti et verentur, ne gravius <lb xml:id="p1z12"/>exponam omnia vocatus quam antea et vulgus tandem <lb xml:id="p1z13"/>resciscat omnia.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Instruxeram me per domini gratiam perbelle, ut <lb xml:id="p1z14"/>officio meo vocatus non deessem.</s>
					<s n="9" xml:lang="la">Sed ex mora <lb xml:id="p1z15"/>illa suspicor fore, ut subsidant omnia.</s>
					<s n="10" xml:lang="la">Auxit illis hanc acerbitatem <lb xml:id="p1z16"/>praesentia duorum quaestorum <placeName ref="l160">Friburgensium</placeName> in hac me <lb xml:id="p1z17"/>concione tum habita, coram quibus se perstringi aegre tulerunt, <lb xml:id="p1z18"/>cum tamen ego illos interesse omnino nescirem; praeter morem <lb xml:id="p1z19"/>enim illorum factum est, ut concioni adessent, quos nunquam <lb xml:id="p1z20"/>adfuisse scio toto hoc tempore, quo ego <placeName ref="l41">Bernae</placeName> ministravi.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z21"/>Sed obdurandus est animus erga eiusmodi.</s>
					<s n="12" xml:lang="la">Ipsum factum <lb xml:id="p1z22"/>me cruciat, horum importunitas nihil.</s>
					<s n="13" xml:lang="la">De legatis mittendis <lb xml:id="p1z23"/>nihil audio; geruntur omnia clam, ideo tam bene succedunt.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z24"/>Paucissimi sunt apud nos, qui recte intelligant hoc, <lb xml:id="p1z25"/>quod factum est, id quod <persName ref="p5353">Hürtzelius</persName><note xml:id="fn1" type="footnote" ana="bio" n="1">Vielleicht Tuchherr <persName ref="p20085">Peter Hirzel</persName> (1511-1573)? Zu diesem vgl. Katalog der Hss. der ZBZ, II: Familienarchive, Sp. 254.</note> hic noster tibi exponere po<lb xml:id="p1z26"/>terit.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">A <placeName ref="l167">Geneva</placeName> iterum turbas exspecto.</s>
					<s n="16" xml:lang="la"><persName>Hi<lb xml:id="p1z27"/>er<lb xml:id="p1z28"/>onymus</persName> ablegatus erat quia <persName ref="p540">Calvinum</persName> haereticum vo<lb xml:id="p1z29"/>citaverat.</s>
					<s n="17" xml:lang="la">Rediens vero ad senatum mansionem denuo <lb xml:id="p1z30"/>(in odium <persName ref="p540">Calvini</persName>, sat scio) impetravit.</s>
					<s n="18" xml:lang="la">Hinc habebimus <lb xml:id="p1z31"/>turbarum satis.</s>
					<s n="19" xml:lang="la">Ita foris pugnae nobis perpetuo, ut <lb xml:id="p1z32"/>ille ait, intus terrores.</s>
					<s n="20" xml:lang="la">Sed qui consolatur humiles <lb xml:id="p1z33"/>consolatur etiam nos.</s>
					<s n="21" xml:lang="la">Illi sit laus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Fratri meo propter occupati<lb xml:id="p1z34"/>ones nihil scribo.</s>
					<s n="23" xml:lang="la" ana="salute">Saluta illum meo nomine una cum <lb xml:id="p1z35"/>tuis omnibus.</s>
					<s n="24" xml:lang="la">Tuas ad <persName ref="p540">Calvinum</persName> curabo et illa quoque quae <lb xml:id="p1z36"/>d. <persName ref="p8011">Gvaltherus</persName> misit <placeName ref="l280">Lausannam</placeName> mittenda.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Vestram <lb xml:id="p1z37"/>libertatem erga <persName ref="p540">Calvinum</persName> valde probo; videtur enim nimium <lb xml:id="p1z38"/>semper <persName ref="p1974">Lutherum</persName> et <persName ref="p467">Bucerum</persName> defendere et se alteri<lb xml:id="p1z39"/>us huius flexiloquis orationibus nimium accommodare, <lb xml:id="p1z40"/>quum tamen satis manifestum sit, qua in re impegerint <lb xml:id="p1z41"/>ambo.</s>
					<s n="26" xml:lang="la">Lutherani tam sunt crassi ut nihil supra, <lb xml:id="p1z42"/>et eiusmodi accommodatis sermonibus confirmantur in <lb xml:id="p1z43"/>errore magis, quam ut inde educantur.</s>
					<s n="27" xml:lang="la">Larva ergo illis abstra<lb xml:id="p1z44"/>henda, ut quantopere caecutiant in re plana et perspicua <lb xml:id="p1z45"/>cernere queant.</s>
					<s n="28" xml:lang="la">Tibi pro his omnibus summas ago grat<lb xml:id="p1z46"/>ias.</s>
				</p>
				<p>
					<s n="29" xml:lang="la" ana="farewell">Vale.</s>
					<s n="30" xml:lang="la" ana="salute">Mei te omnes salutant tibique et tuis <lb xml:id="p1z47"/>omnibus foelicia precantur saecula.</s>
					<s n="31" xml:lang="la">Det tibi dominus, ut cum <lb xml:id="p1z48"/>bona pace multos annos ecclesiae suae adhuc servire <lb xml:id="p1z49"/>possis.</s>
					<s n="32" xml:lang="la">Amen.</s>
					<s n="33" xml:lang="la"><placeName ref="l41">Bernae</placeName> 28. decembris post natalem <lb xml:id="p1z50"/>servatoris.</s>
				</p>
				<p>
					<s n="34" xml:lang="la"><lb xml:id="p1z51"/>Tuus <persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="35" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino et compa<lb xml:id="p2z4"/>tri suo colendissimo et charissimo.</s>
				</p>
				<p>
					<s n="36" xml:lang="de"><lb xml:id="p2z5"/>M. <persName ref="p495">Heinrych Bul<lb xml:id="p2z6"/>linger</persName> zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>