	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tanta me beneficiorum multitudine obruis, colendissime <lb xml:id="p1z2"/>domine et compater, ut dignas satis nunquam habere aut agere <lb xml:id="p1z3"/>nedum referre possim gratias.</s>
					<s n="3" xml:lang="la">Praeter caetera enim, quę mihi <lb xml:id="p1z4"/>subinde praestas, dignaris etiam nunc me tam honorifico et <lb xml:id="p1z5"/>magnifico munere, nummo inquam illo salvatoris nostri imaginem <lb xml:id="p1z6"/>ferente, pro quo tantas ago gratias, quantas possum <lb xml:id="p1z7"/>maximas, et oro illum, cuius iste imaginem repraesentat, <lb xml:id="p1z8"/>ut te suo favore in aeternum complectatur abundeque retribuat <lb xml:id="p1z9"/>omnia.</s>
					<s n="4" xml:lang="la">Simul etiam gratias ago pro omnibus istis literis et <lb xml:id="p1z10"/>scriptis, quę mihi communicasti.</s>
					<s n="5" xml:lang="la">Ea tibi per fratrem omnia remitto <lb xml:id="p1z11"/>et remisissem citius, nisi certo destitutus fuissem nuncio.</s>
					<s n="6" xml:lang="la">Quod <lb xml:id="p1z12"/>ad me, lacer sum toto corpore ex his aquis, ita ut manus <lb xml:id="p1z13"/>praesertim et pedes suum mihi officium negent.</s>
					<s n="7" xml:lang="la">Quod itaque <lb xml:id="p1z14"/>in scribendo brevior sum, huic partim causae tribuas, partim <lb xml:id="p1z15"/>fratri, quod is tibi res nostras omnes melius coram explicabit.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Forte finita hac lavatione, si tantum nobis temporis detur, <lb xml:id="p1z17"/>te videbo et coram tecum de rebus nostris omnibus conferam.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/>Quamvis enim non multa, quę illic agam, habeam, <lb xml:id="p1z19"/>hoc unum tamen mihi satis magnum est te videre et tuo <lb xml:id="p1z20"/>conspectu frui.</s>
					<s n="10" xml:lang="la">Quod utinam nobis dominus saepius adhuc <lb xml:id="p1z21"/>concedat!</s>
					<s n="11" xml:lang="la">Ei te commendo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Salutat te uxor mea et <lb xml:id="p1z22"/>dominus <persName>Brunnerus</persName> cum toto nostro sodalitio.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Es Thermis no<lb xml:id="p1z23"/>stris <placeName ref="l21">Badensibus</placeName> 20. maii 1571.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z24"/>Tuus per omnia <lb xml:id="p1z25"/><persName ref="p8018">Iohannes Hallerus</persName><lb xml:id="p1z26"/>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, domino meo <lb xml:id="p2z3"/>honorando et compatri charissimo.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
