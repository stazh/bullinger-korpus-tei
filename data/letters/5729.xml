	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Quoniam mandatum hoc nobis a te est datum, clarissime domine ac <lb xml:id="p1z3"/>pater colendissime, ut de puerorum nostroque omnium successu ad te idque <lb xml:id="p1z4"/>saepius ex itinere scriberemus, faciendum, nobis existimavimus, ut <placeName ref="l28">Ba<lb xml:id="p1z5"/>silęa</placeName> proximo quidem loco hoc mandatum paternum tuum exequi in<lb xml:id="p1z6"/>ciperemus, quo venimus salvi omnes atque incolumes ex dei gratia tertio <lb xml:id="p1z7"/>a nostro <placeName ref="l587">Tiguro</placeName> discessu die.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Successerunt in itinere omnia commode; <lb xml:id="p1z8"/>pueri absque fastidio curru vecti sunt, nisi quod vestri desiderium <lb xml:id="p1z9"/>summum retinent, ex quo non vulgare natum est taedium, quod <lb xml:id="p1z10"/>difficulter etiam cum lachrymis perferunt; prandendo, coenando <lb xml:id="p1z11"/>vel aliquid aliud agendo suspiria alta ducunt paterni tui ma<lb xml:id="p1z12"/>trisque charissimae amoris memores.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Nos officio nostro non desumus, <lb xml:id="p1z13"/>omnia illorum commoda, valetudinem imprimis, et quae eam consequuntur, <lb xml:id="p1z14"/>saluti nostrae praeferimus et speramus dominum adfuturum <lb xml:id="p1z15"/>nobis vestris adiuti precibus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Iam navim commodam reperimus, <lb xml:id="p1z16"/>qua cras <placeName ref="l491">Argentoratum</placeName> descendemus; nam aurigae illi nostri <lb xml:id="p1z17"/>in <placeName ref="l691">Lotaringiam</placeName> hinc recta sunt profecti.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Sed nos ex dei gratia <lb xml:id="p1z18"/>fruemur maiori commodo hoc facili <placeName ref="l2459">Rheni</placeName> descensu; inde ad te <lb xml:id="p1z19"/>longiores dabimus literas.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Nam haec subito scribimus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Mitto <lb xml:id="p1z20"/>libellum quendam vobis a nostro <placeName ref="l2472">Polono</placeName> <persName>Orichovio</persName> scriptum, <lb xml:id="p1z21"/>Chimaerae nomen habet, sed vere chimęra chimęram procreavit <lb xml:id="p1z22"/>atque ita puto, quod <persName>Orichovius</persName> ille loquax iam in posterum chimaera <lb xml:id="p1z23"/>permanebit, non quod <persName ref="p3018">Stancarum</persName> nebulonem tractet, sed quod <lb xml:id="p1z24"/>multos sanctos ac pios viros proscindit nec tuo nomini bellua parcit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z25"/>Deus tandem compescet ipsius impietatem.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Vale felicissime, <lb xml:id="p1z26"/>pater colendissime cum uxore prudentissima ac piissima foemina <lb xml:id="p1z27"/>matre nostra cumque tota tua familia honestissima; eam totam <lb xml:id="p1z28"/>vobiscum salutant pueri officiosissime, ego vero et symmistas tuos <lb xml:id="p1z29"/>et generos, viros clarissimos.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Deus vos ecclesiae suae conservet.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Dat. <lb xml:id="p1z30"/><placeName ref="l28">Basileae</placeName> 9. maii 1563.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z31"/>Tui observantissimus <lb xml:id="p1z32"/>famulus <persName ref="p8511">Christophorus <lb xml:id="p1z33"/>Thretius</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro doctissimo homin<lb xml:id="p2z2"/>i d. <persName ref="p495">Henricho Bullingero</persName>, ..<lb xml:id="p2z3"/>. eximio <placeName ref="l587">Tigurinae</placeName> ecclesiae.<lb xml:id="p2z4"/>.. lissimo etc. suo dno et [...<lb xml:id="p2z5"/>] colendissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
