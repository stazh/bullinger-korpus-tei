	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Unmittelbar vor dem Aufbruch zur Zusammenkunft mit <persName ref="p2095" cert="high">Melanchthon</persName> in <placeName ref="l512" cert="high">Tübingen</placeName> (s. unten Z. 5), deren Zeitpunkt allerdings nicht genau feststeht (s. <persName ref="p2095" cert="high">Melanchthon</persName> BW, Regesten II 273, <ref target="file11839">Nr. 1793</ref>; vgl. <bibl source="b51">Blarer BW</bibl> I 825, Nr. 738 mit Anm. 1).</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia et pax, observande et charissime <persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Nostri hic admodum exhilarati sunt, dum <lb xml:id="p1z3"/>praedicavimus illis, qua fide, quo studio concordiam <lb xml:id="p1z5"/>iuveris illic et adiuturum te receperis apud tuos<note xml:id="fna" type="footnote" n="a">apud tuos <hi>über der Zeile nachgetragen.</hi></note><note xml:id="fn2" type="footnote" n="2"><persName ref="p467">Bucer</persName> bezieht sich wohl auf mündliche Äußerungen <persName ref="p495">Bullingers</persName> während der <placeName ref="l28">Bas- 1er</placeName> Tagung vom 24./25. September. Vgl. den Abschied vom 25. September (<bibl source="b197">EA</bibl> IV/1c 764) sowie die Antwort der Theologen auf den Vortrag <persName ref="p5565">Capitos</persName> und <persName ref="p467">Bucers</persName> (ebd. und <bibl source="b197">EA</bibl> IV/1b 903f, zu f 2; Abschrift von <persName ref="p495">Bullingers</persName> Hand: E II 337, 180v.-181r.).</note>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Volebam <lb xml:id="p1z6"/>vobis mittere capita synodi <placeName ref="l296">Londinensis</placeName><note xml:id="fn3" type="footnote" n="3">Zur den von der Konvokation im Juli 1536 angenommenen "Zehn Artikeln" s. <hi>Prüser,</hi> England 112-115.</note>, sed defuit <lb xml:id="p1z7"/>tempus.</s>
					<s n="4" xml:lang="la">Abeo enim nunc <placeName ref="l512">Tubingam</placeName><note xml:id="fn4" type="footnote" n="4">Siehe oben Anm. 1.</note>.</s>
					<s n="5" xml:lang="la">Capita eius <lb xml:id="p1z8"/>perscripsi ad <placeName ref="l830">Anglos</placeName> hospites vestros<note xml:id="fn5" type="footnote" n="5"><persName ref="p8422">Nicholas Partridge</persName>, <persName ref="p506">John Butler</persName> und <persName ref="p7104">William Woodroffe</persName>.</note>; ab illis <lb xml:id="p1z9"/>accipietis ea.</s>
					<s n="6" xml:lang="la">Nos regno Christi pessime <lb xml:id="p1z10"/>defuimus detrectando legationem mittere, quae <lb xml:id="p1z11"/>hinc<note xml:id="fnb" type="footnote" n="b"><hi>kann auch als</hi> huic <hi>gelesen werden.</hi></note> synodo interfuisset, id quod rex <lb xml:id="p1z12"/>petierat<note xml:id="fn6" type="footnote" n="6">Auf die Entsendung der von König <persName ref="p8375">Heinrich VIII.</persName> gewünschten Gesandtschaft der <placeName ref="l1202">Schmalkaldener</placeName>, an der auch <persName ref="p467">Bucer</persName> teilnehmen sollte, hatte man nach der Hinrichtung <persName ref="p4358">Anne Boleyns</persName> verzichtet; s. <hi>Prüser,</hi> England 95-103.</note>.</s>
					<s n="7" xml:lang="la">Sed accipiendum est, quod dominus largitur.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Bene habet, dum regnum hoc<note xml:id="fnc" type="footnote" n="c">hoc <hi>über der Zeile nachgetragen.</hi></note> perstat<pb type="edition" next="435"/> in reiectione <lb xml:id="p1z14"/>papae et admisit doctrinam iustificationis, et <lb xml:id="p1z15"/>reliqua dominus olim dabit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Valete, sancti illic <lb xml:id="p1z16"/>omnes,<note xml:id="fnd" type="footnote" n="d">Pellicane <hi>aus</hi> <persName ref="p8127">Pellicanus</persName> <hi>korrigiert.</hi></note>.</s>
					<s n="10" xml:lang="la"><persName ref="p8127">Pellicane</persName>, <persName ref="p1753">Leo</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p1753">Leo Jud</persName>.</note>, <persName ref="p8171">Theodore</persName><note xml:id="fne" type="footnote" n="e">Theodore <hi>aus</hi> Theodorus <hi>korrigiert.</hi></note><note xml:id="fn8" type="footnote" n="8"><persName ref="p8171">Theodor Bibliander</persName>.</note>, et <lb xml:id="p1z17"/>habete nos in domino commendatos.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l491">Argentorati</placeName>, 1536.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p467">M. Bu.</persName> <lb xml:id="p1z19"/>vester <lb xml:id="p1z20"/>in domino totus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximia pietate et <lb xml:id="p2z2"/>doctrina domino <lb xml:id="p2z3"/><persName ref="p495">Heylricho Bullingero</persName> <lb xml:id="p2z4"/>suo, pastori e<lb xml:id="p2z5"/>cclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z6"/>vigilantissimo, suo <lb xml:id="p2z7"/>singulari <lb xml:id="p2z8"/>patrono et <lb xml:id="p2z9"/>fratri charissimo.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z10"/><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
