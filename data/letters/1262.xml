	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Gratulor te nobis per gratiam dei <lb xml:id="p1z3"/>restitutum esse, domine et frater colend<lb xml:id="p1z4"/>issime.</s>
					<s n="3" xml:lang="la" ana="salute">Abstinui vero hactenus a scribendi <lb xml:id="p1z5"/>officio, ne aegro molestus essem; interea <lb xml:id="p1z6"/>edidi subinde animi mei in te promptissimi <lb xml:id="p1z7"/>significationes, dum <persName ref="p1278">Gastio</persName> nostro <lb xml:id="p1z8"/>nunquam scripsi, quin iusserim singulas tibi <lb xml:id="p1z9"/>communicaret aut referret meam salutem, <lb xml:id="p1z10"/>id quod sat scio eum plenissime effecisse.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z11"/>Iam, cum ille scribat te revaluisse et <lb xml:id="p1z12"/>rursus docere, tecum iterum meis literis <lb xml:id="p1z13"/>colloqui pergo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Con<lb xml:id="p1z14"/>cilium <placeName ref="l1107">Tridentin<lb xml:id="p1z15"/>um</placeName> diabolice institutum procedit dia<lb xml:id="p1z16"/>bolice.</s>
					<s n="6" xml:lang="la">Papa misit illuc legatum <placeName ref="l55">Bononiens<lb xml:id="p1z17"/>em</placeName> cardinalem a <persName ref="p20774">Crescentiis</persName>, legum doctorem, virum <lb xml:id="p1z18"/>valde tritum in schola diaboli.</s>
					<s n="7" xml:lang="la">Nihil <lb xml:id="p1z19"/>autem cedit, ne pilum quidem, de conclusis <lb xml:id="p1z20"/>in 7 sessionibus; vicerunt itaque ante <lb xml:id="p1z21"/>congressum.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Et quis amans veritatis et <lb xml:id="p1z22"/>studiosus salutis suae ecclesiae subiiciat causam <lb xml:id="p1z23"/>religionis hostibus omnis pietatis et honestatis?</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z24"/>quis sustineat se ablegari, ut margaritas <lb xml:id="p1z25"/>porcis proiiciat?</s>
					<s n="10" xml:lang="la">quis conetur illos convertere, <lb xml:id="p1z26"/>qui peccant in spiritum sanctum?</s>
					<s n="11" xml:lang="la">Miror ergo, <lb xml:id="p1z27"/>qua spe dicatur <persName ref="p2095">Melanchton</persName> non refragari, ne <lb xml:id="p1z28"/>mittatur in synagogam luporum; sed forte falsa <lb xml:id="p1z29"/>sunt, quae sparguntur.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z30"/>Qui hasce tibi offert, <lb xml:id="p1z31"/><placeName ref="l640">Flander</placeName> est et <placeName ref="l168">Gandavensis</placeName>; dicit se esse exulem <lb xml:id="p1z32"/>propter evangelium.</s>
					<s n="13" xml:lang="la">Si potes, iuva illum, <lb xml:id="p1z33"/>ut in calcotypia aliqua discat artem com<lb xml:id="p1z34"/>positoriam; nullum ei locum apud nos inveni, <lb xml:id="p1z35"/>in quo haerere potuerit.</s>
					<s n="14" xml:lang="de">Es hatt yederman <lb xml:id="p1z36"/>hie mitt siner nodt gnuͦg ze schaffen.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z37"/>Magna est inopia rerum et maior copia pau<lb xml:id="p1z38"/>perum; nescio, quomodo res vicem habeant.</s>
					<s n="16" xml:lang="la">Dominus <lb xml:id="p1z39"/>cito nos aspiciat oculis misericordiae.</s>
					<s n="17" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z40"/>cum tuis omnibus.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z41"/><placeName ref="l587">Tiguri</placeName> ultima aprilis <lb xml:id="p1z42"/>anno 1551.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z43"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p8418">Osvaldo Myconio</persName>, <lb xml:id="p2z3"/><placeName ref="l28">Basiliensis</placeName> ecclesiae fido <lb xml:id="p2z4"/>pastori, domino et fratri <lb xml:id="p2z5"/>colendissimo suo.</s>
				</p>
				<p>
					<s n="21" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
