	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Habeo tibi gratias immortales, vir <lb xml:id="p1z2"/>eruditissime, quod primus in mea afflictione <lb xml:id="p1z3"/>mihi et pietatis et christianae constantiae <lb xml:id="p1z4"/>calcar addideris.</s>
					<s n="3" xml:lang="la">Incredibile est enim, quam <lb xml:id="p1z5"/>exosculatus sim literas tuas, quas per <persName>Fab[ricium]</persName><lb xml:id="p1z6"/>, civem nostrum, perferendas ad me curasti.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Intellexi amicitiam nostram contractam adhuc <lb xml:id="p1z8"/>permanere integram.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Rarum fuit id cer<lb xml:id="p1z9"/>ne anno praeterito (qui fuit <foreign xml:lang="de">schaltjar</foreign> <lb xml:id="p1z10"/>motus iniquitatis) praesertim ecclesiae <placeName ref="l632">Alsaticae</placeName>.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Rogo itaque, ut pro me sollicitus <lb xml:id="p1z12"/>sis, quum nunc caream me charissimo <lb xml:id="p1z13"/><persName ref="p1010">Erbio</persName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Tu vicem eius nomine ecclesiae <lb xml:id="p1z14"/>commissae mihi loco patroni et seduli ad<lb xml:id="p1z15"/>hortatoris praestabis.</s>
					<s n="8" xml:lang="la">Intra sex menses <lb xml:id="p1z16"/>nullas accepi literas nec ab <persName ref="p1010">Erbio</persName> <lb xml:id="p1z17"/>nec aliis amicis olim constantissimis; <lb xml:id="p1z18"/>quales nunc sint, cum fortuna vultum <lb xml:id="p1z19"/>contraxerit, deus novit.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>Ego vero <lb xml:id="p1z21"/>saevienti fortunae resistere non valeo <lb xml:id="p1z22"/>ullis rationibus quam patientia, quae ne <lb xml:id="p1z23"/>eripiatur nobis, precor tibi tuisque foelicissimum <lb xml:id="p1z24"/>auspicium huius anni.</s>
					<s n="10" xml:lang="la">Si quid scripserit <lb xml:id="p1z25"/><persName ref="p1010">Erbius</persName> ad te, facito me certiorem.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z26"/>De rebus meis audies vivam epistolam.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z27"/>Satis importune indicavit profectionem <lb xml:id="p1z28"/>suam ad vos; ignoscas ergo insulso <lb xml:id="p1z29"/>et incondito calamo.</s>
					<s n="13" xml:lang="la" ana="salute">Salutant te <lb xml:id="p1z30"/><persName ref="p3988">Wolph[ius]</persName> et <persName>Erhard[us] Lab[hardus</persName>].</s>
					<s n="14" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Episcopicellae <lb xml:id="p1z31"/>anno 1561 epiphaniae domini.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z32"/>Tuus <persName ref="p2713">Ioannes Myliagrius</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eruditionis et pietatis <lb xml:id="p2z2"/>non vulgaris viro d. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z4"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z5"/>vigilantissimo et patrono <lb xml:id="p2z6"/>suo colendo.</s>
					<s n="18" xml:lang="de"><lb xml:id="p2z7"/>Zürch.</s>
				</p>
			</div>
		</body>
	</text>
