	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salutem in domino, <persName ref="p495">Bullingere</persName> observande.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Preter expectationem tam subito <lb xml:id="p1z2"/>hinc ad vos proficiscenti typographo nostro<note xml:id="fn1" type="footnote" n="1"><persName ref="p6897">Hans Varnier d.Ä.</persName> (vgl. oben <ref target="file11197">Nr. 1154</ref>, 11f).</note> volui breve hoc epistolium ad te <lb xml:id="p1z3"/>perferendum committere.</s>
					<s n="3" xml:lang="la">Qui etiam dialogum a <persName ref="p6615">Sinapio</persName> nuncnuper mihi missum<note xml:id="fn2" type="footnote" n="2">Siehe oben <ref target="file11197">Nr. 1154</ref>, 64f.</note> <lb xml:id="p1z4"/>et hic tametsi incuriose excusum reddet<note xml:id="fn3" type="footnote" n="3">Zum anonymen "Dialogus vere elegans ..." <placeName ref="l513">Ulm</placeName> (<persName ref="p6897">Hans Varnier</persName>) 1538 s. <hi>Flood/Shaw</hi> 185f mit Anm. 62; ein Exemplar befindet sich in Zürich ZB, Ms S 45, 35a.</note>, ęreum scilicet pro aureo<note xml:id="fn4" type="footnote" n="4"><bibl source="b56">Adagia</bibl>, 1, 2, 1 (<bibl source="b370">LB</bibl> II 68).</note>; nunquam enim <lb xml:id="p1z5"/>mihi excidet vere aureum illud tuum donum nuper mihi transmissum<note xml:id="fn5" type="footnote" n="5"><persName ref="p495">Bullingers</persName> "De scripturae sanctae authoritate" (<bibl source="b286">HBBibl</bibl> I 111); vgl. oben <ref target="file11181">Nr. 1138</ref>, 3-6; 1149, 6-9.</note>, pro quo <lb xml:id="p1z6"/>nunc summas denuo ago gratias relaturus, ubi<note xml:id="fna" type="footnote" n="a">ubi <hi>versehentlich wiederholt.</hi></note> occasio dabitur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Cęterum, quod scribis adversarios monstrum alere<note xml:id="fn6" type="footnote" n="6"><bibl source="b56">Adagia</bibl>, 2, 4, 98 (<bibl source="b370">LB</bibl> II 551).</note>, non omnino falleris; quid <lb xml:id="p1z8"/>enim aliud agerent isti monstripari<note xml:id="fn7" type="footnote" n="7"><persName ref="p495">Bullingers</persName> Befürchtungen bleiben unklar.</note>?</s>
					<s n="5" xml:lang="la">Putassem autem illud, quicquid est <lb xml:id="p1z9"/>monstri, proxima <placeName ref="l1564">Isnacensia</placeName> comitia<note xml:id="fn8" type="footnote" n="8">Gemeint ist der Bundestag der <placeName ref="l1202">Schmalkaldener</placeName> in <placeName ref="l1564">Eisenach</placeName> vom 24. Juli bis 11. August 1538.</note> detexisse; sed nihildum certi potui <lb xml:id="p1z10"/>cognoscere.</s>
					<s n="6" xml:lang="la"><persName ref="p2104">Iustus Menius</persName>, qui <placeName ref="l1564">Isenaci</placeName> episcopatur, ad me cum legatis <lb xml:id="p1z11"/>nostris<note xml:id="fn9" type="footnote" n="9"><persName ref="p4287">Georg Besserer</persName> (s. <bibl source="b480">PC</bibl> II 511); andere <placeName ref="l513">Ulmer</placeName> Abgeordnete sind nicht bekannt.</note> scripsit<note xml:id="fn10" type="footnote" n="10">Nicht erhalten.</note> omnia inter solos proceres tanto acta esse silentio, ut nemini <lb xml:id="p1z12"/>ne <foreign xml:lang="el">γρύ</foreign> quidem<note xml:id="fn11" type="footnote" n="11"><bibl source="b56">Adagia</bibl>, 1, 8, 3 (<bibl source="b370">LB</bibl> II 304).</note> licuerit audire.</s>
					<s n="7" xml:lang="la">Hoc solum plerique mussitant illic peractum, <lb xml:id="p1z13"/>ut cęsar<note xml:id="fn12" type="footnote" n="12"><persName ref="p18538">Karl V.</persName></note> certam et firmam pacem evangelicis ordinibus confirmet.<pb type="edition" next="196"/></s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Huius pacis <foreign xml:lang="el">οἱ πρόξενοι</foreign> et poetę feruntur esse duo illi electores, Palatinus <lb xml:id="p1z15"/>et Marchio<note xml:id="fn13" type="footnote" n="13">Die <placeName ref="l1202">Schmalkaldener</placeName> verlangten auf ihrer Tagung in <placeName ref="l1564">Eisenach</placeName>, <persName ref="p18477">König Ferdinand</persName> solle Pfalzgraf <persName ref="p18548">Ludwig V.</persName> und Markgraf <persName ref="p18520">Joachim II. von Brandenburg</persName> zu Vermittlungsverhandlungen bevollmächtigen; s. Walter <hi>Rosenberg,</hi> Der Kaiser und die Protestanten in den Jahren 1537-1539, Halle a. S. 1903. - Schriften des Vereins für Reformationsgeschichte 77, S. 54-58.</note>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Iam constans fama spargit <placeName ref="l2510">Turcam</placeName> in armis esse et utramque <lb xml:id="p1z16"/><persName ref="p18477">Pannoniam</persName> vexaturum<note xml:id="fn14" type="footnote" n="14">Am 9. Juli 1538 waren die <placeName ref="l2510">Türken</placeName> zum Moldaufeldzug aufgebrochen, und im September unterwarfen sie sich die <placeName ref="l3246">Moldau</placeName> und die <placeName ref="l3183">Walachei</placeName> (vgl. <bibl source="b276">Hammer-Purgstall</bibl> III 200-203. 698-700). Vgl. auch unten <ref target="file11229">Nr. 1186</ref>, 49-55.</note>; alii aliter hoc interpretantur.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Iam <placeName ref="l18">Augustam</placeName> hisce diebus <lb xml:id="p1z17"/>ex <placeName ref="l20">Inferiore Germania</placeName> audio perscriptum esse <persName ref="p20225">Gallorum regem</persName><note xml:id="fn15" type="footnote" n="15"><persName ref="p20225">Franz I.</persName>, König von <placeName ref="l832">Frankreich</placeName>.</note> securum venari <lb xml:id="p1z18"/><placeName ref="l1284">Bruxellę</placeName>.</s>
					<s n="11" xml:lang="la">Oremus dominum, ut in istis bellorum rumoribus ecclesię suę pacem <lb xml:id="p1z19"/>conservet.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Scripsi nuper ad te de <persName ref="p8441">Schwenckfeldio</persName>, hospite <placeName ref="l513">Ulmensi</placeName>, et <persName ref="p8350">Franco</persName>, <lb xml:id="p1z20"/>cive<note xml:id="fn16" type="footnote" n="16">Vgl. oben <ref target="file11192">Nr. 1149</ref>, Anm. 5.</note>.</s>
					<s n="13" xml:lang="la">Senatus scholarchis iniunxit, ut, quicquid in illis sectariis desideremus, <lb xml:id="p1z21"/>in scriptis offeramus<note xml:id="fn17" type="footnote" n="17">Ratsbeschluß vom 31. Juli 1538 (s. <hi>Peuckert,</hi> <persName ref="p8350">Franck</persName> 364).</note>; id nunc satagimus pręstare.</s>
					<s n="14" xml:lang="la">Tu ad hanc rem etiam <lb xml:id="p1z22"/>aliquid facere posses.</s>
					<s n="15" xml:lang="la"><persName ref="p8441">Schwenckfeldius</persName> hoc insolens dogma cogitat acriter defendere: <lb xml:id="p1z23"/>Christus in gloria ut homo non est creatura.</s>
					<s n="16" xml:lang="la">Misit <persName ref="p467">Bucerus</persName> noster ex <placeName ref="l491">Argentina</placeName> <lb xml:id="p1z24"/>a <persName ref="p8441">Schwenckfeldio</persName> compositum de sacramentis libellum<note xml:id="fn18" type="footnote" n="18">Gemeint ist <persName ref="p8441">Schwenckfelds</persName> "Summarium. Außzug und innhalt der fürnämbsten punct unnd leeren des hailigen Augustini übers sechst capitel Johannis", das unter dem Pseudonym <persName ref="p8441">Ruffus Sarmentarius</persName> 1538 bei <persName ref="p6870">Philipp Ulhart d.Ä.</persName> in <placeName ref="l18">Augsburg</placeName> erschienen war (<bibl source="b169">CSch</bibl> VI 95-113).</note> satis pestilentem.</s>
					<s n="17" xml:lang="la"><placeName ref="l157">Francofurdtię</placeName> <lb xml:id="p1z25"/><persName ref="p8350">Franci</persName> Chronica de Germanorum, praecipue <placeName ref="l2481">Svevorum</placeName> et <placeName ref="l513">Ulmensium</placeName> rebus gestis <lb xml:id="p1z26"/>audio excusa iam esse<note xml:id="fn19" type="footnote" n="19"><persName ref="p8350">Francks</persName> "Germaniae Chronicon ..." war im August 1538 bei <persName ref="p4676">Christian Egenolff</persName> in <placeName ref="l157">Frankfurt</placeName> a. M. erschienen; s. Christoph <hi>Dejung,</hi> Sebastian Franck, in: Bibliotheca Dissidentium, hg. v. André Séguenny, Bd. VII, Baden-Baden 1986 (Bibliotheca bibliographica Aureliana 106), S. 84, Nr. 19.</note>; miser ille rhapsodus ut Esopicus graculus <lb xml:id="p1z27"/>alienis plumis se venditat<note xml:id="fn20" type="footnote" n="20"><bibl source="b56">Adagia</bibl>, 3, 6, 91 (<bibl source="b370">LB</bibl> II 866).</note>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Obsecro rescribe, presertim de <persName ref="p1753">Leone</persName><note xml:id="fn21" type="footnote" n="21"><persName ref="p1753">Leo Jud</persName>.</note>, an ab <lb xml:id="p1z28"/>ipso possit impetrari, ut semel huc vocetur<note xml:id="fn22" type="footnote" n="22">Vgl. dazu oben Nr. 1154, 73-75.</note>; nostri mira habent consilia <lb xml:id="p1z29"/>in mutandis ministris ecclesię, vocandis et ablegandis.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="salute">Salvos cupio omnes <lb xml:id="p1z30"/>symmystas, inprimis venerandum <persName ref="p8127">Pellicanum</persName>, cuius piis et eruditis literis<note xml:id="fn23" type="footnote" n="23">Nicht erhalten.</note> nunc non <lb xml:id="p1z31"/>licuit respondere; ob id excusari illi cupio.</s>
					<s n="20" xml:lang="la" ana="farewell">Bene vale, <persName ref="p495">Bullingere</persName> observande, <lb xml:id="p1z32"/>et me tui amantissimum redama, ut soles.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Raptim, <placeName ref="l513">Ulmę</placeName>, 27. augusti 38.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z33"/><persName ref="p1055">Martinus Frechtus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximie pio et docto d. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tigurinę</placeName> ecclesię antistiti fidelissimo, domino <lb xml:id="p2z3"/>et fratri observando.</s>
				</p>
			</div>
		</body>
