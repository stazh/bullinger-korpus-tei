	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>COMMENDAVI tibi non ita dudum <persName>nobilem gandevensem</persName>, <lb xml:id="p1z4"/>humanissime <persName ref="p495">Bullingere</persName>, multis nominibus et commendatione mea <lb xml:id="p1z5"/>et tua amicitia dignum.</s>
					<s n="3" xml:lang="la">Iam tibi iis commendo nobilem <lb xml:id="p1z6"/>istum <placeName ref="l830">Anglum</placeName>: nulla in re alteri inferior, vir est placidus <lb xml:id="p1z7"/>et quietus moribus, fide vestrae ecclesiae consentiens.</s>
					<s n="4" xml:lang="la">Apud me <lb xml:id="p1z8"/>aliquandiu convixit, nihilque inveni in homine, quod accusare <lb xml:id="p1z9"/>possem.</s>
					<s n="5" xml:lang="la" ana="farewell">Vale tudinarius est ob diuturnam tabem, qua laborat.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Si igitur aer vester illi conveniat, rogo ne desit officium <lb xml:id="p1z11"/>tuum in hospite parando, apud quem suo aliquantulum more <lb xml:id="p1z12"/>liceat vivere.</s>
					<s n="7" xml:lang="la">Cuperet apud dominum <persName>gesnerum</persName> commorari: <lb xml:id="p1z13"/>rogo igitur, ut ei a te commendetur.</s>
					<s n="8" xml:lang="la">Nova quae sunt ad <lb xml:id="p1z14"/>te scripsi ante dies octo; caetera omnia is indicabit.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/>Non sinunt negotia plura scribere: Deo igitur te et <lb xml:id="p1z16"/>familiam commendo.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z17"/>Tuus, <persName ref="p505">BURCHERUS</persName>, <placeName ref="l830">Anglus</placeName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>multis nominibus mihi <lb xml:id="p2z3"/>charo.</s>
					<s n="12" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note>[Nicht vergessen, dass etwa im September 1549 der undatierte Brief von <persName ref="p8298">Martin Borrhaus</persName> (nr 19341) zu veröffentlichen ist!]</note>
				</p>
			</div>
		</body>
	</text>
