	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z3"/>S.</s>
					<s n="2" xml:lang="la">Tuas recepi literas scriptas 14. huius mensis.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Legatos ducis <placeName ref="l2478">Sabaudie</placeName> <lb xml:id="p1z4"/>hac transeuntes non vidi.</s>
					<s n="4" xml:lang="la">Ex iis puto te intellexisse, quid constituerint <lb xml:id="p1z5"/>petere ab <placeName ref="l862">Helvetiis</placeName>; si omnia ad legitimum iudicium referant, non difficile <lb xml:id="p1z6"/>transigentur controversie omnes inter bonos et prudentes.</s>
					<s n="5" xml:lang="la">Certum est <lb xml:id="p1z8"/>imperatorem obtinuisse quinquies centena milia florenorum; sed petit, ut se omnes <lb xml:id="p1z9"/>obligent in solidum et unus pro alio, quod difficillime concedent.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Catastrophe ea esse debebat 20. huius mensis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Contribuuntur centum millia <lb xml:id="p1z11"/>contra <placeName ref="l2653">Moscovitam</placeName>, ad quem mittitur legatio.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Composuit <persName>Augustus</persName> controversiam <lb xml:id="p1z12"/>motam inter <placeName ref="l2477">Palatinum</placeName> et <placeName ref="l619">Bavarum</placeName> illorum instrumentis exustis.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>Scriptum tuum misi etiam <placeName ref="l832">Gallice</placeName> versum et tam Latinum quam <placeName ref="l832">Gallicum</placeName> <lb xml:id="p1z14"/>optime pictum; quantum profecerit posthac intelligemus, ubi se <lb xml:id="p1z15"/>obtulerit occasio et tempus commodum.</s>
					<s n="10" xml:lang="la">Quoniam optas, ut meas <lb xml:id="p1z16"/>nęnias tibi communicem, <persName>Fulgono</persName> mitto, ut tibi interpretetur; nam <lb xml:id="p1z17"/>si fuisset ocium vertissem utcumque; eis nondum supremum manu apposui <lb xml:id="p1z18"/>ocium expectans.</s>
					<s n="11" xml:lang="la">Eis addere aut diminuere poteris, que videbuntur; <lb xml:id="p1z19"/>nam iudicium tuum ea in re valde desidero, ante quam <lb xml:id="p1z20"/>amicis communicem.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Constitueram ad te mittere, ubi abundarem ocio, <lb xml:id="p1z21"/>et recognovissem; sed pro tua humanitate et amicitia excusabis <lb xml:id="p1z22"/>omnia.</s>
					<s n="13" xml:lang="la">Que de <placeName ref="l830">Anglia</placeName> et <placeName ref="l2524">Scotia</placeName> scribis, verissima esse ab aliis accepi; <lb xml:id="p1z23"/>nullos puto esse motus aut defectiones in <placeName ref="l832">Gallia</placeName>, neque primates a quietis <lb xml:id="p1z24"/>consiliis sunt alieni.</s>
					<s n="14" xml:lang="la" ana="salute">Orandus est deus, ut omnia ad gloriam nominis sui convertat <lb xml:id="p1z25"/>et ad suorum salutem et verbi sui propagationem.</s>
					<s n="15" xml:lang="la">Quid a vestris <lb xml:id="p1z26"/>obtinuerint <placeName ref="l2478">Sabaudi</placeName>, cupio intelligere.</s>
					<s n="16" xml:lang="la" ana="salute">Salutabis d. <persName ref="p8111">Martirem</persName> et d. <persName ref="p8011">Galterum</persName> <lb xml:id="p1z27"/>et amicos.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l760">Sol[uturi]</placeName> 25. augusti.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l28">Basi<lb xml:id="p1z28"/>lienses</placeName> iudicarunt contra <placeName ref="l41">Bernates</placeName> <lb xml:id="p1z29"/>in favorem <placeName ref="l167">Ge<lb xml:id="p1z30"/>nevensium</placeName>.</s>
					<s n="20" xml:lang="la"><persName ref="p18575">Philippus Hispaniam</persName> petiit.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z31"/>Tuus ex animo si suus.</s>
				</p>
				<p>
					<note>[Von anderer Hand:]</note>
					<s n="22" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>