			<zone xml:id="p4z7-0" points="1554,1654 1576,1656 1588,1668 1596,1662 1644,1674 1660,1660 1688,1662 1726,1688 1742,1688 1744,1546 1722,1544 1678,1514 1646,1524 1602,1560 1556,1556">1567,1612 1592,1614 1618,1615 1643,1617 1669,1616 1694,1613 1720,1611 1746,1609</zone>
