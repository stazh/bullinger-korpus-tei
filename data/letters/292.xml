	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino, literas per <persName ref="p1040">Udalricum</persName>, qui frumenta... erat, missas, <lb xml:id="p1z2"/>puto te accepisse, in quibus, quę in partibus inferioribus aguntur, videbis.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/><persName ref="p458">Brentius</persName> ad nos venit 1. Octobris a duce <persName ref="p9708">Udalrico</persName> diu servatus <lb xml:id="p1z4"/>in arce <placeName ref="l514">Urach</placeName>; adiunxit illi proprium tabellarium dato equo.</s>
					<s n="3" xml:lang="la">Hęrebit <lb xml:id="p1z5"/>apud nos per hyemem, donec revocetur a principe.</s>
					<s n="4" xml:lang="la">Episcopus <lb xml:id="p1z6"/>noster pfaffos omnes vocavit ad synodum in <placeName ref="l2301">Altkirch</placeName> Caesaris <lb xml:id="p1z7"/>scriptum illis propositurus ac pecunias exacturus; digniores essent <lb xml:id="p1z8"/>maiori plaga et mulcta.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/><persName ref="p458">Brentius</persName> nobis varia de <placeName ref="l822">Germanię</placeName> statu narravit, quę nunc <lb xml:id="p1z10"/>temporis propter negotia non potero exponere, de hacque re alias.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/><persName ref="p18099">Iodochus Willichius</persName> hęc ad me: "Islebius plurimum negotii nobis <lb xml:id="p1z12"/>facit propter Interimistas ab interimendo vocatos; conatur enim de<lb xml:id="p1z13"/>fendere mitiori quadam interpretatione, sed in quibusdam connivendum <lb xml:id="p1z14"/>esse suadet.</s>
					<s n="7" xml:lang="la">Nemo tamen est, qui illi monenti et precanti iuxta <lb xml:id="p1z15"/>cum suo principe obtemperat.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Adhuc principes innostris partibus sunt dei beneficio constantes, <lb xml:id="p1z17"/>terroribus <persName ref="p18538">Caesaris</persName> non moventur.</s>
					<s n="9" xml:lang="la"><placeName ref="l303">Magdeburgum</placeName>..</s>
					<s n="10" xml:lang="la">iam bene munitum <lb xml:id="p1z18"/>obsidionem expectat; sed nunc edito libello Germanico suam innocentiam <lb xml:id="p1z19"/>omnibus patefaciunt.</s>
					<s n="11" xml:lang="la">Nova quędam est confęderatio intra civitates <lb xml:id="p1z20"/>maritimas<note xml:id="fn1" type="footnote" n="1">die Hansestädte ("Seestädte").</note> contra huius consilii et edicti Caesarei sententiam; malunt <lb xml:id="p1z21"/>enim deo obedire vel capitis periculo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/><placeName>Sarmatia</placeName> nobis vicina evangelicam instaurationem in ecclesiis suis <lb xml:id="p1z23"/>adornavit.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z24"/>Dantisci item prędicatur evangelium sancte et pure.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z25"/><placeName>Moscovitę</placeName> idem in sua regione tentant.</s>
					<s n="15" xml:lang="la">Deus absque dubio suam <lb xml:id="p1z26"/>ecclesiam tanquam oculi pupillam tutabitur.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z27"/><placeName ref="l449">Silesia</placeName> adhuc puritatem christianę theologię profitetur.</s>
					<s n="17" xml:lang="la"><placeName ref="l66">Wratislavia</placeName><note xml:id="fn2" type="footnote" n="2"><placeName ref="l66">Breslau</placeName>.</note> <lb xml:id="p1z28"/>nonnihil sibi propter insidias <persName ref="p18477">Ferdinandi</persName> timet<lb xml:id="p1z29"/>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Iam conventus et <placeName>Petercovii</placeName> in <placeName ref="l2472">Polonia</placeName> propter purioris doctrinę <lb xml:id="p2z2"/>instaurationem, quę iam in Lithua ia absoluta est.</s>
					<s n="19" xml:lang="la">Vilnę <lb xml:id="p2z3"/>enim, quę eius regionis caput est et in qua est multarum <lb xml:id="p2z4"/>nationum colluvies, evangelium in publico pulpito apiis <lb xml:id="p2z5"/>doctoribus promulgatur; iunior enim rex <persName ref="p1825">Sigismundus Augustu<lb xml:id="p2z6"/>s</persName> pietati doctrinę impense favet.</s>
					<s n="20" xml:lang="la">Hęc <persName ref="p18099">Willichius</persName> <lb xml:id="p2z7"/>die Veneris post Laurentii 1548.</s>
					<s n="21" xml:lang="la"><placeName ref="l158">Francofurti cis <lb xml:id="p2z8"/>Viadrum</placeName>.</s>
					<s n="22" xml:lang="la"><lb xml:id="p2z9"/>Academię tres nolunt recipere Interim: <placeName ref="l284">Lipsensis</placeName>, <lb xml:id="p2z10"/><placeName ref="l157">Francofordiensis</placeName> et <placeName ref="l558">Wittenbergensis</placeName>; docti sunt unanimes <lb xml:id="p2z11"/>hac in re et opponunt se omnibus, qui papismum sentiunt.</s>
					<s n="23" xml:lang="la"><lb xml:id="p2z12"/>Dominus illis spiritu fortitudinis adsit illustretque illorum <lb xml:id="p2z13"/>corda, quo pie sentiant, a veritate non deficiant.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p2z14"/><persName ref="p458">Brentius</persName> a <placeName ref="l303">Magdeburgensibus</placeName> vocatus in pastorem ecclesia<lb xml:id="p2z15"/>rum, sed nihildum dedit responsi; vult prius absolvere <lb xml:id="p2z16"/>suas homilias in Esaiam et alia quaedam; nam commodaturae <lb xml:id="p2z17"/>sunt tristibus et adflictis ecclesiis.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p2z18"/>Est pręterea, quod a te velim; audio enim te orationem <lb xml:id="p2z19"/>publice habuisse, in qua omnes articulos perditi Interim <lb xml:id="p2z20"/>refellas; quam cuperem legere et argumenta illa imbibere <lb xml:id="p2z21"/>simulque mea addere.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p2z22"/><persName ref="p458">Brentius</persName> in ędibus <persName ref="p1365">Grynei</persName> demortui est cum vidua, quę <lb xml:id="p2z23"/>illum in convictorem recepit.</s>
					<s n="27" xml:lang="la">Commodissimum habet locum, <lb xml:id="p2z24"/>suis studiis aptum, bibliothecam instructissimam.</s>
					<s n="28" xml:lang="la" ana="farewell">Vale.</s>
					<s n="29" xml:lang="la" ana="salute"><pb/><lb xml:id="p3z1"/>Salutabis nomine [meo] fratres omnes, D. <persName ref="p8171">Theodorum</persName>, cu<lb xml:id="p3z2"/>i <lb xml:id="p3z3"/>brevi scribam, <persName ref="p8127">Pellicanum</persName>, <persName ref="p8011">Gvaltherum</persName> etc.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><lb xml:id="p3z4"/><placeName ref="l28">Basileę</placeName> 3. Octobris 1548.</s>
				</p>
				<p>
					<s n="31" xml:lang="la"><lb xml:id="p3z5"/>Tuus <persName ref="p1278">Gastius</persName>.</s>
					<s n="32" xml:lang="la" ana="salute"><lb xml:id="p3z6"/>D. <persName ref="p6820">Petrus Tussanus</persName>, cum hęc scriberem, <lb xml:id="p3z7"/>advenit ac iussit, ut nomine adscriberem <lb xml:id="p3z8"/>suo salutem tibi ac omnibus fratribus.</s>
					<s n="33" xml:lang="la">Qui de <lb xml:id="p3z9"/>principe suo <persName>Christophoro</persName> plausibilia narrat, <lb xml:id="p3z10"/>qui Interim ita approbet, ne Christum amittat <lb xml:id="p3z11"/>illiusque meritum obscuret.</s>
					<s n="34" xml:lang="la"><lb xml:id="p3z12"/>Ubi... D. <persName ref="p8417">Musculus</persName> agat, cupio <lb xml:id="p3z13"/>scire, et mirum, quod reliquerit <lb xml:id="p3z14"/><placeName ref="l28">Basileam</placeName> et D. <persName ref="p5213">Hervagium</persName>, apud <lb xml:id="p3z15"/>quem cum usore et liberis commodissime <lb xml:id="p3z16"/>potuisset vivere.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="35" xml:lang="la"><pb/><lb xml:id="p4z1"/>D. <persName ref="p495">Heinrycho <lb xml:id="p4z2"/>Bullingero</persName>, evan<lb xml:id="p4z3"/>gelicę veritatis <lb xml:id="p4z4"/>praeconi constantis<lb xml:id="p4z5"/>simo.</s>
					<s n="36" xml:lang="de"><lb xml:id="p4z6"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
