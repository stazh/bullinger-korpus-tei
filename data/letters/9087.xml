	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Min früntlichen gruͦtz und willigen dienst zuͦvor, getrüwer, lieber <lb xml:id="p1z2"/>herr und gfatter.</s>
					<s n="2" xml:lang="de">Diewil üch und ander vilicht wunderet, was die <lb xml:id="p1z3"/>von <placeName ref="l2450">Schwytz</placeName> unserem hohen gwalt fürge<lb xml:id="p1z4"/>trage<lb xml:id="p1z5"/>n<lb xml:id="p1z6"/>, <lb xml:id="p1z7"/>so wüß<lb xml:id="p1z8"/>e<lb xml:id="p1z9"/>nt, das es <lb xml:id="p1z10"/>nütt un<lb xml:id="p1z11"/>fr<lb xml:id="p1z12"/>ü<lb xml:id="p1z13"/>ntl<lb xml:id="p1z14"/>ichs gs<lb xml:id="p1z15"/>in, so<lb xml:id="p1z16"/>nd<lb xml:id="p1z17"/>er <lb xml:id="p1z18"/>allei<lb xml:id="p1z19"/>n von <lb xml:id="p1z20"/>deren wä<lb xml:id="p1z21"/>gen im <lb xml:id="p1z22"/>Gast<lb xml:id="p1z23"/>a<lb xml:id="p1z24"/>l, w<lb xml:id="p1z25"/>eli<lb xml:id="p1z26"/>che <placeName ref="l2450">S<lb xml:id="p1z27"/>chw<lb xml:id="p1z28"/>y<lb xml:id="p1z29"/>tz</placeName> <lb xml:id="p1z30"/>und <placeName ref="l646">Gla<lb xml:id="p1z31"/>r<lb xml:id="p1z32"/>us</placeName> <lb xml:id="p1z33"/>mit e<lb xml:id="p1z34"/>inander<lb xml:id="p1z35"/>en b<pb/><lb xml:id="p2z1"/>evo<lb xml:id="p2z2"/>gte<lb xml:id="p2z3"/>nt.</s>
				</p>
				<p>
					<s n="3" xml:lang="de"><lb xml:id="p2z4"/>Denen h<lb xml:id="p2z5"/>and <lb xml:id="p2z6"/>un<lb xml:id="p2z7"/>ser <lb xml:id="p2z8"/>eid<lb xml:id="p2z9"/>gnoßen vo<lb xml:id="p2z10"/>n <placeName ref="l2450">Schwytz</placeName> imm <lb xml:id="p2z11"/>le<lb xml:id="p2z12"/>ttsten z<lb xml:id="p2z13"/>wy<lb xml:id="p2z14"/>tra<lb xml:id="p2z15"/>cht et<lb xml:id="p2z16"/>tliche fry<lb xml:id="p2z17"/>heitt<lb xml:id="p2z18"/>en und e<lb xml:id="p2z19"/>in <lb xml:id="p2z20"/>t<lb xml:id="p2z21"/>eil <pb/><lb xml:id="p3z1"/>d<lb xml:id="p3z2"/>er <lb xml:id="p3z3"/>mi<lb xml:id="p3z4"/>nderen.<lb xml:id="p3z5"/>.<pb/><lb xml:id="p4z1"/>.</s>
				</p>
