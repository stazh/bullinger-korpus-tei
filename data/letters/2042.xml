			<zone xml:id="p2z5-0" points="1326,2255 1393,2240 1470,2283 1574,2221 1621,2236 1740,2218 1733,2036 1666,2034 1599,2059 1547,2032 1320,2064">1333,2142 1358,2149 1384,2155 1409,2158 1435,2160 1460,2160 1486,2160 1511,2160 1537,2162 1563,2163 1588,2163 1614,2163 1639,2163 1665,2164 1690,2166 1716,2164 1742,2163</zone>
