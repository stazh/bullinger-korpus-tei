	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Potens et misericors dominus pro consueta bonitate adflictis rebus <lb xml:id="p1z2"/>adest.</s>
					<s n="3" xml:lang="la">Videbantur <placeName ref="l18">Augustae</placeName> ruitura omnia; adeo consilia quorundam <lb xml:id="p1z3"/>ad exicium pietatis inflammata erant.</s>
					<s n="4" xml:lang="la">Sed fracta sunt aut impedita <lb xml:id="p1z4"/>saltem, partim principum, qui <placeName ref="l337">Neoburgi</placeName> convenerunt, consensione atque <lb xml:id="p1z5"/>constantia, quod religionem attinet, in qua se perstaturos professi <lb xml:id="p1z6"/>sunt et <placeName ref="l1204">Pataviensia</placeName> pacta ita urgent, ut rata velint, partim propter <lb xml:id="p1z7"/>inopinatum summi pontificis et <persName ref="p7548">archiepiscopi Maguntini</persName> meritum, de <lb xml:id="p1z8"/>quo et alii aliquot aliunde et ego ex <placeName ref="l491">Argentorato</placeName> certior <lb xml:id="p1z9"/>factus sum.</s>
					<s n="5" xml:lang="la">Dominus Iesus adsit ecclesiae suae propugnator et custos.</s>
					<s n="6" xml:lang="la" ana="farewell"><lb xml:id="p1z10"/>Bene vale in Christo Iesu cum tuis omnibus <placeName ref="l28">Basileae</placeName> 9. aprilis <lb xml:id="p1z11"/>anno 1555.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Molimur <placeName ref="l830">Anglis</placeName> exulibus hic sedem impetrare a senatu nostro.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>T[uus] <lb xml:id="p1z14"/><persName ref="p3099">Sulcerus</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>antistiti optimo et <lb xml:id="p2z5"/>vigilantissimo, domino <lb xml:id="p2z6"/>et symmistae colend<lb xml:id="p2z7"/>issimo.</s>
				</p>
			</div>
		</body>
	</text>
