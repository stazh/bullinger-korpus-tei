	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quae de comitiis futuris 26. iulii <lb xml:id="p1z2"/>celebrandis scripseram, intellexisti, domine ho<lb xml:id="p1z3"/>norande et frater charissime.</s>
					<s n="3" xml:lang="la">Sed audi, quid <lb xml:id="p1z4"/>interea acciderit.</s>
					<s n="4" xml:lang="la"><placeName ref="l41">Bernates</placeName> vocati respondent <lb xml:id="p1z5"/>ipsis non videri opportunum, ut propter <lb xml:id="p1z6"/>illam postulationem pontificis aut Caesaris celebrentur <lb xml:id="p1z7"/>comicia, et non ita pridem communibus receptum <lb xml:id="p1z8"/>esse declaratumque suffragiis, in quale consentiamus <lb xml:id="p1z9"/>concilium; nolle autem ipsos ei responsioni <lb xml:id="p1z10"/>addere quicquam.</s>
					<s n="5" xml:lang="la">Quamvis autem nostrates noluerint <lb xml:id="p1z11"/>quicquam mutatum, voluerunt tamen, ut urbes <lb xml:id="p1z12"/>periculosis illis temporibus semel convenirent <lb xml:id="p1z13"/>et amice de rebus omnibus conferrent, non <lb xml:id="p1z14"/>tantum de responsione danda.</s>
					<s n="6" xml:lang="la">Quoniam vero <placeName ref="l41">Bernenses</placeName> <lb xml:id="p1z15"/>scripserunt se neminem missuros, nostrates <lb xml:id="p1z16"/>comitia etiam vestratibus et <placeName ref="l441">Schaffhusianis</placeName> <lb xml:id="p1z17"/>renunciarunt, ne soli coeuntes sine <placeName ref="l41">Bernatibus</placeName> <lb xml:id="p1z18"/>vicinis occasionem suppeditarent exul<lb xml:id="p1z19"/>tandi et nescio quid suspicandi.</s>
					<s n="7" xml:lang="de">Die zyt <lb xml:id="p1z20"/>und löuff werdent uns filicht leeren, das wir <lb xml:id="p1z21"/>lieber zamen kummend, dann jetzund beschicht.</s>
					<s n="8" xml:lang="la">In<lb xml:id="p1z22"/>stitutum nostrorum optimum fuit et saluberrimum; <lb xml:id="p1z23"/>illine imprudentia an morositate negarint, <lb xml:id="p1z24"/>nescio.</s>
					<s n="9" xml:lang="la">Haec tibi soli scribo ac nolo, <lb xml:id="p1z25"/>cuiquam communices, multas ob caussas.</s>
					<s n="10" xml:lang="la">Ex <placeName ref="l834">Italia</placeName> <lb xml:id="p1z26"/>scribitur bellum et bellorum turbas ita fervere, <lb xml:id="p1z27"/>ut nihil atrotius factum fuerit in hominum <lb xml:id="p1z28"/>memoria.</s>
					<s n="11" xml:lang="la">Duces <placeName ref="l1196">Urbini</placeName> et <placeName ref="l150">Ferrariensis</placeName> <lb xml:id="p1z29"/>et <persName ref="p21383">comes Mirandulae</persName> aperte profitentur <lb xml:id="p1z30"/>partes <placeName ref="l832">Gallicas</placeName>.</s>
					<s n="12" xml:lang="la">De <placeName ref="l522">Venetis</placeName> magna spes <lb xml:id="p1z31"/>est et ipsos <placeName ref="l832">Galli</placeName> partes sequturos.</s>
					<s n="13" xml:lang="la"><placeName ref="l257">Constantiam</placeName> <lb xml:id="p1z32"/>venerunt milites recta ex castris <lb xml:id="p1z33"/><persName ref="p18250">Mauricianis</persName>, qui <lb xml:id="p1z34"/>idem referunt de <placeName ref="l303">Mag<lb xml:id="p1z35"/>deburgensibus</placeName>, quod tu scribis, at de capto <lb xml:id="p1z36"/><persName ref="p18250">Mauritio</persName> ne <lb xml:id="p1z37"/>verbum quidem.</s>
					<s n="14" xml:lang="la">Ago tibi gratias <lb xml:id="p1z38"/>pro diligenti scriptione.</s>
					<s n="15" xml:lang="de"><foreign xml:lang="la">Salvi sint <pb/><lb xml:id="p2z1"/>fratres <lb xml:id="p2z2"/>et symmystae omnes, quibus dices,</foreign> min <lb xml:id="p2z3"/>herren habind uß eehafften ursachen den tag <lb xml:id="p2z4"/>widerumb abgeschriben; dann diewyl den <placeName ref="l41">Bernern</placeName> <lb xml:id="p2z5"/>nitt gefellig den tag zuͦ besuͦchen, habend <lb xml:id="p2z6"/>min herrem fur guͦt angesähen, damitt man <lb xml:id="p2z7"/>nitt meinte, worumb es beschähe, den <lb xml:id="p2z8"/>tag abzeschryben.</s>
					<s n="16" xml:lang="la" ana="farewell">Vale cum tuis omnibus.</s>
					<s n="17" xml:lang="la">Festinantissime.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p2z9"/>17. iulii anno 1551.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Ornatissimo viro d. <persName ref="p8418">Osvaldo Myconio</persName>, domino et <lb xml:id="p2z10"/>fratri suo colendissimo.</s>
					<s n="21" xml:lang="de"><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
