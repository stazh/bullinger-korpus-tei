	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quantum versionem librorum tuorum De gratia dei attinet, <lb xml:id="p1z2"/>paulo ante ex <placeName ref="l337">Neoburgo</placeName> ad te scripsi sperans literas meas <lb xml:id="p1z3"/>ad te perlatas nunc esse.</s>
					<s n="3" xml:lang="la">Sumptus <persName>Ionę</persName> mei <persName>Hieronimo <lb xml:id="p1z4"/>Papus</persName> <placeName ref="l291">Lindoviam</placeName> destinabo; is haud dubie pecunias secure <lb xml:id="p1z5"/>et tuto <placeName ref="l587">Tigurum</placeName> mittere potest.</s>
					<s n="4" xml:lang="la">Tu cręditores meos interim <lb xml:id="p1z6"/>verbis levibus placato.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Doctor <persName ref="p2856">Gereon Sailer</persName> medicus dicit se ex urbe vestra filio <lb xml:id="p1z8"/>suo preceptorem esse nactum, qui iam ad ministerium evangeli<lb xml:id="p1z9"/>cum in patriam revocetur, cumque animus mihi sit <lb xml:id="p1z10"/>Ionam meum per aliquot menses victui <persName ref="p2856">Geryonis</persName> committere <lb xml:id="p1z11"/>et cum filio ipsius in literis versandum tradere, te ob<lb xml:id="p1z12"/>secro, ut aut priorem pręceptorem diutius <placeName ref="l18">Auguste</placeName> agere <lb xml:id="p1z13"/>permittas aut quempiam alium nobis in locum ipsius ad <lb xml:id="p1z14"/>nos dirigas, cuius opera pueri instituantur.</s>
					<s n="6" xml:lang="la">Cui pro <lb xml:id="p1z15"/>laboribus suis nos responsuri sumus.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale.</s>
					<s n="8" xml:lang="la">Celerrime <lb xml:id="p1z16"/>ex <placeName ref="l18">Augusta</placeName> 20. marcii anno 1554.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z17"/>Tuus <persName ref="p8354">Georgius Laetus</persName> <lb xml:id="p1z18"/>a <placeName>Lömnicz</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem hochgelerten und fromen <lb xml:id="p2z2"/>herren <persName ref="p495">Henrichen Bullinger</persName>, <lb xml:id="p2z3"/>vorgeern<note xml:id="fn1" type="footnote" n="1">Antistes.</note> der christlichen kilchn <lb xml:id="p2z4"/><placeName ref="l587">Zurch</placeName>, minem lieben herren <lb xml:id="p2z5"/>und frunnde<lb xml:id="p2z6"/>.</s>
					<s n="11" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zurch</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
