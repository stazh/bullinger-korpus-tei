	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>7. iulii 39. magistratui nostro significater gubernatorem
					<lb xml:id="p1z2"/>pohibuisse, ne quis per iacum Conensem frucnta et
					<lb xml:id="p1z3"/>Mediolani
					<lb xml:id="p1z4"/>alia ad victum pertinentia nehat in valle Tellinam, exercitum
					<lb xml:id="p1z5"/>quoque conscribi. Legatus regis Galliae, qui hic est ait id fieri in
					<lb xml:id="p1z6"/>Philipsi profecturi in Hispaniam. Seriit in marimi
					<lb xml:id="p1z7"/>cectamus Venetorum. Legatus regis asseverat magos
					<lb xml:id="p1z8"/>ugnatum et Gallo
					<lb xml:id="p1z9"/>ese tn scotia notus, bis esse conflictum vel
					<lb xml:id="p1z10"/>Metuunt Galli ne alium creent regem per tu
					<lb xml:id="p1z11"/>Addit legatus filium probectoris Scotiae ex
					<lb xml:id="p1z12"/>mbs regis, qui ipsum capere voluerit elapsum
					<lb xml:id="p1z13"/>s. Vereri itaque ne is ducat Anglam et regi
					<lb xml:id="p1z14"/>Sic Solonon vexa
					<lb xml:id="p1z15"/>fiat infensissimus hostis
					<lb xml:id="p1z16"/>u a profago.
					<pb/>
					<lb xml:id="p2z1"/>Ein eeren rock.3
					<lb xml:id="p2z2"/>En keyd zuͦ eeren.
					<lb xml:id="p2z3"/>lisch ind bauben
					<lb xml:id="p2z4"/>studier tisch.
					<lb xml:id="p2z5"/>disch tuch und zwähelen.
					<lb xml:id="p2z6"/>blatten, Schußle, Täller
					<lb xml:id="p2z7"/>häfen, besse, pfannen
					<lb xml:id="p2z8"/>Bettstatt. Rasten
					<lb xml:id="p2z9"/>enutatio in
					<lb xml:id="p2z10"/>No test
					<lb xml:id="p2z11"/>wyn.
					<lb xml:id="p2z12"/>.
