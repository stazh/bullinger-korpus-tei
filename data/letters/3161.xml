	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l491">Argent[ina]</placeName> 23<lb xml:id="p1z2"/>. Aprilis.</s>
					<s n="2" xml:lang="la">Literas tuas, vir doctissime, cum illa concione de Christi Domini confessione et abnegatione <lb xml:id="p1z3"/>accepi.</s>
					<s n="3" xml:lang="la">Ceterum, quia postridie eram <placeName ref="l157">Franckofordiam</placeName> petiturus, nec potui tuis <lb xml:id="p1z4"/>respondere, neque mihi ipsi in eo, quod propuseram, hucusque satisfacere.</s>
					<s n="4" xml:lang="la">Jam vero reversus, <lb xml:id="p1z5"/>octiumque nactus, quod respondeam nihil aliud habeo, nisi ut gratias dem tuae humanitati, <lb xml:id="p1z6"/>non meo tantum, sed etiam <placeName ref="l830">Angliae</placeName> nomine.</s>
					<s n="5" xml:lang="la">Non enim mihi solummodo rem gratissimam fecisti, <lb xml:id="p1z7"/>sed <placeName ref="l830">Angliae</placeName> longe utilissimam, ni nos proprio invideamus commodo.</s>
					<s n="6" xml:lang="la">Apud me jam <lb xml:id="p1z8"/>est constitutum, tuam illam concionem in vulgarem nostrum sermonem quamprimum vertere, et <lb xml:id="p1z9"/>sic <placeName ref="l830">Anglis</placeName> legendam dare.</s>
					<s n="7" xml:lang="la">Sed ne Latinam imprimendam curarem, partim me monebat <lb xml:id="p1z10"/>meae petitionis ratio, qua <placeName ref="l830">Anglistantum</placeName> consultum petebam, partim quia de tua non constabat <lb xml:id="p1z11"/>mihi voluntate.</s>
					<s n="8" xml:lang="la">Latinam ergo tuae relinquo prudentiae, de qua tamen, si mihi apud te <lb xml:id="p1z12"/>liceret dicere quod sentio, dicerem eam huic deficienti seculo valde necessariam.</s>
					<s n="9" xml:lang="la">Ceterum <lb xml:id="p1z13"/>ego id, quod libenter suscepi, curabo quam possim fideliter.</s>
					<s n="10" xml:lang="la">Tibi <placeName ref="l830">Anglia</placeName> gratias debet, et <lb xml:id="p1z14"/>dabit, spero.</s>
					<s n="11" xml:lang="la">Te Deus pro sua misericordia ecclesiae suae viventem valentemque diu <lb xml:id="p1z15"/>conservet, tuque me devinctissimum tibi puta.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Tuus enim sum, <persName ref="p2866">Tho. Sampson</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z16"/>Fratres nostros tuae humanitati nos omnes commendamus, qui te de rebus nostris certiorem facient.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro et <lb xml:id="p2z2"/>Christi ministro fidelissimo <lb xml:id="p2z3"/>D. <persName ref="p495">Henricho Bullingero</persName>, <placeName ref="l587">Tyguri</placeName>.</s>
				</p>
			</div>
		</body>
