	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia Christi tecum.</s>
					<s n="2" xml:lang="la">Qum hunc <persName>Ulrichum <lb xml:id="p1z2"/>Aescherum</persName> ex vestratibus patriam repetentem ac <lb xml:id="p1z3"/>fidum nuntium omnisque modestiae expolitum simulacrum, <lb xml:id="p1z4"/>nactus fuerim, nolui doctissime, ne dicam omnium fratrum <lb xml:id="p1z5"/>charissime <persName ref="p495">Bullingere</persName>, hoc piaculi in te, patronum <lb xml:id="p1z6"/>nostrarum ecclesiarum, quę circum vicinos malevolos <lb xml:id="p1z7"/>homines ridetur, quasi propediem sit excindenda, com<lb xml:id="p1z8"/>mittere, quo haberes certum nostris de rebus etc.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z9"/>Ecclesię adhuc sua utuntur libertate in Christo Iesu, <lb xml:id="p1z10"/>tametsi sint, qui putent ad nos Baalicos, quod <lb xml:id="p1z11"/>absit, pfaffones recipiendos.</s>
					<s n="4" xml:lang="la">Sed deus meliora <lb xml:id="p1z12"/>dabit; nam respublicę ecclesiarum ita callum verbo <lb xml:id="p1z13"/>gratię instructę obduxerunt, ut nunc vehementius <lb xml:id="p1z14"/>quam unquam <placeName ref="l875">Hispanicam</placeName> fidem sive religionem odiant; <lb xml:id="p1z15"/>agnoscunt enim imposturas.</s>
					<s n="5" xml:lang="la">Utinam ita sine seditione, <lb xml:id="p1z16"/>sed vera in Christo patientia cum resipiscentia perstent.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z17"/>Catabaptistę multum negotii nobis facessunt, quorum <lb xml:id="p1z18"/>stultitia a cordatis iam utcunque etiam deprehenditur.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z19"/><persName>Nicolaus Baunerus</persName>, cuius calumnias legisti, ni <lb xml:id="p1z20"/>fallor, per principem missas, recantavit nunc <lb xml:id="p1z21"/>spiritum sanctum admittens tertiam personam sacrę triadis; <lb xml:id="p1z22"/>item adserit Christum veram carnem ex semine Abra<lb xml:id="p1z23"/>hę, Davidis atque tandem ex virgine Maria sine <lb xml:id="p1z24"/>omni labe et peccato adsumpsisse; proscriptus nunc exulat <lb xml:id="p1z25"/>ac per literas orat recipi in gratiam etc.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z26"/>Constans fama conciliabulum <placeName ref="l1107">Tridentinum</placeName> dissipatum; <lb xml:id="p1z27"/><placeName ref="l491">Argentoratensis</placeName> episcopus rediit, certum est, item et <placeName ref="l307">Moguntinus</placeName> <lb xml:id="p1z28"/>et <placeName ref="l1028">Trevirensis</placeName>.</s>
					<s n="9" xml:lang="la">Christus non deerit et suis <lb xml:id="p1z29"/>et suę causę.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale in Christo.</s>
					<s n="11" xml:lang="la" ana="salute">Salutant vos fratres in <lb xml:id="p1z30"/>Christo, <persName>Regulus</persName> praecipue.</s>
					<s n="12" xml:lang="la" ana="salute">Saluta tu nobis tuos symmystas <lb xml:id="p1z31"/><persName ref="p8011">Gvaltherum</persName>, <persName ref="p8171">Bibliandrum</persName>, meum conpresbyterum <persName ref="p8127">Pellicanum</persName>; <lb xml:id="p1z32"/>dic illi me congregare viaticum ad peregrinationem, <lb xml:id="p1z33"/>que propediem instabit, ut idem faciat.</s>
					<s n="13" xml:lang="la">Utinam <lb xml:id="p1z34"/>liberemur secundum domini voluntatem.</s>
					<s n="14" xml:lang="la"><placeName ref="l411">Richenvillę</placeName> 26. o<lb xml:id="p1z35"/>ctobris 1551.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">T[<lb xml:id="p1z36"/>uus] <persName ref="p1010">Erbius</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Pietatis ac sacrae eruditi<lb xml:id="p2z2"/>onis eximio viro d. <lb xml:id="p2z3"/><persName ref="p495">Henrycho Bullingero</persName>, <lb xml:id="p2z4"/><placeName ref="l587">Tygurinorum</placeName> antistiti <lb xml:id="p2z5"/>vigilantissimo<lb xml:id="p2z6"/>.</s>
				</p>
