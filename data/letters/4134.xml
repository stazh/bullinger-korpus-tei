	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Dices pro certo clarissimis viris d. d. consulibus <lb xml:id="p1z2"/>et cordatis senatoribus hoc unum agi, ut in <placeName ref="l648">Rhetia</placeName> <lb xml:id="p1z3"/>collegium Iesuitarum instituatur.</s>
					<s n="3" xml:lang="la">Iesuitae in<lb xml:id="p1z4"/>auspicatum genus monachorum, qui ad invidiam de<lb xml:id="p1z5"/>clinandam vix sustinent nuncupari monachi, <lb xml:id="p1z6"/>vincunt hypocrisi, improbitate, audatia et nequitia <lb xml:id="p1z7"/>monachos omnes.</s>
					<s n="4" xml:lang="la">In hoc intenti sunt toti, ut <lb xml:id="p1z8"/>opprimant evangelium et restituant collapsum papatum <lb xml:id="p1z9"/>paulatimque subducant homines in capti<lb xml:id="p1z10"/>vitatem antichristianam.</s>
					<s n="5" xml:lang="la">Ergo non utuntur pro<lb xml:id="p1z11"/>digioso monachorum habitu.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Dici volunt a Iesu <lb xml:id="p1z12"/>unico servatore Iesuitae, ne audiant impie <lb xml:id="p1z13"/>ipsos denominari ab hominibus; Iesum ergo labiis <lb xml:id="p1z14"/>crepant, corde oderunt<note type="margin">dazu a.R.: "Iesu wider, Iesu wydt."</note>.</s>
					<s n="7" xml:lang="la">Gratis docent et mi<lb xml:id="p1z15"/>rifice insinuant se in animos hominum.</s>
					<s n="8" xml:lang="la">Docti sunt <lb xml:id="p1z16"/>plerique, acuti, eloquentes.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Mitto hic quaedam <lb xml:id="p1z17"/>de ipsorum initiis; sed vide, ut exacto hoc <lb xml:id="p1z18"/>octiduo remittas certo et tuto.</s>
					<s n="10" xml:lang="la"><persName ref="p18477">Rex Ferdinandus</persName> <lb xml:id="p1z19"/>imperator eos fovet prae aliis.</s>
					<s n="11" xml:lang="la">Coeperunt iam <placeName ref="l546">Viennae</placeName> <lb xml:id="p1z20"/>et <placeName ref="l231">Ingolstadii</placeName> nidulari, nec dubito, <lb xml:id="p1z21"/>quin et cum <placeName ref="l2448">5 Pagicis</placeName> et cum abbate <placeName ref="l473">Sangallensi</placeName> <lb xml:id="p1z22"/>plurima communicent consilia, ac audio inter illos <lb xml:id="p1z23"/>clanculum multa tentari de schola instituend.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/>Hoc certum est: si semel receperitis illas ranas <lb xml:id="p1z25"/><placeName ref="l648">Rhetiam</placeName> nunquam solidam habituram pacem.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z26"/>Vigilate itaque et serio agite, quae decent <lb xml:id="p1z27"/>viros dei.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Te oro, ut has ipsas literas mittas <lb xml:id="p1z28"/>d. <persName ref="p8432">Friderycho a Salice</persName>; non potui eo scribere.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z29"/>Filius meus per <placeName ref="l18">Augustam</placeName> ex <placeName>Tarvisio</placeName> <lb xml:id="p1z30"/>scripsit<note type="margin">dazu a.R.: "Datae sunt filii literae 5. octobris."</note> se misisse ad ipsum d. <persName>Friderychum</persName> literas, in quibus <lb xml:id="p1z31"/>omnes res suas complexus sit.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Oratum velim itaque <lb xml:id="p1z32"/>ipsum, ut diligenter eas ad me perferri curaret; <lb xml:id="p1z33"/>intelligo enim, quod de pecuniis in illis agit.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z34"/>Remitto articulos cardinalicios carnalissimos; vidimus <lb xml:id="p1z35"/>alias ordine articulos omnes scripti Italice, <lb xml:id="p1z36"/>quos mihi interpretabatur <persName ref="p8101">Laelius</persName>.</s>
					<s n="18" xml:lang="de">Es sind groß buͦben.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z37"/>Conscribuntur a nostris comitia <placeName ref="l21">Badenam</placeName> 10. decembris <lb xml:id="p1z38"/>inchoanda.</s>
					<s n="20" xml:lang="la">Agetur in illis cum <placeName ref="l28">Basiliensibus</placeName> de annona, <lb xml:id="p1z39"/>quam isti partius<note type="misc">i.S.v. parcius</note> ad nos vehi sinunt etc.</s>
					<s n="21" xml:lang="la">Vix <lb xml:id="p1z40"/>haec exarare potui.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 24. novembris <lb xml:id="p1z41"/>anno 1559.</s>
					<s n="24" xml:lang="la" ana="salute"><lb xml:id="p1z42"/>Saluta <lb xml:id="p1z43"/>amicos.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z44"/><persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>apud <placeName ref="l648">Rhetos</placeName> ministro, com<lb xml:id="p2z4"/>patri et fratri suo charissimo.</s>
					<s n="27" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
