	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salutem et graciam per Christum, dominum nostrum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Duabus <lb xml:id="p1z2"/>nundinis <placeName ref="l157">Franckfordium</placeName>[!] proximis elapsis<note xml:id="fn1" type="footnote" n="1"><persName ref="p2448">Pergener</persName> bezieht sich auf die Frühjahrs- und Herbstmesse des Jahres 1541 (allerdings liegt ein Brief an <persName ref="p495">Bullinger</persName> vom 1. März 1541 vor; s. <bibl source="b14">HBBW XI</bibl>, <ref target="file11513">Nr. 1470</ref>).</note> litteras nullas ad fide<lb xml:id="p1z3"/>lissimos<note xml:id="fnb" type="footnote" n="b"><hi>In der Vorlage</hi> fidelissimas.</note> ministros verbi dei apud <placeName ref="l587">Tigurum</placeName><note xml:id="fnc" type="footnote" n="c"><hi>In der Vorlage</hi> Tigurnn <hi>oder</hi> <placeName ref="l587">Tigurim</placeName>.</note> dedi, <persName ref="p495">Bullingere</persName> charissime.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Hoc autem factum est non mea negligencia vel fortę[!] ob<lb xml:id="p1z5"/>livione; nam semper<pb type="edition" next="42"/> memor sum vestri et ex vestris scriptis <lb xml:id="p1z6"/>vere agnosco spiritum Christi inhabitare vestra pectora.</s>
					<s n="4" xml:lang="la">Since<lb xml:id="p1z7"/>ro animo hoc scribo; sentiunt mecum fratres fideles quam <lb xml:id="p1z8"/>plurimi.</s>
					<s n="5" xml:lang="la">In causa vero fuit iuvenis ille <placeName ref="l157">Francfordianus</placeName>, <persName ref="p5197">Io<lb xml:id="p1z9"/>annes</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p5197">Johannes Hensenstein</persName>.</note> nomine; ex quo uxorem<note xml:id="fn3" type="footnote" n="3">Unbekannt.</note> in <placeName ref="l1647">Chutnis Montibus</placeName><note xml:id="fn4" type="footnote" n="4"><placeName ref="l1647">Kuttenberg (Kutná Hora</placeName>, <placeName ref="l3685">Mittelböhmen</placeName>).</note> duxerit,<note xml:id="fn5" type="footnote" n="5">Vgl. <bibl source="b11">HBBW IX</bibl> <ref target="file11336">[Nr. 1293]</ref>, S. 186, 3f.</note> raro <lb xml:id="p1z10"/><placeName ref="l157">Francfordiam</placeName> adit, licet natus hic sit.</s>
					<s n="6" xml:lang="la">Reperi tandem homine<lb xml:id="p1z11"/>m in <placeName ref="l1899">Budissin</placeName><note xml:id="fn6" type="footnote" n="6"><placeName ref="l1899">Bautzen</placeName> (<placeName ref="l749">Sachsen</placeName>).</note>, que civitas iter diei ab hac urbe sita est, <lb xml:id="p1z12"/>qui nundinas <placeName ref="l157">Francfordienses</placeName><note xml:id="fnd" type="footnote" n="d"><hi>Undeutlich korrigiert aus</hi> <placeName ref="l157">Francfordium</placeName>.</note> non negligit.</s>
					<s n="7" xml:lang="la">Is ultro<note xml:id="fne" type="footnote" n="e"><hi>In der Vorlage</hi> ultero.</note> promisit <lb xml:id="p1z13"/>litteras meas <persName ref="p4851">Christofero Froschouero</persName> sese<note xml:id="fnf" type="footnote" n="f"><hi>In der Vorlage</hi> se se.</note> exhibiturum addens <lb xml:id="p1z14"/>insuper bibliothecam<note xml:id="fn7" type="footnote" n="7">Gemeint ist offenbar <persName ref="p4851">Froschauers</persName> Niederlassung in <placeName ref="l157">Frankfurt</placeName>.</note> eius sibi esse notam.</s>
					<s n="8" xml:lang="la">Cuius opera <lb xml:id="p1z15"/>fiet, ut post hac negligencię non sit locus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Ego vicissim vestra <lb xml:id="p1z16"/>commentaria summo gaudio expecto.</s>
					<s n="10" xml:lang="la">Biennio ferme nihil librorum <lb xml:id="p1z17"/>ad nos pervenit.</s>
					<s n="11" xml:lang="la">Mirantur multi fratres et ego cum <lb xml:id="p1z18"/>illis.</s>
					<s n="12" xml:lang="la">Illis diebus dei benignitate nactus sum annotacio<lb xml:id="p1z19"/>nes sancti viri <persName ref="p4091">Hul[drichi] Tzvinglii</persName> in Genesin et Exodum per <lb xml:id="p1z20"/><persName ref="p1753">Leonem Iudę</persName> et <persName ref="p8412">Casparum Megandrum</persName> excerptas<note xml:id="fn8" type="footnote" n="8"><persName ref="p4091">Zwinglis</persName> Erläuterungen zu Genesis und Exodus (<bibl source="b700">Z</bibl> XIII 1-290 bzw. 291-427) waren bereits 1527 in einer von <persName ref="p1753">Leo Jud</persName> und <persName ref="p8412">Kaspar Megander</persName> besorgten Ausgabe bei <persName ref="p4851">Christoph Froschauer</persName> erschienen (<bibl>BZD</bibl> C 131 bzw. 134).</note>.</s>
					<s n="13" xml:lang="la"><placeName ref="l558">Wittem<lb xml:id="p1z21"/>bergensis</placeName>[!] ministri nihil preter Germanicos libros nobis obtrudunt.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z22"/>Lubens plura scriberem; sed omnia, quę in mente habeo, <lb xml:id="p1z23"/>nota vobis sunt.</s>
					<s n="15" xml:lang="la">Novarum rerum nihil est, quod vos <lb xml:id="p1z24"/>delectare posset.</s>
					<s n="16" xml:lang="la"><persName ref="p18593">Turca</persName><note xml:id="fn9" type="footnote" n="9">Sultan <persName ref="p18593">Suleiman I.</persName></note> regnat in <placeName ref="l882">Hungaria</placeName> late quietę[!] factus <lb xml:id="p1z25"/>noster vicinis[!].</s>
					<s n="17" xml:lang="la">Ultra fines <placeName ref="l882">Hungarie</placeName> nondum progres<lb xml:id="p1z26"/>sus est.</s>
					<s n="18" xml:lang="la">Obstitit forte pestilencia, que <placeName ref="l850">Austriam</placeName> et <placeName ref="l921">Mora<lb xml:id="p1z27"/>viam</placeName> invaserat.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">In mense decembri iam preterito <lb xml:id="p1z28"/>congregavit rex <persName ref="p18477">Ferdinandus</persName> <placeName ref="l396">Pragam</placeName> <placeName ref="l921">Moravos</placeName>, <placeName ref="l449">Schlesitas</placeName> <lb xml:id="p1z29"/>et utramque <placeName ref="l363">Lusaciam</placeName>; aderant et <placeName ref="l850">Austriaci</placeName><note xml:id="fn10" type="footnote" n="10">Zum Generallandtag in <placeName ref="l396">Prag</placeName>, der am 5. Dezember 1541 begann und am 15. Januar 1542 endete, s. RTA JR XII/1 61.</note>.</s>
					<s n="20" xml:lang="la">Pos<lb xml:id="p1z30"/>tulabat auxilia contra <placeName ref="l2510">Turcam</placeName>.</s>
					<s n="21" xml:lang="la">Promissa sunt subsidia, <lb xml:id="p1z31"/>sed nihil contra <placeName ref="l2510">Turcam</placeName> que fatient.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><placeName ref="l850">Austriaci</placeName> <lb xml:id="p1z32"/>inprimis cupiunt evangelium in eorum<note xml:id="fng" type="footnote" n="g"><hi>In der Vorlage</hi> erorum[?].</note> terra sincere <lb xml:id="p1z33"/>predicari asserentes impietatem in causa esse, quod nihil <lb xml:id="p1z34"/>feliciter sit gestum contra <placeName ref="l2510">Turcam</placeName>.</s>
					<s n="23" xml:lang="la">Obluctabantur papistę, <lb xml:id="p1z35"/>presertim monachus<note xml:id="fn11" type="footnote" n="11"><persName ref="p2448">Pergener</persName> bezeichnet <persName ref="p7688">Friedrich Nausea</persName> zu Unrecht als Mönch.</note> quidem nomine <persName ref="p7688">Nausea</persName> fac<lb xml:id="p1z36"/>tus iam episcopus <placeName ref="l546">Viennensis</placeName>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Cetera scribam <placeName ref="l822">Germanice</placeName> <lb xml:id="p1z37"/>ad <persName ref="p4851">Christo[ferum] Frosch[ouerum]</persName><note xml:id="fn12" type="footnote" n="12">Siehe <persName ref="p2448">Pergeners</persName> Brief an <persName ref="p4851">Froschauer</persName> vom 21. Februar 1542 (Zürich StA, E II 367, 5-8).</note>.</s>
					<s n="25" xml:lang="la">Opto vestris ecclesiis et ministris <lb xml:id="p1z38"/>earum incrementa congnicionis[!] dei.</s>
					<s n="26" xml:lang="la" ana="salute">Salvus sit <persName ref="p8127">Pellicanus</persName>,<pb type="scan" next="222"/> <pb/><lb xml:id="p2z1"/><persName ref="p1753">Leo Iude</persName>, <persName ref="p8412">Megander</persName>, <persName ref="p8171">Bibliander</persName> et ceteri.</s>
					<s n="27" xml:lang="la">Ad futuras nundinas, <lb xml:id="p2z2"/>si Christi gracia adfuerit, pluribus scribam; ea sit cum nobis omnibus.<pb type="edition" next="43"/></s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p2z3"/>Celerrime ex <placeName ref="l580">Zitavia</placeName> in marchionatu <placeName ref="l363">Superioris Lusacię</placeName>, 20. mensis februar<lb xml:id="p2z4"/>ii anno 1542.</s>
				</p>
				<p>
					<s n="29" xml:lang="la">Fraternitatis vestre deditissimus</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><persName ref="p2448">Osvaldus Pergenerus</persName> <lb xml:id="p2z5"/>etc. a commentariis<note xml:id="fn13" type="footnote" ana="lex" n="13">Stadtschreiber.</note>.</s>
				</p>
				<p>
					<note type="address">[Adresse darunter:]</note>
					<s n="31" xml:lang="la">Vere pio et erudito <lb xml:id="p2z6"/>viro d. <persName ref="p495">Henricho Bulli<lb xml:id="p2z7"/>nger<lb xml:id="p2z8"/>o</persName>, amplissime ecclesię <placeName ref="l587">Tigurine</placeName> episco<lb xml:id="p2z9"/>po, amico sinccerissimo.</s>
				</p>
			</div>
		</body>
