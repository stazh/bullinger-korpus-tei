	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Literas tuas, clarissime vir et pater in Christo reverende, <lb xml:id="p1z2"/>summa animi laetitia accepi, et gratulamur omnes <lb xml:id="p1z3"/>in domino, quod sensim te dominus ex i<lb xml:id="p1z4"/>nfirmitate diuturna ad sanitatem reducit, <lb xml:id="p1z5"/>optimo de iusto quoque brevi robore restituendo <lb xml:id="p1z6"/>in eodem domino sperantes.</s>
					<s n="3" xml:lang="la">Cognovimus <lb xml:id="p1z7"/>tuam et censorum in emendanda <lb xml:id="p1z8"/>catechesi sententiam.</s>
					<s n="4" xml:lang="la">Quantum ad primam eius lineam <lb xml:id="p1z9"/>attinet, interposuimus verbum, de quo ad<lb xml:id="p1z10"/>monuisti; deinde vocabulum <foreign xml:lang="de">ketzer</foreign> in verbum <lb xml:id="p1z11"/><foreign xml:lang="de">sectler,</foreign> quod similiter disyllabum sit et d. <lb xml:id="p1z12"/><persName ref="p3988">Wolffio</persName> non displiceat, muatvimus; recolimus <lb xml:id="p1z13"/>enim, quod vox <foreign xml:lang="de">ketzer</foreign> apud nos non errori tan<lb xml:id="p1z14"/>tum maledicto pertinaciter inhaerentem, <lb xml:id="p1z15"/>sed etiam foedissima libidine pollutum significet <lb xml:id="p1z16"/>ideoque in nostris regionibus abominabilius sit <lb xml:id="p1z17"/>quam in plerisque aliis.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quantum ad vocem papae <lb xml:id="p1z18"/>in penultimo cantico pertinet, malumus totam <lb xml:id="p1z19"/>omitti quam papae nomen mutari et <placeName ref="l2510">Turcae</placeName> <lb xml:id="p1z20"/>relinqui; causae praecipuae sunt, quod minus recte <lb xml:id="p1z21"/>sęparari videantur, quos scriptura coniungit.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z22"/>Deinde quod plerisque videri possemus nos <lb xml:id="p1z23"/>maeretrici Babylonicae blandiri velle; nam <lb xml:id="p1z24"/>idem <placeName ref="l361">Noribergensibus</placeName> apud plerasque <placeName ref="l822">Germaniae</placeName> <lb xml:id="p1z25"/>ecclesias reformatas accidit, qui verba <foreign xml:lang="de">"und <lb xml:id="p1z26"/>wehr des papsts und <placeName ref="l2510">Türcken</placeName> mord"</foreign> in ista <lb xml:id="p1z27"/>mutarunt tempore Interim <foreign xml:lang="de">"und wehr <lb xml:id="p1z28"/>des teuffels lug und mord",</foreign> unde pasquillus <lb xml:id="p1z29"/>ubique sparsus cecinit: "witz habuit <placeName ref="l361">Nürnberg</placeName>, <lb xml:id="p1z30"/>achsla tragavit utraque."</s>
					<s n="7" xml:lang="la">Quia igitur hoc canticum <lb xml:id="p1z31"/>in omnibus celebrioribus <placeName ref="l822">Germaniae</placeName> ecclesiis solennite<lb xml:id="p1z32"/>r canitur, malumus, ut dixi, omittere inter nostra cat<lb xml:id="p1z33"/>echistica carmina quam mutatum inseri, ne nobis, quod iam scriptum est, <lb xml:id="p1z34"/>a malevolis accidat.</s>
					<s n="8" xml:lang="la">Quia enim breve est et prius in libello Psalmorum a d. <persName ref="p1227">Froschouero</persName> ex<lb xml:id="p1z35"/>cusorum habetur, poterit quaelibet ecclesia, cui canere placebit, inde petere.</s>
					<s n="9" xml:lang="la">Poterit et ha<lb xml:id="p1z36"/>nc ob causam forte haud incommode omitti, ne ob hanc vocem aliquibus <lb xml:id="p1z37"/>infirmis tota catechesis excutiatur ex manibus; debet enim catechismus simplex esse <lb xml:id="p1z38"/>veritatis doctrina<note type="margin">Zusatz a.R.</note>.</s>
					<s n="10" xml:lang="la">Latine vero hoc tempore nolumus <lb xml:id="p1z39"/>excudi catechesin, donec inspiciant scholae nostrae.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z40"/>Hoc ex silentio nostro antea intelligere vos <lb xml:id="p1z41"/>putabamus.</s>
					<s n="12" xml:lang="la">Festinanter haec scribo, quare <lb xml:id="p1z42"/>festinanti ignoscas.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Resalutant vos fratres.</s>
					<s n="14" xml:lang="la" ana="salute"><lb xml:id="p1z43"/>Salutabis nostro nomine clarissimos viros d. d. <persName ref="p8011">Gvaltherum</persName> <lb xml:id="p1z44"/>et <persName ref="p3988">Wolffium</persName> omnesque fratres.</s>
					<s n="15" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="16" xml:lang="de">Datum 7. iulii 1569.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Tuus <lb xml:id="p1z45"/><persName ref="p8109">Iohannes Conradus <lb xml:id="p1z46"/>Ulmerus</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z47"/>Hortator eris d. <persName ref="p1227">Froschouero</persName>, <lb xml:id="p1z48"/>ut brevi excudatur propter iuventu<lb xml:id="p1z49"/>tem catechismus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo omnique eruditionis et <lb xml:id="p2z2"/>virtutis genere ornatissimo viro <lb xml:id="p2z3"/>d. <persName ref="p495">Henrico Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae antistiti fidelissimo, <lb xml:id="p2z5"/>patri meo in Christo summe colendo.</s>
				</p>
			</div>
