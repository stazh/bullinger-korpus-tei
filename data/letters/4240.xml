	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Hodie ad te, mi frater, scripsi; nunc <lb xml:id="p1z2"/>iterum scribo, maxime propter hunc <persName>Maternum</persName>, <lb xml:id="p1z3"/>qui has tibi offert, virum sanctissimum et doctissimum.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Convictor hic aliquamdiu fuit d. <persName ref="p8111">Petri <lb xml:id="p1z5"/>Martyris</persName>, nunc cogitat videre <placeName ref="l834">Italiam</placeName>.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Ego modis omnibus dissuavi; sed quoniam ita <lb xml:id="p1z7"/>constituit et literas commendatitias postulavit, <lb xml:id="p1z8"/>ego illum tibi commendo virum modis omnibus <lb xml:id="p1z9"/>dignum, cui faveant et quem promoveant viri <lb xml:id="p1z10"/>boni.</s>
					<s n="5" xml:lang="la">Habes forte in <placeName ref="l520">Valle Tellina</placeName> <placeName ref="l834">Italos</placeName>, quibus <lb xml:id="p1z11"/>ipsum commendes, qui ipsum scriptis et consilio iuvent.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Obsecro, sic eum excipias et promoveas, <lb xml:id="p1z13"/>ut sentiat nostram ipsi commendationem profuisse <lb xml:id="p1z14"/>plurimum.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 22. martii 1560.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note>[Darunter von der Hand des <persName ref="p8009">Fabricius</persName>:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName>Maternus Eccilius</persName> <placeName>Silesius</placeName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Praestan<lb xml:id="p2z2"/>tissimo viro d. <persName ref="p8009">Ioanni Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro <lb xml:id="p2z4"/>fideli, compatri et <lb xml:id="p2z5"/>fratri charissimo suo.</s>
					<s n="12" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName> in <lb xml:id="p2z7"/><placeName ref="l648">Pündten</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
