	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Cur tu nihil scribas, ego valde miror, praesertim <lb xml:id="p1z2"/>in tam difficili rerum statu.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Ego quietus <lb xml:id="p1z3"/>et plane securus mihi omnia bona ex <lb xml:id="p1z4"/>proximis comitiis pollicebar ideoque hodie, <lb xml:id="p1z5"/>cum prodeambulandi gratia progredior, plures <lb xml:id="p1z6"/>advolitant, sciscitantur, si quid haberem novi, <lb xml:id="p1z7"/>indicant, quid a senatu <placeName ref="l587">Tigurino</placeName> sit <lb xml:id="p1z8"/>scriptum, quid aliunde et quod cras hic <lb xml:id="p1z9"/>futura sunt comitia.</s>
					<s n="3" xml:lang="de">Es ist der bruch, das <lb xml:id="p1z10"/>der bischoff das usschrybt im <placeName>Gottshuß</placeName>, so im ein radt an <lb xml:id="p1z11"/>die hand gibt.</s>
					<s n="4" xml:lang="la">Ille autem recusavit et voluit <lb xml:id="p1z12"/>tantum accersere viciniores, papistas scilicet; <lb xml:id="p1z13"/>sed cum ille tergiversaretur, senatus noster <lb xml:id="p1z14"/>dedit ei optionem, aut ipse scriberet aut <lb xml:id="p1z15"/>se perscripturum, ideoque episcopus videns <lb xml:id="p1z16"/>serio rem agi scripsit tandem, licet invitus <lb xml:id="p1z17"/>admodum.</s>
					<s n="5" xml:lang="de">Es schrybt ein junger von <persName>Höuwen</persName> <lb xml:id="p1z18"/>dem von <placeName>Marmols</placeName>: er höre, ein eidgnoschafft <lb xml:id="p1z19"/>stande nit wol zesamen; sye im treffenlich <lb xml:id="p1z20"/>leyd.</s>
					<s n="6" xml:lang="de">Der pfaltzgraff am <placeName ref="l2459">Rhyn</placeName> besamle <lb xml:id="p1z21"/>ouch ein groß volckh, <foreign xml:lang="la">de quo tu m<lb xml:id="p1z22"/>elius sc<lb xml:id="p1z23"/>ire <pb/><lb xml:id="p2z1"/>pot<lb xml:id="p2z2"/>es<lb xml:id="p2z3"/>.</foreign></s>
					<s n="7" xml:lang="la">Item <lb xml:id="p2z4"/>al<lb xml:id="p2z5"/>ii <lb xml:id="p2z6"/>dicu<lb xml:id="p2z8"/>nt ba<lb xml:id="p2z9"/>lis<lb xml:id="p2z10"/>tar<lb xml:id="p2z12"/>ios ia<lb xml:id="p2z13"/>cul<lb xml:id="p2z14"/>at<lb xml:id="p2z15"/>o<lb xml:id="p2z16"/>res <lb xml:id="p2z18"/>nos<lb xml:id="p2z19"/>tro<lb xml:id="p2z20"/>s <lb xml:id="p2z21"/><foreign xml:lang="de">(<lb xml:id="p2z22"/>di<lb xml:id="p2z23"/>e sc<lb xml:id="p2z25"/>h<lb xml:id="p2z26"/>üt<lb xml:id="p2z27"/>zen)</foreign> <pb/><lb xml:id="p3z1"/>ben<lb xml:id="p3z2"/>igne <lb xml:id="p3z4"/>d<lb xml:id="p3z5"/>imis<lb xml:id="p3z6"/>sos <lb xml:id="p3z7"/>no<lb xml:id="p3z8"/>n <lb xml:id="p3z9"/>s<lb xml:id="p3z11"/>i<lb xml:id="p3z12"/>n<lb xml:id="p3z14"/>e <lb xml:id="p3z16"/>spe <lb xml:id="p3z18"/>e<lb xml:id="p3z19"/>t <lb xml:id="p3z25"/>p<pb/><lb xml:id="p4z1"/>o<lb xml:id="p4z3"/>l<lb xml:id="p4z4"/>-</s>
					<note>Die Transkription bricht hier ab.</note>
				</p>
