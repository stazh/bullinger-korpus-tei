	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Ero ominus igi missis et Butheri remnissig clirissime
					<lb xml:id="p1z2"/>Bullingere, gratrius ago Angli vicem doleo, qui iniquitate
					<lb xml:id="p1z3"/>fortunę premitur. meo iuditio pri melior fortuna
					<lb xml:id="p1z4"/>deguug. Ego heri domum redii ab aliquot principit
					<lb xml:id="p1z5"/>qui proximis diebus eeoisationis scriptum conta
					<lb xml:id="p1z6"/>conventum papisticum modo Tridenti hęrentem
					<lb xml:id="p1z7"/>mulgabunt principes deacverunt concilium hoc
					<lb xml:id="p1z8"/>non ignoscere, utpote a papa convocatum, in quo soli
					<lb xml:id="p1z9"/>qui pape iurati sunt iudicabunt et pro sua libidi
					<lb xml:id="p1z10"/>neomnia decernent, iuxtu tua conmptissimas edi
					<lb xml:id="p1z11"/>et consuetudines (id quod secundum sestio suti
					<lb xml:id="p1z12"/>indicat; nam ibi addut ausarum diiudicationem
					<lb xml:id="p1z13"/>futuram ex authoritate patrinis et  consensu
					<lb xml:id="p1z14"/>veteriis et catholice ecclesie. quam autem illi catholocam
					<lb xml:id="p1z15"/>vocent eu docere cum se catholiog nos rorestandę
					<lb xml:id="p1z16"/>apellitent Dux Maurumg dei voluntate dissipin
					<lb xml:id="p1z17"/>non ita pridem papisticau cohorteque fuede deo
					<lb xml:id="p1z18"/>collumem
					<lb xml:id="p1z19"/>fuerit etim protentem prper Condensem principem di
					<lb xml:id="p1z20"/>principus et sianu Germanię non sinem
					<lb xml:id="p1z21"/>militem hinc educi contra Gallos deo militantes
					<lb xml:id="p1z22"/>Anglicum omnia accipiete ex latore preseraim
					<lb xml:id="p1z23"/>ut me amantissime salutem venerandum virum
					<lb xml:id="p1z24"/>D. Martinem et Rudolphum Gvalterum Maieium
					<lb xml:id="p1z25"/>offitia erga vos perpetuo constabunt Aergentinam
					<lb xml:id="p1z26"/>2. fpuli
					<lb xml:id="p1z27"/>hiscophorus Men.
					<pb/>
					<lb xml:id="p2z1"/>Eximio eruditione et
					<lb xml:id="p2z2"/>vircuro viro d. Bullingero,
					<lb xml:id="p2z3"/>domino olevandio.
					<lb xml:id="p2z4"/>abidissimo meo
					<lb xml:id="p2z5"/>Geuric
				</p>
