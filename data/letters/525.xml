					<s n="14" xml:lang="la"><lb xml:id="p2z36"/><placeName ref="l587">Ti<lb xml:id="p2z37"/>g<lb xml:id="p2z38"/>uri</placeName><lb xml:id="p2z41"/>.</s>
				</p>
