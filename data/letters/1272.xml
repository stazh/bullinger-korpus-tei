	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="de"><foreign xml:lang="la">De Mirandula interrogavi d. <persName ref="p714">Cęlium</persName>, qui dixit a <lb xml:id="p1z2"/>mercatoribus accepisse,</foreign> das die Barfuͤsser mönch haben ein capitel zuͦ <lb xml:id="p1z3"/>Mirandula instituiert; vil münch sindt kommen, haben harnasch, der merer <lb xml:id="p1z4"/>theil pantzerhembder und buchsen bracht uff den eslen; sindt iren vil <lb xml:id="p1z5"/>worden, die etlich Spanier kriegknecht, sind under inen gsin, haben <lb xml:id="p1z6"/>die stat wellen anderen öffnen by nacht und dem keyserischen kriegsvolck <lb xml:id="p1z7"/>uberantworten.</s>
					<s n="3" xml:lang="de">Dessen ist man innen worden, die münch by nacht <lb xml:id="p1z8"/>gfangen, die kriegsmünch gehenckt mit anderen münchen.</s>
					<s n="4" xml:lang="la">Sed <lb xml:id="p1z9"/><persName ref="p714">Celius</persName> expectat literas et fortassis a domino <persName ref="p3375">Vergerio</persName> brevi audies certiorem <lb xml:id="p1z10"/>historiam hac de re.</s>
					<s n="5" xml:lang="la">Sic omnia videmus agi proditionibus et do<lb xml:id="p1z11"/>lis.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Scripsi etiam in primis literis de episcopis<note type="misc">darüber v. <persName ref="p495">Bullingers</persName> Hand: "Mogunt[ino</note>, <placeName ref="l1028">Trevir[ensi]</placeName> et <placeName ref="l267">Colonien[si]</placeName>.] ad <placeName ref="l976">Confluentia<lb xml:id="p1z13"/>m</placeName> congregatis, <lb xml:id="p1z14"/>idque est verum; adiunxit se Palatinus Rheni, et alii episcopi<note type="misc">"Herbipolen[sis</note> etc."] miserunt <lb xml:id="p1z15"/>legatos ad illum <lb xml:id="p1z16"/>conventum.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/>Quibus de rebus putas illos consultaturos?<note type="misc">"De Magdeburgen[sibus</note> pacandis, de <persName>Ferd[inando]</persName> et <persName>Philippo</persName> pacandis."<lb xml:id="p1z18"/>]</s>
					<s n="8" xml:lang="la"><persName>Caesar</persName> plaga domini aggravatus est, ut nesciat, quo se vertat, etsi <lb xml:id="p1z19"/>dominum illum persequi non cessat nec illi gloriam propriam dare vult <lb xml:id="p1z20"/>in istis plagis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z21"/>Praeterea rogavit tabellarius, ut tibi significem se literas probe curasse, <lb xml:id="p1z22"/>etsi mihi non dederit; incidit enim forte fortuna in illum, cui inscriptę <lb xml:id="p1z23"/>erant.</s>
					<s n="10" xml:lang="la">Neque hoc te latere volo, etsi ridiculum sit, in nostro m<lb xml:id="p1z24"/>acello hodie nullus bos nec vacca mactata sunt; servabimus in <lb xml:id="p1z25"/>crastinum ieiunium quadragesimale ascensuri in cęlum, ubi hiis car<lb xml:id="p1z26"/>nalibus rebus opus non habemus.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale.</s>
					<s n="12" xml:lang="la"><placeName ref="l28">Basileę</placeName> 6. maii <lb xml:id="p1z27"/>1551.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Dominus <persName ref="p8124">Naogeorgos</persName> te salutat officiosissime.</s>
					<s n="14" xml:lang="la" ana="salute">Salutabis <lb xml:id="p1z28"/>nomine meo d. <persName ref="p8171">Theodorum</persName>, optimum virum, qui absque dubi<lb xml:id="p1z29"/>o <lb xml:id="p1z30"/>tristitia non dicenda afficitur ob <persName>Eleazari</persName><note type="misc">darüber von <persName ref="p495">Bullingers</persName> Hand: "<persName>Köllin</persName>"</note> mortem subitaneam.</s>
					<s n="15" xml:lang="la" ana="farewell"><lb xml:id="p1z31"/>Vale aeternum.</s>
					<s n="16" xml:lang="la">A domino <persName ref="p8418">Myconio</persName> literas accipies <lb xml:id="p1z32"/>absque dubio.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z33"/>T[uus] <persName ref="p1278">Gastius</persName> ex <lb xml:id="p1z34"/>animo.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem wolgelerten <lb xml:id="p2z2"/>herren meyster <persName ref="p495">Hein<lb xml:id="p2z3"/>rych Bullinger</persName>, lüt<lb xml:id="p2z4"/>priester zuͦ <placeName ref="l587">Zurich</placeName>, <lb xml:id="p2z5"/>mynem gunstigen, lie<lb xml:id="p2z6"/>ben herren, zuͦ <lb xml:id="p2z7"/>handen.</s>
					<s n="19" xml:lang="de"><lb xml:id="p2z8"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
