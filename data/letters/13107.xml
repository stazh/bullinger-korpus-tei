			<zone xml:id="p2z24-0" points="766,3690 816,3690 853,3658 953,3685 975,3669 1025,3690 1107,3677 1101,3455 1080,3463 1046,3444 980,3489 948,3489 924,3516 909,3502 761,3492">778,3604 803,3601 829,3598 854,3600 880,3601 905,3601 931,3600 956,3598 982,3600 1007,3601 1033,3603 1058,3605 1084,3606 1110,3607</zone>
		</surface>
