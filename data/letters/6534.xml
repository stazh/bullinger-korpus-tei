			<zone xml:id="p2z45-0" points="713,3305 893,3323 1013,3295 1068,3323 1171,3288 1406,3300 1459,3291 1461,3233 1164,3222 1015,3275 874,3240 713,3265">725,3297 761,3298 798,3299 835,3294 872,3296 909,3295 946,3294 983,3294 1020,3294 1057,3291 1094,3289 1130,3285 1167,3282 1204,3281 1241,3279 1278,3276 1315,3276 1352,3276 1389,3276 1426,3276 1463,3276</zone>
			<zone xml:id="p2z46-0" points="838,3374 1118,3351 1256,3387 1395,3344 1894,3385 2124,3339 2126,3291 1183,3286 920,3332 840,3302">851,3366 914,3356 978,3353 1042,3353 1106,3350 1170,3349 1234,3350 1298,3346 1362,3341 1426,3338 1490,3338 1553,3336 1617,3334 1681,3330 1745,3327 1809,3327 1873,3327 1937,3325 2001,3324 2065,3327 2129,3324</zone>
