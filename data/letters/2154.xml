	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Novum hunc annum, compater in domino charissime, <lb xml:id="p1z2"/>tibi ac tuis omnibus opto per omnia faustum <lb xml:id="p1z3"/>et omnis calamitatis expertem simulque pro <lb xml:id="p1z4"/>strena <persName ref="p2207">Ioanni Heinrychulo</persName>, meo filio, tuo in Christo, <lb xml:id="p1z5"/>missa gratias ago quam possum maximas.</s>
					<s n="3" xml:lang="la">Oro dominum, <lb xml:id="p1z6"/>ut, quod facis, in multos annos feliciter facias et <lb xml:id="p1z7"/>locum in te habeat illud Christi: Beatius est dare <lb xml:id="p1z8"/>quam accipere.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Caeterum septima huius literas ex <placeName ref="l18">Augusta</placeName> <lb xml:id="p1z10"/>mea accepi missas a d. <persName>Mekardo</persName>, in quibus <lb xml:id="p1z11"/>sunt quae tibi significanda esse existimavi.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z12"/>Nempe ista: Concordiam in causa eucharistiae <lb xml:id="p1z13"/>inter vos et d. <persName ref="p540">Calvinum</persName> institutam quidam ad<lb xml:id="p1z14"/>modum commendant, et iudicant esse medium quodd<lb xml:id="p1z15"/>am, quo partes contendentium conciliari queant.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z16"/>Et ad hanc doctus ille ac pius baro <persName ref="p8041">Iohannes a Lasco</persName>, <lb xml:id="p1z17"/>qui nunc misera <placeName ref="l830">Anglia</placeName> relicta in <placeName ref="l825">Dania</placeName> agit, <lb xml:id="p1z18"/>suo scripto illustrissimum <persName ref="p17927">electorem Palatinum</persName> <lb xml:id="p1z19"/>et caeteras quoque quas potest ecclesias hortatur, <lb xml:id="p1z20"/>ut in illa tandem evangelici omnes contra Anti<lb xml:id="p1z21"/>christum conveniant.</s>
					<s n="7" xml:lang="la">Haec ille.</s>
					<s n="8" xml:lang="la">Qua de re si <lb xml:id="p1z22"/>quid et ipse accepisti, obsecro communica.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z23"/>Adiecit de marchione ad hunc modum: "Interposuerunt <lb xml:id="p1z24"/>se dux <placeName ref="l572">Wirtemp[ergicus]</placeName> et <placeName ref="l619">Bavarus</placeName> una cum duobus <lb xml:id="p1z25"/>marchionibus electore et <persName>Ioanne</persName> pro ineunda concordia <lb xml:id="p1z26"/>inter marchionem et ligam <placeName>Noricam</placeName>.</s>
					<s n="10" xml:lang="la">Res serio <lb xml:id="p1z27"/>agitur; marchio petit ingentem summam auri; dux <lb xml:id="p1z28"/><placeName ref="l1041">Brunsvicensis</placeName> rediit in ducatum suum."</s>
					<s n="11" xml:lang="la">Haec ille.</s>
					<s n="12" xml:lang="la">Quomo<lb xml:id="p1z29"/>docunque habeat causa marchionis, certe scio secretarium <lb xml:id="p1z30"/>illius intimum mihi notissimum praeterita septi<lb xml:id="p1z31"/>mana transisse per nos in <placeName ref="l832">Galliam</placeName> ad regem.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z32"/>Denique in episcopatu <placeName ref="l61">Bremensi</placeName> colliguntur iam <lb xml:id="p1z33"/>6000 equitum.</s>
					<s n="14" xml:lang="la">Sunt, qui suspicantur conscribi illos <lb xml:id="p1z34"/>a Caesare, ut vi magna filium suum per <placeName ref="l822">Germaniam</placeName> <lb xml:id="p1z35"/>traducat in <placeName ref="l830">Angliam</placeName> illisque postea contra <lb xml:id="p1z36"/><placeName ref="l832">Gallum</placeName> utatur.</s>
					<s n="15" xml:lang="la"><placeName ref="l832">Gallus</placeName> non satis fuit vigilans, <lb xml:id="p1z37"/>quod <placeName ref="l830">Angliam</placeName> attinet.</s>
					<s n="16" xml:lang="la">Hae nuptiae magnum illi <lb xml:id="p1z38"/>malum, nisi occurrat in tempore, minari <lb xml:id="p1z39"/>videntur.</s>
					<s n="17" xml:lang="la">Interea spero dominum non deserturum <lb xml:id="p1z40"/>causam fidelium suorum, imo magis suam ipsius.</s>
					<s n="18" xml:lang="la" ana="farewell"><lb xml:id="p1z41"/>Optime vale, compater charissime.</s>
					<s n="19" xml:lang="de">Min <persName ref="p20374">Margret</persName> und <lb xml:id="p1z42"/>kinder wünschent euch allen vil guts und ein <lb xml:id="p1z43"/>gantz glückhaftigs jar.</s>
					<s n="20" xml:lang="la" ana="salute">Salutem quaeso omnibus isthic <lb xml:id="p1z44"/>fratribus et amicis, d. <persName ref="p8127">Pellicano</persName>, d. <persName ref="p8171">Bibliandro</persName>, d. <lb xml:id="p1z45"/><persName ref="p8011">Gvalthero</persName>, m. <persName ref="p7228">Zwinglio</persName> et reliquis omnibus.</s>
					<s n="21" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1554. <lb xml:id="p1z46"/>10. ianuarii.</s>
					<s n="22" xml:lang="la"><persName ref="p8417">W[<lb xml:id="p1z47"/>olfg<lb xml:id="p1z48"/>angus] Musc[ulus]</persName>, tuus compater in domino.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo m. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho Bul<lb xml:id="p2z4"/>lingero</persName>, compatri <lb xml:id="p2z5"/>suo in domino <lb xml:id="p2z6"/>charissimo.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
