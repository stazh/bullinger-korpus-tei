	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Der Zusammenhang mit den Briefen <ref target="file10786">Nr. 748</ref>, 753 und 762 (vgl. unten Anm. 2 und 6) erlaubt eine zweifelsfreie Datierung.</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia et pax, observande et charissime <persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Dici non potest, ut exhilararint nos literae tuae<note xml:id="fn2" type="footnote" n="2">Oben <ref target="file10786">Nr. 748</ref> (und 753?).</note>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Pergite hac via; domini est, ne dubitetis.</s>
					<s n="4" xml:lang="la">Nos <persName ref="p1974">Luthero</persName> <lb xml:id="p1z4"/>omnia<note xml:id="fn3" type="footnote" n="3"><persName ref="p467">Bucer</persName> und <persName ref="p5565">Capito</persName> sandten unmittelbar nach ihrer Rückkehr vom <placeName ref="l28">Basler</placeName> Konvent einen Bericht über die erzielte Einigung an <persName ref="p1974">Luther</persName>; s. <bibl source="b671">WA</bibl> Briefwechsel VII 357-359, <ref target="file12340">Nr. 2293</ref>; vgl. <hi>Köhler,</hi> ZL II 416f.</note>, sed propter itineris longitudinem nondum <lb xml:id="p1z5"/>potuimus recipere responsum<note xml:id="fn4" type="footnote" n="4"><persName ref="p1974">Luther</persName> antwortete wegen Krankheit erst am 25. März. <persName ref="p467">Bucer</persName> erhielt den Brief (<bibl source="b671">WA</bibl> Briefwechsel VII 378f, <ref target="file13050">Nr. 3001</ref>) am 11. April in <placeName ref="l18">Augsburg</placeName>.</note>.</s>
					<s n="5" xml:lang="la">Vulgus utrinque non <lb xml:id="p1z6"/>semper sapit.</s>
					<s n="6" xml:lang="la">Sed verum est illos plus insanire, <lb xml:id="p1z7"/>nec enim dum cum vulgo actum, quia cum ducibus <lb xml:id="p1z8"/>nondum transactum est.</s>
					<s n="7" xml:lang="la">Sustineamus opus domini.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z9"/>Spero, quod tantopere expetis, te brevi habiturum<note xml:id="fn5" type="footnote" n="5"><persName ref="p495">Bullinger</persName> hoffte auf ein freundliches Schreiben aus <placeName ref="l558">Wittenberg</placeName>; vgl. oben <ref target="file10786">Nr. 748</ref>, 12f. 16f; 753, 19f.</note>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><persName ref="p5565">Capito</persName>, <lb xml:id="p1z10"/>puto, pridem de filio d. doctoris medici scripsit<note xml:id="fn6" type="footnote" n="6">Siehe oben <ref target="file10800">Nr. 762</ref>, 1-11.</note>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z11"/>Habet quendam pharmacopolam<note xml:id="fn7" type="footnote" n="7">Unbekannt.</note>, qui illum recipere <lb xml:id="p1z12"/>velit, sed pacisci, cum vident.</s>
					<s n="11" xml:lang="la">Alius quidam<pb type="edition" next="166"/><note xml:id="fn8" type="footnote" n="8">Unbekannt.</note> hac arte <lb xml:id="p1z13"/>potentior recipiet eum, sed ad septembrem, et hic <lb xml:id="p1z14"/>plus a pietate est; alter, ni fallor, vita nondum <lb xml:id="p1z15"/>probavit se valde intelligere Christum.</s>
					<s n="12" xml:lang="la">At religio primum <lb xml:id="p1z16"/>in omni vita.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Saluta plurimum totum illic sanctorum <lb xml:id="p1z17"/>chorum, <persName ref="p1753">Leonem</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p1753">Leo Jud</persName>.</note>, <persName ref="p8127">Pellicanum</persName>, <persName ref="p8171">Bibliandrum</persName> et reliquos.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z18"/>Arg[entorati], <lb xml:id="p1z19"/>11. marcii.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p467">M. Bucerus</persName>.</s>
				</p>
