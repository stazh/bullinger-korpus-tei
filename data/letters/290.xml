	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z3"/>Quem hic coram cernis (doctissime <persName ref="p495">Bullingere</persName>) vir est <lb xml:id="p1z4"/>nostras ex <placeName ref="l2592">Foedere</placeName>, quod vulgo dicitur <placeName ref="l3104">Foedus Decem Iudiciorum</placeName>; <lb xml:id="p1z5"/>is ad vos venit in re sua (quam ipse narrabit coram) auxilium, <lb xml:id="p1z6"/>consilium expetens.</s>
					<s n="2" xml:lang="la">Cum vero causam, propter quam huc <lb xml:id="p1z7"/>venisset, exigissemus, incipit se habere filium, quem dedicasset <lb xml:id="p1z8"/>studio bonarum literarum; illum ut suis aleret, non habere, <lb xml:id="p1z9"/>ad haec significans nobis Foedus ipsum ad magistratum <placeName ref="l587">Tig<lb xml:id="p1z10"/>urinensem</placeName> daturum literass commendatitias, si fieri posset, <lb xml:id="p1z11"/>ut reciperetur <placeName ref="l587">Tiguri</placeName> in eum numerum, quem alunt <lb xml:id="p1z12"/>alimonia.</s>
					<s n="3" xml:lang="la">Is, inquam, bonus vir me obsecravit, ut meum <lb xml:id="p1z13"/>auxilium non denegarem.</s>
					<s n="4" xml:lang="la">Quod cum iure facerem, volui <lb xml:id="p1z14"/>ad te meas dare literas orans, ut et tu, qui <lb xml:id="p1z15"/>multum in ea re potes iuvare, manum tuam non abstra<lb xml:id="p1z16"/>has ab illo.</s>
					<s n="5" xml:lang="la">Caeterum fuit administrator rerum ca<lb xml:id="p1z17"/>nonicarum; quem cum senserunt factum Christianum, <lb xml:id="p1z18"/>omnibus praediis eum privarunt; inde redactus ad <lb xml:id="p1z19"/>summam inopiam.</s>
					<s n="6" xml:lang="la">Quare quicquid beneficentiae in eum conferas, <lb xml:id="p1z20"/>minime in ingratum locatum erit.</s>
					<s n="7" xml:lang="la">Rerum novarum <lb xml:id="p1z21"/>neque hic neque ex <placeName ref="l834">Italia</placeName> habemus nos; tu si quid <lb xml:id="p1z22"/>habes, fac, more tuo nobis significes.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale.</s>
					<s n="9" xml:lang="la" ana="salute">Salutem <lb xml:id="p1z23"/>plurimam dicito meo nomine uxori tuae honestissimae <lb xml:id="p1z24"/>totaeque familiae tuae.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Data 2. Octobris, anno 1548. <note>ohne Name</note></s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Prestantissimo viro D. <persName ref="p495">H[ain<lb xml:id="p2z2"/>rico] Bullingero</persName>, ecclesie <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> antistiti cum fidelissimo, <lb xml:id="p2z4"/>tum et constantissimo, <lb xml:id="p2z5"/>domino ac fratri suo longe obser<lb xml:id="p2z6"/>vandissimo.</s>
				</p>
			</div>
		</body>
	</text>
