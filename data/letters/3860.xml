	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Festinat tabellio; festino et ego vocatus <lb xml:id="p1z2"/>ad unum et alterum senem aegrum.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Paucis ergo haec <lb xml:id="p1z3"/>habeas: proposuit <persName>Kolmarus</persName> hodie suum negotium <lb xml:id="p1z4"/>senatui, scriptum simul publicum obtulit.</s>
					<s n="4" xml:lang="la">Displic<lb xml:id="p1z5"/>uit vehementer ea res optimis quibusque.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Receptus <lb xml:id="p1z6"/>est interim in locum suum, quo fuit, cum hinc <lb xml:id="p1z7"/>avocaretur.</s>
					<s n="6" xml:lang="la">Non vult illum mittere nunc magistratus <lb xml:id="p1z8"/>amplissimus, concedit tamen spacium mensis; <lb xml:id="p1z9"/>si in hoc tempore revocent ipsum <placeName ref="l108">Davosiani</placeName> <lb xml:id="p1z10"/>scriptis ad magistratum literis, concedetur illis <lb xml:id="p1z11"/>forte; sin secus, retinebitur apud nos; <foreign xml:lang="de">dann wir <lb xml:id="p1z12"/>jetzund ußkummen sind, das wir nitt über 3 <lb xml:id="p1z13"/>lediger habend,</foreign> neque ullus ex his ad istos mitteretur.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Nisi ergo serio ipsum postulaverint et defensionem <lb xml:id="p1z15"/>tutam promiserint, aliquo item modo damnum resars<lb xml:id="p1z16"/>ierint, ex nostris non puto quemquam mittendum.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Si autem ita se gesserint, tu decet probos <lb xml:id="p1z18"/>et fideles, forte hic <persName>Colmarus</persName> ipsis reddetur.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/>Tuas literas accepi et legi.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Gratias ago; domino d. <lb xml:id="p1z20"/>legato dices me etiam suas accepisse et in <lb xml:id="p1z21"/>praesenti catalogum remittere ac gratias agere; scribam <lb xml:id="p1z22"/>alias, cum plus erit ocii; salutabis ipsum.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z23"/><persName ref="p1825">Rex Poloniae</persName> febricitabat dumtaxat; nullum <lb xml:id="p1z24"/>est vitae periculum.</s>
					<s n="12" xml:lang="la">Heri habui nuncium <lb xml:id="p1z25"/>ex <placeName ref="l2472">Polonia</placeName>, qui 10. ianuarii <placeName ref="l260">Cracovia</placeName> dis<lb xml:id="p1z26"/>cessit: omnia bene habent; progreditur verbum <lb xml:id="p1z27"/>dei.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Fortiter renituntur episcopi, sed nihil possunt.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z28"/><persName ref="p20809">Regina Hungariae</persName> salva et incolumis est; filius quoque <lb xml:id="p1z29"/>incolumis est; sed Babek, qui ipsam <persName ref="p18477">Fer<lb xml:id="p1z30"/>dinando</persName> voluit prodere, concisus est cum suis.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z31"/><placeName ref="l2510">Turca</placeName> est in maxima expeditione.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l491">Argentina</placeName> 8. <lb xml:id="p1z32"/>ianuarii terremotu est concussa.</s>
					<s n="17" xml:lang="la">Co<lb xml:id="p1z34"/>gor abrumpere haec.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="farewell">Vale cum tuis omnibus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z35"/>Liber d. <persName>Philippi</persName> paratus est; habeo ipsum; expecto, <lb xml:id="p1z36"/>cui committat, ut a me accipiat.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z38"/>Valeat <persName>Philippus</persName>, <persName ref="p6130">Pontasella</persName>, uterque consul[um], opt<lb xml:id="p1z39"/>imi quique.</s>
					<s n="21" xml:lang="la">11. februarii 1559.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z41"/><persName ref="p495">Bullingerus</persName> tuus <pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p8009">Ioanni Fabritio</persName>, <lb xml:id="p2z3"/><placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z4"/>ministro, compatri <lb xml:id="p2z5"/>et fratri colendissimo <lb xml:id="p2z6"/>et charissimo suo<note type="misc">meo?</note>.</s>
					<s n="23" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
