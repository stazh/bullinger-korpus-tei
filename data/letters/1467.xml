	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime vir, tandem aliquid mitto, quod ex <lb xml:id="p1z3"/><placeName ref="l1107">Tridentina</placeName> synagoga potui expiscari, <lb xml:id="p1z4"/>certe non sine magnis laboribus, sumptibus <lb xml:id="p1z5"/>et periculis.</s>
					<s n="2" xml:lang="la">Qui haec mittit, ita <lb xml:id="p1z6"/>ad me scribit:</s>
					<s n="3" xml:lang="la">"Eucharistiam nedum tracta<lb xml:id="p1z7"/>visse, verum etiam absolvisse audio; decretum <lb xml:id="p1z8"/>propediem mittam."</s>
					<s n="4" xml:lang="la">Et ego ad te omnia <lb xml:id="p1z9"/>mittam ilico.</s>
					<s n="5" xml:lang="la">Dabis haec meis nepotibus, <lb xml:id="p1z10"/>imo iuva illos, ut habeant, qui describant; <lb xml:id="p1z11"/>nam iussi, ut duo exempla ad alios <lb xml:id="p1z12"/>fratres mittantur.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale et salve <lb xml:id="p1z13"/>cum tota familia, scola atque ecclesia.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/><placeName ref="l525">Vicosoprani</placeName>, 10. novembris<note type="margin">a.R.: E..!</note> 1551.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Cla<pb/><lb xml:id="p2z1"/>rissimo d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori.</s>
					<s n="10" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
