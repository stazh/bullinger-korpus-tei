	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et vitae innocentiam a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Maximas ego tibi, <lb xml:id="p1z2"/>doctissime <persName ref="p8418">Myconi</persName>, ago gratias pro libro epistolarum <persName ref="p18722">Erasmi</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p18722">Erasmus</persName>' "Epistolarum floridarum liber unus", vgl. oben <ref target="file10645">Nr. 607</ref>, 16-21.</note>.</s>
					<s n="3" xml:lang="la">Quem <lb xml:id="p1z3"/>ego nondum legi integrum; nam <persName ref="p8049">Vadianus</persName> hunc mihi <lb xml:id="p1z4"/>e manibus abripuit, sponte tamen offerenti<note xml:id="fna" type="footnote" n="a">tamen offerenti <hi>am Rande nachgetragen für gestrichenes</hi> volenti.</note>, et <placeName ref="l473">Sangallum</placeName> avexit<note xml:id="fn2" type="footnote" n="2">Vgl. Verena Schenker-Frei, Bibliotheca Vadiani, St. Gallen 1973. - Vadian-Studien 9, S. 76, <ref target="file10260">Nr. 229</ref>.</note>.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Legi tamen epistolas aliquot, quibus nil stultius vidi<note xml:id="fnb" type="footnote" n="b">vidi <hi>am Rande nachgetragen</hi> für <hi>gestrichenes</hi> legi.</note> unquam.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Aut enim in his bonorum virorum famam arrodit <lb xml:id="p1z7"/>aut dogmata quaedam christiana in utranque partem dis<lb xml:id="p1z8"/>putans obscurat<note xml:id="fnc" type="footnote" n="c"><hi>vor und nach</hi> obscurat <hi>gestrichenes</hi> aut.</note> inque dubium vertit aut turpiter <lb xml:id="p1z9"/>quibusdam hominibus nihili adulatur.</s>
					<s n="6" xml:lang="la">An vero non <lb xml:id="p1z10"/>insignis est impudentia, quod tantopere munera, opes <lb xml:id="p1z11"/>et principum, abbatum et episcoporum iactitat amicicias?</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Miseret me profecto miserandi senis, et illas <lb xml:id="p1z13"/>quidem nenias tribuo senio repuerascenti.</s>
					<s n="8" xml:lang="la">Conciona<lb xml:id="p1z14"/>tor ille<note xml:id="fn3" type="footnote" n="3"><persName ref="p18722">Erasmus</persName>' "Ecclesiastes", vgl. oben <ref target="file10662">Nr. 624</ref>, 8-11.</note> plus mihi placuit, quamvis ne hunc quidem <lb xml:id="p1z15"/>totum legerim.</s>
					<s n="9" xml:lang="la">Quod ad vos <placeName ref="l28">Basileam</placeName> confugit, fato <lb xml:id="p1z16"/><persName ref="p5869">Mori</persName> ac <persName ref="p7469">Roffensis</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p7469">John Fisher</persName>, 1469-1535, von <placeName ref="l1480">Beverly</placeName> (<placeName ref="l3769">Yorkshire</placeName>), Bischof von <placeName ref="l1653">Rochester</placeName>, Freund von <persName ref="p18722">Erasmus</persName>, wurde am 22. Juni 1535 - wie kurz darauf auch <persName ref="p5869">Thomas Morus</persName> - wegen seiner Verweigerung des Suprematseides enthauptet. - Lit.: James K. <hi>McConica,</hi> in: <bibl source="b163">Contemporaries</bibl> II 36-39 (mit weiterer Lit.).</note> tribuo.</s>
					<s n="10" xml:lang="la">Putat fortassis tutius esse <lb xml:id="p1z17"/>in libera gente agere quam sub principum tutela.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z18"/>Quid, si <persName ref="p18477">Ferdinandus</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p18477">Ferdinand I.</persName>, <placeName ref="l425">römischer</placeName> König.</note> aliquando a monachis et scurris <lb xml:id="p1z19"/>quibusdam subornatus <persName ref="p18722">Erasmum</persName> ut turbarum et heresum<pb type="edition" next="380"/> <lb xml:id="p1z20"/>in <placeName ref="l822">Germania</placeName> authorem primarium duci iuberet vel <lb xml:id="p1z21"/>morte clancularia auferret?</s>
					<s n="12" xml:lang="la">Id metuit fortassis senex <lb xml:id="p1z22"/>miser, et scriptae forsan ultro citroque epistolae metum <lb xml:id="p1z23"/>iniiciunt attonito ad tantam principum quorundam <lb xml:id="p1z24"/>libidinem et momentaneam mutationem.</s>
					<s n="13" xml:lang="la">Me certe <persName ref="p5869">Mori</persName> <lb xml:id="p1z25"/>fatum monuit miseriae humanae, et ut principum <lb xml:id="p1z26"/>favore nihil lubricum magis, ita fortuna nihil in<lb xml:id="p1z27"/>constantius adde et periculosius esse.</s>
					<s n="14" xml:lang="la">Christo domino et veritati <lb xml:id="p1z28"/>eius ex animo servire, huic immori sacrosanctum <lb xml:id="p1z29"/>et longe in hisce terris foelicissimum est.</s>
					<s n="15" xml:lang="la">Ego virum con<lb xml:id="p1z30"/>venirem amice ac honorifice alloquerer.</s>
					<s n="16" xml:lang="la">Quid, si in <lb xml:id="p1z31"/>senio vir tantus totus ad nos concederet?</s>
					<s n="17" xml:lang="la">Obsecro, quod <lb xml:id="p1z32"/>dixi, prudenter expende et cogita occasionem valere plurimum.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z33"/>De concordia hoc ipsum sentio quod <lb xml:id="p1z34"/>tu<note xml:id="fn6" type="footnote" n="6">Vgl. oben <ref target="file10690">Nr. 652</ref>, 9-33.</note>.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z35"/>Scripsi <persName ref="p2095">Philippo</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p495">Bullinger</persName> an <persName ref="p2095">Philipp Melanchthon</persName>, oben <ref target="file10674">Nr. 636</ref>.</note>, <persName ref="p1974">Luthero</persName> certas ob causas scribere nolui.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z36"/>Apographum proximo nuncio remitte<note xml:id="fn8" type="footnote" n="8">Die für <persName ref="p8418">Myconius</persName> bestimmte Abschrift ist erhalten, s. ebd., Anm. a.</note>, et quid <lb xml:id="p1z37"/>de concordia, de qua tantum illi<note xml:id="fn9" type="footnote" n="9">Gemeint sind wohl <persName ref="p467">Bucer</persName> und <persName ref="p5565">Capito</persName>.</note> praedicant, audias, in<lb xml:id="p1z38"/>dica.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Quid nostri agant, quod bonis illis adeo displicere <lb xml:id="p1z39"/>possit<note xml:id="fn10" type="footnote" n="10">Vgl. oben <ref target="file10690">Nr. 652</ref>, 34-40.</note>, profecto nescio, nisi illud putes, quod nimis <lb xml:id="p1z40"/>anxie in <placeName ref="l760">Solodorensium</placeName> negotio agunt<note xml:id="fn11" type="footnote" n="11">Vgl. ebd., Anm. 9.</note> aut quod cum <placeName ref="l41">Bernatibus</placeName>, <lb xml:id="p1z41"/>sine vobis et aliis <persName ref="p18536">Allobrogum duci</persName><note xml:id="fn12" type="footnote" n="12"><persName ref="p18536">Karl III.</persName>, Herzog von <placeName ref="l2478">Savoyen</placeName>.</note> tam praefracte, <lb xml:id="p1z42"/>quam illi petebant, scribere noluerunt<note xml:id="fn13" type="footnote" n="13">Vgl. unten <ref target="file10695">Nr. 657</ref>, Anm. 7.</note>.</s>
					<s n="22" xml:lang="la">Interim, quae <lb xml:id="p1z43"/>custodienda mandasti, diligenter observabimus.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Ipse <lb xml:id="p1z44"/>nunc exemplar mitto, de quo frustra ais <persName ref="p344">Bindero</persName> mandass<lb xml:id="p1z45"/>e quaedam<note xml:id="fn14" type="footnote" n="14"><persName ref="p8418">Myconius</persName> hatte <persName ref="p344">Georg Binder</persName> gebeten, ihm ein Exemplar von <persName ref="p495">Bullingers</persName> Kommentar zu vier Paulusbriefen zu beschaffen; vgl. oben <ref target="file10690">Nr. 652</ref>, 44-46.</note>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Quid vero de caesare<note xml:id="fn15" type="footnote" n="15"><persName ref="p18538">Karl V.</persName></note> <lb xml:id="p1z46"/>audis?</s>
					<s n="25" xml:lang="la"><lb xml:id="p1z47"/>Quid de futuro consilio<note xml:id="fn16" type="footnote" n="16">Papst <persName ref="p19981">Paul III.</persName> hatte am 15. Januar 1535 ein Konzil angekündigt, vgl. <bibl source="b477">Pastor</bibl> V 33.</note>?</s>
					<s n="26" xml:lang="la">Quid de technis <lb xml:id="p1z48"/><persName ref="p20225">Galli</persName><note xml:id="fn17" type="footnote" n="17"><persName ref="p20225">Franz I.</persName></note>?</s>
				</p>
				<p>
					<s n="27" xml:lang="la" ana="salute">Salvum te vult <persName ref="p3242">Utingerus</persName>.</s>
					<s n="28" xml:lang="la">Salvam vult <lb xml:id="p1z49"/>uxorem<note xml:id="fn18" type="footnote" ana="bio" n="18">Der Name der Frau von <persName ref="p8418">Myconius</persName> ist nicht bekannt. In den <placeName ref="l28">Basler</placeName> Kirchenbüchern erscheint sie als <persName ref="p5896">Margret</persName>, <persName ref="p8418">Myconii</persName> uxor, bzw. <persName ref="p5896">Margret Myconia</persName> (z. B. Basel StA, Kirchenarchiv W 12, 1, f. 10r. [1536] und 73v. [1549]). Fest steht, daß sie eine Blutsverwandte der Witwe des <placeName ref="l441">Schaffhauser</placeName> Ratsherrn <persName ref="p6521">Heinrich Schwarz</persName> war (s. Zürich StA, E II 358, 115). Bei letzterer handelt es sich nach Auskunft von Herrn Dr. Lieb (Staatsarchiv <placeName ref="l441">Schaffhausen</placeName>) um <persName ref="p6398">Elisabeth Schellenberg</persName> von <placeName ref="l2445">Pfäffikon</placeName> (<placeName ref="l803">Kt. Zürich</placeName>).</note> mater mea<note xml:id="fn19" type="footnote" ana="bio" n="19"><persName ref="p495">Bullingers</persName> Mutter <persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note> et uxor<note xml:id="fn20" type="footnote" ana="bio" n="20"><persName ref="p495">Bullingers</persName> Frau <persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note>.</s>
					<s n="29" xml:lang="la">De peste nolim te sollicitum <lb xml:id="p1z50"/>esse<note xml:id="fn21" type="footnote" n="21">Vgl. oben <ref target="file10690">Nr. 652</ref>, 1-7.</note>.</s>
					<s n="30" xml:lang="la">Si me abripuerit, dominus commodiorem ecclesiae dabit.</s>
				</p>
				<p>
					<s n="31" xml:lang="la"><lb xml:id="p1z51"/><placeName ref="l587">Tiguri</placeName>, 2. octobris 1535.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><persName ref="p495">H. Bull.</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Ohne Adresse.]</note>
				</p>
