	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Hoc certius statuo non omittendum, quin adfueris<note xml:id="fn1" type="footnote" n="1">Nämlich am Theologenkonvent, der am 14. Mai in <placeName ref="l1564">Eisenach</placeName> beginnen sollte; vgl. oben <ref target="file10835">Nr. 796</ref>, 1-7 mit Anm. 1.</note>, <lb xml:id="p1z2"/>quo cogito expendoque diutius.</s>
					<s n="3" xml:lang="la">Nam es, quo utetur <lb xml:id="p1z3"/>deus ad maxima adeoque iam utitur.</s>
					<s n="4" xml:lang="la">Iuvenis es <lb xml:id="p1z4"/>et autoritate canus<note xml:id="fna" type="footnote" n="a"><hi>in der Vorlage irrtümlich</hi> cano.</note> non unis <placeName ref="l587">Tigurinis</placeName>.</s>
					<s n="5" xml:lang="la">Illic autem esses <lb xml:id="p1z5"/>auditurus et reliquos, quorum existimatio vigebit <lb xml:id="p1z6"/>apud posteros, nec sine fructu auditurus; nam parvi <lb xml:id="p1z7"/>temporis colloquium plus intelligentię utrinque prodit, <lb xml:id="p1z8"/>quam multorum mensium lectio aperuerit.</s>
					<s n="6" xml:lang="la">Adeo vivit <lb xml:id="p1z9"/>indoles animi in sermone, quę stilo nescio quid ascititii<note xml:id="fn2" type="footnote" n="2">hier wohl im Sinne von: etwas Fremdes, Neues, Aufgeschnapptes.</note> <lb xml:id="p1z10"/>contrahit.</s>
					<s n="7" xml:lang="la">Quare obsecro te, da operam, ut adfueris <lb xml:id="p1z11"/>nobiscum.</s>
					<s n="8" xml:lang="la">Lassescit corpus seni morbis et curis <lb xml:id="p1z12"/>fracto, et tamen volens adero.</s>
					<s n="9" xml:lang="la">Sine magistratu <lb xml:id="p1z13"/>res agetur, quo syncerius ac liberius.</s>
					<s n="10" xml:lang="la">Spiritus Christi erit <lb xml:id="p1z14"/>nobiscum.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale.</s>
					<s n="12" xml:lang="la" ana="salute"><persName ref="p8171">Bibliandro</persName> et <persName ref="p8127">Pellicano</persName> ex nobis <lb xml:id="p1z15"/>salutem dicas.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">19.<note xml:id="fnb" type="footnote" n="b"><hi>Die zweite Ziffer undeutlich (aus a?) korrigiert.</hi></note> aprilis anno 1536.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Preclaro viro M. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, pastori <lb xml:id="p2z3"/>urbano <placeName ref="l587">Tiguri</placeName>, sibi in <lb xml:id="p2z4"/>domino observando.</s>
				</p>
			</div>
		</body>
