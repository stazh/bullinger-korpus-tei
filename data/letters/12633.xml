	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1">Siehe dazu unten Anm. 10.</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Scias, <persName ref="p495">Bullingere</persName>, quod turbatores<note xml:id="fn2" type="footnote" n="2"><persName ref="p8364">Beat Gering</persName> und <persName ref="p3099">Simon Sulzer</persName>.</note> <lb xml:id="p1z2"/>nostri egerrime ferant, quod m<lb xml:id="p1z3"/>agistratus <placeName ref="l587">Tigurin<lb xml:id="p1z4"/>um</placeName><note xml:id="fn3" type="footnote" n="3">Zur Wahl des <persName ref="p1804">Jodocus Kilchmeyer</persName> s. <ref target="file12630">Nr. 2583</ref>, Anm. 5.</note> elegerit, <lb xml:id="p1z5"/>quem ipsi non nominarunt<note xml:id="fn4" type="footnote" n="4">Zu den von <persName ref="p8364">Gering</persName> und <persName ref="p3099">Sulzer</persName> vorgeschlagenen Kandidaten s. <ref target="file12630">Nr. 2583</ref>, Anm. 2.</note>.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z6"/>Voluerunt itaque impedire <lb xml:id="p1z7"/>eius vocationem quasi non <lb xml:id="p1z8"/>legitimam, et quod violarant<note xml:id="fn5" type="footnote" n="5">Subjekt sind die Ratsherren.</note> <lb xml:id="p1z9"/>ecclesiasticam autoritatem<note xml:id="fn6" type="footnote" n="6">Vgl. <ref target="file12634">Nr. 2587</ref>,1-5. - Zur Autoritätsfrage der Geistlichen s. <ref target="file12631">Nr. 2584</ref>,50-52. 68f.</note>.</s>
					<s n="3" xml:lang="la">Sed <lb xml:id="p1z10"/>novimus de Josaphat, Josia, <lb xml:id="p1z11"/>Ezechia, Iudeo Machabeo et <lb xml:id="p1z12"/>Cyro rege,<note xml:id="fn7" type="footnote" n="7">Gemeint sind die jüdischen Reformkönige Josaphat (<cit type="bible"><ref>1 Kön 22, 41-44</ref></cit>; <cit type="bible"><ref>2Chr. 17, 3-9</ref></cit>); Hiskija bzw. Ezechia (<cit type="bible"><ref>2Kön 18, 1-6</ref></cit>), Josia (<cit type="bible"><ref>2Kön 22, 1-23, 28</ref></cit>), der jüdische Widerstandskämpfer Judas Makkabäus <cit type="bible"><ref>(1Makk 3ff)</ref></cit>, und der persische judenfreundlich gesinnte König Kyros II. (<cit type="bible"><ref>2Chr 36, 221</ref></cit>: <cit type="bible"><ref>Jes 44, 28-45, 4</ref></cit>).</note> quid <lb xml:id="p1z14"/>magistratus possit in ecclesiasticis <lb xml:id="p1z15"/>rebus ministrisque ordinandis.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z16"/>Proinde effice omni modo, <lb xml:id="p1z17"/>ne recuset<note xml:id="fn8" type="footnote" n="8">Subjekt ist <persName ref="p1804">Kilchmeyer</persName>.</note> vocationem a <lb xml:id="p1z18"/>spiritu sancto pręstitam.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z19"/>Habebit constantes adsti<lb xml:id="p1z20"/>pulatores<note xml:id="fn9" type="footnote" n="9">Nämlich die zwinglisch Orientierten in <placeName ref="l41">Bern</placeName>.</note>.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale.</s>
					<s n="7" xml:lang="la">Datum <lb xml:id="p1z21"/>15. septembris anno, etc.<lb xml:id="p1z22"/>, 46.<lb xml:id="p1z23"/>, et<lb xml:id="p1z24"/>c.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z25"/>Tuus <lb xml:id="p1z26"/><persName ref="p3700">Eb</persName><lb xml:id="p1z27"/>.</s>
				</p>
				<p>
					<note type="address">[Ohne Adresse.<note xml:id="fn10" type="footnote" n="10">Dieses auf einem kleinen Zettelchen verfasste Schreiben wurde höchstwahrscheinlich den Briefen <ref target="file12631">Nr. 2584</ref> und <ref target="file12634">Nr. 2587</ref> beigelegt.</note>]</note>
				</p>
			</div>
