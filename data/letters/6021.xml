	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Utinam recte valeas; valde mihi est <lb xml:id="p1z2"/>suspectum, quod nullas a te accipio literas, nec <lb xml:id="p1z3"/>enim ita asuevi.</s>
					<s n="3" xml:lang="la">Sed forte destitueris argumen<lb xml:id="p1z4"/>to; verum concilium et <placeName ref="l834">Italia</placeName> abundans tibi <lb xml:id="p1z5"/>suppeditaret.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Occasionem aliam itaque expecto.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>In comitiis <placeName ref="l21">Badenis</placeName> fuerunt iam dies multos legati; quid <lb xml:id="p1z8"/>egerint, facile non dixero; scio <placeName ref="l781">Urianos</placeName>, <placeName ref="l2450">Suitenses</placeName> <lb xml:id="p1z9"/>et <placeName ref="l2469">Subsylvanos</placeName> reiecisse capita pacificationis <lb xml:id="p1z10"/>et nova obtrudere, quae <placeName ref="l646">Claronenses</placeName> repudiant.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Varius est rumor; sunt, qui affirment <lb xml:id="p1z12"/>parare nescio quos quas turbas contra <placeName ref="l646">Claronenses</placeName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="de"><lb xml:id="p1z13"/>Hilfft dann wäder rächt noch guͤtikeit, so erbarms <lb xml:id="p1z14"/>gott; der wölle allen geträngten zuͦ hilff kummen <lb xml:id="p1z15"/>und den unlidigen übermuͦt demuͤtigen.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Ex <placeName ref="l832">Gallia</placeName> nihil habemus, nisi quod confirmatur evangelii <lb xml:id="p1z17"/>praedicationem perrumpere.</s>
					<s n="9" xml:lang="la">Deus det gratiam.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><lb xml:id="p1z18"/>Ich hab hütt brieff von <placeName ref="l18">Augspurg</placeName>, das <persName ref="p20597">Wilhelm <lb xml:id="p1z19"/>von Gruntpach</persName> inn die acht gethan sampt sinem <lb xml:id="p1z20"/>bystand, das er sich anhept stercken, die widerparth <lb xml:id="p1z21"/>ouch.</s>
					<s n="11" xml:lang="la">O miseram <placeName ref="l822">Germaniam</placeName> et multo miseriorem <lb xml:id="p1z22"/><placeName ref="l862">Helvetiam</placeName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Miserere nostri domine et serva <lb xml:id="p1z23"/>nos et ne tradideris confitentes nomen tuum in <lb xml:id="p1z24"/>manus hostium verbi dei, ne tradideris nos alienis; <lb xml:id="p1z25"/>tu nos castigato.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><persName ref="p4521">Castellio</persName> <placeName ref="l28">Basileae</placeName> <lb xml:id="p1z26"/>mortuus est 29. decembris anni praeteriti.</s>
					<s n="14" xml:lang="la" ana="farewell">Vive et vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z27"/>Oremus dominum, ut nos servet a malo.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z28"/>21. ianuarii 1564.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Saluta amicos e<lb xml:id="p1z29"/>tc.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Io<lb xml:id="p2z2"/>anni Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae fideli <lb xml:id="p2z4"/>ministro, domino et fratri <lb xml:id="p2z5"/>meo colendissimo et charissimo.</s>
					<s n="20" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>