	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a deo patre <lb xml:id="p1z2"/>ex domino nostro Iesu Christo.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Quamvis maximis assiduisque pene ad molestiam <lb xml:id="p1z4"/>occupatus essem negotiis, vir clarissime, non nihil <lb xml:id="p1z5"/>tamen vinculo necessitudinis benevolentiaeque mu<lb xml:id="p1z6"/>tuae concedendum esse temporis duxi, quo aliqua <lb xml:id="p1z7"/>ex parte offitio debito per me satisfieri possit, <lb xml:id="p1z8"/>maxime vero occasione commodiori conatum meum <lb xml:id="p1z9"/>adiuvante.</s>
					<s n="3" xml:lang="la" ana="salute">Nam quum istuc ad te optimus <lb xml:id="p1z10"/>et eruditus vir d. <persName ref="p8511">Christophorus Threcius</persName>, <lb xml:id="p1z11"/>quo uno omnium ego familiarissime utor, iter <lb xml:id="p1z12"/>pararet multaque de tuo erga me animi candor<lb xml:id="p1z13"/>e, quem etiam ex literis tuis humanissime scriptis <lb xml:id="p1z14"/>antea cognoveram, narras[s]et, operam dedi <lb xml:id="p1z15"/>measque statim partes duxi, ut per eum meas <lb xml:id="p1z16"/>mitterem literas, quibus et salutem tuam inviserem <lb xml:id="p1z17"/>offitiaque mea promptissima offerrem.</s>
					<s n="4" xml:lang="la">Hoc <lb xml:id="p1z18"/>enim meum unicum studium fuit semper et est, <lb xml:id="p1z19"/>ut eorum mihi favorem demerear, qui et ingeni<lb xml:id="p1z20"/>i praestantia, pietatis ardore vitaeque sanctitate <lb xml:id="p1z21"/>eminent.</s>
					<s n="5" xml:lang="la">Quod quoniam de te et id qui<lb xml:id="p1z22"/>dem merito fama praedicat, clarius vero egre<lb xml:id="p1z23"/>gia tua scripta declarant, postremo vero et <lb xml:id="p1z24"/>literę ad me humaniter exarratę id ipsum redol<lb xml:id="p1z25"/>ent, magnam foelicitatis partem esse putavi, <lb xml:id="p1z26"/>quod tuo suavissimo colloquio, si non coram pręs<lb xml:id="p1z27"/>enti, saltem per literas absenti frui liceat.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z28"/>Quod itaque te prospera valetudine hucusque usum <lb xml:id="p1z29"/>fuisse ex certis quibusdam nuntiis cognovi, ve<lb xml:id="p1z30"/>hementer gaudeo deoque pro tanto beneficio gratias <lb xml:id="p1z31"/>ingentes ago, insuper et peto, ut in posterum id <lb xml:id="p1z32"/>ipsum robur atque eas vires tibi largiri <lb xml:id="p1z33"/>dignetur ad nominis sui gloriam ecclesiaeque <lb xml:id="p1z34"/>afflictae utilitatem, quod non dubito facturum <lb xml:id="p1z35"/>pro eo ipso, quo est in genus humanum amore atque <lb xml:id="p1z36"/>benignitate.</s>
					<s n="7" xml:lang="la">Et quoniam nunc negotiis reipublicae <lb xml:id="p1z37"/>districto plura (ut dixi) scribere non vacat, <pb/><lb xml:id="p2z3"/>reliqua commisi domino <persName ref="p8511">Trecio</persName> nomine meo coram ad <lb xml:id="p2z4"/>te refferenda hoc unico adiecto, quod, si quan<lb xml:id="p2z5"/>do opera mea in isto locorum intervallo usui tibi <lb xml:id="p2z6"/>esse poterit, studium in eo collocabo, ut co<lb xml:id="p2z7"/>gnoscas gratissimum hominem te sibi devinxisse.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p2z8"/>Vale, vir doctissime, et me, uti soles, ama <lb xml:id="p2z9"/>vicissimque te a me vehementer amari tibi <lb xml:id="p2z10"/>certo persuadeas.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Datum ex salinis <placeName ref="l545">Velicensibus</placeName> die <lb xml:id="p2z11"/>28. aprilis anno Christi veri dei nostri 156<lb xml:id="p2z12"/>7<lb xml:id="p2z15"/>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z19"/>Addictissim<lb xml:id="p2z23"/>u<lb xml:id="p2z24"/>s <lb xml:id="p2z25"/><persName ref="p3108">A<lb xml:id="p2z29"/>nd<lb xml:id="p2z30"/>reas Schadcovius</persName>, salina<lb xml:id="p2z31"/>rum <lb xml:id="p2z32"/><placeName ref="l545">Velicensiu<lb xml:id="p2z38"/>m</placeName> <lb xml:id="p2z39"/>n<lb xml:id="p2z46"/>o<lb xml:id="p2z48"/>t<lb xml:id="p2z49"/>ar<lb xml:id="p2z50"/>i<lb xml:id="p2z51"/>us<lb xml:id="p2z52"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse 668:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p4z1"/>Reverendo atque cla<lb xml:id="p4z2"/>rissimo viro domino <persName ref="p495">Henricho <lb xml:id="p4z3"/>Bullingero</persName> seni<lb xml:id="p4z4"/>ori, Iesu Christi ser<lb xml:id="p4z5"/>vo eximio, <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p4z6"/>ecclesiae episcopo <lb xml:id="p4z7"/>vigilantissimo etc. <lb xml:id="p4z8"/>domino et fratri in <lb xml:id="p4z9"/>Christo observando.</s>
				</p>
				<p>
					<note type="author">[Darunter Bemerkung von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="12" xml:lang="la"><lb xml:id="p4z10"/><persName ref="p3108">Andreas Schadcovius</persName>, <lb xml:id="p4z11"/>salinarum <placeName ref="l545">Velicensium</placeName> in <lb xml:id="p4z12"/><placeName ref="l2472">Polonia</placeName> notarius.</s>
				</p>
