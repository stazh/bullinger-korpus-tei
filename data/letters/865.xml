	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Per Christum Iesum S. D.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Gratias tibi ago pro sancto et benevolo munere; <lb xml:id="p1z4"/>nam me relaturum esse polliceri nullo modo poss<lb xml:id="p1z5"/>um.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/><persName ref="p8384">Hospiniano</persName>, collegae et communi amico nostro, tuum munus <lb xml:id="p1z7"/>reddidi, literas communicavi.</s>
					<s n="4" xml:lang="la">Quod autem me <lb xml:id="p1z8"/>prae cęteris amas, et charissimum est et honorificum mihi duco.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Quod censuram tuorum sermonum nobis permittis, non sunt, <lb xml:id="p1z10"/>optime et doctissime <persName ref="p495">Bullingere</persName> (ut pro me dicam) in me ea dona, quibus <lb xml:id="p1z11"/>fretus ausim de huiuscemodi rebus ferre sententiam, ac praesertim, <lb xml:id="p1z12"/>quae a te et tui similibus proficiscuntur, quae ita laudo, ita <lb xml:id="p1z13"/>probo, pro mea hac tenui rerum divinarum cognitione, ut vel <lb xml:id="p1z14"/>multos tum in nostra <placeName ref="l834">Italia</placeName> tum alibi optem esse, qui talia, <lb xml:id="p1z15"/>hoc est tam solida tamque omnibus numeris absoluta, conscribant.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z16"/>Omitto illud periculosum esse et invidiae plenum <lb xml:id="p1z17"/>hoc tempore de iis aliquid mutire, quae in caussa religionis <lb xml:id="p1z18"/>non modo alienae, sed etiam nostrae huius sincerioris eduntur.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z19"/>Nam, quae tu magna animi simplicitate et candore dixeris <lb xml:id="p1z20"/>scripserisve, ita sinistre accipientur, ut etiam ab iis, qui <lb xml:id="p1z21"/>tuum iudicium rogarint, scriptis perstringaris, nec refert, <lb xml:id="p1z22"/>quam aperte, modo ita, ut a quibusdam agnoscaris et ipsorum <lb xml:id="p1z23"/>fastidio et stomacho satisfaciant.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale per dominum <lb xml:id="p1z24"/>Iesum Christum, frater optime atque amantissime, et me, ut facis, <lb xml:id="p1z25"/>amare et ornare perge.</s>
					<s n="9" xml:lang="la"><placeName ref="l28">Basileae</placeName> 13. calendas aprilis 1550.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><persName ref="p714">C[oelius] S[ecu<lb xml:id="p1z26"/>ndus] Curio</persName>, ex animo tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Sapientissimo ecclesiae <lb xml:id="p2z2"/><placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z3"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z4"/>[a]mico et per Christum <lb xml:id="p2z6"/>fratri observandissimo suo.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
