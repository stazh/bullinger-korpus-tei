	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Pudet me sane, quod tot nunc abs te muneribus <lb xml:id="p1z2"/>lucubrationum tuarum singularum affectus, nihil vicis<lb xml:id="p1z3"/>sim retribuam; possem sane merito ingratus, <lb xml:id="p1z4"/>quod tamen indignum viro bono nomen est, appellari.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Itaque ut saltem aliquam gratitudinis meae tibi signi<lb xml:id="p1z6"/>ficationem praebeam, caseum hunc <persName>Sanensem</persName> ad te <lb xml:id="p1z7"/>mitto, quem spero boni gustus esse, non tamen talem, qui <lb xml:id="p1z8"/>tuis erga me beneficiis respondeat.</s>
					<s n="4" xml:lang="la">Si amplior se mihi <lb xml:id="p1z9"/>obtulerit occasio, amplius de te tuisque bene merebor.</s>
				</p>
				<p>
					<s n="5" xml:lang="la" ana="farewell"><lb xml:id="p1z10"/>Bene vale.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Salvi sint tui omnes.</s>
				</p>
				<p>
					<s n="7" xml:lang="de"><placeName ref="l41">Bernę</placeName> 17. sep<lb xml:id="p1z11"/>tembris 1557.</s>
				</p>
				<p>
					<note type="signature">[Unterschrift fehlt.]</note>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinę</placeName> ecclesię <lb xml:id="p2z4"/>pastori fidelissimo, <lb xml:id="p2z5"/>domino et compatri s<lb xml:id="p2z6"/>uo charissimo colen<lb xml:id="p2z7"/>dissimoque.</s>
				</p>
			</div>
		</body>
	</text>
