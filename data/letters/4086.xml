	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Heri ad te misi acta <placeName ref="l18">Augustanorum</placeName> comitiorum, nunc ad te mitto ad te leges <lb xml:id="p1z2"/>academie gene[vensis?] et quę e <placeName ref="l301">Lugduno</placeName> scripta sunt.</s>
					<s n="3" xml:lang="la">17. rex unctus est.</s>
					<s n="4" xml:lang="la"><persName>Philippus</persName> <lb xml:id="p1z3"/>nunc est in <placeName ref="l875">Hispania</placeName>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Dux <placeName>Sabaudie</placeName> adhuc est cum <persName ref="p8112">rege Gallie</persName>.</s>
					<s n="6" xml:lang="la">Spero me <lb xml:id="p1z4"/>brevi te visurum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Salutabis omnes amicos.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l760">Sol[uturi]</placeName> 21. septembris.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Tuus si suus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">D. H[enrico] Bul[<lb xml:id="p1z5"/>lingero] e[cclesie] T[<pb/><lb xml:id="p2z1"/>igurine] p[astori] v[igilantissimo] <lb xml:id="p2z2"/>a[mico] s[uo].</s>
				</p>
			</div>
		</body>
	</text>
