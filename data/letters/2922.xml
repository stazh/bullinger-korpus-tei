	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Salve <persName ref="p495">H. Bullingere</persName> frater.</s>
					<s n="2" xml:lang="la">Princeps meus <lb xml:id="p1z3"/>habuit tuum librum neque ullum dedit iuditium <lb xml:id="p1z4"/>displicere, quum offeretur, legisse nondum scio; <lb xml:id="p1z5"/>olfaciam, nam sum brevi iterum futurus <lb xml:id="p1z6"/>cum illo, an placuerit.</s>
					<s n="3" xml:lang="la">Heus, audi res <lb xml:id="p1z7"/>novas de me.</s>
					<s n="4" xml:lang="la">Dux <placeName ref="l2562">Prussiae</placeName> misit secretari<lb xml:id="p1z8"/>um ad me; rogat clementer, ad illum ut <lb xml:id="p1z9"/>eam, rogat etiam principem meum, ut <lb xml:id="p1z10"/>cogat ire; addit causas, nempe ut compo<lb xml:id="p1z11"/>nam ortas contentiones in ecclesiis <placeName ref="l2562">Prus<lb xml:id="p1z12"/>siacis</placeName> et iuvem <placeName ref="l2472">Poloniam</placeName>, quae fugiens <lb xml:id="p1z13"/>a papatu delabitur in sectas; sic enim scribit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z14"/>Ego tametsi scio me imparem esse tam ar<lb xml:id="p1z15"/>duis negotiis, tamen non detrecto laborem.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z16"/>Tu ora pro me cum tota ecclesia, quod te <lb xml:id="p1z17"/>vehementissime rogo.</s>
					<s n="7" xml:lang="la">Fui nuper apud <lb xml:id="p1z18"/>electorem <placeName ref="l2477">Palatinum</placeName>, qui omnino mihi <lb xml:id="p1z19"/>placet; ardet desiderio instaurandi ecclesia<lb xml:id="p1z20"/>s atque scholas.</s>
					<s n="8" xml:lang="la">Scribam tibi adhuc, <lb xml:id="p1z21"/>antequam abeam ex ducatu, quod intra <lb xml:id="p1z22"/>15 dies fiet, ac <placeName ref="l410">Ratisponam</placeName> prius ibo.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z23"/>Nunc catalogum novum mitto; mittam mox <lb xml:id="p1z24"/>annotationes, que nunc excuduntur.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale et <lb xml:id="p1z25"/>salve.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l512">Tubingae</placeName> 16. maii 1556.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, antistit<lb xml:id="p2z3"/>i <lb xml:id="p2z4"/><placeName ref="l587">Tigu<pb/><lb xml:id="p3z1"/>r<lb xml:id="p3z2"/>ino</placeName>, <lb xml:id="p3z3"/>fratri honorando.</s>
					<s n="14" xml:lang="la"><lb xml:id="p3z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
