	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Accepi tuas et puto te meas quoque interea accepisse.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Diarium seu itinerarium illud <placeName ref="l339">Neocomense</placeName> non misi; vidi <lb xml:id="p1z3"/><placeName ref="l832">Gallicum</placeName> exemplar satis prolixum, et quod nihil fere con<lb xml:id="p1z4"/>tinebat, quod esset alicuius momenti.</s>
					<s n="4" xml:lang="la">Interea literas, <lb xml:id="p1z5"/>quas <placeName ref="l339">Neocomo</placeName> et <placeName ref="l167">Geneva</placeName> accepi, misi.</s>
					<s n="5" xml:lang="la">Nunc nihil habe<lb xml:id="p1z6"/>o, nisi quod omnia de pace facta personant.</s>
					<s n="6" xml:lang="la">Sed ego nihil<lb xml:id="p1z7"/>dum certi affirmo; necdum enim, quibus conditionibus inita <lb xml:id="p1z8"/>sit, audivi.</s>
					<s n="7" xml:lang="la">Rediit ex castris consul <placeName ref="l922">Friburgensis</placeName> <persName>Praro<lb xml:id="p1z9"/>manus</persName>, quem audio hodie hic affuturum; is forte certi <lb xml:id="p1z10"/>aliquid adferet.</s>
					<s n="8" xml:lang="la">Quicquid cognovero, ad te perscribam.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z11"/>De valetudine mea et nostrorum ex fratris literis cognosces.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z12"/>Ego plura iam non possum propterea, quod festinante <lb xml:id="p1z13"/>nuncio ad negotia publica avocor.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Proinde bene vale; <lb xml:id="p1z14"/>dominus te servet incolumem diutissime!</s>
					<s n="12" xml:lang="la" ana="salute">Saluta tuos omnes <lb xml:id="p1z15"/>meo nomine; salutant te nostri quoque.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l41">Bernae</placeName> 2a aprilis 1568.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><persName ref="p8018">I[o<lb xml:id="p1z16"/>hannes] <lb xml:id="p1z17"/>Hallerus</persName> <lb xml:id="p1z18"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
