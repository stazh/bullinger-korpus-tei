	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. Ne omnino nihil scriberem, significo tuae pietati
					<lb xml:id="p1z2"/>me binas abs te accepisse literas, pro quibus ago
					<lb xml:id="p1z3"/>gratias. Quod rerius scripsi iam aliquanto tempore
					<lb xml:id="p1z4"/>aa fuit valetudo mea satis afflicta. Utcunque
					<lb xml:id="p1z5"/>arevalesco. Gratiae sint domino, quem oro, ut fece
					<lb xml:id="p1z6"/>liciter utatur meo ministerio, quoad vivere n
					<lb xml:id="p1z7"/>rrit me. Scribo iam sermones duos Germania
					<lb xml:id="p1z8"/>Gmanice, quos Latinos facit gener meus La
					<lb xml:id="p1z9"/>vaterus de coena domini de institutione eius
					<lb xml:id="p1z10"/>de forma et usu et reliquis ad hoc negotium
					<lb xml:id="p1z11"/>pertinentibus. Mittam et tibi et illustrissimo
					<lb xml:id="p1z12"/>primis exemplaria, quem atdio rediisse
					<lb xml:id="p1z13"/>ad vos. Gratulare illi meo nomine. Nunc enim
					<lb xml:id="p1z14"/>vix haec tibi scribere potui, addes et
					<lb xml:id="p1z15"/>illud: d. Hallerum Bernatem 30. maii in hae
					<lb xml:id="p1z16"/>erba scribere, Illustrissimu comiti beorgio
					<lb xml:id="p1z17"/>nihil amplius respondere possum, nisi quod mihi
					<lb xml:id="p1z18"/>videretur operae precium esse, ut si ministrum illum
					<lb xml:id="p1z19"/>de quo antea ex agro nostro habere vellet, quem
					<lb xml:id="p1z20"/>Tossano coniungeret, scriberet ea de re ad nostrum
					<lb xml:id="p1z21"/>senatum, cuius authoritate facile omnia tollum
					<lb xml:id="p1z22"/>impedimenta. Haec ille. Commenda me praesien
					<lb xml:id="p1z23"/>piissimo. de quo spero, quod de optimo
					<lb xml:id="p1z24"/>principe. Scribam illi, quam primum editi
					<lb xml:id="p1z25"/>fuerint sermones illi. Cras typographum
					<lb xml:id="p1z26"/>parare incipiet. Valemus hic recte deo
					<lb xml:id="p1z27"/>gratia et sunt pacata omnina. Dominus benedicat no
					<lb xml:id="p1z28"/>porro et servet nos. Ora pro nobis
					<lb xml:id="p1z29"/>et scribe mox. Fama est optimo Melanchton
					<lb xml:id="p1z30"/>migrasse ad dominum, sed et alios quos
					<lb xml:id="p1z31"/>viros bonos. Si de his habes adi
					<lb xml:id="p1z32"/>quid certi, significa. Vive et vale
					<lb xml:id="p1z33"/>optime. Salutant te symmystae et
					<lb xml:id="p1z34"/>
					<lb xml:id="p1z35"/>Tiguri 11. iunii 1553.
					<lb xml:id="p1z36"/>fratres omnes.
					<lb xml:id="p1z37"/>sunt fratres.
					<lb xml:id="p1z38"/>Salvu
					<lb xml:id="p1z39"/>Bullingerus tuus.
					<pb/>
					<lb xml:id="p2z1"/>Optime de pietateme
					<lb xml:id="p2z2"/>senum d. Matthiae
					<lb xml:id="p2z3"/>ErbioRychevylano
					<lb xml:id="p2z4"/>pastori, domino et fratri
					<lb xml:id="p2z5"/>suo colendissimo.
					<lb xml:id="p2z6"/>Reychenwyr
					<lb xml:id="p2z7"/>redditę q die
					<lb xml:id="p2z8"/>augusti.
				</p>
