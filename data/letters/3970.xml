	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Miror, qui fiat, quod iam aliquod septiman<lb xml:id="p1z2"/>as nullas a te acceperim literas.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Caterum tri<lb xml:id="p1z3"/>buo hoc tuis negotiis, aut quod argumento destitutus re <lb xml:id="p1z4"/>nihili nolueris turbare mea studia.</s>
					<s n="4" xml:lang="la">Ex <lb xml:id="p1z5"/><placeName ref="l18">Augustanis</placeName> comitiis plane nihil accipio; ex <placeName ref="l830">Anglia</placeName> <lb xml:id="p1z6"/>per <placeName ref="l491">Argentoratum</placeName> habemus religionis res in perlamento <lb xml:id="p1z7"/>filiciter pro... re, restitui etiam exules et multa <lb xml:id="p1z8"/>alia felicia, de quibus cum copiosiores expectem literas, <lb xml:id="p1z9"/>satis esse putavi haec in praesenti consignasse.</s>
					<s n="5" xml:lang="la"><placeName ref="l28">Basileae</placeName> <lb xml:id="p1z10"/>Georgius David ante biennium mortuus exhumatus 20. <lb xml:id="p1z11"/>maii postera est combustus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><persName>Horrenda</persName> sparsit dogmata <lb xml:id="p1z12"/>et latuit <placeName ref="l28">Basileae</placeName>; liberi eius, generi et familia<lb xml:id="p1z13"/>res carcere detenti sunt multo tempore, cumque ne<lb xml:id="p1z14"/>garint et pernegarint se abominandis coniunxisse dogmatis, <lb xml:id="p1z15"/>dimissi sunt, non tamen sine certa ratione etc.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/><placeName ref="l41">Bernenses</placeName> <placeName>Martburgo</placeName> evocarunt d. <persName ref="p8386">Hyperium</persName> <placeName ref="l280">Lausan<lb xml:id="p1z17"/>nam</placeName> profitendi gratia; rediit vero infecta re tabellio; <lb xml:id="p1z18"/>nam dimittere ipsum noluit princeps, sed et liberale <lb xml:id="p1z19"/>ei stipendium decrevit.</s>
					<s n="8" xml:lang="la">Vult item, ut reformet <lb xml:id="p1z20"/>scholam <placeName>Martburgensem</placeName>, pollicetur multa; alioqui enim <lb xml:id="p1z21"/>non mansurus erat <persName ref="p8386">Hyperius</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Mira est <persName>Saxonum</persName> schver<lb xml:id="p1z22"/>merisatio; lantgravius indigne fert barbariem, <lb xml:id="p1z23"/>indigne fert et <persName ref="p2095">Philippus Melanchton</persName>.</s>
					<s n="10" xml:lang="la">Varia captantur consi<lb xml:id="p1z24"/>lia; quid futurum sit, novit dominus, et nos forte, si <lb xml:id="p1z25"/>vixerimus, audiemus.</s>
					<s n="11" xml:lang="la">Res nostrae per dei gratiam satis bene <lb xml:id="p1z26"/>habent.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Utinam tu quoque cum tuis omnibus valeas.</s>
					<s n="13" xml:lang="la">Dominus <lb xml:id="p1z27"/>benedicat tibi.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Salutato d. <persName>Philippum</persName>, d. <persName ref="p3196">Tscharnerum</persName> et <persName ref="p8055">Ambrosium</persName>, <lb xml:id="p1z28"/>d. <persName ref="p6130">Pontasellam</persName> et amicos nostros.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 25. maii <lb xml:id="p1z29"/>anno 1559.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z30"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z31"/>Clarissimum virum d. legatum regium <lb xml:id="p1z32"/>salutato nomine meo humanissime <lb xml:id="p1z33"/>et me ipsi commenda.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z3"/>in <placeName ref="l648">Rhetia</placeName> ministro fideli, <lb xml:id="p2z4"/>domino compatri et fratri <lb xml:id="p2z5"/>suo charissimo et colendissimo.</s>
					<s n="20" xml:lang="la"><lb xml:id="p2z6"/>Chur.</s>
				</p>
			</div>
		</body>
	</text>
