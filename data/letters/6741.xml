					<s n="2" xml:lang="la">Patres ac fratres reverendi, etsi de mutua <lb xml:id="p1z2"/>nostra coniunctione nunquam dubitavimus, tamen <lb xml:id="p1z3"/>non possumus non agere summas deo et patri nostro <lb xml:id="p1z4"/>gratias ac vobis etiam maximum nostrum gaudium <lb xml:id="p1z5"/>testificari, quod nuper adeo nos tam arcto vinculis, <lb xml:id="p1z6"/>communis videlicet per omnia confessionis, conglutinarit, <lb xml:id="p1z7"/>idque eo magis, quod manifeste cernamus totum hoc <lb xml:id="p1z8"/>negotium divina providentia potius quam ullis <lb xml:id="p1z9"/>humanis consiliis fuisse administratum.</s>
					<s n="3" xml:lang="la">Speramus <lb xml:id="p1z10"/>ergo ac plene confidimus tantae huius rei <lb xml:id="p1z11"/>auctorem hoc nobis daturum, ut ad exteras <lb xml:id="p1z12"/>etiam gentes longe lateque huius nostrae sanctae <lb xml:id="p1z13"/>consensionis odor maximo cum fructu <lb xml:id="p1z14"/>diffundatur.</s>
					<s n="4" xml:lang="la">Superest, ut pro viribus tantum <lb xml:id="p1z15"/>hoc bonum mutuis officiis et quam ardentissima <lb xml:id="p1z16"/>fraternitate in domino faveamus.</s>
					<s n="5" xml:lang="la">Qua quidem <lb xml:id="p1z17"/>in re speramus <lb xml:id="p1z18"/>nos operam sedulo daturos, ne quid <lb xml:id="p1z20"/>in nobis merito requiratis.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z21"/>valete, patres ac fratres in domino plurimum observandi.</s>
					<s n="7" xml:lang="la">D. Iesu<lb xml:id="p1z22"/>s dignetur vos omnes custodire et <lb xml:id="p1z23"/>sanctis vestris laboribus magis ac magis <lb xml:id="p1z24"/>benedicere.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l167">Genevae</placeName> 26. msrtii 1566.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z25"/><persName ref="p8033">Theodor Beza</persName> nomine omnium <lb xml:id="p1z26"/>pastorum ac professorum <lb xml:id="p1z27"/><placeName ref="l167">Genevensis</placeName> ecclesiae, fratrum <lb xml:id="p1z28"/>pietati vestrae addictissimorum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eximiis Christi servis <lb xml:id="p2z2"/>patribus ac dominis <lb xml:id="p2z3"/>plurimum observandis <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z5"/>pastoribus et doctoribus.</s>
					<s n="11" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
