	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime vir ac frater colendissime.</s>
					<s n="2" xml:lang="la">Cum brev<lb xml:id="p1z2"/>i tecum futurus sim onustus non modo <lb xml:id="p1z3"/><placeName ref="l2562">Prutenicis</placeName>, <placeName ref="l841">Lituanicis</placeName> ac <placeName ref="l2472">Polonicis</placeName>, <lb xml:id="p1z4"/>sed etiam <placeName ref="l822">Germanicis</placeName> negotiis, non est <lb xml:id="p1z5"/>opus, ut onerem te legendis meis nunc; <lb xml:id="p1z6"/>sed coram faciam.</s>
					<s n="3" xml:lang="la" ana="farewell">Interim vale.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="salute">Salvere <lb xml:id="p1z7"/>iubeo domum, scholam ecclesiam.</s>
					<s n="5" xml:lang="la">Oro, <lb xml:id="p1z8"/>voca ad te duos fratres <placeName ref="l2472">Polonos</placeName>, pie<lb xml:id="p1z9"/>ntissimae matris filios; dic me prope<lb xml:id="p1z10"/>diem affuturum, ac ut ita se gerant, <lb xml:id="p1z11"/>ut possim matri bonum testimonium <lb xml:id="p1z12"/>dare.</s>
					<s n="6" xml:lang="la">Si quid rerum <placeName ref="l834">Italicarum</placeName> novi habes, <lb xml:id="p1z13"/>oro, scribe cum hoc meo famulo.</s>
					<s n="7" xml:lang="la" ana="farewell"><lb xml:id="p1z14"/>Vale et salve, <persName ref="p495">H. Bullingere</persName>.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/><placeName ref="l512">Tubingae</placeName> kalendis maii 1557.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse von anderer Hand:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>fratri et domino hon<lb xml:id="p2z4"/>orando.</s>
					<s n="11" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
