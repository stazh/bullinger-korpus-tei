	<text xml:lang="de">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Pecunias pro aromaticis speciebus accepi<note xml:id="fn1" type="footnote" n="1">Vgl. <ref target="file12504">Nr. 2457</ref>,4-6.</note>.</s>
					<s n="3" xml:lang="la">Pretium <persName ref="p18989">Boethii</persName><note xml:id="fn2" type="footnote" n="2">Die <persName ref="p18989">Boethius</persName>-Ausgabe (s. <bibl source="b19">HBBW XVI</bibl> 178, Anm. 43) hatte <persName ref="p495">Bullinger</persName> vermutlich nach dem 31. März von <persName ref="p1278">Gast</persName> erhalten (s. ebd., 289,200.</note> <lb xml:id="p1z2"/>indicabo, si m. <persName ref="p6070">Henrichum Petri</persName> videro.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="4" xml:lang="de"><lb xml:id="p1z3"/>Die von <placeName ref="l491">Straßburg</placeName> haben dem <persName ref="p3590">lantgroven</persName> von <placeName ref="l213">Hessen</placeName><note xml:id="fn3" type="footnote" n="3"><persName ref="p3590">Philipp von Hessen</persName>.</note> 4 fenlin <lb xml:id="p1z4"/>lantzknecht geschickt<note xml:id="fn4" type="footnote" n="4">Siehe dazu <bibl source="b480">PC</bibl> IV/I 148, Nr. 118; 158f, Nr. 129f; 164f, <ref target="file10169">Nr. 138</ref>; 172, <ref target="file10175">Nr. 144</ref>; 175, <ref target="file10179">Nr. 148</ref>; 188, <ref target="file10195">Nr. 164</ref>; 194, <ref target="file10201">Nr. 170</ref>; 199, <ref target="file10207">Nr. 176</ref>.</note>.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="5" xml:lang="de">Ouch hab ich ein brieff gelesen, den ein <lb xml:id="p1z5"/>houptman<note xml:id="fn5" type="footnote" n="5">Unbekannt.</note> uß des <persName ref="p20225">kunigs</persName> von <placeName ref="l832">Franckreichs</placeName><note xml:id="fn6" type="footnote" n="6"><persName ref="p20225">Franz I.</persName></note> leger<note xml:id="fn7" type="footnote" ana="lex" n="7">Lager.</note> geschriben hat siner muͦtter<note xml:id="fn8" type="footnote" n="8">Unbekannt.</note>, <lb xml:id="p1z6"/>die zuͦ <placeName ref="l28">Basel</placeName> wonet, er woͤlte jetz heimkommen sein.</s>
					<s n="6" xml:lang="de">So hab er, der <persName ref="p3590">Hessus</persName>, <lb xml:id="p1z7"/>den huffen lantzsknecht angenomen, nachdem es friden ist worden zwischen <lb xml:id="p1z8"/>dem <persName ref="p20225">Gallo</persName> und <persName ref="p8375">Anglo</persName><note xml:id="fn9" type="footnote" n="9">König <persName ref="p8375">Heinrich VIII.</persName> - Zum Friedensschluss s. <ref target="file12517">Nr. 2470</ref>,16f; <ref target="file12529">Nr. 2482</ref>,15-17.</note>.<note xml:id="fn10" type="footnote" n="10">Die Initiative, diese Truppen für den Landgrafen anzuwerben, geht auf <placeName ref="l491">Straßburg</placeName> zurück; s. <bibl source="b480">PC</bibl> IV/1 164f, Nr. 138; 166, Nr. 139; 168, <ref target="file10172">Nr. 141</ref>; 173, <ref target="file10175">Nr. 144</ref>; 175f, <ref target="file10179">Nr. 148</ref>; 181, <ref target="file10185">Nr. 154</ref>; 188, <ref target="file10195">Nr. 164</ref>.</note><pb type="edition" next="134"/></s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="7" xml:lang="de">Das geschrey ist by unß, der <persName ref="p3590">Hessus</persName> und <persName ref="p20464">dux <lb xml:id="p1z9"/>Lüneburgensis</persName><note xml:id="fn11" type="footnote" n="11">Herzog <persName ref="p20464">Franz von Braunschweig-Lüneburg-Gifhorn</persName>.</note> wellen <placeName ref="l2529">Probant</placeName><note xml:id="fn12" type="footnote" n="12"><placeName ref="l2529">Brabant</placeName>.</note> angriffen, darin vil gerüster pferdt seindt <lb xml:id="p1z10"/>und vil fuͦßvolcks.</s>
					<s n="8" xml:lang="de">Got gebe gluck und heil!</s>
					<s n="9" xml:lang="la">Scio dominum nos <lb xml:id="p1z11"/>non deserere, sed suo auxilio <persName ref="p18538">Pharaonem</persName> illum<note xml:id="fn13" type="footnote" n="13"><persName ref="p18538">Karl V.</persName>; vgl. <ref target="file12525">Nr. 2478</ref> und Anm. 7.</note> perdere ac ad inferna <lb xml:id="p1z12"/>detrudere.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="10" xml:lang="de"><lb xml:id="p1z13"/>Es kummen vil knecht widerumb.</s>
					<s n="11" xml:lang="de">Die ursach, mann wil ynen nit <lb xml:id="p1z14"/>sagen, wo uß man woͤlle, wider wenn<note xml:id="fn14" type="footnote" ana="lex" n="14">wen.</note>.</s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="12" xml:lang="de"><lb xml:id="p1z15"/>Die unsern haben ußgelegt<note xml:id="fn15" type="footnote" n="15">ausgehoben; gemustert.</note> zum fenlin und paner<note xml:id="fn16" type="footnote" n="16">Siehe dazu <ref target="file12525">Nr. 2478</ref>, Anm. 22.</note>.</s>
					<s n="13" xml:lang="de">Der <lb xml:id="p1z16"/>keyser wietet<note xml:id="fn17" type="footnote" ana="lex" n="17">wütet.</note>, pfifft uff dem letzsten löchlin<note xml:id="fn18" type="footnote" n="18">"Auf dem letzten Loch pfeifen", d.h. am Ende seiner Kräfte sein; vgl. <bibl source="b681">Wander</bibl> III 216, Nr. 79.</note>.</s>
					<s n="14" xml:lang="de">Die pfaffen müssen <lb xml:id="p1z17"/>gar zum tüfel.</s>
				</p>
			</div>
			<div xml:id="div7" corresp="regest7">
				<p>
					<s n="15" xml:lang="la">Hęc paucis volui ad te scribere; reliqua <persName ref="p8418">Myconius</persName><note xml:id="fn19" type="footnote" n="19">Mit Brief <ref target="file12529">Nr. 2482</ref>.</note>.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p18250">Saxo</persName><note xml:id="fn20" type="footnote" n="20">Herzog <persName ref="p18250">Moritz von Sachsen</persName>.</note> parat se ac munit loca <placeName ref="l2449">Bohemiam</placeName> spectantia, <lb xml:id="p1z19"/>ne irruptio fiat improvisa<note xml:id="fn21" type="footnote" n="21">Vonseiten der <placeName ref="l2510">Türken</placeName>. - In <persName ref="p7430">Christoph von Carlowitz</persName>' Brief an Herzog <persName ref="p18250">Moritz von Sachsen</persName>, 27. und 28. Juni 1546 <hi>(<persName ref="p18250">Moritz von Sachsen</persName> PK</hi> 11/2 684, <ref target="file10975">Nr. 933</ref>), wird diese Gefahr allerdings als gering eingeschätzt. <persName ref="p18250">Herzog Moritz</persName> fürchtete wohl schon damals einen Einfall des Königs von <placeName ref="l2449">Böhmen</placeName>, <persName ref="p18477">Ferdinand I.</persName>, ins benachbarte ernestinische <placeName ref="l749">Sachsen</placeName>; s. <ref target="file12650">Nr. 2603</ref>, Anm. 8.</note>.</s>
					<s n="17" xml:lang="de"><lb xml:id="p1z20"/>Ich weiß das wol, das die botschafft von <placeName ref="l491">Straßburg</placeName> ist heim<lb xml:id="p1z21"/>postiert in 3 tagen von <placeName ref="l410">Regenspurg</placeName>,<note xml:id="fn22" type="footnote" n="22">Die Gesandten <placeName ref="l491">Straßburgs</placeName> auf dem <placeName ref="l410">Regensburger</placeName> Reichstag waren <persName ref="p7684">Heinrich von Müllenheim</persName> und <persName ref="p5137">Michael Han</persName>. Mit einem Schreiben vom 21. Juni forderte der <placeName ref="l491">Straßburger</placeName> Rat sie zur Heimkehr auf; s. <bibl source="b480">PC</bibl> IV/1 145, Nr. 113. - Die in diesem Brief überlieferten und mit <placeName ref="l491">Straßburg</placeName> in Verbindung stehenden Nachrichten gehen wohl auf <persName ref="p8310">Ulrich Chelius (Geiger)</persName> zurück, der am 28. Juni als Gesandter <placeName ref="l491">Straßburgs</placeName> in <placeName ref="l28">Basel</placeName> nachgewiesen ist; <bibl source="b480">PC</bibl> IV/1 165, Nr. 138; 173f, <ref target="file10177">Nr. 146</ref>.</note> do<note xml:id="fn23" type="footnote" ana="lex" n="23">diesbezüglich.</note> niemants nuit darvon <lb xml:id="p1z22"/>geseyt, ob periculum imminens.</s>
					<s n="18" xml:lang="la"><foreign xml:lang="de">Gott kan alle</foreign> consilia impiorum frangere, <lb xml:id="p1z23"/>annihilare,<note xml:id="fn24" type="footnote" n="24">Vgl. <cit type="bible"><ref>Ps 37 (Vulg. 36), 12-17</ref></cit>; <cit type="bible"><ref>Hi 5, 12</ref></cit>; <cit type="bible"><ref>Neh 4, 9 (Vulg. 15)</ref></cit>.</note> saltem nos domino fidamus, illum invocemus corde et o<lb xml:id="p1z24"/>re<note xml:id="fn25" type="footnote" n="25">Vgl. <cit type="bible"><ref>Röm 10, 9f</ref></cit>.</note>.</s>
				</p>
			</div>
			<div xml:id="div8" corresp="regest8">
				<p>
					<s n="19" xml:lang="la" ana="farewell">Vale.</s>
					<s n="20" xml:lang="la">29. iunii 1546.</s>
				</p>
			</div>
			<div xml:id="div9" corresp="regest9">
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z25"/>Tuus <lb xml:id="p1z26"/><persName ref="p1278">G.</persName></s>
				</p>
			</div>
			<div xml:id="div10" corresp="regest10">
				<p>
					<s n="22" xml:lang="de"><lb xml:id="p1z27"/>Die von <placeName ref="l491">Straßburg</placeName> nement noch knecht an.</s>
					<s n="23" xml:lang="de">Haben by 7 fenlin.</s>
					<s n="24" xml:lang="de"><lb xml:id="p1z28"/>Mann wolt im <placeName ref="l632">Elsaß</placeName> knecht annemen, so wil niemants ziehen<note xml:id="fn26" type="footnote" n="26">Das stimmt nicht; s. z.B. <bibl source="b480">PC</bibl> IV/1 175, Nr. 148.</note>.</s>
					<s n="25" xml:lang="de"><lb xml:id="p1z29"/>Der <persName ref="p8098">margraff</persName><note xml:id="fn27" type="footnote" n="27"><persName ref="p8098">Georg von Württemberg-Mömpelgard</persName>.</note> hat verbotten by lib und guͦt, das niemants keim <lb xml:id="p1z30"/>herren zuͦziehe, er sey, wer er woͤll<pb/><lb xml:id="p2z1"/>e.</s>
				</p>
			</div>
			<div xml:id="div11" corresp="regest11">
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="26" xml:lang="de"><lb xml:id="p2z2"/>Dem erwuͤrdigen <lb xml:id="p2z3"/>herren, herren <persName ref="p495">Hein<lb xml:id="p2z4"/>rychen Bullinger</persName>, <lb xml:id="p2z5"/>pfarherr zuͦ <placeName ref="l587">Zürich</placeName>, <lb xml:id="p2z6"/>mynem gunstigen, lie<lb xml:id="p2z7"/>ben herren, zuͦ han<lb xml:id="p2z8"/>den.</s>
				</p>
				<p>
					<s n="27" xml:lang="de"><lb xml:id="p2z9"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
