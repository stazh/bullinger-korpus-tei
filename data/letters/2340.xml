			<zone xml:id="p2z44-0" points="2579,3349 2608,3352 2628,3343 2640,3356 2654,3358 2665,3349 2674,3359 2698,3365 2705,3268 2693,3264 2684,3269 2665,3255 2644,3268 2621,3266 2616,3271 2598,3259 2584,3259">2590,3321 2619,3321 2648,3321 2677,3318 2706,3312</zone>
