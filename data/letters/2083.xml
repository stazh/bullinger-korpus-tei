	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Arbitror te, compater in domino charissime, <lb xml:id="p1z2"/>iam antea intellexisse d. <persName ref="p2336">Bernardinum <lb xml:id="p1z3"/>Ochinum</persName> Senensem illum proximis diebus <lb xml:id="p1z4"/>fuisse <placeName ref="l28">Basileę</placeName>, elapsum videlicet ex <lb xml:id="p1z5"/><placeName ref="l830">Anglia</placeName>, misera illa et multis modis <lb xml:id="p1z6"/>calamitosa.</s>
					<s n="3" xml:lang="la">De <persName ref="p8111">Petro Martyre</persName> nondum <lb xml:id="p1z7"/>cognovi, ubinam sit, vehementer illi <lb xml:id="p1z8"/>timeo a papistis <placeName ref="l830">Anglicis</placeName>.</s>
					<s n="4" xml:lang="la">Quaeso, si de <lb xml:id="p1z9"/>illo et aliis bonis viris certi quid habes, <lb xml:id="p1z10"/>communices.</s>
					<s n="5" xml:lang="la">Miserabilis est haec ruina <placeName ref="l830">An<lb xml:id="p1z11"/>glicanarum</placeName> ecclesiarum, quae in ipso veluti <lb xml:id="p1z12"/>flore praeter omnium opinionem cruci sub<lb xml:id="p1z13"/>iiciuntur, imo de veritate Christi periclitantur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Legatus pontificis initio mensis <lb xml:id="p1z15"/>huius <placeName ref="l18">Augustam</placeName> transiit petens <placeName ref="l830">Angliam</placeName> <lb xml:id="p1z16"/>confirmaturus illic mancipia antichristi <lb xml:id="p1z17"/>et membra Christi divexaturus.</s>
					<s n="7" xml:lang="la">Orandus <lb xml:id="p1z18"/>est dominus noctes et dies pro fratribus <lb xml:id="p1z19"/>periclitantibus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l18">Augustani</placeName> iterum conscribunt <lb xml:id="p1z20"/>militem.</s>
					<s n="9" xml:lang="la">Marchio fertur tertio caesus; <lb xml:id="p1z21"/>partes illius dux <persName ref="p20484">Ioh[annes] Frid[ericus]</persName> fovere <lb xml:id="p1z22"/>videtur nec deesse illi manum <persName ref="p18538">Caesaris</persName>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Promicat mira <placeName ref="l822">Germaniae</placeName> nostrę <lb xml:id="p1z24"/>confusio.</s>
					<s n="11" xml:lang="la">D. <persName ref="p2916">Schertlinus</persName> <placeName ref="l18">Augustam</placeName> rediit, <lb xml:id="p1z25"/>quibus conditionibus, ignoro.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z26"/>Caeterum mitto hic ad te Decalogum nostrum, <lb xml:id="p1z27"/>aquas videlicet mari; verum sic faciendum <lb xml:id="p1z28"/>est, quando meliora non habeo.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z29"/>Boni haec consule.</s>
					<s n="14" xml:lang="la">Per gratiam domini bene <lb xml:id="p1z30"/>valemus.</s>
					<s n="15" xml:lang="la">Spero idem de te ac tuis.</s>
					<s n="16" xml:lang="la" ana="salute">Saluta <lb xml:id="p1z31"/>tuos omnes, d. <persName ref="p8171">Theobaldum</persName>, <persName ref="p8127">Pellicanum</persName>, <persName ref="p8011">Gvaltherum</persName> <lb xml:id="p1z32"/>et reliquos.</s>
					<s n="17" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1553. 22. novembris, quo <pb/><lb xml:id="p2z1"/>die exercitus Protestantium anno 46 <lb xml:id="p2z2"/>a se invicem dissiluit et Caesari omnes <lb xml:id="p2z3"/>valvas aperuit.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z4"/><persName ref="p8417">W[o<lb xml:id="p2z5"/>lfgangus] <lb xml:id="p2z6"/>Musc[ulus</persName>] tuus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z7"/>Praestantissimo <lb xml:id="p2z8"/>theologo m. <lb xml:id="p2z9"/><persName ref="p495">Heinrycho Bul<lb xml:id="p2z10"/>lingero</persName>, d. et <lb xml:id="p2z11"/>compatri suo <lb xml:id="p2z13"/>charissimo.</s>
				</p>
				<p>
					<s n="20" xml:lang="de"><lb xml:id="p2z15"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
