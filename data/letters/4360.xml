	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Si vos valetis, domine ac compater multum observande, bene est; <lb xml:id="p1z3"/>nos quoque per domini optimi maximi gratiam recte valemus omnes.</s>
					<s n="3" xml:lang="la">Do<lb xml:id="p1z4"/>minus det, ut deinceps quoque una vobiscum nos quoque valeamus <lb xml:id="p1z5"/>semper!</s>
					<s n="4" xml:lang="la">Gratias tibi magnas agimus pro novis illis ad nos datis, <lb xml:id="p1z6"/>quae eatenus nobis quoque serviunt, ut pro piorum successu gratias <lb xml:id="p1z7"/>agamus domino et undique impendentia pericula et impiorum ma<lb xml:id="p1z8"/>chinas deprecari iuvemus, id quod facimus per domini gratiam et <lb xml:id="p1z9"/>faciemus.</s>
					<s n="5" xml:lang="la">Fieri sponsalia tui filii <persName ref="p477">Ioannis Rodolphi</persName> audimus, cui <lb xml:id="p1z10"/>omnes una vobiscum omnia precamur fausta optamusque, ut <lb xml:id="p1z11"/>talem vitae sociam [h]abeat, qualem sibi quisque bonus et sapi<lb xml:id="p1z12"/>ens optare possit.</s>
					<s n="6" xml:lang="la">20 fl. quod attinet, habebis illos <lb xml:id="p1z13"/>in promptu, nec est, quod pro his roges aut praecipias; <lb xml:id="p1z14"/>numerabit illos aut socrus mea aut noster <persName>Wilhelmus</persName>, <lb xml:id="p1z15"/>novus camerarius, qui illos ei reddet.</s>
					<s n="7" xml:lang="la">Quod scribis forte <lb xml:id="p1z16"/>fore, ut quidam ex nostris nos invisuri sint, fiat, quod vobis <lb xml:id="p1z17"/>videbitur; mallemus tamen illos sumptibus et laboribus suis <lb xml:id="p1z18"/>parcere, licet nobis charissimi et gratissimi sint futuri.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z19"/>Haec propere effusa, domine ac compater observande, nunc, rogo, <lb xml:id="p1z20"/>boni consulas; negant enim, ut vides, manus officium, quę <lb xml:id="p1z21"/>nunc in me solae satis sunt afflictae; reliqua omnia <lb xml:id="p1z22"/>per domini gratiam in me meisque habent quam optime.</s>
					<s n="9" xml:lang="la" ana="salute">Salutem <lb xml:id="p1z23"/>petimus omnium nostrum nomine dicere digneris <lb xml:id="p1z24"/>tuae honestissimae matronę et familię cum generis et fil<lb xml:id="p1z25"/>iabus, domino item <persName ref="p8011">Gvalthero</persName> et <persName ref="p3988">Wolfio</persName>, dilectis et <lb xml:id="p1z26"/>honorandis fratribus.</s>
					<s n="10" xml:lang="la" ana="farewell">Valete in domino quam foelicissime.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z27"/>Ad <placeName ref="l21">Aquas Helvetiorum</placeName> 22. iulii 1560.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z28"/>Tui colendissimus et observantissimus <lb xml:id="p1z29"/><persName ref="p1453">Wolfgangus Hallerus</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>antistiti fidelissimo, domino ac <lb xml:id="p2z4"/>compatri suo summe colendo.</s>
					<s n="14" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>