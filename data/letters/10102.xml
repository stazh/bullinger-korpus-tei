			<zone xml:id="p2z2-0" points="946,2178 1084,2215 1172,2167 1506,2195 1650,2173 1652,2100 1628,2096 1510,2103 1433,2148 1317,2116 1155,2152 947,2146">951,2166 986,2163 1021,2163 1056,2163 1091,2163 1126,2162 1161,2160 1196,2158 1231,2157 1266,2157 1301,2157 1336,2157 1371,2157 1406,2156 1441,2154 1476,2154 1511,2149 1546,2146 1581,2146 1616,2150 1652,2157</zone>
