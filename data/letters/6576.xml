	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Ultimis meis ad te literis scripsi, chare frater, <lb xml:id="p1z2"/>uxorem d. <persName ref="p8011">Gvaltheri</persName> nostri, charissimam sororem nostram, <lb xml:id="p1z3"/>decumbere graviter.</s>
					<s n="3" xml:lang="la">His tibi significo illam in <lb xml:id="p1z4"/>syncerissima fide sub initium die 14. huius mensis <lb xml:id="p1z5"/>inter 2. et 3. reddidisse spiritum suum deo et maxima <lb xml:id="p1z6"/>admirandaque cum laetitia migrasse hinc maximo <lb xml:id="p1z7"/>nostrum omnium cum dolore.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Fortissimo quidem animo <lb xml:id="p1z8"/>hanc calamitatem fert <persName ref="p8011">Gvaltherus</persName>, verum ita attonitus <lb xml:id="p1z9"/>sui dissimilis est, ut ei vehementer metuam.</s>
					<s n="5" xml:lang="la">Ora ergo <lb xml:id="p1z10"/>dominum, ut utile organum ecclesiae non destruat <lb xml:id="p1z11"/>piisque eripiat.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><placeName ref="l167">Geneva</placeName> scribit <persName ref="p8033">Beza</persName> noster rem <lb xml:id="p1z12"/>ecclesiae in <placeName ref="l832">Gallia</placeName> non bono esse loco.</s>
					<s n="7" xml:lang="la">Orandum ergo <lb xml:id="p1z13"/>dominum, ut sanguinaria consilia latronum in<lb xml:id="p1z14"/>fringat.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">In <placeName ref="l830">Anglia</placeName> et <placeName ref="l2524">Scotia</placeName> maximi sunt tu<lb xml:id="p1z15"/>multus; Satanas ergo novas excitat tragoedias.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>Dominus conterat eum!</s>
					<s n="10" xml:lang="la">Plura ille ad me scribit; <lb xml:id="p1z17"/>ego vero ocium non habeo plura ad te scribendi.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z18"/><placeName ref="l18">Augustae Vindelicorum</placeName> ad me scribitur <lb xml:id="p1z19"/>comitia imperialia proclamata esse eaque futura <lb xml:id="p1z20"/><placeName ref="l18">Augustae</placeName> calendis ianuarii.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l546">Vienna</placeName> ex <lb xml:id="p1z21"/>aula ad me scribitur diu laboratum esse de sar<lb xml:id="p1z22"/>cienda pace inter imperatorem et <placeName ref="l2510">Turcam</placeName>, sed nullo <lb xml:id="p1z23"/>cum felici eventu, exercitus in hyberna <lb xml:id="p1z24"/>ductos.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Maxima est praeterea rerum et caritas <lb xml:id="p1z25"/>et inopia in <placeName ref="l832">Gallia</placeName>, <placeName ref="l830">Anglia</placeName>, <placeName ref="l20">Inferiore Germ<lb xml:id="p1z26"/>ania</placeName>, et hic quoque carissimo precio vendunt<lb xml:id="p1z27"/>ur frumenta; sunt ergo haec ultima tempora etc.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z28"/>Alias scribam copiosius, cum moeror me minus <lb xml:id="p1z29"/>turbaverit.</s>
					<s n="15" xml:lang="la">Alioqui <placeName ref="l546">Vienna</placeName> accepi <lb xml:id="p1z30"/>scriptum pulcherrimum cuiusdam viri magni <lb xml:id="p1z31"/>contra Illyricum in causa sacramentaria pro nobis; <lb xml:id="p1z32"/>ea res vehementer me consolatur etc.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute">Vale una cum <lb xml:id="p1z33"/>amicis nostris omnibus, quos salutabis, etiam <lb xml:id="p1z34"/>d. consules.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 16. novembris 1565.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z35"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p8009">Ioanni Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae pastori <lb xml:id="p2z4"/>fideli et vigilantissimo, <lb xml:id="p2z5"/>domino et fratri meo <lb xml:id="p2z6"/>colendo et charissimo.</s>
					<s n="20" xml:lang="la"><lb xml:id="p2z7"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
