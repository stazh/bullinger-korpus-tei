	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Hodie primum absoluta est a typographo <lb xml:id="p1z2"/>haec oratio atque in amicum <lb xml:id="p1z3"/>euntem <placeName ref="l28">Basileam</placeName>.</s>
					<s n="2" xml:lang="la">Itaque preter tuum <lb xml:id="p1z4"/>mitto duo exemplaria, quorum alterum <lb xml:id="p1z5"/>d. <persName ref="p8332">Baionensi</persName>, alterum d. <persName ref="p8296">Bassafontaneo</persName> oro <lb xml:id="p1z6"/>mittas et nuncies hodie huc nun<lb xml:id="p1z7"/>cium venisse de mortis ducis <placeName ref="l749">Saxo[niae]</placeName> <persName ref="p19065">Io<lb xml:id="p1z8"/>annis Friderici</persName> et de ux.</s>
					<s n="3" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z9"/>et salve.</s>
					<s n="4" xml:lang="la">Heri ad te scripsi.</s>
					<s n="5" xml:lang="la"><placeName ref="l512">Tubingae</placeName> <lb xml:id="p1z10"/>19. martii 1554.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>Tibi <persName ref="p495">Bulling[ere]</persName>.</s>
				</p>
			</div>
		</body>
	</text>
