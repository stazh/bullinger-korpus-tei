	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Accepi ante biduum literas tuas, compater in domino charissime, <lb xml:id="p1z2"/>una cum iis, quae <persName ref="p458">Brentio</persName> in causa <foreign xml:lang="el">τῆς πανταχουσίας</foreign> <lb xml:id="p1z3"/>respondes, pro quibus habeo tibi magnas gratias.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Obfirmavit ille non suum modo, sed et principis <lb xml:id="p1z5"/>ipsius animum in hoc dogmate, ut spes de illo <lb xml:id="p1z6"/>rectius aliquando sentiendi esse non possit.</s>
					<s n="4" xml:lang="la">Interim <lb xml:id="p1z7"/>recte facis, quod scriptis tuis non solum illi <lb xml:id="p1z8"/>respondes, sed et imperitiorum saluti consulis, ne <lb xml:id="p1z9"/>tam noxio dogmate a simplicitate fidei abducantur.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Quod Antilogiam Abrahae mei attinet, prudenter <lb xml:id="p1z11"/>mones omittenda esse, quae de <placeName ref="l18">Augustanis</placeName> con<lb xml:id="p1z12"/>cionatoribus sub finem attexuit; hoc, quaeso, <lb xml:id="p1z13"/>pro diligentia tua cures, ubi praelo subiicietur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>De concilio <placeName ref="l1107">Tridentino</placeName>, in quo antichristo cudentur <lb xml:id="p1z15"/>fulmina, quibus ecclesias Christri impetat, idem <lb xml:id="p1z16"/>prorsus quod tu sentio.</s>
					<s n="7" xml:lang="la">Dubium non est, quin <lb xml:id="p1z17"/>sancti patres sanctificaturi sint super nos bellum; <lb xml:id="p1z18"/>nanque hoc parturiunt iandudum.</s>
					<s n="8" xml:lang="la">Exitus par<lb xml:id="p1z19"/>turitiorum harum in manu dei est.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Quod me attinet, <lb xml:id="p1z20"/>non tam illorum consilia quam nostra dissidia <lb xml:id="p1z21"/>timeo; video difficillimum esse, ut simultates <lb xml:id="p1z22"/>nostrorum principum ac magistratuum tollantur, <lb xml:id="p1z23"/>per quas fit, ut quaevis respublica pro <lb xml:id="p1z24"/>se vel secura sit suis ipsius viribus innitens <lb xml:id="p1z25"/>vel, si quid consilii captat, sic captet, ut <lb xml:id="p1z26"/>reliquas nolit esse conscias.</s>
					<s n="10" xml:lang="la">Videmus <lb xml:id="p1z27"/>adversarios consilia sua communicare invicem, <lb xml:id="p1z28"/>interea nos quid?</s>
					<s n="11" xml:lang="la">Expectamus scilicet articulum <lb xml:id="p1z29"/>necessitatis ac periclitationis.</s>
					<s n="12" xml:lang="la">Dominus aperiat <lb xml:id="p1z30"/>oculos dormitantium, ut videant, et corda <lb xml:id="p1z31"/>securorum, ut intelligant et rebus tam publicis <lb xml:id="p1z32"/>quam suis christiana prudentia diligentius aliquanto <lb xml:id="p1z33"/>prospiciant.</s>
					<s n="13" xml:lang="la">Audio legatum ducis <placeName ref="l2478">Sabaudiae</placeName> <lb xml:id="p1z34"/>fuisse isthic apud vos; forsan utitur artibus, <lb xml:id="p1z35"/>quibus <persName ref="p18538">Carolus</persName> utebatur, cum bellum contra <lb xml:id="p1z36"/>nostros moliretur.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Dominus dissipet consilia principum!</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell"><lb xml:id="p1z37"/>Optime vale.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute">Saluta tuos omnes una cum <lb xml:id="p1z38"/>amicis ac fratribus.</s>
					<s n="17" xml:lang="la" ana="salute">Resalutat te reverenter <lb xml:id="p1z39"/><persName ref="p2207">Ioannes Heinrycus</persName> noster.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l41">Bernę</placeName> 62. 15. martii.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><persName ref="p8417">W[olfgangus] M[usculus]</persName> tuus in domino.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo d. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho <lb xml:id="p2z4"/>Bullingero</persName>, domino <lb xml:id="p2z5"/>compatri ac <lb xml:id="p2z6"/>fratri longe <lb xml:id="p2z7"/>charissimo.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
