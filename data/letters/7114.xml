	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literas nostras dominis colendissimis 26. aprilis scriptas 21. maii admodum <lb xml:id="p1z2"/>seri, cum primum in urbem veneram, accepi.</s>
					<s n="3" xml:lang="la">Abiendum autem mihi erat altero <lb xml:id="p1z3"/>mane; itaque negotium de pharmacopola deligendo d. <persName ref="p2899">Schenkio</persName> mandavi.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Is interea, dum abfui (redii autem ante triduum) rem omnem, quantum <lb xml:id="p1z5"/>fieri potuit, procuravit.</s>
					<s n="5" xml:lang="la">Indicavi enim ei, antequam abirem, Fischerum seu Piscatore<lb xml:id="p1z6"/>m illum, de quo ad te perscribet, commodissimum fore ad hanc rem, quantum <lb xml:id="p1z7"/>ex amicis, quos illo ipso vespero hac de re compellaram, percepi.</s>
					<s n="6" xml:lang="la"><persName ref="p2899">Schenkius</persName> <lb xml:id="p1z8"/>de omnibus abundanter ad te scribit; nihil itaque opus, ut eadem hic repetam.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z9"/>Vestrum nunc est deliberare, quid hic facere velitis.</s>
					<s n="8" xml:lang="la">Ego adolescenti, <lb xml:id="p1z10"/>cum advenerit, libenter gratificabor tui et parentis eius, licet mihi ignoti, <lb xml:id="p1z11"/>nomine, quacunque in re me opus habebit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Precor, ut balnea, quibus uti constituisti, <lb xml:id="p1z12"/>bene tibi vertant, ut sancti labores tui, quos indefesse continuas, dei <lb xml:id="p1z13"/>et patris domini nostri Iesu Christi gratia foeliciter in multorum salutem <lb xml:id="p1z14"/>absolvantur.</s>
					<s n="10" xml:lang="la">Accepi alias literas cum literis, quas hactenus misisti, prout <lb xml:id="p1z15"/>ex eis, quas ad te dedi, nondum vero tibi redditas intelligo, percipies.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z16"/>quę apud nos passim ferantur, ex inserta scheda percipies.</s>
					<s n="12" xml:lang="la">Quod de <lb xml:id="p1z17"/>consiliis principum posterioribus tuis suspicaris, suspicaris non immerito; pate<lb xml:id="p1z18"/>nt enim ista vel lippientibus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l41">Bernates</placeName> audio postulasse, ut <placeName ref="l167">Genevenses</placeName> <lb xml:id="p1z19"/>3000 <placeName ref="l862">Helvetiorum</placeName> praesidium admittant, illis alteram urbis partem trans <lb xml:id="p1z20"/>flumen tradant una cum clavibus portarum, quae res meo iudicio <lb xml:id="p1z21"/>illis non temere suspecta fuit.</s>
					<s n="14" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Datę <placeName ref="l18">Augustę</placeName> 26. maii <lb xml:id="p1z22"/>anno 1567.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z23"/>Tui observantissimus <persName ref="p3740">Georgius a Stetten</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Venerando, pio atque erudito domino <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, ecclesię <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>antistiti vigilantissimo, domino et <lb xml:id="p2z4"/>amico suo colendo.</s>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
