	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto hic tibi, colendissime domine compater, ea, quae <lb xml:id="p1z2"/>apud nos sunt nova, praesertim acta comitiorum, <lb xml:id="p1z3"/>quae ex <placeName ref="l18">Augusta</placeName> accepimus.</s>
					<s n="3" xml:lang="la">Ea lecta ad me <lb xml:id="p1z4"/>remittas, oro.</s>
					<s n="4" xml:lang="la">De <placeName ref="l303">Magdeburgensium</placeName> victoria et <lb xml:id="p1z5"/>clade <persName ref="p18250">Mauritii</persName> accepi a <persName ref="p8440">Gervasio</persName> nostro ea, quae <lb xml:id="p1z6"/>tu illi communicasti; cum his conveniebant ea, quae de his <lb xml:id="p1z7"/>quoque ad me scribebat <persName ref="p8055">Blaurerus</persName>.</s>
					<s n="5" xml:lang="la">Quidam no<lb xml:id="p1z8"/>strorum civium hisce diebus ex <placeName ref="l361">Norinberga</placeName> veniens <lb xml:id="p1z9"/>dicit vulgari fama illic ferri ducem <placeName ref="l701">Mechelburgensem</placeName> <lb xml:id="p1z10"/><placeName ref="l303">Magdeburgi</placeName> ex vulnere obiisse et <persName ref="p18716">Ericum Brunsvicensem</persName> a n<lb xml:id="p1z11"/>obile[wohl - i!] quodam captum capite plexum esse <persName ref="p18250">Mauritioque</persName> <lb xml:id="p1z12"/>maxillam alteram tormenti icto esse decussam.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Consul noster <lb xml:id="p1z14"/><persName ref="p2278">a Wattenwyl</persName> in senatu dixit non valde deinceps <lb xml:id="p1z15"/>a Caesare esse metuendum; illum enim inferis iam appropin<lb xml:id="p1z16"/>quare; habet opinor ex filio suo, qui in aula Caesaris <lb xml:id="p1z17"/>agit.</s>
					<s n="7" xml:lang="la">De <placeName ref="l2510">Turca</placeName> apparatu multa feruntur; sed nescio, <lb xml:id="p1z18"/>quam certa.</s>
					<s n="8" xml:lang="la">Hoc certum est bombardas illas Caesarea<lb xml:id="p1z19"/>nas ante aliquot menses ex <placeName ref="l2529">Brabantia</placeName> in <placeName ref="l631">Burgundiam</placeName> <lb xml:id="p1z20"/>vectas nunc in inferiores illas iterum partes reduci, <lb xml:id="p1z21"/>unde speratur Caesarem habiturum, quod cum aliis agat, <lb xml:id="p1z22"/>quo nos possimus tranquillitate frui.</s>
					<s n="9" xml:lang="la">Interea oremus <lb xml:id="p1z23"/>ad dominum sedulo, omnis pacis patrem et authorem, ut et <lb xml:id="p1z24"/>nobis et aliis illam largiri dignetur.</s>
					<s n="10" xml:lang="la">Pestis apud <lb xml:id="p1z25"/>nos nondum omnino cessavit; tertium iam ex collegio <lb xml:id="p1z26"/>nostro studiosum abripuit, unde caeteris liberum <lb xml:id="p1z27"/>factum est unicuique ad suos concedere ad aliquot dies.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z28"/>Hinc fit, ut lectiones iam vacent.</s>
					<s n="12" xml:lang="la">Quid apud <lb xml:id="p1z29"/>vos fiat, ex te cognoscere cupio.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale.</s>
					<s n="14" xml:lang="la">Salva sit <lb xml:id="p1z30"/>omnis tua familia, salvi sint quoque fratres.</s>
					<s n="15" xml:lang="la" ana="salute">Nostri omnes te <lb xml:id="p1z31"/>tuosque plurimum salutant.</s>
					<s n="16" xml:lang="la"><placeName ref="l41">Bernae</placeName> 2. februarii 1551.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z32"/>T[uus] <persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro fideli<lb xml:id="p2z2"/>ssimoque Christi et ecclesiae <lb xml:id="p2z3"/>ministro d. <persName ref="p495">Heinrycho <lb xml:id="p2z4"/>Bullingero</persName>, domino et <lb xml:id="p2z5"/>compatri suo vene<lb xml:id="p2z6"/>rando, pastori ecclesiae <lb xml:id="p2z7"/><placeName ref="l587">Tigurinae</placeName> primario.</s>
				</p>
			</div>
		</body>
