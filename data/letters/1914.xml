	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a deo patre per Christum servatorem etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Venit <lb xml:id="p1z2"/>ad me hisce diebus <persName>Thomas Albertus</persName>, olim <foreign xml:lang="el">κανονικῷ</foreign> irre<lb xml:id="p1z3"/>gularis in <placeName ref="l2440">Öningen</placeName>, nunc Christi ab aliquot annis discipulus.</s>
					<s n="3" xml:lang="la">Is <lb xml:id="p1z4"/>mihi narravit, quomodo in tumultu rusticorum fuerit plebanus in <lb xml:id="p1z5"/><placeName>Lotstetten</placeName> idque praepositi sui ordinatione, antequam plene absolutus <lb xml:id="p1z6"/>esset in pfaffum.</s>
					<s n="4" xml:lang="la">Caeterum cum per nobilium tyrannidem cogeretur <lb xml:id="p1z7"/>a sua parochia discedere denuoque rediret in <placeName ref="l2440">Öningen</placeName>, ibi prae<lb xml:id="p1z8"/>positus ipsum voluerit cogere, ut pfaffatum absolveret missaretque, cum<lb xml:id="p1z9"/>que hac in re pias ac iustas ob rationes nollet ipsi obsecundare, coa<lb xml:id="p1z10"/>ctus ex <placeName ref="l2440">Öningen</placeName> se subduxerit ad suos.</s>
					<s n="5" xml:lang="la">Olim item quaesierit per amplissimum <lb xml:id="p1z11"/>vestrum magistratum a praeposito, ut pro merito tractaretur <lb xml:id="p1z12"/>essetque, quo viveret in posterum; sed omnia frustra.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Caeterum, quid iam <lb xml:id="p1z13"/>cum ipso successore praepositurae acturus sit, ipse praesens tibi n<lb xml:id="p1z14"/>arrabit.</s>
					<s n="7" xml:lang="la">Hoc unum a me petiit, ut te orarem, quod intercedere ipsis <lb xml:id="p1z15"/>velis apud d. consulem; novit enim te multum non tantum propter <lb xml:id="p1z16"/>pietatem, sed et propter affinitatem apud ipsum posse.</s>
					<s n="8" xml:lang="la">Pollicitus est <lb xml:id="p1z17"/>ei consul operam suam, quam haud dubie praestabit eo libentius, <lb xml:id="p1z18"/>cum viderit te ipsi suffragari.</s>
					<s n="9" xml:lang="la">Tu fac, ut sentiat preces <lb xml:id="p1z19"/>meas apud te aliquid posse; sic enim utcunque tibi alioquin <lb xml:id="p1z20"/>devinctum reddes devinctiorem.</s>
					<s n="10" xml:lang="la">Novi nihil habemus, quam <lb xml:id="p1z21"/>quod miles noster 1. kalendas iulii coepit merere <persName>Gallo</persName> magno <lb xml:id="p1z22"/>nostro cum dolore.</s>
					<s n="11" xml:lang="la">Tu si quid novi habes tibique vacat, eius nos <lb xml:id="p1z23"/>certiores facias, oro.</s>
					<s n="12" xml:lang="la" ana="salute">Salutant te <persName ref="p1309">Grübelius</persName> et <persName>Iacobus</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z24"/>Vale ac vive diu foelix.</s>
					<s n="14" xml:lang="la"><placeName ref="l441">Scaffhusii</placeName> 3. iulii anno <lb xml:id="p1z25"/>1553.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z26"/>Tuus ex animo <lb xml:id="p1z27"/><persName ref="p3481">Simpertus Vogt</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctrina, candore ac pietate <lb xml:id="p2z2"/>conspicuo <persName ref="p495">Heinrycho Bul<lb xml:id="p2z3"/>lingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>antistiti vigilantissimo, <lb xml:id="p2z5"/>d. observando <lb xml:id="p2z6"/>suo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>