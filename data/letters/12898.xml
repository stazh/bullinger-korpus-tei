			<zone xml:id="p1z34-0" points="546,2566 564,2564 578,2579 601,2569 641,2603 670,2590 702,2608 773,2587 783,2601 807,2598 812,2492 760,2474 728,2492 686,2461 641,2471 601,2453 551,2471">563,2554 588,2552 613,2551 639,2551 664,2549 690,2548 715,2546 740,2544 766,2542 791,2542 817,2542</zone>
