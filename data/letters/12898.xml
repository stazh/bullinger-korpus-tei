			<zone xml:id="p1z31-0" points="359,2361 823,2287 965,2326 1026,2281 1184,2326 1469,2284 1627,2321 1725,2279 1891,2321 2039,2289 2121,2347 2216,2303 2374,2326 2374,2258 2318,2237 2263,2268 1910,2229 1870,2263 1764,2216 1451,2258 1379,2210 1216,2252 1105,2210 994,2247 802,2216 680,2268 596,2229 543,2266 359,2250">372,2312 472,2303 572,2294 673,2289 773,2285 874,2279 974,2276 1074,2277 1175,2276 1275,2273 1376,2276 1476,2276 1576,2276 1677,2278 1777,2279 1878,2282 1978,2285 2078,2290 2179,2288 2279,2291 2380,2291</zone>
			<zone xml:id="p1z32-0" points="359,2411 818,2395 931,2347 1213,2390 1374,2350 2426,2405 2426,2310 2123,2342 2036,2289 1891,2324 1725,2276 1551,2326 1474,2284 1095,2321 1023,2281 965,2326 731,2295 359,2363">372,2392 480,2378 588,2369 697,2360 805,2355 913,2348 1022,2345 1130,2339 1238,2338 1347,2339 1455,2342 1564,2345 1672,2345 1780,2348 1889,2354 1997,2355 2105,2359 2214,2366 2322,2371 2431,2383</zone>
