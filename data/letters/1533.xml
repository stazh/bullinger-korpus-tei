	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Heri tuas accepi, compater charissime, <lb xml:id="p1z2"/>una cum nummo, quem filiolo meo <persName ref="p2207">Ioanni <lb xml:id="p1z3"/>Heinricho</persName> strenuae loco misisti, pro qua <lb xml:id="p1z4"/>tibi benevolentia gratias habemus maximas.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Videtur puer singulari quadam gratia <lb xml:id="p1z6"/>praeditus; mire elegans est, delicatulus, <lb xml:id="p1z7"/>blandidulus et loquaculus; sic potissimum <lb xml:id="p1z8"/>a matre praedicatur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Caeterum, quoniam non satis contentus es scripto, <lb xml:id="p1z10"/>quod ad propositam quaestionem <lb xml:id="p1z11"/>misi, sed adhuc de eo quoque adiici <lb xml:id="p1z12"/>quedam cupis, quod ad magistratum <lb xml:id="p1z13"/>pertinet pro vera religione, si ita <lb xml:id="p1z14"/>res ferat, pugnare, ecce mitto ea quoque <lb xml:id="p1z15"/>de re sententiam meam aeque paucis <lb xml:id="p1z16"/>atque priora compraehensam, ita tamen <lb xml:id="p1z17"/>ut legas et, si qua emendanda vel <lb xml:id="p1z18"/>mutanda videbuntur, emendes ac <lb xml:id="p1z19"/>mutes, antequam aedantur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Materia <lb xml:id="p1z20"/>est invidię et indignationi potentum <lb xml:id="p1z21"/>obnoxia; quare curandum est, quoad <lb xml:id="p1z22"/>eius fieri potest, ut nec veritas <lb xml:id="p1z23"/>deseratur nec quisquam bonorum per incon<lb xml:id="p1z24"/>syderantiam aut temeritatem offendatur.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z25"/>Nemo solus satis cautus esse potest; <lb xml:id="p1z26"/>oro igitur, ut tuum quoque calculum adhibeas, <lb xml:id="p1z27"/>immo, si quid displicuerit, <lb xml:id="p1z28"/>reseces et commoditati causae attemperes<lb xml:id="p1z29"/>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Optime vale, compater in domino <lb xml:id="p1z30"/>charissime.</s>
					<s n="8" xml:lang="la" ana="salute">Salutem tuis omnibus nostro nomine, <lb xml:id="p1z31"/>item dominis ac fratribus, d. <persName ref="p8127">Pellicano</persName>, d. <persName ref="p5957">Theobaldo</persName>, <lb xml:id="p1z32"/>d. <persName ref="p8011">Gvalthero</persName>, d. <persName ref="p167">Amiano</persName>, d. <persName ref="p4554">Colino</persName>, m. <persName ref="p1214">Io[hanni] <lb xml:id="p1z33"/>Phrysio</persName> et d. <persName ref="p506">Butlero</persName>.</s>
					<s n="9" xml:lang="la">Commendo tibi <lb xml:id="p1z34"/>etiam symmystam nostrum <persName ref="p3178">Io'annem Traberum</persName> <placeName ref="l18">Augustanum</placeName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z35"/><placeName ref="l18">Augustani</placeName> in vigila na[talis] domini interimistas <lb xml:id="p1z36"/>concionatores eiectis substituerunt, e quibus <lb xml:id="p1z37"/>unus est <persName ref="p8385">Huberinus</persName>, olim diaconus meus.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z38"/>Foecundus est hodie pseudadelphorum proventus.</s>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z39"/>Rursus vale.</s>
					<s n="13" xml:lang="la"><placeName ref="l41">Bernę</placeName> 1552. 12. ianuarii.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z40"/><persName ref="p8417">W[olfgangus] Musc[ulus]</persName>, compater tuus.</s>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo <lb xml:id="p2z2"/>theologo m. <lb xml:id="p2z3"/><persName ref="p495">Heinrycho Bul<lb xml:id="p2z4"/>lingero</persName>, com<lb xml:id="p2z5"/>patri in domino <lb xml:id="p2z6"/>longe <lb xml:id="p2z7"/>charissimo.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
