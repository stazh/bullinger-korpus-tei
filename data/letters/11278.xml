	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino etc.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Quanquam non multis abhinc diebus literas<note xml:id="fn1" type="footnote" n="1">Oben <ref target="file11275">Nr. 1232</ref>.</note> ad te <lb xml:id="p1z2"/>dederim, patrone charissime, nunc tamen alias his addere non piget, ne <lb xml:id="p1z3"/>in tanto literarum mearum (quas nunc mitto) numero<note xml:id="fn2" type="footnote" n="2">Die gleichzeitig abgeschickten Briefe scheinen nicht erhalten zu sein.</note> tu meis omnino <lb xml:id="p1z4"/>careas.</s>
					<s n="3" xml:lang="la">Pristina etenim tua erga me benevolentia et amor paternus, <lb xml:id="p1z5"/>quo me prosecutus es praesentem, efficit, ut non dubitem, quin absentis <lb xml:id="p1z6"/>literę tibi gratissimę sint.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><placeName ref="l28">Basileam</placeName> me rediisse rerumque <lb xml:id="p1z7"/>statum prioribus literis exposui<note xml:id="fn3" type="footnote" n="3">Siehe oben <ref target="file11275">Nr. 1232</ref>, 12-28.</note>, quare non operae pretium puto <lb xml:id="p1z8"/>te harum rerum relatione diutius detinere.</s>
					<s n="5" xml:lang="la">Hoc unum te obsecro <lb xml:id="p1z9"/>(si modo, ut <placeName ref="l28">Basileae</placeName> maneam, tibi animus est), ut <persName ref="p4543">Ciceronem</persName> <lb xml:id="p1z10"/>meum aliaque, quę petii<note xml:id="fn4" type="footnote" n="4">Siehe ebd., Z. 29-32.</note>, ad me transmittas.</s>
					<s n="6" xml:lang="la">Cuperem etiam meam <lb xml:id="p1z11"/>habere chelim<note xml:id="fn5" type="footnote" n="5">Laute; vgl. <bibl source="b10">HBBW VIII</bibl> <ref target="file11241">[Nr. 1198]</ref>, S. 265, Anm. 11.</note>, si modo quis esset, qui aequo pretio hanc ad <lb xml:id="p1z12"/>me transferret.</s>
					<s n="7" xml:lang="la"><persName ref="p18308">Quirinus</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p18308">Quirinus von Leiden</persName>.</note> fortasse onus hoc subibit.<pb type="edition" next="76"/></s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Mitto hic tibi spheram armillarem, quam per otium, antequam <lb xml:id="p1z14"/><placeName ref="l491">Argentinam</placeName> peterem, composui, quam iam dissolutam <lb xml:id="p1z15"/>compingere poterit <persName ref="p344">Binderus</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Mittam hac aestate etiam <lb xml:id="p1z16"/>alia quędam, si modo deus meis secundus fuerit studiis.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p2553">M[artinus] Beyer</persName> <placeName ref="l157">Frankfordiam</placeName> nunc petiit<note xml:id="fn7" type="footnote" n="7">Zur Abreise <persName ref="p2553">Martin Peyers</persName> aus <placeName ref="l491">Straßburg</placeName> vgl. auch <bibl>CO</bibl> X/2 320f, <ref target="file10191">Nr. 160</ref>, und <bibl source="b422">MBW</bibl> 2156.</note>; hinc cum <persName ref="p2095">Philippo</persName> <lb xml:id="p1z18"/><placeName ref="l558">Vitembergam</placeName> abibit<note xml:id="fna" type="footnote" n="a"><hi>vor</hi> abibit <hi>gestrichenes</hi> p.</note><note xml:id="fn8" type="footnote" n="8"><persName ref="p2095">Philipp Melanchthon</persName> hielt sich anläßlich des <placeName ref="l1202">Schmalkaldischen</placeName> Bundestags bis zum 20. April in <placeName ref="l157">Frankfurt</placeName> auf (s. <bibl source="b441">MO</bibl> III 698); <persName ref="p2553">Peyer</persName> traf allerdings bereits am 12. März in <placeName ref="l558">Wittenberg</placeName> ein (s. Amerbach, Korr. VI 54).</note>.</s>
					<s n="11" xml:lang="la">Hic abiens ab <placeName ref="l491">Argentina</placeName> mihi <lb xml:id="p1z19"/>scripsit<note xml:id="fn9" type="footnote" n="9"><persName ref="p2553">Peyers</persName> Brief ist nicht erhalten.</note> rogatque, ut suo nomine te plurima salute im<lb xml:id="p1z20"/>pertiam.</s>
					<s n="12" xml:lang="la">Scripsisset ad te ipse, nisi pudor obstitisset.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/>Iniunxerat idem mihi <placeName ref="l491">Argentinę</placeName>, ut <persName ref="p4851">Froschouero</persName> scriberem, <lb xml:id="p1z22"/>ut optimae papyri, quam habet, <foreign xml:lang="de">ein rysen<note xml:id="fn10" type="footnote" n="10">Papiermaß; ein Ries entspricht 20 Buch, das sind 480 Bogen Schreibpapier oder 500 Bogen Druckpapier (s. <bibl source="b260">Grimm</bibl> II 468 und VIII 929f).</note></foreign> <placeName ref="l157">Frankfordiam</placeName> <lb xml:id="p1z23"/>advehat ibique bibliopolę <persName ref="p4983">Mauritio Golz</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p4983">Moritz Goltz (Goltze)</persName>, 1495-1548, von <placeName ref="l1726">Belzig</placeName> (<placeName ref="l3481">Kr. Potsdam-Mittelmark</placeName>, <placeName ref="l1048">Brandenburg</placeName>), war Buchführer und Verleger in <placeName ref="l558">Wittenberg</placeName>, wo er auch dem Rat angehörte. Ab etwa 1527 reiste er jeweils zur Frühjahrsmesse nach <placeName ref="l157">Frankfurt</placeName>. - Lit.: <hi>Grimm,</hi> Buchführer 1616, Nr. 663.</note> <lb xml:id="p1z24"/>eam tradat, ut <persName ref="p2553">Martino</persName> <placeName ref="l558">Witembergam</placeName> deducat.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z25"/>Solvet is, quodcunque constiterit.</s>
					<s n="15" xml:lang="la">Tu, quęso, <persName ref="p4851">Froschouerum</persName> <lb xml:id="p1z26"/>hoc roga; tuę enim preces plus quam meae proficient.</s>
					<s n="16" xml:lang="de">Bätend inn <lb xml:id="p1z27"/>allein, das er deß reinisten bapirs nemmy, so er hatt.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z28"/>Iussit<note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> Iussit <hi>ein gestrichener Wortanfang.</hi></note> etiam <persName ref="p8418">Miconius</persName>, ut suo scribam nomine, ut <lb xml:id="p1z29"/>etiam illi papyrus <placeName ref="l587">Tigurina</placeName> advehatur.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="farewell">Vale bene, <lb xml:id="p1z30"/>pater observande, et <persName ref="p8011">Rodolphum</persName> tuum semper tibi <lb xml:id="p1z31"/>commendatum habeto.</s>
					<s n="19" xml:lang="la" ana="salute">Salutabis meis verbis <persName ref="p7042">matrem</persName><note xml:id="fn12" type="footnote" ana="bio" n="12"><persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note> <lb xml:id="p1z32"/>et <persName ref="p8051">uxorem</persName><note xml:id="fn13" type="footnote" ana="bio" n="13"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> tuam cum universa familia.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l28">Basileę</placeName>, <lb xml:id="p1z33"/>ex aedibus d. <persName ref="p8418">Myconii</persName>, <lb xml:id="p1z34"/>4. martii 1539.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z35"/>Tui observantissimus</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z36"/><persName ref="p8011">Rod. Gvalterus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vere pio et erudito <lb xml:id="p2z2"/>viro M. <persName ref="p495">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/>patrono suo <lb xml:id="p2z5"/>imprimis colendo.</s>
				</p>
			</div>
