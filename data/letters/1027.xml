	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Scribere nihil potui prae negotiorum <lb xml:id="p1z2"/>turba.</s>
					<s n="3" xml:lang="la">Saltem hoc indicare volui me ac<lb xml:id="p1z3"/>cepisse tuas gratissimas prorsus.</s>
					<s n="4" xml:lang="la">Quae <lb xml:id="p1z4"/>habeo ex literis <placeName ref="l306">Mediolano</placeName> scriptis de <lb xml:id="p1z5"/>profligato exercitu Caesaris a <placeName>Barbaris</placeName> <lb xml:id="p1z6"/>et <placeName>Traguto</placeName>, recitavi fratri huic optimo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Repararunt classem Ianuae et repetierunt <lb xml:id="p1z8"/><placeName>Barbariam</placeName> spe maxima.</s>
					<s n="6" xml:lang="la">Dominus iudex est.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z9"/>aeternum.</s>
					<s n="8" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 24. septembris anno 1550.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z10"/><persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p8418">Osvaldo My<lb xml:id="p2z2"/>conio</persName>, observ<lb xml:id="p2z3"/>andissimo suo domino <lb xml:id="p2z4"/>et fratri.</s>
				</p>
				<p>
					<s n="11" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
