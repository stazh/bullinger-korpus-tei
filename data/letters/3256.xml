	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Rex <persName ref="p18477">Ferdinandus</persName> <persName ref="p2916">Schertlinum</persName> toti orbi deridendum <lb xml:id="p1z2"/>propinavit; in <lb xml:id="p1z3"/>preteritis et petenti pollicitus <lb xml:id="p1z4"/>est adversus <placeName ref="l2510">Turcam</placeName> se fore 5 millium peditum <lb xml:id="p1z5"/>fore imperatorem iunctis trecentis levioris armaturę equitibus.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z6"/>Ob id filium utrumque, capitaneos, quos diu antea novit <lb xml:id="p1z7"/>expertissimos, nobiles multos et magnam catervam <lb xml:id="p1z8"/>eorum, qui dudum veteranis sunt adscripti, convocat.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z9"/>Rex idem, quod ore petiit, etiam binis literis et postea <lb xml:id="p1z10"/>per legatum <placeName>Ylsingum</placeName>, prefectum preturę <placeName ref="l409">Ravenspurg</placeName> <lb xml:id="p1z11"/>decies confirmavit et ursit, ut se paratum <persName ref="p2916">Schertlinus</persName> <lb xml:id="p1z12"/>exhibeat et statim in militiam vocatus absque mora <lb xml:id="p1z13"/>veniat.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Milites strenui multi, imperator ipse <lb xml:id="p1z14"/>cum capitaneis se ornavit.</s>
					<s n="6" xml:lang="la">[...] et multi etiam <lb xml:id="p1z15"/>cataphracta, item vestibus pretiosioribus, catenas, <lb xml:id="p1z16"/>annulos et que alioqui non tantum ad splendorem <lb xml:id="p1z17"/>familię, sed etiam necessitatem pertinent, vendunt <lb xml:id="p1z18"/>et se paratos ad certamen reddunt.</s>
					<s n="7" xml:lang="la">Quid fit?</s>
					<s n="8" xml:lang="la">Rex <lb xml:id="p1z19"/>26. huius ad <persName ref="p2916">Schertlinum</persName> scribit, quod iam non opus <lb xml:id="p1z20"/>habeat sua opera; igitur dimittere milites <lb xml:id="p1z21"/>debeat, nec verbo mentionem facit expensarum, vel <lb xml:id="p1z22"/>quod pluribus, qui gregarios milites aluerunt, <lb xml:id="p1z23"/>aliquid rependere velit, et quod turpius, <lb xml:id="p1z24"/>addit in literis ad <persName ref="p2916">Schertlinum</persName> rex, quod dimittendos <lb xml:id="p1z25"/>ad illum a Polweil, qui delectum in <placeName ref="l1299">Riedlingen</placeName> habebat, <lb xml:id="p1z26"/>promovere et mittere velit, cum tamen rex probe <lb xml:id="p1z27"/>sciat, que iniuriarum actio inter illum a <placeName>Polweil</placeName> et <lb xml:id="p1z28"/><persName ref="p2916">Schertlinum</persName> intercedat.</s>
					<s n="9" xml:lang="la"><persName ref="p2916">Schertlinus</persName>, capitanei, veterani et <lb xml:id="p1z29"/>gregarii clamitant adversus regem, honestiores <lb xml:id="p1z30"/>lachrimis etiam testantur se poenitentia ductos ob <lb xml:id="p1z31"/>nunquam recuperandos sumptus.</s>
					<s n="10" xml:lang="la">Emerget inde <lb xml:id="p1z32"/>aliquid, quod dies patefaciet; non licet liberius <lb xml:id="p1z33"/><persName>Polweilerum</persName> vel dicunt vel simulant in <placeName ref="l808">Belgas</placeName> cum 7 m<lb xml:id="p1z34"/>illibus peditum et 1000 equitibus profecturum.</s>
					<s n="11" xml:lang="la">En, <lb xml:id="p1z35"/>mi <persName ref="p495">Bullingere</persName>, istis moribus, istis o[...]bus et imposturis <lb xml:id="p1z36"/><placeName ref="l2510">Turcam</placeName> debellaturi sumus.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Mitto ad te dialogum, ex quo intelliges, dexteritatem eorum, <lb xml:id="p2z2"/>qui exemplar honestatis esse deberent.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z3"/>Ali in <placeName ref="l822">Germania</placeName> aliquid monstri ad extirpandam libert<lb xml:id="p2z4"/>atem putant multi, et multa hoc futurum testantur.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p2z5"/>De bello <placeName ref="l834">Italico</placeName> multi multa dicunt; victricia <lb xml:id="p2z6"/>arma <placeName ref="l832">Gallo</placeName> attribuunt, qui multum aeris apud <lb xml:id="p2z7"/>eum deposuerunt, trophaeum <placeName ref="l850">Austriaco</placeName> assignant, <lb xml:id="p2z8"/>qui multum lucri ex eo emulgendum sperant.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z9"/>In <placeName ref="l808">Belgis</placeName> tres sunt ordines, prior sub principe <lb xml:id="p2z10"/><placeName ref="l2478">Sabaudiensi</placeName> <placeName>Marięburgum</placeName> delebit, alter in <lb xml:id="p2z11"/><placeName ref="l631">Burgundios</placeName> proficiscetur, rex <persName>Philippus</persName> cum <placeName ref="l830">Anglis</placeName>, <lb xml:id="p2z12"/><placeName ref="l640">Flandris</placeName> et <placeName ref="l20">Hollandis</placeName> dicitur in <placeName ref="l832">Galliam</placeName> irrumpere.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z13"/>Hoc ut succedat, tempus declarabit.</s>
					<s n="17" xml:lang="la">Certum hoc <lb xml:id="p2z14"/>habeo: pontificio spiritu hactenus nihil egregii ab <lb xml:id="p2z15"/>utraque parte designatum, nisi quod miseros <lb xml:id="p2z16"/>et innocentes subditos miserrime dilaniarunt <lb xml:id="p2z17"/>et eorum corpora, bona, animas et fortunas diripuerunt, <lb xml:id="p2z18"/>honestatem muliebr[.]m prostituerunt et, uno verbo <lb xml:id="p2z19"/>dicam, virilem togam muliebrem stolam <lb xml:id="p2z20"/>reddiderunt.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z21"/>De colloquio nihil habeo, quod utile fore <lb xml:id="p2z22"/>adfirmem.</s>
					<s n="19" xml:lang="la"><lb xml:id="p2z23"/>Filii mei <persName>Raphaelis</persName> res ut se habeat, <lb xml:id="p2z24"/><persName>Petrus</persName> noster exponet.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Puer iunior in literis <lb xml:id="p2z25"/>pulchre progreditur.</s>
					<s n="21" xml:lang="la"><lb xml:id="p2z26"/>Filius tuus etiam meus innocenter et pie vivit.</s>
					<s n="22" xml:lang="la"><lb xml:id="p2z27"/>Dabo operam, ut cum tempore olerum artificia exploret.</s>
					<s n="23" xml:lang="la"><lb xml:id="p2z28"/>Erit is mihi commendatissimus.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p2z29"/><persName>Petrus</persName> optimus homo est; cum timore domini <lb xml:id="p2z30"/>magnam in officio suo habet sedulitatem; fac ut <lb xml:id="p2z31"/>cito redeat.</s>
					<s n="25" xml:lang="la" ana="salute"><persName ref="p1283">Gesnerum</persName> saluta; huis duos mitto <lb xml:id="p2z32"/>pisces.</s>
					<s n="26" xml:lang="la" ana="farewell">Iterum vale.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><placeName ref="l18">Auguste</placeName> ocyssime 1. augusti <lb xml:id="p2z33"/>anno etc. <pb/><lb xml:id="p3z1"/>57.</s>
					<s n="28" xml:lang="la"><persName ref="p2856">G[ereon]</persName> t[<pb/><lb xml:id="p4z1"/>uus].</s>
				</p>
				<p>
					<note type="address">[Adresse von anderer Hand:]</note>
					<s n="29" xml:lang="la"><lb xml:id="p4z2"/>Doctissimo atque ornatissimo viro d. <lb xml:id="p4z3"/>d. <persName ref="p495">Hainrico Bullingero</persName>, unico suo colendissimo.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
