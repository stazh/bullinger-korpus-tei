	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. E <placeName ref="l55">Bononia</placeName> allata est epistola mihi a mercatore quodam, quae tibi erat inscripta.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Orabar autem, ut ad te bona fide curarem perferendam.</s>
					<s n="3" xml:lang="la">Reddet eam <persName ref="p8199">Ioannes <lb xml:id="p1z3"/>Chuͦnradus Escherus</persName>, abbatis praefectus, nec erat aliud praeterea, quod <lb xml:id="p1z4"/>scriberem, nisi ut <persName ref="p8417">Musculi</persName> tibi caussam commendarem, quo cum legato e <placeName ref="l41">Bern<lb xml:id="p1z5"/>a</placeName> venturo suo nomine, qua tu pro amicis soles, diligentia ageres.</s>
					<s n="4" xml:lang="la">Vix ferri <lb xml:id="p1z6"/>enim arbitrarer expensa in familia tam numerosa, si largitorem nullum <lb xml:id="p1z7"/>habeamus aut operae precium nullum respondeat.</s>
					<s n="5" xml:lang="la">Scribo haec haud ea <lb xml:id="p1z8"/>quidem de caussa, quod vel dubitem de tua fide vel illo inhortante <lb xml:id="p1z9"/>sim invitatus ad te monendum, sed quod in hominem tam eruditum <lb xml:id="p1z10"/>et tam candide pium non possim non esse animo propensissimo.</s>
					<s n="6" xml:lang="la">Quodsi quid <lb xml:id="p1z11"/>tu meis literis vel ad senatum <placeName ref="l41">Bernensem</placeName> vel privatim ad senatores aliquos <lb xml:id="p1z12"/>impetraturum sperares, equidem nullam operam detrectarem; ad gratifican<lb xml:id="p1z13"/>dum enim viro tanto omnino sum paratus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>De conventu illo urbium auspicata mihi omnia polliceor; tantum cura, ne fatalis <lb xml:id="p1z15"/>illa et vere proditoria vox feratur in agro vestro: <foreign xml:lang="de">wir wellend von dess <lb xml:id="p1z16"/>gloubens wegen kheinen krieg haben.</foreign></s>
					<s n="8" xml:lang="la">Nihil enim dubito, quin, si Caesar venenum <lb xml:id="p1z17"/>illud assuetae malevolentiae sit in nostram libe[r] tatem effusurus, frustra <lb xml:id="p1z18"/>illi bellum pro religione suscipiendum detrectent, qui, si modo aras suas et <lb xml:id="p1z19"/>focos, ut aiunt, salvos velint, pro libertate sint certo bellaturi, qui fidei <lb xml:id="p1z20"/>libertatem aestimant tam levi.</s>
					<s n="9" xml:lang="la" ana="salute">Sed dominus haec omnia dispensabit nostram <lb xml:id="p1z22"/>in salutem; id enim ex animo precabimur.</s>
					<s n="10" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l473">Sangalli</placeName>, XIIII novembris, <lb xml:id="p1z23"/>anno MDXLVIII.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p8049">Ioachimus Vadianus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro domino <persName ref="p495">Henrycho <lb xml:id="p2z2"/>Bullingero</persName>, amplissimae urbis <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> episcopo, domino suo inprimis <lb xml:id="p2z4"/>colendo.</s>
				</p>
			</div>
		</body>
	</text>
