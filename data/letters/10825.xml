	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Equidem satis risi, quia scribis de vinculis papae caesari paratis<note xml:id="fn1" type="footnote" n="1">Siehe oben <ref target="file10822">Nr. 783</ref>, 18-20.</note>.</s>
					<s n="3" xml:lang="la">Timeo, ne <lb xml:id="p1z3"/>verum sit facinus tam nobile.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><placeName ref="l491">Argentinensium</placeName> confessionem<note xml:id="fn2" type="footnote" n="2">Die Confessio <placeName ref="l894">Tetrapolitana</placeName>; s. ebd., Z. 7-17 mit Anm. 3.</note> aliquando vidi, de apologia<note xml:id="fn3" type="footnote" n="3"><persName ref="p467">Bucers</persName> Apologie der Tetrapolitana; s. ebd., Anm. 4.</note> ne <lb xml:id="p1z4"/>verbum quidem audivi unquam.</s>
					<s n="5" xml:lang="la"><placeName ref="l28">Basileae</placeName> nec confessio est nec apologia.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quod <lb xml:id="p1z5"/>et rarius et brevius scribo, quęso, ne te moveat.</s>
					<s n="7" xml:lang="la">Aliter hoc tempore non valeo.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z6"/>Dabitur, ut omnia sarciam.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Naufragium librarii quidam fecerunt infra <placeName ref="l491">Argentinam</placeName><note xml:id="fn4" type="footnote" n="4">Über das Unglück, das den Buchhändlern offenbar auf dem Weg zur <placeName ref="l157">Frankfurter</placeName> Frühjahrsmesse zugestoßen war, ist nichts Näheres bekannt.</note>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z7"/>Grave dicunt, at nondum constat, quibus id mali acciderit.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><persName ref="p1365">Grynęus</persName> <lb xml:id="p1z8"/>theologus factus in praelegendo novo testamento mihi successit<note xml:id="fn5" type="footnote" n="5">Vgl. oben <ref target="file10815">Nr. 777</ref>, 19-21 mit Anm. 7.</note>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z9"/>Raptim, <placeName ref="l28">Basileae</placeName>, 7. aprilis anno 36.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z10"/>Tuus <persName ref="p8418">Myco<lb xml:id="p1z11"/>nius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/>fratri in domino charissimo <lb xml:id="p2z3"/>suo.</s>
				</p>
			</div>
		</body>
	</text>
