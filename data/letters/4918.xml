	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ego (reverende in Christo pater) cum domino <persName>Philippo</persName> <lb xml:id="p1z2"/>in proximum pagum avocor, ut ibi fratri iure agenti causam <lb xml:id="p1z3"/>contra sacrificulos adsimus, ideoque brevior sum, quam velim.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Pontificis et <persName>Philippi</persName> legati adhuc expectantur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Scripserat <lb xml:id="p1z5"/><persName>Iodocus Tschudius</persName> ad magnum virum <placeName ref="l2592">Superioris Foederis</placeName> <lb xml:id="p1z6"/>nescio quae vana nova aut ab aliis conficta aut <lb xml:id="p1z7"/>ab illo ipso; fingit tamen se <placeName ref="l760">Soloturi</placeName> audisse ex <persName ref="p8354">Frölichio</persName>.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Summa autem literarum (quas ipse legi) haec fuit: <persName>Philippum</persName> <lb xml:id="p1z9"/>cohortatum <persName ref="p20341">Galliae regem</persName> <lb xml:id="p1z10"/>et proceres eius regni per suos legatos, ut ad ecclesię sinum <lb xml:id="p1z11"/>redeant; quod ni fecerint, se extrema tentaturum, ex eoque <lb xml:id="p1z12"/>a rege et parlamento decretum esse, ut omnes Lutherani <lb xml:id="p1z13"/>intra mensem <placeName ref="l832">Gallia</placeName> excedant capitis poena illis <lb xml:id="p1z14"/>denunciata, qui post mensem deprehenderentur.</s>
					<s n="6" xml:lang="la">Religionis <lb xml:id="p1z15"/>vero negotium ad concilium <placeName ref="l1107">Tridentinum</placeName> reiectum, quo et <lb xml:id="p1z16"/><persName ref="p18575">Philippus</persName> rex suos proceres ecclesiasticos mittere cogitet <lb xml:id="p1z17"/>circa medium augusti.</s>
					<s n="7" xml:lang="la">Scribere praeterea episcopum <placeName>Tarracinum</placeName>, <lb xml:id="p1z18"/>qui legationem in <placeName ref="l875">Hispania</placeName> obeat, <persName ref="p18090">regem Navarr<lb xml:id="p1z19"/>ae</persName> Lutheranam illam sectam abiurasse et cum rege <lb xml:id="p1z20"/><persName ref="p18575">Philippo</persName> in pristinam gratiam rediisse.</s>
					<s n="8" xml:lang="la">Post haec ille <lb xml:id="p1z21"/>artifex addit sibi certis et idoneis testibus compertum pontificis <lb xml:id="p1z22"/>et <persName ref="p18575">Philippi</persName> legatos propediem affuturos; rogare se, ut <lb xml:id="p1z23"/>benigne audiantur.</s>
					<s n="9" xml:lang="la">Haec se scribere singulari amore <lb xml:id="p1z24"/>adductum, quo erga <placeName ref="l648">Rhetiam</placeName> afficiatur; timere enim <lb xml:id="p1z25"/>se nescio quos motus bellicos, qui impendeant, <lb xml:id="p1z26"/>nisi Rheti legatis obsequantur.</s>
					<s n="10" xml:lang="la">Haec literarum summa est.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z27"/>Quae per omne <placeName ref="l2592">Superius Foedus</placeName> ita sunt divulgatę, ut <lb xml:id="p1z28"/>fere nemo sit, qui exemplar literarum non ipse inspexerit.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z29"/>Facile autem tu pro tua prudentia intelligis, quorsum haec <lb xml:id="p1z30"/>omnia.</s>
					<s n="13" xml:lang="la">Comitia celebrabuntur non <placeName ref="l98">Curiae</placeName>, sed <placeName ref="l1103">Ilantii</placeName>, <lb xml:id="p1z31"/>loco illis hominibus apprime ad hoc unum institutum <lb xml:id="p1z32"/>idoneo.</s>
					<s n="14" xml:lang="la">Haec cum ita sint (reverende in Christo pater), <pb/><lb xml:id="p2z1"/>cupio omnino ex te scire, quid in <placeName ref="l832">Gallia</placeName> agatur, quo male<lb xml:id="p2z2"/>volis os obstruere et bonos in spem meliorem erigere poss[im].</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z3"/>Scripsit quidem affinis meus quaedam, sed obscurius; existimo illum ips[um] <lb xml:id="p2z4"/>negotium non intellexisse.</s>
					<s n="16" xml:lang="la">Sed per idem tempus accepi literas <placeName ref="l28">Basilea</placeName> <lb xml:id="p2z5"/>14. augusti scriptas a d. d. <persName ref="p1327">Gratarolo</persName>, quae testantur in <placeName ref="l832">Gallia</placeName> omnia <lb xml:id="p2z6"/>salva esse.</s>
					<s n="17" xml:lang="la">Haec scripsi subito; nunc enim a domino <persName>Philippo</persName> <lb xml:id="p2z7"/>(qui et te salvum cupit) ad iter evocor.</s>
					<s n="18" xml:lang="la" ana="farewell">Vale, reverende in Christo pate<lb xml:id="p2z8"/>r, cum tuis omnibus quam diutissime et felicissime.</s>
					<s n="19" xml:lang="la">Quod <lb xml:id="p2z9"/>mones, vigilabimus memores interim illius: Nisi dominus <lb xml:id="p2z10"/>custodierit civitatem, frustra vigilat, qui custodit eam.</s>
					<s n="20" xml:lang="la">Qui et rogandus <lb xml:id="p2z11"/>est, ut ipse nostros conatus fortunet.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l98">Curię</placeName> 18. augusti anno domini 1561.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p2z12"/>Tui observantissimus <persName ref="p8009">Ioannes Fabricius</persName>.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Amplissimo viro d. <persName ref="p495">Heinrycho Bul<lb xml:id="p2z13"/>lingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> antistiti vigilantissimo, domino <lb xml:id="p2z14"/>suo.</s>
				</p>
				<p>
					<s n="24" xml:lang="de"><placeName ref="l587">Zürych</placeName>.</s>
				</p>
			</div>
		</body>
