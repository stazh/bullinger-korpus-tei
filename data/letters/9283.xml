	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Gratia et pax a deo per d Iesum
					<lb xml:id="p1z2"/>oti, quem oro, ut te quam diutissimu
					<lb xml:id="p1z3"/>imcolumem praestet et sanctissimis labiru
					<lb xml:id="p1z4"/>suis benedicat in utilitatem ecclesiae
					<lb xml:id="p1z5"/>siae. Amen.
					<lb xml:id="p1z6"/>senerande pater et Ricosrum occupi
					<lb xml:id="p1z7"/>oggnogi arrupis estvog paripam
					<lb xml:id="p1z8"/>heess is pegrois coors possts
					<lb xml:id="p1z9"/>literas tuas, quibus mihi Henricum Frisium
					<lb xml:id="p1z10"/>ero commendas, magna
					<lb xml:id="p1z11"/>noluptate perlegi et gaudeo ex intimo pectori
					<lb xml:id="p1z12"/>quod me absentem nec visum hactenus tuo
					<lb xml:id="p1z13"/>amore et amicitia dignaris, quam tanti facia
					<lb xml:id="p1z14"/>n nihil mihi hactenus aviderit gratius et
					<lb xml:id="p1z15"/>iuundius. Etsi autem par fuisset, ut stalim
					<lb xml:id="p1z16"/>rescripsissem literis tuis, id tamen nondum
					<lb xml:id="p1z17"/>praestari a me potuit, quod tabellariorum
					<lb xml:id="p1z18"/>penuria et loci intervallunt omnem occasio.
					<lb xml:id="p1z19"/>scribendi praecipiat. Nunc cum time
					<lb xml:id="p1z20"/>vestri vestraeque ecclesiae alumni ex academia
					<lb xml:id="p1z21"/>Vitebergensi discedant, nolui committere, ut
					<lb xml:id="p1z22"/>sine meis literis abirent; Magna enim mihi
					<lb xml:id="p1z23"/>intercessit cum ipsis necessitudo et suavissimi
					<lb xml:id="p1z24"/>familiaritas, praesertim vero Iovani Hik
					<lb xml:id="p1z25"/>propter singularem animi sinteri et aperti
					<lb xml:id="p1z26"/>constantiam, quae vere Germanicae gentis
					<lb xml:id="p1z27"/>propria est, dilexi plurimum et ad
					<lb xml:id="p1z28"/>cupio omnibus tenui opella mea provitissimi
					<pb/>
					<lb xml:id="p2z1"/>prodesse. C. d. d. Prucerus per fratres menses
					<lb xml:id="p2z2"/>gravissime decubuit, adeo, ut etiam de vita ipsius
					<lb xml:id="p2z3"/>desperaretur, sed exaudivit divina clementia vota
					<lb xml:id="p2z4"/>piorum et resperit salutem academiae, quae mais
					<lb xml:id="p2z5"/>tuo praesidi, erba hoc viro, destitueretur Uingen
					<lb xml:id="p2z6"/>et Heslusius post mortem principis, Ioannis
					<lb xml:id="p2z7"/>Guithemi tertia iam vice lena discedere sint
					<lb xml:id="p2z8"/>acti curante id electore Saxoniae, quem iussi,
					<lb xml:id="p2z9"/>loniciis immeritum impetuit. Status
					<lb xml:id="p2z10"/>academiae nostrae iam tranquillior est, quammi
					<lb xml:id="p2z11"/>metuendum sit, ne inquieta et turbulenta ingenia
					<lb xml:id="p2z12"/>nevos tumultus conitent. Bevale venerande
					<lb xml:id="p2z13"/>pater et me amare perge. Babantur raplim vito
					<lb xml:id="p2z14"/>die aprilis, quo dicnuntur habita fuis,
					<lb xml:id="p2z15"/>se comitia eligendo regi Poloniae anno salu.
					<lb xml:id="p2z16"/>54.
					<lb xml:id="p2z17"/>Tu venerandae pafervit.
					<lb xml:id="p2z18"/>subiectissimu filius
					<lb xml:id="p2z19"/>Philippus Theodorus.
					<lb xml:id="p2z20"/>Noribergensis
					<pb/>
					<lb xml:id="p4z1"/>Pietate et eruditione
					<lb xml:id="p4z2"/>Virtute ac dignitate clai
					<lb xml:id="p4z3"/>viro domino
					<lb xml:id="p4z4"/>Henrico Bullingero,
					<lb xml:id="p4z5"/>sanctae theologiae
					<lb xml:id="p4z6"/>doctori et professori
					<lb xml:id="p4z7"/><placeName ref="l587">Tiguri</placeName>, domino et
					<lb xml:id="p4z8"/>parenti suo cum brb
					<lb xml:id="p4z9"/>servantia colendo.
					<lb xml:id="p4z10"/>zu
				</p>
			</div>
