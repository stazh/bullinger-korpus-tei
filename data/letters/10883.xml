			<zone xml:id="p2z7-0" points="2576,1640 2873,1613 3095,1651 3169,1626 3216,1665 3329,1607 3505,1660 3506,1555 3152,1533 2935,1587 2834,1553 2725,1601 2576,1598">2582,1630 2628,1624 2674,1622 2720,1618 2767,1617 2813,1614 2859,1614 2906,1613 2952,1612 2998,1612 3045,1612 3091,1614 3137,1613 3183,1610 3230,1609 3276,1609 3322,1606 3369,1606 3415,1603 3461,1606 3508,1615</zone>
