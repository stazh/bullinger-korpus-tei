	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Claris<lb xml:id="p1z2"/>sime <persName ref="p495">Bullingere</persName>.</s>
					<s n="3" xml:lang="la">Is d. <persName>Antonius</persName>, qui <lb xml:id="p1z3"/>has literas reddet, fuit apud [me] per men<lb xml:id="p1z4"/>sem; nunc ob negotia quaedam sua in <lb xml:id="p1z5"/><placeName ref="l834">Italiam</placeName> redit.</s>
					<s n="4" xml:lang="la">Te inviset, ut <persName ref="p495">Bullingerum</persName> <lb xml:id="p1z6"/>illum illum facie agnoscat, quem <lb xml:id="p1z7"/>tamen iamdudum norat.</s>
					<s n="5" xml:lang="la">Commendo eum <lb xml:id="p1z8"/>tibi, si qua in re potes prodesse.</s>
					<s n="6" xml:lang="la">Vir est <lb xml:id="p1z9"/>pius et prudens.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Aliis in literis, quas <lb xml:id="p1z10"/>alius, qui cum eo est, tibi tradet seor<lb xml:id="p1z11"/>sim, fusius scribo et de multis quidem.</s>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z12"/>Vale et salve.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l512">Tubingae</placeName> 6. septembris 1554.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <persName ref="p495">Heinrico <lb xml:id="p2z2"/>Bulinghero</persName>, fratri honoran<lb xml:id="p2z3"/>do.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
