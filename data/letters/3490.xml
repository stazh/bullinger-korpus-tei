	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. Accepi binas a te duarum chorarum spacio, alteras
					<lb xml:id="p1z2"/>a d. Sulcero, alteras a d. Vincentio Madio
					<lb xml:id="p1z3"/>uatranque tenoris de libello Theodori
					<lb xml:id="p1z4"/>nostri de ratione temporum, quem mihi tanto
					<lb xml:id="p1z5"/>commendas et reipblicae plurimum profuturam eius
					<lb xml:id="p1z6"/>editionem affirmas, petisque, ut statim respondu
					<lb xml:id="p1z7"/>an excudere illum hoc tempore velim ac
					<lb xml:id="p1z8"/>ssAgo igitur gratias tibi, mi d. Bullingere,
					<lb xml:id="p1z9"/>qui mearum rerum tam seriam curam agas,
					<lb xml:id="p1z10"/>ut omni occasione consulere rationibus nostris coneris
					<lb xml:id="p1z11"/>Quod vero ad ipsum d. Theodori nostri librum attinat,
					<lb xml:id="p1z12"/>facile persuadeor, ut in eo excudendo vobis grat
					<lb xml:id="p1z13"/>iutcunque alioqui occupatus hoc temporo  abso
					<lb xml:id="p1z14"/>aliorum libris, quibus opera Locarethac hyeme
					<lb xml:id="p1z15"/>oportuit. Sed spero me omnibus, qua iampridem sunt cepi
					<lb xml:id="p1z16"/>intra paucas septimnes absolvendis suffer.
					<lb xml:id="p1z17"/>ut quod reliquu est temporis etiam isti
					<lb xml:id="p1z18"/>excudendo pulchre impendi possit. Gaudebo
					<lb xml:id="p1z19"/>autm oblatam mihi esse occasionem tam gratificandi
					<lb xml:id="p1z20"/>tandem aliquando ipsi d. Theodoro nostro, quam
					<lb xml:id="p1z21"/>nescio qua sine mea sie cusqum allerius culpa offeria.
					<lb xml:id="p1z22"/>sum mihi hactenus ex nimis diuturno erga me
					<lb xml:id="p1z23"/>silentio suspicatus sum, quam etiam mea hac qualicunque
					<lb xml:id="p1z24"/>opella reipublicae literariae commodandi, ac libenter domi
					<lb xml:id="p1z25"/>meae non apud alium, ut quam fieri potest optime excuat.
					<lb xml:id="p1z26"/>omnem operam dabo. Bene vale et d. Theodoro
					<lb xml:id="p1z27"/>plurims meo nomine salutem dicito et quod non ad ipsumues
					<lb xml:id="p1z28"/>etiam scripserim excusato. Vix enim hęc licuit, Brachio dextro
					<lb xml:id="p1z29"/>Qnodum satis adhuc contienato. Salutem omnibus tuo nomine, quibs iussisti
					<pb/>
					<lb xml:id="p2z1"/>domino Henrico
					<lb xml:id="p2z2"/>Bullingero, ecclesię
					<lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> pastori
					<lb xml:id="p2z4"/>vigilantissimo atque d
					<lb xml:id="p2z5"/>ptissimo, domino et amico
					<lb xml:id="p2z6"/>suo inprimis
					<lb xml:id="p2z7"/>colendo.
					<lb xml:id="p2z8"/>Tiguri.
				</p>
			</div>
		</body>
	</text>
