					<lb xml:id="p1z4"/>Bezae, ad d. Bullingerum
					<lb xml:id="p1z5"/>Genevae 27. iulii.
					<lb xml:id="p1z6"/>noster quaria huius mensis iuli
					<lb xml:id="p1z7"/>victoriam nimium fervidus persequium
