	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Ornatissime domine, nudiustertius accepi per postam fasciculum <lb xml:id="p1z2"/>tuum cum literis domini <persName ref="p3375">Vergerii</persName>.</s>
					<s n="2" xml:lang="la">Nunc fuit mihi allatus iste, quem hic <lb xml:id="p1z3"/>intus invenies cum altero regis, undenam ignoro.</s>
					<s n="3" xml:lang="la">Nihil novi <lb xml:id="p1z4"/>habeo.</s>
					<s n="4" xml:lang="la">Dominus orator<note type="margin">a.R.: <persName ref="p8296">Seb. de l'Aubespine</persName></note> est brevi redditurus.</s>
					<s n="5" xml:lang="la">Si quid est, quod eo <lb xml:id="p1z5"/>absente possim nomine tuo, iube, domine, et paratum me habebis, et si quid <lb xml:id="p1z6"/>novarum tibi occurrerit, significando, si placet ad eum, quem primum <lb xml:id="p1z7"/>mittam.</s>
					<s n="6" xml:lang="la" ana="farewell">Bene vale, mi domine observande.</s>
					<s n="7" xml:lang="la">Datum 25a ianuarii.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z8"/>Tuus in omnibus observantissimus <lb xml:id="p1z9"/><persName ref="p1895">Robertus le gras</persName>.</s>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Egregio atque doctissimo viro domino <lb xml:id="p2z2"/>d. <persName ref="p495">Bulingero</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
