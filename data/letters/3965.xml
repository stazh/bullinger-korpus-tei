	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Humanissimas tuas literas <persName ref="p8391">Iuellus</persName> et ego initio aprilis accepimus; ex quibus <lb xml:id="p1z2"/>perspexi, te ad tempus constitutum filium tuum <persName ref="p477">Rodolphum</persName>, ob ingenii cultum <lb xml:id="p1z3"/>capescendum, ad academiam <placeName ref="l376">Oxoniensem</placeName> missurum.</s>
					<s n="2" xml:lang="la">Cuius (ut nunc sunt res) <lb xml:id="p1z4"/>ego author tibi esse nolim.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Nam adhuc spelunca est tenebrarum, tenebrionum, <lb xml:id="p1z5"/>latronum.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Pauci illic sunt evangelici, plurimi papistae.</s>
					<s n="5" xml:lang="la">Sed cum reformata <lb xml:id="p1z6"/>fuerit (quod brevi futurum et speramus et optamus) tum demum veniat <lb xml:id="p1z7"/>tuus <persName ref="p477">Rodolphus</persName>.</s>
					<s n="6" xml:lang="la">Quam gratus futurus sit mihi illius in <placeName ref="l830">Angliam</placeName> <lb xml:id="p1z8"/>adventus, iam nihil dicam.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Malim animi mei in illum gratitudinem <lb xml:id="p1z9"/>re quam verbis exprimere etc.</s>
					<s n="8" xml:lang="la">Liber communium precum, temporibus <persName ref="p3207">Edouardi</persName> <lb xml:id="p1z10"/>regis usitatus, nunc iterum per totam <placeName ref="l830">Angliam</placeName> in usu passim est, [et] ubique <lb xml:id="p1z11"/>erit, renitentibus atque reclamantibus pseudoepiscopis.</s>
					<s n="9" xml:lang="la">Regina caput ecclesiae <lb xml:id="p1z12"/><placeName ref="l830">Anglicanae</placeName> dici non vult, tametsi hic titulus illi oblatus sit, sed guber<lb xml:id="p1z13"/>natricis titulum libenter recepit; qui in idem recidunt.</s>
					<s n="10" xml:lang="la">Papa ex <lb xml:id="p1z14"/><placeName ref="l830">Anglia</placeName> denuo est profligatus, moerentibus episcopis et universa rasorum <lb xml:id="p1z15"/>colluvie.</s>
					<s n="11" xml:lang="la">Missae sunt abrogatae.</s>
					<s n="12" xml:lang="la">8. mai parliamentum est finitum.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><persName>Comes <lb xml:id="p1z16"/>Bedfordiensis</persName> tres coronatos nostro <persName ref="p8466">Wolphgango</persName> donavit.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">In hoc ille <lb xml:id="p1z17"/>felicior multis aliis.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Qui posthac fient episcopi, nullas habebunt arces, <lb xml:id="p1z18"/>praedia, villas.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Qui nunc sunt, iis quae habent, donec vixerint, fruentur: <lb xml:id="p1z19"/>digni, qui non solum ab officio, sed et capistro suspendantur.</s>
					<s n="17" xml:lang="la">Sunt enim <persName>Davi</persName> (<persName>Dani?</persName>)<lb xml:id="p1z20"/>, interturbantes omnia.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Monasteria brevi dissolventur.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Plura iam scribere non <lb xml:id="p1z21"/>possum.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Nam intra quatriduum in solo natali cum pessimis bestiis <persName>Arrianis</persName> <lb xml:id="p1z22"/>et e pulpito et mutuis colloquiis est mihi conflictandum: in quem finem <lb xml:id="p1z23"/>eruditissimum tuum librum de utraque in Christo natura diligenter evolvi.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z24"/>Spero me satis instructum in aciem venturum, atque adeo hostes Christi <lb xml:id="p1z25"/>debellaturum.</s>
					<s n="22" xml:lang="la">Vivit Christus, regnat et regnabit<note xml:id="fn1" type="footnote" n="1">Anklang an den aus der römischen Messe bekannten Orationsschluß (vgl. Gwalther an HB, 3. Okt. 1538).</note> invitis Arrianis, Ana<lb xml:id="p1z26"/>baptistis et papistis.</s>
					<s n="23" xml:lang="la" ana="farewell">Vale, vir praestantissime atque animo meo charissime!</s>
					<s n="24" xml:lang="la"><lb xml:id="p1z27"/>Optimam tuam coniugem, filios, filias, et generosissimos tuos generos <lb xml:id="p1z28"/>meo nomine salutatibus (ut sic dixerim) adobruito.</s>
					<s n="25" xml:lang="la">Gratissimam rem mihi <lb xml:id="p1z29"/>fecit bonus <persName ref="p1884">Lavaterus</persName>, qui tam bonum libellum, eumque totum <placeName ref="l587">Tigurinum</placeName>, <lb xml:id="p1z30"/>ad me miserit.</s>
					<s n="26" xml:lang="la" ana="salute">Salutabis mihi d. <persName ref="p8171">Bibliandrum</persName>, <persName ref="p4554">Collinum</persName>, <persName ref="p1453">Hallerum</persName>, <persName ref="p3988">Wolphium</persName>, <lb xml:id="p1z31"/><persName ref="p8461">Wickium</persName>, <persName ref="p1214">Frisium</persName>, <persName ref="p2336">Bernardinum</persName>, <persName ref="p167">Ammianum</persName>, <persName>Meyerum</persName>, <persName ref="p2916">Sebastianum</persName>, <persName>Colerum</persName>, <lb xml:id="p1z32"/><persName ref="p1234">Funckium</persName>, <persName ref="p8127">Pellicanum</persName>, <persName ref="p1227">Froschouerum</persName> et omnes.</s>
					<s n="27" xml:lang="la" ana="salute">Uxor mea te, tuam, tuos, tuas, <lb xml:id="p1z33"/>et omnes salutat.</s>
				</p>
				<p>
					<s n="28" xml:lang="la">Saepe erumpunt illi lachrymae, cum de foeminis <placeName ref="l587">Tigurinis</placeName> <lb xml:id="p1z34"/>fit mentio.</s>
					<s n="29" xml:lang="la">Vestris magnificis magistratibus, urbi, atque adeo toti <lb xml:id="p1z35"/><placeName ref="l587">Tig[urinae]</placeName> ditioni omnia felicissima precor.</s>
					<s n="30" xml:lang="la"><lb xml:id="p1z36"/>Urbs <placeName ref="l587">Tigurina</placeName>, vale: valeant male, prospera cuncta <lb xml:id="p1z37"/>Qui tibi non optent.</s>
				</p>
				<p>
					<s n="31" xml:lang="la" ana="farewell">Urbs <placeName ref="l587">Tigurina</placeName>, vale.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><lb xml:id="p1z38"/>Raptim.</s>
				</p>
				<p>
					<s n="33" xml:lang="la"><placeName ref="l296">Londini</placeName>, 21 maii, 1559.</s>
				</p>
				<p>
					<s n="34" xml:lang="la"><lb xml:id="p1z39"/>Tuissimus, <persName ref="p2473">Ioannes Parkhurstus</persName>.</s>
				</p>
				<p>
					<s n="35" xml:lang="la"><pb/><lb xml:id="p2z3"/>Praeclarissimo viro d. <lb xml:id="p2z4"/><persName ref="p495">Henricho Bullingero</persName>.</s>
				</p>
				<p>
					<s n="36" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
