	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literas tuas novissimas accepi, meis inclusas ad d. <persName>Baionensem</persName> scriptas; illi <lb xml:id="p1z2"/>fideliter eadem hora sunt redditae, scribae quidem ipsius; nam ipse <persName>Davasi<lb xml:id="p1z3"/>i</persName> erat in comiciis.</s>
					<s n="3" xml:lang="la">Foedera nostra milites illi concesserunt, si quidem <lb xml:id="p1z4"/>illos velit iuxta convencionem ac pacta inter nos et regem.</s>
					<s n="4" xml:lang="la">Cunctatur <lb xml:id="p1z5"/>illos abducere; nam illi sapientes nostri annuerunt, eciamsi <placeName ref="l862">Helvecii</placeName> <lb xml:id="p1z6"/>nondum annuerint; tam obsequentes sumus illi.</s>
					<s n="5" xml:lang="la">Vetus tamen dictum est: <lb xml:id="p1z7"/>auro loquente nihil pollet quaevis oracio.</s>
					<s n="6" xml:lang="la">In ecclesia nostra ambo <lb xml:id="p1z8"/>dehortati sumus mortales a milicia, quicquid dicant, qui illibenter <lb xml:id="p1z9"/>audiunt; ambo autem claris et multis verbis id egimus, alter eciam <lb xml:id="p1z10"/>nostrum tota concione id docuit, praeterea nihil.</s>
					<s n="7" xml:lang="la">Hoc pro certo <lb xml:id="p1z11"/>tenemus: non habiturum <persName ref="p8112">regem Gallorum</persName> tot Retos (quatuor milia <lb xml:id="p1z12"/>peciit), nisi ampliorem solucionem fecerit quam hactenus.</s>
					<s n="8" xml:lang="la">Ex <placeName ref="l834">Italia</placeName> <lb xml:id="p1z13"/>pro certo audimus ab omnibus, qui illinc veniunt, <persName>Strozam</persName> multos <lb xml:id="p1z14"/><placeName ref="l875">Hispanorum</placeName> demisisse horco, sunt, qui dicant milium aliquot, <lb xml:id="p1z15"/>multos eciam primorum Caesaris captos ab illo et hoc gestum Senae.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>Sunt, qui dicant et in <placeName ref="l736">Pedemontana</placeName> regione passos esse Caesarea<lb xml:id="p1z17"/>nos.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Caetera apud nos in statu priore suoque sunt.</s>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z18"/>Vale, virorum integerrime, et nos redama.</s>
					<s n="12" xml:lang="la" ana="salute">Salutant te <lb xml:id="p1z19"/><persName ref="p3196">Tschernerus</persName>, <persName ref="p8013">Haimius</persName>, ita enim me iussit scribere, <persName ref="p6130">Pontisella</persName>; praete<lb xml:id="p1z20"/>rea fratres ecclesiastae, quorum nomina adscribere inpraesenciarum s<lb xml:id="p1z21"/>upersedemus, tibi felicia omnia precantur.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Ex <placeName ref="l98">Curia</placeName>, die 16. <lb xml:id="p1z22"/>aprilis anni 1554.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z23"/>Tuae humanitatis <persName ref="p654">Ioannes Comander</persName> et <lb xml:id="p1z24"/><persName ref="p8359">Philippus Gallicius</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vere magno viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurino</placeName> ecclesiastae, <lb xml:id="p2z4"/>domino suo colendissimo.</s>
				</p>
				<p>
					<s n="16" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
