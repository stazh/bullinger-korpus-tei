	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literae tuae, reverende in Christo pater, mihi sunt redditae.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Scio ego te valde <lb xml:id="p1z2"/>esse occupatum nec ideo quidem scribo, ut tuas vicissim expetam, sed quod officium <lb xml:id="p1z3"/>meum faciam.</s>
					<s n="4" xml:lang="la">Nunc tamen sum brevior.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Legatum ipsum non adii; quae eum scire volui, <lb xml:id="p1z4"/>per schedulam ei significavi.</s>
					<s n="6" xml:lang="la" ana="salute">Misit ad me secretarium suum, cupit te officiose <lb xml:id="p1z5"/>resalutari.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Classem <placeName ref="l2510">Trucicam</placeName> discessisse certo et sancte affirmat; idem <lb xml:id="p1z6"/>nuper consulibus dixit et addidit regulum quendam esse, qui hactenus in <placeName ref="l832">Galli</placeName> partes <lb xml:id="p1z7"/>inclinarit, qui damnum hoc a <placeName ref="l2510">Turcis</placeName> acceperit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">De navibus partim captis partim <lb xml:id="p1z8"/>demersis legatus scire aliquid se negat.</s>
					<s n="9" xml:lang="la">Addidit secretarius quotidie expectari pugnam etc.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z9"/>Mitto literas <placeName ref="l822">Germanicas</placeName> <placeName ref="l306">Mediolano</placeName> ad civem nostrum perscriptas de supplicio duorum fratrum, <lb xml:id="p1z10"/>quorum tu historiam integram scire laboras; lege haec, dum pleniora, et literas lectas <lb xml:id="p1z11"/>remitte.</s>
					<s n="11" xml:lang="la">Libros tuos, quos polliceris, gratum erit inspicere; nam de argumento libri <lb xml:id="p1z12"/>nobis non constat.</s>
					<s n="12" xml:lang="la">Sed utinam haberemus, quo te vicissim demereri possemus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z13"/>Certe cum nos totos tuis beneficiis obstringes, perpetuos habebis debitores.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z14"/>Plura non possum; sed et haec raptim, ut vides.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Vale, vir clarissime, cum omni tua <lb xml:id="p1z15"/>familia quam felicissime.</s>
					<s n="16" xml:lang="la" ana="salute">Salutem tibi dicere me iusserunt d. <persName>Philippus</persName> et <persName ref="p6130">Pontisella</persName> <lb xml:id="p1z16"/>noster.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z17"/><placeName ref="l98">Curie</placeName> 29. augusti anno domini 1558.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p8009">Ioannes <lb xml:id="p1z19"/>Fabricius</persName> tui <lb xml:id="p1z20"/>observantissimus.</s>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro eruditione et pietate <lb xml:id="p2z2"/>excellenti d. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> antistiti fidelissimo, <lb xml:id="p2z4"/>domino et patrono suo plurimum <lb xml:id="p2z5"/>observando.</s>
					<s n="20" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName> zum Grossen <lb xml:id="p2z7"/>Münster.</s>
				</p>
			</div>
		</body>
	</text>
