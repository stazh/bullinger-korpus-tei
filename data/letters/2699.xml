	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p2095">Philippo Melanchtoni</persName> <persName ref="p495">H[einrichus] <lb xml:id="p1z2"/>Bullingerus</persName> S. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Pietati tuae et humanitati confisus, piissime et doctissime <lb xml:id="p1z4"/><persName ref="p2095">Philippe</persName>, domine colendissime et frater charissime, mitto <lb xml:id="p1z5"/>ad te hunc meum filium <persName ref="p487">Heinrychum</persName>, et per ipsum <lb xml:id="p1z6"/>dominum nostrum te obtestor ut velis illi esse pater, <lb xml:id="p1z7"/>eumque in tuas ędes, in victum et in tutelam tuam <lb xml:id="p1z8"/>recipere.</s>
					<s n="3" xml:lang="la">Numerabo tibi quod aequum fuerit et alii <lb xml:id="p1z9"/>coaequales eius tibi appenderint.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Praeterea me tibi <lb xml:id="p1z10"/>tuisque obstringo, et omne nostrum officium vicissim defero: <lb xml:id="p1z11"/>Quod si tibi omnino commodum non fuerit illum in <lb xml:id="p1z12"/>aedes tuas recipere, saltem illi auxilio esse velis, <lb xml:id="p1z13"/>consultorque bonus, ut honestum vel sanctum nanciscatur <lb xml:id="p1z14"/>hospitem, et ut tu interim eius sumas <lb xml:id="p1z15"/>patrocinium.</s>
					<s n="5" xml:lang="la">Nemini erit oneri, nemini erit molestus, <lb xml:id="p1z16"/>cum nemine contendet.</s>
					<s n="6" xml:lang="la">Sibi, dei et literis vivet.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/>Te sequitur, te sibi deligit praeceptorem et audire <lb xml:id="p1z18"/>cupit.</s>
					<s n="8" xml:lang="la">Ego cupio ut pacifice apud vos agere et bonas <lb xml:id="p1z19"/>pariter ac pias literas discere possit.</s>
					<s n="9" xml:lang="la">Deo enim <lb xml:id="p1z20"/>et bonis literis hunc consecravi.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Deo et literis si <lb xml:id="p1z21"/>hunc una mecum applicare contenderis, scis te <lb xml:id="p1z22"/>praemium accepturum a vivifico domino et deo nostro.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Praterea <lb xml:id="p1z23"/>me et meos tibi tuisque prorsus devincies, De <lb xml:id="p1z24"/>rebus omnibus satis diligenter scribit aliquando dilectissimus al<lb xml:id="p1z25"/>iquando frater noster <persName ref="p540">Calvinus</persName>.</s>
					<s n="12" xml:lang="la">Ea de causa sum brevior, sciens <lb xml:id="p1z26"/>te multis esse occupatum.</s>
					<s n="13" xml:lang="la">Mitto tuae pietati tres <lb xml:id="p1z27"/>sermones germanicos quos hoc anno et praeterito <lb xml:id="p1z28"/>aedidi, et postremum maxime contra <persName ref="p8441">Schvenkfeldianos</persName>.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z29"/>Dominus Iesus servet te diu incolumem anima et corpore <lb xml:id="p1z30"/>afflictissimae suae ecclesię.</s>
					<s n="15" xml:lang="la" ana="salute">Salutant te fratres et <lb xml:id="p1z31"/>symmystae.</s>
					<s n="16" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 22. augusti anno 1555.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z32"/><persName ref="p495">Heinrychus Bullingerus</persName> <lb xml:id="p1z33"/><placeName ref="l587">Tigurinae</placeName> ecclesię minister <lb xml:id="p1z34"/>tuus ex animo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>