	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">De iis, que in <placeName ref="l640">Flandrie</placeName> finibus et <persName>Caleti</persName> post captam <lb xml:id="p1z2"/><persName>Theodenis Villam</persName> acta sunt, intelliges ex literis, quas ad illustrissimum <lb xml:id="p1z3"/>senatum scribo.</s>
					<s n="3" xml:lang="la">Est mirus terror et fuga in iis regionibus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Utinam principum animi inclinarentur ad pacem et ad reformationem ecclesiae.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Sed nondum dierum omnium sol occidit, et restant menses cruenti, <lb xml:id="p1z6"/>et ducum animi ad manus descendent nec detrectabunt pugnam.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z7"/>Quid, si dominus per alienum opus suum facere velit et omnia <lb xml:id="p1z8"/>ad nominis sui amplificationem, ut solet, convertere?</s>
					<s n="7" xml:lang="la">Illi sit gloria.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z9"/>Unus ex meis scripsit <persName>coronellum Dandelot</persName> liberatum a carcere, <lb xml:id="p1z10"/>etiam si perstitisset in opinione.</s>
					<s n="9" xml:lang="la">Ubi remiserint paulo calores, <lb xml:id="p1z11"/>mittam filium.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Sed nondum accepi te convaluisse; ne permittas equos <lb xml:id="p1z12"/>cursorios ocio perire, et de tua valetudine ut sepe me <lb xml:id="p1z13"/>certiorem facias, etiam atque etiam oro.</s>
					<s n="11" xml:lang="la" ana="salute">Bene vale et meo nomine amicos <lb xml:id="p1z14"/>communes saluta.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l760">Soluturi</placeName> 21. iulii.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z15"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z2"/>Clarissimo et doctissimo viro <lb xml:id="p2z3"/>d. <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z4"/>ecclesie <placeName ref="l587">Tigurine</placeName> antistiti vigilantissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="de"><placeName ref="l587">Zurich</placeName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="de"><lb xml:id="p2z6"/>An herren <persName ref="p495">Heinrich Bullinger</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="de"><placeName ref="l587">Zürich</placeName>.</s>
				</p>
				<p>
					<note>[Von anderer Hand.]</note>
				</p>
			</div>
		</body>
	</text>
