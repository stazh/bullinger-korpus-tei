	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et pacem a domino.</s>
					<s n="2" xml:lang="la">Non iniuria historiographus ille testatur bonas <lb xml:id="p1z2"/>leges ex malis moribus oriri, <persName ref="p495">Bullingere</persName> dilectissime; nam quotidiana <lb xml:id="p1z3"/>experientia hoc docet.</s>
					<s n="3" xml:lang="la">Inde gubernatores rerumpublicarum vix satis prospicere <lb xml:id="p1z4"/>possunt, ne quid fraudis in rebus etiam optime conditis commisceatur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">De<lb xml:id="p1z5"/>crevit senatus noster amplissimus, quod aliquot civium liberi ad bonas artes <lb xml:id="p1z6"/>bonaque studia nati alantur ex ecclesiae nostrae ęrario successuri in locum <lb xml:id="p1z7"/>monachorum nostrorum.</s>
					<s n="5" xml:lang="la">Verentur tamen, ne, cum in iustam aetatem pervenerint <lb xml:id="p1z8"/>reipublicae per parentes subtrahantur privatisque usibus applicentur.</s>
					<s n="6" xml:lang="la">Non dubitant <lb xml:id="p1z9"/>tamen vos iamdudum per iusta decreta cavisse, ne quid tale cum damno ecclesiarum <lb xml:id="p1z10"/>vestrarum admitti possit.</s>
					<s n="7" xml:lang="la">Orant igitur scholarchae nostri, ut, si quid habeatis in <lb xml:id="p1z11"/>hanc rem iamdudum a vobis decretum, ipsis per te conmunicetur offerentes <lb xml:id="p1z12"/>interim tibi totique vestrae ecclesiae suam operam, si qua in re vobis commodo <lb xml:id="p1z13"/>usuique esse possint.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Novi nihil habemus quam miseros istos fructus <placeName ref="l832">Gallicae</placeName> <lb xml:id="p1z14"/>confoederationis, quos nuper clades illa Rhetica tulit, atque utinam non m<lb xml:id="p1z15"/>aiorem subinde naxam expectare cogamur, cum desertis iis, qui fidei nostrae commissi, <lb xml:id="p1z16"/>iis suppetias ferimus, qui Christum in suis extreme persequuntur.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Articulos <lb xml:id="p1z17"/>de studiosis, si quos habetis, velim nobis lingua Germanica transmitteres<lb xml:id="p1z18"/>, ut, si necessitas exigeret, possint senatui nostro conspiciendi proponi.</s>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z19"/>Vale Christo ex ecclesiae ipsius diu incolumis.</s>
					<s n="11" xml:lang="la">Raptim <placeName ref="l441">Scaffhusi<lb xml:id="p1z20"/>i</placeName> 8. kalendas septembris <lb xml:id="p1z21"/>anno 1554.</s>
					<s n="12" xml:lang="la" ana="salute">Salutant te symmystae mei, <lb xml:id="p1z22"/>d. item <persName ref="p467">Martinus</persName>, consul caeterique.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z23"/>Tuus ex animo <lb xml:id="p1z24"/><persName ref="p3481">Simpertus Vogt</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctrina et pietate conspicuo <lb xml:id="p2z2"/>viro d. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesiae past<lb xml:id="p2z4"/>ori vigilantissimo, domino <lb xml:id="p2z5"/>suo ac fratri observando.</s>
					<s n="15" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
