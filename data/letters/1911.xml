	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Scripta iam epistola constitui mittere certum <lb xml:id="p1z2"/>nuncium, qui <persName ref="p8442">Iosiam</persName> meum deducat, quum <lb xml:id="p1z3"/>sit scriptum: Vhe soli, quoniam, si ceciderit, <lb xml:id="p1z4"/>non est, qui sublevet eum.</s>
					<s n="2" xml:lang="la">Tu vero poteris <lb xml:id="p1z5"/>ad me per hunc ipsum nuncium non modo <lb xml:id="p1z6"/>scribere, sed mittere, si quid forte ali<lb xml:id="p1z7"/>cunde supervenisset literarum mihi in<lb xml:id="p1z8"/>scriptarum.</s>
					<s n="3" xml:lang="la">Utinam scripsisses de Catalo<lb xml:id="p1z9"/>go, quod te rogavi et mihi promiseras <lb xml:id="p1z10"/>te esse facturum; nam posses nunc mittere, <lb xml:id="p1z11"/>et ego imprimerem recta.</s>
					<s n="4" xml:lang="la">Scribe, si quid <lb xml:id="p1z12"/>habes ab <placeName ref="l834">Italia</placeName> rerum novarum, praesertim <lb xml:id="p1z13"/>quisnam fuerit suffectus dux <placeName ref="l522">Venetorum</placeName>.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z14"/><persName ref="p8442">Iosias</persName> tibi dicet, quid cogitarim de eo; tu eum <lb xml:id="p1z15"/>audi et scribe omnino, quid sentias; mi<lb xml:id="p1z16"/>hi certe non videtur spernenda tam bona <lb xml:id="p1z17"/>occasio; sed tu plus vides.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale et <lb xml:id="p1z18"/>salve.</s>
					<s n="7" xml:lang="la"><placeName ref="l512">Tubingae</placeName> ipso Ioannis die 1553.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z19"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Bullingero</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
