	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p8114">Nicolaus Artopoeus</persName> <persName ref="p495">Henrico Bullingero</persName>, viro docto <lb xml:id="p1z2"/>atque humanissimo S. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Praefectus coenobiorum nostrorum, harum baiulus, isthuc <lb xml:id="p1z4"/>venit negotium habens cum domino <persName ref="p1227">Christophoro Froschovero</persName>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Quicquid id est, ex ipso cognosces.</s>
					<s n="4" xml:lang="la">Vir est plane <lb xml:id="p1z6"/>bonus et syncerus, qui et pedibus et manibus, <lb xml:id="p1z7"/>ut adagio fertur, nostrum, imo Domini in<lb xml:id="p1z8"/>stitutum fovet et tuetur.</s>
					<s n="5" xml:lang="la">Is confidit iis meis literis <lb xml:id="p1z9"/>se apud te nonnihil impetrabiliorem et gratiosiorem <lb xml:id="p1z10"/>fore.</s>
					<s n="6" xml:lang="la">Quae spes ne optimum virum fallat, mirum <lb xml:id="p1z11"/>in modum te rogo; effice, quaeso, quo intellegat <lb xml:id="p1z12"/>id, quod etiam persuasissimum habet, se et me tibi <lb xml:id="p1z13"/>esse charissimos.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale, vir doctissime.</s>
					<s n="8" xml:lang="la"><placeName ref="l98">Curiae</placeName>, 28. <lb xml:id="p1z14"/>Octobris, ex scholio coenobio.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/>viro et el<lb xml:id="p2z4"/>oquentia et <lb xml:id="p2z5"/>eruditione <lb xml:id="p2z6"/>praestantissimo.</s>
				</p>
			</div>
		</body>
	</text>
