	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non vidi d. <persName>Halesium</persName>; concionabar, quum ad ędes meas venerat, <lb xml:id="p1z2"/>dein accedendum erat ad duos damnatos, et dolet tam pium hominem <lb xml:id="p1z3"/>non vidisse.</s>
					<s n="3" xml:lang="la">Quid in <placeName ref="l830">Anglis</placeName> faciet apud populum seditiosissimum?</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Naufragium ingens est factum in mari; sunt cadavera plus quam 300 inventa, <lb xml:id="p1z5"/>quę mare eiecit, et maritimas civitates adhuc quędam inveniunt.</s>
					<s n="5" xml:lang="la">Quidam putant <lb xml:id="p1z6"/>esse <placeName ref="l875">Hispanos</placeName>, quidam <placeName ref="l830">Anglos</placeName>, quod verisimilius est; propterea animi illorum inclinant <lb xml:id="p1z8"/>ad pacem.</s>
					<s n="6" xml:lang="la">Absque dubio pax erit inter <placeName ref="l832">Gallum</placeName> et <placeName ref="l830">Anglum</placeName>.</s>
					<s n="7" xml:lang="la">Dux <persName ref="p1546">Christophorus Wirtembergensis</persName> <lb xml:id="p1z9"/>5 diebus apud nos fuit et in diversorio iuxta Augustum dirutum voluit pernocta<lb xml:id="p1z10"/>ri; interea literas accepit, nescio a quo, quas legit et mox inęnatus abiit.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/><persName>Petit Hohentwel</persName>; fortassis pater illius in extremis laborat aut aliquid novi molitur.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z12"/><placeName ref="l491">Argentinam</placeName> recepisse missatores 2. februarii quidam spargunt; sed certiora expecto.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l922">Fribur<lb xml:id="p1z13"/>genses</placeName> miserunt sacrificulos et scholasticos, quo splendidiori pompa missaticum <lb xml:id="p1z14"/>opus absolvant.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Et mirum, in hac die accendunt omnes lumina et ipsi verum lumen, <lb xml:id="p1z15"/>quod est Christus, expellunt, tenebras inducunt.</s>
					<s n="12" xml:lang="la"><persName ref="p3099">Sulzerus</persName> 19. ianuarii inauguratus <lb xml:id="p1z16"/>est in pastorem templi Petrini a <persName ref="p8418">Myconio</persName>, qui domum reversus mox in pristinum <lb xml:id="p1z17"/>morbum incidit.</s>
					<s n="13" xml:lang="la"><persName ref="p8466">Wolfius</persName> tacito consumitur igne.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z18"/>Mitto praeterea tibi duo folia ex libello de ponderibus, ut solummodo gustum <lb xml:id="p1z19"/>habeas, donec integrum misero.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z20"/>De servo pistoris <placeName ref="l546">Wiennę</placeName> <placeName ref="l850">Austrię</placeName> combusto brevi mittam integram <lb xml:id="p1z21"/>historiam, quam quidam apud nos excudet.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z22"/>Duos <placeName ref="l257">Constantię</placeName> esse publico iudicio damnatos ac pęna crudeli adfecto<lb xml:id="p1z23"/>s audimus; sed nihil certi spargitur; quam historiam a te cupio scire.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z24"/>Libellos quos tu petis, apud nos non extant, et mirum, quod tam diu <lb xml:id="p1z25"/>distuleris emere tales libellos.</s>
					<s n="18" xml:lang="la">Ex nundinis, si placet, curabo ad <lb xml:id="p1z26"/>me portari.</s>
					<s n="19" xml:lang="la"><persName ref="p2916">Schertlinus</persName> <placeName ref="l21">Badenę</placeName> est in comitiis, cui dabo literas <lb xml:id="p1z27"/>tuas, si venerit.</s>
					<s n="20" xml:lang="la">Mitto praeterea tibi confessionem de eucharistia, quę <lb xml:id="p1z28"/>minus intricata est, quam certe non intelligerem, nisi scripta tua priora <lb xml:id="p1z29"/>consulerem.</s>
					<s n="21" xml:lang="la">Articuli in isto negotio aperti, sine fuco verborum scribendi <lb xml:id="p1z30"/>essent et ambiguitates verborum omittere utile esset, quo vera concordia <lb xml:id="p1z31"/>inter ecclesias constaret.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="farewell">Vale.</s>
					<s n="23" xml:lang="la">Brevi plura.</s>
					<s n="24" xml:lang="la">3. februarii 1550.</s>
					<s n="25" xml:lang="la" ana="salute"><lb xml:id="p1z32"/>D. <persName ref="p8171">Theodorum</persName> salutabis cum reliquis.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">T[uus] <lb xml:id="p1z33"/><persName ref="p1278">Gastius</persName>.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>.</s>
				</p>
			</div>
		</body>
	</text>
