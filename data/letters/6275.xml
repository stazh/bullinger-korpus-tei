			<zone xml:id="p4z6-0" points="556,1683 788,1664 882,1699 1246,1683 1246,1619 1190,1633 1056,1596 1015,1615 885,1592 801,1633 663,1585 556,1617">561,1666 595,1664 629,1663 664,1663 698,1663 732,1661 767,1660 801,1661 835,1663 870,1660 904,1662 938,1663 973,1663 1007,1663 1041,1663 1076,1662 1110,1660 1144,1660 1179,1660 1213,1663 1248,1672</zone>
