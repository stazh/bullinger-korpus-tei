	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve, clarissime vir et humanissime d. <persName ref="p495">Bullingere</persName>.</s>
					<s n="2" xml:lang="la">Velim equidem <lb xml:id="p1z2"/>libentissime pluribus ad te scribere, sed, quod scribam, non est.</s>
					<s n="3" xml:lang="la">Expectamus <lb xml:id="p1z3"/>quotidie, quid sint allatura comitia <placeName ref="l18">Augustana</placeName>, item quid futurum inter <lb xml:id="p1z4"/><persName>Gallum</persName> et <persName>Carolum</persName>, quod pacem attinet, quam ne optamus quidem, pacis alias <lb xml:id="p1z5"/>appetentes admodum.</s>
					<s n="4" xml:lang="la">Quantum ad collectam <placeName ref="l41">Bernensium</placeName> in <placeName ref="l294">Locarnenses</placeName> fratres <lb xml:id="p1z6"/>collatam putaveramus nostrum senatum aliorum vestigia citius insequuturum quam aliis <lb xml:id="p1z7"/>benefaciendis pauperibus Christi exulibus occasionem daturum; nam simystae mei mihi <lb xml:id="p1z8"/>aegroto retulerunt se senatum nostrum salutasse <placeName ref="l294">Locarnensium</placeName> gratia et multis <lb xml:id="p1z9"/>argumentis suasisse, ut (quia evangelium etiam profiteantur) exemplum et vestrum et <placeName ref="l41">Bernensium</placeName> <lb xml:id="p1z10"/>erga homines istos Christi exules immitari velint, quorum illi hospitio eos excipiant, <lb xml:id="p1z11"/>hi vero dona conferunt haud exigua.</s>
					<s n="5" xml:lang="la">Quid inde sit futurum, ignoro; aedes rarius <lb xml:id="p1z12"/>adhuc egressus sum.</s>
					<s n="6" xml:lang="la">Utinam permitterent nobis colligendi potestatem; non dubito, <lb xml:id="p1z13"/>quin vel aliquid essemus effecturi.</s>
					<s n="7" xml:lang="la">Sed si sponte nolint, cogendi mihi non vi<lb xml:id="p1z14"/>dentur, cum hilarem datorem dominus diligat etc.</s>
					<s n="8" xml:lang="la">Caeterum mitto hic epitaphia <lb xml:id="p1z15"/>Iulii 3. pontificis, quae dudum misit <persName ref="p3375">Vergerius</persName>, retinui tamen, donec convalescerem <lb xml:id="p1z16"/>eaque describere possem, id quod iam (deo sit laus) mihi contigit.</s>
					<s n="9" xml:lang="la">Cogitabam enim <lb xml:id="p1z17"/>te ea forsan interim aliunde accepturum vel, si iam tandem ad te deferrentur, nihil hac <lb xml:id="p1z18"/>in re esse neglectum.</s>
					<s n="10" xml:lang="la" ana="salute">Sed nolo tibi, praestantissime vir, ulterius molestus esse; <lb xml:id="p1z19"/>rogo, me semper tuae humanitati commendatum habeas meoque nomine salutes, qui de me percontantur, <lb xml:id="p1z20"/>sive simystae sive professores etc.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z21"/><placeName ref="l441">Scaphusiae</placeName> 8. iunii 1555.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z22"/>Tuae humanitati deditissimus <lb xml:id="p1z23"/>semper <persName ref="p2757">Iacobus Rüger</persName>.</s>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo, egregia doctrina, <lb xml:id="p2z2"/>singulari virtute et pietate <lb xml:id="p2z3"/>praedito viro d. m. <persName ref="p495">Heinrycho <lb xml:id="p2z4"/>Bullingero</persName>, antistiti ecclesiae <lb xml:id="p2z5"/><placeName ref="l587">Tigurinae</placeName> vigilantissimo, d. <lb xml:id="p2z6"/>ac fratri suo plurimum suspici<lb xml:id="p2z7"/>endo.</s>
				</p>
