	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>Gratiam et pacem a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Celebravimus hisce diebus <lb xml:id="p1z3"/>synodum<note xml:id="fn1" type="footnote" n="1">Am 6. Mai; vgl. oben <ref target="file11308">Nr. 1265</ref>, Anm. 31.</note>, amice et frater colendissime; ideo negotiis occupatissimus <lb xml:id="p1z4"/>paucula haec scribo.</s>
					<s n="3" xml:lang="la">Quam petisti, <persName ref="p8049">Vadiani</persName> nostri <lb xml:id="p1z5"/>epistolam<note xml:id="fn2" type="footnote" n="2"><bibl source="b8">HBBW VI</bibl>, <ref target="file10936">Nr. 894</ref> (Teildruck); s. oben <ref target="file11300">Nr. 1257</ref>, 34-44 mit Anm. 23 und <ref target="file11301">Nr. 1258</ref>, 18-20.</note> mitto, sed ea lege, ut per hunc tabellionem<note xml:id="fn3" type="footnote" n="3">Vgl. unten Z. 6-8.</note> re<lb xml:id="p1z6"/>mittas.</s>
					<s n="4" xml:lang="la">Praeter uni tibi et <persName ref="p8418">Myconio</persName> alii non com<lb xml:id="p1z7"/>municassem.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Tabellionem, hominem Hebraeum<note xml:id="fn4" type="footnote" n="4"><persName ref="p41">Michael Adam</persName> (vgl. auch unten <ref target="file11312">Nr. 1269</ref>, 3; 1270, 2).</note>, tibi com<lb xml:id="p1z8"/>mendo.</s>
					<s n="6" xml:lang="la">Nam ad <persName ref="p1753">Leonis</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p1753">Leo Jud</persName>.</note> et meas preces, quemadmodum <lb xml:id="p1z9"/>petieras<note xml:id="fn6" type="footnote" n="6">Ein entsprechender Brief von <persName ref="p1365">Grynäus</persName> ist nicht bekannt.</note>, ad te descendit.</s>
					<s n="7" xml:lang="la">Vir est pius et doctus.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z10"/>Quam vero nihil votis nostris responderunt comitia <placeName ref="l157">Franck<lb xml:id="p1z11"/>fordiensia</placeName><note xml:id="fn7" type="footnote" n="7">Zum <placeName ref="l157">Frankfurter</placeName> Anstand vom 19. April 1539 vgl. oben <ref target="file11304">Nr. 1261</ref>, 2-21.</note>!</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Deus misereatur et nostri et eorum, quorum <lb xml:id="p1z12"/>consiliis in tanta pericula coniicitur ecclesia domini.</s>
					<s n="10" xml:lang="la">Agetur <lb xml:id="p1z13"/><placeName ref="l361">Nerobergae</placeName> de concordia papisantium et evan<lb xml:id="p1z14"/>gelizantium<note xml:id="fn8" type="footnote" n="8">In <placeName ref="l157">Frankfurt</placeName> war beschlossen worden, auf den 1. August ein Religionsgespräch nach <placeName ref="l361">Nürnberg</placeName> einzuberufen; vgl. oben <ref target="file11304">Nr. 1261</ref>, Anm. 6.</note>.</s>
					<s n="11" xml:lang="la">At quae potest esse concordia inter lucem <lb xml:id="p1z15"/>et tenebras<note xml:id="fn9" type="footnote" n="9">Vgl. <cit type="bible"><ref>2Kor 6, 14</ref></cit>.</note>?</s>
					<s n="12" xml:lang="la">Deliquia illa solis<note xml:id="fn10" type="footnote" n="10">Am 18. April, dem Vortag des <placeName ref="l157">Frankfurter</placeName> Abkommens, hatte eine Sonnenfinsternis stattgefunden; vgl. <bibl source="b671">WA</bibl> TR IV 465f, Nr. 4747.</note> portendunt veritati <lb xml:id="p1z16"/>inducendas esse tenebras.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vale et me <lb xml:id="p1z17"/>ama.</s>
					<s n="14" xml:lang="la">Plura nunc non potui.</s>
					<s n="15" xml:lang="la">7. maii 1539.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z18"/><persName ref="p495">H. Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="17" xml:lang="la">D<pb/><lb xml:id="p2z1"/>omino <persName ref="p1365">Simoni Grynaeo</persName>, <lb xml:id="p2z2"/>plane suo.</s>
				</p>
			</div>
		</body>
