	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi literas, quas scribebas 10. ianuarii.</s>
					<s n="3" xml:lang="la">In iis <lb xml:id="p1z2"/>nil est, ad quod respondeam; nam de pugna in <placeName ref="l832">Galliis</placeName> <lb xml:id="p1z3"/>commissa nec verbum quidem hic auditur, nec facile <lb xml:id="p1z4"/>credo pugnatum esse, quamvis nihil affirmare possim; <lb xml:id="p1z5"/>tempori relinquo.</s>
					<s n="4" xml:lang="la">Angusola negat et perne<lb xml:id="p1z6"/>gat pugnatum esse in <placeName ref="l808">Belgio</placeName> cum detrimento <placeName>Albani</placeName>, <lb xml:id="p1z7"/>cuius exercitus sit integer.</s>
					<s n="5" xml:lang="la">Diversum scribitur <lb xml:id="p1z8"/>ex <placeName ref="l15">Antverpia</placeName>, <placeName ref="l267">Colonia</placeName>, <placeName ref="l491">Argentina</placeName>, <placeName ref="l361">Norinberga</placeName> et <placeName ref="l18">August<lb xml:id="p1z9"/>a Vindelicorum</placeName>; tempus illud ipsum quoque revelabit.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z10"/>Scribitur ex <placeName ref="l18">Augusta</placeName> 28. decembris migrasse ad dominum <lb xml:id="p1z11"/>illustrissimum principem ducem <persName ref="p1546">Wirtembergensem Christophorum</persName> <lb xml:id="p1z12"/>seniorem, reliquisse unum modo post se filium; qui <lb xml:id="p1z13"/>si et ipse moriatur, ducatus redibit ad domum <placeName>A<lb xml:id="p1z14"/>ustriacum</placeName>.</s>
					<s n="7" xml:lang="la">Quod utinam avertat dominus; hoc enim si <lb xml:id="p1z15"/>eveniret, concionatores, qui hactenus ubiquitatem <lb xml:id="p1z16"/>defenderunt, futuri sunt ubique, non imaginative, <lb xml:id="p1z17"/>sed essentialiter et corporaliter, id quod certe nollem.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z18"/>Dominus condonet ipsis etc.</s>
					<s n="9" xml:lang="la">Aiunt, qua fide, nescio <lb xml:id="p1z19"/>ingentes copias in <placeName ref="l822">Germania</placeName> brevi conscribendas, nesciri <lb xml:id="p1z20"/>autem, cui et in quem finem, sed et in <placeName ref="l834">Italia</placeName> colligenda <lb xml:id="p1z21"/>decem militum milia.</s>
					<s n="10" xml:lang="la">Dominus concedat nobis pacem <lb xml:id="p1z22"/>et barbaram gentem avertat!</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Dominus servet te cum bonis <lb xml:id="p1z23"/>omnibus.</s>
					<s n="12" xml:lang="la" ana="salute">Saluta d.d.d. consules, <persName ref="p20473">Ganthnerum</persName>, <persName ref="p6130">Pontisellam</persName> et <lb xml:id="p1z24"/>amicos nostros ordine omnes, d. <persName ref="p1770">Gregorium</persName> imprimis<note type="margin">a.R.: nachtr. unt. d. Z. beigefügt</note><lb xml:id="p1z25"/>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 14. ianuarii <lb xml:id="p1z26"/>1569.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z27"/>Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Si certo m<lb xml:id="p1z28"/>ihi referre <lb xml:id="p1z29"/>potes, <lb xml:id="p1z30"/>quid factum in comiciis, indica etc.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z31"/>Utinam tyrannidem inquisitoriam <lb xml:id="p1z32"/><placeName ref="l522">Veneti</placeName> apud suos abrogarint!</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <persName ref="p8016">Tobiae <lb xml:id="p2z2"/>Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae fidelissimo ministro, <lb xml:id="p2z4"/>domino meo honorando <lb xml:id="p2z5"/>et fratri charissimo.</s>
					<s n="18" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
