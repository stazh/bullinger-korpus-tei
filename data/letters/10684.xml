	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et vitae innocentiam a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Apologiam<note xml:id="fn1" type="footnote" n="1">Von welcher Schrift die Rede ist, bleibt unklar.</note> recepi <lb xml:id="p1z2"/>et, quae legi, non improbantur.</s>
					<s n="3" xml:lang="la">Nondum vero legi omnia.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z3"/><persName ref="p8171">Theodorus</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p8171">Theodor Bibliander</persName>.</note> ante me totum percurrit.</s>
					<s n="5" xml:lang="la">Ei videtur scripsisse <lb xml:id="p1z4"/>purius, quam hactenus huius legerit quicquam.</s>
					<s n="6" xml:lang="la"><persName ref="p1753">Leo</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p1753">Leo Jud</persName>.</note> iam <lb xml:id="p1z5"/>legit.</s>
					<s n="7" xml:lang="la">Ab hoc recipiet <persName ref="p8127">Pellicanus</persName>, postremum ego, tum bo<lb xml:id="p1z6"/>na fide tibi restituetur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb type="edition" next="360"/>Doctor <persName ref="p5565">Capito</persName> a nobis nomine <lb xml:id="p1z7"/>senatus <placeName ref="l491">Argentoratensis</placeName> petebat, ne quid in <persName ref="p1974">Lutherum</persName> <lb xml:id="p1z8"/>hisce <placeName ref="l157">Franckfurdiensibus</placeName> nundinis evulgaremus<note xml:id="fn4" type="footnote" n="4">Zu <persName ref="p5565">Capitos</persName> Gesprächen in <placeName ref="l587">Zürich</placeName> vgl. oben <ref target="file10673">Nr. 635</ref>, Anm. 12.</note>.</s>
					<s n="9" xml:lang="la">Maiorem <lb xml:id="p1z9"/>enim stabilioremque concordiae spem superesse hodie quam <lb xml:id="p1z10"/>hactenus, id quod actis quibusdam cum doctore <persName ref="p2856">Gerione</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p2856">Gereon Sailer</persName>.</note>, <lb xml:id="p1z11"/><placeName ref="l18">Augustanorum</placeName> ad <persName ref="p1974">Lutherum</persName> legato, approbabat<note xml:id="fn6" type="footnote" n="6">Zur Zusammenkunft <persName ref="p2856">Sailers</persName> mit <persName ref="p1974">Luther</persName> s. oben <ref target="file10671">Nr. 633</ref>, Anm. 2.</note>: Hunc diserti<lb xml:id="p1z12"/>s verbis cum prolatis tum scriptis pollicitum <lb xml:id="p1z13"/>esse concordiam se post hac non impediturum.</s>
					<s n="10" xml:lang="la">Videre <lb xml:id="p1z14"/>enim se, quod corda non ita longe lateque dissidiant, <lb xml:id="p1z15"/>ut hactenus dissidere putavit etc.</s>
					<s n="11" xml:lang="la">Hanc autem <lb xml:id="p1z16"/>spem prorsus e medio per nos auferendam praedicabat<note xml:id="fna" type="footnote" n="a">praedicabat <hi>am Rande nachgetragen.</hi></note>, si pergamus <lb xml:id="p1z17"/>quicquam hostilius in <persName ref="p1974">Lutherum</persName> scribere.</s>
					<s n="12" xml:lang="la">Respondimus <lb xml:id="p1z18"/>nos nihil parasse neque in <persName ref="p1974">Lutherum</persName> neque in <lb xml:id="p1z19"/>alium quenquam virum bonum veritatisque amantem; <lb xml:id="p1z20"/>imo plurimum abhorrere animos nostros ab istis convitiis, <lb xml:id="p1z21"/>rixis et chartis dentatis<note xml:id="fn7" type="footnote" n="7">Die Redensart beruht auf einer mißverstandenen Stelle bei <persName ref="p4543">Cicero</persName>; vgl. <bibl source="b56">Adagia</bibl>, 3, 6, 87 (Opera omnia Desiderii Erasmi Roterodami II-6, Amsterdam-Oxford 1981, S. 384).</note> testabamur.</s>
					<s n="13" xml:lang="la">Parare sane <lb xml:id="p1z22"/>nos apologiam pro religione nostra<note xml:id="fn8" type="footnote" n="8">Zum "Apologeticus", den <persName ref="p8171">Bibliander</persName> im Auftrag der Zürcher Pfarrer verfaßte, s. oben <ref target="file10659">Nr. 621</ref>, Anm. 19.</note>, sed cum nullius <lb xml:id="p1z23"/>iniuria, utpote qua innocentiam modo nostram <lb xml:id="p1z24"/>toti orbi cupiamus testatam.</s>
					<s n="14" xml:lang="la">Hactenus quidem silentio <lb xml:id="p1z25"/>transiisse et pacientissimo stomacho concoxisse <lb xml:id="p1z26"/>intolleranda convitia, verum re ipsa experiri nos, <lb xml:id="p1z27"/>quod silentium nostrum et nobis et religioni nostrae fraudi <lb xml:id="p1z28"/>sit.</s>
					<s n="15" xml:lang="la">Vel ergo ipse curet, <persName ref="p6469">Schneppius</persName> et <persName ref="p458">Brentius</persName> cum <lb xml:id="p1z29"/>suis convitiari et innoxios traducere desinant, <lb xml:id="p1z30"/>vel desinat ipse nostram remorari responsionem.</s>
					<s n="16" xml:lang="la">Quod <lb xml:id="p1z31"/>apologiam nostram attineat, paratos nos esse in gratiam <lb xml:id="p1z32"/>senatus <placeName ref="l491">Argentoratensis</placeName> prudentissimi aeditionem differre.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z33"/>Interim ipse curet solidis argumentis concordiae <lb xml:id="p1z34"/>certam spem aperire et approbare.</s>
					<s n="18" xml:lang="la">Id si non fiat, <lb xml:id="p1z35"/>vulgaturos nos Apologeticum.</s>
					<s n="19" xml:lang="la">Placuit <persName ref="p5565">Capitoni</persName> conditio, et m<lb xml:id="p1z36"/>agna quaedam sese<note xml:id="fnb" type="footnote" n="b"><hi>Von</hi> sese <hi>bis</hi> impetraturum <hi>am Rande nachgetragen.</hi></note> facturum et impetraturum<note xml:id="fnc" type="footnote" n="c"><hi>Von</hi> sese <hi>bis</hi> impetraturum <hi>am Rande nachgetragen.</hi></note> recepit.</s>
					<s n="20" xml:lang="la">Utinam vir bonus <lb xml:id="p1z37"/>eadem praestare possit!</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Tu vero, <persName ref="p8049">Vadiane</persName> doctissime, <lb xml:id="p1z38"/>perge in tuo isto opere novo<note xml:id="fn9" type="footnote" n="9">Beim neuen Werk, an dem <persName ref="p8049">Vadian</persName> arbeitete, handelte es sich um dessen "Aphorismorum libri sex de consideratione eucharistiae", wie aus <persName ref="p495">Bullingers</persName> Briefen an <persName ref="p8049">Vadian</persName> vom 16. und 29. Oktober hervorgeht (s. unten <ref target="file10700">Nr. 662</ref>, 2-5; 668, 25). Das Buch erschien im August 1536 bei <persName ref="p4851">Froschauer</persName> in <placeName ref="l587">Zürich</placeName> (<bibl>BZD</bibl> 102, Nr. C 253). Zu Entstehung, Inhalt und Wirkung vgl. <hi>Näf,</hi> <persName ref="p8049">Vadian</persName> II 431-443; <hi>Köhler,</hi> ZL II 424-428.</note>.</s>
					<s n="22" xml:lang="la">Nil enim mihi continge<lb xml:id="p1z39"/>t gratius, quam si id<note xml:id="fnd" type="footnote" n="d">id <hi>über gestrichenem</hi> eum[?].</note> brevi recipiam.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z40"/>plurimum, et si quid habes, quod vel me vel <persName ref="p2816">Röystium</persName><note xml:id="fn10" type="footnote" n="10">Bürgermeister <persName ref="p2816">Diethelm Röist</persName>.</note> <lb xml:id="p1z41"/>scire refert, scribito<note xml:id="fn11" type="footnote" n="11">Ein entsprechender Brief <persName ref="p8049">Vadians</persName> ist nicht erhalten.</note>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><pb type="edition" next="361"/><placeName ref="l587">Tiguri</placeName>, 10. septembris 1535.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z42"/><persName ref="p495">H. Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro doctori <persName ref="p8049">Ioachimo Vadiano</persName>, <lb xml:id="p2z2"/>patrono suo suspiciendo.</s>
				</p>
