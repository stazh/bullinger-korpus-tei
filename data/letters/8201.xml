					<lb xml:id="p4z2"/>10.
					<lb xml:id="p4z3"/>Dem erwurdigen und wolgelertten
					<lb xml:id="p4z4"/>herren Heinrich Bullinger der öllter
					<lb xml:id="p4z5"/>der christenlichen kierchen gethruwer
					<lb xml:id="p4z6"/>dienner meinem geliebten herr
					<lb xml:id="p4z7"/>eyleissen lai 29 fundli eylyen d
					<lb xml:id="p4z8"/>in circa dego storet in Sonderim.
					<lb xml:id="p4z9"/>simim uubuust cursa amerum dea
					<lb xml:id="p4z10"/>lvellet 1570.
