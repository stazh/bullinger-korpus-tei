	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ex <placeName ref="l28">Basilea</placeName> ad te scripsi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Poteris ex <placeName ref="l98">Curia</placeName> intelligere, si verum est, quod ad me <lb xml:id="p1z2"/>scriptum est e <placeName ref="l306">Mediolano</placeName> pontificem mittere priorem de la Scara ad <placeName ref="l648">Rhetos</placeName>, ut in <lb xml:id="p1z3"/>veteri religione relinquant <placeName ref="l520">Valtelinam</placeName> et curam temporalium relinquant iis, ad quos <lb xml:id="p1z4"/>pertinet; alioqui excommunicationem minatur effecitque, ut d. <persName ref="p20604">I[oannes] Angelus Ritzo</persName> a <persName ref="p18575">rege <lb xml:id="p1z5"/>Philippo</persName> mittatur idem postulaturus, et qui minetur impeditum iri commercium cum <lb xml:id="p1z6"/><placeName ref="l306">Mediolanensibus</placeName>.</s>
					<s n="4" xml:lang="la">Non deerit illis prudens responsum, si verum est.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Mitto ad <lb xml:id="p1z7"/>te exempla literarum, quas ex <placeName ref="l875">Hispania</placeName> recepi.</s>
					<s n="6" xml:lang="la">Rex nunc t[emporis] habitat in <lb xml:id="p1z8"/>castro <placeName>Boloinensi</placeName> itinere unius horę a <placeName ref="l378">Luthecia</placeName>.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">E<lb xml:id="p1z9"/>ius principumque omnium corda in manu dei sunt, ut iis utatur ad nominis <lb xml:id="p1z10"/>sui gloriam.</s>
					<s n="8" xml:lang="la">Orandus est, ut nostri misereatur et <placeName ref="l832">Gallie</placeName> adsit.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Salutabis <lb xml:id="p1z11"/>amicos omnes nosque amabis.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l760">Soloduri</placeName> 4. iunii.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z12"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="de"><pb/><lb xml:id="p2z1"/>An herrn <persName ref="p495">Heinrichen <lb xml:id="p2z2"/>Bullinger</persName> <placeName ref="l587">Zürich</placeName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="de"><lb xml:id="p2z3"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
