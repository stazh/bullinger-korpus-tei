	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Et superiores accepi literas et quas nunc misisti.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Ad superiores non licuit respondere propter negotia, quae ut <lb xml:id="p1z3"/>magis magisque accumulantur, ita sentio in me non eam <lb xml:id="p1z4"/>agendi promptitudinem ac dexteritatem, quam antea deo <lb xml:id="p1z5"/>concedente habuisse mihi videor, aetati huius aliquid <lb xml:id="p1z6"/>tribuo et aliquid etiam viribus diutina et nimia <lb xml:id="p1z7"/>exercitatione debilitatis, imo fractis.</s>
					<s n="4" xml:lang="la">Omnia certe <lb xml:id="p1z8"/>habent suos periodos certissimas.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Interim omnia a domino, <lb xml:id="p1z9"/>ut sunt, suscipio libens.</s>
					<s n="6" xml:lang="la">Nunc etiam ad posteriores <lb xml:id="p1z10"/>brevibus respondeo.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Horrui toto animo, cum legerem blasphemi <lb xml:id="p1z11"/>nebulonis simile de antiquo et iuvene asino.</s>
					<s n="8" xml:lang="la">Sathani<lb xml:id="p1z12"/>ca mens est, e qua prodeunt tam abominanda.</s>
					<s n="9" xml:lang="la">Sic <lb xml:id="p1z13"/>illi nebulones gratiam et deo et hominibus referunt, quod <lb xml:id="p1z14"/>exules a <persName>Rhetis</persName> sunt collecti.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Dominus pro merito eorum <lb xml:id="p1z15"/>rependet eis.</s>
					<s n="11" xml:lang="la">Idem non deerit vobis in synodo, si modo <lb xml:id="p1z16"/>studentes simplicitati non concesseritis locum illorum <lb xml:id="p1z17"/>audatiae et libidini dicendi.</s>
					<s n="12" xml:lang="la">- Si <placeName ref="l150">Ferrariensis</placeName> <placeName>Mirand<lb xml:id="p1z18"/>ulam</placeName> occupavit, non sine civili <placeName ref="l834">Italiae</placeName> bello retinebit.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z19"/>Forte rependet dominus huic genti pro ipsorum impietate, <lb xml:id="p1z20"/>nisi forte aliud monstrum alant; sed vivit dominus.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z21"/>Ex <placeName ref="l832">Gallia</placeName> nihildum aliud audimus quam pacem coli, licet <lb xml:id="p1z22"/>aliquot in locis filii Belial erumpant et pro ingenio suo <lb xml:id="p1z23"/>vim inferant innoxiis Christi ovibus.</s>
					<s n="15" xml:lang="la">Scribitur regulus <lb xml:id="p1z24"/><placeName>Transsylvaniae</placeName> mortuus et ideo periculum esse, ne committantur <lb xml:id="p1z25"/>inter se imperator et <placeName ref="l2510">Turca</placeName> utroque volente sibi subiu<lb xml:id="p1z26"/>ngere <placeName ref="l869">Transsylvaniam</placeName>.</s>
					<s n="16" xml:lang="la">Qui <placeName ref="l157">Francfordia</placeName> redierunt, <lb xml:id="p1z27"/>nihil memoratu dignum retulere.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Episcopi ex <placeName ref="l830">Anglia</placeName> <lb xml:id="p1z28"/>duo ad me scribunt salva et incolumia ibi omnia esse <lb xml:id="p1z29"/>ex gratia domini, celebranda 2. aprilis universalia <lb xml:id="p1z30"/>regni comitia.</s>
					<s n="18" xml:lang="la">Scribitur <placeName ref="l512">Tubinga</placeName> 14. aprilis d. <persName ref="p20681">B<lb xml:id="p1z31"/>idenbachium</persName>, successorem <persName ref="p458">Brentii</persName> et praepositum <placeName ref="l496">Stutgardianum</placeName> <lb xml:id="p1z32"/>(edidit hic contra nos testamentum <persName ref="p458">Brentii</persName>), incidisse in maniam <lb xml:id="p1z33"/>vel melancholiam ac profectum ad fratrem Beben<lb xml:id="p1z34"/>husium, quod coenobium est, in quo abbatem frater agit.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z35"/>Ibi vero 6. aprilis <persName ref="p20681">Wilhelmum Bidenbachium</persName> sese hora antelucana <lb xml:id="p1z36"/>3. praecipitem se effudisse in plateam ex fenestra, <lb xml:id="p1z37"/>sublatum autem semivivum nihil dignum christiano <lb xml:id="p1z38"/>fecisse nullumve edidisse poenitentiae signum et intra spatium <lb xml:id="p1z39"/>2 horarum efflasse animam sepultumque 4. vespertina <lb xml:id="p1z40"/>eiusdem diei in eodem coenobio: <persName ref="p4183">Iacobum Andreae</persName> habuisse <lb xml:id="p1z41"/>orationem funebrem in laudem mortui conatus demonstrare <lb xml:id="p1z42"/>mortem eius non esse reputandam sicut eorum, qui sibi ipsis <pb/><lb xml:id="p2z1"/>mortem consciscunt; assuevit enim garrulus ille sua<lb xml:id="p2z2"/>viloquentia album reddere nigrum et nigrum album.</s>
					<s n="20" xml:lang="de">Dann <lb xml:id="p2z3"/>die lüth habend vil zügs in irem gougelsack, damitt sy <lb xml:id="p2z4"/>die lüth vergalsterend.</s>
					<s n="21" xml:lang="la">Interim non irridetur deus, qui <lb xml:id="p2z5"/>est iustus iudex.</s>
					<s n="22" xml:lang="la">Nihil certi referunt mercatores <lb xml:id="p2z6"/>de bello vel <placeName ref="l808">Belgico</placeName> vel <placeName ref="l822">Germanico</placeName>.</s>
					<s n="23" xml:lang="la">Dominus concedat nobis <lb xml:id="p2z7"/>pacem!</s>
					<s n="24" xml:lang="la">Infelix et luctuosum tibi fero, mi <persName ref="p8016">Tobia</persName>, nuncium <lb xml:id="p2z8"/>25. huius hora matutina circiter 3. migrasse ex hoc saeculo <lb xml:id="p2z9"/>amplissimum virum consulem reipublicae nostrae d. <persName>a Chaam</persName> et heri <lb xml:id="p2z10"/>sepultum.</s>
					<s n="25" xml:lang="la">Dominus resarciat nobis iacturam hanc inaestimabilem.</s>
					<s n="26" xml:lang="la"><lb xml:id="p2z11"/>Cogito propter reparandam meam incolumitatem, si dominus <lb xml:id="p2z12"/>voluerit, balneum aliquod sub finem maii ingredi.</s>
					<s n="27" xml:lang="la">Si quid boni effice<lb xml:id="p2z13"/>re potestis in causa <persName>Lemanni</persName> nostri, facite.</s>
				</p>
				<p>
					<s n="28" xml:lang="la" ana="farewell">Vale.</s>
					<s n="29" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 27. aprilis.</s>
					<s n="30" xml:lang="la" ana="salute">Saluta nostros omnes.</s>
					<s n="31" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 1571.</s>
				</p>
				<p>
					<s n="32" xml:lang="la"><persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="33" xml:lang="la">Ornatissimo <lb xml:id="p2z14"/>viro d. <persName ref="p8016">Tobiae Eglio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae ministro fideli, domino meo honorando et fratri c<lb xml:id="p2z15"/>harissimo.</s>
				</p>
				<p>
					<s n="34" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
		</body>
