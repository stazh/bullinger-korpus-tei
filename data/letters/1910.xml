	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Scio tibi rem meam esse commendatam, <persName ref="p495">Bullingere</persName> prudentissime, <lb xml:id="p1z2"/>ut ipse ex colloquio mutuo et rursus ex literis <persName ref="p8171">Bibliandri</persName> nostri ad <lb xml:id="p1z3"/><persName ref="p8126">Oporinum</persName> cognovi.</s>
					<s n="2" xml:lang="la">Caeterum ut possem praestolari illam occasionem de <lb xml:id="p1z4"/><placeName ref="l512">Tubingensi</placeName> academia ratio conditionis meae nunc non patitur, ut apud <lb xml:id="p1z5"/><placeName ref="l327">Montebelgardenses</placeName> id fiat propter conditionem mihi a Bisuntinis propositam<lb xml:id="p1z6"/>.</s>
					<s n="3" xml:lang="la">Quum enim tam vehementer ibi pestis grassetur, ut cives omnes <lb xml:id="p1z7"/>fere urbem deseruerint, ita cautum est Bisuntino edicto, ne, quicunque <lb xml:id="p1z8"/>ab ipsa venit urbe vel solo vel solo ingressu admittatur saltem ante 40 <lb xml:id="p1z10"/>dies, quos probet alibi se in loco non suspecto transegisse.</s>
					<s n="4" xml:lang="la">Praeterea etiam <lb xml:id="p1z11"/>mihi periret ultro oblata conditio, si illic moram facere vellem; nam ego <lb xml:id="p1z12"/>non usque adeo timeo ab ipsa pestilentia, eo quod et ipse arte medica novi <lb xml:id="p1z13"/>mihi utcunque praecavere et praeterea iudicem deum mihi vitae periodum <lb xml:id="p1z14"/>praescripsisse certissimus sum.</s>
					<s n="5" xml:lang="la">Ista fere sunt, de quibus cum <persName ref="p8171">Bibliand<lb xml:id="p1z15"/>ro</persName> egi.</s>
					<s n="6" xml:lang="la">Caeterum quum hic adhuc in aliquot dies causa typografiae <lb xml:id="p1z16"/>penes <persName ref="p8126">Oporinum</persName> inchoatae substiturus sim, poteris ad me scribere, <lb xml:id="p1z17"/>si quid iudicas esse ex re christiana, in quo possim et debeam subsistere.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z18"/>Licet enim, quum fuero <persName>Bisuntii</persName> (si forsan illuc redeo), potero <lb xml:id="p1z19"/>nostri <persName ref="p8126">Oporini</persName> opera literas a te accipere, tamen mallem, si, quid sta<lb xml:id="p1z20"/>tui, aequum censes, in quo sim utilis, ipse nunc, antequam recederem, ad me <lb xml:id="p1z21"/>significatione literarum deferri curares.</s>
					<s n="8" xml:lang="la">In literis <persName ref="p8171">Bibliandri</persName> reliqua <lb xml:id="p1z22"/>cognosces.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l28">Basilęae</placeName> ad 24. iunii sextive mensis 1553.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z23"/>Tuus in Christo humilis frater <lb xml:id="p1z24"/><persName ref="p6133">Gulielmus Postellus</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Egregio d. <persName ref="p495">Heinrico <lb xml:id="p2z2"/>Bullingero</persName>, primario <lb xml:id="p2z3"/><placeName ref="l587">Tigurinorum</placeName> ecclesiastae.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note type="author">[Darunter von anderer (nicht <persName ref="p495">Bullingers</persName>) Hand:]</note>
					<s n="14" xml:lang="la">"<lb xml:id="p2z5"/><persName ref="p6133">Postelli</persName>, <placeName ref="l832">Galli</placeName> <lb xml:id="p2z6"/><foreign xml:lang="el">πολυγλώσσου</foreign>."</s>
				</p>
			</div>
