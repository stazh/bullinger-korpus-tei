	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Existimaveram te atque hospitem meum iis, <lb xml:id="p1z2"/>quę ad te de eius filio sincere et vere scripsi, <lb xml:id="p1z3"/>fidem habituros fuisse atque te omnino habuisse <lb xml:id="p1z4"/>tamen existimo; paterno amori agnoscendum <lb xml:id="p1z5"/>puto, si me aliquid dissimulare timeret.</s>
					<s n="3" xml:lang="la">Velim <lb xml:id="p1z6"/>tamen omnino, existimetis me ea de re neque amplius <lb xml:id="p1z7"/>quicquam tum scivisse neque aliter sensisse, quam <lb xml:id="p1z8"/>ad te scripserim.</s>
					<s n="4" xml:lang="la">Sed est iam, quod ad patris <lb xml:id="p1z9"/>animum confirmandum certius scribam.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><persName ref="p17872">Mendoza</persName>, <lb xml:id="p1z10"/>qui hic satis notus est, ante decem dies apud <lb xml:id="p1z11"/>me fuit.</s>
					<s n="6" xml:lang="la">Is mihi se iuvenem illum <placeName ref="l378">Lutetiae</placeName> <lb xml:id="p1z12"/>vidisse, illum nobilem, qui ipsum abduxit, scire <lb xml:id="p1z13"/>confirmavit sibique fuisse in animo ipsi persuadere, <lb xml:id="p1z14"/>ut relicto negotio se um in <placeName ref="l862">Helvetiam</placeName> rediret.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Illius nobilis ingratitudinem magnopere miror; <lb xml:id="p1z16"/>sed ut eousque erumpat, ut quicquam mali hinc <lb xml:id="p1z17"/>accidere possit, timendum non puto.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Ante <lb xml:id="p1z18"/>tres dies ad sororium meum d. <persName ref="p8296">Bassafontanei</persName> fratrem <lb xml:id="p1z19"/>scripsi, ut investigatum iuvenem (id autem illi <lb xml:id="p1z20"/>facillimum erit) cum viatico remittat neque <lb xml:id="p1z21"/>ultra illic expectare patiatur.</s>
					<s n="9" xml:lang="la">Alia fortasse <lb xml:id="p1z22"/>via reperietur, qua hospem pecuniam suam recuperet.<pb/><lb xml:id="p2z1"/>.. non patiar, si potero, illum quicquam perdere... <lb xml:id="p2z2"/>quicquid rerum novarum habueris, ut coepisti, velim, <lb xml:id="p2z3"/>cum dabitur otium, mihi communices.</s>
					<s n="10" xml:lang="la">Noster exercitus <lb xml:id="p2z4"/>in <placeName ref="l832">Gallia</placeName> urbem et arcem munitissimam et magni <lb xml:id="p2z5"/>nominis <persName>Caletos</persName> expugnat.</s>
					<s n="11" xml:lang="la">Ea est <placeName ref="l830">Anglis</placeName> ex <lb xml:id="p2z6"/>diuturna possessione reliqua; si expugnata <lb xml:id="p2z8"/>fuerit, maximum ad reliquum bellum momentum et in posterum <lb xml:id="p2z10"/>ad arcendos toto continente <placeName ref="l830">Anglos</placeName> propugnaculum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z11"/>Nihil aliud habeo, quod scribam.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l160">Fryburgi</placeName> <lb xml:id="p2z12"/>18. ianuarii 1557 nostra computatione<lb xml:id="p2z13"/>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z14"/>Tuus <persName ref="p8183">Sanlaurent[ianus]</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo theologo <lb xml:id="p4z2"/>d. <persName ref="p495">Henrico Bullingero</persName>.</s>
				</p>
