	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Iam quater, ni fallor, ad te scripsi, vir doctissime, neque <lb xml:id="p1z3"/>abs te responsi quicquam recepi, unde vehementer miror, quid <lb xml:id="p1z4"/>in causa sit.</s>
					<s n="3" xml:lang="la">Nihil enim, quod sciam, te offendi; suspicor <lb xml:id="p1z5"/>malevolum aliquem frigidam suffudisse.</s>
					<s n="4" xml:lang="la">Sed te propter Christum <lb xml:id="p1z6"/>oro, ne me indicta causa repudies damnesque; indica, quicquid <lb xml:id="p1z7"/>est, quod te offendit; nisi me purgaro tibique satisfecero, tum <lb xml:id="p1z8"/>facito de me, quod lubet.</s>
					<s n="5" xml:lang="la">Ego te propter disertissima et doctissima <lb xml:id="p1z9"/>tua scripta amavi ante, quam de facie novi, nec te <lb xml:id="p1z10"/>amare desinam, etiamsi me abieceris, quod te tamen minime <lb xml:id="p1z11"/>facturum spero.</s>
					<s n="6" xml:lang="la">Hactenus nunquam huic nostro senatui <lb xml:id="p1z12"/>potui satisfacere in eo, quod ad Interim attinet; coactus igitur <lb xml:id="p1z13"/>sum missionem petere et impetravi, iniquis licet conditionibus, <lb xml:id="p1z14"/>quas ego tam ferre malo, quam ut mihi imputetur, si quid <lb xml:id="p1z15"/>hodie vel cras accidat civitati ob Interim non satis defensum <lb xml:id="p1z16"/>et servatum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Nunc quo me conferam, incertus sum.</s>
					<s n="8" xml:lang="la"><persName ref="p4863">Fuggarus</persName> <lb xml:id="p1z17"/>stipendium promisit, si iuri civili dem operam ad triennium.</s>
					<s n="9" xml:lang="la">At <lb xml:id="p1z18"/>ego quidvis malim quam rebus prophanis immisceri.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Adiuva, <lb xml:id="p1z19"/>quęso, et consilio et opera, ut locus mihi atque functio alicubi paretur; <lb xml:id="p1z20"/>quod tuum apud me beneficium nunquam est intermoriturum.</s>
					<s n="11" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z21"/>vale et rescribe vel tribus verbis.</s>
					<s n="12" xml:lang="de">Datum 30. novembris 1550.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/><persName ref="p8124">Thomas Naogeorgus</persName> <lb xml:id="p1z23"/>tuus.</s>
				</p>
				<p>
					<s n="14" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem hochgelerten unnd <lb xml:id="p2z2"/>wirdigen hern <persName ref="p495">Hainrichen <lb xml:id="p2z3"/>Bullinger</persName> zu <placeName ref="l587">Zürich</placeName>, mein<lb xml:id="p2z4"/>em besonndern gunstigen <lb xml:id="p2z5"/>herren unnd freundt.</s>
				</p>
				<p>
					<s n="15" xml:lang="de"><lb xml:id="p2z7"/>Zürch.</s>
				</p>
			</div>
		</body>
	</text>
