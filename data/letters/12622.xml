	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Gaudium ingens adnunciasti nobis<note xml:id="fn1" type="footnote" n="1">In einem nicht erhaltenen Brief. - Wahrscheinlich war darin (wie in <persName ref="p495">Bullingers</persName> Brief an <persName ref="p8055">Blarer</persName> vom 3. September) von dem Gefecht vor <placeName ref="l231">Ingolstadt</placeName> die Rede; vgl. <ref target="file12609">Nr. 2562</ref>,9-12. Vgl. auch unten Anm. 4.</note>!</s>
					<s n="3" xml:lang="la">Precamur dominum Iesum, ut bene vertat.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z2"/>Videmus favorem divinum a nobis esse.</s>
					<s n="5" xml:lang="la">Curandum ergo, ne amittamus.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z3"/>Placet vero inter alia mihi, quod duo principes, <persName ref="p19065">Saxo</persName><note xml:id="fn2" type="footnote" n="2">Kurfürst <persName ref="p19065">Johann Friedrich I. von Sachsen</persName>.</note> et <persName ref="p3590">Hessus</persName><note xml:id="fn3" type="footnote" n="3">Landgraf <persName ref="p3590">Philipp von Hessen</persName>.</note>, tam <lb xml:id="p1z4"/>agunt inter se amice<note xml:id="fn4" type="footnote" n="4">Zum gemeinsamen Vorgehen des Kurfürsten und des Landgrafen am 31. August vor <placeName ref="l231">Ingolstadt</placeName> s. den Bericht des Kurfürsten vom 2. September <hi>(Mentz</hi> III 550, Nr. 69) und den der landgräflichen Kanzlei in <ref target="file12628">Nr. 2581</ref>,45-66.</note>.</s>
					<s n="7" xml:lang="la">Pater alter, alter filium agere videtur.</s>
					<s n="8" xml:lang="la">An vero <lb xml:id="p1z5"/><persName ref="p19065">Saxonis</persName><pb type="edition" next="423"/> vox ad <persName ref="p3590">Hessum</persName> redeuntem ex<note xml:id="fna" type="footnote" n="a">ex <hi>fehlt</hi> in <hi>der Vorlage.</hi></note> proelio non fuit libere paterna? <lb xml:id="p1z6"/>et <persName ref="p3590">Hessi</persName> responsum annon fuit filii?</s>
					<s n="9" xml:lang="la">Dominus adsit animis tam pie con<lb xml:id="p1z7"/>cordantibus!</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="10" xml:lang="de"><lb xml:id="p1z8"/>Es züchen die <placeName ref="l20">Niderlender</placeName><note xml:id="fn5" type="footnote" n="5">Das kaiserliche Heer unter <persName ref="p7459">Maximilian von Egmont</persName>, Graf von <placeName ref="l2126">Büren</placeName>; s. dazu <ref target="file12607">Nr. 2560</ref>, Anm. 39; <ref target="file12608">Nr. 2561</ref>, Anm. 15; und zuletzt <ref target="file12614">Nr. 2567</ref>,18-23.</note> zum <persName ref="p18538">kaiser</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p18538">Karl V.</persName></note> zuͦ.</s>
					<s n="11" xml:lang="de">Habenn uff <placeName ref="l158">Franckfurt</placeName> <lb xml:id="p1z9"/>ziechen wellen.</s>
					<s n="12" xml:lang="de">Do habenn die lantgraphischen sy nit durch landt<lb xml:id="p1z10"/>wers<note xml:id="fn7" type="footnote" n="7">landtwers: die äußerste Linie der Stadtbefestigung; s. <bibl source="b590">SI</bibl> XVI 9141. - Zur Sache s. <bibl source="b480">PC</bibl> IV/1 369, Nr. 346: "und haben usser [= außerhalb von] der lantwör vor <placeName ref="l157">Frankfurt</placeName> sich gegen den keiserischen wol gehalten und etlich erlegt, ouch ein capitane samt andern gefangen".</note> lassen wellen, sunder sy wider zerugg getriben, ettlich er<lb xml:id="p1z11"/>schossen, ouch ettlich gfangen.</s>
					<s n="13" xml:lang="de">Die sollen bekant haben, das nit <lb xml:id="p1z12"/>uber 4000 zuͦ roß und 12000 ze fuͦß syen.</s>
					<s n="14" xml:lang="de">Haben iren zug <lb xml:id="p1z13"/>uff <placeName ref="l1521">Osthenburg</placeName><note xml:id="fn8" type="footnote" n="8">Richtig: <placeName ref="l1521">Rothenburg ob der Tauber</placeName>; vgl. <bibl source="b480">PC</bibl> IV/1 373, Nr. 352.</note> genommen.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="15" xml:lang="de">Also zücht <persName ref="p9708">herzog Ulrich</persName><note xml:id="fn9" type="footnote" n="9">Herzog <persName ref="p9708">Ulrich von Württemberg</persName>.</note> mit vil volcks <lb xml:id="p1z14"/>uff <placeName ref="l964">Schwebschen Hall</placeName>, die <placeName ref="l20">niderlendischen</placeName> knecht zuͦ <lb xml:id="p1z15"/>furziechen<note xml:id="fn10" type="footnote" n="10">zu furziechen: entgegen zu ziehen.</note>, uff das sy nit zum kaiser oder zum landgrafen moͤgen.</s>
					<s n="16" xml:lang="de"><lb xml:id="p1z16"/>Und die knaͤcht und reisigen<note xml:id="fn11" type="footnote" ana="lex" n="11">Kavallerie.</note>, so umb <placeName ref="l158">Franckfurt</placeName> gelaͤ<lb xml:id="p1z17"/>gen,<note xml:id="fn12" type="footnote" n="12">Zu dieser landgräflichen Einheit s. <ref target="file12605">Nr. 2558</ref>,18f; <ref target="file12608">Nr. 2561</ref>,11-13.</note> uff die 20000, die sollen ouch iren zug durch die <placeName ref="l2322">berg<lb xml:id="p1z18"/>straß</placeName><note xml:id="fn13" type="footnote" n="13">Eine Straße, die sich von <placeName ref="l1779">Darmstadt</placeName> in <placeName ref="l213">Hessen</placeName> über <placeName ref="l210">Heidelberg</placeName> nach <placeName ref="l548">Wiesloch</placeName> in <placeName ref="l572">Nordbaden</placeName> erstreckt.</note> uff <placeName ref="l964">Schwebschen Hall</placeName> genomen haben, h[erzog] <persName ref="p9708">Ulrichen</persName> huffen <lb xml:id="p1z19"/>zuͦ stercken und helfen.</s>
					<s n="17" xml:lang="de">Der allmechtig gott gaͤbe gnad!</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z20"/>Tantilla descripsi ex literis <persName ref="p4715">Episcopii</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p4715">Nikolaus Episcopius</persName>, Buchdrucker in <placeName ref="l28">Basel</placeName>.</note>, ad quem a bono amico<note xml:id="fn15" type="footnote" n="15">Unbekannt.</note> 4. septem<lb xml:id="p1z21"/>bris missa sunt.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z22"/>Libellum meum<note xml:id="fn16" type="footnote" n="16"><hi><persName ref="p8418">Myconius</persName>,</hi> Ein trostliche, und diser zyt, fast dienstliche ußlegung, dess CI. Psalmen <persName ref="p18877">Davids</persName>, <placeName ref="l41">Bern</placeName>, <persName ref="p4191">Matthias Apiarius</persName>, 1546 <bibl source="https://gateway-bayern.de/VD16+G+831">(VD16 G831)</bibl>. - Die Widmung datiert vom 25. Mai 1546 (f. A2v.).</note> misi non ob aliud, nisi ne, sicubi videres, expostulare<lb xml:id="p1z23"/>s mecum ut nuper<note xml:id="fn17" type="footnote" n="17">Im Brief vom 14. März 1545; s. <bibl source="b18">HBBW XV</bibl> 181,10f.</note> me meorum nihil dare ad te.</s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p1278">Gastius</persName> adducto tabellione<note xml:id="fn18" type="footnote" n="18">Unbekannt.</note> prius quam ego legit<note xml:id="fn19" type="footnote" n="19">Den oben in Anm. 1 erwähnten Brief.</note> in ędibus meis, <lb xml:id="p1z25"/>dum ego coenarem, omnia.</s>
					<s n="21" xml:lang="la">Gratias agamus domino sine intermissione et, <lb xml:id="p1z26"/>ut det, precemur, ne a beneficentia eius insolescamus.</s>
				</p>
				<p>
					<s n="22" xml:lang="la" ana="farewell">Vale cum <lb xml:id="p1z27"/>tuis et <persName ref="p8011">Rodulpho</persName><note xml:id="fn20" type="footnote" n="20"><persName ref="p8011">Rudolf Gwalther</persName>.</note> et aliis piis.</s>
					<s n="23" xml:lang="la">Festinat tabellio<note xml:id="fn21" type="footnote" n="21">Unbekannt.</note>, et mihi <lb xml:id="p1z28"/>festinandum.</s>
					<s n="24" xml:lang="la"><placeName ref="l28">Basileę</placeName>, 8. septembris anno 1546.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z29"/><persName ref="p8418">Os. Myconi</persName>. <lb xml:id="p1z30"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, antistiti <lb xml:id="p2z3"/><placeName ref="l587">Tigurinorum</placeName>, fratri ac <lb xml:id="p2z4"/>domino venerando in <lb xml:id="p2z5"/>Christo suo.</s>
					<s n="27" xml:lang="de"><placeName ref="l587">Zü[rich]</placeName><note xml:id="fnb" type="footnote" n="b"><hi>Textverlust durch Entfernung des Verschlussbandes.</hi></note>.</s>
				</p>
			</div>
		</body>
	</text>
