	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Et daetitiam et dolorem tuae mihi attuleri
					<lb xml:id="p1z2"/>literae Marthia, erbi fratrum longe charissime.
					<lb xml:id="p1z3"/>cum viderem te adhuc superstitem, que
					<lb xml:id="p1z4"/>dudum migrasse existimabam. Dolorem cum ex
					<lb xml:id="p1z5"/>iscriptione coniectare possem, quali sis praeditus
					<lb xml:id="p1z6"/>incolumitate, infirma admodum. Dominus te
					<lb xml:id="p1z7"/>sed vult et tibi prodest, restituat aut certe
					<lb xml:id="p1z8"/>morbis et laboribus liberatum in quietem
					<lb xml:id="p1z9"/>transferat, ubi montum videbimus ad iucindam
					<lb xml:id="p1z10"/>sepietatem cum coniuncti capiti nostro Christo, deimde
					<lb xml:id="p1z11"/>videbimus, qui erit omnia in omnibus.
					<lb xml:id="p1z12"/>Languro et ego hisce diebus fatigatus admodum
					<lb xml:id="p1z13"/>capitis doloribus. Praeterea fessus sum. Tedet
					<lb xml:id="p1z14"/>me huius vitae et maxime morum huius seculi pi
					<lb xml:id="p1z15"/>et pudet. Sed versamur in extremo
					<lb xml:id="p1z16"/>illo et corruptissimo saculo, in quoo impietas
					<lb xml:id="p1z17"/>ingratitudo et cupiditas praeva summum o
					<lb xml:id="p1z18"/>upanere locum. Spero appropinquare redemtu
					<lb xml:id="p1z19"/>nostram. Unde arbitror nobis nostra
					<lb xml:id="p1z20"/>erigenda sursum capita. Dominus benedicat nobis
					<lb xml:id="p1z21"/>Miror, an Heinuinus libellos attulerit scribai
					<lb xml:id="p1z22"/>vestrati, an receperis libros nostros de
					<lb xml:id="p1z23"/>gratia dei iustificante etc. Magis miror fa
					<lb xml:id="p1z24"/>usqueadeo amicum mihi in exilio,
					<lb xml:id="p1z25"/>restitutione mei curam prorsus abiecissimu
					<lb xml:id="p1z26"/>Tunc scribebat frequentissime; nunc tern
					<lb xml:id="p1z27"/>quater salutatus et a me provocatus, ne semel
					<lb xml:id="p1z28"/>quidem dignatur scribere. Dominus benedicat illi
					<lb xml:id="p1z29"/>Nihil est apud nos novi; nam in eademu
					<lb xml:id="p1z30"/>ide versamur sorte. Dominus dat pacem; unde
					<lb xml:id="p1z31"/>multum illi debemus. Utinam gratitudine et
					<lb xml:id="p1z32"/>pietate vitae illius responderemus beneficiis. Ora
					<lb xml:id="p1z33"/>pro nobis. Commenda
					<lb xml:id="p1z34"/>fratribus, qui
					<lb xml:id="p1z35"/>et salutabis meo nomine. Salutant te quoque fratres
					<lb xml:id="p1z36"/>Vive et vale aeternum. Tiguri 6. iulii
					<lb xml:id="p1z37"/>nn1554.
					<lb xml:id="p1z38"/>Bullingerus tuus.
					<pb/>
					<lb xml:id="p2z1"/>Ornatissimo viro d. Matthiae
					<lb xml:id="p2z2"/>Erbio Rychevillano pati
					<lb xml:id="p2z3"/>stori, domino colendo et
					<lb xml:id="p2z4"/>fratri charissimo suo.
					<lb xml:id="p2z5"/>rychenwyr.
				</p>
			</div>
		</body>
