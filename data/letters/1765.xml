	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil habeo, quod scribam, compater in <lb xml:id="p1z2"/>domino charissime, nisi unum hoc, quod heri vesperi <lb xml:id="p1z3"/>coepi paululum habere incommodius, praesertim in stomacho, <lb xml:id="p1z4"/>cuius molestiam adhuc sentio; spero tamen paula<lb xml:id="p1z5"/>tim habiturum me melius per gratiam domini sanantis <lb xml:id="p1z6"/>infirma et conservantis fortia.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z7"/>Rerum novarum nihil hic certi habetur.</s>
					<s n="4" xml:lang="la">Volitatur <lb xml:id="p1z8"/>rumor quidam de comite a <placeName ref="l1716">Mansfelden</placeName>, quas ille <lb xml:id="p1z9"/>partes sequatur, nondum certo comperi.</s>
					<s n="5" xml:lang="la">Ferunt <lb xml:id="p1z10"/>eum flagellum esse episcoporum ac praelatorum et nescio <lb xml:id="p1z11"/>quid mali minari civitatibus imperii, praecipue poti<lb xml:id="p1z12"/>oribus.</s>
					<s n="6" xml:lang="la"><placeName ref="l18">Augustani</placeName> mei sunt in magno metu; <lb xml:id="p1z13"/>vicini ex agro conferunt facultates suas in urbem.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Sic accepi ex literis ad d. <persName ref="p8055">Blaurerum</persName> scriptis.</s>
					<s n="8" xml:lang="la">De <lb xml:id="p1z15"/>marchione retulerunt hodie mercatores quidam <lb xml:id="p1z16"/>id, quod ab eo factum est, factum esse causis iustis<lb xml:id="p1z17"/>simis nec verum esse, quod defecerit ad imperatorem.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/>At ea de re audies ex vestrate iuvene, qui <lb xml:id="p1z19"/>ex <placeName ref="l830">Anglia</placeName> reversus me invisit et hasce <lb xml:id="p1z20"/>a me accepit.</s>
					<s n="10" xml:lang="la" ana="farewell">Optime vale, longe charissime compater, <lb xml:id="p1z21"/>cum omni domo tua ac reliquis dominis et fratribus, <lb xml:id="p1z22"/>d. <persName ref="p8127">Pellicano</persName>, d. <persName ref="p8171">Bibliandro</persName>, d. <persName ref="p8011">Rudolfo</persName> et <lb xml:id="p1z23"/>d. <lb xml:id="p1z24"/><persName ref="p506">Butlero</persName>.</s>
					<s n="11" xml:lang="la"><placeName ref="l41">Bernę Elvet[iorum]</placeName> 1552. 26. novembris.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><persName ref="p8417">W[o<lb xml:id="p1z25"/>lfgangus] Musculus</persName>, tuus in <lb xml:id="p1z26"/>domino compater.</s>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo theologo <lb xml:id="p2z2"/>m. <persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>compatri in domino longe <lb xml:id="p2z4"/>charissimo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
