	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Gratissimum mihi fuit, quod
					<lb xml:id="p1z2"/>S. D. P.
					<lb xml:id="p1z3"/>od affines ad me venerunt; Ex illis enim de vestra
					<lb xml:id="p1z4"/>rebus omnibus cognovi. Et quia non dubito, quin
					<lb xml:id="p1z5"/>literae meae tibi gratissimus sint, non previ non aliquid
					<lb xml:id="p1z6"/>salem ad te scribere. De statu meo tabellari
					<lb xml:id="p1z7"/>omnia, quami opisces possunt referi. Thermanium
					<lb xml:id="p1z8"/>edia optimi sodales, quorum numerus quidie
					<lb xml:id="p1z9"/>escit levant et discutiunt. <persName>Raphael Polanus</persName>
					<lb xml:id="p1z10"/>compatermeus commendavit mihi per literas Ambrsi
					<lb xml:id="p1z11"/>Ziezlerum regni concionatorem, cui libenter si apud
					<lb xml:id="p1z12"/>ns fuietem aliquid officii praesertissem. quod si apud nos
					<lb xml:id="p1z13"/>moram trahat tibi eum commendo. Quid agat ex Iosia
					<lb xml:id="p1z14"/>nastro cignovi. Plura nunc non habeo, de omneibus
					<lb xml:id="p1z15"/>ex affinitis cognosces. D. Harannus ab Halvi
					<lb xml:id="p1z16"/>hisce diebus cum filiabus ad nos veniet. Frdichius
					<lb xml:id="p1z17"/>capitaneus cubicula et thermas conduxerat, sed
					<lb xml:id="p1z18"/>quid disset, quod ad nos non venerit. De electione
					<lb xml:id="p1z19"/>ad cosaris ae em primis et lotra ngnoni en otu
					<lb xml:id="p1z20"/>quaedam, quae maxima cum lieroia audivi. Sul
					<lb xml:id="p1z21"/>ocbis meo namne dominam socium, uxorem meum
					<lb xml:id="p1z22"/>temper familiam. Datae Budlene 1000. aprilis
					<lb xml:id="p1z23"/>22.
					<lb xml:id="p1z24"/>fuui et Luri tuus.
					<pb/>
					<lb xml:id="p2z1"/>Clarissimo d. Henrico
					<lb xml:id="p2z2"/>Bullingero, patri suo
					<lb xml:id="p2z3"/>colendissimo.
					<lb xml:id="p2z4"/>furo.
				</p>
			</div>
		</body>
	</text>
