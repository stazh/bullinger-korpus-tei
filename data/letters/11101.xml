	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus et pax Christi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Habeo gratiam, quod saltem aliquid de <placeName ref="l41">Bernensibus</placeName> <lb xml:id="p1z3"/>scripseris nuper<note xml:id="fn1" type="footnote" n="1"><persName ref="p495">Bullingers</persName> Brief, der wohl Nachrichten aus dem Bericht <persName ref="p8412">Meganders</persName>, <persName ref="p2810">Ritters</persName> und <persName ref="p8428">Rhellikans</persName> vom 23. September (oben <ref target="file11088">Nr. 1045</ref>) enthielt, ist nicht erhalten.</note>, et vehementer rogo, ut, si scias, <lb xml:id="p1z4"/>quem finem acceperit negotium, ne me celes.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Omnino autem viderentur mihi <placeName ref="l41">Bernates</placeName> <lb xml:id="p1z6"/>aliis quam istis tricis occupandi.</s>
					<s n="4" xml:lang="la">Cum enim isto<lb xml:id="p1z7"/>s maneant multa pericula, si modo quis<note xml:id="fna" type="footnote" n="a">quis <hi>für ein gestrichenes, unlesbares Wort am</hi> Rande <hi>nachgetragen.</hi></note> adversariarum <lb xml:id="p1z8"/>partium animos et conatus contempletur, certe <lb xml:id="p1z9"/>addendus esset illis animus ad fortitudinem et <lb xml:id="p1z10"/>fidutiam in domino.</s>
					<s n="5" xml:lang="la">Sed nihil apparet solatii <lb xml:id="p1z11"/>inter nos, quam ut mutuum pugnemus et quisque <lb xml:id="p1z12"/>alium, tantum non pugnis, urgeat ad sua.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p8440">Gervasius</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p8440">Gervasius Schuler</persName>; vgl. oben <ref target="file11085">Nr. 1043</ref>, 36f.</note> ab ecclesia impeditus nunc non venit; <lb xml:id="p1z14"/>institutum tamen non mutavit.</s>
					<s n="7" xml:lang="la">Sed optatissimus <lb xml:id="p1z15"/>hospes venit nobis, scilicet <persName ref="p8055">Ambrosius</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p8055">Ambrosius Blarer</persName>.</note>, non manendi, <lb xml:id="p1z16"/>sed videndi nos animo.</s>
					<s n="8" xml:lang="la">Is te iubet cum omnibus <lb xml:id="p1z17"/>fratribus salvum, praecipue <persName ref="p1753">Leone</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p1753">Leo Jud</persName>.</note>, <persName ref="p8171">Theodoro</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p8171">Theodor Bibliander</persName>.</note> et <lb xml:id="p1z18"/><persName ref="p8127">Pellicano</persName>.</s>
					<s n="9" xml:lang="la">Sententia principis contra idola <lb xml:id="p1z19"/>et imagines<note xml:id="fn6" type="footnote" n="6">Zum Beschluß Herzog <persName ref="p9708">Ulrichs von Württemberg</persName>, die Bilder aus den Kirchen zu entfernen, s. oben <ref target="file11089">Nr. 1046</ref>, 13-15 mit Anm. 10.</note> iam exequenda est, quanquam hoc <lb xml:id="p1z20"/>invitis quibusdam.</s>
					<s n="10" xml:lang="la">Deinde nihil legisse <lb xml:id="p1z21"/>nos inquit durius scripto quodam publico <persName ref="p8375">regis</persName> <lb xml:id="p1z22"/><placeName ref="l830">Angliae</placeName> contra concilii institutionem<note xml:id="fn7" type="footnote" n="7">Die Schrift, in der König <persName ref="p8375">Heinrich VIII.</persName> das Konzil in scharfer Form ablehnte (<bibl source="b171">CT</bibl> XII 767-774), fand in mehreren deutschen Übersetzungen welte Verbreitung; s. <bibl>VD 16, E 1326-1329</bibl>; vgl. Friedrich <hi>Prüser,</hi> England und die Schmalkaldener 1535-1540, Leipzig 1929. - <bibl source="b518">QFRG</bibl> XI, S. 111f. 119.</note>.</s>
					<s n="11" xml:lang="la">Sed non <lb xml:id="p1z23"/>habet secum; alioqui misissem ad te.</s>
					<s n="12" xml:lang="la">Forte <lb xml:id="p1z24"/>ex nundinis allatum est per <persName ref="p4851">Froschoferum</persName><note xml:id="fn8" type="footnote" n="8">An der <placeName ref="l157">Frankfurter</placeName> Messe wurde das Büchlein kostenlos verteilt; s. Hubert <hi>Jedin,</hi> Geschichte des Konzils von Trient, Bd. I, Freiburg 1951, S. 557, Anm. 91.</note>.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z25"/>Alia nihil habeo ex illo, quod te<pb type="edition" next="287"/> scire referat.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z26"/>Dolet illi, quod fratres aliquot misere negliguntur <lb xml:id="p1z27"/>in ditione ducis<note xml:id="fn9" type="footnote" n="9">Konkret ist vielleicht die Entlassung von <persName ref="p8087">Hieronymus Kranz</persName> gemeint (s. oben <ref target="file11056">Nr. 1014</ref>, 2-12; 1018, 50-75); vgl. aber auch die Klagen von <persName ref="p1999">Konrad Lüthard</persName> (oben <ref target="file11061">Nr. 1019</ref>) und <persName ref="p6705">Wolfgang Steyrer</persName> (oben <ref target="file11075">Nr. 1033</ref>, 12-20).</note>; cum vero per ipsum non <lb xml:id="p1z28"/>omnia possint ordine obtineri, invocandus <lb xml:id="p1z29"/>est certe dominus, ne ingratitudo ista causae <lb xml:id="p1z30"/>aliquando noceat.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb type="scan" next="||38"/><pb/><lb xml:id="p2z1"/>Unum hoc miror, <persName ref="p467">Bucerum</persName> et <persName ref="p5565">Capitonem</persName> non <lb xml:id="p2z2"/>idem egisse apud vos, quod egerunt <placeName ref="l41">Bernae</placeName>.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z3"/>Tu da operam, ut, si non iniqua dederunt <lb xml:id="p2z4"/><placeName ref="l41">Bernates</placeName>, etiam vos ne gravemini dare, <lb xml:id="p2z5"/>idque unitatis studio.</s>
					<s n="17" xml:lang="la">Atque utinam ultro vos <lb xml:id="p2z6"/>scriberetis <placeName ref="l491">Argentinensibus</placeName> lectam et expensam <lb xml:id="p2z7"/>cum <placeName ref="l41">Bernatibus</placeName> actionem etiam vobis facere <lb xml:id="p2z8"/>satis et omnino eandem vobis mentem esse cum <lb xml:id="p2z9"/>illis.</s>
					<s n="18" xml:lang="la">Hinc <placeName ref="l491">Argentinensibus</placeName> abriperetur omnis <lb xml:id="p2z10"/>occasio simultatis erga vos, et inter vos ipsos <lb xml:id="p2z11"/>firmaretur concordia.</s>
					<s n="19" xml:lang="la">Dudum enim habuerunt <lb xml:id="p2z12"/><placeName ref="l28">Basilienses</placeName>, nunc etiam <placeName ref="l41">Bernenses</placeName> forte; vos <lb xml:id="p2z13"/>iam<note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> iam <hi>gestrichenes</hi> m[?].</note> soli videbimini oppugnatores concordiae, <lb xml:id="p2z14"/>atque <placeName ref="l41">Bernates</placeName> haud dubie nihil dederunt, quam quod <lb xml:id="p2z15"/>per dominum dari potuit.</s>
					<s n="20" xml:lang="la">Optarem vos illis omnino annumerari.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="farewell"><lb xml:id="p2z16"/>Sed vale cum <persName ref="p8051">uxore</persName><note xml:id="fn10" type="footnote" ana="bio" n="10"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> cumq<lb xml:id="p2z17"/>ue <lb xml:id="p2z18"/>liberis omnibus<note xml:id="fn11" type="footnote" n="11">Siehe <bibl source="b8">HBBW VI</bibl> <ref target="file10782">[Nr. 744]</ref>, S. 124, Anm. 34.</note>, imo tota ecclesia.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">16. octobris <lb xml:id="p2z19"/>1537.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p2z22"/>Tuus, tuus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
