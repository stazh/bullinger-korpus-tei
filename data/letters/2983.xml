	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l280">Lausan[<lb xml:id="p1z2"/>nae]</placeName>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Literae, quas mihi deferendas d. <persName ref="p8018">Hallero</persName> tradidisti, <persName ref="p495">Bullingere</persName> <lb xml:id="p1z4"/>optime, mea multum iuvarunt negotia.</s>
					<s n="3" xml:lang="la">Cum enim <placeName ref="l41">Bernam</placeName> venissem <lb xml:id="p1z5"/>et nullum meorum illic reperissem, illa omnia mea confecit; nam <lb xml:id="p1z6"/>et hospitio benignissime excepit et comitem diligentissime quesivit, <lb xml:id="p1z7"/>qui me <placeName ref="l280">Lausannam</placeName> comitaret.</s>
					<s n="4" xml:lang="la">Haec autem omnia, quia mei mentionem <lb xml:id="p1z8"/>tu feceras in illius literis, ille fecit.</s>
					<s n="5" xml:lang="la">Tibi igitur gratias ago, quod me <lb xml:id="p1z9"/>benigne tam benigno viro commendare dignatus es, teque rogo, ut <lb xml:id="p1z10"/>illi gratias agas pro prestita in me humanitate; ego vero <lb xml:id="p1z11"/>me utrique vestrum devinctissimum profiteor.</s>
					<s n="6" xml:lang="la">Deus optimus maximus <lb xml:id="p1z12"/>te diu conservet ecclesiae suae utilem ministrum!</s>
					<s n="7" xml:lang="la" ana="salute">Saluta, queso, <lb xml:id="p1z13"/>meo nomine d. <persName ref="p8461">Ioannem Iacobum Wikium</persName>, hospitem meum humanissimum.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z14"/>Vale.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Raptim 12. augusti.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Tuus in Christo <persName ref="p2866">Thomas Sampson</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bullingero</persName> <lb xml:id="p2z3"/>dentur hae.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tyguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
