	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literas tuas d. <persName ref="p8126">Oporino</persName> inscriptas illico exhibui, <lb xml:id="p1z3"/>qui et respondet, verum alteras ad comitem <persName>Georgium</persName> mittere nondum <lb xml:id="p1z4"/>potui, verum his diebus promisit se curaturum, qui eius domum hic <lb xml:id="p1z5"/>inhabitat.</s>
					<s n="3" xml:lang="la"><placeName ref="l830">Angli</placeName> apud nos agentes maerent admodum, quod non sint recepti <lb xml:id="p1z6"/>a nostris fratres ipsorum, et, ut video, laborandum nobis erit, ut eos retineam<lb xml:id="p1z7"/>us, quibus hactenus facta estinhabitandi copia; adeo re<lb xml:id="p1z8"/>frigescit charitas erga viscera Christi.</s>
					<s n="4" xml:lang="la">Quid consilii d. <persName ref="p1911">Levero</persName> <lb xml:id="p1z9"/>dederis, scire cupio, cuius viri consuetudo mihi multo fuisset gratissim <lb xml:id="p1z10"/>futura, si hic degere contigisset; adeo videor mihi synceram ardentemque <lb xml:id="p1z11"/>pietatem cum summa iudicii moderatione et suavitate morum coniunctam <lb xml:id="p1z12"/>animadvertisse.</s>
					<s n="5" xml:lang="la">Dominum Iesum precor, ut sanctum hoc pectus cum suis misericorditer <lb xml:id="p1z13"/>dirigat et conservet.</s>
					<s n="6" xml:lang="la">Ex <placeName ref="l808">Belgis</placeName> scribit <persName ref="p6920">Vesalius</persName> Caesarem <lb xml:id="p1z14"/>cancellaria sua divulsisse et iam privatum agere nec ultra 12 hominum <lb xml:id="p1z15"/>ministerio ut.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Bene vale in Christo Iesu cum tuis omnibus, <lb xml:id="p1z16"/>quos cupio salutes meis verbis reverenter.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l28">Basileae</placeName> 6. maii <lb xml:id="p1z17"/>anno 1557.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z18"/>Tuus <persName ref="p3099">Sulcerus</persName><lb xml:id="p1z19"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro praestantissimo d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, domino <lb xml:id="p2z3"/>et fratri colendissimo <lb xml:id="p2z4"/>suo.</s>
				</p>
			</div>
		</body>
