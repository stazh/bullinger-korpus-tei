	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Quaeso, d. compater, ut, quae de potestate magistratus <lb xml:id="p1z2"/>ac consimilibus aliis tuo iussu Germanice scripsi [et] <lb xml:id="p1z3"/>ad te misi, per d. <persName ref="p540">Calvinum</persName> vel alium quempiam <lb xml:id="p1z4"/>fidelem hominem ad me remittas; sunt enim diligentius <lb xml:id="p1z5"/>inspicienda et moderanda, ne quam mihi tra<lb xml:id="p1z6"/>gediam homini peregrino excitent.</s>
					<s n="3" xml:lang="la">Dominus te conservet <lb xml:id="p1z7"/>cum tuis omnibus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la" ana="salute">Salutem dominis et fratribus et d. <persName ref="p506">Butlero</persName>.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/><persName ref="p8417">W[olfgangus] Musc[ulus]</persName> compater tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
