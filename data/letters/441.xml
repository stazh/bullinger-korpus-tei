	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. ut uxorem tuam honorarem hocce fasciculo lini expoliti et fabre<lb xml:id="p1z2"/>facti, senatus noster iussit, ne non haberes vel tantillum argumentum <lb xml:id="p1z3"/>voluntatis eius tuae beneficentiae memoris, et habeo certum, quam <lb xml:id="p1z4"/>cuperet, te ornari liberaliter; verum quam alienum sit id genus <lb xml:id="p1z5"/>quantumvis honestum officium a tuis moribus tuaque functione, <lb xml:id="p1z6"/>pernovit.</s>
					<s n="2" xml:lang="la">Proinde quando a tuis habes, quod ad victum attinet, <lb xml:id="p1z7"/>certe hinc habebis, quod et ad amictum faciat; quod ne apostoli <lb xml:id="p1z8"/>quidem ipsi, arbitror, oblatum sibi respuissent.</s>
					<s n="3" xml:lang="la">Sinito igitur, te, clarissim<lb xml:id="p1z9"/>e vir, hac in parte impetrari et persuaderi, ut munus <lb xml:id="p1z10"/>tantulum offerri coniugi non dedigneris.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Nihil enim minus nostri <lb xml:id="p1z11"/>cogitant, quam vel bonitate tua vel pietate abuti, atque hoc <lb xml:id="p1z12"/>uno maxime nomine te amamus, <persName ref="p495">Bullingere</persName>, omnes, qui Christo <placeName ref="l473">S. <lb xml:id="p1z13"/>Galli</placeName> nomen dedimus, quod eruditionis tuae munere cottidie <lb xml:id="p1z14"/>proficimus de dieque in diem melius habemus.</s>
					<s n="5" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><placeName ref="l473">Sangalli</placeName> XX<lb xml:id="p1z15"/>I. Februarii anno MDXLIX.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z16"/><persName ref="p8049">Ioachimus Vadianus</persName>, <lb xml:id="p1z17"/>tuus totus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="8" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro D. <persName ref="p495">Henryco <lb xml:id="p2z2"/>Bullingero</persName>, celebris <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> episcopo, <lb xml:id="p2z4"/>domino suo colendissimo.</s>
				</p>
			</div>
