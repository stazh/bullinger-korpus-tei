			<zone xml:id="p2z5-0" points="431,1660 614,1664 729,1623 828,1665 901,1622 1068,1667 1203,1658 1203,1545 1096,1523 1011,1578 851,1514 760,1574 618,1537 537,1572 488,1545 431,1566">438,1597 476,1600 514,1598 553,1597 591,1597 630,1598 668,1600 706,1600 745,1595 783,1598 822,1598 860,1597 898,1597 937,1597 975,1600 1014,1600 1052,1596 1090,1594 1129,1595 1167,1598 1206,1600</zone>
