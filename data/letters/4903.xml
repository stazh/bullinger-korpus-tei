	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ego, reverende in Christo pater, plane nihil scripturus <lb xml:id="p1z2"/>fueram, propterea quod non haberem, cui darem nec <lb xml:id="p1z3"/>praeterea esset, quod te scire magnopere referret.</s>
					<s n="3" xml:lang="la" ana="salute"><lb xml:id="p1z4"/>Nunc praeter opinionem venit <persName ref="p6055">Petrus Perna</persName> <placeName ref="l522">Venetiis</placeName>, <lb xml:id="p1z5"/>qui salutandi mea gratia cum me convenisset, <lb xml:id="p1z6"/>inter alia dicit se <placeName ref="l522">Venetiis</placeName> ex magno viro audiisse <lb xml:id="p1z7"/>sex catholicos (ita appellant) et 6 evangelicos futuro <lb xml:id="p1z8"/>colloquio deputatos et inter alios te nominat; <lb xml:id="p1z9"/>scripserat idem iam ante quidam <placeName ref="l587">Tiguro</placeName>.</s>
					<s n="4" xml:lang="la">Tu nescio <lb xml:id="p1z10"/>quid in tuis literis dissimulare videris; rogo ergo <lb xml:id="p1z11"/>te, mi pater, ut, quoniam <placeName ref="l522">Venetiis</placeName> haec ad nos afferuntur, <lb xml:id="p1z12"/>ne patiaris nos verum diutius ignorare.</s>
					<s n="5" xml:lang="la">Quod <lb xml:id="p1z13"/>ad tua mandata attinet, ero memor; nunc non <lb xml:id="p1z14"/>possum plura.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Vale cum tuis omnibus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Non relegi.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/><placeName ref="l98">Curię</placeName> 5. augusti anno domini 1561.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>Tui observantissimus <lb xml:id="p1z17"/><persName ref="p8009">Fabricius</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vere magno viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullinger</persName>o, <lb xml:id="p2z3"/>domino <lb xml:id="p2z4"/>suo.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="de"><lb xml:id="p2z6"/>An <persName ref="p495">h. Bullinger</persName>.</s>
				</p>
			</div>
		</body>
	</text>
