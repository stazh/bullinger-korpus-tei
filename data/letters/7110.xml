					<s n="2" xml:lang="la">Historiam seu verius tragicam rerum <lb xml:id="p1z2"/>inferioris nostrae patriae narrationem pluribus perse<lb xml:id="p1z3"/>querer, vir clarissime, nisi hunc manum habeam, <lb xml:id="p1z4"/>qui eam ita exacte tenet, ut nulla scriptione nostra <lb xml:id="p1z5"/>sit opus.</s>
					<s n="3" xml:lang="la">Commendo autem illum eo nomine, quo <lb xml:id="p1z6"/>debent pii et christiani commendari.</s>
					<s n="4" xml:lang="la">Utinam illi <lb xml:id="p1z7"/>apud vos, si ita ferant ipsius rationes, locus <lb xml:id="p1z8"/>habitandi esse possit.</s>
					<s n="5" xml:lang="la">Scripsi haec ex itinere, <lb xml:id="p1z9"/>cum eum deducendi ad primam urbeculam occasio <lb xml:id="p1z10"/>oblata est.</s>
					<s n="6" xml:lang="la">Plura nunc scribere non <lb xml:id="p1z11"/>possum; urget enim qualecunque hoc a me scriptum.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Velim etiam et me et ipsum d. <persName ref="p8011">Galtero</persName><note type="margin">a.R.: -a!</note> com<lb xml:id="p1z13"/>mendatum reddas.</s>
					<s n="8" xml:lang="la">D. <persName ref="p8033">Beza</persName> ad te scribit <lb xml:id="p1z14"/>de rebus nostris.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Bene vale, vir praestantissime.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z15"/>Ex itinere raptim <lb xml:id="p1z16"/>22. maii 1567.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z17"/>Tui observantissimus <lb xml:id="p1z18"/><persName ref="p684">Crispinus</persName><pb/><lb xml:id="p2z8"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
