	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi his diebus aliquoties.</s>
					<s n="3" xml:lang="la">Illis nihil habeo quod <lb xml:id="p1z2"/>nunc addam, nisi quod interea mihi tuae demum <lb xml:id="p1z3"/>redditae sunt, in quibus scribis de <persName ref="p475">Christophoro</persName>, filio <lb xml:id="p1z4"/>tuo, quam liberaliter ille a lantgravio feudis <lb xml:id="p1z5"/>quibusdam donatus sit.</s>
					<s n="4" xml:lang="la">Quo nomine tibi tuisque <lb xml:id="p1z6"/>omnibus gratulor et oro deum, ut tuos omnes perpetua <lb xml:id="p1z7"/>benedictione prosequatur.</s>
					<s n="5" xml:lang="la">Benedicit etiam meis dominus, <lb xml:id="p1z8"/>quo nomine est, quod illi gratias agam.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Filius meus <lb xml:id="p1z9"/>commodam sibi valde adeptus est conditionem; mecum <lb xml:id="p1z10"/>enim habitat et interea non procul ab urbe concionatur.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>Missurus eram eum in <placeName ref="l832">Galliam</placeName>; sed praesens rerum <lb xml:id="p1z12"/>status facit, ut nemo amicorum hoc mihi consulat.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z13"/>Novi nihil habemus.</s>
					<s n="9" xml:lang="la">Expecto hodie <persName>Blasium</persName> meum <lb xml:id="p1z14"/>et uxorem eius, meam filiam.</s>
					<s n="10" xml:lang="la">Dominus te servet <lb xml:id="p1z15"/>cum tuis omnibus!</s>
					<s n="11" xml:lang="la" ana="salute">Salutant te <persName ref="p8063">Steigerus</persName>, <persName ref="p7511">Gra<lb xml:id="p1z16"/>venrietus</persName>, <persName ref="p21017">Manuel</persName>, amici denique et fratres omnes.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z17"/><persName ref="p8417">Musculus</persName> heri laborare cepit capitis dolore; speramus <lb xml:id="p1z18"/>tamen hodie rem esse extra periculum.</s>
					<s n="13" xml:lang="la" ana="salute">Is te quoque salutat <lb xml:id="p1z19"/>et scribet tibi, postquam etiam exemplar tui Esaię acceperit.</s>
					<s n="14" xml:lang="la">Ego <lb xml:id="p1z20"/>in proximis meis pro meo egi gratias.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Vale.</s>
					<s n="16" xml:lang="la"><placeName ref="l41">Bernę</placeName> <lb xml:id="p1z21"/>24. martii 1567.</s>
				</p>
				<p>
