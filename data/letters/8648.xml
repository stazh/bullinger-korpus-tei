	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S. D.</s>
					<s n="2" xml:lang="la">Ago gratias pro missis tuis ad me literis, <lb xml:id="p1z3"/>affinis dilectissime.</s>
					<s n="3" xml:lang="la">Rem<lb xml:id="p1z4"/>itto eas; retinui des<lb xml:id="p1z5"/>cribenda, quae voluisti.</s>
					<s n="4" xml:lang="la">Queror ego plurimum hominum <lb xml:id="p1z6"/>insaniam; praecedunt haec certo certum interitum.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/><persName>Ciserius</persName>, qui abhinc quatriduo ex <placeName ref="l834">Italia</placeName> rediit, <lb xml:id="p1z8"/>heri ea mihi retulit, quae leges in epistola <lb xml:id="p1z9"/>ad d. <persName ref="p2473">Parchurstum</persName> nostrum scripta; mitto enim hanc et <lb xml:id="p1z10"/>aliquot epistolas ad filios nostros scriptas et ad aliquot <lb xml:id="p1z11"/>in <placeName ref="l830">Anglia</placeName> viros, ex quibus omnium aliarum <lb xml:id="p1z12"/>argumenta intelliges.</s>
					<s n="6" xml:lang="la">Communico has tibi, ut nostra <lb xml:id="p1z13"/>ad viros illos scripta omnia consentiant; tu sub <lb xml:id="p1z14"/>vesperam per hunc tuum colonum remittes omnia <lb xml:id="p1z15"/>una cum literis ad me <persName>Stettani</persName> nostri, quas etiam <lb xml:id="p1z16"/>mitto.</s>
					<s n="7" xml:lang="la">Audio <persName ref="p4183">Iacobum Andreae</persName>, fatalem illum hominem, <lb xml:id="p1z17"/>fuisse <placeName ref="l327">Montbelgardi</placeName> et statutum esse, ut, qui <lb xml:id="p1z18"/>n<lb xml:id="p1z19"/>on subscripserit Confessioni <lb xml:id="p1z20"/><placeName ref="l18">Augustanae</placeName> intra 3 <lb xml:id="p1z21"/>menses solum vertat... una(?) cum nostro d. <persName ref="p6820">Tossano</persName>.</s>
					<s n="8" xml:lang="la">Quid, si <persName ref="p18477">Ferdinandus</persName> <lb xml:id="p1z22"/>mortuo <persName>principe Wirtenbergico</persName> occupet uni<lb xml:id="p1z23"/>versam illam ditionem?</s>
					<s n="9" xml:lang="la">Mira sunt dei iudicia.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z24"/>Non possum tibi certo recensere, quae acta sunt <lb xml:id="p1z25"/>in comitiis <placeName>Aaroviensibus</placeName>; non enim saepe quesitum <lb xml:id="p1z26"/>quaestorem domi suae inveni.</s>
					<s n="11" xml:lang="la">Caeteri <lb xml:id="p1z27"/>amici nil certi referunt.</s>
					<s n="12" xml:lang="la">Hodie demum audio <lb xml:id="p1z28"/>negotium omne senatui esse expositum; ubi resciero, <lb xml:id="p1z29"/>significabo.</s>
					<s n="13" xml:lang="la">Triticum heri veniit 12 (...?<lb xml:id="p1z30"/>), quae res supra modum me affligit ut et res aliae <lb xml:id="p1z31"/>graves et periculosae.</s>
					<s n="14" xml:lang="la">Dominus adsit nobis <lb xml:id="p1z32"/>clemens et propitius et benedicat tibi tuisque <lb xml:id="p1z33"/>ac servet ab omni malo.</s>
					<s n="15" xml:lang="la">Totus iam sum in <lb xml:id="p1z34"/>scribendis literis <persName ref="p1227">Froschouero</persName> tradendis, qui <lb xml:id="p1z35"/>discedet vel 29. vel 30. huius mensis.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="salute">Omnes <lb xml:id="p1z36"/>mei te tuosque salutant.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Festinantissime <placeName ref="l587">Tiguri</placeName> 25. aug<lb xml:id="p1z37"/>usti 1571.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Utinam <lb xml:id="p1z38"/>mox salvus <lb xml:id="p1z39"/>et incolumis ad nos redeas.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z40"/><persName ref="p495">Bullingerus</persName> tuissimus.</s>
				</p>
				<p>
					<s n="20" xml:lang="de"><pb/><lb xml:id="p2z1"/>Minem früntlichen, <lb xml:id="p2z2"/>fürgeliepten herren <lb xml:id="p2z3"/>und schwagern h. <lb xml:id="p2z4"/><persName ref="p8011">Rodolffen Gwaltheren</persName> zuͦ <lb xml:id="p2z5"/><placeName ref="l515">Urdorff</placeName>.</s>
				</p>
			</div>
