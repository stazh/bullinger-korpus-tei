	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsit d. <persName ref="p1365">Grynęus</persName> mihi<note xml:id="fn1" type="footnote" n="1">Der Bericht, den <persName ref="p1365">Grynäus</persName> aus <placeName ref="l569">Worms</placeName> an <persName ref="p8418">Myconius</persName> sandte, ist nicht erhalten.</note> conditione adiuncta, ut literas<note xml:id="fna" type="footnote" n="a"><hi>in der Vorlage</hi> literias.</note> descriptas mitterem <lb xml:id="p1z2"/>ad vos una cum catalogo eorum, qui ad conventum destinati sunt<note xml:id="fn2" type="footnote" n="2">Ein vorläufiges Verzeichnis katholischer und protestantischer Delegierter findet sich in einer Abschrift von <persName ref="p495">Bullingers</persName> Hand in Zürich StA, E II 350, 355-357.</note>.</s>
					<s n="3" xml:lang="la">De rebus istis <lb xml:id="p1z3"/>non est, ut pluribus dicam; quid agatur enim <placeName ref="l569">Wormacię</placeName>, ex eius literis facile <lb xml:id="p1z4"/>deprehendetis.</s>
					<s n="4" xml:lang="la">Addo, quę in illis non habentur: Caesar<note xml:id="fn3" type="footnote" n="3"><persName ref="p18538">Karl V.</persName></note> in altero pede laborat <lb xml:id="p1z5"/>morbo, quem nos lupum<note xml:id="fn4" type="footnote" n="4">Vgl. <bibl source="b590">SI</bibl> XV 1556f.</note> vocamus, ut nec ingredi nec equitare valeat, sed <lb xml:id="p1z6"/>lectica vehatur.</s>
					<s n="5" xml:lang="la">Dein optimi quique ex consiliariis eius mortem obierunt<note xml:id="fn5" type="footnote" n="5">Am 28. Dezember 1539 war <persName ref="p5139">Jan Hannart</persName> gestorben, am 2. April 1540 <persName ref="p7609">Antoine de Lalaing</persName>, Graf von <placeName ref="l2042">Hoogstraten</placeName>, am 5. August 1540 <persName ref="p5381">Jean Jonglet</persName>; vgl. Michel <hi>Baelde,</hi> De collaterale raden onder Karel V en Filips II (1531-1578), Brüssel 1965. - Verhandelingen van de Koninklijke Vlaamse Academie voor wetenschappen, letteren en schone kunsten van België, Klasse der letteren, Nr. 60, S. 266f. 270-272.</note>.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z7"/>Ob tyrannidem miserabili odio prosequuntur eum <placeName ref="l20">Inferioris Germanię</placeName> p<lb xml:id="p1z8"/>opuli, adeo ut non caesaris, sed ducis <placeName ref="l640">Flandrię</placeName> nomine vocitent.</s>
					<s n="7" xml:lang="la">Hęc adiecta <lb xml:id="p1z9"/>volui, ne nihil scriberem.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Valete cum vestris in Christo.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l28">Basileae</placeName>, raptim, <lb xml:id="p1z10"/>12. novembris anno 40.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z11"/><persName ref="p8418">Os. Myconius</persName> <lb xml:id="p1z12"/>vester.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho Bul<lb xml:id="p2z2"/>lingero</persName> et fratribus <lb xml:id="p2z3"/>reliquis, ministris <lb xml:id="p2z4"/>Christi, suis in domino.</s>
					<s n="12" xml:lang="de"><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
