	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Sub nundinarum <placeName ref="l157">Francophordensium</placeName> tempus ad te <lb xml:id="p1z2"/>scripsi<note xml:id="fn3" type="footnote" n="3">am 10. April, oben Nr. 000.</note>, mi d. <persName ref="p495">Bulinger</persName>e, quas meas literas per vestros <lb xml:id="p1z3"/>typographos ad te perlatas arbitror.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="3" xml:lang="la">Et quamquam hoc <lb xml:id="p1z4"/>tempore nihil admodum scriptione dignum haberem, <lb xml:id="p1z5"/>tamen, cum hic civis isthuc proficisci pararet, ad te <lb xml:id="p1z6"/>scribendum esse mihi putavi, ut responderem et tuae <lb xml:id="p1z7"/>peticioni et meae promissioni in penultimis meis.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Per quem tuto recribere poteris, si modo tua n<lb xml:id="p1z9"/>egocia tantum temporis tibi concesserint.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="5" xml:lang="la">In vestra <lb xml:id="p1z10"/>Confessione legi de <persName ref="p4505">Campano</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p4505">Johannes Campanus</persName>, vgl. <bibl source="b4">HBBW II</bibl> 214, Anm. 55.</note>, quem vobis scribi<lb xml:id="p1z11"/>tis prorsus ignotum esse<note xml:id="fn5" type="footnote" n="5">Warhaffte Bekanntnuß... (<bibl source="b286">HBBibl</bibl> I 161), 116r., bzw. Orthodoxa <placeName ref="l587">Tigurinae</placeName> ecclesiae ministrorum Confessio... (<bibl source="b286">HBBibl</bibl> I 167), 109r.</note>, quod mihi sane mirum visum <lb xml:id="p1z12"/>est; nam vel ex publicis rumoribus aliquid de illo <lb xml:id="p1z13"/>errore ad vos pervenisse debuerat.</s>
					<s n="6" xml:lang="la">Ego memini temporis, <lb xml:id="p1z14"/>quo adolescente <placeName ref="l267">Coloniae</placeName> se obtulit ad pub<lb xml:id="p1z15"/>licam disputationem contra meos <placeName ref="l267">Colonienses</placeName> sophistas <lb xml:id="p1z16"/>et mittebat pias aliquot propositiones, quae adhuc, ut <lb xml:id="p1z17"/>puto, <placeName ref="l267">Coloniae</placeName> inter bonos viros reperiri possent.</s>
					<s n="7" xml:lang="la">Nunc <lb xml:id="p1z18"/>vero, quantum in eo est, papatum libenter erigere vellet <lb xml:id="p1z19"/>et in hoc totus est, ut purgatorium astruat, de quo <lb xml:id="p1z20"/>volumen quoddam scripsit, quod est approbatum a <lb xml:id="p1z21"/>meis summis amicis theologastris <placeName ref="l267">Coloniensibus</placeName>.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z22"/>Eius mittam brevi, et ubi certum ad te habere potero, <lb xml:id="p1z23"/>exemplo.</s>
					<s n="9" xml:lang="la">Iam et brevitas temporis et occupationes <lb xml:id="p1z24"/>plura scribere prohibent.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale in domino et ignosce <lb xml:id="p1z25"/>meis notulis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">18. maii 1546.</s>
					<s n="12" xml:lang="la"><placeName ref="l56">Bonnae</placeName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p2262">Petrus Medmannus</persName> tuus.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z27"/>Ubi misero assertionem purgatorii, simul etiam <lb xml:id="p1z29"/>de <persName ref="p4505">Campano</persName> copiosius.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bulingero</persName>, in ecclesia <placeName ref="l587">Tigurina</placeName> <lb xml:id="p2z3"/>professori sacrarum literarum <lb xml:id="p2z4"/>diligentissimo, etc., suo <lb xml:id="p2z5"/>modis omnibus s[alutem[?]].</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
