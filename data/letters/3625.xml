	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Nihil habeo singulare, frater et compater <lb xml:id="p1z2"/>charissime, dedi tamen has ad te, ne hic noster <persName ref="p5669">Lindin<lb xml:id="p1z3"/>erus</persName> ad te rediret vacuus et omnino sine literis.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Vivimus hic per dei gratiam recte satis <foreign xml:lang="de">mitt müy <lb xml:id="p1z5"/>und grosser arbeit etc.</foreign></s>
				</p>
				<p>
					<s n="4" xml:lang="la">Comitia celebrantur <placeName ref="l21">Badae</placeName>; <lb xml:id="p1z6"/>nihil audimus, quid agatur ibi.</s>
					<s n="5" xml:lang="la">Fama est petendum <lb xml:id="p1z7"/>a rege militem <placeName ref="l862">Helveticum</placeName>; nil certi assevero.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/><persName ref="p8112">Rex Galliae</persName> prior suos eduxit exercitus ac <lb xml:id="p1z9"/><placeName ref="l1922">Theodonis Villam</placeName> <note>(Diettenhoffen / a. Rd.)</note> obsedit in confiniis <placeName ref="l691">Lothoringiae</placeName> <lb xml:id="p1z10"/>et <placeName ref="l39">Luxemburgensis</placeName> ducatus ad <placeName>Mosam</placeName> non procu<lb xml:id="p1z11"/>l a <placeName ref="l322">Mediomatricum</placeName> urbe, quam <placeName ref="l322">Metim</placeName> vocant.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Dicitur <lb xml:id="p1z12"/>bombardis urbi admodum esse molestus.</s>
					<s n="8" xml:lang="la"><placeName ref="l491">Argentina</placeName> <lb xml:id="p1z13"/>sibi metuit ac praesidium 10 signorum <lb xml:id="p1z14"/>sibi paravit, 6 extra urbem, in urbe 4.</s>
					<s n="9" xml:lang="la">Ex <lb xml:id="p1z15"/><placeName ref="l822">Germania</placeName> insignem equitatum dux <placeName ref="l749">Saxoniae</placeName> iunior, <lb xml:id="p1z16"/>electoris capti filius, et lantgravii filius duxere <lb xml:id="p1z17"/>in <placeName ref="l832">Galliam</placeName>.</s>
					<s n="10" xml:lang="la"><placeName ref="l822">Germanorum</placeName> peditum dicitur <persName>Gallus</persName> <lb xml:id="p1z18"/>habere legiones 10; legionem voco, quam hodie app<lb xml:id="p1z19"/>ellant "regimentum", 10 habens signa.</s>
					<s n="11" xml:lang="la"><persName>Philippus</persName> ad <lb xml:id="p1z20"/>Traiectum <placeName ref="l1772">Mosę</placeName> (vulgo vocant <placeName ref="l1772">Maßtrycht</placeName>) <lb xml:id="p1z21"/>ingentes facit apparatus ac fortasse iam in <lb xml:id="p1z22"/><placeName ref="l832">Gallum</placeName> movet.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Huius lugubris tragoediae <lb xml:id="p1z23"/>auspex fuit, qui iam <placeName ref="l425">Romae</placeName> veluti in ganea <lb xml:id="p1z24"/>subat.</s>
					<s n="13" xml:lang="la">Dominus iustus iudex rependat ei.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z25"/>A <persName>Theodonis</persName> Villa adversus rumor adfertur.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z26"/>Alii enim dicunt oppugnatam et captam <lb xml:id="p1z27"/>esse urbem magna cum strage Gallorum victorum, <lb xml:id="p1z28"/>alii repulsos et frustratos aiunt <placeName ref="l832">Gallos</placeName> <lb xml:id="p1z29"/>sua spe.</s>
					<s n="16" xml:lang="la">- Ex <placeName ref="l546">Vienna</placeName> nunciatur metum esse, <lb xml:id="p1z30"/>ne <persName ref="p18477">Ferdinandus</persName> persequtionem moveat in <lb xml:id="p1z31"/>fideles, ne <placeName ref="l2510">Turca</placeName> quoque bellum inferat.</s>
					<s n="17" xml:lang="la">Quam <lb xml:id="p1z32"/>vellem hoc tempore d. <persName>Friderychum</persName> non descend<lb xml:id="p1z33"/>isse in illas partes, unde non citra ingens <lb xml:id="p1z34"/>emerget discrimen.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Dominus illum tueatur et reducat!</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z35"/>Duo eius pueri me insalutato et nihil <lb xml:id="p1z36"/>tale merente discesserunt.</s>
					<s n="20" xml:lang="la">Scripsi ego, si<lb xml:id="p1z37"/>mulatque intellexissem discessisse, <persName>Friderycho</persName> et <lb xml:id="p1z38"/><persName ref="p6283">Caspari a Salis</persName>; literas misi ad amplissimum virum <lb xml:id="p1z39"/>d. <persName>Ambrosium Martinum</persName>, sed metuo, ne redditae <lb xml:id="p1z40"/>sint istis iam in itinere existentibus; ea de <lb xml:id="p1z41"/>re si quid habes certi, significa.</s>
					<s n="21" xml:lang="de">Ich bin gar nitt ze <lb xml:id="p1z42"/>friden mitt den buͦben und denen, die inen <lb xml:id="p1z43"/>glimpffind etc.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Habes hic partem meorum <pb/><lb xml:id="p2z1"/>laborum; alterius generis et copiosius opus deo <lb xml:id="p2z2"/>volente brevi etiam accipies; in eo iam sudo.</s>
					<s n="23" xml:lang="la" ana="farewell"><lb xml:id="p2z3"/>Vive et vale cum omnibus bonis.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p2z5"/>Scripsi festinantissime et pessime.</s>
					<s n="25" xml:lang="la">24. <lb xml:id="p2z6"/>iunii anno 1558.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p2z7"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Ohne Adresse.]</note>
				</p>
			</div>
		</body>
