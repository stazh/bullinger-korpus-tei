	<text xml:lang="la">
		<body>
			<div>
				<p>
					<note>[Dieser Brief kann erst nach jenem vom 21. Januar geschrieben sein.]</note>
				</p>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. Post ultimas meas ad te tuas recepi scriptas 21. huius mensis cum foliis<lb xml:id="p1z2"/>aliquot.</s>
					<s n="2" xml:lang="la">Tam fui occupatus, ut non vacaverit legere ultra octo folia <lb xml:id="p1z3"/>que valde mihi placent et profutura hoc tempore existimo, ubi venales <lb xml:id="p1z4"/>erunt, mittam domino <placeName ref="l1854">Redonensi</placeName> episcopo et in <placeName ref="l832">Gallia[m]</placeName>, cum etiam tibi <lb xml:id="p1z5"/>tempestivum videbitur et ita faciendum iudicaveris.</s>
					<s n="3" xml:lang="la">De <placeName ref="l646">Glaronensium</placeName> controversia <lb xml:id="p1z6"/>certius intelliges a d. burgimagistro, viro prudentissimo, et quantum <lb xml:id="p1z7"/>me vexarint usurarii me petentes interesse immodicum pro pecunia <persName>regis <lb xml:id="p1z8"/>Henrici</persName> nomine mutuo data.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Bono et praestanti illi viro multum debeo, <lb xml:id="p1z9"/>qui mediator extitit et molestias pertulit <persName>Pfifferi</persName>.</s>
					<s n="5" xml:lang="la">Bullam, quam <lb xml:id="p1z10"/>desideras, ad te mitto, quę vere erit bulla.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><placeName ref="l2448">Quinquepagicorum</placeName> legatos <lb xml:id="p1z11"/>privatim conveni et multis egi de negocio <placeName ref="l646">Glaronensium</placeName>.</s>
					<s n="7" xml:lang="la">Mihi sunt polliciti <lb xml:id="p1z12"/>placata omnia seque quietiora consilia sequuturos.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Salutabis <lb xml:id="p1z13"/>amicos omnes.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l21">Badene</placeName> 14. ianuarii.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z14"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
				</p>
			</div>
		</body>
	</text>
