	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Mulier<note xml:id="fn1" type="footnote" n="1">Unbekannt. - Zu dieser s. zuletzt <ref target="file12992">Nr. 2943</ref>,<ptr target="qvzl17208-2" type="qv"/>.</note> illa tuas<note xml:id="fn2" type="footnote" n="2"><persName ref="p8418">Myconius</persName>' Brief vom 5. Juli (<ref target="file12992">Nr. 2943</ref>).</note> mihi reddidit.</s>
					<s n="3" xml:lang="la">Ego vero, <lb xml:id="p1z2"/>quod mones<note xml:id="fn3" type="footnote" n="3">Bezug auf <persName ref="p8418">Myconius</persName>' Bitte in <ref target="file12992">Nr. 2943</ref>,<ptr target="qvzl17208-4" type="qv"/>.</note> faciam, sedulo et diligenter facio ad <lb xml:id="p1z3"/>concordiam et unanimitatem adhortans non tantum <lb xml:id="p1z4"/>nostrates, sed etiam notos atque amicos in montibus.<note xml:id="fn4" type="footnote" n="4">Gemeint ist wohl eines der Berggebiete der <placeName ref="l803">Zürcher Landschaft</placeName>.</note></s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Recte enim iudicas <placeName ref="l875">Hispanicum</placeName> illum Iovem<note xml:id="fn5" type="footnote" n="5">Kaiser <persName ref="p18538">Karl V.</persName> - In Anspielung auf <ref target="file12992">Nr. 2943</ref>,<ptr target="qvzl17208-3" type="qv"/>.</note>, <lb xml:id="p1z6"/>putridum cadaver,<note xml:id="fn6" type="footnote" n="6">Vgl. <ref target="file12921">Nr. 2872</ref>, <ptr target="qvfn17139-7" type="qv"/>; <ref target="file12992">Nr. 2943</ref>,<ptr target="qvzl17208-3" type="qv"/>.</note> non facile agressurum con<lb xml:id="p1z7"/>cordes.</s>
					<s n="5" xml:lang="la">Praeterea exoriuntur turbae in <placeName ref="l834">Italia</placeName>,<note xml:id="fn7" type="footnote" n="7">Siehe dazu zuletzt <ref target="file12992">Nr. 2943</ref>,<ptr target="qvzl17208-5" type="qv"/>.</note> quas <lb xml:id="p1z8"/>nisi sopierit, non diu potietur <placeName ref="l834">Italia</placeName>: <placeName ref="l834">Itali</placeName> vero <lb xml:id="p1z9"/>oderunt caesarem propter <placeName ref="l875">Hispanos</placeName> et <placeName ref="l875">Hispaniensem</placeName> <lb xml:id="p1z10"/>avaritiam atque arrogantiam fastumque intolle<lb xml:id="p1z11"/>rabilem.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="6" xml:lang="la">Verum, utcunque id habeat, nobis advigi<lb xml:id="p1z12"/>landum videtur: Nobis intentatur iugum!</s>
					<s n="7" xml:lang="la">Inci<lb xml:id="p1z13"/>piunt oculos recipere Helvetii et videre dolos <lb xml:id="p1z14"/>foetidi cadaveris.</s>
					<s n="8" xml:lang="la">Nam in comitiis <placeName ref="l21">Badensibus</placeName><note xml:id="fn8" type="footnote" n="8">Die <placeName ref="l21">Badener</placeName> Tagsatzung, die vom 20. Juni bis zum 15. Juli 1547 tagte; s. <ref target="file12982">Nr. 2933</ref>, <ptr target="qvfn17201-1" type="qv"/>. - Vgl. ferner <ref target="file12983">Nr. 2934</ref>,<ptr target="qvzl17202-4" type="qv"/>; <ref target="file12994">Nr. 2945</ref>,<ptr target="qvzl17217-7" type="qv"/>.</note> <lb xml:id="p1z15"/>optime inter ipsos convenit, ita ut non melius <lb xml:id="p1z16"/>intra annos 20 et amplius.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="9" xml:lang="la">Venit <persName ref="p7852">episcopus Lunden<lb xml:id="p1z17"/>sis</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p7852">Johann von Weeze</persName>, Bischof von <placeName ref="l257">Konstanz</placeName> und nominell seit 1522 Erzbischof von <placeName ref="l2283">Lund</placeName> (<placeName ref="l2520">Schweden</placeName>).</note>, qui et <placeName ref="l257">Constantiensis</placeName> appellatur, sed ingratum se <lb xml:id="p1z18"/>parumque acceptum hospitem videns mox rediit, <lb xml:id="p1z19"/>unde venerat.<note xml:id="fn10" type="footnote" n="10">Vgl. <ref target="file12994">Nr. 2945</ref>,<ptr target="qvzl17217-8" type="qv"/>.</note></s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="10" xml:lang="la">Caesari scripserunt communes literas <lb xml:id="p1z20"/><placeName ref="l862">Helvetii</placeName><note xml:id="fn11" type="footnote" n="11">Zum Brief der <placeName ref="l862">Eidgenossen</placeName> an den Kaiser datierend vom 9. Juli s. <bibl source="b197">EA</bibl> IV/1d 828f o und q; 834 zu o (mit Hinweis auf eine Veröffentlichung). Er war die Antwort auf einen Brief des Kaisers vom 27. Juni; s. <ref target="file13007">Nr. 2958</ref>, <ptr target="qvfn17224-1" type="qv"/>.<ptr target="zfnfn17220-1" type="zfn"/></note> omnes propter <placeName ref="l28">Basilienses</placeName>, <placeName ref="l335">Milhusienses</placeName> et <placeName ref="l431">Rot<lb xml:id="p1z21"/>wylanos</placeName>.</s>
					<s n="11" xml:lang="la">Flagitant responsum, id quod haud dubie <lb xml:id="p1z22"/>ex tuis<note xml:id="fn12" type="footnote" n="12">Die <placeName ref="l28">Basler</placeName> hatten den Ratsherrn <persName ref="p5269">Onofrius Holzach</persName> zur <placeName ref="l21">Badener</placeName> Tagsatzung gesandt; s. <bibl source="b197">EA</bibl> IV/1d 825.</note> melius et rectius didicisti.<note xml:id="fn13" type="footnote" n="13">Siehe dazu <ref target="file12994">Nr. 2945</ref>, <ptr target="qvfn17217-9" type="qv"/>.</note></s>
					<s n="12" xml:lang="la">Conspirarunt <lb xml:id="p1z23"/>inter se, ut dubium non sit, quin omnes <lb xml:id="p1z24"/>laeserit, qui unum ex urbibus aut pagis lae<lb xml:id="p1z25"/>sit.<pb type="edition" next="317"/></s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="13" xml:lang="la">Dissidium quoque, quod serpere coeperat propter <lb xml:id="p1z26"/>Antichristum <persName ref="p8011">Gvaltheri</persName> aeditum,<note xml:id="fn14" type="footnote" n="14">Siehe zuletzt <ref target="file12930">Nr. 2881</ref> und <ptr target="qvfn17147-4" type="qv"/>. Siehe ferner <bibl>Bächtold, Rat</bibl> 102f.</note> et ipsum sopitum <lb xml:id="p1z27"/>creditur, quod soli <placeName ref="l300">Lucernates</placeName> et <placeName ref="l2469">Undervaldii</placeName><note xml:id="fn15" type="footnote" n="15"><persName ref="p3546">Heinrich Fleckenstein</persName>, Gesandter von <placeName ref="l300">Luzern</placeName>, und <persName ref="p17980">Hans Bünti</persName>, Gesandter <placeName ref="l2469">Unterwaldens</placeName>; s. <bibl source="b197">EA</bibl> IV/1d 824.</note> <lb xml:id="p1z28"/>extra consessum cum legatis nostris<note xml:id="fn16" type="footnote" n="16"><persName ref="p1888">Hans Rudolf Lavater</persName> und <persName ref="p6793">Itelhans Thumysen</persName>; s. <ref target="file12983">Nr. 2934</ref>,<ptr target="qvzl17202-4" type="qv"/>.</note> amice loquti <lb xml:id="p1z29"/>sint et quaesti, ita tamen ut mox quaerela posita <lb xml:id="p1z30"/>omnia felicia et amica sint polliciti.</s>
					<s n="14" xml:lang="la">Utcunque <lb xml:id="p1z31"/>vero simus concordes, indigemus tamen ante omnia <lb xml:id="p1z32"/>numinis favore et spiritus divini gratia, quae <lb xml:id="p1z33"/>nos arctius et non hypocritice, sed revera con<lb xml:id="p1z34"/>glutinet.</s>
					<s n="15" xml:lang="la">Eam impetrabimus vera fide et <lb xml:id="p1z35"/>fideli poenitentia, quam nisi urserimus nos <lb xml:id="p1z36"/>et omnes pie receperimus praestiterimusque, trademur i<lb xml:id="p1z37"/>n manus hostium.</s>
					<s n="16" xml:lang="la">Simus ergo hic seduli!</s>
				</p>
			</div>
			<div xml:id="div7" corresp="regest7">
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z38"/>Quid <lb xml:id="p1z39"/>ege<lb xml:id="p1z40"/>rit <persName ref="p8296">Gallus</persName><note xml:id="fn17" type="footnote" ana="bio" n="17">Aus <bibl source="b197">EA</bibl> IV/1d 825 d und e geht hervor, dass zwei <placeName ref="l832">französische</placeName> Gesandte an der Tagsatzung teilnahmen. Ihre Vorträge sind aaO, S. 832f zu d, zusammengefasst. Es waren <persName ref="p17969">Guillaume du Plessis, sieur de Lyancourt</persName> (s. zuletzt <ref target="file12930">Nr. 2881</ref>,<ptr target="qvzl17147-7" type="qv"/>), und <persName ref="p8296">Sébastien de L'Aubespine, abbé de Bassefontaine</persName> (vgl. <ref target="file13004">Nr. 2955</ref>,<ptr target="qvzl17221-1" type="qv"/>). - Da <persName ref="p17969">Du Plessis</persName> noch vor <persName ref="p20225">Franz' I.</persName> Tod zu den <placeName ref="l862">Eidgenossen</placeName> gesandt worden war, ist hier eher von <persName ref="p8296">L'Aubespine</persName> die Rede.<ptr target="zfnfn17220-3" type="zfn"/></note> et quid regis<note xml:id="fn18" type="footnote" n="18">Heinrich II.</note> sui nomine <lb xml:id="p1z41"/>proposuerit, <lb xml:id="p1z42"/>melius nosti.</s>
				</p>
			</div>
			<div xml:id="div8" corresp="regest8">
				<p>
					<s n="18" xml:lang="la">Si quid habes certi<pb type="scan" next="v."/> <pb/><lb xml:id="p2z1"/>ex <placeName ref="l20">Inferiore Germania</placeName> et <placeName ref="l830">Anglia</placeName>, ubi ru[rsus]<note xml:id="fna" type="footnote" n="a"><hi>Hier und unten Text teils im engen Einband verdeckt.</hi></note> <lb xml:id="p2z2"/>dicitur herbescere Christus et pietas evangelica, <ptr target="fnb" type="footnote" n="b"/>fac sciam.<note xml:id="fnb" type="footnote" n="b"><hi>Fehlt in der Vorlage.</hi></note></s>
				</p>
			</div>
			<div xml:id="div9" corresp="regest9">
				<p>
					<s n="19" xml:lang="la">Va[le] una <lb xml:id="p2z3"/>cum tuis omnibus.</s>
				</p>
			</div>
			<div xml:id="div10" corresp="regest10">
				<p>
					<s n="20" xml:lang="la">Nihildum respondit d. <persName ref="p1278">G[as]tius</persName>, <lb xml:id="p2z4"/>an pecunias acceperit pro lana m[i]ssas.<note xml:id="fn19" type="footnote" n="19">Offensichtlich war <persName ref="p1278">Gasts</persName> Brief vom 14. Juli (<ref target="file12998">Nr. 2949</ref>) noch nicht in <placeName ref="l587">Zürich</placeName> eingetroffen; vgl. <ref target="file12998">Nr. 2949</ref>,<ptr target="qvzl17214-1" type="qv"/>.<ptr target="zfnfn17220-2" type="zfn"/></note></s>
					<s n="21" xml:lang="la" ana="salute">Salutabis <lb xml:id="p2z5"/>illum una cum d. <persName ref="p8032">Dryandr[o]</persName>.<note xml:id="fn20" type="footnote" n="20"><persName ref="p8032">Francisco de Enzinas</persName>.</note></s>
					<s n="22" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 16. iulii anno 1547.</s>
					<s n="23" xml:lang="la"><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse darunter:]</note>
					<s n="24" xml:lang="la"><lb xml:id="p2z6"/>Praestantissimo viro d. <persName ref="p8418">Osvaldo Myconio</persName>, observan<lb xml:id="p2z7"/>do suo domino et fratri.</s>
					<s n="25" xml:lang="de"><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>