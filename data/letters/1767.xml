	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Hae literę, quas mitto, pertinent ad bonum <lb xml:id="p1z2"/>fratrem exulantem propter evangelium.</s>
					<s n="2" xml:lang="la">Itaque <lb xml:id="p1z3"/>te oro, <persName ref="p495">H[enrice] Bull[ingere]</persName>, cura, ut ad eum <lb xml:id="p1z4"/>perferantur.</s>
					<s n="3" xml:lang="la" ana="farewell">Vale et salve.</s>
					<s n="4" xml:lang="la">Scripsi <lb xml:id="p1z5"/>ad te de <persName ref="p2807">Camillo</persName>; si tu neglexeris, <lb xml:id="p1z6"/>video omnia in eo statu esse, ut ille <lb xml:id="p1z7"/>triumphet cum suis venenis.</s>
					<s n="5" xml:lang="la">Sancte aff<lb xml:id="p1z8"/>irmo ita futurm magna piorum <lb xml:id="p1z9"/>et pietatis clade.</s>
					<s n="6" xml:lang="la">Non frustra clamo; <lb xml:id="p1z10"/>habet fautores potentes, qui possunt <lb xml:id="p1z11"/>uti aureis clypeis; eo scilicet res <lb xml:id="p1z12"/>redacta est.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ego hic in maiorib<lb xml:id="p1z13"/>us periculis versor quam unquam antea; <lb xml:id="p1z14"/>imo etiam ex fratribus aliquot adver<lb xml:id="p1z15"/>sum me cum papistis coniurarunt.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Non potest ferre diabolus patefactam <lb xml:id="p1z17"/>esse <placeName ref="l520">Vallem Tellinam</placeName> evangelio.</s>
					<s n="9" xml:lang="la">Sed <lb xml:id="p1z18"/>potentior dominus, in quo confido.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/><placeName ref="l525">Vicosoprani</placeName>, pridie kalendas dec[embres] 1552.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>ecclesiae pastori, d[omino] <lb xml:id="p2z5"/>et fratri honorando.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
