			<zone xml:id="p2z4-0" points="1661,1142 1720,1145 1786,1119 1832,1134 1897,1133 1901,1070 1883,1076 1862,1065 1843,1075 1819,1065 1759,1082 1715,1069 1694,1085 1665,1082">1668,1110 1693,1112 1719,1110 1745,1110 1771,1110 1797,1110 1823,1108 1849,1105 1875,1100 1901,1095</zone>
