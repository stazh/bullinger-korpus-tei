	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Ego, mi pater, graviter laboro; <lb xml:id="p1z2"/>sentio cruciatus incredibiles.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Est <lb xml:id="p1z3"/>cholica passio; si accesserit maior <lb xml:id="p1z4"/>inflammatio, actum de me est.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Servivi Christo, in cuius conspectu <lb xml:id="p1z6"/>brevi comparebo rationem redditurus <lb xml:id="p1z7"/>officii mei.</s>
					<s n="5" xml:lang="la">De episcopo nihil <lb xml:id="p1z8"/>est, quod timeas; tanta est <lb xml:id="p1z9"/>evangelicorum avaritia, ut omnibus <lb xml:id="p1z10"/>conatibus eorum perfidiae sit obviam <lb xml:id="p1z11"/>eundum.</s>
					<s n="6" xml:lang="la">Omnes sua quaerunt.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Si <lb xml:id="p1z12"/>deus me ex hac aerumnosa vita evocaret, <lb xml:id="p1z13"/>ne sis author, ut <placeName ref="l587">Tigurinus</placeName> amplius mittatur; <lb xml:id="p1z14"/>ad tot enim difficultates, quas haec <lb xml:id="p1z15"/>functio mea habuit, summa horum <lb xml:id="p1z16"/>hominum est ingratitudo.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Tu <lb xml:id="p1z17"/>quoque aliquam meorum liberorum curam <lb xml:id="p1z18"/>suscipe, quod te per deum immortalem <lb xml:id="p1z19"/>rogo; nam mea non quaesivi, <lb xml:id="p1z20"/>sed potius impendi, ne darem offendiculum.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z21"/>Haec <lb xml:id="p1z22"/>ego paucis vacillante manu.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Rogo deum, ut te ecclesię suae incolumem conservet.</s>
					<s n="11" xml:lang="la">Amen.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p8009">Ioannes Fabr[<pb/><lb xml:id="p2z1"/>icius</persName>] tui observantissimus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">In uno deo spes mea fixa haeret, <lb xml:id="p2z2"/>cui me meaque omnia commendo; sed <lb xml:id="p2z3"/>cura interim non deest.</s>
					<s n="14" xml:lang="la">Habemus medicum <lb xml:id="p2z4"/>peritissimum; is clysteribus obstructionibus <lb xml:id="p2z5"/>et inflammationibus obviam it et dicit <lb xml:id="p2z6"/>adhuc aliquam esse spem.</s>
					<s n="15" xml:lang="la">Sed quicquid est, <lb xml:id="p2z7"/>paratus sum, quo me cumque deus vocaverit.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z8"/>Nolo quicquam adhuc dicatur d. socero; si morbus ingravescit cras o<lb xml:id="p2z9"/>mnia mature de coniuge et liberis constituam.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Clarissimo viro eruditione et pietate excellenti d. <persName ref="p495">Heinrycho Bu<lb xml:id="p2z10"/>llingero</persName>, patri meo colendo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>