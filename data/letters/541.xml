	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Fuit apud nos <persName ref="p8101">Lelius</persName>.</s>
					<s n="3" xml:lang="la">Qui cum tui amanter <lb xml:id="p1z2"/>meminisset ut tui nominis studiosus, <lb xml:id="p1z3"/>non potui illum a me sine meis ad te literis <lb xml:id="p1z4"/>dimittere.</s>
					<s n="4" xml:lang="la">Nihil autem occurrit, quod ad <lb xml:id="p1z5"/>te scriberem nisi me vehementer cupere <lb xml:id="p1z6"/>vos omnes bene valere et ea meditari, <lb xml:id="p1z7"/>que ad amplificationem dei patris in filio <lb xml:id="p1z8"/>Messia et ad aedificationem ecclesię in hac <lb xml:id="p1z9"/>patefactione sacri evangelii pertineant, <lb xml:id="p1z10"/>in qua non secus opus erit ad instauran<lb xml:id="p1z11"/>dum templum coelestis Hierosolymę aedifica<lb xml:id="p1z12"/>toribus altera manu fabrilia instrumenta, <lb xml:id="p1z13"/>altera gladium adversus hostes eva<lb xml:id="p1z14"/>ngelii ferre, atque olim Judęi in reparatione <lb xml:id="p1z15"/>mystici templi et Hierosolymę iam redempti <lb xml:id="p1z16"/>ex Babylonia captivitate tulerunt [Quaero]?</s>
					<s n="5" xml:lang="la">[..<lb xml:id="p1z17"/>.] figuram eius Babylonii exilii, quod nob<lb xml:id="p1z18"/>is antichristus, Babylonis rex, <lb xml:id="p1z19"/>imponit, prętulerit, electi dei iam aliquot <lb xml:id="p1z20"/>seculis experti sunt et etiamnum experiuntur <lb xml:id="p1z21"/>sed cum spe miserę captivitatis solvend[ę] <lb xml:id="p1z22"/>ad Christi regnum longe lateque in orbe terra[rum] <lb xml:id="p1z23"/>proferendum.</s>
					<s n="6" xml:lang="la" ana="farewell">Tu, vir pręstanti erudition[e] <pb/><lb xml:id="p2z1"/>et pietate, <persName ref="p495">Bullinger</persName>i, vale et <persName ref="p8101">Lęlium</persName>, utriusque nos<lb xml:id="p2z2"/>trum communem amicum commendatum habe et <persName ref="p8298">Borrhaum</persName><lb xml:id="p2z3"/>, ut soles, amato.</s>
					<s n="7" xml:lang="la" ana="salute">Omnes apud vos eruditos <lb xml:id="p2z4"/>viros salvere meo nomine plurimum volo.</s>
					<s n="8" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l28">Basilęe</placeName> calendis Junii.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p2z6"/><persName ref="p8298">Martinus Borrhaus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="10" xml:lang="la"><lb xml:id="p2z7"/>Eximia eruditione <lb xml:id="p2z8"/>pietate viro D. <persName ref="p495">Henr[ico] <lb xml:id="p2z9"/>Bullingero</persName>, amico et <lb xml:id="p2z10"/>fratri in domino <lb xml:id="p2z11"/>charissimo.</s>
				</p>
			</div>
