	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la">Quandoquidem, vir longe charissime, scivi me rem gratam tibi facturum, <lb xml:id="p1z2"/>si aliquid literarum ad tuam excellentiam<note type="misc">e 2. l...</note> darem, ideo praetermittere nolui, <lb xml:id="p1z3"/>quin aliquid per mercatores, qui ad <placeName ref="l157">Francfordienses</placeName> nundinas <lb xml:id="p1z4"/>proficiscuntur, tuae excel[l]entiae scriberem et benevolentiam illam in nos colla<lb xml:id="p1z5"/>tam sepius commemorarem, quamvis nihil mihi singulare erat scrib<lb xml:id="p1z6"/>endum.</s>
					<s n="3" xml:lang="la">Sed ne videar me plane ingratum et oblitum beneficiorum in <lb xml:id="p1z7"/>nos collatorum, sciat tua excel[l]entia nos gratia dei prospera valetudine <lb xml:id="p1z8"/>uti.</s>
					<s n="4" xml:lang="la">Sed <persName>Laure[n]tio</persName> praeceptori nostro, non est admodum salubris aer; nam egrotabat.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Nulla nova audivimus ex <placeName ref="l2472">Polonia</placeName>, quae ad tuam excel[l]entiam perscribenda <lb xml:id="p1z10"/>iudicaremus.</s>
					<s n="6" xml:lang="la">Igitur rogo tuam excel[l]entiam, ne me accuset negligentiae in scribendo, <lb xml:id="p1z11"/>quoniam studiis impediebar.</s>
					<s n="7" xml:lang="la">Plura mihi non sund scribenda ad tuam excel[l]entiam.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/>Cupio tuam excel[l]entiam bene valere.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Data <placeName ref="l284">Libsiae</placeName> 25. augusti <lb xml:id="p1z13"/>anno domini 1563.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/>Filius tu[ae] ex[cellentiae] obsequentissimus <lb xml:id="p1z15"/><persName ref="p752">Andreas Czikowski</persName>.</s>
				</p>
				<p>
					<note>[Ohne Adresse.]</note>
				</p>
			</div>
		</body>
	</text>
