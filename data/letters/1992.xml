	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Solebas, compater charissime, graviter de me conqueri, <lb xml:id="p1z2"/>quod tam raras scripserim ad te literas, et merito.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Sed iam per annum unum plures ad te scripsi, et <lb xml:id="p1z4"/>nullas a te recipere potuerim.</s>
					<s n="4" xml:lang="la">Scio statum nostri <lb xml:id="p1z5"/>regni tibi non esse ignotum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Rex noster propter <lb xml:id="p1z6"/>nostra peccata fatis concessit, non sine magno <lb xml:id="p1z7"/>ecclesię nostrę periculo.</s>
					<s n="6" xml:lang="la">Successit ei soror eius, <persName>Maria</persName> <lb xml:id="p1z8"/>nomine, cui deus semper adsit suo sancto <lb xml:id="p1z9"/>spiritu, ut regnet et regat omnia ad gloriam nominis <lb xml:id="p1z10"/>sui.</s>
					<s n="7" xml:lang="la">Altaria passim in regno denuo eriguntur, <lb xml:id="p1z11"/>privatę missę multis in locis crebro <lb xml:id="p1z12"/>fiunt: iacet verus dei cultus, vera invocatio, <lb xml:id="p1z13"/>rectus sacramentorum usus; divina conculcantur s<lb xml:id="p1z14"/>olo, humana p[rae]valent.</s>
					<s n="8" xml:lang="la">Deus <lb xml:id="p1z15"/>propter suum filium unicum Iesum Christum adsit <lb xml:id="p1z16"/>ecclesię sę.</s>
					<s n="9" xml:lang="la">Omnes pii concionatores in extremo <lb xml:id="p1z17"/>versantur periculo; qui carceris <lb xml:id="p1z18"/>squalorem adhuc non sensiunt, expectant <lb xml:id="p1z19"/>in horas.</s>
					<s n="10" xml:lang="la">Interea publica autoritate omnibus <lb xml:id="p1z20"/>interdicitur ne concionentur.</s>
					<s n="11" xml:lang="la">In illorum loca <lb xml:id="p1z21"/>constituuntur hostes evangelii, qui e sugges<lb xml:id="p1z22"/>tu humana et non divina populo proponunt.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z23"/>Iam in solo deo confidimus; illum enixe <lb xml:id="p1z24"/>oramus ut nos consoletur et corroboret <lb xml:id="p1z25"/>ad quevis subeunda pro gloria nominis <lb xml:id="p1z26"/>sui.</s>
					<s n="13" xml:lang="la">Raptim, ex carcere <placeName ref="l296">Londini</placeName>, 3 <lb xml:id="p1z27"/>septembris, 1553.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Saluta charissimam coniugem <lb xml:id="p1z28"/>tuam, dominum <persName ref="p8171">Bibliandrum</persName> cum sua, d. <persName ref="p8127">Pellicanum</persName> cum <lb xml:id="p1z29"/>sua, d. <persName ref="p8011">Gvalterum</persName> cum sua, et omnes alios <lb xml:id="p1z30"/>pios fratres, conter[r]anium nostrum d. <persName ref="p506">Butlerum</persName> cum sua.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z31"/>T[otus] t[uus,] <persName ref="p1560">Ioannes Hoperus</persName>, <lb xml:id="p1z32"/><placeName ref="l567">Wigorn</placeName>. <lb xml:id="p1z33"/>et <placeName ref="l177">Glouc.</placeName> episcopus<pb/><lb xml:id="p2z1"/>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p4z1"/>Praestantissimo viro d. <persName ref="p495">Henrico <lb xml:id="p4z2"/>Bullingero</persName>, <placeName ref="l587">Tiguri</placeName>.</s>
				</p>
				<p>
					<note type="author">[Darunter von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="17" xml:lang="la"><lb xml:id="p4z3"/>Ultima <persName ref="p1560">Hopperi</persName> <lb xml:id="p4z4"/>ex carcere <placeName ref="l296">Lon<lb xml:id="p4z5"/>dinen[si]</placeName>.</s>
				</p>
			</div>
