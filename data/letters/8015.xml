	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Spero postremas meas esse tibi redditas
					<lb xml:id="p1z2"/>quibus nuntium tibi et mihi vald
					<lb xml:id="p1z3"/>iniucundum attuli de Bibliandri nostri
					<lb xml:id="p1z4"/>obita, qui sane mihi fuit tunt
					<lb xml:id="p1z5"/>acerbior, quauanto magis animadvers
					<lb xml:id="p1z6"/>mihi fuisse abs te peculiar.
					<lb xml:id="p1z7"/>quadam ratione commendatum, Et mihi
					<lb xml:id="p1z8"/>quoque obversatur ob oculos maternus
					<lb xml:id="p1z9"/>luctus, cuius partem sustineo, ut
					<lb xml:id="p1z10"/>christiana charitas iubet. S
					<lb xml:id="p1z11"/>insumma iustum aequui, utile est
					<lb xml:id="p1z12"/>quod domino placuit. Interim hoc
					<lb xml:id="p1z13"/>vobis opto persuasum esse, quamvis cu
					<lb xml:id="p1z14"/>eam rationem invilendi aegrotos hic
					<lb xml:id="p1z15"/>sequamur, quae istic obtinuit (quoruam
					<lb xml:id="p1z16"/>indicamus expedire et etiam
					<lb xml:id="p1z17"/>aliter censeremus hoc obtver
					<lb xml:id="p1z18"/>nullo modo posset) tamen, praeterquam
					<lb xml:id="p1z19"/>quod omnibus modis coicti sumus efficere
					<lb xml:id="p1z20"/>nobis
					<lb xml:id="p1z21"/>ut ille tempestive  discederet, eo postea
