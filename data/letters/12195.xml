	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literas missas d. <persName ref="p8073">Gilberto</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p8073">Gilbert Cousin</persName>.</note> per <persName ref="p4575">fratrem</persName><note xml:id="fn2" type="footnote" ana="bio" n="2">Ein Bruder von <persName ref="p8073">Gilbert Cousin</persName>, vielleicht <persName ref="p4575">Antoine</persName>; s. oben <ref target="file12186">Nr. 2139</ref>, Anm. 18.</note>, qui ad nos veniet <lb xml:id="p1z2"/>futura hebdomada,<note xml:id="fn3" type="footnote" n="3">Diesen Besuch hatte <persName ref="p1278">Gast</persName> schon oben <ref target="file12186">Nr. 2139</ref>, 22f angekündigt.</note> transmittam et miror, cur nihil illi rescripseris,<note xml:id="fn4" type="footnote" n="4">Vgl. oben <ref target="file12186">Nr. 2139</ref>, 23f.</note> <lb xml:id="p1z3"/>quum avide tuas expectet literas.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><persName ref="p8312">Cochlaei</persName> en librum<note xml:id="fn5" type="footnote" n="5"><hi><persName ref="p8312">Cochläus</persName>,</hi> In primum <persName ref="p8417">Musculi</persName> Anticochlaeum replica brevis; s. oben <ref target="file12125">Nr. 2078</ref>, Anm. 4. <persName ref="p1278">Gast</persName> hatte <persName ref="p495">Bullinger</persName> angeboten, das Buch auf der <placeName ref="l157">Frankfurter</placeName> Frühjahrsmesse zu kaufen; s. oben <ref target="file12137">Nr. 2090</ref>, 13f. Später meinte <persName ref="p1278">Gast</persName>, dass <persName ref="p495">Bullinger</persName> das Buch, besonders den darin enthaltenen, gegen diesen gerichteten Epilog, vielleicht bereits habe, anderenfalls hätte er ihn geschickt; s. oben <ref target="file12186">Nr. 2139</ref>, 35-37.</note>.</s>
					<s n="4" xml:lang="la">An dignus <lb xml:id="p1z4"/>sit responsione, tu videris.</s>
					<s n="5" xml:lang="la">Arrogans homo veritati se nunquam subiiciet, <lb xml:id="p1z5"/>ut ex illius scriptis apparet.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><persName ref="p467">Buceranis</persName> Apologia vestra in <persName ref="p1974">Lutherum</persName> <lb xml:id="p1z6"/>maxime displicet<note xml:id="fn6" type="footnote" n="6">Das "Warhaffte Bekanntnuß" der <placeName ref="l587">Zürcher</placeName> bzw. dessen lateinische Fassung, die "Orthodoxa <placeName ref="l587">Tigurinae</placeName> ecclesiae confessio"; s. oben Nr. 2061, Anm. 9. - Zur Unzufriedenheit <persName ref="p467">Bucers</persName> selbst s. <bibl>MBW-Reg</bibl> IV, Nr. 3854; <bibl source="b51">Blarer BW</bibl> II 358.</note>.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale cum omnibus tuis.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l28">Basileę</placeName>, 27. aprilis <lb xml:id="p1z7"/>1545.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="salute">Salutem precor d. <persName ref="p8171">Theodoro</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p8171">Theodor Bibliander</persName>.</note>, optimo viro<lb xml:id="p1z8"/>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Tuus <persName ref="p1278">Gastius</persName>.</s>
				</p>
				<p>
					<note>[Nachschrift auf der Rückseite neben der Adresse:]</note>
					<s n="11" xml:lang="la">Vas <lb xml:id="p1z9"/>cum literis et libris<note xml:id="fn8" type="footnote" n="8">Die Sendung enthielt wohl Bücher und Briefe von der <placeName ref="l157">Frankfurter</placeName> Frühjahrsmesse, darunter vielleicht den Katalog gedruckter Neuerscheinungen, den <persName ref="p1278">Gast</persName> am 22. April angekündigt hatte (oben <ref target="file12190">Nr. 2143</ref>, 121), und das oben Z. 4 genannte Buch von <persName ref="p8312">Cochläus</persName>.</note> statim re<lb xml:id="p1z10"/>cipietis.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName><note xml:id="fna" type="footnote" n="a"><hi>In der Vorlage</hi> <persName ref="p495">Bullingo</persName>.</note>, pręceptori <lb xml:id="p2z3"/>suo semper colendo.</s>
					<s n="13" xml:lang="de"><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
