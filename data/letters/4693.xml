			<zone xml:id="p2z21-0" points="2199,2875 2634,2811 2856,2866 3020,2814 3020,2747 2879,2695 2750,2698 2708,2734 2673,2708 2637,2737 2570,2711 2515,2734 2470,2698 2386,2727 2199,2714">2216,2796 2256,2798 2297,2801 2337,2801 2378,2801 2419,2799 2459,2797 2500,2796 2541,2796 2581,2796 2622,2796 2663,2796 2703,2796 2744,2796 2785,2796 2825,2796 2866,2796 2907,2796 2947,2797 2988,2799 3029,2796</zone>
