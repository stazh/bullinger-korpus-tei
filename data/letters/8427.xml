	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S.
					<lb xml:id="p1z2"/>D. Ioannis Brentur Sturgardiae
					<lb xml:id="p1z3"/>11. septimtris mnser die
					<lb xml:id="p1z4"/>omn obiit amo aecari.
					<lb xml:id="p1z5"/>De quo tale caris chubugensis
					<lb xml:id="p1z6"/>quidam professor ad me dedit.
					<lb xml:id="p1z7"/>Bs soepte Lustus iam Brentius addidt anie
					<lb xml:id="p1z8"/>Coeporis et possint mentia caduca suo
					<lb xml:id="p1z9"/>Ullius in mundo semper piam scripia manekunt
					<lb xml:id="p1z10"/>hoc tane in caelo speran arce sclit
					<lb xml:id="p1z11"/>Opiorem meis vis per occasiosem clarissime. Vrs
					<lb xml:id="p1z12"/>iic, Modionae doctoroe republicę vestioe, quam
					<lb xml:id="p1z13"/>offcesisses salutari ac domino Abrasonem hmanissium
					<lb xml:id="p1z14"/>virum renrde.
					<lb xml:id="p1z15"/>Do. Hartege
					<lb xml:id="p1z16"/>scriptiosum
					<lb xml:id="p1z17"/>lenestat ta Hmanrie nostri multariam scapus. rgo
				</p>
			</div>
		</body>
	</text>
