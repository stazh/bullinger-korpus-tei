					<s n="14" xml:lang="la"><placeName ref="l626">Brze<lb xml:id="p2z28"/>st<lb xml:id="p2z29"/>ensi</placeName> <lb xml:id="p2z30"/>e<lb xml:id="p2z33"/>t<lb xml:id="p2z34"/>c<lb xml:id="p2z37"/>., <lb xml:id="p2z39"/>d<lb xml:id="p2z40"/>omin<lb xml:id="p2z41"/>o <lb xml:id="p2z42"/>su<lb xml:id="p2z43"/>o <lb xml:id="p2z44"/>clementissimo.</s>
				</p>
