	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Ioanni Garnerio
					<lb xml:id="p1z2"/>Gallicanae ecclesiae
					<lb xml:id="p1z3"/>pastori Argentinae
					<lb xml:id="p1z4"/>decembris 24. 1554.
					<lb xml:id="p1z5"/>ab
					<lb xml:id="p1z6"/>initioexpono, tur videant
					<lb xml:id="p1z7"/>a
					<lb xml:id="p1z8"/>principes et urbes tantopere require.
					<lb xml:id="p1z9"/>consensu in confessionem Augustana, quia
					<lb xml:id="p1z10"/>vcissent iam comitia et videatur sibi abund
					<lb xml:id="p1z11"/>de caute, si dicant concorditor illam se
					<lb xml:id="p1z12"/>recipere, quod istam dudum Caesarem fere
					<lb xml:id="p1z13"/>hec improbasse videatur. Cum mihi
					<lb xml:id="p1z14"/>potius videatur hostes veritatis non tandm
					<lb xml:id="p1z15"/>requirere, ut fidem profiteatur sedm
					<lb xml:id="p1z16"/>confessionem Augustanam, quam ut nullam profie
					<lb xml:id="p1z17"/>et in veterem via redeamus. quo
					<lb xml:id="p1z18"/>circa adhortandos omnes ad constantia
					<lb xml:id="p1z19"/>confessa veritate. Lapsu enim Angs
					<lb xml:id="p1z20"/>lcaregni confirmatos episcopos magna te
					<lb xml:id="p1z21"/>unde aequi esse ut et nos praepat
					<lb xml:id="p1z22"/>ad pugnam. Non defuturum dominum.
					<lb xml:id="p1z23"/>Cottessimu Augustana te sano sensu admissuru
					<lb xml:id="p1z24"/>respondere posses, si nemo videlicet
					<lb xml:id="p1z25"/>cum ecclesia adigat fateri Christum adeos
					<lb xml:id="p1z26"/>corporaliter et carnaliter percipi, sed ita adesse
					<lb xml:id="p1z27"/>et percipi, ut hactenus et votus a temporo
					<lb xml:id="p1z28"/>apostolorum ecclesia et vestra credidit
					<lb xml:id="p1z29"/>Pesse et percipi. Haec in re non impri
					<lb xml:id="p1z30"/>Quidentur egisse audio d. Petrum Martyrem
					<lb xml:id="p1z31"/>requisitum et ipsum, qui cum quotidie tecum
					<lb xml:id="p1z32"/>sit eius quoque consilio uti poteris. Dissidiis et
					<pb/>
					<lb xml:id="p2z1"/>daent ullam occasio
					<lb xml:id="p2z2"/>contentionibus pii
					<lb xml:id="p2z3"/>provin nihil concedunt imprudenter
					<lb xml:id="p2z4"/>unde postea oriri possint dissidia et
					<lb xml:id="p2z5"/>certationes. Ac nisi candide et synor
					<lb xml:id="p2z6"/>agamus in omnibus nescio quo hoc esse pos
					<lb xml:id="p2z7"/>Speramus brevi
					<lb xml:id="p2z8"/>simus quod dicimur.
					<lb xml:id="p2z9"/>aediturum d. Calvinum scriptum publicum
					<lb xml:id="p2z10"/>quo tueatur et illustret nostram Consensu
					<lb xml:id="p2z11"/>contra calumniatores, occasionem
					<lb xml:id="p2z12"/>suppeditaturum filiis pacis redeundiin
					<lb xml:id="p2z13"/>iustam deserendique illam carnalem
					<lb xml:id="p2z14"/>de coena domini opinione et concertation
					<lb xml:id="p2z15"/>Dominus Iusus adsit nobis et servet in san
					<lb xml:id="p2z16"/>sua veritate in finem usque. Serius
					<lb xml:id="p2z17"/>scribo. Citius non potui. Benedicate
					<lb xml:id="p2z18"/>cclesiae tuae et tibi dominus.
				</p>
			</div>
		</body>
