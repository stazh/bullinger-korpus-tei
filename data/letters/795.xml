	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l491">Argentinae</placeName> 6. ianuarii 1550.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">S. <lb xml:id="p1z2"/>P.</s>
					<s n="3" xml:lang="la">Iam allatae sunt ex <placeName ref="l830">Anglia</placeName> mihi literae, <persName ref="p495">Bullingere</persName> <lb xml:id="p1z3"/>amicissime, quae partim lugubria, maiore tamen ex parte <lb xml:id="p1z4"/>laeta nunciant, lugubria et tristia de morte <persName ref="p4744">Pauli Fagii</persName>, qui <lb xml:id="p1z5"/>nuper, scilicet 23. novembris, obiit diem extremum.</s>
					<s n="4" xml:lang="la">Laeta sunt haec: inter <lb xml:id="p1z6"/><placeName ref="l830">Angliae</placeName> conciliarios praecipuos electi sunt iam duo viri <lb xml:id="p1z7"/>christiani, nempe <placeName ref="l136">Eliensis</placeName> episcopus et marchio <placeName ref="l3507">Dorcestriae</placeName>.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/><persName>Richardus</persName> cum uxore valet.</s>
					<s n="6" xml:lang="la">Supplicium sumptum est de principibus <lb xml:id="p1z9"/>tumultus.</s>
					<s n="7" xml:lang="la">De protectore vana et falsa sunt, quae <lb xml:id="p1z10"/>spargebantur; nam non dedit poenas adhuc.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Fama item <lb xml:id="p1z11"/>huc pervenit de novo tumultu in <placeName ref="l830">Anglia</placeName>, quae falsa est.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z12"/>Expectat nuncius nec sinit plura scribere.</s>
					<s n="10" xml:lang="la">Literas tuas <lb xml:id="p1z13"/>universas misi in <placeName ref="l830">Angliam</placeName>.</s>
					<s n="11" xml:lang="la">In posterum quaeso, quam poteris <lb xml:id="p1z14"/>paucissima, eo scribe; nam non sine magno<note type="margin">a.R.: ...</note> eo mittuntur.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z15"/>Quicquid tamen ad <persName>Richardum</persName> scripseris libenter sumptibus <lb xml:id="p1z16"/>meis mittam.</s>
					<s n="13" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="14" xml:lang="la">Communica haec <placeName ref="l830">Anglis</placeName>, <lb xml:id="p1z17"/>quibus non fuit otium scribendi.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z18"/>Tuus <persName ref="p505">Burcherus</persName>.</s>
				</p>
				<p>
					<s n="16" xml:lang="de"><pb/><lb xml:id="p2z1"/>Dem fürnemen, wisen hern <lb xml:id="p2z2"/><persName ref="p495">Heinrich Bullinger</persName>, p<lb xml:id="p2z3"/>redicanten, mynem gunstigen <lb xml:id="p2z4"/>hern und freundt.</s>
				</p>
				<p>
					<s n="17" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
