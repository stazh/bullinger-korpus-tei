			<zone xml:id="p2z5-0" points="1517,1702 1554,1710 1601,1673 1623,1680 1638,1680 1646,1673 1671,1676 1673,1654 1655,1655 1629,1630 1608,1632 1573,1612 1540,1618 1518,1615">1525,1665 1550,1668 1575,1670 1601,1670 1626,1668 1651,1665 1677,1662</zone>
