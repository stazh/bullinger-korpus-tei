	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">In kalendas aprilis nova sunt instituta comitia a <placeName ref="l1202">Smalcaldensi</placeName> foedere<note xml:id="fn1" type="footnote" n="1">Siehe dazu <ref target="file12398">Nr. 2351</ref>, Anm. 67.</note>.</s>
					<s n="3" xml:lang="la">Illic expedientur<lb xml:id="p1z2"/>, quae nunc<note xml:id="fn2" type="footnote" n="2">D.h. auf dem am 8. Februar beendeten <placeName ref="l1202">Schmalkaldischen</placeName> Bundestag in <placeName ref="l157">Frankfurt</placeName>.</note> expediri non potuerunt.</s>
					<s n="4" xml:lang="la">Consilia, tractationes et cętera omnia habentur <lb xml:id="p1z3"/>clam, id quod mihi summe placet; docet enim ea res, quam prudentia polleant, <lb xml:id="p1z4"/>qui illic conveniunt.</s>
					<s n="5" xml:lang="la"><persName ref="p3088">Sturmius</persName> professor<note xml:id="fn3" type="footnote" n="3"><persName ref="p3088">Johannes Sturm</persName>.</note> quę exposuerit <placeName ref="l157">Francfordię</placeName>,<note xml:id="fn4" type="footnote" n="4">Zu <persName ref="p3088">Sturms</persName> Gesandtschaft im Auftrag der <placeName ref="l1202">Schmalkaldener</placeName> siehe <ref target="file12367">Nr. 2320</ref>, Anm. 36. In <placeName ref="l157">Frankfurt</placeName> berichteten <persName ref="p3088">Sturm</persName>, <persName ref="p7698">Johann Bruno von Niedbruck</persName> und <persName ref="p6096">Johannes Sleidanus</persName> am 4. Februar 1546 über die fehlgeschlagenen Verhandlungen zwischen <placeName ref="l830">England</placeName> und <placeName ref="l832">Frankreich</placeName> und überreichten ein Schreiben von König <persName ref="p20225">Franz I.</persName>; s. <bibl source="b480">PC</bibl> III 711 mit Anm. 3.</note> novit <lb xml:id="p1z5"/>nemo.</s>
					<s n="6" xml:lang="la">Illud tamen certum, ipsum conditiones optimas a <persName ref="p20225">Gallo</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p20225">Franz I.</persName></note> protestantibus adtulisse, <lb xml:id="p1z6"/>quamvis <persName ref="p20225">Gallus</persName> non habuerit illic<note xml:id="fn6" type="footnote" n="6">In <placeName ref="l157">Frankfurt</placeName>.</note> nisi inspectores<note xml:id="fn7" type="footnote" ana="bio" n="7">Die <placeName ref="l832">französischen</placeName> Gesandten <persName ref="p20125">Claude de l'Aubespine</persName> und dessen Bruder <persName ref="p8296">Sébastien de l'Aubespine, Abbé de Bassefontaine</persName>, hielten sich im Januar und Februar 1546 am Bundestag zu <placeName ref="l157">Frankfurt</placeName> auf; s. <bibl source="b513">Potter</bibl> 341.</note>.</s>
					<s n="7" xml:lang="la"><persName ref="p8375">Anglus</persName><note xml:id="fn8" type="footnote" n="8">König <persName ref="p8375">Heinrich VIII.</persName></note> neminem misit<note xml:id="fn9" type="footnote" n="9">In <placeName ref="l157">Frankfurt</placeName> wurden allerdings die durch die englischen Gesandten <persName ref="p4439">Walter Bucler</persName> und <persName ref="p8121">Christopher Mont</persName> an <persName ref="p3590">Philipp von Hessen</persName> übermittelten Antworten <persName ref="p8375">Heinrichs VIII.</persName> vorgetragen; s. <bibl source="b480">PC</bibl> III 712.</note>.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z7"/><persName ref="p18538">Cęsaris</persName><note xml:id="fn10" type="footnote" n="10"><persName ref="p18538">Karl V.</persName></note> legatio nusquam comparuit<note xml:id="fn11" type="footnote" n="11">Gerüchtweise hatte es geheißen, <persName ref="p18538">Karl V.</persName> hätte <persName ref="p7706">Granvelle</persName> nach <placeName ref="l157">Frankfurt</placeName> geschickt; s. <ref target="file12409">Nr. 2362</ref>,15-18.</note>.</s>
					<s n="9" xml:lang="la"><persName ref="p17927">Palatinus</persName><note xml:id="fn12" type="footnote" n="12">Kurfürst <persName ref="p17927">Friedrich II. von der Pfalz</persName>.</note> tamen una cum fratre <persName ref="p20769">Wolfgango</persName><note xml:id="fn13" type="footnote" ana="bio" n="13">Pfalzgraf <persName ref="p20769">Wolfgang von der Pfalz-Neumarkt, gen. d.Ä.</persName> (1494-1558), Statthalter der <placeName ref="l2477">Oberpfalz</placeName>.</note>, <lb xml:id="p1z8"/>qui adhuc caret uxore,<note xml:id="fn14" type="footnote" ana="bio" n="14"><persName ref="p20769">Wolfgang von der Pfalz</persName> starb unverheiratet und kinderlos.</note> celeribus equis <placeName ref="l157">Francfordiam</placeName> venit, quo advenit <lb xml:id="p1z9"/>et <persName ref="p3590">Hessus</persName><note xml:id="fn15" type="footnote" n="15">Landgraf <persName ref="p3590">Philipp von Hessen</persName>.</note>.<note xml:id="fn16" type="footnote" n="16">Siehe dazu <ref target="file12382">Nr. 2335</ref>, Anm. 21.</note></s>
					<s n="10" xml:lang="la">Tractarunt de rebus communibus; tantum scitur.</s>
					<s n="11" xml:lang="la"><persName ref="p7548">Moguntinus</persName><note xml:id="fn17" type="footnote" n="17">Der <placeName ref="l307">Mainzer</placeName> Erzbischof und Kurfürst <persName ref="p7548">Sebastian von Heusenstamm</persName>.</note> illac iter fecit, <lb xml:id="p1z10"/>sed protestantes non convenit<note xml:id="fn18" type="footnote" n="18">Siehe jedoch <ref target="file12409">Nr. 2362</ref> und Anm. 13.</note>.</s>
					<s n="12" xml:lang="la">Placet ex omnibus, quę possunt cognosci, maxime, <lb xml:id="p1z11"/>quod legationem miserunt protestantes honorabilem ad <persName ref="p18538">cęsarem</persName>,<note xml:id="fn19" type="footnote" n="19">Siehe dazu <ref target="file12410">Nr. 2363</ref> und Anm. 9.</note> si qua ratione <lb xml:id="p1z12"/>queant cognoscere, quid sit de ipso sperandum.</s>
					<s n="13" xml:lang="la">Alia ex comitiis <placeName ref="l157">Francfordianis</placeName> <lb xml:id="p1z13"/>nosse haud valeo.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z14"/>Ex <placeName ref="l410">Ratispona</placeName> hęc sunt.</s>
					<s n="15" xml:lang="la">Colloquium<note xml:id="fn20" type="footnote" n="20">Das Zweite <placeName ref="l410">Regensburger</placeName> Religionsgespräch.</note> tandem coepisse, et quoniam de libero arbitrio <lb xml:id="p1z15"/>et peccato originali antea<note xml:id="fn21" type="footnote" n="21">Gemeint sind die früheren Religionsgespräche von <placeName ref="l569">Worms</placeName> und <placeName ref="l410">Regensburg</placeName> (1540/41); s. <bibl source="b62">ADRG</bibl> II und III.</note> collatio fuit habita, in praesentiarum<note xml:id="fn22" type="footnote" n="22">in praesentiarum: für die Folgezeit.</note> tractatur iustificatio<note xml:id="fn23" type="footnote" n="23">Die Verhandlungen zu diesem Thema dauerten vom 5. bis 23. Februar; s. <bibl source="b663">Vogel</bibl> 342-428.</note>.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z16"/>Adfuit spiritus domini in hac tractatione <persName ref="p467">Bucero</persName><pb type="edition" next="204"/><note xml:id="fn24" type="footnote" n="24">Siehe dazu <bibl source="b694">Wolrad, Regensb. RG</bibl> 183. 296-299.</note>, cui functio respondendi <lb xml:id="p1z17"/>fuit data <persName ref="p2095">Philippo</persName><note xml:id="fn25" type="footnote" n="25"><persName ref="p2095">Philipp Melanchthon</persName>. - Er war an einem Steinleiden erkrankt; s. <bibl source="b694">Wolrad, Regensb. RG</bibl> 161.</note> absente (in cuius locum d. <persName ref="p5733">Georgius Maior</persName>, vir pla<lb xml:id="p1z18"/>cidi ingenii et adprime doctus, missus est)<note xml:id="fna" type="footnote" n="a"><hi>Klammern ergänzt.</hi></note>.</s>
					<s n="17" xml:lang="la">Adversarii<note xml:id="fn26" type="footnote" n="26">Die Katholiken.</note> volunt, ut di<lb xml:id="p1z19"/>sputata habeantur in summo silentio; nostri contrarium: Oportere enim evan<lb xml:id="p1z20"/>gelium praedicari omni creaturae<note xml:id="fn27" type="footnote" n="27"><cit type="bible"><ref>Mk 16, 15</ref></cit>.</note>.</s>
					<s n="18" xml:lang="la">Inventum est medium, ut omnia serventur in cista, <lb xml:id="p1z21"/>quę sit in manu senatus <placeName ref="l410">Ratisponensis</placeName>.</s>
					<s n="19" xml:lang="la">Tres claves sic distribuantur: Ut u<lb xml:id="p1z22"/>nam habeant pręsidentes<note xml:id="fn28" type="footnote" n="28">Zu deren Namen s. <ref target="file12380">Nr. 2333</ref>,66f. Am 23. Februar wurde <persName ref="p7711">Julius Pflug</persName> zum dritten Präsidenten ernannt; s. <bibl source="b135">BucerDS</bibl> XV 317, Anm. 8.</note>, alteras duas partes colloquentes<note xml:id="fn29" type="footnote" n="29">Zur ganzen Debatte s. <bibl source="b694">Wolrad, Regensb. RG</bibl> 168-173. 177. 180f; <bibl source="b135">BucerDS</bibl> XV 331-361, Nr. 8f.</note>.</s>
					<s n="20" xml:lang="la">Res ad cęsarem <lb xml:id="p1z23"/>est perscripta, ratumne velit hoc esse annon.</s>
					<s n="21" xml:lang="la">Expectatur responsum.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z24"/>Ex <placeName ref="l1107">Tridento</placeName><note xml:id="fn30" type="footnote" n="30">Das Konzil von <placeName ref="l1107">Trient</placeName>.</note>.</s>
					<s n="23" xml:lang="la">In prima sessione<note xml:id="fn31" type="footnote" n="31">Gemeint ist die (nach anderer Zählung zweite) Session vom 7. Januar 1546. Das Dekret dieser Session enthielt verschiedene Ermahnungen an die in <placeName ref="l1107">Trient</placeName> Versammelten; s. <bibl source="b171">CT</bibl> IV 554f; <hi>Jedin, <placeName ref="l1107">Trient</placeName></hi> II 19-21.</note> excuderunt articulos sex, e quibus: 1. <lb xml:id="p1z25"/>Ut episcopi et praelati orent ac ieiunent.</s>
					<s n="24" xml:lang="la">2. Ut sacrifici semel in hebdomada <lb xml:id="p1z26"/>missent.</s>
					<s n="25" xml:lang="la">3. Ut familiam habeant honestam et minime sumptuosam.</s>
					<s n="26" xml:lang="la">4. <lb xml:id="p1z27"/>Ut magistratus civilis vigilet pro personis concilii; eiectus fuit enim in <lb xml:id="p1z28"/>una noctium episcopus<note xml:id="fn32" type="footnote" n="32">Unbekannt.</note> e suo diversorio; aiunt quęsisse ignem.</s>
					<s n="27" xml:lang="la">5. <lb xml:id="p1z29"/>Ut prospiciatur de commeatu et annona.</s>
					<s n="28" xml:lang="la">6. Ut eligantur notarii, <lb xml:id="p1z30"/>scribę, cursores.</s>
					<s n="29" xml:lang="la">Vides, inquit quidam<note xml:id="fn33" type="footnote" n="33">Unbekannt.</note>, „gratiam pneumatis“ iuxta carmen <lb xml:id="p1z31"/><persName ref="p17777">Alexandri</persName><note xml:id="fn34" type="footnote" ana="bio" n="34"><persName ref="p17777">Alexander von Villa Dei</persName> (aus <placeName ref="l2247">Villedieu</placeName> in der <placeName ref="l2770">Normandie</placeName>), geb. um 1170, gest. um 1250, Verfasser einer um das Jahr 1200 entstandenen Vers-Grammatik "Doctrinale puerorum", aus deren Einleitung hier zitiert wird.</note>: „Me iuvet et faciat complere, quod utile fiat.“</s>
					<s n="30" xml:lang="la">Reliqua <lb xml:id="p1z32"/>tu audies ex <persName ref="p8011">Gvalthero</persName><note xml:id="fn35" type="footnote" n="35">Zu <persName ref="p8011">Gwalthers</persName> Reise nach <placeName ref="l28">Basel</placeName> s. <ref target="file12412">Nr. 2365</ref>, Anm. 3.</note> et <persName ref="p8071">Voglero</persName><note xml:id="fn36" type="footnote" n="36"><persName ref="p8071">Hans Vogler d.Ä.</persName>: s. <bibl source="b645">Vadian BW</bibl> VI 518f.</note>.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="31" xml:lang="la" ana="farewell">Vale in domino cum tuis.</s>
					<s n="32" xml:lang="la"><lb xml:id="p1z33"/><persName ref="p8171">Theodoro</persName><note xml:id="fn37" type="footnote" n="37"><persName ref="p8171">Theodor Bibliander</persName>.</note> bene volo; de eius erga me animo plane incertus<note xml:id="fn38" type="footnote" n="38">Sicherlich aufgrund des Briefes, den <persName ref="p8418">Myconius</persName> und <persName ref="p8054">Markus Bertschi</persName> am 8. April 1545 an <persName ref="p8171">Bibliander</persName> geschrieben hatten (Zürich ZB, Ms F 81, 397). Darin hatte sich <persName ref="p8418">Myconius</persName> über <persName ref="p1974">Luthers</persName> "Kurtz bekentnis" sowie über die Antwort der <placeName ref="l587">Zürcher</placeName> darauf (das "Warhaffte Bekanntnuß") geäußert und letzteres als nutzlos bezeichnet: "Interim non videmus, quenam sit utilitas responsionis vestrae". - <persName ref="p8418">Myconius</persName> und <persName ref="p8054">Bertschi</persName> waren von <persName ref="p8171">Bibliander</persName> um ihre Meinung gebeten worden; s. <bibl source="b18">HBBW XV</bibl> 181. Anm. 6.</note>.</s>
					<s n="33" xml:lang="la" ana="salute"><persName ref="p8127">Pellicanum</persName> <lb xml:id="p1z34"/>salutabis nomine meo.</s>
				</p>
				<p>
					<s n="34" xml:lang="la"><placeName ref="l28">Basileae</placeName>, raptim, 6. martii anno 1546.</s>
				</p>
				<p>
					<s n="35" xml:lang="la"><lb xml:id="p1z35"/>Tuus <persName ref="p8418">Os. Myconius</persName>.<pb type="edition" next="205"/></s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="36" xml:lang="la">D. <pb/><lb xml:id="p2z1"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tigurinorum</placeName> <lb xml:id="p2z3"/>episcopo dignissimo, domino <lb xml:id="p2z4"/>in Christo observando <lb xml:id="p2z5"/>suo.</s>
					<s n="37" xml:lang="de"><placeName ref="l587">Z[urich]</placeName><note xml:id="fnb" type="footnote" n="b">Teilweise auf das nicht mehr erhaltene Verschlussband geschrieben.</note>.</s>
				</p>
			</div>
		</body>
	</text>
