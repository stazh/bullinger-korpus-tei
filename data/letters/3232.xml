	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Clarissime <persName ref="p495">Bullingere</persName>.</s>
					<s n="2" xml:lang="la">Tria capita continebant literae, <lb xml:id="p1z2"/>quas nuper abs te accepi.</s>
					<s n="3" xml:lang="la">Primum enim commen<lb xml:id="p1z3"/>dabant mihi <persName>Franciscum Cremonensem</persName>, deinde ex<lb xml:id="p1z4"/>cusabant filium, tertio de <persName>Coeliana</persName> causa agebant.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>De postremo habeo, quae respondeam, <lb xml:id="p1z6"/>nempe hoc: Iam aliquot annis <persName ref="p1884">Lavaterus</persName>, gener <lb xml:id="p1z7"/>tuus, qui mihi summe placet, dixit missum fuis<lb xml:id="p1z8"/>se ad te librum <persName>Coelianum</persName>, qui tibi satis displi<lb xml:id="p1z9"/>cuerit, quare te monuisse hominem, ut absti<lb xml:id="p1z10"/>neret ab edendo.</s>
					<s n="5" xml:lang="la">Cum ante mensem ad vos <lb xml:id="p1z11"/>venissem ageremusque cum <persName ref="p8011">R. Gualtero</persName> et <persName ref="p1884">Lavatero</persName> <lb xml:id="p1z12"/>de mandatis illustrissimi ducis mei ad <placeName ref="l28">Basilienses</placeName>, <lb xml:id="p1z13"/>audivi egomet te eundem librum mini<lb xml:id="p1z14"/>me probare.</s>
					<s n="6" xml:lang="la">Has ob causas diserte ausus sum <lb xml:id="p1z15"/>dicere <placeName ref="l28">Basileae</placeName> atque alibi te non probare, ut <lb xml:id="p1z16"/>multi alii gravissimi viri non probant.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/>Tu vero nunc ad me scribis te nescire, quid <lb xml:id="p1z18"/><persName ref="p714">Coelio</persName> eadem de re tecum per litteras <lb xml:id="p1z19"/>expostulanti respondeas.</s>
					<s n="8" xml:lang="la">Ego tibi, tali ac <lb xml:id="p1z20"/>tanto viro non sum qui consilium dem <lb xml:id="p1z21"/>neque in tempore (ut opinor) iam darem; puto <lb xml:id="p1z22"/>enim te scripsisse ad eu miam.</s>
					<s n="9" xml:lang="la">Sed id tamen <lb xml:id="p1z23"/>dicam: ne dubita, quin liber ille sit autoritate <lb xml:id="p1z24"/>primorum totius germaniae condemnandus, <lb xml:id="p1z25"/>publice, inquam, extabunt condemnationes, <pb/><lb xml:id="p2z1"/>hoc enim curatur nunc.</s>
					<s n="10" xml:lang="la">Praeterea ne dubita, <lb xml:id="p2z2"/>quin <persName>Leonium</persName> ingenium (ita hominem <persName ref="p540">Cal<lb xml:id="p2z3"/>vinus</persName> appellat) velit defendere atque edere <lb xml:id="p2z4"/>literas et testimonia eorum, qui mollius <lb xml:id="p2z5"/>de eo senserunt, imo iam se iactabat <lb xml:id="p2z6"/>te mollissime de eo scripsisse ab initio.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Conse<lb xml:id="p2z7"/>quitur id, quod vides, non exprimo amplius.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z8"/>Non paenitet palam accusasse malum librum <lb xml:id="p2z9"/>contra iuditia multarum ecclesiarum editum, deind<lb xml:id="p2z10"/>e vastantem ecclesias.</s>
					<s n="13" xml:lang="la">Id doleo aliquos non <lb xml:id="p2z11"/>audere mecum illatrare lupum ac malle <lb xml:id="p2z12"/>esse spectators, dum laceror.</s>
					<s n="14" xml:lang="la">Viderint, quo<lb xml:id="p2z13"/>modo bonis viris et deo respondeant.</s>
					<s n="15" xml:lang="la">Ego <lb xml:id="p2z14"/>a meo principe facile impetrabo, ut <lb xml:id="p2z15"/>apud d. <placeName ref="l28">Basilienses</placeName> de importunitate hominis <lb xml:id="p2z16"/>expostulet.</s>
					<s n="16" xml:lang="la">Et satis de <persName>Leone</persName>.</s>
					<s n="17" xml:lang="la" ana="salute">Utinam <lb xml:id="p2z17"/>pauca ista communices d. <persName ref="p8011">R. Gualtero</persName>, <lb xml:id="p2z18"/>cui salutem plurimam dico.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p2z19"/>De homine, quem commendaras, dicam unum <lb xml:id="p2z20"/>verbum: perinde est, quando quis mihi tales, <lb xml:id="p2z21"/>qui Germanice ignorant, ad me venientes <lb xml:id="p2z22"/>commendat, ac si dicat: oro da huic ali<lb xml:id="p2z23"/>quot florenos, qui postea tibi parum amicus <lb xml:id="p2z24"/>futurs sit.</s>
					<s n="19" xml:lang="la">Rogas?</s>
					<s n="20" xml:lang="la">Ita est.</s>
					<s n="21" xml:lang="la">Conditionem en<lb xml:id="p2z25"/>im talibus non possum invenire, alo <pb/><lb xml:id="p3z3"/>p<lb xml:id="p3z11"/>er <lb xml:id="p3z15"/>aliquot septimanas, postea volentibus abire nu<lb xml:id="p3z16"/>mero viaticum.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Quoniam vero non successit <lb xml:id="p3z17"/>de conditione invenienda putantes id mea <lb xml:id="p3z18"/>culpa factum, fiunt fere hostes.</s>
					<s n="23" xml:lang="la">Sed tamen <lb xml:id="p3z19"/>non desinam abs te commendatos suscipere, <lb xml:id="p3z20"/>quicquid ipsi agant postea.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p3z21"/>Non tanti facio duos florenulos, ut velim <lb xml:id="p3z22"/>filium tuum se purgare apud me.</s>
					<s n="25" xml:lang="la">Abeat <lb xml:id="p3z23"/>hoc damnum leve cum maioribus multis, <lb xml:id="p3z24"/>quibus saepe afficior.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p3z25"/>Expediar, ut possim me itineri <persName>Polonico</persName> accingere, <lb xml:id="p3z26"/>ubi meus haerus ex <placeName ref="l157">Francfordia</placeName> redierit, <lb xml:id="p3z27"/>hoc est intra 10 (ut puto) dies.</s>
					<s n="27" xml:lang="la">Vos me ves<lb xml:id="p3z28"/>tris precibus iuvate.</s>
					<s n="28" xml:lang="la" ana="farewell">Vale, <persName ref="p495">H. Bullinger</persName>e, <lb xml:id="p3z29"/>ac memoria tene <persName ref="p3375">Vergerium</persName> te deamare <lb xml:id="p3z30"/>ac plurimi facere.</s>
				</p>
				<p>
					<s n="29" xml:lang="la"><lb xml:id="p3z31"/><placeName ref="l512">Tubingae</placeName> 3. iulii 1557.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><lb xml:id="p3z32"/><persName ref="p3375">Vergerius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="31" xml:lang="la">[<pb/><lb xml:id="p4z1"/>C]larissimo viro d. <persName ref="p495">Henrico [B]<lb xml:id="p4z2"/>ullingero</persName>, pastori <placeName ref="l587">Tigurino</placeName>, [<lb xml:id="p4z3"/>f]ratri honorando.</s>
					<s n="32" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
