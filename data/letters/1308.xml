	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Optime pater.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Etsi nihil novi, quod ad te modo scribam, mihi occurrit, illud <lb xml:id="p1z3"/>tamen scias velim nos omnes bene valere in domino et optare, <lb xml:id="p1z4"/>ut tu quoque cum tota familia et fratribus valeatis.</s>
					<s n="3" xml:lang="la">Quas <lb xml:id="p1z5"/>huc deferendas mihi dedisti, fidelissime detuli commendationesque tuas <lb xml:id="p1z6"/>spero non vulgares futuras.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Hodie audivimus tumultum quendam <lb xml:id="p1z7"/>in castris, quae <placeName ref="l303">Magdeburgum</placeName> obsidebant, ortum fuisse eumque adeo <lb xml:id="p1z8"/>magnum extitisse, ut fere invicem manus conseruerint.</s>
					<s n="5" xml:lang="la">Quam ob <lb xml:id="p1z9"/>causam Mauritius cum toto exercitu abiit et <placeName ref="l303">Magdeburgum</placeName> <lb xml:id="p1z10"/>ab obsidione liberata est.</s>
					<s n="6" xml:lang="la">Quod si verum sit, gratias deo <lb xml:id="p1z11"/>agere debemus, qui mortificat et vivificat.</s>
					<s n="7" xml:lang="la" ana="salute">Salutes, quaeso, meo <lb xml:id="p1z12"/>nomine dominum <persName ref="p8127">Pellicanum</persName>, dominum <persName ref="p8171">Bibliandrum</persName> et dominum <lb xml:id="p1z13"/><persName ref="p8011">Gvalterum</persName> et dominum <persName ref="p1214">Ioannem Phrysium</persName>.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale et ora pro nobis<lb xml:id="p1z14"/>.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z15"/><placeName ref="l28">Basileae</placeName> quarto iunii 1551.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/>Tuus ex animo <lb xml:id="p1z17"/><persName ref="p8222">Hier[onymus] Massurius</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Reverendo domino <persName ref="p495">Henryco <lb xml:id="p2z2"/>Bulingero</persName>, verbi dei <lb xml:id="p2z3"/>ministro fidelissimo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
