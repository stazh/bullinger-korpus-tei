	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Acepi tuas, honorande compater, per d. <lb xml:id="p1z2"/><persName ref="p5787">Claudium Mey</persName> missas.</s>
					<s n="3" xml:lang="la">Hodie diacosii fuerunt <lb xml:id="p1z3"/>congregati; quid vero decretum sit, ignoro<lb xml:id="p1z4"/>.</s>
					<s n="4" xml:lang="la">Hic nuncius illico <placeName ref="l587">Tigurum</placeName> mittitur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Fui <lb xml:id="p1z5"/>his diebus <placeName ref="l760">Solodori</placeName>; comitabar enim matrem meam.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/>Inter transeundum incidi in interpretem legati <lb xml:id="p1z7"/>regis, qui illic agit.</s>
					<s n="7" xml:lang="la">Is adolescenti, qui mecum <lb xml:id="p1z8"/>proficiscebatur (est autem cognatus illius) dicebat scrip<lb xml:id="p1z9"/>tum esse hero suo <placeName ref="l587">Tigurinos</placeName> esse in armis contra <placeName>Pa<lb xml:id="p1z10"/>genses</placeName>.</s>
					<s n="8" xml:lang="la">Quod licet falsum esse cognoverim, co<lb xml:id="p1z11"/>lligo tamen inde ipsos nescio quid suspicari.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Uti<lb xml:id="p1z12"/>nam tandem blasphemis illis pacis conditionibus <lb xml:id="p1z13"/>liberaremur!</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Quod <persName ref="p540">Calvinum</persName> attinet, scripsi <lb xml:id="p1z14"/>serio ad <persName ref="p8292">Zebedaeum</persName>; spero fore, ut componamus <lb xml:id="p1z15"/>hoc negotium.</s>
					<s n="11" xml:lang="la">Quid contra <persName ref="p7024">Westphalum</persName> <lb xml:id="p1z16"/>scripserit, videre cupio; subscriptio aegre a <lb xml:id="p1z17"/>nobis obtinebitur propter diversa corrupte <lb xml:id="p1z18"/>iudicantium iudicia; nescio tamen, quid adhuc <lb xml:id="p1z19"/>futurum.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l18">Augustae</placeName> mire conflictantur Lu<lb xml:id="p1z20"/>therani cum nostris.</s>
					<s n="13" xml:lang="la"><placeName ref="l513">Ulmenses</placeName> Interimistas <lb xml:id="p1z21"/>cum papistis pepulere; <persName ref="p1055">Frechtus</persName> illic redire <lb xml:id="p1z22"/>sperat.</s>
					<s n="14" xml:lang="la">Cuperent ex <placeName ref="l862">Helvetiis</placeName> habere ministros; sed <lb xml:id="p1z23"/>vereor, ne dissuadeat <persName ref="p1055">Frechtus</persName>; videor enim mihi <lb xml:id="p1z24"/>hoc subolfacere.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><persName ref="p4863">Ioannis Iacobi Fuggeri</persName> <lb xml:id="p1z25"/>uxor obiit; huic nulla celebrata sunt <lb xml:id="p1z26"/>more papistico parentalia; sed ut in vera <lb xml:id="p1z27"/>fidei confessione discessit, ita iusta quoque <lb xml:id="p1z28"/>nonnisi christiana ei persoluta sunt.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Novi <lb xml:id="p1z29"/>alias nihil est.</s>
					<s n="17" xml:lang="la"><persName ref="p6836">Emanuel Tremellius</persName> He<lb xml:id="p1z30"/>braea lingua cathechismum conscripsit, quem brevi <lb xml:id="p1z31"/>videbis.</s>
					<s n="18" xml:lang="la" ana="salute"><lb xml:id="p1z32"/>Nostri te omnes salutant, cupimus <lb xml:id="p1z33"/>quoque salvam familiam tuam omnem una [cum] fratribus <lb xml:id="p1z34"/>et symmystis, dominis nostris observandis.</s>
					<s n="19" xml:lang="la"><placeName ref="l41">Bernae</placeName> <lb xml:id="p1z35"/>calendis novembris 1554.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z36"/>Tuus <persName ref="p8018">Ioannes Hallerus</persName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> ecclesię pastori <lb xml:id="p2z4"/>fidelissimo, domino ac <lb xml:id="p2z5"/>compatri suo hono<lb xml:id="p2z6"/>rando.</s>
				</p>
				<p>
					<s n="22" xml:lang="de"><lb xml:id="p2z7"/>M. <persName ref="p495">Heinrych <lb xml:id="p2z8"/>Bullinger</persName>n zuͦ <lb xml:id="p2z9"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
