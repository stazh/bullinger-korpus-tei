	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi nuper ad te copiosas.</s>
					<s n="3" xml:lang="la">Interea tuas accepi cum <lb xml:id="p1z2"/>exemplaribus historię <placeName ref="l2510">Turcicae</placeName>.</s>
					<s n="4" xml:lang="la">Dedi ea illis, quibus perti<lb xml:id="p1z3"/>nebant; ii omnes tibi agunt gratias.</s>
					<s n="5" xml:lang="la">Agnosco in ea historia <lb xml:id="p1z4"/>tuum stylum; miror ergo, quomodo <persName ref="p1010">Erbii</persName> nomen addideris.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z5"/><placeName ref="l491">Argentinenses</placeName> interea nostris amicas scripsere literas <lb xml:id="p1z6"/>et in his novitates has, quarum praecipua in tuam gra<lb xml:id="p1z7"/>tiam exscripta hic tibi mitto.</s>
					<s n="7" xml:lang="la">Aliud iam addere <lb xml:id="p1z8"/>non possum.</s>
					<s n="8" xml:lang="de">Man meint, eb 2 monat fürgangend, <lb xml:id="p1z9"/>werde man uß <placeName ref="l832">Franckrych</placeName> nüwe wunder hören.</s>
					<s n="9" xml:lang="de"><lb xml:id="p1z10"/>Gott schicke es alles zum besten.</s>
					<s n="10" xml:lang="de">Amen.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l41">Bernę</placeName> <lb xml:id="p1z11"/>21. februarii 1567.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Dominus <persName ref="p8063">Steigerus</persName> ipse tibi scribit.</s>
					<s n="13" xml:lang="la" ana="salute"><lb xml:id="p1z12"/>Salutant te reliqui omnes; salutem precor ego tuis omnibus.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><persName ref="p8018">I[o<lb xml:id="p1z13"/>hannes] H[allerus</persName>] tuus.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">Bullingero</persName>.</s>
				</p>
			</div>
		</body>
	</text>
