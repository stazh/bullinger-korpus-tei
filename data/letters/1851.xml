	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia Christi tecum.</s>
					<s n="2" xml:lang="la">Iamdudum respondissem <lb xml:id="p1z2"/>aliquo epistolio tibi, doctissime <persName ref="p495">Bullingere</persName>; sed ob <lb xml:id="p1z3"/>uxoris valetudinem malam vehementemque vix ipse <lb xml:id="p1z4"/>aliquando respirare potui, ut meo officio reponderem, <lb xml:id="p1z5"/>atque dum illa melius habet, ego aliquamdiu ex capite <lb xml:id="p1z6"/>laboravi.</s>
					<s n="3" xml:lang="la">Verum iam dei beneficio restitutus tuę <lb xml:id="p1z7"/>humanitati respondeo, ne me putes posuisse ca<lb xml:id="p1z8"/>ducam vitam.</s>
					<s n="4" xml:lang="la">Sexagenarius corporis huius liberationem <lb xml:id="p1z9"/>ut expecto ita et desidero; tantum abest, <lb xml:id="p1z10"/>ut cupiam pręsentis seculi et malitiam et impaen<lb xml:id="p1z12"/>itentiam videre.</s>
					<s n="5" xml:lang="la">O bone deus, libera me in hora <lb xml:id="p1z13"/>bona servaque reliquias ecclesię tuę; nam omnia <lb xml:id="p1z14"/><placeName ref="l822">Germanis</placeName> videntur minitare casum vel diem domin<lb xml:id="p1z15"/>i instare, propterea quod abundet iniquitas et <lb xml:id="p1z16"/>refrixerit charitas multorum.</s>
					<s n="6" xml:lang="la">Evangelium apud nos <lb xml:id="p1z17"/>sonat, annunciatur et auditur; sed periit omnis <lb xml:id="p1z18"/>disciplina plus quam unquam.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Noster princeps in dies <lb xml:id="p1z19"/>expectatur; hospitium est paratum, quod illum <lb xml:id="p1z20"/>postliminio recipiet.</s>
					<s n="8" xml:lang="la">Utinam meliorem magisque pium, <lb xml:id="p1z21"/>quam exierat; nam theologi <placeName ref="l512">Tubingenses</placeName> hominem <lb xml:id="p1z22"/>suis caeremoniis fascinarunt, unde metuo, ne <lb xml:id="p1z23"/>novus rex nova lex et, quod vulgo fertur, nova <lb xml:id="p1z24"/>magis placent.</s>
					<s n="9" xml:lang="la">Hęc forte alias, mi <persName ref="p495">Bullingere</persName>, <lb xml:id="p1z25"/>verbosius.</s>
					<s n="10" xml:lang="la">Tu ora dominum Iesum Christum, dei filium, <lb xml:id="p1z26"/>ne nos in medio luporum positos sinat dissipari.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z27"/>Amen.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Gallus hic in <placeName ref="l632">Alsatia</placeName> et alibi habet suos <lb xml:id="p1z28"/>capitaneos, qui clam conscribant exercitum.</s>
					<s n="13" xml:lang="la">Comitia quorundam <lb xml:id="p1z29"/>principum <placeName ref="l210">Heidelbergę</placeName> soluta; ad <placeName ref="l569">Vangiones</placeName> <lb xml:id="p1z30"/>translata aiunt, quę et ipsa iam dissipata.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z31"/>Quid futurum sit, dies declarabit.</s>
					<s n="15" xml:lang="la" ana="salute">Hisce vale, frater <lb xml:id="p1z32"/>in Christo observandissime, tuamque saluta familiam, symystas, <lb xml:id="p1z33"/><persName ref="p8127">Pellicanum</persName>, <persName ref="p8171">Bibliandrum</persName>, <persName ref="p8011">Gvaltherum</persName>, et orate pro nobis, <lb xml:id="p1z34"/>ne nos scribret Satanas.</s>
					<s n="16" xml:lang="la" ana="salute">Salutant vos nostri.</s>
					<s n="17" xml:lang="la">Raptim <placeName ref="l411">Richenvillę</placeName> <lb xml:id="p1z35"/>20. aprilis 1553.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">T[uus] <persName ref="p1010">Matthias Erbius</persName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Rescribe decrepito seni <persName ref="p1010">Erbio</persName> sepius, qui nunc a<pb/><lb xml:id="p2z1"/>liquando bacillo innititur, ut habet aliqu<lb xml:id="p2z2"/>am ex te consolationem in tot tempestatibus, quę ingru<lb xml:id="p2z3"/>unt.</s>
					<s n="20" xml:lang="la">Spero tamen post nubila <persName>Phoebum</persName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Viro <lb xml:id="p2z4"/>cum primis pio ac erudito purę<lb xml:id="p2z5"/>que doctrinę adserto<lb xml:id="p2z6"/>ri d. <persName ref="p495">Henricho Bullingero</persName>, suo patrono <lb xml:id="p2z7"/>ac fratri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
