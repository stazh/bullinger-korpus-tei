	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>s
					<lb xml:id="p1z2"/>denue
					<lb xml:id="p1z3"/>dignem.
					<lb xml:id="p1z4"/>ptipud
					<lb xml:id="p1z5"/>a liters
					<lb xml:id="p1z6"/>sumptib
					<lb xml:id="p1z7"/>duo.
					<lb xml:id="p1z8"/>nec spem
					<lb xml:id="p1z9"/>nostros, qui
					<lb xml:id="p1z10"/>Dominus
					<lb xml:id="p1z11"/>meam
					<lb xml:id="p1z12"/>S. Quae ex Italia statim accepi, postquam nostri omnus
					<lb xml:id="p1z13"/>discesserunt, nunc per bellizarium quendam mitto
					<lb xml:id="p1z14"/>reverendissime dom pater. Tu nobis salvus et incolumis
					<lb xml:id="p1z15"/>hiscefruere et plura propediem vexseesta. Si quo
					<lb xml:id="p1z16"/>certiora ex Gallia habebuntur, fac, quaeso, vi
					<lb xml:id="p1z17"/>svestionis. Optimus noster Müllerus
					<lb xml:id="p1z18"/>indies deterius habet, nec sibi, quoad vestri
					<lb xml:id="p1z19"/>et dicetam consulaersatis patest, Iulianis no
					<lb xml:id="p1z20"/>paucis interim nihil non moventibus
					<lb xml:id="p1z21"/>ludus literarius destruatur. Vale colendi.
					<lb xml:id="p1z22"/>Alsie Cürch k 1534 25. jeptemr
					<lb xml:id="p1z23"/>d. pater.O
					<lb xml:id="p1z24"/>Cuius et animo Ehybias
					<lb xml:id="p1z25"/>Sconius nonistri
					<lb xml:id="p1z26"/>edic.
					<pb/>
					<lb xml:id="p2z1"/>genere virtutis et doctrinae
					<lb xml:id="p2z2"/>raeclarissimo viro d. Heinrycho
					<lb xml:id="p2z3"/>Bullingero, <placeName ref="l587">Tigurinae</placeName> ecclesiae
					<lb xml:id="p2z4"/>antistiti primario d.
					<lb xml:id="p2z5"/>singular observantia
					<lb xml:id="p2z6"/>cendissimo.
				</p>
			</div>
		</body>
	</text>
