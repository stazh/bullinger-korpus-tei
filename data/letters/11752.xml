	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Exemplum plebisciti vestri<note xml:id="fn1" type="footnote" n="1">Gemeint ist die Schrift "Der loblichen Statt <placeName ref="l587">Zürich</placeName> ordnung und erkanntnuß wider das schädlich kriegen und reyßlouffen"; vgl. oben <ref target="file11743">Nr. 1698</ref>, 24f (mit Anm. 10); 1702, 5-7.</note> mox <placeName ref="l18">Augustam</placeName> <lb xml:id="p1z2"/>consuli <persName ref="p3927">Welsero</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p3927">Hans Welser</persName>.</note> perferendum curavi et magnam <lb xml:id="p1z3"/>tibi hoc nomine gratiam habeo, mi venerande <lb xml:id="p1z4"/><persName ref="p495">Bullingere</persName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Cruentos principum nostrorum animos <lb xml:id="p1z5"/>utinam pacis princeps<note xml:id="fn3" type="footnote" n="3"><cit type="bible"><ref>Jes 9, 6</ref></cit>.</note> Christus noster coherceat!</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Verum sic committi nunc videntur monarcharum <lb xml:id="p1z7"/>istorum<note xml:id="fn4" type="footnote" n="4">Kaiser <persName ref="p18538">Karl V.</persName> und König <persName ref="p20225">Franz I.</persName>; vgl. oben <ref target="file11741">Nr. 1696</ref>, Anm. 16.</note> animi, ut uterque extrema tentaturus <lb xml:id="p1z8"/>videatur idque magno plausu inimici crucis Christi, <lb xml:id="p1z9"/><persName ref="p18593">Turci</persName><note xml:id="fn5" type="footnote" n="5">Sultan <persName ref="p18593">Suleiman I.</persName></note>, qui profecto, ni aliter nostras rationes <lb xml:id="p1z10"/>ineamus, totius Germanię rerum propediem potietur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>O ter quaterque felices, quos mature hinc ad <lb xml:id="p1z12"/>superos dominus evocat, atque o vere beatum <persName ref="p8400">Cholinum</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p8400">Peter Kolin</persName>, vgl. oben <ref target="file11747">Nr. 1702</ref>, 8-12.</note>, <lb xml:id="p1z13"/>beatos cęteros optimos et doctissimos viros, quos singulari <lb xml:id="p1z14"/>beneficio cęlestis patris eximi videmus malis istis omnium <lb xml:id="p1z15"/>longe atrocissimis, quę mundo impendent, <lb xml:id="p1z16"/>qui adeo obfirmato animo urgenti ad resipiscentiam <lb xml:id="p1z17"/>domino velut<note xml:id="fnb" type="footnote" n="b">velut <hi>über der Zeile nachgetragen.</hi></note> ex professo manibus ac pedibus<note xml:id="fn7" type="footnote" n="7">Vgl. <bibl source="b56">Adagia</bibl> 1, 4, 15 (<bibl source="b370">LB</bibl> II 157); 3, 9, 68 (<bibl source="b370">LB</bibl> II 931).</note> obnititur <lb xml:id="p1z18"/>pęnam daturus gravissimis graviores.</s>
					<s n="6" xml:lang="la">Dominus <lb xml:id="p1z19"/>nostri misertus in pusillum suum gregem<note xml:id="fn8" type="footnote" n="8">Vgl. <cit type="bible"><ref>Lk 12, 32</ref></cit>.</note> electorum <lb xml:id="p1z20"/>filiorum suorum nos adnumeret!</s>
					<s n="7" xml:lang="la" ana="salute">Illi nos, mi <lb xml:id="p1z21"/>venerande atque plusquam charissime <persName ref="p495">Bullingere</persName>, dil<lb xml:id="p1z22"/>igentissime commenda<note xml:id="fnc" type="footnote" n="c"><hi>Vor</hi> commenda <hi>gestrichenes</hi> nos.</note> cum tota nostra ecclesia.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z23"/>Saluta <persName ref="p8127">Pellicanum</persName>, <persName ref="p8171">Theodorum</persName>, <persName ref="p8412">Megandrum</persName>, in primis <lb xml:id="p1z24"/><persName ref="p8011">Gvaltherum</persName>, nostrum praecipuum amicum, gratias illi meis <lb xml:id="p1z25"/>verbis amplissimas agens pro suavissimis literis suis<note xml:id="fn9" type="footnote" n="9">Nicht erhalten.</note>, <lb xml:id="p1z26"/>quibus proxime respondeo.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Festino certe iam <lb xml:id="p1z27"/>ad describendum tibi <placeName ref="l822">Germanicum</placeName> pasquillum<note xml:id="fn10" type="footnote" n="10">Eine Abschrift dieses Pasquills von unbekannter Hand mit ausführlichen Bemerkungen <persName ref="p495">Bullingers</persName> findet sich in Zürich ZB, Ms A 127, Nr. 8, S. 221-226 und trägt den Titel "Teutscher Pasqillus [!] 1543". Der Inhalt stimmt weitestgehend mit der detaillierten Beschreibung im Brief <persName ref="p1055">Martin Frechts</persName> an <persName ref="p8049">Vadian</persName> vom 18. Dezember 1542 überein (s. <persName ref="p8049">Vadian</persName> BW VI, <ref target="file11313">Nr. 1270</ref>, hier S. 179f). Eine andere Variante ist unter dem Titel "Scomata Pasquilli in <placeName ref="l822">Germanos</placeName> evulgata anno 1542 mense novembri" gedruckt in: Pasquillorum tomi duo [Hg.: <persName ref="p714">Celio Secondo Curione</persName>], Eleutheropolis [i. e. <placeName ref="l28">Basel</placeName> (<persName ref="p8126">Johannes Oporin</persName>)] 1544, S. 530-537.</note>, <lb xml:id="p1z28"/>si forte nondum aliunde accepisti, ut clarissime ex illo <lb xml:id="p1z29"/>intelligas, quomodo omnibus ingenia<note xml:id="fnd" type="footnote" n="d"><hi>Vor</hi> ingenia <hi>ein gestrichenes, unlesbares Wort.</hi></note> comparata <lb xml:id="p1z30"/>sibi videantur.</s>
					<s n="10" xml:lang="la">Nec adeo procul ille a scopo me <lb xml:id="p1z31"/>quidem<pb type="edition" next="283"/> iudice coniicit.</s>
					<s n="11" xml:lang="la">Dominus misereatur miserrimę <lb xml:id="p1z32"/>nostrę <placeName ref="l822">Germanię</placeName>, quam, nisi irati iudicis sententiam <lb xml:id="p1z33"/>solida resipiscentia antevertat, mox deploratissimam videbimu<lb xml:id="p1z34"/>s.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Labor vester in Bibliis, de quo scribis<note xml:id="fn11" type="footnote" n="11">Vgl. oben <ref target="file11747">Nr. 1702</ref>, 9-15 mit Anm. 6.</note>, <lb xml:id="p1z35"/>magno desiderio a magnis et multis expectatur, <lb xml:id="p1z36"/>quem utinam dominus ad nominis sui gloriam feliciter absolutum <lb xml:id="p1z37"/>curet.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Salutant te nostri, in primis <placeName ref="l822">germanus</placeName> meus <lb xml:id="p1z38"/><persName ref="p8178">frater</persName><note xml:id="fn12" type="footnote" n="12"><persName ref="p8178">Thomas Blarer</persName>.</note>; <persName ref="p4321">uxor</persName><note xml:id="fn13" type="footnote" ana="bio" n="13"><persName ref="p4321">Katharina, geb. Ryff</persName>.</note> et ego tuam <persName ref="p8051">coniugem</persName><note xml:id="fn14" type="footnote" ana="bio" n="14"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note> cum liberis<note xml:id="fn15" type="footnote" n="15">Zu <persName ref="p495">Bullingers</persName> Kindern s. oben <ref target="file11701">Nr. 1658</ref>, Anm. 27.</note> officiose salutamus.</s>
					<s n="14" xml:lang="de">23. decembris 1542.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><persName ref="p495">Bullingero</persName> suo<pb/><lb xml:id="p2z1"/>.</s>
					<s n="16" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
