	<text xml:lang="de">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>ingentzwvillig dienst der zeyt zuͦvor,
					<lb xml:id="p1z2"/>wurdiger und hochgelartter, gonstiger herr
					<lb xml:id="p1z3"/>
					<lb xml:id="p1z4"/>unnd reundt.
					<lb xml:id="p1z5"/>Zrachdem
					<lb xml:id="p1z6"/>ir mir ein inhall oder etlich geschriebenn,
					<lb xml:id="p1z7"/>hab ich doch euch anderer meins gnedigen
					<lb xml:id="p1z8"/>fürsten und herrn obliegender geschefft ha,
					<lb xml:id="p1z9"/>Wie woll ichs ost gernn gewollt, mich
					<lb xml:id="p1z10"/>wider antwortten konnen. Weil aber
					<lb xml:id="p1z11"/>sich so die gelegenheyt also zu egetragen,
					<lb xml:id="p1z12"/>das ewer sohn selbst zue euch verreifet, hab
					<lb xml:id="p1z13"/>ich desto weniger underlassen wollenn
					<lb xml:id="p1z14"/>euch hirmit meinen freundtwilligenn
					<lb xml:id="p1z15"/>dienst, und was ich iderzeyt guͦths verman
					<lb xml:id="p1z16"/>zu vermelden und darbeneben, das si
					<lb xml:id="p1z17"/>ewer schnn in seinem dienst und geschefn
					<lb xml:id="p1z18"/>darin er gepraucht wirdet, ais daser frombien
					<lb xml:id="p1z19"/>fleissig unnd ufrichtig verhallten hat,
					<lb xml:id="p1z20"/>Unnd so er also furtfharenn wir det zwe
					<lb xml:id="p1z21"/>fellt mir nicht, mein gnediger fürst und
					<lb xml:id="p1z22"/>her werde solches zegen ihnen inn gnan
					<lb xml:id="p1z23"/>elches ic
					<lb xml:id="p1z24"/>denn erlennen.
					<lb xml:id="p1z25"/>
					<lb xml:id="p1z26"/>.
					<pb/>
					<lb xml:id="p2z1"/>euch anzeigenn wollen unnd bin euch freundticen
					<lb xml:id="p2z2"/>willige diennst zu eerzeigen gefliessenn.
					<lb xml:id="p2z3"/>Marpurge ann 5. martii anno domini 1563.
					<lb xml:id="p2z4"/>
					<lb xml:id="p2z5"/>Din stwilligr
					<lb xml:id="p2z6"/>Mlexander Bsluger g.
					<pb/>
					<lb xml:id="p4z1"/>em wurdigenn unnd hochgelerttenn hern
					<lb xml:id="p4z2"/>Henrico Bullingero, Harhernn zue
					<lb xml:id="p4z3"/>Zurch, meinem gonstigenn herrnn
					<lb xml:id="p4z4"/>unnd freunndt.
					<lb xml:id="p4z5"/>t
					<lb xml:id="p4z6"/>Alepander pflügern
					<lb xml:id="p4z7"/>latgrävischer secretari.
					<lb xml:id="p4z8"/>1553.
				</p>
			</div>
