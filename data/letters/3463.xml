	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Benedicat tibi et domui tuae univer<lb xml:id="p1z2"/>sae dominus et faxit, ut hic annus novus sit <lb xml:id="p1z3"/>felicissimus.</s>
					<s n="3" xml:lang="la">Heri demum sub vesperam literas <lb xml:id="p1z4"/>tuas 18. decembris datas accepi.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Hodie sub auroram <lb xml:id="p1z5"/>nunciat filius noster <persName>Ioannes</persName> adesse, qui optime <lb xml:id="p1z6"/>curare possit nostras literas; at eum iam <lb xml:id="p1z7"/>nunc abiturum.</s>
					<s n="5" xml:lang="la">Proinde non potui ordine <lb xml:id="p1z8"/>ad tuas respondere neque ea, quae volueram, exarare.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Habebam quaedam de legatione nostrorum <lb xml:id="p1z10"/>in <placeName ref="l832">Galliam</placeName> et de colloquio <placeName ref="l569">Wormatiensi</placeName>.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>Non admodum feliciter aut ex animi sententia <lb xml:id="p1z12"/>cessit legatio cardinalibus et episcopis oppugnantibus <lb xml:id="p1z13"/>Christum et regem seducentibus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Collo<lb xml:id="p1z14"/>quium finitum est sub initium mensis d<lb xml:id="p1z15"/>ecembris.</s>
					<s n="9" xml:lang="la">Nihil effectum est; congressum <lb xml:id="p1z16"/>detrectarunt legitimum papistae.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Quoniam vero <lb xml:id="p1z17"/>intra paucos dies ad nos venturus es, audi<lb xml:id="p1z18"/>es, deo volente, omnia; tum ad sacietatem <lb xml:id="p1z19"/>colloquemur.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Salvus sit optimus senex <lb xml:id="p1z20"/>d. <persName ref="p6831">Traversius</persName>, salvi sint omnes amici nostri <lb xml:id="p1z21"/>et pastores imprimis nostri.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 8. ian<lb xml:id="p1z22"/>uarii 1558.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z23"/><persName ref="p495">Bullingerus</persName> tuus<pb/><lb xml:id="p2z3"/>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z4"/>Virtutibus et genere <lb xml:id="p2z5"/>praeclaro viro d. <persName ref="p8432">Fri<lb xml:id="p2z6"/>derycho a Salice</persName>, <placeName ref="l440">Sa<lb xml:id="p2z7"/>madeno</placeName> <placeName ref="l648">Rheto</placeName>, s<lb xml:id="p2z8"/>ingulari suo amico et <lb xml:id="p2z9"/>tanquam fratri.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>