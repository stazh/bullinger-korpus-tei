	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Tabellarium habeo idoneum,<note xml:id="fn1" type="footnote" n="1">Siehe dazu unten <ptr target="qvfn17226-1" type="qv"/>.</note> materiam autem scribendi ad te minus congruam.<note xml:id="fn2" type="footnote" n="2">Vgl. schon <ref target="file13002">Nr. 2953</ref>, <ptr target="qvfn17219-2" type="qv"/>.</note></s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Dabis igitur veniam negligentię.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="4" xml:lang="la"><persName ref="p2812">Rumanus</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p2812">(Hans) Thoman Ruman (Römer)</persName>.</note> noster omnino decrevit hinc <lb xml:id="p1z3"/>discedere atque, cum perseveranter abitionem postularet,<note xml:id="fn4" type="footnote" n="4">Vgl. <ref target="file13000">Nr. 2951</ref>, <ptr target="qvfn17216-1" type="qv"/>; <ref target="file13002">Nr. 2953</ref>,<ptr target="qvzl17219-5" type="qv"/>.</note> senatus eum <lb xml:id="p1z4"/>dimisit, quod mihi inconsultissimum factum visum est.<note xml:id="fn5" type="footnote" n="5">Vgl. <ref target="file12969">Nr. 2920</ref>,<ptr target="qvzl17185-1" type="qv"/>.</note></s>
					<s n="5" xml:lang="la">Audio quoque ipsi, <lb xml:id="p1z5"/>quantum ad itineris sumptus, etc., pertinet, minime, ut decuerat, prospectum <lb xml:id="p1z6"/>esse, quod nimię festinationi tum etiam pertinati discessus decreto <lb xml:id="p1z7"/>imputetur.</s>
					<s n="6" xml:lang="la">Ego in his turbis bonum virum iuvare non potui.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z8"/>Hodie hic appulit <persName ref="p20183">dux Albę</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p20183">Fernando Álvarez de Toledo</persName>, Herzog von <placeName ref="l3178">Alba</placeName>. - Siehe auch <ref target="file12999">Nr. 2950</ref>,<ptr target="qvzl17215-12" type="qv"/>.</note> cum magno pullatorum numero.</s>
					<s n="8" xml:lang="la">Perendie <lb xml:id="p1z9"/><persName ref="p18538">cęsar</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p18538">Karl V.</persName> - Er traf schon am folgenden Tag in <placeName ref="l18">Augsburg</placeName> ein; s. <ref target="file13001">Nr. 2952</ref>, <ptr target="qvfn17218-2" type="qv"/>.</note> forsan etiam adventurus est.</s>
					<s n="9" xml:lang="la">Comicia debent <placeName ref="l18">Augustę</placeName> celebrari, <lb xml:id="p1z10"/>cum nulla adhuc sint indicta.<note xml:id="fn8" type="footnote" n="8">Siehe aber <ref target="file13001">Nr. 2952</ref>, <ptr target="qvfn17218-1" type="qv"/>.</note></s>
					<s n="10" xml:lang="la">Incredibilis apparet rerum permutatio!</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z11"/>Inter <placeName ref="l862">Helvetios</placeName> optime convenire communis frater noster <persName ref="p8055">Ambrosius B[laurerus]</persName> mihi <lb xml:id="p1z12"/>scripsit.<note xml:id="fn9" type="footnote" n="9">Mit einem nicht in <bibl source="b51">Blarer BW</bibl> erhaltenen Brief. - Vgl. zum damaligen guten Verhältnis der <placeName ref="l862">Eidgenossen</placeName> untereinander <ref target="file13003">Nr. 2954</ref>,<ptr target="qvzl17220-3" type="qv"/>; <ref target="file13007">Nr. 2958</ref>,<ptr target="qvzl17224-3" type="qv"/>.<ptr target="zfnfn17226-2" type="zfn"/></note></s>
					<s n="12" xml:lang="la">Inter cętera asserit ipsos tam flagranti studio, nunquam ut <lb xml:id="p1z13"/>modo, animos iunxisse.</s>
					<s n="13" xml:lang="la">Maximum sane vectigal est concordia!<note xml:id="fn10" type="footnote" n="10">Vgl. das <placeName ref="l822">deutsche</placeName> Sprichwort "Eintracht trägt ein (ist einträglich)"; s. <bibl source="b681">Wander</bibl> I 798, Nr. 8.</note></s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z14"/>Cętera narrabit dominus <persName ref="p2812">Rumanus</persName>.</s>
					<s n="15" xml:lang="la">Ora ad dominum pro nobis!</s>
					<s n="16" xml:lang="la">Dominus <lb xml:id="p1z15"/>vicissim servet vos.</s>
					<s n="17" xml:lang="la">Amen.</s>
					<s n="18" xml:lang="la" ana="salute">Salveant <persName ref="p8011">Gvalterus</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p8011">Rudolf Gwalther</persName>.</note> cum tota vestra congre<lb xml:id="p1z16"/>gatione fidelium.</s>
					<s n="19" xml:lang="de">22. iulii 1547.</s>
					<s n="20" xml:lang="la"><lb xml:id="p1z17"/>Tuus <persName ref="p8354">Georgius Laetus</persName>, etc.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z2"/>amico incomparabili.<note xml:id="fn12" type="footnote" n="12">Dieser Brief wurde <persName ref="p2812">Ruman</persName> mitgegeben (s. oben Z. <ptr target="qvzl17226-1" type="qv"/>), und zwar zusammen mit <persName ref="p8417">Wolfgang Musculus</persName>' Zeugnis für <persName ref="p2812">Ruman</persName> vom 14. Juli (s. <ref target="file13000">Nr. 2951</ref>) und mit <persName ref="p8018">Hallers</persName> Briefen vom 15. und 22. Juli (s. <ref target="file13011">Nr. 2962</ref>,<ptr target="qvzl17227-1" type="qv"/>).<ptr target="zfnfn17226-1" type="zfn"/></note></s>
				</p>
			</div>
		</body>
