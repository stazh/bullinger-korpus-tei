	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Oblitus sum nuper in eo fasciculo, quem ad te misi, includere <lb xml:id="p1z2"/>praefationem illam, cuius in meis literis mentionem faciebam.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Eam igitur nunc mitto cum auctario, is est cum libello <lb xml:id="p1z4"/>ipso, additurus librum <persName>Eberi</persName>, nisi veritus essem tabellarium <lb xml:id="p1z5"/>gravare.</s>
					<s n="3" xml:lang="la">Laboro et enitor, quantum possum, ut <persName ref="p458">Brentianum</persName> <lb xml:id="p1z6"/>responsum ad <placeName ref="l284">Lipsenses</placeName> nundinas mittatur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><placeName ref="l301">Lugduni</placeName> pergit <lb xml:id="p1z7"/>pestis grassari.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Commendo tibi negotium illud de foedere.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/>Rumor hic ortus est ad arma istic esse conclamatum.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z9"/>Dominus faxit, ut meliora brevi audiamus et <lb xml:id="p1z10"/>domita ista ferocia boni pace sancta perfruantur.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z11"/>Bene vale, mi pater.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">D. Iesus te servet incolumem <lb xml:id="p1z12"/>cum collegis omnibus.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Hic apud nos dei <lb xml:id="p1z13"/>beneficio, quicquid pestis erat, iam pene est <lb xml:id="p1z14"/>sopitum.</s>
					<s n="11" xml:lang="la" ana="farewell">Iterum vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l167">Genevae</placeName> 30. augusti.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Tuus <persName ref="p8033">Beza</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z15"/>Accepi ultimas tuas literas hoc <lb xml:id="p1z16"/>e<lb xml:id="p1z17"/>odem die cum uno <lb xml:id="p1z18"/>praeterea libri tui folio; <lb xml:id="p1z19"/>sed priorem eius partem <lb xml:id="p1z20"/>non misisti.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
