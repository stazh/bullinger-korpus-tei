	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Narravit mihi d. <persName ref="p8018">Hallerus</persName> compater <lb xml:id="p1z2"/>meus, <persName ref="p495">Bullingere</persName> compater in domino charissime, <lb xml:id="p1z3"/>quid apud vos designarit <persName>Nicolaus</persName>, nepos <lb xml:id="p1z4"/>meus ex fratre, et e quo illum discrimine <lb xml:id="p1z5"/>interventu tuo eripueris.</s>
					<s n="3" xml:lang="la">Periclitatur et, nisi <lb xml:id="p1z6"/>resipiscat, prorsus peribit sua culpa.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Educavi <lb xml:id="p1z7"/>illum a puero cura ac diligentia quam potui pa<lb xml:id="p1z8"/>terna; nolebat, cum posset, operam dare <lb xml:id="p1z9"/>literis, sed perpetuo aspirabat ad artificium <lb xml:id="p1z10"/>aliquod manuarium.</s>
					<s n="5" xml:lang="la">Coactus addixi eum meis <lb xml:id="p1z11"/>sumptibus arti chirurgicae et hoc nomine <lb xml:id="p1z12"/>misi <placeName ref="l18">Augustam</placeName> commendavique amicis, quos isthic <lb xml:id="p1z13"/>habeo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Duravit ad tempus, postea coepit <lb xml:id="p1z14"/>vagari <lb xml:id="p1z15"/>et <lb xml:id="p1z16"/>va<lb xml:id="p1z17"/>ga<lb xml:id="p1z18"/>nd<lb xml:id="p1z19"/>o mor<lb xml:id="p1z20"/>es pes<lb xml:id="p1z21"/>si<lb xml:id="p1z22"/>mos <lb xml:id="p1z23"/>im<lb xml:id="p1z24"/>bibere, <lb xml:id="p1z25"/>qu<lb xml:id="p1z26"/>ibus <lb xml:id="p1z27"/>sic as<lb xml:id="p1z28"/>suevi<lb xml:id="p1z29"/>t, <lb xml:id="p1z30"/>u<lb xml:id="p1z31"/>t e<lb xml:id="p1z34"/>men<lb xml:id="p1z36"/>dat<lb xml:id="p1z37"/>i<lb xml:id="p1z38"/>o<lb xml:id="p1z39"/>ni<lb xml:id="p1z40"/>s <lb xml:id="p1z41"/>sp<pb/><lb xml:id="p2z2"/>e<lb xml:id="p2z4"/>s</s>
				</p>
				<p>
					<note>[<persName>T. Schieß</persName> hat nur bis hierher abgeschrieben.]</note>
				</p>
			</div>
