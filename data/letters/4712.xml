	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>[...] stratui amplissimo gratias agam de exhibit... <lb xml:id="p1z2"/>eumque brevi invisam.</s>
					<s n="2" xml:lang="la">Non miror, si nihil offerrent <lb xml:id="p1z3"/>cum negocium nobis fuerit cum pertinacibus et quasi <lb xml:id="p1z4"/>furiosis.</s>
					<s n="3" xml:lang="la"><persName ref="p8423">Scultetus Pfiffer</persName> hinc transiit nec me voluit <lb xml:id="p1z5"/>visitare nec mecum coenare; nihil omnino efficiet, <lb xml:id="p1z6"/>si verbis foederis stemus et equitas hic sit aliqua.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Quia illum et sui similes contemno neque pecuniis illos <lb xml:id="p1z8"/>repleo, detraherent libenter mihique imputarent, quod <lb xml:id="p1z9"/>illorum pensiones et debita persoluta non sunt et quod <lb xml:id="p1z10"/>regnorum mutationibus mutentur etiam negocia et verba.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z11"/>Sed hic murus aheneus<note xml:id="fn1" type="footnote" n="1"><bibl source="b56">Adagia</bibl>, 2, 10, 25 (<bibl source="b370">LB</bibl> II 690).</note> etc. norunt me rex et <lb xml:id="p1z12"/>qui sunt illi a consiliis et boni plurimi, at et deus est, <lb xml:id="p1z13"/>qui suos tuetur a calumniis.</s>
					<s n="6" xml:lang="la">Fuit contentio inter <placeName ref="l1209">Navarre</placeName> regem <lb xml:id="p1z14"/>et <persName>Guisie</persName> ducem nec amplius ferre potuit, ut alter <lb xml:id="p1z15"/>se <lb xml:id="p1z16"/>interponeret aut imperaret, et cum multis principibus et conestabili <lb xml:id="p1z17"/>discedere voluit; sed sedata sunt omnia, ita ut <lb xml:id="p1z18"/>longe plus possit <persName>Navarrus</persName> quam antea.</s>
					<s n="7" xml:lang="la"><persName>Guisae</persName> dux <lb xml:id="p1z19"/>comitatur viduam regis <persName>Francisci Remos</persName>, ubi est cardinalis <lb xml:id="p1z20"/>et <persName>Guisiani</persName> alii nec ante mayum rediturus maior spes <lb xml:id="p1z21"/>quam antea vere pacis in <placeName ref="l832">Gallia</placeName>, maior opinio nationalis <lb xml:id="p1z22"/>consilii quam universalis.</s>
					<s n="8" xml:lang="la">Dominus <persName ref="p8111">Martir</persName> videbit, que Italice <lb xml:id="p1z23"/>ad me scripta sunt; post remittes.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Filius aget gratias <lb xml:id="p1z24"/>pro libello Germanico, alias pluribus agam plus ocii nactus.</s>
					<s n="10" xml:lang="la" ana="salute"><lb xml:id="p1z25"/>Salutabis amicos omnes nosque amabis et curam habebis <lb xml:id="p1z26"/>valetudinis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l760">Soluduri</placeName> 16. martii.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z27"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
					<s n="13" xml:lang="de"><pb/><lb xml:id="p2z1"/>An herrn <persName ref="p495">Heinrych <lb xml:id="p2z2"/>Bullinger</persName>, verkhünder <lb xml:id="p2z3"/>des worts gottes.</s>
					<s n="14" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
