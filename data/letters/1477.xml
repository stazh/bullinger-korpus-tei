	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Doleo valde libellum tibi, colendissime m<lb xml:id="p1z2"/>i <persName ref="p8418">Myconi</persName>, non esse redditum.</s>
					<s n="3" xml:lang="la">Iam ergo <lb xml:id="p1z3"/>resarco illum errorem et pro uno mitto <lb xml:id="p1z4"/>tuae pietati duos.</s>
					<s n="4" xml:lang="la">Binas alioqui tuas <lb xml:id="p1z5"/>recepi et ago gratias pro diligentia tua; <lb xml:id="p1z6"/>sed quoniam in illis nihil est, ad quod <lb xml:id="p1z7"/>respondere oporteat, non indigne feres, <lb xml:id="p1z8"/>si nihil respondeam; nec possem per temporis <lb xml:id="p1z9"/>angustiam, si omnino respondere oporteret.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z10"/>Comicia <placeName ref="l21">Badensia</placeName> postridie incipient; <lb xml:id="p1z11"/>postulabit rex, ut mittantur aliquot co<lb xml:id="p1z12"/>hortes <placeName ref="l862">Helvetiorum</placeName>, duo milia opinor; <lb xml:id="p1z13"/>hos praesidii loco deducet in <placeName ref="l736">Pedemontem</placeName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z14"/>Silent res <placeName ref="l2481">Svevorum</placeName>; vereor, ne nimis <lb xml:id="p1z15"/>obsequentes sint Caesari.</s>
					<s n="7" xml:lang="la">Tu si quid habes <lb xml:id="p1z16"/>ab amicis, communica.</s>
					<s n="8" xml:lang="la">Ex <placeName ref="l834">Italia</placeName> scribunt <lb xml:id="p1z17"/>viri pii et praestantes ecclesias crescere, <lb xml:id="p1z18"/>utcunque insaniat diabolus.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale una <lb xml:id="p1z19"/>cum omnibus piis.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 20. novembris, <lb xml:id="p1z20"/>quo die ante 20 annos patria mea relicta <lb xml:id="p1z21"/>cogebar <placeName ref="l587">Tigurum</placeName> profugere, ne a <placeName ref="l2448">Quinque<lb xml:id="p1z22"/>pagicis</placeName> victoribus obtruncarer aut <lb xml:id="p1z23"/>comburerer.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/>Domino sit gloria.</s>
					<s n="12" xml:lang="la">1551.</s>
				</p>
