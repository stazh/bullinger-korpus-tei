	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salve.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Tuae mihi literae sunt redditae.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Brevior <lb xml:id="p1z2"/>sum; nam misere me excruciat do<lb xml:id="p1z3"/>mesticus meus hostis, singulis prope mensibus <lb xml:id="p1z4"/>me conficiens, capitis dolor vehementissimus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Non est, quod sis solicitus propter <persName ref="p2336">Bernardinum</persName>; <lb xml:id="p1z6"/>heri discescit profectus <placeName ref="l28">Basileam</placeName>; si non <lb xml:id="p1z7"/>recipietur, proficiscetur forte ad socios in <lb xml:id="p1z8"/><placeName ref="l2472">Poloniam</placeName>; nescio enim, quo alias possit <lb xml:id="p1z9"/>proficisci.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Causam totam cognosces ex his, <lb xml:id="p1z10"/>quae illis inclusi; sed ea remittes.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Prae<lb xml:id="p1z11"/>vertit sibi praefixum discedendi terminum, <lb xml:id="p1z12"/>qui mali sibi fuit conscius; timuit cen<lb xml:id="p1z13"/>suram libri sui.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Dialogi de trinitate scripti <lb xml:id="p1z14"/>duo sunt pestilentissimi et penitus proculcandi.</s>
				</p>
				<p>
					<s n="8" xml:lang="de"><lb xml:id="p1z15"/><foreign xml:lang="la">Ob vinum <placeName ref="l648">Rheticum</placeName> nolim te solicitum esse;</foreign> so <lb xml:id="p1z16"/>vil ich des gebruchen wil minen lieben <lb xml:id="p1z17"/>gesten, wirt mich <persName ref="p6990">Hans Wägman</persName> mitt der zyt <lb xml:id="p1z18"/>wol versorgen.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/>Redi<lb xml:id="p1z20"/>it <placeName ref="l301">Lugduno</placeName> <lb xml:id="p1z21"/><persName ref="p3043">Stokerus</persName> et mihi retulit omnia iam in <placeName ref="l832">Gallia</placeName> <lb xml:id="p1z22"/>esse pacata; quod veram religionem attinet, <lb xml:id="p1z23"/>res optime habere et spem esse summam; regem <lb xml:id="p1z24"/>quoque spei esse maximę.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Ideo vero <placeName ref="l862">Helvetiorum</placeName> <lb xml:id="p1z25"/>legio est dimissa; qui residui sunt, <lb xml:id="p1z26"/>revertuntur omne<note type="margin">dazu a.R.: "Sy sind duchig."</note>.</s>
					<s n="11" xml:lang="de">Die herrschafften werd<lb xml:id="p1z27"/>ent den geistlichen verkoufft etc.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z28"/>Bene vale.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="salute">Omnes mei te salutant.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Plura non possum.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z29"/>Saluta consules, <persName ref="p8359">Gallici<lb xml:id="p1z30"/>u<lb xml:id="p1z31"/>m</persName>, <lb xml:id="p1z32"/><persName ref="p6130">Pontisellam</persName> et fratres alios, imprimis d. meum <lb xml:id="p1z33"/>colendissimum <persName ref="p2054">Martinengum</persName>; summam actionis <lb xml:id="p1z34"/>cum <persName ref="p2336">Bernardino</persName> illi communicare potes; <lb xml:id="p1z35"/>ego quoque nuper illi quaedam eius significavi.</s>
					<s n="16" xml:lang="de">3. <lb xml:id="p1z36"/>decembris 1563.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z37"/>Tuus ille <persName ref="p495">Bullinger</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <persName ref="p8009">Ioanni <lb xml:id="p2z2"/>Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministro, fatri <lb xml:id="p2z4"/>meo charissimo.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p2z5"/>Chur.</s>
				</p>
			</div>
		</body>
