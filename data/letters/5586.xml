	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Miror te et fratrem et vos omnes ita silere <lb xml:id="p1z2"/>inter tantos rumores; speravi enim subinde <lb xml:id="p1z3"/>me a vobis certa aliqua accepturum.</s>
					<s n="3" xml:lang="la">Quae <lb xml:id="p1z4"/>apud os ferebantur, de conflictu <placeName ref="l832">Gallico</placeName> ad <lb xml:id="p1z5"/>fratrem scripsi; sed sequentes rumores subinde alia <lb xml:id="p1z6"/>atque alia afferunt.</s>
					<s n="4" xml:lang="la">Sunt, qui affirment <placeName>Condensem</placeName> <lb xml:id="p1z7"/>liberatum iterum, et hoc ex <placeName ref="l167">Geneva</placeName> privatim huc <lb xml:id="p1z8"/>scriptum est.</s>
					<s n="5" xml:lang="la">Heri relatum nobis est <persName>Guisianum</persName> quoque <lb xml:id="p1z9"/>ex vulneribus, quę ex bombardarum ictibus accepit, <lb xml:id="p1z10"/>obiisse, atque utinam hoc verum esset!</s>
					<s n="6" xml:lang="la">Alii affirmant <lb xml:id="p1z11"/><placeName ref="l2771">Rothomagum</placeName> ab <placeName ref="l830">Anglis</placeName> esse occupatum; sed inter <lb xml:id="p1z12"/>tot et tam varios rumores tam nihil certi constat, <lb xml:id="p1z13"/>ut nostri <placeName ref="l491">Argentinam</placeName> miserint, qui inde certa <lb xml:id="p1z14"/>afferant.</s>
					<s n="7" xml:lang="la">Helvetiorum capitaneorum, qui supersunt, scriptum <lb xml:id="p1z15"/>vos quoque habere puto; nihilominus his addo; tu potes <lb xml:id="p1z16"/>illud per hunc nuncium remittere; non enim aliud exemplar habeo<note type="margin">Zusatz a.R. mit Verweisung: "non - habeo"</note>.</s>
					<s n="8" xml:lang="la">Expectavimus, <lb xml:id="p1z17"/>ut aliquis vestrum veniret ad nuptias <persName ref="p8351">Theobaldi <lb xml:id="p1z18"/>Frischingi</persName>, quę heri fuerunt; sed frustrati sumus <lb xml:id="p1z19"/>omnes spe nostra.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Valde hoc fuisset gratum <persName ref="p8063">Steigero</persName> <lb xml:id="p1z20"/>consuli et omnibus propinquis.</s>
					<s n="10" xml:lang="la">Alias nunc nihil <lb xml:id="p1z21"/>habeo.</s>
					<s n="11" xml:lang="la" ana="salute">Fratrem meo nomine saluta una cum tuis <lb xml:id="p1z22"/>omnibus; ad ipsum enim nunc nihil scribo.</s>
					<s n="12" xml:lang="la">Nescio, <lb xml:id="p1z23"/>cuius rei gratia hic nuncius mittatur.</s>
					<s n="13" xml:lang="la">Legati nostri <lb xml:id="p1z24"/><placeName>Badena</placeName> nondum sunt reversi; fac, quaeso, sciam, quid <lb xml:id="p1z25"/>ibi agatur.</s>
					<s n="14" xml:lang="la">Audivimus imperatorem <placeName ref="l441">Scaphusiam</placeName> transisse.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z26"/><placeName ref="l41">Bernae</placeName> 15. ianuarii 1563.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z27"/>Admone etiam fratrem, <lb xml:id="p1z28"/>si quid per hunc scribere velit.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z29"/><persName ref="p8018">I[<lb xml:id="p1z30"/>oannes] H[a<lb xml:id="p1z31"/>llerus</persName>], <lb xml:id="p1z32"/>semper tuus.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino <lb xml:id="p2z4"/>suo ac compatri per<lb xml:id="p2z5"/>petuo amore prosequendo.</s>
				</p>
				<p>
					<s n="19" xml:lang="de"><lb xml:id="p2z6"/>M. <persName ref="p495">Heinrych Bullinger</persName>n <lb xml:id="p2z7"/>zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
