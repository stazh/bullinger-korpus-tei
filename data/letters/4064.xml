	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mittit ad me dilectus nobis <persName ref="p8009">Ioannes Fabricius</persName> rogans, ut ego ad tuam <lb xml:id="p1z2"/>humanitatem scribam tam suo quam meo nomine; sese enim omnino non <lb xml:id="p1z3"/>posse, quod hac nocte pepererit ei uxor nimium propere maximis cum <lb xml:id="p1z4"/>doloribus desperatis iam rebus filiolam, quae non diu a nativitate vixerit.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Accepimus ergo tuae humanitatis literas simul cum dono <lb xml:id="p1z6"/>preciosissimo, concionum nimirum tuarum in Ieremiam.</s>
					<s n="4" xml:lang="la">Tu benefact<lb xml:id="p1z7"/>a benefactis tegis, quod ille dixit, ne perpluant; at nos nihil nisi <lb xml:id="p1z8"/>gratias maximas agimus.</s>
					<s n="5" xml:lang="la">Scimus enim nos tandem et referre debere.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Caeterum notabiliora, quae habemus, sunt haec: <placeName ref="l834">Italia</placeName> hoc anno famem <lb xml:id="p1z10"/>sentiet.</s>
					<s n="7" xml:lang="la"><placeName ref="l425">Romanum</placeName> pontificem mortuum esse accipit et nobis nuntiat <lb xml:id="p1z11"/>regius hic legatus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Vini satis est in <placeName ref="l520">Valletelina</placeName>, minus apud <lb xml:id="p1z12"/>nos hic.</s>
					<s n="9" xml:lang="la">Foederum nostrorum loca montana et sylvestria re fru<lb xml:id="p1z13"/>menaria satis abundant, foeni copia nusquam, armenta multa iuniora <lb xml:id="p1z14"/>quidem emuntur hinc in <placeName ref="l834">Italiam</placeName> abducenda, et quod primum sit: <lb xml:id="p1z15"/>res evangelica apud nos in Foederibus peiore in statu, quam ante annos <lb xml:id="p1z16"/>aliquot erat, nunc non est; maioribus enim laudibus extollere non pos<lb xml:id="p1z17"/>sum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Dominus Iesus te caeterosque pios et doctos istic diutissime conservet <lb xml:id="p1z18"/>incolumes.</s>
					<s n="11" xml:lang="la" ana="farewell">Vale, vir humanissime, et <persName ref="p8359">Philippum</persName> tibi antiquum <lb xml:id="p1z19"/>amicum redamare non desinas.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Ex <placeName ref="l98">Curia</placeName> die 28. augusti 1559.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z20"/>Tuae humanitatis totus <persName ref="p8359">Philippus Gallicius</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vere magno viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>bonis omnibus colen<lb xml:id="p2z4"/>dissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z5"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
