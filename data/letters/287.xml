	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Evocatus est a <persName ref="p8018">Ioanne Hallero</persName>, <placeName ref="l41">Bernensis</placeName> ecclesie ministro, <persName>Paulus</persName> ille noster, <lb xml:id="p1z3"/>pius homo et fidei plenus, et spes est minime vana futurum, ut commoda aliqua <lb xml:id="p1z4"/>ecclesia ei provideatur, im[m]o ecclesiae magis consulatur tanti viri bonita<lb xml:id="p1z5"/>te et diligentia nec vulgari eruditione.</s>
					<s n="3" xml:lang="la">Quare et te oratum velim, viro <lb xml:id="p1z6"/>tui amantissimo commendatitiis literis tuis, quae multum ei proderunt, non deesses.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Scripsi sane et ego ad D. <persName ref="p8018">Hallerum</persName> neque certius quicquam me impetraturum <lb xml:id="p1z8"/>esse mihi persuadeo, quam si tuae literae, quae vel solae omnia possent, <lb xml:id="p1z9"/>meis accesserint.</s>
					<s n="5" xml:lang="la">non est autem, ut vel vos <placeName ref="l587">Tiguri</placeName> vel illi <placeName ref="l41">Bernae</placeName> vereantur <lb xml:id="p1z10"/>maiorem exsulum fratrum numerum.</s>
					<s n="6" xml:lang="la">Ubique enim sunt ecclesiae, quae n<lb xml:id="p1z11"/>ihil in illis fovendis alendisque officii intermittunt, et nihil deest vere fidentibus <lb xml:id="p1z12"/>domino.</s>
					<s n="7" xml:lang="la">Haeret adhuc apud nos unicus ille <persName>Chuͦnradus</persName> <placeName ref="l257">Constantiensis</placeName>, <lb xml:id="p1z13"/>doctus et pius vir et <persName ref="p8417">Musculo</persName> nostro <persName>Pauloque</persName> notus, ille, inquam, qui tanta ani<lb xml:id="p1z14"/>mi constantia, tanto cum incremento fidei Christi euangelion primus omnium <lb xml:id="p1z15"/><placeName ref="l409">Ravenspurgi</placeName> praedicavit, multis cum lachrymis et ingenti cum moerore <lb xml:id="p1z16"/>dimissus a sua ecclesia, quum magistratus ipsum urbe excedere iussisset.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Credo, daturos operam ministros nostros, ut et ipsi locus aliquis commodus <lb xml:id="p1z18"/>designetur, in quo commissum sibi talentum multo foenore augere et <lb xml:id="p1z19"/>eximiam suo domino, ut cepit, operam navare queat.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Novi alioqui nihil <lb xml:id="p1z20"/>habemus praeter illud unum, quod nostris ex <placeName ref="l834">Italia</placeName> scribitur:</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><persName>Philippum</persName>, Caesaris filium, <lb xml:id="p1z21"/>ad Eidus Octobres <placeName ref="l1121">Genuam</placeName> instructissima cum classe venturum <lb xml:id="p1z22"/>esse; neque admodum de caussa constat, cur a patre sit vocatus, nisi credi<lb xml:id="p1z23"/>bile est, in hoc esse <persName>Carolum</persName>, ut filium sibi ordinum favore constituat im<lb xml:id="p1z24"/>perii successorem.</s>
					<s n="11" xml:lang="la">Ita variant rerum vices, ut <placeName ref="l822">Germani</placeName>, qui multis saeculis <lb xml:id="p1z25"/><placeName ref="l875">Hispanis</placeName> imperarunt, clarissimis populis illo migrantibus, iam <lb xml:id="p1z26"/>vice versa <placeName ref="l875">Hispanos</placeName> imperatores ferant et migrantes ad se non ferre <lb xml:id="p1z27"/>modo, sed obviis etiam ulnis excipere coga[n]tur.</s>
					<s n="12" xml:lang="la">Vigilent igitur <placeName ref="l862">Helvetii</placeName>, <lb xml:id="p1z28"/>ne durissima aliqua eiusdem gentis iniecta servitute obrua[n]tur.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z29"/>et D. <persName ref="p8417">Musculum</persName> salvum meo nomine iube atque itam D. <persName ref="p8440">Gervasium</persName>.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z30"/><placeName ref="l473">Sangalli</placeName>, IIII calendas Octobres, anno MDXLVIII.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><persName ref="p8049">Ioachimus Vadianus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro domino <persName ref="p495">Henrycho <lb xml:id="p2z2"/>Bullingero,</persName> almae <lb xml:id="p2z3"/>urbis <placeName ref="l587">Tigurinae</placeName> episcopo, domino <lb xml:id="p2z4"/>suo valde colendo.</s>
				</p>
			</div>
		</body>
