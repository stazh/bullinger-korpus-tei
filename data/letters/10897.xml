	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><persName ref="p8127">Pellicanus</persName> noster omnia, quae praesens audivit ex <placeName ref="l491">Argentinensibus</placeName>, exponet<note xml:id="fn1" type="footnote" n="1"><persName ref="p8127">Pellikan</persName> war Mitte Juni über <placeName ref="l586">Zurzach</placeName> und <placeName ref="l28">Basel</placeName> nach <placeName ref="l491">Straßburg</placeName> gereist, wo er <persName ref="p5565">Capito</persName>, <persName ref="p467">Bucer</persName> und <persName ref="p4079">Zwick</persName> traf, die soeben vom <placeName ref="l558">Wittenberger</placeName> Konvent zurückgekehrt waren; s. Pellikan, Chronikon 145f (vgl. ebd., S. XXXVIf); <bibl source="b42">Vadian BW V</bibl> 331f.</note>, <lb xml:id="p1z2"/>itidem de ecclesia nostra deque nobis omnibus.</s>
					<s n="3" xml:lang="la">Equidem ut adfectus sim articulo <lb xml:id="p1z3"/><placeName ref="l749">Saxonici</placeName> conventus viso<note xml:id="fn2" type="footnote" n="2">Gemeint ist die <placeName ref="l558">Wittenberger</placeName> Konkordie (<bibl source="b135">BucerDS</bibl> VI/1 114-134; <bibl source="b671">WA</bibl> Briefwechsel XII 200-212).</note> dicam, paucis.</s>
					<s n="4" xml:lang="la">Quo magis illi negocium eu<lb xml:id="p1z4"/>charistiae conantur explicare, eo magis ego implicor.</s>
					<s n="5" xml:lang="la">Quo clariora, quęcunque <lb xml:id="p1z5"/>huc pertinent, reddere student, eo fiunt obscuriora mihi.</s>
					<s n="6" xml:lang="la">Quid <persName ref="p18056">Ireneus</persName>, quęso, <lb xml:id="p1z6"/>facit in confessionis initio<note xml:id="fn3" type="footnote" n="3">Siehe <bibl source="b135">BucerDS</bibl> VI/1 120, 3f.</note> author obscurus et qui a veteribus non ubique <lb xml:id="p1z7"/>solidus est iudicatus?</s>
					<s n="7" xml:lang="la">Tum quid illud, quod saepe ventilatum est ab omnibus:</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><pb type="edition" next="354"/>"Christus <lb xml:id="p1z8"/>datur et sumitur cum pane et vino<note xml:id="fn4" type="footnote" n="4">Siehe ebd., S. 120, 4f.</note>"?</s>
					<s n="9" xml:lang="la">Ingenue fateor, nescio, quid dicant.</s>
					<s n="10" xml:lang="la">Non <lb xml:id="p1z9"/>est hic transsubstantiatio, non localis inclusio; quo modo igitur cum pane <lb xml:id="p1z10"/>datur corpus Christi<note xml:id="fn5" type="footnote" n="5">Siehe ebd., S. 122, 1-4.</note>?</s>
					<s n="11" xml:lang="la">Expositionem deinde non capio super unione sacramentali<note xml:id="fn6" type="footnote" n="6"><persName ref="p8418">Myconius</persName> scheint sich hier und im folgenden nicht mehr direkt auf die Konkordienformel, sondern auf den Bericht der <placeName ref="l726">Oberdeutschen</placeName> über die Verhandlungen in <placeName ref="l558">Wittenberg</placeName> (<bibl source="b135">BucerDS</bibl> VI/1 135-174) zu beziehen; s. ebd., S. 148, 3-11.</note> <lb xml:id="p1z11"/>ex ratione iam dicta.</s>
					<s n="12" xml:lang="la">Minus movet discrimen inter infidelem et indignum<note xml:id="fn7" type="footnote" n="7">Zur Unterscheidung von manducatio indignorum und infidelium s. ebd., S. 149,1-150,3; 151,19-153,4; 153,12-154, 9; 166,16-170,4.</note>; <lb xml:id="p1z12"/>movet tamen, quod inauditum mihi.</s>
					<s n="13" xml:lang="la">Nec differre novi hactenus "man<lb xml:id="p1z13"/>ducare" corpus domini et "sumere"<note xml:id="fn8" type="footnote" n="8">Siehe ebd., bes. S. 167,28-168,19; 169, 10f.</note>.</s>
					<s n="14" xml:lang="la">In declaratione quid sibi velit omnes profiteri <lb xml:id="p1z14"/>se sentire iuxta confessionem et apologiam principum<note xml:id="fn9" type="footnote" n="9">Siehe ebd., S. 126, 1-3 (gemeint ist das <placeName ref="l18">Augsburgische</placeName> Bekenntnis von 1530 und dessen Apologie).</note>, paenitus ignoro.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z15"/>Quaeso igitur, mentem vestram hic aperire mihi haud dedignemini, si inde forsitan <lb xml:id="p1z16"/>vel melius sentire discam vel socios vos pariam confusionis.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z17"/>Pręter haec<note xml:id="fna" type="footnote" n="a">haec <hi>am Rande nachgetragen.</hi></note> scripsit <persName ref="p5565">Capito</persName> in hęc verba<note xml:id="fn10" type="footnote" n="10">Wörtlich findet sich diese Aussage in keinem der erhaltenen Briefe, vgl. aber <persName ref="p5565">Capitos</persName> Brief an <persName ref="p8129">Jakob Meyer</persName> vom 22. Juni (<persName ref="p5565">Capito</persName>, Con. 212, <ref target="file10654">Nr. 616</ref>).</note>: "Confessio vestra <placeName ref="l28">Basileae</placeName> communiter instituta<note xml:id="fn11" type="footnote" n="11">Das Erste <placeName ref="l862">Helvetische</placeName> Bekenntnis; s. oben <ref target="file10775">Nr. 737</ref>, Anm. 1.</note> <lb xml:id="p1z18"/>quadrat <placeName ref="l558">Wittenbergensibus</placeName> articulis", id quod aeque non video.</s>
					<s n="17" xml:lang="la">Aperite vos <lb xml:id="p1z19"/>oculos mihi, ne cęcutiam in ęternum.</s>
					<s n="18" xml:lang="la">Promittit aliam item declarationem<note xml:id="fn12" type="footnote" n="12">Zu den nach <placeName ref="l28">Basel</placeName> gesandten Erläuterungen der <placeName ref="l558">Wittenberger</placeName> Artikel s. unten <ref target="file10906">Nr. 866</ref>,4-12.</note>, quę <lb xml:id="p1z20"/>nisi sit alia, quemadmodum vocat<note xml:id="fnb" type="footnote" n="b">vocat <hi>korrigiert aus</hi> vocant.</note>, frustranea erit.</s>
					<s n="19" xml:lang="la">Reliqua <persName ref="p8127">Pellicanus</persName>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="farewell"><lb xml:id="p1z21"/>Valete per Christum cum vestris.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l28">Basileae</placeName>, kalendis iuliis anno 36.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z22"/><persName ref="p8418">Os. Myconius</persName> <lb xml:id="p1z23"/>vester.</s>
				</p>
				<p>
					<s n="23" xml:lang="la" ana="salute"><lb xml:id="p1z24"/><persName ref="p3242">Utingerum</persName> salutabitis <lb xml:id="p1z25"/>perquam officiose.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinrycho Bullingero</persName> <lb xml:id="p2z2"/>et d. <persName ref="p8171">Theodoro <lb xml:id="p2z3"/>Bibliandro</persName>, in domino <lb xml:id="p2z4"/>observandissimis suis.</s>
				</p>
			</div>
