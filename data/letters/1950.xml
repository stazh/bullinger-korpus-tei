	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><persName>Paulus</persName> natione Italus<note xml:id="fn1" type="footnote" n="1">Gadius/Gaddi.</note>, homo spectatę nobis probitatis, quum <lb xml:id="p1z2"/>nuper ad comitem nostrum <persName ref="p8066">Celsum</persName> scriberet, inter alia posuit, <lb xml:id="p1z3"/>se literas mihi attulisse ab illustrissima <placeName ref="l150">Ferrarię</placeName> ducissa, <lb xml:id="p1z4"/>quas apud te reliquerat.</s>
					<s n="3" xml:lang="la">Quia vero nuper venerunt a d. <persName ref="p8011">Galthero</persName> <lb xml:id="p1z5"/>literę, ubi nulla eius rei fit mentio: et paulo ante <persName ref="p1918">Ioannes <lb xml:id="p1z6"/>Linerus</persName> mercator <placeName ref="l473">Sangallensis</placeName> hac transiens dixerat, te per quendam <lb xml:id="p1z7"/>Hebręum scripsisse: suspicatus sum, te ab illo deceptum fuisse.</s>
					<s n="4" xml:lang="la">Neque <lb xml:id="p1z8"/>enim ille a nobis visus est, neque dubito, quin eo se contulerit unde <lb xml:id="p1z9"/>maior spes lucri affulgebat.</s>
					<s n="5" xml:lang="la">Quod si forte literę illę perierint, <lb xml:id="p1z10"/>admonitam esse ducissam cupio.</s>
					<s n="6" xml:lang="la">Proinde quia hic vir nobilis, <lb xml:id="p1z11"/>quo internuncio apud <persName ref="p8112">regem Gallię</persName> iam annos complures usa <lb xml:id="p1z12"/>est, istac facturus erat iter, rogavi ut abs te sciscitaretur, <lb xml:id="p1z13"/>quidnam illo fasciculo quem apud te <persName>Paulus</persName> deposuit, factum <lb xml:id="p1z14"/>esset, ut ad dominam suam referat.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">De morte <persName ref="p3207">regis Anglię</persName> <lb xml:id="p1z15"/>frequentiores sunt nuncii, quam vellem.</s>
					<s n="8" xml:lang="la">Itaque iam lugemus non secus <lb xml:id="p1z16"/>ac mortuum: vel potius lugemus ecclesię vicem, quę in uno capite <lb xml:id="p1z17"/>inęstimabilem iacturam fecit.</s>
					<s n="9" xml:lang="la">Nunc quorsum res turbatę inclinent <lb xml:id="p1z18"/>anxie exspectatione suspensi sumus.</s>
					<s n="10" xml:lang="la"><placeName ref="l822">Germaniam</placeName> interea a se <lb xml:id="p1z19"/>mutuis vulneribus et intestinis confici, plus quam dolendum est.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z20"/>Sed nihil mirum, si morbis desperatis tam violenta remedia <lb xml:id="p1z21"/>dominus adhibeat.</s>
					<s n="12" xml:lang="la">Et quid restat, nisi ut assiduis precibus <lb xml:id="p1z22"/>flagitemus, ne ecclesiam suam obrui sinat, quin potius inter <lb xml:id="p1z23"/>ista naufragia eam conservet?</s>
					<s n="13" xml:lang="la" ana="farewell">Vale, ornatissime vir et frater <lb xml:id="p1z24"/>in Christo colendissime.</s>
					<s n="14" xml:lang="la" ana="salute">Saluta officiose symmystas tuos, uxorem, <lb xml:id="p1z25"/>generos, et filias.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Dominus vos omnes pręsidio suo tueatur et spiritu <lb xml:id="p1z26"/>gubernet.</s>
					<s n="16" xml:lang="la" ana="salute">Collegę mei te plurimum salutant.</s>
					<s n="17" xml:lang="la"><placeName ref="l167">Genevę</placeName> <lb xml:id="p1z27"/>4. augusti 1553.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z28"/><persName ref="p540">Ioannes Calvinus</persName> tuus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro <lb xml:id="p2z2"/>d. <persName ref="p495">Henricho Bullingero</persName> <lb xml:id="p2z3"/>ecclesię <placeName ref="l587">Tigurinę</placeName> pastori <lb xml:id="p2z4"/>fratri et symmystę plurimum <lb xml:id="p2z5"/>observando.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>