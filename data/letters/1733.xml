	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Pecuniam pro libris tibi coemptis, vir ornatissime, nuper a vi<lb xml:id="p1z2"/>ro optimo atque doctissimo <persName ref="p8009">Fabricio</persName> accepi mittamque <lb xml:id="p1z3"/>reliquos, quamprimum ex <placeName ref="l491">Argentina</placeName> accepero; nondum enim <lb xml:id="p1z4"/>accepi propter nundinarum <placeName ref="l157">Franfordiensium</placeName> incommoda.</s>
					<s n="2" xml:lang="la">Quant<lb xml:id="p1z5"/>um autem ad d. <persName ref="p6355">Hieronymi</persName> fragmentum tuis libris nuper ad<lb xml:id="p1z6"/>ditum spectat, cui tuum etiam nomen inscripseram, scias <lb xml:id="p1z7"/>eius esse, a quo tuas Decades, donum amplissimum, accepi, <lb xml:id="p1z8"/>qui dum ob tempestatis eo tempore improbitatem commo<lb xml:id="p1z9"/>de ferre non posset, oravit, ut libris tibi mittendis <lb xml:id="p1z10"/>adderem; a te enim suum fasciculum domi petiturum <lb xml:id="p1z11"/>ferebat tibi procul dubio melius quam mihi notus.</s>
					<s n="3" xml:lang="la">Nov<lb xml:id="p1z12"/>arum rerum nihil certi habemus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><placeName ref="l1922">Theodonis villam</placeName> <lb xml:id="p1z13"/>nova obsidione a <placeName ref="l832">Gallo</placeName> cinctam ferunt, cum ob frumenta <lb xml:id="p1z14"/>tocies intercepta fame potius quam ferro capi posse <lb xml:id="p1z15"/>verisimile sit.</s>
					<s n="5" xml:lang="la"><persName>Marchio Brandeburgensis</persName> haud procul <lb xml:id="p1z16"/>a <placeName ref="l1028">Treviri</placeName> eiectis magnis terrae aggeribus loco oportuno <lb xml:id="p1z17"/>atque natura munito Caesaris copias expectare <lb xml:id="p1z18"/>dicitur, ut Marte aperto manus conserat.</s>
					<s n="6" xml:lang="la">Imperator <lb xml:id="p1z19"/>ideo tantopere <placeName ref="l491">Argentinam</placeName> properare fertur, ne <placeName ref="l2459">Rhen<lb xml:id="p1z20"/>i</placeName> pons a <placeName ref="l832">Gallo</placeName>, quem maximis copiis adventare <lb xml:id="p1z21"/>falsa fama spargebatur, interciperetur.</s>
					<s n="7" xml:lang="la">Nunc <lb xml:id="p1z22"/>heret <placeName ref="l961">Landoiae</placeName> adhuc atque paucis notum est, quo suum <lb xml:id="p1z23"/>ducere exercitum velit.</s>
					<s n="8" xml:lang="la">Cetera dies declarabit.</s>
					<s n="9" xml:lang="la" ana="farewell"><lb xml:id="p1z24"/>Vale in domino.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l28">Basileae</placeName> 5. nonas octobris <lb xml:id="p1z25"/>anno <lb xml:id="p1z26"/>1552.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z27"/>Tuus ex animo <lb xml:id="p1z28"/><persName ref="p8406">Conradus Lycosthenes</persName>.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z29"/>Scripsi ante octiduum, nimirum per compositorem quendam, <lb xml:id="p1z30"/>qui apud <persName ref="p1227">Froschoverum</persName> divertit, quid ex <placeName ref="l850">Austria</placeName> habeamus <lb xml:id="p1z31"/>novi; ea num acceperis, proximis intelligere literis <lb xml:id="p1z32"/>percupio.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henricho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <lb xml:id="p2z3"/><placeName ref="l587">Tigurinae</placeName> episcopo omnium <lb xml:id="p2z4"/>vigilantissimo.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l587">Tigurum</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
