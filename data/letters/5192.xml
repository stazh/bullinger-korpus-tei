	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nudiustertius per <placeName ref="l882">Ungarum</placeName> illum scripsi.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Interea heri sub <lb xml:id="p1z2"/>noctem tuę 20. februarii scriptae mihi redditae sunt una <lb xml:id="p1z3"/>cum libro <persName ref="p20367">Heshusii</persName> et literis ad <persName ref="p540">Calvinum</persName> pertinentibus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Librum istum hac nocte <persName ref="p8417">Musculus</persName> percurrit.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Iam adest commode <lb xml:id="p1z5"/>nuncius <placeName ref="l167">Genevensis</placeName>, cui illa omnia <placeName ref="l167">Genevam</placeName> perferenda dabo.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/>Trista sunt, quę de <placeName ref="l1209">Navarro</placeName> audimus; dominus illi det integritatem <lb xml:id="p1z7"/>maiorem.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Quae de conventu apud <placeName ref="l2074">Tabernas</placeName> <lb xml:id="p1z8"/><placeName ref="l632">Alsaticas</placeName>, iam prius nos quoque habuimus.</s>
					<s n="8" xml:lang="la">De <placeName>Castalione</placeName> iubeo <lb xml:id="p1z9"/>te bono esse animo; non defuerunt, qui illum nobis obtrudere <lb xml:id="p1z10"/>conarentur, inprimis vero<foreign xml:lang="el">ὁ ἀρχιγραμματεύς</foreign><note xml:id="fn1" type="footnote" n="1">Zurkinden.</note>, qui ne<lb xml:id="p1z11"/>scio quam singularem cum eo consuetudinem habet; sed interpo<lb xml:id="p1z12"/>suimus nos ita, ut ille loco cesserit, nos alium ordinaverimus.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/><persName ref="p3494">Diesbachius</persName> rursus domi non est; bene ergo fecisti, quod novitates <lb xml:id="p1z14"/>illas ad me miseris; communicavi eas heri in coena <lb xml:id="p1z15"/>novo quaestori, qui prius non audita hodie senatui referet.</s>
					<s n="10" xml:lang="la" ana="salute"><lb xml:id="p1z16"/>Is te salutat una cum quaestore <persName ref="p8012">Hallero</persName>, quibuscum heri <lb xml:id="p1z17"/>coenando honorificam tui fecimus mentionem.</s>
					<s n="11" xml:lang="la"><persName>Abrahami</persName> <lb xml:id="p1z18"/>libellus hic imprimi non potest, quia non habemus magis <lb xml:id="p1z19"/>instructum typographum, quam qui vix manu paginam imprimere <lb xml:id="p1z20"/>possit; rectius ergo apud vos excusetur.</s>
					<s n="12" xml:lang="la">Authorem vero patrem <lb xml:id="p1z21"/>esse falso imaginaris; scio ego filium composuisse sine <lb xml:id="p1z22"/>opera patris et paratum patri legendum dedisse, qui pauca in <lb xml:id="p1z23"/>eo mutavit.</s>
					<s n="13" xml:lang="la">Quid vero tibi videtur de illius ingenio, <lb xml:id="p1z24"/>nunquid, si exercitium accedat, insignis fiat homo?</s>
					<s n="14" xml:lang="la">Puto <lb xml:id="p1z25"/>de isto d. <persName ref="p8417">Musculum</persName> ipsummet scripturum.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">De filio tuo percontabor <lb xml:id="p1z26"/>diligenter inter illius artis peritos et proxime ad te sc(r)ibam.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z27"/>Nunc plura non possum.</s>
					<s n="17" xml:lang="la" ana="farewell">Bene ergo vale.</s>
					<s n="18" xml:lang="la" ana="salute">Salutem tibi dicunt <lb xml:id="p1z28"/>nostri omnes.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l41">Bernae</placeName> 27. februarii 1562.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">C<pb/><lb xml:id="p2z1"/>larissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ec<lb xml:id="p2z3"/>clesiae pastori fidelissimo, domino <lb xml:id="p2z4"/>suo honorando et <lb xml:id="p2z5"/>compatri charissimo.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>