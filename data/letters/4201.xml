	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Curabo modis omnibus, ut me vobis gratum <lb xml:id="p1z2"/>exhibeam omnibus, quibus nunc gratias ago, quas possum <lb xml:id="p1z3"/>maximas.</s>
					<s n="3" xml:lang="la">Ex <placeName ref="l830">Anglia</placeName> literas scriptas mense <lb xml:id="p1z4"/>decembri.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Religionis negotium optime habet.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Deus <lb xml:id="p1z5"/>confirmet verbum suum in aeternum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Nulla mentio con<lb xml:id="p1z6"/>sensionis <placeName ref="l830">Anglorum</placeName> et <placeName ref="l2524">Scotorum</placeName>, nec puto verum <lb xml:id="p1z7"/>esse, quod contra <placeName ref="l832">Gallos</placeName> conspirarint.</s>
					<s n="7" xml:lang="la">Hoc de <placeName ref="l2524">Scotis</placeName> tame<lb xml:id="p1z8"/>n scribitur: intrepide eos in religione progredi, <lb xml:id="p1z9"/><placeName ref="l832">Gallicam</placeName> classem, quae subsidium voluit ferre <lb xml:id="p1z10"/>reginae, tempestate disiectam esse et submersas <lb xml:id="p1z11"/>aliquot naves.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><persName ref="p18465">Reginae Angliae</persName> nuptiae adhuc <lb xml:id="p1z12"/>nullae.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Legatus Caesaris vel imperatoris, qui nomine <persName>Caroli</persName> <lb xml:id="p1z13"/>ambivit, discessit.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Haeret adhuc secundogenitus <placeName>Sueci<lb xml:id="p1z14"/>ae</placeName> regis filius in <placeName ref="l830">Anglia</placeName>, qui fratri suo iuniori <lb xml:id="p1z15"/><persName ref="p18716">Erycho</persName> ambivit; sed existimatur nihil effecturus.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z16"/>Brevi plura dabo.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Haec communia habebis cum amicis, <lb xml:id="p1z17"/>imprimis cum amplissimo viro d. legato, cui me com<lb xml:id="p1z18"/>mendabis.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Valebis aeternum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Literas, quas te <lb xml:id="p1z19"/>nondum accepisse scribis, tradidi <persName ref="p20896">Sülero</persName><note xml:id="fn1" type="footnote" n="1">Zum Schuldenhandel nach <persName ref="p20896">Sülers</persName> Tod finden sich Materialien im Bestand A 369 (s. Register bei den Inventaren des StA).</note>, qui dicit <lb xml:id="p1z20"/>se inserviisse episcopo vestro.</s>
					<s n="15" xml:lang="la">Inclusi meis, ut ipse iuss<lb xml:id="p1z21"/>eras, d. legati ad te literas.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Inclusae sunt item <lb xml:id="p1z22"/>ad <persName ref="p475">Christophorum</persName> meum.</s>
					<s n="17" xml:lang="de">Der sagt, das imm j. <persName ref="p7980">Caspar <lb xml:id="p1z23"/>von Salis</persName> wol zuͦgesagt, das roß zuͦ verkouffen.</s>
					<s n="18" xml:lang="de">Den <lb xml:id="p1z24"/>bitten ich ouch früntlich alls minen günstigen junckherren, <lb xml:id="p1z25"/>das er hälffe, das es verkoufft werde.</s>
					<s n="19" xml:lang="de">Dann <lb xml:id="p1z26"/>wenn ir mirs schon hinab schickend, weiß ichs <lb xml:id="p1z27"/>vil minder zuͦ verkouffen.</s>
				</p>
				<p>
					<s n="20" xml:lang="de">Ir möchtend vilicht meinen, <lb xml:id="p1z28"/>wenn irs verkouffend, möchte ich gedäncken, ich <lb xml:id="p1z29"/>wöllte me hie darus gelöst haben etc.</s>
					<s n="21" xml:lang="de">Nein, ich hab <lb xml:id="p1z30"/>vor geschriben und sagen es wider: verkouffen <lb xml:id="p1z31"/>es, wie ir mögend und alls ob es üwer were.</s>
				</p>
				<p>
					<s n="22" xml:lang="de"><lb xml:id="p1z32"/>Was ir dann lösend, des wil ich zuͦfriden sin.</s>
					<s n="23" xml:lang="de"><lb xml:id="p1z33"/>Möchte es aber nitt anders sin, müssend ir <lb xml:id="p1z34"/>mirs wol schicken; wirt mir aber nitt werd <lb xml:id="p1z35"/>sin, deßhalb das ichs minder zuͦ verkouffen weiß und <lb xml:id="p1z36"/>es ouch ander lüthen befälhen muß; dann ich mich <lb xml:id="p1z37"/>gar nüt der gurramenten vermag.</s>
					<s n="24" xml:lang="de">Dorum t<lb xml:id="p1z38"/>huͦn wie guͦ<lb xml:id="p1z39"/>t fründ.</s>
				</p>
				<p>
					<s n="25" xml:lang="la" ana="farewell">Vale aeternum c<lb xml:id="p1z40"/>um omnibus nostris.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">Festinantissime 26. ianuarii 60.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p1z41"/><persName ref="p495">Bullinger</persName>.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo d. <lb xml:id="p2z2"/><persName ref="p8009">Ioanni Fabritio</persName>, <lb xml:id="p2z3"/><placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z4"/>ministro fidelissimo, <lb xml:id="p2z5"/>compatri et fratri <lb xml:id="p2z6"/>charissimo suo.</s>
					<s n="29" xml:lang="la"><lb xml:id="p2z7"/>Chur.</s>
				</p>
			</div>
