			<zone xml:id="p2z3-0" points="962,1628 1507,1587 1793,1618 1810,1529 1528,1512 1414,1552 1285,1523 964,1582">969,1611 1011,1611 1053,1608 1095,1605 1137,1599 1179,1599 1221,1597 1263,1594 1305,1593 1347,1591 1390,1588 1432,1585 1474,1584 1516,1583 1558,1581 1600,1580 1642,1578 1684,1578 1726,1578 1768,1578 1811,1575</zone>
