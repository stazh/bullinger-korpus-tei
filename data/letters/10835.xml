					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>pastori ecclesię <placeName ref="l587">Tigurinę</placeName>, <lb xml:id="p2z4"/>sibi in domino observando.</s>
