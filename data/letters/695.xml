	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Cum non ignorem optare te admodum cognoscere, quo in statu res sint D. <lb xml:id="p1z2"/><persName ref="p1560">Hopperi</persName> totiusque familię et viderem non tantum ocii dari <persName ref="p1560">Hoppero</persName>, ut scriberet, nec <lb xml:id="p1z3"/>tabellarius posset ob urgentes nautas diutius morari, mei officii esse arbitratus <lb xml:id="p1z4"/>sum, si paucis vitę nostrę conditionem tibi exponerem.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Imprimis <persName ref="p1560">Hopperus</persName> summos <lb xml:id="p1z5"/>ac perpetuos labores sumit in docendo populo, quem habet frequentissimum <lb xml:id="p1z6"/>et <lb xml:id="p1z7"/>attentissimum.</s>
					<s n="4" xml:lang="la">Singulis diebus ad minimum legit semel, sępius bis aut ter<lb xml:id="p1z8"/>.</s>
					<s n="5" xml:lang="la">Episcopus <placeName ref="l1255">Cantuariensis</placeName> redditus est illi paulo ęquior.</s>
					<s n="6" xml:lang="la">Episcopus <placeName ref="l296">Londinensis</placeName> concionatus est <lb xml:id="p1z9"/>prim<lb xml:id="p1z10"/>a septembris ad templum <persName>Pauli</persName> in frequentissima populi concione et pro viribus inculcavit praesentiam <lb xml:id="p1z11"/>corporalem in coena, cui fortiter in lectione eiusdem diei se opposuit <persName ref="p1560">Hopperu<lb xml:id="p1z12"/>s</persName>.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Idem <lb xml:id="p1z14"/>episcopus iussus erat in concione proponere populo regi nostro non minus <lb xml:id="p1z15"/>esse parendum puero quam seni eiusdemque autoritatis esse eius statuta.</s>
					<s n="8" xml:lang="la">Id episcopus <lb xml:id="p1z16"/>intermisit; citatus est igitur ad tribunal seque tam impudenter gessit et obstinate <lb xml:id="p1z17"/>(nam praesens vidi omnia), ut scurram potius diceres quam episcopum; est coniectus <lb xml:id="p1z18"/>in carceres ob hanc obstinatam rebellionem, donec caussę imponatur finis, qui qualis<lb xml:id="p1z19"/>nam futurus sit, ignoramus, praesertim cum plurimos fautores habeat.</s>
					<s n="9" xml:lang="la">Tumultus <lb xml:id="p1z20"/>rusticorum <persName>Anglicorum</persName> divina gratia sedati sunt mulctatis aliquot proditoribus; <lb xml:id="p1z21"/>servantur adhuc multi captivi.</s>
					<s n="10" xml:lang="la">De <placeName ref="l2524">Scotis</placeName> nihil auditur certi.</s>
					<s n="11" xml:lang="la">Uxor <lb xml:id="p1z22"/><persName ref="p1560">Hopperi</persName>, D. <persName>Anna</persName>, valetudine non admodum est integra.</s>
					<s n="12" xml:lang="la">Reliqui valemus.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z23"/>D. <persName ref="p4744">Paulus Fagius</persName> periclitatur de vita; <persName ref="p467">Bucerus</persName> nondum e morbo convaluit, quo uno <lb xml:id="p1z24"/>mense aut amplius laboravit.</s>
					<s n="14" xml:lang="la">Uxores illorum advenerunt.</s>
				</p>
				<p>
					<s n="15" xml:lang="la" ana="farewell">Bene vale, pastor <lb xml:id="p1z25"/>vigilantissime.</s>
					<s n="16" xml:lang="la">Faxit deus, ut populum habeas perpetuo obsequentissimum!</s>
					<s n="17" xml:lang="la">Dolemus <lb xml:id="p1z26"/>valde ac miramur evangelicos in sanguinarium illud <persName>Gallorum</persName> foedus pertrahi <lb xml:id="p1z27"/>potuisse.</s>
					<s n="18" xml:lang="la">Deus vos confirmet, amen.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z28"/>Celerrime script[ae] <placeName ref="l296">Londini</placeName> <lb xml:id="p1z30"/>1549 septembri 30. Commendabis nos praeceptori nostro D. <persName ref="p8171">Bibliandro</persName>, <lb xml:id="p1z31"/>D. <persName ref="p8127">Pellicano</persName> et D. <persName ref="p1283">Gesnero</persName>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z32"/>Tuus famulus obsequentissimus <lb xml:id="p1z33"/><persName ref="p8415">Martinus Micronius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro D. <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>antisti <placeName ref="l587">Tigurinorum</placeName> vigilantissimo.</s>
					<s n="22" xml:lang="la"><lb xml:id="p2z3"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
