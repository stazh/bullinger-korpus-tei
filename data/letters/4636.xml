	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Serius, quam constitueram, huc veni, quod, cum vellem <lb xml:id="p1z2"/><placeName ref="l760">Soluduro</placeName> discedere, correptus sum coliqua, quę me mirum in <lb xml:id="p1z3"/>modum per triduum torsit; sed tandem convalui.</s>
					<s n="3" xml:lang="la">Hic non <lb xml:id="p1z4"/>mala initia pacificationis inveni et <placeName ref="l2448">Quinquepagicos</placeName> eo <lb xml:id="p1z5"/>tandem deductos, ut iusticie viam admittant.</s>
					<s n="4" xml:lang="la">Illorum oratores <lb xml:id="p1z6"/>privatim et familiariter alloquar eisque libere aperiam, quid <lb xml:id="p1z7"/>de toto negocio hoc et pertinacia sentiam.</s>
					<s n="5" xml:lang="la">Permittit <lb xml:id="p1z8"/>aliquando dominus, ut, dum aliquę provincie post longa bellorum <lb xml:id="p1z9"/>incommoda parta pace fruuntur, alie atque alię, que diutissime <lb xml:id="p1z10"/>conquieverunt, externis aut civilibus bellis deflagrent.</s>
					<s n="6" xml:lang="la">Sic <lb xml:id="p1z11"/>sunt vicissitudines; sed servantur, qui reverentur dominum, et <lb xml:id="p1z12"/>pacis commodis in eo fruuntur nec non necessaria movent.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Hac in pacificatione nihil me prętermissurum persuasum habe.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Mittit ad te uxor condimenta aliqua et caseos ad me missos <lb xml:id="p1z15"/>e <placeName ref="l2772">Delphinatu</placeName> non malos; ea a benevolo animo accipies nosque <lb xml:id="p1z16"/>amabis.</s>
					<s n="9" xml:lang="la">Tres tuos fasciculos literarum recepi cum foliis, qui mihi <lb xml:id="p1z17"/>sunt gratissima.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Litere tuto perferentur ei, qui in familia est regis <lb xml:id="p1z18"/><placeName ref="l1209">Navarre</placeName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Eius regis augetur in dies auctoritas, unde spem <lb xml:id="p1z19"/>bonam multi concipiunt.</s>
					<s n="12" xml:lang="la">Expecto, quid in comitiis conclusum <lb xml:id="p1z20"/>sit, tantum vereor, ne non constet pax inter principes <placeName ref="l832">Gallię</placeName>.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z21"/>Opus esset amnistia firmiore, quam que post <persName>Cesarem</persName> occisum fuit.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z22"/>Varii sunt rumores de <persName>Philippi</persName> morte, sed adhuc sine authore.</s>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z23"/>Salutabis amicos omnes.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Te servet dominus incolumem.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z24"/><placeName ref="l21">Badene</placeName> 21. ianuarii.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z25"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<note>[von anderer Hand:]</note>
					<s n="20" xml:lang="de"><pb/><lb xml:id="p2z1"/>An herren <persName ref="p495">Heinrichen <lb xml:id="p2z2"/>Bullinger</persName>, verkhünder <lb xml:id="p2z3"/>des wortt gottes <placeName ref="l587">Zürich</placeName>, <lb xml:id="p2z4"/>zuͦ sichernn hannden<lb xml:id="p2z5"/>.</s>
					<s n="21" xml:lang="de"><lb xml:id="p2z6"/>Mitt sampt einer ballen mitt <lb xml:id="p2z7"/>linem thuͦch überzogen<lb xml:id="p2z8"/>.</s>
				</p>
				<p>
					<s n="22" xml:lang="de"><lb xml:id="p2z9"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>