	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Obsecro, mi <persName ref="p495">Bullingere</persName>, ne gravatim <lb xml:id="p1z2"/>feras, quod meis literis studia tua subinde <lb xml:id="p1z3"/>interturb.</s>
					<s n="3" xml:lang="la">Ea nunc est fortunę meae conditio, <lb xml:id="p1z4"/>ut amicorum mihi sit utendum officiis; quodsi <lb xml:id="p1z5"/>aliquando dabitur occasio vicissim tibi ac reli<lb xml:id="p1z6"/>quis amicis serviendi, ero paratissimus.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Aegre sustineo valetudinem uxoris, quae exilium <lb xml:id="p1z8"/>meum admodum molestum reddit.</s>
					<s n="5" xml:lang="la">Versor ac <lb xml:id="p1z9"/>reversor inter liberos et decumbentem uxorem <lb xml:id="p1z10"/>itaque adflictor et fatigor non modo corporea <lb xml:id="p1z11"/>molestia, sed et animi perturbationibus, ut <lb xml:id="p1z12"/>subinde erumpat illud: Usque quo, domine, usque quo.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z13"/>Rerum domesticarum nec usum habeo nec <lb xml:id="p1z14"/>scientiam, quarum curam hactenus in humeros <lb xml:id="p1z15"/>uxoris abiicere consuevi; quare fit, ut <lb xml:id="p1z16"/>nec mihi nec uxori nec liberis curandis.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z17"/>sufficiam.</s>
					<s n="8" xml:lang="la">Interea iacent omnia mea studia, <lb xml:id="p1z18"/>quorum recordatione tactus teque tuique similes <lb xml:id="p1z19"/>adhuc in pace constitutos ter beatos esse <lb xml:id="p1z20"/>praedico; sed sic est voluntas domini; sit no<lb xml:id="p1z21"/>men illius benedictum in saecula.</s>
					<s n="9" xml:lang="la">Erit aliquando, ut <lb xml:id="p1z22"/>harum tribulationum emolumentum ac fructum <lb xml:id="p1z23"/>sentiamus, quot-quot propter evangelii dei <lb xml:id="p1z24"/>fidem ac confessionem exilii molestiam perferimus.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/>Commendo me interim fidei tuę <lb xml:id="p1z26"/>ac reliquorum fratrum, quos dominus, oro, <lb xml:id="p1z27"/>in pace ac tranquillo pietatis exercitio <lb xml:id="p1z28"/>conservare dignetur.</s>
					<s n="11" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Literas hasce, quaeso, <lb xml:id="p1z29"/>quas <persName ref="p5213">Hervagio</persName> inscriptas reperis, <placeName ref="l28">Basileam</placeName> <lb xml:id="p1z30"/>per occasionem mittas; non onerarem te <lb xml:id="p1z31"/>hoc genere officii, si alia ratione uti daretur.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z32"/>De rebus vestris et <placeName ref="l257">Constantiensium</placeName> si quid <lb xml:id="p1z33"/>habes, significa.</s>
					<s n="14" xml:lang="la"><persName ref="p467">Bucerus</persName> de <placeName ref="l491">Argentinensibus</placeName> <lb xml:id="p1z34"/>nihil adhuc certi, de <placeName ref="l749">Saxonibus</placeName> ac civitatibus <lb xml:id="p1z35"/>maritimis<note xml:id="fn1" type="footnote" n="1">die Hansestädte ("Seestädte").</note> constanter scribit, quod fermentum <lb xml:id="p1z36"/>illud <foreign xml:lang="el">μεταξυκον</foreign> recipere nolint.</s>
					<s n="15" xml:lang="la">Vox domini est: <lb xml:id="p1z37"/>cavete a fermento phariseorum; sit illa piis omnibus <lb xml:id="p1z38"/>tanquam coelestis quaedam admonitio observabilis.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell"><lb xml:id="p1z39"/>Optime vale, virorum charissime.</s>
					<s n="17" xml:lang="la">De rebus meis statuendum <lb xml:id="p1z40"/>erit, ubi uxor convaluerit; interea tamen, si qua dabitur <pb/><lb xml:id="p2z1"/>commoda occasio, ut alicui ecclesię servire <lb xml:id="p2z2"/>possim, significare poteris.</s>
					<s n="18" xml:lang="la" ana="salute">Salutem uxori ac liberis meo et meorum nomine, denique <lb xml:id="p2z3"/>fratribus omnibus et amicis.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><placeName ref="l473">Sangalli</placeName>, 23. Augusti 1548.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><persName ref="p8417">W[olfgangus] Musculus</persName>, tuus in omnibus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="21" xml:lang="la"><lb xml:id="p2z4"/>Praestan<lb xml:id="p2z5"/>tissimo theologo D. <persName ref="p495">Heinrycho Bullinger</persName>o, <placeName ref="l587">Tigurinę</placeName> ecclesiae antisti<lb xml:id="p2z6"/>ti vigilantissimo, fratri in C<lb xml:id="p2z7"/>hristo charissimo.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
