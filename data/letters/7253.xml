					<note type="regest">Er empfiehlt einen Religionsflüchtling, und verweist für alles Weitere auf diesen.</note>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/><persName ref="p20474">Oedoardus</persName> ex Thienensibus comitibus, <lb xml:id="p1z3"/><placeName ref="l1637">Vincentiae</placeName> civitatis primarius.</s>
					<s n="2" xml:lang="la">Hoc unu<lb xml:id="p1z4"/>m tibi dicam me <lb xml:id="p1z5"/>a deo <lb xml:id="p1z6"/>meo in <lb xml:id="p1z7"/>tam l<lb xml:id="p1z8"/>onga g<lb xml:id="p1z9"/>ravissimaqu<lb xml:id="p1z10"/>e cruce <lb xml:id="p1z11"/>non des<lb xml:id="p1z12"/>eri, sed alacrite<lb xml:id="p1z13"/>r patienter<lb xml:id="p1z14"/>que sus<lb xml:id="p1z15"/>tinere mart<lb xml:id="p1z16"/>yrium <lb xml:id="p1z17"/>hoc, co<lb xml:id="p1z18"/>ntem<lb xml:id="p1z19"/>plantem scilicet <lb xml:id="p1z20"/>non quae videntur, sed quae non videntur<lb xml:id="p1z21"/>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><placeName ref="l93">Claven[n]ae</placeName>, die sexto octobri<lb xml:id="p1z22"/>s <pb/><lb xml:id="p2z3"/>156<lb xml:id="p2z4"/>7<pb/><lb xml:id="p4z4"/>.</s>
				</p>
