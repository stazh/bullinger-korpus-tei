	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Litteras ad te mitto scriptas a d. <persName ref="p8183">S. Laurentio [Bochetel]</persName>, qui nunc <lb xml:id="p1z2"/>episcopus est.</s>
					<s n="3" xml:lang="la">D. conestabilis data fide venit ad regem, et nunc <lb xml:id="p1z3"/>deputati ab utrisque principibus tractant de pace, de qua <lb xml:id="p1z4"/>nihil audeo affirmare multas ob causas.</s>
					<s n="4" xml:lang="la">Exercitus <persName ref="p18575">Philippi</persName> pedem re<lb xml:id="p1z5"/>tulit itinere trium miliarium et, qua die recessit, temporis iniuria <lb xml:id="p1z6"/>duo millia hominum desideravit et mille equos.</s>
					<s n="5" xml:lang="la">Spero intra <lb xml:id="p1z7"/>triduum me te visurum, et coram pluribus agemus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Interim bene <lb xml:id="p1z8"/>vale.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute">Salutabis amicos omnes.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l21">Badene</placeName> 20. octobris summo mane.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z9"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo theologo d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, amico <lb xml:id="p2z3"/>singulari.</s>
				</p>
				<p>
					<note type="author">[von anderer Hand.]</note>
				</p>
			</div>
		</body>
	</text>
