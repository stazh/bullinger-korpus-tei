	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Recepi, quae miseram, doctissime vir, et antea te isthaec omnia <lb xml:id="p1z2"/>aliorum itidem cura et diligentia accepisse valde gaudeo.</s>
					<s n="3" xml:lang="la">Talia <lb xml:id="p1z3"/>enim sunt, quae te et per te tuos nosse operę precium sit.</s>
					<s n="4" xml:lang="la">Atque hac <lb xml:id="p1z4"/>quidem vel una caussa fit, ut longe mihi gratius sit: postremum <lb xml:id="p1z5"/>me monitorem esse intelligi, quam si primum me fuisse intelligerem<lb xml:id="p1z6"/>; parem enim gratiam habes et illi, qui voluit, nisi alius prae<lb xml:id="p1z7"/>venisset, et illi, qui efficit, quominus aliorum sedulitate fuerit opus.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Et solidum interim manet <placeName ref="l822">Germanicum</placeName> adagium: <foreign xml:lang="de">Guͦter gwarsam<lb xml:id="p1z9"/>me<note xml:id="fn9" type="footnote" n="9">Vorsicht, Vorsorge; s. <bibl source="b590">SI</bibl> XVI 833f.</note> khamm nien zuͦ vil.</foreign></s>
					<s n="6" xml:lang="la">Proinde nihilo lentior ero in admonendo <lb xml:id="p1z10"/>(quoniam ita iubes) quam fuerim antea.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="7" xml:lang="la">Domino <persName ref="p8055">Ambrosio Blaurero</persName> <lb xml:id="p1z11"/>fasciculum tuum summa fide reddendum curavi.</s>
					<s n="8" xml:lang="la">Plane ignoravi, <lb xml:id="p1z12"/>de <placeName ref="l257">Constantia</placeName> deque <placeName ref="l18">Augusta</placeName> quae mihi significasti, neque est, de mea <lb xml:id="p1z13"/>erga te fide ulla a parte dubites.</s>
					<s n="9" xml:lang="la">Remitto utranque schedam et <lb xml:id="p1z14"/>magnas tibi gratias ago.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="10" xml:lang="la">De <placeName ref="l41">Bernensium</placeName> foedere multus apud nos <lb xml:id="p1z15"/>rumor est, sed certi nihil.</s>
					<s n="11" xml:lang="la">Si ita est, equidem interpretor, quandam <foreign xml:lang="el">παρ<lb xml:id="p1z16"/>ασκευήν</foreign><note xml:id="fn10" type="footnote" ana="lex" n="10">Vorbereitung.</note> esse eius foederis, quod <placeName ref="l832">Gallorum</placeName> <persName ref="p8112">rex</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p8112">Heinrich II.</persName></note> apud Pagos <lb xml:id="p1z17"/>reliquos ambit.</s>
					<s n="12" xml:lang="la">Consultum autem mihi videretur, <persName ref="p8112">Gallum</persName> ambabus, <lb xml:id="p1z18"/>quod dicitur, ulnis amplecti, modo ipse (quod audio) vel religionis <lb xml:id="p1z19"/>ergo petitos<note xml:id="fn12" type="footnote" n="12">die protestantischen <placeName ref="l862">Eidgenossen</placeName>.</note> deserturus non esset; citra enim utriusque opem mu<lb xml:id="p1z20"/>tuam nec <persName ref="p8112">Gallus</persName> <persName ref="p18538">caesarem</persName><note xml:id="fn13" type="footnote" n="13"><persName ref="p18538">Karl V.</persName></note> feret nec <placeName ref="l862">Helvetius</placeName>.</s>
					<s n="13" xml:lang="la">Sed ea in deliberatio<lb xml:id="p1z21"/>ne sane optimum foret, quam minimum seiungi pagos, se coniungi <lb xml:id="p1z22"/>potius et ita agere unanimis consiliis, ne qua discordię suspitio <lb xml:id="p1z23"/>illius insolentiam ulla parte confirmare posset.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="14" xml:lang="la" ana="farewell">Vale.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="15" xml:lang="de">Unser <lb xml:id="p1z24"/><persName ref="p19915">Steucheler</persName> wirt biß sontag<note xml:id="fn14" type="footnote" n="14">21. August 1547.</note> <placeName ref="l587">Zürich</placeName> selbandern<note xml:id="fn15" type="footnote" ana="lex" n="15">zu zweit.</note> mit seltzammer mu<lb xml:id="p1z25"/>mery einreyten, guͦten herren und gsellen<note xml:id="fn16" type="footnote" ana="lex" n="16">am Schützenfest.</note> kurtzwil ze machen, etc.; <lb xml:id="p1z26"/>hab imm sampt seinen gsellen<note xml:id="fn17" type="footnote" n="17">Unbekannt.</note> erloubt.</s>
					<s n="16" xml:lang="de">Doch laßend eß bey euch bleyben, <lb xml:id="p1z27"/>damit er onversechenlich<note xml:id="fn18" type="footnote" ana="lex" n="18">überraschend.</note> erschine.</s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="17" xml:lang="la"><placeName ref="l473">Sangalli</placeName>, 17. die augusti, hora <lb xml:id="p1z28"/>diei 10., quum 9. hora tuae mihi redditae essent, anno 1547.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z29"/><persName ref="p8049">Ioachimus Vadianus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ornatissimo antistiti <lb xml:id="p2z4"/>suo.</s>
				</p>
			</div>
		</body>
