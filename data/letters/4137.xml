	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Colendissimo domino <persName ref="p495">Bullingero</persName> <persName ref="p8432">Federicus a Salice</persName> S. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Paucis iam diebus elapsis scripsi tibi, colendissime domine <persName ref="p495">Bullingere</persName>, neque nunc, quod illis adiiciam, <lb xml:id="p1z3"/>habeo quicquam;, nos enim satis prospere valemus, suntque in <placeName ref="l648">Rhaetia</placeName> nostra omnia <lb xml:id="p1z4"/>in tuto dei beneficio.</s>
					<s n="3" xml:lang="la">Nundinas <placeName ref="l98">Churienses</placeName> proxime praeteritas negociorum <lb xml:id="p1z5"/>meorum turbine praepeditus non accessi; ex illis autem aliquid novi, quod et <lb xml:id="p1z6"/>tibi significarem, operiebar, at nihil penitus intellexi eoque laetor; quo <lb xml:id="p1z7"/>enim minus novarum rerum accipimus, eo melius habemus.</s>
					<s n="4" xml:lang="la">Dominus deus <lb xml:id="p1z8"/>foelicem hunc statum nostrum perpetuo dignetur prosperare.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">De antichristi creatione <lb xml:id="p1z9"/>nihildum certi audio, etsi adfuerint, qui asseverarunt cardinalem <placeName ref="l1060">Mantuanum</placeName> <lb xml:id="p1z10"/>rerum summa potitum.</s>
					<s n="6" xml:lang="la">Veneti passim et per totum dominium suum praesidia <lb xml:id="p1z11"/>auxere.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">In ducatu <placeName ref="l306">Mediolanensi</placeName>, ut referunt, circiter 3000 <placeName ref="l875">Hispanorum</placeName> <lb xml:id="p1z12"/>militum conscripta et hinc inde in hyberna divisa sunt.</s>
					<s n="8" xml:lang="la">Quid vero <lb xml:id="p1z13"/>sibi haec externorum militum praeparatio velit, incertum est, et diversi d<lb xml:id="p1z14"/>iverse sentiunt; ego vero arbitror reliquias esse exercitus, qui iam aliquot <lb xml:id="p1z15"/>annis in <placeName ref="l736">Pedemonte</placeName> militarunt, qui cum hoc importuno ad sulcandum mare <lb xml:id="p1z16"/>tempore in <placeName ref="l875">Hispaniam</placeName> commodius traiici non possint, ut in officio permaneant, <lb xml:id="p1z17"/>nec hinc et inde in subditos desaeviant, ita sint in hyberna divisi <lb xml:id="p1z18"/>et vere proximo debeant in <placeName ref="l875">Hispaniam</placeName> reduci.</s>
					<s n="9" xml:lang="la">De filio tuo <persName ref="p475">Christophero</persName> <lb xml:id="p1z19"/>nihil adhuc accepi, et iam pridem est, quod a Venetiis nullas omnino literas <lb xml:id="p1z20"/>habui; si vero quid accipiam, confestim ad te transmittam.</s>
					<s n="10" xml:lang="la">Reliquum <lb xml:id="p1z21"/>est, ut bene valeas cum tuis omnibus meque iugiter commendatum habeas.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z22"/>iterum atque iterum et foelicissime.</s>
					<s n="12" xml:lang="la" ana="salute">Filius meus <persName ref="p8433">Ioannes</persName>, qui ludum hic <lb xml:id="p1z23"/>litterarium frequentat diligenter, se tibi commendat teque cum tota familia <lb xml:id="p1z24"/>tua plurimum salvere iubet.</s>
					<s n="13" xml:lang="la" ana="salute">Salutabis, quaeso, meo nomine plurimum etiam <lb xml:id="p1z25"/>reverendos senes d. <persName ref="p8111">Petrum Martirem</persName> et d. <persName ref="p2336">Bernardinum Occhinum</persName>, tuos generos <lb xml:id="p1z26"/>omnes et d. consocerum tuum <persName ref="p8011">Waltherum</persName>, viros utique multis nominibus insignes.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell"><lb xml:id="p1z27"/>Iterum aeternum vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Datum <placeName ref="l93">Clavennae</placeName> 27. novembris 1559.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z28"/>Dominus <persName ref="p8022">Franciscus Niger</persName> ante paucos dies e <placeName ref="l505">Tyrano</placeName> huc migravit tanquam in <lb xml:id="p1z29"/>locum amoeniorem et salubriorem.</s>
					<s n="17" xml:lang="la" ana="salute">Illustris matrona <persName>Isabella</persName> utcunque bene <lb xml:id="p1z30"/>habet, sed et d. <persName ref="p2019">Augustinus Maynardus</persName>, quantum prae ingravescente aetate <lb xml:id="p1z31"/>licet, bene habet, omnesque te plurimum iubent salvere.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z32"/>Idem qui supra tibi omnium deditissimus <lb xml:id="p1z33"/><persName ref="p8432">Federicus a Salice</persName>, commissarius <lb xml:id="p1z34"/>comitatus <placeName ref="l93">Clavennensis</placeName>.</s>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p4z1"/>Ornatissimo et clarissimo viro domino <persName ref="p495">Henrico <lb xml:id="p4z2"/>Bullingero</persName>, domino meo iugiter colendissimo.</s>
					<s n="20" xml:lang="la"><lb xml:id="p4z3"/><placeName ref="l587">Tiguri</placeName> <placeName ref="l862">Helvetiorum</placeName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="de">[Dem] <lb xml:id="p4z4"/>hoch- und wolgelerten herren [mai]ste<lb xml:id="p4z5"/>r <persName ref="p495">Hainrichen Bullingern</persName> <lb xml:id="p4z6"/>zum Grossen Münster predicanten, <lb xml:id="p4z7"/>minem insonderß gunstigen, lieben <lb xml:id="p4z8"/>herren.</s>
					<s n="22" xml:lang="de">Zuͦ <lb xml:id="p4z9"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
