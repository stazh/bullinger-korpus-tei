	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Gratias tibi ingentes ago, reve<lb xml:id="p1z2"/>rende pater, pro novis ad me missis; miratus <lb xml:id="p1z3"/>enim sum, quid in causa monetaria <lb xml:id="p1z4"/>fieret.</s>
					<s n="3" xml:lang="la">Nemo fere ad nos pluriis <lb xml:id="p1z5"/>hisce diebus venit, ex quo de rebus <lb xml:id="p1z6"/>vestris deque tua valetudine aliquid liceret <lb xml:id="p1z7"/>cognoscere; sumus in loco a vulgi <lb xml:id="p1z8"/>strepita remoto.</s>
					<s n="4" xml:lang="la">Balneum suas vires <lb xml:id="p1z9"/>erga omnes fere exerit, ita ut sperem <lb xml:id="p1z10"/>meis liberis omnibus profuturum.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">De <lb xml:id="p1z11"/>vestris rebus omnibus interrogavi tabellarium.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Spero <persName ref="p20768">Catharinam</persName>, <persName ref="p527">fratrem</persName> et <lb xml:id="p1z13"/>alios ad diem dominicum ad vos venturos, <lb xml:id="p1z14"/>ut sigillatim de omnibus vestris rebus cogno<lb xml:id="p1z15"/>scere queamus.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Remitto, quae mi<lb xml:id="p1z16"/>sisti <lb xml:id="p1z17"/>proque illis gratias ago.</s>
					<s n="8" xml:lang="la" ana="salute">Vale, vir clarissime; <lb xml:id="p1z18"/>meo nomine salutare tuam familiam <lb xml:id="p1z19"/>totam ne dedigneris.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l5">Eugstae</placeName> postridie d. Ioannis.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">T[<lb xml:id="p1z20"/>uus] t[otus] <lb xml:id="p1z21"/><persName ref="p1884">Ludovicus Lav[aterus</persName>].</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>socero suo colendissimo.</s>
					<s n="12" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
