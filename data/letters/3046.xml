	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Tuas hoedie, honorande domine compater, per <lb xml:id="p1z3"/>hunc urbis vestrae cursorem accepi, et quoniam <lb xml:id="p1z4"/>is mox hoc eodem die discessurus est, non possum <lb xml:id="p1z5"/>tam plene, quam vellem, tibi respondere nec etiam <lb xml:id="p1z6"/>remittere <placeName ref="l646">Glaronensium</placeName> responsum Paganis <lb xml:id="p1z7"/>nostris datum.</s>
					<s n="3" xml:lang="la">Affligit me haec eadem causa <lb xml:id="p1z8"/>quoque valde, quod video tam parum animi esse <lb xml:id="p1z9"/>illis, qui tamen se regis regum servos profitentur et <lb xml:id="p1z10"/>qui non pro cdaduca, sed pro paterna et immortali gloria <lb xml:id="p1z11"/>dimicare videntur.</s>
					<s n="4" xml:lang="la">Hoc unum metuo: si quando <lb xml:id="p1z12"/>serium aliquid gerendum esset, animos videlicet nobis <lb xml:id="p1z13"/>defuturos; videmus enim, quam frigeant omnia, si <lb xml:id="p1z14"/>cum istis hominibus aliquid agendum.</s>
					<s n="5" xml:lang="la">opus ergo, ut <lb xml:id="p1z15"/>dominus nos excitet et animos addat; alioqui deplorat<lb xml:id="p1z16"/>a sunt omnia.</s>
					<s n="6" xml:lang="la">Speraveram illos in <placeName ref="l834">Italiam</placeName>, anti<lb xml:id="p1z17"/>quum <placeName ref="l862">Helvetiorum</placeName> cymiterium profecturos, ut nos in<lb xml:id="p1z18"/>terea essemus quietiores; sed puto irritam fore hanc <lb xml:id="p1z19"/>profectionem.</s>
					<s n="7" xml:lang="la">Invocabimus tamen dominum, qui hactenus <lb xml:id="p1z20"/>ipsorum fregit consilia, ut deinceps quoque eadem frangere <lb xml:id="p1z21"/>pergat.</s>
					<s n="8" xml:lang="la">Quod tuam expositionem attinet, expec<lb xml:id="p1z22"/>tamus illam avide.</s>
					<s n="9" xml:lang="la">Quid tam i dicaturi simus <lb xml:id="p1z23"/>nos, iam prius tibi constat.</s>
					<s n="10" xml:lang="la">Vellemus nos evulgari <lb xml:id="p1z24"/>omnia, quę ad destructionem <placeName ref="l2131">Babylonis</placeName> et erectionem <lb xml:id="p1z25"/>regni Christi faciunt.</s>
					<s n="11" xml:lang="la">Nihil nobis nimis durum aut tanta <lb xml:id="p1z26"/>nequitia indignum videtur.</s>
					<s n="12" xml:lang="la">Nam non est lingua, quę digne <lb xml:id="p1z27"/>satis proloqui, aut manus aliqua, quę mysterium <lb xml:id="p1z28"/>hoc iniquitatis satis depingere et describere possit.</s>
					<s n="13" xml:lang="la">Sed <lb xml:id="p1z29"/>vides, ut varient ingenia et iudicia.</s>
					<s n="14" xml:lang="la"><persName ref="p4191">Apiarius</persName> ipse <lb xml:id="p1z30"/>hoc opus multis suspectum fecit et eo nomine <persName ref="p1227">Froschoverum</persName> <lb xml:id="p1z31"/>traduxit.</s>
					<s n="15" xml:lang="la">Si tacuisset iste, fortassis nulla <lb xml:id="p1z32"/>de hoc suspitio nata fuisset.</s>
					<s n="16" xml:lang="la">Sed satis nobis constat <lb xml:id="p1z33"/>tua non modo eruditio, sed et prudentia, qua in scrip[tis] <lb xml:id="p1z34"/>tuis uteris, ut non existimare possimus quemquam sumpturum in <lb xml:id="p1z35"/>tuo scripto offendiculum.</s>
					<s n="17" xml:lang="la">Itaque, quantum in nobis est, <lb xml:id="p1z36"/>dabimus <lb xml:id="p1z37"/>operam, ut imprimatur, et magni favoris loco ducemus, quod <lb xml:id="p1z38"/>digneris nobis lucubrationes tuas committere.</s>
					<s n="18" xml:lang="la">Quid <lb xml:id="p1z39"/>vero, si senatui nostro opus hoc dedicares atque <lb xml:id="p1z40"/>hac ratione, ut ipsorum authoritate excuderetur, commode <lb xml:id="p1z41"/>efficeres.</s>
					<s n="19" xml:lang="la">Faceres certe rem te non indignam, ipsis vero <lb xml:id="p1z42"/>apprime gratam, et eo libentius in aeditionem consentient, <lb xml:id="p1z43"/>si ipsorum nomen fuerit appositum.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Poteris de his pro <lb xml:id="p1z44"/>tua prudentia cogitare ipse.</s>
					<s n="21" xml:lang="la">Caeterum non possum <lb xml:id="p1z45"/>intermittere, quin... te magnum dolorem animi mei <lb xml:id="p1z46"/>effundam.</s>
					<s n="22" xml:lang="la">Obiit enim 29. octobris nobis clarissimus ille <lb xml:id="p1z47"/>vir et pientissimum pectus.</s>
					<s n="23" xml:lang="la"><persName ref="p3544">Wolph[gangus] ab Erlach</persName>, cui <lb xml:id="p1z48"/>certe similem haec respublica non habuit et in quo maximarum <lb xml:id="p1z49"/>rerum spes sita erat.</s>
					<s n="24" xml:lang="la">Videtur mors eius magn<lb xml:id="p1z50"/>um malum <lb xml:id="p1z51"/>portendere; non enim potuisset quisquam alius cum tanto <lb xml:id="p1z52"/>detrimento reipublicae atque omnium bonorum movi quam ille.</s>
					<s n="25" xml:lang="la"><lb xml:id="p1z53"/>Caeterum proxime plura scribam.</s>
				</p>
				<p>
					<s n="26" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="27" xml:lang="la">Salva sit <lb xml:id="p1z54"/>domus tua, praeterea dominus <persName ref="p8111">P. Martyr</persName>, d. <persName ref="p8011">Gualth[erus]</persName>, generi tui <lb xml:id="p1z55"/>et reliqui fratres.</s>
					<s n="28" xml:lang="la" ana="salute">Salutant te nostri omnes.</s>
				</p>
				<p>
					<s n="29" xml:lang="de"><placeName ref="l41">Bernę</placeName> 16. novembris <lb xml:id="p1z56"/>1556.</s>
				</p>
				<p>
					<s n="30" xml:lang="la"><persName ref="p8018">Ioannes Hall[erus</persName>] tuus<lb xml:id="p1z57"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="31" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullinegro</persName>.</s>
					<s n="32" xml:lang="la"><placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesię pastori fide<lb xml:id="p2z4"/>lissimo, domino et compatri <lb xml:id="p2z5"/>colendissimo et charissimo <lb xml:id="p2z6"/>suo.</s>
					<s n="33" xml:lang="de"><lb xml:id="p2z7"/>M. <persName ref="p495">Heinrych <lb xml:id="p2z8"/>Bullingern</persName> zuͦ <lb xml:id="p2z9"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
