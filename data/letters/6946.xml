	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Quae apud nos ferantur ex schedula hisce inclusa percipies; ea rogo d. <persName ref="p8011">Gval<lb xml:id="p1z3"/>thero</persName> quoque communices.</s>
					<s n="3" xml:lang="la">Quę de <placeName ref="l2510">Turcicis</placeName> rebus vel <placeName ref="l882">Hungaricis</placeName> narrantur, valde mihi <lb xml:id="p1z4"/>dubia videntur.</s>
					<s n="4" xml:lang="la">Constat papisticos rursus aliquid monstri alere seque Lutheranis <lb xml:id="p1z5"/>(qui nunc passim confessionistarum nomen obiiciunt, puto a confessione <placeName ref="l18">Augu<lb xml:id="p1z6"/>stana</placeName>, quo a Calvinianistis discernentur) admodum insinuare cumque iis <lb xml:id="p1z7"/>propemodum se coniungere.</s>
					<s n="5" xml:lang="la">Turbantur autem illorum consilia prout Achitophelis.</s>
					<s n="6" xml:lang="la">Plura <lb xml:id="p1z8"/>nunc non habeo.</s>
					<s n="7" xml:lang="la">Dominum imploro, ut suis semper adsit vosque confirmet atque <lb xml:id="p1z9"/>conservet.</s>
					<s n="8" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="9" xml:lang="la" ana="salute">Saluta meo nomine plurimum d. d. <persName ref="p8011">Rodolphum Gvaltherum</persName>, <lb xml:id="p1z10"/>consulem vestrum cęterosque amicos.</s>
					<s n="10" xml:lang="la">Datum in predio meo <placeName ref="l54">Bocksperg</placeName> 3 ab <lb xml:id="p1z11"/>urbe lapide 12. novembris anno 1566.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z12"/>R[everentiae] t[uae] studiosissimus <persName ref="p3740">Georgius a Stetten</persName>.</s>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Venerando, pio atque erudito domino <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, ecclesię <placeName ref="l587">Tigurinę</placeName> antistiti fidelissimo, <lb xml:id="p2z3"/>domino et amico suo colendo.</s>
					<s n="13" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
