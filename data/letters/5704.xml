			<zone xml:id="p2z3-0" points="1518,805 1547,803 1579,823 1598,818 1629,833 1700,807 1738,808 1743,716 1726,723 1669,712 1655,718 1603,671 1575,671 1564,659 1526,663">1525,761 1552,759 1579,757 1606,755 1634,753 1661,751 1688,750 1715,749 1743,749</zone>
