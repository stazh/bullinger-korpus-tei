	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Gott mitt uns.</s>
					<s n="2" xml:lang="de">Fürgeliepter sun, dißmals <lb xml:id="p1z2"/>hab ich dir nüt zuͦ schriben, hab aber <lb xml:id="p1z3"/>funden in diner cam<lb xml:id="p1z4"/>er ein zerryßnen calender diß jars, da <lb xml:id="p1z5"/>ich ettwas verzeichnuß noch funden.</s>
				</p>
				<p>
					<s n="3" xml:lang="de">Die schicken <lb xml:id="p1z6"/>ich dir hiemitt, obs dich filicht nutzte <lb xml:id="p1z7"/>und dir vor schaden were.</s>
					<s n="4" xml:lang="de">J[unkher] <persName>Hans Meyß</persName> <lb xml:id="p1z8"/>ist frisch und gesund, hat gester har geschriben; <lb xml:id="p1z9"/>das ist, sin brieff, den er imm welschen <lb xml:id="p1z10"/>land geschriben, ist vorgester har kummen, <lb xml:id="p1z11"/>und hab ichs nächt verstanden.</s>
					<s n="5" xml:lang="de">So ist ouch ein <lb xml:id="p1z12"/>brieff an dich; <persName ref="p487">Heinrych</persName> hat ouch einen <lb xml:id="p1z13"/>an inn geschriben.</s>
				</p>
				<p>
					<s n="6" xml:lang="de">Acht wol, er werde dir dinen o<lb xml:id="p1z14"/>rdnen.</s>
					<s n="7" xml:lang="de">Er wirt 11. oder 12. martij heym k<lb xml:id="p1z15"/>omen.</s>
					<s n="8" xml:lang="de">Gester sind die knaben <lb xml:id="p1z16"/>imm namen gottes mitt einandren darvon <lb xml:id="p1z17"/>gefaren <persName ref="p20419">Rodolff Zwingli</persName>, <persName ref="p8011">Rodolff Walthart</persName> <lb xml:id="p1z18"/>und <persName ref="p5832">Bernhart Meyer</persName> von <placeName>Knonow</placeName> etc.</s>
					<s n="9" xml:lang="de">Gott <lb xml:id="p1z19"/>gäbe inen sin gnad; der beware ouch <lb xml:id="p1z20"/>dich, <persName ref="p20082">Susannam</persName>, <persName ref="p5612">Lisenbethli</persName> und das gantz <lb xml:id="p1z21"/>huß.</s>
					<s n="10" xml:lang="de">Noch hab ich nüt von <placeName ref="l646">Glaris</placeName> empfangen.</s>
				</p>
				<p>
					<s n="11" xml:lang="de"><lb xml:id="p1z22"/>Datum frytags 3. martij, da der mertz <lb xml:id="p1z23"/>ein rostigen, hürninen schnabel hatt.</s>
					<s n="12" xml:lang="de">Gott <lb xml:id="p1z24"/>wölle, das er damitt nitt die räben abbick, 1<lb xml:id="p1z25"/>570.</s>
				</p>
				<p>
					<s n="13" xml:lang="de" ana="salute">Alles volck gruͤst üch.</s>
				</p>
				<p>
					<s n="14" xml:lang="de"><persName ref="p495">H[einr<lb xml:id="p1z26"/>ych] B[u<pb/><lb xml:id="p2z1"/>llinger]</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="de">Minem lieben sun <lb xml:id="p2z2"/><persName ref="p477">Hansen Rodolffen Bullingern</persName>, <lb xml:id="p2z3"/>pfarreren zuͦ <lb xml:id="p2z4"/><placeName ref="l35">Berg</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>