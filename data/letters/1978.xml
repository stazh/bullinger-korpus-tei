	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D. P.</s>
					<s n="2" xml:lang="la">Humanissimas accepi literas tuas teduitque me, quod te anxium <lb xml:id="p1z2"/>reddiderint d. <persName ref="p3375">Vergerii</persName> literę ob libellum manuscriptum et aureum numum, <lb xml:id="p1z3"/>quae (ut illico illum monui, etsi redditae non sint literę) iam pridem accepi <lb xml:id="p1z4"/>et typographo tradidi.</s>
					<s n="3" xml:lang="la">Accepi, quaecunque hactenus ad me miseris, habeoque <lb xml:id="p1z5"/>gratias, quod tantus vir, gravioribus occupatus, digneris tamen et minimis <lb xml:id="p1z6"/>in rebus amicis tuis et minoribus fratribus in Christo inservire.</s>
					<s n="4" xml:lang="la">Quo fit, ut cum <lb xml:id="p1z7"/>in summis rebus tum in christiana mansuetudine non paucis exemplo sis.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z8"/>Mitto rursus per alium nuncium <placeName ref="l93">Clavennam</placeName> literas meas ad d. <persName ref="p3375">Vergerium</persName>, <lb xml:id="p1z9"/>cui pro te et me satisfaciam.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Misi autem superioribus diebus fasciculum <lb xml:id="p1z10"/>parvum in forma libri, in quo 10 Responsiones d. <persName ref="p3375">Vergerii</persName> sunt ad <lb xml:id="p1z11"/>cardinalem <placeName ref="l1107">Tridentinum</placeName>, quas credo redditas non esse tibi.</s>
					<s n="7" xml:lang="la">Dederam <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p1z12"/>mulieri, cui nomen est <persName>Dorothea Louwin</persName> <foreign xml:lang="de">by der Lowinen bim <lb xml:id="p1z13"/><placeName>Büchsenhuß</placeName>.</foreign></s>
					<s n="8" xml:lang="la">Curabit tua charitas per puerum, ut, nisi reddiderit, <lb xml:id="p1z14"/>reddat.</s>
					<s n="9" xml:lang="la">Nuper etiam, id est heri, misi ad generum tuum d. <persName ref="p8442">Iosiam</persName> literas <lb xml:id="p1z15"/>et haec omnia d. <persName ref="p3375">Vergerii</persName>, non mea caussa, qui mihi suis frequentibus <lb xml:id="p1z16"/>literis negocium facessit.</s>
					<s n="10" xml:lang="la">Sed omnia libenter fero et fortiora ferrem <lb xml:id="p1z17"/>in christiano negocio me domino corroborante; hic ferre nil novi est.</s>
					<s n="11" xml:lang="la" ana="farewell"><lb xml:id="p1z18"/>Bene vale, deum pro me etiam ora meque tuum tuorumque etiam noris per <lb xml:id="p1z19"/>secula cuncta.</s>
					<s n="12" xml:lang="la">Ex <placeName ref="l28">Basilea</placeName> ultima augusti 1553.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z20"/><foreign xml:lang="de">Warhafftiger</foreign> tuus <lb xml:id="p1z21"/><persName ref="p1327">Gulielmus Gratarolus</persName>, medicus.</s>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo et optimo <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z2"/>pastori d. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>maiori meo observandissimo.</s>
					<s n="15" xml:lang="de"><lb xml:id="p2z4"/>Zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
