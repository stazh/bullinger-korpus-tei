	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Hic bona fide ad te mitto exitum comitiorum <lb xml:id="p1z2"/>nostrorum<note xml:id="fn1" type="footnote" n="1">Zum Ausgang des <placeName ref="l199">Hagenauer</placeName> Religionsgesprächs s. oben <ref target="file11455">Nr. 1412</ref>, 5-43. Auszüge aus diesbezüglichen Akten von der Hand <persName ref="p495">Bullingers</persName> finden sich in Zürich StA, E II 347, 180-189.</note>.</s>
					<s n="3" xml:lang="la">Tabellionum penuria citius mittere non <lb xml:id="p1z3"/>potui, neque otium michi fuit omnia ordine describere; <lb xml:id="p1z4"/>quare benignius feras confusam illam <lb xml:id="p1z5"/>scriptionem.</s>
					<s n="4" xml:lang="la">Facile potes te explicare, cum satis <lb xml:id="p1z6"/>versutus sis nec careas iuditio.</s>
					<s n="5" xml:lang="la">Sed remitte haec <lb xml:id="p1z7"/>mea per hunc tabellarium<note xml:id="fn2" type="footnote" n="2">Unbekannt.</note>; nullum enim aliud <lb xml:id="p1z8"/>exemplar<note xml:id="fna" type="footnote" n="a"><hi>korrigiert aus</hi> exemplum.</note> est michi.</s>
					<s n="6" xml:lang="la"><persName ref="p8049">Vadiano</persName> non opus est <lb xml:id="p1z9"/>aliquid de hoc scribere, nam a me habet omnia<note xml:id="fn3" type="footnote" n="3">Vgl. <persName ref="p4079">Zwicks</persName> Brief an <persName ref="p8049">Vadian</persName> vom 6. August (Vadian BW V 636, Nr. 1126).</note>.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/>Nonne vero egregie conantur nobis imponere <lb xml:id="p1z11"/>adversarii tot dilationibus?</s>
					<s n="8" xml:lang="la">Tandem forte non <lb xml:id="p1z12"/>deerit nobis dominus, ut liberemur aliquando ab <lb xml:id="p1z13"/>impostoribus istis.</s>
					<s n="9" xml:lang="la">Fiat brevi, o deus!<pb type="edition" next="149"/></s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/>Praeterea non est, quod scribam.</s>
					<s n="11" xml:lang="la"><persName ref="p8127">Pellicano</persName>, <persName ref="p1753">Leoni</persName><note xml:id="fn4" type="footnote" n="4"><persName ref="p1753">Leo Jud</persName>.</note>, <persName ref="p8171">Theodoro</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p8171">Theodor Bibliander</persName>.</note>, <lb xml:id="p1z15"/><persName ref="p8412">Megandro</persName>, <persName ref="p8435">Sertorio</persName><note xml:id="fnb" type="footnote" n="b"><persName ref="p8412">Megandro</persName>, <persName ref="p8435">Sertorio</persName> <hi>am Rande nachgetragen.</hi></note><note xml:id="fn6" type="footnote" n="6">Gemeint ist <persName ref="p8435">Christoph Schappeler</persName>, der zeitweise in <placeName ref="l587">Zürich</placeName> lebte (vgl. <persName ref="p6340">Johannes Rütiner</persName>, Diarium 1529-1539, hg. v. Ernst Gerhard Rüsch, Textband I/2, St. Gallen 1996, Abs. 946; Vadian BW VI 77f. 159f).</note> potes summam rei communicare.</s>
					<s n="12" xml:lang="la">Tu <lb xml:id="p1z16"/>ne cesses amare nos.</s>
					<s n="13" xml:lang="la" ana="farewell">Vale cum uxore<note xml:id="fn7" type="footnote" ana="bio" n="7"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note>, matre<note xml:id="fn8" type="footnote" ana="bio" n="8"><persName ref="p7042">Anna, geb. Wiederkehr</persName>.</note> <lb xml:id="p1z17"/>et liberis<note xml:id="fn9" type="footnote" n="9">Siehe oben <ref target="file11387">Nr. 1344</ref>, Anm. 14.</note>. <lb xml:id="p1z18"/>11. augusti 1540.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">T<lb xml:id="p1z19"/>uus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z20"/><persName ref="p4851">Froschoferus</persName> chartam conficit subtilem <lb xml:id="p1z21"/>et valde mundam<note xml:id="fn10" type="footnote" n="10">Zu <persName ref="p4851">Froschauers</persName> Papierfabrikation vgl. Paul <hi>Leemann-van Elck,</hi> Die Offizin Froschauer. <placeName ref="l587">Zürichs</placeName> berühmte Druckerei im 16. Jahrhundert. Ein Beitrag zur Geschichte der Buchdruckerkunst anläßlich der Halbjahrtausendfeier ihrer Erfindung, <placeName ref="l587">Zürich</placeName>/Leipzig 1940, S. 99-102.</note>; id ex tuis et <persName ref="p8049">Vadiani</persName> <lb xml:id="p1z22"/>literis video.</s>
					<s n="16" xml:lang="la">Igitur velim, paucula quaedam <lb xml:id="p1z23"/>folia ad me des, ut videam, qualis sit.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z24"/><persName ref="p8055">Ambrosius</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p8055">Ambrosius Blarer</persName>.</note> salutat te cum fratribus perquam studiosissime.</s>
					<note type="address">[Adresse auf der Rückseite<note xml:id="fnc" type="footnote" n="c"><hi>Darunter, verwischt:</hi> Domino <persName ref="p8127">Cunrado Pellicano</persName>.</note>:]</note>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Hainricho <lb xml:id="p2z2"/>Bullingero</persName>.</s>
				</p>
			</div>
