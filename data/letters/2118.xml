	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Etsi nihil novi habeam, nolo tamen vestrum <lb xml:id="p1z2"/>legatum, virum optimum et bonum omnibus intimum, <lb xml:id="p1z3"/>absque meo responso abiire; ille dicet <lb xml:id="p1z4"/>tibi omnia hic prospera et apud nos etiam, <lb xml:id="p1z5"/>diis gratia.</s>
					<s n="3" xml:lang="la">Unum tantum timeo, quid <lb xml:id="p1z6"/>inquies matrimonium <placeName ref="l875">Hispanię</placeName> et <placeName ref="l830">Anglię</placeName> <lb xml:id="p1z7"/>ista bestia vult; sed subditi et magnates <lb xml:id="p1z8"/><persName>regni Anglię</persName> proponunt sibi mortem ante<lb xml:id="p1z9"/>ferendam, ita quod speratur magn s motus, <lb xml:id="p1z10"/>nisi mutet consilium.</s>
					<s n="4" xml:lang="la">Quod autem ad <lb xml:id="p1z11"/><persName>Caesarem</persName> et <persName ref="p18477">Ferdinandum</persName>, audio certo, ut <lb xml:id="p1z12"/>credidi, esse collusionem inter illos et <lb xml:id="p1z13"/>timeo, ne noster <persName ref="p3375">Vergerius</persName> in hoc <lb xml:id="p1z14"/>cecutiat.</s>
					<s n="5" xml:lang="la">Ero die sabadi <placeName ref="l760">Soluturi</placeName>; <lb xml:id="p1z15"/>inde, si quid novi habeo, ex me expecta.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z16"/>Papa egrotavit ad mortem et adhuc <lb xml:id="p1z17"/>egrotat; sed bene s<lb xml:id="p1z18"/>peratur de eius <lb xml:id="p1z19"/>salute.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Vale bene, vir optime.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z20"/>Ex <lb xml:id="p1z21"/><placeName ref="l160">Friburgo</placeName> 20a decembris.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z22"/>Tuus sem<lb xml:id="p1z23"/>per <lb xml:id="p1z24"/><persName ref="p8296">Bass[a<lb xml:id="p1z25"/>fontaneus]</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
