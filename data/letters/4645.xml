	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S.</s>
					<s n="2" xml:lang="la">Bis ad te scripsi <placeName ref="l21">Badena</placeName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Misi caseolos aliquot et bullam <lb xml:id="p1z3"/><placeName ref="l425">Rome</placeName> impressam.</s>
					<s n="4" xml:lang="la">Mentionem etiam feci de interesse, sed nesciebam <lb xml:id="p1z4"/>arbitros approbasse usuram de decem pro centum.</s>
					<s n="5" xml:lang="la">Ubi regis <lb xml:id="p1z5"/>super ea re voluntatem intellexero, pluribus ad te ea de re <lb xml:id="p1z6"/>non boni exempti scribam, et quid ipse sentiam.</s>
					<s n="6" xml:lang="la">Literas, quas <lb xml:id="p1z7"/>in itinere recepi, reddes d. <persName ref="p8011">Galtero</persName> et videbis, que ex <placeName ref="l834">Italia</placeName> <lb xml:id="p1z8"/>ad me scripta sunt et ex <placeName ref="l832">Gallia</placeName> per d. <persName ref="p8111">Martirem</persName> aut <persName>Valdunum</persName> <lb xml:id="p1z9"/>interpretes; post remittes ad me.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Nondum recepi ultima folia <lb xml:id="p1z10"/>tue tractationis de consilio; nemini, que misisti, communicabo, nisi <lb xml:id="p1z11"/>quando scripseris tempestivum esse.</s>
					<s n="8" xml:lang="la" ana="salute">Salutabis amicos omnes et nos <lb xml:id="p1z12"/>amabis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l760">Soluturi</placeName> 28. ianuarii.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z13"/>Tuus ex animo <persName ref="p629">Cognetius</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z2"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> pastori <lb xml:id="p2z3"/>vigilantissimo.</s>
				</p>
			</div>
		</body>
	</text>
