	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Literae tuae, reverende in Christo pater, nobis sunt redditae; <lb xml:id="p1z2"/>vos autem omnes recte valere vehementer gaudeo.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Ex <placeName ref="l834">Italia</placeName> quae interea habui, misi cum affine d. d. <lb xml:id="p1z4"/><persName ref="p1283">Gesneri</persName>, nec dubito te iam legisse.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Misi etiam <lb xml:id="p1z5"/>scriptum illud et communicavi cum iis, quibuscum <lb xml:id="p1z6"/>communicari volebas.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quae de insula obscurius scripseram, <lb xml:id="p1z7"/>sic mihi nunciabatur, esse quandam scilicet insulam, <lb xml:id="p1z8"/>quae distaret <placeName ref="l1121">Genua</placeName> itinere unius diei, et eam <lb xml:id="p1z9"/>a <placeName ref="l2510">Turca</placeName> occupari.</s>
					<s n="6" xml:lang="la">Quae illa esset, non satis potui <lb xml:id="p1z10"/>augurari, cum mappae nullae mihi ad manum sint.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>Promuntorium enim <placeName ref="l749">Sacconense</placeName> eum tenere non est <lb xml:id="p1z12"/>verisimile.</s>
					<s n="8" xml:lang="la">Trepidatur <placeName ref="l1121">Genuae</placeName> et <placeName ref="l425">Romae</placeName>; hoc certum est.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>Interea nihil habui, nisi quod pontifex intruserit <lb xml:id="p1z14"/>in carceres Caraphas 7. iunii et quidem cardinalem <lb xml:id="p1z15"/>scribitur in consistorio comprehendi curasse.</s>
					<s n="10" xml:lang="la">Causa autem <lb xml:id="p1z16"/>perhibetur, quod, cum pontifex pridie eius diei cum suis <lb xml:id="p1z17"/>in horto Iulii coenasset, Caraphae conspecti fuerint <lb xml:id="p1z18"/>in eodem horto armati.</s>
					<s n="11" xml:lang="la">De <persName ref="p18477">Caesaris Ferdinandi</persName> morte <lb xml:id="p1z19"/>subinde rumores <placeName ref="l232">Oeniponte</placeName><note xml:id="fn1" type="footnote" n="1"><placeName ref="l232">Innsbruck</placeName>.</note> ad nos afferuntur.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z20"/>Haec hactenus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Dominus te cum tuis omnibus <lb xml:id="p1z21"/>incolumem conservet.</s>
					<s n="14" xml:lang="la"><placeName ref="l98">Curiae</placeName> 8. iulii anno 1560.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z22"/>Tui observantissimus <lb xml:id="p1z23"/><persName ref="p8009">Ioannes F[abricius] M[on<lb xml:id="p1z24"/>tanus</persName>].</s>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro eruditione et <lb xml:id="p2z2"/>pietate excellenti d. <persName ref="p495">Heinrych<lb xml:id="p2z3"/>o Bullingero</persName>, ecclesiae <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName> antistiti vigi<lb xml:id="p2z5"/>lantissimo, domino <lb xml:id="p2z6"/>et patrono suo <lb xml:id="p2z7"/>plurimum observando.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>