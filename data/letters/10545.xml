	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Mitto tibi, optime vir, olera<note xml:id="fn1" type="footnote" n="1">Bei diesem Geschenk handelt es sich um <persName ref="p4349">Karlstadts</persName> Disputationsthesen ("Axiomata disputationis pro receptione ad facultatem Theologicam gymnasii Basiliensis", <placeName ref="l28">Basel</placeName> 1535, s. Ernst Freys und Hermann Barge, Verzeichnis der gedruckten Schriften des <persName ref="p4349">Andreas Bodenstein von Karlstadt</persName>, in: Zentralblatt für Bibliothekswesen XXI, 1904, S. 318f, <ref target="file10184">Nr. 153</ref> [Nachdruck Nieuwkoop 1965, S. 76f]).</note> eaque minuta pro tuis magnis <lb xml:id="p1z2"/>et argenteis muneribus<note xml:id="fn2" type="footnote" n="2"><persName ref="p495">Bullinger</persName> hatte <persName ref="p4349">Karlstadt</persName> kurz zuvor seine "Assertio utriusque in Christo naturae" geschenkt, vgl. <bibl source="b6">HBBW IV</bibl>, s. 338, 25f.</note>, nec tamen ausus mittere, nisi <lb xml:id="p1z3"/>sperassem te vel inde collecturum istud<note xml:id="fna" type="footnote" n="a">istud <hi>übergeschrieben.</hi></note>: Si posset, majora tradidisset.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Videbis autem ex epistola<note xml:id="fn3" type="footnote" n="3">Gemeint ist die Vorrede zu den Disputationsthesen.</note> senatus nostri consilium <lb xml:id="p1z5"/>literas exercitatione roborare<note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> roborare <hi>gestrichenes</hi> velle.</note> molientis.</s>
					<s n="4" xml:lang="la">Sunt, quibus <lb xml:id="p1z6"/>non placet<note xml:id="fn4" type="footnote" n="4">Insbesondere Myconius hatte sich gegen die vom Basler Rat beschlossenen Maßnahmen gewandt, s. oben <ref target="file10543">Nr. 507</ref>, 19-36.</note>, sed ego imperio praesertim ad incrementum <lb xml:id="p1z7"/>literarum apposito non potui refragari, maxime cum <lb xml:id="p1z8"/>mihi sic praeceperint, ut parendum sit aut amittenda <lb xml:id="p1z9"/>functio, e qua nunc vivo.</s>
					<s n="5" xml:lang="la">Invitassem vos ad eand<lb xml:id="p1z10"/>em <lb xml:id="p1z11"/>disputationem, nisi obstitisset hyemis inclemencia.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z12"/>Adhuc tamen consultatur, an invitare plerosque velint.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z13"/>Sic enim me obtuli, verum neutiquam fiducia eruditionis aut <lb xml:id="p1z14"/>virium.</s>
					<s n="8" xml:lang="la">Quas si habui, tanto exilio aut amisi aut sic tenuatas <lb xml:id="p1z15"/>habeo, ut plane sciam infirmiores, quam ut quicquam <lb xml:id="p1z16"/>spei in eis ponam.</s>
					<s n="9" xml:lang="la">Quicquid feci, ob utilitatem studii publici <lb xml:id="p1z17"/>et ob spem recipiendarum virium feci fiducia in deum collacata, <lb xml:id="p1z18"/>qui sapientia ac bonitate sua verbo suo huiusque scrutatoribus scireque <lb xml:id="p1z19"/>ac discere ab ipso cupientibus solet adesse.</s>
					<s n="10" xml:lang="la">Quod de hypo<lb xml:id="p1z20"/>theticis inserui, si vacat cum d. <persName ref="p8171">Theodoro</persName><note xml:id="fn5" type="footnote" n="5"><persName ref="p8171">Theodor Bibliander</persName>.</note> excutito.</s>
					<s n="11" xml:lang="la">In hoc <lb xml:id="p1z21"/>plane fui, ut tandem diligentius studeant dialecticę, sine <lb xml:id="p1z22"/>cuius praesidio nullum thema, nullum textum recte tractare nec <lb xml:id="p1z23"/>locos, qui insunt, videre possunt.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="farewell">Vale fęliciter.</s>
					<s n="13" xml:lang="la" ana="salute">Saluta d. <lb xml:id="p1z24"/><persName ref="p8171">Theodorum</persName>, d. <persName ref="p6820">P[etrum] Tossanum</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p6820">Pierre Toussain</persName>.</note>.</s>
					<s n="14" xml:lang="la">Hunc etiam meis verbis precare, <lb xml:id="p1z25"/>ut dignetur locum geneseos de imagine hominis<note xml:id="fn7" type="footnote" n="7">Die Gottesebenbildlichkeit des Menschen <cit type="bible"><ref>(Gen 1, 27)</ref></cit> spielt auch in <persName ref="p4349">Karlstadts</persName> Disputationsthesen eine wichtige Rolle (s. die Thesen 60ff, vgl. <bibl source="b89">Barge</bibl> II 468f).</note> ad me<pb type="edition" next="57"/> <lb xml:id="p1z26"/>scribere.</s>
					<s n="15" xml:lang="la">Ne pigeat te hęc pronunciata distribuere<note xml:id="fn8" type="footnote" n="8"><persName ref="p4349">Karlstadt</persName> ließ seine Thesen mehreren Freunden in <placeName ref="l587">Zürich</placeName> zukommen; ein <persName ref="p8397">Christoph Klauser</persName> gewidmetes Exemplar ist erhalten geblieben (Zürich ZB, Ms S 37, nach <ref target="file10165">Nr. 134</ref>).</note>.</s>
					<s n="16" xml:lang="la" ana="salute"><lb xml:id="p1z27"/>Saluta <persName ref="p1753">Leonem</persName><note xml:id="fn9" type="footnote" n="9"><persName ref="p1753">Leo Jud</persName>.</note>, d. <persName ref="p3242">H[enricum] Utingerum</persName> et omnes vici<lb xml:id="p1z28"/>nos supra et infra.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l28">Basilee</placeName>, die ianuarii 11. <lb xml:id="p1z29"/>anno 1535.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z30"/>Tuus <persName ref="p4349">Carostadius</persName> [!].</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Prudentissimo et doctissimo <lb xml:id="p2z2"/>viro d. <persName ref="p495">Henricho <lb xml:id="p2z3"/>Bullingero</persName>, <lb xml:id="p2z4"/>ecclesiastae <lb xml:id="p2z5"/>Tugurino, <lb xml:id="p2z6"/>maiori suo charissimo<note xml:id="fnc" type="footnote" n="c"><hi>Darunter von unbekannter Hand:</hi> No. 5.</note>.</s>
				</p>
			</div>
