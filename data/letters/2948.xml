	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Cur bonus hic frater Iacobus Rubellus
					<lb xml:id="p1z2"/>fuerit coactus dimissionem petere a vicini
					<lb xml:id="p1z3"/>vestris Basiliensis ipse melius exponet. Conse
					<lb xml:id="p1z4"/>nditionem aliquam querit. Cum autem propter schopm
					<lb xml:id="p1z5"/>frequentem nulla ministrorum laborem
					<lb xml:id="p1z6"/>inopia deo gratia nihil ei potui aperire spei
					<lb xml:id="p1z7"/>apud nos fore na aliquando recipiatur. Quin
					<lb xml:id="p1z8"/>dedi consilium, ut ad vos descendat, apud quos
					<lb xml:id="p1z9"/>vicinia ecclesiae reformentur, forte locum
					<lb xml:id="p1z10"/>aliquem futurum, qui ipsius opera indigeat. Si
					<lb xml:id="p1z11"/>quid ergo tui consilii auxiliique habes, scio pro tua
					<lb xml:id="p1z12"/>pietate misero non defutuum. Condonabis
					<lb xml:id="p1z13"/>autem mihi quod hac parte tibi molestia
					<lb xml:id="p1z14"/>exhibeo. Forte cesserit ei functio liberos
					<lb xml:id="p1z15"/>instituendi, in qua facultate se aliquid
					<lb xml:id="p1z16"/>praestare posse sperat. Silent alioqui iam
					<lb xml:id="p1z17"/>undique omnia. Ego potius a te audiam, optime
					<lb xml:id="p1z18"/>et fidelissime frater, quid fiat apud vicinos nostri
					<lb xml:id="p1z19"/>Vive et vale et commenda me illustrissimo primnie
					<lb xml:id="p1z20"/>Tiguri 19. iunii. Salvi sint sym
					<lb xml:id="p1z21"/>ystae et fratres omnes. 1556.
					<lb xml:id="p1z22"/>Bullingerus tuus.
					<pb/>
					<lb xml:id="p2z1"/>Praestantissimo viro d. Sat
					<lb xml:id="p2z2"/>erbio pastori
					<lb xml:id="p2z3"/>Rychevillano, domino
					<lb xml:id="p2z4"/>colendissimo et fratri
					<lb xml:id="p2z5"/>simosuo.
					<lb xml:id="p2z6"/>Reychenwyle
				</p>
			</div>
		</body>
	</text>
