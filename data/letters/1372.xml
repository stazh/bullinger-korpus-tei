	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><placeName ref="l491">Argentinae</placeName> 10. augusti 1553.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>S. P.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Quod optarem proximis literis, <persName ref="p495">Bullingere</persName> amicissime, <lb xml:id="p1z4"/>en mitto ad te, d. <persName ref="p8111">P[etri] Martyris</persName> disputationem et libellum <lb xml:id="p1z5"/>de eucharistia.</s>
					<s n="4" xml:lang="la">Nolui te fraudare tanta laetitia diutius, nescio <lb xml:id="p1z6"/>tamen, an forsan antea acceperis; quodsi acceperis, functus <lb xml:id="p1z7"/>tamen sum officio meo.</s>
					<s n="5" xml:lang="la">Viri undequaque doctissimi laudabis <lb xml:id="p1z8"/>diligentiam et labores.</s>
					<s n="6" xml:lang="la">Acriter dimicatum est cum hominibus acutis <lb xml:id="p1z9"/>nimium et perversis; palman tamen tulit, quod certe omnibus <lb xml:id="p1z10"/>bonis gaudio maximo est.</s>
					<s n="7" xml:lang="la">Simili si posset <placeName ref="l86">Cantabrigia</placeName> ornari <lb xml:id="p1z11"/>viro, quam foelicissima foret <placeName ref="l830">Anglia</placeName> nostra!</s>
					<s n="8" xml:lang="la">Optant non<lb xml:id="p1z12"/>nulli primi ordinis in <placeName ref="l830">Anglia</placeName> viri <persName ref="p8417">Musculum</persName> eius loco substitui; <lb xml:id="p1z13"/>renuit tamen ipse, ut audio, conditionem.</s>
					<s n="9" xml:lang="la">Ausim tamen <lb xml:id="p1z14"/>ipse promittere, ut si velit hoc munus obire, non minorem apud <lb xml:id="p1z15"/>regem bonosque omnes assequuturum gratiam quam ipse <persName ref="p467">Bucerus</persName>, neque <lb xml:id="p1z16"/>tam perverse doctos <placeName ref="l86">Cantabrigiae</placeName> atque <placeName ref="l376">Oxoniis</placeName> d. <persName>Petrus</persName> inveniet.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z17"/>Suspecti enim semper erant huius academiae alumni haereseos, ut <lb xml:id="p1z18"/>vocant, apud veteres doctos et indoctos, quo facile iudicare <lb xml:id="p1z19"/>posses horum studia synceriora <placeName ref="l376">Oxoniensibus</placeName> semper fuisse; <lb xml:id="p1z20"/>inde enim eruperunt <persName ref="p672">Coxei</persName>, <persName ref="p1560">Hoperi</persName> et, quem primo loco nominari <lb xml:id="p1z21"/>debui, <persName ref="p674">Cranmeri</persName> caeterique id genus doctissimi viri, neque est, <lb xml:id="p1z22"/>cur tam ab hac vocatione horreat; honestius enim est regno <lb xml:id="p1z23"/>quam civitati subvenire.</s>
					<s n="11" xml:lang="la">Quare omni dubio humano ab<lb xml:id="p1z24"/>iecto officium meo iuditio christiani faceret, si toties vocatus <lb xml:id="p1z25"/>tandem acquiesceret; quodsi non fecerit, vix suspicionem <lb xml:id="p1z26"/>pusillanimi et minus strenui aufugiet.</s>
					<s n="12" xml:lang="la">Quod super<lb xml:id="p1z27"/>est, non dubito, quin tu cum viro acturus sis; si posset per<lb xml:id="p1z28"/>suaderi, fac sciam; curabo, ut ei provideretur de viatico, et <lb xml:id="p1z29"/>quae praeterea necessaria sunt.</s>
					<s n="13" xml:lang="la">Uxorem et liberos salvos <lb xml:id="p1z30"/>cupio.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="salute">Saluta amicos omnes.</s>
					<s n="15" xml:lang="la" ana="farewell">Bene vale.</s>
					<s n="16" xml:lang="la">Nova proxim<lb xml:id="p1z31"/>is ante triduum hinc ad <persName>Valentinum Nußboum</persName> missis omnia <lb xml:id="p1z32"/>commemoravi, quae scirem, nec interea quicquam accidit.</s>
					<s n="17" xml:lang="la" ana="farewell">Vale.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><persName ref="p505">I[oan<lb xml:id="p1z33"/>nes] B[urcherus</persName>] tuus totus.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z34"/>Libellum tuum, quo respondisti calumniis ultimis <persName ref="p1974">Lutheri</persName>, cum adiuncto eius<lb xml:id="p1z35"/>dem calumniae libello cuperem quam avide.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Sunt, qui habent <lb xml:id="p1z36"/>responsum tuum, sed carent libello <persName ref="p1974">Lutheri</persName>; quare coniunctum utrumque <lb xml:id="p1z37"/>vellem, quo possent et calumniae erroresque <persName ref="p1974">Lutheri</persName> vestrumque r<lb xml:id="p1z38"/>esponsum cerni.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <persName ref="p495">H. Bullingero</persName>, <lb xml:id="p2z2"/>amico charo.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
