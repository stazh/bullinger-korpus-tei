	<text xml:lang="la">
		<note xml:id="fn1" type="footnote" subtype="metadata" n="1"><persName ref="p1365" cert="high">Grynäus</persName> bestätigt den Erhalt eines von <persName ref="p8049" cert="high">Vadian</persName> verfaßten Briefes; ein solcher wurde ihm am 7. Mai 1539 von <persName ref="p495" cert="high">Bullinger</persName> zugesandt (s. unten Z. 1 mit Anm. 2).</note>
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><persName ref="p8049">Vadiani</persName> epistolam<note xml:id="fn2" type="footnote" n="2">Gemeint ist zweifellos <persName ref="p8049">Vadians</persName> christologische Abhandlung in Briefform vom September 1536 (Teildruck: <bibl source="b8">HBBW VI</bibl>, <ref target="file10936">Nr. 894</ref>), die <persName ref="p495">Bullinger</persName> am 7. Mai übersandt hatte; vgl. oben <ref target="file11310">Nr. 1267</ref>, 3-5.</note> accepi; curabo, ut fide bona restitua<lb xml:id="p1z2"/>tur tibi ac ut non sine commodo ecclesię perveniat ad <lb xml:id="p1z3"/>quosdam.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Commendo tibi hunc <persName ref="p41">Michaelem</persName><note xml:id="fn3" type="footnote" n="3">Zu denken ist an <persName ref="p41">Michael Adam</persName>, der <persName ref="p8049">Vadians</persName> Brief und <persName ref="p495">Bullingers</persName> Begleitschreiben übermittelt hatte (vgl. oben <ref target="file11310">Nr. 1267</ref>, 6-8); es könnte sich aber auch um einen Briefüberbringer handeln, der <persName ref="p495">Bullinger</persName> noch unbekannt war und deshalb einer Empfehlung bedurfte.</note>.</s>
					<s n="4" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z4"/>in domino Christo.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Libellum<note xml:id="fn4" type="footnote" n="4">Nämlich die Neubearbeitung von <persName ref="p495">Bullingers</persName> "De origine erroris libri duo" (<bibl source="b286">HBBibl</bibl> I 12); vgl. oben <ref target="file11301">Nr. 1258</ref>, 1-4.</note> tuum nondum legi; dominus <lb xml:id="p1z5"/>novit, quod hactenus nullum tempus ad eam rem fuit <lb xml:id="p1z6"/>commodum, sic negotia, quanquam levia et puerilia, <lb xml:id="p1z7"/>me abripiunt<note xml:id="fn5" type="footnote" n="5">Anspielung auf den Streit um die Universitätsordnung; vgl. unten <ref target="file11313">Nr. 1270</ref>, 13-22.</note>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="farewell">Iterum vale et me in domino <lb xml:id="p1z8"/>ama.</s>
					<s n="7" xml:lang="la">Dominus Christus servet nos.</s>
					<s n="8" xml:lang="la">Amen.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z9"/><persName ref="p1365">Gryneus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Bullingero</persName> <lb xml:id="p2z2"/>suo, colendo <lb xml:id="p2z3"/>fratri.</s>
				</p>
			</div>
		</body>
	</text>
