			<zone xml:id="p2z10-0" points="432,862 625,884 1238,824 1307,860 1504,817 2228,846 2192,788 1932,759 432,797">444,850 533,844 623,844 712,838 802,832 891,829 981,826 1070,823 1160,820 1249,820 1339,817 1428,814 1518,814 1607,814 1697,814 1786,814 1876,817 1965,817 2055,823 2144,829 2234,835</zone>
