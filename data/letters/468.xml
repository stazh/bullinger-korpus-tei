	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. <lb xml:id="p1z2"/>D.</s>
					<s n="2" xml:lang="la">Non licuit ad omnia tua respondere.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Tuas <lb xml:id="p1z4"/>enim accepi et ago gratias.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>Festinavit hic eques.</s>
					<s n="5" xml:lang="la">Doleo <placeName ref="l491">Argentinensem</placeName> <lb xml:id="p1z6"/>ecclesiam esse dissipatam; dominus <lb xml:id="p1z7"/>recolligat eam.</s>
					<s n="6" xml:lang="la">De <placeName ref="l302">Lubeca</placeName> gaudeo; <lb xml:id="p1z8"/>dominus confirmet eam.</s>
					<s n="7" xml:lang="la"><persName ref="p2706">Richerio</persName> dabis <lb xml:id="p1z9"/>exemplaria, dabis et aliis, quibus vides <lb xml:id="p1z11"/>inscripta; non potui vel verbum ad<lb xml:id="p1z12"/>dere.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Dices <persName ref="p1278">Gastio</persName> me suas acce<lb xml:id="p1z13"/>pisse et agere gratias.</s>
					<s n="9" xml:lang="la">Habes tu folium <lb xml:id="p1z14"/>quoque, quod perperam est impressum.</s>
					<s n="10" xml:lang="la" ana="salute"><persName ref="p2706">Richerium</persName> <lb xml:id="p1z15"/>salutabis.</s>
					<s n="11" xml:lang="la">Valde suspicor non <lb xml:id="p1z16"/>discordare principes in omnibus.</s>
					<s n="12" xml:lang="de">Mine <lb xml:id="p1z17"/>herren habend sich sampstags erkent, <lb xml:id="p1z18"/>sich nüt ze verbinden, sunder wie ire vor<lb xml:id="p1z19"/>deren ze blyben und alles trülich, <lb xml:id="p1z20"/>weß sy sich verbunden an andern, trüwlich <lb xml:id="p1z21"/>ze hallten.</s>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z22"/>Vale aeternum.</s>
					<s n="14" xml:lang="la" ana="salute">Sa<lb xml:id="p1z23"/>lutant te fratres.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Spero <persName ref="p8417">Muculum</persName> <lb xml:id="p1z24"/>receptum esse <placeName ref="l41">Bernae</placeName> in <lb xml:id="p1z25"/>ministerium <lb xml:id="p1z26"/>ecclesiae; <placeName ref="l41">Bernae</placeName> enim est apud <persName ref="p8018">Hallerum</persName>.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z27"/>Heri ad me scripsit etc.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z28"/>18. <lb xml:id="p1z30"/>Martii 1549.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z31"/>Tuus <persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="19" xml:lang="la">D. <pb/><lb xml:id="p2z1"/><persName ref="p8418">Osvaldo Myconio</persName>, <lb xml:id="p2z2"/>domino et sym<lb xml:id="p2z3"/>mistae charissimo suo.</s>
					<s n="20" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l28">Basel</placeName>.</s>
				</p>
			</div>
