	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p8116">Franciscus Portus</persName> viro... S. P<lb xml:id="p1z2"/>.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/><persName>Leonardus Prunardus</persName>, vir et familiae splendidae et... tisque <lb xml:id="p1z4"/>virtutibus clarus, deducit istuc filium... <lb xml:id="p1z5"/>clesia quasi in altera <placeName ref="l167">Geneva</placeName> instituatur... s<lb xml:id="p1z6"/>it, ut neque mea neque alterius commendatione... n<lb xml:id="p1z7"/>olui nullas ei ad te dare literas, ut saltem aliqu... <lb xml:id="p1z8"/>meae in eum observantiae darem.</s>
					<s n="3" xml:lang="la">Peto igitur abs te..., <lb xml:id="p1z9"/>ut, quando tua singularis humanitas orbi terrarum spe<lb xml:id="p1z10"/>ctatissima est, talem praesertim virum amplectaris et con<lb xml:id="p1z11"/>silio iuves et opera, quae patet omnibus, piis inprimis, et <lb xml:id="p1z12"/>huius viri similibus, qui pietatis ergo plurima perpessus est <lb xml:id="p1z13"/>et adhuc perfert.</s>
					<s n="4" xml:lang="la">Equidem cupio, ut filius eius apud d. <lb xml:id="p1z14"/><persName ref="p8442">Iosiam</persName> vivat potissimum; si fieri non poterit, ut, quaeso, <lb xml:id="p1z15"/>vir clarissime, curabis, ut apud alium virum pium et honestum vivat, <lb xml:id="p1z16"/>et puerum ei commendabis.</s>
					<s n="5" xml:lang="la">Facies profecto beneficium viro <lb xml:id="p1z17"/>gratissimo patri pueri; me autem, qui eum colo, ut quem maxime, <lb xml:id="p1z18"/>filium amo et patris causa et propter singularem eius morum <lb xml:id="p1z19"/>probitatem, ita devinxeris, ut, quicquid ei largitus fueris, id <lb xml:id="p1z20"/>omne mihi tributum sim existimaturus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">De statu rerum <placeName ref="l832">Galli<lb xml:id="p1z21"/>carum</placeName>, <placeName ref="l822">Germanarum</placeName>, nostrarum etiam ex eo, qui diutius in aula <lb xml:id="p1z22"/>fuit et cum rege saepius de causa religionis egit, facile et <lb xml:id="p1z24"/>abunde poteris cognoscere.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Vale, vir clarissime.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z25"/><placeName ref="l167">Genevae</placeName> nonis septembris 1568.</s>
				</p>
