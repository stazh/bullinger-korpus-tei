	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Noli metiri ex tarditate mearum litera
					<lb xml:id="p1z2"/>meum erga te studium viror
					<lb xml:id="p1z3"/>onatissime, sed potius ex voluntate
					<lb xml:id="p1z4"/>meam in te observantiam
					<lb xml:id="p1z5"/>Hunc cum intellige boni a te consuli
					<lb xml:id="p1z6"/>arberror me tibi etiam sino literi
					<lb xml:id="p1z7"/>charum m per arbitrum churitum.
					<lb xml:id="p1z8"/>que omnia ferens nihil
					<lb xml:id="p1z9"/>intepreratur. De Boerha
					<lb xml:id="p1z10"/>cancta serpare deset.
					<lb xml:id="p1z11"/>que ab amico amicas spiruri
					<lb xml:id="p1z12"/>ss de duberit, qui has citera
					<lb xml:id="p1z13"/>reddit, Ioannes Heldius est vir
					<lb xml:id="p1z14"/>doctri aa des pietate omnibus ens
					<lb xml:id="p1z15"/>valde probatios, quem et sid ipsum
					<lb xml:id="p1z16"/>nomini et nostro m commenda
					<lb xml:id="p1z17"/>cum fade non dubito; ale Billi ingere
					<lb xml:id="p1z18"/>vir clurimine et me non quia
					<lb xml:id="p1z19"/>rdius scribo, curduos ama, sed quod
					<lb xml:id="p1z20"/>ex animo tę digertuti optime
					<lb xml:id="p1z21"/>canto ardentus icie tuo a
					<lb xml:id="p1z22"/>complectere, quam seruus
					<lb xml:id="p1z23"/>scribo, notum est eru tibi illud litera
					<lb xml:id="p1z24"/>occidit spritus ditu asterp. Va
					<lb xml:id="p1z25"/>Martus Berhur.
					<lb xml:id="p1z26"/>T mar
					<pb/>
					<lb xml:id="p2z1"/>d. Henrico Bullingero,
					<lb xml:id="p2z2"/>ecclesię
