	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Raras nunc ad te scribo literas, colendissime domine <lb xml:id="p1z2"/>pater et compater, quia nihil fere quam privatas <lb xml:id="p1z3"/>et dometicas calamitates multo iam tempore scribere <lb xml:id="p1z4"/>potuissem.</s>
					<s n="3" xml:lang="la">Abstulit mihi dominus intra paucas <lb xml:id="p1z5"/>septimanas sex charissimos pueros, tres filios et <lb xml:id="p1z6"/>totidem filias; sex mihi reliqui.</s>
					<s n="4" xml:lang="la">Ita ex aequo mecum <lb xml:id="p1z7"/>partitus est, ut agnoscam illius gratiam.</s>
					<s n="5" xml:lang="la">Illius nomen <lb xml:id="p1z8"/>sit benedictum!</s>
					<s n="6" xml:lang="la">Pupugit quidem mihi cor mors <lb xml:id="p1z9"/>illorum; gaudeo tamen illos depugnasse nunc omne <lb xml:id="p1z10"/>malum et aeterno gaudio cum Christo et omnibus electis <lb xml:id="p1z11"/>frui, et paro me pro fidei meae tenuitate, ut <lb xml:id="p1z12"/>illos, cum domino visum fuerit, sequar et illis ibi con<lb xml:id="p1z13"/>iungar, ubi sine omni reciprocatione gaudium erit per<lb xml:id="p1z14"/>petuum.</s>
					<s n="7" xml:lang="la">Hodie d. <persName ref="p2919">Michaelis Schlatteri</persName> pię memorię <lb xml:id="p1z15"/>filius alter Michael, marsup(i?) arius<note xml:id="fn1" type="footnote" n="1">Säckler, Säckelmacher o.ä.</note>, obiit; alias neminem <lb xml:id="p1z16"/>scio, qui nunc decumbat.</s>
					<s n="8" xml:lang="la">Obiit etiam his diebus <persName>Magda<lb xml:id="p1z17"/>lena Göldlia</persName>, uxoris fratris mei soror, quę hic apud <lb xml:id="p1z18"/>nos ministro cuidam <persName>Iohanni Placentario</persName> nupta fuerat.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/>Ex <placeName ref="l882">Ungaria</placeName> iam pridem nihil audiveramus, nisi quae <lb xml:id="p1z20"/>abs te hodie et a senatu vestro his diebus noster <lb xml:id="p1z21"/>accepit.</s>
					<s n="10" xml:lang="la">Ego metuo valde ecclesiis <placeName ref="l808">Belgicis</placeName>; utinam <lb xml:id="p1z22"/>illis deus<foreign xml:lang="el">ὥσπερ ἀπὸ μηχανῆς</foreign> appareat!</s>
					<s n="11" xml:lang="la">Quod ut <lb xml:id="p1z23"/>faciat, illum sedulo orabimus.</s>
					<s n="12" xml:lang="la">Ex <placeName ref="l167">Geneva</placeName> etiam iam <lb xml:id="p1z24"/>diu nihil habeo.</s>
					<s n="13" xml:lang="la"><placeName ref="l280">Lausannę</placeName> etiam pestis ingruit; metuo <lb xml:id="p1z25"/>valde meo <persName>Blasio</persName>.</s>
					<s n="14" xml:lang="la">Dominus illum conservet!</s>
					<s n="15" xml:lang="la">Alias non <lb xml:id="p1z26"/>habeo, quod scribam.</s>
					<s n="16" xml:lang="la" ana="salute">Salutant te omnes nostri, prae<lb xml:id="p1z27"/>sertim d. <persName ref="p8063">Steigerus</persName>, qui per oeconomum <placeName ref="l269">Küngßfeldensem</placeName> <lb xml:id="p1z28"/>denuo tibi mittit de vino suo et te valde salutat <lb xml:id="p1z29"/>una cum <persName ref="p21414">Zehenderis</persName>, quorum <persName ref="p4060">Ludovicus</persName> iunior, cui <lb xml:id="p1z30"/>uxor nuper obiit, hodie nuptias celebrat cum altera <lb xml:id="p1z31"/>quadam, <placeName ref="l760">Solodorensi</placeName> divite vidua, quę prius <persName ref="p21415">Sebastiano Su<lb xml:id="p1z32"/>mmcrero</persName> [Summerero?], praefecto in <placeName>Suͦmißwald</placeName> nupta <lb xml:id="p1z33"/>fuerat.</s>
					<s n="17" xml:lang="la">Socer etiam meus tibi plurimum salutis adscribit.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z34"/><placeName ref="l41">Bernae</placeName> 14. decembris 1566.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z35"/><persName ref="p8018">Iohannes Hallerus</persName>, <lb xml:id="p1z36"/>tuus, ut nosti.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Bul<lb xml:id="p2z2"/>lingero</persName>, domino et <lb xml:id="p2z3"/>compatri meo colendis<lb xml:id="p2z4"/>simo.</s>
					<s n="21" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
