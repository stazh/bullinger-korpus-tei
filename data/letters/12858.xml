	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Malluissem equidem coram agere apud te quam literis rursus <lb xml:id="p1z2"/>te molestare alioqui satis occupatum, sed mittendae fuerunt hae literae <lb xml:id="p1z3"/>ad <persName ref="p2336">Bernardinum</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p2336">Ochino</persName>.</note>, quas, ut ipse mittas primo nuncio, magnopere oro.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Ego proficiscar ad vos intra dies tres aut quatuor, ubi coram agemus <lb xml:id="p1z5"/>de rebus omnibus copiosius.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="4" xml:lang="la">Interim si quae literae ad me venerint vel ex <lb xml:id="p1z6"/><placeName ref="l28">Basilea</placeName> vel aliunde, eas apud te retinebis, donec ego veniam.</s>
					<s n="5" xml:lang="la">Idem significabis <lb xml:id="p1z7"/><persName ref="p1214">Frisio</persName><note xml:id="fn3" type="footnote" n="3"><persName ref="p1214">Johannes Fries</persName>.</note>.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="6" xml:lang="la" ana="salute">Saluta meis verbis omnes fratres, quos brevi <lb xml:id="p1z8"/>deo volente videbo.</s>
					<s n="7" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><placeName ref="l473">Sangalli</placeName>, 12. februarii 1547.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z9"/>Tuus <persName ref="p8032">Franciscus Dryander</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>.</s>
					<s n="11" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
