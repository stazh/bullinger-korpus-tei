	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Optime frater.</s>
					<s n="3" xml:lang="la"><persName ref="p495">Henricum</persName> tuum nuper vidi, <lb xml:id="p1z2"/>qui valde bene habet.</s>
					<s n="4" xml:lang="la">Hortatus sum ad pie<lb xml:id="p1z3"/>tatem et studia, et libenter audivit.</s>
					<s n="5" xml:lang="la">Ego <lb xml:id="p1z4"/>hic fere mensem subsistam et saepe agam <lb xml:id="p1z5"/>cum eo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Ex patria mea audio inva<lb xml:id="p1z6"/>luisse pestem ita, ut cotidie 30; repet<lb xml:id="p1z7"/>it poenas deus neglecti evangelii.</s>
					<s n="7" xml:lang="la">Oro <lb xml:id="p1z8"/>te, mitte has inclusas ad hospitem Ciconiae; <lb xml:id="p1z9"/>tantum da puero ferendas; ulterius <lb xml:id="p1z10"/>enim non te amplius urgeo, sat olim ursi.</s>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z11"/>Vale et salve cum omnibus fratribus.</s>
					<s n="9" xml:lang="la">Iuvate <lb xml:id="p1z12"/>me vestris precibus apud d. deum nostrum, <lb xml:id="p1z13"/>quod rogo ex animo.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z14"/><placeName ref="l491">Argentorati</placeName> 15. octobris 1554.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z15"/><persName ref="p3375">Vergerius</persName><lb xml:id="p1z16"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
