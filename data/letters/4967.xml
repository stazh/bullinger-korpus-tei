	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Accepi tuas, chare frater omnes
					<lb xml:id="p1z2"/>singulas, etiam illas, pro quibus te inteliaru
					<lb xml:id="p1z3"/>solicitum, quas per fiduum quempiam
					<lb xml:id="p1z4"/>miseratis ragatium. Intellexi omnia et
					<lb xml:id="p1z5"/>oro dominum, ut omnia per misericordiam
					<lb xml:id="p1z6"/>et potentiam suam bene vertat et consi
					<lb xml:id="p1z7"/>iliaadversariorum infringat. Quod inde
					<lb xml:id="p1z8"/>fessio precibus postulare a domino non d
					<lb xml:id="p1z9"/>sinemus. Hoc tamen inter alia vidi, si res
					<lb xml:id="p1z10"/>od deus aver
					<lb xml:id="p1z11"/>in Rhetia secus quam commodum sit
					<lb xml:id="p1z12"/>totam mali huius pasm in Tiguric
					<lb xml:id="p1z13"/>transferendam. Miseres nos, qui vexamur
					<lb xml:id="p1z14"/>mosere ab hostibus et petimur prae aliis
					<lb xml:id="p1z15"/>amici vero omnia malae, quae ubique exixiunt
					<lb xml:id="p1z16"/>vos exonerant. Interim agnosco nos
					<lb xml:id="p1z17"/>esse peccatores et quosdam ex nostris ita facere
					<lb xml:id="p1z18"/>ut aliis in locis alii plurimi faciunt
					<lb xml:id="p1z19"/>mihi et
					<lb xml:id="p1z20"/>Ideo suadeo tibi, imo non tibi soli, sed ps
					<lb xml:id="p1z21"/>omnibus, ut omnem spem in deum ponant,
					<lb xml:id="p1z22"/>maledictioni obnoxii fiant, ponentes
					<lb xml:id="p1z23"/>.
					<lb xml:id="p1z24"/>brachium sui. Ego certe deo gra
					<lb xml:id="p1z25"/>rdiutina experientia doctus et vexatus, did
					<lb xml:id="p1z26"/>acquioscere in solo deo, quia vana
					<lb xml:id="p1z27"/>salus hominis. Ergo dum facio fideliter
					<lb xml:id="p1z28"/>(quantum dominus gratiae dederit), quod possum, in
					<lb xml:id="p1z29"/>ourgeo et hortor etc. quod reliquem est.
					<lb xml:id="p1z30"/>deo commendo, quanquam et hoc quod movet
					<lb xml:id="p1z31"/>sedulo deo attribuendum est. Habes hic
					<lb xml:id="p1z32"/>forma, quomodo id quod multis proposuisti, in bre
					<lb xml:id="p1z33"/>summm collegerim et magistratui traci
					<lb xml:id="p1z34"/>id est depitatis, quos scis. Urgeo eos
					<lb xml:id="p1z35"/>interim. Hisce diebus consultabitur etc. Exhib
					<lb xml:id="p1z36"/>haec legendae d. consule, uti omnia verit exacte.
					<lb xml:id="p1z37"/>möchte fast wol lyden, das er ettwn selbs ei
					<lb xml:id="p1z38"/>kurtzes brieffti h Müllern geschriben,
					<lb xml:id="p1z39"/>ye ee ye lieber etc. Volui et nostra opera
					<lb xml:id="p1z40"/>cingulariter conferre et formani aliquid ut
					<lb xml:id="p1z41"/>responsum. Haec scripta tuto ad me rem
					<lb xml:id="p1z42"/>et valebis. Multa sunt, quae ne
					<lb xml:id="p1z43"/>1561.
					<lb xml:id="p1z44"/>T.
					<lb xml:id="p1z45"/>ogunt.
					<lb xml:id="p1z46"/>esse
					<pb/>
					<lb xml:id="p2z1"/>a
					<lb xml:id="p2z2"/>Praestantissimo viro d. Ion
					<lb xml:id="p2z3"/>fabritio curi.
					<lb xml:id="p2z4"/>ecclesiae ministro
					<lb xml:id="p2z5"/>fideli, domino colendismo
					<lb xml:id="p2z6"/>et fratri charissimo suo
					<lb xml:id="p2z7"/>Chur.
				</p>
