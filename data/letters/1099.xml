	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Cuius me literę medullitus exhilarant, amice incomparabilis, tu, <lb xml:id="p1z2"/>mihi crede, precipuus es.</s>
					<s n="3" xml:lang="la">Percepi non ita longo intervallo ternas <lb xml:id="p1z3"/>ex te maxima profecto voluptate; dolui autem quasdam antea ad <lb xml:id="p1z4"/>me datas aut interiisse aut interceptas esse.</s>
					<s n="4" xml:lang="la">Respondi ad proxim<lb xml:id="p1z5"/>as brevissime sperans te coram illico me visurum, id quod et <lb xml:id="p1z6"/>iam nunc factum esset, nisi aeris inclementia tum et asperum iter <lb xml:id="p1z7"/>obstitisset; differenda igitur peregrinatio mea erit usque ad proximum <lb xml:id="p1z8"/>ver.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Interim cogitabis, amabo, quomodo frater tuus <lb xml:id="p1z9"/>cum uxore et prole reliquum vitę instituat.</s>
					<s n="6" xml:lang="la">Hic non solum in periculo, <lb xml:id="p1z10"/>sed etiam in sordibus vivere mihi videor, quamquam dominus ab insidiis <lb xml:id="p1z11"/>multorum me hactenus servavit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Quid autem cum piis futurum <lb xml:id="p1z12"/>sit (humano more loquor) nescitur; scimus autem hoc sęculum <lb xml:id="p1z13"/>minitari multas turbas.</s>
					<s n="8" xml:lang="la"><placeName ref="l303">Magdeburgenses</placeName> Interimicę constitutioni <lb xml:id="p1z14"/>nondum subscribunt.</s>
					<s n="9" xml:lang="la"><persName ref="p18250">Dux Mauricius Saxo</persName> est quid grande contra <lb xml:id="p1z15"/>eos conatus, sed re infecta, ut audio, ab obsidione destitit.</s>
					<s n="10" xml:lang="la" ana="salute">Tu <lb xml:id="p1z16"/>vale in aurea libertate cum preclarissimis fratribus, quibus singulis <lb xml:id="p1z17"/>salutem ex me efflictim dices.</s>
					<s n="11" xml:lang="de">Ex <placeName ref="l245">Kauffburna</placeName> 4. decembris <lb xml:id="p1z18"/>1550.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z19"/>Scire aveo, ut valeant domini consules, <lb xml:id="p1z20"/>ut <persName ref="p8498">Theodorius</persName> in arundine et an <lb xml:id="p1z21"/><persName ref="p2916">Schertlerus</persName> adhuc <placeName ref="l28">Basileae</placeName> hereat.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Tuus <persName ref="p8354">G[eorgius] L[<lb xml:id="p1z22"/>aetus</persName>].</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z23"/><placeName ref="l18">Augustę</placeName> comicia celebrantur perpetua; <lb xml:id="p1z24"/>nemo autem ordinum imperii novit, quis <lb xml:id="p1z25"/>tandem finis talium rerum erit.</s>
					<s n="15" xml:lang="la">Dicunt <lb xml:id="p1z26"/>quidam nobis propediem plures nascituros <lb xml:id="p1z27"/>reges, imperatorem <persName ref="p18538">Carolum</persName> diadema fratri <lb xml:id="p1z28"/><persName ref="p18477">Ferdinando</persName> cessurum, <persName ref="p18575">Philippum</persName> autem, principem <lb xml:id="p1z29"/><placeName ref="l875">Hispaniarum</placeName>, in regem <placeName ref="l425">Romanum</placeName> coronandum.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z30"/>Reliqua ostendunt belli faciem.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><pb/><lb xml:id="p2z1"/>Preclarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>antistiti <placeName ref="l587">Tigur[in]o</placeName> spectabili.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>