	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Mitto tibi <persName ref="p8417">Musculi</persName> commentaria in 7 capita evangelii <lb xml:id="p1z2"/>Ioannis<note xml:id="fn1" type="footnote" n="1">Zu <persName ref="p8417">Wolfgang Musculus</persName>' Schrift s. oben <ref target="file12249">Nr. 2202</ref>, Anm. 24. <persName ref="p1278">Gast</persName> hatte <persName ref="p495">Bullinger</persName> u.a. diesen Kommentar angekündigt und angeboten; s. oben <ref target="file12300">Nr. 2253</ref>, 23. 28. -Die Fortsetzung erschien erst 1548.</note>, reliqua, si excusa fuerint, etiam additurus, ne ingra<lb xml:id="p1z3"/>tus erga tua beneficia mihi<note xml:id="fna" type="footnote" n="a">mihi <hi>über der Zeile nachgetragen.</hi></note> exhibita<note xml:id="fn2" type="footnote" n="2">Buchgeschenke <persName ref="p495">Bullingers</persName> an <persName ref="p1278">Gast</persName>; s. oben <ref target="file12275">Nr. 2228</ref>, 33f; 2239, 2-7.</note> videar.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Caeterum hoc tibi significa<lb xml:id="p1z4"/>re volo: <persName ref="p1888">Consulis</persName> vestri <persName ref="p1884">filium</persName><note xml:id="fn3" type="footnote" ana="bio" n="3"><persName ref="p1884">Ludwig Lavater</persName>, Sohn des <placeName ref="l587">Zürcher</placeName> Bürgermeisters <persName ref="p1888">Hans Rudolf Lavater</persName>.</note> non vidi; sub crepusculum literas, <lb xml:id="p1z5"/>quum domi non essem, dedit tuas<note xml:id="fn4" type="footnote" n="4">Nicht erhalten.</note>.</s>
					<s n="4" xml:lang="la">Crastina die in publicis hospitiis <lb xml:id="p1z6"/>eum quęsieram, sed non potui invenire hominem.</s>
					<s n="5" xml:lang="la">Post tertium diem <lb xml:id="p1z7"/>intellexi ipsum summo mane abiisse <placeName ref="l491">Argentinam</placeName>.<pb type="edition" next="593"/></s>
				</p>
				<p>
					<s n="6" xml:lang="la"><persName ref="p20318">Incendiarius</persName><note xml:id="fn5" type="footnote" n="5">Herzog <persName ref="p20318">Heinrich d.J. von Braunschweig-Wolfenbüttel</persName>.</note> habet <lb xml:id="p1z8"/>exercitum bene instructum; dicunt habere 12000 pedites et <lb xml:id="p1z9"/>equites 1400.</s>
					<s n="7" xml:lang="la">Incendit passim villas et oppidula.</s>
					<s n="8" xml:lang="la"><persName ref="p3590">Hessum</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p3590">Philipp von Hessen</persName>.</note> <lb xml:id="p1z10"/>conatur omnino perdere.</s>
					<s n="9" xml:lang="la"><persName ref="p18538">Caesar</persName><note xml:id="fn7" type="footnote" n="7"><persName ref="p18538">Karl V.</persName></note> spectatorem agit huius tragędiae.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z11"/><persName ref="p20531">Episcopus</persName> <placeName ref="l307">Moguntinus</placeName> obiit<note xml:id="fn8" type="footnote" n="8"><persName ref="p20531">Albrecht V. von Brandenburg</persName>, Kurfürst von <placeName ref="l307">Mainz</placeName>, war am 24. September 1545 gestorben.</note>, et canonici certant inter se <lb xml:id="p1z12"/>de eligendo <persName ref="p7548">episcopo</persName><note xml:id="fn9" type="footnote" n="9">Nachfolger wurde <persName ref="p7548">Sebastian von Heusenstamm</persName>.</note>.</s>
					<s n="11" xml:lang="la"><persName ref="p18538">Caesar</persName> aliquid molitur cum isto episcopatu<lb xml:id="p1z13"/>.</s>
					<s n="12" xml:lang="la">Certiora si audiero, scribam, et brevi habebimus <lb xml:id="p1z14"/>totum huius rei negotium tribuno<note xml:id="fn10" type="footnote" n="10">Nicht ermittelt.</note> plebi nostro ab <placeName ref="l491">Argentina</placeName> revers<lb xml:id="p1z15"/>o.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z16"/>Vale in domino.</s>
					<s n="14" xml:lang="la"><placeName ref="l28">Basileę</placeName>, 1545, <lb xml:id="p1z17"/>17. octobris.</s>
					<s n="15" xml:lang="la">Tuus <persName ref="p1278">Gastius</persName> <lb xml:id="p1z18"/>raptim.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="16" xml:lang="la"><pb/><lb xml:id="p2z1"/>Insigni theologo d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z4"/>pastori vigilantissimo, <lb xml:id="p2z5"/>fratri suo charissimo.</s>
					<s n="17" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
