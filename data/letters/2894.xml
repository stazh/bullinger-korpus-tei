	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p714">C[oelius] S[ecundus] C[urio]</persName> per Christum Iesum S. P. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Accepi cum literis librum, quem mihi dono misisti, <lb xml:id="p1z3"/>amicissime et colendissime <persName ref="p495">Bullingere</persName>, utrumque mihi tanto <lb xml:id="p1z4"/>intervallo gratissimum munus; nam et literis tuis <lb xml:id="p1z5"/>vehementer recreor et libris indier eruditior <lb xml:id="p1z6"/>atque ad pietatem instructior fio.</s>
					<s n="3" xml:lang="la">Quare pro <lb xml:id="p1z7"/>utroque munere mihi longe gratissimo ac iucun<lb xml:id="p1z8"/>dissimo gratias ago quam possum maximas.</s>
					<s n="4" xml:lang="la" ana="salute">De filio <lb xml:id="p1z9"/>meo, qui te salutavit, recte censes; nam ipsi, <lb xml:id="p1z10"/>ut te reverenter meo nomine salutaret, quod tunc <lb xml:id="p1z11"/>occupationibus scribere non poteram, diligenter mandavi.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z12"/>De beneficio, quod scribis te nullo eum <lb xml:id="p1z13"/>affecisse, maximo eum beneficio affecisti, si ei abeunt<lb xml:id="p1z14"/>i salutaria, ut soles, monita dedisti.</s>
					<s n="6" xml:lang="la">Haec enim <lb xml:id="p1z15"/>ad illas divitias illasque opes, quae nonquam interire <lb xml:id="p1z16"/>possunt, referenda sunt.</s>
					<s n="7" xml:lang="la">Quare nihil est, <lb xml:id="p1z17"/>quod te hic peccasse dicas, qui beneficium vel <lb xml:id="p1z18"/>maximum contuleris amoris erga nos tui.</s>
					<s n="8" xml:lang="la" ana="farewell"><lb xml:id="p1z19"/>Vale, mi colendissime frater, et me in numero eo <lb xml:id="p1z20"/>habeto, quo me ante annos et deinceps 12 <lb xml:id="p1z21"/>habuisti.</s>
					<s n="9" xml:lang="la" ana="salute">Salutant te voxor, liberi, gener, <lb xml:id="p1z22"/>qui hac filiam meam post annum morbum ad <lb xml:id="p1z23"/>Thermas ducit <placeName ref="l862">Helvetias</placeName>.</s>
					<s n="10" xml:lang="la" ana="salute">Saluta uxorem cum <lb xml:id="p1z24"/>dulcissimis liberis, gener, quo domi habes, et propinquis <lb xml:id="p1z25"/>et amicis.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><placeName ref="l28">Basileę</placeName> 17. calendas maii 1556.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro domino <lb xml:id="p2z2"/><persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z3"/>[eccl]esiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>[anti]stiti vigilantissimo, domino <lb xml:id="p2z5"/>et fratri colendissimo.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
