	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Novi hic nihil est nisi <persName ref="p21399">Rizzium</persName> discedere iratiorem, <lb xml:id="p1z2"/>quod, quae volebat, non perfecerit.</s>
					<s n="3" xml:lang="la">Audio marchionem in <lb xml:id="p1z3"/>aliquas terras concessisse, ut vires reparet.</s>
					<s n="4" xml:lang="la">De triumphis <lb xml:id="p1z4"/>Caesarianorum quod scribis, audio libenter, ut vos omnes <lb xml:id="p1z5"/>intelligatis, quid in animo habeant; et non prudentia <lb xml:id="p1z6"/>Caesaris, sed casu mirabili haec eis spes affulxit, quam <lb xml:id="p1z7"/>video in dies minorem fieri.</s>
					<s n="5" xml:lang="la">Potest et numen spiritus <lb xml:id="p1z8"/>illos parvulo lapsu infringere.</s>
					<s n="6" xml:lang="la">De excusatione tua nihil <lb xml:id="p1z9"/>addo, tantum me neque excanduisse neque unquam commotum <lb xml:id="p1z10"/>iri, si tu vel alius falso sibi aliquid de me persuaserit <lb xml:id="p1z11"/>aut se mihi praeponat suaque sola pulchra esse putet.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Illud hominis est vitium, quod vix magna prudentia <lb xml:id="p1z13"/>vel minimum corrigi possit.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Ut dominus dixit sufficere <lb xml:id="p1z14"/>suam cuique diei molestiam, satis est me onus meum <lb xml:id="p1z15"/>portare neque valde sollicitum esse, quid exterius accidat.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>Tibi, si qua in re possim, videbis, quam prodesse et <lb xml:id="p1z17"/>inservire cupiam eruditionis et pietatis tuae merito, quae <lb xml:id="p1z18"/>se minime fucatam aut <placeName>Suffenicam</placeName> exhibet.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="farewell">Vale.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z19"/><placeName ref="l98">Curiae</placeName>, 12. ianuarii.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Nolo <lb xml:id="p1z20"/>te ignorare <persName ref="p21399">Rizzium</persName> obtulisse 10a.</s>
					<s n="13" xml:lang="la">huius mensis <lb xml:id="p1z21"/>amarulentissimam responsionem ad ea, <lb xml:id="p1z22"/>quae illi dd.</s>
					<s n="14" xml:lang="la"><placeName>Rhaetorum</placeName> nomine dicta fuerant, <lb xml:id="p1z23"/>atque eam scriptam <persName ref="p8359">Gallitii</persName> tui manu.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Vertumni id e<lb xml:id="p1z24"/>sse an <persName>Mercurii</persName> dicas?</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Tuus <persName ref="p8332">Ioh[annes] Frax[ineus]</persName>, ep[<lb xml:id="p1z25"/>iscopus] <placeName ref="l1206">Bayo[nensis]</placeName>.</s>
				</p>
