	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Ex tuis scriptis<note xml:id="fn1" type="footnote" n="1">Nicht erhalten.</note>, facundiss[ime] <persName ref="p495">Bullingere</persName>, colligo litera[s]<note xml:id="fna" type="footnote" n="a"><hi>Randtext im engen Einband verdeckt.</hi></note> <lb xml:id="p1z3"/>meas ad te datas<note xml:id="fn2" type="footnote" n="2">Nicht erhalten.</note> intercidisse, quod licet me turbarit; <lb xml:id="p1z4"/>nihil tamen vereor, ut qui dictis scriptisque constem, <lb xml:id="p1z5"/>cuiuscunque in manus perveniant.</s>
					<s n="3" xml:lang="la">Ornatissime mi <persName ref="p495">Bul[ling]ere</persName><note xml:id="fnb" type="footnote" n="b"><hi>Randtext im engen Einband verdeckt; Endung</hi> - ere <hi>gestrichen und wiederholt.</hi></note>, <lb xml:id="p1z6"/>animo tuo prorsus exemptum volo, quod ulla <lb xml:id="p1z7"/>parte me unquam offenderis; quid enim a tam candido <lb xml:id="p1z8"/>pectore proficisci queat, quod mihi<note xml:id="fnc" type="footnote" n="c"><hi>Vor</hi> mihi <hi>gestrichenes</hi> non.</note> non gratissimum <lb xml:id="p1z9"/>existeret?</s>
					<s n="4" xml:lang="la">Cui etiam non modo mea universa, verum <lb xml:id="p1z10"/>etiam meipsum totum debeo, ut totus, quantus sum, in tuo <lb xml:id="p1z11"/>sim ęre neque solvendo unquam futurus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Legi etiam <lb xml:id="p1z12"/><persName ref="p2095">Melanch[thonis]</persName> epistolam<note xml:id="fn3" type="footnote" n="3"><persName ref="p2095">Melanchthon</persName> an <persName ref="p495">Bullinger</persName>, 31. August 1544 (oben <ref target="file12013">Nr. 1966</ref>).</note>, quę me summo perfudit gaudio, <lb xml:id="p1z13"/>quod sperem aliquando fore, ut melius quidam sentiant <lb xml:id="p1z14"/>atque rabies omnis tollatur.<pb type="edition" next="409"/></s>
				</p>
				<p>
					<s n="6" xml:lang="la">Hic omnia sunt turbata; <lb xml:id="p1z15"/>quicquid senatus statuat vel antea statuerit, omnia <lb xml:id="p1z16"/>quidam<note xml:id="fn4" type="footnote" n="4">Die Rede ist von den Anhängern <persName ref="p467">Bucers</persName>.</note> rescindere, si modo possint, moliuntur, <lb xml:id="p1z17"/>ut non vereantur ad sua stabilienda horribiles introducer<lb xml:id="p1z18"/>e hęreses, idque<note xml:id="fnd" type="footnote" n="d"><hi>Von</hi> idque <hi>bis</hi> student <hi>am Rande nachgetragen.</hi></note> faciunt praetextu verbi dei.</s>
					<s n="7" xml:lang="la">Neque decretis obstringi volunt neque iuramentis; his se eximere stu<lb xml:id="p1z19"/>dent<note xml:id="fne" type="footnote" n="e"><hi>Von</hi> idque <hi>bis</hi> student <hi>am Rande nachgetragen.</hi></note>.</s>
					<s n="8" xml:lang="la">Periit omnis pudor apud illos<note xml:id="fnf" type="footnote" n="f"><hi>Vor</hi> illos <hi>gestrichenes</hi> eos.</note>, et perfricuere frontem<note xml:id="fn5" type="footnote" n="5">perfricare frontem: frech, unverschämt sein; s. <persName ref="p18301">Petrus Apherdian (Pieter van Afferden)</persName>, "Tyrocinium Latinae linguae", <placeName ref="l267">Köln</placeName>, <persName ref="p19337">Johann Gymnich [II.]</persName>, 1575 <bibl source="https://gateway-bayern.de/VD16+A+585">(VD 16 A 585)</bibl>, f. A7r.</note> perrumpere conantes, confisi<lb xml:id="p1z20"/>, quod indigenę, aliaque carnis fiducia fulciuntur.</s>
					<s n="9" xml:lang="la">Consultan[t]<note xml:id="fng" type="footnote" n="g"><hi>Randtext im engen Einband verdeckt.</hi></note> <lb xml:id="p1z21"/>cum <persName ref="p467">Bucero</persName>, quem huc vellent<note xml:id="fnh" type="footnote" n="h"><hi>Vor</hi> vellent <hi>gestrichenes</hi> traducere[?].</note> vocatum <lb xml:id="p1z22"/>ad pacandas contentiones, si non resisteremus.</s>
					<s n="10" xml:lang="la">Sunt <lb xml:id="p1z23"/>apud nos duę magne partes; contagio Buceriana maio[rem]<note xml:id="fni" type="footnote" n="i"><hi>Randtext im engen Einband verdeckt.</hi></note> <lb xml:id="p1z24"/>partem magnatum infecit, timore duntaxat arcent[ur]<note xml:id="fnk" type="footnote" n="k"><hi>Randtext im engen Einband verdeckt.</hi></note> <lb xml:id="p1z25"/>plebis, ne palam <persName ref="p467">Bucero</persName> accedant.</s>
					<s n="11" xml:lang="la">Precemur dominum, <lb xml:id="p1z26"/>ut veritati suę adesse dignetur.</s>
					<s n="12" xml:lang="la">Quod ad me attinet, <lb xml:id="p1z27"/>intrepidans sum, etiamsi me abactum vellent etc.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z28"/>Remitto tibi exemplar<note xml:id="fn6" type="footnote" n="6">des <persName ref="p2095">Melanchthon</persName>-Briefes.</note>, quod nemo nec ego etiam <lb xml:id="p1z29"/>rescripsi<note xml:id="fnl" type="footnote" n="l">rescripsi <hi>korrigiert aus</hi> scripsi.</note>; nihil ergo metuas, bona fide literis et conditio<lb xml:id="p1z30"/>nibus tuis obsequutus sum.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Statui ego conditionem <lb xml:id="p1z31"/>meam mutare;<note xml:id="fn7" type="footnote" n="7">Vgl. unten <ref target="file12064">Nr. 2017</ref> mit Anm. 14.</note> tibi tamen prius significabo, nihil <lb xml:id="p1z32"/>etiam te inconsulto attentabo etc.</s>
					<s n="15" xml:lang="la">Iam scriberem, si esset <lb xml:id="p1z33"/>otium; nuncius<note xml:id="fn8" type="footnote" n="8">Unbekannt.</note> festinat abitum.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Dolet me non <lb xml:id="p1z34"/>domi fuisse, cum adesset <persName ref="p3067">Stumpfius</persName>,<note xml:id="fn9" type="footnote" ana="bio" n="9">Am 6./7. September; s. Ein Reisebericht des Chronisten <persName ref="p3067">Johannes Stumpf</persName> aus dem Jahr 1544, hg. v. Hermann Escher in: <bibl source="b521">QSG</bibl> VI 231-310, bes. 284. 287. Zur Schweizerreise <persName ref="p3067">Stumpfs</persName> s. auch oben <ref target="file12007">Nr. 1960</ref> sowie Gerold <hi>Meyer von Knonau,</hi> Eine Schweizerreise eines Gelehrten im XVI. Jahrhundert, in: Jahrbuch des Schweizer Alpenclub 19, 1883-1884, S. 417-457.</note> cui operam meam <lb xml:id="p1z35"/>elargitus fuissem, si modo intellexissem, quo pacto <lb xml:id="p1z36"/>commodare illi potuissem.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Conduxissem<note xml:id="fnm" type="footnote" n="m"><hi>Von</hi> Conduxissem <hi>bis</hi> adiunxissem <hi>am Rande nachgetragen.</hi></note> quoque illum meque illi comitem in profectionibus adiunxissem<note xml:id="fnn" type="footnote" n="n"><hi>Von</hi> Conduxissem <hi>bis</hi> adiunxissem <hi>am Rande nachgetragen.</hi></note>.</s>
					<s n="18" xml:lang="la">Nihil tuo no<lb xml:id="p1z37"/>mine detrectabo, cui me totum mancipo.</s>
					<s n="19" xml:lang="la">Precor, si tuus ferat animus, <lb xml:id="p1z38"/>ut in symbola<note xml:id="fn10" type="footnote" n="10">Hier vermutlich die Zeichen von Brot und Wein im Abendmahl; s. oben <ref target="file12027">Nr. 1980</ref>, 37-39; unten 2031, 7. 17. 22. 31; ferner <persName ref="p3700">Rümlang</persName> selbst unten 2055, 8.</note> scribere digneris.</s>
					<s n="20" xml:lang="la">Ego veneror et admir[or]<note xml:id="fno" type="footnote" n="o"><hi>Randtext im engen Einband verdeckt.</hi></note> <lb xml:id="p1z39"/>tuam copiam, moderationem, et quod quęque appositissime coheren[t]<note xml:id="fnp" type="footnote" n="p"><hi>Randtext im engen Einband verdeckt.</hi></note>.</s>
					<s n="21" xml:lang="la"><lb xml:id="p1z40"/>Haberes materiam exuberantem hęreses repullulantes ret<lb xml:id="p1z41"/>undendi.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Boni consule, quaeso.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Datum <placeName ref="l41">Bernę</placeName>, 18. septembris anno <lb xml:id="p1z42"/>1544.</s>
				</p>
				<p>
					<s n="24" xml:lang="la">Tuus <persName ref="p3700">Eb. a Rumlang</persName><lb xml:id="p1z43"/>.<pb type="edition" next="410"/></s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo, fidelissimo <lb xml:id="p2z2"/>ac integerrimo viro <lb xml:id="p2z3"/>d. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z4"/>ecclesiastę <placeName ref="l587">Tigurino</placeName> <lb xml:id="p2z5"/>primario, domino <lb xml:id="p2z6"/>suo semper observando<lb xml:id="p2z7"/>.</s>
				</p>
