				<p>
					<lb xml:id="p1z1"/>Capita proposita ab illustrissimo
					<lb xml:id="p1z2"/>1514.
					<lb xml:id="p1z3"/>principe elector Palatino
					<lb xml:id="p1z4"/>mense decembris 1566.
					<lb xml:id="p1z5"/>Bullingero
					<lb xml:id="p1z6"/>rimum congratulatio ad imperatorem ex et demond
					<lb xml:id="p1z7"/>stratiorationis, qua amittantur et rursus retineantur
					<lb xml:id="p1z8"/>imperia
					<lb xml:id="p1z9"/>ommendatio instituti, quo imperator dissidia tollere
					<lb xml:id="p1z10"/>et concordiam restituere conatur.
					<lb xml:id="p1z11"/>Fructus huius instituti, si in timore domini vexita normam
					<lb xml:id="p1z12"/>in ipsius verbo praescriptam ad effectum perducatur.
					<lb xml:id="p1z13"/>Tontes omnium haeresem esse ignorationem deprava
					<lb xml:id="p1z14"/>reiectionem verbi dei e ambitionem cum
					<lb xml:id="p1z15"/>tanto iam tempore tot errorum et blasphemiarum
					<lb xml:id="p1z16"/>ecclesia Romana rea peracta ac convucta sit, ab illa
					<lb xml:id="p1z17"/>faciendum exordium. Frustra enim errorum
					<lb xml:id="p1z18"/>rilos extinguere conari, qui scaturiginem non
					<lb xml:id="p1z19"/>observant.
					<lb xml:id="p1z20"/>Brevis deductio et explicatio errorum secundum species
					<lb xml:id="p1z21"/>Et quoniam exhis fontibus tum anabastistarum tum
					<lb xml:id="p1z22"/>aliorum tum alii nostrorum temporum errores man
					<lb xml:id="p1z23"/>atque etiam manent. Rationem tollendi
					<lb xml:id="p1z24"/>haereses hanc esse.
					<lb xml:id="p1z25"/>Primo ut caesarea maiestas et principes omnes principum
					<lb xml:id="p1z26"/>toan manifestos et omnibus notos abuscis.
					<lb xml:id="p1z27"/>Secundo ut doctrinam ex verbi dei fontibus repurgatam
					<lb xml:id="p1z28"/>annuntiari curent et non pro arbitrio eam incurvent
					<lb xml:id="p1z29"/>et inflectant, ut in Interim factum videmus
					<lb xml:id="p1z30"/>Tertio ne quis indicta causa, qui alioquin audiri cupit,
					<lb xml:id="p1z31"/>condemnetur.
					<lb xml:id="p1z32"/>Quarto, quae olim fuerit diiudicandarum controversae,
					<lb xml:id="p1z33"/>usigrum et confutandarum haereseon in ecclesia ratio
					<lb xml:id="p1z34"/>et quod initium non ab e xecutione et condemnatione
					<lb xml:id="p1z35"/>sed cognitione sumptum sit.
					<pb/>
					<lb xml:id="p2z1"/>QuintoLiberum concilium cum exteris nationibus in
					<lb xml:id="p2z2"/>qo praesideat scriptura prophetica et apostolica instituendium
					<lb xml:id="p2z3"/>esse, ubi papa, ut reus se suosque initio purget ac defensa,
					<lb xml:id="p2z4"/>dat
					<lb xml:id="p2z5"/>Adhibeatur etiam fidei brevis et distincta ac perspicua
					<lb xml:id="p2z6"/>confessio cum antithesi et declaretur consensus tot regnor,
					<lb xml:id="p2z7"/>et provinciarum adiuncta obtestatione, ne tot ecclesiarum
					<lb xml:id="p2z8"/>confessio illis non vocatis damnetur.
					<lb xml:id="p2z9"/>Denique admoneatur Caesar et status, ne vel silentio vel
					<lb xml:id="p2z10"/>dissimulatione vel etiam condemnatione se participer
					<lb xml:id="p2z11"/>faciant, innodei sanguinis, qui in papatu etiamnum eru
					<lb xml:id="p2z12"/>idelissime effunditur.
					<pb/>
