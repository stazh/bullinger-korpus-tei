	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et vitae innocentiam a domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Commodum nactus tabellionem<note xml:id="fn1" type="footnote" n="1">Unbekannt.</note>, <lb xml:id="p1z2"/><persName ref="p8418">Myconi</persName> colendissime, hisce te salutare volui ac felicitatem precari.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Alioqui in praesentiarum, quod scribam, non habeo.</s>
					<s n="4" xml:lang="la">Paucis <lb xml:id="p1z4"/>enim ante diebus, quae habui, scripsi<note xml:id="fn2" type="footnote" n="2">Siehe oben <ref target="file11299">Nr. 1256</ref>.</note> per <persName ref="p506">Ioannem Buttlerum</persName>.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Recte valemus omnes; utinam et tu recte valeas cum tuis omnibus.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z6"/>Caussam, cur hic tabellio missus sit, non plane novi; disces <lb xml:id="p1z7"/>id haud dubie ex tuis<note xml:id="fn3" type="footnote" n="3">d. h. von Vertrauensleuten im Rat.</note>.</s>
					<s n="7" xml:lang="la">Ego suspicor missum propter com<lb xml:id="p1z8"/>itia <placeName ref="l157">Francfordiana</placeName><note xml:id="fn4" type="footnote" n="4">Vgl. oben <ref target="file11273">Nr. 1230</ref>, Anm. 4.</note>.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale et me semper ama.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z9"/><placeName ref="l587">Tiguri</placeName>, 24. aprilis 1539.</s>
				</p>
				<p>
					<s n="10" xml:lang="la" ana="salute">Salutabis d. <persName ref="p1365">Grynaeum</persName>, <persName ref="p1278">Gastium</persName>, <lb xml:id="p1z10"/><persName ref="p506">Buttlerum</persName>, <persName ref="p6192">Ryffenstein</persName>, <persName ref="p8011">Gvaltherum</persName> meum ac reliquos <lb xml:id="p1z11"/>amicos et fratres.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z12"/><persName ref="p495">H. Bullingerus</persName> tuus.<pb type="edition" next="118"/></s>
					<s n="12" xml:lang="la"><lb xml:id="p1z13"/>Obsecro, si quid certi a comitiis <placeName ref="l157">Francfordianis</placeName> <lb xml:id="p1z14"/>habes, communica.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p8418">Osvaldo Myconio</persName>, <lb xml:id="p2z2"/>domino et fratri <lb xml:id="p2z3"/>colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
