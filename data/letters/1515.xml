	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. in domino.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Quae de tua singulari perferuntur humanitate, eadem literas tuas <lb xml:id="p1z3"/>spirare video.</s>
					<s n="3" xml:lang="la">Etsi igitur hoc tempore certa res nulla <lb xml:id="p1z4"/>ita magni offerebatur momenti, tamen nactus, cui ad te <lb xml:id="p1z5"/>darem, praetermittere sine meis literis nolui.</s>
					<s n="4" xml:lang="la">Quod <lb xml:id="p1z6"/>in tam bonam a te partem superiores meae ad te literae <lb xml:id="p1z7"/>acceptae sint, tuum in eo perspicio erga me studium, <lb xml:id="p1z8"/>atque ita me iam animasti, ut, si nihil grave aut valde <lb xml:id="p1z9"/>serium, tamen vel ut haec inter nos iam inita consue<lb xml:id="p1z10"/>tudo confirmetur, ad te scribam.</s>
					<s n="5" xml:lang="la" ana="salute">Salutem tuo nomine <lb xml:id="p1z11"/>(quomodo ad me scripseras) ita domino meo (iam <placeName ref="l1956">Suffolchiae</placeName> <lb xml:id="p1z12"/>duci) dixi, ut ad te dederit literas.</s>
					<s n="6" xml:lang="la">Profecto <lb xml:id="p1z13"/>nihil gratius eius praestantiae facere poteris, quam si <lb xml:id="p1z14"/>(quomodo semel fecisti) pergas filiae suae <lb xml:id="p1z15"/>pia tradere morum praecepta.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Etsi enim ita est <lb xml:id="p1z16"/>instituta, ut summa sit spes eius ad pietatem profectus, <lb xml:id="p1z17"/>tamen tuae <foreign xml:lang="el">παρακλήσεις</foreign> faces quasdam admovent, <lb xml:id="p1z18"/>dum secum semper suum adferunt pondus, vel quia <lb xml:id="p1z19"/>ab alieno profecta sunt vel quia a te tali viro.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z20"/>Commendas mihi <persName ref="p20172">Ioannem ab Ulmis</persName> cum caeteris <placeName ref="l862">Helvetiis</placeName>.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z21"/>Utinam eis adesse possem, quantum vellem!</s>
					<s n="10" xml:lang="la" ana="farewell"><lb xml:id="p1z22"/>Verum, licet eo modo adhuc deo visum non est, ut <lb xml:id="p1z23"/>possim, operam tamen meam, diligentiam et studium semper <lb xml:id="p1z24"/>invenient paratum ad eos iuvandum, quomodo possum, imprimis <lb xml:id="p1z25"/>autem <persName ref="p20172">Ioannem ab Ulmis</persName>, quem novi meaque sententia integ<lb xml:id="p1z26"/>er est iuvenis et moribus <foreign xml:lang="el">ἀδιάφθορος</foreign> Vale.</s>
					<s n="11" xml:lang="la">Christus <lb xml:id="p1z27"/>te omni ratione tueatur tuoque semper adsit ministerio!</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z28"/>Memineris mei (quaeso) in tuis precibus<lb xml:id="p1z29"/>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Tui studiosus <lb xml:id="p1z30"/><persName ref="p1422">Iacobus Haddonus</persName><note type="margin">a.R.: Haddcn!</note>.</s>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Doctissimo viro d. <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, fratri <lb xml:id="p2z3"/>suo charissimo.</s>
				</p>
				<p>
					<note type="author">[Darunter von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="15" xml:lang="la"><lb xml:id="p2z4"/><persName ref="p1422">Iacobus <lb xml:id="p2z5"/>Haddonus</persName>.</s>
				</p>
			</div>
		</body>
	</text>
