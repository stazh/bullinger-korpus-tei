	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la">Occasionem expecto quotidie (vir clarissime), ut <lb xml:id="p1z2"/>aliquid de rebus nostris et principum christianorum tam magnum <lb xml:id="p1z3"/>quoddam parturientibus ad te scribere possim, et dum <lb xml:id="p1z4"/>expecto, ecce, ex inopinato ab <placeName ref="l834">Italia</placeName> nuntiatum est mihi pontificem <lb xml:id="p1z5"/><placeName ref="l425">Romanum</placeName> summa aegritudine affectum esse.</s>
					<s n="3" xml:lang="la">Quodsi ita est <lb xml:id="p1z6"/>et aegritudinem mors est consecutura, faxit saltem deus optimus, <lb xml:id="p1z7"/>ut ipse secum auferat tot semina mali et bellorum, quibus <lb xml:id="p1z8"/>Europa undique scatet et maxime quorum ipse author fautorque <lb xml:id="p1z9"/>fuit.</s>
					<s n="4" xml:lang="la">Alias super hac re diffusius et aliis, quae sese <lb xml:id="p1z10"/>obtulerint.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Classem <placeName ref="l2510">Turcicam</placeName> iam dudum tota <placeName ref="l834">Italia</placeName> solvisse <lb xml:id="p1z11"/>intelligo.</s>
					<s n="6" xml:lang="la">Quod superest, cura ut valeas (domine mihi colendissime) <lb xml:id="p1z12"/>et me ama.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Ex <placeName ref="l98">Curia Rhetorum</placeName> die 3a septembris 1558.</s>
					<s n="8" xml:lang="la">D[<lb xml:id="p1z13"/>ominationis] t[uae] studio et officio totus <lb xml:id="p1z14"/><persName ref="p8306">J. Ja.</persName></s>
				</p>
				<p>
					<s n="9" xml:lang="de"><persName ref="p8306">Decambray</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo et doctissimo viro <lb xml:id="p4z2"/>domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p4z3"/>ecclesię <placeName ref="l587">Tigurinae</placeName> ministro <lb xml:id="p4z4"/>dignissimo.</s>
					<s n="11" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
