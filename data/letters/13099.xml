	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D<lb xml:id="p1z2"/>.</s>
					<s n="2" xml:lang="la">Recepi amantissimas tuas litteras, <persName ref="p6831">Traverse</persName> colendissime, ac intellexi, quae scripsisti de motibus <placeName ref="l834">Italicis</placeName>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Fiunt ista iusto dei iudicio.</s>
					<s n="4" xml:lang="la">Diu enim isti principes intulerunt <placeName ref="l822">Germaniae</placeName> bellum et divexarunt <placeName ref="l822">German<lb xml:id="p1z4"/>iam</placeName>, tale quidpiam meritam.</s>
					<s n="5" xml:lang="la">Caeterum iam in se mutuo convertunt hostilia arma.</s>
					<s n="6" xml:lang="la">Ita vindicat <lb xml:id="p1z5"/>dominus sanguinem effusum ab illis.</s>
					<s n="7" xml:lang="la">Verum haec sunt dolorum initia.</s>
					<s n="8" xml:lang="la">Oremus dominum, ut in patienti<lb xml:id="p1z6"/>a et fide ipsi semper placeamus.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z7"/>Interrogas, amice, quid in comitiis <placeName ref="l18">Augustanis</placeName> agat caesar<note xml:id="fn13" type="footnote" n="13"><persName ref="p18538">Karl V.</persName></note>, quid consultent principes?</s>
					<s n="10" xml:lang="la">Caesar lang<lb xml:id="p1z8"/>uet febri perpetuo, sed aegrotus hic caesar plus hactenus effecit apud Germanos quam fecerint hucus<lb xml:id="p1z9"/>que validi principes multi: Saxonem <persName ref="p19065">Ioannem Frederychum</persName><note xml:id="fn14" type="footnote" n="14"><persName ref="p19065">Johann Friedrich I. von Sachsen</persName>.</note> deiecit; in electoratum subvexit <lb xml:id="p1z10"/><persName ref="p18250">Mauritium</persName> ducem.</s>
					<s n="11" xml:lang="la">Huic data est <placeName ref="l558">Wittemberga</placeName>, ad quam revocavit <persName ref="p2095">Melanchtonem</persName> et profess<lb xml:id="p1z11"/>ores alios amplo oblato stipendio, ut ibi doceant.</s>
					<s n="12" xml:lang="la">Saxo interim elector depositus <placeName ref="l18">Augustae</placeName> <lb xml:id="p1z12"/>tenetur captivus.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="13" xml:lang="la">Prima septembris proposuit certa capita caesar, ad quae vult sibi responderi a prin<lb xml:id="p1z13"/>cipibus, ordinibus et statibus imperii.</s>
					<s n="14" xml:lang="la">Propositionem hic transmitto, sed ea lege, ut mundam serves, <lb xml:id="p1z14"/>legas, lectam d. <persName ref="p654">Comandro</persName> et <persName ref="p396">Blasio</persName> transmittas, qui per proximum nuncium, eumque fidum, remittant.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z15"/>Accepi praeterea scriptum aliud, quod nisi<note xml:id="fna" type="footnote" n="a"><hi>In der Vorlage</hi> misi.</note> clarissimo principi comiti a <persName ref="p8098">Wirtemberg</persName><note xml:id="fn15" type="footnote" n="15"><persName ref="p8098">Georg von Württemberg-Mömpelgard</persName>.</note>, etc., misis<lb xml:id="p1z16"/>sem, hisce adiecissem: Respondent principes ad id, quomodo tolli possit in relligione dissidium.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z17"/>Summa: Nolunt praeiudicare caesari aut suam sententiam proferre ante caesaris sententiam; orant <lb xml:id="p1z18"/>itaque, suam prior dicat caesar, qui multis iam annis modum inquisivit, quo posset tolli dissidium; pollicentur autem <lb xml:id="p1z19"/>se facturos, quod omnino facere possint, etc.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="17" xml:lang="la">Populus interim satis constans est, principes fere nulli<note xml:id="fnb" type="footnote" n="b"><hi>In der Vorlage</hi> multi.</note> sunt.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z20"/>Sed vincet veritas.</s>
					<s n="19" xml:lang="la">Plura iam non possum.</s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="20" xml:lang="la">Effeci apud dominos consules, ut vino honorario amicus ille tuus <lb xml:id="p1z21"/>sit donatus.</s>
					<s n="21" xml:lang="la">Pransi sunt cum illo honoris gratia secundus ex triumviris loco consulum et unus e<note xml:id="fnc" type="footnote" n="c"><hi>In der Vorlage</hi> et.</note> tribunis <lb xml:id="p1z22"/>plebis, quibus me quoque coniunxi.</s>
					<s n="22" xml:lang="la">Utinam illi, uti merebatur, gratificati fuissemus!</s>
				</p>
			</div>
			<div xml:id="div7" corresp="regest7">
				<p>
					<s n="23" xml:lang="la" ana="farewell">Vale <lb xml:id="p1z23"/>aeternum.</s>
					<s n="24" xml:lang="la"><placeName ref="l587">Tiguri</placeName>, 22. octobris 1547.</s>
					<s n="25" xml:lang="la" ana="salute">Salveant filii tui.</s>
				</p>
			</div>
			<div xml:id="div8" corresp="regest8">
				<p>
					<s n="26" xml:lang="la">Ex propositione mellitis<lb xml:id="p1z24"/>sima caesaris pro tua prudentia intelliges caesarem quaerere merum in <placeName ref="l822">Germania</placeName> domin<lb xml:id="p1z25"/>ium et excidium veritatis.</s>
					<s n="27" xml:lang="la">Proin punietur a domino.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse als Überschrift:]</note>
					<s n="29" xml:lang="la"><lb xml:id="p1z29"/>O<lb xml:id="p1z31"/>r<lb xml:id="p1z32"/>natissimo vir<lb xml:id="p1z33"/>o d. <persName ref="p6831">Ioa<lb xml:id="p1z34"/>nni Tra<lb xml:id="p1z35"/>vers<lb xml:id="p1z36"/>io</persName> Suz<lb xml:id="p1z37"/>azie<lb xml:id="p1z38"/>nsi apud <lb xml:id="p1z39"/><placeName ref="l648">Rhet<lb xml:id="p1z40"/>os</placeName>, am<lb xml:id="p1z41"/>ico s<lb xml:id="p1z42"/>uo semper <lb xml:id="p1z43"/>colen<lb xml:id="p1z44"/>do e<lb xml:id="p1z45"/>t ama<lb xml:id="p1z46"/>ndo <note xml:id="fnd" type="footnote" n="d"><hi>Darauf folgt von einer anderen Hand</hi> Zutz.</note></s>
				</p>
			</div>
		</body>
	</text>
</TEI>