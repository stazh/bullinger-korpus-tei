	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Naves quatuor <placeName ref="l15">An<lb xml:id="p1z2"/>tverpi<lb xml:id="p1z3"/>a</placeName> simul <lb xml:id="p1z4"/>solveb<lb xml:id="p1z5"/>ant<lb xml:id="p1z6"/>, qua<lb xml:id="p1z7"/>rum <lb xml:id="p1z8"/>un<lb xml:id="p1z9"/>a naufra<lb xml:id="p1z10"/>gium fe<lb xml:id="p1z11"/>ci<lb xml:id="p1z12"/>t; s<lb xml:id="p1z13"/>al<lb xml:id="p1z14"/>va du<lb xml:id="p1z15"/>ntaxa<lb xml:id="p1z16"/>t tua <lb xml:id="p1z17"/>exempl<lb xml:id="p1z18"/>aria <lb xml:id="p1z19"/>in Abe<lb xml:id="p1z20"/>lis navi ad <lb xml:id="p1z21"/>litt<lb xml:id="p1z22"/>us deve<lb xml:id="p1z23"/>nerunt.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z24"/><persName ref="p672">Coxo</persName> <lb xml:id="p1z25"/>unum <lb xml:id="p1z26"/>dedi, <lb xml:id="p1z27"/>alterum <placeName ref="l3029">Warwicens<lb xml:id="p1z28"/>i</placeName> per C<lb xml:id="p1z29"/>hec<lb xml:id="p1z30"/>hu<lb xml:id="p1z31"/>m tra<lb xml:id="p1z33"/>di <lb xml:id="p1z34"/>c<lb xml:id="p1z35"/>uravi; <lb xml:id="p1z36"/>reliqu<lb xml:id="p1z37"/>a tria, <lb xml:id="p1z38"/>Petri nimirum et marchionis pariter ac filiae <placeName ref="l376">Oxonium</placeName> iamiam deferre <lb xml:id="p1z39"/>mecum decrevi.</s>
					<s n="3" xml:lang="la">Profectus est princeps meus trecentis equitibus et ali<lb xml:id="p1z40"/>quot bonis concionatoribus in <placeName ref="l2524">Scotiam</placeName> eam potissimum ob causam, ut de<lb xml:id="p1z41"/>victam superioribus annis eius regionis partem fideliter in religione instit<lb xml:id="p1z42"/>uat atque informet.</s>
					<s n="4" xml:lang="la">Paucas intra septimanas ad ipsum me profecturum existimo; <pb/><lb xml:id="p2z1"/>inde fortassis literas ad te dabo, si nuncium fidelem nancisci queam.</s>
					<s n="5" xml:lang="la">Exemplum <lb xml:id="p2z2"/>Decadis utrique et <persName ref="p3962">Wulloko</persName> et <persName ref="p8506">Scinnero</persName> tuo nomine donabo, quod te aegre laturum non <lb xml:id="p2z3"/>arbitror.</s>
					<s n="6" xml:lang="la">Comes <placeName ref="l2665">Hyberniae</placeName> ad se me iusserat hoc mane redire; sed <lb xml:id="p2z4"/>cum accedo cubiculum, ad regem vocatus dicitur.</s>
					<s n="7" xml:lang="la">Fuit illi sane salutatio tua <lb xml:id="p2z5"/>perquam grata; <lb xml:id="p2z6"/>literas illius ad te proximis meis haud dubio <placeName ref="l587">Tigurum</placeName> de<lb xml:id="p2z7"/>ferri curabo.</s>
					<s n="8" xml:lang="la"><lb xml:id="p2z8"/>Nunc iter ad principem instituo; tibi vero, <lb xml:id="p2z9"/>amplissime in Christo pater, gratias aeternas pro immortalibus tuis in me bene<lb xml:id="p2z10"/>ficiis etiam atque etiam ago et habeo.</s>
					<s n="9" xml:lang="la"><lb xml:id="p2z12"/>Scribam de singulis ad te post <lb xml:id="p2z13"/>reditum et articulatim.</s>
					<s n="10" xml:lang="la" ana="salute"><lb xml:id="p2z14"/>Salutat te multis verbis frater principis <lb xml:id="p2z15"/>et <persName ref="p8506">Scinnerus</persName>, quibuscum hesterna die lautissime sum pransus.</s>
					<s n="11" xml:lang="la"><placeName ref="l296">Londini</placeName> <lb xml:id="p2z16"/>festinans et raptim.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p2z17"/>Tuae dignitatis <lb xml:id="p2z18"/>studiosissimus discipulus <lb xml:id="p2z19"/><persName ref="p20172">Iohannes ab Ulmis</persName>.</s>
				</p>
				<p>
					<note>[von der Hand des <persName ref="p20172">Johannes von Ulm</persName>:]</note>
					<s n="13" xml:lang="la"><lb xml:id="p2z20"/>Clarissimo et doctissimo viro <lb xml:id="p2z21"/><persName ref="p495">Henricho Bullingero</persName>, domino <lb xml:id="p2z22"/>ac fratri suo carissimo.</s>
				</p>
				<p>
					<note type="author">[Darunter von unbekannter Hand; mit Zusatz von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="14" xml:lang="la"><lb xml:id="p2z23"/>A d. d. <persName ref="p672">Coxo</persName> <lb xml:id="p2z24"/>cancellario <lb xml:id="p2z25"/><placeName ref="l376">Oxonien[si]</placeName>.</s>
				</p>
			</div>
		</body>
