	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Video, mi frater, omnia plena esse malis <lb xml:id="p1z2"/>et ideo ardentius orandum dominum, ut nos exuat et <lb xml:id="p1z3"/>protegat a malo.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Videntur <placeName ref="l306">Mediolanenses</placeName> aliquam ve<lb xml:id="p1z4"/>nari belli occasionem; prudenter ergo, non praecipitanter <lb xml:id="p1z5"/>agendum esse iudico.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Facile quidem bellum incipitur, <lb xml:id="p1z6"/>sed non pari facilitate finitur et deponitur.</s>
					<s n="5" xml:lang="la">Illi quidem <lb xml:id="p1z7"/>iustam videntur dedisse occasionem bello; sed vobis <lb xml:id="p1z8"/>videndum etiam atque etiam, num quavis occasione ut<lb xml:id="p1z9"/>en<lb xml:id="p1z10"/>dum pro vestro iure.</s>
					<s n="6" xml:lang="la">Cedunt multi frequentius et rectius iur<lb xml:id="p1z11"/>i suo, quam hoc persequerentur, et monstrificus <lb xml:id="p1z12"/>ille partus nihil boni praesagit et portendit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Dominus liberet <lb xml:id="p1z13"/>nos a malo et non retribuat pro meritis nostris!</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z14"/>Quem <persName ref="p20811">Ascanium</persName> sclopeto traiectum a <persName>Sciero</persName> apud <lb xml:id="p1z15"/><placeName ref="l323">Mesaucos</placeName> dicas, non intelligo; non scio, quis sit <lb xml:id="p1z16"/><persName>Ascanius</persName> aut quis <persName>Scierus</persName> aut quae c[aus]a caedis.</s>
					<s n="9" xml:lang="la">Signi<lb xml:id="p1z17"/>ficantius ergo haec narrato.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Quae nuper scripsi de pugna commissa ad <placeName>Gröningam</placeName>, <lb xml:id="p1z19"/>subinde magis et magis confirmantur, ut indubitata <lb xml:id="p1z20"/>credantur.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Cecidit locumtenens et vir magnus, com<lb xml:id="p1z21"/>es <placeName ref="l3">Arburgensis</placeName>, veluti manus <persName>Albani</persName>.</s>
					<s n="12" xml:lang="la">Deleta sunt <lb xml:id="p1z22"/>ad internecionem 10 <placeName ref="l875">Hispanorum</placeName> signa.</s>
					<s n="13" xml:lang="la">Capti <placeName ref="l822">Germani</placeName> <lb xml:id="p1z24"/>dimissi sunt; <placeName ref="l875">Hispani</placeName> suspensi et perempti sunt omnes.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z25"/><placeName ref="l875">Hispani</placeName> illustriores novem in unam sunt suspensi <lb xml:id="p1z26"/>arborem.</s>
					<s n="15" xml:lang="la">Et mira huius generis alia scribuntur, prae<lb xml:id="p1z27"/>terea et hoc: <persName>Albanum</persName> ea clade exasperatum, ut <lb xml:id="p1z28"/>captivos suos, quos iam diu detentos audisti, ad <lb xml:id="p1z29"/>unum capitibus truncarit omnes, comitem <placeName>Egmon<lb xml:id="p1z30"/>danum</placeName>, comitem <persName>Hornum</persName>, item barones, equites <lb xml:id="p1z31"/>auratos et nobiles circiter 50.</s>
					<s n="16" xml:lang="la">Quod si verum <lb xml:id="p1z32"/>est, armabit haec immanis et indigna eius crudelitas <lb xml:id="p1z33"/>et <placeName ref="l822">Germanos</placeName> et principes <placeName ref="l822">Germanorum</placeName> plurimos in <lb xml:id="p1z34"/>latronem istum, quem alioqui oderunt boni et mali omnes; <lb xml:id="p1z35"/>nam plures ex magnatibus istis decollatis fue<lb xml:id="p1z36"/>runt papisticae religionis asseclae; fuerunt <lb xml:id="p1z37"/>alii affines et cognati principum.</s>
					<s n="17" xml:lang="la">Sed bellua <lb xml:id="p1z38"/>illa parcit nemini.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z39"/>Ex <placeName ref="l832">Gallia</placeName> nondum audimus <lb xml:id="p1z40"/>meliora et clementiora; nondum tamen desperamus <lb xml:id="p1z41"/>et expectamus lętiora obsecrantes dominum, <lb xml:id="p1z42"/>ut is nos servet et laetificet.</s>
					<s n="19" xml:lang="la" ana="farewell">In hoc vale, chare <lb xml:id="p1z43"/>frater.</s>
					<s n="20" xml:lang="la" ana="salute">Nostri te salutant.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="salute">Saluta tu d. d.d. consules <lb xml:id="p1z44"/>et d. <persName ref="p1770">Carolum</persName>, <persName ref="p6130">Pontisellam</persName>, <persName ref="p20473">Ganthnerum</persName> et omnes nostros.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 25. i<lb xml:id="p1z45"/>unii 1568.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Quaeso, cura, ut hae literae inclusae probe curentur.</s>
					<s n="24" xml:lang="la" ana="farewell">Iterum iterumque vale.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><persName ref="p495">Bullingerus</persName> s[e<lb xml:id="p1z46"/>nior] tuus.</s>
					<s n="26" xml:lang="la" ana="salute">(a tergo:) Saluta mihi, oro, d. <persName ref="p8432">Friderychum</persName> et <persName ref="p8093">Herculem Salic<lb xml:id="p1z47"/>eos</persName>; non potui ad eos nunc scribere.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praestantissimo viro d. <lb xml:id="p2z2"/><persName ref="p8016">Tobiae Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fido, domi<lb xml:id="p2z4"/>no meo colendo et <lb xml:id="p2z5"/>fratri dilectissimo.</s>
				</p>
				<p>
					<s n="28" xml:lang="la"><lb xml:id="p2z6"/>Chur.</s>
				</p>
			</div>
