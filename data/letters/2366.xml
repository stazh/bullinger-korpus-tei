	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Domino <persName ref="p495">Henrico Bullingero</persName> <persName ref="p8175">Theodoricus <lb xml:id="p1z2"/>Bitter</persName> S.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z3"/>Nescio, qua de causa amicissimę tę et mihi <lb xml:id="p1z4"/>semper gratissime ad me litere aliquot annis <lb xml:id="p1z5"/>prorsus intermisse, si non id, quod novissime tuis <lb xml:id="p1z6"/>literis brevitatis me incusabas.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Sed fateor ingenu<lb xml:id="p1z7"/>e tepiditatem necnon incultum et inexercitatum <lb xml:id="p1z8"/>in scribendo ingenium, quare manum etiam aliquam<lb xml:id="p1z9"/>diu retinui.</s>
					<s n="4" xml:lang="la">Verum si in hoc peccatum, veniam <lb xml:id="p1z10"/>dones, precor; semper enim mecum ratus sum: <lb xml:id="p1z11"/>cuinam multiloquentia rudis et indocti <lb xml:id="p1z12"/>placebit?</s>
					<s n="5" xml:lang="la">Hoc unum est, mihi crede, quod me <lb xml:id="p1z13"/>non solum brevem, sed et cunctatiorem antea <lb xml:id="p1z14"/>in scribendo fecerit.</s>
					<s n="6" xml:lang="la">Et quia tibi id displicere <lb xml:id="p1z15"/>animadverti, annis aliquot prorsus etiam <lb xml:id="p1z16"/>abstinui, non quod memoria apud me tua di<lb xml:id="p1z17"/>minuta exciderit aut sepulta sit, quod me vivo <lb xml:id="p1z18"/>nunquam fiet; nam vix credideris, quam cupiam vel <lb xml:id="p1z19"/>una saltem horula praesens conloqui; tum f<lb xml:id="p1z20"/>acillime id, quod nausee in me collegisti, <lb xml:id="p1z21"/>amoverim, - verum quia id negatur, vel scriptis <lb xml:id="p1z22"/>saltem iterum cum veteri tuo in studiis <lb xml:id="p1z23"/>commilitoni familiariter loqui reincipias, <lb xml:id="p1z24"/>obsecro atque obtestor.</s>
					<s n="7" xml:lang="la">Et si mearum rerum certior fieri <lb xml:id="p1z25"/>voles, corpore adhuc incolumi sum una cum pau<lb xml:id="p1z26"/>percula uxore et prolibus necnon veteri ill<lb xml:id="p1z27"/>o hero <persName ref="p2807">Lysio</persName>, quem sanum quidem <placeName ref="l267">Colonia</placeName> <lb xml:id="p1z28"/>discedens reliqui.</s>
					<s n="8" xml:lang="la">His paucis modo valebis; <lb xml:id="p1z29"/>nam negotia, quibus implicabar, longe <lb xml:id="p1z30"/>alio vocabant.</s>
					<s n="9" xml:lang="la">Et si volente deo tuis iu<lb xml:id="p1z31"/>cundissimis literis frueris seu iterum dignatus <lb xml:id="p1z32"/>fueris, alias de singulis copiosius.</s>
					<s n="10" xml:lang="la">Datum <lb xml:id="p1z33"/><placeName ref="l471">Spyre</placeName> anno domini 1554 die martis 21. <lb xml:id="p1z34"/>augusti.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Eruditissimo necnon pietate insign<lb xml:id="p2z2"/>i domino <persName ref="p495">Henrico Bullingero</persName> apud <lb xml:id="p2z3"/><placeName ref="l587">Tugiros</placeName><note type="margin">a.R.: <placeName ref="l587">Tiguros</placeName>?</note> vulgo <placeName ref="l587">Zürich</placeName> ecclesiasti f<lb xml:id="p2z4"/>idelissimo, meo amico integerrim<lb xml:id="p2z5"/>o et domino semper colendo.</s>
				</p>
				<p>
					<s n="12" xml:lang="de"><lb xml:id="p2z6"/>Gen <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
