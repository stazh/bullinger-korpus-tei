	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z2"/>S. D.</s>
					<s n="2" xml:lang="la">Accepimus, domini honorandi et fratres charissimi, per <lb xml:id="p1z3"/>certum nuncium ex <placeName ref="l832">Gallia</placeName> a Guysianis (auxilian<lb xml:id="p1z4"/>tibus aliquot in <placeName ref="l832">Gallia</placeName> magnatibus coniuratis, <lb xml:id="p1z5"/>inprimis autem cardinalibus, episcopis et clero) maximas <lb xml:id="p1z6"/>esse turbas excitatas et quotidie extremam contra f<lb xml:id="p1z7"/>ideles exerceri saevitiam.</s>
					<s n="3" xml:lang="la">Quae ut omnia rectius <lb xml:id="p1z8"/>intelligatis, mitto, quae inde ex <placeName ref="l367">Aurelia</placeName>, ubi fidelium colligitur <lb xml:id="p1z9"/>exercitus, accepi vobis quoque charis communicanda fratribus.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z10"/>Principio habetis descriptionem brevem cru<lb xml:id="p1z11"/>delitatis abominandae Guysianorum, quam exercuerunt <lb xml:id="p1z12"/>contra ecclesiam <placeName ref="l3738">Vassensem</placeName>; inde colligatis, <lb xml:id="p1z13"/>quid consilii concoeperint hi homines contra omnes <lb xml:id="p1z14"/>fideles per <placeName ref="l832">Galliam</placeName> ecclesias.</s>
					<s n="5" xml:lang="la">Deinde mitto protestationem <lb xml:id="p1z15"/>illustrissimi <persName ref="p8315">principis Ludovici, ducis Borbonii, <lb xml:id="p1z16"/>qui est princeps Condensis</persName>, Gallica lingua editam <lb xml:id="p1z17"/>atque impressam, hic autem conversam in Germanicam <lb xml:id="p1z18"/>a d. d. <persName ref="p8395">Georgio Cellario</persName> ita iubente amplissimo huius <lb xml:id="p1z19"/>urbis magistratu, apud quem est Gallicum exemplum.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z20"/>Ergo non est, quod quicquam in ea vobis sit suspectum.</s>
					<s n="7" xml:lang="la">Intelliget<lb xml:id="p1z21"/>is ex ea totius rei negotium, et quod nostri non sint <lb xml:id="p1z22"/>seditiosi contra regem, sed conari eos coniuratos et <lb xml:id="p1z23"/>seditiosos contra regem in ordinem redigere, regem <lb xml:id="p1z24"/>liberare et pacem regno reddere etc.</s>
					<s n="8" xml:lang="la">His adiunxi epistol<lb xml:id="p1z25"/>am d. <persName ref="p8033">Bezae</persName>; ita enim voluit, ut ipsam communicarem <lb xml:id="p1z26"/>fratribus <placeName ref="l28">Basiliensibus</placeName>, <placeName ref="l441">Schaffhusianis</placeName>, <placeName ref="l473">Sangallensibus</placeName> et <placeName ref="l648">Rhetis</placeName>.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z27"/>Videtis, quid facto opus sit, optimi fratres.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z28"/>Clamandum erit vobis sedulo et absque intermissio<lb xml:id="p1z29"/>ne ad dominum, exhortanda ad supplicationem ecclesia.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z30"/>Confirmandae sunt etiam nostrae fidei creditae ecclesiae; <lb xml:id="p1z31"/>etenim si superiores fuerint papistae in <placeName ref="l832">Gallia</placeName>, <lb xml:id="p1z32"/>facinore nephando animati imminebunt et nobis.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z33"/>Sed et nostri papistae istis nihilo sunt mitiores, neque <lb xml:id="p1z34"/>dubium est non alio fine coeptum esse concilium <placeName ref="l1107">Tri<lb xml:id="p1z35"/>denti</placeName>, quam ut causae praetexantur probabiles saltem apud <lb xml:id="p1z36"/>plebem persequtioni truculentissimae, quam iam annis <lb xml:id="p1z37"/>aliquot fabricati sunt.</s>
					<s n="13" xml:lang="la">Utinam vero nos vera poenit<lb xml:id="p1z38"/>entia fideque domino occurreremus est hic clemens <lb xml:id="p1z39"/>ad condonandum poenitentibus delicta et potens ad serv<lb xml:id="p1z40"/>andum suos.</s>
				</p>
				<p>
					<s n="14" xml:lang="la" ana="farewell">In hoc valete, domini honorandi et <lb xml:id="p1z41"/>fratres charissimi.</s>
					<s n="15" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 23. aprilis 1562.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z42"/><persName ref="p495">Bullingerus</persName> vester.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z43"/>Petuntur 4000 <placeName ref="l862">Helvetiorum</placeName>, atque <lb xml:id="p1z44"/>ideo indicta sunt comitia <lb xml:id="p1z45"/><placeName ref="l760">Salodurum</placeName> ad 26. aprilis<pb/><lb xml:id="p4z2"/>.</s>
				</p>
				<p>
					<note>[zw. 444 u. 445]</note>
					<s n="18" xml:lang="la"><lb xml:id="p4z3"/>Fidelibus Christi Iesu servis <lb xml:id="p4z4"/>ecclesiae <placeName ref="l98">Curiensis</placeName> et reliquarum <lb xml:id="p4z5"/><placeName ref="l648">Rhetiae</placeName> ecclesiarum <lb xml:id="p4z6"/>ministris, dominis honorandis <lb xml:id="p4z7"/>et fratribus charissimis suis.</s>
					<s n="19" xml:lang="la"><lb xml:id="p4z8"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
