	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P.</s>
					<s n="2" xml:lang="la">Audio me apud te, doctissime <persName ref="p495">Bul[lingere]</persName>, a quodam adversario <lb xml:id="p1z2"/>graviter esse accusatum.</s>
					<s n="3" xml:lang="la">Ego vero te per eam, quam multos <lb xml:id="p1z3"/>iam annos docuisti, aequitatem etiam atque etiam oro, ne me <lb xml:id="p1z4"/>talem esse putes, qualem tibi persuasit accusator.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Sic di<lb xml:id="p1z5"/>lexeram <persName ref="p4521">Castalionem</persName>, ut tamen eius errores, si qui <lb xml:id="p1z6"/>erant, non dilexerim; probitas atque singularis illius <lb xml:id="p1z7"/>hominis integritas mihi cara fuit, quibus virtutibus <lb xml:id="p1z8"/>si quid vitii adiunctum erat, uti fit, plane totum <lb xml:id="p1z9"/>oderam.</s>
					<s n="5" xml:lang="la">Quam autem pie de omnibus christianę <lb xml:id="p1z10"/>religionis capitibus sentiam, testis esse poterit cum <lb xml:id="p1z11"/>totus nostrorum hominum, qui isthic est, coetus tum vero <lb xml:id="p1z12"/>pręcipue mihi amicissimus in domino frater d. <persName ref="p8511">Christ<lb xml:id="p1z13"/>ophorus Trecius</persName>, quocum crebris litteris de <lb xml:id="p1z14"/>statu nostrarum ecclesiarum disserere soleo.</s>
					<s n="6" xml:lang="la">Tamen, si ac<lb xml:id="p1z15"/>cusatori potius incerta pro certis asserenti quam <lb xml:id="p1z16"/>mihi omnia eiusmodi ficta crimina neganti <lb xml:id="p1z17"/>credere malles, hoc quidem tibi summe prudentie <lb xml:id="p1z18"/>viro licet; verum ego haud mediocri gravabor in<lb xml:id="p1z19"/>iuria.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="farewell">Bene vale, vir doctissime, et me tui <lb xml:id="p1z20"/>studiosum complectere.</s>
					<s n="8" xml:lang="la"><placeName ref="l167">Geneve</placeName> 27. iunii <lb xml:id="p1z21"/>1564.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z22"/>Tue dignitatis studio<lb xml:id="p1z23"/>s<lb xml:id="p1z26"/>iss<lb xml:id="p1z27"/>im<lb xml:id="p1z28"/>us <lb xml:id="p1z29"/><persName ref="p8041">I<lb xml:id="p1z30"/>oha<lb xml:id="p1z35"/>n<lb xml:id="p1z37"/>n<lb xml:id="p1z40"/>es <lb xml:id="p1z41"/>Lasici<lb xml:id="p1z42"/>u<lb xml:id="p1z44"/>s</persName><lb xml:id="p1z46"/>.</s>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vigilantissimo ecclesie <placeName ref="l587">Tiguri<lb xml:id="p2z2"/>ne</placeName> pastori viro clarissimo <lb xml:id="p2z3"/>d. <persName ref="p495">Henricho Bullingero</persName>.</s>
				</p>
				<p>
					<note type="author">[Bemerkung von <persName ref="p495">Bullingers</persName> Hand:]</note>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p2z4"/>"<persName ref="p8041">Ioannis Lasicii</persName> <placeName ref="l2472">Poloni</placeName> <lb xml:id="p2z5"/>literae de <persName ref="p4521">Castalione</persName> <lb xml:id="p2z6"/>et mea responsio 13. <lb xml:id="p2z7"/>iulii 1564."</s>
				</p>
