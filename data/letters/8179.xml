			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Scripsi nuper paucula per Rögerum nostrum
					<lb xml:id="p1z2"/>clarissime vir et pater in Christo venerande.
					<lb xml:id="p1z3"/>nunc amici viri optimi causa iterum tuae
					<lb xml:id="p1z4"/>humanitati molestus esse cogor.
					<lb xml:id="p1z5"/>autem est matrimonialis, cuius formam
					<lb xml:id="p1z6"/>in tabella subiicio.
					<lb xml:id="p1z7"/>Civis nuper mortuus
					<lb xml:id="p1z8"/>Ariani maternam.
					<lb xml:id="p1z9"/>primo inmatrimonio
					<lb xml:id="p1z10"/>Haec ex alio primai
					<lb xml:id="p1z11"/>vinctam habuit.
					<lb xml:id="p1z12"/>marito habuit.
					<lb xml:id="p1z13"/>Avia illa mortua
					<lb xml:id="p1z14"/>2. filiam ex
					<lb xml:id="p1z15"/>civis ducit altera
					<lb xml:id="p1z16"/>hac procreatu
					<lb xml:id="p1z17"/>ipsa
					<lb xml:id="p1z18"/>iberise
					<lb xml:id="p1z19"/>3. filius, qui
					<lb xml:id="p1z20"/>De
					<lb xml:id="p1z21"/>stertiam
					<lb xml:id="p1z22"/>ex 9.
					<lb xml:id="p1z23"/>mortui affinis
					<lb xml:id="p1z24"/>suse
					<lb xml:id="p1z25"/>viduam sib.
					<lb xml:id="p1z26"/>Cen
					<lb xml:id="p1z27"/>ia
					<lb xml:id="p1z28"/>matrimonio
					<lb xml:id="p1z29"/>ngi cupit.
					<lb xml:id="p1z30"/>.
					<lb xml:id="p1z31"/>inter istas
					<lb xml:id="p1z32"/>per
					<lb xml:id="p1z33"/>matri monium Contrahi
					<lb xml:id="p1z34"/>is regionibus et ecclesiis nostris
					<lb xml:id="p1z35"/>possit n
					<lb xml:id="p1z36"/>Obnixe rogo, ut quid in hoc casu
					<lb xml:id="p1z37"/>apud vos fieret, proximo quoque die
					<lb xml:id="p1z38"/>gae velis; nam in eo comitatu
					<lb xml:id="p1z39"/>in quo multis annis ecclesiae praefui.
					<lb xml:id="p1z40"/>has quaestiones iureconsulti solverunt.
					<lb xml:id="p1z41"/>Nac memini me ullum similem acdiiss
					<lb xml:id="p1z42"/>casum. Quare invitus absque doctior
					<lb xml:id="p1z43"/>iudicio, mea in his negociis sententiam
					<lb xml:id="p1z44"/>pronuncio, et tua humanitas novit
					<lb xml:id="p1z45"/>nostros theologos non in omnibus
					<lb xml:id="p1z46"/>istis per omnia solide consentire.Vale
					<lb xml:id="p1z47"/>Christo et d. fratresque omnes saluta reverenter
					<lb xml:id="p1z48"/>Datum propere 16. februarii anno 1570.
					<lb xml:id="p1z49"/>Tuae humanitatis
					<lb xml:id="p1z50"/>studiosissimus.
					<lb xml:id="p1z51"/>Ioannes Conradus.
					<lb xml:id="p1z52"/>Ulmerus.
					<lb xml:id="p1z53"/>3.
					<pb/>
					<lb xml:id="p2z1"/>Clarissimo viro eximioque Christi servo,
					<lb xml:id="p2z2"/>d. Henrico Bullingero, ecclesiae Tigurin
					<lb xml:id="p2z3"/>antistiti fidelissimo, amico et
					<lb xml:id="p2z4"/>patri suo in Christo summe colendo.
					<lb xml:id="p2z5"/>votbus matri
					<lb xml:id="p2z6"/>nomalih.
					<lb xml:id="p2z7"/>
					<lb xml:id="p2z8"/>
				</p>
