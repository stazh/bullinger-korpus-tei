	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus et pax Christi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Pro datis ad me scriptis<note xml:id="fn1" type="footnote" n="1">Nicht erhalten.</note> gratiam tibi habeo.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Quod literę meae<note xml:id="fn2" type="footnote" n="2">Oben <ref target="file10920">Nr. 879</ref>.</note> tardius missae sunt, causam in<lb xml:id="p1z4"/>tellexisti ex ipsis, ni fallor.</s>
					<s n="4" xml:lang="la">Tecum autem <lb xml:id="p1z5"/>sentio illos optimos viros infęlices esse in <lb xml:id="p1z6"/>explicando hoc negotio<note xml:id="fn3" type="footnote" n="3">Offenbar hatte <persName ref="p495">Bullinger</persName> Äußerungen <persName ref="p467">Bucers</persName> und <persName ref="p5565">Capitos</persName> zur Konkordienfrage kritisiert.</note>, id quod plus semel <lb xml:id="p1z7"/>illis coram testatus sum, neque minim, cum <lb xml:id="p1z8"/>in nullo alias negotio tam sint ardentes et fre<lb xml:id="p1z9"/>quentes et certe plus semel mea opera, ut<lb xml:id="p1z10"/>cumque exigua, usi sunt.</s>
					<s n="5" xml:lang="la">Et videor ipse mihi <lb xml:id="p1z11"/><persName ref="p1974">Lutheri</persName> mentem (ut sese nunc illa habet et <lb xml:id="p1z12"/>quam testatur se nunquam non habuisse) probe <lb xml:id="p1z13"/>intelligere.</s>
					<s n="6" xml:lang="la">Utinam Lutherani omnes et totus <lb xml:id="p1z14"/>Lutheranus populus illam<note xml:id="fna" type="footnote" n="a"><hi><persName ref="p495">Bullinger</persName> las irrtümlich</hi> ilium; <hi>s. unten <ref target="file10933">Nr. 891</ref>, 3-5.</hi></note> intelligeret!</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z15"/>Quid nuper ad vos scripserim, omnino excidit <lb xml:id="p1z16"/>mihi argumento excepto, itaque descriptam epistolam <lb xml:id="p1z17"/>abs te peto.</s>
					<s n="8" xml:lang="la" ana="farewell">Praeterea vale et ora <lb xml:id="p1z18"/>dominum pro me et toto isthoc negotio.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z19"/><placeName ref="l257">Constantiae</placeName>, 28. augusti 1536.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/>Tuus totus <persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Hainricho <lb xml:id="p2z2"/>Bullingero</persName>, fratri obse<lb xml:id="p2z3"/>rvando.</s>
					<s n="12" xml:lang="de">Zuͦ <placeName ref="l587">Zurc<lb xml:id="p2z4"/>h</placeName>.</s>
				</p>
			</div>
		</body>
