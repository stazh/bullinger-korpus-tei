	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Cum veniat istuc d. <persName ref="p8432">Fridrichus <span type="pronoun">noster</span> a Salicibus</persName>, pror(sus) <lb xml:id="p1z2"/>non censeo necessarium aliquid de rebus nostris Italicisque scribere; h(oc enim) <lb xml:id="p1z3"/>melius nemo poterit referre de singulis.</s>
					<s n="3" xml:lang="la">Bibliam petieram versionis <lb xml:id="p1z4"/><persName ref="p1753">Iudae Leonis</persName> in forma maxima foliorum papyri regalis nec <lb xml:id="p1z5"/>commaculatam colligatamque bene.</s>
					<s n="4" xml:lang="la">Pro amico invenisti; mitto hic pretium <lb xml:id="p1z6"/>nominatim aureos <placeName ref="l2096">Renenses</placeName> tres.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Venturus est his diebus ad vos biblio<lb xml:id="p1z7"/>pola hic noster; is mihi adportabit codicem, si prius advehi non <lb xml:id="p1z8"/>poterit.</s>
					<s n="6" xml:lang="la">Dominus Iesus te mundo diu conservet incolumem.</s>
					<s n="7" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z9"/>Ex <placeName ref="l98">Curia</placeName> die ultima ianuarii 1558.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z10"/>Tuae humanitatis totus <persName ref="p8359">Philippus Gallicius</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vere magno viro d. <lb xml:id="p2z2"/><persName ref="p495">Heinrycho Bullingero</persName>, <lb xml:id="p2z3"/>domino bonis colendissimo.</s>
				</p>
			</div>
		</body>
	</text>
