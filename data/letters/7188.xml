	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quoniam certum hunc sum nactus nuntium, committere <lb xml:id="p1z2"/>non potui, quin scriberem, licet pauca haberem, <lb xml:id="p1z3"/>saltem ut tibi occasionem praeberem respondendi ad illa, <lb xml:id="p1z4"/>quae superioribus ad te diebus dedi.</s>
					<s n="3" xml:lang="la">Vivimus hic per <lb xml:id="p1z5"/>dei gratiam satis feliciter et oramus dominum, ut nobis <lb xml:id="p1z6"/>pergat benedicere.</s>
					<s n="4" xml:lang="la">Biduo abhinc grando in ea <lb xml:id="p1z7"/>Lacus parte, qua urbs sita est, supra urbem attrivit <lb xml:id="p1z8"/>quaedam; verum si porro parceret nobis dominus, <lb xml:id="p1z9"/>iacturam ferremus facilius.</s>
					<s n="5" xml:lang="la">Audimus <placeName ref="l257">Constantiensem</placeName> espicopum <lb xml:id="p1z10"/>moliri grandia et convocare concilium vel synodum <lb xml:id="p1z11"/>provincialem <placeName ref="l257">Constantiam</placeName> et adfuturam maximam praelatorum <lb xml:id="p1z12"/>turbam.</s>
					<s n="6" xml:lang="la">Mirantur omnes, quid sit et in quem <lb xml:id="p1z13"/>finem haec fiant.</s>
					<s n="7" xml:lang="la">Sed qui cognorunt acta <placeName ref="l1107">Tridentinae</placeName> <lb xml:id="p1z14"/>synodi, intelligunt haec fieri ad occasionem <lb xml:id="p1z15"/>repetendi iura episcopalia et ut episcopus restituatur in <lb xml:id="p1z16"/>integrum per universam <placeName ref="l862">Helvetiam</placeName>, <placeName ref="l2481">Sveviam</placeName> et ducatum <lb xml:id="p1z17"/><placeName ref="l572">Wirtembergensem</placeName> invocato etiam brachio seculari.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z18"/>Repetet ille collegia, paroecias, coenobia et quicquid <lb xml:id="p1z19"/>huius generis est.</s>
					<s n="9" xml:lang="la">Nova ergo bella nobis bellanda instabunt.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/>Volunt isti videri pacis angeli; sed revera cornicin<lb xml:id="p1z21"/>es sunt, qui ad arma concinunt, et quidem sub <lb xml:id="p1z22"/>praetextu religionis quaeritur oppressio libertatis nostrae.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z23"/>Proinde confirmandi sunt nostrorum animi et orandus <lb xml:id="p1z24"/>sine intermissione dominus, ut nostri misertus <lb xml:id="p1z25"/>nos servet a malo.</s>
					<s n="12" xml:lang="la">Ex literis amicorum intelligo <lb xml:id="p1z26"/>legionem <placeName ref="l862">Helveticam</placeName> duci in <placeName ref="l2589">Piccardiam</placeName> ad tuendos <lb xml:id="p1z27"/>terminos <placeName ref="l832">Gallorum</placeName> contra <placeName ref="l875">Hispanorum</placeName> irruptiones.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z28"/><placeName ref="l875">Hispani</placeName> lente descendunt in <placeName ref="l808">Belgium</placeName>; nam non fidunt, <lb xml:id="p1z29"/>ne gubernatrici quidem, nedum proceribus <placeName ref="l808">Belgis</placeName> <lb xml:id="p1z30"/>et <placeName ref="l822">Germanis</placeName>; sed et velitari dicuntur cum peste <lb xml:id="p1z31"/>et dissenteria.</s>
					<s n="14" xml:lang="la">Dominus evertat prava consilia.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Imperator <lb xml:id="p1z32"/>ex podagra <placeName ref="l1204">Possovii</placeName> decumbit, necdum audio confirmatas <lb xml:id="p1z33"/>inducias cum <placeName ref="l2510">Turcis</placeName>, quas ne confirmentur, princeps <lb xml:id="p1z34"/><placeName ref="l869">Trannssylvanus</placeName> resistit.</s>
					<s n="16" xml:lang="la">Coniugium inter <placeName ref="l830">Anglam</placeName> et <lb xml:id="p1z35"/><persName ref="p18538">Carolum Austriacum</persName> audio confectum; sunt tamen, qui ambigant.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z36"/>Aiunt reginam <placeName ref="l2524">Scotiae</placeName> cum adultero et regis <lb xml:id="p1z37"/>caesore truncatam esse capite.</s>
					<s n="18" xml:lang="la">Certum alioqui est in regno <lb xml:id="p1z38"/><placeName ref="l830">Angliae</placeName> et <placeName ref="l2524">Scotiae</placeName> salvam et incolumem esse religionem.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">O<lb xml:id="p1z39"/>remus, mi frater, dominum, ut perpetuo nobis ad<lb xml:id="p1z40"/>s<lb xml:id="p1z41"/>it.</s>
					<s n="20" xml:lang="la" ana="salute">Saluta <persName ref="p20473">Ganthnerum</persName> et <persName ref="p6130">Pontasellam</persName> et hortare, <lb xml:id="p1z42"/>ut scribant aliquando.</s>
					<s n="21" xml:lang="la" ana="salute">Saluta consules humanissime.</s>
					<s n="22" xml:lang="la" ana="farewell"><lb xml:id="p1z43"/>Vale.</s>
					<s n="23" xml:lang="la">Dominus benedicat tuis laboribus.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 9. augusti <lb xml:id="p1z44"/>anno domini 1567.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z45"/><persName ref="p495">H[einrychus] Bullingerus</persName> senior.</s>
				</p>
				<p>
					<note type="address">[Adresse vor f. 486:]</note>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p4z1"/>Ornatissimo viro d. <persName ref="p8016">Tobiae <lb xml:id="p4z2"/>Eglio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p4z3"/>fideli ministro, domino meo <lb xml:id="p4z4"/>et fratri dilecto.</s>
				</p>
				<p>
					<s n="27" xml:lang="de"><lb xml:id="p4z5"/>An h[errn] <persName ref="p8016">Tobiam Egli</persName>, <lb xml:id="p4z6"/>pfarreren zuͦ S. Marti zuͦ <lb xml:id="p4z7"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
