	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Quoniam amicorum omnia communia sunt, <lb xml:id="p1z2"/><persName ref="p495">Bullingere</persName> in domino charissime, haudquaquam dubito <lb xml:id="p1z3"/>aliquam exilii mei curam animum tuum at<lb xml:id="p1z4"/>tingere.</s>
					<s n="3" xml:lang="la">Quapropter visum est paucis significare, <lb xml:id="p1z5"/>quo me procella illa abiecerit, <lb xml:id="p1z6"/>quae <placeName ref="l257">Constantiam</placeName> ex improviso subvertere <lb xml:id="p1z7"/>conabatur.</s>
					<s n="4" xml:lang="la">Interea dum ea civitas oppugnabatur <lb xml:id="p1z8"/>ab <placeName ref="l875">Hispanis</placeName>, iam acceptis uxore ac <lb xml:id="p1z9"/>liberis mirum in modum consternatis una <lb xml:id="p1z10"/>cum reliqua mulierum, puerorum ac peregri<lb xml:id="p1z11"/>norum multitudine civitatem, qua patebat, <lb xml:id="p1z12"/>egressus sum, et quoniam, ut peregrinus, <lb xml:id="p1z13"/>viarum eram ignarus, sequutus sum eos, <lb xml:id="p1z14"/>quibus me momentum illius egressionis <lb xml:id="p1z15"/>coniunxerat, parum referre cogitans, quor<lb xml:id="p1z16"/>sum essem eo itinere perventurus, modo <lb xml:id="p1z17"/>inter eos agerem, qui ab hostibus securi <lb xml:id="p1z18"/>existerent.</s>
					<s n="5" xml:lang="la">Veni itaque ad oppidulum quoddam, <lb xml:id="p1z19"/>quod vocant <placeName ref="l50">Episcopicellam</placeName>, illo cum venissem, <lb xml:id="p1z20"/>ceperunt aliqui ex liberis meis aegrotare, <lb xml:id="p1z21"/>haud quidem graviter, ita tamen, ut ultra <lb xml:id="p1z22"/>proficisci prohiberer.</s>
					<s n="6" xml:lang="la">Post triduum, quoniam <lb xml:id="p1z23"/>intelligebam <placeName ref="l473">Sangallum</placeName> uno tantum miliari distare <lb xml:id="p1z24"/>ab <placeName ref="l50">Episcopicella</placeName>, consilium cepi illo me cum uxore <lb xml:id="p1z25"/>ac liberis conferendi.</s>
					<s n="7" xml:lang="la">Scripsi ea de re ad <persName ref="p8049">Vadianum</persName>; <lb xml:id="p1z26"/>is misso ad me quodam evangelii ministro senatus <lb xml:id="p1z27"/>benevolentiam significavit.</s>
					<s n="8" xml:lang="la">Hanc amplexus <pb/><lb xml:id="p2z1"/>veni <placeName ref="l473">Sangallum</placeName>, ubi iam cum meis ago expertus <lb xml:id="p2z2"/>consilium domini, a quo non mea modo, sed <lb xml:id="p2z3"/>et omnium mortalium salus ac fortuna dependet.</s>
					<s n="9" xml:lang="la"><lb xml:id="p2z4"/>Interea commendo me precibus vestris et <lb xml:id="p2z5"/>fraternę dilectioni.</s>
					<s n="10" xml:lang="la">Si quid putaveris e <lb xml:id="p2z6"/>mea futurum posthac, in tempore significes, oro.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="salute">Optime <lb xml:id="p2z7"/>vale, virorum charissime, salutem uxori, liberis, frabribus, D. <persName ref="p8127">Pelicano</persName>, <persName ref="p8171">Theodoro</persName>, <persName ref="p8011">Gvalthero</persName> <lb xml:id="p2z8"/>ac reliquis.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><placeName ref="l473">Sangalli</placeName> 11. augusti 1548.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><persName ref="p8417">W[olfgangus] Musculus</persName>, tuus in <lb xml:id="p2z9"/>Christo.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="14" xml:lang="la">Ornatissimo viro D. <persName ref="p495">Heinrycho Bullingero</persName>, <placeName ref="l587">Tigurinę</placeName> eccles<lb xml:id="p2z10"/>iae ant<lb xml:id="p2z11"/>istiti vigilantissimo, <lb xml:id="p2z12"/>domino ac fratri charissimo.</s>
				</p>
			</div>
