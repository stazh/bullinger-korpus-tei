	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Redit <persName ref="p2811">Christophorus</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p2811">Christoph Rotacher</persName>.</note> tandem, ut vides, iuvenis certe bonus, quamvis foe<lb xml:id="p1z2"/>de me fefellerit<note xml:id="fn2" type="footnote" n="2">Vgl. <bibl source="b14">HBBW XI</bibl> <ref target="file11604">[Nr. 1561]</ref>, S. 303, 22-29 mit Anm. 12.</note>, falsus tamen longe foedius; scortum<note xml:id="fn3" type="footnote" n="3"><persName ref="p19462">Barbel Esslisperg</persName> oder Esslispach (s. ebd.).</note> enim, quod ad stuprum inno<lb xml:id="p1z3"/>centem coegit, id quod negare nunquam potuit, postquam uterum diutius circumges<lb xml:id="p1z4"/>tavit, interim etiam famulam agens, evanuit et a nemine non dicitur <lb xml:id="p1z5"/>nihil minus quam gravidam fuisse.</s>
					<s n="3" xml:lang="la">Quod si verum, quid aliud in animo fuit quam <lb xml:id="p1z6"/>me et illum infamare et omnibus exponere ludibrio?</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Quod is igitur peccavit, <lb xml:id="p1z7"/>stulticia fuit, non malicia, id quod tamen non in omnibus reperire est.</s>
					<s n="5" xml:lang="la">Quamobrem vi<lb xml:id="p1z8"/>detur omnino recipiendus ac fovendus, donec poterit vel in ludo vel <lb xml:id="p1z9"/>in ecclesia suum officium peragere.</s>
					<s n="6" xml:lang="la">Commendo igitur illum tibi et reliquis, quibus <lb xml:id="p1z10"/>cura demandata est scholarum; non dubium est enim, quin sic sit acturus deinceps, <lb xml:id="p1z11"/>ut, quod ante peccavit, facile in oblivionem deveniat.<pb type="edition" next="70"/></s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>De finitis comitiis et adparatu bellico<note xml:id="fn4" type="footnote" n="4">Der <placeName ref="l471">Speyrer</placeName> Reichstag endete am 11. April mit der Verlesung des Abschieds (RTA JR XII/2 1168-1210, <ref target="file10316">Nr. 285</ref>); zur letzten Phase der Verhandlungen und zur anschließenden Vorbereitung des Türkenfeldzugs s. <bibl source="b640">Traut</bibl> 35-46 bzw. 47-51.</note> nimirum mercatores vestri nun<lb xml:id="p1z13"/>ciarunt.</s>
					<s n="8" xml:lang="la">Digressi sunt per magnam, ut aiunt, concordiam; pecunię vis in<lb xml:id="p1z14"/>gens ubique colligitur, magna item multitudo hominum.</s>
					<s n="9" xml:lang="la"><persName ref="p19981">Papa</persName><note xml:id="fn5" type="footnote" n="5">Papst <persName ref="p19981">Paul III.</persName></note>, quod nescit, an <lb xml:id="p1z15"/>et <placeName ref="l834">Italiam</placeName> petiturus sit <persName ref="p18593">Turca</persName><note xml:id="fn6" type="footnote" n="6">Sultan <persName ref="p18593">Suleiman I.</persName></note> (classem enim ingentem habere congregatam dicitur), <lb xml:id="p1z16"/>promisit quinque tantum millia peditum, si <persName ref="p18538">imperator</persName><note xml:id="fn7" type="footnote" n="7">Kaiser <persName ref="p18538">Karl V.</persName></note> in expeditionem exiturus <lb xml:id="p1z17"/>sit, sin minus, partem dimidiam<note xml:id="fn8" type="footnote" n="8">Vgl. RTA JR XII/2 840.</note>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Concilium edicturus erat ad festum pen<lb xml:id="p1z18"/>tecostes<note xml:id="fn9" type="footnote" n="9">28. Mai.</note>, verum propius est, quam ut sic conveniat; differet usque ad assumptionis <lb xml:id="p1z19"/>Marię<note xml:id="fn10" type="footnote" n="10">15. August.</note>.</s>
					<s n="11" xml:lang="la">Quia vero cupit ipsemet interesse, civitates destinavit in <lb xml:id="p1z20"/><placeName ref="l834">Italia</placeName> <placeName ref="l1060">Mantuam</placeName>, <placeName ref="l150">Ferrariam</placeName>, <placeName ref="l55">Bononiam</placeName> seu <placeName ref="l1161">Placentiam</placeName>.</s>
					<s n="12" xml:lang="la">Quodsi cui pertinaciter <lb xml:id="p1z21"/>placeat <placeName ref="l822">Germania</placeName>, civitatem et hic nominat, <placeName ref="l1107">Tridentinum</placeName>.</s>
					<s n="13" xml:lang="la">Sic <persName ref="p17959">episcopus <lb xml:id="p1z22"/>Mutinensis</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p17959">Nuntius Giovanni Morone</persName>, Bischof von <placeName ref="l954">Modena</placeName>.</note> proposuit <placeName ref="l471">Spirę</placeName> principibus<note xml:id="fn12" type="footnote" n="12">Die Rede <persName ref="p17959">Morones</persName> vom 23. März ist gedruckt in: RTA JR XII/2 839-842, <ref target="file10184">Nr. 153</ref>; <bibl source="b171">CT</bibl> IV 218f, Nr. 175 (nur der das Konzil betreffende Teil); zu den daran anschließenden Diskussionen s. RTA JR XII/2 842-847, <ref target="file10185">Nr. 154</ref>-157 bzw. <bibl source="b171">CT</bibl> IV 219-221, Nr. 176-178. Vgl. Silvia <hi>Schweinzer,</hi> Das Ringen um Konzil und Kirchenreform. Die Mission des Nuntius Giovanni Morone auf dem Speyrer Reichstag 1542, in: Erich Meuthen (Hg.), Reichstage und Kirche, Göttingen 1991. - Schriftenreihe der Historischen Kommission bei der Bayerischen Akademie der Wissenschaften 42, S. 137-189.</note>.</s>
					<s n="14" xml:lang="la">Quid responsum sit, ignoro.</s>
					<s n="15" xml:lang="la">Hęc prioribus <lb xml:id="p1z23"/>literis<note xml:id="fn13" type="footnote" n="13">Oben <ref target="file11662">Nr. 1619</ref>.</note> adiecta volui.</s>
				</p>
				<p>
					<s n="16" xml:lang="la" ana="farewell">Vale cum tuis in domino.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><placeName ref="l28">Basileę</placeName>, raptim, 15. <lb xml:id="p1z24"/>aprilis anno 42.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z25"/><persName ref="p8418">Os. Myconius</persName> <lb xml:id="p1z26"/>tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho Bullingero</persName> <lb xml:id="p2z2"/>doctissimo, in domino <lb xml:id="p2z3"/>suo.</s>
				</p>
