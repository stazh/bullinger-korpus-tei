	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam et vitę innocentiam a deo patre et <lb xml:id="p1z2"/>domino nostro Iesu Christo.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Dici vix potest, <lb xml:id="p1z3"/>quam graviter affecti sint fratres tui deditiss<lb xml:id="p1z4"/>imi, optime <persName ref="p495">Bullingere</persName>, ob nullum <lb xml:id="p1z5"/>impetratum responsum<note xml:id="fn1" type="footnote" n="1"><persName ref="p2448">Pergener</persName> und seine <placeName ref="l580">Zittauer</placeName> Freunde hatten am 23. August 1542 an <persName ref="p495">Bullinger</persName> geschrieben; s. <bibl source="b15">HBBW XII</bibl>, <ref target="file11697">Nr. 1654</ref>.</note>.</s>
					<s n="3" xml:lang="la">Prolixas epistolas <lb xml:id="p1z6"/>non cupimus; quantę vigilię ministris <lb xml:id="p1z7"/>verbi dei apud <placeName ref="l587">Tigurum</placeName> immineant, <lb xml:id="p1z8"/>non ignoramus, brevissimam salutiun<lb xml:id="p1z9"/>culam petimus.</s>
					<s n="4" xml:lang="la">Doces nos quottidie, imo <lb xml:id="p1z10"/>et te quasi loquentem audimus in illis <lb xml:id="p1z11"/>tuis christianissimis commentariis in epistolas divi <lb xml:id="p1z12"/>Pauli,<note xml:id="fn2" type="footnote" n="2"><bibl source="b286">HBBibl</bibl> I 84f.</note> sic et in aliis libris: De scripturę <lb xml:id="p1z13"/>sanctę authoritate<note xml:id="fn3" type="footnote" n="3"><bibl source="b286">HBBibl</bibl> I 111.</note> etc., De origine erroris<note xml:id="fn4" type="footnote" n="4"><bibl source="b286">HBBibl</bibl> 12.</note> etc., De <lb xml:id="p1z14"/>utraque<note xml:id="fnb" type="footnote" n="b"><hi>In der Vorlage</hi> utraqua.</note> natura in Christo,<note xml:id="fn5" type="footnote" n="5">"Assertio utriusque in Christo naturae", <bibl source="b286">HBBibl</bibl> I 62.</note> De federe sem<lb xml:id="p1z15"/>piterno,<note xml:id="fn6" type="footnote" n="6">"De testamento seu foedere dei unico et aeterno", <bibl source="b286">HBBibl</bibl> I 54.</note> De offitio prophetę<note xml:id="fn7" type="footnote" n="7">"De prophetae officio", <bibl source="b286">HBBibl</bibl> I 33.</note>.</s>
					<s n="5" xml:lang="la">Docemur et iam <lb xml:id="p1z16"/>intelligere evangelium Mathei ex tuis <lb xml:id="p1z17"/>annotationibus<note xml:id="fn8" type="footnote" n="8"><bibl source="b286">HBBibl</bibl> 1144.</note>.</s>
					<s n="6" xml:lang="la">Duo habemus in hac urbe <lb xml:id="p1z18"/>exemplaria, expectamus plura.</s>
					<s n="7" xml:lang="la">Docet <lb xml:id="p1z19"/>nos quoque d. <persName ref="p8127">Chuonradus Pellicanus</persName> <lb xml:id="p1z20"/>in septem suis tomis super libros Biblię,<note xml:id="fn9" type="footnote" n="9">Zu <persName ref="p8127">Pellikans</persName> Kommentarwerk s. <bibl source="b15">HBBW XII</bibl> <ref target="file11689">[Nr. 1646]</ref>, S. 148f, Anm. 57.</note> <lb xml:id="p1z21"/>et in aliis idem faciunt sanctissimi martires <lb xml:id="p1z22"/>et viri <persName ref="p4091">Hul[drichus] Tzving[lius]</persName>, <persName ref="p2442">Ioh[annes] Oecolamp[adius]</persName>.</s>
					<s n="8" xml:lang="la">Parvam <lb xml:id="p1z23"/>abs te epistolam petimus.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Vale [cum]<note xml:id="fnc" type="footnote" n="c"><hi>Text beim Öffnen des Siegels beschädigt.</hi></note> d. <lb xml:id="p1z24"/><persName ref="p8127">Chuonrado Pellicano</persName>, <persName ref="p1753">Leone Jud</persName><note xml:id="fn10" type="footnote" n="10"><persName ref="p1753">Leo Jud</persName> war bereits am 19. Juni 1542 gestorben; vgl. <bibl source="b15">HBBW XII</bibl>, S. 99.</note>, <persName ref="p8412">Cas[pare] Megandro</persName> <lb xml:id="p1z25"/>et <persName ref="p8171">Bibliandro</persName> et tota ecclesia <placeName ref="l587">Tigurina</placeName>.</s>
					<s n="10" xml:lang="la" ana="salute"><lb xml:id="p1z26"/>Salutant vos quam plurimi fratres, <lb xml:id="p1z27"/>precipue <persName ref="p1412">Onofrius Strategus</persName>,<note xml:id="fn11" type="footnote" n="11"><persName ref="p1412">Onofrius Herzog</persName>.</note> <persName ref="p8376">Celestinus <lb xml:id="p1z28"/>Hennig</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Datum <placeName ref="l580">Zitte</placeName>, octavo die mensis <lb xml:id="p1z29"/>februarii anno etc. 43.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z30"/><persName ref="p2448">Osvaldus Pergenerus</persName> <lb xml:id="p1z31"/>a commentariis<note xml:id="fn12" type="footnote" ana="lex" n="12">Stadtschreiber.</note> etc.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="13" xml:lang="la"><pb/><lb xml:id="p2z1"/>Vere pio et erudito viro <lb xml:id="p2z2"/>d. <persName ref="p495">Heinricho Bullingero</persName>, <lb xml:id="p2z3"/>amplissimę ecclesię <lb xml:id="p2z4"/><placeName ref="l587">Tigurinę</placeName> episcopo, fratri <lb xml:id="p2z5"/>charissimo.</s>
				</p>
			</div>
