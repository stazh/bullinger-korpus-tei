	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi literas de occupato <placeName ref="l301">Lugduno</placeName> maximo <lb xml:id="p1z2"/>cum gaudio.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Dominus sit gloria et laus; is frangat <lb xml:id="p1z3"/>contumatiam impiorum impiissimam.</s>
					<s n="4" xml:lang="la">Pro literis <lb xml:id="p1z4"/>illis tuis ago humanitati tuae, vir honrande, <lb xml:id="p1z5"/>gratias maximas, cum symmystarum tum meo nomine, <lb xml:id="p1z6"/>et oro ut ita pergas summa rerum gestarum capita <lb xml:id="p1z7"/>vel per te vel per <persName ref="p4440">Budaeum</persName> aut <persName ref="p8078">Ionvillęum</persName> <lb xml:id="p1z8"/>scribere et mature mittere.</s>
					<s n="5" xml:lang="la">D. <persName ref="p629">Coignetius</persName> literas <lb xml:id="p1z9"/>nostras <lb xml:id="p1z10"/>optime curat.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Is etiam se optime in hac causa <lb xml:id="p1z11"/>gessit et gerit adhuc, regi et <persName ref="p8315">Condensi</persName> fidelis.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Quod facit iussus literis adulterinis et <persName ref="p8621">Guysiacis</persName> <lb xml:id="p1z13"/>frigide facit, ita ut a <placeName ref="l2448">5 Pagicis</placeName> pessim<lb xml:id="p1z14"/>e audiat.</s>
					<s n="8" xml:lang="la">Sed confirmo illum subinde literis <lb xml:id="p1z15"/>scriptis.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Cur autem nunc scribam haec pot<lb xml:id="p1z16"/>issimum est causa.</s>
					<s n="10" xml:lang="la">Mittit ad me literas illustrissimus <lb xml:id="p1z17"/><persName ref="p3590">Hessorum</persName> princeps per proprium nuncium.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Cupit <lb xml:id="p1z18"/>a me erudiri et certior fieri rerum <placeName ref="l832">Gallicarum</placeName>, <lb xml:id="p1z19"/>cum in <placeName ref="l213">Hassia</placeName> spargantur tam varii ru<lb xml:id="p1z20"/>mores.</s>
					<s n="12" xml:lang="la">Cupit scire quid sentiam de causa <persName ref="p8315">Condei</persName>, <lb xml:id="p1z21"/>et an defensio eius iusta sit mihique videatur legitim<lb xml:id="p1z22"/>a.</s>
					<s n="13" xml:lang="la">Expono itaque ei negotium ita ut accepi <lb xml:id="p1z23"/>ex te et ex <placeName ref="l832">Gallia</placeName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Mitto <persName ref="p8315">Condei</persName> declarationem et protestatio<lb xml:id="p1z24"/>nem cum foedere.</s>
					<s n="15" xml:lang="la">Defendo pluribus <persName ref="p8315">Condei</persName> causam, <lb xml:id="p1z25"/>ostendo talem esse contra <persName>Conestabilem</persName> et <persName ref="p20858">Guysiacum</persName> <lb xml:id="p1z26"/>qualis Ioiadae fuit contra Athaliam.</s>
					<s n="16" xml:lang="la">Hortor <lb xml:id="p1z27"/>ne sigillo regis falso credat.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Hortor ne militem <lb xml:id="p1z28"/>concedat, aut equites in <placeName ref="l832">Galliam</placeName> contra <persName ref="p8315">Condeum</persName> <lb xml:id="p1z29"/>mittat imo ut impediat potius apud omnes principes <lb xml:id="p1z30"/>et vicinos, <persName>Conestabilis</persName> et <persName ref="p20858">Guysii</persName> parricidia et <lb xml:id="p1z31"/>nepharia contra regem et regnum consilia vicinis <lb xml:id="p1z32"/>exponat.</s>
					<s n="18" xml:lang="la">Literae principis scriptae sunt 24. aprilis <lb xml:id="p1z33"/><placeName ref="l2401">Giessae</placeName> in <placeName ref="l213">Hassia</placeName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Narrat praeterea in li<lb xml:id="p1z34"/>teris suis, <persName ref="p20858">Guysium</persName> cum <placeName>Navarro</placeName> misisse ad <lb xml:id="p1z35"/>ipsum, petitum equites.</s>
					<s n="20" xml:lang="la">Misit una totam actionem <lb xml:id="p1z36"/>legati.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Eam uti accepi ab ipso inclusi his <lb xml:id="p1z37"/>et oro ut mature mittas ad ill.</s>
					<s n="22" xml:lang="la">principem <lb xml:id="p1z38"/>Conden[sem].</s>
					<s n="23" xml:lang="la">Habebit qui interpretentur, vel illum <placeName>Bernatem</placeName> <lb xml:id="p1z39"/>nobilem ab <placeName ref="l993">Erlach</placeName>.</s>
					<s n="24" xml:lang="la">Mihi videretur <lb xml:id="p1z40"/>utile si mitteret ad <persName ref="p3590">Lantgravium</persName> vel literas, vel legatum <pb/><lb xml:id="p2z1"/>qui exponeret universum negotium.</s>
					<s n="25" xml:lang="la">For<lb xml:id="p2z2"/>tassis iam misit.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">Nam, quod modo dixi, prin<lb xml:id="p2z3"/>cipis literae datae sunt <placeName ref="l2401">Giessae</placeName> 24. aprilis.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><lb xml:id="p2z4"/>Cras ego iterum ablegabo nuncium eius literis <lb xml:id="p2z5"/>onustum et hortor ut festinet.</s>
					<s n="28" xml:lang="la">Si scripseris <lb xml:id="p2z6"/>in <placeName ref="l832">Galliam</placeName> commendabis me illustr.</s>
					<s n="29" xml:lang="la">principi <lb xml:id="p2z7"/><persName ref="p8315">Condeo</persName>, cui deus sapientiam et robur <lb xml:id="p2z8"/>et constantiam conferat oro.</s>
				</p>
				<p>
					<s n="30" xml:lang="la" ana="salute">Salutabis charissimum <lb xml:id="p2z9"/>fratrem <persName ref="p8033">Bezam</persName>, pro cuius salute sedulo precamur <lb xml:id="p2z10"/>dominum.</s>
					<s n="31" xml:lang="la">Dominus eius ministerio utitur ad <lb xml:id="p2z11"/>res maximas.</s>
				</p>
				<p>
					<s n="32" xml:lang="la">Benedicat ei dominus et servet eum.</s>
				</p>
				<p>
					<s n="33" xml:lang="la"><lb xml:id="p2z12"/>Fama defertur ad nos <placeName ref="l2448">Quinquepagicos</placeName> ini<lb xml:id="p2z13"/>quissime ferre remoram quam eis iniecerunt <lb xml:id="p2z14"/><placeName ref="l587">Tigurini</placeName> et <placeName ref="l41">Bernates</placeName>.</s>
					<s n="34" xml:lang="la">Clamant: ideo impe<lb xml:id="p2z15"/>diverunt nos ut interea pereant nostri una <lb xml:id="p2z16"/>cum antiqua religione.</s>
					<s n="35" xml:lang="la">Atque o utinam, o si etc.</s>
				</p>
				<p>
					<s n="36" xml:lang="la"><lb xml:id="p2z17"/>Aliis incipit languescere fervor cum au<lb xml:id="p2z18"/>diunt <placeName ref="l301">Lugdunum</placeName> a nostris esse occupatum.</s>
					<s n="37" xml:lang="la">Alii <lb xml:id="p2z19"/>dicunt se militem in <placeName ref="l832">Galliam</placeName> missuros, si <lb xml:id="p2z20"/>prius ipsis satisfactum sit per omnia.</s>
					<s n="38" xml:lang="la">Audio <lb xml:id="p2z21"/>autem summam debiti excrescere ad duas <lb xml:id="p2z22"/>auri tinnas[!?].</s>
					<s n="39" xml:lang="la">Scio autem, quam expilarint <lb xml:id="p2z23"/>exhauserintque <persName ref="p20858">Guysii</persName> aerarium regium.</s>
				</p>
				<p>
					<s n="40" xml:lang="la">Quidam <lb xml:id="p2z24"/>arbitrantur omnino legionem ducendam fore.</s>
					<s n="41" xml:lang="la"><lb xml:id="p2z25"/>Ita urget et satagit <persName ref="p8354">Frölichius</persName> capitaneus <lb xml:id="p2z26"/>quo nomine invisissimus est <persName ref="p629">Cognetio</persName>.</s>
				</p>
				<p>
					<s n="42" xml:lang="la">Ac dicitur <lb xml:id="p2z27"/><persName>Frölichio</persName> dixisse, meminerit beneficiorum acceptorum <lb xml:id="p2z28"/>ex <placeName ref="l832">Gallia</placeName>, et quod <persName>Navarrus</persName>, <persName>Conestabilis</persName>, <lb xml:id="p2z29"/><persName ref="p20858">Guysius</persName> et <persName>Maleschalkus</persName> non sint <placeName ref="l832">Gallia</placeName>, sed <lb xml:id="p2z30"/>potior pars sit ex parte adversa.</s>
					<s n="43" xml:lang="la">Praestat <lb xml:id="p2z31"/>haec scire <persName ref="p8315">Condeum</persName>, ne nimis cunctando <lb xml:id="p2z32"/>occasionem commode agendi amittat, negotiumque <lb xml:id="p2z33"/>absolvat et regem cum regina <placeName ref="l378">Lutetiamque</placeName> re<lb xml:id="p2z34"/>cuperet, priusquam exteri milites <placeName ref="l832">Galliam</placeName> <lb xml:id="p2z35"/>ingrediantur.</s>
				</p>
				<p>
					<s n="44" xml:lang="la">Sed haec omnia tuae commendo prudentiae.</s>
					<s n="45" xml:lang="la"><lb xml:id="p2z36"/>Anxie expectamus quid factum <placeName ref="l378">Lutetiae</placeName>.</s>
				</p>
				<p>
					<s n="46" xml:lang="la" ana="farewell"><lb xml:id="p2z37"/>Vale cum omnibus fratribus.</s>
				</p>
				<p>
					<s n="47" xml:lang="la">Dominus benedicat tibi, vir <lb xml:id="p2z38"/>honorande et frater charissime.</s>
				</p>
				<p>
					<s n="48" xml:lang="la" ana="salute">Omnes nostri te et tuos <lb xml:id="p2z39"/>salutant.</s>
				</p>
				<p>
					<s n="49" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 12. maii 1562.</s>
				</p>
				<p>
					<s n="50" xml:lang="la"><lb xml:id="p2z40"/><persName ref="p495">Heinrychus Bullingerus</persName> <lb xml:id="p2z41"/>tuus.</s>
				</p>
				<p>
					<note>[Adresse vor f. 427:]</note>
					<s n="51" xml:lang="la"><pb/><lb xml:id="p4z1"/>Clarissimo viro d. <persName ref="p540">Ioanni <lb xml:id="p4z2"/>Calvino</persName>, <placeName ref="l167">Genevensis</placeName> <lb xml:id="p4z3"/>ecclesiae fidelissimo <lb xml:id="p4z4"/>pastori et eo absente d. <persName ref="p8305">Ioanni Budaeo</persName> vel <lb xml:id="p4z5"/><persName ref="p8078">Ioanni Ionvillęo</persName>, dominis honorandis et fra<lb xml:id="p4z6"/>tribus charissimis meis.</s>
					<s n="52" xml:lang="de"><lb xml:id="p4z7"/><placeName ref="l167">Genff</placeName>.</s>
				</p>
			</div>
