	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>S. D. Satis equidem liberaliter fidem tuam
					<lb xml:id="p1z2"/>liberasti, vir clarissime, docta et amplari
					<lb xml:id="p1z3"/>tua ad Bernhardinum responsione nec
					<lb xml:id="p1z4"/>dubito, quin non modo voluptatem, sed etiam
					<lb xml:id="p1z5"/>fructu inde uberrimum sit percepturus
					<lb xml:id="p1z6"/>Ego tamen, tantum abest, ut inde satuner
					<lb xml:id="p1z7"/>multo ampliora et copiosiora exta
					<lb xml:id="p1z8"/>liberali penum expecto et desidero, adeo
					<lb xml:id="p1z9"/>ut hac in parte facile avam hominum
					<lb xml:id="p1z10"/>notam mihi muri patrar, qui nunquam
					<lb xml:id="p1z11"/>satiari possit, praesertim cum plures sint
					<lb xml:id="p1z12"/>famelici, qui mecum eundem fructum
					<lb xml:id="p1z13"/>sunt percepturi. Quare tua humanitatem
					<lb xml:id="p1z14"/>plurimum rogarim, oportunitatem temporum
					<lb xml:id="p1z15"/>observans, in communem usum aliquid
					<lb xml:id="p1z16"/>depromas. Porro domum reversus
					<lb xml:id="p1z17"/>accepi per propeium tabellarium responsum.
					<lb xml:id="p1z18"/>Lantgravii, qui nonnihil apertius quale
					<lb xml:id="p1z19"/>exoptarit concilium exponit. huius exempla
					<lb xml:id="p1z20"/>tibi mitto, simile quoque ad Bernhardum
					<lb xml:id="p1z21"/>uncum tuis literis mittam. Ex Grallii
					<lb xml:id="p1z22"/>nihildum certi habeo. Corgnetius legatum
					<lb xml:id="p1z23"/>Gallicus sua curando publica negliger
					<lb xml:id="p1z24"/>videtur. His diebus per mercatores
					<lb xml:id="p1z25"/>audivi Iugduni novas turbas cum
					<lb xml:id="p1z26"/>clericis exoriri, indies plura percipie
					<lb xml:id="p1z27"/>quicquid tamen id fuerit te non celabo.
					<pb/>
					<lb xml:id="p2z1"/>Fetur quoque apud nos pontificem meditar
					<lb xml:id="p2z2"/>quopecto dominum de quis vicinum nostri
					<lb xml:id="p2z3"/>evehat in episcopum Constantiensem et
					<lb xml:id="p2z4"/>cum difficulter id propter Meßlerum possit iam
					<lb xml:id="p2z5"/>effici, hoc tamen mortuo, certo tame ille
					<lb xml:id="p2z6"/>canonicorum electione repudrata subtint,
					<lb xml:id="p2z7"/>quam ob causam episcopus et
					<lb xml:id="p2z8"/>conovici frement, et ut audio in
					<lb xml:id="p2z9"/>proximo Badensi conventu implorabunmt
					<lb xml:id="p2z10"/>Helvetiorum consilium, cum bona pars
					<lb xml:id="p2z11"/>preatuam in terris Helvetiorum sit
					<lb xml:id="p2z12"/>aliqui etiam canonici sunt
					<lb xml:id="p2z13"/>oriandi ex Helvetiis, qui hoc pasto
					<lb xml:id="p2z14"/>non ite procederet electio a spe
					<lb xml:id="p2z15"/>episcopatus deciderent. protia prudentia
					<lb xml:id="p2z16"/>facile intelligis, hoc, si pontifici sucee
					<lb xml:id="p2z17"/>quid nobis inde expectandum
					<lb xml:id="p2z18"/>foret. Sed dominum rogabimus, ut
					<lb xml:id="p2z19"/>hum consilia dissipet. Vale foeliciter
					<lb xml:id="p2z20"/>et meis verbis honorifice resalutabis
					<lb xml:id="p2z21"/>Gvaltherum. Vale. iterum 27. augusti.
					<lb xml:id="p2z22"/>annno 1540.
					<lb xml:id="p2z23"/>Tuus ex animo
					<lb xml:id="p2z24"/>Martinus Peyer.
					<pb/>
					<lb xml:id="p4z1"/>Doctissimo atque vigilantissimo,
					<lb xml:id="p4z2"/><placeName ref="l587">Tigurinae</placeName> ecclesiae pastori
					<lb xml:id="p4z3"/>domino Henrico Bullingero,
					<lb xml:id="p4z4"/>amico suo plerimum
					<lb xml:id="p4z5"/>observando.
