	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Libellum hunc ad te mitto, vir optime, doctissime, qui eetsi <lb xml:id="p1z2"/><persName ref="p506">Iohanni Butlero</persName> vestrati sit nuncupatus, tamen hic <lb xml:id="p1z3"/>aeditus est, neque existimo eum hoc tempore apud vos <lb xml:id="p1z4"/>prostare venalem.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Verum, etsi maxime videris, <lb xml:id="p1z5"/>meum nihilominus animum erga te benevolum <lb xml:id="p1z6"/>tuique memorem cognosces.</s>
					<s n="4" xml:lang="la">Argumentum libelli pium <lb xml:id="p1z7"/>est <lb xml:id="p1z8"/>et e medio procellarum turbatę ecclesiae sumptum mihi<lb xml:id="p1z9"/>que multum lucis attulit in eadem re intellegenda, <lb xml:id="p1z10"/>ita ut satisfactum esse mihi existimen.</s>
					<s n="5" xml:lang="la">Placet <lb xml:id="p1z11"/>admodum ipsum etiam scripti genus in re theologica, <lb xml:id="p1z12"/>purum, Latinum, elegans.</s>
					<s n="6" xml:lang="la">Hunc itaque, ut <lb xml:id="p1z13"/>dixi, libellum a me tanquam tui studioso accipies.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Rerum novarum nihil habeo; sunt quaedam, sed in<lb xml:id="p1z15"/>certa; praeterea neque me <foreign xml:lang="el">[griechi<lb xml:id="p1z16"/>sch]</foreign> in his rebus exhibeo.</s>
					<s n="8" xml:lang="la" ana="farewell">Vale et me domino precibus <lb xml:id="p1z17"/>tuis commenda.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><placeName ref="l28">Basilaee</placeName> 19. septembris <lb xml:id="p1z18"/>anno etc. 49.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z19"/><persName ref="p2039">Michael Maleriu<lb xml:id="p1z20"/>s</persName> <lb xml:id="p1z21"/>doctor.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro optimo, doctissimo domino <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, theologo et ecclesiae <placeName ref="l587">Tigurin<lb xml:id="p2z3"/>ae</placeName> pastori fideli<lb xml:id="p2z4"/>.</s>
				</p>
			</div>
		</body>
	</text>
