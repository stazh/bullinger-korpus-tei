	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Cum vesperi domum redirem, ex adverso in legatum incidi, <lb xml:id="p1z2"/>qui literas in manibus gestabat, quae ei ex <placeName ref="l832">Gallia</placeName> modo <lb xml:id="p1z3"/>erant redditae, in quibus perscriptum erat magnam esse <lb xml:id="p1z4"/>adhuc spem pacis.</s>
					<s n="2" xml:lang="la">Qui vero de pace agunt, convenerunt <lb xml:id="p1z5"/>non in <placeName ref="l2165">Arras</placeName>, ut co(n?) stitutum erat, sed in civitate <lb xml:id="p1z6"/>nomine <placeName>Insula</placeName>.</s>
					<s n="3" xml:lang="la">Literae perscriptae 14. die huius mensis.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z7"/>Rex vero <persName>Gallus</persName>, quin interim per proditionem accepisset <lb xml:id="p1z8"/><placeName>Sant Omer</placeName>, parum, imo minimum abfuit.</s>
					<s n="5" xml:lang="la">Nullae sunt <lb xml:id="p1z9"/>inducię; exercitus uterque in conspectu mutuo se <lb xml:id="p1z10"/>velitationibus exercet etc.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Agri quoque vicini <lb xml:id="p1z11"/>populationibus et incursionibus passim vastantur.</s>
				</p>
				<p>
					<note type="address">[Adresse etc. fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
