	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Nihil propemodum sese offerret et dignum significatu, praesertim cum <lb xml:id="p1z2"/>paucos ante dies h[umanitati] t[uae] rescripserim, nisi literis, quae hodie <lb xml:id="p1z3"/>allatę sunt, respondendum brevibus putassem.</s>
					<s n="3" xml:lang="la">De pace, quam Veneti <lb xml:id="p1z4"/>redemisse dicuntur, nihil audivi et vix puto tanti ipsos <lb xml:id="p1z5"/>poenitere empturos.</s>
					<s n="4" xml:lang="la"><persName ref="p19981">Papam</persName>, quem <persName ref="p18515">Innocentium</persName> <lb xml:id="p1z6"/>dixi, <persName>Pium III.</persName> vocatum esse non dubito, quin pridem resciveris <lb xml:id="p1z7"/>eumque e familia <persName>Mediceus</persName> <placeName ref="l306">Mediolanensium</placeName> esse.</s>
					<s n="5" xml:lang="la">Concilium <lb xml:id="p1z8"/><placeName ref="l306">Mediolani</placeName> aut etiam alibi ipsum celebraturum vulgo fertur.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z9"/>Gallici motus, si rem (quantum mihi licet scire) penitius <lb xml:id="p1z10"/>inspecto, iure quodammodo mihi enasci videntur.</s>
					<s n="7" xml:lang="la" ana="salute">Dominus hęc omnia <lb xml:id="p1z11"/>ad gloriam sui nominis suique salutem vertat, prout certissime <lb xml:id="p1z12"/>vertet.</s>
					<s n="8" xml:lang="la"><persName ref="p18554">Anglię reginę</persName> procos nunc <persName ref="p18538">Carolum</persName>, nunc <persName ref="p18477">Ferdinan<lb xml:id="p1z13"/>dum</persName> dixere; ego ambos spe frustratos iri puto; multa <lb xml:id="p1z14"/>hactenus de illis nuptiis futuris ferebantur, apparabantur dona <lb xml:id="p1z15"/>varia vel potius apparari dicebantur; nunc omnia conticuerunt.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>Apud nos nunc fere omnia silent; interim (ut alias etiam <lb xml:id="p1z17"/>scripsi) passim miles conscribitur clanculum.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><placeName ref="l361">N orenbergenses</placeName> <lb xml:id="p1z18"/>sibi suisque timent, implorant confoederatos; nihildum <lb xml:id="p1z19"/>tamen horum omnium aperte geritur.</s>
					<s n="11" xml:lang="la"><persName>Ducem de Blaw</persName>, filii <persName>Io. Frid</persName>. <lb xml:id="p1z20"/>ducis <placeName ref="l749">Saxonię</placeName> d[ivae]memorię ad quos ea ditio ante spectabat, <lb xml:id="p1z21"/>se eiecturos minantur.</s>
					<s n="12" xml:lang="la">Sed alia interim aguntur; ex <lb xml:id="p1z22"/>parvis initii maximi plerumque extitere motus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Ex <placeName ref="l808">Belgico</placeName> i<lb xml:id="p1z23"/>am diu nihil affertur novi; indicium res non prorsus pro voluntate <lb xml:id="p1z24"/>succedere.</s>
					<s n="14" xml:lang="la" ana="farewell">Vale in domino felicissime, qui nos omnes valere <lb xml:id="p1z25"/>faciat.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Datum <placeName ref="l18">Augustę Vindelicorum</placeName> communi errore dictę, cum vere <lb xml:id="p1z26"/><placeName ref="l648">Rhetię</placeName> sit, 16. februarii anno 1560.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z27"/>R[everentiae] t[uae] observantissimus <persName ref="p3740">Georgius a <lb xml:id="p1z28"/>Stetten iunior</persName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><persName>C. <lb xml:id="p1z29"/>Singero</persName> rescribere etiam nunc tempore exclusus non potui; <lb xml:id="p1z30"/>salutabis eum nihilominus meo nomine.</s>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Venerando atque erudito viro <lb xml:id="p2z2"/>domino <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p2z3"/>domino et amico suo colendo.</s>
					<s n="19" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
