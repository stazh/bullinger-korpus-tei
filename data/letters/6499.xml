	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratia filii dei tecum.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Cum noster <persName ref="p1137">Chunradus <lb xml:id="p1z2"/>Functius</persName>, <placeName ref="l335">Mylhusanę</placeName> minister ecclesię, <lb xml:id="p1z3"/>a nundinis <placeName ref="l491">Argentoratensibus</placeName> properans <lb xml:id="p1z4"/>domum apud me pernoctaret significassetque <lb xml:id="p1z5"/>se brevi ad te iturum, hasce ad te dare volui, <lb xml:id="p1z6"/>humanissime <persName ref="p495">Bullingere</persName>, atque oro, si tua Repetitio <lb xml:id="p1z7"/>in <persName ref="p458">Brentium</persName> solem videre nequit, remittatur <lb xml:id="p1z8"/>matronę; habebit spelaeum, quo abdatur.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z9"/><persName ref="p3988">Ioannem Wolffium</persName> sedulo monebis<foreign xml:lang="el">ἐγκυκλοπαι<lb xml:id="p1z10"/>δίαν</foreign> quamprimum et fęliciter absolvere, <lb xml:id="p1z11"/>ut scholae aliquando pręficiatur reique <lb xml:id="p1z12"/>publicę sementarium instituat etc.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Alter eius <lb xml:id="p1z13"/>collega <persName>Regius</persName> Basileę, ut audio, <lb xml:id="p1z14"/>hęrebit suspenso studio et artibus postergatis.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z15"/>Constans rumor et suspitio dissipatur, <lb xml:id="p1z16"/>cum habitet apud benignam, aut si mavis, <lb xml:id="p1z17"/>si verum est, quod fertur, malignam domini <lb xml:id="p1z18"/><persName>Thomę</persName> bonę memorie <persName>Girfalckum</persName><note xml:id="fn1" type="footnote" n="1">vielleicht - falckn für - falckensis</note> viduam <lb xml:id="p1z19"/>duxisse uxorem.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Quod si verum, studium <lb xml:id="p1z20"/>illius habebit stultum in supino.</s>
					<s n="7" xml:lang="la">Nostrum <lb xml:id="p1z21"/><persName ref="p1137">Chunradum</persName> tuę pietati commendo, qui referet <lb xml:id="p1z22"/>nostrum statum.</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute">Vale et saluta fratres omnes, <lb xml:id="p1z23"/>d. <persName ref="p8011">Gvaltherum</persName>, tuos generos ac familiam, <lb xml:id="p1z24"/>ac orate pro capulari sene.</s>
					<s n="9" xml:lang="de">Die 18. iulii 65.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z25"/>Tuus <persName ref="p1010">Erbius</persName>.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><pb/><lb xml:id="p2z1"/>Viro pietate, eruditione <lb xml:id="p2z2"/>sanctaque vita eximio <lb xml:id="p2z3"/>d. <persName ref="p495">Henrycho Bullingero</persName>, <lb xml:id="p2z4"/>syncero theologo <lb xml:id="p2z5"/>inclytęque urbis <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z6"/>antistiti fideli, <lb xml:id="p2z7"/>suo frat<lb xml:id="p2z9"/>r<lb xml:id="p2z10"/>i.</s>
				</p>
			</div>
		</body>
	</text>
