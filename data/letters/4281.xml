			<zone xml:id="p2z3-0" points="1187,1512 1365,1548 1437,1512 1507,1536 1566,1502 1754,1491 1937,1515 1937,1444 1838,1409 1601,1463 1518,1417 1187,1457">1194,1495 1231,1495 1268,1495 1305,1495 1343,1495 1380,1495 1417,1495 1455,1495 1492,1493 1529,1492 1567,1491 1604,1489 1641,1489 1678,1489 1716,1489 1753,1489 1790,1489 1828,1489 1865,1489 1902,1494 1940,1504</zone>
