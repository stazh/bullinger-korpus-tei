					<lb xml:id="p1z8"/>anque magit addeliter dilegintia
					<lb xml:id="p1z9"/>potui, qui perferet, reperiu. egcopopr
					<lb xml:id="p1z10"/>secem some hic nunus habebes quam et
					<lb xml:id="p1z11"/>et omne fratres me excusatem.
					<lb xml:id="p1z12"/>et quod sciam inter frictisses vissidium
					<lb xml:id="p1z13"/>ex Bitlero audivi, nuper literas hui
					<lb xml:id="p1z14"/>alletos Virtembergenses valde bonas, quelus
					<lb xml:id="p1z15"/>deularit se cene cuper ecclesiis Gallię
					<lb xml:id="p1z16"/>de Augupio et advisi bianc audeo, pui
					<lb xml:id="p1z17"/>ecclesias attinet, imo i ipsis pamiliis
					<lb xml:id="p1z18"/>legaturum principum, a quibus rediit Her.
					<lb xml:id="p1z19"/>noster legate cesteris Bilelum lellum
					<lb xml:id="p1z20"/>etsolit ostrus p. sed reliqui sequisscim.
