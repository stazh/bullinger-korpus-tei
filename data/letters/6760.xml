	<text xml:lang="la">
		<body>
			<div>
				<p>
					<lb xml:id="p1z1"/>Binae a te redditae sunt mihi literae, quibus pristinum tuum erga
					<lb xml:id="p1z2"/>me amorem facile recognovi, quem mihi iampridem bene perpectum
					<lb xml:id="p1z3"/>singulari tua humanitate omnibus officiis testatum reddis navietę
					<lb xml:id="p1z4"/>quae de Germania scribis plaraque mihi comperta eramt non
					<lb xml:id="p1z5"/>dissimulabo iudicium illud tuum de Germanicis convittibus mihi admodu
					<lb xml:id="p1z6"/>probari allata sum mihi nonnulla alia ex Germania, quae Hurici
					<lb xml:id="p1z7"/>sormano  filio cuius prudens moditatumque ingenium mihi non parum
					<lb xml:id="p1z8"/>probaturum communicavi, simulque nonnullam alia, quae meis vebis terum
					<lb xml:id="p1z9"/>aeger cigeliu tatum fidiisaltcas, quantur ipe mihi prostares
					<lb xml:id="p1z10"/>Rene vale vir amplissime Salodiui ordminum aprilis 1566.
					<lb xml:id="p1z11"/>Psurmam salutem, domino Cis ex animo
					<lb xml:id="p1z12"/>Gvaltero,
					<lb xml:id="p1z13"/>Zeilliator.
					<lb xml:id="p1z14"/>S.
					<pb/>
					<lb xml:id="p4z1"/>Reverando domino
					<lb xml:id="p4z2"/>d. Henrico Bullingero,
					<lb xml:id="p4z3"/>ecclesiae Tigurinae
					<lb xml:id="p4z4"/>pastori dignissimo.
				</p>
			</div>
		</body>
	</text>
