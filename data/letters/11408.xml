	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p179">Hermannus Aquilomontanus</persName> d. <persName ref="p495">Henrico Bullingero</persName> s[alutem] d[icit].</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Literas<note xml:id="fn1" type="footnote" n="1"><bibl source="b11">HBBW IX</bibl>, <ref target="file11337">Nr. 1294</ref>.</note> prolixas ad te misi in nundinis posterioribus<note xml:id="fn2" type="footnote" n="2">Am 10. August 1539 (zum Termin der <placeName ref="l157">Frankfurter</placeName> Herbstmesse s. <bibl source="b8">HBBW VI</bibl> <ref target="file10925">[Nr. 884]</ref>, S. 406, Anm. 5).</note>, virorum optime, quibus <lb xml:id="p1z3"/>tuam amicitiam ambivi et in dubiis meis resolutionem.</s>
					<s n="3" xml:lang="la">Decet enim manus adiutrice<lb xml:id="p1z4"/>s mutuo<note xml:id="fna" type="footnote" n="a">mutuo <hi>über der Zeile nachgetragen.</hi></note> <lb xml:id="p1z5"/>porrigere, postquam in eadem navi simus<note xml:id="fn3" type="footnote" n="3"><bibl source="b56">Adagia</bibl>, 2, 1, 10 (<bibl source="b370">LB</bibl> II 410).</note>.</s>
					<s n="4" xml:lang="la">Spero te pro tua humanitate in<lb xml:id="p1z6"/>nata paucis modo respondisse.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Nunc hic de pedobaptismi necessitate <lb xml:id="p1z7"/>certamen exortum est.</s>
					<s n="6" xml:lang="la" ana="salute">Quidam necessario urgent<note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> urgent <hi>gestrichenes</hi> virge.</note> et salutem alligant.</s>
					<s n="7" xml:lang="la" ana="salute"><lb xml:id="p1z8"/>Ego quidem salutem uni Christo affixam respondi, non elementis, nec velle <lb xml:id="p1z9"/>obstetrices baptisare, sed omne sanctum offitium coram ecclesia agendum publice <lb xml:id="p1z10"/>fieri desiderabam et nullo modo infantes damnari, si non baptisentur, sed <lb xml:id="p1z11"/>parentes in culpa, qui institutionem domini negligant aut vilipendant.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z12"/>Hic moris est in dominica tantummodo tingi infantes.</s>
					<s n="9" xml:lang="la" ana="salute">Desideravi, ut tum <lb xml:id="p1z13"/>coram ecclesia adferantur simpliciter et gratie agantur domino de dono et <lb xml:id="p1z14"/>liberatione summi doloris, et si interim moriantur, domino commendentur, <lb xml:id="p1z15"/>ne videamur<note xml:id="fnc" type="footnote" n="c"><hi>in der Vorlage</hi> videamus.</note> salutem alligare elemento aut actioni externe.</s>
					<s n="10" xml:lang="la">Scio quidem <lb xml:id="p1z16"/>institutionem domini; sed sub<note xml:id="fnd" type="footnote" n="d"><hi>vor</hi> sub <hi>gestrichenes</hi> s.</note> lege rursum redigimur, si ita mandato astringa<lb xml:id="p1z17"/>mur, cum charitas et fides non exigant.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">Habes meam sententiam, vir amabilis; <lb xml:id="p1z18"/>precor, tuam limam et castigationem adiungas.</s>
					<s n="12" xml:lang="la">Malo doceri quam instituere.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z19"/>Vale, diligentissime pastor, cum cooperariis omnibus.</s>
					<s n="14" xml:lang="la">Raptim, <placeName ref="l138">Emde</placeName>, 27. februarii 1540.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>Docto et pio viro d. <lb xml:id="p2z2"/><persName ref="p495">Henrico Bullingero</persName>, ecclesie <lb xml:id="p2z3"/>dominice pastori diligentissimo.</s>
					<s n="16" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
