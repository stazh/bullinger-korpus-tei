	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Recepimus schedas expensi et receptas una <lb xml:id="p1z2"/>cum literis vestris.</s>
					<s n="3" xml:lang="la">Pergite ita consignare, quae expen<lb xml:id="p1z3"/>deritis aut receperitis, este frugales istius semper <lb xml:id="p1z4"/>memores: "Quod tibi opus non est, asse carum est, nec cogita<lb xml:id="p1z5"/>veris, quid velis et cupias, sed quibus omnino carere <lb xml:id="p1z6"/>nequeas."</s>
					<s n="4" xml:lang="la">Si sumptus feceritis inutiles praeter necessitatem <lb xml:id="p1z7"/>et parum frugi fueritis, periculum erit, ne magistratus <lb xml:id="p1z8"/>sui poeniteat instituti.</s>
					<s n="5" xml:lang="la">A martio mense iam vobis <lb xml:id="p1z9"/>missi sunt solares aurei vel coronati <placeName ref="l832">Gallici</placeName> 80; <lb xml:id="p1z10"/>nunc enim mitto 40, singulis 20; dati sunt abeunt<lb xml:id="p1z11"/>ibus in fine ianuarii 20 aurei <placeName ref="l822">Germanici</placeName>.</s>
					<s n="6" xml:lang="la">Ea <lb xml:id="p1z12"/>summa in universum facit aureos <placeName ref="l822">Germanicos</placeName> 145, <lb xml:id="p1z13"/>singulis 72 1/2.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Haec in hoc commemoro, ut vos ad fruga<lb xml:id="p1z14"/>litatem excitem, non ut profusionem vobis opprobrem.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z15"/>Praeterea animis infixum habetote, ne frustra sumptus <lb xml:id="p1z16"/>hos faciatis, sed ut seduli et diligentes potius omnibus <lb xml:id="p1z17"/>viribus in eam rem incubatis, ad quem agendam non <lb xml:id="p1z18"/>a nobis dumtaxat, sed a consulibus clarissimis amplissimoque senatu <lb xml:id="p1z19"/>dimissi estis.</s>
					<s n="9" xml:lang="la">Cogitabitis perpetuo, quanta de <lb xml:id="p1z20"/>vobis concepta sit expectatio.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Coniungite ergo dili<lb xml:id="p1z21"/>gentiae vestrae et labori indefesso sedulas preces, quibus <lb xml:id="p1z22"/>auxilium numinis petatis.</s>
					<s n="11" xml:lang="la">Nam intellexistis <lb xml:id="p1z23"/>dudum parari quidem facultatem medicam industria, <lb xml:id="p1z24"/>sed nihilominus esse dei munus conferrique coelitus.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z25"/>Vivite sancte, fugite omnem prophanationem.</s>
					<s n="13" xml:lang="la">Este <lb xml:id="p1z26"/>humiles; deus enim superbis resistit, humilibus dat grati<lb xml:id="p1z27"/>am.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">Persuasum vobis habetote omne tempus vobis <lb xml:id="p1z28"/>periisse, quod studio non fuerit impensum <lb xml:id="p1z29"/>et iacturam temporis esse tantam, ut nulla omnino re <lb xml:id="p1z30"/>possit sarciri, sed et rapido cursu ferri <lb xml:id="p1z31"/>tempus.</s>
					<s n="15" xml:lang="la">Valemus hic gratia dei omnes, valent nostri <lb xml:id="p1z32"/>omnes; agimus in sancta pace.</s>
					<s n="16" xml:lang="la">Orate, ut hoc nobis <lb xml:id="p1z33"/>et vobis diuturnum sit ad gloriam dei.</s>
					<s n="17" xml:lang="la" ana="farewell">Valete.</s>
					<s n="18" xml:lang="la" ana="salute"><lb xml:id="p1z34"/>Salutate d. <persName ref="p8169">Besardum</persName>, d. <persName>Petrum</persName> etc.</s>
					<s n="19" xml:lang="la">Sep<lb xml:id="p1z35"/>tembris 2. <placeName ref="l587">Tiguri</placeName> 1553.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><lb xml:id="p1z36"/><persName ref="p495">Bullingerus</persName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p1z37"/>Optimae spei iuvenibus <persName ref="p3991">Gaspari Wolffio</persName> <lb xml:id="p1z38"/>et <persName ref="p8395">Georgio Kellero</persName>, <placeName ref="l587">Tigurinis</placeName> <placeName ref="l862">Helvetiis</placeName> <lb xml:id="p1z39"/>medicinae operam dantibus <placeName ref="l378">Lutetiae</placeName>, fi<lb xml:id="p1z40"/>liis charissimis suis.</s>
				</p>
			</div>
		</body>
