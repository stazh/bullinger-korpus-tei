	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Mitto hic tibi, <persName ref="p495">Bullingere</persName> doctissime ac charissim<lb xml:id="p1z3"/>e, libros, quos potui invenire, reliqua suo tempore missuru<lb xml:id="p1z4"/>s, si ullo modo assequi possum:</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>De autoritate verbi dei<note xml:id="fn1" type="footnote" n="1"><persName ref="p4160">Alexander Alesius</persName>, De authoritate verbi dei contra episcopum <placeName ref="l296">Lundensem</placeName> [<persName ref="p7805">John Stokesley</persName>], <placeName ref="l491">Straßburg</placeName> (<persName ref="p5926">Crato Mylius</persName>) 1542 <bibl source="https://gateway-bayern.de/VD16+A+1724">(VD 16 A 1724)</bibl>.</note> 8 rap.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Idiomata <persName ref="p7091">Vicelii</persName><note xml:id="fn2" type="footnote" n="2"><persName ref="p7091">Georg Witzel</persName>, Idiomata quaedam linguae sanctae in scripturis veteris testamenti observata, <placeName ref="l307">Mainz</placeName> (<persName ref="p4265">Franz Behem</persName>) 1542 <bibl source="https://gateway-bayern.de/VD16+W+3967">(VD 16 W 3967)</bibl>.</note> 8 rap.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><persName ref="p5336">C. <lb xml:id="p1z7"/>Iulii Hygini</persName><note xml:id="fn3" type="footnote" n="3">Zur 1535 bei <persName ref="p5213">Johann Herwagen</persName> in <placeName ref="l28">Basel</placeName> erschienenen Ausgabe von Werken des <persName ref="p5336">Hyginus</persName>, die hier wahrscheinlich gemeint ist, s. oben <ref target="file11773">Nr. 1728</ref>, 15 mit Anm. 11.</note> <persName ref="p19213">Aug[usti</persName> liberti]<note xml:id="fn4" type="footnote" n="4">D. h. Freigelassener des <persName ref="p19213">Augustus</persName>.</note> 6 batz.</s>
					<s n="6" xml:lang="de"><lb xml:id="p1z8"/>Ordnung der kirchen zuͦ <placeName ref="l964">Hal</placeName><note xml:id="fn5" type="footnote" n="5">[<persName ref="p458">Johannes Brenz</persName>,] Ordnung der kirchen inn eins erbarn raths zu <placeName ref="l964">Schwäbischen Hall</placeName> oberkeit und gepiet gelegen, <placeName ref="l964">Schwäbisch Hall</placeName> (<persName ref="p6149">Pankratius Queck</persName>) 1543 <bibl source="https://gateway-bayern.de/VD16+A+758">(VD 16 A 758)</bibl>, ediert in: Die evangelischen Kirchenordnungen des sechszehnten Jahrhunderts, hg. v. Aemilius Ludwig Richter, Zweiter Bd., Weimar 1846 (Nachdruck: Nieuwkoop 1967), S. 14-21, Nr. LXXVII.</note> 2½ <lb xml:id="p1z9"/>batz.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z10"/><persName ref="p18058">Iul. Firmici</persName> etc<note xml:id="fn6" type="footnote" n="6"><persName ref="p18058">Iulius Firmicus Maternus</persName>, Astronomicῶn lib. VIII [...] [Mathesis], <placeName ref="l28">Basel</placeName> (<persName ref="p5213">Johann Herwagen</persName>) 1533 <bibl source="https://gateway-bayern.de/VD16+F+1119">(VD 16 F 1119)</bibl>. Die Ausgabe enthält weitere astronomische Schriften von verschiedenen Autoren. - <persName ref="p18058">Iulius Firmicus Maternus</persName> aus <placeName ref="l2556">Sizilien</placeName> verfasste um 335/336 n. Chr. ein neuplatonisch geprägtes Handbuch der Astrologie ("Matheseos libri VIII"). Seine zweite Schrift, "De errore profanorum religionum", entstand zwischen 343 und 350 nach seiner Bekehrung zum Christentum und wurde erst 1562 erstmals gedruckt. - Lit.: Karl <hi>Hoheisel,</hi> in: <bibl source="b185">DNP</bibl> IV 523f.</note>. 9 batz.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/>Brevi mittam etiam librum anatomicum.</s>
					<s n="9" xml:lang="la">Erunt tres libri: <lb xml:id="p1z12"/>1. omnia habebit, quae ad fabricam humani corporis attinent, <lb xml:id="p1z13"/>exactissime descripta;<note xml:id="fn7" type="footnote" n="7"><persName ref="p6920">Andreas Vesalius</persName>, De humani corporis fabrica libri septem, <placeName ref="l28">Basel</placeName> (<persName ref="p8126">Johannes Oporin</persName>) 1543 "mense junio" <bibl source="https://gateway-bayern.de/VD16+V+910">(VD 16 V 910)</bibl>; vgl. oben <ref target="file11773">Nr. 1728</ref>, 3-5 mit Anm. 3.</note> 2. epitome erit propriisque et <lb xml:id="p1z14"/>magnis figuris illustratur;<note xml:id="fn8" type="footnote" n="8"><persName ref="p6920">Andreas Vesalius</persName>, De humani corporis fabrica librorum epitome, <placeName ref="l28">Basel</placeName> (<persName ref="p8126">Johannes Oporin</persName>) 1543 "mense iunio" <bibl source="https://gateway-bayern.de/VD16+V+912">(VD 16 V 912)</bibl>.</note> 3. <placeName ref="l822">Germanicus</placeName> erit, <lb xml:id="p1z15"/>quem<pb type="edition" next="158"/> nondum vidi, sed iam sub prelum paratur<note xml:id="fn9" type="footnote" n="9"><persName ref="p6920">Andreas Vesalius</persName>, Von des menschen cörpers anatomey ein kurtzer, aber vast nützer außzug, <placeName ref="l28">Basel</placeName> (<persName ref="p8126">Johannes Oporin</persName>) 1543 "vollendet am neünten tag des augstmonat" <bibl source="https://gateway-bayern.de/VD16+V+916">(VD 16 V 916)</bibl>.</note>.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z16"/>Si omnes tres velles, comparabo.</s>
					<s n="11" xml:lang="la">Indica saltem <lb xml:id="p1z17"/>unico verbo.</s>
					<s n="12" xml:lang="la" ana="salute">Postquam index in magnum volumen <lb xml:id="p1z18"/>absolutus fuerit, habebis<note xml:id="fna" type="footnote" n="a"><hi>Vor</hi> habebis <hi>ein unlesbares, gestrichenes Wort.</hi></note>, si commode in ta<lb xml:id="p1z19"/>bellionem incidero, pretiumque assignabo et<note xml:id="fnb" type="footnote" n="b">et <hi>über der Zeile nachgetragen.</hi></note>, quantum potero <lb xml:id="p1z20"/>vilissimo, sed aequo, emam a doctore<note xml:id="fn10" type="footnote" n="10"><persName ref="p6920">Vesalius</persName>.</note>, qui et <lb xml:id="p1z21"/>te salvere iubet.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vale in domino.</s>
					<s n="14" xml:lang="la" ana="salute">D. <persName ref="p8171">Theodorum</persName><note xml:id="fn11" type="footnote" n="11"><persName ref="p8171">Theodor Bibliander</persName>.</note> et <persName ref="p1214">Phri<lb xml:id="p1z22"/>sium</persName><note xml:id="fn12" type="footnote" n="12"><persName ref="p1214">Johannes Fries</persName>.</note> salutabis.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z23"/>15. iun<lb xml:id="p1z24"/>ii 1543.</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Tuus <lb xml:id="p1z25"/><persName ref="p1278">Gastius</persName> <lb xml:id="p1z26"/>ex animo.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="17" xml:lang="la">D. <pb/><lb xml:id="p2z1"/><persName ref="p495">Heynricho Bullingero</persName>, <lb xml:id="p2z2"/><placeName ref="l587">Tigurinę</placeName> ecclesiae <lb xml:id="p2z3"/>vigilantissimo <lb xml:id="p2z4"/>pastori, praeceptori colendo.</s>
					<s n="18" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
