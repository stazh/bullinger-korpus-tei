	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.P.</s>
					<s n="2" xml:lang="la">Tuas cum <persName ref="p3375">Vergerii</persName> literis accepi, que gratissime <lb xml:id="p1z2"/>fuerunt.</s>
					<s n="3" xml:lang="la" ana="salute">Quia nihil novi habeo praeter ea, que <lb xml:id="p1z3"/>tuis dominis scribo, non illi respondeo, sed rogo te, ut <lb xml:id="p1z4"/>mittas coppiam et illum meis verbis <lb xml:id="p1z5"/>salutes.</s>
					<s n="4" xml:lang="la">De <placeName ref="l830">Anglia</placeName> unum illud certum habeas <lb xml:id="p1z7"/>istam reginam Caesaris filium expetere; quod <lb xml:id="p1z8"/>nisi principes et regni magnates impediunt, <lb xml:id="p1z9"/>ut maxime nituntur, timeo malum exitum; <lb xml:id="p1z10"/>habeo enim inde certa nova.</s>
					<s n="5" xml:lang="la">Quid autem <lb xml:id="p1z11"/>peius toti christiano orbi accidere potest?</s>
					<s n="6" xml:lang="la">Apud <lb xml:id="p1z12"/>nos omnia bene et in <placeName ref="l2801">Corsica</placeName> optime, frigentqu<lb xml:id="p1z13"/>e <placeName ref="l1121">Genuenses</placeName> cum vanis suis ceptis.</s>
					<s n="7" xml:lang="la">Audimus <lb xml:id="p1z15"/>marquionem sollicitare pacem et suos apud <lb xml:id="p1z16"/><persName>regem Romanorum</persName> habere, et iam palam est <lb xml:id="p1z18"/>principes contra Caesarem et filium <lb xml:id="p1z19"/>pro fratre stare.</s>
					<s n="8" xml:lang="la">Sed semper timeo istius <lb xml:id="p1z20"/>veteratoris artes, qui uno verbo solet fratris anim<lb xml:id="p1z21"/>um flectere.</s>
					<s n="9" xml:lang="la"><persName>Maximilianus</persName> tamen abhorret a Caesare et pat<lb xml:id="p1z22"/>rem omnino in potestate habet.</s>
					<s n="10" xml:lang="la">Quamprimum aliquid istorum habe<lb xml:id="p1z23"/>bis, <lb xml:id="p1z24"/>ne permittas, queso, nos falsa credere.</s>
					<s n="11" xml:lang="la">Illa enim sunt magni ponderis.</s>
					<s n="12" xml:lang="la" ana="farewell"><lb xml:id="p1z25"/>Vale optime.</s>
				</p>
				<p>
