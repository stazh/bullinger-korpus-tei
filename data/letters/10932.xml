	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">De <persName ref="p3242">Utingero</persName> minim, quam scripseris lugubria<note xml:id="fn1" type="footnote" n="1"><persName ref="p495">Bullinger</persName> muß in einem nicht erhaltenen Brief über die Erkrankung <persName ref="p3242">Heinrich Utingers</persName> berichtet haben (vgl. auch unten <ref target="file10933">Nr. 891</ref>, 11-16).</note>.</s>
					<s n="3" xml:lang="la">Deus adsit, precor, suo, sive vivat sive m<lb xml:id="p1z2"/>oriatur.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">De cęsare<note xml:id="fn2" type="footnote" n="2">Offenbar hatte sich <persName ref="p495">Bullinger</persName> nach Neuigkeiten über den Krieg zwischen Kaiser <persName ref="p18538">Karl V.</persName> und König <persName ref="p20225">Franz I.</persName> erkundigt.</note> nihil audio, nisi quod periculum instet <placeName ref="l862">Helvetiis</placeName>, si victor evasent.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z3"/>Hic rumor ex omnibus partibus advolat.</s>
					<s n="6" xml:lang="la">In <placeName ref="l2529">Brabantia</placeName> dicunt: Victor caesar invasurus <lb xml:id="p1z4"/>est civitates foederatas (die handstett<note xml:id="fn3" type="footnote" n="3">Hauptstädte(?) wie <placeName ref="l518">Utrecht</placeName>, <placeName ref="l1422">Deventer</placeName> und <placeName ref="l1606">Kampen</placeName>; vgl. <bibl source="b191">DRW</bibl> V 133.</note>) in <placeName ref="l20">Germania Inferiore</placeName>.</s>
					<s n="7" xml:lang="la">Ex <placeName ref="l832">Gallus</placeName> scripsit his <lb xml:id="p1z5"/>diebus ad me quidam<note xml:id="fn4" type="footnote" n="4">Unbekannt; der Brief scheint nicht erhalten zu sein.</note> de incolumitate sua; de hoste ne verbum quidem.</s>
					<s n="8" xml:lang="la">Mittunt vim auri <lb xml:id="p1z6"/>ingentem huc milites <placeName ref="l832">Gallicani</placeName>.</s>
					<s n="9" xml:lang="la">Misit et psitacum quidam.</s>
					<s n="10" xml:lang="la">Ex quo securi mi<lb xml:id="p1z7"/>hi videntur plus satis.</s>
					<s n="11" xml:lang="la">Ex <placeName ref="l760">Salodoro</placeName> locisque aliis nobis finitimis excurrendi<note xml:id="fn5" type="footnote" n="5">Gemeint ist: in den Dienst des <placeName ref="l832">französischen</placeName> Königs.</note> <lb xml:id="p1z8"/>nullus est finis.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><pb type="edition" next="419"/>Caeterum de conventu, priusquam ego consulem adivi, deliberatum erat<note xml:id="fn6" type="footnote" n="6"><persName ref="p495">Bullinger</persName> hatte <persName ref="p8418">Myconius</persName> gebeten, dem Burgermeister <persName ref="p8129">Jakob Meyer</persName> nahezulegen, eine eventuelle Tagung über die Konkordienfrage noch aufzuschieben; s. <persName ref="p8049">Vadian</persName> BW V 362f (vgl. oben <ref target="file10925">Nr. 884</ref>, 5-8, und 885, 35-37).</note>.</s>
					<s n="13" xml:lang="la">In<lb xml:id="p1z9"/>dictum aiebat consul in dominicam proximam ante Michaelis<note xml:id="fn7" type="footnote" n="7">24. September (s. <bibl source="b197">EA</bibl> IV/1c 745 10).</note>.</s>
					<s n="14" xml:lang="la">Quid, si consilio tuorum <lb xml:id="p1z10"/>differri posset?</s>
				</p>
				<p>
					<s n="15" xml:lang="la">In <placeName ref="l830">Anglia</placeName> pax est.</s>
					<s n="16" xml:lang="la">De regina necata<note xml:id="fn8" type="footnote" n="8">Zur Hinrichtung <persName ref="p4358">Anne Boleyns</persName> am 18. Mai 1536 s. Geoffrey Rudolph <hi>Elton,</hi> Reform and Reformation. England 1509-1558, London 1977. - The New History of England, Bd. 2, S. 250-256.</note> et ipsi <placeName ref="l830">Angli</placeName> et finitim<lb xml:id="p1z11"/>i dicunt:</s>
					<s n="17" xml:lang="de">"Es ist ein böß stuck fleisch gsin<note xml:id="fn9" type="footnote" ana="lex" n="9">gewesen.</note>."</s>
					<s n="18" xml:lang="la">Commune hoc.</s>
					<s n="19" xml:lang="la">Suspecti possent igitur esse, <lb xml:id="p1z12"/>quicunque de <persName ref="p8375">rege</persName><note xml:id="fn10" type="footnote" n="10"><persName ref="p8375">Heinrich VIII.</persName></note> male loquuntur.</s>
					<s n="20" xml:lang="la">Ex compatre meo quodam<note xml:id="fn11" type="footnote" n="11">Unbekannt.</note> hęc dico, qui nudius<lb xml:id="p1z13"/>tertius venit ex <placeName ref="l2529">Brabantia</placeName>.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="farewell">Vale cum uxore<note xml:id="fn12" type="footnote" ana="bio" n="12"><persName ref="p8051">Anna, geb. Adlischwyler</persName>.</note>, liberis<note xml:id="fn13" type="footnote" n="13">Siehe oben <ref target="file10782">Nr. 744</ref>, Anm. 34.</note> et fratribus.</s>
					<s n="22" xml:lang="la"><persName ref="p3242">Utingerum</persName>, si vi<lb xml:id="p1z14"/>vit, consolare in domino vel meo nomine.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><placeName ref="l28">Basileae</placeName>, raptim, 6. septembris anno 1536.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z15"/>Tuus <persName ref="p8418">Myconius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Heinricho <lb xml:id="p2z2"/>Bullingero</persName>, domino <lb xml:id="p2z3"/>et fratri suo <lb xml:id="p2z4"/>charissimo.</s>
				</p>
			</div>
		</body>
