	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Reversus sum his diebus <placeName ref="l280">Lausanna</placeName>.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Duxi illuc me<lb xml:id="p1z2"/>cum fratris filium et iussu senatus una cum domino <lb xml:id="p1z3"/><persName>Manuele</persName> statum scholae illius inspexi, quę per domini <lb xml:id="p1z4"/>gratiam mediocriter floret.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><persName ref="p459">Brenvaldus</persName> vester locum <lb xml:id="p1z5"/>ibi honestum habuisset, si non insolentius, quam par erat, <lb xml:id="p1z6"/>se gerere voluisset; discessit inde, antequam veniremus.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z7"/>Audimus illum <placeName ref="l210">Heidelbergam</placeName> profectum.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Sponsam <lb xml:id="p1z8"/><placeName ref="l280">Lausannę</placeName> reliquit.</s>
				</p>
				<p>
					<s n="7" xml:lang="la" ana="salute"><persName ref="p396">Blasius</persName> valet cum suis omnibus <lb xml:id="p1z9"/>et te vehementer salutat; rescripsisset, nisi illum et <lb xml:id="p1z10"/>praesentia mea et aliae occupationes, quę cum hac con<lb xml:id="p1z11"/>currebant, ipsum impedivissent.</s>
					<s n="8" xml:lang="la">Novi illic nihil <lb xml:id="p1z12"/>accepimus praeter ea, quę d. <persName ref="p8033">Beza</persName> iam prius ad te scrip<lb xml:id="p1z13"/>sit, nisi quod relatum nobis fuit <placeName>Turcam</placeName> ex improviso <lb xml:id="p1z14"/>insulam <placeName>Melite</placeName> seu <placeName ref="l2523">Maltam</placeName> occupasse, arcem vero <lb xml:id="p1z15"/>adhuc teneri a nostris.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Hoc idem senatui quoque nostro <lb xml:id="p1z16"/>scriptum est a nobilibus quibusdam <placeName>Sabaudis</placeName>, dum nos ab<lb xml:id="p1z17"/>fuimus.</s>
					<s n="10" xml:lang="la">Domino <persName>Gerardo a Wattenweyl</persName> ex <placeName ref="l875">Hispania</placeName> <lb xml:id="p1z18"/>scribitur <placeName>Tunetum</placeName> a <placeName>Turca</placeName> et <placeName>Draguto</placeName> captum regemque <lb xml:id="p1z19"/>illius loci ibi comprehensum cum omni sua prosapia <lb xml:id="p1z20"/>mox decollatum esse.</s>
					<s n="11" xml:lang="la">Tristia sunt haec; sed metuendum, <lb xml:id="p1z21"/>ne graviora et tristiora sequantur.</s>
				</p>
				<p>
					<s n="12" xml:lang="la">Obiit quoque interea <lb xml:id="p1z22"/>episcopus <placeName ref="l466">Sedunensis</placeName>, in cuius locum hisce diebus <lb xml:id="p1z23"/>communi consilio decuriarum et capituli, ut vocant, <lb xml:id="p1z24"/>electus est <persName ref="p20245">Hildebrandus a Riedmatten</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Decuriae <lb xml:id="p1z25"/>cum summo capitaneo praeservarunt sibi aliquos art<lb xml:id="p1z26"/>iculos erga episcopum er capitulum, qui etiam ipsis concessi <lb xml:id="p1z27"/>sunt; sed qui aut quales illi sint, nondum cognovi.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z28"/>Afferunt etiam hodie nobiles quidam ducem <placeName>Sabaudiae</placeName> <lb xml:id="p1z29"/><persName>Casalum</persName> in <placeName ref="l736">Pedemontio</placeName> (liberum hoc erat, ut audio, <lb xml:id="p1z30"/>et nulli subiectum oppidum) occupasse.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Nostrum <lb xml:id="p1z31"/>foedus nondum est conclusum; spero per domini gratiam fore, ut <lb xml:id="p1z32"/>mora hac dissolvatur prorsus; <foreign xml:lang="de">dann es ist nitt jederman <lb xml:id="p1z33"/>lustig meh und wirt so vil darzuͦ grett, das es denocht <lb xml:id="p1z34"/>helffen sött.</foreign></s>
					<s n="16" xml:lang="la">Nihilominus tamen metuere non desino <lb xml:id="p1z35"/>et dominum orare, ne nos inducat in tentationem.</s>
				</p>
				<p>
					<s n="17" xml:lang="de">Der <lb xml:id="p1z36"/>saffoisch friden ist auch noch nitt besiglet; ich mein, <lb xml:id="p1z37"/>si habind ire sigel verloren.</s>
					<s n="18" xml:lang="la">Interea nostri fruuntur <lb xml:id="p1z38"/>integra possessione ut prius, qua utinam perpetuo <lb xml:id="p1z39"/>fruantur!</s>
					<s n="19" xml:lang="la" ana="salute">Nostri omnes te diligenter salutant, praesertim <persName ref="p8063">Steigerus</persName>, <lb xml:id="p1z40"/><persName ref="p7449">Diesbachius</persName>, <persName ref="p7510">Grafenriet</persName>, <persName ref="p4060">Ludovicus Zehenderus</persName>, <lb xml:id="p1z41"/>qui proxima lunę et filii et filię nuptias simul celebravit; <lb xml:id="p1z42"/>filio despondit <persName>Adriani Ginneri</persName>, divitis et honesti <lb xml:id="p1z43"/>civis, filiam, filiam vero elocavit <persName>N. Wyßhanio</persName>, d. <persName>Ca<lb xml:id="p1z44"/>sparis Wyßhanii</persName>, senatoris, filio.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Sed puto te hoc prius cogno<lb xml:id="p1z45"/>visse.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="salute">Salutant te etiam socer, mater et uxor.</s>
					<s n="22" xml:lang="la" ana="salute">Saluta tuos <lb xml:id="p1z46"/>omnes meo nomine.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><placeName ref="l41">Bernae</placeName> 28. iunii sub noctem 1565.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z47"/><persName ref="p8018">I[ohannes] Hallerus</persName> tu<pb/><lb xml:id="p2z1"/>us.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, domino et <lb xml:id="p2z3"/>compatri meo perpetua <lb xml:id="p2z4"/>observantia colendo.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
