	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/><persName ref="p2664">Ludovicus Quadrius</persName> <persName ref="p495">Henrico Bul[ingero]</persName> S. P. D.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Quamquam nulla inter nos intercedit consuetudo aliave causa, <lb xml:id="p1z3"/>qua adductus tibi commendem <persName ref="p20382">Iulium</persName> filium meum, <lb xml:id="p1z4"/>tamen, quod ubique terrarum pietas christiana, quam profitemur, <lb xml:id="p1z5"/>honestissimum arctissimumque est necessitudinis vinculum, visum sum <lb xml:id="p1z6"/>mihi posse quasi iure meo uti opera ac studio tuo.</s>
					<s n="3" xml:lang="la">Est etiam <lb xml:id="p1z7"/>non alienum a parentis officio, ępiscopo ut parentes filios suos <lb xml:id="p1z8"/>curandos committant.</s>
					<s n="4" xml:lang="la"><placeName ref="l587">Tiguri</placeName> vivit apud <persName ref="p3988">Ioannem Volvium</persName>, virum <lb xml:id="p1z9"/>cum doctum tum autem maxime pium, neque illum tibi commendo, <lb xml:id="p1z10"/>quod de <persName ref="p3988">Volvio</persName> verear, ne sit satis commendatus, siquidem ex literis <lb xml:id="p1z11"/>pueri et multis aliis, qui istinc proficiscuntur, accepi pro filio haberi, <lb xml:id="p1z12"/>nihil ei, quod ad victum et commodum pertineat, deficere, neque flagito <lb xml:id="p1z13"/>tuam accedere commendationem, ut <persName ref="p3988">Volvio</persName> sit commendatior, quod est non potest, <lb xml:id="p1z14"/>sed ut <persName ref="p3988">Volvius</persName> sciat et ępiscopo curae esse filium meum neque mihi tantum <lb xml:id="p1z15"/>rem gratam facere, si curarit, sed etiam ępiscopo suo.</s>
					<s n="5" xml:lang="la">Gratissimum igitur <lb xml:id="p1z16"/>mihi feceris, <persName ref="p495">Bulingeri</persName> doctissime ac pientissime, si <persName ref="p3988">Volvio</persName> illum commendaris, <lb xml:id="p1z17"/>si puerum ipsum, quoties tibi fuerit commodum, ad pietatem ac studia <lb xml:id="p1z18"/>adhortatus fueris; indiget enim ea aetas maiorum exemplis et adhortationibus.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z19"/>Cupio, ut ita confirmatus redeat, ut, quando in <placeName ref="l834">Italiam</placeName> ad studia proficisci <lb xml:id="p1z20"/>contigerit, ita habet suae vitae modum, ut ne animus eius in vitiis <lb xml:id="p1z21"/>ac impietate commoveatur, quod accidit, qui cum malis conflictantur ingeniis.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z22"/>Spero autem tibi prospere cessurum, si tibi etiam fuerit in domino commendatus.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z23"/>Quod autem possum, tibi defero rem, operam, studium meum <lb xml:id="p1z24"/>quibuscunque in rebus tibi opus fuerit; si me ad omnia usus familiariter <lb xml:id="p1z25"/>fueris, mihi gratissimum feceris, et si parem gratiam non retulero, referet dominus noster Iesus Christus.</s>
					<s n="9" xml:lang="la">Cura, <lb xml:id="p1z26"/>ut valeas.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Tirani quinto calendas februarii anno 60.</s>
					<s n="11" xml:lang="la">Doctissimo ac pientissimo d. <persName ref="p495">Henrico Bulingero</persName>, <placeName ref="l587">Tigurinae</placeName> urbis ep<lb xml:id="p1z27"/>iscopo dignissimo, domino meo observandissimo.</s>
				</p>
				<p>
					<note type="author">[Darunter von <persName ref="p495">Bullingers</persName> Hand:]</note>
					<s n="12" xml:lang="la">D. d. <persName ref="p2664">Ludovici a Quadriis</persName> litera.</s>
				</p>
			</div>
		</body>
	</text>
