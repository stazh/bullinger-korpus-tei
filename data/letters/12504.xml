	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">En tandem catalogum librorum, quem toties a me petiisti<note xml:id="fn1" type="footnote" n="1">Siehe dazu <bibl source="b19">HBBW XVI</bibl> 205,1-3; 264,3f.</note>.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>In causa fuit, quod tam tarde miserim, nescio quid, partim dolores oculorum, <lb xml:id="p1z3"/>partim negotia.</s>
				</p>
			</div>
			<div xml:id="div2" corresp="regest2">
				<p>
					<s n="4" xml:lang="la">Mitto praeterea aromaticas species, sed dubius fui, an <lb xml:id="p1z4"/>contritas vel integras volueris.</s>
					<s n="5" xml:lang="la">Integras autem mitto, ne putes me hac <lb xml:id="p1z5"/>in re tibi noluisse inservire.</s>
				</p>
			</div>
			<div xml:id="div3" corresp="regest3">
				<p>
					<s n="6" xml:lang="la">Novi nihil habeo omnino.</s>
					<s n="7" xml:lang="la">Adeo omnia <lb xml:id="p1z6"/>alto silentio aguntur apud principes et episcopos<note xml:id="fn2" type="footnote" n="2">Beim Reichstag zu <placeName ref="l410">Regensburg</placeName>.</note>.</s>
				</p>
			</div>
			<div xml:id="div4" corresp="regest4">
				<p>
					<s n="8" xml:lang="la"><persName ref="p8418">Myconius</persName> me rogavit, ut, si <lb xml:id="p1z7"/>in tabellionem aliquem incidissem, illi<note xml:id="fna" type="footnote" n="a"><hi>Vor</hi> illi <hi>versehentlich wiederholtes</hi> ut.</note> narrarem.</s>
					<s n="9" xml:lang="la">Admonui eum, qui dixit i<lb xml:id="p1z8"/>pse velle scribere<note xml:id="fn3" type="footnote" n="3">Brief <ref target="file12499">Nr. 2452</ref> vom 2. Juni 1546.</note> et multa habere, quę digna sunt, ut bonis viris communicentur.</s>
				</p>
			</div>
			<div xml:id="div5" corresp="regest5">
				<p>
					<s n="10" xml:lang="de"><lb xml:id="p1z9"/>Unser burgerschafft haben Conversionem Pauli<note xml:id="fn4" type="footnote" n="4">Das erst einige Jahre später gedruckte Werk von <persName ref="p8184">Valentin <hi>Boltz</hi></persName>, Tragicocomoedia Sant Pauls bekerung. Gespilt von einer Burgerschafft der wytberuempten frystatt <placeName ref="l28">Basel</placeName> im jor M.D.XLVI [...], <placeName ref="l28">Basel</placeName>, <persName ref="p21153">Jakob Kundig</persName>, 1551 und 1552 <bibl source="https://gateway-bayern.de/VD16+B+6527">(VD16 B6527</bibl>; ZV2243); s. <ref target="file12506">Nr. 2459</ref>,74-80.</note> gespilt mit grossem <lb xml:id="p1z10"/>possen<note xml:id="fn5" type="footnote" n="5">mit grossem possen: mit prunkvollem Spektakel; s. <bibl source="b229">Fischer</bibl> I 1313; <bibl source="b590">SI</bibl> IV 1733. - Zu dieser Aufführung s. auch <persName ref="p1278">Gast</persName>, <hi>Tagebuch</hi> 270f; <persName ref="p2614">Felix Platter</persName>, Tagebuch (Lebensbeschreibung) 1536-1567, hg. v. Valentin Lötscher, Basel/Stuttgart 1976, S. 82f.</note>.</s>
				</p>
			</div>
			<div xml:id="div6" corresp="regest6">
				<p>
					<s n="11" xml:lang="la" ana="farewell">Vale in domino.</s>
					<s n="12" xml:lang="la" ana="salute">Salutabis mihi d. <persName ref="p8171">Theodorum</persName><note xml:id="fn6" type="footnote" n="6"><persName ref="p8171">Theodor Bibliander</persName>.</note> et <persName ref="p8011">Gvaltherum</persName> <lb xml:id="p1z11"/>cum <persName ref="p8051">uxore</persName> tua<note xml:id="fn7" type="footnote" ana="bio" n="7"><persName ref="p8051">Anna Bullinger, geb. Adlischwyler</persName>.</note>.</s>
					<s n="13" xml:lang="la"><placeName ref="l28">Basileę</placeName>, 7. iunii 1546.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z12"/>Tuus <persName ref="p1278">Gastius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="15" xml:lang="la"><pb/><lb xml:id="p2z1"/>D. <lb xml:id="p2z2"/><persName ref="p495">Bullingero</persName> suo.</s>
					<s n="16" xml:lang="de"><lb xml:id="p2z3"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
