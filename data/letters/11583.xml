	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Acta <placeName ref="l569">Wormacensia</placeName><note xml:id="fn1" type="footnote" n="1">Gemeint sind zweifellos die "Acta conventus <placeName ref="l569">Wormatiensis</placeName> a d. <persName ref="p1365">Simone Grynaeo</persName> descripta" (oben <ref target="file11512">Nr. 1469</ref>).</note> hic remitto.</s>
					<s n="3" xml:lang="la">Utinam reliqua <lb xml:id="p1z2"/>quoque comitia sic descripta in publicum ederentur, <lb xml:id="p1z3"/>quo totus mundus intelligeret, quantis nugis et <lb xml:id="p1z4"/>astutiis agatur contra synceritatem evangelii!<pb type="edition" next="237"/></s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z5"/>De <persName ref="p8447">Stainero</persName> quae scripsisti,<note xml:id="fn2" type="footnote" n="2"><persName ref="p495">Bullinger</persName> muss <persName ref="p4079">Zwick</persName> in einem nicht erhaltenen Brief davon unterrichtet haben, dass <persName ref="p8447">Werner Steiner</persName> wegen des Vorwurfs früherer homosexueller Kontakte in Haft genommen worden war. Zu den Einzelheiten s. Diethelm <hi>Fretz,</hi> "Steinen Fata", in: <bibl source="b714">Zwa</bibl> IV/12, 1926, S. 377-384; Helmut <hi>Puff</hi> Sodomy in Reformation <placeName ref="l822">Germany</placeName> and <placeName ref="l862">Switzerland</placeName>, 1400-1600, Chicago 2003, S. 97-100.</note> multis suspiriis accepi.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Ah, quam non sumus certi, quid nobiscum velit dominus <lb xml:id="p1z7"/>in hac miseriarum valle<note xml:id="fn3" type="footnote" n="3">Vgl. <cit type="bible"><ref>Ps 84 (83 Vulg.), 7</ref></cit>.</note>!</s>
					<s n="6" xml:lang="la">Spero autem bonum virum <lb xml:id="p1z8"/>iam ex angustiis [e]t carceribus<note xml:id="fna" type="footnote" n="a">Felt carceribus <hi>am Rande nachgetragen, Anfang im engen Einband verdeckt.</hi></note> liberatum.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z9"/>Ex <placeName ref="l410">Ratispona</placeName> scribitur<note xml:id="fn4" type="footnote" n="4">Vgl. oben <ref target="file11582">Nr. 1539</ref>, 3-7 (mit Anm. 5) und 41f.</note> conceptam quidem concordiae <lb xml:id="p1z10"/>formulam, sed negatam a nostris, imo nec <lb xml:id="p1z11"/>ab adversariis probatam<note xml:id="fn5" type="footnote" n="5">Vgl. die ausführlichen Berichte von <persName ref="p8011">Gwalther</persName> und <persName ref="p9046">Pistorius</persName> (oben <ref target="file11566">Nr. 1523</ref>f).</note>.</s>
					<s n="8" xml:lang="de">So spitzig, kluͦg und <lb xml:id="p1z12"/>gschlipferig<note xml:id="fn6" type="footnote" ana="lex" n="6">schlüpfrig.</note> ding ists.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>Nunc, quoniam <persName ref="p18593">Turca</persName><note xml:id="fn7" type="footnote" n="7">Sultan <persName ref="p18593">Suleiman I.</persName></note> non nisi 25 miliaribus abest <lb xml:id="p1z14"/>a <placeName ref="l1074">Buda</placeName>, tractari<note xml:id="fnb" type="footnote" n="b"><hi>Vor</hi> tractari <hi>gestrichenes</hi> au.</note> petit <persName ref="p18538">cęsar</persName><note xml:id="fn8" type="footnote" n="8">Kaiser <persName ref="p18538">Karl V.</persName></note> de auxilio <lb xml:id="p1z15"/>contra illum, quod nostri omnino recusant nisi <lb xml:id="p1z16"/>certa pace constituta<note xml:id="fn9" type="footnote" n="9">Vgl. oben <ref target="file11581">Nr. 1538</ref>, 128-133 mit Anm. 64.</note>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z17"/>Ministri aliquot iam abierunt, scilicet <persName ref="p1055">Frechtus</persName>, <lb xml:id="p1z18"/><placeName ref="l361">Nurenbergenses</placeName>, <placeName ref="l18">Augustani</placeName><note xml:id="fn10" type="footnote" n="10"><persName ref="p1055">Martin Frecht</persName> aus <placeName ref="l513">Ulm</placeName>, <persName ref="p4637">Veit Dietrich</persName> aus <placeName ref="l361">Nürnberg</placeName> und <persName ref="p8417">Wolfgang Musculus</persName> aus <placeName ref="l18">Augsburg</placeName> (vgl. <bibl>CO</bibl> XI 243).</note> etc.</s>
					<s n="11" xml:lang="la"><persName ref="p540">Calvinus</persName> quoque <lb xml:id="p1z19"/>parat abitum,<note xml:id="fn11" type="footnote" n="11"><persName ref="p540">Calvin</persName> dürfte am 16. Juni abgereist sein (vgl. <persName ref="p467">Bucers</persName> Schreiben an die <placeName ref="l491">Straßburger</placeName> Pfarrer vom gleichen Tag, Corr. des réformateurs VII 157f). Am 20. Juni war er in <placeName ref="l513">Ulm</placeName> (s. unten <ref target="file11586">Nr. 1543</ref>, 18f), am 25. in <placeName ref="l491">Straßburg</placeName> (s. Corr. des réformateurs VII 157, Anm. 2).</note> ut audio.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z20"/>Sic perdimus tandem <lb xml:id="p1z21"/>oleum et operam<note xml:id="fn12" type="footnote" n="12"><persName ref="p19874">Plautus</persName>, Poenulus, 332; vgl. <bibl source="b56">Adagia</bibl>, 1, 4, 62 (<bibl source="b370">LB</bibl> II 171f.)</note>, nisi quod stultitiis nostris iram domini <lb xml:id="p1z23"/>magis ac magis in nos aggravamus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">V<lb xml:id="p1z24"/>ale cum tota domo et fratribus.</s>
					<s n="14" xml:lang="la">Credo <persName ref="p8055">Ambrosium</persName><note xml:id="fn13" type="footnote" n="13"><persName ref="p8055">Ambrosius Blarer</persName>.</note> quoque <lb xml:id="p1z25"/>s<lb xml:id="p1z26"/>cripturum quaedam<note xml:id="fn14" type="footnote" n="14">Oben <ref target="file11582">Nr. 1539</ref>.</note><lb xml:id="p1z27"/>.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z28"/>Ex <placeName ref="l257">Cons<pb/><lb xml:id="p2z1"/>tantia</placeName>, <lb xml:id="p2z2"/>2<lb xml:id="p2z3"/>9. <lb xml:id="p2z4"/>iunii 1<lb xml:id="p2z5"/>54<lb xml:id="p2z6"/>1.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z7"/>Tuus <persName ref="p4079">Io. <lb xml:id="p2z8"/>Z<lb xml:id="p2z9"/>vic<lb xml:id="p2z10"/>k</persName><lb xml:id="p2z11"/>.</s>
				</p>
				<p>
					<note type="address">[Adresse auf der Rückseite:]</note>
					<s n="17" xml:lang="la"><lb xml:id="p2z12"/>Domino <persName ref="p495">Hainricho Bullingero</persName>, <lb xml:id="p2z13"/>c<lb xml:id="p2z14"/>harissimo et observ<lb xml:id="p2z15"/>ando suo in domino <lb xml:id="p2z18"/>fratri<lb xml:id="p2z34"/>.</s>
				</p>
