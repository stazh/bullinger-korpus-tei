	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Inspeximus hodie classem <placeName ref="l582">Zofingensem</placeName>, quae in pago, <lb xml:id="p1z2"/>cui a <placeName>Longa valle</placeName> nomen est<note xml:id="fn1" type="footnote" n="1"><placeName>Langenthal</placeName>.</note>, convenire solet.</s>
					<s n="3" xml:lang="la">Illuc ad <lb xml:id="p1z3"/>me delatae sunt literae a d. <persName ref="p8033">Beza</persName> una cum fasciculo isto, <lb xml:id="p1z4"/>quem hisce coniunctum ad te mitto.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Accepit simul per eundem <lb xml:id="p1z5"/>nuncium d. <persName ref="p5787">Claudius a Madiis</persName> a senatu nostro literas.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Quid illae <lb xml:id="p1z6"/>contineant, adhuc ignoro; mox tamen iis lectis me rogavit, num <lb xml:id="p1z7"/>certo scirem te <placeName>Reginopolim</placeName> ad nos venturum (nam prius me <lb xml:id="p1z8"/>tibi hac de re scripsisse ei dixeram).</s>
					<s n="6" xml:lang="la">Ego, quamvis sperare me <lb xml:id="p1z9"/>hoc dicerem, certi tamen nihil affirmare posse aiebam, unde <lb xml:id="p1z10"/>ille mox proprium nuncium ad te mittendum censuit.</s>
					<s n="7" xml:lang="la">Itaque cum <lb xml:id="p1z11"/>sub vesperam huc appulerimus, conduximus illico hunc nuncium, <lb xml:id="p1z12"/>qui has tibi affert, et rogamus adhuc atque obtestamur, <lb xml:id="p1z13"/>ut una cum fratre meo die proxima Mercurii sub vesperam illuc <lb xml:id="p1z14"/>venias; videtur enim magnum esse aliquid et valde necessarium, <lb xml:id="p1z15"/>quod senatus nostri nomine tecum communicare velit, quamvis, <lb xml:id="p1z16"/>ut scripsi, quid illud sit, nondum cognoscam.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Da ergo nobis et non <lb xml:id="p1z17"/>nobis modo, sed communi rerumpublicarum nostrarum utilitati, <lb xml:id="p1z18"/>ut venias.</s>
					<s n="9" xml:lang="la">Comites adducas tecum filios et generos tuos, et <lb xml:id="p1z19"/>quoscunque voles alios; omnes enim nobis erunt gratissimi.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z20"/>Cras proficiscemur <placeName>Aroviam</placeName>, die Mercurii synodum illic celebrabim<lb xml:id="p1z21"/>us, quam ita cito facile absolvemus, ut adhuc <placeName>Reginopolim</placeName> <lb xml:id="p1z22"/>eo vespere, etsi serum proficiscendum sit, venturi simus.</s>
				</p>
				<p>
					<s n="11" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z23"/>vale.</s>
				</p>
				<p>
					<s n="12" xml:lang="la" ana="salute">Salutant te mei collegae, eoconomus item <persName ref="p8449">Telamonius</persName> <lb xml:id="p1z24"/>et <persName ref="p8369">Hemmanus Haberer</persName>.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Plura non scribo, quia reliqua omnia <lb xml:id="p1z25"/>coram tecum agam.</s>
					<s n="14" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><placeName ref="l582">Zofingae</placeName> 29. maii sub noctem.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z26"/><persName ref="p8018">Iohannes Hallerus</persName> <lb xml:id="p1z27"/>tuus.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z28"/>Iam occluseram literas, cum denuo me monet d. <persName ref="p5787">a <lb xml:id="p1z29"/>Madiis</persName>, ut hoc adiiciam, ut, si omnino fieri non possit, ut venias, <lb xml:id="p1z30"/>per hunc nuncium illico hoc nobis significes; ita enim fortasse <lb xml:id="p1z31"/>fiet, ut ipse ad vos ascendat <placeName ref="l587">Tigurum</placeName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> ecclesiae <lb xml:id="p2z3"/>pastori fidelissimo, domino suo <lb xml:id="p2z4"/>honorando et compatri charissismo.</s>
					<s n="19" xml:lang="de"><lb xml:id="p2z5"/>M. <persName ref="p495">Heinrych Bullinger</persName>n <lb xml:id="p2z6"/>zuͦ <placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>