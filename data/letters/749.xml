	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Hac hora, postquam tuas accepi, <lb xml:id="p1z2"/><persName ref="p495">Bullingere</persName> compater in domino charissime, <lb xml:id="p1z3"/>quaestorem <persName ref="p8012">Hallerum</persName> propter causam D. <lb xml:id="p1z4"/><persName ref="p8018">Halleri</persName>, compatris nostri, tandem absolvendam <lb xml:id="p1z5"/>accessi illique, quae ad me scripseris, <lb xml:id="p1z6"/>exposui.</s>
					<s n="3" xml:lang="de"><foreign xml:lang="la">Respondit ad hunc modum:</foreign> <lb xml:id="p1z7"/>synes bedunckens achte er, das in <lb xml:id="p1z8"/>diser sachen inn eynem radt allhie <lb xml:id="p1z9"/>nichts für zuͦ nemen sye, er khünde <lb xml:id="p1z10"/>dann selb darby im radt seyn; er <lb xml:id="p1z11"/>khünde aber noch nit.</s>
					<s n="4" xml:lang="de">Darumb wüsse <lb xml:id="p1z12"/>er hierin nichts zu handlen, byß er <lb xml:id="p1z13"/>uff die fuͤß khome, hoff aber bald; <lb xml:id="p1z14"/>dann wann er schon mitt dem herren <lb xml:id="p1z15"/><persName ref="p8018">Haller</persName> rede, was sin will und meinung <lb xml:id="p1z16"/>sye, so sye es doch nur halb gmacht, <lb xml:id="p1z17"/>diewil er noch nit personlich im <lb xml:id="p1z18"/>radt darvon handlen khünde.</s>
					<s n="5" xml:lang="de">Wann <lb xml:id="p1z19"/>aber ir ein weg hetten, der euch <lb xml:id="p1z20"/>baß gefiel, so mögen irs im schriben <lb xml:id="p1z21"/>mitt einem bsonderen leufer; er <lb xml:id="p1z22"/>welle demselben seynen lon geben etc.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z23"/>Haec fere summa eorum est, quae <lb xml:id="p1z24"/>mihi vir ille respondit.</s>
					<s n="7" xml:lang="la">Addidit <lb xml:id="p1z25"/>se nondum oblitum esse eorum, quae ad <lb xml:id="p1z26"/>se scripseris.</s>
					<s n="8" xml:lang="la">Quod me concernit, <lb xml:id="p1z27"/>non possum satis mirari istam <lb xml:id="p1z28"/>tarditatem et oscitantiam in causa <lb xml:id="p1z29"/>ecclesię Christi; anxie vereor, ne <lb xml:id="p1z30"/>quod nostris ecclesiis iudicio domini <lb xml:id="p1z31"/>omnium iustissimo accidit, accidat etiam <lb xml:id="p1z32"/>vestris.</s>
					<s n="9" xml:lang="la">Caeterum domus mea post obdorm<lb xml:id="p1z33"/>itionem <persName ref="p20454">Iudith</persName>, filię meae, qua de iam <lb xml:id="p1z34"/>antea scripsi, adhuc tranquilla est.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z35"/>De <persName>Eusebio</persName>, quem misi, non est opus <pb/><lb xml:id="p2z1"/>ut tantopere gratias agas.</s>
					<s n="11" xml:lang="la">Utinam possem <lb xml:id="p2z2"/>humanitati tuae ac tuorum respondere, <lb xml:id="p2z3"/>quam ostendistis in exules.</s>
					<s n="12" xml:lang="la">De rebus <lb xml:id="p2z4"/><placeName ref="l830">Anglicis</placeName> scribuntur admodum tristia.</s>
					<s n="13" xml:lang="la"><lb xml:id="p2z5"/>Si quid certi acceperis, oro, communices.</s>
					<s n="14" xml:lang="la" ana="farewell"><lb xml:id="p2z6"/>Optime vale, virorum colendissime.</s>
					<s n="15" xml:lang="la" ana="salute">Salutem <lb xml:id="p2z7"/>tuis omnibus et fratribus et dominis, domino <lb xml:id="p2z8"/><persName ref="p8127">Pellicano</persName>, venerandissimo seni, D. <persName ref="p8171">Bibli<lb xml:id="p2z9"/>andro</persName>, D. <persName ref="p8011">Gualthero</persName> et toti vestro <foreign xml:lang="el">[<lb xml:id="p2z10"/>griechisch]</foreign>, etiam <persName ref="p8440">Gervasio</persName> nostro, cui <lb xml:id="p2z11"/>cupiam obnixe tandem aliqua ratione <lb xml:id="p2z12"/>esse consultum.</s>
					<s n="16" xml:lang="la" ana="salute">Salutant vos mei omnes.</s>
				</p>
				<p>
					<s n="17" xml:lang="de"><placeName ref="l41">Bernę</placeName> 2. <lb xml:id="p2z13"/>decembris 1549.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">Salutem etiam D. <persName ref="p506">Butlero</persName> et quaest<lb xml:id="p2z14"/>ori <placeName ref="l339">Neuburgico</placeName>.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><persName ref="p8417">W[olfgangus] Musc[ulus]</persName>, com<lb xml:id="p2z15"/>pater tuus in domino.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="20" xml:lang="la"><lb xml:id="p2z16"/>Clarissimo theologo M. <persName ref="p495">Heinrycho B<lb xml:id="p2z17"/>ullingero</persName>, compatri in <lb xml:id="p2z18"/>domino charissimo.</s>
				</p>
			</div>
		</body>
