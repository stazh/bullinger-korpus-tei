	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Cum tuo me nomine pridie salutaret <persName ref="p506">Butlerus</persName> noster et anxie te cupere de rebus <lb xml:id="p1z2"/><placeName ref="l303">Madenburgensibus</placeName>, quonam modo accidissent, mihi significaret, forte fortuna cuidam <lb xml:id="p1z3"/>ex amicis allatus est e <placeName ref="l361">Norimberga</placeName> libellus <placeName ref="l303">Madenburgi</placeName> aeditus, ex quo <lb xml:id="p1z4"/>omnia intelliges.</s>
					<s n="3" xml:lang="la">Miram de se constantiae expectationem omnium animis incutit <lb xml:id="p1z5"/>illa urbs, quam utinam et vicinae imitarentur!</s>
					<s n="4" xml:lang="la">De plusculis enim ambigitur, <lb xml:id="p1z6"/>mansuraene in fide Christi sint necne, usque adeo in speciem quidem plau<lb xml:id="p1z7"/>sibilibus, sed longe tamen insidiosissimis artibus tentantur quaedam, quas sper<lb xml:id="p1z8"/>amus tamen circumspectius acturas esse, quam vulgus sibi polliceatur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Interea <lb xml:id="p1z9"/>temporis nihil habemus ex <placeName ref="l18">Augusta</placeName> certi, nisi quod certo ferunt <persName ref="p18538">Caesarem</persName> <lb xml:id="p1z10"/>filio suo <persName ref="p18575">Philippo</persName> fratris <persName ref="p18477">Ferdinandi</persName> filiam uxorem daturum magno quidem <lb xml:id="p1z11"/>fratris consensu, pro lege videlicet caninae verecundiae.</s>
					<s n="6" xml:lang="la">Si quid acciderit, bre<lb xml:id="p1z12"/>vi intelliges.</s>
					<s n="7" xml:lang="la" ana="farewell">Vale.</s>
					<s n="8" xml:lang="la"><placeName ref="l473">Sangalli</placeName> 23. octobris anno 50.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><persName ref="p8049">Ioachimus Vadianus</persName>.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrycho Bullingero</persName>, <lb xml:id="p2z2"/>praeclarae urbis <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>episcopo, domino suo inprimis colendo<lb xml:id="p2z4"/>.</s>
				</p>
			</div>
		</body>
	</text>
