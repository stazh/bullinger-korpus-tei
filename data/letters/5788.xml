	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Non potest sane satis depraedicare <persName>Blasius</persName> meus, <lb xml:id="p1z2"/>quae illi praestiteritis humanitatis officia tuque inprimis.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z3"/>Itaque est, quod tibi et aliis meo et illius nomine sum<lb xml:id="p1z4"/>mas agam gratias, et oro, ut deinceps ipsum meque meosque <lb xml:id="p1z5"/>omnes vobis habeatis commendatos.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Ipse interea <placeName ref="l280">Lausan<lb xml:id="p1z6"/>nam</placeName> a senatu nostro destinatus est, ut ibi artium <lb xml:id="p1z7"/>professionem suscipiat; hoc ut illi et scholae foelix ac faus<lb xml:id="p1z8"/>tum sit, dominum precor.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Maluissem ipsum apud nos manere <lb xml:id="p1z9"/>potuisse; sed quoniam hic nihil vacat et scholae illius <lb xml:id="p1z10"/>necessitas hoc requirat, non possum contradicere et <lb xml:id="p1z11"/>legitimae vocationi me opponere.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Potest illic non minus <lb xml:id="p1z12"/>prodesse reipublicae nostrae, quam si hic esset, et fortassis <lb xml:id="p1z13"/>fiet, ut aliquando huc transferatur.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Si quid vobis aut <lb xml:id="p1z14"/>vestris illic prodesse poterit, sicut facere debet, ita faciet <lb xml:id="p1z15"/>quoque libenter.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Quod negotium nostrum Sabaudicum <lb xml:id="p1z16"/>attinet, intellexi tuum consilium bonum, prudens et cir<lb xml:id="p1z17"/>cumspectum; illo ut hactenus usi sumus, ita deinceps <lb xml:id="p1z18"/>quoque utemur.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Quod restitutionem attinet, poteram <lb xml:id="p1z19"/>tibi opponere multa eaque non contemnenda; sed nolo <lb xml:id="p1z20"/>te istis fatigare, relinquam ista illis disputanda, quorum <lb xml:id="p1z21"/>est in hisce decernere.</s>
				</p>
				<p>
					<s n="10" xml:lang="la">Alioqui non minore cum periculo <lb xml:id="p1z22"/>recipietur sententia <placeName ref="l28">Basiliensis</placeName>, quam reiiciatur; <lb xml:id="p1z23"/>quid tamen futurum sit, adhuc ignoro, expectamus <lb xml:id="p1z24"/>principis responsum.</s>
				</p>
				<p>
					<s n="11" xml:lang="la">De <placeName ref="l646">Glaronensibus</placeName> nihil au<lb xml:id="p1z25"/>dio, an receperint conditiones propositas necne.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z26"/>Ex <placeName ref="l832">Gallia</placeName> nihil certi habemus.</s>
				</p>
				<p>
					<s n="13" xml:lang="la">Fuerunt his diebus <lb xml:id="p1z27"/>quidam stipatores regis hic, quos dicunt esse <placeName ref="l587">Tigurinos</placeName>; <lb xml:id="p1z28"/>ab illis, quoniam ad vos profecti sunt, cognoscetis, quid <lb xml:id="p1z29"/>rerum geratur illic.</s>
				</p>
				<p>
					<s n="14" xml:lang="la">De concilio <placeName ref="l1107">Tridentino</placeName> quoque nihil <lb xml:id="p1z30"/>audimus.</s>
					<s n="15" xml:lang="la">Quod attinet foedus <placeName ref="l832">Gallorum</placeName>, nescio <lb xml:id="p1z31"/>quid futurum sit; non puto tamen quemquam fore, qui illud <lb xml:id="p1z32"/>admittat.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><placeName ref="l167">Genevenses</placeName> nudiustertius hac transierunt, <lb xml:id="p1z33"/>qui <placeName ref="l21">Badenam</placeName> proficiscuntur; quid acturi sint, ignoro.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p1z34"/>Illis, si nostri consentiant, sententiae <placeName ref="l28">Basiliensi</placeName> non <lb xml:id="p1z35"/>bene consuletur.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute">Faxit dominus, ut omnia cedant ad ipsius <lb xml:id="p1z36"/>gloriam, multorum salutem et rerumpublicarum nostrarum <lb xml:id="p1z37"/>incolumitatem.</s>
					<s n="19" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="20" xml:lang="la">Tuae literae tibi fraudi non <lb xml:id="p1z38"/>erunt; tamen, si ita omnino vis, remittam illas tibi.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="salute"><lb xml:id="p1z39"/>Salutant te amici et fratres omnes, consul <persName ref="p8063">Steigerus</persName>, quęstores, <lb xml:id="p1z40"/><persName ref="p7510">Grafenriet</persName>, <persName ref="p8012">Haller</persName>, <persName>Manuel</persName>, <persName ref="p7449">Diesbachius</persName> insuper <lb xml:id="p1z41"/>et <persName>Wytenbachius senior</persName>, qui mihi hodie in prandio, <lb xml:id="p1z42"/>ad quod nos vocaverat, hoc commisit, <persName ref="p8417">Musculus</persName> item <lb xml:id="p1z43"/>et socer.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Salvi sint tui omnes.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><placeName ref="l41">Bernae</placeName> 27. iunii <lb xml:id="p1z44"/>1563.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><lb xml:id="p1z45"/><persName ref="p8018">I[oannes] Hallerus</persName> <lb xml:id="p1z46"/>tuus.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino suo honorando et <lb xml:id="p2z5"/>compatri charissimo.</s>
				</p>
			</div>
