	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino.</s>
					<s n="2" xml:lang="la">Curavi literas ad <persName ref="p8055">Blorerum</persName> diligentissime, etsi vix potuerim <lb xml:id="p1z2"/>nancisci fidelem hominem et piscatoribus nihil est fidendum ob ebrietatem, qua <lb xml:id="p1z3"/>perpetuo laborant.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Verum hac de re scripsi <persName ref="p8055">Blaurero</persName>, qui fortassis colloquetur <lb xml:id="p1z4"/>cum piscatore aliquo, ut libenter in se recipiat, si quid mittatur aut a <lb xml:id="p1z5"/>vobis aut ab aliis.</s>
					<s n="4" xml:lang="la">Duo ex <placeName ref="l18">Augustanis</placeName> concionatoribus apud nos hęrent.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z6"/>Ad quos scriptum est <placeName ref="l361">Norebergenses</placeName> tribus ex fratribus <placeName ref="l18">Augustanis</placeName> dedisse <lb xml:id="p1z7"/>150 taleros in viaticum; liberalitas non contemnenda, et indicat hec adhuc <lb xml:id="p1z8"/>christiana apud illos vigere pectora, qui fratribus libenter aliquid benignitatis <lb xml:id="p1z9"/>collaturi sunt, qui constantes sunt in evangelio Christi asserendo.</s>
					<s n="6" xml:lang="la">Furit <lb xml:id="p1z10"/><persName ref="p18538">Caesar</persName> cum suis; scholae abrogatę sunt <placeName ref="l18">Augustę</placeName>, eiecti magistri et inhi<lb xml:id="p1z11"/>bitum est illis, ne quem deinceps doceant evangelii doctrinam; horreo dicere.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Proscribuntur quotidie multi.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Hę sunt fructus concilii <placeName ref="l1107">Tridentini</placeName>.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z13"/>Quid putas acturos <placeName ref="l862">Helvetios</placeName> nostros in istis comitiis?</s>
					<s n="10" xml:lang="la">Metuo nostram <lb xml:id="p1z14"/>pusillanimitatem, qui non audemus illorum consiliis frivolis contraire <lb xml:id="p1z15"/>aut nos opponere, qui veritatem habemus.</s>
					<s n="11" xml:lang="la">Admonendi sunt consules, sena<lb xml:id="p1z16"/>tores et plebs, ne facile minis terreantur <persName ref="p18538">Cęsareanis</persName>.</s>
					<s n="12" xml:lang="la">Practicam excogit<lb xml:id="p1z17"/>arunt fallacissimam; verum si constantes erimus, nihil efficient, et <lb xml:id="p1z18"/>dominus illorum consilia dissipabit.</s>
					<s n="13" xml:lang="la">Obtrudent nobis concilii prae<lb xml:id="p1z19"/>scripta; quęnam putas esse?</s>
					<s n="14" xml:lang="la">Dominus nostri misereatur et det nobis <lb xml:id="p1z20"/>veram sui cognitionem in corda nostra, ne vacillemus more quorundam.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z21"/><placeName ref="l18">Augustani</placeName> concionatores omnes imperterriti responderunt adversariis, adeo <lb xml:id="p1z22"/>erecti sunt; ludimagistri quidam ad vomitum redierunt<note xml:id="fn1" type="footnote" n="1">Vgl. <cit type="bible"><ref>Spr 26, 11</ref></cit>; <cit type="bible"><ref>2Petr 2, 22</ref></cit>.</note>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><persName ref="p8173">Xystus</persName> noster <lb xml:id="p1z23"/>ad papistas concessit, sed altera die recantavit; quid cum illo <lb xml:id="p1z24"/>agent, adhuc ignoramus.</s>
					<s n="17" xml:lang="la">Tempora instant tribulationis et tentationis.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z25"/>Exurge itaque, domine, et dissipentur inmici nostri, quo <lb xml:id="p1z26"/>videant te solum deum esse, et quem misisti Iesum Christum.</s>
					<s n="19" xml:lang="la">Amen.</s>
					<s n="20" xml:lang="la" ana="farewell"><lb xml:id="p1z27"/>Vale.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><placeName ref="l28">Basileę</placeName> 22. septembris 1551.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z28"/>T[uus] <persName ref="p1278">Gas<lb xml:id="p1z29"/>tius</persName> <lb xml:id="p1z30"/>ex animo.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z31"/>Ago tibi gratias pro libello <lb xml:id="p1z32"/>misso, neque opus, ut sis sollici<lb xml:id="p1z33"/>tus de <lb xml:id="p1z34"/>libellis transmissis; bene computabo, <lb xml:id="p1z35"/>s<lb xml:id="p1z36"/>i alios misero, nempe Polyaenum, cum <lb xml:id="p1z37"/>reliquis.</s>
					<s n="24" xml:lang="la">Si commode poteris, mitte homiliam Zeni <lb xml:id="p1z38"/>martyris in epistolam ad Corinthios; alias noli emere.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Expecto ab <placeName ref="l491">Arg<lb xml:id="p1z39"/>entinensibus</placeName> literas de <placeName ref="l749">Saxonicis</placeName> rebus a domino <persName ref="p18137">Marpach<pb/><lb xml:id="p2z1"/>io</persName>.</s>
				</p>
				<p>
					<s n="26" xml:lang="la">D. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, p<lb xml:id="p2z3"/>astori ecclesiae <lb xml:id="p2z4"/><placeName ref="l587">Tigurinae</placeName>.</s>
					<s n="27" xml:lang="de"><lb xml:id="p2z5"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
