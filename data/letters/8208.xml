	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Et tuas, mi frater, et d. <persName>Salicei</persName> literas accepi, <lb xml:id="p1z2"/><persName ref="p1012">Aernii</persName><note xml:id="fn1" type="footnote" n="1">Leonhard Erni.</note> vero mei vidi nullas, spero tamen eius ea <lb xml:id="p1z3"/>fide ei esse redditas, qua meas mihi curavit <lb xml:id="p1z4"/>certo tradi; interim puerum nec vidi nec novi.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z5"/>Illud vero dolet mihi plurimum, quod nuper, <lb xml:id="p1z6"/>cum hic esses, non tantum temporis concedebatur <lb xml:id="p1z7"/>nobis, ut colloqui familiarius potuerimus.</s>
					<s n="4" xml:lang="la">Interim, <lb xml:id="p1z8"/>quod ibi diminutum est, literis sarciemus mutuis.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Non est, quod magni faciatis privatorum et ebriosorum <lb xml:id="p1z10"/>hominum contra vos contumelias; sic solent <lb xml:id="p1z11"/>isti, sed bruta sunt eorum fulmina.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Huius generis <lb xml:id="p1z12"/>multa nos <placeName ref="l587">Tigurini</placeName> sustinemus a nonnullis <placeName ref="l2448">Quin<lb xml:id="p1z13"/>quepagicis</placeName>.</s>
					<s n="7" xml:lang="de">Das alles weret, biß es gnuͦg ist; <lb xml:id="p1z14"/>gott aber versumpt kein zyl.</s>
					<s n="8" xml:lang="la">Oremus illum, ut <lb xml:id="p1z15"/>liberet nos ab hominibus absurdis.</s>
					<s n="9" xml:lang="la">Ex <placeName ref="l832">Gallia</placeName> <lb xml:id="p1z16"/>dicuntur redire milites Helvetii, qui hactenus in <lb xml:id="p1z17"/><placeName ref="l832">Gallia</placeName> militarunt, omnes nec bona cum gratia regis.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z18"/>Voluit eos mittere in <placeName>Aquitaniam</placeName> ad <placeName>Vascones</placeName>; <lb xml:id="p1z19"/>sed noluerunt et petierunt dimissionem.</s>
					<s n="11" xml:lang="la">Oravit <lb xml:id="p1z20"/>rex, manerent saltem adhuc mensem, quod regina <lb xml:id="p1z21"/>Navare cum utroque principe sit in aula regis <lb xml:id="p1z22"/>serioque tractetur de pace; quodsi discedant, ad <lb xml:id="p1z23"/>iniquiorem se adigi pacem.</s>
					<s n="12" xml:lang="la">Sed noluerunt ma<lb xml:id="p1z24"/>nere dicunturque adfuturi ad paschatis festum, <lb xml:id="p1z25"/>qui scilicet sunt residui.</s>
					<s n="13" xml:lang="la">Multi moriuntur inter eos.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z26"/><placeName ref="l491">Argentinam</placeName> transire 16 cohortes regiorum equitum <lb xml:id="p1z27"/>laceri et mendici; indignantur regi, qui ipsis <lb xml:id="p1z28"/>debet 9 mensium stipendia.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Quantum putas eum <lb xml:id="p1z29"/>debere Helvetiis aut quid putas accepturos, <lb xml:id="p1z30"/>qui iam ingressi sunt de novo militiam?</s>
				</p>
				<p>
					<s n="16" xml:lang="la">Acci<lb xml:id="p1z31"/>pient morbos et maledictionem a domino.</s>
					<s n="17" xml:lang="la">Imperator <lb xml:id="p1z32"/>indixit imperialia comitia <placeName ref="l471">Spyram</placeName> <lb xml:id="p1z33"/>mense maio ad diem 27.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Mirabiles sunt <lb xml:id="p1z34"/>practicae, de quibus iam brevitas temporis scribere <lb xml:id="p1z35"/>plura non sinit.</s>
				</p>
				<p>
					<s n="19" xml:lang="la" ana="farewell">Vale una cum consulibus, <persName>Carolo</persName>, <lb xml:id="p1z36"/><persName ref="p6130">Pontisella</persName>, <persName ref="p20473">Ganthnero</persName> et d. <persName ref="p2776">Ruinella</persName>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName> <lb xml:id="p1z37"/>17. martii 1570.</s>
				</p>
				<p>
					<s n="21" xml:lang="la">Ocyssime.</s>
					<s n="22" xml:lang="la">Non relegi.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z38"/><persName ref="p495">Bullingerus</persName> tuus.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro <lb xml:id="p2z2"/>d. <persName ref="p8016">Tobiae Eglio</persName>, <lb xml:id="p2z3"/><placeName ref="l98">Curiensis</placeName> ecclesiae <lb xml:id="p2z4"/>ministro, sym<lb xml:id="p2z5"/>mystae et fratri meo <lb xml:id="p2z6"/>dilectissimo.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p2z7"/>Chur.</s>
				</p>
			</div>
		</body>
	</text>
