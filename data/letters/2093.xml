	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. in domino P. <lb xml:id="p1z2"/>Permulta mihi scribenda essent ad tuam huma<lb xml:id="p1z3"/>nitatem, si animi mei sententiae indulgerem; <lb xml:id="p1z4"/>verum propter multiplicia negotia, quibus impraesentiarum <lb xml:id="p1z5"/>obruor, vix quicquam possum, neque sane ea omnia <lb xml:id="p1z6"/>literis recte mandari possent, isteque <persName>Ioannes <lb xml:id="p1z7"/>Smutzius</persName> multo melius sermone referet.</s>
					<s n="2" xml:lang="la">O <lb xml:id="p1z8"/>summam acceptam a nostris cladem, o veram <lb xml:id="p1z9"/>pietatem repudiatam, o divini numinis in nos <lb xml:id="p1z10"/>iuste commotam iracundiam!</s>
					<s n="3" xml:lang="la">Non audeo amplius; reliqua <lb xml:id="p1z11"/>intellige.</s>
					<s n="4" xml:lang="la">Non tam summa fuimus in spe verae <lb xml:id="p1z12"/>religionis restituendae, quam sumus iam in metu <lb xml:id="p1z13"/>impiae et nefariae idololatriae revocandae.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z14"/>Funde, quaeso, preces pro me meique similes.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z15"/>Pauci eiusmodi homunciones cogimur testificari <lb xml:id="p1z16"/>de vera pietate et religione; duces <lb xml:id="p1z17"/>nostri omnes ista sunt obruti clade et in <lb xml:id="p1z18"/>carceres coniecti; de espicopis <lb xml:id="p1z19"/>sentio et eiusmodi.</s>
					<s n="7" xml:lang="la">Adsit nobis deus!</s>
					<s n="8" xml:lang="la">Nos <lb xml:id="p1z20"/>quoque inaniter sermonem habemus; nam quid <lb xml:id="p1z21"/>fiet, (nisi deus aliter mutet), constitutum est.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z22"/>Tantum ut profiteamur, in quem credimus <lb xml:id="p1z23"/>quamque tenemus religionem, a nobis est oblata <lb xml:id="p1z24"/>conditio suscepta resistendi adversariis; qualis <lb xml:id="p1z25"/>erit finis, deus novit, et ultimum an<note type="margin">a.R.: ...</note> hoc sit, <lb xml:id="p1z26"/>quod ad tuam humanitatem scribam necne.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z27"/>Valde doleo non potuisse me tam plene <persName>Smutzio</persName> <lb xml:id="p1z28"/>tuo providere per <placeName ref="l1956">Suffol[ciae]</placeName> ducem, quam vellem <lb xml:id="p1z29"/>et sperassem, nisi hoc ita cecidisset, quod non <lb xml:id="p1z30"/>possum sine lacrymis commemorare.</s>
					<s n="11" xml:lang="la">Condones igitur <lb xml:id="p1z31"/>mihi, quod de eo non plura scribam; non dubito, <lb xml:id="p1z32"/>quin ad te perlata est totius tragoediae quasi <lb xml:id="p1z33"/>series.</s>
					<s n="12" xml:lang="la">Ipse dux retinet suum verum deum et, <lb xml:id="p1z34"/>spero, retinebit suam sententiam plene de vera religi<lb xml:id="p1z35"/>one (adiuvante deo) maxime invito diabolo <lb xml:id="p1z36"/>et summe elaboranti<pb/><lb xml:id="p2z1"/>bus suis membris in transversum agere eius domin<lb xml:id="p2z2"/>ationem.</s>
					<s n="13" xml:lang="la">Quod ut melius faciat, commendo eius <lb xml:id="p2z3"/>dominationem tuis precibus et meipsum commendo <lb xml:id="p2z4"/>et mei similes.</s>
					<s n="14" xml:lang="la" ana="salute">Quaeso, salutem mihi dicas <lb xml:id="p2z5"/>d. <persName ref="p8171">Bibliandro</persName>.</s>
					<s n="15" xml:lang="la">Deus adsit vobis suo <lb xml:id="p2z6"/>spiritu ad finem et per vos suum illustret <lb xml:id="p2z7"/>nomen semper, quomodo hactenus fecit.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z8"/><placeName ref="l296">Londini</placeName> 30. novembris 1553.</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z9"/>Tui studiosissimus <lb xml:id="p2z10"/><persName ref="p1422">Iacobus Haddonus</persName>.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><pb/><lb xml:id="p4z1"/>Observandissimo in <lb xml:id="p4z2"/>Christo patri d. <lb xml:id="p4z3"/><persName ref="p495">Bullingero</persName>.</s>
				</p>
			</div>
