	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Fui his diebus una cum d. <persName ref="p8417">Musculo</persName>, dum ferias habemus <lb xml:id="p1z2"/>autumnales, <placeName ref="l339">Neocomi</placeName>.</s>
					<s n="3" xml:lang="la" ana="salute"><persName ref="p1049">Farellus</persName>, qui se valde humanum nobis <lb xml:id="p1z3"/>exhibuit, te et omnes fratres, qui sunt illic, plurimum salutat.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z4"/>Expectatur, quid <persName>Pagani</persName> denuo agant in causa ministri <persName>S. <lb xml:id="p1z5"/>Blasii</persName>, qui praeterquam quod vicinorum voce usus est, nihil est locutus, <lb xml:id="p1z6"/>quod quemquam vel laedere vel offendere possit.</s>
					<s n="5" xml:lang="la">Sed sine dubio latet <lb xml:id="p1z7"/>etiam alius anguis in hac herba.</s>
					<s n="6" xml:lang="la">Audiemus, quid venturum sit ex comitiis <lb xml:id="p1z8"/>illis <placeName ref="l21">Badensibus</placeName>.</s>
					<s n="7" xml:lang="la">Nostri neminem mittere voluerunt propter causas, <lb xml:id="p1z9"/>de quibus prius scripsi.</s>
				</p>
				<p>
					<s n="8" xml:lang="la">Bellum contra <persName>Gallum</persName> a Caesare in <placeName ref="l631">Burgun<lb xml:id="p1z10"/>dia</placeName> iam publice promulgatum et proclamatum est.</s>
					<s n="9" xml:lang="la"><persName>Maria</persName>, soror <persName ref="p18538">Caesaris</persName>, <lb xml:id="p1z11"/>in <placeName ref="l2589">Picardia</placeName> molitur aliquid contra <persName>Gallum</persName>.</s>
					<s n="10" xml:lang="la">Ipse interea sęvit <lb xml:id="p1z12"/>in pios declarans se non cum papatu, sed cum <persName>Iulio</persName> bellum gerere.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z13"/>Metuo valde de huic regno propter sanguinem christianum, quem fudit, <lb xml:id="p1z14"/>et nobis quoque, qui ab illius commercio tot periculis et malis edocti <lb xml:id="p1z15"/>nondum tamen abstinere didicimus prorsus.</s>
				</p>
				<p>
					<s n="12" xml:lang="de">Unsers schultheß <persName ref="p2305">Nägelins</persName> <lb xml:id="p1z16"/>sünen einer ist von dem <persName ref="p17907">Gonzaga</persName> zuͦ <placeName ref="l306">Meiland</placeName> gefangen, als <lb xml:id="p1z17"/>er gen <placeName ref="l1122">Parma</placeName> wellen.</s>
					<s n="13" xml:lang="de">Den hatt der Müßer erfaren und begert <lb xml:id="p1z18"/>an <persName ref="p17907">Gonzagam</persName>, das er inn imm laße, welchs er thon.</s>
					<s n="14" xml:lang="de">Der schlecht jetz uff <lb xml:id="p1z19"/>ein rantzung 4m kronen, wil damitt dem vatter intrencken, <lb xml:id="p1z20"/>was er vornaher in siner sach ghandlet; er ist angschafft.</s>
					<s n="15" xml:lang="de">Ist <lb xml:id="p1z21"/>aber eben deß rechten: bhieltend wir unsere kind daheim und <lb xml:id="p1z22"/>lartinds werchen, so bschech inen das nitt.</s>
					<s n="16" xml:lang="de">Uns muͦß aber also <lb xml:id="p1z23"/>deß <placeName ref="l832">Frantzosen</placeName> werden, damitt wir nitt vergeben frantzö<lb xml:id="p1z24"/>sisch sigind.</s>
					<s n="17" xml:lang="de">Man wirt gsen, ob er möchte gegen deß küngs gfangn<lb xml:id="p1z25"/>en einem gelediget werden.</s>
				</p>
				<p>
					<s n="18" xml:lang="la">Haec habui modo.</s>
					<s n="19" xml:lang="la">Exemplarium <persName ref="p3375">Vergerii</persName> <lb xml:id="p1z26"/>nulla mitto propter tempestatem; literas tamen, quas simul mitto, illi dabis.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="farewell">Vale.</s>
					<s n="21" xml:lang="la" ana="salute"><lb xml:id="p1z27"/>Saluta uxorem, liberos, fratres; salutant vos quoque mei.</s>
					<s n="22" xml:lang="la"><placeName ref="l41">Bernae</placeName> 4. calendis octobris 1551.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><persName ref="p8018">I[oannes] Hall[erus</persName>].</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino et compatri suo <lb xml:id="p2z5"/>charissimo.</s>
				</p>
				<p>
					<s n="25" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l587">Zürich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
