	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Anno 50 adi<note xml:id="fn1" type="footnote" n="1">anno domini?</note> 26. septembris ex colonia.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">S. P.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z2"/>Non potui per d. <persName ref="p4851">Froschouerum</persName> ex nundinis respondere propter occupationes.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Literas in <placeName ref="l830">Angliam</placeName> transmittendas <lb xml:id="p1z3"/>curavi una cum aliis a <persName ref="p4851">Froschouero</persName> commissis.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><persName>Florianus</persName> ante 8 menses fuit <placeName ref="l210">Heydelbergae</placeName>; quonam se postea <lb xml:id="p1z4"/>contulerit, ignoramus; imposuit multis piis.</s>
					<s n="6" xml:lang="la">Ago tuae dominationi ingentes gratias pro labore suscepto ad d. <persName ref="p1560">Hoperum</persName>; <lb xml:id="p1z5"/>non dubito illum nihil non facturum et curaturum tuo nomine.</s>
					<s n="7" xml:lang="la">Ipse paro profectionem quam primum.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z6"/>Senior noster archiepiscopus ecclesiae <placeName ref="l587">Tigurinae</placeName> se commendat et vestris precibus, quemadmodum ex hisce <lb xml:id="p1z7"/>ad te literis intelliges; utinam tibi integrum esset illum invisere; agit gratias pro libro tuo.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z8"/>D. <persName ref="p536">Caesario</persName> tuas salutationes indicavi.</s>
					<s n="10" xml:lang="la">Agit <placeName ref="l267">Coloniae</placeName> apud <placeName>Widenbachenses</placeName> prope d. <persName>Panthaleonem</persName>, totus <lb xml:id="p1z9"/>iam surdus est; non potuit scribere, prima oportunitate mittet aliquot carmina ad te.</s>
					<s n="11" xml:lang="la">Preleguntur illi <lb xml:id="p1z10"/>quotidie tua commentaria in Novum Testamentum; precatur tibi et omnibus doctis omnia leta.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z11"/>Mitius agit Caesar in <placeName ref="l2529">Brabantia</placeName>.</s>
					<s n="13" xml:lang="la">Quidnam boni allatura est regina Ungariae, quae apud Caesarem <lb xml:id="p1z12"/>de mitiganda inquisitione <placeName ref="l875">Hispanica</placeName> profecta est, adhuc nescimus; speramus meliora.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z13"/>Literas in <placeName ref="l642">Phrysiam</placeName> mittendas curabo.</s>
					<s n="15" xml:lang="la">Expecto in horas bibliopolas ex <placeName ref="l185">Groninga</placeName> et <placeName ref="l138">Embda</placeName>; illis committam.</s>
					<s n="16" xml:lang="la"><lb xml:id="p1z14"/>Capsam ligneam et epistolas d. <persName ref="p8011">Rodolphi Gvalteri</persName> accepi; adiunxi meis rebus in <placeName ref="l830">Angliam</placeName> missis; offero illi <lb xml:id="p1z15"/>officium meum.</s>
					<s n="17" xml:lang="la">D. <persName ref="p1283">Gesneri</persName> literas legendas dedit d. <persName>Echtio</persName> et d. <persName>Bernardo</persName>; uterque pro missis stabit.</s>
					<s n="18" xml:lang="la"><lb xml:id="p1z16"/>D. <persName>Hermannus Petri</persName> summa cum diligentia librum <persName ref="p540">Calvini</persName> De vitandis superstitionibus legit; agit tibi summas gratias.</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z17"/>Mandaveram famulo meo, ut <persName ref="p4851">Froschouero</persName> pro d. <persName ref="p1283">Gesnero</persName> novos libros traderet; quod infectum comperi.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="salute"><lb xml:id="p1z18"/>Salutabis meo nomine omnes, quos noveris mihi amicos.</s>
					<s n="21" xml:lang="la">Brevi latius scribam.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><lb xml:id="p1z19"/>Tuus <persName ref="p380">Ioannes Byrckmannus</persName> senior.</s>
				</p>
				<p>
					<s n="23" xml:lang="la"><lb xml:id="p1z20"/>Domino <persName ref="p4851">Froschouero</persName> non scribo; vellem, curaret imprimi Biblia duarum translationum et Psalterium <lb xml:id="p1z21"/><persName ref="p1753">Leonis Iudae</persName>.</s>
					<s n="24" xml:lang="la">Desyderatur unus tomus tuarum <persName>Decadum</persName>, quem imprimi optarem.</s>
					<s n="25" xml:lang="la">Preterea tuum <lb xml:id="p1z22"/>contra anabaptistas et d. <persName ref="p4091">Zvinglii</persName> Passio et Catechesis <persName ref="p1753">Leonis Iudae</persName> summopere expectatur.</s>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, Tigurensi antistiti <lb xml:id="p2z3"/>vigilantissimo, dominum plurimum <lb xml:id="p2z4"/>colendo.</s>
				</p>
				<p>
					<s n="27" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
