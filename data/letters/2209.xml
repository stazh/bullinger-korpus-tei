	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Duobus mensibus et amplius prope nullas <lb xml:id="p1z2"/>abs te, fili literas accipimus.</s>
					<s n="3" xml:lang="la">Tribuo hoc <lb xml:id="p1z3"/>tuis studiis adeo assiduis, ut non tantillum <lb xml:id="p1z4"/>temporis tibi decidas, quo scribas, et literas <lb xml:id="p1z5"/>quidem non necessarias.</s>
					<s n="4" xml:lang="la">Non enim cupio, <lb xml:id="p1z6"/>ut literas scribas de nulla re gravi aut <lb xml:id="p1z7"/>necessaria; malo te omne tempus literis et lectio<lb xml:id="p1z8"/>nibus impendere.</s>
					<s n="5" xml:lang="la">Si vero aliquando mittas <lb xml:id="p1z9"/>exercitationis aliquod specimen, unde stu<lb xml:id="p1z10"/>diorum tuorum profectum experiri aut aestimare liceat, <lb xml:id="p1z11"/>aut de studiis tuis et de praeceptoribus lectio<lb xml:id="p1z12"/>nibusque aliquid mecum commenteris, rem facies <lb xml:id="p1z13"/>gratam.</s>
					<s n="6" xml:lang="la">Expecto nunc iterum schedam ex<lb xml:id="p1z14"/>pensarum; inde sumentem initium, unde priorem <lb xml:id="p1z15"/>terminaveras: nam quae tuae necessitati <lb xml:id="p1z16"/>inservire videro, libere concedam, prae<lb xml:id="p1z17"/>sertim si intelligam te progressus facere egre<lb xml:id="p1z18"/>gios in pietate et eruditione; ideo enim hos <lb xml:id="p1z19"/>in te sumptus facio, ut hunc scilicet finem consequar, <lb xml:id="p1z20"/>quo redeas aliquando ad nos melior et doctior, id <lb xml:id="p1z21"/>quod ego a deo nostro precibus postulo indefessis, et <lb xml:id="p1z22"/>ut idem tu quoque facias, oro atque obtestor.</s>
					<s n="7" xml:lang="la">Sic <lb xml:id="p1z23"/>satis, deo gratia, recte valemus omnes, nisi quod <lb xml:id="p1z24"/>mater atque ego frequentibus capitis doloribus <lb xml:id="p1z25"/>distringimur.</s>
					<s n="8" xml:lang="la">Admonet nos ita bonus dominus nostrae <lb xml:id="p1z26"/>sortis et vos quoque liberos nostros, ut vobis provideatis <lb xml:id="p1z27"/>in tempore, dum adhuc vivimus et auxilium <lb xml:id="p1z28"/>vobis ferre possumus; mortuis enim nobis <lb xml:id="p1z29"/>non eadem facilitate procedent omnia.</s>
					<s n="9" xml:lang="la">Quamquam <lb xml:id="p1z30"/>sat sciam deum timentibus ipsum et in veritate <lb xml:id="p1z31"/>invocantibus nunquam defuturum.</s>
					<s n="10" xml:lang="la">Volo, ut ipse has <lb xml:id="p1z32"/>literas tradas d. <persName ref="p8362">Garnerio</persName>, <persName ref="p8359">Gallicanae</persName> ecclesiae pastori, <lb xml:id="p1z33"/>et d. <persName ref="p8111">Petro Martyri</persName> suas, quem a te singu<lb xml:id="p1z34"/>lariter observari contendo etiam atque etiam.</s>
					<s n="11" xml:lang="la" ana="farewell">Vive <lb xml:id="p1z35"/>memor institutionis meae et vale, chare fili.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z36"/>Dominus benedicat tibi in aeternum.</s>
					<s n="13" xml:lang="la">Salvi s<lb xml:id="p1z37"/>int studiosi nostri, et tota domus tua valeat, etc.</s>
					<s n="14" xml:lang="la"><lb xml:id="p1z38"/><placeName ref="l587">Tiguri</placeName> 1. martii 1554.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z39"/><persName ref="p495">Bullingerus</persName> pater<pb/><lb xml:id="p2z1"/>.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p2z2"/>Dilecto suo filio <persName ref="p487">Heinrycho <lb xml:id="p2z3"/>Bullingero</persName> <placeName ref="l491">Argentinae</placeName> <lb xml:id="p2z4"/>agenti in aedibus <lb xml:id="p2z5"/>d. <persName ref="p505">Ioannis Burcheri</persName> <placeName ref="l830">Angli</placeName>.</s>
				</p>
				<p>
					<s n="17" xml:lang="de"><lb xml:id="p2z6"/><placeName ref="l491">Straßburg</placeName>.</s>
