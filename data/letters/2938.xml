	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Uxor mea charissima, charissime <lb xml:id="p1z2"/>mi <persName ref="p495">Bullingere</persName>, in pacientia summa ac <lb xml:id="p1z3"/>fide non minori animam deo reddidit <lb xml:id="p1z4"/>hodie infra quintam et sextam, tibi tuisque <lb xml:id="p1z5"/>valedixit in domino, me meosque omnes tibi recom<lb xml:id="p1z6"/>mendavit.</s>
					<s n="3" xml:lang="la">Pro hesterna visitatione tibi <lb xml:id="p1z7"/>et optimo viro <persName ref="p4091">Zwinglio</persName> gratias magnas habuit.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/>Cras curabitur per sepulturam.</s>
					<s n="5" xml:lang="la">Oramus ego et <lb xml:id="p1z10"/>filii mei, ut alius loco filii mei substituatur, qui <lb xml:id="p1z11"/>res divinas peragat in <placeName ref="l1128">Schwamendingen</placeName>, <lb xml:id="p1z12"/>ne is cogatur matrem suam charissimam sepulturę <lb xml:id="p1z13"/>per absenciam destituere.</s>
					<s n="6" xml:lang="la" ana="farewell">Vale felix semper.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z14"/>Ex <placeName ref="l229">Höng</placeName> penultima mai ann<lb xml:id="p1z15"/>o 50<note type="misc">zweifelhaft.</note>.</s>
					<s n="8" xml:lang="la"><persName ref="p8039">Johannes Hugo</persName> semper tuus.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="9" xml:lang="la"><lb xml:id="p1z16"/>Clarissimo viro domi<lb xml:id="p1z17"/>no <persName ref="p495">Henrico Bullingero</persName>, <lb xml:id="p1z18"/>compatri suo <pb/><lb xml:id="p2z1"/>charissimo.</s>
				</p>
				<p>
					<note type="author">[Bemerkung von <persName ref="p495">Bullingers</persName> Hand auf der Vorderseite unten:]</note>
					<s n="10" xml:lang="la">Chare fili, te oro, <lb xml:id="p2z2"/>ut cras concioneris in <placeName ref="l1128">S<lb xml:id="p2z3"/>chwamendingen</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
