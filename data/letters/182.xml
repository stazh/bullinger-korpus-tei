	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Tuas, mi venerande <persName ref="p495">Bullingere</persName>, cum <persName ref="p458">Brentii</persName> nostri consilio <lb xml:id="p1z2"/>accepi.</s>
					<s n="2" xml:lang="la">Nunc non est, quur plura scribere vel possim vel <lb xml:id="p1z3"/>debeam, quum <persName ref="p8417">Musculum</persName> hunc, multis nominibus venerandum <lb xml:id="p1z4"/>et charissimum fratrem, coram auditurus sis omnia ista mala, quibus <lb xml:id="p1z5"/>nunc divexantur ecclesię Christi, exponentem, quem multis <lb xml:id="p1z6"/>sane tibi tuisque symmystis ac monino vestris hominibus commen<lb xml:id="p1z7"/>darem, nisi esset vobis iamdudum et nominis claritate notus <lb xml:id="p1z8"/>et fide erga Christum et ecclesiam ipsius adamatus.</s>
				</p>
				<p>
					<s n="3" xml:lang="la"><lb xml:id="p1z9"/>Invenies in hoc viro, ubi penitius introspexeris, eruditione<lb xml:id="p1z10"/>m et pietatem minime vulgarem.</s>
					<s n="4" xml:lang="la">Hoc illi, obsecro, <lb xml:id="p1z11"/>officium mea etiam caussa praestes velim, ut comitem aliquem <lb xml:id="p1z12"/>fidelem itineris istic tuo beneficio nanciscatur, qui ipsum <lb xml:id="p1z13"/><placeName ref="l28">Basileam</placeName> deducat; illuc enim non leves ob caussas festinat, <lb xml:id="p1z14"/>praecipue vero ut illinc pientissimam uxorem cum novem liberis <lb xml:id="p1z15"/><placeName ref="l18">Augusta</placeName>, ubi valde periclitantur, ad se vocet.</s>
					<s n="5" xml:lang="la">Sunt <lb xml:id="p1z16"/>vestrates magis quam nostri eius itineris gnari; alioqui <lb xml:id="p1z17"/>ipsi optimo viro adiunxissemus, qui comitarentur.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z18"/>Comitem illum an <placeName ref="l2852">Ötingenn</placeName> neminem hic invenio qui <lb xml:id="p1z19"/>cuiusmodi vir sit, novit, nisi quod <persName ref="p4082">C[onradus] Z[viccius]</persName> meus virum valde <lb xml:id="p1z20"/>bonum esse non semel se audisse affirmat.</s>
					<s n="7" xml:lang="la">Electus est in episcopum <lb xml:id="p1z21"/>doctor <persName>Mezlerus</persName> canonicus, qui superioribus annis episcopi <lb xml:id="p1z22"/>cancellarius, aliquando etiam vicarius fuit.</s>
					<s n="8" xml:lang="la">Adeo hoc solum nunc <lb xml:id="p1z23"/>curant canonici, ut talem habeant antesignanum, qui <lb xml:id="p1z24"/>malas practicande artes probe calleat, nunquam alioqui <lb xml:id="p1z25"/>passuri, ut obscurę familię vir episcopus ipsorum salutaretur.</s>
				</p>
				<p>
					<s n="9" xml:lang="la"><lb xml:id="p1z26"/>Pro nobis ut constanter ores, quo constantes simus <placeName ref="l257">Constantienses</placeName>, <lb xml:id="p1z27"/>te, si unquam prius multum, nunc plus plurimo rogo, <lb xml:id="p1z28"/>obsecro et obtestor, non minus autem pro <placeName ref="l291">Lindaugiensibus</placeName>, <lb xml:id="p1z29"/>qui totos se domino hostiam sanctam vivam et acceptissimam ob<lb xml:id="p1z30"/>tulerunt, quorum exemplum utinam <placeName ref="l491">Argentoratenses</placeName> pariter et <lb xml:id="p1z31"/>nostri imitentur.</s>
					<s n="10" xml:lang="la">Ah ah, quam horrenda sunt iudicia domini, <lb xml:id="p1z32"/>quam animum meum infringit turpis ista et perfida multorum <lb xml:id="p1z33"/>defectio, quę <placeName ref="l822">Germanię</placeName> nostrę, quod valde metuo, <lb xml:id="p1z34"/>extrema mala portendit.</s>
					<s n="11" xml:lang="la">Dominus sibi reliquias aliquas <lb xml:id="p1z35"/>servet, in quibus potentiam brachii sui mundo declaret.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z36"/><placeName ref="l291">Lindaviensium</placeName> responsum <persName ref="p8472">Curio</persName> tibi legendum exhibebit.</s>
					<s n="13" xml:lang="la"><lb xml:id="p1z37"/>Caetera <persName ref="p8417">Musculus</persName> noster, quo feliciter in Christo fruere.</s>
					<s n="14" xml:lang="la" ana="farewell"><lb xml:id="p1z38"/>Bene vale.</s>
					<s n="15" xml:lang="la">4. Iulii anno 1548.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z39"/>Tuus <persName ref="p8055">A[mbrosius] Bl[aurerus</persName>].</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute"><lb xml:id="p1z40"/>Salutabis reverenter <lb xml:id="p1z41"/>et amantissime fratres omnes <lb xml:id="p1z42"/>et amicos cum tua dom<lb xml:id="p1z43"/>o.</s>
				</p>
				<p>
					<s n="18" xml:lang="la" ana="salute"><lb xml:id="p1z44"/>Salutant te nostri, inpr<lb xml:id="p1z45"/>imis <persName ref="p4082">C[onradus] Z[viccius]</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p4082">Conradus Zviccius</persName></note>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/><persName ref="p495">Bullingero</persName> <lb xml:id="p2z2"/>suo.</s>
					<s n="20" xml:lang="la"><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
