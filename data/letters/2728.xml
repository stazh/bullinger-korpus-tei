	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Non intermitto de te bene cogitare et sentire, propterea de rebus <lb xml:id="p1z2"/>imperii tibi, tibi inquam amico, pauca perstringere libet.</s>
					<s n="3" xml:lang="la">Rex cum <lb xml:id="p1z3"/>papistarum grege multos nunc menses Augustę triverunt omnem <lb xml:id="p1z4"/>lapidem moventes, quomodo reliquum <placeName ref="l822">Germanię</placeName> pessundarent; pręcipue <lb xml:id="p1z5"/>vero in hoc fuerunt, ut papatum reducerent Christo Iesu proscripto.</s>
				</p>
				<p>
					<s n="4" xml:lang="la"><lb xml:id="p1z6"/>Tandem vero clementia dei factum est, ut adversarii ex <placeName ref="l2510">Turca</placeName> <lb xml:id="p1z7"/>et aliunde etiam imminentibus malis territi cum protestantibus <lb xml:id="p1z8"/>(ut dicitur) pepigerunt, nempe inter cętera sic:</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Communis pax inter ordines imperii sit perpetua et inviolabilis <lb xml:id="p1z10"/>sub pęna periurii et fractę pacis.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z11"/>Religio tam evangelica quam <placeName ref="l425">Romana</placeName> unicuique sit libera et impunis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><lb xml:id="p1z12"/>Archiepiscopi, episcopi, abbates et id genus egregiorum propter opes <lb xml:id="p1z13"/>si ad <placeName ref="l18">Augustanam</placeName> confessionem desciverint, bonis ecclesiasticis <lb xml:id="p1z14"/>immobilibus renuncient, reliquorm sint participes, et hoc duret <lb xml:id="p1z15"/>ad determinationem ordinariam.</s>
				</p>
				<p>
					<s n="8" xml:lang="la"><lb xml:id="p1z16"/>Principibus, baronibus et imperii proceribus liberum esto <lb xml:id="p1z17"/>in suis ditionibus sive <placeName ref="l18">Augustanam</placeName> sive papisticam religionem <lb xml:id="p1z18"/>instituere non obstante etiam si ius patronatus quarundam <lb xml:id="p1z19"/>ecclesiarum ad alios principes sive episcopos pertineat.<note type="margin">a.R.: "ęquis numero."</note></s>
					<s n="9" xml:lang="la"><lb xml:id="p1z20"/>Iudicium chamerę imperialis ęquis assessoribus ex utraque <lb xml:id="p1z21"/>religione constituatur.</s>
				</p>
				<p>
					<s n="10" xml:lang="la"><lb xml:id="p1z22"/>Quantum quisque ecclesiasticorum bonorum iam possidet, tantum <lb xml:id="p1z23"/>illi cedet et manebit.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z24"/>Capitorum plura sunt, quę ad te posthac daturus sum, quando <lb xml:id="p1z25"/>tractatio publicata fuerit, id quod intra octiduum futurum esse <lb xml:id="p1z26"/>aiunt.</s>
				</p>
				<p>
					<s n="12" xml:lang="la"><lb xml:id="p1z27"/>Lutherani et papistę voluerunt Zvinglianos, Schwenckfeldicos, <lb xml:id="p1z28"/>anabaptistas etc. nominatum a pace facta excludere, quibus <lb xml:id="p1z29"/>tamen nonnulli cordati restiterunt et omissionem eiusmodi odiosę <lb xml:id="p1z30"/>perstrictionis obtinuerunt.</s>
				</p>
				<p>
					<s n="13" xml:lang="la" ana="farewell">Vale et me tuis commenda.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><lb xml:id="p1z31"/>Ego me ab officio cancellariatus modo subtraxi sperans <lb xml:id="p1z32"/>me tranquilliorem adepturum vitam; sed opinione mea <lb xml:id="p1z33"/>falsus multis laboribus tam domi quam foris distringor.</s>
					<s n="15" xml:lang="la" ana="salute"><lb xml:id="p1z34"/>Salutem ex me dic amicis et fratribus nostris <placeName ref="l587">Tiguri</placeName> et alibi <lb xml:id="p1z35"/>agentibus.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z36"/><persName ref="p8417">Musculum</persName> nostrum salvum esse cupio, cui ad literas suas <lb xml:id="p1z37"/>respondere nunc negotia vetuerunt.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z38"/>15. septembris <lb xml:id="p1z39"/>1555.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><lb xml:id="p1z40"/>Tuus ex animo <persName ref="p8354">G[eorgius] Lętus</persName> <lb xml:id="p1z41"/>a <placeName>Lemnicz</placeName> etc.</s>
					<s n="19" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domin <persName ref="p495">Henricho Bullingero</persName>, <lb xml:id="p2z2"/>antistiti <placeName ref="l587">Tigurino</placeName>, amico <lb xml:id="p2z3"/>incomparabili<lb xml:id="p2z4"/>.</s>
				</p>
			</div>
		</body>
	</text>
</TEI>