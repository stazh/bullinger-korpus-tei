			<zone xml:id="p2z3-0" points="2419,1325 2474,1327 2522,1286 2563,1310 2647,1291 2804,1318 2810,1212 2793,1208 2730,1229 2696,1219 2647,1236 2607,1221 2524,1251 2425,1253">2434,1279 2459,1279 2484,1278 2509,1276 2535,1275 2560,1273 2585,1271 2610,1271 2636,1271 2661,1269 2686,1267 2711,1264 2737,1261 2762,1259 2787,1259 2813,1259</zone>
			<zone xml:id="p2z4-0" points="2529,1422 2543,1422 2565,1443 2586,1443 2596,1435 2609,1441 2645,1439 2639,1301 2584,1299 2569,1308 2541,1293 2524,1295">2538,1384 2565,1382 2592,1382 2619,1386 2646,1387</zone>
