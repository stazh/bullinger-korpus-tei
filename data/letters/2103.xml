	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scripsi ad te nudius tertius de iis, quae ad me variis ex locis <lb xml:id="p1z2"/>perlata fuerant; nunc nihil habeo, quod addam.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Tantum te rogo, <lb xml:id="p1z3"/>si mea et <persName ref="p3375">Vergerii</persName> tui causa aliquid facere vis (ut certe vis), <lb xml:id="p1z4"/>mitte quamprimum ad eum has literas et, si aliter expediri re<lb xml:id="p1z5"/>s non potest, dedita opera nuncium mitte.</s>
					<s n="4" xml:lang="la">Ego hic quaeri <lb xml:id="p1z6"/>iussi; sed plane nemo repertus est, ut sunt hic homines, qui <lb xml:id="p1z7"/>vel extra hypocaustum caput efferre vellet.</s>
					<s n="5" xml:lang="la">Quantum pro <lb xml:id="p1z8"/>mercede promiseris, exolvet <persName ref="p3375">Vergerius</persName>; ego vel duplo redemerim, <lb xml:id="p1z9"/>ut hac te molestia liberarem.</s>
					<s n="6" xml:lang="la">Sed aut mitti non debuerunt <lb xml:id="p1z10"/>literae aut per te mitti; ita parum aliis puto esse committendum.</s>
					<s n="7" xml:lang="la"><lb xml:id="p1z11"/>Scio te austeriore, quam vellem, instituto omnia ab amicis praeter <lb xml:id="p1z12"/>bonam voluntatem repudiare.</s>
					<s n="8" xml:lang="la">Habes liberos, habes amicos: fac, <lb xml:id="p1z13"/>si qua in re aliquid possimus, ut nostreae erga tantum virum <lb xml:id="p1z14"/>benevolentiae vestigium aliquod extet.</s>
					<s n="9" xml:lang="la" ana="farewell">Vale.</s>
					<s n="10" xml:lang="la"><placeName ref="l98">Curiae</placeName>, nonis decembris.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z15"/>Magni refert <persName ref="p3375">Ve<lb xml:id="p1z16"/>rgerii</persName> literas quam celerrime ad eum <lb xml:id="p1z17"/>curari; si forte haud in magno sit aere s<lb xml:id="p1z18"/>uo, ut plaerumque bonis viris accidit, <lb xml:id="p1z19"/>vel duplum nuncio pro mercede pendam.</s>
					<s n="12" xml:lang="la"><lb xml:id="p1z20"/>Nunc re incerta constituere non potui, <lb xml:id="p1z21"/>quid mitterem.</s>
				</p>
				<p>
					<s n="13" xml:lang="la"><lb xml:id="p1z22"/>Tuus <persName ref="p8332">episcopus Bayonensis</persName>.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Henrico <lb xml:id="p2z2"/>Bullingero</persName>, ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ministro, amico charissimo.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z4"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
