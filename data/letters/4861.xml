	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">In hac patientię officina tam misere et ingrate vexatus <lb xml:id="p1z2"/>et agitatus fui singulis fere momentis, ut respirandi vix datum <lb xml:id="p1z3"/>sit ocium, nedum explendi officia scribendi.</s>
					<s n="3" xml:lang="la">Talis est institutio huius <lb xml:id="p1z4"/>senecte mundi.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">Mitto ad te supplicationem factam regi et libellum oblatum iunio mense.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Epicopi et doctiores ex <placeName ref="l832">Gallia</placeName> convenire debent <placeName ref="l378">Parisiis</placeName> 20. huius mensis, <lb xml:id="p1z6"/>ut super religionis reformatione deliberent.</s>
					<s n="6" xml:lang="la">Orandus dominus, ut hominum <lb xml:id="p1z7"/>mentes illuminet suo spiritu.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><placeName ref="l646">Glaronense</placeName> negocium dilatum in <persName>sancti Galli diem</persName>. [16.10.1561]</s>
				</p>
				<p>
					<s n="8" xml:lang="la" ana="salute"><lb xml:id="p1z8"/>Salutabis amicos omnes.</s>
				</p>
				<p>
					<s n="9" xml:lang="la" ana="farewell">Bene vale.</s>
				</p>
				<p>
					<s n="10" xml:lang="de"><placeName ref="l21">Badene</placeName> 4. iulii.</s>
				</p>
				<p>
					<s n="11" xml:lang="la"><lb xml:id="p1z9"/>Tuus ex animo <persName ref="p629">Coignetius</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse von anderer Hand:]</note>
					<s n="12" xml:lang="la"><pb/><lb xml:id="p2z1"/>Domino <persName ref="p495">Henrico Bulinghero</persName>, <lb xml:id="p2z2"/>ecclesie <placeName ref="l587">Tigurinae</placeName> pastori vi<lb xml:id="p2z3"/>gilantissimo.</s>
					<s n="13" xml:lang="la">Tigury.</s>
				</p>
			</div>
		</body>
	</text>
