	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Accepi binas tuas et communicavi cum consulibus, quae <lb xml:id="p1z2"/>communicanda erant.</s>
				</p>
				<p>
					<s n="3" xml:lang="la">Agimus tibi gratias pro fide et dili<lb xml:id="p1z3"/>gentia.</s>
					<s n="4" xml:lang="la">Intelligimus aliunde quoque principes sacerdotum <lb xml:id="p1z4"/>instinctu multa parare contra omnes evangelicos, quos se<lb xml:id="p1z5"/>mel excindere cogitent; sed ita instutuunt consilia <lb xml:id="p1z6"/>ut arte Carolina his omnia tuta et amica promittant, <lb xml:id="p1z7"/>illis vim inferant, sublatis autem e medio iam <lb xml:id="p1z8"/>et alios aggrediantur.</s>
					<s n="5" xml:lang="la">Ex <placeName ref="l18">Augusta</placeName> scribunt amici di<lb xml:id="p1z9"/>missos in <placeName ref="l808">Belgico</placeName> 3000 <placeName ref="l875">Hispanorum</placeName> iterum conscribi <lb xml:id="p1z10"/>et expectari <placeName ref="l15">Antverpiae</placeName> <persName>Philippum</persName>.</s>
				</p>
				<p>
					<s n="6" xml:lang="la">Forte mors <lb xml:id="p1z11"/><persName>Galli</persName> interturbat istorum consilia.</s>
					<s n="7" xml:lang="la">Certum est <lb xml:id="p1z12"/><persName>Navarrum</persName> gubernationi adhibitum et fratrem eius <lb xml:id="p1z13"/>principem de <placeName>Conde</placeName>, cordatum principem, qui fuerat <lb xml:id="p1z14"/>captivus, magno esse in precio.</s>
					<s n="8" xml:lang="la">Sic eveniebat <lb xml:id="p1z15"/><persName>Valentiniano</persName> imperatori sublato Iuliano.</s>
				</p>
				<p>
					<s n="9" xml:lang="la">Mortuus est <lb xml:id="p1z16"/>et rex <placeName ref="l2520">Svetiae</placeName>; filius eius magnum conscribit exercitum <lb xml:id="p1z17"/>ac putatur hoc facere contra <placeName ref="l825">Danos</placeName>.</s>
					<s n="10" xml:lang="la">Admonent <lb xml:id="p1z18"/>haec me verborum domini Math. 24: "Audituri estis r<lb xml:id="p1z19"/>umores bellorum; videte, ne turbemini."</s>
					<s n="11" xml:lang="la">Cras de<lb xml:id="p1z20"/>signabuntur legati <placeName ref="l21">Badenam</placeName>; habebitur enim maior <lb xml:id="p1z21"/>senatus.</s>
					<s n="12" xml:lang="la">23. huius sublatus est lapis ex <placeName>Foro</placeName> panario per <lb xml:id="p1z22"/>senatus consultum, qui ibi visebatur a praetereuntibus <lb xml:id="p1z23"/>et in bello <placeName ref="l587">Tigurino</placeName> a <placeName ref="l41">Bernatibus</placeName> in curiam senatoriam <lb xml:id="p1z24"/>deiectus fuerat et ibi iam asservatus supra <lb xml:id="p1z25"/>114 annos in rei memoriam.</s>
					<s n="13" xml:lang="la">Visum est autem senatui <lb xml:id="p1z26"/>in his turbis non facere ad amicitiam confirmandam <lb xml:id="p1z27"/>huiusmodi... raculorum symbola.</s>
					<s n="14" xml:lang="la">Scio rem istam <lb xml:id="p1z28"/><placeName ref="l2448">Paganis</placeName> fore ingratissimam; nunc enim iactarunt se satis <lb xml:id="p1z29"/>certos esse <placeName ref="l587">Tigurinos</placeName> et <placeName ref="l41">Bernates</placeName> nunquam ex animo <lb xml:id="p1z30"/>cohaesuros, quando hic lapis sit lapis exacerbationis <lb xml:id="p1z31"/>et offendiendi etc.</s>
				</p>
				<p>
					<s n="15" xml:lang="la">Nihil nunc ad tuas <lb xml:id="p1z32"/>respondeo ordine; nam aegre haec scribo.</s>
					<s n="16" xml:lang="la">Revalui <lb xml:id="p1z33"/>quidem, id est non amplius decumbo et semel et iterum <lb xml:id="p1z34"/>concionatus sum, sed aegre, <foreign xml:lang="de">trüffen umhin und sol nüt.</foreign></s>
					<s n="17" xml:lang="la"><lb xml:id="p1z35"/>Nunc vero maxime opus erat viribus; nam <lb xml:id="p1z36"/>primum De conciliis librum absolvi, secundum produxi <lb xml:id="p1z37"/>usque ad <placeName ref="l28">Basiliense</placeName> concilium; iam addenda erat <lb xml:id="p1z38"/>catastrophe.</s>
					<s n="18" xml:lang="la">Germanice quoque hoc ipsum <lb xml:id="p1z39"/>opus <lb xml:id="p1z40"/>scribendum.</s>
				</p>
				<p>
					<s n="19" xml:lang="la">Statueram et de coelo, de dextera dei et ubiqu<lb xml:id="p1z41"/>itate <lb xml:id="p1z42"/>corporis Christi scribere in <lb xml:id="p1z43"/>verba domini Ioannis 14. "In domo patris mei" etc.</s>
					<s n="20" xml:lang="de">Aber ich weiß <lb xml:id="p1z44"/>nitt, wie es gan wil; gott weist es; dem befilch <lb xml:id="p1z45"/>ich mich.</s>
				</p>
				<p>
					<s n="21" xml:lang="de">Wünsch üch, üwer lieben hußfrowen <pb/><lb xml:id="p2z1"/>und unsern lieben herren und fründen, burgermeister[n] beiden, <persName>Philippo</persName>, <lb xml:id="p2z2"/><persName ref="p6130">Pontasellę</persName> etc. vil guͦter jaren: Gott mitt üch trüwlich.</s>
				</p>
				<p>
					<s n="22" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 27. decembris anno a <lb xml:id="p2z3"/>nato Christo 1561.</s>
					<s n="23" xml:lang="la" ana="salute">Salutat te <persName ref="p1884">Ludovicus</persName>.</s>
				</p>
				<p>
					<s n="24" xml:lang="la"><persName ref="p495">Bullingerus</persName> Praestantissimo viro d. <lb xml:id="p2z4"/><persName ref="p8009">Ioanni Fabritio</persName>, <placeName ref="l98">Curiensis</placeName> ecclesiae mini<lb xml:id="p2z5"/>stro fidelissimo, domino et fratri colendo <lb xml:id="p2z6"/>et percharo.</s>
					<s n="25" xml:lang="la"><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
