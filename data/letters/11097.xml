	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Gratiam a Domino.</s>
				</p>
				<p>
					<s n="2" xml:lang="la">Placuit hoc nuncio <placeName ref="l167">Genevensis</placeName> ecclesiae confessionem <lb xml:id="p1z2"/>eucharistiae, vocis item Adonai explicationem perspicuam, visita<lb xml:id="p1z3"/>toribus <persName ref="p5565">Capitoni</persName> et <persName ref="p467">Bucero</persName> iam pridem <placeName ref="l41">Bernae</placeName> oblatam trans<lb xml:id="p1z4"/>mittere, quo quid boni viri illi et doctissimi hisce in rebus <lb xml:id="p1z5"/>sentiant appareat.</s>
					<s n="3" xml:lang="la">Spero me vigesima huius mensis prima <lb xml:id="p1z6"/>sub noctem vobiscum <placeName ref="l587">Tiguri</placeName> futurum.</s>
					<s n="4" xml:lang="la">Dominus vobiscum.</s>
					<s n="5" xml:lang="la"><placeName ref="l41">Bernae</placeName>, 13. <lb xml:id="p1z7"/>Octobris anno XXXVII.</s>
				</p>
				<p>
					<s n="6" xml:lang="la"><lb xml:id="p1z8"/><persName ref="p8412">Megander</persName> totus vester.</s>
				</p>
				<p>
					<s n="7" xml:lang="la"><pb/><lb xml:id="p2z1"/>Dominis et fratribus in Domino obser<lb xml:id="p2z2"/>vandissimis <persName ref="p495">Bullingero</persName> et <lb xml:id="p2z3"/>Leoni <placeName ref="l587">Tiguri</placeName> a concionibus.</s>
					<s n="8" xml:lang="de"><lb xml:id="p2z4"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
