	<text xml:lang="de">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="de"><lb xml:id="p1z1"/>Diewyl ich ylends disen botten find uff <placeName ref="l555">Winterthur</placeName>, <lb xml:id="p1z2"/>hab ich euch disen brieff mines l[ieben] v[etters] <persName ref="p4082">C[onrat] Zwicken</persName> <lb xml:id="p1z3"/>zuͦschicken wellen in höchster yl; hab euch uff mentag <lb xml:id="p1z4"/>by <persName ref="p8393">Hieronymo Emporo</persName> und davor uff dienstag, ouch uff <placeName ref="l555">Wynterthuͦr</placeName>, <lb xml:id="p1z5"/>geschriben.</s>
					<s n="2" xml:lang="de">Bittend gott fuͤr unß trülich.</s>
					<s n="3" xml:lang="la">7. augusti 1549.</s>
				</p>
				<p>
					<s n="4" xml:lang="la">T[uus] <lb xml:id="p1z6"/><persName ref="p8055">A[mbrosius] Bl[aurerus]</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="5" xml:lang="de"><pb/><lb xml:id="p2z1"/>An meister <persName ref="p495">Heinrich <lb xml:id="p2z2"/>Bullinger</persName> in sin hand.</s>
				</p>
				<p>
					<s n="6" xml:lang="de"><lb xml:id="p2z3"/><placeName ref="l587">Zurich</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
