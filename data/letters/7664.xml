	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Redditis tuis literis, vir praeclarissime, simul <lb xml:id="p1z2"/>undique non dissimiles ferebantur sermones.</s>
					<s n="3" xml:lang="la">Adsunt etiam <lb xml:id="p1z3"/>magnifici d. legati nuncii, qui me ad prandium <lb xml:id="p1z4"/>vocarunt.</s>
					<s n="4" xml:lang="la">Nolui difficilem me prestare, cum quia <lb xml:id="p1z5"/>totum invitaverat senatum, tum quia se nova <lb xml:id="p1z6"/>quaedam nobis significaturum pollicebatur.</s>
				</p>
				<p>
					<s n="5" xml:lang="la">Splendide <lb xml:id="p1z7"/>tractati sumus.</s>
					<s n="6" xml:lang="la">In medio autem prandio exorsus talia <lb xml:id="p1z8"/>et Latinis et Italicis verbis proferebat: certum esse <persName ref="p18394">princi<lb xml:id="p1z9"/>pem Uraniensem</persName> <placeName ref="l1284">Bruxellas</placeName> intravisse, urbem <lb xml:id="p1z10"/>sponte claves obtulisse et potissimam nobilium <lb xml:id="p1z11"/>partem ipsi nunc adhaerescere.</s>
					<s n="7" xml:lang="la">Nervos proinde belli <lb xml:id="p1z12"/>copiosissimos nunc minime defuturos; esse enim <placeName ref="l1284">B[ruxell<lb xml:id="p1z13"/>as]</placeName> sedem regiam et pecuniis aliisque belli usibus refer<lb xml:id="p1z14"/>tissimam.</s>
					<s n="8" xml:lang="la">Reginam etiam <placeName ref="l875">Hispaniae</placeName> <placeName ref="l832">Gallam</placeName> vitam cum <lb xml:id="p1z15"/>morte commutasse, antequam autem exspiraret, in gra<lb xml:id="p1z16"/>vissimam colloquutionem cum rege erupisse, nempe: <lb xml:id="p1z17"/>[<lb xml:id="p1z18"/>O mi rex, nunc persuasum mihi est, imo exploratum habeo <lb xml:id="p1z19"/>te autorem esse patriae dilacerationis.</s>
					<s n="9" xml:lang="la">Te impulsore et <lb xml:id="p1z20"/>adiutore frater meus charissimus, <persName ref="p20341">rex Galliarum</persName>, <lb xml:id="p1z21"/>de corona periclitatur, regnum proteritur, pii miserri<lb xml:id="p1z22"/>me cruciantur omnisque humanitatis modus exceditur.</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z23"/>Desine, quaeso, desine.</s>
					<s n="11" xml:lang="la">Deus enim est deus,] etc..</s>
					<s n="12" xml:lang="la">Mentionem <lb xml:id="p1z24"/>etiam fecit extincti filii suaeque mortis instantis, cuius <lb xml:id="p1z25"/>luctus hinc inde conceptus non ultima sit occasio <lb xml:id="p1z26"/>et causa.</s>
					<s n="13" xml:lang="la">Ipsi quoque regi interitum et miserrimum <lb xml:id="p1z27"/>exitum praesagivit.</s>
					<s n="14" xml:lang="la">At ille sub haec omnia Luteranam <lb xml:id="p1z28"/>eam esse regessit.</s>
					<s n="15" xml:lang="la">Subinnuit quoque d. l[egatus] veneno in<lb xml:id="p1z29"/>fectam esse reginam.</s>
					<s n="16" xml:lang="la"><placeName ref="l1250">Tolosam</placeName> captam esse negavit <lb xml:id="p1z30"/>nec proelium ullum commissum esse, sed brevi fore.</s>
					<s n="17" xml:lang="la"><lb xml:id="p1z31"/>Ex <placeName ref="l834">Italia</placeName> nihil iam habeo memorabile, et, quod <lb xml:id="p1z32"/>sciat, <persName ref="p8089">Lentulo</persName> quoque nihil est.</s>
					<s n="18" xml:lang="la">Certum est duo foedera, <lb xml:id="p1z33"/>Iurisdictiones nempe et Domum Dei, in eo convenisse, ut <lb xml:id="p1z34"/>monachi sistantur in comitiis neque factum tam <lb xml:id="p1z35"/>audax sinatur inultum; sed vereor artifices quosdam etc.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z36"/>Plura non possum; incepi enim febricitare.</s>
					<s n="20" xml:lang="la">D. Iesus nos <lb xml:id="p1z37"/>omnes beet.</s>
					<s n="21" xml:lang="la">Amen.</s>
				</p>
				<p>
					<s n="22" xml:lang="la">Datae ocyssime <placeName ref="l98">Curiae</placeName> <placeName ref="l648">R[aetorum]</placeName> 1568, <lb xml:id="p1z38"/>9. novembris.</s>
					<s n="23" xml:lang="la"><pb/><lb xml:id="p2z1"/>Praeclarissimo viro d. <lb xml:id="p2z2"/>m. <persName ref="p495">Hennrico Bullingero</persName>, <lb xml:id="p2z3"/>ecclesiae <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z4"/>pastori summo, d. <lb xml:id="p2z5"/>suo colendissimo.</s>
				</p>
			</div>
