			<zone xml:id="p2z3-0" points="1066,1316 1110,1333 1225,1294 1357,1347 1475,1282 1532,1302 1534,1250 1431,1234 1323,1244 1227,1220 1167,1262 1068,1254">1072,1293 1097,1289 1123,1288 1149,1287 1174,1287 1200,1285 1226,1284 1252,1284 1277,1283 1303,1282 1329,1282 1354,1284 1380,1282 1406,1281 1432,1279 1457,1278 1483,1278 1509,1277 1535,1275</zone>
			<zone xml:id="p2z4-0" points="1049,1414 1151,1368 1267,1403 1598,1393 1598,1296 1428,1320 1383,1350 1204,1297 1108,1340 1049,1333">1054,1367 1081,1366 1108,1361 1135,1361 1163,1362 1190,1364 1217,1364 1245,1364 1272,1364 1299,1364 1327,1364 1354,1367 1381,1370 1408,1370 1436,1368 1463,1364 1490,1362 1518,1361 1545,1359 1572,1360 1600,1364</zone>
