	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D.</s>
					<s n="2" xml:lang="la">Ne nihil omnino scriberem, chare frater, <lb xml:id="p1z2"/>hoc saltem scribere volui me tuas accepisse <lb xml:id="p1z3"/>et abunde risisse, cum legerem morionis concionem.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Occurrebat mox illud: "Ex ore infantium <lb xml:id="p1z5"/>et lactentium perfecisti virtutem, ut destruas inimi<lb xml:id="p1z6"/>cum et ultorem."</s>
					<s n="4" xml:lang="la">Saepe isti homines antea quoque en<lb xml:id="p1z7"/>comium ante victoriam cecinerunt, cum celeusma eorum <lb xml:id="p1z8"/>desineret tandem in ipsorum: requiet eis, luceat eis etc.</s>
				</p>
				<p>
					<s n="5" xml:lang="la"><lb xml:id="p1z9"/>Oremus dominum, ut prostrato <placeName>Sisara</placeName> et <placeName>Holopherne</placeName> <lb xml:id="p1z10"/>ecclesia de laudes concinat domino, quoniam bonus, quoniam <lb xml:id="p1z11"/>in aeternum misericordia eius; ipse enim afflictis <lb xml:id="p1z12"/>adest et invocantes nomen eius exaudit, humiles <lb xml:id="p1z13"/>exaltat et superbos deiecit e sedibus.</s>
					<s n="6" xml:lang="la"><persName>Gedeon</persName> mihi, <lb xml:id="p1z14"/>quantum quidem possum, mihi curae erit.</s>
					<s n="7" xml:lang="la">Verum tu <lb xml:id="p1z15"/>scis magistratum et ecclesiam hac in parte prorsus <lb xml:id="p1z16"/>esse oneratam rectissimeque iudicas sordidum esse, <lb xml:id="p1z17"/>quod urbs adeo opulenta ministri sui filio non in ali<lb xml:id="p1z18"/>quo saltem prospicit.</s>
					<s n="8" xml:lang="la">Inservivit ille multis <lb xml:id="p1z19"/>annis ecclesiae; nunc ei haec refertur gratia.</s>
					<s n="9" xml:lang="la">Sed hoc <lb xml:id="p1z20"/>futurum praedixit nobis dominus, qui nos nostrosque <lb xml:id="p1z21"/>nunquam deseret.</s>
					<s n="10" xml:lang="la">- Episcopus <placeName ref="l257">Constantiensis</placeName> pergit in <lb xml:id="p1z22"/>suo proposito, de quo nuper ad te scripsi, ac audio <lb xml:id="p1z23"/>conventum indictum ad calendas septembres.</s>
					<s n="11" xml:lang="de"><lb xml:id="p1z24"/>Da schlach glück zuͦ, wie sy suͦchend ruͦ etc.</s>
					<s n="12" xml:lang="la">- <placeName ref="l41">Bernates</placeName> <lb xml:id="p1z25"/>audio consultare serio, an recipiant etiam <lb xml:id="p1z26"/>foedus <placeName ref="l832">Gallicum</placeName>, an respuant; regis legatus <lb xml:id="p1z27"/>urget.</s>
					<s n="13" xml:lang="la">Audio autem illos novos quosdam praescribere <lb xml:id="p1z28"/>articulos, illum imprimis: liberam esse <lb xml:id="p1z29"/>debere religionem veram per universum regnum etc. <lb xml:id="p1z30"/>ac nescio quae alia.</s>
					<s n="14" xml:lang="la">Iam adest, qui literas has <lb xml:id="p1z31"/>petit.</s>
					<s n="15" xml:lang="la">Totam vero diem consumpsi in scribendis <lb xml:id="p1z32"/>literis pluribus in <placeName ref="l2472">Poloniam</placeName> et <placeName ref="l210">Heydelbergam</placeName> etc.</s>
				</p>
				<p>
					<s n="16" xml:lang="la"><lb xml:id="p1z33"/>Proinde boni consulas haec, oro.</s>
				</p>
				<p>
					<s n="17" xml:lang="la" ana="salute">Vale una cum <lb xml:id="p1z34"/>d. <persName ref="p20473">Ganthnero</persName>, <persName ref="p6130">Pontasella</persName>, dominis consulibus<note type="margin">a.R.: cosss.</note> et ips etiam <lb xml:id="p1z35"/><persName ref="p1770">Carolo</persName> et legato regio, <persName>Baltazare</persName> quoque interprete, quos <lb xml:id="p1z36"/>omnes nomine meo salutabis.</s>
				</p>
				<p>
					<s n="18" xml:lang="la"><placeName ref="l587">Tiguri</placeName> 15. a<lb xml:id="p1z37"/>ugusti 1567.</s>
				</p>
				<p>
					<s n="19" xml:lang="la"><lb xml:id="p1z38"/><persName ref="p495">Bullingerus</persName> tuus <lb xml:id="p1z39"/>senior etc.</s>
				</p>
				<p>
					<s n="20" xml:lang="la"><pb/><lb xml:id="p2z1"/>Ornatissimo viro d. <persName ref="p8016">Thobiae <lb xml:id="p2z2"/>Eglio</persName>, <placeName ref="l98">Curiensis</placeName> <lb xml:id="p2z3"/>ecclesiae ministri fideli, <lb xml:id="p2z4"/>domino meo colendo et <lb xml:id="p2z5"/>fratri charissimo.</s>
				</p>
				<p>
					<s n="21" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l98">Chur</placeName>.</s>
				</p>
			</div>
