	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. P. D.</s>
					<s n="2" xml:lang="la">Literas tuas, quas a te <placeName ref="l587">Tiguro</placeName> accepimus, cum cura <lb xml:id="p1z2"/><placeName ref="l210">Heidelbergam</placeName> ad illustrissimum patrem misi eidemque <lb xml:id="p1z3"/>ipse etiam de negotio, quod agebatur, scripsi.</s>
					<s n="3" xml:lang="la">Quid impetratum <lb xml:id="p1z4"/>sit, mihi non constat; nam illustrissimus pater illud <lb xml:id="p1z5"/>tantum significat se tibi in his literis, quas <persName>Heinricus <lb xml:id="p1z6"/>Seringerus</persName> inter caeteris heri nobis attulit et ego per puerum <lb xml:id="p1z7"/>meum ad senatum <placeName ref="l587">Tigurinum</placeName> teque mitto, respondisse.</s>
					<s n="4" xml:lang="la"><lb xml:id="p1z8"/><persName ref="p8055">Blaurerum</persName> certe, si in mea potestate res sit, libenter in <lb xml:id="p1z9"/>familia mea sim habiturus; sin, quod nescio, aliud <lb xml:id="p1z10"/>visum est illustrissimo patri, non dubito, quin iustis <lb xml:id="p1z11"/>certisque rationibus fecerit.</s>
					<s n="5" xml:lang="la">Nam ego cum hoc tum <lb xml:id="p1z12"/>alia omnia eius prudentiae et clementiae in me paternae, <lb xml:id="p1z13"/>sicut filium obedientem decet, committo.</s>
				</p>
				<p>
					<s n="6" xml:lang="la" ana="salute">Quod scribam <lb xml:id="p1z14"/>aliud, hoc tempore nihil est; itaque bene valebis et collegas <lb xml:id="p1z15"/>tuos meo nomine salutabis.</s>
				</p>
				<p>
					<s n="7" xml:lang="la">Datae <placeName ref="l28">Basileae</placeName> 3. nonas septembris <lb xml:id="p1z16"/>anno 1568.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z17"/>Tuus <lb xml:id="p1z18"/><persName ref="p8024">Christophorus comes Palatinus</persName> manu propria [subscripsit].</s>
				</p>
				<p>
					<note type="address">[Adresse fehlt.]</note>
				</p>
			</div>
		</body>
	</text>
