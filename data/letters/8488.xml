	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S.</s>
					<s n="2" xml:lang="la">Scriberem frequentius; sed plane nihil te dignum habeo; <lb xml:id="p1z2"/>praeterea, quę minoris momenti sunt, ad fratrem <lb xml:id="p1z3"/>scribo, ut is ex iis, qui videntur isti, tibi communicet.</s>
					<s n="3" xml:lang="la"><lb xml:id="p1z4"/>Silent omnia alto silentio.</s>
					<s n="4" xml:lang="la"><placeName ref="l167">Genevenses</placeName> etiam nihil scribunt.</s>
					<s n="5" xml:lang="la"><lb xml:id="p1z5"/>Omnibus nunc negotium est cum caritate illa et rerum <lb xml:id="p1z6"/>inopia inconsueta, quamvis, si cum aliis res nostras <lb xml:id="p1z7"/>conferamus, videamus esse prae caeteris beati.</s>
					<s n="6" xml:lang="la">Mer<lb xml:id="p1z8"/>catores <placeName ref="l18">Augustani</placeName>, qui hac transeunt, mira nobis re<lb xml:id="p1z9"/>ferunt de locorum illorum calamitate.</s>
					<s n="7" xml:lang="la">Haec tamen <lb xml:id="p1z10"/>merentur peccata nostra; dominus misereatur suorum inopum!</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z11"/>Varii interea sunt rumores de conscriptione militum, <lb xml:id="p1z12"/>quae passim fiat per <placeName ref="l822">Germaniam</placeName>, cum nemo adhuc <lb xml:id="p1z13"/>sciat, in quem finem aut in cuius usus ista cedant.</s>
					<s n="9" xml:lang="la"><lb xml:id="p1z14"/>In <placeName ref="l631">Burgundia</placeName> vicina timemus aliquid mali; nam <lb xml:id="p1z15"/>istius provincię gubernator ab officio motus est, et augentur <lb xml:id="p1z16"/>subsidia <placeName ref="l875">Hispanorum</placeName>.</s>
					<s n="10" xml:lang="la">Albanus vicinos bonis verbis <lb xml:id="p1z17"/>demollit, ut nihil suspicentur mali.</s>
					<s n="11" xml:lang="la">Sed haec videntur <lb xml:id="p1z18"/>certissima turbarum esse initia.</s>
					<s n="12" xml:lang="la"><persName>Bizantini</persName>, qui hactenus <lb xml:id="p1z19"/>libertate imperii adhuc usi sunt, sibi valde <lb xml:id="p1z20"/>metuunt, ne et libertate consueta priventur et inquisit<lb xml:id="p1z21"/>ionis summum malum ipsis obtrudatur.</s>
					<s n="13" xml:lang="la">Iam poenitet <lb xml:id="p1z22"/>nostrum <persName>Gerardum a Wattenwyl</persName>, quod contempta <lb xml:id="p1z23"/>patria, domo et religione et dominio insigni, quod <lb xml:id="p1z24"/>habebat in comitatu <placeName ref="l339">Neocomensi</placeName> in <placeName ref="l631">Burgundiam</placeName> <lb xml:id="p1z25"/>res suas transferre maluerit.</s>
					<s n="14" xml:lang="la">Sed iustum hoc est dei <lb xml:id="p1z26"/>iudicium; is solet per eos ipsos ita nos punire, propter <lb xml:id="p1z27"/>quos a bono et a veritate recedimus et quorum <lb xml:id="p1z28"/>amicitiam et dilectionem amori dei praeferimus.</s>
					<s n="15" xml:lang="la"><lb xml:id="p1z29"/>Privata mediocriter habent.</s>
					<s n="16" xml:lang="la">Vidi instructionem legatis <lb xml:id="p1z30"/>vestris <placeName ref="l28">Basilaeam</placeName> missis datam, in qua quid corrigi <lb xml:id="p1z31"/>velim, si usus ferat, ad fratrem scripsi.</s>
				</p>
				<p>
					<s n="17" xml:lang="la">Interea avi<lb xml:id="p1z32"/>dissime expecto, quid factum sit; audivi quidem, <lb xml:id="p1z33"/>quomodo legati dimissi, sed quid postea factum, hoc <lb xml:id="p1z34"/>adhuc ignoro.</s>
					<s n="18" xml:lang="la">Utinam <persName ref="p2305">Nägelinus</persName> illic aliquis esset, <lb xml:id="p1z35"/>qui ulcus hoc non leniret modo, sed evelleret prorsus!</s>
					<s n="19" xml:lang="la"><lb xml:id="p1z36"/>Dolet mihi, quod audiam te calculi doloribus subinde <lb xml:id="p1z37"/>vexari; quam enim acuti sint illi, meo male saepe <lb xml:id="p1z38"/>quoque expertus sum, quamvis nunc a biennio multo <lb xml:id="p1z39"/>in hac parte melius habeam quam antea.</s>
					<s n="20" xml:lang="la">Sic dominus illis <lb xml:id="p1z40"/>lapillis nos lapidare vult; quid enim refert, quibus <lb xml:id="p1z41"/>occidamur tandem, modo id fiat in domino.</s>
				</p>
				<p>
					<s n="21" xml:lang="la" ana="farewell">Bene <lb xml:id="p1z42"/>vale.</s>
					<s n="22" xml:lang="la" ana="salute">Salutant te consules ambo et quęstores, <persName ref="p20518">H<lb xml:id="p1z43"/>agenbergius</persName> et socer, tum etiam <persName ref="p7129">Iosua Witenbachius</persName> <lb xml:id="p1z44"/>et <persName ref="p8099">Schöpfius</persName> medicus.</s>
					<s n="23" xml:lang="la" ana="salute">Salutem precor familiaribus tuis <lb xml:id="p1z45"/>et fratribus illic omnibus.</s>
				</p>
				<p>
					<s n="24" xml:lang="de"><placeName ref="l41">Bernę</placeName> 12. februarii <lb xml:id="p1z46"/>1571.</s>
				</p>
				<p>
					<s n="25" xml:lang="la"><lb xml:id="p1z47"/><persName ref="p8018">Iohan[nes] Hallerus</persName> <lb xml:id="p1z48"/>tuus.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><pb/><lb xml:id="p2z1"/>Clarissimo viro d. <persName ref="p495">Heinrycho <lb xml:id="p2z2"/>Bullingero</persName>, <placeName ref="l587">Tigurinae</placeName> <lb xml:id="p2z3"/>ecclesiae pastori fidelissimo, <lb xml:id="p2z4"/>domino meo honorando et <lb xml:id="p2z5"/>compatri charissimo.</s>
				</p>
			</div>
