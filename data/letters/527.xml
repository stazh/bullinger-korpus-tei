	<text xml:lang="la">
		<body>
			<div>
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>S. D. P.</s>
					<s n="2" xml:lang="la">Ago tibi gratias pro omnibus et in omnibus, quae incessanter mihi confers.</s>
					<s n="3" xml:lang="la">Misit mihi <persName ref="p8018">Hallerus</persName> <lb xml:id="p1z2"/>noster cum libello tuo literas etiam tuas; res iucundissimas continebant.</s>
					<s n="4" xml:lang="la">Scriptum tuum contra Interim <lb xml:id="p1z3"/>nondum omnino vertit; ubi verterit, mihi missurus est.</s>
					<s n="5" xml:lang="la">Pridie <placeName ref="l41">Bernę</placeName> apud ipsum fui; dixit <lb xml:id="p1z4"/>revolutum iam esse terminum, quo revocari a vobis debeat.</s>
					<s n="6" xml:lang="la">Quę res mihi displicuit val<lb xml:id="p1z5"/>de propter communem statum nostrum.</s>
					<s n="7" xml:lang="la">Quantum enim intelligo, <placeName ref="l41">Bernatibus</placeName> supra modum est acceptus; <lb xml:id="p1z6"/>affirmat ecclesia, si hunc semper habuissent, nunquam exoriri potuisse tanta civium odia; <lb xml:id="p1z7"/>rem vero omnem peius habituram, si denuo ipsis eripiatur.</s>
					<s n="8" xml:lang="la">Quantum ergo in te est, mi <lb xml:id="p1z8"/>pater, oro, ne permittas petentibus eum <placeName ref="l41">Bernatibus</placeName> negari.</s>
					<s n="9" xml:lang="la">una sumus ecclesia, et hoc <lb xml:id="p1z9"/>magis mutuus crescet amor, vetus restinguetur odium, si communes utrinque nobis erunt pa<lb xml:id="p1z10"/>stores etc.</s>
					<s n="10" xml:lang="la">Sed hęc pro tua singulari prudentia et expendere et iuvare poteris optime; <lb xml:id="p1z11"/>parce interim stulto admonitori.</s>
					<s n="11" xml:lang="la" ana="salute">Salutant te nostri.</s>
					<s n="12" xml:lang="la" ana="salute">Saluta meo nomine tuos.</s>
					<s n="13" xml:lang="la" ana="farewell"><lb xml:id="p1z12"/>Vale.</s>
				</p>
				<p>
					<s n="14" xml:lang="la"><placeName ref="l49">Biellnis</placeName> 12. Kalendas Junii 1549.</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p1z13"/>Totus ex animo tuus <persName ref="p8082">Ioa<lb xml:id="p1z14"/>nnes Leo<pb/><lb xml:id="p2z1"/>poldus Fry</persName>.</s>
				</p>
				<p>
					<note type="address">[Adresse:]</note>
					<s n="16" xml:lang="la"><lb xml:id="p2z2"/>Doctissimo piissimoque <placeName ref="l587">Tigurinę</placeName> <lb xml:id="p2z3"/>ecclesię antistiti <persName ref="p495">Heinrycho <lb xml:id="p2z4"/>Bullingero</persName>, patri suo plurimum <lb xml:id="p2z5"/>semper observando.</s>
					<s n="17" xml:lang="la"><lb xml:id="p2z6"/><placeName ref="l587">Tiguri</placeName>.</s>
				</p>
			</div>
		</body>
	</text>
