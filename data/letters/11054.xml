	<text xml:lang="la">
		<body>
			<div xml:id="div1" corresp="regest1">
				<p>
					<s n="1" xml:lang="la"><lb xml:id="p1z1"/>Salus et pax Christi.</s>
				</p>
				<p>
					<s n="2" xml:lang="la"><lb xml:id="p1z2"/>Nec iam quicquam est, quod ad te scribam, charissime <lb xml:id="p1z3"/>omnium <persName ref="p467">Bucere</persName><note xml:id="fna" type="footnote" n="a"><hi>irrtümlich für</hi> <persName ref="p495">Bullingere</persName>.</note>, et certe gratulor et nobis et <lb xml:id="p1z4"/>ecclesiae, cum desunt tam contentiosa literarum <lb xml:id="p1z5"/>argumenta, quibus iam diu sumus non sine <lb xml:id="p1z6"/>magno fastidio vexati.</s>
					<s n="3" xml:lang="la">Nunc pro charta <lb xml:id="p1z7"/>habes ex animo candidum <persName ref="p5741">Ioachimum</persName><note xml:id="fn1" type="footnote" n="1"><persName ref="p5741">Joachim Maler</persName>.</note> nostrum, <lb xml:id="p1z8"/>quocum tuto de omnibus conferre potes.</s>
					<s n="4" xml:lang="la">Is <lb xml:id="p1z9"/>nuper ex <placeName ref="l491">Argentorato</placeName> rediens<note xml:id="fn2" type="footnote" n="2">Zum Versuch <persName ref="p5741">Malers</persName>, <persName ref="p467">Bucer</persName> durch den <placeName ref="l491">Straßburger</placeName> Rat zurückbinden zu lassen, s. <bibl source="b480">PC</bibl> II 695-697; <hi>Moeller,</hi> <persName ref="p4079">Zwick</persName> 196.</note> literas<note xml:id="fn3" type="footnote" n="3">Nicht erhalten.</note> a <persName ref="p5565">Capitone</persName> <lb xml:id="p1z10"/>attulit, in quibus optimus vir de vobis aut <lb xml:id="p1z11"/>ecclesiis vestris ne verbum quidem, nisi quod <lb xml:id="p1z12"/>putat <persName ref="p467">Bucerum</persName> vobis satisfacere posse, si audiretur, <lb xml:id="p1z13"/>et daturum illum vitam in iudicum manus, <lb xml:id="p1z14"/>siquidem verum esse deprehenderent, qua de re <lb xml:id="p1z15"/>ex literis accusatur<note xml:id="fn4" type="footnote" n="4">Die <placeName ref="l491">Straßburger</placeName> hatten durch <persName ref="p5741">Maler</persName> erfahren, daß <persName ref="p467">Bucers</persName> Brief vom 1. April (oben <ref target="file11025">Nr. 983</ref>) und sein Schreiben an <persName ref="p1974">Luther</persName> vom 19. Januar an manchen Orten Mißfallen erregt hatten (s. <bibl source="b480">PC</bibl> II 696).</note>.</s>
					<s n="5" xml:lang="la">Deinde nunquam et <lb xml:id="p1z16"/>nusquam non deplorat ecclesiarum neglectum, <lb xml:id="p1z17"/>quodque non satis vigilemus pro illis et bene <lb xml:id="p1z18"/>instituendis et ad posteros pure transmittendis.</s>
					<s n="6" xml:lang="la"><lb xml:id="p1z19"/>Neglectum esse putat, quod ministerii evangelici vis <lb xml:id="p1z20"/>et officii pastoralis partes<note xml:id="fnb" type="footnote" n="b"><hi>vor</hi> partes <hi>gestrichenes</hi> vis.</note> non vividius <lb xml:id="p1z21"/>tractentur.</s>
					<s n="7" xml:lang="la">Quam sententiam ego non intelligo.</s>
					<s n="8" xml:lang="la"><lb xml:id="p1z22"/>Nam si post tantum regni Christi successum nunc <lb xml:id="p1z23"/>primum discenda<note xml:id="fnc" type="footnote" n="c">discenda <hi>vom Schreiber korrigiert aus</hi> discendum.</note> est verbi sive ministerii illius <lb xml:id="p1z24"/>autoritas, nescio, in quo digito hactenus eiecta <lb xml:id="p1z25"/>sint potentissima dęmonia<note xml:id="fn5" type="footnote" n="5">Vgl. <cit type="bible"><ref>Lk 11, 20</ref></cit>.</note>.</s>
					<s n="9" xml:lang="la">Quid aliud voluerunt <lb xml:id="p1z26"/>anabaptistae una hac ecclesiarum reformatione?</s>
					<s n="10" xml:lang="la"><lb xml:id="p1z27"/>Videamus ergo, ne in easdem Syrtes<note xml:id="fn6" type="footnote" n="6">im Sinne von: gefährliche Untiefen.</note> impingamus.</s>
					<s n="11" xml:lang="la"><lb xml:id="p1z28"/>Sed de hoc cum <persName ref="p5741">Ioachimo</persName>, si libet.</s>
					<s n="12" xml:lang="la">Ego iam nihil <lb xml:id="p1z29"/>addo, sed invoco te Iesum Christum in caelum [!], <lb xml:id="p1z30"/>ne inducas nos in tentationem<note xml:id="fn7" type="footnote" n="7"><cit type="bible"><ref>Mt 6, 13</ref></cit>; <cit type="bible"><ref>Lk 11, 4</ref></cit>.</note>.</s>
					<s n="13" xml:lang="la"><pb type="scan" next="||35"/><pb/><lb xml:id="p2z1"/>O quam vereor reditum eiecti semel dęmonii comitibus <lb xml:id="p2z2"/>septem peioribus ipso<note xml:id="fn8" type="footnote" n="8">Vgl. <cit type="bible"><ref>Mt 12, 45</ref></cit>.</note>, et ne zizaniam nos <lb xml:id="p2z3"/>eradicaturi ex agro faciamus hoc cum magna <lb xml:id="p2z4"/>tritici iactura<note xml:id="fn9" type="footnote" n="9">Vgl. <cit type="bible"><ref>Mt 13, 24-30. 36-42</ref></cit>.</note>.</s>
					<s n="14" xml:lang="la">Utinam autem vanissimus sit <lb xml:id="p2z5"/>omnis iste metus!</s>
				</p>
				<p>
					<s n="15" xml:lang="la"><lb xml:id="p2z6"/><persName ref="p1753">Leonem</persName><note xml:id="fn10" type="footnote" n="10"><persName ref="p1753">Leo Jud</persName>.</note> audivi nuper decumbere.</s>
					<s n="16" xml:lang="la">Dominus eum <lb xml:id="p2z7"/>nobis restituat!</s>
				</p>
				<p>
					<s n="17" xml:lang="la"><lb xml:id="p2z8"/>Indicem <persName ref="p7187">Ziegleri</persName><note xml:id="fn11" type="footnote" ana="bio" n="11">Gemeint ist offenbar der <bibl source="b322">Index</bibl> zu <persName ref="p7187">Jakob Zieglers</persName> "Terrae sanctae ... descriptio". Unter diesem Titel gab <persName ref="p18383">Wendelin Rihel</persName> in <placeName ref="l491">Straßburg</placeName> die Restexemplare von <persName ref="p7187">Zieglers</persName> Werk aus dem Jahr 1532 neu heraus, wobei ein <bibl source="b322">Index</bibl> und weitere Ergänzungen beigefügt wurden (vgl. Karl <hi>Schottenloher,</hi> <persName ref="p7187">Jakob Ziegler</persName> aus <placeName ref="l1078">Landau an der Isar</placeName>. Ein Gelehrtenleben aus der Zeit des Humanismus und der Reformation, Münster 1910. -Reformationsgeschichtliche Studien und Texte 8-10, S. 384).</note> brevi a me habebis.</s>
					<s n="18" xml:lang="la">Tu cura, <lb xml:id="p2z9"/>ut <persName ref="p4091">Zvinglii</persName> librorum<note xml:id="fnd" type="footnote" n="d"><hi>vor</hi> librorum <hi>gestrichenes</hi> in.</note> indicem<note xml:id="fn12" type="footnote" n="12">Zu denken ist wohl an ein Verzeichnis der Werke <persName ref="p4091">Zwinglis</persName>.</note> habeam.</s>
					<s n="19" xml:lang="la"><persName ref="p2442">Oecolam<lb xml:id="p2z10"/>padii</persName><note xml:id="fn13" type="footnote" n="13"><persName ref="p4079">Zwick</persName> muß ein handschriftliches Verzeichnis der Werke <persName ref="p2442">Oekolampads</persName> besessen haben; ein entsprechender Druck ist nicht bekannt.</note> habeo<note xml:id="fne" type="footnote" n="e"><hi>vor</hi> habeo <hi>gestrichenes</hi> h...</note> ex <placeName ref="l28">Basilęa</placeName>, quem hic tibi relege<lb xml:id="p2z11"/>ndum<pb type="edition" next="182"/> mitto, si forte neglectum aliquid inve<lb xml:id="p2z12"/>nires; sed remitte per <persName ref="p5741">Ioachimum</persName>.</s>
				</p>
				<p>
					<s n="20" xml:lang="la" ana="salute"><lb xml:id="p2z13"/><persName ref="p8127">Pellicanum</persName> salutabis, qui et ipse <persName ref="p7187">Zieglerum</persName> accipiet <lb xml:id="p2z14"/>a me<note xml:id="fn14" type="footnote" n="14">Am 15. September schreibt <persName ref="p4079">Zwick</persName> an <persName ref="p8127">Pelikan</persName>: "Hic tandem satis facio pollicitationi meae, scilicet ut indicem tuum in <persName ref="p7187">Zieglerum</persName> habeas. Alterum dato <persName ref="p495">Bullingero</persName>." (Zürich ZB, Ms F 47, 20; vgl. unten <ref target="file11085">Nr. 1043</ref>, 42).</note>.</s>
					<s n="21" xml:lang="la">Cui etiam literas has potes dare legendas.</s>
					<s n="22" xml:lang="la"><lb xml:id="p2z15"/>Non enim vacat utrisque semper unum argumentum <lb xml:id="p2z16"/>scribere.</s>
				</p>
				<p>
					<s n="23" xml:lang="la">Familias vestras salvas cupio in Christo.</s>
					<s n="24" xml:lang="la" ana="farewell"><lb xml:id="p2z17"/>Vale, cor meum.</s>
				</p>
				<p>
					<s n="25" xml:lang="la">Ultima iunii 1537.</s>
				</p>
				<p>
					<s n="26" xml:lang="la"><lb xml:id="p2z18"/>Tuus, quantus sum, <lb xml:id="p2z19"/><persName ref="p4079">Io. Zvick</persName>.</s>
				</p>
