					<lb xml:id="p3z2"/>cona
					<lb xml:id="p3z3"/>iptum.
					<lb xml:id="p3z4"/>idem
					<lb xml:id="p3z5"/>n.
					<lb xml:id="p3z6"/>isit
					<lb xml:id="p3z7"/>inter
					<lb xml:id="p3z8"/>
					<lb xml:id="p3z9"/>S.
					<lb xml:id="p3z10"/>nihi
					<lb xml:id="p3z11"/>restis
					<lb xml:id="p3z12"/>s
					<lb xml:id="p3z13"/>am
					<lb xml:id="p3z14"/>cls.
					<lb xml:id="p3z15"/>.
					<lb xml:id="p3z16"/>861a.
					<pb/>
					<lb xml:id="p4z1"/>Clarissimo viro eximioque Christi servo,
					<lb xml:id="p4z2"/>d. Henrico Bullingero, ecclesiae Tigurina
					<lb xml:id="p4z3"/>antistiti vigilantissimo, amico et
					<lb xml:id="p4z4"/>patri suo in Christo summe colendo.
				</p>
